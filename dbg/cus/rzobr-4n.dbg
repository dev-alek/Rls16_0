     2620   PROCEDURE display-B1  :
     2621         if NOT( NOT Show-Negativ-2 and
     2622            ( b1-prih         [1]   = 0 AND
     2623              b1-rash          [1]   = 0 AND
     2624              b1-kassa         [1]   = 0 AND
     2625              b1-Inv           [1]   = 0 AND
     2626              b1-Overturn      [1]   = 0 AND
     2627              b1-Overturn      [5]   = 0 AND
     2628              b1-Overturn      [8]   = 0 ) ) then DO:
     2629           IF  NOT (NOT Show-Negativ  AND (
     2630                 b1-prih          [1]   = 0 AND
     2631                 b1-rash          [1]   = 0 AND
     2632                 b1-kassa         [1]   = 0 AND
     2633                 b1-Inv           [1]   = 0 AND
     2634                 b1-Overturn      [1]   = 0 AND
     2635                 b1-Overturn      [5]   = 0 AND
     2636                 b1-ostatok-start [1]   = 0 AND
     2637                 b1-ostatok-End   [1]   = 0   )) then DO:
     2638                 if Sums-Only THEN do:
     2639                     if fr0 = true then do:
     2640                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2641                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2642                         fr0 = false .
     2643                       end.
     2644                  end.
     2645           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2646           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2647           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2648           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2649           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2650           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2651           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2652          if not sums-only then run p-line.
     2653    End.
     2654    end.
     2655   END PROCEDURE.
     2656   PROCEDURE display-B2  :
     2657        if NOT( NOT Show-Negativ-2 and
     2658            ( b2-prih         [1]   = 0 AND
     2659              b2-rash          [1]   = 0 AND
     2660              b2-kassa         [1]   = 0 AND
     2661              b2-Inv           [1]   = 0 AND
     2662              b2-Overturn      [1]   = 0 AND
     2663              b2-Overturn      [5]   = 0 AND
     2664              b2-Overturn      [8]   = 0 ) ) then DO:
     2665           IF  NOT (NOT Show-Negativ  AND (
     2666                 b2-prih          [1]   = 0 AND
     2667                 b2-rash          [1]   = 0 AND
     2668                 b2-kassa         [1]   = 0 AND
     2669                 b2-Inv           [1]   = 0 AND
     2670                 b2-Overturn      [1]   = 0 AND
     2671                 b2-Overturn      [5]   = 0 AND
     2672                 b2-ostatok-start [1]   = 0 AND
     2673                 b2-ostatok-End   [1]   = 0   )) then DO:
     2674           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2675           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2676           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2677           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2678            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2679            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2680            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2681    End.
     2682   end.
     2683   END PROCEDURE.
     2684   PROCEDURE Clear-B1  :
     2685    b1-gds-zap-other           = 0.
     2686    REPEAT kk = 1 to 9 :
     2687    Assign
     2688       b1-Prih                                            [kk]    = 0
     2689       b1-Rash                                            [kk]    = 0
     2690       b1-KAssa                                           [kk]    = 0
     2691       b1-Inv                                             [kk]    = 0
     2692       b1-Overturn                                        [kk]    = 0
     2693       b1-ostatok-end                                     [kk]    = 0
     2694       b1-ostatok-start                                   [kk]    = 0   .
     2695      End.
     2696    END PROCEDURE.
     2697   PROCEDURE Clear-B2  :
     2698    b2-gds-zap-other           = 0.
     2699    REPEAT kk = 1 to 9 :
     2700    Assign
     2701       b2-Prih                                            [kk]    = 0
     2702       b2-Rash                                            [kk]    = 0
     2703       b2-KAssa                                           [kk]    = 0
     2704       b2-Inv                                             [kk]    = 0
     2705       b2-Overturn                                        [kk]    = 0
     2706       b2-ostatok-end                                     [kk]    = 0
     2707       b2-ostatok-start                                   [kk]    = 0   .
     2708      End.
     2709   END PROCEDURE.
     2710   PROCEDURE Clear-Bi  :
     2711    bi-gds-zap-other           = 0.
     2712    REPEAT kk = 1 to 9 :
     2713    Assign
     2714       bi-Prih                                            [kk]    = 0
     2715       bi-Rash                                            [kk]    = 0
     2716       bi-KAssa                                           [kk]    = 0
     2717       bi-Inv                                             [kk]    = 0
     2718       bi-Overturn                                        [kk]    = 0
     2719       bi-ostatok-end                                     [kk]    = 0
     2720       bi-ostatok-start                                   [kk]    = 0   .
     2721      End.
     2722   END PROCEDURE.
     2723   PROCEDURE Display-title :
     2724   define variable v-nn as integer   no-undo .
     2725      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2726             REPORTNAME  AT 20 format "X(170)" SKIP
     2727             Trim(str1)  AT 35 format "X(75)" SKIP.
     2728        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2729        Repeat i = 1 to v-nn:
     2730         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2731        End.
     2732       i=0.
     2733          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2734        v-nn = NUM-ENTRIES(str4,chr(10)).
     2735        Repeat i = 1 to v-nn :
     2736         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2737        End.
     2738       i=0.
     2739        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2740        Repeat i = 1 to v-nn :
     2741         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2742        End.
     2743       i=0.
     2744       run rep/extitle.p (1) .
     2745   END PROCEDURE.
     2746   PROCEDURE ob-line  :
     2747   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2748   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2749   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2750   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2751   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2752   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2753   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2754   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2755   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2756   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2757   define input  parameter xTog-obj           as log no-undo.
     2758   define variable  tt#          as   int                 no-undo.
     2759    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2760    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2761    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2762     For EAch obj-list  no-lock :
     2763        FOR each ub.ot-line where
     2764                           ub.ot-line.artic         = x-artic
     2765                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2766                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2767                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     2768                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     2769                     AND   ub.ot-line.prod-code    = x-prod-code
     2770                     AND   ub.ot-line.prod-type    = x-prod-type
     2771                     AND   ub.ot-line.sum-type     = x-sum-type
     2772                       no-lock :
     2773       CASE ub.ot-line.ext-doc-type:
     2774                 WHEN        'ie':U  OR
     2775                 WHEN        're':U  OR
     2776                 WHEN        'iv':U    OR
     2777                 WHEN        'rv':U OR
     2778                 WHEN        'im':U     THEN
     2779                 DO:
     2780                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2781                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2782                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2783                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2784                 End.
     2785                 WHEN       'ee':U      OR
     2786                 WHEN       'ep':U    OR
     2787                 WHEN       'ev':U     OR
     2788                 WHEN       'em':U       OR
     2789                 WHEN       'wm':U       OR
     2790                 WHEN       'we':U     THEN
     2791                 DO:
     2792                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2793                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2794                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2795                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2796                 End.
     2797                 WHEN       'es':U  OR
     2798                 WHEN       'rs':U THEN
     2799                 DO:
     2800                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2801                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2802                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2803                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2804                 End.
     2805             WHEN  'vt':U or when 'vp':U     THEN
     2806                 DO:
     2807                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2808                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2809                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2810                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2811                 End.
     2812             WHEN       'ot':U THEN
     2813                 DO:
     2814                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2815                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2816                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2817                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2818                 End.
     2819         End CASE.
     2820      End.
     2821     END.
     2822     if tt# = 6 then DO:
     2823              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2824                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2825                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2826     End.
     2827   END PROCEDURE.
     2828   procedure ost-line :
     2829     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2830     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2831     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2832     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2833     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2834     define input  parameter x-tog-shift  as logical no-undo .
     2835     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2836     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2837     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2838     define input  parameter xtog-obj     as logical no-undo .
     2839     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2840     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2841     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2842     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2843     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2844     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2845     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2846     define buffer buff-obj-list  for obj-list .
     2847     define buffer buff-stk-line  for ub.stk-line .
     2848     assign
     2849       Quantity = 0
     2850       Coast_R  = 0
     2851       Coast_V  = 0
     2852       VAT_R    = 0
     2853       VAT_V    = 0
     2854       SLT_R    = 0
     2855       SLT_V    = 0
     2856     .
     2857     if  x-tog-shift = false then do:
     2858       for each buff-obj-list no-lock
     2859       on error undo, return error
     2860       :
     2861         find last buff-stk-line no-lock
     2862           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2863             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2864             and buff-stk-line.artic      = x-artic
     2865             and buff-stk-line.prod-type  = x-prod-type
     2866             and buff-stk-line.prod-code  = x-prod-code
     2867             and buff-stk-line.sum-type   = x-sum-type
     2868             and buff-stk-line.cat-id     = '##,##':U
     2869             and buff-stk-line.fact-order <= x-fact-order
     2870             and buff-stk-line.shift-num  = 0
     2871           use-index category
     2872           no-error .
     2873         if available buff-stk-line then do:
     2874           assign
     2875             Quantity = Quantity +  buff-stk-line.fact-qnty
     2876             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2877             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2878             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2879             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2880             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2881             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2882           .
     2883         end.
     2884       end.
     2885     end.
     2886     else do:
     2887       for each buff-obj-list no-lock
     2888         where xtog-obj = false
     2889            or (buff-obj-list.obj-type = x-store-type
     2890               and buff-obj-list.obj-code = x-store-code
     2891               )
     2892       on error undo, return error
     2893       :
     2894         find last buff-stk-line no-lock
     2895           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2896             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2897             and buff-stk-line.artic      = x-artic
     2898             and buff-stk-line.prod-type  = x-prod-type
     2899             and buff-stk-line.prod-code  = x-prod-code
     2900             and buff-stk-line.sum-type   = x-sum-type
     2901             and buff-stk-line.cat-id     = '##,##':U
     2902             and buff-stk-line.fact-order <= x-fact-order
     2903             and buff-stk-line.shift-num  > 0
     2904           use-index category
     2905           no-error .
     2906         if available buff-stk-line then do:
     2907           assign
     2908             Quantity = Quantity +  buff-stk-line.fact-qnty
     2909             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2910             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2911             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2912             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2913             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2914             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2915           .
     2916         end.
     2917       end.
     2918     end.
     2919   end procedure.
     2920   procedure ost-lineother-tax :
     2921     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2922     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2923     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2924     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2925     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2926     define input  parameter x-tog-shift  as logical no-undo .
     2927     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2928     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2929     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2930     define input  parameter xTog-obj     as logical no-undo .
     2931     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2932     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2933     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2934     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2935     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2936     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2937     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2938     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2939     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2940     define buffer buff-obj-list  for obj-list .
     2941     define buffer buff-stk-line  for ub.stk-line .
     2942     assign
     2943       Quantity = 0
     2944       Coast_R  = 0
     2945       Coast_V  = 0
     2946       VAT_R    = 0
     2947       VAT_V    = 0
     2948       SLT_R    = 0
     2949       SLT_V    = 0
     2950       other_R  = 0
     2951       other_V  = 0
     2952     .
     2953     if  x-tog-shift = false then do:
     2954       for each buff-obj-list no-lock
     2955       on error undo, return error
     2956       :
     2957         find last buff-stk-line no-lock
     2958           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2959             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2960             and buff-stk-line.artic      = x-artic
     2961             and buff-stk-line.prod-type  = x-prod-type
     2962             and buff-stk-line.prod-code  = x-prod-code
     2963             and buff-stk-line.sum-type   = x-sum-type
     2964             and buff-stk-line.cat-id     = '##,##':U
     2965             and buff-stk-line.fact-order <= x-fact-order
     2966             and buff-stk-line.shift-num  = 0
     2967           use-index category
     2968           no-error .
     2969         if available buff-stk-line then do:
     2970           assign
     2971             Quantity = Quantity +  buff-stk-line.fact-qnty
     2972             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2973             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2974             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2975             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2976             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2977             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2978             other_R  = other_R  +  buff-stk-line.other-rubl
     2979             other_V  = other_V  +  buff-stk-line.other-base
     2980           .
     2981         end.
     2982       end.
     2983     end.
     2984     else do:
     2985       for each buff-obj-list no-lock
     2986         where xtog-obj = false
     2987            or (buff-obj-list.obj-type = x-store-type
     2988               and buff-obj-list.obj-code = x-store-code
     2989               )
     2990       on error undo, return error
     2991       :
     2992         find last buff-stk-line no-lock
     2993           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2994             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2995             and buff-stk-line.artic      = x-artic
     2996             and buff-stk-line.prod-type  = x-prod-type
     2997             and buff-stk-line.prod-code  = x-prod-code
     2998             and buff-stk-line.sum-type   = x-sum-type
     2999             and buff-stk-line.cat-id     = '##,##':U
     3000             and buff-stk-line.fact-order <= x-fact-order
     3001             and buff-stk-line.shift-num  > 0
     3002           use-index category
     3003           no-error .
     3004         if available buff-stk-line then do:
     3005           assign
     3006             Quantity = Quantity +  buff-stk-line.fact-qnty
     3007             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3008             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3009             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3010             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3011             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3012             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3013             other_R = other_R   +  buff-stk-line.other-rubl
     3014             other_V = other_V   +  buff-stk-line.other-base
     3015           .
     3016         end.
     3017       end.
     3018     end.
     3019   end procedure.
     3020   procedure ost-line-kg :
     3021     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3022     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3023     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3024     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3025     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3026     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3027     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3028     define buffer buff-obj-list  for obj-list .
     3029     define buffer buf_doc-line for ub.doc-line .
     3030     define buffer buf_inv-line for ub.inv-line .
     3031     do
     3032     on error undo, return error
     3033     :
     3034       for each buf_doc-line no-lock where
     3035                buf_doc-line.obj-type    = p-obj-type   and
     3036                buf_doc-line.obj-code    = p-obj-code   and
     3037                buf_doc-line.prod-type   = p-prod-type  and
     3038                buf_doc-line.prod-code   = p-prod-code  and
     3039                buf_doc-line.artic       = p-artic      and
     3040                buf_doc-line.status_     = 'факт':U      and
     3041                buf_doc-line.fact-order <= p-fact-order
     3042             by buf_doc-line.fact-order    descending
     3043       :
     3044         find first buf_inv-line no-lock where
     3045                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3046                    buf_inv-line.artic     = buf_doc-line.artic     and
     3047                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3048                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3049         if available buf_inv-line
     3050         then do:
     3051           if buf_inv-line.after-cli-qnty <> ?
     3052           then do:
     3053             assign
     3054               p-quantity-kg = buf_inv-line.after-cli-qnty
     3055             .
     3056             leave .
     3057           end.
     3058         end.
     3059       end.
     3060       if p-quantity-kg = ?
     3061       then do:
     3062         assign
     3063           p-quantity-kg = 0
     3064         .
     3065       end.
     3066     end.
     3067   end procedure.
     3068   PROCEDURE ostatok :
     3069   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3070   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3071   def input parameter x-tog-shift   as   logical             no-undo.
     3072   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3073   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3074   def input parameter x-shift-start as integer               no-undo.
     3075   def input parameter x-shift-end   as integer               no-undo.
     3076   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3077   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3078   def input parameter xTog-obj   as log no-undo.
     3079   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3080   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3081   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3082   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3083   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3084   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3085   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3086   def var              Fact-orderS   as char  no-undo.
     3087   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3088      Assign
     3089         Fact-order   = 0
     3090         Quantity     = 0
     3091         Coast_R      = 0
     3092         Coast_V      = 0
     3093         VAT_R        = 0
     3094         VAT_V        = 0 .
     3095    x-date-start-t  = x-date-start + 1 .
     3096   IF x-date-end = date('') then DO:
     3097      Fact-order = 0 .
     3098      for each obj-list
     3099          where  ( not xtog-obj or
     3100                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3101                 no-lock :
     3102         if  x-tog-shift = false then do:
     3103                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3104                               ub.stk-tot.Fact-date <=  x-date-start
     3105                               and ub.stk-tot.shift-num = 0
     3106                               USE-INDEX fact-date no-lock no-error .
     3107              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3108         End.
     3109         Else  DO :
     3110             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3111              (ub.stk-tot.shift-date  = x-date-start-t and
     3112               ub.stk-tot.shift-num  < x-shift-start or
     3113               ub.stk-tot.shift-date  < x-date-start-t  )
     3114               and ub.stk-tot.shift-num  > 0
     3115               USE-INDEX Shift-num no-lock no-error .
     3116            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3117           END.
     3118       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3119     End.
     3120   End.
     3121   Else DO:
     3122     For each obj-list  WHERE
     3123        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3124         no-lock :
     3125      IF  x-TOG-Shift = False Then DO:
     3126          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3127               ub.stk-tot.Fact-date <= x-date-end
     3128               and ub.stk-tot.shift-num = 0
     3129               USE-INDEX fact-date no-lock no-error.
     3130          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3131      END.
     3132      Else DO:
     3133           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3134               (ub.stk-tot.shift-date  = x-date-end and
     3135               ub.stk-tot.shift-num  <= x-shift-end or
     3136               ub.stk-tot.shift-date  < x-date-end       ) and
     3137               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3138               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3139       End.
     3140       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3141     End.
     3142   End.
     3143   END PROCEDURE.
     3144   PROCEDURE report-exec1  :
     3145      FIND FIRST clients where x-store-type = clients.obj-type AND
     3146                               x-store-code = clients.obj-code no-lock no-error.
     3147     run waitfram-show(clients.obj-name) .
     3148     run calcitog.
     3149     run print-header.
     3150      case retclassify :
     3151        when "prod/grp-goods":u then run run4.
     3152        otherwise do:
     3153          message "Ошибка вызова!"  view-as alert-box error .
     3154        end.
     3155      end case.
     3156     run print-footer.
     3157     END PROCEDURE.
     3158   PROCEDURE Calc-Sub-itog :
     3159   define input parameter tt as int no-undo.
     3160   define variable b as int no-undo.
     3161   if tt = 6  then Assign
     3162     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     3163     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     3164     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     3165     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     3166     .
     3167   repeat b = 1 to 3:
     3168     Assign
     3169     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     3170     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     3171     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     3172     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     3173     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     3174     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     3175     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     3176     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     3177     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     3178     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     3179     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     3180     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     3181     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     3182     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     3183     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     3184     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     3185     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     3186     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     3187     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     3188     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     3189     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     3190     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     3191   End.
     3192   END PROCEDURE.
     3193   PROCEDURE Clear-item :
     3194   define variable kk as int no-undo.
     3195    gds-zap-other = 0 .
     3196    REPEAT kk = 1 to 9 :
     3197    Assign
     3198       prih            [kk]    = 0
     3199       rash            [kk]    = 0
     3200       kassa           [kk]    = 0
     3201       Inv             [kk]    = 0
     3202       Overturn        [kk]    = 0
     3203       ostatok-end     [kk]    = 0
     3204       ostatok-start   [kk]    = 0 .
     3205          End.
     3206    END PROCEDURE.
     3207   PROCEDURE Item-Goods :
     3208      define input parameter  par-3 as char no-undo.
     3209      define input parameter  par-4 as char no-undo.
     3210        if par-4 = "goods":U  Then DO:
     3211           assign
     3212               gds-zap-unit-base  = Goods.unit-base
     3213               gds-zap-prt-root   = Goods.prt-root
     3214               gds-zap-prod-type  = Goods.prod-type
     3215               gds-zap-prod-code  = Goods.prod-code
     3216               gds-zap-artic      = Goods.artic
     3217               gds-zap-grp-name   = Goods.grp-name
     3218               gds-zap-b-code     = Goods.gds-code
     3219               gds-zap-type       = Goods.gds-type.
     3220           if g#gds-engl then
     3221               assign gds-zap-gds-name = Goods.engl-name.
     3222           else
     3223               assign gds-zap-gds-name = Goods.gds-name.
     3224        End.
     3225        if par-4 = "gds-list":U  Then DO:
     3226           assign
     3227               gds-zap-unit-base  = gds-list.unit-base
     3228               gds-zap-prt-root   = gds-list.prt-root
     3229               gds-zap-prod-type  = gds-list.prod-type
     3230               gds-zap-prod-code  = gds-list.prod-code
     3231               gds-zap-artic      = gds-list.artic
     3232               gds-zap-grp-name   = gds-list.grp-name
     3233               gds-zap-b-code     = gds-list.gds-code
     3234               gds-zap-type       = gds-list.gds-type.
     3235           if g#gds-engl then
     3236               assign gds-zap-gds-name = gds-list.engl-name.
     3237           else
     3238               assign gds-zap-gds-name = gds-list.gds-name.
     3239        End.
     3240       run foreach.
     3241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3242     (input  gds-zap-b-code
     3243     ,input  ?
     3244     ,output v-bar-code
     3245     )  .
     3246   s-bar-code = string (v-bar-code,"999999999").
     3247       If  break_group = true  and par-3 <> "1"  then DO :
     3248            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3249            gds-zap-prod-name  = clients.obj-name.
     3250             If break_group1 = true  THEN  DO :
     3251               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3252                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3253                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3254               if par-3 = "6"  then  dO:
     3255                  if xTog-obj = true then do:
     3256                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3257                     .
     3258                   end.
     3259                  else do:
     3260                   var-vat-pc = temp-gds-list.vat-pc .
     3261                   end.
     3262                   assign
     3263                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3264                       b1-name = temp-str.
     3265                   end.
     3266               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3267                   fr0 = true .
     3268                   tmp#stroka0 = temp-str.
     3269               End.
     3270             End.
     3271               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3272                 if par-3 = "4"
     3273                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3274                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3275                 if NOT xSumsOnly THEN DO:
     3276                     fr = true .
     3277                 End.
     3278                 break_group1 = false.
     3279               END.
     3280          break_group = false.
     3281       End.
     3282       run display-line.
     3283    END PROCEDURE.
     3284   PROCEDURE Di :
     3285   define input parameter p1 as char no-undo.
     3286   define input parameter p2 as int no-undo.
     3287   define input parameter p3 as char no-undo.
     3288   define input parameter p4 as char no-undo.
     3289   define input parameter p5 as char no-undo.
     3290   define input parameter p6 as char no-undo.
     3291   define input parameter p7 as char no-undo.
     3292    CASE CAPS(p7) :
     3293      WHEN "B1":U  Then DO:
     3294       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3295         p3 @ s-bar-code
     3296         p4 @ gds-zap-artic
     3297         p5 @ gds-zap-gds-name
     3298         p6 @ gds-zap-unit-base
     3299         p1 @ gds-type
     3300         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3301         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3302         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3303         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3304         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3305         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3306         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3307         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3308         with FRAME ZAPAS .
     3309                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3310                   End.
     3311      WHEN "B2":U  Then  DO:
     3312       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3313         p3 @ s-bar-code
     3314         p4 @ gds-zap-artic
     3315         p5 @ gds-zap-gds-name
     3316         p6 @ gds-zap-unit-base
     3317         p1 @ gds-type
     3318         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3319         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3320         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3321         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3322         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3323         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3324         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3325         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3326         with FRAME ZAPAS .
     3327                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3328                 End.
     3329      WHEN "BI":U Then  DO:
     3330       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3331         p3 @ s-bar-code
     3332         p4 @ gds-zap-artic
     3333         p5 @ gds-zap-gds-name
     3334         p6 @ gds-zap-unit-base
     3335         p1 @ gds-type
     3336         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3337         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3338         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3339         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3340         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3341         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3342         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3343         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3344         with FRAME ZAPAS .
