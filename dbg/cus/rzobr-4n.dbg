     1862             INPUT   gds-zap-prod-code   ,
     1863             INPUT   gds-zap-prod-type   ,
     1864             INPUT   Fact-order-1,
     1865             INPUT   Fact-order-2,
     1866             input   'crsa':U    ,
     1867             input   '##,##':U,
     1868             input   ""    ,
     1869             input   xTog-obj) .
     1870         End.
     1871             End case.
     1872        run calc-sub-itog (3).
     1873        End.
     1874     If xshowsale  Then DO:
     1875       case  gds-zap-type :
     1876       when 'у':U THEN DO:
     1877         run ob-line (
     1878             input   x-store-code   ,
     1879             input   x-store-type   ,
     1880             INPUT   gds-zap-artic       ,
     1881             INPUT   gds-zap-prod-code   ,
     1882             INPUT   gds-zap-prod-type   ,
     1883             INPUT   Fact-order-1,
     1884             INPUT   Fact-order-2,
     1885             input   'sasr':U    ,
     1886             input   '##,##':U,
     1887             input   ""    ,
     1888             input   xTog-obj) .
     1889        End.
     1890       when 'т':U THEN DO:
     1891         run ob-line (
     1892             input   x-store-code   ,
     1893             input   x-store-type   ,
     1894             INPUT   gds-zap-artic       ,
     1895             INPUT   gds-zap-prod-code   ,
     1896             INPUT   gds-zap-prod-type   ,
     1897             INPUT   Fact-order-1,
     1898             INPUT   Fact-order-2,
     1899             input   'sale':U    ,
     1900             input   '##,##':U,
     1901             input   ""    ,
     1902             input   xTog-obj) .
     1903         End.
     1904             End case.
     1905        run calc-sub-itog (6).
     1906        End.
     1907   END PROCEDURE.
     1908   PROCEDURE display-line :
     1909        i = i + 1.
     1910           if NOT( NOT Show-Negativ-2 and
     1911            ( prih         [1]   = 0 AND
     1912             rash          [1]   = 0 AND
     1913             kassa         [1]   = 0 AND
     1914             Inv           [1]   = 0 AND
     1915             Overturn      [1]   = 0 AND
     1916             Overturn      [5]   = 0 AND
     1917             Overturn      [8]   = 0 ) ) then DO:
     1918           IF  NOT (NOT Show-Negativ  AND (
     1919                 prih          [1]   = 0 AND
     1920                 rash          [1]   = 0 AND
     1921                 kassa         [1]   = 0 AND
     1922                 Inv           [1]   = 0 AND
     1923                 Overturn      [1]   = 0 AND
     1924                 Overturn      [5]   = 0 AND
     1925                 ostatok-start [1]   = 0 AND
     1926                 ostatok-End   [1]   = 0   )) then DO:
     1927           IF NOT Sums-Only then DO:
     1928               if fr0 = true then do:
     1929                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     1930                 if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     1931                 fr0 = false .
     1932               end.
     1933               if fr = true then dO:
     1934                 PUT stream OutStream space(10) temp-str format "X(100)" SKIP.
     1935                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) String(temp-str) skip.
     1936                 fr = false .
     1937               end.
     1938              run display-str1 in this-procedure.
     1939             End.
     1940           End.
     1941        END.
     1942     END PROCEDURE.
     1943   PROCEDURE print-header :
     1944   if NOT FirstLine Then DO:
     1945      run display-title.
     1946      FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1947   End.
     1948    FirstLine = TRUE .
     1949       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1950             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name)  AT 30 format "X(170)" SKIP.
     1951             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name) format "X(170)" SKIP.
     1952         End.
     1953         run clear-b1 .
     1954         run clear-b2.
     1955         run clear-bi .
     1956         break_group = true.
     1957         break_group1 = true.
     1958      END PROCEDURE.
     1959   PROCEDURE Print-Footer :
     1960         If RetClassify = "no-classify":U  then run u-line.
     1961          gds-zap-artic = "ИТОГО" .
     1962          run display-bi.
     1963          run u-line.
     1964          END PROCEDURE.
     1965   PROCEDURE U-LINE :
     1966   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1967           s-bar-code
     1968           gds-zap-artic
     1969           gds-zap-gds-name
     1970           gds-zap-unit-base
     1971           gds-type
     1972           F-ostatok-start
     1973           F-Prih
     1974           F-Rash
     1975           F-KAssa
     1976           F-Inv
     1977           F-Overturn
     1978           F-ostatok-end
     1979           gds-zap-other
     1980           with FRAME ZAPAS .
     1981           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1982           END PROCEDURE.
     1983   PROCEDURE P-LINE :
     1984   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1985           gds-zap-artic
     1986           gds-zap-gds-name
     1987           gds-zap-unit-base
     1988           gds-type
     1989           F-ostatok-start
     1990           F-Prih
     1991           F-Rash
     1992           F-KAssa
     1993           F-Inv
     1994           F-Overturn
     1995           F-ostatok-end
     1996           gds-zap-other
     1997           with FRAME ZAPAS .
     1998           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1999           END PROCEDURE.
     2000   procedure run4 :
     2001         case select-good :
     2002            when 1  then do:
     2003   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2004   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2005       for each gds-obj  where
     2006             gds-obj.obj-type = x-store-type  and
     2007             gds-obj.obj-code = x-store-code
     2008             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2009         no-lock,
     2010   First clients  where  clients.obj-code = gds-obj.prod-code and
     2011                         clients.obj-type = gds-obj.prod-type
     2012                   no-lock,
     2013             First goods  where  gds-obj.gds-code   = goods.gds-code
     2014   no-lock
     2015   BREAK BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2016         BY (temp-gds-list.grp-name)
     2017       BY (temp-gds-list.artic) :
     2018         run item-goods ( "4" , "goods" ) .
     2019         if return-value <> "" then NEXT.
     2020           If Last-of(temp-gds-list.grp-name) Then Do:
     2021           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     2022             Then  Assign
     2023                     S-bar-code   = " Итого по "
     2024                     Gds-zap-artic = Substring(
     2025                                          B2-name
     2026                                         ,1,16)
     2027                     Gds-zap-gds-name = Substring(
     2028                                          B2-name
     2029                                         ,17,40)
     2030                                   .
     2031             Else  Assign
     2032                     S-bar-code   = ""
     2033                     Gds-zap-artic = "        Итого по "
     2034                     Gds-zap-gds-name =   B2-name
     2035                                   .
     2036               Run Display-b1 In This-procedure .
     2037               Run Clear-b1 In This-procedure .
     2038               Assign Break_Group = True.
     2039           End.
     2040           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2041           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2042             Then  Assign
     2043                 S-bar-code   = "Итого по "
     2044                 Gds-zap-artic = Substring(
     2045                                      B1-name
     2046                                     ,1,16)
     2047                 Gds-zap-gds-name = Substring(
     2048                                      B1-name
     2049                                     ,17,40)
     2050                               .
     2051             Else Assign
     2052                 S-bar-code = ""
     2053                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2054                                                                    Else "  Итого по "
     2055                 Gds-zap-gds-name =   B1-name
     2056                 .
     2057             Run Display-b2 In This-procedure .
     2058             Run Clear-b2 In This-procedure .
     2059             Run Clear-b1 In This-procedure .
     2060             Assign  Break_Group1 = True.
     2061           End.
     2062       End.
     2063     END.
     2064     Else DO:
     2065      For each obj-list no-lock :
     2066                     FOR EACH gds-obj where
     2067                   gds-obj.obj-type = obj-list.obj-type    and
     2068                   gds-obj.obj-code = obj-list.obj-code
     2069                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2070                   no-lock :
     2071                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2072                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2073                       Create temp-gds-list.
     2074                       Assign
     2075                         temp-gds-list.prod-code = gds-obj.prod-code
     2076                         temp-gds-list.grp-name  = gds-obj.grp-name
     2077                         temp-gds-list.gds-name  = goods.gds-name
     2078                         temp-gds-list.gds-code  = gds-obj.gds-code
     2079                         temp-gds-list.artic     = gds-obj.artic
     2080                       .
     2081                   End.
     2082               End.
     2083     End.
     2084     for each temp-gds-list no-lock
     2085       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2086                                        , First clients   where  clients.obj-code = goods.prod-code and
     2087                                                                 clients.obj-type = goods.prod-type
     2088         BREAK
     2089   BY (substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))
     2090   BY (temp-gds-list.grp-name)
     2091       BY temp-gds-list.artic :
     2092       run item-goods ( "4" , "goods" ) .
     2093         if return-value <> "" then NEXT.
     2094           If Last-of(temp-gds-list.grp-name) Then Do:
     2095           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     2096             Then  Assign
     2097                     S-bar-code   = " Итого по "
     2098                     Gds-zap-artic = Substring(
     2099                                          B2-name
     2100                                         ,1,16)
     2101                     Gds-zap-gds-name = Substring(
     2102                                          B2-name
     2103                                         ,17,40)
     2104                                   .
     2105             Else  Assign
     2106                     S-bar-code   = ""
     2107                     Gds-zap-artic = "        Итого по "
     2108                     Gds-zap-gds-name =   B2-name
     2109                                   .
     2110               Run Display-b1 In This-procedure .
     2111               Run Clear-b1 In This-procedure .
     2112               Assign Break_Group = True.
     2113           End.
     2114           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2115           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2116             Then  Assign
     2117                 S-bar-code   = "Итого по "
     2118                 Gds-zap-artic = Substring(
     2119                                      B1-name
     2120                                     ,1,16)
     2121                 Gds-zap-gds-name = Substring(
     2122                                      B1-name
     2123                                     ,17,40)
     2124                               .
     2125             Else Assign
     2126                 S-bar-code = ""
     2127                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2128                                                                    Else "  Итого по "
     2129                 Gds-zap-gds-name =   B1-name
     2130                 .
     2131             Run Display-b2 In This-procedure .
     2132             Run Clear-b2 In This-procedure .
     2133             Run Clear-b1 In This-procedure .
     2134             Assign  Break_Group1 = True.
     2135           End.
     2136     End.
     2137   End.
     2138     end.
     2139            when 2  then do:
     2140   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2141     if x-selectobject = "currency":u  or  xtog-obj then do:
     2142         for  each gds-obj
     2143                     where gds-obj.obj-code   = x-store-code
     2144                      and  gds-obj.obj-type   = x-store-type
     2145                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2146                           no-lock ,
     2147                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2148                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     2149                     break
     2150                     by (substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))
     2151                     by temp-gds-list.grp-name
     2152                     by temp-gds-list.artic :
     2153                     run item-goods ( input "4" , input "goods" ) .
     2154                     if return-value <> "" then next.
     2155           If Last-of(temp-gds-list.grp-name) Then Do:
     2156           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     2157             Then  Assign
     2158                     S-bar-code   = " Итого по "
     2159                     Gds-zap-artic = Substring(
     2160                                          B2-name
     2161                                         ,1,16)
     2162                     Gds-zap-gds-name = Substring(
     2163                                          B2-name
     2164                                         ,17,40)
     2165                                   .
     2166             Else  Assign
     2167                     S-bar-code   = ""
     2168                     Gds-zap-artic = "        Итого по "
     2169                     Gds-zap-gds-name =   B2-name
     2170                                   .
     2171               Run Display-b1 In This-procedure .
     2172               Run Clear-b1 In This-procedure .
     2173               Assign Break_Group = True.
     2174           End.
     2175           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2176           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2177             Then  Assign
     2178                 S-bar-code   = "Итого по "
     2179                 Gds-zap-artic = Substring(
     2180                                      B1-name
     2181                                     ,1,16)
     2182                 Gds-zap-gds-name = Substring(
     2183                                      B1-name
     2184                                     ,17,40)
     2185                               .
     2186             Else Assign
     2187                 S-bar-code = ""
     2188                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2189                                                                    Else "  Итого по "
     2190                 Gds-zap-gds-name =   B1-name
     2191                 .
     2192             Run Display-b2 In This-procedure .
     2193             Run Clear-b2 In This-procedure .
     2194             Run Clear-b1 In This-procedure .
     2195             Assign  Break_Group1 = True.
     2196           End.
     2197         end.
     2198     end.
     2199     else do:
     2200         for each obj-list no-lock :
     2201               for  each gds-obj
     2202                 where  gds-obj.obj-code   = obj-list.obj-code
     2203                   and  gds-obj.obj-type   = obj-list.obj-type
     2204                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2205                 no-lock ,
     2206                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2207                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2208                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2209                           create temp-gds-list.
