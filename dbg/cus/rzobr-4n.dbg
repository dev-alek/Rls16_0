     1712                   output  coast_r     ,
     1713                   output  coast_v     ,
     1714                   output  vat_r       ,
     1715                   output  vat_v       ,
     1716                   output  slt_r       ,
     1717                   output  slt_v       ).
     1718   assign
     1719     ostatok-end [1 + 0]   = quantity
