     3674     excel-qnty(bo-Overturn     [1])  CHR(9)
     3675     excel-sum(bo-Overturn     [2])  CHR(9)
     3676     excel-sum(bo-Overturn     [5])  CHR(9)
     3677     excel-sum(bo-Overturn     [8])  CHR(9)
     3678     excel-sum(bo-Overturn     [3])  CHR(9)
     3679     excel-sum(bo-Overturn     [6])  CHR(9)
     3680     excel-sum(bo-Overturn     [9])  CHR(9)
     3681     excel-qnty(bo-Ostatok-end  [1])  CHR(9)
     3682     excel-sum(bo-Ostatok-end  [2])  CHR(9)
     3683     excel-sum(bo-Ostatok-end  [5])  CHR(9)
     3684     excel-sum(bo-Ostatok-end  [8])  CHR(9)
