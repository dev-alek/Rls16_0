     1515       HEADER
     1516           string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) AT 5 format "X(35)"
     1517           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1518           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>9") ) AT 147 format "X(53)" SKIP
     1519           Line format "X(194)" AT 1
     1520      with width 232 down stream-io use-text NO-BOX.
     1521        assign
     1522           i=0
     1523           xlavel = xvar-lavel
     1524           Select-Good   = x-SelectGood
     1525           PayType       = x-SET_PAY_TYPE
     1526           RetClassify   = xClassify
     1527           RetSortType   = xSortType
     1528           Sums-Only     = xSumsOnly
     1529           Show-Negativ  = xShowZero
     1530           Show-Negativ-2  = xShowZero-2
     1531           xShowCost     = Show-Cost
     1532           xShowSale     = Show-Sale
     1533           xShowcrsa     = Show-crsa
     1534           FirstLine     = FALSE
     1535           Line          = fill("-", 232)
     1536           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1537        run report-execute.
     1538   PROCEDURE report-execute :
     1539   define variable gj as integer no-undo init 0.
     1540     If (ValType=0 and x-base-code=0)  Or ValType=1
     1541                                   then   assign tPrintRubl = yes .
     1542                                   else   assign tPrintRubl = no .
     1543     run waitfram-show( 'Подождите ...' ) .
     1544     if ReportPageHeight = 0 then ReportPageHeight  = 43.
     1545   output stream OutStream to value( string( session:temp-directory +
     1546                                        "rpt" + string( g#report-num ) ) )
     1547                                        page-size  value(ReportPageHeight) .
     1548     FIND FIRST clients where x-store-type = clients.obj-type AND
     1549                              x-store-code = clients.obj-code no-lock no-error.
     1550     If available clients then  ObjName = clients.obj-name.
     1551                                   else  ObjName="объект не определен".
     1552   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1553   form header
     1554     line format "X(194)" at 1 skip
     1555     "Продолжение - на следующей странице" at 30 skip
     1556     with frame bottomframe width 232 page-bottom no-labels no-box .
     1557   view stream outstream frame bottomframe .
     1558        run report-exec1.
     1559     HIDE stream OutStream FRAME BottomFrame .
     1560     HIDE   STREAM OutStream FRAME ZAPAS .
     1561     Output stream OutStream close.
     1562     run waitfram-hide .
     1563     if Make-Excel then output stream ForExcel close.
     1564     define variable v-user-action as character no-undo .
     1565     define variable v-printed as logical   no-undo .
     1566     define variable DisabledOptions as integer   no-undo .
     1567     define variable v-orient-page as character no-undo .
     1568     run How-name in this-procedure (
     1569         input ReportPageHeight,
     1570         input ReportPageWidth,
     1571         output v-orient-page )
     1572         .
     1573     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1574                                    else DisabledOptions = 0 .
     1575     run gbl/prnfilen.w
     1576       (input  ""
     1577       ,input  DisabledOptions
     1578       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1579       ,input  ReportFontNum
     1580       ,output v-user-action
     1581       ,output v-printed
     1582       ) .
     1583   END PROCEDURE.
     1584   PROCEDURE foreach :
     1585   If Integer(50) = 0 Then Temp1  = 100  .
     1586                         Else Temp1 = Integer(50) .
     1587        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     1588            RUN waitfram-show( "Обработано строк : " + string( i )) .
     1589     run clear-item.
     1590   run ost-line in this-procedure
     1591                  (input   x-store-code  ,
     1592                   input   x-store-type  ,
     1593                   input   gds-zap-artic     ,
     1594                   input   gds-zap-prod-code ,
     1595                   input   gds-zap-prod-type ,
     1596                   input   x-tog-shift       ,
     1597                   input   Fact-order-1               ,
     1598                   input   'cost':U            ,
     1599                   input   '##,##':U    ,
     1600                   input   xtog-obj    ,
     1601                   output  quantity    ,
     1602                   output  coast_r     ,
     1603                   output  coast_v     ,
     1604                   output  vat_r       ,
     1605                   output  vat_v       ,
     1606                   output  slt_r       ,
     1607                   output  slt_v       ).
     1608   assign
     1609     ostatok-start [1 + 0]   = quantity
     1610    ostatok-start [2 + 0]   = if tprintrubl then coast_r else coast_v
     1611    ostatok-start [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1612    b1-ostatok-start [1 + 0] =  b1-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     1613    b1-ostatok-start [2 + 0] =  b1-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     1614    b1-ostatok-start [3 + 0] =  b1-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     1615    b2-ostatok-start [1 + 0] =  b2-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     1616    b2-ostatok-start [2 + 0] =  b2-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     1617    b2-ostatok-start [3 + 0] =  b2-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     1618    .
     1619    assign
     1620     bi-ostatok-start [1 + 0] =  bi-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     1621     bi-ostatok-start [2 + 0] =  bi-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     1622     bi-ostatok-start [3 + 0] =  bi-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     1623    .
     1624   If  xshowcrsa or vat-crsa Then DO:
     1625   run ost-line in this-procedure
     1626                  (input   x-store-code  ,
     1627                   input   x-store-type  ,
     1628                   input   gds-zap-artic     ,
     1629                   input   gds-zap-prod-code ,
     1630                   input   gds-zap-prod-type ,
     1631                   input   x-tog-shift       ,
     1632                   input   Fact-order-1               ,
     1633                   input   'crsa':U            ,
     1634                   input   '##,##':U    ,
     1635                   input   xtog-obj    ,
     1636                   output  quantity    ,
     1637                   output  coast_r     ,
     1638                   output  coast_v     ,
     1639                   output  vat_r       ,
     1640                   output  vat_v       ,
     1641                   output  slt_r       ,
     1642                   output  slt_v       ).
     1643   assign
     1644     ostatok-start [4]        = round(ostatok-start [1] *  p-price-med , 2)
     1645    ostatok-start [2 + 3]   = if tprintrubl then coast_r else coast_v
     1646    ostatok-start [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1647    b1-ostatok-start [1 + 3] =  b1-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     1648    b1-ostatok-start [2 + 3] =  b1-ostatok-start [2 + 3] + ostatok-start [2 + 3]
     1649    b1-ostatok-start [3 + 3] =  b1-ostatok-start [3 + 3] + ostatok-start [3 + 3]
     1650    b2-ostatok-start [1 + 3] =  b2-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     1651    b2-ostatok-start [2 + 3] =  b2-ostatok-start [2 + 3] + ostatok-start [2 + 3]
     1652    b2-ostatok-start [3 + 3] =  b2-ostatok-start [3 + 3] + ostatok-start [3 + 3]
     1653    .
     1654    assign
     1655     bi-ostatok-start [1 + 3] =  bi-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     1656     bi-ostatok-start [2 + 3] =  bi-ostatok-start [2 + 3] + ostatok-start [2 + 3]
     1657     bi-ostatok-start [3 + 3] =  bi-ostatok-start [3 + 3] + ostatok-start [3 + 3]
     1658    .
     1659      End.
     1660   If xshowsale or vat-sale Then DO:
     1661   run ost-line in this-procedure
     1662                  (input   x-store-code  ,
     1663                   input   x-store-type  ,
     1664                   input   gds-zap-artic     ,
     1665                   input   gds-zap-prod-code ,
     1666                   input   gds-zap-prod-type ,
     1667                   input   x-tog-shift       ,
     1668                   input   Fact-order-1               ,
     1669                   input   'crsa':U            ,
     1670                   input   '##,##':U    ,
     1671                   input   xtog-obj    ,
     1672                   output  quantity    ,
     1673                   output  coast_r     ,
     1674                   output  coast_v     ,
     1675                   output  vat_r       ,
     1676                   output  vat_v       ,
     1677                   output  slt_r       ,
     1678                   output  slt_v       ).
     1679   assign
     1680     ostatok-start [1 + 6]   = quantity
     1681    ostatok-start [2 + 6]   = if tprintrubl then coast_r else coast_v
     1682    ostatok-start [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1683    ostatok-start [10]        = if tprintrubl then slt_r   else slt_v
     1684    b1-ostatok-start [1 + 6] =  b1-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     1685    b1-ostatok-start [2 + 6] =  b1-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     1686    b1-ostatok-start [3 + 6] =  b1-ostatok-start [3 + 6] + ostatok-start [3 + 6]
     1687    b2-ostatok-start [1 + 6] =  b2-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     1688    b2-ostatok-start [2 + 6] =  b2-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     1689    b2-ostatok-start [3 + 6] =  b2-ostatok-start [3 + 6] + ostatok-start [3 + 6]
     1690    b1-ostatok-start [10] =  b1-ostatok-start [10] + ostatok-start [10]
     1691    b2-ostatok-start [10] =  b2-ostatok-start [10] + ostatok-start [10]
     1692    .
     1693    assign
     1694     bi-ostatok-start [1 + 6] =  bi-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     1695     bi-ostatok-start [2 + 6] =  bi-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     1696     bi-ostatok-start [3 + 6] =  bi-ostatok-start [3 + 6] + ostatok-start [3 + 6]
     1697     bi-ostatok-start [10] =  bi-ostatok-start [10] + ostatok-start [10]
     1698    .
     1699      End.
     1700   run ost-line in this-procedure
     1701                  (input   x-store-code  ,
     1702                   input   x-store-type  ,
     1703                   input   gds-zap-artic     ,
     1704                   input   gds-zap-prod-code ,
     1705                   input   gds-zap-prod-type ,
     1706                   input   x-tog-shift       ,
     1707                   input   Fact-order-2               ,
     1708                   input   'cost':U            ,
