     1286   end procedure.
     1287   PROCEDURE on-same-page :
     1288     define input parameter p-line-number as integer  no-undo .
     1289     if p-line-number > page-size( OutStream ) then do:
     1290       return .
     1291     end.
     1292     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     1293       page stream OutStream .
     1294     end.
     1295   end procedure.
