      741   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
      742     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      743     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
      744     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
      745   END FUNCTION.
      746   PROCEDURE get-red-line :
      747     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
      748     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      749     DO ON ERROR UNDO, RETURN ERROR :
      750       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
      751     END.
      752   END PROCEDURE.
      753   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      754     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      755     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      756     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      757   END FUNCTION.
      758   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      759     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      760     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      761     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      762   END FUNCTION.
      763   PROCEDURE get-number-grade :
      764     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      765     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      766     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      767     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      768     DO ON ERROR UNDO, RETURN ERROR :
      769       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      770       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      771       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      772       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      773                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      774       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      775     END.
      776   END PROCEDURE.
      777   PROCEDURE conv-sum-to-word :
      778     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      779     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      780     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      781     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      782     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      783     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      784     DO ON ERROR UNDO, RETURN ERROR :
      785       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      786       IF ERROR-STATUS :ERROR THEN DO:
      787         ASSIGN p-res = ?.
      788         UNDO, RETURN ERROR.
      789       END.
      790       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      791         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      792         IF jj < 15 THEN DO:
      793           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      794           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      795              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      796           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      797              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      798              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      799             IF jj = 12 THEN DO:
      800               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      801             END.       ELSE DO:
      802               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      803             END.
      804           END.
      805           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      806                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      807                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      808                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      809              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      810           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      811         END.
      812         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      813           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      814           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      815           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      816           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      817           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      818         END.                                        ELSE DO:
      819           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      820         END.
      821         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      822         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      823         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      824       END.
      825       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      826       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      827       ASSIGN p-res = TRIM( OutSum ).
      828     END.
      829   END PROCEDURE.
      830   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      831     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      832     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      833     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      834   END FUNCTION.
      835   PROCEDURE get-total-word :
      836     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      837     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      838     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      839     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      840     DO ON ERROR UNDO, RETURN ERROR :
      841       ASSIGN p-word = Word-Sum( p-sum ).
      842                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      843                         RedLine( p-word )
      844                  ) +
      845                         " ":U + p-curr + " ":U +
      846                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      847                         " ":U + p-part + ".".
      848                           END.
      849   END PROCEDURE.
