      914   define variable sym13 as character init ":"   no-undo.
      915   define variable sym14 as character init ":"   no-undo.
      916   define variable tb-code       as character    no-undo.
      917   define variable Price         as decimal no-undo.
      918   define variable UBL           as decimal no-undo .
      919   define variable b-qnty        as decimal no-undo.
      920   define variable b-stoim       as character no-undo .
      921   define variable b-price       as character no-undo .
      922   define variable B-service     as decimal no-undo.
      923   define variable B-ship        as decimal no-undo.
      924   define variable OKEI          as character    no-undo.
      925   define variable ProdName      as character    no-undo.
      926   define variable pp as character no-undo .
      927   define variable tord-date as date no-undo .
      928   DEFINE FRAME sl
      929           sym1 column-label ":!:!:!:!:"  format "X(1)" space(0)
      930           Lines_Counter COLUMN-LABEL "N!п/п! ! ! " format ">>>>9" space(0)
      931           sym2 column-label ":!:!:!:!:" format "X(1)" space(0)
      932           ub.goods.artic COLUMN-LABEL "Артикул! ! ! ! " format "X(16)" space(0)
      933           sym3 column-label ":!:!:!:!:" format "X(1)" space(0)
      934           ub.goods.gds-name COLUMN-LABEL "Наименование товара! ! ! ! " format "X(39)" space(0)
      935           Sym4 column-label ":!:!:!:!:" format "X(1)" space(0)
      936           tb-code COLUMN-LABEL "Код товара! ! ! ! " format "X(10)" space(0)
      937           sym5 column-label ":!:!:!:!:" format "X(1)" space(0)
      938           ub.goods.sort COLUMN-LABEL "Сорт! ! ! ! " format "X(4)" space(0)
      939           sym11 column-label ":!:!:!:!:" format "X(1)" space(0)
      940           ub.units.OKEI COLUMN-LABEL "Код!ед.!изм.!по!ОКЕИ" format ">>>>" space(0)
      941           sym6 column-label ":!:!:!:!:" format "X(1)" space(0)
      942           ub.units.unit-name COLUMN-LABEL "Наим!ед.!изм.! ! " format "X(4)" space(0)
      943           sym7 column-label ":!:!:!:!:" format "X(1)" space(0)
      944           B-qnty COLUMN-LABEL "Количество ! ! ! ! " format "->>>>>>>9.<<<" space(0)
      945           sym9 column-label ":!:!:!:!:" format "X(1)" space(0)
      946           B-PRICE COLUMN-LABEL "Цена           ! ! ! ! " format "x(14)" space(0)
      947           sym10 column-label ":!:!:!:!:" format "X(1)" space(0)
      948           B-stoim COLUMN-LABEL "Сумма ! ! ! ! " format "x(15)" space(0)
      949           sym12 column-label ":!:!:!:!:" format "X(1)" space(0)
      950          HEADER
      951           string( cur-time-print() ) AT 5 format "X(35)"
      952           string( "Поставка N " + trcv-code + "  " + trim (v-rcv-num) + " от  " + string ( tdoc-date , "99/99/9999" ) ) AT 47 format "X(63)"
      953           string( pp ) AT 90 format "X(19)"
      954           string( " Лист " + string( PAGE-NUMBER(OutStream) , ">>9") ) format "X(13)" SKIP
      955           UndLine format "X(136)" AT 1
      956           with width 136 down stream-io use-text NO-BOX.
      957   find first ub.ord-doc-rcv WHERE recid(ub.ord-doc-rcv) = rec_id NO-LOCK .
      958   assign
      959       tdoc-date = (if ub.ord-doc-rcv.status_ <> 'факт':U then ub.ord-doc-rcv.doc-date else ub.ord-doc-rcv.fact-date )
      960       tdoc-code = ub.ord-doc-rcv.doc-code
      961       trcv-code = ub.ord-doc-rcv.rcv-code
      962       .
      963   v-rcv-num = entry(1,ub.ord-doc-rcv.sub-par,chr(4)) .
      964   if ub.ord-doc-rcv.doc-code <> ? and ub.ord-doc-rcv.doc-code <> "" then do:
      965      define buffer buf_ord-doc for ub.ord-doc  .
      966      find first buf_ord-doc no-lock where buf_ord-doc.doc-code = ub.ord-doc-rcv.doc-code no-error .
      967      if available buf_ord-doc then
      968         v-ord-doc = buf_ord-doc.doc-code + " " + entry(1, buf_ord-doc.cli-out-doc, chr(4)) + " от " + string(buf_ord-doc.doc-date , "99/99/9999") .
      969   end.
      970   if session:set-wait-state("compiler") then.
      971   output STREAM OutStream to value( string( session:temp-directory +
      972                                        "rpt" + string( g#report-num ) ) )
      973                                        page-size  value(62) .
      974   assign
      975     Line    = fill("-", 136)
      976     UndLine = fill("_", 136)
      977     LineBuf = fill("_", 136) .
      978     if  CostPrice then DO:
      979                      IF PrintRubl
      980                        THEN Assign PP = "Учетные цены ".
      981                        Else Assign PP = "Учетные цены (б.в.)" .
      982                      End.
      983      Else DO:
      984                   IF PrintRubl
      985                        THEN Assign PP = "Цены док-та".
      986                        Else Assign PP = "Цены док-та (б.в.)" .
      987           End.
      988   if ub.ord-doc-rcv.exch-code = 0 then
      989       assign
      990           PrintRubl = true
      991           pp = "руб"
      992       .
      993   else do:
      994      FIND ub.currency NO-LOCK WHERE ub.currency.curr-code = ub.ord-doc-rcv.exch-code.
      995      assign
      996           PrintRubl = false
      997           pp = ub.currency.curr-abbr
      998           .
      999           end.
     1000   .
     1001   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1002   FIND This_Object  WHERE This_Object.obj-type = ub.ord-doc-rcv.obj-type
     1003                       AND This_Object.obj-code = ub.ord-doc-rcv.obj-code NO-LOCK.
     1004   FIND ub.clients  WHERE ub.clients.obj-type = 'орг':U
     1005                   AND ub.clients.obj-code = ub.ord-doc-rcv.host-code NO-LOCK.
     1006   define buffer buf_cli for ub.clients  .
     1007   find first buf_cli no-lock where
     1008              buf_cli.obj-code = ub.ord-doc-rcv.cli-code and
     1009              buf_cli.obj-type = ub.ord-doc-rcv.cli-type no-error .
     1010     case ub.ord-doc-rcv.obj-type :
     1011       when  'маг':U then do :
     1012           find ub.shop  where ub.shop.obj-code = ub.ord-doc-rcv.obj-code no-lock.
     1013           assign
     1014             b-adress = ub.shop.addres1
     1015             b-phone  = ub.shop.phone .
     1016       end.
     1017       when  'скл':U then do :
     1018           find ub.store  where ub.store.obj-code = ub.ord-doc-rcv.obj-code no-lock.
     1019           assign
     1020             b-adress = ub.store.addres1
     1021             b-phone  = ub.store.phone .
     1022       end.
     1023     end case.
     1024     assign
     1025      name1   = "ИНН " + t-inn + " " + caps( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     1026      adres1  = t-addres + " " + t-phone
     1027      name2   = This_Object.obj-name
     1028      adres2  = b-adress + '  ' + b-phone
     1029      .
     1030       case clients.obj-type:
     1031          when 'орг':U
     1032          then do:
     1033               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1034               if available ub.firm
     1035               then do:
     1036                   assign
     1037                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1038                       t-addres = t-addres
     1039                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1040                               then ""
     1041                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1042                             )
     1043                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1044                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1045                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1046                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1047                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1048                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1049                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1050                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1051                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1052                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1053                       t-phone = ub.firm.phone
     1054                       t-inn   = ub.firm.inn
     1055                       t-okpo  = ub.firm.okpo
     1056                   .
     1057               end.
     1058          end.
     1059          when 'маг':U
     1060          then do:
     1061               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1062               if available ub.shop
     1063               then do:
     1064                   assign
     1065                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1066                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1067                       t-phone = shop.phone
     1068                       t-inn = ""
     1069                       t-okpo = ""
     1070                   .
     1071               end.
     1072          end.
     1073          when 'скл':U
     1074          then do:
     1075               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1076               if available ub.store
     1077               then do:
     1078                   assign
     1079                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1080                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1081                       t-phone = ub.store.phone
     1082                       t-inn = ""
     1083                       t-okpo = ""
     1084                   .
     1085               end.
     1086          end.
     1087          when 'чел':U
     1088          then do:
     1089               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1090               if available ub.person
     1091               then do:
     1092                   assign
     1093                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1094                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1095                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1096                       t-phone = ub.person.phone1
     1097                       t-inn = ub.person.inn
     1098                       t-okpo = ub.person.okpo
     1099                   .
     1100               end.
     1101          end.
     1102       end case.
     1103   PUT STREAM OutStream
     1104                                                                        space(5) Line format  "X(19)" AT 42 + 76 skip
     1105       space(0)                                                        "| " AT 42 + 76 'код':U  AT 50 + 76   "|" AT 60 + 76 skip
     1106       space(0) "Форма по ОКУД" format "X(14)"                  AT 66 + 38  "| " AT 42 + 76 "0330226"            "|" AT 60 + 76 skip
     1107       space(0) string( Name1 + ' ' + Adres1 ) format "X(100)"
     1108                                        "по ОКПО" format "X(7)" AT  72 + 38 "| " AT  42 + 76 t-okpo format "X(16)" "|" AT 60 + 76 skip
     1109       space(0) string( CAPS( buf_cli.obj-name ) + " (" + string(buf_cli.obj-code) + ")" ) format "X(100)"
     1110                                                                       "| " AT 42 + 76                        "|" AT 60 + 76 skip
     1111       space(0) "Вид деятельности по ОКДП" format "X(25)" AT 55 + 38       "| " AT 42 + 76                        "|" AT 60 + 76 skip
     1112       space(0) "" format "X(26)" AT 53 + 38                               "| " AT 42 + 76 ub.ord-doc-rcv.doc-date
     1113                                                                              format "99/99/9999"        "|" AT 60 + 76 skip
     1114       space(0) "" format "X(29)" AT 50 + 38                               "| " AT 42 + 76
     1115                               (if ub.ord-doc-rcv.status_ <> 'факт':U then tdoc-date else ?) format "99/99/9999" "|" AT 60 + 76 skip
     1116       space(0) "Вид операции" format "X(12)" AT 67 + 38                   "| " AT 42 + 76 "  " format "X(16)"    "|" AT 60 + 76 skip
     1117                                                                        space(5) Line format  "X(19)" AT 42 + 76 skip(2)
     1118                                          space(79) Line format "X(33)" skip
     1119       space(56) string( "ПОСТАВКА") format "x(10)"
     1120                                         " | " at 79
     1121                                           ( string( trcv-code , "X(16)" ) + " | "
     1122                                           + string( tdoc-date , "99/99/9999" )
     1123                                       + " | "  + (if ub.ord-doc-rcv.status_ <> 'факт':U then string( "(" + CAPS(ub.ord-doc-rcv.status_) + ")" ) else ""))
     1124                                       + trim (v-rcv-num)
     1125                                            format "X(116)"
     1126                                            skip
     1127                                            space(79) Line format "X(33)" skip
     1128       space(0) "Заказчик " name2  format "X(130)" skip(1)
     1129       space(0) "Заказ " v-ord-doc  format "X(130)" skip(1)
     1130       space(0) "Адрес " adres2 format "X(40)"  skip(1)
     1131       space(0) "Поставку принял "
     1132                   UndLine format "X(25)" AT 25 UndLine format "X(50)" at 60 SKIP
     1133                     "должность" format "X(25)" AT 25 "фамилия,имя,отчество" format "X(50)" AT 60 SKIP(1)
     1134       "Заказ передал отборщику " UndLine format "X(25)" AT 25 UndLine format "X(50)" at 60 SKIP
     1135       "должность" format "X(25)" AT 25 "фамилия,имя,отчество" format "X(50)"  AT 60 SKIP(1)
     1136       space(0) "Подготовить и доставить на дом к "  String(ub.ord-doc-rcv.ship-time,"hh:mm")
     1137                                                                   String(ub.ord-doc-rcv.ship-date , "99/99/9999")
     1138                                                                   format "X(193)"  SKIP(2)
     1139       .
     1140    FORM with frame sl .
     1141   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142   form header
     1143     line format "X(136)" at 1 skip
     1144     "Продолжение - на следующей странице" at 30 skip
     1145     with frame bottomframe width 232 page-bottom no-labels no-box .
     1146   view stream outstream frame bottomframe .
     1147      run waitfram-show in this-procedure( 'Подождите ...' ) .
     1148   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   for each ub.ord-line-rcv where
     1150            ub.ord-line-rcv.rcv-code = ub.ord-doc-rcv.rcv-code and
     1151            ub.ord-line-rcv.doc-code = ub.ord-doc-rcv.doc-code
     1152            no-lock ,
     1153         first ub.goods where ub.goods.prod-type = ub.ord-line-rcv.prod-type and
     1154                           ub.goods.prod-code = ub.ord-line-rcv.prod-code and
     1155                           ub.goods.artic = ub.ord-line-rcv.artic no-lock break by (if sort-gr then  ub.goods.grp-name else ub.goods.artic) by ub.goods.artic
     1156                           :
     1157       find first ub.units where ub.units.unit-name = ub.ord-line-rcv.unit-cli no-lock no-error .
     1158       assign
     1159           lines_counter = lines_counter + 1  .
     1160       accumulate  (ub.ord-line-rcv.cli-qnty * ub.ord-line-rcv.price-cli) ( total )
     1161                    ub.ord-line-rcv.cli-qnty ( total )
     1162                    ub.goods.artic ( count ).
     1163       if sort-gr = true  and first-of (if sort-gr then  ub.goods.grp-name else ub.goods.artic) then do:
     1164         down stream outstream 1 with frame sl .
     1165         put stream outstream unformatted
     1166              string("_______________Группа : " + trim(caps(ub.goods.grp-name)) + undline)  format "X(136)"
     1167              skip .
     1168              end.
     1169               b-price = if ub.ord-line-rcv.price-cli = ? then "" else string(ub.ord-line-rcv.price-cli) .
     1170               b-qnty  = ub.ord-line-rcv.cli-qnty .
     1171               b-stoim =  if b-price = "" then "" else string(decimal(b-price) * b-qnty) .
     1172               b-service = ub.ord-doc-rcv.sum-service.
     1173               b-ship    = ub.ord-doc-rcv.sum-ship   .
     1174       display stream outstream
     1175         sym1
     1176         lines_counter
     1177         sym2
     1178         ub.goods.artic
     1179         sym3
     1180         ub.goods.gds-name
     1181         sym4
     1182         trim( string( ub.goods.gds-code )) @ tb-code
     1183         sym5
     1184         ub.units.okei
     1185         sym6
     1186         ub.units.unit-name
     1187         sym7
     1188         ub.goods.sort
     1189         sym9
     1190         b-price
     1191         sym10
     1192         b-qnty
     1193         sym11
     1194         b-stoim
     1195         sym12   with frame sl.
     1196         down stream outstream 1 with frame sl .
     1197         if print-graft = false  then  put stream outstream linebuf format "X(136)" skip.
     1198       if ( ( ( accum count ub.goods.artic ) modulo 10 ) = 0 ) and
     1199            ( ( accum count ub.goods.artic ) >= 10 ) then
     1200           run waitfram-show in this-procedure ( "Обработано строк : " + string( accum count ub.goods.artic ) ) .
     1201   end.
     1202   assign
     1203   b-sum1 = accum total (ub.ord-line-rcv.cli-qnty * ub.ord-line-rcv.price-cli)
     1204   b-sum-qnty = accum total (ub.ord-line-rcv.cli-qnty)
     1205   b-sum = b-service + b-ship   + b-sum1.
     1206     if b-sum1 = ? then do:
     1207       display stream outstream
     1208         "Итого " @ ub.units.unit-name
     1209         b-sum-qnty  @ b-qnty
     1210         sym9  sym10  sym7 sym12
     1211         with frame sl.
     1212      end.
     1213     else do:
     1214       display stream outstream
     1215         "Итого " @ ub.units.unit-name
     1216         b-sum-qnty  @ b-qnty
     1217         b-sum1  @ b-stoim
     1218         sym9  sym10  sym7 sym12
     1219         with frame sl.
     1220     end.
     1221      down stream outstream 1 with frame sl .
     1222       if print-graft = false then put stream outstream linebuf format "X(136)" skip.
     1223       put stream outstream
     1224         "Стоимость обслуживания:" + string( b-service , "->>>,>>>,>>9.99" ) + sym12 at 98 format "x(38)"  skip
     1225         "    Стоимость доставки:" + string( b-ship    , "->>>,>>>,>>9.99" ) + sym12 at 98 format "x(38)"  skip
     1226         if b-sum = ? then "" else
     1227         "                 Всего:" + string( b-sum     , "->>>,>>>,>>9.99" ) + sym12 at 98 format "x(38)"  skip.
     1228         down stream outstream 1 with frame sl .
     1229       if print-graft = false then put stream outstream linebuf at 101 format "x(40)" skip.
     1230   run rep/wp-qnty.p ( Lines_counter, output PropisCount).
     1231   run rep/wp-qnty.p ( B-Sum-qnty, output PropisQnty).
     1232   if NOT PrintRubl then
     1233       ASSIGN
     1234       PropisSum = Total-Word( B-Sum, ub.currency.curr-abbr, ub.currency.part-abbr )
     1235       abbr = pp
     1236       .
     1237   else
     1238       run rep/wp-rub.p ( B-Sum , output PropisSum, output abbr).
     1239    run on-same-page in this-procedure (input 23) .
     1240    HIDE stream OutStream FRAME BottomFrame .
     1241    PUT  STREAM OutStream
     1242               "Итого по поставке :" Skip
     1243                 "а) количество порядковых номеров: " + string(Lines_Counter) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     1244                 "б) общее количество единиц : " + string(B-Sum-qnty ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     1245                 if B-Sum = ? then "" else
     1246                 "в) на сумму : " + trim(string(B-Sum , "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr +
     1247                               " (" + PropisSum + ")"  format "x(179)"  at 18 SKIP(1)
     1248               "Расчет проверил "
     1249               LineBuf format "X(25)"     AT 18 LineBuf format "X(25)"   AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1250               "должность" format "X(25)" AT 18 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP(1)
     1251               "Отобранный товар проверил контролер-упаковщик : "  LineBuf format "X(25)" AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1252                                                                 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP(1)
     1253               "Товар выдал"  Skip
     1254               LineBuf format "X(25)"                              AT 18 LineBuf format "X(25)"   AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1255               "должность" format "X(25)" AT 18 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP(2)
     1256               "Заказчик стоимость поставки оплатил" format "X(35)"  LineBuf   AT 48 format "X(25)" skip
     1257                                                                   "подпись заказчика" AT 48 format "X(25)" SKIP
     1258               "Деньги в сумме " +
     1259               ( if B-Sum = ? then " " else
     1260               trim(string(b-Sum, "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr + " (" + PropisSum + ")"
     1261               )         format "x(179)"  SKIP(1)
     1262               "получил"
     1263               LineBuf format "X(25)"                              AT 18 LineBuf format "X(25)"   AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1264               "должность" format "X(25)"                          AT 18 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP
     1265               .
     1266   output stream OutStream CLOSE .
     1267   run waitfram-hide in this-procedure  .
     1268   define variable v-user-action as character no-undo .
     1269   define variable v-printed as logical   no-undo .
     1270   define variable DisabledOptions as integer   no-undo .
     1271   DisabledOptions = 0 .
     1272   run gbl/prnfilen.w
     1273     (input  ""
     1274     ,input  DisabledOptions
     1275     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1276     ,input  7
     1277     ,output v-user-action
     1278     ,output v-printed
     1279     ) .
     1280   procedure calc-sl :
     1281   define input parameter tt as character no-undo .
     1282   if tt = "artic":U THEN DO:
     1283   End.
     1284   if tt = "scala":U THEN DO:
