      178   def
      179    shared
      180   temp-table  obj-list no-undo
      181     field obj-type like ub.clients.obj-type
      182     field obj-code like ub.clients.obj-code
      183     field obj-name like ub.clients.obj-name
      184     field obj-id   as integer
