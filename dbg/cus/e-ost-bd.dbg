      614   define new global shared variable g#library  as handle no-undo .
      615   define new global shared variable g#library2 as handle no-undo .
      616   define variable var-report-r-b as character no-undo .
      617   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      619     (output var-report-r-b
      620     )  .
      621   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622     define variable v-cntxt-db-num        as integer   no-undo .
      623     define variable v-cntxt-userid        as character no-undo .
      624     define variable v-cntxt-level         as character no-undo .
      625     define variable v-cntxt-host-code-obj as integer   no-undo .
      626     define variable v-cntxt-obj-type      as character no-undo .
      627     define variable v-cntxt-obj-code      as integer   no-undo .
      628     define variable v-cntxt-db-num-obj    as integer   no-undo .
      629     define variable v-cntxt-is-admin      as logical   no-undo .
      630   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   define temp-table userobjs_temp-user-obj no-undo
      632     field obj-type as character
      633     field obj-code as integer
      634     index xpk is primary unique obj-type obj-code
      635     .
      636   procedure userobjs_clear :
      637     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      638     do
      639     on error undo, return error return-value
      640     :
      641       for each buf_userobjs_temp-user-obj
      642       on error undo, return error return-value
      643       :
      644         delete buf_userobjs_temp-user-obj .
      645       end.
      646     end.
      647   end .
      648   procedure userobjs_object-count :
      649     define output parameter p-total-count as integer   no-undo .
      650     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      651     do
      652     on error undo, return error return-value
      653     :
      654       assign
      655         p-total-count = 0
      656       .
      657       for each buf_userobjs_temp-user-obj
      658       on error undo, return error return-value
      659       :
      660         assign
      661           p-total-count = p-total-count + 1
      662         .
      663       end.
      664     end.
      665   end.
      666   procedure userobjs_append :
      667      define input  parameter p-obj-type as character no-undo .
      668      define input  parameter p-obj-code as integer   no-undo .
      669     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      670     do
      671     on error undo, return error return-value
      672     :
      673       find first buf_userobjs_temp-user-obj
      674         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      675           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      676         no-error .
      677       if not available buf_userobjs_temp-user-obj
      678       then do:
      679         create buf_userobjs_temp-user-obj .
      680         assign
      681           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      682           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      683         .
      684       end.
      685     end.
      686   end.
      687   procedure userobjs_object-exist :
      688     define output parameter p-object-exist as logical   no-undo .
      689     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      690     do
      691     on error undo, return error return-value
      692     :
      693       find first buf_userobjs_temp-user-obj
      694         no-error .
      695       if not available buf_userobjs_temp-user-obj
      696       then do:
      697         assign
      698           p-object-exist = false
      699         .
      700       end.
      701       else do:
      702         assign
      703           p-object-exist = true
      704         .
      705       end.
      706     end.
      707   end.
      708   procedure userobjs_transfer :
      709     define input  parameter p-callback-handle as handle no-undo .
      710     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      711     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      712     do
      713     on error undo, return error return-value
      714     :
      715       if valid-handle(p-callback-handle) <> true
      716       then do:
      717         message
      718           vss-workfile vss-revision vss-description skip
      719           "Ошибка задания входных параметров" skip
      720           "Неизвестный указатель на процедуру" skip
      721           view-as alert-box error .
      722         undo, return error return-value .
      723       end.
      724       if p-callback-handle :get-signature("userobjs_append") = ""
      725       then do:
      726         message
      727           vss-workfile vss-revision vss-description skip
      728           "Ошибка задания входных параметров" skip
      729           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      730                     ,p-callback-handle :file-name
      731                     ) skip
      732           view-as alert-box error .
      733         undo, return error return-value .
      734       end.
      735       for each buf_userobjs_temp-user-obj
      736       on error undo, return error return-value
      737       :
      738         run userobjs_append in p-callback-handle
      739           (input  buf_userobjs_temp-user-obj.obj-type
      740           ,input  buf_userobjs_temp-user-obj.obj-code
      741           ) .
      742       end.
      743     end.
      744   end procedure.
      745   procedure userobjs_select-one :
      746      define input  parameter parparentproc     as widget-handle no-undo .
      747      define input  parameter p-db-num          as integer   no-undo .
      748      define input  parameter p-user-id         as character no-undo .
      749      define input  parameter p-host-code-obj   as integer   no-undo .
      750      define input  parameter p-obj-type        as character no-undo .
      751      define input  parameter p-obj-code        as integer   no-undo .
      752      define output parameter p-user-select     as logical   no-undo .
      753      define output parameter p-select-obj-type as character no-undo .
      754      define output parameter p-select-obj-code as character no-undo .
      755     do
      756     on error undo, return error return-value
      757     :
      758       run gbl/userobjs.w
      759         (input  parparentproc
      760         ,input  this-procedure :handle
      761         ,input  p-db-num
      762         ,input  p-user-id
      763         ,input  p-host-code-obj
      764         ,input  p-obj-type
      765         ,input  p-obj-code
      766         ,INPUT  "b-sel"
      767         ,output p-user-select
      768         ,output p-select-obj-type
      769         ,output p-select-obj-code
      770         ) .
      771     end.
      772   end.
      773   procedure userobjs_select-many :
      774     define input  parameter parparentproc   as widget-handle no-undo .
      775     define input  parameter p-db-num        as integer   no-undo .
      776     define input  parameter p-user-id       as character no-undo .
      777     define input  parameter p-host-code-obj as integer   no-undo .
      778     define input  parameter p-obj-type      as character no-undo .
      779     define input  parameter p-obj-code      as integer   no-undo .
      780     define output parameter p-user-select   as logical   no-undo .
      781     define variable v-select-obj-type as character no-undo .
      782     define variable v-select-obj-code as integer   no-undo .
      783     do
      784     on error undo, return error return-value
      785     :
      786       run gbl/userobjs.w
      787         (input  parparentproc
      788         ,input  this-procedure :handle
      789         ,input  p-db-num
      790         ,input  p-user-id
      791         ,input  p-host-code-obj
      792         ,input  p-obj-type
      793         ,input  p-obj-code
      794         ,INPUT  "b-sel,b-mark"
      795         ,output p-user-select
      796         ,output v-select-obj-type
      797         ,output v-select-obj-code
      798         ) .
      799     end.
      800   end.
      801   procedure thobjs :
      802      define input        parameter parparentproc     as widget-handle no-undo .
      803      define input        parameter i-bttns           as character     no-undo .
      804      define input        parameter i-list-mode       as character     no-undo.
      805      define input        parameter i-obj-type        as character     no-undo.
      806      define input        parameter i-db-num          as integer       no-undo.
      807      define input        parameter i-host-code       as integer       no-undo.
      808      define input-output parameter p-rid-list        as character     no-undo .
      809   run ref/thobjs.p
      810           ( input parparentproc
      811            ,input  this-procedure :handle
      812           , input i-bttns
      813           , input i-list-mode
      814           , input i-obj-type
      815           , input i-db-num
      816           , input i-host-code
      817           , input-output p-rid-list ) no-error .
      818   end.
      819   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      820   ASSIGN parParentProc =  my-handle .
      821   DEFINE VARIABLE FILL-IN-3 AS INTEGER FORMAT ">>9":U INITIAL 0
      822        VIEW-AS FILL-IN
      823        SIZE 5.25 BY 1 NO-UNDO.
      824   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      825        VIEW-AS RADIO-SET VERTICAL
      826        RADIO-BUTTONS
      827             "Нет", 1,
      828   "Выборочно", 2
      829        SIZE 23.88 BY 1.96 NO-UNDO.
      830   DEFINE VARIABLE RADIO-SET-2 AS INTEGER
      831        VIEW-AS RADIO-SET VERTICAL
      832        RADIO-BUTTONS
      833             "Нет", 1,
      834   "Выборочно", 2
      835        SIZE 23.88 BY 1.96 NO-UNDO.
      836   DEFINE RECTANGLE RECT-5
      837        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      838        SIZE 49 BY 4.42.
      839   DEFINE RECTANGLE RECT-6
      840        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      841        SIZE 49 BY 4.42.
      842   DEFINE RECTANGLE RECT-7
      843        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      844        SIZE 36.38 BY 5.21.
      845   DEFINE VARIABLE TOGGLE-1 AS LOGICAL INITIAL no
      846        LABEL "Только итоги"
      847        VIEW-AS TOGGLE-BOX
      848        SIZE 17.38 BY .83 NO-UNDO.
      849   DEFINE VARIABLE TOGGLE-2 AS LOGICAL INITIAL no
      850        LABEL "по группам с уровня"
      851        VIEW-AS TOGGLE-BOX
      852        SIZE 23.63 BY .83 NO-UNDO.
      853   DEFINE FRAME F-Main
      854        TOGGLE-1 AT ROW 3.63 COL 3.75
      855        FILL-IN-3 AT ROW 4.54 COL 26.5 COLON-ALIGNED NO-LABEL
      856        TOGGLE-2 AT ROW 4.71 COL 3.63
      857        RADIO-SET-1 AT ROW 9.21 COL 5.25 NO-LABEL
      858        RADIO-SET-2 AT ROW 14.08 COL 5.25 NO-LABEL
      859        "Объекты, показываемые отдельно от всех БД:" VIEW-AS TEXT
      860             SIZE 44.63 BY 1.17 AT ROW 12.46 COL 3.75
      861             FGCOLOR 4
      862        "Просмотр :" VIEW-AS TEXT
      863             SIZE 26.88 BY 1 AT ROW 1.83 COL 3.63
      864             FGCOLOR 4
      865        "Объекты, показываемые отдельно от своей БД:" VIEW-AS TEXT
      866             SIZE 44.63 BY 1.17 AT ROW 7.58 COL 3.38
      867             FGCOLOR 4
      868        RECT-6 AT ROW 12 COL 2
      869        RECT-5 AT ROW 7.13 COL 2
      870        RECT-7 AT ROW 1.21 COL 2.38
      871       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      872            SIDE-LABELS NO-UNDERLINE THREE-D
      873            AT COL 1 ROW 1 SCROLLABLE .
      874   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      875   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      876   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      877   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      878   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      879   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      880   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      881   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      882         adm-object-hdl = FRAME F-Main:HANDLE.
      883   RUN ensure-broker.
      884   THIS-PROCEDURE:ADM-DATA =
      885        'ADM1.1~`':U +
      886        'SmartObject~`':U +
      887        '~`':U +
      888        'NO ~`':U +
      889        '~`':U +
      890        '~`':U +
      891        '~`':U +
      892        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      893           + "~`":U +
      894        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      895        'Record-Source,Record-Target,TableIO-Target~`':U +
      896        '~`':U +
      897        '~`~`~`~`~`~`~`~`~`~`~`':U +
      898        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      899            THEN "^^":U
      900        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      901             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      902   PROCEDURE adm-apply-entry :
      903     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      904   END PROCEDURE.
      905   PROCEDURE adm-destroy :
      906    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      907   END PROCEDURE.
      908   PROCEDURE adm-disable :
      909       DISABLE RECT-6 RECT-5 RECT-7 TOGGLE-1 RADIO-SET-1 RADIO-SET-2 WITH FRAME F-Main.
      910       RUN dispatch ('disable-fields':U).
      911       RUN set-attribute-list ('ENABLED=no':U).
      912       RETURN.
      913   END PROCEDURE.
      914   PROCEDURE adm-edit-attribute-list :
      915         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      916         RETURN.
      917   END PROCEDURE.
      918   PROCEDURE adm-enable :
      919       ENABLE UNLESS-HIDDEN RECT-6 RECT-5 RECT-7 TOGGLE-1 RADIO-SET-1 RADIO-SET-2 WITH FRAME F-Main.
      920       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      921       RUN set-attribute-list ('ENABLED=yes':U).
      922       RETURN.
      923   END PROCEDURE.
      924   PROCEDURE adm-exit :
      925        RUN notify ('exit':U).
      926     RETURN.
      927   END PROCEDURE.
      928   PROCEDURE adm-hide :
      929     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      930   END PROCEDURE.
      931   PROCEDURE adm-initialize :
      932     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      933   END PROCEDURE.
      934   PROCEDURE adm-show-errors :
      935       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      936       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      937           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      938       END.
      939       RETURN.
      940   END PROCEDURE.
      941   PROCEDURE adm-UIB-mode :
      942     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      943   END PROCEDURE.
      944   PROCEDURE adm-view :
      945     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      946   END PROCEDURE.
      947   PROCEDURE dispatch :
      948       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      949       RUN broker-dispatch IN adm-broker-hdl
      950           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      951       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      952   END PROCEDURE.
      953   PROCEDURE ensure-broker :
      954   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      955   IF RETURN-VALUE NE "ADM-Broker":U THEN
      956   DO:
      957       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      958       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      959   END.
      960   END PROCEDURE.
      961   PROCEDURE get-attribute :
      962     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      963     RUN broker-get-attribute IN adm-broker-hdl
      964         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      965     RETURN RETURN-VALUE.
      966   END PROCEDURE.
      967   PROCEDURE get-attribute-list :
      968     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      969     RUN broker-get-attribute-list IN adm-broker-hdl
      970         (INPUT THIS-PROCEDURE,
      971          INPUT ?,
      972          OUTPUT p-attr-list) NO-ERROR.
      973     RETURN.
      974   END PROCEDURE.
      975   PROCEDURE new-state :
      976     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      977     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      978     RETURN.
      979   END PROCEDURE.
      980   PROCEDURE notify :
      981     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      982     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      983     IF RETURN-VALUE = "ADM-ERROR":U THEN
      984         RETURN "ADM-ERROR":U.
      985     RETURN.
      986   END PROCEDURE.
      987   PROCEDURE set-attribute-list :
      988     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      989     RUN ensure-broker.
      990     RUN broker-set-attribute-list IN adm-broker-hdl
      991         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      992     RETURN.
      993   END PROCEDURE.
      994   PROCEDURE set-position :
      995       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      996       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      997       IF VALID-HANDLE(adm-object-hdl) THEN
      998       DO:
      999         ASSIGN adm-object-hdl:ROW    =   p-row
     1000                adm-object-hdl:COLUMN =   p-col.
     1001       END.
     1002       RETURN.
     1003   END PROCEDURE.
     1004   PROCEDURE adm-display-fields :
     1005       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1006       RETURN.
     1007   END PROCEDURE.
     1008   PROCEDURE adm-open-query :
     1009     RETURN.
     1010   END PROCEDURE.
     1011   PROCEDURE adm-row-changed :
     1012         IF VALID-HANDLE(adm-object-hdl) THEN
     1013           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1014         RUN notify ('row-available':U).
     1015         RETURN.
     1016   END PROCEDURE.
     1017   PROCEDURE reposition-query :
     1018       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1019       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1020       RETURN.
     1021   END PROCEDURE.
     1022     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1023     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1024     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1025     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1026     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1027     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1028     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1029     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1030     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1031     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1032     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1033     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1034     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1035     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1036     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1037     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1038     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1039     IF "":U = "":U THEN
     1040       RUN modify-list-attribute IN adm-broker-hdl
     1041         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1042     RUN use-create-on-add(?).
     1043   PROCEDURE adm-add-record :
     1044       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1045          "must have at least one Enabled Table to perform Add.":U
