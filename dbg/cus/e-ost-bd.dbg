     1088   END PROCEDURE.
     1089   PROCEDURE adm-end-update :
     1090     RETURN.
     1091   END PROCEDURE.
     1092   PROCEDURE adm-reset-record :
     1093       RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE adm-update-record :
     1096       MESSAGE
     1097         "Object ":U THIS-PROCEDURE:FILE-NAME
     1098           "must have at least one Enabled Table to perform Update.":U
     1099             VIEW-AS ALERT-BOX ERROR.
     1100      RETURN.
     1101   END PROCEDURE.
     1102   PROCEDURE check-modified :
     1103   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1104   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1105   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1106   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1107     IF check-state = "check":U THEN
     1108     DO:
     1109       RUN get-link-handle IN adm-broker-hdl
     1110         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1111            OUTPUT group-target-list).
     1112       IF group-target-list NE "":U THEN
     1113       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1114         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1115         RUN check-modified IN curr-widget ('group-check':U).
     1116         IF RETURN-VALUE NE "":U THEN
     1117         DO:
     1118           RUN check-modified-message(RETURN-VALUE).
     1119           RETURN "":U.
     1120         END.
     1121       END.
     1122     END.
     1123     RETURN "":U.
     1124   END PROCEDURE.
     1125   PROCEDURE check-modified-message :
     1126     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1127        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1128           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1129        IF RETURN-VALUE = "YES":U THEN
     1130           RUN notify ('view,CONTAINER-SOURCE':U).
     1131        MESSAGE IF p-changed-table NE ? THEN
     1132           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1133           ELSE "Current values have been changed."
     1134           SKIP "  Do you wish to save those changes?"
     1135           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1136        IF ANS THEN
     1137        DO:
     1138           IF group-assign-target THEN
     1139             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1140           ELSE RUN dispatch('update-record':U).
     1141           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1142           DO:
     1143               MESSAGE "Changes to the previous record were not saved."
     1144                 VIEW-AS ALERT-BOX ERROR.
     1145               IF group-assign-target THEN
     1146                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1147               ELSE RUN dispatch ('cancel-record':U).
     1148           END.
     1149        END.
     1150        ELSE DO:
     1151          IF group-assign-target THEN
     1152             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1153          ELSE RUN dispatch('cancel-record':U).
     1154        END.
     1155        RETURN.
     1156   END PROCEDURE.
     1157   PROCEDURE get-rowid :
     1158       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1159       ASSIGN
     1160       p-table   =   adm-first-table.
     1161       RETURN.
     1162   END PROCEDURE.
     1163   PROCEDURE init-group-assign :
     1164       RUN request-attribute IN adm-broker-hdl
     1165         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1166       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1167         group-assign-target = yes.
     1168       ELSE group-assign-target = no.
     1169       RETURN.
     1170   END PROCEDURE.
     1171   PROCEDURE set-editors :
     1172       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1173       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1174       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1175       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1176       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1177       DO WHILE VALID-HANDLE (curr-widget):
     1178           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1179              curr-widget:HIDDEN = no THEN DO:
     1180             CASE p-field-setting:
     1181               WHEN "INITIALIZE":U THEN
     1182               DO:
     1183                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1184                     read-only-list +
     1185                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1186                        STRING(curr-widget).
     1187               END.
     1188               WHEN "DISABLE":U OR
     1189               WHEN "ENABLE":U THEN
     1190               DO:
     1191                   curr-widget:SENSITIVE = yes.
     1192                   RUN get-attribute ('Read-Only-Editors':U).
     1193                   IF RETURN-VALUE = ? OR
     1194                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1195                       curr-widget:READ-ONLY =
     1196                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1197               END.
     1198               WHEN "CLEAR":U THEN
     1199                   curr-widget:SCREEN-VALUE = "":U.
     1200             END CASE.
     1201           END.
     1202           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1203       END.
     1204       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1205         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1206           + '"':U).
     1207       RETURN.
     1208   END PROCEDURE.
     1209   PROCEDURE use-check-modified-all :
     1210    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1211     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1212     RETURN.
     1213   END PROCEDURE.
     1214   PROCEDURE use-create-on-add :
     1215   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1216      RETURN.
     1217   END PROCEDURE.
     1218   PROCEDURE use-initial-lock :
     1219     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1220     ASSIGN adm-initial-lock = p-attr-value.
     1221     RETURN.
     1222   END PROCEDURE.
     1223     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1224   ASSIGN
     1225          FRAME F-Main:SCROLLABLE       = FALSE
     1226          FRAME F-Main:HIDDEN           = TRUE.
     1227   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME F-Main
     1228   DO:
     1229     assign RADIO-SET-1 .
     1230     assign Obj1-list = "" .
     1231     if RADIO-SET-1 = 2 then do:
     1232       define variable v-user-select as logical   no-undo .
     1233   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1234   run userobjs_select-many in this-procedure
     1235     (input  my-handle
     1236     ,input  v-cntxt-db-num
     1237     ,input  v-cntxt-userid
     1238     ,input  v-cntxt-host-code-obj
     1239     ,input  v-cntxt-obj-type
     1240     ,input  v-cntxt-obj-code
     1241     ,output v-user-select
     1242     )  .
     1243       if v-user-select <> true then do:
     1244         assign RADIO-SET-1 = 1 .
     1245         display RADIO-SET-1 with frame F-Main .
     1246       end.
     1247       else do:
     1248         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1249         for each buf_userobjs_temp-user-obj :
     1250           if Obj1-list = "" then
     1251             assign  Obj1-list = Obj1-list + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1252           else
     1253             assign  Obj1-list = Obj1-list + "," + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1254         end.
     1255       end.
     1256     end.
     1257   END.
     1258   ON VALUE-CHANGED OF RADIO-SET-2 IN FRAME F-Main
     1259   DO:
     1260     assign RADIO-SET-2 .
     1261     assign Obj2-list = "" .
     1262     if RADIO-SET-2 = 2 then do:
     1263       define variable v-user-select as logical   no-undo .
     1264   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   run userobjs_select-many in this-procedure
     1266     (input  my-handle
     1267     ,input  v-cntxt-db-num
     1268     ,input  v-cntxt-userid
     1269     ,input  v-cntxt-host-code-obj
     1270     ,input  v-cntxt-obj-type
     1271     ,input  v-cntxt-obj-code
     1272     ,output v-user-select
     1273     )  .
     1274       if v-user-select <> true then do:
     1275         assign RADIO-SET-2 = 1 .
     1276         display RADIO-SET-2 with frame F-Main .
     1277       end.
     1278       else do:
     1279         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1280         for each buf_userobjs_temp-user-obj :
     1281           if Obj2-list = "" then
     1282             assign  Obj2-list = Obj2-list + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1283           else
     1284             assign  Obj2-list = Obj2-list + "," + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1285         end.
     1286       end.
     1287     end.
     1288   END.
     1289   ON VALUE-CHANGED OF TOGGLE-1 IN FRAME F-Main
     1290   DO:
     1291     assign TOGGLE-1 .
     1292     if TOGGLE-1 = yes then ENABLE  TOGGLE-2 FILL-IN-3 WITH FRAME F-Main.
     1293     else                   DISABLE TOGGLE-2 FILL-IN-3 WITH FRAME F-Main.
     1294   END.
     1295   if not this-procedure :persistent
     1296   then do:
     1297     message
     1298       vss-workfile vss-revision vss-description skip
     1299       "Ошибка при запуске процедуры" skip
     1300       "Данную процедуру следует запускать только с параметром persistent" skip
     1301       view-as alert-box error .
     1302     undo, return error .
     1303   end.
     1304   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1305     run mainmenu_getcntxt in parparentproc
     1306       (output v-cntxt-db-num
     1307       ,output v-cntxt-userid
     1308       ,output v-cntxt-level
     1309       ,output v-cntxt-host-code-obj
     1310       ,output v-cntxt-obj-type
     1311       ,output v-cntxt-obj-code
     1312       ,output v-cntxt-db-num-obj
     1313       ,output v-cntxt-is-admin
     1314       ) .
     1315       run get-userid  in parParentProc ( output g#userid ).
     1316   PROCEDURE disable_UI :
     1317     HIDE FRAME F-Main.
     1318     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1319   END PROCEDURE.
     1320   PROCEDURE local-apply-layout :
     1321     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1322   END PROCEDURE.
     1323   PROCEDURE my-report :
     1324   define variable lavel as integer no-undo .
     1325     if TOGGLE-2 = yes then assign lavel = FILL-IN-3 .
     1326     else                   assign lavel = -1 .
     1327     run cus/r-ost-bd.p (RADIO-SET-1, Obj1-list, RADIO-SET-2, Obj2-list, TOGGLE-1, lavel ) .
     1328   END PROCEDURE.
     1329   PROCEDURE my-var :
     1330     Assign frame F-Main RADIO-SET-1 RADIO-SET-2 TOGGLE-1 TOGGLE-2 FILL-IN-3 .
     1331     Assign
     1332       STR-obj-type = ''
     1333       STR-obj-code = ''
     1334       STR-obj-name = ''
     1335       STR-obj      = ''
     1336     .
     1337     For each obj-list no-lock:
     1338       Assign
     1339         STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1340         STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1341         STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1342         STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1343       .
     1344     End.
     1345     assign
     1346       str1 = "Остатки по УБД на " + String(x-date-start,"99/99/9999")
     1347     .
     1348   END PROCEDURE.
     1349   PROCEDURE state-changed :
     1350     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1351     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1352     CASE p-state:
     1353       when "link-changed":U then  DO:
     1354            Run my-var.
     1355            End.
     1356     END CASE.
     1357   END PROCEDURE.
