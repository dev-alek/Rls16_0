     1064        "must have at least one Enabled Table to perform Copy.":U
     1065          VIEW-AS ALERT-BOX ERROR.
     1066       RETURN.
     1067   END PROCEDURE.
     1068   PROCEDURE adm-create-record :
     1069      RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE adm-current-changed :
     1072     RETURN.
     1073   END PROCEDURE.
     1074   PROCEDURE adm-delete-record :
     1075    MESSAGE
     1076          "Object ":U THIS-PROCEDURE:FILE-NAME
     1077            "must have at least one Enabled Table to perform Delete.":U
     1078              VIEW-AS ALERT-BOX ERROR.
     1079       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1080       RETURN.
