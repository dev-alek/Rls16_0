     1055     END PROCEDURE.
     1056   PROCEDURE adm-assign-statement :
     1057     RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE adm-cancel-record :
     1060      RETURN.
     1061     END PROCEDURE.
     1062   PROCEDURE adm-copy-record :
