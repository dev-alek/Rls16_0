      490     Col-name[177]= 'FU':U
      491     Col-name[178]= 'FV':U
      492     Col-name[179]= 'FW':U
      493     Col-name[180]= 'FX':U
      494     Col-name[181]= 'FY':U
      495     Col-name[182]= 'FZ':U
      496     Col-name[183]= 'GA':U
      497     Col-name[184]= 'GB':U
      498     Col-name[185]= 'GC':U
      499     Col-name[186]= 'GD':U
      500     Col-name[187]= 'GE':U
      501     Col-name[188]= 'GF':U
      502     Col-name[189]= 'GG':U
      503     Col-name[190]= 'GH':U
      504     Col-name[191]= 'GI':U
      505     Col-name[192]= 'GJ':U
      506     Col-name[193]= 'GK':U
      507     Col-name[194]= 'GL':U
      508     Col-name[195]= 'GM':U
      509     Col-name[196]= 'GN':U
      510     Col-name[197]= 'GO':U
      511     Col-name[198]= 'GP':U
      512     Col-name[199]= 'GQ':U
      513     Col-name[200]=   'GR':U
      514     Col-name[201]=   'GS':U
      515     Col-name[202]=   'GT':U
      516     Col-name[203]=   'GU':U
      517     Col-name[204]=   'GV':U
      518     Col-name[205]=   'GW':U
      519     Col-name[206]=   'GX':U
      520     Col-name[207]=   'GY':U
      521     Col-name[208]=   'GZ':U
      522     Col-name[209]=   'HA':U
      523     Col-name[210]=   'HB':U
      524     Col-name[211]=   'HC':U
      525     Col-name[212]=   'HD':U
      526     Col-name[213]=   'HE':U
      527     Col-name[214]=   'HF':U
      528     Col-name[215]=   'HG':U
      529     Col-name[216]=   'HH':U
      530     Col-name[217]=   'HI':U
      531     Col-name[218]=   'HJ':U
      532     Col-name[219]=   'HK':U
      533     Col-name[220]=   'HL':U
      534     Col-name[221]=   'HM':U
      535     Col-name[222]=   'HN':U
      536     Col-name[223]=   'HO':U
      537     Col-name[224]=   'HP':U
      538     Col-name[225]=   'HQ':U
      539     Col-name[226]=   'HR':U
      540     Col-name[227]=   'HS':U
      541     Col-name[228]=   'HT':U
      542     Col-name[229]=   'HU':U
      543     Col-name[230]=   'HV':U
      544     Col-name[231]=   'HW':U
      545     Col-name[232]=   'HX':U
      546     Col-name[233]=   'HY':U
      547     Col-name[234]=   'HZ':U
      548     Col-name[235]=   'IA':U
      549     Col-name[236]=   'IB':U
      550     Col-name[237]=   'IC':U
      551     Col-name[238]=   'ID':U
      552     Col-name[239]=   'IE':U
      553     Col-name[240]=   'IF':U
      554     Col-name[241]=   'IG':U
      555     Col-name[242]=   'IH':U
      556     Col-name[243]=   'II':U
      557     Col-name[244]=   'IJ':U
      558     Col-name[245]=   'IK':U
      559     Col-name[246]=   'IL':U
      560     Col-name[247]=   'IM':U
      561     Col-name[248]=   'IN':U
      562     Col-name[249]=   'IO':U
      563     Col-name[250]=   'IP':U
      564     Col-name[251]=   'IQ':U
      565     Col-name[252]=   'IR':U
      566     Col-name[253]=   'IS':U
      567     Col-name[254]=   'IT':U
      568     Col-name[255]=   'IU':U
      569     Col-name[256]=   'IV':U
      570     .
      571    end.
      572   end procedure.
      573   define variable var-report-r-b as character no-undo .
      574   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      576     (output var-report-r-b
      577     )  .
      578   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define SHARED temp-table temp-cards no-undo
      580   field d-card like ub.dis-card.d-card
      581   field cli-type like ub.dis-card.cli-type
      582   field cli-code like ub.dis-card.cli-code
      583   field last-date like ub.chk-doc.chk-date
      584   field last-time like ub.chk-doc.chk-time
      585   field last-obj-type like ub.chk-doc.obj-type
      586   field last-obj-code like ub.chk-doc.obj-code
      587   index pi is unique primary
      588   d-card
      589   index iclients
      590   cli-type
      591   cli-code
      592   .
      593   define SHARED temp-table temp-gds no-undo
      594   field d-card like ub.dis-card.d-card
      595   field cli-type like ub.dis-card.cli-type
      596   field cli-code like ub.dis-card.cli-code
      597   field gds-code like ub.goods.gds-code
      598   field artic like ub.goods.artic
      599   field prod-type like ub.goods.prod-type
      600   field prod-code like ub.goods.prod-code
      601   field gds-name like ub.goods.gds-name
      602   field src-d-pcnt like ub.chk-doc.src-d-pcnt
      603   field chk-date like ub.chk-doc.chk-date
      604   field obj-code like ub.chk-doc.obj-code
      605   field cashier like ub.chk-doc.cashier
      606   field cashier-psn-code like ub.chk-doc.cashier-psn-code
      607   field sales-man like ub.chk-doc.sales-man
      608   field salesman-psn-code like ub.chk-doc.salesman-psn-code
      609   field d-pcnt as decimal
      610   field doc-qnty like ub.chk-gds.doc-qnty
      611   field price-base like ub.chk-gds.price-base
      612   field discnt like ub.chk-gds.discnt
      613   field cash-rate like ub.chk-doc.cash-rate
      614   field cash-scale like ub.chk-doc.cash-scale
      615   index pi is primary
      616   cli-type
      617   cli-code
      618   d-card
      619   gds-code
      620   .
      621   define variable Prodtype as char no-undo.
      622   define variable prodCode as integer no-undo.
      623   define variable v-grp-name as character no-undo .
      624   define variable v-gds-code like ub.goods.gds-code no-undo .
      625   define variable v-is-grp as logical no-undo .
      626   define variable v-first-level as character no-undo .
      627   define temp-table obj-host no-undo
      628   FIELd host-code like ub.sysconf.host-code
      629   index pi is primary unique host-code.
      630   define buffer buf_shop for ub.shop.
      631   define buffer buf_store for ub.store.
      632   if p-list = "ONE":U then do:
      633     CASE prodmode:
      634       when 3 then do:
      635         assign
      636         ProdType = Substr(FixProdAttr, 1, 3)
      637         ProdCode = integer(substr(FixProdAttr, 4))
      638         .
      639       end.
      640       when 2 then do:
      641         assign
      642         v-grp-name = FixProdAttr
      643         .
      644       end.
      645       when 5 then do:
      646         assign
      647         v-gds-code = integer(FixProdAttr)
      648         .
      649       end.
      650     end case.
      651   end.
      652   for each temp-cards:
      653     delete temp-cards.
      654   end.
      655   for each temp-gds:
      656     delete temp-gds.
      657   end.
      658   for each obj-host:
      659     DELETE obj-host.
      660   end.
      661   create obj-host.
      662   assign
      663   obj-host.host-code = 0
      664   .
      665   FOR EACH obj-list :
      666     if obj-list.obj-type = 'Ï‡„':U then do:
      667       find first buf_shop no-lock where
      668                 buf_shop.obj-code = obj-list.obj-code.
      669       find first obj-host no-lock where
      670                   obj-host.host-code = buf_shop.host-code no-error .
      671       if not available obj-host then do:
      672         create
      673         obj-host.
      674         assign
      675         obj-host.host-code = buf_shop.host-code
      676         .
      677       end.
      678     end.
      679     else do:
      680       find first buf_store no-lock where
      681                 buf_store.obj-code = obj-list.obj-code.
      682       find first obj-host no-lock where
      683                   obj-host.host-code = buf_store.host-code no-error .
      684       if not available obj-host then do:
      685         create
      686         obj-host.
      687         assign
      688         obj-host.host-code = buf_store.host-code
      689         .
      690       end.
      691     end.
      692     if can-find( FIRST ub.chk-doc WHERE
      693                       ub.chk-doc.obj-type = obj-list.obj-type AND
      694                       ub.chk-doc.obj-code = obj-list.obj-code AND
      695                       ub.chk-doc.chk-date >= startpoint AND
      696                       ub.chk-doc.chk-date <= endpoint AND
      697                       ub.chk-doc.d-card <> "" AND
      698                       ub.chk-doc.out-code <> ? ) then DO:
      699       _chk-doc:
      700       FOR EACH ub.chk-doc NO-LOCK WHERE
      701               ub.chk-doc.obj-type = obj-list.obj-type AND
      702               ub.chk-doc.obj-code = obj-list.obj-code AND
      703               ub.chk-doc.chk-date >= startpoint AND
      704               ub.chk-doc.chk-date <= endpoint AND
      705               ub.chk-doc.out-code <> ? ,
      706           FIRST ub.dis-card No-LOCK WHERE
      707                 ub.dis-card.d-card = ub.chk-doc.d-card:
      708         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
      709         PROCESS EVENTS .
      710         ACCUMULATE     ub.chk-doc.doc-code ( COUNT ) .
      711         if ( ( ACCUM COUNT ub.chk-doc.doc-code ) modulo 10 ) = 0 AND
      712             ( ACCUM COUNT ub.chk-doc.doc-code ) >= 10 then do:
      713           if valid-handle(p-call-handle)
      714           and p-call-handle:get-signature ('waifram-show':U) <> "":U then do:
      715             run waitfram-show in p-call-handle (
      716                                                 obj-list.obj-type + " N" + string( obj-list.obj-code ) +
      717                                                 v-proc-check + string( ACCUM COUNT ub.chk-doc.doc-code )
      718                                                 ).
      719           end.
      720         end.
      721         _gds:
      722         for each ub.chk-gds no-lock where
      723                 ub.chk-gds.doc-code = ub.chk-doc.doc-code,
      724             FIRST ub.bar-code No-LOCK WHERE
      725                   ub.bar-code.b-code = ub.chk-gds.b-code,
      726             FIRST ub.goods No-LOCK WHERE
      727                   ub.goods.gds-code = ub.bar-code.gds-code
      728                    :
      729   CASE p-list:
      730     when "ONE":U then do:
      731       case prodmode:
      732         when 3 then do:
      733           if (not ub.goods.prod-code = prodcode) or (not ub.goods.prod-type = Prodtype) then do:
      734             NEXT _GDS.
      735           end.
      736         end.
      737         WHEN 2 then do:
      738           if (not ub.goods.grp-name begins v-grp-name) then do:
      739             NEXT _GDS.
      740           end.
      741         end.
      742         when 5 then do:
      743           if (not ub.goods.gds-code = v-gds-code) then do:
      744             NEXT _GDS.
      745           end.
      746         end.
      747       end case.
      748     end.
      749     when "LIST":U then do:
      750       case prodmode:
      751         when 3 then do:
      752           IF NOT can-find(first g#cli No-LOCK where
      753                                 g#cli.obj-type = ub.goods.prod-type AND
      754                                 g#cli.obj-code = ub.goods.prod-code) then NEXT _gds.
      755         end.
      756         when 2 then do:
      757           assign
      758           v-first-level = substr(ub.goods.grp-name, 1, index(ub.goods.grp-name, chr(47)))
      759           .
      760           IF NOT can-find(first tmp#grp No-LOCK where
      761                                 tmp#grp.grp-name begins v-first-level ) then NEXT _gds.
      762           else do:
      763             assign
      764             v-is-grp = no
      765             .
      766             for each tmp#grp no-lock where
      767                      tmp#grp.grp-name begins v-first-level:
      768               if goods.grp-name begins tmp#grp.grp-name then assign v-is-grp = yes.
      769             end.
      770             if not v-is-grp then NEXT _gds.
      771           end.
      772         end.
      773         when 4 then do:
      774           IF NOT can-find(first gds-list No-LOCK where
      775                                 gds-list.gds-code = ub.goods.gds-code) then NEXT _gds.
      776         end.
      777       end case.
      778     end.
      779     otherwise do:
      780     end.
      781   end CASE.
      782           create temp-gds.
      783           assign
      784           temp-gds.d-card = ub.chk-doc.d-card
      785           temp-gds.cli-type = ub.dis-card.cli-type
      786           temp-gds.cli-code = ub.dis-card.cli-code
      787           temp-gds.gds-code = ub.goods.gds-code
      788           temp-gds.artic = ub.goods.artic
      789           temp-gds.prod-type = ub.goods.prod-type
      790           temp-gds.prod-code = ub.goods.prod-code
      791           temp-gds.gds-name = ub.goods.gds-name
      792           temp-gds.src-d-pcnt = (if (ub.chk-doc.src-d-pcnt <> ?)
      793                                  AND (ub.chk-doc.src-d-pcnt <> 0)
      794                                  then ub.chk-doc.src-d-pcnt
      795                                  else round(ub.chk-doc.discnt / ub.chk-doc.tot-doc * 100, 2)
      796                                  )
      797           temp-gds.chk-date = ub.chk-doc.chk-date
      798           temp-gds.obj-code = ub.chk-doc.obj-code
      799           temp-gds.cashier = ub.chk-doc.cashier
      800           temp-gds.cashier-psn-code = ub.chk-doc.cashier-psn-code
      801           temp-gds.sales-man = ub.chk-doc.sales-man
      802           temp-gds.salesman-psn-code = ub.chk-doc.salesman-psn-code
      803           temp-gds.d-pcnt = round(ub.chk-gds.discnt / ub.chk-gds.price-base * 100, 2)
      804           temp-gds.doc-qnty = ub.chk-gds.doc-qnty
      805           temp-gds.price-base = ub.chk-gds.price-base
      806           temp-gds.discnt = ub.chk-gds.discnt
      807           temp-gds.cash-rate = ub.chk-doc.cash-rate
      808           temp-gds.cash-scale = ub.chk-doc.cash-scale
      809           .
      810           FIND FIRST temp-cards WHERE
      811                     temp-cards.d-card = ub.chk-doc.d-card NO-ERROR .
      812           if NOT available temp-cards then  do:
      813             CREATE temp-cards .
      814             assign
      815             temp-cards.d-card = ub.chk-doc.d-card
      816             temp-cards.cli-type = ub.dis-card.cli-type
      817             temp-cards.cli-code = ub.dis-card.cli-code
      818             temp-cards.last-date = ub.chk-doc.chk-date
      819             temp-cards.last-time = ub.chk-doc.chk-time
      820             temp-cards.last-obj-type = ub.chk-doc.obj-type
      821             temp-cards.last-obj-code = ub.chk-doc.obj-code
      822             .
      823           end.
      824           else do:
      825             if ub.chk-doc.chk-date > temp-cards.last-date
      826             OR (ub.chk-doc.chk-date = temp-cards.last-date
      827                 AND
      828                 ub.chk-doc.chk-time >= temp-cards.last-time) then do:
      829               assign
      830               temp-cards.last-date = ub.chk-doc.chk-date
      831               temp-cards.last-time = ub.chk-doc.chk-time
      832               temp-cards.last-obj-type = ub.chk-doc.obj-type
      833               temp-cards.last-obj-code = ub.chk-doc.obj-code
      834               .
      835             end.
      836           end.
      837         END.
      838       END.
      839     END.
      840   END.
