      861   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      862   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      863   procedure fltopend_fltopend :
      864   define input parameter p-parent-handle as handle no-undo .
      865   define input parameter p-qh as handle no-undo .
      866   define input parameter p-flt-open-open-query  as character no-undo .
      867   define input parameter p-where-cond as character no-undo .
      868   define input parameter p-use-indFIRST-query-tail as character no-undo .
      869   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      870   define input parameter p-indexed-reposition as character no-undo .
      871     do
      872     on error undo, return error
      873     :
      874   define variable v-prepare-string as character no-undo .
      875   define variable glog as logical no-undo .
      876   assign
      877   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      878                      p-where-cond + chr(32)  +
      879                      p-use-indFIRST-query-tail + chr(32) +
      880                      p-use-ind-sort-clmn-by + chr(32) +
      881                      p-indexed-reposition
      882   .
      883   assign
      884   glog = p-qh:query-prepare(v-prepare-string) no-error .
      885   if not glog
      886   or error-status:error then do:
      887     message error-status:get-message(1) view-as alert-box .
      888     undo, return error .
      889   end.
      890   assign
      891   glog = p-qh:query-open no-error .
      892   if not glog
      893   or error-status:error then do:
      894     message error-status:get-message(1) view-as alert-box .
      895     undo, return error .
      896   end.
      897     end.
      898   end procedure.
      899   procedure fltopend_fltfindd :
      900   define input parameter p-parent-handle as handle no-undo .
      901   define input parameter p-qh as handle no-undo .
      902   define input parameter p-rowid as rowid no-undo .
      903   define input parameter p-next as logical no-undo .
      904   define input parameter p-lock as integer no-undo .
      905   define input parameter p-bh as handle no-undo .
      906   define input parameter p-where-cond as character no-undo .
      907   define input parameter p-use-index-phrase as character no-undo .
      908   define variable glog as logical no-undo .
      909   define variable v-qh as handle no-undo .
      910   define variable v-bh as handle no-undo .
      911   define variable v-recid as recid no-undo .
      912   define variable v-prepare-string as character no-undo .
      913   do
      914   on error undo, return error
      915   on stop undo, return error
      916   :
      917     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      918     create buffer v-bh for table p-bh buffer-name p-bh:name.
      919     create query v-qh.
      920     v-qh:set-buffers(v-bh).
      921     v-prepare-string = substitute("for each &1 &2 &3"
      922                                     ,v-bh:name
      923                                     ,p-where-cond
      924                                     ,p-use-index-phrase).
      925     glog = v-qh:query-prepare(v-prepare-string) no-error.
      926     if not glog then do:
      927       delete object v-qh.
      928       delete object v-bh.
      929       undo, return error .
      930     end.
      931     glog = v-qh:query-open no-error .
      932     if not glog then do:
      933       delete object v-qh.
      934       delete object v-bh.
      935       undo, return error .
      936     end.
      937     if p-next then do:
      938       v-qh:reposition-to-rowid(p-rowid) no-error .
      939       glog = v-qh:get-next( p-lock) no-error .
      940       glog = v-qh:get-next( p-lock) no-error .
      941       if not glog or v-qh:query-off-end = yes then do:
      942         glog = v-qh:get-first( p-lock) no-error .
      943       end.
      944     end.
      945     else do:
      946       glog = v-qh:get-first( p-lock) no-error .
      947     end.
      948     v-recid = v-bh:recid no-error .
      949     delete object v-qh.
      950     delete object v-bh.
      951     return string(v-recid) .
      952   end.
      953   end procedure.
      954   procedure fltopend_fltfindq :
      955   define input parameter p-parent-handle as handle no-undo .
      956   define input parameter p-qh as handle no-undo .
      957   define input parameter p-next as logical no-undo .
      958   define input parameter p-lock as integer no-undo .
      959   define input parameter p-flt-open-open-query  as character no-undo .
      960   define input parameter p-where-cond as character no-undo .
      961   define input parameter p-use-indFIRST-query-tail as character no-undo .
      962   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      963   define input parameter p-indexed-reposition as character no-undo .
      964   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      965   define variable glog as logical no-undo .
      966   define variable v-qh as handle no-undo .
      967   define variable v-bh as handle no-undo extent 18.
      968   define variable v-rowid as rowid no-undo extent 18.
      969   define variable v-ii as integer no-undo .
      970   define variable v-prepare-string as character no-undo .
      971   do
      972   on error undo, return error
      973   on stop undo, return error
      974   :
      975     create query v-qh.
      976     do v-ii = 1 to p-qh:num-buffers:
      977       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      978       assign
      979       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      980       no-error.
      981       v-qh:add-buffer(v-bh[v-ii]).
      982     end.
      983     assign
      984     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      985                       p-where-cond + chr(32)  +
      986                       p-use-indFIRST-query-tail + chr(32) +
      987                       p-use-ind-sort-clmn-by + chr(32) +
      988                       p-indexed-reposition
      989     .
      990     glog = v-qh:query-prepare( v-prepare-string) no-error .
      991     if not glog then do:
      992       delete object v-qh.
      993       do v-ii = 1 to p-qh:num-buffers:
      994         delete object v-bh[v-ii].
      995       end.
      996       undo, return error .
      997     end.
      998     glog = v-qh:query-open no-error .
      999     if not glog then do:
     1000       delete object v-qh.
     1001       do v-ii = 1 to p-qh:num-buffers:
     1002         delete object v-bh[v-ii].
     1003       end.
     1004       undo, return error .
     1005     end.
     1006     if p-next then do:
     1007       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1008       glog = v-qh:get-next( p-lock) no-error .
     1009       glog = v-qh:get-next( p-lock) no-error .
     1010       if not glog or v-qh:query-off-end = yes then do:
     1011         glog = v-qh:get-first( p-lock) no-error .
     1012       end.
     1013     end.
     1014     else do:
     1015       glog = v-qh:get-first( p-lock) no-error .
     1016     end.
     1017     do v-ii = 1 to p-qh:num-buffers:
     1018       assign
     1019       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1020       no-error.
     1021     end.
     1022     delete object v-qh.
     1023     do v-ii = 1 to p-qh:num-buffers:
     1024       delete object v-bh[v-ii].
     1025     end.
     1026   end.
     1027   end procedure.
