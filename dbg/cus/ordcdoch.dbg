     1084   STRING(buf_c-ord-doc.sys-time-int, "HH:MM")  FORMAT "x(6)" @ buf_c-ord-doc.sys-time-int COLUMN-LABEL "Время"
     1085   buf_c-ord-doc.corr-date  COLUMN-LABEL "Дата!изменения"
     1086   STRING(buf_c-ord-doc.corr-time, "HH:MM")  FORMAT "x(6)" @ buf_c-ord-doc.corr-time COLUMN-LABEL "Время!изменения"
     1087   buf_c-ord-doc.corr-user-name   COLUMN-LABEL "Кто менял!Код"
     1088   usrfulnf (buf_c-ord-doc.corr-user-name) COLUMN-LABEL "Кто менял!ФИО"
     1089   buf_c-ord-doc.corr-user-db-num COLUMN-LABEL "В !БД"  FORMAT ">>>>>9"
     1090       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 97.75 BY 10.04.
     1091   DEFINE FRAME Dialog-Frame
     1092        B-Cancel AT ROW 1 COL 1
     1093        B-sch AT ROW 1 COL 11
     1094        B-Help AT ROW 1 COL 89
     1095        BR-docs AT ROW 2.21 COL 1.25
     1096        BR-changes AT ROW 12.5 COL 1
     1097        SPACE(0.12) SKIP(0.00)
     1098       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1099            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1100            TITLE "История заказа"
     1101            CANCEL-BUTTON B-Cancel.
     1102   ASSIGN
     1103          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1104          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1105   ASSIGN
     1106          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1
     1107          BR-docs:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE
     1108          BR-docs:COLUMN-MOVABLE IN FRAME Dialog-Frame         = TRUE.
     1109   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1110   DO:
     1111     APPLY "END-ERROR":U TO SELF.
     1112   END.
     1113   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1114   DO:
     1115     run proc-b-sch in this-procedure no-error.
     1116     if not available buf_c-ord-doc then run OpenBr (yes, no, '':U).
     1117   END.
     1118   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1119   DO:
     1120   if available buf_c-ord-doc then do:
     1121     run proc-view-changes in this-procedure no-error.
     1122   end.
     1123   END.
     1124   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1125   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1126   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   on help of frame Dialog-Frame
     1128   do:
     1129     run gbl/app_help.p
     1130       (input this-procedure :file-name
     1131       ,input ''
     1132       ,input ?
     1133       ) no-error.
     1134     if error-status :error then do:
     1135       message
     1136         "Ошибка при вызове помощи"
     1137         error-status :get-message(1)
     1138         view-as alert-box .
     1139     end.
     1140   end.
     1141   run minbtn-set in this-procedure .
     1142   on choose of b-help in frame Dialog-Frame
     1143   do:
     1144     apply "help":u to frame Dialog-Frame .
     1145   end.
     1146   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147   procedure minbtn-set :
     1148       do
     1149           on error undo, return error return-value
     1150           :
     1151           define variable ii              as integer       no-undo .
     1152           define variable fh              as widget-handle no-undo .
     1153           define variable hh              as widget-handle no-undo .
     1154           define variable v-h             as handle        extent 4 no-undo .
     1155           define variable v-name-button   as character     no-undo .
     1156           define variable v-help-old-x    as decimal       no-undo .
     1157           define variable v-help-old-y    as decimal       no-undo .
     1158           define variable v-help-old-size as decimal       no-undo .
     1159           define variable v-frame-width   as decimal       no-undo .
     1160           define variable jj              as integer       no-undo .
     1161           do
     1162               on error undo, return error
     1163               :
     1164               assign
     1165                   v-frame-width = frame Dialog-Frame:width - 0.3
     1166                   fh            = frame Dialog-Frame:first-child
     1167                   hh            = fh:first-child
     1168                   ii            = 1
     1169                   .
     1170               do while valid-handle(hh):
     1171                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1172                   do:
     1173                       case lc(hh:name) :
     1174                           when "b-help" then
     1175                               do:
     1176                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1177                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1178                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1179                                   hh:TOOLTIP = "Помощь" .
     1180                                   v-help-old-x = hh:column .
     1181                                   v-help-old-y = hh:row    .
     1182                                   v-help-old-size = hh:width .
     1183                                   hh:width-chars = 2.5 .
     1184                               end.
     1185                           when "b-print" then
     1186                               do:
     1187                                   hh:load-image("cmp/b-print.bmp":u) .
     1188                                   hh:TOOLTIP = "Печать" .
     1189                                   v-h[ii] = hh:handle .
     1190                                   ii = ii + 1 .
     1191                                   hh:width-chars = 3 .
     1192                               end.
     1193                           when "b-history" or
     1194                           when "b-hist" then
     1195                               do:
     1196                                   hh:load-image("cmp/b-hist.bmp":u) .
     1197                                   hh:TOOLTIP = "История" .
     1198                                   v-h[ii] = hh:handle .
     1199                                   ii = ii + 1 .
     1200                                   hh:width-chars = 3 .
     1201                               end.
     1202                           when "b-sch" then
     1203                               do:
     1204                                   hh:load-image("cmp/b-sch.bmp":u) .
     1205                                   hh:TOOLTIP = "Установка Фильтра" .
     1206                                   v-h[ii] = hh:handle .
     1207                                   ii = ii + 1 .
     1208                                   hh:width-chars = 3 .
     1209                               end.
     1210                           when "b-hist-user" then
     1211                               do:
     1212                                   hh:load-image("cmp/b-hist.bmp":u) .
     1213                                   hh:TOOLTIP = "История пользователя" .
     1214                                   ii = ii + 1 .
     1215                               end.
     1216                       end case.
     1217                   end.
     1218                   hh = hh:next-sibling.
     1219               end.
     1220               b-help:column = v-frame-width - b-help:width-chars.
     1221               jj = 0.
     1222               repeat ii = 4 to 1 by -1 :
     1223                   if valid-handle (v-h[ii] ) then
     1224                   do:
     1225                       jj  = jj + 1 .
     1226                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1227                       v-h[ii]:row    = v-help-old-y .
     1228                   end.
     1229               end.
     1230           end.
     1231       end.
     1232   end procedure.
     1233   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1234   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1235   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1236   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1237   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1238   define variable v-diasize-current-frame-height as decimal   no-undo .
     1239   define variable v-diasize-change-size          as logical   no-undo .
     1240   define variable v-diasize-resize-button        as handle    no-undo .
     1241   define variable v-diasize-wndmax               as logical   no-undo .
     1242   define variable v-diasize-wndstore             as logical   no-undo .
     1243   define variable v-diasize-proc-name            as character no-undo .
     1244   define variable v-diasize-browse-handle        as handle    no-undo .
     1245   define variable v-diasize-browse-number        as integer   no-undo .
     1246   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1247   define temp-table temp-diasize-handle no-undo
     1248     field handle-value  as handle
     1249     field save-position as decimal
     1250     index xpk is primary unique handle-value
     1251     .
     1252   define temp-table temp-browse-handle no-undo
     1253     field browse-type   as character
     1254     field browse-number as integer
     1255     field browse-handle as handle
     1256     field original-size as decimal
     1257     index xpk is primary unique browse-type browse-number
     1258     index xie browse-type browse-handle
     1259   .
     1260   procedure diasize_change-height :
     1261     define input  parameter p-change-value  as decimal   no-undo .
     1262     define input  parameter p-move-resize   as logical   no-undo .
     1263     define variable v-field-group-handle    as handle    no-undo .
     1264     define variable v-object-handle         as handle    no-undo .
     1265     define variable v-frame-height          as decimal   no-undo .
     1266     define variable v-frame-virtual-height  as decimal   no-undo .
     1267     define variable v-browse-height         as decimal   no-undo .
     1268     define variable v-window-height         as decimal   no-undo .
     1269     define variable v-window-virtual-height as decimal   no-undo .
     1270     define variable v-change-sign           as integer   no-undo .
     1271     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1272     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1273     if p-change-value > 0
     1274     then do:
     1275       if frame Dialog-Frame :height + p-change-value
     1276           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1277       then do:
     1278         assign
     1279           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1280                           - (frame Dialog-Frame :height-chars)
     1281         .
     1282         if p-change-value <= 0
     1283         then do:
     1284           run diasize_position-resize-button in this-procedure .
     1285           return .
     1286         end.
     1287       end.
     1288     end.
     1289     if p-change-value < 0
     1290     then do:
     1291       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1292       then do:
     1293         assign
     1294           p-change-value = v-diasize-orig-frame-height
     1295                          - (frame Dialog-Frame :height-chars)
     1296         .
     1297         if p-change-value >= 0
     1298         then do:
     1299           run diasize_position-resize-button in this-procedure .
     1300           return .
     1301         end.
     1302       end.
     1303     end.
     1304     if p-change-value >= 0
     1305     then do:
     1306       assign
     1307         v-change-sign = 1
     1308       .
     1309     end.
     1310     else do:
     1311       assign
     1312         v-change-sign = -1
     1313       .
     1314     end.
     1315     assign
     1316       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1317     .
     1318     if p-change-value = 0
     1319     then do:
     1320       run diasize_position-resize-button in this-procedure .
     1321       return .
     1322     end.
     1323     move_block:
     1324     do
     1325     on error undo move_block, retry move_block
     1326     :
     1327       if retry
     1328       then do:
     1329         do
     1330         on error undo move_block, leave move_block
     1331         :
     1332           if p-change-value > 0
     1333           then do:
     1334             for each buf_temp-diasize-handle
     1335             on error undo, next
     1336             :
     1337               assign
     1338                 v-object-handle = buf_temp-diasize-handle.handle-value
     1339               .
     1340               if v-object-handle <> v-diasize-resize-button
     1341               then do:
     1342                 assign
     1343                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1344                 .
     1345               end.
     1346             end.
     1347             assign
     1348               v-diasize-browse-handle :height = v-browse-height
     1349             .
     1350             for each buf_temp-browse-handle
     1351               where buf_temp-browse-handle.browse-type = 'height':u
     1352             on error undo, next
     1353             :
     1354               assign
     1355                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1356               .
     1357             end.
     1358             assign
     1359               frame Dialog-Frame :height = v-frame-height
     1360             .
     1361             if frame Dialog-Frame :scrollable = true
     1362             then do:
     1363               assign
     1364                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1365               .
     1366             end.
     1367             run diasize_position-resize-button in this-procedure .
     1368           end.
     1369           else do:
     1370             if frame Dialog-Frame :scrollable = true
     1371             then do:
     1372               assign
     1373                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1374               .
     1375             end.
     1376             assign
     1377               frame Dialog-Frame :height = v-frame-height
     1378             .
     1379             assign
     1380               v-diasize-browse-handle :height = v-browse-height
     1381             .
     1382             for each buf_temp-browse-handle
     1383               where buf_temp-browse-handle.browse-type = 'height':u
     1384             on error undo, next
     1385             :
     1386               assign
     1387                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1388               .
     1389             end.
     1390             for each buf_temp-diasize-handle
     1391             on error undo, next
     1392             :
     1393               assign
     1394                 v-object-handle = buf_temp-diasize-handle.handle-value
     1395               .
     1396               if v-object-handle <> v-diasize-resize-button
     1397               then do:
     1398                 assign
     1399                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1400                 .
     1401               end.
     1402             end.
     1403             run diasize_position-resize-button in this-procedure .
     1404           end.
     1405           assign
     1406             v-diasize-change-size = false
     1407           .
     1408           leave move_block .
     1409         end.
     1410       end.
     1411       assign
     1412         v-diasize-need-full-display = true
     1413       .
     1414       if v-diasize-change-size = false
     1415       then do:
     1416         assign
     1417           v-diasize-change-size = true
     1418         .
     1419       end.
     1420       else do:
     1421         return .
     1422       end.
     1423       assign
     1424         v-frame-height = frame Dialog-Frame :height
     1425         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1426         v-browse-height = v-diasize-browse-handle :height
     1427       .
     1428       for each buf_temp-browse-handle
     1429         where buf_temp-browse-handle.browse-type = 'height':u
     1430       :
     1431         assign
     1432           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1433         .
     1434       end.
     1435       for each buf_temp-diasize-handle
     1436       :
     1437         delete buf_temp-diasize-handle .
     1438       end.
     1439       assign
     1440         v-field-group-handle = frame Dialog-Frame :first-child
     1441       .
     1442       do while valid-handle(v-field-group-handle)
     1443       :
     1444         assign
     1445           v-object-handle = v-field-group-handle :first-child
     1446         .
     1447         do while valid-handle(v-object-handle)
     1448         :
     1449           if  v-object-handle <> v-diasize-browse-handle :handle
     1450           and can-query(v-object-handle, "row")
     1451           and can-query(v-object-handle, "height")
     1452           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1453           then do:
     1454             find first buf_temp-browse-handle
     1455               where buf_temp-browse-handle.browse-type   = 'height':u
     1456                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1457               no-error .
     1458             if available buf_temp-browse-handle
     1459             then do:
     1460             end.
     1461             else do:
     1462               create buf_temp-diasize-handle .
     1463               assign
     1464                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1465                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1466               .
     1467             end.
     1468           end.
     1469           assign
     1470             v-object-handle = v-object-handle :next-sibling
     1471           .
     1472         end.
     1473         assign
     1474           v-field-group-handle = v-field-group-handle :next-sibling
     1475         .
     1476       end.
     1477       do with frame Dialog-Frame
     1478       :
     1479         hide v-diasize-resize-button .
     1480         assign
     1481           v-diasize-resize-button :row    = 1
     1482           v-diasize-resize-button :column = 1
     1483         .
     1484       end.
     1485       if p-change-value > 0
     1486       then do:
     1487         if frame Dialog-Frame :scrollable = true
     1488         then do:
     1489           assign
     1490             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1491             no-error .
     1492           if error-status :error
     1493           or error-status :get-message(1) <> ""
     1494           then do:
     1495             undo move_block, retry move_block .
     1496           end.
     1497         end.
     1498         assign
     1499           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1500           no-error .
     1501         if error-status :error
     1502         or error-status :get-message(1) <> ""
     1503         then do:
     1504           undo move_block, retry move_block .
     1505         end.
     1506         assign
     1507           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1508           no-error .
     1509         if error-status :error
     1510         or error-status :get-message(1) <> ""
     1511         then do:
     1512           undo move_block, retry move_block .
     1513         end.
     1514         for each buf_temp-browse-handle
     1515           where buf_temp-browse-handle.browse-type = 'height':u
     1516         on error undo move_block, retry move_block
     1517         :
     1518           assign
     1519             buf_temp-browse-handle.browse-handle :height
     1520               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1521             no-error .
     1522           if error-status :error
     1523           or error-status :get-message(1) <> ""
     1524           then do:
     1525             undo move_block, retry move_block .
     1526           end.
     1527         end.
     1528         for each buf_temp-diasize-handle
     1529         on error undo move_block, retry move_block
     1530         :
     1531           assign
     1532             v-object-handle = buf_temp-diasize-handle.handle-value
     1533           .
     1534           if v-object-handle <> v-diasize-resize-button
     1535           then do:
     1536             assign
     1537               v-object-handle :row = v-object-handle :row + p-change-value
     1538               no-error .
     1539             if error-status :error
     1540             or error-status :get-message(1) <> ""
     1541             then do:
     1542               undo move_block, retry move_block .
     1543             end.
     1544           end.
     1545         end.
     1546       end.
     1547       else do:
     1548         for each buf_temp-diasize-handle
     1549         on error undo move_block, retry move_block
     1550         :
     1551           assign
     1552             v-object-handle = buf_temp-diasize-handle.handle-value
     1553           .
     1554           if v-object-handle <> v-diasize-resize-button
     1555           then do:
     1556             assign
     1557               v-object-handle :row = v-object-handle :row + p-change-value
     1558               no-error .
     1559             if error-status :error
     1560             or error-status :get-message(1) <> ""
     1561             then do:
     1562               undo move_block, retry move_block .
     1563             end.
     1564           end.
     1565         end.
     1566         assign
     1567           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1568           no-error .
     1569         if error-status :error
     1570         or error-status :get-message(1) <> ""
     1571         then do:
     1572           undo move_block, retry move_block .
     1573         end.
     1574         for each buf_temp-browse-handle
     1575           where buf_temp-browse-handle.browse-type = 'height':u
     1576         on error undo move_block, retry move_block
     1577         :
     1578           assign
     1579             buf_temp-browse-handle.browse-handle :height
     1580               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1581             no-error .
     1582           if error-status :error
     1583           or error-status :get-message(1) <> ""
     1584           then do:
     1585             undo move_block, retry move_block .
     1586           end.
     1587         end.
     1588         assign
     1589           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1590           no-error .
     1591         if error-status :error
     1592         or error-status :get-message(1) <> ""
     1593         then do:
     1594           undo move_block, retry move_block .
     1595         end.
     1596         if frame Dialog-Frame :scrollable = true
     1597         then do:
     1598           assign
     1599             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1600             no-error .
     1601           if error-status :error
     1602           or error-status :get-message(1) <> ""
     1603           then do:
     1604             undo move_block, retry move_block .
     1605           end.
     1606         end.
     1607       end.
     1608       if p-move-resize = true
     1609       then do:
     1610         run diasize_position-resize-button in this-procedure .
     1611       end.
     1612       if v-diasize-wndstore = true
     1613       then do:
     1614         if connected("ub") = true
     1615         then do:
     1616           define variable v-cntxt-db-num        as integer   no-undo .
     1617           define variable v-cntxt-userid        as character no-undo .
     1618           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1619                                             , OUTPUT v-cntxt-userid
     1620                                             ) .
     1621           run gbl/wndsizew.p
     1622             (input  v-cntxt-db-num
     1623             ,input  v-cntxt-userid
     1624             ,input  v-diasize-proc-name
     1625             ,input  'height':u
     1626             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1627             ) .
     1628         end.
     1629       end.
     1630     end.
     1631     assign
     1632       v-diasize-change-size = false
     1633     .
     1634   end procedure.
     1635   procedure diasize_set-height :
     1636     define input  parameter p-new-height  as decimal   no-undo .
     1637     define input  parameter p-move-resize as logical   no-undo .
     1638     do
     1639     on error undo, return error return-value
     1640     :
     1641       run diasize_change-height in this-procedure
     1642         (input  (p-new-height - frame Dialog-Frame :height)
     1643         ,input  p-move-resize
     1644         ) .
     1645     end.
     1646   end procedure.
     1647   procedure diasize_change-width :
     1648     define input  parameter p-change-value as decimal   no-undo .
     1649     define input  parameter p-move-resize  as logical   no-undo .
     1650     define variable v-field-group-handle   as handle    no-undo .
     1651     define variable v-object-handle        as handle    no-undo .
     1652     define variable v-frame-width          as decimal   no-undo .
     1653     define variable v-frame-virtual-width  as decimal   no-undo .
     1654     define variable v-browse-width         as decimal   no-undo .
     1655     define variable v-window-width         as decimal   no-undo .
     1656     define variable v-window-virtual-width as decimal   no-undo .
     1657     define variable v-change-sign          as integer   no-undo .
     1658     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1659     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1660     if p-change-value > 0
     1661     then do:
     1662       if frame Dialog-Frame :width + p-change-value >
     1663           session :width-chars
     1664       then do:
     1665         assign
     1666           p-change-value = session :width-chars - frame Dialog-Frame :width
     1667         .
     1668         if p-change-value <= 0
     1669         then do:
     1670           run diasize_position-resize-button in this-procedure .
     1671           return .
     1672         end.
     1673       end.
     1674     end.
     1675     if p-change-value < 0
     1676     then do:
     1677       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1678       then do:
     1679         assign
     1680           p-change-value = v-diasize-orig-frame-width
     1681                          - frame Dialog-Frame :width
     1682         .
     1683         if p-change-value >= 0
     1684         then do:
     1685           run diasize_position-resize-button in this-procedure .
     1686           return .
     1687         end.
     1688       end.
     1689     end.
     1690     if p-change-value >= 0
     1691     then do:
     1692       assign
     1693         v-change-sign = 1
     1694       .
     1695     end.
     1696     else do:
     1697       assign
     1698         v-change-sign = -1
     1699       .
     1700     end.
     1701     assign
     1702       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1703     .
     1704     if p-change-value = 0
     1705     then do:
     1706       run diasize_position-resize-button in this-procedure .
     1707       return .
     1708     end.
     1709     move_block:
     1710     do
     1711     on error undo move_block, leave move_block
     1712     :
     1713       if retry
     1714       then do:
     1715         do
     1716         on error undo move_block, leave move_block
     1717         :
     1718           if p-change-value > 0
     1719           then do:
     1720             for each buf_temp-diasize-handle
     1721             on error undo, next
     1722             :
     1723               assign
     1724                 v-object-handle = buf_temp-diasize-handle.handle-value
     1725               .
     1726               if v-object-handle <> v-diasize-resize-button
     1727               then do:
     1728                 assign
     1729                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1730                 .
     1731               end.
     1732             end.
     1733             assign
     1734               v-diasize-browse-handle :width = v-browse-width
     1735             .
     1736             for each buf_temp-browse-handle
     1737               where buf_temp-browse-handle.browse-type = 'width':u
     1738             on error undo, next
     1739             :
     1740               assign
     1741                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1742               .
     1743             end.
     1744             assign
     1745               frame Dialog-Frame :width = v-frame-width
     1746             .
     1747             if frame Dialog-Frame :scrollable = true
     1748             then do:
     1749               assign
     1750                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1751               .
     1752             end.
     1753             run diasize_position-resize-button in this-procedure .
     1754           end.
     1755           else do:
     1756             if frame Dialog-Frame :scrollable = true
     1757             then do:
     1758               assign
     1759                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1760               .
     1761             end.
     1762             assign
     1763               frame Dialog-Frame :width = v-frame-width
     1764             .
     1765             for each buf_temp-browse-handle
     1766               where buf_temp-browse-handle.browse-type = 'width':u
     1767             on error undo, next
     1768             :
     1769               assign
     1770                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1771               .
     1772             end.
     1773             assign
     1774               v-diasize-browse-handle :width = v-browse-width
     1775             .
     1776             for each buf_temp-diasize-handle
     1777             on error undo, next
     1778             :
     1779               assign
     1780                 v-object-handle = buf_temp-diasize-handle.handle-value
     1781               .
     1782               if v-object-handle <> v-diasize-resize-button
     1783               then do:
     1784                 assign
     1785                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1786                 .
     1787               end.
     1788             end.
     1789             run diasize_position-resize-button in this-procedure .
     1790           end.
     1791           assign
     1792             v-diasize-change-size = false
     1793           .
     1794           leave move_block .
     1795         end.
     1796       end.
     1797       assign
     1798         v-diasize-need-full-display = true
     1799       .
     1800       if v-diasize-change-size = false
     1801       then do:
     1802         assign
     1803           v-diasize-change-size = true
     1804         .
     1805       end.
     1806       else do:
     1807         return .
     1808       end.
     1809       assign
     1810         v-frame-width = frame Dialog-Frame :width
     1811         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1812         v-browse-width = v-diasize-browse-handle :width
     1813       .
     1814       for each buf_temp-browse-handle
     1815         where buf_temp-browse-handle.browse-type = 'width':u
     1816       :
     1817         assign
     1818           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1819         .
     1820       end.
     1821       for each buf_temp-diasize-handle
     1822       :
     1823         delete buf_temp-diasize-handle .
     1824       end.
     1825       assign
     1826         v-field-group-handle = frame Dialog-Frame :first-child
     1827       .
     1828       do while valid-handle(v-field-group-handle)
     1829       :
     1830         assign
     1831           v-object-handle = v-field-group-handle :first-child
     1832         .
     1833         do while valid-handle(v-object-handle)
     1834         :
     1835           if  v-object-handle <> v-diasize-browse-handle :handle
     1836           and v-object-handle <> v-diasize-resize-button
     1837           and can-query(v-object-handle, "row")
     1838           and can-query(v-object-handle, "height")
     1839           and ( v-object-handle :col + v-object-handle :width
     1840                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1841               )
     1842           then do:
     1843             find first buf_temp-browse-handle
     1844               where buf_temp-browse-handle.browse-type   = 'width':u
     1845                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1846               no-error .
     1847             if available buf_temp-browse-handle
     1848             then do:
     1849             end.
     1850             else do:
     1851               create buf_temp-diasize-handle .
     1852               assign
     1853                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1854                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1855               .
     1856             end.
     1857           end.
     1858           assign
     1859             v-object-handle = v-object-handle :next-sibling
     1860           .
     1861         end.
     1862         assign
     1863           v-field-group-handle = v-field-group-handle :next-sibling
     1864         .
     1865       end.
     1866       do with frame Dialog-Frame
     1867       :
     1868         hide v-diasize-resize-button .
     1869         v-diasize-resize-button :row = 1.
     1870         v-diasize-resize-button :column = 1.
     1871       end.
     1872       if p-change-value > 0
     1873       then do:
     1874         if frame Dialog-Frame :scrollable = true
     1875         then do:
     1876           assign
     1877             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1878             no-error .
     1879           if error-status :error
     1880           or error-status :get-message(1) <> ""
     1881           then do:
     1882             undo move_block, retry move_block.
     1883           end.
     1884         end.
     1885         assign
     1886           frame Dialog-Frame :width = v-frame-width + p-change-value
     1887           no-error .
     1888         if error-status :error
     1889         or error-status :get-message(1) <> ""
     1890         then do:
     1891           undo move_block, retry move_block.
     1892         end.
     1893         assign
     1894           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1895         no-error .
     1896         if error-status :error
     1897         or error-status :get-message(1) <> ""
     1898         then do:
     1899           undo move_block, retry move_block.
     1900         end.
     1901         for each buf_temp-browse-handle
     1902           where buf_temp-browse-handle.browse-type = 'width':u
     1903         on error undo move_block, retry move_block
     1904         :
     1905           assign
     1906             buf_temp-browse-handle.browse-handle :width
     1907               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1908             no-error .
     1909           if error-status :error
     1910           or error-status :get-message(1) <> ""
     1911           then do:
     1912             undo move_block, retry move_block .
     1913           end.
     1914         end.
     1915         for each buf_temp-diasize-handle
     1916         on error undo move_block, retry move_block
     1917         :
     1918           assign
     1919             v-object-handle = buf_temp-diasize-handle.handle-value
     1920           .
     1921           if v-object-handle <> v-diasize-resize-button
     1922           then do:
     1923             assign
     1924               v-object-handle :col = v-object-handle :col + p-change-value
     1925               no-error .
     1926             if error-status :error
     1927             or error-status :get-message(1) <> ""
     1928             then do:
     1929               undo move_block, retry move_block .
     1930             end.
     1931           end.
     1932         end.
     1933       end.
     1934       else do:
     1935         for each buf_temp-diasize-handle
     1936         on error undo move_block, retry move_block
     1937         :
     1938           assign
     1939             v-object-handle = buf_temp-diasize-handle.handle-value
     1940           .
     1941           if v-object-handle <> v-diasize-resize-button
     1942           then do:
     1943             assign
     1944               v-object-handle :col = v-object-handle :col + p-change-value
     1945               no-error .
     1946             if error-status :error
     1947             or error-status :get-message(1) <> ""
     1948             then do:
     1949               undo move_block, retry move_block .
     1950             end.
     1951           end.
     1952         end.
     1953         for each buf_temp-browse-handle
     1954           where buf_temp-browse-handle.browse-type = 'width':u
     1955         on error undo move_block, retry move_block
     1956         :
     1957           assign
     1958             buf_temp-browse-handle.browse-handle :width
     1959               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1960             no-error .
     1961           if error-status :error
     1962           or error-status :get-message(1) <> ""
     1963           then do:
     1964             undo move_block, retry move_block .
     1965           end.
     1966         end.
     1967         assign
     1968           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1969           no-error .
     1970         if error-status :error
     1971         or error-status :get-message(1) <> ""
     1972         then do:
     1973           undo move_block, retry move_block.
     1974         end.
     1975         assign
     1976           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1977         no-error .
     1978         if error-status :error
     1979         or error-status :get-message(1) <> ""
     1980         then do:
     1981           undo move_block, retry move_block.
     1982         end.
     1983         if frame Dialog-Frame :scrollable = true
     1984         then do:
     1985           assign
     1986             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1987           no-error .
     1988           if error-status :error
     1989           or error-status :get-message(1) <> ""
     1990           then do:
     1991             undo move_block, retry move_block.
     1992           end.
     1993         end.
     1994       end.
     1995       if p-move-resize
     1996       then do:
     1997         run diasize_position-resize-button in this-procedure .
     1998       end.
     1999       if v-diasize-wndstore = true
     2000       then do:
     2001         if connected("ub") = true
     2002         then do:
     2003           define variable v-cntxt-db-num        as integer   no-undo .
     2004           define variable v-cntxt-userid        as character no-undo .
     2005           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2006                                             , OUTPUT v-cntxt-userid
     2007                                             ) .
     2008           run gbl/wndsizew.p
     2009             (input  v-cntxt-db-num
     2010             ,input  v-cntxt-userid
     2011             ,input  v-diasize-proc-name
     2012             ,input  'width':u
     2013             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2014             ) .
     2015         end.
     2016       end.
     2017     end.
     2018     assign
     2019       v-diasize-change-size = false
     2020     .
     2021   end procedure.
     2022   procedure diasize_set-width :
     2023     define input  parameter p-new-width  as decimal   no-undo .
     2024     define input  parameter p-move-resize as logical   no-undo .
     2025     do
     2026     on error undo, return error return-value
     2027     :
     2028       run diasize_change-width in this-procedure
     2029         (input  (p-new-width - frame Dialog-Frame :width)
     2030         ,input  p-move-resize
     2031         ) .
     2032     end.
     2033   end procedure.
     2034   procedure diasize_position-resize-button :
     2035     do with frame Dialog-Frame
     2036     :
     2037       hide v-diasize-resize-button .
     2038       assign
     2039         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2040                     - 1
     2041                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2042         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2043                     - 1
     2044                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2045       .
     2046       view v-diasize-resize-button .
     2047     end.
     2048   end procedure.
     2049   on alt-right anywhere
     2050   do:
     2051     run diasize_change-width in this-procedure
     2052       (input 1
     2053       ,input true
     2054       ) .
     2055     return no-apply .
     2056   end.
     2057   on alt-left anywhere
     2058   do:
     2059     run diasize_change-width in this-procedure
     2060       (input -1
     2061       ,input true
     2062       ) .
     2063     return no-apply .
     2064   end.
     2065   on alt-down anywhere
     2066   do:
     2067     run diasize_change-height in this-procedure
     2068       (input 1
     2069       ,input true
     2070       ) .
     2071     return no-apply .
     2072   end.
     2073   on alt-up anywhere
     2074   do:
     2075     run diasize_change-height in this-procedure
     2076       (input -1
     2077       ,input true
     2078       ) .
     2079     return no-apply .
     2080   end.
     2081   on alt-enter of frame Dialog-Frame
     2082   do:
     2083     run diasize_maximize in this-procedure
     2084       (input  ?
     2085       ).
     2086     return no-apply .
     2087   end.
     2088   procedure diasize_end-move :
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       define variable v-row-delta as decimal   no-undo .
     2093       define variable v-col-delta as decimal   no-undo .
     2094       define variable v-new-row as decimal   no-undo .
     2095       define variable v-new-col as decimal   no-undo .
     2096       assign
     2097         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2098         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2099       .
     2100       assign
     2101         v-row-delta = v-new-row - frame Dialog-Frame :height
     2102         v-col-delta = v-new-col - frame Dialog-Frame :width
     2103       .
     2104       run diasize_change-height in this-procedure
     2105         (input v-row-delta
     2106         ,input true
     2107         ) .
     2108       run diasize_change-width in this-procedure
     2109         (input v-col-delta
     2110         ,input true
     2111         ) .
     2112     end.
     2113   end procedure.
     2114   procedure diasize_maximize :
     2115     define input  parameter p-action as logical   no-undo .
     2116     do
     2117     on error undo, return error return-value
     2118     :
     2119       if p-action = ?
     2120       then do:
     2121         if v-diasize-need-maximize = true
     2122         then do:
     2123           assign
     2124             p-action = true
     2125           .
     2126         end.
     2127         else do:
     2128           assign
     2129             p-action = false
     2130           .
     2131         end.
     2132       end.
     2133       if p-action = true
     2134       then do:
     2135         run diasize_change-height in this-procedure
     2136           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2137               - frame Dialog-Frame :height-chars
     2138           ,input true
     2139           ) .
     2140         run diasize_change-width in this-procedure
     2141           (input session :width-chars
     2142               - frame Dialog-Frame :width-chars
     2143           ,input true
     2144           ) .
     2145         assign
     2146           v-diasize-need-maximize = false
     2147         .
     2148       end.
     2149       else do:
     2150         run diasize_change-width in this-procedure
     2151           (input v-diasize-orig-frame-width
     2152               - frame Dialog-Frame :width-chars
     2153           ,input true
     2154           ) .
     2155         run diasize_change-height in this-procedure
     2156           (input v-diasize-orig-frame-height
     2157               - frame Dialog-Frame :height-chars
     2158           ,input true
     2159           ) .
     2160         assign
     2161           v-diasize-need-maximize = true
     2162         .
     2163       end.
     2164     end.
     2165   end procedure.
     2166   procedure diasize_restore-orig-size :
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       assign
     2171         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2172         v-diasize-current-frame-height = frame Dialog-Frame :height
     2173       .
     2174       run diasize_set-height in this-procedure
     2175         (input  v-diasize-orig-frame-height
     2176         ,input  true
     2177         ) .
     2178       run diasize_set-width in this-procedure
     2179         (input  v-diasize-orig-frame-width
     2180         ,input  true
     2181         ) .
     2182     end.
     2183   end procedure.
     2184   procedure diasize_restore-current-size :
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       run diasize_set-height in this-procedure
     2189         (input  v-diasize-current-frame-height
     2190         ,input  true
     2191         ) .
     2192       run diasize_set-width in this-procedure
     2193         (input  v-diasize-current-frame-width
     2194         ,input  true
     2195         ) .
     2196     end.
     2197   end procedure.
     2198   procedure diasize_set-browse-handle :
     2199     define input  parameter p-browse-handle as handle   no-undo .
     2200     define buffer buf_temp-browse-handle for temp-browse-handle .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       assign
     2205         v-diasize-browse-handle = p-browse-handle
     2206       .
     2207       for each buf_temp-browse-handle
     2208       on error undo, return error return-value
     2209       :
     2210         delete buf_temp-browse-handle .
     2211       end.
     2212     end.
     2213   end procedure.
     2214   procedure diasize_add_browse :
     2215     define input  parameter p-browse-type   as character no-undo .
     2216     define input  parameter p-browse-handle as handle    no-undo .
     2217     define buffer buf_temp-browse-handle for temp-browse-handle .
     2218     do
     2219     on error undo, return error return-value
     2220     :
     2221       assign
     2222         v-diasize-browse-number = v-diasize-browse-number + 1
     2223       .
     2224       create buf_temp-browse-handle .
     2225       assign
     2226         buf_temp-browse-handle.browse-type   = p-browse-type
     2227         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2228         buf_temp-browse-handle.browse-handle = p-browse-handle
     2229       .
     2230     end.
     2231   end procedure.
     2232   procedure diasize_init :
     2233     define variable v-default-value    as logical   no-undo .
     2234     define variable v-restore-saved    as logical   no-undo .
     2235     define variable v-resize-value-str as character no-undo .
     2236     do
     2237     on error undo, return error return-value
     2238     :
     2239       do with frame Dialog-Frame
     2240       :
     2241         assign
     2242           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2243           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2244           v-diasize-browse-handle     = browse br-docs :handle
     2245         .
     2246         create button v-diasize-resize-button
     2247         assign
     2248           parent        = frame Dialog-Frame :first-child
     2249           label         = "s"
     2250           height-pixels = 16
     2251           width-pixels  = 16
     2252           visible       = true
     2253           sensitive     = true
     2254           movable       = true
     2255           triggers:
     2256             on end-move persistent run diasize_end-move in this-procedure .
     2257           end triggers.
     2258         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2259         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2260         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2261         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2262         assign
     2263           v-diasize-wndmax = false
     2264         .
     2265         if connected("ub") = true
     2266         then do:
     2267           define variable v-cntxt-db-num        as integer   no-undo .
     2268           define variable v-cntxt-userid        as character no-undo .
     2269           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2270                                             , OUTPUT v-cntxt-userid
     2271                                             ) .
     2272           run gbl/wndpar_r.p
     2273             (input  v-cntxt-db-num
     2274             ,input  v-cntxt-userid
     2275             ,input  'wndmax':U
     2276             ,output v-diasize-wndmax
     2277             ,output v-default-value
     2278             ) .
     2279         end.
     2280         assign
     2281           v-diasize-wndstore = false
     2282         .
     2283         if connected("ub") = true
     2284         then do:
     2285           run gbl/wndpar_r.p
     2286             (input  v-cntxt-db-num
     2287             ,input  v-cntxt-userid
     2288             ,input  'wndstore':U
     2289             ,output v-diasize-wndstore
     2290             ,output v-default-value
     2291             ) .
     2292         end.
     2293         assign
     2294           v-diasize-proc-name = entry(1, program-name(2), '.')
     2295         .
     2296         if v-diasize-wndstore = true
     2297         then do:
     2298           assign
     2299             v-restore-saved = false
     2300           .
     2301           if connected("ub") = true
     2302           then do:
     2303             run gbl/wndsizer.p
     2304               (input  v-cntxt-db-num
     2305               ,input  v-cntxt-userid
     2306               ,input  v-diasize-proc-name
     2307               ,input  'height':u
     2308               ,output v-resize-value-str
     2309               ) .
     2310             if v-resize-value-str <> '':U
     2311             then do:
     2312               run diasize_change-height in this-procedure
     2313                 (input  integer(v-resize-value-str)
     2314                 ,input  true
     2315                 ) .
     2316               assign
     2317                 v-restore-saved = true
     2318               .
     2319             end.
     2320           end.
     2321           if connected("ub") = true
     2322           then do:
     2323             run gbl/wndsizer.p
     2324               (input  v-cntxt-db-num
     2325               ,input  v-cntxt-userid
     2326               ,input  v-diasize-proc-name
     2327               ,input  'width':u
     2328               ,output v-resize-value-str
     2329               ) .
     2330             if v-resize-value-str <> '':U
     2331             then do:
     2332               run diasize_change-width in this-procedure
     2333                 (input  integer(v-resize-value-str)
     2334                 ,input  true
     2335                 ) .
     2336               assign
     2337                 v-restore-saved = true
     2338               .
     2339             end.
     2340           end.
     2341           if v-restore-saved <> true
     2342           then do:
     2343             if v-diasize-wndmax = true
     2344             then do:
     2345               run diasize_maximize in this-procedure
     2346                 (input  true
     2347                 ) .
     2348             end.
     2349           end.
     2350         end.
     2351         else do:
     2352           if v-diasize-wndmax = true
     2353           then do:
     2354             run diasize_maximize in this-procedure
     2355               (input  true
     2356               ) .
     2357           end.
     2358         end.
     2359       end.
     2360     end.
     2361   end procedure.
     2362   procedure diasize_need-full-display :
     2363     define output parameter p-need-full-display as logical   no-undo .
     2364     do
     2365     on error undo, return error return-value
     2366     :
     2367       assign
     2368         p-need-full-display = v-diasize-need-full-display
     2369       .
     2370       assign
     2371         v-diasize-need-full-display = false
     2372       .
     2373     end.
     2374   end procedure.
     2375   procedure get-context :
     2376      define output parameter p-db-num as integer          no-undo.
     2377      define output parameter p-user-id as character        no-undo.
     2378      define variable v-login               as character    no-undo.
     2379      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2380      define buffer buf_user-login  for ub.user-login .
     2381      do
     2382      on error undo, return error
     2383      :
     2384            FIND FIRST buf_sys-ctrl no-lock.
     2385            ASSIGN
     2386               v-login = USERID("ub")
     2387               p-db-num = buf_sys-ctrl.db-num
     2388            .
     2389            FIND FIRST buf_user-login
     2390                 WHERE buf_user-login.db-num = p-db-num
     2391                   AND buf_user-login.user-login = v-login
     2392                 no-lock
     2393                 no-error
     2394                 .
     2395            IF AVAILABLE buf_user-login
     2396            THEN DO:
     2397               assign
     2398                  p-user-id = buf_user-login.user-id
     2399               .
     2400            END.
     2401      end.
     2402   end procedure.
     2403   run diasize_add_browse in this-procedure
     2404     (input  'width':u
     2405     ,input  browse BR-changes :handle
     2406     ) .
     2407   run diasize_init in this-procedure .
     2408   MAIN-BLOCK:
     2409   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2410      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2411   define variable p-file-label as character no-undo .
     2412   if par-rcv-code = "" then do:
     2413     p-file-label =  "История заказа".
     2414     buf_c-ord-doc.rcv-code:VISIBLE IN BROWSE br-docs = false .
     2415   end.
     2416   else do:
     2417     p-file-label =  "История поставки".
     2418   end.
     2419   temp-changes.l_name:RESIZABLE in browse BR-changes = true .
     2420   temp-changes.v_old:RESIZABLE  in browse BR-changes = true .
     2421   temp-changes.v_new:RESIZABLE  in browse BR-changes = true .
     2422   define buffer buf_clients for  ub.clients .
     2423     run my-enable_ui .
     2424     run openbr (yes, no, '':u).
     2425     hide B-sch in frame Dialog-Frame .
     2426     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2427     wait-for go of frame Dialog-Frame.
     2428   END.
     2429   run disable_ui.
     2430   PROCEDURE disable_UI :
     2431     HIDE FRAME Dialog-Frame.
     2432   END PROCEDURE.
     2433   PROCEDURE enable_UI :
     2434     ENABLE B-Cancel B-Help BR-docs BR-changes
     2435         WITH FRAME Dialog-Frame.
     2436     VIEW FRAME Dialog-Frame.
     2437     OPEN QUERY BR-docs FOR EACH buf_c-ord-doc no-lock.
     2438   END PROCEDURE.
     2439   PROCEDURE my-enable_UI :
     2440     ENABLE B-Cancel
     2441            B-sch
     2442            B-Help
     2443            BR-docs
     2444            BR-changes
     2445         WITH FRAME Dialog-Frame.
     2446     VIEW FRAME Dialog-Frame.
     2447   END PROCEDURE.
     2448   PROCEDURE OpenBr :
     2449   define input  parameter p-open-query     as logical   no-undo .
     2450   define input  parameter p-find-next      as logical   no-undo .
     2451   define input  parameter p-find-condition as character no-undo .
     2452   define variable l-query-was-opened as logical no-undo .
     2453   define variable title0 as character no-undo.
     2454   title0 = caps(p-file-label) + chr(32).
     2455   define variable sort-column-phrase as character no-undo .
     2456   case sort-column-name :
     2457     when "" then do:
     2458       assign
     2459         sort-column-phrase = ""
     2460       .
     2461     end.
     2462     otherwise do:
     2463       assign
     2464         sort-column-phrase = "by " + sort-column-name
     2465       .
     2466     end.
     2467   end case.
     2468   define variable l-open-query as logical   no-undo .
     2469          find first buf_clients no-lock where buf_clients.obj-type = 'орг':U no-error .
     2470          if not available buf_clients then return .
     2471          filter-point = filter-point0 .
     2472          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name .
     2473   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2474   define variable  l-disable-where-15  as logical   no-undo .
     2475   define variable  l-filter-open-15    as logical   .
     2476   define variable  flt-rec-15       as recid     no-undo .
     2477   define variable  filter-name-15      as character no-undo .
     2478   define variable  where-phrase-15     as character no-undo .
     2479   define variable  sort-phrase-15      as character no-undo .
     2480   define variable  where-phrase-rus-15 as character no-undo .
     2481   define variable  sort-phrase-rus-15  as character no-undo .
     2482   run gbl/flt-get.p
     2483     (input filter-point
     2484     ,output flt-rec-15
     2485     ,output filter-name-15
     2486     ,output where-phrase-15
     2487     ,output sort-phrase-15
     2488     ,output where-phrase-rus-15
     2489     ,output sort-phrase-rus-15
     2490     ).
     2491   if p-open-query then do:
     2492       run set-filter-name in this-procedure
     2493         (INPUT filter-name-15
     2494         ) no-error .
     2495     assign
     2496       l-filter-open-15 = false
     2497     .
     2498     if flt-rec-15 <> ?
     2499       or sort-column-phrase > ""
     2500     then do:
     2501       define variable  parameter-2-15 as character no-undo .
     2502       define variable  parameter-3-15 as character no-undo .
     2503       define variable  parameter-4-15 as character no-undo .
     2504       define variable  parameter-5-15 as character no-undo .
     2505       define variable  parameter-6-15 as character no-undo .
     2506       define variable  parameter-7-15 as character no-undo .
     2507         assign
     2508         parameter-3-15 =
     2509                                 "FOR EACH buf_c-ord-doc"
     2510         parameter-4-15 =
     2511           (
     2512             if (" buf_c-ord-doc.doc-code = par-doc-code and  buf_c-ord-doc.rcv-code =  par-rcv-code  " + " " + where-phrase-15) <> ""
     2513             then substitute(' buf_c-ord-doc.doc-code = &1&2&1 and  buf_c-ord-doc.rcv-code = &1&3&1 '  , chr(34) , par-doc-code, par-rcv-code )  + " " + where-phrase-15
     2514             else "true"
     2515           )
     2516         parameter-5-15 = (" " + "" + " " + "")
     2517         parameter-6-15 = if sort-phrase-15 = ''
     2518                              then
     2519           (
     2520           " " + "  " +
     2521             " " + sort-column-phrase +
     2522           " " + " by buf_c-ord-doc.corr-date by buf_c-ord-doc.corr-time"
     2523           )
     2524                              else
     2525           (
     2526           " " + "  " +
     2527             " " + sort-column-phrase +
     2528           " " + sort-phrase-15
     2529           )
     2530         parameter-7-15 =
     2531           " indexed-reposition  "
     2532       .
     2533       do
     2534       on stop undo, leave
     2535       on error undo, leave
     2536       :
     2537         assign
     2538           l-disable-where-15 =
     2539             (" buf_c-ord-doc.doc-code = par-doc-code and  buf_c-ord-doc.rcv-code =  par-rcv-code  " + " " + where-phrase-15 = "")
     2540         .
     2541         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2542                             ,input query br-docs:handle
     2543                             ,input parameter-3-15
     2544                             ,input parameter-4-15
     2545                             ,input parameter-5-15
     2546                             ,input parameter-6-15
     2547                             ,input parameter-7-15
     2548                             )
     2549         .
     2550         assign
     2551           l-filter-open-15 = true
     2552         .
     2553       end.
     2554       if l-filter-open-15 = false then do:
     2555         message
     2556           "Ошибка при фильтрации / сортировке" skip
     2557           "Будут показаны записи без учета фильтра" skip
     2558           view-as alert-box .
     2559       end.
     2560       else do:
     2561           assign
     2562             l-query-was-opened = true
     2563           .
     2564       end.
     2565     end.
     2566     if l-filter-open-15 = false then do:
     2567       OPEN QUERY br-docs FOR EACH buf_c-ord-doc
     2568         where  buf_c-ord-doc.doc-code = par-doc-code and  buf_c-ord-doc.rcv-code =  par-rcv-code
     2569          by buf_c-ord-doc.corr-date by buf_c-ord-doc.corr-time
     2570         indexed-reposition
     2571     .
     2572         assign
     2573           l-query-was-opened = true
     2574         .
     2575     end.
     2576   end.
     2577   else do:
     2578     assign
     2579       doc-rec = recid( buf_c-ord-doc )
     2580     .
     2581     do
     2582     on stop undo, leave
     2583     on error undo, leave
     2584     :
     2585       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_c-ord-doc:handle) then do:
     2586         assign
     2587         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2588         parameter-4-15 =
     2589           "where ":u + substitute(' buf_c-ord-doc.doc-code = &1&2&1 and  buf_c-ord-doc.rcv-code = &1&3&1 '  , chr(34) , par-doc-code, par-rcv-code )  + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     2590         parameter-5-15 = "  "
     2591       .
     2592         run fltopend_fltfindd in this-procedure  (
     2593                             input this-procedure:handle
     2594                             ,input query br-docs:handle
     2595                             ,input rowid(buf_c-ord-doc)
     2596                             ,input logical(parameter-2-15)
     2597                             ,input no-lock
     2598                             ,input (buffer buf_c-ord-doc:handle)
     2599                             ,input parameter-4-15
     2600                             ,input parameter-5-15
     2601                             ) no-error.
     2602         .
     2603         assign
     2604           doc-rec = integer(return-value)
     2605           v-fltopend-rowid[1] = ?
     2606         .
     2607       end.
     2608       else do:
     2609         assign
     2610         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2611         parameter-3-15 =  "FOR EACH buf_c-ord-doc"
     2612         parameter-4-15 =
     2613           (
     2614             if (" buf_c-ord-doc.doc-code = par-doc-code and  buf_c-ord-doc.rcv-code =  par-rcv-code  " + " " + where-phrase-15) <> ""
     2615             then substitute(' buf_c-ord-doc.doc-code = &1&2&1 and  buf_c-ord-doc.rcv-code = &1&3&1 '  , chr(34) , par-doc-code, par-rcv-code )  + " " + where-phrase-15
     2616             else "true"
     2617           )
     2618         parameter-5-15 = (" " + "" + " " + "" + " " + p-find-condition)
     2619         parameter-6-15 = if sort-phrase-15 = ''
     2620                              then
     2621           (
     2622           " " + "  " +
     2623             " " + sort-column-phrase +
     2624           " " + " by buf_c-ord-doc.corr-date by buf_c-ord-doc.corr-time"
     2625           )
     2626                              else
     2627           (
     2628           " " + "  " +
     2629             " " + sort-column-phrase +
     2630           " " + sort-phrase-15
     2631           )
     2632         parameter-7-15 =
     2633           " indexed-reposition  "
     2634       .
     2635         run fltopend_fltfindq in this-procedure  (
     2636                             input this-procedure:handle
     2637                             ,input query br-docs:handle
     2638                             ,input logical(parameter-2-15)
     2639                             ,input no-lock
     2640                             ,input parameter-3-15
     2641                             ,input parameter-4-15
     2642                             ,input parameter-5-15
     2643                             ,input parameter-6-15
     2644                             ,input parameter-7-15
     2645                             ,output v-fltopend-rowid
     2646                             ) no-error.
     2647         .
     2648         doc-rec = ?.
     2649       end.
     2650       assign
     2651         l-query-was-opened = true
     2652       .
     2653     end.
     2654   end.
     2655   if not p-open-query then
     2656   REPOSITION br-docs to recid doc-rec No-ERROR.
     2657   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2658   APPLY "ENTRY" TO br-docs.
     2659   END PROCEDURE.
     2660   PROCEDURE proc-b-sch :
     2661   assign
     2662     tbl = 'c-ord-doc'
     2663     join-tbl = 'buf_c-ord-doc'
     2664     fld = ""
     2665     lab = ""
     2666     spr = ""
     2667     dim = '0'
     2668     .
     2669   run fltfield-add in this-procedure('doc-code', 'Внутр.№', '',
     2670   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2671   run fltfield-add in this-procedure('status_', 'Статус', '',
     2672   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2673   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     2674   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2675   Filter-Block:
     2676   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2677       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2678       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2679     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2680     run openbr ( yes, no, '':u).
     2681   END.
     2682   END PROCEDURE.
     2683   PROCEDURE proc-find-code :
     2684   define input parameter par-next as logical no-undo.
     2685   define input parameter pardoc-code as char no-undo.
     2686   END PROCEDURE.
     2687   PROCEDURE proc-view-changes :
     2688   define buffer new_c-ord-doc for ub.c-ord-doc.
     2689   define buffer current_ord-doc for ub.ord-doc.
     2690   define buffer current_ord-doc-rcv for ub.ord-doc-rcv.
     2691   define variable v-chg-fields as character no-undo.
     2692   define variable v-old-fields as character no-undo.
     2693   define variable v-new-fields as character no-undo.
     2694   define variable ii as integer no-undo.
     2695   for each temp-changes:
     2696       delete temp-changes.
     2697   END.
     2698   if not available buf_c-ord-doc then do:
     2699     Open QUery br-changes for each temp-changes.
     2700     return.
     2701   end.
     2702   find first new_c-ord-doc no-lock where
     2703              new_c-ord-doc.doc-code  = buf_c-ord-doc.doc-code and
     2704              new_c-ord-doc.rcv-code  = buf_c-ord-doc.rcv-code and
     2705              new_c-ord-doc.chip-num  > buf_c-ord-doc.chip-num no-error.
     2706   if not available new_c-ord-doc then do:
     2707       if buf_c-ord-doc.rcv-code = "" then do:
     2708           find first current_ord-doc no-lock where
     2709                      current_ord-doc.doc-code  = buf_c-ord-doc.doc-code no-error.
     2710               if not available current_ord-doc then do:
     2711               return error.
     2712           end.
     2713           buffer-compare current_ord-doc  to buf_c-ord-doc
     2714           save result in v-chg-fields.
     2715       end.
     2716       else do:
     2717           find first current_ord-doc-rcv no-lock where
     2718                     current_ord-doc-rcv.rcv-code  = buf_c-ord-doc.rcv-code and
     2719                     current_ord-doc-rcv.doc-code  = buf_c-ord-doc.doc-code no-error.
     2720               if not available current_ord-doc-rcv then do:
     2721               return error.
     2722           end.
     2723           buffer-compare current_ord-doc-rcv  to buf_c-ord-doc
     2724           save result in v-chg-fields.
     2725       end.
     2726   end.
     2727   else do:
     2728       buffer-compare new_c-ord-doc except chip-num corr-date corr-time corr-user-name corr-user-db-num to buf_c-ord-doc
     2729       save result in v-chg-fields.
     2730   end.
     2731   define variable v-nn as integer   no-undo .
     2732   v-nn = num-entries (v-chg-fields) .
     2733   if v-nn  > 0 then do:
     2734   do ii = 1 to v-nn :
     2735   CASE entry(ii, v-chg-fields):
