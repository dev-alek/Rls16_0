     2827   END CASE.
     2828   end.
     2829   end.
     2830   define buffer old_c-ord-line for ub.c-ord-line  .
     2831   for each ub.c-ord-line where
     2832            ub.c-ord-line.doc-code = buf_c-ord-doc.doc-code and
     2833            ub.c-ord-line.chip-num = buf_c-ord-doc.chip-num
     2834            :
     2835        find last old_c-ord-line no-lock where
     2836            old_c-ord-line.doc-code   = ub.c-ord-line.doc-code  and
     2837            old_c-ord-line.artic      = ub.c-ord-line.artic     and
     2838            old_c-ord-line.prod-type  = ub.c-ord-line.prod-type and
     2839            old_c-ord-line.prod-code  = ub.c-ord-line.prod-code and
     2840            old_c-ord-line.chip-num   < buf_c-ord-doc.chip-num
     2841            use-index pi no-error .
     2842            if available old_c-ord-line then do:
     2843                 buffer-compare ub.c-ord-line to old_c-ord-line
     2844                 save result in v-chg-fields.
     2845            end.
     2846            v-nn = num-entries (v-chg-fields) .
     2847           do ii = 1 to v-nn:
     2848               CASE entry(ii, v-chg-fields):
     2849                                             when "status_":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "status_":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Статус строки"         temp-changes.v_new = string(ub.c-ord-line.status_)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.status_)                                  else "")       .   end.
     2850                                             when "qnty":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "qnty":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Количество"         temp-changes.v_new = string(ub.c-ord-line.qnty)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.qnty)                                  else "")       .   end.
     2851                                             when "cli-qnty":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "cli-qnty":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Кол.во пост"         temp-changes.v_new = string(ub.c-ord-line.cli-qnty)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.cli-qnty)                                  else "")       .   end.
     2852                                             when "price-cli":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "price-cli":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Цена поставщика"         temp-changes.v_new = string(ub.c-ord-line.price-cli)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.price-cli)                                  else "")       .   end.
     2853                                             when "price-rubl":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "price-rubl":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Цена в нац.вал."         temp-changes.v_new = string(ub.c-ord-line.price-rubl)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.price-rubl)                                  else "")       .   end.
     2854                                             when "price-base":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "price-base":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Цена в баз.вал."         temp-changes.v_new = string(ub.c-ord-line.price-base)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.price-base)                                  else "")       .   end.
     2855                                             when "sum-cli":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-cli":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма в ценах поставщика"         temp-changes.v_new = string(ub.c-ord-line.sum-cli)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-cli)                                  else "")       .   end.
     2856                                             when "sum-rubl":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-rubl":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма в нац.вал."         temp-changes.v_new = string(ub.c-ord-line.sum-rubl)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-rubl)                                  else "")       .   end.
     2857                                             when "sum-base":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-base":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма в баз.вал."         temp-changes.v_new = string(ub.c-ord-line.sum-base)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-base)                                  else "")       .   end.
     2858                                             when "sum-VAT":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-VAT":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма НДС"         temp-changes.v_new = string(ub.c-ord-line.sum-VAT)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-VAT)                                  else "")       .   end.
     2859               end case.
     2860           end.
     2861   end.
     2862   Open QUery br-changes for each temp-changes.
     2863   END PROCEDURE.
     2864   PROCEDURE set-filter-name :
     2865   define input parameter p-filter-name as character no-undo .
     2866     do with frame Dialog-Frame:
     2867       if p-filter-name > "" then do:
     2868         assign
     2869           frame Dialog-Frame:title
     2870             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2871         .
     2872         assign
     2873           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2874         .
     2875       end.
     2876       else do:
     2877         assign
     2878           b-sch :TOOLTIP = ""
     2879         .
     2880       end.
     2881     end.
     2882   END PROCEDURE.
