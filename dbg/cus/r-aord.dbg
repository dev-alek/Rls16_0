     1660   procedure call-proc-calc :
     1661   do
     1662   on error undo, return error return-value
     1663   :
     1664       if G#type = 'ФП':U    then  do:
     1665             run cus/qnty-obj.p  ( my-handle,
     1666                             input v-round-m ,
     1667                             input v-round-base ,
     1668                             input e-method ,
     1669                             input "all-ord":U,
     1670                             input "1-" ,
     1671                             input date-p-1,
     1672                             input date-p-2,
     1673                             input "calc":U,
     1674                             input no,
     1675                             input R-algoritm ,
     1676                             input R-algoritm2,
     1677                             input R-min-rest ,
     1678                             input R-min-rest3,
     1679                             input p-code     ,
     1680                             input t-rv       ,
