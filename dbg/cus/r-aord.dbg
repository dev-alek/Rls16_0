     1755   procedure make-tmp#zakz :
     1756     define buffer buf_season for ub.season.
     1757     define buffer buf_season-attr for ub.season-attr.
     1758     define buffer buf_gds-season for ub.gds-season.
     1759     define buffer buf_gds-season-attr for ub.gds-season-attr.
     1760    do
     1761    on error undo, return error return-value
     1762    :
     1763   find first gds-list no-error .
     1764   if not available gds-list then  do:
     1765      message "Не выбран ни один товар !!!" view-as alert-box .
     1766      return error.
     1767      end.
     1768   for each tmp#zakaz :
     1769       delete tmp#zakaz.
     1770   end.
     1771   for each tmp#zakaz-prn :
     1772       delete tmp#zakaz-prn.
     1773   end.
     1774   define variable max-num as integer no-undo .
     1775   define variable t-type as character no-undo .
     1776   for each gds-list :
     1777       max-num = max-num + 1 .
     1778     create tmp#zakaz.
     1779     assign
     1780       tmp#zakaz.doc-code        = "1-"
     1781       tmp#zakaz.gds-code        = gds-list.gds-code
     1782       tmp#zakaz.prod-type       = gds-list.prod-type
     1783       tmp#zakaz.prod-code       = gds-list.prod-code
     1784       tmp#zakaz.artic           = gds-list.artic
     1785       tmp#zakaz.gds-name        = gds-list.gds-name
     1786       tmp#zakaz.deadline        = gds-list.deadline
     1787       tmp#zakaz.unit-cli        = gds-list.unit-cli
     1788       tmp#zakaz.unit-base       = gds-list.unit-base
     1789       tmp#zakaz.negative-rest   = gds-list.negative-rest
     1790       tmp#zakaz.cli-base-rate   = gds-list.cli-base-rate
     1791       tmp#zakaz.ms-cart         = gds-list.qnty-cart
     1792       tmp#zakaz.line-num        = max-num + 1
     1793       .
     1794     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     1795     if available bufff-units then
     1796     assign
     1797       tmp#zakaz.unit-type       = bufff-units.type .
     1798     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     1799     if available bufff-units then
     1800     assign
     1801       tmp#zakaz.unit-cli-type       = bufff-units.type .
     1802   case R-min-rest :
     1803   when 1 then do:
     1804   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1806     (input  v-cntxt-obj-type
     1807     ,input  v-cntxt-obj-code
     1808     ,input  ?
     1809     ,input  ?
     1810     ,input  ?
     1811     ,input  tmp#zakaz.gds-code
     1812     ,output v-obj-AssMin
     1813     ,output v-obj-igt
     1814     ,output tmp#zakaz.min-stock
     1815     ,output tmp#zakaz.max-stock
     1816     ,output tmp#zakaz.service-order
     1817     ,output tmp#zakaz.min-order
     1818     )  .
     1819    end.
     1820    when 2 then do:
     1821   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1822   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1823     (input  'орг':U
     1824     ,input  v-cntxt-host-code-obj
     1825     ,input  ?
     1826     ,input  ?
     1827     ,input  ?
     1828     ,input  tmp#zakaz.gds-code
     1829     ,output v-obj-AssMin
     1830     ,output v-obj-igt
     1831     ,output tmp#zakaz.min-stock
     1832     ,output tmp#zakaz.max-stock
     1833     ,output tmp#zakaz.service-order
     1834     ,output tmp#zakaz.min-order
     1835     )  .
     1836   end.
     1837   end case.
     1838   if R-min-rest3 then do:
     1839     for each buf_season no-lock where
     1840                 buf_season.sea-month-1 <= integer (DATE-sale-2) and
     1841                 buf_season.sea-month-2 >= integer (DATE-sale-1):
     1842       find first buf_season-attr where buf_season-attr.sea-code = buf_season.sea-code
     1843         and buf_season-attr.db-num = buf_season.db-num
     1844         and buf_season-attr.attr-code = 'sea-obj':U
     1845         and buf_season-attr.attr-value = obj-list.obj-type + string (obj-list.obj-code) no-error.
     1846       find first buf_gds-season no-lock where
     1847         buf_gds-season.gds-code = tmp#zakaz.gds-code and
     1848         buf_gds-season.sea-code = buf_season.sea-code and
     1849         buf_gds-season.db-num   = buf_season.db-num
     1850           no-error .
     1851       if available buf_season-attr and available buf_gds-season
     1852       then do:
     1853         find first buf_gds-season-attr no-lock where buf_gds-season-attr.sea-code = buf_gds-season.sea-code
     1854           and buf_gds-season-attr.db-num = buf_gds-season.db-num
     1855           and buf_gds-season-attr.gds-code = buf_gds-season.gds-code
     1856           and buf_gds-season-attr.attr-code = 'gdssea-season-coef':U
     1857             no-error .
     1858         if available buf_gds-season-attr then tmp#zakaz.season-coef = decimal (buf_gds-season-attr.attr-value).
     1859         tmp#zakaz.min-stock = buf_gds-season.min-stock .
     1860         leave.
     1861       end.
     1862       else do:
     1863         if available buf_gds-season then do:
     1864           find first buf_gds-season-attr no-lock where buf_gds-season-attr.sea-code = buf_gds-season.sea-code
     1865             and buf_gds-season-attr.db-num = buf_gds-season.db-num
     1866             and buf_gds-season-attr.gds-code = buf_gds-season.gds-code
     1867             and buf_gds-season-attr.attr-code = 'gdssea-season-coef':U
     1868             no-error.
     1869           if available buf_gds-season-attr then tmp#zakaz.season-coef = decimal (buf_gds-season-attr.attr-value).
     1870             tmp#zakaz.min-stock = buf_gds-season.min-stock .
     1871           end.
     1872       end.
     1873     end.
     1874     if tmp#zakaz.season-coef = ? or tmp#zakaz.season-coef = 0 then assign tmp#zakaz.season-coef = 1.
     1875   end.
     1876   end.
     1877    end.
     1878   end procedure.
     1879   procedure init-screen :
     1880    do
     1881    on error undo, return error return-value
     1882    :
     1883   find first ubflt.usr-flt  no-lock where
     1884            ubflt.usr-flt.user-name    = v-cntxt-userid and
     1885            ubflt.usr-flt.call-point   = "all-ord":U    no-error .
     1886            if not avail ubflt.usr-flt  then do:
     1887               message error-status :get-message(1) .
     1888            end.
     1889   p-val = ubflt.usr-flt.list_ .
     1890   define variable v-nn as integer   no-undo .
     1891   v-nn = num-entries(p-val) .
     1892     do i = 1 to v-nn :
     1893        case  entry(1,(entry(i,p-val)), "=" ) :
     1894           when string( "v-round-m" )              then v-round-m = entry(2,(entry(i,p-val)), "=" )           .
     1895           when string( "v-round-base" )           then v-round-base = decimal(entry(2,(entry(i,p-val)), "=" ) )          .
     1896           when string( "R-min-rest" )             then R-min-rest = integer(entry(2,(entry(i,p-val)), "=" )).
     1897           when string( "R-algoritm" )             then R-algoritm = integer(entry(2,(entry(i,p-val)), "=" )).
     1898           when string( "R-algoritm2" )            then R-algoritm2 = integer(entry(2,(entry(i,p-val)), "=" )).
     1899           when string( "tmp-sale.tmp-code" )      then do:
     1900                find first ub.tmp-sale no-lock where ub.tmp-sale.tmp-code = entry(2,(entry(i,p-val)), "=" ) no-error.
     1901                if available ub.tmp-sale then do:
     1902                 p-code = ub.tmp-sale.tmp-code.
     1903                end.
     1904                else do:
     1905                end.
     1906           end.
     1907           when string( "SelectObject" ) then  do:
     1908                   SelectObject = string(entry(2,(entry(i,p-val)), "=" )) no-error .
     1909                end.
     1910           when string( "date-p-1" )     then  date-p-1   = date(entry(2,(entry(i,p-val)), "=" )).
     1911           when string( "date-p-2" )     then  date-p-2   = date(entry(2,(entry(i,p-val)), "=" )).
     1912           when string( "t-way"   )      then  t-way      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     1913           when string( "t-rcv"   )      then  t-rcv      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     1914           when string( "t-clos"   )     then  t-clos     = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     1915           when string( "t-rv"   )       then  t-rv       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     1916           when string( "t-rvz"  )       then  t-rvz      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1917           when string( "t-rvc"  )       then  t-rvc      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     1918           when string( "t-rvzc" )       then  t-rvzc     = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     1919           when string( "t-sp"   )       then  t-sp       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     1920           when string( "t-sppv" )       then  t-sppv     = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     1921           when string( "t-sppv-2")      then  t-sppv-2   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     1922           when string( "t-sppv-3")      then  t-sppv-3   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1923           when string( "t-sppv-4")      then  t-sppv-4   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1924           when string( "p-neg-sale")    then  p-neg-sale = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1925           when string( "t-gar")         then  t-gar      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1926           when string( "t-min-ost")     then  t-min-ost  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1927           when string( "t-deadline")    then  t-deadline  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1928           when string( "t-min-zapas")   then  t-min-zapas = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1929           when string( "R-min-rest3")   then  R-min-rest3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     1930           otherwise do:
     1931           end.
     1932        end case.
     1933     end.
     1934   date-1 = date-p-1 .
     1935   date-2 = date-p-2 .
     1936     kol-obj = num-entries( entry(2,ubflt.usr-flt.list_,"&" ) , ",") - 1 .
     1937        if kol-obj  = ? then kol-obj  = 0 .
     1938   find first ubflt.usr-flt where
     1939               ubflt.usr-flt.user-name    = v-cntxt-userid and
     1940               ubflt.usr-flt.call-point   = "selrdallo":U
     1941               no-error .
     1942       if available ubflt.usr-flt then do:
     1943                       tog-det-prizn = logical(entry(5, ubflt.usr-flt.list_, chr(4))) .
     1944       end.
     1945   if R-algoritm <> 1 then tog-det-prizn = false.
     1946    end.
     1947   end procedure.
