     1682                             input t-rvc      ,
     1683                             input t-rvzc  ,
     1684                             input t-sp    ,
     1685                             input t-sppv  ,
     1686                             input t-sppv-2,
     1687                             input t-sppv-3,
     1688                             input t-sppv-4,
     1689                             input t-way   ,
     1690                             input t-rcv   ,
     1691                             input t-clos  ,
     1692                             input table tt-date ,
     1693                             input table temp-abc-day ,
     1694                             input p-neg-sale    ,
     1695                             input t-gar         ,
     1696                             input t-min-zapas ,
     1697                             input t-min-ost ,
     1698                             input t-deadline ,
     1699                             input v-cntxt-obj-type  ,
     1700                             input v-cntxt-obj-code  ,
     1701                             input g#type            ,
     1702                             input tog-det-prizn
     1703                                   ) no-error .
     1704                                     if error-status :error then do:
     1705                                               message  error-status :get-message(1) .
     1706                                     end.
     1707             end.
     1708       else  do:
     1709             run cus/qntysale.p
     1710               ( my-handle,
     1711                 input v-round-m ,
     1712                 input v-round-base ,
     1713                 input e-method ,
     1714                 input "all-ord":U,
     1715                 input "1-" ,
     1716                 input date-p-1,
     1717                 input date-p-2,
     1718                 input "calc":U,
     1719                 input no,
     1720                 input R-algoritm,
     1721                 input R-algoritm2,
     1722                 input R-min-rest,
     1723                 input R-min-rest3,
     1724                 input p-code,
     1725                 input t-rv,
     1726                 input t-rvz,
     1727                 input t-rvc ,
     1728                 input t-rvzc ,
     1729                 input t-sp   ,
