      811   procedure cur-time :
      812      define output parameter p-today as date      no-undo .
      813      define output parameter p-time  as integer   no-undo .
      814     do
      815     on error undo, return error
      816     :
      817       define variable v-date1 as date      no-undo .
      818       define variable v-date2 as date      no-undo .
      819       define variable v-time  as integer   no-undo .
      820       assign
      821         v-date1 = today
      822         v-time  = time
      823         v-date2 = today
      824       .
      825       if v-date1 <> v-date2
      826       then do:
      827         assign
      828           v-date1 = today
      829           v-time  = v-time
      830         .
      831       end.
      832       assign
      833         p-today = v-date1
      834         p-time  = v-time
      835       .
      836     end.
      837   end.
      838   function cur-time-date returns character
      839   :
      840     return string(today, '99/99/9999':U) .
      841   end.
      842   function cur-time-mjd returns decimal
      843   :
      844     define variable v-date as date      no-undo .
      845     define variable v-time as integer   no-undo .
      846     run cur-time in this-procedure
      847       (output v-date
      848       ,output v-time
      849       ) .
      850     return integer(v-date) - 2400002 + (v-time / 86400) .
      851   end.
      852   function cur-time-get-ending-index returns integer
      853   (input p-number as integer
      854   )
      855   :
      856     if p-number < 0
      857     or p-number = ?
      858     then do:
      859       return 1 .
      860     end.
      861     define variable v-rest as integer   no-undo .
      862     assign
      863       p-number = p-number modulo 100
      864     .
      865     if p-number < 20
      866     then do:
      867       assign
      868         v-rest = p-number
      869       .
      870     end.
      871     else do:
      872       assign
      873         v-rest = p-number modulo 10
      874       .
      875     end.
      876     case v-rest :
      877       when 1
      878       then do:
      879         return 2 .
      880       end.
      881       when 2 or
      882       when 3 or
      883       when 4
      884       then do:
      885         return 3 .
      886       end.
      887       otherwise do:
      888         return 1 .
      889       end.
      890     end case .
      891   end.
      892   procedure cur-time-mjd-to-date :
      893      define input  parameter i-mjd-diff as decimal no-undo.
      894      define output parameter o-Date     as date    no-undo.
      895      define output parameter o-Time     as integer no-undo.
      896      define variable v-day-number as integer   no-undo .
      897      if    i-mjd-diff < 0
      898         or i-mjd-diff = ?
      899      then do:
      900         return "?" .
      901      end.
      902      assign
      903         v-day-number = truncate(i-mjd-diff,0).
      904         o-Date = date(v-day-number + 2400002).
      905         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      906     .
      907   end.
      908   function cur-time-mjd-to-string returns character
      909   (input p-mjd-diff as decimal
      910   )
      911   :
      912     define variable v-day-number as integer   no-undo .
      913     define variable v-seconds    as integer   no-undo .
      914     define variable v-hour       as integer   no-undo .
      915     define variable v-min        as integer   no-undo .
      916     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      917     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      918     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      919     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      920     if p-mjd-diff < 0
      921     or p-mjd-diff = ?
      922     then do:
      923       return "?" .
      924     end.
      925     assign
      926       v-day-number = integer(truncate(p-mjd-diff,0))
      927       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      928     .
      929     if v-seconds > 86400
      930     then do:
      931       assign
      932         v-seconds = 86400 - 1
      933       .
      934     end.
      935     if v-seconds < 0
      936     then do:
      937       assign
      938         v-seconds = 0
      939       .
      940     end.
      941     assign
      942       v-hour = truncate(v-seconds / 3600, 0)
      943     .
      944     assign
      945       v-seconds = v-seconds modulo 3600
      946     .
      947     assign
      948       v-min = truncate(v-seconds / 60, 0)
      949     .
      950     assign
      951       v-seconds = v-seconds modulo 60
      952     .
      953     return
      954         (if v-day-number <> 0
      955           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      956           else ""
      957         )
      958       + (if v-day-number <> 0 or v-hour <> 0
      959           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      960           else ""
      961         )
      962       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      963           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      964           else ""
      965         )
      966       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      967       .
      968   end.
      969   function cur-time-string returns character
      970   :
      971     define variable v-date as date      no-undo .
      972     define variable v-time as integer   no-undo .
      973     run cur-time in this-procedure
      974       (output v-date
      975       ,output v-time
      976       ) .
      977     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      978   end.
      979   function cur-time-string-sec returns character
      980   :
      981     define variable v-date as date      no-undo .
      982     define variable v-time as integer   no-undo .
      983     run cur-time in this-procedure
      984       (output v-date
      985       ,output v-time
      986       ) .
      987     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      988   end.
      989   function cur-time-custom  returns character
      990   (input p-prefix as character
      991   ,input p-date-format as character
      992   ,input p-delimiter as character
      993   ,input p-time-format as character
      994   ,input p-suffix as character
      995   )
      996   :
      997     define variable v-date as date      no-undo .
      998     define variable v-time as integer   no-undo .
      999     run cur-time in this-procedure
     1000       (output v-date
     1001       ,output v-time
     1002       ) .
     1003     return
     1004       p-prefix
     1005       + string(v-date, p-date-format)
     1006       + p-delimiter
     1007       + string(v-time, p-time-format)
     1008       + p-suffix
     1009       .
     1010   end.
     1011   function cur-time-print  returns character
     1012   :
     1013     define variable v-date as date      no-undo .
     1014     define variable v-time as integer   no-undo .
     1015     run cur-time in this-procedure
     1016       (output v-date
     1017       ,output v-time
     1018       ) .
     1019     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1020   end.
     1021   function cur-time-datetime returns datetime
     1022   :
     1023     define variable v-char as character no-undo .
     1024     define variable v-datetime as datetime no-undo .
     1025     v-char = cur-time-string().
     1026     v-datetime = datetime(v-char).
     1027     return  v-datetime.
     1028   end.
     1029   function cur-time-string-msec returns character
     1030   :
     1031     define variable v-date as datetime  no-undo .
     1032     v-date = now.
     1033     return string(v-date) .
     1034   end.
     1035   define variable v-account as integer init 0 no-undo .
     1036   define variable v-account-lavel as character no-undo .
     1037   define variable v-button-stop as logical no-undo .
     1038   define variable v-kol-spice as integer no-undo .
     1039   define variable v-kol-spice2 as integer no-undo .
     1040   define variable v-kol-spice3 as integer no-undo .
     1041   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1042   DEFINE BUTTON StopBtn AUTO-END-KEY
     1043        LABEL "Стоп"
     1044        SIZE 10 BY 1.
     1045   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1046        LABEL "Обработано записей"
     1047         VIEW-AS TEXT
     1048        SIZE 14 BY .67 NO-UNDO.
     1049   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1050         VIEW-AS TEXT
     1051        SIZE 53.25 BY .67
     1052        FGCOLOR 1  NO-UNDO.
     1053   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1054         VIEW-AS TEXT
     1055        SIZE 53.25 BY .67
     1056        FGCOLOR 1  NO-UNDO.
     1057   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1058         VIEW-AS TEXT
     1059        SIZE 53.25 BY .67
     1060        FGCOLOR 1  NO-UNDO.
     1061   DEFINE RECTANGLE RECT-1
     1062        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1063        SIZE 55.13 BY 4.46.
     1064   DEFINE FRAME InfoFrame
     1065        StopBtn AT ROW 4.25 COL 21.75
     1066        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1067        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1068        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1069        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1070        RECT-1 AT ROW 1 COL 1
     1071       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1072            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1073            TITLE "Процесс"
     1074            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1075   define variable mFrameView      as logical   no-undo init yes.
     1076     define variable mFramHandle as handle no-undo.
     1077     mFramHandle = frame InfoFrame:handle.
     1078     if  log-manager:logfile-name ne ?
     1079     then DO:
     1080         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1081         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1082         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1083     end.
     1084     mFrameView = not session:batch-mode and mFramHandle:visible.
     1085     if mFrameView
     1086     then do:
     1087       ASSIGN
     1088          FRAME InfoFrame:HIDDEN                           = TRUE
     1089          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1090     end.
     1091   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1092   DO:
     1093     IF not StopProcessing THEN
     1094       Message "Вы действительно хотите прервать" SKIP
     1095               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1096                 UPDATE StopProcessing.
     1097     IF StopProcessing THEN do:
     1098        if mFrameView
     1099        then do:
     1100           HIDE FRAME InfoFrame.
     1101        end.
     1102     End.
     1103   END.
