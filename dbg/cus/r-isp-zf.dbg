      166   def
      167    shared
      168   temp-table  obj-list no-undo
      169     field obj-type like ub.clients.obj-type
      170     field obj-code like ub.clients.obj-code
      171     field obj-name like ub.clients.obj-name
      172     field obj-id   as integer
