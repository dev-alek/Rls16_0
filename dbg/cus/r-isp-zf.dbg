     1061           sym10 v-date-nakl    column-label "Дата!поставки"          format "99.99.99"          space(0)
     1062           sym11 v-time-nakl    column-label "Время!пост."            format "X(6)"              space(0)
     1063           sym12 v-cost-nakl    column-label "Цена!поставки"          format ">>>>>>>>9.99"      space(0)
