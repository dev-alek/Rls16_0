      968         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      969         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      970     end.
      971     mFrameView = not session:batch-mode and mFramHandle:visible.
      972     if mFrameView
      973     then do:
      974       ASSIGN
      975          FRAME InfoFrame:HIDDEN                           = TRUE
      976          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      977     end.
      978   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      979   DO:
      980     IF not StopProcessing THEN
      981       Message "Вы действительно хотите прервать" SKIP
      982               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      983                 UPDATE StopProcessing.
      984     IF StopProcessing THEN do:
      985        if mFrameView
      986        then do:
      987           HIDE FRAME InfoFrame.
      988        end.
      989     End.
      990   END.
      991   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      992     if  log-manager:logfile-name ne ?
      993     then DO:
      994         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      995     end.
      996     if not session:batch-mode then
      997     do:
      998       VIEW FRAME InfoFrame.
      999       mFrameView = true.
     1000     end.
     1001      v-button-stop = false .
     1002         if mFrameView
     1003         then do:
     1004         if v-button-stop then view STOPBTN in frame InfoFrame.
     1005                          else Hide STOPBTN in frame InfoFrame.
     1006         end.
     1007     define variable  Line as char no-undo.
     1008     define variable  v-bar-code            as integer                  no-undo.
     1009     define variable  v-goods-artic         as char                     no-undo.
