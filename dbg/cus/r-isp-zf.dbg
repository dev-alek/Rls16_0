     1068     run prn-lib-open-stream  in this-procedure (input parParentProc,input 43,input yes,input no).
     1069     FORM HEADER
     1070         Line format "X(198)" AT 1 SKIP
     1071         "Продолжение - на следующей странице" AT 30 SKIP
     1072         with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     1073     VIEW stream PrnLibStream FRAME BottomFrame .
     1074     if p-post-2 = 2 then do:
     1075       FORM HEADER
     1076           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(70)"
     1077           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 170 format "X(15)" SKIP
     1078           Line format "X(198)" AT 1 with FRAME f-doc .
     1079     end.
     1080     else do:
     1081       FORM HEADER
     1082           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(70)"
     1083           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 170 format "X(15)" SKIP
     1084           Line format "X(198)" AT 1 with FRAME f-doc1 .
     1085     end.
     1086     PUT stream PrnLibStream SPACE(30) "Отчет по исполнению заказов по фирме за период с: " x-date-start format "99/99/9999" "г. по: "  x-date-end format "99/99/9999" "г." SKIP .
     1087     PUT stream PrnLibStream  str1 format "X(100)" SKIP  str2 format "X(100)" SKIP str3 format "X(100)" SKIP .
     1088       for each buf_ord-doc no-lock
     1089         where buf_ord-doc.host-code = g#host-code
     1090           and buf_ord-doc.doc-type  = 'ФП':U
     1091           and buf_ord-doc.doc-date >= x-date-start
     1092           and buf_ord-doc.doc-date <= x-date-end
     1093         :
     1094         if p-post = 2 then do:
     1095           find buf_clients no-lock
     1096             where buf_clients.obj-type = buf_ord-doc.cli-type
     1097               and buf_clients.obj-code = buf_ord-doc.cli-code .
     1098           if not can-do( p_cli-list, string( recid( buf_clients ) ) ) then next.
     1099         end.
     1100         assign
     1101           PrnNum = no
     1102           sum-doc-val-post = 0
     1103           sum-doc-val-nakl = 0
     1104           v-date-post = buf_ord-doc.ship-date
     1105           v-time-post =  string(buf_ord-doc.ship-time, "HH:MM")
     1106         .
     1107         for each buf_ord-line no-lock
     1108            where buf_ord-line.doc-code  = buf_ord-doc.doc-code
     1109           :
     1110           assign Counter = Counter + 1.
     1111   IF ( Counter modulo v-account = 0 )  then DO:
     1112             if  log-manager:logfile-name ne ?
     1113             then DO:
     1114                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1115             end.
     1116              if mFrameView
     1117              then do:
     1118               DISPLAY
     1119                 Counter @ RecordsDone
     1120                 WITH FRAME InfoFrame.
     1121              end.
     1122   End.
     1123      if v-button-stop then  DO:
     1124            if mFrameView
     1125            then
     1126               PROCESS EVENTS.
     1127            IF StopProcessing THEN DO:
     1128            RETURN error.
     1129            End.
     1130      end.
     1131           if x-SelectGood <> 1 then do:
     1132             find first gds-list no-lock
     1133               where gds-list.artic     = buf_ord-line.artic
     1134                 and gds-list.prod-type = buf_ord-line.prod-type
     1135                 and gds-list.prod-code = buf_ord-line.prod-code
     1136                 no-error
     1137               .
     1138             if not available gds-list then next .
     1139           end.
     1140           assign
     1141             v-val-post  = buf_ord-line.qnty
     1142             v-val-nakl  = 0
     1143             v-cost-nakl = 0
     1144           .
     1145           if x-SET_val_TYPE = 1 then do:
     1146             assign
     1147               v-cost-post = buf_ord-line.price-rubl
     1148             .
     1149           end.
     1150           else do:
     1151             assign
     1152               v-cost-post = buf_ord-line.price-base
     1153             .
     1154           end.
     1155           for each Temp-i :
     1156             delete Temp-i.
     1157           end.
     1158           for each buf_ord-doc-rcv no-lock
     1159             where buf_ord-doc-rcv.doc-code  = buf_ord-doc.doc-code
     1160             :
     1161             if p-post-2 = 2 then do:
     1162             for each ub.ord-chain no-lock where
     1163                       ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     1164                       ub.ord-chain.doc-type = 'rcv'                  and
     1165                       ub.ord-chain.rel-doc-type = 'trn'
     1166                       :
     1167               find first buf_trn-doc no-lock
     1168                 where buf_trn-doc.doc-code  = ub.ord-chain.rel-doc-code no-error
     1169               .
     1170               if not available buf_trn-doc then next .
     1171               if  p-otkl = 4 or p-otkl = 5 then do:
     1172                 run cmptime-time-diff ( buf_trn-doc.fact-date, buf_ord-doc-rcv.fact-ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1173                 if p-time >= ABSOLUTE( v-difference ) then next .
     1174               end.
     1175               find first buf_doc-line no-lock
     1176                 where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     1177                   and buf_doc-line.artic     = buf_ord-line.artic
     1178                   and buf_doc-line.prod-type = buf_ord-line.prod-type
     1179                   and buf_doc-line.prod-code = buf_ord-line.prod-code
     1180                   no-error
     1181                 .
     1182               if available buf_doc-line then do:
     1183                 create Temp-i no-error .
     1184                 assign
