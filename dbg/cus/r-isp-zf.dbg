      831     define input parameter p-report-name-html as character no-undo .
      832     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      833   end procedure.
      834   procedure prn-lib-reportviewer :
      835     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      836     define input parameter p-report-name-html as character no-undo .
      837     define input parameter p-param        as character no-undo .
      838     define variable v-excel           as character no-undo init 'TRUE' .
      839     define variable v-value-character as character no-undo .
      840     define variable v-value-integer   as character no-undo .
      841     define variable v-value-date      as date      no-undo .
      842     define variable v-value-decimal   as decimal   no-undo .
      843     define variable rep-excel         as logical   no-undo .
      844     define variable excel-string      as character no-undo .
      845     define variable v-param-type      as character no-undo .
      846     define variable v-tth             as handle    no-undo .
      847     run adm/shattri.p (
      848       input "get":U
      849       ,input  ""
      850       ,input  0
      851       ,input  'report-glob':U
      852       ,input  'rep-excel':U
      853       ,output v-value-character
      854       ,output v-value-date
      855       ,output v-value-decimal
      856       ,output v-value-integer
      857       ,output rep-excel
      858       ,output v-param-type
      859       ,INPUT-OUTPUT table-handle v-tth
      860       )  .
      861     if rep-excel then v-excel = "TRUE" .
      862     else v-excel = "FALSE" .
      863     if p-param eq ""
      864     then
      865        p-param = "EXCEL:" + v-excel.
      866     else
      867        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      868     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      869   end procedure.
