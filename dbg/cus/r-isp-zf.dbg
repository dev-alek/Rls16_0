      610   procedure cmptime :
      611   do
      612   on error undo, return error
      613   :
      614   define output parameter p-difference as decimal      no-undo.
      615   define variable v-srv-time      as decimal           no-undo.
      616   define variable v-cli-time      as decimal           no-undo.
      617   assign
      618       session :time-source = "ub":U
      619       v-srv-time = integer(today) + ( time / 86400 )
      620   .
      621   assign
      622       session :time-source = "LOCAL":U
      623       v-cli-time = integer(today) + ( time / 86400 )
      624   .
      625   assign
      626       p-difference = ( v-srv-time - v-cli-time ) * 1440
      627   .
      628   end.
      629   end procedure.
      630   procedure cmptime-time-diff :
      631   do
      632   on error undo, return error
      633   :
      634   define input parameter p-date1          as date         no-undo.
      635   define input parameter p-time1          as integer      no-undo.
      636   define input parameter p-date2          as date         no-undo.
      637   define input parameter p-time2          as integer      no-undo.
      638   define output parameter p-difference    as decimal      no-undo.
      639       assign
      640           p-difference = ( integer( p-date2 ) - integer( p-date1 ) + ( ( p-time2 - p-time1 ) / 86400 ) ) * 1440
      641       .
      642   end.
      643   end procedure.
      644   procedure cmptime-string-to-hms :
      645   do
      646   on error undo, return error
      647   :
      648   define input parameter p-time-string as character    no-undo.
      649   define input parameter p-format      as character    no-undo.
      650   define output parameter p-hour as integer      no-undo.
      651   define output parameter p-min  as integer      no-undo.
      652   define output parameter p-sec  as integer      no-undo.
      653   if p-format <> "hh:mm" and p-format <> "hh:mm:ss"
      654   then do:
      655       message
      656         "cmptime.i: Ошибка преобразования строки даты"
      657         skip return-value
      658         skip trim(error-status :get-message(1))
      659              trim(error-status :get-message(2))
      660              trim(error-status :get-message(3))
      661              trim(error-status :get-message(4))
      662              trim(error-status :get-message(5))
      663       view-as alert-box error.
      664       undo, return error .
      665   end.
      666   assign
      667       p-hour      = integer ( entry( 1, p-time-string, ":" ) )
      668       p-min       = integer ( entry( 2, p-time-string, ":" ) )
      669       p-sec       = ( if p-format = "hh:mm:ss"
      670                       then integer ( entry( 3, p-time-string, ":" ) )
      671                       else 0
      672                     )
      673   .
      674   end.
      675   end procedure.
      676   procedure cmptime-hms-to-integer :
      677   do
      678   on error undo, return error
      679   :
      680   define input parameter p-hour   as integer      no-undo.
      681   define input parameter p-min    as integer      no-undo.
      682   define input parameter p-sec    as integer      no-undo.
      683   define output parameter p-time  as integer      no-undo.
      684       assign
      685           p-time = p-hour * 3600 + ( p-min * 60 ) + p-sec
      686       .
      687   end.
      688   end procedure.
      689   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      690   define  stream PrnLibStream.
      691   procedure prn-lib-prn-file :
      692     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      693     define input parameter p-DIsabledoptions as integer no-undo .
      694     define variable v-report-name as character no-undo .
      695     define variable v-user-action as character no-undo .
      696     define variable v-printed     as logical   no-undo .
      697     define variable v-exist       as logical   no-undo .
      698     do
      699       on error undo, return error
      700       :
      701       run prn-lib-get-report-name  in this-procedure (
      702         input parParentProc
      703         ,output v-report-name
      704         ).
      705   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      707     (input  v-report-name
      708     ,input  2
      709     ,output v-exist
      710     )  .
      711       if NOT v-exist then
      712       DO:
      713         Message
      714           "Нет заданий на печать ! "
      715           view-as alert-box .
      716         Return  .
      717       End.
      718       run gbl/prnfilen.w
      719         (input  ""
      720         ,input  p-DisabledOptions
      721         ,input  string(v-report-name )
      722         ,input  7
      723         ,output v-user-action
      724         ,output v-printed
      725         ) .
      726       if v-printed then
      727       do:
      728         return "YES" .
      729       end.
      730       else
      731       do:
      732         return "NO" .
      733       end.
      734     end.
      735   end procedure.
      736   procedure prn-lib-open-stream :
      737     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      738     define input parameter p-page-size    as integer no-undo .
      739     define input parameter p-is-stream    as logical no-undo .
      740     define input parameter p-append       as logical no-undo .
      741     define variable v-report-name as character no-undo .
      742     do
      743       on error undo, return error
      744       :
      745       run prn-lib-get-report-name  in this-procedure (
      746         input parParentProc
      747         ,output v-report-name
      748         ).
      749       if p-is-stream then
      750       do:
      751         if p-append then
      752         do:
      753           output stream PrnLibStream to value( v-report-name )
      754             page-size value(p-page-size) append .
      755         end.
      756         if not p-append then
      757         do:
      758           output stream PrnLibStream to value( v-report-name )
      759             page-size value(p-page-size) .
      760         end.
      761       end.
      762       if not p-is-stream then
      763       do:
      764         if p-append then
      765         do:
      766           output to value( v-report-name )
      767             page-size value(p-page-size) append .
      768         end.
      769         if not p-append then
      770         do:
      771           output to value( v-report-name )
      772             page-size value(p-page-size) .
      773         end.
      774       end.
      775     end.
      776   end procedure.
      777   procedure prn-lib-open-exp :
      778     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      779     define input parameter p-is-stream    as logical no-undo .
      780     define input parameter p-is-append    as logical no-undo .
      781     define output parameter p-ReportFileName as char init "report" no-undo.
      782     define output parameter p-process as logical no-undo .
      783     define variable glog as logical no-undo .
      784     do
      785       on error undo, return error
      786       :
      787       SYSTEM-DIALOG GET-FILE p-ReportFileName
      788         TITLE      "Укажите путь"
      789         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      790         ASK-OVERWRITE
      791         CREATE-TEST-FILE
      792         SAVE-AS
      793         USE-FILENAME
      794         DEFAULT-EXTENSION "txt"
      795         UPDATE glog
      796         .
      797       if not glog then  return.
      798       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      799       if p-is-stream then
      800       do:
      801         if p-is-append then
      802         do:
      803           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      804         end.
      805         else
      806         do:
      807           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      808         end.
      809       end.
      810       else
      811       do:
      812         if p-is-append then
      813         do:
      814           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      815         end.
      816         else
      817         do:
      818           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      819         end.
      820       end.
      821       p-process = yes.
      822     end.
      823   end procedure.
      824   procedure prn-lib-get-report-name :
      825     define input parameter parParentProc  as widget-handle no-undo.
      826     define output parameter p-report-name as character no-undo .
      827     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      828   end procedure.
      829   procedure prn-lib-reportviewer-report-name :
