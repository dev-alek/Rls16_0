     1031     define variable  v-difference          as decimal      no-undo.
     1032   if session :set-wait-state( "compiler" ) then.
     1033     Line = fill("-", 198).
     1034       DEFINE frame f-doc
     1035           sym1  v-bar-code     column-label " Код!        "          format ">>>>>>>>>>>>>>9"  space(0)
     1036           sym2  v-goods-artic  column-label " Артикул! "             format "X(15)"             space(0)
