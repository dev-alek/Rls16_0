     1186                   Temp-i.i-num-rcv    = buf_ord-doc-rcv.rcv-code
     1187                   Temp-i.i-val-nakl   = buf_doc-line.fact-qnty
     1188                   Temp-i.i-date-nakl  = buf_trn-doc.fact-date
     1189                   Temp-i.i-time-nakl  = string(buf_ord-doc-rcv.fact-ship-time, "HH:MM")
     1190                 .
     1191                 if x-SET_val_TYPE = 1 then do:
     1192                   assign
     1193                     Temp-i.i-cost-nakl  = buf_doc-line.price-rubl
     1194                   .
     1195                 end.
     1196                 else do:
     1197                   assign
     1198                     Temp-i.i-cost-nakl = buf_doc-line.price-base
     1199                   .
     1200                 end.
     1201               end.
     1202             end.
     1203             end.
     1204             else do:
     1205               if p-otkl = 4 or p-otkl = 5 then do:
     1206                 run cmptime-time-diff ( buf_ord-doc-rcv.ship-date, buf_ord-doc-rcv.ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1207                 if p-time >= ABSOLUTE( v-difference ) then next .
     1208               end.
     1209               find first buf_ord-line-rcv no-lock
     1210                 where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
     1211                   and buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
     1212                   and buf_ord-line-rcv.artic     = buf_ord-line.artic
     1213                   and buf_ord-line-rcv.prod-type = buf_ord-line.prod-type
     1214                   and buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     1215                   no-error
     1216                 .
     1217               if available buf_ord-line-rcv then do:
     1218                 create Temp-i no-error .
     1219                 assign
     1220                   Temp-i.i-num-doc    = buf_ord-doc-rcv.doc-code
     1221                   Temp-i.i-num-rcv    = buf_ord-doc-rcv.rcv-code
     1222                   Temp-i.i-val-nakl   = buf_ord-line-rcv.qnty
     1223                   Temp-i.i-date-nakl  = buf_ord-doc-rcv.ship-date
     1224                   Temp-i.i-time-nakl  = string(buf_ord-doc-rcv.ship-time, "HH:MM")
     1225                 .
     1226                 if x-SET_val_TYPE = 1 then do:
     1227                   assign
     1228                     Temp-i.i-cost-nakl  = buf_ord-line-rcv.price-rubl
     1229                   .
     1230                 end.
     1231                 else do:
     1232                   assign
     1233                     Temp-i.i-cost-nakl = buf_ord-line-rcv.price-base
     1234                   .
     1235                 end.
     1236               end.
     1237             end.
     1238           end.
     1239           assign
     1240             NumPost = 0
     1241             StatOtkl = 0
     1242           .
     1243           if p-otkl = 1 or p-otkl = 4 or p-otkl = 5 then do:
     1244             assign
     1245               StatOtkl = 1
     1246             .
     1247           end.
     1248           for each Temp-i no-lock :
     1249             assign
     1250               NumPost = NumPost + 1
     1251             .
     1252             case p-otkl :
     1253               when 2 then do:
     1254                 if ABSOLUTE((( v-val-post - Temp-i.i-val-nakl ) * 100 / v-val-post )) > p-proc then do:
     1255                   assign
     1256                     StatOtkl = 1
     1257                   .
     1258                 end.
     1259               end.
     1260               when 3 then do:
     1261                 if ABSOLUTE((( v-cost-post - Temp-i.i-cost-nakl ) * 100 / v-cost-post )) > p-proc then do:
     1262                   assign
     1263                     StatOtkl = 1
     1264                   .
     1265                 end.
     1266               end.
     1267               when 5 then do:
     1268                 if ABSOLUTE((( v-val-post - Temp-i.i-val-nakl ) * 100 / v-val-post )) > p-proc then do:
     1269                   assign
     1270                     StatOtkl = 1
     1271                   .
     1272                 end.
     1273                 if ABSOLUTE((( v-cost-post - Temp-i.i-cost-nakl ) * 100 / v-cost-post )) > p-proc then do:
     1274                   assign
     1275                     StatOtkl = 1
     1276                   .
     1277                 end.
     1278               end.
     1279             end.
     1280           end.
     1281           if StatOtkl = 0 then next .
     1282           find first buf_goods  no-lock
     1283             where buf_goods.artic     = buf_ord-line.artic
     1284               and buf_goods.prod-type = buf_ord-line.prod-type
     1285               and buf_goods.prod-code = buf_ord-line.prod-code
     1286             .
     1287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1288     (input  buf_goods.gds-code
     1289     ,input  ?
     1290     ,output v-bar-code
     1291     ) no-error .
     1292    .
     1293           if error-status:error then do:
     1294             message
     1295               vss-workfile + ". Не найден бар-код товара " + buf_goods.artic
     1296             view-as alert-box error.
     1297             undo, return error .
     1298           end.
     1299           if p-tg-zay = yes then do:
     1300             if PrnNum = no then do:
     1301               assign
     1302                 PrnNum = yes
     1303                 v-goods-name = string( " Заказ " + buf_ord-doc.doc-code )
     1304               .
     1305               if p-post-2 = 2 then do:
     1306                 display stream PrnLibStream sym1 v-goods-name sym15 with frame f-doc.
     1307                 down stream PrnLibStream with frame f-doc .
     1308               end.
     1309               else do:
     1310                 display stream PrnLibStream sym1 v-goods-name sym15 with frame f-doc1.
     1311                 down stream PrnLibStream with frame f-doc1 .
     1312               end.
     1313             end.
     1314           end.
     1315           assign
     1316             v-goods-artic   = string(buf_goods.artic)
     1317             v-goods-name    = buf_goods.gds-name
     1318             v-goods-unit    = buf_goods.unit-base
     1319             sum-doc-val-post = sum-doc-val-post + v-val-post
     1320             sum-all-val-post = sum-all-val-post + v-val-post
     1321           .
     1322           find first Temp-i no-lock no-error .
     1323           if not available Temp-i then do:
     1324             if p-post-2 = 2 then do:
     1325               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8  v-cost-post sym9 sym10 sym11 sym12 sym13 sym14 sym15 with frame f-doc.
     1326               down stream PrnLibStream with frame f-doc .
     1327             end.
     1328             else do:
     1329               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8  v-cost-post sym9 sym10 sym11 sym12 sym13 sym14 sym15 with frame f-doc1.
     1330               down stream PrnLibStream with frame f-doc1 .
     1331             end.
     1332           end.
     1333           else do:
     1334             assign
     1335               v-val-nakl  = Temp-i.i-val-nakl
     1336               v-date-nakl = Temp-i.i-date-nakl
     1337               v-time-nakl = Temp-i.i-time-nakl
     1338               v-cost-nakl = Temp-i.i-cost-nakl
     1339               v-otkl      = v-val-nakl - v-val-post
     1340               v-otkl-prc  = (v-val-nakl - v-val-post) * 100 / v-val-post
     1341               sum-doc-val-nakl = sum-doc-val-nakl + v-val-nakl
     1342               sum-all-val-nakl = sum-all-val-nakl + v-val-nakl
     1343             .
     1344             if p-post-2 = 2 then do:
     1345               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8  v-cost-post sym9  v-val-nakl sym10 v-date-nakl sym11 v-time-nakl sym12 v-cost-nakl sym13 v-otkl sym14  v-otkl-prc sym15  with frame f-doc.
     1346               down stream PrnLibStream with frame f-doc .
     1347             end.
     1348             else do:
     1349               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8  v-cost-post sym9  v-val-nakl sym10 v-date-nakl sym11 v-time-nakl sym12 v-cost-nakl sym13 v-otkl sym14  v-otkl-prc sym15  with frame f-doc1.
     1350               down stream PrnLibStream with frame f-doc1 .
     1351             end.
     1352             if NumPost > 1 then do:
     1353               assign
     1354                 StatOtkl = 0
     1355               .
     1356               for each Temp-i no-lock :
     1357                 if StatOtkl = 0 then do:
     1358                   assign
     1359                     StatOtkl = 1
     1360                   .
     1361                 end.
     1362                 else do:
     1363                   assign
     1364                     v-val-nakl  = Temp-i.i-val-nakl
     1365                     v-date-nakl = Temp-i.i-date-nakl
     1366                     v-time-nakl = Temp-i.i-time-nakl
     1367                     v-cost-nakl = Temp-i.i-cost-nakl
     1368                     v-otkl      = v-val-nakl - v-val-post
     1369                     v-otkl-prc  = (v-val-nakl - v-val-post) * 100 / v-val-post
     1370                     sum-doc-val-nakl = sum-doc-val-nakl + v-val-nakl
     1371                     sum-all-val-nakl = sum-all-val-nakl + v-val-nakl
     1372                   .
     1373                   if p-post-2 = 2 then do:
     1374                     display stream PrnLibStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 v-val-nakl sym10 v-date-nakl sym11 v-time-nakl sym12 v-cost-nakl sym13 v-otkl sym14  v-otkl-prc sym15 with frame f-doc.
     1375                     down stream PrnLibStream with frame f-doc .
     1376                   end.
     1377                   else do:
     1378                     display stream PrnLibStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 v-val-nakl sym10 v-date-nakl sym11 v-time-nakl sym12 v-cost-nakl sym13 v-otkl sym14  v-otkl-prc sym15 with frame f-doc1.
     1379                     down stream PrnLibStream with frame f-doc1 .
     1380                   end.
     1381                 end.
     1382               end.
     1383               if p-post-2 = 2 then do:
     1384                 assign
     1385                   v-goods-name = "Всего по накладным:"
     1386                   v-val-nakl   = sum-doc-val-nakl
     1387                 .
     1388                 display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 sym6 sym7 sym8 sym9 v-val-nakl sym10 sym11 sym12 sym13 sym14  sym15 with frame f-doc.
     1389                 down stream PrnLibStream with frame f-doc .
     1390               end.
     1391               else do:
     1392                 assign
     1393                   v-goods-name = "Всего по поставкам:"
     1394                   v-val-nakl   = sum-doc-val-nakl
     1395                 .
     1396                 display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 sym6 sym7 sym8 sym9 v-val-nakl sym10 sym11 sym12 sym13 sym14  sym15 with frame f-doc1.
     1397                 down stream PrnLibStream with frame f-doc1 .
     1398               end.
     1399             end.
     1400           end.
     1401         end.
     1402         if p-tg-zay = yes then do:
     1403           if PrnNum = yes then do:
     1404             assign
     1405               v-goods-name = "Всего по заказу:"
     1406               v-val-post   = sum-doc-val-post
     1407               v-val-nakl   = sum-doc-val-nakl
     1408             .
     1409             if p-post-2 = 2 then do:
     1410               display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 sym9 v-val-nakl sym10 sym11 sym12 sym13 sym14  sym15 with frame f-doc.
     1411               down stream PrnLibStream with frame f-doc .
     1412             end.
     1413             else do:
     1414               display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 sym9 v-val-nakl sym10 sym11 sym12 sym13 sym14  sym15 with frame f-doc1.
     1415               down stream PrnLibStream with frame f-doc1 .
     1416             end.
     1417           end.
     1418         end.
     1419       end.
     1420     assign
     1421       v-goods-name = "ИТОГО:"
     1422       v-val-post   = sum-all-val-post
     1423       v-val-nakl   = sum-all-val-nakl
     1424     .
     1425     if p-post-2 = 2 then do:
     1426       display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 sym9 v-val-nakl sym10 sym11 sym12 sym13 sym14  sym15 with frame f-doc.
     1427       down stream PrnLibStream with frame f-doc .
     1428     end.
     1429     else do:
     1430       display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 sym9 v-val-nakl sym10 sym11 sym12 sym13 sym14  sym15 with frame f-doc1.
     1431       down stream PrnLibStream with frame f-doc1 .
     1432     end.
     1433     PUT STREAM PrnLibStream Line format "X(198)".
     1434     HIDE stream PrnLibStream FRAME BottomFrame .
     1435     OUTPUT stream PrnLibStream CLOSE.
     1436   if mFrameView
     1437   then do:
     1438      HIDE FRAME InfoFrame.
     1439   end.
     1440   if session :set-wait-state( "" ) then.
     1441     run prn-lib-prn-file in this-procedure (input parParentProc,input 8).
     1442   END.
