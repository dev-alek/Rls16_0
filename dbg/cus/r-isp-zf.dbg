     1016     define variable  v-val-nakl            as decimal                  no-undo.
     1017     define variable  v-date-nakl           as date                     no-undo.
     1018     define variable  v-time-nakl           as char                     no-undo.
     1019     define variable  v-cost-nakl           as decimal                  no-undo.
     1020     define variable  v-otkl                as decimal                  no-undo.
