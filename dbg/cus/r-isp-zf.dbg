      178   procedure create_obj-list :
      179      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      180      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      181      do
      182      on error undo, return error return-value
      183      :
      184         define buffer cli-obj for ub.clients .
      185         define variable p-var as integer no-undo .
      186         define buffer buf_obj-list for obj-list .
      187         find last buf_obj-list  use-index pi no-error .
      188         if available buf_obj-list
      189         then
      190            p-var = buf_obj-list.obj-id + 1.
      191         else
      192            p-var = 1.
      193         find first cli-obj where
      194                   cli-obj.obj-type = p-obj-type
      195               and cli-obj.obj-code = p-obj-code
      196         no-lock no-error.
      197         if available cli-obj
      198         then do:
      199            create buf_obj-list.
      200            assign
      201               buf_obj-list.obj-id   = p-var
      202               buf_obj-list.obj-code = cli-obj.obj-code
      203               buf_obj-list.obj-type = cli-obj.obj-type
      204               buf_obj-list.obj-name = cli-obj.obj-name
      205               buf_obj-list.db-num   = cli-obj.db-num
      206            .
      207         end.
      208      end.
      209   end.
