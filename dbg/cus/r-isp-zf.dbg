     1040           sym6  v-date-post    column-label "Дата!заказа"            format "99.99.99"          space(0)
     1041           sym7  v-time-post    column-label "Время!заказа"           format "X(6)"              space(0)
     1042           sym8  v-cost-post    column-label "Цена!заказа"            format ">>>>>>>>9.99"      space(0)
     1043           sym9  v-val-nakl     column-label "Кол-во по!накладной"    format "->>>>>>>9.999"     space(0)
     1044           sym10 v-date-nakl    column-label "Дата!накл-ой"           format "99.99.99"          space(0)
     1045           sym11 v-time-nakl    column-label "Время!накл."            format "X(6)"              space(0)
     1046           sym12 v-cost-nakl    column-label "Цена!накладной"         format ">>>>>>>>9.99"      space(0)
     1047           sym13 v-otkl         column-label "Отклонение! "           format "->>>>>9.999"       space(0)
     1048           sym14 v-otkl-prc     column-label "  %  ! откл."           format "->>9.99"           space(0)
     1049           sym15
     1050       with width 235 down stream-io.
     1051       DEFINE frame f-doc1
     1052           sym1  v-bar-code     column-label " Код!        "          format ">>>>>>>>>>>>>>9"   space(0)
     1053           sym2  v-goods-artic  column-label " Артикул! "             format "X(15)"             space(0)
