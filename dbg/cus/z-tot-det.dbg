     2309               '         <th   style="background-color:#ffffcc; text-align: center;">Название товара</th>' skip
     2310               '         <th   style="background-color:#ffffcc; text-align: center;">Артикул поставщика </th>' skip
     2311               '         <th   style="background-color:#ffffcc; text-align: center;">Цена в валюте поставщика на баз.ед.изм.</th>' skip
     2312               '         <th   style="background-color:#ffffcc; text-align: center;">Количество в баз.ед.изм</th>' skip
     2313               '       </tr>' skip.
     2314           output stream OutStr-html close.
     2315       end.
     2316       output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     2317       define variable v-cli as decimal no-undo.
     2318       for each  buf_ord-line no-lock where  buf_ord-line.doc-code = p-ord-doc break by buf_ord-line.line-num  :
     2319           find first goods no-lock where
     2320               goods.artic     = buf_ord-line.artic     and
     2321               goods.prod-type = buf_ord-line.prod-type and
     2322               goods.prod-code = buf_ord-line.prod-code no-error .
     2323           if error-status :error then next.
     2324           find first clients no-lock where
     2325               goods.prod-type = clients.obj-type and
     2326               goods.prod-code = clients.obj-code no-error .
     2327           if error-status :error then next.
     2328           v-cli =  (buf_ord-line.price-cli / buf_ord-line.cli-base-rate).
     2329           put stream OutStr-html unformatted
     2330               '       <tr level="1">' skip
     2331               '         <td  style="display: yes; text-align: right; font-weight: bold">' +  buf_ord-line.artic + '</td>' skip
     2332               '         <td style="display: yes; text-align:  right; font-weight: bold">' +  buf_ord-line.prod-type  + '</td>' skip
     2333               '         <td style="display: yes; text-align:  right; font-weight: bold">'  + string(buf_ord-line.prod-code)  + '</td>' skip
     2334               '         <td text_wrap="true" style="display: yes; text-align:  right; font-weight: bold">'   +  goods.gds-name  + '</td>' skip
     2335               '         <td style="display: yes; text-align:  right; font-weight: bold">'   + buf_ord-line.cli-art  + '</td>' skip
     2336               '         <td style="display: yes; text-align:  right; font-weight: bold">'  +  string(v-cli, "->>>>>>>9.999") +  '</td>' skip
     2337               '         <td style="display: yes; text-align:  right; font-weight: bold">'  +  string(buf_ord-line.qnty, "->>>>>>>9.99")  + '</td>' skip
     2338               '       </tr>' skip
     2339               .
     2340       end.
     2341       do:
     2342           put stream OutStr-html unformatted
     2343               '     </tbody>' skip
     2344               '    </thead>' skip
     2345               '   </table>' skip
     2346               '  </body>' skip.
     2347       end.
     2348       for each buf_ord-doc-rcv where buf_ord-doc-rcv.doc-code =  p-ord-doc by buf_ord-doc-rcv.obj-code:
     2349           find first sh-clients no-lock where
     2350               sh-clients.obj-type =  buf_ord-doc-rcv.obj-type and
     2351               sh-clients.obj-code =  buf_ord-doc-rcv.obj-code no-error  .
     2352           if error-status :error then next.
     2353           find first post-clients no-lock where
     2354               post-clients.obj-type =   buf_ord-doc-rcv.cli-type and
     2355               post-clients.obj-code =  buf_ord-doc-rcv.cli-code no-error  .
     2356           if error-status :error then next.
     2357           run fmtcli-get-client in this-procedure (
     2358               input buf_ord-doc-rcv.obj-type,
     2359               input buf_ord-doc-rcv.obj-code
     2360               ).
     2361           put stream OutStr-html unformatted
     2362               ' <body>' skip
     2363               '   <table name="' + buf_ord-doc-rcv.obj-type + string(buf_ord-doc-rcv.obj-code) + "-" +  buf_ord-doc-rcv.rcv-code '" fit_to_page="true" orientation="landscape" outline_below="false">' skip
     2364               '     <thead>' skip
     2365               '       <tr class="set_columns">' skip
     2366               '         <td style="width: 100px; border: none;"></td>' skip
     2367               '         <td style="width: 110px; border: none;"></td>' skip
     2368               '         <td style="width: 110px; border: none;"></td>' skip
     2369               '         <td style="width: 180px; border: none;"></td>' skip
     2370               '         <td style="width: 100px; border: none;"></td>' skip
     2371               '         <td style="width: 100px; border: none;"></td>' skip
     2372               '         <td style="width: 100px; border: none;"></td>' skip
     2373               '       </tr>' skip
     2374               .
     2375           do:
     2376               put stream OutStr-html unformatted
     2377                   '<TR>'skip
     2378                   '<TD  colspan = "7" style="text-align: left;border: none">Объект: ' +  sh-clients.obj-name + '</TD>'skip
     2379                   '</TR>'skip
     2380                   '<TR>'skip
     2381                   '<TD  colspan = "7" style="text-align: left;border: none">Адрес: ' + v-fmtcli-full-addres   + '</TD>'skip
     2382                   '</TR>'skip
     2383                   '     </thead>' skip
     2384                   .
     2385           end.
     2386           do:
     2387               put stream OutStr-html unformatted
     2388                   '     <tbody>' skip
     2389                   '       <tr style="height: 60px;">' skip
     2390                   '         <th   style="background-color:#ffffcc; text-align: center;">Артикул</th>' skip
     2391                   '         <th   style="background-color:#ffffcc; text-align: center;">Тип производителя</th>' skip
     2392                   '         <th   style="background-color:#ffffcc; text-align: center;">Код производителя</th>' skip
     2393                   '         <th   style="background-color:#ffffcc; text-align: center;">Название товара</th>' skip
     2394                   '         <th   style="background-color:#ffffcc; text-align: center;">Артикул поставщика </th>' skip
     2395                   '         <th   style="background-color:#ffffcc; text-align: center;">Цена в валюте поставщика на баз.ед.изм.</th>' skip
     2396                   '         <th   style="background-color:#ffffcc; text-align: center;">Количество в баз.ед.изм</th>' skip
     2397                   '       </tr>' skip.
     2398           end.
     2399           define buffer buf_ord-line-rcv for ord-line-rcv.
     2400           define variable v-cli-rcv as decimal no-undo .
     2401           define variable v-cli-art as char no-undo.
     2402           for each buf_ord-line-rcv no-lock where buf_ord-line-rcv.rcv-code = buf_ord-doc-rcv.rcv-code and  buf_ord-line-rcv.doc-code = buf_ord-doc-rcv.doc-code :
     2403               find first goods no-lock where
     2404                   goods.artic     = buf_ord-line-rcv.artic     and
     2405                   goods.prod-type = buf_ord-line-rcv.prod-type and
     2406                   goods.prod-code = buf_ord-line-rcv.prod-code no-error .
     2407               if error-status :error then next.
     2408               find first clients no-lock where
     2409                   goods.prod-type = clients.obj-type and
     2410                   goods.prod-code = clients.obj-code no-error .
     2411               if error-status :error then next.
     2412                         find first   buf_ord-line no-lock where  buf_ord-line.doc-code = buf_ord-line-rcv.doc-code  and buf_ord-line.artic = buf_ord-line-rcv.artic and  buf_ord-line-rcv.prod-type = buf_ord-line.prod-type
     2413                         and buf_ord-line-rcv.prod-code = buf_ord-line.prod-code no-error.
     2414                         if available buf_ord-line then do:
     2415                             v-cli-art  = buf_ord-line.cli-art.
     2416                             end.
     2417               v-cli-rcv =  (buf_ord-line.price-cli / buf_ord-line.cli-base-rate).
     2418               put stream OutStr-html unformatted
     2419                   '       <tr level="1">' skip
     2420                   '         <td  style="display: yes; text-align: right; font-weight: bold">' +  buf_ord-line-rcv.artic + '</td>' skip
     2421                   '         <td style="display: yes; text-align:  right; font-weight: bold">' +  buf_ord-line-rcv.prod-type  + '</td>' skip
     2422                   '         <td style="display: yes; text-align:  right; font-weight: bold">'  + string(buf_ord-line-rcv.prod-code)  + '</td>' skip
     2423                   '         <td text_wrap="true" style="display: yes; text-align:  right; font-weight: bold">'   +  goods.gds-name  + '</td>' skip
     2424                   '         <td style="display: yes; text-align:  right; font-weight: bold">' + v-cli-art  + '</td>' skip
     2425                   '         <td style="display: yes; text-align:  right; font-weight: bold">'  +  string(v-cli-rcv, "->>>>>>>9.999")  + '</td>' skip
     2426                   '         <td style="display: yes; text-align:  right; font-weight: bold">'  +  string(buf_ord-line-rcv.qnty, "->>>>>>>9.999") + '</td>' skip
     2427                   '       </tr>' skip
     2428                   .
     2429           end.
     2430           do:
     2431               put stream OutStr-html unformatted
     2432                   '</thead>' skip
     2433                   '     </tbody>' skip
     2434                   '</table>' skip
     2435                   '</body>' skip
     2436                   .
     2437           end.
     2438       end.
     2439       do:
     2440           put stream OutStr-html unformatted
     2441               ' </html>' skip
     2442               .
     2443           output stream OutStr-html close.
     2444       end.
     2445   end procedure.
     2446   procedure define-full-path-Report:
     2447       define input parameter p-rep-num as integer no-undo.
     2448       define output parameter p-file-name-rep-htm as character no-undo.
     2449       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2450   end procedure.
     2451   procedure create-file:
     2452       define input parameter p-file-name as character no-undo.
     2453       output to value(string(p-file-name)).
     2454       output close.
     2455   end procedure.
     2456   procedure Report-Viewer:
     2457       define input parameter p-full-path-RepView as character no-undo.
     2458       define input parameter p-file-name-rep-htm as character no-undo.
     2459       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     2460   end procedure.
     2461   procedure get-full-path-RepViewer:
     2462       define output parameter p-fill-path-RepView as character no-undo.
     2463       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     2464       do:
     2465           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     2466       end.
     2467       else
     2468       do:
     2469           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     2470       end.
     2471   end procedure.
     2472   procedure search-full-path-Report:
     2473       define input parameter p-file-name as character no-undo.
     2474       if search(p-file-name) = ? then
     2475       do:
     2476           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     2477       end.
     2478       else
     2479       do:
     2480           p-file-name = search(p-file-name).
     2481       end.
     2482   end procedure.
