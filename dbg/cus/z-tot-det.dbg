     1592   define variable vss-include-info13 as character format "X(65)" no-undo
     1593   initial "@(#)$Workfile$ $Revision$".
     1594   define variable v-fmtcli-name          as character    no-undo.
     1595   define variable v-fmtcli-engl-name     as character    no-undo.
     1596   define variable v-fmtcli-addres        as character    no-undo.
     1597   define variable v-fmtcli-post-addres   as character    no-undo.
     1598   define variable v-fmtcli-full-addres   as character    no-undo.
     1599   define variable v-fmtcli-phone         as character    no-undo.
     1600   define variable v-fmtcli-inn           as character    no-undo.
     1601   define variable v-fmtcli-kpp           as character    no-undo.
     1602   define variable v-fmtcli-okpo          as character    no-undo.
     1603   define variable v-fmtcli-country       as character    no-undo.
     1604   define variable v-fmtcli-city          as character    no-undo.
     1605   define variable v-fmtcli-index         as character    no-undo.
     1606   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1607   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1608   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1609   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1610   define variable v-fmtcli-bank-bik      as character    no-undo.
     1611   define variable v-fmtcli-bank-name     as character    no-undo.
     1612   define variable v-fmtcli-bank-addres   as character    no-undo.
     1613   define variable v-fmtcli-bank-city     as character    no-undo.
     1614   procedure fmtcli-get-bank :
     1615   define input parameter p-host-code      as integer          no-undo.
     1616   define input parameter p-obj-type       as character        no-undo.
     1617   define input parameter p-obj-code       as integer          no-undo.
     1618   define input parameter p-curr-code      as integer          no-undo.
     1619       define buffer buf_fin-schet     for ub.fin-schet.
     1620       define buffer buf_fin-bank      for ub.fin-bank.
     1621   do
     1622   for buf_fin-schet
     1623     , buf_fin-bank
     1624   on error undo, return error
     1625   :
     1626       assign
     1627           v-fmtcli-schet-exists       = no
     1628           v-fmtcli-bank-exists        = no
     1629           v-fmtcli-bank-r-schet       = "":U
     1630           v-fmtcli-bank-c-schet       = "":U
     1631           v-fmtcli-bank-bik           = "":U
     1632           v-fmtcli-bank-name          = "":U
     1633           v-fmtcli-bank-addres        = "":U
     1634           v-fmtcli-bank-city          = "":U
     1635       .
     1636       search-for-schet:
     1637       for each buf_fin-schet no-lock
     1638          where buf_fin-schet.host-code = p-host-code
     1639            and buf_fin-schet.cli-type  = p-obj-type
     1640            and buf_fin-schet.cli-code  = p-obj-code
     1641            and buf_fin-schet.curr-code = p-curr-code
     1642       on error undo, return error
     1643       :
     1644           if buf_fin-schet.status_   = 'удал':U
     1645           then do:
     1646           end.
     1647           else do:
     1648               assign
     1649                   v-fmtcli-schet-exists   = yes
     1650                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1651                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1652               .
     1653               find first buf_fin-bank no-lock
     1654                    where buf_fin-bank.host-code = p-host-code
     1655                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1656               no-error.
     1657               if available buf_fin-bank
     1658               then do:
     1659                   assign
     1660                       v-fmtcli-bank-exists      = yes
     1661                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1662                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1663                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1664                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1665                   .
     1666               end.
     1667               else do:
     1668                   assign
     1669                       v-fmtcli-bank-exists    = no
     1670                       v-fmtcli-bank-bik       = "":U
     1671                       v-fmtcli-bank-name      = "":U
     1672                       v-fmtcli-bank-addres    = "":U
     1673                       v-fmtcli-bank-city      = "":U
     1674                   .
     1675               end.
     1676               leave search-for-schet.
     1677           end.
     1678       end.
     1679   end.
     1680   end procedure.
     1681   procedure fmtcli-get-client :
     1682   define input parameter p-obj-type       as character    no-undo.
     1683   define input parameter p-obj-code       as integer      no-undo.
     1684       define variable v-temp-fmtcli-address      as character     no-undo.
     1685       define variable v-num-country-city    as integer      no-undo.
     1686       define buffer buf_clients   for ub.clients.
     1687       define buffer buf_firm      for ub.firm.
     1688       define buffer buf_store     for ub.store.
     1689       define buffer buf_shop      for ub.shop.
     1690       define buffer buf_person    for ub.person.
     1691   do
     1692   for buf_clients
     1693     , buf_firm
     1694     , buf_store
     1695     , buf_shop
     1696     , buf_person
     1697   on error undo, return error
     1698   :
     1699       assign
     1700           v-fmtcli-name           = "":U
     1701           v-fmtcli-addres         = "":U
     1702           v-fmtcli-post-addres    = "":U
     1703           v-fmtcli-full-addres    = "":U
     1704           v-fmtcli-phone          = "":U
     1705           v-fmtcli-inn            = "":U
     1706           v-fmtcli-kpp            = "":U
     1707           v-fmtcli-okpo           = "":U
     1708           v-fmtcli-city           = "":U
     1709           v-fmtcli-index          = "":U
     1710           v-fmtcli-country        = "":U
     1711       .
     1712       find first buf_clients no-lock
     1713            where buf_clients.obj-type = p-obj-type
     1714              and buf_clients.obj-code = p-obj-code
     1715       .
     1716       assign
     1717           v-fmtcli-name = buf_clients.obj-name
     1718       .
     1719       case buf_clients.obj-type:
     1720          when 'орг':U
     1721          then do:
     1722               find first buf_firm no-lock
     1723                    where buf_firm.firm-code = buf_clients.obj-code
     1724                    no-error
     1725               .
     1726               if available buf_firm
     1727               then do:
     1728                   assign
     1729                       v-num-country-city = num-entries( buf_firm.city )
     1730                       v-fmtcli-engl-name = buf_firm.engl-name
     1731                   .
     1732                   if v-num-country-city > 0
     1733                   then do:
     1734                       assign
     1735                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1736                       .
     1737                   end.
     1738                   if v-num-country-city > 1
     1739                   then do:
     1740                       assign
     1741                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1742                       .
     1743                   end.
     1744                   run fmtcli-concatenate-strings in this-procedure (
     1745                         input v-fmtcli-full-addres
     1746                       , input v-fmtcli-country
     1747                       , input ", ":U
     1748                       , input 50
     1749                       , output v-fmtcli-full-addres
     1750                   ).
     1751                   run fmtcli-concatenate-strings in this-procedure (
     1752                         input v-fmtcli-full-addres
     1753                       , input v-fmtcli-city
     1754                       , input ", ":U
     1755                       , input 50
     1756                       , output v-fmtcli-full-addres
     1757                   ).
     1758                   run fmtcli-concatenate-strings in this-procedure (
     1759                         input v-fmtcli-full-addres
     1760                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1761                       , input ", ":U
     1762                       , input 50
     1763                       , output v-fmtcli-full-addres
     1764                   ).
     1765                   run fmtcli-concatenate-strings in this-procedure (
     1766                         input v-fmtcli-post-addres
     1767                       , input v-fmtcli-country
     1768                       , input ", ":U
     1769                       , input 50
     1770                       , output v-fmtcli-post-addres
     1771                   ).
     1772                   run fmtcli-concatenate-strings in this-procedure (
     1773                         input v-fmtcli-post-addres
     1774                       , input v-fmtcli-city
     1775                       , input ", ":U
     1776                       , input 50
     1777                       , output v-fmtcli-post-addres
     1778                   ).
     1779                   run fmtcli-concatenate-strings in this-procedure (
     1780                         input v-fmtcli-post-addres
     1781                       , input string( buf_firm.ind )
     1782                       , input ", ":U
     1783                       , input 50
     1784                       , output v-fmtcli-post-addres
     1785                   ).
     1786                   run fmtcli-concatenate-strings in this-procedure (
     1787                         input substring( buf_firm.addres1, 1, 50 )
     1788                       , input buf_firm.addres2
     1789                       , input " ":U
     1790                       , input 50
     1791                       , output v-temp-fmtcli-address
     1792                   ).
     1793                   run fmtcli-concatenate-strings in this-procedure (
     1794                         input v-temp-fmtcli-address
     1795                       , input substring( buf_firm.addres1, 51, 50 )
     1796                       , input " ":U
     1797                       , input 50
     1798                       , output v-temp-fmtcli-address
     1799                   ).
     1800                   run fmtcli-concatenate-strings in this-procedure (
     1801                         input v-temp-fmtcli-address
     1802                       , input substring( buf_firm.addres1, 101, 50 )
     1803                       , input " ":U
     1804                       , input 50
     1805                       , output v-temp-fmtcli-address
     1806                   ).
     1807                   assign
     1808                       v-fmtcli-addres = v-temp-fmtcli-address
     1809                   .
     1810                   if buf_firm.addres1 <> ?
     1811                   then do:
     1812                       run fmtcli-concatenate-strings in this-procedure (
     1813                             input v-fmtcli-full-addres
     1814                           , input v-fmtcli-addres
     1815                           , input ", ":U
     1816                           , input 0
     1817                           , output v-fmtcli-full-addres
     1818                       ).
     1819                   end.
     1820                   run fmtcli-concatenate-strings in this-procedure (
     1821                         input substring( buf_firm.post-addr1, 1, 50 )
     1822                       , input buf_firm.post-addr2
     1823                       , input " ":U
     1824                       , input 50
     1825                       , output v-fmtcli-post-addres
     1826                   ).
     1827                   run fmtcli-concatenate-strings in this-procedure (
     1828                         input v-fmtcli-post-addres
     1829                       , input substring( buf_firm.post-addr1, 51, 50 )
     1830                       , input " ":U
     1831                       , input 50
     1832                       , output v-fmtcli-post-addres
     1833                   ).
     1834                   run fmtcli-concatenate-strings in this-procedure (
     1835                         input v-fmtcli-post-addres
     1836                       , input substring( buf_firm.post-addr1, 101, 50 )
     1837                       , input " ":U
     1838                       , input 50
     1839                       , output v-fmtcli-post-addres
     1840                   ).
     1841                   assign
     1842                       v-fmtcli-phone         = buf_firm.phone
     1843                       v-fmtcli-inn           = buf_firm.inn
     1844                       v-fmtcli-kpp           = buf_firm.kpp
     1845                       v-fmtcli-okpo          = buf_firm.okpo
     1846                       v-fmtcli-index         = string( buf_firm.ind )
     1847                   .
     1848               end.
     1849          end.
     1850          when 'маг':U
     1851          then do:
     1852               find first buf_shop no-lock
     1853                    where buf_shop.obj-code = buf_clients.obj-code
     1854               .
     1855               if available buf_shop
     1856               then do:
     1857                   run fmtcli-concatenate-strings in this-procedure (
     1858                         input buf_shop.addres1
     1859                       , input buf_shop.addres2
     1860                       , input " ":U
     1861                       , input 50
     1862                       , output v-fmtcli-addres
     1863                   ).
     1864                   assign
     1865                       v-fmtcli-full-addres = v-fmtcli-addres
     1866                       v-fmtcli-post-addres = v-fmtcli-addres
     1867                       v-fmtcli-phone       = buf_shop.phone
     1868                       v-fmtcli-inn         = "":U
     1869                       v-fmtcli-kpp         = "":U
     1870                       v-fmtcli-okpo        = "":U
     1871                       v-fmtcli-city        = "":U
     1872                       v-fmtcli-index       = "":U
     1873                   .
     1874               end.
     1875          end.
     1876          when 'скл':U
     1877          then do:
     1878               find first buf_store no-lock
     1879                    where buf_store.obj-code = buf_clients.obj-code
     1880               .
     1881               if available buf_store
     1882               then do:
     1883                   run fmtcli-concatenate-strings in this-procedure (
     1884                         input buf_store.addres1
     1885                       , input buf_store.addres2
     1886                       , input " ":U
     1887                       , input 50
     1888                       , output v-fmtcli-addres
     1889                   ).
     1890                   assign
     1891                       v-fmtcli-full-addres = v-fmtcli-addres
     1892                       v-fmtcli-phone       = buf_store.phone
     1893                       v-fmtcli-inn         = "":U
     1894                       v-fmtcli-kpp         = "":U
     1895                       v-fmtcli-okpo        = "":U
     1896                       v-fmtcli-city        = "":U
     1897                       v-fmtcli-index       = "":U
     1898                   .
     1899               end.
     1900          end.
     1901          when 'чел':U
     1902          then do:
     1903               find first buf_person no-lock
     1904                    where buf_person.psn-code = buf_clients.obj-code
     1905               .
     1906               if available buf_person
     1907               then do:
     1908                   run fmtcli-concatenate-strings in this-procedure (
     1909                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1910                                 then "":U
     1911                                 else string( buf_person.ind, "999999")
     1912                                 )
     1913                       , input buf_person.city
     1914                       , input ", ":U
     1915                       , input 0
     1916                       , output v-fmtcli-full-addres
     1917                   ).
     1918                   assign
     1919                       v-fmtcli-addres = buf_person.address
     1920                   .
     1921                   run fmtcli-concatenate-strings in this-procedure (
     1922                         input v-fmtcli-full-addres
     1923                       , input v-fmtcli-addres
     1924                       , input ", ":U
     1925                       , input 0
     1926                       , output v-fmtcli-full-addres
     1927                   ).
     1928                   assign
     1929                       v-fmtcli-phone     = buf_person.phone1
     1930                       v-fmtcli-inn       = buf_person.inn
     1931                       v-fmtcli-kpp       = buf_person.kpp
     1932                       v-fmtcli-okpo      = buf_person.okpo
     1933                       v-fmtcli-city      = buf_person.city
     1934                       v-fmtcli-index     = string( buf_person.ind )
     1935                   .
     1936               end.
     1937          end.
     1938       end case.
     1939   end.
     1940   end procedure.
     1941   procedure fmtcli-concatenate-strings :
     1942   define input parameter p-string-1       as character        no-undo.
     1943   define input parameter p-string-2       as character        no-undo.
     1944   define input parameter p-delimiter      as character        no-undo.
     1945   define input parameter p-length         as integer          no-undo.
     1946   define output parameter p-out-string    as character        no-undo.
     1947   do
     1948   on error undo, return error
     1949   :
     1950       assign
     1951           p-out-string = ( if p-string-1 = ?
     1952                            then "":U
     1953                            else trim( p-string-1 ) )
     1954       .
     1955       assign
     1956           p-out-string = p-out-string
     1957                        + ( if p-out-string = "":U
     1958                            or length( p-out-string ) = p-length
     1959                            or p-string-2 = ?
     1960                            or trim( p-string-2 ) = "":U
     1961                            then "":U
     1962                            else p-delimiter )
     1963                        + ( if p-string-2 = ?
     1964                            or trim( p-string-2 ) = "":U
     1965                            then "":U
     1966                            else trim( p-string-2 ) )
     1967       .
     1968   end.
     1969   end procedure.
