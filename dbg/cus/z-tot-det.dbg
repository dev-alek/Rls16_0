      590   procedure cur-time :
      591      define output parameter p-today as date      no-undo .
      592      define output parameter p-time  as integer   no-undo .
      593     do
      594     on error undo, return error
      595     :
      596       define variable v-date1 as date      no-undo .
      597       define variable v-date2 as date      no-undo .
      598       define variable v-time  as integer   no-undo .
      599       assign
      600         v-date1 = today
      601         v-time  = time
      602         v-date2 = today
      603       .
      604       if v-date1 <> v-date2
      605       then do:
      606         assign
      607           v-date1 = today
      608           v-time  = v-time
      609         .
      610       end.
      611       assign
      612         p-today = v-date1
      613         p-time  = v-time
      614       .
      615     end.
      616   end.
      617   function cur-time-date returns character
      618   :
      619     return string(today, '99/99/9999':U) .
      620   end.
      621   function cur-time-mjd returns decimal
      622   :
      623     define variable v-date as date      no-undo .
      624     define variable v-time as integer   no-undo .
      625     run cur-time in this-procedure
      626       (output v-date
      627       ,output v-time
      628       ) .
      629     return integer(v-date) - 2400002 + (v-time / 86400) .
      630   end.
      631   function cur-time-get-ending-index returns integer
      632   (input p-number as integer
      633   )
      634   :
      635     if p-number < 0
      636     or p-number = ?
      637     then do:
      638       return 1 .
      639     end.
      640     define variable v-rest as integer   no-undo .
      641     assign
      642       p-number = p-number modulo 100
      643     .
      644     if p-number < 20
      645     then do:
      646       assign
      647         v-rest = p-number
      648       .
      649     end.
      650     else do:
      651       assign
      652         v-rest = p-number modulo 10
      653       .
      654     end.
      655     case v-rest :
      656       when 1
      657       then do:
      658         return 2 .
      659       end.
      660       when 2 or
      661       when 3 or
      662       when 4
      663       then do:
      664         return 3 .
      665       end.
      666       otherwise do:
      667         return 1 .
      668       end.
      669     end case .
      670   end.
      671   procedure cur-time-mjd-to-date :
      672      define input  parameter i-mjd-diff as decimal no-undo.
      673      define output parameter o-Date     as date    no-undo.
      674      define output parameter o-Time     as integer no-undo.
      675      define variable v-day-number as integer   no-undo .
      676      if    i-mjd-diff < 0
      677         or i-mjd-diff = ?
      678      then do:
      679         return "?" .
      680      end.
      681      assign
      682         v-day-number = truncate(i-mjd-diff,0).
      683         o-Date = date(v-day-number + 2400002).
      684         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      685     .
      686   end.
      687   function cur-time-mjd-to-string returns character
      688   (input p-mjd-diff as decimal
      689   )
      690   :
      691     define variable v-day-number as integer   no-undo .
      692     define variable v-seconds    as integer   no-undo .
      693     define variable v-hour       as integer   no-undo .
      694     define variable v-min        as integer   no-undo .
      695     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      696     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      697     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      698     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      699     if p-mjd-diff < 0
      700     or p-mjd-diff = ?
      701     then do:
      702       return "?" .
      703     end.
      704     assign
      705       v-day-number = integer(truncate(p-mjd-diff,0))
      706       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      707     .
      708     if v-seconds > 86400
      709     then do:
      710       assign
      711         v-seconds = 86400 - 1
      712       .
      713     end.
      714     if v-seconds < 0
      715     then do:
      716       assign
      717         v-seconds = 0
      718       .
      719     end.
      720     assign
      721       v-hour = truncate(v-seconds / 3600, 0)
      722     .
      723     assign
      724       v-seconds = v-seconds modulo 3600
      725     .
      726     assign
      727       v-min = truncate(v-seconds / 60, 0)
      728     .
      729     assign
      730       v-seconds = v-seconds modulo 60
      731     .
      732     return
      733         (if v-day-number <> 0
      734           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      735           else ""
      736         )
      737       + (if v-day-number <> 0 or v-hour <> 0
      738           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      739           else ""
      740         )
      741       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      742           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      743           else ""
      744         )
      745       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      746       .
      747   end.
      748   function cur-time-string returns character
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      757   end.
      758   function cur-time-string-sec returns character
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      767   end.
      768   function cur-time-custom  returns character
      769   (input p-prefix as character
      770   ,input p-date-format as character
      771   ,input p-delimiter as character
      772   ,input p-time-format as character
      773   ,input p-suffix as character
      774   )
      775   :
      776     define variable v-date as date      no-undo .
      777     define variable v-time as integer   no-undo .
      778     run cur-time in this-procedure
      779       (output v-date
      780       ,output v-time
      781       ) .
      782     return
      783       p-prefix
      784       + string(v-date, p-date-format)
      785       + p-delimiter
      786       + string(v-time, p-time-format)
      787       + p-suffix
      788       .
      789   end.
      790   function cur-time-print  returns character
      791   :
      792     define variable v-date as date      no-undo .
      793     define variable v-time as integer   no-undo .
      794     run cur-time in this-procedure
      795       (output v-date
      796       ,output v-time
      797       ) .
      798     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      799   end.
      800   function cur-time-datetime returns datetime
      801   :
      802     define variable v-char as character no-undo .
      803     define variable v-datetime as datetime no-undo .
      804     v-char = cur-time-string().
      805     v-datetime = datetime(v-char).
      806     return  v-datetime.
      807   end.
      808   function cur-time-string-msec returns character
      809   :
      810     define variable v-date as datetime  no-undo .
      811     v-date = now.
      812     return string(v-date) .
      813   end.
      814   define variable v-account as integer init 0 no-undo .
      815   define variable v-account-lavel as character no-undo .
      816   define variable v-button-stop as logical no-undo .
      817   define variable v-kol-spice as integer no-undo .
      818   define variable v-kol-spice2 as integer no-undo .
      819   define variable v-kol-spice3 as integer no-undo .
      820   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      821   DEFINE BUTTON StopBtn AUTO-END-KEY
      822        LABEL "Стоп"
      823        SIZE 10 BY 1.
      824   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      825        LABEL "Обработано записей"
      826         VIEW-AS TEXT
      827        SIZE 14 BY .67 NO-UNDO.
      828   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      829         VIEW-AS TEXT
      830        SIZE 53.25 BY .67
      831        FGCOLOR 1  NO-UNDO.
      832   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      833         VIEW-AS TEXT
      834        SIZE 53.25 BY .67
      835        FGCOLOR 1  NO-UNDO.
      836   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      837         VIEW-AS TEXT
      838        SIZE 53.25 BY .67
      839        FGCOLOR 1  NO-UNDO.
      840   DEFINE RECTANGLE RECT-1
      841        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      842        SIZE 55.13 BY 4.46.
      843   DEFINE FRAME InfoFrame
      844        StopBtn AT ROW 4.25 COL 21.75
      845        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      846        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      847        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      848        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      849        RECT-1 AT ROW 1 COL 1
      850       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      851            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      852            TITLE "Процесс"
      853            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      854   define variable mFrameView      as logical   no-undo init yes.
      855     define variable mFramHandle as handle no-undo.
      856     mFramHandle = frame InfoFrame:handle.
      857     if  log-manager:logfile-name ne ?
      858     then DO:
      859         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      860         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      861         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      862     end.
      863     mFrameView = not session:batch-mode and mFramHandle:visible.
      864     if mFrameView
      865     then do:
      866       ASSIGN
      867          FRAME InfoFrame:HIDDEN                           = TRUE
      868          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      869     end.
      870   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      871   DO:
      872     IF not StopProcessing THEN
      873       Message "Вы действительно хотите прервать" SKIP
      874               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      875                 UPDATE StopProcessing.
      876     IF StopProcessing THEN do:
      877        if mFrameView
      878        then do:
      879           HIDE FRAME InfoFrame.
      880        end.
      881     End.
      882   END.
      883   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      884     if num-entries(string(p-dec), '.') = 2
      885       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      886       else return( string(p-dec)) .
      887   end function.
      888   function format-point-to-comma returns char (input orig as char ) .
      889   define variable rtext as character no-undo .
      890   define variable strt as integer no-undo .
      891   define variable leng as integer no-undo .
      892   assign rtext = orig .
      893   repeat:
      894     strt =  index(rtext,'.').
      895     if strt = 0 then leave.
      896     leng = 1.
      897     substring(rtext,strt,leng,"character") = v-delim .
      898   end.
      899   return rtext.
      900   end function.
      901   function format-excel-text returns char ( input start-text as char ) :
      902   def var  i    as int no-undo.
      903   def var  ch   as char no-undo.
      904   def var  n    as int no-undo.
      905   def var  ipos as int no-undo.
      906     n = num-entries(trim(start-text), chr(10)) - 1 .
      907     do i = 1 to n :
      908       ipos = index( start-text, chr(10)).
      909       if ipos > 0 then
      910         substr( start-text, ipos, 1 ) = ' '.
      911     end.
      912     n = num-entries(trim(start-text), chr(13)) - 1 .
      913     do i = 1 to n :
      914       ipos = index( start-text, chr(13)).
      915       if ipos > 0 then
      916         substr( start-text, ipos, 1 ) = ' '.
      917     end.
      918     if index( start-text, '"' ) = 0 then
      919       start-text =  '="'   + trim( start-text) + '"'   .
      920       else do:
      921         n = num-entries(trim(start-text), '"') - 1.
      922         do i = 1 to n :
      923           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      924         end.
      925         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      926         start-text = '="'  + ch  + '"' .
      927       end.
      928     return start-text.
      929   end.
      930   function excel-sum returns char (input p-dec as decimal ).
      931     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      932   end function.
      933   function excel-qnty returns char (input p-dec as decimal ).
      934     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      935   end function.
      936   function format-excel-text-macr returns char ( input start-text as char ) :
      937   def var  i    as int no-undo.
      938   def var  ch   as char no-undo.
      939   def var  n    as int no-undo.
      940   def var  ipos as int no-undo.
      941     n = num-entries(trim(start-text), chr(10)) - 1 .
      942     do i = 1 to n :
      943       ipos = index( start-text, chr(10)).
      944       if ipos > 0 then
      945         substring( start-text, ipos , 1 ) = ' '.
      946     end.
      947     n = num-entries(trim(start-text), chr(13)) - 1 .
      948     do i = 1 to n :
      949       ipos = index( start-text, chr(13)).
      950       if ipos > 0 then
      951         substring( start-text, ipos, 1 ) = ' '.
      952     end.
      953     if index( start-text, '"' ) = 0 then
      954       start-text =  '"'   + trim( start-text) + '"'   .
      955       else do:
      956         n = num-entries(trim(start-text), '"') - 1.
      957         do i = 1 to n :
      958           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      959         end.
      960         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      961         start-text = '"'  + ch  + '"' .
      962       end.
      963     n = num-entries(trim(start-text), chr(10)) - 1 .
      964     do i = 1 to n :
      965       ipos = index( start-text, chr(10)).
      966       if ipos > 0 then
      967         substring( start-text, ipos , 1 ) = ' '.
      968     end.
      969       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      970     return start-text.
      971   end.
      972   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      974   procedure paramls-clear :
      975     define buffer buf_temp-param for temp-param .
      976     do
      977     on error undo, return error return-value
      978     :
      979       for each buf_temp-param
      980       on error undo, return error
      981       :
      982         delete buf_temp-param .
      983       end.
      984     end.
      985   end procedure.
      986   procedure paramls-write :
      987     define input  parameter p-code     as character no-undo .
      988     define input  parameter p-sub-code as character no-undo .
      989     define input  parameter p-value    as character no-undo .
      990     define buffer buf_temp-param for temp-param .
      991     do
      992     on error undo, return error return-value
      993     :
      994       find first buf_temp-param
      995         where buf_temp-param.param-code     = p-code
      996           and buf_temp-param.param-sub-code = p-sub-code
      997         no-error .
      998       if not available buf_temp-param then do:
      999         create buf_temp-param .
     1000         assign
     1001           buf_temp-param.param-code     = p-code
     1002           buf_temp-param.param-sub-code = p-sub-code
     1003         .
     1004       end.
     1005       assign
     1006         buf_temp-param.param-value = p-value
     1007       .
     1008     end.
     1009   end procedure.
     1010   procedure paramls-read :
     1011     define input  parameter p-code          as character no-undo .
     1012     define input  parameter p-sub-code      as character no-undo .
     1013     define input  parameter p-default-value as character no-undo .
     1014     define output parameter p-value         as character no-undo .
     1015     define buffer buf_temp-param for temp-param .
     1016     do
     1017     on error undo, return error return-value
     1018     :
     1019       find first buf_temp-param
     1020         where buf_temp-param.param-code     = p-code
     1021           and buf_temp-param.param-sub-code = p-sub-code
     1022         no-error .
     1023       if available buf_temp-param then do:
     1024         assign
     1025           p-value = buf_temp-param.param-value
     1026         .
     1027       end.
     1028       else do:
     1029         assign
     1030           p-value = p-default-value
     1031         .
     1032       end.
     1033     end.
     1034   end procedure.
     1035   procedure paramls-append :
     1036     define input  parameter p-code     as character no-undo .
     1037     define input  parameter p-sub-code as character no-undo .
     1038     define input  parameter p-value    as character no-undo .
     1039     define buffer buf_temp-param for temp-param .
     1040     do
     1041     on error undo, return error return-value
     1042     :
     1043       find first buf_temp-param
     1044            where buf_temp-param.param-code     = p-code
     1045              and buf_temp-param.param-sub-code = p-sub-code
     1046         no-error .
     1047       if not available buf_temp-param then do:
     1048         create buf_temp-param .
     1049         assign
     1050           buf_temp-param.param-code     = p-code
     1051           buf_temp-param.param-sub-code = p-sub-code
     1052           buf_temp-param.param-value    = p-value
     1053         .
     1054       end.
     1055       else do:
     1056           assign
     1057               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1058           .
     1059       end.
     1060     end.
     1061   end procedure.
