        1   Define input parameter Rootgrp as integer no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Выбор Секции для отчета    ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE BUTTON b-help
      112        LABEL "Помо&щь":L
      113        size 10 by 1
      114        BGCOLOR 8 .
      115   DEFINE BUTTON b-quit AUTO-END-KEY
      116        LABEL "&Выход":L
      117        size 10 by 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON Btn_sell AUTO-GO
      120        LABEL "Выбор"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE QUERY BROWSE-2 FOR
      124         ub.gds-grp SCROLLING.
      125   DEFINE BROWSE BROWSE-2
      126     QUERY BROWSE-2 DISPLAY
      127         ub.gds-grp.node-name FORMAT "X(60)"
      128       WITH SEPARATORS SIZE 40.38 BY 12
      129            BGCOLOR 15 FGCOLOR 0 .
      130   DEFINE FRAME Dialog-Frame
      131        b-quit at row 1.17 col 2
      132        Btn_sell AT ROW 1.17 COL 13
      133        b-help at row 1.17 col 31.75
      134        BROWSE-2 AT ROW 2.71 COL 1.75
      135        SPACE(0.86) SKIP(0.24)
      136       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      137            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      138            TITLE "Выбор Секции"
      139            DEFAULT-BUTTON Btn_sell.
      140   ASSIGN
      141          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      142          FRAME Dialog-Frame:HIDDEN           = TRUE.
      143   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      144   DO:
      145     APPLY "END-ERROR":U TO SELF.
      146   END.
      147   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      148   DO:
      149     Return 'все':U.
      150   END.
      151   ON CHOOSE OF Btn_sell IN FRAME Dialog-Frame
      152   DO:
      153     Find current ub.gds-grp no-lock no-error.
      154     Return string(ub.gds-grp.node-code).
      155   END.
      156   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   on help of frame Dialog-Frame
      158   do:
      159     run gbl/app_help.p
      160       (input this-procedure :file-name
      161       ,input ''
      162       ,input ?
      163       ) no-error.
      164     if error-status :error then do:
      165       message
      166         "Ошибка при вызове помощи"
      167         error-status :get-message(1)
      168         view-as alert-box .
      169     end.
      170   end.
      171   run minbtn-set in this-procedure .
      172   on choose of b-help in frame Dialog-Frame
      173   do:
      174     apply "help":u to frame Dialog-Frame .
      175   end.
      176   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   procedure minbtn-set :
      178       do
      179           on error undo, return error return-value
      180           :
      181           define variable ii              as integer       no-undo .
      182           define variable fh              as widget-handle no-undo .
      183           define variable hh              as widget-handle no-undo .
      184           define variable v-h             as handle        extent 4 no-undo .
      185           define variable v-name-button   as character     no-undo .
      186           define variable v-help-old-x    as decimal       no-undo .
      187           define variable v-help-old-y    as decimal       no-undo .
      188           define variable v-help-old-size as decimal       no-undo .
      189           define variable v-frame-width   as decimal       no-undo .
      190           define variable jj              as integer       no-undo .
      191           do
      192               on error undo, return error
      193               :
      194               assign
      195                   v-frame-width = frame Dialog-Frame:width - 0.3
      196                   fh            = frame Dialog-Frame:first-child
      197                   hh            = fh:first-child
      198                   ii            = 1
      199                   .
      200               do while valid-handle(hh):
      201                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      202                   do:
      203                       case lc(hh:name) :
      204                           when "b-help" then
      205                               do:
      206                                   hh:load-image-up("cmp/b-help.bmp":u) .
      207                                   hh:load-image-down("cmp/b-help.bmp":u) .
      208                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      209                                   hh:TOOLTIP = "Помощь" .
      210                                   v-help-old-x = hh:column .
      211                                   v-help-old-y = hh:row    .
      212                                   v-help-old-size = hh:width .
      213                                   hh:width-chars = 2.5 .
      214                               end.
      215                           when "b-print" then
      216                               do:
      217                                   hh:load-image("cmp/b-print.bmp":u) .
      218                                   hh:TOOLTIP = "Печать" .
      219                                   v-h[ii] = hh:handle .
      220                                   ii = ii + 1 .
      221                                   hh:width-chars = 3 .
      222                               end.
      223                           when "b-history" or
      224                           when "b-hist" then
      225                               do:
      226                                   hh:load-image("cmp/b-hist.bmp":u) .
      227                                   hh:TOOLTIP = "История" .
      228                                   v-h[ii] = hh:handle .
      229                                   ii = ii + 1 .
      230                                   hh:width-chars = 3 .
      231                               end.
      232                           when "b-sch" then
      233                               do:
      234                                   hh:load-image("cmp/b-sch.bmp":u) .
      235                                   hh:TOOLTIP = "Установка Фильтра" .
      236                                   v-h[ii] = hh:handle .
      237                                   ii = ii + 1 .
      238                                   hh:width-chars = 3 .
      239                               end.
      240                           when "b-hist-user" then
      241                               do:
      242                                   hh:load-image("cmp/b-hist.bmp":u) .
      243                                   hh:TOOLTIP = "История пользователя" .
      244                                   ii = ii + 1 .
      245                               end.
      246                       end case.
      247                   end.
      248                   hh = hh:next-sibling.
      249               end.
      250               b-help:column = v-frame-width - b-help:width-chars.
      251               jj = 0.
      252               repeat ii = 4 to 1 by -1 :
      253                   if valid-handle (v-h[ii] ) then
      254                   do:
      255                       jj  = jj + 1 .
      256                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      257                       v-h[ii]:row    = v-help-old-y .
      258                   end.
      259               end.
      260           end.
      261       end.
      262   end procedure.
      263   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      264   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      265   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      266   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      267   define variable v-diasize-current-frame-width  as decimal   no-undo .
      268   define variable v-diasize-current-frame-height as decimal   no-undo .
      269   define variable v-diasize-change-size          as logical   no-undo .
      270   define variable v-diasize-resize-button        as handle    no-undo .
      271   define variable v-diasize-wndmax               as logical   no-undo .
      272   define variable v-diasize-wndstore             as logical   no-undo .
      273   define variable v-diasize-proc-name            as character no-undo .
      274   define variable v-diasize-browse-handle        as handle    no-undo .
      275   define variable v-diasize-browse-number        as integer   no-undo .
      276   define variable v-diasize-need-full-display    as logical   no-undo init false .
      277   define temp-table temp-diasize-handle no-undo
      278     field handle-value  as handle
      279     field save-position as decimal
      280     index xpk is primary unique handle-value
      281     .
      282   define temp-table temp-browse-handle no-undo
      283     field browse-type   as character
      284     field browse-number as integer
      285     field browse-handle as handle
      286     field original-size as decimal
      287     index xpk is primary unique browse-type browse-number
      288     index xie browse-type browse-handle
      289   .
      290   procedure diasize_change-height :
      291     define input  parameter p-change-value  as decimal   no-undo .
      292     define input  parameter p-move-resize   as logical   no-undo .
      293     define variable v-field-group-handle    as handle    no-undo .
      294     define variable v-object-handle         as handle    no-undo .
      295     define variable v-frame-height          as decimal   no-undo .
      296     define variable v-frame-virtual-height  as decimal   no-undo .
      297     define variable v-browse-height         as decimal   no-undo .
      298     define variable v-window-height         as decimal   no-undo .
      299     define variable v-window-virtual-height as decimal   no-undo .
      300     define variable v-change-sign           as integer   no-undo .
      301     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      302     define buffer buf_temp-browse-handle  for temp-browse-handle .
      303     if p-change-value > 0
      304     then do:
      305       if frame Dialog-Frame :height + p-change-value
      306           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      307       then do:
      308         assign
      309           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      310                           - (frame Dialog-Frame :height-chars)
      311         .
      312         if p-change-value <= 0
      313         then do:
      314           run diasize_position-resize-button in this-procedure .
      315           return .
      316         end.
      317       end.
      318     end.
      319     if p-change-value < 0
      320     then do:
      321       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      322       then do:
      323         assign
      324           p-change-value = v-diasize-orig-frame-height
      325                          - (frame Dialog-Frame :height-chars)
      326         .
      327         if p-change-value >= 0
      328         then do:
      329           run diasize_position-resize-button in this-procedure .
      330           return .
      331         end.
      332       end.
      333     end.
      334     if p-change-value >= 0
      335     then do:
      336       assign
      337         v-change-sign = 1
      338       .
      339     end.
      340     else do:
      341       assign
      342         v-change-sign = -1
      343       .
      344     end.
      345     assign
      346       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      347     .
      348     if p-change-value = 0
      349     then do:
      350       run diasize_position-resize-button in this-procedure .
      351       return .
      352     end.
      353     move_block:
      354     do
      355     on error undo move_block, retry move_block
      356     :
      357       if retry
      358       then do:
      359         do
      360         on error undo move_block, leave move_block
      361         :
      362           if p-change-value > 0
      363           then do:
      364             for each buf_temp-diasize-handle
      365             on error undo, next
      366             :
      367               assign
      368                 v-object-handle = buf_temp-diasize-handle.handle-value
      369               .
      370               if v-object-handle <> v-diasize-resize-button
      371               then do:
      372                 assign
      373                   v-object-handle :row = buf_temp-diasize-handle.save-position
      374                 .
      375               end.
      376             end.
      377             assign
      378               v-diasize-browse-handle :height = v-browse-height
      379             .
      380             for each buf_temp-browse-handle
      381               where buf_temp-browse-handle.browse-type = 'height':u
      382             on error undo, next
      383             :
      384               assign
      385                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      386               .
      387             end.
      388             assign
      389               frame Dialog-Frame :height = v-frame-height
      390             .
      391             if frame Dialog-Frame :scrollable = true
      392             then do:
      393               assign
      394                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      395               .
      396             end.
      397             run diasize_position-resize-button in this-procedure .
      398           end.
      399           else do:
      400             if frame Dialog-Frame :scrollable = true
      401             then do:
      402               assign
      403                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      404               .
      405             end.
      406             assign
      407               frame Dialog-Frame :height = v-frame-height
      408             .
      409             assign
      410               v-diasize-browse-handle :height = v-browse-height
      411             .
      412             for each buf_temp-browse-handle
      413               where buf_temp-browse-handle.browse-type = 'height':u
      414             on error undo, next
      415             :
      416               assign
      417                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      418               .
      419             end.
      420             for each buf_temp-diasize-handle
      421             on error undo, next
      422             :
      423               assign
      424                 v-object-handle = buf_temp-diasize-handle.handle-value
      425               .
      426               if v-object-handle <> v-diasize-resize-button
      427               then do:
      428                 assign
      429                   v-object-handle :row = buf_temp-diasize-handle.save-position
      430                 .
      431               end.
      432             end.
      433             run diasize_position-resize-button in this-procedure .
      434           end.
      435           assign
      436             v-diasize-change-size = false
      437           .
      438           leave move_block .
      439         end.
      440       end.
      441       assign
      442         v-diasize-need-full-display = true
      443       .
      444       if v-diasize-change-size = false
      445       then do:
      446         assign
      447           v-diasize-change-size = true
      448         .
      449       end.
      450       else do:
      451         return .
      452       end.
      453       assign
      454         v-frame-height = frame Dialog-Frame :height
      455         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      456         v-browse-height = v-diasize-browse-handle :height
      457       .
      458       for each buf_temp-browse-handle
      459         where buf_temp-browse-handle.browse-type = 'height':u
      460       :
      461         assign
      462           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      463         .
      464       end.
      465       for each buf_temp-diasize-handle
      466       :
      467         delete buf_temp-diasize-handle .
      468       end.
      469       assign
      470         v-field-group-handle = frame Dialog-Frame :first-child
      471       .
      472       do while valid-handle(v-field-group-handle)
      473       :
      474         assign
      475           v-object-handle = v-field-group-handle :first-child
      476         .
      477         do while valid-handle(v-object-handle)
      478         :
      479           if  v-object-handle <> v-diasize-browse-handle :handle
      480           and can-query(v-object-handle, "row")
      481           and can-query(v-object-handle, "height")
      482           and ( v-object-handle :row > v-diasize-browse-handle :row )
      483           then do:
      484             find first buf_temp-browse-handle
      485               where buf_temp-browse-handle.browse-type   = 'height':u
      486                 and buf_temp-browse-handle.browse-handle = v-object-handle
      487               no-error .
      488             if available buf_temp-browse-handle
      489             then do:
      490             end.
      491             else do:
      492               create buf_temp-diasize-handle .
      493               assign
      494                 buf_temp-diasize-handle.handle-value  = v-object-handle
      495                 buf_temp-diasize-handle.save-position = v-object-handle :row
      496               .
      497             end.
      498           end.
      499           assign
      500             v-object-handle = v-object-handle :next-sibling
      501           .
      502         end.
      503         assign
      504           v-field-group-handle = v-field-group-handle :next-sibling
      505         .
      506       end.
      507       do with frame Dialog-Frame
      508       :
      509         hide v-diasize-resize-button .
      510         assign
      511           v-diasize-resize-button :row    = 1
      512           v-diasize-resize-button :column = 1
      513         .
      514       end.
      515       if p-change-value > 0
      516       then do:
      517         if frame Dialog-Frame :scrollable = true
      518         then do:
      519           assign
      520             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      521             no-error .
      522           if error-status :error
      523           or error-status :get-message(1) <> ""
      524           then do:
      525             undo move_block, retry move_block .
      526           end.
      527         end.
      528         assign
      529           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      530           no-error .
      531         if error-status :error
      532         or error-status :get-message(1) <> ""
      533         then do:
      534           undo move_block, retry move_block .
      535         end.
      536         assign
      537           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      538           no-error .
      539         if error-status :error
      540         or error-status :get-message(1) <> ""
      541         then do:
      542           undo move_block, retry move_block .
      543         end.
      544         for each buf_temp-browse-handle
      545           where buf_temp-browse-handle.browse-type = 'height':u
      546         on error undo move_block, retry move_block
      547         :
      548           assign
      549             buf_temp-browse-handle.browse-handle :height
      550               = buf_temp-browse-handle.browse-handle :height + p-change-value
      551             no-error .
      552           if error-status :error
      553           or error-status :get-message(1) <> ""
      554           then do:
      555             undo move_block, retry move_block .
      556           end.
      557         end.
      558         for each buf_temp-diasize-handle
      559         on error undo move_block, retry move_block
      560         :
      561           assign
      562             v-object-handle = buf_temp-diasize-handle.handle-value
      563           .
      564           if v-object-handle <> v-diasize-resize-button
      565           then do:
      566             assign
      567               v-object-handle :row = v-object-handle :row + p-change-value
      568               no-error .
      569             if error-status :error
      570             or error-status :get-message(1) <> ""
      571             then do:
      572               undo move_block, retry move_block .
      573             end.
      574           end.
      575         end.
      576       end.
      577       else do:
      578         for each buf_temp-diasize-handle
      579         on error undo move_block, retry move_block
      580         :
      581           assign
      582             v-object-handle = buf_temp-diasize-handle.handle-value
      583           .
      584           if v-object-handle <> v-diasize-resize-button
      585           then do:
      586             assign
      587               v-object-handle :row = v-object-handle :row + p-change-value
      588               no-error .
      589             if error-status :error
      590             or error-status :get-message(1) <> ""
      591             then do:
      592               undo move_block, retry move_block .
      593             end.
      594           end.
      595         end.
      596         assign
      597           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      598           no-error .
      599         if error-status :error
      600         or error-status :get-message(1) <> ""
      601         then do:
      602           undo move_block, retry move_block .
      603         end.
      604         for each buf_temp-browse-handle
      605           where buf_temp-browse-handle.browse-type = 'height':u
      606         on error undo move_block, retry move_block
      607         :
      608           assign
      609             buf_temp-browse-handle.browse-handle :height
      610               = buf_temp-browse-handle.browse-handle :height + p-change-value
      611             no-error .
      612           if error-status :error
      613           or error-status :get-message(1) <> ""
      614           then do:
      615             undo move_block, retry move_block .
      616           end.
      617         end.
      618         assign
      619           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      620           no-error .
      621         if error-status :error
      622         or error-status :get-message(1) <> ""
      623         then do:
      624           undo move_block, retry move_block .
      625         end.
      626         if frame Dialog-Frame :scrollable = true
      627         then do:
      628           assign
      629             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      630             no-error .
      631           if error-status :error
      632           or error-status :get-message(1) <> ""
      633           then do:
      634             undo move_block, retry move_block .
      635           end.
      636         end.
      637       end.
      638       if p-move-resize = true
      639       then do:
      640         run diasize_position-resize-button in this-procedure .
      641       end.
      642       if v-diasize-wndstore = true
      643       then do:
      644         if connected("ub") = true
      645         then do:
      646           define variable v-cntxt-db-num        as integer   no-undo .
      647           define variable v-cntxt-userid        as character no-undo .
      648           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      649                                             , OUTPUT v-cntxt-userid
      650                                             ) .
      651           run gbl/wndsizew.p
      652             (input  v-cntxt-db-num
      653             ,input  v-cntxt-userid
      654             ,input  v-diasize-proc-name
      655             ,input  'height':u
      656             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      657             ) .
      658         end.
      659       end.
      660     end.
      661     assign
      662       v-diasize-change-size = false
      663     .
      664   end procedure.
      665   procedure diasize_set-height :
      666     define input  parameter p-new-height  as decimal   no-undo .
      667     define input  parameter p-move-resize as logical   no-undo .
      668     do
      669     on error undo, return error return-value
      670     :
      671       run diasize_change-height in this-procedure
      672         (input  (p-new-height - frame Dialog-Frame :height)
      673         ,input  p-move-resize
      674         ) .
      675     end.
      676   end procedure.
      677   procedure diasize_change-width :
      678     define input  parameter p-change-value as decimal   no-undo .
      679     define input  parameter p-move-resize  as logical   no-undo .
      680     define variable v-field-group-handle   as handle    no-undo .
      681     define variable v-object-handle        as handle    no-undo .
      682     define variable v-frame-width          as decimal   no-undo .
      683     define variable v-frame-virtual-width  as decimal   no-undo .
      684     define variable v-browse-width         as decimal   no-undo .
      685     define variable v-window-width         as decimal   no-undo .
      686     define variable v-window-virtual-width as decimal   no-undo .
      687     define variable v-change-sign          as integer   no-undo .
      688     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      689     define buffer buf_temp-browse-handle  for temp-browse-handle .
      690     if p-change-value > 0
      691     then do:
      692       if frame Dialog-Frame :width + p-change-value >
      693           session :width-chars
      694       then do:
      695         assign
      696           p-change-value = session :width-chars - frame Dialog-Frame :width
      697         .
      698         if p-change-value <= 0
      699         then do:
      700           run diasize_position-resize-button in this-procedure .
      701           return .
      702         end.
      703       end.
      704     end.
      705     if p-change-value < 0
      706     then do:
      707       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      708       then do:
      709         assign
      710           p-change-value = v-diasize-orig-frame-width
      711                          - frame Dialog-Frame :width
      712         .
      713         if p-change-value >= 0
      714         then do:
      715           run diasize_position-resize-button in this-procedure .
      716           return .
      717         end.
      718       end.
      719     end.
      720     if p-change-value >= 0
      721     then do:
      722       assign
      723         v-change-sign = 1
      724       .
      725     end.
      726     else do:
      727       assign
      728         v-change-sign = -1
      729       .
      730     end.
      731     assign
      732       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      733     .
      734     if p-change-value = 0
      735     then do:
      736       run diasize_position-resize-button in this-procedure .
      737       return .
      738     end.
      739     move_block:
      740     do
      741     on error undo move_block, leave move_block
      742     :
      743       if retry
      744       then do:
      745         do
      746         on error undo move_block, leave move_block
      747         :
      748           if p-change-value > 0
      749           then do:
      750             for each buf_temp-diasize-handle
      751             on error undo, next
      752             :
      753               assign
      754                 v-object-handle = buf_temp-diasize-handle.handle-value
      755               .
      756               if v-object-handle <> v-diasize-resize-button
      757               then do:
      758                 assign
      759                   v-object-handle :col = buf_temp-diasize-handle.save-position
      760                 .
      761               end.
      762             end.
      763             assign
      764               v-diasize-browse-handle :width = v-browse-width
      765             .
      766             for each buf_temp-browse-handle
      767               where buf_temp-browse-handle.browse-type = 'width':u
      768             on error undo, next
      769             :
      770               assign
      771                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      772               .
      773             end.
      774             assign
      775               frame Dialog-Frame :width = v-frame-width
      776             .
      777             if frame Dialog-Frame :scrollable = true
      778             then do:
      779               assign
      780                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      781               .
      782             end.
      783             run diasize_position-resize-button in this-procedure .
      784           end.
      785           else do:
      786             if frame Dialog-Frame :scrollable = true
      787             then do:
      788               assign
      789                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      790               .
      791             end.
      792             assign
      793               frame Dialog-Frame :width = v-frame-width
      794             .
      795             for each buf_temp-browse-handle
      796               where buf_temp-browse-handle.browse-type = 'width':u
      797             on error undo, next
      798             :
      799               assign
      800                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      801               .
      802             end.
      803             assign
      804               v-diasize-browse-handle :width = v-browse-width
      805             .
      806             for each buf_temp-diasize-handle
      807             on error undo, next
      808             :
      809               assign
      810                 v-object-handle = buf_temp-diasize-handle.handle-value
      811               .
      812               if v-object-handle <> v-diasize-resize-button
      813               then do:
      814                 assign
      815                   v-object-handle :col = buf_temp-diasize-handle.save-position
      816                 .
      817               end.
      818             end.
      819             run diasize_position-resize-button in this-procedure .
      820           end.
      821           assign
      822             v-diasize-change-size = false
      823           .
      824           leave move_block .
      825         end.
      826       end.
      827       assign
      828         v-diasize-need-full-display = true
      829       .
      830       if v-diasize-change-size = false
      831       then do:
      832         assign
      833           v-diasize-change-size = true
      834         .
      835       end.
      836       else do:
      837         return .
      838       end.
      839       assign
      840         v-frame-width = frame Dialog-Frame :width
      841         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      842         v-browse-width = v-diasize-browse-handle :width
      843       .
      844       for each buf_temp-browse-handle
      845         where buf_temp-browse-handle.browse-type = 'width':u
      846       :
      847         assign
      848           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      849         .
      850       end.
      851       for each buf_temp-diasize-handle
      852       :
      853         delete buf_temp-diasize-handle .
      854       end.
      855       assign
      856         v-field-group-handle = frame Dialog-Frame :first-child
      857       .
      858       do while valid-handle(v-field-group-handle)
      859       :
      860         assign
      861           v-object-handle = v-field-group-handle :first-child
      862         .
      863         do while valid-handle(v-object-handle)
      864         :
      865           if  v-object-handle <> v-diasize-browse-handle :handle
      866           and v-object-handle <> v-diasize-resize-button
      867           and can-query(v-object-handle, "row")
      868           and can-query(v-object-handle, "height")
      869           and ( v-object-handle :col + v-object-handle :width
      870                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      871               )
      872           then do:
      873             find first buf_temp-browse-handle
      874               where buf_temp-browse-handle.browse-type   = 'width':u
      875                 and buf_temp-browse-handle.browse-handle = v-object-handle
      876               no-error .
      877             if available buf_temp-browse-handle
      878             then do:
      879             end.
      880             else do:
      881               create buf_temp-diasize-handle .
      882               assign
      883                 buf_temp-diasize-handle.handle-value  = v-object-handle
      884                 buf_temp-diasize-handle.save-position = v-object-handle :col
      885               .
      886             end.
      887           end.
      888           assign
      889             v-object-handle = v-object-handle :next-sibling
      890           .
      891         end.
      892         assign
      893           v-field-group-handle = v-field-group-handle :next-sibling
      894         .
      895       end.
      896       do with frame Dialog-Frame
      897       :
      898         hide v-diasize-resize-button .
      899         v-diasize-resize-button :row = 1.
      900         v-diasize-resize-button :column = 1.
      901       end.
      902       if p-change-value > 0
      903       then do:
      904         if frame Dialog-Frame :scrollable = true
      905         then do:
      906           assign
      907             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      908             no-error .
      909           if error-status :error
      910           or error-status :get-message(1) <> ""
      911           then do:
      912             undo move_block, retry move_block.
      913           end.
      914         end.
      915         assign
      916           frame Dialog-Frame :width = v-frame-width + p-change-value
      917           no-error .
      918         if error-status :error
      919         or error-status :get-message(1) <> ""
      920         then do:
      921           undo move_block, retry move_block.
      922         end.
      923         assign
      924           v-diasize-browse-handle :width = v-browse-width + p-change-value
      925         no-error .
      926         if error-status :error
      927         or error-status :get-message(1) <> ""
      928         then do:
      929           undo move_block, retry move_block.
      930         end.
      931         for each buf_temp-browse-handle
      932           where buf_temp-browse-handle.browse-type = 'width':u
      933         on error undo move_block, retry move_block
      934         :
      935           assign
      936             buf_temp-browse-handle.browse-handle :width
      937               = buf_temp-browse-handle.browse-handle :width + p-change-value
      938             no-error .
      939           if error-status :error
      940           or error-status :get-message(1) <> ""
      941           then do:
      942             undo move_block, retry move_block .
      943           end.
      944         end.
      945         for each buf_temp-diasize-handle
      946         on error undo move_block, retry move_block
      947         :
      948           assign
      949             v-object-handle = buf_temp-diasize-handle.handle-value
      950           .
      951           if v-object-handle <> v-diasize-resize-button
      952           then do:
      953             assign
      954               v-object-handle :col = v-object-handle :col + p-change-value
      955               no-error .
      956             if error-status :error
      957             or error-status :get-message(1) <> ""
      958             then do:
      959               undo move_block, retry move_block .
      960             end.
      961           end.
      962         end.
      963       end.
      964       else do:
      965         for each buf_temp-diasize-handle
      966         on error undo move_block, retry move_block
      967         :
      968           assign
      969             v-object-handle = buf_temp-diasize-handle.handle-value
      970           .
      971           if v-object-handle <> v-diasize-resize-button
      972           then do:
      973             assign
      974               v-object-handle :col = v-object-handle :col + p-change-value
      975               no-error .
      976             if error-status :error
      977             or error-status :get-message(1) <> ""
      978             then do:
      979               undo move_block, retry move_block .
      980             end.
      981           end.
      982         end.
      983         for each buf_temp-browse-handle
      984           where buf_temp-browse-handle.browse-type = 'width':u
      985         on error undo move_block, retry move_block
      986         :
      987           assign
      988             buf_temp-browse-handle.browse-handle :width
      989               = buf_temp-browse-handle.browse-handle :width + p-change-value
      990             no-error .
      991           if error-status :error
      992           or error-status :get-message(1) <> ""
      993           then do:
      994             undo move_block, retry move_block .
      995           end.
      996         end.
      997         assign
      998           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
      999           no-error .
     1000         if error-status :error
     1001         or error-status :get-message(1) <> ""
     1002         then do:
     1003           undo move_block, retry move_block.
     1004         end.
     1005         assign
     1006           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1007         no-error .
     1008         if error-status :error
     1009         or error-status :get-message(1) <> ""
     1010         then do:
     1011           undo move_block, retry move_block.
     1012         end.
     1013         if frame Dialog-Frame :scrollable = true
     1014         then do:
     1015           assign
     1016             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1017           no-error .
     1018           if error-status :error
     1019           or error-status :get-message(1) <> ""
     1020           then do:
     1021             undo move_block, retry move_block.
     1022           end.
     1023         end.
     1024       end.
     1025       if p-move-resize
     1026       then do:
     1027         run diasize_position-resize-button in this-procedure .
     1028       end.
     1029       if v-diasize-wndstore = true
     1030       then do:
     1031         if connected("ub") = true
     1032         then do:
     1033           define variable v-cntxt-db-num        as integer   no-undo .
     1034           define variable v-cntxt-userid        as character no-undo .
     1035           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1036                                             , OUTPUT v-cntxt-userid
     1037                                             ) .
     1038           run gbl/wndsizew.p
     1039             (input  v-cntxt-db-num
     1040             ,input  v-cntxt-userid
     1041             ,input  v-diasize-proc-name
     1042             ,input  'width':u
     1043             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1044             ) .
     1045         end.
     1046       end.
     1047     end.
     1048     assign
     1049       v-diasize-change-size = false
     1050     .
     1051   end procedure.
     1052   procedure diasize_set-width :
     1053     define input  parameter p-new-width  as decimal   no-undo .
     1054     define input  parameter p-move-resize as logical   no-undo .
     1055     do
     1056     on error undo, return error return-value
     1057     :
     1058       run diasize_change-width in this-procedure
     1059         (input  (p-new-width - frame Dialog-Frame :width)
     1060         ,input  p-move-resize
     1061         ) .
     1062     end.
     1063   end procedure.
     1064   procedure diasize_position-resize-button :
     1065     do with frame Dialog-Frame
     1066     :
     1067       hide v-diasize-resize-button .
     1068       assign
     1069         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1070                     - 1
     1071                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1072         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1073                     - 1
     1074                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1075       .
     1076       view v-diasize-resize-button .
     1077     end.
     1078   end procedure.
     1079   on alt-right anywhere
     1080   do:
     1081     run diasize_change-width in this-procedure
     1082       (input 1
     1083       ,input true
     1084       ) .
     1085     return no-apply .
     1086   end.
     1087   on alt-left anywhere
     1088   do:
     1089     run diasize_change-width in this-procedure
     1090       (input -1
     1091       ,input true
     1092       ) .
     1093     return no-apply .
     1094   end.
     1095   on alt-down anywhere
     1096   do:
     1097     run diasize_change-height in this-procedure
     1098       (input 1
     1099       ,input true
     1100       ) .
     1101     return no-apply .
     1102   end.
     1103   on alt-up anywhere
     1104   do:
     1105     run diasize_change-height in this-procedure
     1106       (input -1
     1107       ,input true
     1108       ) .
     1109     return no-apply .
     1110   end.
     1111   on alt-enter of frame Dialog-Frame
     1112   do:
     1113     run diasize_maximize in this-procedure
     1114       (input  ?
     1115       ).
     1116     return no-apply .
     1117   end.
     1118   procedure diasize_end-move :
     1119     do
     1120     on error undo, return error return-value
     1121     :
     1122       define variable v-row-delta as decimal   no-undo .
     1123       define variable v-col-delta as decimal   no-undo .
     1124       define variable v-new-row as decimal   no-undo .
     1125       define variable v-new-col as decimal   no-undo .
     1126       assign
     1127         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1128         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1129       .
     1130       assign
     1131         v-row-delta = v-new-row - frame Dialog-Frame :height
     1132         v-col-delta = v-new-col - frame Dialog-Frame :width
     1133       .
     1134       run diasize_change-height in this-procedure
     1135         (input v-row-delta
     1136         ,input true
     1137         ) .
     1138       run diasize_change-width in this-procedure
     1139         (input v-col-delta
     1140         ,input true
     1141         ) .
     1142     end.
     1143   end procedure.
     1144   procedure diasize_maximize :
     1145     define input  parameter p-action as logical   no-undo .
     1146     do
     1147     on error undo, return error return-value
     1148     :
     1149       if p-action = ?
     1150       then do:
     1151         if v-diasize-need-maximize = true
     1152         then do:
     1153           assign
     1154             p-action = true
     1155           .
     1156         end.
     1157         else do:
     1158           assign
     1159             p-action = false
     1160           .
     1161         end.
     1162       end.
     1163       if p-action = true
     1164       then do:
     1165         run diasize_change-height in this-procedure
     1166           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1167               - frame Dialog-Frame :height-chars
     1168           ,input true
     1169           ) .
     1170         run diasize_change-width in this-procedure
     1171           (input session :width-chars
     1172               - frame Dialog-Frame :width-chars
     1173           ,input true
     1174           ) .
     1175         assign
     1176           v-diasize-need-maximize = false
     1177         .
     1178       end.
     1179       else do:
     1180         run diasize_change-width in this-procedure
     1181           (input v-diasize-orig-frame-width
     1182               - frame Dialog-Frame :width-chars
     1183           ,input true
     1184           ) .
     1185         run diasize_change-height in this-procedure
     1186           (input v-diasize-orig-frame-height
     1187               - frame Dialog-Frame :height-chars
     1188           ,input true
     1189           ) .
     1190         assign
     1191           v-diasize-need-maximize = true
     1192         .
     1193       end.
     1194     end.
     1195   end procedure.
     1196   procedure diasize_restore-orig-size :
     1197     do
     1198     on error undo, return error return-value
     1199     :
     1200       assign
     1201         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1202         v-diasize-current-frame-height = frame Dialog-Frame :height
     1203       .
     1204       run diasize_set-height in this-procedure
     1205         (input  v-diasize-orig-frame-height
     1206         ,input  true
     1207         ) .
     1208       run diasize_set-width in this-procedure
     1209         (input  v-diasize-orig-frame-width
     1210         ,input  true
     1211         ) .
     1212     end.
     1213   end procedure.
     1214   procedure diasize_restore-current-size :
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       run diasize_set-height in this-procedure
     1219         (input  v-diasize-current-frame-height
     1220         ,input  true
     1221         ) .
     1222       run diasize_set-width in this-procedure
     1223         (input  v-diasize-current-frame-width
     1224         ,input  true
     1225         ) .
     1226     end.
     1227   end procedure.
     1228   procedure diasize_set-browse-handle :
     1229     define input  parameter p-browse-handle as handle   no-undo .
     1230     define buffer buf_temp-browse-handle for temp-browse-handle .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       assign
     1235         v-diasize-browse-handle = p-browse-handle
     1236       .
     1237       for each buf_temp-browse-handle
     1238       on error undo, return error return-value
     1239       :
     1240         delete buf_temp-browse-handle .
     1241       end.
     1242     end.
     1243   end procedure.
     1244   procedure diasize_add_browse :
     1245     define input  parameter p-browse-type   as character no-undo .
     1246     define input  parameter p-browse-handle as handle    no-undo .
     1247     define buffer buf_temp-browse-handle for temp-browse-handle .
     1248     do
     1249     on error undo, return error return-value
     1250     :
     1251       assign
     1252         v-diasize-browse-number = v-diasize-browse-number + 1
     1253       .
     1254       create buf_temp-browse-handle .
     1255       assign
     1256         buf_temp-browse-handle.browse-type   = p-browse-type
     1257         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1258         buf_temp-browse-handle.browse-handle = p-browse-handle
     1259       .
     1260     end.
     1261   end procedure.
     1262   procedure diasize_init :
     1263     define variable v-default-value    as logical   no-undo .
     1264     define variable v-restore-saved    as logical   no-undo .
     1265     define variable v-resize-value-str as character no-undo .
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       do with frame Dialog-Frame
     1270       :
     1271         assign
     1272           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1273           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1274           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1275         .
     1276         create button v-diasize-resize-button
     1277         assign
     1278           parent        = frame Dialog-Frame :first-child
     1279           label         = "s"
     1280           height-pixels = 16
     1281           width-pixels  = 16
     1282           visible       = true
     1283           sensitive     = true
     1284           movable       = true
     1285           triggers:
     1286             on end-move persistent run diasize_end-move in this-procedure .
     1287           end triggers.
     1288         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1289         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1290         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1291         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1292         assign
     1293           v-diasize-wndmax = false
     1294         .
     1295         if connected("ub") = true
     1296         then do:
     1297           define variable v-cntxt-db-num        as integer   no-undo .
     1298           define variable v-cntxt-userid        as character no-undo .
     1299           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1300                                             , OUTPUT v-cntxt-userid
     1301                                             ) .
     1302           run gbl/wndpar_r.p
     1303             (input  v-cntxt-db-num
     1304             ,input  v-cntxt-userid
     1305             ,input  'wndmax':U
     1306             ,output v-diasize-wndmax
     1307             ,output v-default-value
     1308             ) .
     1309         end.
     1310         assign
     1311           v-diasize-wndstore = false
     1312         .
     1313         if connected("ub") = true
     1314         then do:
     1315           run gbl/wndpar_r.p
     1316             (input  v-cntxt-db-num
     1317             ,input  v-cntxt-userid
     1318             ,input  'wndstore':U
     1319             ,output v-diasize-wndstore
     1320             ,output v-default-value
     1321             ) .
     1322         end.
     1323         assign
     1324           v-diasize-proc-name = entry(1, program-name(2), '.')
     1325         .
     1326         if v-diasize-wndstore = true
     1327         then do:
     1328           assign
     1329             v-restore-saved = false
     1330           .
     1331           if connected("ub") = true
     1332           then do:
     1333             run gbl/wndsizer.p
     1334               (input  v-cntxt-db-num
     1335               ,input  v-cntxt-userid
     1336               ,input  v-diasize-proc-name
     1337               ,input  'height':u
     1338               ,output v-resize-value-str
     1339               ) .
     1340             if v-resize-value-str <> '':U
     1341             then do:
     1342               run diasize_change-height in this-procedure
     1343                 (input  integer(v-resize-value-str)
     1344                 ,input  true
     1345                 ) .
     1346               assign
     1347                 v-restore-saved = true
     1348               .
     1349             end.
     1350           end.
     1351           if connected("ub") = true
     1352           then do:
     1353             run gbl/wndsizer.p
     1354               (input  v-cntxt-db-num
     1355               ,input  v-cntxt-userid
     1356               ,input  v-diasize-proc-name
     1357               ,input  'width':u
     1358               ,output v-resize-value-str
     1359               ) .
     1360             if v-resize-value-str <> '':U
     1361             then do:
     1362               run diasize_change-width in this-procedure
     1363                 (input  integer(v-resize-value-str)
     1364                 ,input  true
     1365                 ) .
     1366               assign
     1367                 v-restore-saved = true
     1368               .
     1369             end.
     1370           end.
     1371           if v-restore-saved <> true
     1372           then do:
     1373             if v-diasize-wndmax = true
     1374             then do:
     1375               run diasize_maximize in this-procedure
     1376                 (input  true
     1377                 ) .
     1378             end.
     1379           end.
     1380         end.
     1381         else do:
     1382           if v-diasize-wndmax = true
     1383           then do:
     1384             run diasize_maximize in this-procedure
     1385               (input  true
     1386               ) .
     1387           end.
     1388         end.
     1389       end.
     1390     end.
     1391   end procedure.
     1392   procedure diasize_need-full-display :
     1393     define output parameter p-need-full-display as logical   no-undo .
     1394     do
     1395     on error undo, return error return-value
     1396     :
     1397       assign
     1398         p-need-full-display = v-diasize-need-full-display
     1399       .
     1400       assign
     1401         v-diasize-need-full-display = false
     1402       .
     1403     end.
     1404   end procedure.
     1405   procedure get-context :
     1406      define output parameter p-db-num as integer          no-undo.
     1407      define output parameter p-user-id as character        no-undo.
     1408      define variable v-login               as character    no-undo.
     1409      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1410      define buffer buf_user-login  for ub.user-login .
     1411      do
     1412      on error undo, return error
     1413      :
     1414            FIND FIRST buf_sys-ctrl no-lock.
     1415            ASSIGN
     1416               v-login = USERID("ub")
     1417               p-db-num = buf_sys-ctrl.db-num
     1418            .
     1419            FIND FIRST buf_user-login
     1420                 WHERE buf_user-login.db-num = p-db-num
     1421                   AND buf_user-login.user-login = v-login
     1422                 no-lock
     1423                 no-error
     1424                 .
     1425            IF AVAILABLE buf_user-login
     1426            THEN DO:
     1427               assign
     1428                  p-user-id = buf_user-login.user-id
     1429               .
     1430            END.
     1431      end.
     1432   end procedure.
     1433       run diasize_init in this-procedure .
     1434   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1435   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1436   MAIN-BLOCK:
     1437   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1438      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1439     run enable_UI in this-procedure .
     1440     WAIT-FOR GO OF FRAME Dialog-Frame.
     1441   END.
     1442   run disable_UI in this-procedure.
     1443   PROCEDURE disable_UI :
     1444     HIDE FRAME Dialog-Frame.
     1445   END PROCEDURE.
     1446   PROCEDURE enable_UI :
     1447     ENABLE b-quit Btn_sell b-help BROWSE-2
     1448         WITH FRAME Dialog-Frame.
     1449     VIEW FRAME Dialog-Frame.
     1450     OPEN QUERY BROWSE-2 FOR EACH ub.gds-grp       WHERE ub.gds-grp.upper-code = Rootgrp NO-LOCK.
     1451   END PROCEDURE.
