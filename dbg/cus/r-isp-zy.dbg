      608   procedure cmptime :
      609   do
      610   on error undo, return error
      611   :
      612   define output parameter p-difference as decimal      no-undo.
      613   define variable v-srv-time      as decimal           no-undo.
      614   define variable v-cli-time      as decimal           no-undo.
      615   assign
      616       session :time-source = "ub":U
      617       v-srv-time = integer(today) + ( time / 86400 )
      618   .
      619   assign
      620       session :time-source = "LOCAL":U
      621       v-cli-time = integer(today) + ( time / 86400 )
      622   .
      623   assign
      624       p-difference = ( v-srv-time - v-cli-time ) * 1440
      625   .
      626   end.
      627   end procedure.
      628   procedure cmptime-time-diff :
      629   do
      630   on error undo, return error
      631   :
      632   define input parameter p-date1          as date         no-undo.
      633   define input parameter p-time1          as integer      no-undo.
      634   define input parameter p-date2          as date         no-undo.
      635   define input parameter p-time2          as integer      no-undo.
      636   define output parameter p-difference    as decimal      no-undo.
      637       assign
      638           p-difference = ( integer( p-date2 ) - integer( p-date1 ) + ( ( p-time2 - p-time1 ) / 86400 ) ) * 1440
      639       .
      640   end.
      641   end procedure.
      642   procedure cmptime-string-to-hms :
      643   do
      644   on error undo, return error
      645   :
      646   define input parameter p-time-string as character    no-undo.
      647   define input parameter p-format      as character    no-undo.
      648   define output parameter p-hour as integer      no-undo.
      649   define output parameter p-min  as integer      no-undo.
      650   define output parameter p-sec  as integer      no-undo.
      651   if p-format <> "hh:mm" and p-format <> "hh:mm:ss"
      652   then do:
      653       message
      654         "cmptime.i: Ошибка преобразования строки даты"
      655         skip return-value
      656         skip trim(error-status :get-message(1))
      657              trim(error-status :get-message(2))
      658              trim(error-status :get-message(3))
      659              trim(error-status :get-message(4))
      660              trim(error-status :get-message(5))
      661       view-as alert-box error.
      662       undo, return error .
      663   end.
      664   assign
      665       p-hour      = integer ( entry( 1, p-time-string, ":" ) )
      666       p-min       = integer ( entry( 2, p-time-string, ":" ) )
      667       p-sec       = ( if p-format = "hh:mm:ss"
      668                       then integer ( entry( 3, p-time-string, ":" ) )
      669                       else 0
      670                     )
      671   .
      672   end.
      673   end procedure.
      674   procedure cmptime-hms-to-integer :
      675   do
      676   on error undo, return error
      677   :
      678   define input parameter p-hour   as integer      no-undo.
      679   define input parameter p-min    as integer      no-undo.
      680   define input parameter p-sec    as integer      no-undo.
      681   define output parameter p-time  as integer      no-undo.
      682       assign
      683           p-time = p-hour * 3600 + ( p-min * 60 ) + p-sec
      684       .
      685   end.
      686   end procedure.
      687   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      688   define  stream PrnLibStream.
      689   procedure prn-lib-prn-file :
      690     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      691     define input parameter p-DIsabledoptions as integer no-undo .
      692     define variable v-report-name as character no-undo .
      693     define variable v-user-action as character no-undo .
      694     define variable v-printed     as logical   no-undo .
      695     define variable v-exist       as logical   no-undo .
      696     do
      697       on error undo, return error
      698       :
      699       run prn-lib-get-report-name  in this-procedure (
      700         input parParentProc
      701         ,output v-report-name
      702         ).
      703   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      705     (input  v-report-name
      706     ,input  2
      707     ,output v-exist
      708     )  .
      709       if NOT v-exist then
      710       DO:
      711         Message
      712           "Нет заданий на печать ! "
      713           view-as alert-box .
      714         Return  .
      715       End.
      716       run gbl/prnfilen.w
      717         (input  ""
      718         ,input  p-DisabledOptions
      719         ,input  string(v-report-name )
      720         ,input  7
      721         ,output v-user-action
      722         ,output v-printed
      723         ) .
      724       if v-printed then
      725       do:
      726         return "YES" .
      727       end.
      728       else
      729       do:
      730         return "NO" .
      731       end.
      732     end.
      733   end procedure.
      734   procedure prn-lib-open-stream :
      735     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      736     define input parameter p-page-size    as integer no-undo .
      737     define input parameter p-is-stream    as logical no-undo .
      738     define input parameter p-append       as logical no-undo .
      739     define variable v-report-name as character no-undo .
      740     do
      741       on error undo, return error
      742       :
      743       run prn-lib-get-report-name  in this-procedure (
      744         input parParentProc
      745         ,output v-report-name
      746         ).
      747       if p-is-stream then
      748       do:
      749         if p-append then
      750         do:
      751           output stream PrnLibStream to value( v-report-name )
      752             page-size value(p-page-size) append .
      753         end.
      754         if not p-append then
      755         do:
      756           output stream PrnLibStream to value( v-report-name )
      757             page-size value(p-page-size) .
      758         end.
      759       end.
      760       if not p-is-stream then
      761       do:
      762         if p-append then
      763         do:
      764           output to value( v-report-name )
      765             page-size value(p-page-size) append .
      766         end.
      767         if not p-append then
      768         do:
      769           output to value( v-report-name )
      770             page-size value(p-page-size) .
      771         end.
      772       end.
      773     end.
      774   end procedure.
      775   procedure prn-lib-open-exp :
      776     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      777     define input parameter p-is-stream    as logical no-undo .
      778     define input parameter p-is-append    as logical no-undo .
      779     define output parameter p-ReportFileName as char init "report" no-undo.
      780     define output parameter p-process as logical no-undo .
      781     define variable glog as logical no-undo .
      782     do
      783       on error undo, return error
      784       :
      785       SYSTEM-DIALOG GET-FILE p-ReportFileName
      786         TITLE      "Укажите путь"
      787         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      788         ASK-OVERWRITE
      789         CREATE-TEST-FILE
      790         SAVE-AS
      791         USE-FILENAME
      792         DEFAULT-EXTENSION "txt"
      793         UPDATE glog
      794         .
      795       if not glog then  return.
      796       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      797       if p-is-stream then
      798       do:
      799         if p-is-append then
      800         do:
      801           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      802         end.
      803         else
      804         do:
      805           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      806         end.
      807       end.
      808       else
      809       do:
      810         if p-is-append then
      811         do:
      812           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      813         end.
      814         else
      815         do:
      816           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      817         end.
      818       end.
      819       p-process = yes.
      820     end.
      821   end procedure.
      822   procedure prn-lib-get-report-name :
      823     define input parameter parParentProc  as widget-handle no-undo.
      824     define output parameter p-report-name as character no-undo .
      825     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      826   end procedure.
      827   procedure prn-lib-reportviewer-report-name :
      828     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      829     define input parameter p-report-name-html as character no-undo .
      830     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      831   end procedure.
      832   procedure prn-lib-reportviewer :
      833     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      834     define input parameter p-report-name-html as character no-undo .
      835     define input parameter p-param        as character no-undo .
      836     define variable v-excel           as character no-undo init 'TRUE' .
      837     define variable v-value-character as character no-undo .
      838     define variable v-value-integer   as character no-undo .
      839     define variable v-value-date      as date      no-undo .
      840     define variable v-value-decimal   as decimal   no-undo .
      841     define variable rep-excel         as logical   no-undo .
      842     define variable excel-string      as character no-undo .
      843     define variable v-param-type      as character no-undo .
      844     define variable v-tth             as handle    no-undo .
      845     run adm/shattri.p (
      846       input "get":U
      847       ,input  ""
      848       ,input  0
      849       ,input  'report-glob':U
      850       ,input  'rep-excel':U
      851       ,output v-value-character
      852       ,output v-value-date
      853       ,output v-value-decimal
      854       ,output v-value-integer
      855       ,output rep-excel
      856       ,output v-param-type
      857       ,INPUT-OUTPUT table-handle v-tth
      858       )  .
      859     if rep-excel then v-excel = "TRUE" .
      860     else v-excel = "FALSE" .
      861     if p-param eq ""
      862     then
      863        p-param = "EXCEL:" + v-excel.
      864     else
      865        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      866     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      867   end procedure.
      868   do
      869   on error undo, return error
      870   :
      871     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      872     ASSIGN parParentProc =  my-handle .
      873     define variable g#report-num as integer   no-undo .
      874     run get-report-num  in parParentProc ( output g#report-num ).
      875     define buffer buf_ord-doc      for ub.ord-doc.
      876     define buffer buf_ord-line     for ub.ord-line.
      877     define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv.
      878     define buffer buf_ord-line-rcv for ub.ord-line-rcv.
      879     define buffer buf_goods        for ub.goods.
      880     define buffer buf_trn-doc      for ub.trn-doc.
      881     define buffer buf1_trn-doc      for ub.trn-doc.
      882     define buffer buf_doc-line     for ub.doc-line.
      883     define buffer buf_clients      for ub.clients.
      884     define temp-table Temp-i no-undo
      885       field i-num-doc    like ub.ord-doc-rcv.doc-code
      886       field i-num-rcv    like ub.ord-doc-rcv.rcv-code
      887       field i-val-nakl   as decimal
      888       field i-date-nakl  as date
      889       field i-time-nakl  as char
      890       index PI IS PRIMARY i-num-doc  i-num-rcv
      891     .
      892     define variable Counter as integer .
      893   define variable v-account as integer init 0 no-undo .
      894   define variable v-account-lavel as character no-undo .
      895   define variable v-button-stop as logical no-undo .
      896   define variable v-kol-spice as integer no-undo .
      897   define variable v-kol-spice2 as integer no-undo .
      898   define variable v-kol-spice3 as integer no-undo .
      899   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      900   DEFINE BUTTON StopBtn AUTO-END-KEY
      901        LABEL "Стоп"
      902        SIZE 10 BY 1.
      903   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      904        LABEL "Обработано записей"
      905         VIEW-AS TEXT
      906        SIZE 14 BY .67 NO-UNDO.
      907   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      908         VIEW-AS TEXT
      909        SIZE 53.25 BY .67
      910        FGCOLOR 1  NO-UNDO.
      911   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      912         VIEW-AS TEXT
      913        SIZE 53.25 BY .67
      914        FGCOLOR 1  NO-UNDO.
      915   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      916         VIEW-AS TEXT
      917        SIZE 53.25 BY .67
      918        FGCOLOR 1  NO-UNDO.
      919   DEFINE RECTANGLE RECT-1
      920        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      921        SIZE 55.13 BY 4.46.
      922   DEFINE FRAME InfoFrame
      923        StopBtn AT ROW 4.25 COL 21.75
      924        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      925        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      926        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      927        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      928        RECT-1 AT ROW 1 COL 1
      929       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      930            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      931            TITLE "Процесс"
      932            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      933   define variable mFrameView      as logical   no-undo init yes.
      934     define variable mFramHandle as handle no-undo.
      935     mFramHandle = frame InfoFrame:handle.
      936     if  log-manager:logfile-name ne ?
      937     then DO:
      938         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      939         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      940         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      941     end.
      942     mFrameView = not session:batch-mode and mFramHandle:visible.
      943     if mFrameView
      944     then do:
      945       ASSIGN
      946          FRAME InfoFrame:HIDDEN                           = TRUE
      947          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      948     end.
      949   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      950   DO:
      951     IF not StopProcessing THEN
      952       Message "Вы действительно хотите прервать" SKIP
      953               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      954                 UPDATE StopProcessing.
      955     IF StopProcessing THEN do:
      956        if mFrameView
      957        then do:
      958           HIDE FRAME InfoFrame.
      959        end.
      960     End.
      961   END.
      962   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      963     if  log-manager:logfile-name ne ?
      964     then DO:
      965         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      966     end.
      967     if not session:batch-mode then
      968     do:
      969       VIEW FRAME InfoFrame.
      970       mFrameView = true.
      971     end.
      972      v-button-stop = false .
      973         if mFrameView
      974         then do:
      975         if v-button-stop then view STOPBTN in frame InfoFrame.
      976                          else Hide STOPBTN in frame InfoFrame.
      977         end.
      978     define variable  Line as char no-undo.
      979     define variable  v-bar-code            as integer                  no-undo.
      980     define variable  v-goods-artic         as char                     no-undo.
      981     define variable  v-goods-name          as char                     no-undo.
      982     define variable  v-goods-unit          as char                     no-undo.
      983     define variable  v-val-post            as decimal                  no-undo.
      984     define variable  v-date-post           as date                     no-undo.
      985     define variable  v-time-post           as char                     no-undo.
      986     define variable  v-val-nakl            as decimal                  no-undo.
      987     define variable  v-date-nakl           as date                     no-undo.
      988     define variable  v-time-nakl           as char                     no-undo.
      989     define variable  sum-doc-val-post      as decimal  initial 0       no-undo.
      990     define variable  sum-doc-val-nakl      as decimal  initial 0       no-undo.
      991     define variable  sum-obj-val-post      as decimal  initial 0       no-undo.
      992     define variable  sum-obj-val-nakl      as decimal  initial 0       no-undo.
      993     define variable  sum-all-val-post      as decimal  initial 0       no-undo.
      994     define variable  sum-all-val-nakl      as decimal  initial 0       no-undo.
      995     define variable  v-fact-order-start     as decimal   no-undo .
      996     define variable  v-fact-order-end       as decimal   no-undo .
      997     define variable  StatOtkl as integer   no-undo .
      998     define variable  NumPost as integer   no-undo .
      999     define variable  PrnNum as logical   no-undo .
     1000     define variable  PrnObj as logical   no-undo .
     1001     define variable v-difference   as decimal      no-undo.
     1002   if session :set-wait-state( "compiler" ) then.
     1003     Line = fill("-", 200).
     1004       DEFINE frame f-doc
     1005           sym1  v-bar-code     column-label " Код!        "          format ">>>>>>>>>>>>>>>9"  space(0)
     1006           sym2  v-goods-artic  column-label " Артикул! "             format "X(16)"             space(0)
     1007           sym3  v-goods-name   column-label " Наименование товара! " format "X(40)"             space(0)
     1008           sym4  v-goods-unit   column-label "Ед.!изм"                format "X(3)"              space(0)
     1009           sym5  v-val-post     column-label "Кол-во по!заявке"       format ">,>>>,>>9.999"     space(0)
     1010           sym6  v-date-post    column-label " Дата!заявки"            format "99.99.9999"        space(0)
     1011           sym7  v-time-post    column-label " Время!заявки"           format "X(9)"              space(0)
     1012           sym8  v-val-nakl     column-label "Кол-во по!наклад."     format ">,>>>,>>9.999"     space(0)
     1013           sym9  v-date-nakl    column-label " Дата!наклад."          format "99.99.9999"        space(0)
     1014           sym10 v-time-nakl    column-label " Время!наклад."         format "X(9)"              space(0)
     1015           sym11
     1016       with width 235 down stream-io.
     1017       DEFINE frame f-doc1
     1018           sym1  v-bar-code     column-label " Код!        "          format ">>>>>>>>>>>>>>>9"  space(0)
     1019           sym2  v-goods-artic  column-label " Артикул! "             format "X(16)"             space(0)
     1020           sym3  v-goods-name   column-label " Наименование товара! " format "X(40)"             space(0)
     1021           sym4  v-goods-unit   column-label "Ед.!изм"                format "X(3)"              space(0)
     1022           sym5  v-val-post     column-label "Кол-во по!заявке"       format ">,>>>,>>9.999"     space(0)
     1023           sym6  v-date-post    column-label "Дата!заявки"            format "99.99.9999"        space(0)
     1024           sym7  v-time-post    column-label "Время!заявки"           format "X(9)"              space(0)
     1025           sym8  v-val-nakl     column-label "Кол-во по!поставке"     format ">,>>>,>>9.999"     space(0)
     1026           sym9 v-date-nakl     column-label "Дата!поставки"          format "99.99.9999"        space(0)
     1027           sym10 v-time-nakl    column-label "Время!поставки"         format "X(9)"              space(0)
     1028           sym11
     1029       with width 235 down stream-io.
     1030     run prn-lib-open-stream  in this-procedure (input parParentProc,input 43,input yes,input no).
     1031     FORM HEADER
     1032         Line format "X(160)" AT 1 SKIP
     1033         "Продолжение - на следующей странице" AT 30 SKIP
     1034         with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     1035     VIEW stream PrnLibStream FRAME BottomFrame .
     1036     if p-post-2 = 2 then do:
     1037       FORM HEADER
     1038           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(100)"
     1039           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 140 format "X(15)" SKIP
     1040           Line format "X(160)" AT 1
     1041       with FRAME f-doc .
     1042     end.
     1043     else do:
     1044       FORM HEADER
     1045           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(100)"
     1046           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 140 format "X(15)" SKIP
     1047           Line format "X(160)" AT 1
     1048       with FRAME f-doc1 .
     1049     end.
     1050     PUT stream PrnLibStream  SPACE(30) "Отчет по исполнению заявок за период с: "  x-date-start format "99/99/9999" "г. по: "  x-date-end format "99/99/9999" "г." SKIP .
     1051     PUT stream PrnLibStream  str2 format "X(100)" SKIP str3 format "X(100)" SKIP .
     1052     for each obj-list no-lock :
     1053       assign
     1054         PrnObj = no
     1055         sum-obj-val-post = 0
     1056         sum-obj-val-nakl = 0
     1057       .
     1058       for each buf_ord-doc no-lock
     1059         where buf_ord-doc.obj-type  = obj-list.obj-type
     1060           and buf_ord-doc.obj-code  = obj-list.obj-code
     1061           and buf_ord-doc.doc-type  = 'ОФ':U
     1062           and buf_ord-doc.doc-date >= x-date-start
     1063           and buf_ord-doc.doc-date <= x-date-end
     1064         :
     1065         if buf_ord-doc.status_  <> 'факт':U then next.
     1066         assign
     1067           PrnNum = no
     1068           sum-doc-val-post = 0
     1069           sum-doc-val-nakl = 0
     1070           v-date-post = buf_ord-doc.ship-date
     1071           v-time-post =  string(buf_ord-doc.ship-time, "HH:MM")
     1072         .
     1073         for each buf_ord-line no-lock
     1074            where buf_ord-line.doc-code  = buf_ord-doc.doc-code
     1075           :
     1076           assign Counter = Counter + 1.
     1077   IF ( Counter modulo v-account = 0 )  then DO:
     1078             if  log-manager:logfile-name ne ?
     1079             then DO:
     1080                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1081             end.
     1082              if mFrameView
     1083              then do:
     1084               DISPLAY
     1085                 Counter @ RecordsDone
     1086                 WITH FRAME InfoFrame.
     1087              end.
     1088   End.
     1089      if v-button-stop then  DO:
     1090            if mFrameView
     1091            then
     1092               PROCESS EVENTS.
     1093            IF StopProcessing THEN DO:
     1094            RETURN error.
     1095            End.
     1096      end.
     1097           if x-SelectGood <> 1 then do:
     1098             find first gds-list no-lock
     1099               where gds-list.artic     = buf_ord-line.artic
     1100                 and gds-list.prod-type = buf_ord-line.prod-type
     1101                 and gds-list.prod-code = buf_ord-line.prod-code
     1102                 no-error
     1103               .
     1104             if not available gds-list then next .
     1105           end.
     1106           assign
     1107             v-val-post  = buf_ord-line.cli-qnty
     1108             v-val-nakl  = 0
     1109           .
     1110           for each Temp-i:
     1111             delete Temp-i.
     1112           end.
     1113           for each buf_ord-doc-rcv no-lock
     1114             where buf_ord-doc-rcv.cons-code = buf_ord-doc.cons-code
     1115             :
     1116             if buf_ord-doc-rcv.obj-code <>  buf_ord-doc.obj-code or buf_ord-doc-rcv.obj-type <>  buf_ord-doc.obj-type  then next .
     1117             if p-post-2 = 2 then do:
     1118             for each ub.ord-chain no-lock where
     1119                      ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     1120                      ub.ord-chain.doc-type = 'rcv'                  and
     1121                      ub.ord-chain.rel-doc-type = 'trn'
     1122                      :
     1123               find first buf_trn-doc no-lock
     1124                 where buf_trn-doc.doc-code  = ub.ord-chain.rel-doc-code no-error
     1125               .
     1126               if not available buf_trn-doc then next .
     1127               if buf_ord-doc-rcv.doc-type = "in":U then do:
     1128                 find first buf1_trn-doc no-lock
     1129                   where buf1_trn-doc.out-code  = buf_trn-doc.doc-code no-error
     1130                 .
     1131                 if not available buf1_trn-doc then next .
     1132                 if  p-otkl = 3 or p-otkl = 4 then do:
     1133                   run cmptime-time-diff ( buf1_trn-doc.fact-date, buf_ord-doc-rcv.fact-ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1134                   if p-time >= ABSOLUTE( v-difference ) then next .
     1135                 end.
     1136                 find first buf_doc-line no-lock
     1137                   where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     1138                     and buf_doc-line.artic     = buf_ord-line.artic
     1139                     and buf_doc-line.prod-type = buf_ord-line.prod-type
     1140                     and buf_doc-line.prod-code = buf_ord-line.prod-code
     1141                     no-error
     1142                   .
     1143               end.
     1144               else do:
     1145                 if  p-otkl = 3 or p-otkl = 4 then do:
     1146                   run cmptime-time-diff ( buf_trn-doc.fact-date, buf_ord-doc-rcv.fact-ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1147                   if p-time >= ABSOLUTE( v-difference ) then next .
     1148                 end.
     1149                 find first buf_doc-line no-lock
     1150                   where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     1151                     and buf_doc-line.artic     = buf_ord-line.artic
     1152                     and buf_doc-line.prod-type = buf_ord-line.prod-type
     1153                     and buf_doc-line.prod-code = buf_ord-line.prod-code
     1154                     no-error
     1155                   .
     1156               end.
     1157               if available buf_doc-line then do:
     1158                 create Temp-i no-error .
     1159                 assign
     1160                   Temp-i.i-num-doc    = buf_ord-doc.doc-code
     1161                   Temp-i.i-num-rcv    = buf_ord-doc-rcv.rcv-code
     1162                   Temp-i.i-val-nakl   = buf_doc-line.fact-qnty
     1163                   Temp-i.i-date-nakl  = buf_trn-doc.fact-date
     1164                   Temp-i.i-time-nakl  = string(buf_ord-doc-rcv.fact-ship-time, "HH:MM")
     1165                 .
     1166               end.
     1167             end.
     1168             end.
     1169             else do:
     1170               if p-otkl = 3 or p-otkl = 4 then do:
     1171                 run cmptime-time-diff ( buf_ord-doc-rcv.ship-date, buf_ord-doc-rcv.ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1172                 if p-time >= ABSOLUTE( v-difference ) then next .
     1173               end.
     1174               find first buf_ord-line-rcv no-lock
     1175                 where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
     1176                   and buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
     1177                   and buf_ord-line-rcv.artic     = buf_ord-line.artic
     1178                   and buf_ord-line-rcv.prod-type = buf_ord-line.prod-type
     1179                   and buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     1180                   no-error
     1181                 .
     1182               if available buf_ord-line-rcv then do:
     1183                 create Temp-i no-error .
     1184                 assign
     1185                   Temp-i.i-num-doc    = buf_ord-doc-rcv.doc-code
     1186                   Temp-i.i-num-rcv    = buf_ord-doc-rcv.rcv-code
     1187                   Temp-i.i-val-nakl   = buf_ord-line-rcv.qnty
     1188                   Temp-i.i-date-nakl  = buf_ord-doc-rcv.ship-date
     1189                   Temp-i.i-time-nakl  = string(buf_ord-doc-rcv.ship-time, "HH:MM")
     1190                 .
     1191               end.
     1192             end.
     1193           end.
     1194           assign
     1195             NumPost = 0
     1196             StatOtkl = 0
     1197           .
     1198           if p-otkl = 1 or p-otkl = 3 or p-otkl = 4 then do:
     1199             assign
     1200               StatOtkl = 1
     1201             .
     1202           end.
     1203           for each Temp-i no-lock :
     1204             assign
     1205               NumPost = NumPost + 1
     1206             .
     1207             if p-otkl = 2 or p-otkl = 4 then do:
     1208               if ABSOLUTE((( v-val-post - Temp-i.i-val-nakl ) * 100 / v-val-post )) > p-proc then do:
     1209                 assign
     1210                   StatOtkl = 1
     1211                 .
     1212               end.
     1213             end.
     1214           end.
     1215           if StatOtkl = 0 then next .
     1216           find first buf_goods  no-lock
     1217             where buf_goods.artic     = buf_ord-line.artic
     1218               and buf_goods.prod-type = buf_ord-line.prod-type
     1219               and buf_goods.prod-code = buf_ord-line.prod-code
     1220             .
     1221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1222     (input  buf_goods.gds-code
     1223     ,input  ?
     1224     ,output v-bar-code
     1225     ) no-error .
     1226    .
     1227           if error-status:error then do:
     1228             message
     1229               vss-workfile + ". Не найден бар-код товара " + buf_goods.artic
     1230             view-as alert-box error.
     1231             undo, return error .
     1232           end.
     1233           if PrnObj = no then do:
     1234             assign
     1235               PrnObj = yes
     1236               v-goods-name = string( " Объект: " + obj-list.obj-name)
     1237             .
     1238             if p-post-2 = 2 then do:
     1239               display stream PrnLibStream sym1 v-goods-name sym11 with frame f-doc.
     1240               down stream PrnLibStream with frame f-doc .
     1241             end.
     1242             else do:
     1243               display stream PrnLibStream sym1 v-goods-name sym11 with frame f-doc1.
     1244               down stream PrnLibStream with frame f-doc1 .
     1245             end.
     1246           end.
     1247           if p-tg-zay = yes then do:
     1248             if PrnNum = no then do:
     1249               assign
     1250                 PrnNum = yes
     1251                 v-goods-name = string( " Заявка " + buf_ord-doc.doc-code )
     1252               .
     1253               if p-post-2 = 2 then do:
     1254                 display stream PrnLibStream sym1 v-goods-name sym11 with frame f-doc.
     1255                 down stream PrnLibStream with frame f-doc .
     1256               end.
     1257               else do:
     1258                 display stream PrnLibStream sym1 v-goods-name sym11 with frame f-doc1.
     1259                 down stream PrnLibStream with frame f-doc1.
     1260               end.
     1261             end.
     1262           end.
     1263           assign
     1264             v-goods-artic   = string(buf_goods.artic)
     1265             v-goods-name    = buf_goods.gds-name
     1266             v-goods-unit    = buf_goods.unit-base
     1267             sum-doc-val-post = sum-doc-val-post + v-val-post
     1268             sum-obj-val-post = sum-obj-val-post + v-val-post
     1269             sum-all-val-post = sum-all-val-post + v-val-post
     1270           .
     1271           find first Temp-i no-lock no-error .
     1272           if not available Temp-i then do:
     1273             if p-post-2 = 2 then do:
     1274               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8 sym9 sym10 sym11 with frame f-doc.
     1275               down stream PrnLibStream with frame f-doc .
     1276             end.
     1277             else do:
     1278               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8 sym9 sym10 sym11 with frame f-doc1.
     1279               down stream PrnLibStream with frame f-doc1 .
     1280             end.
     1281           end.
     1282           else do:
     1283             assign
     1284               v-val-nakl  = Temp-i.i-val-nakl
     1285               v-date-nakl = Temp-i.i-date-nakl
     1286               v-time-nakl = Temp-i.i-time-nakl
     1287               sum-doc-val-nakl = sum-doc-val-nakl + v-val-nakl
     1288               sum-obj-val-nakl = sum-obj-val-nakl + v-val-nakl
     1289               sum-all-val-nakl = sum-all-val-nakl + v-val-nakl
     1290             .
     1291             if p-post-2 = 2 then do:
     1292               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8  v-val-nakl sym9  v-date-nakl sym10 v-time-nakl sym11 with frame f-doc.
     1293               down stream PrnLibStream with frame f-doc .
     1294             end.
     1295             else do:
     1296               display stream PrnLibStream sym1  v-bar-code sym2  v-goods-artic sym3  v-goods-name sym4  v-goods-unit sym5  v-val-post sym6  v-date-post sym7  v-time-post sym8  v-val-nakl sym9  v-date-nakl sym10 v-time-nakl sym11 with frame f-doc1.
     1297               down stream PrnLibStream with frame f-doc1 .
     1298             end.
     1299             if NumPost > 1 then do:
     1300               assign
     1301                 StatOtkl = 0
     1302               .
     1303               for each Temp-i no-lock :
     1304                 if StatOtkl = 0 then do:
     1305                   assign
     1306                     StatOtkl = 1
     1307                   .
     1308                 end.
     1309                 else do:
     1310                   assign
     1311                     v-val-nakl  = Temp-i.i-val-nakl
     1312                     v-date-nakl = Temp-i.i-date-nakl
     1313                     v-time-nakl = Temp-i.i-time-nakl
     1314                     sum-doc-val-nakl = sum-doc-val-nakl + v-val-nakl
     1315                     sum-obj-val-nakl = sum-obj-val-nakl + v-val-nakl
     1316                     sum-all-val-nakl = sum-all-val-nakl + v-val-nakl
     1317                   .
     1318                   if p-post-2 = 2 then do:
     1319                     display stream PrnLibStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8  v-val-nakl sym9  v-date-nakl sym10 v-time-nakl sym11 with frame f-doc.
     1320                     down stream PrnLibStream with frame f-doc .
     1321                   end.
     1322                   else do:
     1323                     display stream PrnLibStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8  v-val-nakl sym9  v-date-nakl sym10 v-time-nakl sym11 with frame f-doc1.
     1324                     down stream PrnLibStream with frame f-doc1 .
     1325                   end.
     1326                 end.
     1327               end.
     1328               if p-post-2 = 2 then do:
     1329                 assign
     1330                   v-goods-name = "Всего по накладным:"
     1331                   v-val-nakl   = sum-doc-val-nakl
     1332                 .
     1333                 display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc.
     1334                 down stream PrnLibStream with frame f-doc .
     1335               end.
     1336               else do:
     1337                 assign
     1338                   v-goods-name = "Всего по поставкам:"
     1339                   v-val-nakl   = sum-doc-val-nakl
     1340                 .
     1341                 display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc1.
     1342                 down stream PrnLibStream with frame f-doc1 .
     1343               end.
     1344             end.
     1345           end.
     1346         end.
     1347         if p-tg-zay = yes then do:
     1348           if PrnNum = yes then do:
     1349             assign
     1350               v-goods-name = "Всего по заявке:"
     1351               v-val-post   = sum-doc-val-post
     1352               v-val-nakl   = sum-doc-val-nakl
     1353             .
     1354             if p-post-2 = 2 then do:
     1355               display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc.
     1356               down stream PrnLibStream with frame f-doc .
     1357             end.
     1358             else do:
     1359               display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc1.
     1360               down stream PrnLibStream with frame f-doc1 .
     1361             end.
     1362           end.
     1363         end.
     1364       end.
     1365       if PrnObj = yes then do:
     1366         assign
     1367           v-goods-name = "Всего по объекту:"
     1368           v-val-post   = sum-obj-val-post
     1369           v-val-nakl   = sum-obj-val-nakl
     1370         .
     1371         if p-post-2 = 2 then do:
     1372           display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc.
     1373           down stream PrnLibStream with frame f-doc .
     1374           display stream PrnLibStream sym1 sym11 with frame f-doc.
     1375           down stream PrnLibStream with frame f-doc .
     1376         end.
     1377         else do:
     1378           display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc1.
     1379           down stream PrnLibStream with frame f-doc1 .
     1380           display stream PrnLibStream sym1 sym11 with frame f-doc1.
     1381           down stream PrnLibStream with frame f-doc1 .
     1382         end.
     1383       end.
     1384     end.
     1385     assign
     1386       v-goods-name = "ИТОГО:"
     1387       v-val-post   = sum-all-val-post
     1388       v-val-nakl   = sum-all-val-nakl
     1389     .
     1390     if p-post-2 = 2 then do:
     1391       display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc.
     1392       down stream PrnLibStream with frame f-doc .
     1393     end.
     1394     else do:
     1395       display stream PrnLibStream sym1 sym2 sym3 v-goods-name sym4 sym5 v-val-post sym6 sym7 sym8 v-val-nakl sym9 sym10 sym11 with frame f-doc1.
     1396       down stream PrnLibStream with frame f-doc1 .
     1397     end.
     1398     PUT STREAM PrnLibStream Line format "X(160)".
     1399     HIDE stream PrnLibStream FRAME BottomFrame .
     1400     OUTPUT stream PrnLibStream CLOSE.
     1401   if mFrameView
     1402   then do:
     1403      HIDE FRAME InfoFrame.
     1404   end.
     1405   if session :set-wait-state( "" ) then.
     1406     run prn-lib-prn-file in this-procedure (input parParentProc,input 8).
     1407   END.
