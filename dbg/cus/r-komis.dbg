     4044     then (string(fill18) + (if 12 < last-col-num then CHR(9) else ""))
     4045     else ""
     4046     if use-column[13]
     4047     then (string(fill18) + (if 13 < last-col-num then CHR(9) else ""))
     4048     else ""
     4049     if use-column[14]
     4050     then (string(fill18) + (if 14 < last-col-num then CHR(9) else ""))
     4051     else ""
     4052     if use-column[15]
     4053     then (string(fill18) + (if 15 < last-col-num then CHR(9) else ""))
     4054     else ""
     4055     if use-column[16]
     4056     then (string(fill18) + (if 16 < last-col-num then CHR(9) else ""))
     4057     else ""
     4058         skip.
     4059     end.
     4060   end procedure.
