     1516           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1517       end.
     1518       assign
     1519         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1520     end.
     1521   end.
     1522   assign
     1523     varprice-base-cons = varprice-base-cons / varcons-qnty
     1524     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1525   if varprice-base-cons = ? then do:
     1526     assign
     1527       varprice-base-cons = 0.
     1528   end.
     1529   if varprice-rubl-cons = ? then do:
     1530     assign
     1531       varprice-rubl-cons = 0.
     1532   end.
     1533   assign
     1534     varsum-base-factovp     = 0
     1535     varslt-base-factovp     = 0
     1536     varvat-base-factovp     = 0
     1537     varvatcons-base-factovp = 0
     1538     vardsc-base-factovp     = 0
     1539     varsum-base-docovp      = 0
     1540     varslt-base-docovp      = 0
     1541     varvat-base-docovp      = 0
     1542     varvatcons-base-docovp  = 0
     1543     vardsc-base-docovp      = 0
     1544     varsum-rubl-factovp     = 0
     1545     varslt-rubl-factovp     = 0
     1546     varvat-rubl-factovp     = 0
     1547     varvatcons-rubl-factovp = 0
     1548     vardsc-rubl-factovp     = 0
     1549     varsum-rubl-docovp      = 0
     1550     varslt-rubl-docovp      = 0
     1551     varvat-rubl-docovp      = 0
     1552     varvatcons-rubl-docovp  = 0
     1553     vardsc-rubl-docovp      = 0.
     1554   assign
     1555     varis-one-gds-dtl = no.
     1556   find first out-vatp_gds-dtl where out-vatp_gds-dtl.doc-code  = t-doc.doc-code  and
     1557                                        out-vatp_gds-dtl.artic     = ub.doc-line.artic     and
     1558                                        out-vatp_gds-dtl.prod-type = ub.doc-line.prod-type and
     1559                                        out-vatp_gds-dtl.prod-code = ub.doc-line.prod-code no-lock no-error.
     1560   if available out-vatp_gds-dtl then do:
     1561     find first buf_out-vatp_gds-dtl where buf_out-vatp_gds-dtl.doc-code  =  t-doc.doc-code                and
     1562                                              buf_out-vatp_gds-dtl.artic     =  ub.doc-line.artic                   and
     1563                                              buf_out-vatp_gds-dtl.prod-type =  ub.doc-line.prod-type               and
     1564                                              buf_out-vatp_gds-dtl.prod-code =  ub.doc-line.prod-code               and
     1565                                              recid(buf_out-vatp_gds-dtl)    <> recid(out-vatp_gds-dtl) no-lock no-error.
     1566     if not available buf_out-vatp_gds-dtl then do:
     1567       assign
     1568         varis-one-gds-dtl = yes.
     1569     end.
     1570     if varoutvprb = "base":u then do:
     1571       assign
     1572         varcurprice-base = out-vatp_gds-dtl.cur-base
     1573         varcurprice-rubl = out-vatp_gds-dtl.cur-base * ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)).
     1574     end.
     1575     else do:
     1576       assign
     1577         varcurprice-base = out-vatp_gds-dtl.cur-base / ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base))
     1578         varcurprice-rubl = out-vatp_gds-dtl.cur-base.
     1579     end.
     1580     if varempty-scale    = yes or
     1581        varis-one-gds-dtl = yes   then do:
     1582       assign
     1583                   price-base-with-tax-sale    = (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)
     1584           slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     1585           vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     1586           discnt-base-sale            = out-vatp_gds-dtl.discnt-base
     1587                   price-rubl-with-tax-sale    = (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)
     1588           slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     1589           vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     1590           discnt-rubl-sale            = out-vatp_gds-dtl.discnt-rubl
     1591           .
     1592       if t-doc.doc-type = 'инв':U then do:
