     1647           slt-base-sale               = varslt-base-docovp / varfact-qnty
     1648           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     1649           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     1650           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     1651                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     1652           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
