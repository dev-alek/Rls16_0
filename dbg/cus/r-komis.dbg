     2113   DEFINE VARIABLE v-price-without-tax-cost  like ub.doc-line.price-rubl no-undo .
     2114   DEFINE VARIABLE v-sum-without-tax-cost    like ub.doc-line.price-rubl no-undo .
     2115   DEFINE VARIABLE v-sum-vat-cost            like ub.doc-line.price-rubl no-undo .
     2116   DEFINE VARIABLE v-sum-with-tax-cost       like ub.doc-line.price-rubl no-undo .
     2117   DEFINE VARIABLE v-price-without-tax-sale  like ub.doc-line.price-rubl no-undo .
     2118   DEFINE VARIABLE v-sum-without-tax-sale    like ub.doc-line.price-rubl no-undo .
     2119   DEFINE VARIABLE v-sum-vat-sale            like ub.doc-line.price-rubl no-undo .
     2120   DEFINE VARIABLE v-sum-without-slt-sale    like ub.doc-line.price-rubl no-undo .
     2121   DEFINE VARIABLE v-sum-slt-sale            like ub.doc-line.price-rubl no-undo .
     2122   DEFINE VARIABLE v-sum-with-slt-sale       like ub.doc-line.price-rubl no-undo .
     2123   DEFINE VARIABLE accum-qnty                    like ub.doc-line.doc-qnty   no-undo .
     2124   DEFINE VARIABLE accum-sum-without-tax-cost    like ub.doc-line.price-rubl no-undo .
     2125   DEFINE VARIABLE accum-sum-vat-cost            like ub.doc-line.price-rubl no-undo .
     2126   DEFINE VARIABLE accum-sum-with-tax-cost       like ub.doc-line.price-rubl no-undo .
     2127   DEFINE VARIABLE accum-sum-without-tax-sale    like ub.doc-line.price-rubl no-undo .
     2128   DEFINE VARIABLE accum-sum-vat-sale            like ub.doc-line.price-rubl no-undo .
     2129   DEFINE VARIABLE accum-sum-without-slt-sale    like ub.doc-line.price-rubl no-undo .
     2130   DEFINE VARIABLE accum-sum-slt-sale            like ub.doc-line.price-rubl no-undo .
     2131   DEFINE VARIABLE accum-sum-with-tax-sale       like ub.doc-line.price-rubl no-undo .
     2132   DEFINE VARIABLE v-choice                      as integer no-undo .
     2133   DEFINE VARIABLE v-gen-print                   as logical no-undo init yes.
     2134   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     2135        VIEW-AS EDITOR
     2136        SIZE 1 BY 4 NO-UNDO.
     2137   DEFINE FRAME top-frame
     2138   t-1       AT ROW 1 COL 1 no-label
     2139   HEADER
