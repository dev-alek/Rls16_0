      163   procedure create_obj-list :
      164      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      165      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      166      do
      167      on error undo, return error return-value
      168      :
      169         define buffer cli-obj for ub.clients .
      170         define variable p-var as integer no-undo .
      171         define buffer buf_obj-list for obj-list .
      172         find last buf_obj-list  use-index pi no-error .
      173         if available buf_obj-list
      174         then
      175            p-var = buf_obj-list.obj-id + 1.
      176         else
      177            p-var = 1.
      178         find first cli-obj where
      179                   cli-obj.obj-type = p-obj-type
      180               and cli-obj.obj-code = p-obj-code
      181         no-lock no-error.
      182         if available cli-obj
      183         then do:
      184            create buf_obj-list.
      185            assign
      186               buf_obj-list.obj-id   = p-var
      187               buf_obj-list.obj-code = cli-obj.obj-code
      188               buf_obj-list.obj-type = cli-obj.obj-type
      189               buf_obj-list.obj-name = cli-obj.obj-name
      190               buf_obj-list.db-num   = cli-obj.db-num
      191            .
      192         end.
      193      end.
      194   end.
