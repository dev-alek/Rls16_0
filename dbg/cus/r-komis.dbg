     1669       end.
     1670     end.
     1671   end.
     1672   assign
     1673     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1674     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1675     assign
     1676     price-rubl-without-tax-sale-b = price-rubl-with-tax-sale - vat-rubl-buyer - slt-rubl-sale - road-tax-rubl-sale
     1677     .
     1678     _parts:
     1679     FOR EACH ub.parts NO-LOCK WHERE
     1680             ub.parts.artic = ub.doc-line.artic
     1681         AND ub.parts.prod-type = ub.doc-line.prod-type
     1682         AND ub.parts.prod-code = ub.doc-line.prod-code
     1683         AND ub.parts.out-code = doc-num
     1684         AND ub.parts.obj-type = ub.doc-line.obj-type
     1685         AND ub.parts.obj-code = ub.doc-line.obj-code
     1686         :
     1687       find first buf_parts-attr no-lock where
     1688                  buf_parts-attr.in-code = ub.parts.in-code
     1689              AND buf_parts-attr.gds-code = v-gds-code
     1690              AND buf_parts-attr.part-code = ub.parts.part-code no-error .
     1691       if available buf_parts-attr then do:
     1692         if
     1693         NOT (buf_parts-attr.supp-type = cli_supp.obj-type
     1694         AND buf_parts-attr.supp-code = cli_supp.obj-code) then NEXT _parts.
     1695         if buf_parts-attr.purch-code <> ocons-pay
     1696         AND buf_parts-attr.purch-code <> ocons-pay-2
     1697         then next _parts.
     1698         assign
     1699         v-parts-VAt-pc = buf_parts-attr.vat-pc
     1700         v-parts-SLT-pc = buf_parts-attr.SLT-pc
     1701         v-in-code = buf_parts-attr.income-in-code
     1702         v-part-code  = buf_parts-attr.income-part-code
     1703         .
     1704       end.
     1705       else do:
     1706         if
     1707         NOT (ub.parts.supp-type = cli_supp.obj-type
     1708         AND ub.parts.supp-code = cli_supp.obj-code) then NEXT _parts.
     1709         if ub.parts.purch-code <> ocons-pay
     1710         AND ub.parts.purch-code <> ocons-pay-2
     1711         then next _parts.
     1712         assign
     1713         v-parts-VAt-pc = ub.parts.vat-pc
     1714         v-parts-SLT-pc = ub.parts.SLT-pc
     1715         v-in-code = ub.parts.in-code
     1716         v-part-code = ub.parts.part-code
     1717         .
     1718       end.
     1719   assign
     1720     price-rubl-with-tax-loc  = ub.parts.price-rubl
     1721     price-base-with-tax-loc  = ub.parts.price-base
     1722   .
     1723   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1725     (output varinvprb
     1726     )  .
     1727     if ub.parts.out-code = 'free-zone':U     or
     1728        ub.parts.out-code = 'out-zone':U   or
     1729        ub.parts.doc-type = 'акт':U then do:
     1730       assign
     1731         in-vatp-have-vat-slt  = yes.
     1732     end.
     1733     else do:
     1734       find first in-vatp_doc-attr  no-lock
     1735         where in-vatp_doc-attr .doc-code  = ub.parts.out-code
     1736           and in-vatp_doc-attr .attr-code = 'envd':U
     1737         no-error .
     1738       if not available in-vatp_doc-attr  then do:
     1739         assign
     1740           in-vatp-have-vat-slt  = yes.
     1741       end.
     1742       else do:
     1743            in-vatp-have-vat-slt  = no.
     1744       end.
     1745     end.
     1746     assign
     1747      price-cli-with-tax-loc  = ub.parts.price-cli
     1748      cli-base-rate           = ub.parts.cli-base-rate.
     1749     ASSIGN   road-tax-base-loc   = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
     1750              road-tax-rubl-loc   = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
     1751     ASSIGN  transport-base-loc  = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     1752             transport-rubl-loc  = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     1753             other-base-loc      = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     1754             other-rubl-loc      = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     1755             vat-pc-loc          = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     1756             slt-pc-loc          = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     1757             ASSIGN   slt-base-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-base-with-tax-loc  - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc  / (100 + slt-pc-loc ))                        vat-base-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-base-with-tax-loc  - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc  / (100 + slt-pc-loc )) * vat-pc-loc  / (100 + vat-pc-loc )).
     1758       ASSIGN   slt-rubl-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-rubl-with-tax-loc  - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc  / (100 + slt-pc-loc ))                        vat-rubl-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-rubl-with-tax-loc  - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc  / (100 + slt-pc-loc )) * vat-pc-loc  / (100 + vat-pc-loc )).
     1759     assign
     1760       exch-rate-cli-loc  = (ub.parts.price-rubl - transport-rubl-loc  - other-rubl-loc  - road-tax-rubl-loc  - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc  else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc  else 0)) / ub.parts.price-cli .
     1761     assign
     1762       slt-cli-loc         = slt-rubl-loc        / exch-rate-cli-loc
     1763       vat-cli-loc         = vat-rubl-loc        / exch-rate-cli-loc
     1764       road-tax-cli-loc    = road-tax-rubl-loc   / exch-rate-cli-loc
     1765       transport-cli-loc   = 0
     1766       other-cli-loc       = 0
     1767     .
     1768   ASSIGN
     1769             price-base-without-tax-loc  = price-base-with-tax-loc  - vat-base-loc  - slt-base-loc  - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1770       price-rubl-without-tax-loc  = price-rubl-with-tax-loc  - vat-rubl-loc  - slt-rubl-loc  - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1771   .
     1772       if T-parts
     1773       then do:
     1774          FIND FIRST sj-goods WHERE
     1775                   sj-goods.artic = ub.doc-line.artic
     1776               AND sj-goods.prod-type = ub.doc-line.prod-type
     1777               AND sj-goods.prod-code = ub.doc-line.prod-code
     1778               AND sj-goods.is-out_ = is-out
     1779               AND sj-goods.VAT-supp = v-parts-Vat-pc
     1780               AND sj-goods.price-with-tax-cost_ = price-rubl-with-tax-loc
     1781               AND sj-goods.price-without-tax-sale_ = price-rubl-without-tax-sale-b
     1782               AND sj-goods.part-code = v-part-code
     1783               AND sj-goods.in-code = v-in-code
     1784               No-error.
     1785       end.
     1786       else do:
     1787         FIND FIRST sj-goods WHERE
     1788                   sj-goods.artic = ub.doc-line.artic
     1789               AND sj-goods.prod-type = ub.doc-line.prod-type
     1790               AND sj-goods.prod-code = ub.doc-line.prod-code
     1791               AND sj-goods.is-out_ = is-out
     1792               AND sj-goods.VAT-supp = v-parts-Vat-pc
     1793               AND sj-goods.price-with-tax-cost_ = price-rubl-with-tax-loc
     1794               AND sj-goods.price-without-tax-sale_ = price-rubl-without-tax-sale-b
     1795               No-error.
     1796       END.
     1797       if not avail sj-goods
     1798       then do:
     1799         FIND FIRST ub.goods No-LOCK WHERE
     1800                   ub.goods.artic = ub.doc-line.artic
     1801               AND ub.goods.prod-type = ub.doc-line.prod-type
     1802               AND ub.goods.prod-code = ub.doc-line.prod-code No-ERROR.
     1803         create sj-goods.
     1804         assign
     1805         sj-goods.artic = ub.goods.artic
     1806         sj-goods.prod-type = ub.goods.prod-type
     1807         sj-goods.prod-code = ub.goods.prod-code
     1808         sj-goods.unit = ub.goods.unit-base
     1809         sj-goods.gds-name = REPLACE(ub.goods.gds-name, " ", "_")
     1810         sj-goods.VAT-supp = v-parts-VAT-pc
     1811         sj-goods.SLT-supp = v-parts-SLT-pc
     1812         sj-goods.in-code = if T-parts then v-in-code else ""
     1813         sj-goods.part-code = if T-parts then v-part-code else ""
     1814         sj-goods.is-out_ = is-out
     1815         sj-goods.price-with-tax-cost_ = price-rubl-with-tax-loc
     1816         .
     1817       END.
     1818       assign
     1819       prt-qnty =  is-out * ub.parts.fact-qnty
     1820       sj-goods.qnty = sj-goods.qnty +  prt-qnty
     1821       sj-goods.price-without-tax-cost_ = price-rubl-without-tax-loc
     1822       sj-goods.sum-without-tax-cost_  =  sj-goods.sum-without-tax-cost_ + price-rubl-without-tax-loc * prt-qnty
     1823       sj-goods.sum-vat-cost_ = sj-goods.sum-vat-cost_ + vat-rubl-loc * prt-qnty
     1824       sj-goods.sum-with-tax-cost_   =  sj-goods.sum-with-tax-cost_ + price-rubl-with-tax-loc * prt-qnty
     1825       sj-goods.sum-without-tax-sale_ = sj-goods.sum-without-tax-sale_ + price-rubl-without-tax-sale-b * prt-qnty
     1826       sj-goods.price-without-tax-sale_ = sj-goods.sum-without-tax-sale_ / sj-goods.qnty
     1827       sj-goods.sum-vat-sale_ = sj-goods.sum-vat-sale + vat-rubl-buyer * prt-qnty
     1828       sj-goods.sum-slt-sale_ = sj-goods.sum-slt-sale + slt-rubl-sale * prt-qnty
     1829       sj-goods.sum-with-tax-sale_ = sj-goods.sum-with-tax-sale_ + price-rubl-with-tax-sale * prt-qnty
     1830       .
     1831     END.
     1832   END.
     1833     end.
     1834   end procedure.
     1835   procedure filltable :
     1836   DEFINE VARiable v-host-code like ub.sysconf.host-code no-undo.
     1837   DEFINE VARIABLE loc#retail as logical no-undo.
     1838   DEFINE VARIABLE real-code like ub.clients.obj-code no-undo.
     1839   DEFINE VARIABLE real-type like ub.clients.obj-type no-undo.
     1840   DEFINE VARIABLE ocons-pay like ub.sysconf.purch-code no-undo.
     1841   DEFINE VARIABLE ocons-pay-2 like ub.sysconf.purch-code no-undo.
     1842   DEFINE VARIABLE is-out as integer no-undo .
     1843   DEFINE VARIABLE doc-num like ub.trn-doc.doc-code no-undo.
     1844   DEFINE VARIABLE offc as logical no-undo.
     1845   DEFINE VARIABLE prt-qnty as decimal no-undo .
     1846     do
     1847     on error undo, return error
     1848     :
     1849       run waitfram-show in this-procedure ( input "Ждите") .
     1850       FOR EACH sj-goods :
     1851           delete sj-goods .
     1852       END .
     1853       _obj-list:
     1854       FOR EACH obj-list NO-LOCK:
     1855   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1856   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1857     (input  obj-list.obj-type
     1858     ,input  obj-list.obj-code
     1859     ,output v-host-code
     1860     )  .
     1861         FIND FIRST ub.sysconf NO-LOCK WHERE ub.sysconf.host-code = v-host-code.
     1862         IF AVAIL ub.sysconf
     1863         then
     1864         assign
     1865         loc#retail = ub.sysconf.ord-prt
     1866         real-code = ub.sysconf.sale-code
     1867         real-type = ub.sysconf.sale-type
     1868         ocons-pay = integer('2':U)
     1869         ocons-pay-2 = integer('4':U)
     1870         .
     1871         else NEXT _obj-list.
     1872         CASE RS-by:
     1873           when 1 then do:
     1874           _inkas:
     1875             FOR EACH ub.inkas WHERE
     1876                     ub.inkas.doc-date >= X-date-start and
     1877                     ub.inkas.doc-date <= X-date-end AND
     1878                     ub.inkas.obj-code = obj-list.obj-code and
     1879                     ub.inkas.obj-type = obj-list.obj-type AND
     1880                     ub.inkas.status_ = 'факт':U NO-LOCK,
     1881                 each ub.sale-doc no-lock where
     1882                       ub.sale-doc.inkas-code = ub.inkas.inkas-code
     1883                   and ub.sale-doc.order > 0:
     1884               if ub.sale-doc.in-inkas then do:
     1885                 FIND FIRST t-doc No-LOCK WHERE
     1886                         t-doc.doc-code = ub.sale-doc.doc-code no-error.
     1887                 if available t-doc then do:
     1888                   assign
     1889                   doc-num = t-doc.doc-code
     1890                   is-out = ub.sale-doc.dir
     1891                   .
     1892                   if t-doc.office then NEXT _inkas.
     1893                   run cr-sj-goods in this-procedure (
     1894                                                     input doc-num
     1895                                                     ,input is-out
     1896                                                     ,input ocons-pay
     1897                                                     ,input ocons-pay-2
     1898                                                     ).
     1899                 end.
     1900               end.
     1901             END.
     1902           END.
     1903           when 2 then do:
     1904           _trn-doc:
     1905             FOR EACH t-doc NO-LOCK WHERE
     1906                     t-doc.obj-type = obj-list.obj-type AND
     1907                     t-doc.obj-code = obj-list.obj-code AND
     1908                     t-doc.cli-type = real-type AND
     1909                     t-doc.cli-code = real-code AND
     1910                     t-doc.status_ = 'факт':U AND
     1911                     t-doc.doc-date >= X-date-start AND
     1912                     t-doc.doc-date <= X-date-end AND
     1913                     t-doc.ext-doc-type = 'ee':U
     1914                     :
     1915               assign
     1916               doc-num = t-doc.doc-code
     1917               offc = t-doc.office
     1918               is-out = 1.
     1919               if offc then NEXT _trn-doc.
     1920               run cr-sj-goods in this-procedure (
     1921                                                   input doc-num
     1922                                                  ,input is-out
     1923                                                  ,input ocons-pay
     1924                                                  ,input ocons-pay-2
     1925                                                  ).
     1926             END.
     1927             _ret-doc:
     1928             FOR EACH t-doc NO-LOCK WHERE
     1929                     t-doc.obj-type = obj-list.obj-type AND
     1930                     t-doc.obj-code = obj-list.obj-code AND
     1931                     t-doc.cli-type = real-type AND
     1932                     t-doc.cli-code = real-code AND
     1933                     t-doc.status_ = 'факт':U AND
     1934                     t-doc.doc-date >= X-date-start AND
     1935                     t-doc.doc-date <= X-date-end AND
     1936                     t-doc.ext-doc-type = 're':U:
     1937               assign
     1938               doc-num = t-doc.doc-code
     1939               offc = t-doc.office
     1940               is-out = -1.
     1941               if offc then NEXT _ret-doc.
     1942               run cr-sj-goods in this-procedure (
     1943                                                   input doc-num
     1944                                                  ,input is-out
     1945                                                  ,input ocons-pay
     1946                                                  ,input ocons-pay-2
     1947                                                  ).
     1948             END.
     1949           END.
     1950           WHEN 3 or when 4 then do:
     1951             _3trn-doc:
     1952             FOR EACH t-doc NO-LOCK WHERE
     1953                     t-doc.obj-type = obj-list.obj-type AND
     1954                     t-doc.obj-code = obj-list.obj-code AND
     1955                     t-doc.status_ = 'факт':U AND
     1956                     t-doc.doc-date >= X-date-start AND
     1957                     t-doc.doc-date <= X-date-end AND
     1958                     (t-doc.ext-doc-type = 'ee':U
     1959                     or t-doc.ext-doc-type = 'es':U) :
     1960               assign
     1961               doc-num = t-doc.doc-code
     1962               offc = t-doc.office
     1963               is-out = 1.
     1964               if offc then NEXT _3trn-doc.
     1965               run cr-sj-goods in this-procedure (
     1966                                                   input doc-num
     1967                                                  ,input is-out
     1968                                                  ,input ocons-pay
     1969                                                  ,input ocons-pay-2
     1970                                                  ).
     1971               if Rs-by = 3 then do:
     1972                 if t-doc.ext-doc-type = 'es':U then NEXT _3trn-doc.
     1973               end.
     1974             END.
     1975             if Rs-by = 4 then do:
     1976               _3trn-doc-ret:
     1977               FOR EACH t-doc NO-LOCK WHERE
     1978                       t-doc.obj-type = obj-list.obj-type AND
     1979                       t-doc.obj-code = obj-list.obj-code AND
     1980                       t-doc.status_ = 'факт':U AND
     1981                       t-doc.doc-date >= X-date-start AND
     1982                       t-doc.doc-date <= X-date-end AND
     1983                       (t-doc.ext-doc-type = 're':U OR
     1984                       t-doc.ext-doc-type = 'rs':U):
     1985                 assign
     1986                 doc-num = t-doc.doc-code
     1987                 offc = t-doc.office
     1988                 is-out = - 1.
     1989                 if offc then NEXT _3trn-doc-ret.
     1990                 run cr-sj-goods in this-procedure (
     1991                                                     input doc-num
     1992                                                   ,input is-out
     1993                                                   ,input ocons-pay
     1994                                                   ,input ocons-pay-2
     1995                                                   ).
     1996               END.
     1997             end.
     1998             _spitrn-doc:
     1999             FOR EACH t-doc NO-LOCK WHERE
     2000                     t-doc.obj-type = obj-list.obj-type AND
     2001                     t-doc.obj-code = obj-list.obj-code AND
     2002                     t-doc.status_ = 'факт':U AND
     2003                     t-doc.doc-date >= X-date-start AND
     2004                     t-doc.doc-date <= X-date-end AND
     2005                     t-doc.internal = no AND
     2006                     (t-doc.ext-doc-type = 'wm':U
     2007                     OR (Rs-by = 4 and
     2008                         t-doc.ext-doc-type = 'we':U)
     2009                     )
     2010                     :
     2011               assign
     2012               doc-num = t-doc.doc-code
     2013               offc = t-doc.office
     2014               is-out = 1.
     2015               if offc then NEXT _spitrn-doc.
     2016               run cr-sj-goods in this-procedure (
     2017                                                   input doc-num
     2018                                                 ,input is-out
     2019                                                 ,input ocons-pay
     2020                                                 ,input ocons-pay-2
     2021                                                 ).
     2022             END.
     2023           end.
     2024         END CASE.
     2025       END.
     2026       run waitfram-hide in this-procedure .
     2027     end.
     2028   end procedure.
     2029   define variable l-col-type         as character no-undo .
     2030   define variable l-col-pos          as integer no-undo .
     2031   define variable l-col-len          as integer no-undo .
     2032   define variable l-col-format       as character no-undo .
     2033   define variable l-col-lable        as character no-undo .
     2034   define variable v-dec-sep          as character no-undo init ? .
     2035   define variable v-th-sep           as character no-undo init ? .
     2036   define variable v-r-col-num        as integer no-undo .
     2037   define variable v-reg-replace      as logical no-undo .
     2038   define variable v-date-col-format  as character no-undo .
     2039   DEFINE VARIABLE last-col-num as integer no-undo.
     2040   run gbl/getlocal.p (
     2041                     output v-dec-sep
     2042                    ,output v-th-sep
     2043                    ,output v-sdate
     2044                    ,output v-shortdate
     2045                    ) no-error .
     2046   assign
     2047   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     2048                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     2049   .
     2050     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     2051                                               INPUT p-dec-sep AS CHARACTER  ) :
     2052       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     2053       IF TRIM( p-string ) = "0"                    OR
     2054          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     2055          TRIM( p-string ) =       p-dec-sep + "00" OR
     2056          TRIM( p-string ) =       p-dec-sep + "0"  OR
     2057          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     2058                                                    ELSE DO: ASSIGN v-string = p-string. END.
     2059       RETURN ( TRIM( v-string ) ).
     2060     END FUNCTION.
     2061   FUNCTION reg-output returns character( input p-string as character
     2062                                         ,input p-private-data as character
     2063                                         ,input p-replace as logical
     2064                                         ,input p-supress as logical
     2065                                         ,input p-dec-sep as character
     2066                                         ,input p-th-sep as character
     2067                                         ):
     2068   DEFINE VARIABLE v-reg-output as character no-undo .
     2069   DEFINE VARIABLE v-data-type as character no-undo .
     2070   DEFINE VARIABLE v-progress-format as character no-undo .
     2071   assign
     2072   v-progress-format = entry(1, p-private-data, chr(4))
     2073   v-data-type = entry(2, p-private-data, chr(4))
     2074   .
     2075   if p-string = ? then return chr(63).
     2076   if (v-data-type = "INTEGER"
     2077       OR v-data-type = "DECIMAL" ) THEN DO:
     2078     IF p-replace THEN DO:
     2079       assign
     2080         v-reg-output = replace( p-string
     2081                                         ,chr(44)
     2082                                         ,"":U
     2083                                       )
     2084         v-reg-output = trim(v-reg-output)
     2085       .
     2086     END.
     2087     else do:
     2088       v-reg-output = p-string.
     2089     end.
     2090     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     2091     return v-reg-output.
     2092   end.
     2093     return p-string.
     2094   END FUNCTION.
