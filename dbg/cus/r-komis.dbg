      587   define variable var-report-r-b as character no-undo .
      588   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      590     (output var-report-r-b
      591     )  .
      592   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   define  stream PrnLibStream.
      594   procedure prn-lib-prn-file :
      595     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      596     define input parameter p-DIsabledoptions as integer no-undo .
      597     define variable v-report-name as character no-undo .
      598     define variable v-user-action as character no-undo .
      599     define variable v-printed     as logical   no-undo .
      600     define variable v-exist       as logical   no-undo .
      601     do
      602       on error undo, return error
      603       :
      604       run prn-lib-get-report-name  in this-procedure (
      605         input parParentProc
      606         ,output v-report-name
      607         ).
      608   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      610     (input  v-report-name
      611     ,input  2
      612     ,output v-exist
      613     )  .
      614       if NOT v-exist then
      615       DO:
      616         Message
      617           "Нет заданий на печать ! "
      618           view-as alert-box .
      619         Return  .
      620       End.
      621       run gbl/prnfilen.w
      622         (input  ""
      623         ,input  p-DisabledOptions
      624         ,input  string(v-report-name )
      625         ,input  7
      626         ,output v-user-action
      627         ,output v-printed
      628         ) .
      629       if v-printed then
      630       do:
      631         return "YES" .
      632       end.
      633       else
      634       do:
      635         return "NO" .
      636       end.
      637     end.
      638   end procedure.
      639   procedure prn-lib-open-stream :
      640     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      641     define input parameter p-page-size    as integer no-undo .
      642     define input parameter p-is-stream    as logical no-undo .
      643     define input parameter p-append       as logical no-undo .
      644     define variable v-report-name as character no-undo .
      645     do
      646       on error undo, return error
      647       :
      648       run prn-lib-get-report-name  in this-procedure (
      649         input parParentProc
      650         ,output v-report-name
      651         ).
      652       if p-is-stream then
      653       do:
      654         if p-append then
      655         do:
      656           output stream PrnLibStream to value( v-report-name )
      657             page-size value(p-page-size) append .
      658         end.
      659         if not p-append then
      660         do:
      661           output stream PrnLibStream to value( v-report-name )
      662             page-size value(p-page-size) .
      663         end.
      664       end.
      665       if not p-is-stream then
      666       do:
      667         if p-append then
      668         do:
      669           output to value( v-report-name )
      670             page-size value(p-page-size) append .
      671         end.
      672         if not p-append then
      673         do:
      674           output to value( v-report-name )
      675             page-size value(p-page-size) .
      676         end.
      677       end.
      678     end.
      679   end procedure.
      680   procedure prn-lib-open-exp :
      681     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      682     define input parameter p-is-stream    as logical no-undo .
      683     define input parameter p-is-append    as logical no-undo .
      684     define output parameter p-ReportFileName as char init "report" no-undo.
      685     define output parameter p-process as logical no-undo .
      686     define variable glog as logical no-undo .
      687     do
      688       on error undo, return error
      689       :
      690       SYSTEM-DIALOG GET-FILE p-ReportFileName
      691         TITLE      "Укажите путь"
      692         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      693         ASK-OVERWRITE
      694         CREATE-TEST-FILE
      695         SAVE-AS
      696         USE-FILENAME
      697         DEFAULT-EXTENSION "txt"
      698         UPDATE glog
      699         .
      700       if not glog then  return.
      701       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      702       if p-is-stream then
      703       do:
      704         if p-is-append then
      705         do:
      706           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      707         end.
      708         else
      709         do:
      710           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      711         end.
      712       end.
      713       else
      714       do:
      715         if p-is-append then
      716         do:
      717           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      718         end.
      719         else
      720         do:
      721           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      722         end.
      723       end.
      724       p-process = yes.
      725     end.
      726   end procedure.
      727   procedure prn-lib-get-report-name :
      728     define input parameter parParentProc  as widget-handle no-undo.
      729     define output parameter p-report-name as character no-undo .
      730     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      731   end procedure.
      732   procedure prn-lib-reportviewer-report-name :
      733     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      734     define input parameter p-report-name-html as character no-undo .
      735     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      736   end procedure.
      737   procedure prn-lib-reportviewer :
      738     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      739     define input parameter p-report-name-html as character no-undo .
      740     define input parameter p-param        as character no-undo .
      741     define variable v-excel           as character no-undo init 'TRUE' .
      742     define variable v-value-character as character no-undo .
      743     define variable v-value-integer   as character no-undo .
      744     define variable v-value-date      as date      no-undo .
      745     define variable v-value-decimal   as decimal   no-undo .
      746     define variable rep-excel         as logical   no-undo .
      747     define variable excel-string      as character no-undo .
      748     define variable v-param-type      as character no-undo .
      749     define variable v-tth             as handle    no-undo .
      750     run adm/shattri.p (
      751       input "get":U
      752       ,input  ""
      753       ,input  0
      754       ,input  'report-glob':U
      755       ,input  'rep-excel':U
      756       ,output v-value-character
      757       ,output v-value-date
      758       ,output v-value-decimal
      759       ,output v-value-integer
      760       ,output rep-excel
      761       ,output v-param-type
      762       ,INPUT-OUTPUT table-handle v-tth
      763       )  .
      764     if rep-excel then v-excel = "TRUE" .
      765     else v-excel = "FALSE" .
      766     if p-param eq ""
      767     then
      768        p-param = "EXCEL:" + v-excel.
      769     else
      770        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      771     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      772   end procedure.
