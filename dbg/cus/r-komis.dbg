      900       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      901       define variable varinvatp-envdo             as   character              no-undo.
      902       define variable varinvatp-typeo             as   character              no-undo.
      903   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      904   define variable v-waitfram-action01         as character   no-undo .
      905   define variable v-waitfram-action02         as character   no-undo .
      906   define variable v-waitfram-action03         as character   no-undo .
      907   define variable mWaitFramTextBeg            as character   no-undo.
      908   define variable mWaitFramTextEnd            as character   no-undo.
      909   define variable mWaitFramView               as logical     no-undo.
      910   define variable mWaitProcEvent              as logical     no-undo init yes.
      911   define variable mWaitFramInterval           as integer     no-undo init 1 .
      912   define variable mWaitFramStop               as logical     no-undo.
      913   define variable mWaitFramStopUser           as logical     no-undo.
      914   define variable mWaitFramStopTimeOut        as logical     no-undo.
      915   define variable mWaitFramStartProc          as datetime-tz no-undo.
      916   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      917   define button B-WaitFramStop auto-end-key
      918        label "Стоп"
      919        size 10 by 1 tooltip "Остоновить процесс".
      920   define button B-viewProcInfo
      921        label "Информация"
      922        size 15 by 1 tooltip "Информация о процесс".
      923   define frame waitfram
      924     v-waitfram-action01 format "x(72)" no-label skip
      925     v-waitfram-action02 format "x(72)" no-label skip
      926     v-waitfram-action03 format "x(72)" no-label skip
      927     B-viewProcInfo
      928     B-WaitFramStop at row 4 col 30
      929     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      930     .
      931   define new global shared variable mBatchMode as logical no-undo init ?.
      932   define variable mFramBachModHandle as handle no-undo.
      933   mFramBachModHandle = frame waitfram:handle.
      934   define variable mFameOldVis as logical no-undo.
      935   define variable mVisCUrentVin as logical no-undo.
      936   if session:batch-mode
      937   then
      938      mBatchMode = yes.
      939   if mBatchMode = ? then do:
      940     mVisCUrentVin = current-window:visible.
      941     mFameOldVis = mFramBachModHandle:visible.
      942     mFramBachModHandle:visible  = yes.
      943     mBatchMode = mFramBachModHandle:visible ne yes.
      944     mFramBachModHandle:visible = mFameOldVis.
      945     current-window:visible = mVisCUrentVin.
      946   end.
      947    if  log-manager:logfile-name ne ?
      948     then DO:
      949         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      950         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      951         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      952     end.
      953   on choose of B-WaitFramStop in frame waitfram
      954   do:
      955     mWaitFramStop = yes.
      956     mWaitFramStopUser = yes.
      957   end.
      958   function waitfram-check-timeout returns logical():
      959      define variable vtime as int64 no-undo.
      960      if mWaitFramStopTimeOut
      961      then
      962         return yes.
      963      vtime = ( now - mWaitFramStartProc ) / 1000 .
      964      if     mWaitFramTimeOut ne ?
      965         and mWaitFramTimeOut ne 0
      966         and mWaitFramTimeOut lt vtime
      967      then do:
      968         mWaitFramStopTimeOut = yes.
      969      end.
      970      return mWaitFramStopTimeOut.
      971   end.
      972   procedure waitfram-hide :
      973     if not session:batch-mode
      974     then do
      975     on error undo, return error return-value
      976     :
      977       pause 0 before-hide .
      978       if not mBatchMode then
      979         hide frame waitfram .
      980     if     not mWaitFramView
      981        and mWaitProcEvent
      982     then
      983       process events .
      984     end.
      985   end procedure.
      986   procedure waitfram-show :
      987     define input  parameter p-message as character no-undo .
      988     define variable v-left-margin as integer   no-undo .
      989     if not session:batch-mode
      990     then do
      991     on error undo, return error return-value
      992     :
      993       if length(p-message) <= 70 then do:
      994         assign
      995           v-left-margin = integer((70 - length(p-message)) / 2)
      996         .
      997         assign
      998           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      999         .
     1000         assign
     1001           v-waitfram-action01 = " "
     1002           v-waitfram-action02 = " "
     1003                                    + fill(" ", v-left-margin)
     1004                                    + p-message
     1005           v-waitfram-action03 = " "
     1006         .
     1007       end.
     1008       else do:
     1009         define variable vRindex1 as integer no-undo.
     1010         define variable vRindex2 as integer no-undo.
     1011         vRindex1 = r-index(p-message," ",70).
     1012         if vRindex1 = 0
     1013         then
     1014            vRindex1 = 70.
     1015         if length(p-message)  <= vRindex1 + 70 then do:
     1016           assign
     1017             v-waitfram-action01 = " "
     1018             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1019             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1020           .
     1021         end.
     1022         else do:
     1023           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1024           if vRindex2 <= vRindex1
     1025           then
     1026              vRindex2 = vRindex1 + 70.
     1027           assign
     1028             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1029             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1030             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1031           .
     1032         end.
     1033       end.
     1034       B-viewProcInfo:visible   in frame waitfram = no.
     1035       B-viewProcInfo:sensitive in frame waitfram = no.
     1036       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1037       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1038       if  (   mWaitFramView
     1039          or  mWaitProcEvent)
     1040          and not mBatchMode
     1041       then
     1042          display
     1043             v-waitfram-action01 skip
     1044             v-waitfram-action02 skip
     1045             v-waitfram-action03 skip
     1046          with frame waitfram .
     1047       if     mWaitFramView
     1048          then do:
     1049             if     mWaitFramInterval ne ?
     1050                and not mBatchMode
     1051             then
     1052                wait-for go of frame waitfram pause mWaitFramInterval.
     1053          end.
     1054          else
     1055             if     mWaitProcEvent
     1056                and not mBatchMode
     1057             then
     1058                process events .
     1059     end.
     1060   end procedure.
     1061      procedure waitfram-show-this:
     1062         define input  parameter iInterval as int64 no-undo.
     1063         define variable vtime as int64 no-undo.
     1064         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1065         mWaitFramInterval = iInterval.
     1066         run waitfram-show (substitute("&1&2 &3&4" ,
     1067                                       mWaitFramTextBeg ,
     1068                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1069                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1070                                       mWaitFramTextEnd
     1071                                      )
     1072                           ).
     1073      end.
     1074      procedure WaitFramRunPause:
     1075         define input  parameter iInterval as dec no-undo.
     1076         define variable vStart  as datetime-tz no-undo.
     1077         define variable vend    as datetime-tz no-undo.
     1078         define variable vint as int64 no-undo.
     1079         define variable vOk as logical no-undo.
     1080         vStart = now.
     1081         vend   = vStart.
     1082         publish "WaitFramPause" (iInterval,output vOk).
     1083         vend   =  now.
     1084         vint = vend - vStart.
     1085         vint = iInterval - vint / 1000.
     1086         if     not mWaitFramStop
     1087            and (   vint > 0
     1088                 or (    not vOk
     1089                     and iInterval eq ?
     1090                     )
     1091                 )
     1092         then
     1093            run waitfram-show-this (iInterval).
     1094         vend   =  now.
     1095         vint = vend - vStart.
     1096         vint = iInterval - vint / 1000.
     1097         if     not mWaitFramStop
     1098            and vint > 0
     1099         then do:
     1100            run gbl/pause.p (vint * 1000).
     1101         end.
     1102         if iInterval ne ?
     1103         then
     1104            publish "WaitFramStop".
     1105         waitfram-check-timeout().
     1106      end.
     1107      procedure WaitFramWaitFor:
     1108         define input  parameter iInterval as dec no-undo.
     1109         assign
     1110            mWaitFramStartProc   = now
     1111            mWaitFramStopUser    = no
     1112            mWaitFramStopTimeOut = no
     1113         .
     1114         block-wait:
     1115         do while not mWaitFramStop:
     1116            run WaitFramRunPause (iInterval).
     1117            if  waitfram-check-timeout()
     1118            then do:
     1119               leave block-wait.
     1120            end.
     1121         end.
     1122         run waitfram-hide.
     1123      end.
     1124   procedure waitfram-join :
     1125     define input  parameter p-line-1  as character no-undo .
     1126     define input  parameter p-line-2  as character no-undo .
     1127     define input  parameter p-line-3  as character no-undo .
     1128     define output parameter p-message as character no-undo .
     1129     do
     1130     on error undo, return error return-value
     1131     :
     1132       assign
     1133         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1134                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1135                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1136       .
     1137     end.
     1138   end procedure.
     1139   function waitfram-join-function returns character
     1140     (input p-line-1 as character
     1141     ,input p-line-2 as character
     1142     ,input p-line-3 as character
     1143     ).
     1144     define variable v-message as character no-undo .
     1145     run waitfram-join in this-procedure
     1146       (input  p-line-1
     1147       ,input  p-line-2
     1148       ,input  p-line-3
     1149       ,output v-message
     1150       ) .
     1151     return v-message .
     1152   end function .
