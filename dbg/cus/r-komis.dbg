     1323       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1324       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1325       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1326       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1327       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1328       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1329       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1330       define variable varinvatp-envdo             as   character              no-undo.
     1331       define variable varinvatp-typeo             as   character              no-undo.
     1332     do
     1333     on error undo, return error
     1334     :
     1335   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   FOR  each ub.doc-line NO-LOCk WHERE
     1337            ub.doc-line.doc-code = doc-num:
     1338   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
     1340     (input  recid(ub.doc-line)
     1341     ,output v-gds-code
     1342     ) no-error .
     1343     if error-status:error then do:
     1344      next.
     1345     end.
     1346     assign
     1347     my-accum = my-accum + 1
     1348     .
     1349     IF my-accum MODULO 50  = 0 then do:
     1350       run waitfram-show in this-procedure ("Обработано " + string(my-accum) + " строк накладных ").
     1351     end.
     1352   if t-doc.ext-doc-type = 'ot':U or
     1353      t-doc.ext-doc-type = ?                 then do:
     1354     assign
     1355      out-vatp-have-vat-slt = yes.
     1356   end.
     1357   else do:
     1358     find first out-vatp_doc-attr no-lock
     1359       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     1360         and out-vatp_doc-attr.attr-code = 'envd':U
     1361         no-error .
     1362     if not available out-vatp_doc-attr then do:
     1363       assign
     1364         out-vatp-have-vat-slt = yes.
     1365     end.
     1366     else do:
     1367        out-vatp-have-vat-slt = no.
     1368     end.
     1369   end.
     1370   find first out-vatp_goods where out-vatp_goods.artic     = ub.doc-line.artic     and
     1371                                      out-vatp_goods.prod-type = ub.doc-line.prod-type and
     1372                                      out-vatp_goods.prod-code = ub.doc-line.prod-code no-lock.
     1373   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1375     (input  ub.doc-line.artic
     1376     ,input  ub.doc-line.prod-type
     1377     ,input  ub.doc-line.prod-code
     1378     ,output varroot-node
     1379     ) no-error .
     1380   if error-status :error then do:
     1381     message
     1382       vss-workfile vss-revision vss-description skip
     1383       "Ошибка при определении корневого признака товара" skip
     1384       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     1385       error-status :get-message(1) skip
     1386       return-value skip
     1387       view-as alert-box error .
     1388     undo, return error .
     1389   end.
     1390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1391     (input  varroot-node
     1392     ,input  'empty-scale=request'
     1393     ,output varempty-scale
     1394     ) no-error .
     1395   if error-status :error then do:
     1396     message
     1397       vss-workfile vss-revision vss-description skip
     1398       "Ошибка при определении атрибута признака" skip
     1399       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     1400       "Признак" varroot-node skip
     1401       "Запрашивался атрибут" "empty-scale=request" skip
     1402       error-status :get-message(1) skip
     1403       return-value skip
     1404       view-as alert-box error .
     1405     undo, return error .
     1406   end.
     1407   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1409     (output varoutvprb
     1410     )  .
     1411   if varoutvprb = "base":u then do:
     1412     assign
     1413           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     1414       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1)
     1415     .
     1416   end.
     1417   else do:
     1418     assign
     1419           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     1420       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     1421     .
     1422   end.
     1423   if varoutvprb = "rubl":u then do:
     1424     assign
     1425           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     1426       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1) .
     1427   end.
     1428   else do:
     1429     assign
     1430           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
     1431       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     1432   end.
     1433   assign
     1434     varis-cons-parts-have =  no.
     1435   assign
     1436     varfact-qnty       = 0
     1437     varcons-qnty       = 0
     1438     varprice-base-cons = 0
     1439     varprice-rubl-cons = 0.
     1440   find first out-vatp_doc-line where
     1441              out-vatp_doc-line.doc-code   = t-doc.doc-code
     1442          and out-vatp_doc-line.artic      = ub.doc-line.artic
     1443          and out-vatp_doc-line.prod-type  = ub.doc-line.prod-type
     1444          and out-vatp_doc-line.prod-code  = ub.doc-line.prod-code no-lock no-error.
     1445   if available out-vatp_doc-line           and
     1446     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1447     assign
     1448       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1449   end.
     1450   else do:
     1451     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     1452                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     1453                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     1454                                  and out-vatp_parts.artic      = ub.doc-line.artic
     1455                                  and out-vatp_parts.prod-type  = ub.doc-line.prod-type
     1456                                  and out-vatp_parts.prod-code  = ub.doc-line.prod-code no-lock :
     1457       if out-vatp_parts.purch-code = 2 then do:
     1458   assign
     1459     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1460     price-base-with-tax-loco = out-vatp_parts.price-base
     1461   .
     1462   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1463   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1464     (output varinvprbo
     1465     )  .
     1466     if out-vatp_parts.out-code = 'free-zone':U     or
     1467        out-vatp_parts.out-code = 'out-zone':U   or
     1468        out-vatp_parts.doc-type = 'акт':U then do:
     1469       assign
     1470         in-vatp-have-vat-slto = yes.
     1471     end.
     1472     else do:
     1473       find first in-vatp_doc-attro no-lock
     1474         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1475           and in-vatp_doc-attro.attr-code = 'envd':U
     1476         no-error .
     1477       if not available in-vatp_doc-attro then do:
     1478         assign
     1479           in-vatp-have-vat-slto = yes.
     1480       end.
     1481       else do:
     1482            in-vatp-have-vat-slto = no.
     1483       end.
     1484     end.
     1485     assign
     1486      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1487      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1488     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1489              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1490     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1491             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1492             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1493             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1494             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1495             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1496             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1497       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1498     assign
     1499       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1500     assign
     1501       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1502       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1503       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1504       transport-cli-loco  = 0
     1505       other-cli-loco      = 0
     1506     .
     1507   ASSIGN
     1508             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1509       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1510   .
     1511         assign
     1512           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1513           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1514         assign
