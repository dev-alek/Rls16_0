     3408     FORM with FRAME FKomis .
     3409     FORM HEADER
     3410     Line format "X(60)" AT 1 SKIP
     3411     string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     3412     with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3413     VIEW stream PrnLibStream FRAME NBottomFrame .
     3414     PUT stream PrnLibStream UNFORMATTED
     3415     SPACE(10)
     3416     p-Report-header
     3417     SKIP(1).
     3418     display STREAM PrnLibStream with frame top-Frame .
     3419   end.
     3420   run rep/extitle.p (1).
     3421   assign
     3422   accum-qnty                   = 0
     3423   accum-sum-without-tax-cost   = 0
     3424   accum-sum-vat-cost           = 0
     3425   accum-sum-with-tax-cost      = 0
     3426   accum-sum-without-tax-sale   = 0
     3427   accum-sum-vat-sale           = 0
     3428   accum-sum-without-slt-sale   = 0
     3429   accum-sum-slt-sale           = 0
     3430   accum-sum-with-tax-sale      = 0
     3431   .
     3432   FOR EACH sj-goods no-lock
     3433   By sj-goods.artic
     3434   By sj-goods.prod-type
     3435   By sj-goods.prod-code:
     3436     assign
     3437     v-nn = v-nn + 1
     3438     v-prod = sj-goods.prod-type + chr(32) + string(sj-goods.prod-code)
     3439     v-sum-without-slt-sale = sj-goods.sum-with-tax-sale_ - sj-goods.sum-slt-sale_
     3440     accum-qnty                   = accum-qnty                   + sj-goods.qnty
     3441     accum-sum-without-tax-cost   = accum-sum-without-tax-cost   + sj-goods.sum-without-tax-cost_
     3442     accum-sum-vat-cost           = accum-sum-vat-cost           + sj-goods.sum-vat-cost_
     3443     accum-sum-with-tax-cost      = accum-sum-with-tax-cost      + sj-goods.sum-with-tax-cost_
     3444     accum-sum-without-tax-sale   = accum-sum-without-tax-sale   + sj-goods.sum-without-tax-sale_
     3445     accum-sum-vat-sale           = accum-sum-vat-sale           + sj-goods.sum-vat-sale_
     3446     accum-sum-without-slt-sale   = accum-sum-without-slt-sale   + v-sum-without-slt-sale
     3447     accum-sum-slt-sale           = accum-sum-slt-sale           + sj-goods.sum-slt-sale_
     3448     accum-sum-with-tax-sale      = accum-sum-with-tax-sale      + sj-goods.sum-with-tax-sale_
     3449     .
