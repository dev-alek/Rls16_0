     2477             v-itog-bn [8]  = v-itog-bn [8]  + temp-sale.sum4
     2478             v-itog-bn [9]  = v-itog-bn [9]  + temp-sale.val5
     2479             v-itog-bn [10] = v-itog-bn [10] + temp-sale.sum5
     2480             v-itog-bn [11] = v-itog-bn [11] + temp-sale.val6
     2481             v-itog-bn [12] = v-itog-bn [12] + temp-sale.sum6
     2482             v-itog-bn [13] = v-itog-bn [13] + temp-sale.val-all
     2483             v-itog-bn [14] = v-itog-bn [14] + temp-sale.sum-all
