      912       end.
      913     end.
      914   end procedure.
      915   procedure paramls-write :
      916     define input  parameter p-code     as character no-undo .
      917     define input  parameter p-sub-code as character no-undo .
      918     define input  parameter p-value    as character no-undo .
      919     define buffer buf_temp-param for temp-param .
      920     do
      921     on error undo, return error return-value
      922     :
      923       find first buf_temp-param
      924         where buf_temp-param.param-code     = p-code
      925           and buf_temp-param.param-sub-code = p-sub-code
      926         no-error .
      927       if not available buf_temp-param then do:
      928         create buf_temp-param .
      929         assign
      930           buf_temp-param.param-code     = p-code
      931           buf_temp-param.param-sub-code = p-sub-code
      932         .
      933       end.
      934       assign
      935         buf_temp-param.param-value = p-value
      936       .
      937     end.
      938   end procedure.
      939   procedure paramls-read :
      940     define input  parameter p-code          as character no-undo .
      941     define input  parameter p-sub-code      as character no-undo .
      942     define input  parameter p-default-value as character no-undo .
      943     define output parameter p-value         as character no-undo .
      944     define buffer buf_temp-param for temp-param .
      945     do
      946     on error undo, return error return-value
      947     :
      948       find first buf_temp-param
      949         where buf_temp-param.param-code     = p-code
      950           and buf_temp-param.param-sub-code = p-sub-code
      951         no-error .
      952       if available buf_temp-param then do:
      953         assign
      954           p-value = buf_temp-param.param-value
      955         .
      956       end.
      957       else do:
      958         assign
      959           p-value = p-default-value
      960         .
      961       end.
      962     end.
      963   end procedure.
      964   procedure paramls-append :
      965     define input  parameter p-code     as character no-undo .
      966     define input  parameter p-sub-code as character no-undo .
      967     define input  parameter p-value    as character no-undo .
      968     define buffer buf_temp-param for temp-param .
      969     do
      970     on error undo, return error return-value
      971     :
      972       find first buf_temp-param
      973            where buf_temp-param.param-code     = p-code
      974              and buf_temp-param.param-sub-code = p-sub-code
      975         no-error .
      976       if not available buf_temp-param then do:
      977         create buf_temp-param .
      978         assign
      979           buf_temp-param.param-code     = p-code
      980           buf_temp-param.param-sub-code = p-sub-code
      981           buf_temp-param.param-value    = p-value
      982         .
      983       end.
      984       else do:
      985           assign
      986               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      987           .
      988       end.
      989     end.
      990   end procedure.
      991   define variable vss-include-info15 as character format "X(65)" no-undo
      992   initial "@(#)$Workfile$ $Revision$".
      993   define stream excel-line.
