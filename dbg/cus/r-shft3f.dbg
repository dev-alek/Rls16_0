     2194         if thbjattr_thbj-attr.prop-code = 'rep-sort'  then v-sort-list  = thbjattr_thbj-attr.property-value-character .
     2195     end.
     2196   if error-status:error or v-sort-list = "":U then do:
     2197     define variable v-tooltip as character no-undo .
     2198     define variable v-label as character no-undo .
     2199     define variable v-tooltip-code as character no-undo .
     2200     run thbjattr_tooltip in this-procedure (
     2201                                               input  'report-glob':U
     2202                                              ,input  'rep-sort':U
     2203                                              ,output v-tooltip
     2204                                              ,output v-label
     2205                                              ,output v-tooltip-code ) no-error.
     2206     if error-status:error then do:
     2207       assign
     2208       v-tooltip-code = 'rep-sort':U
     2209       v-tooltip = 'report-glob':U
     2210       .
     2211     end.
     2212     message
     2213     substitute("Не найден или незаполнен параметр <&1>&2Секция <&3>"
     2214               , v-tooltip-code
     2215               , chr(10)
     2216               ,v-tooltip)
     2217     view-as alert-box error .
     2218     return .
     2219   end.
     2220     _sort-cycle:
     2221     do v-ind = 1 to NUM-ENTRIES(v-sort-list) :
     2222       assign v-str = entry( v-ind, v-sort-list ) .
     2223       _gds-cycle:
     2224       for each buf_goods no-lock
     2225       where buf_goods.gds-code = integer(v-str)
     2226       :
     2227   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2228     (
     2229        input buf_goods.artic
     2230     ,  input buf_goods.prod-type
     2231     ,  input buf_goods.prod-code
     2232     , output v-is-petrol
     2233     , output v-is-pieces
     2234     ) .
     2235         if v-is-petrol  = yes
     2236         and v-is-pieces = no
     2237         then do:
     2238   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2239     (input  buf_goods.gds-code
     2240     ,input  ?
     2241     ,output v-b-code
     2242     )  .
     2243           find first temp-gds where temp-gds.gds-code = buf_goods.gds-code no-error .
     2244           if not available temp-gds then do:
     2245             create temp-gds .
     2246             assign
     2247               temp-gds.artic     = buf_goods.artic
     2248               temp-gds.prod-type = buf_goods.prod-type
     2249               temp-gds.prod-code = buf_goods.prod-code
     2250               temp-gds.gds-code  = buf_goods.gds-code
     2251             temp-gds.b-code    = v-b-code
     2252               temp-gds.num       = v-ind
     2253             .
     2254             next _gds-cycle.
     2255           end.
     2256         end.
     2257       end.
     2258     end.
     2259     find first temp-gds no-error .
     2260     if not available temp-gds then do:
     2261       message "Нет товаров для отчета." view-as alert-box error .
     2262       return .
     2263     end.
     2264   define variable cpgrpnam as character no-undo .
     2265   define variable v-dops as character no-undo.
     2266   define variable v-dopi as integer no-undo.
     2267   define variable ii as integer no-undo.
     2268   define variable nn as integer   no-undo .
     2269   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2270   empty temp-table thbjattr_thbj-attr.
     2271   run adm/shattri.p (
     2272      input "get":U
     2273     ,input ''
     2274     ,input 0
     2275     ,input 'cashpays':U
     2276     ,input  ""
     2277     ,output v-value-character
     2278     ,output v-value-date
     2279     ,output v-value-decimal
     2280     ,output v-value-integer
     2281     ,output v-value-logical
     2282     ,output par-type
     2283     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2284     ) no-error .
     2285     for each thbjattr_thbj-attr :
     2286         if thbjattr_thbj-attr.prop-code = 'cpgrpnam':U  then cpgrpnam  = thbjattr_thbj-attr.property-value-character .
     2287     end.
     2288     assign  nn = 1 .
     2289     DO ii = 1 TO NUM-ENTRIES(cpgrpnam) by 2:
     2290       ASSIGN
     2291         v-dops = ENTRY(ii, cpgrpnam)
     2292         v-dopi = integer(ENTRY(ii + 1, cpgrpnam))
     2293       NO-ERROR.
     2294       IF ERROR-STATUS:ERROR or v-dopi = 0 or v-dopi >= 10000 THEN DO:
     2295         run thbjattr_tooltip in this-procedure (
     2296                                                  input 'cashpays':U
     2297                                                 ,input  'cpgrpnam':U
     2298                                                 ,output v-tooltip
     2299                                                 ,output v-label
     2300                                                 ,output v-tooltip-code ) no-error.
     2301         if error-status:error then do:
     2302           assign
     2303           v-tooltip-code = 'cpgrpnam':U
     2304           v-tooltip = 'cashpays':U
     2305           .
     2306         end.
     2307         MESSAGE
     2308         substitute("Неверное значение параметра <&1>&2Секция <&3>&2" +
     2309                    "четные элементы списка должны быть положительными целыми числами < 10000"
     2310                   , v-tooltip-code
     2311                   , chr(10)
     2312                   ,v-tooltip)
     2313         VIEW-AS ALERT-BOX ERROR.
     2314         RETURN .
     2315       END.
     2316       create temp-grp .
     2317       ASSIGN
     2318         temp-grp.name = v-dops
     2319         temp-grp.code = v-dopi
     2320         temp-grp.num  = nn
     2321         nn            = nn + 1
     2322       .
     2323     END.
     2324     define buffer buf_chk-gds-pay for ub.chk-gds-pay .
     2325     define buffer buf_cash-pay for ub.cash-pay .
     2326     run rep/rpychk0.p ( input "r-shft3f"
     2327                        ,input obj-list.obj-type
     2328                        ,input obj-list.obj-code
     2329                        ,input ?
     2330                        ,input ?
     2331                        ,input X-date-start
     2332                        ,input X-date-end
     2333                        ,input X-shift-start
     2334                        ,input X-shift-end
     2335                        ,input ?
     2336                        ).
     2337     for each temp-gds :
     2338       for each buf_chk-gds-pay no-lock
     2339         where buf_chk-gds-pay.b-code      = temp-gds.b-code
     2340           and buf_chk-gds-pay.obj-type    = obj-list.obj-type
     2341           and buf_chk-gds-pay.obj-code    = obj-list.obj-code
     2342           and buf_chk-gds-pay.shift-date >= X-date-start
     2343           and buf_chk-gds-pay.shift-date <= X-date-end
     2344       :
     2345         if buf_chk-gds-pay.algo-num <> "1.8" then next.
     2346         if buf_chk-gds-pay.shift-date = X-date-start  and buf_chk-gds-pay.shift-num < X-Shift-Start  then next .
     2347         if buf_chk-gds-pay.shift-date = X-date-end and buf_chk-gds-pay.shift-num > X-Shift-end then next .
     2348         find first temp-sale where temp-sale.code = buf_chk-gds-pay.pay-code no-error .
     2349         if not available temp-sale then do:
     2350           find first buf_cash-pay no-lock where buf_cash-pay.cdpay-code = buf_chk-gds-pay.pay-code and buf_cash-pay.curr-code = buf_chk-gds-pay.curr-code .
     2351           create temp-sale .
     2352           assign
     2353             temp-sale.name   = buf_cash-pay.obj-name
     2354             temp-sale.code   = buf_cash-pay.cdpay-code
     2355             temp-sale.is-nal = buf_cash-pay.is-cash
     2356           .
     2357           temp-sale.grp  = get-grp-name(input buf_cash-pay.cdpay-code, buf_cash-pay.curr-code) .
     2358         end.
     2359         case temp-gds.num :
     2360           when 1 then do:
     2361             assign
     2362               temp-sale.val1 = temp-sale.val1 + buf_chk-gds-pay.eff-doc-qnty
     2363               temp-sale.sum1 = temp-sale.sum1 + buf_chk-gds-pay.tot-r-b
     2364             .
     2365           end.
     2366           when 2 then do:
     2367             assign
     2368               temp-sale.val2 = temp-sale.val2 + buf_chk-gds-pay.eff-doc-qnty
     2369               temp-sale.sum2 = temp-sale.sum2 + buf_chk-gds-pay.tot-r-b
     2370             .
     2371           end.
     2372           when 3 then do:
     2373             assign
     2374               temp-sale.val3 = temp-sale.val3 + buf_chk-gds-pay.eff-doc-qnty
     2375               temp-sale.sum3 = temp-sale.sum3 + buf_chk-gds-pay.tot-r-b
     2376             .
     2377           end.
     2378           when 4 then do:
     2379             assign
     2380               temp-sale.val4 = temp-sale.val4 + buf_chk-gds-pay.eff-doc-qnty
     2381               temp-sale.sum4 = temp-sale.sum4 + buf_chk-gds-pay.tot-r-b
     2382             .
     2383           end.
     2384           when 5 then do:
     2385             assign
     2386               temp-sale.val5 = temp-sale.val5 + buf_chk-gds-pay.eff-doc-qnty
     2387               temp-sale.sum5 = temp-sale.sum5 + buf_chk-gds-pay.tot-r-b
     2388             .
     2389           end.
     2390           when 6 then do:
     2391             assign
     2392               temp-sale.val6 = temp-sale.val6 + buf_chk-gds-pay.eff-doc-qnty
     2393               temp-sale.sum6 = temp-sale.sum6 + buf_chk-gds-pay.tot-r-b
     2394             .
     2395           end.
     2396         end.
     2397         assign
     2398           temp-sale.val-all = temp-sale.val5 + buf_chk-gds-pay.eff-doc-qnty
     2399           temp-sale.sum-all = temp-sale.sum5 + buf_chk-gds-pay.tot-r-b
     2400         .
     2401       end.
     2402     end.
     2403   output stream out-stream to value( string( session:temp-directory +
     2404                                        "rpt" + string( g#report-num ) ) )
     2405                                        page-size  value(62) .
