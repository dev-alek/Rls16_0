     1869   define variable v-codes as character no-undo .
     1870   define variable v-labels as character no-undo .
     1871   define variable v-ok as logical no-undo .
     1872     do
     1873     on error undo, return error
     1874     :
     1875       assign
     1876       v-value = p-value
     1877       .
     1878       run ref/cpa-grp.w (
     1879                      input parparentproc
