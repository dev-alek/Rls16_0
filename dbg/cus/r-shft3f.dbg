     2109            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2110   define variable mFrameView      as logical   no-undo init yes.
     2111     define variable mFramHandle as handle no-undo.
     2112     mFramHandle = frame InfoFrame:handle.
     2113     if  log-manager:logfile-name ne ?
     2114     then DO:
     2115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2117         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2118     end.
     2119     mFrameView = not session:batch-mode and mFramHandle:visible.
     2120     if mFrameView
     2121     then do:
     2122       ASSIGN
     2123          FRAME InfoFrame:HIDDEN                           = TRUE
     2124          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2125     end.
     2126   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2127   DO:
     2128     IF not StopProcessing THEN
     2129       Message "Вы действительно хотите прервать" SKIP
     2130               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2131                 UPDATE StopProcessing.
     2132     IF StopProcessing THEN do:
     2133        if mFrameView
     2134        then do:
     2135           HIDE FRAME InfoFrame.
     2136        end.
     2137     End.
     2138   END.
     2139   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     2140     if  log-manager:logfile-name ne ?
     2141     then DO:
     2142         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2143     end.
