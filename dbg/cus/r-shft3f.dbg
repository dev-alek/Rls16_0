     2600   define temp-table temp-rvs-line no-undo like ub.rvs-line
     2601     FIELD gds-name as character
     2602     FIELD place_loc1 as character
     2603     FIELD shift-date like ub.rvs-doc.shift-date
     2604     FIELD shift-num  like ub.rvs-doc.shift-num
     2605     FIELD v-bar-code like ub.bar-code.b-code
     2606     FIELD artic      like ub.goods.artic
     2607     FIELD prod-type  like ub.goods.prod-type
     2608     FIELD prod-code  like ub.goods.prod-code
     2609   .
     2610   procedure Calc-Itog-Counter :
     2611     do on error undo, return error return-value :
     2612     define buffer buf_rvs-line-pump for ub.rvs-line-pump .
     2613     define buffer buf_temp-rvs-line for temp-rvs-line .
     2614   define buffer previous-rvs-doc for ub.rvs-doc.
     2615   define buffer previous-rvs-line for ub.rvs-line.
     2616   define buffer previous-rvs-line-pump for ub.rvs-line-pump.
     2617   define buffer last-rvs-doc for ub.rvs-doc.
     2618   define buffer last-rvs-line for ub.rvs-line.
     2619   define buffer last-rvs-line-pump for ub.rvs-line-pump.
     2620   define buffer previous-shift-obj for ub.shift-obj.
     2621   define buffer control-rvs-doc for ub.rvs-doc.
     2622   define buffer control-rvs-line-pump for ub.rvs-line-pump.
     2623   define variable pol5 as decimal   no-undo .
     2624   define variable pol6 as decimal   no-undo .
     2625   FIND FIRST last-rvs-doc No-LOCK WHERE
     2626              last-rvs-doc.obj-type   = obj-list.obj-type AND
     2627              last-rvs-doc.obj-code   = obj-list.obj-code AND
     2628              last-rvs-doc.shift-date = x-date-End AND
     2629              last-rvs-doc.shift-num  = x-shift-end AND
     2630              last-rvs-doc.status_    = 'факт':U AND
     2631              last-rvs-doc.rvs-type   = 'смена':U NO-ERROR.
     2632   if not avail last-rvs-doc then do:
     2633     message vss-workfile vss-revision vss-description skip
     2634             "Не найдена сверка типа СМН "
     2635             "объект" obj-list.obj-type obj-list.obj-code
     2636             "смена" x-date-End x-shift-end
     2637     view-as alert-box ERROR.
     2638     return error.
     2639   END.
     2640   find last previous-shift-obj no-lock where
     2641             previous-shift-obj.obj-type   = obj-list.obj-type  and
     2642             previous-shift-obj.obj-code   = obj-list.obj-code  and
     2643         ( ( previous-shift-obj.shift-date = x-date-Start   and
     2644             previous-shift-obj.shift-num  < x-shift-Start  ) or
     2645             previous-shift-obj.shift-date < x-date-Start ) use-index pi no-error .
     2646   if available previous-shift-obj then do:
     2647     FIND FIRST previous-rvs-doc No-LOCK WHERE
     2648               previous-rvs-doc.obj-type   = obj-list.obj-type AND
     2649               previous-rvs-doc.obj-code   = obj-list.obj-code AND
     2650               previous-rvs-doc.shift-date = previous-shift-obj.shift-date AND
     2651               previous-rvs-doc.shift-num  = previous-shift-obj.shift-num AND
     2652               previous-rvs-doc.status_    = 'факт':U AND
     2653               previous-rvs-doc.rvs-type   = 'смена':U NO-ERROR.
     2654   end.
     2655     for each ub.rvs-doc No-LOCK WHERE
     2656              ub.rvs-doc.obj-type   = obj-list.obj-type AND
     2657              ub.rvs-doc.obj-code   = obj-list.obj-code AND
     2658              ub.rvs-doc.shift-date >= x-date-Start AND
     2659              ub.rvs-doc.shift-date <= x-date-End AND
     2660              ub.rvs-doc.status_    = 'факт':U AND
     2661              ub.rvs-doc.rvs-type   = 'смена':U :
     2662       if ub.rvs-doc.shift-date = x-date-Start and ub.rvs-doc.shift-num < x-Shift-Start then next .
     2663       if ub.rvs-doc.shift-date = x-date-End   and ub.rvs-doc.shift-num > x-Shift-End then next .
     2664       for each ub.rvs-line No-LOCK WHERE ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code :
     2665         find first temp-gds where temp-gds.gds-code = ub.rvs-line.gds-code no-error .
     2666         if not available temp-gds then next .
     2667         find first temp-rvs-line where temp-rvs-line.pl-code  = ub.rvs-line.pl-code and temp-rvs-line.gds-code = ub.rvs-line.gds-code no-error .
     2668         if not available temp-rvs-line then do:
     2669           create temp-rvs-line .
     2670           BUFFER-COPY ub.rvs-line to temp-rvs-line .
     2671           assign
     2672             temp-rvs-line.artic      = temp-gds.artic
     2673             temp-rvs-line.prod-type  = temp-gds.prod-type
     2674             temp-rvs-line.prod-code  = temp-gds.prod-code
     2675             temp-rvs-line.shift-date = ub.rvs-doc.shift-date
     2676             temp-rvs-line.shift-num  = ub.rvs-doc.shift-num
     2677             temp-rvs-line.v-bar-code = temp-gds.b-code
     2678           .
     2679         end.
     2680         else do:
     2681           if temp-rvs-line.shift-date < ub.rvs-doc.shift-date or temp-rvs-line.shift-date = ub.rvs-doc.shift-date and temp-rvs-line.shift-num  < ub.rvs-doc.shift-num then
     2682             BUFFER-COPY ub.rvs-line to temp-rvs-line .
     2683         end.
     2684       end.
     2685     end.
     2686     for each temp-rvs-line  break by temp-rvs-line.gds-code by temp-rvs-line.pl-code on error undo, return error return-value :
     2687       if first-of(temp-rvs-line.gds-code) then do:
     2688         assign
     2689           pol5 = 0
     2690           pol6 = 0
     2691         .
     2692       end.
     2693       if avail previous-rvs-doc then
     2694         Find first previous-rvs-line  No-LOCK WHERE
     2695                 previous-rvs-line.rvs-code = previous-rvs-doc.rvs-code and
     2696                 previous-rvs-line.gds-code = temp-rvs-line.gds-code  and
     2697                 previous-rvs-line.obj-code = temp-rvs-line.obj-code  and
     2698                 previous-rvs-line.obj-type = temp-rvs-line.obj-type  and
     2699                 previous-rvs-line.pl-code  = temp-rvs-line.pl-code
     2700                 no-error .
     2701       FOR EACH buf_rvs-line-pump No-LOCK WHERE
     2702          buf_rvs-line-pump.rvs-code = temp-rvs-line.rvs-code  and
     2703          buf_rvs-line-pump.gds-code = temp-rvs-line.gds-code  and
     2704          buf_rvs-line-pump.obj-code = temp-rvs-line.obj-code  and
     2705          buf_rvs-line-pump.obj-type = temp-rvs-line.obj-type  and
     2706          buf_rvs-line-pump.pl-code  = temp-rvs-line.pl-code
     2707         BREAK BY buf_rvs-line-pump.pump-code BY buf_rvs-line-pump.nozzle-code:
     2708         assign
     2709           pol5 = pol5 + buf_rvs-line-pump.state-mh-cnt
     2710         .
     2711         if avail previous-rvs-doc then do:
     2712           Find FIRST previous-rvs-line-pump  No-LOCK WHERE
     2713               previous-rvs-line-pump.rvs-code = previous-rvs-doc.rvs-code AND
     2714               previous-rvs-line-pump.gds-code = temp-rvs-line.gds-code  and
     2715               previous-rvs-line-pump.obj-code = temp-rvs-line.obj-code  and
     2716               previous-rvs-line-pump.obj-type = temp-rvs-line.obj-type  and
     2717               previous-rvs-line-pump.pl-code  = temp-rvs-line.pl-code AND
     2718               previous-rvs-line-pump.pump-code = buf_rvs-line-pump.pump-code AND
     2719               previous-rvs-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code No-ERROR.
     2720           IF AVAIL previous-rvs-line-pump then do:
     2721             assign pol6 = pol6 + previous-rvs-line-pump.state-mh-cnt .
     2722           end.
     2723         end.
     2724         if not avail previous-rvs-doc or not avail previous-rvs-line-pump then do:
     2725           FOR EACH control-rvs-doc NO-LOCK WHERE
     2726               control-rvs-doc.obj-type   = obj-list.obj-type AND
     2727               control-rvs-doc.obj-code   = obj-list.obj-code AND
     2728               control-rvs-doc.shift-date = x-date-Start AND
     2729               control-rvs-doc.shift-num  = x-shift-Start AND
     2730               control-rvs-doc.status_    = 'факт':U AND
     2731               control-rvs-doc.rvs-type   = 'контроль':U,
     2732           FIRST control-rvs-line-pump No-LOCK WHERE
     2733             control-rvs-line-pump.rvs-code = control-rvs-doc.rvs-code AND
     2734             control-rvs-line-pump.gds-code = temp-rvs-line.gds-code  and
     2735             control-rvs-line-pump.obj-code = temp-rvs-line.obj-code  and
     2736             control-rvs-line-pump.obj-type = temp-rvs-line.obj-type  and
     2737             control-rvs-line-pump.pl-code  = temp-rvs-line.pl-code AND
     2738             control-rvs-line-pump.pump-code = buf_rvs-line-pump.pump-code AND
     2739             control-rvs-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code
     2740           BY control-rvs-doc.fact-order:
     2741             assign pol6 = pol6 + control-rvs-line-pump.state-mh-cnt .
     2742             LEAVE.
     2743           END.
     2744         end.
     2745       END.
     2746       if last-of( temp-rvs-line.gds-code ) then do:
     2747         find first temp-gds where temp-gds.gds-code = temp-rvs-line.gds-code no-error .
     2748         if available temp-gds then assign v-counter [ temp-gds.num ] = pol5 - pol6 .
     2749       End.
     2750     End.
     2751     end.
     2752   end procedure.
     2753   procedure Calc-Itog-Teh :
     2754     do on error undo, return error return-value :
     2755       define buffer buf_clients      for ub.clients .
     2756       define buffer buf_clients-attr for ub.clients-attr .
     2757       define buffer buf_trn-doc      for ub.trn-doc .
     2758       define buffer buf_doc-line     for ub.doc-line .
     2759       FOR EACH buf_clients-attr WHERE buf_clients-attr.attr-code  = 'shftrep2':U AND buf_clients-attr.attr-value = "yes":U :
     2760         FIND FIRST buf_clients NO-LOCK WHERE buf_clients.obj-type = buf_clients-attr.obj-type AND buf_clients.obj-code = buf_clients-attr.obj-code NO-ERROR.
     2761         IF not AVAILABLE buf_clients THEN next .
     2762         for each buf_trn-doc no-lock
     2763           where buf_trn-doc.obj-type   = obj-list.obj-type
     2764             and buf_trn-doc.obj-code   = obj-list.obj-code
     2765             and buf_trn-doc.status_    = 'факт':U
     2766             and buf_trn-doc.cli-type   = buf_clients.obj-type
     2767             and buf_trn-doc.cli-code   = buf_clients.obj-code
     2768             and buf_trn-doc.shift-date >= x-Date-Start
     2769             and buf_trn-doc.shift-date <= x-Date-End
     2770         :
     2771           if buf_trn-doc.shift-date = x-Date-Start and buf_trn-doc.shift-num < x-Shift-Start then next .
     2772           if buf_trn-doc.shift-date = x-Date-End   and buf_trn-doc.shift-num > x-Shift-End   then next .
     2773           IF buf_trn-doc.ext-doc-type = 'ie':U then next .
     2774           for each buf_doc-line no-lock where buf_doc-line.doc-code  = buf_trn-doc.doc-code :
     2775             find first temp-gds
     2776               where temp-gds.artic     = buf_doc-line.artic
     2777                 and temp-gds.prod-type = buf_doc-line.prod-type
     2778                 and temp-gds.prod-code = buf_doc-line.prod-code
     2779             no-error .
     2780             if not available temp-gds then next .
     2781             IF buf_doc-line.ext-doc-type = 'vt':U or buf_doc-line.ext-doc-type = 'vp':U THEN DO:
     2782               assign v-teh [ temp-gds.num ] = v-teh  [ temp-gds.num ] + ( IF buf_doc-line.cli-qnty = ? THEN 0 ELSE buf_doc-line.cli-qnty ).
     2783             end.
     2784             else do:
     2785               assign v-teh [ temp-gds.num ] = v-teh  [ temp-gds.num ] + buf_doc-line.fact-qnty .
     2786             end.
     2787           END.
     2788         END.
     2789       END.
     2790     end.
     2791   end procedure.
