      999   .
     1000   define temp-table temp_sheet1_line-data no-undo
     1001       field sheet-name    as character
     1002       field xl-line-id    as integer
     1003       field name   as character
     1004       field DT_l   as character
     1005       field DT_s   as character
     1006       field AI80_l as character
     1007       field AI80_s as character
     1008       field AI92_l as character
     1009       field AI92_s as character
