     2176     define variable v-sort-list as character no-undo .
     2177   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2178   empty temp-table thbjattr_thbj-attr.
     2179   run adm/shattri.p (
     2180      input "get":U
     2181     ,input ''
     2182     ,input 0
     2183     ,input 'report-glob':U
     2184     ,input  ""
     2185     ,output v-value-character
     2186     ,output v-value-date
