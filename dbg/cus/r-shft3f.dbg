     1898   procedure cp-attr-manual-edit :
     1899   do on error undo, return error return-value
     1900     :
     1901     define input  parameter p-code           as character no-undo .
     1902     define output parameter p-section-num    as integer no-undo .
     1903       case p-code :
     1904               when 'paycard-export-prefix':U then do:     assign     p-section-num = 1.   end.
     1905               when 'grp-code':U then do:     assign     p-section-num = 1.   end.
     1906               when 'is-use':U then do:     assign     p-section-num = 1.   end.
     1907               when 'dop-doc':U then do:     assign     p-section-num = 1.   end.
     1908               when 'paycard-all-prefix':U then do:     assign     p-section-num = 1.   end.
     1909               when 'form_km3':U then do:     assign     p-section-num = 1.   end.
     1910               when 'bal_malina':U then do:     assign     p-section-num = 1.   end.
     1911               when 'max_proc_sum':U then do:     assign     p-section-num = 1.   end.
     1912               when 'mask_card_kup':U then do:     assign     p-section-num = 1.   end.
     1913         otherwise do:
     1914           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1915         end.
     1916       end.
     1917     end.
     1918   end procedure.
     1919   procedure cp-attr-batch-edit :
     1920   do
     1921     on error undo, return error
     1922     :
     1923     define input  parameter p-code           as character no-undo .
