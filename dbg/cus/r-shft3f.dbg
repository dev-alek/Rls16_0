      611   procedure thbjattr_code :
      612      define input  parameter p-upper-code     as character no-undo .
      613      define input  parameter p-code           as character no-undo .
      614      define output parameter p-label          as character no-undo .
      615      define output parameter p-user-can-edit  as logical   no-undo .
      616      define output parameter p-output-display as logical   no-undo .
      617      define output parameter p-other          as character no-undo .
      618      define output parameter p-prop-list      as character no-undo .
      619      define output parameter p-prop-type-list as character no-undo .
      620      define output parameter p-prop-label-list as character no-undo .
      621      define output parameter p-global          as logical no-undo .
      622      define output parameter p-host           as logical no-undo .
      623      define output parameter p-shop           as logical no-undo .
      624      define output parameter p-store          as logical no-undo .
      625      define output parameter p-db             as logical no-undo .
      626      define variable p-region as logical no-undo.
      627      run thbjattr_code_reg in this-procedure (
      628                                               p-upper-code,
      629                                               p-code,
      630                                               output p-label,
      631                                               output p-user-can-edit,
      632                                               output p-output-display,
      633                                               output p-other,
      634                                               output p-prop-list,
      635                                               output p-prop-type-list,
      636                                               output p-prop-label-list,
      637                                               output p-global,
      638                                               output p-host,
      639                                               output p-shop,
      640                                               output p-store,
      641                                               output p-db,
      642                                               output p-region
      643                                               ).
      644   end procedure.
      645   procedure thbjattr_code_reg :
      646   define input  parameter p-upper-code     as character no-undo .
      647   define input  parameter p-code           as character no-undo .
      648   define output parameter p-label          as character no-undo .
      649   define output parameter p-user-can-edit  as logical   no-undo .
      650   define output parameter p-output-display as logical   no-undo .
      651   define output parameter p-other          as character no-undo .
      652   define output parameter p-prop-list      as character no-undo .
      653   define output parameter p-prop-type-list as character no-undo .
      654   define output parameter p-prop-label-list as character no-undo .
      655   define output parameter p-global          as logical no-undo .
      656   define output parameter p-host           as logical no-undo .
      657   define output parameter p-shop           as logical no-undo .
      658   define output parameter p-store          as logical no-undo .
      659   define output parameter p-db             as logical no-undo .
      660   define output parameter p-region         as logical no-undo .
      661   do
      662   on error undo, return error return-value
      663   :
      664       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      665       (input  p-upper-code
      666       ,input  p-code
      667       ,output p-label
      668       ,output p-user-can-edit
      669       ,output p-output-display
      670       ,output p-other
      671       ,output p-prop-list
      672       ,output p-prop-type-list
      673       ,output p-prop-label-list
      674       ,output p-global
      675       ,output p-host
      676       ,output p-shop
      677       ,output p-store
      678       ,output p-db
      679       ,output p-region
      680       ) no-error .
      681     if error-status :error
      682     then do:
      683       undo, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1)).
      684     end.
      685   end.
      686   end procedure.
