     1925       case p-code :
     1926               when 'paycard-export-prefix':U then do:     assign     p-section-num = 0.   end.
     1927               when 'grp-code':U then do:     assign     p-section-num = 0.   end.
     1928               when 'is-use':U then do:     assign     p-section-num = 0.   end.
     1929               when 'dop-doc':U then do:     assign     p-section-num = 0.   end.
     1930               when 'form_km3':U then do:     assign     p-section-num = 0.   end.
     1931               when 'bal_malina':U then do:     assign     p-section-num = 0.   end.
     1932               when 'max_proc_sum':U then do:     assign     p-section-num = 0.   end.
     1933               when 'mask_card_kup':U then do:     assign     p-section-num = 0.   end.
     1934         otherwise do:
     1935           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1936         end.
     1937       end.
     1938     end.
     1939   end procedure.
