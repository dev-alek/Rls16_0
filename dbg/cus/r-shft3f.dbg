     1023   define variable v-shift3xl-data-file-name       as character    no-undo.
     1024   procedure shift3xl-init :
     1025   do
     1026   on error undo, return error
     1027   :
     1028       assign
     1029           v-shift3xl-sheet1-cur-data-row = 0
     1030       .
     1031       run gbl/_tmpfile.p (
     1032             input "xd"
     1033           , input ".txt"
     1034           , output v-shift3xl-data-file-name
     1035       ).
     1036       output stream excel-line to value( v-shift3xl-data-file-name ).
     1037       run gbl/_tmpfile.p (
     1038             input "xc"
     1039           , input ".txt"
     1040           , output v-shift3xl-cell-file-name
     1041       ).
     1042       output stream excel-cell to value( v-shift3xl-cell-file-name ).
     1043       run shift3xl-write-cell-data in this-procedure (
     1044             input "sheetList":U
     1045           , input "Реализация":U
     1046       ).
     1047       run shift3xl-write-cell-data in this-procedure (
     1048             input "Реализация_valutCode":U
     1049           , input "0":U
     1050       ).
     1051       run shift3xl-write-cell-data in this-procedure (
     1052             input "Реализация_columnList":U
     1053           , input "name,DT_l,DT_s,AI80_l,AI80_s,AI92_l,AI92_s,AI95_l,AI95_s,AI98_l,AI98_s,SUG_l,SUG_s,all_l,all_s"
     1054       ).
     1055       run shift3xl-write-cell-data in this-procedure (
     1056             input "Реализация_columnType":U
     1057           , input "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     1058       ).
     1059       run shift3xl-write-cell-data in this-procedure (
     1060             input "Реализация_subtotalList":U
     1061           , input "":U
     1062       ).
     1063       run shift3xl-write-cell-data in this-procedure (
     1064             input "Реализация_subtotalType":U
     1065           , input "":U
     1066       ).
     1067   end.
     1068   end procedure.
     1069   procedure shift3xl-sheet1-write-line-data :
     1070   define input parameter p-name     as character        no-undo.
     1071   define input parameter p-DT_l     as character        no-undo.
     1072   define input parameter p-DT_s     as character        no-undo.
     1073   define input parameter p-AI80_l   as character        no-undo.
     1074   define input parameter p-AI80_s   as character        no-undo.
     1075   define input parameter p-AI92_l   as character        no-undo.
     1076   define input parameter p-AI92_s   as character        no-undo.
     1077   define input parameter p-AI95_l   as character        no-undo.
     1078   define input parameter p-AI95_s   as character        no-undo.
     1079   define input parameter p-AI98_l   as character        no-undo.
     1080   define input parameter p-AI98_s   as character        no-undo.
     1081   define input parameter p-SUG_l    as character        no-undo.
     1082   define input parameter p-SUG_s    as character        no-undo.
     1083   define input parameter p-all_l    as character        no-undo.
     1084   define input parameter p-all_s    as character        no-undo.
     1085       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     1086   do
     1087   for buf_temp_sheet1_line-data
     1088   on error undo, return error
     1089   :
     1090       for each buf_temp_sheet1_line-data
     1091       :
     1092           delete buf_temp_sheet1_line-data.
     1093       end.
     1094       create buf_temp_sheet1_line-data.
     1095       assign
     1096           v-shift3xl-sheet1-cur-data-row = v-shift3xl-sheet1-cur-data-row + 1
     1097           buf_temp_sheet1_line-data.sheet-name    = "Реализация":U
     1098           buf_temp_sheet1_line-data.xl-line-id    = v-shift3xl-sheet1-cur-data-row
     1099           buf_temp_sheet1_line-data.name    = p-name
     1100           buf_temp_sheet1_line-data.DT_l    = p-DT_l
     1101           buf_temp_sheet1_line-data.DT_s    = p-DT_s
     1102           buf_temp_sheet1_line-data.AI80_l  = p-AI80_l
     1103           buf_temp_sheet1_line-data.AI80_s  = p-AI80_s
     1104           buf_temp_sheet1_line-data.AI92_l  = p-AI92_l
     1105           buf_temp_sheet1_line-data.AI92_s  = p-AI92_s
     1106           buf_temp_sheet1_line-data.AI95_l  = p-AI95_l
     1107           buf_temp_sheet1_line-data.AI95_s  = p-AI95_s
     1108           buf_temp_sheet1_line-data.AI98_l  = p-AI98_l
     1109           buf_temp_sheet1_line-data.AI98_s  = p-AI98_s
     1110           buf_temp_sheet1_line-data.SUG_l   = p-SUG_l
     1111           buf_temp_sheet1_line-data.SUG_s   = p-SUG_s
     1112           buf_temp_sheet1_line-data.all_l   = p-all_l
     1113           buf_temp_sheet1_line-data.all_s   = p-all_s
     1114       .
     1115       put stream excel-line unformatted
     1116                           buf_temp_sheet1_line-data.sheet-name
     1117           CHR(9)   "DTA":U
     1118           CHR(9)   buf_temp_sheet1_line-data.name
     1119           CHR(9)   buf_temp_sheet1_line-data.DT_l
     1120           CHR(9)   buf_temp_sheet1_line-data.DT_s
     1121           CHR(9)   buf_temp_sheet1_line-data.AI80_l
     1122           CHR(9)   buf_temp_sheet1_line-data.AI80_s
     1123           CHR(9)   buf_temp_sheet1_line-data.AI92_l
     1124           CHR(9)   buf_temp_sheet1_line-data.AI92_s
     1125           CHR(9)   buf_temp_sheet1_line-data.AI95_l
     1126           CHR(9)   buf_temp_sheet1_line-data.AI95_s
     1127           CHR(9)   buf_temp_sheet1_line-data.AI98_l
     1128           CHR(9)   buf_temp_sheet1_line-data.AI98_s
     1129           CHR(9)   buf_temp_sheet1_line-data.SUG_l
     1130           CHR(9)   buf_temp_sheet1_line-data.SUG_s
     1131           CHR(9)   buf_temp_sheet1_line-data.all_l
     1132           CHR(9)   buf_temp_sheet1_line-data.all_s
     1133           chr(10)
     1134       .
     1135   end.
     1136   end procedure.
     1137   procedure shift3xl-write-cell-data :
     1138   define input parameter p-data-key   as character        no-undo.
     1139   define input parameter p-data-value as character        no-undo.
     1140       define buffer buf_temp_cell-data     for temp_cell-data.
     1141   do
     1142   for buf_temp_cell-data
     1143   on error undo, return error
     1144   :
     1145       find first buf_temp_cell-data
     1146            where buf_temp_cell-data.data-key = p-data-key
     1147       no-error.
     1148       if not available buf_temp_cell-data
     1149       then do:
     1150           create buf_temp_cell-data.
     1151           assign
     1152               buf_temp_cell-data.data-key = p-data-key
     1153           .
     1154       end.
     1155       assign
     1156           buf_temp_cell-data.data-value = p-data-value
     1157       .
     1158       put stream excel-cell unformatted
     1159                           buf_temp_cell-data.data-key
     1160           CHR(9)   buf_temp_cell-data.data-value
     1161           chr(10)
     1162       .
     1163   end.
     1164   end procedure.
     1165   procedure shift3xl-run-excel :
     1166   define input parameter p-header-filename    as character        no-undo.
     1167   define input parameter p-data-filename      as character        no-undo.
     1168       define variable v-template-file-name    as character    no-undo.
     1169       define variable v-vb-file-name          as character    no-undo.
     1170       define buffer buf_temp-param for temp-param .
     1171   do
     1172   for buf_temp-param
     1173   on error undo, return error
     1174   :
     1175       create buf_temp-param.
     1176       assign
     1177           v-template-file-name    = search( "exe/shift3.xlt" )
     1178           v-vb-file-name          = search( "exe/t_form.bas")
     1179       .
     1180       if v-template-file-name = ?
     1181       or v-template-file-name = "":U
     1182       then do:
     1183           message
     1184               "Ошибка имени файла шаблона."
     1185           view-as alert-box error.
     1186       end.
     1187       if v-vb-file-name = ?
     1188       or v-vb-file-name = "":U
     1189       then do:
     1190           message
     1191               "Ошибка имени файла кода обработки."
     1192           view-as alert-box error.
     1193       end.
     1194       run paramls-write in this-procedure (
     1195             input "template":U
     1196           , input "template-file-name":U
     1197           , input v-template-file-name
     1198       ).
     1199       run paramls-write in this-procedure (
     1200             input "template":U
     1201           , input "vb-file-name":U
     1202           , input v-vb-file-name
     1203       ).
     1204       run paramls-write in this-procedure (
     1205             input "data":U
     1206           , input "data-header-filename":U
     1207           , input p-header-filename
     1208       ).
     1209       run paramls-write in this-procedure (
     1210             input "data":U
     1211           , input "data-filename":U
     1212           , input p-data-filename
     1213       ).
     1214       run gbl/macroxlt.p (
     1215           input-output table buf_temp-param
     1216       ) no-error.
     1217       if error-status :error
     1218       then do:
     1219           message
     1220                    vss-workfile vss-revision vss-description
     1221               skip(1)
     1222               skip "Ошибка создания файла Excel."
     1223               skip return-value
     1224               skip trim(error-status :get-message(1))
     1225                    trim(error-status :get-message(2))
     1226                    trim(error-status :get-message(3))
     1227           view-as alert-box error.
     1228           undo, return error .
     1229       end.
     1230   end.
     1231   end procedure.
     1232   procedure shift3xl-close :
     1233   do
     1234   on error undo, return error
     1235   :
     1236       output stream excel-line close.
     1237       output stream excel-cell close.
     1238       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1239       export "exe/shift3.xlt":U.
     1240       export "exe/t_form.bas":U.
     1241       export v-shift3xl-cell-file-name.
     1242       export v-shift3xl-data-file-name.
     1243       output close.
     1244   end.
     1245   end procedure.
     1246   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   procedure cur-time :
     1249      define output parameter p-today as date      no-undo .
     1250      define output parameter p-time  as integer   no-undo .
     1251     do
     1252     on error undo, return error
     1253     :
     1254       define variable v-date1 as date      no-undo .
     1255       define variable v-date2 as date      no-undo .
     1256       define variable v-time  as integer   no-undo .
     1257       assign
     1258         v-date1 = today
     1259         v-time  = time
     1260         v-date2 = today
     1261       .
     1262       if v-date1 <> v-date2
     1263       then do:
     1264         assign
     1265           v-date1 = today
     1266           v-time  = v-time
     1267         .
     1268       end.
     1269       assign
     1270         p-today = v-date1
     1271         p-time  = v-time
     1272       .
     1273     end.
     1274   end.
     1275   function cur-time-date returns character
     1276   :
     1277     return string(today, '99/99/9999':U) .
     1278   end.
     1279   function cur-time-mjd returns decimal
     1280   :
     1281     define variable v-date as date      no-undo .
     1282     define variable v-time as integer   no-undo .
     1283     run cur-time in this-procedure
     1284       (output v-date
     1285       ,output v-time
     1286       ) .
     1287     return integer(v-date) - 2400002 + (v-time / 86400) .
     1288   end.
     1289   function cur-time-get-ending-index returns integer
     1290   (input p-number as integer
     1291   )
     1292   :
     1293     if p-number < 0
     1294     or p-number = ?
     1295     then do:
     1296       return 1 .
     1297     end.
     1298     define variable v-rest as integer   no-undo .
     1299     assign
     1300       p-number = p-number modulo 100
     1301     .
     1302     if p-number < 20
     1303     then do:
     1304       assign
     1305         v-rest = p-number
     1306       .
     1307     end.
     1308     else do:
     1309       assign
     1310         v-rest = p-number modulo 10
     1311       .
     1312     end.
     1313     case v-rest :
     1314       when 1
     1315       then do:
     1316         return 2 .
     1317       end.
     1318       when 2 or
     1319       when 3 or
     1320       when 4
     1321       then do:
     1322         return 3 .
     1323       end.
     1324       otherwise do:
     1325         return 1 .
     1326       end.
     1327     end case .
     1328   end.
     1329   procedure cur-time-mjd-to-date :
     1330      define input  parameter i-mjd-diff as decimal no-undo.
     1331      define output parameter o-Date     as date    no-undo.
     1332      define output parameter o-Time     as integer no-undo.
     1333      define variable v-day-number as integer   no-undo .
     1334      if    i-mjd-diff < 0
     1335         or i-mjd-diff = ?
     1336      then do:
     1337         return "?" .
     1338      end.
     1339      assign
     1340         v-day-number = truncate(i-mjd-diff,0).
     1341         o-Date = date(v-day-number + 2400002).
     1342         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1343     .
     1344   end.
     1345   function cur-time-mjd-to-string returns character
     1346   (input p-mjd-diff as decimal
     1347   )
     1348   :
     1349     define variable v-day-number as integer   no-undo .
     1350     define variable v-seconds    as integer   no-undo .
     1351     define variable v-hour       as integer   no-undo .
     1352     define variable v-min        as integer   no-undo .
     1353     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1354     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1355     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1356     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1357     if p-mjd-diff < 0
     1358     or p-mjd-diff = ?
     1359     then do:
     1360       return "?" .
     1361     end.
     1362     assign
     1363       v-day-number = integer(truncate(p-mjd-diff,0))
     1364       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1365     .
     1366     if v-seconds > 86400
     1367     then do:
     1368       assign
     1369         v-seconds = 86400 - 1
     1370       .
     1371     end.
     1372     if v-seconds < 0
     1373     then do:
     1374       assign
     1375         v-seconds = 0
     1376       .
     1377     end.
     1378     assign
     1379       v-hour = truncate(v-seconds / 3600, 0)
     1380     .
     1381     assign
     1382       v-seconds = v-seconds modulo 3600
     1383     .
     1384     assign
     1385       v-min = truncate(v-seconds / 60, 0)
     1386     .
     1387     assign
     1388       v-seconds = v-seconds modulo 60
     1389     .
     1390     return
     1391         (if v-day-number <> 0
     1392           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1393           else ""
     1394         )
     1395       + (if v-day-number <> 0 or v-hour <> 0
     1396           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1397           else ""
     1398         )
     1399       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1400           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1401           else ""
     1402         )
     1403       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1404       .
     1405   end.
     1406   function cur-time-string returns character
     1407   :
     1408     define variable v-date as date      no-undo .
     1409     define variable v-time as integer   no-undo .
     1410     run cur-time in this-procedure
     1411       (output v-date
     1412       ,output v-time
     1413       ) .
     1414     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1415   end.
     1416   function cur-time-string-sec returns character
     1417   :
     1418     define variable v-date as date      no-undo .
     1419     define variable v-time as integer   no-undo .
     1420     run cur-time in this-procedure
     1421       (output v-date
     1422       ,output v-time
     1423       ) .
     1424     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1425   end.
     1426   function cur-time-custom  returns character
     1427   (input p-prefix as character
     1428   ,input p-date-format as character
     1429   ,input p-delimiter as character
     1430   ,input p-time-format as character
     1431   ,input p-suffix as character
     1432   )
     1433   :
     1434     define variable v-date as date      no-undo .
     1435     define variable v-time as integer   no-undo .
     1436     run cur-time in this-procedure
     1437       (output v-date
     1438       ,output v-time
     1439       ) .
     1440     return
     1441       p-prefix
     1442       + string(v-date, p-date-format)
     1443       + p-delimiter
     1444       + string(v-time, p-time-format)
     1445       + p-suffix
     1446       .
     1447   end.
     1448   function cur-time-print  returns character
     1449   :
     1450     define variable v-date as date      no-undo .
     1451     define variable v-time as integer   no-undo .
     1452     run cur-time in this-procedure
     1453       (output v-date
     1454       ,output v-time
     1455       ) .
     1456     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1457   end.
     1458   function cur-time-datetime returns datetime
     1459   :
     1460     define variable v-char as character no-undo .
     1461     define variable v-datetime as datetime no-undo .
     1462     v-char = cur-time-string().
     1463     v-datetime = datetime(v-char).
     1464     return  v-datetime.
     1465   end.
     1466   function cur-time-string-msec returns character
     1467   :
     1468     define variable v-date as datetime  no-undo .
     1469     v-date = now.
     1470     return string(v-date) .
     1471   end.
     1472   procedure cp-attr-code :
     1473     do
     1474     on error undo, return error
     1475     :
     1476       define input  parameter p-code           as character no-undo .
     1477       define output parameter p-type           as character no-undo .
     1478       define output parameter p-format         as character no-undo .
     1479       define output parameter p-label          as character no-undo .
     1480       define output parameter p-range          as integer   no-undo .
     1481       define output parameter p-user-can-edit  as logical   no-undo .
     1482       define output parameter p-output-display as logical   no-undo .
     1483       define output parameter p-other          as character no-undo .
     1484       case p-code :
     1485               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1486               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     1487               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     1488               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     1489               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1490               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1491               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1492               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1493               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1494               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1495         otherwise do:
     1496           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1497         end.
     1498       end.
     1499     end.
     1500   end procedure.
     1501   procedure cp-attr-tooltip :
     1502     do
     1503     on error undo, return error
     1504     :
     1505       define input  parameter p-code    as character no-undo .
     1506       define output parameter p-tooltip as character no-undo .
     1507       define output parameter p-label   as character no-undo .
     1508       case p-code :
     1509               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     1510               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     1511               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     1512               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     1513               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     1514               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     1515               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     1516               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     1517               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     1518               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     1519         otherwise do:
     1520           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     1521         end.
     1522       end.
     1523     end.
     1524   end procedure.
     1525   procedure cp-attr-value :
     1526     do
     1527     on error undo, return error
     1528     :
     1529       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1530       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1531       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1532       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1533       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1534       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     1535       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     1536       define output parameter p-type        as character no-undo .
     1537       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1538       define variable v-format         as character no-undo .
     1539       define variable v-label          as character no-undo .
     1540       define variable v-range          as integer   no-undo .
     1541       define variable v-user-can-edit  as logical   no-undo .
     1542       define variable v-output-display as logical   no-undo .
     1543       define variable v-other          as character no-undo .
     1544       run cp-attr-code in this-procedure
     1545         (input  p-code
     1546         ,output p-type
     1547         ,output v-format
     1548         ,output v-label
     1549         ,output v-range
     1550         ,output v-user-can-edit
     1551         ,output v-output-display
     1552         ,output v-other
     1553         ) no-error .
     1554       if error-status :error then do:
     1555         undo, return error return-value .
     1556       end.
     1557       find first buf_cash-pay-attr no-lock
     1558         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1559           and buf_cash-pay-attr.curr-code  = p-curr-code
     1560           and buf_cash-pay-attr.host-code  = p-host-code
     1561           and buf_cash-pay-attr.obj-type   = p-obj-type
     1562           and buf_cash-pay-attr.obj-code   = p-obj-code
     1563           and buf_cash-pay-attr.attr-code  = p-code
     1564         no-error .
     1565       if avail buf_cash-pay-attr then do:
     1566         assign
     1567           p-value =  buf_cash-pay-attr.attr-value
     1568         .
     1569       end.
     1570       else do:
     1571         assign
     1572           p-value = if p-type = 'L':U then "no":U else ""
     1573         .
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure cp-attr-write :
     1578     do
     1579     on error undo, return error
     1580     :
     1581       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1582       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1583       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1584       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1585       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1586       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1587       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     1588       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1589       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     1590       define variable v-type           as character no-undo .
     1591       define variable v-format         as character no-undo .
     1592       define variable v-label          as character no-undo .
     1593       define variable v-range          as integer   no-undo .
     1594       define variable v-user-can-edit  as logical   no-undo .
     1595       define variable v-output-display as logical   no-undo .
     1596       define variable v-other          as character no-undo .
     1597       run cp-attr-code in this-procedure
     1598         (input  p-code
     1599         ,output v-type
     1600         ,output v-format
     1601         ,output v-label
     1602         ,output v-range
     1603         ,output v-user-can-edit
     1604         ,output v-output-display
     1605         ,output v-other
     1606         ) no-error .
     1607       if error-status :error then do:
     1608         undo, return error return-value .
     1609       end.
     1610       find first buf_cash-pay-attr exclusive-lock
     1611         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1612           and buf_cash-pay-attr.curr-code  = p-curr-code
     1613           and buf_cash-pay-attr.host-code  = p-host-code
     1614           and buf_cash-pay-attr.obj-type   = p-obj-type
     1615           and buf_cash-pay-attr.obj-code   = p-obj-code
     1616           and buf_cash-pay-attr.attr-code = p-code
     1617         no-error .
     1618       if not available buf_cash-pay-attr then do:
     1619         create buf_cash-pay-attr .
     1620         assign
     1621         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1622         buf_cash-pay-attr.curr-code  = p-curr-code
     1623         buf_cash-pay-attr.host-code  = p-host-code
     1624         buf_cash-pay-attr.obj-type   = p-obj-type
     1625         buf_cash-pay-attr.obj-code   = p-obj-code
     1626         buf_cash-pay-attr.attr-code = p-code
     1627         .
     1628       end.
     1629       assign
     1630         buf_cash-pay-attr.attr-value = p-value
     1631       .
     1632       release buf_cash-pay-attr no-error .
     1633       if error-status:error then do:
     1634         undo, return error return-value .
     1635       end.
     1636     end.
     1637   end procedure.
     1638   procedure cp-attr-exist :
     1639     do
     1640     on error undo, return error
     1641     :
     1642       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1643       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1644       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1645       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1646       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1647       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1648       define output parameter p-exist   as logical  no-undo .
     1649       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1650       define variable v-type           as character no-undo .
     1651       define variable v-format         as character no-undo .
     1652       define variable v-label          as character no-undo .
     1653       define variable v-range          as integer   no-undo .
     1654       define variable v-user-can-edit  as logical   no-undo .
     1655       define variable v-output-display as logical   no-undo .
     1656       define variable v-other          as character no-undo .
     1657       run cp-attr-code in this-procedure
     1658         (input  p-code
     1659         ,output v-type
     1660         ,output v-format
     1661         ,output v-label
     1662         ,output v-range
     1663         ,output v-user-can-edit
     1664         ,output v-output-display
     1665         ,output v-other
     1666         ) no-error .
     1667       if error-status :error then do:
     1668         undo, return error return-value .
     1669       end.
     1670       find first buf_cash-pay-attr exclusive-lock
     1671         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1672           and buf_cash-pay-attr.curr-code  = p-curr-code
     1673           and buf_cash-pay-attr.host-code  = p-host-code
     1674           and buf_cash-pay-attr.obj-type   = p-obj-type
     1675           and buf_cash-pay-attr.obj-code   = p-obj-code
     1676           and buf_cash-pay-attr.attr-code = p-code
     1677         no-error .
     1678       if  available buf_cash-pay-attr then do:
     1679         p-exist = yes.
     1680       end.
     1681     end.
     1682   end procedure.
     1683   procedure cp-attr-delete :
     1684     do
     1685     on error undo, return error
     1686     :
     1687       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1688       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1689       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1690       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1691       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1692       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1693       define output parameter p-deleted  as logical no-undo.
     1694       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1695       define variable v-type           as character no-undo .
     1696       define variable v-format         as character no-undo .
     1697       define variable v-label          as character no-undo .
     1698       define variable v-range          as integer   no-undo .
     1699       define variable v-user-can-edit  as logical   no-undo .
     1700       define variable v-output-display as logical   no-undo .
     1701       define variable v-other          as character no-undo .
     1702       run cp-attr-code in this-procedure
     1703         (input  p-code
     1704         ,output v-type
     1705         ,output v-format
     1706         ,output v-label
     1707         ,output v-range
     1708         ,output v-user-can-edit
     1709         ,output v-output-display
     1710         ,output v-other
     1711         ) no-error .
     1712       if error-status :error then do:
     1713         undo, return error return-value .
     1714       end.
     1715       find first buf_cash-pay-attr exclusive-lock
     1716         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1717           and buf_cash-pay-attr.curr-code  = p-curr-code
     1718           and buf_cash-pay-attr.host-code  = p-host-code
     1719           and buf_cash-pay-attr.obj-type   = p-obj-type
     1720           and buf_cash-pay-attr.obj-code   = p-obj-code
     1721           and buf_cash-pay-attr.attr-code = p-code
     1722         no-error NO-WAIT.
     1723       if not available buf_cash-pay-attr then do:
     1724         p-deleted = no.
     1725       end.
     1726       else do:
     1727         delete buf_cash-pay-attr no-error .
     1728         if error-status:error then do:
     1729           undo, return error return-value .
     1730         end.
     1731         p-deleted = yes.
     1732       end.
     1733     end.
     1734   end procedure.
     1735   procedure cp-attr-news :
     1736     do
     1737     on error undo, return error
     1738     :
     1739       define input  parameter p-code           as character no-undo .
     1740       define output parameter p-news           as logical   no-undo .
     1741       case p-code :
     1742               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1743               when 'grp-code':U then do:     assign     p-news = true.   end.
     1744               when 'is-use':U then do:     assign     p-news = true.   end.
     1745               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1746               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1747               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1748               when 'form_km3':U then do:     assign     p-news = false.   end.
     1749               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1750               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1751               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1752         otherwise do:
     1753           p-news = no.
     1754         end.
     1755       end.
     1756     end.
     1757   end procedure.
     1758   procedure cp-attr-hist :
     1759     do
     1760     on error undo, return error
     1761     :
     1762       define input  parameter p-code           as character no-undo .
     1763       define output parameter p-hist           as logical   no-undo .
     1764       case p-code :
     1765               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
     1766               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1767               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1768               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1769               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1770               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1771               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1772         otherwise do:
     1773           p-hist = no.
     1774         end.
     1775       end.
     1776     end.
     1777   end procedure.
     1778   procedure paycard-prefix :
     1779   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
     1780   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
     1781   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
     1782   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
     1783   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
     1784   define input-output parameter p-value as character no-undo .
     1785   define output parameter p-setted as logical no-undo .
     1786   DEFINE VARIABLE v-value as character no-undo .
     1787   define variable v-codes as character no-undo .
     1788   define variable v-labels as character no-undo .
     1789   define variable v-ok as logical no-undo .
     1790     do
     1791     on error undo, return error
     1792     :
     1793       assign
     1794       v-value = p-value
     1795       .
     1796       run ref/cpa-pcep.w (
     1797                      input parparentproc
     1798                     ,input p-cdpay-code
     1799                     ,input p-curr-code
     1800                     ,input p-host-code
     1801                     ,input p-obj-type
     1802                     ,input p-obj-code
     1803                     ,input-output v-value
     1804                     ,output v-ok
     1805                      ) no-error .
     1806       if
     1807       v-ok and
     1808       p-value <> v-value and v-value <> ? and not error-status:error then do:
     1809         assign
     1810         p-setted = yes
     1811         p-value = v-value
     1812         .
     1813       end.
     1814     end.
     1815   end procedure.
     1816   procedure is-use :
     1817   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
     1818   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
     1819   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
     1820   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
     1821   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
     1822   define input-output parameter p-value as character no-undo .
     1823   define output parameter p-setted as logical no-undo .
     1824   DEFINE VARIABLE v-value as character no-undo .
     1825   define variable v-codes as character no-undo .
     1826   define variable v-labels as character no-undo .
     1827   define variable v-ok as logical no-undo .
     1828     do
     1829     on error undo, return error
     1830     :
     1831       assign
     1832       v-value = p-value
     1833       .
     1834       if p-obj-type = 'скл':U then do:
     1835         message
     1836         substitute("Нельзя задать атрибут для объекта типа &1", p-obj-type)
     1837         view-as alert-box error .
     1838         return error.
     1839       end.
     1840       run ref/cpa-isus.w (
     1841                      input parparentproc
     1842                     ,input p-cdpay-code
     1843                     ,input p-curr-code
     1844                     ,input p-host-code
     1845                     ,input p-obj-type
     1846                     ,input p-obj-code
     1847                     ,input-output v-value
     1848                     ,output v-ok
     1849                      ) no-error .
     1850       if
     1851       v-ok and
     1852       p-value <> v-value and v-value <> ? and not error-status:error then do:
     1853         assign
     1854         p-setted = yes
     1855         p-value = v-value
     1856         .
     1857       end.
     1858     end.
     1859   end procedure.
     1860   procedure grp-code :
     1861   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
     1862   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
     1863   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
     1864   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
     1865   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
     1866   define input-output parameter p-value as character no-undo .
     1867   define output parameter p-setted as logical no-undo .
