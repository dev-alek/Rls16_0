        1   define temp-table tt_doc-line no-undo like ub.doc-line.
        2   define input parameter parparentproc  as widget-handle no-undo.
        3   define input parameter p-mode         as character no-undo.
        4   define input parameter p-doc-code as character no-undo .
        5   define input parameter p-gds-code as int no-undo .
        6   define input  parameter table for tt_doc-line .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-Workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список накладных одного товара по заказу" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define buffer buf_goods for ub.goods.
      128   define buffer buf_trn-doc for ub.trn-doc  .
      129   define buffer buf_clients for ub.clients  .
      130   DEFINE BUTTON B-exit AUTO-GO
      131        LABEL "&Ввод"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON B-Help
      135        LABEL "&Help"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON B-print
      139        LABEL "&Печать"
      140        SIZE 10 BY 1
      141        BGCOLOR 8 .
      142   DEFINE BUTTON B-quit AUTO-END-KEY
      143        LABEL "&Отмена"
      144        SIZE 10 BY 1
      145        BGCOLOR 8 .
      146   DEFINE BUTTON B-trn
      147        LABEL "&Накладная"
      148        SIZE 12 BY 1 TOOLTIP "Просмотр Накладной"
      149        BGCOLOR 8 .
      150   DEFINE VARIABLE v-goods AS CHARACTER FORMAT "X(256)":U
      151        LABEL "Товар"
      152         VIEW-AS TEXT
      153        SIZE 90.5 BY .67
      154        FGCOLOR 1  NO-UNDO.
      155   DEFINE QUERY BROWSE-3 FOR
      156         tt_doc-line,
      157         buf_trn-doc,
      158         buf_clients SCROLLING.
      159   DEFINE BROWSE BROWSE-3
      160     QUERY BROWSE-3 NO-LOCK DISPLAY
      161         tt_doc-line.doc-code COLUMN-LABEL "N накладной" FORMAT "X(16)":U
      162         buf_trn-doc.status_ + string(buf_trn-doc.flag_,"+/-") COLUMN-LABEL "Статус" FORMAT "X(7)":U
      163         tt_doc-line.fact-qnty  COLUMN-LABEL "По накладным" FORMAT "->>>,>>>,>>>,>>9.999":U
      164         buf_clients.obj-type + string (buf_clients.obj-code) COLUMN-LABEL "Код" FORMAT "X(10)":U
      165         buf_clients.obj-name  COLUMN-LABEL "Поставщик" FORMAT "X(10)":U
      166         buf_trn-doc.ship-date COLUMN-LABEL "Доставка" FORMAT "99/99/99":U
      167         buf_trn-doc.fact-date COLUMN-LABEL "Факт" FORMAT "99/99/99":U
      168         string(buf_trn-doc.fact-time,"hh:mm") COLUMN-LABEL "Время-факт" FORMAT "X(5)":U
      169       WITH NO-ROW-MARKERS SEPARATORS SIZE 99.25 BY 10.75 FIT-LAST-COLUMN.
      170   DEFINE FRAME Dialog-Frame
      171        B-exit AT ROW 1 COL 1
      172        B-quit AT ROW 1 COL 11
      173        B-trn AT ROW 1 COL 21 WIDGET-ID 52
      174        B-print AT ROW 1 COL 80 WIDGET-ID 56
      175        B-Help AT ROW 1 COL 90
      176        BROWSE-3 AT ROW 3 COL 1 WIDGET-ID 200
      177        v-goods AT ROW 2.25 COL 7.5 COLON-ALIGNED WIDGET-ID 58
      178        SPACE(0.25) SKIP(12.03)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "Список накладных товара по заказу"
      182            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      183   ASSIGN
      184          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      185          FRAME Dialog-Frame:HIDDEN           = TRUE.
      186   ON GO OF FRAME Dialog-Frame
      187   DO:
      188     run save-proc in this-procedure no-error.
      189     if error-status :error then return no-apply.
      190   END.
      191   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      192   DO:
      193     APPLY "END-ERROR":U TO SELF.
      194   END.
      195   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      196   DO:
      197     if not available tt_doc-line then return no-apply.
      198   END.
      199   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
      200   DO:
      201     define buffer buf_doc-line for ub.doc-line  .
      202     if not available tt_doc-line then return no-apply.
      203     find first buf_trn-doc no-lock where
      204                buf_trn-doc.doc-code  = tt_doc-line.doc-code
      205                 no-error .
      206     find first buf_doc-line no-lock where
      207                buf_doc-line.doc-code  = tt_doc-line.doc-code  and
      208                buf_doc-line.artic  = tt_doc-line.artic        and
      209                buf_doc-line.prod-type = tt_doc-line.prod-type        and
      210                buf_doc-line.prod-code = tt_doc-line.prod-code
      211                no-error .
      212     if not available buf_trn-doc then return no-apply.
      213     run str/trn-lkp.p (input parParentProc, input recid(buf_trn-doc) , input  recid(buf_doc-line) ) .
      214   END.
      215   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      216   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      217   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      218   on help of frame Dialog-Frame
      219   do:
      220     run gbl/app_help.p
      221       (input this-procedure :file-name
      222       ,input ''
      223       ,input ?
      224       ) no-error.
      225     if error-status :error then do:
      226       message
      227         "Ошибка при вызове помощи"
      228         error-status :get-message(1)
      229         view-as alert-box .
      230     end.
      231   end.
      232   run minbtn-set in this-procedure .
      233   on choose of b-help in frame Dialog-Frame
      234   do:
      235     apply "help":u to frame Dialog-Frame .
      236   end.
      237   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   procedure minbtn-set :
      239       do
      240           on error undo, return error return-value
      241           :
      242           define variable ii              as integer       no-undo .
      243           define variable fh              as widget-handle no-undo .
      244           define variable hh              as widget-handle no-undo .
      245           define variable v-h             as handle        extent 4 no-undo .
      246           define variable v-name-button   as character     no-undo .
      247           define variable v-help-old-x    as decimal       no-undo .
      248           define variable v-help-old-y    as decimal       no-undo .
      249           define variable v-help-old-size as decimal       no-undo .
      250           define variable v-frame-width   as decimal       no-undo .
      251           define variable jj              as integer       no-undo .
      252           do
      253               on error undo, return error
      254               :
      255               assign
      256                   v-frame-width = frame Dialog-Frame:width - 0.3
      257                   fh            = frame Dialog-Frame:first-child
      258                   hh            = fh:first-child
      259                   ii            = 1
      260                   .
      261               do while valid-handle(hh):
      262                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      263                   do:
      264                       case lc(hh:name) :
      265                           when "b-help" then
      266                               do:
      267                                   hh:load-image-up("cmp/b-help.bmp":u) .
      268                                   hh:load-image-down("cmp/b-help.bmp":u) .
      269                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      270                                   hh:TOOLTIP = "Помощь" .
      271                                   v-help-old-x = hh:column .
      272                                   v-help-old-y = hh:row    .
      273                                   v-help-old-size = hh:width .
      274                                   hh:width-chars = 2.5 .
      275                               end.
      276                           when "b-print" then
      277                               do:
      278                                   hh:load-image("cmp/b-print.bmp":u) .
      279                                   hh:TOOLTIP = "Печать" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-history" or
      285                           when "b-hist" then
      286                               do:
      287                                   hh:load-image("cmp/b-hist.bmp":u) .
      288                                   hh:TOOLTIP = "История" .
      289                                   v-h[ii] = hh:handle .
      290                                   ii = ii + 1 .
      291                                   hh:width-chars = 3 .
      292                               end.
      293                           when "b-sch" then
      294                               do:
      295                                   hh:load-image("cmp/b-sch.bmp":u) .
      296                                   hh:TOOLTIP = "Установка Фильтра" .
      297                                   v-h[ii] = hh:handle .
      298                                   ii = ii + 1 .
      299                                   hh:width-chars = 3 .
      300                               end.
      301                           when "b-hist-user" then
      302                               do:
      303                                   hh:load-image("cmp/b-hist.bmp":u) .
      304                                   hh:TOOLTIP = "История пользователя" .
      305                                   ii = ii + 1 .
      306                               end.
      307                       end case.
      308                   end.
      309                   hh = hh:next-sibling.
      310               end.
      311               b-help:column = v-frame-width - b-help:width-chars.
      312               jj = 0.
      313               repeat ii = 4 to 1 by -1 :
      314                   if valid-handle (v-h[ii] ) then
      315                   do:
      316                       jj  = jj + 1 .
      317                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      318                       v-h[ii]:row    = v-help-old-y .
      319                   end.
      320               end.
      321           end.
      322       end.
      323   end procedure.
      324   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      325   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      326   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      327   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      328   define variable v-diasize-current-frame-width  as decimal   no-undo .
      329   define variable v-diasize-current-frame-height as decimal   no-undo .
      330   define variable v-diasize-change-size          as logical   no-undo .
      331   define variable v-diasize-resize-button        as handle    no-undo .
      332   define variable v-diasize-wndmax               as logical   no-undo .
      333   define variable v-diasize-wndstore             as logical   no-undo .
      334   define variable v-diasize-proc-name            as character no-undo .
      335   define variable v-diasize-browse-handle        as handle    no-undo .
      336   define variable v-diasize-browse-number        as integer   no-undo .
      337   define variable v-diasize-need-full-display    as logical   no-undo init false .
      338   define temp-table temp-diasize-handle no-undo
      339     field handle-value  as handle
      340     field save-position as decimal
      341     index xpk is primary unique handle-value
      342     .
      343   define temp-table temp-browse-handle no-undo
      344     field browse-type   as character
      345     field browse-number as integer
      346     field browse-handle as handle
      347     field original-size as decimal
      348     index xpk is primary unique browse-type browse-number
      349     index xie browse-type browse-handle
      350   .
      351   procedure diasize_change-height :
      352     define input  parameter p-change-value  as decimal   no-undo .
      353     define input  parameter p-move-resize   as logical   no-undo .
      354     define variable v-field-group-handle    as handle    no-undo .
      355     define variable v-object-handle         as handle    no-undo .
      356     define variable v-frame-height          as decimal   no-undo .
      357     define variable v-frame-virtual-height  as decimal   no-undo .
      358     define variable v-browse-height         as decimal   no-undo .
      359     define variable v-window-height         as decimal   no-undo .
      360     define variable v-window-virtual-height as decimal   no-undo .
      361     define variable v-change-sign           as integer   no-undo .
      362     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      363     define buffer buf_temp-browse-handle  for temp-browse-handle .
      364     if p-change-value > 0
      365     then do:
      366       if frame Dialog-Frame :height + p-change-value
      367           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      368       then do:
      369         assign
      370           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      371                           - (frame Dialog-Frame :height-chars)
      372         .
      373         if p-change-value <= 0
      374         then do:
      375           run diasize_position-resize-button in this-procedure .
      376           return .
      377         end.
      378       end.
      379     end.
      380     if p-change-value < 0
      381     then do:
      382       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      383       then do:
      384         assign
      385           p-change-value = v-diasize-orig-frame-height
      386                          - (frame Dialog-Frame :height-chars)
      387         .
      388         if p-change-value >= 0
      389         then do:
      390           run diasize_position-resize-button in this-procedure .
      391           return .
      392         end.
      393       end.
      394     end.
      395     if p-change-value >= 0
      396     then do:
      397       assign
      398         v-change-sign = 1
      399       .
      400     end.
      401     else do:
      402       assign
      403         v-change-sign = -1
      404       .
      405     end.
      406     assign
      407       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      408     .
      409     if p-change-value = 0
      410     then do:
      411       run diasize_position-resize-button in this-procedure .
      412       return .
      413     end.
      414     move_block:
      415     do
      416     on error undo move_block, retry move_block
      417     :
      418       if retry
      419       then do:
      420         do
      421         on error undo move_block, leave move_block
      422         :
      423           if p-change-value > 0
      424           then do:
      425             for each buf_temp-diasize-handle
      426             on error undo, next
      427             :
      428               assign
      429                 v-object-handle = buf_temp-diasize-handle.handle-value
      430               .
      431               if v-object-handle <> v-diasize-resize-button
      432               then do:
      433                 assign
      434                   v-object-handle :row = buf_temp-diasize-handle.save-position
      435                 .
      436               end.
      437             end.
      438             assign
      439               v-diasize-browse-handle :height = v-browse-height
      440             .
      441             for each buf_temp-browse-handle
      442               where buf_temp-browse-handle.browse-type = 'height':u
      443             on error undo, next
      444             :
      445               assign
      446                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      447               .
      448             end.
      449             assign
      450               frame Dialog-Frame :height = v-frame-height
      451             .
      452             if frame Dialog-Frame :scrollable = true
      453             then do:
      454               assign
      455                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      456               .
      457             end.
      458             run diasize_position-resize-button in this-procedure .
      459           end.
      460           else do:
      461             if frame Dialog-Frame :scrollable = true
      462             then do:
      463               assign
      464                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      465               .
      466             end.
      467             assign
      468               frame Dialog-Frame :height = v-frame-height
      469             .
      470             assign
      471               v-diasize-browse-handle :height = v-browse-height
      472             .
      473             for each buf_temp-browse-handle
      474               where buf_temp-browse-handle.browse-type = 'height':u
      475             on error undo, next
      476             :
      477               assign
      478                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      479               .
      480             end.
      481             for each buf_temp-diasize-handle
      482             on error undo, next
      483             :
      484               assign
      485                 v-object-handle = buf_temp-diasize-handle.handle-value
      486               .
      487               if v-object-handle <> v-diasize-resize-button
      488               then do:
      489                 assign
      490                   v-object-handle :row = buf_temp-diasize-handle.save-position
      491                 .
      492               end.
      493             end.
      494             run diasize_position-resize-button in this-procedure .
      495           end.
      496           assign
      497             v-diasize-change-size = false
      498           .
      499           leave move_block .
      500         end.
      501       end.
      502       assign
      503         v-diasize-need-full-display = true
      504       .
      505       if v-diasize-change-size = false
      506       then do:
      507         assign
      508           v-diasize-change-size = true
      509         .
      510       end.
      511       else do:
      512         return .
      513       end.
      514       assign
      515         v-frame-height = frame Dialog-Frame :height
      516         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      517         v-browse-height = v-diasize-browse-handle :height
      518       .
      519       for each buf_temp-browse-handle
      520         where buf_temp-browse-handle.browse-type = 'height':u
      521       :
      522         assign
      523           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      524         .
      525       end.
      526       for each buf_temp-diasize-handle
      527       :
      528         delete buf_temp-diasize-handle .
      529       end.
      530       assign
      531         v-field-group-handle = frame Dialog-Frame :first-child
      532       .
      533       do while valid-handle(v-field-group-handle)
      534       :
      535         assign
      536           v-object-handle = v-field-group-handle :first-child
      537         .
      538         do while valid-handle(v-object-handle)
      539         :
      540           if  v-object-handle <> v-diasize-browse-handle :handle
      541           and can-query(v-object-handle, "row")
      542           and can-query(v-object-handle, "height")
      543           and ( v-object-handle :row > v-diasize-browse-handle :row )
      544           then do:
      545             find first buf_temp-browse-handle
      546               where buf_temp-browse-handle.browse-type   = 'height':u
      547                 and buf_temp-browse-handle.browse-handle = v-object-handle
      548               no-error .
      549             if available buf_temp-browse-handle
      550             then do:
      551             end.
      552             else do:
      553               create buf_temp-diasize-handle .
      554               assign
      555                 buf_temp-diasize-handle.handle-value  = v-object-handle
      556                 buf_temp-diasize-handle.save-position = v-object-handle :row
      557               .
      558             end.
      559           end.
      560           assign
      561             v-object-handle = v-object-handle :next-sibling
      562           .
      563         end.
      564         assign
      565           v-field-group-handle = v-field-group-handle :next-sibling
      566         .
      567       end.
      568       do with frame Dialog-Frame
      569       :
      570         hide v-diasize-resize-button .
      571         assign
      572           v-diasize-resize-button :row    = 1
      573           v-diasize-resize-button :column = 1
      574         .
      575       end.
      576       if p-change-value > 0
      577       then do:
      578         if frame Dialog-Frame :scrollable = true
      579         then do:
      580           assign
      581             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      582             no-error .
      583           if error-status :error
      584           or error-status :get-message(1) <> ""
      585           then do:
      586             undo move_block, retry move_block .
      587           end.
      588         end.
      589         assign
      590           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      591           no-error .
      592         if error-status :error
      593         or error-status :get-message(1) <> ""
      594         then do:
      595           undo move_block, retry move_block .
      596         end.
      597         assign
      598           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      599           no-error .
      600         if error-status :error
      601         or error-status :get-message(1) <> ""
      602         then do:
      603           undo move_block, retry move_block .
      604         end.
      605         for each buf_temp-browse-handle
      606           where buf_temp-browse-handle.browse-type = 'height':u
      607         on error undo move_block, retry move_block
      608         :
      609           assign
      610             buf_temp-browse-handle.browse-handle :height
      611               = buf_temp-browse-handle.browse-handle :height + p-change-value
      612             no-error .
      613           if error-status :error
      614           or error-status :get-message(1) <> ""
      615           then do:
      616             undo move_block, retry move_block .
      617           end.
      618         end.
      619         for each buf_temp-diasize-handle
      620         on error undo move_block, retry move_block
      621         :
      622           assign
      623             v-object-handle = buf_temp-diasize-handle.handle-value
      624           .
      625           if v-object-handle <> v-diasize-resize-button
      626           then do:
      627             assign
      628               v-object-handle :row = v-object-handle :row + p-change-value
      629               no-error .
      630             if error-status :error
      631             or error-status :get-message(1) <> ""
      632             then do:
      633               undo move_block, retry move_block .
      634             end.
      635           end.
      636         end.
      637       end.
      638       else do:
      639         for each buf_temp-diasize-handle
      640         on error undo move_block, retry move_block
      641         :
      642           assign
      643             v-object-handle = buf_temp-diasize-handle.handle-value
      644           .
      645           if v-object-handle <> v-diasize-resize-button
      646           then do:
      647             assign
      648               v-object-handle :row = v-object-handle :row + p-change-value
      649               no-error .
      650             if error-status :error
      651             or error-status :get-message(1) <> ""
      652             then do:
      653               undo move_block, retry move_block .
      654             end.
      655           end.
      656         end.
      657         assign
      658           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      659           no-error .
      660         if error-status :error
      661         or error-status :get-message(1) <> ""
      662         then do:
      663           undo move_block, retry move_block .
      664         end.
      665         for each buf_temp-browse-handle
      666           where buf_temp-browse-handle.browse-type = 'height':u
      667         on error undo move_block, retry move_block
      668         :
      669           assign
      670             buf_temp-browse-handle.browse-handle :height
      671               = buf_temp-browse-handle.browse-handle :height + p-change-value
      672             no-error .
      673           if error-status :error
      674           or error-status :get-message(1) <> ""
      675           then do:
      676             undo move_block, retry move_block .
      677           end.
      678         end.
      679         assign
      680           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      681           no-error .
      682         if error-status :error
      683         or error-status :get-message(1) <> ""
      684         then do:
      685           undo move_block, retry move_block .
      686         end.
      687         if frame Dialog-Frame :scrollable = true
      688         then do:
      689           assign
      690             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      691             no-error .
      692           if error-status :error
      693           or error-status :get-message(1) <> ""
      694           then do:
      695             undo move_block, retry move_block .
      696           end.
      697         end.
      698       end.
      699       if p-move-resize = true
      700       then do:
      701         run diasize_position-resize-button in this-procedure .
      702       end.
      703       if v-diasize-wndstore = true
      704       then do:
      705         if connected("ub") = true
      706         then do:
      707           define variable v-cntxt-db-num        as integer   no-undo .
      708           define variable v-cntxt-userid        as character no-undo .
      709           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      710                                             , OUTPUT v-cntxt-userid
      711                                             ) .
      712           run gbl/wndsizew.p
      713             (input  v-cntxt-db-num
      714             ,input  v-cntxt-userid
      715             ,input  v-diasize-proc-name
      716             ,input  'height':u
      717             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      718             ) .
      719         end.
      720       end.
      721     end.
      722     assign
      723       v-diasize-change-size = false
      724     .
      725   end procedure.
      726   procedure diasize_set-height :
      727     define input  parameter p-new-height  as decimal   no-undo .
      728     define input  parameter p-move-resize as logical   no-undo .
      729     do
      730     on error undo, return error return-value
      731     :
      732       run diasize_change-height in this-procedure
      733         (input  (p-new-height - frame Dialog-Frame :height)
      734         ,input  p-move-resize
      735         ) .
      736     end.
      737   end procedure.
      738   procedure diasize_change-width :
      739     define input  parameter p-change-value as decimal   no-undo .
      740     define input  parameter p-move-resize  as logical   no-undo .
      741     define variable v-field-group-handle   as handle    no-undo .
      742     define variable v-object-handle        as handle    no-undo .
      743     define variable v-frame-width          as decimal   no-undo .
      744     define variable v-frame-virtual-width  as decimal   no-undo .
      745     define variable v-browse-width         as decimal   no-undo .
      746     define variable v-window-width         as decimal   no-undo .
      747     define variable v-window-virtual-width as decimal   no-undo .
      748     define variable v-change-sign          as integer   no-undo .
      749     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      750     define buffer buf_temp-browse-handle  for temp-browse-handle .
      751     if p-change-value > 0
      752     then do:
      753       if frame Dialog-Frame :width + p-change-value >
      754           session :width-chars
      755       then do:
      756         assign
      757           p-change-value = session :width-chars - frame Dialog-Frame :width
      758         .
      759         if p-change-value <= 0
      760         then do:
      761           run diasize_position-resize-button in this-procedure .
      762           return .
      763         end.
      764       end.
      765     end.
      766     if p-change-value < 0
      767     then do:
      768       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      769       then do:
      770         assign
      771           p-change-value = v-diasize-orig-frame-width
      772                          - frame Dialog-Frame :width
      773         .
      774         if p-change-value >= 0
      775         then do:
      776           run diasize_position-resize-button in this-procedure .
      777           return .
      778         end.
      779       end.
      780     end.
      781     if p-change-value >= 0
      782     then do:
      783       assign
      784         v-change-sign = 1
      785       .
      786     end.
      787     else do:
      788       assign
      789         v-change-sign = -1
      790       .
      791     end.
      792     assign
      793       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      794     .
      795     if p-change-value = 0
      796     then do:
      797       run diasize_position-resize-button in this-procedure .
      798       return .
      799     end.
      800     move_block:
      801     do
      802     on error undo move_block, leave move_block
      803     :
      804       if retry
      805       then do:
      806         do
      807         on error undo move_block, leave move_block
      808         :
      809           if p-change-value > 0
      810           then do:
      811             for each buf_temp-diasize-handle
      812             on error undo, next
      813             :
      814               assign
      815                 v-object-handle = buf_temp-diasize-handle.handle-value
      816               .
      817               if v-object-handle <> v-diasize-resize-button
      818               then do:
      819                 assign
      820                   v-object-handle :col = buf_temp-diasize-handle.save-position
      821                 .
      822               end.
      823             end.
      824             assign
      825               v-diasize-browse-handle :width = v-browse-width
      826             .
      827             for each buf_temp-browse-handle
      828               where buf_temp-browse-handle.browse-type = 'width':u
      829             on error undo, next
      830             :
      831               assign
      832                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      833               .
      834             end.
      835             assign
      836               frame Dialog-Frame :width = v-frame-width
      837             .
      838             if frame Dialog-Frame :scrollable = true
      839             then do:
      840               assign
      841                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      842               .
      843             end.
      844             run diasize_position-resize-button in this-procedure .
      845           end.
      846           else do:
      847             if frame Dialog-Frame :scrollable = true
      848             then do:
      849               assign
      850                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      851               .
      852             end.
      853             assign
      854               frame Dialog-Frame :width = v-frame-width
      855             .
      856             for each buf_temp-browse-handle
      857               where buf_temp-browse-handle.browse-type = 'width':u
      858             on error undo, next
      859             :
      860               assign
      861                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      862               .
      863             end.
      864             assign
      865               v-diasize-browse-handle :width = v-browse-width
      866             .
      867             for each buf_temp-diasize-handle
      868             on error undo, next
      869             :
      870               assign
      871                 v-object-handle = buf_temp-diasize-handle.handle-value
      872               .
      873               if v-object-handle <> v-diasize-resize-button
      874               then do:
      875                 assign
      876                   v-object-handle :col = buf_temp-diasize-handle.save-position
      877                 .
      878               end.
      879             end.
      880             run diasize_position-resize-button in this-procedure .
      881           end.
      882           assign
      883             v-diasize-change-size = false
      884           .
      885           leave move_block .
      886         end.
      887       end.
      888       assign
      889         v-diasize-need-full-display = true
      890       .
      891       if v-diasize-change-size = false
      892       then do:
      893         assign
      894           v-diasize-change-size = true
      895         .
      896       end.
      897       else do:
      898         return .
      899       end.
      900       assign
      901         v-frame-width = frame Dialog-Frame :width
      902         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      903         v-browse-width = v-diasize-browse-handle :width
      904       .
      905       for each buf_temp-browse-handle
      906         where buf_temp-browse-handle.browse-type = 'width':u
      907       :
      908         assign
      909           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      910         .
      911       end.
      912       for each buf_temp-diasize-handle
      913       :
      914         delete buf_temp-diasize-handle .
      915       end.
      916       assign
      917         v-field-group-handle = frame Dialog-Frame :first-child
      918       .
      919       do while valid-handle(v-field-group-handle)
      920       :
      921         assign
      922           v-object-handle = v-field-group-handle :first-child
      923         .
      924         do while valid-handle(v-object-handle)
      925         :
      926           if  v-object-handle <> v-diasize-browse-handle :handle
      927           and v-object-handle <> v-diasize-resize-button
      928           and can-query(v-object-handle, "row")
      929           and can-query(v-object-handle, "height")
      930           and ( v-object-handle :col + v-object-handle :width
      931                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      932               )
      933           then do:
      934             find first buf_temp-browse-handle
      935               where buf_temp-browse-handle.browse-type   = 'width':u
      936                 and buf_temp-browse-handle.browse-handle = v-object-handle
      937               no-error .
      938             if available buf_temp-browse-handle
      939             then do:
      940             end.
      941             else do:
      942               create buf_temp-diasize-handle .
      943               assign
      944                 buf_temp-diasize-handle.handle-value  = v-object-handle
      945                 buf_temp-diasize-handle.save-position = v-object-handle :col
      946               .
      947             end.
      948           end.
      949           assign
      950             v-object-handle = v-object-handle :next-sibling
      951           .
      952         end.
      953         assign
      954           v-field-group-handle = v-field-group-handle :next-sibling
      955         .
      956       end.
      957       do with frame Dialog-Frame
      958       :
      959         hide v-diasize-resize-button .
      960         v-diasize-resize-button :row = 1.
      961         v-diasize-resize-button :column = 1.
      962       end.
      963       if p-change-value > 0
      964       then do:
      965         if frame Dialog-Frame :scrollable = true
      966         then do:
      967           assign
      968             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      969             no-error .
      970           if error-status :error
      971           or error-status :get-message(1) <> ""
      972           then do:
      973             undo move_block, retry move_block.
      974           end.
      975         end.
      976         assign
      977           frame Dialog-Frame :width = v-frame-width + p-change-value
      978           no-error .
      979         if error-status :error
      980         or error-status :get-message(1) <> ""
      981         then do:
      982           undo move_block, retry move_block.
      983         end.
      984         assign
      985           v-diasize-browse-handle :width = v-browse-width + p-change-value
      986         no-error .
      987         if error-status :error
      988         or error-status :get-message(1) <> ""
      989         then do:
      990           undo move_block, retry move_block.
      991         end.
      992         for each buf_temp-browse-handle
      993           where buf_temp-browse-handle.browse-type = 'width':u
      994         on error undo move_block, retry move_block
      995         :
      996           assign
      997             buf_temp-browse-handle.browse-handle :width
      998               = buf_temp-browse-handle.browse-handle :width + p-change-value
      999             no-error .
     1000           if error-status :error
     1001           or error-status :get-message(1) <> ""
     1002           then do:
     1003             undo move_block, retry move_block .
     1004           end.
     1005         end.
     1006         for each buf_temp-diasize-handle
     1007         on error undo move_block, retry move_block
     1008         :
     1009           assign
     1010             v-object-handle = buf_temp-diasize-handle.handle-value
     1011           .
     1012           if v-object-handle <> v-diasize-resize-button
     1013           then do:
     1014             assign
     1015               v-object-handle :col = v-object-handle :col + p-change-value
     1016               no-error .
     1017             if error-status :error
     1018             or error-status :get-message(1) <> ""
     1019             then do:
     1020               undo move_block, retry move_block .
     1021             end.
     1022           end.
     1023         end.
     1024       end.
     1025       else do:
     1026         for each buf_temp-diasize-handle
     1027         on error undo move_block, retry move_block
     1028         :
     1029           assign
     1030             v-object-handle = buf_temp-diasize-handle.handle-value
     1031           .
     1032           if v-object-handle <> v-diasize-resize-button
     1033           then do:
     1034             assign
     1035               v-object-handle :col = v-object-handle :col + p-change-value
     1036               no-error .
     1037             if error-status :error
     1038             or error-status :get-message(1) <> ""
     1039             then do:
     1040               undo move_block, retry move_block .
     1041             end.
     1042           end.
     1043         end.
     1044         for each buf_temp-browse-handle
     1045           where buf_temp-browse-handle.browse-type = 'width':u
     1046         on error undo move_block, retry move_block
     1047         :
     1048           assign
     1049             buf_temp-browse-handle.browse-handle :width
     1050               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1051             no-error .
     1052           if error-status :error
     1053           or error-status :get-message(1) <> ""
     1054           then do:
     1055             undo move_block, retry move_block .
     1056           end.
     1057         end.
     1058         assign
     1059           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1060           no-error .
     1061         if error-status :error
     1062         or error-status :get-message(1) <> ""
     1063         then do:
     1064           undo move_block, retry move_block.
     1065         end.
     1066         assign
     1067           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1068         no-error .
     1069         if error-status :error
     1070         or error-status :get-message(1) <> ""
     1071         then do:
     1072           undo move_block, retry move_block.
     1073         end.
     1074         if frame Dialog-Frame :scrollable = true
     1075         then do:
     1076           assign
     1077             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1078           no-error .
     1079           if error-status :error
     1080           or error-status :get-message(1) <> ""
     1081           then do:
     1082             undo move_block, retry move_block.
     1083           end.
     1084         end.
     1085       end.
     1086       if p-move-resize
     1087       then do:
     1088         run diasize_position-resize-button in this-procedure .
     1089       end.
     1090       if v-diasize-wndstore = true
     1091       then do:
     1092         if connected("ub") = true
     1093         then do:
     1094           define variable v-cntxt-db-num        as integer   no-undo .
     1095           define variable v-cntxt-userid        as character no-undo .
     1096           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1097                                             , OUTPUT v-cntxt-userid
     1098                                             ) .
     1099           run gbl/wndsizew.p
     1100             (input  v-cntxt-db-num
     1101             ,input  v-cntxt-userid
     1102             ,input  v-diasize-proc-name
     1103             ,input  'width':u
     1104             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1105             ) .
     1106         end.
     1107       end.
     1108     end.
     1109     assign
     1110       v-diasize-change-size = false
     1111     .
     1112   end procedure.
     1113   procedure diasize_set-width :
     1114     define input  parameter p-new-width  as decimal   no-undo .
     1115     define input  parameter p-move-resize as logical   no-undo .
     1116     do
     1117     on error undo, return error return-value
     1118     :
     1119       run diasize_change-width in this-procedure
     1120         (input  (p-new-width - frame Dialog-Frame :width)
     1121         ,input  p-move-resize
     1122         ) .
     1123     end.
     1124   end procedure.
     1125   procedure diasize_position-resize-button :
     1126     do with frame Dialog-Frame
     1127     :
     1128       hide v-diasize-resize-button .
     1129       assign
     1130         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1131                     - 1
     1132                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1133         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1134                     - 1
     1135                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1136       .
     1137       view v-diasize-resize-button .
     1138     end.
     1139   end procedure.
     1140   on alt-right anywhere
     1141   do:
     1142     run diasize_change-width in this-procedure
     1143       (input 1
     1144       ,input true
     1145       ) .
     1146     return no-apply .
     1147   end.
     1148   on alt-left anywhere
     1149   do:
     1150     run diasize_change-width in this-procedure
     1151       (input -1
     1152       ,input true
     1153       ) .
     1154     return no-apply .
     1155   end.
     1156   on alt-down anywhere
     1157   do:
     1158     run diasize_change-height in this-procedure
     1159       (input 1
     1160       ,input true
     1161       ) .
     1162     return no-apply .
     1163   end.
     1164   on alt-up anywhere
     1165   do:
     1166     run diasize_change-height in this-procedure
     1167       (input -1
     1168       ,input true
     1169       ) .
     1170     return no-apply .
     1171   end.
     1172   on alt-enter of frame Dialog-Frame
     1173   do:
     1174     run diasize_maximize in this-procedure
     1175       (input  ?
     1176       ).
     1177     return no-apply .
     1178   end.
     1179   procedure diasize_end-move :
     1180     do
     1181     on error undo, return error return-value
     1182     :
     1183       define variable v-row-delta as decimal   no-undo .
     1184       define variable v-col-delta as decimal   no-undo .
     1185       define variable v-new-row as decimal   no-undo .
     1186       define variable v-new-col as decimal   no-undo .
     1187       assign
     1188         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1189         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1190       .
     1191       assign
     1192         v-row-delta = v-new-row - frame Dialog-Frame :height
     1193         v-col-delta = v-new-col - frame Dialog-Frame :width
     1194       .
     1195       run diasize_change-height in this-procedure
     1196         (input v-row-delta
     1197         ,input true
     1198         ) .
     1199       run diasize_change-width in this-procedure
     1200         (input v-col-delta
     1201         ,input true
     1202         ) .
     1203     end.
     1204   end procedure.
     1205   procedure diasize_maximize :
     1206     define input  parameter p-action as logical   no-undo .
     1207     do
     1208     on error undo, return error return-value
     1209     :
     1210       if p-action = ?
     1211       then do:
     1212         if v-diasize-need-maximize = true
     1213         then do:
     1214           assign
     1215             p-action = true
     1216           .
     1217         end.
     1218         else do:
     1219           assign
     1220             p-action = false
     1221           .
     1222         end.
     1223       end.
     1224       if p-action = true
     1225       then do:
     1226         run diasize_change-height in this-procedure
     1227           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1228               - frame Dialog-Frame :height-chars
     1229           ,input true
     1230           ) .
     1231         run diasize_change-width in this-procedure
     1232           (input session :width-chars
     1233               - frame Dialog-Frame :width-chars
     1234           ,input true
     1235           ) .
     1236         assign
     1237           v-diasize-need-maximize = false
     1238         .
     1239       end.
     1240       else do:
     1241         run diasize_change-width in this-procedure
     1242           (input v-diasize-orig-frame-width
     1243               - frame Dialog-Frame :width-chars
     1244           ,input true
     1245           ) .
     1246         run diasize_change-height in this-procedure
     1247           (input v-diasize-orig-frame-height
     1248               - frame Dialog-Frame :height-chars
     1249           ,input true
     1250           ) .
     1251         assign
     1252           v-diasize-need-maximize = true
     1253         .
     1254       end.
     1255     end.
     1256   end procedure.
     1257   procedure diasize_restore-orig-size :
     1258     do
     1259     on error undo, return error return-value
     1260     :
     1261       assign
     1262         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1263         v-diasize-current-frame-height = frame Dialog-Frame :height
     1264       .
     1265       run diasize_set-height in this-procedure
     1266         (input  v-diasize-orig-frame-height
     1267         ,input  true
     1268         ) .
     1269       run diasize_set-width in this-procedure
     1270         (input  v-diasize-orig-frame-width
     1271         ,input  true
     1272         ) .
     1273     end.
     1274   end procedure.
     1275   procedure diasize_restore-current-size :
     1276     do
     1277     on error undo, return error return-value
     1278     :
     1279       run diasize_set-height in this-procedure
     1280         (input  v-diasize-current-frame-height
     1281         ,input  true
     1282         ) .
     1283       run diasize_set-width in this-procedure
     1284         (input  v-diasize-current-frame-width
     1285         ,input  true
     1286         ) .
     1287     end.
     1288   end procedure.
     1289   procedure diasize_set-browse-handle :
     1290     define input  parameter p-browse-handle as handle   no-undo .
     1291     define buffer buf_temp-browse-handle for temp-browse-handle .
     1292     do
     1293     on error undo, return error return-value
     1294     :
     1295       assign
     1296         v-diasize-browse-handle = p-browse-handle
     1297       .
     1298       for each buf_temp-browse-handle
     1299       on error undo, return error return-value
     1300       :
     1301         delete buf_temp-browse-handle .
     1302       end.
     1303     end.
     1304   end procedure.
     1305   procedure diasize_add_browse :
     1306     define input  parameter p-browse-type   as character no-undo .
     1307     define input  parameter p-browse-handle as handle    no-undo .
     1308     define buffer buf_temp-browse-handle for temp-browse-handle .
     1309     do
     1310     on error undo, return error return-value
     1311     :
     1312       assign
     1313         v-diasize-browse-number = v-diasize-browse-number + 1
     1314       .
     1315       create buf_temp-browse-handle .
     1316       assign
     1317         buf_temp-browse-handle.browse-type   = p-browse-type
     1318         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1319         buf_temp-browse-handle.browse-handle = p-browse-handle
     1320       .
     1321     end.
     1322   end procedure.
     1323   procedure diasize_init :
     1324     define variable v-default-value    as logical   no-undo .
     1325     define variable v-restore-saved    as logical   no-undo .
     1326     define variable v-resize-value-str as character no-undo .
     1327     do
     1328     on error undo, return error return-value
     1329     :
     1330       do with frame Dialog-Frame
     1331       :
     1332         assign
     1333           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1334           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1335           v-diasize-browse-handle     = browse BROWSE-3 :handle
     1336         .
     1337         create button v-diasize-resize-button
     1338         assign
     1339           parent        = frame Dialog-Frame :first-child
     1340           label         = "s"
     1341           height-pixels = 16
     1342           width-pixels  = 16
     1343           visible       = true
     1344           sensitive     = true
     1345           movable       = true
     1346           triggers:
     1347             on end-move persistent run diasize_end-move in this-procedure .
     1348           end triggers.
     1349         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1350         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1351         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1352         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1353         assign
     1354           v-diasize-wndmax = false
     1355         .
     1356         if connected("ub") = true
     1357         then do:
     1358           define variable v-cntxt-db-num        as integer   no-undo .
     1359           define variable v-cntxt-userid        as character no-undo .
     1360           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1361                                             , OUTPUT v-cntxt-userid
     1362                                             ) .
     1363           run gbl/wndpar_r.p
     1364             (input  v-cntxt-db-num
     1365             ,input  v-cntxt-userid
     1366             ,input  'wndmax':U
     1367             ,output v-diasize-wndmax
     1368             ,output v-default-value
     1369             ) .
     1370         end.
     1371         assign
     1372           v-diasize-wndstore = false
     1373         .
     1374         if connected("ub") = true
     1375         then do:
     1376           run gbl/wndpar_r.p
     1377             (input  v-cntxt-db-num
     1378             ,input  v-cntxt-userid
     1379             ,input  'wndstore':U
     1380             ,output v-diasize-wndstore
     1381             ,output v-default-value
     1382             ) .
     1383         end.
     1384         assign
     1385           v-diasize-proc-name = entry(1, program-name(2), '.')
     1386         .
     1387         if v-diasize-wndstore = true
     1388         then do:
     1389           assign
     1390             v-restore-saved = false
     1391           .
     1392           if connected("ub") = true
     1393           then do:
     1394             run gbl/wndsizer.p
     1395               (input  v-cntxt-db-num
     1396               ,input  v-cntxt-userid
     1397               ,input  v-diasize-proc-name
     1398               ,input  'height':u
     1399               ,output v-resize-value-str
     1400               ) .
     1401             if v-resize-value-str <> '':U
     1402             then do:
     1403               run diasize_change-height in this-procedure
     1404                 (input  integer(v-resize-value-str)
     1405                 ,input  true
     1406                 ) .
     1407               assign
     1408                 v-restore-saved = true
     1409               .
     1410             end.
     1411           end.
     1412           if connected("ub") = true
     1413           then do:
     1414             run gbl/wndsizer.p
     1415               (input  v-cntxt-db-num
     1416               ,input  v-cntxt-userid
     1417               ,input  v-diasize-proc-name
     1418               ,input  'width':u
     1419               ,output v-resize-value-str
     1420               ) .
     1421             if v-resize-value-str <> '':U
     1422             then do:
     1423               run diasize_change-width in this-procedure
     1424                 (input  integer(v-resize-value-str)
     1425                 ,input  true
     1426                 ) .
     1427               assign
     1428                 v-restore-saved = true
     1429               .
     1430             end.
     1431           end.
     1432           if v-restore-saved <> true
     1433           then do:
     1434             if v-diasize-wndmax = true
     1435             then do:
     1436               run diasize_maximize in this-procedure
     1437                 (input  true
     1438                 ) .
     1439             end.
     1440           end.
     1441         end.
     1442         else do:
     1443           if v-diasize-wndmax = true
     1444           then do:
     1445             run diasize_maximize in this-procedure
     1446               (input  true
     1447               ) .
     1448           end.
     1449         end.
     1450       end.
     1451     end.
     1452   end procedure.
     1453   procedure diasize_need-full-display :
     1454     define output parameter p-need-full-display as logical   no-undo .
     1455     do
     1456     on error undo, return error return-value
     1457     :
     1458       assign
     1459         p-need-full-display = v-diasize-need-full-display
     1460       .
     1461       assign
     1462         v-diasize-need-full-display = false
     1463       .
     1464     end.
     1465   end procedure.
     1466   procedure get-context :
     1467      define output parameter p-db-num as integer          no-undo.
     1468      define output parameter p-user-id as character        no-undo.
     1469      define variable v-login               as character    no-undo.
     1470      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1471      define buffer buf_user-login  for ub.user-login .
     1472      do
     1473      on error undo, return error
     1474      :
     1475            FIND FIRST buf_sys-ctrl no-lock.
     1476            ASSIGN
     1477               v-login = USERID("ub")
     1478               p-db-num = buf_sys-ctrl.db-num
     1479            .
     1480            FIND FIRST buf_user-login
     1481                 WHERE buf_user-login.db-num = p-db-num
     1482                   AND buf_user-login.user-login = v-login
     1483                 no-lock
     1484                 no-error
     1485                 .
     1486            IF AVAILABLE buf_user-login
     1487            THEN DO:
     1488               assign
     1489                  p-user-id = buf_user-login.user-id
     1490               .
     1491            END.
     1492      end.
     1493   end procedure.
     1494       run diasize_init in this-procedure .
     1495   MAIN-BLOCK:
     1496   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1497      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1498   define variable loc#log as logical   no-undo .
     1499       RUN init-tt.
     1500       RUN enable_UI.
     1501       RUN init-proc.
     1502     WAIT-FOR GO OF FRAME Dialog-Frame.
     1503   END.
     1504   RUN disable_UI.
     1505   PROCEDURE bg-col :
     1506   define input  parameter p-color as integer   no-undo .
     1507   END PROCEDURE.
     1508   PROCEDURE disable_UI :
     1509     HIDE FRAME Dialog-Frame.
     1510   END PROCEDURE.
     1511   PROCEDURE enable_UI :
     1512     DISPLAY v-goods
     1513         WITH FRAME Dialog-Frame.
     1514     ENABLE B-exit B-quit B-trn B-print B-Help BROWSE-3 v-goods
     1515         WITH FRAME Dialog-Frame.
     1516     VIEW FRAME Dialog-Frame.
     1517     OPEN QUERY BROWSE-3 FOR EACH tt_doc-line NO-LOCK where tt_doc-line.artic     = buf_goods.artic and tt_doc-line.prod-type = buf_goods.prod-type and tt_doc-line.prod-code = buf_goods.prod-code  ,        first buf_trn-doc no-lock where       buf_trn-doc.doc-code = tt_doc-line.doc-code ,        first buf_clients no-lock where       buf_clients.obj-code = buf_trn-doc.cli-code and       buf_clients.obj-type = buf_trn-doc.cli-type  INDEXED-REPOSITION.
     1518   END PROCEDURE.
     1519   PROCEDURE fill-widgets :
     1520   END PROCEDURE.
     1521   PROCEDURE init-proc :
     1522   if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1523        B-exit:label in frame Dialog-Frame  = "Вы&ход"  .
     1524        hide B-quit in frame Dialog-Frame .
     1525     END.
     1526     hide b-print  in frame Dialog-Frame .
     1527   end procedure.
     1528   PROCEDURE init-tt :
     1529   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1530   v-goods =   buf_goods.artic + "  код:" + string ( buf_goods.gds-code ) + " "  +  buf_goods.gds-name .
     1531   END PROCEDURE.
     1532   PROCEDURE save-proc :
     1533   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1534   END PROCEDURE.
