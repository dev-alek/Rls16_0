     1679   define variable vss-include-info16 as character format "X(65)" no-undo
     1680   initial "@(#)$Workfile$".
     1681     assign Counter1 = Counter1 + 1.
     1682   IF ( Counter1 modulo v-account = 0 )  then DO:
     1683             if  log-manager:logfile-name ne ?
     1684             then DO:
     1685                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1686             end.
     1687              if mFrameView
     1688              then do:
     1689               DISPLAY
     1690                 Counter1 @ RecordsDone
     1691                 WITH FRAME InfoFrame.
     1692              end.
     1693   End.
     1694      if v-button-stop then  DO:
     1695            if mFrameView
     1696            then
     1697               PROCESS EVENTS.
     1698            IF StopProcessing THEN DO:
     1699            RETURN error.
     1700            End.
     1701      end.
     1702     find first temp-goods where temp-goods.gds-code = buf_gds-obj.gds-code no-error .
     1703     if not available temp-goods then do:
     1704       create temp-goods .
     1705       find first buf_goods no-lock  where buf_goods.gds-code = buf_gds-obj.gds-code .
     1706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1707     (input  buf_gds-obj.gds-code
     1708     ,input  ?
     1709     ,output ii
     1710     ) no-error .
     1711       if error-status :error then do:
     1712         message
     1713           vss-workfile vss-revision vss-description skip
     1714           "Ошибка при определении бар-кода товара" skip
     1715           "Код товара" buf_goods.artic skip
     1716         view-as alert-box error .
     1717         undo, return error .
     1718       end.
     1719       assign
     1720         temp-goods.gds-code  = buf_goods.gds-code
     1721         temp-goods.artic     = buf_goods.artic
     1722         temp-goods.prod-code = buf_goods.prod-code
     1723         temp-goods.prod-type = buf_goods.prod-type
     1724         temp-goods.grp-name  = buf_goods.grp-name
     1725         temp-goods.b-code    = string(ii,"9999999999999")
     1726       .
     1727       if g#gds-engl then assign temp-goods.gds-name = buf_goods.engl-name.
     1728       else               assign temp-goods.gds-name = buf_goods.gds-name.
