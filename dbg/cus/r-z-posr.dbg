     1736             where buf_gds-obj.host-code = p-host
     1737               and buf_gds-obj.artic     = gds-list.artic
     1738               and buf_gds-obj.prod-type = gds-list.prod-type
     1739               and buf_gds-obj.prod-code = gds-list.prod-code
     1740             :
     1741   define variable vss-include-info17 as character format "X(65)" no-undo
     1742   initial "@(#)$Workfile$".
     1743     assign Counter1 = Counter1 + 1.
     1744   IF ( Counter1 modulo v-account = 0 )  then DO:
     1745             if  log-manager:logfile-name ne ?
     1746             then DO:
     1747                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1748             end.
     1749              if mFrameView
     1750              then do:
