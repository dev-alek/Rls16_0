     1247     index xie2 db-num host-code
     1248   .
     1249   procedure init-temphost:
     1250     define buffer buf_store   for ub.store .
     1251     define buffer buf_shop    for ub.shop .
     1252     define buffer buf_clients for ub.clients .
     1253     define buffer buf_db for ub.db .
     1254     define buffer buf_temp-host for temp-host .
     1255     define buffer buf_temp-obj for temp-obj .
     1256     do
     1257     on error undo, return error return-value
     1258     :
     1259       for each buf_store
     1260       on error undo, return error
     1261       :
     1262         find first buf_temp-host
     1263           where buf_temp-host.host-code = buf_store.host-code
     1264           no-error .
     1265         if not available buf_temp-host
     1266         then do:
     1267           create buf_temp-host .
     1268           assign
     1269             buf_temp-host.host-code = buf_store.host-code
     1270           .
     1271         end.
     1272         find first buf_clients no-lock
     1273           where buf_clients.obj-type = 'скл':U
     1274             and buf_clients.obj-code = buf_store.obj-code
     1275           no-error .
     1276         if not available buf_clients
     1277         then do:
     1278           message
     1279             "Ошибка при поиске клиента" skip
     1280             "Клиент" 'скл':U buf_store.obj-code skip
     1281             view-as alert-box error .
     1282           undo, return error .
     1283         end.
     1284         create buf_temp-obj .
     1285         assign
     1286           buf_temp-obj.obj-type  = 'скл':U
     1287           buf_temp-obj.obj-code  = buf_store.obj-code
     1288           buf_temp-obj.host-code = buf_store.host-code
     1289           buf_temp-obj.db-num    = buf_clients.db-num
     1290         .
     1291       end.
     1292       for each buf_shop
     1293       on error undo, return error
     1294       :
     1295         find first buf_temp-host
     1296           where buf_temp-host.host-code = buf_shop.host-code
     1297           no-error .
     1298         if not available buf_temp-host
     1299         then do:
     1300           create buf_temp-host .
     1301           assign
     1302             buf_temp-host.host-code = buf_shop.host-code
     1303           .
     1304         end.
     1305         find first buf_clients no-lock
     1306           where buf_clients.obj-type = 'маг':U
     1307             and buf_clients.obj-code = buf_shop.obj-code
     1308           no-error .
     1309         if not available buf_clients then do:
     1310           message
     1311             "Ошибка при поиске клиента" skip
     1312             "Клиент" 'маг':U buf_shop.obj-code skip
     1313             view-as alert-box error .
     1314           undo, return error .
     1315         end.
     1316         create buf_temp-obj .
     1317         assign
     1318           buf_temp-obj.obj-type  = 'маг':U
     1319           buf_temp-obj.obj-code  = buf_shop.obj-code
     1320           buf_temp-obj.host-code = buf_shop.host-code
     1321           buf_temp-obj.db-num    = buf_clients.db-num
     1322         .
     1323       end.
     1324     end.
     1325   end.
     1326   define variable vss-include-info13 as character format "X(65)" no-undo
     1327   initial "@(#)$Workfile$ $Revision$".
     1328   procedure grplib-get-full-name :
     1329      define input parameter p-node-code  as integer      no-undo.
     1330      define output parameter p-full-name as character    no-undo.
     1331      do
     1332   on error undo, return error
     1333   :
     1334       define variable v-upper-code    as integer           no-undo.
     1335       define buffer buf_gds-grp       for ub.gds-grp.
     1336       define buffer buf_upper_gds-grp for ub.gds-grp.
     1337       find first buf_gds-grp no-lock
     1338            where buf_gds-grp.node-code = p-node-code
     1339       no-error.
     1340       if not available buf_gds-grp
     1341       then do:
     1342           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1343       end.
     1344       assign
     1345           p-full-name  = ""
     1346           v-upper-code = 1
     1347       .
     1348       do while buf_gds-grp.upper-code <> 0
     1349       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1350       :
     1351           assign
     1352               p-full-name  = buf_gds-grp.node-name
     1353                            + (if p-full-name <> "" then chr(47) else "")
     1354                            + p-full-name
     1355               v-upper-code = buf_gds-grp.upper-code
     1356           .
     1357           find first buf_gds-grp no-lock
     1358                where buf_gds-grp.node-code = v-upper-code
     1359           no-error.
     1360           if not available buf_gds-grp
     1361           then do:
     1362               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1363                                   + string( v-upper-code )
     1364                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1365           end.
     1366       end.
     1367       assign
     1368       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1369       .
     1370   end.
     1371   end .
     1372   procedure grplib-get-node-from-full-name :
     1373   define input parameter p-full-name as character no-undo .
     1374   define output parameter p-node-code as integer no-undo .
     1375   define variable v-ii as integer no-undo .
     1376   define variable v-upper-code as integer no-undo .
     1377   define variable v-root-code as integer no-undo .
     1378   define variable v-entry as character no-undo .
     1379   define buffer buf_gds-grp       for ub.gds-grp.
     1380   do
     1381   on error undo, return error
     1382   :
     1383     find first buf_gds-grp no-lock
     1384         where buf_gds-grp.upper-code = 0
     1385     no-error .
     1386     if not available buf_gds-grp
     1387     then do:
     1388         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1389     end.
     1390     else do:
     1391       assign
     1392       v-root-code = buf_gds-grp.node-code
     1393       .
     1394     end.
     1395     v-upper-code = v-root-code.
     1396     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1397       assign
     1398       v-entry = entry(v-ii, p-full-name, chr(47)).
     1399       if v-entry = '' then leave.
     1400       find first buf_gds-grp no-lock where
     1401                 buf_gds-grp.node-name = v-entry
     1402             and buf_gds-grp.upper-code = v-upper-code
     1403             no-error.
     1404       if not available buf_gds-grp then do:
     1405         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1406       end.
     1407       else do:
     1408         p-node-code = buf_gds-grp.node-code.
     1409         v-upper-code = buf_gds-grp.node-code.
     1410       end.
     1411     end.
     1412   end.
     1413   end .
     1414   do
     1415   on error undo, return error
     1416   :
     1417     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     1418     ASSIGN parParentProc =  my-handle .
