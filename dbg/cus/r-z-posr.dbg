      650   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      651     if num-entries(string(p-dec), '.') = 2
      652       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      653       else return( string(p-dec)) .
      654   end function.
      655   function format-point-to-comma returns char (input orig as char ) .
      656   define variable rtext as character no-undo .
      657   define variable strt as integer no-undo .
      658   define variable leng as integer no-undo .
      659   assign rtext = orig .
      660   repeat:
      661     strt =  index(rtext,'.').
      662     if strt = 0 then leave.
      663     leng = 1.
      664     substring(rtext,strt,leng,"character") = v-delim .
      665   end.
      666   return rtext.
      667   end function.
      668   function format-excel-text returns char ( input start-text as char ) :
      669   def var  i    as int no-undo.
      670   def var  ch   as char no-undo.
      671   def var  n    as int no-undo.
      672   def var  ipos as int no-undo.
      673     n = num-entries(trim(start-text), chr(10)) - 1 .
      674     do i = 1 to n :
      675       ipos = index( start-text, chr(10)).
      676       if ipos > 0 then
      677         substr( start-text, ipos, 1 ) = ' '.
      678     end.
      679     n = num-entries(trim(start-text), chr(13)) - 1 .
      680     do i = 1 to n :
      681       ipos = index( start-text, chr(13)).
      682       if ipos > 0 then
      683         substr( start-text, ipos, 1 ) = ' '.
      684     end.
      685     if index( start-text, '"' ) = 0 then
      686       start-text =  '="'   + trim( start-text) + '"'   .
      687       else do:
      688         n = num-entries(trim(start-text), '"') - 1.
      689         do i = 1 to n :
      690           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      691         end.
      692         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      693         start-text = '="'  + ch  + '"' .
      694       end.
      695     return start-text.
      696   end.
      697   function excel-sum returns char (input p-dec as decimal ).
      698     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      699   end function.
      700   function excel-qnty returns char (input p-dec as decimal ).
      701     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      702   end function.
      703   function format-excel-text-macr returns char ( input start-text as char ) :
      704   def var  i    as int no-undo.
      705   def var  ch   as char no-undo.
      706   def var  n    as int no-undo.
      707   def var  ipos as int no-undo.
      708     n = num-entries(trim(start-text), chr(10)) - 1 .
      709     do i = 1 to n :
      710       ipos = index( start-text, chr(10)).
      711       if ipos > 0 then
      712         substring( start-text, ipos , 1 ) = ' '.
      713     end.
      714     n = num-entries(trim(start-text), chr(13)) - 1 .
      715     do i = 1 to n :
      716       ipos = index( start-text, chr(13)).
      717       if ipos > 0 then
      718         substring( start-text, ipos, 1 ) = ' '.
      719     end.
      720     if index( start-text, '"' ) = 0 then
      721       start-text =  '"'   + trim( start-text) + '"'   .
      722       else do:
      723         n = num-entries(trim(start-text), '"') - 1.
      724         do i = 1 to n :
      725           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      726         end.
      727         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      728         start-text = '"'  + ch  + '"' .
      729       end.
      730     n = num-entries(trim(start-text), chr(10)) - 1 .
      731     do i = 1 to n :
      732       ipos = index( start-text, chr(10)).
      733       if ipos > 0 then
      734         substring( start-text, ipos , 1 ) = ' '.
      735     end.
      736       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      737     return start-text.
      738   end.
      739   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      741   procedure paramls-clear :
      742     define buffer buf_temp-param for temp-param .
      743     do
      744     on error undo, return error return-value
      745     :
      746       for each buf_temp-param
      747       on error undo, return error
      748       :
      749         delete buf_temp-param .
      750       end.
      751     end.
      752   end procedure.
      753   procedure paramls-write :
      754     define input  parameter p-code     as character no-undo .
      755     define input  parameter p-sub-code as character no-undo .
      756     define input  parameter p-value    as character no-undo .
      757     define buffer buf_temp-param for temp-param .
      758     do
      759     on error undo, return error return-value
      760     :
      761       find first buf_temp-param
      762         where buf_temp-param.param-code     = p-code
      763           and buf_temp-param.param-sub-code = p-sub-code
      764         no-error .
      765       if not available buf_temp-param then do:
      766         create buf_temp-param .
      767         assign
      768           buf_temp-param.param-code     = p-code
      769           buf_temp-param.param-sub-code = p-sub-code
      770         .
      771       end.
      772       assign
      773         buf_temp-param.param-value = p-value
      774       .
      775     end.
      776   end procedure.
      777   procedure paramls-read :
      778     define input  parameter p-code          as character no-undo .
      779     define input  parameter p-sub-code      as character no-undo .
      780     define input  parameter p-default-value as character no-undo .
      781     define output parameter p-value         as character no-undo .
      782     define buffer buf_temp-param for temp-param .
      783     do
      784     on error undo, return error return-value
      785     :
      786       find first buf_temp-param
      787         where buf_temp-param.param-code     = p-code
      788           and buf_temp-param.param-sub-code = p-sub-code
      789         no-error .
      790       if available buf_temp-param then do:
      791         assign
      792           p-value = buf_temp-param.param-value
      793         .
      794       end.
      795       else do:
      796         assign
      797           p-value = p-default-value
      798         .
      799       end.
      800     end.
      801   end procedure.
      802   procedure paramls-append :
      803     define input  parameter p-code     as character no-undo .
      804     define input  parameter p-sub-code as character no-undo .
      805     define input  parameter p-value    as character no-undo .
      806     define buffer buf_temp-param for temp-param .
      807     do
      808     on error undo, return error return-value
      809     :
      810       find first buf_temp-param
      811            where buf_temp-param.param-code     = p-code
      812              and buf_temp-param.param-sub-code = p-sub-code
      813         no-error .
      814       if not available buf_temp-param then do:
      815         create buf_temp-param .
      816         assign
      817           buf_temp-param.param-code     = p-code
      818           buf_temp-param.param-sub-code = p-sub-code
      819           buf_temp-param.param-value    = p-value
      820         .
      821       end.
      822       else do:
      823           assign
      824               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      825           .
      826       end.
      827     end.
      828   end procedure.
      829   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      830   procedure factord :
      831     define input  parameter p-fact-date            as date    no-undo .
      832     define input  parameter p-fact-time            as integer no-undo .
      833     define input  parameter p-fact-num             as integer no-undo .
      834     define input  parameter p-shift-date           as date    no-undo .
      835     define input  parameter p-shift-num            as integer no-undo .
      836     define input  parameter p-shift-on             as logical no-undo .
      837     define output parameter p-fact-order           as decimal no-undo .
      838     define output parameter p-shift-end-fact-order as decimal no-undo .
      839     define output parameter p-day-end-fact-order   as decimal no-undo .
      840     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      841     if p-fact-date = ?
      842     then do:
      843       return error "Не указана фактическая дата" .
      844     end.
      845     define variable v-fact-date-num as integer no-undo .
      846     assign
      847       v-fact-date-num = integer(p-fact-date)
      848     .
      849     if p-fact-num = ?
      850     or p-fact-num = 0
      851     then do:
      852       return error "Не задан p-fact-num " + string(p-fact-num) .
      853     end.
      854     if p-fact-num < 0
      855     then do:
      856       return error "Отрицательный fact-num " + string(p-fact-num) .
      857     end.
      858     if p-fact-num >= 100000000
      859     then do:
      860       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      861     end.
      862     if p-shift-on = true
      863     then do:
      864       if p-shift-date = ?
      865       then do:
      866         return error "Не задана дата смены" .
      867       end.
      868       if p-shift-num = ?
      869       or p-shift-num = 0
      870       then do:
      871         return error "Не задан номер смены" .
      872       end.
      873     end.
      874     else do:
      875       assign
      876         p-shift-date = p-fact-date
      877         p-shift-num  = 24
      878       .
      879     end.
      880     define variable v-shift-offset as integer no-undo .
      881     if p-shift-date = p-fact-date
      882     then do:
      883       assign
      884         v-shift-offset = 1
      885       .
      886     end.
      887     if p-shift-date < p-fact-date
      888     then do:
      889       assign
      890         v-shift-offset = 0
      891       .
      892     end.
      893     if p-shift-date > p-fact-date
      894     then do:
      895       message
      896         vss-workfile vss-revision vss-description skip
      897         "Неправильная дата закрытия смены" skip
      898         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      899         view-as alert-box error .
      900       undo, return error
      901         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      902           ,string(p-fact-date, '99/99/9999':U)
      903           ,string(p-shift-date, '99/99/9999':U)
      904           )
      905       .
      906     end.
      907     if p-shift-num < 1
      908     or p-shift-num > 24
      909     then do:
      910       message
      911         vss-workfile vss-revision vss-description skip
      912         "Неправильный номер смены" skip
      913         "p-shift-num" p-shift-num skip
      914         view-as alert-box error .
      915       undo, return error return-value .
      916     end.
      917     assign
      918       p-fact-order           = v-fact-date-num
      919                              + v-shift-offset * 0.5
      920                              + p-shift-num    * 0.02 - 0.01
      921                              + p-fact-num     * 0.0000000001
      922       p-shift-end-fact-order = v-fact-date-num
      923                              + v-shift-offset * 0.5
      924                              + p-shift-num    * 0.02
      925       p-day-end-fact-order   = v-fact-date-num
      926                              + 0.99
      927     .
      928     if p-fact-order           <= v-fact-date-num
      929     or p-shift-end-fact-order <= v-fact-date-num
      930     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      931     or p-shift-end-fact-order >= p-day-end-fact-order
      932     then do:
      933       message
      934         vss-workfile vss-revision vss-description skip
      935         "Внутренняя ошибка при генерации фактического номера" skip
      936         "p-fact-date"            p-fact-date            skip
      937         "p-fact-time"            p-fact-time            skip
      938         "p-fact-num"             p-fact-num             skip
      939         "p-shift-date"           p-shift-date           skip
      940         "p-shift-num"            p-shift-num            skip
      941         "p-shift-on"             p-shift-on             skip
      942         "p-shift-end-fact-order" p-shift-end-fact-order skip
      943         "p-day-end-fact-order"   p-day-end-fact-order   skip
      944         "v-fact-date-num"        v-fact-date-num        skip
      945         view-as alert-box error .
      946       undo, return error return-value .
      947     end.
      948   end procedure.
      949   procedure day-begin-fact-order :
      950     define input  parameter p-fact-date            as date    no-undo .
      951     define output parameter p-day-begin-fact-order as decimal no-undo .
      952     do
      953     on error undo, return error return-value
      954     :
      955       if p-fact-date = ?
      956       then do:
      957         assign
      958           p-day-begin-fact-order = 0
      959         .
      960       end.
      961       else do:
      962         assign
      963           p-day-begin-fact-order = integer(p-fact-date)
      964         .
      965       end.
      966     end.
      967   end procedure.
      968   procedure factord-max-fact-order :
      969     define output parameter p-max-fact-order as decimal   no-undo .
      970     do
      971     on error undo, return error return-value
      972     :
      973       run day-begin-fact-order in this-procedure
      974         (input  date(1, 1, 5000)
      975         ,output p-max-fact-order
      976         ) .
      977     end.
      978   end procedure.
      979   procedure factord-cut-archive :
      980     define input  parameter p-obj-type             as character no-undo .
      981     define input  parameter p-obj-code             as integer   no-undo .
      982     define input  parameter p-fact-date            as date      no-undo .
      983     define output parameter p-shift-on             as logical   no-undo .
      984     define output parameter p-shift-date           as date      no-undo .
      985     define output parameter p-shift-num            as integer   no-undo .
      986     define output parameter p-day-end-fact-order   as decimal   no-undo .
      987     define output parameter p-shift-end-fact-order as decimal   no-undo .
      988     define variable v-fact-order as decimal   no-undo .
      989     define buffer buf_shift-obj for ub.shift-obj .
      990     do
      991     on error undo, return error return-value
      992     :
      993   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      995     (input  p-obj-type
      996     ,input  p-obj-code
      997     ,input  'shift-on=request'
      998     ,output p-shift-on
      999     ) no-error .
     1000       if error-status :error
     1001       then do:
     1002         message
     1003           vss-workfile vss-revision vss-description skip
     1004           "Ошибка при определении атрибута объекта" skip
     1005           "Объект" p-obj-type p-obj-code skip
     1006           error-status :get-message(1) skip
     1007           return-value skip
     1008           view-as alert-box error .
     1009         undo, return error return-value .
     1010       end.
     1011       if p-shift-on = false
     1012       then do:
     1013         assign
     1014           p-shift-date               = ?
     1015           p-shift-num                = 0
     1016         .
     1017       end.
     1018       else do:
     1019         find first buf_shift-obj share-lock
     1020           where buf_shift-obj.obj-type   = p-obj-type
     1021             and buf_shift-obj.obj-code   = p-obj-code
     1022             and buf_shift-obj.shift-date > p-fact-date
     1023           use-index pi
     1024           no-error .
     1025         if not available buf_shift-obj
     1026         or buf_shift-obj.status_ <> 'зкр':U
     1027         then do:
     1028           message
     1029             vss-workfile vss-revision vss-description skip
     1030             "Невозможно вычислить последнюю смену" skip
     1031             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1032             "Объект" p-obj-type p-obj-code skip
     1033             "Дата" p-fact-date skip
     1034             view-as alert-box error .
     1035           undo, return error return-value .
     1036         end.
     1037         find last buf_shift-obj share-lock
     1038           where buf_shift-obj.obj-type = p-obj-type
     1039             and buf_shift-obj.obj-code = p-obj-code
     1040             and buf_shift-obj.shift-date <= p-fact-date
     1041           use-index pi
     1042           no-error .
     1043         if available buf_shift-obj
     1044         then do:
     1045           if  buf_shift-obj.status_ = 'зкр':U
     1046           then do:
     1047             assign
     1048               p-shift-date = buf_shift-obj.shift-date
     1049               p-shift-num  = buf_shift-obj.shift-num
     1050             .
     1051           end.
     1052           else do:
     1053             message
     1054               vss-workfile vss-revision vss-description skip
     1055               "Невозможно вычислить последнюю смену" skip
     1056               "Статус смены отличен от статуса" 'зкр':U skip
     1057               "Объект" p-obj-type p-obj-code skip
     1058               "Дата" p-fact-date skip
     1059               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1060               view-as alert-box error .
     1061             undo, return error return-value .
     1062           end.
     1063         end.
     1064         else do:
     1065           assign
     1066             p-shift-date = p-fact-date - 1
     1067             p-shift-num  = 1
     1068           .
     1069         end.
     1070       end.
     1071       run factord in this-procedure
     1072         (input  p-fact-date
     1073         ,input  1
     1074         ,input  1
     1075         ,input  p-shift-date
     1076         ,input  p-shift-num
     1077         ,input  p-shift-on
     1078         ,output v-fact-order
     1079         ,output p-shift-end-fact-order
     1080         ,output p-day-end-fact-order
     1081         ) no-error .
     1082       if error-status :error
     1083       then do:
     1084         message
     1085           vss-workfile vss-revision vss-description skip
     1086           "Ошибка при вызове процедуры factord"
     1087           error-status :get-message(1) skip
     1088           return-value skip
     1089           view-as alert-box error .
     1090         undo, return error return-value .
     1091       end.
     1092     end.
     1093   end procedure.
     1094   procedure factord-lock-shift :
     1095     define input  parameter p-obj-type  as character no-undo .
     1096     define input  parameter p-obj-code  as integer   no-undo .
     1097     define input  parameter p-fact-date as date      no-undo .
     1098     define parameter buffer buf_shift-obj for ub.shift-obj .
     1099     define variable v-shift-on      as logical   no-undo .
     1100     define variable v-extra-message as character no-undo .
     1101     define variable v-error as character no-undo .
     1102     do
     1103     on error undo, return error return-value
     1104     :
     1105   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1107     (input  p-obj-type
     1108     ,input  p-obj-code
     1109     ,input  'shift-on=request'
     1110     ,output v-shift-on
     1111     ) no-error .
     1112       if error-status :error
     1113       then do:
     1114         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1115         undo, return error v-error .
     1116       end.
     1117       if v-shift-on = true
     1118       then do:
     1119         find first buf_shift-obj share-lock
     1120           where buf_shift-obj.obj-type   = p-obj-type
     1121             and buf_shift-obj.obj-code   = p-obj-code
     1122             and buf_shift-obj.shift-date > p-fact-date
     1123           use-index pi
     1124           no-error .
     1125         if not available buf_shift-obj
     1126         or buf_shift-obj.status_ <> 'зкр':U
     1127         then do:
     1128           find last buf_shift-obj
     1129             where buf_shift-obj.obj-type = p-obj-type
     1130               and buf_shift-obj.obj-code = p-obj-code
     1131               and buf_shift-obj.status_  = 'зкр':U
     1132             use-index stts
     1133             no-error .
     1134           if available buf_shift-obj
     1135           then do:
     1136             assign
     1137               v-extra-message =
     1138                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1139                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1140                               )
     1141             .
     1142           end.
     1143           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1144           undo, return error v-error .
     1145         end.
     1146       end.
     1147     end.
     1148   end procedure.
     1149   procedure factord-end-day :
     1150     define input  parameter p-fact-date            as date    no-undo .
     1151     define output parameter p-day-end-fact-order   as decimal no-undo .
     1152     do
     1153     on error undo, return error return-value
     1154     :
     1155       if p-fact-date = ?
     1156       then do:
     1157         return error "Не указана фактическая дата" .
     1158       end.
     1159       assign
     1160         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1161       .
     1162     end.
     1163   end procedure.
     1164   procedure factord-to-date :
     1165     define input  parameter p-fact-order as decimal no-undo .
     1166     define output parameter p-fact-date  as date    no-undo .
     1167     define variable v-ref-date  as date      no-undo .
     1168     define variable v-ref-delta as integer   no-undo .
     1169     do
     1170     on error undo, return error return-value
     1171     :
     1172       if p-fact-order = ?
     1173       or p-fact-order = 0
     1174       then do:
     1175         return error "Не указан fact-order" .
     1176       end.
     1177       assign
     1178         v-ref-date  = date(1, 1, 2000)
     1179       .
     1180       assign
     1181         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1182       .
     1183       assign
     1184         p-fact-date = v-ref-date + v-ref-delta
     1185       .
     1186     end.
     1187   end procedure.
     1188   procedure factord-to-fact-num :
     1189     define input  parameter p-fact-order as decimal no-undo .
     1190     define output parameter p-fact-num   as integer no-undo .
     1191     define variable v-fact-order-trunc as decimal no-undo .
     1192     do
     1193     on error undo, return error return-value
     1194     :
     1195       if p-fact-order = ?
     1196       or p-fact-order = 0
     1197       then do:
     1198         return error "Не указан fact-order" .
     1199       end.
     1200       assign
     1201        v-fact-order-trunc = truncate(p-fact-order, 2)
     1202       .
     1203       assign
     1204         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1205       .
     1206     end.
     1207   end procedure.
     1208   procedure factord-to-shift-num :
     1209     define input  parameter p-fact-order as decimal no-undo .
     1210     define output parameter p-shift-num   as integer no-undo .
     1211     define variable  p-shift-numd  as decimal   no-undo .
     1212     define variable v-fact-order-trunc as decimal no-undo .
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216       if p-fact-order = ?
     1217       or p-fact-order = 0
     1218       then do:
     1219         return error "Не указан fact-order" .
     1220       end.
     1221       assign
     1222        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1223       .
     1224       if v-fact-order-trunc < 0.5 then do:
     1225         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1226       end.
     1227       assign
     1228         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1229         .
     1230        assign
     1231         p-shift-num = truncate (p-shift-numd , 0)
     1232       .
     1233     end.
     1234   end procedure.
     1235   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1236   define  temp-table temp-host no-undo
     1237     field host-code like ub.store.host-code
     1238     index xpk host-code
     1239   .
     1240   define  temp-table temp-obj no-undo
     1241     field obj-type  like ub.clients.obj-type
     1242     field obj-code  like ub.clients.obj-code
     1243     field host-code like ub.store.host-code
     1244     field db-num    like ub.clients.db-num
     1245     index xpk  obj-type obj-code
