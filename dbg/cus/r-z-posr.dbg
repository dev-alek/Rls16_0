     1461     define variable v-file-name as character no-undo .
     1462     define variable v-row       as integer   no-undo .
     1463     define variable v-col       as integer   no-undo .
     1464     define variable v-ind       as integer   no-undo initial 1 .
     1465     assign  Counter1 = 0 .
     1466   define variable v-account as integer init 0 no-undo .
     1467   define variable v-account-lavel as character no-undo .
     1468   define variable v-button-stop as logical no-undo .
     1469   define variable v-kol-spice as integer no-undo .
     1470   define variable v-kol-spice2 as integer no-undo .
     1471   define variable v-kol-spice3 as integer no-undo .
