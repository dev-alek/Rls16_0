     1445       field obj-type  like clients.obj-type
     1446       field obj-code  like clients.obj-code
     1447       field sum-zak   as decimal
     1448       field sum-prod  as decimal
     1449       INDEX pi  IS PRIMARY gds-code obj-type obj-code
     1450     .
     1451     define buffer buf_goods    for goods.
     1452     define buffer buf_clients  for clients.
     1453     define buffer buf_gds-obj  for gds-obj.
     1454     define buffer buf_doc-line for doc-line.
     1455     define variable Counter1    as integer   no-undo .
