     1796     run CalculPrice in this-procedure .
     1797     assign
     1798       make-excel = yes
     1799       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     1800     .
     1801     output stream macr_excel to value(v-file-name) .
     1802     assign v-ind = v-ind + 1 .
     1803   if session :set-wait-state( "compiler" ) then.
     1804     run PutColumnTitulExcel in this-procedure .
     1805     if sort-grp then do:
     1806       for each temp-goods break by temp-goods.grp-name by if SortType = 1 then  temp-goods.b-code Else (if SortType = 2 then  temp-goods.artic Else  temp-goods.gds-name) :
     1807         if first-of(temp-goods.grp-name ) then do:
     1808           run macr_excel_char (temp-goods.grp-name, v-row, 3) .
     1809           run macr_cell_format ( 11, yes, no, ?, v-row, 3, v-row, 3) .
     1810           assign v-row = v-row + 1  .
     1811         end.
     1812         run PrintLine in this-procedure .
     1813       end.
     1814     end.
     1815     else do:
     1816       for each temp-goods break by if SortType = 1 then  temp-goods.b-code Else (if SortType = 2 then  temp-goods.artic Else  temp-goods.gds-name) :
     1817         run PrintLine in this-procedure .
     1818       end.
     1819     end.
     1820     output stream macr_excel close .
     1821     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     1822     run end-proc .
     1823   if mFrameView
     1824   then do:
     1825      HIDE FRAME InfoFrame.
     1826   end.
     1827   if session :set-wait-state( "" ) then.
     1828     run rep/runexcel.p (v-file-name ).
     1829   end.
     1830   procedure CalculPrice :
     1831     do on error undo, return error return-value :
     1832       define variable tmp-fo  as decimal   no-undo .
     1833       define variable tmp-sum as decimal   no-undo .
     1834       for each temp-goods :
     1835         assign
     1836           tmp-fo   = 0
     1837           tmp-sum  = 0
     1838           Counter1 = Counter1 + 1
     1839         .
     1840   IF ( Counter1 modulo v-account = 0 )  then DO:
     1841             if  log-manager:logfile-name ne ?
     1842             then DO:
     1843                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1844             end.
     1845              if mFrameView
     1846              then do:
     1847               DISPLAY
     1848                 Counter1 @ RecordsDone
     1849                 WITH FRAME InfoFrame.
     1850              end.
     1851   End.
     1852      if v-button-stop then  DO:
     1853            if mFrameView
     1854            then
     1855               PROCESS EVENTS.
     1856            IF StopProcessing THEN DO:
     1857            RETURN error.
     1858            End.
     1859      end.
     1860         for each temp-obj :
     1861           find last buf_doc-line no-lock
     1862             where buf_doc-line.artic      = temp-goods.artic
     1863               and buf_doc-line.prod-type  = temp-goods.prod-type
     1864               and buf_doc-line.prod-code  = temp-goods.prod-code
     1865               and buf_doc-line.obj-type   = temp-obj.obj-type
     1866               and buf_doc-line.obj-code   = temp-obj.obj-code
     1867               and buf_doc-line.status_    = 'факт':U
     1868               and buf_doc-line.fact-order < v-fact-order-start
     1869               and (buf_doc-line.ext-doc-type = 'ie':U or buf_doc-line.ext-doc-type = 'iv':U )
     1870             no-error .
     1871           if available buf_doc-line then do:
     1872             if buf_doc-line.fact-order > tmp-fo then do:
     1873               assign
     1874                 tmp-sum = if var-report-r-b = "rubl" then buf_doc-line.price-rubl else buf_doc-line.price-base
     1875                 tmp-fo  = buf_doc-line.fact-order
     1876               .
     1877             end.
     1878           end.
     1879         end.
     1880         assign
     1881           temp-goods.sum-posr = tmp-sum
     1882           temp-goods.sum-zak  = 0
     1883           temp-goods.sum-prod = 0
     1884           num-obj1 = 0
     1885           num-obj2 = 0
     1886         .
     1887         for each obj-list :
     1888           create temp-goods-obj .
     1889           assign
     1890             temp-goods-obj.gds-code = temp-goods.gds-code
     1891             temp-goods-obj.obj-type = obj-list.obj-type
     1892             temp-goods-obj.obj-code = obj-list.obj-code
     1893             temp-goods-obj.sum-zak  = 0
     1894             temp-goods-obj.sum-prod = 0
     1895           .
     1896           find last buf_doc-line no-lock
     1897             where buf_doc-line.artic      = temp-goods.artic
     1898               and buf_doc-line.prod-type  = temp-goods.prod-type
     1899               and buf_doc-line.prod-code  = temp-goods.prod-code
     1900               and buf_doc-line.obj-type   = obj-list.obj-type
     1901               and buf_doc-line.obj-code   = obj-list.obj-code
     1902               and buf_doc-line.status_    = 'факт':U
     1903               and buf_doc-line.fact-order < v-fact-order-start
     1904               and (buf_doc-line.ext-doc-type = 'ie':U or buf_doc-line.ext-doc-type = 'iv':U )
     1905             no-error .
     1906           if available buf_doc-line then do:
     1907             assign
     1908               temp-goods.sum-zak     = temp-goods.sum-zak + (if var-report-r-b = "rubl" then buf_doc-line.price-rubl else buf_doc-line.price-base)
     1909               temp-goods-obj.sum-zak = if var-report-r-b = "rubl" then buf_doc-line.price-rubl else buf_doc-line.price-base
     1910               num-obj1 = num-obj1 + 1
     1911             .
     1912           end.
     1913           find last price-list no-lock
     1914             where price-list.obj-type   = obj-list.obj-type
     1915               and price-list.obj-code   = obj-list.obj-code
     1916               and price-list.b-code     = int(temp-goods.b-code)
     1917               and price-list.fact-order < v-fact-order-start
     1918             use-index fact-close no-error .
     1919           if available price-list then do:
     1920             assign
     1921               temp-goods.sum-prod     = temp-goods.sum-prod + price-list.price-sale
     1922               temp-goods-obj.sum-prod = price-list.price-sale
     1923               num-obj2 = num-obj2 + 1
     1924             .
     1925           end.
     1926         end.
     1927         assign
     1928           temp-goods.sum-zak  = temp-goods.sum-zak  / num-obj1
     1929           temp-goods.sum-prod = temp-goods.sum-prod / num-obj2
     1930         .
     1931       end.
     1932     end.
     1933   end procedure.
     1934   procedure PutColumnTitulExcel :
     1935     do
     1936     on error undo, return error return-value
     1937     :
     1938     assign
     1939       v-row = 4
     1940       v-col = 3
     1941       str1 = "Сравнительный отчет по ценам товара на объектах на " + String(x-date-start,"99/99/9999")
     1942     .
     1943     run macr_excel_char (str1, 1, 3) .
     1944     run macr_cell_format ( 11, yes, no, ?, 1, 3, 1, 3) .
     1945     run macr_excel_char ("Объекты: " + STR-obj , 2, 1) .
     1946     run macr_cell_format ( 11, yes, no, ?, 2, 1, 2, 1) .
     1947     if str2 = ? then assign  str2 = "" .
     1948     run macr_excel_char ( str2 , 3, 1) .
     1949     run macr_cell_format ( 11, yes, no, ?, 3, 1, 3, 1) .
     1950     run macr_excel_char("Код", v-row, 1) .
     1951     run macr_cell_size (14,?, v-row, 1,?,?).
     1952     run macr_excel_char("Артикул", v-row, 2) .
     1953     run macr_cell_size (14,?, v-row, 2,?,?).
     1954     run macr_excel_char("Наименование товара", v-row, 3) .
     1955     run macr_cell_size (40,?, v-row, 3,?,?).
     1956     run macr_excel_char("Производитель", v-row, 4) .
     1957     run macr_cell_size (40,?, v-row, 4,?,?).
     1958     assign v-col = 5 .
     1959     run macr_excel_char("Учет. цена посредника", v-row, v-col) .
     1960     assign v-col = 6 + num-obj .
     1961     run macr_excel_char("Сред. учет. цена", v-row, v-col) .
     1962     assign v-col = 7 + num-obj * 2 .
     1963     run macr_excel_char("Сред. продаж. цена", v-row, v-col) .
     1964     assign v-col = 8 + num-obj * 2 .
     1965     run macr_excel_char("Эффективность", v-row, v-col) .
     1966     assign v-col = 9 + num-obj * 2 .
     1967     run macr_excel_char("Наценка", v-row, v-col) .
     1968     assign v-col = 6 .
     1969     for each obj-list :
     1970       find first buf_clients no-lock
     1971         where buf_clients.obj-type = obj-list.obj-type
     1972           and buf_clients.obj-code = obj-list.obj-code
     1973       .
     1974       run macr_excel_char( "Учет. цена на " + buf_clients.obj-name,   v-row, v-col ) .
     1975       run macr_excel_char( "Продаж. цена на " + buf_clients.obj-name,   v-row, v-col + num-obj + 1 ) .
     1976       assign v-col = v-col + 1 .
     1977     end.
     1978     run macr_cell_bordur ( v-row, 1, v-row , 9 + num-obj * 2) .
     1979     run macr_cell_format ( 10, yes, no, 35, v-row, 1, v-row , 9 + num-obj * 2) .
     1980     assign  v-row = 5 .
     1981     end.
     1982   end procedure.
     1983   procedure PrintLine :
     1984     do on error undo, return error return-value :
     1985       if  ( v-row ) >= 63000 then do:
     1986         Output stream Macr_Excel  close .
     1987         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     1988         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1989         output stream  Macr_Excel to value(v-file-name) .
     1990         v-ind = v-ind + 1 .
     1991         run PutColumnTitulExcel in this-procedure .
     1992       end.
     1993       assign  v-col = 6  .
     1994       run macr_excel_char(temp-goods.b-code,   v-row, 1) .
     1995       run macr_excel_char(temp-goods.artic,    v-row, 2) .
     1996       run macr_excel_char(temp-goods.gds-name, v-row, 3) .
     1997       find first buf_clients no-lock where buf_clients.obj-type = temp-goods.prod-type and buf_clients.obj-code = temp-goods.prod-code .
     1998       run macr_excel_char(buf_clients.obj-name, v-row, 4) .
     1999       run macr_excel_sum (temp-goods.sum-posr,  v-row, 5, 2) .
     2000       run macr_excel_sum (temp-goods.sum-zak,   v-row, 6 + num-obj, 2) .
     2001       run macr_excel_sum (temp-goods.sum-prod,  v-row, 7 + num-obj * 2, 2) .
     2002       run macr_excel_sum (temp-goods.sum-prod - temp-goods.sum-posr,  v-row, 8 + num-obj * 2, 2) .
     2003       run macr_excel_sum ((temp-goods.sum-prod - temp-goods.sum-zak) * 100 / temp-goods.sum-zak ,  v-row, 9 + num-obj * 2, 2) .
     2004       for each temp-goods-obj where temp-goods-obj.gds-code = temp-goods.gds-code :
     2005         run macr_excel_sum (temp-goods-obj.sum-zak,   v-row, v-col, 2) .
     2006         run macr_excel_sum (temp-goods-obj.sum-prod,  v-row, v-col + num-obj + 1, 2) .
     2007         assign v-col = v-col + 1 .
     2008       end.
     2009       assign v-row = v-row + 1 .
     2010     end.
     2011   end procedure.
     2012   procedure macr_excel_char :
     2013    do
     2014    on error undo, return error return-value
     2015    :
     2016    define input parameter  p-val as character no-undo .
     2017    define input parameter  p-row as integer no-undo .
     2018    define input parameter  p-col as integer no-undo .
     2019         put  stream macr_excel unformatted
     2020           substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) skip  .
     2021    end.
     2022   end procedure.
     2023   procedure macr_excel_sum :
     2024    do
     2025    on error undo, return error return-value
     2026    :
     2027    define input parameter  p-val as decimal   no-undo .
     2028    define input parameter  p-row as integer   no-undo .
     2029    define input parameter  p-col as integer   no-undo .
     2030    define input parameter  p-typ as integer   no-undo .
     2031    if p-val = ? then assign p-val = 0 .
     2032    define variable ss as character no-undo .
     2033    assign
     2034      ss = string( Round( p-val, p-typ) )
     2035    .
     2036    put  stream macr_excel unformatted  substitute('formula(&3,"r&1c&2")', p-row , p-col , ss ) skip  .
     2037    end.
     2038   END procedure.
     2039   procedure macr_cell_format :
     2040    do
     2041    on error undo, return error return-value
     2042    :
     2043    define input parameter  p-size   as integer   no-undo .
     2044    define input parameter  p-bold   as logical   no-undo .
     2045    define input parameter  p-italic as logical   no-undo .
     2046    define input parameter  p-color  as integer   no-undo .
     2047    define input parameter  p-row    as integer   no-undo .
     2048    define input parameter  p-col    as integer   no-undo .
     2049    define input parameter  p-row-2  as integer   no-undo .
     2050    define input parameter  p-col-2  as integer   no-undo .
     2051     if p-size = ? then p-size = 10 .
     2052     if p-bold = ? then p-bold = false .
     2053     if p-italic = ? then p-italic = false .
     2054     if p-row-2 = ? then p-row-2 = p-row .
     2055     if p-col-2 = ? then p-col-2 = p-col .
     2056     put  stream macr_excel unformatted
     2057      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     2058     if p-color <> ? then do:
     2059        put  stream macr_excel unformatted
     2060          substitute('patterns(1,,&1,true)', p-color )  skip  .
     2061     end.
     2062     put  stream macr_excel unformatted
     2063          substitute('format.font(,&1,&2,&3)' , p-size,
     2064                                           string ( p-bold  , "true/false" ) ,
     2065                                           string ( p-italic , "true/false" )
     2066                                           ) skip .
     2067    end.
     2068   end procedure.
     2069   procedure macr_cell_bordur :
     2070    do
     2071    on error undo, return error return-value
     2072    :
     2073    define input parameter  p-row    as integer   no-undo .
     2074    define input parameter  p-col    as integer   no-undo .
     2075    define input parameter  p-row-2  as integer   no-undo .
     2076    define input parameter  p-col-2  as integer   no-undo .
     2077     if p-row-2 = ? then p-row-2 = p-row .
     2078     if p-col-2 = ? then p-col-2 = p-col .
     2079     put  stream macr_excel unformatted
     2080      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     2081     put  stream macr_excel unformatted
     2082          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  skip
     2083          'ALIGNMENT(3 , , 4 , 4 ,)'   skip
     2084          .
     2085    end.
     2086   end procedure.
     2087   procedure macr_cell_size :
     2088    do
     2089    on error undo, return error return-value
     2090    :
     2091    define input parameter  p-w   as integer   no-undo .
     2092    define input parameter  p-l   as integer   no-undo .
     2093    define input parameter  p-row    as integer   no-undo .
     2094    define input parameter  p-col    as integer   no-undo .
     2095    define input parameter  p-row-2  as integer   no-undo .
     2096    define input parameter  p-col-2  as integer   no-undo .
     2097     if p-row-2 = ? then p-row-2 = p-row .
     2098     if p-col-2 = ? then p-col-2 = p-col .
     2099     if p-w = ? then    p-w = 0 .
     2100     if p-l = ? then    p-l = 0 .
     2101    define variable s-w as character no-undo .
     2102    define variable s-l as character no-undo .
     2103    if p-w = 0 then s-w = "" .
     2104               else s-w = string(p-w)  .
     2105    if p-l = 0 then s-l = "" .
     2106               else s-l = string(p-l)  .
     2107   put  stream macr_excel unformatted
     2108        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2109   put  stream macr_excel unformatted
     2110        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2111   put  stream macr_excel unformatted
     2112        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2113    end.
     2114   end procedure.
     2115   procedure end-proc :
     2116    do
     2117    on error undo, return error return-value
     2118    :
     2119     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2120     OUTPUT to VALUE (v-file-name) .
     2121     for each temp-param :
     2122       export  temp-param  .
     2123     end.
     2124    end.
     2125   end procedure.
