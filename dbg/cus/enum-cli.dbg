        1   DEFINE BUFFER X_clients FOR ub.clients.
        2   DEFINE BUFFER X1_clients FOR ub.clients.
        3   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
        4   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        5   DEFINE INPUT PARAMETER  bttns       AS character NO-UNDO.
        6   DEFINE INPUT PARAMETER  p-list-mode AS character NO-UNDO.
        7   DEFINE INPUT PARAMETER  p-dop-par    AS character NO-UNDO.
        8   DEFINE input-output PARAMETER p-rid-list  AS character NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Коды фирм в системах клиентов".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define new global shared variable g#language as character no-undo .
      320   if g#language <> '' and g#language <> 'rus':U then do:
      321     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      322   end.
      323   procedure proc-alt-shift-f2:
      324     if not ibs.th.gbl.gbl-var:rcode
      325   then
      326     run gbl\inidebug.p .
      327   end.
      328   procedure proc-alt-shift-f3:
      329     run gbl/prvssinf.p
      330       ( input this-procedure
      331       ) .
      332   end.
      333   define variable v-inform-launched as logical no-undo initial false .
      334   procedure proc-alt-shift-f4:
      335     define variable v-action as character no-undo .
      336     if v-inform-launched = false then do:
      337       assign
      338         v-inform-launched = true
      339       .
      340       run gbl/d-inform.w
      341         (  input self
      342         ,  input this-procedure
      343         , output v-action
      344         ) no-error .
      345       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      346       assign
      347         v-inform-launched = false
      348       .
      349     end.
      350   end.
      351   procedure proc-alt-f1:
      352     run gbl/corrhelp.p
      353       (input this-procedure
      354       ) .
      355   end .
      356   on alt-shift-f2 anywhere do:
      357     run proc-alt-shift-f2.
      358   end.
      359   on alt-shift-f3 anywhere do:
      360     run proc-alt-shift-f3 in this-procedure .
      361   end.
      362   on alt-shift-f4 anywhere do:
      363     run proc-alt-shift-f4 in this-procedure.
      364   end.
      365   on alt-f1 anywhere do:
      366     run proc-alt-f1 in this-procedure .
      367   end.
      368   define new global shared variable g#library  as handle no-undo .
      369   define new global shared variable g#library2 as handle no-undo .
      370   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371     define variable v-cntxt-db-num        as integer   no-undo .
      372     define variable v-cntxt-userid        as character no-undo .
      373     define variable v-cntxt-level         as character no-undo .
      374     define variable v-cntxt-host-code-obj as integer   no-undo .
      375     define variable v-cntxt-obj-type      as character no-undo .
      376     define variable v-cntxt-obj-code      as integer   no-undo .
      377     define variable v-cntxt-db-num-obj    as integer   no-undo .
      378     define variable v-cntxt-is-admin      as logical   no-undo .
      379   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   procedure gen-key-rec :
      381     define input  parameter p-tbl-name    as character no-undo.
      382     define input  parameter p-bh_tbl-name as handle    no-undo.
      383     define output parameter p-key-rec     as character no-undo.
      384     do
      385     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      386     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      387     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      388     :
      389       define variable fh               as handle    no-undo .
      390       define variable v-ok             as logical   no-undo .
      391       define variable v-inform         as character no-undo .
      392       define variable v-ind            as integer   no-undo .
      393       define variable v-idx-field-qnty as integer   no-undo .
      394       if p-tbl-name = ?
      395         or p-tbl-name = "":U
      396       then do:
      397         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      398       end.
      399       if not p-bh_tbl-name:available then do:
      400         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      401       end.
      402       assign
      403         p-key-rec = p-tbl-name
      404         v-inform  = p-bh_tbl-name:index-information(1)
      405         v-ind     = 2
      406       .
      407       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      408       on error undo, return error
      409       :
      410         assign
      411           v-inform = p-bh_tbl-name:index-information( v-ind )
      412           v-ind    = v-ind + 1
      413         .
      414       end.
      415       if v-inform = ?
      416         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      417         or entry( 3, v-inform, ",":U ) <> "1":U
      418       then do:
      419         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      420       end.
      421       else do:
      422         assign
      423           v-idx-field-qnty = num-entries( v-inform ) - 4
      424         .
      425         if v-idx-field-qnty < 2 then do:
      426           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      427         end.
      428         do v-ind = 1 to v-idx-field-qnty by 2
      429         on error undo, return error
      430         :
      431           assign
      432             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      433             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      434           .
      435         end.
      436       end.
      437       if p-key-rec = ? then do:
      438         assign
      439           p-key-rec = "":U
      440         .
      441         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      442       end.
      443     end.
      444     return.
      445   end procedure.
      446   procedure gen-where-keyr-tab :
      447     define input  parameter i-tableSerach as character no-undo.
      448     define input  parameter i-tablekey   as character  no-undo.
      449     define input  parameter p-key-rec    as character  no-undo.
      450     define input  parameter p-key-handle as handle     no-undo .
      451     define input  parameter p-db-name    as character  no-undo .
      452     define input  parameter p-tt-handle  as handle     no-undo .
      453     define output parameter o-Where      as character  no-undo.
      454     do
      455     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      456     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      457     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      458     :
      459       define variable v-full-tbl-name  as character no-undo .
      460       define variable bh_tbl-name      as handle    no-undo .
      461       define variable fh_key           as handle    no-undo .
      462       define variable fh_search        as handle    no-undo .
      463       define variable v-field-num      as integer   no-undo .
      464       define variable v-count-fld      as integer   no-undo .
      465       define variable v-inform         as character no-undo .
      466       define variable v-ind            as integer   no-undo .
      467       define variable v-idx-field-qnty as integer   no-undo .
      468       define variable v-field-name     as character no-undo .
      469       define variable v-field-val      as character no-undo .
      470       define variable v-word-link      as character no-undo .
      471       define variable vTable           as character no-undo.
      472       define variable bh_tbl-key       as handle    no-undo .
      473       assign
      474         p-key-rec = trim( p-key-rec )
      475       .
      476       if p-key-handle <> ? then do:
      477         if not valid-handle(p-key-handle)
      478            or p-key-handle:type <> "buffer"
      479         then do:
      480           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      481         end.
      482         if num-entries( p-key-rec, chr(3) ) > 1
      483           or p-key-rec = ?
      484           or p-key-rec = "":U
      485         then do:
      486           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      487         end.
      488       end.
      489       else do:
      490         if p-key-rec = ?
      491           or p-key-rec = "":U
      492         then do:
      493           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      494         end.
      495       end.
      496       assign
      497         vTable = entry( 1 , p-key-rec, chr(3) )
      498       .
      499       if p-tt-handle <> ?
      500         and ( not valid-handle(p-tt-handle)
      501               or p-tt-handle:type <> "buffer"
      502             )
      503       then do:
      504         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      505       end.
      506       if p-tt-handle = ? then do:
      507         assign
      508           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      509         .
      510         create buffer bh_tbl-name for table v-full-tbl-name .
      511       end.
      512       else do:
      513         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      514       end.
      515       assign
      516         v-inform = bh_tbl-name:index-information(1)
      517         v-ind    = 2
      518       .
      519       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      520       on error undo, return error
      521       :
      522         assign
      523           v-inform = bh_tbl-name:index-information( v-ind )
      524           v-ind    = v-ind + 1
      525         .
      526       end.
      527       if v-inform = ?
      528         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      529         or entry( 3, v-inform, ",":U ) <> "1":U
      530       then do:
      531         delete object bh_tbl-name no-error.
      532         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      533       end.
      534       assign
      535         v-idx-field-qnty = num-entries( v-inform ) - 4
      536       .
      537       if v-idx-field-qnty < 2 then do:
      538         delete object bh_tbl-name no-error.
      539         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      540       end.
      541       assign
      542         o-where     = "where":U
      543         v-word-link = "":U
      544         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      545         v-count-fld = 0
      546       .
      547       if i-tablekey ne "" and i-tablekey ne ?
      548       then do:
      549         assign
      550           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      551         .
      552         create buffer bh_tbl-key for table v-full-tbl-name .
      553       end.
      554       if i-tableSerach ne "" and i-tableSerach ne ?
      555       then do:
      556         delete object bh_tbl-name no-error.
      557         assign
      558           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      559         .
      560         create buffer bh_tbl-name for table v-full-tbl-name .
      561       end.
      562       block_where:
      563       do v-ind = 1 to v-idx-field-qnty by 2
      564       on error undo, return error
      565       :
      566         assign
      567           v-count-fld = v-count-fld + 1
      568         .
      569         if p-key-handle = ?
      570           and v-count-fld > v-field-num
      571         then do:
      572           leave block_where.
      573         end.
      574         define variable VfieldKeyTable as handle no-undo.
      575         assign
      576           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      577           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      578         .
      579         if     bh_tbl-key ne ?
      580         then do:
      581            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      582            if VfieldKeyTable eq ?
      583            then next block_where.
      584         end.
      585         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      586         then
      587            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      588         else
      589            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      590         if p-key-handle = ? then do:
      591           assign
      592             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      593           .
      594         end.
      595         else do:
      596           assign
      597             fh_key = p-key-handle:buffer-field( v-field-name )
      598           .
      599           if fh_key = ?
      600             or not valid-handle( fh_key )
      601           then do:
      602             delete object bh_tbl-name.
      603             if     bh_tbl-key ne ?
      604             then
      605                delete object bh_tbl-key.
      606             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      607           end.
      608           assign
      609             v-field-val = fh_key:buffer-value
      610           .
      611         end.
      612         if fh_search:data-type ="character":U then do:
      613           assign
      614             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      615             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      616             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      617             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      618             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      619             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      620             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      621             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      622             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      623             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      624             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      625             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      626             v-field-val = substitute( '"&1"', v-field-val )
      627           .
      628         end.
      629         assign
      630           o-where = substitute( "&1 &2", o-where, v-field-val )
      631         .
      632         if v-word-link = "":U then do:
      633           assign
      634             v-word-link = "and":U
      635           .
      636         end.
      637       end.
      638       delete object bh_tbl-name.
      639       if     bh_tbl-key ne ?
      640       then
      641          delete object bh_tbl-key.
      642       if p-key-handle = ?
      643         and v-count-fld <> v-field-num
      644       then do:
      645         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      646       end.
      647     end.
      648   end procedure.
      649   procedure gen-hn-keyr-tab :
      650     define input  parameter i-tableSerach as character no-undo.
      651     define input  parameter i-tablekey   as character no-undo.
      652     define input  parameter p-key-rec    as character no-undo.
      653     define input  parameter p-key-handle as handle    no-undo .
      654     define input  parameter p-db-name    as character no-undo .
      655     define input  parameter p-tt-handle  as handle    no-undo .
      656     define input  parameter p-stts-lock  as integer   no-undo .
      657     define output parameter o-hn         as handle    no-undo.
      658     define variable v-full-tbl-name as character no-undo.
      659     define variable v-where         as character no-undo.
      660     define variable bh_tbl-name     as handle    no-undo.
      661     define variable vTable          as character no-undo.
      662     do
      663     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      664     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      665     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      666         run gen-where-keyr-tab(i-tableSerach,
      667                                i-tablekey,
      668                                p-key-rec,
      669                                p-key-handle,
      670                                p-db-name,
      671                                p-tt-handle,
      672                                output v-where).
      673         if i-tableSerach ne "" and i-tableSerach ne ?
      674         then do:
      675            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      676            create buffer bh_tbl-name for table v-full-tbl-name .
      677         end.
      678         else do:
      679            if p-tt-handle = ? then do:
      680               assign
      681                  vTable = entry( 1 , p-key-rec, chr(3) )
      682               .
      683               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      684               create buffer bh_tbl-name for table v-full-tbl-name .
      685            end.
      686            else do:
      687               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      688            end.
      689         end.
      690         if p-tt-handle = ? then do:
      691            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      692         end.
      693         else do:
      694            bh_tbl-name:find-first( v-where ) no-error .
      695         end.
      696         o-hn = bh_tbl-name.
      697      end.
      698   end procedure.
      699   procedure gen-hn-keyr :
      700     define input  parameter p-key-rec    as character no-undo.
      701     define input  parameter p-key-handle as handle    no-undo .
      702     define input  parameter p-db-name    as character no-undo .
      703     define input  parameter p-tt-handle  as handle    no-undo .
      704     define input  parameter p-stts-lock  as integer   no-undo .
      705     define output parameter o-hn         as handle    no-undo.
      706     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      707   end.
      708   procedure gen-row-keyr :
      709     define input  parameter p-key-rec    as character no-undo.
      710     define input  parameter p-key-handle as handle    no-undo .
      711     define input  parameter p-db-name    as character no-undo .
      712     define input  parameter p-tt-handle  as handle    no-undo .
      713     define input  parameter p-stts-lock  as integer   no-undo .
      714     define output parameter p-tbl-row    as rowid     no-undo.
      715     define output parameter p-tbl-name   as character no-undo.
      716     define variable vHn as handle no-undo.
      717       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      718       p-tbl-row = if vHn:available then vHn:rowid else ?.
      719       p-tbl-name =  vHn:table.
      720       delete object vHn no-error.
      721     if p-tbl-row = ? then do:
      722       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      723     end.
      724     else do:
      725       return.
      726     end.
      727   end procedure.
      728   procedure gen-key-fv :
      729     define input  parameter p-key-rec    as character no-undo .
      730     define output parameter p-field-list as character no-undo .
      731     define output parameter p-value-list as character no-undo.
      732     do
      733     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      734     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      735     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      736     :
      737       define variable v-full-tbl-name  as character no-undo .
      738       define variable bh_tbl-name      as handle    no-undo .
      739       define variable v-tbl-name       as character no-undo .
      740       define variable v-field-num      as integer   no-undo .
      741       define variable v-count-fld      as integer   no-undo .
      742       define variable v-inform         as character no-undo .
      743       define variable v-ind            as integer   no-undo .
      744       define variable v-idx-field-qnty as integer   no-undo .
      745       define variable v-delim-key      as character no-undo .
      746       if p-key-rec = ?
      747         or p-key-rec = "":U
      748       then do:
      749         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      750       end.
      751       assign
      752         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      753         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      754       .
      755       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      756       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      757       assign
      758         v-inform = bh_tbl-name:index-information(1)
      759         v-ind    = 2
      760       .
      761       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      762       on error undo, return error
      763       :
      764         assign
      765           v-inform = bh_tbl-name:index-information( v-ind )
      766           v-ind    = v-ind + 1
      767         .
      768       end.
      769       if v-inform = ?
      770         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      771         or entry( 3, v-inform, ",":U ) <> "1":U
      772       then do:
      773         delete object bh_tbl-name no-error.
      774         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      775       end.
      776       assign
      777         v-idx-field-qnty = num-entries( v-inform ) - 4
      778       .
      779       if v-idx-field-qnty < 2 then do:
      780         delete object bh_tbl-name no-error.
      781         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      782       end.
      783       assign
      784         p-field-list = "":U
      785         p-value-list = "":U
      786         v-delim-key  = "":U
      787         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      788         v-count-fld  = 0
      789       .
      790       block_where:
      791       do v-ind = 1 to v-idx-field-qnty by 2
      792       on error undo, return error
      793       :
      794         assign
      795           v-count-fld = v-count-fld + 1
      796         .
      797         if v-count-fld > v-field-num then do:
      798           leave block_where.
      799         end.
      800         assign
      801           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      802           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      803         .
      804         if v-ind = 1 then do:
      805           assign
      806             v-delim-key = chr(3)
      807           .
      808         end.
      809       end.
      810       delete object bh_tbl-name.
      811       if v-count-fld <> v-field-num then do:
      812         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      813       end.
      814     end.
      815   end procedure.
      816   procedure gen-key-field :
      817     define input  parameter p-table      as character no-undo .
      818     define output parameter p-field-list as character no-undo .
      819     do
      820     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      821     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      822     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      823     :
      824       define variable v-full-tbl-name  as character no-undo .
      825       define variable bh_tbl-name      as handle    no-undo .
      826       define variable v-tbl-name       as character no-undo .
      827       define variable v-field-num      as integer   no-undo .
      828       define variable v-count-fld      as integer   no-undo .
      829       define variable v-inform         as character no-undo .
      830       define variable v-ind            as integer   no-undo .
      831       define variable v-idx-field-qnty as integer   no-undo .
      832       define variable v-delim-key      as character no-undo .
      833       if p-table = ?
      834         or p-table = "":U
      835       then do:
      836         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      837       end.
      838       assign
      839         v-tbl-name      = p-table
      840         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      841       .
      842       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      843       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      844       assign
      845         v-inform = bh_tbl-name:index-information(1)
      846         v-ind    = 2
      847       .
      848       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      849       on error undo, return error
      850       :
      851         assign
      852           v-inform = bh_tbl-name:index-information( v-ind )
      853           v-ind    = v-ind + 1
      854         .
      855       end.
      856       if v-inform = ?
      857         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      858         or entry( 3, v-inform, ",":U ) <> "1":U
      859       then do:
      860         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      861       end.
      862       assign
      863         v-idx-field-qnty = num-entries( v-inform ) - 4
      864       .
      865       if v-idx-field-qnty < 2 then do:
      866         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      867       end.
      868       assign
      869         p-field-list = "":U
      870         v-delim-key  = "":U
      871         v-count-fld  = 0
      872       .
      873       block_where:
      874       do v-ind = 1 to v-idx-field-qnty by 2
      875       on error undo, return error
      876       :
      877         assign
      878           v-count-fld = v-count-fld + 1
      879         .
      880         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      881         if v-ind = 1 then do:
      882           assign
      883             v-delim-key = chr(3)
      884           .
      885         end.
      886       end.
      887       delete object bh_tbl-name.
      888     end.
      889   end procedure.
      890   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      891   define variable c-point  as character no-undo .
      892   define variable tbl      as character no-undo .
      893   define variable join-tbl as character no-undo .
      894   define variable fld      as character no-undo .
      895   define variable lab      as character no-undo .
      896   define variable spr      as character no-undo .
      897   define variable dim      as character no-undo .
      898   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   procedure fltfield-clear :
      900     define output parameter loc-fld as character no-undo.
      901     define output parameter loc-lab as character no-undo .
      902     define output parameter loc-spr as character no-undo .
      903     define output parameter loc-dim as character no-undo .
      904     assign
      905       loc-fld = ""
      906       loc-lab = ""
      907       loc-spr = ""
      908       loc-dim = "0"
      909     .
      910   end procedure .
      911   procedure fltfield-add :
      912     define input        parameter par-fld as character no-undo.
      913     define input        parameter par-lab as character no-undo .
      914     define input        parameter par-spr as character no-undo .
      915     define input-output parameter loc-fld as character no-undo.
      916     define input-output parameter loc-lab as character no-undo .
      917     define input-output parameter loc-spr as character no-undo .
      918     define input-output parameter loc-dim as character no-undo .
      919     do
      920     on error undo, return error
      921     :
      922       assign
      923       loc-fld = if loc-dim = '0'
      924                 then par-fld
      925                 else (loc-fld + chr(44) + par-fld)
      926       loc-lab = if loc-dim = '0'
      927                 then par-lab
      928                 else (loc-lab + chr(44) + par-lab)
      929       loc-spr = if loc-dim = '0'
      930                 then par-spr
      931                 else (loc-spr + chr(44) + par-spr)
      932       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      933                 string(integer(if num-entries(loc-dim) > 1
      934                               then entry(2, loc-dim)
      935                               else entry(1, loc-dim)
      936                               ) + 1)
      937       no-error
      938       .
      939     end.
      940   end procedure.
      941   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   FUNCTION mark-string RETURNS CHARACTER
      943     ( input p-recid as recid, input mark-list as character  ) :
      944     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      945   END FUNCTION.
      946   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   procedure cur-time :
      949      define output parameter p-today as date      no-undo .
      950      define output parameter p-time  as integer   no-undo .
      951     do
      952     on error undo, return error
      953     :
      954       define variable v-date1 as date      no-undo .
      955       define variable v-date2 as date      no-undo .
      956       define variable v-time  as integer   no-undo .
      957       assign
      958         v-date1 = today
      959         v-time  = time
      960         v-date2 = today
      961       .
      962       if v-date1 <> v-date2
      963       then do:
      964         assign
      965           v-date1 = today
      966           v-time  = v-time
      967         .
      968       end.
      969       assign
      970         p-today = v-date1
      971         p-time  = v-time
      972       .
      973     end.
      974   end.
      975   function cur-time-date returns character
      976   :
      977     return string(today, '99/99/9999':U) .
      978   end.
      979   function cur-time-mjd returns decimal
      980   :
      981     define variable v-date as date      no-undo .
      982     define variable v-time as integer   no-undo .
      983     run cur-time in this-procedure
      984       (output v-date
      985       ,output v-time
      986       ) .
      987     return integer(v-date) - 2400002 + (v-time / 86400) .
      988   end.
      989   function cur-time-get-ending-index returns integer
      990   (input p-number as integer
      991   )
      992   :
      993     if p-number < 0
      994     or p-number = ?
      995     then do:
      996       return 1 .
      997     end.
      998     define variable v-rest as integer   no-undo .
      999     assign
     1000       p-number = p-number modulo 100
     1001     .
     1002     if p-number < 20
     1003     then do:
     1004       assign
     1005         v-rest = p-number
     1006       .
     1007     end.
     1008     else do:
     1009       assign
     1010         v-rest = p-number modulo 10
     1011       .
     1012     end.
     1013     case v-rest :
     1014       when 1
     1015       then do:
     1016         return 2 .
     1017       end.
     1018       when 2 or
     1019       when 3 or
     1020       when 4
     1021       then do:
     1022         return 3 .
     1023       end.
     1024       otherwise do:
     1025         return 1 .
     1026       end.
     1027     end case .
     1028   end.
     1029   procedure cur-time-mjd-to-date :
     1030      define input  parameter i-mjd-diff as decimal no-undo.
     1031      define output parameter o-Date     as date    no-undo.
     1032      define output parameter o-Time     as integer no-undo.
     1033      define variable v-day-number as integer   no-undo .
     1034      if    i-mjd-diff < 0
     1035         or i-mjd-diff = ?
     1036      then do:
     1037         return "?" .
     1038      end.
     1039      assign
     1040         v-day-number = truncate(i-mjd-diff,0).
     1041         o-Date = date(v-day-number + 2400002).
     1042         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1043     .
     1044   end.
     1045   function cur-time-mjd-to-string returns character
     1046   (input p-mjd-diff as decimal
     1047   )
     1048   :
     1049     define variable v-day-number as integer   no-undo .
     1050     define variable v-seconds    as integer   no-undo .
     1051     define variable v-hour       as integer   no-undo .
     1052     define variable v-min        as integer   no-undo .
     1053     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1054     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1055     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1056     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1057     if p-mjd-diff < 0
     1058     or p-mjd-diff = ?
     1059     then do:
     1060       return "?" .
     1061     end.
     1062     assign
     1063       v-day-number = integer(truncate(p-mjd-diff,0))
     1064       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1065     .
     1066     if v-seconds > 86400
     1067     then do:
     1068       assign
     1069         v-seconds = 86400 - 1
     1070       .
     1071     end.
     1072     if v-seconds < 0
     1073     then do:
     1074       assign
     1075         v-seconds = 0
     1076       .
     1077     end.
     1078     assign
     1079       v-hour = truncate(v-seconds / 3600, 0)
     1080     .
     1081     assign
     1082       v-seconds = v-seconds modulo 3600
     1083     .
     1084     assign
     1085       v-min = truncate(v-seconds / 60, 0)
     1086     .
     1087     assign
     1088       v-seconds = v-seconds modulo 60
     1089     .
     1090     return
     1091         (if v-day-number <> 0
     1092           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1093           else ""
     1094         )
     1095       + (if v-day-number <> 0 or v-hour <> 0
     1096           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1097           else ""
     1098         )
     1099       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1100           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1101           else ""
     1102         )
     1103       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1104       .
     1105   end.
     1106   function cur-time-string returns character
     1107   :
     1108     define variable v-date as date      no-undo .
     1109     define variable v-time as integer   no-undo .
     1110     run cur-time in this-procedure
     1111       (output v-date
     1112       ,output v-time
     1113       ) .
     1114     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1115   end.
     1116   function cur-time-string-sec returns character
     1117   :
     1118     define variable v-date as date      no-undo .
     1119     define variable v-time as integer   no-undo .
     1120     run cur-time in this-procedure
     1121       (output v-date
     1122       ,output v-time
     1123       ) .
     1124     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1125   end.
     1126   function cur-time-custom  returns character
     1127   (input p-prefix as character
     1128   ,input p-date-format as character
     1129   ,input p-delimiter as character
     1130   ,input p-time-format as character
     1131   ,input p-suffix as character
     1132   )
     1133   :
     1134     define variable v-date as date      no-undo .
     1135     define variable v-time as integer   no-undo .
     1136     run cur-time in this-procedure
     1137       (output v-date
     1138       ,output v-time
     1139       ) .
     1140     return
     1141       p-prefix
     1142       + string(v-date, p-date-format)
     1143       + p-delimiter
     1144       + string(v-time, p-time-format)
     1145       + p-suffix
     1146       .
     1147   end.
     1148   function cur-time-print  returns character
     1149   :
     1150     define variable v-date as date      no-undo .
     1151     define variable v-time as integer   no-undo .
     1152     run cur-time in this-procedure
     1153       (output v-date
     1154       ,output v-time
     1155       ) .
     1156     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1157   end.
     1158   function cur-time-datetime returns datetime
     1159   :
     1160     define variable v-char as character no-undo .
     1161     define variable v-datetime as datetime no-undo .
     1162     v-char = cur-time-string().
     1163     v-datetime = datetime(v-char).
     1164     return  v-datetime.
     1165   end.
     1166   function cur-time-string-msec returns character
     1167   :
     1168     define variable v-date as datetime  no-undo .
     1169     v-date = now.
     1170     return string(v-date) .
     1171   end.
     1172   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1174   define  shared variable RepPathName        as character no-undo .
