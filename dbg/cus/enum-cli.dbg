     1177   define  stream PrnLibStream.
     1178   procedure prn-lib-prn-file :
     1179     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1180     define input parameter p-DIsabledoptions as integer no-undo .
     1181     define variable v-report-name as character no-undo .
     1182     define variable v-user-action as character no-undo .
     1183     define variable v-printed     as logical   no-undo .
     1184     define variable v-exist       as logical   no-undo .
     1185     do
     1186       on error undo, return error
     1187       :
     1188       run prn-lib-get-report-name  in this-procedure (
     1189         input parParentProc
     1190         ,output v-report-name
     1191         ).
     1192   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1194     (input  v-report-name
     1195     ,input  2
     1196     ,output v-exist
     1197     )  .
     1198       if NOT v-exist then
     1199       DO:
     1200         Message
     1201           "Нет заданий на печать ! "
     1202           view-as alert-box .
     1203         Return  .
     1204       End.
     1205       run gbl/prnfilen.w
     1206         (input  ""
     1207         ,input  p-DisabledOptions
     1208         ,input  string(v-report-name )
     1209         ,input  7
     1210         ,output v-user-action
     1211         ,output v-printed
     1212         ) .
     1213       if v-printed then
     1214       do:
     1215         return "YES" .
     1216       end.
     1217       else
     1218       do:
     1219         return "NO" .
     1220       end.
     1221     end.
     1222   end procedure.
     1223   procedure prn-lib-open-stream :
     1224     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1225     define input parameter p-page-size    as integer no-undo .
     1226     define input parameter p-is-stream    as logical no-undo .
     1227     define input parameter p-append       as logical no-undo .
     1228     define variable v-report-name as character no-undo .
     1229     do
     1230       on error undo, return error
     1231       :
     1232       run prn-lib-get-report-name  in this-procedure (
     1233         input parParentProc
     1234         ,output v-report-name
     1235         ).
     1236       if p-is-stream then
     1237       do:
     1238         if p-append then
     1239         do:
     1240           output stream PrnLibStream to value( v-report-name )
     1241             page-size value(p-page-size) append .
     1242         end.
     1243         if not p-append then
     1244         do:
     1245           output stream PrnLibStream to value( v-report-name )
     1246             page-size value(p-page-size) .
     1247         end.
     1248       end.
     1249       if not p-is-stream then
     1250       do:
     1251         if p-append then
     1252         do:
     1253           output to value( v-report-name )
     1254             page-size value(p-page-size) append .
     1255         end.
     1256         if not p-append then
     1257         do:
     1258           output to value( v-report-name )
     1259             page-size value(p-page-size) .
     1260         end.
     1261       end.
     1262     end.
     1263   end procedure.
     1264   procedure prn-lib-open-exp :
     1265     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1266     define input parameter p-is-stream    as logical no-undo .
     1267     define input parameter p-is-append    as logical no-undo .
     1268     define output parameter p-ReportFileName as char init "report" no-undo.
     1269     define output parameter p-process as logical no-undo .
     1270     define variable glog as logical no-undo .
     1271     do
     1272       on error undo, return error
     1273       :
     1274       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1275         TITLE      "Укажите путь"
     1276         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1277         ASK-OVERWRITE
     1278         CREATE-TEST-FILE
     1279         SAVE-AS
     1280         USE-FILENAME
     1281         DEFAULT-EXTENSION "txt"
     1282         UPDATE glog
     1283         .
     1284       if not glog then  return.
     1285       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1286       if p-is-stream then
     1287       do:
     1288         if p-is-append then
     1289         do:
     1290           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1291         end.
     1292         else
     1293         do:
     1294           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1295         end.
     1296       end.
     1297       else
     1298       do:
     1299         if p-is-append then
     1300         do:
     1301           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1302         end.
     1303         else
     1304         do:
     1305           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1306         end.
     1307       end.
     1308       p-process = yes.
     1309     end.
     1310   end procedure.
     1311   procedure prn-lib-get-report-name :
     1312     define input parameter parParentProc  as widget-handle no-undo.
     1313     define output parameter p-report-name as character no-undo .
     1314     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1315   end procedure.
     1316   procedure prn-lib-reportviewer-report-name :
     1317     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1318     define input parameter p-report-name-html as character no-undo .
     1319     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1320   end procedure.
     1321   procedure prn-lib-reportviewer :
     1322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1323     define input parameter p-report-name-html as character no-undo .
     1324     define input parameter p-param        as character no-undo .
     1325     define variable v-excel           as character no-undo init 'TRUE' .
     1326     define variable v-value-character as character no-undo .
     1327     define variable v-value-integer   as character no-undo .
     1328     define variable v-value-date      as date      no-undo .
     1329     define variable v-value-decimal   as decimal   no-undo .
     1330     define variable rep-excel         as logical   no-undo .
     1331     define variable excel-string      as character no-undo .
     1332     define variable v-param-type      as character no-undo .
     1333     define variable v-tth             as handle    no-undo .
     1334     run adm/shattri.p (
     1335       input "get":U
     1336       ,input  ""
     1337       ,input  0
     1338       ,input  'report-glob':U
     1339       ,input  'rep-excel':U
     1340       ,output v-value-character
     1341       ,output v-value-date
     1342       ,output v-value-decimal
     1343       ,output v-value-integer
     1344       ,output rep-excel
     1345       ,output v-param-type
     1346       ,INPUT-OUTPUT table-handle v-tth
     1347       )  .
     1348     if rep-excel then v-excel = "TRUE" .
     1349     else v-excel = "FALSE" .
     1350     if p-param eq ""
     1351     then
     1352        p-param = "EXCEL:" + v-excel.
     1353     else
     1354        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1355     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1356   end procedure.
     1357   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1359   procedure fltopend_fltopend :
     1360   define input parameter p-parent-handle as handle no-undo .
     1361   define input parameter p-qh as handle no-undo .
     1362   define input parameter p-flt-open-open-query  as character no-undo .
     1363   define input parameter p-where-cond as character no-undo .
     1364   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1365   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1366   define input parameter p-indexed-reposition as character no-undo .
     1367     do
     1368     on error undo, return error
     1369     :
     1370   define variable v-prepare-string as character no-undo .
     1371   define variable glog as logical no-undo .
     1372   assign
     1373   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1374                      p-where-cond + chr(32)  +
     1375                      p-use-indFIRST-query-tail + chr(32) +
     1376                      p-use-ind-sort-clmn-by + chr(32) +
     1377                      p-indexed-reposition
     1378   .
     1379   assign
     1380   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1381   if not glog
     1382   or error-status:error then do:
     1383     message error-status:get-message(1) view-as alert-box .
     1384     undo, return error .
     1385   end.
     1386   assign
     1387   glog = p-qh:query-open no-error .
     1388   if not glog
     1389   or error-status:error then do:
     1390     message error-status:get-message(1) view-as alert-box .
     1391     undo, return error .
     1392   end.
     1393     end.
     1394   end procedure.
     1395   procedure fltopend_fltfindd :
     1396   define input parameter p-parent-handle as handle no-undo .
     1397   define input parameter p-qh as handle no-undo .
     1398   define input parameter p-rowid as rowid no-undo .
     1399   define input parameter p-next as logical no-undo .
     1400   define input parameter p-lock as integer no-undo .
     1401   define input parameter p-bh as handle no-undo .
     1402   define input parameter p-where-cond as character no-undo .
     1403   define input parameter p-use-index-phrase as character no-undo .
     1404   define variable glog as logical no-undo .
     1405   define variable v-qh as handle no-undo .
     1406   define variable v-bh as handle no-undo .
     1407   define variable v-recid as recid no-undo .
     1408   define variable v-prepare-string as character no-undo .
     1409   do
     1410   on error undo, return error
     1411   on stop undo, return error
     1412   :
     1413     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1414     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1415     create query v-qh.
     1416     v-qh:set-buffers(v-bh).
     1417     v-prepare-string = substitute("for each &1 &2 &3"
     1418                                     ,v-bh:name
     1419                                     ,p-where-cond
     1420                                     ,p-use-index-phrase).
     1421     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1422     if not glog then do:
     1423       delete object v-qh.
     1424       delete object v-bh.
     1425       undo, return error .
     1426     end.
     1427     glog = v-qh:query-open no-error .
     1428     if not glog then do:
     1429       delete object v-qh.
     1430       delete object v-bh.
     1431       undo, return error .
     1432     end.
     1433     if p-next then do:
     1434       v-qh:reposition-to-rowid(p-rowid) no-error .
     1435       glog = v-qh:get-next( p-lock) no-error .
     1436       glog = v-qh:get-next( p-lock) no-error .
     1437       if not glog or v-qh:query-off-end = yes then do:
     1438         glog = v-qh:get-first( p-lock) no-error .
     1439       end.
     1440     end.
     1441     else do:
     1442       glog = v-qh:get-first( p-lock) no-error .
     1443     end.
     1444     v-recid = v-bh:recid no-error .
     1445     delete object v-qh.
     1446     delete object v-bh.
     1447     return string(v-recid) .
     1448   end.
     1449   end procedure.
     1450   procedure fltopend_fltfindq :
     1451   define input parameter p-parent-handle as handle no-undo .
     1452   define input parameter p-qh as handle no-undo .
     1453   define input parameter p-next as logical no-undo .
     1454   define input parameter p-lock as integer no-undo .
     1455   define input parameter p-flt-open-open-query  as character no-undo .
     1456   define input parameter p-where-cond as character no-undo .
     1457   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1458   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1459   define input parameter p-indexed-reposition as character no-undo .
     1460   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1461   define variable glog as logical no-undo .
     1462   define variable v-qh as handle no-undo .
     1463   define variable v-bh as handle no-undo extent 18.
     1464   define variable v-rowid as rowid no-undo extent 18.
     1465   define variable v-ii as integer no-undo .
     1466   define variable v-prepare-string as character no-undo .
     1467   do
     1468   on error undo, return error
     1469   on stop undo, return error
     1470   :
     1471     create query v-qh.
     1472     do v-ii = 1 to p-qh:num-buffers:
     1473       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1474       assign
     1475       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1476       no-error.
     1477       v-qh:add-buffer(v-bh[v-ii]).
     1478     end.
     1479     assign
     1480     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1481                       p-where-cond + chr(32)  +
     1482                       p-use-indFIRST-query-tail + chr(32) +
     1483                       p-use-ind-sort-clmn-by + chr(32) +
     1484                       p-indexed-reposition
     1485     .
     1486     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1487     if not glog then do:
     1488       delete object v-qh.
     1489       do v-ii = 1 to p-qh:num-buffers:
     1490         delete object v-bh[v-ii].
     1491       end.
     1492       undo, return error .
     1493     end.
     1494     glog = v-qh:query-open no-error .
     1495     if not glog then do:
     1496       delete object v-qh.
     1497       do v-ii = 1 to p-qh:num-buffers:
     1498         delete object v-bh[v-ii].
     1499       end.
     1500       undo, return error .
     1501     end.
     1502     if p-next then do:
     1503       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1504       glog = v-qh:get-next( p-lock) no-error .
     1505       glog = v-qh:get-next( p-lock) no-error .
     1506       if not glog or v-qh:query-off-end = yes then do:
     1507         glog = v-qh:get-first( p-lock) no-error .
     1508       end.
     1509     end.
     1510     else do:
     1511       glog = v-qh:get-first( p-lock) no-error .
     1512     end.
     1513     do v-ii = 1 to p-qh:num-buffers:
     1514       assign
     1515       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1516       no-error.
     1517     end.
     1518     delete object v-qh.
     1519     do v-ii = 1 to p-qh:num-buffers:
     1520       delete object v-bh[v-ii].
     1521     end.
     1522   end.
     1523   end procedure.
     1524   define variable sort-column-name as character no-undo.
     1525   define variable filter-point     as character NO-UNDO INIT "enum-cli".
     1526   define variable filter-label     as character NO-UNDO INIT "Коды фирм в системах клиентов".
     1527   define variable filter-point0    as character NO-UNDO INIT "enum-cli".
     1528   define variable filter-label0    as character NO-UNDO INIT "Коды фирм в системах клиентов".
     1529   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1530   define variable v-host-code as integer no-undo .
     1531   FUNCTION get-firm-name RETURNS CHARACTER
     1532     ( INPUT p-host-code AS integer )  FORWARD.
     1533   DEFINE BUTTON b-add
     1534        LABEL "&Добавить"
     1535        SIZE 10 BY 1.
     1536   DEFINE BUTTON b-cli
     1537        LABEL "Клиент"
     1538        SIZE 10 BY 1.
     1539   DEFINE BUTTON b-del
     1540        LABEL "&Удалить"
     1541        SIZE 10 BY 1.
     1542   DEFINE BUTTON b-sconf
     1543        LABEL "Фирма"
     1544        SIZE 10 BY 1.
     1545   DEFINE BUTTON B-Help
     1546        LABEL "Помо&щь"
     1547        SIZE 3 BY 1
     1548        BGCOLOR 8 .
     1549   DEFINE BUTTON B-mark
     1550        LABEL "&*"
     1551        SIZE 3 BY 1.
     1552   DEFINE BUTTON b-print
     1553        LABEL "&Печать"
     1554        SIZE 3 BY 1.
     1555   DEFINE BUTTON b-quit AUTO-END-KEY
     1556        LABEL "&Выход"
     1557        SIZE 10 BY 1
     1558        BGCOLOR 8 .
     1559   DEFINE BUTTON b-sch
     1560        LABEL "Фильтр"
     1561        SIZE 3 BY 1.
     1562   DEFINE BUTTON B-sel AUTO-GO
     1563        LABEL "Вы&бор"
     1564        SIZE 10 BY 1.
     1565   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1566         VIEW-AS TEXT
     1567        SIZE 6 BY 1
     1568        FGCOLOR 4  NO-UNDO.
     1569   DEFINE QUERY br-enum-cli FOR X_ext-classif, X_clients SCROLLING.
     1570   DEFINE BROWSE br-enum-cli
     1571     QUERY br-enum-cli NO-LOCK DISPLAY
     1572         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1573   X_ext-classif.KEY#_one  COLUMN-LABEL "Код фирмы" FORMAT ">>>>9"
     1574   get-firm-name(X_ext-classif.KEY#_one) COLUMN-LABEL "Фирма" FORMAT "X(30)"
     1575   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     1576   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     1577   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(60)"
     1578   X_ext-classif.CharKey_Three COLUMN-LABEL "Код фирмы!в системе клиента" FORMAT "X(20)"
     1579       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 20.37 FIT-LAST-COLUMN.
     1580   DEFINE FRAME Dialog-Frame
     1581        b-quit AT ROW 1 COL 1
     1582        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1583        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1584        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1585        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1586        b-cli AT ROW 1 COL 51 WIDGET-ID 2
     1587        b-sconf AT ROW 1 COL 61 WIDGET-ID 18
     1588        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1589        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1590        B-Help AT ROW 1 COL 95
     1591        br-enum-cli AT ROW 2.87 COL 1.5 WIDGET-ID 100
     1592        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1593        SPACE(79.30) SKIP(21.26)
     1594       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1595            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1596            TITLE ""
     1597            CANCEL-BUTTON b-quit.
     1598   ASSIGN
     1599          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1600          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1601   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1602   DO:
     1603     APPLY "END-ERROR":U TO SELF.
     1604   END.
     1605   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1606   DO:
     1607     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1608     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1609   END.
     1610   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1611   DO:
     1612     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1613     run ref/showcli.p ( INPUT parparentproc
     1614                        ,INPUT X_clients.obj-type
     1615                        ,INPUT X_clients.obj-code) NO-ERROR.
     1616     APPLY "entry" TO br-enum-cli.
     1617   END.
     1618   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1619   DO:
     1620     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1621     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1622     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1623   END.
     1624   ON CHOOSE OF b-sconf IN FRAME Dialog-Frame
     1625   DO:
     1626   define variable v-have-rights    as logical        no-undo.
     1627   define variable v-success    as logical        no-undo.
     1628   define variable v-host-code   as integer        no-undo.
     1629     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1630     ASSIGN
     1631     v-host-code = X_ext-classif.key#_one.
     1632     run adm/config.w (
     1633                        input parparentproc
     1634                       ,input v-host-code
     1635                       ,input  'ПРОСМОТР':U
     1636                       ,input no
     1637                      ) no-error.
     1638     if error-status:error then return no-apply.
     1639     APPLY "entry" TO br-enum-cli.
     1640   END.
     1641   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1642   DO:
     1643     define variable loc#log as logical no-undo .
     1644     if available X_ext-classif then do:
     1645   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1646   define variable v-str-recid14 as character no-undo .
     1647   define variable v-num-entry14 as integer   no-undo .
     1648   assign
     1649     v-str-recid14 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1650     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1651   .
     1652   if v-num-entry14 > 0 then do:
     1653     assign
     1654       entry( v-num-entry14, v-rid-list ) = "":U
     1655       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1656     .
     1657   end.
     1658   else do:
     1659     assign
     1660       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1661     .
     1662   end.
     1663       loc#log = br-enum-cli:refresh() .
     1664       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1665           loc#log = br-enum-cli:select-next-row ().
     1666           apply "VALUE-CHANGED" to br-enum-cli in frame Dialog-Frame.
     1667       end.
     1668       if num-entries( v-rid-list ) = 0
     1669       then
     1670           hide mark-num in frame Dialog-Frame.
     1671       else
     1672           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1673     end.
     1674     apply "entry" to br-enum-cli in frame Dialog-Frame.
     1675   END.
     1676   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1677   DO:
     1678     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1679     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1680   END.
     1681   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1682   DO:
     1683     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1684     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1685   END.
     1686   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1687   DO:
     1688       if ( available X_ext-classif ) then do:
     1689       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1690       then
     1691       v-rid-list = string( recid( X_ext-classif ) ) .
     1692     end.
     1693   END.
     1694   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1695   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1696   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697   on help of frame Dialog-Frame
     1698   do:
     1699     run gbl/app_help.p
     1700       (input this-procedure :file-name
     1701       ,input ''
     1702       ,input ?
     1703       ) no-error.
     1704     if error-status :error then do:
     1705       message
     1706         "Ошибка при вызове помощи"
     1707         error-status :get-message(1)
     1708         view-as alert-box .
     1709     end.
     1710   end.
     1711   run minbtn-set in this-procedure .
     1712   on choose of b-help in frame Dialog-Frame
     1713   do:
     1714     apply "help":u to frame Dialog-Frame .
     1715   end.
     1716   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   procedure minbtn-set :
     1718       do
     1719           on error undo, return error return-value
     1720           :
     1721           define variable ii              as integer       no-undo .
     1722           define variable fh              as widget-handle no-undo .
     1723           define variable hh              as widget-handle no-undo .
     1724           define variable v-h             as handle        extent 4 no-undo .
     1725           define variable v-name-button   as character     no-undo .
     1726           define variable v-help-old-x    as decimal       no-undo .
     1727           define variable v-help-old-y    as decimal       no-undo .
     1728           define variable v-help-old-size as decimal       no-undo .
     1729           define variable v-frame-width   as decimal       no-undo .
     1730           define variable jj              as integer       no-undo .
     1731           do
     1732               on error undo, return error
     1733               :
     1734               assign
     1735                   v-frame-width = frame Dialog-Frame:width - 0.3
     1736                   fh            = frame Dialog-Frame:first-child
     1737                   hh            = fh:first-child
     1738                   ii            = 1
     1739                   .
     1740               do while valid-handle(hh):
     1741                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1742                   do:
     1743                       case lc(hh:name) :
     1744                           when "b-help" then
     1745                               do:
     1746                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1747                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1748                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1749                                   hh:TOOLTIP = "Помощь" .
     1750                                   v-help-old-x = hh:column .
     1751                                   v-help-old-y = hh:row    .
     1752                                   v-help-old-size = hh:width .
     1753                                   hh:width-chars = 2.5 .
     1754                               end.
     1755                           when "b-print" then
     1756                               do:
     1757                                   hh:load-image("cmp/b-print.bmp":u) .
     1758                                   hh:TOOLTIP = "Печать" .
     1759                                   v-h[ii] = hh:handle .
     1760                                   ii = ii + 1 .
     1761                                   hh:width-chars = 3 .
     1762                               end.
     1763                           when "b-history" or
     1764                           when "b-hist" then
     1765                               do:
     1766                                   hh:load-image("cmp/b-hist.bmp":u) .
     1767                                   hh:TOOLTIP = "История" .
     1768                                   v-h[ii] = hh:handle .
     1769                                   ii = ii + 1 .
     1770                                   hh:width-chars = 3 .
     1771                               end.
     1772                           when "b-sch" then
     1773                               do:
     1774                                   hh:load-image("cmp/b-sch.bmp":u) .
     1775                                   hh:TOOLTIP = "Установка Фильтра" .
     1776                                   v-h[ii] = hh:handle .
     1777                                   ii = ii + 1 .
     1778                                   hh:width-chars = 3 .
     1779                               end.
     1780                           when "b-hist-user" then
     1781                               do:
     1782                                   hh:load-image("cmp/b-hist.bmp":u) .
     1783                                   hh:TOOLTIP = "История пользователя" .
     1784                                   ii = ii + 1 .
     1785                               end.
     1786                       end case.
     1787                   end.
     1788                   hh = hh:next-sibling.
     1789               end.
     1790               b-help:column = v-frame-width - b-help:width-chars.
     1791               jj = 0.
     1792               repeat ii = 4 to 1 by -1 :
     1793                   if valid-handle (v-h[ii] ) then
     1794                   do:
     1795                       jj  = jj + 1 .
     1796                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1797                       v-h[ii]:row    = v-help-old-y .
     1798                   end.
     1799               end.
     1800           end.
     1801       end.
     1802   end procedure.
     1803   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1804   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1805   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1806   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1807   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1808   define variable v-diasize-current-frame-height as decimal   no-undo .
     1809   define variable v-diasize-change-size          as logical   no-undo .
     1810   define variable v-diasize-resize-button        as handle    no-undo .
     1811   define variable v-diasize-wndmax               as logical   no-undo .
     1812   define variable v-diasize-wndstore             as logical   no-undo .
     1813   define variable v-diasize-proc-name            as character no-undo .
     1814   define variable v-diasize-browse-handle        as handle    no-undo .
     1815   define variable v-diasize-browse-number        as integer   no-undo .
     1816   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1817   define temp-table temp-diasize-handle no-undo
     1818     field handle-value  as handle
     1819     field save-position as decimal
     1820     index xpk is primary unique handle-value
     1821     .
     1822   define temp-table temp-browse-handle no-undo
     1823     field browse-type   as character
     1824     field browse-number as integer
     1825     field browse-handle as handle
     1826     field original-size as decimal
     1827     index xpk is primary unique browse-type browse-number
     1828     index xie browse-type browse-handle
     1829   .
     1830   procedure diasize_change-height :
     1831     define input  parameter p-change-value  as decimal   no-undo .
     1832     define input  parameter p-move-resize   as logical   no-undo .
     1833     define variable v-field-group-handle    as handle    no-undo .
     1834     define variable v-object-handle         as handle    no-undo .
     1835     define variable v-frame-height          as decimal   no-undo .
     1836     define variable v-frame-virtual-height  as decimal   no-undo .
     1837     define variable v-browse-height         as decimal   no-undo .
     1838     define variable v-window-height         as decimal   no-undo .
     1839     define variable v-window-virtual-height as decimal   no-undo .
     1840     define variable v-change-sign           as integer   no-undo .
     1841     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1842     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1843     if p-change-value > 0
     1844     then do:
     1845       if frame Dialog-Frame :height + p-change-value
     1846           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1847       then do:
     1848         assign
     1849           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1850                           - (frame Dialog-Frame :height-chars)
     1851         .
     1852         if p-change-value <= 0
     1853         then do:
     1854           run diasize_position-resize-button in this-procedure .
     1855           return .
     1856         end.
     1857       end.
     1858     end.
     1859     if p-change-value < 0
     1860     then do:
     1861       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1862       then do:
     1863         assign
     1864           p-change-value = v-diasize-orig-frame-height
     1865                          - (frame Dialog-Frame :height-chars)
     1866         .
     1867         if p-change-value >= 0
     1868         then do:
     1869           run diasize_position-resize-button in this-procedure .
     1870           return .
     1871         end.
     1872       end.
     1873     end.
     1874     if p-change-value >= 0
     1875     then do:
     1876       assign
     1877         v-change-sign = 1
     1878       .
     1879     end.
     1880     else do:
     1881       assign
     1882         v-change-sign = -1
     1883       .
     1884     end.
     1885     assign
     1886       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1887     .
     1888     if p-change-value = 0
     1889     then do:
     1890       run diasize_position-resize-button in this-procedure .
     1891       return .
     1892     end.
     1893     move_block:
     1894     do
     1895     on error undo move_block, retry move_block
     1896     :
     1897       if retry
     1898       then do:
     1899         do
     1900         on error undo move_block, leave move_block
     1901         :
     1902           if p-change-value > 0
     1903           then do:
     1904             for each buf_temp-diasize-handle
     1905             on error undo, next
     1906             :
     1907               assign
     1908                 v-object-handle = buf_temp-diasize-handle.handle-value
     1909               .
     1910               if v-object-handle <> v-diasize-resize-button
     1911               then do:
     1912                 assign
     1913                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1914                 .
     1915               end.
     1916             end.
     1917             assign
     1918               v-diasize-browse-handle :height = v-browse-height
     1919             .
     1920             for each buf_temp-browse-handle
     1921               where buf_temp-browse-handle.browse-type = 'height':u
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1926               .
     1927             end.
     1928             assign
     1929               frame Dialog-Frame :height = v-frame-height
     1930             .
     1931             if frame Dialog-Frame :scrollable = true
     1932             then do:
     1933               assign
     1934                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1935               .
     1936             end.
     1937             run diasize_position-resize-button in this-procedure .
     1938           end.
     1939           else do:
     1940             if frame Dialog-Frame :scrollable = true
     1941             then do:
     1942               assign
     1943                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1944               .
     1945             end.
     1946             assign
     1947               frame Dialog-Frame :height = v-frame-height
     1948             .
     1949             assign
     1950               v-diasize-browse-handle :height = v-browse-height
     1951             .
     1952             for each buf_temp-browse-handle
     1953               where buf_temp-browse-handle.browse-type = 'height':u
     1954             on error undo, next
     1955             :
     1956               assign
     1957                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1958               .
     1959             end.
     1960             for each buf_temp-diasize-handle
     1961             on error undo, next
     1962             :
     1963               assign
     1964                 v-object-handle = buf_temp-diasize-handle.handle-value
     1965               .
     1966               if v-object-handle <> v-diasize-resize-button
     1967               then do:
     1968                 assign
     1969                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1970                 .
     1971               end.
     1972             end.
     1973             run diasize_position-resize-button in this-procedure .
     1974           end.
     1975           assign
     1976             v-diasize-change-size = false
     1977           .
     1978           leave move_block .
     1979         end.
     1980       end.
     1981       assign
     1982         v-diasize-need-full-display = true
     1983       .
     1984       if v-diasize-change-size = false
     1985       then do:
     1986         assign
     1987           v-diasize-change-size = true
     1988         .
     1989       end.
     1990       else do:
     1991         return .
     1992       end.
     1993       assign
     1994         v-frame-height = frame Dialog-Frame :height
     1995         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1996         v-browse-height = v-diasize-browse-handle :height
     1997       .
     1998       for each buf_temp-browse-handle
     1999         where buf_temp-browse-handle.browse-type = 'height':u
     2000       :
     2001         assign
     2002           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2003         .
     2004       end.
     2005       for each buf_temp-diasize-handle
     2006       :
     2007         delete buf_temp-diasize-handle .
     2008       end.
     2009       assign
     2010         v-field-group-handle = frame Dialog-Frame :first-child
     2011       .
     2012       do while valid-handle(v-field-group-handle)
     2013       :
     2014         assign
     2015           v-object-handle = v-field-group-handle :first-child
     2016         .
     2017         do while valid-handle(v-object-handle)
     2018         :
     2019           if  v-object-handle <> v-diasize-browse-handle :handle
     2020           and can-query(v-object-handle, "row")
     2021           and can-query(v-object-handle, "height")
     2022           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2023           then do:
     2024             find first buf_temp-browse-handle
     2025               where buf_temp-browse-handle.browse-type   = 'height':u
     2026                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2027               no-error .
     2028             if available buf_temp-browse-handle
     2029             then do:
     2030             end.
     2031             else do:
     2032               create buf_temp-diasize-handle .
     2033               assign
     2034                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2035                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2036               .
     2037             end.
     2038           end.
     2039           assign
     2040             v-object-handle = v-object-handle :next-sibling
     2041           .
     2042         end.
     2043         assign
     2044           v-field-group-handle = v-field-group-handle :next-sibling
     2045         .
     2046       end.
     2047       do with frame Dialog-Frame
     2048       :
     2049         hide v-diasize-resize-button .
     2050         assign
     2051           v-diasize-resize-button :row    = 1
     2052           v-diasize-resize-button :column = 1
     2053         .
     2054       end.
     2055       if p-change-value > 0
     2056       then do:
     2057         if frame Dialog-Frame :scrollable = true
     2058         then do:
     2059           assign
     2060             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2061             no-error .
     2062           if error-status :error
     2063           or error-status :get-message(1) <> ""
     2064           then do:
     2065             undo move_block, retry move_block .
     2066           end.
     2067         end.
     2068         assign
     2069           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2070           no-error .
     2071         if error-status :error
     2072         or error-status :get-message(1) <> ""
     2073         then do:
     2074           undo move_block, retry move_block .
     2075         end.
     2076         assign
     2077           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2078           no-error .
     2079         if error-status :error
     2080         or error-status :get-message(1) <> ""
     2081         then do:
     2082           undo move_block, retry move_block .
     2083         end.
     2084         for each buf_temp-browse-handle
     2085           where buf_temp-browse-handle.browse-type = 'height':u
     2086         on error undo move_block, retry move_block
     2087         :
     2088           assign
     2089             buf_temp-browse-handle.browse-handle :height
     2090               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2091             no-error .
     2092           if error-status :error
     2093           or error-status :get-message(1) <> ""
     2094           then do:
     2095             undo move_block, retry move_block .
     2096           end.
     2097         end.
     2098         for each buf_temp-diasize-handle
     2099         on error undo move_block, retry move_block
     2100         :
     2101           assign
     2102             v-object-handle = buf_temp-diasize-handle.handle-value
     2103           .
     2104           if v-object-handle <> v-diasize-resize-button
     2105           then do:
     2106             assign
     2107               v-object-handle :row = v-object-handle :row + p-change-value
     2108               no-error .
     2109             if error-status :error
     2110             or error-status :get-message(1) <> ""
     2111             then do:
     2112               undo move_block, retry move_block .
     2113             end.
     2114           end.
     2115         end.
     2116       end.
     2117       else do:
     2118         for each buf_temp-diasize-handle
     2119         on error undo move_block, retry move_block
     2120         :
     2121           assign
     2122             v-object-handle = buf_temp-diasize-handle.handle-value
     2123           .
     2124           if v-object-handle <> v-diasize-resize-button
     2125           then do:
     2126             assign
     2127               v-object-handle :row = v-object-handle :row + p-change-value
     2128               no-error .
     2129             if error-status :error
     2130             or error-status :get-message(1) <> ""
     2131             then do:
     2132               undo move_block, retry move_block .
     2133             end.
     2134           end.
     2135         end.
     2136         assign
     2137           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2138           no-error .
     2139         if error-status :error
     2140         or error-status :get-message(1) <> ""
     2141         then do:
     2142           undo move_block, retry move_block .
     2143         end.
     2144         for each buf_temp-browse-handle
     2145           where buf_temp-browse-handle.browse-type = 'height':u
     2146         on error undo move_block, retry move_block
     2147         :
     2148           assign
     2149             buf_temp-browse-handle.browse-handle :height
     2150               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2151             no-error .
     2152           if error-status :error
     2153           or error-status :get-message(1) <> ""
     2154           then do:
     2155             undo move_block, retry move_block .
     2156           end.
     2157         end.
     2158         assign
     2159           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2160           no-error .
     2161         if error-status :error
     2162         or error-status :get-message(1) <> ""
     2163         then do:
     2164           undo move_block, retry move_block .
     2165         end.
     2166         if frame Dialog-Frame :scrollable = true
     2167         then do:
     2168           assign
     2169             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2170             no-error .
     2171           if error-status :error
     2172           or error-status :get-message(1) <> ""
     2173           then do:
     2174             undo move_block, retry move_block .
     2175           end.
     2176         end.
     2177       end.
     2178       if p-move-resize = true
     2179       then do:
     2180         run diasize_position-resize-button in this-procedure .
     2181       end.
     2182       if v-diasize-wndstore = true
     2183       then do:
     2184         if connected("ub") = true
     2185         then do:
     2186           define variable v-cntxt-db-num        as integer   no-undo .
     2187           define variable v-cntxt-userid        as character no-undo .
     2188           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2189                                             , OUTPUT v-cntxt-userid
     2190                                             ) .
     2191           run gbl/wndsizew.p
     2192             (input  v-cntxt-db-num
     2193             ,input  v-cntxt-userid
     2194             ,input  v-diasize-proc-name
     2195             ,input  'height':u
     2196             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2197             ) .
     2198         end.
     2199       end.
     2200     end.
     2201     assign
     2202       v-diasize-change-size = false
     2203     .
     2204   end procedure.
     2205   procedure diasize_set-height :
     2206     define input  parameter p-new-height  as decimal   no-undo .
     2207     define input  parameter p-move-resize as logical   no-undo .
     2208     do
     2209     on error undo, return error return-value
     2210     :
     2211       run diasize_change-height in this-procedure
     2212         (input  (p-new-height - frame Dialog-Frame :height)
     2213         ,input  p-move-resize
     2214         ) .
     2215     end.
     2216   end procedure.
     2217   procedure diasize_change-width :
     2218     define input  parameter p-change-value as decimal   no-undo .
     2219     define input  parameter p-move-resize  as logical   no-undo .
     2220     define variable v-field-group-handle   as handle    no-undo .
     2221     define variable v-object-handle        as handle    no-undo .
     2222     define variable v-frame-width          as decimal   no-undo .
     2223     define variable v-frame-virtual-width  as decimal   no-undo .
     2224     define variable v-browse-width         as decimal   no-undo .
     2225     define variable v-window-width         as decimal   no-undo .
     2226     define variable v-window-virtual-width as decimal   no-undo .
     2227     define variable v-change-sign          as integer   no-undo .
     2228     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2229     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2230     if p-change-value > 0
     2231     then do:
     2232       if frame Dialog-Frame :width + p-change-value >
     2233           session :width-chars
     2234       then do:
     2235         assign
     2236           p-change-value = session :width-chars - frame Dialog-Frame :width
     2237         .
     2238         if p-change-value <= 0
     2239         then do:
     2240           run diasize_position-resize-button in this-procedure .
     2241           return .
     2242         end.
     2243       end.
     2244     end.
     2245     if p-change-value < 0
     2246     then do:
     2247       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2248       then do:
     2249         assign
     2250           p-change-value = v-diasize-orig-frame-width
     2251                          - frame Dialog-Frame :width
     2252         .
     2253         if p-change-value >= 0
     2254         then do:
     2255           run diasize_position-resize-button in this-procedure .
     2256           return .
     2257         end.
     2258       end.
     2259     end.
     2260     if p-change-value >= 0
     2261     then do:
     2262       assign
     2263         v-change-sign = 1
     2264       .
     2265     end.
     2266     else do:
     2267       assign
     2268         v-change-sign = -1
     2269       .
     2270     end.
     2271     assign
     2272       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2273     .
     2274     if p-change-value = 0
     2275     then do:
     2276       run diasize_position-resize-button in this-procedure .
     2277       return .
     2278     end.
     2279     move_block:
     2280     do
     2281     on error undo move_block, leave move_block
     2282     :
     2283       if retry
     2284       then do:
     2285         do
     2286         on error undo move_block, leave move_block
     2287         :
     2288           if p-change-value > 0
     2289           then do:
     2290             for each buf_temp-diasize-handle
     2291             on error undo, next
     2292             :
     2293               assign
     2294                 v-object-handle = buf_temp-diasize-handle.handle-value
     2295               .
     2296               if v-object-handle <> v-diasize-resize-button
     2297               then do:
     2298                 assign
     2299                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2300                 .
     2301               end.
     2302             end.
     2303             assign
     2304               v-diasize-browse-handle :width = v-browse-width
     2305             .
     2306             for each buf_temp-browse-handle
     2307               where buf_temp-browse-handle.browse-type = 'width':u
     2308             on error undo, next
     2309             :
     2310               assign
     2311                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2312               .
     2313             end.
     2314             assign
     2315               frame Dialog-Frame :width = v-frame-width
     2316             .
     2317             if frame Dialog-Frame :scrollable = true
     2318             then do:
     2319               assign
     2320                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2321               .
     2322             end.
     2323             run diasize_position-resize-button in this-procedure .
     2324           end.
     2325           else do:
     2326             if frame Dialog-Frame :scrollable = true
     2327             then do:
     2328               assign
     2329                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2330               .
     2331             end.
     2332             assign
     2333               frame Dialog-Frame :width = v-frame-width
     2334             .
     2335             for each buf_temp-browse-handle
     2336               where buf_temp-browse-handle.browse-type = 'width':u
     2337             on error undo, next
     2338             :
     2339               assign
     2340                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2341               .
     2342             end.
     2343             assign
     2344               v-diasize-browse-handle :width = v-browse-width
     2345             .
     2346             for each buf_temp-diasize-handle
     2347             on error undo, next
     2348             :
     2349               assign
     2350                 v-object-handle = buf_temp-diasize-handle.handle-value
     2351               .
     2352               if v-object-handle <> v-diasize-resize-button
     2353               then do:
     2354                 assign
     2355                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2356                 .
     2357               end.
     2358             end.
     2359             run diasize_position-resize-button in this-procedure .
     2360           end.
     2361           assign
     2362             v-diasize-change-size = false
     2363           .
     2364           leave move_block .
     2365         end.
     2366       end.
     2367       assign
     2368         v-diasize-need-full-display = true
     2369       .
     2370       if v-diasize-change-size = false
     2371       then do:
     2372         assign
     2373           v-diasize-change-size = true
     2374         .
     2375       end.
     2376       else do:
     2377         return .
     2378       end.
     2379       assign
     2380         v-frame-width = frame Dialog-Frame :width
     2381         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2382         v-browse-width = v-diasize-browse-handle :width
     2383       .
     2384       for each buf_temp-browse-handle
     2385         where buf_temp-browse-handle.browse-type = 'width':u
     2386       :
     2387         assign
     2388           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2389         .
     2390       end.
     2391       for each buf_temp-diasize-handle
     2392       :
     2393         delete buf_temp-diasize-handle .
     2394       end.
     2395       assign
     2396         v-field-group-handle = frame Dialog-Frame :first-child
     2397       .
     2398       do while valid-handle(v-field-group-handle)
     2399       :
     2400         assign
     2401           v-object-handle = v-field-group-handle :first-child
     2402         .
     2403         do while valid-handle(v-object-handle)
     2404         :
     2405           if  v-object-handle <> v-diasize-browse-handle :handle
     2406           and v-object-handle <> v-diasize-resize-button
     2407           and can-query(v-object-handle, "row")
     2408           and can-query(v-object-handle, "height")
     2409           and ( v-object-handle :col + v-object-handle :width
     2410                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2411               )
     2412           then do:
     2413             find first buf_temp-browse-handle
     2414               where buf_temp-browse-handle.browse-type   = 'width':u
     2415                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2416               no-error .
     2417             if available buf_temp-browse-handle
     2418             then do:
     2419             end.
     2420             else do:
     2421               create buf_temp-diasize-handle .
     2422               assign
     2423                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2424                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2425               .
     2426             end.
     2427           end.
     2428           assign
     2429             v-object-handle = v-object-handle :next-sibling
     2430           .
     2431         end.
     2432         assign
     2433           v-field-group-handle = v-field-group-handle :next-sibling
     2434         .
     2435       end.
     2436       do with frame Dialog-Frame
     2437       :
     2438         hide v-diasize-resize-button .
     2439         v-diasize-resize-button :row = 1.
     2440         v-diasize-resize-button :column = 1.
     2441       end.
     2442       if p-change-value > 0
     2443       then do:
     2444         if frame Dialog-Frame :scrollable = true
     2445         then do:
     2446           assign
     2447             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2448             no-error .
     2449           if error-status :error
     2450           or error-status :get-message(1) <> ""
     2451           then do:
     2452             undo move_block, retry move_block.
     2453           end.
     2454         end.
     2455         assign
     2456           frame Dialog-Frame :width = v-frame-width + p-change-value
     2457           no-error .
     2458         if error-status :error
     2459         or error-status :get-message(1) <> ""
     2460         then do:
     2461           undo move_block, retry move_block.
     2462         end.
     2463         assign
     2464           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2465         no-error .
     2466         if error-status :error
     2467         or error-status :get-message(1) <> ""
     2468         then do:
     2469           undo move_block, retry move_block.
     2470         end.
     2471         for each buf_temp-browse-handle
     2472           where buf_temp-browse-handle.browse-type = 'width':u
     2473         on error undo move_block, retry move_block
     2474         :
     2475           assign
     2476             buf_temp-browse-handle.browse-handle :width
     2477               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2478             no-error .
     2479           if error-status :error
     2480           or error-status :get-message(1) <> ""
     2481           then do:
     2482             undo move_block, retry move_block .
     2483           end.
     2484         end.
     2485         for each buf_temp-diasize-handle
     2486         on error undo move_block, retry move_block
     2487         :
     2488           assign
     2489             v-object-handle = buf_temp-diasize-handle.handle-value
     2490           .
     2491           if v-object-handle <> v-diasize-resize-button
     2492           then do:
     2493             assign
     2494               v-object-handle :col = v-object-handle :col + p-change-value
     2495               no-error .
     2496             if error-status :error
     2497             or error-status :get-message(1) <> ""
     2498             then do:
     2499               undo move_block, retry move_block .
     2500             end.
     2501           end.
     2502         end.
     2503       end.
     2504       else do:
     2505         for each buf_temp-diasize-handle
     2506         on error undo move_block, retry move_block
     2507         :
     2508           assign
     2509             v-object-handle = buf_temp-diasize-handle.handle-value
     2510           .
     2511           if v-object-handle <> v-diasize-resize-button
     2512           then do:
     2513             assign
     2514               v-object-handle :col = v-object-handle :col + p-change-value
     2515               no-error .
     2516             if error-status :error
     2517             or error-status :get-message(1) <> ""
     2518             then do:
     2519               undo move_block, retry move_block .
     2520             end.
     2521           end.
     2522         end.
     2523         for each buf_temp-browse-handle
     2524           where buf_temp-browse-handle.browse-type = 'width':u
     2525         on error undo move_block, retry move_block
     2526         :
     2527           assign
     2528             buf_temp-browse-handle.browse-handle :width
     2529               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2530             no-error .
     2531           if error-status :error
     2532           or error-status :get-message(1) <> ""
     2533           then do:
     2534             undo move_block, retry move_block .
     2535           end.
     2536         end.
     2537         assign
     2538           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2539           no-error .
     2540         if error-status :error
     2541         or error-status :get-message(1) <> ""
     2542         then do:
     2543           undo move_block, retry move_block.
     2544         end.
     2545         assign
     2546           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2547         no-error .
     2548         if error-status :error
     2549         or error-status :get-message(1) <> ""
     2550         then do:
     2551           undo move_block, retry move_block.
     2552         end.
     2553         if frame Dialog-Frame :scrollable = true
     2554         then do:
     2555           assign
     2556             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2557           no-error .
     2558           if error-status :error
     2559           or error-status :get-message(1) <> ""
     2560           then do:
     2561             undo move_block, retry move_block.
     2562           end.
     2563         end.
     2564       end.
     2565       if p-move-resize
     2566       then do:
     2567         run diasize_position-resize-button in this-procedure .
     2568       end.
     2569       if v-diasize-wndstore = true
     2570       then do:
     2571         if connected("ub") = true
     2572         then do:
     2573           define variable v-cntxt-db-num        as integer   no-undo .
     2574           define variable v-cntxt-userid        as character no-undo .
     2575           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2576                                             , OUTPUT v-cntxt-userid
     2577                                             ) .
     2578           run gbl/wndsizew.p
     2579             (input  v-cntxt-db-num
     2580             ,input  v-cntxt-userid
     2581             ,input  v-diasize-proc-name
     2582             ,input  'width':u
     2583             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2584             ) .
     2585         end.
     2586       end.
     2587     end.
     2588     assign
     2589       v-diasize-change-size = false
     2590     .
     2591   end procedure.
     2592   procedure diasize_set-width :
     2593     define input  parameter p-new-width  as decimal   no-undo .
     2594     define input  parameter p-move-resize as logical   no-undo .
     2595     do
     2596     on error undo, return error return-value
     2597     :
     2598       run diasize_change-width in this-procedure
     2599         (input  (p-new-width - frame Dialog-Frame :width)
     2600         ,input  p-move-resize
     2601         ) .
     2602     end.
     2603   end procedure.
     2604   procedure diasize_position-resize-button :
     2605     do with frame Dialog-Frame
     2606     :
     2607       hide v-diasize-resize-button .
     2608       assign
     2609         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2610                     - 1
     2611                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2612         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2613                     - 1
     2614                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2615       .
     2616       view v-diasize-resize-button .
     2617     end.
     2618   end procedure.
     2619   on alt-right anywhere
     2620   do:
     2621     run diasize_change-width in this-procedure
     2622       (input 1
     2623       ,input true
     2624       ) .
     2625     return no-apply .
     2626   end.
     2627   on alt-left anywhere
     2628   do:
     2629     run diasize_change-width in this-procedure
     2630       (input -1
     2631       ,input true
     2632       ) .
     2633     return no-apply .
     2634   end.
     2635   on alt-down anywhere
     2636   do:
     2637     run diasize_change-height in this-procedure
     2638       (input 1
     2639       ,input true
     2640       ) .
     2641     return no-apply .
     2642   end.
     2643   on alt-up anywhere
     2644   do:
     2645     run diasize_change-height in this-procedure
     2646       (input -1
     2647       ,input true
     2648       ) .
     2649     return no-apply .
     2650   end.
     2651   on alt-enter of frame Dialog-Frame
     2652   do:
     2653     run diasize_maximize in this-procedure
     2654       (input  ?
     2655       ).
     2656     return no-apply .
     2657   end.
     2658   procedure diasize_end-move :
     2659     do
     2660     on error undo, return error return-value
     2661     :
     2662       define variable v-row-delta as decimal   no-undo .
     2663       define variable v-col-delta as decimal   no-undo .
     2664       define variable v-new-row as decimal   no-undo .
     2665       define variable v-new-col as decimal   no-undo .
     2666       assign
     2667         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2668         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2669       .
     2670       assign
     2671         v-row-delta = v-new-row - frame Dialog-Frame :height
     2672         v-col-delta = v-new-col - frame Dialog-Frame :width
     2673       .
     2674       run diasize_change-height in this-procedure
     2675         (input v-row-delta
     2676         ,input true
     2677         ) .
     2678       run diasize_change-width in this-procedure
     2679         (input v-col-delta
     2680         ,input true
     2681         ) .
     2682     end.
     2683   end procedure.
     2684   procedure diasize_maximize :
     2685     define input  parameter p-action as logical   no-undo .
     2686     do
     2687     on error undo, return error return-value
     2688     :
     2689       if p-action = ?
     2690       then do:
     2691         if v-diasize-need-maximize = true
     2692         then do:
     2693           assign
     2694             p-action = true
     2695           .
     2696         end.
     2697         else do:
     2698           assign
     2699             p-action = false
     2700           .
     2701         end.
     2702       end.
     2703       if p-action = true
     2704       then do:
     2705         run diasize_change-height in this-procedure
     2706           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2707               - frame Dialog-Frame :height-chars
     2708           ,input true
     2709           ) .
     2710         run diasize_change-width in this-procedure
     2711           (input session :width-chars
     2712               - frame Dialog-Frame :width-chars
     2713           ,input true
     2714           ) .
     2715         assign
     2716           v-diasize-need-maximize = false
     2717         .
     2718       end.
     2719       else do:
     2720         run diasize_change-width in this-procedure
     2721           (input v-diasize-orig-frame-width
     2722               - frame Dialog-Frame :width-chars
     2723           ,input true
     2724           ) .
     2725         run diasize_change-height in this-procedure
     2726           (input v-diasize-orig-frame-height
     2727               - frame Dialog-Frame :height-chars
     2728           ,input true
     2729           ) .
     2730         assign
     2731           v-diasize-need-maximize = true
     2732         .
     2733       end.
     2734     end.
     2735   end procedure.
     2736   procedure diasize_restore-orig-size :
     2737     do
     2738     on error undo, return error return-value
     2739     :
     2740       assign
     2741         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2742         v-diasize-current-frame-height = frame Dialog-Frame :height
     2743       .
     2744       run diasize_set-height in this-procedure
     2745         (input  v-diasize-orig-frame-height
     2746         ,input  true
     2747         ) .
     2748       run diasize_set-width in this-procedure
     2749         (input  v-diasize-orig-frame-width
     2750         ,input  true
     2751         ) .
     2752     end.
     2753   end procedure.
     2754   procedure diasize_restore-current-size :
     2755     do
     2756     on error undo, return error return-value
     2757     :
     2758       run diasize_set-height in this-procedure
     2759         (input  v-diasize-current-frame-height
     2760         ,input  true
     2761         ) .
     2762       run diasize_set-width in this-procedure
     2763         (input  v-diasize-current-frame-width
     2764         ,input  true
     2765         ) .
     2766     end.
     2767   end procedure.
     2768   procedure diasize_set-browse-handle :
     2769     define input  parameter p-browse-handle as handle   no-undo .
     2770     define buffer buf_temp-browse-handle for temp-browse-handle .
     2771     do
     2772     on error undo, return error return-value
     2773     :
     2774       assign
     2775         v-diasize-browse-handle = p-browse-handle
     2776       .
     2777       for each buf_temp-browse-handle
     2778       on error undo, return error return-value
     2779       :
     2780         delete buf_temp-browse-handle .
     2781       end.
     2782     end.
     2783   end procedure.
     2784   procedure diasize_add_browse :
     2785     define input  parameter p-browse-type   as character no-undo .
     2786     define input  parameter p-browse-handle as handle    no-undo .
     2787     define buffer buf_temp-browse-handle for temp-browse-handle .
     2788     do
     2789     on error undo, return error return-value
     2790     :
     2791       assign
     2792         v-diasize-browse-number = v-diasize-browse-number + 1
     2793       .
     2794       create buf_temp-browse-handle .
     2795       assign
     2796         buf_temp-browse-handle.browse-type   = p-browse-type
     2797         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2798         buf_temp-browse-handle.browse-handle = p-browse-handle
     2799       .
     2800     end.
     2801   end procedure.
     2802   procedure diasize_init :
     2803     define variable v-default-value    as logical   no-undo .
     2804     define variable v-restore-saved    as logical   no-undo .
     2805     define variable v-resize-value-str as character no-undo .
     2806     do
     2807     on error undo, return error return-value
     2808     :
     2809       do with frame Dialog-Frame
     2810       :
     2811         assign
     2812           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2813           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2814           v-diasize-browse-handle     = browse br-enum-cli :handle
     2815         .
     2816         create button v-diasize-resize-button
     2817         assign
     2818           parent        = frame Dialog-Frame :first-child
     2819           label         = "s"
     2820           height-pixels = 16
     2821           width-pixels  = 16
     2822           visible       = true
     2823           sensitive     = true
     2824           movable       = true
     2825           triggers:
     2826             on end-move persistent run diasize_end-move in this-procedure .
     2827           end triggers.
     2828         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2829         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2830         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2831         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2832         assign
     2833           v-diasize-wndmax = false
     2834         .
     2835         if connected("ub") = true
     2836         then do:
     2837           define variable v-cntxt-db-num        as integer   no-undo .
     2838           define variable v-cntxt-userid        as character no-undo .
     2839           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2840                                             , OUTPUT v-cntxt-userid
     2841                                             ) .
     2842           run gbl/wndpar_r.p
     2843             (input  v-cntxt-db-num
     2844             ,input  v-cntxt-userid
     2845             ,input  'wndmax':U
     2846             ,output v-diasize-wndmax
     2847             ,output v-default-value
     2848             ) .
     2849         end.
     2850         assign
     2851           v-diasize-wndstore = false
     2852         .
     2853         if connected("ub") = true
     2854         then do:
     2855           run gbl/wndpar_r.p
     2856             (input  v-cntxt-db-num
     2857             ,input  v-cntxt-userid
     2858             ,input  'wndstore':U
     2859             ,output v-diasize-wndstore
     2860             ,output v-default-value
     2861             ) .
     2862         end.
     2863         assign
     2864           v-diasize-proc-name = entry(1, program-name(2), '.')
     2865         .
     2866         if v-diasize-wndstore = true
     2867         then do:
     2868           assign
     2869             v-restore-saved = false
     2870           .
     2871           if connected("ub") = true
     2872           then do:
     2873             run gbl/wndsizer.p
     2874               (input  v-cntxt-db-num
     2875               ,input  v-cntxt-userid
     2876               ,input  v-diasize-proc-name
     2877               ,input  'height':u
     2878               ,output v-resize-value-str
     2879               ) .
     2880             if v-resize-value-str <> '':U
     2881             then do:
     2882               run diasize_change-height in this-procedure
     2883                 (input  integer(v-resize-value-str)
     2884                 ,input  true
     2885                 ) .
     2886               assign
     2887                 v-restore-saved = true
     2888               .
     2889             end.
     2890           end.
     2891           if connected("ub") = true
     2892           then do:
     2893             run gbl/wndsizer.p
     2894               (input  v-cntxt-db-num
     2895               ,input  v-cntxt-userid
     2896               ,input  v-diasize-proc-name
     2897               ,input  'width':u
     2898               ,output v-resize-value-str
     2899               ) .
     2900             if v-resize-value-str <> '':U
     2901             then do:
     2902               run diasize_change-width in this-procedure
     2903                 (input  integer(v-resize-value-str)
     2904                 ,input  true
     2905                 ) .
     2906               assign
     2907                 v-restore-saved = true
     2908               .
     2909             end.
     2910           end.
     2911           if v-restore-saved <> true
     2912           then do:
     2913             if v-diasize-wndmax = true
     2914             then do:
     2915               run diasize_maximize in this-procedure
     2916                 (input  true
     2917                 ) .
     2918             end.
     2919           end.
     2920         end.
     2921         else do:
     2922           if v-diasize-wndmax = true
     2923           then do:
     2924             run diasize_maximize in this-procedure
     2925               (input  true
     2926               ) .
     2927           end.
     2928         end.
     2929       end.
     2930     end.
     2931   end procedure.
     2932   procedure diasize_need-full-display :
     2933     define output parameter p-need-full-display as logical   no-undo .
     2934     do
     2935     on error undo, return error return-value
     2936     :
     2937       assign
     2938         p-need-full-display = v-diasize-need-full-display
     2939       .
     2940       assign
     2941         v-diasize-need-full-display = false
     2942       .
     2943     end.
     2944   end procedure.
     2945   procedure get-context :
     2946      define output parameter p-db-num as integer          no-undo.
     2947      define output parameter p-user-id as character        no-undo.
     2948      define variable v-login               as character    no-undo.
     2949      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2950      define buffer buf_user-login  for ub.user-login .
     2951      do
     2952      on error undo, return error
     2953      :
     2954            FIND FIRST buf_sys-ctrl no-lock.
     2955            ASSIGN
     2956               v-login = USERID("ub")
     2957               p-db-num = buf_sys-ctrl.db-num
     2958            .
     2959            FIND FIRST buf_user-login
     2960                 WHERE buf_user-login.db-num = p-db-num
     2961                   AND buf_user-login.user-login = v-login
     2962                 no-lock
     2963                 no-error
     2964                 .
     2965            IF AVAILABLE buf_user-login
     2966            THEN DO:
     2967               assign
     2968                  p-user-id = buf_user-login.user-id
     2969               .
     2970            END.
     2971      end.
     2972   end procedure.
     2973       run diasize_init in this-procedure .
     2974   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2975   procedure set-filter-name :
     2976   define input parameter p-filter-name as character no-undo .
     2977     do with frame Dialog-Frame:
     2978       if p-filter-name > "" then do:
     2979         assign
     2980           frame Dialog-Frame:title
     2981             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2982         .
     2983         assign
     2984           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2985         .
     2986       end.
     2987       else do:
     2988         assign
     2989           b-sch :tooltip = ""
     2990         .
     2991       end.
     2992     end.
     2993   end procedure.
     2994   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2995   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2996     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2997     return no-apply.
     2998   end.
     2999   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3000   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3001     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3002     return no-apply.
     3003   end.
     3004   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3005   on F8 of frame Dialog-Frame anywhere do:
     3006     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3007     return no-apply.
     3008   end.
     3009   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3010   on INS of frame Dialog-Frame anywhere do:
     3011     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3012     return no-apply.
     3013   end.
     3014   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3015   on F2 of frame Dialog-Frame anywhere do:
     3016     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3017     return no-apply.
     3018   end.
     3019   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3020   on F2 of frame Dialog-Frame anywhere do:
     3021     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3022     return no-apply.
     3023   end.
     3024   MAIN-BLOCK:
     3025   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3026      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3027   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3028     run mainmenu_getcntxt in parparentproc
     3029       (output v-cntxt-db-num
     3030       ,output v-cntxt-userid
     3031       ,output v-cntxt-level
     3032       ,output v-cntxt-host-code-obj
     3033       ,output v-cntxt-obj-type
     3034       ,output v-cntxt-obj-code
     3035       ,output v-cntxt-db-num-obj
     3036       ,output v-cntxt-is-admin
     3037       ) .
     3038     case p-list-mode:
     3039       when 'все':U then do:
     3040       end.
     3041       otherwise do:
     3042          message
     3043          substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3044          view-as alert-box error.
     3045          undo, return error .
     3046       end.
     3047     end.
     3048     v-rid-list = p-rid-list.
     3049     RUN Myenable.
     3050     WAIT-FOR GO OF FRAME Dialog-Frame.
     3051   END.
     3052   RUN disable_UI.
     3053   PROCEDURE disable_UI :
     3054     HIDE FRAME Dialog-Frame.
     3055   END PROCEDURE.
     3056   PROCEDURE enable_UI :
     3057     DISPLAY mark-num
     3058         WITH FRAME Dialog-Frame.
     3059     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-sconf b-sch b-print B-Help
     3060            br-enum-cli mark-num
     3061         WITH FRAME Dialog-Frame.
     3062     VIEW FRAME Dialog-Frame.
     3063     OPEN QUERY br-enum-cli FOR EACH X_ext-classif NO-LOCK,        FIRST X_clients NO-LOCK INDEXED-REPOSITION.
     3064   END PROCEDURE.
     3065   PROCEDURE MyEnable :
     3066   ENABLE
     3067   b-quit
     3068   b-cli
     3069   b-print
     3070   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3071   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3072   b-sch
     3073   B-Help
     3074   b-sconf
     3075   br-enum-cli
     3076   WITH FRAME Dialog-Frame.
     3077   VIEW FRAME Dialog-Frame.
     3078   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3079   END PROCEDURE.
     3080   PROCEDURE OpenBr :
     3081   define input  parameter p-open-query     as logical   no-undo .
     3082   define input  parameter p-find-next      as logical   no-undo .
     3083   define input  parameter p-find-condition as character no-undo .
     3084   define variable sort-column-phrase as character no-undo .
     3085   define variable l-query-was-opened as logical no-undo .
     3086   define variable title0 as character no-undo .
     3087   define buffer buf_clients for clients.
     3088   case sort-column-name :
     3089     when "" then do:
     3090       assign
     3091         sort-column-phrase = ""
     3092       .
     3093     end.
     3094     otherwise do:
     3095       assign
     3096         sort-column-phrase = "by " + sort-column-name
     3097       .
     3098     end.
     3099   end case.
     3100   filter-point = filter-point0 + p-list-mode .
     3101   case p-list-mode:
     3102    when 'все':U then do:
     3103     title0 = "Коды фирм в системах клиентов".
     3104     ASSIGN
     3105     frame Dialog-Frame:title = substitute("&1", title0)
     3106     filter-label = SUBSTITUTE("&1"
     3107                               , frame Dialog-Frame:title
     3108                               )
     3109     .
     3110   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3111   define variable  l-disable-where-27  as logical   no-undo .
     3112   define variable  l-filter-open-27    as logical   .
     3113   define variable  flt-rec-27       as recid     no-undo .
     3114   define variable  filter-name-27      as character no-undo .
     3115   define variable  where-phrase-27     as character no-undo .
     3116   define variable  sort-phrase-27      as character no-undo .
     3117   define variable  where-phrase-rus-27 as character no-undo .
     3118   define variable  sort-phrase-rus-27  as character no-undo .
     3119   run gbl/flt-get.p
     3120     (input filter-point
     3121     ,output flt-rec-27
     3122     ,output filter-name-27
     3123     ,output where-phrase-27
     3124     ,output sort-phrase-27
     3125     ,output where-phrase-rus-27
     3126     ,output sort-phrase-rus-27
     3127     ).
     3128       run set-filter-name in this-procedure
     3129         (INPUT filter-name-27
     3130         ) no-error .
     3131     assign
     3132       l-filter-open-27 = false
     3133     .
     3134     if flt-rec-27 <> ?
     3135       or sort-column-phrase > ""
     3136     then do:
     3137       define variable  parameter-2-27 as character no-undo .
     3138       define variable  parameter-3-27 as character no-undo .
     3139       define variable  parameter-4-27 as character no-undo .
     3140       define variable  parameter-5-27 as character no-undo .
     3141       define variable  parameter-6-27 as character no-undo .
     3142       define variable  parameter-7-27 as character no-undo .
     3143         assign
     3144         parameter-3-27 =
     3145                                 "FOR EACH X_ext-classif"
     3146         parameter-4-27 =
     3147           (
     3148             if (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'code_firm_ext':U                           AND X_ext-classif.db-num = - 1" + " " + where-phrase-27) <> ""
     3149             then  substitute('X_ext-classif.classif-subject = &1&2&1                           and X_ext-classif.classif-name = &1&3&1                           AND X_ext-classif.db-num = - 1', chr(34), 'clients':U, 'code_firm_ext':U) + " " + where-phrase-27
     3150             else "true"
     3151           )
     3152         parameter-5-27 = (" " + "" + " " + substitute(', FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3153         parameter-6-27 = if sort-phrase-27 = ''
     3154                              then
     3155           (
     3156           " " + "  " +
     3157             " " + sort-column-phrase +
     3158           " " + "  "
     3159           )
     3160                              else
     3161           (
     3162           " " + "  " +
     3163             " " + sort-column-phrase +
     3164           " " + sort-phrase-27
     3165           )
     3166         parameter-7-27 =
     3167           " INDEXED-REPOSITION  "
     3168       .
     3169       do
     3170       on stop undo, leave
     3171       on error undo, leave
     3172       :
     3173         assign
     3174           l-disable-where-27 =
     3175             (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'code_firm_ext':U                           AND X_ext-classif.db-num = - 1" + " " + where-phrase-27 = "")
     3176         .
     3177         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3178                             ,input QUERY br-enum-cli:handle
     3179                             ,input parameter-3-27
     3180                             ,input parameter-4-27
     3181                             ,input parameter-5-27
     3182                             ,input parameter-6-27
     3183                             ,input parameter-7-27
     3184                             )
     3185         .
     3186         assign
     3187           l-filter-open-27 = true
     3188         .
     3189       end.
     3190       if l-filter-open-27 = false then do:
     3191         message
     3192           "Ошибка при фильтрации / сортировке" skip
     3193           "Будут показаны записи без учета фильтра" skip
     3194           view-as alert-box .
     3195       end.
     3196       else do:
     3197           assign
     3198             l-query-was-opened = true
     3199           .
     3200       end.
     3201     end.
     3202     if l-filter-open-27 = false then do:
     3203       OPEN QUERY br-enum-cli FOR EACH X_ext-classif
     3204         where  X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'code_firm_ext':U                           AND X_ext-classif.db-num = - 1
     3205       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3206         INDEXED-REPOSITION
     3207     .
     3208         assign
     3209           l-query-was-opened = true
     3210         .
     3211     end.
     3212    end.
     3213   end case.
     3214   APPLY "entry" TO br-enum-cli.
     3215   if available X_ext-classif then do:
     3216       APPLY "VALUE-CHANGED":U to br-enum-cli.
     3217   END.
     3218   END PROCEDURE.
     3219   PROCEDURE proc-b-add :
     3220   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3221   define variable v-rid as recid no-undo .
     3222   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3223   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3224   define variable v-uniq-key-rec as character no-undo .
     3225   define variable v-tbl-row as rowid no-undo .
     3226   define variable v-tbl-name as character no-undo .
     3227   define variable v-firm-code as integer  no-undo .
     3228   define variable varcode as character no-undo .
     3229   define buffer buf_clients for ub.clients.
     3230   define buffer buf_sysconf for ub.sysconf.
     3231   message
     3232   "Выберите фирму, для которой Вы хотите ввести код в системе клиента"
     3233   view-as alert-box .
     3234   run adm/sconfs.w (
     3235         input parParentProc
     3236       , input "b-sel":U
     3237       , input no
     3238       , input 0
     3239       , output v-firm-code
     3240       , input-output v-rid-list
     3241   ) no-error.
     3242   if v-rid-list = "":U then return.
     3243   find first buf_sysconf no-lock
     3244     where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
     3245   v-value-integer = buf_sysconf.host-code.
     3246   message
     3247   "Выберите клиента, для системы которого Вы хотите ввести код Фирмы"
     3248   view-as alert-box .
     3249   run ref/cli-all.w (   input parparentproc
     3250                     ,input "b-sel"
     3251                     ,input 'орг':U
     3252                     ,input 'все':U
     3253                     ,input 'текущие':U
     3254                     ,input ?
     3255                     ,input ",,,,,,NO,,"
     3256                     ,input "":U
     3257                     ,output v-rid-list) no-error.
     3258   if v-rid-list = '':U then return no-apply.
     3259   find first buf_clients where recid (buf_clients) = integer (v-rid-list) no-lock no-error.
     3260   if not (buf_clients.obj-type = 'орг':U
     3261          or
     3262          buf_clients.obj-type = 'чел':U) then do:
     3263     message
     3264     "Можно выбрать только ОРГАНИЗАЦИЮ или ФИЗ.ЛИЦО"
     3265     view-as alert-box error .
     3266     undo, return error .
     3267   end.
     3268   run gbl/d-prompt.w (
     3269           'title=':u + "Ввод кода фирмы в системе клиента" + '\':u
     3270         + 'text1=':u + "Код" + '\':u
     3271         + 'format=' + "x(20)" + '\':u
     3272         + 'type=' + 'C':U + '\':u
     3273         + 'fillin_row=2\':u
     3274         + 'fillin_col=4\':u
     3275         + 'fillin_width=21\':u
     3276         + 'fillin_height=1\':u
     3277         + 'max-chars=20\':u
     3278         + 'readonly=no'
     3279         , input-output varcode
     3280         ) no-error.
     3281   if return-value <> "TRUE" or error-status:error then do:
     3282     undo, return error .
     3283   end.
     3284   run gen-key-rec IN THIS-PROCEDURE
     3285   ( input 'clients':U
     3286     ,input (buffer buf_clients:handle)
     3287     ,output v-uniq-key-rec).
     3288   run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3289                       ,INPUT NO
     3290                       ,INPUT-OUTPUT v-rid
     3291                       ,INPUT 'clients':U
     3292                       ,INPUT 'code_firm_ext':U
     3293                       ,input (-1)
     3294                       ,input v-value-integer
     3295                       ,input buf_clients.obj-code
     3296                       ,input 0
     3297                       ,input '':U
     3298                       ,input buf_clients.obj-type
     3299                       ,input varcode
     3300                       ,input (if buf_clients.obj-type = 'орг':U then 1000000000 else 0) + buf_clients.obj-code
     3301                       ,input v-uniq-key-rec ) no-error.
     3302   if error-status:error then do:
     3303     undo, return error .
     3304   end.
     3305   if v-rid <> ? then do:
     3306     run openbr in this-procedure ( input yes, input no, input '':U).
     3307     reposition br-enum-cli to recid v-rid no-error .
     3308     apply "entry" to br-enum-cli in frame Dialog-Frame .
     3309   end.
     3310   END PROCEDURE.
     3311   PROCEDURE proc-b-del :
     3312   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3313   DEFINE VARIABLE glog AS logical NO-UNDO.
     3314   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3315   v-rec = recid(X_ext-classif).
     3316   MESSAGE
     3317   "Вы действительно хотитет удалить эту запись?"
     3318   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3319   IF NOT glog THEN RETURN ERROR.
     3320   run ref/extclas3.p ( INPUT NO
     3321                       ,INPUT v-rec) NO-ERROR.
     3322   if not error-status:error then do:
     3323     run openbr in this-procedure ( input yes, input no, input '':U).
     3324     reposition br-enum-cli to row 1 no-error .
     3325     apply "entry" to br-enum-cli in frame Dialog-Frame .
     3326   end.
     3327   END PROCEDURE.
     3328   PROCEDURE proc-b-print :
     3329   DEFINE VARIABLE date_string              as   character no-undo .
     3330   DEFINE VARIABLE Line                     as   character no-undo .
     3331   DEFINE VARIABLE for-time                 as   character no-undo .
     3332   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3333   define variable v-rid                    as   recid no-undo .
     3334   DEFINE VARIABLE v-firm-name AS CHARACTER NO-UNDO.
     3335   DEFINE FRAME list1
     3336   X_ext-classif.KEY#_one  COLUMN-LABEL "Код!фирмы" FORMAT ">>>>9"
     3337   v-firm-name COLUMN-LABEL "Фирма" FORMAT "X(30)"
     3338   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     3339   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     3340   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(56)"
     3341   X_ext-classif.CharKey_Three COLUMN-LABEL "Код фирмы!в системе клиента" FORMAT "X(20)"
     3342   HEADER  date_string AT 5 format "X(35)"
     3343   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3344   Line format "X(132)" AT 1
     3345   with width 232 down stream-io use-text    .
     3346   Line = fill("-", 132).
     3347   date_string = cur-time-print() .
     3348   run prn-lib-open-stream  in this-procedure (
     3349                                                input parParentProc
     3350                                               ,input  62
     3351                                               ,input yes
     3352                                               ,input no
     3353                                               ).
     3354   PUT  STREAM PrnLibStream
     3355   SPACE(25) ( frame Dialog-Frame:title )
     3356   format "x(90)" SKIP(1) .
     3357   FORM HEADER
     3358   Line format "X(132)" AT 1 SKIP
     3359   "Продолжение - на следующей странице" AT 30 SKIP
     3360   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3361   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3362   v-rid = recid(X_ext-classif).
     3363   FORM with FRAME List1.
     3364   run waitfram-show in this-procedure ( input "Ждите...").
     3365   DO WHILE available X_ext-classif :
     3366      GET prev br-enum-cli.
     3367   END.
     3368   GET next br-enum-cli.
     3369   DO WHILE available X_ext-classif :
     3370     v-firm-name = get-firm-name(X_ext-classif.key#_one).
     3371     Display STREAM PrnLibStream
     3372     v-firm-name
     3373     X_ext-classif.KEY#_one
     3374     X_clients.obj-type
     3375     X_clients.obj-code
     3376     X_clients.obj-name
     3377     X_ext-classif.CharKey_Three
     3378     with FRAME List1.
     3379     DOWN STREAM PrnLibStream
     3380     1
     3381     with FRAME List1.
     3382     assign
     3383     accum-count = accum-count + 1
     3384     .
     3385     GET next br-enum-cli.
     3386   END.
     3387   UNDERLINE  STREAM PrnLibStream
     3388   X_ext-classif.KEY#_one
     3389   v-firm-name
     3390   X_clients.obj-type
     3391   X_clients.obj-code
     3392   X_clients.obj-name
     3393   X_ext-classif.CharKey_Three
     3394   with FRAME List1.
     3395   DISPLAY STREAM PrnLibStream
     3396   accum-count @ X_ext-classif.key#_one
     3397   with frame List1.
     3398   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3399   HIDE  STREAM PrnLibStream FRAME List1.
     3400   output  STREAM PrnLibStream CLOSE.
     3401   reposition br-enum-cli to recid v-rid no-error .
     3402   apply "ENTRY" to br-enum-cli in frame Dialog-Frame .
     3403   run waitfram-hide in this-procedure .
     3404   run prn-lib-prn-file in this-procedure (
     3405                                             input parParentProc
     3406                                             ,input 0
     3407                                             ).
     3408   END PROCEDURE.
     3409   PROCEDURE proc-b-sch :
     3410   define variable v-ri as recid no-undo .
     3411   assign
     3412   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3413   .
     3414   assign
     3415   tbl = 'ext-classif':U
     3416   join-tbl = 'X_ext-classif'
     3417   fld = ""
     3418   lab = ""
     3419   spr = ""
     3420   dim = '0'
     3421   .
     3422   run fltfield-add in this-procedure('key#_one', 'Код Фирмы', '',
     3423   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3424   DO on stop undo, leave:
     3425       run gbl/filter.w ( INPUT parparentproc
     3426                    ,INPUT filter-point + chr(4) + filter-label
     3427                    ,INPUT tbl
     3428                    ,INPUT join-tbl
     3429                    ,INPUT fld
     3430                    ,INput lab
     3431                    ,INPUT spr
     3432                    ,INPUT  dim).
     3433       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3434       if v-ri <> ? then do:
     3435         reposition br-enum-cli to recid v-ri no-error.
     3436       end.
     3437       APPLY "ENTRY" to br-enum-cli in frame Dialog-Frame .
     3438       APPLY "VALUE-CHANGED" to br-enum-cli.
     3439   END .
     3440   END PROCEDURE.
     3441   PROCEDURE get-host-name-proc :
     3442     define input  parameter p-host-code as integer   no-undo .
     3443     define output parameter p-host-name as character no-undo .
     3444     define buffer buf_clients for ub.clients .
     3445     do
     3446     on error undo, return error return-value
     3447     :
     3448       find first buf_clients no-lock
     3449         where buf_clients.obj-type = 'орг':U
     3450           and buf_clients.obj-code = p-host-code
     3451         no-error .
     3452       if available buf_clients
     3453       then do:
     3454         assign
     3455           p-host-name = (if buf_clients.stts = 0
     3456                          then buf_clients.obj-name
     3457                          else (substring (buf_clients.obj-name, 1, 20)
     3458                               + fill (" " , 20 - length (substring (buf_clients.obj-name, 1, 20)))
     3459                               + '---  УДАЛЕН  ---':U
     3460                               )
     3461                         )
     3462         .
     3463       end.
     3464     end.
     3465   END PROCEDURE.
     3466   FUNCTION get-firm-name RETURNS CHARACTER
     3467     ( INPUT p-host-code AS integer ) :
     3468     define variable v-host-name as character no-undo .
     3469     run get-host-name-proc in this-procedure
     3470       (input  p-host-code
     3471       ,output v-host-name
     3472       ) .
     3473     return v-host-name .
     3474   END FUNCTION.
