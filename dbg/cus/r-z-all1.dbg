     1761                       ub.gds-obj.artic     = temp-goods.artic     and
     1762                       ub.gds-obj.prod-type = temp-goods.prod-type and
     1763                       ub.gds-obj.prod-code = temp-goods.prod-code and
     1764                       ub.gds-obj.obj-code  = obj-list.obj-code and
