     1402   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1403     if num-entries(string(p-dec), '.') = 2
     1404       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1405       else return( string(p-dec)) .
     1406   end function.
     1407   function format-point-to-comma returns char (input orig as char ) .
     1408   define variable rtext as character no-undo .
     1409   define variable strt as integer no-undo .
     1410   define variable leng as integer no-undo .
     1411   assign rtext = orig .
     1412   repeat:
     1413     strt =  index(rtext,'.').
     1414     if strt = 0 then leave.
     1415     leng = 1.
     1416     substring(rtext,strt,leng,"character") = v-delim .
     1417   end.
     1418   return rtext.
     1419   end function.
     1420   function format-excel-text returns char ( input start-text as char ) :
     1421   def var  i    as int no-undo.
     1422   def var  ch   as char no-undo.
     1423   def var  n    as int no-undo.
     1424   def var  ipos as int no-undo.
     1425     n = num-entries(trim(start-text), chr(10)) - 1 .
     1426     do i = 1 to n :
     1427       ipos = index( start-text, chr(10)).
     1428       if ipos > 0 then
     1429         substr( start-text, ipos, 1 ) = ' '.
     1430     end.
     1431     n = num-entries(trim(start-text), chr(13)) - 1 .
     1432     do i = 1 to n :
     1433       ipos = index( start-text, chr(13)).
     1434       if ipos > 0 then
     1435         substr( start-text, ipos, 1 ) = ' '.
     1436     end.
     1437     if index( start-text, '"' ) = 0 then
     1438       start-text =  '="'   + trim( start-text) + '"'   .
     1439       else do:
     1440         n = num-entries(trim(start-text), '"') - 1.
     1441         do i = 1 to n :
     1442           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1443         end.
     1444         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1445         start-text = '="'  + ch  + '"' .
     1446       end.
     1447     return start-text.
     1448   end.
     1449   function excel-sum returns char (input p-dec as decimal ).
     1450     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1451   end function.
     1452   function excel-qnty returns char (input p-dec as decimal ).
     1453     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1454   end function.
     1455   function format-excel-text-macr returns char ( input start-text as char ) :
     1456   def var  i    as int no-undo.
     1457   def var  ch   as char no-undo.
     1458   def var  n    as int no-undo.
     1459   def var  ipos as int no-undo.
     1460     n = num-entries(trim(start-text), chr(10)) - 1 .
     1461     do i = 1 to n :
     1462       ipos = index( start-text, chr(10)).
     1463       if ipos > 0 then
     1464         substring( start-text, ipos , 1 ) = ' '.
     1465     end.
     1466     n = num-entries(trim(start-text), chr(13)) - 1 .
     1467     do i = 1 to n :
     1468       ipos = index( start-text, chr(13)).
     1469       if ipos > 0 then
     1470         substring( start-text, ipos, 1 ) = ' '.
     1471     end.
     1472     if index( start-text, '"' ) = 0 then
     1473       start-text =  '"'   + trim( start-text) + '"'   .
     1474       else do:
     1475         n = num-entries(trim(start-text), '"') - 1.
     1476         do i = 1 to n :
     1477           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1478         end.
     1479         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1480         start-text = '"'  + ch  + '"' .
     1481       end.
     1482     n = num-entries(trim(start-text), chr(10)) - 1 .
     1483     do i = 1 to n :
     1484       ipos = index( start-text, chr(10)).
     1485       if ipos > 0 then
     1486         substring( start-text, ipos , 1 ) = ' '.
     1487     end.
     1488       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1489     return start-text.
     1490   end.
     1491   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     1493      IF parundefine-var = ? THEN RETURN 0.00.
     1494                             ELSE RETURN parundefine-var.
     1495   END FUNCTION.
     1496   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     1497      IF p-undef-char = ? THEN do:
     1498        RETURN "?".
     1499      end.
     1500      ELSE do:
     1501        RETURN p-undef-char .
     1502      end.
     1503   END FUNCTION.
     1504   procedure report-execute :
     1505     if (valtype=0 and x-base-code=0)  or valtype=1
     1506                                   then   assign tprintrubl = yes .
     1507                                   else   assign tprintrubl = no .
     1508      no-prise = true .
     1509     if var-report-r-b = "rubl"  then do:
     1510       if  x-base-code <> 0 and valtype = 2  then no-prise = false  .
     1511       end.
     1512     else do:
     1513       if  x-base-code <> 0 and valtype = 1  then no-prise = false  .
     1514     end.
     1515     run waitfram-show( 'Подождите ...' ) .
     1516     run calcitog in this-procedure.
     1517     run print-header in this-procedure.
     1518     run prep-file in this-procedure.
     1519       case classify :
     1520         when 1 then do:
     1521           run foreach1 in this-procedure.
     1522         end.
     1523         when 2 then do:
     1524           run foreach2 in this-procedure.
     1525         end.
     1526         when 3 then do:
     1527           run foreach3 in this-procedure.
     1528         end.
     1529         when 4 then do:
     1530           run foreach4 in this-procedure.
     1531         end.
     1532       end case.
     1533     run print-footer in this-procedure.
     1534     if Make-Excel then output stream ForExcel close.
     1535     run waitfram-hide .
     1536     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1537   end procedure.
     1538   procedure print-header :
     1539            reportname = reportname +
     1540           "на "  + cur-time-string-sec()  .
     1541     run rep/extitle.p (1) .
     1542   end procedure.
     1543   procedure print-footer :
     1544     define variable v-today as date      no-undo .
     1545     define variable v-time  as integer   no-undo .
     1546     run cur-time in this-procedure ( output v-today
     1547                                    , output v-time
     1548                                    ).
     1549     if Make-Excel then  put   stream ForExcel unformatted " Печать закончена : " + string(v-time,"hh:mm:ss") skip.
     1550     if Make-Excel then  put   stream ForExcel unformatted " За время формирования отчета были закрыты документы : " skip.
     1551     for each obj-list no-lock :
     1552         for each ub.trn-doc no-lock where
     1553             ub.trn-doc.status_ = 'факт':U and
     1554             ub.trn-doc.flag_= true and
     1555             ub.trn-doc.host-code = v-cntxt-host-code-obj and
     1556             ub.trn-doc.obj-code = obj-list.obj-code and
     1557             ub.trn-doc.obj-type = obj-list.obj-type
     1558             by ub.trn-doc.fact-order descending :
     1559             if ub.trn-doc.fact-order <= fact-order-2 then leave.
     1560             if Make-Excel then  put   stream ForExcel unformatted ub.trn-doc.doc-code skip.
     1561         end.
     1562     end.
     1563     if Make-Excel then  put   stream ForExcel unformatted " ______________________________________________________" skip.
     1564      end procedure.
     1565   procedure calcitog :
     1566       run ostatok (
     1567           input x-store-code  ,
     1568           input x-store-type  , x-tog-shift,
     1569           input x-date-start - 1 ,
     1570           input date('')      , x-shift-start,x-shift-end,
     1571           input 'crsa':U   ,
     1572           input '##,##':U,
     1573           input xtog-obj ,
     1574           output  quantity1  ,
     1575           output  coast_r1   ,
     1576           output  coast_v1   ,
     1577           output  vat_r1     ,
     1578           output  vat_v1     ,
     1579           output  fact-order-1 ).
     1580       run ostatok (
     1581           input x-store-code  ,
     1582           input x-store-type  , x-tog-shift,
     1583           input x-date-start  ,
     1584           input x-date-end    , x-shift-start,x-shift-end,
     1585           input 'crsa':U   ,
     1586           input '##,##':U,
     1587           input xtog-obj ,
     1588           output  quantity1  ,
     1589           output  coast_r1   ,
     1590           output  coast_v1   ,
     1591           output  vat_r1     ,
     1592           output  vat_v1     ,
     1593           output  fact-order-2 ).
     1594             quantity1  = 0.
     1595             coast_r1   = 0.
     1596             coast_v1   = 0.
     1597             vat_r1     = 0.
     1598             vat_v1     = 0.
     1599   end procedure.
     1600   procedure foreach1 :
     1601   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1602   n-nn = 0.
     1603   n-no = n-no + 1 .
     1604    For Each temp-goods  no-lock
     1605               break
     1606                   by ( temp-goods.artic + temp-goods.prod-type + string ( temp-goods.prod-code ))
     1607                   by temp-goods.prod-type By temp-goods.prod-code by temp-goods.artic
     1608                    with FRAME Zapas :
     1609                 IF first-of(temp-goods.artic) then DO:
     1610                   assign
     1611                     f-qnty       = 0
     1612                     f-cost-sum   = 0
     1613                     f-sale-sum   = 0
     1614                     f-sale-other = 0
     1615                     .
     1616               End.
     1617             if last-of(temp-goods.artic) then DO:
     1618                n-nm = n-nm + 1.
     1619   If Integer(50) = 0 Then Temp1  = 100  .
     1620                         Else Temp1 = Integer(50) .
     1621        IF ( n-nm modulo Temp1 = 0 ) AND ( n-nm >= Temp1 ) then
     1622            RUN waitfram-show( "Обработано строк : " + string( n-nm )) .
     1623               n-nn = n-nn + 1 .
     1624               if itog = false  Then DO:
     1625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1626     (input  temp-goods.gds-code
     1627     ,input  ?
     1628     ,output v-bar-code
     1629     )  .
     1630                   if Make-Excel then  put   stream ForExcel unformatted
     1631                       string(n-nn)                      CHR(9)
     1632                       v-bar-code                        CHR(9)
     1633                       format-excel-text(temp-goods.artic)    CHR(9)
     1634                       temp-goods.gds-name                    CHR(9)
     1635                                                         CHR(9)
     1636                                                         .
     1637               End.
     1638               For each obj-list no-lock :
     1639                   Assign
     1640                     f-qnty       = 0
     1641                     f-cost-sum   = 0
     1642                     f-sale-sum   = 0
     1643                     f-sale-other = 0
     1644                   .
     1645                   for each ub.gds-obj no-lock where
     1646                       ub.gds-obj.artic     = temp-goods.artic     and
     1647                       ub.gds-obj.prod-type = temp-goods.prod-type and
     1648                       ub.gds-obj.prod-code = temp-goods.prod-code and
     1649                       ub.gds-obj.obj-code  = obj-list.obj-code and
     1650                       ub.gds-obj.obj-type  = obj-list.obj-type    :
     1651                       Assign
     1652                       f-qnty       = f-qnty     + ub.gds-obj.fact-qnty
     1653                       f-cost-sum   = f-cost-sum + determined(ub.gds-obj.fact-rubl)
     1654                       f-sale-sum   = f-sale-sum + ub.gds-obj.fact-sale
     1655                       .
     1656                   End.
     1657                   f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     1658                       if itog = false
     1659                           Then DO:
     1660                               if Make-Excel then  put   stream ForExcel unformatted
     1661                               excel-qnty(f-qnty        )        CHR(9)
     1662                               if p-cost then ( excel-sum (f-cost-sum    )    +    CHR(9) ) else ""
     1663                               if p-sale then ( excel-sum (f-sale-sum    )    +    CHR(9) ) else ""
     1664                               if p-dis  then ( excel-sum (f-sale-other  )    +    CHR(9) ) else ""
     1665                               .
     1666                       End.
     1667                find first Temp-i where Temp-i.obj-code  = obj-list.obj-code and
     1668                                        Temp-i.obj-type  = obj-list.obj-type  no-error .
     1669                     if not avail Temp-i Then  create Temp-i no-error .
     1670                     assign
     1671                       Temp-i.obj-code     = obj-list.obj-code
     1672                       Temp-i.obj-type     = obj-list.obj-type
     1673                       Temp-i.b-qnty       = Temp-i.b-qnty       + f-qnty
     1674                       Temp-i.b-cost-sum   = Temp-i.b-cost-sum   + f-cost-sum
     1675                       Temp-i.b-sale-sum   = Temp-i.b-sale-sum   + f-sale-sum
     1676                       Temp-i.b-sale-other = Temp-i.b-sale-other + f-sale-other
     1677                     .
     1678            end.
     1679                if  Itog = false Then do:
     1680                    if Make-Excel then  put   stream ForExcel unformatted  chr(10) .
     1681                End.
     1682                run display-prt in this-procedure  .
     1683             End.
     1684    End.
     1685     if Make-Excel then  put   stream ForExcel unformatted
     1686             "ИТОГО"                           CHR(9)
     1687             "по объектам"                     CHR(9)
     1688                         CHR(9)
     1689                         CHR(9)
     1690                         CHR(9)
     1691                 .
     1692                 for each obj-list no-lock :
     1693                      find first Temp-i where Temp-i.obj-code  = obj-list.obj-code and
     1694                                              Temp-i.obj-type  = obj-list.obj-type no-lock  no-error .
     1695                       if not avail Temp-i Then  create Temp-i no-error .
     1696                       assign
     1697                         Temp-i.obj-code     = obj-list.obj-code
     1698                         Temp-i.obj-type     = obj-list.obj-type
     1699                         .
     1700                       if Make-Excel then  put   stream ForExcel unformatted
     1701                       excel-qnty(Temp-i.b-qnty           )   CHR(9)
     1702                      if p-cost then ( excel-sum (Temp-i.b-cost-sum       ) +  CHR(9) ) else ""
     1703                      if p-sale then ( excel-sum (Temp-i.b-sale-sum       ) +  CHR(9) ) else ""
     1704                      if p-dis  then ( excel-sum (Temp-i.b-sale-other     ) +  CHR(9) ) else ""
     1705                       .
     1706                 End.
     1707             if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     1708   end procedure.
     1709   procedure foreach2 :
     1710   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1711   n-nn = 0.
