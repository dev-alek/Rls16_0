     1841                             Temp-b.b-cost-sum   = 0
     1842                             Temp-b.b-sale-sum   = 0
     1843                             Temp-b.b-sale-other = 0
     1844                             .
     1845                 End.
     1846                 if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     1847             End.
     1848    End.
     1849     if Make-Excel then  put   stream ForExcel unformatted
     1850             "ИТОГО"                           CHR(9)
