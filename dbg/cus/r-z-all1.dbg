     2201   procedure display-prt :
     2202   if itog = false  then do:
     2203   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2204   IF temp-goods.prt-root <> Prtroot Then DO:
     2205       for each ub.gds-prt no-lock where
     2206           ub.gds-prt.prt-root = temp-goods.prt-root and
     2207           ub.gds-prt.IS-term   =  true
     2208           by ub.gds-prt.f-name with FRAME Zapas :
     2209                pp = 0 .
     2210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2211     (input  temp-goods.gds-code
     2212     ,input  ub.gds-prt.node-code
     2213     ,output v-bar-code
     2214     )  .
     2215               For each obj-list no-lock :
     2216                   Assign
     2217                     p-qnty      =  0
     2218                     p-cost-sum  =  0
     2219                     p-sale-sum  =  0
     2220                     p-sale-other=  0
     2221                     .
     2222                   for each ub.prt-obj no-lock where
     2223                       ub.prt-obj.artic     = temp-goods.artic     and
     2224                       ub.prt-obj.prod-type = temp-goods.prod-type and
     2225                       ub.prt-obj.prod-code = temp-goods.prod-code and
     2226                       ub.prt-obj.obj-code  = obj-list.obj-code and
     2227                       ub.prt-obj.obj-type  = obj-list.obj-type and
     2228                       ub.prt-obj.IS-term   =  true and
     2229                       ub.prt-obj.prt-code  = ub.gds-prt.node-code :
     2230                       Assign
     2231                         p-qnty      = p-qnty       + ub.prt-obj.fact-qnty
     2232                         p-sale-sum  = p-sale-sum   + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     2233                   End.
     2234                   Assign
     2235                     p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     2236                     p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     2237                     .
     2238                   create temp-gds-prt.
     2239                   assign temp-gds-prt.v-p-qnty       = p-qnty
     2240                           temp-gds-prt.v-p-cost-sum   = p-cost-sum
     2241                           temp-gds-prt.v-p-sale-sum   = p-sale-sum
     2242                           temp-gds-prt.v-p-sale-other = p-sale-other
     2243                           temp-gds-prt.obj-code = obj-list.obj-code
     2244                           temp-gds-prt.obj-type = obj-list.obj-type
     2245                           .
     2246               End.
     2247               pp = 0.
     2248               for each obj-list no-lock ,
     2249                   each temp-gds-prt where temp-gds-prt.obj-code = obj-list.obj-code and
     2250                                           temp-gds-prt.obj-type = obj-list.obj-type no-lock  :
     2251                     if not (
     2252                     temp-gds-prt.v-p-qnty      =  0 and
     2253                     temp-gds-prt.v-p-cost-sum  =  0 and
     2254                     temp-gds-prt.v-p-sale-sum  =  0 and
     2255                     temp-gds-prt.v-p-sale-other=  0   ) then do:
     2256                        pp = 1.
     2257                        leave.
     2258                        end.
     2259               End.
     2260                 if pp = 1 then do :
     2261                   if Make-Excel then  put   stream ForExcel unformatted
     2262                                  CHR(9)
     2263                         v-bar-code                  CHR(9)
     2264                                                     CHR(9)
     2265                                                     CHR(9)
     2266                         ub.gds-prt.f-name              CHR(9)
     2267                         .
     2268                     for each obj-list no-lock :
     2269                         find first temp-gds-prt where temp-gds-prt.obj-code = obj-list.obj-code and
     2270                                                       temp-gds-prt.obj-type = obj-list.obj-type no-lock  no-error .
     2271                         if avail temp-gds-prt then do:
     2272                         if Make-Excel then  put   stream ForExcel unformatted
     2273                           excel-qnty(temp-gds-prt.v-p-qnty        )   CHR(9)
     2274                           if p-cost then ( excel-sum (temp-gds-prt.v-p-cost-sum    ) +  CHR(9)) else ""
     2275                           if p-sale then ( excel-sum (temp-gds-prt.v-p-sale-sum    ) +  CHR(9)) else ""
     2276                           if p-dis  then ( excel-sum (temp-gds-prt.v-p-sale-other  ) +  CHR(9)) else ""
     2277                           .
     2278                         End.
     2279                     End.
     2280                     if  Itog = false Then do:
     2281                         if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     2282                         End.
     2283                 End .
     2284                 for each temp-gds-prt : delete temp-gds-prt. end.
     2285       End.
     2286   End.
     2287   end.
     2288   end procedure.
     2289   procedure prep-file :
     2290   for each obj-list no-lock :
     2291      for each ub.gds-obj where not (
     2292               ub.gds-obj.fact-qnty = 0 and
     2293               ub.gds-obj.avrg-qnty = 0 and
     2294               ub.gds-obj.fact-sale = 0 )
     2295               and
     2296               ub.gds-obj.obj-code  = obj-list.obj-code and
     2297               ub.gds-obj.obj-type  = obj-list.obj-type no-lock
     2298               :
     2299               find first ub.goods   where
     2300                                  ub.goods.gds-code = ub.gds-obj.gds-code no-lock no-error .
     2301               find first ub.clients where
     2302                                  ub.clients.obj-code = ub.gds-obj.prod-code and
     2303                                  ub.clients.obj-type = ub.gds-obj.prod-type no-lock no-error .
     2304               if avail ub.goods and
     2305                   avail ub.clients and
     2306                   not can-find (temp-goods where temp-goods.gds-code = ub.gds-obj.gds-code no-lock ) then do:
     2307                  create temp-goods.
     2308   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2310     (input  ub.gds-obj.obj-type
     2311     ,input  ub.gds-obj.obj-code
     2312     ,output v-host-code
     2313     )  .
     2314   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2315   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2316     (input  ub.gds-obj.gds-code
     2317     ,input  '1':U
     2318     ,input  ?
     2319     ,input  v-host-code
     2320     ,input  ub.gds-obj.obj-type
     2321     ,input  ub.gds-obj.obj-code
     2322     ,output v-vat-pc
     2323     ) no-error .
     2324                  assign
     2325                     temp-goods.gds-code  = ub.goods.gds-code
     2326                     temp-goods.b-code    = ub.goods.gds-code
     2327                     temp-goods.artic     = ub.goods.artic
     2328                     temp-goods.cli       = ub.clients.obj-name
     2329                     temp-goods.grp-name  = ub.goods.grp-name
     2330                     temp-goods.vat-pc    = v-vat-pc
     2331                     temp-goods.prod-code = ub.goods.prod-code
     2332                     temp-goods.prod-type = ub.goods.prod-type
     2333                     temp-goods.prt-root  = ub.goods.prt-root
     2334                     temp-goods.gds-name  = ub.goods.gds-name
     2335                     .
     2336               end.
     2337      end.
     2338   end.
     2339   end procedure.
     2340   PROCEDURE ostatok :
     2341   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2342   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2343   def input parameter x-tog-shift   as   logical             no-undo.
     2344   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2345   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2346   def input parameter x-shift-start as integer               no-undo.
     2347   def input parameter x-shift-end   as integer               no-undo.
     2348   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2349   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2350   def input parameter xTog-obj   as log no-undo.
     2351   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2352   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2353   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2354   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2355   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2356   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2357   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2358   def var              Fact-orderS   as char  no-undo.
     2359   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2360      Assign
     2361         Fact-order   = 0
     2362         Quantity     = 0
     2363         Coast_R      = 0
     2364         Coast_V      = 0
     2365         VAT_R        = 0
     2366         VAT_V        = 0 .
     2367    x-date-start-t  = x-date-start + 1 .
     2368   IF x-date-end = date('') then DO:
     2369      Fact-order = 0 .
     2370      for each obj-list
     2371          where  ( not xtog-obj or
     2372                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2373                 no-lock :
     2374         if  x-tog-shift = false then do:
     2375                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2376                               ub.stk-tot.Fact-date <=  x-date-start
     2377                               and ub.stk-tot.shift-num = 0
     2378                               USE-INDEX fact-date no-lock no-error .
     2379              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2380         End.
     2381         Else  DO :
     2382             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2383              (ub.stk-tot.shift-date  = x-date-start-t and
     2384               ub.stk-tot.shift-num  < x-shift-start or
     2385               ub.stk-tot.shift-date  < x-date-start-t  )
     2386               and ub.stk-tot.shift-num  > 0
     2387               USE-INDEX Shift-num no-lock no-error .
     2388            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2389           END.
     2390       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2391     End.
     2392   End.
     2393   Else DO:
     2394     For each obj-list  WHERE
     2395        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2396         no-lock :
     2397      IF  x-TOG-Shift = False Then DO:
     2398          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2399               ub.stk-tot.Fact-date <= x-date-end
     2400               and ub.stk-tot.shift-num = 0
     2401               USE-INDEX fact-date no-lock no-error.
     2402          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2403      END.
     2404      Else DO:
     2405           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2406               (ub.stk-tot.shift-date  = x-date-end and
     2407               ub.stk-tot.shift-num  <= x-shift-end or
     2408               ub.stk-tot.shift-date  < x-date-end       ) and
     2409               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2410               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2411       End.
     2412       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2413     End.
     2414   End.
     2415   END PROCEDURE.
