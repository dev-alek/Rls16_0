     1782                find first Temp-i where Temp-i.obj-code  = obj-list.obj-code and
     1783                                        Temp-i.obj-type  = obj-list.obj-type  no-error .
     1784                     if not avail Temp-i Then  create Temp-i no-error .
     1785                     assign
     1786                       Temp-i.obj-code     = obj-list.obj-code
     1787                       Temp-i.obj-type     = obj-list.obj-type
     1788                       Temp-i.b-qnty       = Temp-i.b-qnty       + f-qnty
     1789                       Temp-i.b-cost-sum   = Temp-i.b-cost-sum   + f-cost-sum
     1790                       Temp-i.b-sale-sum   = Temp-i.b-sale-sum   + f-sale-sum
     1791                       Temp-i.b-sale-other = Temp-i.b-sale-other + f-sale-other
     1792                     .
     1793                find first Temp-b where Temp-b.obj-code  = obj-list.obj-code and
     1794                                        Temp-b.obj-type  = obj-list.obj-type no-error .
     1795                     if not avail Temp-b Then  create Temp-b no-error .
     1796                     assign
     1797                       Temp-b.grp          = STRING(temp-goods.cli)
     1798                       Temp-b.obj-code     = obj-list.obj-code
     1799                       Temp-b.obj-type     = obj-list.obj-type
     1800                       Temp-b.b-qnty       = Temp-b.b-qnty       + f-qnty
     1801                       Temp-b.b-cost-sum   = Temp-b.b-cost-sum   + f-cost-sum
     1802                       Temp-b.b-sale-sum   = Temp-b.b-sale-sum   + f-sale-sum
