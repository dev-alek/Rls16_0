     1824                           excel-qnty(Temp-b.b-qnty           )   CHR(9)
     1825                           if p-cost then ( excel-sum (Temp-b.b-cost-sum       ) +  CHR(9) ) else ""
     1826                           if p-sale then ( excel-sum (Temp-b.b-sale-sum       ) +  CHR(9) ) else ""
