     2186               Assign Break_Group = True.
     2187           End.
     2188           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2189           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2190             Then  Assign
     2191                 S-bar-code   = "Итого по "
     2192                 Gds-zap-artic = Substring(
     2193                                      B1-name
     2194                                     ,1,16)
     2195                 Gds-zap-gds-name = Substring(
     2196                                      B1-name
     2197                                     ,17,40)
     2198                               .
     2199             Else Assign
     2200                 S-bar-code = ""
     2201                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2202                                                                    Else "  Итого по "
     2203                 Gds-zap-gds-name =   B1-name
     2204                 .
     2205             Run Display-b2 In This-procedure .
     2206             Run Clear-b2 In This-procedure .
     2207             Run Clear-b1 In This-procedure .
     2208             Assign  Break_Group1 = True.
     2209           End.
     2210         end.
     2211     end.
     2212     else do:
     2213         for each obj-list no-lock :
     2214               for  each gds-obj
     2215                 where  gds-obj.obj-code   = obj-list.obj-code
     2216                   and  gds-obj.obj-type   = obj-list.obj-type
     2217                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2218                 no-lock ,
