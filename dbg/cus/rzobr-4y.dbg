     1723                   output  coast_v     ,
     1724                   output  vat_r       ,
     1725                   output  vat_v       ,
     1726                   output  slt_r       ,
     1727                   output  slt_v       ).
     1728   assign
     1729     ostatok-end [1 + 0]   = quantity
     1730    ostatok-end [2 + 0]   = if tprintrubl then coast_r else coast_v
     1731    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1732    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1733    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1734    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1735    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1736    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1737    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1738    .
     1739    assign
     1740     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1741     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1742     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1743    .
     1744   If  xshowcrsa or vat-crsa Then DO:
     1745   run ost-line in this-procedure
     1746                  (input   x-store-code  ,
     1747                   input   x-store-type  ,
     1748                   input   gds-zap-artic     ,
     1749                   input   gds-zap-prod-code ,
     1750                   input   gds-zap-prod-type ,
     1751                   input   x-tog-shift       ,
     1752                   input   Fact-order-2               ,
     1753                   input   'crsa':U            ,
     1754                   input   '##,##':U    ,
     1755                   input   xtog-obj    ,
     1756                   output  quantity    ,
     1757                   output  coast_r     ,
     1758                   output  coast_v     ,
     1759                   output  vat_r       ,
     1760                   output  vat_v       ,
     1761                   output  slt_r       ,
     1762                   output  slt_v       ).
     1763   assign
     1764     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1765    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1766    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1767    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1768    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1769    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1770    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1771    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1772    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1773    .
     1774    assign
     1775     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1776     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1777     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1778    .
     1779      End.
     1780   If xshowsale or vat-sale Then DO:
     1781   run ost-line in this-procedure
     1782                  (input   x-store-code  ,
     1783                   input   x-store-type  ,
     1784                   input   gds-zap-artic     ,
     1785                   input   gds-zap-prod-code ,
     1786                   input   gds-zap-prod-type ,
     1787                   input   x-tog-shift       ,
     1788                   input   Fact-order-2               ,
     1789                   input   'crsa':U            ,
     1790                   input   '##,##':U    ,
     1791                   input   xtog-obj    ,
     1792                   output  quantity    ,
     1793                   output  coast_r     ,
     1794                   output  coast_v     ,
     1795                   output  vat_r       ,
     1796                   output  vat_v       ,
     1797                   output  slt_r       ,
     1798                   output  slt_v       ).
     1799   assign
     1800     ostatok-end [1 + 6]   = quantity
     1801    ostatok-end [2 + 6]   = if tprintrubl then coast_r else coast_v
     1802    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1803    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     1804    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1805    b1-ostatok-end [2 + 6] =  b1-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1806    b1-ostatok-end [3 + 6] =  b1-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1807    b2-ostatok-end [1 + 6] =  b2-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1808    b2-ostatok-end [2 + 6] =  b2-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1809    b2-ostatok-end [3 + 6] =  b2-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1810    b1-ostatok-end [10] =  b1-ostatok-end [10] + ostatok-end [10]
     1811    b2-ostatok-end [10] =  b2-ostatok-end [10] + ostatok-end [10]
     1812    .
     1813    assign
     1814     bi-ostatok-end [1 + 6] =  bi-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1815     bi-ostatok-end [2 + 6] =  bi-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1816     bi-ostatok-end [3 + 6] =  bi-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1817     bi-ostatok-end [10] =  bi-ostatok-end [10] + ostatok-end [10]
     1818    .
     1819      End.
     1820       case  gds-zap-type :
     1821       when 'у':U THEN DO:
     1822         run ob-line (
     1823             input   x-store-code   ,
     1824             input   x-store-type   ,
     1825             INPUT   gds-zap-artic       ,
     1826             INPUT   gds-zap-prod-code   ,
     1827             INPUT   gds-zap-prod-type   ,
     1828             INPUT   Fact-order-1,
     1829             INPUT   Fact-order-2,
     1830             input   'cssr':U    ,
     1831             input   '##,##':U,
     1832             input   ""    ,
     1833             input   xTog-obj) .
     1834        End.
     1835       when 'т':U THEN DO:
     1836         run ob-line (
     1837             input   x-store-code   ,
     1838             input   x-store-type   ,
     1839             INPUT   gds-zap-artic       ,
     1840             INPUT   gds-zap-prod-code   ,
     1841             INPUT   gds-zap-prod-type   ,
     1842             INPUT   Fact-order-1,
     1843             INPUT   Fact-order-2,
     1844             input   'cost':U    ,
     1845             input   '##,##':U,
     1846             input   ""    ,
     1847             input   xTog-obj) .
     1848         End.
     1849         End case.
     1850      run calc-sub-itog (0).
     1851     If xshowcrsa OR  xshowsale or vat-crsa or vat-sale Then DO:
     1852       case  gds-zap-type :
     1853       when 'у':U THEN DO:
     1854         run ob-line (
     1855             input   x-store-code   ,
     1856             input   x-store-type   ,
     1857             INPUT   gds-zap-artic       ,
     1858             INPUT   gds-zap-prod-code   ,
     1859             INPUT   gds-zap-prod-type   ,
     1860             INPUT   Fact-order-1,
     1861             INPUT   Fact-order-2,
     1862             input   'cgsr':U    ,
     1863             input   '##,##':U,
     1864             input   ""    ,
     1865             input   xTog-obj) .
     1866        End.
     1867       when 'т':U THEN DO:
     1868         run ob-line (
     1869             input   x-store-code   ,
     1870             input   x-store-type   ,
     1871             INPUT   gds-zap-artic       ,
     1872             INPUT   gds-zap-prod-code   ,
     1873             INPUT   gds-zap-prod-type   ,
     1874             INPUT   Fact-order-1,
     1875             INPUT   Fact-order-2,
     1876             input   'crsa':U    ,
     1877             input   '##,##':U,
     1878             input   ""    ,
     1879             input   xTog-obj) .
     1880         End.
     1881             End case.
     1882        run calc-sub-itog (3).
     1883        End.
     1884     If xshowsale  Then DO:
     1885       case  gds-zap-type :
     1886       when 'у':U THEN DO:
     1887         run ob-line (
     1888             input   x-store-code   ,
     1889             input   x-store-type   ,
     1890             INPUT   gds-zap-artic       ,
     1891             INPUT   gds-zap-prod-code   ,
     1892             INPUT   gds-zap-prod-type   ,
     1893             INPUT   Fact-order-1,
     1894             INPUT   Fact-order-2,
     1895             input   'sasr':U    ,
     1896             input   '##,##':U,
     1897             input   ""    ,
     1898             input   xTog-obj) .
     1899        End.
     1900       when 'т':U THEN DO:
     1901         run ob-line (
     1902             input   x-store-code   ,
     1903             input   x-store-type   ,
     1904             INPUT   gds-zap-artic       ,
     1905             INPUT   gds-zap-prod-code   ,
     1906             INPUT   gds-zap-prod-type   ,
     1907             INPUT   Fact-order-1,
     1908             INPUT   Fact-order-2,
     1909             input   'sale':U    ,
     1910             input   '##,##':U,
     1911             input   ""    ,
     1912             input   xTog-obj) .
     1913         End.
     1914             End case.
     1915        run calc-sub-itog (6).
     1916        End.
     1917   END PROCEDURE.
     1918   PROCEDURE display-line :
     1919        i = i + 1.
     1920           if NOT( NOT Show-Negativ-2 and
     1921            ( prih         [1]   = 0 AND
     1922             rash          [1]   = 0 AND
     1923             kassa         [1]   = 0 AND
     1924             Inv           [1]   = 0 AND
     1925             Overturn      [1]   = 0 AND
     1926             Overturn      [5]   = 0 AND
     1927             Overturn      [8]   = 0 ) ) then DO:
     1928           IF  NOT (NOT Show-Negativ  AND (
     1929                 prih          [1]   = 0 AND
     1930                 rash          [1]   = 0 AND
     1931                 kassa         [1]   = 0 AND
     1932                 Inv           [1]   = 0 AND
     1933                 Overturn      [1]   = 0 AND
     1934                 Overturn      [5]   = 0 AND
     1935                 ostatok-start [1]   = 0 AND
     1936                 ostatok-End   [1]   = 0   )) then DO:
     1937           IF NOT Sums-Only then DO:
     1938               if fr0 = true then do:
     1939                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     1940                 if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     1941                 fr0 = false .
     1942               end.
     1943               if fr = true then dO:
     1944                 PUT stream OutStream space(10) temp-str format "X(100)" SKIP.
     1945                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) String(temp-str) skip.
     1946                 fr = false .
     1947               end.
     1948              run display-str1 in this-procedure.
     1949             End.
     1950           End.
     1951        END.
     1952     END PROCEDURE.
     1953   PROCEDURE print-header :
     1954   if NOT FirstLine Then DO:
     1955      run display-title.
     1956      FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1957   End.
     1958    FirstLine = TRUE .
     1959       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1960             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name)  AT 30 format "X(170)" SKIP.
     1961             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name) format "X(170)" SKIP.
     1962         End.
     1963         run clear-b1 .
     1964         run clear-b2.
     1965         run clear-bi .
     1966         break_group = true.
     1967         break_group1 = true.
     1968      END PROCEDURE.
     1969   PROCEDURE Print-Footer :
     1970         If RetClassify = "no-classify":U  then run u-line.
     1971          gds-zap-artic = "ИТОГО" .
     1972          run display-bi.
     1973          run u-line.
     1974          END PROCEDURE.
     1975   PROCEDURE U-LINE :
     1976   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1977           s-bar-code
     1978           gds-zap-artic
     1979           gds-zap-gds-name
     1980           gds-zap-unit-base
     1981           gds-type
     1982           F-ostatok-start
     1983           F-Prih
     1984           F-Rash
     1985           F-KAssa
     1986           F-Inv
     1987           F-Overturn
     1988           F-ostatok-end
     1989           gds-zap-other
     1990           with FRAME ZAPAS .
     1991           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1992           END PROCEDURE.
     1993   PROCEDURE P-LINE :
     1994   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1995           gds-zap-artic
     1996           gds-zap-gds-name
     1997           gds-zap-unit-base
     1998           gds-type
     1999           F-ostatok-start
     2000           F-Prih
     2001           F-Rash
     2002           F-KAssa
     2003           F-Inv
     2004           F-Overturn
     2005           F-ostatok-end
     2006           gds-zap-other
     2007           with FRAME ZAPAS .
     2008           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2009           END PROCEDURE.
     2010   procedure run4 :
     2011     run run4sort2 .
     2012     end procedure .
     2013   procedure run4sort2 :
     2014         case select-good :
     2015            when 1  then do:
     2016   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2017   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2018       for each gds-obj  where
     2019             gds-obj.obj-type = x-store-type  and
     2020             gds-obj.obj-code = x-store-code
     2021             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2022         no-lock,
     2023   First clients  where  clients.obj-code = gds-obj.prod-code and
     2024                         clients.obj-type = gds-obj.prod-type
     2025                   no-lock,
     2026             First goods  where  gds-obj.gds-code   = goods.gds-code
     2027   no-lock
     2028   BREAK BY ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     2029         BY (gds-obj.grp-name)
     2030       BY (goods.artic) :
     2031         run item-goods ( "4" , "goods" ) .
     2032         if return-value <> "" then NEXT.
     2033           If Last-of(gds-obj.grp-name) Then Do:
     2034           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2035             Then  Assign
     2036                     S-bar-code   = " Итого по "
     2037                     Gds-zap-artic = Substring(
     2038                                          B2-name
     2039                                         ,1,16)
     2040                     Gds-zap-gds-name = Substring(
     2041                                          B2-name
     2042                                         ,17,40)
     2043                                   .
     2044             Else  Assign
     2045                     S-bar-code   = ""
     2046                     Gds-zap-artic = "        Итого по "
     2047                     Gds-zap-gds-name =   B2-name
     2048                                   .
     2049               Run Display-b1 In This-procedure .
     2050               Run Clear-b1 In This-procedure .
     2051               Assign Break_Group = True.
     2052           End.
     2053           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2054           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2055             Then  Assign
     2056                 S-bar-code   = "Итого по "
     2057                 Gds-zap-artic = Substring(
     2058                                      B1-name
     2059                                     ,1,16)
     2060                 Gds-zap-gds-name = Substring(
     2061                                      B1-name
     2062                                     ,17,40)
     2063                               .
     2064             Else Assign
     2065                 S-bar-code = ""
     2066                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2067                                                                    Else "  Итого по "
     2068                 Gds-zap-gds-name =   B1-name
     2069                 .
     2070             Run Display-b2 In This-procedure .
     2071             Run Clear-b2 In This-procedure .
     2072             Run Clear-b1 In This-procedure .
     2073             Assign  Break_Group1 = True.
     2074           End.
     2075       End.
     2076     END.
     2077     Else DO:
     2078      For each obj-list no-lock :
     2079                     FOR EACH gds-obj where
     2080                   gds-obj.obj-type = obj-list.obj-type    and
     2081                   gds-obj.obj-code = obj-list.obj-code
     2082                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2083                   no-lock :
     2084                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2085                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2086                       Create temp-gds-list.
     2087                       Assign
     2088                         temp-gds-list.prod-code = gds-obj.prod-code
     2089                         temp-gds-list.grp-name  = gds-obj.grp-name
     2090                         temp-gds-list.gds-name  = goods.gds-name
     2091                         temp-gds-list.gds-code  = gds-obj.gds-code
     2092                         temp-gds-list.artic     = gds-obj.artic
     2093                       .
     2094                   End.
     2095               End.
     2096     End.
     2097     for each temp-gds-list no-lock
     2098       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2099                                        , First clients   where  clients.obj-code = goods.prod-code and
     2100                                                                 clients.obj-type = goods.prod-type
     2101         BREAK
     2102   BY (substring(clients.obj-name,1,10) + string(gds-obj.prod-code))
     2103   BY (gds-obj.grp-name)
     2104       BY goods.artic :
     2105       run item-goods ( "4" , "goods" ) .
     2106         if return-value <> "" then NEXT.
     2107           If Last-of(gds-obj.grp-name) Then Do:
     2108           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2109             Then  Assign
     2110                     S-bar-code   = " Итого по "
     2111                     Gds-zap-artic = Substring(
     2112                                          B2-name
     2113                                         ,1,16)
     2114                     Gds-zap-gds-name = Substring(
     2115                                          B2-name
     2116                                         ,17,40)
     2117                                   .
     2118             Else  Assign
     2119                     S-bar-code   = ""
     2120                     Gds-zap-artic = "        Итого по "
     2121                     Gds-zap-gds-name =   B2-name
     2122                                   .
     2123               Run Display-b1 In This-procedure .
     2124               Run Clear-b1 In This-procedure .
     2125               Assign Break_Group = True.
     2126           End.
     2127           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2128           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2129             Then  Assign
     2130                 S-bar-code   = "Итого по "
     2131                 Gds-zap-artic = Substring(
     2132                                      B1-name
     2133                                     ,1,16)
     2134                 Gds-zap-gds-name = Substring(
     2135                                      B1-name
     2136                                     ,17,40)
     2137                               .
     2138             Else Assign
     2139                 S-bar-code = ""
     2140                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     2141                                                                    Else "  Итого по "
     2142                 Gds-zap-gds-name =   B1-name
     2143                 .
     2144             Run Display-b2 In This-procedure .
     2145             Run Clear-b2 In This-procedure .
     2146             Run Clear-b1 In This-procedure .
     2147             Assign  Break_Group1 = True.
     2148           End.
     2149     End.
     2150   End.
     2151     end.
     2152            when 2  then do:
     2153   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2154     if x-selectobject = "currency":u  or  xtog-obj then do:
     2155         for  each gds-obj
     2156                     where gds-obj.obj-code   = x-store-code
     2157                      and  gds-obj.obj-type   = x-store-type
     2158                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2159                           no-lock ,
     2160                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2161                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     2162                     break
     2163                     by (substring(clients.obj-name,1,10) + string(gds-obj.prod-code))
     2164                     by gds-obj.grp-name
     2165                     by goods.artic :
     2166                     run item-goods ( input "4" , input "goods" ) .
     2167                     if return-value <> "" then next.
     2168           If Last-of(gds-obj.grp-name) Then Do:
     2169           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2170             Then  Assign
     2171                     S-bar-code   = " Итого по "
     2172                     Gds-zap-artic = Substring(
     2173                                          B2-name
     2174                                         ,1,16)
     2175                     Gds-zap-gds-name = Substring(
     2176                                          B2-name
     2177                                         ,17,40)
     2178                                   .
     2179             Else  Assign
     2180                     S-bar-code   = ""
     2181                     Gds-zap-artic = "        Итого по "
     2182                     Gds-zap-gds-name =   B2-name
     2183                                   .
     2184               Run Display-b1 In This-procedure .
