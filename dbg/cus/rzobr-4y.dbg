     3692     excel-sum(bo-Inv          [9])  CHR(9)
     3693     excel-qnty(bo-Overturn     [1])  CHR(9)
     3694     excel-sum(bo-Overturn     [2])  CHR(9)
     3695     excel-sum(bo-Overturn     [5])  CHR(9)
     3696     excel-sum(bo-Overturn     [8])  CHR(9)
