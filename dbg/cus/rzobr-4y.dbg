     3739     excel-qnty(Prih         [1])  CHR(9)
     3740     excel-sum(Prih         [2])  CHR(9)
     3741     excel-sum(Prih         [5])  CHR(9)
     3742     excel-sum(Prih         [8])  CHR(9)
     3743     excel-sum(Prih         [3])  CHR(9)
     3744     excel-sum(Prih         [6])  CHR(9)
     3745     excel-sum(Prih         [9])  CHR(9)
     3746     excel-qnty(RAsh         [1])  CHR(9)
