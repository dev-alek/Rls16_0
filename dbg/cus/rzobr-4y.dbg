     2571   PROCEDURE CalcItog :
     2572       run ostatok (
     2573           input x-store-code  ,
     2574           input x-store-type  ,x-TOG-Shift,
     2575           input x-date-start - 1 ,
     2576           input date('')      , x-Shift-Start,x-Shift-End,
     2577           input 'crsa':U   ,
     2578           input '##,##':U,
     2579           input xTog-obj ,
     2580           output  Quantity1  ,
     2581           output  Coast_R1   ,
     2582           output  Coast_V1   ,
     2583           output  VAT_R1     ,
     2584           output  VAT_V1     ,
     2585           output  Fact-order-1 ).
     2586       run ostatok (
     2587           input x-store-code  ,
     2588           input x-store-type  , x-TOG-Shift,
     2589           input x-date-start  ,
     2590           input x-date-end    , x-Shift-Start,x-Shift-End,
     2591           input 'crsa':U   ,
     2592           input '##,##':U,
     2593           input xTog-obj ,
     2594           output  Quantity1  ,
     2595           output  Coast_R1   ,
     2596           output  Coast_V1   ,
     2597           output  VAT_R1     ,
     2598           output  VAT_V1     ,
     2599           output  Fact-order-2 ).
     2600             Quantity1  = 0.
     2601             Coast_R1   = 0.
     2602             Coast_V1   = 0.
     2603             VAT_R1     = 0.
     2604             VAT_V1     = 0.
     2605   END PROCEDURE.
     2606   PROCEDURE display-str1  :
     2607              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2608            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2609            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2610            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2611            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2612            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2613            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2614   end procedure.
