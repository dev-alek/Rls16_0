     3758     excel-sum(KAssa        [6])  CHR(9)
     3759     excel-sum(KAssa        [9])  CHR(9)
     3760     excel-qnty(Inv          [1])  CHR(9)
     3761     excel-sum(Inv          [2])  CHR(9)
     3762     excel-sum(Inv          [5])  CHR(9)
     3763     excel-sum(Inv          [8])  CHR(9)
     3764     excel-sum(Inv          [3])  CHR(9)
     3765     excel-sum(Inv          [6])  CHR(9)
     3766     excel-sum(Inv          [9])  CHR(9)
     3767     excel-qnty(Overturn     [1])  CHR(9)
     3768     excel-sum(Overturn     [2])  CHR(9)
     3769     excel-sum(Overturn     [5])  CHR(9)
     3770     excel-sum(Overturn     [8])  CHR(9)
     3771     excel-sum(Overturn     [3])  CHR(9)
     3772     excel-sum(Overturn     [6])  CHR(9)
     3773     excel-sum(Overturn     [9])  CHR(9)
     3774     excel-qnty(Ostatok-end  [1])  CHR(9)
