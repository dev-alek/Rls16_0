     2633   PROCEDURE display-B1  :
     2634         if NOT( NOT Show-Negativ-2 and
     2635            ( b1-prih         [1]   = 0 AND
     2636              b1-rash          [1]   = 0 AND
     2637              b1-kassa         [1]   = 0 AND
     2638              b1-Inv           [1]   = 0 AND
     2639              b1-Overturn      [1]   = 0 AND
     2640              b1-Overturn      [5]   = 0 AND
     2641              b1-Overturn      [8]   = 0 ) ) then DO:
     2642           IF  NOT (NOT Show-Negativ  AND (
     2643                 b1-prih          [1]   = 0 AND
     2644                 b1-rash          [1]   = 0 AND
     2645                 b1-kassa         [1]   = 0 AND
     2646                 b1-Inv           [1]   = 0 AND
     2647                 b1-Overturn      [1]   = 0 AND
     2648                 b1-Overturn      [5]   = 0 AND
     2649                 b1-ostatok-start [1]   = 0 AND
     2650                 b1-ostatok-End   [1]   = 0   )) then DO:
     2651                 if Sums-Only THEN do:
     2652                     if fr0 = true then do:
     2653                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2654                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2655                         fr0 = false .
     2656                       end.
     2657                  end.
     2658           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2659           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2660           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2661           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2662           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2663           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2664           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2665          if not sums-only then run p-line.
     2666    End.
     2667    end.
     2668   END PROCEDURE.
     2669   PROCEDURE display-B2  :
     2670        if NOT( NOT Show-Negativ-2 and
     2671            ( b2-prih         [1]   = 0 AND
     2672              b2-rash          [1]   = 0 AND
     2673              b2-kassa         [1]   = 0 AND
     2674              b2-Inv           [1]   = 0 AND
     2675              b2-Overturn      [1]   = 0 AND
     2676              b2-Overturn      [5]   = 0 AND
     2677              b2-Overturn      [8]   = 0 ) ) then DO:
     2678           IF  NOT (NOT Show-Negativ  AND (
     2679                 b2-prih          [1]   = 0 AND
     2680                 b2-rash          [1]   = 0 AND
     2681                 b2-kassa         [1]   = 0 AND
     2682                 b2-Inv           [1]   = 0 AND
     2683                 b2-Overturn      [1]   = 0 AND
     2684                 b2-Overturn      [5]   = 0 AND
     2685                 b2-ostatok-start [1]   = 0 AND
     2686                 b2-ostatok-End   [1]   = 0   )) then DO:
     2687           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2688           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2689           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2690           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2691            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2692            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2693            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2694    End.
     2695   end.
     2696   END PROCEDURE.
     2697   PROCEDURE Clear-B1  :
     2698    b1-gds-zap-other           = 0.
     2699    REPEAT kk = 1 to 9 :
     2700    Assign
     2701       b1-Prih                                            [kk]    = 0
     2702       b1-Rash                                            [kk]    = 0
     2703       b1-KAssa                                           [kk]    = 0
     2704       b1-Inv                                             [kk]    = 0
     2705       b1-Overturn                                        [kk]    = 0
     2706       b1-ostatok-end                                     [kk]    = 0
     2707       b1-ostatok-start                                   [kk]    = 0   .
     2708      End.
     2709    END PROCEDURE.
     2710   PROCEDURE Clear-B2  :
     2711    b2-gds-zap-other           = 0.
     2712    REPEAT kk = 1 to 9 :
     2713    Assign
     2714       b2-Prih                                            [kk]    = 0
     2715       b2-Rash                                            [kk]    = 0
     2716       b2-KAssa                                           [kk]    = 0
     2717       b2-Inv                                             [kk]    = 0
     2718       b2-Overturn                                        [kk]    = 0
     2719       b2-ostatok-end                                     [kk]    = 0
     2720       b2-ostatok-start                                   [kk]    = 0   .
     2721      End.
     2722   END PROCEDURE.
     2723   PROCEDURE Clear-Bi  :
     2724    bi-gds-zap-other           = 0.
     2725    REPEAT kk = 1 to 9 :
     2726    Assign
     2727       bi-Prih                                            [kk]    = 0
     2728       bi-Rash                                            [kk]    = 0
     2729       bi-KAssa                                           [kk]    = 0
     2730       bi-Inv                                             [kk]    = 0
     2731       bi-Overturn                                        [kk]    = 0
     2732       bi-ostatok-end                                     [kk]    = 0
     2733       bi-ostatok-start                                   [kk]    = 0   .
     2734      End.
     2735   END PROCEDURE.
     2736   PROCEDURE Display-title :
     2737   define variable v-nn as integer   no-undo .
     2738      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2739             REPORTNAME  AT 20 format "X(170)" SKIP
     2740             Trim(str1)  AT 35 format "X(75)" SKIP.
     2741        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2742        Repeat i = 1 to v-nn:
     2743         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2744        End.
     2745       i=0.
     2746          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2747        v-nn = NUM-ENTRIES(str4,chr(10)).
     2748        Repeat i = 1 to v-nn :
     2749         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2750        End.
     2751       i=0.
     2752        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2753        Repeat i = 1 to v-nn :
     2754         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2755        End.
     2756       i=0.
     2757       run rep/extitle.p (1) .
     2758   END PROCEDURE.
     2759   PROCEDURE ob-line  :
     2760   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2761   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2762   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2763   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2764   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2765   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2766   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2767   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2768   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2769   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2770   define input  parameter xTog-obj           as log no-undo.
     2771   define variable  tt#          as   int                 no-undo.
     2772    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2773    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2774    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2775        FOR each ub.ot-line where
     2776                           ub.ot-line.artic         = x-artic
     2777                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2778                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2779                     AND   ub.ot-line.obj-code     = x-store-code
     2780                     AND   ub.ot-line.obj-type     = x-store-type
     2781                     AND   ub.ot-line.prod-code    = x-prod-code
     2782                     AND   ub.ot-line.prod-type    = x-prod-type
     2783                     AND   ub.ot-line.sum-type     = x-sum-type
     2784                       no-lock :
     2785       CASE ub.ot-line.ext-doc-type:
     2786                 WHEN        'ie':U  OR
     2787                 WHEN        're':U  OR
     2788                 WHEN        'iv':U    OR
     2789                 WHEN        'rv':U OR
     2790                 WHEN        'im':U     THEN
     2791                 DO:
     2792                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2793                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2794                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2795                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2796                 End.
     2797                 WHEN       'ee':U      OR
     2798                 WHEN       'ep':U    OR
     2799                 WHEN       'ev':U     OR
     2800                 WHEN       'em':U       OR
     2801                 WHEN       'wm':U       OR
     2802                 WHEN       'we':U     THEN
     2803                 DO:
     2804                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2805                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2806                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2807                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2808                 End.
     2809                 WHEN       'es':U  OR
     2810                 WHEN       'rs':U THEN
     2811                 DO:
     2812                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2813                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2814                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2815                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2816                 End.
     2817             WHEN  'vt':U or when 'vp':U     THEN
     2818                 DO:
     2819                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2820                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2821                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2822                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2823                 End.
     2824             WHEN       'ot':U THEN
     2825                 DO:
     2826                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2827                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2828                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2829                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2830                 End.
     2831         End CASE.
     2832     END.
     2833     if tt# = 6 then DO:
     2834              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2835                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2836                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2837     End.
     2838   END PROCEDURE.
     2839   procedure ost-line :
     2840     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2841     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2842     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2843     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2844     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2845     define input  parameter x-tog-shift  as logical no-undo .
     2846     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2847     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2848     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2849     define input  parameter xtog-obj     as logical no-undo .
     2850     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2851     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2852     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2853     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2854     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2855     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2856     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2857     define buffer buff-obj-list  for obj-list .
     2858     define buffer buff-stk-line  for ub.stk-line .
     2859     assign
     2860       Quantity = 0
     2861       Coast_R  = 0
     2862       Coast_V  = 0
     2863       VAT_R    = 0
     2864       VAT_V    = 0
     2865       SLT_R    = 0
     2866       SLT_V    = 0
     2867     .
     2868     if  x-tog-shift = false then do:
     2869       for each buff-obj-list no-lock
     2870         where xtog-obj = false
     2871            or (buff-obj-list.obj-type = x-store-type
     2872               and buff-obj-list.obj-code = x-store-code
     2873               )
     2874       on error undo, return error
     2875       :
     2876       find last buff-stk-line no-lock
     2877         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2878           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2879           and buff-stk-line.artic      = x-artic
     2880           and buff-stk-line.prod-type  = x-prod-type
     2881           and buff-stk-line.prod-code  = x-prod-code
     2882           and buff-stk-line.sum-type   = x-sum-type
     2883           and buff-stk-line.cat-id     = '##,##':U
     2884           and buff-stk-line.fact-order <= x-fact-order
     2885           and buff-stk-line.shift-num  = 0
     2886         use-index category
     2887         no-error .
     2888       if available buff-stk-line then do:
     2889         assign
     2890           Quantity = Quantity + buff-stk-line.fact-qnty
     2891           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2892           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2893           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2894           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2895           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2896           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2897         .
     2898       end.
     2899      end.
     2900     end.
     2901     else do:
     2902       for each buff-obj-list no-lock
     2903         where xtog-obj = false
     2904            or (buff-obj-list.obj-type = x-store-type
     2905               and buff-obj-list.obj-code = x-store-code
     2906               )
     2907       on error undo, return error
     2908       :
     2909         find last buff-stk-line no-lock
     2910           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2911             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2912             and buff-stk-line.artic      = x-artic
     2913             and buff-stk-line.prod-type  = x-prod-type
     2914             and buff-stk-line.prod-code  = x-prod-code
     2915             and buff-stk-line.sum-type   = x-sum-type
     2916             and buff-stk-line.cat-id     = '##,##':U
     2917             and buff-stk-line.fact-order <= x-fact-order
     2918             and buff-stk-line.shift-num  > 0
     2919           use-index category
     2920           no-error .
     2921         if available buff-stk-line then do:
     2922           assign
     2923             Quantity = Quantity +  buff-stk-line.fact-qnty
     2924             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2925             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2926             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2927             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2928             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2929             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2930           .
     2931         end.
     2932       end.
     2933     end.
     2934   end procedure.
     2935   procedure ost-lineother-tax :
     2936     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2937     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2938     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2939     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2940     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2941     define input  parameter x-tog-shift  as logical no-undo .
     2942     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2943     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2944     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2945     define input  parameter xTog-obj     as logical no-undo .
     2946     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2947     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2948     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2949     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2950     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2951     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2952     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2953     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2954     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2955     define buffer buff-obj-list  for obj-list .
     2956     define buffer buff-stk-line  for ub.stk-line .
     2957     assign
     2958       Quantity = 0
     2959       Coast_R  = 0
     2960       Coast_V  = 0
     2961       VAT_R    = 0
     2962       VAT_V    = 0
     2963       SLT_R    = 0
     2964       SLT_V    = 0
     2965       other_R  = 0
     2966       other_V  = 0
     2967     .
     2968     if  x-tog-shift = false then do:
     2969       for each buff-obj-list no-lock
     2970         where xtog-obj = false
     2971            or (buff-obj-list.obj-type = x-store-type
     2972               and buff-obj-list.obj-code = x-store-code
     2973               )
     2974       on error undo, return error
     2975       :
     2976       find last buff-stk-line no-lock
     2977         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2978           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2979           and buff-stk-line.artic      = x-artic
     2980           and buff-stk-line.prod-type  = x-prod-type
     2981           and buff-stk-line.prod-code  = x-prod-code
     2982           and buff-stk-line.sum-type   = x-sum-type
     2983           and buff-stk-line.cat-id     = '##,##':U
     2984           and buff-stk-line.fact-order <= x-fact-order
     2985           and buff-stk-line.shift-num  = 0
     2986         use-index category
     2987         no-error .
     2988       if available buff-stk-line then do:
     2989         assign
     2990           Quantity = Quantity + buff-stk-line.fact-qnty
     2991           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2992           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2993           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2994           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2995           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2996           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2997           other_R  = other_R  + buff-stk-line.other-rubl
     2998           other_V  = other_V  + buff-stk-line.other-base
     2999         .
     3000       end.
     3001    end.
     3002     end.
     3003     else do:
     3004       for each buff-obj-list no-lock
     3005         where xtog-obj = false
     3006            or (buff-obj-list.obj-type = x-store-type
     3007               and buff-obj-list.obj-code = x-store-code
     3008               )
     3009       on error undo, return error
     3010       :
     3011         find last buff-stk-line no-lock
     3012           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3013             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3014             and buff-stk-line.artic      = x-artic
     3015             and buff-stk-line.prod-type  = x-prod-type
     3016             and buff-stk-line.prod-code  = x-prod-code
     3017             and buff-stk-line.sum-type   = x-sum-type
     3018             and buff-stk-line.cat-id     = '##,##':U
     3019             and buff-stk-line.fact-order <= x-fact-order
     3020             and buff-stk-line.shift-num  > 0
     3021           use-index category
     3022           no-error .
     3023         if available buff-stk-line then do:
     3024           assign
     3025             Quantity = Quantity +  buff-stk-line.fact-qnty
     3026             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3027             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3028             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3029             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3030             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3031             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3032             other_R = other_R   +  buff-stk-line.other-rubl
     3033             other_V = other_V   +  buff-stk-line.other-base
     3034           .
     3035         end.
     3036       end.
     3037     end.
     3038   end procedure.
     3039   procedure ost-line-kg :
     3040     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3041     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3042     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3043     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3044     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3045     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3046     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3047     define buffer buff-obj-list  for obj-list .
     3048     define buffer buf_doc-line for ub.doc-line .
     3049     define buffer buf_inv-line for ub.inv-line .
     3050     do
     3051     on error undo, return error
     3052     :
     3053       for each buf_doc-line no-lock where
     3054                buf_doc-line.obj-type    = p-obj-type   and
     3055                buf_doc-line.obj-code    = p-obj-code   and
     3056                buf_doc-line.prod-type   = p-prod-type  and
     3057                buf_doc-line.prod-code   = p-prod-code  and
     3058                buf_doc-line.artic       = p-artic      and
     3059                buf_doc-line.status_     = 'факт':U      and
     3060                buf_doc-line.fact-order <= p-fact-order
     3061             by buf_doc-line.fact-order    descending
     3062       :
     3063         find first buf_inv-line no-lock where
     3064                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3065                    buf_inv-line.artic     = buf_doc-line.artic     and
     3066                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3067                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3068         if available buf_inv-line
     3069         then do:
     3070           if buf_inv-line.after-cli-qnty <> ?
     3071           then do:
     3072             assign
     3073               p-quantity-kg = buf_inv-line.after-cli-qnty
     3074             .
     3075             leave .
     3076           end.
     3077         end.
     3078       end.
     3079       if p-quantity-kg = ?
     3080       then do:
     3081         assign
     3082           p-quantity-kg = 0
     3083         .
     3084       end.
     3085     end.
     3086   end procedure.
     3087   PROCEDURE ostatok :
     3088   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3089   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3090   def input parameter x-tog-shift   as   logical             no-undo.
     3091   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3092   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3093   def input parameter x-shift-start as integer               no-undo.
     3094   def input parameter x-shift-end   as integer               no-undo.
     3095   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3096   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3097   def input parameter xTog-obj   as log no-undo.
     3098   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3099   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3100   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3101   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3102   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3103   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3104   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3105   def var              Fact-orderS   as char  no-undo.
     3106   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3107      Assign
     3108         Fact-order   = 0
     3109         Quantity     = 0
     3110         Coast_R      = 0
     3111         Coast_V      = 0
     3112         VAT_R        = 0
     3113         VAT_V        = 0 .
     3114    x-date-start-t  = x-date-start + 1 .
     3115   IF x-date-end = date('') then DO:
     3116      Fact-order = 0 .
     3117      for each obj-list
     3118          where  ( not xtog-obj or
     3119                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3120                 no-lock :
     3121         if  x-tog-shift = false then do:
     3122                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3123                               ub.stk-tot.Fact-date <=  x-date-start
     3124                               and ub.stk-tot.shift-num = 0
     3125                               USE-INDEX fact-date no-lock no-error .
     3126              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3127         End.
     3128         Else  DO :
     3129             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3130              (ub.stk-tot.shift-date  = x-date-start-t and
     3131               ub.stk-tot.shift-num  < x-shift-start or
     3132               ub.stk-tot.shift-date  < x-date-start-t  )
     3133               and ub.stk-tot.shift-num  > 0
     3134               USE-INDEX Shift-num no-lock no-error .
     3135            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3136           END.
     3137       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3138     End.
     3139   End.
     3140   Else DO:
     3141     For each obj-list  WHERE
     3142        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3143         no-lock :
     3144      IF  x-TOG-Shift = False Then DO:
     3145          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3146               ub.stk-tot.Fact-date <= x-date-end
     3147               and ub.stk-tot.shift-num = 0
     3148               USE-INDEX fact-date no-lock no-error.
     3149          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3150      END.
     3151      Else DO:
     3152           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3153               (ub.stk-tot.shift-date  = x-date-end and
     3154               ub.stk-tot.shift-num  <= x-shift-end or
     3155               ub.stk-tot.shift-date  < x-date-end       ) and
     3156               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3157               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3158       End.
     3159       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3160     End.
     3161   End.
     3162   END PROCEDURE.
     3163   PROCEDURE report-exec1  :
     3164      FIND FIRST clients where x-store-type = clients.obj-type AND
     3165                               x-store-code = clients.obj-code no-lock no-error.
     3166     run waitfram-show(clients.obj-name) .
     3167     run calcitog.
     3168     run print-header.
     3169      case retclassify :
     3170        when "prod/grp-goods":u then run run4.
     3171        otherwise do:
     3172          message "Ошибка вызова!"  view-as alert-box error .
     3173        end.
     3174      end case.
     3175     run print-footer.
     3176     END PROCEDURE.
     3177   PROCEDURE Calc-Sub-itog :
     3178   define input parameter tt as int no-undo.
     3179   define variable b as int no-undo.
     3180   if tt = 6  then Assign
     3181     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     3182     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     3183     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     3184     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     3185     .
     3186   repeat b = 1 to 3:
     3187     Assign
     3188     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     3189     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     3190     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     3191     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     3192     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     3193     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     3194     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     3195     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     3196     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     3197     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     3198     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     3199     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     3200     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     3201     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     3202     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     3203     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     3204     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     3205     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     3206     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     3207     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     3208     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     3209     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     3210   End.
     3211   END PROCEDURE.
     3212   PROCEDURE Clear-item :
     3213   define variable kk as int no-undo.
     3214    gds-zap-other = 0 .
     3215    REPEAT kk = 1 to 9 :
     3216    Assign
     3217       prih            [kk]    = 0
     3218       rash            [kk]    = 0
     3219       kassa           [kk]    = 0
     3220       Inv             [kk]    = 0
     3221       Overturn        [kk]    = 0
     3222       ostatok-end     [kk]    = 0
     3223       ostatok-start   [kk]    = 0 .
     3224          End.
     3225    END PROCEDURE.
     3226   PROCEDURE Item-Goods :
     3227      define input parameter  par-3 as char no-undo.
     3228      define input parameter  par-4 as char no-undo.
     3229        if par-4 = "goods":U  Then DO:
     3230           assign
     3231               gds-zap-unit-base  = Goods.unit-base
     3232               gds-zap-prt-root   = Goods.prt-root
     3233               gds-zap-prod-type  = Goods.prod-type
     3234               gds-zap-prod-code  = Goods.prod-code
     3235               gds-zap-artic      = Goods.artic
     3236               gds-zap-grp-name   = Goods.grp-name
     3237               gds-zap-b-code     = Goods.gds-code
     3238               gds-zap-type       = Goods.gds-type.
     3239           if g#gds-engl then
     3240               assign gds-zap-gds-name = Goods.engl-name.
     3241           else
     3242               assign gds-zap-gds-name = Goods.gds-name.
     3243        End.
     3244        if par-4 = "gds-list":U  Then DO:
     3245           assign
     3246               gds-zap-unit-base  = gds-list.unit-base
     3247               gds-zap-prt-root   = gds-list.prt-root
     3248               gds-zap-prod-type  = gds-list.prod-type
     3249               gds-zap-prod-code  = gds-list.prod-code
     3250               gds-zap-artic      = gds-list.artic
     3251               gds-zap-grp-name   = gds-list.grp-name
     3252               gds-zap-b-code     = gds-list.gds-code
     3253               gds-zap-type       = gds-list.gds-type.
     3254           if g#gds-engl then
     3255               assign gds-zap-gds-name = gds-list.engl-name.
     3256           else
     3257               assign gds-zap-gds-name = gds-list.gds-name.
     3258        End.
     3259       run foreach.
     3260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3261     (input  gds-zap-b-code
     3262     ,input  ?
     3263     ,output v-bar-code
     3264     )  .
     3265   s-bar-code = string (v-bar-code,"999999999").
     3266       If  break_group = true  and par-3 <> "1"  then DO :
     3267            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3268            gds-zap-prod-name  = clients.obj-name.
     3269             If break_group1 = true  THEN  DO :
     3270               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3271                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3272                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3273               if par-3 = "6"  then  dO:
     3274                  if xTog-obj = true then do:
     3275                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3276                     .
     3277                   end.
     3278                  else do:
     3279                   var-vat-pc = temp-gds-list.vat-pc .
     3280                   end.
     3281                   assign
     3282                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3283                       b1-name = temp-str.
     3284                   end.
     3285               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3286                   fr0 = true .
     3287                   tmp#stroka0 = temp-str.
     3288               End.
     3289             End.
     3290               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3291                 if par-3 = "4"
     3292                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3293                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3294                 if NOT xSumsOnly THEN DO:
     3295                     fr = true .
     3296                 End.
     3297                 break_group1 = false.
     3298               END.
     3299          break_group = false.
     3300       End.
     3301       run display-line.
     3302    END PROCEDURE.
     3303   PROCEDURE Di :
     3304   define input parameter p1 as char no-undo.
     3305   define input parameter p2 as int no-undo.
     3306   define input parameter p3 as char no-undo.
     3307   define input parameter p4 as char no-undo.
     3308   define input parameter p5 as char no-undo.
     3309   define input parameter p6 as char no-undo.
     3310   define input parameter p7 as char no-undo.
     3311    CASE CAPS(p7) :
     3312      WHEN "B1":U  Then DO:
     3313       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3314         p3 @ s-bar-code
     3315         p4 @ gds-zap-artic
     3316         p5 @ gds-zap-gds-name
     3317         p6 @ gds-zap-unit-base
     3318         p1 @ gds-type
     3319         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3320         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3321         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3322         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3323         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3324         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3325         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3326         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3327         with FRAME ZAPAS .
     3328                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3329                   End.
     3330      WHEN "B2":U  Then  DO:
     3331       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3332         p3 @ s-bar-code
     3333         p4 @ gds-zap-artic
     3334         p5 @ gds-zap-gds-name
     3335         p6 @ gds-zap-unit-base
     3336         p1 @ gds-type
     3337         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3338         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3339         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3340         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3341         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3342         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3343         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3344         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3345         with FRAME ZAPAS .
     3346                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3347                 End.
     3348      WHEN "BI":U Then  DO:
     3349       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3350         p3 @ s-bar-code
     3351         p4 @ gds-zap-artic
     3352         p5 @ gds-zap-gds-name
     3353         p6 @ gds-zap-unit-base
     3354         p1 @ gds-type
     3355         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3356         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3357         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
