      995               create buf_temp-diasize-handle .
      996               assign
      997                 buf_temp-diasize-handle.handle-value  = v-object-handle
      998                 buf_temp-diasize-handle.save-position = v-object-handle :col
      999               .
     1000             end.
     1001           end.
     1002           assign
     1003             v-object-handle = v-object-handle :next-sibling
     1004           .
     1005         end.
