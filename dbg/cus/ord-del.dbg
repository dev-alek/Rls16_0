      592         :
      593           if  v-object-handle <> v-diasize-browse-handle :handle
      594           and can-query(v-object-handle, "row")
      595           and can-query(v-object-handle, "height")
      596           and ( v-object-handle :row > v-diasize-browse-handle :row )
      597           then do:
      598             find first buf_temp-browse-handle
      599               where buf_temp-browse-handle.browse-type   = 'height':u
      600                 and buf_temp-browse-handle.browse-handle = v-object-handle
      601               no-error .
      602             if available buf_temp-browse-handle
      603             then do:
      604             end.
      605             else do:
      606               create buf_temp-diasize-handle .
      607               assign
      608                 buf_temp-diasize-handle.handle-value  = v-object-handle
      609                 buf_temp-diasize-handle.save-position = v-object-handle :row
      610               .
      611             end.
      612           end.
      613           assign
      614             v-object-handle = v-object-handle :next-sibling
      615           .
      616         end.
      617         assign
      618           v-field-group-handle = v-field-group-handle :next-sibling
      619         .
      620       end.
      621       do with frame Dialog-Frame
      622       :
      623         hide v-diasize-resize-button .
      624         assign
      625           v-diasize-resize-button :row    = 1
      626           v-diasize-resize-button :column = 1
      627         .
      628       end.
      629       if p-change-value > 0
      630       then do:
      631         if frame Dialog-Frame :scrollable = true
      632         then do:
      633           assign
      634             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      635             no-error .
      636           if error-status :error
      637           or error-status :get-message(1) <> ""
      638           then do:
      639             undo move_block, retry move_block .
      640           end.
      641         end.
      642         assign
      643           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      644           no-error .
      645         if error-status :error
      646         or error-status :get-message(1) <> ""
      647         then do:
      648           undo move_block, retry move_block .
      649         end.
      650         assign
      651           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      652           no-error .
