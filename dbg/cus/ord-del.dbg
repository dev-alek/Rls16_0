     1013         v-diasize-resize-button :row = 1.
     1014         v-diasize-resize-button :column = 1.
     1015       end.
     1016       if p-change-value > 0
     1017       then do:
     1018         if frame Dialog-Frame :scrollable = true
     1019         then do:
     1020           assign
     1021             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1022             no-error .
