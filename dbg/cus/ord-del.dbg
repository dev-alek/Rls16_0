      766             (input  v-cntxt-db-num
      767             ,input  v-cntxt-userid
      768             ,input  v-diasize-proc-name
      769             ,input  'height':u
      770             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      771             ) .
      772         end.
      773       end.
      774     end.
      775     assign
      776       v-diasize-change-size = false
      777     .
      778   end procedure.
      779   procedure diasize_set-height :
      780     define input  parameter p-new-height  as decimal   no-undo .
      781     define input  parameter p-move-resize as logical   no-undo .
      782     do
      783     on error undo, return error return-value
      784     :
      785       run diasize_change-height in this-procedure
      786         (input  (p-new-height - frame Dialog-Frame :height)
      787         ,input  p-move-resize
      788         ) .
      789     end.
      790   end procedure.
      791   procedure diasize_change-width :
      792     define input  parameter p-change-value as decimal   no-undo .
      793     define input  parameter p-move-resize  as logical   no-undo .
      794     define variable v-field-group-handle   as handle    no-undo .
      795     define variable v-object-handle        as handle    no-undo .
      796     define variable v-frame-width          as decimal   no-undo .
      797     define variable v-frame-virtual-width  as decimal   no-undo .
      798     define variable v-browse-width         as decimal   no-undo .
      799     define variable v-window-width         as decimal   no-undo .
      800     define variable v-window-virtual-width as decimal   no-undo .
      801     define variable v-change-sign          as integer   no-undo .
      802     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      803     define buffer buf_temp-browse-handle  for temp-browse-handle .
      804     if p-change-value > 0
      805     then do:
      806       if frame Dialog-Frame :width + p-change-value >
      807           session :width-chars
      808       then do:
      809         assign
      810           p-change-value = session :width-chars - frame Dialog-Frame :width
      811         .
      812         if p-change-value <= 0
      813         then do:
      814           run diasize_position-resize-button in this-procedure .
      815           return .
      816         end.
      817       end.
      818     end.
      819     if p-change-value < 0
      820     then do:
      821       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      822       then do:
      823         assign
      824           p-change-value = v-diasize-orig-frame-width
      825                          - frame Dialog-Frame :width
      826         .
      827         if p-change-value >= 0
      828         then do:
      829           run diasize_position-resize-button in this-procedure .
      830           return .
      831         end.
      832       end.
      833     end.
      834     if p-change-value >= 0
      835     then do:
      836       assign
      837         v-change-sign = 1
      838       .
      839     end.
      840     else do:
      841       assign
      842         v-change-sign = -1
      843       .
      844     end.
      845     assign
      846       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      847     .
      848     if p-change-value = 0
      849     then do:
      850       run diasize_position-resize-button in this-procedure .
      851       return .
      852     end.
      853     move_block:
      854     do
      855     on error undo move_block, leave move_block
      856     :
      857       if retry
      858       then do:
      859         do
      860         on error undo move_block, leave move_block
      861         :
      862           if p-change-value > 0
      863           then do:
      864             for each buf_temp-diasize-handle
      865             on error undo, next
      866             :
      867               assign
      868                 v-object-handle = buf_temp-diasize-handle.handle-value
      869               .
      870               if v-object-handle <> v-diasize-resize-button
