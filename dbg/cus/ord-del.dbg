        1   DEFINE TEMP-TABLE tmp-ord NO-UNDO LIKE ub.ord-doc
        2          field mm as log.
        3   define input parameter parParentProc  as widget-handle no-undo.
        4   define input parameter date1 as date no-undo .
        5   define input parameter date2 as date no-undo .
        6   define input parameter g#type as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Удаление неисполненных заказов".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       73   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       74   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       75   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       76   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       77   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       78   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       79   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       80   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       81   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       82   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       83   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       84   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       85   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       86   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       87   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       88   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       89   procedure proc-alt-shift-f2:
       90     if not ibs.th.gbl.gbl-var:rcode
       91   then
       92     run gbl\inidebug.p .
       93   end.
       94   procedure proc-alt-shift-f3:
       95     run gbl/prvssinf.p
       96       ( input this-procedure
       97       ) .
       98   end.
       99   define variable v-inform-launched as logical no-undo initial false .
      100   procedure proc-alt-shift-f4:
      101     define variable v-action as character no-undo .
      102     if v-inform-launched = false then do:
      103       assign
      104         v-inform-launched = true
      105       .
      106       run gbl/d-inform.w
      107         (  input self
      108         ,  input this-procedure
      109         , output v-action
      110         ) no-error .
      111       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      112       assign
      113         v-inform-launched = false
      114       .
      115     end.
      116   end.
      117   procedure proc-alt-f1:
      118     run gbl/corrhelp.p
      119       (input this-procedure
      120       ) .
      121   end .
      122   on alt-shift-f2 anywhere do:
      123     run proc-alt-shift-f2.
      124   end.
      125   on alt-shift-f3 anywhere do:
      126     run proc-alt-shift-f3 in this-procedure .
      127   end.
      128   on alt-shift-f4 anywhere do:
      129     run proc-alt-shift-f4 in this-procedure.
      130   end.
      131   on alt-f1 anywhere do:
      132     run proc-alt-f1 in this-procedure .
      133   end.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135     define variable v-cntxt-db-num        as integer   no-undo .
      136     define variable v-cntxt-userid        as character no-undo .
      137     define variable v-cntxt-level         as character no-undo .
      138     define variable v-cntxt-host-code-obj as integer   no-undo .
      139     define variable v-cntxt-obj-type      as character no-undo .
      140     define variable v-cntxt-obj-code      as integer   no-undo .
      141     define variable v-cntxt-db-num-obj    as integer   no-undo .
      142     define variable v-cntxt-is-admin      as logical   no-undo .
      143   define new shared buffer SHAR-BUF_ORD-DOC for ub.ORD-DOC  .
      144   define variable g#log      as logical   no-undo .
      145   define variable br-handle    as handle   no-undo .
      146   define variable bf-handle    as handle   no-undo .
      147   define variable next-prev    as logical  no-undo .
      148   DEFINE BUTTON b-del
      149        LABEL "&Удалить":L
      150        SIZE 12 BY 1 TOOLTIP "Удалить заказ".
      151   DEFINE BUTTON b-erase
      152        LABEL "&Снять все *":L
      153        SIZE 13 BY 1 TOOLTIP "Снять все отметки"
      154        BGCOLOR 8 .
      155   DEFINE BUTTON b-help
      156        LABEL "Помо&щь":L
      157        SIZE 12 BY 1.
      158   DEFINE BUTTON b-lkp
      159        LABEL "&Просмотр":L
      160        SIZE 12 BY 1 TOOLTIP "Просмотр заказа без корректировки".
      161   DEFINE BUTTON b-mark
      162        LABEL "&*":L
      163        SIZE 4 BY 1.
      164   DEFINE BUTTON b-quit AUTO-GO
      165        LABEL "&Выход ":L
      166        SIZE 12 BY 1 TOOLTIP "Выход из режима".
      167   DEFINE QUERY BROWSE-3 FOR
      168         tmp-ord SCROLLING.
      169   DEFINE BROWSE BROWSE-3
      170     QUERY BROWSE-3 DISPLAY
      171         tmp-ord.mm         COLUMN-LABEL "*" FORMAT "*/"
      172         tmp-ord.doc-code
      173         tmp-ord.flag_      COLUMN-LABEL "ОК"   FORMAT "+/-"
      174         tmp-ord.status_    COLUMN-LABEL "Статус"  FORMAT "x(6)"
      175         tmp-ord.doc-date
      176         tmp-ord.host-code  COLUMN-LABEL "Фирма"
      177         tmp-ord.cli-type + " " + String(tmp-ord.cli-code) @ tmp-ord.cli-type COLUMN-LABEL "Код" FORMAT "x(9)"
      178         tmp-ord.cli-name
      179       WITH SEPARATORS SIZE 80.63 BY 15.5.
      180   DEFINE FRAME Dialog-Frame
      181        b-quit AT ROW 1 COL 2.13
      182        b-mark AT ROW 1 COL 14.13
      183        b-erase AT ROW 1 COL 18.13
      184        b-lkp AT ROW 1 COL 31.13
      185        b-del AT ROW 1 COL 43.13
      186        b-help AT ROW 1 COL 69.88
      187        BROWSE-3 AT ROW 2.21 COL 1.38
      188        SPACE(0.11) SKIP(0.20)
      189       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      190            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      191            TITLE "Неисполненные заказы".
      192   ASSIGN
      193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      194          FRAME Dialog-Frame:HIDDEN           = TRUE.
      195   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      196   DO:
      197     APPLY "END-ERROR":U TO SELF.
      198   END.
      199   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      200   DO:
      201     run procdel in this-procedure .
      202     OPEN QUERY BROWSE-3 FOR EACH tmp-ord NO-LOCK.
      203   END.
      204   ON CHOOSE OF b-erase IN FRAME Dialog-Frame
      205   DO:
      206     For each Tmp-ord share-lock :
      207         Tmp-ord.mm = false.
      208     End.
      209       OPEN QUERY BROWSE-3 FOR EACH tmp-ord NO-LOCK.
      210   END.
      211   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      212   DO:
      213   define variable v-doc-rec as recid no-undo .
      214     find first SHAR-BUF_ORD-DOC no-lock where SHAR-BUF_ORD-DOC.doc-code = tmp-ord.doc-code no-error .
      215     if error-status :error then return .
      216     run cus/ord-zakz.p
      217       ( input parParentProc ,
      218         input 'ПРОСМОТР':U ,
      219         input shar-buf_ord-doc.doc-type ,
      220         output v-doc-rec ,
      221         input-output br-handle  ,
      222         input-output bf-handle ,
      223         input-output next-prev
      224       ).
      225   END.
      226   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      227   OR MOUSE-SELECT-DBLCLICK OF BROWSE-3 IN FRAME Dialog-Frame
      228   DO:
      229     if not available tmp-ord then do:
      230        message "Неправильный выбор строки.".
      231        return no-apply.
      232        end.
      233      IF     tmp-ord.mm = true THEN DO:
      234              tmp-ord.mm = false.
      235              disp "" @ Tmp-ord.mm with browse BROWSE-3.
      236       End.
      237       Else DO:
      238              tmp-ord.mm = true.
      239              disp "*" @ tmp-ord.mm with browse BROWSE-3.
      240       End.
      241        apply "VALUE-CHANGED" to BROWSE-3 in frame Dialog-Frame.
      242        apply "ROW-DISPLAY" to BROWSE-3 in frame Dialog-Frame.
      243        g#log = BROWSE-3:select-next-row ().
      244   END.
      245   ON ROW-DISPLAY OF BROWSE-3 IN FRAME Dialog-Frame
      246   DO:
      247   if tmp-ord.mm = true then DO:
      248         tmp-ord.mm          :fgcolor in browse BROWSE-3 = brown_color.
      249         tmp-ord.doc-code    :fgcolor in browse BROWSE-3 = brown_color.
      250         tmp-ord.flag_       :fgcolor in browse BROWSE-3 = brown_color.
      251         tmp-ord.status_     :fgcolor in browse BROWSE-3 = brown_color.
      252         tmp-ord.doc-date    :fgcolor in browse BROWSE-3 = brown_color.
      253         tmp-ord.host-code   :fgcolor in browse BROWSE-3 = brown_color.
      254         tmp-ord.cli-type    :fgcolor in browse BROWSE-3 = brown_color.
      255         tmp-ord.cli-name    :fgcolor in browse BROWSE-3 = brown_color.
      256     End.
      257     Else DO:
      258         tmp-ord.mm          :fgcolor in browse BROWSE-3 = black_color.
      259         tmp-ord.doc-code    :fgcolor in browse BROWSE-3 = black_color.
      260         tmp-ord.flag_       :fgcolor in browse BROWSE-3 = black_color.
      261         tmp-ord.status_     :fgcolor in browse BROWSE-3 = black_color.
      262         tmp-ord.doc-date    :fgcolor in browse BROWSE-3 = black_color.
      263         tmp-ord.host-code   :fgcolor in browse BROWSE-3 = black_color.
      264         tmp-ord.cli-type    :fgcolor in browse BROWSE-3 = black_color.
      265         tmp-ord.cli-name    :fgcolor in browse BROWSE-3 = black_color.
      266     End.
      267   END.
      268   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      269   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      270   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   on help of frame Dialog-Frame
      272   do:
      273     run gbl/app_help.p
      274       (input this-procedure :file-name
      275       ,input ''
      276       ,input ?
      277       ) no-error.
      278     if error-status :error then do:
      279       message
      280         "Ошибка при вызове помощи"
      281         error-status :get-message(1)
      282         view-as alert-box .
      283     end.
      284   end.
      285   run minbtn-set in this-procedure .
      286   on choose of b-help in frame Dialog-Frame
      287   do:
      288     apply "help":u to frame Dialog-Frame .
      289   end.
      290   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   procedure minbtn-set :
      292       do
      293           on error undo, return error return-value
      294           :
      295           define variable ii              as integer       no-undo .
      296           define variable fh              as widget-handle no-undo .
      297           define variable hh              as widget-handle no-undo .
      298           define variable v-h             as handle        extent 4 no-undo .
      299           define variable v-name-button   as character     no-undo .
      300           define variable v-help-old-x    as decimal       no-undo .
      301           define variable v-help-old-y    as decimal       no-undo .
      302           define variable v-help-old-size as decimal       no-undo .
      303           define variable v-frame-width   as decimal       no-undo .
      304           define variable jj              as integer       no-undo .
      305           do
      306               on error undo, return error
      307               :
      308               assign
      309                   v-frame-width = frame Dialog-Frame:width - 0.3
      310                   fh            = frame Dialog-Frame:first-child
      311                   hh            = fh:first-child
      312                   ii            = 1
      313                   .
      314               do while valid-handle(hh):
      315                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      316                   do:
      317                       case lc(hh:name) :
      318                           when "b-help" then
      319                               do:
      320                                   hh:load-image-up("cmp/b-help.bmp":u) .
      321                                   hh:load-image-down("cmp/b-help.bmp":u) .
      322                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      323                                   hh:TOOLTIP = "Помощь" .
      324                                   v-help-old-x = hh:column .
      325                                   v-help-old-y = hh:row    .
      326                                   v-help-old-size = hh:width .
      327                                   hh:width-chars = 2.5 .
      328                               end.
      329                           when "b-print" then
      330                               do:
      331                                   hh:load-image("cmp/b-print.bmp":u) .
      332                                   hh:TOOLTIP = "Печать" .
      333                                   v-h[ii] = hh:handle .
      334                                   ii = ii + 1 .
      335                                   hh:width-chars = 3 .
      336                               end.
      337                           when "b-history" or
      338                           when "b-hist" then
      339                               do:
      340                                   hh:load-image("cmp/b-hist.bmp":u) .
      341                                   hh:TOOLTIP = "История" .
      342                                   v-h[ii] = hh:handle .
      343                                   ii = ii + 1 .
      344                                   hh:width-chars = 3 .
      345                               end.
      346                           when "b-sch" then
      347                               do:
      348                                   hh:load-image("cmp/b-sch.bmp":u) .
      349                                   hh:TOOLTIP = "Установка Фильтра" .
      350                                   v-h[ii] = hh:handle .
      351                                   ii = ii + 1 .
      352                                   hh:width-chars = 3 .
      353                               end.
      354                           when "b-hist-user" then
      355                               do:
      356                                   hh:load-image("cmp/b-hist.bmp":u) .
      357                                   hh:TOOLTIP = "История пользователя" .
      358                                   ii = ii + 1 .
      359                               end.
      360                       end case.
      361                   end.
      362                   hh = hh:next-sibling.
      363               end.
      364               b-help:column = v-frame-width - b-help:width-chars.
      365               jj = 0.
      366               repeat ii = 4 to 1 by -1 :
      367                   if valid-handle (v-h[ii] ) then
      368                   do:
      369                       jj  = jj + 1 .
      370                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      371                       v-h[ii]:row    = v-help-old-y .
      372                   end.
      373               end.
      374           end.
      375       end.
      376   end procedure.
      377   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      378   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      379   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      380   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      381   define variable v-diasize-current-frame-width  as decimal   no-undo .
      382   define variable v-diasize-current-frame-height as decimal   no-undo .
      383   define variable v-diasize-change-size          as logical   no-undo .
      384   define variable v-diasize-resize-button        as handle    no-undo .
      385   define variable v-diasize-wndmax               as logical   no-undo .
      386   define variable v-diasize-wndstore             as logical   no-undo .
      387   define variable v-diasize-proc-name            as character no-undo .
      388   define variable v-diasize-browse-handle        as handle    no-undo .
      389   define variable v-diasize-browse-number        as integer   no-undo .
      390   define variable v-diasize-need-full-display    as logical   no-undo init false .
      391   define temp-table temp-diasize-handle no-undo
      392     field handle-value  as handle
      393     field save-position as decimal
      394     index xpk is primary unique handle-value
      395     .
      396   define temp-table temp-browse-handle no-undo
      397     field browse-type   as character
      398     field browse-number as integer
      399     field browse-handle as handle
      400     field original-size as decimal
      401     index xpk is primary unique browse-type browse-number
      402     index xie browse-type browse-handle
      403   .
      404   procedure diasize_change-height :
      405     define input  parameter p-change-value  as decimal   no-undo .
      406     define input  parameter p-move-resize   as logical   no-undo .
      407     define variable v-field-group-handle    as handle    no-undo .
      408     define variable v-object-handle         as handle    no-undo .
      409     define variable v-frame-height          as decimal   no-undo .
      410     define variable v-frame-virtual-height  as decimal   no-undo .
      411     define variable v-browse-height         as decimal   no-undo .
      412     define variable v-window-height         as decimal   no-undo .
      413     define variable v-window-virtual-height as decimal   no-undo .
      414     define variable v-change-sign           as integer   no-undo .
      415     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      416     define buffer buf_temp-browse-handle  for temp-browse-handle .
      417     if p-change-value > 0
      418     then do:
      419       if frame Dialog-Frame :height + p-change-value
      420           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      421       then do:
      422         assign
      423           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      424                           - (frame Dialog-Frame :height-chars)
      425         .
      426         if p-change-value <= 0
      427         then do:
      428           run diasize_position-resize-button in this-procedure .
      429           return .
      430         end.
      431       end.
      432     end.
      433     if p-change-value < 0
      434     then do:
      435       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      436       then do:
      437         assign
      438           p-change-value = v-diasize-orig-frame-height
      439                          - (frame Dialog-Frame :height-chars)
      440         .
      441         if p-change-value >= 0
      442         then do:
      443           run diasize_position-resize-button in this-procedure .
      444           return .
      445         end.
      446       end.
      447     end.
      448     if p-change-value >= 0
      449     then do:
      450       assign
      451         v-change-sign = 1
      452       .
      453     end.
      454     else do:
      455       assign
      456         v-change-sign = -1
      457       .
      458     end.
      459     assign
      460       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      461     .
      462     if p-change-value = 0
      463     then do:
      464       run diasize_position-resize-button in this-procedure .
      465       return .
      466     end.
      467     move_block:
      468     do
      469     on error undo move_block, retry move_block
      470     :
      471       if retry
      472       then do:
      473         do
      474         on error undo move_block, leave move_block
      475         :
      476           if p-change-value > 0
      477           then do:
      478             for each buf_temp-diasize-handle
      479             on error undo, next
      480             :
      481               assign
      482                 v-object-handle = buf_temp-diasize-handle.handle-value
      483               .
      484               if v-object-handle <> v-diasize-resize-button
      485               then do:
      486                 assign
      487                   v-object-handle :row = buf_temp-diasize-handle.save-position
      488                 .
      489               end.
      490             end.
      491             assign
      492               v-diasize-browse-handle :height = v-browse-height
      493             .
      494             for each buf_temp-browse-handle
      495               where buf_temp-browse-handle.browse-type = 'height':u
      496             on error undo, next
      497             :
      498               assign
      499                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      500               .
      501             end.
      502             assign
      503               frame Dialog-Frame :height = v-frame-height
      504             .
      505             if frame Dialog-Frame :scrollable = true
      506             then do:
      507               assign
      508                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      509               .
      510             end.
      511             run diasize_position-resize-button in this-procedure .
      512           end.
      513           else do:
      514             if frame Dialog-Frame :scrollable = true
      515             then do:
      516               assign
      517                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      518               .
      519             end.
      520             assign
      521               frame Dialog-Frame :height = v-frame-height
      522             .
      523             assign
      524               v-diasize-browse-handle :height = v-browse-height
      525             .
      526             for each buf_temp-browse-handle
      527               where buf_temp-browse-handle.browse-type = 'height':u
      528             on error undo, next
      529             :
      530               assign
      531                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      532               .
      533             end.
      534             for each buf_temp-diasize-handle
      535             on error undo, next
      536             :
      537               assign
      538                 v-object-handle = buf_temp-diasize-handle.handle-value
      539               .
      540               if v-object-handle <> v-diasize-resize-button
      541               then do:
      542                 assign
      543                   v-object-handle :row = buf_temp-diasize-handle.save-position
      544                 .
      545               end.
      546             end.
      547             run diasize_position-resize-button in this-procedure .
      548           end.
      549           assign
      550             v-diasize-change-size = false
      551           .
      552           leave move_block .
      553         end.
      554       end.
      555       assign
      556         v-diasize-need-full-display = true
      557       .
