     1158             ) .
     1159         end.
     1160       end.
     1161     end.
     1162     assign
     1163       v-diasize-change-size = false
     1164     .
     1165   end procedure.
     1166   procedure diasize_set-width :
     1167     define input  parameter p-new-width  as decimal   no-undo .
     1168     define input  parameter p-move-resize as logical   no-undo .
     1169     do
     1170     on error undo, return error return-value
     1171     :
     1172       run diasize_change-width in this-procedure
     1173         (input  (p-new-width - frame Dialog-Frame :width)
     1174         ,input  p-move-resize
     1175         ) .
     1176     end.
     1177   end procedure.
     1178   procedure diasize_position-resize-button :
     1179     do with frame Dialog-Frame
     1180     :
     1181       hide v-diasize-resize-button .
     1182       assign
     1183         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1184                     - 1
     1185                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1186         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1187                     - 1
     1188                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1189       .
     1190       view v-diasize-resize-button .
     1191     end.
     1192   end procedure.
     1193   on alt-right anywhere
     1194   do:
     1195     run diasize_change-width in this-procedure
     1196       (input 1
     1197       ,input true
     1198       ) .
     1199     return no-apply .
     1200   end.
     1201   on alt-left anywhere
     1202   do:
     1203     run diasize_change-width in this-procedure
     1204       (input -1
     1205       ,input true
     1206       ) .
     1207     return no-apply .
     1208   end.
     1209   on alt-down anywhere
     1210   do:
     1211     run diasize_change-height in this-procedure
     1212       (input 1
     1213       ,input true
     1214       ) .
     1215     return no-apply .
     1216   end.
     1217   on alt-up anywhere
     1218   do:
     1219     run diasize_change-height in this-procedure
     1220       (input -1
     1221       ,input true
     1222       ) .
     1223     return no-apply .
     1224   end.
     1225   on alt-enter of frame Dialog-Frame
     1226   do:
     1227     run diasize_maximize in this-procedure
     1228       (input  ?
     1229       ).
     1230     return no-apply .
     1231   end.
     1232   procedure diasize_end-move :
     1233     do
     1234     on error undo, return error return-value
     1235     :
     1236       define variable v-row-delta as decimal   no-undo .
     1237       define variable v-col-delta as decimal   no-undo .
     1238       define variable v-new-row as decimal   no-undo .
     1239       define variable v-new-col as decimal   no-undo .
     1240       assign
     1241         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1242         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1243       .
     1244       assign
     1245         v-row-delta = v-new-row - frame Dialog-Frame :height
     1246         v-col-delta = v-new-col - frame Dialog-Frame :width
     1247       .
     1248       run diasize_change-height in this-procedure
     1249         (input v-row-delta
     1250         ,input true
     1251         ) .
     1252       run diasize_change-width in this-procedure
     1253         (input v-col-delta
     1254         ,input true
     1255         ) .
     1256     end.
     1257   end procedure.
     1258   procedure diasize_maximize :
     1259     define input  parameter p-action as logical   no-undo .
     1260     do
     1261     on error undo, return error return-value
     1262     :
     1263       if p-action = ?
     1264       then do:
     1265         if v-diasize-need-maximize = true
     1266         then do:
     1267           assign
     1268             p-action = true
     1269           .
     1270         end.
     1271         else do:
     1272           assign
     1273             p-action = false
     1274           .
     1275         end.
     1276       end.
     1277       if p-action = true
     1278       then do:
     1279         run diasize_change-height in this-procedure
     1280           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1281               - frame Dialog-Frame :height-chars
     1282           ,input true
     1283           ) .
     1284         run diasize_change-width in this-procedure
     1285           (input session :width-chars
     1286               - frame Dialog-Frame :width-chars
     1287           ,input true
     1288           ) .
     1289         assign
     1290           v-diasize-need-maximize = false
     1291         .
     1292       end.
     1293       else do:
     1294         run diasize_change-width in this-procedure
     1295           (input v-diasize-orig-frame-width
     1296               - frame Dialog-Frame :width-chars
     1297           ,input true
     1298           ) .
     1299         run diasize_change-height in this-procedure
     1300           (input v-diasize-orig-frame-height
     1301               - frame Dialog-Frame :height-chars
     1302           ,input true
     1303           ) .
     1304         assign
     1305           v-diasize-need-maximize = true
     1306         .
     1307       end.
     1308     end.
     1309   end procedure.
     1310   procedure diasize_restore-orig-size :
     1311     do
     1312     on error undo, return error return-value
     1313     :
     1314       assign
     1315         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1316         v-diasize-current-frame-height = frame Dialog-Frame :height
     1317       .
     1318       run diasize_set-height in this-procedure
     1319         (input  v-diasize-orig-frame-height
     1320         ,input  true
     1321         ) .
     1322       run diasize_set-width in this-procedure
     1323         (input  v-diasize-orig-frame-width
     1324         ,input  true
     1325         ) .
     1326     end.
     1327   end procedure.
     1328   procedure diasize_restore-current-size :
     1329     do
     1330     on error undo, return error return-value
     1331     :
     1332       run diasize_set-height in this-procedure
     1333         (input  v-diasize-current-frame-height
     1334         ,input  true
     1335         ) .
     1336       run diasize_set-width in this-procedure
     1337         (input  v-diasize-current-frame-width
     1338         ,input  true
     1339         ) .
     1340     end.
     1341   end procedure.
     1342   procedure diasize_set-browse-handle :
     1343     define input  parameter p-browse-handle as handle   no-undo .
     1344     define buffer buf_temp-browse-handle for temp-browse-handle .
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       assign
     1349         v-diasize-browse-handle = p-browse-handle
     1350       .
     1351       for each buf_temp-browse-handle
     1352       on error undo, return error return-value
     1353       :
     1354         delete buf_temp-browse-handle .
     1355       end.
     1356     end.
     1357   end procedure.
     1358   procedure diasize_add_browse :
     1359     define input  parameter p-browse-type   as character no-undo .
     1360     define input  parameter p-browse-handle as handle    no-undo .
     1361     define buffer buf_temp-browse-handle for temp-browse-handle .
     1362     do
     1363     on error undo, return error return-value
     1364     :
     1365       assign
     1366         v-diasize-browse-number = v-diasize-browse-number + 1
     1367       .
     1368       create buf_temp-browse-handle .
     1369       assign
     1370         buf_temp-browse-handle.browse-type   = p-browse-type
     1371         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1372         buf_temp-browse-handle.browse-handle = p-browse-handle
     1373       .
     1374     end.
     1375   end procedure.
     1376   procedure diasize_init :
     1377     define variable v-default-value    as logical   no-undo .
     1378     define variable v-restore-saved    as logical   no-undo .
     1379     define variable v-resize-value-str as character no-undo .
     1380     do
     1381     on error undo, return error return-value
     1382     :
     1383       do with frame Dialog-Frame
     1384       :
     1385         assign
     1386           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1387           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1388           v-diasize-browse-handle     = browse BROWSE-3 :handle
     1389         .
     1390         create button v-diasize-resize-button
     1391         assign
     1392           parent        = frame Dialog-Frame :first-child
     1393           label         = "s"
     1394           height-pixels = 16
     1395           width-pixels  = 16
     1396           visible       = true
     1397           sensitive     = true
     1398           movable       = true
     1399           triggers:
     1400             on end-move persistent run diasize_end-move in this-procedure .
     1401           end triggers.
     1402         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1403         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1404         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1405         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1406         assign
     1407           v-diasize-wndmax = false
     1408         .
     1409         if connected("ub") = true
     1410         then do:
     1411           define variable v-cntxt-db-num        as integer   no-undo .
     1412           define variable v-cntxt-userid        as character no-undo .
     1413           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1414                                             , OUTPUT v-cntxt-userid
     1415                                             ) .
     1416           run gbl/wndpar_r.p
     1417             (input  v-cntxt-db-num
     1418             ,input  v-cntxt-userid
     1419             ,input  'wndmax':U
     1420             ,output v-diasize-wndmax
     1421             ,output v-default-value
     1422             ) .
     1423         end.
     1424         assign
     1425           v-diasize-wndstore = false
     1426         .
     1427         if connected("ub") = true
     1428         then do:
     1429           run gbl/wndpar_r.p
     1430             (input  v-cntxt-db-num
     1431             ,input  v-cntxt-userid
     1432             ,input  'wndstore':U
     1433             ,output v-diasize-wndstore
     1434             ,output v-default-value
     1435             ) .
     1436         end.
     1437         assign
     1438           v-diasize-proc-name = entry(1, program-name(2), '.')
     1439         .
     1440         if v-diasize-wndstore = true
     1441         then do:
     1442           assign
     1443             v-restore-saved = false
     1444           .
     1445           if connected("ub") = true
     1446           then do:
     1447             run gbl/wndsizer.p
     1448               (input  v-cntxt-db-num
     1449               ,input  v-cntxt-userid
     1450               ,input  v-diasize-proc-name
     1451               ,input  'height':u
     1452               ,output v-resize-value-str
     1453               ) .
     1454             if v-resize-value-str <> '':U
     1455             then do:
     1456               run diasize_change-height in this-procedure
     1457                 (input  integer(v-resize-value-str)
     1458                 ,input  true
     1459                 ) .
     1460               assign
     1461                 v-restore-saved = true
     1462               .
     1463             end.
     1464           end.
     1465           if connected("ub") = true
     1466           then do:
     1467             run gbl/wndsizer.p
     1468               (input  v-cntxt-db-num
     1469               ,input  v-cntxt-userid
     1470               ,input  v-diasize-proc-name
     1471               ,input  'width':u
     1472               ,output v-resize-value-str
     1473               ) .
     1474             if v-resize-value-str <> '':U
     1475             then do:
     1476               run diasize_change-width in this-procedure
     1477                 (input  integer(v-resize-value-str)
     1478                 ,input  true
     1479                 ) .
     1480               assign
     1481                 v-restore-saved = true
     1482               .
     1483             end.
     1484           end.
     1485           if v-restore-saved <> true
     1486           then do:
     1487             if v-diasize-wndmax = true
     1488             then do:
     1489               run diasize_maximize in this-procedure
     1490                 (input  true
     1491                 ) .
     1492             end.
     1493           end.
     1494         end.
     1495         else do:
     1496           if v-diasize-wndmax = true
     1497           then do:
     1498             run diasize_maximize in this-procedure
     1499               (input  true
     1500               ) .
     1501           end.
     1502         end.
     1503       end.
     1504     end.
     1505   end procedure.
     1506   procedure diasize_need-full-display :
     1507     define output parameter p-need-full-display as logical   no-undo .
     1508     do
     1509     on error undo, return error return-value
     1510     :
     1511       assign
     1512         p-need-full-display = v-diasize-need-full-display
     1513       .
     1514       assign
     1515         v-diasize-need-full-display = false
     1516       .
     1517     end.
     1518   end procedure.
     1519   procedure get-context :
     1520      define output parameter p-db-num as integer          no-undo.
     1521      define output parameter p-user-id as character        no-undo.
     1522      define variable v-login               as character    no-undo.
     1523      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1524      define buffer buf_user-login  for ub.user-login .
     1525      do
     1526      on error undo, return error
     1527      :
     1528            FIND FIRST buf_sys-ctrl no-lock.
     1529            ASSIGN
     1530               v-login = USERID("ub")
     1531               p-db-num = buf_sys-ctrl.db-num
     1532            .
     1533            FIND FIRST buf_user-login
     1534                 WHERE buf_user-login.db-num = p-db-num
     1535                   AND buf_user-login.user-login = v-login
     1536                 no-lock
     1537                 no-error
     1538                 .
     1539            IF AVAILABLE buf_user-login
     1540            THEN DO:
     1541               assign
     1542                  p-user-id = buf_user-login.user-id
     1543               .
     1544            END.
     1545      end.
     1546   end procedure.
     1547       run diasize_init in this-procedure .
     1548   run maketmp in this-procedure .
     1549   MAIN-BLOCK:
     1550   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1551      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1552     RUN enable_UI.
     1553     WAIT-FOR GO OF FRAME Dialog-Frame.
     1554   END.
     1555   RUN disable_UI.
     1556   PROCEDURE disable_UI :
     1557     HIDE FRAME Dialog-Frame.
     1558   END PROCEDURE.
     1559   PROCEDURE enable_UI :
     1560     ENABLE b-quit b-mark b-erase b-lkp b-del b-help BROWSE-3
     1561         WITH FRAME Dialog-Frame.
     1562     VIEW FRAME Dialog-Frame.
     1563     OPEN QUERY BROWSE-3 FOR EACH tmp-ord NO-LOCK.
     1564   END PROCEDURE.
     1565   PROCEDURE maketmp :
     1566   define variable  t-ret as logical no-undo .
     1567   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     1568   For each ub.ord-doc where
     1569                ub.ord-doc.host-code = v-cntxt-host-code-obj and
     1570                ub.ord-doc.doc-date >= date1 and
     1571                ub.ord-doc.doc-date <= date2 and
     1572                ub.ord-doc.doc-type  = g#type   and
     1573             Not can-find
     1574                (first  ub.trn-doc where
     1575                         ub.trn-doc.host-code =  ub.ord-doc.host-code and
     1576                         ub.trn-doc.ord-num   =  ub.ord-doc.doc-code  no-lock )  no-lock :
     1577               Create tmp-ord.
     1578               Buffer-copy ub.ord-doc to tmp-ord.
     1579       End.
     1580       t-ret =  session:SET-WAIT-STATE("") .
     1581   END PROCEDURE.
     1582   procedure procdel:
     1583   define variable v-ii as integer no-undo .
     1584   define variable v-ss like Tmp-ord.doc-code no-undo .
     1585   define variable  t-ret as logical no-undo .
     1586   g#log = false .
     1587   message "Удалять отмеченные заказы ?" view-as alert-box question Buttons Yes-No Title "Вопрос" update g#log .
     1588   IF g#log = true then do:
     1589   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     1590     FOR EACH  Tmp-ord WHERE Tmp-ord.mm = true share-LOCK :
     1591        find ub.ord-doc where  Tmp-ord.doc-code = ub.ord-doc.doc-code and  Tmp-ord.doc-date = ub.ord-doc.doc-date share-lock.
     1592        v-ii =  v-ii + 1.
     1593        v-ss = "Закааз № "  + Tmp-ord.doc-code.
     1594        delete ub.ord-doc .
     1595        delete Tmp-ord .
     1596     END.
     1597     t-ret =  session:SET-WAIT-STATE("") .
     1598    End.
     1599    End procedure.
