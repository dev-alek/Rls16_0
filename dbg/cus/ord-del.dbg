      688           end.
      689         end.
      690       end.
      691       else do:
      692         for each buf_temp-diasize-handle
      693         on error undo move_block, retry move_block
      694         :
      695           assign
      696             v-object-handle = buf_temp-diasize-handle.handle-value
      697           .
      698           if v-object-handle <> v-diasize-resize-button
      699           then do:
      700             assign
      701               v-object-handle :row = v-object-handle :row + p-change-value
      702               no-error .
