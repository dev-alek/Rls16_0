      704             or error-status :get-message(1) <> ""
      705             then do:
      706               undo move_block, retry move_block .
      707             end.
      708           end.
      709         end.
      710         assign
      711           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      712           no-error .
