      510   end.
      511   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   procedure minbtn-set :
      513       do
      514           on error undo, return error return-value
      515           :
      516           define variable ii              as integer       no-undo .
      517           define variable fh              as widget-handle no-undo .
      518           define variable hh              as widget-handle no-undo .
      519           define variable v-h             as handle        extent 4 no-undo .
      520           define variable v-name-button   as character     no-undo .
      521           define variable v-help-old-x    as decimal       no-undo .
      522           define variable v-help-old-y    as decimal       no-undo .
      523           define variable v-help-old-size as decimal       no-undo .
      524           define variable v-frame-width   as decimal       no-undo .
      525           define variable jj              as integer       no-undo .
      526           do
      527               on error undo, return error
      528               :
      529               assign
      530                   v-frame-width = frame Dialog-Frame:width - 0.3
      531                   fh            = frame Dialog-Frame:first-child
      532                   hh            = fh:first-child
      533                   ii            = 1
      534                   .
      535               do while valid-handle(hh):
      536                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      537                   do:
      538                       case lc(hh:name) :
      539                           when "b-help" then
      540                               do:
      541                                   hh:load-image-up("cmp/b-help.bmp":u) .
      542                                   hh:load-image-down("cmp/b-help.bmp":u) .
      543                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      544                                   hh:TOOLTIP = "Помощь" .
      545                                   v-help-old-x = hh:column .
      546                                   v-help-old-y = hh:row    .
      547                                   v-help-old-size = hh:width .
      548                                   hh:width-chars = 2.5 .
      549                               end.
      550                           when "b-print" then
      551                               do:
      552                                   hh:load-image("cmp/b-print.bmp":u) .
      553                                   hh:TOOLTIP = "Печать" .
      554                                   v-h[ii] = hh:handle .
      555                                   ii = ii + 1 .
      556                                   hh:width-chars = 3 .
      557                               end.
      558                           when "b-history" or
      559                           when "b-hist" then
      560                               do:
      561                                   hh:load-image("cmp/b-hist.bmp":u) .
      562                                   hh:TOOLTIP = "История" .
      563                                   v-h[ii] = hh:handle .
      564                                   ii = ii + 1 .
      565                                   hh:width-chars = 3 .
      566                               end.
      567                           when "b-sch" then
      568                               do:
      569                                   hh:load-image("cmp/b-sch.bmp":u) .
      570                                   hh:TOOLTIP = "Установка Фильтра" .
      571                                   v-h[ii] = hh:handle .
      572                                   ii = ii + 1 .
      573                                   hh:width-chars = 3 .
      574                               end.
      575                           when "b-hist-user" then
      576                               do:
      577                                   hh:load-image("cmp/b-hist.bmp":u) .
      578                                   hh:TOOLTIP = "История пользователя" .
      579                                   ii = ii + 1 .
      580                               end.
      581                       end case.
      582                   end.
      583                   hh = hh:next-sibling.
      584               end.
      585               b-help:column = v-frame-width - b-help:width-chars.
      586               jj = 0.
      587               repeat ii = 4 to 1 by -1 :
      588                   if valid-handle (v-h[ii] ) then
      589                   do:
      590                       jj  = jj + 1 .
      591                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      592                       v-h[ii]:row    = v-help-old-y .
      593                   end.
      594               end.
      595           end.
      596       end.
      597   end procedure.
      598   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      599   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      600   MAIN-BLOCK:
      601   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      602      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      603     RUN init-proc in this-procedure .
      604     RUN enable_UI in this-procedure .
      605     WAIT-FOR GO OF FRAME Dialog-Frame.
      606   END.
      607   RUN disable_UI in this-procedure .
      608   PROCEDURE create-ord-doc :
      609   define variable v-doc-type as character no-undo .
      610   define variable v-cli-type as character no-undo .
      611   define variable v-cli-code as integer   no-undo .
      612   define variable v-cli-name as character no-undo .
      613   define buffer buf_ord-doc for ub.ord-doc  .
      614   find first buf_ord-doc no-lock  where
      615         recid ( buf_ord-doc ) = p-recid no-error .
      616     case scr-doc-type :
      617         when 1 then do:
      618         find first buf_clients no-lock where buf_clients.obj-type = 'орг':U  and buf_clients.obj-code = buf_ord-doc.host-code no-error .
      619           v-doc-type = 'ОФ':U .
      620           v-cli-type = 'орг':U .
      621           v-cli-code = buf_ord-doc.host-code .
      622           v-cli-name = buf_clients.obj-name .
      623         end.
      624         when 2 then do:
      625           v-doc-type = 'ОО':U .
      626           v-cli-type = "" .
      627           v-cli-code = 0 .
      628         end.
      629         when 3 then do:
      630           v-doc-type = 'ОР':U .
      631           v-cli-type = "" .
      632           v-cli-code = 0 .
      633         end.
      634         otherwise do:
      635           return .
      636         end.
      637     end case.
      638   define variable v-i-doc as character no-undo .
      639   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   run proc-ord-code in this-procedure
      641    (input   'main' ,
      642     input   v-cntxt-db-num ,
      643     input   v-cntxt-obj-type ,
      644     input   v-cntxt-obj-code ,
      645     input   v-i-doc ,
      646     output  p-ord-doc
      647    ) .
      648   define buffer buf_gds-obj   for ub.gds-obj  .
      649   define buffer buf_ord-line  for ub.ord-line.
      650   define buffer buf_ord-dtl   for ub.ord-dtl.
      651   create ub.ord-doc.
      652   buffer-copy buf_ord-doc to ub.ord-doc
      653      assign
      654         ub.ord-doc.doc-code  = p-ord-doc
      655         ub.ord-doc.doc-type  = v-doc-type
      656         ub.ord-doc.doc-date  = today
      657         ub.ord-doc.date-sale-1   = buf_ord-doc.ship-date
      658         ub.ord-doc.date-sale-2   = buf_ord-doc.ship-date
      659         ub.ord-doc.cli-code  = v-cli-code
      660         ub.ord-doc.cli-type  = v-cli-type
      661         ub.ord-doc.cli-name  = v-cli-name
      662         ub.ord-doc.buyer-out-code  = buf_ord-doc.doc-code
      663         ub.ord-doc.flag_     = false
      664         ub.ord-doc.status_   = 'новый':U
      665      .
      666   for each buf_ord-line no-lock where
      667            buf_ord-line.doc-code = buf_ord-doc.doc-code
      668            :
      669            find first buf_gds-obj no-lock where
      670                       buf_gds-obj.obj-type = buf_ord-doc.obj-type and
      671                       buf_gds-obj.obj-code = buf_ord-doc.obj-code and
      672                       buf_gds-obj.gds-code = buf_ord-line.gds-code no-error .
      673            if not available buf_gds-obj then do:
      674               create ub.ord-line.
      675                   buffer-copy buf_ord-line to ub.ord-line
      676                   assign
      677                     ub.ord-line.doc-code  = p-ord-doc
      678                     .
      679            end.
      680            else do:
      681               if buf_ord-line.qnty > buf_gds-obj.free-qnty  then do:
      682                   create ub.ord-line.
      683                       buffer-copy buf_ord-line to ub.ord-line
      684                       assign
      685                         ub.ord-line.doc-code   = p-ord-doc
      686                         ub.ord-line.qnty       = buf_ord-line.qnty - buf_gds-obj.free-qnty
      687                         ub.ord-line.fact-qnty  = ub.ord-line.qnty
      688                         ub.ord-line.cli-qnty   = ub.ord-line.qnty  * buf_ord-line.cli-base-rate
      689                         ub.ord-line.price-rubl = buf_gds-obj.last-rubl
      690                         ub.ord-line.price-base = buf_gds-obj.last-base
      691                         .
      692               end.
      693            end.
      694   end.
      695   for each buf_ord-dtl no-lock where
      696            buf_ord-dtl.doc-code = buf_ord-doc.doc-code
      697            :
      698            create ub.ord-dtl.
      699            buffer-copy buf_ord-dtl to ub.ord-dtl
      700            assign
      701              ub.ord-dtl.doc-code  = p-ord-doc
      702              .
      703   end.
      704   p-rez = true .
      705   END PROCEDURE.
      706   PROCEDURE disable_UI :
      707     HIDE FRAME Dialog-Frame.
      708   END PROCEDURE.
      709   PROCEDURE enable_UI :
      710     DISPLAY scr-doc-type FILL-IN-1
      711         WITH FRAME Dialog-Frame.
      712     ENABLE B-Cancel B-save B-help scr-doc-type
      713         WITH FRAME Dialog-Frame.
      714     VIEW FRAME Dialog-Frame.
      715   END PROCEDURE.
      716   PROCEDURE init-proc :
      717   p-rez = false .
      718   END PROCEDURE.
