      445        BGCOLOR 8 .
      446   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Типы заявок:"
      447         VIEW-AS TEXT
      448        SIZE 14 BY .67
      449        FGCOLOR 4  NO-UNDO.
      450   DEFINE VARIABLE scr-doc-type AS INTEGER INITIAL 4
      451        VIEW-AS RADIO-SET VERTICAL
      452        RADIO-BUTTONS
      453             "Объект-Фирма", 1,
      454   "Объект-Объект", 2,
