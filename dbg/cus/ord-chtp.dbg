      484   END.
      485   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
      486   DO:
      487   END.
      488   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      489   DO:
      490   END.
      491   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   on help of frame Dialog-Frame
      493   do:
      494     run gbl/app_help.p
      495       (input this-procedure :file-name
      496       ,input ''
      497       ,input ?
      498       ) no-error.
      499     if error-status :error then do:
      500       message
      501         "Ошибка при вызове помощи"
      502         error-status :get-message(1)
      503         view-as alert-box .
      504     end.
      505   end.
      506   run minbtn-set in this-procedure .
