     2209   procedure ex-file :
     2210   define input parameter ff as character no-undo .
     2211   define input parameter ex as logical no-undo .
     2212     if ex = false then do:
     2213       create "Excel.Application" chExcelApplication no-error.
     2214       if error-status :error then do:
     2215           message
     2216           "Ошибка при запуске Excel" skip
     2217           error-status :get-message(1) skip
     2218           view-as alert-box error .
     2219           undo, return error .
     2220       end.
     2221       if ff = ""  then do:
     2222         chWorkBook   = chExcelApplication:WorkBooks:add( ).
     2223       end.
     2224       else do:
     2225         chWorkBook   = chExcelApplication:WorkBooks:open( ff ).
     2226       end.
     2227     end.
     2228     assign     chExcelApplication:interactive = false      chExcelApplication:ScreenUpdating = false      chExcelApplication:visible = false  .
     2229     chWorkSheet  = chExcelApplication:Sheets:item (1).
     2230   end procedure.
