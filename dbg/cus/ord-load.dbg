     1445   define variable l-Ostatok-today  as decimal   no-undo .
     1446   define variable l-negative-rest  as logical   no-undo .
     1447   define variable l-qnty-day       as integer   no-undo .
     1448   define variable l-pay-day        as integer   no-undo .
     1449   define variable l-Temp-rash      as decimal   no-undo .
     1450   define variable l-null-day       as integer   no-undo init 0 .
     1451   define variable l-min-zap        as decimal   no-undo .
     1452   define variable l-order          as decimal   no-undo .
     1453   define variable l-a              as decimal   no-undo .
     1454   define variable l-b              as decimal   no-undo .
     1455   define variable l-negative-sale  as logical   no-undo .
     1456   define variable l-goods-way      as decimal   no-undo .
     1457   define variable l-min-order      as decimal   no-undo .
     1458   define variable l-tog-min-order  as logical   no-undo .
     1459   define variable loc-unit-base    as character no-undo .
     1460   define variable l-min-ost        as logical   no-undo .
     1461   define variable l-tog-deadline   as logical   no-undo .
     1462   define variable l-deadline       as integer   no-undo .
     1463   define variable l-type-MR        as character no-undo .
     1464   define variable par-ord-min-ost  as logical   no-undo .
     1465   define variable v-media-qnty     as decimal   no-undo .
     1466   define variable l-corr-coeff     as decimal   no-undo .
     1467   define stream stream_order .
     1468   define variable is-log             as logical   no-undo .
     1469   define variable p-val              as character no-undo .
     1470   define variable p-type             as character no-undo .
     1471   define variable v-value-character  as character no-undo .
     1472   define variable v-value-date       as date      no-undo .
     1473   define variable v-value-decimal    as decimal   no-undo .
     1474   define variable v-value-integer    as integer   no-undo .
     1475   define variable v-stroka-protocol  as character no-undo .
     1476   define variable v-protocol-date    as date      no-undo .
     1477   define variable v-protocol-time    as integer   no-undo .
     1478   run adm/shattri.p (
     1479     input "get":U
     1480     ,input ""
     1481     ,input 0
     1482     ,input 'ord-global':U
     1483     ,input 'ord-log':U
     1484     ,output v-value-character
     1485     ,output v-value-date
     1486     ,output v-value-decimal
     1487     ,output v-value-integer
     1488     ,output is-log
     1489     ,output p-type
     1490     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1491     ) no-error .
     1492     if error-status :error then is-log = false .
     1493   run adm/shattri.p (
     1494     input "get":U
     1495     ,input ""
     1496     ,input 0
     1497     ,input 'ord-global':U
     1498     ,input 'ord-min-ost-day':U
     1499     ,output v-value-character
     1500     ,output v-value-date
     1501     ,output v-value-decimal
     1502     ,output v-value-integer
     1503     ,output par-ord-min-ost
     1504     ,output p-type
     1505     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1506     ) no-error .
     1507     if error-status :error then par-ord-min-ost = false .
     1508   procedure recalc-cli-qnty :
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512   define input  parameter p-gds-code      as integer   no-undo .
     1513   define input  parameter p-round-m       as character no-undo .
     1514   define input  parameter p-round-base    as decimal   no-undo .
     1515   define input  parameter p-unit-cli      as character no-undo .
     1516   define input  parameter p-cli-base-rate as decimal   no-undo .
     1517   define input  parameter p-price-cli     as decimal   no-undo .
     1518   define input  parameter p-price-rubl    as decimal   no-undo .
     1519   define input  parameter p-price-base    as decimal   no-undo .
     1520   define input-output parameter p-cli-qnty as decimal   no-undo .
     1521   define input-output parameter p-qnty     as decimal   no-undo .
     1522   define input-output parameter p-sum-cli  as decimal   no-undo .
     1523   define input-output parameter p-sum-rubl as decimal   no-undo .
     1524   define input-output parameter p-sum-base as decimal   no-undo .
     1525   define buffer buf_goods for ub.goods  .
     1526   define buffer buf_units for ub.units  .
     1527   define variable v-cli-qnty as decimal   no-undo .
     1528   find first buf_goods no-lock where
     1529              buf_goods.gds-code = p-gds-code no-error .
     1530   v-cli-qnty = p-cli-qnty .
     1531   if can-find (
     1532   first buf_units where
     1533         buf_units.unit-name = p-unit-cli and
     1534         lookup ('шту':U, buf_units.type) > 0 ) and
     1535     truncate ( p-cli-qnty, 0 ) <> p-cli-qnty then do:
     1536     assign
     1537       v-cli-qnty = trunc( p-cli-qnty, 0 ) .
     1538   end.
     1539      case p-round-m :
     1540             when 'Кол-во_в_коробке':U then do:
     1541              if buf_goods.qnty-cart  <> 0 then do:
     1542                   if ( p-qnty  > 0 and p-qnty <  buf_goods.qnty-cart ) then p-qnty = buf_goods.qnty-cart .
     1543                   assign
     1544                     p-qnty     = round ( p-qnty / buf_goods.qnty-cart, 0 ) *  buf_goods.qnty-cart
     1545                     .
     1546                     if ( p-qnty > 0 and p-qnty <  buf_goods.qnty-cart ) then p-qnty = buf_goods.qnty-cart .
     1547                   assign
     1548                     p-cli-qnty = p-qnty / p-cli-base-rate
     1549                     p-sum-cli  = p-price-cli  * p-cli-qnty
     1550                     p-sum-rubl = p-price-rubl * p-qnty
     1551                     p-sum-base = p-price-base * p-qnty
     1552                   .
     1553                end.
     1554                else do:
     1555                   assign
     1556                     p-qnty     = v-cli-qnty   * p-cli-base-rate
     1557                     p-sum-cli  = p-price-cli  * v-cli-qnty
     1558                     p-sum-rubl = p-price-rubl * p-qnty
     1559                     p-sum-base = p-price-base * p-qnty
     1560                   .
     1561                end.
     1562             end.
     1563             when 'Без-дробных':U then do:
     1564                 if can-find(first buf_units where
     1565                         buf_units.unit-name = p-unit-cli and
     1566                         lookup ('шту':U, buf_units.type) > 0 ) and
     1567                         trunc ( p-cli-qnty, 0 ) <> p-cli-qnty then do:
     1568                         assign
     1569                           p-cli-qnty = trunc( p-cli-qnty, 0 ) + 1
     1570                           p-qnty     = p-cli-qnty   * p-cli-base-rate
     1571                           p-sum-cli  = p-price-cli  * p-cli-qnty
     1572                           p-sum-rubl = p-price-rubl * p-qnty
     1573                           p-sum-base = p-price-base * p-qnty
     1574                         .
     1575                 end.
     1576                 else do:
     1577                         assign
     1578                           p-cli-qnty = round( p-cli-qnty, 0 )
     1579                           p-qnty     = p-cli-qnty   * p-cli-base-rate
     1580                           p-sum-cli  = p-price-cli  * p-cli-qnty
     1581                           p-sum-rubl = p-price-rubl * p-qnty
     1582                           p-sum-base = p-price-base * p-qnty
     1583                         .
     1584                 end.
     1585             end.
     1586             when 'Произвольно':U then do:
     1587               if p-round-base <> 0 then do:
     1588                 assign
     1589                   p-cli-qnty = round ( p-cli-qnty / p-round-base , 0 ) * p-round-base
     1590                 .
     1591               end.
     1592               assign
     1593                   p-qnty     = p-cli-qnty   * p-cli-base-rate
     1594                   p-sum-cli  = p-price-cli  * p-cli-qnty
     1595                   p-sum-rubl = p-price-rubl * p-qnty
     1596                   p-sum-base = p-price-base * p-qnty
     1597                 .
     1598             end.
     1599             when 'Отключено':U or when ""  then do:
     1600               assign
     1601                   p-cli-qnty = v-cli-qnty
     1602                   p-qnty     = p-cli-qnty   * p-cli-base-rate
     1603                   p-sum-cli  = p-price-cli  * p-cli-qnty
     1604                   p-sum-rubl = p-price-rubl * p-qnty
     1605                   p-sum-base = p-price-base * p-qnty
     1606                 .
     1607             end.
     1608      end case.
     1609   if is-log = true then  Output stream stream_order to value ("order_raschet.txt") APPEND .
     1610   if is-log = true then  put stream stream_order unformatted
     1611           " После округления кол-во в баз.ед. изм. : " p-qnty  skip
     1612           " Метод округления :  " p-round-m
     1613             ( if p-round-m = 'Произвольно':U
     1614                 then  string(p-round-base)
     1615                 else  "" )
     1616             ( if p-round-m = 'Кол-во_в_коробке':U
     1617                 then  string(buf_goods.qnty-cart)
     1618                 else  "" ) skip
     1619           "__________________________________________________"     skip  .
     1620   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     1621   v-stroka-protocol = v-stroka-protocol + chr(4) +
     1622                     "18.Метод округления : " +  p-round-m +
     1623                       ( if p-round-m = 'Произвольно':U
     1624                           then  string(p-round-base)
     1625                           else  " " )  +
     1626                       ( if p-round-m = 'Кол-во_в_коробке':U
     1627                           then  string(buf_goods.qnty-cart)
     1628                           else  "" ) + chr(4) +
     1629                     "19.После округления кол-во в баз.ед. изм. : " + string( p-qnty)
     1630                       .
     1631     end.
     1632   end procedure.
     1633   procedure create-protocol :
     1634   define input  parameter p-ord-doc  as character no-undo .
     1635   define input  parameter p-gds-code as integer   no-undo .
     1636   define input  parameter p-date     as date     no-undo .
     1637   define input  parameter p-time     as integer   no-undo .
     1638   define input  parameter p-obj-type as character no-undo .
     1639   define input  parameter p-obj-code as integer   no-undo .
     1640   define input  parameter p-str      as character no-undo .
     1641   define buffer buf_ord-line-attr for ub.ord-line-attr  .
     1642     do
     1643     on error undo, return error return-value
     1644     :
     1645     if p-gds-code = ? or p-gds-code = 0 then return.
     1646     if p-ord-doc = ? or p-ord-doc = ""   then return.
     1647     if p-obj-type = ?  then return.
     1648     if p-obj-code = ?  then return.
     1649     if p-date = ?  then return.
     1650       find first buf_ord-line-attr exclusive-lock where
     1651                 buf_ord-line-attr.doc-code = p-ord-doc  and
     1652                 buf_ord-line-attr.gds-code = p-gds-code and
     1653                 buf_ord-line-attr.attr-code =  "protocol"           + chr(4) +
     1654                                                 p-obj-type          + chr(4) +
     1655                                                 string(p-obj-code)  + chr(4) +
     1656                                                 string(p-date, "99-99-9999" )  + chr(4) +
     1657                                                 string(p-time,"hh:mm:ss"  )
     1658                                                 no-error .
     1659       if not available buf_ord-line-attr then do:
     1660          create buf_ord-line-attr no-error .
     1661       end.
     1662       if available buf_ord-line-attr then do:
     1663       assign
     1664         buf_ord-line-attr.doc-code  = p-ord-doc
     1665         buf_ord-line-attr.gds-code  = p-gds-code
     1666         buf_ord-line-attr.attr-code =  "protocol"           + chr(4) +
     1667                                         p-obj-type          + chr(4) +
     1668                                         string(p-obj-code)  + chr(4) +
     1669                                         string(p-date, "99-99-9999" )  + chr(4) +
     1670                                         string(p-time, "hh:mm:ss"  )
     1671         buf_ord-line-attr.attr-value  = p-str
     1672         no-error
     1673       .
     1674       end.
     1675     end.
     1676   end procedure.
     1677   procedure create-obj-temp :
     1678   define input  parameter p-ord-doc as character no-undo .
     1679   define input  parameter p-gds-code as integer   no-undo .
     1680   define input  parameter p-obj-type as character no-undo .
     1681   define input  parameter p-obj-code as integer   no-undo .
     1682   define input  parameter p-qnty as decimal   no-undo .
     1683   define buffer buf_ord-line-attr for ub.ord-line-attr  .
     1684     do
     1685     on error undo, return error return-value
     1686     :
     1687     if p-gds-code = ? or p-gds-code = 0 then return.
     1688     if p-ord-doc = ? or p-ord-doc = "" then return.
     1689     if p-obj-type = ?  then return.
     1690     if p-obj-code = ?  then return.
     1691       find first buf_ord-line-attr exclusive-lock where
     1692                 buf_ord-line-attr.doc-code = p-ord-doc  and
     1693                 buf_ord-line-attr.gds-code = p-gds-code and
     1694                 buf_ord-line-attr.attr-code =  "objqnty"   + chr(4) +
     1695                                                 p-obj-type + chr(4) +
     1696                                                 string(p-obj-code)  no-error .
     1697       if not available buf_ord-line-attr then do:
     1698          create buf_ord-line-attr no-error .
     1699       end.
     1700       assign
     1701         buf_ord-line-attr.doc-code  = p-ord-doc
     1702         buf_ord-line-attr.gds-code  = p-gds-code
     1703         buf_ord-line-attr.attr-code = "objqnty"  + chr(4) +
     1704                                       p-obj-type + chr(4) +
     1705                                       string(p-obj-code)
     1706         buf_ord-line-attr.attr-value = string( p-qnty )
     1707         no-error
     1708       .
     1709     end.
     1710   end procedure.
     1711   procedure create-min-stock-gds-way :
     1712   define input  parameter p-ord-doc   as character no-undo .
     1713   define input  parameter p-gds-code  as integer   no-undo .
     1714   define input  parameter p-min-stock as decimal   no-undo .
     1715   define input  parameter p-gds-way   as decimal   no-undo .
     1716   define buffer buf_ord-line-attr for ub.ord-line-attr  .
     1717     do
     1718     on error undo, return error return-value
     1719     :
     1720     if p-gds-code = ? or p-gds-code = 0 then return.
     1721     if p-ord-doc  = ? or p-ord-doc = "" then return.
     1722       find first buf_ord-line-attr exclusive-lock where
     1723                 buf_ord-line-attr.doc-code = p-ord-doc  and
     1724                 buf_ord-line-attr.gds-code = p-gds-code and
     1725                 buf_ord-line-attr.attr-code = 'min-stock':U
     1726                                                no-error .
     1727       if not available buf_ord-line-attr then do:
     1728          create buf_ord-line-attr no-error .
     1729       end.
     1730       if available buf_ord-line-attr then do:
     1731       assign
     1732         buf_ord-line-attr.doc-code  = p-ord-doc
     1733         buf_ord-line-attr.gds-code  = p-gds-code
     1734         buf_ord-line-attr.attr-code = 'min-stock':U
     1735         buf_ord-line-attr.attr-value = string (p-min-stock)
     1736         no-error
     1737       .
     1738       end.
     1739       find first buf_ord-line-attr exclusive-lock where
     1740                 buf_ord-line-attr.doc-code = p-ord-doc  and
     1741                 buf_ord-line-attr.gds-code = p-gds-code and
     1742                 buf_ord-line-attr.attr-code = 'gds-way':U
     1743                                                no-error .
     1744       if not available buf_ord-line-attr then do:
     1745          create buf_ord-line-attr no-error .
     1746       end.
     1747       if available buf_ord-line-attr then do:
     1748       assign
     1749         buf_ord-line-attr.doc-code  = p-ord-doc
     1750         buf_ord-line-attr.gds-code  = p-gds-code
     1751         buf_ord-line-attr.attr-code = 'gds-way':U
     1752         buf_ord-line-attr.attr-value = string (p-gds-way)
     1753         no-error
     1754       .
     1755       end.
     1756     end.
     1757   end procedure.
     1758   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1760   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1761   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1762   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1763   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1764   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1765   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1766   procedure uf-name :
     1767     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1768     define output parameter p-use-List_     as logical   no-undo .
     1769     define output parameter p-type-List_     as character no-undo .
     1770     define output parameter p-format-List_   as character no-undo .
     1771     define output parameter p-use-Naim      as logical   no-undo .
     1772     define output parameter p-type-Naim      as character no-undo .
     1773     define output parameter p-format-Naim    as character no-undo .
     1774     define output parameter p-use-print-graft as logical   no-undo .
     1775     define output parameter p-use-sort-gr   as logical   no-undo .
     1776     define output parameter p-use-type-price as logical   no-undo .
     1777     define output parameter p-use-type-val  as logical   no-undo .
     1778     define output parameter p-label          as character no-undo .
     1779     define output parameter p-tooltip        as character no-undo .
     1780     define output parameter p-user-can-edit  as logical   no-undo .
     1781     define output parameter p-output-display as logical   no-undo .
     1782     define output parameter p-other          as character no-undo .
     1783     do
     1784     on error undo, return error
     1785     :
     1786       case p-code :
     1787               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
