     2374         define variable v-i-doc as character no-undo .
     2375   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2376   run proc-ord-code in this-procedure
     2377    (input   'main' ,
     2378     input   v-cntxt-db-num ,
     2379     input   v-cntxt-obj-type ,
     2380     input   v-cntxt-obj-code ,
     2381     input   v-i-doc ,
     2382     output  v#doc-code
     2383    ) .
     2384             assign
     2385               ord-qnty = 0
     2386               ord-sum-cli = 0
     2387               k = 0
     2388               .
     2389             if ik = 1  then assign
     2390                              v#doc-code1 = v#doc-code
     2391                              ik = 0
     2392                              .
     2393         end.
     2394              find first ub.goods where ub.goods.gds-code = tmp#p-zakaz.gds-code no-lock no-error.
     2395              find first ub.gds-obj no-lock where
     2396                         ub.gds-obj.obj-type = store-type and
     2397                         ub.gds-obj.obj-code = store-code and
     2398                         ub.gds-obj.gds-code = tmp#p-zakaz.gds-code
     2399                         no-error.
     2400              v-e-m = ''.
     2401              if available ub.goods then do :
     2402                   assign
     2403                     k = k + 1
     2404                   .
     2405                     for each tmp#objqnty where
     2406                              tmp#objqnty.gds-code = tmp#p-zakaz.gds-code and
     2407                              tmp#objqnty.cli-type = tmp#p-zakaz.cli-type and
     2408                              tmp#objqnty.cli-code = string(tmp#p-zakaz.cli-code)
     2409                              :
     2410                               assign
     2411                                 v-obj-type = entry(1,tmp#objqnty.obj ,' ')
     2412                                 v-obj-code = integer(entry(2,tmp#objqnty.obj ,' '))
     2413                                 v-e-m = 'Импорт с объектами'
     2414                               .
     2415                               if lookup( tmp#objqnty.obj + ',' , v-spis ) = 0 then
     2416                                  v-spis = trim( v-spis ) + tmp#objqnty.obj + ','.
     2417                               run create-obj-temp (
     2418                                   v#doc-code           ,
     2419                                   tmp#objqnty.gds-code ,
     2420                                   v-obj-type ,
     2421                                   v-obj-code ,
     2422                                   decimal(tmp#objqnty.qnty)
     2423                                   ) .
     2424                   end.
     2425                   find first bf-units-cli where bf-units-cli.unit-name = ub.goods.unit-cli no-lock no-error.
     2426                   create shar_ord-line no-error.
     2427                   assign
     2428                     shar_ord-line.doc-code    = v#doc-code
     2429                     shar_ord-line.prod-type   = ub.goods.prod-type
     2430                     shar_ord-line.prod-code   = ub.goods.prod-code
     2431                     shar_ord-line.artic       = ub.goods.artic
     2432                     shar_ord-line.gds-code    = ub.goods.gds-code
     2433                     shar_ord-line.cli-art     = tmp#p-zakaz.cli-art
     2434                     shar_ord-line.qnty        = tmp#p-zakaz.qnty
     2435                     shar_ord-line.order-qnty  = tmp#p-zakaz.qnty
     2436                     shar_ord-line.initial-qnty = tmp#p-zakaz.qnty
     2437                     shar_ord-line.cli-qnty    = ( if lookup('шту':U, bf-units-cli.type) > 0
     2438                       and  trunc (tmp#p-zakaz.qnty / ub.goods.cli-base-rate, 0) <> tmp#p-zakaz.qnty / ub.goods.cli-base-rate
     2439                       then trunc (tmp#p-zakaz.qnty / ub.goods.cli-base-rate, 0)
     2440                       else tmp#p-zakaz.qnty / ub.goods.cli-base-rate )
     2441                     shar_ord-line.price-cli   = tmp#p-zakaz.price-cli * ub.goods.cli-base-rate
     2442                     shar_ord-line.sum-cli     = shar_ord-line.price-cli * shar_ord-line.cli-qnty
     2443                     shar_ord-line.price-rubl  = tmp#p-zakaz.price-cli
     2444                     shar_ord-line.price-base  = ( tmp#p-zakaz.price-cli ) / v-base-rate * v-base-scale
     2445                     shar_ord-line.sum-rubl    = shar_ord-line.price-rubl * shar_ord-line.qnty
     2446                     shar_ord-line.sum-base    = shar_ord-line.price-base * shar_ord-line.qnty
     2447                     shar_ord-line.unit-cli    = ub.goods.unit-cli
     2448                     shar_ord-line.line-num    = k
     2449                     .
     2450                   assign
     2451                     ord-qnty    = ord-qnty + tmp#p-zakaz.qnty
     2452                     ord-sum-cli = ord-sum-cli + ( shar_ord-line.cli-qnty * shar_ord-line.price-cli )
     2453                     v-pcvat = 0
     2454                     .
     2455                       for each buf_cli-gds no-lock  where
     2456                                buf_cli-gds.artic         = ub.goods.artic      and
     2457                                buf_cli-gds.prod-code     = ub.goods.prod-code  and
     2458                                buf_cli-gds.prod-type     = ub.goods.prod-type  and
     2459                                buf_cli-gds.host-code     = g#host-code   ,
     2460                         first buf_clients no-lock where
     2461                               buf_clients.obj-type = buf_cli-gds.cli-type and
     2462                               buf_clients.obj-code = buf_cli-gds.cli-code  ,
     2463                         first buf_doc-line no-lock where
     2464                               buf_doc-line.doc-code   = buf_cli-gds.in-code and
     2465                               buf_doc-line.artic      = buf_cli-gds.artic and
     2466                               buf_doc-line.prod-type  = buf_cli-gds.prod-type and
     2467                               buf_doc-line.prod-code  = buf_cli-gds.prod-code
     2468                               :
     2469                            v-pcvat = buf_doc-line.vat-pc.
     2470                       end.
     2471                      assign
     2472                        shar_ord-line.vat-pc  = v-pcvat
     2473                      .
     2474              end.
     2475       if last-of(tmp#p-zakaz.cli-code) then do:
     2476             find first for-cli no-lock where
     2477                        for-cli.obj-type = tmp#p-zakaz.cli-type and
     2478                        for-cli.obj-code = tmp#p-zakaz.cli-code
     2479                        no-error.
     2480                 if not available for-cli then do:
     2481                    message "В таблице для импорта не верно задано значение Поставщика "
     2482                     tmp#p-zakaz.cli-type
     2483                     tmp#p-zakaz.cli-code
     2484                     view-as alert-box error .
     2485                   next.
     2486                 end.
     2487             run waitfram-show in this-procedure ("Создается заказ № " + string(v#doc-code) + " для " + for-cli.obj-name ).
     2488             kol-z = kol-z + 1.
     2489             if v-e-m <> "" then do:
     2490                 v-e-m = trim(v-e-m) + ' :&' + trim (v-spis) .
     2491             end.
     2492             create shar_ord-doc.
     2493             assign
     2494                 shar_ord-doc.doc-code     = v#doc-code
     2495                 shar_ord-doc.doc-date     = to-day
     2496                 shar_ord-doc.cli-code     = for-cli.obj-code
     2497                 shar_ord-doc.cli-name     = for-cli.obj-name
     2498                 shar_ord-doc.cli-type     = for-cli.obj-type
     2499                 shar_ord-doc.creid        = v-cntxt-userid
     2500                 shar_ord-doc.agnt         = ?
     2501                 shar_ord-doc.boss         = ?
     2502                 shar_ord-doc.fact-date    = ?
     2503                 shar_ord-doc.pay-code     = g#out-pay
     2504                 shar_ord-doc.ship-date    = l-date
     2505                 shar_ord-doc.sum-service  = 0
     2506                 shar_ord-doc.sum-ship     = 0
     2507                 shar_ord-doc.flag_        = false
     2508                 shar_ord-doc.status_      = 'новый':U
     2509                 shar_ord-doc.wrkr         = ?
     2510                 shar_ord-doc.host-code    = g#host-code
     2511                 shar_ord-doc.doc-type     = p-type-ord
     2512                 shar_ord-doc.tot-lines    = k
     2513                 shar_ord-doc.order-type   = 0
     2514                 shar_ord-doc.cycle-day    = 0
     2515                 shar_ord-doc.start-date   = l-date-1
     2516                 shar_ord-doc.end-date     = l-date-2
     2517                 shar_ord-doc.date-sale-1  = l-date-1
     2518                 shar_ord-doc.date-sale-2  = l-date-2
     2519                 shar_ord-doc.pay-day      = var-l-pay-day
     2520                 shar_ord-doc.obj-code     = store-code
     2521                 shar_ord-doc.obj-type     = store-type
     2522                 shar_ord-doc.slt-type     = 'без':U
     2523                 shar_ord-doc.vat-type     = 'в т. ч.':U
     2524                 shar_ord-doc.exch-code    = 0
     2525                 shar_ord-doc.exch-date    = to-day
     2526                 shar_ord-doc.e-method     = v-e-m
     2527                 .
     2528               find ub.currency where ub.currency.curr-code = 0 no-lock no-error.
     2529               find last ub.curr-accnt where ub.curr-accnt.curr-code = ub.currency.curr-code  use-index pi no-lock no-error.
     2530                 if available ub.curr-accnt then
     2531                    assign
     2532                       shar_ord-doc.exch-rate  = ub.curr-accnt.exch-rate
     2533                       shar_ord-doc.exch-scale = ub.curr-accnt.exch-scale
     2534                    .
     2535   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     2537     (input  g#host-code
     2538     ,input  to-day
     2539     ,output shar_ord-doc.base-rate
     2540     ,output shar_ord-doc.base-scale
     2541     )  .
     2542       end.
     2543     end.
     2544     run waitfram-hide in this-procedure .
     2545     if kol-z > 0 then
     2546         message   "Импорт завершен !" skip
     2547                   "Сформировано " kol-z " заказов с № " v#doc-code1 " по № " v#doc-code
     2548                   view-as alert-box information title "Внимание !"
     2549                   .
     2550     else
     2551         message   "Импорт завершен !" skip
     2552                   "Сформировано " kol-z " заказов "
     2553                   view-as alert-box information title "Внимание !"
     2554                   .
     2555   end procedure.
     2556   procedure init-p :
     2557   do
     2558   on error undo, return error return-value
     2559   :
     2560   run uf-get in this-procedure (
     2561        input  'seqeallo':U
     2562       ,input  'adm'
     2563       ,output v-uf-List_
     2564       ,output v-uf-Naim
     2565       ,output v-uf-print-graft
     2566       ,output v-uf-sort-gr
     2567       ,output v-uf-type-price
     2568       ,output v-uf-type-val
     2569   )  no-error.
     2570   define variable iv as integer   no-undo .
     2571   define variable i-kol as integer   no-undo .
     2572   define variable st as character no-undo .
     2573       if v-uf-List_ <> "" then do:
     2574       i-kol = num-entries (v-uf-List_, chr(4)) .
     2575           repeat Iv = 1 to i-kol :
     2576             st = entry(Iv,v-uf-List_, chr(4)).
     2577             create tt-table.
     2578             assign
     2579               tt-table.id = integer(entry(1, st))
     2580               tt-table.new-id = integer(entry(2, st))
     2581             .
     2582           end.
     2583       end.
     2584       else do:
     2585           repeat Iv = 1 to 33 :
     2586             create tt-table.
     2587             assign
     2588               tt-table.id = iv
     2589               tt-table.new-id = iv
     2590             .
     2591           end.
     2592       end.
     2593   assign
     2594    col-gds-code     = new-n (1)
     2595    col-typecode-obj = new-n (22)
     2596    col-zakz-qnty    = new-n (25)
     2597    col-price        = new-n (27)
     2598    col-cli-type     = new-n (28)
     2599    col-cli-code     = new-n (29)
     2600    col-cli-art      = new-n (30)
     2601    col-choice       = new-n (31)
     2602   .
     2603   end.
     2604   end procedure.
