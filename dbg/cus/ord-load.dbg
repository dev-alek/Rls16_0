      819   define variable v-waitfram-action01         as character   no-undo .
      820   define variable v-waitfram-action02         as character   no-undo .
      821   define variable v-waitfram-action03         as character   no-undo .
      822   define variable mWaitFramTextBeg            as character   no-undo.
      823   define variable mWaitFramTextEnd            as character   no-undo.
      824   define variable mWaitFramView               as logical     no-undo.
      825   define variable mWaitProcEvent              as logical     no-undo init yes.
      826   define variable mWaitFramInterval           as integer     no-undo init 1 .
      827   define variable mWaitFramStop               as logical     no-undo.
      828   define variable mWaitFramStopUser           as logical     no-undo.
      829   define variable mWaitFramStopTimeOut        as logical     no-undo.
      830   define variable mWaitFramStartProc          as datetime-tz no-undo.
      831   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      832   define button B-WaitFramStop auto-end-key
      833        label "Стоп"
      834        size 10 by 1 tooltip "Остоновить процесс".
      835   define button B-viewProcInfo
      836        label "Информация"
      837        size 15 by 1 tooltip "Информация о процесс".
      838   define frame waitfram
      839     v-waitfram-action01 format "x(72)" no-label skip
      840     v-waitfram-action02 format "x(72)" no-label skip
      841     v-waitfram-action03 format "x(72)" no-label skip
      842     B-viewProcInfo
      843     B-WaitFramStop at row 4 col 30
      844     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      845     .
      846   define new global shared variable mBatchMode as logical no-undo init ?.
      847   define variable mFramBachModHandle as handle no-undo.
      848   mFramBachModHandle = frame waitfram:handle.
      849   define variable mFameOldVis as logical no-undo.
      850   define variable mVisCUrentVin as logical no-undo.
      851   if session:batch-mode
      852   then
      853      mBatchMode = yes.
      854   if mBatchMode = ? then do:
      855     mVisCUrentVin = current-window:visible.
      856     mFameOldVis = mFramBachModHandle:visible.
      857     mFramBachModHandle:visible  = yes.
      858     mBatchMode = mFramBachModHandle:visible ne yes.
      859     mFramBachModHandle:visible = mFameOldVis.
      860     current-window:visible = mVisCUrentVin.
      861   end.
      862    if  log-manager:logfile-name ne ?
      863     then DO:
      864         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      865         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      866         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      867     end.
      868   on choose of B-WaitFramStop in frame waitfram
      869   do:
      870     mWaitFramStop = yes.
      871     mWaitFramStopUser = yes.
      872   end.
      873   function waitfram-check-timeout returns logical():
      874      define variable vtime as int64 no-undo.
      875      if mWaitFramStopTimeOut
      876      then
      877         return yes.
      878      vtime = ( now - mWaitFramStartProc ) / 1000 .
      879      if     mWaitFramTimeOut ne ?
      880         and mWaitFramTimeOut ne 0
      881         and mWaitFramTimeOut lt vtime
      882      then do:
      883         mWaitFramStopTimeOut = yes.
      884      end.
      885      return mWaitFramStopTimeOut.
      886   end.
      887   procedure waitfram-hide :
      888     if not session:batch-mode
      889     then do
      890     on error undo, return error return-value
      891     :
      892       pause 0 before-hide .
      893       if not mBatchMode then
      894         hide frame waitfram .
      895     end.
      896   end procedure.
      897   procedure waitfram-show :
      898     define input  parameter p-message as character no-undo .
      899     define variable v-left-margin as integer   no-undo .
      900     if not session:batch-mode
      901     then do
      902     on error undo, return error return-value
      903     :
      904       if length(p-message) <= 70 then do:
      905         assign
      906           v-left-margin = integer((70 - length(p-message)) / 2)
      907         .
      908         assign
      909           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      910         .
      911         assign
      912           v-waitfram-action01 = " "
      913           v-waitfram-action02 = " "
      914                                    + fill(" ", v-left-margin)
      915                                    + p-message
      916           v-waitfram-action03 = " "
      917         .
      918       end.
      919       else do:
      920         define variable vRindex1 as integer no-undo.
      921         define variable vRindex2 as integer no-undo.
      922         vRindex1 = r-index(p-message," ",70).
      923         if vRindex1 = 0
      924         then
      925            vRindex1 = 70.
      926         if length(p-message)  <= vRindex1 + 70 then do:
      927           assign
      928             v-waitfram-action01 = " "
      929             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      930             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      931           .
      932         end.
      933         else do:
      934           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      935           if vRindex2 <= vRindex1
      936           then
      937              vRindex2 = vRindex1 + 70.
      938           assign
      939             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      940             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      941             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      942           .
      943         end.
      944       end.
      945       B-viewProcInfo:visible   in frame waitfram = no.
      946       B-viewProcInfo:sensitive in frame waitfram = no.
      947       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      948       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      949       if  (   mWaitFramView
      950          or  mWaitProcEvent)
      951          and not mBatchMode
      952       then
      953          display
      954             v-waitfram-action01 skip
      955             v-waitfram-action02 skip
      956             v-waitfram-action03 skip
      957          with frame waitfram .
      958     end.
      959   end procedure.
      960      procedure waitfram-show-this:
      961         define input  parameter iInterval as int64 no-undo.
      962         define variable vtime as int64 no-undo.
      963         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      964         mWaitFramInterval = iInterval.
      965         run waitfram-show (substitute("&1&2 &3&4" ,
      966                                       mWaitFramTextBeg ,
      967                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      968                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      969                                       mWaitFramTextEnd
      970                                      )
      971                           ).
      972      end.
      973      procedure WaitFramRunPause:
      974         define input  parameter iInterval as dec no-undo.
      975         define variable vStart  as datetime-tz no-undo.
      976         define variable vend    as datetime-tz no-undo.
      977         define variable vint as int64 no-undo.
      978         define variable vOk as logical no-undo.
      979         vStart = now.
      980         vend   = vStart.
      981         publish "WaitFramPause" (iInterval,output vOk).
      982         vend   =  now.
      983         vint = vend - vStart.
      984         vint = iInterval - vint / 1000.
      985         if     not mWaitFramStop
      986            and (   vint > 0
      987                 or (    not vOk
      988                     and iInterval eq ?
      989                     )
      990                 )
      991         then
      992            run waitfram-show-this (iInterval).
      993         vend   =  now.
      994         vint = vend - vStart.
      995         vint = iInterval - vint / 1000.
      996         if     not mWaitFramStop
      997            and vint > 0
      998         then do:
      999            run gbl/pause.p (vint * 1000).
     1000         end.
     1001         if iInterval ne ?
     1002         then
     1003            publish "WaitFramStop".
     1004         waitfram-check-timeout().
     1005      end.
     1006      procedure WaitFramWaitFor:
     1007         define input  parameter iInterval as dec no-undo.
     1008         assign
     1009            mWaitFramStartProc   = now
     1010            mWaitFramStopUser    = no
     1011            mWaitFramStopTimeOut = no
     1012         .
     1013         block-wait:
     1014         do while not mWaitFramStop:
     1015            run WaitFramRunPause (iInterval).
     1016            if  waitfram-check-timeout()
     1017            then do:
     1018               leave block-wait.
     1019            end.
     1020         end.
     1021         run waitfram-hide.
     1022      end.
     1023   procedure waitfram-join :
     1024     define input  parameter p-line-1  as character no-undo .
     1025     define input  parameter p-line-2  as character no-undo .
     1026     define input  parameter p-line-3  as character no-undo .
     1027     define output parameter p-message as character no-undo .
     1028     do
     1029     on error undo, return error return-value
     1030     :
     1031       assign
     1032         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1033                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1034                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1035       .
     1036     end.
     1037   end procedure.
     1038   function waitfram-join-function returns character
     1039     (input p-line-1 as character
     1040     ,input p-line-2 as character
     1041     ,input p-line-3 as character
     1042     ).
     1043     define variable v-message as character no-undo .
     1044     run waitfram-join in this-procedure
     1045       (input  p-line-1
     1046       ,input  p-line-2
     1047       ,input  p-line-3
     1048       ,output v-message
     1049       ) .
     1050     return v-message .
     1051   end function .
     1052   procedure proc-alt-shift-f2:
     1053     if not ibs.th.gbl.gbl-var:rcode
     1054   then
     1055     run gbl\inidebug.p .
     1056   end.
     1057   procedure proc-alt-shift-f3:
     1058     run gbl/prvssinf.p
     1059       ( input this-procedure
     1060       ) .
     1061   end.
     1062   define variable v-inform-launched as logical no-undo initial false .
     1063   procedure proc-alt-shift-f4:
     1064     define variable v-action as character no-undo .
     1065     if v-inform-launched = false then do:
     1066       assign
     1067         v-inform-launched = true
     1068       .
     1069       run gbl/d-inform.w
     1070         (  input self
     1071         ,  input this-procedure
     1072         , output v-action
     1073         ) no-error .
     1074       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1075       assign
     1076         v-inform-launched = false
     1077       .
     1078     end.
     1079   end.
     1080   procedure proc-alt-f1:
     1081     run gbl/corrhelp.p
     1082       (input this-procedure
     1083       ) .
     1084   end .
     1085   on alt-shift-f2 anywhere do:
     1086     run proc-alt-shift-f2.
     1087   end.
     1088   on alt-shift-f3 anywhere do:
     1089     run proc-alt-shift-f3 in this-procedure .
     1090   end.
     1091   on alt-shift-f4 anywhere do:
     1092     run proc-alt-shift-f4 in this-procedure.
     1093   end.
     1094   on alt-f1 anywhere do:
     1095     run proc-alt-f1 in this-procedure .
     1096   end.
     1097   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098     define variable v-cntxt-db-num        as integer   no-undo .
     1099     define variable v-cntxt-userid        as character no-undo .
     1100     define variable v-cntxt-level         as character no-undo .
     1101     define variable v-cntxt-host-code-obj as integer   no-undo .
     1102     define variable v-cntxt-obj-type      as character no-undo .
     1103     define variable v-cntxt-obj-code      as integer   no-undo .
     1104     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1105     define variable v-cntxt-is-admin      as logical   no-undo .
     1106   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1107   procedure proc-ord-code :
     1108   define input  parameter  p-type as character no-undo .
     1109   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1110   define input  parameter  v-cntxt-obj-type as character no-undo .
     1111   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1112   define input  parameter  p-i-doc    as character no-undo .
     1113   define output parameter  p-ord-doc  as character no-undo .
     1114   define variable          v-idop     as character no-undo .
     1115     do
     1116     on error undo, return error return-value
     1117     :
     1118   case p-type :
     1119       when "main-no-ver" then do:
     1120         if  (v-cntxt-db-num <> 0) then
     1121           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1122         else
     1123           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1124       end.
     1125       when "main" then do:
     1126             do while true:
     1127             if  (v-cntxt-db-num <> 0) then
     1128               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1129             else
     1130               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1131             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1132             End.
     1133       end.
     1134       when "chip" then do:
     1135         assign
     1136           v-idop = p-i-doc .
     1137         do while true :
     1138           if index (v-idop , ".") = 0 then
     1139             v-idop  = replace (v-idop , "-", "-1.").
     1140           else
     1141             v-idop  =
     1142             substring (v-idop , 1, index (v-idop, "-")) +
     1143             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1144             substring (v-idop, index (v-idop, ".")).
     1145           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1146         end.
     1147         assign
     1148           p-ord-doc = v-idop.
     1149       end.
     1150   end case.
     1151     end.
     1152   end procedure.
     1153   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
