     1862   end procedure.
     1863   procedure uf-get :
     1864     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1865     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1866     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1867     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1868     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1869     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1870     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1871     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1872     do
     1873     on error undo, return error
     1874     :
     1875       define buffer buf_usr-flt for ubflt.usr-flt .
     1876       define variable v-use-List_     as logical   no-undo .
     1877       define variable v-type-List_     as character no-undo .
     1878       define variable v-format-List_   as character no-undo .
     1879       define variable v-use-Naim      as logical   no-undo .
     1880       define variable v-type-Naim      as character no-undo .
     1881       define variable v-format-Naim    as character no-undo .
     1882       define variable v-use-print-graft as logical   no-undo .
     1883       define variable v-use-sort-gr     as logical   no-undo .
     1884       define variable v-use-type-price  as logical   no-undo .
     1885       define variable v-use-type-val    as logical   no-undo .
     1886       define variable v-label          as character no-undo .
     1887       define variable v-tooltip        as character no-undo .
     1888       define variable v-user-can-edit  as logical   no-undo .
     1889       define variable v-output-display as logical   no-undo .
     1890       define variable v-other          as character no-undo .
     1891       run uf-name in this-procedure
     1892          (input  entry(1, p-code, chr(4))
     1893         ,output v-use-List_
     1894         ,output v-type-List_
     1895         ,output v-format-List_
     1896         ,output v-use-Naim
     1897         ,output v-type-Naim
     1898         ,output v-format-Naim
     1899         ,output v-use-print-graft
     1900         ,output v-use-sort-gr
     1901         ,output v-use-type-price
     1902         ,output v-use-type-val
     1903         ,output v-label
     1904         ,output v-tooltip
     1905         ,output v-user-can-edit
     1906         ,output v-output-display
     1907         ,output v-other
     1908         ) no-error .
     1909       if error-status :error then do:
     1910         undo, return error return-value .
     1911       end.
     1912       find first buf_usr-flt no-lock where
     1913                  buf_usr-flt.Call-point     = p-code AND
     1914                  buf_usr-flt.user-name       = p-user-name
     1915         no-error .
     1916       if avail buf_usr-flt then do:
     1917         assign
     1918         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1919         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1920         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1921         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1922         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1923         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1924         .
     1925       end.
     1926       else do:
     1927         assign
     1928         p-List_        = (if v-use-List_       then "":U                    else ?)
     1929         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1930         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1931         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1932         p-type-price   = (if v-use-type-price  then no                      else ?)
     1933         p-type-val     = (if v-use-List_       then no                      else ?)
     1934         .
     1935       end.
     1936     end.
     1937   end procedure.
     1938   procedure uf-set :
     1939     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1940     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1941     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1942     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1943     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1944     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1945     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1946     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1947     do
     1948     on error undo, return error
     1949     :
     1950       define buffer buf_usr-flt for ubflt.usr-flt .
     1951       define variable v-use-List_     as logical   no-undo .
     1952       define variable v-type-List_     as character no-undo .
     1953       define variable v-format-List_   as character no-undo .
     1954       define variable v-use-Naim      as logical   no-undo .
     1955       define variable v-type-Naim      as character no-undo .
     1956       define variable v-format-Naim    as character no-undo .
     1957       define variable v-use-print-graft as logical   no-undo .
     1958       define variable v-use-sort-gr   as logical   no-undo .
     1959       define variable v-use-type-price as logical   no-undo .
     1960       define variable v-use-type-val  as logical   no-undo .
     1961       define variable v-tooltip        as character no-undo .
     1962       define variable v-label          as character no-undo .
     1963       define variable v-user-can-edit  as logical   no-undo .
     1964       define variable v-output-display as logical   no-undo .
     1965       define variable v-other          as character no-undo .
     1966       run uf-name in this-procedure
     1967         (input  entry(1, p-code, chr(4))
     1968         ,output v-use-List_
     1969         ,output v-type-List_
     1970         ,output v-format-List_
     1971         ,output v-use-Naim
     1972         ,output v-type-Naim
     1973         ,output v-format-Naim
     1974         ,output v-use-print-graft
     1975         ,output v-use-sort-gr
     1976         ,output v-use-type-price
     1977         ,output v-use-type-val
     1978         ,output v-label
     1979         ,output v-tooltip
     1980         ,output v-user-can-edit
     1981         ,output v-output-display
     1982         ,output v-other
     1983         ) no-error .
     1984       if error-status :error then do:
     1985         undo, return error return-value .
     1986       end.
     1987       find first buf_usr-flt where
     1988                  buf_usr-flt.Call-point     = p-code AND
     1989                  buf_usr-flt.user-name       = p-user-name
     1990         no-error .
     1991       if not avail buf_usr-flt then do:
     1992           create buf_usr-flt .
     1993           assign
     1994           buf_usr-flt.call-point = p-code
     1995           buf_usr-flt.user-name  = p-user-name
     1996           .
     1997       end.
     1998       if avail buf_usr-flt then do:
     1999        assign
     2000        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2001        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2002        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2003        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2004        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2005        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2006       .
     2007       release buf_usr-flt.
     2008       end.
     2009       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2010     end.
     2011   end procedure.
     2012   define temp-table temp-err no-undo  LIKE ub.rep-line
