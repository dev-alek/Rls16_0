     1193   procedure thbjattr_code_reg :
     1194   define input  parameter p-upper-code     as character no-undo .
     1195   define input  parameter p-code           as character no-undo .
     1196   define output parameter p-label          as character no-undo .
     1197   define output parameter p-user-can-edit  as logical   no-undo .
     1198   define output parameter p-output-display as logical   no-undo .
     1199   define output parameter p-other          as character no-undo .
     1200   define output parameter p-prop-list      as character no-undo .
     1201   define output parameter p-prop-type-list as character no-undo .
     1202   define output parameter p-prop-label-list as character no-undo .
     1203   define output parameter p-global          as logical no-undo .
     1204   define output parameter p-host           as logical no-undo .
     1205   define output parameter p-shop           as logical no-undo .
     1206   define output parameter p-store          as logical no-undo .
     1207   define output parameter p-db             as logical no-undo .
     1208   define output parameter p-region         as logical no-undo .
     1209   do
     1210   on error undo, return error return-value
     1211   :
     1212       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1213       (input  p-upper-code
     1214       ,input  p-code
     1215       ,output p-label
     1216       ,output p-user-can-edit
     1217       ,output p-output-display
     1218       ,output p-other
     1219       ,output p-prop-list
     1220       ,output p-prop-type-list
     1221       ,output p-prop-label-list
     1222       ,output p-global
     1223       ,output p-host
     1224       ,output p-shop
     1225       ,output p-store
     1226       ,output p-db
     1227       ,output p-region
     1228       ) no-error .
     1229     if error-status :error
     1230     then do:
     1231       undo, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1)).
     1232     end.
     1233   end.
     1234   end procedure.
