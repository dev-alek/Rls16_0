     1393   do
     1394   on error undo, return error return-value
     1395   :
     1396       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
     1397       (input  p-obj-type
     1398       ,input  p-obj-code
     1399       ,input  p-upper-code
     1400       ,input  p-code
     1401       ,output p-deleted
     1402       ) no-error .
     1403     if error-status :error
     1404     then do:
     1405       undo, return error return-value .
     1406     end.
     1407   end.
     1408   end procedure.
     1409   procedure thbjattr_delete-section :
