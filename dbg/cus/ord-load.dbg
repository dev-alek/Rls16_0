     2033   procedure creat-tt :
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037       define input  parameter p-gds-code as integer   no-undo .
     2038       define input  parameter p-str as character no-undo .
     2039       find first temp-err where
     2040                  temp-err.gds-code = p-gds-code no-error .
     2041                  if available temp-err then return .
     2042       if p-str  <> "" then do:
     2043          create temp-err.
     2044          assign
     2045            temp-err.gds-code = p-gds-code
     2046            temp-err.str = p-str
     2047        .
     2048       end.
     2049     end.
     2050   end procedure.
