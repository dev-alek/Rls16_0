     2342                          .
     2343                       end.
     2344               end.
     2345           end.
     2346    end.
     2347   if v-erase = true then do:
     2348         run view-exept-gds (substitute("Есть товары, не добавленные в заказ !&1Просмотреть список ?", chr(10))) . .
     2349   end.
