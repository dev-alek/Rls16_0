      385   define  variable garbcoll_ii as integer no-undo .
      386   define  temp-table temp-gc no-undo
      387   field ii as integer
      388   field obj-r as handle
      389   field cn as character
      390   index pi is unique primary
      391   ii
      392   index icn
      393   cn.
      394   procedure garbcoll_create-gc-entry :
      395   define input parameter p-cn as character no-undo .
      396   define input parameter p-obj-r as handle no-undo .
      397     do
      398     on error undo, return error
      399     :
      400       create temp-gc.
      401       assign
      402       temp-gc.ii = garbcoll_ii
      403       garbcoll_ii = garbcoll_ii + 1
      404       temp-gc.cn = p-cn
      405       temp-gc.obj-r = p-obj-r
      406       .
      407     end.
      408   end procedure.
      409   procedure garbcoll_clear :
      410     do
      411     on error undo, return error
      412     :
      413       for each temp-gc:
      414         delete object temp-gc.obj-r.
      415         delete temp-gc.
      416       end.
      417     end.
      418   end procedure.
