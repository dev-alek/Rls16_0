       48   function context_begin-esys-command return logical
       49   (
       50       input p-esys-id-list as character
       51      ,input-output p-esys-cmd-proc-handle as handle
       52      ,output p-esys-cmd-code as integer
       53   ):
       54      if not valid-handle(p-esys-cmd-proc-handle )
       55      then do:
       56        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
       57        if error-status :error
       58        then do:
       59           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
       60                                              "&5&4&6"
       61                                              ,vss-workfile
       62                                              ,vss-revision
       63                                              ,vss-description
       64                                              ,chr(10)
       65                                              ,error-status:get-message(1)
       66                                              ,return-value )).
       67        end.
       68        run begin-create-command in p-esys-cmd-proc-handle
       69          (input 'cmd-esys-general':U
       70          ,input p-esys-id-list
       71          ,output p-esys-cmd-code
       72          ) no-error.
       73        if error-status :error
       74        then do:
       75          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
       76                                                           , 'cmd-esys-general':U
       77                                                           , error-status:get-message(1)
       78                                                           , return-value
       79                                                           )).
       80          return no .
       81        end.
       82        return yes.
       83      end.
       84   end.
