      999   define variable mWaitFramTextEnd            as character   no-undo.
     1000   define variable mWaitFramView               as logical     no-undo.
     1001   define variable mWaitProcEvent              as logical     no-undo init yes.
     1002   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1003   define variable mWaitFramStop               as logical     no-undo.
     1004   define variable mWaitFramStopUser           as logical     no-undo.
     1005   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1006   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1007   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1008   define button B-WaitFramStop auto-end-key
     1009        label "Стоп"
     1010        size 10 by 1 tooltip "Остоновить процесс".
     1011   define button B-viewProcInfo
     1012        label "Информация"
     1013        size 15 by 1 tooltip "Информация о процесс".
     1014   define frame waitfram
     1015     v-waitfram-action01 format "x(72)" no-label skip
     1016     v-waitfram-action02 format "x(72)" no-label skip
     1017     v-waitfram-action03 format "x(72)" no-label skip
     1018     B-viewProcInfo
     1019     B-WaitFramStop at row 4 col 30
     1020     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1021     .
     1022   define new global shared variable mBatchMode as logical no-undo init ?.
     1023   define variable mFramBachModHandle as handle no-undo.
     1024   mFramBachModHandle = frame waitfram:handle.
     1025   define variable mFameOldVis as logical no-undo.
     1026   define variable mVisCUrentVin as logical no-undo.
     1027   if session:batch-mode
     1028   then
     1029      mBatchMode = yes.
     1030   if mBatchMode = ? then do:
     1031     mVisCUrentVin = current-window:visible.
     1032     mFameOldVis = mFramBachModHandle:visible.
     1033     mFramBachModHandle:visible  = yes.
     1034     mBatchMode = mFramBachModHandle:visible ne yes.
     1035     mFramBachModHandle:visible = mFameOldVis.
     1036     current-window:visible = mVisCUrentVin.
     1037   end.
     1038    if  log-manager:logfile-name ne ?
     1039     then DO:
     1040         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1041         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1042         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1043     end.
     1044   on choose of B-WaitFramStop in frame waitfram
     1045   do:
     1046     mWaitFramStop = yes.
     1047     mWaitFramStopUser = yes.
     1048   end.
     1049   function waitfram-check-timeout returns logical():
     1050      define variable vtime as int64 no-undo.
     1051      if mWaitFramStopTimeOut
     1052      then
     1053         return yes.
     1054      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1055      if     mWaitFramTimeOut ne ?
     1056         and mWaitFramTimeOut ne 0
     1057         and mWaitFramTimeOut lt vtime
     1058      then do:
     1059         mWaitFramStopTimeOut = yes.
     1060      end.
     1061      return mWaitFramStopTimeOut.
     1062   end.
     1063   procedure waitfram-hide :
     1064     if not session:batch-mode
     1065     then do
     1066     on error undo, return error return-value
     1067     :
     1068       pause 0 before-hide .
     1069       if not mBatchMode then
     1070         hide frame waitfram .
     1071     if     not mWaitFramView
     1072        and mWaitProcEvent
     1073     then
     1074       process events .
     1075     end.
     1076   end procedure.
     1077   procedure waitfram-show :
     1078     define input  parameter p-message as character no-undo .
     1079     define variable v-left-margin as integer   no-undo .
     1080     if not session:batch-mode
     1081     then do
     1082     on error undo, return error return-value
     1083     :
     1084       if length(p-message) <= 70 then do:
     1085         assign
     1086           v-left-margin = integer((70 - length(p-message)) / 2)
     1087         .
     1088         assign
     1089           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1090         .
     1091         assign
     1092           v-waitfram-action01 = " "
     1093           v-waitfram-action02 = " "
     1094                                    + fill(" ", v-left-margin)
     1095                                    + p-message
     1096           v-waitfram-action03 = " "
     1097         .
     1098       end.
     1099       else do:
     1100         define variable vRindex1 as integer no-undo.
     1101         define variable vRindex2 as integer no-undo.
     1102         vRindex1 = r-index(p-message," ",70).
     1103         if vRindex1 = 0
     1104         then
     1105            vRindex1 = 70.
     1106         if length(p-message)  <= vRindex1 + 70 then do:
     1107           assign
     1108             v-waitfram-action01 = " "
     1109             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1110             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1111           .
     1112         end.
     1113         else do:
     1114           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1115           if vRindex2 <= vRindex1
     1116           then
     1117              vRindex2 = vRindex1 + 70.
     1118           assign
     1119             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1120             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1121             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1122           .
     1123         end.
     1124       end.
     1125       B-viewProcInfo:visible   in frame waitfram = no.
     1126       B-viewProcInfo:sensitive in frame waitfram = no.
     1127       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1128       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1129       if  (   mWaitFramView
     1130          or  mWaitProcEvent)
     1131          and not mBatchMode
     1132       then
     1133          display
     1134             v-waitfram-action01 skip
     1135             v-waitfram-action02 skip
     1136             v-waitfram-action03 skip
     1137          with frame waitfram .
     1138       if     mWaitFramView
     1139          then do:
     1140             if     mWaitFramInterval ne ?
     1141                and not mBatchMode
     1142             then
     1143                wait-for go of frame waitfram pause mWaitFramInterval.
     1144          end.
     1145          else
     1146             if     mWaitProcEvent
     1147                and not mBatchMode
     1148             then
     1149                process events .
     1150     end.
     1151   end procedure.
     1152      procedure waitfram-show-this:
     1153         define input  parameter iInterval as int64 no-undo.
     1154         define variable vtime as int64 no-undo.
     1155         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1156         mWaitFramInterval = iInterval.
     1157         run waitfram-show (substitute("&1&2 &3&4" ,
     1158                                       mWaitFramTextBeg ,
     1159                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1160                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1161                                       mWaitFramTextEnd
     1162                                      )
     1163                           ).
     1164      end.
     1165      procedure WaitFramRunPause:
     1166         define input  parameter iInterval as dec no-undo.
     1167         define variable vStart  as datetime-tz no-undo.
     1168         define variable vend    as datetime-tz no-undo.
     1169         define variable vint as int64 no-undo.
     1170         define variable vOk as logical no-undo.
     1171         vStart = now.
     1172         vend   = vStart.
     1173         publish "WaitFramPause" (iInterval,output vOk).
     1174         vend   =  now.
     1175         vint = vend - vStart.
     1176         vint = iInterval - vint / 1000.
     1177         if     not mWaitFramStop
     1178            and (   vint > 0
     1179                 or (    not vOk
     1180                     and iInterval eq ?
     1181                     )
     1182                 )
     1183         then
     1184            run waitfram-show-this (iInterval).
     1185         vend   =  now.
     1186         vint = vend - vStart.
     1187         vint = iInterval - vint / 1000.
     1188         if     not mWaitFramStop
     1189            and vint > 0
     1190         then do:
     1191            run gbl/pause.p (vint * 1000).
     1192         end.
     1193         if iInterval ne ?
     1194         then
     1195            publish "WaitFramStop".
     1196         waitfram-check-timeout().
     1197      end.
     1198      procedure WaitFramWaitFor:
     1199         define input  parameter iInterval as dec no-undo.
     1200         assign
     1201            mWaitFramStartProc   = now
     1202            mWaitFramStopUser    = no
     1203            mWaitFramStopTimeOut = no
     1204         .
     1205         block-wait:
     1206         do while not mWaitFramStop:
     1207            run WaitFramRunPause (iInterval).
     1208            if  waitfram-check-timeout()
     1209            then do:
     1210               leave block-wait.
     1211            end.
     1212         end.
     1213         run waitfram-hide.
     1214      end.
     1215   procedure waitfram-join :
     1216     define input  parameter p-line-1  as character no-undo .
     1217     define input  parameter p-line-2  as character no-undo .
     1218     define input  parameter p-line-3  as character no-undo .
     1219     define output parameter p-message as character no-undo .
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       assign
     1224         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1225                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1226                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1227       .
     1228     end.
     1229   end procedure.
     1230   function waitfram-join-function returns character
     1231     (input p-line-1 as character
     1232     ,input p-line-2 as character
     1233     ,input p-line-3 as character
     1234     ).
     1235     define variable v-message as character no-undo .
     1236     run waitfram-join in this-procedure
     1237       (input  p-line-1
     1238       ,input  p-line-2
     1239       ,input  p-line-3
     1240       ,output v-message
     1241       ) .
     1242     return v-message .
     1243   end function .
     1244   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
