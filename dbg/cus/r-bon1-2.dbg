     1342   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343   procedure on-same-page :
     1344     define input parameter p-line-number as integer no-undo .
     1345     if p-line-number > page-size( PrnLibStream ) then do:
     1346       return .
     1347     end.
     1348     if line-counter( PrnLibStream ) + p-line-number > page-size( PrnLibStream ) then do:
     1349       page stream PrnLibStream .
     1350     end.
     1351   end procedure.
     1352   DEFINE FRAME FRAME-1
     1353   pol2 column-label "1":c17 format "X(17)"
     1354   pol3 column-label "2":c11 format "X(11)"
     1355   pol4 column-label "3":c20 format "X(20)"
     1356   pol5 column-label "4":c9 format "X(9)"
     1357   pol7 column-label "5":c20 format "X(20)"
     1358   pol8 column-label "6":c10 format "->>,>>9.99"
     1359   pol9 column-label "7":c11 format ">>>,>>9.99"
     1360   pol10 column-label "8":c15 format "->>>,>>>,>>9.99"
     1361   pol11n column-label "9":c15 format "->>>,>>>,>>9.99"
     1362   pol11b column-label "10":c15 format "->>>,>>>,>>9.99"
     1363   pol12 column-label "11":c15 format "->>>,>>>,>>9.99"
     1364   pol13 column-label "12":c18 format "X(18)"
     1365   with width 232 down stream-io use-text NO-BOX.
     1366   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367   form header
     1368    skip(4)
     1369   with frame TopFrameSystem width 232 page-top no-labels no-box.
     1370   view stream PrnLibStream frame TopFrameSystem.
     1371   for each obj-list no-lock:
     1372     for each buf_temp-bon1 where
     1373             buf_temp-bon1.obj-type = obj-list.obj-type
     1374         and buf_temp-bon1.obj-code = obj-list.obj-code
     1375         and buf_temp-bon1.level = 0
     1376     break
     1377     by buf_temp-bon1.obj-type
     1378     by buf_temp-bon1.obj-code
     1379     by buf_temp-bon1.chk-date
     1380     by buf_temp-bon1.chk-time :
     1381       if first-of( buf_temp-bon1.obj-code) then do:
     1382         assign
     1383         acc-sum = 0.0
     1384         acc-discnt-value-abs = 0.0
     1385         acc-pay-sumn = 0.0
     1386         acc-pay-sumb = 0.0
     1387         .
     1388       end.
     1389       if first-of( buf_temp-bon1.chk-date)
     1390       and p-sheet-num = 3
     1391       then do:
     1392         assign
     1393         d-acc-sum = 0.0
     1394         d-acc-discnt-value-abs = 0.0
     1395         d-acc-pay-sumn = 0.0
     1396         d-acc-pay-sumb = 0.0
     1397         .
     1398         display stream PrnLibStream
     1399         substitute("Дата: &1", string(buf_temp-bon1.chk-date, "99.99.99")) @ pol2
     1400         WITH FRAME FRAME-1
     1401         .
     1402         DOWN STREAM PRnLibStream
     1403         with frame frame-1.
     1404         if Make-Excel then  put   stream ForExcel unformatted
     1405         substitute("Дата: &1", string(buf_temp-bon1.chk-date, "99.99.99"))
     1406         skip.
     1407       end.
     1408       find first buf_temp-bon1-gds where
     1409                 buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code no-error.
     1410       if not available buf_temp-bon1-gds then do:
     1411         find first buf_goods no-lock where
     1412                 buf_goods.gds-code = buf_temp-bon1.gds-code no-error.
     1413         create buf_temp-bon1-gds.
     1414         assign
     1415         buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code
     1416         buf_temp-bon1-gds.gds-name = (if available buf_goods
     1417                                       then buf_goods.gds-name
     1418                                       else substitute("Неизвестный товар &1", buf_temp-bon1.gds-code))
     1419         .
     1420       end.
     1421       find first buf_temp-bon1-cashier where
     1422                 buf_temp-bon1-cashier.cashier-psn-code = buf_temp-bon1.cashier-psn-code no-error.
     1423       if not available buf_temp-bon1-cashier then do:
     1424         find first buf_clients no-lock where
     1425                 buf_clients.obj-type = 'чел':U
     1426             and buf_clients.obj-code = buf_temp-bon1.cashier-psn-code no-error.
     1427         create buf_temp-bon1-cashier.
     1428         assign
     1429         buf_temp-bon1-cashier.cashier-psn-code = buf_temp-bon1.cashier-psn-code
     1430         buf_temp-bon1-cashier.obj-name = (if available buf_clients
     1431                                       then buf_clients.obj-name
     1432                                       else substitute("Неизвестный кассир чел&1", buf_temp-bon1.cashier-psn-code))
     1433         .
     1434       end.
     1435       if buf_temp-bon1.op-code = 1 then do:
     1436         assign
     1437         pol11n = 0
     1438         pol11b = buf_temp-bon1.pay-sum
     1439         .
     1440       end.
     1441       if buf_temp-bon1.op-code = 2 then do:
     1442         assign
     1443         pol11n = buf_temp-bon1.pay-sum
     1444         pol11b = 0
     1445         .
     1446       end.
     1447       display stream PrnLibStream
     1448       (string(buf_temp-bon1.chk-date, "99.99.99") + chr(32) + string(buf_temp-bon1.chk-time, "HH:MM:SS")) @ pol2
     1449       (string(buf_temp-bon1.shift-date, "99.99.99") + chr(32) + string(buf_temp-bon1.shift-name, "X(2)")) @ pol3
     1450       buf_temp-bon1.doc-code @ pol4
     1451       buf_temp-bon1.d-card @ pol5
     1452        buf_temp-bon1-gds.gds-name @ pol7
     1453        buf_temp-bon1.src-qnty @ pol8
     1454        buf_temp-bon1.src-price @ pol9
     1455        (buf_temp-bon1.src-price * buf_temp-bon1.src-qnty) @ pol10
     1456        pol11n
     1457        pol11b
     1458        buf_temp-bon1.discnt-value-abs @ pol12
     1459        buf_temp-bon1-cashier.obj-name @ pol13
     1460       WITH FRAME FRAME-1
     1461       .
     1462       DOWN STREAM PRnLibStream
     1463       with frame frame-1.
     1464       if Make-Excel then  put   stream ForExcel unformatted
     1465       (string(buf_temp-bon1.chk-date, "99.99.99") + chr(32) + string(buf_temp-bon1.chk-time, "HH:MM:SS")) CHR(9)
     1466       (string(buf_temp-bon1.shift-date, "99.99.99") + chr(32) + string(buf_temp-bon1.shift-name, "X(2)")) CHR(9)
     1467       buf_temp-bon1.doc-code CHR(9)
     1468       buf_temp-bon1.d-card CHR(9)
     1469        buf_temp-bon1-gds.gds-name CHR(9)
     1470        buf_temp-bon1.src-qnty CHR(9)
     1471        buf_temp-bon1.src-price CHR(9)
     1472        (buf_temp-bon1.src-price * buf_temp-bon1.src-qnty) CHR(9)
     1473       (if buf_temp-bon1.op-code = 1
     1474        then "-"
     1475        else string(buf_temp-bon1.pay-sum, "-999,999,999.99")) CHR(9)
     1476       (if buf_temp-bon1.op-code = 2
     1477        then "-"
     1478        else string(buf_temp-bon1.pay-sum, "-999,999,999.99")) CHR(9)
     1479        buf_temp-bon1.discnt-value-abs CHR(9)
     1480        buf_temp-bon1-cashier.obj-name
     1481        skip.
     1482        assign
     1483        acc-sum = acc-sum + (buf_temp-bon1.src-price * buf_temp-bon1.src-qnty)
     1484        acc-discnt-value-abs = acc-discnt-value-abs + buf_temp-bon1.discnt-value-abs
     1485        acc-pay-sumn = acc-pay-sumn +  (if buf_temp-bon1.op-code = 1
     1486                                       then 0
     1487                                       else buf_temp-bon1.pay-sum)
     1488        acc-pay-sumb = acc-pay-sumb +  (if buf_temp-bon1.op-code = 2
     1489                                       then 0
     1490                                       else buf_temp-bon1.pay-sum)
     1491        d-acc-sum = d-acc-sum + (buf_temp-bon1.src-price * buf_temp-bon1.src-qnty)
     1492        d-acc-discnt-value-abs = d-acc-discnt-value-abs + buf_temp-bon1.discnt-value-abs
     1493        d-acc-pay-sumn = d-acc-pay-sumn +  (if buf_temp-bon1.op-code = 1
     1494                                       then 0
     1495                                       else buf_temp-bon1.pay-sum)
     1496        d-acc-pay-sumb = d-acc-pay-sumb +  (if buf_temp-bon1.op-code = 2
     1497                                       then 0
     1498                                       else buf_temp-bon1.pay-sum)
     1499        .
     1500        if last-of( buf_temp-bon1.chk-date)
     1501        and p-sheet-num = 3
     1502        then do:
     1503           display stream PrnLibStream
     1504           substitute("Итого за &1", string(buf_temp-bon1.chk-date, "99.99.99")) @ pol2
     1505           acc-sum @ pol10
     1506           acc-pay-sumn @ pol11n
     1507           acc-pay-sumb @ pol11b
     1508           acc-discnt-value-abs @ pol12
     1509           WITH FRAME FRAME-1
     1510           .
     1511           DOWN STREAM PRnLibStream
     1512           with frame frame-1.
     1513           if Make-Excel then  put   stream ForExcel unformatted
     1514           substitute("Итого за &1", string(buf_temp-bon1.chk-date, "99.99.99")) CHR(9)
     1515           CHR(9)
     1516           CHR(9)
     1517           CHR(9)
     1518           CHR(9)
     1519           CHR(9)
     1520           CHR(9)
     1521           acc-sum CHR(9)
     1522           acc-pay-sumn CHR(9)
     1523           acc-pay-sumb CHR(9)
     1524           acc-discnt-value-abs
     1525           skip.
     1526        end.
     1527        if last-of( buf_temp-bon1.obj-code) then do:
     1528           display stream PrnLibStream
     1529           "Итого по отчету" @ pol2
