     1331   define variable d-acc-pay-sumn as decimal no-undo .
     1332   define variable d-acc-pay-sumb as decimal no-undo .
     1333   define variable d-acc-discnt-value-abs as decimal no-undo .
     1334   define buffer buf_temp-bon1 for temp-bon1.
     1335   define buffer item_temp-bon1 for temp-bon1.
     1336   define buffer op_temp-bon1 for temp-bon1.
