     1314   define variable pol2 as character no-undo .
     1315   define variable pol3 as character no-undo .
     1316   define variable pol4 as character no-undo .
     1317   define variable pol5 as character no-undo .
     1318   define variable pol7 as character no-undo .
     1319   define variable pol8 as decimal   no-undo .
     1320   define variable pol9 as decimal   no-undo .
     1321   define variable pol10 as decimal  no-undo .
     1322   define variable pol11n as decimal  no-undo .
     1323   define variable pol11b as decimal  no-undo .
     1324   define variable pol12 as decimal  no-undo .
     1325   define variable pol13 as character  no-undo .
     1326   define variable acc-sum as decimal no-undo .
     1327   define variable acc-pay-sumn as decimal no-undo .
     1328   define variable acc-pay-sumb as decimal no-undo .
     1329   define variable acc-discnt-value-abs as decimal no-undo .
