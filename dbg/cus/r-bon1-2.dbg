      589   define shared stream PrnLibStream.
      590   procedure prn-lib-prn-file :
      591     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      592     define input parameter p-DIsabledoptions as integer no-undo .
      593     define variable v-report-name as character no-undo .
      594     define variable v-user-action as character no-undo .
      595     define variable v-printed     as logical   no-undo .
      596     define variable v-exist       as logical   no-undo .
      597     do
      598       on error undo, return error
      599       :
      600       run prn-lib-get-report-name  in this-procedure (
      601         input parParentProc
      602         ,output v-report-name
      603         ).
      604   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      606     (input  v-report-name
      607     ,input  2
      608     ,output v-exist
      609     )  .
      610       if NOT v-exist then
      611       DO:
      612         Message
      613           "Нет заданий на печать ! "
      614           view-as alert-box .
      615         Return  .
      616       End.
      617       run gbl/prnfilen.w
      618         (input  ""
      619         ,input  p-DisabledOptions
      620         ,input  string(v-report-name )
      621         ,input  7
      622         ,output v-user-action
      623         ,output v-printed
      624         ) .
      625       if v-printed then
      626       do:
      627         return "YES" .
      628       end.
      629       else
      630       do:
      631         return "NO" .
      632       end.
      633     end.
      634   end procedure.
      635   procedure prn-lib-open-stream :
      636     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      637     define input parameter p-page-size    as integer no-undo .
      638     define input parameter p-is-stream    as logical no-undo .
      639     define input parameter p-append       as logical no-undo .
      640     define variable v-report-name as character no-undo .
      641     do
      642       on error undo, return error
      643       :
      644       run prn-lib-get-report-name  in this-procedure (
      645         input parParentProc
      646         ,output v-report-name
      647         ).
      648       if p-is-stream then
      649       do:
      650         if p-append then
      651         do:
      652           output stream PrnLibStream to value( v-report-name )
      653             page-size value(p-page-size) append .
      654         end.
      655         if not p-append then
      656         do:
      657           output stream PrnLibStream to value( v-report-name )
      658             page-size value(p-page-size) .
      659         end.
      660       end.
      661       if not p-is-stream then
      662       do:
      663         if p-append then
      664         do:
      665           output to value( v-report-name )
      666             page-size value(p-page-size) append .
      667         end.
      668         if not p-append then
      669         do:
      670           output to value( v-report-name )
      671             page-size value(p-page-size) .
      672         end.
      673       end.
      674     end.
      675   end procedure.
      676   procedure prn-lib-open-exp :
      677     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      678     define input parameter p-is-stream    as logical no-undo .
      679     define input parameter p-is-append    as logical no-undo .
      680     define output parameter p-ReportFileName as char init "report" no-undo.
      681     define output parameter p-process as logical no-undo .
      682     define variable glog as logical no-undo .
      683     do
      684       on error undo, return error
      685       :
      686       SYSTEM-DIALOG GET-FILE p-ReportFileName
      687         TITLE      "Укажите путь"
      688         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      689         ASK-OVERWRITE
      690         CREATE-TEST-FILE
      691         SAVE-AS
      692         USE-FILENAME
      693         DEFAULT-EXTENSION "txt"
      694         UPDATE glog
      695         .
      696       if not glog then  return.
      697       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      698       if p-is-stream then
      699       do:
      700         if p-is-append then
      701         do:
      702           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      703         end.
      704         else
      705         do:
      706           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      707         end.
      708       end.
      709       else
      710       do:
      711         if p-is-append then
      712         do:
      713           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      714         end.
      715         else
      716         do:
      717           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      718         end.
      719       end.
      720       p-process = yes.
      721     end.
      722   end procedure.
      723   procedure prn-lib-get-report-name :
      724     define input parameter parParentProc  as widget-handle no-undo.
      725     define output parameter p-report-name as character no-undo .
      726     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      727   end procedure.
      728   procedure prn-lib-reportviewer-report-name :
      729     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      730     define input parameter p-report-name-html as character no-undo .
      731     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      732   end procedure.
      733   procedure prn-lib-reportviewer :
      734     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      735     define input parameter p-report-name-html as character no-undo .
      736     define input parameter p-param        as character no-undo .
      737     define variable v-excel           as character no-undo init 'TRUE' .
      738     define variable v-value-character as character no-undo .
      739     define variable v-value-integer   as character no-undo .
      740     define variable v-value-date      as date      no-undo .
      741     define variable v-value-decimal   as decimal   no-undo .
      742     define variable rep-excel         as logical   no-undo .
      743     define variable excel-string      as character no-undo .
      744     define variable v-param-type      as character no-undo .
      745     define variable v-tth             as handle    no-undo .
      746     run adm/shattri.p (
      747       input "get":U
      748       ,input  ""
      749       ,input  0
      750       ,input  'report-glob':U
      751       ,input  'rep-excel':U
      752       ,output v-value-character
      753       ,output v-value-date
      754       ,output v-value-decimal
      755       ,output v-value-integer
      756       ,output rep-excel
      757       ,output v-param-type
      758       ,INPUT-OUTPUT table-handle v-tth
      759       )  .
      760     if rep-excel then v-excel = "TRUE" .
      761     else v-excel = "FALSE" .
      762     if p-param eq ""
      763     then
      764        p-param = "EXCEL:" + v-excel.
      765     else
      766        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      767     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      768   end procedure.
      769   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      770   procedure cur-time :
      771      define output parameter p-today as date      no-undo .
      772      define output parameter p-time  as integer   no-undo .
      773     do
      774     on error undo, return error
      775     :
      776       define variable v-date1 as date      no-undo .
      777       define variable v-date2 as date      no-undo .
      778       define variable v-time  as integer   no-undo .
      779       assign
      780         v-date1 = today
      781         v-time  = time
      782         v-date2 = today
      783       .
      784       if v-date1 <> v-date2
      785       then do:
      786         assign
      787           v-date1 = today
      788           v-time  = v-time
      789         .
      790       end.
      791       assign
      792         p-today = v-date1
      793         p-time  = v-time
      794       .
      795     end.
      796   end.
      797   function cur-time-date returns character
      798   :
      799     return string(today, '99/99/9999':U) .
      800   end.
      801   function cur-time-mjd returns decimal
      802   :
      803     define variable v-date as date      no-undo .
      804     define variable v-time as integer   no-undo .
      805     run cur-time in this-procedure
      806       (output v-date
      807       ,output v-time
      808       ) .
      809     return integer(v-date) - 2400002 + (v-time / 86400) .
      810   end.
      811   function cur-time-get-ending-index returns integer
      812   (input p-number as integer
      813   )
      814   :
      815     if p-number < 0
      816     or p-number = ?
      817     then do:
      818       return 1 .
      819     end.
      820     define variable v-rest as integer   no-undo .
      821     assign
      822       p-number = p-number modulo 100
      823     .
      824     if p-number < 20
      825     then do:
      826       assign
      827         v-rest = p-number
      828       .
      829     end.
      830     else do:
      831       assign
      832         v-rest = p-number modulo 10
      833       .
      834     end.
      835     case v-rest :
      836       when 1
      837       then do:
      838         return 2 .
      839       end.
      840       when 2 or
      841       when 3 or
      842       when 4
      843       then do:
      844         return 3 .
      845       end.
      846       otherwise do:
      847         return 1 .
      848       end.
      849     end case .
      850   end.
      851   procedure cur-time-mjd-to-date :
      852      define input  parameter i-mjd-diff as decimal no-undo.
      853      define output parameter o-Date     as date    no-undo.
      854      define output parameter o-Time     as integer no-undo.
      855      define variable v-day-number as integer   no-undo .
      856      if    i-mjd-diff < 0
      857         or i-mjd-diff = ?
      858      then do:
      859         return "?" .
      860      end.
      861      assign
      862         v-day-number = truncate(i-mjd-diff,0).
      863         o-Date = date(v-day-number + 2400002).
      864         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      865     .
      866   end.
      867   function cur-time-mjd-to-string returns character
      868   (input p-mjd-diff as decimal
      869   )
      870   :
      871     define variable v-day-number as integer   no-undo .
      872     define variable v-seconds    as integer   no-undo .
      873     define variable v-hour       as integer   no-undo .
      874     define variable v-min        as integer   no-undo .
      875     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      876     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      877     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      878     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      879     if p-mjd-diff < 0
      880     or p-mjd-diff = ?
      881     then do:
      882       return "?" .
      883     end.
      884     assign
      885       v-day-number = integer(truncate(p-mjd-diff,0))
      886       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      887     .
      888     if v-seconds > 86400
      889     then do:
      890       assign
      891         v-seconds = 86400 - 1
      892       .
      893     end.
      894     if v-seconds < 0
      895     then do:
      896       assign
      897         v-seconds = 0
      898       .
      899     end.
      900     assign
      901       v-hour = truncate(v-seconds / 3600, 0)
      902     .
      903     assign
      904       v-seconds = v-seconds modulo 3600
      905     .
      906     assign
      907       v-min = truncate(v-seconds / 60, 0)
      908     .
      909     assign
      910       v-seconds = v-seconds modulo 60
      911     .
      912     return
      913         (if v-day-number <> 0
      914           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      915           else ""
      916         )
      917       + (if v-day-number <> 0 or v-hour <> 0
      918           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      919           else ""
      920         )
      921       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      922           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      923           else ""
      924         )
      925       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      926       .
      927   end.
      928   function cur-time-string returns character
      929   :
      930     define variable v-date as date      no-undo .
      931     define variable v-time as integer   no-undo .
      932     run cur-time in this-procedure
      933       (output v-date
      934       ,output v-time
      935       ) .
      936     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      937   end.
      938   function cur-time-string-sec returns character
      939   :
      940     define variable v-date as date      no-undo .
      941     define variable v-time as integer   no-undo .
      942     run cur-time in this-procedure
      943       (output v-date
      944       ,output v-time
      945       ) .
      946     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      947   end.
      948   function cur-time-custom  returns character
      949   (input p-prefix as character
      950   ,input p-date-format as character
      951   ,input p-delimiter as character
      952   ,input p-time-format as character
      953   ,input p-suffix as character
      954   )
      955   :
      956     define variable v-date as date      no-undo .
      957     define variable v-time as integer   no-undo .
      958     run cur-time in this-procedure
      959       (output v-date
      960       ,output v-time
      961       ) .
      962     return
      963       p-prefix
      964       + string(v-date, p-date-format)
      965       + p-delimiter
      966       + string(v-time, p-time-format)
      967       + p-suffix
      968       .
      969   end.
      970   function cur-time-print  returns character
      971   :
      972     define variable v-date as date      no-undo .
      973     define variable v-time as integer   no-undo .
      974     run cur-time in this-procedure
      975       (output v-date
      976       ,output v-time
      977       ) .
      978     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      979   end.
      980   function cur-time-datetime returns datetime
      981   :
      982     define variable v-char as character no-undo .
      983     define variable v-datetime as datetime no-undo .
      984     v-char = cur-time-string().
      985     v-datetime = datetime(v-char).
      986     return  v-datetime.
      987   end.
      988   function cur-time-string-msec returns character
      989   :
      990     define variable v-date as datetime  no-undo .
      991     v-date = now.
      992     return string(v-date) .
      993   end.
