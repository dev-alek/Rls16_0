     1488   procedure run1 :
     1489          case select-good :
     1490           when 1  then do:
     1491   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1493       for each gds-obj  where
     1494             gds-obj.obj-type = x-store-type  and
     1495             gds-obj.obj-code = x-store-code
     1496             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1497                   no-lock,
     1498             First goods  where  gds-obj.gds-code   = goods.gds-code
     1499   no-lock
     1500   BREAK
     1501       BY (temp-gds-list.artic) :
     1502         run item-goods ( "1" , "goods" ) .
     1503         if return-value <> "" then NEXT.
     1504       End.
     1505     END.
     1506     Else DO:
     1507      For each obj-list no-lock :
     1508                     FOR EACH gds-obj where
     1509                   gds-obj.obj-type = obj-list.obj-type    and
     1510                   gds-obj.obj-code = obj-list.obj-code
     1511                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1512                   no-lock :
     1513                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1514                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1515                       Create temp-gds-list.
     1516                       Assign
     1517                         temp-gds-list.prod-code = gds-obj.prod-code
     1518                         temp-gds-list.grp-name  = gds-obj.grp-name
     1519                         temp-gds-list.gds-name  = goods.gds-name
     1520                         temp-gds-list.gds-code  = gds-obj.gds-code
     1521                         temp-gds-list.artic     = gds-obj.artic
     1522                       .
     1523                   End.
     1524               End.
     1525     End.
     1526     for each temp-gds-list no-lock
     1527       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1528         BREAK
     1529       BY temp-gds-list.artic :
     1530       run item-goods ( "1" , "goods" ) .
     1531         if return-value <> "" then NEXT.
     1532     End.
     1533   End.
     1534     end.
     1535           when 2  then do:
     1536   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1537     if x-selectobject = "currency":u  or  xtog-obj then do:
     1538         for  each gds-obj
     1539                     where gds-obj.obj-code   = x-store-code
     1540                      and  gds-obj.obj-type   = x-store-type
     1541                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1542                           no-lock ,
     1543                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1544                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     1545                     break
     1546                     by temp-gds-list.artic :
     1547                     run item-goods ( input "1" , input "goods" ) .
     1548                     if return-value <> "" then next.
     1549         end.
     1550     end.
     1551     else do:
     1552         for each obj-list no-lock :
     1553               for  each gds-obj
     1554                 where  gds-obj.obj-code   = obj-list.obj-code
     1555                   and  gds-obj.obj-type   = obj-list.obj-type
     1556                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1557                 no-lock ,
     1558                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1559                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     1560                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1561                           create temp-gds-list.
     1562                           assign
     1563                             temp-gds-list.prod-code = gds-obj.prod-code
     1564                             temp-gds-list.grp-name  = gds-obj.grp-name
     1565                             temp-gds-list.gds-name  = goods.grp-name
     1566                             temp-gds-list.gds-code  = gds-obj.gds-code
     1567                             temp-gds-list.artic     = gds-obj.artic
     1568                           .
     1569                       end.
     1570               end.
     1571       end.
     1572     for each temp-gds-list no-lock
     1573       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1574         break
     1575       by temp-gds-list.artic :
     1576       run item-goods ( "1" , "goods" ) .
     1577         if return-value <> "" then next.
     1578     end.
     1579   end.
     1580     end.
     1581           when 3 then do:
     1582   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1583   if x-selectobject = "currency":u  or  xtog-obj then do:
     1584     for  each gds-obj
     1585         where  gds-obj.obj-code   = x-store-code
     1586           and  gds-obj.obj-type   = x-store-type
     1587                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1588                 no-lock ,
     1589     first g#cli
     1590           where gds-obj.prod-code  = g#cli.obj-code
     1591           and  gds-obj.prod-type   = g#cli.obj-type
     1592           no-lock,
     1593     first goods
     1594           where gds-obj.gds-code = goods.gds-code no-lock
     1595           break
     1596           by temp-gds-list.artic :
     1597           run item-goods ( "1" , "goods" ) .
     1598           if return-value <> "" then next.
     1599         end.
     1600     end.
     1601     else do:
     1602       for each obj-list no-lock :
     1603             for  each gds-obj
     1604               where  gds-obj.obj-code   = obj-list.obj-code
     1605                 and  gds-obj.obj-type   = obj-list.obj-type
     1606                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1607                       no-lock ,
     1608             first g#cli
     1609                 where gds-obj.prod-code  = g#cli.obj-code
     1610                 and  gds-obj.prod-type   = g#cli.obj-type
     1611                 no-lock,
     1612             first goods
     1613                 where gds-obj.gds-code = goods.gds-code no-lock :
     1614                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1615                       create temp-gds-list.
     1616                       assign
     1617                         temp-gds-list.prod-code = gds-obj.prod-code
     1618                         temp-gds-list.grp-name  = gds-obj.grp-name
     1619                         temp-gds-list.gds-name  = goods.gds-name
     1620                         temp-gds-list.gds-code  = gds-obj.gds-code
     1621                         temp-gds-list.artic     = gds-obj.artic
     1622                       .
     1623                   end.
     1624             end.
     1625       end.
     1626         for each temp-gds-list no-lock
     1627           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1628             break
     1629               by temp-gds-list.artic :
     1630           run item-goods ( "1" , "goods" ) .
     1631             if return-value <> "" then next.
     1632         end.
     1633   end.
     1634     end.
     1635           otherwise do:
     1636   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1638       for each gds-obj  where
     1639             gds-obj.obj-type = x-store-type  and
     1640             gds-obj.obj-code = x-store-code
     1641             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1642                   no-lock,
     1643             First goods  where  gds-obj.gds-code   = goods.gds-code
     1644         no-lock,
     1645   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     1646   no-lock
     1647   BREAK
     1648       BY (gds-list.artic) :
     1649         run item-goods ( "1" , "gds-list" ) .
     1650         if return-value <> "" then NEXT.
     1651       End.
     1652     END.
     1653     Else DO:
     1654      For each obj-list no-lock :
     1655                     FOR EACH gds-obj where
     1656                   gds-obj.obj-type = obj-list.obj-type    and
     1657                   gds-obj.obj-code = obj-list.obj-code
     1658                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1659                   no-lock,
     1660             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     1661                   no-lock :
     1662                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1663                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1664                       Create temp-gds-list.
     1665                       Assign
     1666                         temp-gds-list.prod-code = gds-obj.prod-code
     1667                         temp-gds-list.grp-name  = gds-obj.grp-name
     1668                         temp-gds-list.gds-name  = goods.gds-name
     1669                         temp-gds-list.gds-code  = gds-obj.gds-code
     1670                         temp-gds-list.artic     = gds-obj.artic
     1671                       .
     1672                   End.
     1673               End.
     1674     End.
     1675     for each temp-gds-list no-lock
     1676       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     1677         BREAK
     1678       BY gds-list.artic :
     1679       run item-goods ( "1" , "gds-list" ) .
     1680         if return-value <> "" then NEXT.
     1681     End.
     1682   End.
     1683           end.
     1684          end case.
     1685   end procedure.
     1686   PROCEDURE CalcItog :
     1687       run ostatok (
     1688           input x-store-code  ,
     1689           input x-store-type  ,x-TOG-Shift,
     1690           input x-date-start - 1 ,
     1691           input date('')      , x-Shift-Start,x-Shift-End,
     1692           input 'crsa':U   ,
     1693           input '##,##':U,
     1694           input xTog-obj ,
     1695           output  Quantity1  ,
     1696           output  Coast_R1   ,
     1697           output  Coast_V1   ,
     1698           output  VAT_R1     ,
     1699           output  VAT_V1     ,
     1700           output  Fact-order-1 ).
     1701       run ostatok (
     1702           input x-store-code  ,
     1703           input x-store-type  , x-TOG-Shift,
     1704           input x-date-start  ,
     1705           input x-date-end    ,  x-Shift-Start,x-Shift-End,
     1706           input 'crsa':U   ,
     1707           input '##,##':U,
     1708           input xTog-obj ,
     1709           output  Quantity1  ,
     1710           output  Coast_R1   ,
     1711           output  Coast_V1   ,
     1712           output  VAT_R1     ,
     1713           output  VAT_V1     ,
     1714           output  Fact-order-2 ).
     1715             Quantity1  = 0.
     1716             Coast_R1   = 0.
     1717             Coast_V1   = 0.
     1718             VAT_R1     = 0.
     1719             VAT_V1     = 0.
     1720   END PROCEDURE.
