     1783   PROCEDURE ob-line  :
     1784   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     1785   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     1786   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     1787   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     1788   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     1789   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     1790   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     1791   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     1792   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     1793   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     1794   define input  parameter xTog-obj         as log no-undo.
     1795   define input  parameter xi               as int no-undo.
     1796   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     1797   define output  parameter ret-str         as char  no-undo.
     1798   define variable  First-sum   like ub.stk-line.fact-qnty   no-undo.
     1799   define variable  Second-sum  like ub.stk-line.fact-qnty   no-undo.
     1800   define variable  Temp-First-sum  like ub.stk-line.fact-qnty   no-undo.
     1801   define variable  Temp-Second-sum  like ub.stk-line.fact-qnty   no-undo.
     1802     Assign First-sum = 0 Second-sum = 0 Temp-First-sum = 0 Temp-Second-sum = 0 ret-str = "".
     1803     For EAch Temp#obj-list  no-lock BREAK by Temp#obj-list.grp-name :
     1804         FIND LAST ub.stk-line where
     1805                                 ub.stk-line.artic         = x-artic
     1806                           AND   ub.stk-line.fact-order   <= x-fact-order-2
     1807                           AND   ub.stk-line.obj-code     = Temp#obj-list.obj-code
     1808                           AND   ub.stk-line.obj-type     = Temp#obj-list.obj-type
     1809                           AND   ub.stk-line.prod-code    = x-prod-code
     1810                           AND   ub.stk-line.prod-type    = x-prod-type
     1811                           AND   ub.stk-line.sum-type     = 'crsa':U
     1812                           AND   ub.stk-line.cat-id       = '##,##':U
     1813                           USE-index category no-lock  no-error.
     1814                 if available ub.stk-LINE THEN Second-sum = Second-sum + ub.stk-line.fact-qnty.
     1815                 if available ub.stk-LINE THEN Temp-Second-sum = Temp-Second-sum + ub.stk-line.fact-qnty.
     1816       if LAST-of (Temp#obj-list.grp-name) Then
     1817         Assign ret-str = ret-str + excel-sum ( Temp-Second-sum )
     1818                ret-str = ret-str + CHR(9)
     1819                Temp-First-sum  = 0
     1820                Temp-Second-sum = 0.
     1821      End.
     1822      Quntity = Second-sum .
     1823   END PROCEDURE.
     1824   PROCEDURE ostatok :
     1825   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1826   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1827   def input parameter x-tog-shift   as   logical             no-undo.
     1828   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1829   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1830   def input parameter x-shift-start as integer               no-undo.
     1831   def input parameter x-shift-end   as integer               no-undo.
     1832   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1833   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1834   def input parameter xTog-obj   as log no-undo.
     1835   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1836   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1837   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1838   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1839   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1840   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1841   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1842   def var              Fact-orderS   as char  no-undo.
     1843   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1844      Assign
     1845         Fact-order   = 0
     1846         Quantity     = 0
     1847         Coast_R      = 0
     1848         Coast_V      = 0
     1849         VAT_R        = 0
     1850         VAT_V        = 0 .
     1851    x-date-start-t  = x-date-start + 1 .
     1852   IF x-date-end = date('') then DO:
     1853      Fact-order = 0 .
     1854      for each obj-list
     1855          where  ( not xtog-obj or
     1856                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1857                 no-lock :
     1858         if  x-tog-shift = false then do:
     1859                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1860                               ub.stk-tot.Fact-date <=  x-date-start
     1861                               and ub.stk-tot.shift-num = 0
     1862                               USE-INDEX fact-date no-lock no-error .
     1863              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1864         End.
     1865         Else  DO :
     1866             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1867              (ub.stk-tot.shift-date  = x-date-start-t and
     1868               ub.stk-tot.shift-num  < x-shift-start or
     1869               ub.stk-tot.shift-date  < x-date-start-t  )
     1870               and ub.stk-tot.shift-num  > 0
     1871               USE-INDEX Shift-num no-lock no-error .
     1872            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1873           END.
     1874       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1875     End.
     1876   End.
     1877   Else DO:
     1878     For each obj-list  WHERE
     1879        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1880         no-lock :
     1881      IF  x-TOG-Shift = False Then DO:
     1882          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1883               ub.stk-tot.Fact-date <= x-date-end
     1884               and ub.stk-tot.shift-num = 0
     1885               USE-INDEX fact-date no-lock no-error.
     1886          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1887      END.
     1888      Else DO:
     1889           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1890               (ub.stk-tot.shift-date  = x-date-end and
     1891               ub.stk-tot.shift-num  <= x-shift-end or
     1892               ub.stk-tot.shift-date  < x-date-end       ) and
     1893               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1894               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1895       End.
     1896       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1897     End.
     1898   End.
     1899   END PROCEDURE.
     1900   PROCEDURE report-exec1  :
     1901      FIND FIRST ub.clients where x-store-type = ub.clients.obj-type AND
     1902                                  x-store-code = ub.clients.obj-code no-lock no-error.
     1903              If available ub.clients then  ObjName = ub.clients.obj-name.
     1904                                            else  ObjName="объект не определен".
     1905     run waitfram-show in this-procedure (objname) .
     1906     run calcitog in this-procedure .
     1907     run print-header in this-procedure .
     1908     run run1 in this-procedure .
     1909     run printtemptable in this-procedure .
     1910     run print-footer in this-procedure .
     1911     END PROCEDURE.
     1912   PROCEDURE Calc-Sub-itog :
     1913   define input parameter tt as int no-undo.
     1914   define variable b as int no-undo.
     1915   define variable c as int no-undo.
     1916   define variable temp-sum1 as decimal no-undo .
     1917   define variable temp-sum2 as decimal no-undo .
     1918   define variable temp-sumi as decimal no-undo .
     1919   define variable temp-sum1# as decimal no-undo .
     1920   define variable temp-sum2# as decimal no-undo .
     1921   define variable temp-sumi# as decimal no-undo .
     1922   define variable ret-str-1 as character no-undo .
     1923   define variable ret-str-2 as character no-undo .
     1924   define variable ret-str-i as character no-undo .
     1925   define variable v-nn as integer   no-undo .
     1926     b1-ostatok-end [1] =  b1-ostatok-end [1] + TMP#bs.ostatok-end.
     1927     b2-ostatok-end [1] =  b2-ostatok-end [1] + TMP#bs.ostatok-end.
     1928     bi-ostatok-end [1] =  bi-ostatok-end [1] + TMP#bs.ostatok-end.
     1929     B1-Prih[1]    = B1-Prih[1]    + TMP#bs.Prih.
     1930     B2-Prih[1]    = B2-Prih[1]    + TMP#bs.Prih .
     1931     Bi-Prih[1]    = Bi-Prih[1]    + TMP#bs.Prih  .
     1932     B1-f-zakaz    = B1-f-zakaz   + TMP#bs.f-zakaz.
     1933     B2-f-zakaz    = B2-f-zakaz   + TMP#bs.f-zakaz.
     1934     Bi-f-zakaz    = Bi-f-zakaz   + TMP#bs.f-zakaz.
     1935     B1-F-Center-stock = B1-F-Center-stock  +  TMP#bs.F-Center-stock.
     1936     B2-F-Center-stock = B2-F-Center-stock  +  TMP#bs.F-Center-stock.
     1937     Bi-F-Center-stock = Bi-F-Center-stock  +  TMP#bs.F-Center-stock.
     1938     B1-KAssa[1]    = B1-KAssa[1]   +  TMP#bs.KAssa1 .  B2-kassa[1]    = B2-kassa[1]   +  TMP#bs.kassa1 .  Bi-Kassa[1]    = Bi-Kassa[1]   +  TMP#bs.Kassa1 .
     1939     B1-KAssa[2]    = B1-KAssa[2]   +  TMP#bs.KAssa2 .  B2-kassa[2]    = B2-kassa[2]   +  TMP#bs.kassa2 .  Bi-Kassa[2]    = Bi-Kassa[2]   +  TMP#bs.Kassa2 .
     1940     B1-KAssa[3]    = B1-KAssa[3]   +  TMP#bs.KAssa3 .  B2-kassa[3]    = B2-kassa[3]   +  TMP#bs.kassa3 .  Bi-Kassa[3]    = Bi-Kassa[3]   +  TMP#bs.Kassa3 .
     1941     B1-KAssa[4]    = B1-KAssa[4]   +  TMP#bs.KAssa4 .  B2-kassa[4]    = B2-kassa[4]   +  TMP#bs.kassa4 .  Bi-Kassa[4]    = Bi-Kassa[4]   +  TMP#bs.Kassa4 .
     1942     B1-KAssa[5]    = B1-KAssa[5]   +  TMP#bs.KAssa5 .  B2-kassa[5]    = B2-kassa[5]   +  TMP#bs.kassa5 .  Bi-Kassa[5]    = Bi-Kassa[5]   +  TMP#bs.Kassa5 .
     1943     B1-KAssa[6]    = B1-KAssa[6]   +  TMP#bs.KAssa6 .  B2-kassa[6]    = B2-kassa[6]   +  TMP#bs.kassa6 .  Bi-Kassa[6]    = Bi-Kassa[6]   +  TMP#bs.Kassa6 .
     1944     B1-F-avr =  round(b1-kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     1945     B2-F-avr =  round(b2-kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     1946     Bi-F-avr =  round(bi-kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     1947     repeat   c = 1 to 8 :
     1948         Assign
     1949         Temp-sum1  = 0 ret-str-1 = ""
     1950         Temp-sum2  = 0 ret-str-2 = ""
     1951         Temp-sumi  = 0 ret-str-i = "" .
     1952         v-nn = num-entries(tmp#bs.ret-str [c] , CHR(9)) - 1 .
     1953         repeat  b = 1 to v-nn :
     1954             Temp-sum1# = format-return(entry(b,B1-Ret-str [c],CHR(9))) no-error . if ERROR-STATUS :error then Temp-sum1# = 0.
     1955             Temp-sum2# = format-return(entry(b,B2-Ret-str [c],CHR(9))) no-error . if ERROR-STATUS :error then Temp-sum2# = 0.
     1956             Temp-sumi# = format-return(entry(b,Bi-Ret-str [c],CHR(9))) no-error . if ERROR-STATUS :error then Temp-sumi# = 0.
     1957             Temp-sum1 = Temp-sum1# + format-return(entry(b,TMP#bs.Ret-str [c],CHR(9))) no-error.
     1958             Temp-sum2 = Temp-sum2# + format-return(entry(b,TMP#bs.Ret-str [c],CHR(9))) no-error.
     1959             Temp-sumi = Temp-sumi# + format-return(entry(b,TMP#bs.Ret-str [c],CHR(9))) no-error.
     1960             Assign
     1961                    ret-str-1 = ret-str-1 + excel-sum((decimal(Temp-sum1) ))
     1962                    ret-str-1 = ret-str-1 + CHR(9)
     1963                    ret-str-2 = ret-str-2 + excel-sum((decimal(Temp-sum2) ))
     1964                    ret-str-2 = ret-str-2 + CHR(9)
     1965                    ret-str-i = ret-str-i + excel-sum((decimal(Temp-sumi) ))
     1966                    ret-str-i = ret-str-i + CHR(9).
     1967         End.
     1968         b1-ret-str[c] =  ret-str-1.
     1969         b2-ret-str[c] =  ret-str-2.
     1970         bi-ret-str[c] =  ret-str-i.
     1971     End.
     1972   END PROCEDURE.
     1973   PROCEDURE Clear-item :
     1974   define variable kk as int no-undo.
     1975    REPEAT kk = 1 to 6:
     1976    Assign
     1977       prih                 [kk]    = 0
     1978       rash                 [kk]    = 0
     1979       kassa                [kk]    = 0
     1980       Inv                  [kk]    = 0
     1981       Overturn             [kk]    = 0
     1982       ostatok-end      [kk] =   0
     1983       ostatok-start    [kk] =   0   .
     1984          End.
     1985      REPEAT kk = 1 to 8 :
     1986      B1-ret-str[kk] = s#ret-str.
     1987      B2-ret-str[kk] = s#ret-str.
     1988      Bi-ret-str[kk] = s#ret-str.
     1989      End.
     1990    END PROCEDURE.
     1991   PROCEDURE Item-Goods :
     1992    define input parameter  par-3 as char no-undo.
     1993    define input parameter  par-4 as char no-undo.
     1994         if par-4 = "goods":U  Then
     1995                                   assign
     1996                                       gds-zap-prt-root   = ub.goods.prt-root
     1997                                       gds-zap-prod-type  = ub.goods.prod-type
     1998                                       gds-zap-prod-code  = ub.goods.prod-code
     1999                                       gds-zap-artic      = ub.goods.artic
     2000                                       gds-zap-grp-name   = ub.goods.grp-name
     2001                                       gds-zap-b-code     = ub.goods.gds-code.
     2002        if par-4 = "gds-list":U  Then
     2003                                   assign
     2004                                       gds-zap-prt-root   = gds-list.prt-root
     2005                                       gds-zap-prod-type  = gds-list.prod-type
     2006                                       gds-zap-prod-code  = gds-list.prod-code
     2007                                       gds-zap-artic      = gds-list.artic
     2008                                       gds-zap-grp-name   = gds-list.grp-name
     2009                                       gds-zap-b-code     = gds-list.gds-code.
     2010             FIND FIRST ub.clients WHERE ub.clients.obj-type = gds-zap-prod-type AND
     2011                                      ub.clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2012                                      gds-zap-prod-name  = ub.clients.obj-name .
     2013      if xtog-lavel = true  and  xLavel > 0 then
     2014         gds-zap-grp-name = n-lavel(INPUT gds-zap-grp-name, Input xLavel ) .
     2015      run foreach in this-procedure .
     2016      Return error.
     2017    END PROCEDURE.
     2018   PROCEDURE Di :
     2019   define input parameter p1 as char no-undo.
     2020   define input parameter p2 as int no-undo.
     2021   define input parameter p3 as char no-undo.
     2022   define input parameter p4 as char no-undo.
     2023   define input parameter p5 as char no-undo.
     2024   define input parameter p6 as char no-undo.
     2025   define input parameter p7 as char no-undo.
     2026    CASE CAPS(p7) :
     2027      WHEN "B1":U  Then
     2028               run display-str-ex ( '' ,
     2029                   p3                  ,
     2030                   p4                  ,
     2031                   b1-F-zakaz          ,
     2032                   b1-F-center-stock   ,
     2033                   b1-Prih       [1]   ,
     2034                   b1-ostatok-end[1]   ,
     2035                   b1-F-avr            ,
     2036                   b1-KAssa      [1]   ,
     2037                   b1-KAssa      [2]   ,
     2038                   b1-KAssa      [3]   ,
     2039                   b1-KAssa      [4]   ,
     2040                   b1-KAssa      [5]   ,
     2041                   b1-KAssa      [6]  , "B1":U ).
     2042      WHEN "B2":U  Then
     2043                run display-str-ex ( '',
     2044                   p3                  ,
     2045                   p4                  ,
     2046                   b2-F-zakaz          ,
     2047                   b2-F-center-stock   ,
     2048                   b2-Prih [1]         ,
     2049                   b2-ostatok-end[1]   ,
     2050                   b2-F-avr            ,
     2051                   b2-KAssa      [1]   ,
     2052                   b2-KAssa      [2]   ,
     2053                   b2-KAssa      [3]   ,
     2054                   b2-KAssa      [4]   ,
     2055                   b2-KAssa      [5]   ,
     2056                   b2-KAssa      [6]  , "B2":U ).
     2057      WHEN "BI":U Then
     2058                run display-str-ex ( '',
     2059                   ''                   ,
     2060                   p4                   ,
     2061                   bi-F-zakaz           ,
     2062                   bi-F-center-stock    ,
     2063                   bi-Prih          [1] ,
     2064                   bi-ostatok-end   [1] ,
     2065                   bi-f-avr             ,
     2066                   bi-kAssa       [1]   ,
     2067                   bi-KAssa         [2] ,
     2068                   bi-KAssa         [3] ,
     2069                   bi-KAssa         [4] ,
     2070                   bi-KAssa         [5] ,
     2071                   bi-KAssa         [6] , "BI":U).
     2072      WHEN ""  Then
     2073                run display-str-ex ( ':',
     2074                   ii                    ,
     2075                   p4                    ,
     2076                   F-zakaz               ,
     2077                   F-center-stock        ,
     2078                   Prih          [1]     ,
     2079                   ostatok-end   [1]     ,
     2080                   f-avr                 ,
     2081                   kASSA         [1]     ,
     2082                   KAssa         [2]     ,
     2083                   KAssa         [3]     ,
     2084                   KAssa         [4]     ,
     2085                   KAssa         [5]     ,
     2086                   KAssa         [6]    , "":U ).
     2087          End case.
     2088    END PROCEDURE.
     2089   procedure zakaz :
     2090      F-zakaz = 0.
     2091      For each Temp#obj-list :
     2092      For each ub.trn-doc where
     2093             ub.trn-doc.doc-date <= x-date-end
     2094       AND   ub.trn-doc.doc-date >= x-date-start
     2095       AND   ub.trn-doc.status_   = 'запрос':U
     2096       AND   ub.trn-doc.internal  = false
     2097       AND   ub.trn-doc.obj-code   = Temp#obj-list.obj-code
     2098       AND   ub.trn-doc.obj-type   = Temp#obj-list.obj-type
     2099        no-lock :
     2100         For each ub.doc-line where
     2101                 ub.trn-doc.doc-code =  ub.doc-line.doc-code
     2102           AND   ub.doc-line.obj-code   = Temp#obj-list.obj-code
     2103           AND   ub.doc-line.obj-type   = Temp#obj-list.obj-type
     2104           AND   ub.doc-line.prod-code  = gds-zap-prod-code
     2105           AND   ub.doc-line.prod-type  = gds-zap-prod-type
     2106           AND   ub.doc-line.status_    = 'запрос':U
     2107           AND   ub.doc-line.artic      = gds-zap-artic    no-lock :
     2108                 F-zakaz = F-zakaz  +  ub.doc-line.doc-qnty   .
     2109         End.
     2110      End.
     2111   End.
     2112   End procedure.
     2113   Procedure maket :
     2114     Create temp#sum-type no-error.
     2115     Assign temp#sum-type.sum-type =   'ie':U       temp#sum-type.xi = 1      .
     2116     Create temp#sum-type no-error.
     2117     Assign temp#sum-type.sum-type =   'iv':U       temp#sum-type.xi = 1      .
     2118     Create temp#sum-type no-error.
     2119     Assign temp#sum-type.sum-type =  'ev':U       temp#sum-type.xi = 1      .
     2120     Create temp#sum-type no-error.
     2121     Assign temp#sum-type.sum-type =  'es':U       temp#sum-type.xi = 2  .
     2122     Create temp#sum-type no-error.
     2123     Assign temp#sum-type.sum-type =  'rs':U   temp#sum-type.xi = 2  .
     2124     if tog-voz then DO:
     2125       Create temp#sum-type no-error.
     2126       Assign temp#sum-type.sum-type =  're':U        temp#sum-type.xi = 2  .
     2127     End.
     2128     Create temp#sum-type no-error.
     2129     Assign temp#sum-type.sum-type = 'crsa':U  temp#sum-type.xi = 3  .
     2130    End procedure.
     2131   Procedure Display-str-ex :
     2132    define input parameter  p0  as char no-undo.
     2133    define input parameter  p1  as char no-undo.
     2134    define input parameter  p2  as char no-undo.
     2135    define input parameter  p3  as decimal   no-undo.
     2136    define input parameter  p4  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2137    define input parameter  p5  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2138    define input parameter  p6  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2139    define input parameter  p7  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2140    define input parameter  p8  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2141    define input parameter  p9  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2142    define input parameter  p10 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2143    define input parameter  p11 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2144    define input parameter  p12 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2145    define input parameter  p13 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2146    define input parameter  B as char no-undo.
     2147   define variable v-nn as integer   no-undo .
     2148    if p0 <> ':' THEN DO:
     2149                  if Make-Excel then  put   stream ForExcel unformatted
     2150                   p1   CHR(9)
     2151                   p2   CHR(9)
     2152                   excel-sum(p3)   CHR(9)
     2153                   excel-sum(p4)   CHR(9)
     2154                   excel-sum(p5)   CHR(9)
     2155                    if b <> "BI":U THEN string(b1-ret-str[1])
     2156                                   ELSE string(bi-ret-str[1])
     2157                   excel-sum(p6)   CHR(9)
     2158                    if b <> "BI":U THEN string(b1-ret-str[8])
     2159                                   ELSE string(bi-ret-str[8])
     2160                   excel-sum(p7)   CHR(9)
     2161                   excel-sum(p8)   CHR(9)
     2162                    if b <> "BI":U THEN string(b1-ret-str[2])
     2163                                   ELSE string(bi-ret-str[2])
     2164                                   .
     2165                   if Showorders = false THEN DO:
     2166                   if Make-Excel then  put   stream ForExcel unformatted
     2167                    excel-sum(p9)   CHR(9)
     2168                    if b <> "BI":U THEN string(b1-ret-str[3])
     2169                                   ELSE string(bi-ret-str[3])
     2170                    excel-sum(p10)  CHR(9)
     2171                    if b <> "BI":U THEN string(b1-ret-str[4])
     2172                                   ELSE string(bi-ret-str[4])
     2173                   excel-sum(p11)  CHR(9)
     2174                    if b <> "BI":U THEN string(b1-ret-str[5])
     2175                                   ELSE string(bi-ret-str[5])
     2176                   excel-sum(p12)  CHR(9)
     2177                    if b <> "BI":U THEN string(b1-ret-str[6])
     2178                                   ELSE string(bi-ret-str[6])
     2179                   excel-sum(p13)  CHR(9)
     2180                    if b <> "BI":U THEN string(b1-ret-str[7])
     2181                                   ELSE string(bi-ret-str[7]) Skip.
     2182                                  End.
     2183                     if Make-Excel then  put   stream ForExcel unformatted Skip.
     2184                    End.
     2185                  Else DO:
     2186    define variable i as integer no-undo .
     2187    qnty-orders = "".
     2188   if showorders = true then DO:
     2189       v-nn = num-entries(Number-Orders) .
     2190       repeat i = 1 to  v-nn :
     2191       If entry(i,Number-Orders) <> ?
     2192          and entry(i,Number-Orders) <> "."
     2193          and entry(i,Number-Orders) <> ""
     2194          and entry(i,Number-Orders) <> "0" Then DO:
     2195         Find first ub.doc-line where
     2196               entry(i,Number-Orders)    = ub.doc-line.doc-code
     2197               AND   ub.doc-line.prod-code  = TMP#bs.prod-code
     2198               AND   ub.doc-line.prod-type  = TMP#bs.prod-type
     2199               AND   ub.doc-line.status_    = 'запрос':U
     2200               AND   ub.doc-line.artic      = TMP#bs.artic
     2201               no-lock no-error .
     2202               qnty-orders =  qnty-orders  +
     2203                         (if avail ub.doc-line then
     2204                         string(ub.doc-line.fact-qnty)  Else "0")  +  CHR(9) .
     2205        End.
     2206       End.
     2207    End.
     2208    Else qnty-orders = "".
     2209         if Make-Excel then  put   stream ForExcel unformatted
     2210           p1   CHR(9)
     2211           p2   CHR(9)
     2212           excel-sum(p3)   CHR(9)
     2213           excel-sum(p4)   CHR(9)
     2214           excel-sum(p5)   CHR(9)
     2215           string(TMP#bs.ret-str[1])
     2216           excel-sum(p6)   CHR(9)
     2217           string(TMP#bs.ret-str[8])
     2218           excel-sum(p7)   CHR(9)
     2219           excel-sum(p8)   CHR(9)
     2220           string(TMP#bs.ret-str[2] )
     2221           .
     2222         if Showorders = false THEN DO:
     2223         if Make-Excel then  put   stream ForExcel unformatted
     2224           excel-sum(p9)   CHR(9)
     2225           string(TMP#bs.ret-str[3]  )
     2226           excel-sum(p10)  CHR(9)
     2227           string(TMP#bs.ret-str[4])
     2228           excel-sum(p11)  CHR(9)
     2229           string(TMP#bs.ret-str[5])
     2230           excel-sum(p12)  CHR(9)
     2231           string(TMP#bs.ret-str[6])
     2232           excel-sum(p13)  CHR(9)
     2233           string(TMP#bs.ret-str[7])
     2234           Skip.
     2235         End.
     2236         if Showorders = true  THEN DO:
     2237            if Make-Excel then  put   stream ForExcel unformatted qnty-orders       skip  .
     2238         End.
     2239         if Make-Excel then  put   stream ForExcel unformatted Skip.
     2240     End.
     2241   End procedure.
     2242   PROCEDURE Maketemptable :
     2243      Assign
     2244       v#b-code        = gds-zap-b-code
     2245       v#artic         = gds-zap-artic
     2246       v#prod-code     = gds-zap-prod-code
     2247       v#prod-type     = gds-zap-prod-type
     2248       v#prt-root      = gds-zap-prt-root
     2249       v#grp-name      = gds-zap-grp-name
     2250       v#F-zakaz       =  F-zakaz
     2251       v#F-center-stock=  F-center-stock
     2252       v#Prih          =  Prih          [1]
     2253       v#ostatok-end   =  ostatok-end   [1]
     2254       v#f-avr         =  f-avr
     2255       v#kASSA1        =  kASSA         [1]
     2256       v#KAssa2        =  KAssa         [2]
     2257       v#KAssa3        =  KAssa         [3]
     2258       v#KAssa4        =  KAssa         [4]
     2259       v#KAssa5        =  KAssa         [5]
     2260       v#KAssa6        =  KAssa         [6]
     2261       no-error.
     2262        Repeat l = 1 to 8 :
     2263          V#ret-str[l] = (ret-str[l]).
     2264        End.
     2265      Create TMP#bs no-error.
     2266      run eqq no-error.
     2267   END PROCEDURE.
     2268   PROCEDURE Eqq :
     2269      Assign
     2270       TMP#bs.b-code        = v#b-code
     2271       TMP#bs.artic         = v#artic
     2272       TMP#bs.prod-code     = v#prod-code
     2273       TMP#bs.prod-type     = v#prod-type
     2274       TMP#bs.prt-root      = v#prt-root
     2275       TMP#bs.grp-name      = v#grp-name
     2276       TMP#bs.F-zakaz       = v#F-zakaz
     2277       TMP#bs.F-center-stock= v#F-center-stock
     2278       TMP#bs.Prih          = v#Prih
     2279       TMP#bs.ostatok-end   = v#ostatok-end
     2280       TMP#bs.f-avr         = v#f-avr
     2281       TMP#bs.kASSA1        = v#kASSA1
     2282       TMP#bs.KAssa2        = v#KAssa2
     2283       TMP#bs.KAssa3        = v#KAssa3
     2284       TMP#bs.KAssa4        = v#KAssa4
     2285       TMP#bs.KAssa5        = v#KAssa5
     2286       TMP#bs.KAssa6        = v#KAssa6
     2287       TMP#bs.KAssa6        = v#KAssa6    no-error    .
     2288        Repeat l = 1 to 8 :
     2289          TMP#bs.ret-str[l] = v#ret-str[l] no-error.
     2290        End.
     2291   END PROCEDURE.
     2292   PROCEDURE PrintTempTAble :
     2293   define variable i as int init 0  no-undo.
     2294    Case RetClassify  :
     2295     WHEN "no-classify":U then DO:
     2296           For each TMP#bs   no-lock by
     2297           (if xSorttype = "sort-code":U  THEN string(TMP#bs.b-code)
     2298             ELSE if xSorttype = "sort-artic":U  THEN TMP#bs.artic
     2299                   ELSE  string( TMP#bs.f-avr,"-9999999999.999"))  :
     2300                       i = i + 1 .
     2301           If  Tog-Qnty = true   and  TMP#bs.f-avr = 0 then next.
     2302           If  Tog-Qnty = true  and I <= xBSAmount Then DO:
     2303                run display-line-tmp in this-procedure (i).  end.
     2304           If  Tog-Qnty = false  Then  DO:
     2305               run display-line-tmp in this-procedure (i). end.
     2306           End.
     2307       End.
     2308       when  "grp-goods":U then do:
     2309         if xtog-lavel = false then do:
     2310           For each TMP#bs where
     2311           ( Tog-Qnty = false OR TMP#bs.f-avr <> 0 )
     2312            no-lock  BREAK by TMP#bs.grp-name BY
     2313           (if xSorttype = "sort-code":U  THEN string(TMP#bs.b-code)
     2314             ELSE if xSorttype = "sort-artic":U  THEN TMP#bs.artic
     2315                   ELSE  string(TMP#bs.f-avr,"-9999999999.999"))  :
     2316                       i = i + 1 .
     2317               if First-of(TMP#bs.grp-name) then do:
     2318                 run sub-head in this-procedure (tmp#bs.grp-name).
     2319                 End.
     2320               If  Tog-Qnty = true  and I <= xBSAmount Then  Run display-line-tMP(i).
     2321               If  Tog-Qnty = false Then   Run display-line-tMP(i).
     2322               if last-of(TMP#bs.grp-name) then do :
     2323                  i = 0.
     2324                  run sub-foot in this-procedure (tmp#bs.grp-name).
     2325                  End.
     2326               End.
     2327          end.
     2328          else do:
     2329           for each tmp#bs where
     2330           ( tog-qnty = false or tmp#bs.f-avr <> 0 )
     2331            no-lock  break
     2332             by (n-lavel(tmp#bs.grp-name,xlavel))
     2333             by str
     2334             by (if xsorttype = "sort-code":u  then string(tmp#bs.b-code)
     2335                                               else
     2336                                                 if xsorttype = "sort-artic":u
     2337                                                    then tmp#bs.artic
     2338                                                    else  string(tmp#bs.f-avr,"-9999999999.999"))  :
     2339              str = n-lavel(input tmp#bs.grp-name, input xlavel ) .
     2340              i = i + 1 .
     2341               if First-of(str) then do:
     2342                 run sub-head in this-procedure (str).
     2343                 End.
     2344               If  Tog-Qnty = true  and I <= xBSAmount Then  run display-line-tmp in this-procedure (i).
     2345               If  Tog-Qnty = false Then   run display-line-tmp in this-procedure (i).
     2346               if last-of(str) then do :
     2347                  i = 0.
     2348                  run sub-foot in this-procedure (str).
     2349                  End.
     2350           end.
     2351          end.
     2352        end.
     2353     End case.
     2354   END PROCEDURE.
     2355   PROCEDURE display-line-tMP :
     2356   define input parameter i as int no-undo.
     2357   run display-str-ex ( ':',
     2358     i                     ,
     2359     TMP#bs.artic          ,
     2360     TMP#bs.F-zakaz        ,
     2361     TMP#bs.F-center-stock ,
     2362     TMP#bs.Prih           ,
     2363     TMP#bs.ostatok-end    ,
     2364     TMP#bs.f-avr          ,
     2365     TMP#bs.kASSA1         ,
     2366     TMP#bs.KAssa2         ,
     2367     TMP#bs.KAssa3         ,
     2368     TMP#bs.KAssa4         ,
     2369     TMP#bs.KAssa5         ,
     2370     TMP#bs.KAssa6
     2371     , "":U).
     2372   run calc-sub-itog in this-procedure (0).
     2373   END PROCEDURE.
     2374   PROCEDURE ob-line-1  :
     2375   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     2376   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     2377   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     2378   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     2379   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     2380   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     2381   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     2382   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     2383   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     2384   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2385   define input  parameter xTog-obj         as log no-undo.
     2386   define input  parameter xi               as int no-undo.
     2387   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     2388   define output  parameter ret-str         as char  no-undo.
     2389   define variable  First-sum   like ub.stk-line.fact-qnty   no-undo.
     2390   define variable  Second-sum  like ub.stk-line.fact-qnty   no-undo.
     2391   define variable  Temp-First-sum   like ub.stk-line.fact-qnty   no-undo.
     2392   define variable  Temp-Second-sum  like ub.stk-line.fact-qnty   no-undo.
     2393     if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     2394     Assign First-sum = 0 Second-sum = 0 Temp-First-sum = 0 Temp-Second-sum = 0 ret-str = "" .
     2395     For each Temp#obj-list   no-lock BREAK by Temp#obj-list.grp-name :
     2396       FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     2397         For each  ub.ot-line where
     2398                                 ub.ot-line.artic         = x-artic
     2399                           AND   ub.ot-line.fact-order   <= x-fact-order-2
     2400                           AND   ub.ot-line.fact-order   >= x-fact-order-1
     2401                           AND   ub.ot-line.obj-code     = Temp#obj-list.obj-code
     2402                           AND   ub.ot-line.obj-type     = Temp#obj-list.obj-type
     2403                           AND   ub.ot-line.prod-code    = x-prod-code
     2404                           AND   ub.ot-line.prod-type    = x-prod-type
     2405                           AND   ub.ot-line.sum-type     = 'crsa':U
     2406                           AND   ub.ot-line.ext-doc-type = temp#sum-type.sum-type
     2407                              no-lock  :
     2408               Assign
     2409               First-sum      = First-sum + ub.ot-line.fact-qnty
     2410               Temp-First-sum = Temp-First-sum + ub.ot-line.fact-qnty.
     2411         End.
     2412       End.
     2413       if LAST-of (Temp#obj-list.grp-name) Then
     2414         Assign ret-str = ret-str + String(decimal(Temp-first-sum) )
     2415                ret-str = ret-str + CHR(9)
     2416                Temp-First-sum  = 0 .
     2417    End.
     2418    Quntity = first-sum.
     2419   END PROCEDURE.
     2420   Procedure Sub-head :
     2421   define input parameter p1 as character no-undo .
     2422     temp-str = string("ГРУППА : " + p1 ).
     2423                if Make-Excel then  put   stream ForExcel unformatted temp-str format "X(100)" SKIP.
     2424    End procedure.
     2425   Procedure Sub-Foot :
     2426   define input parameter p1 as character no-undo .
     2427     temp-str = string("Итого по"+ CHR(9) + " ГРУППА : " + p1 ).
     2428     run di ("b1", 1, "Итого по",p1,"","","b1").
     2429     run clear-b1.
     2430    End procedure.
     2431    procedure display-line :
     2432     do
     2433     on error undo, return error return-value
     2434     :
     2435     end.
     2436    end procedure.
