     1256   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1257   define variable  str  as char format "X(60)"  no-undo.
     1258   define variable  str2 as char no-undo.
     1259   define variable v-r as character no-undo init "" .
     1260   define variable  i#i as int no-undo.
     1261   STR = "".
     1262   repeat i#i =1 to lavel#:
     1263       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1264       else do:
     1265           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1266           if not error-status:error  and str2 <> "":u then
     1267                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1268           end.
     1269   end.
     1270   if str <> ? then do:
     1271   v-r = str + chr(47) .
     1272   end.
     1273   RETURN v-r .
     1274   END FUNCTION.
     1275   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1276     if num-entries(string(p-dec), '.') = 2
     1277       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1278       else return( string(p-dec)) .
     1279   end function.
     1280   function format-point-to-comma returns char (input orig as char ) .
     1281   define variable rtext as character no-undo .
     1282   define variable strt as integer no-undo .
     1283   define variable leng as integer no-undo .
     1284   assign rtext = orig .
     1285   repeat:
     1286     strt =  index(rtext,'.').
     1287     if strt = 0 then leave.
     1288     leng = 1.
     1289     substring(rtext,strt,leng,"character") = v-delim .
     1290   end.
     1291   return rtext.
     1292   end function.
     1293   function format-excel-text returns char ( input start-text as char ) :
     1294   def var  i    as int no-undo.
     1295   def var  ch   as char no-undo.
     1296   def var  n    as int no-undo.
     1297   def var  ipos as int no-undo.
     1298     n = num-entries(trim(start-text), chr(10)) - 1 .
     1299     do i = 1 to n :
     1300       ipos = index( start-text, chr(10)).
     1301       if ipos > 0 then
     1302         substr( start-text, ipos, 1 ) = ' '.
     1303     end.
     1304     n = num-entries(trim(start-text), chr(13)) - 1 .
     1305     do i = 1 to n :
     1306       ipos = index( start-text, chr(13)).
     1307       if ipos > 0 then
     1308         substr( start-text, ipos, 1 ) = ' '.
     1309     end.
     1310     if index( start-text, '"' ) = 0 then
     1311       start-text =  '="'   + trim( start-text) + '"'   .
     1312       else do:
     1313         n = num-entries(trim(start-text), '"') - 1.
     1314         do i = 1 to n :
     1315           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1316         end.
     1317         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1318         start-text = '="'  + ch  + '"' .
     1319       end.
     1320     return start-text.
     1321   end.
     1322   function excel-sum returns char (input p-dec as decimal ).
     1323     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1324   end function.
     1325   function excel-qnty returns char (input p-dec as decimal ).
     1326     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1327   end function.
     1328   function format-excel-text-macr returns char ( input start-text as char ) :
     1329   def var  i    as int no-undo.
     1330   def var  ch   as char no-undo.
     1331   def var  n    as int no-undo.
     1332   def var  ipos as int no-undo.
     1333     n = num-entries(trim(start-text), chr(10)) - 1 .
     1334     do i = 1 to n :
     1335       ipos = index( start-text, chr(10)).
     1336       if ipos > 0 then
     1337         substring( start-text, ipos , 1 ) = ' '.
     1338     end.
     1339     n = num-entries(trim(start-text), chr(13)) - 1 .
     1340     do i = 1 to n :
     1341       ipos = index( start-text, chr(13)).
     1342       if ipos > 0 then
     1343         substring( start-text, ipos, 1 ) = ' '.
     1344     end.
     1345     if index( start-text, '"' ) = 0 then
     1346       start-text =  '"'   + trim( start-text) + '"'   .
     1347       else do:
     1348         n = num-entries(trim(start-text), '"') - 1.
     1349         do i = 1 to n :
     1350           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1351         end.
     1352         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1353         start-text = '"'  + ch  + '"' .
     1354       end.
     1355     n = num-entries(trim(start-text), chr(10)) - 1 .
     1356     do i = 1 to n :
     1357       ipos = index( start-text, chr(10)).
     1358       if ipos > 0 then
     1359         substring( start-text, ipos , 1 ) = ' '.
     1360     end.
     1361       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1362     return start-text.
     1363   end.
     1364   PROCEDURE report-execute :
     1365   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1366   case x-set_pay_type :
     1367     when 1 then do:
     1368           tprintrubl = ( var-report-r-b = 'rubl':U ) .
     1369     end.
     1370     when 2 or when 3 then do:
     1371           if x-set_val_type = 1  then tprintrubl = yes .
     1372           if x-set_val_type = 2  then tprintrubl = no  .
     1373     end.
     1374   end case.
     1375     run waitfram-show( 'Подождите ...' ) .
     1376      output stream OutStream to value( string( session:temp-directory +
     1377                               "rpt" + string( g#report-num ) ) )      .
     1378      run maket.
     1379      run report-exec1.
     1380     output stream outstream close.
     1381     run waitfram-hide .
     1382     if Make-Excel then output stream ForExcel close.
     1383     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1384   END PROCEDURE.
     1385   PROCEDURE foreach :
     1386    R = R + 1.
     1387   If Integer(10) = 0 Then Temp1  = 100  .
     1388                         Else Temp1 = Integer(10) .
     1389        IF ( R modulo Temp1 = 0 ) AND ( R >= Temp1 ) then
     1390            RUN waitfram-show( "Обработано строк : " + string( R )) .
     1391     run clear-item.
     1392     run zakaz.
     1393     if not show-negativ  and  f-zakaz  = 0 then return.
     1394      run ob-line ( input   x-store-code,input   x-store-type,input   gds-zap-artic,input   gds-zap-prod-code ,
     1395         INPUT   gds-zap-prod-type,
     1396         INPUT   Fact-order-2,
     1397         INPUT   Fact-order-2,
     1398         input   'crsa':U ,input   '##,##':U, input   "", input   xTog-obj ,
     1399         input   3 ,
     1400         output  ostatok-end[1] ,
     1401         output  ret-str[8] ) .
     1402      run ob-line-1 ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code   ,
     1403         INPUT   gds-zap-prod-type   ,
     1404         INPUT   Fact-order-1,
     1405         INPUT   Fact-order-2,
     1406         input   'crsa':U    ,  input   '##,##':U, input   "", input   xTog-obj ,
     1407         input   1 ,
     1408         output prih[1] ,
     1409         output ret-str[1]).
     1410   F-center-stock =  f-zakaz - prih[1].
     1411      RUN ob-line-1 ( input   x-store-code   , input   x-store-type   , INPUT   gds-zap-artic       ,  INPUT   gds-zap-prod-code   ,      INPUT   gds-zap-prod-type   ,
     1412         INPUT   Fo0,
     1413         INPUT   Fo02,
     1414         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xTog-obj ,
     1415         input   2 ,
     1416         output kassa[1] ,
     1417         output ret-str[2]  ).
     1418    if Showorders = false THEN DO:
     1419      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1420         input   fo1,
     1421         input   fo12,
     1422         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1423         input   2 ,
     1424         output kassa[2] ,
     1425         output ret-str[3]  ).
     1426      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1427         input   fo2,
     1428         input   fo22,
     1429         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1430         input   2 ,
     1431         output kassa[3] ,
     1432         output ret-str[4]  ).
     1433      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1434         input   fo3,
     1435         input   fo32,
     1436         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1437         input   2 ,
     1438         output kassa[4] ,
     1439         output ret-str[5]  ).
     1440      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1441         input   fo4,
     1442         input   fo42,
     1443         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1444         input   2 ,
     1445         output kassa[5] ,
     1446         output ret-str[6]  ).
     1447      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1448         input   fo5,
     1449         input   fo52,
     1450         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1451         input   2 ,
     1452         output kassa[6] ,
     1453         output ret-str[7]  ).
     1454   End.
     1455      f-avr =  round(kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     1456        IF   f-zakaz  = 0 AND
     1457             Prih[1] = 0 and
     1458             kassa[1] = 0 and
     1459             kassa[2] = 0 and
     1460             kassa[3] = 0 and
     1461             kassa[4] = 0 and
     1462             kassa[5] = 0 and
     1463             kassa[6] = 0 and
     1464             ostatok-end[1] = 0
     1465             THEN RETURN.
     1466         rr = rr + 1 .
     1467         run maketemptable  .
     1468   END PROCEDURE.
