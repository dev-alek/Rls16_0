      649   define variable v-waitfram-action01         as character   no-undo .
      650   define variable v-waitfram-action02         as character   no-undo .
      651   define variable v-waitfram-action03         as character   no-undo .
      652   define variable mWaitFramTextBeg            as character   no-undo.
      653   define variable mWaitFramTextEnd            as character   no-undo.
      654   define variable mWaitFramView               as logical     no-undo.
      655   define variable mWaitProcEvent              as logical     no-undo init yes.
      656   define variable mWaitFramInterval           as integer     no-undo init 1 .
      657   define variable mWaitFramStop               as logical     no-undo.
      658   define variable mWaitFramStopUser           as logical     no-undo.
      659   define variable mWaitFramStopTimeOut        as logical     no-undo.
      660   define variable mWaitFramStartProc          as datetime-tz no-undo.
      661   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      662   define button B-WaitFramStop auto-end-key
      663        label "Стоп"
      664        size 10 by 1 tooltip "Остоновить процесс".
      665   define button B-viewProcInfo
      666        label "Информация"
      667        size 15 by 1 tooltip "Информация о процесс".
      668   define frame waitfram
      669     v-waitfram-action01 format "x(72)" no-label skip
      670     v-waitfram-action02 format "x(72)" no-label skip
      671     v-waitfram-action03 format "x(72)" no-label skip
      672     B-viewProcInfo
      673     B-WaitFramStop at row 4 col 30
      674     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      675     .
      676   define new global shared variable mBatchMode as logical no-undo init ?.
      677   define variable mFramBachModHandle as handle no-undo.
      678   mFramBachModHandle = frame waitfram:handle.
      679   define variable mFameOldVis as logical no-undo.
      680   define variable mVisCUrentVin as logical no-undo.
      681   if session:batch-mode
      682   then
      683      mBatchMode = yes.
      684   if mBatchMode = ? then do:
      685     mVisCUrentVin = current-window:visible.
      686     mFameOldVis = mFramBachModHandle:visible.
      687     mFramBachModHandle:visible  = yes.
      688     mBatchMode = mFramBachModHandle:visible ne yes.
      689     mFramBachModHandle:visible = mFameOldVis.
      690     current-window:visible = mVisCUrentVin.
      691   end.
      692    if  log-manager:logfile-name ne ?
      693     then DO:
      694         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      695         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      696         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      697     end.
      698   on choose of B-WaitFramStop in frame waitfram
      699   do:
      700     mWaitFramStop = yes.
      701     mWaitFramStopUser = yes.
      702   end.
      703   function waitfram-check-timeout returns logical():
      704      define variable vtime as int64 no-undo.
      705      if mWaitFramStopTimeOut
      706      then
      707         return yes.
      708      vtime = ( now - mWaitFramStartProc ) / 1000 .
      709      if     mWaitFramTimeOut ne ?
      710         and mWaitFramTimeOut ne 0
      711         and mWaitFramTimeOut lt vtime
      712      then do:
      713         mWaitFramStopTimeOut = yes.
      714      end.
      715      return mWaitFramStopTimeOut.
      716   end.
      717   procedure waitfram-hide :
      718     if not session:batch-mode
      719     then do
      720     on error undo, return error return-value
      721     :
      722       pause 0 before-hide .
      723       if not mBatchMode then
      724         hide frame waitfram .
      725     if     not mWaitFramView
      726        and mWaitProcEvent
      727     then
      728       process events .
      729     end.
      730   end procedure.
      731   procedure waitfram-show :
      732     define input  parameter p-message as character no-undo .
      733     define variable v-left-margin as integer   no-undo .
      734     if not session:batch-mode
      735     then do
      736     on error undo, return error return-value
      737     :
      738       if length(p-message) <= 70 then do:
      739         assign
      740           v-left-margin = integer((70 - length(p-message)) / 2)
      741         .
      742         assign
      743           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      744         .
      745         assign
      746           v-waitfram-action01 = " "
      747           v-waitfram-action02 = " "
      748                                    + fill(" ", v-left-margin)
      749                                    + p-message
      750           v-waitfram-action03 = " "
      751         .
      752       end.
      753       else do:
      754         define variable vRindex1 as integer no-undo.
      755         define variable vRindex2 as integer no-undo.
      756         vRindex1 = r-index(p-message," ",70).
      757         if vRindex1 = 0
      758         then
      759            vRindex1 = 70.
      760         if length(p-message)  <= vRindex1 + 70 then do:
      761           assign
      762             v-waitfram-action01 = " "
      763             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      764             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      765           .
      766         end.
      767         else do:
      768           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      769           if vRindex2 <= vRindex1
      770           then
      771              vRindex2 = vRindex1 + 70.
      772           assign
      773             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      774             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      775             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      776           .
      777         end.
      778       end.
      779       B-viewProcInfo:visible   in frame waitfram = no.
      780       B-viewProcInfo:sensitive in frame waitfram = no.
      781       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      782       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      783       if  (   mWaitFramView
      784          or  mWaitProcEvent)
      785          and not mBatchMode
      786       then
      787          display
      788             v-waitfram-action01 skip
      789             v-waitfram-action02 skip
      790             v-waitfram-action03 skip
      791          with frame waitfram .
      792       if     mWaitFramView
      793          then do:
      794             if     mWaitFramInterval ne ?
      795                and not mBatchMode
      796             then
      797                wait-for go of frame waitfram pause mWaitFramInterval.
      798          end.
      799          else
      800             if     mWaitProcEvent
      801                and not mBatchMode
      802             then
      803                process events .
      804     end.
      805   end procedure.
      806      procedure waitfram-show-this:
      807         define input  parameter iInterval as int64 no-undo.
      808         define variable vtime as int64 no-undo.
      809         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      810         mWaitFramInterval = iInterval.
      811         run waitfram-show (substitute("&1&2 &3&4" ,
      812                                       mWaitFramTextBeg ,
      813                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      814                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      815                                       mWaitFramTextEnd
      816                                      )
      817                           ).
      818      end.
      819      procedure WaitFramRunPause:
      820         define input  parameter iInterval as dec no-undo.
      821         define variable vStart  as datetime-tz no-undo.
      822         define variable vend    as datetime-tz no-undo.
      823         define variable vint as int64 no-undo.
      824         define variable vOk as logical no-undo.
      825         vStart = now.
      826         vend   = vStart.
      827         publish "WaitFramPause" (iInterval,output vOk).
      828         vend   =  now.
      829         vint = vend - vStart.
      830         vint = iInterval - vint / 1000.
      831         if     not mWaitFramStop
      832            and (   vint > 0
      833                 or (    not vOk
      834                     and iInterval eq ?
      835                     )
      836                 )
      837         then
      838            run waitfram-show-this (iInterval).
      839         vend   =  now.
      840         vint = vend - vStart.
      841         vint = iInterval - vint / 1000.
      842         if     not mWaitFramStop
      843            and vint > 0
      844         then do:
      845            run gbl/pause.p (vint * 1000).
      846         end.
      847         if iInterval ne ?
      848         then
      849            publish "WaitFramStop".
      850         waitfram-check-timeout().
      851      end.
      852      procedure WaitFramWaitFor:
      853         define input  parameter iInterval as dec no-undo.
      854         assign
      855            mWaitFramStartProc   = now
      856            mWaitFramStopUser    = no
      857            mWaitFramStopTimeOut = no
      858         .
      859         block-wait:
      860         do while not mWaitFramStop:
      861            run WaitFramRunPause (iInterval).
      862            if  waitfram-check-timeout()
      863            then do:
      864               leave block-wait.
      865            end.
      866         end.
      867         run waitfram-hide.
      868      end.
      869   procedure waitfram-join :
      870     define input  parameter p-line-1  as character no-undo .
      871     define input  parameter p-line-2  as character no-undo .
      872     define input  parameter p-line-3  as character no-undo .
      873     define output parameter p-message as character no-undo .
      874     do
      875     on error undo, return error return-value
      876     :
      877       assign
      878         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      879                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      880                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      881       .
      882     end.
      883   end procedure.
      884   function waitfram-join-function returns character
      885     (input p-line-1 as character
      886     ,input p-line-2 as character
      887     ,input p-line-3 as character
      888     ).
      889     define variable v-message as character no-undo .
      890     run waitfram-join in this-procedure
      891       (input  p-line-1
      892       ,input  p-line-2
      893       ,input  p-line-3
      894       ,output v-message
      895       ) .
      896     return v-message .
      897   end function .
