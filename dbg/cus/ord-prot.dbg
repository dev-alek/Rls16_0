        1   define input  parameter p-ord-doc  as character no-undo .
        2   define input  parameter p-gds-code as integer   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Протокол расчета заказа".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   DEFINE TEMP-TABLE TT-protocol NO-UNDO
       68     field v-date as char
       69     field v-time as char
       70     field obj-type as char
       71     field obj-code as int
       72     field v-par as char
       73     field v-val as char
       74   index pi
       75   v-date desc
       76   v-time desc
       77   obj-type ASCENDING
       78   obj-code ASCENDING
       79   v-par  ASCENDING
       80   .
       81   define variable v-obj as character no-undo .
       82   DEFINE BUTTON B-Cancel AUTO-END-KEY
       83        LABEL "Выход"
       84        SIZE 10 BY 1
       85        BGCOLOR 8 .
       86   DEFINE BUTTON B-Help
       87        LABEL "&Help"
       88        SIZE 10 BY 1
       89        BGCOLOR 8 .
       90   DEFINE QUERY BROWSE-3 FOR
       91         TT-protocol SCROLLING.
       92   DEFINE BROWSE BROWSE-3
       93     QUERY BROWSE-3 NO-LOCK DISPLAY
       94         TT-protocol.v-date  column-label "Дата" Format "x(11)"
       95   TT-protocol.v-time        column-label "Время"
       96   TT-protocol.obj-type + string(TT-protocol.obj-code )  @ v-obj column-label "Объект"  Format "x(11)"
       97   TT-protocol.v-par column-label "Параметр расчета"  Format "x(100)"
       98   TT-protocol.v-val column-label "Значение"  Format "x(100)"
       99       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 19.25 FIT-LAST-COLUMN.
      100   DEFINE FRAME Dialog-Frame
      101        B-Cancel AT ROW 1 COL 1
      102        B-Help AT ROW 1 COL 72
      103        BROWSE-3 AT ROW 2.25 COL 1.5 WIDGET-ID 200
      104        SPACE(0.37) SKIP(1.24)
      105       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      106            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      107            TITLE "Протокол расчета заказа"
      108            CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      109   ASSIGN
      110          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      111          FRAME Dialog-Frame:HIDDEN           = TRUE.
      112   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      113   DO:
      114     APPLY "END-ERROR":U TO SELF.
      115   END.
      116   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      117   OR HELP OF FRAME Dialog-Frame
      118   DO:
      119   END.
      120   ON ROW-DISPLAY OF BROWSE-3 IN FRAME Dialog-Frame
      121   DO:
      122         tt-protocol.v-par:bgcolor in browse BROWSE-3  = ?.
      123         tt-protocol.v-val:bgcolor in browse BROWSE-3  = ? .
      124         tt-protocol.v-date:bgcolor in browse BROWSE-3  = ?.
      125         tt-protocol.v-time:bgcolor in browse BROWSE-3  = ?.
      126         v-obj:bgcolor in browse BROWSE-3  = ? .
      127         tt-protocol.v-par:fgcolor in browse BROWSE-3  = ?.
      128         tt-protocol.v-val:fgcolor in browse BROWSE-3  = ? .
      129         tt-protocol.v-date:fgcolor in browse BROWSE-3  = ?.
      130         tt-protocol.v-time:fgcolor in browse BROWSE-3  = ?.
      131         v-obj:bgcolor in browse BROWSE-3  = ? .
      132     if tt-protocol.v-par begins "17" or
      133        tt-protocol.v-par begins "19" then do:
      134          tt-protocol.v-par:bgcolor in browse BROWSE-3  = 4   .
      135          tt-protocol.v-val:bgcolor in browse BROWSE-3  = 4   .
      136          tt-protocol.v-date:bgcolor in browse BROWSE-3  = 4   .
      137          tt-protocol.v-time:bgcolor in browse BROWSE-3  = 4   .
      138          v-obj:bgcolor in browse BROWSE-3  = 4   .
      139          tt-protocol.v-par:fgcolor in browse BROWSE-3  = 15   .
      140          tt-protocol.v-val:fgcolor in browse BROWSE-3  = 15  .
      141          tt-protocol.v-date:Fgcolor in browse BROWSE-3  = 15 .
      142          tt-protocol.v-time:Fgcolor in browse BROWSE-3  = 15 .
      143          v-obj:Fgcolor in browse BROWSE-3  = 15  .
      144     end.
      145     if index(tt-protocol.v-par ,"рассчитано заказа" ) > 0 then do:
      146          tt-protocol.v-par:fgcolor in browse BROWSE-3  = 1   .
      147          tt-protocol.v-val:fgcolor in browse BROWSE-3  = 1   .
      148          tt-protocol.v-date:Fgcolor in browse BROWSE-3  = 1 .
      149          tt-protocol.v-time:Fgcolor in browse BROWSE-3  = 1 .
      150          v-obj:Fgcolor in browse BROWSE-3  = 1  .
      151     end.
      152   END.
      153   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      154   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      155   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   on help of frame Dialog-Frame
      157   do:
      158     run gbl/app_help.p
      159       (input this-procedure :file-name
      160       ,input ''
      161       ,input ?
      162       ) no-error.
      163     if error-status :error then do:
      164       message
      165         "Ошибка при вызове помощи"
      166         error-status :get-message(1)
      167         view-as alert-box .
      168     end.
      169   end.
      170   run minbtn-set in this-procedure .
      171   on choose of b-help in frame Dialog-Frame
      172   do:
      173     apply "help":u to frame Dialog-Frame .
      174   end.
      175   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   procedure minbtn-set :
      177       do
      178           on error undo, return error return-value
      179           :
      180           define variable ii              as integer       no-undo .
      181           define variable fh              as widget-handle no-undo .
      182           define variable hh              as widget-handle no-undo .
      183           define variable v-h             as handle        extent 4 no-undo .
      184           define variable v-name-button   as character     no-undo .
      185           define variable v-help-old-x    as decimal       no-undo .
      186           define variable v-help-old-y    as decimal       no-undo .
      187           define variable v-help-old-size as decimal       no-undo .
      188           define variable v-frame-width   as decimal       no-undo .
      189           define variable jj              as integer       no-undo .
      190           do
      191               on error undo, return error
      192               :
      193               assign
      194                   v-frame-width = frame Dialog-Frame:width - 0.3
      195                   fh            = frame Dialog-Frame:first-child
      196                   hh            = fh:first-child
      197                   ii            = 1
      198                   .
      199               do while valid-handle(hh):
      200                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      201                   do:
      202                       case lc(hh:name) :
      203                           when "b-help" then
      204                               do:
      205                                   hh:load-image-up("cmp/b-help.bmp":u) .
      206                                   hh:load-image-down("cmp/b-help.bmp":u) .
      207                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      208                                   hh:TOOLTIP = "Помощь" .
      209                                   v-help-old-x = hh:column .
      210                                   v-help-old-y = hh:row    .
      211                                   v-help-old-size = hh:width .
      212                                   hh:width-chars = 2.5 .
      213                               end.
      214                           when "b-print" then
      215                               do:
      216                                   hh:load-image("cmp/b-print.bmp":u) .
      217                                   hh:TOOLTIP = "Печать" .
      218                                   v-h[ii] = hh:handle .
      219                                   ii = ii + 1 .
      220                                   hh:width-chars = 3 .
      221                               end.
      222                           when "b-history" or
      223                           when "b-hist" then
      224                               do:
      225                                   hh:load-image("cmp/b-hist.bmp":u) .
      226                                   hh:TOOLTIP = "История" .
      227                                   v-h[ii] = hh:handle .
      228                                   ii = ii + 1 .
      229                                   hh:width-chars = 3 .
      230                               end.
      231                           when "b-sch" then
      232                               do:
      233                                   hh:load-image("cmp/b-sch.bmp":u) .
      234                                   hh:TOOLTIP = "Установка Фильтра" .
      235                                   v-h[ii] = hh:handle .
      236                                   ii = ii + 1 .
      237                                   hh:width-chars = 3 .
      238                               end.
      239                           when "b-hist-user" then
      240                               do:
      241                                   hh:load-image("cmp/b-hist.bmp":u) .
      242                                   hh:TOOLTIP = "История пользователя" .
      243                                   ii = ii + 1 .
      244                               end.
      245                       end case.
      246                   end.
      247                   hh = hh:next-sibling.
      248               end.
      249               b-help:column = v-frame-width - b-help:width-chars.
      250               jj = 0.
      251               repeat ii = 4 to 1 by -1 :
      252                   if valid-handle (v-h[ii] ) then
      253                   do:
      254                       jj  = jj + 1 .
      255                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      256                       v-h[ii]:row    = v-help-old-y .
      257                   end.
      258               end.
      259           end.
      260       end.
      261   end procedure.
      262   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      263   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      264   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      265   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      266   define variable v-diasize-current-frame-width  as decimal   no-undo .
      267   define variable v-diasize-current-frame-height as decimal   no-undo .
      268   define variable v-diasize-change-size          as logical   no-undo .
      269   define variable v-diasize-resize-button        as handle    no-undo .
      270   define variable v-diasize-wndmax               as logical   no-undo .
      271   define variable v-diasize-wndstore             as logical   no-undo .
      272   define variable v-diasize-proc-name            as character no-undo .
      273   define variable v-diasize-browse-handle        as handle    no-undo .
      274   define variable v-diasize-browse-number        as integer   no-undo .
      275   define variable v-diasize-need-full-display    as logical   no-undo init false .
      276   define temp-table temp-diasize-handle no-undo
      277     field handle-value  as handle
      278     field save-position as decimal
      279     index xpk is primary unique handle-value
      280     .
      281   define temp-table temp-browse-handle no-undo
      282     field browse-type   as character
      283     field browse-number as integer
      284     field browse-handle as handle
      285     field original-size as decimal
      286     index xpk is primary unique browse-type browse-number
      287     index xie browse-type browse-handle
      288   .
      289   procedure diasize_change-height :
      290     define input  parameter p-change-value  as decimal   no-undo .
      291     define input  parameter p-move-resize   as logical   no-undo .
      292     define variable v-field-group-handle    as handle    no-undo .
      293     define variable v-object-handle         as handle    no-undo .
      294     define variable v-frame-height          as decimal   no-undo .
      295     define variable v-frame-virtual-height  as decimal   no-undo .
      296     define variable v-browse-height         as decimal   no-undo .
      297     define variable v-window-height         as decimal   no-undo .
      298     define variable v-window-virtual-height as decimal   no-undo .
      299     define variable v-change-sign           as integer   no-undo .
      300     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      301     define buffer buf_temp-browse-handle  for temp-browse-handle .
      302     if p-change-value > 0
      303     then do:
      304       if frame Dialog-Frame :height + p-change-value
      305           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      306       then do:
      307         assign
      308           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      309                           - (frame Dialog-Frame :height-chars)
      310         .
      311         if p-change-value <= 0
      312         then do:
      313           run diasize_position-resize-button in this-procedure .
      314           return .
      315         end.
      316       end.
      317     end.
      318     if p-change-value < 0
      319     then do:
      320       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      321       then do:
      322         assign
      323           p-change-value = v-diasize-orig-frame-height
      324                          - (frame Dialog-Frame :height-chars)
      325         .
      326         if p-change-value >= 0
      327         then do:
      328           run diasize_position-resize-button in this-procedure .
      329           return .
      330         end.
      331       end.
      332     end.
      333     if p-change-value >= 0
      334     then do:
      335       assign
      336         v-change-sign = 1
      337       .
      338     end.
      339     else do:
      340       assign
      341         v-change-sign = -1
      342       .
      343     end.
      344     assign
      345       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      346     .
      347     if p-change-value = 0
      348     then do:
      349       run diasize_position-resize-button in this-procedure .
      350       return .
      351     end.
      352     move_block:
      353     do
      354     on error undo move_block, retry move_block
      355     :
      356       if retry
      357       then do:
      358         do
      359         on error undo move_block, leave move_block
      360         :
      361           if p-change-value > 0
      362           then do:
      363             for each buf_temp-diasize-handle
      364             on error undo, next
      365             :
      366               assign
      367                 v-object-handle = buf_temp-diasize-handle.handle-value
      368               .
      369               if v-object-handle <> v-diasize-resize-button
      370               then do:
      371                 assign
      372                   v-object-handle :row = buf_temp-diasize-handle.save-position
      373                 .
      374               end.
      375             end.
      376             assign
      377               v-diasize-browse-handle :height = v-browse-height
      378             .
      379             for each buf_temp-browse-handle
      380               where buf_temp-browse-handle.browse-type = 'height':u
      381             on error undo, next
      382             :
      383               assign
      384                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      385               .
      386             end.
      387             assign
      388               frame Dialog-Frame :height = v-frame-height
      389             .
      390             if frame Dialog-Frame :scrollable = true
      391             then do:
      392               assign
      393                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      394               .
      395             end.
      396             run diasize_position-resize-button in this-procedure .
      397           end.
      398           else do:
      399             if frame Dialog-Frame :scrollable = true
      400             then do:
      401               assign
      402                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      403               .
      404             end.
      405             assign
      406               frame Dialog-Frame :height = v-frame-height
      407             .
      408             assign
      409               v-diasize-browse-handle :height = v-browse-height
      410             .
      411             for each buf_temp-browse-handle
      412               where buf_temp-browse-handle.browse-type = 'height':u
      413             on error undo, next
      414             :
      415               assign
      416                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      417               .
      418             end.
      419             for each buf_temp-diasize-handle
      420             on error undo, next
      421             :
      422               assign
      423                 v-object-handle = buf_temp-diasize-handle.handle-value
      424               .
      425               if v-object-handle <> v-diasize-resize-button
      426               then do:
      427                 assign
      428                   v-object-handle :row = buf_temp-diasize-handle.save-position
      429                 .
      430               end.
      431             end.
      432             run diasize_position-resize-button in this-procedure .
      433           end.
      434           assign
      435             v-diasize-change-size = false
      436           .
      437           leave move_block .
      438         end.
      439       end.
      440       assign
      441         v-diasize-need-full-display = true
      442       .
      443       if v-diasize-change-size = false
      444       then do:
      445         assign
      446           v-diasize-change-size = true
      447         .
      448       end.
      449       else do:
      450         return .
      451       end.
      452       assign
      453         v-frame-height = frame Dialog-Frame :height
      454         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      455         v-browse-height = v-diasize-browse-handle :height
      456       .
      457       for each buf_temp-browse-handle
      458         where buf_temp-browse-handle.browse-type = 'height':u
      459       :
      460         assign
      461           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      462         .
      463       end.
      464       for each buf_temp-diasize-handle
      465       :
      466         delete buf_temp-diasize-handle .
      467       end.
      468       assign
      469         v-field-group-handle = frame Dialog-Frame :first-child
      470       .
      471       do while valid-handle(v-field-group-handle)
      472       :
      473         assign
      474           v-object-handle = v-field-group-handle :first-child
      475         .
      476         do while valid-handle(v-object-handle)
      477         :
      478           if  v-object-handle <> v-diasize-browse-handle :handle
      479           and can-query(v-object-handle, "row")
      480           and can-query(v-object-handle, "height")
      481           and ( v-object-handle :row > v-diasize-browse-handle :row )
      482           then do:
      483             find first buf_temp-browse-handle
      484               where buf_temp-browse-handle.browse-type   = 'height':u
      485                 and buf_temp-browse-handle.browse-handle = v-object-handle
      486               no-error .
      487             if available buf_temp-browse-handle
      488             then do:
      489             end.
      490             else do:
      491               create buf_temp-diasize-handle .
      492               assign
      493                 buf_temp-diasize-handle.handle-value  = v-object-handle
      494                 buf_temp-diasize-handle.save-position = v-object-handle :row
      495               .
      496             end.
      497           end.
      498           assign
      499             v-object-handle = v-object-handle :next-sibling
      500           .
      501         end.
      502         assign
      503           v-field-group-handle = v-field-group-handle :next-sibling
      504         .
      505       end.
      506       do with frame Dialog-Frame
      507       :
      508         hide v-diasize-resize-button .
      509         assign
      510           v-diasize-resize-button :row    = 1
      511           v-diasize-resize-button :column = 1
      512         .
      513       end.
      514       if p-change-value > 0
      515       then do:
      516         if frame Dialog-Frame :scrollable = true
      517         then do:
      518           assign
      519             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      520             no-error .
      521           if error-status :error
      522           or error-status :get-message(1) <> ""
      523           then do:
      524             undo move_block, retry move_block .
      525           end.
      526         end.
      527         assign
      528           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      529           no-error .
      530         if error-status :error
      531         or error-status :get-message(1) <> ""
      532         then do:
      533           undo move_block, retry move_block .
      534         end.
      535         assign
      536           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      537           no-error .
      538         if error-status :error
      539         or error-status :get-message(1) <> ""
      540         then do:
      541           undo move_block, retry move_block .
      542         end.
      543         for each buf_temp-browse-handle
      544           where buf_temp-browse-handle.browse-type = 'height':u
      545         on error undo move_block, retry move_block
      546         :
      547           assign
      548             buf_temp-browse-handle.browse-handle :height
      549               = buf_temp-browse-handle.browse-handle :height + p-change-value
      550             no-error .
      551           if error-status :error
      552           or error-status :get-message(1) <> ""
      553           then do:
      554             undo move_block, retry move_block .
      555           end.
      556         end.
      557         for each buf_temp-diasize-handle
      558         on error undo move_block, retry move_block
      559         :
      560           assign
      561             v-object-handle = buf_temp-diasize-handle.handle-value
      562           .
      563           if v-object-handle <> v-diasize-resize-button
      564           then do:
      565             assign
      566               v-object-handle :row = v-object-handle :row + p-change-value
      567               no-error .
      568             if error-status :error
      569             or error-status :get-message(1) <> ""
      570             then do:
      571               undo move_block, retry move_block .
      572             end.
      573           end.
      574         end.
      575       end.
      576       else do:
      577         for each buf_temp-diasize-handle
      578         on error undo move_block, retry move_block
      579         :
      580           assign
      581             v-object-handle = buf_temp-diasize-handle.handle-value
      582           .
      583           if v-object-handle <> v-diasize-resize-button
      584           then do:
      585             assign
      586               v-object-handle :row = v-object-handle :row + p-change-value
      587               no-error .
      588             if error-status :error
      589             or error-status :get-message(1) <> ""
      590             then do:
      591               undo move_block, retry move_block .
      592             end.
      593           end.
      594         end.
      595         assign
      596           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      597           no-error .
      598         if error-status :error
      599         or error-status :get-message(1) <> ""
      600         then do:
      601           undo move_block, retry move_block .
      602         end.
      603         for each buf_temp-browse-handle
      604           where buf_temp-browse-handle.browse-type = 'height':u
      605         on error undo move_block, retry move_block
      606         :
      607           assign
      608             buf_temp-browse-handle.browse-handle :height
      609               = buf_temp-browse-handle.browse-handle :height + p-change-value
      610             no-error .
      611           if error-status :error
      612           or error-status :get-message(1) <> ""
      613           then do:
      614             undo move_block, retry move_block .
      615           end.
      616         end.
      617         assign
      618           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      619           no-error .
      620         if error-status :error
      621         or error-status :get-message(1) <> ""
      622         then do:
      623           undo move_block, retry move_block .
      624         end.
      625         if frame Dialog-Frame :scrollable = true
      626         then do:
      627           assign
      628             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      629             no-error .
      630           if error-status :error
      631           or error-status :get-message(1) <> ""
      632           then do:
      633             undo move_block, retry move_block .
      634           end.
      635         end.
      636       end.
      637       if p-move-resize = true
      638       then do:
      639         run diasize_position-resize-button in this-procedure .
      640       end.
      641       if v-diasize-wndstore = true
      642       then do:
      643         if connected("ub") = true
      644         then do:
      645           define variable v-cntxt-db-num        as integer   no-undo .
      646           define variable v-cntxt-userid        as character no-undo .
      647           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      648                                             , OUTPUT v-cntxt-userid
      649                                             ) .
      650           run gbl/wndsizew.p
      651             (input  v-cntxt-db-num
      652             ,input  v-cntxt-userid
      653             ,input  v-diasize-proc-name
      654             ,input  'height':u
      655             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      656             ) .
      657         end.
      658       end.
      659     end.
      660     assign
      661       v-diasize-change-size = false
      662     .
      663   end procedure.
      664   procedure diasize_set-height :
      665     define input  parameter p-new-height  as decimal   no-undo .
      666     define input  parameter p-move-resize as logical   no-undo .
      667     do
      668     on error undo, return error return-value
      669     :
      670       run diasize_change-height in this-procedure
      671         (input  (p-new-height - frame Dialog-Frame :height)
      672         ,input  p-move-resize
      673         ) .
      674     end.
      675   end procedure.
      676   procedure diasize_change-width :
      677     define input  parameter p-change-value as decimal   no-undo .
      678     define input  parameter p-move-resize  as logical   no-undo .
      679     define variable v-field-group-handle   as handle    no-undo .
      680     define variable v-object-handle        as handle    no-undo .
      681     define variable v-frame-width          as decimal   no-undo .
      682     define variable v-frame-virtual-width  as decimal   no-undo .
      683     define variable v-browse-width         as decimal   no-undo .
      684     define variable v-window-width         as decimal   no-undo .
      685     define variable v-window-virtual-width as decimal   no-undo .
      686     define variable v-change-sign          as integer   no-undo .
      687     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      688     define buffer buf_temp-browse-handle  for temp-browse-handle .
      689     if p-change-value > 0
      690     then do:
      691       if frame Dialog-Frame :width + p-change-value >
      692           session :width-chars
      693       then do:
      694         assign
      695           p-change-value = session :width-chars - frame Dialog-Frame :width
      696         .
      697         if p-change-value <= 0
      698         then do:
      699           run diasize_position-resize-button in this-procedure .
      700           return .
      701         end.
      702       end.
      703     end.
      704     if p-change-value < 0
      705     then do:
      706       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      707       then do:
      708         assign
      709           p-change-value = v-diasize-orig-frame-width
      710                          - frame Dialog-Frame :width
      711         .
      712         if p-change-value >= 0
      713         then do:
      714           run diasize_position-resize-button in this-procedure .
      715           return .
      716         end.
      717       end.
      718     end.
      719     if p-change-value >= 0
      720     then do:
      721       assign
      722         v-change-sign = 1
      723       .
      724     end.
      725     else do:
      726       assign
      727         v-change-sign = -1
      728       .
      729     end.
      730     assign
      731       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      732     .
      733     if p-change-value = 0
      734     then do:
      735       run diasize_position-resize-button in this-procedure .
      736       return .
      737     end.
      738     move_block:
      739     do
      740     on error undo move_block, leave move_block
      741     :
      742       if retry
      743       then do:
      744         do
      745         on error undo move_block, leave move_block
      746         :
      747           if p-change-value > 0
      748           then do:
      749             for each buf_temp-diasize-handle
      750             on error undo, next
      751             :
      752               assign
      753                 v-object-handle = buf_temp-diasize-handle.handle-value
      754               .
      755               if v-object-handle <> v-diasize-resize-button
      756               then do:
      757                 assign
      758                   v-object-handle :col = buf_temp-diasize-handle.save-position
      759                 .
      760               end.
      761             end.
      762             assign
      763               v-diasize-browse-handle :width = v-browse-width
      764             .
      765             for each buf_temp-browse-handle
      766               where buf_temp-browse-handle.browse-type = 'width':u
      767             on error undo, next
      768             :
      769               assign
      770                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      771               .
      772             end.
      773             assign
      774               frame Dialog-Frame :width = v-frame-width
      775             .
      776             if frame Dialog-Frame :scrollable = true
      777             then do:
      778               assign
      779                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      780               .
      781             end.
      782             run diasize_position-resize-button in this-procedure .
      783           end.
      784           else do:
      785             if frame Dialog-Frame :scrollable = true
      786             then do:
      787               assign
      788                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      789               .
      790             end.
      791             assign
      792               frame Dialog-Frame :width = v-frame-width
      793             .
      794             for each buf_temp-browse-handle
      795               where buf_temp-browse-handle.browse-type = 'width':u
      796             on error undo, next
      797             :
      798               assign
      799                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      800               .
      801             end.
      802             assign
      803               v-diasize-browse-handle :width = v-browse-width
      804             .
      805             for each buf_temp-diasize-handle
      806             on error undo, next
      807             :
      808               assign
      809                 v-object-handle = buf_temp-diasize-handle.handle-value
      810               .
      811               if v-object-handle <> v-diasize-resize-button
      812               then do:
      813                 assign
      814                   v-object-handle :col = buf_temp-diasize-handle.save-position
      815                 .
      816               end.
      817             end.
      818             run diasize_position-resize-button in this-procedure .
      819           end.
      820           assign
      821             v-diasize-change-size = false
      822           .
      823           leave move_block .
      824         end.
      825       end.
      826       assign
      827         v-diasize-need-full-display = true
      828       .
      829       if v-diasize-change-size = false
      830       then do:
      831         assign
      832           v-diasize-change-size = true
      833         .
      834       end.
      835       else do:
      836         return .
      837       end.
      838       assign
      839         v-frame-width = frame Dialog-Frame :width
      840         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      841         v-browse-width = v-diasize-browse-handle :width
      842       .
      843       for each buf_temp-browse-handle
      844         where buf_temp-browse-handle.browse-type = 'width':u
      845       :
      846         assign
      847           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      848         .
      849       end.
      850       for each buf_temp-diasize-handle
      851       :
      852         delete buf_temp-diasize-handle .
      853       end.
      854       assign
      855         v-field-group-handle = frame Dialog-Frame :first-child
      856       .
      857       do while valid-handle(v-field-group-handle)
      858       :
      859         assign
      860           v-object-handle = v-field-group-handle :first-child
      861         .
      862         do while valid-handle(v-object-handle)
      863         :
      864           if  v-object-handle <> v-diasize-browse-handle :handle
      865           and v-object-handle <> v-diasize-resize-button
      866           and can-query(v-object-handle, "row")
      867           and can-query(v-object-handle, "height")
      868           and ( v-object-handle :col + v-object-handle :width
      869                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      870               )
      871           then do:
      872             find first buf_temp-browse-handle
      873               where buf_temp-browse-handle.browse-type   = 'width':u
      874                 and buf_temp-browse-handle.browse-handle = v-object-handle
      875               no-error .
      876             if available buf_temp-browse-handle
      877             then do:
      878             end.
      879             else do:
      880               create buf_temp-diasize-handle .
      881               assign
      882                 buf_temp-diasize-handle.handle-value  = v-object-handle
      883                 buf_temp-diasize-handle.save-position = v-object-handle :col
      884               .
      885             end.
      886           end.
      887           assign
      888             v-object-handle = v-object-handle :next-sibling
      889           .
      890         end.
      891         assign
      892           v-field-group-handle = v-field-group-handle :next-sibling
      893         .
      894       end.
      895       do with frame Dialog-Frame
      896       :
      897         hide v-diasize-resize-button .
      898         v-diasize-resize-button :row = 1.
      899         v-diasize-resize-button :column = 1.
      900       end.
      901       if p-change-value > 0
      902       then do:
      903         if frame Dialog-Frame :scrollable = true
      904         then do:
      905           assign
      906             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      907             no-error .
      908           if error-status :error
      909           or error-status :get-message(1) <> ""
      910           then do:
      911             undo move_block, retry move_block.
      912           end.
      913         end.
      914         assign
      915           frame Dialog-Frame :width = v-frame-width + p-change-value
      916           no-error .
      917         if error-status :error
      918         or error-status :get-message(1) <> ""
      919         then do:
      920           undo move_block, retry move_block.
      921         end.
      922         assign
      923           v-diasize-browse-handle :width = v-browse-width + p-change-value
      924         no-error .
      925         if error-status :error
      926         or error-status :get-message(1) <> ""
      927         then do:
      928           undo move_block, retry move_block.
      929         end.
      930         for each buf_temp-browse-handle
      931           where buf_temp-browse-handle.browse-type = 'width':u
      932         on error undo move_block, retry move_block
      933         :
      934           assign
      935             buf_temp-browse-handle.browse-handle :width
      936               = buf_temp-browse-handle.browse-handle :width + p-change-value
      937             no-error .
      938           if error-status :error
      939           or error-status :get-message(1) <> ""
      940           then do:
      941             undo move_block, retry move_block .
      942           end.
      943         end.
      944         for each buf_temp-diasize-handle
      945         on error undo move_block, retry move_block
      946         :
      947           assign
      948             v-object-handle = buf_temp-diasize-handle.handle-value
      949           .
      950           if v-object-handle <> v-diasize-resize-button
      951           then do:
      952             assign
      953               v-object-handle :col = v-object-handle :col + p-change-value
      954               no-error .
      955             if error-status :error
      956             or error-status :get-message(1) <> ""
      957             then do:
      958               undo move_block, retry move_block .
      959             end.
      960           end.
      961         end.
      962       end.
      963       else do:
      964         for each buf_temp-diasize-handle
      965         on error undo move_block, retry move_block
      966         :
      967           assign
      968             v-object-handle = buf_temp-diasize-handle.handle-value
      969           .
      970           if v-object-handle <> v-diasize-resize-button
      971           then do:
      972             assign
      973               v-object-handle :col = v-object-handle :col + p-change-value
      974               no-error .
      975             if error-status :error
      976             or error-status :get-message(1) <> ""
      977             then do:
      978               undo move_block, retry move_block .
      979             end.
      980           end.
      981         end.
      982         for each buf_temp-browse-handle
      983           where buf_temp-browse-handle.browse-type = 'width':u
      984         on error undo move_block, retry move_block
      985         :
      986           assign
      987             buf_temp-browse-handle.browse-handle :width
      988               = buf_temp-browse-handle.browse-handle :width + p-change-value
      989             no-error .
      990           if error-status :error
      991           or error-status :get-message(1) <> ""
      992           then do:
      993             undo move_block, retry move_block .
      994           end.
      995         end.
      996         assign
      997           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
      998           no-error .
      999         if error-status :error
     1000         or error-status :get-message(1) <> ""
     1001         then do:
     1002           undo move_block, retry move_block.
     1003         end.
     1004         assign
     1005           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1006         no-error .
     1007         if error-status :error
     1008         or error-status :get-message(1) <> ""
     1009         then do:
     1010           undo move_block, retry move_block.
     1011         end.
     1012         if frame Dialog-Frame :scrollable = true
     1013         then do:
     1014           assign
     1015             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1016           no-error .
     1017           if error-status :error
     1018           or error-status :get-message(1) <> ""
     1019           then do:
     1020             undo move_block, retry move_block.
     1021           end.
     1022         end.
     1023       end.
     1024       if p-move-resize
     1025       then do:
     1026         run diasize_position-resize-button in this-procedure .
     1027       end.
     1028       if v-diasize-wndstore = true
     1029       then do:
     1030         if connected("ub") = true
     1031         then do:
     1032           define variable v-cntxt-db-num        as integer   no-undo .
     1033           define variable v-cntxt-userid        as character no-undo .
     1034           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1035                                             , OUTPUT v-cntxt-userid
     1036                                             ) .
     1037           run gbl/wndsizew.p
     1038             (input  v-cntxt-db-num
     1039             ,input  v-cntxt-userid
     1040             ,input  v-diasize-proc-name
     1041             ,input  'width':u
     1042             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1043             ) .
     1044         end.
     1045       end.
     1046     end.
     1047     assign
     1048       v-diasize-change-size = false
     1049     .
     1050   end procedure.
     1051   procedure diasize_set-width :
     1052     define input  parameter p-new-width  as decimal   no-undo .
     1053     define input  parameter p-move-resize as logical   no-undo .
     1054     do
     1055     on error undo, return error return-value
     1056     :
     1057       run diasize_change-width in this-procedure
     1058         (input  (p-new-width - frame Dialog-Frame :width)
     1059         ,input  p-move-resize
     1060         ) .
     1061     end.
     1062   end procedure.
     1063   procedure diasize_position-resize-button :
     1064     do with frame Dialog-Frame
     1065     :
     1066       hide v-diasize-resize-button .
     1067       assign
     1068         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1069                     - 1
     1070                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1071         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1072                     - 1
     1073                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1074       .
     1075       view v-diasize-resize-button .
     1076     end.
     1077   end procedure.
     1078   on alt-right anywhere
     1079   do:
     1080     run diasize_change-width in this-procedure
     1081       (input 1
     1082       ,input true
     1083       ) .
     1084     return no-apply .
     1085   end.
     1086   on alt-left anywhere
     1087   do:
     1088     run diasize_change-width in this-procedure
     1089       (input -1
     1090       ,input true
     1091       ) .
     1092     return no-apply .
     1093   end.
     1094   on alt-down anywhere
     1095   do:
     1096     run diasize_change-height in this-procedure
     1097       (input 1
     1098       ,input true
     1099       ) .
     1100     return no-apply .
     1101   end.
     1102   on alt-up anywhere
     1103   do:
     1104     run diasize_change-height in this-procedure
     1105       (input -1
     1106       ,input true
     1107       ) .
     1108     return no-apply .
     1109   end.
     1110   on alt-enter of frame Dialog-Frame
     1111   do:
     1112     run diasize_maximize in this-procedure
     1113       (input  ?
     1114       ).
     1115     return no-apply .
     1116   end.
     1117   procedure diasize_end-move :
     1118     do
     1119     on error undo, return error return-value
     1120     :
     1121       define variable v-row-delta as decimal   no-undo .
     1122       define variable v-col-delta as decimal   no-undo .
     1123       define variable v-new-row as decimal   no-undo .
     1124       define variable v-new-col as decimal   no-undo .
     1125       assign
     1126         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1127         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1128       .
     1129       assign
     1130         v-row-delta = v-new-row - frame Dialog-Frame :height
     1131         v-col-delta = v-new-col - frame Dialog-Frame :width
     1132       .
     1133       run diasize_change-height in this-procedure
     1134         (input v-row-delta
     1135         ,input true
     1136         ) .
     1137       run diasize_change-width in this-procedure
     1138         (input v-col-delta
     1139         ,input true
     1140         ) .
     1141     end.
     1142   end procedure.
     1143   procedure diasize_maximize :
     1144     define input  parameter p-action as logical   no-undo .
     1145     do
     1146     on error undo, return error return-value
     1147     :
     1148       if p-action = ?
     1149       then do:
     1150         if v-diasize-need-maximize = true
     1151         then do:
     1152           assign
     1153             p-action = true
     1154           .
     1155         end.
     1156         else do:
     1157           assign
     1158             p-action = false
     1159           .
     1160         end.
     1161       end.
     1162       if p-action = true
     1163       then do:
     1164         run diasize_change-height in this-procedure
     1165           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1166               - frame Dialog-Frame :height-chars
     1167           ,input true
     1168           ) .
     1169         run diasize_change-width in this-procedure
     1170           (input session :width-chars
     1171               - frame Dialog-Frame :width-chars
     1172           ,input true
     1173           ) .
     1174         assign
     1175           v-diasize-need-maximize = false
     1176         .
     1177       end.
     1178       else do:
     1179         run diasize_change-width in this-procedure
     1180           (input v-diasize-orig-frame-width
     1181               - frame Dialog-Frame :width-chars
     1182           ,input true
     1183           ) .
     1184         run diasize_change-height in this-procedure
     1185           (input v-diasize-orig-frame-height
     1186               - frame Dialog-Frame :height-chars
     1187           ,input true
     1188           ) .
     1189         assign
     1190           v-diasize-need-maximize = true
     1191         .
     1192       end.
     1193     end.
     1194   end procedure.
     1195   procedure diasize_restore-orig-size :
     1196     do
     1197     on error undo, return error return-value
     1198     :
     1199       assign
     1200         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1201         v-diasize-current-frame-height = frame Dialog-Frame :height
     1202       .
     1203       run diasize_set-height in this-procedure
     1204         (input  v-diasize-orig-frame-height
     1205         ,input  true
     1206         ) .
     1207       run diasize_set-width in this-procedure
     1208         (input  v-diasize-orig-frame-width
     1209         ,input  true
     1210         ) .
     1211     end.
     1212   end procedure.
     1213   procedure diasize_restore-current-size :
     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217       run diasize_set-height in this-procedure
     1218         (input  v-diasize-current-frame-height
     1219         ,input  true
     1220         ) .
     1221       run diasize_set-width in this-procedure
     1222         (input  v-diasize-current-frame-width
     1223         ,input  true
     1224         ) .
     1225     end.
     1226   end procedure.
     1227   procedure diasize_set-browse-handle :
     1228     define input  parameter p-browse-handle as handle   no-undo .
     1229     define buffer buf_temp-browse-handle for temp-browse-handle .
     1230     do
     1231     on error undo, return error return-value
     1232     :
     1233       assign
     1234         v-diasize-browse-handle = p-browse-handle
     1235       .
     1236       for each buf_temp-browse-handle
     1237       on error undo, return error return-value
     1238       :
     1239         delete buf_temp-browse-handle .
     1240       end.
     1241     end.
     1242   end procedure.
     1243   procedure diasize_add_browse :
     1244     define input  parameter p-browse-type   as character no-undo .
     1245     define input  parameter p-browse-handle as handle    no-undo .
     1246     define buffer buf_temp-browse-handle for temp-browse-handle .
     1247     do
     1248     on error undo, return error return-value
     1249     :
     1250       assign
     1251         v-diasize-browse-number = v-diasize-browse-number + 1
     1252       .
     1253       create buf_temp-browse-handle .
     1254       assign
     1255         buf_temp-browse-handle.browse-type   = p-browse-type
     1256         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1257         buf_temp-browse-handle.browse-handle = p-browse-handle
     1258       .
     1259     end.
     1260   end procedure.
     1261   procedure diasize_init :
     1262     define variable v-default-value    as logical   no-undo .
     1263     define variable v-restore-saved    as logical   no-undo .
     1264     define variable v-resize-value-str as character no-undo .
     1265     do
     1266     on error undo, return error return-value
     1267     :
     1268       do with frame Dialog-Frame
     1269       :
     1270         assign
     1271           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1272           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1273           v-diasize-browse-handle     = browse BROWSE-3 :handle
     1274         .
     1275         create button v-diasize-resize-button
     1276         assign
     1277           parent        = frame Dialog-Frame :first-child
     1278           label         = "s"
     1279           height-pixels = 16
     1280           width-pixels  = 16
     1281           visible       = true
     1282           sensitive     = true
     1283           movable       = true
     1284           triggers:
     1285             on end-move persistent run diasize_end-move in this-procedure .
     1286           end triggers.
     1287         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1288         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1289         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1290         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1291         assign
     1292           v-diasize-wndmax = false
     1293         .
     1294         if connected("ub") = true
     1295         then do:
     1296           define variable v-cntxt-db-num        as integer   no-undo .
     1297           define variable v-cntxt-userid        as character no-undo .
     1298           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1299                                             , OUTPUT v-cntxt-userid
     1300                                             ) .
     1301           run gbl/wndpar_r.p
     1302             (input  v-cntxt-db-num
     1303             ,input  v-cntxt-userid
     1304             ,input  'wndmax':U
     1305             ,output v-diasize-wndmax
     1306             ,output v-default-value
     1307             ) .
     1308         end.
     1309         assign
     1310           v-diasize-wndstore = false
     1311         .
     1312         if connected("ub") = true
     1313         then do:
     1314           run gbl/wndpar_r.p
     1315             (input  v-cntxt-db-num
     1316             ,input  v-cntxt-userid
     1317             ,input  'wndstore':U
     1318             ,output v-diasize-wndstore
     1319             ,output v-default-value
     1320             ) .
     1321         end.
     1322         assign
     1323           v-diasize-proc-name = entry(1, program-name(2), '.')
     1324         .
     1325         if v-diasize-wndstore = true
     1326         then do:
     1327           assign
     1328             v-restore-saved = false
     1329           .
     1330           if connected("ub") = true
     1331           then do:
     1332             run gbl/wndsizer.p
     1333               (input  v-cntxt-db-num
     1334               ,input  v-cntxt-userid
     1335               ,input  v-diasize-proc-name
     1336               ,input  'height':u
     1337               ,output v-resize-value-str
     1338               ) .
     1339             if v-resize-value-str <> '':U
     1340             then do:
     1341               run diasize_change-height in this-procedure
     1342                 (input  integer(v-resize-value-str)
     1343                 ,input  true
     1344                 ) .
     1345               assign
     1346                 v-restore-saved = true
     1347               .
     1348             end.
     1349           end.
     1350           if connected("ub") = true
     1351           then do:
     1352             run gbl/wndsizer.p
     1353               (input  v-cntxt-db-num
     1354               ,input  v-cntxt-userid
     1355               ,input  v-diasize-proc-name
     1356               ,input  'width':u
     1357               ,output v-resize-value-str
     1358               ) .
     1359             if v-resize-value-str <> '':U
     1360             then do:
     1361               run diasize_change-width in this-procedure
     1362                 (input  integer(v-resize-value-str)
     1363                 ,input  true
     1364                 ) .
     1365               assign
     1366                 v-restore-saved = true
     1367               .
     1368             end.
     1369           end.
     1370           if v-restore-saved <> true
     1371           then do:
     1372             if v-diasize-wndmax = true
     1373             then do:
     1374               run diasize_maximize in this-procedure
     1375                 (input  true
     1376                 ) .
     1377             end.
     1378           end.
     1379         end.
     1380         else do:
     1381           if v-diasize-wndmax = true
     1382           then do:
     1383             run diasize_maximize in this-procedure
     1384               (input  true
     1385               ) .
     1386           end.
     1387         end.
     1388       end.
     1389     end.
     1390   end procedure.
     1391   procedure diasize_need-full-display :
     1392     define output parameter p-need-full-display as logical   no-undo .
     1393     do
     1394     on error undo, return error return-value
     1395     :
     1396       assign
     1397         p-need-full-display = v-diasize-need-full-display
     1398       .
     1399       assign
     1400         v-diasize-need-full-display = false
     1401       .
     1402     end.
     1403   end procedure.
     1404   procedure get-context :
     1405      define output parameter p-db-num as integer          no-undo.
     1406      define output parameter p-user-id as character        no-undo.
     1407      define variable v-login               as character    no-undo.
     1408      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1409      define buffer buf_user-login  for ub.user-login .
     1410      do
     1411      on error undo, return error
     1412      :
     1413            FIND FIRST buf_sys-ctrl no-lock.
     1414            ASSIGN
     1415               v-login = USERID("ub")
     1416               p-db-num = buf_sys-ctrl.db-num
     1417            .
     1418            FIND FIRST buf_user-login
     1419                 WHERE buf_user-login.db-num = p-db-num
     1420                   AND buf_user-login.user-login = v-login
     1421                 no-lock
     1422                 no-error
     1423                 .
     1424            IF AVAILABLE buf_user-login
     1425            THEN DO:
     1426               assign
     1427                  p-user-id = buf_user-login.user-id
     1428               .
     1429            END.
     1430      end.
     1431   end procedure.
     1432       run diasize_init in this-procedure .
     1433   MAIN-BLOCK:
     1434   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1435      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1436     run make-tt .
     1437     RUN enable_UI.
     1438     TT-protocol.v-par :resizable in browse BROWSE-3 = true .
     1439     TT-protocol.v-par :width     in browse BROWSE-3 = 35 .
     1440     define buffer buf_goods for ub.goods  .
     1441       find first buf_goods no-lock where
     1442                buf_goods.gds-code = p-gds-code .
     1443     ASSIGN frame Dialog-Frame:TITLE = "Протокол расчета заказа по товару " + buf_goods.gds-name + " Арт." + buf_goods.artic .
     1444     WAIT-FOR GO OF FRAME Dialog-Frame.
     1445   END.
     1446   RUN disable_UI.
     1447   PROCEDURE disable_UI :
     1448     HIDE FRAME Dialog-Frame.
     1449   END PROCEDURE.
     1450   PROCEDURE enable_UI :
     1451     ENABLE B-Cancel B-Help BROWSE-3
     1452         WITH FRAME Dialog-Frame.
     1453     VIEW FRAME Dialog-Frame.
     1454     OPEN QUERY BROWSE-3 FOR EACH TT-protocol NO-LOCK INDEXED-REPOSITION.
     1455   END PROCEDURE.
     1456   PROCEDURE make-tt :
     1457   define buffer buf_ord-line-attr for ub.ord-line-attr  .
     1458   define variable i as integer   no-undo .
     1459   for each buf_ord-line-attr no-lock where
     1460            buf_ord-line-attr.doc-code = p-ord-doc and
     1461            buf_ord-line-attr.gds-code = p-gds-code and
     1462            buf_ord-line-attr.attr-code begins "protocol"
     1463            :
     1464       repeat i = 1 to num-entries ( buf_ord-line-attr.attr-value,chr(4) ) :
     1465       create TT-protocol.
     1466       assign
     1467         TT-protocol.obj-type =  entry( 2 , buf_ord-line-attr.attr-code ,chr(4))
     1468         TT-protocol.obj-code =  int (entry( 3 , buf_ord-line-attr.attr-code ,chr(4)))
     1469         TT-protocol.v-date =    entry( 4 , buf_ord-line-attr.attr-code ,chr(4))
     1470         TT-protocol.v-time =    entry( 5 , buf_ord-line-attr.attr-code ,chr(4))
     1471         TT-protocol.v-par  = trim (entry( 1 , entry( i , buf_ord-line-attr.attr-value ,chr(4)) , ":" ))
     1472         TT-protocol.v-val  = trim (entry( 2 , entry( i , buf_ord-line-attr.attr-value ,chr(4)) , ":" ))
     1473       .
     1474   end.
     1475   end.
     1476   END PROCEDURE.
