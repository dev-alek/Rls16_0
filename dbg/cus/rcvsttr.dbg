        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-recid as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: rcvsttr.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/rcvsttr.p $":U .
        9   define variable vss-description as character no-undo init "Изменение статуса поставки при закрытии накладной на факт".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define buffer buf_trn-doc for ub.trn-doc.
       71   define buffer buf_doc-line for ub.doc-line.
       72   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
       73   define buffer buf_ord-doc for ub.ord-doc.
       74   define variable   to-day  as date  no-undo .
       75   find first buf_trn-doc no-lock where recid(buf_trn-doc) =  p-recid no-error .
       76       if error-status :error then do:
       77           message
       78           vss-workfile vss-revision vss-description skip
       79           error-status :get-message(1)
       80               "ОШИБКА при поиске Накладной "
       81               view-as alert-box error .
       82               return .
       83       end.
       84   find first  ub.ord-chain no-lock where
       85               ub.ord-chain.rel-doc-code = buf_trn-doc.doc-code  and
       86               ub.ord-chain.doc-type = 'rcv'                  and
       87               ub.ord-chain.rel-doc-type = 'trn' no-error .
       88       if error-status :error then do:
       89          return .
       90       end.
       91   find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.rcv-code = ub.ord-chain.doc-code no-error .
       92       if error-status :error then do:
       93          return .
       94       end.
       95   find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code and
       96                                        buf_ord-doc.doc-type = 'ОР':U no-error .
       97   if available buf_ord-doc then do:
       98       if buf_trn-doc.doc-type <> 'при':U then do:
       99          run cus/ordorcls.p ( parparentproc, input recid(buf_ord-doc) , input false ) no-error .
      100       end.
      101       else do:
      102          run cus/ordorcls.p ( parparentproc , input recid(buf_ord-doc) , input false ) no-error .
      103       end.
      104       if error-status :error  and return-value <> "" then do:
      105       message
      106         error-status :get-message(1) skip
      107         return-value skip
      108         "Заказ нельзя закрыть !"
      109         view-as alert-box error
      110       .
      111       return error .
      112       end.
      113   end.
      114   find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code and
      115                                        buf_ord-doc.doc-type = 'ПО':U no-error .
      116   if available buf_ord-doc then do:
      117      run cus/ordpocls.p ( parparentproc , input recid(buf_ord-doc) , input false ) no-error .
      118      if error-status :error  and return-value begins 'error'  then DO:
      119         return error substring(return-value , 7) .
      120      END.
      121   end.
      122   find first buf_ord-doc no-lock
      123        where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code
      124        and (
      125             buf_ord-doc.doc-type = 'ОП':U
      126          or buf_ord-doc.doc-type = 'ФП':U
      127             )
      128          no-error .
      129   if available buf_ord-doc then do:
      130      run cus/ordopcls.p ( parparentproc , input recid(buf_ord-doc) , input false ) no-error .
      131      if error-status :error  and return-value begins 'error'  then DO:
      132         return error substring(return-value , 7) .
      133      END.
      134   end.
