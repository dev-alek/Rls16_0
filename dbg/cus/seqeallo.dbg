      966     .
      967   end procedure.
      968   procedure diasize_set-height :
      969     define input  parameter p-new-height  as decimal   no-undo .
      970     define input  parameter p-move-resize as logical   no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974       run diasize_change-height in this-procedure
      975         (input  (p-new-height - frame Dialog-Frame :height)
      976         ,input  p-move-resize
      977         ) .
      978     end.
      979   end procedure.
      980   procedure diasize_change-width :
      981     define input  parameter p-change-value as decimal   no-undo .
      982     define input  parameter p-move-resize  as logical   no-undo .
      983     define variable v-field-group-handle   as handle    no-undo .
      984     define variable v-object-handle        as handle    no-undo .
