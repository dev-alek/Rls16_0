     1269         on error undo move_block, retry move_block
     1270         :
     1271           assign
     1272             v-object-handle = buf_temp-diasize-handle.handle-value
     1273           .
     1274           if v-object-handle <> v-diasize-resize-button
     1275           then do:
     1276             assign
     1277               v-object-handle :col = v-object-handle :col + p-change-value
     1278               no-error .
     1279             if error-status :error
     1280             or error-status :get-message(1) <> ""
     1281             then do:
     1282               undo move_block, retry move_block .
     1283             end.
     1284           end.
     1285         end.
     1286         for each buf_temp-browse-handle
     1287           where buf_temp-browse-handle.browse-type = 'width':u
     1288         on error undo move_block, retry move_block
     1289         :
     1290           assign
     1291             buf_temp-browse-handle.browse-handle :width
     1292               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1293             no-error .
     1294           if error-status :error
     1295           or error-status :get-message(1) <> ""
     1296           then do:
     1297             undo move_block, retry move_block .
     1298           end.
     1299         end.
     1300         assign
     1301           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1302           no-error .
     1303         if error-status :error
     1304         or error-status :get-message(1) <> ""
     1305         then do:
     1306           undo move_block, retry move_block.
     1307         end.
     1308         assign
     1309           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1310         no-error .
     1311         if error-status :error
     1312         or error-status :get-message(1) <> ""
     1313         then do:
     1314           undo move_block, retry move_block.
     1315         end.
     1316         if frame Dialog-Frame :scrollable = true
     1317         then do:
     1318           assign
     1319             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1320           no-error .
     1321           if error-status :error
     1322           or error-status :get-message(1) <> ""
     1323           then do:
     1324             undo move_block, retry move_block.
     1325           end.
     1326         end.
     1327       end.
     1328       if p-move-resize
     1329       then do:
     1330         run diasize_position-resize-button in this-procedure .
     1331       end.
     1332       if v-diasize-wndstore = true
     1333       then do:
     1334         if connected("ub") = true
     1335         then do:
     1336           define variable v-cntxt-db-num        as integer   no-undo .
     1337           define variable v-cntxt-userid        as character no-undo .
     1338           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1339                                             , OUTPUT v-cntxt-userid
     1340                                             ) .
     1341           run gbl/wndsizew.p
     1342             (input  v-cntxt-db-num
     1343             ,input  v-cntxt-userid
     1344             ,input  v-diasize-proc-name
     1345             ,input  'width':u
     1346             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1347             ) .
     1348         end.
     1349       end.
     1350     end.
     1351     assign
     1352       v-diasize-change-size = false
     1353     .
     1354   end procedure.
     1355   procedure diasize_set-width :
     1356     define input  parameter p-new-width  as decimal   no-undo .
     1357     define input  parameter p-move-resize as logical   no-undo .
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       run diasize_change-width in this-procedure
     1362         (input  (p-new-width - frame Dialog-Frame :width)
     1363         ,input  p-move-resize
     1364         ) .
     1365     end.
     1366   end procedure.
     1367   procedure diasize_position-resize-button :
     1368     do with frame Dialog-Frame
     1369     :
     1370       hide v-diasize-resize-button .
     1371       assign
     1372         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1373                     - 1
     1374                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1375         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1376                     - 1
     1377                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1378       .
     1379       view v-diasize-resize-button .
     1380     end.
     1381   end procedure.
     1382   on alt-right anywhere
     1383   do:
     1384     run diasize_change-width in this-procedure
     1385       (input 1
     1386       ,input true
     1387       ) .
     1388     return no-apply .
     1389   end.
     1390   on alt-left anywhere
     1391   do:
     1392     run diasize_change-width in this-procedure
     1393       (input -1
     1394       ,input true
     1395       ) .
     1396     return no-apply .
     1397   end.
     1398   on alt-down anywhere
     1399   do:
     1400     run diasize_change-height in this-procedure
     1401       (input 1
     1402       ,input true
     1403       ) .
     1404     return no-apply .
     1405   end.
     1406   on alt-up anywhere
     1407   do:
     1408     run diasize_change-height in this-procedure
     1409       (input -1
     1410       ,input true
     1411       ) .
     1412     return no-apply .
     1413   end.
     1414   on alt-enter of frame Dialog-Frame
     1415   do:
     1416     run diasize_maximize in this-procedure
     1417       (input  ?
     1418       ).
     1419     return no-apply .
     1420   end.
     1421   procedure diasize_end-move :
     1422     do
     1423     on error undo, return error return-value
     1424     :
     1425       define variable v-row-delta as decimal   no-undo .
     1426       define variable v-col-delta as decimal   no-undo .
     1427       define variable v-new-row as decimal   no-undo .
     1428       define variable v-new-col as decimal   no-undo .
     1429       assign
     1430         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1431         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1432       .
     1433       assign
     1434         v-row-delta = v-new-row - frame Dialog-Frame :height
     1435         v-col-delta = v-new-col - frame Dialog-Frame :width
     1436       .
     1437       run diasize_change-height in this-procedure
     1438         (input v-row-delta
     1439         ,input true
     1440         ) .
     1441       run diasize_change-width in this-procedure
     1442         (input v-col-delta
     1443         ,input true
     1444         ) .
     1445     end.
     1446   end procedure.
     1447   procedure diasize_maximize :
     1448     define input  parameter p-action as logical   no-undo .
     1449     do
     1450     on error undo, return error return-value
     1451     :
     1452       if p-action = ?
     1453       then do:
     1454         if v-diasize-need-maximize = true
     1455         then do:
     1456           assign
     1457             p-action = true
     1458           .
     1459         end.
     1460         else do:
     1461           assign
     1462             p-action = false
     1463           .
     1464         end.
     1465       end.
     1466       if p-action = true
     1467       then do:
     1468         run diasize_change-height in this-procedure
     1469           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1470               - frame Dialog-Frame :height-chars
     1471           ,input true
     1472           ) .
     1473         run diasize_change-width in this-procedure
     1474           (input session :width-chars
     1475               - frame Dialog-Frame :width-chars
     1476           ,input true
     1477           ) .
     1478         assign
     1479           v-diasize-need-maximize = false
     1480         .
     1481       end.
     1482       else do:
     1483         run diasize_change-width in this-procedure
     1484           (input v-diasize-orig-frame-width
     1485               - frame Dialog-Frame :width-chars
     1486           ,input true
     1487           ) .
     1488         run diasize_change-height in this-procedure
     1489           (input v-diasize-orig-frame-height
     1490               - frame Dialog-Frame :height-chars
     1491           ,input true
     1492           ) .
     1493         assign
     1494           v-diasize-need-maximize = true
     1495         .
     1496       end.
     1497     end.
     1498   end procedure.
     1499   procedure diasize_restore-orig-size :
     1500     do
     1501     on error undo, return error return-value
     1502     :
     1503       assign
     1504         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1505         v-diasize-current-frame-height = frame Dialog-Frame :height
     1506       .
     1507       run diasize_set-height in this-procedure
     1508         (input  v-diasize-orig-frame-height
     1509         ,input  true
     1510         ) .
     1511       run diasize_set-width in this-procedure
     1512         (input  v-diasize-orig-frame-width
     1513         ,input  true
     1514         ) .
     1515     end.
     1516   end procedure.
     1517   procedure diasize_restore-current-size :
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       run diasize_set-height in this-procedure
     1522         (input  v-diasize-current-frame-height
     1523         ,input  true
     1524         ) .
     1525       run diasize_set-width in this-procedure
     1526         (input  v-diasize-current-frame-width
     1527         ,input  true
     1528         ) .
     1529     end.
     1530   end procedure.
     1531   procedure diasize_set-browse-handle :
     1532     define input  parameter p-browse-handle as handle   no-undo .
     1533     define buffer buf_temp-browse-handle for temp-browse-handle .
     1534     do
     1535     on error undo, return error return-value
     1536     :
     1537       assign
     1538         v-diasize-browse-handle = p-browse-handle
     1539       .
     1540       for each buf_temp-browse-handle
     1541       on error undo, return error return-value
     1542       :
     1543         delete buf_temp-browse-handle .
     1544       end.
     1545     end.
     1546   end procedure.
     1547   procedure diasize_add_browse :
     1548     define input  parameter p-browse-type   as character no-undo .
     1549     define input  parameter p-browse-handle as handle    no-undo .
     1550     define buffer buf_temp-browse-handle for temp-browse-handle .
     1551     do
     1552     on error undo, return error return-value
     1553     :
     1554       assign
     1555         v-diasize-browse-number = v-diasize-browse-number + 1
     1556       .
     1557       create buf_temp-browse-handle .
     1558       assign
     1559         buf_temp-browse-handle.browse-type   = p-browse-type
     1560         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1561         buf_temp-browse-handle.browse-handle = p-browse-handle
     1562       .
     1563     end.
     1564   end procedure.
     1565   procedure diasize_init :
     1566     define variable v-default-value    as logical   no-undo .
     1567     define variable v-restore-saved    as logical   no-undo .
     1568     define variable v-resize-value-str as character no-undo .
     1569     do
     1570     on error undo, return error return-value
     1571     :
     1572       do with frame Dialog-Frame
     1573       :
     1574         assign
     1575           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1576           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1577           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1578         .
     1579         create button v-diasize-resize-button
     1580         assign
     1581           parent        = frame Dialog-Frame :first-child
     1582           label         = "s"
     1583           height-pixels = 16
     1584           width-pixels  = 16
     1585           visible       = true
     1586           sensitive     = true
     1587           movable       = true
     1588           triggers:
     1589             on end-move persistent run diasize_end-move in this-procedure .
     1590           end triggers.
     1591         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1592         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1593         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1594         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1595         assign
     1596           v-diasize-wndmax = false
     1597         .
     1598         if connected("ub") = true
     1599         then do:
     1600           define variable v-cntxt-db-num        as integer   no-undo .
     1601           define variable v-cntxt-userid        as character no-undo .
     1602           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1603                                             , OUTPUT v-cntxt-userid
     1604                                             ) .
     1605           run gbl/wndpar_r.p
     1606             (input  v-cntxt-db-num
     1607             ,input  v-cntxt-userid
     1608             ,input  'wndmax':U
     1609             ,output v-diasize-wndmax
     1610             ,output v-default-value
     1611             ) .
     1612         end.
     1613         assign
     1614           v-diasize-wndstore = false
     1615         .
     1616         if connected("ub") = true
     1617         then do:
     1618           run gbl/wndpar_r.p
     1619             (input  v-cntxt-db-num
     1620             ,input  v-cntxt-userid
     1621             ,input  'wndstore':U
     1622             ,output v-diasize-wndstore
     1623             ,output v-default-value
     1624             ) .
     1625         end.
     1626         assign
     1627           v-diasize-proc-name = entry(1, program-name(2), '.')
     1628         .
     1629         if v-diasize-wndstore = true
     1630         then do:
     1631           assign
     1632             v-restore-saved = false
     1633           .
     1634           if connected("ub") = true
     1635           then do:
     1636             run gbl/wndsizer.p
     1637               (input  v-cntxt-db-num
     1638               ,input  v-cntxt-userid
     1639               ,input  v-diasize-proc-name
     1640               ,input  'height':u
     1641               ,output v-resize-value-str
     1642               ) .
     1643             if v-resize-value-str <> '':U
     1644             then do:
     1645               run diasize_change-height in this-procedure
     1646                 (input  integer(v-resize-value-str)
     1647                 ,input  true
     1648                 ) .
     1649               assign
     1650                 v-restore-saved = true
     1651               .
     1652             end.
     1653           end.
     1654           if connected("ub") = true
     1655           then do:
     1656             run gbl/wndsizer.p
     1657               (input  v-cntxt-db-num
     1658               ,input  v-cntxt-userid
     1659               ,input  v-diasize-proc-name
     1660               ,input  'width':u
     1661               ,output v-resize-value-str
     1662               ) .
     1663             if v-resize-value-str <> '':U
     1664             then do:
     1665               run diasize_change-width in this-procedure
     1666                 (input  integer(v-resize-value-str)
     1667                 ,input  true
     1668                 ) .
     1669               assign
     1670                 v-restore-saved = true
     1671               .
     1672             end.
     1673           end.
     1674           if v-restore-saved <> true
     1675           then do:
     1676             if v-diasize-wndmax = true
     1677             then do:
     1678               run diasize_maximize in this-procedure
     1679                 (input  true
     1680                 ) .
     1681             end.
     1682           end.
     1683         end.
     1684         else do:
     1685           if v-diasize-wndmax = true
     1686           then do:
     1687             run diasize_maximize in this-procedure
     1688               (input  true
     1689               ) .
     1690           end.
     1691         end.
     1692       end.
     1693     end.
     1694   end procedure.
     1695   procedure diasize_need-full-display :
     1696     define output parameter p-need-full-display as logical   no-undo .
     1697     do
     1698     on error undo, return error return-value
     1699     :
     1700       assign
     1701         p-need-full-display = v-diasize-need-full-display
     1702       .
     1703       assign
     1704         v-diasize-need-full-display = false
     1705       .
     1706     end.
     1707   end procedure.
     1708   procedure get-context :
     1709      define output parameter p-db-num as integer          no-undo.
     1710      define output parameter p-user-id as character        no-undo.
     1711      define variable v-login               as character    no-undo.
     1712      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1713      define buffer buf_user-login  for ub.user-login .
     1714      do
     1715      on error undo, return error
     1716      :
     1717            FIND FIRST buf_sys-ctrl no-lock.
     1718            ASSIGN
     1719               v-login = USERID("ub")
     1720               p-db-num = buf_sys-ctrl.db-num
     1721            .
     1722            FIND FIRST buf_user-login
     1723                 WHERE buf_user-login.db-num = p-db-num
     1724                   AND buf_user-login.user-login = v-login
     1725                 no-lock
     1726                 no-error
     1727                 .
     1728            IF AVAILABLE buf_user-login
     1729            THEN DO:
     1730               assign
     1731                  p-user-id = buf_user-login.user-id
     1732               .
     1733            END.
     1734      end.
     1735   end procedure.
     1736       run diasize_init in this-procedure .
     1737   MAIN-BLOCK:
     1738   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1739      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1740       RUN make_tt  .
     1741       RUN enable_UI.
     1742     WAIT-FOR GO OF FRAME Dialog-Frame.
     1743   END.
     1744   RUN disable_UI.
     1745   PROCEDURE disable_UI :
     1746     HIDE FRAME Dialog-Frame.
     1747   END PROCEDURE.
     1748   PROCEDURE enable_UI :
     1749     ENABLE B-OK B-Cancel B-Help BROWSE-1 B-up B-down
     1750         WITH FRAME Dialog-Frame.
     1751     VIEW FRAME Dialog-Frame.
     1752     OPEN QUERY BROWSE-1 FOR EACH tt-table .
     1753   END PROCEDURE.
     1754   PROCEDURE make_tt :
     1755     create tt-table.
     1756     assign
     1757       tt-table.id       = 1
     1758       tt-table.name-col = 'Код товара'
     1759       tt-table.new-id = tt-table.id
     1760     .
     1761     create tt-table.
     1762     assign
     1763       tt-table.id       = 2
     1764       tt-table.name-col = 'Артикул'
     1765       tt-table.new-id = tt-table.id
     1766     .
     1767     create tt-table.
     1768     assign
     1769       tt-table.id       = 3
     1770       tt-table.name-col = 'Название товара'
     1771       tt-table.new-id = tt-table.id
     1772     .
     1773     create tt-table.
     1774     assign
     1775       tt-table.id       = 4
     1776       tt-table.name-col = 'Группа'
     1777       tt-table.new-id = tt-table.id
     1778     .
     1779     create tt-table.
     1780     assign
     1781       tt-table.id       = 5
     1782       tt-table.name-col = 'Ед.Изм.'
     1783       tt-table.new-id = tt-table.id
     1784     .
     1785     create tt-table.
     1786     assign
     1787       tt-table.id       = 6
     1788       tt-table.name-col = 'Код производителя'
     1789       tt-table.new-id = tt-table.id
     1790     .
     1791     create tt-table.
     1792     assign
     1793       tt-table.id       = 7
     1794       tt-table.name-col = 'Название производителя'
     1795       tt-table.new-id = tt-table.id
     1796     .
     1797     create tt-table.
     1798     assign
     1799       tt-table.id       = 8
     1800       tt-table.name-col = 'Артикул контрагента'
     1801       tt-table.new-id = tt-table.id
     1802     .
     1803     create tt-table.
     1804     assign
     1805       tt-table.id       = 9
     1806       tt-table.name-col = 'ЕдИзм Контрагента'
     1807       tt-table.new-id = tt-table.id
     1808     .
     1809     create tt-table.
     1810     assign
     1811       tt-table.id       = 10
     1812       tt-table.name-col = 'Срок хранения'
     1813       tt-table.new-id = tt-table.id
     1814     .
     1815     create tt-table.
     1816     assign
     1817       tt-table.id       = 11
     1818       tt-table.name-col = 'Коэффициент пересчета Ед.Изм.'
     1819       tt-table.new-id = tt-table.id
     1820     .
     1821     create tt-table.
     1822     assign
     1823       tt-table.id       = 12
     1824       tt-table.name-col = 'Кол-во в упаковке'
     1825       tt-table.new-id = tt-table.id
     1826     .
     1827     create tt-table.
     1828     assign
     1829       tt-table.id       = 13
     1830       tt-table.name-col = 'Темп продаж'
     1831       tt-table.new-id = tt-table.id
     1832     .
     1833     create tt-table.
     1834     assign
     1835       tt-table.id       = 14
     1836       tt-table.name-col = 'Расход'
     1837       tt-table.new-id = tt-table.id
     1838     .
     1839     create tt-table.
     1840     assign
     1841       tt-table.id       = 15
     1842       tt-table.name-col = 'Дней без продаж и остатков'
     1843       tt-table.new-id = tt-table.id
     1844     .
     1845     create tt-table.
     1846     assign
     1847       tt-table.id       = 16
     1848       tt-table.name-col = 'Дней в продаже'
     1849       tt-table.new-id = tt-table.id
     1850     .
     1851     create tt-table.
     1852     assign
     1853       tt-table.id       = 17
     1854       tt-table.name-col = 'Остаток'
     1855       tt-table.new-id = tt-table.id
     1856     .
     1857     create tt-table.
     1858     assign
     1859       tt-table.id       = 18
     1860       tt-table.name-col = 'Приход'
     1861       tt-table.new-id = tt-table.id
     1862     .
     1863     create tt-table.
     1864     assign
     1865       tt-table.id       = 19
     1866       tt-table.name-col = 'MIN остаток'
     1867       tt-table.new-id = tt-table.id
     1868     .
     1869     create tt-table.
     1870     assign
     1871       tt-table.id       = 20
     1872       tt-table.name-col = 'Уровень постоянного присутствия'
     1873       tt-table.new-id = tt-table.id
     1874     .
     1875     create tt-table.
     1876     assign
     1877       tt-table.id       = 21
     1878       tt-table.name-col = 'MIN заказ'
     1879       tt-table.new-id = tt-table.id
     1880     .
     1881     create tt-table.
     1882     assign
