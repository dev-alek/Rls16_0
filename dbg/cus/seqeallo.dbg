      796               assign
      797                 buf_temp-diasize-handle.handle-value  = v-object-handle
      798                 buf_temp-diasize-handle.save-position = v-object-handle :row
      799               .
      800             end.
      801           end.
      802           assign
      803             v-object-handle = v-object-handle :next-sibling
      804           .
      805         end.
      806         assign
      807           v-field-group-handle = v-field-group-handle :next-sibling
      808         .
      809       end.
      810       do with frame Dialog-Frame
      811       :
      812         hide v-diasize-resize-button .
      813         assign
      814           v-diasize-resize-button :row    = 1
      815           v-diasize-resize-button :column = 1
      816         .
      817       end.
