      163               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      164         otherwise do:
      165           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      166         end.
      167       end CASE.
      168     end.
      169   end procedure.
      170   procedure uf-get :
      171     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      172     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      173     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      174     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      175     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      176     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      177     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      178     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      179     do
      180     on error undo, return error
      181     :
      182       define buffer buf_usr-flt for ubflt.usr-flt .
      183       define variable v-use-List_     as logical   no-undo .
      184       define variable v-type-List_     as character no-undo .
      185       define variable v-format-List_   as character no-undo .
      186       define variable v-use-Naim      as logical   no-undo .
      187       define variable v-type-Naim      as character no-undo .
      188       define variable v-format-Naim    as character no-undo .
      189       define variable v-use-print-graft as logical   no-undo .
      190       define variable v-use-sort-gr     as logical   no-undo .
      191       define variable v-use-type-price  as logical   no-undo .
      192       define variable v-use-type-val    as logical   no-undo .
      193       define variable v-label          as character no-undo .
      194       define variable v-tooltip        as character no-undo .
      195       define variable v-user-can-edit  as logical   no-undo .
      196       define variable v-output-display as logical   no-undo .
      197       define variable v-other          as character no-undo .
      198       run uf-name in this-procedure
      199          (input  entry(1, p-code, chr(4))
      200         ,output v-use-List_
      201         ,output v-type-List_
      202         ,output v-format-List_
      203         ,output v-use-Naim
      204         ,output v-type-Naim
      205         ,output v-format-Naim
      206         ,output v-use-print-graft
      207         ,output v-use-sort-gr
      208         ,output v-use-type-price
      209         ,output v-use-type-val
      210         ,output v-label
      211         ,output v-tooltip
      212         ,output v-user-can-edit
      213         ,output v-output-display
      214         ,output v-other
      215         ) no-error .
      216       if error-status :error then do:
      217         undo, return error return-value .
      218       end.
      219       find first buf_usr-flt no-lock where
      220                  buf_usr-flt.Call-point     = p-code AND
      221                  buf_usr-flt.user-name       = p-user-name
      222         no-error .
      223       if avail buf_usr-flt then do:
      224         assign
      225         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      226         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      227         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      228         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      229         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      230         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      231         .
      232       end.
      233       else do:
      234         assign
      235         p-List_        = (if v-use-List_       then "":U                    else ?)
      236         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      237         p-print-graft  = (if v-use-print-graft then no                      else ?)
      238         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      239         p-type-price   = (if v-use-type-price  then no                      else ?)
      240         p-type-val     = (if v-use-List_       then no                      else ?)
      241         .
      242       end.
      243     end.
      244   end procedure.
      245   procedure uf-set :
      246     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      247     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      248     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      249     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      250     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      251     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      252     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      253     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      254     do
      255     on error undo, return error
      256     :
      257       define buffer buf_usr-flt for ubflt.usr-flt .
      258       define variable v-use-List_     as logical   no-undo .
      259       define variable v-type-List_     as character no-undo .
      260       define variable v-format-List_   as character no-undo .
      261       define variable v-use-Naim      as logical   no-undo .
      262       define variable v-type-Naim      as character no-undo .
      263       define variable v-format-Naim    as character no-undo .
      264       define variable v-use-print-graft as logical   no-undo .
      265       define variable v-use-sort-gr   as logical   no-undo .
      266       define variable v-use-type-price as logical   no-undo .
      267       define variable v-use-type-val  as logical   no-undo .
      268       define variable v-tooltip        as character no-undo .
      269       define variable v-label          as character no-undo .
      270       define variable v-user-can-edit  as logical   no-undo .
      271       define variable v-output-display as logical   no-undo .
      272       define variable v-other          as character no-undo .
      273       run uf-name in this-procedure
      274         (input  entry(1, p-code, chr(4))
      275         ,output v-use-List_
      276         ,output v-type-List_
      277         ,output v-format-List_
      278         ,output v-use-Naim
      279         ,output v-type-Naim
      280         ,output v-format-Naim
      281         ,output v-use-print-graft
      282         ,output v-use-sort-gr
      283         ,output v-use-type-price
      284         ,output v-use-type-val
      285         ,output v-label
      286         ,output v-tooltip
      287         ,output v-user-can-edit
      288         ,output v-output-display
      289         ,output v-other
      290         ) no-error .
      291       if error-status :error then do:
      292         undo, return error return-value .
      293       end.
      294       find first buf_usr-flt where
      295                  buf_usr-flt.Call-point     = p-code AND
      296                  buf_usr-flt.user-name       = p-user-name
      297         no-error .
      298       if not avail buf_usr-flt then do:
      299           create buf_usr-flt .
      300           assign
      301           buf_usr-flt.call-point = p-code
      302           buf_usr-flt.user-name  = p-user-name
      303           .
      304       end.
      305       if avail buf_usr-flt then do:
      306        assign
      307        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      308        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      309        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      310        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      311        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      312        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      313       .
      314       release buf_usr-flt.
      315       end.
      316       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      317     end.
      318   end procedure.
      319   procedure proc-alt-shift-f2:
      320     if not ibs.th.gbl.gbl-var:rcode
      321   then
      322     run gbl\inidebug.p .
      323   end.
      324   procedure proc-alt-shift-f3:
      325     run gbl/prvssinf.p
      326       ( input this-procedure
      327       ) .
      328   end.
      329   define variable v-inform-launched as logical no-undo initial false .
      330   procedure proc-alt-shift-f4:
      331     define variable v-action as character no-undo .
      332     if v-inform-launched = false then do:
      333       assign
      334         v-inform-launched = true
      335       .
      336       run gbl/d-inform.w
      337         (  input self
      338         ,  input this-procedure
      339         , output v-action
      340         ) no-error .
      341       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      342       assign
      343         v-inform-launched = false
      344       .
      345     end.
      346   end.
      347   procedure proc-alt-f1:
      348     run gbl/corrhelp.p
      349       (input this-procedure
      350       ) .
      351   end .
      352   on alt-shift-f2 anywhere do:
      353     run proc-alt-shift-f2.
      354   end.
      355   on alt-shift-f3 anywhere do:
      356     run proc-alt-shift-f3 in this-procedure .
      357   end.
      358   on alt-shift-f4 anywhere do:
      359     run proc-alt-shift-f4 in this-procedure.
      360   end.
      361   on alt-f1 anywhere do:
      362     run proc-alt-f1 in this-procedure .
      363   end.
      364   define temp-table tt-table no-undo
      365       FIELD id AS INTEGER
      366       FIELD name-col AS CHARACTER format "x(256)"
      367       FIELD new-id AS INTEGER
      368       INDEX p1 IS PRIMARY new-id
      369       INDEX p2 id
      370       .
      371   define temp-table tt-old no-undo
      372       FIELD id AS INTEGER
      373       FIELD new-id AS INTEGER
      374       INDEX p1 IS PRIMARY id
      375       .
      376   define variable v-recid as recid no-undo .
      377   DEFINE BUTTON B-Cancel AUTO-END-KEY
      378        LABEL "&Отмена"
      379        SIZE 10 BY 1
      380        BGCOLOR 8 .
      381   DEFINE BUTTON B-down
      382        LABEL "B-down"
      383        IMAGE-UP FILE "btn-down-arrow":U
      384        IMAGE-DOWN FILE "btn-down-arrow":U
      385        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      386        SIZE 6.38 BY 1.13.
      387   DEFINE BUTTON B-Help
      388        LABEL "&Помощь"
      389        SIZE 10 BY 1
      390        BGCOLOR 8 .
      391   DEFINE BUTTON B-OK AUTO-GO
      392        LABEL "&Ввод"
      393        SIZE 10 BY 1
      394        BGCOLOR 8 .
      395   DEFINE BUTTON B-up
      396        IMAGE-UP FILE "btn-up-arrow":U
      397        IMAGE-DOWN FILE "btn-up-arrow":U
      398        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
      399        SIZE 6.38 BY 1.13.
      400   DEFINE QUERY BROWSE-1 FOR
      401   tt-table.
      402   DEFINE BROWSE BROWSE-1
      403     QUERY BROWSE-1 DISPLAY
      404         tt-table.name-col format "x(100)" column-label "Название колонки"
      405       WITH NO-ROW-MARKERS SEPARATORS SIZE 72 BY 18.75 EXPANDABLE.
      406   DEFINE FRAME Dialog-Frame
      407        B-OK AT ROW 1 COL 1
      408        B-Cancel AT ROW 1 COL 11
      409        B-Help AT ROW 1 COL 71.5
      410        BROWSE-1 AT ROW 2.75 COL 2
      411        B-up AT ROW 2.75 COL 75
      412        B-down AT ROW 4.25 COL 75
      413        SPACE(0.24) SKIP(16.53)
      414       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      415            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      416            TITLE "Изменение порядка колонок в режиме РАСЧЕТ потребности товара"
      417            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
      418   ASSIGN
      419          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      420          FRAME Dialog-Frame:HIDDEN           = TRUE.
      421   ON GO OF FRAME Dialog-Frame
      422   DO:
      423     RUN save-proc NO-ERROR.
      424     if error-status :error then
      425        return no-apply.
      426   END.
      427   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      428   DO:
      429     APPLY "END-ERROR":U TO SELF.
      430   END.
      431   ON CHOOSE OF B-down IN FRAME Dialog-Frame
      432   DO:
      433     IF AVAILABLE tt-table THEN DO:
      434         v-recid = recid(tt-table) .
      435         tt-table.new-id = tt-table.new-id + 1 .
      436         if tt-table.new-id > 34 then tt-table.new-id = 34.
      437         OPEN QUERY BROWSE-1 FOR EACH tt-table .
      438         reposition BROWSE-1 to recid v-recid no-error .
      439         BROWSE-1 :SET-REPOSITIONED-ROW(10, "CONDITIONAL") .
      440     END.
      441   END.
      442   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      443   OR HELP OF FRAME Dialog-Frame
      444   DO:
      445   END.
      446   ON CHOOSE OF B-up IN FRAME Dialog-Frame
      447   DO:
      448     IF AVAILABLE tt-table THEN DO:
      449       v-recid = recid(tt-table) .
      450       tt-table.new-id = tt-table.new-id - 1 .
      451       if tt-table.new-id < 0 then tt-table.new-id = 1.
      452       OPEN QUERY BROWSE-1 FOR EACH tt-table .
      453       reposition BROWSE-1 to recid v-recid no-error .
      454       BROWSE-1 :SET-REPOSITIONED-ROW(10, "CONDITIONAL") .
      455     END.
      456   END.
      457   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      458   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      459   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      460   on help of frame Dialog-Frame
      461   do:
      462     run gbl/app_help.p
      463       (input this-procedure :file-name
      464       ,input ''
      465       ,input ?
      466       ) no-error.
      467     if error-status :error then do:
      468       message
      469         "Ошибка при вызове помощи"
      470         error-status :get-message(1)
      471         view-as alert-box .
      472     end.
      473   end.
      474   run minbtn-set in this-procedure .
      475   on choose of b-help in frame Dialog-Frame
      476   do:
      477     apply "help":u to frame Dialog-Frame .
      478   end.
      479   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   procedure minbtn-set :
      481       do
      482           on error undo, return error return-value
      483           :
      484           define variable ii              as integer       no-undo .
      485           define variable fh              as widget-handle no-undo .
      486           define variable hh              as widget-handle no-undo .
      487           define variable v-h             as handle        extent 4 no-undo .
      488           define variable v-name-button   as character     no-undo .
      489           define variable v-help-old-x    as decimal       no-undo .
      490           define variable v-help-old-y    as decimal       no-undo .
      491           define variable v-help-old-size as decimal       no-undo .
      492           define variable v-frame-width   as decimal       no-undo .
      493           define variable jj              as integer       no-undo .
      494           do
      495               on error undo, return error
      496               :
      497               assign
      498                   v-frame-width = frame Dialog-Frame:width - 0.3
      499                   fh            = frame Dialog-Frame:first-child
      500                   hh            = fh:first-child
      501                   ii            = 1
      502                   .
      503               do while valid-handle(hh):
      504                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      505                   do:
      506                       case lc(hh:name) :
      507                           when "b-help" then
      508                               do:
      509                                   hh:load-image-up("cmp/b-help.bmp":u) .
      510                                   hh:load-image-down("cmp/b-help.bmp":u) .
      511                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      512                                   hh:TOOLTIP = "Помощь" .
      513                                   v-help-old-x = hh:column .
      514                                   v-help-old-y = hh:row    .
      515                                   v-help-old-size = hh:width .
      516                                   hh:width-chars = 2.5 .
      517                               end.
      518                           when "b-print" then
      519                               do:
      520                                   hh:load-image("cmp/b-print.bmp":u) .
      521                                   hh:TOOLTIP = "Печать" .
      522                                   v-h[ii] = hh:handle .
      523                                   ii = ii + 1 .
      524                                   hh:width-chars = 3 .
      525                               end.
      526                           when "b-history" or
      527                           when "b-hist" then
      528                               do:
      529                                   hh:load-image("cmp/b-hist.bmp":u) .
      530                                   hh:TOOLTIP = "История" .
      531                                   v-h[ii] = hh:handle .
      532                                   ii = ii + 1 .
      533                                   hh:width-chars = 3 .
      534                               end.
      535                           when "b-sch" then
      536                               do:
      537                                   hh:load-image("cmp/b-sch.bmp":u) .
      538                                   hh:TOOLTIP = "Установка Фильтра" .
      539                                   v-h[ii] = hh:handle .
      540                                   ii = ii + 1 .
      541                                   hh:width-chars = 3 .
      542                               end.
      543                           when "b-hist-user" then
      544                               do:
      545                                   hh:load-image("cmp/b-hist.bmp":u) .
      546                                   hh:TOOLTIP = "История пользователя" .
      547                                   ii = ii + 1 .
      548                               end.
      549                       end case.
      550                   end.
      551                   hh = hh:next-sibling.
      552               end.
      553               b-help:column = v-frame-width - b-help:width-chars.
      554               jj = 0.
      555               repeat ii = 4 to 1 by -1 :
      556                   if valid-handle (v-h[ii] ) then
      557                   do:
      558                       jj  = jj + 1 .
      559                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      560                       v-h[ii]:row    = v-help-old-y .
      561                   end.
      562               end.
      563           end.
      564       end.
      565   end procedure.
      566   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      567   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      568   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      569   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      570   define variable v-diasize-current-frame-width  as decimal   no-undo .
      571   define variable v-diasize-current-frame-height as decimal   no-undo .
      572   define variable v-diasize-change-size          as logical   no-undo .
      573   define variable v-diasize-resize-button        as handle    no-undo .
      574   define variable v-diasize-wndmax               as logical   no-undo .
      575   define variable v-diasize-wndstore             as logical   no-undo .
      576   define variable v-diasize-proc-name            as character no-undo .
      577   define variable v-diasize-browse-handle        as handle    no-undo .
      578   define variable v-diasize-browse-number        as integer   no-undo .
      579   define variable v-diasize-need-full-display    as logical   no-undo init false .
      580   define temp-table temp-diasize-handle no-undo
      581     field handle-value  as handle
      582     field save-position as decimal
      583     index xpk is primary unique handle-value
      584     .
      585   define temp-table temp-browse-handle no-undo
      586     field browse-type   as character
      587     field browse-number as integer
      588     field browse-handle as handle
      589     field original-size as decimal
      590     index xpk is primary unique browse-type browse-number
      591     index xie browse-type browse-handle
      592   .
      593   procedure diasize_change-height :
      594     define input  parameter p-change-value  as decimal   no-undo .
      595     define input  parameter p-move-resize   as logical   no-undo .
      596     define variable v-field-group-handle    as handle    no-undo .
      597     define variable v-object-handle         as handle    no-undo .
      598     define variable v-frame-height          as decimal   no-undo .
      599     define variable v-frame-virtual-height  as decimal   no-undo .
      600     define variable v-browse-height         as decimal   no-undo .
      601     define variable v-window-height         as decimal   no-undo .
      602     define variable v-window-virtual-height as decimal   no-undo .
      603     define variable v-change-sign           as integer   no-undo .
      604     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      605     define buffer buf_temp-browse-handle  for temp-browse-handle .
      606     if p-change-value > 0
      607     then do:
      608       if frame Dialog-Frame :height + p-change-value
      609           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      610       then do:
      611         assign
      612           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      613                           - (frame Dialog-Frame :height-chars)
      614         .
      615         if p-change-value <= 0
      616         then do:
      617           run diasize_position-resize-button in this-procedure .
      618           return .
      619         end.
      620       end.
      621     end.
      622     if p-change-value < 0
      623     then do:
      624       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      625       then do:
      626         assign
      627           p-change-value = v-diasize-orig-frame-height
      628                          - (frame Dialog-Frame :height-chars)
      629         .
      630         if p-change-value >= 0
      631         then do:
      632           run diasize_position-resize-button in this-procedure .
      633           return .
      634         end.
      635       end.
      636     end.
      637     if p-change-value >= 0
      638     then do:
      639       assign
      640         v-change-sign = 1
      641       .
      642     end.
      643     else do:
      644       assign
      645         v-change-sign = -1
      646       .
      647     end.
      648     assign
      649       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      650     .
      651     if p-change-value = 0
      652     then do:
      653       run diasize_position-resize-button in this-procedure .
      654       return .
      655     end.
      656     move_block:
      657     do
      658     on error undo move_block, retry move_block
      659     :
      660       if retry
      661       then do:
      662         do
      663         on error undo move_block, leave move_block
      664         :
      665           if p-change-value > 0
      666           then do:
      667             for each buf_temp-diasize-handle
      668             on error undo, next
      669             :
      670               assign
      671                 v-object-handle = buf_temp-diasize-handle.handle-value
      672               .
      673               if v-object-handle <> v-diasize-resize-button
      674               then do:
      675                 assign
      676                   v-object-handle :row = buf_temp-diasize-handle.save-position
      677                 .
      678               end.
      679             end.
      680             assign
      681               v-diasize-browse-handle :height = v-browse-height
      682             .
      683             for each buf_temp-browse-handle
      684               where buf_temp-browse-handle.browse-type = 'height':u
      685             on error undo, next
      686             :
      687               assign
      688                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      689               .
      690             end.
      691             assign
      692               frame Dialog-Frame :height = v-frame-height
      693             .
      694             if frame Dialog-Frame :scrollable = true
      695             then do:
      696               assign
      697                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      698               .
      699             end.
