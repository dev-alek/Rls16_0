     1958     .
     1959   run uf-get in this-procedure (
     1960        input  'seqeallo':U
     1961       ,input  'adm'
     1962       ,output v-uf-List_
     1963       ,output v-uf-Naim
     1964       ,output v-uf-print-graft
     1965       ,output v-uf-sort-gr
     1966       ,output v-uf-type-price
     1967       ,output v-uf-type-val
     1968   )  no-error.
     1969   if v-uf-List_ <> "" then do:
     1970   define variable iv as integer   no-undo .
     1971   define variable i-kol as integer   no-undo .
     1972   define variable st as character no-undo .
     1973   i-kol = num-entries (v-uf-List_, chr(4)) .
     1974   repeat Iv = 1 to i-kol :
     1975      st = entry(Iv,v-uf-List_, chr(4)).
     1976      create tt-old.
     1977      assign
     1978        tt-old.id = integer(entry(1, st))
     1979        tt-old.new-id = integer(entry(2, st))
     1980      .
     1981   end.
     1982   for each tt-table :
     1983       find first tt-old where
     1984                  tt-old.id = tt-table.id no-error.
     1985        if available tt-old then do:
     1986         tt-table.new-id = tt-old.new-id .
     1987        end.
     1988   end.
     1989   end.
     1990   END PROCEDURE.
     1991   PROCEDURE save-proc :
     1992   define variable v-str as character no-undo .
     1993   define variable v-i   as integer   no-undo .
     1994   v-str = '' .
     1995   v-i = 0 .
     1996   for each tt-table break by new-id :
     1997       v-i = v-i + 1 .
     1998       v-str = v-str + string(tt-table.id) + ',' + string(v-i) + chr(4) .
     1999   end.
     2000   v-str = trim(v-str,chr(4)) .
     2001   run uf-set in this-procedure(
     2002       input  'seqeallo':U
     2003       ,input 'adm'
     2004       ,input v-str
     2005       ,input v-uf-Naim
     2006       ,input v-uf-print-graft
     2007       ,input v-uf-sort-gr
     2008       ,input v-uf-type-price
     2009       ,input v-uf-type-val
     2010   ) no-error    .
     2011   END PROCEDURE.
