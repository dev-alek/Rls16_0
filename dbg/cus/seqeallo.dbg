      991     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      992     define buffer buf_temp-browse-handle  for temp-browse-handle .
      993     if p-change-value > 0
      994     then do:
      995       if frame Dialog-Frame :width + p-change-value >
      996           session :width-chars
      997       then do:
      998         assign
      999           p-change-value = session :width-chars - frame Dialog-Frame :width
     1000         .
     1001         if p-change-value <= 0
     1002         then do:
     1003           run diasize_position-resize-button in this-procedure .
     1004           return .
     1005         end.
     1006       end.
     1007     end.
     1008     if p-change-value < 0
     1009     then do:
     1010       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1011       then do:
     1012         assign
     1013           p-change-value = v-diasize-orig-frame-width
     1014                          - frame Dialog-Frame :width
     1015         .
     1016         if p-change-value >= 0
     1017         then do:
     1018           run diasize_position-resize-button in this-procedure .
     1019           return .
     1020         end.
     1021       end.
     1022     end.
     1023     if p-change-value >= 0
     1024     then do:
     1025       assign
     1026         v-change-sign = 1
     1027       .
     1028     end.
     1029     else do:
     1030       assign
     1031         v-change-sign = -1
     1032       .
     1033     end.
     1034     assign
     1035       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1036     .
     1037     if p-change-value = 0
     1038     then do:
     1039       run diasize_position-resize-button in this-procedure .
     1040       return .
     1041     end.
