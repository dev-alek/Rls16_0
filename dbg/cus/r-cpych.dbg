      577   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   define  stream PrnLibStream.
      579   procedure prn-lib-prn-file :
      580     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      581     define input parameter p-DIsabledoptions as integer no-undo .
      582     define variable v-report-name as character no-undo .
      583     define variable v-user-action as character no-undo .
      584     define variable v-printed     as logical   no-undo .
      585     define variable v-exist       as logical   no-undo .
      586     do
      587       on error undo, return error
      588       :
      589       run prn-lib-get-report-name  in this-procedure (
      590         input parParentProc
      591         ,output v-report-name
      592         ).
      593   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      595     (input  v-report-name
      596     ,input  2
      597     ,output v-exist
      598     )  .
      599       if NOT v-exist then
      600       DO:
      601         Message
      602           "Нет заданий на печать ! "
      603           view-as alert-box .
      604         Return  .
      605       End.
      606       run gbl/prnfilen.w
      607         (input  ""
      608         ,input  p-DisabledOptions
      609         ,input  string(v-report-name )
      610         ,input  7
      611         ,output v-user-action
      612         ,output v-printed
      613         ) .
      614       if v-printed then
      615       do:
      616         return "YES" .
      617       end.
      618       else
      619       do:
      620         return "NO" .
      621       end.
      622     end.
      623   end procedure.
      624   procedure prn-lib-open-stream :
      625     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      626     define input parameter p-page-size    as integer no-undo .
      627     define input parameter p-is-stream    as logical no-undo .
      628     define input parameter p-append       as logical no-undo .
      629     define variable v-report-name as character no-undo .
      630     do
      631       on error undo, return error
      632       :
      633       run prn-lib-get-report-name  in this-procedure (
      634         input parParentProc
      635         ,output v-report-name
      636         ).
      637       if p-is-stream then
      638       do:
      639         if p-append then
      640         do:
      641           output stream PrnLibStream to value( v-report-name )
      642             page-size value(p-page-size) append .
      643         end.
      644         if not p-append then
      645         do:
      646           output stream PrnLibStream to value( v-report-name )
      647             page-size value(p-page-size) .
      648         end.
      649       end.
      650       if not p-is-stream then
      651       do:
      652         if p-append then
      653         do:
      654           output to value( v-report-name )
      655             page-size value(p-page-size) append .
      656         end.
      657         if not p-append then
      658         do:
      659           output to value( v-report-name )
      660             page-size value(p-page-size) .
      661         end.
      662       end.
      663     end.
      664   end procedure.
      665   procedure prn-lib-open-exp :
      666     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      667     define input parameter p-is-stream    as logical no-undo .
      668     define input parameter p-is-append    as logical no-undo .
      669     define output parameter p-ReportFileName as char init "report" no-undo.
      670     define output parameter p-process as logical no-undo .
      671     define variable glog as logical no-undo .
      672     do
      673       on error undo, return error
      674       :
      675       SYSTEM-DIALOG GET-FILE p-ReportFileName
      676         TITLE      "Укажите путь"
      677         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      678         ASK-OVERWRITE
      679         CREATE-TEST-FILE
      680         SAVE-AS
      681         USE-FILENAME
      682         DEFAULT-EXTENSION "txt"
      683         UPDATE glog
      684         .
      685       if not glog then  return.
      686       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      687       if p-is-stream then
      688       do:
      689         if p-is-append then
      690         do:
      691           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      692         end.
      693         else
      694         do:
      695           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      696         end.
      697       end.
      698       else
      699       do:
      700         if p-is-append then
      701         do:
      702           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      703         end.
      704         else
      705         do:
      706           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      707         end.
      708       end.
      709       p-process = yes.
      710     end.
      711   end procedure.
      712   procedure prn-lib-get-report-name :
      713     define input parameter parParentProc  as widget-handle no-undo.
      714     define output parameter p-report-name as character no-undo .
      715     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      716   end procedure.
      717   procedure prn-lib-reportviewer-report-name :
      718     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      719     define input parameter p-report-name-html as character no-undo .
      720     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      721   end procedure.
      722   procedure prn-lib-reportviewer :
      723     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      724     define input parameter p-report-name-html as character no-undo .
      725     define input parameter p-param        as character no-undo .
      726     define variable v-excel           as character no-undo init 'TRUE' .
      727     define variable v-value-character as character no-undo .
      728     define variable v-value-integer   as character no-undo .
      729     define variable v-value-date      as date      no-undo .
      730     define variable v-value-decimal   as decimal   no-undo .
      731     define variable rep-excel         as logical   no-undo .
      732     define variable excel-string      as character no-undo .
      733     define variable v-param-type      as character no-undo .
      734     define variable v-tth             as handle    no-undo .
      735     run adm/shattri.p (
      736       input "get":U
      737       ,input  ""
      738       ,input  0
      739       ,input  'report-glob':U
      740       ,input  'rep-excel':U
      741       ,output v-value-character
      742       ,output v-value-date
      743       ,output v-value-decimal
      744       ,output v-value-integer
      745       ,output rep-excel
      746       ,output v-param-type
      747       ,INPUT-OUTPUT table-handle v-tth
      748       )  .
      749     if rep-excel then v-excel = "TRUE" .
      750     else v-excel = "FALSE" .
      751     if p-param eq ""
      752     then
      753        p-param = "EXCEL:" + v-excel.
      754     else
      755        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      756     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      757   end procedure.
      758   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759   define variable v-waitfram-action01         as character   no-undo .
      760   define variable v-waitfram-action02         as character   no-undo .
      761   define variable v-waitfram-action03         as character   no-undo .
      762   define variable mWaitFramTextBeg            as character   no-undo.
      763   define variable mWaitFramTextEnd            as character   no-undo.
      764   define variable mWaitFramView               as logical     no-undo.
      765   define variable mWaitProcEvent              as logical     no-undo init yes.
      766   define variable mWaitFramInterval           as integer     no-undo init 1 .
      767   define variable mWaitFramStop               as logical     no-undo.
      768   define variable mWaitFramStopUser           as logical     no-undo.
      769   define variable mWaitFramStopTimeOut        as logical     no-undo.
      770   define variable mWaitFramStartProc          as datetime-tz no-undo.
      771   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      772   define button B-WaitFramStop auto-end-key
      773        label "Стоп"
      774        size 10 by 1 tooltip "Остоновить процесс".
      775   define button B-viewProcInfo
      776        label "Информация"
      777        size 15 by 1 tooltip "Информация о процесс".
      778   define frame waitfram
      779     v-waitfram-action01 format "x(72)" no-label skip
      780     v-waitfram-action02 format "x(72)" no-label skip
      781     v-waitfram-action03 format "x(72)" no-label skip
      782     B-viewProcInfo
      783     B-WaitFramStop at row 4 col 30
      784     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      785     .
      786   define new global shared variable mBatchMode as logical no-undo init ?.
      787   define variable mFramBachModHandle as handle no-undo.
      788   mFramBachModHandle = frame waitfram:handle.
      789   define variable mFameOldVis as logical no-undo.
      790   define variable mVisCUrentVin as logical no-undo.
      791   if session:batch-mode
      792   then
      793      mBatchMode = yes.
      794   if mBatchMode = ? then do:
      795     mVisCUrentVin = current-window:visible.
      796     mFameOldVis = mFramBachModHandle:visible.
      797     mFramBachModHandle:visible  = yes.
      798     mBatchMode = mFramBachModHandle:visible ne yes.
      799     mFramBachModHandle:visible = mFameOldVis.
      800     current-window:visible = mVisCUrentVin.
      801   end.
      802    if  log-manager:logfile-name ne ?
      803     then DO:
      804         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      805         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      806         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      807     end.
      808   on choose of B-WaitFramStop in frame waitfram
      809   do:
      810     mWaitFramStop = yes.
      811     mWaitFramStopUser = yes.
      812   end.
      813   function waitfram-check-timeout returns logical():
      814      define variable vtime as int64 no-undo.
      815      if mWaitFramStopTimeOut
      816      then
      817         return yes.
      818      vtime = ( now - mWaitFramStartProc ) / 1000 .
      819      if     mWaitFramTimeOut ne ?
      820         and mWaitFramTimeOut ne 0
      821         and mWaitFramTimeOut lt vtime
      822      then do:
      823         mWaitFramStopTimeOut = yes.
      824      end.
      825      return mWaitFramStopTimeOut.
      826   end.
      827   procedure waitfram-hide :
      828     if not session:batch-mode
      829     then do
      830     on error undo, return error return-value
      831     :
      832       pause 0 before-hide .
      833       if not mBatchMode then
      834         hide frame waitfram .
      835     if     not mWaitFramView
      836        and mWaitProcEvent
      837     then
      838       process events .
      839     end.
      840   end procedure.
      841   procedure waitfram-show :
      842     define input  parameter p-message as character no-undo .
      843     define variable v-left-margin as integer   no-undo .
      844     if not session:batch-mode
      845     then do
      846     on error undo, return error return-value
      847     :
      848       if length(p-message) <= 70 then do:
      849         assign
      850           v-left-margin = integer((70 - length(p-message)) / 2)
      851         .
      852         assign
      853           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      854         .
      855         assign
      856           v-waitfram-action01 = " "
      857           v-waitfram-action02 = " "
      858                                    + fill(" ", v-left-margin)
      859                                    + p-message
      860           v-waitfram-action03 = " "
      861         .
      862       end.
      863       else do:
      864         define variable vRindex1 as integer no-undo.
      865         define variable vRindex2 as integer no-undo.
      866         vRindex1 = r-index(p-message," ",70).
      867         if vRindex1 = 0
      868         then
      869            vRindex1 = 70.
      870         if length(p-message)  <= vRindex1 + 70 then do:
      871           assign
      872             v-waitfram-action01 = " "
      873             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      874             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      875           .
      876         end.
      877         else do:
      878           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      879           if vRindex2 <= vRindex1
      880           then
      881              vRindex2 = vRindex1 + 70.
      882           assign
      883             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      884             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      885             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      886           .
      887         end.
      888       end.
      889       B-viewProcInfo:visible   in frame waitfram = no.
      890       B-viewProcInfo:sensitive in frame waitfram = no.
      891       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      892       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      893       if  (   mWaitFramView
      894          or  mWaitProcEvent)
      895          and not mBatchMode
      896       then
      897          display
      898             v-waitfram-action01 skip
      899             v-waitfram-action02 skip
      900             v-waitfram-action03 skip
      901          with frame waitfram .
      902       if     mWaitFramView
      903          then do:
      904             if     mWaitFramInterval ne ?
      905                and not mBatchMode
      906             then
      907                wait-for go of frame waitfram pause mWaitFramInterval.
      908          end.
      909          else
      910             if     mWaitProcEvent
      911                and not mBatchMode
      912             then
      913                process events .
      914     end.
      915   end procedure.
      916      procedure waitfram-show-this:
      917         define input  parameter iInterval as int64 no-undo.
      918         define variable vtime as int64 no-undo.
      919         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      920         mWaitFramInterval = iInterval.
      921         run waitfram-show (substitute("&1&2 &3&4" ,
      922                                       mWaitFramTextBeg ,
      923                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      924                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      925                                       mWaitFramTextEnd
      926                                      )
      927                           ).
      928      end.
      929      procedure WaitFramRunPause:
      930         define input  parameter iInterval as dec no-undo.
      931         define variable vStart  as datetime-tz no-undo.
      932         define variable vend    as datetime-tz no-undo.
      933         define variable vint as int64 no-undo.
      934         define variable vOk as logical no-undo.
      935         vStart = now.
      936         vend   = vStart.
      937         publish "WaitFramPause" (iInterval,output vOk).
      938         vend   =  now.
      939         vint = vend - vStart.
      940         vint = iInterval - vint / 1000.
      941         if     not mWaitFramStop
      942            and (   vint > 0
      943                 or (    not vOk
      944                     and iInterval eq ?
      945                     )
      946                 )
      947         then
      948            run waitfram-show-this (iInterval).
      949         vend   =  now.
      950         vint = vend - vStart.
      951         vint = iInterval - vint / 1000.
      952         if     not mWaitFramStop
      953            and vint > 0
      954         then do:
      955            run gbl/pause.p (vint * 1000).
      956         end.
      957         if iInterval ne ?
      958         then
      959            publish "WaitFramStop".
      960         waitfram-check-timeout().
      961      end.
      962      procedure WaitFramWaitFor:
      963         define input  parameter iInterval as dec no-undo.
      964         assign
      965            mWaitFramStartProc   = now
      966            mWaitFramStopUser    = no
      967            mWaitFramStopTimeOut = no
      968         .
      969         block-wait:
      970         do while not mWaitFramStop:
      971            run WaitFramRunPause (iInterval).
      972            if  waitfram-check-timeout()
      973            then do:
      974               leave block-wait.
      975            end.
      976         end.
      977         run waitfram-hide.
      978      end.
      979   procedure waitfram-join :
      980     define input  parameter p-line-1  as character no-undo .
      981     define input  parameter p-line-2  as character no-undo .
      982     define input  parameter p-line-3  as character no-undo .
      983     define output parameter p-message as character no-undo .
      984     do
      985     on error undo, return error return-value
      986     :
      987       assign
      988         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      989                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      990                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      991       .
      992     end.
      993   end procedure.
      994   function waitfram-join-function returns character
      995     (input p-line-1 as character
      996     ,input p-line-2 as character
      997     ,input p-line-3 as character
      998     ).
      999     define variable v-message as character no-undo .
     1000     run waitfram-join in this-procedure
     1001       (input  p-line-1
     1002       ,input  p-line-2
     1003       ,input  p-line-3
     1004       ,output v-message
     1005       ) .
     1006     return v-message .
     1007   end function .
     1008   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1009   procedure cur-time :
     1010      define output parameter p-today as date      no-undo .
     1011      define output parameter p-time  as integer   no-undo .
     1012     do
     1013     on error undo, return error
     1014     :
     1015       define variable v-date1 as date      no-undo .
     1016       define variable v-date2 as date      no-undo .
     1017       define variable v-time  as integer   no-undo .
     1018       assign
     1019         v-date1 = today
     1020         v-time  = time
     1021         v-date2 = today
     1022       .
     1023       if v-date1 <> v-date2
     1024       then do:
     1025         assign
     1026           v-date1 = today
     1027           v-time  = v-time
     1028         .
     1029       end.
     1030       assign
     1031         p-today = v-date1
     1032         p-time  = v-time
     1033       .
     1034     end.
     1035   end.
     1036   function cur-time-date returns character
     1037   :
     1038     return string(today, '99/99/9999':U) .
     1039   end.
     1040   function cur-time-mjd returns decimal
     1041   :
     1042     define variable v-date as date      no-undo .
     1043     define variable v-time as integer   no-undo .
     1044     run cur-time in this-procedure
     1045       (output v-date
     1046       ,output v-time
     1047       ) .
     1048     return integer(v-date) - 2400002 + (v-time / 86400) .
     1049   end.
     1050   function cur-time-get-ending-index returns integer
     1051   (input p-number as integer
     1052   )
     1053   :
     1054     if p-number < 0
     1055     or p-number = ?
     1056     then do:
     1057       return 1 .
     1058     end.
     1059     define variable v-rest as integer   no-undo .
     1060     assign
     1061       p-number = p-number modulo 100
     1062     .
     1063     if p-number < 20
     1064     then do:
     1065       assign
     1066         v-rest = p-number
     1067       .
     1068     end.
     1069     else do:
     1070       assign
     1071         v-rest = p-number modulo 10
     1072       .
     1073     end.
     1074     case v-rest :
     1075       when 1
     1076       then do:
     1077         return 2 .
     1078       end.
     1079       when 2 or
     1080       when 3 or
     1081       when 4
     1082       then do:
     1083         return 3 .
     1084       end.
     1085       otherwise do:
     1086         return 1 .
     1087       end.
     1088     end case .
     1089   end.
     1090   procedure cur-time-mjd-to-date :
     1091      define input  parameter i-mjd-diff as decimal no-undo.
     1092      define output parameter o-Date     as date    no-undo.
     1093      define output parameter o-Time     as integer no-undo.
     1094      define variable v-day-number as integer   no-undo .
     1095      if    i-mjd-diff < 0
     1096         or i-mjd-diff = ?
     1097      then do:
     1098         return "?" .
     1099      end.
     1100      assign
     1101         v-day-number = truncate(i-mjd-diff,0).
     1102         o-Date = date(v-day-number + 2400002).
     1103         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1104     .
     1105   end.
     1106   function cur-time-mjd-to-string returns character
     1107   (input p-mjd-diff as decimal
     1108   )
     1109   :
     1110     define variable v-day-number as integer   no-undo .
     1111     define variable v-seconds    as integer   no-undo .
     1112     define variable v-hour       as integer   no-undo .
     1113     define variable v-min        as integer   no-undo .
     1114     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1115     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1116     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1117     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1118     if p-mjd-diff < 0
     1119     or p-mjd-diff = ?
     1120     then do:
     1121       return "?" .
     1122     end.
     1123     assign
     1124       v-day-number = integer(truncate(p-mjd-diff,0))
     1125       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1126     .
     1127     if v-seconds > 86400
     1128     then do:
     1129       assign
     1130         v-seconds = 86400 - 1
     1131       .
     1132     end.
     1133     if v-seconds < 0
     1134     then do:
     1135       assign
     1136         v-seconds = 0
     1137       .
     1138     end.
     1139     assign
     1140       v-hour = truncate(v-seconds / 3600, 0)
     1141     .
     1142     assign
     1143       v-seconds = v-seconds modulo 3600
     1144     .
     1145     assign
     1146       v-min = truncate(v-seconds / 60, 0)
     1147     .
     1148     assign
     1149       v-seconds = v-seconds modulo 60
     1150     .
     1151     return
     1152         (if v-day-number <> 0
     1153           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1154           else ""
     1155         )
     1156       + (if v-day-number <> 0 or v-hour <> 0
     1157           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1158           else ""
     1159         )
     1160       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1161           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1162           else ""
     1163         )
     1164       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1165       .
     1166   end.
     1167   function cur-time-string returns character
     1168   :
     1169     define variable v-date as date      no-undo .
     1170     define variable v-time as integer   no-undo .
     1171     run cur-time in this-procedure
     1172       (output v-date
     1173       ,output v-time
     1174       ) .
     1175     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1176   end.
     1177   function cur-time-string-sec returns character
     1178   :
     1179     define variable v-date as date      no-undo .
     1180     define variable v-time as integer   no-undo .
     1181     run cur-time in this-procedure
     1182       (output v-date
     1183       ,output v-time
     1184       ) .
     1185     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1186   end.
     1187   function cur-time-custom  returns character
     1188   (input p-prefix as character
     1189   ,input p-date-format as character
     1190   ,input p-delimiter as character
     1191   ,input p-time-format as character
     1192   ,input p-suffix as character
     1193   )
     1194   :
     1195     define variable v-date as date      no-undo .
     1196     define variable v-time as integer   no-undo .
     1197     run cur-time in this-procedure
     1198       (output v-date
     1199       ,output v-time
     1200       ) .
     1201     return
     1202       p-prefix
     1203       + string(v-date, p-date-format)
     1204       + p-delimiter
     1205       + string(v-time, p-time-format)
     1206       + p-suffix
     1207       .
     1208   end.
     1209   function cur-time-print  returns character
     1210   :
     1211     define variable v-date as date      no-undo .
     1212     define variable v-time as integer   no-undo .
     1213     run cur-time in this-procedure
     1214       (output v-date
     1215       ,output v-time
     1216       ) .
     1217     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1218   end.
     1219   function cur-time-datetime returns datetime
     1220   :
     1221     define variable v-char as character no-undo .
     1222     define variable v-datetime as datetime no-undo .
     1223     v-char = cur-time-string().
     1224     v-datetime = datetime(v-char).
     1225     return  v-datetime.
     1226   end.
     1227   function cur-time-string-msec returns character
     1228   :
     1229     define variable v-date as datetime  no-undo .
     1230     v-date = now.
     1231     return string(v-date) .
     1232   end.
