     2302   CHR(9)
     2303   CHR(9)
     2304   CHR(9)
     2305   'чеков:' CHR(9)
     2306   all_temp-cpych.num-chk CHR(9)
     2307   all_temp-cpych.doc-qnty CHR(9)
     2308   all_temp-cpych.doc-qnty-2 CHR(9)
     2309   all_temp-cpych.sum-tot  CHR(9)
     2310   CHR(9)
     2311   CHR(9)
     2312   all_temp-cpych.discnt-sum  CHR(9)
     2313   all_temp-cpych.sum-netto
     2314   skip
     2315   .
     2316   ii-excel = ii-excel + 1.
     2317   run waitfram-hide in this-procedure .
     2318   HIDE STREAM PrnLibStream FRAME BottomFrame .
     2319   OUTPUT STREAM PrnLibStream CLOSE.
     2320   if Make-Excel then output stream ForExcel close.
     2321   run waitfram-hide in this-procedure .
     2322   run prn-lib-prn-file in this-procedure (
     2323                                             input parParentProc
     2324                                             ,input 8
     2325                                             ).
     2326   procedure process-inkas :
     2327   define parameter buffer buf_temp-inkas for temp-inkas.
     2328   define variable v-doc-code as character no-undo .
     2329   define buffer buf_tt-cash-pay  for tt-cash-pay.
     2330   define buffer buf_chk-pay for ub.chk-pay.
     2331   define buffer buf_chk-doc for ub.chk-doc.
     2332   define buffer buf_temp-cpych for temp-cpych.
     2333   define buffer card-obj_temp-cpych for temp-cpych.
     2334   define buffer card_temp-cpych for temp-cpych.
     2335   for each buf_tt-cash-pay,
     2336         each buf_chk-pay no-lock where
     2337             buf_chk-pay.out-code = buf_temp-inkas.inkas-code
     2338           and buf_chk-pay.pay-code = buf_tt-cash-pay.cdpay-code
     2339           and buf_chk-pay.curr-code = buf_tt-cash-pay.curr-code
     2340   by  buf_chk-pay.doc-code           :
     2341     if buf_chk-pay.pay-card = "0"
     2342     or buf_chk-pay.pay-card = ""
     2343     or buf_chk-pay.pay-card = ? then next.
     2344     if p-pay-card <> ''
     2345     and buf_chk-pay.pay-card <> p-pay-card then next.
     2346     if v-doc-code <> buf_chk-pay.doc-code then do:
     2347       find first card-obj_temp-cpych where
     2348               card-obj_temp-cpych.pay-card = buf_chk-pay.pay-card
     2349           and card-obj_temp-cpych.obj-type = buf_chk-pay.obj-type
     2350           and card-obj_temp-cpych.obj-code = buf_chk-pay.obj-code
     2351           and card-obj_temp-cpych.category = "card-obj"
     2352           no-error.
     2353       if not available card-obj_temp-cpych then do:
     2354         create card-obj_temp-cpych.
     2355         assign
     2356         card-obj_temp-cpych.pay-card = buf_chk-pay.pay-card
     2357         card-obj_temp-cpych.fpay-card = fill( chr(32) , 16 - length(buf_chk-pay.pay-card)) + buf_chk-pay.pay-card
     2358         card-obj_temp-cpych.chk-date  = ?
     2359         card-obj_temp-cpych.chk-time = 0
     2360         card-obj_temp-cpych.doc-code = ''
     2361         card-obj_temp-cpych.obj-type = buf_chk-pay.obj-type
     2362         card-obj_temp-cpych.obj-code = buf_chk-pay.obj-code
     2363         card-obj_temp-cpych.b-code   = 0
     2364         card-obj_temp-cpych.line-num  = 0
     2365         card-obj_temp-cpych.category = "card-obj"
     2366         .
     2367       end.
     2368       find first card_temp-cpych where
     2369               card_temp-cpych.pay-card = buf_chk-pay.pay-card
     2370           and card_temp-cpych.obj-type = ''
     2371           and card_temp-cpych.obj-code = 0
     2372           and card_temp-cpych.category = "card"
     2373           no-error.
     2374       if not available card_temp-cpych then do:
     2375         create card_temp-cpych.
     2376         assign
     2377         card_temp-cpych.pay-card = buf_chk-pay.pay-card
     2378         card_temp-cpych.fpay-card = fill( chr(32) , 16 - length(buf_chk-pay.pay-card)) + buf_chk-pay.pay-card
     2379         card_temp-cpych.chk-date  = ?
     2380         card_temp-cpych.chk-time = 0
     2381         card_temp-cpych.doc-code = ''
     2382         card_temp-cpych.obj-type = ''
     2383         card_temp-cpych.obj-code = 0
     2384         card_temp-cpych.b-code   = 0
     2385         card_temp-cpych.line-num  = 0
     2386         card_temp-cpych.category = "card"
     2387         .
     2388       end.
     2389       find first obj_temp-cpych where
     2390                 obj_temp-cpych.obj-type = obj-list.obj-type
     2391             and obj_temp-cpych.obj-code = obj-list.obj-code
     2392             and obj_temp-cpych.category = "obj" no-error.
     2393       if not available obj_temp-cpych then do:
     2394         create obj_temp-cpych.
     2395         assign
     2396         obj_temp-cpych.pay-card = ''
     2397         obj_temp-cpych.fpay-card = ''
     2398         obj_temp-cpych.chk-date  = ?
     2399         obj_temp-cpych.chk-time = 0
     2400         obj_temp-cpych.doc-code = ''
     2401         obj_temp-cpych.obj-type = obj-list.obj-type
     2402         obj_temp-cpych.obj-code = obj-list.obj-code
     2403         obj_temp-cpych.b-code  = 0
     2404         obj_temp-cpych.gds-code = 0
     2405         obj_temp-cpych.line-num = v-line + 1
     2406         v-line = v-line + 1
     2407         obj_temp-cpych.num-chk = 0
     2408         obj_temp-cpych.discnt = 0
     2409         obj_temp-cpych.category = "obj"
     2410         .
     2411       end.
     2412       find first all_temp-cpych where
     2413                 all_temp-cpych.obj-type = ''
     2414             and all_temp-cpych.obj-code = 0
     2415             and all_temp-cpych.category = "all" no-error.
     2416       if not available all_temp-cpych then do:
     2417         create all_temp-cpych.
     2418         assign
     2419         all_temp-cpych.pay-card = ''
     2420         all_temp-cpych.fpay-card = ''
     2421         all_temp-cpych.chk-date  = ?
     2422         all_temp-cpych.chk-time = 0
     2423         all_temp-cpych.doc-code = ''
     2424         all_temp-cpych.obj-type = ''
     2425         all_temp-cpych.obj-code = 0
     2426         all_temp-cpych.b-code  = 0
     2427         all_temp-cpych.gds-code = 0
     2428         all_temp-cpych.line-num = v-line + 1
     2429         v-line = v-line + 1
     2430         all_temp-cpych.num-chk = 0
     2431         all_temp-cpych.discnt = 0
     2432         all_temp-cpych.category = "all"
     2433         .
     2434       end.
     2435       find first buf_temp-cpych where
     2436               buf_temp-cpych.pay-card = buf_chk-pay.pay-card
     2437           and buf_temp-cpych.doc-code = buf_chk-pay.doc-code no-error.
     2438       if not available buf_temp-cpych then do:
     2439         find first buf_chk-doc no-lock where
     2440                   buf_chk-doc.doc-code = buf_chk-pay.doc-code no-error.
     2441         if available buf_chk-doc then do:
     2442           assign
     2443           card-obj_temp-cpych.num-chk = card-obj_temp-cpych.num-chk + 1
     2444           card_temp-cpych.num-chk     = card_temp-cpych.num-chk + 1
     2445           obj_temp-cpych.num-chk     = obj_temp-cpych.num-chk + 1
     2446           all_temp-cpych.num-chk     = all_temp-cpych.num-chk + 1
     2447           .
     2448           for each buf_chk-gds no-lock where
     2449                   buf_chk-gds.doc-code = buf_chk-doc.doc-code:
     2450             create buf_temp-cpych.
     2451             assign
     2452             buf_temp-cpych.pay-card = buf_chk-pay.pay-card
     2453             buf_temp-cpych.fpay-card = fill( chr(32) , 16 - length(buf_chk-pay.pay-card)) + buf_chk-pay.pay-card
     2454             buf_temp-cpych.chk-date  = buf_chk-doc.chk-date
     2455             buf_temp-cpych.chk-time = buf_chk-doc.chk-time
     2456             buf_temp-cpych.doc-code = buf_chk-doc.doc-code
     2457             buf_temp-cpych.obj-type = buf_chk-doc.obj-type
     2458             buf_temp-cpych.obj-code = buf_chk-doc.obj-code
     2459             buf_temp-cpych.b-code   = buf_chk-gds.b-code
     2460             buf_temp-cpych.price-base = buf_chk-gds.price-base
     2461             buf_temp-cpych.doc-qnty = buf_chk-gds.doc-qnty
     2462             buf_temp-cpych.doc-qnty-2 = (if buf_chk-gds.pump > 0
     2463                                          then buf_chk-gds.doc-qnty * buf_chk-gds.density
     2464                                          else 0)
     2465             buf_temp-cpych.sum-tot   = buf_chk-gds.doc-qnty * buf_chk-gds.price-base
     2466             buf_temp-cpych.discnt    = buf_chk-gds.discnt
     2467             buf_temp-cpych.sum-netto  = buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     2468             buf_temp-cpych.num-chk = 0
     2469             buf_temp-cpych.line-num = buf_chk-gds.line-num
     2470             buf_temp-cpych.is-ptrl = (buf_chk-gds.pump > 0)
     2471             buf_temp-cpych.category = ""
     2472             .
     2473             assign
     2474             card-obj_temp-cpych.doc-qnty  = card-obj_temp-cpych.doc-qnty + buf_chk-gds.doc-qnty
     2475             card-obj_temp-cpych.doc-qnty-2  = card-obj_temp-cpych.doc-qnty-2 + (if buf_chk-gds.pump > 0
     2476                                                                                 then buf_chk-gds.doc-qnty * buf_chk-gds.density
     2477                                                                                 else 0)
     2478             card-obj_temp-cpych.sum-tot   = card-obj_temp-cpych.sum-tot + buf_chk-gds.doc-qnty * buf_chk-gds.price-base
     2479             card-obj_temp-cpych.sum-netto  = card-obj_temp-cpych.sum-netto + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     2480             card_temp-cpych.doc-qnty  = card_temp-cpych.doc-qnty + buf_chk-gds.doc-qnty
     2481             card_temp-cpych.doc-qnty-2  = card_temp-cpych.doc-qnty + (if buf_chk-gds.pump > 0
     2482                                                                       then buf_chk-gds.doc-qnty * buf_chk-gds.density
     2483                                                                       else 0)
     2484             card_temp-cpych.sum-tot   = card_temp-cpych.sum-tot + buf_chk-gds.doc-qnty * buf_chk-gds.price-base
     2485             card_temp-cpych.sum-netto  = card_temp-cpych.sum-netto + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     2486             .
     2487             release buf_temp-cpych.
     2488           end.
     2489         end.
     2490         release card-obj_temp-cpych.
     2491         release card_temp-cpych.
     2492         release obj_temp-cpych.
     2493         release all_temp-cpych.
     2494       end.
     2495       v-doc-code = buf_chk-pay.doc-code.
     2496     end.
     2497   end.
     2498   end procedure.
