     1512                             (if available buf_currency
     1513                             then buf_currency.curr-abbr
     1514                             else string(v-curr-code)) + ")"
     1515                           )
     1516     .
     1517   end.
     1518   assign
     1519   sheetf.Excel-Column-Lable =  "№ карты,Дата-время,Чек №,Артикул,Наименование,Цена,Количество,Кол-во кг,Сумма без скидки,Тип скидки,% скидки,Сумма скидки,Сумма нетто"
     1520   sheetf.colformat = "1=@;2=@;3=@;4=@;5=@;6=0.00;7=0.000;8=0.000;9=0.00;11=0.00;12=0.00;13=0.00"
     1521   sheetf.sizes = "19,16,19,16,36,10,12,12,15,20,6,14,15"
     1522   v-r-b = (if v-curr-r-b = 'rubl':U or v-one-curr-code then yes else no)
     1523   .
