     1391      and thbjattr_thbj-attr.obj-code = v-cntxt-obj-code
     1392      and thbjattr_thbj-attr.upper-prop-code = 'dc-ref':U
     1393   on error undo, return error return-value :
     1394     case thbjattr_thbj-attr.prop-code:
     1395       when 'l-mask':U then do:
     1396         assign
     1397         par-l-mask = thbjattr_thbj-attr.property-value-logical.
     1398       end.
