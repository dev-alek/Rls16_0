     1410                   buf_inkas.shift-date  >= x-date-start
     1411               AND buf_inkas.shift-date  <= x-date-end
     1412               AND buf_inkas.obj-type   = obj-list.obj-type
     1413               AND buf_inkas.obj-code   = obj-list.obj-code:
     1414           IF X-Radio-task = 3
     1415           AND  ((buf_inkas.shift-date = x-date-start AND buf_inkas.shift-num < X-shift-start) OR
     1416                 (buf_inkas.shift-date = x-date-end AND  buf_inkas.shift-num > X-shift-end) ) THEN DO:
     1417              next _inkas.
     1418           END.
     1419           IF X-radio-task = 4
     1420           AND buf_inkas.shift-num <> X-Shift-Alone then DO:
     1421             next _inkas.
     1422           END.
