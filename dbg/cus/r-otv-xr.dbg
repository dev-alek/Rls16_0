     1432   DEFINE TEMP-TABLE tt-line NO-UNDO
     1433     FIELD artic        AS CHARACTER                                                     FORMAT "x(16)":U
     1434     FIELD prod-type    AS CHARACTER                                                     FORMAT "x(3)":U
     1435     FIELD prod-code    AS INTEGER                                                       FORMAT ">>>>>>>>9":U
     1436     FIELD gds-qty      AS DECIMAL   COLUMN-LABEL "Количество ! "                        FORMAT "->>>>>9.<<<":U
     1437     FIELD price-no-VAT AS DECIMAL   COLUMN-LABEL "Цена!за ед.изм."                      FORMAT "->>>>>>>9.99":U
     1438     FIELD sum-no-VAT   AS DECIMAL   COLUMN-LABEL "Стоимость товаров!всего без налога"   FORMAT "->>>>>>>>>>>>9.99":U
     1439     FIELD VAT-pc       AS DECIMAL   COLUMN-LABEL "Ставка!налога"                        FORMAT ">9.9<%":U
     1440     FIELD VAT          AS DECIMAL   COLUMN-LABEL "Сумма!налога"                         FORMAT "->>>>>>>9.99":U
     1441     FIELD sum          AS DECIMAL   COLUMN-LABEL "Ст-ть товаров!с учетом налога"        FORMAT "->>>>>>>>>>9.99":U
     1442     FIELD country      AS CHARACTER COLUMN-LABEL "Страна!происхождения"                 FORMAT "x(15)":U
     1443     FIELD GTD          AS CHARACTER COLUMN-LABEL "Номер грузовой таможенной!декларации" FORMAT "x(31)":U
     1444     FIELD is-positive  AS LOGICAL
     1445     INDEX pi           IS UNIQUE    PRIMARY is-positive prod-type prod-code artic VAT-pc price-no-VAT GTD.
     1446   DEFINE VARIABLE str                  AS CHARACTER NO-UNDO.
     1447   DEFINE VARIABLE gds-str              AS CHARACTER NO-UNDO.
     1448   DEFINE VARIABLE gds-str1             AS CHARACTER NO-UNDO.
     1449   DEFINE VARIABLE gds-str2             AS CHARACTER NO-UNDO.
     1450   DEFINE VARIABLE v-lines-counter      AS INTEGER   NO-UNDO.
     1451   DEFINE VARIABLE v-qnty               AS DECIMAL   NO-UNDO FORMAT "->>>>>9.<<<":U.
     1452   DEFINE VARIABLE v-price              AS DECIMAL   NO-UNDO.
     1453   DEFINE VARIABLE v-price-no-VAT       AS DECIMAL   NO-UNDO FORMAT "->>>>>>>9.99":U.
     1454   DEFINE VARIABLE v-sum                AS DECIMAL   NO-UNDO FORMAT "->>>>>>>>>>9.99":U.
     1455   DEFINE VARIABLE v-sum-no-VAT         AS DECIMAL   NO-UNDO FORMAT "->>>>>>>>>>>>9.99":U.
     1456   DEFINE VARIABLE v-sum-excise         AS DECIMAL   NO-UNDO FORMAT ">>>>>9.99":U.
     1457   DEFINE VARIABLE v-VAT                AS DECIMAL   NO-UNDO FORMAT "->>>>>>>9.99":U.
     1458   DEFINE VARIABLE v-SLT                AS DECIMAL   NO-UNDO.
     1459   DEFINE VARIABLE v-parts-price        AS DECIMAL   NO-UNDO.
     1460   DEFINE VARIABLE v-parts-price-no-VAT AS DECIMAL   NO-UNDO.
     1461   DEFINE VARIABLE v-parts-sum          AS DECIMAL   NO-UNDO.
     1462   DEFINE VARIABLE v-parts-sum-no-VAT   AS DECIMAL   NO-UNDO.
     1463   DEFINE VARIABLE v-parts-sum-excise   AS DECIMAL   NO-UNDO.
     1464   DEFINE VARIABLE v-parts-VAT          AS DECIMAL   NO-UNDO.
     1465   DEFINE VARIABLE v-parts-SLT          AS DECIMAL   NO-UNDO.
     1466   DEFINE VARIABLE v-tot-sum            AS DECIMAL   NO-UNDO.
     1467   DEFINE VARIABLE v-tot-VAT            AS DECIMAL   NO-UNDO.
     1468   DEFINE VARIABLE v-tot-SLT            AS DECIMAL   NO-UNDO.
     1469   DEFINE VARIABLE v-tot-sum-no-VAT     AS DECIMAL   NO-UNDO.
     1470   DEFINE VARIABLE v-prt-qnty           AS DECIMAL   NO-UNDO.
     1471   DEFINE VARIABLE v-prt-VAT            AS DECIMAL   NO-UNDO.
     1472   DEFINE VARIABLE v-prt-SLT            AS DECIMAL   NO-UNDO.
     1473   DEFINE VARIABLE v-prt-sum-no-VAT     AS DECIMAL   NO-UNDO.
     1474   DEFINE VARIABLE v-prt-sum            AS DECIMAL   NO-UNDO.
     1475   DEFINE VARIABLE v-tot-prt-qnty       AS DECIMAL   NO-UNDO.
     1476   DEFINE VARIABLE v-tot-prt-VAT        AS DECIMAL   NO-UNDO.
     1477   DEFINE VARIABLE v-tot-prt-SLT        AS DECIMAL   NO-UNDO.
     1478   DEFINE VARIABLE v-tot-prt-sum-no-VAT AS DECIMAL   NO-UNDO.
     1479   DEFINE VARIABLE v-tot-prt-sum        AS DECIMAL   NO-UNDO.
     1480   DEFINE VARIABLE v-country            AS CHARACTER NO-UNDO FORMAT "x(15)":U.
     1481   DEFINE VARIABLE v-GTD                AS CHARACTER NO-UNDO FORMAT "x(31)":U.
     1482   DEFINE VARIABLE v-single-line        AS CHARACTER NO-UNDO.
     1483   DEFINE VARIABLE t-m_adr              AS CHARACTER NO-UNDO.
     1484   DEFINE VARIABLE t-a_adr              AS CHARACTER NO-UNDO.
     1485   DEFINE VARIABLE t-m_INN              AS CHARACTER NO-UNDO.
     1486   DEFINE VARIABLE t-a_INN              AS CHARACTER NO-UNDO.
     1487   DEFINE VARIABLE t-num                AS CHARACTER NO-UNDO.
     1488   DEFINE VARIABLE v-num                AS CHARACTER NO-UNDO.
     1489   DEFINE VARIABLE is_positive          AS LOGICAL   NO-UNDO.
     1490   DEFINE BUFFER buf_suppl FOR ub.clients.
     1491   DEFINE BUFFER buf_owner FOR ub.clients.
     1492   DEFINE BUFFER buf_mf    FOR ub.firm.
     1493   DEFINE BUFFER buf_af    FOR ub.firm.
     1494   DEFINE BUFFER buf_mp    FOR ub.person.
     1495   DEFINE BUFFER buf_ap    FOR ub.person.
     1496   DEFINE FRAME r-factur-print-1
     1497     sym1  SPACE( 0 ) ub.goods.gds-name  COLUMN-LABEL "Наименование товара! " FORMAT "x(59)":U  SPACE( 0 )
     1498     sym2  SPACE( 0 ) ub.goods.unit-base COLUMN-LABEL "Ед.!изм."              FORMAT "x(4)":U   SPACE( 0 )
     1499     sym3  SPACE( 0 ) v-qnty             COLUMN-LABEL "Количество ! "                           SPACE( 0 )
     1500     sym4  SPACE( 0 ) v-price-no-VAT     COLUMN-LABEL "Цена!за ед.изм."                         SPACE( 0 )
     1501     sym5  SPACE( 0 ) v-sum-no-VAT       COLUMN-LABEL "Стоимость товаров!всего без налога"      SPACE( 0 )
     1502     sym6  SPACE( 0 ) v-sum-excise       COLUMN-LABEL "в т.ч.!акциз"                            SPACE( 0 )
     1503     sym7  SPACE( 0 ) ub.doc-line.Vat-pc COLUMN-LABEL "Ставка!налога"         FORMAT ">9.9<%":U SPACE( 0 )
     1504     sym8  SPACE( 0 ) v-VAT              COLUMN-LABEL "Сумма!налога"                            SPACE( 0 )
     1505     sym9  SPACE( 0 ) v-sum              COLUMN-LABEL "Ст-ть товаров!с учетом налога"           SPACE( 0 )
     1506     sym10 SPACE( 0 ) v-country          COLUMN-LABEL "Страна!происхождения"                    SPACE( 0 )
     1507     sym11 SPACE( 0 ) v-GTD              COLUMN-LABEL "Номер грузовой таможенной!декларации"    SPACE( 0 ) sym12 SPACE( 0 )
     1508   HEADER STRING( "Страница " + STRING( PAGE-NUMBER( PrnLibStream ), ">>9":U ) ) AT 180 FORMAT "x(13)":U SKIP
     1509                  v-single-line                                                  AT   1 FORMAT "x(198)":U
     1510   WITH WIDTH 235 DOWN STREAM-IO.
     1511   FORM HEADER
     1512     v-single-line FORMAT "x(198)":U       AT  1 SKIP
     1513     "Продолжение - на следующей странице" AT 30 SKIP
     1514   WITH FRAME Bottomframe WIDTH 235 PAGE-BOTTOM NO-LABELS NO-BOX.
     1515   FUNCTION SheetFormat RETURNS INTEGER :
     1516     DEFINE VARIABLE log-sheet-answer AS LOGICAL NO-UNDO.
     1517   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1518   do:
     1519     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1520       (input  v-cntxt-db-num
     1521       ,input  v-cntxt-userid
     1522       ,input  0
     1523       ,input  'actn_waybills-to-file_print':U
     1524       ,input  'firm':U
     1525       ,input  v-cntxt-host-code-obj
     1526       ,input  '':U
     1527       ,input  0
     1528       ,input  0
     1529       ,input  0
     1530       ,input  0
     1531       ,input  no
     1532       ,output log-sheet-answer
     1533       )  .
     1534   end.
     1535     RETURN ( IF log-sheet-answer THEN 8 ELSE 0 ).
     1536   END FUNCTION.
     1537   Main-Block:
     1538   DO ON ERROR   UNDO Main-Block, LEAVE Main-Block
     1539      ON END-KEY UNDO Main-Block, LEAVE Main-Block :
     1540     FIND buf_owner NO-LOCK WHERE
     1541          buf_owner.obj-type = 'орг':U      AND
     1542          buf_owner.obj-code = v-cntxt-host-code-obj.
     1543     FIND buf_suppl NO-LOCK WHERE
     1544          buf_suppl.obj-type = p-supp-type AND
     1545          buf_suppl.obj-code = p-supp-code NO-ERROR.
     1546     IF NOT AVAILABLE buf_suppl THEN DO:
     1547       MESSAGE "Не найден поставщик: " p-supp-type p-supp-code "." VIEW-AS ALERT-BOX.
     1548       RETURN ERROR.
     1549     END.
     1550     RUN init-var                  IN THIS-PROCEDURE.
     1551     RUN calc-sum                  IN THIS-PROCEDURE.
     1552     RUN print-responsible_storage IN THIS-PROCEDURE.
     1553   END.
     1554   PROCEDURE init-var :
     1555     ASSIGN v-single-line   = FILL( "-", 198 )
     1556            v-lines-counter = 1
     1557            t-num           = "за период с " +
     1558                              STRING( IF p-date-from > TODAY THEN TODAY ELSE p-date-from, "99/99/9999":U ) + " по " +
     1559                              STRING( IF p-date-till > TODAY THEN TODAY ELSE p-date-till, "99/99/9999":U )
     1560            v-num           = " № " + p-scf-code + " от " +
     1561                              STRING( IF p-date-till > TODAY THEN TODAY ELSE p-date-till, "99/99/9999":U ).
     1562     IF p-ins-date = YES THEN DO:
     1563       ASSIGN p-pay-code = p-pay-code + " от " + STRING( IF p-date-till > TODAY THEN TODAY ELSE p-date-till, "99/99/9999":U ).
     1564     END.
     1565     IF buf_owner.obj-type = 'орг':U THEN DO:
     1566       FIND buf_mf  NO-LOCK WHERE buf_mf.firm-code   = v-cntxt-host-code-obj.
     1567       ASSIGN t-m_adr = ( ( IF buf_mf.ind <> 0 THEN STRING( buf_mf.ind ) + " ":U ELSE "":U ) + buf_mf.city + " ":U +
     1568                        TRIM( buf_mf.addres1 ) + " ":U + TRIM( buf_mf.addres2 ) )
     1569              t-m_INN = buf_mf.inn + ( IF buf_mf.kpp = ? OR TRIM( buf_mf.kpp ) = "":U THEN "":U ELSE ( "/" + buf_mf.kpp ) ).
     1570     END.                           ELSE DO:
     1571       FIND buf_mp  NO-LOCK WHERE buf_mp.psn-code    = v-cntxt-host-code-obj.
     1572       ASSIGN t-m_adr = ( ( IF buf_mp.ind <> 0 THEN STRING( buf_mp.ind ) + " ":U ELSE "":U ) + buf_mp.city + " ":U +
     1573                        TRIM( buf_mp.address )                                  )
     1574              t-m_INN = buf_mp.inn + ( IF buf_mp.kpp = ? OR TRIM( buf_mp.kpp ) = "":U THEN "":U ELSE ( "/" + buf_mp.kpp ) ).
     1575     END.
     1576     IF buf_suppl.obj-type = 'орг':U THEN DO:
     1577       FIND buf_af  NO-LOCK WHERE buf_af.firm-code   = p-supp-code.
     1578       ASSIGN t-a_adr = ( ( IF buf_af.ind <> 0 THEN STRING( buf_af.ind ) + " ":U ELSE "":U ) + buf_af.city + " ":U +
     1579                        TRIM( buf_af.addres1 ) + " ":U + TRIM( buf_af.addres2 ) )
     1580              t-a_INN = buf_af.inn + ( IF buf_af.kpp = ? OR TRIM( buf_af.kpp ) = "":U THEN "":U ELSE ( "/" + buf_af.kpp ) ).
     1581     END.                           ELSE DO:
     1582       FIND buf_ap  NO-LOCK WHERE buf_ap.psn-code    = p-supp-code.
     1583       ASSIGN t-a_adr = ( ( IF buf_ap.ind <> 0 THEN STRING( buf_ap.ind ) + " ":U ELSE "":U ) + buf_ap.city + " ":U +
     1584                        TRIM( buf_ap.address ) )
     1585              t-a_INN = buf_ap.inn + ( IF buf_ap.kpp = ? OR TRIM( buf_ap.kpp ) = "":U THEN "":U ELSE ( "/" + buf_ap.kpp ) ).
     1586     END.
     1587   END PROCEDURE.
     1588   PROCEDURE calc-sum :
     1589     FOR EACH ub.parts NO-LOCK WHERE
     1590              ub.parts.host-code  = v-cntxt-host-code-obj AND
     1591              ub.parts.supp-type  = p-supp-type AND
     1592              ub.parts.supp-code  = p-supp-code AND
     1593              ub.parts.status_    = YES         AND
     1594              ub.parts.fact-date >= p-date-from AND
     1595              ub.parts.fact-date <= p-date-till :
     1596       IF ub.parts.out-code = 'free-zone':U OR ub.parts.out-code = 'out-zone':U THEN DO: NEXT. END.
     1597       FIND ub.trn-doc NO-LOCK WHERE ub.trn-doc.doc-code = ub.parts.out-code NO-ERROR.
     1598       IF NOT AVAILABLE ub.trn-doc THEN DO: NEXT. END.
     1599       IF LOOKUP( ub.trn-doc.ext-doc-type, 'pc,ee,es,re,rs':U ) = 0 THEN DO: NEXT. END.
     1600       FIND ub.doc-line NO-LOCK WHERE
     1601            ub.doc-line.doc-code  = ub.trn-doc.doc-code AND
     1602            ub.doc-line.artic     = ub.parts.artic      AND
     1603            ub.doc-line.prod-type = ub.parts.prod-type  AND
     1604            ub.doc-line.prod-code = ub.parts.prod-code  NO-ERROR.
     1605       IF NOT AVAILABLE ub.doc-line THEN DO: NEXT. END.
     1606       FIND ub.goods NO-LOCK WHERE
     1607            ub.goods.artic     = ub.doc-line.artic     AND
     1608            ub.goods.prod-type = ub.doc-line.prod-type AND
     1609            ub.goods.prod-code = ub.doc-line.prod-code NO-ERROR.
     1610       IF NOT AVAILABLE ub.goods THEN DO: NEXT. END.
     1611       IF LOOKUP( ub.trn-doc.ext-doc-type, 're,rs':U ) <> 0 THEN DO:
     1612         IF ub.parts.purch-code <> INTEGER( '4':U ) THEN DO: NEXT. END.
     1613       END.                                                   ELSE DO:
     1614         IF ub.trn-doc.ext-doc-type <> 'pc':U AND
     1615            ub.parts.purch-code  = INTEGER( '4':U ) THEN DO:
     1616         END.                                                          ELSE DO:
     1617           IF ub.trn-doc.ext-doc-type =  'pc':U                AND
     1618              ub.parts.purch-code     =  INTEGER( '3':U ) AND
     1619              ub.parts.in-code        <> ub.parts.out-code                      THEN DO:
     1620           END.                                                                 ELSE DO: NEXT. END.
     1621         END.
     1622       END.
     1623       FIND obj-list WHERE obj-list.obj-type = ub.parts.obj-type AND obj-list.obj-code = ub.parts.obj-code NO-ERROR.
     1624       IF NOT AVAILABLE obj-list THEN DO: NEXT. END.
     1625       IF           obj-list.obj-type = 'скл':U THEN DO:
     1626         FIND ub.store NO-LOCK WHERE ub.store.obj-code = obj-list.obj-code NO-ERROR.
     1627         IF NOT AVAILABLE ub.store THEN DO: NEXT. END.
     1628         IF ub.store.host-code <> ub.parts.host-code THEN DO: NEXT. END.
     1629       END. ELSE IF obj-list.obj-type = 'маг':U  THEN DO:
     1630         FIND ub.shop  NO-LOCK WHERE ub.shop.obj-code  = obj-list.obj-code NO-ERROR.
     1631         IF NOT AVAILABLE ub.shop  THEN DO: NEXT. END.
     1632         IF ub.shop.host-code  <> ub.parts.host-code THEN DO: NEXT. END.
     1633       END.
     1634       ASSIGN is_positive = ( LOOKUP( ub.trn-doc.ext-doc-type, 're,rs':U ) = 0).
     1635       FIND FIRST ub.country NO-LOCK WHERE ub.country.alpha1 = ub.goods.alpha1 NO-ERROR.
     1636       ASSIGN v-country = IF AVAILABLE ub.country THEN ub.country.short-name ELSE "":U  .
     1637        IF ub.goods.gds-type <> 'у':U THEN DO:
     1638         ASSIGN v-GTD      = ub.parts.cst-code
     1639                v-prt-qnty = ub.parts.fact-qnty.
     1640         IF LOOKUP( ub.trn-doc.ext-doc-type, 're,rs':U ) <> 0 or ub.trn-doc.ext-doc-type = 'pc':U THEN DO:
     1641           ASSIGN v-prt-qnty = - v-prt-qnty.
     1642         END.
     1643   assign
     1644     price-rubl-with-tax-loc = parts.price-rubl
     1645     price-base-with-tax-loc = parts.price-base
     1646   .
     1647   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1649     (output varinvprb
     1650     )  .
     1651     if parts.out-code = 'free-zone':U     or
     1652        parts.out-code = 'out-zone':U   or
     1653        parts.doc-type = 'акт':U then do:
     1654       assign
     1655         in-vatp-have-vat-slt = yes.
     1656     end.
     1657     else do:
     1658       find first in-vatp_doc-attr no-lock
     1659         where in-vatp_doc-attr.doc-code  = parts.out-code
     1660           and in-vatp_doc-attr.attr-code = 'envd':U
     1661         no-error .
     1662       if not available in-vatp_doc-attr then do:
     1663         assign
     1664           in-vatp-have-vat-slt = yes.
     1665       end.
     1666       else do:
     1667            in-vatp-have-vat-slt = no.
     1668       end.
     1669     end.
     1670     assign
     1671      price-cli-with-tax-loc = parts.price-cli
     1672      cli-base-rate          = parts.cli-base-rate.
     1673     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
     1674              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
     1675     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
     1676             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
     1677             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
     1678             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
     1679             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
     1680             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     1681             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1682       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1683     assign
     1684       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     1685     assign
     1686       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1687       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1688       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1689       transport-cli-loc  = 0
     1690       other-cli-loc      = 0
     1691     .
     1692   ASSIGN
     1693             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1694       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1695   .
     1696         ASSIGN v-parts-VAT = ( IF PrintRubl THEN vat-rubl-loc      ELSE vat-base-loc      )
     1697                v-parts-SLT = ( IF PrintRubl THEN slt-rubl-loc      ELSE slt-base-loc      )
     1698                v-tax-price = ( IF PrintRubl THEN road-tax-rubl-loc ELSE road-tax-base-loc ).
     1699         IF v-parts-VAT = ? THEN DO: ASSIGN v-parts-VAT = 0. END.
     1700         IF v-parts-SLT = ? THEN DO: ASSIGN v-parts-SLT = 0. END.
     1701         IF v-tax-price = ? THEN DO: ASSIGN v-tax-price = 0. END.
     1702         ASSIGN v-parts-price-no-VAT =
     1703                  ( IF PrintRubl THEN ( price-rubl-with-tax-loc - ( vat-rubl-loc + slt-rubl-loc + road-tax-rubl-loc ) )
     1704                                 ELSE ( price-base-with-tax-loc - ( vat-base-loc + slt-base-loc + road-tax-base-loc ) ) )
     1705                v-parts-sum          =
     1706                  ( IF PrintRubl THEN   price-rubl-with-tax-loc ELSE price-base-with-tax-loc ) * v-prt-qnty.
     1707       END.
     1708       FIND tt-line WHERE
     1709            tt-line.is-positive  = is_positive          AND
     1710            tt-line.artic        = ub.goods.artic       AND
     1711            tt-line.prod-type    = ub.goods.prod-type   AND
     1712            tt-line.prod-code    = ub.goods.prod-code   AND
     1713            tt-line.VAT-pc       = ub.doc-line.VAT-pc   AND
     1714            tt-line.price-no-VAT = v-parts-price-no-VAT AND
     1715            tt-line.GTD          = v-GTD                NO-ERROR.
     1716       IF NOT AVAILABLE tt-line THEN DO:
     1717         CREATE tt-line.
     1718         ASSIGN tt-line.artic        = ub.goods.artic
     1719                tt-line.prod-type    = ub.goods.prod-type
     1720                tt-line.prod-code    = ub.goods.prod-code
     1721                tt-line.VAT-pc       = ub.doc-line.VAT-pc
     1722                tt-line.price-no-VAT = v-parts-price-no-VAT
     1723                tt-line.country      = v-country
     1724                tt-line.GTD          = v-GTD
     1725                tt-line.is-positive  = is_positive.
     1726       END.
     1727       ASSIGN tt-line.gds-qty    = tt-line.gds-qty    + v-prt-qnty
     1728              tt-line.sum-no-VAT = tt-line.sum-no-VAT + v-parts-price-no-VAT * v-prt-qnty
     1729              tt-line.VAT        = tt-line.VAT        + v-parts-VAT          * v-prt-qnty
     1730              tt-line.sum        = tt-line.sum        + v-parts-sum.
     1731     END.
     1732   END PROCEDURE.
     1733   PROCEDURE print-responsible_storage :
     1734     ASSIGN v-tot-sum-no-VAT = 0
     1735            v-tot-VAT        = 0
     1736            v-tot-sum        = 0.
     1737     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1738     RUN prn-lib-open-stream IN THIS-PROCEDURE ( INPUT parparentproc, INPUT 43, INPUT YES, INPUT NO ).
     1739     VIEW STREAM PrnLibStream FRAME Bottomframe.
     1740     RUN print-header-1 IN THIS-PROCEDURE.
     1741     FORM WITH FRAME r-factur-print-1.
     1742     FOR EACH tt-line WHERE tt-line.is-positive = YES :
     1743       RUN print-line IN THIS-PROCEDURE.
     1744       ASSIGN v-tot-sum-no-VAT = v-tot-sum-no-VAT + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE ABS( tt-line.sum-no-VAT ) )
     1745              v-tot-VAT        = v-tot-VAT        + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE ABS( tt-line.VAT        ) )
     1746              v-tot-sum        = v-tot-sum        + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE ABS( tt-line.sum        ) ).
     1747     END.
     1748     PUT  STREAM PrnLibStream v-single-line FORMAT "x(198)":U.
     1749     IF LINE-COUNTER( PrnLibStream ) + 7 > PAGE-SIZE( PrnLibStream ) THEN DO: PAGE STREAM PrnLibStream. END.
     1750     IF v-tot-sum-no-VAT <> 0 OR v-tot-VAT <> 0 OR v-tot-sum <> 0 THEN DO:
     1751       DISPLAY STREAM PrnLibStream "Всего"          @ ub.goods.gds-name
     1752                                   v-tot-sum-no-VAT @ v-sum-no-VAT
     1753                                   v-tot-VAT        @ v-VAT
     1754                                   v-tot-sum        @ v-sum
     1755       WITH FRAME r-factur-print-1.
     1756     END.
     1757     RUN print-footer IN THIS-PROCEDURE.
     1758     HIDE   STREAM PrnLibStream FRAME Bottomframe.
     1759     PAGE   STREAM PrnLibStream.
     1760     OUTPUT STREAM PrnLibStream CLOSE.
     1761     ASSIGN v-tot-sum-no-VAT = 0
     1762            v-tot-VAT        = 0
     1763            v-tot-sum        = 0.
     1764     RUN prn-lib-open-stream IN THIS-PROCEDURE ( INPUT parparentproc, INPUT 43, INPUT YES, INPUT YES ).
     1765     VIEW STREAM PrnLibStream FRAME Bottomframe.
     1766     RUN print-header-2 IN THIS-PROCEDURE.
     1767     FORM WITH FRAME r-factur-print-1.
     1768     FOR EACH tt-line WHERE tt-line.is-positive = NO  :
     1769       RUN print-line IN THIS-PROCEDURE.
     1770       ASSIGN v-tot-sum-no-VAT = v-tot-sum-no-VAT + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE ABS( tt-line.sum-no-VAT ) )
     1771              v-tot-VAT        = v-tot-VAT        + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE ABS( tt-line.VAT        ) )
     1772              v-tot-sum        = v-tot-sum        + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE ABS( tt-line.sum        ) ).
     1773     END.
     1774     PUT STREAM PrnLibStream v-single-line FORMAT "x(198)":U.
     1775     IF LINE-COUNTER( PrnLibStream ) + 7 > PAGE-SIZE( PrnLibStream ) THEN DO: PAGE STREAM PrnLibStream. END.
     1776     IF v-tot-sum-no-VAT <> 0 OR v-tot-VAT <> 0 OR v-tot-sum <> 0 THEN DO:
     1777       DISPLAY STREAM PrnLibStream "Всего"          @ ub.goods.gds-name
     1778                                   v-tot-sum-no-VAT @ v-sum-no-VAT
     1779                                   v-tot-VAT        @ v-VAT
     1780                                   v-tot-sum        @ v-sum
     1781       WITH FRAME r-factur-print-1.
     1782     END.
     1783     RUN print-footer IN THIS-PROCEDURE.
     1784     HIDE   STREAM PrnLibStream FRAME Bottomframe.
     1785     OUTPUT STREAM PrnLibStream CLOSE.
     1786   if mFrameView
     1787   then do:
     1788      HIDE FRAME InfoFrame.
     1789   end.
     1790     SESSION :SET-WAIT-STATE( "":U ).
     1791     RUN prn-lib-prn-file IN THIS-PROCEDURE ( INPUT parparentproc, INPUT SheetFormat( ) ).
     1792   END PROCEDURE.
     1793   PROCEDURE print-header-1 :
     1794         IF           p-title = "отчет"        THEN DO:
     1795     PUT STREAM PrnLibStream
     1796       SPACE( 25 ) STRING( "ОТЧЕТ ПО РЕАЛИЗАЦИИ "                        + t-num                                   ) FORMAT "x(100)":U SKIP( 1 ).
     1797         END. ELSE IF p-title = "счет-фактура" THEN DO:
     1798     PUT STREAM PrnLibStream
     1799       SPACE( 25 ) STRING( "СЧЕТ-ФАКТУРА "                               + CAPS( v-num )                           ) FORMAT "x(100)":U SKIP( 1 ).
     1800         END.
     1801     PUT STREAM PrnLibStream
     1802       SPACE(  5 ) STRING( "Продавец   "                                 + buf_suppl.obj-name                      ) FORMAT "x(100)":U SKIP
     1803       SPACE(  5 ) STRING( "Адрес   "                                    + t-a_adr                                 ) FORMAT "x(90)":U  SKIP
     1804       SPACE(  5 ) STRING( "ИНН/КПП продавца   "                         + t-a_INN                                 ) FORMAT "x(100)":U SKIP
     1805       SPACE(  5 ) STRING( "Грузоотправитель и его адрес   "             + TRIM( buf_suppl.obj-name )              ) FORMAT "x(100)":U SKIP
     1806       SPACE(  5 ) STRING( "Грузополучатель  и его адрес   " + TRIM( buf_owner.obj-name ) + ", " + t-m_adr         ) FORMAT "x(130)":U SKIP
     1807       SPACE(  5 ) STRING( "К платежно-расчетному документу  "           + p-pay-code                              ) FORMAT "x(100)":U SKIP( 1 )
     1808       SPACE(  5 ) STRING( "Покупатель   " + buf_owner.obj-name + "(" + STRING( buf_owner.obj-code ) + ")"         ) FORMAT "x(100)":U SKIP
     1809       SPACE(  5 ) STRING( "Адрес   "                                    + t-m_adr                                 ) FORMAT "x(90)":U  SKIP
     1810       SPACE(  5 ) STRING( "ИНН/КПП покупателя  "                        + t-m_INN                                 ) FORMAT "x(100)":U SKIP
     1811       SPACE(  5 ) "Дополнение (условия оплаты по договору (контракту), способ отправления и т.п.)"                  FORMAT "x(130)":U SKIP
     1812       SPACE(  5 ) STRING( FILL( "_", 130 ) )                                                                        FORMAT "x(130)":U SKIP
     1813       SPACE( 10 ) STRING( "Цены и суммы указаны в " + TRIM( ( IF PrintRubl THEN "рублях" ELSE base-type ) ) + "." ) FORMAT "x(120)":U SKIP( 1 ).
     1814   END PROCEDURE.
     1815   PROCEDURE print-header-2 :
     1816         IF           p-title = "отчет"        THEN DO:
     1817     PUT STREAM PrnLibStream
     1818       SPACE( 25 ) STRING( "ОТЧЕТ ПО ВОЗВРАТАМ ТОВАРА ОТ ПОКУПАТЕЛЯ "                 + t-num                      ) FORMAT "x(100)":U SKIP( 1 ).
     1819         END. ELSE IF p-title = "счет-фактура" THEN DO:
     1820     PUT STREAM PrnLibStream
     1821       SPACE( 25 ) STRING( "СЧЕТ-ФАКТУРА "                                            + CAPS( v-num )              ) FORMAT "x(100)":U SKIP( 1 ).
     1822         END.
     1823     PUT STREAM PrnLibStream
     1824       SPACE(  5 ) STRING( "Продавец   "                                              + buf_owner.obj-name         ) FORMAT "x(100)":U SKIP
     1825       SPACE(  5 ) STRING( "Адрес   "                                                 + t-m_adr                    ) FORMAT "x(90)":U  SKIP
     1826       SPACE(  5 ) STRING( "ИНН/КПП продавца  "                                       + t-m_INN                    ) FORMAT "x(100)":U SKIP
     1827       SPACE(  5 ) STRING( "Грузоотправитель и его адрес   "                          + TRIM( buf_owner.obj-name ) ) FORMAT "x(100)":U SKIP
     1828       SPACE(  5 ) STRING( "Грузополучатель  и его адрес   " + TRIM( buf_suppl.obj-name ) + ", " + t-a_adr         ) FORMAT "x(130)":U SKIP
     1829       SPACE(  5 ) STRING( "К платежно-расчетному документу  "                        + p-pay-code                 ) FORMAT "x(100)":U SKIP( 1 )
     1830       SPACE(  5 ) STRING( "Покупатель   " + buf_suppl.obj-name + "(" + STRING( buf_suppl.obj-code ) + ")"         ) FORMAT "x(100)":U SKIP
     1831       SPACE(  5 ) STRING( "Адрес   "                                                 + t-a_adr                    ) FORMAT "x(90)":U  SKIP
     1832       SPACE(  5 ) STRING( "ИНН/КПП покупателя  "                                     + t-a_INN                    ) FORMAT "x(100)":U SKIP
     1833       SPACE(  5 ) "Дополнение (условия оплаты по договору (контракту), способ отправления и т.п.)"                  FORMAT "x(130)":U SKIP
     1834       SPACE(  5 ) STRING( FILL( "_", 130 ) )                                                                        FORMAT "x(130)":U SKIP
     1835       SPACE( 10 ) STRING( "Цены и суммы указаны в " + TRIM( ( IF PrintRubl THEN "рублях" ELSE base-type ) ) + "." ) FORMAT "x(120)":U SKIP( 1 ).
     1836   END PROCEDURE.
     1837   PROCEDURE print-footer :
     1838     DOWN   STREAM PrnLibStream 2 WITH FRAME r-factur-print-1.
     1839     PUT    STREAM PrnLibStream                                 SKIP( 1 )
     1840       SPACE( 5 ) ( IF v-tot-sum + v-tot-SLT <> 0 THEN "Всего к оплате: " +
     1841                  STRING( TRIM( STRING( ABS( v-tot-sum + v-tot-SLT ), "->,>>>,>>>,>>>,>>>,>>9.99":U ) ) +
     1842                  " (" + TRIM( ( IF PrintRubl THEN "РУБ" ELSE base-type ) ) + ")" ) ELSE "":U )  FORMAT "x(150)":U SKIP
     1843       SPACE( 5 ) ( IF v-tot-tax <> 0 THEN "В том числе " + v-tax-name + " : " +
     1844                         TRIM( STRING( ABS( v-tot-tax ),              "->,>>>,>>>,>>>,>>>,>>9.99":U ) ) +
     1845                  " (" + TRIM( ( IF PrintRubl THEN "РУБ" ELSE base-type ) ) + ")" ELSE "":U )    FORMAT "x(150)":U SKIP( 1 )
     1846                  "Руководитель предприятия  ____________________    ____________________" FORMAT "x(70)":U
     1847       SPACE( 5 )        "Главный бухгалтер  ____________________    ____________________" FORMAT "x(63)":U SKIP
     1848                  "                            (подпись)               (ф. и. о.) "
     1849       SPACE( 5 ) "                            (подпись)               (ф. и. о.)"                          SKIP.
     1850   END PROCEDURE.
     1851   PROCEDURE print-line :
     1852     DEFINE VARIABLE v-start-string AS CHARACTER NO-UNDO.
     1853     DEFINE VARIABLE v-add-string   AS CHARACTER NO-UNDO.
     1854     DO ON ERROR UNDO, RETURN ERROR :
     1855       FIND FIRST ub.goods NO-LOCK WHERE
     1856                  ub.goods.prod-type = tt-line.prod-type AND
     1857                  ub.goods.prod-code = tt-line.prod-code AND
     1858                  ub.goods.artic     = tt-line.artic.
     1859       ASSIGN gds-str   = "":U
     1860              gds-str1  = "":U
     1861              gds-str2  = "":U.
     1862       FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     1863       IF ub.units.type = 'дро':U + "," + '2ед':U OR ub.units.type = 'дро':U + "," + 'доп':U THEN DO:
     1864         ASSIGN str = STRING( ub.goods.artic, "x(16)":U ) + " ":U + STRING( ub.goods.Sort, "x(5)":U ) + " ":U +
     1865                      TRIM(   ub.goods.gds-name ) + " ":U + TRIM( ub.goods.PS ).
     1866       END.                                                                                                    ELSE DO:
     1867         ASSIGN str = STRING( ub.goods.artic, "x(16)":U ) + " ":U + TRIM(   ub.goods.gds-name ).
     1868       END.
     1869       ASSIGN   gds-str1 = breakstr( str,     59, INPUT-OUTPUT gds-str1, INPUT-OUTPUT gds-str2 ).
     1870       DO WHILE TRIM( gds-str2 ) <> "":U :
     1871         ASSIGN gds-str  = gds-str2
     1872                gds-str1 = breakstr( gds-str, 59, INPUT-OUTPUT gds-str1, INPUT-OUTPUT gds-str2 ).
     1873       END.
     1874       ASSIGN   gds-str1 = breakstr( str,     59, INPUT-OUTPUT gds-str1, INPUT-OUTPUT gds-str2 ).
     1875       DISPLAY STREAM PrnLibStream sym1  gds-str1                    @ ub.goods.gds-name
     1876                                   sym2  ub.goods.unit-base
     1877                                   sym3  ABS( tt-line.gds-qty      ) @ v-qnty
     1878                                   sym4  ABS( tt-line.price-no-VAT ) @ v-price-no-VAT
     1879                                   sym5  ABS( tt-line.sum-no-VAT   ) @ v-sum-no-VAT
     1880                                   sym6  "   ---" FORMAT "x(6)":U    @ v-sum-excise
     1881                                   sym7  ABS( tt-line.VAT-pc       ) @ ub.doc-line.VAT-pc
     1882                                   sym8  ABS( tt-line.VAT          ) @ v-VAT
     1883                                   sym9  ABS( tt-line.sum          ) @ v-sum
     1884                                   sym10 tt-line.country             @ v-country
     1885                                   sym11 tt-line.GTD                 @ v-GTD              sym12
     1886       WITH FRAME r-factur-print-1.
     1887       DOWN STREAM PrnLibStream 1 WITH FRAME r-factur-print-1.
     1888       ASSIGN v-start-string = gds-str2.
     1889       DO WHILE TRIM( v-start-string ) <> "":U :
     1890         ASSIGN gds-str = v-start-string.
     1891         ASSIGN v-add-string = breakstr( gds-str, 59, INPUT-OUTPUT v-add-string, INPUT-OUTPUT v-start-string ).
     1892         DISPLAY STREAM PrnLibStream sym1 FILL( " ":U, 17 ) + v-add-string @ ub.goods.gds-name sym2
     1893                                     sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1894         WITH FRAME r-factur-print-1.
     1895         DOWN STREAM PrnLibStream 1 WITH FRAME r-factur-print-1.
     1896       END.
     1897       ASSIGN v-lines-counter = v-lines-counter + 1.
     1898   IF ( v-lines-counter modulo v-account = 0 )  then DO:
     1899    Assign
     1900       v-kol-spice = (50 - LENGTH(ReportName)) / 2
     1901       RecordsString = fill(' ',v-kol-spice) + string(ReportName)
     1902       .
     1903             if  log-manager:logfile-name ne ?
     1904             then DO:
     1905                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1906             end.
     1907              if mFrameView
     1908              then do:
     1909               DISPLAY
     1910                 v-lines-counter @ RecordsDone
     1911                 RecordsString   @ RecordsString
     1912                 WITH FRAME InfoFrame.
     1913              end.
     1914   End.
     1915      if v-button-stop then  DO:
     1916            if mFrameView
     1917            then
     1918               PROCESS EVENTS.
     1919            IF StopProcessing THEN DO:
     1920            RETURN error.
     1921            End.
     1922      end.
     1923     END.
     1924   END PROCEDURE.
