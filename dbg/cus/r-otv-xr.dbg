      692   define  stream PrnLibStream.
      693   procedure prn-lib-prn-file :
      694     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      695     define input parameter p-DIsabledoptions as integer no-undo .
      696     define variable v-report-name as character no-undo .
      697     define variable v-user-action as character no-undo .
      698     define variable v-printed     as logical   no-undo .
      699     define variable v-exist       as logical   no-undo .
      700     do
      701       on error undo, return error
      702       :
      703       run prn-lib-get-report-name  in this-procedure (
      704         input parParentProc
      705         ,output v-report-name
      706         ).
      707   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      709     (input  v-report-name
      710     ,input  2
      711     ,output v-exist
      712     )  .
      713       if NOT v-exist then
      714       DO:
      715         Message
      716           "Нет заданий на печать ! "
      717           view-as alert-box .
      718         Return  .
      719       End.
      720       run gbl/prnfilen.w
      721         (input  ""
      722         ,input  p-DisabledOptions
      723         ,input  string(v-report-name )
      724         ,input  7
      725         ,output v-user-action
      726         ,output v-printed
      727         ) .
      728       if v-printed then
      729       do:
      730         return "YES" .
      731       end.
      732       else
      733       do:
      734         return "NO" .
      735       end.
      736     end.
      737   end procedure.
      738   procedure prn-lib-open-stream :
      739     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      740     define input parameter p-page-size    as integer no-undo .
      741     define input parameter p-is-stream    as logical no-undo .
      742     define input parameter p-append       as logical no-undo .
      743     define variable v-report-name as character no-undo .
      744     do
      745       on error undo, return error
      746       :
      747       run prn-lib-get-report-name  in this-procedure (
      748         input parParentProc
      749         ,output v-report-name
      750         ).
      751       if p-is-stream then
      752       do:
      753         if p-append then
      754         do:
      755           output stream PrnLibStream to value( v-report-name )
      756             page-size value(p-page-size) append .
      757         end.
      758         if not p-append then
      759         do:
      760           output stream PrnLibStream to value( v-report-name )
      761             page-size value(p-page-size) .
      762         end.
      763       end.
      764       if not p-is-stream then
      765       do:
      766         if p-append then
      767         do:
      768           output to value( v-report-name )
      769             page-size value(p-page-size) append .
      770         end.
      771         if not p-append then
      772         do:
      773           output to value( v-report-name )
      774             page-size value(p-page-size) .
      775         end.
      776       end.
      777     end.
      778   end procedure.
      779   procedure prn-lib-open-exp :
      780     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      781     define input parameter p-is-stream    as logical no-undo .
      782     define input parameter p-is-append    as logical no-undo .
      783     define output parameter p-ReportFileName as char init "report" no-undo.
      784     define output parameter p-process as logical no-undo .
      785     define variable glog as logical no-undo .
      786     do
      787       on error undo, return error
      788       :
      789       SYSTEM-DIALOG GET-FILE p-ReportFileName
      790         TITLE      "Укажите путь"
      791         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      792         ASK-OVERWRITE
      793         CREATE-TEST-FILE
      794         SAVE-AS
      795         USE-FILENAME
      796         DEFAULT-EXTENSION "txt"
      797         UPDATE glog
      798         .
      799       if not glog then  return.
      800       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      801       if p-is-stream then
      802       do:
      803         if p-is-append then
      804         do:
      805           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      806         end.
      807         else
      808         do:
      809           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      810         end.
      811       end.
      812       else
      813       do:
      814         if p-is-append then
      815         do:
      816           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      817         end.
      818         else
      819         do:
      820           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      821         end.
      822       end.
      823       p-process = yes.
      824     end.
      825   end procedure.
      826   procedure prn-lib-get-report-name :
      827     define input parameter parParentProc  as widget-handle no-undo.
      828     define output parameter p-report-name as character no-undo .
      829     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      830   end procedure.
      831   procedure prn-lib-reportviewer-report-name :
      832     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      833     define input parameter p-report-name-html as character no-undo .
      834     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      835   end procedure.
      836   procedure prn-lib-reportviewer :
      837     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      838     define input parameter p-report-name-html as character no-undo .
      839     define input parameter p-param        as character no-undo .
      840     define variable v-excel           as character no-undo init 'TRUE' .
      841     define variable v-value-character as character no-undo .
      842     define variable v-value-integer   as character no-undo .
      843     define variable v-value-date      as date      no-undo .
      844     define variable v-value-decimal   as decimal   no-undo .
      845     define variable rep-excel         as logical   no-undo .
      846     define variable excel-string      as character no-undo .
      847     define variable v-param-type      as character no-undo .
      848     define variable v-tth             as handle    no-undo .
      849     run adm/shattri.p (
      850       input "get":U
      851       ,input  ""
      852       ,input  0
      853       ,input  'report-glob':U
      854       ,input  'rep-excel':U
      855       ,output v-value-character
      856       ,output v-value-date
      857       ,output v-value-decimal
      858       ,output v-value-integer
      859       ,output rep-excel
      860       ,output v-param-type
      861       ,INPUT-OUTPUT table-handle v-tth
      862       )  .
      863     if rep-excel then v-excel = "TRUE" .
      864     else v-excel = "FALSE" .
      865     if p-param eq ""
      866     then
      867        p-param = "EXCEL:" + v-excel.
      868     else
      869        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      870     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      871   end procedure.
      872   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   function breakstr returns character ( input        for-name    as character,
      874                                         input        line-length as integer,
      875                                         input-output line1       as character,
      876                                         input-output line2       as character ) :
      877     define variable ii as integer no-undo.
      878     if length( for-name ) > line-length then do:
      879       assign ii    = 1
      880              line1 = "":u
      881              line2 = "":u.
      882       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      883         assign line1 =       substring( for-name, 1, line-length     )
      884                line2 = trim( substring( for-name,    line-length + 1 ) ).
      885       end.                                                     else do:
      886         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      887           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      888                  ii    = ii    + 1.
      889           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      890             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      891           end.
      892         end.
      893         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      894       end.
      895     end.                                else do:
      896       assign line1 = for-name
      897              line2 = "":u.
      898     end.
      899     return ( line1 ).
      900   end function.
