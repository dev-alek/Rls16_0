     1065   define variable v-account as integer init 0 no-undo .
     1066   define variable v-account-lavel as character no-undo .
     1067   define variable v-button-stop as logical no-undo .
     1068   define variable v-kol-spice as integer no-undo .
     1069   define variable v-kol-spice2 as integer no-undo .
     1070   define variable v-kol-spice3 as integer no-undo .
     1071   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1072   DEFINE BUTTON StopBtn AUTO-END-KEY
     1073        LABEL "Стоп"
     1074        SIZE 10 BY 1.
     1075   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1076        LABEL "Обработано записей"
     1077         VIEW-AS TEXT
     1078        SIZE 14 BY .67 NO-UNDO.
     1079   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1080         VIEW-AS TEXT
     1081        SIZE 53.25 BY .67
     1082        FGCOLOR 1  NO-UNDO.
     1083   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1084         VIEW-AS TEXT
     1085        SIZE 53.25 BY .67
     1086        FGCOLOR 1  NO-UNDO.
     1087   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1088         VIEW-AS TEXT
     1089        SIZE 53.25 BY .67
     1090        FGCOLOR 1  NO-UNDO.
     1091   DEFINE RECTANGLE RECT-1
     1092        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1093        SIZE 55.13 BY 4.46.
     1094   DEFINE FRAME InfoFrame
     1095        StopBtn AT ROW 4.25 COL 21.75
     1096        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1097        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1098        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1099        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1100        RECT-1 AT ROW 1 COL 1
     1101       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1102            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1103            TITLE "Процесс"
     1104            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1105   define variable mFrameView      as logical   no-undo init yes.
     1106     define variable mFramHandle as handle no-undo.
     1107     mFramHandle = frame InfoFrame:handle.
     1108     if  log-manager:logfile-name ne ?
     1109     then DO:
     1110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1112         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1113     end.
     1114     mFrameView = not session:batch-mode and mFramHandle:visible.
     1115     if mFrameView
     1116     then do:
     1117       ASSIGN
     1118          FRAME InfoFrame:HIDDEN                           = TRUE
     1119          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1120     end.
     1121   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1122   DO:
     1123     IF not StopProcessing THEN
     1124       Message "Вы действительно хотите прервать" SKIP
     1125               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1126                 UPDATE StopProcessing.
     1127     IF StopProcessing THEN do:
     1128        if mFrameView
     1129        then do:
     1130           HIDE FRAME InfoFrame.
     1131        end.
     1132     End.
     1133   END.
     1134   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     1135     if  log-manager:logfile-name ne ?
     1136     then DO:
     1137         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1138     end.
     1139     if not session:batch-mode then
     1140     do:
     1141       VIEW FRAME InfoFrame.
     1142       mFrameView = true.
     1143     end.
     1144      v-button-stop = false .
     1145         if mFrameView
     1146         then do:
     1147         if v-button-stop then view STOPBTN in frame InfoFrame.
     1148                          else Hide STOPBTN in frame InfoFrame.
     1149         end.
     1150   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
