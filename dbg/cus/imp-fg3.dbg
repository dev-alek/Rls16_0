        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input  parameter file-name as char no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: imp-fg3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/imp-fg3.p $":U .
        9   define variable vss-description as character no-undo init "Импорт в ДНЦ  ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define buffer buf_goods for ub.goods .
       80   define stream imp.
       81   define stream err.
       82   define variable text-string        as    char no-undo .
       83   define variable i-doc-num       like   price-doc-forming.pdf-id no-undo .
       84   DEF VAR loc-ref-list      as    char no-undo .
       85   define variable i-price         like doc-line.price-cli     no-undo.
       86   define variable i-d-pcnt        like price-doc-forming-gds.d-pcnt      no-undo.
       87   DEF var impc as integer No-UNDO.
       88   DEF var imp-save as integer No-UNDO.
       89   DEF var i-artic as char no-undo.
       90   DEF var i-prod-code like goods.prod-code no-undo.
       91   DEFINE VAR  N-param AS DEC NO-UNDO.
       92   DEF VAR i-t1 AS CHAR NO-UNDO.
       93   DEF VAR i-t2 AS CHAR NO-UNDO.
       94   DEF VAR i-t3 AS CHAR NO-UNDO.
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96     run mainmenu_getcntxt in parparentproc
       97       (output v-cntxt-db-num
       98       ,output v-cntxt-userid
       99       ,output v-cntxt-level
      100       ,output v-cntxt-host-code-obj
      101       ,output v-cntxt-obj-type
      102       ,output v-cntxt-obj-code
      103       ,output v-cntxt-db-num-obj
      104       ,output v-cntxt-is-admin
      105       ) .
      106   run str/pdfnew.w ( input parParentProc
      107                     , 'all'
      108                      , v-cntxt-obj-type
      109                      , v-cntxt-obj-code
      110                      ,  ?
      111                      ,?
      112                      ,"b-sel":U
      113                      ,input-output loc-ref-list).
      114   if loc-ref-list  = '':U
      115   or loc-ref-list  = ?
      116   then do:
      117     message "Документ назначения цены не выбран."
      118             view-as alert-box error.
      119     return error.
      120   end.
      121   find price-doc-forming where recid (price-doc-forming) = integer(entry(1, loc-ref-list)) no-error .
      122   if not available price-doc-forming then do:
      123     message
      124     substitute("ДНЦ с recid &1 не найден", integer(entry(1, loc-ref-list)))
      125     view-as alert-box .
      126     return .
      127   end.
      128   if price-doc-forming.stts <> 0 then do:
      129         message "Статус ДНЦ должен быть 'новый'."
      130                 view-as alert-box error.
      131         return error.
      132   end.
      133   i-doc-num = price-doc-forming.pdf-id.
      134   input stream imp from value (file-name) .
      135   repeat:
      136         text-string = "".
      137         IMPORT stream imp UNFORMATTED text-string NO-ERROR.
      138         if trim(text-string) = "" then leave.
      139         impc = impc + 1.
      140         if num-entries (text-string, ";") <> 24 then do:
      141           N-param = num-entries (text-string, ";").
      142           OUTPUT stream Err TO value ("Imp_Price.err") append.
      143              put stream Err unformatted
      144                string(today, "99/99/9999") " "
      145                string(time, "HH:MM")
      146                " Неправильное число параметров в строке, должно быть 22, а у вас " N-param skip.
      147              export stream  Err text-string .
      148           output stream Err close.
      149           next.
      150         end.
      151         IF trim(ENTRY( 9, text-string, ";")) = "Article name" THEN NEXT.
      152         assign
      153               i-artic = trim(ENTRY( 9, text-string, ";") + "-" + ENTRY( 10, text-string, ";"))
      154               i-prod-code = dec(ENTRY( 22, text-string, ";")).
      155         i-t1 = ENTRY( 20, text-string, ";").
      156         REPEAT:
      157            IF INDEX(i-t1, " ") = 0 THEN LEAVE.
      158            i-t2 = SUBSTRING ( i-t1, 1 , INDEX(i-t1, " ") - 1).
      159            i-t3 = SUBSTRING ( i-t1, INDEX(i-t1, " ") + 1).
      160            i-t1 = i-t2 + i-t3.
      161         END.
      162         IF INDEX(i-t1, ",") <> 0 THEN DO:
      163           ASSIGN
      164             i-t2 = SUBSTRING ( i-t1, 1 , INDEX(i-t1, ",") - 1).
      165             i-t3 = SUBSTRING ( i-t1, INDEX(i-t1, ",") + 1).
      166             i-t1 = i-t2 + "." + i-t3.
      167         END.
      168         ASSIGN i-price = dec(i-t1).
      169         display
      170                    impc  label "Прочитано"
      171                    imp-save label "Сохранено"
      172                    i-artic format "x(10)" label "Артикул"
      173                    text-string format "x(40)" label "Строка файла"
      174            with frame ff view-as dialog-box
      175         title ": Импорт справочника товаров из файла".
      176         pause 0.
      177         find first goods where
      178           goods.prod-type = "орг" and
      179           goods.prod-code = i-prod-code and
      180           goods.artic = i-artic
      181         no-lock no-error.
      182         if not avail goods then do:
      183              OUTPUT stream Err TO value ("Imp_Price.err") append.
      184                 put stream Err unformatted
      185                   string(today, "99/99/9999") " "
      186                   string(time, "HH:MM")
      187                   " Товар не найден в справочнике товаров, см. строку " impc skip.
      188                 export stream  Err text-string .
      189              output stream Err close.
      190              next.
      191         end.
      192         find first bar-code where bar-code.gds-code = goods.gds-code no-lock no-error.
      193         if not avail bar-code then do:
      194              OUTPUT stream Err TO value ("Imp_Price.err") append.
      195                 put stream Err unformatted
      196                   string(today, "99/99/9999") " "
      197                   string(time, "HH:MM")
      198                   " У товара нет собственного Бар-Кода, см. строку " impc skip.
      199                 export stream  Err text-string .
      200              output stream Err close.
      201              next.
      202         end.
      203         if i-price <= 0 or i-price = ? then do:
      204              OUTPUT stream Err TO value ("Imp_Price.err") append.
      205                 put stream Err unformatted
      206                   string(today, "99/99/9999") " "
      207                   string(time, "HH:MM")
      208                   " У товара нет цены, см. строку " impc skip.
      209                 export stream  Err text-string .
      210              output stream Err close.
      211              next.
      212         end.
      213         find price-doc-forming-gds where
      214             price-doc-forming-gds.pdf-id    = i-doc-num         and
      215             price-doc-forming-gds.b-code     = bar-code.b-code no-error.
      216         if available price-doc-forming-gds then do:
      217                 next.
      218         end.
      219         else do:
      220           create price-doc-forming-gds.
      221           assign
      222             price-doc-forming-gds.pdf-id     = i-doc-num
      223             price-doc-forming-gds.b-code      = bar-code.b-code
      224             price-doc-forming-gds.artic       = goods.artic
      225             price-doc-forming-gds.prod-type   = goods.prod-type
      226             price-doc-forming-gds.prod-code   = goods.prod-code
      227             price-doc-forming-gds.calc-method = 'Отсутствует':U
      228             imp-save               = imp-save + 1
      229   price-doc-forming-gds.plt-db-num   =    price-doc-forming.plt-db-num
      230   price-doc-forming-gds.plt-id    =     price-doc-forming.plt-id
      231           .
      232         end.
      233         assign
      234           price-doc-forming-gds.price-sale-doc = i-price
      235           price-doc-forming-gds.price-sale-rubl = i-price
      236           price-doc-forming-gds.price-sale-base = i-price
      237           price-doc-forming-gds.d-pcnt     = i-d-pcnt
      238         .
      239   end.
      240   input stream imp close.
      241   message ("Импорт из файла " + file-name + " закончен, прочитано " + string(impc) +
      242            ",  создано строк в ДНЦ " + string(imp-save) ) skip
      243            "Все строки из файла которые не удалось импортировать можно посмотреть в файле Imp_Price.err "
      244   view-as alert-box  INFORMATION.
