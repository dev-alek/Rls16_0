        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle    no-undo .
        3   define input parameter p-doc-code    as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: orcmtrn.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/orcmtrn.p $":U .
        9   define variable vss-description as character no-undo init "Создание накладной по заказу ОРЦ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     define variable v-cntxt-db-num        as integer   no-undo .
       81     define variable v-cntxt-userid        as character no-undo .
       82     define variable v-cntxt-level         as character no-undo .
       83     define variable v-cntxt-host-code-obj as integer   no-undo .
       84     define variable v-cntxt-obj-type      as character no-undo .
       85     define variable v-cntxt-obj-code      as integer   no-undo .
       86     define variable v-cntxt-db-num-obj    as integer   no-undo .
       87     define variable v-cntxt-is-admin      as logical   no-undo .
       88   define buffer buf-OR_ord-doc for ub.ord-doc  .
       89   find first buf-OR_ord-doc exclusive-lock where
       90              buf-OR_ord-doc.doc-code = p-doc-code no-error .
       91   if not available buf-OR_ord-doc then do:
       92      return error return-value .
       93   end.
       94   define variable v-ok  as logical   no-undo .
       95   define buffer buf_clients for ub.clients.
       96   define buffer obj_clients for ub.clients.
       97   if buf-OR_ord-doc.status_ <> 'запрос':U then  do:
       98      return error "Создание накладной возможно статусе " + 'запрос':U .
       99   end.
      100   define variable v-obj-type as character no-undo .
      101   define variable v-obj-code as integer   no-undo .
      102   define variable v-host-code as integer   no-undo .
      103   find first buf_clients no-lock where
      104              buf_clients.obj-code = buf-OR_ord-doc.cli-code and
      105              buf_clients.obj-type = buf-OR_ord-doc.cli-type
      106              no-error .
      107   find first obj_clients no-lock where
      108              obj_clients.obj-code = buf-OR_ord-doc.obj-code and
      109              obj_clients.obj-type = buf-OR_ord-doc.obj-type
      110              no-error .
      111    v-obj-type  = buf-OR_ord-doc.cli-type .
      112    v-obj-code  = buf-OR_ord-doc.cli-code .
      113    v-host-code = buf_clients.host-code .
      114   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115     run mainmenu_getcntxt in parparentproc
      116       (output v-cntxt-db-num
      117       ,output v-cntxt-userid
      118       ,output v-cntxt-level
      119       ,output v-cntxt-host-code-obj
      120       ,output v-cntxt-obj-type
      121       ,output v-cntxt-obj-code
      122       ,output v-cntxt-db-num-obj
      123       ,output v-cntxt-is-admin
      124       ) .
      125   if obj_clients.host-code <> buf_clients.host-code then do:
      126       run cus/crhldr.p
      127         ( input parparentproc
      128         , input buf-OR_ord-doc.doc-code
      129         ) no-error .
      130         if error-status :error then return error substitute("Ошибка при создании МФ накладной &1" , return-value , error-status :get-message(1) ) .
      131   end.
      132   else do:
      133       run cus/crrasper.p
      134         ( input parparentproc
      135         , input buf-OR_ord-doc.doc-code
      136         ) no-error .
      137         if error-status :error then return error substitute("Ошибка при создании внутренней накладной &1" , return-value , error-status :get-message(1) ) .
      138   end.
