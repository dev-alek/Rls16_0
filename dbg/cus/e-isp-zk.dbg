      672        LABEL "Итоги по заказам"
      673        VIEW-AS TOGGLE-BOX
      674        SIZE 25.25 BY .83 TOOLTIP "Раздельно по заказам" NO-UNDO.
      675   DEFINE VARIABLE v-ext-art AS LOGICAL INITIAL no
      676        LABEL "Артикул Поставщика"
      677        VIEW-AS TOGGLE-BOX
      678        SIZE 21.5 BY .83 TOOLTIP "печатать Артикул ПОСТАВЩИКА или ПРОИЗВОДИТЕЛЯ" NO-UNDO.
      679   DEFINE FRAME F-Main
      680        RAD-otkl AT ROW 2.08 COL 32.38 NO-LABEL
      681        RAD-Post AT ROW 2.25 COL 1.88 NO-LABEL
      682        Ed-otkl-prc AT ROW 3.79 COL 58.5 COLON-ALIGNED NO-LABEL
      683        Ed-otkl-prc-2 AT ROW 5.33 COL 58.5 COLON-ALIGNED NO-LABEL
      684        r-status_ AT ROW 5.67 COL 2 NO-LABEL WIDGET-ID 2
      685        Ed-otkl-tmh AT ROW 6.96 COL 57.5 COLON-ALIGNED NO-LABEL
      686        Ed-otkl-tmm AT ROW 6.96 COL 63.38 COLON-ALIGNED NO-LABEL
      687        RAD-Post-2 AT ROW 10.33 COL 1.88 NO-LABEL
      688        v-ext-art AT ROW 13.58 COL 2.5 WIDGET-ID 10
      689        tg-zay AT ROW 14.67 COL 2.5
      690        "Выбор заказов по статусам:" VIEW-AS TEXT
      691             SIZE 27.5 BY .67 AT ROW 4.75 COL 2.38 WIDGET-ID 8
      692             FGCOLOR 4
      693        ":" VIEW-AS TEXT
      694             SIZE .75 BY .96 TOOLTIP ":" AT ROW 6.96 COL 64.5
      695        "Выбор заказов по ПОСТАВЩИКАМ:" VIEW-AS TEXT
      696             SIZE 27 BY .67 AT ROW 1.33 COL 2
      697             FGCOLOR 4
      698        "Сравнение:" VIEW-AS TEXT
      699             SIZE 19.38 BY .67 AT ROW 9.42 COL 7.13
      700             FGCOLOR 4
      701        "Выбор товаров:" VIEW-AS TEXT
      702             SIZE 19.38 BY .67 AT ROW 1.25 COL 37.75
      703             FGCOLOR 4
      704        RECT-7 AT ROW 1.08 COL 1.75
      705        RECT-9 AT ROW 9.17 COL 1.75
      706        RECT-8 AT ROW 13 COL 1.75
      707        RECT-5 AT ROW 1 COL 31
      708       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      709            SIDE-LABELS NO-UNDERLINE THREE-D
      710            AT COL 1 ROW 1 SCROLLABLE .
      711   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      712   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      713   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      714   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      715   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      716   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      717   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      718   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      719         adm-object-hdl = FRAME F-Main:HANDLE.
      720   RUN ensure-broker.
      721   THIS-PROCEDURE:ADM-DATA =
      722        'ADM1.1~`':U +
      723        'SmartObject~`':U +
      724        '~`':U +
      725        'NO ~`':U +
      726        '~`':U +
      727        '~`':U +
      728        '~`':U +
      729        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      730           + "~`":U +
      731        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      732        'Record-Source,Record-Target,TableIO-Target~`':U +
      733        '~`':U +
      734        '~`~`~`~`~`~`~`~`~`~`~`':U +
      735        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      736            THEN "^^":U
      737        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      738             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      739   PROCEDURE adm-apply-entry :
      740     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      741   END PROCEDURE.
      742   PROCEDURE adm-destroy :
      743    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      744   END PROCEDURE.
      745   PROCEDURE adm-disable :
      746       DISABLE RECT-7 RECT-9 RECT-8 RECT-5 RAD-otkl RAD-Post Ed-otkl-prc Ed-otkl-prc-2 r-status_ Ed-otkl-tmh Ed-otkl-tmm RAD-Post-2 v-ext-art tg-zay WITH FRAME F-Main.
      747       RUN dispatch ('disable-fields':U).
      748       RUN set-attribute-list ('ENABLED=no':U).
      749       RETURN.
      750   END PROCEDURE.
      751   PROCEDURE adm-edit-attribute-list :
      752         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      753         RETURN.
      754   END PROCEDURE.
      755   PROCEDURE adm-enable :
      756       ENABLE UNLESS-HIDDEN RECT-7 RECT-9 RECT-8 RECT-5 RAD-otkl RAD-Post Ed-otkl-prc Ed-otkl-prc-2 r-status_ Ed-otkl-tmh Ed-otkl-tmm RAD-Post-2 v-ext-art tg-zay WITH FRAME F-Main.
      757       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      758       RUN set-attribute-list ('ENABLED=yes':U).
      759       RETURN.
      760   END PROCEDURE.
      761   PROCEDURE adm-exit :
      762        RUN notify ('exit':U).
      763     RETURN.
      764   END PROCEDURE.
      765   PROCEDURE adm-hide :
      766     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      767   END PROCEDURE.
      768   PROCEDURE adm-initialize :
      769     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      770   END PROCEDURE.
      771   PROCEDURE adm-show-errors :
      772       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      773       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      774           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      775       END.
      776       RETURN.
      777   END PROCEDURE.
      778   PROCEDURE adm-UIB-mode :
      779     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      780   END PROCEDURE.
      781   PROCEDURE adm-view :
      782     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      783   END PROCEDURE.
      784   PROCEDURE dispatch :
      785       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      786       RUN broker-dispatch IN adm-broker-hdl
      787           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      788       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      789   END PROCEDURE.
      790   PROCEDURE ensure-broker :
      791   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      792   IF RETURN-VALUE NE "ADM-Broker":U THEN
      793   DO:
      794       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      795       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      796   END.
      797   END PROCEDURE.
      798   PROCEDURE get-attribute :
      799     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      800     RUN broker-get-attribute IN adm-broker-hdl
      801         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      802     RETURN RETURN-VALUE.
      803   END PROCEDURE.
      804   PROCEDURE get-attribute-list :
      805     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      806     RUN broker-get-attribute-list IN adm-broker-hdl
      807         (INPUT THIS-PROCEDURE,
      808          INPUT ?,
      809          OUTPUT p-attr-list) NO-ERROR.
      810     RETURN.
      811   END PROCEDURE.
      812   PROCEDURE new-state :
      813     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      814     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      815     RETURN.
      816   END PROCEDURE.
      817   PROCEDURE notify :
      818     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      819     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      820     IF RETURN-VALUE = "ADM-ERROR":U THEN
      821         RETURN "ADM-ERROR":U.
      822     RETURN.
      823   END PROCEDURE.
      824   PROCEDURE set-attribute-list :
      825     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      826     RUN ensure-broker.
      827     RUN broker-set-attribute-list IN adm-broker-hdl
      828         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      829     RETURN.
      830   END PROCEDURE.
      831   PROCEDURE set-position :
      832       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      833       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      834       IF VALID-HANDLE(adm-object-hdl) THEN
      835       DO:
      836         ASSIGN adm-object-hdl:ROW    =   p-row
      837                adm-object-hdl:COLUMN =   p-col.
      838       END.
      839       RETURN.
      840   END PROCEDURE.
      841   PROCEDURE adm-display-fields :
      842       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      843       RETURN.
      844   END PROCEDURE.
      845   PROCEDURE adm-open-query :
      846     RETURN.
      847   END PROCEDURE.
      848   PROCEDURE adm-row-changed :
      849         IF VALID-HANDLE(adm-object-hdl) THEN
      850           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      851         RUN notify ('row-available':U).
      852         RETURN.
      853   END PROCEDURE.
      854   PROCEDURE reposition-query :
      855       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      856       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      857       RETURN.
      858   END PROCEDURE.
      859     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      860     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      861     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      862     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      863     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      864     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      865     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      866     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      867     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      868     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      869     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      870     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      871     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      872     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      873     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      874     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      875     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      876     IF "":U = "":U THEN
      877       RUN modify-list-attribute IN adm-broker-hdl
      878         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      879     RUN use-create-on-add(?).
      880   PROCEDURE adm-add-record :
      881       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      882          "must have at least one Enabled Table to perform Add.":U
      883          VIEW-AS ALERT-BOX ERROR.
      884       RETURN.
      885   END PROCEDURE.
      886   PROCEDURE adm-assign-record :
      887    MESSAGE
      888          "Object ":U THIS-PROCEDURE:FILE-NAME
      889            "must have at least one Enabled Table to perform Assign.":U
      890              VIEW-AS ALERT-BOX ERROR.
      891      RETURN.
      892     END PROCEDURE.
      893   PROCEDURE adm-assign-statement :
      894     RETURN.
      895   END PROCEDURE.
      896   PROCEDURE adm-cancel-record :
      897      RETURN.
      898     END PROCEDURE.
      899   PROCEDURE adm-copy-record :
      900       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      901        "must have at least one Enabled Table to perform Copy.":U
      902          VIEW-AS ALERT-BOX ERROR.
      903       RETURN.
      904   END PROCEDURE.
      905   PROCEDURE adm-create-record :
      906      RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-current-changed :
      909     RETURN.
      910   END PROCEDURE.
      911   PROCEDURE adm-delete-record :
      912    MESSAGE
      913          "Object ":U THIS-PROCEDURE:FILE-NAME
      914            "must have at least one Enabled Table to perform Delete.":U
      915              VIEW-AS ALERT-BOX ERROR.
      916       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      917       RETURN.
      918   END PROCEDURE.
      919   PROCEDURE adm-disable-fields :
      920         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      921       RETURN.
      922   END PROCEDURE.
      923   PROCEDURE adm-enable-fields :
      924       RETURN.
      925   END PROCEDURE.
      926   PROCEDURE adm-end-update :
      927     RETURN.
      928   END PROCEDURE.
      929   PROCEDURE adm-reset-record :
      930       RETURN.
      931   END PROCEDURE.
      932   PROCEDURE adm-update-record :
      933       MESSAGE
      934         "Object ":U THIS-PROCEDURE:FILE-NAME
      935           "must have at least one Enabled Table to perform Update.":U
      936             VIEW-AS ALERT-BOX ERROR.
      937      RETURN.
      938   END PROCEDURE.
      939   PROCEDURE check-modified :
      940   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      941   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      942   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      943   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      944     IF check-state = "check":U THEN
      945     DO:
      946       RUN get-link-handle IN adm-broker-hdl
      947         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      948            OUTPUT group-target-list).
      949       IF group-target-list NE "":U THEN
      950       DO i = 1 TO NUM-ENTRIES(group-target-list):
      951         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      952         RUN check-modified IN curr-widget ('group-check':U).
      953         IF RETURN-VALUE NE "":U THEN
      954         DO:
      955           RUN check-modified-message(RETURN-VALUE).
      956           RETURN "":U.
      957         END.
      958       END.
      959     END.
      960     RETURN "":U.
      961   END PROCEDURE.
      962   PROCEDURE check-modified-message :
      963     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      964        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      965           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      966        IF RETURN-VALUE = "YES":U THEN
      967           RUN notify ('view,CONTAINER-SOURCE':U).
      968        MESSAGE IF p-changed-table NE ? THEN
      969           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      970           ELSE "Current values have been changed."
      971           SKIP "  Do you wish to save those changes?"
      972           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      973        IF ANS THEN
      974        DO:
      975           IF group-assign-target THEN
      976             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      977           ELSE RUN dispatch('update-record':U).
      978           IF RETURN-VALUE = "ADM-ERROR":U THEN
      979           DO:
      980               MESSAGE "Changes to the previous record were not saved."
      981                 VIEW-AS ALERT-BOX ERROR.
      982               IF group-assign-target THEN
      983                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      984               ELSE RUN dispatch ('cancel-record':U).
      985           END.
      986        END.
      987        ELSE DO:
      988          IF group-assign-target THEN
      989             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      990          ELSE RUN dispatch('cancel-record':U).
      991        END.
      992        RETURN.
      993   END PROCEDURE.
      994   PROCEDURE get-rowid :
      995       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      996       ASSIGN
      997       p-table   =   adm-first-table.
      998       RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE init-group-assign :
     1001       RUN request-attribute IN adm-broker-hdl
     1002         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1003       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1004         group-assign-target = yes.
     1005       ELSE group-assign-target = no.
     1006       RETURN.
     1007   END PROCEDURE.
     1008   PROCEDURE set-editors :
     1009       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1010       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1011       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1012       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1013       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1014       DO WHILE VALID-HANDLE (curr-widget):
     1015           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1016              curr-widget:HIDDEN = no THEN DO:
     1017             CASE p-field-setting:
     1018               WHEN "INITIALIZE":U THEN
     1019               DO:
     1020                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1021                     read-only-list +
     1022                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1023                        STRING(curr-widget).
     1024               END.
     1025               WHEN "DISABLE":U OR
     1026               WHEN "ENABLE":U THEN
     1027               DO:
     1028                   curr-widget:SENSITIVE = yes.
     1029                   RUN get-attribute ('Read-Only-Editors':U).
     1030                   IF RETURN-VALUE = ? OR
     1031                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1032                       curr-widget:READ-ONLY =
     1033                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1034               END.
     1035               WHEN "CLEAR":U THEN
     1036                   curr-widget:SCREEN-VALUE = "":U.
     1037             END CASE.
     1038           END.
     1039           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1040       END.
     1041       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1042         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1043           + '"':U).
     1044       RETURN.
     1045   END PROCEDURE.
     1046   PROCEDURE use-check-modified-all :
     1047    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1048     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1049     RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE use-create-on-add :
     1052   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1053      RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE use-initial-lock :
     1056     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1057     ASSIGN adm-initial-lock = p-attr-value.
     1058     RETURN.
     1059   END PROCEDURE.
     1060     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1061   ASSIGN
     1062          FRAME F-Main:SCROLLABLE       = FALSE
     1063          FRAME F-Main:HIDDEN           = TRUE.
     1064   ON VALUE-CHANGED OF r-status_ IN FRAME F-Main
     1065   DO:
     1066     Assign RAD-Post.
     1067     Case RAD-Post :
     1068       when 2 then
     1069       do:
     1070           run ref/cli-all.w (input my-handle
     1071                        ,input  "b-sel,b-mark"
     1072                        ,input  'про':U
     1073                        ,input  'все':U
     1074                        ,input  'текущие':U
     1075                        ,input  ?
     1076                        ,input  ",,,,,,NO,,"
     1077                        ,input  ?
     1078                        ,output cli-lst ) .
     1079           if cli-lst = "" then do:
     1080             Assign  RAD-Post = 1.
     1081             Display RAD-Post with frame F-Main .
     1082           end.
     1083       end.
     1084     End case.
     1085   END.
     1086   ON VALUE-CHANGED OF RAD-otkl IN FRAME F-Main
     1087   DO:
     1088    assign RAD-otkl.
     1089    assign Ed-otkl-prc.
     1090    assign Ed-otkl-tmh.
     1091    assign Ed-otkl-tmm.
     1092    assign
     1093      r-status_
     1094    .
     1095   END.
     1096   ON VALUE-CHANGED OF RAD-Post IN FRAME F-Main
     1097   DO:
     1098     Assign RAD-Post.
     1099     Case RAD-Post :
     1100       when 2 then
     1101       do:
     1102           run ref/cli-all.w (input my-handle
     1103                        ,input  "b-sel,b-mark"
     1104                        ,input  'про':U
     1105                        ,input  'все':U
     1106                        ,input  'текущие':U
     1107                        ,input  ?
     1108                        ,input  ",,,,,,NO,,"
     1109                        ,input  ?
     1110                        ,output cli-lst ) .
     1111           if cli-lst = "" then do:
     1112             Assign  RAD-Post = 1.
     1113             Display RAD-Post with frame F-Main .
     1114           end.
     1115       end.
     1116     End case.
     1117   END.
     1118   if not this-procedure :persistent
     1119   then do:
     1120     message
     1121       vss-workfile vss-revision vss-description skip
     1122       "Ошибка при запуске процедуры" skip
     1123       "Данную процедуру следует запускать только с параметром persistent" skip
     1124       view-as alert-box error .
     1125     undo, return error .
     1126   end.
     1127   PROCEDURE disable_UI :
     1128     HIDE FRAME F-Main.
     1129     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1130   END PROCEDURE.
     1131   PROCEDURE local-initialize :
     1132     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1133   END PROCEDURE.
     1134   PROCEDURE my-report :
     1135    define variable Ed-otkl-tm as integer   no-undo initial 0 .
     1136    case RAD-otkl :
     1137      when 3 then
     1138      do:
     1139        assign
     1140          Ed-otkl-prc = Ed-otkl-prc-2
     1141        .
     1142      end.
     1143      when 4 then
     1144      do:
     1145        assign
     1146          Ed-otkl-tm = Ed-otkl-tmh * 60 + Ed-otkl-tmm
     1147        .
     1148      end.
     1149      when 5 then
     1150      do:
     1151        assign
     1152          Ed-otkl-tm  = 0
     1153          Ed-otkl-prc = 0
     1154        .
     1155      end.
     1156    end.
     1157    run cus/r-isp-zk.p ( RAD-Post, cli-lst, tg-zay, RAD-otkl, Ed-otkl-prc, Ed-otkl-tm, RAD-Post-2 , r-status_ , v-ext-art) .
     1158   END PROCEDURE.
     1159   PROCEDURE my-var :
     1160     assign frame F-Main   RAD-Post RAD-Post-2 RAD-otkl Ed-otkl-prc Ed-otkl-tmm  Ed-otkl-tmh tg-zay Ed-otkl-prc-2  r-status_  v-ext-art.
     1161     str1 = "Выбор заказов: " .
     1162     case RAD-Post :
     1163       when 1 then assign str1 = str1 + "все" .
     1164       when 2 then assign str1 = str1 + "от выбранных поставщиков" .
     1165     end.
     1166     case r-status_ :
     1167       when 1 then assign str1 = str1 + "Статусы - все" .
     1168       when 2 then assign str1 = str1 + "Закрытые на ФАКТ" .
     1169     end.
     1170     str2 = "Выбор товаров: " .
     1171     case RAD-otkl :
     1172       when 1 then assign str2 = str2 + "все" .
     1173       when 2 then assign str2 = str2 + "отклонения по кол-ву больше " + String(Ed-otkl-prc) + "  %" .
     1174       when 3 then assign str2 = str2 + "отклонения по цене больше " + String(Ed-otkl-prc-2) + "  %" .
     1175       when 4 then assign str2 = str2 + "отклонения по времени больше " + String(Ed-otkl-tmh) + " ч. " + String(Ed-otkl-tmm) + " м. " .
     1176       when 5 then assign str2 = str2 + "все отклонения" .
     1177     end.
     1178     case RAD-post-2 :
     1179       when 1 then assign str3 = "Сравнивать по поставкам" .
     1180       when 2 then assign str3 = "Сравнивать по накладным" .
     1181     end.
     1182    ReportNAme   = "Отчет по исполнению заказов" .
