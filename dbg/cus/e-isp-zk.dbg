      603   define new global shared variable g#library  as handle no-undo .
      604   define new global shared variable g#library2 as handle no-undo .
      605   define variable var-report-r-b as character no-undo .
      606   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      608     (output var-report-r-b
      609     )  .
      610   define new global shared variable g#language as character no-undo .
      611   if g#language <> '' and g#language <> 'rus':U then do:
      612     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      613   end.
      614   CREATE WIDGET-POOL.
      615   define variable  State-source as  WIDGET-HANDLE.
      616   define variable  cli-lst as character no-undo .
      617   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      618   ASSIGN parParentProc =  my-handle .
      619   DEFINE VARIABLE Ed-otkl-prc AS INTEGER FORMAT ">>>9":U INITIAL 0
      620        VIEW-AS FILL-IN
      621        SIZE 8.63 BY .96 NO-UNDO.
      622   DEFINE VARIABLE Ed-otkl-prc-2 AS INTEGER FORMAT ">>>9":U INITIAL 0
      623        VIEW-AS FILL-IN
      624        SIZE 8.63 BY .96 NO-UNDO.
      625   DEFINE VARIABLE Ed-otkl-tmh AS INTEGER FORMAT "9999":U INITIAL 0
      626        VIEW-AS FILL-IN
      627        SIZE 5 BY 1 NO-UNDO.
      628   DEFINE VARIABLE Ed-otkl-tmm AS INTEGER FORMAT "99":U INITIAL 0
      629        VIEW-AS FILL-IN
      630        SIZE 3.63 BY 1 NO-UNDO.
      631   DEFINE VARIABLE r-status_ AS INTEGER INITIAL 2
      632        VIEW-AS RADIO-SET VERTICAL
      633        RADIO-BUTTONS
      634             "Все", 1,
      635   "только ФАКТ", 2
      636        SIZE 27.63 BY 1.83 NO-UNDO.
      637   DEFINE VARIABLE RAD-otkl AS INTEGER
      638        VIEW-AS RADIO-SET VERTICAL
      639        RADIO-BUTTONS
      640             "Все товары", 1,
      641   "Отклонения по кол-ву (%)", 2,
      642   "Отклонения по цене (%)", 3,
      643   "Отклонения по времени ", 4,
      644   "Все отклонения", 5
      645        SIZE 27.75 BY 7.88
      646        FGCOLOR 0  NO-UNDO.
      647   DEFINE VARIABLE RAD-Post AS INTEGER
      648        VIEW-AS RADIO-SET VERTICAL
      649        RADIO-BUTTONS
      650             "От всех поставщиков", 1,
      651   "От выбранных поставщиков", 2
      652        SIZE 27.63 BY 2 NO-UNDO.
      653   DEFINE VARIABLE RAD-Post-2 AS INTEGER
      654        VIEW-AS RADIO-SET VERTICAL
      655        RADIO-BUTTONS
      656             "По поставкам", 1,
      657   "По накладным", 2
      658        SIZE 27.63 BY 1.96 NO-UNDO.
