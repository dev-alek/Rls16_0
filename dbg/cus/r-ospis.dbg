     3806   procedure print-line :
     3807     do on error undo, return error return-value :
     3808     assign
     3809        Lines_Counter = Lines_Counter + 1
     3810       .
     3811     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     3812     if line-counter( OutStream ) < Tmp_Counter then
     3813       assign
     3814       .
     3815     assign
     3816       Tmp_Counter  = line-counter( OutStream )
     3817     .
     3818     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     3819   display STREAM OutStream
     3820       sym1
     3821       temp-str.artic
     3822       sym2
     3823       temp-str.gds-name
     3824       Sym3
     3825       temp-str.qnty
     3826       Sym4
     3827       temp-str.sum-sale
     3828       Sym5
     3829       temp-str.sum-cost
     3830       Sym6
     3831       temp-str.sum-crsa
     3832       Sym7
     3833       with FRAME  plan-menu    .
     3834   DOWN stream  OutStream 1 with FRAME plan-menu .
