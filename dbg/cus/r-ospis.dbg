     3838   run macr_excel_char in this-procedure ( temp-str.gds-name   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3839   run macr_excel_dec in this-procedure ( temp-str.qnty       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3840   run macr_excel_dec in this-procedure ( temp-str.sum-sale , num#str# , num#col#   )   . assign    num#col# = num#col# + 1 .
     3841   run macr_excel_dec in this-procedure ( temp-str.sum-cost , num#str# , num#col#   )   . assign    num#col# = num#col# + 1 .
     3842   run macr_excel_dec in this-procedure ( temp-str.sum-crsa , num#str# , num#col#   )   . assign    num#col# = num#col# + 1 .
     3843     end.
