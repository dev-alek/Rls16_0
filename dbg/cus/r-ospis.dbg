      803   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      805   procedure paramls-clear :
      806     define buffer buf_temp-param for temp-param .
      807     do
      808     on error undo, return error return-value
      809     :
      810       for each buf_temp-param
      811       on error undo, return error
      812       :
      813         delete buf_temp-param .
      814       end.
      815     end.
      816   end procedure.
      817   procedure paramls-write :
      818     define input  parameter p-code     as character no-undo .
      819     define input  parameter p-sub-code as character no-undo .
      820     define input  parameter p-value    as character no-undo .
      821     define buffer buf_temp-param for temp-param .
      822     do
      823     on error undo, return error return-value
      824     :
      825       find first buf_temp-param
      826         where buf_temp-param.param-code     = p-code
      827           and buf_temp-param.param-sub-code = p-sub-code
      828         no-error .
      829       if not available buf_temp-param then do:
      830         create buf_temp-param .
      831         assign
      832           buf_temp-param.param-code     = p-code
      833           buf_temp-param.param-sub-code = p-sub-code
      834         .
      835       end.
      836       assign
      837         buf_temp-param.param-value = p-value
      838       .
      839     end.
      840   end procedure.
      841   procedure paramls-read :
      842     define input  parameter p-code          as character no-undo .
      843     define input  parameter p-sub-code      as character no-undo .
      844     define input  parameter p-default-value as character no-undo .
      845     define output parameter p-value         as character no-undo .
      846     define buffer buf_temp-param for temp-param .
      847     do
      848     on error undo, return error return-value
      849     :
      850       find first buf_temp-param
      851         where buf_temp-param.param-code     = p-code
      852           and buf_temp-param.param-sub-code = p-sub-code
      853         no-error .
      854       if available buf_temp-param then do:
      855         assign
      856           p-value = buf_temp-param.param-value
      857         .
      858       end.
      859       else do:
      860         assign
      861           p-value = p-default-value
      862         .
      863       end.
      864     end.
      865   end procedure.
      866   procedure paramls-append :
      867     define input  parameter p-code     as character no-undo .
      868     define input  parameter p-sub-code as character no-undo .
      869     define input  parameter p-value    as character no-undo .
      870     define buffer buf_temp-param for temp-param .
      871     do
      872     on error undo, return error return-value
      873     :
      874       find first buf_temp-param
      875            where buf_temp-param.param-code     = p-code
      876              and buf_temp-param.param-sub-code = p-sub-code
      877         no-error .
      878       if not available buf_temp-param then do:
      879         create buf_temp-param .
      880         assign
      881           buf_temp-param.param-code     = p-code
      882           buf_temp-param.param-sub-code = p-sub-code
      883           buf_temp-param.param-value    = p-value
      884         .
      885       end.
      886       else do:
      887           assign
      888               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      889           .
      890       end.
      891     end.
      892   end procedure.
      893   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      894     if num-entries(string(p-dec), '.') = 2
      895       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      896       else return( string(p-dec)) .
      897   end function.
      898   function format-point-to-comma returns char (input orig as char ) .
      899   define variable rtext as character no-undo .
      900   define variable strt as integer no-undo .
      901   define variable leng as integer no-undo .
      902   assign rtext = orig .
      903   repeat:
      904     strt =  index(rtext,'.').
      905     if strt = 0 then leave.
      906     leng = 1.
      907     substring(rtext,strt,leng,"character") = v-delim .
      908   end.
      909   return rtext.
      910   end function.
      911   function format-excel-text returns char ( input start-text as char ) :
      912   def var  i    as int no-undo.
      913   def var  ch   as char no-undo.
      914   def var  n    as int no-undo.
      915   def var  ipos as int no-undo.
      916     n = num-entries(trim(start-text), chr(10)) - 1 .
      917     do i = 1 to n :
      918       ipos = index( start-text, chr(10)).
      919       if ipos > 0 then
      920         substr( start-text, ipos, 1 ) = ' '.
      921     end.
      922     n = num-entries(trim(start-text), chr(13)) - 1 .
      923     do i = 1 to n :
      924       ipos = index( start-text, chr(13)).
      925       if ipos > 0 then
      926         substr( start-text, ipos, 1 ) = ' '.
      927     end.
      928     if index( start-text, '"' ) = 0 then
      929       start-text =  '="'   + trim( start-text) + '"'   .
      930       else do:
      931         n = num-entries(trim(start-text), '"') - 1.
      932         do i = 1 to n :
      933           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      934         end.
      935         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      936         start-text = '="'  + ch  + '"' .
      937       end.
      938     return start-text.
      939   end.
      940   function excel-sum returns char (input p-dec as decimal ).
      941     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      942   end function.
      943   function excel-qnty returns char (input p-dec as decimal ).
      944     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      945   end function.
      946   function format-excel-text-macr returns char ( input start-text as char ) :
      947   def var  i    as int no-undo.
      948   def var  ch   as char no-undo.
      949   def var  n    as int no-undo.
      950   def var  ipos as int no-undo.
      951     n = num-entries(trim(start-text), chr(10)) - 1 .
      952     do i = 1 to n :
      953       ipos = index( start-text, chr(10)).
      954       if ipos > 0 then
      955         substring( start-text, ipos , 1 ) = ' '.
      956     end.
      957     n = num-entries(trim(start-text), chr(13)) - 1 .
      958     do i = 1 to n :
      959       ipos = index( start-text, chr(13)).
      960       if ipos > 0 then
      961         substring( start-text, ipos, 1 ) = ' '.
      962     end.
      963     if index( start-text, '"' ) = 0 then
      964       start-text =  '"'   + trim( start-text) + '"'   .
      965       else do:
      966         n = num-entries(trim(start-text), '"') - 1.
      967         do i = 1 to n :
      968           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      969         end.
      970         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      971         start-text = '"'  + ch  + '"' .
      972       end.
      973     n = num-entries(trim(start-text), chr(10)) - 1 .
      974     do i = 1 to n :
      975       ipos = index( start-text, chr(10)).
      976       if ipos > 0 then
      977         substring( start-text, ipos , 1 ) = ' '.
      978     end.
      979       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      980     return start-text.
      981   end.
      982   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      983   procedure factord :
      984     define input  parameter p-fact-date            as date    no-undo .
      985     define input  parameter p-fact-time            as integer no-undo .
      986     define input  parameter p-fact-num             as integer no-undo .
      987     define input  parameter p-shift-date           as date    no-undo .
      988     define input  parameter p-shift-num            as integer no-undo .
      989     define input  parameter p-shift-on             as logical no-undo .
      990     define output parameter p-fact-order           as decimal no-undo .
      991     define output parameter p-shift-end-fact-order as decimal no-undo .
      992     define output parameter p-day-end-fact-order   as decimal no-undo .
      993     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      994     if p-fact-date = ?
      995     then do:
      996       return error "Не указана фактическая дата" .
      997     end.
      998     define variable v-fact-date-num as integer no-undo .
      999     assign
     1000       v-fact-date-num = integer(p-fact-date)
     1001     .
     1002     if p-fact-num = ?
     1003     or p-fact-num = 0
     1004     then do:
     1005       return error "Не задан p-fact-num " + string(p-fact-num) .
     1006     end.
     1007     if p-fact-num < 0
     1008     then do:
     1009       return error "Отрицательный fact-num " + string(p-fact-num) .
     1010     end.
     1011     if p-fact-num >= 100000000
     1012     then do:
     1013       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1014     end.
     1015     if p-shift-on = true
     1016     then do:
     1017       if p-shift-date = ?
     1018       then do:
     1019         return error "Не задана дата смены" .
     1020       end.
     1021       if p-shift-num = ?
     1022       or p-shift-num = 0
     1023       then do:
     1024         return error "Не задан номер смены" .
     1025       end.
     1026     end.
     1027     else do:
     1028       assign
     1029         p-shift-date = p-fact-date
     1030         p-shift-num  = 24
     1031       .
     1032     end.
     1033     define variable v-shift-offset as integer no-undo .
     1034     if p-shift-date = p-fact-date
     1035     then do:
     1036       assign
     1037         v-shift-offset = 1
     1038       .
     1039     end.
     1040     if p-shift-date < p-fact-date
     1041     then do:
     1042       assign
     1043         v-shift-offset = 0
     1044       .
     1045     end.
     1046     if p-shift-date > p-fact-date
     1047     then do:
     1048       message
     1049         vss-workfile vss-revision vss-description skip
     1050         "Неправильная дата закрытия смены" skip
     1051         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1052         view-as alert-box error .
     1053       undo, return error
     1054         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1055           ,string(p-fact-date, '99/99/9999':U)
     1056           ,string(p-shift-date, '99/99/9999':U)
     1057           )
     1058       .
     1059     end.
     1060     if p-shift-num < 1
     1061     or p-shift-num > 24
     1062     then do:
     1063       message
     1064         vss-workfile vss-revision vss-description skip
     1065         "Неправильный номер смены" skip
     1066         "p-shift-num" p-shift-num skip
     1067         view-as alert-box error .
     1068       undo, return error return-value .
     1069     end.
     1070     assign
     1071       p-fact-order           = v-fact-date-num
     1072                              + v-shift-offset * 0.5
     1073                              + p-shift-num    * 0.02 - 0.01
     1074                              + p-fact-num     * 0.0000000001
     1075       p-shift-end-fact-order = v-fact-date-num
     1076                              + v-shift-offset * 0.5
     1077                              + p-shift-num    * 0.02
     1078       p-day-end-fact-order   = v-fact-date-num
     1079                              + 0.99
     1080     .
     1081     if p-fact-order           <= v-fact-date-num
     1082     or p-shift-end-fact-order <= v-fact-date-num
     1083     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1084     or p-shift-end-fact-order >= p-day-end-fact-order
     1085     then do:
     1086       message
     1087         vss-workfile vss-revision vss-description skip
     1088         "Внутренняя ошибка при генерации фактического номера" skip
     1089         "p-fact-date"            p-fact-date            skip
     1090         "p-fact-time"            p-fact-time            skip
     1091         "p-fact-num"             p-fact-num             skip
     1092         "p-shift-date"           p-shift-date           skip
     1093         "p-shift-num"            p-shift-num            skip
     1094         "p-shift-on"             p-shift-on             skip
     1095         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1096         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1097         "v-fact-date-num"        v-fact-date-num        skip
     1098         view-as alert-box error .
     1099       undo, return error return-value .
     1100     end.
     1101   end procedure.
     1102   procedure day-begin-fact-order :
     1103     define input  parameter p-fact-date            as date    no-undo .
     1104     define output parameter p-day-begin-fact-order as decimal no-undo .
     1105     do
     1106     on error undo, return error return-value
     1107     :
     1108       if p-fact-date = ?
     1109       then do:
     1110         assign
     1111           p-day-begin-fact-order = 0
     1112         .
     1113       end.
     1114       else do:
     1115         assign
     1116           p-day-begin-fact-order = integer(p-fact-date)
     1117         .
     1118       end.
     1119     end.
     1120   end procedure.
     1121   procedure factord-max-fact-order :
     1122     define output parameter p-max-fact-order as decimal   no-undo .
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126       run day-begin-fact-order in this-procedure
     1127         (input  date(1, 1, 5000)
     1128         ,output p-max-fact-order
     1129         ) .
     1130     end.
     1131   end procedure.
     1132   procedure factord-cut-archive :
     1133     define input  parameter p-obj-type             as character no-undo .
     1134     define input  parameter p-obj-code             as integer   no-undo .
     1135     define input  parameter p-fact-date            as date      no-undo .
     1136     define output parameter p-shift-on             as logical   no-undo .
     1137     define output parameter p-shift-date           as date      no-undo .
     1138     define output parameter p-shift-num            as integer   no-undo .
     1139     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1140     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1141     define variable v-fact-order as decimal   no-undo .
     1142     define buffer buf_shift-obj for ub.shift-obj .
     1143     do
     1144     on error undo, return error return-value
     1145     :
     1146   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1148     (input  p-obj-type
     1149     ,input  p-obj-code
     1150     ,input  'shift-on=request'
     1151     ,output p-shift-on
     1152     ) no-error .
     1153       if error-status :error
     1154       then do:
     1155         message
     1156           vss-workfile vss-revision vss-description skip
     1157           "Ошибка при определении атрибута объекта" skip
     1158           "Объект" p-obj-type p-obj-code skip
     1159           error-status :get-message(1) skip
     1160           return-value skip
     1161           view-as alert-box error .
     1162         undo, return error return-value .
     1163       end.
     1164       if p-shift-on = false
     1165       then do:
     1166         assign
     1167           p-shift-date               = ?
     1168           p-shift-num                = 0
     1169         .
     1170       end.
     1171       else do:
     1172         find first buf_shift-obj share-lock
     1173           where buf_shift-obj.obj-type   = p-obj-type
     1174             and buf_shift-obj.obj-code   = p-obj-code
     1175             and buf_shift-obj.shift-date > p-fact-date
     1176           use-index pi
     1177           no-error .
     1178         if not available buf_shift-obj
     1179         or buf_shift-obj.status_ <> 'зкр':U
     1180         then do:
     1181           message
     1182             vss-workfile vss-revision vss-description skip
     1183             "Невозможно вычислить последнюю смену" skip
     1184             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1185             "Объект" p-obj-type p-obj-code skip
     1186             "Дата" p-fact-date skip
     1187             view-as alert-box error .
     1188           undo, return error return-value .
     1189         end.
     1190         find last buf_shift-obj share-lock
     1191           where buf_shift-obj.obj-type = p-obj-type
     1192             and buf_shift-obj.obj-code = p-obj-code
     1193             and buf_shift-obj.shift-date <= p-fact-date
     1194           use-index pi
     1195           no-error .
     1196         if available buf_shift-obj
     1197         then do:
     1198           if  buf_shift-obj.status_ = 'зкр':U
     1199           then do:
     1200             assign
     1201               p-shift-date = buf_shift-obj.shift-date
     1202               p-shift-num  = buf_shift-obj.shift-num
     1203             .
     1204           end.
     1205           else do:
     1206             message
     1207               vss-workfile vss-revision vss-description skip
     1208               "Невозможно вычислить последнюю смену" skip
     1209               "Статус смены отличен от статуса" 'зкр':U skip
     1210               "Объект" p-obj-type p-obj-code skip
     1211               "Дата" p-fact-date skip
     1212               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1213               view-as alert-box error .
     1214             undo, return error return-value .
     1215           end.
     1216         end.
     1217         else do:
     1218           assign
     1219             p-shift-date = p-fact-date - 1
     1220             p-shift-num  = 1
     1221           .
     1222         end.
     1223       end.
     1224       run factord in this-procedure
     1225         (input  p-fact-date
     1226         ,input  1
     1227         ,input  1
     1228         ,input  p-shift-date
     1229         ,input  p-shift-num
     1230         ,input  p-shift-on
     1231         ,output v-fact-order
     1232         ,output p-shift-end-fact-order
     1233         ,output p-day-end-fact-order
     1234         ) no-error .
     1235       if error-status :error
     1236       then do:
     1237         message
     1238           vss-workfile vss-revision vss-description skip
     1239           "Ошибка при вызове процедуры factord"
     1240           error-status :get-message(1) skip
     1241           return-value skip
     1242           view-as alert-box error .
     1243         undo, return error return-value .
     1244       end.
     1245     end.
     1246   end procedure.
     1247   procedure factord-lock-shift :
     1248     define input  parameter p-obj-type  as character no-undo .
     1249     define input  parameter p-obj-code  as integer   no-undo .
     1250     define input  parameter p-fact-date as date      no-undo .
     1251     define parameter buffer buf_shift-obj for ub.shift-obj .
     1252     define variable v-shift-on      as logical   no-undo .
     1253     define variable v-extra-message as character no-undo .
     1254     define variable v-error as character no-undo .
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1260     (input  p-obj-type
     1261     ,input  p-obj-code
     1262     ,input  'shift-on=request'
     1263     ,output v-shift-on
     1264     ) no-error .
     1265       if error-status :error
     1266       then do:
     1267         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1268         undo, return error v-error .
     1269       end.
     1270       if v-shift-on = true
     1271       then do:
     1272         find first buf_shift-obj share-lock
     1273           where buf_shift-obj.obj-type   = p-obj-type
     1274             and buf_shift-obj.obj-code   = p-obj-code
     1275             and buf_shift-obj.shift-date > p-fact-date
     1276           use-index pi
     1277           no-error .
     1278         if not available buf_shift-obj
     1279         or buf_shift-obj.status_ <> 'зкр':U
     1280         then do:
     1281           find last buf_shift-obj
     1282             where buf_shift-obj.obj-type = p-obj-type
     1283               and buf_shift-obj.obj-code = p-obj-code
     1284               and buf_shift-obj.status_  = 'зкр':U
     1285             use-index stts
     1286             no-error .
     1287           if available buf_shift-obj
     1288           then do:
     1289             assign
     1290               v-extra-message =
     1291                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1292                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1293                               )
     1294             .
     1295           end.
     1296           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1297           undo, return error v-error .
     1298         end.
     1299       end.
     1300     end.
     1301   end procedure.
     1302   procedure factord-end-day :
     1303     define input  parameter p-fact-date            as date    no-undo .
     1304     define output parameter p-day-end-fact-order   as decimal no-undo .
     1305     do
     1306     on error undo, return error return-value
     1307     :
     1308       if p-fact-date = ?
     1309       then do:
     1310         return error "Не указана фактическая дата" .
     1311       end.
     1312       assign
     1313         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1314       .
     1315     end.
     1316   end procedure.
     1317   procedure factord-to-date :
     1318     define input  parameter p-fact-order as decimal no-undo .
     1319     define output parameter p-fact-date  as date    no-undo .
     1320     define variable v-ref-date  as date      no-undo .
     1321     define variable v-ref-delta as integer   no-undo .
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325       if p-fact-order = ?
     1326       or p-fact-order = 0
     1327       then do:
     1328         return error "Не указан fact-order" .
     1329       end.
     1330       assign
     1331         v-ref-date  = date(1, 1, 2000)
     1332       .
     1333       assign
     1334         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1335       .
     1336       assign
     1337         p-fact-date = v-ref-date + v-ref-delta
     1338       .
     1339     end.
     1340   end procedure.
     1341   procedure factord-to-fact-num :
     1342     define input  parameter p-fact-order as decimal no-undo .
     1343     define output parameter p-fact-num   as integer no-undo .
     1344     define variable v-fact-order-trunc as decimal no-undo .
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       if p-fact-order = ?
     1349       or p-fact-order = 0
     1350       then do:
     1351         return error "Не указан fact-order" .
     1352       end.
     1353       assign
     1354        v-fact-order-trunc = truncate(p-fact-order, 2)
     1355       .
     1356       assign
     1357         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1358       .
     1359     end.
     1360   end procedure.
     1361   procedure factord-to-shift-num :
     1362     define input  parameter p-fact-order as decimal no-undo .
     1363     define output parameter p-shift-num   as integer no-undo .
     1364     define variable  p-shift-numd  as decimal   no-undo .
     1365     define variable v-fact-order-trunc as decimal no-undo .
     1366     do
     1367     on error undo, return error return-value
     1368     :
     1369       if p-fact-order = ?
     1370       or p-fact-order = 0
     1371       then do:
     1372         return error "Не указан fact-order" .
     1373       end.
     1374       assign
     1375        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1376       .
     1377       if v-fact-order-trunc < 0.5 then do:
     1378         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1379       end.
     1380       assign
     1381         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1382         .
     1383        assign
     1384         p-shift-num = truncate (p-shift-numd , 0)
     1385       .
     1386     end.
     1387   end procedure.
