     3852   procedure PrintTitul :
     3853     do  on error undo, return error return-value  :
     3854       define variable v-nn as integer   no-undo .
     3855        PUT stream OutStream  string( v-cntxt-host-name-obj ) skip.
     3856        PUT stream OutStream CaPS(ReportName) AT 10 format "x(100)"  skip .
     3857        PUT stream OutStream str1 AT 1 format "x(130)"  skip(2) .
     3858        PUT stream OutStream str2 AT 1 format "x(130)"  skip .
     3859        v-nn = NUM-ENTRIES(str3,chr(10)).
     3860        Repeat i = 1 to v-nn :
     3861          PUT stream OutStream  Entry(i,str3,chr(10))  AT 1 format "X(130)" skip .
     3862        End.
     3863        v-nn = NUM-ENTRIES(str4,chr(10)).
     3864        Repeat i = 1 to v-nn :
     3865          PUT stream OutStream  Entry(i,str4,chr(10))  AT 1 format "X(130)" skip .
     3866        End.
     3867        v-nn = NUM-ENTRIES(ReportHeader,chr(10)).
     3868        Repeat i = 1 to v-nn :
     3869          PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(130)" skip .
     3870        End.
     3871     num#str# = 1.
     3872     num#col# = 1.
     3873         run macr_excel_char_with_format in this-procedure ( ReportNAme , num#str# , num#col#  ).
     3874         run macr_cell_format in this-procedure
     3875             ( 12    ,
     3876               true  ,
     3877               false ,
     3878               ?     ,
     3879               num#str# ,
     3880               num#col# ,
     3881               ? ,
     3882               ?         ) .
     3883   define variable l-ii  as integer no-undo .
     3884   define variable l-jj  as integer no-undo .
     3885   define variable l-len as integer no-undo .
     3886   define variable l-m   as integer no-undo .
     3887   define variable v-n as integer   no-undo .
     3888   v-n = num-entries( str1 , "chr(10)"  )   .   do l-ii = 1 to v-n :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 120 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format in this-procedure (                  substring(entry( l-ii , str1  , "chr(10)") , (( 120 * l-jj ) - 119 )  , 120 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3889   v-n = num-entries( str2 , "chr(10)"  )   .   do l-ii = 1 to v-n :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 120 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format in this-procedure (                  substring(entry( l-ii , str2  , "chr(10)") , (( 120 * l-jj ) - 119 )  , 120 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3890   v-n = num-entries( str3 , "chr(10)"  )   .   do l-ii = 1 to v-n :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 120 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format in this-procedure (                  substring(entry( l-ii , str3  , "chr(10)") , (( 120 * l-jj ) - 119 )  , 120 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3891   v-n = num-entries( str4 , "chr(10)"  )   .   do l-ii = 1 to v-n :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 120 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format in this-procedure (                  substring(entry( l-ii , str4  , "chr(10)") , (( 120 * l-jj ) - 119 )  , 120 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3892   v-n = num-entries( reportheader , "chr(10)"  )   .   do l-ii = 1 to v-n :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 120 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format in this-procedure (                  substring(entry( l-ii , reportheader  , "chr(10)") , (( 120 * l-jj ) - 119 )  , 120 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3893     num#str# = num#str# + 1.
     3894     num#col# = 1.
     3895     run macr_excel_char_with_format in this-procedure (  "  Цены указаны в РУБ"     , num#str#  , num#col#  ) .
     3896      run proc-print-header in this-procedure .
     3897     end.
     3898   end procedure.
     3899   procedure PrintPodval :
     3900     do on error undo, return error return-value  :
     3901       PUT stream OutStream  Line format "X(132)" at 1 skip.
     3902     end.
     3903   end procedure.
     3904   PROCEDURE on-same-page :
     3905     define input parameter p-line-number as integer  no-undo .
     3906     if p-line-number > page-size( OutStream ) then return .
     3907     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     3908   end procedure.
     3909   procedure make-tt :
     3910     do
     3911     on error undo, return error return-value
     3912     :
     3913    define buffer buf_trn-doc for  ub.trn-doc.
     3914    define buffer buf_doc-line for ub.doc-line.
     3915    define buffer buf_goods for ub.goods.
     3916    for each obj-list
     3917        on error undo, return error :
     3918        for each buf_trn-doc no-lock where
     3919            buf_trn-doc.obj-type = obj-list.obj-type  and
     3920            buf_trn-doc.obj-code = obj-list.obj-code  and
     3921            buf_trn-doc.internal = false  and
     3922            buf_trn-doc.doc-type = 'спи':U  and
     3923            buf_trn-doc.ext-doc-type = 'we':U and
     3924            buf_trn-doc.status_ = 'факт':U and
     3925            buf_trn-doc.fact-date >= x-date-start and
     3926            buf_trn-doc.fact-date <= x-date-end
     3927            on error undo, return error :
     3928            if p-RADPost  = 2 then do:
     3929               find first g#post where g#post.obj-type = buf_trn-doc.cli-type and
     3930                                       g#post.obj-code = buf_trn-doc.cli-code no-error .
     3931                if not available g#post then next.
     3932            end.
     3933              for each buf_doc-line no-lock where
     3934                       buf_doc-line.doc-code = buf_trn-doc.doc-code
     3935                  on error undo, return error :
     3936                  if x-SelectGood <> 1 then do:
     3937                     find first gds-list where
     3938                                 gds-list.artic      = buf_doc-line.artic       and
     3939                                 gds-list.prod-type  = buf_doc-line.prod-type   and
     3940                                 gds-list.prod-code  = buf_doc-line.prod-code   no-error .
     3941                     if not available gds-list then next.
     3942                  end.
     3943                   find first buf_goods no-lock where
     3944                     buf_goods.artic              = buf_doc-line.artic       and
     3945                     buf_goods.prod-type          = buf_doc-line.prod-type   and
     3946                     buf_goods.prod-code          = buf_doc-line.prod-code   no-error .
     3947                   run clcprtsl_calc-line  in this-procedure (recid (buf_doc-line)) .
     3948                   find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     3949                   if error-status :error then do:
     3950                       message vss-workfile vss-revision vss-description skip
     3951                             "Ошибка tt-allsum-line " skip
     3952                               buf_doc-line.artic
     3953                               skip
     3954                               error-status :get-message(1) skip
     3955                               return-value skip
     3956                               view-as alert-box error
     3957                       .
     3958                       next.
     3959                   end.
     3960                   find first temp-str where
     3961                     temp-str.artic              = buf_doc-line.artic       and
     3962                     temp-str.prod-type          = buf_doc-line.prod-type   and
     3963                     temp-str.prod-code          = buf_doc-line.prod-code   and
     3964                     temp-str.supp-code          =  buf_trn-doc.cli-code    and
     3965                     temp-str.supp-type          =  buf_trn-doc.cli-type    and
     3966                     temp-str.obj-code           =  buf_trn-doc.obj-code    and
     3967                     temp-str.obj-type           =  buf_trn-doc.obj-type    no-error .
     3968                   if not available temp-str then do:
     3969                       create temp-str.
     3970                       assign
     3971                         temp-str.artic              = buf_doc-line.artic
     3972                         temp-str.prod-type          = buf_doc-line.prod-type
     3973                         temp-str.prod-code          = buf_doc-line.prod-code
     3974                         temp-str.gds-name           = buf_goods.gds-name
     3975                         temp-str.gds-code           = buf_goods.gds-code
     3976                         temp-str.qnty               =  tt-allsum-line.fact-qnty
     3977                         temp-str.sum-sale           =  tt-allsum-line.sum-dsc-rubl-doc
     3978                         temp-str.sum-cost           =  tt-allsum-line.sum-dsc-rubl-acc
     3979                         temp-str.sum-crsa           =  tt-allsum-line.sum-dsc-rubl-cur
     3980                         temp-str.supp-code          =  buf_trn-doc.cli-code
     3981                         temp-str.supp-type          =  buf_trn-doc.cli-type
     3982                         temp-str.obj-code           =  buf_trn-doc.obj-code
     3983                         temp-str.obj-type           =  buf_trn-doc.obj-type
     3984                       .
     3985                     end.
     3986                     else do:
     3987                       assign
     3988                         temp-str.qnty               =  temp-str.qnty     +  tt-allsum-line.fact-qnty
     3989                         temp-str.sum-sale           =  temp-str.sum-sale +  tt-allsum-line.sum-dsc-rubl-doc
     3990                         temp-str.sum-cost           =  temp-str.sum-cost +  tt-allsum-line.sum-dsc-rubl-acc
     3991                         temp-str.sum-crsa           =  temp-str.sum-crsa +  tt-allsum-line.sum-dsc-rubl-cur
     3992                       .
     3993                     end.
     3994              end.
     3995        end.
     3996    end.
     3997     end.
     3998    end procedure.
     3999   procedure print-obj :
     4000    do
     4001    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4002    :
     4003    define output parameter v-qnty-a as decimal no-undo .
     4004    define output parameter v-sum1-a as decimal no-undo .
     4005    define output parameter v-sum2-a as decimal no-undo .
     4006    define output parameter v-sum3-a as decimal no-undo .
     4007    define variable v-qnty     as decimal no-undo .
     4008    define variable v-sum1     as decimal no-undo .
     4009    define variable v-sum2     as decimal no-undo .
     4010    define variable v-sum3     as decimal no-undo .
     4011    define variable v-qnty-o as decimal no-undo .
     4012    define variable v-sum1-o as decimal no-undo .
     4013    define variable v-sum2-o as decimal no-undo .
     4014    define variable v-sum3-o as decimal no-undo .
     4015    assign
     4016       v-qnty    = 0
     4017       v-sum1    = 0
     4018       v-sum2    = 0
     4019       v-sum3    = 0
     4020       v-qnty-o  = 0
     4021       v-sum1-o  = 0
     4022       v-sum2-o  = 0
     4023       v-sum3-o  = 0
     4024       v-qnty-a  = 0
     4025       v-sum1-a  = 0
     4026       v-sum2-a  = 0
     4027       v-sum3-a  = 0
     4028    .
     4029       for each temp-str break by temp-str.obj-type  by temp-str.obj-code
     4030                               by temp-str.supp-type by temp-str.supp-code
     4031       :
     4032           if first-of (temp-str.obj-code) then do:
     4033              find first obj-list where
     4034                                  obj-list.obj-type = temp-str.obj-type  and
     4035                                  obj-list.obj-code = temp-str.obj-code .
     4036              run print-name in this-procedure ("ОБЪЕКТ:" , obj-list.obj-name ) .
     4037              PUT stream OutStream  Line format "X(132)" at 1 skip.
     4038               assign
     4039                   v-qnty    = 0
     4040                   v-sum1    = 0
     4041                   v-sum2    = 0
     4042                   v-sum3    = 0
     4043                   v-qnty-o  = 0
     4044                   v-sum1-o  = 0
     4045                   v-sum2-o  = 0
     4046                   v-sum3-o  = 0
     4047               .
     4048           end.
     4049                 if first-of (temp-str.supp-code) then do:
     4050                   find first ub.clients where
     4051                                       ub.clients.obj-type = temp-str.supp-type  and
     4052                                       ub.clients.obj-code = temp-str.supp-code .
     4053                   if p-SumsOnly = false then
     4054                      run print-name in this-procedure  ("КОНТРАГЕНТ" , "СПИСАНИЯ: " + ub.clients.obj-name ) .
     4055                   assign
     4056                       v-qnty    = 0
     4057                       v-sum1    = 0
     4058                       v-sum2    = 0
     4059                       v-sum3    = 0
     4060                   .
     4061                 end.
     4062                 assign
     4063                     v-qnty    = v-qnty   +  temp-str.qnty
     4064                     v-sum1    = v-sum1   +  temp-str.sum-sale
     4065                     v-sum2    = v-sum2   +  temp-str.sum-cost
     4066                     v-sum3    = v-sum3   +  temp-str.sum-crsa
     4067                     v-qnty-o  = v-qnty-o +  temp-str.qnty
     4068                     v-sum1-o  = v-sum1-o +  temp-str.sum-sale
     4069                     v-sum2-o  = v-sum2-o +  temp-str.sum-cost
     4070                     v-sum3-o  = v-sum3-o +  temp-str.sum-crsa
     4071                     v-qnty-a  = v-qnty-a +  temp-str.qnty
     4072                     v-sum1-a  = v-sum1-a +  temp-str.sum-sale
     4073                     v-sum2-a  = v-sum2-a +  temp-str.sum-cost
     4074                     v-sum3-a  = v-sum3-a +  temp-str.sum-crsa
     4075                 .
     4076                 if p-SumsOnly = false then run print-line in this-procedure .
     4077                 if last-of (temp-str.supp-code) then do:
     4078                   run print-itog in this-procedure ("ИТОГО ПО КОНТРАГЕНТУ: " + ub.clients.obj-name ,
     4079                   v-qnty,
     4080                   v-sum1,
     4081                   v-sum2,
     4082                   v-sum3  ) .
     4083                 end.
     4084           if last-of (temp-str.obj-code) then do:
     4085              run print-itog in this-procedure ("ИТОГО ПО ОБЪЕКТУ: " + obj-list.obj-name ,
     4086                   v-qnty-o,
     4087                   v-sum1-o,
     4088                   v-sum2-o,
     4089                   v-sum3-o  ) .
     4090              PUT stream OutStream  Line format "X(132)" at 1 skip.
     4091           end.
     4092       end.
     4093    end.
     4094   end procedure.
     4095   procedure print-all :
     4096    do
     4097    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4098    :
     4099    define output parameter v-qnty-a as decimal no-undo .
     4100    define output parameter v-sum1-a as decimal no-undo .
     4101    define output parameter v-sum2-a as decimal no-undo .
     4102    define output parameter v-sum3-a as decimal no-undo .
     4103    define variable v-qnty     as decimal no-undo .
     4104    define variable v-sum1     as decimal no-undo .
     4105    define variable v-sum2     as decimal no-undo .
     4106    define variable v-sum3     as decimal no-undo .
     4107    assign
     4108       v-qnty    = 0
     4109       v-sum1    = 0
     4110       v-sum2    = 0
     4111       v-sum3    = 0
     4112       v-qnty-a  = 0
     4113       v-sum1-a  = 0
     4114       v-sum2-a  = 0
     4115       v-sum3-a  = 0
     4116    .
     4117       for each temp-str break by temp-str.supp-type by temp-str.supp-code :
     4118           if first-of (temp-str.supp-code) then do:
     4119              find first ub.clients where
     4120                                  ub.clients.obj-type = temp-str.supp-type  and
     4121                                  ub.clients.obj-code = temp-str.supp-code .
     4122              if p-SumsOnly = false then
     4123                 run print-name in this-procedure ("КОНТРАГЕНТ" , "СПИСАНИЯ: " + ub.clients.obj-name ) .
     4124               assign
     4125                   v-qnty    = 0
     4126                   v-sum1    = 0
     4127                   v-sum2    = 0
     4128                   v-sum3    = 0
     4129               .
     4130           end.
     4131                 assign
     4132                     v-qnty    = v-qnty   +  temp-str.qnty
     4133                     v-sum1    = v-sum1   +  temp-str.sum-sale
     4134                     v-sum2    = v-sum2   +  temp-str.sum-cost
     4135                     v-sum3    = v-sum3   +  temp-str.sum-crsa
     4136                     v-qnty-a  = v-qnty-a +  temp-str.qnty
     4137                     v-sum1-a  = v-sum1-a +  temp-str.sum-sale
     4138                     v-sum2-a  = v-sum2-a +  temp-str.sum-cost
     4139                     v-sum3-a  = v-sum3-a +  temp-str.sum-crsa
     4140                 .
     4141           if p-SumsOnly = false then
     4142              run print-line in this-procedure .
     4143           if last-of (temp-str.supp-code) then do:
     4144              run print-itog  in this-procedure ("ИТОГО ПО КОНТРАГЕНТУ: " + ub.clients.obj-name   ,
     4145                               v-qnty ,
     4146                               v-sum1 ,
     4147                               v-sum2 ,
     4148                               v-sum3  ) .
     4149           end.
     4150       end.
     4151    end.
     4152   end procedure.
     4153   procedure print-name :
     4154    do
     4155    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4156    with frame plan-menu
     4157    :
     4158   define input parameter p-name as character no-undo .
     4159   define input parameter p-name1 as character no-undo .
     4160   display STREAM OutStream
     4161       sym1
     4162       p-name  @  temp-str.artic
     4163       p-name1 @  temp-str.gds-name
     4164       Sym7
     4165       with FRAME  plan-menu    .
     4166   DOWN stream  OutStream 1 with FRAME plan-menu .
     4167     num#str# = num#str# + 1.
     4168     num#col# = 1.
     4169     run macr_excel_char_with_format in this-procedure (  p-name + " " + p-name1  , num#str#  , num#col#  ) .
     4170         run macr_cell_format in this-procedure
     4171             ( 12    ,
     4172               true  ,
     4173               false ,
     4174               ?     ,
     4175               num#str# ,
     4176               num#col# ,
     4177               ? ,
     4178               ?         ) .
     4179    end.
     4180   end procedure.
     4181   procedure print-itog :
     4182    do
     4183    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4184    with frame plan-menu
     4185    :
     4186   define input parameter p-name as character no-undo .
     4187   define input parameter p-qnty     as decimal no-undo .
     4188   define input parameter p-sum-sale as decimal no-undo .
     4189   define input parameter p-sum-cost as decimal no-undo .
     4190   define input parameter p-sum-crsa as decimal no-undo .
     4191   display STREAM OutStream
     4192       sym1
     4193       substring(p-name,1,16)  @ temp-str.artic
     4194       substring(p-name,17,1)  @ Sym2
     4195       substring(p-name,18,30) @ temp-str.gds-name
     4196       Sym3
     4197       p-qnty      @ temp-str.qnty
     4198       Sym4
     4199       p-sum-sale  @ temp-str.sum-sale
     4200       Sym5
     4201       p-sum-cost  @ temp-str.sum-cost
     4202       Sym6
     4203       p-sum-crsa  @ temp-str.sum-crsa
     4204       Sym7
     4205       with FRAME  plan-menu    .
     4206   DOWN stream  OutStream 1 with FRAME plan-menu .
     4207     num#str# = num#str# + 1.
     4208     num#col# = 1.
     4209   run macr_excel_char_with_format in this-procedure (  p-name  , num#str#  , num#col#  ) . assign    num#col# = num#col# + 2 .
     4210   run macr_excel_dec in this-procedure ( p-qnty     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     4211   run macr_excel_dec in this-procedure ( p-sum-sale , num#str# , num#col#   )   . assign    num#col# = num#col# + 1 .
     4212   run macr_excel_dec in this-procedure ( p-sum-cost , num#str# , num#col#   )   . assign    num#col# = num#col# + 1 .
     4213   run macr_excel_dec in this-procedure ( p-sum-crsa , num#str# , num#col#   )   . assign    num#col# = num#col# + 1 .
     4214         run macr_cell_format in this-procedure
     4215             ( 12    ,
     4216               true  ,
     4217               false ,
     4218               34     ,
     4219               num#str# ,
     4220               1 ,
     4221               ? ,
     4222               num#col#   ) .
     4223    end.
     4224   end procedure.
     4225   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4226   procedure macr_excel_char :
     4227    do
     4228    on error undo, return error return-value
     4229    :
     4230    define input parameter  p-val as character no-undo .
     4231    define input parameter  p-row as integer no-undo .
     4232    define input parameter  p-col as integer no-undo .
     4233    if p-val = ? then p-val = "" .
     4234       put stream macr_excel unformatted
     4235             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4236    end.
     4237   end procedure.
     4238   procedure macr_excel_char_with_format :
     4239    do
     4240    on error undo, return error return-value
     4241    :
     4242    define input parameter  p-val as character no-undo .
     4243    define input parameter  p-row as integer no-undo .
     4244    define input parameter  p-col as integer no-undo .
     4245    if p-val = ? then p-val = "" .
     4246       put stream macr_excel unformatted
     4247             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4248       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     4249       put stream macr_excel unformatted
     4250             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4251    end.
     4252   end procedure.
     4253   procedure macr_excel_cell_format :
     4254    do
     4255    on error undo, return error return-value
     4256    :
     4257    define input parameter  p-val    as character no-undo .
     4258    define input parameter  p-row    as integer   no-undo .
     4259    define input parameter  p-col    as integer   no-undo .
     4260    define input parameter  p-format as character no-undo .
     4261    if p-val = ? then p-val = "" .
     4262       put stream macr_excel unformatted
     4263             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4264       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     4265       put stream macr_excel unformatted
     4266             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4267    end.
     4268   end procedure.
     4269   procedure macr_excel_sum :
     4270    do
     4271    on error undo, return error return-value
     4272    :
     4273    define input parameter  p-row as integer no-undo .
     4274    define input parameter  p-col as integer no-undo .
     4275    define input parameter  p-row1 as integer no-undo .
     4276    define input parameter  p-col1 as integer no-undo .
     4277    define input parameter  p-row2 as integer no-undo .
     4278    define input parameter  p-col2 as integer no-undo .
     4279       put stream macr_excel unformatted
     4280             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     4281    end.
     4282   end procedure.
     4283   procedure macr_excel_dec :
     4284    do
     4285    on error undo, return error return-value
     4286    :
     4287    define input parameter  p-val as character no-undo .
     4288    define input parameter  p-row as integer   no-undo .
     4289    define input parameter  p-col as integer   no-undo .
     4290     if p-val = ? then p-val =  "" .
     4291      put  stream macr_excel unformatted
     4292           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     4293    end.
     4294   end procedure.
     4295   procedure macr_cell_format :
     4296    do
     4297    on error undo, return error return-value
     4298    :
     4299    define input parameter  p-size   as integer   no-undo .
     4300    define input parameter  p-bold   as logical   no-undo .
     4301    define input parameter  p-italic as logical   no-undo .
     4302    define input parameter  p-color  as integer   no-undo .
     4303    define input parameter  p-row    as integer   no-undo .
     4304    define input parameter  p-col    as integer   no-undo .
     4305    define input parameter  p-row-2  as integer   no-undo .
     4306    define input parameter  p-col-2  as integer   no-undo .
     4307     if p-size = ? then p-size = 10 .
     4308     if p-bold = ? then p-bold = false .
     4309     if p-italic = ? then p-italic = false .
     4310     if p-row-2 = ? then p-row-2 = p-row .
     4311     if p-col-2 = ? then p-col-2 = p-col .
     4312     put  stream macr_excel unformatted
     4313      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     4314     if p-color <> ? then do:
     4315        put  stream macr_excel unformatted
     4316          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     4317     end.
     4318     put  stream macr_excel unformatted
     4319          substitute('format.font(,&1,&2,&3)' , p-size,
     4320                                           string ( p-bold  , "true/false" ) ,
     4321                                           string ( p-italic , "true/false" )
     4322                                           ) + chr(10) .
     4323    end.
     4324   end procedure.
     4325   procedure macr_cell_size :
     4326    do
     4327    on error undo, return error return-value
     4328    :
     4329    define input parameter  p-w   as integer   no-undo .
     4330    define input parameter  p-l   as integer   no-undo .
     4331    define input parameter  p-row    as integer   no-undo .
     4332    define input parameter  p-col    as integer   no-undo .
     4333    define input parameter  p-row-2  as integer   no-undo .
     4334    define input parameter  p-col-2  as integer   no-undo .
     4335     if p-row-2 = ? then p-row-2 = p-row .
     4336     if p-col-2 = ? then p-col-2 = p-col .
     4337     if p-w = ? then    p-w = 0 .
     4338     if p-l = ? then    p-l = 0 .
     4339    define variable s-w as character no-undo .
     4340    define variable s-l as character no-undo .
     4341    if p-w = 0 then s-w = "" .
     4342               else s-w = string(p-w)  .
     4343    if p-l = 0 then s-l = "" .
     4344               else s-l = string(p-l)  .
     4345   put  stream macr_excel unformatted
     4346        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4347   put  stream macr_excel unformatted
     4348        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4349   put  stream macr_excel unformatted
     4350        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4351    end.
     4352   end procedure.
     4353   procedure proc-print-header :
     4354    do
     4355    on error undo, return error return-value
     4356    :
     4357      find first sheetf .
     4358        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4359        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4360        var-1 =  num#str# .
     4361        repeat c-c = 1 to sheetf.excel-row-title :
     4362        num#str# = num#str# + 1 .
     4363        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4364        do c-i = 1 to p-var :
     4365           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4366           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4367           num#col# = c-i .
     4368           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     4369           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4370        end.
     4371       c-i = 0.
     4372       end.
     4373       run macr_cell_format (
     4374           10       ,
     4375           true     ,
     4376           false    ,
     4377           35       ,
     4378           var-1 + 1,
     4379           1        ,
     4380           num#str# ,
     4381           num#col# )
     4382           .
     4383     put  stream macr_excel unformatted
     4384          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4385          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4386          .
     4387    end.
     4388   end procedure.
     4389   procedure end-proc :
     4390    do
     4391    on error undo, return error return-value
     4392    :
     4393     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4394     OUTPUT to VALUE (v-file-name) .
     4395     for each temp-param :
     4396       export  temp-param  .
     4397     end.
     4398    end.
     4399   end procedure.
