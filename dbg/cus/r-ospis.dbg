     3125   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3126   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3127     (input  bf_trn-doc.obj-type
     3128     ,input  bf_trn-doc.obj-code
     3129     ,input  varb-code
     3130     ,input  0
     3131     ,input  bf_trn-doc.fact-order
     3132     ,output vardoc-num
     3133     ,output varprice-sale
     3134     ,output varroad-tax
     3135     ,output varexcise
     3136     )  .
     3137             if varprice-sale = ?
     3138             then do:
     3139               assign
     3140                 varprice-sale = 0
     3141                 varroad-tax   = 0
     3142                 varexcise     = 0
     3143               .
     3144             end.
     3145             assign
     3146               varlastcur-base     = varprice-sale
     3147               varlastcur-road-tax = varroad-tax
     3148               varlastcur-excise   = varexcise
     3149               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3150               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3151               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3152               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3153             .
     3154         end.
     3155       end.
     3156       if varcur-fact-qnty = 0 then do:
     3157         assign
     3158           varcur-base      = varlastcur-base
     3159           varcur-road-tax  = varlastcur-road-tax
     3160           varcur-excise    = varlastcur-excise
     3161         .
     3162       end.
     3163       else do:
     3164         assign
     3165           varcur-base      = varcur-base      / varcur-fact-qnty
     3166           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3167           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3168         .
     3169       end.
     3170       if varcur-vat-pc = ?
     3171       then do:
     3172         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3173       end.
     3174       if varcur-slt-pc = ?
     3175       then do:
     3176         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3177       end.
     3178       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3179       assign
     3180         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3181       if varcur-cons-vat-pc = ? then do:
     3182         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3183       end.
     3184       define buffer buf_tt-clcparts for tt-clcparts .
     3185       for each buf_tt-clcparts
     3186       on error undo, return error return-value
     3187       :
     3188         delete buf_tt-clcparts.
     3189       end.
     3190       for each bf_parts no-lock
     3191         where bf_parts.out-code  = bf_doc-line.doc-code
     3192           and bf_parts.obj-type  = bf_doc-line.obj-type
     3193           and bf_parts.obj-code  = bf_doc-line.obj-code
     3194           and bf_parts.artic     = bf_doc-line.artic
     3195           and bf_parts.prod-type = bf_doc-line.prod-type
     3196           and bf_parts.prod-code = bf_doc-line.prod-code
     3197       on error undo, return error return-value
     3198       :
     3199         create buf_tt-clcparts .
     3200         buffer-copy bf_parts to buf_tt-clcparts .
     3201         if v-calcbypart = yes   then do:
     3202   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3203     (buffer bf_parts
     3204     ,output v-b-pcode
     3205     ) no-error .
     3206   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3208     (input  bf_parts.obj-type
     3209     ,input  bf_parts.obj-code
     3210     ,input  v-b-pcode
     3211     ,input  0
     3212     ,input  bf_trn-doc.fact-order
     3213     ,output vardoc-num
     3214     ,output varprice-salef
     3215     ,output varroad-tax
     3216     ,output varexcise
     3217     ) no-error .
     3218             if varprice-sale = ?
     3219             then do:
     3220               assign
     3221                 varprice-salef = 0
     3222                 varroad-tax   = 0
     3223                 varexcise     = 0
     3224               .
     3225             end.
     3226             assign
     3227             part-cur-base  = varprice-salef
     3228             part-cur-road-tax  = varroad-tax
     3229             part-cur-excise = varexcise.
     3230         end.
     3231       end.
     3232       run clcprtsl_calc-ttable in this-procedure
     3233         (input yes,
     3234          input yes,
     3235          input bf_doc-line.road-tax,
     3236          input bf_doc-line.excise,
     3237          input bf_doc-line.vat-pc,
     3238          input bf_doc-line.cons-vat-pc,
     3239          input bf_doc-line.slt-pc,
     3240          input bf_trn-doc.base-rate,
     3241          input bf_trn-doc.base-scale,
     3242          input varr-b,
     3243          input varcur-base,
     3244          input varcur-road-tax,
     3245          input varcur-excise,
     3246          input varcur-vat-pc,
     3247          input varcur-cons-vat-pc,
     3248          input varcur-slt-pc
     3249          ) no-error.
     3250       if error-status:error then do:
     3251         message
     3252           vss-workfile vss-revision vss-description skip
     3253           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3254           return-value skip
     3255           trim(error-status :get-message(1))
     3256           trim(error-status :get-message(2))
     3257           trim(error-status :get-message(3))
     3258           trim(error-status :get-message(4))
     3259           trim(error-status :get-message(5)) skip
     3260           view-as alert-box error.
     3261         undo, return error .
     3262       end.
     3263     end.
     3264   end.
     3265   end.
     3266   procedure clcprtsl_calc-ttable :
     3267   define input parameter paris-doc           as   logical                 no-undo.
     3268   define input parameter paris-cur           as   logical                 no-undo.
     3269   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3270   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3271   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3272   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3273   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3274   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3275   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3276   define input parameter parr-b              as   character               no-undo.
     3277   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3278   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3279   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3280   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3281   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3282   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3283   define buffer bf_tt-allsum      for tt-allsum.
     3284   define buffer bf_tt-clcparts    for tt-clcparts.
     3285   define buffer bf_tt-allsum-line for tt-allsum-line.
     3286   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3287   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3288   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3289   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3290   define variable varexcise          like ub.price-list.excise     no-undo.
     3291   do on error undo, return error return-value :
     3292   for each bf_tt-allsum-line
     3293   on error undo, return error return-value
     3294    :
     3295     delete bf_tt-allsum-line.
     3296   end.
     3297   for each bf_tt-allsum
     3298   on error undo, return error return-value
     3299   :
     3300     delete bf_tt-allsum.
     3301   end.
     3302   for each bf_tt-clcparts
     3303   on error undo, return error return-value
     3304   :
     3305   if v-calcbypart then do:
     3306             assign
     3307             parcur-base =   bf_tt-clcparts.part-cur-base
     3308             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3309             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3310             .
     3311   end.
     3312      run clcprtsl_calc-parts in this-procedure (
     3313        input recid(bf_tt-clcparts),
     3314        input paris-doc,
     3315        input paris-cur,
     3316        input parroad-tax,
     3317        input parexcise,
     3318        input parvat-pc,
     3319        input parcons-vat-pc,
     3320        input parslt-pc,
     3321        input parbase-rate,
     3322        input parbase-scale,
     3323        input parr-b,
     3324        input parcur-base,
     3325        input parcur-road-tax,
     3326        input parcur-excise,
     3327        input parcur-vat-pc,
     3328        input parcurcons-vat-pc,
     3329        input parcurslt-pc
     3330        ) no-error.
     3331     if error-status:error then do:
     3332       message
     3333         vss-workfile vss-revision vss-description skip
     3334         vss-include-info13 skip
     3335         "Ошибка при обсчете партии" skip
     3336         "Документ партии " bf_tt-clcparts.out-code skip
     3337         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3338         return-value skip
     3339         error-status:get-message(1) skip
     3340         error-status:get-message(2) skip
     3341         error-status:get-message(3) skip
     3342         view-as alert-box error .
     3343       undo, return error .
     3344     end.
     3345     for each bf_tt-allsum on error undo, return error return-value :
     3346       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3347       if not available bf_tt-allsum-line then do:
     3348         create bf_tt-allsum-line.
     3349         assign
     3350           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3351       end.
     3352       assign
     3353         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3354         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3355         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3356         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3357         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3358         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3359         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3360         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3361         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3362         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3363         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3364         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3365         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3366         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3367         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3368         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3369         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3370         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3371         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3372         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3373         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3374         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3375         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3376         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3377         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3378         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3379         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3380         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3381         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3382         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3383         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3384         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3385         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3386         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3387         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3388         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3389         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3390         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3391         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3392         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3393         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3394         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3395         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3396         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3397         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3398         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3399         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3400         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3401         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3402         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3403         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3404         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3405         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3406         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3407         .
     3408     end.
     3409   end.
     3410   end.
     3411   end procedure.
     3412   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3413   procedure proc-alt-shift-f2:
     3414     if not ibs.th.gbl.gbl-var:rcode
     3415   then
     3416     run gbl\inidebug.p .
     3417   end.
     3418   procedure proc-alt-shift-f3:
     3419     run gbl/prvssinf.p
     3420       ( input this-procedure
     3421       ) .
     3422   end.
     3423   define variable v-inform-launched as logical no-undo initial false .
     3424   procedure proc-alt-shift-f4:
     3425     define variable v-action as character no-undo .
     3426     if v-inform-launched = false then do:
     3427       assign
     3428         v-inform-launched = true
     3429       .
     3430       run gbl/d-inform.w
     3431         (  input self
     3432         ,  input this-procedure
     3433         , output v-action
     3434         ) no-error .
     3435       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     3436       assign
     3437         v-inform-launched = false
     3438       .
     3439     end.
     3440   end.
     3441   procedure proc-alt-f1:
     3442     run gbl/corrhelp.p
     3443       (input this-procedure
     3444       ) .
     3445   end .
     3446   on alt-shift-f2 anywhere do:
     3447     run proc-alt-shift-f2.
     3448   end.
     3449   on alt-shift-f3 anywhere do:
     3450     run proc-alt-shift-f3 in this-procedure .
     3451   end.
     3452   on alt-shift-f4 anywhere do:
     3453     run proc-alt-shift-f4 in this-procedure.
     3454   end.
     3455   on alt-f1 anywhere do:
     3456     run proc-alt-f1 in this-procedure .
     3457   end.
     3458   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3459     define variable v-cntxt-db-num        as integer   no-undo .
