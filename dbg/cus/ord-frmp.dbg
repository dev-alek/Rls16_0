      362   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure cur-time :
      364      define output parameter p-today as date      no-undo .
      365      define output parameter p-time  as integer   no-undo .
      366     do
      367     on error undo, return error
      368     :
      369       define variable v-date1 as date      no-undo .
      370       define variable v-date2 as date      no-undo .
      371       define variable v-time  as integer   no-undo .
      372       assign
      373         v-date1 = today
      374         v-time  = time
      375         v-date2 = today
      376       .
      377       if v-date1 <> v-date2
      378       then do:
      379         assign
      380           v-date1 = today
      381           v-time  = v-time
      382         .
      383       end.
      384       assign
      385         p-today = v-date1
      386         p-time  = v-time
      387       .
      388     end.
      389   end.
      390   function cur-time-date returns character
      391   :
      392     return string(today, '99/99/9999':U) .
      393   end.
      394   function cur-time-mjd returns decimal
      395   :
      396     define variable v-date as date      no-undo .
      397     define variable v-time as integer   no-undo .
      398     run cur-time in this-procedure
      399       (output v-date
      400       ,output v-time
      401       ) .
      402     return integer(v-date) - 2400002 + (v-time / 86400) .
      403   end.
      404   function cur-time-get-ending-index returns integer
      405   (input p-number as integer
      406   )
      407   :
      408     if p-number < 0
      409     or p-number = ?
      410     then do:
      411       return 1 .
      412     end.
      413     define variable v-rest as integer   no-undo .
      414     assign
      415       p-number = p-number modulo 100
      416     .
      417     if p-number < 20
      418     then do:
      419       assign
      420         v-rest = p-number
      421       .
      422     end.
      423     else do:
      424       assign
      425         v-rest = p-number modulo 10
      426       .
      427     end.
      428     case v-rest :
      429       when 1
      430       then do:
      431         return 2 .
      432       end.
      433       when 2 or
      434       when 3 or
      435       when 4
      436       then do:
      437         return 3 .
      438       end.
      439       otherwise do:
      440         return 1 .
      441       end.
      442     end case .
      443   end.
      444   procedure cur-time-mjd-to-date :
      445      define input  parameter i-mjd-diff as decimal no-undo.
      446      define output parameter o-Date     as date    no-undo.
      447      define output parameter o-Time     as integer no-undo.
      448      define variable v-day-number as integer   no-undo .
      449      if    i-mjd-diff < 0
      450         or i-mjd-diff = ?
      451      then do:
      452         return "?" .
      453      end.
      454      assign
      455         v-day-number = truncate(i-mjd-diff,0).
      456         o-Date = date(v-day-number + 2400002).
      457         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      458     .
      459   end.
      460   function cur-time-mjd-to-string returns character
      461   (input p-mjd-diff as decimal
      462   )
      463   :
      464     define variable v-day-number as integer   no-undo .
      465     define variable v-seconds    as integer   no-undo .
      466     define variable v-hour       as integer   no-undo .
      467     define variable v-min        as integer   no-undo .
      468     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      469     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      470     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      471     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      472     if p-mjd-diff < 0
      473     or p-mjd-diff = ?
      474     then do:
      475       return "?" .
      476     end.
      477     assign
      478       v-day-number = integer(truncate(p-mjd-diff,0))
      479       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      480     .
      481     if v-seconds > 86400
      482     then do:
      483       assign
      484         v-seconds = 86400 - 1
      485       .
      486     end.
      487     if v-seconds < 0
      488     then do:
      489       assign
      490         v-seconds = 0
      491       .
      492     end.
      493     assign
      494       v-hour = truncate(v-seconds / 3600, 0)
      495     .
      496     assign
      497       v-seconds = v-seconds modulo 3600
      498     .
      499     assign
      500       v-min = truncate(v-seconds / 60, 0)
      501     .
      502     assign
      503       v-seconds = v-seconds modulo 60
      504     .
      505     return
      506         (if v-day-number <> 0
      507           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      508           else ""
      509         )
      510       + (if v-day-number <> 0 or v-hour <> 0
      511           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      512           else ""
      513         )
      514       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      515           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      516           else ""
      517         )
      518       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      519       .
      520   end.
      521   function cur-time-string returns character
      522   :
      523     define variable v-date as date      no-undo .
      524     define variable v-time as integer   no-undo .
      525     run cur-time in this-procedure
      526       (output v-date
      527       ,output v-time
      528       ) .
      529     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      530   end.
      531   function cur-time-string-sec returns character
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      540   end.
      541   function cur-time-custom  returns character
      542   (input p-prefix as character
      543   ,input p-date-format as character
      544   ,input p-delimiter as character
      545   ,input p-time-format as character
      546   ,input p-suffix as character
      547   )
      548   :
      549     define variable v-date as date      no-undo .
      550     define variable v-time as integer   no-undo .
      551     run cur-time in this-procedure
      552       (output v-date
      553       ,output v-time
      554       ) .
      555     return
      556       p-prefix
      557       + string(v-date, p-date-format)
      558       + p-delimiter
      559       + string(v-time, p-time-format)
      560       + p-suffix
      561       .
      562   end.
      563   function cur-time-print  returns character
      564   :
      565     define variable v-date as date      no-undo .
      566     define variable v-time as integer   no-undo .
      567     run cur-time in this-procedure
      568       (output v-date
      569       ,output v-time
      570       ) .
      571     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      572   end.
      573   function cur-time-datetime returns datetime
      574   :
      575     define variable v-char as character no-undo .
      576     define variable v-datetime as datetime no-undo .
      577     v-char = cur-time-string().
      578     v-datetime = datetime(v-char).
      579     return  v-datetime.
      580   end.
      581   function cur-time-string-msec returns character
      582   :
      583     define variable v-date as datetime  no-undo .
      584     v-date = now.
      585     return string(v-date) .
      586   end.
      587   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   procedure factord :
      589     define input  parameter p-fact-date            as date    no-undo .
      590     define input  parameter p-fact-time            as integer no-undo .
      591     define input  parameter p-fact-num             as integer no-undo .
      592     define input  parameter p-shift-date           as date    no-undo .
      593     define input  parameter p-shift-num            as integer no-undo .
      594     define input  parameter p-shift-on             as logical no-undo .
      595     define output parameter p-fact-order           as decimal no-undo .
      596     define output parameter p-shift-end-fact-order as decimal no-undo .
      597     define output parameter p-day-end-fact-order   as decimal no-undo .
      598     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      599     if p-fact-date = ?
      600     then do:
      601       return error "Не указана фактическая дата" .
      602     end.
      603     define variable v-fact-date-num as integer no-undo .
      604     assign
      605       v-fact-date-num = integer(p-fact-date)
      606     .
      607     if p-fact-num = ?
      608     or p-fact-num = 0
      609     then do:
      610       return error "Не задан p-fact-num " + string(p-fact-num) .
      611     end.
      612     if p-fact-num < 0
      613     then do:
      614       return error "Отрицательный fact-num " + string(p-fact-num) .
      615     end.
      616     if p-fact-num >= 100000000
      617     then do:
      618       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      619     end.
      620     if p-shift-on = true
      621     then do:
      622       if p-shift-date = ?
      623       then do:
      624         return error "Не задана дата смены" .
      625       end.
      626       if p-shift-num = ?
      627       or p-shift-num = 0
      628       then do:
      629         return error "Не задан номер смены" .
      630       end.
      631     end.
      632     else do:
      633       assign
      634         p-shift-date = p-fact-date
      635         p-shift-num  = 24
      636       .
      637     end.
      638     define variable v-shift-offset as integer no-undo .
      639     if p-shift-date = p-fact-date
      640     then do:
      641       assign
      642         v-shift-offset = 1
      643       .
      644     end.
      645     if p-shift-date < p-fact-date
      646     then do:
      647       assign
      648         v-shift-offset = 0
      649       .
      650     end.
      651     if p-shift-date > p-fact-date
      652     then do:
      653       message
      654         vss-workfile vss-revision vss-description skip
      655         "Неправильная дата закрытия смены" skip
      656         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      657         view-as alert-box error .
      658       undo, return error
      659         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      660           ,string(p-fact-date, '99/99/9999':U)
      661           ,string(p-shift-date, '99/99/9999':U)
      662           )
      663       .
      664     end.
      665     if p-shift-num < 1
      666     or p-shift-num > 24
      667     then do:
      668       message
      669         vss-workfile vss-revision vss-description skip
      670         "Неправильный номер смены" skip
      671         "p-shift-num" p-shift-num skip
      672         view-as alert-box error .
      673       undo, return error return-value .
      674     end.
      675     assign
      676       p-fact-order           = v-fact-date-num
      677                              + v-shift-offset * 0.5
      678                              + p-shift-num    * 0.02 - 0.01
      679                              + p-fact-num     * 0.0000000001
      680       p-shift-end-fact-order = v-fact-date-num
      681                              + v-shift-offset * 0.5
      682                              + p-shift-num    * 0.02
      683       p-day-end-fact-order   = v-fact-date-num
      684                              + 0.99
      685     .
      686     if p-fact-order           <= v-fact-date-num
      687     or p-shift-end-fact-order <= v-fact-date-num
      688     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      689     or p-shift-end-fact-order >= p-day-end-fact-order
      690     then do:
      691       message
      692         vss-workfile vss-revision vss-description skip
      693         "Внутренняя ошибка при генерации фактического номера" skip
      694         "p-fact-date"            p-fact-date            skip
      695         "p-fact-time"            p-fact-time            skip
      696         "p-fact-num"             p-fact-num             skip
      697         "p-shift-date"           p-shift-date           skip
      698         "p-shift-num"            p-shift-num            skip
      699         "p-shift-on"             p-shift-on             skip
      700         "p-shift-end-fact-order" p-shift-end-fact-order skip
      701         "p-day-end-fact-order"   p-day-end-fact-order   skip
      702         "v-fact-date-num"        v-fact-date-num        skip
      703         view-as alert-box error .
      704       undo, return error return-value .
      705     end.
      706   end procedure.
      707   procedure day-begin-fact-order :
      708     define input  parameter p-fact-date            as date    no-undo .
      709     define output parameter p-day-begin-fact-order as decimal no-undo .
      710     do
      711     on error undo, return error return-value
      712     :
      713       if p-fact-date = ?
      714       then do:
      715         assign
      716           p-day-begin-fact-order = 0
      717         .
      718       end.
      719       else do:
      720         assign
      721           p-day-begin-fact-order = integer(p-fact-date)
      722         .
      723       end.
      724     end.
      725   end procedure.
      726   procedure factord-max-fact-order :
      727     define output parameter p-max-fact-order as decimal   no-undo .
      728     do
      729     on error undo, return error return-value
      730     :
      731       run day-begin-fact-order in this-procedure
      732         (input  date(1, 1, 5000)
      733         ,output p-max-fact-order
      734         ) .
      735     end.
      736   end procedure.
      737   procedure factord-cut-archive :
      738     define input  parameter p-obj-type             as character no-undo .
      739     define input  parameter p-obj-code             as integer   no-undo .
      740     define input  parameter p-fact-date            as date      no-undo .
      741     define output parameter p-shift-on             as logical   no-undo .
      742     define output parameter p-shift-date           as date      no-undo .
      743     define output parameter p-shift-num            as integer   no-undo .
      744     define output parameter p-day-end-fact-order   as decimal   no-undo .
      745     define output parameter p-shift-end-fact-order as decimal   no-undo .
      746     define variable v-fact-order as decimal   no-undo .
      747     define buffer buf_shift-obj for ub.shift-obj .
      748     do
      749     on error undo, return error return-value
      750     :
      751   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      753     (input  p-obj-type
      754     ,input  p-obj-code
      755     ,input  'shift-on=request'
      756     ,output p-shift-on
      757     ) no-error .
      758       if error-status :error
      759       then do:
      760         message
      761           vss-workfile vss-revision vss-description skip
      762           "Ошибка при определении атрибута объекта" skip
      763           "Объект" p-obj-type p-obj-code skip
      764           error-status :get-message(1) skip
      765           return-value skip
      766           view-as alert-box error .
      767         undo, return error return-value .
      768       end.
      769       if p-shift-on = false
      770       then do:
      771         assign
      772           p-shift-date               = ?
      773           p-shift-num                = 0
      774         .
      775       end.
      776       else do:
      777         find first buf_shift-obj share-lock
      778           where buf_shift-obj.obj-type   = p-obj-type
      779             and buf_shift-obj.obj-code   = p-obj-code
      780             and buf_shift-obj.shift-date > p-fact-date
      781           use-index pi
      782           no-error .
      783         if not available buf_shift-obj
      784         or buf_shift-obj.status_ <> 'зкр':U
      785         then do:
      786           message
      787             vss-workfile vss-revision vss-description skip
      788             "Невозможно вычислить последнюю смену" skip
      789             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      790             "Объект" p-obj-type p-obj-code skip
      791             "Дата" p-fact-date skip
      792             view-as alert-box error .
      793           undo, return error return-value .
      794         end.
      795         find last buf_shift-obj share-lock
      796           where buf_shift-obj.obj-type = p-obj-type
      797             and buf_shift-obj.obj-code = p-obj-code
      798             and buf_shift-obj.shift-date <= p-fact-date
      799           use-index pi
      800           no-error .
      801         if available buf_shift-obj
      802         then do:
      803           if  buf_shift-obj.status_ = 'зкр':U
      804           then do:
      805             assign
      806               p-shift-date = buf_shift-obj.shift-date
      807               p-shift-num  = buf_shift-obj.shift-num
      808             .
      809           end.
      810           else do:
      811             message
      812               vss-workfile vss-revision vss-description skip
      813               "Невозможно вычислить последнюю смену" skip
      814               "Статус смены отличен от статуса" 'зкр':U skip
      815               "Объект" p-obj-type p-obj-code skip
      816               "Дата" p-fact-date skip
      817               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      818               view-as alert-box error .
      819             undo, return error return-value .
      820           end.
      821         end.
      822         else do:
      823           assign
      824             p-shift-date = p-fact-date - 1
      825             p-shift-num  = 1
      826           .
      827         end.
      828       end.
      829       run factord in this-procedure
      830         (input  p-fact-date
      831         ,input  1
      832         ,input  1
      833         ,input  p-shift-date
      834         ,input  p-shift-num
      835         ,input  p-shift-on
      836         ,output v-fact-order
      837         ,output p-shift-end-fact-order
      838         ,output p-day-end-fact-order
      839         ) no-error .
      840       if error-status :error
      841       then do:
      842         message
      843           vss-workfile vss-revision vss-description skip
      844           "Ошибка при вызове процедуры factord"
      845           error-status :get-message(1) skip
      846           return-value skip
      847           view-as alert-box error .
      848         undo, return error return-value .
      849       end.
      850     end.
      851   end procedure.
      852   procedure factord-lock-shift :
      853     define input  parameter p-obj-type  as character no-undo .
      854     define input  parameter p-obj-code  as integer   no-undo .
      855     define input  parameter p-fact-date as date      no-undo .
      856     define parameter buffer buf_shift-obj for ub.shift-obj .
      857     define variable v-shift-on      as logical   no-undo .
      858     define variable v-extra-message as character no-undo .
      859     define variable v-error as character no-undo .
      860     do
      861     on error undo, return error return-value
      862     :
      863   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      865     (input  p-obj-type
      866     ,input  p-obj-code
      867     ,input  'shift-on=request'
      868     ,output v-shift-on
      869     ) no-error .
      870       if error-status :error
      871       then do:
      872         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      873         undo, return error v-error .
      874       end.
      875       if v-shift-on = true
      876       then do:
      877         find first buf_shift-obj share-lock
      878           where buf_shift-obj.obj-type   = p-obj-type
      879             and buf_shift-obj.obj-code   = p-obj-code
      880             and buf_shift-obj.shift-date > p-fact-date
      881           use-index pi
      882           no-error .
      883         if not available buf_shift-obj
      884         or buf_shift-obj.status_ <> 'зкр':U
      885         then do:
      886           find last buf_shift-obj
      887             where buf_shift-obj.obj-type = p-obj-type
      888               and buf_shift-obj.obj-code = p-obj-code
      889               and buf_shift-obj.status_  = 'зкр':U
      890             use-index stts
      891             no-error .
      892           if available buf_shift-obj
      893           then do:
      894             assign
      895               v-extra-message =
      896                     substitute("Дата начала последеней закрытой смены на объекте &1"
      897                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      898                               )
      899             .
      900           end.
      901           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      902           undo, return error v-error .
      903         end.
      904       end.
      905     end.
      906   end procedure.
      907   procedure factord-end-day :
      908     define input  parameter p-fact-date            as date    no-undo .
      909     define output parameter p-day-end-fact-order   as decimal no-undo .
      910     do
      911     on error undo, return error return-value
      912     :
      913       if p-fact-date = ?
      914       then do:
      915         return error "Не указана фактическая дата" .
      916       end.
      917       assign
      918         p-day-end-fact-order = integer(p-fact-date) + 0.99
      919       .
      920     end.
      921   end procedure.
      922   procedure factord-to-date :
      923     define input  parameter p-fact-order as decimal no-undo .
      924     define output parameter p-fact-date  as date    no-undo .
      925     define variable v-ref-date  as date      no-undo .
      926     define variable v-ref-delta as integer   no-undo .
      927     do
      928     on error undo, return error return-value
      929     :
      930       if p-fact-order = ?
      931       or p-fact-order = 0
      932       then do:
      933         return error "Не указан fact-order" .
      934       end.
      935       assign
      936         v-ref-date  = date(1, 1, 2000)
      937       .
      938       assign
      939         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      940       .
      941       assign
      942         p-fact-date = v-ref-date + v-ref-delta
      943       .
      944     end.
      945   end procedure.
      946   procedure factord-to-fact-num :
      947     define input  parameter p-fact-order as decimal no-undo .
      948     define output parameter p-fact-num   as integer no-undo .
      949     define variable v-fact-order-trunc as decimal no-undo .
      950     do
      951     on error undo, return error return-value
      952     :
      953       if p-fact-order = ?
      954       or p-fact-order = 0
      955       then do:
      956         return error "Не указан fact-order" .
      957       end.
      958       assign
      959        v-fact-order-trunc = truncate(p-fact-order, 2)
      960       .
      961       assign
      962         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      963       .
      964     end.
      965   end procedure.
      966   procedure factord-to-shift-num :
      967     define input  parameter p-fact-order as decimal no-undo .
      968     define output parameter p-shift-num   as integer no-undo .
      969     define variable  p-shift-numd  as decimal   no-undo .
      970     define variable v-fact-order-trunc as decimal no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974       if p-fact-order = ?
      975       or p-fact-order = 0
      976       then do:
      977         return error "Не указан fact-order" .
      978       end.
      979       assign
      980        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      981       .
      982       if v-fact-order-trunc < 0.5 then do:
      983         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      984       end.
      985       assign
      986         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      987         .
      988        assign
      989         p-shift-num = truncate (p-shift-numd , 0)
      990       .
      991     end.
      992   end procedure.
      993   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   procedure fact-order-mpl :
      997     do
      998     on error undo, return error return-value
      999     :
     1000   define input  parameter p-doc-date as date     no-undo .
     1001   define input  parameter p-obj-type as character no-undo .
     1002   define input  parameter p-obj-code as integer   no-undo .
     1003   define output parameter p-fact-order as decimal   no-undo .
     1004   define variable v-fact-date            as date    no-undo .
     1005   define variable v-fact-time            as integer no-undo .
     1006   define variable v-fact-order           as decimal no-undo .
     1007   define variable v-shift-end-fact-order as decimal no-undo .
     1008   define variable v-day-end-fact-order   as decimal no-undo .
     1009   define variable l-shift-on as logical no-undo .
     1010   define variable l-date as date      no-undo .
     1011   define variable l-time as integer   no-undo .
     1012   define variable shift-date as date      no-undo .
     1013   define variable shift-num  as integer   no-undo .
     1014   define variable shift-name as character no-undo .
     1015   define variable max-fact-order as decimal   no-undo .
     1016   define buffer buf_global-state for ub.global-state  .
     1017   find first buf_global-state no-lock no-error .
     1018   if not available buf_global-state then do:
     1019      message
     1020        "Не заданы параметры ценообразования!"
     1021        view-as alert-box error
     1022      .
     1023      return error return-value .
     1024   end.
     1025     run cur-time in this-procedure
     1026     ( output v-fact-date ,
     1027       output v-fact-time  ).
     1028   if p-doc-date = ? then do:
     1029   if buf_global-state.pl-use-sys-date-time  = true then do:
     1030         run factord in this-procedure
     1031           (input  v-fact-date
     1032           ,input  v-fact-time
     1033           ,input  v-fact-time
     1034           ,input  ?
     1035           ,input  ?
     1036           ,input  false
     1037           ,output v-fact-order
     1038           ,output v-shift-end-fact-order
     1039           ,output v-day-end-fact-order
     1040           ) no-error .
     1041         if error-status :error
     1042         or v-fact-order = ?
     1043         or v-fact-order = 0 then do:
     1044           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1045         end.
     1046         p-fact-order = v-fact-order .
     1047   end.
     1048   else do:
     1049   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1051     (input  p-obj-type
     1052     ,input  p-obj-code
     1053     ,input  'shift-on=request'
     1054     ,output l-shift-on
     1055     ) no-error .
     1056         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1057         if p-doc-date <> ? then do:
     1058         end.
     1059          run gbl/factdate.p
     1060          ( input        p-obj-type  ,
     1061            input        p-obj-code  ,
     1062            input-output v-fact-date ,
     1063            input-output v-fact-time ,
     1064            input-output shift-date      ,
     1065            input-output shift-num       ,
     1066            input-output shift-name      ,
     1067            input        yes
     1068            ) no-error .
     1069         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1070         run factord in this-procedure
     1071           (input  v-fact-date
     1072           ,input  v-fact-time
     1073           ,input  v-fact-time
     1074           ,input  shift-date
     1075           ,input  shift-num
     1076           ,input  l-shift-on
     1077           ,output v-fact-order
     1078           ,output v-shift-end-fact-order
     1079           ,output v-day-end-fact-order
     1080           ) no-error .
     1081         if error-status :error
     1082         or v-fact-order = ?
     1083         or v-fact-order = 0 then do:
     1084           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1085         end.
     1086         p-fact-order = v-fact-order .
     1087   end.
     1088   end.
     1089   else do:
     1090          run gbl/factdate.p
     1091          ( input        p-obj-type  ,
     1092            input        p-obj-code  ,
     1093            input-output v-fact-date ,
     1094            input-output v-fact-time ,
     1095            input-output shift-date      ,
     1096            input-output shift-num       ,
     1097            input-output shift-name      ,
     1098            input        yes
     1099            ) no-error .
     1100         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1101         v-fact-date = p-doc-date .
     1102         run factord in this-procedure
     1103           (input  v-fact-date
     1104           ,input  v-fact-time
     1105           ,input  v-fact-time
     1106           ,input  shift-date
     1107           ,input  shift-num
     1108           ,input  l-shift-on
     1109           ,output v-fact-order
     1110           ,output v-shift-end-fact-order
     1111           ,output v-day-end-fact-order
     1112           ) no-error .
     1113         if error-status :error
     1114         or v-fact-order = ?
     1115         or v-fact-order = 0 then do:
     1116           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1117         end.
     1118         p-fact-order = v-fact-order .
     1119   end.
     1120     end.
     1121   end procedure.
     1122   define variable p-curr-code   as integer no-undo .
     1123   define variable p-curr-date   as date no-undo .
     1124   define variable p-exch-rate   as decimal no-undo .
     1125   define variable p-exch-scale  as decimal no-undo .
     1126   define variable p-curr-abbr   as character no-undo .
     1127   define variable g#host-name  as character no-undo .
     1128   define variable g#host-code  as integer   no-undo .
     1129   define variable store-type   as character no-undo .
     1130   define variable store-code   as integer   no-undo .
     1131   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132     run mainmenu_getcntxt in parparentproc
     1133       (output v-cntxt-db-num
     1134       ,output v-cntxt-userid
     1135       ,output v-cntxt-level
     1136       ,output v-cntxt-host-code-obj
     1137       ,output v-cntxt-obj-type
     1138       ,output v-cntxt-obj-code
     1139       ,output v-cntxt-db-num-obj
     1140       ,output v-cntxt-is-admin
     1141       ) .
     1142   assign
     1143     store-type     = v-cntxt-obj-type
     1144     store-code     = v-cntxt-obj-code
     1145     loc-store-type = v-cntxt-obj-type
     1146     loc-store-code = v-cntxt-obj-code
     1147   .
     1148   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1150     (input  store-type
     1151     ,input  store-code
     1152     ,output g#host-code
     1153     ,output g#host-name
     1154     )  .
     1155   DEFINE BUTTON b-exit-cycl AUTO-GO
     1156        LABEL "Стоп&Цикл"
     1157        SIZE 11 BY 1.
     1158   DEFINE BUTTON B-help DEFAULT
     1159        LABEL "Помо&щь"
     1160        SIZE 10 BY 1
     1161        BGCOLOR 8 .
     1162   DEFINE BUTTON b-quit AUTO-END-KEY
     1163        LABEL "&Отмена"
     1164        SIZE 10 BY 1.
     1165   DEFINE BUTTON b-save AUTO-GO
     1166        LABEL "Со&хранить"
     1167        SIZE 11 BY 1.
     1168   DEFINE BUTTON r-price
     1169        IMAGE-UP FILE "btn-down-arrow":U
     1170        IMAGE-DOWN FILE "btn-down-arrow":U
     1171        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1172        LABEL ""
     1173        SIZE 3 BY 1 TOOLTIP "Выбор цены".
     1174   DEFINE VARIABLE scr-artic AS CHARACTER FORMAT "X(16)"
     1175        LABEL "Артикул"
     1176         VIEW-AS TEXT
     1177        SIZE 17 BY .67.
     1178   DEFINE VARIABLE scr-cli-qnty AS DECIMAL FORMAT ">,>>>,>>9.999" INITIAL 0
     1179        LABEL "Количество"
     1180         VIEW-AS TEXT
     1181        SIZE 13 BY .67 TOOLTIP "В ед.изм.поставщика".
     1182   DEFINE VARIABLE scr-gds-name AS CHARACTER FORMAT "X(256)":U
     1183         VIEW-AS TEXT
     1184        SIZE 51.13 BY .67
     1185        FGCOLOR 4  NO-UNDO.
     1186   DEFINE VARIABLE scr-price-base AS DECIMAL FORMAT ">,>>>,>>9.99" INITIAL 0
     1187        LABEL "Цена (вал)"
     1188        VIEW-AS FILL-IN
     1189        SIZE 23.25 BY 1.
     1190   DEFINE VARIABLE scr-price-rubl AS DECIMAL FORMAT ">,>>>,>>9.99" INITIAL 0
     1191        LABEL "Цена (abbr_rub)"
     1192        VIEW-AS FILL-IN
     1193        SIZE 23 BY 1.
     1194   DEFINE VARIABLE scr-prod-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
     1195        LABEL "Производитель"
     1196         VIEW-AS TEXT
     1197        SIZE 10 BY .67.
     1198   DEFINE VARIABLE scr-prod-name AS CHARACTER FORMAT "X(256)":U
     1199         VIEW-AS TEXT
     1200        SIZE 51.13 BY .67
     1201        FGCOLOR 4  NO-UNDO.
     1202   DEFINE VARIABLE scr-prod-type AS CHARACTER FORMAT "X(3)"
     1203         VIEW-AS TEXT
     1204        SIZE 4.88 BY .67.
     1205   DEFINE VARIABLE scr-qnty AS DECIMAL FORMAT ">,>>>,>>9.999" INITIAL 0
     1206        LABEL "Количество"
     1207        VIEW-AS FILL-IN
     1208        SIZE 13 BY 1.
     1209   DEFINE VARIABLE scr-sum-base AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1210        LABEL "Сумма (баз.в.)"
     1211         VIEW-AS TEXT
     1212        SIZE 22 BY .67
     1213        FGCOLOR 4 .
     1214   DEFINE VARIABLE scr-sum-rubl AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1215        LABEL "Сумма в abbr_rub"
     1216         VIEW-AS TEXT
     1217        SIZE 22 BY .67
     1218        FGCOLOR 4 .
     1219   DEFINE VARIABLE scr-unit-base AS CHARACTER FORMAT "X(3)"
     1220         VIEW-AS TEXT
     1221        SIZE 4 BY .67
     1222        FGCOLOR 4 .
     1223   DEFINE VARIABLE scr-unit-cli AS CHARACTER FORMAT "X(3)"
     1224         VIEW-AS TEXT
     1225        SIZE 4 BY .67
     1226        FGCOLOR 4 .
     1227   DEFINE VARIABLE scr-val AS CHARACTER FORMAT "XXX":U
     1228         VIEW-AS TEXT
     1229        SIZE 4.75 BY 1
     1230        FGCOLOR 4  NO-UNDO.
     1231   DEFINE VARIABLE v-cli-base-rate AS DECIMAL FORMAT ">>,>>9.<<<":U INITIAL 0
     1232         VIEW-AS TEXT
     1233        SIZE 14 BY .67 TOOLTIP "Коэффициент пересчета баз.ед.изм. в ед.изм.поставщика"
     1234        FGCOLOR 1  NO-UNDO.
     1235   DEFINE QUERY Dialog-Frame FOR
     1236         ub.ord-line SCROLLING.
     1237   DEFINE FRAME Dialog-Frame
     1238        b-save AT ROW 1 COL 1
     1239        b-quit AT ROW 1 COL 12
     1240        b-exit-cycl AT ROW 1 COL 22
     1241        B-help AT ROW 1 COL 78.38
     1242        scr-qnty AT ROW 5.38 COL 17.38 COLON-ALIGNED
     1243        scr-price-rubl AT ROW 8 COL 17.5 COLON-ALIGNED
     1244        r-price AT ROW 8 COL 43.5
     1245        scr-price-base AT ROW 9 COL 17.5 COLON-ALIGNED
     1246        scr-artic AT ROW 2.79 COL 17.38 COLON-ALIGNED
     1247        scr-gds-name AT ROW 2.79 COL 36 COLON-ALIGNED NO-LABEL
     1248        scr-prod-code AT ROW 3.83 COL 17.38 COLON-ALIGNED
     1249        scr-prod-type AT ROW 3.88 COL 29 COLON-ALIGNED NO-LABEL
     1250        scr-prod-name AT ROW 3.92 COL 35.75 COLON-ALIGNED NO-LABEL
     1251        scr-unit-base AT ROW 5.54 COL 30.75 COLON-ALIGNED NO-LABEL
     1252        v-cli-base-rate AT ROW 5.75 COL 37.5 COLON-ALIGNED NO-LABEL
     1253        scr-unit-cli AT ROW 6.63 COL 30.75 COLON-ALIGNED NO-LABEL
     1254        scr-cli-qnty AT ROW 6.67 COL 17.38 COLON-ALIGNED
     1255        scr-sum-rubl AT ROW 8 COL 64.5 COLON-ALIGNED
     1256        scr-val AT ROW 9 COL 2 NO-LABEL
     1257        scr-sum-base AT ROW 9 COL 64.5 COLON-ALIGNED
     1258        SPACE(1.12) SKIP(6.07)
     1259       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1260            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1261            TITLE "<insert dialog title>".
     1262   ASSIGN
     1263          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1264          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1265   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1266   DO:
     1267     APPLY "END-ERROR":U TO SELF.
     1268   END.
     1269   ON CHOOSE OF b-exit-cycl IN FRAME Dialog-Frame
     1270   DO:
     1271      assign
     1272        stp-cycle  =  true
     1273        stp-exit  =  false.
     1274        .
     1275   END.
     1276   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1277   DO:
     1278   if p-line-mode = 'ПРОСМОТР':U then do:
     1279       stp-cycle  =  false.
     1280       stp-exit  =  true .
     1281       return.
     1282   end.
     1283   define variable compare-log as logical no-undo .
     1284   if p-line-mode <> "ЦИКЛ":u   then do:
     1285       if compare-log = false then do:
     1286           message "Вы действительно хотите выйти без сохранения изменений ?" view-as alert-box question
     1287                   buttons yes-no   update jjj as logical .
     1288                   if jjj = true then
     1289       end.
     1290   end.
     1291       stp-cycle  =  false.
     1292       stp-exit  =  true .
     1293       return "error".
     1294   END.
     1295   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1296   DO:
     1297       stp-cycle  =  false.
     1298       stp-exit   =  false.
     1299       assign frame Dialog-Frame scr-qnty .
     1300       if scr-price-rubl:SENSITIVE then  assign frame Dialog-Frame scr-price-rubl .
     1301       if scr-price-base:SENSITIVE then  assign frame Dialog-Frame scr-price-base .
     1302       assign
     1303         shar_ord-line.qnty       = scr-qnty
     1304         shar_ord-line.cli-qnty   = scr-qnty
     1305         shar_ord-line.cli-base-rate   = 1
     1306         shar_ord-line.price-rubl = scr-price-rubl
     1307         shar_ord-line.price-base = scr-price-base
     1308         shar_ord-line.price-cli  = scr-price-rubl
     1309         shar_ord-line.sum-rubl = shar_ord-line.price-rubl * shar_ord-line.qnty
     1310         shar_ord-line.sum-base = shar_ord-line.price-base * shar_ord-line.qnty
     1311         shar_ord-line.sum-cli  = shar_ord-line.price-cli  * shar_ord-line.qnty
     1312       .
     1313   END.
     1314   ON CHOOSE OF r-price IN FRAME Dialog-Frame
     1315   DO:
     1316     run ch-price in this-procedure no-error .
     1317     if error-status :error then message
     1318       vss-workfile vss-revision vss-description skip
     1319       error-status :get-message(1) skip
     1320       return-value skip
     1321       "Ошибка !!!"
     1322       view-as alert-box error
     1323     .
     1324   END.
     1325   ON LEAVE OF scr-price-base IN FRAME Dialog-Frame
     1326   DO:
     1327   if scr-price-base:modified = false then return .
     1328    assign  frame Dialog-Frame scr-price-base .
     1329       scr-price-rubl = scr-price-base * ( p-exch-rate  / p-exch-scale )     .
     1330       scr-sum-rubl =  scr-price-rubl * scr-qnty .
     1331       scr-sum-base =  scr-price-base  * scr-qnty .
     1332       display scr-price-rubl  scr-sum-base scr-sum-rubl with frame Dialog-Frame .
     1333   END.
     1334   ON return OF scr-price-base IN FRAME Dialog-Frame
     1335   DO:
     1336       run next-focus in this-procedure  (input  scr-price-base:handle ) .
     1337     return no-apply .
     1338   END.
     1339   ON LEAVE OF scr-price-rubl IN FRAME Dialog-Frame
     1340   DO:
     1341      if scr-price-rubl:modified = false then return .
     1342       assign  frame Dialog-Frame  scr-price-rubl.
     1343       scr-price-base = scr-price-rubl / ( p-exch-rate  * p-exch-scale )     .
     1344       scr-sum-rubl =  scr-price-rubl * scr-qnty .
     1345       scr-sum-base =  scr-price-base  * scr-qnty .
     1346       display scr-price-base  scr-sum-base scr-sum-rubl with frame Dialog-Frame .
     1347   END.
     1348   ON return OF scr-price-rubl IN FRAME Dialog-Frame
     1349   DO:
     1350       run next-focus in this-procedure  (input  scr-price-rubl:handle ) .
     1351     return no-apply .
     1352   END.
     1353   ON LEAVE OF scr-qnty IN FRAME Dialog-Frame
     1354   DO:
     1355     assign frame Dialog-Frame scr-qnty .
     1356    IF CAN-FIND ( FIRST ub.units WHERE ub.units.unit-name = scr-unit-base
     1357                       and LOOKUP('шту':U, ub.units.type) > 0   AND
     1358                          TRUNC(scr-qnty, 0)   <>    scr-qnty         )
     1359      THEN DO:
     1360         MESSAGE "Базовая единица товара " scr-unit-base " - штучная." skip
     1361                 "Кол-во  должно быть целым."
     1362         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1363         RETURN no-apply.
     1364     END.
     1365       scr-sum-rubl =  scr-price-rubl * scr-qnty .
     1366       scr-sum-base =  scr-price-base * scr-qnty .
     1367       scr-cli-qnty =  scr-qnty / v-cli-base-rate .
     1368    IF CAN-FIND ( FIRST ub.units WHERE ub.units.unit-name = scr-unit-cli
     1369                       and LOOKUP('шту':U, ub.units.type) > 0   AND
     1370                          TRUNC(scr-cli-qnty, 0)   <>    scr-cli-qnty         )
     1371      THEN DO:
     1372         MESSAGE
     1373                 "Единица товара поставщика" scr-unit-cli " - штучная." skip
     1374                 "Получается не полная единица измерения поставщика !!!."
     1375         view-as alert-box information
     1376         title "внимание".
     1377     END.
     1378       display  scr-cli-qnty  scr-sum-base scr-sum-rubl with frame Dialog-Frame .
     1379   END.
     1380   ON return OF scr-qnty IN FRAME Dialog-Frame
     1381   DO:
     1382       run next-focus in this-procedure  (input  scr-qnty:handle ) .
     1383     return no-apply .
     1384   END.
     1385   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1386   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1387   assign
     1388     scr-price-rubl :label = "Цена (руб)"
     1389     scr-sum-rubl   :label = "Сумма в руб"
     1390   .
     1391   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1392   on help of frame Dialog-Frame
     1393   do:
     1394     run gbl/app_help.p
     1395       (input this-procedure :file-name
     1396       ,input ''
     1397       ,input ?
     1398       ) no-error.
     1399     if error-status :error then do:
     1400       message
     1401         "Ошибка при вызове помощи"
     1402         error-status :get-message(1)
     1403         view-as alert-box .
     1404     end.
     1405   end.
     1406   run minbtn-set in this-procedure .
     1407   on choose of b-help in frame Dialog-Frame
     1408   do:
     1409     apply "help":u to frame Dialog-Frame .
     1410   end.
     1411   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1412   procedure minbtn-set :
     1413       do
     1414           on error undo, return error return-value
     1415           :
     1416           define variable ii              as integer       no-undo .
     1417           define variable fh              as widget-handle no-undo .
     1418           define variable hh              as widget-handle no-undo .
     1419           define variable v-h             as handle        extent 4 no-undo .
     1420           define variable v-name-button   as character     no-undo .
     1421           define variable v-help-old-x    as decimal       no-undo .
     1422           define variable v-help-old-y    as decimal       no-undo .
     1423           define variable v-help-old-size as decimal       no-undo .
     1424           define variable v-frame-width   as decimal       no-undo .
     1425           define variable jj              as integer       no-undo .
     1426           do
     1427               on error undo, return error
     1428               :
     1429               assign
     1430                   v-frame-width = frame Dialog-Frame:width - 0.3
     1431                   fh            = frame Dialog-Frame:first-child
     1432                   hh            = fh:first-child
     1433                   ii            = 1
     1434                   .
     1435               do while valid-handle(hh):
     1436                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1437                   do:
     1438                       case lc(hh:name) :
     1439                           when "b-help" then
     1440                               do:
     1441                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1442                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1443                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1444                                   hh:TOOLTIP = "Помощь" .
     1445                                   v-help-old-x = hh:column .
     1446                                   v-help-old-y = hh:row    .
     1447                                   v-help-old-size = hh:width .
     1448                                   hh:width-chars = 2.5 .
     1449                               end.
     1450                           when "b-print" then
     1451                               do:
     1452                                   hh:load-image("cmp/b-print.bmp":u) .
     1453                                   hh:TOOLTIP = "Печать" .
     1454                                   v-h[ii] = hh:handle .
     1455                                   ii = ii + 1 .
     1456                                   hh:width-chars = 3 .
     1457                               end.
     1458                           when "b-history" or
     1459                           when "b-hist" then
     1460                               do:
     1461                                   hh:load-image("cmp/b-hist.bmp":u) .
     1462                                   hh:TOOLTIP = "История" .
     1463                                   v-h[ii] = hh:handle .
     1464                                   ii = ii + 1 .
     1465                                   hh:width-chars = 3 .
     1466                               end.
     1467                           when "b-sch" then
     1468                               do:
     1469                                   hh:load-image("cmp/b-sch.bmp":u) .
     1470                                   hh:TOOLTIP = "Установка Фильтра" .
     1471                                   v-h[ii] = hh:handle .
     1472                                   ii = ii + 1 .
     1473                                   hh:width-chars = 3 .
     1474                               end.
     1475                           when "b-hist-user" then
     1476                               do:
     1477                                   hh:load-image("cmp/b-hist.bmp":u) .
     1478                                   hh:TOOLTIP = "История пользователя" .
     1479                                   ii = ii + 1 .
     1480                               end.
     1481                       end case.
     1482                   end.
     1483                   hh = hh:next-sibling.
     1484               end.
     1485               b-help:column = v-frame-width - b-help:width-chars.
     1486               jj = 0.
     1487               repeat ii = 4 to 1 by -1 :
     1488                   if valid-handle (v-h[ii] ) then
     1489                   do:
     1490                       jj  = jj + 1 .
     1491                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1492                       v-h[ii]:row    = v-help-old-y .
     1493                   end.
     1494               end.
     1495           end.
     1496       end.
     1497   end procedure.
     1498   MAIN-BLOCK:
     1499   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1500      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1501   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1503     (input  g#host-code
     1504     ,output p-curr-code
     1505     )  .
     1506   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1508     (input  p-curr-code
     1509     ,input  p-curr-date
     1510     ,output p-exch-rate
     1511     ,output p-exch-scale
     1512     ,output p-curr-abbr
     1513     )  .
     1514       run init-proc.
     1515       if p-line-mode = 'ПРОСМОТР':U then run lkp-enable.
     1516                                  else RUN my-enable.
     1517   END.
     1518   RUN disable_UI.
     1519   PROCEDURE ch-price :
     1520   define variable v-cli-type    as character no-undo .
     1521   define variable v-cli-code    as integer   no-undo .
     1522   define variable v-main-b-code as integer   no-undo .
     1523   define variable v-b-code      as integer   no-undo .
     1524   define variable v-obj-type    as character no-undo .
     1525   define variable v-obj-code    as integer   no-undo .
     1526   define variable v-qnty-doc    as decimal   no-undo .
     1527   define variable v-sum-doc     as decimal   no-undo .
     1528   define variable v-fact-order  as decimal   no-undo .
     1529   define variable v-plt-id      as integer   no-undo .
     1530   define variable v-plt-db-num  as integer   no-undo .
     1531   define variable v-pdf-id      as integer   no-undo .
     1532   define variable v-pdf-db-num  as integer   no-undo .
     1533   define variable v-sale-price-base as decimal   no-undo .
     1534   define variable v-sale-price-rubl as decimal   no-undo .
     1535   define variable v-pay-code as character no-undo .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1540     (input  shar_ord-line.gds-code
     1541     ,input  ?
     1542     ,output v-main-b-code
     1543     )  .
     1544   run fact-order-mpl  in this-procedure (
     1545       input doc-date ,
     1546       input loc-store-type ,
     1547       input loc-store-code ,
     1548       output v-fact-order) .
     1549   assign
     1550     v-pay-code  = string(paytype)
     1551     v-cli-type  = loc-cli-type
     1552     v-cli-code  = loc-cli-code
     1553     v-b-code    = v-main-b-code
     1554     v-obj-type  = loc-store-type
     1555     v-obj-code  = loc-store-code
     1556     .
     1557   v-sum-doc       = 0 .
     1558   define buffer buf_loc_ord-line for ub.ord-line  .
     1559   for each buf_loc_ord-line no-lock where
     1560            buf_loc_ord-line.doc-code = shar_ord-line.doc-code :
     1561     if
     1562     not
     1563     ( buf_loc_ord-line.prod-code = shar_ord-line.prod-code and
     1564       buf_loc_ord-line.prod-type = shar_ord-line.prod-type and
     1565       buf_loc_ord-line.artic     = shar_ord-line.artic      )
     1566      then
     1567      v-sum-doc = v-sum-doc + ( buf_loc_ord-line.fact-qnty * buf_loc_ord-line.price-rubl ) .
     1568   end.
     1569       run str/chmpldoc.w
     1570           (input parparentproc
     1571           ,input  v-cli-type
     1572           ,input  v-cli-code
     1573           ,input  v-main-b-code
     1574           ,input  v-b-code
     1575           ,input  v-obj-type
     1576           ,input  v-obj-code
     1577           ,input  v-qnty-doc
     1578           ,input  v-sum-doc
     1579           ,input  v-pay-code
     1580           ,input  ""
     1581           ,input  v-fact-order
     1582           ,output v-plt-id
     1583           ,output v-plt-db-num
     1584           ,output v-pdf-id
     1585           ,output v-pdf-db-num
     1586           ,output v-sale-price-base
     1587           ,output v-sale-price-rubl
     1588           ).
     1589    if v-plt-id = ? then return.
     1590    if scr-price-rubl:visible in frame Dialog-Frame and scr-price-rubl:SENSITIVE then do:
     1591       scr-price-rubl = v-sale-price-rubl .
     1592       display scr-price-rubl with frame Dialog-Frame .
     1593       apply "leave" to scr-price-rubl in frame Dialog-Frame.
     1594    end.
     1595    else do:
     1596       if scr-price-base:visible and  scr-price-base:SENSITIVE then do:
     1597           scr-price-base = v-sale-price-base .
     1598           display scr-price-base with frame Dialog-Frame .
     1599           apply "leave" to scr-price-base in frame Dialog-Frame.
     1600       end.
     1601     end.
     1602   end.
     1603   END PROCEDURE.
     1604   PROCEDURE disable_UI :
     1605     HIDE FRAME Dialog-Frame.
     1606   END PROCEDURE.
     1607   PROCEDURE enable_UI :
     1608     OPEN QUERY Dialog-Frame FOR EACH ub.ord-line SHARE-LOCK.
     1609     GET FIRST Dialog-Frame.
     1610     DISPLAY scr-qnty scr-price-rubl scr-price-base scr-artic scr-gds-name
     1611             scr-prod-code scr-prod-type scr-prod-name scr-unit-base
     1612             v-cli-base-rate scr-unit-cli scr-cli-qnty scr-sum-rubl scr-val
     1613             scr-sum-base
     1614         WITH FRAME Dialog-Frame.
     1615     ENABLE b-save b-quit b-exit-cycl B-help scr-qnty scr-price-rubl r-price
     1616            scr-price-base scr-artic scr-gds-name scr-prod-code scr-prod-type
     1617            scr-prod-name scr-unit-base scr-unit-cli scr-cli-qnty scr-sum-rubl
     1618            scr-val scr-sum-base
     1619         WITH FRAME Dialog-Frame.
     1620     VIEW FRAME Dialog-Frame.
     1621   END PROCEDURE.
     1622   PROCEDURE init-proc :
     1623    do
     1624    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1625    :
     1626     define buffer buf_goods for ub.goods.
     1627     define buffer buf_clients for ub.clients.
     1628     if p-line-mode = 'ПРОСМОТР':U then
     1629        find first shar_ord-line no-lock where recid(shar_ord-line) = par-ord no-error .
     1630     else
     1631        find first shar_ord-line  exclusive-lock  where recid(shar_ord-line) = par-ord no-error .
     1632             if error-status :error then do:
     1633             message vss-workfile vss-revision vss-description skip
     1634                   "Ошибка  " skip
     1635                     "p-line-mode" p-line-mode    skip
     1636                     "par-ord" par-ord  skip
     1637                     error-status :get-message(1) skip
     1638                     return-value skip
     1639                     view-as alert-box error
     1640             .
     1641             return error .
     1642             end.
     1643      ASSIGN frame Dialog-Frame:TITLE = "Строка заказа  № " + shar_ord-line.doc-code  + " - " + caps(p-line-mode).
     1644     find first buf_goods no-lock  WHERE
     1645               buf_goods.artic     = shar_ord-line.artic      and
     1646               buf_goods.prod-code = shar_ord-line.prod-code  and
     1647               buf_goods.prod-type = shar_ord-line.prod-type no-error .
     1648             if error-status :error then do:
     1649                return error .
     1650             end.
     1651     find first buf_clients no-lock  WHERE
     1652               buf_clients.obj-code = shar_ord-line.prod-code  and
     1653               buf_clients.obj-type = shar_ord-line.prod-type no-error .
     1654             if error-status :error then do:
     1655                return error .
     1656             end.
     1657          assign
     1658             scr-qnty       = shar_ord-line.qnty
     1659             scr-price-rubl = shar_ord-line.price-rubl
     1660             scr-price-base = shar_ord-line.price-base
     1661             scr-artic      = shar_ord-line.artic
     1662             scr-gds-name   = buf_goods.gds-name
     1663             scr-prod-code  = shar_ord-line.prod-code
     1664             scr-prod-type  = shar_ord-line.prod-type
     1665             scr-prod-name  = buf_clients.obj-name
     1666             scr-unit-base  = buf_goods.unit-base
     1667             scr-val        = p-curr-abbr
     1668             scr-cli-qnty   =  scr-qnty / buf_goods.cli-base-rate
     1669             scr-unit-cli   = shar_ord-line.unit-cli
     1670             scr-sum-rubl   = scr-qnty  *  scr-price-rubl
     1671             scr-sum-base   = scr-qnty  *  scr-price-base
     1672             v-cli-base-rate = buf_goods.cli-base-rate
     1673          .
     1674     end.
     1675   END PROCEDURE.
     1676   PROCEDURE lkp-enable :
     1677    do
     1678    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1679    :
     1680     DISPLAY scr-qnty scr-price-rubl scr-price-base scr-artic scr-gds-name
     1681             scr-prod-code scr-prod-type scr-prod-name scr-unit-base scr-val
     1682             scr-cli-qnty scr-unit-cli scr-sum-rubl scr-sum-base v-cli-base-rate
     1683         WITH FRAME Dialog-Frame.
     1684     ENABLE b-quit
     1685            B-help
     1686         WITH FRAME Dialog-Frame.
     1687     VIEW FRAME Dialog-Frame.
     1688     WAIT-FOR GO OF FRAME Dialog-Frame .
     1689     end.
     1690   END PROCEDURE.
     1691   PROCEDURE my-enable :
     1692    do
     1693    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1694    :
     1695   define variable p-r-b-abbr as character no-undo .
     1696   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1697   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1698     (output p-r-b-abbr
     1699     )  .
     1700     DISPLAY scr-qnty scr-price-rubl scr-price-base scr-artic scr-gds-name
     1701             scr-prod-code scr-prod-type scr-prod-name scr-unit-base scr-val
     1702             scr-cli-qnty scr-unit-cli scr-sum-rubl scr-sum-base v-cli-base-rate
     1703         WITH FRAME Dialog-Frame.
     1704     ENABLE b-save
     1705            b-quit
     1706            b-exit-cycl   when p-line-mode = "ЦИКЛ":u
     1707            B-help
     1708            scr-qnty
     1709            r-price
     1710            scr-price-rubl when p-r-b-abbr = 'rubl':U
     1711            scr-price-base when p-r-b-abbr <> 'rubl':U
     1712         WITH FRAME Dialog-Frame.
     1713     VIEW FRAME Dialog-Frame.
     1714     if p-line-mode <> "ЦИКЛ":u  then hide b-exit-cycl in frame Dialog-Frame .
     1715     WAIT-FOR GO OF FRAME Dialog-Frame focus scr-qnty .
     1716     end.
     1717   END PROCEDURE.
     1718   PROCEDURE next-focus :
     1719    do
     1720    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1721    :
     1722   define input parameter p-widget-handle as handle no-undo .
     1723   define variable l-apply-entry as logical no-undo .
     1724   assign
     1725     l-apply-entry =   true
     1726   .
     1727   do with frame Dialog-Frame :
     1728     if  scr-qnty       :handle = p-widget-handle then do:  if scr-price-rubl     :sensitive then do:       apply "entry":u to scr-price-rubl   .        return . end.
     1729                                                            if scr-price-base     :sensitive then do:       apply "entry":u to scr-price-base   .        return . end.
     1730                                                       end.
     1731     if  scr-price-rubl :handle = p-widget-handle then do:  if B-save    :sensitive then do:       apply "entry":u to B-save    .        return . end. end.
     1732     if  scr-price-base :handle = p-widget-handle then do:  if B-save    :sensitive then do:       apply "entry":u to B-save    .        return . end. end.
     1733     end.
     1734     end.
     1735   END PROCEDURE.
