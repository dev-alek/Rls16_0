      818        week-22 AT ROW 12.92 COL 55.13 COLON-ALIGNED
      819        week-3 AT ROW 13.92 COL 38.13 COLON-ALIGNED
      820        week-32 AT ROW 13.96 COL 55.13 COLON-ALIGNED
      821        week-4 AT ROW 14.88 COL 38.13 COLON-ALIGNED
      822        week-42 AT ROW 14.92 COL 55.13 COLON-ALIGNED
      823        week-5 AT ROW 15.96 COL 38.13 COLON-ALIGNED
      824        week-52 AT ROW 16 COL 55.13 COLON-ALIGNED
      825        FILL-IN-3 AT ROW 9 COL 39 COLON-ALIGNED NO-LABEL
      826        "товаров,но >=" VIEW-AS TEXT
      827             SIZE 13.5 BY 1 AT ROW 8.88 COL 13.88
      828        "Интервалы просмотра реализации:" VIEW-AS TEXT
      829             SIZE 32.75 BY .67 AT ROW 10.5 COL 34.75
      830             FGCOLOR 4
      831        "Виды продаж :":C20 VIEW-AS TEXT
      832             SIZE 20.75 BY .67 AT ROW 6.54 COL 47.63
      833             FGCOLOR 4
      834        "Классификация :" VIEW-AS TEXT
      835             SIZE 15 BY .75 AT ROW 1.46 COL 12
      836             FGCOLOR 4
      837        "Сортировка :":C20 VIEW-AS TEXT
      838             SIZE 20.63 BY .75 AT ROW 1.46 COL 47.63
      839             FGCOLOR 4
      840        "товаров" VIEW-AS TEXT
      841             SIZE 8 BY 1 AT ROW 6.92 COL 37.13
      842        "Показать :" VIEW-AS TEXT
      843             SIZE 11.5 BY .75 AT ROW 4.88 COL 2.63
      844             FGCOLOR 4
      845        RECT-6 AT ROW 1.21 COL 46.13
      846        RECT-8 AT ROW 10.21 COL 1.75
      847        RECT-5 AT ROW 1.21 COL 1.75
      848       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      849            SIDE-LABELS NO-UNDERLINE THREE-D
      850            AT COL 1 ROW 1 SCROLLABLE .
      851   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      852   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      853   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      854   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      855   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      856   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      857   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      858   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      859         adm-object-hdl = FRAME F-Main:HANDLE.
      860   RUN ensure-broker.
      861   THIS-PROCEDURE:ADM-DATA =
      862        'ADM1.1~`':U +
      863        'SmartObject~`':U +
      864        '~`':U +
      865        'NO ~`':U +
      866        '~`':U +
      867        '~`':U +
      868        '~`':U +
      869        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      870           + "~`":U +
      871        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      872        'Record-Source,Record-Target,TableIO-Target~`':U +
      873        '~`':U +
      874        '~`~`~`~`~`~`~`~`~`~`~`':U +
      875        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      876            THEN "^^":U
      877        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      878             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      879   PROCEDURE adm-apply-entry :
      880     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      881   END PROCEDURE.
      882   PROCEDURE adm-destroy :
      883    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      884   END PROCEDURE.
      885   PROCEDURE adm-disable :
      886       DISABLE RECT-6 RECT-8 RECT-5 Tog-obj SortType Classify RADIO-SET-1 tog-kass tog-ras tog-voz Tog-1 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 FILL-IN-3 WITH FRAME F-Main.
      887       RUN dispatch ('disable-fields':U).
      888       RUN set-attribute-list ('ENABLED=no':U).
      889       RETURN.
      890   END PROCEDURE.
      891   PROCEDURE adm-edit-attribute-list :
      892         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      893         RETURN.
      894   END PROCEDURE.
      895   PROCEDURE adm-enable :
      896       ENABLE UNLESS-HIDDEN RECT-6 RECT-8 RECT-5 Tog-obj SortType Classify RADIO-SET-1 tog-kass tog-ras tog-voz Tog-1 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 FILL-IN-3 WITH FRAME F-Main.
      897       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      898       RUN set-attribute-list ('ENABLED=yes':U).
      899       RETURN.
      900   END PROCEDURE.
      901   PROCEDURE adm-exit :
      902        RUN notify ('exit':U).
      903     RETURN.
      904   END PROCEDURE.
      905   PROCEDURE adm-hide :
      906     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      907   END PROCEDURE.
      908   PROCEDURE adm-initialize :
      909     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      910   END PROCEDURE.
      911   PROCEDURE adm-show-errors :
      912       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      913       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      914           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      915       END.
      916       RETURN.
      917   END PROCEDURE.
      918   PROCEDURE adm-UIB-mode :
      919     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      920   END PROCEDURE.
      921   PROCEDURE adm-view :
      922     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      923   END PROCEDURE.
      924   PROCEDURE dispatch :
      925       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      926       RUN broker-dispatch IN adm-broker-hdl
      927           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      928       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      929   END PROCEDURE.
      930   PROCEDURE ensure-broker :
      931   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      932   IF RETURN-VALUE NE "ADM-Broker":U THEN
      933   DO:
      934       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      935       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      936   END.
      937   END PROCEDURE.
      938   PROCEDURE get-attribute :
      939     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      940     RUN broker-get-attribute IN adm-broker-hdl
      941         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      942     RETURN RETURN-VALUE.
      943   END PROCEDURE.
      944   PROCEDURE get-attribute-list :
      945     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      946     RUN broker-get-attribute-list IN adm-broker-hdl
      947         (INPUT THIS-PROCEDURE,
      948          INPUT ?,
      949          OUTPUT p-attr-list) NO-ERROR.
      950     RETURN.
      951   END PROCEDURE.
      952   PROCEDURE new-state :
      953     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      954     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      955     RETURN.
      956   END PROCEDURE.
      957   PROCEDURE notify :
      958     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      959     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      960     IF RETURN-VALUE = "ADM-ERROR":U THEN
      961         RETURN "ADM-ERROR":U.
      962     RETURN.
      963   END PROCEDURE.
      964   PROCEDURE set-attribute-list :
      965     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      966     RUN ensure-broker.
      967     RUN broker-set-attribute-list IN adm-broker-hdl
      968         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      969     RETURN.
      970   END PROCEDURE.
      971   PROCEDURE set-position :
      972       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      973       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      974       IF VALID-HANDLE(adm-object-hdl) THEN
      975       DO:
      976         ASSIGN adm-object-hdl:ROW    =   p-row
      977                adm-object-hdl:COLUMN =   p-col.
      978       END.
      979       RETURN.
      980   END PROCEDURE.
      981   PROCEDURE adm-display-fields :
      982       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      983       RETURN.
      984   END PROCEDURE.
      985   PROCEDURE adm-open-query :
      986     RETURN.
      987   END PROCEDURE.
      988   PROCEDURE adm-row-changed :
      989         IF VALID-HANDLE(adm-object-hdl) THEN
      990           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      991         RUN notify ('row-available':U).
      992         RETURN.
      993   END PROCEDURE.
      994   PROCEDURE reposition-query :
      995       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      996       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      997       RETURN.
      998   END PROCEDURE.
      999     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1000     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1001     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1002     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1003     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1004     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1005     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1006     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1007     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1008     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1009     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1010     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1011     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1012     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1013     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1014     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1015     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1016     IF "":U = "":U THEN
     1017       RUN modify-list-attribute IN adm-broker-hdl
     1018         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1019     RUN use-create-on-add(?).
     1020   PROCEDURE adm-add-record :
     1021       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1022          "must have at least one Enabled Table to perform Add.":U
     1023          VIEW-AS ALERT-BOX ERROR.
     1024       RETURN.
     1025   END PROCEDURE.
     1026   PROCEDURE adm-assign-record :
     1027    MESSAGE
     1028          "Object ":U THIS-PROCEDURE:FILE-NAME
     1029            "must have at least one Enabled Table to perform Assign.":U
     1030              VIEW-AS ALERT-BOX ERROR.
     1031      RETURN.
     1032     END PROCEDURE.
     1033   PROCEDURE adm-assign-statement :
     1034     RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE adm-cancel-record :
     1037      RETURN.
     1038     END PROCEDURE.
     1039   PROCEDURE adm-copy-record :
     1040       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1041        "must have at least one Enabled Table to perform Copy.":U
     1042          VIEW-AS ALERT-BOX ERROR.
     1043       RETURN.
     1044   END PROCEDURE.
     1045   PROCEDURE adm-create-record :
     1046      RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE adm-current-changed :
     1049     RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE adm-delete-record :
     1052    MESSAGE
     1053          "Object ":U THIS-PROCEDURE:FILE-NAME
     1054            "must have at least one Enabled Table to perform Delete.":U
     1055              VIEW-AS ALERT-BOX ERROR.
     1056       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1057       RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE adm-disable-fields :
     1060         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1061       RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE adm-enable-fields :
     1064       RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE adm-end-update :
     1067     RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE adm-reset-record :
     1070       RETURN.
     1071   END PROCEDURE.
     1072   PROCEDURE adm-update-record :
     1073       MESSAGE
     1074         "Object ":U THIS-PROCEDURE:FILE-NAME
     1075           "must have at least one Enabled Table to perform Update.":U
     1076             VIEW-AS ALERT-BOX ERROR.
     1077      RETURN.
     1078   END PROCEDURE.
     1079   PROCEDURE check-modified :
     1080   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1081   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1082   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1083   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1084     IF check-state = "check":U THEN
     1085     DO:
     1086       RUN get-link-handle IN adm-broker-hdl
     1087         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1088            OUTPUT group-target-list).
     1089       IF group-target-list NE "":U THEN
     1090       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1091         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1092         RUN check-modified IN curr-widget ('group-check':U).
     1093         IF RETURN-VALUE NE "":U THEN
     1094         DO:
     1095           RUN check-modified-message(RETURN-VALUE).
     1096           RETURN "":U.
     1097         END.
     1098       END.
     1099     END.
     1100     RETURN "":U.
     1101   END PROCEDURE.
     1102   PROCEDURE check-modified-message :
     1103     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1104        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1105           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1106        IF RETURN-VALUE = "YES":U THEN
     1107           RUN notify ('view,CONTAINER-SOURCE':U).
     1108        MESSAGE IF p-changed-table NE ? THEN
     1109           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1110           ELSE "Current values have been changed."
     1111           SKIP "  Do you wish to save those changes?"
     1112           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1113        IF ANS THEN
     1114        DO:
     1115           IF group-assign-target THEN
     1116             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1117           ELSE RUN dispatch('update-record':U).
     1118           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1119           DO:
     1120               MESSAGE "Changes to the previous record were not saved."
     1121                 VIEW-AS ALERT-BOX ERROR.
     1122               IF group-assign-target THEN
     1123                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1124               ELSE RUN dispatch ('cancel-record':U).
     1125           END.
     1126        END.
     1127        ELSE DO:
     1128          IF group-assign-target THEN
     1129             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1130          ELSE RUN dispatch('cancel-record':U).
     1131        END.
     1132        RETURN.
     1133   END PROCEDURE.
     1134   PROCEDURE get-rowid :
     1135       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1136       ASSIGN
     1137       p-table   =   adm-first-table.
     1138       RETURN.
     1139   END PROCEDURE.
     1140   PROCEDURE init-group-assign :
     1141       RUN request-attribute IN adm-broker-hdl
     1142         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1143       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1144         group-assign-target = yes.
     1145       ELSE group-assign-target = no.
     1146       RETURN.
     1147   END PROCEDURE.
     1148   PROCEDURE set-editors :
     1149       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1150       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1151       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1152       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1153       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1154       DO WHILE VALID-HANDLE (curr-widget):
     1155           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1156              curr-widget:HIDDEN = no THEN DO:
     1157             CASE p-field-setting:
     1158               WHEN "INITIALIZE":U THEN
     1159               DO:
     1160                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1161                     read-only-list +
     1162                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1163                        STRING(curr-widget).
     1164               END.
     1165               WHEN "DISABLE":U OR
     1166               WHEN "ENABLE":U THEN
     1167               DO:
     1168                   curr-widget:SENSITIVE = yes.
     1169                   RUN get-attribute ('Read-Only-Editors':U).
     1170                   IF RETURN-VALUE = ? OR
     1171                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1172                       curr-widget:READ-ONLY =
     1173                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1174               END.
     1175               WHEN "CLEAR":U THEN
     1176                   curr-widget:SCREEN-VALUE = "":U.
     1177             END CASE.
     1178           END.
     1179           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1180       END.
     1181       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1182         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1183           + '"':U).
     1184       RETURN.
     1185   END PROCEDURE.
     1186   PROCEDURE use-check-modified-all :
     1187    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1188     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1189     RETURN.
     1190   END PROCEDURE.
     1191   PROCEDURE use-create-on-add :
     1192   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1193      RETURN.
     1194   END PROCEDURE.
     1195   PROCEDURE use-initial-lock :
     1196     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1197     ASSIGN adm-initial-lock = p-attr-value.
     1198     RETURN.
     1199   END PROCEDURE.
     1200     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1201   ASSIGN
     1202          FRAME F-Main:SCROLLABLE       = FALSE
     1203          FRAME F-Main:HIDDEN           = TRUE.
     1204   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1205   DO:
     1206     Assign Classify.
     1207      if Classify = "grp-goods":U
     1208            Then do:
     1209               display TOG-lavel   with frame F-Main .
     1210               enable  TOG-lavel   with frame F-Main .
     1211           end.
     1212            Else do:
     1213               TOG-lavel = false.
     1214               display  TOG-lavel  var-Lavel with frame F-Main .
     1215               disable  TOG-lavel  var-Lavel with frame F-Main .
     1216           end.
     1217   END.
     1218   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME F-Main
     1219   DO:
     1220     Assign radio-set-1.
     1221     case radio-set-1 :
     1222     when 1 then DO:
     1223             disable max-amount max-amount-2 min-sum with frame F-Main .
     1224            end.
     1225     when 2 then DO:
     1226             enable max-amount with frame F-Main .
     1227             disable max-amount-2 min-sum with frame F-Main .
     1228            end.
     1229     when 3 then DO:
     1230             disable max-amount with frame F-Main .
     1231             enable max-amount-2 min-sum with frame F-Main .
     1232              end.
     1233     End case.
     1234        display max-amount max-amount-2 min-sum with frame F-Main .
     1235   END.
     1236   ON VALUE-CHANGED OF Tog-1 IN FRAME F-Main
     1237   DO:
     1238     assign tog-1 .
     1239     if tog-1 then
     1240     enable week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1241     else
     1242     disable week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1243     display week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1244   END.
     1245   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1246   DO:
     1247     Assign tog-lavel.
     1248     if tog-lavel =TRUE
     1249           Then do:
     1250               display  var-Lavel  with frame F-Main .
     1251               enable   var-Lavel  with frame F-Main .
     1252           end.
     1253            Else do:
     1254               display    var-Lavel with frame F-Main .
     1255               disable    var-Lavel with frame F-Main .
     1256           end.
     1257   END.
     1258   if not this-procedure :persistent
     1259   then do:
     1260     message
     1261       vss-workfile vss-revision vss-description skip
     1262       "Ошибка при запуске процедуры" skip
     1263       "Данную процедуру следует запускать только с параметром persistent" skip
     1264       view-as alert-box error .
     1265     undo, return error .
     1266   end.
     1267   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1268   on ' ' of week-1 in frame F-Main
     1269   do:
     1270     if (can-query (self, "sensitive")
     1271        and
     1272        self :sensitive = true
     1273        )
     1274     or (can-query (self, "read-only")
     1275        and
     1276        self :read-only = false
     1277        )
     1278     then do:
     1279       assign
     1280         self :screen-value = ?
     1281       .
     1282     end.
     1283     return no-apply.
     1284   end.
     1285   on delete-character of week-1 in frame F-Main
     1286   do:
     1287     if (can-query (self, "sensitive")
     1288        and
     1289        self :sensitive = true
     1290        )
     1291     or (can-query (self, "read-only")
     1292        and
     1293        self :read-only = false
     1294        )
     1295     then do:
     1296       assign
     1297         self :screen-value = ?
     1298       .
     1299     end.
     1300     return no-apply.
     1301   end.
     1302   on ctrl-d of week-1 in frame F-Main
     1303   do:
     1304     define variable v-curr-sv-date as date no-undo .
     1305     if (can-query (self, "sensitive")
     1306        and
     1307        self :sensitive = true
     1308        )
     1309     or (can-query (self, "read-only")
     1310        and
     1311        self :read-only = false
     1312        )
     1313     then do:
     1314       if self :handle <> focus :handle
     1315       then do:
     1316         apply "entry":u to self .
     1317       end.
     1318       run gbl/getcurdt.p
     1319         (output v-curr-sv-date
     1320         ) .
     1321       assign
     1322         self :screen-value = string(v-curr-sv-date) .
     1323       .
     1324     end.
     1325     return no-apply.
     1326   end.
     1327   on ctrl-b of week-1 in frame F-Main
     1328   do:
     1329     if (can-query (self, "sensitive")
     1330        and
     1331        self :sensitive = true
     1332        )
     1333     or (can-query (self, "read-only")
     1334        and
     1335        self :read-only = false
     1336        )
     1337     then do:
     1338       if self :handle <> focus :handle
     1339       then do:
     1340         apply "entry":u to self .
     1341       end.
     1342       define variable v-curr-sv-date as date no-undo .
     1343       define variable v-new-sv-date  as date no-undo .
     1344       assign
     1345         v-curr-sv-date = date(self :screen-value) no-error
     1346       .
     1347       if v-curr-sv-date = ?
     1348       then do:
     1349         run gbl/getcurdt.p
     1350           (output v-curr-sv-date
     1351           ) .
     1352       end.
     1353       if v-curr-sv-date <> ?
     1354       then do:
     1355         assign
     1356           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1357         .
     1358         assign
     1359           self :screen-value = string(v-new-sv-date) .
     1360         .
     1361       end.
     1362     end.
     1363     return no-apply .
     1364   end.
     1365   on ctrl-e of week-1 in frame F-Main
     1366   do:
     1367     if (can-query (self, "sensitive")
     1368        and
     1369        self :sensitive = true
     1370        )
     1371     or (can-query (self, "read-only")
     1372        and
     1373        self :read-only = false
     1374        )
     1375     then do:
     1376       if self :handle <> focus :handle
     1377       then do:
     1378         apply "entry":u to self .
     1379       end.
     1380       define variable v-curr-sv-date as date no-undo .
     1381       define variable v-new-sv-date  as date no-undo .
     1382       assign
     1383         v-curr-sv-date = date(self :screen-value) no-error
     1384       .
     1385       if v-curr-sv-date = ?
     1386       then do:
     1387         run gbl/getcurdt.p
     1388           (output v-curr-sv-date
     1389           ) .
     1390       end.
     1391       if v-curr-sv-date <> ?
     1392       then do:
     1393         run gbl/lastdate.p
     1394           (input  v-curr-sv-date
     1395           ,output v-new-sv-date
     1396           ).
     1397         assign
     1398           self :screen-value = string(v-new-sv-date) .
     1399         .
     1400       end.
     1401     end.
     1402     return no-apply .
     1403   end.
     1404   on ctrl-f of week-1 in frame F-Main
     1405   do:
     1406     if (can-query (self, "sensitive")
     1407        and
     1408        self :sensitive = true
     1409        )
     1410     or (can-query (self, "read-only")
     1411        and
     1412        self :read-only = false
     1413        )
     1414     then do:
     1415       if self :handle <> focus :handle
     1416       then do:
     1417         apply "entry":u to self .
     1418       end.
     1419       define variable v-ok            as logical   no-undo .
     1420       define variable v-curr-sv-date  as date      no-undo .
     1421       define variable v-description   as character no-undo .
     1422       assign
     1423         v-curr-sv-date = date(self :screen-value) no-error
     1424       .
     1425       if v-curr-sv-date = ?
     1426       then do:
     1427         run gbl/getcurdt.p
     1428           (output v-curr-sv-date
     1429           ) .
     1430       end.
     1431       if v-curr-sv-date <> ?
     1432       then do:
     1433         run gbl/d-inpday.w
     1434           (input ?
     1435           ,input "Выбор даты"
     1436           ,input v-description
     1437           ,input ""
     1438           ,input-output v-curr-sv-date
     1439           ,output v-ok
     1440           ).
     1441         if v-ok = true
     1442         then do:
     1443           assign
     1444             self :screen-value = string(v-curr-sv-date) .
     1445           .
     1446         end.
     1447       end.
     1448     end.
     1449     return no-apply .
     1450   end.
     1451     define MENU m-ed-date14
     1452       MENU-ITEM m-ed-date14-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1453       MENU-ITEM m-ed-date14-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1454       MENU-ITEM m-ed-date14-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1455       MENU-ITEM m-ed-date14-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1456       .
     1457     if week-1 :POPUP-MENU in frame F-Main = ?
     1458     then do:
     1459       ASSIGN
     1460         week-1 :POPUP-MENU in frame F-Main = MENU m-ed-date14 :HANDLE
     1461         week-1 :MENU-MOUSE in frame F-Main = 3
     1462       .
     1463     end.
     1464     define variable v-label-handle14 as handle no-undo .
     1465     assign
     1466       v-label-handle14 = week-1 :side-label-handle in frame F-Main
     1467     .
     1468     if valid-handle (v-label-handle14)
     1469     then do:
     1470       if v-label-handle14 :tooltip = ""
     1471       or v-label-handle14 :tooltip = ?
