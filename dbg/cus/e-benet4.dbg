     3059   PROCEDURE disable_UI :
     3060     HIDE FRAME F-Main.
     3061     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     3062   END PROCEDURE.
     3063   PROCEDURE find-fo :
     3064   def input  parameter date1 as date no-undo.
     3065   def input  parameter date2 as date no-undo.
     3066   def output parameter f-1   like ub.ot-line.fact-order no-undo.
     3067   def output parameter f-2   like ub.ot-line.fact-order no-undo.
     3068      Assign f-1 = Integer(date1 - 1 ) + 0.99  f-2 = Integer(date2) + 0.99 .
     3069   END PROCEDURE.
     3070   PROCEDURE local-initialize :
     3071     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     3072     assign
     3073       FILL-IN-3 = "руб"
     3074     .
     3075     do with frame F-Main
     3076     :
     3077       display
     3078         FILL-IN-3
     3079         with frame F-Main .
     3080     end.
     3081      disable max-amount-2 min-sum with frame F-Main .
     3082      RAdio-set-1:screen-value      in frame F-Main = '1'.
     3083      Tog-obj:screen-value      in frame F-Main = 'yes'.
     3084      Tog-1:screen-value      in frame F-Main = 'yes'.
     3085      Tog-kass:screen-value      in frame F-Main = 'yes'.
     3086      Tog-ras:screen-value      in frame F-Main = 'yes'.
     3087      Tog-voz:screen-value      in frame F-Main = 'yes'.
     3088      Tog-lavel:screen-value      in frame F-Main = 'no'.
     3089      var-lavel:screen-value    in frame F-Main = '1'.
     3090      min-sum:screen-value      in frame F-Main = '0'.
     3091      max-amount:screen-value   in frame F-Main = '20'.
     3092      max-amount-2:screen-value in frame F-Main = '20'.
     3093      max-amount   = 20.
     3094      max-amount-2 = 20.
     3095   END PROCEDURE.
     3096   PROCEDURE my-report :
     3097   if tog-obj = true  then do:
     3098         run cus/r-benet4.p
     3099             (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type, input base-code, input Classify, input SortType, input false, input false, input Tog-obj, input tog-lavel, input var-lavel, input radio-set-1,input max-amount, input max-amount-2,input min-sum, input tog-kass,input tog-ras, input tog-voz, input fo1,input fo12, input fo2,input fo22,input fo3,input fo32,input fo4,input fo42,input fo5,input fo52,input tog-1 ). .
     3100   end.
     3101   Else do:
     3102           run cus/r-bene4n.p
     3103               (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type, input base-code, input Classify, input SortType, input false, input false, input Tog-obj, input tog-lavel, input var-lavel, input radio-set-1,input max-amount, input max-amount-2,input min-sum, input tog-kass,input tog-ras, input tog-voz, input fo1,input fo12, input fo2,input fo22,input fo3,input fo32,input fo4,input fo42,input fo5,input fo52,input tog-1 ). .
     3104   End.
     3105   END PROCEDURE.
     3106   PROCEDURE my-var :
     3107     define variable v-check-date as date      no-undo .
     3108     define variable v-archive-ok as logical   no-undo .
     3109     define variable v-comment    as character no-undo .
     3110     define variable v-can-print  as logical   no-undo .
     3111   define variable M as int no-undo.
     3112   assign frame F-Main
     3113   tog-obj tog-lavel var-lavel tog-1
     3114   Classify SortType
     3115   max-amount
     3116   max-amount-2
     3117   min-sum
     3118   tog-kass
     3119   tog-ras
     3120   tog-voz
     3121   radio-set-1
     3122   week-1
     3123   week-12
     3124   week-2
     3125   week-22
     3126   week-3
     3127   week-32
     3128   week-4
     3129   week-42
     3130   week-5
     3131   week-52
     3132   .
     3133   if
     3134   week-1  = ? OR
     3135   week-12 = ? OR
     3136   week-2  = ? OR
     3137   week-22 = ? OR
     3138   week-3  = ? OR
     3139   week-32 = ? OR
     3140   week-4  = ? OR
     3141   week-42 = ? OR
     3142   week-5  = ? OR
     3143   week-52 = ?  THEN DO:
     3144        MEssage 'Не заданы интервалы просмотра реализации ! ' view-as alert-box error.
     3145        RETURN 'Second-page':U  . End.
     3146   Assign
     3147    STR-obj-type = ''
     3148    STR-obj-code = ''
     3149    STR-obj-name = ''
     3150    STR-obj      = ''.
     3151   For each obj-list no-lock:
     3152    Assign
     3153    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3154    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3155    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3156    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     3157   End.
     3158   ReportNAme = "О Т Ч Е Т   О   Р Е А Л И З А Ц И И   Т О В А Р А".
     3159   def var t-class as char no-undo.
     3160   def var t-sort as char no-undo.
     3161     case classify:
     3162       when "no-classify":u    then t-class =   "Без классификации" .
     3163       when "prod":u           then t-class =   "Производители"   .
     3164       when "post":u           then t-class =   "Поставщики"   .
     3165       when "grp-goods":u      then t-class =   "Группы товаров"  .
     3166       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     3167       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     3168       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     3169       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     3170       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     3171       when  "sort":u          then t-class =   "Проба(Сорт)" .
     3172       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     3173       when  "t-level":u       then t-class =   "Терминальные группы" .
     3174    end case.
     3175     case sorttype:
     3176       when "sort-pp":u               then t-sort =   "по порядку" .
     3177       when "sort-code":u             then t-sort =   "по коду" .
     3178       when "sort-artic":u            then t-sort =   "по артикулу"  .
     3179       when "sort-qunty":u            then t-sort =   "по реализации".
     3180       when "sort-name":u             then t-sort =   "по наименованию".
     3181       when "sort-type":u             then t-sort =   "по типу ткани".
     3182       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     3183       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     3184    end case.
     3185   ReportHeader = "Классификация : " + t-Class.
     3186   ReportHeader = ReportHeader +
     3187                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     3188   ReportHeader = ReportHeader + chr(10) +
     3189                  "Сортировка " + (t-Sort)  + chr(10) .
     3190   case radio-set-1 :
     3191   When 2 then
     3192       ReportHeader = ReportHeader + string(max-amount) + ' с наибольшей реализацией ' + chr(10).
     3193   When 3 then
     3194       ReportHeader = ReportHeader + string(max-amount-2) + ' с наименьшей реализацией, но большей ' + string(min-sum) + ' руб.' + chr(10).
     3195   End case.
     3196   ReportHeader = ReportHeader +
     3197                  "Виды продаж : " + if (tog-kass) then 'касса продажа':U Else ""   .
     3198   ReportHeader = ReportHeader +  " , " +
     3199                   if (tog-ras) then 'расход внешний':U Else ""   .
     3200   ReportHeader = ReportHeader +  " , " +
     3201                   if (tog-voz) then 'возврат внешний':U Else ""   .
     3202      if tog-1 then DO:
     3203       ReportHeader = ReportHeader  + chr(10) + if week-1  <> DATE('')   THEN  " 1я неделя " + String(week-1,"99/99/9999")          ELSE ""  .
     3204       ReportHeader = ReportHeader  + if week-12 <> DATE('')   THEN  " по " + String(week-12,"99/99/9999")      + chr(10) ELSE ""  .
     3205       ReportHeader = ReportHeader  + if week-2  <> DATE('')   THEN  " 2я неделя " + String(week-2,"99/99/9999")          ELSE ""  .
     3206       ReportHeader = ReportHeader  + if week-22 <> DATE('')   THEN  " по " + String(week-22,"99/99/9999")      + chr(10) ELSE ""  .
     3207       ReportHeader = ReportHeader  + if week-3  <> DATE('')   THEN  " 3я неделя " + String(week-3,"99/99/9999")          ELSE ""  .
     3208       ReportHeader = ReportHeader  + if week-32 <> DATE('')   THEN  " по " + String(week-32,"99/99/9999")      + chr(10) ELSE ""  .
     3209       ReportHeader = ReportHeader  + if week-4  <> DATE('')   THEN  " 4я неделя " + String(week-4,"99/99/9999")          ELSE ""  .
     3210       ReportHeader = ReportHeader  + if week-42 <> DATE('')   THEN  " по " + String(week-42,"99/99/9999")      + chr(10) ELSE ""  .
     3211       ReportHeader = ReportHeader  + if week-5  <> DATE('')   THEN  " 5я неделя " + String(week-5,"99/99/9999")          ELSE ""  .
     3212       ReportHeader = ReportHeader  + if week-52 <> DATE('')   THEN  " по " + String(week-52,"99/99/9999")      + chr(10) ELSE "" .
     3213     assign
     3214       v-check-date = maximum( week-1  ,
     3215                         week-12 ,
     3216                         week-2  ,
     3217                         week-22 ,
     3218                         week-3  ,
     3219                         week-32 ,
     3220                         week-4  ,
     3221                         week-42 ,
     3222                         week-5  ,
     3223                         week-52 ).
     3224     for each obj-list no-lock
     3225     :
     3226       run rep/chk-ahz.p
     3227         (input        obj-list.obj-type
     3228         ,input        obj-list.obj-code
     3229         ,input        true
     3230         ,input        true
     3231         ,input        false
     3232         ,input        false
     3233         ,input        true
     3234         ,input        v-cntxt-db-num
     3235         ,input        v-cntxt-userid
     3236         ,input-output v-check-date
     3237         ,input-output v-check-date
     3238         ,output       v-archive-ok
     3239         ,output       v-comment
     3240         ,output       v-can-print
     3241         ) .
     3242     end.
     3243    run find-fo (input week-1, input week-12  ,output fo1, output fo12).
     3244    run find-fo (input week-2, input week-22  ,output fo2, output fo22).
     3245    run find-fo (input week-3, input week-32  ,output fo3, output fo32).
     3246    run find-fo (input week-4, input week-42  ,output fo4, output fo42).
     3247    run find-fo (input week-5, input week-52  ,output fo5, output fo52).
     3248    sheetf.Excel-Column-Lable = "Артикул,Наименование,Процент (%),Реализация,,Среднесут.реализация,, " +
     3249    "Реализация 1 неделя " + ",," +
     3250    "Реализация 2 неделя " + ",," +
     3251    "Реализация 3 неделя " + ",," +
     3252    "Реализация 4 неделя " + ",," +
     3253    "Реализация 5 неделя " + ",," +
     3254    chr(10) .
     3255    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,,Количество,Сумма,Количество,Сумма" +
     3256      ",Количество,Сумма" +
     3257      ",Количество,Сумма" +
     3258      ",Количество,Сумма" +
     3259      ",Количество,Сумма" +
     3260      ",Количество,Сумма" .
     3261    sheetf.Sizes = '16,60,12,13,13,13,13,13,13,13,13,13,13,13,13,13,13,' .
     3262    End.
     3263    Else DO:
     3264    sheetf.Excel-Column-Lable = "Артикул,Наименование,Процент (%),Реализация,,Среднесут.реализация,, " +
     3265    chr(10) .
     3266    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,,Количество,Сумма,Количество,Сумма" .
     3267    sheetf.Sizes = '16,60,12,13,13,13,13,' .
     3268    End.
     3269    str2=''.
     3270   END PROCEDURE.
     3271   PROCEDURE state-changed :
     3272     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     3273     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     3274     define variable month-1 as date no-undo .
     3275     define variable month-2 as date no-undo .
     3276     define variable nn as int no-undo.
     3277     define variable ret# as log no-undo.
     3278     CASE p-state:
     3279       when "link-changed" then  DO:
     3280            End.
     3281     END CASE.
     3282     if month-1 = ? THEN   month-1 = DAte(month(x-Date-Start ),1,year(x-Date-Start )).
     3283   if month-2 = ? THEN   DO:
     3284       month-2 = x-Date-Start  .
     3285       run gbl/lastdate.p
     3286         (input  month-2
     3287         ,output month-2  ).
     3288       End.
     3289   NN = Weekday(DAte(month(month-1 ),1,year(month-1)))  .
     3290   if week-1  = ? THEN   week-1  = month-1 + (2 - NN)                             .
     3291   if week-12 = ? THEN   week-12 = week-1 +  6                                  .
     3292   if week-2  = ? THEN   week-2  = week-12 + 1                                  .
     3293   if week-22 = ? THEN   week-22 = week-2  + 6                                  .
     3294   if week-3  = ? THEN   week-3  = week-22 + 1                                  .
     3295   if week-32 = ? THEN   week-32 = week-3  + 6                                  .
     3296   if week-4  = ? THEN   week-4  = week-32 + 1                                  .
     3297   if week-42 = ? THEN   week-42 = week-4  + 6                                  .
     3298   if week-5  = ? THEN   week-5  = week-42 + 1                                  .
     3299   if week-52 = ? THEN   week-52 = week-5 + 6                                   .
     3300   if date(week-1:screen-value in frame F-Main) <> ? then
     3301    assign frame F-Main
     3302   week-1
     3303   week-12
     3304   week-2
     3305   week-22
     3306   week-3
     3307   week-32
     3308   week-4
     3309   week-42
     3310   week-5
     3311   week-52
     3312   .
     3313   display  week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     3314   END PROCEDURE.
