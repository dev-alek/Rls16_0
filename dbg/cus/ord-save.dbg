     2323       buf_ord-line.obj-code = buf_ord-doc.obj-code
     2324       buf_ord-line.status_  = buf_ord-doc.status_
     2325       .
     2326       if buf_ord-line.cli-base-rate = ?
     2327       or buf_ord-line.cli-base-rate = 0 then do:
     2328         assign
     2329         buf_ord-line.cli-base-rate = buf_goods.cli-base-rate
     2330        .
