     4144   define variable v-mess as character no-undo .
     4145   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     4146     v-dop = entry(v-ii, p-mess, chr(4) ).
     4147     case entry(1, v-dop, "="):
