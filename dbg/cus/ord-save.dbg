     4033       run ordlineattr-code in this-procedure
     4034         (input  p-code
     4035         ,output v-type
     4036         ,output v-format
     4037         ,output v-fillin_width
     4038         ,output v-fillin_height
     4039         ,output v-label
     4040         ,output v-user-can-edit
     4041         ,output v-output-display
     4042         ,output v-proc
     4043         ,output v-func
     4044         ,output v-sort
     4045         ,output v-other
     4046         ) no-error .
     4047       if error-status :error then do:
     4048         undo, return error return-value .
     4049       end.
     4050       find first buf_ord-line-attr exclusive-lock
     4051         where buf_ord-line-attr.doc-code  = p-doc-code
     4052           and buf_ord-line-attr.gds-code  = p-gds-code
     4053           and buf_ord-line-attr.attr-code = p-code
     4054         no-error NO-WAIT.
     4055       if not available buf_ord-line-attr then do:
     4056         p-deleted = no.
     4057       end.
     4058       else do:
     4059         delete buf_ord-line-attr.
     4060         p-deleted = yes.
     4061       end.
     4062     end.
     4063   end procedure.
     4064   procedure ordlineattr-code :
     4065     do on error undo, return error return-value
     4066     :
     4067       define input  parameter p-code           as character no-undo .
     4068       define output parameter p-type           as character no-undo .
     4069       define output parameter p-format         as character no-undo .
     4070       define output parameter p-fillin_width   as integer   no-undo .
     4071       define output parameter p-fillin_height  as integer   no-undo .
     4072       define output parameter p-label          as character no-undo .
     4073       define output parameter p-user-can-edit  as logical   no-undo .
     4074       define output parameter p-output-display as logical   no-undo .
     4075       define output parameter p-proc           as character no-undo .
     4076       define output parameter p-func           as character no-undo .
     4077       define output parameter p-sort           as integer   no-undo .
     4078       define output parameter p-other          as character no-undo .
     4079       case p-code :
     4080               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     4081               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     4082         otherwise do:
     4083           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     4084         end.
     4085       end.
     4086     end.
     4087   end procedure.
     4088   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     4089   define variable v-ii as integer   no-undo .
     4090   define variable v-dop as character no-undo .
     4091   define variable v-dop1 as character no-undo .
     4092   define variable v-mess as character no-undo .
     4093   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     4094     v-dop = entry(v-ii, p-mess, chr(4) ).
     4095     case entry(1, v-dop, "="):
     4096       when 'pack-num':U then do:
     4097         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     4098       end.
     4099       when 'route':U then do:
     4100         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     4101       end.
     4102       when 'ediiterchangeid':U then do:
     4103         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     4104       end.
     4105       when 'price-up':U then do:
     4106         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     4107       end.
     4108       when 'price-down':U then do:
     4109         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     4110       end.
     4111       when 'vat-change':U then do:
     4112         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     4113       end.
     4114       when 'ps':U then do:
     4115         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     4116       end.
     4117       when 'info':U then do:
     4118         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     4119       end.
     4120       when 'qnty-up':U then do:
     4121         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     4122       end.
     4123       when 'qnty-down':U then do:
     4124         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     4125       end.
     4126       when 'bstr-change':U then do:
     4127         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     4128       end.
     4129       when 'shipdate-change':U then do:
     4130         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     4131       end.
     4132       when 'clioutdoc-change':U then do:
     4133         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     4134       end.
     4135     end case.
     4136     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     4137   end.
     4138   return v-mess.
     4139   end function.
     4140   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     4141   define variable v-ii as integer   no-undo .
     4142   define variable v-dop as character no-undo .
