     2334         assign
     2335         buf_ord-line.unit-cli = buf_goods.unit-cli
     2336         .
     2337       end.
     2338     t-sum = 0.
     2339     for each buf_ord-dtl no-lock where
     2340         buf_ord-dtl.doc-code  = buf_ord-line.doc-code and
     2341         buf_ord-dtl.artic     = buf_ord-line.artic and
