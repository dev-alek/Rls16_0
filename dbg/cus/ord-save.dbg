     4157       when 'price-up':U then do:
     4158         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     4159       end.
     4160       when 'price-down':U then do:
     4161         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     4162       end.
     4163       when 'vat-change':U then do:
     4164         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     4165       end.
     4166       when 'ps':U then do:
     4167         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     4168       end.
     4169       when 'info':U then do:
     4170         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     4171       end.
     4172       when 'qnty-up':U then do:
     4173         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     4174       end.
     4175       when 'qnty-down':U then do:
     4176         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     4177       end.
     4178       when 'bstr-change':U then do:
     4179         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     4180       end.
     4181       when 'shipdate-change':U then do:
     4182         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     4183       end.
     4184       when 'clioutdoc-change':U then do:
     4185         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     4186       end.
     4187     end case.
     4188     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     4189   end.
     4190   return v-mess.
     4191   end function.
     4192   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     4193   define variable v-ii as integer   no-undo .
     4194   define variable v-dop as character no-undo .
     4195   define variable v-dop1 as character no-undo .
     4196   define variable v-value as character no-undo .
     4197   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     4198     v-dop = entry(v-ii, p-mess, chr(4) ).
     4199     if entry(1, v-dop, "=") = p-key then do:
     4200       return entry(2, v-dop, "=").
     4201     end.
     4202   end.
     4203   return v-value.
     4204   end function.
     4205   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     4206                                                        ,input p-key as character
     4207                                                        ,input p-value as character):
     4208   define variable v-dop as character no-undo .
     4209   define variable v-modificator as character no-undo .
     4210   assign
     4211   v-modificator = entry(2, p-key, "-") no-error .
     4212   case v-modificator:
     4213     when "up" then do:
     4214       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     4215     end.
     4216     when "down" then do:
     4217       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     4218     end.
     4219     when "change" then do:
     4220       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     4221     end.
     4222     otherwise do:
     4223       v-dop = substitute("&1=&2", p-key, p-value).
     4224     end.
     4225   end case.
     4226   if p-mess = ''
     4227   or p-mess = ? then do:
     4228     return v-dop .
     4229   end.
     4230   else do:
     4231     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     4232   end.
     4233   end function.
     4234   procedure create-edi-state :
     4235   define input  parameter p-tbl-name   as character no-undo .
     4236   define input  parameter p-doc-code   as character no-undo .
     4237   define input  parameter p-cli-type   as character no-undo .
     4238   define input  parameter p-cli-code   as integer   no-undo .
     4239   define input  parameter p-act        as character no-undo .
     4240   define input  parameter p-state      as character no-undo .
     4241   define input  parameter p-err        as integer   no-undo .
     4242   define input  parameter p-des        as character no-undo .
     4243   define input  parameter p-mess       as character no-undo .
     4244   define input  parameter p-dm         as integer  no-undo .
     4245   define input-output parameter p-date       as date no-undo .
     4246   define input-output parameter p-time       as integer no-undo .
     4247   define buffer buf_EDI-status for ub.EDI-status  .
     4248   define variable v-time as integer   no-undo .
     4249   define variable v-date as date   no-undo .
     4250   do
     4251   on error undo, return error return-value
     4252   :
     4253     if p-date = ? then do:
     4254       run cur-time in this-procedure ( output v-date, output v-time).
     4255     end.
     4256     else do:
     4257       assign
     4258       v-date = p-date
     4259       v-time = p-time
     4260       .
     4261     end.
     4262     find first buf_edi-status exclusive-lock where
     4263                 buf_edi-status.date-status = v-date
     4264             and buf_edi-status.time-status = v-time
     4265             and buf_edi-status.tbl-name    = p-tbl-name
     4266             and buf_edi-status.doc-code    = p-doc-code no-error .
     4267     if not available buf_edi-status  then do:
     4268       create buf_edi-status.
     4269     end.
     4270     assign
     4271     buf_edi-status.act         = p-act        .
     4272     buf_edi-status.cli-type    = p-cli-type   .
     4273     buf_edi-status.cli-code    = p-cli-code   .
     4274     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     4275     buf_edi-status.doc-code    = p-doc-code   .
     4276     buf_edi-status.err-code    = p-err        .
     4277     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     4278     buf_edi-status.state       = p-state      .
     4279     buf_edi-status.tbl-name    = p-tbl-name   .
     4280     buf_edi-status.date-status = v-date       .
     4281     buf_edi-status.time-status = v-time       .
     4282     buf_edi-status.whole-send-news = p-dm     .
     4283     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     4284                                       else (if g#esys
     4285                                             then (chr(4) +  'ВС':U)
     4286                                             else g#userid)
     4287                                       )       .
     4288     assign
     4289     p-date = buf_edi-status.date-status
     4290     p-time = buf_edi-status.time-status
     4291     .
     4292   end.
     4293   end procedure.
     4294   procedure update-edi-state-light :
     4295   define input  parameter p-tbl-name   as character no-undo .
     4296   define input  parameter p-doc-code   as character no-undo .
     4297   define input  parameter p-date-status as date no-undo .
     4298   define input  parameter p-time-status as integer no-undo .
     4299   define input  parameter p-state      as character no-undo .
     4300   define input  parameter p-err        as integer   no-undo .
     4301   define input  parameter p-des        as character no-undo .
     4302   define input  parameter p-mess       as character no-undo .
     4303   define buffer buf_edi-status for ub.edi-status.
     4304   do
     4305   on error undo, return error
     4306   :
     4307     find first buf_edi-status exclusive-lock where
     4308                 buf_edi-status.date-status = p-date-status
     4309             and buf_edi-status.time-status = p-time-status
     4310             and buf_edi-status.tbl-name    = p-tbl-name
     4311             and buf_edi-status.doc-code    = p-doc-code no-error .
     4312     if available buf_edi-status  then do:
     4313       assign
     4314       buf_edi-status.des-err     = p-des        .
     4315       buf_edi-status.err-code    = p-err        .
     4316       buf_edi-status.mess-id     = p-mess       .
     4317       buf_edi-status.state       = p-state      .
     4318     end.
     4319   end.
     4320   end procedure.
     4321               assign
     4322                   shar_ord-doc.ord-int1 = integer('6':U)
     4323               .
     4324               assign
     4325                   v-current-doc-code = shar_ord-doc.doc-code
     4326                   v-current-obj-type = shar_ord-doc.obj-type
     4327                   v-current-obj-code = shar_ord-doc.obj-code
     4328                   p-parent-handle = this-procedure:handle
     4329               .
     4330   define variable ExpData1 as class Route-data_ no-undo .
     4331   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     4332   define variable v-DATA as memptr no-undo.
     4333   define variable v-esys-cmd-proc-handle as handle no-undo .
     4334   define variable v-esys-cmd-code as integer no-undo .
     4335   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
