     3986       run ordlineattr-code in this-procedure
     3987         (input  p-code
     3988         ,output v-type
     3989         ,output v-format
     3990         ,output v-fillin_width
     3991         ,output v-fillin_height
     3992         ,output v-label
     3993         ,output v-user-can-edit
     3994         ,output v-output-display
     3995         ,output v-proc
     3996         ,output v-func
     3997         ,output v-sort
     3998         ,output v-other
     3999         ) no-error .
     4000       if error-status :error then do:
     4001         undo, return error return-value .
     4002       end.
     4003       find first buf_ord-line-attr no-lock
     4004         where buf_ord-line-attr.doc-code  = p-doc-code
     4005           and buf_ord-line-attr.gds-code = p-gds-code
     4006           and buf_ord-line-attr.attr-code = p-code
     4007         no-error .
     4008       if  available buf_ord-line-attr then do:
     4009         p-exist = yes.
     4010       end.
     4011     end.
     4012   end procedure.
