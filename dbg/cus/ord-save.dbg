     4338   function context_begin-esys-command return logical
     4339   (
     4340       input p-esys-id-list as character
     4341      ,input-output p-esys-cmd-proc-handle as handle
     4342      ,output p-esys-cmd-code as integer
     4343   ):
     4344      if not valid-handle(p-esys-cmd-proc-handle )
     4345      then do:
     4346        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     4347        if error-status :error
     4348        then do:
     4349           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     4350                                              "&5&4&6"
     4351                                              ,vss-workfile
     4352                                              ,vss-revision
     4353                                              ,vss-description
     4354                                              ,chr(10)
     4355                                              ,error-status:get-message(1)
     4356                                              ,return-value )).
     4357        end.
     4358        run begin-create-command in p-esys-cmd-proc-handle
     4359          (input 'cmd-esys-general':U
     4360          ,input p-esys-id-list
     4361          ,output p-esys-cmd-code
     4362          ) no-error.
     4363        if error-status :error
     4364        then do:
     4365          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     4366                                                           , 'cmd-esys-general':U
     4367                                                           , error-status:get-message(1)
     4368                                                           , return-value
     4369                                                           )).
     4370          return no .
     4371        end.
     4372        return yes.
     4373      end.
     4374   end.
     4375   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4376   function context_send-esys-command return int64
     4377   (
     4378       input p-esys-id-list as character
     4379      ,input p-esys-cmd-proc-handle as handle
     4380      ,input p-esys-cmd-code as integer
     4381      ,input p-user-id as character
     4382   ):
     4383      define variable v-dmp-ord-int64 as int64 no-undo .
     4384      if valid-handle(p-esys-cmd-proc-handle )
     4385      then do:
     4386         run send-command-esys in p-esys-cmd-proc-handle
     4387             (input p-esys-cmd-code
     4388             ,input p-esys-id-list
     4389             ,input p-user-id
     4390             ,output v-dmp-ord-int64
     4391             ) no-error.
     4392         if error-status :error
     4393         then do:
     4394            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4395                                                           , p-esys-id-list
     4396                                                           , p-cmd-code
     4397                                                           , chr(10)
     4398                                                           , error-status:get-message(1)
     4399                                                           , return-value
     4400                                                           )).
     4401            return 0.
     4402         end.
     4403         delete procedure p-esys-cmd-proc-handle no-error.
     4404         return v-dmp-ord-int64.
     4405      end.
     4406      else do:
     4407         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4408                                                       , p-esys-id-list
     4409                                                       , p-cmd-code
     4410                                                       , chr(10)
     4411                                                       , error-status:get-message(1)
     4412                                                       , return-value
     4413                                                       )).
     4414         return 0 .
     4415      end.
     4416   end.
     4417   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
