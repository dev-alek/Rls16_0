     2672     ,output g#host-code
     2673     ,output g#host-name
     2674     )  .
     2675   run get-report-num  in parParentProc ( output g#report-num ).
     2676   define variable k as int init 0 no-undo.
     2677   define variable ord-qnty    as decimal init 0 no-undo.
     2678   define variable ord-sum-cli as decimal init 0 no-undo.
     2679   define variable t-ret as logical no-undo .
     2680   define variable to-day as date no-undo .
     2681   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2682   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2684     (input  store-type
     2685     ,input  store-code
     2686     ,output to-day
     2687     )  .
     2688   define variable t-date  as date      no-undo .
     2689   define variable t-time  as integer   no-undo .
     2690   define variable t-log-3 as logical   no-undo .
     2691   run cur-time (output  t-date , output  t-time ).
     2692   t-ret =  session:set-wait-state("general") .
     2693   assign     k = 0
     2694              ord-qnty    = 0
     2695              ord-sum-cli = 0.
     2696   case t-action :
     2697   when "lkp" then do :
     2698   end.
     2699   when "chg" or when "add":u  or when "copy" then do :
     2700      k = 0 .
     2701      for each tmp#zakaz no-lock :
     2702          assign k = k + 1 .
     2703      end.
     2704     for each shar_ord-dtl where shar_ord-dtl.doc-code = loc-ord-num exclusive-lock   :
     2705         delete shar_ord-dtl .
