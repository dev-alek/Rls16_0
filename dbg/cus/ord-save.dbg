     3850   procedure ordlineattr-value :
     3851     do
     3852     on error undo, return error return-value
     3853     :
     3854       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     3855       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     3856       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     3857       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     3858       define output parameter p-type     as character no-undo .
     3859       define buffer buf_ord-line-attr for ub.ord-line-attr .
     3860       define variable v-format         as character no-undo .
     3861       define variable v-fillin_width   as integer   no-undo .
     3862       define variable v-fillin_height  as integer   no-undo .
     3863       define variable v-label          as character no-undo .
     3864       define variable v-user-can-edit  as logical   no-undo .
     3865       define variable v-output-display as logical   no-undo .
     3866       define variable v-other          as character no-undo .
     3867       define variable v-proc           as character no-undo .
     3868       define variable v-func           as character no-undo .
     3869       define variable v-sort           as integer   no-undo .
     3870       run ordlineattr-code in this-procedure
     3871         (input  p-code
     3872         ,output p-type
     3873         ,output v-format
     3874         ,output v-fillin_width
     3875         ,output v-fillin_height
     3876         ,output v-label
     3877         ,output v-user-can-edit
     3878         ,output v-output-display
     3879         ,output v-proc
     3880         ,output v-func
     3881         ,output v-sort
     3882         ,output v-other
     3883         ) no-error .
     3884       if error-status :error then do:
     3885         undo, return error return-value .
     3886       end.
     3887       find first buf_ord-line-attr no-lock
     3888         where buf_ord-line-attr.doc-code  = p-doc-code
     3889           and buf_ord-line-attr.gds-code  = p-gds-code
     3890           and buf_ord-line-attr.attr-code = p-code
     3891         no-error .
     3892       if avail buf_ord-line-attr then do:
     3893         assign
     3894           p-value =  buf_ord-line-attr.attr-value
     3895         .
     3896       end.
     3897       else do:
     3898         assign
     3899           p-value = if p-type = 'L':U then "no":U else ""
     3900         .
     3901       end.
     3902     end.
     3903   end procedure.
     3904   procedure ordlineattr-write :
     3905     do
     3906     on error undo, return error return-value
     3907     :
     3908       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     3909       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     3910       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     3911       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     3912       define buffer buf_ord-line-attr for ub.ord-line-attr .
     3913       define variable v-type           as character no-undo .
     3914       define variable v-format         as character no-undo .
     3915       define variable v-fillin_width   as integer   no-undo .
     3916       define variable v-fillin_height  as integer   no-undo .
     3917       define variable v-label          as character no-undo .
     3918       define variable v-user-can-edit  as logical   no-undo .
     3919       define variable v-output-display as logical   no-undo .
     3920       define variable v-other          as character no-undo .
     3921       define variable v-proc           as character no-undo .
     3922       define variable v-func           as character no-undo .
     3923       define variable v-sort           as integer   no-undo .
     3924       run ordlineattr-code in this-procedure
     3925         (input  p-code
     3926         ,output v-type
     3927         ,output v-format
     3928         ,output v-fillin_width
     3929         ,output v-fillin_height
     3930         ,output v-label
     3931         ,output v-user-can-edit
     3932         ,output v-output-display
     3933         ,output v-proc
     3934         ,output v-func
     3935         ,output v-sort
     3936         ,output v-other
     3937         ) no-error .
     3938       if error-status :error then do:
     3939         message
     3940           vss-workfile vss-revision vss-description skip
     3941           error-status :get-message(1) skip
     3942           return-value skip
     3943           ""
     3944           view-as alert-box error
     3945         .
     3946         undo, return error return-value .
     3947       end.
     3948       find first buf_ord-line-attr exclusive-lock
     3949         where buf_ord-line-attr.doc-code  = p-doc-code
     3950           and buf_ord-line-attr.gds-code  = p-gds-code
     3951           and buf_ord-line-attr.attr-code = p-code
     3952         no-error .
     3953       if not available buf_ord-line-attr then do:
     3954         create buf_ord-line-attr .
     3955         assign
     3956           buf_ord-line-attr.doc-code   = p-doc-code
     3957           buf_ord-line-attr.gds-code   = p-gds-code
     3958           buf_ord-line-attr.attr-code  = p-code
     3959         .
     3960       end.
     3961       assign
     3962         buf_ord-line-attr.attr-value = p-value
     3963       .
     3964   end.
     3965   end procedure.
     3966   procedure ordlineattr-exist :
     3967     do
     3968     on error undo, return error return-value
     3969     :
     3970       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     3971       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
