     4451   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4452   function context_delete-command return logical
     4453   (
     4454       input p-esys-cmd-proc-handle as handle
     4455      ,input p-esys-cmd-code as integer
     4456   ):
     4457      if valid-handle(p-esys-cmd-proc-handle )
     4458      then do:
     4459         run delete-command in p-esys-cmd-proc-handle
     4460             (input p-esys-cmd-code
     4461             ) no-error.
     4462         if error-status :error
     4463         then do:
     4464            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     4465                                                              , p-cmd-code
     4466                                                              , chr(10)
     4467                                                              , error-status:get-message(1)
     4468                                                              , return-value
     4469                                                              )).
     4470            return no .
     4471         end.
     4472         delete procedure p-esys-cmd-proc-handle no-error.
     4473         return yes.
     4474      end.
     4475      else do:
     4476         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     4477                                                       , p-cmd-code
     4478                                                       , chr(10)
     4479                                                       , error-status:get-message(1)
     4480                                                       , return-value
     4481                                                       )).
     4482         return no .
     4483      end.
     4484   end.
     4485   procedure send-stat_contour :
     4486     define input parameter p-doc-type as character no-undo .
     4487     define input parameter p-state as character no-undo .
     4488     define input parameter p-stage as character no-undo .
     4489     define input parameter p-description as character no-undo .
     4490     define input parameter p-messID as character no-undo .
     4491     define variable v-ii as integer no-undo .
     4492     define variable v-uniq-key-rec as character no-undo .
     4493     define variable v-cli-uniq-key-rec as character no-undo .
     4494     define variable v-err as logical no-undo .
     4495     define variable v-custom-pack-name as character no-undo .
     4496     define variable v-success as logical   no-undo .
     4497     DEFINE VARIABLE v-today as date no-undo .
     4498     DEFINE VARIABLE v-time as integer no-undo .
     4499     define variable v-ord-int1 as integer no-undo .
     4500     define variable v-obj-gln as character no-undo .
     4501     define variable v-cli-gln as character no-undo .
     4502     define variable v-gln-net as character no-undo .
     4503     define variable v-type as character no-undo .
     4504     define variable v-mess as character no-undo .
     4505     define variable v-b-code as integer no-undo .
     4506     define variable v-b-str as character no-undo .
     4507     define variable v-jj as integer   no-undo .
     4508     define variable v-cli-base-rate as decimal no-undo .
     4509     define variable v-dump-ord-int64 as int64 no-undo .
     4510     define variable v-rcv-code as character no-undo .
     4511     define variable v-cli-rcv-code as character no-undo .
     4512     define variable v-EDIINTERCHANGEID as character no-undo .
     4513     define variable v-edist-mess as character no-undo .
     4514     define variable v-date-status as character no-undo .
     4515     define variable v-time-status as integer no-undo .
     4516     define variable v-error as character no-undo .
     4517     define variable v-stringdate as character no-undo .
     4518     define variable v-documentNumber as character no-undo .
     4519     define variable v-documentDate as character no-undo .
     4520     define variable sw as handle no-undo .
     4521     define buffer buf_ext-system for ub.ext-system.
     4522     define buffer buf_ord-doc for ub.ord-doc.
     4523     define buffer buf_ord-line for ub.ord-line.
     4524     define buffer buf_object for ub.clients.
     4525     define buffer buf_clients for ub.clients.
     4526     define buffer buf_ext-classif for ub.ext-classif.
     4527     define buffer esys_ext-classif for ub.ext-classif.
     4528     define buffer buf_goods for ub.goods.
     4529     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     4530     define buffer buf_currency for ub.currency.
     4531     define buffer buf_ord-line-attr for ub.ord-line-attr.
     4532     define buffer buf_edi-status for ub.edi-status.
     4533   _main:
     4534   do
     4535   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4536   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4537   :
     4538     if retry then do:
     4539           .
     4540       undo _main, return error.
     4541     end.
     4542     else do:
     4543       assign
     4544       v-mess = ''
     4545       .
     4546       find first buf_ord-doc exclusive-lock where
     4547                 buf_ord-doc.doc-code = v-current-doc-code no-error .
     4548       if not available buf_ord-doc then do:
     4549         v-mess = substitute("Не найден заказ для поставки").
     4550         v-err = yes.
     4551         undo _main, retry _main.
     4552       end.
     4553       if p-doc-type = "DESADV" then do :
     4554           find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.doc-code = v-current-doc-code no-error .
     4555           if available buf_ord-doc-rcv then assign v-rcv-code = buf_ord-doc-rcv.rcv-code .
     4556       end.
     4557       find first buf_clients no-lock where
     4558                 buf_clients.obj-type = buf_ord-doc.cli-type
     4559             and buf_clients.obj-code = buf_ord-doc.cli-code no-error.
     4560       if not available buf_clients then do:
     4561         v-mess =  substitute("Не найден контрагент &1&2", buf_ord-doc.cli-type, buf_ord-doc.cli-code).
     4562         v-err = yes.
     4563         undo _main, retry _main.
     4564       end.
     4565       run gen-key-rec in this-procedure ( input 'clients':U
     4566                                         ,input (buffer buf_clients:handle)
     4567                                         ,output v-cli-uniq-key-rec) no-error .
     4568       if error-status:error then do:
     4569         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4570                                   , error-status:get-message(1)
     4571                                   , return-value
     4572                                   , chr(10)
     4573                                   , buf_ord-doc.cli-type
     4574                                   , buf_ord-doc.cli-code).
     4575         v-err = yes.
     4576         undo _main, retry _main.
     4577       end.
     4578       find first esys_ext-classif no-lock where
     4579           esys_ext-classif.classif-name = 'exite-edi':U
     4580       and esys_ext-classif.classif-subject = 'clients':U
     4581       and esys_ext-classif.db-num = -1
     4582       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     4583       if not available esys_ext-classif then do:
     4584         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", buf_ord-doc.cli-type, buf_ord-doc.cli-code).
     4585         v-err = yes.
     4586         undo _main, retry _main.
     4587       end.
     4588       find first buf_object no-lock where
     4589                 buf_object.obj-type = v-current-obj-type
     4590             and buf_object.obj-code = v-current-obj-code no-error.
     4591       if not available buf_object then do:
     4592         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     4593         v-err = yes.
     4594         undo _main, retry _main.
     4595       end.
     4596       run gen-key-rec in this-procedure ( input 'clients':U
     4597                                         ,input (buffer buf_object:handle)
     4598                                         ,output v-uniq-key-rec) no-error .
     4599       if error-status:error then do:
     4600         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4601                                   , error-status:get-message(1)
     4602                                   , return-value
     4603                                   , chr(10)
     4604                                   , buf_object.obj-type
     4605                                   , buf_object.obj-code).
     4606         v-err = yes.
     4607         undo _main, retry _main.
     4608       end.
     4609       assign
     4610       v-obj-gln = get-gln( input buf_object.obj-type
     4611                       ,input buf_object.obj-code) no-error.
     4612       if error-status:error
     4613       or v-obj-gln = chr(63)
     4614       or v-obj-gln = '' then do:
     4615         v-mess =  substitute("Не определен GLN для &1&2"
     4616                                   , buf_object.obj-type
     4617                                   , buf_object.obj-code) .
     4618         v-err = yes.
     4619         undo _main, retry _main.
     4620       end.
     4621       v-cli-gln = get-gln( input buf_ord-doc.cli-type
     4622                           ,input buf_ord-doc.cli-code) no-error.
     4623       if error-status:error
     4624       or v-cli-gln = chr(63)
     4625       or v-cli-gln = '' then do:
     4626         v-mess =  substitute("Не определен GLN для &1&2"
     4627                                   , buf_object.obj-type
     4628                                   , buf_object.obj-code) .
     4629         v-err = yes.
     4630         undo _main, retry _main.
     4631       end.
     4632       for each esys_ext-classif no-lock where
     4633           esys_ext-classif.classif-name = 'exite-edi':U
     4634       and esys_ext-classif.classif-subject = 'clients':U
     4635       and esys_ext-classif.db-num = -1
     4636       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec,
     4637         first buf_ext-system no-lock where
     4638                   buf_ext-system.esys-id = esys_ext-classif.key#_one
     4639               and buf_ext-system.db-num = 0
     4640               and buf_ext-system.esys-have-export = yes,
     4641         first buf_ext-classif no-lock where
     4642           buf_ext-classif.classif-name = 'exite-edi':U
     4643       and buf_ext-classif.classif-subject = 'clients':U
     4644       and buf_ext-classif.db-num = -1
     4645       and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec
     4646       and buf_Ext-classif.key#_one = esys_ext-classif.key#_one:
     4647         leave.
     4648       end.
     4649       if not available buf_ext-system then do:
     4650         v-mess = substitute("Для поставщика &1&2 не найдена ВС, у которой есть экспорт в текущей БД").
     4651         v-err = yes.
     4652         undo _main, retry _main.
     4653       end.
     4654       run ext-system-attr-value in this-procedure ( input buf_ext-system.esys-id
     4655                                                    ,input buf_ext-system.db-num
     4656                                                    ,input 'gln-net':U
     4657                                                    ,output v-gln-net
     4658                                                    ,output v-type) no-error.
     4659       IF  context_begin-esys-command( input string(buf_ext-system.esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     4660         undo _main, return error v-last-error-message .
     4661       end.
     4662       v-stringdate = substring(string(NOW), 7, 4) + substring(string(NOW), 4, 2) + substring(string(NOW), 1, 2)
     4663                    + substring(string(NOW), 12, 2) + substring(string(NOW), 15, 2) + substring(string(NOW), 18, 2).
     4664       v-custom-pack-name = p-state + "_" + v-stringdate + "_" + p-doc-type + "_" + buf_ord-doc.doc-code + "_&pack-num.xml".
     4665       if p-doc-type = "ORDRSP" then do :
     4666           if p-stage = "Read" then
     4667           assign
     4668               v-documentNumber = entry(1, v-cli-out-doc, chr(4))
     4669               v-documentDate = entry(2, v-cli-out-doc, chr(4))
     4670           .
     4671           else
     4672           assign
     4673               v-documentNumber = entry(1, buf_ord-doc.cli-out-doc, chr(4))
     4674               v-documentDate = entry(2, buf_ord-doc.cli-out-doc, chr(4))
     4675           .
     4676           for each buf_edi-status no-lock where
     4677                   buf_edi-status.tbl-name = 'ord-doc':U
     4678              and buf_edi-status.doc-code = v-current-doc-code
     4679              and (buf_edi-status.state = '1':U or buf_edi-status.state = '12':U or buf_edi-status.state = '6':U or buf_edi-status.state = '3':U)
     4680              and buf_edi-status.err-code < 3 :
     4681             assign
     4682               v-EDIINTERCHANGEID = cr-edist_get-mess-key-value(buf_edi-status.mess, 'ediiterchangeid':U)
     4683             .
     4684             if v-EDIINTERCHANGEID <> ? and trim(v-EDIINTERCHANGEID) <> "" then leave .
     4685           end.
     4686           for each temp-edi-status no-lock where
     4687                   temp-edi-status.tbl-name = 'ord-doc':U
     4688              and temp-edi-status.doc-code begins v-current-doc-code :
     4689             assign
     4690               v-error = v-error +
     4691                              (if v-error = '' then ''
     4692                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4693                               else if r-index(v-error, ";") = length(v-error) then ''
     4694                               else ';')
     4695                                +
     4696                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4697                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4698             .
     4699           end.
     4700           for each temp-edi-status no-lock where
     4701                   temp-edi-status.tbl-name = 'ord-line':U
     4702              and temp-edi-status.doc-code begins v-current-doc-code :
     4703             assign
     4704               v-error = v-error +
     4705                              (if v-error = '' then ''
     4706                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4707                               else if r-index(v-error, ";") = length(v-error) then ''
     4708                               else ';')
     4709                                +
     4710                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4711                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4712             .
     4713           end.
     4714       end.
     4715       if p-doc-type = "DESADV" then do :
     4716           assign
     4717               v-documentNumber = v-desadv-DELIVERYNOTENUMBER
     4718               v-documentDate = iso-date(v-desadv-DELIVERYNOTEDATE)
     4719           .
     4720           for each buf_edi-status no-lock where
     4721                   buf_edi-status.tbl-name = 'ord-doc-rcv':U
     4722              and buf_edi-status.doc-code = v-rcv-code
     4723              and buf_edi-status.state = '8':U
     4724              and buf_edi-status.err-code < 3 :
     4725             assign
     4726             v-EDIINTERCHANGEID = cr-edist_get-mess-key-value(buf_edi-status.mess, 'ediiterchangeid':U).
     4727             if v-EDIINTERCHANGEID <> ? and trim(v-EDIINTERCHANGEID) <> "" then leave .
     4728           end.
     4729           for each temp-edi-status no-lock where
     4730                   temp-edi-status.tbl-name = 'ord-doc':U
     4731              and temp-edi-status.doc-code begins v-current-doc-code :
     4732             assign
     4733               v-error = v-error +
     4734                              (if v-error = '' then ''
     4735                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4736                               else if r-index(v-error, ";") = length(v-error) then ''
     4737                               else ';')
     4738                                +
     4739                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4740                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4741             .
     4742           end.
     4743           for each temp-edi-status no-lock where
     4744                   temp-edi-status.tbl-name = 'ord-line':U
     4745              and temp-edi-status.doc-code begins v-current-doc-code :
     4746             assign
     4747               v-error = v-error +
     4748                              (if v-error = '' then ''
     4749                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4750                               else if r-index(v-error, ";") = length(v-error) then ''
     4751                               else ';')
     4752                                +
     4753                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4754                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4755             .
     4756           end.
     4757           for each temp-edi-status no-lock where
     4758                   temp-edi-status.tbl-name = 'ord-doc-rcv':U
     4759              and temp-edi-status.doc-code begins v-rcv-code :
     4760             assign
     4761               v-error = v-error +
     4762                              (if v-error = '' then ''
     4763                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4764                               else if r-index(v-error, ";") = length(v-error) then ''
     4765                               else ';')
     4766                                +
     4767                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4768                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4769             .
     4770           end.
     4771           for each temp-edi-status no-lock where
     4772                   temp-edi-status.tbl-name = 'ord-line-rcv':U
     4773              and temp-edi-status.doc-code begins v-rcv-code :
     4774             assign
     4775               v-error = v-error +
     4776                              (if v-error = '' then ''
     4777                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4778                               else if r-index(v-error, ";") = length(v-error) then ''
     4779                               else ';')
     4780                                +
     4781                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4782                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4783             .
     4784           end.
     4785       end.
     4786       if v-EDIINTERCHANGEID <> ? and v-EDIINTERCHANGEID <> "" and p-messID = ? then p-messID = v-EDIINTERCHANGEID .
     4787       if p-messID = ? then p-messID = "" .
     4788       create sax-writer sw .
     4789       sw:formatted = true.
     4790       sw:set-output-destination ("memptr", v-DATA).
     4791       sw:encoding = "UTF-8".
     4792       sw:start-document () .
     4793       sw:start-element ("statusReport") .
     4794           sw:write-data-element ("reportDateTime", substring(iso-date(NOW), 1, 23) + "Z") .
     4795           sw:write-data-element ("reportRecipient", v-cli-gln) .
     4796           sw:start-element ("reportItem") .
     4797               sw:write-data-element ("messageId", p-messID) .
     4798               sw:write-data-element ("documentId", p-messID) .
     4799               sw:write-data-element ("messageSender", v-cli-gln) .
     4800               sw:write-data-element ("messageRecepient", v-gln-net) .
     4801               sw:write-data-element ("documentType", p-doc-type) .
     4802               sw:write-data-element ("documentNumber", v-documentNumber) .
     4803               sw:write-data-element ("documentDate", v-documentDate) no-error .
     4804               sw:start-element ("statusItem") .
     4805                   sw:write-data-element ("dateTime", substring(iso-date(NOW), 1, 23) + "Z") .
     4806                   sw:write-data-element ("stage", p-stage) .
     4807                   sw:write-data-element ("state", p-state) .
     4808                   sw:write-data-element ("description", p-description) .
     4809                   if p-stage = "Checking" and p-state = "Ok" and p-description = "Сообщение отклонено на стороне получателя" then
     4810                   do :
     4811                       sw:write-data-element ("error", "Заказ УЖЕ в статусе Подтвержден или ПодтвержденОК") .
     4812                   end.
     4813                   else if p-stage = "Checking" and p-state = "Fail" and p-doc-type = "DESADV" and p-description = "Сообщение отклонено на стороне получателя в УБД" then
     4814                   do :
     4815                       sw:write-data-element ("error", "Поставка уже в работе в УБД") .
     4816                   end.
     4817                   else if p-state = "Fail" then
     4818                   do :
     4819                       v-error = replace(v-error, chr(4), " ") .
     4820                       v-error = replace(v-error, ";", "; ") .
     4821                       if trim(v-error) <> "" then
     4822                       do v-ii = 1 to num-entries(v-error, chr(30) ):
     4823                           if trim(entry(v-ii, v-error, chr(30) )) <> "" then
     4824                           sw:write-data-element ("error", trim(entry(v-ii, v-error, chr(30)))) .
     4825                       end.
     4826                   end.
     4827                   else do :
     4828                   end.
     4829               sw:end-element ("statusItem") .
     4830           sw:end-element ("reportItem") .
     4831       sw:end-element ("statusReport") .
     4832       sw:end-document () .
     4833       delete object sw.
     4834       IF ExpData1:esys-add-dump-data ( INPUT v-DATA, INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4835         undo _main, return error v-last-error-message .
     4836       end.
     4837       IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4838         undo _main, return error v-last-error-message .
     4839       end.
     4840       v-dump-ord-int64 = context_send-esys-command( input string(buf_ext-system.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid).
     4841       if v-dump-ord-int64 = 0 THEN do:
     4842         undo _main, return error v-last-error-message .
     4843       end.
     4844       v-edist-mess = ''.
     4845       v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'route':U, string(v-dump-ord-int64)).
     4846       v-date-status = ?.
     4847       run create-edi-state in this-procedure (
     4848                                               input 'ord-doc-rcv':U
     4849                                             , input v-rcv-code
     4850                                             , input buf_ord-doc.cli-type
     4851                                             , input buf_ord-doc.cli-code
     4852                                             , input 'ИЗМЕНЕНИЕ':U
     4853                                             , input buf_ord-doc.ord-int1
     4854                                             , input integer('0':U)
     4855                                             , input buf_ord-doc.PS
     4856                                             , input v-edist-mess
     4857                                             , input integer('2':U)
     4858                                             , input-output v-date-status
     4859                                             , input-output v-time-status
     4860                                             ).
     4861           ExpData1:Route-data_clear-data ( ) .
     4862     end.
     4863   end.
     4864   end procedure.
     4865               run send-stat_contour ( input "ORDRSP"
     4866                                       ,input "OK"
     4867                                       ,input "checking"
     4868                                       ,input "Сообщение принято"
     4869                                       ,input ?) .
     4870             end.
     4871             else
     4872               assign
     4873                   shar_ord-doc.ord-int1 = integer('5':U)
     4874               .
     4875           end.
     4876           run cus/ord-clos.p
     4877             ( input  parParentProc
     4878             , input  recid(shar_ord-doc)
     4879             , input  shar_ord-doc.obj-type
     4880             , input  shar_ord-doc.obj-code
     4881             , input  v-cntxt-db-num
     4882             , input  true
     4883             , input  "no"
     4884             ) no-error .
     4885           if error-status :error or return-value <> "" then do:
     4886               message return-value         skip
     4887               error-status :get-message(1) skip
     4888               view-as alert-box error
     4889               title "Закрытие заказа"
     4890             .
     4891             return  .
     4892           end.
     4893           if p-dm-edi <> integer('9':U) then do :
     4894               run cus/edocsord.p (  input parParentProc
     4895                                     ,input recid(shar_ord-doc)
     4896                                     ,input 'ord-doc':U
     4897                                     ,input yes
     4898                                     ) no-error  .
     4899               if error-status :error or
     4900               (shar_ord-doc.whole-send-news = integer('1':U)
     4901               and shar_ord-doc.ord-int1 <> integer('5':U))
     4902               or
     4903               (shar_ord-doc.whole-send-news = integer('2':U)
     4904               and p-dm-edi = integer('5':U)
     4905               and not shar_ord-doc.ord-int1 = integer('5':U)
     4906               )
     4907               then do:
     4908                 message
     4909                 "Не удалось отправить заказ !" view-as alert-box information .
     4910                 shar_ord-doc.status_ = 'новый':U .
     4911               end.
     4912           end.
     4913         end.
     4914         when 2 then do:
     4915           if is-edoc-nn-doc then do :
     4916            assign
     4917            shar_ord-doc.ord-int1 = integer('0':U)
     4918            shar_ord-doc.ord-int2 = integer('1':U)
     4919            .
     4920           end.
     4921           if is-edi-doc then do :
     4922               if p-dm-edi = integer('9':U) then
     4923                   assign shar_ord-doc.ord-int1 = integer('1':U) .
     4924               else
     4925                   assign
     4926                     shar_ord-doc.ord-int1 = integer('4':U)
     4927                     shar_ord-doc.ord-int2 = integer('1':U)
     4928                   .
     4929             run cus/edocsord.p (  input parParentProc
     4930                                   ,input recid(shar_ord-doc)
     4931                                   ,input 'ord-doc':U
     4932                                   ,input yes
     4933                                   ) no-error  .
     4934             if error-status :error or
     4935               (shar_ord-doc.whole-send-news = integer('2':U)
     4936               and p-dm-edi = integer('5':U)
     4937               and shar_ord-doc.ord-int1 <> integer('4':U)
     4938               )
     4939             or (shar_ord-doc.whole-send-news = integer('2':U)
     4940               and p-dm-edi = integer('9':U)
     4941               and shar_ord-doc.ord-int1 <> integer('1':U)
     4942               )
     4943             then do:
     4944               message
     4945               "Не удалось отправить заказ !" view-as alert-box information .
     4946               shar_ord-doc.status_ = 'новый':U .
     4947             end.
     4948           end.
     4949         end.
     4950         when 3 then do:
     4951         end.
     4952       end case.
     4953     end.
     4954   end.
     4955   run proc-fin in this-procedure .
     4956   return .
     4957    procedure proc-fin :
     4958      do
     4959      on error undo, return error return-value
     4960      :
     4961         for each tmp#zakaz      :   delete tmp#zakaz     . end .
     4962         for each tmp#zakaz-dtl  :   delete tmp#zakaz-dtl . end .
     4963         t-ret =  session:set-wait-state("") .
     4964      end.
     4965    end procedure.
     4966   procedure display-line-process :
     4967   define input parameter p-num-rec as integer no-undo .
     4968   define parameter buffer buf_ord-line for ub.ord-line.
     4969   do
     4970   on error undo, return error
     4971   :
     4972     if  p-num-rec modulo 10 = 0 then do:
     4973       run waitfram-show in this-procedure ( input "Просмотрено &1 строк", p-num-rec ).
     4974     end.
     4975   end.
     4976   end procedure.
