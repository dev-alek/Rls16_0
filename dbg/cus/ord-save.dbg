      883   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      884   procedure ver-clients-calc :
      885   define input  parameter p-cli-type as character no-undo .
      886   define input  parameter p-cli-code as integer   no-undo .
      887   define input  parameter p-obj-type as character no-undo .
      888   define input  parameter p-obj-code as integer   no-undo .
      889   define input  parameter p-method   as character no-undo .
      890   define output parameter p-error    as logical   no-undo .
      891   define variable v-not-corr-op as character no-undo .
      892   define variable v-type as character no-undo .
      893     do
      894     on error undo, return error return-value
      895     :
      896    p-error = false .
      897    v-not-corr-op  = 'no' .
      898    run clntattr-value (
      899       input   p-obj-type
      900     , input   p-obj-code
      901     , input   'not-corr-op':U
      902     , output  v-not-corr-op
      903     , output  v-type
      904     ) no-error .
      905     if error-status :error then v-not-corr-op  = 'no' .
      906     if v-not-corr-op = 'yes' and  p-method = ""  then do:
      907       assign v-not-corr-op = 'no' .
      908       run clntattr-value (
      909       input   p-cli-type
      910     , input   p-cli-code
      911     , input   'not-corr-op':U
      912     , output  v-not-corr-op
      913     , output  v-type
      914     ) no-error .
      915     if error-status :error then v-not-corr-op  = 'no' .
      916     if v-not-corr-op = 'yes'  and  p-method = ""  then p-error = true .
      917     end.
      918     end.
      919   end procedure.
      920   procedure ver-ord-line :
      921   define input parameter  p-doc-code like ub.ord-doc.doc-code no-undo .
      922   define output parameter p-error    as logical               no-undo .
      923   define variable v-longchar          as longchar  no-undo .
      924   define variable v-err-ext           as logical   no-undo .
      925   define variable var-ok-assort-pol   as logical   no-undo .
      926   define variable var-mess-assort-pol as character no-undo .
      927   define variable v-event-code        as character no-undo .
      928   define variable v-ok                as logical   no-undo .
      929   define variable v-nabor             as logical   no-undo .
      930   define buffer buf_ord-line for ub.ord-line.
      931   define buffer buf_ord-doc  for ub.ord-doc.
      932   v-err-ext  = false .
      933   find first buf_ord-doc no-lock
      934     where buf_ord-doc.doc-code = p-doc-code no-error.
      935     if not available buf_ord-doc then do:
      936     end.
      937     else do:
      938   for each buf_ord-line of buf_ord-doc
      939     break by buf_ord-line.cli-art :
      940       if buf_ord-doc.doc-type <> 'ПО':U  and
      941          buf_ord-doc.doc-type <> 'ФП':U  then do:
      942          var-ok-assort-pol = true .
      943          v-event-code = buf_ord-doc.doc-type + "-" .
      944   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
