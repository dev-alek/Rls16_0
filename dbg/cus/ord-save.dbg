     3139     end.
     3140   end procedure.
     3141   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3142   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3143   define variable tempcxml_v-num_ as integer no-undo .
     3144   define  temp-table temp-xml-tables no-undo
     3145   field order as integer
     3146   field tbl-name as character
     3147   field tbl-handle_ as handle
     3148   field table-handle_ as handle
     3149   field uniq-gate-rec as character
     3150   field gate-name as character
     3151   field gate-handle_ as handle
     3152   field is-parent as logical
     3153   index pi is unique primary
     3154   uniq-gate-rec
     3155   tbl-name
     3156   index iorder
     3157   order
     3158   index gr
     3159   uniq-gate-rec
     3160   index gh
     3161   gate-handle_
     3162   index iparent
     3163   is-parent
     3164   .
     3165   define  temp-table temp-xml-records no-undo
     3166   field tbl-name as character
     3167   field uniq-key-rec as character
     3168   index pi is unique primary
     3169   tbl-name
     3170   uniq-key-rec
     3171   .
     3172   def var vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3173   procedure get-gate-file-name :
     3174   define input parameter p-gate-rec as character no-undo .
     3175   define output  parameter p-gate-file-name as character no-undo .
     3176   define buffer buf_clob-data for ub.clob-data.
     3177   define variable v-tbl-row as rowid no-undo .
     3178   define variable v-tbl-name as character no-undo .
     3179   run gen-row-keyr in this-procedure ( input p-gate-rec
     3180                                       ,input ?
     3181                                       ,input "ub"
     3182                                       ,input ?
     3183                                       ,input no-lock
     3184                                       ,output v-tbl-row
     3185                                       ,output v-tbl-name) no-error.
     3186   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     3187                                                           ,vss-include-info27
     3188                                                           ,p-gate-rec).
     3189   find first buf_clob-data no-lock where
     3190             rowid(buf_clob-data) = v-tbl-row no-error.
     3191   if not available buf_clob-data then do:
     3192     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     3193                                                             ,vss-include-info27
     3194                                                             ,p-gate-rec).
     3195   end.
     3196   p-gate-file-name = buf_clob-data.file-name.
     3197   end procedure.
     3198   procedure get-gate-rec :
     3199   define input  parameter p-gate-name as character no-undo .
     3200   define output parameter p-gate-rec as character no-undo .
     3201   define buffer buf_clob-bind for ub.clob-bind.
     3202   define buffer buf_clob-data for ub.clob-data.
     3203   main-block:
     3204   do
     3205   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info27, return-value, chr(10), error-status :get-message (1))
     3206   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info27 )
     3207   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info27 )
     3208   :
     3209       find first buf_clob-bind no-lock where
     3210                 buf_clob-bind.uniq-key-rec = p-gate-name
     3211             and buf_clob-bind.field-name = '':U
     3212             and buf_clob-bind.part-num = 1
     3213             and buf_clob-bind.resource-type = 'gate':U
     3214             no-error.
     3215       if not available buf_clob-bind then do:
     3216         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     3217                                         , p-gate-name
     3218                                         ).
     3219       end.
     3220       find first buf_clob-data no-lock where
     3221                 buf_clob-data.db-num = buf_clob-bind.db-num
     3222             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     3223       if not available buf_clob-data then do:
     3224         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     3225                                         , buf_clob-bind.db-num
     3226                                         , buf_clob-bind.int64-id
     3227                                         , p-gate-name
     3228                                         ).
     3229       end.
     3230       run gen-key-rec in this-procedure ( input 'clob-data':U
     3231                                 ,input buffer buf_clob-data:handle
     3232                                 ,output p-gate-rec).
     3233   end.
     3234   end procedure.
     3235   procedure get-gate-by-name :
     3236   define input  parameter p-gate-name as character no-undo .
     3237   define output parameter p-gate-rec as character no-undo .
     3238   define output parameter p-dsh as handle no-undo .
     3239   define input-output  parameter p-xmlh as handle no-undo .
     3240   define variable v-ii as integer   no-undo .
     3241   define variable glog as logical   no-undo .
     3242   define variable v-longchar as longchar no-undo .
     3243   define variable v-txmlh as handle no-undo .
     3244   define variable v-db-num as integer no-undo .
     3245   define variable v-int64-id as int64 no-undo .
     3246   define buffer buf_clob-bind for ub.clob-bind.
     3247   define buffer buf_clob-data for ub.clob-data.
     3248   main-block:
     3249   do
     3250   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info27, return-value, chr(10), error-status :get-message (1))
     3251   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info27 )
     3252   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info27 )
     3253   :
     3254       find first buf_clob-bind no-lock where
     3255                 buf_clob-bind.uniq-key-rec = p-gate-name
     3256             and buf_clob-bind.field-name = '':U
     3257             and buf_clob-bind.part-num = 1
     3258             and buf_clob-bind.resource-type = 'gate':U
     3259             no-error.
     3260       if not available buf_clob-bind then do:
     3261         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     3262                                         , p-gate-name
     3263                                         ).
     3264       end.
     3265       find first buf_clob-data no-lock where
     3266                 buf_clob-data.db-num = buf_clob-bind.db-num
     3267             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     3268       if not available buf_clob-data then do:
     3269         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     3270                                         , buf_clob-bind.db-num
     3271                                         , buf_clob-bind.int64-id
     3272                                         , p-gate-name
     3273                                         ).
     3274       end.
     3275       assign
     3276       v-longchar = buf_clob-data.cdata
     3277       .
     3278       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3279       if error-status :error then do:
     3280         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3281       end.
     3282       create dataset p-dsh .
     3283       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     3284                                     , v-longchar
     3285                                     , ?
     3286                                     , ?
     3287                                     , ?
     3288                                     ) no-error.
     3289       v-longchar = '':U.
     3290       if error-status :error
     3291       or not glog
     3292       then do:
     3293         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     3294       end.
     3295       if not valid-handle(p-xmlh)
     3296       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     3297         create temp-table v-txmlh.
     3298         v-txmlh:create-like(buffer temp-xml-tables:handle).
     3299         v-txmlh:temp-table-prepare("temp-xml-tables").
     3300         p-xmlh = v-txmlh:default-buffer-handle.
     3301       end.
     3302       run gen-key-rec in this-procedure ( input 'clob-data':U
     3303                                 ,input buffer buf_clob-data:handle
     3304                                 ,output p-gate-rec).
     3305       do v-ii = 1 to p-dsh:num-buffers:
     3306         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     3307         if not p-xmlh:available then do:
     3308           p-xmlh:buffer-create().
     3309           assign
     3310           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     3311           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3312           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3313           p-xmlh::gate-handle_ = p-dsh
     3314           p-xmlh::uniq-gate-rec = p-gate-rec
     3315           p-xmlh::gate-name = p-dsh:name
     3316           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3317           .
     3318           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3319             assign
     3320             p-xmlh::order = -3.
     3321           end.
     3322         end.
     3323       end.
     3324   end.
     3325   end procedure.
     3326   procedure get-gate-by-rec :
     3327   define input  parameter p-gate-rec as character no-undo .
     3328   define output parameter p-dsh as handle no-undo .
     3329   define input-output  parameter p-xmlh as handle no-undo .
     3330   define input-output parameter p-longchar  as longchar no-undo .
     3331   define variable v-ii as integer   no-undo .
     3332   define variable glog as logical   no-undo .
     3333   define variable v-rowid as rowid no-undo .
     3334   define variable v-tbl-name as character no-undo .
     3335   define variable v-longchar as longchar no-undo .
     3336   define variable v-txmlh as handle no-undo .
     3337   define buffer buf_clob-data for ub.clob-data.
     3338   main-block:
     3339   do
     3340   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info27, return-value, chr(10), error-status :get-message (1))
     3341   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info27 )
     3342   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info27 )
     3343   :
     3344     run gen-row-keyr in this-procedure (
     3345                                           input  p-gate-rec
     3346                                           ,input  ?
     3347                                           ,input  "ub"
     3348                                           ,input  ?
     3349                                           ,input  NO-LOCK
     3350                                           ,output v-rowid
     3351                                           ,output v-tbl-name   ) no-error.
     3352       find first buf_clob-data no-lock where
     3353                 rowid(buf_clob-data) = v-rowid  no-error.
     3354       if not available buf_clob-data then do:
     3355         undo, return error substitute("Не найден CLOB  &1"
     3356                                         , p-gate-rec
     3357                                         ).
     3358       end.
     3359       assign
     3360       v-longchar = buf_clob-data.cdata
     3361       .
     3362       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3363       if error-status :error then do:
     3364         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3365       end.
     3366       create dataset p-dsh .
     3367       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     3368                                     , v-longchar
     3369                                     , ?
     3370                                     , ?
     3371                                     , ?
     3372                                     ) no-error.
     3373       define variable v-esm as character no-undo .
     3374       v-esm = error-status:get-message(1) .
     3375       if p-longchar <> ? then do:
     3376         p-longchar = v-longchar.
     3377       end.
     3378       v-longchar = '':U.
     3379       if error-status :error
     3380       or not glog
     3381       then do:
     3382         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     3383                                      , p-gate-rec
     3384                                      , p-gate-rec
     3385                                      , v-esm
     3386                                      ).
     3387       end.
     3388       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     3389       if not valid-handle(p-xmlh)
     3390       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     3391         create temp-table v-txmlh.
     3392         v-txmlh:create-like(buffer temp-xml-tables:handle).
     3393         v-txmlh:temp-table-prepare("temp-xml-tables").
     3394         p-xmlh = v-txmlh:default-buffer-handle.
     3395       end.
     3396       do v-ii = 1 to p-dsh:num-buffers:
     3397         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     3398         if not p-xmlh:available then do:
     3399           p-xmlh:buffer-create().
     3400           assign
     3401           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     3402           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3403           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3404           p-xmlh::gate-handle_ = p-dsh
     3405           p-xmlh::uniq-gate-rec = p-gate-rec
     3406           p-xmlh::gate-name = p-dsh:name
     3407           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3408           .
     3409           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3410             assign
     3411             p-xmlh::order = -3.
     3412           end.
     3413           p-xmlh:buffer-release().
     3414         end.
     3415       end.
     3416   end.
     3417   end procedure.
     3418   procedure get-gate-by-file :
     3419   define input  parameter p-schema-file-name as character no-undo .
     3420   define input  parameter p-gate-rec as character no-undo .
     3421   define output parameter p-dsh as handle no-undo .
     3422   define input-output  parameter p-xmlh as handle no-undo .
     3423   define variable v-ii as integer   no-undo .
     3424   define variable glog as logical   no-undo .
     3425   define variable v-rowid as rowid no-undo .
     3426   define variable v-tbl-name as character no-undo .
     3427   define variable v-longchar as longchar no-undo .
     3428   define variable v-txmlh as handle no-undo .
     3429   main-block:
     3430   do
     3431   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info27, return-value, chr(10), error-status :get-message (1))
     3432   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info27 )
     3433   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info27 )
     3434   :
     3435       COPY-LOB
     3436       FROM  FILE p-schema-file-name
     3437       TO  OBJECT v-longchar
     3438       no-convert
     3439       NO-ERROR .
     3440       if error-status :error then do:
     3441           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     3442                                     , p-schema-file-name
     3443                                 , chr(10)
     3444                                 , error-status:get-message(1) ).
     3445       end.
     3446       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3447       if error-status :error then do:
     3448         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     3449       end.
     3450       create dataset p-dsh .
     3451       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     3452                                     , v-longchar
     3453                                     , ?
     3454                                     , ?
     3455                                     , ?
     3456                                     ) no-error.
     3457       v-longchar = ''.
     3458       if error-status :error
     3459       or not glog
     3460       then do:
     3461         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     3462                                      , p-schema-file-name
     3463                                      ,chr(10)
     3464                                      , error-status:get-message(1)
     3465                                      ).
     3466       end.
     3467       if not valid-handle(p-xmlh)
     3468       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     3469         create temp-table v-txmlh.
     3470         v-txmlh:create-like(buffer temp-xml-tables:handle).
     3471         v-txmlh:temp-table-prepare("temp-xml-tables").
     3472         p-xmlh = v-txmlh:default-buffer-handle.
     3473       end.
     3474       do v-ii = 1 to p-dsh:num-buffers:
     3475         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     3476                                      ,p-dsh:get-buffer-handle(v-ii):name
     3477                                      ,p-gate-rec
     3478                                      )) no-error.
     3479         if not p-xmlh:available then do:
     3480           p-xmlh:buffer-create().
     3481           assign
     3482           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     3483           p-xmlh::uniq-gate-rec = p-gate-rec
     3484           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3485           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3486           p-xmlh::gate-handle_ = p-dsh
     3487           p-xmlh::gate-name = p-dsh:name
     3488           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3489           .
     3490           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3491             assign
     3492             p-xmlh::order = -3.
     3493           end.
     3494           p-xmlh:buffer-release().
     3495         end.
     3496       end.
     3497   end.
     3498   end procedure.
     3499   procedure gate-clear :
     3500   define input  parameter p-dsh as handle no-undo .
     3501   define input  parameter p-xmlh as handle no-undo .
     3502   define variable v-dsh as handle no-undo .
     3503   define variable v-th as handle no-undo .
     3504     do
     3505     on error undo, return error return-value
     3506     :
     3507       if valid-handle(p-dsh) then do:
     3508         delete object p-dsh.
     3509         v-dsh = p-dsh.
     3510         p-dsh = ?.
     3511       end.
     3512       repeat while true:
     3513         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     3514                            , share-lock) no-error.
     3515         if p-xmlh:available then do:
     3516           assign
     3517           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     3518           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     3519           and valid-handle(v-th)
     3520           and v-th:dynamic = yes
     3521           then do:
     3522             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     3523             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     3524           end.
     3525           p-xmlh:buffer-delete().
     3526         end.
     3527         else do:
     3528           leave.
     3529         end.
     3530       end.
     3531       if p-xmlh:dynamic = yes
     3532       and valid-handle(p-xmlh)
     3533       then do:
     3534         delete object p-xmlh:table-handle.
     3535         p-xmlh = ?.
     3536       end.
     3537       v-dsh = ?.
     3538     end.
     3539   end procedure.
     3540   procedure all-gates-clear :
     3541   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     3542   do
     3543   on error undo, return error
     3544   :
     3545     for each buf_temp-xml-tables
     3546     break
     3547     by buf_temp-xml-tables.uniq-gate-rec
     3548     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3549     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3550     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3551     :
     3552         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     3553           delete object buf_temp-xml-tables.gate-handle_.
     3554           buf_temp-xml-tables.gate-handle_ = ?.
     3555         end.
     3556         if valid-handle(buf_temp-xml-tables.table-handle_)
     3557         and buf_temp-xml-tables.table-handle_:dynamic = no
     3558         then do:
     3559           delete object buf_temp-xml-tables.table-handle_.
     3560           buf_temp-xml-tables.table-handle_ = ?.
     3561         end.
     3562         delete buf_temp-xml-tables.
     3563     end.
     3564   end.
     3565   end procedure.
     3566   procedure fix-schemalocation :
     3567   define input-output  parameter p-longchar as longchar no-undo .
     3568   DEFINE VARIABLE hdoc AS HANDLE.
     3569   DEFINE VARIABLE hroot AS HANDLE.
     3570   DEFINE VARIABLE hnode-child AS HANDLE.
     3571   DEFINE VARIABLE hnode-attr AS HANDLE.
     3572   define variable v-jj as integer   no-undo .
     3573   define variable ok as logical   no-undo .
     3574   define variable v-path1                    as character                no-undo .
     3575   DEFINE VARIABLE v-full-path1               as character                no-undo .
     3576   DEFINE VARIABLE v-file-name1               as character                no-undo .
     3577   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     3578   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     3579   define variable v-schema-location          as character                no-undo .
     3580   do
     3581   on error undo, return error return-value
     3582   :
     3583     CREATE X-DOCUMENT hdoc.
     3584     CREATE X-noderef hroot.
     3585     CREATE X-noderef hnode-child.
     3586     CREATE X-noderef hnode-attr.
     3587     hdoc:load("longchar", p-longchar, no) no-error.
     3588     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     3589     hdoc:get-document-element(hroot).
     3590     _repeat:
     3591     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     3592       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     3593       if not ok then next.
     3594       if hNode-Child:local-name = "include"
     3595       then do:
     3596         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     3597           v-schema-location = hnode-attr:node-value.
     3598           run gbl/filename.p (
     3599                           input "exe/" + hnode-attr:node-value
     3600                         ,output v-full-path1
     3601                         ,output v-path1
     3602                         ,output v-file-name1
     3603                         ,output v-file-name-no-ext1
     3604                         ,output v-file-name-ext1
     3605                         ) no-error .
     3606           if error-status :error then do:
     3607             delete object hnode-attr.
     3608             delete object hnode-child.
     3609             delete object hroot.
     3610             delete object hdoc.
     3611             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     3612           end.
     3613         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     3614         leave  _repeat.
     3615       end.
     3616     END.
     3617     hdoc:save("longchar", p-longchar).
     3618     delete object hnode-attr.
     3619     delete object hnode-child.
     3620     delete object hroot.
     3621     delete object hdoc.
     3622   end.
     3623   end procedure.
     3624   procedure gate-clb_fill-xml-tables :
     3625   define input parameter p-dsh as handle no-undo .
     3626   define input-output parameter p-xmlh as handle no-undo .
     3627   define variable v-ii as integer no-undo .
     3628     do
     3629     on error undo, return error
     3630     :
     3631       do v-ii = 1 to p-dsh:num-buffers:
     3632         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     3633         if not p-xmlh:available then do:
     3634           p-xmlh:buffer-create().
     3635           assign
     3636           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     3637           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3638           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3639           p-xmlh::gate-handle_ = p-dsh
     3640           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     3641           p-xmlh::gate-name = p-dsh:name
     3642           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3643           .
     3644           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3645             assign
     3646             p-xmlh::order = -3.
     3647           end.
     3648           p-xmlh:buffer-release().
     3649         end.
     3650       end.
     3651     end.
     3652   end procedure.
     3653   procedure all-gates-empty :
     3654   define buffer buf_temp-xml-tables for temp-xml-tables.
     3655   do
     3656   on error undo, return error
     3657   :
     3658     for each buf_temp-xml-tables
     3659     break
     3660     by buf_temp-xml-tables.uniq-gate-rec
     3661     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3662     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3663     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3664     :
     3665       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     3666         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     3667       end.
     3668     end.
     3669   end.
     3670   end procedure.
