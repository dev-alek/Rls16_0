     2289       run ord-savl_ver-gds-flor in this-procedure ( input buf_goods.gds-code
     2290                                           , output v-nabor ) no-error .
     2291       if v-nabor = true then do:
     2292         undo main-block, return error substitute("&1 &2 &3&4"  +
     2293                                                 "Заказ &5&4 Артикул &6 &7&8&4 &9&4"  +
     2294                                                 "является набором (букет) !!!&4" +
     2295                                                 "Удалите его из списка товаров !"
     2296                                                 ,vss-workfile
     2297                                                 ,vss-revision
     2298                                                 ,vss-description
     2299                                                 ,chr(10)
     2300                                                 ,buf_ord-line.doc-code
     2301                                                 ,buf_ord-line.artic
     2302                                                 ,buf_ord-line.prod-type
     2303                                                 ,buf_ord-line.prod-code
     2304                                                 ,buf_goods.gds-name ).
     2305       end.
     2306       if buf_goods.gds-type =  'у':U  then do:
     2307         undo main-block, return error substitute("&1 &2 &3&4"  +
     2308                                                 "Заказ &5&4 Артикул &6 &7&8&4 &9&4"  +
     2309                                                 "является услугой !!!&4" +
     2310                                                 "Удалите его из списка товаров !"
     2311                                                 ,vss-workfile
     2312                                                 ,vss-revision
     2313                                                 ,vss-description
     2314                                                 ,chr(10)
     2315                                                 ,buf_ord-line.doc-code
     2316                                                 ,buf_ord-line.artic
     2317                                                 ,buf_ord-line.prod-type
     2318                                                 ,buf_ord-line.prod-code
     2319                                                 ,buf_goods.gds-name ).
     2320       end.
     2321       assign
