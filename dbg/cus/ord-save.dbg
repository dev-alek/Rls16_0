     4014     do
     4015     on error undo, return error return-value
     4016     :
     4017       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     4018       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
