     2347       undo main-block, return error substitute("&1 &2 &3&4Количество по признакам больше чем по строке товара&4" +
     2348                                               "Заказ &5&4 Артикул &6 &7&8&4 &9&4"  +
     2349                                               "является услугой !!!&4" +
     2350                                               "Удалите его из списка товаров !"
     2351                                               ,vss-workfile
     2352                                               ,vss-revision
     2353                                               ,vss-description
     2354                                               ,chr(10)
     2355                                               ,buf_ord-line.doc-code
     2356                                               ,buf_ord-line.artic
     2357                                               ,buf_ord-line.prod-type
     2358                                               ,buf_ord-line.prod-code
     2359                                               ,buf_goods.gds-name ).
     2360     end.
     2361   end.
     2362   end procedure .
     2363   procedure ord-savl_ver-gds-flor :
     2364   define input  parameter  p-gds-code as integer   no-undo .
     2365   define output parameter  p-nabor   as logical   no-undo .
     2366   main-block:
     2367   do
     2368   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2369   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2370   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2371   :
     2372     p-nabor = false .
     2373     run ver-gds-grp-nabor in this-procedure ( input p-gds-code, output p-nabor) .
     2374   end.
     2375   end procedure.
     2376   procedure ord-savl_del-str-info :
     2377   define input   parameter p-str1    as character no-undo .
     2378   define input   parameter p-str-dop as character no-undo .
     2379   define output  parameter p-str2    as character no-undo .
     2380   main-block:
     2381   do
     2382   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2383   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2384   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2385   :
     2386     p-str1     = trim  (p-str1   ) .
     2387     p-str-dop  = trim  (p-str-dop) .
     2388     p-str1     = trim  (p-str1   ,chr(10) ) .
     2389     p-str-dop  = trim  (p-str-dop,chr(10) ) .
     2390     if length (p-str1) + length (p-str-dop )     >=  2000  then do:
     2391       p-str2 = substitute ("&1 вся информация не умещается...." , p-str1 ) .
     2392       return .
     2393     end.
     2394     p-str2  = substitute ("&1&3&2" , p-str1, p-str-dop ,chr(10) ) .
     2395   end.
     2396   end procedure.
     2397   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2398   define variable v-waitfram-action01         as character   no-undo .
     2399   define variable v-waitfram-action02         as character   no-undo .
     2400   define variable v-waitfram-action03         as character   no-undo .
     2401   define variable mWaitFramTextBeg            as character   no-undo.
     2402   define variable mWaitFramTextEnd            as character   no-undo.
     2403   define variable mWaitFramView               as logical     no-undo.
     2404   define variable mWaitProcEvent              as logical     no-undo init yes.
     2405   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2406   define variable mWaitFramStop               as logical     no-undo.
     2407   define variable mWaitFramStopUser           as logical     no-undo.
     2408   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2409   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2410   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2411   define button B-WaitFramStop auto-end-key
     2412        label "Стоп"
     2413        size 10 by 1 tooltip "Остоновить процесс".
     2414   define button B-viewProcInfo
     2415        label "Информация"
     2416        size 15 by 1 tooltip "Информация о процесс".
     2417   define frame waitfram
     2418     v-waitfram-action01 format "x(72)" no-label skip
     2419     v-waitfram-action02 format "x(72)" no-label skip
     2420     v-waitfram-action03 format "x(72)" no-label skip
     2421     B-viewProcInfo
     2422     B-WaitFramStop at row 4 col 30
     2423     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2424     .
     2425   define new global shared variable mBatchMode as logical no-undo init ?.
     2426   define variable mFramBachModHandle as handle no-undo.
     2427   mFramBachModHandle = frame waitfram:handle.
     2428   define variable mFameOldVis as logical no-undo.
     2429   define variable mVisCUrentVin as logical no-undo.
     2430   if session:batch-mode
     2431   then
     2432      mBatchMode = yes.
     2433   if mBatchMode = ? then do:
     2434     mVisCUrentVin = current-window:visible.
     2435     mFameOldVis = mFramBachModHandle:visible.
     2436     mFramBachModHandle:visible  = yes.
     2437     mBatchMode = mFramBachModHandle:visible ne yes.
     2438     mFramBachModHandle:visible = mFameOldVis.
     2439     current-window:visible = mVisCUrentVin.
     2440   end.
     2441    if  log-manager:logfile-name ne ?
     2442     then DO:
     2443         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2444         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2445         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2446     end.
     2447   on choose of B-WaitFramStop in frame waitfram
     2448   do:
     2449     mWaitFramStop = yes.
     2450     mWaitFramStopUser = yes.
     2451   end.
     2452   function waitfram-check-timeout returns logical():
     2453      define variable vtime as int64 no-undo.
     2454      if mWaitFramStopTimeOut
     2455      then
     2456         return yes.
     2457      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2458      if     mWaitFramTimeOut ne ?
     2459         and mWaitFramTimeOut ne 0
     2460         and mWaitFramTimeOut lt vtime
     2461      then do:
     2462         mWaitFramStopTimeOut = yes.
     2463      end.
     2464      return mWaitFramStopTimeOut.
     2465   end.
     2466   procedure waitfram-hide :
     2467     if not session:batch-mode
     2468     then do
     2469     on error undo, return error return-value
     2470     :
     2471       pause 0 before-hide .
     2472       if not mBatchMode then
     2473         hide frame waitfram .
     2474     if     not mWaitFramView
     2475        and mWaitProcEvent
     2476     then
     2477       process events .
     2478     end.
     2479   end procedure.
     2480   procedure waitfram-show :
     2481     define input  parameter p-message as character no-undo .
     2482     define variable v-left-margin as integer   no-undo .
     2483     if not session:batch-mode
     2484     then do
     2485     on error undo, return error return-value
     2486     :
     2487       if length(p-message) <= 70 then do:
     2488         assign
     2489           v-left-margin = integer((70 - length(p-message)) / 2)
     2490         .
     2491         assign
     2492           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2493         .
     2494         assign
     2495           v-waitfram-action01 = " "
     2496           v-waitfram-action02 = " "
     2497                                    + fill(" ", v-left-margin)
     2498                                    + p-message
     2499           v-waitfram-action03 = " "
     2500         .
     2501       end.
     2502       else do:
     2503         define variable vRindex1 as integer no-undo.
     2504         define variable vRindex2 as integer no-undo.
     2505         vRindex1 = r-index(p-message," ",70).
     2506         if vRindex1 = 0
     2507         then
     2508            vRindex1 = 70.
     2509         if length(p-message)  <= vRindex1 + 70 then do:
     2510           assign
     2511             v-waitfram-action01 = " "
     2512             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2513             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2514           .
     2515         end.
     2516         else do:
     2517           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2518           if vRindex2 <= vRindex1
     2519           then
     2520              vRindex2 = vRindex1 + 70.
     2521           assign
     2522             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2523             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2524             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2525           .
     2526         end.
     2527       end.
     2528       B-viewProcInfo:visible   in frame waitfram = no.
     2529       B-viewProcInfo:sensitive in frame waitfram = no.
     2530       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2531       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2532       if  (   mWaitFramView
     2533          or  mWaitProcEvent)
     2534          and not mBatchMode
     2535       then
     2536          display
     2537             v-waitfram-action01 skip
     2538             v-waitfram-action02 skip
     2539             v-waitfram-action03 skip
     2540          with frame waitfram .
     2541       if     mWaitFramView
     2542          then do:
     2543             if     mWaitFramInterval ne ?
     2544                and not mBatchMode
     2545             then
     2546                wait-for go of frame waitfram pause mWaitFramInterval.
     2547          end.
     2548          else
     2549             if     mWaitProcEvent
     2550                and not mBatchMode
     2551             then
     2552                process events .
     2553     end.
     2554   end procedure.
     2555      procedure waitfram-show-this:
     2556         define input  parameter iInterval as int64 no-undo.
     2557         define variable vtime as int64 no-undo.
     2558         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2559         mWaitFramInterval = iInterval.
     2560         run waitfram-show (substitute("&1&2 &3&4" ,
     2561                                       mWaitFramTextBeg ,
     2562                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2563                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2564                                       mWaitFramTextEnd
     2565                                      )
     2566                           ).
     2567      end.
     2568      procedure WaitFramRunPause:
     2569         define input  parameter iInterval as dec no-undo.
     2570         define variable vStart  as datetime-tz no-undo.
     2571         define variable vend    as datetime-tz no-undo.
     2572         define variable vint as int64 no-undo.
     2573         define variable vOk as logical no-undo.
     2574         vStart = now.
     2575         vend   = vStart.
     2576         publish "WaitFramPause" (iInterval,output vOk).
     2577         vend   =  now.
     2578         vint = vend - vStart.
     2579         vint = iInterval - vint / 1000.
     2580         if     not mWaitFramStop
     2581            and (   vint > 0
     2582                 or (    not vOk
     2583                     and iInterval eq ?
     2584                     )
     2585                 )
     2586         then
     2587            run waitfram-show-this (iInterval).
     2588         vend   =  now.
     2589         vint = vend - vStart.
     2590         vint = iInterval - vint / 1000.
     2591         if     not mWaitFramStop
     2592            and vint > 0
     2593         then do:
     2594            run gbl/pause.p (vint * 1000).
     2595         end.
     2596         if iInterval ne ?
     2597         then
     2598            publish "WaitFramStop".
     2599         waitfram-check-timeout().
     2600      end.
     2601      procedure WaitFramWaitFor:
     2602         define input  parameter iInterval as dec no-undo.
     2603         assign
     2604            mWaitFramStartProc   = now
     2605            mWaitFramStopUser    = no
     2606            mWaitFramStopTimeOut = no
     2607         .
     2608         block-wait:
     2609         do while not mWaitFramStop:
     2610            run WaitFramRunPause (iInterval).
     2611            if  waitfram-check-timeout()
     2612            then do:
     2613               leave block-wait.
     2614            end.
     2615         end.
     2616         run waitfram-hide.
     2617      end.
     2618   procedure waitfram-join :
     2619     define input  parameter p-line-1  as character no-undo .
     2620     define input  parameter p-line-2  as character no-undo .
     2621     define input  parameter p-line-3  as character no-undo .
     2622     define output parameter p-message as character no-undo .
     2623     do
     2624     on error undo, return error return-value
     2625     :
     2626       assign
     2627         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2628                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2629                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2630       .
     2631     end.
     2632   end procedure.
     2633   function waitfram-join-function returns character
     2634     (input p-line-1 as character
     2635     ,input p-line-2 as character
     2636     ,input p-line-3 as character
     2637     ).
     2638     define variable v-message as character no-undo .
     2639     run waitfram-join in this-procedure
     2640       (input  p-line-1
     2641       ,input  p-line-2
     2642       ,input  p-line-3
     2643       ,output v-message
     2644       ) .
     2645     return v-message .
     2646   end function .
