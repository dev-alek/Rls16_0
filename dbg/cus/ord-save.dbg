      566   define variable v-inform-launched as logical no-undo initial false .
      567   procedure proc-alt-shift-f4:
      568     define variable v-action as character no-undo .
      569     if v-inform-launched = false then do:
      570       assign
      571         v-inform-launched = true
      572       .
      573       run gbl/d-inform.w
      574         (  input self
      575         ,  input this-procedure
      576         , output v-action
      577         ) no-error .
      578       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      579       assign
      580         v-inform-launched = false
      581       .
      582     end.
      583   end.
      584   procedure proc-alt-f1:
