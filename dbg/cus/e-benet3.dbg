      574   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      575     if num-entries(string(p-dec), '.') = 2
      576       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      577       else return( string(p-dec)) .
      578   end function.
      579   function format-point-to-comma returns char (input orig as char ) .
      580   define variable rtext as character no-undo .
      581   define variable strt as integer no-undo .
      582   define variable leng as integer no-undo .
      583   assign rtext = orig .
      584   repeat:
      585     strt =  index(rtext,'.').
      586     if strt = 0 then leave.
      587     leng = 1.
      588     substring(rtext,strt,leng,"character") = v-delim .
      589   end.
      590   return rtext.
      591   end function.
      592   function format-excel-text returns char ( input start-text as char ) :
      593   def var  i    as int no-undo.
      594   def var  ch   as char no-undo.
      595   def var  n    as int no-undo.
      596   def var  ipos as int no-undo.
      597     n = num-entries(trim(start-text), chr(10)) - 1 .
      598     do i = 1 to n :
      599       ipos = index( start-text, chr(10)).
      600       if ipos > 0 then
      601         substr( start-text, ipos, 1 ) = ' '.
      602     end.
      603     n = num-entries(trim(start-text), chr(13)) - 1 .
      604     do i = 1 to n :
      605       ipos = index( start-text, chr(13)).
      606       if ipos > 0 then
      607         substr( start-text, ipos, 1 ) = ' '.
      608     end.
      609     if index( start-text, '"' ) = 0 then
      610       start-text =  '="'   + trim( start-text) + '"'   .
      611       else do:
      612         n = num-entries(trim(start-text), '"') - 1.
      613         do i = 1 to n :
      614           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      615         end.
      616         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      617         start-text = '="'  + ch  + '"' .
      618       end.
      619     return start-text.
      620   end.
      621   function excel-sum returns char (input p-dec as decimal ).
      622     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      623   end function.
      624   function excel-qnty returns char (input p-dec as decimal ).
      625     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      626   end function.
      627   function format-excel-text-macr returns char ( input start-text as char ) :
      628   def var  i    as int no-undo.
      629   def var  ch   as char no-undo.
      630   def var  n    as int no-undo.
      631   def var  ipos as int no-undo.
      632     n = num-entries(trim(start-text), chr(10)) - 1 .
      633     do i = 1 to n :
      634       ipos = index( start-text, chr(10)).
      635       if ipos > 0 then
      636         substring( start-text, ipos , 1 ) = ' '.
      637     end.
      638     n = num-entries(trim(start-text), chr(13)) - 1 .
      639     do i = 1 to n :
      640       ipos = index( start-text, chr(13)).
      641       if ipos > 0 then
      642         substring( start-text, ipos, 1 ) = ' '.
      643     end.
      644     if index( start-text, '"' ) = 0 then
      645       start-text =  '"'   + trim( start-text) + '"'   .
      646       else do:
      647         n = num-entries(trim(start-text), '"') - 1.
      648         do i = 1 to n :
      649           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      650         end.
      651         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      652         start-text = '"'  + ch  + '"' .
      653       end.
      654     n = num-entries(trim(start-text), chr(10)) - 1 .
      655     do i = 1 to n :
      656       ipos = index( start-text, chr(10)).
      657       if ipos > 0 then
      658         substring( start-text, ipos , 1 ) = ' '.
      659     end.
      660       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      661     return start-text.
      662   end.
      663   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664   define variable v-waitfram-action01         as character   no-undo .
      665   define variable v-waitfram-action02         as character   no-undo .
      666   define variable v-waitfram-action03         as character   no-undo .
      667   define variable mWaitFramTextBeg            as character   no-undo.
      668   define variable mWaitFramTextEnd            as character   no-undo.
      669   define variable mWaitFramView               as logical     no-undo.
      670   define variable mWaitProcEvent              as logical     no-undo init yes.
      671   define variable mWaitFramInterval           as integer     no-undo init 1 .
      672   define variable mWaitFramStop               as logical     no-undo.
      673   define variable mWaitFramStopUser           as logical     no-undo.
      674   define variable mWaitFramStopTimeOut        as logical     no-undo.
      675   define variable mWaitFramStartProc          as datetime-tz no-undo.
      676   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      677   define button B-WaitFramStop auto-end-key
      678        label "Стоп"
      679        size 10 by 1 tooltip "Остоновить процесс".
      680   define button B-viewProcInfo
      681        label "Информация"
      682        size 15 by 1 tooltip "Информация о процесс".
      683   define frame waitfram
      684     v-waitfram-action01 format "x(72)" no-label skip
      685     v-waitfram-action02 format "x(72)" no-label skip
      686     v-waitfram-action03 format "x(72)" no-label skip
      687     B-viewProcInfo
      688     B-WaitFramStop at row 4 col 30
      689     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      690     .
      691   define new global shared variable mBatchMode as logical no-undo init ?.
      692   define variable mFramBachModHandle as handle no-undo.
      693   mFramBachModHandle = frame waitfram:handle.
      694   define variable mFameOldVis as logical no-undo.
      695   define variable mVisCUrentVin as logical no-undo.
      696   if session:batch-mode
      697   then
      698      mBatchMode = yes.
      699   if mBatchMode = ? then do:
      700     mVisCUrentVin = current-window:visible.
      701     mFameOldVis = mFramBachModHandle:visible.
      702     mFramBachModHandle:visible  = yes.
      703     mBatchMode = mFramBachModHandle:visible ne yes.
      704     mFramBachModHandle:visible = mFameOldVis.
      705     current-window:visible = mVisCUrentVin.
      706   end.
      707    if  log-manager:logfile-name ne ?
      708     then DO:
      709         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      710         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      711         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      712     end.
      713   on choose of B-WaitFramStop in frame waitfram
      714   do:
      715     mWaitFramStop = yes.
      716     mWaitFramStopUser = yes.
      717   end.
      718   function waitfram-check-timeout returns logical():
      719      define variable vtime as int64 no-undo.
      720      if mWaitFramStopTimeOut
      721      then
      722         return yes.
      723      vtime = ( now - mWaitFramStartProc ) / 1000 .
      724      if     mWaitFramTimeOut ne ?
      725         and mWaitFramTimeOut ne 0
      726         and mWaitFramTimeOut lt vtime
      727      then do:
      728         mWaitFramStopTimeOut = yes.
      729      end.
      730      return mWaitFramStopTimeOut.
      731   end.
      732   procedure waitfram-hide :
      733     if not session:batch-mode
      734     then do
      735     on error undo, return error return-value
      736     :
      737       pause 0 before-hide .
      738       if not mBatchMode then
      739         hide frame waitfram .
      740     if     not mWaitFramView
      741        and mWaitProcEvent
      742     then
      743       process events .
      744     end.
      745   end procedure.
      746   procedure waitfram-show :
      747     define input  parameter p-message as character no-undo .
      748     define variable v-left-margin as integer   no-undo .
      749     if not session:batch-mode
      750     then do
      751     on error undo, return error return-value
      752     :
      753       if length(p-message) <= 70 then do:
      754         assign
      755           v-left-margin = integer((70 - length(p-message)) / 2)
      756         .
      757         assign
      758           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      759         .
      760         assign
      761           v-waitfram-action01 = " "
      762           v-waitfram-action02 = " "
      763                                    + fill(" ", v-left-margin)
      764                                    + p-message
      765           v-waitfram-action03 = " "
      766         .
      767       end.
      768       else do:
      769         define variable vRindex1 as integer no-undo.
      770         define variable vRindex2 as integer no-undo.
      771         vRindex1 = r-index(p-message," ",70).
      772         if vRindex1 = 0
      773         then
      774            vRindex1 = 70.
      775         if length(p-message)  <= vRindex1 + 70 then do:
      776           assign
      777             v-waitfram-action01 = " "
      778             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      779             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      780           .
      781         end.
      782         else do:
      783           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      784           if vRindex2 <= vRindex1
      785           then
      786              vRindex2 = vRindex1 + 70.
      787           assign
      788             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      789             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      790             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      791           .
      792         end.
      793       end.
      794       B-viewProcInfo:visible   in frame waitfram = no.
      795       B-viewProcInfo:sensitive in frame waitfram = no.
      796       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      797       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      798       if  (   mWaitFramView
      799          or  mWaitProcEvent)
      800          and not mBatchMode
      801       then
      802          display
      803             v-waitfram-action01 skip
      804             v-waitfram-action02 skip
      805             v-waitfram-action03 skip
      806          with frame waitfram .
      807       if     mWaitFramView
      808          then do:
      809             if     mWaitFramInterval ne ?
      810                and not mBatchMode
      811             then
      812                wait-for go of frame waitfram pause mWaitFramInterval.
      813          end.
      814          else
      815             if     mWaitProcEvent
      816                and not mBatchMode
      817             then
      818                process events .
      819     end.
      820   end procedure.
      821      procedure waitfram-show-this:
      822         define input  parameter iInterval as int64 no-undo.
      823         define variable vtime as int64 no-undo.
      824         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      825         mWaitFramInterval = iInterval.
      826         run waitfram-show (substitute("&1&2 &3&4" ,
      827                                       mWaitFramTextBeg ,
      828                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      829                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      830                                       mWaitFramTextEnd
      831                                      )
      832                           ).
      833      end.
      834      procedure WaitFramRunPause:
      835         define input  parameter iInterval as dec no-undo.
      836         define variable vStart  as datetime-tz no-undo.
      837         define variable vend    as datetime-tz no-undo.
      838         define variable vint as int64 no-undo.
      839         define variable vOk as logical no-undo.
      840         vStart = now.
      841         vend   = vStart.
      842         publish "WaitFramPause" (iInterval,output vOk).
      843         vend   =  now.
      844         vint = vend - vStart.
      845         vint = iInterval - vint / 1000.
      846         if     not mWaitFramStop
      847            and (   vint > 0
      848                 or (    not vOk
      849                     and iInterval eq ?
      850                     )
      851                 )
      852         then
      853            run waitfram-show-this (iInterval).
      854         vend   =  now.
      855         vint = vend - vStart.
      856         vint = iInterval - vint / 1000.
      857         if     not mWaitFramStop
      858            and vint > 0
      859         then do:
      860            run gbl/pause.p (vint * 1000).
      861         end.
      862         if iInterval ne ?
      863         then
      864            publish "WaitFramStop".
      865         waitfram-check-timeout().
      866      end.
      867      procedure WaitFramWaitFor:
      868         define input  parameter iInterval as dec no-undo.
      869         assign
      870            mWaitFramStartProc   = now
      871            mWaitFramStopUser    = no
      872            mWaitFramStopTimeOut = no
      873         .
      874         block-wait:
      875         do while not mWaitFramStop:
      876            run WaitFramRunPause (iInterval).
      877            if  waitfram-check-timeout()
      878            then do:
      879               leave block-wait.
      880            end.
      881         end.
      882         run waitfram-hide.
      883      end.
      884   procedure waitfram-join :
      885     define input  parameter p-line-1  as character no-undo .
      886     define input  parameter p-line-2  as character no-undo .
      887     define input  parameter p-line-3  as character no-undo .
      888     define output parameter p-message as character no-undo .
      889     do
      890     on error undo, return error return-value
      891     :
      892       assign
      893         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      894                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      895                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      896       .
      897     end.
      898   end procedure.
      899   function waitfram-join-function returns character
      900     (input p-line-1 as character
      901     ,input p-line-2 as character
      902     ,input p-line-3 as character
      903     ).
      904     define variable v-message as character no-undo .
      905     run waitfram-join in this-procedure
      906       (input  p-line-1
      907       ,input  p-line-2
      908       ,input  p-line-3
      909       ,output v-message
      910       ) .
      911     return v-message .
      912   end function .
      913   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914   define  stream PrnLibStream.
      915   procedure prn-lib-prn-file :
      916     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      917     define input parameter p-DIsabledoptions as integer no-undo .
      918     define variable v-report-name as character no-undo .
      919     define variable v-user-action as character no-undo .
      920     define variable v-printed     as logical   no-undo .
      921     define variable v-exist       as logical   no-undo .
      922     do
      923       on error undo, return error
      924       :
      925       run prn-lib-get-report-name  in this-procedure (
      926         input parParentProc
      927         ,output v-report-name
      928         ).
      929   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      930   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      931     (input  v-report-name
      932     ,input  2
      933     ,output v-exist
      934     )  .
      935       if NOT v-exist then
      936       DO:
      937         Message
      938           "Нет заданий на печать ! "
      939           view-as alert-box .
