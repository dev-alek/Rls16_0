      960   procedure prn-lib-open-stream :
      961     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      962     define input parameter p-page-size    as integer no-undo .
      963     define input parameter p-is-stream    as logical no-undo .
      964     define input parameter p-append       as logical no-undo .
      965     define variable v-report-name as character no-undo .
      966     do
      967       on error undo, return error
      968       :
      969       run prn-lib-get-report-name  in this-procedure (
      970         input parParentProc
      971         ,output v-report-name
      972         ).
      973       if p-is-stream then
      974       do:
      975         if p-append then
      976         do:
      977           output stream PrnLibStream to value( v-report-name )
      978             page-size value(p-page-size) append .
      979         end.
      980         if not p-append then
      981         do:
      982           output stream PrnLibStream to value( v-report-name )
      983             page-size value(p-page-size) .
      984         end.
      985       end.
      986       if not p-is-stream then
      987       do:
      988         if p-append then
      989         do:
      990           output to value( v-report-name )
      991             page-size value(p-page-size) append .
      992         end.
      993         if not p-append then
      994         do:
      995           output to value( v-report-name )
      996             page-size value(p-page-size) .
      997         end.
      998       end.
      999     end.
     1000   end procedure.
     1001   procedure prn-lib-open-exp :
     1002     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1003     define input parameter p-is-stream    as logical no-undo .
     1004     define input parameter p-is-append    as logical no-undo .
     1005     define output parameter p-ReportFileName as char init "report" no-undo.
     1006     define output parameter p-process as logical no-undo .
     1007     define variable glog as logical no-undo .
     1008     do
     1009       on error undo, return error
     1010       :
     1011       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1012         TITLE      "Укажите путь"
     1013         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1014         ASK-OVERWRITE
     1015         CREATE-TEST-FILE
     1016         SAVE-AS
     1017         USE-FILENAME
     1018         DEFAULT-EXTENSION "txt"
     1019         UPDATE glog
     1020         .
     1021       if not glog then  return.
     1022       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1023       if p-is-stream then
     1024       do:
     1025         if p-is-append then
     1026         do:
     1027           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1028         end.
     1029         else
     1030         do:
     1031           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1032         end.
     1033       end.
     1034       else
     1035       do:
     1036         if p-is-append then
     1037         do:
     1038           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1039         end.
     1040         else
     1041         do:
     1042           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1043         end.
     1044       end.
     1045       p-process = yes.
     1046     end.
     1047   end procedure.
     1048   procedure prn-lib-get-report-name :
     1049     define input parameter parParentProc  as widget-handle no-undo.
     1050     define output parameter p-report-name as character no-undo .
     1051     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1052   end procedure.
     1053   procedure prn-lib-reportviewer-report-name :
     1054     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1055     define input parameter p-report-name-html as character no-undo .
     1056     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1057   end procedure.
     1058   procedure prn-lib-reportviewer :
     1059     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1060     define input parameter p-report-name-html as character no-undo .
     1061     define input parameter p-param        as character no-undo .
     1062     define variable v-excel           as character no-undo init 'TRUE' .
     1063     define variable v-value-character as character no-undo .
     1064     define variable v-value-integer   as character no-undo .
     1065     define variable v-value-date      as date      no-undo .
     1066     define variable v-value-decimal   as decimal   no-undo .
     1067     define variable rep-excel         as logical   no-undo .
     1068     define variable excel-string      as character no-undo .
     1069     define variable v-param-type      as character no-undo .
     1070     define variable v-tth             as handle    no-undo .
     1071     run adm/shattri.p (
     1072       input "get":U
     1073       ,input  ""
     1074       ,input  0
     1075       ,input  'report-glob':U
     1076       ,input  'rep-excel':U
     1077       ,output v-value-character
     1078       ,output v-value-date
     1079       ,output v-value-decimal
     1080       ,output v-value-integer
     1081       ,output rep-excel
     1082       ,output v-param-type
     1083       ,INPUT-OUTPUT table-handle v-tth
     1084       )  .
     1085     if rep-excel then v-excel = "TRUE" .
     1086     else v-excel = "FALSE" .
     1087     if p-param eq ""
     1088     then
     1089        p-param = "EXCEL:" + v-excel.
     1090     else
     1091        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1092     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1093   end procedure.
     1094   define variable     NotInc          as  log     no-undo.
     1095   define variable Line                as      char    no-undo.
     1096   define variable date_string     as      char    no-undo.
     1097   define var cas-num as integer no-undo.
     1098   define SHARED var method as character no-undo.
     1099   def SHARED var cas-shft as logical no-undo init no.
     1100   define variable found as logical init yes no-undo.
     1101   define variable multi-obj as logical no-undo.
     1102   define variable dopd as decimal no-undo.
     1103   define variable g#report-num as integer no-undo .
     1104   define buffer buf_chk-doc for ub.chk-doc.
     1105   define buffer buf_chk-gds for ub.chk-gds.
     1106   define buffer buf_bar-code for ub.bar-code.
     1107   define buffer buf_goods for ub.goods.
     1108   define buffer buf_clients for ub.clients.
     1109   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1110   PROCEDURE no-benq.
     1111   DEFINE OUTPUT PARAMETER found as logical init no.
     1112   define buffer buf_chk-doc for ub.chk-doc.
     1113   FOR EACH obj-list WHERE
     1114           obj-list.obj-type = 'маг':U NO-LOCK :
     1115     CASE X-Radio-Task > 1 :
     1116       WHEN YES THEN DO:
     1117         FOR EACH buf_chk-doc NO-LOCK WHERE
     1118                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1119                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1120                 (
     1121                   buf_chk-doc.shift-date >= X-date-start AND
     1122                   buf_chk-doc.shift-date <= X-date-end)
     1123                   AND
     1124                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1125           IF X-Radio-Task = 3 AND
     1126           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1127             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1128           IF X-Radio-Task = 4 AND
     1129           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1130           found = yes.
     1131           return.
     1132         END.
     1133       END.
     1134       WHEN NO THEN DO:
     1135         FOR EACH buf_chk-doc NO-LOCK WHERE
     1136               buf_chk-doc.obj-type = obj-list.obj-type AND
     1137               buf_chk-doc.obj-code = obj-list.obj-code AND
     1138               buf_chk-doc.chk-date >= X-date-start AND
     1139               buf_chk-doc.chk-date <= X-date-end   AND
     1140               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1141           found = yes.
     1142           return.
     1143         END.
     1144        END.
     1145      END CASE.
     1146    END.
     1147   END PROCEDURE.
     1148   PROCEDURE no-benqi.
     1149   DEFINE OUTPUT PARAMETER found as logical init no.
     1150   define buffer buf_chk-doc for ub.chk-doc.
     1151   define buffer buf_inkas for ub.inkas.
     1152   FOR EACH obj-list WHERE
     1153         obj-list.obj-type = 'маг':U NO-LOCK :
     1154     CASE X-Radio-Task > 1 :
     1155       WHEN YES THEN DO:
     1156         FOR EACH buf_chk-doc No-LOCK WHERE
     1157                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1158                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1159                 (
     1160                   buf_chk-doc.shift-date >= X-date-start AND
     1161                   buf_chk-doc.shift-date <= X-date-end)
     1162                   AND
     1163                   buf_Chk-doc.out-code = ? AND
     1164                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1165           IF X-Radio-Task = 3 AND
     1166           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1167             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1168           IF X-Radio-Task = 4 AND
     1169           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1170           found = yes.
     1171           return.
     1172         END.
     1173         FOR EACH buf_inkas No-LOCK WHERE
     1174                   buf_inkas.obj-type = obj-list.obj-type AND
     1175                   buf_inkas.obj-code = obj-list.obj-code AND
     1176                   (
     1177                   buf_inkas.shift-date >= X-date-start AND
     1178                   buf_inkas.shift-date <= X-date-end):
     1179           if buf_inkas.status_ = 'факт':U
     1180           or buf_inkas.status_ = 'запрос':U then next.
     1181           IF X-Radio-Task = 3 AND
     1182           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1183             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1184           IF X-Radio-Task = 4 AND
     1185           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1186           found = yes.
     1187           return.
     1188         END.
     1189       END.
     1190       WHEN NO THEN DO:
     1191         FOR EACH buf_chk-doc NO-LOCK WHERE
     1192                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1193                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1194                 buf_chk-doc.chk-date >= X-date-start AND
     1195                 buf_chk-doc.chk-date <= X-date-end   AND
     1196                 buf_Chk-doc.out-code = ? AND
     1197                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1198           found = yes.
     1199           return.
     1200         END.
     1201         FOR EACH buf_inkas NO-LOCK WHERE
     1202                 buf_inkas.obj-type = obj-list.obj-type AND
     1203                 buf_inkas.obj-code = obj-list.obj-code AND
     1204                 buf_inkas.doc-date >= X-date-start AND
     1205                 buf_inkas.doc-date <= X-date-end :
     1206           if buf_inkas.status_ = 'факт':U
     1207           or buf_inkas.status_ = 'запрос':U then next.
     1208           found = yes.
     1209           return.
     1210         END.
     1211       END.
     1212     END CASE.
     1213   END.
     1214   END PROCEDURE.
     1215   PROCEDURE no-benq-i.
     1216   DEFINE OUTPUT PARAMETER found as logical init no.
     1217   define buffer buf_inkas for ub.inkas.
     1218   CASE X-Radio-Task > 1:
     1219     WHEN YES then do:
     1220       FOR EACH obj-list WHERE
     1221               obj-list.obj-type = 'маг':U NO-LOCK :
     1222         FOR EACH buf_inkas NO-LOCK WHERE
     1223                 buf_inkas.obj-type = obj-list.obj-type AND
     1224                 buf_inkas.obj-code = obj-list.obj-code AND
     1225                 buf_inkas.status_ = 'факт':U AND
     1226                 (
     1227                 buf_inkas.shift-date >= X-date-start AND
     1228                 buf_inkas.shift-date <= X-date-end):
     1229           IF X-Radio-Task = 3 AND
     1230           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1231             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1232           IF X-Radio-Task = 4 AND
     1233           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1234           found = yes.
     1235           return.
     1236         END.
     1237     END.
     1238     END.
     1239     WHEN NO THEN DO:
     1240       FOR EACH obj-list WHERE
     1241               obj-list.obj-type = 'маг':U NO-LOCK :
     1242         FOR EACH buf_inkas NO-LOCK WHERE
     1243                 buf_inkas.obj-type = obj-list.obj-type AND
     1244                 buf_inkas.obj-code = obj-list.obj-code AND
     1245                 buf_inkas.status_ = 'факт':U AND
     1246                 buf_inkas.doc-date >= X-date-start AND
     1247                 buf_inkas.doc-date <= X-date-end :
     1248            found = yes.
     1249            return.
     1250         END.
     1251       END.
     1252     END.
     1253   END CASE.
     1254   END PROCEDURE.
     1255   PROCEDURE no-benq-i-office.
     1256   DEFINE OUTPUT PARAMETER found as logical init no.
     1257   define buffer buf_sale-doc for ub.sale-doc.
     1258   CASE X-Radio-Task > 1:
     1259     WHEN YES then do:
     1260       FOR EACH obj-list WHERE
     1261               obj-list.obj-type = 'маг':U NO-LOCK :
     1262         FOR EACH buf_sale-doc NO-LOCK WHERE
     1263                  buf_Sale-doc.obj-type = obj-list.obj-type
     1264              AND buf_sale-doc.obj-code = obj-list.obj-code
     1265              AND buf_sale-doc.status_ = 'факт':U
     1266              AND buf_sale-doc.chr-office = 'у':U
     1267              AND (
     1268                 buf_sale-doc.shift-date >= X-date-start
     1269                 AND
     1270                 buf_sale-doc.shift-date <= X-date-end):
     1271           IF X-Radio-Task = 3 AND
     1272           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1273             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1274           IF X-Radio-Task = 4 AND
     1275           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1276           found = yes.
     1277           return.
     1278         END.
     1279       END.
     1280     END.
     1281     WHEN NO THEN DO:
     1282       FOR EACH obj-list WHERE
     1283               obj-list.obj-type = 'маг':U NO-LOCK :
     1284         FOR EACH buf_sale-doc NO-LOCK WHERE
     1285                 buf_sale-doc.obj-type = obj-list.obj-type
     1286            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1287            AND  buf_sale-doc.status_ = 'факт':U
     1288            AND  buf_sale-doc.chr-office = 'у':U
     1289            AND  buf_sale-doc.doc-date >= X-date-start
     1290            AND  buf_sale-doc.doc-date <= X-date-end :
     1291           found = yes.
     1292           return.
     1293         END.
     1294       END.
     1295     END.
     1296   END CASE.
     1297   END PROCEDURE.
     1298   def temp-table benefits no-undo
     1299       field obj-code like ub.chk-doc.obj-code
     1300       Field gds-code like ub.goods.gds-code
     1301       Field artic like ub.goods.artic
     1302       field dcpc as decimal format "->9%"
     1303       field price-base like ub.chk-gds.price-base
     1304       field price-netto like ub.chk-gds.price-base
     1305       field qnty like ub.gds-dtl.fact-qnty
     1306       field discnt    like ub.chk-gds.discnt
     1307       INDEX pi IS PRIMARY obj-code dcpc gds-code price-base
     1308       INDEX i-artic obj-code dcpc artic price-base
     1309       .
     1310   FOR EACH benefits:
     1311       delete benefits.
     1312   END.
     1313   run waitfram-show in this-procedure ("Ждите...").
     1314   run no-benqi(OUTPUT Notinc).
     1315   FIND obj-list No-LOCK NO-ERROR.
     1316   IF NOT AVAIL obj-list then do:
     1317     multi-obj = yes.
     1318   end.
     1319   FOR EACH obj-list No-LOCK:
     1320   _chk-gds:
     1321     FOR EACH buf_chk-doc No-LOCK WHERE
     1322              buf_chk-doc.obj-type = obj-list.obj-type AND
     1323              buf_chk-doc.obj-code = obj-list.obj-code AND
     1324              buf_chk-doc.out-code <> ? AND
     1325              buf_chk-doc.chk-date >= X-date-start AND
     1326              buf_chk-doc.chk-date <= X-date-end,
     1327         EACH buf_chk-gds No-LOCK WHERE
     1328              buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     1329         FIRST buf_bar-code No-LOCK WHERE
     1330               buf_bar-code.b-code = buf_chk-gds.b-code:
     1331       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1332       if buf_chk-gds.write-off-code <> ?
     1333       and buf_chk-gds.write-off-code > 0 then NEXT _chk-gds.
     1334       ACCUMULATE buf_chk-gds.doc-code (COUNT).
     1335       IF (ACCUM COUNT buf_chk-gds.doc-code) MODULO 50 = 0 then
     1336       run waitfram-show in this-procedure ("Ждите..." + "Обработано " +
     1337                      string(ACCUM COUNT buf_chk-gds.doc-code) + " строк чеков").
     1338       IF x-SelectGood = 4 then do:
     1339         FIND FIRST buf_goods No-LOCK WHERE buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     1340         IF NOT CAN-FIND(first gds-list WHERE
     1341                               gds-list.artic = buf_goods.artic AND
     1342                               gds-list.prod-type  = buf_goods.prod-type AND
     1343                               gds-list.prod-code = buf_goods.prod-code
     1344                               ) then
     1345                               NEXT _chk-gds.
     1346       end.
     1347       dopd = ROUND(buf_chk-gds.discnt / buf_chk-gds.price-base * 100, 0).
     1348       if dopd = 0 then NEXT _chk-gds.
     1349       FIND FIRST benefits WHERE
     1350                  benefits.gds-code = buf_bar-code.gds-code AND
     1351                  benefits.dcpc = dopd AND
     1352                  benefits.price-base = buf_chk-gds.price-base AND
     1353                  benefits.obj-code = buf_chk-doc.obj-code No-ERROR.
     1354       IF NOT avail benefits then do:
     1355         FIND FIRST buf_goods NO-LOCK WHERE
     1356                    buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     1357         create benefits.
     1358         assign
     1359         benefits.artic = buf_goods.artic
     1360         benefits.gds-code = buf_bar-code.gds-code
     1361         benefits.dcpc =  dopd
     1362         benefits.price-base = buf_chk-gds.price-base
     1363         benefits.discnt = benefits.dcpc * benefits.price-base / 100
     1364         benefits.price-netto = benefits.price-base - benefits.discnt
     1365         benefits.obj-code = buf_chk-doc.obj-code
     1366         .
     1367       end.
     1368       assign
     1369       benefits.qnty = benefits.qnty + buf_chk-gds.doc-qnty
     1370       .
     1371     END.
     1372   END.
     1373    run waitfram-show in this-procedure ("Ждите... Вывод информации...").
     1374   assign
     1375   sheetf.Excel-Column-Lable =
     1376   "Артикул" + chr(44) +
     1377   "Количество"  + chr(44) +
     1378   "Цена исх"  + chr(44) +
     1379   "Цена со скидкой"  + chr(44) +
     1380   "Сумма скидки"
     1381   sheetf.sizes =
     1382   "16" + chr(44) +
     1383   "15"  + chr(44) +
     1384   "15"  + chr(44) +
     1385   "15"  + chr(44) +
     1386   "15"
     1387   str1 = string(( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ), "X(40)")
     1388   str3 = " "
     1389   .
     1390   run rep/extitle.p (1).
     1391   FOR EACH benefits NO-LOCK
     1392       BREAK
     1393       BY BENEFITS.OBJ-CODE
     1394       BY BENEFITS.DCPC
     1395       BY BENEFITS.ARTIC
     1396       BY BENEFITS.PRICE-BASE:
     1397       IF FIRST-OF(BENEFITS.OBj-CODE) THEN DO:
     1398         FIND FIRST buf_clients NO-LOCK WHERE
     1399                    buf_clients.obj-type = 'маг':U AND
     1400                    buf_clients.obj-code = benefits.obj-code No-ERROR.
     1401         if Make-Excel then  put   stream ForExcel unformatted
     1402         (IF AVAIL buf_clients
     1403          then buf_clients.obj-name
     1404          else ("Магазин N " + string(benefits.obj-code))
     1405         )
     1406         SKIP.
     1407       END.
     1408       IF FIRST-OF(BENEFITS.dcpc) THEN DO:
     1409         if Make-Excel then  put   stream ForExcel unformatted
     1410         ("Скидка " + string(BENEFITS.dcpc, "->9%"))
     1411         SKIP.
     1412       END.
     1413       if Make-Excel then  put   stream ForExcel unformatted
     1414       BENEFITS.artic CHR(9)
     1415       BENEFITS.qnty  CHR(9)
     1416       BENEFITS.PRICE-BASE CHR(9)
     1417       BENEFITS.PRICE-NETTO CHR(9)
     1418       BENEFITS.DISCNT
     1419       SKIP.
     1420       ACCUMULATE
     1421       BENEFITS.qnty (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1422       (BENEFITS.qnty * BENEFITS.price-base) (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1423       (BENEFITS.qnty * BENEFITS.price-netto) (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1424       (BENEFITS.qnty * BENEFITS.discnt) (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1425       .
     1426       IF LAST-OF(BENEFITS.dcpc) THEN DO:
     1427         if Make-Excel then  put   stream ForExcel unformatted
     1428         ("ИТОГО: (" + string(BENEFITS.dcpc, "->9%") + ")") CHR(9)
     1429         ACCUM TOTAL BY BENEFITS.dcpc BENEFITS.qnty CHR(9)
     1430         ACCUM TOTAL BY BENEFITS.dcpc (BENEFITS.qnty * BENEFITS.PRICE-BASE) CHR(9)
     1431         ACCUM TOTAL BY BENEFITS.dcpc (BENEFITS.qnty * BENEFITS.PRICE-NETTo) CHR(9)
     1432         ACCUM TOTAL BY BENEFITS.dcpc (BENEFITS.qnty * BENEFITS.DISCNT)
     1433         SKIP.
     1434       END.
     1435       IF Multi-obj AND LAST-OF(BENEFITS.OBJ-CODE) THEN DO:
     1436         if Make-Excel then  put   stream ForExcel unformatted
     1437         ("ИТОГО ПО МАГАЗИНУ " + string(BENEFITS.OBJ-CODE)) CHR(9)
     1438         ACCUM TOTAL BY BENEFITS.obj-code BENEFITS.qnty CHR(9)
     1439         ACCUM TOTAL BY BENEFITS.obj-code (BENEFITS.qnty * BENEFITS.PRICE-BASE) CHR(9)
     1440         ACCUM TOTAL BY BENEFITS.obj-code (BENEFITS.qnty * BENEFITS.PRICE-NETTo) CHR(9)
     1441         ACCUM TOTAL BY BENEFITS.obj-code (BENEFITS.qnty * BENEFITS.DISCNT)
     1442         SKIP.
     1443       END.
     1444       IF LAST(BENEFITS.OBJ-CODE) THEN DO:
     1445         if Make-Excel then  put   stream ForExcel unformatted
     1446         "ИТОГО ПО ВСЕМ " CHR(9)
     1447         ACCUM TOTAL BENEFITS.qnty CHR(9)
     1448         ACCUM TOTAL (BENEFITS.qnty * BENEFITS.PRICE-BASE) CHR(9)
     1449         ACCUM TOTAL (BENEFITS.qnty * BENEFITS.PRICE-NETTo) CHR(9)
     1450         ACCUM TOTAL (BENEFITS.qnty * BENEFITS.DISCNT)
     1451         SKIP.
     1452       END.
     1453   END.
     1454   if Make-Excel then output stream ForExcel close.
     1455   run get-report-num in my-handle (output g#report-num).
     1456   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1457   run waitfram-hide in this-procedure .
