      648   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      650   procedure paramls-clear :
      651     define buffer buf_temp-param for temp-param .
      652     do
      653     on error undo, return error return-value
      654     :
      655       for each buf_temp-param
      656       on error undo, return error
      657       :
      658         delete buf_temp-param .
      659       end.
      660     end.
      661   end procedure.
      662   procedure paramls-write :
      663     define input  parameter p-code     as character no-undo .
      664     define input  parameter p-sub-code as character no-undo .
      665     define input  parameter p-value    as character no-undo .
      666     define buffer buf_temp-param for temp-param .
      667     do
      668     on error undo, return error return-value
      669     :
      670       find first buf_temp-param
      671         where buf_temp-param.param-code     = p-code
      672           and buf_temp-param.param-sub-code = p-sub-code
      673         no-error .
      674       if not available buf_temp-param then do:
      675         create buf_temp-param .
      676         assign
      677           buf_temp-param.param-code     = p-code
      678           buf_temp-param.param-sub-code = p-sub-code
      679         .
      680       end.
      681       assign
      682         buf_temp-param.param-value = p-value
      683       .
      684     end.
      685   end procedure.
      686   procedure paramls-read :
      687     define input  parameter p-code          as character no-undo .
      688     define input  parameter p-sub-code      as character no-undo .
      689     define input  parameter p-default-value as character no-undo .
      690     define output parameter p-value         as character no-undo .
      691     define buffer buf_temp-param for temp-param .
      692     do
      693     on error undo, return error return-value
      694     :
      695       find first buf_temp-param
      696         where buf_temp-param.param-code     = p-code
      697           and buf_temp-param.param-sub-code = p-sub-code
      698         no-error .
      699       if available buf_temp-param then do:
      700         assign
      701           p-value = buf_temp-param.param-value
      702         .
      703       end.
      704       else do:
      705         assign
      706           p-value = p-default-value
      707         .
      708       end.
      709     end.
      710   end procedure.
      711   procedure paramls-append :
      712     define input  parameter p-code     as character no-undo .
      713     define input  parameter p-sub-code as character no-undo .
      714     define input  parameter p-value    as character no-undo .
      715     define buffer buf_temp-param for temp-param .
      716     do
      717     on error undo, return error return-value
      718     :
      719       find first buf_temp-param
      720            where buf_temp-param.param-code     = p-code
      721              and buf_temp-param.param-sub-code = p-sub-code
      722         no-error .
      723       if not available buf_temp-param then do:
      724         create buf_temp-param .
      725         assign
      726           buf_temp-param.param-code     = p-code
      727           buf_temp-param.param-sub-code = p-sub-code
      728           buf_temp-param.param-value    = p-value
      729         .
      730       end.
      731       else do:
      732           assign
      733               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      734           .
      735       end.
      736     end.
      737   end procedure.
      738   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      739     if num-entries(string(p-dec), '.') = 2
      740       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      741       else return( string(p-dec)) .
      742   end function.
      743   function format-point-to-comma returns char (input orig as char ) .
      744   define variable rtext as character no-undo .
      745   define variable strt as integer no-undo .
      746   define variable leng as integer no-undo .
      747   assign rtext = orig .
      748   repeat:
      749     strt =  index(rtext,'.').
      750     if strt = 0 then leave.
      751     leng = 1.
      752     substring(rtext,strt,leng,"character") = v-delim .
      753   end.
      754   return rtext.
      755   end function.
      756   function format-excel-text returns char ( input start-text as char ) :
      757   def var  i    as int no-undo.
      758   def var  ch   as char no-undo.
      759   def var  n    as int no-undo.
      760   def var  ipos as int no-undo.
      761     n = num-entries(trim(start-text), chr(10)) - 1 .
      762     do i = 1 to n :
      763       ipos = index( start-text, chr(10)).
      764       if ipos > 0 then
      765         substr( start-text, ipos, 1 ) = ' '.
      766     end.
      767     n = num-entries(trim(start-text), chr(13)) - 1 .
      768     do i = 1 to n :
      769       ipos = index( start-text, chr(13)).
      770       if ipos > 0 then
      771         substr( start-text, ipos, 1 ) = ' '.
      772     end.
      773     if index( start-text, '"' ) = 0 then
      774       start-text =  '="'   + trim( start-text) + '"'   .
      775       else do:
      776         n = num-entries(trim(start-text), '"') - 1.
      777         do i = 1 to n :
      778           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      779         end.
      780         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      781         start-text = '="'  + ch  + '"' .
      782       end.
      783     return start-text.
      784   end.
      785   function excel-sum returns char (input p-dec as decimal ).
      786     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      787   end function.
      788   function excel-qnty returns char (input p-dec as decimal ).
      789     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      790   end function.
      791   function format-excel-text-macr returns char ( input start-text as char ) :
      792   def var  i    as int no-undo.
      793   def var  ch   as char no-undo.
      794   def var  n    as int no-undo.
      795   def var  ipos as int no-undo.
      796     n = num-entries(trim(start-text), chr(10)) - 1 .
      797     do i = 1 to n :
      798       ipos = index( start-text, chr(10)).
      799       if ipos > 0 then
      800         substring( start-text, ipos , 1 ) = ' '.
      801     end.
      802     n = num-entries(trim(start-text), chr(13)) - 1 .
      803     do i = 1 to n :
      804       ipos = index( start-text, chr(13)).
      805       if ipos > 0 then
      806         substring( start-text, ipos, 1 ) = ' '.
      807     end.
      808     if index( start-text, '"' ) = 0 then
      809       start-text =  '"'   + trim( start-text) + '"'   .
      810       else do:
      811         n = num-entries(trim(start-text), '"') - 1.
      812         do i = 1 to n :
      813           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      814         end.
      815         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      816         start-text = '"'  + ch  + '"' .
      817       end.
      818     n = num-entries(trim(start-text), chr(10)) - 1 .
      819     do i = 1 to n :
      820       ipos = index( start-text, chr(10)).
      821       if ipos > 0 then
      822         substring( start-text, ipos , 1 ) = ' '.
      823     end.
      824       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      825     return start-text.
      826   end.
      827   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
      828   define variable  str  as char format "X(60)"  no-undo.
      829   define variable  str2 as char no-undo.
      830   define variable v-r as character no-undo init "" .
      831   define variable  i#i as int no-undo.
      832   STR = "".
      833   repeat i#i =1 to lavel#:
      834       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
      835       else do:
      836           str2 = entry(i#i,grp-name, chr(47)) no-error.
      837           if not error-status:error  and str2 <> "":u then
      838                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
      839           end.
      840   end.
      841   if str <> ? then do:
      842   v-r = str + chr(47) .
      843   end.
      844   RETURN v-r .
      845   END FUNCTION.
      846   define variable v-account as integer init 0 no-undo .
      847   define variable v-account-lavel as character no-undo .
      848   define variable v-button-stop as logical no-undo .
