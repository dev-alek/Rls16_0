      926   define variable v-inform-launched as logical no-undo initial false .
      927   procedure proc-alt-shift-f4:
      928     define variable v-action as character no-undo .
      929     if v-inform-launched = false then do:
      930       assign
      931         v-inform-launched = true
      932       .
      933       run gbl/d-inform.w
      934         (  input self
      935         ,  input this-procedure
      936         , output v-action
      937         ) no-error .
      938       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      939       assign
      940         v-inform-launched = false
      941       .
      942     end.
      943   end.
      944   procedure proc-alt-f1:
      945     run gbl/corrhelp.p
      946       (input this-procedure
      947       ) .
      948   end .
      949   on alt-shift-f2 anywhere do:
      950     run proc-alt-shift-f2.
      951   end.
      952   on alt-shift-f3 anywhere do:
      953     run proc-alt-shift-f3 in this-procedure .
      954   end.
      955   on alt-shift-f4 anywhere do:
      956     run proc-alt-shift-f4 in this-procedure.
      957   end.
      958   on alt-f1 anywhere do:
      959     run proc-alt-f1 in this-procedure .
      960   end.
