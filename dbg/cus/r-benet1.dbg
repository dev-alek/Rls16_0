      850   define variable v-kol-spice2 as integer no-undo .
      851   define variable v-kol-spice3 as integer no-undo .
      852   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      853   DEFINE BUTTON StopBtn AUTO-END-KEY
      854        LABEL "Стоп"
      855        SIZE 10 BY 1.
      856   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      857        LABEL "Обработано записей"
      858         VIEW-AS TEXT
      859        SIZE 14 BY .67 NO-UNDO.
      860   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      861         VIEW-AS TEXT
      862        SIZE 53.25 BY .67
      863        FGCOLOR 1  NO-UNDO.
      864   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      865         VIEW-AS TEXT
      866        SIZE 53.25 BY .67
      867        FGCOLOR 1  NO-UNDO.
      868   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      869         VIEW-AS TEXT
      870        SIZE 53.25 BY .67
      871        FGCOLOR 1  NO-UNDO.
      872   DEFINE RECTANGLE RECT-1
      873        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      874        SIZE 55.13 BY 4.46.
      875   DEFINE FRAME InfoFrame
      876        StopBtn AT ROW 4.25 COL 21.75
      877        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      878        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      879        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      880        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      881        RECT-1 AT ROW 1 COL 1
      882       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      883            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      884            TITLE "Процесс"
      885            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      886   define variable mFrameView      as logical   no-undo init yes.
      887     define variable mFramHandle as handle no-undo.
      888     mFramHandle = frame InfoFrame:handle.
      889     if  log-manager:logfile-name ne ?
      890     then DO:
      891         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      892         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      893         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      894     end.
      895     mFrameView = not session:batch-mode and mFramHandle:visible.
      896     if mFrameView
      897     then do:
      898       ASSIGN
      899          FRAME InfoFrame:HIDDEN                           = TRUE
      900          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      901     end.
      902   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      903   DO:
      904     IF not StopProcessing THEN
      905       Message "Вы действительно хотите прервать" SKIP
      906               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      907                 UPDATE StopProcessing.
      908     IF StopProcessing THEN do:
      909        if mFrameView
      910        then do:
      911           HIDE FRAME InfoFrame.
      912        end.
      913     End.
      914   END.
      915   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   procedure proc-alt-shift-f2:
      917     if not ibs.th.gbl.gbl-var:rcode
      918   then
      919     run gbl\inidebug.p .
