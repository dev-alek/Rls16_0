     4257                         temp-gds-list.vat-pc    = var-vat-pc
     4258                       .
     4259                   end.
     4260             end.
     4261       end.
     4262         for each temp-gds-list no-lock
     4263           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     4264             break by (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))   by goods.artic :
     4265           run item-goods ( "6" , "goods" ) .
     4266             if return-value <> "" then next.
     4267           If Last-of((func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))) Then Do:
     4268           If String(Entry(2,"(func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))",".")) = "Grp-name"
     4269             Then  Assign
     4270                     S-bar-code   = " Итого по "
     4271                     Gds-zap-artic = Substring(
     4272                                         B1-name
     4273                                         ,1,16)
     4274                     Gds-zap-gds-name = Substring(
     4275                                         B1-name
     4276                                         ,17,40)
     4277                                   .
     4278             Else  Assign
     4279                     S-bar-code   = ""
     4280                     Gds-zap-artic = "        Итого по "
     4281                     Gds-zap-gds-name =  B1-name
     4282                                   .
     4283               Run Display-b1 In This-procedure .
     4284               Run Clear-b1 In This-procedure .
     4285               Assign Break_Group = True.
     4286           End.
     4287         end.
     4288   end.
     4289     end.
     4290           otherwise do:
     4291   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4292   IF x-SelectObject = "currency":U  OR  xTog-obj then do :
     4293   define variable first-l49 as logical   no-undo .
     4294     first-l49 = true .
     4295     for each gds-obj
     4296       where gds-obj.obj-type = x-store-type
     4297         and gds-obj.obj-code = x-store-code
     4298             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     4299             no-lock,
     4300         first goods  where  goods.gds-code = gds-obj.gds-code
     4301         no-lock,
     4302         First gds-list  where gds-list.gds-code =  gds-obj.gds-code
     4303         no-lock
     4304         break by func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code)
     4305               by (gds-list.artic)
     4306               :
     4307         var-vat-pc = func-vat ( input gds-obj.gds-code, input x-store-type, input x-store-code) .
     4308         if last-vat <> var-vat-pc then do:
     4309             if not first-l49 then do:
     4310               Assign
     4311                   s-bar-code    = ""
     4312                   gds-zap-artic = "        Итого по "
     4313                   gds-zap-gds-name = b1-name
     4314                   .
     4315                 run display-b1.
     4316                 run clear-b1  .
     4317             end.
     4318             Assign
     4319               first-l49 = false
     4320               break_group = true
     4321               break_group1 = true
     4322               .
     4323             end.
     4324         first-l49 = false .
     4325         run item-goods ( "6" , "gds-list" ) .
     4326         last-vat = func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code) .
     4327      end.
     4328       Assign
     4329           s-bar-code   = ""
     4330           gds-zap-artic = "        Итого по "
     4331           gds-zap-gds-name = b1-name
     4332           .
     4333         run display-b1.
     4334         run clear-b1.
     4335   end.
     4336   else do:
     4337      For each obj-list no-lock :
     4338                     FOR EACH gds-obj where
     4339                         gds-obj.obj-type = obj-list.obj-type    and
     4340                         gds-obj.obj-code = obj-list.obj-code
     4341                         and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     4342                         no-lock,
     4343                   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     4344                         no-lock :
     4345                         find first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code no-error .
     4346                         if not available temp-gds-list then do:
     4347                             find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     4348                             Create temp-gds-list.
     4349   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4351     (input  gds-obj.gds-code
     4352     ,input  '1':U
     4353     ,input  ?
     4354     ,input  v-cntxt-host-code-obj
     4355     ,input  gds-obj.obj-type
     4356     ,input  gds-obj.obj-code
     4357     ,output var-vat-pc
     4358     ) no-error .
     4359                             Assign
     4360                               temp-gds-list.prod-code = gds-obj.prod-code
     4361                               temp-gds-list.grp-name  = gds-obj.grp-name
     4362                               temp-gds-list.gds-name  = goods.gds-name
     4363                               temp-gds-list.gds-code  = gds-obj.gds-code
     4364                               temp-gds-list.artic     = gds-obj.artic
     4365                               temp-gds-list.vat-pc    = var-vat-pc
     4366                             .
     4367                         End.
     4368                         else do:
     4369                         if temp-gds-list.vat-pc = 0 or temp-gds-list.vat-pc = ? then do:
     4370   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4372     (input  gds-obj.gds-code
     4373     ,input  '1':U
     4374     ,input  ?
     4375     ,input  v-cntxt-host-code-obj
     4376     ,input  gds-obj.obj-type
     4377     ,input  gds-obj.obj-code
     4378     ,output var-vat-pc
     4379     ) no-error .
     4380                               Assign
     4381                                 temp-gds-list.vat-pc    = var-vat-pc
     4382                               .
     4383                         end.
     4384                         end.
     4385               End.
     4386     End.
     4387     for each temp-gds-list no-lock
     4388       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     4389         BREAK BY (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))  BY gds-list.artic :
     4390       run item-goods ( "6" , "gds-list" ) .
     4391         if return-value <> "" then NEXT.
     4392           If Last-of((func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))) Then Do:
     4393           If String(Entry(2,"(func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))",".")) = "Grp-name"
     4394             Then  Assign
     4395                     S-bar-code   = " Итого по "
     4396                     Gds-zap-artic = Substring(
     4397                                         B1-name
     4398                                         ,1,16)
     4399                     Gds-zap-gds-name = Substring(
     4400                                         B1-name
     4401                                         ,17,40)
     4402                                   .
     4403             Else  Assign
     4404                     S-bar-code   = ""
     4405                     Gds-zap-artic = "        Итого по "
     4406                     Gds-zap-gds-name =  B1-name
     4407                                   .
     4408               Run Display-b1 In This-procedure .
     4409               Run Clear-b1 In This-procedure .
     4410               Assign Break_Group = True.
     4411           End.
     4412     End.
     4413   End.
     4414           end.
     4415         end case.
     4416   end procedure.
     4417   PROCEDURE CalcItog :
     4418       run ostatok in this-procedure
     4419       (   input x-store-code  ,
     4420           input x-store-type  , x-TOG-Shift,
     4421           input x-date-start - 1 ,
     4422           input date ('')      , x-Shift-Start,x-Shift-End,
     4423           input 'crsa':U   ,
     4424           input '##,##':U,
     4425           input xTog-obj ,
     4426           output  Quantity1  ,
     4427           output  Coast_R1   ,
     4428           output  Coast_V1   ,
     4429           output  VAT_R1     ,
     4430           output  VAT_V1     ,
     4431           output  Fact-order-1 ).
     4432       run ostatok in this-procedure
     4433       (
     4434           input x-store-code  ,
     4435           input x-store-type  ,x-TOG-Shift,
     4436           input x-date-start  ,
     4437           input x-date-end    , x-Shift-Start,x-Shift-End,
     4438           input 'crsa':U   ,
     4439           input '##,##':U,
     4440           input xTog-obj ,
     4441           output  Quantity1  ,
     4442           output  Coast_R1   ,
     4443           output  Coast_V1   ,
     4444           output  VAT_R1     ,
     4445           output  VAT_V1     ,
     4446           output  Fact-order-2 ).
     4447             Quantity1  = 0.
     4448             Coast_R1   = 0.
     4449             Coast_V1   = 0.
     4450             VAT_R1     = 0.
     4451             VAT_V1     = 0.
     4452   END PROCEDURE.
     4453   PROCEDURE display-str1  :
     4454   define variable i as integer no-undo .
     4455   define variable v-nn as integer   no-undo .
     4456    qnty-orders = "" .
     4457   if showorders = true then DO:
     4458       v-nn = num-entries (Number-Orders,CHR(9))  .
     4459       repeat i = 1 to v-nn :
     4460       If entry (i,Number-Orders,CHR(9)) <> ?
     4461          and entry (i,Number-Orders,CHR(9)) <> ""
     4462          and entry (i,Number-Orders,CHR(9)) <> "0" Then DO:
     4463         Find first ub.doc-line where
     4464               entry (i,Number-Orders,CHR(9)) =  ub.doc-line.doc-code
     4465               AND   ub.doc-line.obj-code   = x-store-code
     4466               AND   ub.doc-line.obj-type   = x-store-type
     4467               AND   ub.doc-line.prod-code  = gds-zap-prod-code
     4468               AND   ub.doc-line.prod-type  = gds-zap-prod-type
     4469               AND   ub.doc-line.status_    = 'запрос':U
     4470               AND   ub.doc-line.artic      = gds-zap-artic
     4471               no-lock no-error .
     4472               qnty-orders =  qnty-orders  +
     4473                          (if avail ub.doc-line then
     4474                         string (ub.doc-line.fact-qnty)  Else "0")  +  "," .
     4475        End.
     4476       End.
     4477    End.
     4478    Else qnty-orders = "".
     4479    run di  ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4480   END PROCEDURE.
     4481   PROCEDURE display-Bi  :
     4482      qnty-orders = "".
     4483      run di ("кол-во",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     4484          run macr_cell_format  (
     4485             10       ,
     4486             true     ,
     4487             false    ,
     4488             ?        ,
     4489             num#str# ,
     4490             1        ,
     4491             num#str# ,
     4492             14 )
     4493             .
     4494   END PROCEDURE.
     4495   PROCEDURE display-B1  :
     4496       qnty-orders = "".
     4497       run di ("кол-во"  ,1,  ( s-bar-code + ' ' + CAPS (gds-zap-artic + gds-zap-gds-name)) , "" ,"","","B1":U).
     4498          run macr_cell_format  (
     4499             10       ,
     4500             true     ,
     4501             false    ,
     4502             ?        ,
     4503             num#str# ,
     4504             1        ,
     4505             num#str# ,
     4506             14 )
     4507             .
     4508   END PROCEDURE.
     4509   PROCEDURE display-Bo  :
     4510   END PROCEDURE.
     4511   PROCEDURE display-B2  :
     4512       qnty-orders = "".
     4513       run di  ( "кол-во", 1 , ( s-bar-code + ' ' + caps (gds-zap-artic + gds-zap-gds-name)), "" ,"", "","b2":u).
     4514          run macr_cell_format  (
     4515             10       ,
     4516             true     ,
     4517             false    ,
     4518             36        ,
     4519             num#str# ,
     4520             1        ,
     4521             num#str# ,
     4522             14 )
     4523             .
     4524   END PROCEDURE.
