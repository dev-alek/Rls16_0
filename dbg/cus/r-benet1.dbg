     5293   PROCEDURE MAketemptable :
     5294      Assign
     5295       v#b-code        = gds-zap-b-code
     5296       v#artic         = gds-zap-artic
     5297       v#prod-code     = gds-zap-prod-code
     5298       v#prod-type     = gds-zap-prod-type
     5299       v#prt-root      = gds-zap-prt-root
     5300       v#grp-name      = gds-zap-grp-name
     5301       v#F-zakaz       =  F-zakaz
     5302       v#F-center-stock=  F-center-stock
     5303       v#Prih          =  Prih          [1]
     5304       v#ostatok-end   =  ostatok-end   [1]
     5305       v#f-avr         =  f-avr
     5306       v#kASSA1        =  kAssa         [1]
     5307       v#KAssa2        =  KAssa         [2]
     5308       v#KAssa3        =  KAssa         [3]
     5309       v#KAssa4        =  KAssa         [4]
     5310       v#KAssa5        =  KAssa         [5]
     5311       v#KAssa6        =  KAssa         [6]      no-error.
     5312      If RR <= xBSAmount Then DO:
     5313      Create TMP#bs.
     5314      run eqq.
     5315      End.
     5316    Else DO:
     5317         Find Last TMP#bs  use-index Byf-avr.
     5318         If available TMP#bs AND ABSOLUTE (v#f-avr ) > ABSOLUTE (TMP#bs.f-avr ) Then run eqq.
     5319    End.
     5320   END PROCEDURE.
     5321   PROCEDURE Eqq :
     5322      Assign
     5323       TMP#bs.b-code        = v#b-code
     5324       TMP#bs.artic         = v#artic
     5325       TMP#bs.prod-code     = v#prod-code
     5326       TMP#bs.prod-type     = v#prod-type
     5327       TMP#bs.prt-root      = v#prt-root
     5328       TMP#bs.grp-name      = v#grp-name
     5329       TMP#bs.F-zakaz       = v#F-zakaz
     5330       TMP#bs.F-center-stock= v#F-center-stock
     5331       TMP#bs.Prih          = v#Prih
     5332       TMP#bs.ostatok-end   = v#ostatok-end
     5333       TMP#bs.f-avr         = v#f-avr
     5334       TMP#bs.kASSA1        = v#kASSA1
     5335       TMP#bs.KAssa2        = v#KAssa2
     5336       TMP#bs.KAssa3        = v#KAssa3
     5337       TMP#bs.KAssa4        = v#KAssa4
     5338       TMP#bs.KAssa5        = v#KAssa5
     5339       TMP#bs.KAssa6        = v#KAssa6
     5340       .
     5341   END PROCEDURE.
     5342   PROCEDURE PrintTempTAble :
     5343   define variable i as int init 0  no-undo.
     5344   define variable l as integer no-undo .
     5345   define variable v-nn as integer   no-undo .
     5346       For each TMP#bs  where TMP#bs.f-avr <> 0 by
     5347        (if xSorttype = "sort-code":U  THEN string (TMP#bs.b-code)
     5348          ELSE if xSorttype = "sort-artic":U  THEN TMP#bs.artic
     5349               ELSE  string (TMP#bs.f-avr,"9999999999.999"))   :
     5350                   i = i + 1 .
     5351    qnty-orders = "".
     5352       v-nn = num-entries (Number-Orders,CHR(9)) .
     5353   if showorders = true then DO:
     5354       repeat l = 1 to v-nn :
     5355       If entry (l,Number-Orders,CHR(9)) <> ?
     5356          and entry (l,Number-Orders,CHR(9)) <> ""
     5357          and entry (l,Number-Orders,CHR(9)) <> "0" Then DO:
     5358         Find first ub.doc-line where
     5359               entry (l,Number-Orders,CHR(9)) =  ub.doc-line.doc-code
     5360               AND   ub.doc-line.obj-code   = x-store-code
     5361               AND   ub.doc-line.obj-type   = x-store-type
     5362               AND   ub.doc-line.prod-code  = TMP#bs.prod-code
     5363               AND   ub.doc-line.prod-type  = TMP#bs.prod-type
     5364               AND   ub.doc-line.status_    = 'запрос':U
     5365               AND   ub.doc-line.artic      = TMP#bs.artic
     5366               no-lock no-error .
     5367               qnty-orders =  qnty-orders  +
     5368                          (if avail ub.doc-line then
     5369                         string (ub.doc-line.fact-qnty)  Else "0")  +  "," .
     5370        End.
     5371       End.
     5372    End.
     5373    Else qnty-orders = "".
     5374                   run display-line-tmp (i).
     5375       End.
     5376       run u-line.
     5377       qnty-orders = "".
     5378   end procedure.
     5379   procedure display-line-tmp :
     5380   define input parameter i as int no-undo.
     5381                run display-str-ex  ( ':',
     5382                   i                    ,
     5383                   tmp#bs.artic            ,
     5384                   tmp#bs.f-zakaz             ,
     5385                   tmp#bs.f-center-stock      ,
     5386                   tmp#bs.prih                ,
     5387                   tmp#bs.ostatok-end         ,
     5388                   tmp#bs.f-avr               ,
     5389                   tmp#bs.kassa1              ,
     5390                   tmp#bs.kassa2              ,
     5391                   tmp#bs.kassa3              ,
     5392                   tmp#bs.kassa4              ,
     5393                   tmp#bs.kassa5              ,
     5394                   tmp#bs.kassa6              ).
     5395   end procedure.
     5396   procedure ob-line-1  :
     5397   define input  parameter x-store-code     like clients.obj-code      no-undo.
     5398   define input  parameter x-store-type     like clients.obj-type      no-undo.
     5399   define input  parameter x-artic          like ub.stk-line.artic        no-undo.
     5400   define input  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5401   define input  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5402   define input  parameter x-fact-order-1   like ub.stk-line.fact-order   no-undo.
     5403   define input  parameter x-fact-order-2   like ub.stk-line.fact-order   no-undo.
     5404   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5405   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5406   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     5407   define input  parameter xtog-obj         as log no-undo.
     5408   define input  parameter xi               as int no-undo.
     5409   define output  parameter quntity         like ub.stk-line.fact-qnty   no-undo.
     5410   define variable  first-sum   like ub.stk-line.fact-qnty   no-undo.
     5411     assign
     5412       first-sum = 0
     5413       quntity = 0
     5414       .
     5415       for each obj-list  where
     5416                obj-list.obj-type = x-store-type  and
     5417                obj-list.obj-code = x-store-code
     5418                :
     5419         for each temp#sum-type where
     5420                  temp#sum-type.xi = xi
     5421                  :
     5422         for each  ub.ot-line no-lock where
     5423                   ub.ot-line.artic         = x-artic                and
     5424                   ub.ot-line.fact-order   <= x-fact-order-2         and
     5425                   ub.ot-line.fact-order   >= x-fact-order-1         and
     5426                   ub.ot-line.obj-code     = obj-list.obj-code       and
     5427                   ub.ot-line.obj-type     = obj-list.obj-type       and
     5428                   ub.ot-line.prod-code    = x-prod-code             and
     5429                   ub.ot-line.prod-type    = x-prod-type             and
     5430                   ub.ot-line.sum-type     = 'crsa':U             and
     5431                   ub.ot-line.ext-doc-type = temp#sum-type.sum-type
     5432                  :
     5433               assign
     5434                 first-sum = first-sum + ub.ot-line.fact-qnty
     5435                 .
     5436         end.
     5437       end.
     5438    end.
     5439    Quntity = first-sum.
     5440   END PROCEDURE.
     5441   def var vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5442   procedure macr_excel_char :
     5443    do
     5444    on error undo, return error return-value
     5445    :
     5446    define input parameter  p-val as character no-undo .
     5447    define input parameter  p-row as integer no-undo .
     5448    define input parameter  p-col as integer no-undo .
     5449    if p-val = ? then p-val = "" .
     5450       put stream macr_excel unformatted
     5451             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5452    end.
     5453   end procedure.
     5454   procedure macr_excel_char_with_format :
     5455    do
     5456    on error undo, return error return-value
     5457    :
     5458    define input parameter  p-val as character no-undo .
     5459    define input parameter  p-row as integer no-undo .
     5460    define input parameter  p-col as integer no-undo .
     5461    if p-val = ? then p-val = "" .
     5462       put stream macr_excel unformatted
     5463             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     5464       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     5465       put stream macr_excel unformatted
     5466             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5467    end.
     5468   end procedure.
     5469   procedure macr_excel_cell_format :
     5470    do
     5471    on error undo, return error return-value
     5472    :
     5473    define input parameter  p-val    as character no-undo .
     5474    define input parameter  p-row    as integer   no-undo .
     5475    define input parameter  p-col    as integer   no-undo .
     5476    define input parameter  p-format as character no-undo .
     5477    if p-val = ? then p-val = "" .
     5478       put stream macr_excel unformatted
     5479             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     5480       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     5481       put stream macr_excel unformatted
     5482             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5483    end.
     5484   end procedure.
     5485   procedure macr_excel_sum :
     5486    do
     5487    on error undo, return error return-value
     5488    :
     5489    define input parameter  p-row as integer no-undo .
     5490    define input parameter  p-col as integer no-undo .
     5491    define input parameter  p-row1 as integer no-undo .
     5492    define input parameter  p-col1 as integer no-undo .
     5493    define input parameter  p-row2 as integer no-undo .
     5494    define input parameter  p-col2 as integer no-undo .
     5495       put stream macr_excel unformatted
     5496             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     5497    end.
     5498   end procedure.
     5499   procedure macr_excel_dec :
     5500    do
     5501    on error undo, return error return-value
     5502    :
     5503    define input parameter  p-val as character no-undo .
     5504    define input parameter  p-row as integer   no-undo .
     5505    define input parameter  p-col as integer   no-undo .
     5506     if p-val = ? then p-val =  "" .
     5507      put  stream macr_excel unformatted
     5508           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     5509    end.
     5510   end procedure.
     5511   procedure macr_cell_format :
     5512    do
     5513    on error undo, return error return-value
     5514    :
     5515    define input parameter  p-size   as integer   no-undo .
     5516    define input parameter  p-bold   as logical   no-undo .
     5517    define input parameter  p-italic as logical   no-undo .
     5518    define input parameter  p-color  as integer   no-undo .
     5519    define input parameter  p-row    as integer   no-undo .
     5520    define input parameter  p-col    as integer   no-undo .
     5521    define input parameter  p-row-2  as integer   no-undo .
     5522    define input parameter  p-col-2  as integer   no-undo .
     5523     if p-size = ? then p-size = 10 .
     5524     if p-bold = ? then p-bold = false .
     5525     if p-italic = ? then p-italic = false .
     5526     if p-row-2 = ? then p-row-2 = p-row .
     5527     if p-col-2 = ? then p-col-2 = p-col .
     5528     put  stream macr_excel unformatted
     5529      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     5530     if p-color <> ? then do:
     5531        put  stream macr_excel unformatted
     5532          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     5533     end.
     5534     put  stream macr_excel unformatted
     5535          substitute('format.font(,&1,&2,&3)' , p-size,
     5536                                           string ( p-bold  , "true/false" ) ,
     5537                                           string ( p-italic , "true/false" )
     5538                                           ) + chr(10) .
     5539    end.
     5540   end procedure.
     5541   procedure macr_cell_size :
     5542    do
     5543    on error undo, return error return-value
     5544    :
     5545    define input parameter  p-w   as integer   no-undo .
     5546    define input parameter  p-l   as integer   no-undo .
     5547    define input parameter  p-row    as integer   no-undo .
     5548    define input parameter  p-col    as integer   no-undo .
     5549    define input parameter  p-row-2  as integer   no-undo .
     5550    define input parameter  p-col-2  as integer   no-undo .
     5551     if p-row-2 = ? then p-row-2 = p-row .
     5552     if p-col-2 = ? then p-col-2 = p-col .
     5553     if p-w = ? then    p-w = 0 .
     5554     if p-l = ? then    p-l = 0 .
     5555    define variable s-w as character no-undo .
     5556    define variable s-l as character no-undo .
     5557    if p-w = 0 then s-w = "" .
     5558               else s-w = string(p-w)  .
     5559    if p-l = 0 then s-l = "" .
     5560               else s-l = string(p-l)  .
     5561   put  stream macr_excel unformatted
     5562        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     5563   put  stream macr_excel unformatted
     5564        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     5565   put  stream macr_excel unformatted
     5566        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     5567    end.
     5568   end procedure.
     5569   procedure proc-print-header :
     5570    do
     5571    on error undo, return error return-value
     5572    :
     5573      find first sheetf .
     5574        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     5575        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     5576        var-1 =  num#str# .
     5577        repeat c-c = 1 to sheetf.excel-row-title :
     5578        num#str# = num#str# + 1 .
     5579        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     5580        do c-i = 1 to p-var :
     5581           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     5582           str--2 = integer(entry( c-i, sheetf.sizes )) .
     5583           num#col# = c-i .
     5584           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     5585           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     5586        end.
     5587       c-i = 0.
     5588       end.
     5589       run macr_cell_format (
     5590           10       ,
     5591           true     ,
     5592           false    ,
     5593           35       ,
     5594           var-1 + 1,
     5595           1        ,
     5596           num#str# ,
     5597           num#col# )
     5598           .
     5599     put  stream macr_excel unformatted
     5600          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     5601          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     5602          .
     5603    end.
     5604   end procedure.
     5605   procedure end-proc :
     5606    do
     5607    on error undo, return error return-value
     5608    :
     5609     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     5610     OUTPUT to VALUE (v-file-name) .
     5611     for each temp-param :
     5612       export  temp-param  .
     5613     end.
     5614    end.
     5615   end procedure.
     5616   procedure new-tmp-page :
     5617    do
     5618    on error undo, return error return-value
     5619    :
     5620       if   num#str#  >=  63000  then do:
     5621           output stream macr_excel  close .
     5622           run paramls-write in this-procedure
     5623              (input "file"
     5624             ,input string (v-ind)
     5625             ,input v-file-name
     5626             ) .
     5627           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5628           output stream  macr_excel to value (v-file-name) .
     5629           v-ind = v-ind + 1 .
     5630           num#str# = 0 .
     5631      run make-col .
     5632      run proc-print-header .
     5633     end.
     5634    end.
     5635   end procedure.
     5636   procedure make-col :
     5637   do
     5638   on error undo, return error return-value
     5639   :
     5640     num#str# = num#str# + 2.
     5641   end.
     5642   end procedure.
