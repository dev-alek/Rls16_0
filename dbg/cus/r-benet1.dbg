     1359   PROCEDURE foreach :
     1360    R = R + 1.
     1361   IF ( r modulo v-account = 0 )  then DO:
     1362    Assign
     1363       v-kol-spice = (50 - LENGTH(objname)) / 2
     1364       RecordsString = fill(' ',v-kol-spice) + string(objname)
     1365       .
     1366             if  log-manager:logfile-name ne ?
     1367             then DO:
     1368                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1369             end.
     1370              if mFrameView
     1371              then do:
     1372               DISPLAY
     1373                 r @ RecordsDone
     1374                 RecordsString   @ RecordsString
     1375                 WITH FRAME InfoFrame.
     1376              end.
     1377   End.
     1378      if v-button-stop then  DO:
     1379            if mFrameView
     1380            then
     1381               PROCESS EVENTS.
     1382            IF StopProcessing THEN DO:
     1383            RETURN error.
     1384            End.
     1385      end.
     1386     run clear-item in this-procedure .
     1387     run zakaz in this-procedure .
     1388     IF NOT Show-Negativ  AND  f-zakaz  = 0 THEN RETURN.
     1389   run ost-line in this-procedure
     1390                  (input   x-store-code  ,
     1391                   input   x-store-type  ,
     1392                   input   gds-zap-artic     ,
     1393                   input   gds-zap-prod-code ,
     1394                   input   gds-zap-prod-type ,
     1395                   input   x-tog-shift       ,
     1396                   input   Fact-order-2               ,
     1397                   input   'crsa':U            ,
     1398                   input   '##,##':U    ,
     1399                   input   xtog-obj    ,
     1400                   output  quantity    ,
     1401                   output  coast_r     ,
     1402                   output  coast_v     ,
     1403                   output  vat_r       ,
     1404                   output  vat_v       ,
     1405                   output  slt_r       ,
     1406                   output  slt_v       ).
     1407   assign
     1408     ostatok-end [1 + 0]   = quantity
     1409    ostatok-end [2 + 0]   = if tprintrubl then coast_r else coast_v
     1410    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1411    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1412    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1413    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1414    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1415    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1416    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1417    .
     1418    assign
     1419     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1420     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1421     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1422    .
     1423      run ob-line in this-procedure ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code   ,
     1424         input   gds-zap-prod-type   ,
     1425         input   fact-order-1,
     1426         input   fact-order-2,
     1427         input   'crsa':U    ,  input   '##,##':U, input   "", input   xtog-obj ,
     1428         input   1 ,
     1429         output prih[1]   ).
     1430   f-center-stock = f-zakaz - prih[1].
     1431      run ob-line-1 in this-procedure ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1432         input   fo0,
     1433         input   fo02,
     1434         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1435         input   2 ,
     1436         output kassa[1]   ).
     1437    If Showorders = false THEN DO:
     1438      run ob-line-1 in this-procedure ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1439         input   fo1,
     1440         input   fo12,
     1441         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1442         input   2 ,
     1443         output kassa[2]   ).
     1444      run ob-line-1 in this-procedure   ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1445         input   fo2,
     1446         input   fo22,
     1447         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1448         input   2 ,
     1449         output kassa[3]   ).
     1450      run ob-line-1 in this-procedure   ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1451         input   fo3,
     1452         input   fo32,
     1453         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1454         input   2 ,
     1455         output kassa[4]   ).
     1456      run ob-line-1 in this-procedure   ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1457         input   fo4,
     1458         input   fo42,
     1459         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1460         input   2 ,
     1461         output kassa[5]   ).
     1462      run ob-line-1 in this-procedure   ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1463         input   fo5,
     1464         input   fo52,
     1465         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1466         input   2 ,
     1467         output kassa[6]   ).
     1468   end.
     1469      f-avr = round ( kassa[1] / if integer (fo02 - fo0) = 0 then 1 else integer (fo02 - fo0) , 3) .
     1470      if not tog-qnty then  run calc-sub-itog in this-procedure   (0).
     1471         else do :
     1472              rr = rr + 1 .
     1473              run maketemptable in this-procedure   .
     1474               return error.
     1475         end.
     1476   END PROCEDURE.
     1477   PROCEDURE display-line :
     1478        IF  NOT  (NOT Show-Negativ  AND   f-zakaz  = 0  aND PRIH[1] = 0  AND kassa[1] = 0 ) then DO:
     1479           IF NOT Sums-Only then DO:
     1480              ii = ii + 1.
     1481              run display-str1 in this-procedure .
     1482             End.
     1483        END.
