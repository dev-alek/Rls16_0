     4571   PROCEDURE ob-line  :
     4572   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     4573   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     4574   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     4575   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     4576   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     4577   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     4578   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     4579   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     4580   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     4581   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     4582   define input  parameter xTog-obj         as log no-undo.
     4583   define input  parameter xi               as int no-undo.
     4584   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     4585   define variable  First-sum   like ub.stk-line.fact-qnty   no-undo.
     4586   define variable  Second-sum  like ub.stk-line.fact-qnty   no-undo.
     4587   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     4588     Assign First-sum = 0 Second-sum = 0 Quntity = 0 .
     4589     For EAch obj-list  where  x-store-type = obj-list.obj-type  AND  x-store-code = obj-list.obj-code
     4590      no-lock:
     4591      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     4592         FIND LAST ub.stk-line where
     4593                                 ub.stk-line.artic         = x-artic
     4594                           AND   ub.stk-line.fact-order   <= x-fact-order-1
     4595                           AND   ub.stk-line.obj-code     = obj-list.obj-code
     4596                           AND   ub.stk-line.obj-type     = obj-list.obj-type
     4597                           AND   ub.stk-line.prod-code    = x-prod-code
     4598                           AND   ub.stk-line.prod-type    = x-prod-type
     4599                           AND   ub.stk-line.sum-type     = temp#sum-type.sum-type
     4600                           AND   ub.stk-line.cat-id       = '##,##':U
     4601                                 no-lock use-index pi no-error.
     4602              if available ub.stk-line THEN First-sum = First-sum + ub.stk-line.fact-qnty.
     4603         FIND LAST STK-line2 where
     4604                                 STK-line2.artic         = x-artic
     4605                           AND   STK-line2.fact-order   <= x-fact-order-2
     4606                           AND   STK-line2.obj-code     = obj-list.obj-code
     4607                           AND   STK-line2.obj-type     = obj-list.obj-type
     4608                           AND   STK-line2.prod-code    = x-prod-code
     4609                           AND   STK-line2.prod-type    = x-prod-type
     4610                           AND   STK-line2.sum-type     = temp#sum-type.sum-type
     4611                           AND   STK-line2.cat-id       = '##,##':U
     4612                                 no-lock use-index pi  no-error.
     4613              if available STK-LINE2 THEN Second-sum = Second-sum + Stk-line2.fact-qnty.
     4614      End.
     4615      End.
     4616      Quntity = Second-sum - first-sum.
     4617   END PROCEDURE.
     4618   procedure ost-line :
     4619     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4620     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4621     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4622     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4623     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4624     define input  parameter x-tog-shift  as logical no-undo .
     4625     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4626     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4627     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4628     define input  parameter xtog-obj     as logical no-undo .
     4629     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4630     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4631     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4632     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4633     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4634     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4635     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4636     define buffer buff-obj-list  for obj-list .
     4637     define buffer buff-stk-line  for ub.stk-line .
     4638     assign
     4639       Quantity = 0
     4640       Coast_R  = 0
     4641       Coast_V  = 0
     4642       VAT_R    = 0
     4643       VAT_V    = 0
     4644       SLT_R    = 0
     4645       SLT_V    = 0
     4646     .
     4647     if  x-tog-shift = false then do:
     4648       for each buff-obj-list no-lock
     4649         where xtog-obj = false
     4650            or (buff-obj-list.obj-type = x-store-type
     4651               and buff-obj-list.obj-code = x-store-code
     4652               )
     4653       on error undo, return error
     4654       :
     4655         find last buff-stk-line no-lock
     4656           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4657             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4658             and buff-stk-line.artic      = x-artic
     4659             and buff-stk-line.prod-type  = x-prod-type
     4660             and buff-stk-line.prod-code  = x-prod-code
     4661             and buff-stk-line.sum-type   = x-sum-type
     4662             and buff-stk-line.cat-id     = '##,##':U
     4663             and buff-stk-line.fact-order <= x-fact-order
     4664             and buff-stk-line.shift-num  = 0
     4665           use-index category
     4666           no-error .
     4667         if available buff-stk-line then do:
     4668           assign
     4669             Quantity = Quantity +  buff-stk-line.fact-qnty
     4670             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4671             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4672             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4673             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4674             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4675             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4676           .
     4677         end.
     4678       end.
     4679     end.
     4680     else do:
     4681       for each buff-obj-list no-lock
     4682         where xtog-obj = false
     4683            or (buff-obj-list.obj-type = x-store-type
     4684               and buff-obj-list.obj-code = x-store-code
     4685               )
     4686       on error undo, return error
     4687       :
     4688         find last buff-stk-line no-lock
     4689           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4690             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4691             and buff-stk-line.artic      = x-artic
     4692             and buff-stk-line.prod-type  = x-prod-type
     4693             and buff-stk-line.prod-code  = x-prod-code
     4694             and buff-stk-line.sum-type   = x-sum-type
     4695             and buff-stk-line.cat-id     = '##,##':U
     4696             and buff-stk-line.fact-order <= x-fact-order
     4697             and buff-stk-line.shift-num  > 0
     4698           use-index category
     4699           no-error .
     4700         if available buff-stk-line then do:
     4701           assign
     4702             Quantity = Quantity +  buff-stk-line.fact-qnty
     4703             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4704             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4705             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4706             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4707             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4708             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4709           .
     4710         end.
     4711       end.
     4712     end.
     4713   end procedure.
     4714   procedure ost-lineother-tax :
     4715     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4716     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4717     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4718     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4719     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4720     define input  parameter x-tog-shift  as logical no-undo .
     4721     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4722     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4723     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4724     define input  parameter xTog-obj     as logical no-undo .
     4725     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4726     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4727     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4728     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4729     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4730     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4731     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4732     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4733     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4734     define buffer buff-obj-list  for obj-list .
     4735     define buffer buff-stk-line  for ub.stk-line .
     4736     assign
     4737       Quantity = 0
     4738       Coast_R  = 0
     4739       Coast_V  = 0
     4740       VAT_R    = 0
     4741       VAT_V    = 0
     4742       SLT_R    = 0
     4743       SLT_V    = 0
     4744       other_R  = 0
     4745       other_V  = 0
     4746     .
     4747     if  x-tog-shift = false then do:
     4748       for each buff-obj-list no-lock
     4749         where xtog-obj = false
     4750            or (buff-obj-list.obj-type = x-store-type
     4751               and buff-obj-list.obj-code = x-store-code
     4752               )
     4753       on error undo, return error
     4754       :
     4755         find last buff-stk-line no-lock
     4756           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4757             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4758             and buff-stk-line.artic      = x-artic
     4759             and buff-stk-line.prod-type  = x-prod-type
     4760             and buff-stk-line.prod-code  = x-prod-code
     4761             and buff-stk-line.sum-type   = x-sum-type
     4762             and buff-stk-line.cat-id     = '##,##':U
     4763             and buff-stk-line.fact-order <= x-fact-order
     4764             and buff-stk-line.shift-num  = 0
     4765           use-index category
     4766           no-error .
     4767         if available buff-stk-line then do:
     4768           assign
     4769             Quantity = Quantity +  buff-stk-line.fact-qnty
     4770             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4771             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4772             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4773             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4774             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4775             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4776             other_R  = other_R  +  buff-stk-line.other-rubl
     4777             other_V  = other_V  +  buff-stk-line.other-base
     4778           .
     4779         end.
     4780       end.
     4781     end.
     4782     else do:
     4783       for each buff-obj-list no-lock
     4784         where xtog-obj = false
     4785            or (buff-obj-list.obj-type = x-store-type
     4786               and buff-obj-list.obj-code = x-store-code
     4787               )
     4788       on error undo, return error
     4789       :
     4790         find last buff-stk-line no-lock
     4791           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4792             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4793             and buff-stk-line.artic      = x-artic
     4794             and buff-stk-line.prod-type  = x-prod-type
     4795             and buff-stk-line.prod-code  = x-prod-code
     4796             and buff-stk-line.sum-type   = x-sum-type
     4797             and buff-stk-line.cat-id     = '##,##':U
     4798             and buff-stk-line.fact-order <= x-fact-order
     4799             and buff-stk-line.shift-num  > 0
     4800           use-index category
     4801           no-error .
     4802         if available buff-stk-line then do:
     4803           assign
     4804             Quantity = Quantity +  buff-stk-line.fact-qnty
     4805             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4806             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4807             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4808             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4809             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4810             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4811             other_R = other_R   +  buff-stk-line.other-rubl
     4812             other_V = other_V   +  buff-stk-line.other-base
     4813           .
     4814         end.
     4815       end.
     4816     end.
     4817   end procedure.
     4818   procedure ost-line-kg :
     4819     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4820     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4821     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4822     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4823     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4824     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4825     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4826     define buffer buff-obj-list  for obj-list .
     4827     define buffer buf_doc-line for ub.doc-line .
     4828     define buffer buf_inv-line for ub.inv-line .
     4829     do
     4830     on error undo, return error
     4831     :
     4832       for each buf_doc-line no-lock where
     4833                buf_doc-line.obj-type    = p-obj-type   and
     4834                buf_doc-line.obj-code    = p-obj-code   and
     4835                buf_doc-line.prod-type   = p-prod-type  and
     4836                buf_doc-line.prod-code   = p-prod-code  and
     4837                buf_doc-line.artic       = p-artic      and
     4838                buf_doc-line.status_     = 'факт':U      and
     4839                buf_doc-line.fact-order <= p-fact-order
     4840             by buf_doc-line.fact-order    descending
     4841       :
     4842         find first buf_inv-line no-lock where
     4843                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4844                    buf_inv-line.artic     = buf_doc-line.artic     and
     4845                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4846                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4847         if available buf_inv-line
     4848         then do:
     4849           if buf_inv-line.after-cli-qnty <> ?
     4850           then do:
     4851             assign
     4852               p-quantity-kg = buf_inv-line.after-cli-qnty
     4853             .
     4854             leave .
     4855           end.
     4856         end.
     4857       end.
     4858       if p-quantity-kg = ?
     4859       then do:
     4860         assign
     4861           p-quantity-kg = 0
     4862         .
     4863       end.
     4864     end.
     4865   end procedure.
     4866   PROCEDURE ostatok :
     4867   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4868   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4869   def input parameter x-tog-shift   as   logical             no-undo.
     4870   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4871   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4872   def input parameter x-shift-start as integer               no-undo.
     4873   def input parameter x-shift-end   as integer               no-undo.
     4874   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4875   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4876   def input parameter xTog-obj   as log no-undo.
     4877   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4878   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4879   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4880   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4881   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4882   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4883   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4884   def var              Fact-orderS   as char  no-undo.
     4885   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4886      Assign
     4887         Fact-order   = 0
     4888         Quantity     = 0
     4889         Coast_R      = 0
     4890         Coast_V      = 0
     4891         VAT_R        = 0
     4892         VAT_V        = 0 .
     4893    x-date-start-t  = x-date-start + 1 .
     4894   IF x-date-end = date('') then DO:
     4895      Fact-order = 0 .
     4896      for each obj-list
     4897          where  ( not xtog-obj or
     4898                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4899                 no-lock :
     4900         if  x-tog-shift = false then do:
     4901                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4902                               ub.stk-tot.Fact-date <=  x-date-start
     4903                               and ub.stk-tot.shift-num = 0
     4904                               USE-INDEX fact-date no-lock no-error .
     4905              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4906         End.
     4907         Else  DO :
     4908             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4909              (ub.stk-tot.shift-date  = x-date-start-t and
     4910               ub.stk-tot.shift-num  < x-shift-start or
     4911               ub.stk-tot.shift-date  < x-date-start-t  )
     4912               and ub.stk-tot.shift-num  > 0
     4913               USE-INDEX Shift-num no-lock no-error .
     4914            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4915           END.
     4916       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4917     End.
     4918   End.
     4919   Else DO:
     4920     For each obj-list  WHERE
     4921        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4922         no-lock :
     4923      IF  x-TOG-Shift = False Then DO:
     4924          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4925               ub.stk-tot.Fact-date <= x-date-end
     4926               and ub.stk-tot.shift-num = 0
     4927               USE-INDEX fact-date no-lock no-error.
     4928          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4929      END.
     4930      Else DO:
     4931           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4932               (ub.stk-tot.shift-date  = x-date-end and
     4933               ub.stk-tot.shift-num  <= x-shift-end or
     4934               ub.stk-tot.shift-date  < x-date-end       ) and
     4935               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4936               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4937       End.
     4938       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4939     End.
     4940   End.
     4941   END PROCEDURE.
     4942   PROCEDURE report-exec1  :
     4943   for each TMP#bs share-lock: delete TMP#bs. end.
     4944      FIND FIRST clients where x-store-type = clients.obj-type AND
     4945                               x-store-code = clients.obj-code no-lock no-error.
     4946              If available clients then  ObjName = clients.obj-name.
     4947                                            else  ObjName = "объект не определен".
     4948     run calcitog.
     4949     run print-header.
     4950      case retclassify :
     4951         when "no-classify":u    then  run run1.
     4952         when "grp-goods":u      then  run run2.
     4953         when "prod":u           then  run run3.
     4954         when "prod/grp-goods":u then  run run4.
     4955         when "grp-goods/prod":u then  run run5.
     4956         when "vat-ps":u         then  run run7.
     4957      end case.
     4958      if tog-qnty then
     4959         run printtemptable in this-procedure .
     4960         else run print-footer in this-procedure  .
     4961     END PROCEDURE.
     4962   PROCEDURE Calc-Sub-itog :
     4963   define input parameter tt as int no-undo.
     4964   define variable b as int no-undo.
     4965     Assign
     4966     B1-Prih[1]    = B1-Prih[1]    +  Prih[1]
     4967     B2-Prih[1]    = B2-Prih[1]    +  Prih[1]
     4968     Bi-Prih[1]    = Bi-Prih[1]    +  Prih[1]
     4969     B1-f-zakaz    = B1-f-zakaz   + f-zakaz
     4970     B2-f-zakaz    = B2-f-zakaz   + f-zakaz
     4971     Bi-f-zakaz    = Bi-f-zakaz   + f-zakaz
     4972     B1-F-Center-stock = B1-F-Center-stock  +  F-Center-stock
     4973     B2-F-Center-stock = B2-F-Center-stock  +  F-Center-stock
     4974     Bi-F-Center-stock = Bi-F-Center-stock  +  F-Center-stock
     4975     B1-F-avr = B1-F-avr  +  F-avr
     4976     B2-F-avr = B2-F-avr  +  F-avr
     4977     Bi-F-avr = Bi-F-avr  +  F-avr.
     4978   repeat b = 1 to 6:
     4979     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT] .
     4980     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT] .
     4981     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT] .
     4982   End.
     4983   END PROCEDURE.
     4984   PROCEDURE Clear-item :
     4985   define variable kk as int no-undo.
     4986    REPEAT kk = 1 to 6:
     4987    Assign
     4988       prih                 [kk]    = 0
     4989       rash                 [kk]    = 0
     4990       kassa               [kk]    = 0
     4991       ostatok-end      [kk] =   0
     4992       ostatok-start    [kk] =   0   .
     4993          End.
     4994    END PROCEDURE.
     4995   PROCEDURE Item-Goods :
     4996    define input parameter  par-3 as char no-undo.
     4997    define input parameter  par-4 as char no-undo.
     4998         if par-4 = "goods":U  Then DO:
     4999             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     5000                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     5001                                   assign
     5002                                       gds-zap-unit-base  = Goods.unit-base
     5003                                       gds-zap-prt-root   = Goods.prt-root
     5004                                       gds-zap-prod-type  = Goods.prod-type
     5005                                       gds-zap-prod-code  = Goods.prod-code
     5006                                       gds-zap-artic      = Goods.artic
     5007                                       gds-zap-grp-name   = Goods.grp-name
     5008                                       gds-zap-b-code     = Goods.gds-code
     5009                                       gds-zap-prod-name  = clients.obj-name .
     5010                                   if g#gds-engl then
     5011                                       assign gds-zap-gds-name = Goods.engl-name.
     5012                                   else
     5013                                       assign gds-zap-gds-name = Goods.gds-name.
     5014                               End.
     5015        if par-4 = "gds-list":U  Then DO:
     5016             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     5017                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     5018                                   assign
     5019                                       gds-zap-unit-base  = gds-list.unit-base
     5020                                       gds-zap-prt-root   = gds-list.prt-root
     5021                                       gds-zap-prod-type  = gds-list.prod-type
     5022                                       gds-zap-prod-code  = gds-list.prod-code
     5023                                       gds-zap-artic      = gds-list.artic
     5024                                       gds-zap-grp-name   = gds-list.grp-name
     5025                                       gds-zap-b-code     = gds-list.gds-code
     5026                                       gds-zap-prod-name  = clients.obj-name .
     5027                                   if g#gds-engl then
     5028                                       assign gds-zap-gds-name = gds-list.engl-name.
     5029                                   else
     5030                                       assign gds-zap-gds-name = gds-list.gds-name.
     5031                               End.
     5032      run foreach.
     5033       if  break_group = true  and par-3 <> "1"  then do :
     5034            find first clients where clients.obj-type = gds-zap-prod-type and clients.obj-code = gds-zap-prod-code use-index pi no-lock .
     5035            gds-zap-prod-name  = clients.obj-name.
     5036             If break_group1 = true  THEN  DO :
     5037               if  (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     5038                 then DO: Assign temp-str = string ("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     5039                 else DO: Assign temp-str = string ("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     5040                 if par-3 = "6"  then  DO:
     5041                           var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     5042                           assign
     5043                               temp-str = string ( "СТАВКА НДС : " + string (var-vat-pc) + "%" )
     5044                               b1-name = temp-str.
     5045                 end.
     5046                  if NOT xSumsOnly or  (par-3 = "4" Or par-3 = "5" ) THEN DO :
     5047                   fr0 = true .
     5048                   tmp#stroka0 = temp-str.
     5049   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5050   Num#str# = Num#str# + 1.
     5051   run macr_excel_char ( string(tmp#stroka0)  , num#str# , 1 ) .
     5052                   run macr_cell_format  (
     5053                                 10       ,
     5054                                 true     ,
     5055                                 true     ,
     5056                                 36       ,
     5057                                 num#str#,
     5058                                 1        ,
     5059                                 num#str# ,
     5060                                 14 )
     5061                                 .
     5062                  End.
     5063             End.
     5064             IF  (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     5065               if par-3 = "4"
     5066                 then Assign temp-str = string ("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     5067                 else Assign temp-str = string ("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     5068               if NOT xSumsOnly THEN DO:
     5069                   fr = true .
     5070   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5071   Num#str# = Num#str# + 1.
     5072   run macr_excel_char ( string(temp-str)  , num#str# , 1 ) .
     5073      .
     5074                   run macr_cell_format  (
     5075                                 10       ,
     5076                                 true     ,
     5077                                 true     ,
     5078                                 37       ,
     5079                                 num#str#,
     5080                                 1        ,
     5081                                 num#str# ,
     5082                                 14 )
     5083                                 .
     5084               End.
     5085               break_group1 = false.
     5086             END.
     5087          break_group = false.
     5088       End.
     5089       If NOT Tog-Qnty THEN run display-line.
     5090    END PROCEDURE.
     5091   PROCEDURE Di :
     5092   define input parameter p1 as char no-undo.
     5093   define input parameter p2 as int no-undo.
     5094   define input parameter p3 as char no-undo.
     5095   define input parameter p4 as char no-undo.
     5096   define input parameter p5 as char no-undo.
     5097   define input parameter p6 as char no-undo.
     5098   define input parameter p7 as char no-undo.
     5099    CASE CAPS (p7) :
     5100      WHEN "B1":U  Then
     5101               run display-str-ex  ( '',
     5102                   p3                  ,
     5103                   p4                  ,
     5104                   b1-F-zakaz          ,
     5105                   b1-F-center-stock   ,
     5106                   b1-Prih       [1]   ,
     5107                   b1-ostatok-end[1]   ,
     5108                   b1-F-avr            ,
     5109                   b1-KAssa      [1]   ,
     5110                   b1-KAssa      [2]   ,
     5111                   b1-KAssa      [3]   ,
     5112                   b1-KAssa      [4]   ,
     5113                   b1-KAssa      [5]   ,
     5114                   b1-KAssa      [6]   ).
     5115      WHEN "B2":U  Then
     5116                run display-str-ex  ( '',
     5117                   p3                  ,
     5118                   p4                  ,
     5119                   b2-F-zakaz          ,
     5120                   b2-F-center-stock   ,
     5121                   b2-Prih [1]         ,
     5122                   b2-ostatok-end[1]   ,
     5123                   b2-F-avr            ,
     5124                   b2-KAssa      [1]   ,
     5125                   b2-KAssa      [2]   ,
     5126                   b2-KAssa      [3]   ,
     5127                   b2-KAssa      [4]   ,
     5128                   b2-KAssa      [5]   ,
     5129                   b2-KAssa      [6]   ).
     5130      WHEN "BI":U Then
     5131                run display-str-ex  ( '',
     5132                   ''                   ,
     5133                   p4                   ,
     5134                   bi-f-zakaz           ,
     5135                   bi-f-center-stock    ,
     5136                   bi-prih          [1] ,
     5137                   bi-ostatok-end   [1] ,
     5138                   bi-f-avr             ,
     5139                   bi-kassa       [1]   ,
     5140                   bi-kassa         [2] ,
     5141                   bi-kassa         [3] ,
     5142                   bi-kassa         [4] ,
     5143                   bi-kassa         [5] ,
     5144                   bi-kassa         [6] ).
     5145      when ""  then
     5146                run display-str-ex  ( ':',
     5147                   ii                    ,
     5148                   p4                    ,
     5149                   f-zakaz               ,
     5150                   f-center-stock        ,
     5151                   prih          [1]     ,
     5152                   ostatok-end   [1]     ,
     5153                   f-avr                 ,
     5154                   kassa         [1]     ,
     5155                   kassa         [2]     ,
     5156                   kassa         [3]     ,
     5157                   kassa         [4]     ,
     5158                   kassa         [5]     ,
     5159                   kassa         [6]     ).
     5160          end case.
     5161    end procedure.
     5162    procedure zakaz :
     5163      f-zakaz = 0.
     5164      for each ub.trn-doc where
     5165             ub.trn-doc.doc-date <= x-date-end
     5166       and   ub.trn-doc.doc-date >= x-date-start
     5167       and   ub.trn-doc.status_   = 'запрос':U
     5168       and   ub.trn-doc.internal  = false
     5169       and   ub.trn-doc.obj-code   = x-store-code
     5170       and   ub.trn-doc.obj-type   = x-store-type
     5171        no-lock :
     5172         for each ub.doc-line where
     5173                 ub.trn-doc.doc-code =  ub.doc-line.doc-code
     5174           and   ub.doc-line.obj-code   = x-store-code
     5175           and   ub.doc-line.obj-type   = x-store-type
     5176           and   ub.doc-line.prod-code  = gds-zap-prod-code
     5177           and   ub.doc-line.prod-type  = gds-zap-prod-type
     5178           and   ub.doc-line.status_    = 'запрос':U
     5179           and   ub.doc-line.artic      = gds-zap-artic    no-lock :
     5180                 f-zakaz = f-zakaz  +  ub.doc-line.doc-qnty   .
     5181         end.
     5182      end.
     5183   end procedure.
     5184   procedure maket :
     5185     create temp#sum-type no-error.
     5186     assign temp#sum-type.sum-type = 'cgdt':U + 'iv':U       temp#sum-type.xi = 1      .
     5187     create temp#sum-type no-error.
     5188     assign temp#sum-type.sum-type = 'cgdt':U +  'ev':U       temp#sum-type.xi = 1      .
     5189     Create temp#sum-type no-error.
     5190     Assign temp#sum-type.sum-type =  'es':U       temp#sum-type.xi = 2      .
     5191     Create temp#sum-type no-error.
     5192     Assign temp#sum-type.sum-type =  'rs':U   temp#sum-type.xi = 2      .
     5193    If tog-voz then do:
     5194       Create temp#sum-type no-error.
     5195       Assign temp#sum-type.sum-type =  're':U        temp#sum-type.xi = 2      .
     5196     End.
     5197    End procedure.
