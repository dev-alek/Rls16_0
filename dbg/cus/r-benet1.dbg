     4544       b2-Rash                                            [kk]    = 0
     4545       b2-KAssa                                           [kk]    = 0
     4546       b2-Inv                                             [kk]    = 0
     4547       b2-Overturn                                        [kk]    = 0
     4548       b2-ostatok-end                                     [kk]    = 0
     4549       b2-ostatok-start                                   [kk]    = 0
