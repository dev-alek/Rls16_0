     1562   function func-vat returns decimal (
     1563       input p-gds-code as integer  ,
     1564       input p-obj-type as character ,
     1565       input p-obj-code as integer  ).
     1566   define variable i-vat-pc as decimal no-undo .
     1567   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1569     (input  p-gds-code
     1570     ,input  '1':U
     1571     ,input  x-Date-End
     1572     ,input  v-cntxt-host-code-obj
     1573     ,input  p-obj-type
     1574     ,input  p-obj-code
     1575     ,output i-vat-pc
     1576     ) no-error .
     1577   if error-status :error then return 0 .
     1578   else return i-vat-pc.
     1579   end function .
     1580   procedure run1 :
     1581    run run1sort2.
     1582   end procedure.
     1583   procedure run1sort2 :
     1584          case select-good :
     1585           when 1  then do:
     1586   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1587   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1588       for each gds-obj  where
     1589             gds-obj.obj-type = x-store-type  and
     1590             gds-obj.obj-code = x-store-code
     1591             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1592                   no-lock,
     1593             First goods  where  gds-obj.gds-code   = goods.gds-code
     1594   no-lock
     1595   BREAK
     1596       BY (goods.artic) :
     1597         run item-goods ( "1" , "goods" ) .
     1598         if return-value <> "" then NEXT.
     1599       End.
     1600     END.
     1601     Else DO:
     1602      For each obj-list no-lock :
     1603                     FOR EACH gds-obj where
     1604                   gds-obj.obj-type = obj-list.obj-type    and
     1605                   gds-obj.obj-code = obj-list.obj-code
     1606                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1607                   no-lock :
     1608                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1609                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1610                       Create temp-gds-list.
     1611                       Assign
     1612                         temp-gds-list.prod-code = gds-obj.prod-code
     1613                         temp-gds-list.grp-name  = gds-obj.grp-name
     1614                         temp-gds-list.gds-name  = goods.gds-name
     1615                         temp-gds-list.gds-code  = gds-obj.gds-code
     1616                         temp-gds-list.artic     = gds-obj.artic
     1617                       .
     1618                   End.
     1619               End.
     1620     End.
     1621     for each temp-gds-list no-lock
     1622       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1623         BREAK
     1624       BY goods.artic :
     1625       run item-goods ( "1" , "goods" ) .
     1626         if return-value <> "" then NEXT.
     1627     End.
     1628   End.
     1629     end.
     1630           when 2  then do:
     1631   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632     if x-selectobject = "currency":u  or  xtog-obj then do:
     1633         for  each gds-obj
     1634                     where gds-obj.obj-code   = x-store-code
     1635                      and  gds-obj.obj-type   = x-store-type
     1636                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1637                           no-lock ,
     1638                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1639                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     1640                     break
     1641                     by goods.artic :
     1642                     run item-goods ( input "1" , input "goods" ) .
     1643                     if return-value <> "" then next.
     1644         end.
     1645     end.
     1646     else do:
     1647         for each obj-list no-lock :
     1648               for  each gds-obj
     1649                 where  gds-obj.obj-code   = obj-list.obj-code
     1650                   and  gds-obj.obj-type   = obj-list.obj-type
     1651                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1652                 no-lock ,
     1653                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1654                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     1655                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1656                           create temp-gds-list.
     1657                           assign
     1658                             temp-gds-list.prod-code = gds-obj.prod-code
     1659                             temp-gds-list.grp-name  = gds-obj.grp-name
     1660                             temp-gds-list.gds-name  = goods.grp-name
     1661                             temp-gds-list.gds-code  = gds-obj.gds-code
     1662                             temp-gds-list.artic     = gds-obj.artic
     1663                           .
     1664                       end.
     1665               end.
     1666       end.
     1667     for each temp-gds-list no-lock
     1668       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1669         break
     1670       by goods.artic :
     1671       run item-goods ( "1" , "goods" ) .
     1672         if return-value <> "" then next.
     1673     end.
     1674   end.
     1675     end.
     1676           when 3 then do:
     1677   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   if x-selectobject = "currency":u  or  xtog-obj then do:
     1679     for  each gds-obj
     1680         where  gds-obj.obj-code   = x-store-code
     1681           and  gds-obj.obj-type   = x-store-type
