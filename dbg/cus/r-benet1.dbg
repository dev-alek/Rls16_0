     1268   PROCEDURE report-execute :
     1269   define variable l as integer no-undo .
     1270   define variable lL as integer no-undo .
     1271   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   case x-set_pay_type :
     1273     when 1 then do:
     1274           tprintrubl = ( var-report-r-b = 'rubl':U ) .
     1275     end.
     1276     when 2 or when 3 then do:
     1277           if x-set_val_type = 1  then tprintrubl = yes .
     1278           if x-set_val_type = 2  then tprintrubl = no  .
     1279     end.
     1280   end case.
     1281       p-file-name =  string ( session:temp-directory +
     1282                                     "rpt" + string ( g#report-num ) + ".txt" ) .
     1283        output stream outstream to value ( string ( session:temp-directory +
     1284                                     "rpt" + string ( g#report-num ) ) )      .
     1285       run maket in this-procedure .
     1286       run gbl/_tmpfile.p  ( "wb", ".txt", output v-file-name) .
     1287       output stream macr_excel to value (v-file-name)   .
     1288                   put stream  outstream  "1" format "x (100)" skip .
     1289       v-ind = 1    .
     1290       num#str# = 0 .
     1291         num#str# = num#str# + 1 .
     1292         num#col# =  1 .
     1293         run macr_excel_char_with_format ( reportname , num#str# , num#col#  ).
     1294         run macr_cell_format
     1295              ( 12    ,
     1296               true  ,
     1297               false ,
     1298               ?     ,
     1299               num#str# ,
     1300               num#col# ,
     1301               ? ,
     1302               ?         ) .
     1303   define variable l-ii  as integer no-undo .
     1304   define variable l-jj  as integer no-undo .
     1305   define variable l-len as integer no-undo .
     1306   define variable l-m   as integer no-undo .
     1307   define variable v-nn as integer   no-undo .
     1308   v-nn = num-entries ( str1 , "chr(10)"  ) .  do l-ii = 1 to v-nn   :        l-len = length  (entry ( l-ii , str1  , "chr(10)")) .                       l-m = integer ( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                                        substring (entry ( l-ii , str1  , "chr(10)") ,  ( ( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1309   v-nn = num-entries ( str2 , "chr(10)"  ) .  do l-ii = 1 to v-nn   :        l-len = length  (entry ( l-ii , str2  , "chr(10)")) .                       l-m = integer ( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                                        substring (entry ( l-ii , str2  , "chr(10)") ,  ( ( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1310   v-nn = num-entries ( str3 , "chr(10)"  ) .  do l-ii = 1 to v-nn   :        l-len = length  (entry ( l-ii , str3  , "chr(10)")) .                       l-m = integer ( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                                        substring (entry ( l-ii , str3  , "chr(10)") ,  ( ( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1311   v-nn = num-entries ( str4 , "chr(10)"  ) .  do l-ii = 1 to v-nn   :        l-len = length  (entry ( l-ii , str4  , "chr(10)")) .                       l-m = integer ( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                                        substring (entry ( l-ii , str4  , "chr(10)") ,  ( ( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1312   v-nn = num-entries ( reportheader , "chr(10)"  ) .  do l-ii = 1 to v-nn   :        l-len = length  (entry ( l-ii , reportheader  , "chr(10)")) .                       l-m = integer ( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                                        substring (entry ( l-ii , reportheader  , "chr(10)") ,  ( ( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1313     num#str# = num#str# + 1.
     1314     num#col# = 1.
     1315     run macr_excel_char_with_format (
     1316           "Дата печати : " + string (today,"99.99.9999") +  " , "     +
     1317         " Цены указаны в " +
     1318          (if tprintrubl then "РУБ" else x-base-type )
     1319         , num#str#
     1320         , num#col#
     1321           ) .
     1322   run make-col in this-procedure .
     1323   run proc-print-header in this-procedure .
     1324      define variable gj as integer no-undo init 0.
     1325      if xtog-obj  then do:
     1326         for each obj-list no-lock:
     1327             x-store-type = obj-list.obj-type.
     1328             x-store-code = obj-list.obj-code.
     1329             run report-exec1 in this-procedure .
     1330             gj = gj + 1 .
     1331         end.
     1332         if gj > 1 then   run display-bo in this-procedure .
     1333         end.
     1334      else  run report-exec1 in this-procedure .
     1335      output stream outstream close.
     1336      output stream outstream2 close.
     1337     output stream macr_excel  close .
     1338   if mFrameView
     1339   then do:
     1340      HIDE FRAME InfoFrame.
     1341   end.
     1342       run paramls-write in this-procedure
     1343          (input "file"
     1344         ,input string (v-ind)
     1345         ,input v-file-name
     1346         ) .
     1347       run paramls-write in this-procedure
     1348          (input "charcol"
     1349         ,input ""
     1350         ,input "2"
     1351         ) .
     1352     run end-proc in this-procedure .
     1353   if mFrameView
     1354   then do:
     1355      HIDE FRAME InfoFrame.
     1356   end.
     1357     run rep/runexcel.p  (p-file-name ).
