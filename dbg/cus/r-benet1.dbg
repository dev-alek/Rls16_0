     1485   PROCEDURE print-header :
     1486   define variable l-name as character no-undo .
     1487   define variable mm as integer no-undo .
     1488   define variable RANGES as character no-undo .
     1489   if Showorders = false then
     1490       if NOT FirstLine Then  run display-title in this-procedure .
     1491       FirstLine = TRUE .
     1492       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1493          l-name =  "ПО ОБЪЕКТУ : " + CAPS (ObjName).
     1494   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1495   Num#str# = Num#str# + 1.
     1496   run macr_excel_char ( string(l-name)  , num#str# , 1 ) .
     1497    .
     1498             End.
     1499     if showOrders then do :
     1500         Number-Orders = "" .
     1501           run macr_excel_char_with_format ( string ("№/№"                    )  , num#str# , 1) .
     1502           run macr_excel_char_with_format ( string ("Артикул"                )  , num#str# , 2) .
     1503           run macr_excel_char_with_format ( string ("Суммарный Заказ"        )  , num#str# , 3) .
     1504           run macr_excel_char_with_format ( string ("Центр. склад"           )  , num#str# , 4) .
     1505           run macr_excel_char_with_format ( string ("Приход"                 )  , num#str# , 5) .
     1506           run macr_excel_char_with_format ( string ("Остаток"                )  , num#str# , 6) .
     1507           run macr_excel_char_with_format ( string ("Реализ. Среднесуточная" )  , num#str# , 7) .
     1508           run macr_excel_char_with_format ( string ("Касса за месяц"         )  , num#str# , 8) .
     1509           run macr_cell_format  (
     1510                           10       ,
     1511                           true     ,
     1512                           false    ,
     1513                           35       ,
     1514                           num#str#,
     1515                           1        ,
     1516                           num#str# ,
     1517                           8 )
     1518                           .
     1519             mm = 8  .
     1520             For each ub.trn-doc where
     1521                     ub.trn-doc.doc-date <= x-date-end
     1522               AND   ub.trn-doc.doc-date >= x-date-start
     1523               AND   ub.trn-doc.status_   = 'запрос':U
     1524               AND   ub.trn-doc.internal  = false
     1525               AND   ub.trn-doc.obj-code   = x-store-code
     1526               AND   ub.trn-doc.obj-type   = x-store-type
     1527               no-lock :
     1528                     Number-Orders = Number-orders +  ub.trn-doc.doc-code  + CHR(9).
     1529                     sheetf.Sizes = sheetf.sizes + "15," .
     1530                     mm = mm + 1 .
     1531                       run macr_excel_char_with_format in this-procedure  ( ub.trn-doc.doc-code  , num#str# , mm ) .
     1532                       run macr_cell_format in this-procedure   (
     1533                           10       ,
     1534                           true     ,
     1535                           false    ,
     1536                           35       ,
     1537                           num#str#,
     1538                           mm        ,
     1539                           num#str# ,
     1540                           mm )
     1541                           .
     1542             End.
     1543         End.
     1544         run clear-b1 in this-procedure  .
     1545         run clear-b2 in this-procedure .
     1546         run clear-bi in this-procedure  .
     1547         run clear-item in this-procedure .
     1548         break_group = true.
     1549         break_group1 = true.
     1550         num#str#  = num#str#  + 1 .
     1551      END PROCEDURE.
