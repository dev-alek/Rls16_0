     2450   procedure run3 :
     2451     run run3sort2.
     2452   end procedure.
     2453   procedure run3sort2 :
     2454     case select-good :
     2455       when 1  then do:
     2456   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2457   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2458       for each gds-obj  where
     2459             gds-obj.obj-type = x-store-type  and
     2460             gds-obj.obj-code = x-store-code
     2461             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2462         no-lock,
     2463   First clients  where  clients.obj-code = gds-obj.prod-code and
     2464                         clients.obj-type = gds-obj.prod-type
     2465                   no-lock,
     2466             First goods  where  gds-obj.gds-code   = goods.gds-code
     2467   no-lock
     2468   BREAK
     2469         BY ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     2470       BY (goods.artic) :
     2471         run item-goods ( "2" , "goods" ) .
     2472         if return-value <> "" then NEXT.
     2473           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2474           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2475             Then  Assign
     2476                     S-bar-code   = " Итого по "
     2477                     Gds-zap-artic = Substring(
     2478                                         B1-name
     2479                                         ,1,16)
     2480                     Gds-zap-gds-name = Substring(
     2481                                         B1-name
     2482                                         ,17,40)
     2483                                   .
     2484             Else  Assign
     2485                     S-bar-code   = ""
     2486                     Gds-zap-artic = "        Итого по "
     2487                     Gds-zap-gds-name =  B1-name
     2488                                   .
     2489               Run Display-b1 In This-procedure .
     2490               Run Clear-b1 In This-procedure .
     2491               Assign Break_Group = True.
     2492           End.
     2493       End.
     2494     END.
     2495     Else DO:
     2496      For each obj-list no-lock :
     2497                     FOR EACH gds-obj where
     2498                   gds-obj.obj-type = obj-list.obj-type    and
     2499                   gds-obj.obj-code = obj-list.obj-code
     2500                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2501                   no-lock :
     2502                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2503                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2504                       Create temp-gds-list.
     2505                       Assign
     2506                         temp-gds-list.prod-code = gds-obj.prod-code
     2507                         temp-gds-list.grp-name  = gds-obj.grp-name
     2508                         temp-gds-list.gds-name  = goods.gds-name
     2509                         temp-gds-list.gds-code  = gds-obj.gds-code
     2510                         temp-gds-list.artic     = gds-obj.artic
     2511                       .
     2512                   End.
     2513               End.
     2514     End.
     2515     for each temp-gds-list no-lock
     2516       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2517                                        , First clients   where  clients.obj-code = goods.prod-code and
     2518                                                                 clients.obj-type = goods.prod-type
