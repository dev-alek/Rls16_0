     4529       b1-Rash                                            [kk]    = 0
     4530       b1-KAssa                                           [kk]    = 0
     4531       b1-Inv                                             [kk]    = 0
     4532       b1-Overturn                                        [kk]    = 0
     4533       b1-ostatok-end                                     [kk]    = 0
     4534       b1-ostatok-start                                   [kk]    = 0
