      663   define variable v-waitfram-action01         as character   no-undo .
      664   define variable v-waitfram-action02         as character   no-undo .
      665   define variable v-waitfram-action03         as character   no-undo .
      666   define variable mWaitFramTextBeg            as character   no-undo.
      667   define variable mWaitFramTextEnd            as character   no-undo.
      668   define variable mWaitFramView               as logical     no-undo.
      669   define variable mWaitProcEvent              as logical     no-undo init yes.
      670   define variable mWaitFramInterval           as integer     no-undo init 1 .
      671   define variable mWaitFramStop               as logical     no-undo.
      672   define variable mWaitFramStopUser           as logical     no-undo.
      673   define variable mWaitFramStopTimeOut        as logical     no-undo.
      674   define variable mWaitFramStartProc          as datetime-tz no-undo.
      675   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      676   define button B-WaitFramStop auto-end-key
      677        label "Стоп"
      678        size 10 by 1 tooltip "Остоновить процесс".
      679   define button B-viewProcInfo
      680        label "Информация"
      681        size 15 by 1 tooltip "Информация о процесс".
      682   define frame waitfram
      683     v-waitfram-action01 format "x(72)" no-label skip
      684     v-waitfram-action02 format "x(72)" no-label skip
      685     v-waitfram-action03 format "x(72)" no-label skip
      686     B-viewProcInfo
      687     B-WaitFramStop at row 4 col 30
      688     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      689     .
      690   define new global shared variable mBatchMode as logical no-undo init ?.
      691   define variable mFramBachModHandle as handle no-undo.
      692   mFramBachModHandle = frame waitfram:handle.
      693   define variable mFameOldVis as logical no-undo.
      694   define variable mVisCUrentVin as logical no-undo.
      695   if session:batch-mode
      696   then
      697      mBatchMode = yes.
      698   if mBatchMode = ? then do:
      699     mVisCUrentVin = current-window:visible.
      700     mFameOldVis = mFramBachModHandle:visible.
      701     mFramBachModHandle:visible  = yes.
      702     mBatchMode = mFramBachModHandle:visible ne yes.
      703     mFramBachModHandle:visible = mFameOldVis.
      704     current-window:visible = mVisCUrentVin.
      705   end.
      706    if  log-manager:logfile-name ne ?
      707     then DO:
      708         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      709         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      710         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      711     end.
      712   on choose of B-WaitFramStop in frame waitfram
      713   do:
      714     mWaitFramStop = yes.
      715     mWaitFramStopUser = yes.
      716   end.
      717   function waitfram-check-timeout returns logical():
      718      define variable vtime as int64 no-undo.
      719      if mWaitFramStopTimeOut
      720      then
      721         return yes.
      722      vtime = ( now - mWaitFramStartProc ) / 1000 .
      723      if     mWaitFramTimeOut ne ?
      724         and mWaitFramTimeOut ne 0
      725         and mWaitFramTimeOut lt vtime
      726      then do:
      727         mWaitFramStopTimeOut = yes.
      728      end.
      729      return mWaitFramStopTimeOut.
      730   end.
      731   procedure waitfram-hide :
      732     if not session:batch-mode
      733     then do
      734     on error undo, return error return-value
      735     :
      736       pause 0 before-hide .
      737       if not mBatchMode then
      738         hide frame waitfram .
      739     if     not mWaitFramView
      740        and mWaitProcEvent
      741     then
      742       process events .
      743     end.
      744   end procedure.
      745   procedure waitfram-show :
      746     define input  parameter p-message as character no-undo .
      747     define variable v-left-margin as integer   no-undo .
      748     if not session:batch-mode
      749     then do
      750     on error undo, return error return-value
      751     :
      752       if length(p-message) <= 70 then do:
      753         assign
      754           v-left-margin = integer((70 - length(p-message)) / 2)
      755         .
      756         assign
      757           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      758         .
      759         assign
      760           v-waitfram-action01 = " "
      761           v-waitfram-action02 = " "
      762                                    + fill(" ", v-left-margin)
      763                                    + p-message
      764           v-waitfram-action03 = " "
      765         .
      766       end.
      767       else do:
      768         define variable vRindex1 as integer no-undo.
      769         define variable vRindex2 as integer no-undo.
      770         vRindex1 = r-index(p-message," ",70).
      771         if vRindex1 = 0
      772         then
      773            vRindex1 = 70.
      774         if length(p-message)  <= vRindex1 + 70 then do:
      775           assign
      776             v-waitfram-action01 = " "
      777             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      778             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      779           .
      780         end.
      781         else do:
      782           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      783           if vRindex2 <= vRindex1
      784           then
      785              vRindex2 = vRindex1 + 70.
      786           assign
      787             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      788             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      789             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      790           .
      791         end.
      792       end.
      793       B-viewProcInfo:visible   in frame waitfram = no.
      794       B-viewProcInfo:sensitive in frame waitfram = no.
      795       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      796       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      797       if  (   mWaitFramView
      798          or  mWaitProcEvent)
      799          and not mBatchMode
      800       then
      801          display
      802             v-waitfram-action01 skip
      803             v-waitfram-action02 skip
      804             v-waitfram-action03 skip
      805          with frame waitfram .
      806       if     mWaitFramView
      807          then do:
      808             if     mWaitFramInterval ne ?
      809                and not mBatchMode
      810             then
      811                wait-for go of frame waitfram pause mWaitFramInterval.
      812          end.
      813          else
      814             if     mWaitProcEvent
      815                and not mBatchMode
      816             then
      817                process events .
      818     end.
      819   end procedure.
      820      procedure waitfram-show-this:
      821         define input  parameter iInterval as int64 no-undo.
      822         define variable vtime as int64 no-undo.
      823         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      824         mWaitFramInterval = iInterval.
      825         run waitfram-show (substitute("&1&2 &3&4" ,
      826                                       mWaitFramTextBeg ,
      827                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      828                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      829                                       mWaitFramTextEnd
      830                                      )
      831                           ).
      832      end.
      833      procedure WaitFramRunPause:
      834         define input  parameter iInterval as dec no-undo.
      835         define variable vStart  as datetime-tz no-undo.
      836         define variable vend    as datetime-tz no-undo.
      837         define variable vint as int64 no-undo.
      838         define variable vOk as logical no-undo.
      839         vStart = now.
      840         vend   = vStart.
      841         publish "WaitFramPause" (iInterval,output vOk).
      842         vend   =  now.
      843         vint = vend - vStart.
      844         vint = iInterval - vint / 1000.
      845         if     not mWaitFramStop
      846            and (   vint > 0
      847                 or (    not vOk
      848                     and iInterval eq ?
      849                     )
      850                 )
      851         then
      852            run waitfram-show-this (iInterval).
      853         vend   =  now.
      854         vint = vend - vStart.
      855         vint = iInterval - vint / 1000.
      856         if     not mWaitFramStop
      857            and vint > 0
      858         then do:
      859            run gbl/pause.p (vint * 1000).
      860         end.
      861         if iInterval ne ?
      862         then
      863            publish "WaitFramStop".
      864         waitfram-check-timeout().
      865      end.
      866      procedure WaitFramWaitFor:
      867         define input  parameter iInterval as dec no-undo.
      868         assign
      869            mWaitFramStartProc   = now
      870            mWaitFramStopUser    = no
      871            mWaitFramStopTimeOut = no
      872         .
      873         block-wait:
      874         do while not mWaitFramStop:
      875            run WaitFramRunPause (iInterval).
      876            if  waitfram-check-timeout()
      877            then do:
      878               leave block-wait.
      879            end.
      880         end.
      881         run waitfram-hide.
      882      end.
      883   procedure waitfram-join :
      884     define input  parameter p-line-1  as character no-undo .
      885     define input  parameter p-line-2  as character no-undo .
      886     define input  parameter p-line-3  as character no-undo .
      887     define output parameter p-message as character no-undo .
      888     do
      889     on error undo, return error return-value
      890     :
      891       assign
      892         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      893                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      894                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      895       .
      896     end.
      897   end procedure.
      898   function waitfram-join-function returns character
      899     (input p-line-1 as character
      900     ,input p-line-2 as character
      901     ,input p-line-3 as character
      902     ).
      903     define variable v-message as character no-undo .
      904     run waitfram-join in this-procedure
      905       (input  p-line-1
      906       ,input  p-line-2
      907       ,input  p-line-3
      908       ,output v-message
      909       ) .
      910     return v-message .
      911   end function .
