     1659   procedure ost-line :
     1660     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1661     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1662     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1663     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1664     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1665     define input  parameter x-tog-shift  as logical no-undo .
     1666     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1667     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1668     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1669     define input  parameter xtog-obj     as logical no-undo .
     1670     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1671     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1672     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1673     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1674     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1675     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1676     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1677     define buffer buff-obj-list  for obj-list .
     1678     define buffer buff-stk-line  for ub.stk-line .
     1679     assign
     1680       Quantity = 0
     1681       Coast_R  = 0
     1682       Coast_V  = 0
     1683       VAT_R    = 0
     1684       VAT_V    = 0
     1685       SLT_R    = 0
     1686       SLT_V    = 0
     1687     .
     1688     if  x-tog-shift = false then do:
     1689       for each buff-obj-list no-lock
     1690         where xtog-obj = false
     1691            or (buff-obj-list.obj-type = x-store-type
     1692               and buff-obj-list.obj-code = x-store-code
     1693               )
     1694       on error undo, return error
     1695       :
     1696       find last buff-stk-line no-lock
     1697         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1698           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1699           and buff-stk-line.artic      = x-artic
     1700           and buff-stk-line.prod-type  = x-prod-type
     1701           and buff-stk-line.prod-code  = x-prod-code
     1702           and buff-stk-line.sum-type   = x-sum-type
     1703           and buff-stk-line.cat-id     = '##,##':U
     1704           and buff-stk-line.fact-order <= x-fact-order
     1705           and buff-stk-line.shift-num  = 0
     1706         use-index category
     1707         no-error .
     1708       if available buff-stk-line then do:
     1709         assign
     1710           Quantity = Quantity + buff-stk-line.fact-qnty
     1711           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1712           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1713           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1714           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1715           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1716           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1717         .
     1718       end.
     1719      end.
     1720     end.
     1721     else do:
     1722       for each buff-obj-list no-lock
     1723         where xtog-obj = false
     1724            or (buff-obj-list.obj-type = x-store-type
     1725               and buff-obj-list.obj-code = x-store-code
     1726               )
     1727       on error undo, return error
     1728       :
     1729         find last buff-stk-line no-lock
     1730           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1731             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1732             and buff-stk-line.artic      = x-artic
     1733             and buff-stk-line.prod-type  = x-prod-type
     1734             and buff-stk-line.prod-code  = x-prod-code
     1735             and buff-stk-line.sum-type   = x-sum-type
     1736             and buff-stk-line.cat-id     = '##,##':U
     1737             and buff-stk-line.fact-order <= x-fact-order
     1738             and buff-stk-line.shift-num  > 0
     1739           use-index category
     1740           no-error .
     1741         if available buff-stk-line then do:
     1742           assign
     1743             Quantity = Quantity +  buff-stk-line.fact-qnty
     1744             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1745             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1746             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1747             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1748             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1749             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1750           .
     1751         end.
     1752       end.
     1753     end.
     1754   end procedure.
     1755   procedure ost-lineother-tax :
     1756     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1757     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1758     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1759     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1760     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1761     define input  parameter x-tog-shift  as logical no-undo .
     1762     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1763     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1764     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1765     define input  parameter xTog-obj     as logical no-undo .
     1766     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1767     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1768     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1769     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1770     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1771     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1772     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1773     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1774     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1775     define buffer buff-obj-list  for obj-list .
     1776     define buffer buff-stk-line  for ub.stk-line .
     1777     assign
     1778       Quantity = 0
     1779       Coast_R  = 0
     1780       Coast_V  = 0
     1781       VAT_R    = 0
     1782       VAT_V    = 0
     1783       SLT_R    = 0
     1784       SLT_V    = 0
     1785       other_R  = 0
     1786       other_V  = 0
     1787     .
     1788     if  x-tog-shift = false then do:
     1789       for each buff-obj-list no-lock
     1790         where xtog-obj = false
     1791            or (buff-obj-list.obj-type = x-store-type
     1792               and buff-obj-list.obj-code = x-store-code
     1793               )
     1794       on error undo, return error
     1795       :
     1796       find last buff-stk-line no-lock
     1797         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1798           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1799           and buff-stk-line.artic      = x-artic
     1800           and buff-stk-line.prod-type  = x-prod-type
     1801           and buff-stk-line.prod-code  = x-prod-code
     1802           and buff-stk-line.sum-type   = x-sum-type
     1803           and buff-stk-line.cat-id     = '##,##':U
     1804           and buff-stk-line.fact-order <= x-fact-order
     1805           and buff-stk-line.shift-num  = 0
     1806         use-index category
     1807         no-error .
     1808       if available buff-stk-line then do:
     1809         assign
     1810           Quantity = Quantity + buff-stk-line.fact-qnty
     1811           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1812           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1813           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1814           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1815           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1816           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1817           other_R  = other_R  + buff-stk-line.other-rubl
     1818           other_V  = other_V  + buff-stk-line.other-base
     1819         .
     1820       end.
     1821    end.
     1822     end.
     1823     else do:
     1824       for each buff-obj-list no-lock
     1825         where xtog-obj = false
     1826            or (buff-obj-list.obj-type = x-store-type
     1827               and buff-obj-list.obj-code = x-store-code
     1828               )
     1829       on error undo, return error
     1830       :
     1831         find last buff-stk-line no-lock
     1832           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1833             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1834             and buff-stk-line.artic      = x-artic
     1835             and buff-stk-line.prod-type  = x-prod-type
     1836             and buff-stk-line.prod-code  = x-prod-code
     1837             and buff-stk-line.sum-type   = x-sum-type
     1838             and buff-stk-line.cat-id     = '##,##':U
     1839             and buff-stk-line.fact-order <= x-fact-order
     1840             and buff-stk-line.shift-num  > 0
     1841           use-index category
     1842           no-error .
     1843         if available buff-stk-line then do:
     1844           assign
     1845             Quantity = Quantity +  buff-stk-line.fact-qnty
     1846             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1847             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1848             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1849             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1850             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1851             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1852             other_R = other_R   +  buff-stk-line.other-rubl
     1853             other_V = other_V   +  buff-stk-line.other-base
     1854           .
     1855         end.
     1856       end.
     1857     end.
     1858   end procedure.
     1859   procedure ost-line-kg :
     1860     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1861     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1862     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1863     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1864     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1865     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1866     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1867     define buffer buff-obj-list  for obj-list .
     1868     define buffer buf_doc-line for ub.doc-line .
     1869     define buffer buf_inv-line for ub.inv-line .
     1870     do
     1871     on error undo, return error
     1872     :
     1873       for each buf_doc-line no-lock where
     1874                buf_doc-line.obj-type    = p-obj-type   and
     1875                buf_doc-line.obj-code    = p-obj-code   and
     1876                buf_doc-line.prod-type   = p-prod-type  and
     1877                buf_doc-line.prod-code   = p-prod-code  and
     1878                buf_doc-line.artic       = p-artic      and
     1879                buf_doc-line.status_     = 'факт':U      and
     1880                buf_doc-line.fact-order <= p-fact-order
     1881             by buf_doc-line.fact-order    descending
     1882       :
     1883         find first buf_inv-line no-lock where
     1884                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1885                    buf_inv-line.artic     = buf_doc-line.artic     and
     1886                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1887                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1888         if available buf_inv-line
     1889         then do:
     1890           if buf_inv-line.after-cli-qnty <> ?
     1891           then do:
     1892             assign
     1893               p-quantity-kg = buf_inv-line.after-cli-qnty
     1894             .
     1895             leave .
     1896           end.
     1897         end.
     1898       end.
     1899       if p-quantity-kg = ?
     1900       then do:
     1901         assign
     1902           p-quantity-kg = 0
     1903         .
     1904       end.
     1905     end.
     1906   end procedure.
     1907   PROCEDURE ostatok :
     1908   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1909   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1910   def input parameter x-tog-shift   as   logical             no-undo.
     1911   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1912   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1913   def input parameter x-shift-start as integer               no-undo.
     1914   def input parameter x-shift-end   as integer               no-undo.
     1915   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1916   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1917   def input parameter xTog-obj   as log no-undo.
     1918   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1919   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1920   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1921   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1922   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1923   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1924   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1925   def var              Fact-orderS   as char  no-undo.
     1926   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1927      Assign
     1928         Fact-order   = 0
     1929         Quantity     = 0
     1930         Coast_R      = 0
     1931         Coast_V      = 0
     1932         VAT_R        = 0
     1933         VAT_V        = 0 .
     1934    x-date-start-t  = x-date-start + 1 .
     1935   IF x-date-end = date('') then DO:
     1936      Fact-order = 0 .
     1937      for each obj-list
     1938          where  ( not xtog-obj or
     1939                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1940                 no-lock :
     1941         if  x-tog-shift = false then do:
     1942                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1943                               ub.stk-tot.Fact-date <=  x-date-start
     1944                               and ub.stk-tot.shift-num = 0
     1945                               USE-INDEX fact-date no-lock no-error .
     1946              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1947         End.
     1948         Else  DO :
     1949             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1950              (ub.stk-tot.shift-date  = x-date-start-t and
     1951               ub.stk-tot.shift-num  < x-shift-start or
     1952               ub.stk-tot.shift-date  < x-date-start-t  )
     1953               and ub.stk-tot.shift-num  > 0
     1954               USE-INDEX Shift-num no-lock no-error .
     1955            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1956           END.
     1957       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1958     End.
     1959   End.
     1960   Else DO:
     1961     For each obj-list  WHERE
     1962        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1963         no-lock :
     1964      IF  x-TOG-Shift = False Then DO:
     1965          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1966               ub.stk-tot.Fact-date <= x-date-end
     1967               and ub.stk-tot.shift-num = 0
     1968               USE-INDEX fact-date no-lock no-error.
     1969          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1970      END.
     1971      Else DO:
     1972           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1973               (ub.stk-tot.shift-date  = x-date-end and
     1974               ub.stk-tot.shift-num  <= x-shift-end or
     1975               ub.stk-tot.shift-date  < x-date-end       ) and
     1976               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1977               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1978       End.
     1979       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1980     End.
     1981   End.
     1982   END PROCEDURE.
     1983   PROCEDURE report-execute :
     1984     If (ValType = 0 and var-report-r-b = 'rubl' )  Or ValType = 1
     1985                                   then   assign tPrintRubl = yes .
     1986                                   else   assign tPrintRubl = no .
     1987     run waitfram-show ( 'Подождите ...' ) .
     1988     output stream OutStream to value( string( session:temp-directory +
     1989                               "rpt" + string( g#report-num ) ) )      .
     1990      run report-exec1.
     1991      Output stream OutStream close.
     1992      run waitfram-hide.
     1993     if Make-Excel then output stream ForExcel close.
     1994     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1995   END PROCEDURE.
     1996   PROCEDURE foreach :
     1997   define variable tt# as integer no-undo .
     1998   define buffer buf-obj-list  for obj-list .
     1999    R = R + 1.
     2000   If Integer(25) = 0 Then Temp1  = 100  .
     2001                         Else Temp1 = Integer(25) .
     2002        IF ( R modulo Temp1 = 0 ) AND ( R >= Temp1 ) then
     2003            RUN waitfram-show( "Обработано строк : " + string( R )) .
     2004     run clear-item.
     2005    tt# = 0 .
     2006   define variable gds-zap-b-code-ed as integer no-undo .
     2007      if flag-dop-bc = true then do:
     2008   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2009     (input  gds-zap-b-code
     2010     ,input  ?
     2011     ,output gds-zap-b-code-ed
     2012     )  .
     2013         v-dop-bc = ""   .
     2014           for each ub.prod-bc no-lock where
     2015               ub.prod-bc.b-code = gds-zap-b-code-ed
     2016               on error undo, return error :
     2017               v-dop-bc = v-dop-bc + ub.prod-bc.b-str + chr(44) .
     2018           end.
     2019           v-dop-bc = substring(v-dop-bc, 1 , length(v-dop-bc) - 1 ) .
     2020      end.
     2021   For each  buf-obj-list no-lock :
     2022     run ost-line (  input   buf-obj-list.obj-code ,
     2023                     input   buf-obj-list.obj-type ,
     2024                     INPUT   gds-zap-artic     ,
     2025                     INPUT   gds-zap-prod-code ,
     2026                     INPUT   gds-zap-prod-type ,
     2027                     input   x-tog-shift       ,
     2028                     INPUT   fact-order-2      ,
     2029                     input   type-a       ,
     2030                     input   '##,##':U    ,
     2031                     input   true        ,
     2032                     output  Quantity    ,
     2033                     output  Coast_R     ,
     2034                     output  Coast_V     ,
     2035                     output  VAT_R       ,
     2036                     output  VAT_V       ,
     2037                     output  SLT_R       ,
     2038                     output  SLT_V       ) .
     2039      If not can-find  (tmp#obj-list where
     2040         buf-obj-list.obj-code = tmp#obj-list.obj-code and
     2041         buf-obj-list.obj-type = tmp#obj-list.obj-type  ) then do:
     2042               create tmp#obj-list.
     2043               Assign
     2044                 tmp#obj-list.obj-code = buf-obj-list.obj-code
     2045                 tmp#obj-list.obj-type = buf-obj-list.obj-type .
     2046           End.
     2047     Find first tmp#obj-list where
     2048         buf-obj-list.obj-code = tmp#obj-list.obj-code and
     2049         buf-obj-list.obj-type = tmp#obj-list.obj-type
     2050     share-lock no-error .
     2051     Assign
     2052     tmp#obj-list.ostatok-end [1 + tt#]  = Quantity
     2053     tmp#obj-list.ostatok-end [2 + tt#]  = if tprintrubl then Coast_R else Coast_V
     2054     tmp#obj-list.b1-ostatok-end [1 + tt# ] =  tmp#obj-list.b1-ostatok-end [1 + tt#] + tmp#obj-list.ostatok-end [1 + tt#]
     2055     tmp#obj-list.b1-ostatok-end [2 + tt# ] =  tmp#obj-list.b1-ostatok-end [2 + tt#] + tmp#obj-list.ostatok-end [2 + tt#]
     2056     tmp#obj-list.bi-ostatok-end [1 + tt# ] =  tmp#obj-list.bi-ostatok-end [1 + tt#] + tmp#obj-list.ostatok-end [1 + tt#]
     2057     tmp#obj-list.bi-ostatok-end [2 + tt# ] =  tmp#obj-list.bi-ostatok-end [2 + tt#] + tmp#obj-list.ostatok-end [2 + tt#]
     2058     .
     2059   End.
     2060   END PROCEDURE.
     2061   PROCEDURE display-line :
     2062           IF NOT Sums-Only then DO:
     2063              ii = ii + 1.
     2064              run display-str1.
     2065             End.
     2066     END PROCEDURE.
     2067   PROCEDURE print-header :
     2068   if NOT FirstLine Then  run display-title.
     2069       FirstLine = TRUE .
     2070         run clear-b1 .
     2071         run clear-bi .
     2072         run clear-item.
     2073         break_group = true.
     2074         break_group1 = true.
     2075      END PROCEDURE.
     2076   PROCEDURE Print-Footer :
     2077          gds-zap-artic = "ИТОГО" .
     2078          run display-bi.
     2079          END PROCEDURE.
     2080   PROCEDURE U-LINE :
     2081           END PROCEDURE.
     2082   PROCEDURE P-LINE :
     2083           END PROCEDURE.
     2084   PROCEDURE CalcItog :
     2085       run ostatok (
     2086           input x-store-code  ,
     2087           input x-store-type  , x-TOG-Shift,
     2088           input x-date-start - 1 ,
     2089           input date('')      , x-Shift-Start,x-Shift-End,
     2090           input type-a   ,
     2091           input '##,##':U,
     2092           input xTog-obj ,
     2093           output  Quantity1  ,
     2094           output  Coast_R1   ,
     2095           output  Coast_V1   ,
     2096           output  VAT_R1     ,
     2097           output  VAT_V1     ,
     2098           output  Fact-order-1 ).
     2099       run ostatok (
     2100           input x-store-code  ,
     2101           input x-store-type  ,x-TOG-Shift,
     2102           input x-date-start  ,
     2103           input x-date-end    , x-Shift-Start,x-Shift-End,
     2104           input type-a   ,
     2105           input '##,##':U,
     2106           input xTog-obj ,
     2107           output  Quantity1  ,
     2108           output  Coast_R1   ,
     2109           output  Coast_V1   ,
     2110           output  VAT_R1     ,
     2111           output  VAT_V1     ,
     2112           output  Fact-order-2 ).
     2113             Quantity1  = 0.
     2114             Coast_R1   = 0.
     2115             Coast_V1   = 0.
     2116             VAT_R1     = 0.
     2117             VAT_V1     = 0.
     2118   END PROCEDURE.
     2119   PROCEDURE display-str1  :
     2120              run di ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2121   END PROCEDURE.
     2122   PROCEDURE display-Bi  :
     2123      v-dop-bc = ""     .
     2124      run di ("кол-во",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     2125   END PROCEDURE.
     2126   PROCEDURE display-B1  :
     2127      v-dop-bc = ""     .
     2128      run di ("кол-во"  ,1, (s-bar-code + " " + caps( gds-zap-artic + gds-zap-gds-name)), "" ,"","","b1":u).
     2129   END PROCEDURE.
     2130   PROCEDURE Clear-B1  :
     2131    For each tmp#obj-list  :
     2132       REPEAT kk = 1 to 6 :
     2133        tmp#obj-list.b1-ostatok-end    [kk]    = 0
     2134        .
     2135       End.
     2136     End.
     2137    END PROCEDURE.
     2138   PROCEDURE Clear-B2  :
     2139    For each tmp#obj-list :
     2140       REPEAT kk = 1 to 6 :
     2141        tmp#obj-list.b1-ostatok-end    [kk]    = 0
     2142        .
     2143       End.
     2144     End.
     2145   END PROCEDURE.
     2146   PROCEDURE Clear-Bi  :
     2147    For each tmp#obj-list :
     2148       REPEAT kk = 1 to 6 :
     2149        tmp#obj-list.bi-ostatok-end    [kk]    = 0
     2150        .
     2151       End.
     2152     End .
     2153   END PROCEDURE.
     2154   PROCEDURE Display-title :
     2155       i = 0.
     2156       run rep/extitle.p (1) .
     2157   END PROCEDURE.
     2158   PROCEDURE report-exec1  :
     2159      FIND FIRST clients where x-store-type = clients.obj-type AND
     2160                               x-store-code = clients.obj-code no-lock no-error.
     2161              If available clients then  ObjName = clients.obj-name.
     2162                                            else  ObjName="объект не определен".
     2163     run calcitog.
     2164     run print-header.
     2165      CASE RetClassify :
     2166       when "prod":u         then            run run3.
     2167       otherwise do:
     2168         message "Ошибка вызова!" view-as alert-box error .
     2169       end.
     2170      end case.
     2171      run print-footer.
     2172     END PROCEDURE.
     2173   PROCEDURE Clear-item :
     2174    For each tmp#obj-list :
     2175       REPEAT kk = 1 to 6 :
     2176        ostatok-end                                     [kk]    = 0
     2177        .
     2178       End.
     2179     End.
     2180    END PROCEDURE.
     2181   PROCEDURE Item-Goods :
     2182    define input parameter  par-3 as character  no-undo.
     2183    define input parameter  par-4 as character  no-undo.
     2184         if par-4 = "goods":U  Then DO:
     2185             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     2186                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     2187                                   assign
     2188                                       gds-zap-unit-base  = Goods.unit-base
     2189                                       gds-zap-prt-root   = Goods.prt-root
     2190                                       gds-zap-prod-type  = Goods.prod-type
     2191                                       gds-zap-prod-code  = Goods.prod-code
     2192                                       gds-zap-artic      = Goods.artic
     2193                                       gds-zap-grp-name   = Goods.grp-name
     2194                                       gds-zap-b-code     = Goods.gds-code
     2195                                       gds-zap-prod-name  = clients.obj-name .
     2196                                   if g#gds-engl then
     2197                                       assign gds-zap-gds-name = Goods.engl-name.
     2198                                   else
     2199                                       assign gds-zap-gds-name = Goods.gds-name.
     2200                               End.
     2201        if par-4 = "gds-list":U  Then DO:
     2202             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     2203                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     2204                                   assign
     2205                                       gds-zap-unit-base  = gds-list.unit-base
     2206                                       gds-zap-prt-root   = gds-list.prt-root
     2207                                       gds-zap-prod-type  = gds-list.prod-type
     2208                                       gds-zap-prod-code  = gds-list.prod-code
     2209                                       gds-zap-artic      = gds-list.artic
     2210                                       gds-zap-grp-name   = gds-list.grp-name
     2211                                       gds-zap-b-code     = gds-list.gds-code
     2212                                       gds-zap-prod-name  = clients.obj-name .
     2213                                   if g#gds-engl then
     2214                                       assign gds-zap-gds-name = gds-list.engl-name.
     2215                                   else
     2216                                       assign gds-zap-gds-name = gds-list.gds-name.
     2217                               End.
     2218      run foreach.
     2219       If  break_group = true  and par-3 <> "1"  then DO :
     2220            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2221            gds-zap-prod-name  = clients.obj-name.
     2222             If break_group1 = true  THEN  DO :
     2223               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     2224                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     2225                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     2226               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     2227                           fr0 = true .
     2228                   tmp#stroka0 = temp-str.
     2229                   if Make-Excel then  put   stream ForExcel unformatted tmp#stroka0  skip.
     2230               End.
     2231             End.
     2232             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     2233               if par-3 = "4"
     2234                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     2235                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     2236               if NOT xSumsOnly THEN DO:
     2237                   fr = true .
     2238                   if Make-Excel then  put   stream ForExcel unformatted CHR(9) temp-str  skip.
     2239               End.
     2240               break_group1 = false.
     2241             END.
     2242          break_group = false.
     2243       End.
     2244       run display-line.
     2245    END PROCEDURE.
     2246   PROCEDURE Di :
     2247   define input parameter p1 as character  no-undo.
     2248   define input parameter p2 as integer   no-undo.
     2249   define input parameter p3 as character  no-undo.
     2250   define input parameter p4 as character  no-undo.
     2251   define input parameter p5 as character  no-undo.
     2252   define input parameter p6 as character  no-undo.
     2253   define input parameter p7 as character  no-undo.
     2254   define variable tot-qnty as decimal no-undo .
     2255   define variable tot-sum as decimal no-undo .
     2256   assign
     2257     tot-qnty = 0
     2258     tot-sum  = 0
     2259   .
     2260    CASE CAPS(p7) :
     2261      WHEN "B1":U  Then DO:
     2262         if Make-Excel then  put   stream ForExcel unformatted
     2263             p3   CHR(9)
     2264             ( if flag-dop-bc = true   then  CHR(9) else "" )
     2265             p4   CHR(9)
     2266             p5   CHR(9)
     2267             p6   CHR(9)
     2268             .
     2269             For each tmp#obj-list :
     2270             if Make-Excel then  put   stream ForExcel unformatted
     2271             excel-qnty (tmp#obj-list.b1-ostatok-end[1] ) CHR(9)
     2272             excel-sum  (tmp#obj-list.b1-ostatok-end[2] ) CHR(9).
     2273             assign
     2274               tot-qnty = tot-qnty + decimal(tmp#obj-list.b1-ostatok-end[1])
     2275               tot-sum  = tot-sum  + decimal(tmp#obj-list.b1-ostatok-end[2])
     2276             .
     2277             End.
     2278             if Make-Excel then  put   stream ForExcel unformatted
     2279             excel-qnty (tot-qnty ) CHR(9)
     2280             excel-sum  (tot-sum  ) CHR(9)
     2281             Skip.
     2282             run clear-b1 .
     2283         End.
     2284      WHEN "BI":U Then DO:
     2285         if Make-Excel then  put   stream ForExcel unformatted
     2286             p3   CHR(9)
     2287             ( if flag-dop-bc = true   then  CHR(9) else "" )
     2288             p4   CHR(9)
     2289             p5   CHR(9)
     2290             p6   CHR(9)
     2291             .
     2292             For each tmp#obj-list :
     2293             if Make-Excel then  put   stream ForExcel unformatted
     2294             excel-qnty  (tmp#obj-list.bi-ostatok-end[1] ) CHR(9)
     2295             excel-sum   (tmp#obj-list.bi-ostatok-end[2] ) CHR(9).
     2296             assign
     2297               tot-qnty = tot-qnty + decimal(tmp#obj-list.bi-ostatok-end[1])
     2298               tot-sum  = tot-sum  + decimal(tmp#obj-list.bi-ostatok-end[2])
     2299             .
     2300             End.
     2301             if Make-Excel then  put   stream ForExcel unformatted
     2302             excel-qnty (tot-qnty ) CHR(9)
     2303             excel-sum  (tot-sum  ) CHR(9)
     2304             Skip.
     2305         End.
     2306      WHEN ""  Then DO:
     2307        if Show-Negativ = true OR  (Show-Negativ = false and NOT can-find ( first tmp#obj-list where tmp#obj-list.ostatok-end[1] = 0 and
     2308                                                          tmp#obj-list.ostatok-end[2] = 0 ))
     2309                THEN  DO:
     2310                  if Make-Excel then  put   stream ForExcel unformatted
     2311                  ( p3)   CHR(9)
     2312                  ( if flag-dop-bc = true   then ( v-dop-bc + CHR(9)) else "" )
     2313                  ( p4)   CHR(9)
     2314                  ( p5)   CHR(9)
     2315                  ( p6)   CHR(9)
     2316                   .
     2317                   assign
     2318                     tot-qnty = 0
     2319                     tot-sum  = 0
     2320                   .
     2321                  For each tmp#obj-list :
     2322                  if Make-Excel then  put   stream ForExcel unformatted
     2323                   excel-qnty ( tmp#obj-list.ostatok-end[1] ) CHR(9)
     2324                   excel-sum  ( tmp#obj-list.ostatok-end[2] ) CHR(9).
     2325                   assign
     2326                     tot-qnty = tot-qnty + decimal(tmp#obj-list.ostatok-end[1])
     2327                     tot-sum  = tot-sum  + decimal(tmp#obj-list.ostatok-end[2])
     2328                   .
     2329                  End.
     2330                  if Make-Excel then  put   stream ForExcel unformatted
     2331                   excel-qnty (tot-qnty ) CHR(9)
     2332                   excel-sum  (tot-sum  ) CHR(9)
     2333                  Skip.
     2334               End.
     2335      End.
     2336     End case.
     2337    END PROCEDURE.
