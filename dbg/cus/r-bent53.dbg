     1283   procedure run3 :
     1284         case select-good :
     1285           when 1  then do:
     1286   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1288       for each gds-obj  where
     1289             gds-obj.obj-type = x-store-type  and
     1290             gds-obj.obj-code = x-store-code
     1291             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1292         no-lock,
     1293   First clients  where  clients.obj-code = gds-obj.prod-code and
     1294                         clients.obj-type = gds-obj.prod-type
     1295                   no-lock,
     1296             First goods  where  gds-obj.gds-code   = goods.gds-code
     1297   no-lock
     1298   BREAK
     1299         BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     1300       BY (temp-gds-list.artic) :
     1301         run item-goods ( "2" , "goods" ) .
     1302         if return-value <> "" then NEXT.
     1303           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     1304           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     1305             Then  Assign
     1306                     S-bar-code   = " Итого по "
     1307                     Gds-zap-artic = Substring(
     1308                                         B1-name
     1309                                         ,1,16)
     1310                     Gds-zap-gds-name = Substring(
     1311                                         B1-name
     1312                                         ,17,40)
     1313                                   .
     1314             Else  Assign
     1315                     S-bar-code   = ""
     1316                     Gds-zap-artic = "        Итого по "
     1317                     Gds-zap-gds-name =  B1-name
     1318                                   .
     1319               Run Display-b1 In This-procedure .
     1320               Run Clear-b1 In This-procedure .
     1321               Assign Break_Group = True.
     1322           End.
     1323       End.
     1324     END.
     1325     Else DO:
     1326      For each obj-list no-lock :
     1327                     FOR EACH gds-obj where
     1328                   gds-obj.obj-type = obj-list.obj-type    and
     1329                   gds-obj.obj-code = obj-list.obj-code
     1330                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1331                   no-lock :
     1332                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1333                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1334                       Create temp-gds-list.
     1335                       Assign
     1336                         temp-gds-list.prod-code = gds-obj.prod-code
     1337                         temp-gds-list.grp-name  = gds-obj.grp-name
     1338                         temp-gds-list.gds-name  = goods.gds-name
     1339                         temp-gds-list.gds-code  = gds-obj.gds-code
     1340                         temp-gds-list.artic     = gds-obj.artic
     1341                       .
     1342                   End.
     1343               End.
     1344     End.
     1345     for each temp-gds-list no-lock
     1346       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1347                                        , First clients   where  clients.obj-code = goods.prod-code and
     1348                                                                 clients.obj-type = goods.prod-type
     1349         BREAK
     1350   BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     1351       BY temp-gds-list.artic :
     1352       run item-goods ( "2" , "goods" ) .
     1353         if return-value <> "" then NEXT.
     1354           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     1355           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     1356             Then  Assign
