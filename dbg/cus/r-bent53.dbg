     1157   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1158   define variable  str  as char format "X(60)"  no-undo.
     1159   define variable  str2 as char no-undo.
     1160   define variable v-r as character no-undo init "" .
     1161   define variable  i#i as int no-undo.
     1162   STR = "".
     1163   repeat i#i =1 to lavel#:
     1164       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1165       else do:
     1166           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1167           if not error-status:error  and str2 <> "":u then
     1168                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1169           end.
     1170   end.
     1171   if str <> ? then do:
     1172   v-r = str + chr(47) .
     1173   end.
     1174   RETURN v-r .
     1175   END FUNCTION.
     1176   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1177     if num-entries(string(p-dec), '.') = 2
     1178       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1179       else return( string(p-dec)) .
     1180   end function.
     1181   function format-point-to-comma returns char (input orig as char ) .
     1182   define variable rtext as character no-undo .
     1183   define variable strt as integer no-undo .
     1184   define variable leng as integer no-undo .
     1185   assign rtext = orig .
     1186   repeat:
     1187     strt =  index(rtext,'.').
     1188     if strt = 0 then leave.
     1189     leng = 1.
     1190     substring(rtext,strt,leng,"character") = v-delim .
     1191   end.
     1192   return rtext.
     1193   end function.
     1194   function format-excel-text returns char ( input start-text as char ) :
     1195   def var  i    as int no-undo.
     1196   def var  ch   as char no-undo.
     1197   def var  n    as int no-undo.
     1198   def var  ipos as int no-undo.
     1199     n = num-entries(trim(start-text), chr(10)) - 1 .
     1200     do i = 1 to n :
     1201       ipos = index( start-text, chr(10)).
     1202       if ipos > 0 then
     1203         substr( start-text, ipos, 1 ) = ' '.
     1204     end.
     1205     n = num-entries(trim(start-text), chr(13)) - 1 .
     1206     do i = 1 to n :
     1207       ipos = index( start-text, chr(13)).
     1208       if ipos > 0 then
     1209         substr( start-text, ipos, 1 ) = ' '.
     1210     end.
     1211     if index( start-text, '"' ) = 0 then
     1212       start-text =  '="'   + trim( start-text) + '"'   .
     1213       else do:
     1214         n = num-entries(trim(start-text), '"') - 1.
     1215         do i = 1 to n :
     1216           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1217         end.
     1218         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1219         start-text = '="'  + ch  + '"' .
     1220       end.
     1221     return start-text.
     1222   end.
     1223   function excel-sum returns char (input p-dec as decimal ).
     1224     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1225   end function.
     1226   function excel-qnty returns char (input p-dec as decimal ).
     1227     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1228   end function.
     1229   function format-excel-text-macr returns char ( input start-text as char ) :
     1230   def var  i    as int no-undo.
     1231   def var  ch   as char no-undo.
     1232   def var  n    as int no-undo.
     1233   def var  ipos as int no-undo.
     1234     n = num-entries(trim(start-text), chr(10)) - 1 .
     1235     do i = 1 to n :
     1236       ipos = index( start-text, chr(10)).
     1237       if ipos > 0 then
     1238         substring( start-text, ipos , 1 ) = ' '.
     1239     end.
     1240     n = num-entries(trim(start-text), chr(13)) - 1 .
     1241     do i = 1 to n :
     1242       ipos = index( start-text, chr(13)).
     1243       if ipos > 0 then
     1244         substring( start-text, ipos, 1 ) = ' '.
     1245     end.
     1246     if index( start-text, '"' ) = 0 then
     1247       start-text =  '"'   + trim( start-text) + '"'   .
     1248       else do:
     1249         n = num-entries(trim(start-text), '"') - 1.
     1250         do i = 1 to n :
     1251           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1252         end.
     1253         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1254         start-text = '"'  + ch  + '"' .
     1255       end.
     1256     n = num-entries(trim(start-text), chr(10)) - 1 .
     1257     do i = 1 to n :
     1258       ipos = index( start-text, chr(10)).
     1259       if ipos > 0 then
     1260         substring( start-text, ipos , 1 ) = ' '.
     1261     end.
     1262       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1263     return start-text.
     1264   end.
     1265   function func-vat returns decimal (
     1266       input p-gds-code as integer  ,
     1267       input p-obj-type as character ,
     1268       input p-obj-code as integer  ).
     1269   define variable i-vat-pc as decimal no-undo .
     1270   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1272     (input  p-gds-code
     1273     ,input  '1':U
     1274     ,input  x-Date-End
