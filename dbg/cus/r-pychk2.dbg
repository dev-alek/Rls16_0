     1293   index igrp grp-code
     1294   .
     1295   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   DEFINE SHARED VARIABLE cas-shft as logical no-undo init no.
     1297   DEFINE VARIABLE cas-num as integer no-undo.
     1298   DEFINE VARIABLE found as logical init yes no-undo.
     1299   define variable ii-excel as integer no-undo .
     1300   define variable ii-page as integer no-undo init 1.
     1301   define variable v-curr-code like ub.currency.curr-code no-undo init ?.
     1302   define variable v-one-curr-code as logical no-undo .
     1303   define variable inkas-uslugi1 as character no-undo .
     1304   define variable inkas-uslugi2 as character no-undo .
     1305   define buffer buf_inkas for ub.inkas.
     1306   define buffer buf_cash-pay for ub.cash-pay.
     1307   define buffer buf1_sheetf for sheetf.
     1308   define buffer buf_sheetf for sheetf.
     1309   define buffer buf_goods for ub.goods.
     1310   define buffer buf_clients for ub.clients.
     1311   define buffer buf_doc-line for ub.doc-line.
     1312   run waitfram-show in this-procedure ("Ждите...").
     1313   for each treal-3:
     1314     delete treal-3.
     1315   end.
     1316   for each treal-vat:
     1317     delete treal-vat.
     1318   end.
     1319   _realize-filter--Date-and-Shift:
     1320   FOR EACH obj-list No-LOCK:
     1321       if x-tog-shift = no then do:
     1322      for each  buf_Inkas no-lock where
     1323               buf_inkas.fact-date     >= x-date-start
     1324           AND buf_inkas.fact-date     <= x-date-end
     1325           AND buf_inkas.obj-type   = obj-list.obj-type
     1326           AND buf_inkas.obj-code   = obj-list.obj-code
     1327           AND buf_inkas.status_     = 'факт':U:
     1328               run process-inkas in this-procedure (buffer buf_inkas).
     1329           end.
     1330       end.
     1331       else do:
     1332           for each buf_Inkas no-lock where
     1333                   buf_inkas.shift-date   >= x-date-start
     1334               AND buf_inkas.shift-date   <= x-date-end
     1335               AND buf_inkas.obj-type      = obj-list.obj-type
     1336               AND buf_inkas.obj-code      = obj-list.obj-code
     1337               AND buf_inkas.status_       = 'факт':U:
     1338                   if buf_inkas.shift-date = x-date-start and buf_inkas.shift-num < x-shift-start then next.
     1339                   if buf_inkas.shift-date = x-date-end and buf_inkas.shift-num > x-shift-end then next.
     1340                   run process-inkas in this-procedure (buffer buf_inkas).
     1341           end.
     1342       end.
     1343   END.
     1344   run waitfram-hide in this-procedure .
     1345   run printproc in this-procedure.
     1346   procedure process-inkas :
     1347   define parameter buffer buf_inkas for ub.inkas.
     1348   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1349   define variable pychk_rv as integer no-undo .
     1350   DEFINE BUFFER b-treal-3 for treal-3.
     1351   DEFINE VARIABLE v-line-num as integer no-undo .
     1352   define variable v-curr-r-b as character no-undo .
     1353   define variable v-base-code like ub.sysconf.base-code no-undo .
     1354   define variable p-by-pay-desk as logical no-undo .
     1355   define buffer buf_bar-code for ub.bar-code.
     1356   define buffer buf_cash-pay for ub.cash-pay.
     1357   define buffer buf_trn-doc for ub.trn-doc.
     1358   define buffer buf_ret-doc for ub.trn-doc.
     1359   define buffer buf_goods   for ub.goods.
     1360   define buffer pay_treal-vat for treal-vat.
     1361   define buffer pay0_treal-vat for treal-vat.
     1362   define buffer gen_treal-vat for treal-vat.
     1363   define buffer gen0_treal-vat for treal-vat.
     1364   define buffer buf_doc-line for ub.doc-line.
     1365   define variable v-ret-doc-code like ub.trn-doc.doc-code no-undo .
     1366   define variable v-grp-code as character no-undo .
     1367   define buffer buf_tt-cash-pay  for tt-cash-pay.
     1368   define buffer buf_tt-cash-group for tt-cash-group.
     1369   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     1370   do
     1371   on error undo, return error
     1372   :
     1373   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1375     (output v-curr-r-b
     1376     )  .
     1377   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1379     (input  buf_inkas.host-code
     1380     ,output v-base-code
     1381     )  .
     1382     assign
     1383     v-curr-code = (if v-curr-code = ? then v-base-code else v-curr-code)
     1384     v-one-curr-code = (if v-base-code = v-curr-code then yes else no)
     1385     .
     1386     find first buf_trn-doc no-lock where
     1387               buf_trn-doc.doc-code = buf_inkas.inkas-code no-error.
     1388     find first buf_ret-doc no-lock where
     1389               buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
     1390     if available buf_ret-doc then
     1391     assign
     1392     v-ret-doc-code = buf_ret-doc.doc-code
     1393     .
     1394     run rep/rpychk0.p ( input "r-pychk2"
     1395                         ,input buf_inkas.obj-type
     1396                         ,input buf_inkas.obj-code
     1397                         ,input ?
     1398                         ,input ?
     1399                         ,input ?
     1400                         ,input ?
     1401                         ,input ?
     1402                         ,input ?
     1403                         ,input buf_inkas.inkas-code
     1404                         ).
     1405     _chk-doc:
     1406     FOR EACH ub.chk-doc No-LOCK WHERE
     1407             ub.chk-doc.obj-type = buf_inkas.obj-type AND
     1408             ub.chk-doc.obj-code = buf_inkas.obj-code AND
     1409             ub.chk-doc.out-code = buf_inkas.inkas-code:
     1410       if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1411       pychk_rv = (if p-rv
     1412               then (if ub.chk-doc.netto >= 0 then 1 else - 1)
     1413               else 0).
     1414       for each buf_chk-gds-pay no-lock where
     1415               buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     1416           and buf_chk-gds-pay.algo-num = "1.8",
     1417           first buf_bar-code no-lock where
     1418               buf_bar-code.b-code = buf_chk-gds-pay.b-code,
     1419           first buf_cash-pay no-lock where
     1420               buf_cash-pay.cdpay-code = buf_chk-gds-pay.pay-code
     1421           and buf_cash-pay.curr-code = buf_chk-gds-pay.curr-code:
     1422   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1423   if x-SelectGood  = 4 then do:
     1424     find first gds-list no-lock where
     1425             gds-list.gds-code = buf_bar-code.gds-code no-error .
     1426   end.
     1427   if x-SelectGood  = 1
     1428   or available gds-list then do:
     1429       FIND FIRST treal-3 No-LOCK WHERE
     1430                 treal-3.gds-code = buf_bar-code.gds-code
     1431             AND treal-3.cpay-code = buf_chk-gds-pay.pay-code
     1432             AND treal-3.curr-code = buf_chk-gds-pay.curr-code
     1433             AND treal-3.rv = pychk_rv  No-ERROR.
     1434       IF NOT AVAIL treal-3 then do:
     1435         FIND last b-treal-3 No-LOCK WHERE
     1436                   b-treal-3.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
     1437         create treal-3.
     1438         assign
     1439         treal-3.gds-code = buf_bar-code.gds-code
     1440         treal-3.rv = pychk_rv
     1441         treal-3.cpay-code = buf_chk-gds-pay.pay-code
     1442         treal-3.curr-code = buf_chk-gds-pay.curr-code
     1443         treal-3.qnty1  =  0
     1444         treal-3.netto = 0
     1445         treal-3.out-name = buf_cash-pay.obj-name
     1446         treal-3.is-pay = yes
     1447         treal-3.ii =  (if avail b-treal-3
     1448                       then b-treal-3.ii + 1
     1449                       else 1)
     1450         .
     1451       END.
     1452       assign
     1453       treal-3.netto = treal-3.netto + (if v-curr-r-b = 'base':U
     1454                                         or v-base-code = 0
     1455                                         then buf_chk-gds-pay.tot-r-b
     1456                                         else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
     1457       treal-3.qnty1 = treal-3.qnty1 + buf_chk-gds-pay.eff-doc-qnty
     1458       treal-3.netto-rubl = treal-3.netto-rubl + (if v-curr-r-b = 'rubl':U
     1459                                                 or v-base-code = 0
     1460                                                 then buf_chk-gds-pay.tot-r-b
     1461                                                 else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
     1462       treal-3.netto-inkas = (if treal-3.inkas-code <> buf_inkas.inkas-code
     1463                             then 0
     1464                             else treal-3.netto-inkas)
     1465       treal-3.netto-rubl-inkas = (if treal-3.inkas-code <> buf_inkas.inkas-code
     1466                                   then 0
     1467                                   else treal-3.netto-rubl-inkas)
     1468       treal-3.vat-pc      = if treal-3.inkas-code <> buf_inkas.inkas-code
     1469                             then -1
     1470                             else treal-3.vat-pc
     1471       treal-3.inkas-code        = if treal-3.inkas-code <> buf_inkas.inkas-code
     1472                                   then buf_inkas.inkas-code
     1473                                   else treal-3.inkas-code
     1474       treal-3.netto-inkas = treal-3.netto-inkas + (if v-curr-r-b = 'base':U
     1475                                                     or v-base-code = 0
     1476                                                     then buf_chk-gds-pay.tot-r-b
     1477                                                     else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
     1478       treal-3.netto-rubl-inkas = treal-3.netto-rubl-inkas + (if v-curr-r-b = 'rubl':U
     1479                                                               or v-base-code = 0
     1480                                                               then buf_chk-gds-pay.tot-r-b
     1481                                                               else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
     1482       .
     1483   end.
     1484       end.
     1485     END.
     1486     inkas-uslugi1 = entry(1,buf_inkas.inkas-code,"-") + "у-" + entry(2,buf_inkas.inkas-code,"-") .
     1487     inkas-uslugi2 = entry(1,buf_inkas.inkas-code,"-") + "у=" + entry(2,buf_inkas.inkas-code,"-") .
     1488     _doc-line:
     1489     FOR EACH treal-3 where
     1490             treal-3.vat-pc = - 1,
     1491         FIRST buf_goods no-lock where
     1492               buf_goods.gds-code = treal-3.gds-code:
     1493       if not p-rv or treal-3.rv = 1 then do:
     1494         FIND FIRST buf_doc-line no-lock WHERE
     1495                   buf_doc-line.doc-code = buf_inkas.inkas-code AND
     1496                   buf_doc-line.artic     = buf_goods.artic AND
     1497                   buf_doc-line.prod-type = buf_goods.prod-type AND
     1498                   buf_doc-line.prod-code = buf_goods.prod-code  no-error .
     1499         if available buf_doc-line then do:
