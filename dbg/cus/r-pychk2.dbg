      581   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   define  stream PrnLibStream.
      583   procedure prn-lib-prn-file :
      584     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      585     define input parameter p-DIsabledoptions as integer no-undo .
      586     define variable v-report-name as character no-undo .
      587     define variable v-user-action as character no-undo .
      588     define variable v-printed     as logical   no-undo .
      589     define variable v-exist       as logical   no-undo .
      590     do
      591       on error undo, return error
      592       :
      593       run prn-lib-get-report-name  in this-procedure (
      594         input parParentProc
      595         ,output v-report-name
      596         ).
      597   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      599     (input  v-report-name
      600     ,input  2
      601     ,output v-exist
      602     )  .
      603       if NOT v-exist then
      604       DO:
      605         Message
      606           "Нет заданий на печать ! "
      607           view-as alert-box .
      608         Return  .
      609       End.
      610       run gbl/prnfilen.w
      611         (input  ""
      612         ,input  p-DisabledOptions
      613         ,input  string(v-report-name )
      614         ,input  7
      615         ,output v-user-action
      616         ,output v-printed
      617         ) .
      618       if v-printed then
      619       do:
      620         return "YES" .
      621       end.
      622       else
      623       do:
      624         return "NO" .
      625       end.
      626     end.
      627   end procedure.
      628   procedure prn-lib-open-stream :
      629     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      630     define input parameter p-page-size    as integer no-undo .
      631     define input parameter p-is-stream    as logical no-undo .
      632     define input parameter p-append       as logical no-undo .
      633     define variable v-report-name as character no-undo .
      634     do
      635       on error undo, return error
      636       :
      637       run prn-lib-get-report-name  in this-procedure (
      638         input parParentProc
      639         ,output v-report-name
      640         ).
      641       if p-is-stream then
      642       do:
      643         if p-append then
      644         do:
      645           output stream PrnLibStream to value( v-report-name )
      646             page-size value(p-page-size) append .
      647         end.
      648         if not p-append then
      649         do:
      650           output stream PrnLibStream to value( v-report-name )
      651             page-size value(p-page-size) .
      652         end.
      653       end.
      654       if not p-is-stream then
      655       do:
      656         if p-append then
      657         do:
      658           output to value( v-report-name )
      659             page-size value(p-page-size) append .
      660         end.
      661         if not p-append then
      662         do:
      663           output to value( v-report-name )
      664             page-size value(p-page-size) .
      665         end.
      666       end.
      667     end.
      668   end procedure.
      669   procedure prn-lib-open-exp :
      670     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      671     define input parameter p-is-stream    as logical no-undo .
      672     define input parameter p-is-append    as logical no-undo .
      673     define output parameter p-ReportFileName as char init "report" no-undo.
      674     define output parameter p-process as logical no-undo .
      675     define variable glog as logical no-undo .
      676     do
      677       on error undo, return error
      678       :
      679       SYSTEM-DIALOG GET-FILE p-ReportFileName
      680         TITLE      "Укажите путь"
      681         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      682         ASK-OVERWRITE
      683         CREATE-TEST-FILE
      684         SAVE-AS
      685         USE-FILENAME
      686         DEFAULT-EXTENSION "txt"
      687         UPDATE glog
      688         .
      689       if not glog then  return.
      690       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      691       if p-is-stream then
      692       do:
      693         if p-is-append then
      694         do:
      695           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      696         end.
      697         else
      698         do:
      699           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      700         end.
      701       end.
      702       else
      703       do:
      704         if p-is-append then
      705         do:
      706           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      707         end.
      708         else
      709         do:
      710           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      711         end.
      712       end.
      713       p-process = yes.
      714     end.
      715   end procedure.
      716   procedure prn-lib-get-report-name :
      717     define input parameter parParentProc  as widget-handle no-undo.
      718     define output parameter p-report-name as character no-undo .
      719     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      720   end procedure.
      721   procedure prn-lib-reportviewer-report-name :
      722     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      723     define input parameter p-report-name-html as character no-undo .
      724     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      725   end procedure.
      726   procedure prn-lib-reportviewer :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-report-name-html as character no-undo .
      729     define input parameter p-param        as character no-undo .
      730     define variable v-excel           as character no-undo init 'TRUE' .
      731     define variable v-value-character as character no-undo .
      732     define variable v-value-integer   as character no-undo .
      733     define variable v-value-date      as date      no-undo .
      734     define variable v-value-decimal   as decimal   no-undo .
      735     define variable rep-excel         as logical   no-undo .
      736     define variable excel-string      as character no-undo .
      737     define variable v-param-type      as character no-undo .
      738     define variable v-tth             as handle    no-undo .
      739     run adm/shattri.p (
      740       input "get":U
      741       ,input  ""
      742       ,input  0
      743       ,input  'report-glob':U
      744       ,input  'rep-excel':U
      745       ,output v-value-character
      746       ,output v-value-date
      747       ,output v-value-decimal
      748       ,output v-value-integer
      749       ,output rep-excel
      750       ,output v-param-type
      751       ,INPUT-OUTPUT table-handle v-tth
      752       )  .
      753     if rep-excel then v-excel = "TRUE" .
      754     else v-excel = "FALSE" .
      755     if p-param eq ""
      756     then
      757        p-param = "EXCEL:" + v-excel.
      758     else
      759        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      760     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      761   end procedure.
      762   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   define variable v-waitfram-action01         as character   no-undo .
      764   define variable v-waitfram-action02         as character   no-undo .
      765   define variable v-waitfram-action03         as character   no-undo .
      766   define variable mWaitFramTextBeg            as character   no-undo.
      767   define variable mWaitFramTextEnd            as character   no-undo.
      768   define variable mWaitFramView               as logical     no-undo.
      769   define variable mWaitProcEvent              as logical     no-undo init yes.
      770   define variable mWaitFramInterval           as integer     no-undo init 1 .
      771   define variable mWaitFramStop               as logical     no-undo.
      772   define variable mWaitFramStopUser           as logical     no-undo.
      773   define variable mWaitFramStopTimeOut        as logical     no-undo.
      774   define variable mWaitFramStartProc          as datetime-tz no-undo.
      775   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      776   define button B-WaitFramStop auto-end-key
      777        label "Стоп"
      778        size 10 by 1 tooltip "Остоновить процесс".
      779   define button B-viewProcInfo
      780        label "Информация"
      781        size 15 by 1 tooltip "Информация о процесс".
      782   define frame waitfram
      783     v-waitfram-action01 format "x(72)" no-label skip
      784     v-waitfram-action02 format "x(72)" no-label skip
      785     v-waitfram-action03 format "x(72)" no-label skip
      786     B-viewProcInfo
      787     B-WaitFramStop at row 4 col 30
      788     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      789     .
      790   define new global shared variable mBatchMode as logical no-undo init ?.
      791   define variable mFramBachModHandle as handle no-undo.
      792   mFramBachModHandle = frame waitfram:handle.
      793   define variable mFameOldVis as logical no-undo.
      794   define variable mVisCUrentVin as logical no-undo.
      795   if session:batch-mode
      796   then
      797      mBatchMode = yes.
      798   if mBatchMode = ? then do:
      799     mVisCUrentVin = current-window:visible.
      800     mFameOldVis = mFramBachModHandle:visible.
      801     mFramBachModHandle:visible  = yes.
      802     mBatchMode = mFramBachModHandle:visible ne yes.
      803     mFramBachModHandle:visible = mFameOldVis.
      804     current-window:visible = mVisCUrentVin.
      805   end.
      806    if  log-manager:logfile-name ne ?
      807     then DO:
      808         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      809         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      810         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      811     end.
      812   on choose of B-WaitFramStop in frame waitfram
      813   do:
      814     mWaitFramStop = yes.
      815     mWaitFramStopUser = yes.
      816   end.
      817   function waitfram-check-timeout returns logical():
      818      define variable vtime as int64 no-undo.
      819      if mWaitFramStopTimeOut
      820      then
      821         return yes.
      822      vtime = ( now - mWaitFramStartProc ) / 1000 .
      823      if     mWaitFramTimeOut ne ?
      824         and mWaitFramTimeOut ne 0
      825         and mWaitFramTimeOut lt vtime
      826      then do:
      827         mWaitFramStopTimeOut = yes.
      828      end.
      829      return mWaitFramStopTimeOut.
      830   end.
      831   procedure waitfram-hide :
      832     if not session:batch-mode
      833     then do
      834     on error undo, return error return-value
      835     :
      836       pause 0 before-hide .
      837       if not mBatchMode then
      838         hide frame waitfram .
      839     if     not mWaitFramView
      840        and mWaitProcEvent
      841     then
      842       process events .
      843     end.
      844   end procedure.
      845   procedure waitfram-show :
      846     define input  parameter p-message as character no-undo .
      847     define variable v-left-margin as integer   no-undo .
      848     if not session:batch-mode
      849     then do
      850     on error undo, return error return-value
      851     :
      852       if length(p-message) <= 70 then do:
      853         assign
      854           v-left-margin = integer((70 - length(p-message)) / 2)
      855         .
      856         assign
      857           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      858         .
      859         assign
      860           v-waitfram-action01 = " "
      861           v-waitfram-action02 = " "
      862                                    + fill(" ", v-left-margin)
      863                                    + p-message
      864           v-waitfram-action03 = " "
      865         .
      866       end.
      867       else do:
      868         define variable vRindex1 as integer no-undo.
      869         define variable vRindex2 as integer no-undo.
      870         vRindex1 = r-index(p-message," ",70).
      871         if vRindex1 = 0
      872         then
      873            vRindex1 = 70.
      874         if length(p-message)  <= vRindex1 + 70 then do:
      875           assign
      876             v-waitfram-action01 = " "
      877             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      878             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      879           .
      880         end.
      881         else do:
      882           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      883           if vRindex2 <= vRindex1
      884           then
      885              vRindex2 = vRindex1 + 70.
      886           assign
      887             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      888             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      889             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      890           .
      891         end.
      892       end.
      893       B-viewProcInfo:visible   in frame waitfram = no.
      894       B-viewProcInfo:sensitive in frame waitfram = no.
      895       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      896       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      897       if  (   mWaitFramView
      898          or  mWaitProcEvent)
      899          and not mBatchMode
      900       then
      901          display
      902             v-waitfram-action01 skip
      903             v-waitfram-action02 skip
      904             v-waitfram-action03 skip
      905          with frame waitfram .
      906       if     mWaitFramView
      907          then do:
      908             if     mWaitFramInterval ne ?
      909                and not mBatchMode
      910             then
      911                wait-for go of frame waitfram pause mWaitFramInterval.
      912          end.
      913          else
      914             if     mWaitProcEvent
      915                and not mBatchMode
      916             then
      917                process events .
      918     end.
      919   end procedure.
      920      procedure waitfram-show-this:
      921         define input  parameter iInterval as int64 no-undo.
      922         define variable vtime as int64 no-undo.
      923         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      924         mWaitFramInterval = iInterval.
      925         run waitfram-show (substitute("&1&2 &3&4" ,
      926                                       mWaitFramTextBeg ,
      927                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      928                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      929                                       mWaitFramTextEnd
      930                                      )
      931                           ).
      932      end.
      933      procedure WaitFramRunPause:
      934         define input  parameter iInterval as dec no-undo.
      935         define variable vStart  as datetime-tz no-undo.
      936         define variable vend    as datetime-tz no-undo.
      937         define variable vint as int64 no-undo.
      938         define variable vOk as logical no-undo.
      939         vStart = now.
      940         vend   = vStart.
      941         publish "WaitFramPause" (iInterval,output vOk).
      942         vend   =  now.
      943         vint = vend - vStart.
      944         vint = iInterval - vint / 1000.
      945         if     not mWaitFramStop
      946            and (   vint > 0
      947                 or (    not vOk
      948                     and iInterval eq ?
      949                     )
      950                 )
      951         then
      952            run waitfram-show-this (iInterval).
      953         vend   =  now.
      954         vint = vend - vStart.
      955         vint = iInterval - vint / 1000.
      956         if     not mWaitFramStop
      957            and vint > 0
      958         then do:
      959            run gbl/pause.p (vint * 1000).
      960         end.
      961         if iInterval ne ?
      962         then
      963            publish "WaitFramStop".
      964         waitfram-check-timeout().
      965      end.
      966      procedure WaitFramWaitFor:
      967         define input  parameter iInterval as dec no-undo.
      968         assign
      969            mWaitFramStartProc   = now
      970            mWaitFramStopUser    = no
      971            mWaitFramStopTimeOut = no
      972         .
      973         block-wait:
      974         do while not mWaitFramStop:
      975            run WaitFramRunPause (iInterval).
      976            if  waitfram-check-timeout()
      977            then do:
      978               leave block-wait.
      979            end.
      980         end.
      981         run waitfram-hide.
      982      end.
      983   procedure waitfram-join :
      984     define input  parameter p-line-1  as character no-undo .
      985     define input  parameter p-line-2  as character no-undo .
      986     define input  parameter p-line-3  as character no-undo .
      987     define output parameter p-message as character no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991       assign
      992         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      993                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      994                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      995       .
      996     end.
      997   end procedure.
      998   function waitfram-join-function returns character
      999     (input p-line-1 as character
     1000     ,input p-line-2 as character
     1001     ,input p-line-3 as character
     1002     ).
     1003     define variable v-message as character no-undo .
     1004     run waitfram-join in this-procedure
     1005       (input  p-line-1
     1006       ,input  p-line-2
     1007       ,input  p-line-3
     1008       ,output v-message
     1009       ) .
     1010     return v-message .
     1011   end function .
     1012   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   DEFINE NEW SHARED TEMP-TABLE treal-3 no-undo
     1014   FIELD gds-code like ub.goods.gds-code
     1015   FIELD cpay-code as integer
     1016   FIELD curr-code as integer
     1017   FIELD qnty1 as decimal
     1018   FIELD netto as decimal
     1019   FIELD out-name as character format "X(20)"
     1020   FIELD is-pay as logical
     1021   FIELD ii as integer
     1022   FIELD netto-rubl as decimal
     1023   FIELD rv    as integer
     1024   FIELD VAT-pc like ub.doc-line.vat-pc
     1025   FIELD netto-inkas as decimal
     1026   FIELD netto-rubl-inkas as decimal
     1027   FIELD inkas-code like ub.chk-doc.out-code
     1028   INDEX pi IS UNIQUE PRIMARY
     1029           gds-code
     1030           cpay-code
     1031           curr-code
     1032           rv
     1033           is-pay DESCENDING
     1034   INDEX vi
     1035   IS UNIQUE
     1036         gds-code
     1037         ii
     1038   INDEX ivat vat-pc
     1039   .
     1040   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   procedure cur-time :
     1042      define output parameter p-today as date      no-undo .
     1043      define output parameter p-time  as integer   no-undo .
     1044     do
     1045     on error undo, return error
     1046     :
     1047       define variable v-date1 as date      no-undo .
     1048       define variable v-date2 as date      no-undo .
     1049       define variable v-time  as integer   no-undo .
     1050       assign
     1051         v-date1 = today
     1052         v-time  = time
     1053         v-date2 = today
     1054       .
     1055       if v-date1 <> v-date2
     1056       then do:
     1057         assign
     1058           v-date1 = today
     1059           v-time  = v-time
     1060         .
     1061       end.
     1062       assign
     1063         p-today = v-date1
     1064         p-time  = v-time
     1065       .
     1066     end.
     1067   end.
     1068   function cur-time-date returns character
     1069   :
     1070     return string(today, '99/99/9999':U) .
     1071   end.
     1072   function cur-time-mjd returns decimal
     1073   :
     1074     define variable v-date as date      no-undo .
     1075     define variable v-time as integer   no-undo .
     1076     run cur-time in this-procedure
     1077       (output v-date
     1078       ,output v-time
     1079       ) .
     1080     return integer(v-date) - 2400002 + (v-time / 86400) .
     1081   end.
     1082   function cur-time-get-ending-index returns integer
     1083   (input p-number as integer
     1084   )
     1085   :
     1086     if p-number < 0
     1087     or p-number = ?
     1088     then do:
     1089       return 1 .
     1090     end.
     1091     define variable v-rest as integer   no-undo .
     1092     assign
     1093       p-number = p-number modulo 100
     1094     .
     1095     if p-number < 20
     1096     then do:
     1097       assign
     1098         v-rest = p-number
     1099       .
     1100     end.
     1101     else do:
     1102       assign
     1103         v-rest = p-number modulo 10
     1104       .
     1105     end.
     1106     case v-rest :
     1107       when 1
     1108       then do:
     1109         return 2 .
     1110       end.
     1111       when 2 or
     1112       when 3 or
     1113       when 4
     1114       then do:
     1115         return 3 .
     1116       end.
     1117       otherwise do:
     1118         return 1 .
     1119       end.
     1120     end case .
     1121   end.
     1122   procedure cur-time-mjd-to-date :
     1123      define input  parameter i-mjd-diff as decimal no-undo.
     1124      define output parameter o-Date     as date    no-undo.
     1125      define output parameter o-Time     as integer no-undo.
     1126      define variable v-day-number as integer   no-undo .
     1127      if    i-mjd-diff < 0
     1128         or i-mjd-diff = ?
     1129      then do:
     1130         return "?" .
     1131      end.
     1132      assign
     1133         v-day-number = truncate(i-mjd-diff,0).
     1134         o-Date = date(v-day-number + 2400002).
     1135         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1136     .
     1137   end.
     1138   function cur-time-mjd-to-string returns character
     1139   (input p-mjd-diff as decimal
     1140   )
     1141   :
     1142     define variable v-day-number as integer   no-undo .
     1143     define variable v-seconds    as integer   no-undo .
     1144     define variable v-hour       as integer   no-undo .
     1145     define variable v-min        as integer   no-undo .
     1146     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1147     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1148     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1149     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1150     if p-mjd-diff < 0
     1151     or p-mjd-diff = ?
     1152     then do:
     1153       return "?" .
     1154     end.
     1155     assign
     1156       v-day-number = integer(truncate(p-mjd-diff,0))
     1157       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1158     .
     1159     if v-seconds > 86400
     1160     then do:
     1161       assign
     1162         v-seconds = 86400 - 1
     1163       .
     1164     end.
     1165     if v-seconds < 0
     1166     then do:
     1167       assign
     1168         v-seconds = 0
     1169       .
     1170     end.
     1171     assign
     1172       v-hour = truncate(v-seconds / 3600, 0)
     1173     .
     1174     assign
     1175       v-seconds = v-seconds modulo 3600
     1176     .
     1177     assign
     1178       v-min = truncate(v-seconds / 60, 0)
     1179     .
     1180     assign
     1181       v-seconds = v-seconds modulo 60
     1182     .
     1183     return
     1184         (if v-day-number <> 0
     1185           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1186           else ""
     1187         )
     1188       + (if v-day-number <> 0 or v-hour <> 0
     1189           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1190           else ""
     1191         )
     1192       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1193           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1194           else ""
     1195         )
     1196       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1197       .
     1198   end.
     1199   function cur-time-string returns character
     1200   :
     1201     define variable v-date as date      no-undo .
     1202     define variable v-time as integer   no-undo .
     1203     run cur-time in this-procedure
     1204       (output v-date
     1205       ,output v-time
     1206       ) .
     1207     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1208   end.
     1209   function cur-time-string-sec returns character
     1210   :
     1211     define variable v-date as date      no-undo .
     1212     define variable v-time as integer   no-undo .
     1213     run cur-time in this-procedure
     1214       (output v-date
     1215       ,output v-time
     1216       ) .
     1217     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1218   end.
     1219   function cur-time-custom  returns character
     1220   (input p-prefix as character
     1221   ,input p-date-format as character
     1222   ,input p-delimiter as character
     1223   ,input p-time-format as character
     1224   ,input p-suffix as character
     1225   )
     1226   :
     1227     define variable v-date as date      no-undo .
     1228     define variable v-time as integer   no-undo .
     1229     run cur-time in this-procedure
     1230       (output v-date
     1231       ,output v-time
     1232       ) .
     1233     return
     1234       p-prefix
     1235       + string(v-date, p-date-format)
     1236       + p-delimiter
     1237       + string(v-time, p-time-format)
     1238       + p-suffix
     1239       .
     1240   end.
     1241   function cur-time-print  returns character
     1242   :
     1243     define variable v-date as date      no-undo .
     1244     define variable v-time as integer   no-undo .
     1245     run cur-time in this-procedure
     1246       (output v-date
     1247       ,output v-time
     1248       ) .
     1249     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1250   end.
     1251   function cur-time-datetime returns datetime
     1252   :
     1253     define variable v-char as character no-undo .
     1254     define variable v-datetime as datetime no-undo .
     1255     v-char = cur-time-string().
     1256     v-datetime = datetime(v-char).
     1257     return  v-datetime.
     1258   end.
     1259   function cur-time-string-msec returns character
     1260   :
     1261     define variable v-date as datetime  no-undo .
     1262     v-date = now.
     1263     return string(v-date) .
     1264   end.
     1265   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   define SHARED temp-table treal-vat no-undo
     1267   FIELD vat-pc like ub.doc-line.vat-pc
     1268   FIELD inkas-code like ub.inkas.inkas-code
     1269   FIELD doc-date    like ub.inkas.doc-date
