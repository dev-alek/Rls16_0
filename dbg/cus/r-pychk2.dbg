     1942               AND gen0_treal-vat.rv = 0:
     1943               find first buf_treal-vat no-lock where
     1944                     buf_treal-vat.inkas-code = "":U
     1945                 AND buf_treal-vat.grp-code   = pay_treal-vat.grp-code
     1946                 AND buf_treal-vat.vat-pc     = gen0_treal-vat.vat-pc
     1947                 AND buf_treal-vat.rv         = irv  no-error.
     1948               assign
     1949               ii = ii + 1
     1950               col-ii = col-trail + 20 * (ii - 1)
     1951               .
     1952               if available buf_treal-vat then do:
     1953                   assign
     1954                   accum-netto[irv + 2] = accum-netto[irv + 2] + buf_treal-vat.netto
     1955                   accum-netto-rubl[irv + 2] = accum-netto-rubl[irv + 2] + buf_treal-vat.netto-rubl
     1956                   .
     1957                 if not v-only-excel then do:
     1958                   put stream PrnLibStream unformatted
     1959                   string(if v-rubl
     1960                         then buf_treal-vat.netto-rubl
     1961                         else buf_treal-vat.netto, "->>,>>>,>>>,>>9.99") at col-ii.
     1962                 end.
     1963                 if Make-Excel then  put   stream ForExcel unformatted
     1964                 (if v-rubl
     1965                 then buf_treal-vat.netto-rubl
     1966                 else buf_treal-vat.netto)  CHR(9)
     1967                 .
     1968               end.
     1969               else do:
     1970                 if not v-only-excel then do:
     1971                   put stream PrnLibStream unformatted
     1972                   string(0, "->>,>>>,>>>,>>9.99") at col-ii.
     1973                 end.
     1974                               if Make-Excel then  put   stream ForExcel unformatted
     1975                 0  CHR(9)
     1976                 .
     1977               end.
     1978             end.
     1979             assign
     1980             ii = ii + 1
     1981             col-ii = col-trail + 20 * (ii - 1)
     1982             .
     1983             if not v-only-excel then do:
     1984               put stream PrnLibStream unformatted
     1985               string(if v-rubl
     1986                     then accum-netto-rubl[irv + 2]
     1987                     else accum-netto[irv + 2], "->>,>>>,>>>,>>9.99") at col-ii skip.
     1988             end.
     1989             if Make-Excel then  put   stream ForExcel unformatted
     1990             (if v-rubl
     1991             then accum-netto-rubl[irv + 2]
     1992             else accum-netto[irv + 2])
     1993             SKIP.
     1994             assign
     1995             ii-excel = ii-excel + 1
     1996             .
     1997           end.
     1998           if p-rv then do:
     1999             if not v-only-excel then do:
     2000               DOWN STREAM PrnLibStream
     2001               1 with FRAME OutFrame .
     2002             end.
     2003             if Make-Excel then  put   stream ForExcel unformatted
     2004             CHR(9)
     2005             SKIP.
     2006             assign
     2007             ii-excel = ii-excel + 1
     2008             .
     2009           end.
     2010         end.
     2011       end.
     2012       if not v-only-excel then do:
     2013         DOWN STREAM PrnLibStream
     2014         1 with FRAME OutFrame .
     2015         Put stream PrnLibStream unformatted "ИТОГО ПО ВСЕМ ПРОДАЖАМ И ТИПАМ ПЛАТЕЖЕЙ" .
     2016       end.
     2017       if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2018       if Make-Excel then  put   stream ForExcel unformatted
     2019       "ИТОГО ПО ВСЕМ" CHR(9)
     2020       "ПРОДАЖАМ" CHR(9)
     2021       "И ТИПАМ ПЛАТЕЖЕЙ"  CHR(9)
     2022       .
     2023       do iext = 1 to 3:
     2024         assign
     2025         accum-netto[iext] = 0
     2026         accum-netto-rubl[iext] = 0
     2027         .
     2028       end.
     2029       do irv2 = 1 to num-entries(if p-rv then "1,-1,0" else '0'):
     2030         ii = 0.
     2031         irv = integer(entry(irv2, if p-rv then "1,-1,0" else '0')).
     2032         if p-rv then do:
     2033           if not v-only-excel then do:
     2034                       put stream PrnLibStream unformatted
     2035             entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр") at col-fix
     2036             .
     2037           end.
     2038           if Make-Excel then  put   stream ForExcel unformatted
     2039           (if irv2 > 1
     2040            then fill(CHR(9), 3)
     2041            else '':U)
     2042            entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр") CHR(9).
     2043         end.
     2044         for each gen0_treal-vat no-lock where
     2045                 gen0_treal-vat.inkas-code = "":U
     2046             AND gen0_treal-vat.grp-code   = "":U
     2047             AND gen0_treal-vat.rv   = 0 :
     2048           find first gen_treal-vat no-lock where
     2049                     gen_treal-vat.inkas-code = ""
     2050                 AND gen_treal-vat.grp-code = ""
     2051                 AND gen_treal-vat.vat-pc = gen0_treal-vat.vat-pc
     2052                 AND gen_treal-vat.rv = irv no-error.
     2053           assign
     2054           ii = ii + 1
     2055           col-ii = col-trail + 20 * (ii - 1)
     2056           .
     2057           if available gen_treal-vat then do:
     2058             if not v-only-excel then do:
     2059               put stream PrnLibStream unformatted
     2060               string(if v-rubl
     2061                     then gen_treal-vat.netto-rubl
     2062                     else gen_treal-vat.netto, "->>,>>>,>>>,>>9.99") at col-ii.
     2063             end.
     2064             if Make-Excel then  put   stream ForExcel unformatted
     2065             (if v-rubl
     2066             then gen_treal-vat.netto-rubl
     2067             else gen_treal-vat.netto) CHR(9)
     2068             .
     2069             assign
     2070             accum-netto[irv + 2] = accum-netto[irv + 2] + gen_treal-vat.netto
     2071             accum-netto-rubl[irv + 2] = accum-netto-rubl[irv + 2] + gen_treal-vat.netto-rubl
     2072             .
     2073           end.
     2074           else do:
     2075             if not v-only-excel then do:
     2076               put stream PrnLibStream unformatted
     2077               string(0, "->>,>>>,>>>,>>9.99") at col-ii.
     2078             end.
     2079                       if Make-Excel then  put   stream ForExcel unformatted
     2080             0  CHR(9)
     2081             .
     2082           end.
     2083         end.
     2084         assign
     2085         ii  = ii + 1
     2086         col-ii = col-trail + 20 * (ii - 1)
     2087         .
     2088         if not v-only-excel then do:
     2089           put stream PrnLibStream unformatted
     2090           string(if v-rubl
     2091                 then accum-netto-rubl[irv + 2]
     2092                 else accum-netto[irv + 2], "->>,>>>,>>>,>>9.99") at col-ii.
     2093           if irv = 0 then do:
     2094             DOWN STREAM PrnLibStream
     2095             1 with FRAME OutFrame .
     2096           end.
     2097           else do:
     2098             put stream PrnLibStream unformatted skip.
     2099           end.
     2100         end.
     2101         if Make-Excel then  put   stream ForExcel unformatted
     2102         (if v-rubl
     2103         then accum-netto-rubl[irv + 2]
     2104         else accum-netto[irv + 2])
     2105         skip.
     2106       end.
     2107       HIDE STREAM PrnLibStream FRAME BottomFrame .
     2108       OUTPUT STREAM PrnLibStream CLOSE.
     2109       if Make-Excel then output stream ForExcel close.
     2110       run waitfram-hide in this-procedure .
     2111       if not v-only-excel then do:
     2112         run prn-lib-prn-file in this-procedure (
     2113                                                   input parParentProc
     2114                                                   ,input 8
     2115                                                   ).
     2116       end.
     2117       else do:
     2118         define variable v-report-name as character no-undo .
     2119         run prn-lib-get-report-name  in this-procedure(
     2120                                                        input parParentProc
     2121                                                       ,output v-report-name ) .
     2122         run rep/runexcel.p (v-report-name + ".txt").
     2123       end.
     2124     end.
     2125   end procedure.
     2126   procedure printproc-gds :
     2127   define variable v-gds-code like ub.goods.gds-code no-undo .
     2128   define variable f-artic like ub.goods.artic no-undo .
     2129   define variable f-gds-name like ub.goods.gds-name no-undo .
     2130   define variable f-prod-name like ub.clients.obj-name no-undo .
     2131   define variable f-cash-pay-name like ub.cash-pay.obj-name no-undo .
     2132   define variable f-grp-name like ub.goods.grp-name no-undo .
     2133   define variable f-sum-rubl as decimal no-undo .
     2134   define variable f-sum-base as decimal no-undo .
     2135   DEFINE VARIABLE Line                as      char    no-undo.
     2136   DEFINE VARIABLE date_string     as      char    no-undo.
     2137     do
     2138     on error undo, return error
     2139     :
     2140   DEFINE FRAME OutFrame
     2141   v-gds-code COLUMN-LABEL "Код товара"
     2142   f-artic  COLUMN-LABEL "Артикул"
     2143   f-gds-name COLUMn-LABEL "Название товара"  format "X(40)"
     2144   f-prod-name COLUMn-LABEL "Производитель" format "X(30)"
     2145   f-cash-pay-name COLUMn-LABEL "Тип касс.платежа" format "X(30)"
     2146   f-grp-name  COLUMn-LABEL "Группа" format "X(50)"
     2147   f-sum-rubl      COLUMn-LABEL "Сумма в руб." format "->>>,>>>,>>9.99"
     2148   f-sum-base      COLUMn-LABEL "Сумма в б.в." format "->>>,>>>,>>9.99"
     2149   HEADER
     2150   cur-time-print() AT 5 format "X(35)"
     2151   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>>>>9" ) ) AT 170 format "X(13)" SKIP
     2152   Line format "X(195)" AT 1
     2153   with width 232 down stream-io.
     2154   FORM HEADER
     2155   Line format "X(195)" AT 1 SKIP
     2156   "Продолжение - на следующей странице" AT 60 SKIP
     2157   with FRAME BottomFrame width 232
     2158   PAGE-BOTTOM no-labels no-box.
     2159   run waitfram-show in this-procedure ("Ждите..." ).
     2160   run prn-lib-open-stream  in this-procedure (
     2161                                               input parParentProc
     2162                                               ,input 43
     2163                                               ,input yes
     2164                                               ,input no
     2165                                               ).
     2166   run rep/extitle.p (1).
     2167   find first buf1_sheetf no-lock where buf1_sheetf.sheet-num = 1 or buf1_sheetf.sheet-num = 0.
     2168   PUT stream PrnLibStream UNFORMATTED
     2169   ("Разбивка товаров в чеке по типам кассовых платежей" +
     2170   string( x-date-start, "99/99/9999" ) + " по " + string(x-date-end, "99/99/9999") + ".")
     2171   format "x(110)" SKIP(1).
     2172   PUT stream PrnLibStream UNFORMATTED
     2173   str1 skip
     2174   str2 skip
     2175   str4 skip.
     2176   PUT stream PrnLibStream UNFORMATTED
     2177   reportheader SKIP(0).
     2178   VIEW STREAM PrnLibStream FRAME BottomFrame .
     2179   FORM with FRAME OutFrame.
     2180   for each treal-3 no-lock
     2181   break
     2182   by treal-3.gds-code
     2183   by treal-3.cpay-code
     2184   by treal-3.curr-code
     2185   by treal-3.is-pay
     2186   :
     2187     if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2188     if first-of(treal-3.is-pay) then do:
     2189       find first buf_goods no-lock where
     2190                 buf_goods.gds-code = treal-3.gds-code.
     2191       find first buf_clients no-lock where
     2192                 buf_Clients.obj-type = buf_goods.prod-type
     2193             AND buf_Clients.obj-code = buf_goods.prod-code no-error .
     2194       assign
     2195       f-prod-name = buf_clients.obj-name
     2196       f-gds-name = buf_goods.gds-name
     2197       f-grp-name = buf_goods.grp-name
     2198       f-artic = buf_goods.artic
     2199       .
     2200       display stream PrnLibStream
     2201       treal-3.gds-code @ v-gds-code
     2202       f-artic
     2203       f-gds-name
     2204       f-prod-name
     2205       f-grp-name
     2206       treal-3.out-name @ f-cash-pay-name
     2207       treal-3.netto-rubl @ f-sum-rubl
     2208       treal-3.netto @ f-sum-base
     2209       with frame OutFrame.
     2210       DOWN STREAM PrnLibStream
     2211       1 with FRAME OutFrame .
     2212     end.
     2213     else do:
     2214       display stream PrnLibStream
     2215       treal-3.out-name @ f-cash-pay-name
     2216       treal-3.netto-rubl @ f-sum-rubl
     2217       treal-3.netto @ f-sum-base
     2218       with frame OutFrame.
     2219       DOWN STREAM PrnLibStream
     2220       1 with FRAME OutFrame .
     2221     end.
     2222     if Make-Excel then  put   stream ForExcel unformatted
     2223     treal-3.gds-code          CHR(9)
     2224     f-artic                   CHR(9)
     2225     f-gds-name                CHR(9)
     2226     f-prod-name               CHR(9)
     2227     f-grp-name                CHR(9)
     2228     treal-3.out-name          CHR(9)
     2229     treal-3.netto-rubl        CHR(9)
     2230     treal-3.netto             CHR(9)
     2231     skip.
     2232     assign
     2233     ii-excel = ii-excel + 1
     2234     .
     2235   end.
     2236   HIDE STREAM PrnLibStream FRAME BottomFrame .
     2237   OUTPUT STREAM PrnLibStream CLOSE.
     2238   if Make-Excel then output stream ForExcel close.
     2239   run waitfram-hide in this-procedure .
     2240   run prn-lib-prn-file in this-procedure (
     2241                                             input parParentProc
     2242                                             ,input 8
     2243                                             ).
     2244     end.
     2245   end procedure.
