      152   procedure create_obj-list :
      153      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      154      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      155      do
      156      on error undo, return error return-value
      157      :
      158         define buffer cli-obj for ub.clients .
      159         define variable p-var as integer no-undo .
      160         define buffer buf_obj-list for obj-list .
      161         find last buf_obj-list  use-index pi no-error .
      162         if available buf_obj-list
      163         then
      164            p-var = buf_obj-list.obj-id + 1.
      165         else
      166            p-var = 1.
      167         find first cli-obj where
      168                   cli-obj.obj-type = p-obj-type
      169               and cli-obj.obj-code = p-obj-code
      170         no-lock no-error.
      171         if available cli-obj
      172         then do:
      173            create buf_obj-list.
      174            assign
      175               buf_obj-list.obj-id   = p-var
      176               buf_obj-list.obj-code = cli-obj.obj-code
      177               buf_obj-list.obj-type = cli-obj.obj-type
      178               buf_obj-list.obj-name = cli-obj.obj-name
      179               buf_obj-list.db-num   = cli-obj.db-num
      180            .
      181         end.
      182      end.
      183   end.
