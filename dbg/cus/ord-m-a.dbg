      771   .
      772   procedure create_obj-list :
      773      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      774      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      775      do
      776      on error undo, return error return-value
      777      :
      778         define buffer cli-obj for ub.clients .
      779         define variable p-var as integer no-undo .
      780         define buffer buf_obj-list for obj-list .
      781         find last buf_obj-list  use-index pi no-error .
      782         if available buf_obj-list
      783         then
      784            p-var = buf_obj-list.obj-id + 1.
      785         else
      786            p-var = 1.
      787         find first cli-obj where
      788                   cli-obj.obj-type = p-obj-type
      789               and cli-obj.obj-code = p-obj-code
      790         no-lock no-error.
      791         if available cli-obj
      792         then do:
      793            create buf_obj-list.
      794            assign
      795               buf_obj-list.obj-id   = p-var
      796               buf_obj-list.obj-code = cli-obj.obj-code
      797               buf_obj-list.obj-type = cli-obj.obj-type
      798               buf_obj-list.obj-name = cli-obj.obj-name
      799               buf_obj-list.db-num   = cli-obj.db-num
      800            .
      801         end.
      802      end.
      803   end.
