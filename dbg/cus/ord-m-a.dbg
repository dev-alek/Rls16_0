     4993        DISPLAY  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code    WITH FRAME Dialog-Frame.
     4994        ENABLE  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code  WITH FRAME Dialog-Frame.
     4995        end.
     4996     ENABLE RECT-1 RECT-3 RECT-5 RECT-6 RECT-7 RECT-8  R-algoritm p-neg-sale R-min-rest T-gar r-min-rest3 T-min-ost R-algoritm2 SelectObject BR-obj-list T-min-zapas BUTTON-obj  t-way BROWSE-1 B-10 B-1 B-2 T-clos B-3 t-rv t-rvc T-rcv B-4 t-rvz T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m p-prt-art Btn_OK Btn_Cancel B-Help i-exit FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 FILL-IN-15 FILL-IN-13 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7 FILL-IN-16
     4997            WITH FRAME Dialog-Frame.
     4998   .
     4999     VIEW FRAME Dialog-Frame.
     5000     OPEN QUERY br-obj-list  FOR EACH obj-list .    OPEN QUERY browse-1 FOR EACH tt-date .    OPEN QUERY BROWSE-abc-day FOR EACH temp-abc-day .
     5001   END PROCEDURE.
     5002   PROCEDURE loc-init :
     5003   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5004   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5005   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     5006     (input  store-type
     5007     ,input  store-code
     5008     ,output to-day
     5009     )  .
     5010   define variable i as integer no-undo .
     5011   if v-mode = ? then  do:
     5012   find first buf_usr-flt  no-lock where
     5013            buf_usr-flt.user-name = loc-ord-num and
     5014            buf_usr-flt.call-point   = "ord-m":U    no-error .
     5015   end.
     5016   else do:
     5017      if v-mode = "all-ord":U then do:
     5018           find first buf_usr-flt  no-lock where
     5019                   buf_usr-flt.user-name   = g#userid and
     5020                   buf_usr-flt.call-point  = "all-ord":U    no-error .
     5021      end.
     5022      else do:
     5023             find first buf_usr-flt  no-lock where
     5024                   buf_usr-flt.user-name = loc-ord-num and
     5025                   buf_usr-flt.call-point   = "ord-m":U  + v-mode   no-error .
     5026                   if not available buf_usr-flt  then do:
     5027                     find first buf_usr-flt  no-lock where
     5028                             buf_usr-flt.user-name = loc-ord-num and
     5029                             buf_usr-flt.call-point   = "ord-m":U  no-error .
     5030                   end.
     5031      end.
     5032   end.
     5033   if not available buf_usr-flt  then do:
     5034      find first buf_usr-flt  no-lock where
     5035            buf_usr-flt.user-name    = g#userid and
     5036            buf_usr-flt.call-point   = "ord-m":U    no-error .
     5037   end.
     5038   if available buf_usr-flt  then do:
     5039     run init-screen ( buf_usr-flt.list_ ) .
     5040   end.
     5041   else do:
     5042       assign
     5043           date-p-1  = to-day - 30
     5044           date-p-2  = to-day
     5045           t-rv   = true
     5046           t-rvz  = true
     5047           t-rvc  = true
     5048           t-rvzc = true
     5049           r-algoritm = 1
     5050       .
     5051     if v-round-m = "" or v-round-m = ? then v-round-m = 'Отключено':U .
     5052     display v-round-m with frame Dialog-Frame .
     5053       find first ub.tmp-sale no-lock no-error .
     5054       if error-status :error then do:
     5055             create  ub.tmp-sale.
     5056             assign  ub.tmp-sale.tmp-code = "1"
     5057                     ub.tmp-sale.desc_    = "Пустой"
     5058                     .
     5059       end.
     5060       find current ub.tmp-sale no-lock no-error .
     5061       if available ub.tmp-sale then
     5062           display  ub.tmp-sale.tmp-code
     5063                     ub.tmp-sale.desc_   with frame Dialog-Frame .
     5064       if available ub.tmp-sale then  rr = recid(ub.tmp-sale) .
     5065   end.
     5066   if v-mode = "auto-ord" then do:
     5067     run init-screen ( p-return ) .
     5068   end.
     5069    display R-algoritm p-neg-sale R-min-rest T-gar r-min-rest3 T-min-ost R-algoritm2 SelectObject BR-obj-list T-min-zapas BUTTON-obj  t-way BROWSE-1 B-10 B-1 B-2 T-clos B-3 t-rv t-rvc T-rcv B-4 t-rvz T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m p-prt-art Btn_OK Btn_Cancel B-Help i-exit FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 FILL-IN-15 FILL-IN-13 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7 FILL-IN-16 with frame Dialog-Frame.
     5070     if g#type = 'ФП':U then do:
     5071           ENABLE
     5072             SelectObject
     5073             br-obj-list
     5074             BUTTON-obj
     5075             FILL-IN-13
     5076             rect-7
     5077             WITH FRAME Dialog-Frame.
     5078     end.
     5079     else do:
     5080         hide  SelectObject  br-obj-list  BUTTON-obj  FILL-IN-13 rect-7            in frame Dialog-Frame .
     5081         for each obj-list
     5082             on error undo, return error :
     5083             delete obj-list.
     5084         end.
     5085   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5086   run create_obj-list in this-procedure
     5087    ( input store-type ,
     5088      input store-code )
     5089      .
     5090     end.
     5091   define variable v-value  as character no-undo .
     5092   define variable v-i      as integer   no-undo .
     5093   define variable v-dec as integer   no-undo .
     5094   define variable p-prop-code as character no-undo .
     5095   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
     5096   define variable v-value-date    like ub.thbj-attr.property-value-date no-undo .
     5097   define variable v-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
     5098   define variable v-value-logical like ub.thbj-attr.property-value-logical no-undo .
     5099   define variable v-value-integer like ub.thbj-attr.property-value-integer no-undo .
     5100   define variable v-type     as character no-undo .
     5101   define variable v-found as decimal no-undo .
     5102    empty TEMP-TABLE  thbjattr_thbj-attr .
     5103    empty TEMP-TABLE temp-abc-day .
     5104    repeat v-i = 1 to 6:
     5105       run adm/shattri.p (
     5106         input "get":U
     5107         ,input store-type
     5108         ,input store-code
     5109         ,input 'abc-sale-day':U
     5110         ,input  chr ( 64 + v-i )
     5111         ,output v-value-character
     5112         ,output v-value-date
     5113         ,output v-value-decimal
     5114         ,output v-value-integer
     5115         ,output v-value-logical
     5116         ,output par-type
     5117         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5118         ) no-error .
     5119           v-dec = v-value-integer no-error .
     5120           if v-dec = ? then v-dec = 0 .
     5121           create temp-abc-day.
     5122           assign
     5123             temp-abc-day.abc-type = chr ( 64 + v-i )
     5124             temp-abc-day.gar-day  = v-dec
     5125           .
     5126    end.
     5127    run v-c-alg in this-procedure .
     5128    run v-c-way in this-procedure .
     5129   END PROCEDURE.
     5130   PROCEDURE p-calc :
     5131   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     5132   define input-output parameter n-day as logical no-undo .
     5133   define input parameter n-i as integer no-undo .
     5134   define variable t-i as date no-undo.
     5135   define variable p-modulo as integer no-undo .
     5136   assign frame Dialog-Frame
     5137      date-p-1 date-p-2.
     5138     if date-p-1 = ? or  date-p-2 = ? then
     5139     apply "entry " to date-p-1 .
     5140   if date-p-1 <> ? and  date-p-2 <> ? then do:
     5141     if n-day = true then do:
     5142           n-day = false.
     5143            repeat t-i = date-p-1 To date-p-2 :
     5144               p-modulo = if (integer(t-i) MODULO 7 ) = 0 then 7 else (integer(t-i) MODULO 7 ).
     5145               if p-modulo = n-i then do:
     5146                    find first tt-date where  tt-date.exch-date =  t-i no-error.
     5147                       if available  tt-date then delete tt-date.
     5148               end.
     5149            end.
     5150     end.
     5151     else do:
     5152           n-day = true.
     5153            repeat t-i = date-p-1 To date-p-2 :
     5154              p-modulo = if (integer(t-i) MODULO 7 ) = 0 then 7 else (integer(t-i) MODULO 7 ).
     5155               if p-modulo = n-i
     5156               then do:
     5157                   if not can-find ( first tt-date where tt-date.exch-date =  t-i ) then do:
     5158                       create tt-date.
     5159                       assign tt-date.exch-date =  t-i.
     5160                       end.
     5161               end.
     5162            end.
     5163     end.
     5164      OPEN QUERY browse-1 FOR EACH tt-date .
     5165     end.
     5166    end.
     5167   END PROCEDURE.
     5168   PROCEDURE remember-screen :
     5169    do
     5170    on error undo, return error return-value
     5171    :
     5172   define input-output parameter p-val as character no-undo .
     5173            p-val =
     5174               string( "v-round-m=" )  + string( v-round-m ) + "," +
     5175               string( "v-round-base=" )  + string( v-round-base,">>>>>>>>>9.99" ) + "," +
     5176               string( "R-algoritm=" )  + string( R-algoritm ) + "," +
     5177               string( "R-algoritm2=" ) + string( R-algoritm2 ) + "," +
     5178               string( "tmp-sale.tmp-code=" ) + (
     5179               if available ub.tmp-sale and R-algoritm = 2
     5180                     then   string( ub.tmp-sale.tmp-code )
     5181                                 else ( " " ) )                          + "," +
     5182               string( "R-min-rest3=" ) + string( R-min-rest3,"yes/no" ) + "," +
     5183               string( "R-min-rest=" )  + string( R-min-rest ) + "," +
     5184               ( if date-p-1 = ?  then ""
     5185                                  else string( "date-p-1=" )    + string( date-p-1,"99/99/9999" )
     5186                                  )
     5187                                + "," +
     5188               ( if date-p-2 = ?  then ""
     5189                                  else string( "date-p-2=" )    + string( date-p-2,"99/99/9999" )
     5190                                  )
     5191                                + "," +
     5192               string( "t-way="    )    + string( t-way   ,"yes/no" ) + "," +
     5193               string( "t-rcv="    )    + string( t-rcv   ,"yes/no" ) + "," +
     5194               string( "t-clos="   )    + string( t-clos  ,"yes/no" ) + "," +
     5195               string( "t-rv="     )    + string( t-rv    ,"yes/no" ) + "," +
     5196               string( "t-rvz="    )    + string( t-rvz   ,"yes/no" ) + "," +
     5197               string( "t-rvc="    )    + string( t-rvc   ,"yes/no" ) + "," +
     5198               string( "t-rvzc="   )    + string( t-rvzc  ,"yes/no" ) + "," +
     5199               string( "t-sp="     )    + string( t-sp    ,"yes/no" ) + "," +
     5200               string( "t-sppv-2=" )    + string( t-sppv-2,"yes/no" ) + "," +
     5201               string( "t-sppv-3=" )    + string( t-sppv-3,"yes/no" ) + "," +
     5202               string( "t-sppv-4=" )    + string( t-sppv-4,"yes/no" ) + "," +
     5203               string( "p-neg-sale=" )  + string( p-neg-sale,"yes/no" ) + "," +
     5204               string( "t-gar=" )       + string( t-gar,"yes/no" ) + "," +
     5205               string( "t-min-zapas=" ) + string( t-min-zapas,"yes/no" ) + "," +
     5206               string( "t-min-ost=" ) + string( t-min-ost,"yes/no" ) + "," +
     5207               string( "SelectObject=" ) + string( SelectObject )
     5208               .
     5209     if g#type <> 'ФП':U then do:
     5210         for each  obj-list : delete obj-list . end.
     5211   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5212   run create_obj-list in this-procedure
     5213    ( input store-type ,
     5214      input store-code )
     5215      .
     5216     end.
     5217     p-val = p-val +  "," + "Объекты :&"  .
     5218         for each obj-list :
     5219                 p-val = p-val +  obj-list.obj-type + " " + string(obj-list.obj-code) + ","    .
     5220         end.
     5221     end.
     5222   END PROCEDURE.
     5223   PROCEDURE select-objects-proc :
     5224    do
     5225    on error undo, return error return-value
     5226    :
     5227     define input parameter p-e-m as character no-undo .
     5228     define variable v-all-object as logical   no-undo .
     5229     my-handle = parparentproc .
     5230   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5231   for each obj-list :
     5232    delete obj-list.
     5233   end.
     5234   str-obj#  = "" .
     5235   str-obj2# = "" .
     5236   str-obj3# = "" .
     5237   case selectobject :
     5238   when "currency":U then do:
     5239    run verify-check.
     5240   end.
     5241   when 'все':U then   do:
     5242    run sss.
     5243   end.
     5244   when "all" then   do:
     5245    run sss.
     5246   end.
     5247   when "firm":U then   do:
     5248    run sss.
     5249   end.
     5250   when "choice":U then do:
     5251     for each obj-list :
     5252         delete obj-list.
     5253     end.
     5254     define variable v-object-exist as logical   no-undo .
     5255   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5256   run userobjs_object-exist in this-procedure
     5257     (output v-object-exist
     5258     )  .
     5259     if not params-only and v-object-exist = false then do:
     5260   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5261   run userobjs_append in this-procedure
     5262     (input  v-cntxt-obj-type
     5263     ,input  v-cntxt-obj-code
     5264     )  .
     5265        v-object-exist = true .
     5266     end.
     5267     if my-request     = false
     5268     or v-object-exist = false
     5269     then do:
     5270       define variable v-user-select as logical   no-undo .
     5271       define variable v-recids as character no-undo .
     5272       if params-only then do:
     5273       run ref/thobjs.w
     5274           ( input my-handle
     5275           , input this-procedure:handle
     5276           , input (if params-only-mode = 'ПРОСМОТР':U then "b-mark-hidden" else "b-mark,b-sel")
     5277           , input 'все':U
     5278           , input ''
     5279           , input ?
     5280           , input ?
     5281           , input-output v-recids ) no-error .
     5282        end.
     5283        else do:
     5284   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5285   run userobjs_select-many in this-procedure
     5286     (input  my-handle
     5287     ,input  v-cntxt-db-num
     5288     ,input  v-cntxt-userid
     5289     ,input  v-cntxt-host-code-obj
     5290     ,input  v-cntxt-obj-type
     5291     ,input  v-cntxt-obj-code
     5292     ,output v-user-select
     5293     )  .
     5294        end.
     5295     end.
     5296     my-request = true .
     5297   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5298   run userobjs_object-exist in this-procedure
     5299     (output v-object-exist
     5300     )  .
     5301     if v-object-exist = false
     5302     then do:
     5303       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u then do:
     5304         assign selectobject = "firm":U .
     5305       end.
     5306       else do:
     5307         assign selectobject =  "currency":u .
     5308       end.
     5309       display selectobject with frame Dialog-Frame .
     5310       disable button-obj   with frame Dialog-Frame .
     5311       find cli-obj where cli-obj.obj-type = v-cntxt-obj-type and
     5312                           cli-obj.obj-code = v-cntxt-obj-code no-lock .
     5313       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u
     5314       then do:
     5315         run sss.
     5316       end.
     5317       else do:
     5318         run verify-check.
     5319       end.
     5320     end.
     5321     else do:
     5322         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     5323         define buffer buf_clients for ub.clients .
     5324         define buffer buf_db for ub.db .
     5325         define buffer buf_shop for ub.shop .
     5326         define buffer buf_store for ub.store .
     5327         define buffer buf_sysconf for ub.sysconf .
     5328         for each buf_userobjs_temp-user-obj
     5329         :
     5330           find first buf_clients no-lock
     5331             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     5332               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     5333             .
     5334             if verify-send-check  and buf_clients.db-num <> v-cntxt-db-num  and v-all-object = false then do:
     5335                   find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     5336                   if buf_db.send-check = false then do:
     5337                     str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     5338                     next.
     5339                   end.
     5340             end.
     5341             if temp-param-obj-type = 'shop':u and v-all-object = false then do:
     5342                 if buf_userobjs_temp-user-obj.obj-type = 'скл':U then do:
     5343                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     5344                     next.
     5345                   end.
     5346             end.
     5347             if temp-param-obj-type = 'stock':u and v-all-object = false then do:
     5348                 if buf_userobjs_temp-user-obj.obj-type = 'маг':U then do:
     5349                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     5350                     next.
     5351                 end.
     5352             end.
     5353             case buf_userobjs_temp-user-obj.obj-type:
     5354                 when 'скл':U then
     5355                     do:
     5356                         find buf_store where buf_store.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     5357                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
     5358                         find first buf_clients no-lock where
     5359                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     5360                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     5361                             .
     5362                         if buf_sysconf.base-code = base-code or v-all-object = true
     5363                             then do:
     5364   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5365   run create_obj-list in this-procedure
     5366    ( input buf_userobjs_temp-user-obj.obj-type ,
     5367      input buf_userobjs_temp-user-obj.obj-code )
     5368      .
     5369                             end.
     5370                             else do:
     5371                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5372                             end.
     5373                     end.
     5374                 when 'маг':U then
     5375                     do:
     5376                         find first buf_shop where buf_shop.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     5377                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
     5378                         find first buf_clients no-lock where
     5379                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     5380                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     5381                         if buf_sysconf.base-code = base-code or v-all-object = true
     5382                               then do:
     5383   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5384   run create_obj-list in this-procedure
     5385    ( input buf_userobjs_temp-user-obj.obj-type ,
     5386      input buf_userobjs_temp-user-obj.obj-code )
     5387      .
     5388                             end.
     5389                             else do:
     5390                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5391                             end.
     5392                     end.
     5393             end case.
     5394           end.
     5395       end.
     5396   end.
     5397   end case.
     5398   if SelectObject = "currency":U  or g#type <> 'ФП':U then do:
     5399       for each  obj-list : delete obj-list . end.
     5400   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5401   run create_obj-list in this-procedure
     5402    ( input store-type ,
     5403      input store-code )
     5404      .
     5405   end.
     5406   if SelectObject = 'order':U then do:
     5407       for each  obj-list : delete obj-list . end.
     5408       define variable str-pos as integer no-undo .
     5409       define variable str-pos2 as integer no-undo .
     5410       define variable str-1 as character no-undo .
     5411       define variable i as integer no-undo .
     5412       define variable e1 as character no-undo .
     5413       define variable e2 as integer no-undo .
     5414       define variable v-nn as integer   no-undo .
     5415       str-pos = index (  p-e-m , "&" ) .
     5416       str-pos2 = LENGTH ( p-e-m ) - str-pos .
     5417       str-1 = substring (p-e-m , str-pos + 1 , str-pos2 ).
     5418       v-nn = num-entries (str-1) .
     5419       do i = 1 to v-nn :
     5420           assign
     5421             e1 = entry(1, (entry( i , str-1, "," )) , " ")
     5422             e2 = integer(entry(2, (entry( i , str-1, "," )), " " ))
     5423             no-error .
     5424             if error-status :error then next.
     5425   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5426   run create_obj-list in this-procedure
     5427    ( input e1 ,
     5428      input e2 )
     5429      .
     5430       end.
     5431   end.
     5432   OPEN QUERY br-obj-list  FOR EACH obj-list .
     5433     end.
     5434   END PROCEDURE.
     5435   PROCEDURE sss :
     5436     do
     5437     on error undo, return error return-value
     5438     :
     5439   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5440     for each obj-list :  delete obj-list.  end.
     5441     assign
     5442       str-obj#  = ''
     5443       str-obj2# = ''
     5444       str-obj3# = ''.
     5445     define buffer buf_user-obj for ub.user-obj .
     5446     for each buf_user-obj no-lock
     5447       where buf_user-obj.db-num  = v-cntxt-db-num
     5448         and buf_user-obj.user-id = v-cntxt-userid
     5449     ,each cli-obj no-lock
     5450       where cli-obj.obj-type = buf_user-obj.obj-type
     5451         and cli-obj.obj-code = buf_user-obj.obj-code
     5452         and ( ( cli-obj.db-num = g#db-num ) or g#db-num = 0 )
     5453     :
     5454             find first ub.clients no-lock
     5455               where ub.clients.obj-type = buf_user-obj.obj-type
     5456                 and ub.clients.obj-code = buf_user-obj.obj-code
     5457               no-error .
     5458             if verify-send-check  and ub.clients.db-num <> g#db-num  then do:
     5459                find first ub.db where ub.db.db-num = ub.clients.db-num no-lock.
     5460                if ub.db.send-check = false
     5461                then do:
     5462                  assign
     5463                    str-obj2# = str-obj2#  + " " + ub.clients.obj-name + ","
     5464                  .
     5465                  next.
     5466                end.
     5467             end.
     5468             if temp-param-obj-type = 'shop':u
     5469             then do:
     5470               if buf_user-obj.obj-type = 'скл':U
     5471               then do:
     5472                 assign
     5473                   str-obj# = str-obj#  +  " " + ub.clients.obj-name + ","
     5474                 .
     5475                 next.
     5476               end.
     5477             end.
     5478             if temp-param-obj-type = 'stock':u
     5479             then do:
     5480               if buf_user-obj.obj-type = 'маг':U then do:
     5481                 assign
     5482                   str-obj# = str-obj#  +  " " +  ub.clients.obj-name + ","
     5483                 .
     5484                 next.
     5485               end.
     5486             end.
     5487                   case buf_user-obj.obj-type
     5488                   :
     5489                       when 'скл':U then
     5490                           do:
     5491                               find ub.store where ub.store.obj-code = buf_user-obj.obj-code no-lock.
     5492                               if selectobject = "firm":U then do:
     5493                                 if ub.store.host-code <> g#host-code then do:
     5494                                     str-obj3# = str-obj3#  + " " + ub.clients.obj-name + ",".
     5495                                     next.
     5496                                     end.
     5497                               end.
     5498                               find first ub.sysconf no-lock where ub.sysconf.host-code = ub.store.host-code no-error.
     5499                               find first ub.clients no-lock
     5500                                 where ub.clients.obj-type = buf_user-obj.obj-type
     5501                                   and ub.clients.obj-code = buf_user-obj.obj-code
     5502                                 no-error .
     5503                               if ub.sysconf.base-code = base-code then
     5504                                   do:
     5505   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5506   run create_obj-list in this-procedure
     5507    ( input buf_user-obj.obj-type ,
     5508      input buf_user-obj.obj-code )
     5509      .
     5510                                   end.
     5511                                   else str-obj# = str-obj#  +  " " +   ub.clients.obj-name + "," .
     5512                           end.
     5513                       when 'маг':U then
     5514                           do:
     5515                               find ub.shop where ub.shop.obj-code = buf_user-obj.obj-code no-lock.
     5516                               if selectobject = "firm":U then do:
     5517                                 if ub.shop.host-code <> g#host-code then do:
     5518                                     str-obj3# = str-obj3#  + " " + ub.clients.obj-name + ",".
     5519                                     next.
     5520                                     end.
     5521                               end.
     5522                               find first ub.sysconf no-lock where ub.sysconf.host-code = ub.shop.host-code no-error.
     5523                               find first ub.clients no-lock where
     5524                                           ub.clients.obj-type = buf_user-obj.obj-type and
     5525                                           ub.clients.obj-code = buf_user-obj.obj-code no-error.
     5526                               if ub.sysconf.base-code = base-code
     5527                               then do:
     5528   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5529   run create_obj-list in this-procedure
     5530    ( input buf_user-obj.obj-type ,
     5531      input buf_user-obj.obj-code )
     5532      .
     5533                               end.
     5534                               else do:
     5535                                 assign
     5536                                   str-obj# = str-obj#  +  " " +  ub.clients.obj-name +  ","
     5537                                 .
     5538                               end.
     5539                           end.
     5540                   end case.
     5541     end.
     5542     end.
     5543   END PROCEDURE.
     5544   PROCEDURE v-c-2 :
     5545     assign frame   Dialog-Frame   r-algoritm2.
     5546     case  r-algoritm2:
     5547     when 1 then do:
     5548            enable  RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14      with frame Dialog-Frame .
     5549            disable BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7    with frame Dialog-Frame .
     5550            hide    BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7    in   frame Dialog-Frame .
     5551            browse-1:bgcolor      in   frame Dialog-Frame  = 8 .
     5552     end.
     5553     when 2 then do:
     5554           enable  RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14    with frame Dialog-Frame .
     5555           disable BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame .
     5556           hide    BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  in   frame Dialog-Frame .
     5557           browse-1:bgcolor    in   frame Dialog-Frame  = 8 .
     5558     end.
     5559     when 3 then do:
     5560           enable   RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7   with frame Dialog-Frame .
     5561           browse-1:bgcolor  in frame Dialog-Frame  = ? .
     5562      end.
     5563      otherwise do:
     5564         message "Нет!!! " .
     5565      end.
     5566     end case.
     5567   END PROCEDURE.
     5568   PROCEDURE v-c-alg :
     5569    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     5570    define variable g#log  as logical   no-undo .
     5571     assign frame   Dialog-Frame   r-algoritm.
     5572     g#log = R-algoritm2:enable(radio-label("2", R-algoritm2:radio-buttons)) .
     5573     case  r-algoritm:
     5574     when 1 then do:
     5575            enable  RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7 with frame Dialog-Frame .
     5576            disable BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code  T-gar t-gar-1 t-gar-2 with frame Dialog-Frame .
     5577            hide    BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code  T-gar t-gar-1 t-gar-2 in frame Dialog-Frame .
     5578            g#log = R-min-rest:enable( 'На фирме' ) .
     5579            browse-1:bgcolor  in frame Dialog-Frame  = 8 .
     5580     end.
     5581     when 2 then do:
     5582           enable  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7 with frame Dialog-Frame .
     5583           disable RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  T-gar t-gar-1 t-gar-2  with frame Dialog-Frame .
