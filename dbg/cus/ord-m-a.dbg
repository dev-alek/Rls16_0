     5616           browse-1:bgcolor  in frame Dialog-Frame  = 8 .
     5617           g#log = R-min-rest:enable( 'На фирме' ) .
     5618               OPEN QUERY BROWSE-abc-day FOR EACH temp-abc-day .
     5619     end.
     5620      otherwise do:
     5621         message "Нет!!! " .
     5622      end.
     5623     end case.
     5624     if r-algoritm <>  2 and
     5625        r-algoritm <>  5 and
     5626        r-algoritm <>  6
     5627        then do:
     5628        run v-c-2 in this-procedure .
     5629        end.
     5630    end.
     5631   END PROCEDURE.
     5632   PROCEDURE v-c-way :
     5633     assign frame   Dialog-Frame   t-way.
     5634     if  t-way then do:
     5635         if loc-doc-type = 'ОО':U then do:
     5636            T-rcv:label = 'запрос':U      .
     5637            hide T-clos  in frame Dialog-Frame .
     5638         end.
     5639         display T-clos when loc-doc-type <> 'ОО':U
     5640                 T-rcv
     5641                 FILL-IN-8  with frame Dialog-Frame .
     5642         enable T-clos  when loc-doc-type <> 'ОО':U
     5643                T-rcv
     5644                FILL-IN-8 with frame Dialog-Frame .
     5645         end.
     5646     else do:
     5647           disable T-clos T-rcv FILL-IN-8 with frame Dialog-Frame .
     5648           hide T-clos T-rcv FILL-IN-8 in frame Dialog-Frame .
     5649           end.
     5650   END PROCEDURE.
     5651   PROCEDURE verify-check :
     5652   END PROCEDURE.
