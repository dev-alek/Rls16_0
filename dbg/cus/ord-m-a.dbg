      760   def
      761    shared
      762   temp-table  obj-list no-undo
      763     field obj-type like ub.clients.obj-type
      764     field obj-code like ub.clients.obj-code
      765     field obj-name like ub.clients.obj-name
      766     field obj-id   as integer
