     2256        B-spis AT ROW 18.42 COL 9.75
     2257        v-name AT ROW 19.5 COL 1 NO-LABEL
     2258        p-prt-art AT ROW 19.67 COL 66 WIDGET-ID 8
     2259        B-save AT ROW 20.5 COL 51.63
     2260        Btn_OK AT ROW 20.5 COL 66.75
     2261        Btn_Cancel AT ROW 20.5 COL 82
     2262        B-Help AT ROW 20.5 COL 97.5
     2263        i-exit AT ROW 20.71 COL 66.88 WIDGET-ID 10
     2264        FILL-IN-2 AT ROW 1.21 COL 41.13 COLON-ALIGNED NO-LABEL
     2265        FILL-IN-17 AT ROW 1.25 COL 1.88 NO-LABEL
     2266        FILL-IN-3 AT ROW 2.67 COL 67 COLON-ALIGNED NO-LABEL
     2267        t-gar-1 AT ROW 4.21 COL 67 COLON-ALIGNED NO-LABEL
     2268        t-gar-2 AT ROW 4.83 COL 66.88 COLON-ALIGNED NO-LABEL
     2269        FILL-IN-15 AT ROW 6.25 COL 1.63 NO-LABEL
     2270        FILL-IN-13 AT ROW 6.33 COL 32.25 COLON-ALIGNED NO-LABEL
     2271        t-min-ost-1 AT ROW 6.42 COL 66.88 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     2272        t-min-ost-2 AT ROW 7.04 COL 66.88 COLON-ALIGNED NO-LABEL WIDGET-ID 6
     2273        FILL-IN-5 AT ROW 8.67 COL 67.13 COLON-ALIGNED NO-LABEL
     2274        FILL-IN-7 AT ROW 9.29 COL 67.13 COLON-ALIGNED NO-LABEL
     2275        t-1 AT ROW 10.58 COL 2.63 COLON-ALIGNED NO-LABEL
     2276        FILL-IN-8 AT ROW 11.42 COL 85 COLON-ALIGNED NO-LABEL
     2277        FILL-IN-14 AT ROW 11.54 COL 32.5 COLON-ALIGNED NO-LABEL
     2278        t-2 AT ROW 11.67 COL 2.63 COLON-ALIGNED NO-LABEL
     2279        t-3 AT ROW 12.54 COL 2.63 COLON-ALIGNED NO-LABEL
     2280        t-4 AT ROW 13.67 COL 2.63 COLON-ALIGNED NO-LABEL
     2281        t-5 AT ROW 14.71 COL 2.63 COLON-ALIGNED NO-LABEL
     2282        t-6 AT ROW 15.67 COL 2.63 COLON-ALIGNED NO-LABEL
     2283        t-7 AT ROW 16.58 COL 2.63 COLON-ALIGNED NO-LABEL
     2284        FILL-IN-16 AT ROW 18.04 COL 1.75 NO-LABEL
     2285        tmp-sale.desc_ AT ROW 18.21 COL 11 COLON-ALIGNED NO-LABEL FORMAT "X(120)"
     2286              VIEW-AS TEXT
     2287             SIZE 59.88 BY .67
     2288             FGCOLOR 1
     2289        tmp-sale.tmp-code AT ROW 19.04 COL 11 COLON-ALIGNED NO-LABEL FORMAT "X(120)"
     2290              VIEW-AS TEXT
     2291             SIZE 59.75 BY .67
     2292        "Дополнительные условия расчета":C32 VIEW-AS TEXT
     2293             SIZE 32 BY .67 AT ROW 1.25 COL 67.25
     2294             BGCOLOR 8 FGCOLOR 4
     2295       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2296            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2297            FGCOLOR 0
     2298            CANCEL-BUTTON Btn_Cancel.
     2299   DEFINE FRAME Dialog-Frame
     2300        RECT-1 AT ROW 1.08 COL 1
     2301        RECT-3 AT ROW 6 COL 1.13
     2302        RECT-5 AT ROW 1.08 COL 42.38
     2303        RECT-6 AT ROW 1.13 COL 66.88
     2304        RECT-7 AT ROW 6 COL 33.5
     2305        RECT-8 AT ROW 11.42 COL 33.5
     2306        SPACE(22.01) SKIP(4.95)
     2307       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2308            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2309            FGCOLOR 0
     2310            TITLE "Параметры расчета заказа"
     2311            CANCEL-BUTTON Btn_Cancel.
     2312   ASSIGN
     2313          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2314          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2315   ASSIGN
     2316          B-save:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2317          date-p-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2318          date-p-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2319   ASSIGN
     2320          v-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2321   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2322   DO:
     2323     APPLY "END-ERROR":U TO SELF.
     2324   END.
     2325   ON CHOOSE OF B-1 IN FRAME Dialog-Frame
     2326   DO:
     2327     run p-calc in this-procedure ( input-output t-1 , input 1) .
     2328     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     2329   END.
     2330   ON CHOOSE OF B-10 IN FRAME Dialog-Frame
     2331   DO:
     2332        for each tt-date :
     2333            delete tt-date.
     2334      end.
     2335      assign
     2336       t-1 = false
     2337       t-2 = false
     2338       t-3 = false
     2339       t-4 = false
     2340       t-5 = false
     2341       t-6 = false
     2342       t-7 = false
     2343    .
     2344    display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2345     OPEN QUERY browse-1 FOR EACH tt-date .
     2346   END.
     2347   ON CHOOSE OF B-2 IN FRAME Dialog-Frame
     2348   DO:
     2349     run p-calc in this-procedure (input-output t-2 ,input 2) .
     2350     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2351   END.
     2352   ON CHOOSE OF B-3 IN FRAME Dialog-Frame
     2353   DO:
     2354     run p-calc in this-procedure  (input-output t-3 ,input 3) .
     2355     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2356   END.
     2357   ON CHOOSE OF B-4 IN FRAME Dialog-Frame
     2358   DO:
     2359     run p-calc in this-procedure (input-output t-4 ,input 4) .
     2360     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2361   END.
     2362   ON CHOOSE OF B-5 IN FRAME Dialog-Frame
     2363   DO:
     2364     run p-calc in this-procedure (input-output t-5 ,input 5) .
     2365     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2366   END.
     2367   ON CHOOSE OF B-6 IN FRAME Dialog-Frame
     2368   DO:
     2369     run p-calc in this-procedure (input-output t-6 ,input 6) .
     2370     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2371   END.
     2372   ON CHOOSE OF B-7 IN FRAME Dialog-Frame
     2373   DO:
     2374     run p-calc in this-procedure (input-output t-7 ,input 7) .
     2375     display BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     2376   END.
     2377   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     2378   DO:
     2379   apply "choose" to btn_ok  in frame Dialog-Frame .
     2380    find first buf_usr-flt  exclusive-lock  where
     2381            buf_usr-flt.user-name    = g#userid and
     2382            buf_usr-flt.call-point   = "all-ord":U   no-error .
     2383        if NOT available buf_usr-flt then  create buf_usr-flt.
     2384        find first ub.tmp-sale where recid(ub.tmp-sale) = rr  no-lock no-error .
     2385          Assign
     2386            buf_usr-flt.user-name    = g#userid
     2387            buf_usr-flt.call-point   = "all-ord":U
     2388            buf_usr-flt.list_ = "".
     2389            run remember-screen ( input-output buf_usr-flt.list_ ).
     2390   t-ret =  session:SET-WAIT-STATE("") .
     2391   END.
     2392   ON CHOOSE OF B-spis IN FRAME Dialog-Frame
     2393   DO:
     2394   define variable t-recid as recid no-undo .
     2395   define variable s-recid as character no-undo .
     2396       if r-algoritm = 6 then do:
     2397         define buffer buf_abc-analysis for abc-analysis  .
     2398         run cus/abc-run.p (input parparentproc, output s-recid ).
     2399         if num-entries(s-recid) <> 2 THEN DO:
     2400           message "Для данного метода расчета надо выбрать 2 анализа" view-as alert-box information .
     2401           return no-apply.
     2402         END.
     2403         find first abc-analysis  where recid(abc-analysis) = int(entry(1,s-recid)) no-lock no-error .
     2404         if available abc-analysis and not error-status :error  then do:
     2405           v-p-code = abc-analysis.abc-id .
     2406           display ( abc-analysis.abc-name  + " от " +  string(abc-analysis.abc-date-create, "99/99/9999")) @ ub.tmp-sale.desc_
     2407                     with frame Dialog-Frame .
     2408                     v-name = "1." + ( abc-analysis.abc-name + " от " + string(abc-analysis.abc-date-create, "99/99/9999")) .
     2409          end.
     2410         if num-entries(s-recid) > 1 then do:
     2411             find first buf_abc-analysis  where recid(buf_abc-analysis) = int(entry(2,s-recid)) no-lock no-error .
     2412             rr = ? .
     2413             if available buf_abc-analysis and not error-status :error  then do:
     2414               display ( buf_abc-analysis.abc-name  + " от " +  string(buf_abc-analysis.abc-date-create, "99/99/9999")) @  ub.tmp-sale.tmp-code
     2415                         with frame Dialog-Frame .
     2416                         v-name = v-name + " 2." + ( buf_abc-analysis.abc-name  + " от " +  string(buf_abc-analysis.abc-date-create, "99/99/9999")) .
     2417               end.
     2418         end.
     2419     end.
     2420     else do:
     2421         run ref/tmp-sale.w
     2422           (input parparentproc
     2423           ,input "b-sel"
     2424           ,output t-recid
     2425           ).
     2426         find first ub.tmp-sale  where recid(ub.tmp-sale) = int(t-recid) no-lock no-error .
     2427         rr = t-recid.
     2428         if available  ub.tmp-sale and not error-status :error  then
     2429           display  ub.tmp-sale.tmp-code
     2430                    ub.tmp-sale.desc_
     2431                    with frame Dialog-Frame .
     2432           else do:
     2433           display "" @ ub.tmp-sale.tmp-code
     2434                   "" @ ub.tmp-sale.desc_
     2435                    with frame Dialog-Frame .
     2436           end.
     2437         end.
     2438   END.
     2439   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     2440   DO:
     2441   define variable p-code as character no-undo .
     2442   define variable p-desc as character no-undo .
     2443   define variable obj-jj as integer no-undo .
     2444   define variable Ret as logical no-undo .
     2445   define variable t-type as character no-undo .
     2446   define variable loc-sum-min as decimal no-undo .
     2447   Assign frame Dialog-Frame R-algoritm p-neg-sale R-min-rest T-gar r-min-rest3 T-min-ost R-algoritm2 T-min-zapas  t-way T-clos t-rv t-rvc T-rcv t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 v-round-m p-prt-art FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 FILL-IN-15 FILL-IN-13 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-7 FILL-IN-8 FILL-IN-16  no-error .
     2448   Assign frame Dialog-Frame v-round-base no-error .
     2449   if date-p-1 <> ? and date-p-2 <> ? then do:
     2450      if date-p-1 >  date-p-2 then do:
     2451                                    message "Не верно задан интервал дат для расчета обьема продаж !"
     2452                                    view-as alert-box information.
     2453                                    return no-apply .
     2454                                   end.
     2455   end.
     2456   if (t-rv      = false  and
     2457       t-rvz     = false  and
     2458       t-rvc     = false  and
     2459       t-rvzc    = false  and
     2460       t-sp      = false  and
     2461       t-sppv-2  = false  and
     2462       t-sppv-3  = false  and
     2463       t-sppv-4  = false ) and
     2464       ( R-algoritm <> 2  and R-algoritm <> 6  and  R-algoritm <> 5)  then do:
     2465        message  " Не выбран ни один тип документа, по которым рассчитывается обьем продаж !"
     2466        view-as alert-box information.
     2467        return no-apply .
     2468   end.
     2469   if v-round-m = 'Кол-во_в_коробке':U then do:
     2470      for each  tmp#zakaz :
     2471          if tmp#zakaz.cli-base-rate <> 1 then do:
     2472           message
     2473             substitute("При методе округления до числа в упаковке не учитывается ед.измерения Поставщика.
     2474             &3Измените ед.изм. поставщика в заказе у товара
     2475             &3артикул &1 код &2
     2476             &3на &4"
     2477             , tmp#zakaz.artic, tmp#zakaz.gds-code, chr(10) , tmp#zakaz.unit-base)
     2478             view-as alert-box information.
     2479             return no-apply.
     2480          end.
     2481      end.
     2482   end.
     2483   if t-way:visible = false then t-way = false .
     2484   if t-way = false then
     2485   assign
     2486     t-clos  = false
     2487     t-rcv   = false
     2488   .
     2489   if NOT ( t-way = true and  ( t-clos  = true  or  t-rcv  = true  )
     2490            or
     2491            t-way = false )
     2492   then do:
     2493   message "При учете предыдущих заказов надо выбрать хотя бы один статус !"
     2494     view-as alert-box information.
     2495      return no-apply.
     2496   end.
     2497   if t-way:visible = false then t-way = false .
     2498   if R-algoritm2 = 3 and R-algoritm2:visible  and not can-find (  first  tt-date  )  then do:
     2499   message "При календарном методе расчета должна быть заполнена таблица - даты"
     2500     view-as alert-box information.
     2501   return no-apply.
     2502   end.
     2503   if  R-algoritm = 2 then do:
     2504   if not available ub.tmp-sale then
     2505      find ub.tmp-sale  where recid(ub.tmp-sale) = rr no-lock no-error  .
     2506       if available ub.tmp-sale then
     2507           assign
     2508               p-code = ub.tmp-sale.tmp-code
     2509               p-desc = ub.tmp-sale.desc_
     2510               .
     2511   end.
     2512   if  R-algoritm = 2  and ( ub.tmp-sale.tmp-code:screen-value in frame Dialog-Frame = ? OR ub.tmp-sale.tmp-code:screen-value in frame Dialog-Frame = "" ) then do:
     2513       message "Не выбран список темпов продаж!!!"
     2514       view-as alert-box information.
     2515       return no-apply.
     2516   end.
     2517   if  R-algoritm = 6  then do:
     2518       assign
     2519           p-code = ?
     2520           p-desc = v-name
     2521       .
     2522   end.
     2523   if v-mode <> "all-ord":U then dO:
     2524      run ord-mm in this-procedure .
     2525   end.
     2526   e-method =  FILL-IN-17 + " : " + entry(R-algoritm * 2 - 1 , R-algoritm:RADIO-BUTTONS)   +
     2527              (  if R-algoritm = 2 or R-algoritm = 6 then ( " : " +  p-desc   + chr(10)) else "" ) +  ";" .
     2528   if R-algoritm <> 2  and R-algoritm <> 5 and  R-algoritm <> 6 then
     2529   e-method =  e-method  +  FILL-IN-15 + " : " + entry(R-algoritm2 * 2 - 1 , R-algoritm2:RADIO-BUTTONS) +  ";" + chr(10) +
     2530              (  if date-p-1 <> ? and R-algoritm <> 2 and R-algoritm <> 6 and R-algoritm <> 5 then "c  "  + string(date-p-1,"99/99/9999") else " " ) +
     2531              (  if date-p-2 <> ? and R-algoritm <> 2 and R-algoritm <> 6 and R-algoritm <> 5 then " по " + string(date-p-2,"99/99/9999") else " " ) +  ";" +  chr(10) +
     2532              (  if t-1 then " " + b-1:label   else "" ) +
     2533              (  if t-2 then " " + b-2:label   else "" ) +
     2534              (  if t-3 then " " + b-3:label   else "" ) +
     2535              (  if t-4 then " " + b-4:label   else "" ) +
     2536              (  if t-5 then " " + b-5:label   else "" ) +
     2537              (  if t-6 then " " + b-6:label   else "" ) +
     2538              (  if t-7 then " " + b-7:label   else "" ) .
     2539   e-method =  e-method  +      ";" +  chr(10) +
     2540              FILL-IN-2 + " : " + entry(R-min-rest * 2 - 1 , R-min-rest:RADIO-BUTTONS)  .
     2541    e-method = e-method +   chr(10) +
     2542            ( if  r-min-rest3    then  " : " + r-min-rest3:label  else "" ) + ";" .
     2543    e-method = e-method +   chr(10)   +
     2544            ( if  FILL-IN-14:visible             then  FILL-IN-14 + " : "     else "" ) +
     2545            ( if  t-rv     and t-rv:visible      then  " " + t-rv  :label     else "" ) +
     2546            ( if  t-rvz    and t-rvz:visible     then  " " + t-rvz :label     else "" ) +
     2547            ( if  t-rvc    and t-rvc:visible     then  " " + t-rvc :label     else "" ) +
     2548            ( if  t-rvzc   and t-rvzc:visible    then  " " + t-rvzc:label     else "" ) +
     2549            ( if  t-sp     and t-sp:visible      then  " " + t-sp  :label     else "" ) +
     2550            ( if  t-sppv-2 and t-sppv-2:visible  then  " " + t-sppv-2:label   else "" ) +
     2551            ( if  t-sppv-3 and t-sppv-3:visible  then  " " + t-sppv-3:label   else "" ) +
     2552            ( if  t-sppv-4 and t-sppv-4:visible  then  " " + t-sppv-4:label   else "" )
     2553              .
     2554    e-method = e-method +   chr(10) +
     2555            ( if  t-way    and t-way:visible   then  " " + t-way  :label + " : "    else "" ) +
     2556            ( if  t-rcv    and t-rcv:visible   then  " " + t-rcv  :label            else "" ) +
     2557            ( if  t-clos   and t-clos:visible  then  " " + t-clos :label            else "" ) + ";"
     2558            .
     2559    e-method = e-method +   chr(10) +
     2560            ( if  p-neg-sale  and  p-neg-sale:visible   then  " " + p-neg-sale  :tooltip + " : "    else "" ) +
     2561            ( if  t-gar       and  t-gar:visible        then  " " + t-gar  :tooltip            else "" ) +
     2562            ( if  t-min-ost   and  t-min-ost:visible    then  " " + t-min-ost  :tooltip + " : "    else "" ) +
     2563            ( if  t-min-zapas and  t-min-zapas:visible  then  " " + t-min-zapas :tooltip            else "" ) + ";"
     2564            .
     2565    e-method = e-method +  chr(10) + "Объекты :&"  .
     2566             for each obj-list :
     2567                     e-method = e-method +  obj-list.obj-type + " " + string(obj-list.obj-code) + ","    .
     2568             end.
     2569    if v-mode <> "all-ord":U and v-mode <> "auto-ord" then dO:
     2570         find first buf_usr-flt  exclusive-lock  where
     2571                 buf_usr-flt.user-name    = loc-ord-num and
     2572                 buf_usr-flt.call-point   = "ord-m":U + ( if v-mode <> ? then v-mode else "" )  no-error .
     2573             if NOT available buf_usr-flt then  create buf_usr-flt.
     2574             find first ub.tmp-sale where recid(ub.tmp-sale) = rr  no-lock no-error .
     2575               Assign
     2576                 buf_usr-flt.user-name    = loc-ord-num
     2577                 buf_usr-flt.call-point   = "ord-m":U + ( if v-mode <> ? then v-mode else "" )
     2578                 buf_usr-flt.list_ = "".
     2579                 run remember-screen ( input-output buf_usr-flt.list_ ).
     2580         find first buf_usr-flt  exclusive-lock  where
     2581                 buf_usr-flt.user-name    = g#userid and
     2582                 buf_usr-flt.call-point   = "ord-m":U  no-error .
     2583             if NOT available buf_usr-flt then  create buf_usr-flt.
     2584               Assign
     2585                 buf_usr-flt.user-name    = g#userid
     2586                 buf_usr-flt.call-point   = "ord-m":U
     2587                 buf_usr-flt.list_ = "".
     2588                 run remember-screen ( input-output buf_usr-flt.list_ ).
     2589         t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2590             for each obj-list :
     2591               obj-jj = obj-jj + 1.
     2592             end.
     2593             if g#type = 'ФП':U and R-min-rest = 1 then  do:
     2594                if R-algoritm = 6  then do:
     2595                   run cus/qnty-obj.p
     2596                   (     input parParentProc,
     2597                         input v-round-m ,
     2598                         input v-round-base ,
     2599                         input e-method ,
     2600                         input v-mode,
     2601                         input loc-ord-num ,
     2602                         input date-p-1,
     2603                         input date-p-2,
     2604                         input "calc":U,
     2605                         input no,
     2606                         input 2  ,
     2607                         input R-algoritm2,
     2608                         input R-min-rest ,
     2609                         input R-min-rest3,
     2610                         input p-code     ,
     2611                         input t-rv       ,
     2612                         input t-rvz      ,
     2613                         input t-rvc      ,
     2614                         input t-rvzc  ,
     2615                         input t-sp    ,
     2616                         input t-sppv-2  ,
     2617                         input t-sppv-2,
     2618                         input t-sppv-3,
     2619                         input t-sppv-4,
     2620                         input t-way   ,
     2621                         input t-rcv   ,
     2622                         input t-clos  ,
     2623                         input table tt-date ,
     2624                         input table temp-abc-day ,
     2625                         input p-neg-sale  ,
     2626                         input t-gar       ,
     2627                         input t-min-zapas ,
     2628                         input t-min-ost   ,
     2629                         input store-type  ,
     2630                         input store-code  ,
     2631                         input g#type      ,
     2632                         input no
     2633                         ) no-error .
     2634                end.
     2635                else do:
     2636                   run cus/qnty-obj.p
     2637                   (     input parParentProc,
     2638                         input v-round-m ,
     2639                         input v-round-base ,
     2640                         input e-method ,
     2641                         input v-mode,
     2642                         input loc-ord-num ,
     2643                         input date-p-1,
     2644                         input date-p-2,
     2645                         input "calc":U,
     2646                         input no,
     2647                         input R-algoritm  ,
     2648                         input R-algoritm2,
     2649                         input R-min-rest ,
     2650                         input R-min-rest3,
     2651                         input p-code     ,
     2652                         input t-rv       ,
     2653                         input t-rvz      ,
     2654                         input t-rvc      ,
     2655                         input t-rvzc  ,
     2656                         input t-sp    ,
     2657                         input t-sppv-2  ,
     2658                         input t-sppv-2,
     2659                         input t-sppv-3,
     2660                         input t-sppv-4,
     2661                         input t-way   ,
     2662                         input t-rcv   ,
     2663                         input t-clos  ,
     2664                         input table tt-date ,
     2665                         input table temp-abc-day-empty ,
     2666                         input p-neg-sale    ,
     2667                         input t-gar         ,
     2668                         input t-min-zapas ,
     2669                         input t-min-ost ,
     2670                         input store-type  ,
     2671                         input store-code  ,
     2672                         input g#type     ,
     2673                         input no
     2674                         ) no-error .
     2675                end.
     2676                 if error-status :error then do:
     2677                   message  error-status :get-message(1) .
     2678                   error-status :error = false.
     2679                 end.
     2680             end.
     2681             else  do:
     2682                if R-algoritm = 6  then do:
     2683                   run cus/qntysale.p
     2684                     ( input parParentProc,
     2685                       input v-round-m ,
     2686                       input v-round-base ,
     2687                       input e-method ,
     2688                       input v-mode,
     2689                       input loc-ord-num ,
     2690                       input date-p-1,
     2691                       input date-p-2,
     2692                       input "calc":U,
     2693                       input no,
     2694                       input 2 ,
     2695                       input R-algoritm2,
     2696                       input R-min-rest,
     2697                       input R-min-rest3,
     2698                       input p-code,
     2699                       input t-rv,
     2700                       input t-rvz,
     2701                       input t-rvc ,
     2702                       input t-rvzc ,
     2703                       input t-sp   ,
     2704                       input t-sppv-2 ,
     2705                       input t-sppv-2,
     2706                       input t-sppv-3,
     2707                       input t-sppv-4,
     2708                       input t-way,
     2709                       input t-rcv,
     2710                       input t-clos,
     2711                       input table tt-date ,
     2712                       input table temp-abc-day ,
     2713                       input p-neg-sale,
     2714                       input t-gar,
     2715                       input t-min-zapas ,
     2716                       input t-min-ost ,
     2717                       input store-type  ,
     2718                       input store-code  ,
     2719                       input g#type    ,
     2720                       input no
     2721                       ) no-error .
     2722                end.
     2723                else do:
     2724                   run cus/qntysale.p
     2725                     ( input parParentProc,
     2726                       input v-round-m ,
     2727                       input v-round-base ,
     2728                       input e-method ,
     2729                       input v-mode,
     2730                       input loc-ord-num ,
     2731                       input date-p-1,
     2732                       input date-p-2,
     2733                       input "calc":U,
     2734                       input no,
     2735                       input R-algoritm ,
     2736                       input R-algoritm2,
     2737                       input R-min-rest,
     2738                       input R-min-rest3,
     2739                       input p-code,
     2740                       input t-rv,
     2741                       input t-rvz,
     2742                       input t-rvc ,
     2743                       input t-rvzc ,
     2744                       input t-sp   ,
     2745                       input t-sppv-2 ,
     2746                       input t-sppv-2,
     2747                       input t-sppv-3,
     2748                       input t-sppv-4,
     2749                       input t-way,
     2750                       input t-rcv,
     2751                       input t-clos,
     2752                       input table tt-date ,
     2753                       input table temp-abc-day-empty ,
     2754                       input p-neg-sale,
     2755                       input t-gar,
     2756                       input t-min-zapas ,
     2757                       input t-min-ost ,
     2758                       input store-type  ,
     2759                       input store-code  ,
     2760                       input g#type  ,
     2761                       input no
     2762                       ) no-error .
     2763                end.
     2764                 if error-status :error then do:
     2765                   message error-status :get-message(1) .
     2766                   error-status :error = false   .
     2767                 end.
     2768             end.
     2769             if  G#type <> 'ОО':U and
     2770                 G#type <> 'ОР':U
     2771             then run calc-sum-vat in this-procedure .
     2772             if v-mode = ? then do:
     2773                 for each tmp#zakaz:
     2774                     find first shar_ord-line  exclusive-lock  where
     2775                           shar_ord-line.doc-code  = loc-ord-num and
     2776                           shar_ord-line.artic     = tmp#zakaz.artic and
     2777                           shar_ord-line.prod-type = tmp#zakaz.prod-type and
     2778                           shar_ord-line.prod-code = tmp#zakaz.prod-code no-error  .
     2779                     if available shar_ord-line then do:
     2780                       BUFFER-COPY tmp#zakaz  to  shar_ord-line .
     2781                     end.
     2782                 end.
     2783             end.
     2784    end.
     2785    if v-mode = "auto-ord" then do:
     2786      run remember-screen ( input-output p-return ).
     2787    end.
     2788   t-ret =  session:SET-WAIT-STATE("") .
     2789   END.
     2790   ON CHOOSE OF BUTTON-obj IN FRAME Dialog-Frame
     2791   DO:
     2792     assign SelectObject.
     2793     my-request = false .
     2794     run select-objects-proc in this-procedure (input e-method).
     2795   END.
     2796   ON VALUE-CHANGED OF p-prt-art IN FRAME Dialog-Frame
     2797   DO:
     2798   assign
     2799     p-prt-art
     2800   .
     2801    v-show-all-goods = p-prt-art .
     2802   END.
