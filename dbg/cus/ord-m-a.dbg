     4520         v-curr-sv-date = date(self :screen-value) no-error
     4521       .
     4522       if v-curr-sv-date = ?
     4523       then do:
     4524         run gbl/getcurdt.p
     4525           (output v-curr-sv-date
     4526           ) .
     4527       end.
     4528       if v-curr-sv-date <> ?
     4529       then do:
     4530         run gbl/d-inpday.w
     4531           (input ?
     4532           ,input "Выбор даты"
     4533           ,input v-description
     4534           ,input ""
     4535           ,input-output v-curr-sv-date
     4536           ,output v-ok
     4537           ).
     4538         if v-ok = true
