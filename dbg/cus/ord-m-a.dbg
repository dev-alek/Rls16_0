     1401   procedure userobjs_clear :
     1402     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       for each buf_userobjs_temp-user-obj
     1407       on error undo, return error return-value
     1408       :
     1409         delete buf_userobjs_temp-user-obj .
     1410       end.
     1411     end.
     1412   end .
     1413   procedure userobjs_object-count :
     1414     define output parameter p-total-count as integer   no-undo .
     1415     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       assign
     1420         p-total-count = 0
     1421       .
     1422       for each buf_userobjs_temp-user-obj
     1423       on error undo, return error return-value
     1424       :
     1425         assign
     1426           p-total-count = p-total-count + 1
     1427         .
     1428       end.
     1429     end.
     1430   end.
     1431   procedure userobjs_append :
     1432      define input  parameter p-obj-type as character no-undo .
     1433      define input  parameter p-obj-code as integer   no-undo .
     1434     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       find first buf_userobjs_temp-user-obj
     1439         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1440           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1441         no-error .
     1442       if not available buf_userobjs_temp-user-obj
     1443       then do:
     1444         create buf_userobjs_temp-user-obj .
     1445         assign
     1446           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1447           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1448         .
     1449       end.
     1450     end.
     1451   end.
     1452   procedure userobjs_object-exist :
     1453     define output parameter p-object-exist as logical   no-undo .
     1454     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1455     do
     1456     on error undo, return error return-value
     1457     :
     1458       find first buf_userobjs_temp-user-obj
     1459         no-error .
     1460       if not available buf_userobjs_temp-user-obj
     1461       then do:
     1462         assign
     1463           p-object-exist = false
     1464         .
     1465       end.
     1466       else do:
     1467         assign
     1468           p-object-exist = true
     1469         .
     1470       end.
     1471     end.
     1472   end.
     1473   procedure userobjs_transfer :
     1474     define input  parameter p-callback-handle as handle no-undo .
     1475     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1476     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1477     do
     1478     on error undo, return error return-value
     1479     :
     1480       if valid-handle(p-callback-handle) <> true
     1481       then do:
     1482         message
     1483           vss-workfile vss-revision vss-description skip
     1484           "Ошибка задания входных параметров" skip
     1485           "Неизвестный указатель на процедуру" skip
     1486           view-as alert-box error .
     1487         undo, return error return-value .
     1488       end.
     1489       if p-callback-handle :get-signature("userobjs_append") = ""
     1490       then do:
     1491         message
     1492           vss-workfile vss-revision vss-description skip
     1493           "Ошибка задания входных параметров" skip
     1494           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1495                     ,p-callback-handle :file-name
     1496                     ) skip
     1497           view-as alert-box error .
     1498         undo, return error return-value .
     1499       end.
     1500       for each buf_userobjs_temp-user-obj
     1501       on error undo, return error return-value
     1502       :
     1503         run userobjs_append in p-callback-handle
     1504           (input  buf_userobjs_temp-user-obj.obj-type
     1505           ,input  buf_userobjs_temp-user-obj.obj-code
     1506           ) .
     1507       end.
     1508     end.
     1509   end procedure.
