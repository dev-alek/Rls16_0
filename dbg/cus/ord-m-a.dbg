     1201   function diff-list returns character (
     1202     input parfirst-list  as character,
     1203     input parsecond-list as character,
     1204     input pardelim       as character).
     1205     if pardelim = ""
     1206     or pardelim = ?
     1207     then do:
     1208       assign
     1209         pardelim = ","
     1210       .
     1211     end.
     1212     def var ind as integer no-undo .
     1213     def var v-elem as character no-undo .
     1214     def var v-result-list as character no-undo init "".
     1215     def var v-num-parfirst-list as integer no-undo .
     1216     assign
     1217       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1218     .
     1219     do ind = 1 to v-num-parfirst-list
     1220     :
     1221       assign
     1222         v-elem = entry(ind, parfirst-list, pardelim)
     1223       .
     1224       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1225         assign
     1226           v-result-list = v-result-list
     1227                         + (if v-result-list > "" then pardelim else "")
     1228                         + v-elem
     1229         .
     1230       end.
     1231     end.
     1232     return v-result-list .
     1233   end function.
     1234   function add-list returns character (
     1235    input parfirst-list  as character,
     1236    input parsecond-list as character,
     1237    input pardelim       as character).
     1238     if pardelim = ""
     1239     or pardelim = ?
     1240     then do:
     1241       assign
     1242         pardelim = ","
     1243       .
     1244     end.
     1245     def var ind as integer no-undo .
     1246     def var v-elem as character no-undo .
     1247     def var v-result-list as character no-undo init "".
     1248     def var v-num-parfirst-list as integer no-undo .
     1249     assign
     1250       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1251     .
     1252     do ind = 1 to v-num-parfirst-list
     1253     :
     1254       assign
     1255         v-elem = entry(ind, parfirst-list, pardelim)
     1256       .
     1257       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1258         assign
     1259           v-result-list = v-result-list
     1260                         + (if v-result-list > "" then pardelim else "")
     1261                         + v-elem
     1262         .
     1263       end.
     1264     end.
     1265     def var v-num-parsecond-list as integer no-undo .
     1266     assign
     1267       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1268     .
     1269     do ind = 1 to v-num-parsecond-list
     1270     :
     1271       assign
     1272         v-elem = entry(ind, parsecond-list, pardelim)
     1273       .
     1274       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1275         assign
     1276           v-result-list = v-result-list
     1277                         + (if v-result-list > "" then pardelim else "")
     1278                         + v-elem
     1279         .
     1280       end.
     1281     end.
     1282     return v-result-list .
     1283   end function.
     1284   function cross-list returns character (
     1285    input parfirst-list  as character,
     1286    input parsecond-list as character,
     1287    input pardelim       as character).
     1288     if pardelim = ""
     1289     or pardelim = ?
     1290     then do:
     1291       assign
     1292         pardelim = ","
     1293       .
     1294     end.
     1295     def var ind as integer no-undo .
     1296     def var v-elem as character no-undo .
     1297     def var v-result-list as character no-undo init "".
     1298     def var v-num-parfirst-list as integer no-undo .
     1299     assign
     1300       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1301     .
     1302     do ind = 1 to v-num-parfirst-list
     1303     :
     1304       assign
     1305         v-elem = entry(ind, parfirst-list, pardelim)
     1306       .
     1307       if lookup(v-elem, v-result-list, pardelim) = 0
     1308       and lookup(v-elem, parsecond-list, pardelim) > 0
     1309       then do:
     1310         assign
     1311           v-result-list = v-result-list
     1312                         + (if v-result-list > "" then pardelim else "")
     1313                         + v-elem
     1314         .
     1315       end.
     1316     end.
     1317     return v-result-list .
     1318   end function.
     1319   function radio-label returns character (
     1320    input par-rs-value  as character,
     1321    input par-rs-radio-buttons as character)
     1322    .
     1323    DEFINE variable v-result-label as character no-undo.
     1324    assign
     1325    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1326                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1327                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1328                             ), par-rs-radio-buttons
     1329                           )
     1330    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1331    .
     1332   return v-result-label.
     1333   end function.
     1334   function m-radio-label returns character (
     1335    input par-rs-value  as character,
     1336    input par-rs-radio-buttons as character,
     1337    input par-delim as character
     1338    )
     1339    .
     1340    DEFINE variable v-result-label as character no-undo.
     1341    assign
     1342    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1343                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1344                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1345                             ), par-rs-radio-buttons, par-delim
     1346                           )
     1347    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1348    .
     1349   return v-result-label.
     1350   end function.
     1351   FUNCTION mixlist returns character
     1352   (
     1353    input parfirst-list  as character
     1354    ,input parsecond-list as character
     1355    ,input pardelim       as character
     1356    ,input pardelim-result as character ) :
     1357     if pardelim = ""
     1358     or pardelim = ?
     1359     then do:
     1360       assign
     1361         pardelim = ","
     1362       .
     1363     end.
     1364     def var ind as integer no-undo .
     1365     def var v-elem1 as character no-undo .
     1366     def var v-elem2 as character no-undo .
     1367     def var v-result-list as character no-undo init "".
     1368     do ind = 1 to num-entries(parfirst-list, pardelim)
     1369     :
     1370       assign
     1371         v-elem1 = entry(ind, parfirst-list, pardelim)
     1372         v-elem2 = entry(ind, parsecond-list, pardelim)
     1373       .
     1374         assign
     1375           v-result-list = v-result-list
     1376                         + (if v-result-list > "" then pardelim-result else "")
     1377                         + v-elem1 + pardelim-result + v-elem2
     1378         .
     1379     end.
     1380     return v-result-list .
     1381   END FUNCTION.
