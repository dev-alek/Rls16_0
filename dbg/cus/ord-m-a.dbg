     2846     DO:   assign frame Dialog-Frame   T-sppv-4 .   display T-sppv-4  with FRAME Dialog-Frame  .  END.
     2847   END.
     2848   ON VALUE-CHANGED OF t-way IN FRAME Dialog-Frame
     2849   DO:
     2850     run v-c-way in this-procedure .
     2851   END.
     2852   ON VALUE-CHANGED OF v-round-m IN FRAME Dialog-Frame
     2853   DO:
     2854     ASSIGN v-round-m .
     2855     if lookup ( v-round-m , 'Произвольно':U ) > 0 then do:
     2856        enable  v-round-base with frame Dialog-Frame .
     2857        display v-round-base with frame Dialog-Frame .
     2858        end.
     2859        else hide v-round-base in frame Dialog-Frame .
     2860   END.
     2861   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2862   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2863   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2864   on help of frame Dialog-Frame
     2865   do:
     2866     run gbl/app_help.p
     2867       (input this-procedure :file-name
     2868       ,input ''
     2869       ,input ?
     2870       ) no-error.
     2871     if error-status :error then do:
     2872       message
     2873         "Ошибка при вызове помощи"
     2874         error-status :get-message(1)
     2875         view-as alert-box .
     2876     end.
     2877   end.
     2878   run minbtn-set in this-procedure .
     2879   on choose of b-help in frame Dialog-Frame
     2880   do:
     2881     apply "help":u to frame Dialog-Frame .
     2882   end.
     2883   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2884   procedure minbtn-set :
     2885       do
     2886           on error undo, return error return-value
     2887           :
     2888           define variable ii              as integer       no-undo .
     2889           define variable fh              as widget-handle no-undo .
     2890           define variable hh              as widget-handle no-undo .
     2891           define variable v-h             as handle        extent 4 no-undo .
     2892           define variable v-name-button   as character     no-undo .
     2893           define variable v-help-old-x    as decimal       no-undo .
     2894           define variable v-help-old-y    as decimal       no-undo .
     2895           define variable v-help-old-size as decimal       no-undo .
     2896           define variable v-frame-width   as decimal       no-undo .
     2897           define variable jj              as integer       no-undo .
     2898           do
     2899               on error undo, return error
     2900               :
     2901               assign
     2902                   v-frame-width = frame Dialog-Frame:width - 0.3
     2903                   fh            = frame Dialog-Frame:first-child
     2904                   hh            = fh:first-child
     2905                   ii            = 1
     2906                   .
     2907               do while valid-handle(hh):
     2908                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2909                   do:
     2910                       case lc(hh:name) :
     2911                           when "b-help" then
     2912                               do:
     2913                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2914                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2915                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2916                                   hh:TOOLTIP = "Помощь" .
     2917                                   v-help-old-x = hh:column .
     2918                                   v-help-old-y = hh:row    .
     2919                                   v-help-old-size = hh:width .
     2920                                   hh:width-chars = 2.5 .
     2921                               end.
     2922                           when "b-print" then
     2923                               do:
     2924                                   hh:load-image("cmp/b-print.bmp":u) .
     2925                                   hh:TOOLTIP = "Печать" .
     2926                                   v-h[ii] = hh:handle .
     2927                                   ii = ii + 1 .
     2928                                   hh:width-chars = 3 .
     2929                               end.
     2930                           when "b-history" or
     2931                           when "b-hist" then
     2932                               do:
     2933                                   hh:load-image("cmp/b-hist.bmp":u) .
     2934                                   hh:TOOLTIP = "История" .
     2935                                   v-h[ii] = hh:handle .
     2936                                   ii = ii + 1 .
     2937                                   hh:width-chars = 3 .
     2938                               end.
     2939                           when "b-sch" then
     2940                               do:
     2941                                   hh:load-image("cmp/b-sch.bmp":u) .
     2942                                   hh:TOOLTIP = "Установка Фильтра" .
     2943                                   v-h[ii] = hh:handle .
     2944                                   ii = ii + 1 .
     2945                                   hh:width-chars = 3 .
     2946                               end.
     2947                           when "b-hist-user" then
     2948                               do:
     2949                                   hh:load-image("cmp/b-hist.bmp":u) .
     2950                                   hh:TOOLTIP = "История пользователя" .
     2951                                   ii = ii + 1 .
     2952                               end.
     2953                       end case.
     2954                   end.
     2955                   hh = hh:next-sibling.
     2956               end.
     2957               b-help:column = v-frame-width - b-help:width-chars.
     2958               jj = 0.
     2959               repeat ii = 4 to 1 by -1 :
     2960                   if valid-handle (v-h[ii] ) then
     2961                   do:
     2962                       jj  = jj + 1 .
     2963                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2964                       v-h[ii]:row    = v-help-old-y .
     2965                   end.
     2966               end.
     2967           end.
     2968       end.
     2969   end procedure.
     2970   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2971   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2972   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2973   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2974   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2975   define variable v-diasize-current-frame-height as decimal   no-undo .
     2976   define variable v-diasize-change-size          as logical   no-undo .
     2977   define variable v-diasize-resize-button        as handle    no-undo .
     2978   define variable v-diasize-wndmax               as logical   no-undo .
     2979   define variable v-diasize-wndstore             as logical   no-undo .
     2980   define variable v-diasize-proc-name            as character no-undo .
     2981   define variable v-diasize-browse-handle        as handle    no-undo .
     2982   define variable v-diasize-browse-number        as integer   no-undo .
     2983   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2984   define temp-table temp-diasize-handle no-undo
     2985     field handle-value  as handle
     2986     field save-position as decimal
     2987     index xpk is primary unique handle-value
     2988     .
     2989   define temp-table temp-browse-handle no-undo
     2990     field browse-type   as character
     2991     field browse-number as integer
     2992     field browse-handle as handle
     2993     field original-size as decimal
     2994     index xpk is primary unique browse-type browse-number
     2995     index xie browse-type browse-handle
     2996   .
     2997   procedure diasize_change-height :
     2998     define input  parameter p-change-value  as decimal   no-undo .
     2999     define input  parameter p-move-resize   as logical   no-undo .
     3000     define variable v-field-group-handle    as handle    no-undo .
     3001     define variable v-object-handle         as handle    no-undo .
     3002     define variable v-frame-height          as decimal   no-undo .
     3003     define variable v-frame-virtual-height  as decimal   no-undo .
     3004     define variable v-browse-height         as decimal   no-undo .
     3005     define variable v-window-height         as decimal   no-undo .
     3006     define variable v-window-virtual-height as decimal   no-undo .
     3007     define variable v-change-sign           as integer   no-undo .
     3008     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3009     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3010     if p-change-value > 0
     3011     then do:
     3012       if frame Dialog-Frame :height + p-change-value
     3013           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3014       then do:
     3015         assign
     3016           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3017                           - (frame Dialog-Frame :height-chars)
     3018         .
     3019         if p-change-value <= 0
     3020         then do:
     3021           run diasize_position-resize-button in this-procedure .
     3022           return .
     3023         end.
     3024       end.
     3025     end.
     3026     if p-change-value < 0
     3027     then do:
     3028       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3029       then do:
     3030         assign
     3031           p-change-value = v-diasize-orig-frame-height
     3032                          - (frame Dialog-Frame :height-chars)
     3033         .
     3034         if p-change-value >= 0
     3035         then do:
     3036           run diasize_position-resize-button in this-procedure .
     3037           return .
     3038         end.
     3039       end.
     3040     end.
     3041     if p-change-value >= 0
     3042     then do:
     3043       assign
     3044         v-change-sign = 1
     3045       .
     3046     end.
     3047     else do:
     3048       assign
     3049         v-change-sign = -1
     3050       .
     3051     end.
     3052     assign
     3053       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3054     .
     3055     if p-change-value = 0
     3056     then do:
     3057       run diasize_position-resize-button in this-procedure .
     3058       return .
     3059     end.
     3060     move_block:
     3061     do
     3062     on error undo move_block, retry move_block
     3063     :
     3064       if retry
     3065       then do:
     3066         do
     3067         on error undo move_block, leave move_block
     3068         :
     3069           if p-change-value > 0
     3070           then do:
     3071             for each buf_temp-diasize-handle
     3072             on error undo, next
     3073             :
     3074               assign
     3075                 v-object-handle = buf_temp-diasize-handle.handle-value
     3076               .
     3077               if v-object-handle <> v-diasize-resize-button
     3078               then do:
     3079                 assign
     3080                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3081                 .
     3082               end.
     3083             end.
     3084             assign
     3085               v-diasize-browse-handle :height = v-browse-height
     3086             .
     3087             for each buf_temp-browse-handle
     3088               where buf_temp-browse-handle.browse-type = 'height':u
     3089             on error undo, next
     3090             :
     3091               assign
     3092                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3093               .
     3094             end.
     3095             assign
     3096               frame Dialog-Frame :height = v-frame-height
     3097             .
     3098             if frame Dialog-Frame :scrollable = true
     3099             then do:
     3100               assign
     3101                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3102               .
     3103             end.
     3104             run diasize_position-resize-button in this-procedure .
     3105           end.
     3106           else do:
     3107             if frame Dialog-Frame :scrollable = true
     3108             then do:
     3109               assign
     3110                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3111               .
     3112             end.
     3113             assign
     3114               frame Dialog-Frame :height = v-frame-height
     3115             .
     3116             assign
     3117               v-diasize-browse-handle :height = v-browse-height
     3118             .
     3119             for each buf_temp-browse-handle
     3120               where buf_temp-browse-handle.browse-type = 'height':u
     3121             on error undo, next
     3122             :
     3123               assign
     3124                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3125               .
     3126             end.
     3127             for each buf_temp-diasize-handle
     3128             on error undo, next
     3129             :
     3130               assign
     3131                 v-object-handle = buf_temp-diasize-handle.handle-value
     3132               .
     3133               if v-object-handle <> v-diasize-resize-button
     3134               then do:
     3135                 assign
     3136                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3137                 .
     3138               end.
     3139             end.
     3140             run diasize_position-resize-button in this-procedure .
     3141           end.
     3142           assign
     3143             v-diasize-change-size = false
     3144           .
     3145           leave move_block .
     3146         end.
     3147       end.
     3148       assign
     3149         v-diasize-need-full-display = true
     3150       .
     3151       if v-diasize-change-size = false
     3152       then do:
     3153         assign
     3154           v-diasize-change-size = true
     3155         .
     3156       end.
     3157       else do:
     3158         return .
     3159       end.
     3160       assign
     3161         v-frame-height = frame Dialog-Frame :height
     3162         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3163         v-browse-height = v-diasize-browse-handle :height
     3164       .
     3165       for each buf_temp-browse-handle
     3166         where buf_temp-browse-handle.browse-type = 'height':u
     3167       :
     3168         assign
     3169           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3170         .
     3171       end.
     3172       for each buf_temp-diasize-handle
     3173       :
     3174         delete buf_temp-diasize-handle .
     3175       end.
     3176       assign
     3177         v-field-group-handle = frame Dialog-Frame :first-child
     3178       .
     3179       do while valid-handle(v-field-group-handle)
     3180       :
     3181         assign
     3182           v-object-handle = v-field-group-handle :first-child
     3183         .
     3184         do while valid-handle(v-object-handle)
     3185         :
     3186           if  v-object-handle <> v-diasize-browse-handle :handle
     3187           and can-query(v-object-handle, "row")
     3188           and can-query(v-object-handle, "height")
     3189           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3190           then do:
     3191             find first buf_temp-browse-handle
     3192               where buf_temp-browse-handle.browse-type   = 'height':u
     3193                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3194               no-error .
     3195             if available buf_temp-browse-handle
     3196             then do:
     3197             end.
     3198             else do:
     3199               create buf_temp-diasize-handle .
     3200               assign
     3201                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3202                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3203               .
     3204             end.
     3205           end.
     3206           assign
     3207             v-object-handle = v-object-handle :next-sibling
     3208           .
     3209         end.
     3210         assign
     3211           v-field-group-handle = v-field-group-handle :next-sibling
     3212         .
     3213       end.
     3214       do with frame Dialog-Frame
     3215       :
     3216         hide v-diasize-resize-button .
     3217         assign
     3218           v-diasize-resize-button :row    = 1
     3219           v-diasize-resize-button :column = 1
     3220         .
     3221       end.
     3222       if p-change-value > 0
     3223       then do:
     3224         if frame Dialog-Frame :scrollable = true
     3225         then do:
     3226           assign
     3227             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3228             no-error .
     3229           if error-status :error
     3230           or error-status :get-message(1) <> ""
     3231           then do:
     3232             undo move_block, retry move_block .
     3233           end.
     3234         end.
     3235         assign
     3236           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3237           no-error .
     3238         if error-status :error
     3239         or error-status :get-message(1) <> ""
     3240         then do:
     3241           undo move_block, retry move_block .
     3242         end.
     3243         assign
     3244           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3245           no-error .
     3246         if error-status :error
     3247         or error-status :get-message(1) <> ""
     3248         then do:
     3249           undo move_block, retry move_block .
     3250         end.
     3251         for each buf_temp-browse-handle
     3252           where buf_temp-browse-handle.browse-type = 'height':u
     3253         on error undo move_block, retry move_block
     3254         :
     3255           assign
     3256             buf_temp-browse-handle.browse-handle :height
     3257               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3258             no-error .
     3259           if error-status :error
     3260           or error-status :get-message(1) <> ""
     3261           then do:
     3262             undo move_block, retry move_block .
     3263           end.
     3264         end.
     3265         for each buf_temp-diasize-handle
     3266         on error undo move_block, retry move_block
     3267         :
     3268           assign
     3269             v-object-handle = buf_temp-diasize-handle.handle-value
     3270           .
     3271           if v-object-handle <> v-diasize-resize-button
     3272           then do:
     3273             assign
     3274               v-object-handle :row = v-object-handle :row + p-change-value
     3275               no-error .
     3276             if error-status :error
     3277             or error-status :get-message(1) <> ""
     3278             then do:
     3279               undo move_block, retry move_block .
     3280             end.
     3281           end.
     3282         end.
     3283       end.
     3284       else do:
     3285         for each buf_temp-diasize-handle
     3286         on error undo move_block, retry move_block
     3287         :
     3288           assign
     3289             v-object-handle = buf_temp-diasize-handle.handle-value
     3290           .
     3291           if v-object-handle <> v-diasize-resize-button
     3292           then do:
     3293             assign
     3294               v-object-handle :row = v-object-handle :row + p-change-value
     3295               no-error .
     3296             if error-status :error
     3297             or error-status :get-message(1) <> ""
     3298             then do:
     3299               undo move_block, retry move_block .
     3300             end.
     3301           end.
     3302         end.
     3303         assign
     3304           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3305           no-error .
     3306         if error-status :error
     3307         or error-status :get-message(1) <> ""
     3308         then do:
     3309           undo move_block, retry move_block .
     3310         end.
     3311         for each buf_temp-browse-handle
     3312           where buf_temp-browse-handle.browse-type = 'height':u
     3313         on error undo move_block, retry move_block
     3314         :
     3315           assign
     3316             buf_temp-browse-handle.browse-handle :height
     3317               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3318             no-error .
     3319           if error-status :error
     3320           or error-status :get-message(1) <> ""
     3321           then do:
     3322             undo move_block, retry move_block .
     3323           end.
     3324         end.
     3325         assign
     3326           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3327           no-error .
     3328         if error-status :error
     3329         or error-status :get-message(1) <> ""
     3330         then do:
     3331           undo move_block, retry move_block .
     3332         end.
     3333         if frame Dialog-Frame :scrollable = true
     3334         then do:
     3335           assign
     3336             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3337             no-error .
     3338           if error-status :error
     3339           or error-status :get-message(1) <> ""
     3340           then do:
     3341             undo move_block, retry move_block .
     3342           end.
     3343         end.
     3344       end.
     3345       if p-move-resize = true
     3346       then do:
     3347         run diasize_position-resize-button in this-procedure .
     3348       end.
     3349       if v-diasize-wndstore = true
     3350       then do:
     3351         if connected("ub") = true
     3352         then do:
     3353           define variable v-cntxt-db-num        as integer   no-undo .
     3354           define variable v-cntxt-userid        as character no-undo .
     3355           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3356                                             , OUTPUT v-cntxt-userid
     3357                                             ) .
     3358           run gbl/wndsizew.p
     3359             (input  v-cntxt-db-num
     3360             ,input  v-cntxt-userid
     3361             ,input  v-diasize-proc-name
     3362             ,input  'height':u
     3363             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3364             ) .
     3365         end.
     3366       end.
     3367     end.
     3368     assign
     3369       v-diasize-change-size = false
     3370     .
     3371   end procedure.
     3372   procedure diasize_set-height :
     3373     define input  parameter p-new-height  as decimal   no-undo .
     3374     define input  parameter p-move-resize as logical   no-undo .
     3375     do
     3376     on error undo, return error return-value
     3377     :
     3378       run diasize_change-height in this-procedure
     3379         (input  (p-new-height - frame Dialog-Frame :height)
     3380         ,input  p-move-resize
     3381         ) .
     3382     end.
     3383   end procedure.
     3384   procedure diasize_change-width :
     3385     define input  parameter p-change-value as decimal   no-undo .
     3386     define input  parameter p-move-resize  as logical   no-undo .
     3387     define variable v-field-group-handle   as handle    no-undo .
     3388     define variable v-object-handle        as handle    no-undo .
     3389     define variable v-frame-width          as decimal   no-undo .
     3390     define variable v-frame-virtual-width  as decimal   no-undo .
     3391     define variable v-browse-width         as decimal   no-undo .
     3392     define variable v-window-width         as decimal   no-undo .
     3393     define variable v-window-virtual-width as decimal   no-undo .
     3394     define variable v-change-sign          as integer   no-undo .
     3395     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3396     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3397     if p-change-value > 0
     3398     then do:
     3399       if frame Dialog-Frame :width + p-change-value >
     3400           session :width-chars
     3401       then do:
     3402         assign
     3403           p-change-value = session :width-chars - frame Dialog-Frame :width
     3404         .
     3405         if p-change-value <= 0
     3406         then do:
     3407           run diasize_position-resize-button in this-procedure .
     3408           return .
     3409         end.
     3410       end.
     3411     end.
     3412     if p-change-value < 0
     3413     then do:
     3414       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3415       then do:
     3416         assign
     3417           p-change-value = v-diasize-orig-frame-width
     3418                          - frame Dialog-Frame :width
     3419         .
     3420         if p-change-value >= 0
     3421         then do:
     3422           run diasize_position-resize-button in this-procedure .
     3423           return .
     3424         end.
     3425       end.
     3426     end.
     3427     if p-change-value >= 0
     3428     then do:
     3429       assign
     3430         v-change-sign = 1
     3431       .
     3432     end.
     3433     else do:
     3434       assign
     3435         v-change-sign = -1
     3436       .
     3437     end.
     3438     assign
     3439       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3440     .
     3441     if p-change-value = 0
     3442     then do:
     3443       run diasize_position-resize-button in this-procedure .
     3444       return .
     3445     end.
     3446     move_block:
     3447     do
     3448     on error undo move_block, leave move_block
     3449     :
     3450       if retry
     3451       then do:
     3452         do
     3453         on error undo move_block, leave move_block
     3454         :
     3455           if p-change-value > 0
     3456           then do:
     3457             for each buf_temp-diasize-handle
     3458             on error undo, next
     3459             :
     3460               assign
     3461                 v-object-handle = buf_temp-diasize-handle.handle-value
     3462               .
     3463               if v-object-handle <> v-diasize-resize-button
     3464               then do:
     3465                 assign
     3466                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3467                 .
     3468               end.
     3469             end.
     3470             assign
     3471               v-diasize-browse-handle :width = v-browse-width
     3472             .
     3473             for each buf_temp-browse-handle
     3474               where buf_temp-browse-handle.browse-type = 'width':u
     3475             on error undo, next
     3476             :
     3477               assign
     3478                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3479               .
     3480             end.
     3481             assign
     3482               frame Dialog-Frame :width = v-frame-width
     3483             .
     3484             if frame Dialog-Frame :scrollable = true
     3485             then do:
     3486               assign
     3487                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3488               .
     3489             end.
     3490             run diasize_position-resize-button in this-procedure .
     3491           end.
     3492           else do:
     3493             if frame Dialog-Frame :scrollable = true
     3494             then do:
     3495               assign
     3496                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3497               .
     3498             end.
     3499             assign
     3500               frame Dialog-Frame :width = v-frame-width
     3501             .
     3502             for each buf_temp-browse-handle
     3503               where buf_temp-browse-handle.browse-type = 'width':u
     3504             on error undo, next
     3505             :
     3506               assign
     3507                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3508               .
     3509             end.
     3510             assign
     3511               v-diasize-browse-handle :width = v-browse-width
     3512             .
     3513             for each buf_temp-diasize-handle
     3514             on error undo, next
     3515             :
     3516               assign
     3517                 v-object-handle = buf_temp-diasize-handle.handle-value
     3518               .
     3519               if v-object-handle <> v-diasize-resize-button
     3520               then do:
     3521                 assign
     3522                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3523                 .
     3524               end.
     3525             end.
     3526             run diasize_position-resize-button in this-procedure .
     3527           end.
     3528           assign
     3529             v-diasize-change-size = false
     3530           .
     3531           leave move_block .
     3532         end.
     3533       end.
     3534       assign
     3535         v-diasize-need-full-display = true
     3536       .
     3537       if v-diasize-change-size = false
     3538       then do:
     3539         assign
     3540           v-diasize-change-size = true
     3541         .
     3542       end.
     3543       else do:
     3544         return .
     3545       end.
     3546       assign
     3547         v-frame-width = frame Dialog-Frame :width
     3548         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3549         v-browse-width = v-diasize-browse-handle :width
     3550       .
     3551       for each buf_temp-browse-handle
     3552         where buf_temp-browse-handle.browse-type = 'width':u
     3553       :
     3554         assign
     3555           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3556         .
     3557       end.
     3558       for each buf_temp-diasize-handle
     3559       :
     3560         delete buf_temp-diasize-handle .
     3561       end.
     3562       assign
     3563         v-field-group-handle = frame Dialog-Frame :first-child
     3564       .
     3565       do while valid-handle(v-field-group-handle)
     3566       :
     3567         assign
     3568           v-object-handle = v-field-group-handle :first-child
     3569         .
     3570         do while valid-handle(v-object-handle)
     3571         :
     3572           if  v-object-handle <> v-diasize-browse-handle :handle
     3573           and v-object-handle <> v-diasize-resize-button
     3574           and can-query(v-object-handle, "row")
     3575           and can-query(v-object-handle, "height")
     3576           and ( v-object-handle :col + v-object-handle :width
     3577                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3578               )
     3579           then do:
     3580             find first buf_temp-browse-handle
     3581               where buf_temp-browse-handle.browse-type   = 'width':u
     3582                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3583               no-error .
     3584             if available buf_temp-browse-handle
     3585             then do:
     3586             end.
     3587             else do:
     3588               create buf_temp-diasize-handle .
     3589               assign
     3590                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3591                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3592               .
     3593             end.
     3594           end.
     3595           assign
     3596             v-object-handle = v-object-handle :next-sibling
     3597           .
     3598         end.
     3599         assign
     3600           v-field-group-handle = v-field-group-handle :next-sibling
     3601         .
     3602       end.
     3603       do with frame Dialog-Frame
     3604       :
     3605         hide v-diasize-resize-button .
     3606         v-diasize-resize-button :row = 1.
     3607         v-diasize-resize-button :column = 1.
     3608       end.
     3609       if p-change-value > 0
     3610       then do:
     3611         if frame Dialog-Frame :scrollable = true
     3612         then do:
     3613           assign
     3614             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3615             no-error .
     3616           if error-status :error
     3617           or error-status :get-message(1) <> ""
     3618           then do:
     3619             undo move_block, retry move_block.
     3620           end.
     3621         end.
     3622         assign
     3623           frame Dialog-Frame :width = v-frame-width + p-change-value
     3624           no-error .
     3625         if error-status :error
     3626         or error-status :get-message(1) <> ""
     3627         then do:
     3628           undo move_block, retry move_block.
     3629         end.
     3630         assign
     3631           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3632         no-error .
     3633         if error-status :error
     3634         or error-status :get-message(1) <> ""
     3635         then do:
     3636           undo move_block, retry move_block.
     3637         end.
     3638         for each buf_temp-browse-handle
     3639           where buf_temp-browse-handle.browse-type = 'width':u
     3640         on error undo move_block, retry move_block
     3641         :
     3642           assign
     3643             buf_temp-browse-handle.browse-handle :width
     3644               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3645             no-error .
     3646           if error-status :error
     3647           or error-status :get-message(1) <> ""
     3648           then do:
     3649             undo move_block, retry move_block .
     3650           end.
     3651         end.
     3652         for each buf_temp-diasize-handle
     3653         on error undo move_block, retry move_block
     3654         :
     3655           assign
     3656             v-object-handle = buf_temp-diasize-handle.handle-value
     3657           .
     3658           if v-object-handle <> v-diasize-resize-button
     3659           then do:
     3660             assign
     3661               v-object-handle :col = v-object-handle :col + p-change-value
     3662               no-error .
     3663             if error-status :error
     3664             or error-status :get-message(1) <> ""
     3665             then do:
     3666               undo move_block, retry move_block .
     3667             end.
     3668           end.
     3669         end.
     3670       end.
     3671       else do:
     3672         for each buf_temp-diasize-handle
     3673         on error undo move_block, retry move_block
     3674         :
     3675           assign
     3676             v-object-handle = buf_temp-diasize-handle.handle-value
     3677           .
     3678           if v-object-handle <> v-diasize-resize-button
     3679           then do:
     3680             assign
     3681               v-object-handle :col = v-object-handle :col + p-change-value
     3682               no-error .
     3683             if error-status :error
     3684             or error-status :get-message(1) <> ""
     3685             then do:
     3686               undo move_block, retry move_block .
     3687             end.
     3688           end.
     3689         end.
     3690         for each buf_temp-browse-handle
     3691           where buf_temp-browse-handle.browse-type = 'width':u
     3692         on error undo move_block, retry move_block
     3693         :
     3694           assign
     3695             buf_temp-browse-handle.browse-handle :width
     3696               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3697             no-error .
     3698           if error-status :error
     3699           or error-status :get-message(1) <> ""
     3700           then do:
     3701             undo move_block, retry move_block .
     3702           end.
     3703         end.
     3704         assign
     3705           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3706           no-error .
     3707         if error-status :error
     3708         or error-status :get-message(1) <> ""
     3709         then do:
     3710           undo move_block, retry move_block.
     3711         end.
     3712         assign
     3713           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3714         no-error .
     3715         if error-status :error
     3716         or error-status :get-message(1) <> ""
     3717         then do:
     3718           undo move_block, retry move_block.
     3719         end.
     3720         if frame Dialog-Frame :scrollable = true
     3721         then do:
     3722           assign
     3723             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3724           no-error .
     3725           if error-status :error
     3726           or error-status :get-message(1) <> ""
     3727           then do:
     3728             undo move_block, retry move_block.
     3729           end.
     3730         end.
     3731       end.
     3732       if p-move-resize
     3733       then do:
     3734         run diasize_position-resize-button in this-procedure .
     3735       end.
     3736       if v-diasize-wndstore = true
     3737       then do:
     3738         if connected("ub") = true
     3739         then do:
     3740           define variable v-cntxt-db-num        as integer   no-undo .
     3741           define variable v-cntxt-userid        as character no-undo .
     3742           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3743                                             , OUTPUT v-cntxt-userid
     3744                                             ) .
     3745           run gbl/wndsizew.p
     3746             (input  v-cntxt-db-num
     3747             ,input  v-cntxt-userid
     3748             ,input  v-diasize-proc-name
     3749             ,input  'width':u
     3750             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3751             ) .
     3752         end.
     3753       end.
     3754     end.
     3755     assign
     3756       v-diasize-change-size = false
     3757     .
     3758   end procedure.
     3759   procedure diasize_set-width :
     3760     define input  parameter p-new-width  as decimal   no-undo .
     3761     define input  parameter p-move-resize as logical   no-undo .
     3762     do
     3763     on error undo, return error return-value
     3764     :
     3765       run diasize_change-width in this-procedure
     3766         (input  (p-new-width - frame Dialog-Frame :width)
     3767         ,input  p-move-resize
     3768         ) .
     3769     end.
     3770   end procedure.
     3771   procedure diasize_position-resize-button :
     3772     do with frame Dialog-Frame
     3773     :
     3774       hide v-diasize-resize-button .
     3775       assign
     3776         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3777                     - 1
     3778                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3779         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3780                     - 1
     3781                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3782       .
     3783       view v-diasize-resize-button .
     3784     end.
     3785   end procedure.
     3786   on alt-right anywhere
     3787   do:
     3788     run diasize_change-width in this-procedure
     3789       (input 1
     3790       ,input true
     3791       ) .
     3792     return no-apply .
     3793   end.
     3794   on alt-left anywhere
     3795   do:
     3796     run diasize_change-width in this-procedure
     3797       (input -1
     3798       ,input true
     3799       ) .
     3800     return no-apply .
     3801   end.
     3802   on alt-down anywhere
     3803   do:
     3804     run diasize_change-height in this-procedure
     3805       (input 1
     3806       ,input true
     3807       ) .
     3808     return no-apply .
     3809   end.
     3810   on alt-up anywhere
     3811   do:
     3812     run diasize_change-height in this-procedure
     3813       (input -1
     3814       ,input true
     3815       ) .
     3816     return no-apply .
     3817   end.
     3818   on alt-enter of frame Dialog-Frame
     3819   do:
     3820     run diasize_maximize in this-procedure
     3821       (input  ?
     3822       ).
     3823     return no-apply .
     3824   end.
     3825   procedure diasize_end-move :
     3826     do
     3827     on error undo, return error return-value
     3828     :
     3829       define variable v-row-delta as decimal   no-undo .
     3830       define variable v-col-delta as decimal   no-undo .
     3831       define variable v-new-row as decimal   no-undo .
     3832       define variable v-new-col as decimal   no-undo .
     3833       assign
     3834         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3835         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3836       .
     3837       assign
     3838         v-row-delta = v-new-row - frame Dialog-Frame :height
     3839         v-col-delta = v-new-col - frame Dialog-Frame :width
     3840       .
     3841       run diasize_change-height in this-procedure
     3842         (input v-row-delta
     3843         ,input true
     3844         ) .
     3845       run diasize_change-width in this-procedure
     3846         (input v-col-delta
     3847         ,input true
     3848         ) .
     3849     end.
     3850   end procedure.
     3851   procedure diasize_maximize :
     3852     define input  parameter p-action as logical   no-undo .
     3853     do
     3854     on error undo, return error return-value
     3855     :
     3856       if p-action = ?
     3857       then do:
     3858         if v-diasize-need-maximize = true
     3859         then do:
     3860           assign
     3861             p-action = true
     3862           .
     3863         end.
     3864         else do:
     3865           assign
     3866             p-action = false
     3867           .
     3868         end.
     3869       end.
     3870       if p-action = true
     3871       then do:
     3872         run diasize_change-height in this-procedure
     3873           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3874               - frame Dialog-Frame :height-chars
     3875           ,input true
     3876           ) .
     3877         run diasize_change-width in this-procedure
     3878           (input session :width-chars
     3879               - frame Dialog-Frame :width-chars
     3880           ,input true
     3881           ) .
     3882         assign
     3883           v-diasize-need-maximize = false
     3884         .
     3885       end.
     3886       else do:
     3887         run diasize_change-width in this-procedure
     3888           (input v-diasize-orig-frame-width
     3889               - frame Dialog-Frame :width-chars
     3890           ,input true
     3891           ) .
     3892         run diasize_change-height in this-procedure
     3893           (input v-diasize-orig-frame-height
     3894               - frame Dialog-Frame :height-chars
     3895           ,input true
     3896           ) .
     3897         assign
     3898           v-diasize-need-maximize = true
     3899         .
     3900       end.
     3901     end.
     3902   end procedure.
     3903   procedure diasize_restore-orig-size :
     3904     do
     3905     on error undo, return error return-value
     3906     :
     3907       assign
     3908         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3909         v-diasize-current-frame-height = frame Dialog-Frame :height
     3910       .
     3911       run diasize_set-height in this-procedure
     3912         (input  v-diasize-orig-frame-height
     3913         ,input  true
     3914         ) .
     3915       run diasize_set-width in this-procedure
     3916         (input  v-diasize-orig-frame-width
     3917         ,input  true
     3918         ) .
     3919     end.
     3920   end procedure.
     3921   procedure diasize_restore-current-size :
     3922     do
     3923     on error undo, return error return-value
     3924     :
     3925       run diasize_set-height in this-procedure
     3926         (input  v-diasize-current-frame-height
     3927         ,input  true
     3928         ) .
     3929       run diasize_set-width in this-procedure
     3930         (input  v-diasize-current-frame-width
     3931         ,input  true
     3932         ) .
     3933     end.
     3934   end procedure.
     3935   procedure diasize_set-browse-handle :
     3936     define input  parameter p-browse-handle as handle   no-undo .
     3937     define buffer buf_temp-browse-handle for temp-browse-handle .
     3938     do
     3939     on error undo, return error return-value
     3940     :
     3941       assign
     3942         v-diasize-browse-handle = p-browse-handle
     3943       .
     3944       for each buf_temp-browse-handle
     3945       on error undo, return error return-value
     3946       :
     3947         delete buf_temp-browse-handle .
     3948       end.
     3949     end.
     3950   end procedure.
     3951   procedure diasize_add_browse :
     3952     define input  parameter p-browse-type   as character no-undo .
     3953     define input  parameter p-browse-handle as handle    no-undo .
     3954     define buffer buf_temp-browse-handle for temp-browse-handle .
     3955     do
     3956     on error undo, return error return-value
     3957     :
     3958       assign
     3959         v-diasize-browse-number = v-diasize-browse-number + 1
     3960       .
     3961       create buf_temp-browse-handle .
     3962       assign
     3963         buf_temp-browse-handle.browse-type   = p-browse-type
     3964         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3965         buf_temp-browse-handle.browse-handle = p-browse-handle
     3966       .
     3967     end.
     3968   end procedure.
     3969   procedure diasize_init :
     3970     define variable v-default-value    as logical   no-undo .
     3971     define variable v-restore-saved    as logical   no-undo .
     3972     define variable v-resize-value-str as character no-undo .
     3973     do
     3974     on error undo, return error return-value
     3975     :
     3976       do with frame Dialog-Frame
     3977       :
     3978         assign
     3979           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3980           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3981           v-diasize-browse-handle     = browse BR-obj-list :handle
     3982         .
     3983         create button v-diasize-resize-button
     3984         assign
     3985           parent        = frame Dialog-Frame :first-child
     3986           label         = "s"
     3987           height-pixels = 16
     3988           width-pixels  = 16
     3989           visible       = true
     3990           sensitive     = true
     3991           movable       = true
     3992           triggers:
     3993             on end-move persistent run diasize_end-move in this-procedure .
     3994           end triggers.
     3995         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3996         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3997         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3998         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3999         assign
     4000           v-diasize-wndmax = false
     4001         .
     4002         if connected("ub") = true
     4003         then do:
     4004           define variable v-cntxt-db-num        as integer   no-undo .
     4005           define variable v-cntxt-userid        as character no-undo .
     4006           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4007                                             , OUTPUT v-cntxt-userid
     4008                                             ) .
     4009           run gbl/wndpar_r.p
     4010             (input  v-cntxt-db-num
     4011             ,input  v-cntxt-userid
     4012             ,input  'wndmax':U
     4013             ,output v-diasize-wndmax
     4014             ,output v-default-value
     4015             ) .
     4016         end.
     4017         assign
     4018           v-diasize-wndstore = false
     4019         .
     4020         if connected("ub") = true
     4021         then do:
     4022           run gbl/wndpar_r.p
     4023             (input  v-cntxt-db-num
     4024             ,input  v-cntxt-userid
     4025             ,input  'wndstore':U
     4026             ,output v-diasize-wndstore
     4027             ,output v-default-value
     4028             ) .
     4029         end.
     4030         assign
     4031           v-diasize-proc-name = entry(1, program-name(2), '.')
     4032         .
     4033         if v-diasize-wndstore = true
     4034         then do:
     4035           assign
     4036             v-restore-saved = false
     4037           .
     4038           if connected("ub") = true
     4039           then do:
     4040             run gbl/wndsizer.p
     4041               (input  v-cntxt-db-num
     4042               ,input  v-cntxt-userid
     4043               ,input  v-diasize-proc-name
     4044               ,input  'height':u
     4045               ,output v-resize-value-str
     4046               ) .
     4047             if v-resize-value-str <> '':U
     4048             then do:
     4049               run diasize_change-height in this-procedure
     4050                 (input  integer(v-resize-value-str)
     4051                 ,input  true
     4052                 ) .
     4053               assign
     4054                 v-restore-saved = true
     4055               .
     4056             end.
     4057           end.
     4058           if connected("ub") = true
     4059           then do:
     4060             run gbl/wndsizer.p
     4061               (input  v-cntxt-db-num
     4062               ,input  v-cntxt-userid
     4063               ,input  v-diasize-proc-name
     4064               ,input  'width':u
     4065               ,output v-resize-value-str
     4066               ) .
     4067             if v-resize-value-str <> '':U
     4068             then do:
     4069               run diasize_change-width in this-procedure
     4070                 (input  integer(v-resize-value-str)
     4071                 ,input  true
     4072                 ) .
     4073               assign
     4074                 v-restore-saved = true
     4075               .
     4076             end.
     4077           end.
     4078           if v-restore-saved <> true
     4079           then do:
     4080             if v-diasize-wndmax = true
     4081             then do:
     4082               run diasize_maximize in this-procedure
     4083                 (input  true
     4084                 ) .
     4085             end.
     4086           end.
     4087         end.
     4088         else do:
     4089           if v-diasize-wndmax = true
     4090           then do:
     4091             run diasize_maximize in this-procedure
     4092               (input  true
     4093               ) .
     4094           end.
     4095         end.
     4096       end.
     4097     end.
     4098   end procedure.
     4099   procedure diasize_need-full-display :
     4100     define output parameter p-need-full-display as logical   no-undo .
     4101     do
     4102     on error undo, return error return-value
     4103     :
     4104       assign
     4105         p-need-full-display = v-diasize-need-full-display
     4106       .
     4107       assign
     4108         v-diasize-need-full-display = false
     4109       .
     4110     end.
     4111   end procedure.
     4112   procedure get-context :
     4113      define output parameter p-db-num as integer          no-undo.
     4114      define output parameter p-user-id as character        no-undo.
     4115      define variable v-login               as character    no-undo.
     4116      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4117      define buffer buf_user-login  for ub.user-login .
     4118      do
     4119      on error undo, return error
     4120      :
     4121            FIND FIRST buf_sys-ctrl no-lock.
     4122            ASSIGN
     4123               v-login = USERID("ub")
     4124               p-db-num = buf_sys-ctrl.db-num
     4125            .
     4126            FIND FIRST buf_user-login
     4127                 WHERE buf_user-login.db-num = p-db-num
     4128                   AND buf_user-login.user-login = v-login
     4129                 no-lock
     4130                 no-error
     4131                 .
     4132            IF AVAILABLE buf_user-login
     4133            THEN DO:
     4134               assign
     4135                  p-user-id = buf_user-login.user-id
     4136               .
     4137            END.
     4138      end.
     4139   end procedure.
     4140       run diasize_init in this-procedure .
     4141   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4142   on ' ' of date-p-1 in frame Dialog-Frame
     4143   do:
     4144     if (can-query (self, "sensitive")
     4145        and
     4146        self :sensitive = true
     4147        )
     4148     or (can-query (self, "read-only")
     4149        and
     4150        self :read-only = false
     4151        )
     4152     then do:
     4153       assign
     4154         self :screen-value = ?
     4155       .
     4156     end.
     4157     return no-apply.
     4158   end.
     4159   on delete-character of date-p-1 in frame Dialog-Frame
     4160   do:
     4161     if (can-query (self, "sensitive")
     4162        and
     4163        self :sensitive = true
     4164        )
     4165     or (can-query (self, "read-only")
     4166        and
     4167        self :read-only = false
     4168        )
     4169     then do:
     4170       assign
     4171         self :screen-value = ?
     4172       .
     4173     end.
     4174     return no-apply.
     4175   end.
     4176   on ctrl-d of date-p-1 in frame Dialog-Frame
     4177   do:
     4178     define variable v-curr-sv-date as date no-undo .
     4179     if (can-query (self, "sensitive")
     4180        and
     4181        self :sensitive = true
     4182        )
     4183     or (can-query (self, "read-only")
     4184        and
     4185        self :read-only = false
     4186        )
     4187     then do:
     4188       if self :handle <> focus :handle
     4189       then do:
     4190         apply "entry":u to self .
     4191       end.
     4192       run gbl/getcurdt.p
     4193         (output v-curr-sv-date
     4194         ) .
     4195       assign
     4196         self :screen-value = string(v-curr-sv-date) .
     4197       .
     4198     end.
     4199     return no-apply.
     4200   end.
     4201   on ctrl-b of date-p-1 in frame Dialog-Frame
     4202   do:
     4203     if (can-query (self, "sensitive")
     4204        and
     4205        self :sensitive = true
     4206        )
     4207     or (can-query (self, "read-only")
     4208        and
     4209        self :read-only = false
     4210        )
     4211     then do:
     4212       if self :handle <> focus :handle
     4213       then do:
     4214         apply "entry":u to self .
     4215       end.
     4216       define variable v-curr-sv-date as date no-undo .
     4217       define variable v-new-sv-date  as date no-undo .
     4218       assign
     4219         v-curr-sv-date = date(self :screen-value) no-error
     4220       .
     4221       if v-curr-sv-date = ?
     4222       then do:
     4223         run gbl/getcurdt.p
     4224           (output v-curr-sv-date
     4225           ) .
     4226       end.
     4227       if v-curr-sv-date <> ?
     4228       then do:
     4229         assign
     4230           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     4231         .
     4232         assign
     4233           self :screen-value = string(v-new-sv-date) .
     4234         .
     4235       end.
     4236     end.
     4237     return no-apply .
     4238   end.
     4239   on ctrl-e of date-p-1 in frame Dialog-Frame
     4240   do:
     4241     if (can-query (self, "sensitive")
     4242        and
     4243        self :sensitive = true
     4244        )
     4245     or (can-query (self, "read-only")
     4246        and
     4247        self :read-only = false
     4248        )
     4249     then do:
     4250       if self :handle <> focus :handle
     4251       then do:
     4252         apply "entry":u to self .
     4253       end.
     4254       define variable v-curr-sv-date as date no-undo .
     4255       define variable v-new-sv-date  as date no-undo .
     4256       assign
     4257         v-curr-sv-date = date(self :screen-value) no-error
     4258       .
     4259       if v-curr-sv-date = ?
     4260       then do:
     4261         run gbl/getcurdt.p
     4262           (output v-curr-sv-date
     4263           ) .
     4264       end.
     4265       if v-curr-sv-date <> ?
     4266       then do:
     4267         run gbl/lastdate.p
     4268           (input  v-curr-sv-date
     4269           ,output v-new-sv-date
     4270           ).
     4271         assign
     4272           self :screen-value = string(v-new-sv-date) .
     4273         .
     4274       end.
     4275     end.
     4276     return no-apply .
     4277   end.
     4278   on ctrl-f of date-p-1 in frame Dialog-Frame
     4279   do:
     4280     if (can-query (self, "sensitive")
     4281        and
     4282        self :sensitive = true
     4283        )
     4284     or (can-query (self, "read-only")
     4285        and
     4286        self :read-only = false
     4287        )
     4288     then do:
     4289       if self :handle <> focus :handle
     4290       then do:
     4291         apply "entry":u to self .
     4292       end.
     4293       define variable v-ok            as logical   no-undo .
     4294       define variable v-curr-sv-date  as date      no-undo .
     4295       define variable v-description   as character no-undo .
     4296       assign
     4297         v-curr-sv-date = date(self :screen-value) no-error
     4298       .
     4299       if v-curr-sv-date = ?
     4300       then do:
     4301         run gbl/getcurdt.p
     4302           (output v-curr-sv-date
     4303           ) .
     4304       end.
     4305       if v-curr-sv-date <> ?
     4306       then do:
     4307         run gbl/d-inpday.w
     4308           (input ?
     4309           ,input "Выбор даты"
     4310           ,input v-description
     4311           ,input ""
     4312           ,input-output v-curr-sv-date
     4313           ,output v-ok
     4314           ).
     4315         if v-ok = true
     4316         then do:
     4317           assign
     4318             self :screen-value = string(v-curr-sv-date) .
     4319           .
     4320         end.
     4321       end.
     4322     end.
     4323     return no-apply .
     4324   end.
     4325     define MENU m-ed-date19
     4326       MENU-ITEM m-ed-date19-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     4327       MENU-ITEM m-ed-date19-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     4328       MENU-ITEM m-ed-date19-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     4329       MENU-ITEM m-ed-date19-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     4330       .
