     4424   on ctrl-b of date-p-2 in frame Dialog-Frame
     4425   do:
     4426     if (can-query (self, "sensitive")
     4427        and
     4428        self :sensitive = true
     4429        )
     4430     or (can-query (self, "read-only")
     4431        and
     4432        self :read-only = false
     4433        )
     4434     then do:
     4435       if self :handle <> focus :handle
     4436       then do:
     4437         apply "entry":u to self .
     4438       end.
     4439       define variable v-curr-sv-date as date no-undo .
     4440       define variable v-new-sv-date  as date no-undo .
     4441       assign
     4442         v-curr-sv-date = date(self :screen-value) no-error
     4443       .
     4444       if v-curr-sv-date = ?
     4445       then do:
     4446         run gbl/getcurdt.p
     4447           (output v-curr-sv-date
     4448           ) .
     4449       end.
     4450       if v-curr-sv-date <> ?
     4451       then do:
     4452         assign
     4453           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     4454         .
     4455         assign
     4456           self :screen-value = string(v-new-sv-date) .
     4457         .
     4458       end.
     4459     end.
     4460     return no-apply .
     4461   end.
     4462   on ctrl-e of date-p-2 in frame Dialog-Frame
     4463   do:
     4464     if (can-query (self, "sensitive")
     4465        and
     4466        self :sensitive = true
     4467        )
     4468     or (can-query (self, "read-only")
     4469        and
     4470        self :read-only = false
     4471        )
     4472     then do:
     4473       if self :handle <> focus :handle
     4474       then do:
     4475         apply "entry":u to self .
     4476       end.
     4477       define variable v-curr-sv-date as date no-undo .
     4478       define variable v-new-sv-date  as date no-undo .
     4479       assign
     4480         v-curr-sv-date = date(self :screen-value) no-error
     4481       .
     4482       if v-curr-sv-date = ?
     4483       then do:
     4484         run gbl/getcurdt.p
     4485           (output v-curr-sv-date
     4486           ) .
     4487       end.
     4488       if v-curr-sv-date <> ?
     4489       then do:
     4490         run gbl/lastdate.p
     4491           (input  v-curr-sv-date
     4492           ,output v-new-sv-date
     4493           ).
     4494         assign
     4495           self :screen-value = string(v-new-sv-date) .
     4496         .
     4497       end.
     4498     end.
     4499     return no-apply .
     4500   end.
     4501   on ctrl-f of date-p-2 in frame Dialog-Frame
     4502   do:
     4503     if (can-query (self, "sensitive")
     4504        and
     4505        self :sensitive = true
     4506        )
     4507     or (can-query (self, "read-only")
     4508        and
     4509        self :read-only = false
     4510        )
     4511     then do:
     4512       if self :handle <> focus :handle
     4513       then do:
     4514         apply "entry":u to self .
     4515       end.
     4516       define variable v-ok            as logical   no-undo .
     4517       define variable v-curr-sv-date  as date      no-undo .
