     4825     ,input   loc-exch-rate
     4826     ,input   loc-exch-scale
     4827     ,input   vat_type
     4828     ,input   slt_type
     4829     ,input   tmp#zakaz.artic
     4830     ,input   tmp#zakaz.prod-type
     4831     ,input   tmp#zakaz.prod-code
     4832     ,input   tmp#zakaz.price-cli
     4833     ,input   tmp#zakaz.cli-base-rate
     4834     ,input   tmp#zakaz.price-rubl
     4835     ,input   tmp#zakaz.vat-pc
     4836     ,input   tmp#zakaz.slt-pc
     4837     ,input   tmp#zakaz.road-tax
     4838     ,input   tmp#zakaz.transport-rubl
     4839     ,input   tmp#zakaz.other-rubl
     4840     ,output  varprice-cli-dt
     4841     ,output  varprice-cli-unit-base-dt
     4842     ,output  varprice-road-tax-dt
     4843     ,output  varprice-other-exp-dt
     4844     ,output  varprice-transport-exp-dt
     4845     ,output  varprice-without-abs-dt
     4846     ,output  varprice-slt-dt
     4847     ,output  varprice-no-slt-dt
     4848     ,output  varprice-vat-dt
     4849     ,output  varprice-no-vat-slt-dt
     4850     ,output  varprice-rubl-dt
     4851     ,output  varprice-road-tax-rubl-dt
     4852     ,output  varprice-other-exp-rubl-dt
     4853     ,output  varprice-transport-exp-rubl-dt
     4854     ,output  varprice-without-abs-rubl-dt
     4855     ,output  varprice-slt-rubl-dt
     4856     ,output  varprice-no-slt-rubl-dt
     4857     ,output  varprice-vat-rubl-dt
     4858     ,output  varprice-no-vat-slt-rubl-dt
     4859     ,output  varprice-base-dt
     4860     ,output  varprice-road-tax-base-dt
     4861     ,output  varprice-other-exp-base-dt
     4862     ,output  varprice-transport-exp-base-dt
     4863     ,output  varprice-without-abs-base-dt
     4864     ,output  varprice-slt-base-dt
     4865     ,output  varprice-no-slt-base-dt
     4866     ,output  varprice-vat-base-dt
     4867     ,output  varprice-no-vat-slt-base-dt
     4868     ) no-error.
     4869       if error-status:error then do:
     4870         return error "Ошибка при пересчете НДС".
     4871       end.
     4872      assign
     4873       tmp#zakaz.sum-vat    = varprice-vat-dt  * tmp#zakaz.cli-qnty
     4874       tmp#zakaz.sum-slt    = varprice-slt-dt
     4875       tmp#zakaz.road-tax   = if var-report-r-b = "rubl" then   varprice-road-tax-rubl-dt else varprice-road-tax-base-dt
     4876       tmp#zakaz.other-base = varprice-other-exp-base-dt
     4877       tmp#zakaz.other-rubl = varprice-other-exp-rubl-dt
     4878       tmp#zakaz.price-rubl = varprice-rubl-dt
     4879       tmp#zakaz.price-base = varprice-base-dt
     4880       tmp#zakaz.price-cli  = varprice-cli-dt
     4881        .
     4882     end.
     4883     end.
     4884   END PROCEDURE.
     4885   PROCEDURE disable_UI :
     4886     HIDE FRAME Dialog-Frame.
     4887   END PROCEDURE.
     4888   PROCEDURE enable_UI :
     4889     OPEN QUERY Dialog-Frame FOR EACH tmp-sale NO-LOCK.
     4890     GET FIRST Dialog-Frame.
     4891     DISPLAY R-algoritm p-neg-sale R-min-rest T-gar r-min-rest3 T-min-ost
     4892             R-algoritm2 SelectObject T-min-zapas date-p-1 date-p-2 t-way T-clos
     4893             t-rv t-rvc T-rcv t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3
     4894             v-round-m v-round-base v-name p-prt-art FILL-IN-2 FILL-IN-17 FILL-IN-3
     4895             t-gar-1 t-gar-2 FILL-IN-15 FILL-IN-13 t-min-ost-1 t-min-ost-2
     4896             FILL-IN-5 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7
     4897             FILL-IN-16
     4898         WITH FRAME Dialog-Frame.
     4899     IF AVAILABLE tmp-sale THEN
     4900       DISPLAY tmp-sale.desc_ tmp-sale.tmp-code
     4901         WITH FRAME Dialog-Frame.
     4902     ENABLE RECT-1 RECT-3 RECT-5 RECT-6 RECT-7 RECT-8 R-algoritm p-neg-sale
     4903            R-min-rest T-gar r-min-rest3 T-min-ost R-algoritm2 SelectObject
     4904            BR-obj-list T-min-zapas BUTTON-obj date-p-1 date-p-2 t-way BROWSE-1
     4905            BROWSE-abc-day B-10 B-1 B-2 T-clos B-3 t-rv t-rvc T-rcv B-4 t-rvz
     4906            T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m
     4907            v-round-base B-spis p-prt-art Btn_OK Btn_Cancel B-Help i-exit
     4908            FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 FILL-IN-15 FILL-IN-13 t-min-ost-1
     4909            t-min-ost-2 FILL-IN-5 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4
     4910            t-5 t-6 t-7 FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code
     4911         WITH FRAME Dialog-Frame.
     4912     VIEW FRAME Dialog-Frame.
     4913     OPEN QUERY br-obj-list  FOR EACH obj-list .    OPEN QUERY browse-1 FOR EACH tt-date .    OPEN QUERY BROWSE-abc-day FOR EACH temp-abc-day .
     4914   END PROCEDURE.
     4915   PROCEDURE init-screen :
     4916    do
     4917    on error undo, return error return-value
     4918    :
     4919   define input parameter p-val as character no-undo .
     4920   define variable i as integer no-undo .
     4921     if g#type <> 'ФП':U then do:
     4922         for each  obj-list : delete obj-list . end.
     4923   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4924   run create_obj-list in this-procedure
     4925    ( input store-type ,
     4926      input store-code )
     4927      .
     4928     end.
     4929   define variable v-nn as integer   no-undo .
     4930     v-nn = num-entries(p-val) .
     4931     do i = 1 to v-nn :
     4932        case  entry(1,(entry(i,p-val)), "=" ) :
     4933           when string( "v-round-m" )              then v-round-m =          entry(2,(entry(i,p-val)), "=" ).
     4934           when string( "v-round-base" )           then v-round-base = decimal( entry(2,(entry(i,p-val)), "=" )).
     4935           when string( "R-min-rest" )             then R-min-rest = integer(entry(2,(entry(i,p-val)), "=" )).
     4936           when string( "R-algoritm" )             then R-algoritm = integer(entry(2,(entry(i,p-val)), "=" )).
     4937           when string( "R-algoritm2" )            then R-algoritm2 = integer(entry(2,(entry(i,p-val)), "=" )).
     4938           when string( "tmp-sale.tmp-code" )      then do:
     4939                find first ub.tmp-sale no-lock where ub.tmp-sale.tmp-code = entry(2,(entry(i,p-val)), "=" ) no-error.
     4940                if available ub.tmp-sale then do:
     4941                   rr = recid(ub.tmp-sale) .
     4942                    display  ub.tmp-sale.tmp-code
     4943                                ub.tmp-sale.desc_   with frame Dialog-Frame .
     4944                    reposition Dialog-Frame to recid rr no-error  .
     4945                    if error-status :error then error-status :get-message(1) .
     4946                end.
     4947                else do:
     4948                find first ub.tmp-sale no-lock no-error .
     4949                   if available ub.tmp-sale then rr = recid(ub.tmp-sale) .
     4950                end.
     4951           end.
     4952           when string( "SelectObject" ) then  do:
     4953                   SelectObject = string(entry(2,(entry(i,p-val)), "=" )) no-error .
     4954                   if error-status :error then SelectObject = "firm":U  .
     4955                   if SelectObject = "choice":U then SelectObject = "order":U .
     4956                   run select-objects-proc in this-procedure (input p-val).
     4957                end.
     4958           when string( "date-p-1" ) then  date-p-1 = date(entry(2,(entry(i,p-val)), "=" )).
     4959           when string( "date-p-2" ) then  date-p-2 = date(entry(2,(entry(i,p-val)), "=" )).
     4960           when string( "t-way"    )   then  t-way    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4961           when string( "t-rcv"    )   then  t-rcv    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4962           when string( "t-clos"   )   then  t-clos    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4963           when string( "t-rv"   )   then  t-rv    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4964           when string( "t-rvz"  )   then  t-rvz   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4965           when string( "t-rvc"  )   then  t-rvc   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4966           when string( "t-rvzc" )   then  t-rvzc  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4967           when string( "t-sp"   )   then  t-sp    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4968           when string( "t-sppv-2")  then  t-sppv-2 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4969           when string( "t-sppv-3")  then  t-sppv-3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4970           when string( "t-sppv-4")  then  t-sppv-4 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4971           when string( "p-neg-sale")   then  p-neg-sale = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4972           when string( "t-gar")         then  t-gar = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4973           when string( "t-min-zapas") then  t-min-zapas = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4974           when string( "t-min-ost") then  t-min-ost = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4975           when string( "R-min-rest3")  then  R-min-rest3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4976       end case.
     4977      g#log = SelectObject:disable(radio-label("all":U , SelectObject:radio-buttons)).
     4978     end.
     4979     if lookup ( v-round-m , 'Произвольно':U ) > 0 then do:
     4980           enable  v-round-base with frame Dialog-Frame .
     4981           display v-round-base with frame Dialog-Frame .
     4982        end.
     4983   end.
     4984   END PROCEDURE.
     4985   PROCEDURE loc-enable-UI :
     4986     OPEN QUERY Dialog-Frame FOR EACH tmp-sale NO-LOCK.
     4987     GET FIRST Dialog-Frame.
     4988     reposition Dialog-Frame to recid rr no-error  .
     4989     find first ub.tmp-sale where rr = recid(ub.tmp-sale) no-lock no-error .
     4990     DISPLAY R-algoritm p-neg-sale R-min-rest T-gar r-min-rest3 T-min-ost R-algoritm2 SelectObject BR-obj-list T-min-zapas BUTTON-obj  t-way BROWSE-1 B-10 B-1 B-2 T-clos B-3 t-rv t-rvc T-rcv B-4 t-rvz T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m p-prt-art Btn_OK Btn_Cancel B-Help i-exit FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 FILL-IN-15 FILL-IN-13 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7 FILL-IN-16
     4991         WITH FRAME Dialog-Frame.
