     5592           browse-1:bgcolor  in frame Dialog-Frame  = ? .
     5593           g#log = R-min-rest:enable( 'На фирме' ) .
     5594      end.
     5595      when 4 then do:
     5596           enable   RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7   with frame Dialog-Frame .
     5597           disable  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 T-gar t-gar-1 t-gar-2  with frame Dialog-Frame .
     5598           hide     BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 T-gar t-gar-1 t-gar-2  in frame Dialog-Frame .
     5599           g#log = R-min-rest:enable( 'На фирме' ) .
     5600           browse-1:bgcolor  in frame Dialog-Frame  = ? .
     5601           g#log = R-algoritm2:disable(radio-label("2", R-algoritm2:radio-buttons)) .
     5602      end.
     5603      when 5 then do:
     5604           R-min-rest = 1.
     5605           r-min-rest3 = false .
     5606           g#log = R-min-rest:disable( 'На фирме' ) .
     5607           display R-min-rest r-min-rest3 with frame Dialog-Frame .
     5608           disable RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 T-gar t-gar-1 t-gar-2 r-min-rest3  with frame Dialog-Frame .
