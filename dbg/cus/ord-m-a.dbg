     5585           browse-1:bgcolor  in frame Dialog-Frame  = 8 .
     5586           g#log = R-min-rest:enable( 'На фирме' ) .
     5587     end.
     5588     when 3 then do:
     5589           enable   RECT-3 RECT-8 R-algoritm2  t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14  p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7   T-gar t-gar-1 t-gar-2   with frame Dialog-Frame .
