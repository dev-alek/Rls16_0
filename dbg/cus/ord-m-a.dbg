     4332     then do:
     4333       ASSIGN
     4334         date-p-1 :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date19 :HANDLE
     4335         date-p-1 :MENU-MOUSE in frame Dialog-Frame = 3
     4336       .
     4337     end.
