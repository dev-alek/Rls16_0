      577   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure cur-time :
      579      define output parameter p-today as date      no-undo .
      580      define output parameter p-time  as integer   no-undo .
      581     do
      582     on error undo, return error
      583     :
      584       define variable v-date1 as date      no-undo .
      585       define variable v-date2 as date      no-undo .
      586       define variable v-time  as integer   no-undo .
      587       assign
      588         v-date1 = today
      589         v-time  = time
      590         v-date2 = today
      591       .
      592       if v-date1 <> v-date2
      593       then do:
      594         assign
      595           v-date1 = today
      596           v-time  = v-time
      597         .
      598       end.
      599       assign
      600         p-today = v-date1
      601         p-time  = v-time
      602       .
      603     end.
      604   end.
      605   function cur-time-date returns character
      606   :
      607     return string(today, '99/99/9999':U) .
      608   end.
      609   function cur-time-mjd returns decimal
      610   :
      611     define variable v-date as date      no-undo .
      612     define variable v-time as integer   no-undo .
      613     run cur-time in this-procedure
      614       (output v-date
      615       ,output v-time
      616       ) .
      617     return integer(v-date) - 2400002 + (v-time / 86400) .
      618   end.
      619   function cur-time-get-ending-index returns integer
      620   (input p-number as integer
      621   )
      622   :
      623     if p-number < 0
      624     or p-number = ?
      625     then do:
      626       return 1 .
      627     end.
      628     define variable v-rest as integer   no-undo .
      629     assign
      630       p-number = p-number modulo 100
      631     .
      632     if p-number < 20
      633     then do:
      634       assign
      635         v-rest = p-number
      636       .
      637     end.
      638     else do:
      639       assign
      640         v-rest = p-number modulo 10
      641       .
      642     end.
      643     case v-rest :
      644       when 1
      645       then do:
      646         return 2 .
      647       end.
      648       when 2 or
      649       when 3 or
      650       when 4
      651       then do:
      652         return 3 .
      653       end.
      654       otherwise do:
      655         return 1 .
      656       end.
      657     end case .
      658   end.
      659   procedure cur-time-mjd-to-date :
      660      define input  parameter i-mjd-diff as decimal no-undo.
      661      define output parameter o-Date     as date    no-undo.
      662      define output parameter o-Time     as integer no-undo.
      663      define variable v-day-number as integer   no-undo .
      664      if    i-mjd-diff < 0
      665         or i-mjd-diff = ?
      666      then do:
      667         return "?" .
      668      end.
      669      assign
      670         v-day-number = truncate(i-mjd-diff,0).
      671         o-Date = date(v-day-number + 2400002).
      672         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674   end.
      675   function cur-time-mjd-to-string returns character
      676   (input p-mjd-diff as decimal
      677   )
      678   :
      679     define variable v-day-number as integer   no-undo .
      680     define variable v-seconds    as integer   no-undo .
      681     define variable v-hour       as integer   no-undo .
      682     define variable v-min        as integer   no-undo .
      683     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      684     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      685     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      686     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      687     if p-mjd-diff < 0
      688     or p-mjd-diff = ?
      689     then do:
      690       return "?" .
      691     end.
      692     assign
      693       v-day-number = integer(truncate(p-mjd-diff,0))
      694       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      695     .
      696     if v-seconds > 86400
      697     then do:
      698       assign
      699         v-seconds = 86400 - 1
      700       .
      701     end.
      702     if v-seconds < 0
      703     then do:
      704       assign
      705         v-seconds = 0
      706       .
      707     end.
      708     assign
      709       v-hour = truncate(v-seconds / 3600, 0)
      710     .
      711     assign
      712       v-seconds = v-seconds modulo 3600
      713     .
      714     assign
      715       v-min = truncate(v-seconds / 60, 0)
      716     .
      717     assign
      718       v-seconds = v-seconds modulo 60
      719     .
      720     return
      721         (if v-day-number <> 0
      722           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      723           else ""
      724         )
      725       + (if v-day-number <> 0 or v-hour <> 0
      726           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      730           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      731           else ""
      732         )
      733       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      734       .
      735   end.
      736   function cur-time-string returns character
      737   :
      738     define variable v-date as date      no-undo .
      739     define variable v-time as integer   no-undo .
      740     run cur-time in this-procedure
      741       (output v-date
      742       ,output v-time
      743       ) .
      744     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      745   end.
      746   function cur-time-string-sec returns character
      747   :
      748     define variable v-date as date      no-undo .
      749     define variable v-time as integer   no-undo .
      750     run cur-time in this-procedure
      751       (output v-date
      752       ,output v-time
      753       ) .
      754     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      755   end.
      756   function cur-time-custom  returns character
      757   (input p-prefix as character
      758   ,input p-date-format as character
      759   ,input p-delimiter as character
      760   ,input p-time-format as character
      761   ,input p-suffix as character
      762   )
      763   :
      764     define variable v-date as date      no-undo .
      765     define variable v-time as integer   no-undo .
      766     run cur-time in this-procedure
      767       (output v-date
      768       ,output v-time
      769       ) .
      770     return
      771       p-prefix
      772       + string(v-date, p-date-format)
      773       + p-delimiter
      774       + string(v-time, p-time-format)
      775       + p-suffix
      776       .
      777   end.
      778   function cur-time-print  returns character
      779   :
      780     define variable v-date as date      no-undo .
      781     define variable v-time as integer   no-undo .
      782     run cur-time in this-procedure
      783       (output v-date
      784       ,output v-time
      785       ) .
      786     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      787   end.
      788   function cur-time-datetime returns datetime
      789   :
      790     define variable v-char as character no-undo .
      791     define variable v-datetime as datetime no-undo .
      792     v-char = cur-time-string().
      793     v-datetime = datetime(v-char).
      794     return  v-datetime.
      795   end.
      796   function cur-time-string-msec returns character
      797   :
      798     define variable v-date as datetime  no-undo .
      799     v-date = now.
      800     return string(v-date) .
      801   end.
      802   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      804   define new shared variable RepPathName        as character no-undo .
