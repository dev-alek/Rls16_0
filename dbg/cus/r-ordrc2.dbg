      807   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      808   procedure paramls-clear :
      809     define buffer buf_temp-param for temp-param .
      810     do
      811     on error undo, return error return-value
      812     :
      813       for each buf_temp-param
      814       on error undo, return error
      815       :
      816         delete buf_temp-param .
      817       end.
      818     end.
      819   end procedure.
      820   procedure paramls-write :
      821     define input  parameter p-code     as character no-undo .
      822     define input  parameter p-sub-code as character no-undo .
      823     define input  parameter p-value    as character no-undo .
      824     define buffer buf_temp-param for temp-param .
      825     do
      826     on error undo, return error return-value
      827     :
      828       find first buf_temp-param
      829         where buf_temp-param.param-code     = p-code
      830           and buf_temp-param.param-sub-code = p-sub-code
      831         no-error .
      832       if not available buf_temp-param then do:
      833         create buf_temp-param .
      834         assign
      835           buf_temp-param.param-code     = p-code
      836           buf_temp-param.param-sub-code = p-sub-code
      837         .
      838       end.
      839       assign
      840         buf_temp-param.param-value = p-value
      841       .
      842     end.
      843   end procedure.
      844   procedure paramls-read :
      845     define input  parameter p-code          as character no-undo .
      846     define input  parameter p-sub-code      as character no-undo .
      847     define input  parameter p-default-value as character no-undo .
      848     define output parameter p-value         as character no-undo .
      849     define buffer buf_temp-param for temp-param .
      850     do
      851     on error undo, return error return-value
      852     :
      853       find first buf_temp-param
      854         where buf_temp-param.param-code     = p-code
      855           and buf_temp-param.param-sub-code = p-sub-code
      856         no-error .
      857       if available buf_temp-param then do:
      858         assign
      859           p-value = buf_temp-param.param-value
      860         .
      861       end.
      862       else do:
      863         assign
      864           p-value = p-default-value
      865         .
      866       end.
      867     end.
      868   end procedure.
      869   procedure paramls-append :
      870     define input  parameter p-code     as character no-undo .
      871     define input  parameter p-sub-code as character no-undo .
      872     define input  parameter p-value    as character no-undo .
      873     define buffer buf_temp-param for temp-param .
      874     do
      875     on error undo, return error return-value
      876     :
      877       find first buf_temp-param
      878            where buf_temp-param.param-code     = p-code
      879              and buf_temp-param.param-sub-code = p-sub-code
      880         no-error .
      881       if not available buf_temp-param then do:
      882         create buf_temp-param .
      883         assign
      884           buf_temp-param.param-code     = p-code
      885           buf_temp-param.param-sub-code = p-sub-code
      886           buf_temp-param.param-value    = p-value
      887         .
      888       end.
      889       else do:
      890           assign
      891               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      892           .
      893       end.
      894     end.
      895   end procedure.
      896   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      897     if num-entries(string(p-dec), '.') = 2
      898       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      899       else return( string(p-dec)) .
      900   end function.
      901   function format-point-to-comma returns char (input orig as char ) .
      902   define variable rtext as character no-undo .
      903   define variable strt as integer no-undo .
      904   define variable leng as integer no-undo .
      905   assign rtext = orig .
      906   repeat:
      907     strt =  index(rtext,'.').
      908     if strt = 0 then leave.
      909     leng = 1.
      910     substring(rtext,strt,leng,"character") = v-delim .
      911   end.
      912   return rtext.
      913   end function.
      914   function format-excel-text returns char ( input start-text as char ) :
      915   def var  i    as int no-undo.
      916   def var  ch   as char no-undo.
      917   def var  n    as int no-undo.
      918   def var  ipos as int no-undo.
      919     n = num-entries(trim(start-text), chr(10)) - 1 .
      920     do i = 1 to n :
      921       ipos = index( start-text, chr(10)).
      922       if ipos > 0 then
      923         substr( start-text, ipos, 1 ) = ' '.
      924     end.
      925     n = num-entries(trim(start-text), chr(13)) - 1 .
      926     do i = 1 to n :
      927       ipos = index( start-text, chr(13)).
      928       if ipos > 0 then
      929         substr( start-text, ipos, 1 ) = ' '.
      930     end.
      931     if index( start-text, '"' ) = 0 then
      932       start-text =  '="'   + trim( start-text) + '"'   .
      933       else do:
      934         n = num-entries(trim(start-text), '"') - 1.
      935         do i = 1 to n :
      936           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      937         end.
      938         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      939         start-text = '="'  + ch  + '"' .
      940       end.
      941     return start-text.
      942   end.
      943   function excel-sum returns char (input p-dec as decimal ).
      944     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      945   end function.
      946   function excel-qnty returns char (input p-dec as decimal ).
      947     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      948   end function.
      949   function format-excel-text-macr returns char ( input start-text as char ) :
      950   def var  i    as int no-undo.
      951   def var  ch   as char no-undo.
      952   def var  n    as int no-undo.
      953   def var  ipos as int no-undo.
      954     n = num-entries(trim(start-text), chr(10)) - 1 .
      955     do i = 1 to n :
      956       ipos = index( start-text, chr(10)).
      957       if ipos > 0 then
      958         substring( start-text, ipos , 1 ) = ' '.
      959     end.
      960     n = num-entries(trim(start-text), chr(13)) - 1 .
      961     do i = 1 to n :
      962       ipos = index( start-text, chr(13)).
      963       if ipos > 0 then
      964         substring( start-text, ipos, 1 ) = ' '.
      965     end.
      966     if index( start-text, '"' ) = 0 then
      967       start-text =  '"'   + trim( start-text) + '"'   .
      968       else do:
      969         n = num-entries(trim(start-text), '"') - 1.
      970         do i = 1 to n :
      971           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      972         end.
      973         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      974         start-text = '"'  + ch  + '"' .
      975       end.
      976     n = num-entries(trim(start-text), chr(10)) - 1 .
      977     do i = 1 to n :
      978       ipos = index( start-text, chr(10)).
      979       if ipos > 0 then
      980         substring( start-text, ipos , 1 ) = ' '.
      981     end.
      982       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      983     return start-text.
      984   end.
      985   define variable v-account as integer init 0 no-undo .
      986   define variable v-account-lavel as character no-undo .
      987   define variable v-button-stop as logical no-undo .
      988   define variable v-kol-spice as integer no-undo .
      989   define variable v-kol-spice2 as integer no-undo .
      990   define variable v-kol-spice3 as integer no-undo .
      991   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      992   DEFINE BUTTON StopBtn AUTO-END-KEY
      993        LABEL "Стоп"
      994        SIZE 10 BY 1.
      995   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      996        LABEL "Обработано записей"
      997         VIEW-AS TEXT
      998        SIZE 14 BY .67 NO-UNDO.
      999   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1000         VIEW-AS TEXT
     1001        SIZE 53.25 BY .67
     1002        FGCOLOR 1  NO-UNDO.
     1003   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1004         VIEW-AS TEXT
     1005        SIZE 53.25 BY .67
     1006        FGCOLOR 1  NO-UNDO.
     1007   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1008         VIEW-AS TEXT
     1009        SIZE 53.25 BY .67
     1010        FGCOLOR 1  NO-UNDO.
     1011   DEFINE RECTANGLE RECT-1
     1012        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1013        SIZE 55.13 BY 4.46.
     1014   DEFINE FRAME InfoFrame
     1015        StopBtn AT ROW 4.25 COL 21.75
     1016        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1017        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1018        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1019        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1020        RECT-1 AT ROW 1 COL 1
     1021       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1022            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1023            TITLE "Процесс"
     1024            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1025   define variable mFrameView      as logical   no-undo init yes.
     1026     define variable mFramHandle as handle no-undo.
     1027     mFramHandle = frame InfoFrame:handle.
     1028     if  log-manager:logfile-name ne ?
     1029     then DO:
     1030         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1031         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1032         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1033     end.
     1034     mFrameView = not session:batch-mode and mFramHandle:visible.
     1035     if mFrameView
     1036     then do:
     1037       ASSIGN
     1038          FRAME InfoFrame:HIDDEN                           = TRUE
     1039          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1040     end.
     1041   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1042   DO:
     1043     IF not StopProcessing THEN
     1044       Message "Вы действительно хотите прервать" SKIP
     1045               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1046                 UPDATE StopProcessing.
     1047     IF StopProcessing THEN do:
     1048        if mFrameView
     1049        then do:
     1050           HIDE FRAME InfoFrame.
     1051        end.
     1052     End.
     1053   END.
     1054   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1055     if  log-manager:logfile-name ne ?
     1056     then DO:
     1057         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1058     end.
     1059     if not session:batch-mode then
     1060     do:
     1061       VIEW FRAME InfoFrame.
     1062       mFrameView = true.
     1063     end.
     1064      v-button-stop = false .
     1065         if mFrameView
     1066         then do:
     1067         if v-button-stop then view STOPBTN in frame InfoFrame.
     1068                          else Hide STOPBTN in frame InfoFrame.
     1069         end.
     1070   define variable vss-include-info10 as character format "X(65)" no-undo
     1071   initial "@(#)$Workfile$ $Revision$".
     1072   procedure grplib-get-full-name :
     1073      define input parameter p-node-code  as integer      no-undo.
     1074      define output parameter p-full-name as character    no-undo.
     1075      do
     1076   on error undo, return error
     1077   :
     1078       define variable v-upper-code    as integer           no-undo.
     1079       define buffer buf_gds-grp       for ub.gds-grp.
     1080       define buffer buf_upper_gds-grp for ub.gds-grp.
     1081       find first buf_gds-grp no-lock
     1082            where buf_gds-grp.node-code = p-node-code
     1083       no-error.
     1084       if not available buf_gds-grp
     1085       then do:
     1086           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1087       end.
     1088       assign
     1089           p-full-name  = ""
     1090           v-upper-code = 1
     1091       .
     1092       do while buf_gds-grp.upper-code <> 0
     1093       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1094       :
     1095           assign
     1096               p-full-name  = buf_gds-grp.node-name
     1097                            + (if p-full-name <> "" then chr(47) else "")
     1098                            + p-full-name
     1099               v-upper-code = buf_gds-grp.upper-code
     1100           .
     1101           find first buf_gds-grp no-lock
     1102                where buf_gds-grp.node-code = v-upper-code
     1103           no-error.
     1104           if not available buf_gds-grp
     1105           then do:
     1106               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1107                                   + string( v-upper-code )
     1108                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1109           end.
     1110       end.
     1111       assign
     1112       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1113       .
     1114   end.
     1115   end .
     1116   procedure grplib-get-node-from-full-name :
     1117   define input parameter p-full-name as character no-undo .
     1118   define output parameter p-node-code as integer no-undo .
     1119   define variable v-ii as integer no-undo .
     1120   define variable v-upper-code as integer no-undo .
     1121   define variable v-root-code as integer no-undo .
     1122   define variable v-entry as character no-undo .
     1123   define buffer buf_gds-grp       for ub.gds-grp.
     1124   do
     1125   on error undo, return error
     1126   :
     1127     find first buf_gds-grp no-lock
     1128         where buf_gds-grp.upper-code = 0
     1129     no-error .
     1130     if not available buf_gds-grp
     1131     then do:
     1132         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1133     end.
     1134     else do:
     1135       assign
     1136       v-root-code = buf_gds-grp.node-code
     1137       .
     1138     end.
     1139     v-upper-code = v-root-code.
     1140     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1141       assign
     1142       v-entry = entry(v-ii, p-full-name, chr(47)).
     1143       if v-entry = '' then leave.
     1144       find first buf_gds-grp no-lock where
     1145                 buf_gds-grp.node-name = v-entry
     1146             and buf_gds-grp.upper-code = v-upper-code
     1147             no-error.
     1148       if not available buf_gds-grp then do:
     1149         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1150       end.
     1151       else do:
     1152         p-node-code = buf_gds-grp.node-code.
     1153         v-upper-code = buf_gds-grp.node-code.
     1154       end.
     1155     end.
     1156   end.
     1157   end .
