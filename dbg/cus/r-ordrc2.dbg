     1427   run macr_excel_dec in this-procedure ( temp-i.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1428   run macr_excel_dec in this-procedure ( temp-i.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1429   run macr_excel_dec in this-procedure ( temp-i.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1430   run macr_excel_dec in this-procedure ( temp-i.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1431   run macr_excel_dec in this-procedure ( temp-i.prc_fact-qnty_qnty  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1432   num#str# =  7 .
     1433   num#col# = 1.
     1434   run macr_excel_char in this-procedure ( "Кол-во заказов за период"   , num#str# , num#col#   ) .
     1435   num#str# =  8 .
