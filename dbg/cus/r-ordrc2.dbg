     1404   procedure print-all-itog :
     1405   num#str# = num#str# + 1.
     1406   num#col# = 1.
     1407       run macr_cell_format in this-procedure
     1408           ( ?     ,
     1409             true   ,
     1410             false  ,
     1411             ?      ,
     1412             num#str# ,
     1413             1      ,
     1414             num#str# ,
     1415             20 ) .
