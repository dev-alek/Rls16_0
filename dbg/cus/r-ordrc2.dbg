     1451   procedure PrintTitul :
     1452     do  on error undo, return error return-value  :
     1453     define variable cc as integer no-undo .
     1454     define variable tt as integer no-undo .
     1455       num#str# = num#str# + 1.
     1456       num#col# = 2.
     1457       cc = num#str# .
     1458       run macr_excel_char in this-procedure ( ReportName  , num#str# , num#col#   ) .
     1459       run macr_cell_format in this-procedure
     1460           ( 12     ,
     1461             true   ,
     1462             false  ,
     1463             ?      ,
     1464             cc     ,
     1465             2      ,
     1466             num#str# ,
     1467             2 ) .
     1468       num#col# = 1.
     1469       num#str# = num#str# + 1.
     1470   define variable l-ii  as integer no-undo .
     1471   define variable l-jj  as integer no-undo .
     1472   define variable l-len as integer no-undo .
     1473   define variable l-m   as integer no-undo .
     1474   define variable v-nn as integer   no-undo .
     1475   v-nn = num-entries( str1 , "chr(10)"  )  .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1476   v-nn = num-entries( str2 , "chr(10)"  )  .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1477   v-nn = num-entries( str4 , "chr(10)"  )  .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1478   v-nn = num-entries( reportheader , "chr(10)"  )  .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1479       num#str# = num#str# + 1.
     1480       run macr_excel_char("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     1481       num#str# = 10.
     1482       run pshap in this-procedure .
     1483       num#str# = num#str# + 1.
     1484       num#col# = 1.
     1485       run macr_excel_char in this-procedure ( "Код"   , num#str# , num#col#   ) .
     1486       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1487       num#col# = 2.
     1488       run macr_excel_char in this-procedure ( "Наименование Контрагента "   , num#str# , num#col#   ) .
     1489       run macr_cell_size in this-procedure  ( 30 , ? , num#str# , num#col# , ?, ? ) .
     1490       num#col# = 3.
     1491       run macr_excel_char in this-procedure ( if p-OrdDate = "doc-date" then "Дата заказа " else "Заказ на дату" , num#str# , num#col#   ) .
     1492       run macr_cell_size in this-procedure  ( 11 , ? , num#str# , num#col# , ?, ? ) .
     1493       num#col# = 4.
     1494       run macr_excel_char in this-procedure ( "Дата заказа факт"   , num#str# , num#col#   ) .
     1495       run macr_cell_size in this-procedure  ( 11 , ? , num#str# , num#col# , ?, ? ) .
     1496       num#col# = 5.
     1497       run macr_excel_char in this-procedure ( "№ заказа"   , num#str# , num#col#   ) .
     1498       run macr_cell_size in this-procedure  ( 14 , ? , num#str# , num#col# , ?, ? ) .
     1499       num#col# = 6.
     1500       run macr_excel_char in this-procedure ( "Статус"   , num#str# , num#col#   ) .
     1501       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1502       num#col# = 7.
     1503       run macr_excel_char in this-procedure ( "Дата факт РН"   , num#str# , num#col#   ) .
     1504       run macr_cell_size in this-procedure  ( 11 , ? , num#str# , num#col# , ?, ? ) .
     1505       num#col# = 8.
     1506       run macr_excel_char in this-procedure ( "№ РН"   , num#str# , num#col#   ) .
     1507       run macr_cell_size in this-procedure  ( v-size-ras , ? , num#str# , num#col# , ?, ? ) .
     1508       num#col# = 9.
     1509       run macr_excel_char in this-procedure ( "Дата факт ПН"   , num#str# , num#col#   ) .
     1510       run macr_cell_size in this-procedure  ( 11 , ? , num#str# , num#col# , ?, ? ) .
     1511       num#col# = 10.
     1512       run macr_excel_char in this-procedure ( "№ ПН"   , num#str# , num#col#   ) .
     1513       run macr_cell_size in this-procedure  ( v-size-pri , ? , num#str# , num#col# , ?, ? ) .
     1514       num#col# = 11.
     1515       run macr_excel_char in this-procedure ( "Рассчитано по заказу"   , num#str# , num#col#   ) .
     1516       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1517       num#col# = 12.
     1518       run macr_excel_char in this-procedure ( "Заказано"   , num#str# , num#col#   ) .
     1519       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1520       num#col# = 13.
     1521       run macr_excel_char in this-procedure ( "Разрешено к отпуску"   , num#str# , num#col#   ) .
     1522       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1523       num#col# = 14.
     1524       run macr_excel_char in this-procedure ( "Разрешено к отпуску / Заказано,%"   , num#str# , num#col#   ) .
     1525       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1526       num#col# = 15.
     1527       run macr_excel_char in this-procedure ( "Поставлено"   , num#str# , num#col#   ) .
     1528       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1529       num#col# = 16.
     1530       run macr_excel_char in this-procedure ( "Поставлено / Разрешено к отпуску,%"   , num#str# , num#col#   ) .
     1531       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1532       run macr_cell_format in this-procedure
     1533       ( 10    ,
     1534         true  ,
     1535         false  ,
     1536         ?    ,
     1537         num#str# ,
     1538         1 ,
     1539         num#str# ,
     1540         16 ) .
     1541        put  stream macr_excel unformatted
     1542          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1543          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1544          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1545          .
     1546     end.
     1547   end procedure.
     1548   procedure make-tt :
     1549   define buffer buf_ord-doc      for ub.ord-doc  .
     1550   define variable v-gds as logical no-undo .
     1551   define variable first-line as logical   no-undo .
     1552     do
     1553     on error undo, return error return-value
     1554     :
     1555   create temp-i.
     1556   assign
     1557   temp-i.initial-qnty     = 0
     1558   temp-i.order-qnty       = 0
     1559   temp-i.qnty             = 0
     1560   temp-i.fact-qnty        = 0
     1561   temp-i.account-order    = 0
     1562   .
     1563   first-line  = true.
     1564   v-gds = false .
     1565   find first gds-list no-error .
     1566   if available gds-list then v-gds = true  .
     1567     for each obj-list :
     1568     if p-mode <> "RC":U then do:
     1569         if p-OrdDate = "doc-date" then do :
     1570           for each buf_ord-doc no-lock where
     1571                   buf_ord-doc.doc-type  = 'ОР':U and
     1572                   buf_ord-doc.obj-type  = obj-list.obj-type and
     1573                   buf_ord-doc.obj-code  = obj-list.obj-code and
     1574                   lookup ( buf_ord-doc.status_ , v-list-st) > 0  and
     1575                   buf_ord-doc.doc-date >= x-date-start and
     1576                   buf_ord-doc.doc-date <= x-date-end
     1577                       :
     1578               run make-tt-1 in this-procedure
     1579               ( input buf_ord-doc.doc-code,
     1580                 input buf_ord-doc.obj-type,
     1581                 input buf_ord-doc.obj-code,
     1582                 input buf_ord-doc.ship-date,
     1583                 input buf_ord-doc.doc-date,
     1584                 input buf_ord-doc.fact-date ,
     1585                 input buf_ord-doc.status_,
     1586                 input buf_ord-doc.flag_,
     1587                 input first-line,
     1588                 input v-gds ) .
     1589                         end.
     1590                         end.
     1591         if p-OrdDate = "ship-date" then do :
     1592           for each buf_ord-doc no-lock where
     1593                   buf_ord-doc.doc-type  = 'ОР':U and
     1594                   buf_ord-doc.obj-type  = obj-list.obj-type and
     1595                   buf_ord-doc.obj-code  = obj-list.obj-code and
     1596                   lookup ( buf_ord-doc.status_ , v-list-st) > 0  and
     1597                   buf_ord-doc.ship-date >= x-date-start and
     1598                   buf_ord-doc.ship-date <= x-date-end
     1599                           :
     1600               run make-tt-1 in this-procedure
     1601               ( input buf_ord-doc.doc-code,
     1602                 input buf_ord-doc.obj-type,
     1603                 input buf_ord-doc.obj-code,
     1604                 input buf_ord-doc.ship-date,
     1605                 input buf_ord-doc.doc-date,
     1606                 input buf_ord-doc.fact-date ,
     1607                 input buf_ord-doc.status_,
     1608                 input buf_ord-doc.flag_,
     1609                 input first-line,
     1610                 input v-gds ) .
     1611               end.
     1612           end.
     1613     end.
     1614     else do:
     1615         if p-OrdDate = "doc-date" then do :
     1616           for each buf_ord-doc no-lock where
     1617                   buf_ord-doc.doc-type  = 'ОР':U and
     1618                   buf_ord-doc.cli-type  = obj-list.obj-type and
     1619                   buf_ord-doc.cli-code  = obj-list.obj-code and
     1620                   lookup ( buf_ord-doc.status_ , v-list-st) > 0  and
     1621                   buf_ord-doc.doc-date >= x-date-start and
     1622                   buf_ord-doc.doc-date <= x-date-end
     1623                   :
     1624               run make-tt-1 in this-procedure
     1625               ( input buf_ord-doc.doc-code,
     1626                 input buf_ord-doc.cli-type,
     1627                 input buf_ord-doc.cli-code,
     1628                 input buf_ord-doc.ship-date,
     1629                 input buf_ord-doc.doc-date,
     1630                 input buf_ord-doc.fact-date ,
     1631                 input buf_ord-doc.status_,
     1632                 input buf_ord-doc.flag_,
     1633                 input first-line,
     1634                 input v-gds ) .
     1635           end.
     1636         end.
     1637         if p-OrdDate = "ship-date" then do :
     1638           for each buf_ord-doc use-index ByCli no-lock where
     1639                   buf_ord-doc.host-code = v-cntxt-host-code-obj  and
     1640                   buf_ord-doc.doc-type  = 'ОР':U and
     1641                   buf_ord-doc.cli-type  = obj-list.obj-type and
     1642                   buf_ord-doc.cli-code  = obj-list.obj-code and
     1643                   lookup ( buf_ord-doc.status_ , v-list-st) > 0  and
     1644                   buf_ord-doc.ship-date >= x-date-start and
     1645                   buf_ord-doc.ship-date <= x-date-end
     1646                   :
     1647               run make-tt-1 in this-procedure
     1648                 ( input buf_ord-doc.doc-code,
     1649                   input buf_ord-doc.cli-type,
     1650                   input buf_ord-doc.cli-code,
     1651                   input buf_ord-doc.ship-date,
     1652                   input buf_ord-doc.doc-date,
     1653                   input buf_ord-doc.fact-date ,
     1654                   input buf_ord-doc.status_,
     1655                   input buf_ord-doc.flag_,
     1656                   input first-line,
     1657                   input v-gds ) .
     1658           end.
     1659         end.
     1660     end.
     1661     end.
     1662     end.
     1663   end procedure.
     1664   procedure make-tt-1 :
     1665   define input parameter v-ord-doc-code  like ub.ord-doc.doc-code .
     1666   define input parameter v-ord-obj-type  like ub.ord-doc.obj-type .
     1667   define input parameter v-ord-obj-code  like ub.ord-doc.obj-code .
     1668   define input parameter v-ord-ship-date like ub.ord-doc.ship-date .
     1669   define input parameter v-ord-doc-date like ub.ord-doc.doc-date .
     1670   define input parameter v-ord-fact-date like ub.ord-doc.fact-date .
     1671   define input parameter v-ord-status    like ub.ord-doc.status_ .
     1672   define input parameter v-ord-flag      like ub.ord-doc.flag_ .
     1673   define input parameter first-line as logical no-undo .
     1674   define input parameter v-gds        as logical no-undo .
     1675   define buffer buf_ord-doc-rcv   for ub.ord-doc-rcv  .
     1676   define buffer buf_ord-line      for ub.ord-line  .
     1677   define buffer buf_trn-doc       for ub.trn-doc  .
     1678   define buffer buf_doc-line      for ub.doc-line  .
     1679   define buffer bufr_trn-doc      for ub.trn-doc  .
     1680   define buffer bufr_doc-line     for ub.doc-line  .
     1681   define buffer buf1_ord-doc-rcv  for ub.ord-doc-rcv  .
     1682   define buffer buf2_ord-doc-rcv  for ub.ord-doc-rcv  .
     1683   define buffer buf_goods         for ub.goods  .
     1684   define buffer buf_clients       for ub.clients  .
     1685   define variable v-recid     as recid no-undo .
     1686   define variable v-trn-date  as date no-undo .
     1687   define variable v-trn-n     as character no-undo .
     1688   define variable v-size-p    as integer no-undo initial 14.
     1689   define variable v-trn-dater as date no-undo .
     1690   define variable v-trn-nr    as character no-undo .
     1691   define variable v-size-r    as integer no-undo initial 14.
     1692   do
     1693   on error undo, return error return-value
     1694   :
     1695     find first buf_clients no-lock where
     1696               buf_clients.obj-type = v-ord-obj-type and
     1697               buf_clients.obj-code = v-ord-obj-code no-error .
     1698               for each buf_ord-line no-lock where
     1699             buf_ord-line.doc-code = v-ord-doc-code
     1700                       :
     1701                         v-recid = 0.
     1702               v-trn-dater = ?.
     1703               v-trn-nr = "" .
     1704               v-trn-date = ?.
     1705               v-trn-n = "" .
     1706               v-size-r = 0.
     1707               v-size-p = 0.
     1708                         if v-gds = true  then do:
     1709                             find first gds-list where gds-list.gds-code = buf_ord-line.gds-code no-error .
     1710                             if not available gds-list then next.
     1711                         end.
     1712                         find first temp-main where
     1713                                   temp-main.n-order  = buf_ord-line.doc-code
     1714                                   no-error .
     1715                         if not available temp-main then do:
     1716                           create temp-main.
     1717                           assign
     1718                             temp-main.n-order       = buf_ord-line.doc-code
     1719                   temp-main.date-order    = if p-OrdDate = "doc-date" then v-ord-doc-date else v-ord-ship-date
     1720                   temp-main.date-fact     = v-ord-fact-date
     1721                             temp-main.cli-codetype  = buf_clients.obj-type + string (buf_clients.obj-code)
     1722                             temp-main.cli-name      = buf_clients.obj-name
     1723                   temp-main.status-order  = v-ord-status + string(v-ord-flag,"+/-")
     1724                         .
     1725                         end.
     1726               for each buf1_ord-doc-rcv no-lock where buf1_ord-doc-rcv.doc-code = v-ord-doc-code ,
     1727                             each ub.ord-chain no-lock where
     1728                                 ub.ord-chain.doc-code = buf1_ord-doc-rcv.rcv-code and
     1729                                 ub.ord-chain.doc-type = 'rcv'                     and
     1730                                 ub.ord-chain.rel-doc-type = 'trn' ,
     1731               first buf_trn-doc no-lock
     1732                 where  buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code
     1733                           :
     1734                 v-recid = recid(buf1_ord-doc-rcv).
     1735                 find first buf_ord-doc-rcv no-lock where recid(buf_ord-doc-rcv) = v-recid no-error .
     1736                 find first buf_doc-line no-lock where
     1737                           buf_doc-line.doc-code  = buf_trn-doc.doc-code   and
     1738                           buf_doc-line.artic     = buf_ord-line.artic     and
     1739                           buf_doc-line.prod-type = buf_ord-line.prod-type and
     1740                           buf_doc-line.prod-code = buf_ord-line.prod-code
     1741                           no-error .
     1742                 find first temp-main where
     1743                             temp-main.n-order  = buf_ord-line.doc-code
     1744                             no-error .
     1745                 if available temp-main then do :
     1746                   if buf_trn-doc.doc-type = 'при':U then do :
     1747                     if v-trn-date = ? then do :
     1748                       v-trn-date = buf_trn-doc.fact-date.
     1749                     end.
     1750                     else do :
     1751                       if v-trn-date < buf_trn-doc.fact-date then do :
     1752                         v-trn-date = buf_trn-doc.fact-date.
     1753                       end.
     1754                     end.
     1755                     v-trn-n    = buf_trn-doc.doc-code.
     1756                     if lookup(v-trn-n,temp-main.n-trn-pri) = 0 then do :
     1757                       temp-main.n-trn-pri = temp-main.n-trn-pri + if temp-main.n-trn-pri = '' then v-trn-n else ',' + v-trn-n.
     1758                     end.
     1759                     v-size-p = length(trim(temp-main.n-trn-pri)).
     1760                     if v-size-p > v-size-pri then v-size-pri = v-size-p.
     1761                   end.
     1762                   if buf_trn-doc.doc-type = 'рас':U then do :
     1763                     if  v-trn-dater = ? then do :
     1764                       v-trn-dater = buf_trn-doc.fact-date.
     1765                     end.
     1766                     else do :
     1767                       if v-trn-dater < buf_trn-doc.fact-date then do :
     1768                         v-trn-dater = buf_trn-doc.fact-date.
     1769                       end.
     1770                     end.
     1771                     v-trn-nr    = buf_trn-doc.doc-code.
     1772                     temp-main.fact-qnty      = temp-main.fact-qnty +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1773                     if lookup(v-trn-nr,temp-main.n-trn-ras) = 0 then do :
     1774                       temp-main.n-trn-ras = temp-main.n-trn-ras + if temp-main.n-trn-ras = '' then v-trn-nr else ',' + v-trn-nr.
     1775                     end.
     1776                     v-size-r = length(trim(temp-main.n-trn-ras)).
     1777                     if v-size-r > v-size-ras then v-size-ras = v-size-r.
     1778                         end.
     1779                   if buf_trn-doc.doc-type = 'возврат':U then do :
     1780                     temp-main.fact-qnty = temp-main.fact-qnty -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1781                   end.
     1782                 end.
     1783                 find current temp-i.
     1784                 if buf_trn-doc.doc-type = 'рас':U then do :
     1785                   temp-i.fact-qnty        = temp-i.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1786                 end.
     1787                 if buf_trn-doc.doc-type = 'возврат':U then do :
     1788                   temp-i.fact-qnty        = temp-i.fact-qnty     -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1789                 end.
     1790               end.
     1791               find first temp-main where
     1792                           temp-main.n-order  = buf_ord-line.doc-code
     1793                           no-error .
     1794               if available temp-main then do :
     1795                         assign
     1796                             temp-main.date-fact-ras  = string( v-trn-dater , "99/99/9999")
     1797                             temp-main.date-fact-pri  = string( v-trn-date , "99/99/9999")
     1798                             temp-main.initial-qnty   = temp-main.initial-qnty  +  buf_ord-line.initial-qnty
     1799                             temp-main.order-qnty     = temp-main.order-qnty    +  buf_ord-line.order-qnty
     1800                             temp-main.qnty           = temp-main.qnty          +  buf_ord-line.qnty
     1801                             .
     1802                           if temp-main.date-fact-ras  = ? then temp-main.date-fact-ras  = "" .
     1803                           if temp-main.date-fact-pri  = ? then temp-main.date-fact-pri  = "" .
     1804                         find current temp-i.
     1805                         assign
     1806                           temp-i.initial-qnty     = temp-i.initial-qnty  +  buf_ord-line.initial-qnty
     1807                           temp-i.order-qnty       = temp-i.order-qnty    +  buf_ord-line.order-qnty
     1808                           temp-i.qnty             = temp-i.qnty          +  buf_ord-line.qnty
     1809                           .
     1810               end.
     1811     end.
     1812               assign
     1813                 temp-i.account-order    = temp-i.account-order + 1.
     1814       if v-ord-fact-date <> ? then do:
     1815         temp-i.strday           = temp-i.strday + string(v-ord-fact-date - v-ord-doc-date) + "," .
     1816                 end.
     1817               .
     1818           end.
     1819   end procedure.
     1820   procedure pshap :
     1821     do
     1822     on error undo, return error return-value
     1823     :
     1824     end.
     1825   end procedure.
     1826   procedure PrintPodval :
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830     end.
     1831   end procedure.
     1832   procedure PrintDet :
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836         for each temp-main no-lock where  break by temp-main.date-order :
     1837             run print-line in this-procedure .
     1838         end.
     1839     end.
     1840   end procedure.
     1841   procedure re-calc :
     1842   define input  parameter p-order-qnty             as decimal   no-undo .
     1843   define input  parameter p-qnty                   as decimal   no-undo .
     1844   define input  parameter p-fact-qnty              as decimal   no-undo .
     1845   define input  parameter p-str                    as character no-undo .
     1846   define output parameter p-prc_fact-qnty_qnty     as decimal   no-undo .
     1847   define output parameter p-prc_qnty_order-qnty    as decimal   no-undo .
     1848   define output parameter p-acc-day-trn            as decimal   no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852   assign
     1853     p-prc_fact-qnty_qnty  = (if p-qnty = 0 then 0 else  p-fact-qnty /  p-qnty) * 100
     1854     p-prc_qnty_order-qnty = (if p-order-qnty = 0 then 0 else p-qnty / p-order-qnty) * 100
     1855   .
     1856   define variable v-kol as integer   no-undo .
     1857   define variable v-sum as decimal   no-undo .
     1858   p-str = trim(p-str,",") .
     1859   v-sum = 0.
     1860   define variable v-nnn as integer   no-undo .
     1861   v-nnn = num-entries ( p-str ) .
     1862   repeat v-kol = 1 to  v-nnn :
     1863      v-sum = v-sum + integer ( entry ( v-kol , p-str ))  .
     1864   end.
     1865     p-acc-day-trn    = round( v-sum / v-kol  , 4 ) .
     1866     end.
     1867   end procedure.
     1868   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1869   procedure macr_excel_char :
     1870    do
     1871    on error undo, return error return-value
     1872    :
     1873    define input parameter  p-val as character no-undo .
     1874    define input parameter  p-row as integer no-undo .
     1875    define input parameter  p-col as integer no-undo .
     1876    if p-val = ? then p-val = "" .
     1877       put stream macr_excel unformatted
     1878             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1879    end.
     1880   end procedure.
     1881   procedure macr_excel_char_with_format :
     1882    do
     1883    on error undo, return error return-value
     1884    :
     1885    define input parameter  p-val as character no-undo .
     1886    define input parameter  p-row as integer no-undo .
     1887    define input parameter  p-col as integer no-undo .
     1888    if p-val = ? then p-val = "" .
     1889       put stream macr_excel unformatted
     1890             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1891       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1892       put stream macr_excel unformatted
     1893             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1894    end.
     1895   end procedure.
     1896   procedure macr_excel_cell_format :
     1897    do
     1898    on error undo, return error return-value
     1899    :
     1900    define input parameter  p-val    as character no-undo .
     1901    define input parameter  p-row    as integer   no-undo .
     1902    define input parameter  p-col    as integer   no-undo .
     1903    define input parameter  p-format as character no-undo .
     1904    if p-val = ? then p-val = "" .
     1905       put stream macr_excel unformatted
     1906             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1907       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1908       put stream macr_excel unformatted
     1909             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1910    end.
     1911   end procedure.
     1912   procedure macr_excel_sum :
     1913    do
     1914    on error undo, return error return-value
     1915    :
     1916    define input parameter  p-row as integer no-undo .
     1917    define input parameter  p-col as integer no-undo .
     1918    define input parameter  p-row1 as integer no-undo .
     1919    define input parameter  p-col1 as integer no-undo .
     1920    define input parameter  p-row2 as integer no-undo .
     1921    define input parameter  p-col2 as integer no-undo .
     1922       put stream macr_excel unformatted
     1923             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1924    end.
     1925   end procedure.
     1926   procedure macr_excel_dec :
     1927    do
     1928    on error undo, return error return-value
     1929    :
     1930    define input parameter  p-val as character no-undo .
     1931    define input parameter  p-row as integer   no-undo .
     1932    define input parameter  p-col as integer   no-undo .
     1933     if p-val = ? then p-val =  "" .
     1934      put  stream macr_excel unformatted
     1935           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1936    end.
     1937   end procedure.
     1938   procedure macr_cell_format :
     1939    do
     1940    on error undo, return error return-value
     1941    :
     1942    define input parameter  p-size   as integer   no-undo .
     1943    define input parameter  p-bold   as logical   no-undo .
     1944    define input parameter  p-italic as logical   no-undo .
     1945    define input parameter  p-color  as integer   no-undo .
     1946    define input parameter  p-row    as integer   no-undo .
     1947    define input parameter  p-col    as integer   no-undo .
     1948    define input parameter  p-row-2  as integer   no-undo .
     1949    define input parameter  p-col-2  as integer   no-undo .
     1950     if p-size = ? then p-size = 10 .
     1951     if p-bold = ? then p-bold = false .
     1952     if p-italic = ? then p-italic = false .
     1953     if p-row-2 = ? then p-row-2 = p-row .
     1954     if p-col-2 = ? then p-col-2 = p-col .
     1955     put  stream macr_excel unformatted
     1956      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1957     if p-color <> ? then do:
     1958        put  stream macr_excel unformatted
     1959          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1960     end.
     1961     put  stream macr_excel unformatted
     1962          substitute('format.font(,&1,&2,&3)' , p-size,
     1963                                           string ( p-bold  , "true/false" ) ,
     1964                                           string ( p-italic , "true/false" )
     1965                                           ) + chr(10) .
     1966    end.
     1967   end procedure.
     1968   procedure macr_cell_size :
     1969    do
     1970    on error undo, return error return-value
     1971    :
     1972    define input parameter  p-w   as integer   no-undo .
     1973    define input parameter  p-l   as integer   no-undo .
     1974    define input parameter  p-row    as integer   no-undo .
     1975    define input parameter  p-col    as integer   no-undo .
     1976    define input parameter  p-row-2  as integer   no-undo .
     1977    define input parameter  p-col-2  as integer   no-undo .
     1978     if p-row-2 = ? then p-row-2 = p-row .
     1979     if p-col-2 = ? then p-col-2 = p-col .
     1980     if p-w = ? then    p-w = 0 .
     1981     if p-l = ? then    p-l = 0 .
     1982    define variable s-w as character no-undo .
     1983    define variable s-l as character no-undo .
     1984    if p-w = 0 then s-w = "" .
     1985               else s-w = string(p-w)  .
     1986    if p-l = 0 then s-l = "" .
     1987               else s-l = string(p-l)  .
     1988   put  stream macr_excel unformatted
     1989        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1990   put  stream macr_excel unformatted
     1991        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1992   put  stream macr_excel unformatted
     1993        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1994    end.
     1995   end procedure.
     1996   procedure proc-print-header :
     1997    do
     1998    on error undo, return error return-value
     1999    :
     2000      find first sheetf .
     2001        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2002        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2003        var-1 =  num#str# .
     2004        repeat c-c = 1 to sheetf.excel-row-title :
     2005        num#str# = num#str# + 1 .
     2006        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2007        do c-i = 1 to p-var :
     2008           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2009           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2010           num#col# = c-i .
     2011           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2012           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2013        end.
     2014       c-i = 0.
     2015       end.
     2016       run macr_cell_format (
     2017           10       ,
     2018           true     ,
     2019           false    ,
     2020           35       ,
     2021           var-1 + 1,
     2022           1        ,
     2023           num#str# ,
     2024           num#col# )
     2025           .
     2026     put  stream macr_excel unformatted
     2027          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2028          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2029          .
     2030    end.
     2031   end procedure.
     2032   procedure end-proc :
     2033    do
     2034    on error undo, return error return-value
     2035    :
     2036     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2037     OUTPUT to VALUE (v-file-name) .
     2038     for each temp-param :
     2039       export  temp-param  .
     2040     end.
     2041    end.
     2042   end procedure.
