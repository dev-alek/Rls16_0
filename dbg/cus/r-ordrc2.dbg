     1394   run macr_excel_char in this-procedure (  temp-main.n-trn-ras         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1395   run macr_excel_char in this-procedure (  temp-main.date-fact-pri     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1396   run macr_excel_char in this-procedure (  temp-main.n-trn-pri         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1397   run macr_excel_dec in this-procedure ( temp-main.initial-qnty        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1398   run macr_excel_dec in this-procedure ( temp-main.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1399   run macr_excel_dec in this-procedure ( temp-main.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1400   run macr_excel_dec in this-procedure ( temp-main.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1401   run macr_excel_dec in this-procedure ( temp-main.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
