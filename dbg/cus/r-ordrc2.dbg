     1374   procedure print-line :
     1375   define variable vacc-day-trn as decimal   no-undo .
     1376   num#str# = num#str# + 1.
     1377   num#col# = 1.
     1378   run re-calc in this-procedure (
     1379       input  temp-main.order-qnty
     1380     , input  temp-main.qnty
     1381     , input  temp-main.fact-qnty
     1382     , input  ""
     1383     , output temp-main.prc_fact-qnty_qnty
     1384     , output temp-main.prc_qnty_order-qnty
     1385     , output vacc-day-trn
     1386     ).
     1387   run macr_excel_char in this-procedure (  temp-main.cli-codetype      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1388   run macr_excel_char in this-procedure (  temp-main.cli-name          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1389   run macr_excel_char in this-procedure (  string(temp-main.date-order , "99/99/9999") , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1390   run macr_excel_char in this-procedure (  string(temp-main.date-fact , "99/99/9999") , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1391   run macr_excel_char in this-procedure (  temp-main.n-order           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1392   run macr_excel_char in this-procedure (  temp-main.status-order      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
