     1357   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   procedure gen-key-rec :
     1360     define input  parameter p-tbl-name    as character no-undo.
     1361     define input  parameter p-bh_tbl-name as handle    no-undo.
     1362     define output parameter p-key-rec     as character no-undo.
     1363     do
     1364     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1365     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1366     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1367     :
     1368       define variable fh               as handle    no-undo .
     1369       define variable v-ok             as logical   no-undo .
     1370       define variable v-inform         as character no-undo .
     1371       define variable v-ind            as integer   no-undo .
     1372       define variable v-idx-field-qnty as integer   no-undo .
     1373       if p-tbl-name = ?
     1374         or p-tbl-name = "":U
     1375       then do:
     1376         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
     1377       end.
     1378       if not p-bh_tbl-name:available then do:
     1379         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
     1380       end.
     1381       assign
     1382         p-key-rec = p-tbl-name
     1383         v-inform  = p-bh_tbl-name:index-information(1)
     1384         v-ind     = 2
     1385       .
     1386       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1387       on error undo, return error
     1388       :
     1389         assign
     1390           v-inform = p-bh_tbl-name:index-information( v-ind )
     1391           v-ind    = v-ind + 1
     1392         .
     1393       end.
     1394       if v-inform = ?
     1395         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1396         or entry( 3, v-inform, ",":U ) <> "1":U
     1397       then do:
     1398         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
     1399       end.
     1400       else do:
     1401         assign
     1402           v-idx-field-qnty = num-entries( v-inform ) - 4
     1403         .
     1404         if v-idx-field-qnty < 2 then do:
     1405           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
     1406         end.
     1407         do v-ind = 1 to v-idx-field-qnty by 2
     1408         on error undo, return error
     1409         :
     1410           assign
     1411             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1412             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1413           .
     1414         end.
     1415       end.
     1416       if p-key-rec = ? then do:
     1417         assign
     1418           p-key-rec = "":U
     1419         .
     1420         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
     1421       end.
     1422     end.
     1423     return.
     1424   end procedure.
     1425   procedure gen-where-keyr-tab :
     1426     define input  parameter i-tableSerach as character no-undo.
     1427     define input  parameter i-tablekey   as character  no-undo.
     1428     define input  parameter p-key-rec    as character  no-undo.
     1429     define input  parameter p-key-handle as handle     no-undo .
     1430     define input  parameter p-db-name    as character  no-undo .
     1431     define input  parameter p-tt-handle  as handle     no-undo .
     1432     define output parameter o-Where      as character  no-undo.
     1433     do
     1434     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1435     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1436     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1437     :
     1438       define variable v-full-tbl-name  as character no-undo .
     1439       define variable bh_tbl-name      as handle    no-undo .
     1440       define variable fh_key           as handle    no-undo .
     1441       define variable fh_search        as handle    no-undo .
     1442       define variable v-field-num      as integer   no-undo .
     1443       define variable v-count-fld      as integer   no-undo .
     1444       define variable v-inform         as character no-undo .
     1445       define variable v-ind            as integer   no-undo .
     1446       define variable v-idx-field-qnty as integer   no-undo .
     1447       define variable v-field-name     as character no-undo .
     1448       define variable v-field-val      as character no-undo .
     1449       define variable v-word-link      as character no-undo .
     1450       define variable vTable           as character no-undo.
     1451       define variable bh_tbl-key       as handle    no-undo .
     1452       assign
     1453         p-key-rec = trim( p-key-rec )
     1454       .
     1455       if p-key-handle <> ? then do:
     1456         if not valid-handle(p-key-handle)
     1457            or p-key-handle:type <> "buffer"
     1458         then do:
     1459           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
     1460         end.
     1461         if num-entries( p-key-rec, chr(3) ) > 1
     1462           or p-key-rec = ?
     1463           or p-key-rec = "":U
     1464         then do:
     1465           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
     1466         end.
     1467       end.
     1468       else do:
     1469         if p-key-rec = ?
     1470           or p-key-rec = "":U
     1471         then do:
     1472           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1473         end.
     1474       end.
     1475       assign
     1476         vTable = entry( 1 , p-key-rec, chr(3) )
     1477       .
     1478       if p-tt-handle <> ?
     1479         and ( not valid-handle(p-tt-handle)
     1480               or p-tt-handle:type <> "buffer"
     1481             )
     1482       then do:
     1483         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
     1484       end.
     1485       if p-tt-handle = ? then do:
     1486         assign
     1487           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1488         .
     1489         create buffer bh_tbl-name for table v-full-tbl-name .
     1490       end.
     1491       else do:
     1492         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1493       end.
     1494       assign
     1495         v-inform = bh_tbl-name:index-information(1)
     1496         v-ind    = 2
     1497       .
     1498       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1499       on error undo, return error
     1500       :
     1501         assign
     1502           v-inform = bh_tbl-name:index-information( v-ind )
     1503           v-ind    = v-ind + 1
     1504         .
     1505       end.
     1506       if v-inform = ?
     1507         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1508         or entry( 3, v-inform, ",":U ) <> "1":U
     1509       then do:
     1510         delete object bh_tbl-name no-error.
     1511         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
     1512       end.
     1513       assign
     1514         v-idx-field-qnty = num-entries( v-inform ) - 4
     1515       .
     1516       if v-idx-field-qnty < 2 then do:
     1517         delete object bh_tbl-name no-error.
     1518         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
     1519       end.
     1520       assign
     1521         o-where     = "where":U
     1522         v-word-link = "":U
     1523         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1524         v-count-fld = 0
     1525       .
     1526       if i-tablekey ne "" and i-tablekey ne ?
     1527       then do:
     1528         assign
     1529           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1530         .
     1531         create buffer bh_tbl-key for table v-full-tbl-name .
     1532       end.
     1533       if i-tableSerach ne "" and i-tableSerach ne ?
     1534       then do:
     1535         delete object bh_tbl-name no-error.
     1536         assign
     1537           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1538         .
     1539         create buffer bh_tbl-name for table v-full-tbl-name .
     1540       end.
     1541       block_where:
     1542       do v-ind = 1 to v-idx-field-qnty by 2
     1543       on error undo, return error
     1544       :
     1545         assign
     1546           v-count-fld = v-count-fld + 1
     1547         .
     1548         if p-key-handle = ?
     1549           and v-count-fld > v-field-num
     1550         then do:
     1551           leave block_where.
     1552         end.
     1553         define variable VfieldKeyTable as handle no-undo.
     1554         assign
     1555           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1556           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1557         .
     1558         if     bh_tbl-key ne ?
     1559         then do:
     1560            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1561            if VfieldKeyTable eq ?
     1562            then next block_where.
     1563         end.
     1564         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1565         then
     1566            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1567         else
     1568            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1569         if p-key-handle = ? then do:
     1570           assign
     1571             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1572           .
     1573         end.
     1574         else do:
     1575           assign
     1576             fh_key = p-key-handle:buffer-field( v-field-name )
     1577           .
     1578           if fh_key = ?
     1579             or not valid-handle( fh_key )
     1580           then do:
     1581             delete object bh_tbl-name.
     1582             if     bh_tbl-key ne ?
     1583             then
     1584                delete object bh_tbl-key.
     1585             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     1586           end.
     1587           assign
     1588             v-field-val = fh_key:buffer-value
     1589           .
     1590         end.
     1591         if fh_search:data-type ="character":U then do:
     1592           assign
     1593             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1594             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1595             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1596             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1597             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1598             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1599             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1600             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1601             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1602             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1603             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1604             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1605             v-field-val = substitute( '"&1"', v-field-val )
     1606           .
     1607         end.
     1608         assign
     1609           o-where = substitute( "&1 &2", o-where, v-field-val )
     1610         .
     1611         if v-word-link = "":U then do:
     1612           assign
     1613             v-word-link = "and":U
     1614           .
     1615         end.
     1616       end.
     1617       delete object bh_tbl-name.
     1618       if     bh_tbl-key ne ?
     1619       then
     1620          delete object bh_tbl-key.
     1621       if p-key-handle = ?
     1622         and v-count-fld <> v-field-num
     1623       then do:
     1624         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1625       end.
     1626     end.
     1627   end procedure.
     1628   procedure gen-hn-keyr-tab :
     1629     define input  parameter i-tableSerach as character no-undo.
     1630     define input  parameter i-tablekey   as character no-undo.
     1631     define input  parameter p-key-rec    as character no-undo.
     1632     define input  parameter p-key-handle as handle    no-undo .
     1633     define input  parameter p-db-name    as character no-undo .
     1634     define input  parameter p-tt-handle  as handle    no-undo .
     1635     define input  parameter p-stts-lock  as integer   no-undo .
     1636     define output parameter o-hn         as handle    no-undo.
     1637     define variable v-full-tbl-name as character no-undo.
     1638     define variable v-where         as character no-undo.
     1639     define variable bh_tbl-name     as handle    no-undo.
     1640     define variable vTable          as character no-undo.
     1641     do
     1642     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1643     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1644     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1645         run gen-where-keyr-tab(i-tableSerach,
     1646                                i-tablekey,
     1647                                p-key-rec,
     1648                                p-key-handle,
     1649                                p-db-name,
     1650                                p-tt-handle,
     1651                                output v-where).
     1652         if i-tableSerach ne "" and i-tableSerach ne ?
     1653         then do:
     1654            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1655            create buffer bh_tbl-name for table v-full-tbl-name .
     1656         end.
     1657         else do:
     1658            if p-tt-handle = ? then do:
     1659               assign
     1660                  vTable = entry( 1 , p-key-rec, chr(3) )
     1661               .
     1662               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1663               create buffer bh_tbl-name for table v-full-tbl-name .
     1664            end.
     1665            else do:
     1666               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1667            end.
     1668         end.
     1669         if p-tt-handle = ? then do:
     1670            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1671         end.
     1672         else do:
     1673            bh_tbl-name:find-first( v-where ) no-error .
     1674         end.
     1675         o-hn = bh_tbl-name.
     1676      end.
     1677   end procedure.
     1678   procedure gen-hn-keyr :
     1679     define input  parameter p-key-rec    as character no-undo.
     1680     define input  parameter p-key-handle as handle    no-undo .
     1681     define input  parameter p-db-name    as character no-undo .
     1682     define input  parameter p-tt-handle  as handle    no-undo .
     1683     define input  parameter p-stts-lock  as integer   no-undo .
     1684     define output parameter o-hn         as handle    no-undo.
     1685     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1686   end.
     1687   procedure gen-row-keyr :
     1688     define input  parameter p-key-rec    as character no-undo.
     1689     define input  parameter p-key-handle as handle    no-undo .
     1690     define input  parameter p-db-name    as character no-undo .
     1691     define input  parameter p-tt-handle  as handle    no-undo .
     1692     define input  parameter p-stts-lock  as integer   no-undo .
     1693     define output parameter p-tbl-row    as rowid     no-undo.
     1694     define output parameter p-tbl-name   as character no-undo.
     1695     define variable vHn as handle no-undo.
     1696       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1697       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1698       p-tbl-name =  vHn:table.
     1699       delete object vHn no-error.
     1700     if p-tbl-row = ? then do:
     1701       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     1702     end.
     1703     else do:
     1704       return.
     1705     end.
     1706   end procedure.
     1707   procedure gen-key-fv :
     1708     define input  parameter p-key-rec    as character no-undo .
     1709     define output parameter p-field-list as character no-undo .
     1710     define output parameter p-value-list as character no-undo.
     1711     do
     1712     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1713     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1714     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1715     :
     1716       define variable v-full-tbl-name  as character no-undo .
     1717       define variable bh_tbl-name      as handle    no-undo .
     1718       define variable v-tbl-name       as character no-undo .
     1719       define variable v-field-num      as integer   no-undo .
     1720       define variable v-count-fld      as integer   no-undo .
     1721       define variable v-inform         as character no-undo .
     1722       define variable v-ind            as integer   no-undo .
     1723       define variable v-idx-field-qnty as integer   no-undo .
     1724       define variable v-delim-key      as character no-undo .
     1725       if p-key-rec = ?
     1726         or p-key-rec = "":U
     1727       then do:
     1728         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1729       end.
     1730       assign
     1731         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1732         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1733       .
     1734       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1735       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     1736       assign
     1737         v-inform = bh_tbl-name:index-information(1)
     1738         v-ind    = 2
     1739       .
     1740       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1741       on error undo, return error
     1742       :
     1743         assign
     1744           v-inform = bh_tbl-name:index-information( v-ind )
     1745           v-ind    = v-ind + 1
     1746         .
     1747       end.
     1748       if v-inform = ?
     1749         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1750         or entry( 3, v-inform, ",":U ) <> "1":U
     1751       then do:
     1752         delete object bh_tbl-name no-error.
     1753         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1754       end.
     1755       assign
     1756         v-idx-field-qnty = num-entries( v-inform ) - 4
     1757       .
     1758       if v-idx-field-qnty < 2 then do:
     1759         delete object bh_tbl-name no-error.
     1760         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1761       end.
     1762       assign
     1763         p-field-list = "":U
     1764         p-value-list = "":U
     1765         v-delim-key  = "":U
     1766         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1767         v-count-fld  = 0
     1768       .
     1769       block_where:
     1770       do v-ind = 1 to v-idx-field-qnty by 2
     1771       on error undo, return error
     1772       :
     1773         assign
     1774           v-count-fld = v-count-fld + 1
     1775         .
     1776         if v-count-fld > v-field-num then do:
     1777           leave block_where.
     1778         end.
     1779         assign
     1780           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1781           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1782         .
     1783         if v-ind = 1 then do:
     1784           assign
     1785             v-delim-key = chr(3)
     1786           .
     1787         end.
     1788       end.
     1789       delete object bh_tbl-name.
     1790       if v-count-fld <> v-field-num then do:
     1791         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1792       end.
     1793     end.
     1794   end procedure.
     1795   procedure gen-key-field :
     1796     define input  parameter p-table      as character no-undo .
     1797     define output parameter p-field-list as character no-undo .
     1798     do
     1799     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1800     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1801     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1802     :
     1803       define variable v-full-tbl-name  as character no-undo .
     1804       define variable bh_tbl-name      as handle    no-undo .
     1805       define variable v-tbl-name       as character no-undo .
     1806       define variable v-field-num      as integer   no-undo .
     1807       define variable v-count-fld      as integer   no-undo .
     1808       define variable v-inform         as character no-undo .
     1809       define variable v-ind            as integer   no-undo .
     1810       define variable v-idx-field-qnty as integer   no-undo .
     1811       define variable v-delim-key      as character no-undo .
     1812       if p-table = ?
     1813         or p-table = "":U
     1814       then do:
     1815         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     1816       end.
     1817       assign
     1818         v-tbl-name      = p-table
     1819         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1820       .
     1821       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1822       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     1823       assign
     1824         v-inform = bh_tbl-name:index-information(1)
     1825         v-ind    = 2
     1826       .
     1827       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1828       on error undo, return error
     1829       :
     1830         assign
     1831           v-inform = bh_tbl-name:index-information( v-ind )
     1832           v-ind    = v-ind + 1
     1833         .
     1834       end.
     1835       if v-inform = ?
     1836         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1837         or entry( 3, v-inform, ",":U ) <> "1":U
     1838       then do:
     1839         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1840       end.
     1841       assign
     1842         v-idx-field-qnty = num-entries( v-inform ) - 4
     1843       .
     1844       if v-idx-field-qnty < 2 then do:
     1845         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1846       end.
     1847       assign
     1848         p-field-list = "":U
     1849         v-delim-key  = "":U
     1850         v-count-fld  = 0
     1851       .
     1852       block_where:
     1853       do v-ind = 1 to v-idx-field-qnty by 2
     1854       on error undo, return error
     1855       :
     1856         assign
     1857           v-count-fld = v-count-fld + 1
     1858         .
     1859         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1860         if v-ind = 1 then do:
     1861           assign
     1862             v-delim-key = chr(3)
     1863           .
     1864         end.
     1865       end.
     1866       delete object bh_tbl-name.
     1867     end.
     1868   end procedure.
     1869   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   FUNCTION get-region RETURNS CHARACTER
     1871     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1872     define variable par-region as character no-undo.
     1873     if parhost-code = 0 and
     1874          parobj-type = "":U and
     1875          parobj-code = 0 then do:
     1876          par-region = "Глобально".
     1877          return par-region.
     1878       end.
     1879       if parobj-type = 'орг':U then do:
     1880          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1881          return par-region.
     1882       end.
     1883       if parobj-type = 'регион':U
     1884       then do:
     1885          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1886          return par-region.
     1887       end.
     1888       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1889       return par-region.
     1890   END FUNCTION.
     1891   FUNCTION get-objregion RETURNS CHARACTER
     1892     (  input parobj-type as character, input parobj-code as integer ) :
     1893     define variable par-region as character no-undo.
     1894     if  parobj-type = "":U and
     1895         parobj-code = 0
     1896     then do:
     1897        par-region = "Глобально".
     1898     end.
     1899     else if parobj-type = 'орг':U
     1900     then do:
     1901        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1902     end.
     1903     else if parobj-type = 'регион':U
     1904     then do:
     1905        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1906     end.
     1907     else
     1908        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1909     return par-region.
     1910   END FUNCTION.
     1911   FUNCTION calldscr returns character ( input p-call-id as character):
     1912   define variable v-descr as character no-undo .
     1913   define variable v-field-list as character no-undo .
     1914   define variable v-value-list as character no-undo.
     1915   define variable v-prop-label as character no-undo .
     1916   define variable v-node-label as character no-undo .
     1917   define variable v-dt-code as integer no-undo .
     1918   define variable v-host-code as integer no-undo .
     1919   define variable v-obj-type as character no-undo .
     1920   define variable v-obj-code as integer no-undo .
     1921   define variable v-label as character no-undo .
     1922   define variable v-node-code as integer no-undo .
     1923   define buffer buf_prop-head for ub.prop-head.
     1924   define buffer buf_prop-ref for ub.prop-ref.
     1925   define buffer buf_prop-map for ub.prop-map.
     1926   run gen-key-fv in this-procedure ( input p-call-id
     1927                                     ,output v-field-list
     1928                                     ,output v-value-list) no-error .
     1929   if error-status:error then return p-call-id.
     1930   CASE entry(1, p-call-id, chr(3)):
     1931     when 'dis-card-type':U then do:
     1932       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1933                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1934                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1935                            ).
     1936     end.
     1937     when 'dis-card':U then do:
     1938       v-descr = substitute("ДК: № &1"
     1939                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1940                            ).
     1941     end.
     1942     when 'dis-card-property':U then do:
     1943       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1944       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1945       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1946       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1947       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1948       find first buf_prop-ref no-lock where
     1949                 buf_prop-ref.dt-code = v-dt-code no-error .
     1950       if available buf_prop-ref then do:
     1951         find first buf_prop-head no-lock where
     1952                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1953         v-prop-label = buf_prop-head.prop-label.
     1954         find first buf_prop-map no-lock where
     1955                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1956               and buf_prop-map.node-code = v-node-code no-error .
     1957         if available buf_prop-map then do:
     1958           v-label = buf_prop-map.node-label.
     1959         end.
     1960       end.
     1961       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1962                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1963                            ,v-prop-label
     1964                            ,v-label
     1965                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1966                            ).
     1967     end.
     1968     when 'clients':U then do:
     1969       v-descr = substitute("&1&2"
     1970                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1971                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1972                            ).
     1973     end.
     1974     when 'ext-system':U then do:
     1975       v-descr = substitute("Внешняя система &1"
     1976                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1977                            ).
     1978     end.
     1979     WHEN 'thbj-attr':U then do:
     1980       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1981       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1982       then do:
     1983         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1984           v-descr = "Операции с товарами".
     1985         end.
     1986         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1987           v-descr = "Операции с клиентами".
     1988         end.
     1989         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1990           v-descr = "Операции с группами товаров".
     1991         end.
     1992         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1993           v-descr = "Операции с группами клиентов".
     1994         end.
     1995         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1996           v-descr = "Операции с чеками на POS IBS-TH".
     1997         end.
     1998         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1999           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     2000         end.
     2001         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     2002           v-descr = "Операции в системе электронного документооборота".
     2003         end.
     2004         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     2005           v-descr = "Операции со справочниками".
     2006         end.
     2007         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     2008           v-descr = "Операции с ДНЦ и переоценками".
     2009         end.
     2010         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     2011           v-descr = "Отчеты".
     2012         end.
     2013         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     2014           v-descr = "Операции с заказами".
     2015         end.
     2016       end.
     2017     end.
     2018     when 'cash-desk':U then do:
     2019       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     2020                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     2021                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     2022                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     2023                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     2024                            ).
     2025     end.
     2026     when 'ext-file':U then do:
     2027       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     2028                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     2029                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     2030                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     2031                            ).
     2032     end.
     2033   end case.
     2034   return v-descr.
     2035   end function.
     2036   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2037   DEFINE VARIABLE v-dir AS CHARACTER NO-UNDO.
     2038   DEFINE VARIABLE v-file-rule AS CHARACTER NO-UNDO.
     2039   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     2040   DEFINE VARIABLE v-dc-type AS CHARACTER NO-UNDO.
     2041   define variable v-emitent-host-code like ub.dis-card-type.emitent-host-code no-undo .
     2042   define variable v-rule-profile-id as integer no-undo init 12.
     2043   define variable v-codex-id as integer no-undo init 5.
     2044   define variable v-ruleset-id as integer no-undo init 1.
     2045   DEFINE BUTTON b-dc-type
     2046        IMAGE-UP FILE "btn-down-arrow":U
     2047        IMAGE-DOWN FILE "btn-down-arrow":U
     2048        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2049        LABEL "..."
     2050        SIZE 3.6 BY 1.03.
     2051   DEFINE BUTTON b-dir-sel
     2052        IMAGE-UP FILE "btn-down-arrow":U
     2053        IMAGE-DOWN FILE "btn-down-arrow":U
     2054        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2055        LABEL "..."
     2056        SIZE 3.6 BY 1.03.
     2057   DEFINE BUTTON B-exit AUTO-GO
     2058        LABEL "&Ввод"
     2059        SIZE 10 BY 1
     2060        BGCOLOR 8 .
     2061   DEFINE BUTTON B-Help
     2062        LABEL "Помо&щь"
     2063        SIZE 3 BY 1
     2064        BGCOLOR 8 .
     2065   DEFINE BUTTON b-param
     2066        LABEL "&Параметры"
     2067        SIZE 10 BY 1.
     2068   DEFINE BUTTON b-quit AUTO-END-KEY
     2069        LABEL "&Отмена"
     2070        SIZE 10 BY 1
     2071        BGCOLOR 8 .
     2072   DEFINE BUTTON b-rule-profile
     2073        IMAGE-UP FILE "btn-down-arrow":U
     2074        IMAGE-DOWN FILE "btn-down-arrow":U
     2075        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2076        LABEL "..."
     2077        SIZE 3.6 BY 1.03.
     2078   DEFINE VARIABLE f-dc-type-label AS CHARACTER FORMAT "X(256)":U INITIAL "Тип ДК для экспорта"
     2079         VIEW-AS TEXT
     2080        SIZE 29 BY .67
     2081        FGCOLOR 4  NO-UNDO.
     2082   DEFINE VARIABLE f-file-seq-label-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Местоположение счетчика в имени файла"
     2083         VIEW-AS TEXT
     2084        SIZE 38.5 BY .67
     2085        FGCOLOR 4  NO-UNDO.
     2086   DEFINE VARIABLE f-rs-dir-label AS CHARACTER FORMAT "X(256)":U INITIAL "Настройка директории экспорта данных"
     2087         VIEW-AS TEXT
     2088        SIZE 40 BY .67
     2089        FGCOLOR 4  NO-UNDO.
     2090   DEFINE VARIABLE f-rs-file-rule-label AS CHARACTER FORMAT "X(256)":U INITIAL "Настройка формирования имени файла экспорта"
     2091         VIEW-AS TEXT
     2092        SIZE 45.5 BY .67
     2093        FGCOLOR 4  NO-UNDO.
     2094   DEFINE VARIABLE f-seq-label AS CHARACTER FORMAT "X(256)":U INITIAL "|"
     2095         VIEW-AS TEXT
     2096        SIZE 2 BY .67
     2097        FGCOLOR 4  NO-UNDO.
     2098   DEFINE VARIABLE file-name-1 AS CHARACTER FORMAT "X(256)":U
     2099        LABEL "Имя файла"
     2100        VIEW-AS FILL-IN
     2101        SIZE 14 BY 1
     2102        BGCOLOR 8  NO-UNDO.
     2103   DEFINE VARIABLE file-name-2 AS CHARACTER FORMAT "X(256)":U
     2104        VIEW-AS FILL-IN
     2105        SIZE 14 BY 1
     2106        BGCOLOR 8  NO-UNDO.
     2107   DEFINE VARIABLE file-seq AS CHARACTER FORMAT "X(256)":U INITIAL "?"
     2108        VIEW-AS FILL-IN
     2109        SIZE 2 BY 1
     2110        BGCOLOR 8  NO-UNDO.
     2111   DEFINE VARIABLE v-dir-name AS CHARACTER FORMAT "X(256)":U
     2112        LABEL "Директория"
     2113        VIEW-AS FILL-IN
     2114        SIZE 82.5 BY 1
     2115        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     2116   DEFINE VARIABLE rs-dir AS CHARACTER
     2117        VIEW-AS RADIO-SET VERTICAL
     2118        RADIO-BUTTONS
     2119             "берется из Ini-файла ([schedule-free] dctxt-e_out=)", "ini",
     2120   "привязана к строке расписания", "other"
     2121        SIZE 55 BY 2 NO-UNDO.
     2122   DEFINE VARIABLE RS-file-rule AS CHARACTER
     2123        VIEW-AS RADIO-SET VERTICAL
     2124        RADIO-BUTTONS
     2125             "С помощью наращиваемого счетчика", "seq",
     2126   "Постоянное имя", "const"
     2127        SIZE 38 BY 2.27 NO-UNDO.
     2128   DEFINE QUERY Dialog-Frame FOR
     2129         X_rule-profile,
     2130         ub.rule,
     2131         X_dis-card-type SCROLLING.
     2132   DEFINE FRAME Dialog-Frame
     2133        B-exit AT ROW 1 COL 1
     2134        b-quit AT ROW 1 COL 11
     2135        B-Help AT ROW 1 COL 94.8
     2136        rs-dir AT ROW 4 COL 2 NO-LABEL
     2137        b-dir-sel AT ROW 5 COL 60
     2138        v-dir-name AT ROW 6.27 COL 13 COLON-ALIGNED
     2139        RS-file-rule AT ROW 8.77 COL 2 NO-LABEL
     2140        file-name-1 AT ROW 8.77 COL 43
     2141        file-seq AT ROW 8.77 COL 66 COLON-ALIGNED NO-LABEL
     2142        file-name-2 AT ROW 8.77 COL 68 COLON-ALIGNED NO-LABEL
     2143        X_rule-profile.name AT ROW 12.2 COL 8 COLON-ALIGNED WIDGET-ID 10
     2144             LABEL "Профайл"
     2145             VIEW-AS FILL-IN
     2146             SIZE 79 BY 1
     2147        b-rule-profile AT ROW 12.27 COL 90 WIDGET-ID 26
     2148        ub.X_rule.name AT ROW 13.27 COL 10 NO-LABEL WIDGET-ID 18
     2149             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2150             SIZE 79.5 BY 2
     2151        b-param AT ROW 17.53 COL 36 WIDGET-ID 14
     2152        X_dis-card-type.type AT ROW 17.8 COL 2.5 NO-LABEL WIDGET-ID 24
     2153             VIEW-AS FILL-IN
     2154             SIZE 10 BY 1
     2155             BGCOLOR 8
     2156        b-dc-type AT ROW 17.8 COL 13.5 WIDGET-ID 2
     2157        f-rs-dir-label AT ROW 2.77 COL 2.5 COLON-ALIGNED NO-LABEL
     2158        f-rs-file-rule-label AT ROW 7.77 COL 1 COLON-ALIGNED NO-LABEL
     2159        f-seq-label AT ROW 10 COL 68 NO-LABEL
     2160        f-file-seq-label-2 AT ROW 11 COL 50 COLON-ALIGNED NO-LABEL
     2161        f-dc-type-label AT ROW 16.77 COL 2 NO-LABEL WIDGET-ID 6
     2162        X_dis-card-type.emitent-host-code AT ROW 17.8 COL 24.5 COLON-ALIGNED WIDGET-ID 22
     2163             LABEL "Эмитент"
     2164              VIEW-AS TEXT
     2165             SIZE 6 BY .67
     2166        SPACE(65.30) SKIP(3.48)
     2167       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2168            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2169            TITLE "Параметры экспорта данных по продажам по ДК в текстовый файл"
     2170            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2171   ASSIGN
     2172          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2173          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2174   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2175   DO:
     2176     APPLY "END-ERROR":U TO SELF.
     2177   END.
     2178   ON CHOOSE OF b-dc-type IN FRAME Dialog-Frame
     2179   DO:
     2180     run proc-b-type in this-procedure no-error.
     2181     if error-status:error then return no-apply.
     2182   END.
     2183   ON CHOOSE OF b-dir-sel IN FRAME Dialog-Frame
     2184   DO:
     2185     define variable c-dir-name  as character no-undo.
     2186     define variable c-dir-type  as character no-undo.
     2187     define variable l-can-write as logical   no-undo.
     2188   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2189   if lookup(self :type
     2190            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2191            ) = 0
     2192   then do:
     2193     message
     2194       "$Workfile$"
     2195       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2196       "Интерфейсный элемент" self :name  skip
     2197       "Тип" self :type  skip
     2198       "Процедура" this-procedure :file-name skip
     2199       view-as alert-box .
     2200   end.
     2201   else do:
     2202     apply "entry":u to self  .
     2203     if focus :handle <> self :handle  then do:
     2204       return no-apply .
     2205     end.
     2206   end.
     2207     run gbl/dir-sel.p ( output c-dir-name, output c-dir-type, output l-can-write ).
     2208     if c-dir-name = '':U or c-dir-name = ? or
     2209        c-dir-type = '':U or c-dir-type = ? then do:
     2210       return no-apply.
     2211     end.
     2212     if l-can-write <> yes then do:
     2213       message 'Вы не имеете права писать в выбранную директорию:' c-dir-name view-as alert-box error.
     2214       return no-apply.
     2215     end.
     2216     assign  v-dir-name = c-dir-name.
     2217     display v-dir-name with frame Dialog-Frame.
     2218       .
     2219   END.
     2220   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2221   DO:
     2222     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2223     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2224     APPLY "GO" TO FRAME Dialog-Frame.
     2225   END.
     2226   ON CHOOSE OF b-param IN FRAME Dialog-Frame
     2227   DO:
     2228       RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     2229       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2230   END.
     2231   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2232   DO:
     2233         assign
     2234           p-cancel = yes
     2235       .
     2236   END.
     2237   ON CHOOSE OF b-rule-profile IN FRAME Dialog-Frame
     2238   DO:
     2239     run proc-rule-profile in this-procedure no-error.
     2240     if error-status:error then return no-apply.
     2241   END.
     2242   ON VALUE-CHANGED OF rs-dir IN FRAME Dialog-Frame
     2243   DO:
     2244     ASSIGN
     2245     rs-dir.
     2246     CASE rs-dir:
     2247         WHEN 'ini' THEN DO:
     2248            HIDE
     2249            b-dir-sel
     2250            IN FRAME Dialog-Frame.
     2251         END.
     2252         OTHERWISE DO:
     2253             DISPLAY
     2254             b-dir-sel
     2255             with FRAME Dialog-Frame.
     2256             ENABLE
     2257             b-dir-sel
     2258             with FRAME Dialog-Frame.
     2259        END.
     2260     END CASE.
     2261   END.
     2262   ON VALUE-CHANGED OF RS-file-rule IN FRAME Dialog-Frame
     2263   DO:
     2264     ASSIGN
     2265     rs-file-rule.
     2266     CASE rs-file-rule:
     2267         WHEN "seq" THEN DO:
     2268            DISPLAY
     2269            file-name-1
     2270            file-name-2
     2271            file-seq
     2272            f-seq-label
     2273            f-file-seq-label-2
     2274            WITH FRAME Dialog-Frame.
     2275            ENABLE
     2276            file-name-1
     2277            file-name-2
     2278            WITH FRAME Dialog-Frame.
     2279         END.
     2280         WHEN "const" THEN DO:
     2281           HIDE
     2282           file-seq
     2283           file-name-2
     2284           f-seq-label
     2285           f-file-seq-label-2
     2286           in FRAME Dialog-Frame.
     2287        END.
     2288     END CASE.
     2289   END.
     2290   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2291   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2292   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2293   on help of frame Dialog-Frame
     2294   do:
     2295     run gbl/app_help.p
     2296       (input this-procedure :file-name
     2297       ,input ''
     2298       ,input ?
     2299       ) no-error.
     2300     if error-status :error then do:
     2301       message
     2302         "Ошибка при вызове помощи"
     2303         error-status :get-message(1)
     2304         view-as alert-box .
     2305     end.
     2306   end.
     2307   run minbtn-set in this-procedure .
     2308   on choose of b-help in frame Dialog-Frame
     2309   do:
     2310     apply "help":u to frame Dialog-Frame .
     2311   end.
     2312   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   procedure minbtn-set :
     2314       do
     2315           on error undo, return error return-value
     2316           :
     2317           define variable ii              as integer       no-undo .
     2318           define variable fh              as widget-handle no-undo .
     2319           define variable hh              as widget-handle no-undo .
     2320           define variable v-h             as handle        extent 4 no-undo .
     2321           define variable v-name-button   as character     no-undo .
     2322           define variable v-help-old-x    as decimal       no-undo .
     2323           define variable v-help-old-y    as decimal       no-undo .
     2324           define variable v-help-old-size as decimal       no-undo .
     2325           define variable v-frame-width   as decimal       no-undo .
     2326           define variable jj              as integer       no-undo .
     2327           do
     2328               on error undo, return error
     2329               :
     2330               assign
     2331                   v-frame-width = frame Dialog-Frame:width - 0.3
     2332                   fh            = frame Dialog-Frame:first-child
     2333                   hh            = fh:first-child
     2334                   ii            = 1
     2335                   .
     2336               do while valid-handle(hh):
     2337                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2338                   do:
     2339                       case lc(hh:name) :
     2340                           when "b-help" then
     2341                               do:
     2342                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2343                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2344                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2345                                   hh:TOOLTIP = "Помощь" .
     2346                                   v-help-old-x = hh:column .
     2347                                   v-help-old-y = hh:row    .
     2348                                   v-help-old-size = hh:width .
     2349                                   hh:width-chars = 2.5 .
     2350                               end.
     2351                           when "b-print" then
     2352                               do:
     2353                                   hh:load-image("cmp/b-print.bmp":u) .
     2354                                   hh:TOOLTIP = "Печать" .
     2355                                   v-h[ii] = hh:handle .
     2356                                   ii = ii + 1 .
     2357                                   hh:width-chars = 3 .
     2358                               end.
     2359                           when "b-history" or
     2360                           when "b-hist" then
     2361                               do:
     2362                                   hh:load-image("cmp/b-hist.bmp":u) .
     2363                                   hh:TOOLTIP = "История" .
     2364                                   v-h[ii] = hh:handle .
     2365                                   ii = ii + 1 .
     2366                                   hh:width-chars = 3 .
     2367                               end.
     2368                           when "b-sch" then
     2369                               do:
     2370                                   hh:load-image("cmp/b-sch.bmp":u) .
     2371                                   hh:TOOLTIP = "Установка Фильтра" .
     2372                                   v-h[ii] = hh:handle .
     2373                                   ii = ii + 1 .
     2374                                   hh:width-chars = 3 .
     2375                               end.
     2376                           when "b-hist-user" then
     2377                               do:
     2378                                   hh:load-image("cmp/b-hist.bmp":u) .
     2379                                   hh:TOOLTIP = "История пользователя" .
     2380                                   ii = ii + 1 .
     2381                               end.
     2382                       end case.
     2383                   end.
     2384                   hh = hh:next-sibling.
     2385               end.
     2386               b-help:column = v-frame-width - b-help:width-chars.
     2387               jj = 0.
     2388               repeat ii = 4 to 1 by -1 :
     2389                   if valid-handle (v-h[ii] ) then
     2390                   do:
     2391                       jj  = jj + 1 .
     2392                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2393                       v-h[ii]:row    = v-help-old-y .
     2394                   end.
     2395               end.
     2396           end.
     2397       end.
     2398   end procedure.
     2399   MAIN-BLOCK:
     2400   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2401      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2402   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2403     run mainmenu_getcntxt in parparentproc
     2404       (output v-cntxt-db-num
     2405       ,output v-cntxt-userid
     2406       ,output v-cntxt-level
     2407       ,output v-cntxt-host-code-obj
     2408       ,output v-cntxt-obj-type
     2409       ,output v-cntxt-obj-code
     2410       ,output v-cntxt-db-num-obj
     2411       ,output v-cntxt-is-admin
     2412       ) .
     2413     IF NOT g#db-num = 0  THEN DO:
     2414       MESSAGE
     2415       "Импорт данных по ДК не может быть вызван в УБД"
     2416        VIEW-AS ALERT-BOX ERROR.
     2417        UNDO, RETURN ERROR.
     2418     END.
     2419     if p-mode = 'shd':U then do:
     2420       assign
     2421       frame Dialog-Frame :title = frame Dialog-Frame :title +
     2422                         substitute(". &1: Задача номер &2"
     2423                         , p-task-type
     2424                         , p-task-num )
     2425       .
     2426     end.
     2427     run init-param-values in this-procedure (
     2428         input p-cre-db-num
     2429       , input p-task-type
     2430       , input p-task-num
     2431       , output v-rule-profile-id
     2432       , OUTPUT v-dir-name
     2433       ) no-error.
     2434     if error-status :error then undo, return error .
     2435     RUN init-fields in this-procedure no-error.
     2436     if error-status :error then undo, return error .
     2437     RUN Myenable.
     2438     apply "value-changed" to rs-dir.
     2439     apply "value-changed" to rs-file-rule.
     2440     WAIT-FOR GO OF FRAME Dialog-Frame.
     2441   END.
     2442   RUN disable_UI.
     2443   PROCEDURE attach-attr-to-schedule-line :
     2444   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     2445   define buffer buf_schedule      for ub.schedule.
     2446   define buffer buf_schedule-attr for ub.schedule-attr.
     2447   define buffer lock-batchprocess for ub.batchprocess.
     2448   CASE p-mode:
     2449     when 'shd':U then do:
     2450         run gbl/lock-prc.p
     2451             (input 'schd':U
     2452             ,input 'dctxt-e':U
     2453             ,input 0
     2454             ,input 0
     2455             ,input '':U
     2456             ,input ""
     2457             ,input ""
     2458             ,input (
     2459                     "Экспорт данных продаж по ДК в текстовый файл"
     2460                   )
     2461             ,input yes
     2462             ,buffer lock-batchprocess
     2463             ) no-error .
     2464         FIND FIRST buf_schedule-attr NO-LOCK WHERE
     2465                    buf_schedule-attr.cre-db-num = p-cre-db-num
     2466                and buf_schedule-attr.task-type  = p-task-type
     2467                and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'dctxt-e') NO-ERROR.
     2468         IF AVAILABLE  buf_schedule-attr
     2469             AND buf_schedule-attr.task-num <> p-task-num
     2470             AND buf_schedule-attr.task-num <> - 1
     2471             and p-task-num <> - 1
     2472             THEN DO:
     2473           MESSAGE
     2474           substitute("Уже есть расписание для экспорта данных продаж по ДК номер расписания &1"
     2475                      ,buf_schedule-attr.task-num
     2476                     )
     2477           VIEW-AS ALERT-BOX ERROR.
     2478           UNDO, RETURN ERROR.
     2479         END.
     2480         find first buf_schedule no-lock
     2481              where buf_schedule.cre-db-num = p-cre-db-num
     2482                and buf_schedule.task-type  = p-task-type
     2483                and buf_schedule.task-num   = p-task-num
     2484         no-error.
     2485         if not available buf_schedule
     2486         and (  p-task-type   <> 'autofree':U
     2487             or p-task-num    <> -1 )
     2488         then do:
     2489             message
     2490               vss-workfile vss-revision vss-description
     2491               skip "Не найдена строка расписания."
     2492               skip return-value
     2493               skip trim(error-status :get-message(1))
     2494                    trim(error-status :get-message(2))
     2495                    trim(error-status :get-message(3))
     2496             view-as alert-box error.
     2497             undo, return error .
     2498         end.
     2499       run schedule-attr-write in this-procedure (
     2500             input p-cre-db-num
     2501           , input p-task-type
     2502           , input p-task-num
     2503           , input 'schedule-param-list':U
     2504           , input p-param-list
     2505       ).
     2506     end.
     2507     when 'run':U then do:
     2508       p-params = p-param-list.
     2509     end.
     2510   END CASE.
     2511   END PROCEDURE.
     2512   PROCEDURE disable_UI :
     2513     HIDE FRAME Dialog-Frame.
     2514   END PROCEDURE.
     2515   PROCEDURE enable_UI :
     2516     OPEN QUERY Dialog-Frame FOR EACH X_rule-profile SHARE-LOCK,       EACH ub.rule WHERE TRUE  SHARE-LOCK,       EACH X_dis-card-type WHERE TRUE  SHARE-LOCK.
     2517     GET FIRST Dialog-Frame.
     2518     DISPLAY rs-dir v-dir-name RS-file-rule file-name-1 file-seq file-name-2
     2519             f-rs-dir-label f-rs-file-rule-label f-seq-label f-file-seq-label-2
     2520             f-dc-type-label
     2521         WITH FRAME Dialog-Frame.
     2522     IF AVAILABLE X_dis-card-type THEN
     2523       DISPLAY X_dis-card-type.type X_dis-card-type.emitent-host-code
     2524         WITH FRAME Dialog-Frame.
     2525     IF AVAILABLE X_rule THEN
     2526       DISPLAY X_rule.name
     2527         WITH FRAME Dialog-Frame.
     2528     IF AVAILABLE X_rule-profile THEN
     2529       DISPLAY X_rule-profile.name
     2530         WITH FRAME Dialog-Frame.
     2531     ENABLE B-exit b-quit B-Help rs-dir b-dir-sel RS-file-rule X_rule-profile.name
     2532            b-rule-profile X_rule.name b-param b-dc-type
     2533            X_dis-card-type.emitent-host-code
     2534         WITH FRAME Dialog-Frame.
     2535     VIEW FRAME Dialog-Frame.
     2536   END PROCEDURE.
     2537   PROCEDURE init-fields :
     2538   DEFINE VARIABLE v-out AS CHARACTER NO-UNDO.
     2539   DEFINE VARIABLE glog AS logical NO-UNDO.
     2540   ASSIGN
     2541   rs-dir = (if v-dir = 'ini' then v-dir else 'other').
     2542   IF rs-dir = "ini":u THEN DO:
     2543       run verify-ini-entry in this-procedure (
     2544                                            INPUT  'dctxt-e_out'
     2545                                           ,INPUT  'schedule-free'
     2546                                           ,INPUT substitute("отсутствует параметр &1 секция &2 в ini-файле"
     2547                                                             , 'dctxt-e_out'
     2548                                                             , 'schedule-free')
     2549                                           ,INPUT no
     2550                                           ,output v-out) no-error .
     2551       if error-status:error or v-out = ? then return error return-value .
     2552       RUN verify-file in this-procedure
     2553                                         (input v-out
     2554                                         ,input substitute("Не найден каталог &1 параметр &2, секция &3 ini-файла"
     2555                                                       , v-out
     2556                                                       , 'schedule-free'
     2557                                                      , 'dctxt-e_out')
     2558                                         ,input no
     2559                                         ,output glog) no-error.
     2560       if error-status:error or not glog then return error return-value .
     2561     v-dir-name = v-out.
     2562   END.
     2563   ELSE DO:
     2564       RUN verify-file in this-procedure
     2565                                         (input v-dir
     2566                                         ,input substitute("Не найден каталог &1"
     2567                                                       , v-dir
     2568                                                       )
     2569                                         ,input no
     2570                                         ,output glog) no-error.
     2571       if error-status:error or not glog then do:
     2572         v-dir-name = "".
     2573       end.
     2574       else do:
     2575         v-dir-name = v-dir.
     2576      end.
     2577   END.
     2578   ASSIGN
     2579   rs-file-rule = v-file-rule
     2580   file-name-1 = ENTRY(1, v-file-name, chr(63))
     2581   file-name-2 = (IF NUM-ENTRIES(v-file-name, chr(63)) > 1
     2582                  AND rs-file-rule = "seq"
     2583                  THEN ENTRY(2, v-file-name, chr(63))
     2584                  ELSE '':U)
     2585   .
     2586   END PROCEDURE.
     2587   PROCEDURE init-param-values :
     2588   do
     2589   on error undo, return error
     2590   :
     2591   define input parameter p-cre-db-num as integer   no-undo .
     2592   define input parameter p-task-type  as character    no-undo.
     2593   define input parameter p-task-num   as integer      no-undo.
     2594   define output parameter p-profile-id as integer  no-undo.
     2595   define output parameter p-dir       as character    no-undo.
     2596   define variable v-param-list    as character     no-undo.
     2597   define variable v-param-type    as character     no-undo.
     2598   define variable ii as integer   no-undo .
     2599   define variable v-entry  as character no-undo .
     2600   define variable v-task-num as integer   no-undo .
     2601   define variable v-other-params as character no-undo .
     2602   define variable v-local-rule-profile-id as integer no-undo.
     2603   define buffer buf_schedule for ub.schedule.
     2604   define buffer buf_schedule-attr for ub.schedule-attr.
     2605     CASE p-mode:
     2606       when 'shd':U then do:
     2607         if p-task-num > 0 then do:
     2608           v-task-num = p-task-num.
     2609         end.
     2610         else do:
     2611           for each buf_schedule no-lock where
     2612                   buf_schedule.cre-db-num = p-cre-db-num
     2613               AND buf_schedule.task-type = p-task-type,
     2614               first buf_schedule-attr no-lock where
     2615                     buf_schedule-attr.cre-db-num = p-cre-db-num
     2616                 AND buf_schedule-attr.task-type = p-task-type
     2617                 AND buf_schedule-attr.task-num = buf_schedule.task-num
     2618                 AND buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'dctxt-e') :
     2619              v-task-num = buf_schedule.task-num.
     2620              leave .
     2621           end.
     2622         end.
     2623         if v-task-num > 0 then do:
     2624           run schedule-attr-value in this-procedure (
     2625                 input p-cre-db-num
     2626               , input p-task-type
     2627               , input v-task-num
     2628               , input 'schedule-param-list':U
     2629               , output v-param-list
     2630               , output v-param-type
     2631           ) NO-ERROR.
     2632         end.
     2633         if v-param-list = '':U then
     2634         v-param-list = string(12) + chr(4) + 'ini' + chr(4) + "seq" + chr(4) + "f?.txt" + chr(4).
     2635       END.
     2636       WHEN 'run' THEN DO:
     2637         assign
     2638         v-param-list = string(12) + chr(4) + 'ini' + chr(4) + "seq" + chr(4) + "f?.txt" + chr(4).
     2639       END.
     2640     END CASE.
     2641     ASSIGN
     2642     v-local-rule-profile-id = integer(entry(1, v-param-list, chr(4)))
     2643     v-dir = entry(2, v-param-list, chr(4))
     2644     v-file-rule = entry(3, v-param-list, chr(4))
     2645     v-file-name = entry(4, v-param-list, chr(4))
     2646     v-emitent-host-code = 0
     2647     v-dc-type = entry(1, entry(5, v-param-list, chr(4)))
     2648     v-other-params = v-param-list
     2649     .
     2650     ENTRY(1, v-other-params, chr(4)) = '':U.
     2651     ENTRY(2, v-other-params, chr(4)) = '':U.
     2652     ENTRY(3, v-other-params, chr(4)) = '':U.
     2653     ENTRY(4, v-other-params, chr(4)) = '':U.
     2654     v-other-params = substring(v-other-params, 5).
     2655     run set-rule-profile in this-procedure ( input v-local-rule-profile-id) no-error.
     2656     if error-status:error then undo, return error.
     2657     p-profile-id = v-local-rule-profile-id.
     2658     IF v-dc-type <> '':U THEN DO:
     2659       run set-dc-type in this-procedure ( input v-other-params
     2660                                          ,input v-dc-type
     2661                                          ,input v-emitent-host-code).
     2662     END.
     2663   END.
     2664   END PROCEDURE.
     2665   PROCEDURE MyEnable :
     2666   CASE p-mode:
     2667       WHEN 'run':U THEN DO:
     2668           ASSIGN
     2669           rs-dir:RADIO-BUTTONS IN FRAME Dialog-Frame
     2670                                = "берется из Ini-файла ([schedule-free] dctxt-e_out=)" + chr(44) +
     2671                                  "ini":U + chr(44) +
     2672                                  "задать директорию экспорта" + chr(44) +
     2673                                  "other".
     2674       END.
     2675       WHEN 'shd':U THEN DO:
     2676           ASSIGN
     2677           rs-dir:RADIO-BUTTONS = "берется из Ini-файла ([schedule-free] dctxt-e_out=)" + chr(44) +
     2678                                  "ini":U + chr(44) +
     2679                                  "привязываются  к строке расписания" + chr(44) +
     2680                                  "other".
     2681       END.
     2682   END CASE.
     2683   DISPLAY
     2684   rs-dir
     2685   f-rs-dir-label
     2686   v-dir-name
     2687   rs-file-rule
     2688   file-name-1
     2689   f-rs-file-rule-label
     2690   (if available X_rule-profile then X_rule-profile.name else '') @ X_rule-profile.name
     2691   (if available X_dis-card-type then X_Dis-card-type.type else '') @ X_dis-card-type.type
     2692   X_rule.name when available X_rule
     2693   WITH FRAME Dialog-Frame.
     2694   ENABLE
     2695   B-exit
     2696   b-quit
     2697   B-Help
     2698   rs-dir
     2699   b-dir-sel WHEN rs-dir <> 'Ini':U
     2700   RS-file-rule
     2701   b-dc-type
     2702   b-rule-profile
     2703   b-param
     2704   WITH FRAME Dialog-Frame.
     2705   VIEW FRAME Dialog-Frame.
     2706   END PROCEDURE.
     2707   PROCEDURE proc-b-param :
     2708   define variable v-param-form as character no-undo .
     2709   define variable v-list-mode as character no-undo .
     2710   define buffer buf_rule-profile for ub.rule-profile.
     2711   find first buf_rule-profile no-lock where
     2712             buf_rule-profile.profile_id = X_rp-by-call.profile_id.
     2713   assign
     2714   v-param-form = (if buf_rule-profile.custom-param-form > 0
     2715                   then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     2716                   else "ref/rulercps.w")
     2717   v-list-mode = (if buf_rule-profile.custom-param-form > 0
     2718                  then 'rp-by-call':U
     2719                  else 'rule-call-param':U)
     2720   .
     2721   run value(v-param-form) (
     2722                        input parparentproc
     2723                       ,input this-procedure:handle
     2724                       ,input "b-chg":U
     2725                       ,input 'ИЗМЕНЕНИЕ':U
     2726                       ,input v-list-mode
     2727                       ,input 0
     2728                       ,input ?
     2729                       ,input X_rp-by-call.call_id
     2730                       ,input X_rule-by-profile.codex_id
     2731                       ,input X_rule-by-profile.ruleset_id
     2732                       ,input ?
     2733                       ,input X_rule-by-profile.RULE_id
     2734                       ,INput substitute("Правило &1 &2", X_rule-by-profile.RULE_id, calldscr(X_rp-by-call.call_id))
     2735                       ,input-output table tt0-rule-call-param  ) no-error.
     2736   END PROCEDURE.
     2737   PROCEDURE proc-b-type :
     2738   define variable v-rid-list as character no-undo.
     2739   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     2740   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     2741   define buffer buf_rule for ub.rule.
     2742   define buffer buf_ruledict for ub.ruledict.
     2743   define buffer buf_rule-call-param for ub.rule-call-param.
     2744   define buffer buf_ruledict-param for ub.ruledict-param.
     2745   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2746   IF AVAILABLE X_rp-by-call THEN DO:
     2747      ASSIGN
     2748      v-rid-list = STRING(RECID(X_rp-by-call)).
     2749   END.
     2750   run rul/rp-by-call-s.w ( INPUT parparentproc
     2751                           ,INPUT "b-sel":U
     2752                           ,INPUT "profile-id"
     2753                           ,INPUT X_rule-by-profile.profile_id
     2754                           ,INPUT '':U
     2755                           ,input ''
     2756                           ,input 0
     2757                           ,input 0
     2758                           ,INPUT-OUTPUT v-rid-list
     2759                           ) NO-ERROR.
     2760   if v-rid-list = "" then return error.
     2761   find first buf_rp-by-call no-lock where
     2762             recid(buf_rp-by-call) = integer(v-rid-list) no-error.
     2763   if not available buf_rp-by-call then do:
     2764     message
     2765     substitute("Не найдена привязка правила rp-by-call с recid &1" , v-rid-list)
     2766     view-as alert-box error .
     2767     return.
     2768   end.
     2769   FIND FIRST X_rp-by-call WHERE RECID(X_rp-by-call) = RECID(buf_rp-by-call).
     2770   FIND FIRST X_dis-card-type WHERE
     2771           X_dis-card-type.uniq-key-rec = buf_rp-by-call.call_id.
     2772   display
     2773   X_dis-card-type.type
     2774   X_dis-card-type.emitent-host-code
     2775   with frame Dialog-Frame.
     2776   FOR EACH buf_tt0-rule-call-param:
     2777     DELETE buf_tt0-rule-call-param.
     2778   END.
     2779   for each buf_Rule-call-param no-lock where
     2780         buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     2781    and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     2782    and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     2783    and  buf_rule-call-param.rule_id = X_rule-by-profile.rule_id:
     2784   create buf_tt0-rule-call-param.
     2785   buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     2786   end.
     2787   RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     2788   END PROCEDURE.
     2789   PROCEDURE proc-rule-profile :
     2790   define variable v-rid-list as character no-undo .
     2791    define buffer buf_rule-profile for ub.rule-profile.
     2792     do
     2793     on error undo, return error return-value
     2794     :
     2795      find first buf_rule-profile no-lock where
     2796                 buf_rule-profile.profile_id = v-rule-profile-id no-error.
     2797      if available buf_rule-profile then do:
     2798         assign
     2799         v-rid-list = string(recid(buf_rule-profile)).
     2800      end.
     2801      run rul/rule-profile-s.w (
     2802                             input parparentproc
     2803                           , input 'b-sel'
     2804                           , input "general-view"
     2805                           , input 'dis-card-type':U
     2806                           , input-output v-rid-list ) no-error.
     2807       if v-rid-list <> '':U
     2808       and v-rid-list <> string(recid(buf_rule-profile)) then do:
     2809         find first buf_rule-profile no-lock where
     2810                  recid(buf_rule-profile) = integer(v-rid-list) no-error.
     2811         if available buf_rule-profile then do:
     2812           run set-rule-profile in this-procedure ( input buf_rule-profile.profile_id).
     2813         end.
     2814       end.
     2815     end.
     2816   END PROCEDURE.
     2817   PROCEDURE proc-save :
     2818   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2819   DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
     2820   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     2821   define variable v-dop-file-name as character no-undo .
     2822   define variable ii as integer   no-undo .
     2823   define variable v-exists as logical no-undo .
     2824   DEFINE VARIABLE v-other-param AS CHARACTER NO-UNDO.
     2825   DEFINE BUFFER buf_tt0-rule-call-param FOR tt0-rule-call-param.
     2826   ASSIGN
     2827   FRAME Dialog-Frame
     2828   rs-dir
     2829   rs-file-rule
     2830   file-name-1
     2831   file-name-2 WHEN file-name-2:VISIBLE IN FRAME Dialog-Frame
     2832   .
     2833   if X_dis-card-type.type:screen-value  = '':u  then do:
     2834    message
     2835    "Не задан тип ДК для экспорта"
     2836    view-as alert-box error .
     2837    return error.
     2838   end.
     2839   IF rs-dir <> 'ini' THEN DO:
     2840       ASSIGN
     2841       v-dir-name.
     2842       RUN verify-file in this-procedure
     2843                                         ( input v-dir-name
     2844                                         , input substitute("Не найден каталог &1"
     2845                                                       , v-dir-name)
     2846                                         ,input no
     2847                                         ,output glog) no-error.
     2848      if error-status:error or not glog then do:
     2849          v-dir-name = '':U.
     2850       end.
     2851       else
     2852       v-dir-name = v-dir.
     2853   END.
     2854   CASE rs-file-rule:
     2855       WHEN "seq":U THEN DO:
     2856         ASSIGN
     2857         v-file-name = file-name-1 + chr(63) + file-name-2.
     2858       END.
     2859       WHEN "const":U THEN DO:
     2860         ASSIGN
     2861         v-file-name = file-name-1.
     2862       END.
     2863   END CASE.
     2864   v-dop-file-name = replace(v-file-name, chr(63), '':U).
     2865   do ii = 1 to length('\/:*?"<>|':U):
     2866     if index(v-dop-file-name, substring('\/:*?"<>|':U, ii, 1)) > 0 then do:
     2867       message
     2868       substitute("Введенное имя файла содержит недопустимый символ &1", substring('\/:*?"<>|':U, ii, 1))
     2869       view-as alert-box error .
     2870       return error.
     2871     end.
     2872   end.
     2873   if trim(v-dop-file-name) = '':U then do:
     2874    message
     2875    "Не задано имя файла для экспорта"
     2876    view-as alert-box error .
     2877    return error.
     2878   end.
     2879   FOR EACH buf_tt0-rule-call-param
     2880   BY buf_tt0-rule-call-param.param-num:
     2881     ASSIGN
     2882     v-other-param = v-other-param + (IF buf_tt0-rule-call-param.param-num = 1
     2883                                      THEN '':U
     2884                                      ELSE chr(4)) +
     2885     SUBSTITUTE("&1",  BUFFER buf_tt0-rule-call-param:HANDLE:BUFFER-FIELD(SUBSTITUTE("param-value-&1"
     2886                                                                                     , buf_tt0-rule-call-param.param-data-type)):BUFFER-VALUE).
     2887   END.
     2888   ASSIGN
     2889   v-param-list = ( string(v-rule-profile-id) + chr(4) +
     2890                   IF rs-dir = 'ini' THEN 'ini' ELSE v-dir-name) + chr(4) +
     2891                  rs-file-rule + chr(4) +
     2892                   v-file-name + chr(4) +
     2893                   X_dis-card-type.type:SCREEN-VALUE + chr(4) +
     2894                   v-other-param.
     2895   IF p-mode = 'shd' THEN DO:
     2896       run attach-attr-to-schedule-line in this-procedure (
     2897                                                            INPUT v-param-list
     2898       ) NO-ERROR.
     2899     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2900   END.
     2901   END PROCEDURE.
     2902   PROCEDURE set-dc-type :
     2903   define input parameter p-other-params as character no-undo.
     2904   define input parameter p-dc-type as character no-undo.
     2905   define input parameter p-emitent-host-code as integer no-undo.
     2906   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     2907   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     2908   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     2909   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     2910   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     2911   define variable v-ok as logical no-undo .
     2912   define variable v-rid-list as character no-undo .
     2913   define variable v-local-rule-profile-id as integer no-undo.
     2914   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2915   define buffer buf_rule-call-param for ub.rule-call-param.
     2916         FIND FIRST X_dis-card-type NO-LOCK WHERE
     2917                   X_dis-card-type.emitent-host-code = p-emitent-host-code
     2918             AND   X_dis-card-type.type = p-dc-type
     2919             AND X_dis-card-type.host-code = 0
     2920             AND X_dis-card-type.obj-type = '':U
     2921             AND X_dis-card-type.obj-code = 0 NO-ERROR.
     2922       IF NOT AVAILABLE X_dis-card-type  THEN DO:
     2923         MESSAGE
     2924         substitute("Неизвестный тип ДК &1 эмитент &2"
     2925                    , v-dc-type
     2926                    , v-emitent-host-code)
     2927         VIEW-AS ALERT-BOX ERROR.
     2928         return.
     2929       END.
     2930       FIND FIRST X_rp-by-call NO-LOCK WHERE
     2931                 X_rp-by-call.profile_id = v-rule-profile-id
     2932           AND   X_rp-by-call.call_id = X_dis-card-type.uniq-key-rec NO-ERROR.
     2933       IF NOT AVAILABLE X_rp-by-call THEN DO:
     2934           MESSAGE
     2935           substitute("Тип ДК &1 эмитент &2 не привязан к профайлу импорта-экспорта в текстовый файл"
     2936                      , p-dc-type
     2937                      , p-emitent-host-code)
     2938           VIEW-AS ALERT-BOX ERROR.
     2939           RETURN .
     2940       END.
     2941       find X_rule-by-call where
     2942           X_rule-by-call.call#_id = X_rp-by-call.call#_id
     2943        and X_rule-by-call.rule_id = X_rule-by-profile.rule_id
     2944        and X_rule-by-call.profile_id = X_rule-by-profile.profile_id no-error .
     2945       if ambiguous X_rule-by-call then do:
     2946         message
     2947         "Выберите какой вызов правила Вас необходим"
     2948         view-as alert-box .
     2949         run rul/rule-by-call-s.w ( input parparentproc
     2950                                   ,input "b-sel"
     2951                                   ,input "call_id"
     2952                                   ,input X_rp-by-call.call_id
     2953                                   ,input X_rule-by-profile.codex_id
     2954                                   ,input X_rule-by-profile.ruleset_id
     2955                                   ,input X_rule-by-profile.rule_id
     2956                                   ,input-output v-rid-list) no-error .
     2957         if v-rid-list = '':u then do:
     2958           UNDO, RETURN ERROR.
     2959         end.
     2960         find first X_rule-by-call no-lock where
     2961                   recid(X_rule-by-call) = integer(v-rid-list) no-error .
     2962         if not available X_rule-by-call then do:
     2963           UNDO, RETURN ERROR.
     2964         end.
     2965       end.
     2966       FOR each buf_Rule-call-param no-lock where
     2967             buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     2968        and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     2969        and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     2970        and  buf_rule-call-param.order_id = X_rule-by-call.order_id :
     2971         create buf_tt0-rule-call-param.
     2972         buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     2973         CASE buf_rule-call-param.param-data-type:
     2974           WHEN 'character':U THEN DO:
     2975              ASSIGN
     2976              buf_tt0-rule-call-param.param-value-character = ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4))
     2977              NO-ERROR.
     2978           END.
     2979           WHEN 'date':U THEN DO:
     2980              ASSIGN
     2981              buf_tt0-rule-call-param.param-value-date = IF entry(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)) = chr(63)
     2982                                                         THEN ?
     2983                                                         ELSE DATE(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2984              NO-ERROR.
     2985           END.
     2986           WHEN 'decimal':U THEN DO:
     2987              ASSIGN
     2988              buf_tt0-rule-call-param.param-value-decimal = decimal(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2989              NO-ERROR.
     2990           END.
     2991           WHEN 'integer':U THEN DO:
     2992              ASSIGN
     2993              buf_tt0-rule-call-param.param-value-integer = integer(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2994              NO-ERROR.
     2995           END.
     2996           WHEN 'logical':U THEN DO:
     2997              ASSIGN
     2998              buf_tt0-rule-call-param.param-value-logical = logical(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2999              NO-ERROR.
     3000           END.
     3001         END CASE.
     3002         IF ERROR-STATUS:ERROR THEN DO:
     3003            MESSAGE
     3004            substitute("Некорректное значение параметра &1=&2"
     3005                       ,buf_tt0-rule-call-param.param-label
     3006                       ,BUFFER buf_tt0-rule-call-param:HANDLE:BUFFER-FIELD(substitute("param-value-&1", buf_tt0-rule-call-param.param-data-type)):buffer-value)
     3007            VIEW-AS ALERT-BOX ERROR.
     3008            UNDO, RETURN .
     3009         END.
     3010         if buf_tt0-rule-call-param.param-2-data-type <> '':U then do:
     3011           assign
     3012           v-ok = no
     3013           v-value-character = buf_tt0-rule-call-param.param-value-character
     3014           v-value-date = buf_tt0-rule-call-param.param-value-date
     3015           v-value-decimal = buf_tt0-rule-call-param.param-value-decimal
     3016           v-value-integer = buf_tt0-rule-call-param.param-value-integer
     3017           v-value-logical = buf_tt0-rule-call-param.param-value-logical
     3018           .
     3019           run ref/rule-dtt.p (
     3020                               input ?
     3021                               ,input 'ПРОВЕРКА':U
     3022                               ,input 'dis-card-type':U
     3023                               ,input buf_tt0-rule-call-param.param-data-type
     3024                               ,input buf_tt0-rule-call-param.param-2-data-type
     3025                               ,input buf_tt0-rule-call-param.param-3-data-type
     3026                               ,input buf_tt0-rule-call-param.p-index
     3027                               ,input-output v-value-character
     3028                               ,input-output v-value-date
     3029                               ,input-output v-value-decimal
     3030                               ,input-output v-value-integer
     3031                               ,input-output v-value-logical
     3032                               ,output v-ok
     3033                               ) no-error.
     3034           if error-status:error
     3035           or not v-ok then do:
     3036             undo,  return error substitute("Неверное значение параметра № &1(&8) для вызова правила &2:&3" +
     3037                                                 "точка вызова &4, кодекс &5, набор правил &6, порядок вызова &7"
     3038                                                 , buf_tt0-rule-call-param.param-num
     3039                                                 , tt0-rule-call-param.rule_id
     3040                                                 , chr(10)
     3041                                                 , X_dis-card-type.uniq-key-rec
     3042                                                 , tt0-rule-call-param.codex_id
     3043                                                 , tt0-rule-call-param.ruleset_id
     3044                                                 , tt0-rule-call-param.order_id
     3045                                                 , buf_tt0-rule-call-param.param-name
     3046                                                 ).
     3047           end.
     3048         end.
     3049       end.
     3050       assign
     3051       v-dc-type = p-dc-type
     3052       v-emitent-host-code = p-emitent-host-code.
     3053   END PROCEDURE.
     3054   PROCEDURE set-rule-profile :
     3055   define input parameter p-profile-id as integer no-undo.
     3056   define buffer buf_rule-profile for ub.rule-profile.
     3057   define buffer buf_rule-by-profile for ub.rule-by-profile.
     3058   define buffer buf_rule for ub.rule.
     3059     FIND FIRST buf_rule-profile NO-LOCK WHERE
     3060               buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     3061     IF NOT AVAILABLE buf_rule-profile THEN DO:
     3062        MESSAGE
     3063        "Не найден профайл для работы экспорта в текстовый файл"
     3064         VIEW-AS ALERT-BOX ERROR.
     3065        UNDO, RETURN ERROR.
     3066     END.
     3067     FIND FIRST buf_rule-by-profile NO-LOCK WHERE
     3068             buf_rule-by-profile.profile_id = p-profile-id
     3069         AND buf_rule-by-profile.codex_id = v-codex-id
     3070         AND buf_rule-by-profile.ruleset_id = v-ruleset-id NO-ERROR.
     3071     IF NOT AVAILABLE buf_rule-by-profile THEN DO:
     3072        MESSAGE
     3073        "Не найдено или неопределено правило для импорта из текстового файла"
     3074         VIEW-AS ALERT-BOX ERROR.
     3075        UNDO, RETURN ERROR.
     3076     END.
     3077     FIND FIRST buf_rule NO-LOCK WHERE
     3078           buf_rule.rule_id = buf_rule-by-profile.rule_id no-error.
     3079     IF NOT AVAILABLE buf_rule THEN DO:
     3080        MESSAGE
     3081        substitute("Не найдено правило &1 для импорта из текстового файла", buf_rule-by-profile.rule_id)
     3082         VIEW-AS ALERT-BOX ERROR.
     3083        UNDO, RETURN ERROR.
     3084     END.
     3085   find first X_rule-profile no-lock where
     3086           recid(X_rule-profile) = recid(buf_rule-profile).
     3087   find first X_rule-by-profile no-lock where
     3088           recid(X_rule-by-profile) = recid(buf_rule-by-profile).
     3089   find first X_rule no-lock where
     3090           recid(X_rule) = recid(buf_rule).
     3091   v-rule-profile-id = p-profile-id.
     3092   END PROCEDURE.
