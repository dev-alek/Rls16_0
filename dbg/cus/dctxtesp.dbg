      407   procedure schedule-attr-name :
      408   do
      409     on error undo, return error
      410     :
      411     define input  parameter p-code           as character no-undo .
      412     define output parameter p-type           as character no-undo .
      413     define output parameter p-format         as character no-undo .
      414     define output parameter p-label          as character no-undo .
      415     define output parameter p-user-can-edit  as logical   no-undo .
      416     define output parameter p-output-display as logical   no-undo .
      417     define output parameter p-other          as character no-undo .
      418       if index(p-code, chr(4)) > 0 then do:
      419         p-code = entry(1, p-code, chr(4)).
      420       end.
      421       case p-code :
      422               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      423               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      424               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      425               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      426               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      427               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      428               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      429               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      430               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      431         otherwise do:
      432           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      433         end.
      434       end.
      435     end.
      436   end procedure.
      437   procedure schedule-attr-tooltip :
      438   do
      439     on error undo, return error
      440     :
      441       define input  parameter p-code    as character no-undo .
      442       define output parameter p-tooltip as character no-undo .
      443       define output parameter p-label   as character no-undo .
      444       if index(p-code, chr(4)) > 0 then do:
      445         p-code = entry(1, p-code, chr(4)).
      446       end.
      447       case p-code :
      448               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      449               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      450               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      451               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      452               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      453               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      454               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      455               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      456               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      457         otherwise do:
      458               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      459         end.
      460       end.
      461     end.
      462   end procedure.
      463   procedure schedule-attr-value :
      464   do
      465   on error undo, return error return-value
      466   :
      467   define input parameter  p-cre-db-num as integer    no-undo.
      468   define input parameter  p-task-type  as character  no-undo.
      469   define input parameter  p-task-num   as integer    no-undo.
      470   define input parameter  p-code       as character  no-undo.
      471   define output parameter p-value      as character  no-undo.
      472   define output parameter p-type       as character  no-undo.
      473       define variable v-format         as character no-undo .
      474       define variable v-label          as character no-undo .
      475       define variable v-user-can-edit  as logical   no-undo .
      476       define variable v-output-display as logical   no-undo .
      477       define variable v-other          as character no-undo .
      478       define buffer buf_schedule-attr for ub.schedule-attr.
      479       run schedule-attr-name in this-procedure (
      480             input  p-code
      481           , output p-type
      482           , output v-format
      483           , output v-label
      484           , output v-user-can-edit
      485           , output v-output-display
      486           , output v-other
      487       ) no-error .
      488       if error-status :error
      489       then do:
      490           undo, return error return-value .
      491       end.
      492       if p-code begins ('schd-free-id':U + chr(4))
      493       and entry(2, p-code, chr(4)) = '':U then do:
      494         find first buf_schedule-attr no-lock
      495             where buf_schedule-attr.cre-db-num = p-cre-db-num
      496               and buf_schedule-attr.task-type  = p-task-type
      497               and buf_schedule-attr.task-num   = p-task-num
      498               and buf_schedule-attr.attr-code  begins p-code
      499         no-error .
      500       end.
      501       else do:
      502         find first buf_schedule-attr no-lock
      503             where buf_schedule-attr.cre-db-num = p-cre-db-num
      504               and buf_schedule-attr.task-type  = p-task-type
      505               and buf_schedule-attr.task-num   = p-task-num
      506               and buf_schedule-attr.attr-code  = p-code
      507         no-error .
      508       end.
      509       if available buf_schedule-attr
      510       then do:
      511           assign
      512               p-value = buf_schedule-attr.attr-value
      513           .
      514       end.
      515       else do:
      516         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      517            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      518         end.
      519         else do:
      520           assign
      521               p-value = if p-type = 'L':U then "no":U else ""
      522           .
      523         end.
      524       end.
      525   end.
      526   end procedure.
      527   procedure schedule-attr-write :
      528   do
      529   on error undo, return error
      530   :
      531   define input parameter p-cre-db-num  as integer   no-undo.
      532   define input parameter p-task-type   as character no-undo.
      533   define input parameter p-task-num    as integer   no-undo.
      534   define input parameter p-code        as character no-undo.
      535   define input parameter p-value       as character no-undo.
      536       define variable v-type              as character                no-undo.
      537       define variable v-format            as character                no-undo.
      538       define variable v-label             as character                no-undo.
      539       define variable v-user-can-edit     as logical                  no-undo.
      540       define variable v-output-display    as logical                  no-undo.
      541       define variable v-other             as character                no-undo.
      542       define buffer buf_schedule-attr for ub.schedule-attr .
      543       run schedule-attr-name in this-procedure (
      544             input  p-code
      545           , output v-type
      546           , output v-format
      547           , output v-label
      548           , output v-user-can-edit
      549           , output v-output-display
      550           , output v-other
      551       ) no-error.
      552       if error-status :error
      553       then do:
      554           undo, return error return-value.
      555       end.
      556       find first buf_schedule-attr exclusive-lock
      557            where buf_schedule-attr.cre-db-num = p-cre-db-num
      558              and buf_schedule-attr.task-type  = p-task-type
      559              and buf_schedule-attr.task-num   = p-task-num
      560              and buf_schedule-attr.attr-code  = p-code
      561       no-error.
      562       if not available buf_schedule-attr
      563       then do:
      564           create buf_schedule-attr.
      565           assign
      566             buf_schedule-attr.cre-db-num = p-cre-db-num
      567             buf_schedule-attr.task-type  = p-task-type
      568             buf_schedule-attr.task-num   = p-task-num
      569             buf_schedule-attr.attr-code  = p-code
      570             buf_schedule-attr.attr-value = p-value
      571           .
      572       end.
      573       else do:
      574           assign
      575               buf_schedule-attr.attr-value = p-value
      576           .
      577       end.
      578   end.
      579   end procedure.
      580   procedure schedule-attr-delete :
      581   do
      582   on error undo, return error
      583   :
      584   define input  parameter p-cre-db-num  as integer   no-undo.
      585   define input  parameter p-task-type   as character no-undo.
      586   define input  parameter p-task-num    as integer   no-undo.
      587   define input  parameter p-code        as character no-undo.
      588   define output parameter p-deleted     as logical   no-undo.
      589       define buffer buf_schedule-attr for ub.schedule-attr .
      590       define variable v-type              as character                no-undo.
      591       define variable v-format            as character                no-undo.
      592       define variable v-label             as character                no-undo.
      593       define variable v-user-can-edit     as logical                  no-undo.
      594       define variable v-output-display    as logical                  no-undo.
      595       define variable v-other             as character                no-undo.
      596       run schedule-attr-name in this-procedure (
      597             input p-code
      598           , output v-type
      599           , output v-format
      600           , output v-label
      601           , output v-user-can-edit
      602           , output v-output-display
      603           , output v-other
      604       ) no-error .
      605       if error-status :error
      606       then do:
      607           undo, return error return-value .
      608       end.
      609       find first buf_schedule-attr exclusive-lock
      610            where buf_schedule-attr.cre-db-num = p-cre-db-num
      611              and buf_schedule-attr.task-type  = p-task-type
      612              and buf_schedule-attr.task-num   = p-task-num
      613              and buf_schedule-attr.attr-code  = p-code
      614       no-error.
      615       if not available buf_schedule-attr
      616       then do:
      617           assign
      618               p-deleted = no
      619           .
      620       end.
      621       else do:
      622           delete buf_schedule-attr.
      623           assign
      624               p-deleted = yes
      625           .
      626       end.
      627   end.
      628   end procedure.
      629   procedure schedule-attr-news :
      630   do
      631   on error undo, return error
      632   :
      633       define input  parameter p-code           as character no-undo .
      634       define output parameter p-news           as logical   no-undo .
      635       if index(p-code, chr(4)) > 0 then do:
      636         p-code = entry(1, p-code, chr(4)).
      637       end.
      638       case p-code :
      639               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      640               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      641               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      642               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      643               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      644               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      645               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      646               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      647               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      648         otherwise do:
      649           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      650         end.
      651       end.
      652   end.
      653   end procedure.
      654   procedure schedule-attr-extract-logical :
      655   do
      656   on error undo, return error
      657   :
      658   define input  parameter p-parameter-number   as integer      no-undo.
      659   define input  parameter p-parameter-list     as character    no-undo.
      660   define output parameter p-parameter-value   as logical      no-undo.
      661       if num-entries( p-parameter-list ) > p-parameter-number - 1
      662       then do:
      663           assign
      664               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      665           .
      666       end.
      667       else do:
      668           assign
      669               p-parameter-value   = no
      670           .
      671       end.
      672   end.
      673   end procedure.
      674   procedure schedule-attr-get-free-id :
      675   do
      676   on error undo, return error return-value
      677   :
      678     define input  parameter p-cre-db-num  as integer   no-undo.
      679     define input  parameter p-task-type   as character no-undo.
      680     define input  parameter p-task-num    as integer   no-undo.
      681     define output parameter p-free-id     as character no-undo.
      682     define buffer buf_schedule-attr for ub.schedule-attr.
      683     find first buf_schedule-attr no-lock
      684         where buf_schedule-attr.cre-db-num = p-cre-db-num
      685           and buf_schedule-attr.task-type  = p-task-type
      686           and buf_schedule-attr.task-num   = p-task-num
      687           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      688     no-error .
      689     if available buf_schedule-attr then
      690     assign
      691     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      692     no-error
      693     .
      694   end.
      695   end procedure.
      696   procedure schedule-attr-get-free-props :
      697     define input parameter p-free-id as character no-undo .
      698     define output parameter p-value as character no-undo .
      699     define buffer buf_temp-schedule-free for temp-schedule-free.
      700     do
      701     on error undo, return error return-value
      702     :
      703       find first buf_temp-schedule-free no-lock no-error .
      704       if not available buf_temp-schedule-free then do:
      705         run schedule-attr-fill-free-props in this-procedure .
      706       end.
      707       find first buf_temp-schedule-free where
      708               buf_temp-schedule-free.free-id = p-free-id no-error.
      709       if available buf_temp-schedule-free then do:
      710         assign
      711         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      712                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      713                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      714                   buf_temp-schedule-free.conf-param           + chr(4) +
      715                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      716                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      717                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      718                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      719                   buf_temp-schedule-free.other-info
      720         .
      721       end.
      722       else do:
      723        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      724                              "id произвольной задачи - &5"
      725                              ,vss-workfile
      726                              ,vss-revision
      727                              ,vss-description
      728                              ,chr(10)
      729                              ,p-free-id).
      730       end.
      731     end.
      732   end procedure.
      733   procedure schedule-attr-is-rum-free-id :
      734   define input parameter p-free-id as character no-undo .
      735   define output parameter p-is-rum as logical no-undo .
      736   define buffer buf_temp-schedule-free for temp-schedule-free.
      737   do
      738   on error undo, return error
      739   :
      740       find first buf_temp-schedule-free no-lock no-error .
      741       if not available buf_temp-schedule-free then do:
      742         run schedule-attr-fill-free-props in this-procedure .
      743       end.
      744       find first buf_temp-schedule-free where
      745               buf_temp-schedule-free.free-id = p-free-id no-error.
      746       if available buf_temp-schedule-free
      747       and buf_temp-schedule-free.is-rum
      748       then do:
      749         p-is-rum = yes.
      750       end.
      751   end.
      752   end procedure.
      753   procedure schedule-attr-fill-free-props :
      754   define variable v-path                    as character                no-undo .
      755   DEFINE VARIABLE v-full-path               as character                no-undo .
      756   DEFINE VARIABLE v-file-name               as character                no-undo .
      757   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      758   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      759   define buffer buf_temp-schedule-free for temp-schedule-free.
      760   define variable v-answer as logical no-undo .
      761     do
      762     on error undo, return error substitute("&1 &2 &3&4&5&4"
      763                                           ,vss-workfile
      764                                           ,vss-revision
      765                                           ,vss-description
      766                                           ,chr(10)
      767                                           ,error-status:get-message(1) )
      768     :
      769       run gbl/filename.p (
      770                       input 'cmp/shd-free.d'
      771                     ,output v-full-path
      772                     ,output v-path
      773                     ,output v-file-name
      774                     ,output v-file-name-no-ext
      775                     ,output v-file-name-ext
      776                     ) .
      777       input from value(v-full-path).
      778       repeat :
      779         create buf_temp-schedule-free.
      780         import buf_temp-schedule-free.
      781       END.
      782       input close.
      783       _ff:
      784       for each buf_temp-schedule-free :
      785         if buf_temp-schedule-free.free-id = '':U then do:
      786            delete buf_temp-schedule-free.
      787            next _ff.
      788          end.
      789          run schedule-attr-check-enc in this-procedure (
      790                                                       input  buf_temp-schedule-free.free-id
      791                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      792                                                               buf_temp-schedule-free.proc-param-edit-name +
      793                                                               buf_temp-schedule-free.conf-param +
      794                                                               string(buf_temp-schedule-free.is-gbd) +
      795                                                               string(buf_temp-schedule-free.is-ubd) +
      796                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      797                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      798                                                               string(buf_temp-schedule-free.other-info)
      799                                                               )
      800                                                       ,input  buf_temp-schedule-free.enc-key
      801                                                       ,output v-answer    ) no-error .
      802          if error-status:error
      803          or not v-answer then delete buf_temp-schedule-free.
      804        end.
      805     end.
      806   end procedure.
      807   Function schedule-attr-reverse returns character (str as character).
      808      define variable rev_incl_s as character init "" no-undo .
      809      define variable rev_incl_i as integer no-undo .
      810      define variable rev_incl_l as integer no-undo .
      811      rev_incl_l = length(str).
      812      do rev_incl_i = 1 to rev_incl_l:
      813         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      814      end.
      815      return rev_incl_s.
      816   end.
      817   procedure schedule-attr-check-enc.
      818     define input  parameter p-free-id   as character no-undo .
      819     define input  parameter p-value     as character no-undo .
      820     define input  parameter p-enc-value as character no-undo .
      821     define output parameter p-answer    as logical   no-undo .
      822     define variable tmp         as character no-undo .
      823     define variable v-enc-value as character no-undo .
      824     assign
      825     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      826     .
      827     run schedule-attr-pswd-enc in this-procedure
      828       ( input tmp
      829        ,output v-enc-value
      830       ) no-error .
      831     if error-status:error then do:
      832       message
      833         vss-workfile vss-revision vss-description skip
      834         "Ошибка при вызове процедуры pswd-enc" skip
      835         return-value skip
      836         error-status :get-message(1) skip
      837         view-as alert-box error .
      838       undo, return error .
      839     end.
      840     if v-enc-value = p-enc-value then do:
      841       assign
      842         p-answer = true
      843       .
      844     end.
      845     else do:
      846       assign
      847         p-answer = false
      848       .
      849     end.
      850   end.
      851   procedure schedule-attr-conf-enc.
      852     define input  parameter p-free-id   as character no-undo .
      853     define input  parameter p-value     as character no-undo .
      854     define output parameter p-enc-value as character no-undo .
      855     define variable tmp         as character no-undo .
      856     assign
      857       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      858     .
      859     run schedule-attr-pswd-enc in this-procedure
      860       ( input tmp
      861        ,output p-enc-value
      862       ) no-error .
      863     if error-status:error then do:
      864       message
      865         vss-workfile vss-revision vss-description skip
      866         "Ошибка при вызове процедуры pswd-enc" skip
      867         return-value skip
      868         error-status :get-message(1) skip
      869         view-as alert-box error .
      870       undo, return error .
      871     end.
      872   end procedure.
      873   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   procedure schedule-attr-pswd-enc :
      875     define input parameter  pswd     as character no-undo .
      876     define output parameter enc-pswd as character no-undo .
      877     do
      878     on error undo, return error return-value
      879     :
      880       assign
      881         enc-pswd = encode(pswd + string(index(pswd, "k")))
      882       .
      883     end.
      884   end procedure.
      885   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   procedure cur-time :
      887      define output parameter p-today as date      no-undo .
      888      define output parameter p-time  as integer   no-undo .
      889     do
      890     on error undo, return error
      891     :
      892       define variable v-date1 as date      no-undo .
      893       define variable v-date2 as date      no-undo .
      894       define variable v-time  as integer   no-undo .
      895       assign
      896         v-date1 = today
      897         v-time  = time
      898         v-date2 = today
      899       .
      900       if v-date1 <> v-date2
      901       then do:
      902         assign
      903           v-date1 = today
      904           v-time  = v-time
      905         .
      906       end.
      907       assign
      908         p-today = v-date1
      909         p-time  = v-time
      910       .
      911     end.
      912   end.
      913   function cur-time-date returns character
      914   :
      915     return string(today, '99/99/9999':U) .
      916   end.
      917   function cur-time-mjd returns decimal
      918   :
      919     define variable v-date as date      no-undo .
      920     define variable v-time as integer   no-undo .
      921     run cur-time in this-procedure
      922       (output v-date
      923       ,output v-time
      924       ) .
      925     return integer(v-date) - 2400002 + (v-time / 86400) .
      926   end.
      927   function cur-time-get-ending-index returns integer
      928   (input p-number as integer
      929   )
      930   :
      931     if p-number < 0
      932     or p-number = ?
      933     then do:
      934       return 1 .
      935     end.
      936     define variable v-rest as integer   no-undo .
      937     assign
      938       p-number = p-number modulo 100
      939     .
      940     if p-number < 20
      941     then do:
      942       assign
      943         v-rest = p-number
      944       .
      945     end.
      946     else do:
      947       assign
      948         v-rest = p-number modulo 10
      949       .
      950     end.
      951     case v-rest :
      952       when 1
      953       then do:
      954         return 2 .
      955       end.
      956       when 2 or
      957       when 3 or
      958       when 4
      959       then do:
      960         return 3 .
      961       end.
      962       otherwise do:
      963         return 1 .
      964       end.
      965     end case .
      966   end.
      967   procedure cur-time-mjd-to-date :
      968      define input  parameter i-mjd-diff as decimal no-undo.
      969      define output parameter o-Date     as date    no-undo.
      970      define output parameter o-Time     as integer no-undo.
      971      define variable v-day-number as integer   no-undo .
      972      if    i-mjd-diff < 0
      973         or i-mjd-diff = ?
      974      then do:
      975         return "?" .
      976      end.
      977      assign
      978         v-day-number = truncate(i-mjd-diff,0).
      979         o-Date = date(v-day-number + 2400002).
      980         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      981     .
      982   end.
      983   function cur-time-mjd-to-string returns character
      984   (input p-mjd-diff as decimal
      985   )
      986   :
      987     define variable v-day-number as integer   no-undo .
      988     define variable v-seconds    as integer   no-undo .
      989     define variable v-hour       as integer   no-undo .
      990     define variable v-min        as integer   no-undo .
      991     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      992     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      993     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      994     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      995     if p-mjd-diff < 0
      996     or p-mjd-diff = ?
      997     then do:
      998       return "?" .
      999     end.
     1000     assign
     1001       v-day-number = integer(truncate(p-mjd-diff,0))
     1002       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1003     .
     1004     if v-seconds > 86400
     1005     then do:
     1006       assign
     1007         v-seconds = 86400 - 1
     1008       .
     1009     end.
     1010     if v-seconds < 0
     1011     then do:
     1012       assign
     1013         v-seconds = 0
     1014       .
     1015     end.
     1016     assign
     1017       v-hour = truncate(v-seconds / 3600, 0)
     1018     .
     1019     assign
     1020       v-seconds = v-seconds modulo 3600
     1021     .
     1022     assign
     1023       v-min = truncate(v-seconds / 60, 0)
     1024     .
     1025     assign
     1026       v-seconds = v-seconds modulo 60
     1027     .
     1028     return
     1029         (if v-day-number <> 0
     1030           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1031           else ""
     1032         )
     1033       + (if v-day-number <> 0 or v-hour <> 0
     1034           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1035           else ""
     1036         )
     1037       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1038           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1039           else ""
     1040         )
     1041       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1042       .
     1043   end.
     1044   function cur-time-string returns character
     1045   :
     1046     define variable v-date as date      no-undo .
     1047     define variable v-time as integer   no-undo .
     1048     run cur-time in this-procedure
     1049       (output v-date
     1050       ,output v-time
     1051       ) .
     1052     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1053   end.
     1054   function cur-time-string-sec returns character
     1055   :
     1056     define variable v-date as date      no-undo .
     1057     define variable v-time as integer   no-undo .
     1058     run cur-time in this-procedure
     1059       (output v-date
     1060       ,output v-time
     1061       ) .
     1062     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1063   end.
     1064   function cur-time-custom  returns character
     1065   (input p-prefix as character
     1066   ,input p-date-format as character
     1067   ,input p-delimiter as character
     1068   ,input p-time-format as character
     1069   ,input p-suffix as character
     1070   )
     1071   :
     1072     define variable v-date as date      no-undo .
     1073     define variable v-time as integer   no-undo .
     1074     run cur-time in this-procedure
     1075       (output v-date
     1076       ,output v-time
     1077       ) .
     1078     return
     1079       p-prefix
     1080       + string(v-date, p-date-format)
     1081       + p-delimiter
     1082       + string(v-time, p-time-format)
     1083       + p-suffix
     1084       .
     1085   end.
     1086   function cur-time-print  returns character
     1087   :
     1088     define variable v-date as date      no-undo .
     1089     define variable v-time as integer   no-undo .
     1090     run cur-time in this-procedure
     1091       (output v-date
     1092       ,output v-time
     1093       ) .
     1094     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1095   end.
     1096   function cur-time-datetime returns datetime
     1097   :
     1098     define variable v-char as character no-undo .
     1099     define variable v-datetime as datetime no-undo .
     1100     v-char = cur-time-string().
     1101     v-datetime = datetime(v-char).
     1102     return  v-datetime.
     1103   end.
     1104   function cur-time-string-msec returns character
     1105   :
     1106     define variable v-date as datetime  no-undo .
     1107     v-date = now.
     1108     return string(v-date) .
     1109   end.
     1110   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   PROCEDURE verify-ini-entry:
     1112   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1113   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1114   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1115   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1116   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1117   define variable v-mess as character no-undo .
     1118   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1119   if ini-entry-value = ? and ini-key-name begins "spl"
     1120   then
     1121   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1122   if ini-entry-value = ? and ini-key-name begins "sav"
     1123   then
     1124   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1125   if ini-entry-value = ? then do:
     1126     assign
     1127     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1128                       , chr(10)
     1129                       , ini-section-name
     1130                       , ini-key-name
     1131                       , error-msg-text).
     1132       if not silence then do:
     1133         message
     1134         v-mess
     1135         view-as alert-box ERROR  .
     1136         return error.
     1137       end.
     1138       else do:
     1139         return error v-mess.
     1140       end.
     1141   end.
     1142   END PROCEDURE.
     1143   PROCEDURE verify-file:
     1144   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1145   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1146   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1147   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1148   file-info:file-name = filename.
     1149   found = NOT (file-info:full-pathname = ?).
     1150   if NOT found  then do:
     1151     if not silence then do:
     1152       message error-msg-text
     1153       view-as alert-box ERROR.
     1154       return error.
     1155     end.
     1156     else return error error-msg-text.
     1157   end.
     1158   END PROCEDURE.
     1159   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160     define variable v-cntxt-db-num        as integer   no-undo .
     1161     define variable v-cntxt-userid        as character no-undo .
     1162     define variable v-cntxt-level         as character no-undo .
     1163     define variable v-cntxt-host-code-obj as integer   no-undo .
     1164     define variable v-cntxt-obj-type      as character no-undo .
     1165     define variable v-cntxt-obj-code      as integer   no-undo .
     1166     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1167     define variable v-cntxt-is-admin      as logical   no-undo .
     1168   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1169   define temp-table userobjs_temp-user-obj no-undo
     1170     field obj-type as character
     1171     field obj-code as integer
     1172     index xpk is primary unique obj-type obj-code
     1173     .
     1174   procedure userobjs_clear :
     1175     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1176     do
     1177     on error undo, return error return-value
     1178     :
     1179       for each buf_userobjs_temp-user-obj
     1180       on error undo, return error return-value
     1181       :
     1182         delete buf_userobjs_temp-user-obj .
     1183       end.
     1184     end.
     1185   end .
     1186   procedure userobjs_object-count :
     1187     define output parameter p-total-count as integer   no-undo .
     1188     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1189     do
     1190     on error undo, return error return-value
     1191     :
     1192       assign
     1193         p-total-count = 0
     1194       .
     1195       for each buf_userobjs_temp-user-obj
     1196       on error undo, return error return-value
     1197       :
     1198         assign
     1199           p-total-count = p-total-count + 1
     1200         .
     1201       end.
     1202     end.
     1203   end.
     1204   procedure userobjs_append :
     1205      define input  parameter p-obj-type as character no-undo .
     1206      define input  parameter p-obj-code as integer   no-undo .
     1207     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1208     do
     1209     on error undo, return error return-value
     1210     :
     1211       find first buf_userobjs_temp-user-obj
     1212         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1213           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1214         no-error .
     1215       if not available buf_userobjs_temp-user-obj
     1216       then do:
     1217         create buf_userobjs_temp-user-obj .
     1218         assign
     1219           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1220           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1221         .
     1222       end.
     1223     end.
     1224   end.
     1225   procedure userobjs_object-exist :
     1226     define output parameter p-object-exist as logical   no-undo .
     1227     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1228     do
     1229     on error undo, return error return-value
     1230     :
     1231       find first buf_userobjs_temp-user-obj
     1232         no-error .
     1233       if not available buf_userobjs_temp-user-obj
     1234       then do:
     1235         assign
     1236           p-object-exist = false
     1237         .
     1238       end.
     1239       else do:
     1240         assign
     1241           p-object-exist = true
     1242         .
     1243       end.
     1244     end.
     1245   end.
     1246   procedure userobjs_transfer :
     1247     define input  parameter p-callback-handle as handle no-undo .
     1248     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1249     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1250     do
     1251     on error undo, return error return-value
     1252     :
     1253       if valid-handle(p-callback-handle) <> true
     1254       then do:
     1255         message
     1256           vss-workfile vss-revision vss-description skip
     1257           "Ошибка задания входных параметров" skip
     1258           "Неизвестный указатель на процедуру" skip
     1259           view-as alert-box error .
     1260         undo, return error return-value .
     1261       end.
     1262       if p-callback-handle :get-signature("userobjs_append") = ""
     1263       then do:
     1264         message
     1265           vss-workfile vss-revision vss-description skip
     1266           "Ошибка задания входных параметров" skip
     1267           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1268                     ,p-callback-handle :file-name
     1269                     ) skip
     1270           view-as alert-box error .
     1271         undo, return error return-value .
     1272       end.
     1273       for each buf_userobjs_temp-user-obj
     1274       on error undo, return error return-value
     1275       :
     1276         run userobjs_append in p-callback-handle
     1277           (input  buf_userobjs_temp-user-obj.obj-type
     1278           ,input  buf_userobjs_temp-user-obj.obj-code
     1279           ) .
     1280       end.
     1281     end.
     1282   end procedure.
