      526   define  shared  variable loc-doc-type   like ub.ord-doc.doc-type no-undo .
      527   define  shared  variable temp-e-method  as character no-undo .
      528   define  shared  variable x-tog-artic as logical   no-undo .
      529   define  shared  variable x-tog-grp    as logical   no-undo .
      530   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   define variable v-waitfram-action01         as character   no-undo .
      532   define variable v-waitfram-action02         as character   no-undo .
      533   define variable v-waitfram-action03         as character   no-undo .
      534   define variable mWaitFramTextBeg            as character   no-undo.
      535   define variable mWaitFramTextEnd            as character   no-undo.
      536   define variable mWaitFramView               as logical     no-undo.
      537   define variable mWaitProcEvent              as logical     no-undo init yes.
      538   define variable mWaitFramInterval           as integer     no-undo init 1 .
      539   define variable mWaitFramStop               as logical     no-undo.
      540   define variable mWaitFramStopUser           as logical     no-undo.
      541   define variable mWaitFramStopTimeOut        as logical     no-undo.
      542   define variable mWaitFramStartProc          as datetime-tz no-undo.
      543   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      544   define button B-WaitFramStop auto-end-key
      545        label "Стоп"
      546        size 10 by 1 tooltip "Остоновить процесс".
      547   define button B-viewProcInfo
      548        label "Информация"
      549        size 15 by 1 tooltip "Информация о процесс".
      550   define frame waitfram
      551     v-waitfram-action01 format "x(72)" no-label skip
      552     v-waitfram-action02 format "x(72)" no-label skip
      553     v-waitfram-action03 format "x(72)" no-label skip
      554     B-viewProcInfo
      555     B-WaitFramStop at row 4 col 30
      556     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      557     .
      558   define new global shared variable mBatchMode as logical no-undo init ?.
      559   define variable mFramBachModHandle as handle no-undo.
      560   mFramBachModHandle = frame waitfram:handle.
      561   define variable mFameOldVis as logical no-undo.
      562   define variable mVisCUrentVin as logical no-undo.
      563   if session:batch-mode
      564   then
      565      mBatchMode = yes.
      566   if mBatchMode = ? then do:
      567     mVisCUrentVin = current-window:visible.
      568     mFameOldVis = mFramBachModHandle:visible.
      569     mFramBachModHandle:visible  = yes.
      570     mBatchMode = mFramBachModHandle:visible ne yes.
      571     mFramBachModHandle:visible = mFameOldVis.
      572     current-window:visible = mVisCUrentVin.
      573   end.
      574    if  log-manager:logfile-name ne ?
      575     then DO:
      576         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      577         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      578         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      579     end.
      580   on choose of B-WaitFramStop in frame waitfram
      581   do:
      582     mWaitFramStop = yes.
      583     mWaitFramStopUser = yes.
      584   end.
      585   function waitfram-check-timeout returns logical():
      586      define variable vtime as int64 no-undo.
      587      if mWaitFramStopTimeOut
      588      then
      589         return yes.
      590      vtime = ( now - mWaitFramStartProc ) / 1000 .
      591      if     mWaitFramTimeOut ne ?
      592         and mWaitFramTimeOut ne 0
      593         and mWaitFramTimeOut lt vtime
      594      then do:
      595         mWaitFramStopTimeOut = yes.
      596      end.
      597      return mWaitFramStopTimeOut.
      598   end.
      599   procedure waitfram-hide :
      600     if not session:batch-mode
      601     then do
      602     on error undo, return error return-value
      603     :
      604       pause 0 before-hide .
      605       if not mBatchMode then
      606         hide frame waitfram .
      607     if     not mWaitFramView
      608        and mWaitProcEvent
      609     then
      610       process events .
      611     end.
      612   end procedure.
      613   procedure waitfram-show :
      614     define input  parameter p-message as character no-undo .
      615     define variable v-left-margin as integer   no-undo .
      616     if not session:batch-mode
      617     then do
      618     on error undo, return error return-value
      619     :
      620       if length(p-message) <= 70 then do:
      621         assign
      622           v-left-margin = integer((70 - length(p-message)) / 2)
      623         .
      624         assign
      625           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      626         .
      627         assign
      628           v-waitfram-action01 = " "
      629           v-waitfram-action02 = " "
      630                                    + fill(" ", v-left-margin)
      631                                    + p-message
      632           v-waitfram-action03 = " "
      633         .
      634       end.
      635       else do:
      636         define variable vRindex1 as integer no-undo.
      637         define variable vRindex2 as integer no-undo.
      638         vRindex1 = r-index(p-message," ",70).
      639         if vRindex1 = 0
      640         then
      641            vRindex1 = 70.
      642         if length(p-message)  <= vRindex1 + 70 then do:
      643           assign
      644             v-waitfram-action01 = " "
      645             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      646             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      647           .
      648         end.
      649         else do:
      650           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      651           if vRindex2 <= vRindex1
      652           then
      653              vRindex2 = vRindex1 + 70.
      654           assign
      655             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      656             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      657             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      658           .
      659         end.
      660       end.
      661       B-viewProcInfo:visible   in frame waitfram = no.
      662       B-viewProcInfo:sensitive in frame waitfram = no.
      663       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      664       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      665       if  (   mWaitFramView
      666          or  mWaitProcEvent)
      667          and not mBatchMode
      668       then
      669          display
      670             v-waitfram-action01 skip
      671             v-waitfram-action02 skip
      672             v-waitfram-action03 skip
      673          with frame waitfram .
      674       if     mWaitFramView
      675          then do:
      676             if     mWaitFramInterval ne ?
      677                and not mBatchMode
      678             then
      679                wait-for go of frame waitfram pause mWaitFramInterval.
      680          end.
      681          else
      682             if     mWaitProcEvent
      683                and not mBatchMode
      684             then
      685                process events .
      686     end.
      687   end procedure.
      688      procedure waitfram-show-this:
      689         define input  parameter iInterval as int64 no-undo.
      690         define variable vtime as int64 no-undo.
      691         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      692         mWaitFramInterval = iInterval.
      693         run waitfram-show (substitute("&1&2 &3&4" ,
      694                                       mWaitFramTextBeg ,
      695                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      696                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      697                                       mWaitFramTextEnd
      698                                      )
      699                           ).
      700      end.
      701      procedure WaitFramRunPause:
      702         define input  parameter iInterval as dec no-undo.
      703         define variable vStart  as datetime-tz no-undo.
      704         define variable vend    as datetime-tz no-undo.
      705         define variable vint as int64 no-undo.
      706         define variable vOk as logical no-undo.
      707         vStart = now.
      708         vend   = vStart.
      709         publish "WaitFramPause" (iInterval,output vOk).
      710         vend   =  now.
      711         vint = vend - vStart.
      712         vint = iInterval - vint / 1000.
      713         if     not mWaitFramStop
      714            and (   vint > 0
      715                 or (    not vOk
      716                     and iInterval eq ?
      717                     )
      718                 )
      719         then
      720            run waitfram-show-this (iInterval).
      721         vend   =  now.
      722         vint = vend - vStart.
      723         vint = iInterval - vint / 1000.
      724         if     not mWaitFramStop
      725            and vint > 0
      726         then do:
      727            run gbl/pause.p (vint * 1000).
      728         end.
      729         if iInterval ne ?
      730         then
      731            publish "WaitFramStop".
      732         waitfram-check-timeout().
      733      end.
      734      procedure WaitFramWaitFor:
      735         define input  parameter iInterval as dec no-undo.
      736         assign
      737            mWaitFramStartProc   = now
      738            mWaitFramStopUser    = no
      739            mWaitFramStopTimeOut = no
      740         .
      741         block-wait:
      742         do while not mWaitFramStop:
      743            run WaitFramRunPause (iInterval).
      744            if  waitfram-check-timeout()
      745            then do:
      746               leave block-wait.
      747            end.
      748         end.
      749         run waitfram-hide.
      750      end.
      751   procedure waitfram-join :
      752     define input  parameter p-line-1  as character no-undo .
      753     define input  parameter p-line-2  as character no-undo .
      754     define input  parameter p-line-3  as character no-undo .
      755     define output parameter p-message as character no-undo .
      756     do
      757     on error undo, return error return-value
      758     :
      759       assign
      760         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      761                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      762                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      763       .
      764     end.
      765   end procedure.
      766   function waitfram-join-function returns character
      767     (input p-line-1 as character
      768     ,input p-line-2 as character
      769     ,input p-line-3 as character
      770     ).
      771     define variable v-message as character no-undo .
      772     run waitfram-join in this-procedure
      773       (input  p-line-1
      774       ,input  p-line-2
      775       ,input  p-line-3
      776       ,output v-message
      777       ) .
      778     return v-message .
      779   end function .
