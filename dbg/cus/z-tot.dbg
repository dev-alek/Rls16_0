      853   procedure create_obj-list :
      854      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      855      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      856      do
      857      on error undo, return error return-value
      858      :
      859         define buffer cli-obj for ub.clients .
      860         define variable p-var as integer no-undo .
      861         define buffer buf_obj-list for obj-list .
      862         find last buf_obj-list  use-index pi no-error .
      863         if available buf_obj-list
      864         then
      865            p-var = buf_obj-list.obj-id + 1.
      866         else
      867            p-var = 1.
      868         find first cli-obj where
      869                   cli-obj.obj-type = p-obj-type
      870               and cli-obj.obj-code = p-obj-code
      871         no-lock no-error.
      872         if available cli-obj
      873         then do:
      874            create buf_obj-list.
      875            assign
      876               buf_obj-list.obj-id   = p-var
      877               buf_obj-list.obj-code = cli-obj.obj-code
      878               buf_obj-list.obj-type = cli-obj.obj-type
      879               buf_obj-list.obj-name = cli-obj.obj-name
      880               buf_obj-list.db-num   = cli-obj.db-num
      881            .
      882         end.
      883      end.
      884   end.
