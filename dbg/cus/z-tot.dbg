     1277   define new global shared variable g#library  as handle no-undo .
     1278   define new global shared variable g#library2 as handle no-undo .
     1279   define variable var-report-r-b as character no-undo .
     1280   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1282     (output var-report-r-b
     1283     )  .
     1284   my-handle = parparentproc.
     1285   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   procedure proc-alt-shift-f2:
     1287     if not ibs.th.gbl.gbl-var:rcode
     1288   then
     1289     run gbl\inidebug.p .
     1290   end.
     1291   procedure proc-alt-shift-f3:
     1292     run gbl/prvssinf.p
     1293       ( input this-procedure
     1294       ) .
     1295   end.
     1296   define variable v-inform-launched as logical no-undo initial false .
     1297   procedure proc-alt-shift-f4:
     1298     define variable v-action as character no-undo .
     1299     if v-inform-launched = false then do:
     1300       assign
     1301         v-inform-launched = true
     1302       .
     1303       run gbl/d-inform.w
     1304         (  input self
     1305         ,  input this-procedure
     1306         , output v-action
     1307         ) no-error .
     1308       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1309       assign
     1310         v-inform-launched = false
     1311       .
     1312     end.
     1313   end.
     1314   procedure proc-alt-f1:
     1315     run gbl/corrhelp.p
     1316       (input this-procedure
     1317       ) .
     1318   end .
     1319   on alt-shift-f2 anywhere do:
     1320     run proc-alt-shift-f2.
     1321   end.
     1322   on alt-shift-f3 anywhere do:
     1323     run proc-alt-shift-f3 in this-procedure .
     1324   end.
     1325   on alt-shift-f4 anywhere do:
     1326     run proc-alt-shift-f4 in this-procedure.
     1327   end.
     1328   on alt-f1 anywhere do:
     1329     run proc-alt-f1 in this-procedure .
     1330   end.
     1331   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332     define variable v-cntxt-db-num        as integer   no-undo .
     1333     define variable v-cntxt-userid        as character no-undo .
     1334     define variable v-cntxt-level         as character no-undo .
     1335     define variable v-cntxt-host-code-obj as integer   no-undo .
     1336     define variable v-cntxt-obj-type      as character no-undo .
     1337     define variable v-cntxt-obj-code      as integer   no-undo .
     1338     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1339     define variable v-cntxt-is-admin      as logical   no-undo .
     1340   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1341     run mainmenu_getcntxt in my-handle
     1342       (output v-cntxt-db-num
     1343       ,output v-cntxt-userid
     1344       ,output v-cntxt-level
     1345       ,output v-cntxt-host-code-obj
     1346       ,output v-cntxt-obj-type
     1347       ,output v-cntxt-obj-code
     1348       ,output v-cntxt-db-num-obj
     1349       ,output v-cntxt-is-admin
     1350       ) .
     1351   define variable base-type as character no-undo .
     1352   define variable base-code as integer   no-undo .
     1353   define variable g#report-num as integer   no-undo .
     1354   define variable g#gds-engl as logical   no-undo .
     1355   define variable vv-exch-rate  as decimal   no-undo .
     1356   define variable vv-exch-scale as decimal   no-undo .
     1357   define variable v-cntxt-host-name-obj as character no-undo .
     1358   if v-cntxt-level = 'object':U then do:
     1359   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1361     (input  v-cntxt-obj-type
     1362     ,input  v-cntxt-obj-code
     1363     ,output v-cntxt-host-code-obj
     1364     ,output v-cntxt-host-name-obj
     1365     )  .
     1366   end.
     1367   if v-cntxt-level = 'firm':U then do:
     1368     find first ub.clients no-lock where
     1369                ub.clients.obj-type = 'орг':U and
     1370                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1371   if error-status :error then v-cntxt-host-name-obj = ? .
     1372      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1373   end.
     1374   if v-cntxt-level = 'object':U
     1375   or v-cntxt-level = 'firm':U
     1376   then do:
     1377   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1379     (input  v-cntxt-host-code-obj
     1380     ,output base-code
     1381     )  .
     1382   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1384     (input  base-code
     1385     ,input  today
     1386     ,output vv-exch-rate
     1387     ,output vv-exch-scale
     1388     ,output base-type
     1389     )  .
     1390   end.
     1391   run get-report-num in my-handle ( output g#report-num ).
     1392   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1393   define  shared query br-docs for
     1394         shar_ord-line, tmp#zakaz  scrolling.
     1395   def  stream  OutStream.
     1396   define variable g#log as logical   no-undo .
     1397   define variable l-filename as character no-undo .
     1398   define variable i as int init 2 no-undo.
     1399   define variable T as char       no-undo.
     1400   define variable gds-name  like ub.goods.gds-name no-undo.
     1401   define variable unit-base like ub.goods.unit-base no-undo.
     1402   define variable s-bar-code like ub.bar-code.b-code no-undo .
     1403   if work-mode = "M" then do:
     1404                   error-status:error = no.
     1405                   l-filename = "order.txt" .
     1406                   system-dialog get-file  l-filename
     1407                       ask-overwrite
     1408                       save-as
     1409                       create-test-file
     1410                       use-filename
     1411                       update g#log
     1412                       default-extension "txt" .
     1413    if g#log Then
     1414      output stream OutStream to value ( l-filename ) .
     1415      Else  work-mode = "" .
     1416   End.
     1417   run waitfram-show ("Ждите...").
     1418   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,
     1419   each tmp#zakaz where
     1420   tmp#zakaz.artic = shar_ord-line.artic and
     1421   tmp#zakaz.prod-type = shar_ord-line.prod-type and
     1422   tmp#zakaz.prod-code = shar_ord-line.prod-code  .
     1423   if work-mode = "E" then do:
     1424         Assign
     1425         chWorkSheet2:Range  ("A1"):Value         = cur-time-print ()
     1426         chWorkSheet2:Columns  ("A"):ColumnWidth  = 10
     1427         chWorkSheet2:Columns  ("A"):NumberFormat = "@"
     1428         chWorkSheet2:Range    ("A2"):Value       = "Артикул"
     1429         chWorkSheet2:Range    ("D1"):Value       = LOC-OBJ-NAME
     1430         chWorkSheet2:Range    ("D1"):Font:Bold   = True
     1431         chWorkSheet2:Columns  ("B"):ColumnWidth  = 50
     1432         chWorkSheet2:Columns  ("B"):NumberFormat = "@"
     1433         chWorkSheet2:Range  ("B2"):Value = "Название товара"
     1434         chWorkSheet2:Range  ("C2"):Value = "Ед.изм."
     1435         chWorkSheet2:Range  ("D2"):Value = "Артикул поставщика"
     1436         chWorkSheet2:Range  ("E2"):Value = "Ед.изм. контрагента"
     1437         chWorkSheet2:Range  ("F2"):Value = "Кол-во приход по контрагенту"
     1438         chWorkSheet2:Range  ("G2"):Value = "Кол-во расход  по контрагенту"
     1439         chWorkSheet2:Range  ("H2"):Value = "Продаж.цены (вал.продаж) расход"
     1440         chWorkSheet2:Range  ("I2"):Value = "Последн.цена контрагента"
     1441         chWorkSheet2:Range  ("J2"):Value = "Кол-во остатки по контрагенту"
     1442         chWorkSheet2:Range  ("K2"):Value = "Темп расхода с " + String (date-1) + " по " + String (date-2)
     1443         chWorkSheet2:Range  ("L2"):Value = "Срок хранения"
     1444         chWorkSheet2:Range  ("M2"):Value = "Мин остаток"
     1445         chWorkSheet2:Range  ("N2"):Value = "Количество в упаковке"
     1446         chWorkSheet2:Range  ("O2"):Value = "ЗАКАЗ кол-во"
     1447         chWorkSheet2:Range  ("P2"):Value = "ЗАКАЗ сумма"
     1448         chWorkSheet2:Range  ("Q2"):Value = "Расход с " + String (date-1) + " по " + String (date-2)
     1449         chWorkSheet2:Range  ("R2"):Value = "Дней без продаж и остатков"
     1450         chWorkSheet2:Range  ("S2"):Value = "Приход / Расход"
     1451         chWorkSheet2:Range  ("T2"):Value = "Остаток на " + String (date-2) +  " по фирме"
     1452         chWorkSheet2:Range  ("U2"):Value = "Приход по фирме"
     1453         chWorkSheet2:Range  ("V2"):Value = "Внешний расход по фирме"
     1454         chWorkSheet2:Range  ("W2"):Value = "Касса по фирме"
     1455         chWorkSheet2:Range  ("X2"):Value = "Тип производителя"
     1456         chWorkSheet2:Range  ("Y2"):Value = "Код производителя"
     1457         chWorkSheet2:Range  ("Z2"):Value = "Наименование производителя"
     1458         chWorkSheet:Range  ("A2"):Value = "Артикул"
     1459         chWorkSheet:Range  ("B2"):Value = "Тип производителя"
     1460         chWorkSheet:Range  ("C2"):Value = "Код производителя"
     1461         chWorkSheet:Range  ("D2"):Value = "Наименование"
     1462         chWorkSheet:Range  ("E2"):Value = "Артикул поставщика"
     1463         chWorkSheet:Range  ("F2"):Value = "Цена поставщика"
     1464         chWorkSheet:Range  ("G2"):Value = "Кол-во"                                        .
     1465         chWorkSheet:Columns  ("A:G"):ColumnWidth = chWorkSheet2:Columns  ("A"):ColumnWidth .
     1466         chWorkSheet:Columns  ("D"):ColumnWidth = chWorkSheet2:Columns  ("B"):ColumnWidth   .
     1467         chWorkSheet:Columns  ("A:G"):NumberFormat = "@"  .
     1468         chWorkSheet2:Columns  ("A:Z"):NumberFormat = "@" .
     1469         chWorkSheet2:Range  ("A2:Z2"):HorizontalAlignment = 1 .
     1470         chWorkSheet2:Range  ("A2:Z2"):VerticalAlignment   = -4130 .
     1471         chWorkSheet2:Range  ("A2:Z2"):Interior:ColorIndex = 36           .
     1472         chWorkSheet:Range  ("A2:G2"):HorizontalAlignment = 1 .
     1473         chWorkSheet:Range  ("A2:G2"):VerticalAlignment   = -4130 .
     1474      Assign
     1475      chWorkSheet2:Range  ("A2:Z2"):Borders (5):LineStyle = -4142
     1476      chWorkSheet2:Range  ("A2:Z2"):Borders (6):LineStyle   = -4142
     1477      chWorkSheet2:Range  ("A2:Z2"):Borders (7):LineStyle  = 1
     1478      chWorkSheet2:Range  ("A2:Z2"):Borders (7):Weight     = 2
     1479      chWorkSheet2:Range  ("A2:Z2"):Borders (7):ColorIndex = -4105
     1480      chWorkSheet2:Range  ("A2:Z2"):Borders (8):LineStyle  = 1
     1481      chWorkSheet2:Range  ("A2:Z2"):Borders (8):Weight     = 2
     1482      chWorkSheet2:Range  ("A2:Z2"):Borders (8):ColorIndex = -4105
     1483      chWorkSheet2:Range  ("A2:Z2"):Borders (9):LineStyle  = 1
     1484      chWorkSheet2:Range  ("A2:Z2"):Borders (9):Weight     = 2
     1485      chWorkSheet2:Range  ("A2:Z2"):Borders (9):ColorIndex = -4105
     1486      chWorkSheet2:Range  ("A2:Z2"):Borders (10):LineStyle  = 1
     1487      chWorkSheet2:Range  ("A2:Z2"):Borders (10):Weight     = 2
     1488      chWorkSheet2:Range  ("A2:Z2"):Borders (10):ColorIndex = -4105
     1489      chWorkSheet2:Range  ("A2:Z2"):Borders (11):LineStyle  = 1
     1490      chWorkSheet2:Range  ("A2:Z2"):Borders (11):Weight     = 2
     1491      chWorkSheet2:Range  ("A2:Z2"):Borders (11):ColorIndex = -4105.
     1492         end.
     1493    DO WHILE available TMP#zakaz :
     1494       GET prev br-docs.
     1495    END.
     1496    assign
     1497       accum-count = 0
     1498       accum-zakaz = 0
     1499       accum-sum-zakaz = 0 .
     1500   GET next br-docs.
     1501   DO WHILE available tmp#zakaz :
     1502       assign
     1503       accum-count     = accum-count     +   1
     1504       accum-zakaz     = accum-zakaz     +   tmp#zakaz.qnty
     1505       accum-sum-zakaz = accum-sum-zakaz +   tmp#zakaz.sum.
     1506       if work-mode = "M" then do :
     1507           FIND FIRST ub.goods No-LOCK WHERE ub.goods.prod-type = tmp#zakaz.prod-type AND
     1508                                                                       ub.goods.prod-code = tmp#zakaz.prod-code AND
     1509                                                                       ub.goods.artic = tmp#zakaz.artic   NO-ERROR.
     1510           FIND FIRST ub.bar-code No-LOCK WHERE ub.goods.gds-code  = ub.bar-code.gds-code no-error .
     1511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1512     (input  ub.goods.gds-code
     1513     ,input  ?
     1514     ,output s-bar-code
     1515     )  .
     1516          PUT stream  OutStream
     1517                      s-bar-code
     1518                      ","
     1519                      trim  ( string ( tmp#zakaz.qnty , ">>>>>>>>>>9.<<<" ))
     1520                      skip.
     1521       End.
     1522       if work-mode = "E" then do:
     1523           FIND FIRST ub.currency NO-LOCK WHERE ub.currency.curr-code = tmp#zakaz.last-curr-code
     1524           No-ERROR.
     1525           FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = tmp#zakaz.prod-type AND
     1526                                            ub.clients.obj-code = tmp#zakaz.prod-code
     1527           No-ERROR.
     1528           FIND FIRST ub.goods No-LOCK WHERE ub.goods.prod-type = tmp#zakaz.prod-type AND
     1529                                          ub.goods.prod-code = tmp#zakaz.prod-code AND
     1530                                          ub.goods.artic     = tmp#zakaz.artic
     1531                                         NO-ERROR.
     1532           IF AVAILable ub.goods then
     1533               assign
     1534               gds-name = ub.goods.gds-name
     1535               unit-base = ub.goods.unit-base.
     1536           else
     1537           message
     1538             vss-workfile vss-revision vss-description skip
     1539             error-status :get-message(1) skip
     1540             return-value skip
     1541             "Ошибка поиска товара"
     1542             tmp#zakaz.prod-type
     1543             tmp#zakaz.prod-code
     1544             tmp#zakaz.artic
     1545             view-as alert-box error
     1546           .
     1547           Assign
     1548           I = I + 1
     1549           T = STRING (I)
     1550           chWorkSheet2:Range  ("A" + T):Value = tmp#zakaz.artic
     1551           chWorkSheet2:Range  ("B" + T):Value = gds-name
     1552           chWorkSheet2:Range  ("C" + T):Value = unit-base
     1553           chWorkSheet2:Range  ("E" + T):Value = tmp#zakaz.unit-cli
     1554           chWorkSheet2:Range  ("F" + T):Value = tmp#zakaz.in-qnty
     1555           chWorkSheet2:Range  ("G" + T):Value = tmp#zakaz.out-qnty
     1556           chWorkSheet2:Range  ("H" + T):Value = tmp#zakaz.out-sum
     1557           chWorkSheet2:Range  ("I" + T):Value = tmp#zakaz.price-cli
     1558           chWorkSheet2:Range  ("J" + T):Value = tmp#zakaz.supp-qnty
     1559           chWorkSheet2:Range  ("K" + T):Value = tmp#zakaz.Temp-rash
     1560           chWorkSheet2:Range  ("L" + T):Value = tmp#zakaz.deadline
     1561           chWorkSheet2:Range  ("M" + T):Value = tmp#zakaz.min-stock
     1562           chWorkSheet2:Range  ("N" + T):Value = if available ub.goods then  ub.goods.qnty-cart else 0
     1563           chWorkSheet2:Range  ("O" + T):Value = tmp#zakaz.qnty
     1564           chWorkSheet2:Range  ("P" + T):Value = tmp#zakaz.sum
     1565           chWorkSheet2:Range  ("Q" + T):Value = tmp#zakaz.qnty-sale
     1566           chWorkSheet2:Range  ("R" + T):Value = tmp#zakaz.zero-day
     1567           chWorkSheet2:Range  ("S" + T):Value = tmp#zakaz.in-qnty / tmp#zakaz.out-qnty
     1568           chWorkSheet2:Range  ("T" + T):Value = tmp#zakaz.qnty-stk
     1569           chWorkSheet2:Range  ("U" + T):Value = tmp#zakaz.qnty-prih
     1570           chWorkSheet2:Range  ("V" + T):Value = tmp#zakaz.qnty-rash
     1571           chWorkSheet2:Range  ("W" + T):Value = tmp#zakaz.qnty-kassa
     1572           chWorkSheet2:Range  ("X" + T):Value = tmp#zakaz.prod-type
     1573           chWorkSheet2:Range  ("Y" + T):Value = tmp#zakaz.prod-code
     1574           chWorkSheet2:Range  ("Z" + T):Value =  ( if available ub.clients then ub.clients.obj-name else "")
     1575           chWorkSheet:Range  ("A" + T):Value  = tmp#zakaz.artic
     1576           chWorkSheet:Range  ("B" + T):Value  = tmp#zakaz.prod-type
     1577           chWorkSheet:Range  ("C" + T):Value  = tmp#zakaz.prod-code
     1578           chWorkSheet:Range  ("D" + T):Value  = gds-name
     1579           chWorkSheet:Range  ("E" + T):Value  = tmp#zakaz.cli-art
     1580           chWorkSheet:Range  ("F" + T):Value  = tmp#zakaz.price-cli
     1581           chWorkSheet:Range  ("G" + T):Value  = tmp#zakaz.qnty    .
     1582          End.
     1583          GET next br-docs.
     1584   End.
     1585   if work-mode = "M" then do :
     1586      Output stream OutStream close.
     1587   End.
     1588    run waitfram-hide.
