     4979     if scr-boss <> ? and scr-boss <> 0 then do:
     4980         find first buf_clients no-lock where
     4981                   buf_clients.obj-type = 'чел':U  and
     4982                   buf_clients.obj-code  = scr-boss no-error.
     4983             if error-status :error or not available buf_clients then do:
     4984                 Message "Неправильно задан "  scr-boss:label in frame Dialog-Frame.
     4985                   Assign
     4986                   scr-boss-name = ""
     4987                   scr-boss = ?
     4988                   .
     4989                 Display  scr-boss scr-boss-name with frame Dialog-Frame.
     4990                 apply "CHOOSE" to r-boss in frame Dialog-Frame .
     4991             end.
     4992             if available buf_clients Then DO:
     4993                   scr-boss      = buf_clients.obj-code .
     4994                   scr-boss-name = buf_clients.obj-name .
     4995             End.
     4996    End.
     4997    else do:
     4998         Assign
     4999           scr-boss-name = ""
     5000           scr-boss = ?
     5001           .
     5002     end.
     5003    Display  scr-boss scr-boss-name with frame Dialog-Frame.
     5004    end.
     5005   end procedure.
     5006   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
