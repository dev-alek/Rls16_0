     2099               .
     2100            if buf_price-all.plt-fix-cource-crc-doc = true then
     2101               assign
     2102                 v-exch-rate  = buf_price-all.pdf-exch-rate
     2103                 v-exch-scale = buf_price-all.pdf-exch-scale
     2104               .
     2105               else do:
     2106   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2108     (input  buf_price-all.curr-code
     2109     ,input  to-day
     2110     ,output v-exch-rate0
     2111     ,output v-exch-scale0
     2112     ,output v-curr-abbr
     2113     )  .
     2114               assign
     2115                 v-exch-rate  = v-exch-rate0
     2116                 v-exch-scale = v-exch-scale0
     2117                 .
     2118              end.
     2119              v-date-1 = date ( "" )  .
     2120              if buf_price-all.fact-order-sys-from > 0 then do:
     2121                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     2122                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     2123                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     2124              end.
     2125              v-date-2 =  date ( "" )  .
     2126              if buf_price-all.fact-order-sys-to > 0 then do:
     2127                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     2128                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     2129                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     2130              end.
     2131              if buf_price-all.qnty-from <> ? then do :
     2132                 if not (
     2133                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     2134                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     2135                 ) then do:
     2136                        v-interv = "".
     2137                        next.
     2138                 end.
     2139                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     2140              end.
     2141              if buf_price-all.sum-from <> ? then do :
     2142                 if not (
