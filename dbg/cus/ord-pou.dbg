     2785        X_goods.gds-code   COLUMN-LABEL  'Код товара'  FORMAT ">>>>>>>>9"
     2786        X_ord-line.artic   COLUMN-LABEL  'Артикул'
     2787        X_goods.gds-name   COLUMN-LABEL  'Название'  FORMAT "X(25)"
     2788        X_ord-line.qnty   COLUMN-LABEL  'Количество'  FORMAT ">>,>>>,>>9.<<<"
     2789        X_ord-line.price-rubl   COLUMN-LABEL  'Цена(руб)'  FORMAT ">,>>>,>>9.99"
     2790        X_ord-line.price-base   COLUMN-LABEL  'Цена(вал)'  FORMAT ">,>>>,>>9.99"
     2791        X_ord-line.sum-base   COLUMN-LABEL  'Сумма в вал.'  FORMAT ">>>,>>>,>>9.99"
     2792        X_ord-line.sum-rubl   COLUMN-LABEL  'Сумма в руб.'  FORMAT ">>>,>>>,>>9.99"
     2793        v-fact-qnty  COLUMN-LABEL  'Текущий остаток' FORMAT "->>,>>>,>>9.<<<"
     2794     ENABLE
     2795         X_ord-line.qnty
     2796       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.5 BY 13.42 ROW-HEIGHT-CHARS .6.
     2797   DEFINE FRAME Dialog-Frame
     2798        b-exit AT ROW 1 COL 1
     2799        b-quit AT ROW 1 COL 11
     2800        B-delivery AT ROW 1 COL 76.13
     2801        B-help AT ROW 1 COL 86.13
     2802        b-prev AT ROW 2 COL 1
     2803        b-next AT ROW 2 COL 6
     2804        scr-cli AT ROW 2 COL 21.63 COLON-ALIGNED
     2805        r-cli AT ROW 2 COL 32.25
     2806        B-contract AT ROW 2 COL 93.25
     2807        scr-ship-date AT ROW 3 COL 21.63 COLON-ALIGNED
     2808        scr-wrkr AT ROW 6 COL 7.5 COLON-ALIGNED
     2809        r-wrkr AT ROW 6.04 COL 20.25
     2810        scr-agnt AT ROW 6.96 COL 7.5 COLON-ALIGNED
     2811        r-agnt AT ROW 7.04 COL 20.25
     2812        scr-boss AT ROW 7.96 COL 7.5 COLON-ALIGNED
     2813        r-boss AT ROW 8.04 COL 20.25
     2814        B-add AT ROW 9.17 COL 1
     2815        B-specif AT ROW 9.17 COL 11 WIDGET-ID 6
     2816        B-chg AT ROW 9.17 COL 24
     2817        B-del AT ROW 9.17 COL 34
     2818        BROWSE-2 AT ROW 10.25 COL 1
     2819        scr-cli-name AT ROW 2 COL 33.38 COLON-ALIGNED NO-LABEL
     2820        scr-contract AT ROW 2 COL 72 COLON-ALIGNED NO-LABEL
     2821        scr-obj-name AT ROW 4.17 COL 21.5 COLON-ALIGNED
     2822        scr-wrkr-name AT ROW 6.17 COL 21.63 COLON-ALIGNED NO-LABEL
     2823        scr-agnt-name AT ROW 7.21 COL 21.63 COLON-ALIGNED NO-LABEL
     2824        scr-sum-qnty AT ROW 7.83 COL 80.5 COLON-ALIGNED
     2825        scr-boss-name AT ROW 8.25 COL 21.63 COLON-ALIGNED NO-LABEL
     2826        scr-sum-rubl AT ROW 8.54 COL 80.5 COLON-ALIGNED
     2827        scr-sum-base AT ROW 9.33 COL 80.5 COLON-ALIGNED
     2828        I-deliver AT ROW 1 COL 73 WIDGET-ID 2
     2829        SPACE(20.74) SKIP(21.67)
     2830       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2831            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2832            TITLE "Заказ ПО".
     2833   ASSIGN
     2834          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2835          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2836   ASSIGN
     2837          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2838   ASSIGN
     2839          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2840   ON GO OF FRAME Dialog-Frame
     2841   DO:
     2842   define buffer buf_ord-line for ub.ord-line.
     2843   define variable v-kol as integer init 0 no-undo .
     2844     if p-mode =  'ПРОСМОТР':U then return.
     2845     if p-mode <> 'ПРОСМОТР':U then do:
     2846        assign frame Dialog-Frame
     2847        scr-ship-date
     2848        scr-cli-name
     2849        scr-wrkr
     2850        scr-agnt
     2851        scr-boss
     2852        .
     2853        loc-date-ship = scr-ship-date .
     2854     if can-find
     2855       ( first buf_ord-line  no-lock    where
     2856               buf_ord-line.doc-code = loc-ord-num  and
     2857               buf_ord-line.qnty  =  0 ) then do:
     2858         message "В заказе есть строки с 0 количеством . Удаляем их ? " view-as alert-box question  buttons yes-no update v-log.
     2859          if v-log then do:
     2860               for each buf_ord-line  exclusive-lock
     2861                       where buf_ord-line.qnty = 0      and
     2862                       buf_ord-line.doc-code = loc-ord-num
     2863                       :
     2864                        delete buf_ord-line .
     2865               end.
     2866          end.
     2867      end.
     2868        define variable s-1 as decimal init 0 no-undo .
     2869        define variable s-2 as decimal init 0 no-undo .
     2870        define variable s-3 as decimal init 0 no-undo .
     2871        for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     2872            s-1  = s-1  + buf_ord-line.sum-rubl .
     2873            s-2  = s-2  + buf_ord-line.sum-base .
     2874            s-3  = s-3  + buf_ord-line.qnty .
     2875            v-kol = v-kol + 1 .
     2876        end.
     2877        if v-kol = 0 then do:
     2878           message "В заказе нет строк . Удаляем документ ? " view-as alert-box question
     2879           buttons yes-no title "" update t-log-3 as logical.
     2880           if t-log-3 = true then do:
     2881                 find first buf-po_ord-doc exclusive-lock where recid(buf-po_ord-doc) = p-ord-doc-recid  no-error.
     2882                 if available buf-po_ord-doc then
     2883                 delete buf-po_ord-doc.
     2884                 p-ord-doc-recid = ? .
     2885                 return.
     2886               end.
     2887        end.
     2888     end.
     2889   define variable   v-ok  as logical   no-undo .
     2890   define variable   v-err  as character no-undo .
     2891   v-ok = true .
     2892     run validate-transport-contract in this-procedure (
     2893            input v-cntxt-host-code-obj
     2894           ,input loc-cli-type
     2895           ,input loc-cli-code
     2896           ,input loc-contract
     2897           ,input v-transport-cli-type
     2898           ,input v-transport-cli-code
     2899           ,input v-transport-host-code
     2900           ,input v-transport-contract
     2901           ,input true
     2902           ,output v-ok
     2903           ,output v-err
     2904           ) no-error .
     2905          if v-ok = false then do:
     2906             return no-apply .
     2907          end.
     2908     find current buf_ord-doc exclusive-lock no-error .
     2909     assign
     2910       buf_ord-doc.sum-rubl     = s-1
     2911       buf_ord-doc.sum-base     = s-2
     2912       buf_ord-doc.qnty         = s-3
     2913       buf_ord-doc.ship-date    = scr-ship-date
     2914       buf_ord-doc.wrkr         = scr-wrkr
     2915       buf_ord-doc.boss         = scr-boss
     2916       buf_ord-doc.agnt         = scr-agnt
     2917       buf_ord-doc.status_      = 'новый':U
     2918       buf_ord-doc.cli-code     = loc-cli-code
     2919       buf_ord-doc.cli-type     = loc-cli-type
     2920       buf_ord-doc.cli-name     = scr-cli-name
     2921       buf_ord-doc.contract-code = loc-contract
     2922       buf_ord-doc.deliv-type-code    = v-deliv-type-code
     2923       buf_ord-doc.obj-point-code     = v-point-obj-code
     2924       buf_ord-doc.cli-point-code     = v-point-cli-code
     2925       buf_ord-doc.obj-point-db-num   = v-point-obj-db-num
     2926       buf_ord-doc.cli-point-db-num   = v-point-cli-db-num
     2927       buf_ord-doc.transport-host-code     = v-transport-host-code
     2928       buf_ord-doc.transport-cli-type     = v-transport-cli-type
     2929       buf_ord-doc.transport-cli-code     = v-transport-cli-code
     2930       buf_ord-doc.transport-contract = v-transport-contract
     2931       buf_ord-doc.transport-condition= v-transport-condition
     2932       buf_ord-doc.transport-value    = v-transport-value
     2933       buf_ord-doc.sum-ship           = v-transport-sum
     2934       buf_ord-doc.transport-vat      = v-transport-vat
     2935    .
     2936     if buf_ord-doc.status_ = 'новый':U and buf_ord-doc.flag_ = false then do:
     2937         message "Закрываем заказ до статуса НОВЫЙ+ ? " view-as alert-box question
     2938               buttons yes-no title "" update t-log-4 as logical.
     2939               if t-log-4 = true then do:
     2940                 run cus/ordpocls.p ( parParentProc , recid(buf_ord-doc) , true ) no-error .
     2941                 if error-status :error then return  .
     2942               end.
     2943     end.
     2944   END.
     2945   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2946   DO:
     2947     APPLY "END-ERROR":U TO SELF.
     2948   END.
     2949   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     2950   DO:
     2951     run proc-add.
     2952     run recalc-head.
     2953   END.
     2954   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2955   DO:
     2956    define variable r-stop as logical no-undo .
     2957    define variable r-exit as logical no-undo .
     2958    define variable r-recid as recid no-undo.
     2959    find current x_ord-line  exclusive-lock  no-error .
     2960    if available x_ord-line then do:
     2961        r-recid =  recid ( x_ord-line)  .
     2962        run cus/ord-frmp.w (parParentProc , input ?  , input r-recid  , input 'ИЗМЕНЕНИЕ':U,  output r-stop , output r-exit ) .
     2963        v-log =  BROWSE-2:refresh() .
     2964    end.
     2965       run recalc-head.
     2966   END.
     2967   ON return OF B-chg IN FRAME Dialog-Frame
     2968   DO:
     2969     run next-focus in this-procedure  (input  B-chg:handle ) .
     2970     return no-apply .
     2971   END.
     2972   ON CHOOSE OF B-contract IN FRAME Dialog-Frame
     2973   DO:
     2974   define variable o-host-code as integer   no-undo .
     2975   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2977     (input  loc-obj-type
     2978     ,input  loc-obj-code
     2979     ,output o-host-code
     2980     )  .
     2981   define buffer b_contract for ub.contract.
     2982   find first b_contract no-lock  where b_contract.contract-code     = loc-contract and
     2983                                        b_contract.host-code         = o-host-code
     2984                                        no-error .
     2985   if error-status :error then return no-apply.
     2986   run str/sh-contr.p (
     2987     input parParentProc ,
     2988     input recid (b_contract))
     2989     .
     2990   END.
     2991   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2992   DO:
     2993   define variable v-ii as integer no-undo .
     2994   message "Удалить запись ?"
     2995         view-as alert-box question
     2996         buttons yes-no
     2997         update g-log as logical .
     2998         if g-log = false then return no-apply.
     2999    find current x_ord-line  exclusive-lock  no-error .
     3000    if available x_ord-line then do:
     3001       run x-delete ( recid(x_ord-line) , input-output v-ii ) no-error .
     3002       if error-status :error then
     3003       message vss-workfile vss-revision vss-description skip
     3004              "Ошибка удаление 1 " skip
     3005               skip
     3006               error-status :get-message(1) skip
     3007               return-value skip
     3008               view-as alert-box error
     3009       .
     3010       Run OpenBr.
     3011    end.
     3012       run recalc-head.
     3013   END.
     3014   ON CHOOSE OF B-delivery IN FRAME Dialog-Frame
     3015   DO:
     3016      run cus/pardeliv.w
     3017        (input parParentproc
     3018         ,input        p-mode
     3019         ,input        "ord" + 'ПО':U
     3020         ,input        loc-obj-type
     3021         ,input        loc-obj-code
     3022         ,input        loc-cli-type
     3023         ,input        loc-cli-code
     3024         ,input-output v-deliv-type-code
     3025         ,input-output v-point-obj-code
     3026         ,input-output v-point-obj-db-num
     3027         ,input-output v-point-cli-code
     3028         ,input-output v-point-cli-db-num
     3029         ,input-output v-transport-host-code
     3030         ,input-output v-transport-cli-type
     3031         ,input-output v-transport-cli-code
     3032         ,input-output v-transport-contract
     3033         ,input-output v-transport-condition
     3034         ,input-output v-transport-value
     3035         ,input-output v-transport-sum
     3036         ,input-output v-transport-vat
     3037            ) no-error  .
     3038            if error-status :error then message
     3039              vss-workfile vss-revision vss-description skip
     3040              error-status :get-message(1) skip
     3041              return-value skip
     3042              "Ошибка"
     3043              view-as alert-box error
     3044            .
     3045          hide i-deliver in frame Dialog-Frame .
     3046          i-deliver:tooltip = "" .
     3047   END.
     3048   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3049   DO:
     3050       next-prev = ?.
     3051   END.
     3052   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     3053   DO:
     3054   run step-next.
     3055   END.
     3056   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     3057   DO:
     3058      run step-prev.
     3059   END.
     3060   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     3061   DO:
     3062       next-prev = ?.
     3063       message "Выходим без сохранения изменений ?" view-as alert-box question
     3064               buttons yes-no
     3065               update ll as log
     3066               .
     3067       if ll = no then return no-apply.
     3068       else do:
     3069         if p-mode  = 'ДОБАВЛЕНИЕ':U then do:
     3070           find first buf-po_ord-doc exclusive-lock where recid(buf-po_ord-doc) = p-ord-doc-recid  no-error.
     3071           if available buf-po_ord-doc then
     3072           delete buf-po_ord-doc.
     3073         end.
     3074        end.
     3075   END.
     3076   ON CHOOSE OF B-specif IN FRAME Dialog-Frame
     3077   DO:
     3078     run add-spec-contract.
     3079     run recalc-head.
     3080   END.
     3081   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
     3082   DO:
     3083     define buffer buf_gds-obj for ub.gds-obj  .
     3084       find first buf_gds-obj no-lock where
     3085                buf_gds-obj.artic     = x_ord-line.artic     and
     3086                buf_gds-obj.prod-type = x_ord-line.prod-type and
     3087                buf_gds-obj.prod-code = x_ord-line.prod-code and
     3088                buf_gds-obj.obj-type  = buf_ord-doc.obj-type   and
     3089                buf_gds-obj.obj-code  = buf_ord-doc.obj-code   no-error .
     3090      if available buf_gds-obj then
     3091              v-fact-qnty = buf_gds-obj.fact-qnty.
     3092         else v-fact-qnty = 0 .
     3093   END.
     3094   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
     3095   DO:
     3096    define variable rid-list    as  char no-undo .
     3097    define variable old-types as character no-undo .
     3098       run ref/cli-all.w
     3099           (input parparentproc,
     3100            input "b-sel",
     3101            'орг':U,
     3102            ?,
     3103            ?,
     3104            ?,
     3105            ?,
     3106            ?,
     3107            output  rid-list).
     3108       assign
     3109         v-recid-RC = integer(rid-list)
     3110         .
     3111       find first cli#clients no-lock where recid(cli#clients) = v-recid-rc  no-error.
     3112       if available cli#clients then
     3113           assign
     3114               scr-cli      = cli#clients.obj-code
     3115               loc-cli-code = cli#clients.obj-code
     3116               loc-cli-type = cli#clients.obj-type
     3117               scr-cli-name = cli#clients.obj-name
     3118               .
     3119           else
     3120             assign
     3121                 scr-cli-name = ""
     3122                 scr-cli      = ?
     3123                 loc-cli-code = ?
     3124                 loc-cli-type = ""
     3125                 .
     3126   display scr-cli scr-cli-name with frame Dialog-Frame .
     3127   define variable o-host-code as integer   no-undo .
     3128   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3130     (input  loc-obj-type
     3131     ,input  loc-obj-code
     3132     ,output o-host-code
     3133     )  .
     3134       run check-contract-code in this-procedure
     3135        (input  "choose":u,
     3136         input  o-host-code,
     3137         input  loc-cli-type,
     3138         input  loc-cli-code,
     3139         input  ?,
     3140         input  parparentproc,
     3141         input  doc-date,
     3142         input  'рас':U ,
     3143         output loc-contract)
     3144         no-error.
     3145     scr-contract = "".
     3146     if loc-contract <> 0 then do:
     3147        scr-contract = "Вн.№ дог. " + string(loc-contract).
     3148        define buffer buf_contract for ub.contract  .
     3149        find first buf_contract no-lock where
     3150                   buf_contract.contract-code = loc-contract and
     3151                   buf_contract.host-code     =  o-host-code
     3152                  .
     3153        assign
     3154           v-transport-cli-code     =  buf_contract.transport-cli-code
     3155           v-transport-cli-type     =  buf_contract.transport-cli-type
     3156           v-transport-host-code    =  buf_contract.transport-host
     3157           v-transport-contract     =  buf_contract.transport-contract
     3158           v-transport-condition    =  buf_contract.transport-uslov
     3159           v-transport-value        =  buf_contract.transport-value
     3160           .
     3161           i-deliver:tooltip = "Транспортные настроики взяты из договора" .
     3162           display I-deliver with frame Dialog-Frame .
     3163     define variable v-ok as logical   no-undo .
     3164     define variable v-err as character no-undo .
     3165     run validate-transport-contract in this-procedure (
     3166            input v-cntxt-host-code-obj
     3167           ,input loc-cli-type
     3168           ,input loc-cli-code
     3169           ,input loc-contract
     3170           ,input v-transport-cli-type
     3171           ,input v-transport-cli-code
     3172           ,input v-transport-host-code
     3173           ,input v-transport-contract
     3174           ,input false
     3175           ,output v-ok
     3176           ,output v-err
     3177           ) no-error .
     3178          if v-ok = false then do:
     3179           i-deliver:tooltip = "ОШИБКА " + v-err .
     3180           i-deliver:LOAD-IMAGE("cmp/redx.bmp") .
     3181           display I-deliver with frame Dialog-Frame .
     3182          end.
     3183     end.
     3184     display scr-contract with frame Dialog-Frame .
     3185   END.
     3186   ON return OF scr-agnt IN FRAME Dialog-Frame
     3187   DO:
     3188       run next-focus in this-procedure  (input  scr-agnt:handle ) .
     3189     return no-apply .
     3190   END.
     3191   ON return OF scr-agnt-name IN FRAME Dialog-Frame
     3192   DO:
     3193       run next-focus in this-procedure  (input  scr-agnt-name:handle ) .
     3194     return no-apply .
     3195   END.
     3196   ON return OF scr-boss IN FRAME Dialog-Frame
     3197   DO:
     3198       run next-focus in this-procedure  (input  scr-boss:handle ) .
     3199     return no-apply .
     3200   END.
     3201   ON return OF scr-boss-name IN FRAME Dialog-Frame
     3202   DO:
     3203       run next-focus in this-procedure  (input  scr-boss-name:handle ) .
     3204     return no-apply .
     3205   END.
     3206   ON return OF scr-cli IN FRAME Dialog-Frame
     3207   DO:
     3208       run next-focus in this-procedure  (input  scr-cli:handle ) .
     3209     return no-apply .
     3210   END.
     3211   ON return OF scr-ship-date IN FRAME Dialog-Frame
     3212   DO:
     3213     run next-focus in this-procedure  (input  scr-ship-date:handle ) .
     3214     return no-apply .
     3215   END.
     3216   ON return OF scr-wrkr IN FRAME Dialog-Frame
     3217   DO:
     3218       run next-focus in this-procedure  (input  scr-wrkr:handle ) .
     3219     return no-apply .
     3220   END.
     3221   ON return OF scr-wrkr-name IN FRAME Dialog-Frame
     3222   DO:
     3223       run next-focus in this-procedure  (input  scr-wrkr-name:handle ) .
     3224     return no-apply .
     3225   END.
     3226   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3227   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3228   assign
     3229     scr-sum-rubl :label = "Итого сумма (руб)"
     3230   .
     3231     hide I-deliver in frame Dialog-Frame  .
     3232     i-deliver:tooltip = "" .
     3233   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3234   do:
     3235     BROWSE-2 :SET-REPOSITIONED-ROW(8, "CONDITIONAL") .
     3236   end.
     3237   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3238   on ' ' of scr-ship-date in frame Dialog-Frame
     3239   do:
     3240     if (can-query (self, "sensitive")
     3241        and
     3242        self :sensitive = true
     3243        )
     3244     or (can-query (self, "read-only")
     3245        and
     3246        self :read-only = false
     3247        )
     3248     then do:
     3249       assign
     3250         self :screen-value = ?
     3251       .
     3252     end.
     3253     return no-apply.
     3254   end.
     3255   on delete-character of scr-ship-date in frame Dialog-Frame
     3256   do:
     3257     if (can-query (self, "sensitive")
     3258        and
     3259        self :sensitive = true
     3260        )
     3261     or (can-query (self, "read-only")
     3262        and
     3263        self :read-only = false
     3264        )
     3265     then do:
     3266       assign
     3267         self :screen-value = ?
     3268       .
     3269     end.
     3270     return no-apply.
     3271   end.
     3272   on ctrl-d of scr-ship-date in frame Dialog-Frame
     3273   do:
     3274     define variable v-curr-sv-date as date no-undo .
     3275     if (can-query (self, "sensitive")
     3276        and
     3277        self :sensitive = true
     3278        )
     3279     or (can-query (self, "read-only")
     3280        and
     3281        self :read-only = false
     3282        )
     3283     then do:
     3284       if self :handle <> focus :handle
     3285       then do:
     3286         apply "entry":u to self .
     3287       end.
     3288       run gbl/getcurdt.p
     3289         (output v-curr-sv-date
     3290         ) .
     3291       assign
     3292         self :screen-value = string(v-curr-sv-date) .
     3293       .
     3294     end.
     3295     return no-apply.
     3296   end.
     3297   on ctrl-b of scr-ship-date in frame Dialog-Frame
     3298   do:
     3299     if (can-query (self, "sensitive")
     3300        and
     3301        self :sensitive = true
     3302        )
     3303     or (can-query (self, "read-only")
     3304        and
     3305        self :read-only = false
     3306        )
     3307     then do:
     3308       if self :handle <> focus :handle
     3309       then do:
     3310         apply "entry":u to self .
     3311       end.
     3312       define variable v-curr-sv-date as date no-undo .
     3313       define variable v-new-sv-date  as date no-undo .
     3314       assign
     3315         v-curr-sv-date = date(self :screen-value) no-error
     3316       .
     3317       if v-curr-sv-date = ?
     3318       then do:
     3319         run gbl/getcurdt.p
     3320           (output v-curr-sv-date
     3321           ) .
     3322       end.
     3323       if v-curr-sv-date <> ?
     3324       then do:
     3325         assign
     3326           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3327         .
     3328         assign
     3329           self :screen-value = string(v-new-sv-date) .
     3330         .
     3331       end.
     3332     end.
     3333     return no-apply .
     3334   end.
     3335   on ctrl-e of scr-ship-date in frame Dialog-Frame
     3336   do:
     3337     if (can-query (self, "sensitive")
     3338        and
     3339        self :sensitive = true
     3340        )
     3341     or (can-query (self, "read-only")
     3342        and
     3343        self :read-only = false
     3344        )
     3345     then do:
     3346       if self :handle <> focus :handle
     3347       then do:
     3348         apply "entry":u to self .
     3349       end.
     3350       define variable v-curr-sv-date as date no-undo .
     3351       define variable v-new-sv-date  as date no-undo .
     3352       assign
     3353         v-curr-sv-date = date(self :screen-value) no-error
     3354       .
     3355       if v-curr-sv-date = ?
     3356       then do:
     3357         run gbl/getcurdt.p
     3358           (output v-curr-sv-date
     3359           ) .
     3360       end.
     3361       if v-curr-sv-date <> ?
     3362       then do:
     3363         run gbl/lastdate.p
     3364           (input  v-curr-sv-date
     3365           ,output v-new-sv-date
     3366           ).
     3367         assign
     3368           self :screen-value = string(v-new-sv-date) .
     3369         .
     3370       end.
     3371     end.
     3372     return no-apply .
     3373   end.
     3374   on ctrl-f of scr-ship-date in frame Dialog-Frame
     3375   do:
     3376     if (can-query (self, "sensitive")
     3377        and
     3378        self :sensitive = true
     3379        )
     3380     or (can-query (self, "read-only")
     3381        and
     3382        self :read-only = false
     3383        )
     3384     then do:
     3385       if self :handle <> focus :handle
     3386       then do:
     3387         apply "entry":u to self .
     3388       end.
     3389       define variable v-ok            as logical   no-undo .
     3390       define variable v-curr-sv-date  as date      no-undo .
     3391       define variable v-description   as character no-undo .
     3392       assign
     3393         v-curr-sv-date = date(self :screen-value) no-error
     3394       .
     3395       if v-curr-sv-date = ?
     3396       then do:
     3397         run gbl/getcurdt.p
     3398           (output v-curr-sv-date
     3399           ) .
     3400       end.
     3401       if v-curr-sv-date <> ?
     3402       then do:
     3403         run gbl/d-inpday.w
     3404           (input ?
     3405           ,input "Выбор даты"
     3406           ,input v-description
     3407           ,input ""
     3408           ,input-output v-curr-sv-date
     3409           ,output v-ok
     3410           ).
     3411         if v-ok = true
     3412         then do:
     3413           assign
     3414             self :screen-value = string(v-curr-sv-date) .
     3415           .
     3416         end.
     3417       end.
     3418     end.
     3419     return no-apply .
     3420   end.
     3421     define MENU m-ed-date31
     3422       MENU-ITEM m-ed-date31-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3423       MENU-ITEM m-ed-date31-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3424       MENU-ITEM m-ed-date31-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3425       MENU-ITEM m-ed-date31-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
