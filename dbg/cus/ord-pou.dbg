        1   DEFINE BUFFER X_goods FOR ub.goods.
        2   DEFINE NEW SHARED BUFFER X_ord-line FOR ub.ord-line.
        3   define input parameter parParentProc  as widget-handle no-undo.
        4   define input-output parameter p-ord-doc-recid as recid no-undo .
        5   define input parameter p-mode as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Корректировка заказов ПО".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure cur-time :
      119      define output parameter p-today as date      no-undo .
      120      define output parameter p-time  as integer   no-undo .
      121     do
      122     on error undo, return error
      123     :
      124       define variable v-date1 as date      no-undo .
      125       define variable v-date2 as date      no-undo .
      126       define variable v-time  as integer   no-undo .
      127       assign
      128         v-date1 = today
      129         v-time  = time
      130         v-date2 = today
      131       .
      132       if v-date1 <> v-date2
      133       then do:
      134         assign
      135           v-date1 = today
      136           v-time  = v-time
      137         .
      138       end.
      139       assign
      140         p-today = v-date1
      141         p-time  = v-time
      142       .
      143     end.
      144   end.
      145   function cur-time-date returns character
      146   :
      147     return string(today, '99/99/9999':U) .
      148   end.
      149   function cur-time-mjd returns decimal
      150   :
      151     define variable v-date as date      no-undo .
      152     define variable v-time as integer   no-undo .
      153     run cur-time in this-procedure
      154       (output v-date
      155       ,output v-time
      156       ) .
      157     return integer(v-date) - 2400002 + (v-time / 86400) .
      158   end.
      159   function cur-time-get-ending-index returns integer
      160   (input p-number as integer
      161   )
      162   :
      163     if p-number < 0
      164     or p-number = ?
      165     then do:
      166       return 1 .
      167     end.
      168     define variable v-rest as integer   no-undo .
      169     assign
      170       p-number = p-number modulo 100
      171     .
      172     if p-number < 20
      173     then do:
      174       assign
      175         v-rest = p-number
      176       .
      177     end.
      178     else do:
      179       assign
      180         v-rest = p-number modulo 10
      181       .
      182     end.
      183     case v-rest :
      184       when 1
      185       then do:
      186         return 2 .
      187       end.
      188       when 2 or
      189       when 3 or
      190       when 4
      191       then do:
      192         return 3 .
      193       end.
      194       otherwise do:
      195         return 1 .
      196       end.
      197     end case .
      198   end.
      199   procedure cur-time-mjd-to-date :
      200      define input  parameter i-mjd-diff as decimal no-undo.
      201      define output parameter o-Date     as date    no-undo.
      202      define output parameter o-Time     as integer no-undo.
      203      define variable v-day-number as integer   no-undo .
      204      if    i-mjd-diff < 0
      205         or i-mjd-diff = ?
      206      then do:
      207         return "?" .
      208      end.
      209      assign
      210         v-day-number = truncate(i-mjd-diff,0).
      211         o-Date = date(v-day-number + 2400002).
      212         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      213     .
      214   end.
      215   function cur-time-mjd-to-string returns character
      216   (input p-mjd-diff as decimal
      217   )
      218   :
      219     define variable v-day-number as integer   no-undo .
      220     define variable v-seconds    as integer   no-undo .
      221     define variable v-hour       as integer   no-undo .
      222     define variable v-min        as integer   no-undo .
      223     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      224     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      225     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      226     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      227     if p-mjd-diff < 0
      228     or p-mjd-diff = ?
      229     then do:
      230       return "?" .
      231     end.
      232     assign
      233       v-day-number = integer(truncate(p-mjd-diff,0))
      234       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      235     .
      236     if v-seconds > 86400
      237     then do:
      238       assign
      239         v-seconds = 86400 - 1
      240       .
      241     end.
      242     if v-seconds < 0
      243     then do:
      244       assign
      245         v-seconds = 0
      246       .
      247     end.
      248     assign
      249       v-hour = truncate(v-seconds / 3600, 0)
      250     .
      251     assign
      252       v-seconds = v-seconds modulo 3600
      253     .
      254     assign
      255       v-min = truncate(v-seconds / 60, 0)
      256     .
      257     assign
      258       v-seconds = v-seconds modulo 60
      259     .
      260     return
      261         (if v-day-number <> 0
      262           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      263           else ""
      264         )
      265       + (if v-day-number <> 0 or v-hour <> 0
      266           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      270           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      271           else ""
      272         )
      273       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      274       .
      275   end.
      276   function cur-time-string returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-string-sec returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      295   end.
      296   function cur-time-custom  returns character
      297   (input p-prefix as character
      298   ,input p-date-format as character
      299   ,input p-delimiter as character
      300   ,input p-time-format as character
      301   ,input p-suffix as character
      302   )
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return
      311       p-prefix
      312       + string(v-date, p-date-format)
      313       + p-delimiter
      314       + string(v-time, p-time-format)
      315       + p-suffix
      316       .
      317   end.
      318   function cur-time-print  returns character
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      327   end.
      328   function cur-time-datetime returns datetime
      329   :
      330     define variable v-char as character no-undo .
      331     define variable v-datetime as datetime no-undo .
      332     v-char = cur-time-string().
      333     v-datetime = datetime(v-char).
      334     return  v-datetime.
      335   end.
      336   function cur-time-string-msec returns character
      337   :
      338     define variable v-date as datetime  no-undo .
      339     v-date = now.
      340     return string(v-date) .
      341   end.
