     2145                 ) then do:
     2146                    v-interv = "".
     2147                    next.
     2148                 end.
     2149                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     2150              end.
     2151              if buf_price-all.turnover-from <> ? then do :
     2152                 if not (
