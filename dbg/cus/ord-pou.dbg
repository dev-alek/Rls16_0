     2243               p-plt-db-num       = tt_price-all.plt-db-num
     2244               p-pdf-id           = tt_price-all.pdf-id
     2245               p-pdf-db-num       = tt_price-all.pdf-db
     2246               p-sale-price-base  = neos_price-all.price-sale-base
     2247               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     2248               p-road-tax-base    = neos_price-all.road-tax-base
     2249               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     2250               p-excise-base      = neos_price-all.excise-base
     2251               p-excise-rubl      = neos_price-all.excise-rubl
     2252               .
     2253            end.
     2254            else do:
     2255                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2256                 if error-status :error    then do:
     2257                   message "Не найден бар-код" p-b-code view-as alert-box error .
     2258                   return error return-value .
     2259                 end.
     2260             assign
     2261               p-plt-id           = tt_price-all.plt-id
     2262               p-plt-db-num       = tt_price-all.plt-db-num
     2263               p-pdf-id           = tt_price-all.pdf-id
     2264               p-pdf-db-num       = tt_price-all.pdf-db
     2265               p-sale-price-base  = tt_price-all.price-sale-base
     2266               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2267               p-road-tax-base    = tt_price-all.road-tax-base
     2268               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2269               p-excise-base      = tt_price-all.excise-base
