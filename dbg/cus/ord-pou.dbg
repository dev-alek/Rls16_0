     2275   end.
     2276   end procedure.
     2277   procedure mpl-tpl-auto :
     2278   define input  parameter p-b-code     as integer   no-undo .
     2279   define input  parameter p-obj-type   as character no-undo .
     2280   define input  parameter p-obj-code   as integer   no-undo .
     2281   define input  parameter p-plt-id     as integer   no-undo .
     2282   define input  parameter p-plt-db-num as integer   no-undo .
     2283   define input  parameter p-fact-order as decimal   no-undo .
     2284   define output parameter p-sale-price as decimal   no-undo .
     2285   define output parameter p-pdf-id     as integer   no-undo .
     2286   define output parameter p-pdf-db-num as integer   no-undo .
     2287     do
     2288     on error undo, return error return-value
     2289     :
     2290   if p-fact-order = ? then do:
     2291     run fact-order-mpl (
     2292         input   today       ,
     2293         input   p-obj-type  ,
     2294         input   p-obj-code  ,
     2295         output  p-fact-order ) .
     2296   end.
     2297   assign
     2298     p-pdf-id      = ?
     2299     p-pdf-db-num  = ?
     2300     p-sale-price  = ?
     2301   .
     2302   define buffer buf_bar-code for ub.bar-code  .
     2303   define buffer buf_goods for ub.goods  .
     2304   find first buf_bar-code no-lock where
     2305              buf_bar-code.b-code = p-b-code
     2306              no-error .
     2307   if error-status :error then return error return-value .
     2308   find first buf_goods no-lock where
     2309              buf_goods.gds-code = buf_bar-code.gds-code
     2310              no-error .
     2311   if error-status :error then return error return-value .
     2312   define variable v-main-b-code as integer   no-undo .
     2313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2314     (input  buf_goods.gds-code
     2315     ,input  ?
     2316     ,output v-main-b-code
     2317     )  .
     2318   define buffer buf_price-all for ub.price-all  .
     2319   for each tt_price-all : delete tt_price-all. end.
     2320       for each buf_price-all no-lock where
     2321               buf_price-all.plt-id     = p-plt-id                 and
     2322               buf_price-all.plt-db-num = p-plt-db-num             and
     2323               buf_price-all.obj-type   = p-obj-type               and
     2324               buf_price-all.obj-code   = p-obj-code               and
     2325               buf_price-all.gds-code   = buf_goods.gds-code       and
     2326             ( buf_price-all.b-code = v-main-b-code or
     2327               buf_price-all.b-code = p-b-code)    and
     2328               buf_price-all.status_    = 'акт':U         and
     2329               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2330             ( buf_price-all.fact-order-sys-to = ? or
     2331               buf_price-all.fact-order-sys-to >=  p-fact-order)
     2332               :
     2333                 create tt_price-all .
     2334                 buffer-copy buf_price-all to tt_price-all
     2335                 assign
     2336                   tt_price-all.price-sale  = buf_price-all.price-sale
     2337                 .
     2338       end.
     2339   define variable vt-plt-id as integer   no-undo .
     2340   define variable vt-plt-db as integer   no-undo .
     2341   define variable vt-pdf-id as integer   no-undo .
     2342   define variable vt-pdf-db as integer   no-undo .
     2343   define buffer neos_price-all for tt_price-all  .
     2344   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     2345       if available tt_price-all then do:
     2346        assign
     2347          vt-plt-id = tt_price-all.plt-id
     2348          vt-plt-db = tt_price-all.plt-db-num
     2349          vt-pdf-id = tt_price-all.pdf-id
     2350          vt-pdf-db = tt_price-all.pdf-db
     2351        .
     2352        if tt_price-all.b-code = p-b-code then do:
     2353             assign
     2354               p-plt-id           = tt_price-all.plt-id
     2355               p-plt-db-num       = tt_price-all.plt-db-num
     2356               p-pdf-id           = tt_price-all.pdf-id
     2357               p-pdf-db-num       = tt_price-all.pdf-db
     2358               p-sale-price       = tt_price-all.price-sale
     2359               .
     2360        end.
     2361        else do:
     2362          find first neos_price-all where
     2363                     neos_price-all.b-code     = p-b-code  and
     2364                     neos_price-all.plt-id     = vt-plt-id and
     2365                     neos_price-all.plt-db-num = vt-plt-db and
     2366                     neos_price-all.pdf-id     = vt-pdf-id and
     2367                     neos_price-all.pdf-db     = vt-pdf-db
     2368                     use-index pi no-error .
     2369            if available neos_price-all then do:
     2370             assign
     2371               p-plt-id           = tt_price-all.plt-id
     2372               p-plt-db-num       = tt_price-all.plt-db-num
     2373               p-pdf-id           = tt_price-all.pdf-id
     2374               p-pdf-db-num       = tt_price-all.pdf-db
     2375               p-sale-price       = neos_price-all.price-sale
     2376               .
     2377            end.
     2378            else do:
     2379           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2380           if error-status :error    then do:
     2381              message "Не найден бар-код" p-b-code view-as alert-box error .
     2382              return error return-value .
     2383           end.
     2384             assign
     2385               p-plt-id           = tt_price-all.plt-id
     2386               p-plt-db-num       = tt_price-all.plt-db-num
     2387               p-pdf-id           = tt_price-all.pdf-id
     2388               p-pdf-db-num       = tt_price-all.pdf-db
     2389               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     2390               .
     2391            end.
     2392        end.
     2393     end.
     2394     end.
     2395   end procedure.
     2396   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397   procedure validate-transport-contract :
     2398   define input  parameter p-host-code             as integer   no-undo .
     2399   define input  parameter p-cli-type              as character no-undo .
     2400   define input  parameter p-cli-code              as integer   no-undo .
     2401   define input  parameter p-contract-code         as integer   no-undo .
     2402   define input  parameter p-transport-cli-type    as character no-undo .
     2403   define input  parameter p-transport-cli-code    as integer   no-undo .
     2404   define input  parameter p-transport-host-code   as integer   no-undo .
     2405   define input  parameter p-transport-contract    as integer   no-undo .
     2406   define input  parameter p-mess                  as logical   no-undo .
     2407   define output parameter p-ok                    as logical   no-undo .
     2408   define output parameter p-err                   as character no-undo .
     2409     do
     2410     on error undo, return error return-value
     2411     :
     2412   define buffer buf_main_contract for ub.contract  .
     2413   define buffer buf_main_clients  for ub.clients  .
     2414   define buffer buf_transport_contract for ub.contract  .
     2415   define buffer buf_transport_clients  for ub.clients  .
     2416   p-err = "" .
     2417   p-ok = true .
     2418       if p-contract-code <> 0 then do:
     2419           if not ( p-cli-type = 'орг':U or p-cli-type = 'чел':U ) then do:
     2420             p-err = substitute("Конрагент договора может быть &1 или &2" , 'орг':U , 'чел':U) .
     2421             p-ok = false  .
     2422             if p-mess then message p-err  view-as alert-box error.
     2423             return  p-err .
     2424           end.
     2425           find first buf_main_clients no-lock where
     2426                     buf_main_clients.obj-type = p-cli-type and
     2427                     buf_main_clients.obj-code = p-cli-code no-error .
     2428         if not available buf_main_clients then do:
     2429             p-err = substitute("Не верно задан Конрагент  тип &1   код &2" ,  p-cli-type , p-cli-code) .
     2430             p-ok = false  .
     2431             if p-mess then message p-err  view-as alert-box error.
     2432             return  p-err .
     2433         end.
     2434         find first buf_main_contract no-lock where
     2435                     buf_main_contract.host-code = p-host-code and
     2436                     buf_main_contract.contract-code = p-contract-code no-error .
     2437         if not available buf_main_contract then do:
     2438             p-err = substitute("Не найден договор фирма &1  вн.код &2" ,  p-host-code , p-contract-code) .
     2439             p-ok = false  .
     2440             if p-mess then message p-err  view-as alert-box error.
     2441             return  p-err .
     2442         end.
     2443         if not ( buf_main_contract.cli-type = p-cli-type and
     2444                   buf_main_contract.cli-code = p-cli-code) then do:
     2445             p-ok = false  .
     2446             p-err = substitute("Договор принадлежит контрагенту &1 &2 , а не &3 &4 " ,
     2447                                 buf_main_contract.cli-type ,
     2448                                 buf_main_contract.cli-code ,
     2449                                 p-cli-type,
     2450                                 p-cli-code ) .
     2451             if p-mess then message p-err  view-as alert-box error.
     2452             return  p-err .
     2453         end.
     2454       end.
     2455       if p-transport-cli-code <> 0 then do:
     2456           if not ( p-transport-cli-type = 'орг':U or p-transport-cli-type = 'чел':U ) then do:
     2457             p-ok = false  .
     2458             p-err = substitute("Конрагент договора может быть &1 или &2" , 'орг':U , 'чел':U) .
     2459             if p-mess then message p-err  view-as alert-box error.
     2460             return  p-err .
     2461           end.
     2462           find first buf_transport_clients no-lock where
     2463                     buf_transport_clients.obj-type = p-transport-cli-type and
     2464                     buf_transport_clients.obj-code = p-transport-cli-code no-error .
     2465         if not available buf_transport_clients then do:
     2466             p-ok = false  .
     2467             p-err = substitute("Не верно задан тр.Конрагент  тип &1   код &2" ,  p-transport-cli-type , p-transport-cli-code) .
     2468             if p-mess then message p-err  view-as alert-box error.
     2469             return  p-err .
     2470         end.
     2471         find first buf_transport_contract no-lock where
     2472                     buf_transport_contract.host-code     = p-transport-host-code and
     2473                     buf_transport_contract.contract-code = p-transport-contract no-error .
     2474         if not available buf_transport_contract then do:
     2475             p-ok = false  .
     2476             p-err = substitute("Не найден транспортный договор фирма &1  вн.код &2" ,  p-transport-host-code , p-transport-contract) .
     2477             if p-mess then message p-err  view-as alert-box error.
     2478             return  p-err .
     2479         end.
     2480         if not ( buf_transport_contract.cli-type = p-transport-cli-type and
     2481                   buf_transport_contract.cli-code = p-transport-cli-code) then do:
     2482             p-ok = false  .
     2483             p-err = substitute("Договор принадлежит контрагенту &1 &2 , а не &3 &4 " ,
     2484                                 buf_transport_contract.cli-type ,
     2485                                 buf_transport_contract.cli-code ,
     2486                                 p-transport-cli-type,
     2487                                 p-transport-cli-code ) .
     2488             if p-mess then message p-err  view-as alert-box error.
     2489             return  p-err .
     2490         end.
     2491       end.
     2492     end.
     2493   end procedure.
     2494   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2495   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2496   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2497   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2498   ASSIGN
     2499      v-S_CONTRACT                = "Contract":U
     2500      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2501      v-DELIM_CHR_3               = ","
     2502      .
     2503   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2504   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2505   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2506   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2507      INPUT iHost-Code    AS INTEGER,
     2508      INPUT iContract-Num AS INTEGER,
     2509      INPUT iGds-Code     AS INTEGER ):
     2510      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2511      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2512      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2513      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2514      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2515      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2516          INPUT  iHost-Code,
     2517          INPUT  iContract-Num,
     2518          OUTPUT iTmp-Extent3
     2519          ).
     2520      IF iTmp-Extent3[1] = 2 THEN DO:
     2521         ASSIGN
     2522            iTmp-Host-Code      = iTmp-Extent3[2]
     2523            iTmp-Contract-Num   = iTmp-Extent3[3]
     2524            .
     2525      END. ELSE DO:
     2526         ASSIGN
     2527            iTmp-Host-Code      = iHost-Code
     2528            iTmp-Contract-Num   = iContract-Num
     2529            .
     2530      END.
     2531      IF iGds-Code = ? THEN DO:
     2532         ASSIGN
     2533            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2534                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2535                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2536                           ).
     2537      END. ELSE DO:
     2538            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2539                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2540                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2541                              AND buf_Spec.Gds-Code      = iGds-Code
     2542                            ).
     2543      END.
     2544      RETURN (lRet).
     2545   END FUNCTION.
     2546   PROCEDURE MS-Contract-EXTENT-3:
     2547      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2548      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2549      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2550      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2551      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2552      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2553      FIND FIRST buf_Cont-2 WHERE
     2554                 buf_Cont-2.Host-Code      = i-Host-Code
     2555             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2556           NO-LOCK NO-ERROR.
     2557      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2558         RETURN.
     2559      END.
     2560      FOR FIRST buf_Ext-Classif WHERE
     2561                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2562           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2563                                               STRING(i-Contract-code)
     2564           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2565          NO-LOCK,
     2566          EACH buf_Cont WHERE
     2567               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2568           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2569          NO-LOCK:
     2570          ASSIGN
     2571             i-Ret[1] = 1
     2572             i-Ret[2] = buf_Cont.Host-code
     2573             i-Ret[3] = buf_Cont.Contract-code
     2574             .
     2575          LEAVE.
     2576      END.
     2577      IF i-Ret[1] <> 1 THEN DO:
     2578         FOR FIRST buf_Ext-Classif WHERE
     2579                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2580              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2581                                                  STRING(i-Contract-code)
     2582              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2583             NO-LOCK,
     2584             EACH buf_Cont WHERE
     2585                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2586              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2587             NO-LOCK:
     2588             ASSIGN
     2589                i-Ret[1] = 2
     2590                i-Ret[2] = buf_Cont.Host-code
     2591                i-Ret[3] = buf_Cont.Contract-code
     2592                .
     2593             LEAVE.
     2594         END.
     2595      END.
     2596      RETURN.
     2597   END PROCEDURE.
