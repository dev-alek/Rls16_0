     2170                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     2171                   v-pay-name = "" .
     2172                   next.
     2173                 end.
     2174                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     2175              end.
     2176             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     2177             create tt_price-all .
     2178             buffer-copy buf_price-all to tt_price-all
     2179             assign
     2180               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     2181               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     2182               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     2183               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     2184               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     2185               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     2186               tt_price-all.price-sale     = buf_price-all.price-sale
     2187               tt_price-all.road-tax       = buf_price-all.road-tax
     2188               tt_price-all.excise         = buf_price-all.excise
     2189               tt_price-all.pdf-exch-rate   = v-exch-rate
     2190               tt_price-all.pdf-exch-scale  = v-exch-scale
     2191               tt_price-all.pdf-base-rate   = v-base-rate
     2192               tt_price-all.pdf-base-scale  = v-base-scale
     2193               tt_price-all.grp-name        = v-grp-name
