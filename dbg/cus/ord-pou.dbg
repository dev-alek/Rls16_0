     2195               tt_price-all.shift-1         = buf_price-all.start-shift-num
     2196               tt_price-all.time-1          = buf_price-all.start-sys-time
     2197               tt_price-all.date-2          = v-date-2
     2198               tt_price-all.shift-2         = buf_price-all.end-shift-num
     2199               tt_price-all.time-2          = buf_price-all.end-sys-time
     2200               tt_price-all.interv-name     = v-interv
     2201               tt_price-all.pay-name        = v-pay-name
     2202               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     2203             .
     2204   end.
     2205   define variable vt-plt-id as integer   no-undo .
     2206   define variable vt-plt-db as integer   no-undo .
     2207   define variable vt-pdf-id as integer   no-undo .
     2208   define variable vt-pdf-db as integer   no-undo .
     2209   define buffer neos_price-all for tt_price-all  .
     2210   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     2211       if available tt_price-all then do:
