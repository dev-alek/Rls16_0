     5168   MAIN-BLOCK:
     5169   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5170      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5171     if p-mode <> 'ПРОСМОТР':U then do:
     5172       if p-mode  = 'ДОБАВЛЕНИЕ':U then do:
     5173         define variable v-i-doc as character no-undo .
     5174   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5175   run proc-ord-code in this-procedure
     5176    (input   'main' ,
     5177     input   v-cntxt-db-num ,
     5178     input   v-cntxt-obj-type ,
     5179     input   v-cntxt-obj-code ,
     5180     input   v-i-doc ,
     5181     output  loc-ord-num
     5182    ) .
     5183   define variable loc-order-type as integer no-undo .
     5184   if v-cntxt-db-num  = 0 then loc-order-type = 2 .
     5185                          else loc-order-type = 3 .
     5186         run create-ord-doc in this-procedure (
     5187             input loc-ord-num  ,
     5188             input ?            ,
     5189             input ""           ,
     5190             input ""           ,
     5191             input ""           ,
     5192             input v-cntxt-host-code-obj  ,
     5193             input v-cntxt-obj-code   ,
     5194             input v-cntxt-obj-type   ,
     5195             input 'ПО':U       ,
     5196             input 'новый':U   ,
     5197             input today        ,
     5198             input today        ,
     5199             input loc-order-type ,
     5200             output p-ord-doc-recid )
     5201             .
     5202       end.
     5203     do transaction on error undo, return error return-value :
     5204       find first buf_ord-doc  exclusive-lock  where
     5205            recid(buf_ord-doc) = p-ord-doc-recid no-error .
     5206            if error-status :error then do:
     5207            message vss-workfile vss-revision vss-description skip
     5208                   "Ошибка  " skip
     5209                    skip
     5210                    error-status :get-message(1) skip
     5211                    return-value skip
     5212                    view-as alert-box error
     5213            .
     5214            return error.
     5215            end.
     5216     end.
     5217    loc-ord-num = buf_ord-doc.doc-code .
     5218   X_ord-line.qnty:read-only in browse BROWSE-2 = true .
     5219       run recalc-head in this-procedure .
     5220       run my-enable_ui in this-procedure .
     5221        if p-mode  = 'ДОБАВЛЕНИЕ':U then WAIT-FOR GO  OF FRAME Dialog-Frame focus  scr-ship-date.
     5222        else WAIT-FOR GO  OF FRAME Dialog-Frame focus BROWSE-2.
     5223     end.
     5224     else do:
     5225         find first buf_ord-doc  no-lock where
     5226              recid(buf_ord-doc) = p-ord-doc-recid no-error .
     5227            if error-status :error then do:
     5228            message vss-workfile vss-revision vss-description skip
     5229                   "Ошибка просмотра " skip
     5230                    skip
     5231                    error-status :get-message(1) skip
     5232                    return-value skip
     5233                    view-as alert-box error
     5234            .
     5235            return error.
     5236            end.
     5237         loc-ord-num = buf_ord-doc.doc-code .
     5238         run recalc-head in this-procedure .
     5239         run my-enable-lkp in this-procedure .
     5240         WAIT-FOR GO  OF FRAME Dialog-Frame focus b-exit.
     5241     end.
     5242   END.
     5243   RUN disable_UI.
     5244   PROCEDURE add-spec-contract :
     5245   define variable ii        as integer   no-undo .
     5246   define variable t-ret     as logical   no-undo .
     5247   define variable r-tmp     as recid no-undo .
     5248   define variable r-ord     as recid no-undo .
     5249   define variable r-stop    as logical no-undo .
     5250   define variable r-exit    as logical no-undo .
     5251   define variable var-ok-assort-pol   as logical   no-undo .
     5252   define variable var-mess-assort-pol as character no-undo .
     5253   define variable v-price as logical   no-undo .
     5254   define buffer buf_ord-line for ub.ord-line  .
     5255     do
     5256     on error undo, return error return-value
     5257     :
     5258   if loc-contract = 0 or loc-contract = ? then return .
     5259   message "Добавление товаров по спецификации договора "
     5260           skip "Вн.№ " loc-contract skip
     5261           "Продолжать ?"
     5262           view-as alert-box question
     5263           buttons yes-no
     5264           update t-ret
     5265           .
     5266   if t-ret = false then return .
     5267   message "Цены в заказе из спецификации договора ?"
     5268           skip "Вн.№ " loc-contract skip
     5269           view-as alert-box question
     5270           buttons yes-no
     5271           update v-price
     5272           .
     5273      t-ret =  session:set-wait-state("general") .
     5274      line-mode = 'ДОБАВЛЕНИЕ':U.
     5275   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5276   ASSIGN
     5277      i-gl-Host-Code      = 0
     5278      i-gl-Contract-Code  = 0
     5279      i-gl-Extent3        = 0
     5280      .
     5281   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5282       INPUT  v-cntxt-host-code-obj,
     5283       INPUT  loc-contract,
     5284       OUTPUT i-gl-Extent3
     5285      ).
     5286   IF i-gl-Extent3[1] = 2 THEN DO:
     5287      ASSIGN
     5288         i-gl-Host-Code      = i-gl-Extent3[2]
     5289         i-gl-Contract-Code  = i-gl-Extent3[3]
     5290         .
     5291   END. ELSE DO:
     5292      ASSIGN
     5293         i-gl-Host-Code      = v-cntxt-host-code-obj
     5294         i-gl-Contract-Code  = loc-contract
     5295         .
     5296   END.
     5297   FOR EACH
     5298       ub.contract-specif
     5299        NO-LOCK
     5300        WHERE
     5301            ub.contract-specif.Host-code    = i-gl-Host-Code
     5302        AND ub.contract-specif.Contract-num = i-gl-Contract-Code
     5303        :
     5304       ii = ii + 1 .
     5305       if ii > 1 then assign line-mode = "ЦИКЛ":u.
     5306       find first  buf_ord-line  exclusive-lock      where
     5307                   buf_ord-line.gds-code = ub.contract-specif.gds-code  and
     5308                   buf_ord-line.doc-code = loc-ord-num
     5309                   no-error .
     5310        if available buf_ord-line then do:
     5311            run cus/ord-frmp.w ( parParentProc , input ?  , input recid ( buf_ord-line)  , input 'ИЗМЕНЕНИЕ':U,  output r-stop , output r-exit ) no-error .
     5312        end.
     5313        else do:
     5314           run create-tmp in this-procedure (input "contract-spec":u, input  v-price , output r-tmp , output r-ord) no-error .
     5315           if not  error-status :error  then do:
     5316             find first tmp#zakaz  where  recid ( tmp#zakaz ) = r-tmp  .
     5317             var-ok-assort-pol = true .
     5318   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5319   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     5320     (input  'ПО':U
     5321     ,input  ub.contract-specif.gds-code
     5322     ,input  v-cntxt-obj-type
     5323     ,input  v-cntxt-obj-code
     5324     ,input  true
     5325     ,output var-ok-assort-pol
     5326     ,output var-mess-assort-pol
     5327     ) .
     5328             if var-ok-assort-pol = false then do:
     5329                 message var-mess-assort-pol skip "Товар не может быть включен в заказ !" view-as alert-box information .
     5330                 run p-delete in this-procedure ( r-tmp , input-output ii ) .
     5331                 next.
     5332             end.
     5333             run cus/ord-frmp.w ( parParentProc ,input r-tmp  , input r-ord  , input line-mode,  output r-stop , output r-exit ) .
     5334             if r-stop then do:
     5335                run p-delete in this-procedure ( r-tmp , input-output ii).
     5336                leave.
     5337             end.
     5338             if r-exit then do:
     5339                run p-delete in this-procedure ( r-tmp , input-output ii ) .
     5340             end.
     5341           end.
     5342        end.
     5343      end.
     5344       run openbr in this-procedure  .
     5345       t-ret =  session:set-wait-state("") .
     5346       message "Добавлено " + string(ii) + " товаров".
     5347     end.
     5348   END PROCEDURE.
     5349   PROCEDURE create-ord-doc :
     5350    do
     5351    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5352    :
     5353   define input parameter p-doc-code   like  ub.ord-doc.doc-code  no-undo .
     5354   define input parameter p-cli-code   like  ub.ord-doc.cli-code  no-undo .
     5355   define input parameter p-cli-type   like  ub.ord-doc.cli-type  no-undo .
     5356   define input parameter p-cli-name   like  ub.ord-doc.cli-name  no-undo .
     5357   define input parameter p-cons-code  like  ub.ord-doc.cons-code no-undo .
     5358   define input parameter p-host-code  like  ub.ord-doc.host-code no-undo .
     5359   define input parameter p-obj-code   like  ub.ord-doc.obj-code  no-undo .
     5360   define input parameter p-obj-type   like  ub.ord-doc.obj-type  no-undo .
     5361   define input parameter p-doc-type   like  ub.ord-doc.doc-type  no-undo .
     5362   define input parameter p-status_    like  ub.ord-doc.status_   no-undo .
     5363   define input parameter p-doc-date   like  ub.ord-doc.doc-date  no-undo .
     5364   define input parameter p-ship-date  like  ub.ord-doc.ship-date no-undo .
     5365   define input parameter p-order-type like  ub.ord-doc.order-type    no-undo .
     5366   define output parameter p-recid as recid no-undo .
     5367   define variable v-i-doc as character no-undo .
     5368   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5369   run proc-ord-code in this-procedure
     5370    (input   'main' ,
     5371     input   v-cntxt-db-num ,
     5372     input   p-obj-type ,
     5373     input   p-obj-code ,
     5374     input   v-i-doc ,
     5375     output  loc-ord-num
     5376    ) .
     5377      create ub.ord-doc.
     5378      assign
     5379         ub.ord-doc.doc-code   = p-doc-code
     5380         ub.ord-doc.cli-code   = p-cli-code
     5381         ub.ord-doc.cli-type   = p-cli-type
     5382         ub.ord-doc.cli-name   = p-cli-name
     5383         ub.ord-doc.cons-code  = p-cons-code
     5384         ub.ord-doc.host-code  = p-host-code
     5385         ub.ord-doc.obj-code   = p-obj-code
     5386         ub.ord-doc.obj-type   = p-obj-type
     5387         ub.ord-doc.doc-type   = p-doc-type
     5388         ub.ord-doc.status_    = p-status_
     5389         ub.ord-doc.doc-date   = p-doc-date
     5390         ub.ord-doc.ship-date     = p-ship-date
     5391         ub.ord-doc.order-type = p-order-type
     5392         p-recid = recid (ub.ord-doc)
     5393         .
     5394   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5396     (input  ub.ord-doc.host-code
     5397     ,input  p-doc-date
     5398     ,output ub.ord-doc.base-rate
     5399     ,output ub.ord-doc.base-scale
     5400     )  .
     5401     end.
     5402   END PROCEDURE.
     5403   PROCEDURE create-tmp :
     5404    do
     5405    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5406    :
     5407   define input    parameter tt as char no-undo.
     5408   define input    parameter p-price-contract as logical no-undo.
     5409   define output   parameter p-tmp as recid no-undo .
     5410   define output   parameter p-ord as recid no-undo .
     5411   define variable prod-type#   like ub.ord-line.prod-type no-undo .
     5412   define variable prod-code#   like ub.ord-line.prod-code no-undo .
     5413   define variable artic#       like ub.ord-line.artic     no-undo .
     5414   define buffer ll-buf_ord-line for ub.ord-line .
     5415   define variable p-recid as recid no-undo .
     5416       case tt :
     5417       when "tt-gds-list" then do:
     5418         find first ub.goods where
     5419               ub.goods.artic     = tt-gds-list.artic     and
     5420               ub.goods.prod-type = tt-gds-list.prod-type and
     5421               ub.goods.prod-code = tt-gds-list.prod-code no-lock no-error.
     5422               if error-status :error  then do:
     5423                   message vss-workfile vss-revision vss-description skip
     5424                   error-status :get-message(1)
     5425                   "Плохо ! tt-gds-list не = goods !"
     5426                   1
     5427                   view-as alert-box error .
     5428               end.
     5429         end.
     5430       when "contract-spec" then do:
     5431         find first ub.goods where
     5432               ub.goods.gds-code  = ub.contract-specif.gds-code  no-lock no-error.
     5433               if error-status :error  then do:
