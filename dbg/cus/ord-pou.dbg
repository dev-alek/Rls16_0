     1085   define variable var-report-r-b as character no-undo .
     1086   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1088     (output var-report-r-b
     1089     )  .
     1090   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1091     define variable v-cntxt-db-num        as integer   no-undo .
     1092     define variable v-cntxt-userid        as character no-undo .
     1093     define variable v-cntxt-level         as character no-undo .
     1094     define variable v-cntxt-host-code-obj as integer   no-undo .
     1095     define variable v-cntxt-obj-type      as character no-undo .
     1096     define variable v-cntxt-obj-code      as integer   no-undo .
     1097     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1098     define variable v-cntxt-is-admin      as logical   no-undo .
     1099   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   procedure proc-ord-code :
     1101   define input  parameter  p-type as character no-undo .
     1102   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1103   define input  parameter  v-cntxt-obj-type as character no-undo .
     1104   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1105   define input  parameter  p-i-doc    as character no-undo .
     1106   define output parameter  p-ord-doc  as character no-undo .
     1107   define variable          v-idop     as character no-undo .
     1108     do
     1109     on error undo, return error return-value
     1110     :
     1111   case p-type :
     1112       when "main-no-ver" then do:
     1113         if  (v-cntxt-db-num <> 0) then
     1114           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1115         else
     1116           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1117       end.
     1118       when "main" then do:
     1119             do while true:
     1120             if  (v-cntxt-db-num <> 0) then
     1121               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1122             else
     1123               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1124             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1125             End.
     1126       end.
     1127       when "chip" then do:
     1128         assign
     1129           v-idop = p-i-doc .
     1130         do while true :
     1131           if index (v-idop , ".") = 0 then
     1132             v-idop  = replace (v-idop , "-", "-1.").
     1133           else
     1134             v-idop  =
     1135             substring (v-idop , 1, index (v-idop, "-")) +
     1136             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1137             substring (v-idop, index (v-idop, ".")).
     1138           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1139         end.
     1140         assign
     1141           p-ord-doc = v-idop.
     1142       end.
     1143   end case.
     1144     end.
     1145   end procedure.
     1146   procedure check-contract-code :
     1147   define input  parameter parmode           as   character                     no-undo.
     1148   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     1149   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     1150   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     1151   define input  parameter parframe-value    as   character                     no-undo.
     1152   define input  parameter parmenu-handle    as   handle                        no-undo.
     1153   define input  parameter parobj-date       as   date                          no-undo.
     1154   define input  parameter partype-contract  as   character                     no-undo .
     1155   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     1156   define buffer bf_contract     for ub.contract.
     1157   define buffer bf-oth_contract for ub.contract.
     1158   define variable varrid-list as character no-undo.
     1159   define variable varrecid    as recid     no-undo.
     1160   define variable varlog      as logical   no-undo.
     1161   define variable var-args    as char      no-undo.
     1162   define variable var-ext-doc-type as char     no-undo.
     1163   do on error undo, return error return-value :
     1164   var-args = parmode.
     1165   parmode = entry(1, parmode).
     1166   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     1167   if partype-contract = "" or partype-contract = ? then
     1168      partype-contract = 'при':U .
     1169   assign
     1170     parcontract-code = 0
     1171   .
     1172   if parmode = "input":u
     1173   then do:
     1174     if parframe-value = ""
     1175     then do:
     1176       assign
     1177         parcontract-code = 0
     1178       .
     1179     end.
     1180     else do:
     1181       find first bf_contract no-lock
     1182         where bf_contract.host-code         = parhost-code
     1183           and bf_contract.cli-type          = parcli-type
     1184           and bf_contract.cli-code          = parcli-code
     1185           and bf_contract.contract-prn-code = parframe-value
     1186         no-error.
     1187       if available bf_contract
     1188       then do:
     1189         find first bf-oth_contract no-lock
     1190           where bf-oth_contract.host-code          = parhost-code
     1191             and bf-oth_contract.contract-prn-code  = parframe-value
     1192             and bf-oth_contract.cli-type           = parcli-type
     1193             and bf-oth_contract.cli-code           = parcli-code
     1194             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     1195           no-error .
     1196         if available bf-oth_contract
     1197         then do:
     1198           message
     1199             "На фирме " parhost-code skip
     1200             "у контрагента" parcli-type parcli-code skip
     1201             "имеются два контракта с номером" parframe-value skip
     1202           view-as alert-box .
     1203         end.
     1204         else do:
     1205           assign
     1206             parcontract-code = bf_contract.contract-code
     1207           .
     1208         end.
     1209       end.
     1210     end.
     1211   end.
     1212   if parmode <> "input":u
     1213   or parcontract-code = 0
     1214   then do:
     1215     run str/cont-all.w (input parmenu-handle,
     1216                     input parhost-code,
     1217                     input "b-sel",
     1218                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     1219                     input parcli-type,
     1220                     input parcli-code,
     1221                     input ?,
     1222                     input ?,
     1223                     input "current":u,
     1224                     input partype-contract,
     1225                     input-output varrid-list ) no-error.
     1226     if error-status:error then do:
     1227       message "Ошибка при вызове справочника договоров." skip
     1228               return-value                skip
     1229               error-status:get-message(1) skip
     1230               error-status:get-message(2)
     1231       view-as alert-box error.
     1232       return error.
     1233     end.
     1234     assign
     1235       varrecid = integer(entry(1, varrid-list)).
     1236     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     1237     if available bf_contract then do:
     1238       assign
     1239         parcontract-code = bf_contract.contract-code.
     1240     end.
     1241   end.
     1242   if parcontract-code <> 0
     1243   then do:
     1244     if (bf_contract.status_ = 'зкр':U or
     1245         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     1246       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     1247       then do:
     1248           assign
     1249             varlog = no.
     1250           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     1251           view-as alert-box.
     1252           assign
     1253             parcontract-code = 0
     1254           .
     1255       end.
     1256     end.
     1257     if bf_contract.contract-date-beg > parobj-date then do:
     1258       assign
     1259         varlog = no.
     1260       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     1261       view-as alert-box.
     1262       assign
     1263         parcontract-code = 0
     1264       .
     1265     end.
     1266     if parcontract-code <> 0
     1267     then do:
     1268       if bf_contract.cli-type <> parcli-type
     1269       or bf_contract.cli-code <> parcli-code
     1270       then do:
     1271          message "По договору " bf_contract.contract-code
     1272                  ( if bf_contract.doc-type =  'при':U
     1273                    then " поставщиком является "
     1274                    else " покупателем является " )
     1275                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     1276                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     1277          view-as alert-box error.
     1278          assign
     1279            parcontract-code = 0.
     1280       end.
     1281       if parcontract-code <> ? then do:
     1282         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     1283           message "Контракт имеет недопустимый тип." view-as alert-box.
     1284           assign
     1285             parcontract-code = 0.
     1286         end.
     1287       end.
     1288     end.
     1289   end.
     1290   end.
     1291   end procedure.
     1292   procedure cntrcode-get-arg-val:
     1293       def input param p-args as char no-undo.
     1294       def input param p-key as char no-undo.
     1295       def output param p-val as char no-undo.
     1296       def var i as int no-undo.
     1297       def var nums as int no-undo.
     1298       def var key-val as char no-undo.
     1299       nums = num-entries(p-args).
     1300       do i = 1 to nums:
     1301           key-val = entry(i, p-args).
     1302           if key-val begins (p-key + "=") then do:
     1303               p-val = entry(2, key-val, "=").
     1304               return.
     1305           end.
     1306       end.
     1307       p-val = "".
     1308   end.
     1309   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1310   procedure factord :
     1311     define input  parameter p-fact-date            as date    no-undo .
     1312     define input  parameter p-fact-time            as integer no-undo .
     1313     define input  parameter p-fact-num             as integer no-undo .
     1314     define input  parameter p-shift-date           as date    no-undo .
     1315     define input  parameter p-shift-num            as integer no-undo .
     1316     define input  parameter p-shift-on             as logical no-undo .
     1317     define output parameter p-fact-order           as decimal no-undo .
     1318     define output parameter p-shift-end-fact-order as decimal no-undo .
     1319     define output parameter p-day-end-fact-order   as decimal no-undo .
     1320     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1321     if p-fact-date = ?
     1322     then do:
     1323       return error "Не указана фактическая дата" .
     1324     end.
     1325     define variable v-fact-date-num as integer no-undo .
     1326     assign
     1327       v-fact-date-num = integer(p-fact-date)
     1328     .
     1329     if p-fact-num = ?
     1330     or p-fact-num = 0
     1331     then do:
     1332       return error "Не задан p-fact-num " + string(p-fact-num) .
     1333     end.
     1334     if p-fact-num < 0
     1335     then do:
     1336       return error "Отрицательный fact-num " + string(p-fact-num) .
     1337     end.
     1338     if p-fact-num >= 100000000
     1339     then do:
     1340       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1341     end.
     1342     if p-shift-on = true
     1343     then do:
     1344       if p-shift-date = ?
     1345       then do:
     1346         return error "Не задана дата смены" .
     1347       end.
     1348       if p-shift-num = ?
     1349       or p-shift-num = 0
     1350       then do:
     1351         return error "Не задан номер смены" .
     1352       end.
     1353     end.
     1354     else do:
     1355       assign
     1356         p-shift-date = p-fact-date
     1357         p-shift-num  = 24
     1358       .
     1359     end.
     1360     define variable v-shift-offset as integer no-undo .
     1361     if p-shift-date = p-fact-date
     1362     then do:
     1363       assign
     1364         v-shift-offset = 1
     1365       .
     1366     end.
     1367     if p-shift-date < p-fact-date
     1368     then do:
     1369       assign
     1370         v-shift-offset = 0
     1371       .
     1372     end.
     1373     if p-shift-date > p-fact-date
     1374     then do:
     1375       message
     1376         vss-workfile vss-revision vss-description skip
     1377         "Неправильная дата закрытия смены" skip
     1378         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1379         view-as alert-box error .
     1380       undo, return error
     1381         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1382           ,string(p-fact-date, '99/99/9999':U)
     1383           ,string(p-shift-date, '99/99/9999':U)
     1384           )
     1385       .
     1386     end.
     1387     if p-shift-num < 1
     1388     or p-shift-num > 24
     1389     then do:
     1390       message
     1391         vss-workfile vss-revision vss-description skip
     1392         "Неправильный номер смены" skip
     1393         "p-shift-num" p-shift-num skip
     1394         view-as alert-box error .
     1395       undo, return error return-value .
     1396     end.
     1397     assign
     1398       p-fact-order           = v-fact-date-num
     1399                              + v-shift-offset * 0.5
     1400                              + p-shift-num    * 0.02 - 0.01
     1401                              + p-fact-num     * 0.0000000001
     1402       p-shift-end-fact-order = v-fact-date-num
     1403                              + v-shift-offset * 0.5
     1404                              + p-shift-num    * 0.02
     1405       p-day-end-fact-order   = v-fact-date-num
     1406                              + 0.99
     1407     .
     1408     if p-fact-order           <= v-fact-date-num
     1409     or p-shift-end-fact-order <= v-fact-date-num
     1410     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1411     or p-shift-end-fact-order >= p-day-end-fact-order
     1412     then do:
     1413       message
     1414         vss-workfile vss-revision vss-description skip
     1415         "Внутренняя ошибка при генерации фактического номера" skip
     1416         "p-fact-date"            p-fact-date            skip
     1417         "p-fact-time"            p-fact-time            skip
     1418         "p-fact-num"             p-fact-num             skip
     1419         "p-shift-date"           p-shift-date           skip
     1420         "p-shift-num"            p-shift-num            skip
     1421         "p-shift-on"             p-shift-on             skip
     1422         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1423         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1424         "v-fact-date-num"        v-fact-date-num        skip
     1425         view-as alert-box error .
     1426       undo, return error return-value .
     1427     end.
     1428   end procedure.
     1429   procedure day-begin-fact-order :
     1430     define input  parameter p-fact-date            as date    no-undo .
     1431     define output parameter p-day-begin-fact-order as decimal no-undo .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       if p-fact-date = ?
     1436       then do:
     1437         assign
     1438           p-day-begin-fact-order = 0
     1439         .
     1440       end.
     1441       else do:
     1442         assign
     1443           p-day-begin-fact-order = integer(p-fact-date)
     1444         .
     1445       end.
     1446     end.
     1447   end procedure.
     1448   procedure factord-max-fact-order :
     1449     define output parameter p-max-fact-order as decimal   no-undo .
     1450     do
     1451     on error undo, return error return-value
     1452     :
     1453       run day-begin-fact-order in this-procedure
     1454         (input  date(1, 1, 5000)
     1455         ,output p-max-fact-order
     1456         ) .
     1457     end.
     1458   end procedure.
     1459   procedure factord-cut-archive :
     1460     define input  parameter p-obj-type             as character no-undo .
     1461     define input  parameter p-obj-code             as integer   no-undo .
     1462     define input  parameter p-fact-date            as date      no-undo .
     1463     define output parameter p-shift-on             as logical   no-undo .
     1464     define output parameter p-shift-date           as date      no-undo .
     1465     define output parameter p-shift-num            as integer   no-undo .
     1466     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1467     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1468     define variable v-fact-order as decimal   no-undo .
     1469     define buffer buf_shift-obj for ub.shift-obj .
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1475     (input  p-obj-type
     1476     ,input  p-obj-code
     1477     ,input  'shift-on=request'
     1478     ,output p-shift-on
     1479     ) no-error .
     1480       if error-status :error
     1481       then do:
     1482         message
     1483           vss-workfile vss-revision vss-description skip
     1484           "Ошибка при определении атрибута объекта" skip
     1485           "Объект" p-obj-type p-obj-code skip
     1486           error-status :get-message(1) skip
     1487           return-value skip
     1488           view-as alert-box error .
     1489         undo, return error return-value .
     1490       end.
     1491       if p-shift-on = false
     1492       then do:
     1493         assign
     1494           p-shift-date               = ?
     1495           p-shift-num                = 0
     1496         .
     1497       end.
     1498       else do:
     1499         find first buf_shift-obj share-lock
     1500           where buf_shift-obj.obj-type   = p-obj-type
     1501             and buf_shift-obj.obj-code   = p-obj-code
     1502             and buf_shift-obj.shift-date > p-fact-date
     1503           use-index pi
     1504           no-error .
     1505         if not available buf_shift-obj
     1506         or buf_shift-obj.status_ <> 'зкр':U
     1507         then do:
     1508           message
     1509             vss-workfile vss-revision vss-description skip
     1510             "Невозможно вычислить последнюю смену" skip
     1511             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1512             "Объект" p-obj-type p-obj-code skip
     1513             "Дата" p-fact-date skip
     1514             view-as alert-box error .
     1515           undo, return error return-value .
     1516         end.
     1517         find last buf_shift-obj share-lock
     1518           where buf_shift-obj.obj-type = p-obj-type
     1519             and buf_shift-obj.obj-code = p-obj-code
     1520             and buf_shift-obj.shift-date <= p-fact-date
     1521           use-index pi
     1522           no-error .
     1523         if available buf_shift-obj
     1524         then do:
     1525           if  buf_shift-obj.status_ = 'зкр':U
     1526           then do:
     1527             assign
     1528               p-shift-date = buf_shift-obj.shift-date
     1529               p-shift-num  = buf_shift-obj.shift-num
     1530             .
     1531           end.
     1532           else do:
     1533             message
     1534               vss-workfile vss-revision vss-description skip
     1535               "Невозможно вычислить последнюю смену" skip
     1536               "Статус смены отличен от статуса" 'зкр':U skip
     1537               "Объект" p-obj-type p-obj-code skip
     1538               "Дата" p-fact-date skip
     1539               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1540               view-as alert-box error .
     1541             undo, return error return-value .
     1542           end.
     1543         end.
     1544         else do:
     1545           assign
     1546             p-shift-date = p-fact-date - 1
     1547             p-shift-num  = 1
     1548           .
     1549         end.
     1550       end.
     1551       run factord in this-procedure
     1552         (input  p-fact-date
     1553         ,input  1
     1554         ,input  1
     1555         ,input  p-shift-date
     1556         ,input  p-shift-num
     1557         ,input  p-shift-on
     1558         ,output v-fact-order
     1559         ,output p-shift-end-fact-order
     1560         ,output p-day-end-fact-order
     1561         ) no-error .
     1562       if error-status :error
     1563       then do:
     1564         message
     1565           vss-workfile vss-revision vss-description skip
     1566           "Ошибка при вызове процедуры factord"
     1567           error-status :get-message(1) skip
     1568           return-value skip
     1569           view-as alert-box error .
     1570         undo, return error return-value .
     1571       end.
     1572     end.
     1573   end procedure.
     1574   procedure factord-lock-shift :
     1575     define input  parameter p-obj-type  as character no-undo .
     1576     define input  parameter p-obj-code  as integer   no-undo .
     1577     define input  parameter p-fact-date as date      no-undo .
     1578     define parameter buffer buf_shift-obj for ub.shift-obj .
     1579     define variable v-shift-on      as logical   no-undo .
     1580     define variable v-extra-message as character no-undo .
     1581     define variable v-error as character no-undo .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1587     (input  p-obj-type
     1588     ,input  p-obj-code
     1589     ,input  'shift-on=request'
     1590     ,output v-shift-on
     1591     ) no-error .
     1592       if error-status :error
     1593       then do:
     1594         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1595         undo, return error v-error .
     1596       end.
     1597       if v-shift-on = true
     1598       then do:
     1599         find first buf_shift-obj share-lock
     1600           where buf_shift-obj.obj-type   = p-obj-type
     1601             and buf_shift-obj.obj-code   = p-obj-code
     1602             and buf_shift-obj.shift-date > p-fact-date
     1603           use-index pi
     1604           no-error .
     1605         if not available buf_shift-obj
     1606         or buf_shift-obj.status_ <> 'зкр':U
     1607         then do:
     1608           find last buf_shift-obj
     1609             where buf_shift-obj.obj-type = p-obj-type
     1610               and buf_shift-obj.obj-code = p-obj-code
     1611               and buf_shift-obj.status_  = 'зкр':U
     1612             use-index stts
     1613             no-error .
     1614           if available buf_shift-obj
     1615           then do:
     1616             assign
     1617               v-extra-message =
     1618                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1619                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1620                               )
     1621             .
     1622           end.
     1623           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1624           undo, return error v-error .
     1625         end.
     1626       end.
     1627     end.
     1628   end procedure.
     1629   procedure factord-end-day :
     1630     define input  parameter p-fact-date            as date    no-undo .
     1631     define output parameter p-day-end-fact-order   as decimal no-undo .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       if p-fact-date = ?
     1636       then do:
     1637         return error "Не указана фактическая дата" .
     1638       end.
     1639       assign
     1640         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1641       .
     1642     end.
     1643   end procedure.
     1644   procedure factord-to-date :
     1645     define input  parameter p-fact-order as decimal no-undo .
     1646     define output parameter p-fact-date  as date    no-undo .
     1647     define variable v-ref-date  as date      no-undo .
     1648     define variable v-ref-delta as integer   no-undo .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       if p-fact-order = ?
     1653       or p-fact-order = 0
     1654       then do:
     1655         return error "Не указан fact-order" .
     1656       end.
     1657       assign
     1658         v-ref-date  = date(1, 1, 2000)
     1659       .
     1660       assign
     1661         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1662       .
     1663       assign
     1664         p-fact-date = v-ref-date + v-ref-delta
     1665       .
     1666     end.
     1667   end procedure.
     1668   procedure factord-to-fact-num :
     1669     define input  parameter p-fact-order as decimal no-undo .
     1670     define output parameter p-fact-num   as integer no-undo .
     1671     define variable v-fact-order-trunc as decimal no-undo .
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       if p-fact-order = ?
     1676       or p-fact-order = 0
     1677       then do:
     1678         return error "Не указан fact-order" .
     1679       end.
     1680       assign
     1681        v-fact-order-trunc = truncate(p-fact-order, 2)
     1682       .
     1683       assign
     1684         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1685       .
     1686     end.
     1687   end procedure.
     1688   procedure factord-to-shift-num :
     1689     define input  parameter p-fact-order as decimal no-undo .
     1690     define output parameter p-shift-num   as integer no-undo .
     1691     define variable  p-shift-numd  as decimal   no-undo .
     1692     define variable v-fact-order-trunc as decimal no-undo .
     1693     do
     1694     on error undo, return error return-value
     1695     :
     1696       if p-fact-order = ?
     1697       or p-fact-order = 0
     1698       then do:
     1699         return error "Не указан fact-order" .
     1700       end.
     1701       assign
     1702        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1703       .
     1704       if v-fact-order-trunc < 0.5 then do:
     1705         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1706       end.
     1707       assign
     1708         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1709         .
     1710        assign
     1711         p-shift-num = truncate (p-shift-numd , 0)
     1712       .
     1713     end.
     1714   end procedure.
     1715   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1718   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1719   procedure fact-order-mpl :
     1720     do
     1721     on error undo, return error return-value
     1722     :
     1723   define input  parameter p-doc-date as date     no-undo .
     1724   define input  parameter p-obj-type as character no-undo .
     1725   define input  parameter p-obj-code as integer   no-undo .
     1726   define output parameter p-fact-order as decimal   no-undo .
     1727   define variable v-fact-date            as date    no-undo .
     1728   define variable v-fact-time            as integer no-undo .
     1729   define variable v-fact-order           as decimal no-undo .
     1730   define variable v-shift-end-fact-order as decimal no-undo .
     1731   define variable v-day-end-fact-order   as decimal no-undo .
     1732   define variable l-shift-on as logical no-undo .
     1733   define variable l-date as date      no-undo .
     1734   define variable l-time as integer   no-undo .
     1735   define variable shift-date as date      no-undo .
     1736   define variable shift-num  as integer   no-undo .
     1737   define variable shift-name as character no-undo .
     1738   define variable max-fact-order as decimal   no-undo .
     1739   define buffer buf_global-state for ub.global-state  .
     1740   find first buf_global-state no-lock no-error .
     1741   if not available buf_global-state then do:
     1742      message
     1743        "Не заданы параметры ценообразования!"
     1744        view-as alert-box error
     1745      .
     1746      return error return-value .
     1747   end.
     1748     run cur-time in this-procedure
     1749     ( output v-fact-date ,
     1750       output v-fact-time  ).
     1751   if p-doc-date = ? then do:
     1752   if buf_global-state.pl-use-sys-date-time  = true then do:
     1753         run factord in this-procedure
     1754           (input  v-fact-date
     1755           ,input  v-fact-time
     1756           ,input  v-fact-time
     1757           ,input  ?
     1758           ,input  ?
     1759           ,input  false
     1760           ,output v-fact-order
     1761           ,output v-shift-end-fact-order
     1762           ,output v-day-end-fact-order
     1763           ) no-error .
     1764         if error-status :error
     1765         or v-fact-order = ?
     1766         or v-fact-order = 0 then do:
     1767           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1768         end.
     1769         p-fact-order = v-fact-order .
     1770   end.
     1771   else do:
     1772   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1774     (input  p-obj-type
     1775     ,input  p-obj-code
     1776     ,input  'shift-on=request'
     1777     ,output l-shift-on
     1778     ) no-error .
     1779         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1780         if p-doc-date <> ? then do:
     1781         end.
     1782          run gbl/factdate.p
     1783          ( input        p-obj-type  ,
     1784            input        p-obj-code  ,
     1785            input-output v-fact-date ,
     1786            input-output v-fact-time ,
     1787            input-output shift-date      ,
     1788            input-output shift-num       ,
     1789            input-output shift-name      ,
     1790            input        yes
     1791            ) no-error .
     1792         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1793         run factord in this-procedure
     1794           (input  v-fact-date
     1795           ,input  v-fact-time
     1796           ,input  v-fact-time
     1797           ,input  shift-date
     1798           ,input  shift-num
     1799           ,input  l-shift-on
     1800           ,output v-fact-order
     1801           ,output v-shift-end-fact-order
     1802           ,output v-day-end-fact-order
     1803           ) no-error .
     1804         if error-status :error
     1805         or v-fact-order = ?
     1806         or v-fact-order = 0 then do:
     1807           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1808         end.
     1809         p-fact-order = v-fact-order .
     1810   end.
     1811   end.
     1812   else do:
     1813          run gbl/factdate.p
     1814          ( input        p-obj-type  ,
     1815            input        p-obj-code  ,
     1816            input-output v-fact-date ,
     1817            input-output v-fact-time ,
     1818            input-output shift-date      ,
     1819            input-output shift-num       ,
     1820            input-output shift-name      ,
     1821            input        yes
     1822            ) no-error .
     1823         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1824         v-fact-date = p-doc-date .
     1825         run factord in this-procedure
     1826           (input  v-fact-date
     1827           ,input  v-fact-time
     1828           ,input  v-fact-time
     1829           ,input  shift-date
     1830           ,input  shift-num
     1831           ,input  l-shift-on
     1832           ,output v-fact-order
     1833           ,output v-shift-end-fact-order
     1834           ,output v-day-end-fact-order
     1835           ) no-error .
     1836         if error-status :error
     1837         or v-fact-order = ?
     1838         or v-fact-order = 0 then do:
     1839           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1840         end.
     1841         p-fact-order = v-fact-order .
     1842   end.
     1843     end.
     1844   end procedure.
     1845   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1846   field sale-qnty as decimal
     1847   field sale-sum  as decimal
     1848   field sale-tnv  as decimal
     1849   field price-sale-base as decimal
     1850   field price-sale-rubl as decimal
     1851   field road-tax-base   as decimal
     1852   field road-tax-rubl   as decimal
     1853   field excise-base as decimal
     1854   field excise-rubl as decimal
     1855   field date-1 as date
     1856   field date-2 as date
     1857   field shift-1 as int
     1858   field shift-2 as int
     1859   field time-1 as int
     1860   field time-2 as int
     1861   field grp-name as char
     1862   field interv-name as char
     1863   field pay-name as char
     1864   field unit-cli as char
     1865   index pi
     1866   plt-priority DESCENDING
     1867   fact-order DESCENDING
     1868   qnty-from asc
     1869   sum-from asc
     1870   turnover-from asc
     1871   date-1 DESCENDING
     1872   time-1 DESCENDING
     1873   date-2 DESCENDING
     1874   time-2 DESCENDING
     1875   type-price DESCENDING
     1876   .
     1877   procedure mpl-autoprice :
     1878   define input  parameter p-only-b-code as logical   no-undo .
     1879   define input  parameter p-cli-type    as character no-undo .
     1880   define input  parameter p-cli-code    as integer   no-undo .
     1881   define input  parameter p-main-b-code as integer   no-undo .
     1882   define input  parameter p-b-code      as integer   no-undo .
     1883   define input  parameter p-obj-type    as character no-undo .
     1884   define input  parameter p-obj-code    as integer   no-undo .
     1885   define input  parameter p-qnty-doc    as decimal   no-undo .
     1886   define input  parameter p-sum-doc     as decimal   no-undo .
     1887   define input  parameter p-vid-pay        as character no-undo .
     1888   define input  parameter p-cash-pay-type  as character no-undo .
     1889   define input  parameter p-fact-order  as decimal   no-undo .
     1890   define output parameter p-plt-id          as integer   no-undo .
     1891   define output parameter p-plt-db-num      as integer   no-undo .
     1892   define output parameter p-pdf-id          as integer   no-undo .
     1893   define output parameter p-pdf-db-num      as integer   no-undo .
     1894   define output parameter p-sale-price-base as decimal   no-undo .
     1895   define output parameter p-sale-price-rubl as decimal   no-undo .
     1896   define output parameter p-road-tax-base as decimal   no-undo .
     1897   define output parameter p-road-tax-rubl as decimal   no-undo .
     1898   define output parameter p-excise-base   as decimal   no-undo .
     1899   define output parameter p-excise-rubl   as decimal   no-undo .
     1900   define variable v-cli-oborot-ALL as decimal   no-undo .
     1901   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1902   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1903   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1904   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1905   define buffer buf_price-all              for ub.price-all  .
     1906   define buffer buf_goods                  for ub.goods      .
     1907   define buffer buf_global-state           for ub.global-state  .
     1908   define buffer buf_buyer-group            for ub.buyer-group  .
     1909   define buffer buf_turnover-group         for ub.turnover-group  .
     1910   define buffer buf_main-code              for ub.bar-code  .
     1911   define buffer buf_bar-code               for ub.bar-code  .
     1912   define buffer buf_pay-type               for ub.pay-type  .
     1913   define buffer buf_cash-pay               for ub.cash-pay  .
     1914   define variable to-day          as date      no-undo .
     1915   define variable v-base-rate0    as decimal   no-undo .
     1916   define variable v-base-scale0   as decimal   no-undo .
     1917   define variable v-exch-rate0    as decimal   no-undo .
     1918   define variable v-exch-scale0   as decimal   no-undo .
     1919   define variable v-base-rate     as decimal   no-undo .
     1920   define variable v-base-scale    as decimal   no-undo .
     1921   define variable v-exch-rate     as decimal   no-undo .
     1922   define variable v-exch-scale    as decimal   no-undo .
     1923   define variable v-host-code     as integer   no-undo .
     1924   define variable v-curr-abbr     as character no-undo .
     1925   define variable v-grp-name      as character no-undo .
     1926   define variable v-date-1        as date      no-undo .
     1927   define variable v-date-2        as date      no-undo .
     1928   define variable v-interv        as character no-undo .
     1929   define variable v-pay-name      as character no-undo .
     1930   define variable v-cli-oborot    as decimal   no-undo .
     1931   define variable v-trn-pay-code  as integer   no-undo .
     1932   define variable v-cash-pay-curr as integer   no-undo .
     1933   define variable v-cash-pay-code as integer   no-undo .
     1934   do
     1935   on error undo, return error return-value
     1936   :
     1937   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1938   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1939   if p-fact-order = ? then do:
     1940     run fact-order-mpl (
     1941         input   today       ,
     1942         input   p-obj-type  ,
     1943         input   p-obj-code  ,
     1944         output  p-fact-order ).
     1945   end.
     1946   if p-vid-pay <> "" then do:
     1947      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1948      if available buf_pay-type
     1949         then v-trn-pay-code = buf_pay-type.obj-code.
     1950         else v-trn-pay-code =  0.
     1951   end.
     1952   else v-trn-pay-code = 0 .
     1953   if p-cash-pay-type <> "" then do:
     1954      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1955      if available buf_pay-type
     1956         then
     1957           assign
     1958             v-cash-pay-curr = buf_cash-pay.curr-code
     1959             v-cash-pay-code = buf_cash-pay.cdpay-code
     1960           .
     1961         else
     1962           assign
     1963             v-cash-pay-curr = 0
     1964             v-cash-pay-code = 0
     1965             .
     1966   end.
     1967   else
     1968     assign
     1969       v-cash-pay-curr = 0
     1970       v-cash-pay-code = 0
     1971       .
     1972   for each tt_price-all  : delete tt_price-all . end.
     1973   assign
     1974     p-plt-id             = ?
     1975     p-plt-db-num         = ?
     1976     p-pdf-id             = ?
     1977     p-pdf-db-num         = ?
     1978     p-sale-price-base    = ?
