      638   def
      639   new shared
      640   temp-table  obj-list no-undo
      641     field obj-type like ub.clients.obj-type
      642     field obj-code like ub.clients.obj-code
      643     field obj-name like ub.clients.obj-name
      644     field obj-id   as integer
      645     field db-num   as integer
      646     index pi is primary unique obj-id
      647     index ie1 obj-type obj-code
      648     index ie2 obj-name
      649   .
      650   procedure create_obj-list :
      651      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      652      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      653      do
      654      on error undo, return error return-value
      655      :
      656         define buffer cli-obj for ub.clients .
      657         define variable p-var as integer no-undo .
      658         define buffer buf_obj-list for obj-list .
      659         find last buf_obj-list  use-index pi no-error .
      660         if available buf_obj-list
      661         then
      662            p-var = buf_obj-list.obj-id + 1.
      663         else
      664            p-var = 1.
      665         find first cli-obj where
      666                   cli-obj.obj-type = p-obj-type
      667               and cli-obj.obj-code = p-obj-code
      668         no-lock no-error.
      669         if available cli-obj
      670         then do:
      671            create buf_obj-list.
      672            assign
      673               buf_obj-list.obj-id   = p-var
      674               buf_obj-list.obj-code = cli-obj.obj-code
      675               buf_obj-list.obj-type = cli-obj.obj-type
      676               buf_obj-list.obj-name = cli-obj.obj-name
      677               buf_obj-list.db-num   = cli-obj.db-num
      678            .
      679         end.
      680      end.
      681   end.
