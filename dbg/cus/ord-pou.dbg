     2222               p-pdf-id           = tt_price-all.pdf-id
     2223               p-pdf-db-num       = tt_price-all.pdf-db
     2224               p-sale-price-base  = tt_price-all.price-sale-base
     2225               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2226               p-road-tax-base    = tt_price-all.road-tax-base
     2227               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2228               p-excise-base      = tt_price-all.excise-base
     2229               p-excise-rubl      = tt_price-all.excise-rubl
     2230               .
     2231        end.
     2232        else do:
     2233          find first neos_price-all where
     2234                     neos_price-all.b-code     = p-b-code  and
     2235                     neos_price-all.plt-id     = vt-plt-id and
     2236                     neos_price-all.plt-db-num = vt-plt-db and
     2237                     neos_price-all.pdf-id     = vt-pdf-id and
     2238                     neos_price-all.pdf-db     = vt-pdf-db
     2239                     use-index pi no-error .
     2240            if available neos_price-all then do:
     2241             assign
