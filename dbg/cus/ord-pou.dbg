     5627   PROCEDURE disable_UI :
     5628     HIDE FRAME Dialog-Frame.
     5629   END PROCEDURE.
     5630   PROCEDURE enable_UI :
     5631     DISPLAY scr-cli scr-ship-date scr-wrkr scr-agnt scr-boss scr-cli-name
     5632             scr-contract scr-obj-name scr-wrkr-name scr-agnt-name scr-sum-qnty
     5633             scr-boss-name scr-sum-rubl scr-sum-base
     5634         WITH FRAME Dialog-Frame.
     5635     ENABLE b-exit b-quit B-delivery B-help I-deliver scr-cli r-cli B-contract
     5636            scr-ship-date scr-wrkr r-wrkr scr-agnt r-agnt scr-boss r-boss B-add
     5637            B-specif B-chg B-del BROWSE-2 scr-cli-name scr-contract scr-obj-name
     5638            scr-wrkr-name scr-agnt-name scr-sum-qnty scr-boss-name scr-sum-rubl
     5639            scr-sum-base
     5640         WITH FRAME Dialog-Frame.
     5641     VIEW FRAME Dialog-Frame.
     5642     OPEN QUERY BROWSE-2 FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     5643   END PROCEDURE.
     5644   PROCEDURE init-gds-rec :
     5645    do
     5646    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5647    :
     5648     find current x_goods no-lock no-error .
     5649     gds-rec = recid(x_goods) .
     5650     end.
     5651   END PROCEDURE.
     5652   PROCEDURE init-proc :
     5653    do
     5654    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5655    :
     5656    find first buf_clients no-lock where
     5657               buf_clients.obj-code = buf_ord-doc.obj-code and
     5658               buf_clients.obj-type = buf_ord-doc.obj-type
     5659               no-error .
     5660               if error-status :error then do:
     5661               message vss-workfile vss-revision vss-description skip
     5662                      "Ошибка  " skip
     5663                       skip
     5664                       error-status :get-message(1) skip
     5665                       return-value skip
     5666                       view-as alert-box error
     5667               .
     5668               return error .
     5669               end.
     5670    assign
     5671     scr-ship-date    = buf_ord-doc.ship-date
     5672     loc-date-ship    = scr-ship-date
     5673     loc-obj-code     = buf_ord-doc.obj-code
     5674     loc-obj-type     = buf_ord-doc.obj-type
     5675     loc-cli-code     = buf_ord-doc.cli-code
     5676     loc-cli-type     = buf_ord-doc.cli-type
     5677     scr-cli-name     = buf_ord-doc.cli-name
     5678     scr-cli          = buf_ord-doc.cli-code
     5679     loc-doc-type     = buf_ord-doc.doc-type
     5680     scr-obj-name     = buf_clients.obj-name
     5681     loc-ord-num      = buf_ord-doc.doc-code
     5682     scr-wrkr         = buf_ord-doc.wrkr
     5683     scr-boss         = buf_ord-doc.boss
     5684     scr-agnt         = buf_ord-doc.agnt
     5685     loc-contract     = buf_ord-doc.contract-code
     5686     v-deliv-type-code     =  buf_ord-doc.deliv-type-code
     5687     v-point-obj-code      =  buf_ord-doc.obj-point-code
     5688     v-point-cli-code      =  buf_ord-doc.cli-point-code
     5689     v-point-obj-db-num    =  buf_ord-doc.obj-point-db-num
     5690     v-point-cli-db-num    =  buf_ord-doc.cli-point-db-num
     5691     v-transport-host-code      =  buf_ord-doc.transport-host-code
     5692     v-transport-cli-type      =  buf_ord-doc.transport-cli-type
     5693     v-transport-cli-code      =  buf_ord-doc.transport-cli-code
     5694     v-transport-contract  =  buf_ord-doc.transport-contract
     5695     v-transport-condition =  buf_ord-doc.transport-condition
     5696     v-transport-value     =  buf_ord-doc.transport-value
     5697     v-transport-sum       =  buf_ord-doc.sum-ship
     5698     v-transport-vat       =  buf_ord-doc.transport-vat
     5699     scr-contract     = if loc-contract <> 0 then "Вн.№ дог. " + string(loc-contract)  else ""
     5700    .
     5701    run leave-proc-wrkr .
     5702    run leave-proc-boss .
     5703    run leave-proc-agnt .
     5704        ASSIGN frame Dialog-Frame:TITLE = "Заказ  № " + loc-ord-num
     5705      + " Тип: " +     buf_ord-doc.doc-type
     5706      + " Статус: "  +  buf_ord-doc.status_
     5707      + " - " + caps(p-mode).
     5708   assign
     5709   scr-agnt:label in frame Dialog-Frame    = "И&сп"
     5710   scr-agnt:tooltip in frame Dialog-Frame  = "Код исполнителя"
     5711   scr-wrkr:label in frame Dialog-Frame    = "К&л-к"
     5712   scr-wrkr:tooltip in frame Dialog-Frame  = "Код кладовщика"
     5713   scr-boss:label in frame Dialog-Frame    = "&М-р"
     5714   scr-boss:tooltip in frame Dialog-Frame  = "Код менеджера"
     5715   .
     5716     end.
     5717   END PROCEDURE.
     5718   PROCEDURE my-enable-lkp :
     5719    do
     5720    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5721    :
     5722     run init-proc.
     5723     X_ord-line.qnty:read-only in browse BROWSE-2  = true .
     5724     DISPLAY scr-ship-date scr-obj-name
     5725             scr-sum-base scr-sum-qnty scr-sum-rubl
     5726             scr-cli-name
     5727             scr-cli
     5728             scr-contract
     5729         WITH FRAME Dialog-Frame.
     5730     ENABLE b-exit b-next b-prev B-help BROWSE-2
     5731     b-contract B-delivery
     5732          WITH FRAME Dialog-Frame.
     5733       VIEW FRAME Dialog-Frame.
     5734         hide  b-quit in FRAME Dialog-Frame.
     5735         b-exit:label = "&Выход" .
     5736     Run OpenBr.
     5737     end.
     5738   END PROCEDURE.
     5739   PROCEDURE my-enable_UI :
     5740    do
     5741    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5742    :
     5743     run init-proc.
     5744     DISPLAY scr-ship-date scr-obj-name
     5745             scr-sum-base
     5746             scr-sum-qnty scr-sum-rubl
     5747             scr-wrkr-name
     5748             scr-agnt-name
     5749             scr-boss-name
     5750             scr-cli-name
     5751             scr-cli
     5752             scr-contract
     5753             WITH FRAME Dialog-Frame.
     5754     ENABLE b-exit b-quit B-help scr-ship-date B-add B-chg B-del
     5755             BROWSE-2
     5756            scr-wrkr r-wrkr
     5757            scr-agnt r-agnt
     5758            scr-boss r-boss
     5759            b-contract B-delivery
     5760            b-specif
     5761            r-cli
     5762            WITH FRAME Dialog-Frame.
     5763     VIEW FRAME Dialog-Frame.
     5764     Run OpenBr.
     5765     end.
     5766   END PROCEDURE.
     5767   PROCEDURE next-focus :
     5768   do
     5769   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5770   :
     5771   define input parameter p-widget-handle as handle no-undo .
     5772   define variable l-apply-entry as logical no-undo .
     5773   assign
     5774     l-apply-entry =   true
     5775   .
     5776   do with frame Dialog-Frame :
     5777     if  scr-ship-date   :handle = p-widget-handle then do:  if  scr-wrkr        :sensitive then do: apply "entry":u to scr-wrkr       . return . end. end.
     5778     if scr-wrkr         :handle = p-widget-handle then do:  if  scr-agnt        :sensitive then do: apply "entry":u to scr-agnt       . return . end. end.
     5779     if scr-agnt         :handle = p-widget-handle then do:  if  scr-boss        :sensitive then do: apply "entry":u to scr-boss       . return . end. end.
     5780     if scr-boss         :handle = p-widget-handle then do:  if  B-add           :sensitive then do: apply "entry":u to B-add          . return . end. end.
     5781     if  B-add           :handle = p-widget-handle then do:  if  B-exit          :sensitive then do: apply "entry":u to B-exit    .      return . end. end.
     5782     end.
     5783     end.
     5784   END PROCEDURE.
     5785   PROCEDURE openbr :
     5786    do
     5787    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5788    :
     5789   case sort-column-name :
     5790     when "X_ord-line.line-num" then do:
     5791           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.line-num .
     5792     end.
     5793     when "X_goods.gds-code" then do:
     5794           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.gds-code .
     5795     end.
     5796     when "X_ord-line.artic" then do:
     5797           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.artic .
     5798     end.
     5799     when "X_goods.gds-name" then do:
     5800           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.gds-name .
     5801     end.
     5802     when "X_ord-line.qnty" then do:
     5803           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.qnty .
     5804     end.
     5805     when "X_ord-line.price-rubl" then do:
     5806           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.price-rubl .
     5807     end.
     5808     when "X_ord-line.price-base" then do:
     5809           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.price-base .
     5810     end.
     5811     when "X_ord-line.sum-base" then do:
     5812           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.sum-base .
     5813     end.
     5814     when "X_ord-line.sum-rubl" then do:
     5815           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.sum-rubl .
     5816     end.
     5817   otherwise do:
     5818     OPEN QUERY BROWSE-2 FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     5819   end.
     5820   end case.
     5821     end.
     5822   END PROCEDURE.
     5823   PROCEDURE p-delete :
     5824    do
     5825    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5826    :
     5827   define input parameter tmp-recid as recid no-undo .
     5828   define input-output parameter ii as integer no-undo . .
     5829       find first tmp#zakaz where recid(tmp#zakaz) = tmp-recid no-error .
     5830       if not avail tmp#zakaz then return error.
     5831       find first shar_ord-line  exclusive-lock    where
     5832           shar_ord-line.doc-code        = loc-ord-num    and
     5833           shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     5834           shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     5835           shar_ord-line.artic           = tmp#zakaz.artic     no-error.
     5836       if not available shar_ord-line  then  return error .
     5837       delete shar_ord-line .
     5838       delete tmp#zakaz .
     5839       ii = ii - 1 .
     5840     end.
     5841   END PROCEDURE.
     5842   PROCEDURE proc-add :
     5843    do
     5844    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5845    :
     5846   define variable ii as int init 0 no-undo.
     5847   define variable r-tmp as recid no-undo .
     5848   define variable r-ord as recid no-undo .
     5849   define variable r-stop as logical no-undo .
     5850   define variable r-exit as logical no-undo .
     5851   define variable l-g#type as character no-undo .
     5852   define variable l-g#status as character no-undo .
     5853   define variable t-ret as logical no-undo .
     5854   define variable varschartic       like ub.price-list.artic initial " " no-undo.
     5855   define variable v-ref-list  as char                     no-undo.
     5856   define buffer buf_ord-line for ub.ord-line  .
     5857       run str/chsgdsls.w (
     5858           parParentProc ,
     5859           input "order" + 'ПО':U,
     5860           input "Строка документа № " + loc-ord-num , ? , ? ,
     5861           input v-cntxt-host-code-obj,
     5862           input-output varschartic,
     5863           output v-ref-list,
     5864           output table tt-gds-list,
     5865           false
     5866           ) no-error.
     5867       if error-status :error then do:
     5868       message vss-workfile vss-revision vss-description skip
     5869              "Ошибка procedure chsgdsls.w " skip
     5870               skip
     5871               error-status :get-message(1) skip
     5872               return-value skip
     5873               view-as alert-box error
     5874       .
     5875       return error  .
     5876       end.
     5877       t-ret =  session:set-wait-state("general") .
     5878       line-mode = 'ДОБАВЛЕНИЕ':U .
     5879       for each tt-gds-list no-lock :
     5880         ii = ii + 1 .
     5881         if ii > 1 then assign line-mode = "ЦИКЛ":u.
     5882         find first  buf_ord-line  exclusive-lock      where
     5883                     buf_ord-line.gds-code = tt-gds-list.gds-code  and
     5884                     buf_ord-line.doc-code = loc-ord-num
     5885                     no-error .
     5886               if available buf_ord-line then do:
     5887                   run cus/ord-frmp.w (parParentProc , input ?  , input recid ( buf_ord-line)  , input 'ИЗМЕНЕНИЕ':U,  output r-stop , output r-exit ) no-error .
     5888               end.
     5889               else do:
     5890                   run create-tmp in this-procedure  ( input "tt-gds-list":u , input  false , output r-tmp , output r-ord).
     5891                   run cus/ord-frmp.w ( parParentProc ,input r-tmp  , input r-ord  , input line-mode,  output r-stop , output r-exit ) .
     5892                       if r-stop then do:
     5893                         run p-delete ( r-tmp , input-output ii).
     5894                         leave.
     5895                       end.
     5896                       if r-exit then do:
     5897                           run p-delete ( r-tmp , input-output ii ) .
     5898                       end.
     5899             end.
     5900       end.
     5901       Run OpenBr.
     5902       t-ret =  session:set-wait-state("") .
     5903       message "Добавлено " + string(ii) + " товаров".
     5904     end.
     5905   END PROCEDURE.
     5906   PROCEDURE proc-renum :
     5907    do
     5908    on error undo, return error return-value
     5909    :
     5910   define variable g-ok as logical no-undo .
     5911   define variable g as integer no-undo .
     5912   define buffer buf_ord-line for ub.ord-line.
     5913    message " Перенумеровать список товаров ? "
     5914       view-as alert-box question
     5915       buttons yes-no
     5916       UPDATE g-ok
     5917       .
     5918       if g-ok = false then return.
     5919       g = 0 .
     5920       for each buf_ord-line  exclusive-lock  where buf_ord-line.doc-code = loc-ord-num  by buf_ord-line.line-num :
     5921           g = g + 1.
     5922           buf_ord-line.line-num = g.
     5923       end.
     5924       run openbr.
     5925    end.
     5926   END PROCEDURE.
     5927   PROCEDURE recalc-head :
     5928    do
     5929    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5930    :
     5931   define buffer buf_ord-line for ub.ord-line.
     5932   define variable s-1 as decimal init 0 no-undo .
     5933   define variable s-2 as decimal init 0 no-undo .
     5934   define variable s-0 as decimal init 0 no-undo .
     5935        assign frame Dialog-Frame
     5936        scr-ship-date
     5937   .
     5938   for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     5939       s-1  = s-1  + buf_ord-line.sum-rubl .
     5940       s-2  = s-2  + buf_ord-line.sum-base .
     5941       s-0  = s-0  + buf_ord-line.qnty     .
     5942   end.
     5943   assign
     5944     scr-sum-qnty = s-0
     5945     scr-sum-rubl = s-1
     5946     scr-sum-base = s-2
     5947   .
     5948   display
     5949    scr-sum-qnty
     5950    scr-sum-rubl
     5951    scr-sum-base
     5952    with frame Dialog-Frame .
     5953     end.
     5954   END PROCEDURE.
     5955   PROCEDURE step-next :
     5956    do
     5957    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5958    :
     5959     if valid-handle (br-handle) then do:
     5960     v-log = br-handle:select-next-row () no-error .
     5961     if error-status :error then do:
     5962        message "Это режим просмотра одного документа." .
     5963        v-log = false .
     5964        end.
     5965     if not v-log then message "Это последний документ списка.".
     5966   end.
     5967       p-ord-doc-recid = recid ( buf-po_ord-doc ).
     5968       next-prev = yes.
     5969     end.
     5970   END PROCEDURE.
     5971   PROCEDURE step-prev :
     5972    do
     5973    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5974    :
     5975     if valid-handle (br-handle) then do:
     5976     v-log = br-handle:select-prev-row() no-error .
     5977     if error-status :error then do:
     5978        message "Это режим просмотра одного документа." .
     5979        v-log = false .
     5980     end.
     5981     if not v-log then do: message "Это первый документ списка.".   end.
     5982   end.
     5983   p-ord-doc-recid = recid (buf-po_ord-doc).
     5984   next-prev = yes .
     5985     end.
     5986   END PROCEDURE.
     5987   PROCEDURE x-delete :
     5988    do
     5989    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5990    :
     5991   define input parameter p-recid as recid no-undo .
     5992   define input-output parameter ii as integer no-undo . .
     5993       find first shar_ord-line  exclusive-lock  where recid(shar_ord-line) = p-recid  .
     5994       if not available shar_ord-line  then  return error .
     5995       find first tmp#zakaz   where
     5996                   tmp#zakaz.prod-type = shar_ord-line.prod-type         and
     5997                   tmp#zakaz.prod-code = shar_ord-line.prod-code         and
     5998                   tmp#zakaz.artic     = shar_ord-line.artic             no-error.
     5999       if  avail tmp#zakaz then delete tmp#zakaz .
     6000       delete shar_ord-line .
     6001       ii = ii - 1 .
     6002     end.
     6003   END PROCEDURE.
     6004   FUNCTION f-zapr-qnty RETURNS decimal
     6005     ( buffer buf_ord-line for ub.ord-line , par-type as char ) :
     6006   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv .
     6007   define buffer buf_ord-line-rcv for ub.ord-line-rcv .
     6008   define buffer buf_doc-line     for ub.doc-line .
     6009   define buffer buf_trn-doc      for ub.trn-doc  .
     6010   define variable  res as decimal no-undo init 0 .
     6011   for each buf_ord-line-rcv no-lock
     6012       where buf_ord-line-rcv.doc-code  = buf_ord-line.doc-code  and
     6013             buf_ord-line-rcv.artic     = buf_ord-line.artic     and
     6014             buf_ord-line-rcv.prod-type = buf_ord-line.prod-type and
     6015             buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     6016             on error undo, return error :
     6017             find first buf_ord-doc-rcv no-lock where
     6018                       buf_ord-doc-rcv.rcv-code  = buf_ord-line-rcv.rcv-code  and
     6019                       buf_ord-doc-rcv.doc-code  = buf_ord-line-rcv.doc-code  no-error .
     6020                       if error-status :error then next .
     6021           for each ub.ord-chain no-lock where
     6022                     ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     6023                     ub.ord-chain.doc-type = 'rcv'                  and
     6024                     ub.ord-chain.rel-doc-type = 'trn'
     6025                     :
     6026                   find first buf_trn-doc no-lock  where
     6027                             buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code and
     6028                             buf_trn-doc.doc-type = par-type
     6029                                       no-error .
     6030                   if not available buf_trn-doc then next .
     6031                   if buf_trn-doc.doc-type = 'при':U then
     6032                     if buf_trn-doc.status_ <>  'запрос':U then next.
     6033                   find first buf_doc-line no-lock where
     6034                             buf_doc-line.doc-code  = buf_trn-doc.doc-code  and
     6035                             buf_doc-line.artic     = buf_ord-line.artic     and
     6036                             buf_doc-line.prod-type = buf_ord-line.prod-type and
     6037                             buf_doc-line.prod-code = buf_ord-line.prod-code  no-error .
     6038                             if error-status :error then next .
     6039                   res  = res  + buf_doc-line.fact-qnty .
     6040           end.
     6041   end.
     6042     RETURN res .
     6043   END FUNCTION.
