     3460   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3461   on help of frame Dialog-Frame
     3462   do:
     3463     run gbl/app_help.p
     3464       (input this-procedure :file-name
     3465       ,input ''
     3466       ,input ?
     3467       ) no-error.
     3468     if error-status :error then do:
     3469       message
     3470         "Ошибка при вызове помощи"
     3471         error-status :get-message(1)
     3472         view-as alert-box .
     3473     end.
     3474   end.
     3475   run minbtn-set in this-procedure .
     3476   on choose of b-help in frame Dialog-Frame
     3477   do:
     3478     apply "help":u to frame Dialog-Frame .
     3479   end.
     3480   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3481   procedure minbtn-set :
     3482       do
     3483           on error undo, return error return-value
     3484           :
     3485           define variable ii              as integer       no-undo .
     3486           define variable fh              as widget-handle no-undo .
     3487           define variable hh              as widget-handle no-undo .
     3488           define variable v-h             as handle        extent 4 no-undo .
     3489           define variable v-name-button   as character     no-undo .
     3490           define variable v-help-old-x    as decimal       no-undo .
     3491           define variable v-help-old-y    as decimal       no-undo .
     3492           define variable v-help-old-size as decimal       no-undo .
     3493           define variable v-frame-width   as decimal       no-undo .
     3494           define variable jj              as integer       no-undo .
     3495           do
     3496               on error undo, return error
     3497               :
     3498               assign
     3499                   v-frame-width = frame Dialog-Frame:width - 0.3
     3500                   fh            = frame Dialog-Frame:first-child
     3501                   hh            = fh:first-child
     3502                   ii            = 1
     3503                   .
     3504               do while valid-handle(hh):
     3505                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3506                   do:
     3507                       case lc(hh:name) :
     3508                           when "b-help" then
     3509                               do:
     3510                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3511                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3512                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3513                                   hh:TOOLTIP = "Помощь" .
     3514                                   v-help-old-x = hh:column .
     3515                                   v-help-old-y = hh:row    .
     3516                                   v-help-old-size = hh:width .
     3517                                   hh:width-chars = 2.5 .
     3518                               end.
     3519                           when "b-print" then
     3520                               do:
     3521                                   hh:load-image("cmp/b-print.bmp":u) .
     3522                                   hh:TOOLTIP = "Печать" .
     3523                                   v-h[ii] = hh:handle .
     3524                                   ii = ii + 1 .
     3525                                   hh:width-chars = 3 .
     3526                               end.
     3527                           when "b-history" or
     3528                           when "b-hist" then
     3529                               do:
     3530                                   hh:load-image("cmp/b-hist.bmp":u) .
     3531                                   hh:TOOLTIP = "История" .
     3532                                   v-h[ii] = hh:handle .
     3533                                   ii = ii + 1 .
     3534                                   hh:width-chars = 3 .
     3535                               end.
     3536                           when "b-sch" then
     3537                               do:
     3538                                   hh:load-image("cmp/b-sch.bmp":u) .
     3539                                   hh:TOOLTIP = "Установка Фильтра" .
     3540                                   v-h[ii] = hh:handle .
     3541                                   ii = ii + 1 .
     3542                                   hh:width-chars = 3 .
     3543                               end.
     3544                           when "b-hist-user" then
     3545                               do:
     3546                                   hh:load-image("cmp/b-hist.bmp":u) .
     3547                                   hh:TOOLTIP = "История пользователя" .
     3548                                   ii = ii + 1 .
     3549                               end.
     3550                       end case.
     3551                   end.
     3552                   hh = hh:next-sibling.
     3553               end.
     3554               b-help:column = v-frame-width - b-help:width-chars.
     3555               jj = 0.
     3556               repeat ii = 4 to 1 by -1 :
     3557                   if valid-handle (v-h[ii] ) then
     3558                   do:
     3559                       jj  = jj + 1 .
     3560                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3561                       v-h[ii]:row    = v-help-old-y .
     3562                   end.
     3563               end.
     3564           end.
     3565       end.
     3566   end procedure.
     3567   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3568   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3569   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3570   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3571   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3572   define variable v-diasize-current-frame-height as decimal   no-undo .
     3573   define variable v-diasize-change-size          as logical   no-undo .
     3574   define variable v-diasize-resize-button        as handle    no-undo .
     3575   define variable v-diasize-wndmax               as logical   no-undo .
     3576   define variable v-diasize-wndstore             as logical   no-undo .
     3577   define variable v-diasize-proc-name            as character no-undo .
     3578   define variable v-diasize-browse-handle        as handle    no-undo .
     3579   define variable v-diasize-browse-number        as integer   no-undo .
     3580   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3581   define temp-table temp-diasize-handle no-undo
     3582     field handle-value  as handle
     3583     field save-position as decimal
     3584     index xpk is primary unique handle-value
     3585     .
     3586   define temp-table temp-browse-handle no-undo
     3587     field browse-type   as character
     3588     field browse-number as integer
     3589     field browse-handle as handle
     3590     field original-size as decimal
     3591     index xpk is primary unique browse-type browse-number
     3592     index xie browse-type browse-handle
     3593   .
     3594   procedure diasize_change-height :
     3595     define input  parameter p-change-value  as decimal   no-undo .
     3596     define input  parameter p-move-resize   as logical   no-undo .
     3597     define variable v-field-group-handle    as handle    no-undo .
     3598     define variable v-object-handle         as handle    no-undo .
     3599     define variable v-frame-height          as decimal   no-undo .
     3600     define variable v-frame-virtual-height  as decimal   no-undo .
     3601     define variable v-browse-height         as decimal   no-undo .
     3602     define variable v-window-height         as decimal   no-undo .
     3603     define variable v-window-virtual-height as decimal   no-undo .
     3604     define variable v-change-sign           as integer   no-undo .
     3605     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3606     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3607     if p-change-value > 0
     3608     then do:
     3609       if frame Dialog-Frame :height + p-change-value
     3610           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3611       then do:
     3612         assign
     3613           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3614                           - (frame Dialog-Frame :height-chars)
     3615         .
     3616         if p-change-value <= 0
     3617         then do:
     3618           run diasize_position-resize-button in this-procedure .
     3619           return .
     3620         end.
     3621       end.
     3622     end.
     3623     if p-change-value < 0
     3624     then do:
     3625       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3626       then do:
     3627         assign
     3628           p-change-value = v-diasize-orig-frame-height
     3629                          - (frame Dialog-Frame :height-chars)
     3630         .
     3631         if p-change-value >= 0
     3632         then do:
     3633           run diasize_position-resize-button in this-procedure .
     3634           return .
     3635         end.
     3636       end.
     3637     end.
     3638     if p-change-value >= 0
     3639     then do:
     3640       assign
     3641         v-change-sign = 1
     3642       .
     3643     end.
     3644     else do:
     3645       assign
     3646         v-change-sign = -1
     3647       .
     3648     end.
     3649     assign
     3650       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3651     .
     3652     if p-change-value = 0
     3653     then do:
     3654       run diasize_position-resize-button in this-procedure .
     3655       return .
     3656     end.
     3657     move_block:
     3658     do
     3659     on error undo move_block, retry move_block
     3660     :
     3661       if retry
     3662       then do:
     3663         do
     3664         on error undo move_block, leave move_block
     3665         :
     3666           if p-change-value > 0
     3667           then do:
     3668             for each buf_temp-diasize-handle
     3669             on error undo, next
     3670             :
     3671               assign
     3672                 v-object-handle = buf_temp-diasize-handle.handle-value
     3673               .
     3674               if v-object-handle <> v-diasize-resize-button
     3675               then do:
     3676                 assign
     3677                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3678                 .
     3679               end.
     3680             end.
     3681             assign
     3682               v-diasize-browse-handle :height = v-browse-height
     3683             .
     3684             for each buf_temp-browse-handle
     3685               where buf_temp-browse-handle.browse-type = 'height':u
     3686             on error undo, next
     3687             :
     3688               assign
     3689                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3690               .
     3691             end.
     3692             assign
     3693               frame Dialog-Frame :height = v-frame-height
     3694             .
     3695             if frame Dialog-Frame :scrollable = true
     3696             then do:
     3697               assign
     3698                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3699               .
     3700             end.
     3701             run diasize_position-resize-button in this-procedure .
     3702           end.
     3703           else do:
     3704             if frame Dialog-Frame :scrollable = true
     3705             then do:
     3706               assign
     3707                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3708               .
     3709             end.
     3710             assign
     3711               frame Dialog-Frame :height = v-frame-height
     3712             .
     3713             assign
     3714               v-diasize-browse-handle :height = v-browse-height
     3715             .
     3716             for each buf_temp-browse-handle
     3717               where buf_temp-browse-handle.browse-type = 'height':u
     3718             on error undo, next
     3719             :
     3720               assign
     3721                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3722               .
     3723             end.
     3724             for each buf_temp-diasize-handle
     3725             on error undo, next
     3726             :
     3727               assign
     3728                 v-object-handle = buf_temp-diasize-handle.handle-value
     3729               .
     3730               if v-object-handle <> v-diasize-resize-button
     3731               then do:
     3732                 assign
     3733                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3734                 .
     3735               end.
     3736             end.
     3737             run diasize_position-resize-button in this-procedure .
     3738           end.
     3739           assign
     3740             v-diasize-change-size = false
     3741           .
     3742           leave move_block .
     3743         end.
     3744       end.
     3745       assign
     3746         v-diasize-need-full-display = true
     3747       .
     3748       if v-diasize-change-size = false
     3749       then do:
     3750         assign
     3751           v-diasize-change-size = true
     3752         .
     3753       end.
     3754       else do:
     3755         return .
     3756       end.
     3757       assign
     3758         v-frame-height = frame Dialog-Frame :height
     3759         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3760         v-browse-height = v-diasize-browse-handle :height
     3761       .
     3762       for each buf_temp-browse-handle
     3763         where buf_temp-browse-handle.browse-type = 'height':u
     3764       :
     3765         assign
     3766           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3767         .
     3768       end.
     3769       for each buf_temp-diasize-handle
     3770       :
     3771         delete buf_temp-diasize-handle .
     3772       end.
     3773       assign
     3774         v-field-group-handle = frame Dialog-Frame :first-child
     3775       .
     3776       do while valid-handle(v-field-group-handle)
     3777       :
     3778         assign
     3779           v-object-handle = v-field-group-handle :first-child
     3780         .
     3781         do while valid-handle(v-object-handle)
     3782         :
     3783           if  v-object-handle <> v-diasize-browse-handle :handle
     3784           and can-query(v-object-handle, "row")
     3785           and can-query(v-object-handle, "height")
     3786           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3787           then do:
     3788             find first buf_temp-browse-handle
     3789               where buf_temp-browse-handle.browse-type   = 'height':u
     3790                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3791               no-error .
     3792             if available buf_temp-browse-handle
     3793             then do:
     3794             end.
     3795             else do:
     3796               create buf_temp-diasize-handle .
     3797               assign
     3798                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3799                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3800               .
     3801             end.
     3802           end.
     3803           assign
     3804             v-object-handle = v-object-handle :next-sibling
     3805           .
     3806         end.
     3807         assign
     3808           v-field-group-handle = v-field-group-handle :next-sibling
     3809         .
     3810       end.
     3811       do with frame Dialog-Frame
     3812       :
     3813         hide v-diasize-resize-button .
     3814         assign
     3815           v-diasize-resize-button :row    = 1
     3816           v-diasize-resize-button :column = 1
     3817         .
     3818       end.
     3819       if p-change-value > 0
     3820       then do:
     3821         if frame Dialog-Frame :scrollable = true
     3822         then do:
     3823           assign
     3824             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3825             no-error .
     3826           if error-status :error
     3827           or error-status :get-message(1) <> ""
     3828           then do:
     3829             undo move_block, retry move_block .
     3830           end.
     3831         end.
     3832         assign
     3833           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3834           no-error .
     3835         if error-status :error
     3836         or error-status :get-message(1) <> ""
     3837         then do:
     3838           undo move_block, retry move_block .
     3839         end.
     3840         assign
     3841           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3842           no-error .
     3843         if error-status :error
     3844         or error-status :get-message(1) <> ""
     3845         then do:
     3846           undo move_block, retry move_block .
     3847         end.
     3848         for each buf_temp-browse-handle
     3849           where buf_temp-browse-handle.browse-type = 'height':u
     3850         on error undo move_block, retry move_block
     3851         :
     3852           assign
     3853             buf_temp-browse-handle.browse-handle :height
     3854               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3855             no-error .
     3856           if error-status :error
     3857           or error-status :get-message(1) <> ""
     3858           then do:
     3859             undo move_block, retry move_block .
     3860           end.
     3861         end.
     3862         for each buf_temp-diasize-handle
     3863         on error undo move_block, retry move_block
     3864         :
     3865           assign
     3866             v-object-handle = buf_temp-diasize-handle.handle-value
     3867           .
     3868           if v-object-handle <> v-diasize-resize-button
     3869           then do:
     3870             assign
     3871               v-object-handle :row = v-object-handle :row + p-change-value
     3872               no-error .
     3873             if error-status :error
     3874             or error-status :get-message(1) <> ""
     3875             then do:
     3876               undo move_block, retry move_block .
     3877             end.
     3878           end.
     3879         end.
     3880       end.
     3881       else do:
     3882         for each buf_temp-diasize-handle
     3883         on error undo move_block, retry move_block
     3884         :
     3885           assign
     3886             v-object-handle = buf_temp-diasize-handle.handle-value
     3887           .
     3888           if v-object-handle <> v-diasize-resize-button
     3889           then do:
     3890             assign
     3891               v-object-handle :row = v-object-handle :row + p-change-value
     3892               no-error .
     3893             if error-status :error
     3894             or error-status :get-message(1) <> ""
     3895             then do:
     3896               undo move_block, retry move_block .
     3897             end.
     3898           end.
     3899         end.
     3900         assign
     3901           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3902           no-error .
     3903         if error-status :error
     3904         or error-status :get-message(1) <> ""
     3905         then do:
     3906           undo move_block, retry move_block .
     3907         end.
     3908         for each buf_temp-browse-handle
     3909           where buf_temp-browse-handle.browse-type = 'height':u
     3910         on error undo move_block, retry move_block
     3911         :
     3912           assign
     3913             buf_temp-browse-handle.browse-handle :height
     3914               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3915             no-error .
     3916           if error-status :error
     3917           or error-status :get-message(1) <> ""
     3918           then do:
     3919             undo move_block, retry move_block .
     3920           end.
     3921         end.
     3922         assign
     3923           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3924           no-error .
     3925         if error-status :error
     3926         or error-status :get-message(1) <> ""
     3927         then do:
     3928           undo move_block, retry move_block .
     3929         end.
     3930         if frame Dialog-Frame :scrollable = true
     3931         then do:
     3932           assign
     3933             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3934             no-error .
     3935           if error-status :error
     3936           or error-status :get-message(1) <> ""
     3937           then do:
     3938             undo move_block, retry move_block .
     3939           end.
     3940         end.
     3941       end.
     3942       if p-move-resize = true
     3943       then do:
     3944         run diasize_position-resize-button in this-procedure .
     3945       end.
     3946       if v-diasize-wndstore = true
     3947       then do:
     3948         if connected("ub") = true
     3949         then do:
     3950           define variable v-cntxt-db-num        as integer   no-undo .
     3951           define variable v-cntxt-userid        as character no-undo .
     3952           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3953                                             , OUTPUT v-cntxt-userid
     3954                                             ) .
     3955           run gbl/wndsizew.p
     3956             (input  v-cntxt-db-num
     3957             ,input  v-cntxt-userid
     3958             ,input  v-diasize-proc-name
     3959             ,input  'height':u
     3960             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3961             ) .
     3962         end.
     3963       end.
     3964     end.
     3965     assign
     3966       v-diasize-change-size = false
     3967     .
     3968   end procedure.
     3969   procedure diasize_set-height :
     3970     define input  parameter p-new-height  as decimal   no-undo .
     3971     define input  parameter p-move-resize as logical   no-undo .
     3972     do
     3973     on error undo, return error return-value
     3974     :
     3975       run diasize_change-height in this-procedure
     3976         (input  (p-new-height - frame Dialog-Frame :height)
     3977         ,input  p-move-resize
     3978         ) .
     3979     end.
     3980   end procedure.
     3981   procedure diasize_change-width :
     3982     define input  parameter p-change-value as decimal   no-undo .
     3983     define input  parameter p-move-resize  as logical   no-undo .
     3984     define variable v-field-group-handle   as handle    no-undo .
     3985     define variable v-object-handle        as handle    no-undo .
     3986     define variable v-frame-width          as decimal   no-undo .
     3987     define variable v-frame-virtual-width  as decimal   no-undo .
     3988     define variable v-browse-width         as decimal   no-undo .
     3989     define variable v-window-width         as decimal   no-undo .
     3990     define variable v-window-virtual-width as decimal   no-undo .
     3991     define variable v-change-sign          as integer   no-undo .
     3992     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3993     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3994     if p-change-value > 0
     3995     then do:
     3996       if frame Dialog-Frame :width + p-change-value >
     3997           session :width-chars
     3998       then do:
     3999         assign
     4000           p-change-value = session :width-chars - frame Dialog-Frame :width
     4001         .
     4002         if p-change-value <= 0
     4003         then do:
     4004           run diasize_position-resize-button in this-procedure .
     4005           return .
     4006         end.
     4007       end.
     4008     end.
     4009     if p-change-value < 0
     4010     then do:
     4011       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4012       then do:
     4013         assign
     4014           p-change-value = v-diasize-orig-frame-width
     4015                          - frame Dialog-Frame :width
     4016         .
     4017         if p-change-value >= 0
     4018         then do:
     4019           run diasize_position-resize-button in this-procedure .
     4020           return .
     4021         end.
     4022       end.
     4023     end.
     4024     if p-change-value >= 0
     4025     then do:
     4026       assign
     4027         v-change-sign = 1
     4028       .
     4029     end.
     4030     else do:
     4031       assign
     4032         v-change-sign = -1
     4033       .
     4034     end.
     4035     assign
     4036       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4037     .
     4038     if p-change-value = 0
     4039     then do:
     4040       run diasize_position-resize-button in this-procedure .
     4041       return .
     4042     end.
     4043     move_block:
     4044     do
     4045     on error undo move_block, leave move_block
     4046     :
     4047       if retry
     4048       then do:
     4049         do
     4050         on error undo move_block, leave move_block
     4051         :
     4052           if p-change-value > 0
     4053           then do:
     4054             for each buf_temp-diasize-handle
     4055             on error undo, next
     4056             :
     4057               assign
     4058                 v-object-handle = buf_temp-diasize-handle.handle-value
     4059               .
     4060               if v-object-handle <> v-diasize-resize-button
     4061               then do:
     4062                 assign
     4063                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4064                 .
     4065               end.
     4066             end.
     4067             assign
     4068               v-diasize-browse-handle :width = v-browse-width
     4069             .
     4070             for each buf_temp-browse-handle
     4071               where buf_temp-browse-handle.browse-type = 'width':u
     4072             on error undo, next
     4073             :
     4074               assign
     4075                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4076               .
     4077             end.
     4078             assign
     4079               frame Dialog-Frame :width = v-frame-width
     4080             .
     4081             if frame Dialog-Frame :scrollable = true
     4082             then do:
     4083               assign
     4084                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4085               .
     4086             end.
     4087             run diasize_position-resize-button in this-procedure .
     4088           end.
     4089           else do:
     4090             if frame Dialog-Frame :scrollable = true
     4091             then do:
     4092               assign
     4093                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4094               .
     4095             end.
     4096             assign
     4097               frame Dialog-Frame :width = v-frame-width
     4098             .
     4099             for each buf_temp-browse-handle
     4100               where buf_temp-browse-handle.browse-type = 'width':u
     4101             on error undo, next
     4102             :
     4103               assign
     4104                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4105               .
     4106             end.
     4107             assign
     4108               v-diasize-browse-handle :width = v-browse-width
     4109             .
     4110             for each buf_temp-diasize-handle
     4111             on error undo, next
     4112             :
     4113               assign
     4114                 v-object-handle = buf_temp-diasize-handle.handle-value
     4115               .
     4116               if v-object-handle <> v-diasize-resize-button
     4117               then do:
     4118                 assign
     4119                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4120                 .
     4121               end.
     4122             end.
     4123             run diasize_position-resize-button in this-procedure .
     4124           end.
     4125           assign
     4126             v-diasize-change-size = false
     4127           .
     4128           leave move_block .
     4129         end.
     4130       end.
     4131       assign
     4132         v-diasize-need-full-display = true
     4133       .
     4134       if v-diasize-change-size = false
     4135       then do:
     4136         assign
     4137           v-diasize-change-size = true
     4138         .
     4139       end.
     4140       else do:
     4141         return .
     4142       end.
     4143       assign
     4144         v-frame-width = frame Dialog-Frame :width
     4145         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4146         v-browse-width = v-diasize-browse-handle :width
     4147       .
     4148       for each buf_temp-browse-handle
     4149         where buf_temp-browse-handle.browse-type = 'width':u
     4150       :
     4151         assign
     4152           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4153         .
     4154       end.
     4155       for each buf_temp-diasize-handle
     4156       :
     4157         delete buf_temp-diasize-handle .
     4158       end.
     4159       assign
     4160         v-field-group-handle = frame Dialog-Frame :first-child
     4161       .
     4162       do while valid-handle(v-field-group-handle)
     4163       :
     4164         assign
     4165           v-object-handle = v-field-group-handle :first-child
     4166         .
     4167         do while valid-handle(v-object-handle)
     4168         :
     4169           if  v-object-handle <> v-diasize-browse-handle :handle
     4170           and v-object-handle <> v-diasize-resize-button
     4171           and can-query(v-object-handle, "row")
     4172           and can-query(v-object-handle, "height")
     4173           and ( v-object-handle :col + v-object-handle :width
     4174                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4175               )
     4176           then do:
     4177             find first buf_temp-browse-handle
     4178               where buf_temp-browse-handle.browse-type   = 'width':u
     4179                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4180               no-error .
     4181             if available buf_temp-browse-handle
     4182             then do:
     4183             end.
     4184             else do:
     4185               create buf_temp-diasize-handle .
     4186               assign
     4187                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4188                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4189               .
     4190             end.
     4191           end.
     4192           assign
     4193             v-object-handle = v-object-handle :next-sibling
     4194           .
     4195         end.
     4196         assign
     4197           v-field-group-handle = v-field-group-handle :next-sibling
     4198         .
     4199       end.
     4200       do with frame Dialog-Frame
     4201       :
     4202         hide v-diasize-resize-button .
     4203         v-diasize-resize-button :row = 1.
     4204         v-diasize-resize-button :column = 1.
     4205       end.
     4206       if p-change-value > 0
     4207       then do:
     4208         if frame Dialog-Frame :scrollable = true
     4209         then do:
     4210           assign
     4211             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4212             no-error .
     4213           if error-status :error
     4214           or error-status :get-message(1) <> ""
     4215           then do:
     4216             undo move_block, retry move_block.
     4217           end.
     4218         end.
     4219         assign
     4220           frame Dialog-Frame :width = v-frame-width + p-change-value
     4221           no-error .
     4222         if error-status :error
     4223         or error-status :get-message(1) <> ""
     4224         then do:
     4225           undo move_block, retry move_block.
     4226         end.
     4227         assign
     4228           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4229         no-error .
     4230         if error-status :error
     4231         or error-status :get-message(1) <> ""
     4232         then do:
     4233           undo move_block, retry move_block.
     4234         end.
     4235         for each buf_temp-browse-handle
     4236           where buf_temp-browse-handle.browse-type = 'width':u
     4237         on error undo move_block, retry move_block
     4238         :
     4239           assign
     4240             buf_temp-browse-handle.browse-handle :width
     4241               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4242             no-error .
     4243           if error-status :error
     4244           or error-status :get-message(1) <> ""
     4245           then do:
     4246             undo move_block, retry move_block .
     4247           end.
     4248         end.
     4249         for each buf_temp-diasize-handle
     4250         on error undo move_block, retry move_block
     4251         :
     4252           assign
     4253             v-object-handle = buf_temp-diasize-handle.handle-value
     4254           .
     4255           if v-object-handle <> v-diasize-resize-button
     4256           then do:
     4257             assign
     4258               v-object-handle :col = v-object-handle :col + p-change-value
     4259               no-error .
     4260             if error-status :error
     4261             or error-status :get-message(1) <> ""
     4262             then do:
     4263               undo move_block, retry move_block .
     4264             end.
     4265           end.
     4266         end.
     4267       end.
     4268       else do:
     4269         for each buf_temp-diasize-handle
     4270         on error undo move_block, retry move_block
     4271         :
     4272           assign
     4273             v-object-handle = buf_temp-diasize-handle.handle-value
     4274           .
     4275           if v-object-handle <> v-diasize-resize-button
     4276           then do:
     4277             assign
     4278               v-object-handle :col = v-object-handle :col + p-change-value
     4279               no-error .
     4280             if error-status :error
     4281             or error-status :get-message(1) <> ""
     4282             then do:
     4283               undo move_block, retry move_block .
     4284             end.
     4285           end.
     4286         end.
     4287         for each buf_temp-browse-handle
     4288           where buf_temp-browse-handle.browse-type = 'width':u
     4289         on error undo move_block, retry move_block
     4290         :
     4291           assign
     4292             buf_temp-browse-handle.browse-handle :width
     4293               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4294             no-error .
     4295           if error-status :error
     4296           or error-status :get-message(1) <> ""
     4297           then do:
     4298             undo move_block, retry move_block .
     4299           end.
     4300         end.
     4301         assign
     4302           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4303           no-error .
     4304         if error-status :error
     4305         or error-status :get-message(1) <> ""
     4306         then do:
     4307           undo move_block, retry move_block.
     4308         end.
     4309         assign
     4310           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4311         no-error .
     4312         if error-status :error
     4313         or error-status :get-message(1) <> ""
     4314         then do:
     4315           undo move_block, retry move_block.
     4316         end.
     4317         if frame Dialog-Frame :scrollable = true
     4318         then do:
     4319           assign
     4320             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4321           no-error .
     4322           if error-status :error
     4323           or error-status :get-message(1) <> ""
     4324           then do:
     4325             undo move_block, retry move_block.
     4326           end.
     4327         end.
     4328       end.
     4329       if p-move-resize
     4330       then do:
     4331         run diasize_position-resize-button in this-procedure .
     4332       end.
     4333       if v-diasize-wndstore = true
     4334       then do:
     4335         if connected("ub") = true
     4336         then do:
     4337           define variable v-cntxt-db-num        as integer   no-undo .
     4338           define variable v-cntxt-userid        as character no-undo .
     4339           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4340                                             , OUTPUT v-cntxt-userid
     4341                                             ) .
     4342           run gbl/wndsizew.p
     4343             (input  v-cntxt-db-num
     4344             ,input  v-cntxt-userid
     4345             ,input  v-diasize-proc-name
     4346             ,input  'width':u
     4347             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4348             ) .
     4349         end.
     4350       end.
     4351     end.
     4352     assign
     4353       v-diasize-change-size = false
     4354     .
     4355   end procedure.
     4356   procedure diasize_set-width :
     4357     define input  parameter p-new-width  as decimal   no-undo .
     4358     define input  parameter p-move-resize as logical   no-undo .
     4359     do
     4360     on error undo, return error return-value
     4361     :
     4362       run diasize_change-width in this-procedure
     4363         (input  (p-new-width - frame Dialog-Frame :width)
     4364         ,input  p-move-resize
     4365         ) .
     4366     end.
     4367   end procedure.
     4368   procedure diasize_position-resize-button :
     4369     do with frame Dialog-Frame
     4370     :
     4371       hide v-diasize-resize-button .
     4372       assign
     4373         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4374                     - 1
     4375                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4376         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4377                     - 1
     4378                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4379       .
     4380       view v-diasize-resize-button .
     4381     end.
     4382   end procedure.
     4383   on alt-right anywhere
     4384   do:
     4385     run diasize_change-width in this-procedure
     4386       (input 1
     4387       ,input true
     4388       ) .
     4389     return no-apply .
     4390   end.
     4391   on alt-left anywhere
     4392   do:
     4393     run diasize_change-width in this-procedure
     4394       (input -1
     4395       ,input true
     4396       ) .
     4397     return no-apply .
     4398   end.
     4399   on alt-down anywhere
     4400   do:
     4401     run diasize_change-height in this-procedure
     4402       (input 1
     4403       ,input true
     4404       ) .
     4405     return no-apply .
     4406   end.
     4407   on alt-up anywhere
     4408   do:
     4409     run diasize_change-height in this-procedure
     4410       (input -1
     4411       ,input true
     4412       ) .
     4413     return no-apply .
     4414   end.
     4415   on alt-enter of frame Dialog-Frame
     4416   do:
     4417     run diasize_maximize in this-procedure
     4418       (input  ?
     4419       ).
     4420     return no-apply .
     4421   end.
     4422   procedure diasize_end-move :
     4423     do
     4424     on error undo, return error return-value
     4425     :
     4426       define variable v-row-delta as decimal   no-undo .
     4427       define variable v-col-delta as decimal   no-undo .
     4428       define variable v-new-row as decimal   no-undo .
     4429       define variable v-new-col as decimal   no-undo .
     4430       assign
     4431         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4432         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4433       .
     4434       assign
     4435         v-row-delta = v-new-row - frame Dialog-Frame :height
     4436         v-col-delta = v-new-col - frame Dialog-Frame :width
     4437       .
     4438       run diasize_change-height in this-procedure
     4439         (input v-row-delta
     4440         ,input true
     4441         ) .
     4442       run diasize_change-width in this-procedure
     4443         (input v-col-delta
     4444         ,input true
     4445         ) .
     4446     end.
     4447   end procedure.
     4448   procedure diasize_maximize :
     4449     define input  parameter p-action as logical   no-undo .
     4450     do
     4451     on error undo, return error return-value
     4452     :
     4453       if p-action = ?
     4454       then do:
     4455         if v-diasize-need-maximize = true
     4456         then do:
     4457           assign
     4458             p-action = true
     4459           .
     4460         end.
     4461         else do:
     4462           assign
     4463             p-action = false
     4464           .
     4465         end.
     4466       end.
     4467       if p-action = true
     4468       then do:
     4469         run diasize_change-height in this-procedure
     4470           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4471               - frame Dialog-Frame :height-chars
     4472           ,input true
     4473           ) .
     4474         run diasize_change-width in this-procedure
     4475           (input session :width-chars
     4476               - frame Dialog-Frame :width-chars
     4477           ,input true
     4478           ) .
     4479         assign
     4480           v-diasize-need-maximize = false
     4481         .
     4482       end.
     4483       else do:
     4484         run diasize_change-width in this-procedure
     4485           (input v-diasize-orig-frame-width
     4486               - frame Dialog-Frame :width-chars
     4487           ,input true
     4488           ) .
     4489         run diasize_change-height in this-procedure
     4490           (input v-diasize-orig-frame-height
     4491               - frame Dialog-Frame :height-chars
     4492           ,input true
     4493           ) .
     4494         assign
     4495           v-diasize-need-maximize = true
     4496         .
     4497       end.
     4498     end.
     4499   end procedure.
     4500   procedure diasize_restore-orig-size :
     4501     do
     4502     on error undo, return error return-value
     4503     :
     4504       assign
     4505         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4506         v-diasize-current-frame-height = frame Dialog-Frame :height
     4507       .
     4508       run diasize_set-height in this-procedure
     4509         (input  v-diasize-orig-frame-height
     4510         ,input  true
     4511         ) .
     4512       run diasize_set-width in this-procedure
     4513         (input  v-diasize-orig-frame-width
     4514         ,input  true
     4515         ) .
     4516     end.
     4517   end procedure.
     4518   procedure diasize_restore-current-size :
     4519     do
     4520     on error undo, return error return-value
     4521     :
     4522       run diasize_set-height in this-procedure
     4523         (input  v-diasize-current-frame-height
     4524         ,input  true
     4525         ) .
     4526       run diasize_set-width in this-procedure
     4527         (input  v-diasize-current-frame-width
     4528         ,input  true
     4529         ) .
     4530     end.
     4531   end procedure.
     4532   procedure diasize_set-browse-handle :
     4533     define input  parameter p-browse-handle as handle   no-undo .
     4534     define buffer buf_temp-browse-handle for temp-browse-handle .
     4535     do
     4536     on error undo, return error return-value
     4537     :
     4538       assign
     4539         v-diasize-browse-handle = p-browse-handle
     4540       .
     4541       for each buf_temp-browse-handle
     4542       on error undo, return error return-value
     4543       :
     4544         delete buf_temp-browse-handle .
     4545       end.
     4546     end.
     4547   end procedure.
     4548   procedure diasize_add_browse :
     4549     define input  parameter p-browse-type   as character no-undo .
     4550     define input  parameter p-browse-handle as handle    no-undo .
     4551     define buffer buf_temp-browse-handle for temp-browse-handle .
     4552     do
     4553     on error undo, return error return-value
     4554     :
     4555       assign
     4556         v-diasize-browse-number = v-diasize-browse-number + 1
     4557       .
     4558       create buf_temp-browse-handle .
     4559       assign
     4560         buf_temp-browse-handle.browse-type   = p-browse-type
     4561         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4562         buf_temp-browse-handle.browse-handle = p-browse-handle
     4563       .
     4564     end.
     4565   end procedure.
     4566   procedure diasize_init :
     4567     define variable v-default-value    as logical   no-undo .
     4568     define variable v-restore-saved    as logical   no-undo .
     4569     define variable v-resize-value-str as character no-undo .
     4570     do
     4571     on error undo, return error return-value
     4572     :
     4573       do with frame Dialog-Frame
     4574       :
     4575         assign
     4576           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4577           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4578           v-diasize-browse-handle     = browse BROWSE-2 :handle
     4579         .
     4580         create button v-diasize-resize-button
     4581         assign
     4582           parent        = frame Dialog-Frame :first-child
     4583           label         = "s"
     4584           height-pixels = 16
     4585           width-pixels  = 16
     4586           visible       = true
     4587           sensitive     = true
     4588           movable       = true
     4589           triggers:
     4590             on end-move persistent run diasize_end-move in this-procedure .
     4591           end triggers.
     4592         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4593         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4594         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4595         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4596         assign
     4597           v-diasize-wndmax = false
     4598         .
     4599         if connected("ub") = true
     4600         then do:
     4601           define variable v-cntxt-db-num        as integer   no-undo .
     4602           define variable v-cntxt-userid        as character no-undo .
     4603           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4604                                             , OUTPUT v-cntxt-userid
     4605                                             ) .
     4606           run gbl/wndpar_r.p
     4607             (input  v-cntxt-db-num
     4608             ,input  v-cntxt-userid
     4609             ,input  'wndmax':U
     4610             ,output v-diasize-wndmax
     4611             ,output v-default-value
     4612             ) .
     4613         end.
     4614         assign
     4615           v-diasize-wndstore = false
     4616         .
     4617         if connected("ub") = true
     4618         then do:
     4619           run gbl/wndpar_r.p
     4620             (input  v-cntxt-db-num
     4621             ,input  v-cntxt-userid
     4622             ,input  'wndstore':U
     4623             ,output v-diasize-wndstore
     4624             ,output v-default-value
     4625             ) .
     4626         end.
     4627         assign
     4628           v-diasize-proc-name = entry(1, program-name(2), '.')
     4629         .
     4630         if v-diasize-wndstore = true
     4631         then do:
     4632           assign
     4633             v-restore-saved = false
     4634           .
     4635           if connected("ub") = true
     4636           then do:
     4637             run gbl/wndsizer.p
     4638               (input  v-cntxt-db-num
     4639               ,input  v-cntxt-userid
     4640               ,input  v-diasize-proc-name
     4641               ,input  'height':u
     4642               ,output v-resize-value-str
     4643               ) .
     4644             if v-resize-value-str <> '':U
     4645             then do:
     4646               run diasize_change-height in this-procedure
     4647                 (input  integer(v-resize-value-str)
     4648                 ,input  true
     4649                 ) .
     4650               assign
     4651                 v-restore-saved = true
     4652               .
     4653             end.
     4654           end.
     4655           if connected("ub") = true
     4656           then do:
     4657             run gbl/wndsizer.p
     4658               (input  v-cntxt-db-num
     4659               ,input  v-cntxt-userid
     4660               ,input  v-diasize-proc-name
     4661               ,input  'width':u
     4662               ,output v-resize-value-str
     4663               ) .
     4664             if v-resize-value-str <> '':U
     4665             then do:
     4666               run diasize_change-width in this-procedure
     4667                 (input  integer(v-resize-value-str)
     4668                 ,input  true
     4669                 ) .
     4670               assign
     4671                 v-restore-saved = true
     4672               .
     4673             end.
     4674           end.
     4675           if v-restore-saved <> true
     4676           then do:
     4677             if v-diasize-wndmax = true
     4678             then do:
     4679               run diasize_maximize in this-procedure
     4680                 (input  true
     4681                 ) .
     4682             end.
     4683           end.
     4684         end.
     4685         else do:
     4686           if v-diasize-wndmax = true
     4687           then do:
     4688             run diasize_maximize in this-procedure
     4689               (input  true
     4690               ) .
     4691           end.
     4692         end.
     4693       end.
     4694     end.
     4695   end procedure.
     4696   procedure diasize_need-full-display :
     4697     define output parameter p-need-full-display as logical   no-undo .
     4698     do
     4699     on error undo, return error return-value
     4700     :
     4701       assign
     4702         p-need-full-display = v-diasize-need-full-display
     4703       .
     4704       assign
     4705         v-diasize-need-full-display = false
     4706       .
     4707     end.
     4708   end procedure.
     4709   procedure get-context :
     4710      define output parameter p-db-num as integer          no-undo.
     4711      define output parameter p-user-id as character        no-undo.
     4712      define variable v-login               as character    no-undo.
     4713      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4714      define buffer buf_user-login  for ub.user-login .
     4715      do
     4716      on error undo, return error
     4717      :
     4718            FIND FIRST buf_sys-ctrl no-lock.
     4719            ASSIGN
     4720               v-login = USERID("ub")
     4721               p-db-num = buf_sys-ctrl.db-num
     4722            .
     4723            FIND FIRST buf_user-login
     4724                 WHERE buf_user-login.db-num = p-db-num
     4725                   AND buf_user-login.user-login = v-login
     4726                 no-lock
     4727                 no-error
     4728                 .
     4729            IF AVAILABLE buf_user-login
     4730            THEN DO:
     4731               assign
     4732                  p-user-id = buf_user-login.user-id
     4733               .
     4734            END.
     4735      end.
     4736   end procedure.
     4737       run diasize_init in this-procedure .
     4738   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4739   DEF VAR cur-clmn-numBROWSE-2 as INT EXTENT 10 no-undo.
     4740   DEF VAR varmviBROWSE-2       as INT no-undo.
     4741   DEF VAR varmvjBROWSE-2       as INT no-undo.
     4742   DEF VAR varmvkBROWSE-2       as INT no-undo.
     4743   DEF VAR varmvlBROWSE-2       as INT no-undo.
     4744   DEF VAR move-elementBROWSE-2 as INT no-undo.
     4745   def var jjBROWSE-2           as int no-undo.
     4746   do varmviBROWSE-2 = 1 to EXTENT(cur-clmn-numBROWSE-2):
     4747     ASSIGN cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmviBROWSE-2.
     4748   END.
     4749   RUN start-mv-clmnBROWSE-2.
     4750   PROCEDURE start-mv-clmnBROWSE-2:
     4751   def var old-session as logical no-undo.
     4752      old-session = SESSION:IMMEDIATE-DISPLAY.
     4753      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4754      SESSION:IMMEDIATE-DISPLAY = old-session.
     4755   END.
     4756   ON ctrl-cursor-right OF BROWSE BROWSE-2 do:
     4757     RUN re-move-clmnBROWSE-2 ( 1, 10).
     4758   END.
     4759   ON ctrl-cursor-left OF BROWSE BROWSE-2 do:
     4760     RUN re-move-clmnBROWSE-2 (10, 1).
     4761   END.
     4762   PROCEDURE re-move-clmnBROWSE-2:
     4763     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4764     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4765     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4766       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = source-column THEN cur-clmn-numBROWSE-2[varmviBROWSE-2] = -1.
     4767     END.
     4768     if BROWSE-2:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4769     if source-column > target-column THEN
     4770     DO varmvjBROWSE-2 = source-column - 1 to target-column BY -1:
     4771       DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4772           if cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmvjBROWSE-2 THEN DO:
     4773             cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-numBROWSE-2[varmviBROWSE-2] + 1.
     4774           END.
     4775       END.
     4776     END.
     4777     ELSE
     4778     DO varmvjBROWSE-2 = source-column + 1 to target-column:
     4779       DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4780         if cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmvjBROWSE-2 THEN DO:
     4781           cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-numBROWSE-2[varmviBROWSE-2] - 1.
     4782         END.
     4783       END.
     4784     END.
     4785     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4786       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = -1 THEN cur-clmn-numBROWSE-2[varmviBROWSE-2] = target-column.
     4787     END.
     4788   END PROCEDURE.
     4789   PROCEDURE ch-clmnBROWSE-2:
     4790     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4791     if cur-clmn-loc <= 1 then do:
     4792       return .
     4793     end.
     4794     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4795       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-loc THEN move-elementBROWSE-2 = varmviBROWSE-2.
     4796     END.
     4797     RUN re-move-clmnBROWSE-2 (cur-clmn-loc, 1).
     4798   END PROCEDURE.
     4799   PROCEDURE mv-brw-defaultBROWSE-2:
     4800   def var old-session as logical no-undo.
     4801     old-session = SESSION:IMMEDIATE-DISPLAY.
     4802     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4803     do varmvlBROWSE-2 = 1 to EXTENT(cur-clmn-numBROWSE-2):
     4804       RUN re-move-clmnBROWSE-2 (cur-clmn-numBROWSE-2[varmvlBROWSE-2], varmvlBROWSE-2).
     4805     END.
     4806     RUN start-mv-clmnBROWSE-2.
     4807     SESSION:IMMEDIATE-DISPLAY = old-session.
     4808   END PROCEDURE.
     4809   .
     4810   def var sort-labelBROWSE-2   as character no-undo .
     4811   def var sort-clmnBROWSE-2    as handle    no-undo .
     4812   def var cur-clmnBROWSE-2     as handle    no-undo .
     4813   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     4814   def var re-queryBROWSE-2     as logical   initial no no-undo .
     4815   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     4816      run sort-brBROWSE-2
     4817        (input (if available X_ord-line
     4818                then recid(X_ord-line)
     4819                else ?
     4820               )
     4821        ).
     4822   end.
     4823   PROCEDURE sort-brBROWSE-2 :
     4824     define input parameter p-recid as recid no-undo .
     4825     if re-queryBROWSE-2 = no then do:
     4826       assign
     4827          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     4828       .
     4829       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     4830       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     4831         assign
     4832            sort-labelBROWSE-2 = ""
     4833            sort-clmnBROWSE-2 = ?
     4834         .
     4835        end.
     4836        else do:
     4837          assign
     4838            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     4839            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     4840            sort-clmnBROWSE-2:column-fgcolor = 4
     4841          .
     4842        end.
     4843      end.
     4844     assign
     4845       cur-clmn-locBROWSE-2 = 1
     4846     .
     4847     def var column-handle as handle no-undo .
     4848     column-handle = BROWSE-2:first-column.
     4849     do while valid-handle(column-handle) :
     4850       if column-handle = cur-clmnBROWSE-2 then do:
     4851         leave .
     4852       end.
     4853       column-handle = column-handle:NEXT-COLUMN.
     4854       assign
     4855         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     4856       .
     4857     end.
     4858     case sort-labelBROWSE-2:
     4859           when 'N/п'  then DO:   assign     sort-column-name = "X_ord-line.line-num"   .   Run OpenBr.   . END.
     4860           when 'Код товара'  then DO:   assign     sort-column-name = "X_goods.gds-code"   .   Run OpenBr.   . END.
     4861           when 'Артикул'  then DO:   assign     sort-column-name = "X_ord-line.artic"   .   Run OpenBr.   . END.
     4862           when 'Название'  then DO:   assign     sort-column-name = "X_goods.gds-name"   .   Run OpenBr.   . END.
     4863           when 'Количество'  then DO:   assign     sort-column-name = "X_ord-line.qnty"   .   Run OpenBr.   . END.
     4864           when 'Цена(руб)'  then DO:   assign     sort-column-name = "X_ord-line.price-rubl"   .   Run OpenBr.   . END.
     4865           when 'Цена(вал)'  then DO:   assign     sort-column-name = "X_ord-line.price-base"   .   Run OpenBr.   . END.
     4866           when 'Сумма в вал.'  then DO:   assign     sort-column-name = "X_ord-line.sum-base"   .   Run OpenBr.   . END.
     4867           when 'Сумма в руб.'  then DO:   assign     sort-column-name = "X_ord-line.sum-rubl"   .   Run OpenBr.   . END.
     4868           when 'Текущий остаток'  then DO:   assign     sort-column-name = "v-fact-qnty"   .   Run OpenBr.   . END.
     4869       otherwise do:
     4870         assign
     4871           sort-column-name = ""
     4872         .
     4873         Run OpenBr.
     4874           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-2') then do:
     4875             run mv-brw-defaultBROWSE-2.
     4876           end.
     4877         if sort-labelBROWSE-2 <> "" then do:
     4878           assign
     4879             cur-clmnBROWSE-2:column-fgcolor = 0
     4880           .
     4881         end.
     4882         assign
     4883           cur-clmn-locBROWSE-2 = ?
     4884         .
     4885       end.
     4886     end case.
     4887       if cur-clmn-locBROWSE-2 <> ? then do:
     4888         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-2') then do:
     4889           run ch-clmnBROWSE-2 in this-procedure (cur-clmn-locBROWSE-2).
     4890         end.
     4891       end.
     4892     if p-recid <> ? then do:
     4893       reposition BROWSE-2 to recid p-recid no-error.
     4894       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     4895     end.
     4896     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     4897   END PROCEDURE.
     4898   procedure re-open-query-srt-clmnBROWSE-2:
     4899   if cur-clmnBROWSE-2 = ? then do:
     4900      Run OpenBr.
     4901   end.
     4902   else do:
     4903      assign re-queryBROWSE-2 = yes.
     4904      run sort-brBROWSE-2
     4905        (input (if available X_ord-line
     4906                then recid(X_ord-line)
     4907                else ?
     4908               )
     4909        ).
     4910      assign re-queryBROWSE-2 = no.
     4911   end.
     4912   end.
     4913   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4914   on F9 of frame Dialog-Frame anywhere do:
     4915     run init-gds-rec.
     4916     if gds-rec = ? then
     4917       return no-apply.
     4918     run ref/gds-form.w ( input parParentProc
     4919                         ,input 'ПРОСМОТР':U
     4920                         ,input ?
     4921                         ,input ?
     4922                         ,input ?
     4923                         ,input-output gds-rec).
     4924     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     4925     return no-apply.
     4926   end.
     4927   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4928   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
     4929   DO:
     4930      run proc-r-boss in this-procedure .
     4931   END.
     4932   ON LEAVE OF scr-boss IN FRAME Dialog-Frame
     4933   DO:
     4934   run leave-proc-boss in this-procedure .
     4935   END.
     4936   ON  RETURN OF scr-boss IN FRAME Dialog-Frame
     4937   DO:
     4938     run next-focus in this-procedure  (input  scr-boss:handle ) .
     4939     return no-apply .
     4940   END.
     4941   ON MOUSE-SELECT-DBLCLICK OF scr-boss IN FRAME Dialog-Frame
     4942   DO:
     4943     apply "choose" to r-boss in frame Dialog-Frame.
     4944     return no-apply .
     4945   end.
     4946   Procedure proc-r-boss :
     4947    do
     4948    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4949    :
     4950    define variable rid-list    as  char no-undo .
     4951    define variable v-recid as recid no-undo .
     4952    define variable old-types as character no-undo .
     4953    define buffer boss#clients for ub.clients.
     4954       run ref/cli-all.w
     4955       ( input parParentProc, input "b-sel", 'чел':U, ?, ?, ?, ?, ?, output  rid-list).
     4956       Assign
     4957         v-recid = integer(rid-list)
     4958         .
     4959       find first boss#clients no-lock WHERE recid(boss#clients) = v-recid  No-ERROR.
     4960       if avail boss#clients then
     4961           Assign
     4962               scr-boss = boss#clients.obj-code
     4963               scr-boss-name = boss#clients.obj-name
     4964               .
     4965       else
     4966          Assign
     4967             scr-boss-name = ""
     4968             scr-boss = ?
     4969             .
     4970       Display scr-boss scr-boss-name with frame Dialog-Frame .
     4971   end.
     4972   end procedure.
     4973   procedure leave-proc-boss :
     4974    do
     4975    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4976    :
     4977     def buffer buf_clients for ub.clients.
