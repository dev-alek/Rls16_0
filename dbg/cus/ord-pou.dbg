     2213          vt-plt-id = tt_price-all.plt-id
     2214          vt-plt-db = tt_price-all.plt-db-num
     2215          vt-pdf-id = tt_price-all.pdf-id
     2216          vt-pdf-db = tt_price-all.pdf-db
     2217        .
     2218        if tt_price-all.b-code = p-b-code then do:
