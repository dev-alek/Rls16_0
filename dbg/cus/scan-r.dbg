      444        FIELD part-code      LIKE ub.parts.part-code
      445        FIELD rez            as CHARACTER
      446        FIELD err-msg        as CHARACTER
      447        FIELD des            as CHARACTER
      448        FIELD pl-name        AS CHARACTER
      449        FIELD loc1           AS CHARACTER
