        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-rcv-code   like ub.ord-doc-rcv.rcv-code no-undo.
        4   define input parameter p-doc-code   like ub.ord-doc-rcv.doc-code no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: scan-r.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: cus/scan-r.p $":U .
       10   define variable vss-description as character no-undo init "Единая процедура работы с мобильным сканером".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define new global shared variable g#lib-trn  as handle no-undo .
       72   define new global shared variable g#lib-trn2 as handle no-undo .
       73   define new global shared variable g#lib-trn3 as handle no-undo .
       74   define new global shared variable g#lib-trn4 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   procedure last-price :
      302   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      303   define input parameter  p-host-code     as integer no-undo .
      304   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
      305   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
      306   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
      307   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
      308   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
      309   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
      310   define input parameter  p-curr-code  as integer   no-undo .
      311   define output parameter p-price-base like ub.doc-line.price-base no-undo .
      312   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
      313   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
      314   define buffer buf-lib-doc-line for ub.doc-line.
      315   define buffer buf_cli-gds for ub.cli-gds .
      316   define buffer buf_trn-doc for ub.trn-doc  .
      317   define variable vp-curr-code  like ub.trn-doc.exch-code.
      318   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
      319   define variable vp-exch-scale like ub.trn-doc.exch-scale.
      320   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
      321   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
      322   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
      323   define variable v-cli-base-rate as decimal   no-undo .
      324    find first buf_cli-gds no-lock where
      325               buf_cli-gds.cli-type   = p-cli-type    and
      326               buf_cli-gds.cli-code   = p-cli-code    and
      327               buf_cli-gds.host-code  = p-host-code   and
      328               buf_cli-gds.artic      = p-artic       and
      329               buf_cli-gds.prod-type  = p-prod-type   and
      330               buf_cli-gds.prod-code  = p-prod-code
      331               no-error .
      332   if available buf_cli-gds then do:
      333       find first buf_trn-doc no-lock
      334            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
      335        if available buf_trn-doc then do:
      336           vp-curr-code  = buf_trn-doc.exch-code.
      337           vp-exch-rate  = buf_trn-doc.exch-rate.
      338           vp-exch-scale = buf_trn-doc.exch-scale.
      339        end.
      340       find first buf-lib-doc-line no-lock
      341         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
      342           and buf-lib-doc-line.artic     = p-artic
      343           and buf-lib-doc-line.prod-type = p-prod-type
      344           and buf-lib-doc-line.prod-code = p-prod-code
      345         no-error .
      346   end.
      347   else do:
      348   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      350     (input  p-host-code
      351     ,input  p-artic
      352     ,input  p-prod-type
      353     ,input  p-prod-code
      354     ,output v-last-in-code
      355     ,output v-last-obj-type
      356     ,output v-last-obj-code
      357     )  .
      358       find first buf_trn-doc no-lock
      359            where buf_trn-doc.doc-code  = v-last-in-code no-error .
      360        if available buf_trn-doc then do:
      361           vp-curr-code  = buf_trn-doc.exch-code.
      362           vp-exch-rate  = buf_trn-doc.exch-rate.
      363           vp-exch-scale = buf_trn-doc.exch-scale.
      364        end.
      365       find first buf-lib-doc-line no-lock
      366         where buf-lib-doc-line.doc-code  = v-last-in-code
      367           and buf-lib-doc-line.artic     = p-artic
      368           and buf-lib-doc-line.prod-type = p-prod-type
      369           and buf-lib-doc-line.prod-code = p-prod-code
      370         no-error .
      371   end.
      372       if available buf-lib-doc-line then do:
      373         assign
      374           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
      375           p-price-base = buf-lib-doc-line.price-base
      376           p-price-rubl = buf-lib-doc-line.price-rubl
      377           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
      378         .
      379         if v-cli-base-rate <> p-cli-base-rate
      380         then do:
      381             p-price-cli  = p-price-cli / v-cli-base-rate  .
      382         end.
      383          if p-curr-code <> vp-curr-code then do:
      384             p-price-cli  = p-price-rubl  .
      385         end.
      386       end.
      387       Else do:
      388         assign
      389           p-price-base = 0
      390           p-price-rubl = 0
      391           p-price-cli  = 0
      392         .
      393       end.
      394     end.
      395   end procedure.
      396   define variable add-sens as logical init true  no-undo.
