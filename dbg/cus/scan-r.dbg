      482   define stream cur.
      483   define stream log.
      484   define stream err.
      485   define variable scan-txt as char no-undo.
      486   define variable scan-name as char no-undo.
      487   define variable g-type as char no-undo init ?.
      488   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv.
      489   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
      490   define variable is-all as log no-undo.
      491   define variable i as int no-undo.
      492   define variable j as int no-undo.
      493   define variable varerr as logical no-undo.
      494   define variable mess as char no-undo.
      495   define variable glog as logical no-undo .
      496   define frame a
      497       i format ">>>>9"  label "Просмотрено" space (20) skip
      498       j format ">>>>9" label "Обработано"
      499       with view-as dialog-box side-labels three-d title "".
      500   system-dialog get-file scan-txt
      501     title "Выберите файл со сканера"
      502          filters "workabout ms15" "*.dbs",
      503                    "workabout" "*.imp",
      504                    "Инвентаризация с кассы" "*.inv",
      505                    "Текстовые файлы" "*.txt",
      506                    "Все файлы" "*.*"
      507          update glog.
      508   if not glog then return.
      509   if entry (2, scan-txt, ".") = "err" then do:
      510     message "Файл с расширением '.err' не может быть обработан. Переименуйте его.".
      511     return.
      512   end.
      513   message "yes - переписать количество со сканера для всех товаров" skip
      514           "no - прибавить количество со сканера для всех товаров"   skip
      515           "cancel - спрашивать для каждого товара"
      516           view-as alert-box question buttons yes-no-cancel update is-all.
      517   scan-name = entry (1, scan-txt, ".").
      518   frame a:title = "Разбор файла : " + scan-txt.
      519   output stream log to value (scan-name + ".log") append.
      520   output stream err to value (scan-name + ".err") append.
      521   put stream log unformatted "  " skip.
      522   put stream log unformatted cur-time-string-sec() skip.
      523   find first buf_ord-doc-rcv no-lock where
      524              buf_ord-doc-rcv.rcv-code = p-rcv-code and
      525              buf_ord-doc-rcv.doc-code = p-doc-code
      526              no-error.
      527   if error-status :error then return error.
      528   put stream log unformatted " " skip skip
      529           "Документ "     buf_ord-doc-rcv.rcv-code
      530                           buf_ord-doc-rcv.doc-code
      531           " Тип: "        buf_ord-doc-rcv.doc-type
      532           " Статус: "     buf_ord-doc-rcv.status_
      533           " ОК: " string (buf_ord-doc-rcv.flag_, "+/-")
      534                   skip skip.
      535       g-type =  'т':U .
      536   view frame a.
      537   input stream cur from value (scan-txt).
      538     input stream cur from value (scan-txt).
      539     run str/bc-anlz.p
      540        (input parparentproc,
      541         input "file",
      542         input scan-txt,
      543         input yes,
      544         output varerr,
      545         output table in-bc
      546         ) no-error.
      547     if error-status:error then do:
      548        message "Ошибка при обработке файла сканера." skip
      549                error-status:get-message(1)
      550           view-as alert-box error buttons ok.
      551        return error.
      552     end.
      553     if varerr = yes then is-err = yes.
      554     for each in-bc:
      555         if in-bc.rez = "err" then do:
      556            put stream log unformatted in-bc.err-msg skip.
      557            put stream err unformatted in-bc.bar-str skip.
      558            assign is-err = yes.
      559         end.
      560         if in-bc.des <> "" and in-bc.des <> ? then put stream log unformatted in-bc.des.
      561     end.
      562     for each un-bc:
      563         if un-bc.rez = "err" then do:
      564            put stream log unformatted un-bc.err-msg skip.
      565            put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
      566            assign is-err = yes.
      567         end.
      568     end.
      569     i = 0 .
      570     j = 0 .
      571     for each main-bc:
      572       i = i + 1.
      573       disp i with frame a.
      574       find ub.bar-code where ub.bar-code.b-code = main-bc.b-c no-lock.
      575       find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code no-lock.
      576         assign bar-str  = string(main-bc.b-c)
      577                qnty-str = string(main-bc.scn-qnty)
      578                rate     = 1
      579                pl-str   = main-bc.scn-pl
      580                mess     = main-bc.des
      581                p-price  = decimal(main-bc.scn-pl)
      582                .
      583         run proc-code in this-procedure  ( input main-bc.nm
      584                                           ,input ""
      585                                           ) no-error.
      586         if error-status:error then do:
      587            assign is-err = yes.
      588         end.
      589     end.
      590   message 'Просмотрено :' i skip
      591           'Обработано  :' j skip
      592           'Несовпадений по ассортименту:' v-ord  skip
      593           'Несовпадений по количеству:  ' v-qnty
      594           if v-ord > 0 or v-qnty  > 0 then "Подробнее см в СОСТОЯНИЕ ЗАКАЗА" else ""
      595           .
      596   if is-err then
      597       message "Во время загрузки файла:" scan-txt "обнаружены ошибки." skip
      598               "Смотрите log файл."
      599       view-as alert-box error buttons ok.
      600   procedure proc-code :
      601   define input  parameter n-pp   as integer no-undo .
      602   define input  parameter mode-proc as CHAR NO-UNDO.
      603   define buffer b-bar-code for ub.bar-code.
      604   define buffer pc-goods   for ub.goods.
      605   define variable mode-create      as logical no-undo.
      606   define variable rec-old          as recid no-undo.
      607   define variable varres           as logical         no-undo.
      608   define variable var-code-temp    like ub.place.pl-code no-undo.
      609   define variable g-log-char       as character no-undo.
      610   define variable varprice-cli-old        like ub.ord-line-rcv.price-cli no-undo.
      611   define variable varprice-rubl-old       like ub.ord-line-rcv.price-cli no-undo.
      612   define variable varprice-base-old       like ub.ord-line-rcv.price-cli no-undo.
      613   define variable varcli-qnty-old         like ub.ord-line-rcv.cli-qnty  no-undo.
      614   define variable varcli-base-rate-old    like ub.ord-line-rcv.cli-qnty  no-undo.
      615   define variable varfact-qnty-old        like ub.ord-line-rcv.cli-qnty  no-undo.
      616   define variable p-qnty                  like ub.ord-line-rcv.cli-qnty  no-undo.
      617   define variable vardoc-qnty-old         like ub.ord-line-rcv.cli-qnty  no-undo.
      618   define variable varvat-pc-old           like ub.ord-line-rcv.vat-pc    no-undo.
      619   define variable varslt-pc-old           like ub.ord-line-rcv.vat-pc    no-undo.
      620   define variable varroad-tax-old         like ub.ord-line-rcv.price-cli no-undo.
      621   define variable varexcise-old           like ub.ord-line-rcv.price-cli no-undo.
      622   define variable vartransport-rubl-old   like ub.ord-line-rcv.price-cli no-undo.
      623   define variable varother-rubl-old       like ub.ord-line-rcv.price-cli no-undo.
      624   define variable is-1 as logical no-undo .
      625   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626       assign g-log-char = "yes".
      627       do transaction on error undo , leave:
      628          define variable tempmess as character no-undo.
      629          find first buf_ord-line-rcv no-lock where
      630                     buf_ord-line-rcv.artic = ub.goods.artic         and
      631                     buf_ord-line-rcv.prod-type = ub.goods.prod-type and
      632                     buf_ord-line-rcv.prod-code = ub.goods.prod-code and
      633                     buf_ord-line-rcv.rcv-code  = p-rcv-code    and
      634                     buf_ord-line-rcv.doc-code  = p-doc-code
      635                     no-error.
      636          if available buf_ord-line-rcv then do:
      637             assign
      638             mode-create = no
      639             varprice-cli-old       = buf_ord-line-rcv.price-cli
      640             varprice-rubl-old      = buf_ord-line-rcv.price-rubl
      641             varprice-base-old      = buf_ord-line-rcv.price-base
      642             varcli-qnty-old        = buf_ord-line-rcv.cli-qnty
      643             varcli-base-rate-old   = buf_ord-line-rcv.cli-base-rate
      644             varfact-qnty-old       = buf_ord-line-rcv.qnty
      645             varvat-pc-old          = buf_ord-line-rcv.vat-pc
      646             varslt-pc-old          = buf_ord-line-rcv.slt-pc
      647             varroad-tax-old        = buf_ord-line-rcv.road-tax
      648             varexcise-old          = buf_ord-line-rcv.excise
      649             vartransport-rubl-old  = buf_ord-line-rcv.transport-rubl
      650             varother-rubl-old      = buf_ord-line-rcv.other-rubl.
      651          end.
      652          else mode-create = yes.
      653     if is-all = true  then p-qnty =  decimal(qnty-str) .
      654     if is-all = false then p-qnty =  decimal(qnty-str)  + varfact-qnty-old .
      655     if is-all = ? then do:
      656         message "ТОВАР "
      657                 ub.goods.artic
      658                 ub.goods.prod-type
      659                 ub.goods.prod-code  skip
      660                 ub.goods.gds-name   skip  " "
      661                 skip
      662                 "YES - переписать количество со сканера товара = " decimal(qnty-str) skip
      663                 "NO - прибавить количество со сканера для товара = " decimal(qnty-str)  + varfact-qnty-old  skip
      664                 view-as alert-box question buttons yes-no update is-1.
      665             if is-1 = true then p-qnty  =  decimal(qnty-str) .
      666             if is-1 = false then p-qnty =   decimal(qnty-str)  + varfact-qnty-old .
      667     end.
      668     find first buf1_ord-line no-lock where
      669                buf1_ord-line.doc-code   = p-doc-code and
      670                buf1_ord-line.artic      = ub.goods.artic    and
      671                buf1_ord-line.prod-type  = ub.goods.prod-type  and
      672                buf1_ord-line.prod-code  = ub.goods.prod-code no-error .
      673     if available buf1_ord-line then do:
      674        if buf1_ord-line.qnty  <> p-qnty then do:
      675             v-qnty = v-qnty + 1.
      676             put stream err unformatted bar-str "," ub.goods.gds-name
      677           " по заказу " buf1_ord-line.qnty " по поставке " p-qnty skip.
      678        end.
      679     end.
      680     else do:
      681       v-ord = v-ord + 1.
      682       put stream err unformatted bar-str "," ub.goods.gds-name " нет в заказе " skip.
      683     end.
      684     find first buf_zakz_ord-line no-lock where
      685                buf_zakz_ord-line.doc-code  = p-doc-code and
      686                buf_zakz_ord-line.artic     = ub.goods.artic and
      687                buf_zakz_ord-line.prod-code = ub.goods.prod-code and
      688                buf_zakz_ord-line.prod-type = ub.goods.prod-type
      689                no-error .
      690       if available buf_zakz_ord-line then do:
      691          assign
      692            v-cli-base-rate = buf_zakz_ord-line.cli-base-rate
      693            v-unit-cli      = buf_zakz_ord-line.unit-cli
      694            .
      695       end.
      696       else do:
      697         assign
      698           v-cli-base-rate = ub.goods.cli-base-rate
      699           v-unit-cli      = ub.goods.unit-cli
      700           .
      701       end.
      702      run create-ord-line-rcv (
      703           p-rcv-code       ,
      704           p-doc-code       ,
      705           n-pp             ,
      706           ub.goods.artic      ,
      707           ub.goods.prod-code  ,
      708           ub.goods.prod-type  ,
      709           v-cli-base-rate  ,
      710           p-qnty           ,
      711           v-unit-cli       ,
      712           p-price )
      713           .
      714          assign
      715          mess = mess + tempmess.
      716          if error-status:error then do:
      717            assign
      718            mess = mess + return-value.
      719            put stream err unformatted bar-str "," qnty-str skip.
      720            put stream log unformatted "***" mess " - ошибка" skip.
      721            return error.
      722          end.
      723          else do:
      724            put stream log unformatted mess " - успешно" skip.
      725            j = j + 1.
      726            disp j with frame a.
      727          end.
      728       if substring(g-log-char, 1, 4) = "qnty" then do:
      729             put stream err unformatted bar-str "," ENTRY(2, g-log-char, "=") skip.
      730             put stream log unformatted "***" mess " - не все количество зарезервировано" skip.
      731       end.
      732     end.
      733   end procedure.
      734   procedure create-ord-line-rcv :
      735   define input parameter  p-rcv-code       like ub.ord-doc-rcv.rcv-code         no-undo .
      736   define input parameter  p-doc-code       like ub.ord-doc-rcv.doc-code         no-undo .
      737   define input parameter  p-line-num       like ub.ord-line-rcv.line-num        no-undo .
      738   define input parameter  p-artic          like ub.ord-line-rcv.artic           no-undo .
      739   define input parameter  p-prod-code      like ub.ord-line-rcv.prod-code       no-undo .
      740   define input parameter  p-prod-type      like ub.ord-line-rcv.prod-type       no-undo .
      741   define input parameter  p-cli-base-rate  like ub.ord-line-rcv.cli-base-rate   no-undo .
      742   define input parameter  p-qnty           as decimal   no-undo .
      743   define input parameter  p-unit-cli       like ub.ord-line-rcv.unit-cli        no-undo .
      744   define input parameter  p-price          as decimal   no-undo .
      745   define variable p-cli-qnty               as decimal   no-undo .
      746   define buffer bbb_ord-doc-rcv for ub.ord-doc-rcv  .
      747   define buffer tt-goods for ub.goods .
      748   define buffer buf_ord-doc for ub.ord-doc  .
      749    do
      750    on error undo, return error return-value
      751    :
      752    find first buf_ord-doc no-lock where
      753               buf_ord-doc.doc-code = ub.ord-line-rcv.doc-code no-error .
      754    find first bbb_ord-doc-rcv no-lock where
      755               bbb_ord-doc-rcv.rcv-code = p-rcv-code and
      756               bbb_ord-doc-rcv.doc-code = p-doc-code
      757               no-error .
      758    if error-status :error then do:
      759         message vss-workfile vss-revision vss-description skip
      760                 error-status :get-message(1)
      761                 view-as alert-box error .
      762                 undo, return error.
      763    end.
      764    find first tt-goods where
      765         tt-goods.artic             =   p-artic          and
      766         tt-goods.prod-code         =   p-prod-code      and
      767         tt-goods.prod-type         =   p-prod-type      no-lock no-error .
      768    if error-status :error then do:
      769         message vss-workfile vss-revision vss-description skip
      770                 error-status :get-message(1)
      771                 view-as alert-box error .
      772                 undo, return error.
      773    end.
      774   find first ub.ord-line-rcv where
      775              ub.ord-line-rcv.artic     = tt-goods.artic     and
      776              ub.ord-line-rcv.prod-type = tt-goods.prod-type and
      777              ub.ord-line-rcv.prod-code = tt-goods.prod-code and
      778              ub.ord-line-rcv.rcv-code  = p-rcv-code   and
      779              ub.ord-line-rcv.doc-code  = p-doc-code
      780              exclusive-lock    no-error.
      781         if not available ub.ord-line-rcv then do:
      782           create  ub.ord-line-rcv.
      783         end.
      784         assign
      785           ub.ord-line-rcv.gds-code       = tt-goods.gds-code
      786           ub.ord-line-rcv.doc-code       = p-doc-code
      787           ub.ord-line-rcv.rcv-code       = p-rcv-code
      788           ub.ord-line-rcv.line-num       = p-line-num
      789           ub.ord-line-rcv.artic          = p-artic
      790           ub.ord-line-rcv.prod-code      = p-prod-code
      791           ub.ord-line-rcv.prod-type      = p-prod-type
      792           ub.ord-line-rcv.cli-base-rate  = p-cli-base-rate
      793           ub.ord-line-rcv.qnty           = p-qnty
      794           ub.ord-line-rcv.cli-qnty       = ub.ord-line-rcv.qnty  / ub.ord-line-rcv.cli-base-rate
      795           ub.ord-line-rcv.unit-cli       = p-unit-cli
      796       .
      797        if p-price <> 0 then do:
      798           assign
      799             ub.ord-line-rcv.price-rubl =  p-price
      800             ub.ord-line-rcv.price-base =  ub.ord-line-rcv.price-rubl / bbb_ord-doc-rcv.base-rate * bbb_ord-doc-rcv.base-scale
      801             ub.ord-line-rcv.price-cli  =  ( p-price * ub.ord-line-rcv.cli-base-rate) / (bbb_ord-doc-rcv.exch-rate * bbb_ord-doc-rcv.exch-scale)
      802           .
      803        end.
      804        else do:
      805         find first buf_ord-doc no-lock where
      806                     buf_ord-doc.doc-code = ub.ord-line-rcv.doc-code no-error .
      807          if available buf_ord-doc then do:
      808          find first ub.ord-line no-lock where
      809                     ub.ord-line.doc-code   = ub.ord-line-rcv.doc-code and
      810                     ub.ord-line.artic      = tt-goods.artic    and
      811                     ub.ord-line.prod-type  = tt-goods.prod-type  and
      812                     ub.ord-line.prod-code  = tt-goods.prod-code no-error .
      813                     if available ub.ord-line then do:
      814                        assign
      815                         ub.ord-line-rcv.price-rubl = ub.ord-line.price-rubl
      816                         ub.ord-line-rcv.price-base = ub.ord-line.price-base
      817                         ub.ord-line-rcv.price-cli  = ub.ord-line.price-cli
      818                        .
      819                     end.
      820                     else do:
      821                       run last-price (
      822                             input  buf_ord-doc.host-code ,
      823                             input  tt-goods.artic ,
      824                             input  tt-goods.prod-type ,
      825                             input  tt-goods.prod-code ,
      826                             input  buf_ord-doc.cli-code  ,
      827                             input  buf_ord-doc.cli-type  ,
      828                             input  ub.ord-line-rcv.cli-base-rate ,
      829                             input  buf_ord-doc.exch-code ,
      830                             output ub.ord-line-rcv.price-base ,
      831                             output ub.ord-line-rcv.price-rubl ,
      832                             output ub.ord-line-rcv.price-cli  )
      833                       no-error  .
      834                       if error-status :error then message
      835                         vss-workfile vss-revision vss-description skip
      836                         error-status :get-message(1) skip
      837                         return-value skip
      838                         "Ошибка поиска последней цены"
      839                         view-as alert-box error
      840                       .
      841                     end.
      842          end.
      843        end.
      844   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      846     (input  tt-goods.gds-code
      847     ,input  '1':U
      848     ,input  ?
      849     ,input  bbb_ord-doc-rcv.host-code
      850     ,input  bbb_ord-doc-rcv.obj-type
      851     ,input  bbb_ord-doc-rcv.obj-code
      852     ,output ub.ord-line-rcv.vat-pc
      853     ) no-error .
      854     if error-status :error then
      855     message
      856       vss-workfile vss-revision vss-description skip
      857       error-status :get-message(1) skip
      858       return-value skip
      859       ""
      860       view-as alert-box error
      861     .
      862     assign
      863        ub.ord-line-rcv.sum-rubl = ub.ord-line-rcv.qnty * ub.ord-line-rcv.price-rubl
      864        ub.ord-line-rcv.sum-base = ub.ord-line-rcv.qnty * ub.ord-line-rcv.price-base
      865        ub.ord-line-rcv.sum-cli  = ub.ord-line-rcv.cli-qnty * ub.ord-line-rcv.price-cli
      866        .
      867    end.
      868   end procedure.
