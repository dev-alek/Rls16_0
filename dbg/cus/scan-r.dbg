      462   DEFINE new SHARED TEMP-TABLE anlz-bc NO-UNDO
      463        FIELD nm       as INTEGER
      464        FIELD b-c      as integer
      465        FIELD scn-qnty as DECIMAL
      466        FIELD scn-pl   as CHARACTER
      467        FIELD rez      as CHARACTER
