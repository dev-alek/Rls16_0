      539        LABEL "&Шкала"
      540        SIZE 10 BY 1 TOOLTIP "Признаки товара".
      541   DEFINE BUTTON B-trn
      542        LABEL "Просмотр накл"
      543        SIZE 19 BY 1 TOOLTIP "Просмотр накладной".
      544   DEFINE VARIABLE abbr-base AS CHARACTER FORMAT "X(256)":U
      545        LABEL "Баз.Вал."
      546         VIEW-AS TEXT
      547        SIZE 4 BY .67 TOOLTIP "Базовая валюта"
      548        FGCOLOR 4  NO-UNDO.
      549   DEFINE VARIABLE abbr-cli AS CHARACTER FORMAT "X(256)":U
      550         VIEW-AS TEXT
      551        SIZE 4.25 BY .67 TOOLTIP "Валюта поставщика"
      552        FGCOLOR 4  NO-UNDO.
      553   DEFINE VARIABLE l-loc-hour AS INTEGER FORMAT "99":U INITIAL 0
      554        LABEL "Время"
      555         VIEW-AS TEXT
      556        SIZE 3 BY .67 TOOLTIP "Стрелка вверх, вниз изменение часа" NO-UNDO.
      557   DEFINE VARIABLE l-loc-hour-2 AS INTEGER FORMAT "99":U INITIAL 0
      558        LABEL "Факт.время доставки"
      559         VIEW-AS TEXT
      560        SIZE 3 BY .67 TOOLTIP "Стрелка вверх, вниз изменение часа" NO-UNDO.
      561   DEFINE VARIABLE l-loc-min AS INTEGER FORMAT "99":U INITIAL 0
      562         VIEW-AS TEXT
      563        SIZE 3 BY .67 TOOLTIP "Стрелка вверх, вниз изменение минут" NO-UNDO.
      564   DEFINE VARIABLE l-loc-min-2 AS INTEGER FORMAT "99":U INITIAL 0
      565         VIEW-AS TEXT
      566        SIZE 3 BY .67 TOOLTIP "Стрелка вверх, вниз изменение минут" NO-UNDO.
      567   DEFINE VARIABLE loc-cli-out-code AS CHARACTER FORMAT "X(256)":U
      568        LABEL "№ по пост."
      569         VIEW-AS TEXT
      570        SIZE 28.63 BY .67 TOOLTIP "Номер по нумерации поставщика"
      571        FGCOLOR 1  NO-UNDO.
      572   DEFINE VARIABLE loc-type-doc AS CHARACTER FORMAT "X(256)":U
      573        LABEL "Тип"
      574         VIEW-AS TEXT
      575        SIZE 14 BY .67
      576        FGCOLOR 4  NO-UNDO.
      577   DEFINE VARIABLE obj_obj-name AS CHARACTER FORMAT "X(40)"
      578         VIEW-AS TEXT
      579        SIZE 52.5 BY .88.
      580   DEFINE VARIABLE post_obj-name AS CHARACTER FORMAT "X(40)"
      581         VIEW-AS TEXT
      582        SIZE 52.5 BY 1.
      583   DEFINE RECTANGLE RECT-3
      584        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      585        SIZE 62.75 BY 3.04.
      586   DEFINE QUERY BROWSE-30 FOR
      587         post-ord-line-rcv,
      588         Post-goods SCROLLING.
      589   DEFINE QUERY BROWSE-35 FOR
      590         buf_ord-chain SCROLLING.
      591   DEFINE QUERY Dialog-Frame FOR
      592         bufs_ord-doc-rcv,
      593         ub.ord-doc-rcv,
      594         post-clients,
      595         obj-clients SCROLLING.
      596   DEFINE BROWSE BROWSE-30
      597     QUERY BROWSE-30 NO-LOCK DISPLAY
      598         post-ord-line-rcv.artic      COLUMN-LABEL "Артикул"
      599         Post-goods.gds-name          COLUMN-LABEL "Наименование"
      600         Post-goods.unit-base         COLUMN-LABEL "Ед.изм!баз."
      601         post-ord-line-rcv.qnty       COLUMN-LABEL "Кол-во!(баз.ед.изм.)" FORMAT "->>>>>>>9.<<<"         COLUMN-FGCOLOR 1
      602         post-ord-line-rcv.unit-cli   COLUMN-LABEL "Ед.изм!пост"
      603         post-ord-line-rcv.cli-qnty   COLUMN-LABEL "Кол-во!(ед.изм.пост)" FORMAT "->>>>>>>9.<<<"      COLUMN-FGCOLOR 1
      604         post-ord-line-rcv.price-rubl COLUMN-LABEL "Цена!(нац.вал.)"      FORMAT "->>>>>>>>>>>>9.99"
      605         post-ord-line-rcv.price-base COLUMN-LABEL "Цена!(баз.вал.)"      FORMAT "->>>>>>>>>>9.99"
      606         post-ord-line-rcv.price-cli  COLUMN-LABEL "Цена!(пост-ка)"       FORMAT "->>>>>>>>>>9.99" COLUMN-FGCOLOR 1
      607         post-ord-line-rcv.sub-par    COLUMN-LABEL "Code39"               FORMAT "x(40)" COLUMN-FGCOLOR 1
      608         post-ord-line-rcv.line-num   COLUMN-LABEL "№"                    FORMAT ">>>>>>9" COLUMN-FGCOLOR 1
      609     ENABLE
      610         post-ord-line-rcv.qnty
      611         post-ord-line-rcv.cli-qnty
      612         post-ord-line-rcv.price-cli
      613         post-ord-line-rcv.line-num
      614       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.88 BY 12.63.
      615   DEFINE BROWSE BROWSE-35
      616     QUERY BROWSE-35 NO-LOCK DISPLAY
      617         buf_ord-chain.rel-doc-code FORMAT "X(16)":U
      618       WITH NO-BOX NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 30 BY 2.75 ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      619   DEFINE FRAME Dialog-Frame
      620        B-exit AT ROW 1 COL 1
      621        b-prev AT ROW 1 COL 11
      622        b-next AT ROW 1 COL 16
      623        B-diff AT ROW 1 COL 76 WIDGET-ID 10
      624        B-delivery AT ROW 1 COL 86
      625        B-Help AT ROW 1 COL 96
      626        BROWSE-35 AT ROW 5.25 COL 36 WIDGET-ID 100
      627        B-trn AT ROW 5.25 COL 68.5
      628        b-lkp AT ROW 9.13 COL 1.5 WIDGET-ID 6
      629        b-scl AT ROW 9.13 COL 11.5 WIDGET-ID 8
      630        b-export AT ROW 9.13 COL 21.5 WIDGET-ID 4
      631        BROWSE-30 AT ROW 10.38 COL 1.13 WIDGET-ID 200
      632        ub.ord-doc-rcv.rcv-code AT ROW 1.25 COL 33 COLON-ALIGNED
      633             LABEL "Поставка"
      634              VIEW-AS TEXT
      635             SIZE 13.63 BY .67
      636             FGCOLOR 4
      637        loc-type-doc AT ROW 1.25 COL 53 COLON-ALIGNED
      638        ub.ord-doc-rcv.doc-code AT ROW 2.13 COL 15.25 COLON-ALIGNED
      639             LABEL "Заказ"
      640              VIEW-AS TEXT
      641             SIZE 15 BY .63 TOOLTIP "Номер заказа"
      642             FGCOLOR 4
      643        loc-cli-out-code AT ROW 2.13 COL 44.13 COLON-ALIGNED WIDGET-ID 2
      644        ub.ord-doc-rcv.cli-code AT ROW 3.08 COL 15.25 COLON-ALIGNED
      645              VIEW-AS TEXT
      646             SIZE 10 BY .67
      647        ub.ord-doc-rcv.cli-type AT ROW 3.08 COL 25.88 COLON-ALIGNED NO-LABEL
      648              VIEW-AS TEXT
      649             SIZE 4 BY .67
      650        post_obj-name AT ROW 3.08 COL 33.5 COLON-ALIGNED NO-LABEL
      651        obj_obj-name AT ROW 4.25 COL 33.5 COLON-ALIGNED NO-LABEL
      652        ub.ord-doc-rcv.obj-code AT ROW 4.29 COL 18 COLON-ALIGNED
      653              VIEW-AS TEXT
      654             SIZE 10 BY .67
      655        ub.ord-doc-rcv.obj-type AT ROW 4.29 COL 25.88 COLON-ALIGNED NO-LABEL
      656              VIEW-AS TEXT
      657             SIZE 4 BY .67
      658        ub.ord-doc-rcv.ship-date AT ROW 5.42 COL 15.13 COLON-ALIGNED
      659              VIEW-AS TEXT
      660             SIZE 11.25 BY .67 TOOLTIP "Планируемая дата доставки"
      661        l-loc-hour AT ROW 6.54 COL 15.25 COLON-ALIGNED
      662        l-loc-min AT ROW 6.54 COL 20.25 COLON-ALIGNED NO-LABEL
      663        l-loc-hour-2 AT ROW 6.71 COL 87.38 COLON-ALIGNED
      664        l-loc-min-2 AT ROW 6.71 COL 92.38 COLON-ALIGNED NO-LABEL
      665        abbr-cli AT ROW 8.17 COL 25.75 COLON-ALIGNED NO-LABEL
      666        ub.ord-doc-rcv.exch-rate AT ROW 8.29 COL 30.75 COLON-ALIGNED NO-LABEL
      667              VIEW-AS TEXT
      668             SIZE 12 BY .67 TOOLTIP "курс"
      669        ub.ord-doc-rcv.exch-scale AT ROW 8.29 COL 43.38 COLON-ALIGNED NO-LABEL
      670              VIEW-AS TEXT
      671             SIZE 5 BY .67 TOOLTIP "масштаб"
      672        ub.ord-doc-rcv.exch-code AT ROW 8.33 COL 18.13 COLON-ALIGNED
      673              VIEW-AS TEXT
      674             SIZE 4 BY .67 TOOLTIP "код валюты поставщика"
      675        abbr-base AT ROW 8.38 COL 73.25 COLON-ALIGNED
      676        ub.ord-doc-rcv.base-rate AT ROW 8.38 COL 78.38 COLON-ALIGNED NO-LABEL
      677              VIEW-AS TEXT
      678             SIZE 12 BY .67 TOOLTIP "курс"
      679        ub.ord-doc-rcv.base-scale AT ROW 8.38 COL 91 COLON-ALIGNED NO-LABEL
      680              VIEW-AS TEXT
      681             SIZE 5 BY .67 TOOLTIP "масштаб"
      682        ":" VIEW-AS TEXT
      683             SIZE 1.25 BY .67 AT ROW 6.71 COL 92
      684             FGCOLOR 1
      685        ":" VIEW-AS TEXT
      686             SIZE 1.25 BY 1 AT ROW 6.33 COL 20.5
      687             FGCOLOR 1
      688        RECT-3 AT ROW 5.21 COL 35.5
      689        SPACE(1.36) SKIP(15.24)
      690       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      691            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      692            TITLE "Поставка по заказу".
      693   ASSIGN
      694          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      695          FRAME Dialog-Frame:HIDDEN           = TRUE.
      696   ASSIGN
      697          B-diff:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      698   ASSIGN
      699          b-export:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-export-2:HANDLE.
      700   ASSIGN
      701          BROWSE-30:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
      702   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      703   DO:
      704     apply "CHOOSE":u to b-exit.
      705   END.
      706   ON CHOOSE OF B-delivery IN FRAME Dialog-Frame
      707   DO:
      708   define buffer buf_ord-doc for ub.ord-doc  .
      709   define variable type-mode as character no-undo .
      710   if bufs_ord-doc-rcv.doc-type = "in" then type-mode = "rcv" + 'ОО':U .
      711   else do:
      712     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = bufs_ord-doc-rcv.doc-code no-error .
      713       if not available buf_ord-doc  then do:
      714          type-mode = "ord" + 'ОО':U .
      715       end.
      716       else type-mode = "ord" + buf_ord-doc.doc-type .
      717   end.
      718       run cus/pardeliv.w
      719         (input        parParentproc
      720         ,input        'ПРОСМОТР':U
      721         ,input        type-mode
      722         ,input        bufs_ord-doc-rcv.obj-type
      723         ,input        bufs_ord-doc-rcv.obj-code
      724         ,input        bufs_ord-doc-rcv.cli-type
      725         ,input        bufs_ord-doc-rcv.cli-code
      726         ,input-output v-deliv-type-code
      727         ,input-output v-point-obj-code
      728         ,input-output v-point-obj-db-num
      729         ,input-output v-point-cli-code
      730         ,input-output v-point-cli-db-num
      731         ,input-output v-transport-host-code
      732         ,input-output v-transport-cli-type
      733         ,input-output v-transport-cli-code
      734         ,input-output v-transport-contract
      735         ,input-output v-transport-condition
      736         ,input-output v-transport-value
      737         ,input-output v-transport-sum
      738         ,input-output v-transport-vat
      739         ) no-error  .
      740            if error-status :error then message
      741              vss-workfile vss-revision vss-description skip
      742              error-status :get-message(1) skip
      743              return-value skip
      744              "Ошибка"
      745              view-as alert-box error
      746            .
      747   END.
      748   ON CHOOSE OF B-diff IN FRAME Dialog-Frame
      749   DO:
      750   define variable v-ps as character no-undo .
      751     if ub.ord-doc-rcv.ord-int2 = integer('2':U) then do:
      752       v-ps = ub.ord-doc-rcv.PS .
      753       run gbl/notes.w ( input 'ПРОСМОТР':U , input-output v-ps ).
      754     end.
      755   END.
      756   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      757   DO:
      758   next-prev = ?.
      759   apply "end-error":u to self.
      760   return.
      761   END.
      762   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      763   DO:
      764     run cus/z-tot3.p (parParentProc , input ub.ord-doc-rcv.rcv-code , input ub.ord-doc-rcv.doc-code ) .
      765   END.
      766   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      767   DO:
      768     find current post-ord-line-rcv no-error.
      769     if avail post-ord-line-rcv then do:
      770     doc-mode  = 'ПРОСМОТР':U .
      771       run cus/or-obj.w (
      772         parParentProc
      773       , bufs_ord-doc-rcv.host-code
      774       , recid(post-ord-line-rcv)
      775       , 2
      776       , 'ПРОСМОТР':U
      777       , 'ПРОСМОТР':U
      778       , input-output doc-mode
      779       ) no-error  .
      780       if error-status :error then
      781       message
      782         vss-workfile vss-revision vss-description skip
      783         error-status :get-message(1) skip
      784         return-value skip
      785         "Ошибка при корректировке строки поставки"
      786         view-as alert-box error
      787       .
      788   end.
      789   END.
      790   ON CHOOSE OF b-next IN FRAME Dialog-Frame
      791   DO:
      792   RUN STEP-NEXT IN THIS-PROCEDURE .
      793   END.
      794   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
      795   DO:
      796   run step-prev in this-procedure .
      797   END.
      798   ON CHOOSE OF b-scl IN FRAME Dialog-Frame
      799   DO:
      800     message "Режим недоступен" view-as alert-box information .
      801     return .
      802   END.
      803   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
      804   DO:
      805   if not available buf_ord-chain then return .
      806       run str/showdoc.p
      807         (input parparentproc
      808         ,input buf_ord-chain.rel-doc-code
      809         ,input ""
      810         ,input ""
      811         ,input 0
      812         ,input true
      813         ) no-error  .
      814         if error-status :error then
      815          message
      816             "Вернулась из процедуры showdoc.p "
      817             error-status :get-message(1)
      818             view-as alert-box error .
      819   END.
      820   ON CHOOSE OF MENU-ITEM m_mobilscn-2
      821   DO:
      822     if not available ub.ord-doc-rcv then return .
      823     run cus/z-tot2.p (input parparentproc , input "rcv" , input "" ,input  ub.ord-doc-rcv.rcv-code ) .
      824   END.
      825   ON CHOOSE OF MENU-ITEM m___Excel-2
      826   DO:
      827     if not available ub.ord-doc-rcv then return .
      828     run cus/z-tot3.p ( input parParentProc , input ub.ord-doc-rcv.rcv-code , input ub.ord-doc-rcv.doc-code ) .
      829   END.
      830   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      831   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      832   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   on help of frame Dialog-Frame
      834   do:
      835     run gbl/app_help.p
      836       (input this-procedure :file-name
      837       ,input ''
      838       ,input ?
      839       ) no-error.
      840     if error-status :error then do:
      841       message
      842         "Ошибка при вызове помощи"
      843         error-status :get-message(1)
      844         view-as alert-box .
      845     end.
      846   end.
      847   run minbtn-set in this-procedure .
      848   on choose of b-help in frame Dialog-Frame
      849   do:
      850     apply "help":u to frame Dialog-Frame .
      851   end.
      852   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   procedure minbtn-set :
      854       do
      855           on error undo, return error return-value
      856           :
      857           define variable ii              as integer       no-undo .
      858           define variable fh              as widget-handle no-undo .
      859           define variable hh              as widget-handle no-undo .
      860           define variable v-h             as handle        extent 4 no-undo .
      861           define variable v-name-button   as character     no-undo .
      862           define variable v-help-old-x    as decimal       no-undo .
      863           define variable v-help-old-y    as decimal       no-undo .
      864           define variable v-help-old-size as decimal       no-undo .
      865           define variable v-frame-width   as decimal       no-undo .
      866           define variable jj              as integer       no-undo .
      867           do
      868               on error undo, return error
      869               :
      870               assign
      871                   v-frame-width = frame Dialog-Frame:width - 0.3
      872                   fh            = frame Dialog-Frame:first-child
      873                   hh            = fh:first-child
      874                   ii            = 1
      875                   .
      876               do while valid-handle(hh):
      877                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      878                   do:
      879                       case lc(hh:name) :
      880                           when "b-help" then
      881                               do:
      882                                   hh:load-image-up("cmp/b-help.bmp":u) .
      883                                   hh:load-image-down("cmp/b-help.bmp":u) .
      884                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      885                                   hh:TOOLTIP = "Помощь" .
      886                                   v-help-old-x = hh:column .
      887                                   v-help-old-y = hh:row    .
      888                                   v-help-old-size = hh:width .
      889                                   hh:width-chars = 2.5 .
      890                               end.
      891                           when "b-print" then
      892                               do:
      893                                   hh:load-image("cmp/b-print.bmp":u) .
      894                                   hh:TOOLTIP = "Печать" .
      895                                   v-h[ii] = hh:handle .
      896                                   ii = ii + 1 .
      897                                   hh:width-chars = 3 .
      898                               end.
      899                           when "b-history" or
      900                           when "b-hist" then
      901                               do:
      902                                   hh:load-image("cmp/b-hist.bmp":u) .
      903                                   hh:TOOLTIP = "История" .
      904                                   v-h[ii] = hh:handle .
      905                                   ii = ii + 1 .
      906                                   hh:width-chars = 3 .
      907                               end.
      908                           when "b-sch" then
      909                               do:
      910                                   hh:load-image("cmp/b-sch.bmp":u) .
      911                                   hh:TOOLTIP = "Установка Фильтра" .
      912                                   v-h[ii] = hh:handle .
      913                                   ii = ii + 1 .
      914                                   hh:width-chars = 3 .
      915                               end.
      916                           when "b-hist-user" then
      917                               do:
      918                                   hh:load-image("cmp/b-hist.bmp":u) .
      919                                   hh:TOOLTIP = "История пользователя" .
      920                                   ii = ii + 1 .
      921                               end.
      922                       end case.
      923                   end.
      924                   hh = hh:next-sibling.
      925               end.
      926               b-help:column = v-frame-width - b-help:width-chars.
      927               jj = 0.
      928               repeat ii = 4 to 1 by -1 :
      929                   if valid-handle (v-h[ii] ) then
      930                   do:
      931                       jj  = jj + 1 .
      932                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      933                       v-h[ii]:row    = v-help-old-y .
      934                   end.
      935               end.
      936           end.
      937       end.
      938   end procedure.
      939   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      940   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      941   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      942   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      943   define variable v-diasize-current-frame-width  as decimal   no-undo .
      944   define variable v-diasize-current-frame-height as decimal   no-undo .
      945   define variable v-diasize-change-size          as logical   no-undo .
      946   define variable v-diasize-resize-button        as handle    no-undo .
      947   define variable v-diasize-wndmax               as logical   no-undo .
      948   define variable v-diasize-wndstore             as logical   no-undo .
      949   define variable v-diasize-proc-name            as character no-undo .
      950   define variable v-diasize-browse-handle        as handle    no-undo .
      951   define variable v-diasize-browse-number        as integer   no-undo .
      952   define variable v-diasize-need-full-display    as logical   no-undo init false .
      953   define temp-table temp-diasize-handle no-undo
      954     field handle-value  as handle
      955     field save-position as decimal
      956     index xpk is primary unique handle-value
      957     .
      958   define temp-table temp-browse-handle no-undo
      959     field browse-type   as character
      960     field browse-number as integer
      961     field browse-handle as handle
      962     field original-size as decimal
      963     index xpk is primary unique browse-type browse-number
      964     index xie browse-type browse-handle
      965   .
      966   procedure diasize_change-height :
      967     define input  parameter p-change-value  as decimal   no-undo .
      968     define input  parameter p-move-resize   as logical   no-undo .
      969     define variable v-field-group-handle    as handle    no-undo .
      970     define variable v-object-handle         as handle    no-undo .
      971     define variable v-frame-height          as decimal   no-undo .
      972     define variable v-frame-virtual-height  as decimal   no-undo .
      973     define variable v-browse-height         as decimal   no-undo .
      974     define variable v-window-height         as decimal   no-undo .
      975     define variable v-window-virtual-height as decimal   no-undo .
      976     define variable v-change-sign           as integer   no-undo .
      977     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      978     define buffer buf_temp-browse-handle  for temp-browse-handle .
      979     if p-change-value > 0
      980     then do:
      981       if frame Dialog-Frame :height + p-change-value
      982           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      983       then do:
      984         assign
      985           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      986                           - (frame Dialog-Frame :height-chars)
      987         .
      988         if p-change-value <= 0
      989         then do:
      990           run diasize_position-resize-button in this-procedure .
      991           return .
      992         end.
      993       end.
      994     end.
      995     if p-change-value < 0
      996     then do:
      997       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      998       then do:
      999         assign
     1000           p-change-value = v-diasize-orig-frame-height
     1001                          - (frame Dialog-Frame :height-chars)
     1002         .
     1003         if p-change-value >= 0
     1004         then do:
     1005           run diasize_position-resize-button in this-procedure .
     1006           return .
     1007         end.
     1008       end.
     1009     end.
     1010     if p-change-value >= 0
     1011     then do:
     1012       assign
     1013         v-change-sign = 1
     1014       .
     1015     end.
     1016     else do:
     1017       assign
     1018         v-change-sign = -1
     1019       .
     1020     end.
     1021     assign
     1022       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1023     .
     1024     if p-change-value = 0
     1025     then do:
     1026       run diasize_position-resize-button in this-procedure .
     1027       return .
     1028     end.
     1029     move_block:
     1030     do
     1031     on error undo move_block, retry move_block
     1032     :
     1033       if retry
     1034       then do:
     1035         do
     1036         on error undo move_block, leave move_block
     1037         :
     1038           if p-change-value > 0
     1039           then do:
     1040             for each buf_temp-diasize-handle
     1041             on error undo, next
     1042             :
     1043               assign
     1044                 v-object-handle = buf_temp-diasize-handle.handle-value
     1045               .
     1046               if v-object-handle <> v-diasize-resize-button
     1047               then do:
     1048                 assign
     1049                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1050                 .
     1051               end.
     1052             end.
     1053             assign
     1054               v-diasize-browse-handle :height = v-browse-height
     1055             .
     1056             for each buf_temp-browse-handle
     1057               where buf_temp-browse-handle.browse-type = 'height':u
     1058             on error undo, next
     1059             :
     1060               assign
     1061                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1062               .
     1063             end.
     1064             assign
     1065               frame Dialog-Frame :height = v-frame-height
     1066             .
     1067             if frame Dialog-Frame :scrollable = true
     1068             then do:
     1069               assign
     1070                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1071               .
     1072             end.
     1073             run diasize_position-resize-button in this-procedure .
     1074           end.
     1075           else do:
     1076             if frame Dialog-Frame :scrollable = true
     1077             then do:
     1078               assign
     1079                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1080               .
     1081             end.
     1082             assign
     1083               frame Dialog-Frame :height = v-frame-height
     1084             .
     1085             assign
     1086               v-diasize-browse-handle :height = v-browse-height
     1087             .
     1088             for each buf_temp-browse-handle
     1089               where buf_temp-browse-handle.browse-type = 'height':u
     1090             on error undo, next
     1091             :
     1092               assign
     1093                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1094               .
     1095             end.
     1096             for each buf_temp-diasize-handle
     1097             on error undo, next
     1098             :
     1099               assign
     1100                 v-object-handle = buf_temp-diasize-handle.handle-value
     1101               .
     1102               if v-object-handle <> v-diasize-resize-button
     1103               then do:
     1104                 assign
     1105                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1106                 .
     1107               end.
     1108             end.
     1109             run diasize_position-resize-button in this-procedure .
     1110           end.
     1111           assign
     1112             v-diasize-change-size = false
     1113           .
     1114           leave move_block .
     1115         end.
     1116       end.
     1117       assign
     1118         v-diasize-need-full-display = true
     1119       .
     1120       if v-diasize-change-size = false
     1121       then do:
     1122         assign
     1123           v-diasize-change-size = true
     1124         .
     1125       end.
     1126       else do:
     1127         return .
     1128       end.
     1129       assign
     1130         v-frame-height = frame Dialog-Frame :height
     1131         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1132         v-browse-height = v-diasize-browse-handle :height
     1133       .
     1134       for each buf_temp-browse-handle
     1135         where buf_temp-browse-handle.browse-type = 'height':u
     1136       :
     1137         assign
     1138           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1139         .
     1140       end.
     1141       for each buf_temp-diasize-handle
     1142       :
     1143         delete buf_temp-diasize-handle .
     1144       end.
     1145       assign
     1146         v-field-group-handle = frame Dialog-Frame :first-child
     1147       .
     1148       do while valid-handle(v-field-group-handle)
     1149       :
     1150         assign
     1151           v-object-handle = v-field-group-handle :first-child
     1152         .
     1153         do while valid-handle(v-object-handle)
     1154         :
     1155           if  v-object-handle <> v-diasize-browse-handle :handle
     1156           and can-query(v-object-handle, "row")
     1157           and can-query(v-object-handle, "height")
     1158           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1159           then do:
     1160             find first buf_temp-browse-handle
     1161               where buf_temp-browse-handle.browse-type   = 'height':u
     1162                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1163               no-error .
     1164             if available buf_temp-browse-handle
     1165             then do:
     1166             end.
     1167             else do:
     1168               create buf_temp-diasize-handle .
     1169               assign
     1170                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1171                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1172               .
     1173             end.
     1174           end.
     1175           assign
     1176             v-object-handle = v-object-handle :next-sibling
     1177           .
     1178         end.
     1179         assign
     1180           v-field-group-handle = v-field-group-handle :next-sibling
     1181         .
     1182       end.
     1183       do with frame Dialog-Frame
     1184       :
     1185         hide v-diasize-resize-button .
     1186         assign
     1187           v-diasize-resize-button :row    = 1
     1188           v-diasize-resize-button :column = 1
     1189         .
     1190       end.
     1191       if p-change-value > 0
     1192       then do:
     1193         if frame Dialog-Frame :scrollable = true
     1194         then do:
     1195           assign
     1196             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1197             no-error .
     1198           if error-status :error
     1199           or error-status :get-message(1) <> ""
     1200           then do:
     1201             undo move_block, retry move_block .
     1202           end.
     1203         end.
     1204         assign
     1205           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1206           no-error .
     1207         if error-status :error
     1208         or error-status :get-message(1) <> ""
     1209         then do:
     1210           undo move_block, retry move_block .
     1211         end.
     1212         assign
     1213           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1214           no-error .
     1215         if error-status :error
     1216         or error-status :get-message(1) <> ""
     1217         then do:
     1218           undo move_block, retry move_block .
     1219         end.
     1220         for each buf_temp-browse-handle
     1221           where buf_temp-browse-handle.browse-type = 'height':u
     1222         on error undo move_block, retry move_block
     1223         :
     1224           assign
     1225             buf_temp-browse-handle.browse-handle :height
     1226               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1227             no-error .
     1228           if error-status :error
     1229           or error-status :get-message(1) <> ""
     1230           then do:
     1231             undo move_block, retry move_block .
     1232           end.
     1233         end.
     1234         for each buf_temp-diasize-handle
     1235         on error undo move_block, retry move_block
     1236         :
     1237           assign
     1238             v-object-handle = buf_temp-diasize-handle.handle-value
     1239           .
     1240           if v-object-handle <> v-diasize-resize-button
     1241           then do:
     1242             assign
     1243               v-object-handle :row = v-object-handle :row + p-change-value
     1244               no-error .
     1245             if error-status :error
     1246             or error-status :get-message(1) <> ""
     1247             then do:
     1248               undo move_block, retry move_block .
     1249             end.
     1250           end.
     1251         end.
     1252       end.
     1253       else do:
     1254         for each buf_temp-diasize-handle
     1255         on error undo move_block, retry move_block
     1256         :
     1257           assign
     1258             v-object-handle = buf_temp-diasize-handle.handle-value
     1259           .
     1260           if v-object-handle <> v-diasize-resize-button
     1261           then do:
     1262             assign
     1263               v-object-handle :row = v-object-handle :row + p-change-value
     1264               no-error .
     1265             if error-status :error
     1266             or error-status :get-message(1) <> ""
     1267             then do:
     1268               undo move_block, retry move_block .
     1269             end.
     1270           end.
     1271         end.
     1272         assign
     1273           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1274           no-error .
     1275         if error-status :error
     1276         or error-status :get-message(1) <> ""
     1277         then do:
     1278           undo move_block, retry move_block .
     1279         end.
     1280         for each buf_temp-browse-handle
     1281           where buf_temp-browse-handle.browse-type = 'height':u
     1282         on error undo move_block, retry move_block
     1283         :
     1284           assign
     1285             buf_temp-browse-handle.browse-handle :height
     1286               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1287             no-error .
     1288           if error-status :error
     1289           or error-status :get-message(1) <> ""
     1290           then do:
     1291             undo move_block, retry move_block .
     1292           end.
     1293         end.
     1294         assign
     1295           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1296           no-error .
     1297         if error-status :error
     1298         or error-status :get-message(1) <> ""
     1299         then do:
     1300           undo move_block, retry move_block .
     1301         end.
     1302         if frame Dialog-Frame :scrollable = true
     1303         then do:
     1304           assign
     1305             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1306             no-error .
     1307           if error-status :error
     1308           or error-status :get-message(1) <> ""
     1309           then do:
     1310             undo move_block, retry move_block .
     1311           end.
     1312         end.
     1313       end.
     1314       if p-move-resize = true
     1315       then do:
     1316         run diasize_position-resize-button in this-procedure .
     1317       end.
     1318       if v-diasize-wndstore = true
     1319       then do:
     1320         if connected("ub") = true
     1321         then do:
     1322           define variable v-cntxt-db-num        as integer   no-undo .
     1323           define variable v-cntxt-userid        as character no-undo .
     1324           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1325                                             , OUTPUT v-cntxt-userid
     1326                                             ) .
     1327           run gbl/wndsizew.p
     1328             (input  v-cntxt-db-num
     1329             ,input  v-cntxt-userid
     1330             ,input  v-diasize-proc-name
     1331             ,input  'height':u
     1332             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1333             ) .
     1334         end.
     1335       end.
     1336     end.
     1337     assign
     1338       v-diasize-change-size = false
     1339     .
     1340   end procedure.
     1341   procedure diasize_set-height :
     1342     define input  parameter p-new-height  as decimal   no-undo .
     1343     define input  parameter p-move-resize as logical   no-undo .
     1344     do
     1345     on error undo, return error return-value
     1346     :
     1347       run diasize_change-height in this-procedure
     1348         (input  (p-new-height - frame Dialog-Frame :height)
     1349         ,input  p-move-resize
     1350         ) .
     1351     end.
     1352   end procedure.
     1353   procedure diasize_change-width :
     1354     define input  parameter p-change-value as decimal   no-undo .
     1355     define input  parameter p-move-resize  as logical   no-undo .
     1356     define variable v-field-group-handle   as handle    no-undo .
     1357     define variable v-object-handle        as handle    no-undo .
     1358     define variable v-frame-width          as decimal   no-undo .
     1359     define variable v-frame-virtual-width  as decimal   no-undo .
     1360     define variable v-browse-width         as decimal   no-undo .
     1361     define variable v-window-width         as decimal   no-undo .
     1362     define variable v-window-virtual-width as decimal   no-undo .
     1363     define variable v-change-sign          as integer   no-undo .
     1364     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1365     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1366     if p-change-value > 0
     1367     then do:
     1368       if frame Dialog-Frame :width + p-change-value >
     1369           session :width-chars
     1370       then do:
     1371         assign
     1372           p-change-value = session :width-chars - frame Dialog-Frame :width
     1373         .
     1374         if p-change-value <= 0
     1375         then do:
     1376           run diasize_position-resize-button in this-procedure .
     1377           return .
     1378         end.
     1379       end.
     1380     end.
     1381     if p-change-value < 0
     1382     then do:
     1383       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1384       then do:
     1385         assign
     1386           p-change-value = v-diasize-orig-frame-width
     1387                          - frame Dialog-Frame :width
     1388         .
     1389         if p-change-value >= 0
     1390         then do:
     1391           run diasize_position-resize-button in this-procedure .
     1392           return .
     1393         end.
     1394       end.
     1395     end.
     1396     if p-change-value >= 0
     1397     then do:
     1398       assign
     1399         v-change-sign = 1
     1400       .
     1401     end.
     1402     else do:
     1403       assign
     1404         v-change-sign = -1
     1405       .
     1406     end.
     1407     assign
     1408       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1409     .
     1410     if p-change-value = 0
     1411     then do:
     1412       run diasize_position-resize-button in this-procedure .
     1413       return .
     1414     end.
     1415     move_block:
     1416     do
     1417     on error undo move_block, leave move_block
     1418     :
     1419       if retry
     1420       then do:
     1421         do
     1422         on error undo move_block, leave move_block
     1423         :
     1424           if p-change-value > 0
     1425           then do:
     1426             for each buf_temp-diasize-handle
     1427             on error undo, next
     1428             :
     1429               assign
     1430                 v-object-handle = buf_temp-diasize-handle.handle-value
     1431               .
     1432               if v-object-handle <> v-diasize-resize-button
     1433               then do:
     1434                 assign
     1435                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1436                 .
     1437               end.
     1438             end.
     1439             assign
     1440               v-diasize-browse-handle :width = v-browse-width
     1441             .
     1442             for each buf_temp-browse-handle
     1443               where buf_temp-browse-handle.browse-type = 'width':u
     1444             on error undo, next
     1445             :
     1446               assign
     1447                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1448               .
     1449             end.
     1450             assign
     1451               frame Dialog-Frame :width = v-frame-width
     1452             .
     1453             if frame Dialog-Frame :scrollable = true
     1454             then do:
     1455               assign
     1456                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1457               .
     1458             end.
     1459             run diasize_position-resize-button in this-procedure .
     1460           end.
     1461           else do:
     1462             if frame Dialog-Frame :scrollable = true
     1463             then do:
     1464               assign
     1465                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1466               .
     1467             end.
     1468             assign
     1469               frame Dialog-Frame :width = v-frame-width
     1470             .
     1471             for each buf_temp-browse-handle
     1472               where buf_temp-browse-handle.browse-type = 'width':u
     1473             on error undo, next
     1474             :
     1475               assign
     1476                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1477               .
     1478             end.
     1479             assign
     1480               v-diasize-browse-handle :width = v-browse-width
     1481             .
     1482             for each buf_temp-diasize-handle
     1483             on error undo, next
     1484             :
     1485               assign
     1486                 v-object-handle = buf_temp-diasize-handle.handle-value
     1487               .
     1488               if v-object-handle <> v-diasize-resize-button
     1489               then do:
     1490                 assign
     1491                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1492                 .
     1493               end.
     1494             end.
     1495             run diasize_position-resize-button in this-procedure .
     1496           end.
     1497           assign
     1498             v-diasize-change-size = false
     1499           .
     1500           leave move_block .
     1501         end.
     1502       end.
     1503       assign
     1504         v-diasize-need-full-display = true
     1505       .
     1506       if v-diasize-change-size = false
     1507       then do:
     1508         assign
     1509           v-diasize-change-size = true
     1510         .
     1511       end.
     1512       else do:
     1513         return .
     1514       end.
     1515       assign
     1516         v-frame-width = frame Dialog-Frame :width
     1517         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1518         v-browse-width = v-diasize-browse-handle :width
     1519       .
     1520       for each buf_temp-browse-handle
     1521         where buf_temp-browse-handle.browse-type = 'width':u
     1522       :
     1523         assign
     1524           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1525         .
     1526       end.
     1527       for each buf_temp-diasize-handle
     1528       :
     1529         delete buf_temp-diasize-handle .
     1530       end.
     1531       assign
     1532         v-field-group-handle = frame Dialog-Frame :first-child
     1533       .
     1534       do while valid-handle(v-field-group-handle)
     1535       :
     1536         assign
     1537           v-object-handle = v-field-group-handle :first-child
     1538         .
     1539         do while valid-handle(v-object-handle)
     1540         :
     1541           if  v-object-handle <> v-diasize-browse-handle :handle
     1542           and v-object-handle <> v-diasize-resize-button
     1543           and can-query(v-object-handle, "row")
     1544           and can-query(v-object-handle, "height")
     1545           and ( v-object-handle :col + v-object-handle :width
     1546                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1547               )
     1548           then do:
     1549             find first buf_temp-browse-handle
     1550               where buf_temp-browse-handle.browse-type   = 'width':u
     1551                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1552               no-error .
     1553             if available buf_temp-browse-handle
     1554             then do:
     1555             end.
     1556             else do:
     1557               create buf_temp-diasize-handle .
     1558               assign
     1559                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1560                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1561               .
     1562             end.
     1563           end.
     1564           assign
     1565             v-object-handle = v-object-handle :next-sibling
     1566           .
     1567         end.
     1568         assign
     1569           v-field-group-handle = v-field-group-handle :next-sibling
     1570         .
     1571       end.
     1572       do with frame Dialog-Frame
     1573       :
     1574         hide v-diasize-resize-button .
     1575         v-diasize-resize-button :row = 1.
     1576         v-diasize-resize-button :column = 1.
     1577       end.
     1578       if p-change-value > 0
     1579       then do:
     1580         if frame Dialog-Frame :scrollable = true
     1581         then do:
     1582           assign
     1583             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1584             no-error .
     1585           if error-status :error
     1586           or error-status :get-message(1) <> ""
     1587           then do:
     1588             undo move_block, retry move_block.
     1589           end.
     1590         end.
     1591         assign
     1592           frame Dialog-Frame :width = v-frame-width + p-change-value
     1593           no-error .
     1594         if error-status :error
     1595         or error-status :get-message(1) <> ""
     1596         then do:
     1597           undo move_block, retry move_block.
     1598         end.
     1599         assign
     1600           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1601         no-error .
     1602         if error-status :error
     1603         or error-status :get-message(1) <> ""
     1604         then do:
     1605           undo move_block, retry move_block.
     1606         end.
     1607         for each buf_temp-browse-handle
     1608           where buf_temp-browse-handle.browse-type = 'width':u
     1609         on error undo move_block, retry move_block
     1610         :
     1611           assign
     1612             buf_temp-browse-handle.browse-handle :width
     1613               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1614             no-error .
     1615           if error-status :error
     1616           or error-status :get-message(1) <> ""
     1617           then do:
     1618             undo move_block, retry move_block .
     1619           end.
     1620         end.
     1621         for each buf_temp-diasize-handle
     1622         on error undo move_block, retry move_block
     1623         :
     1624           assign
     1625             v-object-handle = buf_temp-diasize-handle.handle-value
     1626           .
     1627           if v-object-handle <> v-diasize-resize-button
     1628           then do:
     1629             assign
     1630               v-object-handle :col = v-object-handle :col + p-change-value
     1631               no-error .
     1632             if error-status :error
     1633             or error-status :get-message(1) <> ""
     1634             then do:
     1635               undo move_block, retry move_block .
     1636             end.
     1637           end.
     1638         end.
     1639       end.
     1640       else do:
     1641         for each buf_temp-diasize-handle
     1642         on error undo move_block, retry move_block
     1643         :
     1644           assign
     1645             v-object-handle = buf_temp-diasize-handle.handle-value
     1646           .
     1647           if v-object-handle <> v-diasize-resize-button
     1648           then do:
     1649             assign
     1650               v-object-handle :col = v-object-handle :col + p-change-value
     1651               no-error .
     1652             if error-status :error
     1653             or error-status :get-message(1) <> ""
     1654             then do:
     1655               undo move_block, retry move_block .
     1656             end.
     1657           end.
     1658         end.
     1659         for each buf_temp-browse-handle
     1660           where buf_temp-browse-handle.browse-type = 'width':u
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             buf_temp-browse-handle.browse-handle :width
     1665               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1666             no-error .
     1667           if error-status :error
     1668           or error-status :get-message(1) <> ""
     1669           then do:
     1670             undo move_block, retry move_block .
     1671           end.
     1672         end.
     1673         assign
     1674           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1675           no-error .
     1676         if error-status :error
     1677         or error-status :get-message(1) <> ""
     1678         then do:
     1679           undo move_block, retry move_block.
     1680         end.
     1681         assign
     1682           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1683         no-error .
     1684         if error-status :error
     1685         or error-status :get-message(1) <> ""
     1686         then do:
     1687           undo move_block, retry move_block.
     1688         end.
     1689         if frame Dialog-Frame :scrollable = true
     1690         then do:
     1691           assign
     1692             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1693           no-error .
     1694           if error-status :error
     1695           or error-status :get-message(1) <> ""
     1696           then do:
     1697             undo move_block, retry move_block.
     1698           end.
     1699         end.
     1700       end.
     1701       if p-move-resize
     1702       then do:
     1703         run diasize_position-resize-button in this-procedure .
     1704       end.
     1705       if v-diasize-wndstore = true
     1706       then do:
     1707         if connected("ub") = true
     1708         then do:
     1709           define variable v-cntxt-db-num        as integer   no-undo .
     1710           define variable v-cntxt-userid        as character no-undo .
     1711           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1712                                             , OUTPUT v-cntxt-userid
     1713                                             ) .
     1714           run gbl/wndsizew.p
     1715             (input  v-cntxt-db-num
     1716             ,input  v-cntxt-userid
     1717             ,input  v-diasize-proc-name
     1718             ,input  'width':u
     1719             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1720             ) .
     1721         end.
     1722       end.
     1723     end.
     1724     assign
     1725       v-diasize-change-size = false
     1726     .
     1727   end procedure.
     1728   procedure diasize_set-width :
     1729     define input  parameter p-new-width  as decimal   no-undo .
     1730     define input  parameter p-move-resize as logical   no-undo .
     1731     do
     1732     on error undo, return error return-value
     1733     :
     1734       run diasize_change-width in this-procedure
     1735         (input  (p-new-width - frame Dialog-Frame :width)
     1736         ,input  p-move-resize
     1737         ) .
     1738     end.
     1739   end procedure.
     1740   procedure diasize_position-resize-button :
     1741     do with frame Dialog-Frame
     1742     :
     1743       hide v-diasize-resize-button .
     1744       assign
     1745         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1746                     - 1
     1747                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1748         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1749                     - 1
     1750                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1751       .
     1752       view v-diasize-resize-button .
     1753     end.
     1754   end procedure.
     1755   on alt-right anywhere
     1756   do:
     1757     run diasize_change-width in this-procedure
     1758       (input 1
     1759       ,input true
     1760       ) .
     1761     return no-apply .
     1762   end.
     1763   on alt-left anywhere
     1764   do:
     1765     run diasize_change-width in this-procedure
     1766       (input -1
     1767       ,input true
     1768       ) .
     1769     return no-apply .
     1770   end.
     1771   on alt-down anywhere
     1772   do:
     1773     run diasize_change-height in this-procedure
     1774       (input 1
     1775       ,input true
     1776       ) .
     1777     return no-apply .
     1778   end.
     1779   on alt-up anywhere
     1780   do:
     1781     run diasize_change-height in this-procedure
     1782       (input -1
     1783       ,input true
     1784       ) .
     1785     return no-apply .
     1786   end.
     1787   on alt-enter of frame Dialog-Frame
     1788   do:
     1789     run diasize_maximize in this-procedure
     1790       (input  ?
     1791       ).
     1792     return no-apply .
     1793   end.
     1794   procedure diasize_end-move :
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       define variable v-row-delta as decimal   no-undo .
     1799       define variable v-col-delta as decimal   no-undo .
     1800       define variable v-new-row as decimal   no-undo .
     1801       define variable v-new-col as decimal   no-undo .
     1802       assign
     1803         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1804         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1805       .
     1806       assign
     1807         v-row-delta = v-new-row - frame Dialog-Frame :height
     1808         v-col-delta = v-new-col - frame Dialog-Frame :width
     1809       .
     1810       run diasize_change-height in this-procedure
     1811         (input v-row-delta
     1812         ,input true
     1813         ) .
     1814       run diasize_change-width in this-procedure
     1815         (input v-col-delta
     1816         ,input true
     1817         ) .
     1818     end.
     1819   end procedure.
     1820   procedure diasize_maximize :
     1821     define input  parameter p-action as logical   no-undo .
     1822     do
     1823     on error undo, return error return-value
     1824     :
     1825       if p-action = ?
     1826       then do:
     1827         if v-diasize-need-maximize = true
     1828         then do:
     1829           assign
     1830             p-action = true
     1831           .
     1832         end.
     1833         else do:
     1834           assign
     1835             p-action = false
     1836           .
     1837         end.
     1838       end.
     1839       if p-action = true
     1840       then do:
     1841         run diasize_change-height in this-procedure
     1842           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1843               - frame Dialog-Frame :height-chars
     1844           ,input true
     1845           ) .
     1846         run diasize_change-width in this-procedure
     1847           (input session :width-chars
     1848               - frame Dialog-Frame :width-chars
     1849           ,input true
     1850           ) .
     1851         assign
     1852           v-diasize-need-maximize = false
     1853         .
     1854       end.
     1855       else do:
     1856         run diasize_change-width in this-procedure
     1857           (input v-diasize-orig-frame-width
     1858               - frame Dialog-Frame :width-chars
     1859           ,input true
     1860           ) .
     1861         run diasize_change-height in this-procedure
     1862           (input v-diasize-orig-frame-height
     1863               - frame Dialog-Frame :height-chars
     1864           ,input true
     1865           ) .
     1866         assign
     1867           v-diasize-need-maximize = true
     1868         .
     1869       end.
     1870     end.
     1871   end procedure.
     1872   procedure diasize_restore-orig-size :
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876       assign
     1877         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1878         v-diasize-current-frame-height = frame Dialog-Frame :height
     1879       .
     1880       run diasize_set-height in this-procedure
     1881         (input  v-diasize-orig-frame-height
     1882         ,input  true
     1883         ) .
     1884       run diasize_set-width in this-procedure
     1885         (input  v-diasize-orig-frame-width
     1886         ,input  true
     1887         ) .
     1888     end.
     1889   end procedure.
     1890   procedure diasize_restore-current-size :
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       run diasize_set-height in this-procedure
     1895         (input  v-diasize-current-frame-height
     1896         ,input  true
     1897         ) .
     1898       run diasize_set-width in this-procedure
     1899         (input  v-diasize-current-frame-width
     1900         ,input  true
     1901         ) .
     1902     end.
     1903   end procedure.
     1904   procedure diasize_set-browse-handle :
     1905     define input  parameter p-browse-handle as handle   no-undo .
     1906     define buffer buf_temp-browse-handle for temp-browse-handle .
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910       assign
     1911         v-diasize-browse-handle = p-browse-handle
     1912       .
     1913       for each buf_temp-browse-handle
     1914       on error undo, return error return-value
     1915       :
     1916         delete buf_temp-browse-handle .
     1917       end.
     1918     end.
     1919   end procedure.
     1920   procedure diasize_add_browse :
     1921     define input  parameter p-browse-type   as character no-undo .
     1922     define input  parameter p-browse-handle as handle    no-undo .
     1923     define buffer buf_temp-browse-handle for temp-browse-handle .
     1924     do
     1925     on error undo, return error return-value
     1926     :
     1927       assign
     1928         v-diasize-browse-number = v-diasize-browse-number + 1
     1929       .
     1930       create buf_temp-browse-handle .
     1931       assign
     1932         buf_temp-browse-handle.browse-type   = p-browse-type
     1933         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1934         buf_temp-browse-handle.browse-handle = p-browse-handle
     1935       .
     1936     end.
     1937   end procedure.
     1938   procedure diasize_init :
     1939     define variable v-default-value    as logical   no-undo .
     1940     define variable v-restore-saved    as logical   no-undo .
     1941     define variable v-resize-value-str as character no-undo .
     1942     do
     1943     on error undo, return error return-value
     1944     :
     1945       do with frame Dialog-Frame
     1946       :
     1947         assign
     1948           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1949           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1950           v-diasize-browse-handle     = browse BROWSE-30 :handle
     1951         .
     1952         create button v-diasize-resize-button
     1953         assign
     1954           parent        = frame Dialog-Frame :first-child
     1955           label         = "s"
     1956           height-pixels = 16
     1957           width-pixels  = 16
     1958           visible       = true
     1959           sensitive     = true
     1960           movable       = true
     1961           triggers:
     1962             on end-move persistent run diasize_end-move in this-procedure .
     1963           end triggers.
     1964         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1965         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1966         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1967         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1968         assign
     1969           v-diasize-wndmax = false
     1970         .
     1971         if connected("ub") = true
     1972         then do:
     1973           define variable v-cntxt-db-num        as integer   no-undo .
     1974           define variable v-cntxt-userid        as character no-undo .
     1975           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1976                                             , OUTPUT v-cntxt-userid
     1977                                             ) .
     1978           run gbl/wndpar_r.p
     1979             (input  v-cntxt-db-num
     1980             ,input  v-cntxt-userid
     1981             ,input  'wndmax':U
     1982             ,output v-diasize-wndmax
     1983             ,output v-default-value
     1984             ) .
     1985         end.
     1986         assign
     1987           v-diasize-wndstore = false
     1988         .
     1989         if connected("ub") = true
     1990         then do:
     1991           run gbl/wndpar_r.p
     1992             (input  v-cntxt-db-num
     1993             ,input  v-cntxt-userid
     1994             ,input  'wndstore':U
     1995             ,output v-diasize-wndstore
     1996             ,output v-default-value
     1997             ) .
     1998         end.
     1999         assign
     2000           v-diasize-proc-name = entry(1, program-name(2), '.')
     2001         .
     2002         if v-diasize-wndstore = true
     2003         then do:
     2004           assign
     2005             v-restore-saved = false
     2006           .
     2007           if connected("ub") = true
     2008           then do:
     2009             run gbl/wndsizer.p
     2010               (input  v-cntxt-db-num
     2011               ,input  v-cntxt-userid
     2012               ,input  v-diasize-proc-name
     2013               ,input  'height':u
     2014               ,output v-resize-value-str
     2015               ) .
     2016             if v-resize-value-str <> '':U
     2017             then do:
     2018               run diasize_change-height in this-procedure
     2019                 (input  integer(v-resize-value-str)
     2020                 ,input  true
     2021                 ) .
     2022               assign
     2023                 v-restore-saved = true
     2024               .
     2025             end.
     2026           end.
     2027           if connected("ub") = true
     2028           then do:
     2029             run gbl/wndsizer.p
     2030               (input  v-cntxt-db-num
     2031               ,input  v-cntxt-userid
     2032               ,input  v-diasize-proc-name
     2033               ,input  'width':u
     2034               ,output v-resize-value-str
     2035               ) .
     2036             if v-resize-value-str <> '':U
     2037             then do:
     2038               run diasize_change-width in this-procedure
     2039                 (input  integer(v-resize-value-str)
     2040                 ,input  true
     2041                 ) .
     2042               assign
     2043                 v-restore-saved = true
     2044               .
     2045             end.
     2046           end.
     2047           if v-restore-saved <> true
     2048           then do:
     2049             if v-diasize-wndmax = true
     2050             then do:
     2051               run diasize_maximize in this-procedure
     2052                 (input  true
     2053                 ) .
     2054             end.
     2055           end.
     2056         end.
     2057         else do:
     2058           if v-diasize-wndmax = true
     2059           then do:
     2060             run diasize_maximize in this-procedure
     2061               (input  true
     2062               ) .
     2063           end.
     2064         end.
     2065       end.
     2066     end.
     2067   end procedure.
     2068   procedure diasize_need-full-display :
     2069     define output parameter p-need-full-display as logical   no-undo .
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       assign
     2074         p-need-full-display = v-diasize-need-full-display
     2075       .
     2076       assign
     2077         v-diasize-need-full-display = false
     2078       .
     2079     end.
     2080   end procedure.
     2081   procedure get-context :
     2082      define output parameter p-db-num as integer          no-undo.
     2083      define output parameter p-user-id as character        no-undo.
     2084      define variable v-login               as character    no-undo.
     2085      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2086      define buffer buf_user-login  for ub.user-login .
     2087      do
     2088      on error undo, return error
     2089      :
     2090            FIND FIRST buf_sys-ctrl no-lock.
     2091            ASSIGN
     2092               v-login = USERID("ub")
     2093               p-db-num = buf_sys-ctrl.db-num
     2094            .
     2095            FIND FIRST buf_user-login
     2096                 WHERE buf_user-login.db-num = p-db-num
     2097                   AND buf_user-login.user-login = v-login
     2098                 no-lock
     2099                 no-error
     2100                 .
     2101            IF AVAILABLE buf_user-login
     2102            THEN DO:
     2103               assign
     2104                  p-user-id = buf_user-login.user-id
     2105               .
     2106            END.
     2107      end.
     2108   end procedure.
     2109       run diasize_init in this-procedure .
     2110   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2111   on F9 of frame Dialog-Frame anywhere do:
     2112     run get_gds-rec.
     2113     if gds-rec = ? then
     2114       return no-apply.
     2115     run ref/gds-form.w ( input parparentproc
     2116                         ,input 'ПРОСМОТР':U
     2117                         ,input ?
     2118                         ,input ?
     2119                         ,input ?
     2120                         ,input-output gds-rec).
     2121     apply "entry" to browse-30 in frame Dialog-Frame.
     2122     return no-apply.
     2123   end.
     2124   on F2 of frame dialog-frame  anywhere do:
     2125    return no-apply.
     2126   end.
     2127   def var sort-labelBROWSE-30   as character no-undo .
     2128   def var sort-clmnBROWSE-30    as handle    no-undo .
     2129   def var cur-clmnBROWSE-30     as handle    no-undo .
     2130   def var cur-clmn-locBROWSE-30 as integer   no-undo .
     2131   def var re-queryBROWSE-30     as logical   initial no no-undo .
     2132   on start-search, ctrl-o of BROWSE-30 in frame dialog-frame do:
     2133      run sort-brBROWSE-30
     2134        (input (if available post-ord-line-rcv
     2135                then recid(post-ord-line-rcv)
     2136                else ?
     2137               )
     2138        ).
     2139   end.
     2140   PROCEDURE sort-brBROWSE-30 :
     2141     define input parameter p-recid as recid no-undo .
     2142     if re-queryBROWSE-30 = no then do:
     2143       assign
     2144          cur-clmnBROWSE-30 = BROWSE-30:current-column in frame dialog-frame
     2145       .
     2146       if sort-clmnBROWSE-30 <> ? then sort-clmnBROWSE-30:column-fgcolor = 0.
     2147       if cur-clmnBROWSE-30 = sort-clmnBROWSE-30 then do:
     2148         assign
     2149            sort-labelBROWSE-30 = ""
     2150            sort-clmnBROWSE-30 = ?
     2151         .
     2152        end.
     2153        else do:
     2154          assign
     2155            sort-labelBROWSE-30 = cur-clmnBROWSE-30:label
     2156            sort-clmnBROWSE-30  = cur-clmnBROWSE-30
     2157            sort-clmnBROWSE-30:column-fgcolor = 4
     2158          .
     2159        end.
     2160      end.
     2161     assign
     2162       cur-clmn-locBROWSE-30 = 1
     2163     .
     2164     def var column-handle as handle no-undo .
     2165     column-handle = BROWSE-30:first-column.
     2166     do while valid-handle(column-handle) :
     2167       if column-handle = cur-clmnBROWSE-30 then do:
     2168         leave .
     2169       end.
     2170       column-handle = column-handle:NEXT-COLUMN.
     2171       assign
     2172         cur-clmn-locBROWSE-30 = cur-clmn-locBROWSE-30 + 1
     2173       .
     2174     end.
     2175     case sort-labelBROWSE-30:
     2176           when 'Артикул'  then DO:   assign     sort-column-name = "post-ord-line-rcv.artic"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.artic .   . END.
     2177           when 'Наименование'  then DO:   assign     sort-column-name = "Post-goods.gds-name"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY Post-goods.gds-name .   . END.
     2178           when 'Ед.изм!баз.'  then DO:   assign     sort-column-name = "Post-goods.unit-base"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY Post-goods.unit-base .   . END.
     2179           when 'Кол-во!(баз.ед.изм.)'  then DO:   assign     sort-column-name = "post-ord-line-rcv.qnty"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.qnty .   . END.
     2180           when 'Ед.изм!пост'  then DO:   assign     sort-column-name = "post-ord-line-rcv.unit-cli"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.unit-cli .   . END.
     2181           when 'Кол-во!(ед.изм.пост)'  then DO:   assign     sort-column-name = "post-ord-line-rcv.cli-qnty"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.cli-qnty .   . END.
     2182           when 'Цена!(нац.вал.)'  then DO:   assign     sort-column-name = "post-ord-line-rcv.price-rubl"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.price-rubl .   . END.
     2183           when 'Цена!(баз.вал.)'  then DO:   assign     sort-column-name = "post-ord-line-rcv.price-base"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.price-base .   . END.
     2184           when 'Цена!(пост-ка)'  then DO:   assign     sort-column-name = "post-ord-line-rcv.price-cli"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.price-cli .   . END.
     2185           when '№'  then DO:   assign     sort-column-name = "post-ord-line-rcv.line-num"   .   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and     bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code  NO-LOCK,        EACH Post-goods where     Post-goods.artic  =  post-ord-line-rcv.artic  and     Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and     Post-goods.prod-type  =  post-ord-line-rcv.prod-type    NO-LOCK BY post-ord-line-rcv.line-num .   . END.
     2186       otherwise do:
     2187         assign
     2188           sort-column-name = ""
     2189         .
     2190         run openbr.
     2191           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-30') then do:
     2192             run mv-brw-defaultBROWSE-30.
     2193           end.
     2194         if sort-labelBROWSE-30 <> "" then do:
     2195           assign
     2196             cur-clmnBROWSE-30:column-fgcolor = 0
     2197           .
     2198         end.
     2199         assign
     2200           cur-clmn-locBROWSE-30 = ?
     2201         .
     2202       end.
     2203     end case.
     2204       if cur-clmn-locBROWSE-30 <> ? then do:
     2205         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-30') then do:
     2206           run ch-clmnBROWSE-30 in this-procedure (cur-clmn-locBROWSE-30).
     2207         end.
     2208       end.
     2209     if p-recid <> ? then do:
     2210       reposition BROWSE-30 to recid p-recid no-error.
     2211       apply "value-changed" to BROWSE-30 in frame dialog-frame.
     2212     end.
     2213     apply "entry" to BROWSE-30 in frame dialog-frame.
     2214   END PROCEDURE.
     2215   procedure re-open-query-srt-clmnBROWSE-30:
     2216   if cur-clmnBROWSE-30 = ? then do:
     2217      run openbr.
     2218   end.
     2219   else do:
     2220      assign re-queryBROWSE-30 = yes.
     2221      run sort-brBROWSE-30
     2222        (input (if available post-ord-line-rcv
     2223                then recid(post-ord-line-rcv)
     2224                else ?
     2225               )
     2226        ).
     2227      assign re-queryBROWSE-30 = no.
     2228   end.
     2229   end.
     2230   ASSIGN
     2231     b-export:POPUP-MENU IN FRAME dialog-frame  = MENU m-export-2:HANDLE
     2232     b-export:MENU-MOUSE = 1.
     2233   next-prev = yes.
     2234   n-p: do while next-prev :
     2235   MAIN-BLOCK:
     2236   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2237      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2238      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2239      find first bufs_ord-doc-rcv no-lock  where recid(bufs_ord-doc-rcv) = p-ord-rec  no-error .
     2240        if not available bufs_ord-doc-rcv then do:
     2241           next-prev = ?.
     2242           return error.
     2243           end.
     2244     Post-goods.gds-name:resizable in browse BROWSE-30  = true .
     2245     run input-p in this-procedure no-error .
     2246     run enable_ui in this-procedure no-error .
     2247     if bufs_ord-doc-rcv.ord-int2 = integer('2':U)  then
     2248        display B-diff with frame dialog-frame .
     2249     else hide  B-diff in frame dialog-frame .
     2250   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251   DEF VAR cur-clmn-numBROWSE-30 as INT EXTENT 10 no-undo.
     2252   DEF VAR varmviBROWSE-30       as INT no-undo.
     2253   DEF VAR varmvjBROWSE-30       as INT no-undo.
     2254   DEF VAR varmvkBROWSE-30       as INT no-undo.
     2255   DEF VAR varmvlBROWSE-30       as INT no-undo.
     2256   DEF VAR move-elementBROWSE-30 as INT no-undo.
     2257   def var jjBROWSE-30           as int no-undo.
     2258   do varmviBROWSE-30 = 1 to EXTENT(cur-clmn-numBROWSE-30):
     2259     ASSIGN cur-clmn-numBROWSE-30[varmviBROWSE-30] = varmviBROWSE-30.
     2260   END.
     2261   RUN start-mv-clmnBROWSE-30.
     2262   PROCEDURE start-mv-clmnBROWSE-30:
     2263   def var old-session as logical no-undo.
     2264      old-session = SESSION:IMMEDIATE-DISPLAY.
     2265      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2266      SESSION:IMMEDIATE-DISPLAY = old-session.
     2267   END.
     2268   ON ctrl-cursor-right OF BROWSE BROWSE-30 do:
     2269     RUN re-move-clmnBROWSE-30 ( 2, 10).
     2270   END.
     2271   ON ctrl-cursor-left OF BROWSE BROWSE-30 do:
     2272     RUN re-move-clmnBROWSE-30 (10, 2).
     2273   END.
     2274   PROCEDURE re-move-clmnBROWSE-30:
     2275     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2276     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2277     DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     2278       if cur-clmn-numBROWSE-30[varmviBROWSE-30] = source-column THEN cur-clmn-numBROWSE-30[varmviBROWSE-30] = -1.
     2279     END.
     2280     if BROWSE-30:MOVE-COLUMN(source-column, target-column) IN FRAME dialog-frame then.
     2281     if source-column > target-column THEN
     2282     DO varmvjBROWSE-30 = source-column - 1 to target-column BY -1:
     2283       DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     2284           if cur-clmn-numBROWSE-30[varmviBROWSE-30] = varmvjBROWSE-30 THEN DO:
     2285             cur-clmn-numBROWSE-30[varmviBROWSE-30] = cur-clmn-numBROWSE-30[varmviBROWSE-30] + 1.
     2286           END.
     2287       END.
     2288     END.
     2289     ELSE
     2290     DO varmvjBROWSE-30 = source-column + 1 to target-column:
     2291       DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     2292         if cur-clmn-numBROWSE-30[varmviBROWSE-30] = varmvjBROWSE-30 THEN DO:
     2293           cur-clmn-numBROWSE-30[varmviBROWSE-30] = cur-clmn-numBROWSE-30[varmviBROWSE-30] - 1.
     2294         END.
     2295       END.
     2296     END.
     2297     DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     2298       if cur-clmn-numBROWSE-30[varmviBROWSE-30] = -1 THEN cur-clmn-numBROWSE-30[varmviBROWSE-30] = target-column.
     2299     END.
     2300   END PROCEDURE.
     2301   PROCEDURE ch-clmnBROWSE-30:
     2302     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2303     if cur-clmn-loc <= 2 then do:
     2304       return .
     2305     end.
     2306     DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     2307       if cur-clmn-numBROWSE-30[varmviBROWSE-30] = cur-clmn-loc THEN move-elementBROWSE-30 = varmviBROWSE-30.
     2308     END.
     2309     RUN re-move-clmnBROWSE-30 (cur-clmn-loc, 2).
     2310   END PROCEDURE.
     2311   PROCEDURE mv-brw-defaultBROWSE-30:
     2312   def var old-session as logical no-undo.
     2313     old-session = SESSION:IMMEDIATE-DISPLAY.
     2314     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2315     do varmvlBROWSE-30 = 2 to EXTENT(cur-clmn-numBROWSE-30):
     2316       RUN re-move-clmnBROWSE-30 (cur-clmn-numBROWSE-30[varmvlBROWSE-30], varmvlBROWSE-30).
     2317     END.
     2318     RUN start-mv-clmnBROWSE-30.
     2319     SESSION:IMMEDIATE-DISPLAY = old-session.
     2320   END PROCEDURE.
     2321   .
     2322     WAIT-FOR GO OF FRAME  dialog-frame  .
     2323   END.
     2324   END.
     2325   run disable_ui  in this-procedure no-error .
     2326   PROCEDURE disable_UI :
     2327     HIDE FRAME Dialog-Frame.
     2328   END PROCEDURE.
     2329   PROCEDURE enable_UI :
     2330     OPEN QUERY Dialog-Frame FOR EACH bufs_ord-doc-rcv where recid(bufs_ord-doc-rcv) = p-ord-rec no-LOCK,              first ub.ord-doc-rcv where  recid(ord-doc-rcv) = p-ord-rec no-lock ,              EACH post-clients WHERE                       bufs_ord-doc-rcv.cli-code = post-clients.obj-code and                       bufs_ord-doc-rcv.cli-type = post-clients.obj-type  no-LOCK ,              EACH obj-clients WHERE                       bufs_ord-doc-rcv.obj-code = obj-clients.obj-code and                       bufs_ord-doc-rcv.obj-type = obj-clients.obj-type  no-LOCK.
     2331     GET FIRST Dialog-Frame.
     2332     DISPLAY loc-type-doc loc-cli-out-code post_obj-name obj_obj-name l-loc-hour
     2333             l-loc-min l-loc-hour-2 l-loc-min-2 abbr-cli abbr-base
     2334         WITH FRAME Dialog-Frame.
     2335     IF AVAILABLE ub.ord-doc-rcv THEN
     2336       DISPLAY ub.ord-doc-rcv.rcv-code ub.ord-doc-rcv.doc-code
     2337             ub.ord-doc-rcv.cli-code ub.ord-doc-rcv.cli-type
     2338             ub.ord-doc-rcv.obj-code ub.ord-doc-rcv.obj-type
     2339             ub.ord-doc-rcv.ship-date ub.ord-doc-rcv.exch-rate
     2340             ub.ord-doc-rcv.exch-scale ub.ord-doc-rcv.exch-code
     2341             ub.ord-doc-rcv.base-rate ub.ord-doc-rcv.base-scale
     2342         WITH FRAME Dialog-Frame.
     2343     ENABLE B-exit b-prev b-next B-diff B-delivery B-Help RECT-3 BROWSE-35 B-trn
     2344            b-lkp b-scl b-export BROWSE-30 ub.ord-doc-rcv.rcv-code loc-type-doc
     2345            ub.ord-doc-rcv.doc-code loc-cli-out-code ub.ord-doc-rcv.cli-code
     2346            ub.ord-doc-rcv.cli-type post_obj-name obj_obj-name
     2347            ub.ord-doc-rcv.obj-code ub.ord-doc-rcv.obj-type
     2348            ub.ord-doc-rcv.ship-date l-loc-hour l-loc-min l-loc-hour-2 l-loc-min-2
     2349            abbr-cli ub.ord-doc-rcv.exch-rate ub.ord-doc-rcv.exch-scale
     2350            ub.ord-doc-rcv.exch-code abbr-base ub.ord-doc-rcv.base-rate
     2351            ub.ord-doc-rcv.base-scale
     2352         WITH FRAME Dialog-Frame.
     2353     VIEW FRAME Dialog-Frame.
     2354     OPEN QUERY  BROWSE-30 FOR EACH post-ord-line-rcv  NO-LOCK     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and           bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code ,        EACH Post-goods  NO-LOCK where      Post-goods.artic      =  post-ord-line-rcv.artic  and      Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and      Post-goods.prod-type  =  post-ord-line-rcv.prod-type by post-ord-line-rcv.line-num.
     2355     OPEN QUERY BROWSE-35 FOR EACH buf_ord-chain NO-LOCK  where           buf_ord-chain.doc-code = ub.ord-doc-rcv.rcv-code and           buf_ord-chain.doc-type = 'rcv'                  and           buf_ord-chain.rel-doc-type = 'trn'   INDEXED-REPOSITION.
     2356   END PROCEDURE.
     2357   PROCEDURE get_gds-rec :
     2358   if not available Post-goods then return .
     2359   gds-rec = recid(Post-goods) .
     2360   END PROCEDURE.
     2361   PROCEDURE input-p :
     2362   do
     2363    on error undo, return error return-value
     2364    :
     2365    ASSIGN
     2366     v-deliv-type-code     =  bufs_ord-doc-rcv.deliv-type-code
     2367     v-point-obj-code      =  bufs_ord-doc-rcv.obj-point-code
     2368     v-point-cli-code      =  bufs_ord-doc-rcv.cli-point-code
     2369     v-point-obj-db-num    =  bufs_ord-doc-rcv.obj-point-db-num
     2370     v-point-cli-db-num    =  bufs_ord-doc-rcv.cli-point-db-num
     2371     v-transport-host-code      =  bufs_ord-doc-rcv.transport-host-code
     2372     v-transport-cli-type      =  bufs_ord-doc-rcv.transport-cli-type
     2373     v-transport-cli-code      =  bufs_ord-doc-rcv.transport-cli-code
     2374     v-transport-contract  =  bufs_ord-doc-rcv.transport-contract
     2375     v-transport-condition =  bufs_ord-doc-rcv.transport-condition
     2376     v-transport-value     =  bufs_ord-doc-rcv.transport-value
     2377     v-transport-sum       =  bufs_ord-doc-rcv.sum-ship
     2378     v-transport-vat       =  bufs_ord-doc-rcv.transport-vat
     2379     .
     2380   define buffer b_trn-doc for ub.trn-doc .
     2381   find first post-clients no-lock where
     2382               post-clients.obj-code = bufs_ord-doc-rcv.cli-code   and
     2383               post-clients.obj-type = bufs_ord-doc-rcv.cli-type
     2384               no-error .
     2385               post_obj-name = post-clients.obj-name.
     2386   find first obj-clients no-lock where
     2387               bufs_ord-doc-rcv.obj-code = obj-clients.obj-code and
     2388               bufs_ord-doc-rcv.obj-type = obj-clients.obj-type
     2389               no-error .
     2390               obj_obj-name = obj-clients.obj-name.
     2391   for each ub.ord-chain no-lock where
     2392             ub.ord-chain.doc-code = bufs_ord-doc-rcv.rcv-code and
     2393             ub.ord-chain.doc-type = 'rcv'                  and
     2394             ub.ord-chain.rel-doc-type = 'trn'
     2395             :
     2396   end.
     2397   find first ub.currency no-lock   where ub.currency.curr-code = bufs_ord-doc-rcv.EXCH-CODE no-error.
     2398     if available ub.currency then abbr-cli = ub.currency.curr-abbr .
     2399   define variable   p-exch-rate  as decimal   no-undo .
     2400   define variable   p-exch-scale as decimal   no-undo .
     2401   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2403     (input  base-code
     2404     ,input  today
     2405     ,output p-exch-rate
     2406     ,output p-exch-scale
     2407     ,output abbr-base
     2408     )  .
     2409   loc-doc-type = bufs_ord-doc-rcv.doc-type.
     2410   Assign
     2411      loc-time       = string( bufs_ord-doc-rcv.ship-time ,"HH:MM")
     2412      loc-time-2     = string( bufs_ord-doc-rcv.fact-ship-time ,"HH:MM")
     2413      l-loc-hour     = integer (entry(1,loc-time,":"))
     2414      l-loc-min      = integer (entry(2,loc-time,":"))
     2415      l-loc-hour-2   = integer (entry(1,loc-time-2,":"))
     2416      l-loc-min-2    = integer (entry(2,loc-time-2,":"))
     2417      loc-type-doc    = IF (bufs_ord-doc-rcv.doc-type = "out":U) THEN ("внешн") ELSE ("внутр")
     2418      loc-base-rate   = bufs_ord-doc-rcv.base-rate
     2419      loc-base-scale  = bufs_ord-doc-rcv.base-scale
     2420      loc-exch-code   = bufs_ord-doc-rcv.exch-code
     2421      loc-exch-rate   = bufs_ord-doc-rcv.exch-rate
     2422      loc-exch-scale  = bufs_ord-doc-rcv.exch-scale
     2423      loc-cli-out-code =  entry(1,bufs_ord-doc-rcv.sub-par,chr(4))
     2424      no-error .
     2425      assign frame dialog-frame:title  = "ПОСТАВКА " + bufs_ord-doc-rcv.rcv-code + " - " + 'ПРОСМОТР':U .
     2426     assign
     2427       post-ord-line-rcv.qnty :read-only      in browse BROWSE-30 = true
     2428       post-ord-line-rcv.cli-qnty:read-only   in browse browse-30 = true
     2429       post-ord-line-rcv.price-cli:read-only  in browse browse-30 = true
     2430       post-ord-line-rcv.line-num:read-only   in browse browse-30 = true.
     2431      enable b-trn  with frame  dialog-frame .
     2432     view frame dialog-frame  .
     2433     display  BROWSE-30 with frame  dialog-frame.
     2434     OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv  NO-LOCK     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and           bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code ,        EACH Post-goods  NO-LOCK where      Post-goods.artic      =  post-ord-line-rcv.artic  and      Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and      Post-goods.prod-type  =  post-ord-line-rcv.prod-type.
     2435     find first ub.goods no-lock where ub.goods.gds-code = Post-goods.gds-code no-error .
     2436   end.
     2437   END PROCEDURE.
     2438   PROCEDURE look-trn-all :
     2439   do
     2440    on error undo, return error return-value
     2441    :
     2442     display  browse-30 with frame  dialog-frame.
     2443     OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv  NO-LOCK     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and           bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code ,        EACH Post-goods  NO-LOCK where      Post-goods.artic      =  post-ord-line-rcv.artic  and      Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and      Post-goods.prod-type  =  post-ord-line-rcv.prod-type.
     2444     find first ub.goods  no-lock where ub.goods.gds-code = Post-goods.gds-code no-error .
     2445   end.
     2446   END PROCEDURE.
     2447   PROCEDURE openbr :
     2448    do
     2449    on error undo, return error return-value
     2450    :
     2451   OPEN QUERY BROWSE-30 FOR EACH post-ord-line-rcv  NO-LOCK     where bufs_ord-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and           bufs_ord-doc-rcv.doc-code = post-ord-line-rcv.doc-code ,        EACH Post-goods  NO-LOCK where      Post-goods.artic      =  post-ord-line-rcv.artic  and      Post-goods.prod-code  =  post-ord-line-rcv.prod-code  and      Post-goods.prod-type  =  post-ord-line-rcv.prod-type.
     2452   end.
     2453   END PROCEDURE.
     2454   PROCEDURE step-next :
     2455    do
     2456    on error undo, return error return-value
     2457    :
     2458   if valid-handle (br-rcv-handle) then do:
     2459     g#log = br-rcv-handle:select-next-row().
     2460     if not g#log then message "Это последний документ списка.".
     2461   end.
     2462       doc-rec = recid ( bufs_ord-doc-rcv ).
     2463       p-ord-rec = recid ( bufs_ord-doc-rcv ).
     2464       next-prev = true .
     2465       line-rec = ? .
     2466       prt-rec  = ? .
     2467     end.
     2468   END PROCEDURE.
     2469   PROCEDURE step-prev :
     2470    do
     2471    on error undo, return error return-value
     2472    :
     2473   if valid-handle (br-rcv-handle) then do:
     2474     g#log = br-rcv-handle:select-prev-row().
     2475     if not g#log then message "Это первый документ списка.".
     2476   end.
     2477   doc-rec   = recid ( bufs_ord-doc-rcv ) .
     2478   p-ord-rec = recid ( bufs_ord-doc-rcv ) .
     2479   next-prev = true .
     2480   line-rec = ?.
     2481   prt-rec = ?.
     2482     end.
     2483   END PROCEDURE.
