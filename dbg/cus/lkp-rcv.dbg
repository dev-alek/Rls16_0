      460   define variable v-transport-vat        as decimal   no-undo .
      461   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      462     run mainmenu_getcntxt in parparentproc
      463       (output v-cntxt-db-num
      464       ,output v-cntxt-userid
      465       ,output v-cntxt-level
      466       ,output v-cntxt-host-code-obj
      467       ,output v-cntxt-obj-type
      468       ,output v-cntxt-obj-code
      469       ,output v-cntxt-db-num-obj
      470       ,output v-cntxt-is-admin
      471       ) .
      472   assign
      473     store-type    = v-cntxt-obj-type
      474     store-code    = v-cntxt-obj-code
      475     g#mainmenu-handle = parParentProc
      476   .
      477   if store-type = ? or store-type = "" then do:
      478       p-host-code = v-cntxt-host-code-obj .
      479       define buffer buf_clients-name for ub.clients  .
      480       find first buf_clients-name no-lock where buf_clients-name.obj-code =  p-host-code and
      481                                                 buf_clients-name.obj-type = 'орг':U no-error .
      482       p-g#host-name = buf_clients-name.obj-name.
      483   end.
      484   else do:
      485   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      487     (input  store-type
      488     ,input  store-code
      489     ,output p-host-code
      490     ,output p-g#host-name
      491     )  .
      492       p-host-code   = v-cntxt-host-code-obj.
      493   end.
      494   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      496     (input  p-host-code
      497     ,output base-code
      498     )  .
      499   define buffer b-ord-line for ub.ord-line-rcv  .
      500   define variable loc-time as char no-undo   .
      501   define variable loc-time-2 as char no-undo .
      502   define variable sort-column-name as character no-undo .
      503   define variable kk as integer no-undo .
      504   define variable doc-mode as character no-undo .
      505   DEFINE MENU m-export-2
      506          MENU-ITEM m___Excel-2    LABEL "Экспорт в Excel"
      507          MENU-ITEM m_mobilscn-2   LABEL "Экспорт в Моб.сканер".
      508   DEFINE BUTTON B-delivery
      509        LABEL "&Доставка"
      510        SIZE 10 BY 1
      511        BGCOLOR 8 .
      512   DEFINE BUTTON B-diff
      513        LABEL "&Разница"
      514        SIZE 10 BY 1
      515        BGCOLOR 8 .
      516   DEFINE BUTTON B-exit AUTO-GO
      517        LABEL "Вы&ход"
      518        SIZE 10 BY 1
      519        BGCOLOR 8 .
      520   DEFINE BUTTON b-export
      521        LABEL "&Экспорт"
      522        SIZE 10 BY 1 TOOLTIP "Экспорт".
      523   DEFINE BUTTON B-Help
      524        LABEL "&Помощь"
