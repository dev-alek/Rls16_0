      448   define variable v-deliv-type-code    as integer   no-undo .
      449   define variable v-point-obj-code     as integer   no-undo .
      450   define variable v-point-cli-code     as integer   no-undo .
      451   define variable v-point-obj-db-num   as integer   no-undo .
      452   define variable v-point-cli-db-num   as integer   no-undo .
