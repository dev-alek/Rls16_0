      529        SIZE 10 BY 1 TOOLTIP "Просмотр строки".
      530   DEFINE BUTTON b-next AUTO-GO
      531        LABEL "&>>"
      532        SIZE 5 BY 1 TOOLTIP "Предыдущая поставка"
      533        BGCOLOR 8 .
      534   DEFINE BUTTON b-prev AUTO-GO
      535        LABEL "&<<"
      536        SIZE 5 BY 1 TOOLTIP "Предыдущая поставка"
      537        BGCOLOR 8 .
