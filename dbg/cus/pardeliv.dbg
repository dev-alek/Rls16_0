        1   define input  parameter       parParentproc          as handle no-undo .
        2   define input  parameter       p-mode                 as character no-undo .
        3   define input  parameter       p-type-doc             as character no-undo .
        4   define input  parameter       p-curr-obj-type        as character no-undo .
        5   define input  parameter       p-curr-obj-code        as integer   no-undo .
        6   define input  parameter       p-cli-type             as character no-undo .
        7   define input  parameter       p-cli-code             as integer   no-undo .
        8   define input-output parameter p-deliv-type-code      as integer   no-undo .
        9   define input-output parameter p-point-obj-code       as integer   no-undo .
       10   define input-output parameter p-point-obj-db-num     as integer   no-undo .
       11   define input-output parameter p-point-cli-code       as integer   no-undo .
       12   define input-output parameter p-point-cli-db-num     as integer   no-undo .
       13   define input-output parameter p-transport-host-code       as integer   no-undo .
       14   define input-output parameter p-transport-cli-type       as character no-undo .
       15   define input-output parameter p-transport-cli-code       as integer   no-undo .
       16   define input-output parameter p-transport-contract   as integer   no-undo .
       17   define input-output parameter p-transport-condition  as integer   no-undo .
       18   define input-output parameter p-transport-value      as decimal   no-undo .
       19   define input-output parameter p-transport-sum        as decimal   no-undo .
       20   define input-output parameter p-transport-vat        as decimal   no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Параметры доставки".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133     define variable v-cntxt-db-num        as integer   no-undo .
      134     define variable v-cntxt-userid        as character no-undo .
      135     define variable v-cntxt-level         as character no-undo .
      136     define variable v-cntxt-host-code-obj as integer   no-undo .
      137     define variable v-cntxt-obj-type      as character no-undo .
      138     define variable v-cntxt-obj-code      as integer   no-undo .
      139     define variable v-cntxt-db-num-obj    as integer   no-undo .
      140     define variable v-cntxt-is-admin      as logical   no-undo .
      141   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142     run mainmenu_getcntxt in parparentproc
      143       (output v-cntxt-db-num
      144       ,output v-cntxt-userid
      145       ,output v-cntxt-level
      146       ,output v-cntxt-host-code-obj
      147       ,output v-cntxt-obj-type
      148       ,output v-cntxt-obj-code
      149       ,output v-cntxt-db-num-obj
      150       ,output v-cntxt-is-admin
      151       ) .
      152   define buffer cargo_clients  for ub.clients  .
      153   define buffer cargo_contract for ub.contract .
      154   define buffer buf_delivery-type for ub.delivery-type  .
      155   define variable curr-host-code as integer   no-undo .
      156   define buffer buf_place-io for ub.place-io  .
      157   define buffer buf_point-io for ub.point-io  .
      158   DEFINE BUTTON B-Cancel AUTO-END-KEY
      159        LABEL "Отмена"
      160        SIZE 10 BY 1
      161        BGCOLOR 8 .
      162   DEFINE BUTTON B-contract
      163        IMAGE-UP FILE "cmp/btn-fnd.bmp":U
      164        IMAGE-DOWN FILE "cmp/btn-fnd.bmp":U
      165        IMAGE-INSENSITIVE FILE "cmp/btn-fnd.bmp":U NO-CONVERT-3D-COLORS
      166        LABEL ""
      167        SIZE 3 BY .79 TOOLTIP "Посмотреть договор".
      168   DEFINE BUTTON B-Help
      169        LABEL "Помо&щь"
      170        SIZE 10 BY 1
      171        BGCOLOR 8 .
      172   DEFINE BUTTON B-save AUTO-GO
      173        LABEL "Ввод"
      174        SIZE 10 BY 1
      175        BGCOLOR 8 .
      176   DEFINE BUTTON r-deliv
      177        IMAGE-UP FILE "btn-down-arrow":U
      178        IMAGE-DOWN FILE "btn-down-arrow":U
      179        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      180        LABEL ""
      181        SIZE 3 BY .88.
      182   DEFINE BUTTON r-point-1
      183        IMAGE-UP FILE "btn-down-arrow":U
      184        IMAGE-DOWN FILE "btn-down-arrow":U
      185        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      186        LABEL ""
      187        SIZE 3 BY .88.
      188   DEFINE BUTTON r-point-2
      189        IMAGE-UP FILE "btn-down-arrow":U
      190        IMAGE-DOWN FILE "btn-down-arrow":U
      191        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      192        LABEL ""
      193        SIZE 3 BY .88.
      194   DEFINE BUTTON r-wrkr
      195        IMAGE-UP FILE "btn-down-arrow":U
      196        IMAGE-DOWN FILE "btn-down-arrow":U
      197        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      198        LABEL ""
      199        SIZE 3 BY .88.
      200   DEFINE BUTTON r-wrkr-2
      201        IMAGE-UP FILE "btn-down-arrow":U
      202        IMAGE-DOWN FILE "btn-down-arrow":U
      203        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      204        LABEL ""
      205        SIZE 3 BY 1.
      206   DEFINE VARIABLE scr-trasport-condition AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 1
      207        LABEL "Условия транспортных услуг"
      208        VIEW-AS COMBO-BOX INNER-LINES 5
      209        LIST-ITEM-PAIRS "Неопеределены",0
      210        DROP-DOWN-LIST
      211        SIZE 65.13 BY 1 NO-UNDO.
      212   DEFINE VARIABLE scr-deliv-type-code AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      213        LABEL "Способ доставки"
      214         VIEW-AS TEXT
      215        SIZE 7 BY .67 NO-UNDO.
      216   DEFINE VARIABLE scr-deliv-type-name AS CHARACTER FORMAT "X(256)":U
      217         VIEW-AS TEXT
      218        SIZE 60.5 BY .67
      219        FGCOLOR 4  NO-UNDO.
      220   DEFINE VARIABLE scr-point-cli-code AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      221        LABEL "Пункт  приемки"
      222         VIEW-AS TEXT
      223        SIZE 7 BY .67 NO-UNDO.
      224   DEFINE VARIABLE scr-point-cli-name AS CHARACTER FORMAT "X(256)":U
      225         VIEW-AS TEXT
      226        SIZE 60.5 BY .67
      227        FGCOLOR 4  NO-UNDO.
      228   DEFINE VARIABLE scr-point-obj-code AS INTEGER FORMAT ">>>>>>>":U INITIAL 0
      229        LABEL "Пункт отгрузки"
      230         VIEW-AS TEXT
      231        SIZE 7 BY .67 NO-UNDO.
      232   DEFINE VARIABLE scr-point-obj-name AS CHARACTER FORMAT "X(256)":U
      233         VIEW-AS TEXT
      234        SIZE 60.5 BY .67
      235        FGCOLOR 4  NO-UNDO.
      236   DEFINE VARIABLE scr-transport-cli-type AS CHARACTER FORMAT "X(3)":U
      237         VIEW-AS TEXT
      238        SIZE 3.63 BY .67 NO-UNDO.
      239   DEFINE VARIABLE scr-transport-contract AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
      240        LABEL "Транспортный договор"
      241         VIEW-AS TEXT
      242        SIZE 10.13 BY .79 TOOLTIP "Договор транспортных услуг" NO-UNDO.
      243   DEFINE VARIABLE scr-transport-cli-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
      244        LABEL "Грузоперевозчик"
      245         VIEW-AS TEXT
      246        SIZE 10.13 BY .67 NO-UNDO.
      247   DEFINE VARIABLE scr-transport-host-name AS CHARACTER FORMAT "X(120)":U
      248         VIEW-AS TEXT
      249        SIZE 37.38 BY .67
      250        FGCOLOR 4  NO-UNDO.
      251   DEFINE VARIABLE scr-transport-name AS CHARACTER FORMAT "X(20)":U
      252         VIEW-AS TEXT
      253        SIZE 12.88 BY .79
      254        FGCOLOR 4  NO-UNDO.
      255   DEFINE VARIABLE scr-transport-sum AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      256        LABEL "Сумма транспортных услуг"
      257        VIEW-AS FILL-IN
      258        SIZE 21.5 BY 1 NO-UNDO.
      259   DEFINE VARIABLE scr-transport-value AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
      260        LABEL ""
      261        VIEW-AS FILL-IN
      262        SIZE 14 BY 1 NO-UNDO.
      263   DEFINE VARIABLE scr-transport-vat-pc AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      264        LABEL "НДС услуги,%"
      265        VIEW-AS FILL-IN
      266        SIZE 6.63 BY 1 NO-UNDO.
      267   DEFINE FRAME Dialog-Frame
      268        B-save AT ROW 1 COL 1
      269        B-Cancel AT ROW 1 COL 11
      270        B-Help AT ROW 1 COL 86
      271        r-deliv AT ROW 2 COL 30.38
      272        r-point-1 AT ROW 3 COL 30.38
      273        r-point-2 AT ROW 4 COL 30.38
      274        r-wrkr AT ROW 6 COL 38
      275        r-wrkr-2 AT ROW 7 COL 33.63
      276        B-contract AT ROW 7 COL 50
      277        scr-trasport-condition AT ROW 8 COL 1.62
      278        scr-transport-value AT ROW 9 COL 27.63 COLON-ALIGNED
      279        scr-transport-sum AT ROW 10 COL 27.63 COLON-ALIGNED
      280        scr-transport-vat-pc AT ROW 11 COL 27.63 COLON-ALIGNED
      281        scr-deliv-type-code AT ROW 2 COL 20.88 COLON-ALIGNED
      282        scr-deliv-type-name AT ROW 2 COL 31.63 COLON-ALIGNED NO-LABEL
      283        scr-point-obj-code AT ROW 3 COL 20.88 COLON-ALIGNED
      284        scr-point-obj-name AT ROW 3 COL 31.63 COLON-ALIGNED NO-LABEL
      285        scr-point-cli-code AT ROW 4 COL 20.88 COLON-ALIGNED
      286        scr-point-cli-name AT ROW 4 COL 31.63 COLON-ALIGNED NO-LABEL
      287        scr-transport-cli-code AT ROW 6 COL 21 COLON-ALIGNED
      288        scr-transport-cli-type AT ROW 6 COL 32.38 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      289        scr-transport-host-name AT ROW 6 COL 39 COLON-ALIGNED NO-LABEL
      290        scr-transport-contract AT ROW 7 COL 21 COLON-ALIGNED
      291        scr-transport-name AT ROW 7 COL 34.63 COLON-ALIGNED NO-LABEL
      292        SPACE(46.98) SKIP(6.24)
      293       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      294            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      295            TITLE "Условия доставки"
      296            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      297   ASSIGN
      298          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      299          FRAME Dialog-Frame:HIDDEN           = TRUE.
      300   ON GO OF FRAME Dialog-Frame
      301   DO:
      302     RUN save-proc no-error .
      303     if error-status :error then return no-apply .
      304   END.
      305   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      306   DO:
      307     APPLY "END-ERROR":U TO SELF.
      308   END.
      309   ON CHOOSE OF B-contract IN FRAME Dialog-Frame
      310   DO:
      311   assign scr-transport-contract .
      312   define buffer b_contract for ub.contract.
      313   find first b_contract no-lock  where b_contract.contract-code     = scr-transport-contract and
      314                                        b_contract.host-code         = curr-host-code
      315                                        no-error .
      316   if error-status :error then return no-apply.
      317   run str/sh-contr.p (
      318       input parParentProc ,
      319       input recid (b_contract))
      320       .
      321   END.
      322   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      323   OR HELP OF FRAME Dialog-Frame
      324   DO:
      325   END.
      326   ON CHOOSE OF r-deliv IN FRAME Dialog-Frame
      327   DO:
      328   define variable v-sts as integer init 0  no-undo .
      329   define variable v-rid-list as character no-undo .
      330          scr-deliv-type-code = 0 .
      331          scr-deliv-type-name = "".
      332   run ref/dlvtypes.w
      333     ( input parParentProc
      334     , input  p-curr-obj-type
      335     , input  p-curr-obj-code
      336     , input  "b-sel":U
      337     , input  'все':U
      338     , input-output v-sts
      339     , input-output v-rid-list )
      340         no-error .
      341       find first buf_delivery-type no-lock where recid(buf_delivery-type) = integer(v-rid-list) no-error .
      342       if available  buf_delivery-type then do:
      343          scr-deliv-type-code = buf_delivery-type.deliv-type-code.
      344          scr-deliv-type-name = buf_delivery-type.deliv-type-name.
      345       end.
      346       display scr-deliv-type-code
      347               scr-deliv-type-name
      348               with frame Dialog-Frame .
      349   END.
      350   ON CHOOSE OF r-point-1 IN FRAME Dialog-Frame
      351   DO:
      352     scr-point-obj-code = 0.
      353     scr-point-obj-name = "".
      354     if p-curr-obj-code = ? then return .
      355     define variable rid-list as character no-undo .
      356     case  p-type-doc  :
      357         when "rcv" + 'ОО':U or
      358         when "rcv" + 'ФП':U or
      359         when "ord" + 'ОР':U or
      360         when "ord" + 'ОО':U or
      361         when "ord" + 'ПО':U or
      362         when "ord" + 'ОФ':U or
      363         when "ord" + 'ОП':U
      364         then do:
      365               run ref/place-io.w
      366                 (input  parparentproc
      367                 ,input  'b-sel'
      368                 ,input  p-curr-obj-type
      369                 ,input  p-curr-obj-code
      370                 ,input  'объект':U
      371                 ,input  'all'
      372                 ,input-output rid-list
      373                 ).
      374               find first buf_place-io no-lock where
      375                   recid (buf_place-io) = integer(rid-list) no-error .
      376               if available buf_place-io then do:
      377                   scr-point-obj-code  = buf_place-io.place-io-code.
      378                   scr-point-obj-name  = buf_place-io.place-io-name.
      379               end.
      380           end.
      381     end case.
      382     display scr-point-obj-code
      383             scr-point-obj-name
      384     with frame Dialog-Frame .
      385   END.
      386   ON CHOOSE OF r-point-2 IN FRAME Dialog-Frame
      387   DO:
      388     scr-point-cli-code = 0.
      389     scr-point-cli-name = "".
      390     if p-cli-code = ? then return .
      391     define variable rid-list as character no-undo .
      392     case  p-type-doc  :
      393         when "rcv" + 'ОО':U or
      394         when "ord" + 'ОР':U or
      395         when "ord" + 'ОО':U then do:
      396               run ref/place-io.w
      397                 (input  parparentproc
      398                 ,input  'b-sel'
      399                 ,input  p-cli-type
      400                 ,input  p-cli-code
      401                 ,input  'объект':U
      402                 ,input  'all'
      403                 ,input-output rid-list
      404                 ).
      405               find first buf_place-io no-lock where
      406                   recid (buf_place-io) = integer(rid-list) no-error .
      407               if available buf_place-io then do:
      408                   scr-point-cli-code = buf_place-io.place-io-code .
      409                   scr-point-cli-name = buf_place-io.place-io-name .
      410               end.
      411         end.
      412         when "ord" + 'ПО':U or
      413         when "ord" + 'ОФ':U or
      414         when "ord" + 'ФП':U or
      415         when "rcv" + 'ФП':U or
      416         when "ord" + 'ОП':U
      417         then do:
      418         run ref/point-io.w
      419           (input  parparentproc
      420           ,input  'b-sel'
      421           ,input  v-cntxt-db-num
      422           ,input  p-cli-type
      423           ,input  p-cli-code
      424           ,input  'объект':U
      425           ,input  'all'
      426           ,input-output rid-list
      427           ).
      428         find first buf_point-io no-lock where
      429               recid (buf_point-io) = integer(rid-list) no-error .
      430         if available buf_point-io then do:
      431             p-point-cli-db-num  = buf_point-io.db-num.
      432             scr-point-cli-code  = buf_point-io.point-code.
      433             scr-point-cli-name  = buf_point-io.point-name.
      434         end.
      435     END.
      436     END CASE.
      437     display scr-point-cli-code
      438             scr-point-cli-name
      439     with frame Dialog-Frame .
      440   END.
      441   ON CHOOSE OF r-wrkr IN FRAME Dialog-Frame
      442   DO:
      443   define variable rid-list as character no-undo.
      444   scr-transport-cli-code   = 0 .
      445   scr-transport-cli-type   = "" .
      446   scr-transport-host-name = "".
      447     run ref/cli-all.w
      448         ( input parParentProc,
      449           input "b-sel",
      450           input 'орг':U,
      451           input 'все':U,
      452           input 'текущие':U,
      453           input ?,
      454           input ",,,,,,NO,,":U,
      455           input "without-obj",
      456           output rid-list ) .
      457   find first cargo_clients no-lock where
      458        recid (cargo_clients) = integer(rid-list) no-error .
      459       if available cargo_clients then do:
      460           scr-transport-cli-code  = cargo_clients.obj-code .
      461           scr-transport-cli-type  = cargo_clients.obj-type .
      462           scr-transport-host-name = cargo_clients.obj-name .
      463       end.
      464   display scr-transport-cli-code
      465           scr-transport-host-name
      466           scr-transport-cli-type
      467           with frame Dialog-Frame.
      468   END.
      469   ON CHOOSE OF r-wrkr-2 IN FRAME Dialog-Frame
      470   DO:
      471   IF scr-transport-cli-code = 0  THEN DO:
      472      message "Не выбран грузоперевозчик !"  view-as alert-box information .
      473      return no-apply .
      474   END.
      475   define variable   rid-list   as character no-undo .
      476   define buffer buf_contract for ub.contract.
      477   ASSIGN scr-transport-cli-code .
      478   scr-transport-contract = 0  .
      479   scr-transport-name     = "" .
      480   run str/cont-all.w (
      481         input   parParentProc   ,
      482         input   curr-host-code  ,
      483         input   "b-sel"         ,
      484         input   'фирма':U      ,
      485         input   scr-transport-cli-type ,
      486         input   scr-transport-cli-code ,
      487         input   ?               ,
      488         input   ?               ,
      489         input   "current"       ,
      490         input   "all"           ,
      491         input-output rid-list )
      492         .
      493   find first buf_contract no-lock where recid (buf_contract) =  integer(rid-list) no-error .
      494   if available buf_contract then do:
      495     scr-transport-contract = buf_contract.contract-code .
      496     scr-transport-name     = buf_contract.contract-prn-code.
      497     end.
      498   DISPLAY scr-transport-contract
      499           scr-transport-name
      500       WITH FRAME Dialog-Frame.
      501   END.
      502   ON return OF scr-point-cli-name IN FRAME Dialog-Frame
      503   DO:
      504       run next-focus in this-procedure  (input  scr-point-cli-name:handle ) .
      505     return no-apply .
      506   END.
      507   ON return OF scr-point-obj-name IN FRAME Dialog-Frame
      508   DO:
      509       run next-focus in this-procedure  (input  scr-point-obj-name:handle ) .
      510     return no-apply .
      511   END.
      512   ON return OF scr-transport-cli-type IN FRAME Dialog-Frame
      513   DO:
      514     run next-focus in this-procedure  (input  scr-transport-cli-type:handle ) .
      515     return no-apply .
      516   END.
      517   ON return OF scr-transport-contract IN FRAME Dialog-Frame
      518   DO:
      519     run next-focus in this-procedure  (input  scr-transport-contract:handle ) .
      520     return no-apply .
      521   END.
      522   ON return OF scr-transport-cli-code IN FRAME Dialog-Frame
      523   DO:
      524     run next-focus in this-procedure  (input  scr-transport-cli-code:handle ) .
      525     return no-apply .
      526   END.
      527   ON return OF scr-transport-host-name IN FRAME Dialog-Frame
      528   DO:
      529       run next-focus in this-procedure  (input  scr-transport-host-name:handle ) .
      530     return no-apply .
      531   END.
      532   ON return OF scr-transport-name IN FRAME Dialog-Frame
      533   DO:
      534       run next-focus in this-procedure  (input  scr-transport-name:handle ) .
      535     return no-apply .
      536   END.
      537   ON VALUE-CHANGED OF scr-trasport-condition IN FRAME Dialog-Frame
      538   DO:
      539    if scr-trasport-condition:screen-value = '1':U
      540       then do:
      541         assign
      542         scr-transport-value:visible = true
      543         .
      544       end.
      545       else
      546         scr-transport-value:visible = false  .
      547   END.
      548   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      549   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      550   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   on help of frame Dialog-Frame
      552   do:
      553     run gbl/app_help.p
      554       (input this-procedure :file-name
      555       ,input ''
      556       ,input ?
      557       ) no-error.
      558     if error-status :error then do:
      559       message
      560         "Ошибка при вызове помощи"
      561         error-status :get-message(1)
      562         view-as alert-box .
      563     end.
      564   end.
      565   run minbtn-set in this-procedure .
      566   on choose of b-help in frame Dialog-Frame
      567   do:
      568     apply "help":u to frame Dialog-Frame .
      569   end.
      570   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure minbtn-set :
      572       do
      573           on error undo, return error return-value
      574           :
      575           define variable ii              as integer       no-undo .
      576           define variable fh              as widget-handle no-undo .
      577           define variable hh              as widget-handle no-undo .
      578           define variable v-h             as handle        extent 4 no-undo .
      579           define variable v-name-button   as character     no-undo .
      580           define variable v-help-old-x    as decimal       no-undo .
      581           define variable v-help-old-y    as decimal       no-undo .
      582           define variable v-help-old-size as decimal       no-undo .
      583           define variable v-frame-width   as decimal       no-undo .
      584           define variable jj              as integer       no-undo .
      585           do
      586               on error undo, return error
      587               :
      588               assign
      589                   v-frame-width = frame Dialog-Frame:width - 0.3
      590                   fh            = frame Dialog-Frame:first-child
      591                   hh            = fh:first-child
      592                   ii            = 1
      593                   .
      594               do while valid-handle(hh):
      595                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      596                   do:
      597                       case lc(hh:name) :
      598                           when "b-help" then
      599                               do:
      600                                   hh:load-image-up("cmp/b-help.bmp":u) .
      601                                   hh:load-image-down("cmp/b-help.bmp":u) .
      602                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      603                                   hh:TOOLTIP = "Помощь" .
      604                                   v-help-old-x = hh:column .
      605                                   v-help-old-y = hh:row    .
      606                                   v-help-old-size = hh:width .
      607                                   hh:width-chars = 2.5 .
      608                               end.
      609                           when "b-print" then
      610                               do:
      611                                   hh:load-image("cmp/b-print.bmp":u) .
      612                                   hh:TOOLTIP = "Печать" .
      613                                   v-h[ii] = hh:handle .
      614                                   ii = ii + 1 .
      615                                   hh:width-chars = 3 .
      616                               end.
      617                           when "b-history" or
      618                           when "b-hist" then
      619                               do:
      620                                   hh:load-image("cmp/b-hist.bmp":u) .
      621                                   hh:TOOLTIP = "История" .
      622                                   v-h[ii] = hh:handle .
      623                                   ii = ii + 1 .
      624                                   hh:width-chars = 3 .
      625                               end.
      626                           when "b-sch" then
      627                               do:
      628                                   hh:load-image("cmp/b-sch.bmp":u) .
      629                                   hh:TOOLTIP = "Установка Фильтра" .
      630                                   v-h[ii] = hh:handle .
      631                                   ii = ii + 1 .
      632                                   hh:width-chars = 3 .
      633                               end.
      634                           when "b-hist-user" then
      635                               do:
      636                                   hh:load-image("cmp/b-hist.bmp":u) .
      637                                   hh:TOOLTIP = "История пользователя" .
      638                                   ii = ii + 1 .
      639                               end.
      640                       end case.
      641                   end.
      642                   hh = hh:next-sibling.
      643               end.
      644               b-help:column = v-frame-width - b-help:width-chars.
      645               jj = 0.
      646               repeat ii = 4 to 1 by -1 :
      647                   if valid-handle (v-h[ii] ) then
      648                   do:
      649                       jj  = jj + 1 .
      650                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      651                       v-h[ii]:row    = v-help-old-y .
      652                   end.
      653               end.
      654           end.
      655       end.
      656   end procedure.
      657   MAIN-BLOCK:
      658   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      659      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      660     run init-proc in this-procedure .
      661     if p-mode = 'ПРОСМОТР':U then
      662          run lkp-enable in this-procedure .
      663     else run enable_ui in this-procedure .
      664     if scr-trasport-condition = integer ('1':U)
      665       then
      666         assign
      667           scr-transport-value:visible = yes
      668           scr-transport-value:label = "%"
      669           .
      670       else scr-transport-value:visible = no .
      671      if  p-type-doc  = "ord" + 'ПО':U
      672      then
      673      assign
      674        scr-point-obj-code:label = "Отгрузка"
      675        scr-point-cli-code:label = "Доставка до"
      676      .
      677      else
      678      assign
      679        scr-point-obj-code:label = "Прием"
      680        scr-point-cli-code:label = "Отгрузка с"
      681      .
      682     wait-for go of frame Dialog-Frame.
      683   end.
      684   run disable_ui in this-procedure .
      685   PROCEDURE disable_UI :
      686     HIDE FRAME Dialog-Frame.
      687   END PROCEDURE.
      688   PROCEDURE enable_UI :
      689     DISPLAY scr-trasport-condition scr-transport-value scr-transport-sum
      690             scr-transport-vat-pc scr-deliv-type-code scr-deliv-type-name
      691             scr-point-obj-code scr-point-obj-name scr-point-cli-code
      692             scr-point-cli-name scr-transport-cli-code scr-transport-cli-type
      693             scr-transport-host-name scr-transport-contract scr-transport-name
      694         WITH FRAME Dialog-Frame.
      695     ENABLE B-save B-Cancel B-Help r-deliv r-point-1 r-point-2 r-wrkr r-wrkr-2
      696            B-contract scr-trasport-condition scr-transport-value
      697            scr-transport-sum scr-transport-vat-pc scr-deliv-type-code
      698            scr-deliv-type-name scr-point-obj-code scr-point-obj-name
      699            scr-point-cli-code scr-point-cli-name scr-transport-cli-code
      700            scr-transport-cli-type scr-transport-host-name scr-transport-contract
      701            scr-transport-name
      702         WITH FRAME Dialog-Frame.
      703     VIEW FRAME Dialog-Frame.
      704   END PROCEDURE.
      705   PROCEDURE init-proc :
      706   scr-trasport-condition:List-Item-Pairs in frame Dialog-Frame =
      707   "Доставка включена,0,Доставка за процент стоимости,1,Сумма доставки зависит от расстояния,2"        .
      708   assign
      709     scr-deliv-type-code     = p-deliv-type-code
      710     scr-transport-cli-code  = p-transport-cli-code
      711     scr-transport-cli-type  = p-transport-cli-type
      712     scr-trasport-condition  = p-transport-condition
      713     scr-transport-value     = p-transport-value
      714     scr-transport-sum       = p-transport-sum
      715     scr-transport-vat-pc    = p-transport-vat
      716     scr-point-obj-code      = p-point-obj-code
      717     scr-point-cli-code      = p-point-cli-code
      718     scr-transport-contract  = p-transport-contract
      719     .
      720     if p-curr-obj-code <> ? then do:
      721   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      723     (input  p-curr-obj-type
      724     ,input  p-curr-obj-code
      725     ,output curr-host-code
      726     )  .
      727     end.
      728     else do:
      729       curr-host-code = v-cntxt-host-code-obj .
      730     end.
      731     p-transport-host-code = curr-host-code .
      732   find first buf_delivery-type no-lock where
      733              buf_delivery-type.deliv-type-code = scr-deliv-type-code
      734              no-error .
      735   if available  buf_delivery-type then do:
      736       scr-deliv-type-name = buf_delivery-type.deliv-type-name.
      737   end.
      738   find first cargo_clients no-lock where
      739         cargo_clients.obj-type = scr-transport-cli-type and
      740         cargo_clients.obj-code = scr-transport-cli-code
      741         no-error .
      742       if available cargo_clients then do:
      743             scr-transport-host-name = cargo_clients.obj-name .
      744             find first cargo_contract no-lock where
      745               cargo_contract.contract-code = scr-transport-contract and
      746               cargo_contract.host-code     = curr-host-code     no-error .
      747             if available cargo_contract then do:
      748               scr-transport-name     = cargo_contract.contract-prn-code.
      749             end.
      750       end.
      751     case  p-type-doc  :
      752         when "ord" + 'ПО':U or
      753         when "ord" + 'ОФ':U or
      754         when "ord" + 'ФП':U or
      755         when "rcv" + 'ФП':U or
      756         when "ord" + 'ОП':U
      757         then do:
      758               find first buf_place-io no-lock where
      759                          buf_place-io.obj-type      = p-curr-obj-type and
      760                          buf_place-io.obj-code      = p-curr-obj-code and
      761                          buf_place-io.place-io-code = scr-point-obj-code
      762                          no-error .
      763               if available buf_place-io then do:
      764                   scr-point-obj-code = buf_place-io.place-io-code.
      765                   scr-point-obj-name = buf_place-io.place-io-name.
      766               end.
      767               find first buf_point-io no-lock where
      768                          buf_point-io.point-code = scr-point-cli-code and
      769                          buf_point-io.db-num     = p-point-cli-db-num
      770                          no-error .
      771               if available buf_point-io then do:
      772                   scr-point-cli-code = buf_point-io.point-code.
      773                   scr-point-cli-name = buf_point-io.point-name.
      774               end.
      775           end.
      776           otherwise do:
      777               find first buf_place-io no-lock where
      778                          buf_place-io.obj-type      = p-curr-obj-type and
      779                          buf_place-io.obj-code      = p-curr-obj-code and
      780                          buf_place-io.place-io-code = scr-point-obj-code
      781                          no-error .
      782               if available buf_place-io then do:
      783                   scr-point-obj-code = buf_place-io.place-io-code.
      784                   scr-point-obj-name = buf_place-io.place-io-name.
      785               end.
      786               find first buf_place-io no-lock where
      787                          buf_place-io.obj-type      = p-cli-type and
      788                          buf_place-io.obj-code      = p-cli-code and
      789                          buf_place-io.place-io-code = scr-point-cli-code
      790                          no-error .
      791               if available buf_place-io then do:
      792                   scr-point-cli-code = buf_place-io.place-io-code.
      793                   scr-point-cli-name = buf_place-io.place-io-name.
      794               end.
      795           end.
      796     end case.
      797   END PROCEDURE.
      798   PROCEDURE lkp-enable :
      799   B-Cancel:label in frame Dialog-Frame  = "&Выход".
      800     B-Cancel:column = 1.
      801     DISPLAY scr-deliv-type-code scr-transport-cli-code scr-trasport-condition
      802             scr-transport-value scr-transport-sum scr-transport-vat-pc
      803             scr-deliv-type-name scr-point-obj-code scr-point-obj-name
      804             scr-point-cli-code scr-point-cli-name scr-transport-host-name
      805             scr-transport-contract scr-transport-name
      806         WITH FRAME Dialog-Frame.
      807     ENABLE B-Cancel B-Help
      808            B-contract
      809         WITH FRAME Dialog-Frame.
      810     VIEW FRAME Dialog-Frame.
      811   END PROCEDURE.
      812   PROCEDURE next-focus :
      813   do
      814   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      815   :
      816   define input parameter p-widget-handle as handle no-undo .
      817   define variable l-apply-entry as logical no-undo .
      818   assign
      819     l-apply-entry =   true
      820   .
      821   do with frame Dialog-Frame :
      822     if  scr-point-cli-name     :handle = p-widget-handle then do:  if scr-point-obj-name     :sensitive then do: apply "entry":u to scr-point-obj-name     . return . end. end.
      823     if  scr-point-obj-name     :handle = p-widget-handle then do:  if scr-transport-contract :sensitive then do: apply "entry":u to scr-transport-contract . return . end. end.
      824     if  scr-transport-contract :handle = p-widget-handle then do:  if scr-transport-cli-code     :sensitive then do: apply "entry":u to scr-transport-cli-code     . return . end. end.
      825     if  scr-transport-cli-code     :handle = p-widget-handle then do:  if scr-transport-name     :sensitive then do: apply "entry":u to scr-transport-name     . return . end. end.
      826     end.
      827     end.
      828   END PROCEDURE.
      829   PROCEDURE save-proc :
      830   assign frame Dialog-Frame
      831   scr-deliv-type-code
      832   scr-transport-cli-code
      833   scr-trasport-condition
      834   scr-transport-value
      835   scr-transport-sum
      836   scr-transport-vat-pc
      837   scr-point-obj-code
      838   scr-point-cli-code
      839   scr-transport-contract
      840   .
      841   assign
      842     p-deliv-type-code     = scr-deliv-type-code
      843     p-transport-cli-type  = scr-transport-cli-type
      844     p-transport-cli-code  = scr-transport-cli-code
      845     p-transport-condition = scr-trasport-condition
      846     p-transport-value     = scr-transport-value
      847     p-transport-sum       = scr-transport-sum
      848     p-transport-vat       = scr-transport-vat-pc
      849     p-point-obj-code      = scr-point-obj-code
      850     p-point-cli-code      = scr-point-cli-code
      851     p-transport-contract  = scr-transport-contract
      852     .
      853   define buffer buf_contract for ub.contract  .
      854   if p-transport-contract  <> 0 and p-transport-contract  <> ? then do:
      855      find first buf_contract no-lock where
      856                 buf_contract.host-code     =  p-transport-host-code and
      857                 buf_contract.contract-code =  p-transport-contract no-error .
      858      if not available buf_contract then do:
      859         message
      860           "Не верно задан договор грузоперевозчика" skip
      861           "Фирма  : " p-transport-host-code  skip
      862           "Договор: " p-transport-contract  skip
      863           view-as alert-box error
      864         .
      865         return error .
      866         end.
      867         if not ( buf_contract.cli-type  =  p-transport-cli-type and
      868                  buf_contract.cli-code  =  p-transport-cli-code  ) then do:
      869         message
      870           "У Грузоперевозчика нет такого договора" skip
      871           "Грузоперевозчик: " p-transport-cli-type p-transport-cli-code      skip
      872           "Фирма  : " p-transport-host-code  skip
      873           "Договор: " p-transport-contract  skip
      874           view-as alert-box error
      875         .
      876         return error .
      877         end.
      878   end.
      879   END PROCEDURE.
