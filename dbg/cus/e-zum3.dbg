     1012                 buf_inkas.obj-code = obj-list.obj-code AND
     1013                 buf_inkas.status_ = 'Ù‡ÍÚ':U AND
     1014                 (
     1015                 buf_inkas.shift-date >= X-date-start AND
     1016                 buf_inkas.shift-date <= X-date-end):
     1017           IF X-Radio-Task = 3 AND
