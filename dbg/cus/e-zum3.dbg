      898   PROCEDURE no-benq.
      899   DEFINE OUTPUT PARAMETER found as logical init no.
      900   define buffer buf_chk-doc for ub.chk-doc.
      901   FOR EACH obj-list WHERE
      902           obj-list.obj-type = 'Ï‡„':U NO-LOCK :
      903     CASE X-Radio-Task > 1 :
      904       WHEN YES THEN DO:
      905         FOR EACH buf_chk-doc NO-LOCK WHERE
      906                 buf_chk-doc.obj-type = obj-list.obj-type AND
      907                 buf_chk-doc.obj-code = obj-list.obj-code AND
      908                 (
      909                   buf_chk-doc.shift-date >= X-date-start AND
      910                   buf_chk-doc.shift-date <= X-date-end)
      911                   AND
      912                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      913           IF X-Radio-Task = 3 AND
      914           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
      915             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
      916           IF X-Radio-Task = 4 AND
      917           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      918           found = yes.
      919           return.
      920         END.
      921       END.
      922       WHEN NO THEN DO:
      923         FOR EACH buf_chk-doc NO-LOCK WHERE
      924               buf_chk-doc.obj-type = obj-list.obj-type AND
      925               buf_chk-doc.obj-code = obj-list.obj-code AND
      926               buf_chk-doc.chk-date >= X-date-start AND
      927               buf_chk-doc.chk-date <= X-date-end   AND
      928               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      929           found = yes.
      930           return.
      931         END.
      932        END.
      933      END CASE.
      934    END.
      935   END PROCEDURE.
      936   PROCEDURE no-benqi.
      937   DEFINE OUTPUT PARAMETER found as logical init no.
      938   define buffer buf_chk-doc for ub.chk-doc.
      939   define buffer buf_inkas for ub.inkas.
      940   FOR EACH obj-list WHERE
      941         obj-list.obj-type = 'Ï‡„':U NO-LOCK :
      942     CASE X-Radio-Task > 1 :
      943       WHEN YES THEN DO:
      944         FOR EACH buf_chk-doc No-LOCK WHERE
      945                 buf_chk-doc.obj-type = obj-list.obj-type AND
      946                 buf_chk-doc.obj-code = obj-list.obj-code AND
      947                 (
      948                   buf_chk-doc.shift-date >= X-date-start AND
      949                   buf_chk-doc.shift-date <= X-date-end)
      950                   AND
      951                   buf_Chk-doc.out-code = ? AND
      952                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      953           IF X-Radio-Task = 3 AND
      954           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
      955             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
      956           IF X-Radio-Task = 4 AND
      957           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      958           found = yes.
      959           return.
      960         END.
      961         FOR EACH buf_inkas No-LOCK WHERE
      962                   buf_inkas.obj-type = obj-list.obj-type AND
      963                   buf_inkas.obj-code = obj-list.obj-code AND
      964                   (
      965                   buf_inkas.shift-date >= X-date-start AND
      966                   buf_inkas.shift-date <= X-date-end):
      967           if buf_inkas.status_ = 'Ù‡ÍÚ':U
      968           or buf_inkas.status_ = 'Á‡ÔÓÒ':U then next.
      969           IF X-Radio-Task = 3 AND
      970           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
      971             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
      972           IF X-Radio-Task = 4 AND
      973           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
      974           found = yes.
      975           return.
      976         END.
      977       END.
      978       WHEN NO THEN DO:
      979         FOR EACH buf_chk-doc NO-LOCK WHERE
      980                 buf_chk-doc.obj-type = obj-list.obj-type AND
      981                 buf_chk-doc.obj-code = obj-list.obj-code AND
      982                 buf_chk-doc.chk-date >= X-date-start AND
      983                 buf_chk-doc.chk-date <= X-date-end   AND
      984                 buf_Chk-doc.out-code = ? AND
      985                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      986           found = yes.
      987           return.
      988         END.
      989         FOR EACH buf_inkas NO-LOCK WHERE
      990                 buf_inkas.obj-type = obj-list.obj-type AND
      991                 buf_inkas.obj-code = obj-list.obj-code AND
      992                 buf_inkas.doc-date >= X-date-start AND
      993                 buf_inkas.doc-date <= X-date-end :
      994           if buf_inkas.status_ = 'Ù‡ÍÚ':U
      995           or buf_inkas.status_ = 'Á‡ÔÓÒ':U then next.
      996           found = yes.
      997           return.
      998         END.
      999       END.
     1000     END CASE.
     1001   END.
     1002   END PROCEDURE.
     1003   PROCEDURE no-benq-i.
     1004   DEFINE OUTPUT PARAMETER found as logical init no.
