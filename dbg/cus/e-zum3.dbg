      574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define variable v-waitfram-action01         as character   no-undo .
      576   define variable v-waitfram-action02         as character   no-undo .
      577   define variable v-waitfram-action03         as character   no-undo .
      578   define variable mWaitFramTextBeg            as character   no-undo.
      579   define variable mWaitFramTextEnd            as character   no-undo.
      580   define variable mWaitFramView               as logical     no-undo.
      581   define variable mWaitProcEvent              as logical     no-undo init yes.
      582   define variable mWaitFramInterval           as integer     no-undo init 1 .
      583   define variable mWaitFramStop               as logical     no-undo.
      584   define variable mWaitFramStopUser           as logical     no-undo.
      585   define variable mWaitFramStopTimeOut        as logical     no-undo.
      586   define variable mWaitFramStartProc          as datetime-tz no-undo.
      587   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      588   define button B-WaitFramStop auto-end-key
      589        label "—ÚÓÔ"
      590        size 10 by 1 tooltip "ŒÒÚÓÌÓ‚ËÚ¸ ÔÓˆÂÒÒ".
      591   define button B-viewProcInfo
      592        label "»ÌÙÓÏ‡ˆËˇ"
      593        size 15 by 1 tooltip "»ÌÙÓÏ‡ˆËˇ Ó ÔÓˆÂÒÒ".
      594   define frame waitfram
      595     v-waitfram-action01 format "x(72)" no-label skip
      596     v-waitfram-action02 format "x(72)" no-label skip
      597     v-waitfram-action03 format "x(72)" no-label skip
      598     B-viewProcInfo
      599     B-WaitFramStop at row 4 col 30
      600     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      601     .
      602   define new global shared variable mBatchMode as logical no-undo init ?.
      603   define variable mFramBachModHandle as handle no-undo.
      604   mFramBachModHandle = frame waitfram:handle.
      605   define variable mFameOldVis as logical no-undo.
      606   define variable mVisCUrentVin as logical no-undo.
      607   if session:batch-mode
      608   then
      609      mBatchMode = yes.
      610   if mBatchMode = ? then do:
      611     mVisCUrentVin = current-window:visible.
      612     mFameOldVis = mFramBachModHandle:visible.
      613     mFramBachModHandle:visible  = yes.
      614     mBatchMode = mFramBachModHandle:visible ne yes.
      615     mFramBachModHandle:visible = mFameOldVis.
      616     current-window:visible = mVisCUrentVin.
      617   end.
      618    if  log-manager:logfile-name ne ?
      619     then DO:
      620         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      621         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      622         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      623     end.
      624   on choose of B-WaitFramStop in frame waitfram
      625   do:
      626     mWaitFramStop = yes.
      627     mWaitFramStopUser = yes.
      628   end.
      629   function waitfram-check-timeout returns logical():
      630      define variable vtime as int64 no-undo.
      631      if mWaitFramStopTimeOut
      632      then
      633         return yes.
      634      vtime = ( now - mWaitFramStartProc ) / 1000 .
      635      if     mWaitFramTimeOut ne ?
      636         and mWaitFramTimeOut ne 0
      637         and mWaitFramTimeOut lt vtime
      638      then do:
      639         mWaitFramStopTimeOut = yes.
      640      end.
      641      return mWaitFramStopTimeOut.
      642   end.
      643   procedure waitfram-hide :
      644     if not session:batch-mode
      645     then do
      646     on error undo, return error return-value
      647     :
      648       pause 0 before-hide .
      649       if not mBatchMode then
      650         hide frame waitfram .
      651     if     not mWaitFramView
      652        and mWaitProcEvent
      653     then
      654       process events .
      655     end.
      656   end procedure.
      657   procedure waitfram-show :
      658     define input  parameter p-message as character no-undo .
      659     define variable v-left-margin as integer   no-undo .
      660     if not session:batch-mode
      661     then do
      662     on error undo, return error return-value
      663     :
      664       if length(p-message) <= 70 then do:
      665         assign
      666           v-left-margin = integer((70 - length(p-message)) / 2)
      667         .
      668         assign
      669           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      670         .
      671         assign
      672           v-waitfram-action01 = " "
      673           v-waitfram-action02 = " "
      674                                    + fill(" ", v-left-margin)
      675                                    + p-message
      676           v-waitfram-action03 = " "
      677         .
      678       end.
      679       else do:
      680         define variable vRindex1 as integer no-undo.
      681         define variable vRindex2 as integer no-undo.
      682         vRindex1 = r-index(p-message," ",70).
      683         if vRindex1 = 0
      684         then
      685            vRindex1 = 70.
      686         if length(p-message)  <= vRindex1 + 70 then do:
      687           assign
      688             v-waitfram-action01 = " "
      689             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      690             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      691           .
      692         end.
      693         else do:
      694           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      695           if vRindex2 <= vRindex1
      696           then
      697              vRindex2 = vRindex1 + 70.
      698           assign
      699             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      700             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      701             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      702           .
      703         end.
      704       end.
      705       B-viewProcInfo:visible   in frame waitfram = no.
      706       B-viewProcInfo:sensitive in frame waitfram = no.
      707       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      708       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      709       if  (   mWaitFramView
      710          or  mWaitProcEvent)
      711          and not mBatchMode
      712       then
      713          display
      714             v-waitfram-action01 skip
      715             v-waitfram-action02 skip
      716             v-waitfram-action03 skip
      717          with frame waitfram .
      718       if     mWaitFramView
      719          then do:
      720             if     mWaitFramInterval ne ?
      721                and not mBatchMode
      722             then
      723                wait-for go of frame waitfram pause mWaitFramInterval.
      724          end.
      725          else
      726             if     mWaitProcEvent
      727                and not mBatchMode
      728             then
      729                process events .
      730     end.
      731   end procedure.
      732      procedure waitfram-show-this:
      733         define input  parameter iInterval as int64 no-undo.
      734         define variable vtime as int64 no-undo.
      735         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      736         mWaitFramInterval = iInterval.
      737         run waitfram-show (substitute("&1&2 &3&4" ,
      738                                       mWaitFramTextBeg ,
      739                                       if vtime eq ? then "" else substitute (" œÓ¯ÎÓ: &1 ÒÂÍ" , string( vtime)),
      740                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " ËÁ " + string(mWaitFramTimeOut) + " ÒÂÍ. " else "",
      741                                       mWaitFramTextEnd
      742                                      )
      743                           ).
      744      end.
      745      procedure WaitFramRunPause:
      746         define input  parameter iInterval as dec no-undo.
      747         define variable vStart  as datetime-tz no-undo.
      748         define variable vend    as datetime-tz no-undo.
      749         define variable vint as int64 no-undo.
      750         define variable vOk as logical no-undo.
      751         vStart = now.
      752         vend   = vStart.
      753         publish "WaitFramPause" (iInterval,output vOk).
      754         vend   =  now.
      755         vint = vend - vStart.
      756         vint = iInterval - vint / 1000.
      757         if     not mWaitFramStop
      758            and (   vint > 0
      759                 or (    not vOk
      760                     and iInterval eq ?
      761                     )
      762                 )
      763         then
      764            run waitfram-show-this (iInterval).
      765         vend   =  now.
      766         vint = vend - vStart.
      767         vint = iInterval - vint / 1000.
      768         if     not mWaitFramStop
      769            and vint > 0
      770         then do:
      771            run gbl/pause.p (vint * 1000).
      772         end.
      773         if iInterval ne ?
      774         then
      775            publish "WaitFramStop".
      776         waitfram-check-timeout().
      777      end.
      778      procedure WaitFramWaitFor:
      779         define input  parameter iInterval as dec no-undo.
      780         assign
      781            mWaitFramStartProc   = now
      782            mWaitFramStopUser    = no
      783            mWaitFramStopTimeOut = no
      784         .
      785         block-wait:
      786         do while not mWaitFramStop:
      787            run WaitFramRunPause (iInterval).
      788            if  waitfram-check-timeout()
      789            then do:
      790               leave block-wait.
      791            end.
      792         end.
      793         run waitfram-hide.
      794      end.
      795   procedure waitfram-join :
      796     define input  parameter p-line-1  as character no-undo .
      797     define input  parameter p-line-2  as character no-undo .
      798     define input  parameter p-line-3  as character no-undo .
      799     define output parameter p-message as character no-undo .
      800     do
      801     on error undo, return error return-value
      802     :
      803       assign
      804         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      805                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      806                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      807       .
      808     end.
      809   end procedure.
      810   function waitfram-join-function returns character
      811     (input p-line-1 as character
      812     ,input p-line-2 as character
      813     ,input p-line-3 as character
      814     ).
      815     define variable v-message as character no-undo .
      816     run waitfram-join in this-procedure
      817       (input  p-line-1
      818       ,input  p-line-2
      819       ,input  p-line-3
      820       ,output v-message
      821       ) .
      822     return v-message .
      823   end function .
