      692   procedure prn-lib-prn-file :
      693     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      694     define input parameter p-DIsabledoptions as integer no-undo .
      695     define variable v-report-name as character no-undo .
      696     define variable v-user-action as character no-undo .
      697     define variable v-printed     as logical   no-undo .
      698     define variable v-exist       as logical   no-undo .
      699     do
      700       on error undo, return error
      701       :
      702       run prn-lib-get-report-name  in this-procedure (
      703         input parParentProc
      704         ,output v-report-name
      705         ).
      706   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      708     (input  v-report-name
      709     ,input  2
      710     ,output v-exist
      711     )  .
      712       if NOT v-exist then
      713       DO:
      714         Message
      715           "Нет заданий на печать ! "
      716           view-as alert-box .
      717         Return  .
      718       End.
      719       run gbl/prnfilen.w
      720         (input  ""
      721         ,input  p-DisabledOptions
      722         ,input  string(v-report-name )
      723         ,input  7
      724         ,output v-user-action
      725         ,output v-printed
      726         ) .
      727       if v-printed then
      728       do:
      729         return "YES" .
      730       end.
      731       else
      732       do:
      733         return "NO" .
      734       end.
      735     end.
      736   end procedure.
      737   procedure prn-lib-open-stream :
      738     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      739     define input parameter p-page-size    as integer no-undo .
      740     define input parameter p-is-stream    as logical no-undo .
      741     define input parameter p-append       as logical no-undo .
      742     define variable v-report-name as character no-undo .
      743     do
      744       on error undo, return error
      745       :
      746       run prn-lib-get-report-name  in this-procedure (
      747         input parParentProc
      748         ,output v-report-name
      749         ).
      750       if p-is-stream then
      751       do:
      752         if p-append then
      753         do:
      754           output stream PrnLibStream to value( v-report-name )
      755             page-size value(p-page-size) append .
      756         end.
      757         if not p-append then
      758         do:
      759           output stream PrnLibStream to value( v-report-name )
      760             page-size value(p-page-size) .
      761         end.
      762       end.
      763       if not p-is-stream then
      764       do:
      765         if p-append then
      766         do:
      767           output to value( v-report-name )
      768             page-size value(p-page-size) append .
      769         end.
      770         if not p-append then
      771         do:
      772           output to value( v-report-name )
      773             page-size value(p-page-size) .
      774         end.
      775       end.
      776     end.
      777   end procedure.
      778   procedure prn-lib-open-exp :
      779     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      780     define input parameter p-is-stream    as logical no-undo .
      781     define input parameter p-is-append    as logical no-undo .
      782     define output parameter p-ReportFileName as char init "report" no-undo.
      783     define output parameter p-process as logical no-undo .
      784     define variable glog as logical no-undo .
      785     do
      786       on error undo, return error
      787       :
      788       SYSTEM-DIALOG GET-FILE p-ReportFileName
      789         TITLE      "Укажите путь"
      790         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      791         ASK-OVERWRITE
      792         CREATE-TEST-FILE
      793         SAVE-AS
      794         USE-FILENAME
      795         DEFAULT-EXTENSION "txt"
      796         UPDATE glog
      797         .
      798       if not glog then  return.
      799       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      800       if p-is-stream then
      801       do:
      802         if p-is-append then
      803         do:
      804           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      805         end.
      806         else
      807         do:
      808           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      809         end.
      810       end.
      811       else
      812       do:
      813         if p-is-append then
      814         do:
      815           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      816         end.
      817         else
      818         do:
      819           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      820         end.
      821       end.
      822       p-process = yes.
      823     end.
      824   end procedure.
      825   procedure prn-lib-get-report-name :
      826     define input parameter parParentProc  as widget-handle no-undo.
      827     define output parameter p-report-name as character no-undo .
      828     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      829   end procedure.
      830   procedure prn-lib-reportviewer-report-name :
      831     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      832     define input parameter p-report-name-html as character no-undo .
      833     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      834   end procedure.
      835   procedure prn-lib-reportviewer :
      836     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      837     define input parameter p-report-name-html as character no-undo .
      838     define input parameter p-param        as character no-undo .
      839     define variable v-excel           as character no-undo init 'TRUE' .
      840     define variable v-value-character as character no-undo .
      841     define variable v-value-integer   as character no-undo .
      842     define variable v-value-date      as date      no-undo .
      843     define variable v-value-decimal   as decimal   no-undo .
      844     define variable rep-excel         as logical   no-undo .
      845     define variable excel-string      as character no-undo .
      846     define variable v-param-type      as character no-undo .
      847     define variable v-tth             as handle    no-undo .
      848     run adm/shattri.p (
      849       input "get":U
      850       ,input  ""
      851       ,input  0
      852       ,input  'report-glob':U
      853       ,input  'rep-excel':U
      854       ,output v-value-character
      855       ,output v-value-date
      856       ,output v-value-decimal
      857       ,output v-value-integer
      858       ,output rep-excel
      859       ,output v-param-type
      860       ,INPUT-OUTPUT table-handle v-tth
      861       )  .
      862     if rep-excel then v-excel = "TRUE" .
      863     else v-excel = "FALSE" .
      864     if p-param eq ""
      865     then
      866        p-param = "EXCEL:" + v-excel.
      867     else
      868        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      869     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      870   end procedure.
      871   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   function breakstr returns character ( input        for-name    as character,
      873                                         input        line-length as integer,
      874                                         input-output line1       as character,
      875                                         input-output line2       as character ) :
      876     define variable ii as integer no-undo.
      877     if length( for-name ) > line-length then do:
      878       assign ii    = 1
      879              line1 = "":u
      880              line2 = "":u.
      881       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      882         assign line1 =       substring( for-name, 1, line-length     )
      883                line2 = trim( substring( for-name,    line-length + 1 ) ).
      884       end.                                                     else do:
      885         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      886           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      887                  ii    = ii    + 1.
      888           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      889             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      890           end.
      891         end.
      892         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      893       end.
      894     end.                                else do:
      895       assign line1 = for-name
      896              line2 = "":u.
      897     end.
      898     return ( line1 ).
      899   end function.
