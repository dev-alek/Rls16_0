     1063   define variable temp1 as integer   no-undo.
     1064   define variable v-account as integer init 0 no-undo .
     1065   define variable v-account-lavel as character no-undo .
     1066   define variable v-button-stop as logical no-undo .
     1067   define variable v-kol-spice as integer no-undo .
     1068   define variable v-kol-spice2 as integer no-undo .
     1069   define variable v-kol-spice3 as integer no-undo .
     1070   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1071   DEFINE BUTTON StopBtn AUTO-END-KEY
     1072        LABEL "Стоп"
     1073        SIZE 10 BY 1.
     1074   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1075        LABEL "Обработано записей"
     1076         VIEW-AS TEXT
     1077        SIZE 14 BY .67 NO-UNDO.
     1078   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1079         VIEW-AS TEXT
     1080        SIZE 53.25 BY .67
     1081        FGCOLOR 1  NO-UNDO.
     1082   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1083         VIEW-AS TEXT
     1084        SIZE 53.25 BY .67
     1085        FGCOLOR 1  NO-UNDO.
     1086   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1087         VIEW-AS TEXT
     1088        SIZE 53.25 BY .67
     1089        FGCOLOR 1  NO-UNDO.
     1090   DEFINE RECTANGLE RECT-1
     1091        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1092        SIZE 55.13 BY 4.46.
     1093   DEFINE FRAME InfoFrame
     1094        StopBtn AT ROW 4.25 COL 21.75
     1095        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1096        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1097        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1098        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1099        RECT-1 AT ROW 1 COL 1
     1100       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1101            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1102            TITLE "Процесс"
     1103            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1104   define variable mFrameView      as logical   no-undo init yes.
     1105     define variable mFramHandle as handle no-undo.
     1106     mFramHandle = frame InfoFrame:handle.
     1107     if  log-manager:logfile-name ne ?
     1108     then DO:
     1109         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1110         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1111         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1112     end.
     1113     mFrameView = not session:batch-mode and mFramHandle:visible.
     1114     if mFrameView
     1115     then do:
     1116       ASSIGN
     1117          FRAME InfoFrame:HIDDEN                           = TRUE
     1118          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1119     end.
     1120   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1121   DO:
     1122     IF not StopProcessing THEN
     1123       Message "Вы действительно хотите прервать" SKIP
     1124               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1125                 UPDATE StopProcessing.
     1126     IF StopProcessing THEN do:
     1127        if mFrameView
     1128        then do:
     1129           HIDE FRAME InfoFrame.
     1130        end.
     1131     End.
     1132   END.
     1133   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     1134     if  log-manager:logfile-name ne ?
     1135     then DO:
     1136         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1137     end.
     1138     if not session:batch-mode then
     1139     do:
     1140       VIEW FRAME InfoFrame.
     1141       mFrameView = true.
     1142     end.
     1143      v-button-stop = false .
     1144         if mFrameView
     1145         then do:
     1146         if v-button-stop then view STOPBTN in frame InfoFrame.
     1147                          else Hide STOPBTN in frame InfoFrame.
     1148         end.
     1149   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   define new global shared variable g#attr-lib  as handle no-undo .
     1151   define variable v-attr-lib-variable as handle no-undo .
     1152   procedure clntattr-code :
     1153     define input  parameter p-code           as character no-undo .
     1154     define output parameter p-type           as character no-undo .
     1155     define output parameter p-format         as character no-undo .
     1156     define output parameter p-label          as character no-undo .
     1157     define output parameter p-user-can-edit  as logical   no-undo .
     1158     define output parameter p-output-display as logical   no-undo .
     1159     define output parameter p-other          as character no-undo .
     1160     do
     1161     on error undo, return error return-value
     1162     :
     1163           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     1164         (input  p-code
     1165         ,output p-type
     1166         ,output p-format
     1167         ,output p-label
     1168         ,output p-user-can-edit
     1169         ,output p-output-display
     1170         ,output p-other
     1171         ) no-error .
     1172       if error-status :error
     1173       then do:
     1174         undo, return error return-value .
     1175       end.
     1176     end.
     1177   end procedure.
