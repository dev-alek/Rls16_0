     1431   define temp-table temp-font no-undo
     1432     field fontnum  as integer
     1433     field fontname as character
     1434     field fontsize as character
     1435     field fonttype as character
     1436     field font-h   as integer
     1437     field font-w   as integer
     1438     field v-row    as integer
     1439     field v-col    as integer
     1440     field v-row-lans as integer
     1441     field v-col-lans as integer
     1442   index pi fontnum
     1443   .
     1444   procedure get-font-ini :
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448   define variable ii as integer   no-undo .
     1449   define variable v-font7 as character no-undo .
     1450   define variable v-font as character no-undo .
     1451   define variable loc-name as character no-undo .
     1452   define variable loc-size as character no-undo .
     1453   define variable loc-type as character no-undo .
     1454   define variable old_H as integer   no-undo .
     1455   define variable old_w as integer   no-undo .
     1456   define variable old-row  as integer   no-undo .
     1457   define variable old-col  as integer   no-undo .
     1458   define variable old-row-lans  as integer   no-undo .
     1459   define variable old-col-lans  as integer   no-undo .
     1460   define variable vv as integer   no-undo .
     1461   empty temp-table temp-font.
     1462     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1463       case num-entries (v-font7) :
     1464         when 4 then do:
     1465             assign
     1466               loc-name = entry ( 1 , v-font7 )
     1467               loc-size = entry ( 2 , v-font7 )
     1468               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1469             .
     1470         end.
     1471         when 3 then do:
     1472             assign
     1473               loc-name = entry ( 1 , v-font7 )
     1474               loc-size = entry ( 2 , v-font7 )
     1475               loc-type = entry ( 3 , v-font7 )
     1476             .
     1477         end.
     1478         when 2 then  do:
     1479             assign
     1480               loc-name = entry ( 1 , v-font7 )
     1481               loc-size = entry ( 2 , v-font7 )
     1482               loc-type = ""
     1483             .
     1484         end.
     1485         when 1 then do:
     1486             assign
     1487               loc-name = trim(entry ( 1 , v-font7 ))
     1488               loc-size = ""
     1489               loc-type = ""
     1490             .
     1491         end.
     1492       end case.
     1493     create temp-font.
     1494     assign
     1495       temp-font.fontnum  = 7
     1496       temp-font.fontname = trim(loc-name)
     1497       temp-font.fontsize = trim(loc-size)
     1498       temp-font.fonttype = trim(loc-type)
     1499       temp-font.v-row    = 62
     1500       temp-font.v-col    = 136
     1501       temp-font.v-row-lans = 43
     1502       temp-font.v-col-lans = 198
     1503     .
     1504     repeat ii = 16 to 100 :
     1505       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1506       if v-font = "" or v-font = ? then leave.
     1507       case num-entries (v-font) :
     1508         when 4 then do:
     1509             assign
     1510               loc-name = entry ( 1 , v-font )
     1511               loc-size = entry ( 2 , v-font )
     1512               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1513             .
     1514         end.
     1515         when 3 then do:
     1516             assign
     1517               loc-name = entry ( 1 , v-font )
     1518               loc-size = entry ( 2 , v-font )
     1519               loc-type = entry ( 3 , v-font )
     1520             .
     1521         end.
     1522         when 2 then do:
     1523             assign
     1524               loc-name = entry ( 1 , v-font )
     1525               loc-size = entry ( 2 , v-font )
     1526               loc-type = ""
     1527             .
     1528         end.
     1529         when 1 then do:
     1530             assign
     1531               loc-name = trim(entry ( 1 , v-font ))
     1532               loc-size = ""
     1533               loc-type = ""
     1534             .
     1535         end.
     1536       end case.
     1537     create temp-font.
     1538     assign
     1539       temp-font.fontnum  = ii
     1540       temp-font.fontname = trim(loc-name)
     1541       temp-font.fontsize = trim(loc-size)
     1542       temp-font.fonttype = trim(loc-type)
     1543     .
     1544     end.
     1545       for each temp-font :
     1546          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1547          if  vv = ? then vv =  0 .
     1548           run rep/exfont.p (
     1549             input   temp-font.fontname ,
     1550             input   vv ,
     1551             input   temp-font.fonttype ,
     1552             output  temp-font.font-h   ,
     1553             output  temp-font.font-w   )
     1554           .
     1555       end.
     1556   find first temp-font where  temp-font.fontnum  = 7  .
     1557   old_H = temp-font.font-H .
     1558   old_w = temp-font.font-W .
     1559   old-row = temp-font.v-row .
     1560   old-col = temp-font.v-col .
     1561   old-row-lans = temp-font.v-row-lans .
     1562   old-col-lans = temp-font.v-col-lans .
     1563       for each temp-font where
     1564                temp-font.fontnum  <> 7 :
     1565           assign
     1566               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1567               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1568               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1569               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1570           .
     1571       end.
     1572     end.
     1573   end procedure.
     1574   PROCEDURE How-name :
     1575   define input  parameter h as integer no-undo .
     1576   define input  parameter w as integer no-undo .
     1577   define output parameter n as character  no-undo .
     1578   define variable A4port-H as integer   no-undo init 63.
     1579   define variable A4port-W as integer   no-undo init 136.
     1580   define variable A4lans-H as integer   no-undo init 43.
     1581   define variable A4lans-W as integer   no-undo init 198.
     1582   define variable Strim-W  as integer   no-undo init 278.
     1583   run define-a4-size (
     1584        input ReportFontNum
     1585       ,output A4port-H
     1586       ,output A4port-W
     1587       ,output A4lans-H
     1588       ,output A4lans-W ).
     1589   If w >= 1 and w <= A4port-W Then DO:
     1590     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1591     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1592     If h > A4port-H              Then n = "to-file":U.
     1593   End.
     1594   If w > A4port-W and w <= A4lans-W Then DO:
     1595     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1596     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1597     If h > A4port-H              Then n = "to-file":U.
     1598   End.
     1599   If w > A4lans-W and w <= Strim-W Then DO:
     1600     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1601     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1602     If h > A4port-H              Then n = "to-file":U.
     1603   End.
     1604   If w > Strim-W Then DO:
     1605      n = "to-file":U.
     1606   End.
     1607   END PROCEDURE.
     1608   PROCEDURE define-a4-size :
     1609   define input  parameter p-ReportFontNum as integer   no-undo .
     1610   define output parameter A4port-H as integer   no-undo .
     1611   define output parameter A4port-W as integer   no-undo .
     1612   define output parameter A4lans-H as integer   no-undo .
     1613   define output parameter A4lans-W as integer   no-undo .
     1614   if not can-find (first temp-font ) then do:
     1615      run get-font-ini .
     1616   end.
     1617   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1618   if available temp-font then do:
     1619   assign
     1620     A4port-H = temp-font.v-row
     1621     A4port-W = temp-font.v-col
     1622     A4lans-H = temp-font.v-row-lans
     1623     A4lans-W = temp-font.v-col-lans
     1624   .
     1625   end.
     1626   else do:
     1627   assign
     1628     A4port-H = 63
     1629     A4port-W = 136
     1630     A4lans-H = 43
     1631     A4lans-W = 198
     1632   .
     1633   end.
     1634   END PROCEDURE.
     1635   DEFINE TEMP-TABLE tt-line NO-UNDO
     1636     FIELD artic        AS CHARACTER                                                     FORMAT "x(16)":U
     1637     FIELD prod-type    AS CHARACTER                                                     FORMAT "x(3)":U
     1638     FIELD prod-code    AS INTEGER                                                       FORMAT ">>>>>>>>9":U
     1639     FIELD gds-qty      AS DECIMAL   COLUMN-LABEL "Количество ! "                        FORMAT "->>>>>9.<<<":U
     1640     FIELD price-no-VAT AS DECIMAL   COLUMN-LABEL "Цена!за ед.изм."                      FORMAT "->>>>>>>9.99":U
     1641     FIELD sum-no-VAT   AS DECIMAL   COLUMN-LABEL "Стоимость товаров!всего без налога"   FORMAT "->>>>>>>>>>>>9.99":U
