     1703     sym5  SPACE( 0 ) v-sum-no-VAT       COLUMN-LABEL "Стоимость товаров!всего без налога"      SPACE( 0 )
     1704     sym6  SPACE( 0 ) v-sum-excise       COLUMN-LABEL "в т.ч.!акциз"                            SPACE( 0 )
     1705     sym7  SPACE( 0 ) ub.doc-line.Vat-pc COLUMN-LABEL "Ставка!налога"         FORMAT ">9.9<%":U SPACE( 0 )
     1706     sym8  SPACE( 0 ) v-VAT              COLUMN-LABEL "Сумма!налога"                            SPACE( 0 )
     1707     sym9  SPACE( 0 ) v-sum              COLUMN-LABEL "Ст-ть товаров!с учетом налога"           SPACE( 0 )
     1708     sym10 SPACE( 0 ) v-country          COLUMN-LABEL "Страна!происхождения"                    SPACE( 0 )
     1709     sym11 SPACE( 0 ) v-GTD              COLUMN-LABEL "Номер грузовой таможенной!декларации"    SPACE( 0 ) sym12 SPACE( 0 )
     1710   HEADER STRING( "Страница " + STRING( PAGE-NUMBER( PrnLibStream ), ">>9":U ) ) AT 180 FORMAT "x(13)":U SKIP
     1711                  v-single-line                                                  AT   1 FORMAT "x(198)":U
     1712   WITH WIDTH 235 DOWN STREAM-IO.
     1713   FORM HEADER
     1714     v-single-line FORMAT "x(198)":U       AT  1 SKIP
     1715     "Продолжение - на следующей странице" AT 30 SKIP
     1716   WITH FRAME Bottomframe WIDTH 235 PAGE-BOTTOM NO-LABELS NO-BOX.
     1717   FUNCTION SheetFormat RETURNS INTEGER :
     1718     DEFINE VARIABLE log-sheet-answer AS LOGICAL NO-UNDO.
     1719   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   do:
     1721     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1722       (input  v-cntxt-db-num
     1723       ,input  v-cntxt-userid
     1724       ,input  0
     1725       ,input  'actn_waybills-to-file_print':U
     1726       ,input  'firm':U
     1727       ,input  v-cntxt-host-code-obj
     1728       ,input  '':U
     1729       ,input  0
     1730       ,input  0
     1731       ,input  0
     1732       ,input  0
     1733       ,input  no
     1734       ,output log-sheet-answer
     1735       )  .
     1736   end.
     1737     RETURN ( IF log-sheet-answer THEN 8 ELSE 0 ).
     1738   END FUNCTION.
     1739   Main-Block:
     1740   DO ON ERROR   UNDO Main-Block, LEAVE Main-Block
     1741      ON END-KEY UNDO Main-Block, LEAVE Main-Block :
     1742     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1743     FIND buf_owner NO-LOCK WHERE
     1744          buf_owner.obj-type = 'орг':U      AND
     1745          buf_owner.obj-code = v-cntxt-host-code-obj.
     1746     FIND buf_suppl NO-LOCK WHERE
     1747          buf_suppl.obj-type = p-supp-type AND
     1748          buf_suppl.obj-code = p-supp-code NO-ERROR.
     1749     IF NOT AVAILABLE buf_suppl THEN DO:
     1750       SESSION :SET-WAIT-STATE( "":U ).
     1751       MESSAGE "Не найден поставщик: " p-supp-type p-supp-code "." VIEW-AS ALERT-BOX.
     1752       RETURN ERROR.
     1753     END.
     1754     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1755     RUN init-var IN THIS-PROCEDURE.
     1756     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1757     RUN calc-sum IN THIS-PROCEDURE.
     1758     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1759     RUN print-rs IN THIS-PROCEDURE.
     1760     SESSION :SET-WAIT-STATE( "":U ).
     1761   END.
     1762     SESSION :SET-WAIT-STATE( "":U ).
     1763   PROCEDURE init-var :
     1764     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1765     ASSIGN v-single-line   = FILL( "-", 198 )
     1766            v-lines-counter = 1
     1767            v-num           = " № " + p-scf-code + " от " +
     1768                              STRING( IF p-date-till > TODAY THEN TODAY ELSE p-date-till, "99/99/9999":U ).
     1769     IF p-ins-date THEN DO:
     1770       ASSIGN p-pay-code = p-pay-code + " от " + STRING( IF p-date-till > TODAY THEN TODAY ELSE p-date-till, "99/99/9999":U ).
     1771     END.
     1772     IF buf_owner.obj-type = 'орг':U THEN DO:
     1773       FIND buf_mf  NO-LOCK WHERE buf_mf.firm-code   = v-cntxt-host-code-obj.
     1774       ASSIGN t-m_adr = ( ( IF buf_mf.ind <> 0 THEN STRING( buf_mf.ind ) + " ":U ELSE "":U ) + buf_mf.city + " ":U +
     1775                        TRIM( buf_mf.addres1 ) + " ":U + TRIM( buf_mf.addres2 ) )
     1776              t-m_INN = buf_mf.inn + ( IF buf_mf.kpp = ? OR TRIM( buf_mf.kpp ) = "":U THEN "":U ELSE ( "/" + buf_mf.kpp ) ).
     1777     END.                           ELSE DO:
     1778       FIND buf_mp  NO-LOCK WHERE buf_mp.psn-code    = v-cntxt-host-code-obj.
     1779       ASSIGN t-m_adr = ( ( IF buf_mp.ind <> 0 THEN STRING( buf_mp.ind ) + " ":U ELSE "":U ) + buf_mp.city + " ":U +
     1780                        TRIM( buf_mp.address )                                  )
     1781              t-m_INN = buf_mp.inn + ( IF buf_mp.kpp = ? OR TRIM( buf_mp.kpp ) = "":U THEN "":U ELSE ( "/" + buf_mp.kpp ) ).
     1782     END.
     1783     IF buf_suppl.obj-type = 'орг':U THEN DO:
     1784       FIND buf_af  NO-LOCK WHERE buf_af.firm-code   = p-supp-code.
     1785       ASSIGN t-a_adr = ( ( IF buf_af.ind <> 0 THEN STRING( buf_af.ind ) + " ":U ELSE "":U ) + buf_af.city + " ":U +
     1786                        TRIM( buf_af.addres1 ) + " ":U + TRIM( buf_af.addres2 ) )
     1787              t-a_INN = buf_af.inn + ( IF buf_af.kpp = ? OR TRIM( buf_af.kpp ) = "":U THEN "":U ELSE ( "/" + buf_af.kpp ) ).
     1788     END.                           ELSE DO:
     1789       FIND buf_ap  NO-LOCK WHERE buf_ap.psn-code    = p-supp-code.
     1790       ASSIGN t-a_adr = ( ( IF buf_ap.ind <> 0 THEN STRING( buf_ap.ind ) + " ":U ELSE "":U ) + buf_ap.city + " ":U +
     1791                        TRIM( buf_ap.address ) )
     1792              t-a_INN = buf_ap.inn + ( IF buf_ap.kpp = ? OR TRIM( buf_ap.kpp ) = "":U THEN "":U ELSE ( "/" + buf_ap.kpp ) ).
     1793     END.
     1794   END PROCEDURE.
     1795   PROCEDURE calc-sum :
     1796     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1797     FOR EACH ub.parts NO-LOCK WHERE
     1798              ub.parts.host-code  = v-cntxt-host-code-obj AND
     1799              ub.parts.supp-type  = p-supp-type AND
     1800              ub.parts.supp-code  = p-supp-code AND
     1801              ub.parts.status_    = YES         AND
     1802              ub.parts.fact-date >= p-date-from AND
     1803              ub.parts.fact-date <= p-date-till :
     1804       IF ub.parts.out-code = 'free-zone':U OR ub.parts.out-code = 'out-zone':U THEN DO: NEXT. END.
     1805       FIND ub.trn-doc NO-LOCK WHERE ub.trn-doc.doc-code = ub.parts.out-code NO-ERROR.
     1806       IF NOT AVAILABLE ub.trn-doc THEN DO: NEXT. END.
     1807       IF LOOKUP( ub.trn-doc.ext-doc-type, 'pc,ee,es,re,rs':U ) = 0 THEN DO: NEXT. END.
     1808       FIND ub.doc-line NO-LOCK WHERE
     1809            ub.doc-line.doc-code  = ub.trn-doc.doc-code AND
     1810            ub.doc-line.artic     = ub.parts.artic      AND
     1811            ub.doc-line.prod-type = ub.parts.prod-type  AND
     1812            ub.doc-line.prod-code = ub.parts.prod-code  NO-ERROR.
     1813       IF NOT AVAILABLE ub.doc-line THEN DO: NEXT. END.
     1814       FIND ub.goods NO-LOCK WHERE
     1815            ub.goods.artic     = ub.doc-line.artic     AND
     1816            ub.goods.prod-type = ub.doc-line.prod-type AND
     1817            ub.goods.prod-code = ub.doc-line.prod-code NO-ERROR.
     1818       IF NOT AVAILABLE ub.goods THEN DO: NEXT. END.
     1819       IF LOOKUP( ub.trn-doc.ext-doc-type, 're,rs':U ) <> 0 THEN DO:
     1820         IF ub.parts.purch-code <> INTEGER( '4':U ) THEN DO: NEXT. END.
     1821       END.                                                               ELSE DO:
     1822         IF ub.trn-doc.ext-doc-type <> 'pc':U AND
     1823            ub.parts.purch-code      = INTEGER( '4':U ) THEN DO:
     1824         END.                                                              ELSE DO:
     1825           IF ub.trn-doc.ext-doc-type  = 'pc':U AND
     1826              ub.parts.purch-code      = INTEGER( '3':U ) AND
     1827              ub.parts.in-code        <> ub.parts.out-code THEN DO:
     1828           END.                                            ELSE DO: NEXT. END.
     1829         END.
     1830       END.
     1831       FIND obj-list WHERE
     1832            obj-list.obj-type = ub.parts.obj-type AND
     1833            obj-list.obj-code = ub.parts.obj-code NO-ERROR.
     1834       IF NOT AVAILABLE obj-list THEN DO: NEXT. END.
     1835       IF           obj-list.obj-type = 'скл':U THEN DO:
     1836         FIND ub.store NO-LOCK WHERE ub.store.obj-code = obj-list.obj-code NO-ERROR.
     1837         IF NOT AVAILABLE ub.store THEN DO: NEXT. END.
     1838         IF ub.store.host-code <> ub.parts.host-code THEN DO: NEXT. END.
     1839       END. ELSE IF obj-list.obj-type = 'маг':U  THEN DO:
     1840         FIND ub.shop  NO-LOCK WHERE ub.shop.obj-code  = obj-list.obj-code NO-ERROR.
     1841         IF NOT AVAILABLE ub.shop  THEN DO: NEXT. END.
     1842         IF ub.shop.host-code  <> ub.parts.host-code THEN DO: NEXT. END.
     1843       END.
     1844       ASSIGN is_positive = ( LOOKUP( ub.trn-doc.ext-doc-type, 're,rs':U ) = 0).
     1845       ASSIGN i-sign      = ( IF is_positive THEN 1 ELSE -1 ).
     1846       FIND FIRST ub.country NO-LOCK WHERE ub.country.alpha1 = ub.goods.alpha1 NO-ERROR.
     1847       ASSIGN v-country =  IF AVAILABLE ub.country THEN ub.country.short-name ELSE "":U .
     1848       IF ub.goods.gds-type <> 'у':U THEN DO:
     1849         ASSIGN v-GTD      = ub.parts.cst-code
     1850                v-prt-qnty = ub.parts.fact-qnty.
     1851         IF LOOKUP( ub.trn-doc.ext-doc-type, 're,rs':U ) <> 0 or ub.trn-doc.ext-doc-type = 'pc':U THEN DO: ASSIGN v-prt-qnty = - v-prt-qnty. END.
     1852   assign
     1853     price-rubl-with-tax-loc = parts.price-rubl
     1854     price-base-with-tax-loc = parts.price-base
     1855   .
     1856   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1858     (output varinvprb
     1859     )  .
     1860     if parts.out-code = 'free-zone':U     or
     1861        parts.out-code = 'out-zone':U   or
     1862        parts.doc-type = 'акт':U then do:
     1863       assign
     1864         in-vatp-have-vat-slt = yes.
     1865     end.
     1866     else do:
     1867       find first in-vatp_doc-attr no-lock
     1868         where in-vatp_doc-attr.doc-code  = parts.out-code
     1869           and in-vatp_doc-attr.attr-code = 'envd':U
     1870         no-error .
     1871       if not available in-vatp_doc-attr then do:
     1872         assign
     1873           in-vatp-have-vat-slt = yes.
     1874       end.
     1875       else do:
     1876            in-vatp-have-vat-slt = no.
     1877       end.
     1878     end.
     1879     assign
     1880      price-cli-with-tax-loc = parts.price-cli
     1881      cli-base-rate          = parts.cli-base-rate.
     1882     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
     1883              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
     1884     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
     1885             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
     1886             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
     1887             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
     1888             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
     1889             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     1890             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1891       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1892     assign
     1893       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     1894     assign
     1895       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1896       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1897       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1898       transport-cli-loc  = 0
     1899       other-cli-loc      = 0
     1900     .
     1901   ASSIGN
     1902             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1903       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1904   .
     1905         ASSIGN v-parts-VAT = ( IF PrintRubl THEN vat-rubl-loc      ELSE vat-base-loc      )
     1906                v-parts-SLT = ( IF PrintRubl THEN slt-rubl-loc      ELSE slt-base-loc      )
     1907                v-tax-price = ( IF PrintRubl THEN road-tax-rubl-loc ELSE road-tax-base-loc ).
     1908         IF v-parts-VAT = ? THEN DO: ASSIGN v-parts-VAT = 0. END.
     1909         IF v-parts-SLT = ? THEN DO: ASSIGN v-parts-SLT = 0. END.
     1910         IF v-tax-price = ? THEN DO: ASSIGN v-tax-price = 0. END.
     1911         ASSIGN v-parts-price-no-VAT =
     1912                  ( IF PrintRubl THEN ( price-rubl-with-tax-loc - ( vat-rubl-loc + slt-rubl-loc + road-tax-rubl-loc ) )
     1913                                 ELSE ( price-base-with-tax-loc - ( vat-base-loc + slt-base-loc + road-tax-base-loc ) ) )
     1914                v-parts-sum          =
     1915                  ( IF PrintRubl THEN   price-rubl-with-tax-loc ELSE price-base-with-tax-loc ) * v-prt-qnty.
     1916       END.
     1917       FIND FIRST tt-line WHERE
     1918                  tt-line.artic        = ub.goods.artic       AND
     1919                  tt-line.prod-type    = ub.goods.prod-type   AND
     1920                  tt-line.prod-code    = ub.goods.prod-code   AND
     1921                  tt-line.VAT-pc       = ub.doc-line.VAT-pc   AND
     1922                  tt-line.price-no-VAT = v-parts-price-no-VAT AND
     1923                  tt-line.GTD          = v-GTD                NO-ERROR.
     1924       IF NOT AVAILABLE tt-line THEN DO:
     1925         CREATE tt-line.
     1926         ASSIGN tt-line.artic        = ub.goods.artic
     1927                tt-line.prod-type    = ub.goods.prod-type
     1928                tt-line.prod-code    = ub.goods.prod-code
     1929                tt-line.VAT-pc       = ub.doc-line.VAT-pc
     1930                tt-line.price-no-VAT = v-parts-price-no-VAT
     1931                tt-line.country      = v-country
     1932                tt-line.GTD          = v-GTD.
     1933       END.
     1934       ASSIGN tt-line.gds-qty    = tt-line.gds-qty    + ABS( v-prt-qnty                        ) * i-sign
     1935              tt-line.sum-no-VAT = tt-line.sum-no-VAT + ABS( v-parts-price-no-VAT * v-prt-qnty ) * i-sign
     1936              tt-line.VAT        = tt-line.VAT        + ABS( v-parts-VAT          * v-prt-qnty ) * i-sign
     1937              tt-line.sum        = tt-line.sum        + ABS( v-parts-sum                       ) * i-sign.
     1938     END.
     1939     FOR EACH tt-line :
     1940       IF ( ( tt-line.gds-qty      = 0 ) OR ( tt-line.gds-qty      = ? ) ) AND
     1941          ( ( tt-line.sum-no-VAT   = 0 ) OR ( tt-line.sum-no-VAT   = ? ) ) AND
     1942          ( ( tt-line.VAT          = 0 ) OR ( tt-line.VAT          = ? ) ) AND
     1943          ( ( tt-line.sum          = 0 ) OR ( tt-line.sum          = ? ) ) THEN DO:
     1944         DELETE tt-line.
     1945         NEXT.
     1946       END.
     1947       IF tt-line.price-no-VAT = ? THEN DO: ASSIGN tt-line.price-no-VAT = 0. END.
     1948     END.
     1949   END PROCEDURE.
     1950   PROCEDURE print-rs :
     1951     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1952     ASSIGN v-tot-sum-no-VAT = 0
     1953            v-tot-VAT        = 0
     1954            v-tot-sum        = 0.
     1955     RUN prn-lib-open-stream IN THIS-PROCEDURE ( INPUT parparentproc, INPUT 43, INPUT YES, INPUT NO ).
     1956     VIEW STREAM PrnLibStream FRAME Bottomframe.
     1957     RUN print-header IN THIS-PROCEDURE.
     1958     FORM WITH FRAME r-factur-print-1.
     1959     FOR EACH tt-line :
     1960       RUN print-line IN THIS-PROCEDURE.
     1961       ASSIGN v-tot-sum-no-VAT = v-tot-sum-no-VAT + ( IF tt-line.sum-no-VAT = ? THEN 0 ELSE tt-line.sum-no-VAT )
     1962              v-tot-VAT        = v-tot-VAT        + ( IF tt-line.VAT        = ? THEN 0 ELSE tt-line.VAT        )
     1963              v-tot-sum        = v-tot-sum        + ( IF tt-line.sum        = ? THEN 0 ELSE tt-line.sum        ).
     1964     END.
     1965     PUT  STREAM PrnLibStream v-single-line FORMAT "x(198)":U.
     1966     IF LINE-COUNTER( PrnLibStream ) + 7 > PAGE-SIZE( PrnLibStream ) THEN DO: PAGE STREAM PrnLibStream. END.
     1967     IF v-tot-sum-no-VAT <> 0 OR v-tot-VAT <> 0 OR v-tot-sum <> 0 THEN DO:
     1968       DISPLAY STREAM PrnLibStream "Всего"          @ ub.goods.gds-name
     1969                                   v-tot-sum-no-VAT @ v-sum-no-VAT
     1970                                   v-tot-VAT        @ v-VAT
     1971                                   v-tot-sum        @ v-sum
     1972       WITH FRAME r-factur-print-1.
     1973     END.
     1974     RUN print-footer IN THIS-PROCEDURE.
     1975     HIDE   STREAM PrnLibStream FRAME Bottomframe.
     1976     OUTPUT STREAM PrnLibStream CLOSE.
     1977   if mFrameView
     1978   then do:
     1979      HIDE FRAME InfoFrame.
     1980   end.
     1981     SESSION :SET-WAIT-STATE( "":U ).
     1982     RUN prn-lib-prn-file IN THIS-PROCEDURE ( INPUT parparentproc, INPUT SheetFormat( ) ).
     1983   END PROCEDURE.
     1984   PROCEDURE print-header :
     1985     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     1986     PUT STREAM PrnLibStream
     1987       SPACE( 25 ) STRING( "СЧЕТ-ФАКТУРА "                               + CAPS( v-num )                           ) FORMAT "x(100)":U SKIP( 1 )
     1988       SPACE(  5 ) STRING( "Продавец   "                                 + buf_suppl.obj-name                      ) FORMAT "x(100)":U SKIP
     1989       SPACE(  5 ) STRING( "Адрес   "                                    + t-a_adr                                 ) FORMAT "x(90)":U  SKIP
     1990       SPACE(  5 ) STRING( "ИНН/КПП продавца   "                         + t-a_INN                                 ) FORMAT "x(100)":U SKIP
     1991       SPACE(  5 ) STRING( "Грузоотправитель и его адрес   "             + TRIM( buf_suppl.obj-name )              ) FORMAT "x(100)":U SKIP
     1992       SPACE(  5 ) STRING( "Грузополучатель  и его адрес   " + TRIM( buf_owner.obj-name ) + ", " + t-m_adr         ) FORMAT "x(130)":U SKIP
     1993       SPACE(  5 ) STRING( "К платежно-расчетному документу  "           + p-pay-code                              ) FORMAT "x(100)":U SKIP( 1 )
     1994       SPACE(  5 ) STRING( "Покупатель   " + buf_owner.obj-name + "(" + STRING( buf_owner.obj-code ) + ")"         ) FORMAT "x(100)":U SKIP
     1995       SPACE(  5 ) STRING( "Адрес   "                                    + t-m_adr                                 ) FORMAT "x(90)":U  SKIP
     1996       SPACE(  5 ) STRING( "ИНН/КПП покупателя  "                        + t-m_INN                                 ) FORMAT "x(100)":U SKIP
     1997       SPACE(  5 ) "Дополнение (условия оплаты по договору (контракту), способ отправления и т.п.)"                  FORMAT "x(130)":U SKIP
     1998       SPACE(  5 ) STRING( FILL( "_", 130 ) )                                                                        FORMAT "x(130)":U SKIP
     1999       SPACE( 10 ) STRING( "Цены и суммы указаны в " + TRIM( ( IF PrintRubl THEN "рублях" ELSE base-type ) ) + "." ) FORMAT "x(120)":U SKIP( 1 ).
     2000   END PROCEDURE.
     2001   PROCEDURE print-footer :
     2002     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     2003     DOWN   STREAM PrnLibStream 2 WITH FRAME r-factur-print-1.
     2004     PUT    STREAM PrnLibStream                                 SKIP( 1 )
     2005       SPACE( 5 ) ( IF v-tot-sum + v-tot-SLT <> 0 THEN "Всего к оплате: " +
     2006                  STRING( TRIM( STRING( v-tot-sum + v-tot-SLT, "->,>>>,>>>,>>>,>>>,>>9.99":U ) ) +
     2007                  " (" + TRIM( ( IF PrintRubl THEN "РУБ" ELSE base-type ) ) + ")" ) ELSE "":U )  FORMAT "x(150)":U SKIP
     2008       SPACE( 5 ) ( IF v-tot-tax <> 0 THEN "В том числе " + v-tax-name + " : " +
     2009                         TRIM( STRING( v-tot-tax,              "->,>>>,>>>,>>>,>>>,>>9.99":U ) ) +
     2010                  " (" + TRIM( ( IF PrintRubl THEN "РУБ" ELSE base-type ) ) + ")"   ELSE "":U )  FORMAT "x(150)":U SKIP( 1 )
     2011                  "Руководитель предприятия  ____________________    ____________________" FORMAT "x(70)":U
     2012       SPACE( 5 )        "Главный бухгалтер  ____________________    ____________________" FORMAT "x(63)":U SKIP
     2013                  "                            (подпись)               (ф. и. о.) "
     2014       SPACE( 5 ) "                            (подпись)               (ф. и. о.)"                          SKIP.
     2015   END PROCEDURE.
     2016   PROCEDURE print-line :
     2017     DEFINE VARIABLE v-start-string AS CHARACTER NO-UNDO.
     2018     DEFINE VARIABLE v-add-string   AS CHARACTER NO-UNDO.
     2019     SESSION :SET-WAIT-STATE( "COMPILER":U ).
     2020     DO ON ERROR UNDO, RETURN ERROR :
     2021       FIND FIRST ub.goods NO-LOCK WHERE
     2022                  ub.goods.prod-type = tt-line.prod-type AND
     2023                  ub.goods.prod-code = tt-line.prod-code AND
     2024                  ub.goods.artic     = tt-line.artic.
     2025       ASSIGN gds-str   = "":U
     2026              gds-str1  = "":U
     2027              gds-str2  = "":U.
     2028       FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     2029       IF ub.units.type = 'дро':U + "," + '2ед':U OR ub.units.type = 'дро':U + "," + 'доп':U THEN DO:
     2030         ASSIGN str = STRING( ub.goods.artic, "x(16)":U ) + " ":U + STRING( ub.goods.Sort, "x(5)":U ) + " ":U +
     2031                      TRIM(   ub.goods.gds-name ) + " ":U + TRIM( ub.goods.PS ).
     2032       END.                                                                                                    ELSE DO:
     2033         ASSIGN str = STRING( ub.goods.artic, "x(16)":U ) + " ":U + TRIM(   ub.goods.gds-name ).
     2034       END.
     2035       ASSIGN   gds-str1 = breakstr( str,     59, INPUT-OUTPUT gds-str1, INPUT-OUTPUT gds-str2 ).
     2036       DO WHILE TRIM( gds-str2 ) <> "":U :
     2037         ASSIGN gds-str  = gds-str2
     2038                gds-str1 = breakstr( gds-str, 59, INPUT-OUTPUT gds-str1, INPUT-OUTPUT gds-str2 ).
     2039       END.
     2040       ASSIGN   gds-str1 = breakstr( str,     59, INPUT-OUTPUT gds-str1, INPUT-OUTPUT gds-str2 ).
     2041       DISPLAY STREAM PrnLibStream sym1  gds-str1                 @ ub.goods.gds-name
     2042                                   sym2  ub.goods.unit-base
     2043                                   sym3  tt-line.gds-qty          @ v-qnty
     2044                                   sym4  tt-line.price-no-VAT     @ v-price-no-VAT
     2045                                   sym5  tt-line.sum-no-VAT       @ v-sum-no-VAT
     2046                                   sym6  "   ---" FORMAT "x(6)":U @ v-sum-excise
     2047                                   sym7  tt-line.VAT-pc           @ ub.doc-line.VAT-pc
     2048                                   sym8  tt-line.VAT              @ v-VAT
     2049                                   sym9  tt-line.sum              @ v-sum
     2050                                   sym10 tt-line.country          @ v-country
     2051                                   sym11 tt-line.GTD              @ v-GTD              sym12
     2052       WITH FRAME r-factur-print-1.
     2053       DOWN STREAM PrnLibStream 1 WITH FRAME r-factur-print-1.
     2054       ASSIGN v-start-string = gds-str2.
     2055       DO WHILE TRIM( v-start-string ) <> "":U :
     2056         ASSIGN gds-str = v-start-string.
     2057         ASSIGN v-add-string = breakstr( gds-str, 59, INPUT-OUTPUT v-add-string, INPUT-OUTPUT v-start-string ).
     2058         DISPLAY STREAM PrnLibStream sym1 FILL( " ":U, 17 ) + v-add-string @ ub.goods.gds-name sym2
     2059                                     sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2060         WITH FRAME r-factur-print-1.
     2061         DOWN STREAM PrnLibStream 1 WITH FRAME r-factur-print-1.
     2062       END.
     2063       ASSIGN v-lines-counter = v-lines-counter + 1.
     2064   IF ( v-lines-counter modulo v-account = 0 )  then DO:
     2065    Assign
     2066       v-kol-spice = (50 - LENGTH(ReportName)) / 2
     2067       RecordsString = fill(' ',v-kol-spice) + string(ReportName)
     2068       .
     2069             if  log-manager:logfile-name ne ?
     2070             then DO:
     2071                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2072             end.
     2073              if mFrameView
     2074              then do:
     2075               DISPLAY
     2076                 v-lines-counter @ RecordsDone
     2077                 RecordsString   @ RecordsString
     2078                 WITH FRAME InfoFrame.
     2079              end.
     2080   End.
     2081      if v-button-stop then  DO:
     2082            if mFrameView
     2083            then
     2084               PROCESS EVENTS.
     2085            IF StopProcessing THEN DO:
     2086            RETURN error.
     2087            End.
     2088      end.
     2089     END.
     2090   END PROCEDURE.
