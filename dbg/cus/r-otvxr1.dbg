     1644     FIELD sum          AS DECIMAL   COLUMN-LABEL "Ст-ть товаров!с учетом налога"        FORMAT "->>>>>>>>>>9.99":U
     1645     FIELD country      AS CHARACTER COLUMN-LABEL "Страна!происхождения"                 FORMAT "x(15)":U
     1646     FIELD GTD          AS CHARACTER COLUMN-LABEL "Номер грузовой таможенной!декларации" FORMAT "x(31)":U
     1647     INDEX pi           IS UNIQUE    PRIMARY prod-type prod-code artic VAT-pc price-no-VAT GTD.
