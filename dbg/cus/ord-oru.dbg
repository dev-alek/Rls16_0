     1139   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140     run mainmenu_getcntxt in parparentproc
     1141       (output v-cntxt-db-num
     1142       ,output v-cntxt-userid
