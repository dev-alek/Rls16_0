     1130   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131     define variable v-cntxt-db-num        as integer   no-undo .
     1132     define variable v-cntxt-userid        as character no-undo .
     1133     define variable v-cntxt-level         as character no-undo .
     1134     define variable v-cntxt-host-code-obj as integer   no-undo .
     1135     define variable v-cntxt-obj-type      as character no-undo .
     1136     define variable v-cntxt-obj-code      as integer   no-undo .
     1137     define variable v-cntxt-db-num-obj    as integer   no-undo .
