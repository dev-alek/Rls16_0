     2911       apply "ctrl-b":U to scr-ship-date in frame Dialog-Frame .
     2912     END.
     2913     ON CHOOSE OF MENU-ITEM m-ed-date26-2 in menu m-ed-date26 DO:
     2914       apply "ctrl-d":U to scr-ship-date in frame Dialog-Frame .
     2915     END.
     2916     ON CHOOSE OF MENU-ITEM m-ed-date26-3 in menu m-ed-date26 DO:
     2917       apply "ctrl-e":U to scr-ship-date in frame Dialog-Frame .
     2918     END.
     2919     ON CHOOSE OF MENU-ITEM m-ed-date26-4 in menu m-ed-date26 DO:
