     1150   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   procedure proc-ord-code :
     1152   define input  parameter  p-type as character no-undo .
     1153   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1154   define input  parameter  v-cntxt-obj-type as character no-undo .
     1155   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1156   define input  parameter  p-i-doc    as character no-undo .
     1157   define output parameter  p-ord-doc  as character no-undo .
     1158   define variable          v-idop     as character no-undo .
     1159     do
     1160     on error undo, return error return-value
     1161     :
     1162   case p-type :
     1163       when "main-no-ver" then do:
     1164         if  (v-cntxt-db-num <> 0) then
     1165           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1166         else
     1167           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1168       end.
     1169       when "main" then do:
     1170             do while true:
     1171             if  (v-cntxt-db-num <> 0) then
     1172               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1173             else
     1174               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1175             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1176             End.
     1177       end.
     1178       when "chip" then do:
     1179         assign
     1180           v-idop = p-i-doc .
     1181         do while true :
     1182           if index (v-idop , ".") = 0 then
     1183             v-idop  = replace (v-idop , "-", "-1.").
     1184           else
     1185             v-idop  =
     1186             substring (v-idop , 1, index (v-idop, "-")) +
     1187             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1188             substring (v-idop, index (v-idop, ".")).
     1189           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1190         end.
     1191         assign
     1192           p-ord-doc = v-idop.
     1193       end.
     1194   end case.
     1195     end.
     1196   end procedure.
     1197   procedure check-contract-code :
     1198   define input  parameter parmode           as   character                     no-undo.
     1199   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     1200   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     1201   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     1202   define input  parameter parframe-value    as   character                     no-undo.
     1203   define input  parameter parmenu-handle    as   handle                        no-undo.
     1204   define input  parameter parobj-date       as   date                          no-undo.
     1205   define input  parameter partype-contract  as   character                     no-undo .
     1206   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     1207   define buffer bf_contract     for ub.contract.
     1208   define buffer bf-oth_contract for ub.contract.
     1209   define variable varrid-list as character no-undo.
     1210   define variable varrecid    as recid     no-undo.
     1211   define variable varlog      as logical   no-undo.
     1212   define variable var-args    as char      no-undo.
     1213   define variable var-ext-doc-type as char     no-undo.
     1214   do on error undo, return error return-value :
     1215   var-args = parmode.
     1216   parmode = entry(1, parmode).
     1217   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     1218   if partype-contract = "" or partype-contract = ? then
     1219      partype-contract = 'при':U .
     1220   assign
     1221     parcontract-code = 0
     1222   .
     1223   if parmode = "input":u
     1224   then do:
     1225     if parframe-value = ""
     1226     then do:
     1227       assign
     1228         parcontract-code = 0
     1229       .
     1230     end.
     1231     else do:
     1232       find first bf_contract no-lock
     1233         where bf_contract.host-code         = parhost-code
     1234           and bf_contract.cli-type          = parcli-type
     1235           and bf_contract.cli-code          = parcli-code
     1236           and bf_contract.contract-prn-code = parframe-value
     1237         no-error.
     1238       if available bf_contract
     1239       then do:
     1240         find first bf-oth_contract no-lock
     1241           where bf-oth_contract.host-code          = parhost-code
     1242             and bf-oth_contract.contract-prn-code  = parframe-value
     1243             and bf-oth_contract.cli-type           = parcli-type
     1244             and bf-oth_contract.cli-code           = parcli-code
     1245             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     1246           no-error .
     1247         if available bf-oth_contract
     1248         then do:
     1249           message
     1250             "На фирме " parhost-code skip
     1251             "у контрагента" parcli-type parcli-code skip
     1252             "имеются два контракта с номером" parframe-value skip
     1253           view-as alert-box .
     1254         end.
     1255         else do:
     1256           assign
     1257             parcontract-code = bf_contract.contract-code
     1258           .
     1259         end.
     1260       end.
     1261     end.
     1262   end.
     1263   if parmode <> "input":u
     1264   or parcontract-code = 0
     1265   then do:
     1266     run str/cont-all.w (input parmenu-handle,
     1267                     input parhost-code,
     1268                     input "b-sel",
     1269                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     1270                     input parcli-type,
     1271                     input parcli-code,
     1272                     input ?,
     1273                     input ?,
     1274                     input "current":u,
     1275                     input partype-contract,
     1276                     input-output varrid-list ) no-error.
     1277     if error-status:error then do:
     1278       message "Ошибка при вызове справочника договоров." skip
     1279               return-value                skip
     1280               error-status:get-message(1) skip
     1281               error-status:get-message(2)
     1282       view-as alert-box error.
     1283       return error.
     1284     end.
     1285     assign
     1286       varrecid = integer(entry(1, varrid-list)).
     1287     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     1288     if available bf_contract then do:
     1289       assign
     1290         parcontract-code = bf_contract.contract-code.
     1291     end.
     1292   end.
     1293   if parcontract-code <> 0
     1294   then do:
     1295     if (bf_contract.status_ = 'зкр':U or
     1296         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     1297       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     1298       then do:
     1299           assign
     1300             varlog = no.
     1301           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     1302           view-as alert-box.
     1303           assign
     1304             parcontract-code = 0
     1305           .
     1306       end.
     1307     end.
     1308     if bf_contract.contract-date-beg > parobj-date then do:
     1309       assign
     1310         varlog = no.
     1311       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     1312       view-as alert-box.
     1313       assign
     1314         parcontract-code = 0
     1315       .
     1316     end.
     1317     if parcontract-code <> 0
     1318     then do:
     1319       if bf_contract.cli-type <> parcli-type
     1320       or bf_contract.cli-code <> parcli-code
     1321       then do:
     1322          message "По договору " bf_contract.contract-code
     1323                  ( if bf_contract.doc-type =  'при':U
     1324                    then " поставщиком является "
     1325                    else " покупателем является " )
     1326                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     1327                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     1328          view-as alert-box error.
     1329          assign
     1330            parcontract-code = 0.
     1331       end.
     1332       if parcontract-code <> ? then do:
     1333         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     1334           message "Контракт имеет недопустимый тип." view-as alert-box.
     1335           assign
     1336             parcontract-code = 0.
     1337         end.
     1338       end.
     1339     end.
     1340   end.
     1341   end.
     1342   end procedure.
     1343   procedure cntrcode-get-arg-val:
     1344       def input param p-args as char no-undo.
     1345       def input param p-key as char no-undo.
     1346       def output param p-val as char no-undo.
     1347       def var i as int no-undo.
     1348       def var nums as int no-undo.
     1349       def var key-val as char no-undo.
     1350       nums = num-entries(p-args).
     1351       do i = 1 to nums:
     1352           key-val = entry(i, p-args).
     1353           if key-val begins (p-key + "=") then do:
     1354               p-val = entry(2, key-val, "=").
     1355               return.
     1356           end.
     1357       end.
     1358       p-val = "".
     1359   end.
