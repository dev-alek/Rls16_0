     2659     return no-apply .
     2660   END.
     2661   ON return OF scr-boss-name IN FRAME Dialog-Frame
     2662   DO:
     2663       run next-focus in this-procedure  (input  scr-boss-name:handle ) .
     2664     return no-apply .
     2665   END.
     2666   ON return OF scr-cli IN FRAME Dialog-Frame
     2667   DO:
     2668       run next-focus in this-procedure  (input  scr-cli:handle ) .
     2669     return no-apply .
     2670   END.
     2671   ON return OF scr-ship-date IN FRAME Dialog-Frame
     2672   DO:
     2673     run next-focus in this-procedure  (input  scr-ship-date:handle ) .
     2674     return no-apply .
     2675   END.
     2676   ON return OF scr-wrkr IN FRAME Dialog-Frame
     2677   DO:
     2678       run next-focus in this-procedure  (input  scr-wrkr:handle ) .
     2679     return no-apply .
     2680   END.
     2681   ON return OF scr-wrkr-name IN FRAME Dialog-Frame
     2682   DO:
     2683       run next-focus in this-procedure  (input  scr-wrkr-name:handle ) .
     2684     return no-apply .
