      222               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      223               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      224               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      225                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      226               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      227         otherwise do:
      228           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      229         end.
      230       end CASE.
      231     end.
      232   end procedure.
      233   procedure uf-get :
      234     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      235     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      236     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      237     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      238     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      239     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      240     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      241     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      242     do
      243     on error undo, return error
      244     :
      245       define buffer buf_usr-flt for ubflt.usr-flt .
      246       define variable v-use-List_     as logical   no-undo .
      247       define variable v-type-List_     as character no-undo .
      248       define variable v-format-List_   as character no-undo .
      249       define variable v-use-Naim      as logical   no-undo .
      250       define variable v-type-Naim      as character no-undo .
      251       define variable v-format-Naim    as character no-undo .
      252       define variable v-use-print-graft as logical   no-undo .
      253       define variable v-use-sort-gr     as logical   no-undo .
      254       define variable v-use-type-price  as logical   no-undo .
      255       define variable v-use-type-val    as logical   no-undo .
      256       define variable v-label          as character no-undo .
      257       define variable v-tooltip        as character no-undo .
      258       define variable v-user-can-edit  as logical   no-undo .
      259       define variable v-output-display as logical   no-undo .
      260       define variable v-other          as character no-undo .
      261       run uf-name in this-procedure
      262          (input  entry(1, p-code, chr(4))
      263         ,output v-use-List_
      264         ,output v-type-List_
      265         ,output v-format-List_
      266         ,output v-use-Naim
      267         ,output v-type-Naim
      268         ,output v-format-Naim
      269         ,output v-use-print-graft
      270         ,output v-use-sort-gr
      271         ,output v-use-type-price
      272         ,output v-use-type-val
      273         ,output v-label
      274         ,output v-tooltip
      275         ,output v-user-can-edit
      276         ,output v-output-display
      277         ,output v-other
      278         ) no-error .
      279       if error-status :error then do:
      280         undo, return error return-value .
      281       end.
      282       find first buf_usr-flt no-lock where
      283                  buf_usr-flt.Call-point     = p-code AND
      284                  buf_usr-flt.user-name       = p-user-name
      285         no-error .
      286       if avail buf_usr-flt then do:
      287         assign
      288         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      289         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      290         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      291         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      292         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      293         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      294         .
      295       end.
      296       else do:
      297         assign
      298         p-List_        = (if v-use-List_       then "":U                    else ?)
      299         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      300         p-print-graft  = (if v-use-print-graft then no                      else ?)
      301         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      302         p-type-price   = (if v-use-type-price  then no                      else ?)
      303         p-type-val     = (if v-use-List_       then no                      else ?)
      304         .
      305       end.
      306     end.
      307   end procedure.
      308   procedure uf-set :
      309     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      310     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      311     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      312     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      313     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      314     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      315     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      316     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      317     do
      318     on error undo, return error
      319     :
      320       define buffer buf_usr-flt for ubflt.usr-flt .
      321       define variable v-use-List_     as logical   no-undo .
      322       define variable v-type-List_     as character no-undo .
      323       define variable v-format-List_   as character no-undo .
      324       define variable v-use-Naim      as logical   no-undo .
      325       define variable v-type-Naim      as character no-undo .
      326       define variable v-format-Naim    as character no-undo .
      327       define variable v-use-print-graft as logical   no-undo .
      328       define variable v-use-sort-gr   as logical   no-undo .
      329       define variable v-use-type-price as logical   no-undo .
      330       define variable v-use-type-val  as logical   no-undo .
      331       define variable v-tooltip        as character no-undo .
      332       define variable v-label          as character no-undo .
      333       define variable v-user-can-edit  as logical   no-undo .
      334       define variable v-output-display as logical   no-undo .
      335       define variable v-other          as character no-undo .
      336       run uf-name in this-procedure
      337         (input  entry(1, p-code, chr(4))
      338         ,output v-use-List_
      339         ,output v-type-List_
      340         ,output v-format-List_
      341         ,output v-use-Naim
      342         ,output v-type-Naim
      343         ,output v-format-Naim
      344         ,output v-use-print-graft
      345         ,output v-use-sort-gr
      346         ,output v-use-type-price
      347         ,output v-use-type-val
      348         ,output v-label
      349         ,output v-tooltip
      350         ,output v-user-can-edit
      351         ,output v-output-display
      352         ,output v-other
      353         ) no-error .
      354       if error-status :error then do:
      355         undo, return error return-value .
      356       end.
      357       find first buf_usr-flt where
      358                  buf_usr-flt.Call-point     = p-code AND
      359                  buf_usr-flt.user-name       = p-user-name
      360         no-error .
      361       if not avail buf_usr-flt then do:
      362           create buf_usr-flt .
      363           assign
      364           buf_usr-flt.call-point = p-code
      365           buf_usr-flt.user-name  = p-user-name
      366           .
      367       end.
      368       if avail buf_usr-flt then do:
      369        assign
      370        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      371        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      372        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      373        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      374        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      375        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      376       .
      377       release buf_usr-flt.
      378       end.
      379       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      380     end.
      381   end procedure.
