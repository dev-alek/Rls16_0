     2007   DEFINE VARIABLE scr-sum-base AS DECIMAL FORMAT ">>,>>>,>>9.99":U INITIAL 0
     2008        LABEL "Итого сумма (вал)"
     2009         VIEW-AS TEXT
     2010        SIZE 14 BY .67
     2011        FGCOLOR 4  NO-UNDO.
