     2018        LABEL "Итого сумма (abbr_rub)"
     2019         VIEW-AS TEXT
     2020        SIZE 14 BY .67
     2021        FGCOLOR 4  NO-UNDO.
     2022   DEFINE VARIABLE scr-wrkr AS INTEGER FORMAT "999999999":U INITIAL 0
     2023        LABEL ""
     2024        VIEW-AS FILL-IN
     2025        SIZE 10.13 BY 1 NO-UNDO.
     2026   DEFINE VARIABLE scr-wrkr-name AS CHARACTER FORMAT "X(20)":U
     2027         VIEW-AS TEXT
     2028        SIZE 25 BY .67
     2029        FGCOLOR 4  NO-UNDO.
     2030   DEFINE VARIABLE t-auto AS LOGICAL INITIAL yes
     2031        LABEL "авто"
     2032        VIEW-AS TOGGLE-BOX
     2033        SIZE 7 BY .83 NO-UNDO.
     2034   DEFINE QUERY BROWSE-2 FOR
     2035         X_ord-line,
     2036         X_goods SCROLLING.
     2037   DEFINE BROWSE BROWSE-2
     2038     QUERY BROWSE-2 NO-LOCK DISPLAY
     2039         X_ord-line.line-num   COLUMN-LABEL  'N/п'   FORMAT ">>>>9"
     2040         X_goods.gds-code   COLUMN-LABEL  'Код'   FORMAT ">>>>>>>>9"
     2041         X_ord-line.artic   COLUMN-LABEL  'Артикул'
     2042         X_goods.gds-name   COLUMN-LABEL  'Название'   FORMAT "X(100)"
     2043         X_ord-line.qnty   COLUMN-LABEL  'Кол-во'   FORMAT "->>,>>>,>>9.<<<"
     2044         X_ord-line.initial-qnty   COLUMN-LABEL  'Рекомен-!довано  '   FORMAT "->>,>>>,>>9.<<<"
     2045         X_goods.unit-base   COLUMN-LABEL  'ед.!изм'   FORMAT "X(3)"
     2046         ( if X_ord-line.temp-rash <> 0 then X_ord-line.order-qnty / X_ord-line.temp-rash  else 0 )   COLUMN-LABEL  'Заказано!в днях'   FORMAT "->>>>>>>>9.99"
     2047         X_ord-line.order-qnty   COLUMN-LABEL  'Заказано'   FORMAT "->>,>>>,>>9.<<<"
     2048         v-rc-qnty  COLUMN-LABEL  'Текущий!остаток РЦ'  FORMAT "->>,>>>,>>9.<<<"
     2049         (chr(int(X_ord-line.add-cli-qnty)) + string(X_ord-line.add-qnty))  COLUMN-LABEL  'ABC1'  FORMAT "x(6)"
     2050         (chr(int(X_ord-line.cancel-cli-qnty)) + string(X_ord-line.cancel-qnty))  COLUMN-LABEL  'ABC2'  FORMAT "x(6)"
     2051         X_ord-line.temp-rash  COLUMN-LABEL  'Темп'  FORMAT "->>,>>>,>>9.<<<"
     2052         v-rc-qnty-free  COLUMN-LABEL  'Свободный!остаток РЦ'  FORMAT "->>,>>>,>>9.<<<"
     2053         X_ord-line.qnty-stk  COLUMN-LABEL  'Остаток на!момент расчета'  FORMAT "->>,>>>,>>9.<<<"
     2054         ( if X_ord-line.temp-rash <> 0 then X_ord-line.qnty-stk / X_ord-line.temp-rash  else 0 )  COLUMN-LABEL  'Остаток!в днях'  FORMAT "->,>>>,>>9.99"
     2055         ENABLE
     2056         X_ord-line.qnty
     2057       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.5 BY 9.67.
     2058   DEFINE FRAME Dialog-Frame
     2059        b-exit AT ROW 1 COL 1
     2060        b-quit AT ROW 1 COL 11
     2061        B-delivery AT ROW 1 COL 76.13
     2062        B-help AT ROW 1 COL 86.13
     2063        b-prev AT ROW 2 COL 1
     2064        b-next AT ROW 2 COL 6
     2065        B-spec AT ROW 2 COL 93.5 WIDGET-ID 2
     2066        scr-cli AT ROW 2.04 COL 27 COLON-ALIGNED
     2067        r-cli AT ROW 2.04 COL 33
     2068        B-contract AT ROW 2.04 COL 90.25
     2069        scr-wrkr AT ROW 3.17 COL 5.88 COLON-ALIGNED
     2070        scr-ship-date AT ROW 3.17 COL 82.5 COLON-ALIGNED
     2071        r-wrkr AT ROW 3.25 COL 18
     2072        scr-pay-day AT ROW 4.17 COL 82.5 COLON-ALIGNED
     2073        scr-agnt AT ROW 4.21 COL 5.75 COLON-ALIGNED
     2074        r-agnt AT ROW 4.29 COL 17.88
     2075        scr-boss AT ROW 5.33 COL 5.75 COLON-ALIGNED
     2076        r-boss AT ROW 5.42 COL 17.88
     2077        scr-e-method AT ROW 6.54 COL 1 NO-LABEL
     2078        b-add AT ROW 12.83 COL 1
     2079        B-chg AT ROW 12.83 COL 11
     2080        B-del AT ROW 12.83 COL 21
     2081        B-calc AT ROW 12.83 COL 31
     2082        b-renum AT ROW 12.83 COL 43
     2083        b-spec-gds AT ROW 12.83 COL 53 WIDGET-ID 4
     2084        t-auto AT ROW 13.04 COL 88.25
     2085        BROWSE-2 AT ROW 14 COL 1
     2086        scr-obj-name AT ROW 1.21 COL 35.13 COLON-ALIGNED
     2087        scr-cli-name AT ROW 2.04 COL 35.13 COLON-ALIGNED NO-LABEL
     2088        scr-contract AT ROW 2.04 COL 68 COLON-ALIGNED NO-LABEL
     2089        scr-wrkr-name AT ROW 3.33 COL 19.25 COLON-ALIGNED NO-LABEL
     2090        scr-agnt-name AT ROW 4.46 COL 19.25 COLON-ALIGNED NO-LABEL
     2091        scr-boss-name AT ROW 5.63 COL 19.25 COLON-ALIGNED NO-LABEL
     2092        scr-sum-qnty AT ROW 6.29 COL 80.38 COLON-ALIGNED
     2093        scr-sum-rubl AT ROW 7 COL 80.38 COLON-ALIGNED
     2094        scr-sum-base AT ROW 7.79 COL 80.38 COLON-ALIGNED
     2095        SPACE(0.24) SKIP(15.21)
     2096       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2097            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2098            TITLE "Заказ ОРЦ".
     2099   ASSIGN
     2100          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2101          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2102   ASSIGN
     2103          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2104   ASSIGN
     2105          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2106   ASSIGN
     2107          scr-sum-base:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2108   ASSIGN
     2109          scr-sum-rubl:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2110   ON GO OF FRAME Dialog-Frame
     2111   DO:
     2112   define buffer buf_ord-line for ub.ord-line.
     2113   define variable v-kol as integer init 0 no-undo .
     2114   define variable cur-clmn-loc as integer   no-undo .
     2115   define variable column-handle as handle no-undo .
     2116   define variable v-list as character no-undo .
     2117     assign
     2118       cur-clmn-loc  = 1
     2119       column-handle = BROWSE-2:first-column
     2120       v-list        = column-handle:label + "#"
     2121     .
     2122     do while valid-handle(column-handle) :
     2123       if cur-clmn-loc = BROWSE-2:num-columns then do:
     2124         leave .
     2125       end.
     2126       assign
     2127         column-handle = column-handle:NEXT-COLUMN
     2128         cur-clmn-loc  = cur-clmn-loc + 1
     2129         v-list        = v-list + column-handle:label + "#"
     2130       .
     2131     end.
     2132      v-list = trim(v-list, "#") .
     2133      define variable v-i as integer   no-undo .
     2134      define variable v-pos as integer   no-undo .
     2135      define variable v-list-new as character no-undo .
     2136      define variable v-elem as character no-undo .
     2137      repeat v-i = 1 to BROWSE-2:num-columns :
     2138         v-elem = entry( v-i, v-list , "#") .
     2139         v-pos = lookup( v-elem , 'N/п' + '#' +  'Код' + '#' +  'Артикул' + '#' +  'Название' + '#' +  'Кол-во' + '#' +  'Рекомен-!довано  ' + '#' +  'ед.!изм' + '#' +  'Заказано!в днях' + '#' +  'Заказано' + '#' +  'Текущий!остаток РЦ' + '#' +  'ABC1' + '#' +  'ABC2' + '#' +  'Темп' + '#' +  'Свободный!остаток РЦ' + '#' +  'Остаток на!момент расчета' + '#' +  'Остаток!в днях' , "#") .
     2140         v-list-new = v-list-new + string(v-pos) + "," .
     2141      end.
     2142      define variable v-list-str as character no-undo .
     2143      define variable v-nn as integer   no-undo .
     2144      v-nn = num-entries(v-list-new) .
     2145      v-list-str = "" .
     2146      repeat v-i = 1 to v-nn :
     2147         v-elem = entry(v-i , v-list-new ) .
     2148         if int(v-elem) > 0 then
     2149         v-list-str  = v-list-str + v-elem + "," .
     2150      end.
     2151      v-list-new = trim ( v-list-str , ",")  +  chr(4)
     2152                 + string(decimal( X_ord-line.line-num:width in browse BROWSE-2   )) +  chr(4)
     2153                 + string(decimal( X_goods.gds-code:width in browse BROWSE-2   )) +  chr(4)
     2154                 + string(decimal( X_ord-line.artic:width in browse BROWSE-2   )) +  chr(4)
     2155                 + string(decimal( X_goods.gds-name:width in browse BROWSE-2   )) +  chr(4)
     2156                 + string(decimal( X_ord-line.qnty:width in browse BROWSE-2   )) +  chr(4)
     2157                 + string(decimal( X_ord-line.initial-qnty:width in browse BROWSE-2    )) +  chr(4)
     2158                 + string(decimal( X_goods.unit-base:width in browse BROWSE-2   )) +  chr(4)
     2159                 + string(10)  +  chr(4)
     2160                 + string(decimal( X_ord-line.order-qnty :width in browse BROWSE-2   )) +  chr(4)
     2161                 + string(decimal( v-rc-qnty:width  in browse BROWSE-2 )) +  chr(4)
     2162                 + string(8) +  chr(4)
     2163                 + string(8) +  chr(4)
     2164                 + string(decimal( X_ord-line.temp-rash:width in browse BROWSE-2   )) +  chr(4)
     2165                 + string(decimal( v-rc-qnty-free:width in browse BROWSE-2   )) +  chr(4)
     2166                 + string(decimal( X_ord-line.qnty-stk:width in browse BROWSE-2   )) +  chr(4)
     2167                 + string(10) +  chr(4)
     2168                 .
     2169       run uf-set in this-procedure(
     2170           input  'ord-rc-p':U
     2171           ,input v-cntxt-userid
     2172           ,input v-list-new
     2173           ,input v-uf-Naim
     2174           ,input v-uf-print-graft
     2175           ,input v-uf-sort-gr
     2176           ,input v-uf-type-price
     2177           ,input v-uf-type-val
     2178       ) no-error    .
     2179           if error-status :error then
     2180           message
     2181             vss-workfile vss-revision vss-description skip
     2182             error-status :get-message(1) skip
     2183             return-value skip
     2184             "uf-set"
     2185             view-as alert-box error
     2186           .
     2187     if p-mode =  'ПРОСМОТР':U then return.
     2188     if p-mode <> 'ПРОСМОТР':U then do:
     2189        assign frame Dialog-Frame
     2190        scr-ship-date
     2191        scr-e-method
     2192        scr-wrkr
     2193        scr-agnt
     2194        scr-boss
     2195        scr-cli
     2196        scr-pay-day
     2197        .
     2198        loc-date-ship = scr-ship-date.
     2199        pay-day = scr-pay-day.
     2200     if loc-cli-code = 0 or loc-cli-code = ? then do:
     2201         message "Не выбран РЦ ! "
     2202         view-as alert-box error .
     2203         return no-apply .
     2204     end.
     2205     if (loc-cli-code = loc-obj-code) and (loc-cli-type = loc-obj-type) then do:
     2206         message "Не верно выбран РЦ ! "
     2207         view-as alert-box error .
     2208         return no-apply .
     2209     end.
     2210     if not (loc-cli-type = 'маг':U  or loc-cli-type = 'скл':U ) then do:
     2211         message "РЦ  должен быть объектом ! "
     2212         view-as alert-box error .
     2213         return no-apply .
     2214     end.
     2215   define variable o-host-code as integer   no-undo .
     2216   define variable c-host-code as integer   no-undo .
     2217   define variable o-base-code as integer   no-undo .
     2218   define variable c-base-code as integer   no-undo .
     2219   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2221     (input  loc-obj-type
     2222     ,input  loc-obj-code
     2223     ,output o-host-code
     2224     )  .
     2225   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2226   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2227     (input  loc-cli-type
     2228     ,input  loc-cli-code
     2229     ,output c-host-code
     2230     )  .
     2231   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2233     (input  o-host-code
     2234     ,output o-base-code
     2235     )  .
     2236   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2238     (input  c-host-code
     2239     ,output c-base-code
     2240     )  .
     2241   if o-base-code <> c-base-code then do:
     2242     message "Контрагенты имеют разную базовую валюту. Создание заказа не возможно ! " view-as alert-box error .
     2243     return .
     2244   end.
     2245         if can-find ( first buf_ord-line  no-lock    where
     2246                             buf_ord-line.doc-code = loc-ord-num  and
     2247                             buf_ord-line.qnty  =  0 ) then do:
     2248             find first buf-or_ord-doc exclusive-lock where recid(buf-or_ord-doc) = p-ord-doc-recid  no-error.
     2249             if buf-or_ord-doc.status_ = 'новый':U then do:
     2250                 message "В заказе есть нерассчитанные строки . Удаляем их ? " view-as alert-box question  buttons yes-no update g#log.
     2251                 if g#log then do:
     2252                       for each buf_ord-line  exclusive-lock
     2253                               where buf_ord-line.qnty = 0      and
     2254                               buf_ord-line.doc-code = loc-ord-num
     2255                               :
     2256                               delete buf_ord-line .
     2257                       end.
     2258                 end.
     2259             end.
     2260             else do:
     2261               message "В заказе есть строки с нулевым количеством ! " view-as alert-box information .
     2262             end.
     2263         end.
     2264      define variable v-del as integer   no-undo .
     2265      v-del = 0 .
     2266        for each  buf_ord-line  exclusive-lock    where
     2267                  buf_ord-line.doc-code = loc-ord-num :
     2268               find first ub.goods WHERE ub.goods.artic = buf_ord-line.artic   AND
     2269                                         ub.goods.prod-code = buf_ord-line.prod-code   AND
     2270                                         ub.goods.prod-type = buf_ord-line.prod-type NO-LOCK.
     2271                 if ub.goods.gds-type =  'у':U  then do:
     2272                     delete buf_ord-line .
     2273                     v-del = v-del + 1.
     2274                 end.
     2275        end.
     2276        if v-del > 0  then message "Удалено " v-del  " услуг"  view-as alert-box information .
     2277        define variable s-1 as decimal init 0 no-undo .
     2278        define variable s-2 as decimal init 0 no-undo .
     2279        define variable s-3 as decimal init 0 no-undo .
     2280        for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     2281            s-1  = s-1  + buf_ord-line.sum-rubl .
     2282            s-2  = s-2  + buf_ord-line.sum-base .
     2283            s-3  = s-3  + buf_ord-line.qnty .
     2284            v-kol = v-kol + 1 .
     2285        end.
     2286        if v-kol = 0 then do:
     2287           message "В заказе нет строк . Удаляем документ ? " view-as alert-box question
     2288           buttons yes-no title "" update t-log-3 as logical.
     2289           if t-log-3 = true then do:
     2290                   find first buf-or_ord-doc exclusive-lock where recid(buf-or_ord-doc) = p-ord-doc-recid  no-error.
     2291                   if available buf-or_ord-doc then
     2292                   delete buf-or_ord-doc.
     2293                   return.
     2294               end.
     2295        end.
     2296     end.
     2297     find current buf_ord-doc exclusive-lock no-error .
     2298     assign
     2299       buf_ord-doc.sum-rubl = s-1
     2300       buf_ord-doc.sum-base = s-2
     2301       buf_ord-doc.qnty     = s-3
     2302       buf_ord-doc.e-method = scr-e-method
     2303       buf_ord-doc.ship-date = scr-ship-date
     2304       buf_ord-doc.wrkr   = scr-wrkr
     2305       buf_ord-doc.boss   = scr-boss
     2306       buf_ord-doc.agnt   = scr-agnt
     2307       buf_ord-doc.cli-code = loc-cli-code
     2308       buf_ord-doc.cli-type = loc-cli-type
     2309       buf_ord-doc.status_     = (if buf_ord-doc.status_ = 'запрос':U then 'запрос':U else  'новый':U)
     2310       buf_ord-doc.cli-name = scr-cli-name
     2311       buf_ord-doc.pay-day  = scr-pay-day
     2312       buf_ord-doc.contract-code  = loc-contract
     2313       buf_ord-doc.deliv-type-code    = v-deliv-type-code
     2314       buf_ord-doc.obj-point-code     = v-point-obj-code
     2315       buf_ord-doc.cli-point-code     = v-point-cli-code
     2316       buf_ord-doc.obj-point-db-num   = v-point-obj-db-num
     2317       buf_ord-doc.cli-point-db-num   = v-point-cli-db-num
     2318       buf_ord-doc.transport-host-code     = v-transport-host-code
     2319       buf_ord-doc.transport-cli-type     = v-transport-cli-type
     2320       buf_ord-doc.transport-cli-code     = v-transport-cli-code
     2321       buf_ord-doc.transport-contract = v-transport-contract
     2322       buf_ord-doc.transport-condition= v-transport-condition
     2323       buf_ord-doc.transport-value    = v-transport-value
     2324       buf_ord-doc.sum-ship           = v-transport-sum
     2325       buf_ord-doc.transport-vat      = v-transport-vat
     2326     .
     2327     if buf_ord-doc.status_ = 'новый':U and buf_ord-doc.flag_ = false then do:
     2328         message "Закрываем заказ до статуса ЗАПРОС+ и отправляем по новостям ? " view-as alert-box question
     2329               buttons yes-no title "Вопрос" update t-log-4 as logical.
     2330               if t-log-4 = true then do:
     2331                 run cus/ordorcls.p ( parparentproc, recid(buf_ord-doc) , true   ) no-error .
     2332                 if error-status :error then do:
     2333                    if return-value begins 'izt' then do:
     2334                       message "Товары не прошедшие по Ассортиментной политике удаляются из заказа и прописываются в примечании"
     2335                       return-value
     2336                       view-as alert-box information .
     2337                    end.
     2338                    else do:
     2339                    message
     2340                      error-status :get-message(1) skip
     2341                      return-value skip
     2342                      "Ошибка при закрытии заказа"
     2343                      view-as alert-box error
     2344                    .
     2345                    end.
     2346                    return  .
     2347                 end.
     2348               end.
     2349     end.
     2350   END.
     2351   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2352   DO:
     2353     APPLY "END-ERROR":U TO SELF.
     2354   END.
     2355   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2356   DO:
     2357     run proc-b-add in this-procedure .
     2358     run recalc-head in this-procedure .
     2359   END.
     2360   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     2361   DO:
     2362   define buffer buf_ord-line for ub.ord-line.
     2363   define buffer buf_goods for ub.goods.
     2364   assign frame Dialog-Frame scr-ship-date scr-pay-day .
     2365   loc-date-ship = scr-ship-date .
     2366   if loc-date-ship < today then do:
     2367      message "Для расчета заказа ДАТА ЗАКАЗА должна быть больше текущей " view-as alert-box information .
     2368      return no-apply.
     2369   end.
     2370   pay-day = scr-pay-day.
     2371   if pay-day = ? or pay-day = 0 then
     2372       message  "ПРЕДУПРЕЖДЕНИЕ :  Не задано количество дней продаж !"
     2373       view-as alert-box information
     2374       title "Внимание!!!".
     2375   for each tmp#zakaz :
     2376       delete tmp#zakaz  .
     2377   end.
     2378   for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     2379       find first buf_goods no-lock where
     2380               buf_goods.artic     = buf_ord-line.artic     and
     2381               buf_goods.prod-type = buf_ord-line.prod-type and
     2382               buf_goods.prod-code = buf_ord-line.prod-code .
     2383       create tmp#zakaz .
     2384       BUFFER-COPY buf_ord-line to tmp#zakaz
     2385     assign
     2386       tmp#zakaz.gds-code        = buf_goods.gds-code
     2387       tmp#zakaz.prod-type       = buf_goods.prod-type
     2388       tmp#zakaz.prod-code       = buf_goods.prod-code
     2389       tmp#zakaz.artic           = buf_goods.artic
     2390       tmp#zakaz.gds-name        = buf_goods.gds-name
     2391       tmp#zakaz.deadline        = buf_goods.deadline
     2392       tmp#zakaz.unit-cli        = buf_goods.unit-cli
     2393       tmp#zakaz.unit-base       = buf_goods.unit-base
     2394       tmp#zakaz.negative-rest   = buf_goods.negative-rest
     2395       tmp#zakaz.cli-base-rate   = 1
     2396       tmp#zakaz.ms-cart         = buf_goods.qnty-cart
     2397       .
     2398   end.
     2399   if not can-find (first tmp#zakaz )  then return.
     2400   if pay-day = 0 or pay-day = ? then pay-day = 1 .
     2401   loc-store-code = v-cntxt-obj-code .
     2402   loc-store-type = v-cntxt-obj-type .
     2403   loc-doc-type   = 'ОР':U     .
     2404   run cus/ord-m.w ( input parParentProc , input ? , 'ОР':U ) .
     2405   scr-e-method = e-method .
     2406   display scr-e-method with frame Dialog-Frame .
     2407   run openbr in this-procedure .
     2408   run recalc-head in this-procedure .
     2409   END.
     2410   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2411   DO:
     2412    define variable r-stop as logical no-undo .
     2413    define variable r-exit as logical no-undo .
     2414    define variable r-recid as recid no-undo.
     2415     if p-mode =  'ПРОСМОТР':U then return.
     2416    find current x_ord-line  exclusive-lock  no-error .
     2417    if available x_ord-line then do:
     2418        r-recid =  recid ( x_ord-line )  .
     2419        run cus/ord-frmo.w
     2420          ( input parParentProc ,
     2421            input ?         ,
     2422            input r-recid   ,
     2423            input 'ИЗМЕНЕНИЕ':U ,
     2424            output r-stop   ,
     2425            output r-exit
     2426            ) .
     2427        g#log =  BROWSE-2:refresh() .
     2428    end.
     2429       run recalc-head in this-procedure  .
     2430   END.
     2431   ON return OF B-chg IN FRAME Dialog-Frame
     2432   DO:
     2433     run next-focus in this-procedure  (input  B-chg:handle ) .
     2434     return no-apply .
     2435   END.
     2436   ON CHOOSE OF B-contract IN FRAME Dialog-Frame
     2437   DO:
     2438   define variable o-host-code as integer   no-undo .
     2439   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2441     (input  loc-obj-type
     2442     ,input  loc-obj-code
     2443     ,output o-host-code
     2444     )  .
     2445   define buffer b_contract for ub.contract.
     2446   find first b_contract no-lock  where b_contract.contract-code     = loc-contract and
     2447                                        b_contract.host-code         = o-host-code
     2448                                        no-error .
     2449   if error-status :error then return no-apply.
     2450   run str/sh-contr.p (
     2451     input parParentProc ,
     2452     input recid (b_contract))
     2453     .
     2454   END.
     2455   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2456   DO:
     2457   define variable v-ii as integer no-undo .
     2458   message "Удалить запись ?"
     2459         view-as alert-box question
     2460         buttons yes-no
     2461         update g-log as logical .
     2462         if g-log = false then return no-apply.
     2463    find current x_ord-line  exclusive-lock  no-error .
     2464    if available x_ord-line then do:
     2465       run x-delete in this-procedure ( recid(x_ord-line) , input-output v-ii ) no-error .
     2466       if error-status :error then
     2467       message vss-workfile vss-revision vss-description skip
     2468              "Ошибка удаление 1 " skip
     2469               skip
     2470               error-status :get-message(1) skip
     2471               return-value skip
     2472               view-as alert-box error
     2473       .
     2474       run openbr in this-procedure .
     2475    end.
     2476       run recalc-head in this-procedure .
     2477   END.
     2478   ON CHOOSE OF B-delivery IN FRAME Dialog-Frame
     2479   DO:
     2480     run cus/pardeliv.w
     2481         (input        parParentproc
     2482         ,input        p-mode
     2483         ,input        "ord" + 'ОР':U
     2484         ,input        loc-obj-type
     2485         ,input        loc-obj-code
     2486         ,input        loc-cli-type
     2487         ,input        loc-cli-code
     2488         ,input-output v-deliv-type-code
     2489         ,input-output v-point-obj-code
     2490         ,input-output v-point-obj-db-num
     2491         ,input-output v-point-cli-code
     2492         ,input-output v-point-cli-db-num
     2493         ,input-output v-transport-host-code
     2494         ,input-output v-transport-cli-type
     2495         ,input-output v-transport-cli-code
     2496         ,input-output v-transport-contract
     2497         ,input-output v-transport-condition
     2498         ,input-output v-transport-value
     2499         ,input-output v-transport-sum
     2500         ,input-output v-transport-vat
     2501            ) no-error  .
     2502            if error-status :error then message
     2503              vss-workfile vss-revision vss-description skip
     2504              error-status :get-message(1) skip
     2505              return-value skip
     2506              "Ошибка"
     2507              view-as alert-box error
     2508            .
     2509   END.
     2510   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2511   DO:
     2512       next-prev = ?.
     2513   END.
     2514   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     2515   DO:
     2516   run step-next in this-procedure .
     2517   END.
     2518   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     2519   DO:
     2520      run step-prev in this-procedure .
     2521   END.
     2522   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2523   DO:
     2524       next-prev = ?.
     2525       message "Выходим без сохранения изменений ?" view-as alert-box question
     2526               buttons yes-no
     2527               update ll as log
     2528               .
     2529       if ll = no then return no-apply.
     2530       else do:
     2531         if p-mode  = 'ДОБАВЛЕНИЕ':U then do:
     2532           find first buf-or_ord-doc exclusive-lock where recid(buf-or_ord-doc) = p-ord-doc-recid  no-error.
     2533           if available buf-or_ord-doc then
     2534           delete buf-or_ord-doc.
     2535         end.
     2536       end.
     2537   END.
     2538   ON CHOOSE OF b-renum IN FRAME Dialog-Frame
     2539   DO:
     2540   run proc-renum in this-procedure .
     2541   END.
     2542   ON CHOOSE OF B-spec IN FRAME Dialog-Frame
     2543   DO:
     2544   define variable o-host-code as integer   no-undo .
     2545   define variable v-rid-list as char no-undo.
     2546   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2548     (input  loc-obj-type
     2549     ,input  loc-obj-code
     2550     ,output o-host-code
     2551     )  .
     2552   define buffer b_contract for ub.contract.
     2553   find first b_contract no-lock  where b_contract.contract-code     = loc-contract and
     2554                                        b_contract.host-code         = o-host-code
     2555                                        no-error .
     2556   if error-status :error then return no-apply.
     2557     run str/contspec.w (
     2558         input  parparentproc,
     2559         input  "b-mark,b-add,b-del,b-chg",
     2560         input  p-mode,
     2561         input  o-host-code,
     2562         input  loc-contract,
     2563         output v-rid-list) .
     2564   END.
     2565   ON CHOOSE OF b-spec-gds IN FRAME Dialog-Frame
     2566   DO:
     2567     run add-spec-gds  in this-procedure .
     2568     run recalc-head in this-procedure .
     2569   END.
     2570   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
     2571   DO:
     2572   define buffer buf_prt-obj for ub.prt-obj .
     2573   define variable p-node as integer   no-undo .
     2574   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2576     (input  x_ord-line.artic
     2577     ,input  x_ord-line.prod-type
     2578     ,input  x_ord-line.prod-code
     2579     ,output p-node
     2580     )  .
     2581     find first buf_prt-obj no-lock where
     2582               buf_prt-obj.prt-code  = p-node and
     2583               buf_prt-obj.artic     = x_ord-line.artic     and
     2584               buf_prt-obj.prod-type = x_ord-line.prod-type and
     2585               buf_prt-obj.prod-code = x_ord-line.prod-code and
     2586               buf_prt-obj.obj-type  = loc-cli-type and
     2587               buf_prt-obj.obj-code  = loc-cli-code
     2588               no-error .
     2589      if available buf_prt-obj
     2590         then
     2591            assign
     2592               v-rc-qnty = buf_prt-obj.fact-qnty
     2593               v-rc-qnty-free = buf_prt-obj.free-qnty
     2594            .
     2595         else
     2596            assign
     2597               v-rc-qnty = 0
     2598               v-rc-qnty-free = 0
     2599            .
     2600   END.
     2601   ON MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
     2602   DO:
     2603     apply "CHOOSE" to B-chg .
     2604   END.
     2605   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
     2606   DO:
     2607    define variable rid-list    as  char no-undo .
     2608    define variable old-types as character no-undo .
     2609       run ref/cli-all.w
     2610           (input parparentproc,
     2611            input "b-sel",
     2612            'маг':U,
     2613            ?,
     2614            ?,
     2615            ?,
     2616            ?,
     2617            ?,
     2618            output  rid-list) no-error .
     2619            if error-status :error or
     2620            rid-list = "" or rid-list = ?
     2621            then return no-apply .
     2622       assign
     2623         v-recid-RC = integer(rid-list)
     2624         .
     2625       find first cli#clients no-lock WHERE recid(cli#clients) = v-recid-RC  No-ERROR.
     2626       if avail cli#clients then do:
     2627             run ver-clients  (cli#clients.obj-type , cli#clients.obj-code , output g#log) .
     2628             if g#log then return no-apply.
     2629           Assign
     2630               scr-cli = cli#clients.obj-code
     2631               loc-cli-code = cli#clients.obj-code
     2632               loc-cli-type = cli#clients.obj-type
     2633               scr-cli-name = cli#clients.obj-name
     2634               .
     2635        end.
     2636           else
     2637             assign
     2638                 scr-cli-name = ""
     2639                 scr-cli      = ?
     2640                 loc-cli-code = ?
     2641                 loc-cli-type = ""
     2642                 .
     2643   display scr-cli scr-cli-name with frame Dialog-Frame .
     2644    run p-cont .
     2645   END.
     2646   ON return OF scr-agnt IN FRAME Dialog-Frame
     2647   DO:
     2648       run next-focus in this-procedure  (input  scr-agnt:handle ) .
     2649     return no-apply .
     2650   END.
     2651   ON return OF scr-agnt-name IN FRAME Dialog-Frame
     2652   DO:
     2653       run next-focus in this-procedure  (input  scr-agnt-name:handle ) .
     2654     return no-apply .
     2655   END.
     2656   ON return OF scr-boss IN FRAME Dialog-Frame
     2657   DO:
