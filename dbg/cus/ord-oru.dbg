     1645   procedure ver-clients :
     1646   define input  parameter p-obj-type as character no-undo .
     1647   define input  parameter p-obj-code as integer   no-undo .
     1648   define output parameter p-error as logical   no-undo .
     1649   define variable v-veto-man-doc as character no-undo .
     1650   define variable v-type        as character no-undo .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654     p-error = false .
     1655   run clntattr-value in this-procedure (
     1656    input p-obj-type ,
     1657    input p-obj-code ,
     1658    input 'veto-man-doc':U     ,
     1659    output v-veto-man-doc ,
     1660    output v-type        ) no-error .
     1661    if error-status :error then message
     1662      error-status :get-message(1) skip
     1663      return-value skip
     1664      "Ошибка clntattr-veto-man-doc"
     1665      view-as alert-box error
     1666    .
     1667     if v-veto-man-doc = 'ALL' then do:
     1668         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     1669         p-error = true .
     1670     end.
     1671    end.
     1672   end procedure.
     1673   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1675   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1676   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1677   ASSIGN
     1678      v-S_CONTRACT                = "Contract":U
     1679      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1680      v-DELIM_CHR_3               = ","
     1681      .
     1682   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1683   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1684   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1685   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1686      INPUT iHost-Code    AS INTEGER,
     1687      INPUT iContract-Num AS INTEGER,
     1688      INPUT iGds-Code     AS INTEGER ):
     1689      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1690      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1691      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1692      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1693      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1694      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1695          INPUT  iHost-Code,
     1696          INPUT  iContract-Num,
     1697          OUTPUT iTmp-Extent3
     1698          ).
     1699      IF iTmp-Extent3[1] = 2 THEN DO:
     1700         ASSIGN
     1701            iTmp-Host-Code      = iTmp-Extent3[2]
     1702            iTmp-Contract-Num   = iTmp-Extent3[3]
     1703            .
     1704      END. ELSE DO:
     1705         ASSIGN
     1706            iTmp-Host-Code      = iHost-Code
     1707            iTmp-Contract-Num   = iContract-Num
     1708            .
     1709      END.
     1710      IF iGds-Code = ? THEN DO:
     1711         ASSIGN
     1712            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1713                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1714                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1715                           ).
     1716      END. ELSE DO:
     1717            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1718                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1719                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1720                              AND buf_Spec.Gds-Code      = iGds-Code
     1721                            ).
     1722      END.
     1723      RETURN (lRet).
     1724   END FUNCTION.
     1725   PROCEDURE MS-Contract-EXTENT-3:
     1726      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1727      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1728      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1729      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1730      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1731      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1732      FIND FIRST buf_Cont-2 WHERE
     1733                 buf_Cont-2.Host-Code      = i-Host-Code
     1734             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1735           NO-LOCK NO-ERROR.
     1736      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1737         RETURN.
     1738      END.
     1739      FOR FIRST buf_Ext-Classif WHERE
     1740                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1741           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1742                                               STRING(i-Contract-code)
     1743           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1744          NO-LOCK,
     1745          EACH buf_Cont WHERE
     1746               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1747           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1748          NO-LOCK:
     1749          ASSIGN
     1750             i-Ret[1] = 1
     1751             i-Ret[2] = buf_Cont.Host-code
     1752             i-Ret[3] = buf_Cont.Contract-code
     1753             .
     1754          LEAVE.
     1755      END.
     1756      IF i-Ret[1] <> 1 THEN DO:
     1757         FOR FIRST buf_Ext-Classif WHERE
     1758                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1759              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1760                                                  STRING(i-Contract-code)
     1761              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1762             NO-LOCK,
     1763             EACH buf_Cont WHERE
     1764                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1765              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1766             NO-LOCK:
     1767             ASSIGN
     1768                i-Ret[1] = 2
     1769                i-Ret[2] = buf_Cont.Host-code
     1770                i-Ret[3] = buf_Cont.Contract-code
     1771                .
     1772             LEAVE.
     1773         END.
     1774      END.
     1775      RETURN.
     1776   END PROCEDURE.
