      134   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      135   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      136   procedure uf-name :
      137     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      138     define output parameter p-use-List_     as logical   no-undo .
      139     define output parameter p-type-List_     as character no-undo .
      140     define output parameter p-format-List_   as character no-undo .
      141     define output parameter p-use-Naim      as logical   no-undo .
      142     define output parameter p-type-Naim      as character no-undo .
      143     define output parameter p-format-Naim    as character no-undo .
      144     define output parameter p-use-print-graft as logical   no-undo .
      145     define output parameter p-use-sort-gr   as logical   no-undo .
      146     define output parameter p-use-type-price as logical   no-undo .
