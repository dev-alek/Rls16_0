      678   def
      679   new shared
      680   temp-table  obj-list no-undo
      681     field obj-type like ub.clients.obj-type
      682     field obj-code like ub.clients.obj-code
      683     field obj-name like ub.clients.obj-name
      684     field obj-id   as integer
      685     field db-num   as integer
      686     index pi is primary unique obj-id
      687     index ie1 obj-type obj-code
      688     index ie2 obj-name
      689   .
      690   procedure create_obj-list :
      691      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      692      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      693      do
      694      on error undo, return error return-value
      695      :
      696         define buffer cli-obj for ub.clients .
      697         define variable p-var as integer no-undo .
      698         define buffer buf_obj-list for obj-list .
      699         find last buf_obj-list  use-index pi no-error .
      700         if available buf_obj-list
      701         then
      702            p-var = buf_obj-list.obj-id + 1.
      703         else
      704            p-var = 1.
      705         find first cli-obj where
      706                   cli-obj.obj-type = p-obj-type
      707               and cli-obj.obj-code = p-obj-code
      708         no-lock no-error.
      709         if available cli-obj
      710         then do:
      711            create buf_obj-list.
      712            assign
      713               buf_obj-list.obj-id   = p-var
      714               buf_obj-list.obj-code = cli-obj.obj-code
      715               buf_obj-list.obj-type = cli-obj.obj-type
      716               buf_obj-list.obj-name = cli-obj.obj-name
      717               buf_obj-list.db-num   = cli-obj.db-num
      718            .
      719         end.
      720      end.
      721   end.
