     2922   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2923   on help of frame Dialog-Frame
     2924   do:
     2925     run gbl/app_help.p
     2926       (input this-procedure :file-name
     2927       ,input ''
     2928       ,input ?
     2929       ) no-error.
     2930     if error-status :error then do:
     2931       message
     2932         "Ошибка при вызове помощи"
     2933         error-status :get-message(1)
     2934         view-as alert-box .
     2935     end.
     2936   end.
     2937   run minbtn-set in this-procedure .
     2938   on choose of b-help in frame Dialog-Frame
     2939   do:
     2940     apply "help":u to frame Dialog-Frame .
     2941   end.
     2942   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2943   procedure minbtn-set :
     2944       do
     2945           on error undo, return error return-value
     2946           :
     2947           define variable ii              as integer       no-undo .
     2948           define variable fh              as widget-handle no-undo .
     2949           define variable hh              as widget-handle no-undo .
     2950           define variable v-h             as handle        extent 4 no-undo .
     2951           define variable v-name-button   as character     no-undo .
     2952           define variable v-help-old-x    as decimal       no-undo .
     2953           define variable v-help-old-y    as decimal       no-undo .
     2954           define variable v-help-old-size as decimal       no-undo .
     2955           define variable v-frame-width   as decimal       no-undo .
     2956           define variable jj              as integer       no-undo .
     2957           do
     2958               on error undo, return error
     2959               :
     2960               assign
     2961                   v-frame-width = frame Dialog-Frame:width - 0.3
     2962                   fh            = frame Dialog-Frame:first-child
     2963                   hh            = fh:first-child
     2964                   ii            = 1
     2965                   .
     2966               do while valid-handle(hh):
     2967                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2968                   do:
     2969                       case lc(hh:name) :
     2970                           when "b-help" then
     2971                               do:
     2972                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2973                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2974                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2975                                   hh:TOOLTIP = "Помощь" .
     2976                                   v-help-old-x = hh:column .
     2977                                   v-help-old-y = hh:row    .
     2978                                   v-help-old-size = hh:width .
     2979                                   hh:width-chars = 2.5 .
     2980                               end.
     2981                           when "b-print" then
     2982                               do:
     2983                                   hh:load-image("cmp/b-print.bmp":u) .
     2984                                   hh:TOOLTIP = "Печать" .
     2985                                   v-h[ii] = hh:handle .
     2986                                   ii = ii + 1 .
     2987                                   hh:width-chars = 3 .
     2988                               end.
     2989                           when "b-history" or
     2990                           when "b-hist" then
     2991                               do:
     2992                                   hh:load-image("cmp/b-hist.bmp":u) .
     2993                                   hh:TOOLTIP = "История" .
     2994                                   v-h[ii] = hh:handle .
     2995                                   ii = ii + 1 .
     2996                                   hh:width-chars = 3 .
     2997                               end.
     2998                           when "b-sch" then
     2999                               do:
     3000                                   hh:load-image("cmp/b-sch.bmp":u) .
     3001                                   hh:TOOLTIP = "Установка Фильтра" .
     3002                                   v-h[ii] = hh:handle .
     3003                                   ii = ii + 1 .
     3004                                   hh:width-chars = 3 .
     3005                               end.
     3006                           when "b-hist-user" then
     3007                               do:
     3008                                   hh:load-image("cmp/b-hist.bmp":u) .
     3009                                   hh:TOOLTIP = "История пользователя" .
     3010                                   ii = ii + 1 .
     3011                               end.
     3012                       end case.
     3013                   end.
     3014                   hh = hh:next-sibling.
     3015               end.
     3016               b-help:column = v-frame-width - b-help:width-chars.
     3017               jj = 0.
     3018               repeat ii = 4 to 1 by -1 :
     3019                   if valid-handle (v-h[ii] ) then
     3020                   do:
     3021                       jj  = jj + 1 .
     3022                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3023                       v-h[ii]:row    = v-help-old-y .
     3024                   end.
     3025               end.
     3026           end.
     3027       end.
     3028   end procedure.
     3029   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3030   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3031   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3032   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3033   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3034   define variable v-diasize-current-frame-height as decimal   no-undo .
     3035   define variable v-diasize-change-size          as logical   no-undo .
     3036   define variable v-diasize-resize-button        as handle    no-undo .
     3037   define variable v-diasize-wndmax               as logical   no-undo .
     3038   define variable v-diasize-wndstore             as logical   no-undo .
     3039   define variable v-diasize-proc-name            as character no-undo .
     3040   define variable v-diasize-browse-handle        as handle    no-undo .
     3041   define variable v-diasize-browse-number        as integer   no-undo .
     3042   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3043   define temp-table temp-diasize-handle no-undo
     3044     field handle-value  as handle
     3045     field save-position as decimal
     3046     index xpk is primary unique handle-value
     3047     .
     3048   define temp-table temp-browse-handle no-undo
     3049     field browse-type   as character
     3050     field browse-number as integer
     3051     field browse-handle as handle
     3052     field original-size as decimal
     3053     index xpk is primary unique browse-type browse-number
     3054     index xie browse-type browse-handle
     3055   .
     3056   procedure diasize_change-height :
     3057     define input  parameter p-change-value  as decimal   no-undo .
     3058     define input  parameter p-move-resize   as logical   no-undo .
     3059     define variable v-field-group-handle    as handle    no-undo .
     3060     define variable v-object-handle         as handle    no-undo .
     3061     define variable v-frame-height          as decimal   no-undo .
     3062     define variable v-frame-virtual-height  as decimal   no-undo .
     3063     define variable v-browse-height         as decimal   no-undo .
     3064     define variable v-window-height         as decimal   no-undo .
     3065     define variable v-window-virtual-height as decimal   no-undo .
     3066     define variable v-change-sign           as integer   no-undo .
     3067     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3068     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3069     if p-change-value > 0
     3070     then do:
     3071       if frame Dialog-Frame :height + p-change-value
     3072           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3073       then do:
     3074         assign
     3075           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3076                           - (frame Dialog-Frame :height-chars)
     3077         .
     3078         if p-change-value <= 0
     3079         then do:
     3080           run diasize_position-resize-button in this-procedure .
     3081           return .
     3082         end.
     3083       end.
     3084     end.
     3085     if p-change-value < 0
     3086     then do:
     3087       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3088       then do:
     3089         assign
     3090           p-change-value = v-diasize-orig-frame-height
     3091                          - (frame Dialog-Frame :height-chars)
     3092         .
     3093         if p-change-value >= 0
     3094         then do:
     3095           run diasize_position-resize-button in this-procedure .
     3096           return .
     3097         end.
     3098       end.
     3099     end.
     3100     if p-change-value >= 0
     3101     then do:
     3102       assign
     3103         v-change-sign = 1
     3104       .
     3105     end.
     3106     else do:
     3107       assign
     3108         v-change-sign = -1
     3109       .
     3110     end.
     3111     assign
     3112       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3113     .
     3114     if p-change-value = 0
     3115     then do:
     3116       run diasize_position-resize-button in this-procedure .
     3117       return .
     3118     end.
     3119     move_block:
     3120     do
     3121     on error undo move_block, retry move_block
     3122     :
     3123       if retry
     3124       then do:
     3125         do
     3126         on error undo move_block, leave move_block
     3127         :
     3128           if p-change-value > 0
     3129           then do:
     3130             for each buf_temp-diasize-handle
     3131             on error undo, next
     3132             :
     3133               assign
     3134                 v-object-handle = buf_temp-diasize-handle.handle-value
     3135               .
     3136               if v-object-handle <> v-diasize-resize-button
     3137               then do:
     3138                 assign
     3139                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3140                 .
     3141               end.
     3142             end.
     3143             assign
     3144               v-diasize-browse-handle :height = v-browse-height
     3145             .
     3146             for each buf_temp-browse-handle
     3147               where buf_temp-browse-handle.browse-type = 'height':u
     3148             on error undo, next
     3149             :
     3150               assign
     3151                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3152               .
     3153             end.
     3154             assign
     3155               frame Dialog-Frame :height = v-frame-height
     3156             .
     3157             if frame Dialog-Frame :scrollable = true
     3158             then do:
     3159               assign
     3160                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3161               .
     3162             end.
     3163             run diasize_position-resize-button in this-procedure .
     3164           end.
     3165           else do:
     3166             if frame Dialog-Frame :scrollable = true
     3167             then do:
     3168               assign
     3169                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3170               .
     3171             end.
     3172             assign
     3173               frame Dialog-Frame :height = v-frame-height
     3174             .
     3175             assign
     3176               v-diasize-browse-handle :height = v-browse-height
     3177             .
     3178             for each buf_temp-browse-handle
     3179               where buf_temp-browse-handle.browse-type = 'height':u
     3180             on error undo, next
     3181             :
     3182               assign
     3183                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3184               .
     3185             end.
     3186             for each buf_temp-diasize-handle
     3187             on error undo, next
     3188             :
     3189               assign
     3190                 v-object-handle = buf_temp-diasize-handle.handle-value
     3191               .
     3192               if v-object-handle <> v-diasize-resize-button
     3193               then do:
     3194                 assign
     3195                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3196                 .
     3197               end.
     3198             end.
     3199             run diasize_position-resize-button in this-procedure .
     3200           end.
     3201           assign
     3202             v-diasize-change-size = false
     3203           .
     3204           leave move_block .
     3205         end.
     3206       end.
     3207       assign
     3208         v-diasize-need-full-display = true
     3209       .
     3210       if v-diasize-change-size = false
     3211       then do:
     3212         assign
     3213           v-diasize-change-size = true
     3214         .
     3215       end.
     3216       else do:
     3217         return .
     3218       end.
     3219       assign
     3220         v-frame-height = frame Dialog-Frame :height
     3221         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3222         v-browse-height = v-diasize-browse-handle :height
     3223       .
     3224       for each buf_temp-browse-handle
     3225         where buf_temp-browse-handle.browse-type = 'height':u
     3226       :
     3227         assign
     3228           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3229         .
     3230       end.
     3231       for each buf_temp-diasize-handle
     3232       :
     3233         delete buf_temp-diasize-handle .
     3234       end.
     3235       assign
     3236         v-field-group-handle = frame Dialog-Frame :first-child
     3237       .
     3238       do while valid-handle(v-field-group-handle)
     3239       :
     3240         assign
     3241           v-object-handle = v-field-group-handle :first-child
     3242         .
     3243         do while valid-handle(v-object-handle)
     3244         :
     3245           if  v-object-handle <> v-diasize-browse-handle :handle
     3246           and can-query(v-object-handle, "row")
     3247           and can-query(v-object-handle, "height")
     3248           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3249           then do:
     3250             find first buf_temp-browse-handle
     3251               where buf_temp-browse-handle.browse-type   = 'height':u
     3252                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3253               no-error .
     3254             if available buf_temp-browse-handle
     3255             then do:
     3256             end.
     3257             else do:
     3258               create buf_temp-diasize-handle .
     3259               assign
     3260                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3261                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3262               .
     3263             end.
     3264           end.
     3265           assign
     3266             v-object-handle = v-object-handle :next-sibling
     3267           .
     3268         end.
     3269         assign
     3270           v-field-group-handle = v-field-group-handle :next-sibling
     3271         .
     3272       end.
     3273       do with frame Dialog-Frame
     3274       :
     3275         hide v-diasize-resize-button .
     3276         assign
     3277           v-diasize-resize-button :row    = 1
     3278           v-diasize-resize-button :column = 1
     3279         .
     3280       end.
     3281       if p-change-value > 0
     3282       then do:
     3283         if frame Dialog-Frame :scrollable = true
     3284         then do:
     3285           assign
     3286             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3287             no-error .
     3288           if error-status :error
     3289           or error-status :get-message(1) <> ""
     3290           then do:
     3291             undo move_block, retry move_block .
     3292           end.
     3293         end.
     3294         assign
     3295           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3296           no-error .
     3297         if error-status :error
     3298         or error-status :get-message(1) <> ""
     3299         then do:
     3300           undo move_block, retry move_block .
     3301         end.
     3302         assign
     3303           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3304           no-error .
     3305         if error-status :error
     3306         or error-status :get-message(1) <> ""
     3307         then do:
     3308           undo move_block, retry move_block .
     3309         end.
     3310         for each buf_temp-browse-handle
     3311           where buf_temp-browse-handle.browse-type = 'height':u
     3312         on error undo move_block, retry move_block
     3313         :
     3314           assign
     3315             buf_temp-browse-handle.browse-handle :height
     3316               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3317             no-error .
     3318           if error-status :error
     3319           or error-status :get-message(1) <> ""
     3320           then do:
     3321             undo move_block, retry move_block .
     3322           end.
     3323         end.
     3324         for each buf_temp-diasize-handle
     3325         on error undo move_block, retry move_block
     3326         :
     3327           assign
     3328             v-object-handle = buf_temp-diasize-handle.handle-value
     3329           .
     3330           if v-object-handle <> v-diasize-resize-button
     3331           then do:
     3332             assign
     3333               v-object-handle :row = v-object-handle :row + p-change-value
     3334               no-error .
     3335             if error-status :error
     3336             or error-status :get-message(1) <> ""
     3337             then do:
     3338               undo move_block, retry move_block .
     3339             end.
     3340           end.
     3341         end.
     3342       end.
     3343       else do:
     3344         for each buf_temp-diasize-handle
     3345         on error undo move_block, retry move_block
     3346         :
     3347           assign
     3348             v-object-handle = buf_temp-diasize-handle.handle-value
     3349           .
     3350           if v-object-handle <> v-diasize-resize-button
     3351           then do:
     3352             assign
     3353               v-object-handle :row = v-object-handle :row + p-change-value
     3354               no-error .
     3355             if error-status :error
     3356             or error-status :get-message(1) <> ""
     3357             then do:
     3358               undo move_block, retry move_block .
     3359             end.
     3360           end.
     3361         end.
     3362         assign
     3363           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3364           no-error .
     3365         if error-status :error
     3366         or error-status :get-message(1) <> ""
     3367         then do:
     3368           undo move_block, retry move_block .
     3369         end.
     3370         for each buf_temp-browse-handle
     3371           where buf_temp-browse-handle.browse-type = 'height':u
     3372         on error undo move_block, retry move_block
     3373         :
     3374           assign
     3375             buf_temp-browse-handle.browse-handle :height
     3376               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3377             no-error .
     3378           if error-status :error
     3379           or error-status :get-message(1) <> ""
     3380           then do:
     3381             undo move_block, retry move_block .
     3382           end.
     3383         end.
     3384         assign
     3385           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3386           no-error .
     3387         if error-status :error
     3388         or error-status :get-message(1) <> ""
     3389         then do:
     3390           undo move_block, retry move_block .
     3391         end.
     3392         if frame Dialog-Frame :scrollable = true
     3393         then do:
     3394           assign
     3395             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3396             no-error .
     3397           if error-status :error
     3398           or error-status :get-message(1) <> ""
     3399           then do:
     3400             undo move_block, retry move_block .
     3401           end.
     3402         end.
     3403       end.
     3404       if p-move-resize = true
     3405       then do:
     3406         run diasize_position-resize-button in this-procedure .
     3407       end.
     3408       if v-diasize-wndstore = true
     3409       then do:
     3410         if connected("ub") = true
     3411         then do:
     3412           define variable v-cntxt-db-num        as integer   no-undo .
     3413           define variable v-cntxt-userid        as character no-undo .
     3414           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3415                                             , OUTPUT v-cntxt-userid
     3416                                             ) .
     3417           run gbl/wndsizew.p
     3418             (input  v-cntxt-db-num
     3419             ,input  v-cntxt-userid
     3420             ,input  v-diasize-proc-name
     3421             ,input  'height':u
     3422             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3423             ) .
     3424         end.
     3425       end.
     3426     end.
     3427     assign
     3428       v-diasize-change-size = false
     3429     .
     3430   end procedure.
     3431   procedure diasize_set-height :
     3432     define input  parameter p-new-height  as decimal   no-undo .
     3433     define input  parameter p-move-resize as logical   no-undo .
     3434     do
     3435     on error undo, return error return-value
     3436     :
     3437       run diasize_change-height in this-procedure
     3438         (input  (p-new-height - frame Dialog-Frame :height)
     3439         ,input  p-move-resize
     3440         ) .
     3441     end.
     3442   end procedure.
     3443   procedure diasize_change-width :
     3444     define input  parameter p-change-value as decimal   no-undo .
     3445     define input  parameter p-move-resize  as logical   no-undo .
     3446     define variable v-field-group-handle   as handle    no-undo .
     3447     define variable v-object-handle        as handle    no-undo .
     3448     define variable v-frame-width          as decimal   no-undo .
     3449     define variable v-frame-virtual-width  as decimal   no-undo .
     3450     define variable v-browse-width         as decimal   no-undo .
     3451     define variable v-window-width         as decimal   no-undo .
     3452     define variable v-window-virtual-width as decimal   no-undo .
     3453     define variable v-change-sign          as integer   no-undo .
     3454     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3455     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3456     if p-change-value > 0
     3457     then do:
     3458       if frame Dialog-Frame :width + p-change-value >
     3459           session :width-chars
     3460       then do:
     3461         assign
     3462           p-change-value = session :width-chars - frame Dialog-Frame :width
     3463         .
     3464         if p-change-value <= 0
     3465         then do:
     3466           run diasize_position-resize-button in this-procedure .
     3467           return .
     3468         end.
     3469       end.
     3470     end.
     3471     if p-change-value < 0
     3472     then do:
     3473       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3474       then do:
     3475         assign
     3476           p-change-value = v-diasize-orig-frame-width
     3477                          - frame Dialog-Frame :width
     3478         .
     3479         if p-change-value >= 0
     3480         then do:
     3481           run diasize_position-resize-button in this-procedure .
     3482           return .
     3483         end.
     3484       end.
     3485     end.
     3486     if p-change-value >= 0
     3487     then do:
     3488       assign
     3489         v-change-sign = 1
     3490       .
     3491     end.
     3492     else do:
     3493       assign
     3494         v-change-sign = -1
     3495       .
     3496     end.
     3497     assign
     3498       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3499     .
     3500     if p-change-value = 0
     3501     then do:
     3502       run diasize_position-resize-button in this-procedure .
     3503       return .
     3504     end.
     3505     move_block:
     3506     do
     3507     on error undo move_block, leave move_block
     3508     :
     3509       if retry
     3510       then do:
     3511         do
     3512         on error undo move_block, leave move_block
     3513         :
     3514           if p-change-value > 0
     3515           then do:
     3516             for each buf_temp-diasize-handle
     3517             on error undo, next
     3518             :
     3519               assign
     3520                 v-object-handle = buf_temp-diasize-handle.handle-value
     3521               .
     3522               if v-object-handle <> v-diasize-resize-button
     3523               then do:
     3524                 assign
     3525                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3526                 .
     3527               end.
     3528             end.
     3529             assign
     3530               v-diasize-browse-handle :width = v-browse-width
     3531             .
     3532             for each buf_temp-browse-handle
     3533               where buf_temp-browse-handle.browse-type = 'width':u
     3534             on error undo, next
     3535             :
     3536               assign
     3537                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3538               .
     3539             end.
     3540             assign
     3541               frame Dialog-Frame :width = v-frame-width
     3542             .
     3543             if frame Dialog-Frame :scrollable = true
     3544             then do:
     3545               assign
     3546                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3547               .
     3548             end.
     3549             run diasize_position-resize-button in this-procedure .
     3550           end.
     3551           else do:
     3552             if frame Dialog-Frame :scrollable = true
     3553             then do:
     3554               assign
     3555                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3556               .
     3557             end.
     3558             assign
     3559               frame Dialog-Frame :width = v-frame-width
     3560             .
     3561             for each buf_temp-browse-handle
     3562               where buf_temp-browse-handle.browse-type = 'width':u
     3563             on error undo, next
     3564             :
     3565               assign
     3566                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3567               .
     3568             end.
     3569             assign
     3570               v-diasize-browse-handle :width = v-browse-width
     3571             .
     3572             for each buf_temp-diasize-handle
     3573             on error undo, next
     3574             :
     3575               assign
     3576                 v-object-handle = buf_temp-diasize-handle.handle-value
     3577               .
     3578               if v-object-handle <> v-diasize-resize-button
     3579               then do:
     3580                 assign
     3581                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3582                 .
     3583               end.
     3584             end.
     3585             run diasize_position-resize-button in this-procedure .
     3586           end.
     3587           assign
     3588             v-diasize-change-size = false
     3589           .
     3590           leave move_block .
     3591         end.
     3592       end.
     3593       assign
     3594         v-diasize-need-full-display = true
     3595       .
     3596       if v-diasize-change-size = false
     3597       then do:
     3598         assign
     3599           v-diasize-change-size = true
     3600         .
     3601       end.
     3602       else do:
     3603         return .
     3604       end.
     3605       assign
     3606         v-frame-width = frame Dialog-Frame :width
     3607         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3608         v-browse-width = v-diasize-browse-handle :width
     3609       .
     3610       for each buf_temp-browse-handle
     3611         where buf_temp-browse-handle.browse-type = 'width':u
     3612       :
     3613         assign
     3614           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3615         .
     3616       end.
     3617       for each buf_temp-diasize-handle
     3618       :
     3619         delete buf_temp-diasize-handle .
     3620       end.
     3621       assign
     3622         v-field-group-handle = frame Dialog-Frame :first-child
     3623       .
     3624       do while valid-handle(v-field-group-handle)
     3625       :
     3626         assign
     3627           v-object-handle = v-field-group-handle :first-child
     3628         .
     3629         do while valid-handle(v-object-handle)
     3630         :
     3631           if  v-object-handle <> v-diasize-browse-handle :handle
     3632           and v-object-handle <> v-diasize-resize-button
     3633           and can-query(v-object-handle, "row")
     3634           and can-query(v-object-handle, "height")
     3635           and ( v-object-handle :col + v-object-handle :width
     3636                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3637               )
     3638           then do:
     3639             find first buf_temp-browse-handle
     3640               where buf_temp-browse-handle.browse-type   = 'width':u
     3641                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3642               no-error .
     3643             if available buf_temp-browse-handle
     3644             then do:
     3645             end.
     3646             else do:
     3647               create buf_temp-diasize-handle .
     3648               assign
     3649                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3650                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3651               .
     3652             end.
     3653           end.
     3654           assign
     3655             v-object-handle = v-object-handle :next-sibling
     3656           .
     3657         end.
     3658         assign
     3659           v-field-group-handle = v-field-group-handle :next-sibling
     3660         .
     3661       end.
     3662       do with frame Dialog-Frame
     3663       :
     3664         hide v-diasize-resize-button .
     3665         v-diasize-resize-button :row = 1.
     3666         v-diasize-resize-button :column = 1.
     3667       end.
     3668       if p-change-value > 0
     3669       then do:
     3670         if frame Dialog-Frame :scrollable = true
     3671         then do:
     3672           assign
     3673             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3674             no-error .
     3675           if error-status :error
     3676           or error-status :get-message(1) <> ""
     3677           then do:
     3678             undo move_block, retry move_block.
     3679           end.
     3680         end.
     3681         assign
     3682           frame Dialog-Frame :width = v-frame-width + p-change-value
     3683           no-error .
     3684         if error-status :error
     3685         or error-status :get-message(1) <> ""
     3686         then do:
     3687           undo move_block, retry move_block.
     3688         end.
     3689         assign
     3690           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3691         no-error .
     3692         if error-status :error
     3693         or error-status :get-message(1) <> ""
     3694         then do:
     3695           undo move_block, retry move_block.
     3696         end.
     3697         for each buf_temp-browse-handle
     3698           where buf_temp-browse-handle.browse-type = 'width':u
     3699         on error undo move_block, retry move_block
     3700         :
     3701           assign
     3702             buf_temp-browse-handle.browse-handle :width
     3703               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3704             no-error .
     3705           if error-status :error
     3706           or error-status :get-message(1) <> ""
     3707           then do:
     3708             undo move_block, retry move_block .
     3709           end.
     3710         end.
     3711         for each buf_temp-diasize-handle
     3712         on error undo move_block, retry move_block
     3713         :
     3714           assign
     3715             v-object-handle = buf_temp-diasize-handle.handle-value
     3716           .
     3717           if v-object-handle <> v-diasize-resize-button
     3718           then do:
     3719             assign
     3720               v-object-handle :col = v-object-handle :col + p-change-value
     3721               no-error .
     3722             if error-status :error
     3723             or error-status :get-message(1) <> ""
     3724             then do:
     3725               undo move_block, retry move_block .
     3726             end.
     3727           end.
     3728         end.
     3729       end.
     3730       else do:
     3731         for each buf_temp-diasize-handle
     3732         on error undo move_block, retry move_block
     3733         :
     3734           assign
     3735             v-object-handle = buf_temp-diasize-handle.handle-value
     3736           .
     3737           if v-object-handle <> v-diasize-resize-button
     3738           then do:
     3739             assign
     3740               v-object-handle :col = v-object-handle :col + p-change-value
     3741               no-error .
     3742             if error-status :error
     3743             or error-status :get-message(1) <> ""
     3744             then do:
     3745               undo move_block, retry move_block .
     3746             end.
     3747           end.
     3748         end.
     3749         for each buf_temp-browse-handle
     3750           where buf_temp-browse-handle.browse-type = 'width':u
     3751         on error undo move_block, retry move_block
     3752         :
     3753           assign
     3754             buf_temp-browse-handle.browse-handle :width
     3755               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3756             no-error .
     3757           if error-status :error
     3758           or error-status :get-message(1) <> ""
     3759           then do:
     3760             undo move_block, retry move_block .
     3761           end.
     3762         end.
     3763         assign
     3764           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3765           no-error .
     3766         if error-status :error
     3767         or error-status :get-message(1) <> ""
     3768         then do:
     3769           undo move_block, retry move_block.
     3770         end.
     3771         assign
     3772           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3773         no-error .
     3774         if error-status :error
     3775         or error-status :get-message(1) <> ""
     3776         then do:
     3777           undo move_block, retry move_block.
     3778         end.
     3779         if frame Dialog-Frame :scrollable = true
     3780         then do:
     3781           assign
     3782             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3783           no-error .
     3784           if error-status :error
     3785           or error-status :get-message(1) <> ""
     3786           then do:
     3787             undo move_block, retry move_block.
     3788           end.
     3789         end.
     3790       end.
     3791       if p-move-resize
     3792       then do:
     3793         run diasize_position-resize-button in this-procedure .
     3794       end.
     3795       if v-diasize-wndstore = true
     3796       then do:
     3797         if connected("ub") = true
     3798         then do:
     3799           define variable v-cntxt-db-num        as integer   no-undo .
     3800           define variable v-cntxt-userid        as character no-undo .
     3801           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3802                                             , OUTPUT v-cntxt-userid
     3803                                             ) .
     3804           run gbl/wndsizew.p
     3805             (input  v-cntxt-db-num
     3806             ,input  v-cntxt-userid
     3807             ,input  v-diasize-proc-name
     3808             ,input  'width':u
     3809             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3810             ) .
     3811         end.
     3812       end.
     3813     end.
     3814     assign
     3815       v-diasize-change-size = false
     3816     .
     3817   end procedure.
     3818   procedure diasize_set-width :
     3819     define input  parameter p-new-width  as decimal   no-undo .
     3820     define input  parameter p-move-resize as logical   no-undo .
     3821     do
     3822     on error undo, return error return-value
     3823     :
     3824       run diasize_change-width in this-procedure
     3825         (input  (p-new-width - frame Dialog-Frame :width)
     3826         ,input  p-move-resize
     3827         ) .
     3828     end.
     3829   end procedure.
     3830   procedure diasize_position-resize-button :
     3831     do with frame Dialog-Frame
     3832     :
     3833       hide v-diasize-resize-button .
     3834       assign
     3835         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3836                     - 1
     3837                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3838         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3839                     - 1
     3840                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3841       .
     3842       view v-diasize-resize-button .
     3843     end.
     3844   end procedure.
     3845   on alt-right anywhere
     3846   do:
     3847     run diasize_change-width in this-procedure
     3848       (input 1
     3849       ,input true
     3850       ) .
     3851     return no-apply .
     3852   end.
     3853   on alt-left anywhere
     3854   do:
     3855     run diasize_change-width in this-procedure
     3856       (input -1
     3857       ,input true
     3858       ) .
     3859     return no-apply .
     3860   end.
     3861   on alt-down anywhere
     3862   do:
     3863     run diasize_change-height in this-procedure
     3864       (input 1
     3865       ,input true
     3866       ) .
     3867     return no-apply .
     3868   end.
     3869   on alt-up anywhere
     3870   do:
     3871     run diasize_change-height in this-procedure
     3872       (input -1
     3873       ,input true
     3874       ) .
     3875     return no-apply .
     3876   end.
     3877   on alt-enter of frame Dialog-Frame
     3878   do:
     3879     run diasize_maximize in this-procedure
     3880       (input  ?
     3881       ).
     3882     return no-apply .
     3883   end.
     3884   procedure diasize_end-move :
     3885     do
     3886     on error undo, return error return-value
     3887     :
     3888       define variable v-row-delta as decimal   no-undo .
     3889       define variable v-col-delta as decimal   no-undo .
     3890       define variable v-new-row as decimal   no-undo .
     3891       define variable v-new-col as decimal   no-undo .
     3892       assign
     3893         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3894         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3895       .
     3896       assign
     3897         v-row-delta = v-new-row - frame Dialog-Frame :height
     3898         v-col-delta = v-new-col - frame Dialog-Frame :width
     3899       .
     3900       run diasize_change-height in this-procedure
     3901         (input v-row-delta
     3902         ,input true
     3903         ) .
     3904       run diasize_change-width in this-procedure
     3905         (input v-col-delta
     3906         ,input true
     3907         ) .
     3908     end.
     3909   end procedure.
     3910   procedure diasize_maximize :
     3911     define input  parameter p-action as logical   no-undo .
     3912     do
     3913     on error undo, return error return-value
     3914     :
     3915       if p-action = ?
     3916       then do:
     3917         if v-diasize-need-maximize = true
     3918         then do:
     3919           assign
     3920             p-action = true
     3921           .
     3922         end.
     3923         else do:
     3924           assign
     3925             p-action = false
     3926           .
     3927         end.
     3928       end.
     3929       if p-action = true
     3930       then do:
     3931         run diasize_change-height in this-procedure
     3932           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3933               - frame Dialog-Frame :height-chars
     3934           ,input true
     3935           ) .
     3936         run diasize_change-width in this-procedure
     3937           (input session :width-chars
     3938               - frame Dialog-Frame :width-chars
     3939           ,input true
     3940           ) .
     3941         assign
     3942           v-diasize-need-maximize = false
     3943         .
     3944       end.
     3945       else do:
     3946         run diasize_change-width in this-procedure
     3947           (input v-diasize-orig-frame-width
     3948               - frame Dialog-Frame :width-chars
     3949           ,input true
     3950           ) .
     3951         run diasize_change-height in this-procedure
     3952           (input v-diasize-orig-frame-height
     3953               - frame Dialog-Frame :height-chars
     3954           ,input true
     3955           ) .
     3956         assign
     3957           v-diasize-need-maximize = true
     3958         .
     3959       end.
     3960     end.
     3961   end procedure.
     3962   procedure diasize_restore-orig-size :
     3963     do
     3964     on error undo, return error return-value
     3965     :
     3966       assign
     3967         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3968         v-diasize-current-frame-height = frame Dialog-Frame :height
     3969       .
     3970       run diasize_set-height in this-procedure
     3971         (input  v-diasize-orig-frame-height
     3972         ,input  true
     3973         ) .
     3974       run diasize_set-width in this-procedure
     3975         (input  v-diasize-orig-frame-width
     3976         ,input  true
     3977         ) .
     3978     end.
     3979   end procedure.
     3980   procedure diasize_restore-current-size :
     3981     do
     3982     on error undo, return error return-value
     3983     :
     3984       run diasize_set-height in this-procedure
     3985         (input  v-diasize-current-frame-height
     3986         ,input  true
     3987         ) .
     3988       run diasize_set-width in this-procedure
     3989         (input  v-diasize-current-frame-width
     3990         ,input  true
     3991         ) .
     3992     end.
     3993   end procedure.
     3994   procedure diasize_set-browse-handle :
     3995     define input  parameter p-browse-handle as handle   no-undo .
     3996     define buffer buf_temp-browse-handle for temp-browse-handle .
     3997     do
     3998     on error undo, return error return-value
     3999     :
     4000       assign
     4001         v-diasize-browse-handle = p-browse-handle
     4002       .
     4003       for each buf_temp-browse-handle
     4004       on error undo, return error return-value
     4005       :
     4006         delete buf_temp-browse-handle .
     4007       end.
     4008     end.
     4009   end procedure.
     4010   procedure diasize_add_browse :
     4011     define input  parameter p-browse-type   as character no-undo .
     4012     define input  parameter p-browse-handle as handle    no-undo .
     4013     define buffer buf_temp-browse-handle for temp-browse-handle .
     4014     do
     4015     on error undo, return error return-value
     4016     :
     4017       assign
     4018         v-diasize-browse-number = v-diasize-browse-number + 1
     4019       .
     4020       create buf_temp-browse-handle .
     4021       assign
     4022         buf_temp-browse-handle.browse-type   = p-browse-type
     4023         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4024         buf_temp-browse-handle.browse-handle = p-browse-handle
     4025       .
     4026     end.
     4027   end procedure.
     4028   procedure diasize_init :
     4029     define variable v-default-value    as logical   no-undo .
     4030     define variable v-restore-saved    as logical   no-undo .
     4031     define variable v-resize-value-str as character no-undo .
     4032     do
     4033     on error undo, return error return-value
     4034     :
     4035       do with frame Dialog-Frame
     4036       :
     4037         assign
     4038           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4039           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4040           v-diasize-browse-handle     = browse BROWSE-2 :handle
     4041         .
     4042         create button v-diasize-resize-button
     4043         assign
     4044           parent        = frame Dialog-Frame :first-child
     4045           label         = "s"
     4046           height-pixels = 16
     4047           width-pixels  = 16
     4048           visible       = true
     4049           sensitive     = true
     4050           movable       = true
     4051           triggers:
     4052             on end-move persistent run diasize_end-move in this-procedure .
     4053           end triggers.
     4054         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4055         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4056         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4057         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4058         assign
     4059           v-diasize-wndmax = false
     4060         .
     4061         if connected("ub") = true
     4062         then do:
     4063           define variable v-cntxt-db-num        as integer   no-undo .
     4064           define variable v-cntxt-userid        as character no-undo .
     4065           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4066                                             , OUTPUT v-cntxt-userid
     4067                                             ) .
     4068           run gbl/wndpar_r.p
     4069             (input  v-cntxt-db-num
     4070             ,input  v-cntxt-userid
     4071             ,input  'wndmax':U
     4072             ,output v-diasize-wndmax
     4073             ,output v-default-value
     4074             ) .
     4075         end.
     4076         assign
     4077           v-diasize-wndstore = false
     4078         .
     4079         if connected("ub") = true
     4080         then do:
     4081           run gbl/wndpar_r.p
     4082             (input  v-cntxt-db-num
     4083             ,input  v-cntxt-userid
     4084             ,input  'wndstore':U
     4085             ,output v-diasize-wndstore
     4086             ,output v-default-value
     4087             ) .
     4088         end.
     4089         assign
     4090           v-diasize-proc-name = entry(1, program-name(2), '.')
     4091         .
     4092         if v-diasize-wndstore = true
     4093         then do:
     4094           assign
     4095             v-restore-saved = false
     4096           .
     4097           if connected("ub") = true
     4098           then do:
     4099             run gbl/wndsizer.p
     4100               (input  v-cntxt-db-num
     4101               ,input  v-cntxt-userid
     4102               ,input  v-diasize-proc-name
     4103               ,input  'height':u
     4104               ,output v-resize-value-str
     4105               ) .
     4106             if v-resize-value-str <> '':U
     4107             then do:
     4108               run diasize_change-height in this-procedure
     4109                 (input  integer(v-resize-value-str)
     4110                 ,input  true
     4111                 ) .
     4112               assign
     4113                 v-restore-saved = true
     4114               .
     4115             end.
     4116           end.
     4117           if connected("ub") = true
     4118           then do:
     4119             run gbl/wndsizer.p
     4120               (input  v-cntxt-db-num
     4121               ,input  v-cntxt-userid
     4122               ,input  v-diasize-proc-name
     4123               ,input  'width':u
     4124               ,output v-resize-value-str
     4125               ) .
     4126             if v-resize-value-str <> '':U
     4127             then do:
     4128               run diasize_change-width in this-procedure
     4129                 (input  integer(v-resize-value-str)
     4130                 ,input  true
     4131                 ) .
     4132               assign
     4133                 v-restore-saved = true
     4134               .
     4135             end.
     4136           end.
     4137           if v-restore-saved <> true
     4138           then do:
     4139             if v-diasize-wndmax = true
     4140             then do:
     4141               run diasize_maximize in this-procedure
     4142                 (input  true
     4143                 ) .
     4144             end.
     4145           end.
     4146         end.
     4147         else do:
     4148           if v-diasize-wndmax = true
     4149           then do:
     4150             run diasize_maximize in this-procedure
     4151               (input  true
     4152               ) .
     4153           end.
     4154         end.
     4155       end.
     4156     end.
     4157   end procedure.
     4158   procedure diasize_need-full-display :
     4159     define output parameter p-need-full-display as logical   no-undo .
     4160     do
     4161     on error undo, return error return-value
     4162     :
     4163       assign
     4164         p-need-full-display = v-diasize-need-full-display
     4165       .
     4166       assign
     4167         v-diasize-need-full-display = false
     4168       .
     4169     end.
     4170   end procedure.
     4171   procedure get-context :
     4172      define output parameter p-db-num as integer          no-undo.
     4173      define output parameter p-user-id as character        no-undo.
     4174      define variable v-login               as character    no-undo.
     4175      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4176      define buffer buf_user-login  for ub.user-login .
     4177      do
     4178      on error undo, return error
     4179      :
     4180            FIND FIRST buf_sys-ctrl no-lock.
     4181            ASSIGN
     4182               v-login = USERID("ub")
     4183               p-db-num = buf_sys-ctrl.db-num
     4184            .
     4185            FIND FIRST buf_user-login
     4186                 WHERE buf_user-login.db-num = p-db-num
     4187                   AND buf_user-login.user-login = v-login
     4188                 no-lock
     4189                 no-error
     4190                 .
     4191            IF AVAILABLE buf_user-login
     4192            THEN DO:
     4193               assign
     4194                  p-user-id = buf_user-login.user-id
     4195               .
     4196            END.
     4197      end.
     4198   end procedure.
     4199       run diasize_init in this-procedure .
     4200   def var sort-labelBROWSE-2   as character no-undo .
     4201   def var sort-clmnBROWSE-2    as handle    no-undo .
     4202   def var cur-clmnBROWSE-2     as handle    no-undo .
     4203   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     4204   def var re-queryBROWSE-2     as logical   initial no no-undo .
     4205   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     4206      run sort-brBROWSE-2
     4207        (input (if available X_ord-line
     4208                then recid(X_ord-line)
     4209                else ?
     4210               )
     4211        ).
     4212   end.
     4213   PROCEDURE sort-brBROWSE-2 :
     4214     define input parameter p-recid as recid no-undo .
     4215     if re-queryBROWSE-2 = no then do:
     4216       assign
     4217          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     4218       .
     4219       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     4220       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     4221         assign
     4222            sort-labelBROWSE-2 = ""
     4223            sort-clmnBROWSE-2 = ?
     4224         .
     4225        end.
     4226        else do:
     4227          assign
     4228            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     4229            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     4230            sort-clmnBROWSE-2:column-fgcolor = 4
     4231          .
     4232        end.
     4233      end.
     4234     assign
     4235       cur-clmn-locBROWSE-2 = 1
     4236     .
     4237     def var column-handle as handle no-undo .
     4238     column-handle = BROWSE-2:first-column.
     4239     do while valid-handle(column-handle) :
     4240       if column-handle = cur-clmnBROWSE-2 then do:
     4241         leave .
     4242       end.
     4243       column-handle = column-handle:NEXT-COLUMN.
     4244       assign
     4245         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     4246       .
     4247     end.
     4248     case sort-labelBROWSE-2:
     4249           when 'N/п'  then DO:   assign     sort-column-name = "X_ord-line.line-num"   .   Run OpenBr.   . END.
     4250           when 'Код'  then DO:   assign     sort-column-name = "X_goods.gds-code"   .   Run OpenBr.   . END.
     4251           when 'Артикул'  then DO:   assign     sort-column-name = "X_ord-line.artic"   .   Run OpenBr.   . END.
     4252           when 'Название'  then DO:   assign     sort-column-name = "X_goods.gds-name"   .   Run OpenBr.   . END.
     4253           when 'Кол-во'  then DO:   assign     sort-column-name = "X_ord-line.qnty"   .   Run OpenBr.   . END.
     4254           when 'Рекомен-!довано  '  then DO:   assign     sort-column-name = "X_ord-line.initial-qnty"   .   Run OpenBr.   . END.
     4255           when 'ед.!изм'  then DO:   assign     sort-column-name = "X_goods.unit-base"   .   Run OpenBr.   . END.
     4256           when 'Заказано!в днях'  then DO:   assign     sort-column-name = "( if X_ord-line.temp-rash <> 0 then X_ord-line.order-qnty / X_ord-line.temp-rash  else 0 )"   .   Run OpenBr.   . END.
     4257           when 'Заказано'  then DO:   assign     sort-column-name = "X_ord-line.order-qnty"   .   Run OpenBr.   . END.
     4258           when 'Текущий!остаток РЦ'  then DO:   assign     sort-column-name = "v-rc-qnty"   .   Run OpenBr.   . END.
     4259           when 'ABC1'  then DO:   assign     sort-column-name = "(chr(int(X_ord-line.add-cli-qnty)) + string(X_ord-line.add-qnty))"   .   Run OpenBr.   . END.
     4260           when 'ABC2'  then DO:   assign     sort-column-name = "(chr(int(X_ord-line.cancel-cli-qnty)) + string(X_ord-line.cancel-qnty))"   .   Run OpenBr.   . END.
     4261           when 'Темп'  then DO:   assign     sort-column-name = "X_ord-line.temp-rash"   .   Run OpenBr.   . END.
     4262           when 'Свободный!остаток РЦ'  then DO:   assign     sort-column-name = "v-rc-qnty-free"   .   Run OpenBr.   . END.
     4263           when 'Остаток на!момент расчета'  then DO:   assign     sort-column-name = "X_ord-line.qnty-stk"   .   Run OpenBr.   . END.
     4264           when 'Остаток!в днях'  then DO:   assign     sort-column-name = "( if X_ord-line.temp-rash <> 0 then X_ord-line.qnty-stk / X_ord-line.temp-rash  else 0 )"   .   Run OpenBr.   . END.
     4265       otherwise do:
     4266         assign
     4267           sort-column-name = ""
     4268         .
     4269         Run OpenBr.
     4270           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-2') then do:
     4271             run mv-brw-defaultBROWSE-2.
     4272           end.
     4273         if sort-labelBROWSE-2 <> "" then do:
     4274           assign
     4275             cur-clmnBROWSE-2:column-fgcolor = 0
     4276           .
     4277         end.
     4278         assign
     4279           cur-clmn-locBROWSE-2 = ?
     4280         .
     4281       end.
     4282     end case.
     4283       if cur-clmn-locBROWSE-2 <> ? then do:
     4284         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-2') then do:
     4285           run ch-clmnBROWSE-2 in this-procedure (cur-clmn-locBROWSE-2).
     4286         end.
     4287       end.
     4288     if p-recid <> ? then do:
     4289       reposition BROWSE-2 to recid p-recid no-error.
     4290       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     4291     end.
     4292     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     4293   END PROCEDURE.
     4294   procedure re-open-query-srt-clmnBROWSE-2:
     4295   if cur-clmnBROWSE-2 = ? then do:
     4296      Run OpenBr.
     4297   end.
     4298   else do:
     4299      assign re-queryBROWSE-2 = yes.
     4300      run sort-brBROWSE-2
     4301        (input (if available X_ord-line
     4302                then recid(X_ord-line)
     4303                else ?
     4304               )
     4305        ).
     4306      assign re-queryBROWSE-2 = no.
     4307   end.
     4308   end.
     4309   X_ord-line.line-num:resizable in browse BROWSE-2   = true .
     4310   X_goods.gds-code:resizable in browse BROWSE-2   = true .
     4311   X_ord-line.artic:resizable in browse BROWSE-2   = true .
     4312   X_goods.gds-name:resizable in browse BROWSE-2   = true .
     4313   X_ord-line.qnty:resizable in browse BROWSE-2   = true .
     4314   X_goods.unit-base:resizable in browse BROWSE-2   = true .
     4315   X_ord-line.initial-qnty:resizable in browse BROWSE-2   = true .
     4316   X_ord-line.order-qnty:resizable in browse BROWSE-2   = true .
     4317   v-rc-qnty:resizable in browse BROWSE-2   = true .
     4318   X_ord-line.temp-rash:resizable in browse BROWSE-2   = true .
     4319   v-rc-qnty-free:resizable in browse BROWSE-2   = true .
     4320   X_ord-line.qnty-stk:resizable in browse BROWSE-2   = true .
     4321   X_ord-line.line-num:width     in browse BROWSE-2   = v-size-col1 .
     4322   X_goods.gds-code:width     in browse BROWSE-2   = v-size-col2 .
     4323   X_ord-line.artic:width     in browse BROWSE-2   = v-size-col3 .
     4324   X_goods.gds-name:width     in browse BROWSE-2   = v-size-col4 .
     4325   X_ord-line.qnty:width     in browse BROWSE-2   = v-size-col5 .
     4326   X_goods.unit-base:width     in browse BROWSE-2   = v-size-col7 .
     4327   v-rc-qnty:width     in browse BROWSE-2   = v-size-col10.
     4328   X_ord-line.temp-rash:width     in browse BROWSE-2   = v-size-col13.
     4329   v-rc-qnty-free:width     in browse BROWSE-2   = v-size-col14.
     4330   X_ord-line.qnty-stk:width     in browse BROWSE-2   = v-size-col15.
     4331   X_ord-line.initial-qnty:width      in browse BROWSE-2   = v-size-col6.
     4332   X_ord-line.order-qnty:width      in browse BROWSE-2   = v-size-col9.
     4333   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4334   on F9 of frame Dialog-Frame anywhere do:
     4335     run init-gds-rec.
     4336     if gds-rec = ? then
     4337       return no-apply.
     4338     run ref/gds-form.w ( input parparentproc
     4339                         ,input 'ПРОСМОТР':U
     4340                         ,input ?
     4341                         ,input ?
     4342                         ,input ?
     4343                         ,input-output gds-rec).
     4344     apply "entry" to browse-2 in frame Dialog-Frame.
     4345     return no-apply.
     4346   end.
     4347   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4348   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
     4349   DO:
     4350      run proc-r-boss in this-procedure .
     4351   END.
     4352   ON LEAVE OF scr-boss IN FRAME Dialog-Frame
     4353   DO:
     4354   run leave-proc-boss in this-procedure .
     4355   END.
     4356   ON  RETURN OF scr-boss IN FRAME Dialog-Frame
     4357   DO:
     4358     run next-focus in this-procedure  (input  scr-boss:handle ) .
     4359     return no-apply .
     4360   END.
     4361   ON MOUSE-SELECT-DBLCLICK OF scr-boss IN FRAME Dialog-Frame
     4362   DO:
     4363     apply "choose" to r-boss in frame Dialog-Frame.
     4364     return no-apply .
     4365   end.
     4366   Procedure proc-r-boss :
     4367    do
     4368    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4369    :
     4370    define variable rid-list    as  char no-undo .
     4371    define variable v-recid as recid no-undo .
     4372    define variable old-types as character no-undo .
     4373    define buffer boss#clients for ub.clients.
     4374       run ref/cli-all.w
     4375       ( input parParentProc, input "b-sel", 'чел':U, ?, ?, ?, ?, ?, output  rid-list).
     4376       Assign
     4377         v-recid = integer(rid-list)
     4378         .
     4379       find first boss#clients no-lock WHERE recid(boss#clients) = v-recid  No-ERROR.
     4380       if avail boss#clients then
     4381           Assign
     4382               scr-boss = boss#clients.obj-code
     4383               scr-boss-name = boss#clients.obj-name
     4384               .
     4385       else
     4386          Assign
     4387             scr-boss-name = ""
     4388             scr-boss = ?
     4389             .
     4390       Display scr-boss scr-boss-name with frame Dialog-Frame .
     4391   end.
     4392   end procedure.
     4393   procedure leave-proc-boss :
     4394    do
     4395    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4396    :
     4397     def buffer buf_clients for ub.clients.
     4398     Assign frame Dialog-Frame scr-boss .
     4399     if scr-boss <> ? and scr-boss <> 0 then do:
     4400         find first buf_clients no-lock where
     4401                   buf_clients.obj-type = 'чел':U  and
     4402                   buf_clients.obj-code  = scr-boss no-error.
     4403             if error-status :error or not available buf_clients then do:
     4404                 Message "Неправильно задан "  scr-boss:label in frame Dialog-Frame.
     4405                   Assign
     4406                   scr-boss-name = ""
     4407                   scr-boss = ?
     4408                   .
     4409                 Display  scr-boss scr-boss-name with frame Dialog-Frame.
     4410                 apply "CHOOSE" to r-boss in frame Dialog-Frame .
     4411             end.
     4412             if available buf_clients Then DO:
     4413                   scr-boss      = buf_clients.obj-code .
     4414                   scr-boss-name = buf_clients.obj-name .
     4415             End.
     4416    End.
     4417    else do:
     4418         Assign
     4419           scr-boss-name = ""
     4420           scr-boss = ?
     4421           .
     4422     end.
     4423    Display  scr-boss scr-boss-name with frame Dialog-Frame.
     4424    end.
     4425   end procedure.
     4426   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4427   ON CHOOSE OF r-agnt IN FRAME Dialog-Frame
     4428   DO:
     4429      run proc-r-agnt in this-procedure .
     4430   END.
     4431   ON LEAVE OF scr-agnt IN FRAME Dialog-Frame
     4432   DO:
     4433   run leave-proc-agnt in this-procedure .
     4434   END.
     4435   ON  RETURN OF scr-agnt IN FRAME Dialog-Frame
     4436   DO:
     4437     run next-focus in this-procedure  (input  scr-agnt:handle ) .
     4438     return no-apply .
     4439   END.
     4440   ON MOUSE-SELECT-DBLCLICK OF scr-agnt IN FRAME Dialog-Frame
     4441   DO:
     4442     apply "choose" to r-agnt in frame Dialog-Frame.
     4443     return no-apply .
     4444   end.
     4445   Procedure proc-r-agnt :
     4446    do
     4447    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4448    :
     4449    define variable rid-list    as  char no-undo .
     4450    define variable v-recid as recid no-undo .
     4451    define variable old-types as character no-undo .
     4452    define buffer agnt#clients for ub.clients.
     4453       run ref/cli-all.w
     4454       ( input parParentProc, input "b-sel", 'чел':U, ?, ?, ?, ?, ?, output  rid-list).
     4455       Assign
     4456         v-recid = integer(rid-list)
     4457         .
     4458       find first agnt#clients no-lock WHERE recid(agnt#clients) = v-recid  No-ERROR.
     4459       if avail agnt#clients then
     4460           Assign
     4461               scr-agnt = agnt#clients.obj-code
     4462               scr-agnt-name = agnt#clients.obj-name
     4463               .
     4464       else
     4465          Assign
     4466             scr-agnt-name = ""
     4467             scr-agnt = ?
     4468             .
     4469       Display scr-agnt scr-agnt-name with frame Dialog-Frame .
     4470   end.
     4471   end procedure.
     4472   procedure leave-proc-agnt :
     4473    do
     4474    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4475    :
     4476     def buffer buf_clients for ub.clients.
     4477     Assign frame Dialog-Frame scr-agnt .
     4478     if scr-agnt <> ? and scr-agnt <> 0 then do:
     4479         find first buf_clients no-lock where
     4480                   buf_clients.obj-type = 'чел':U  and
     4481                   buf_clients.obj-code  = scr-agnt no-error.
     4482             if error-status :error or not available buf_clients then do:
     4483                 Message "Неправильно задан "  scr-agnt:label in frame Dialog-Frame.
     4484                   Assign
     4485                   scr-agnt-name = ""
     4486                   scr-agnt = ?
     4487                   .
     4488                 Display  scr-agnt scr-agnt-name with frame Dialog-Frame.
     4489                 apply "CHOOSE" to r-agnt in frame Dialog-Frame .
     4490             end.
     4491             if available buf_clients Then DO:
     4492                   scr-agnt      = buf_clients.obj-code .
     4493                   scr-agnt-name = buf_clients.obj-name .
     4494             End.
     4495    End.
     4496    else do:
     4497         Assign
     4498           scr-agnt-name = ""
     4499           scr-agnt = ?
     4500           .
     4501     end.
     4502    Display  scr-agnt scr-agnt-name with frame Dialog-Frame.
     4503    end.
     4504   end procedure.
     4505   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4506   ON CHOOSE OF r-wrkr IN FRAME Dialog-Frame
     4507   DO:
     4508      run proc-r-wrkr in this-procedure .
     4509   END.
     4510   ON LEAVE OF scr-wrkr IN FRAME Dialog-Frame
     4511   DO:
     4512   run leave-proc-wrkr in this-procedure .
     4513   END.
     4514   ON  RETURN OF scr-wrkr IN FRAME Dialog-Frame
     4515   DO:
     4516     run next-focus in this-procedure  (input  scr-wrkr:handle ) .
     4517     return no-apply .
     4518   END.
     4519   ON MOUSE-SELECT-DBLCLICK OF scr-wrkr IN FRAME Dialog-Frame
     4520   DO:
     4521     apply "choose" to r-wrkr in frame Dialog-Frame.
     4522     return no-apply .
     4523   end.
     4524   Procedure proc-r-wrkr :
     4525    do
     4526    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4527    :
     4528    define variable rid-list    as  char no-undo .
     4529    define variable v-recid as recid no-undo .
     4530    define variable old-types as character no-undo .
     4531    define buffer wrkr#clients for ub.clients.
     4532       run ref/cli-all.w
     4533       ( input parParentProc, input "b-sel", 'чел':U, ?, ?, ?, ?, ?, output  rid-list).
     4534       Assign
     4535         v-recid = integer(rid-list)
     4536         .
     4537       find first wrkr#clients no-lock WHERE recid(wrkr#clients) = v-recid  No-ERROR.
     4538       if avail wrkr#clients then
     4539           Assign
     4540               scr-wrkr = wrkr#clients.obj-code
     4541               scr-wrkr-name = wrkr#clients.obj-name
     4542               .
     4543       else
     4544          Assign
     4545             scr-wrkr-name = ""
     4546             scr-wrkr = ?
     4547             .
     4548       Display scr-wrkr scr-wrkr-name with frame Dialog-Frame .
     4549   end.
     4550   end procedure.
     4551   procedure leave-proc-wrkr :
     4552    do
     4553    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4554    :
     4555     def buffer buf_clients for ub.clients.
     4556     Assign frame Dialog-Frame scr-wrkr .
     4557     if scr-wrkr <> ? and scr-wrkr <> 0 then do:
     4558         find first buf_clients no-lock where
     4559                   buf_clients.obj-type = 'чел':U  and
     4560                   buf_clients.obj-code  = scr-wrkr no-error.
     4561             if error-status :error or not available buf_clients then do:
     4562                 Message "Неправильно задан "  scr-wrkr:label in frame Dialog-Frame.
     4563                   Assign
     4564                   scr-wrkr-name = ""
     4565                   scr-wrkr = ?
     4566                   .
     4567                 Display  scr-wrkr scr-wrkr-name with frame Dialog-Frame.
     4568                 apply "CHOOSE" to r-wrkr in frame Dialog-Frame .
     4569             end.
     4570             if available buf_clients Then DO:
     4571                   scr-wrkr      = buf_clients.obj-code .
     4572                   scr-wrkr-name = buf_clients.obj-name .
     4573             End.
     4574    End.
     4575    else do:
     4576         Assign
     4577           scr-wrkr-name = ""
     4578           scr-wrkr = ?
     4579           .
     4580     end.
     4581    Display  scr-wrkr scr-wrkr-name with frame Dialog-Frame.
     4582    end.
     4583   end procedure.
     4584   on end-error, stop of frame Dialog-Frame  do:
     4585     apply "choose" to b-exit in frame Dialog-Frame .
     4586     return no-apply.
     4587   end.
     4588   MAIN-BLOCK:
     4589   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4590      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4591   define variable loc-order-type as integer no-undo .
     4592   define variable v-i-doc as character no-undo .
     4593   define variable v-value-character as character no-undo .
     4594   define variable v-value-date      as date      no-undo .
     4595   define variable v-value-decimal   as decimal   no-undo .
     4596   define variable v-value-int as integer   no-undo .
     4597   define variable v-value-logical as logical   no-undo .
     4598   define variable par-type as character no-undo .
     4599   define buffer bufc_clients for ub.clients  .
     4600     if p-mode <> 'ПРОСМОТР':U then do:
     4601     empty temp-table thbjattr_thbj-attr .
     4602       run adm/shattri.p (
     4603        input "get":U
     4604       ,input  v-cntxt-obj-type
     4605       ,input  v-cntxt-obj-code
     4606       ,input 'ord-obj':U
     4607       ,input ""
     4608       ,output v-value-character
     4609       ,output v-value-date
     4610       ,output v-value-decimal
     4611       ,output v-value-int
     4612       ,output v-value-logical
     4613       ,output par-type
     4614       ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4615       ) no-error .
     4616       for each thbjattr_thbj-attr :
     4617          if thbjattr_thbj-attr.prop-code = "ord-askp"    then v-ord-askp    =  thbjattr_thbj-attr.property-value-logical.
     4618          if thbjattr_thbj-attr.prop-code = "ord-obj-rc"  then v-ord-obj-rc  =  thbjattr_thbj-attr.property-value-character.
     4619       end.
     4620       if p-mode  = 'ДОБАВЛЕНИЕ':U then do:
     4621   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4622   run proc-ord-code in this-procedure
     4623    (input   'main' ,
     4624     input   v-cntxt-db-num ,
     4625     input   v-cntxt-obj-type ,
     4626     input   v-cntxt-obj-code ,
     4627     input   v-i-doc ,
     4628     output  loc-ord-num
     4629    ) .
     4630         if ( loc-cli-code = 0  or loc-cli-code = ? ) and v-ord-obj-rc <> ""  then  do:
     4631             assign
     4632             loc-cli-type = substring(v-ord-obj-rc,1,3)
     4633             loc-cli-code = int(substring(v-ord-obj-rc,4,10))
     4634             no-error
     4635             .
     4636             if not error-status :error then DO:
     4637              find first bufc_clients no-lock where
     4638                         bufc_clients.obj-code = loc-cli-code and
     4639                         bufc_clients.obj-type = loc-cli-type no-error .
     4640              if available bufc_clients then do:
     4641              scr-cli-name = bufc_clients.obj-name .
     4642              scr-cli = loc-cli-code               .
     4643              end.
     4644             display
     4645               scr-cli
     4646               scr-cli-name
     4647               with frame Dialog-Frame .
     4648               loc-obj-type = v-cntxt-obj-type .
     4649               loc-obj-code = v-cntxt-obj-code .
     4650               run p-cont .
     4651             END.
     4652         end.
     4653         run create-ord-doc in this-procedure (
     4654             input loc-ord-num  ,
     4655             input loc-cli-code ,
     4656             input loc-cli-type ,
     4657             input ""           ,
     4658             input ""           ,
     4659             input v-cntxt-host-code-obj ,
     4660             input v-cntxt-obj-code      ,
     4661             input v-cntxt-obj-type      ,
     4662             input 'ОР':U       ,
     4663             input 'новый':U   ,
     4664             input today        ,
     4665             input today        ,
     4666             input  loc-order-type ,
     4667             input  loc-contract ,
     4668             output p-ord-doc-recid )
     4669             .
     4670       end.
     4671     do transaction on error undo, return error return-value :
     4672       find first buf_ord-doc  exclusive-lock  where
     4673            recid(buf_ord-doc) = p-ord-doc-recid no-error .
     4674            if error-status :error then do:
     4675            message vss-workfile vss-revision vss-description skip
     4676                   "Ошибка  " skip
     4677                    skip
     4678                    error-status :get-message(1) skip
     4679                    return-value skip
     4680                    view-as alert-box error
     4681            .
     4682            return error.
     4683            end.
     4684     end.
     4685    loc-ord-num = buf_ord-doc.doc-code .
     4686   X_ord-line.qnty:read-only in browse BROWSE-2 = true .
     4687   scr-e-method:read-only in frame Dialog-Frame  = true .
     4688       run recalc-head in this-procedure .
     4689       run my-enable_ui in this-procedure .
     4690     end.
     4691     else do:
     4692         find first buf_ord-doc  no-lock where
     4693              recid(buf_ord-doc) = p-ord-doc-recid no-error .
     4694            if error-status :error then do:
     4695            message vss-workfile vss-revision vss-description skip
     4696                   "Ошибка просмотра " skip
     4697                    skip
     4698                    error-status :get-message(1) skip
     4699                    return-value skip
     4700                    view-as alert-box error
     4701            .
     4702            return error.
     4703            end.
     4704         loc-ord-num = buf_ord-doc.doc-code .
     4705         run recalc-head in this-procedure .
     4706         run my-enable-lkp in this-procedure .
     4707     end.
     4708   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4709   DEF VAR cur-clmn-numBROWSE-2 as INT EXTENT 16 no-undo.
     4710   DEF VAR varmviBROWSE-2       as INT no-undo.
     4711   DEF VAR varmvjBROWSE-2       as INT no-undo.
     4712   DEF VAR varmvkBROWSE-2       as INT no-undo.
     4713   DEF VAR varmvlBROWSE-2       as INT no-undo.
     4714   DEF VAR move-elementBROWSE-2 as INT no-undo.
     4715   def var jjBROWSE-2           as int no-undo.
     4716   do varmviBROWSE-2 = 1 to EXTENT(cur-clmn-numBROWSE-2):
     4717     ASSIGN cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmviBROWSE-2.
     4718   END.
     4719   RUN start-mv-clmnBROWSE-2.
     4720   PROCEDURE start-mv-clmnBROWSE-2:
     4721   def var old-session as logical no-undo.
     4722      old-session = SESSION:IMMEDIATE-DISPLAY.
     4723      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4724          IF  true = true   THEN DO:
     4725      DO jjBROWSE-2 = NUM-ENTRIES(v-order-col) TO 1 BY -1:
     4726        RUN re-move-clmnBROWSE-2 ( cur-clmn-numBROWSE-2[INTEGER(ENTRY (jjBROWSE-2, v-order-col))] , 1).
     4727      END.
     4728          END.
     4729      SESSION:IMMEDIATE-DISPLAY = old-session.
     4730   END.
     4731   ON ctrl-cursor-right OF BROWSE BROWSE-2 do:
     4732     RUN re-move-clmnBROWSE-2 ( 1, 16).
     4733   END.
     4734   ON ctrl-cursor-left OF BROWSE BROWSE-2 do:
     4735     RUN re-move-clmnBROWSE-2 (16, 1).
     4736   END.
     4737   PROCEDURE re-move-clmnBROWSE-2:
     4738     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4739     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4740     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4741       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = source-column THEN cur-clmn-numBROWSE-2[varmviBROWSE-2] = -1.
     4742     END.
     4743     if BROWSE-2:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4744     if source-column > target-column THEN
     4745     DO varmvjBROWSE-2 = source-column - 1 to target-column BY -1:
     4746       DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4747           if cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmvjBROWSE-2 THEN DO:
     4748             cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-numBROWSE-2[varmviBROWSE-2] + 1.
     4749           END.
     4750       END.
     4751     END.
     4752     ELSE
     4753     DO varmvjBROWSE-2 = source-column + 1 to target-column:
     4754       DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4755         if cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmvjBROWSE-2 THEN DO:
     4756           cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-numBROWSE-2[varmviBROWSE-2] - 1.
     4757         END.
     4758       END.
     4759     END.
     4760     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4761       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = -1 THEN cur-clmn-numBROWSE-2[varmviBROWSE-2] = target-column.
     4762     END.
     4763   END PROCEDURE.
     4764   PROCEDURE ch-clmnBROWSE-2:
     4765     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4766     if cur-clmn-loc <= 1 then do:
     4767       return .
     4768     end.
     4769     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     4770       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-loc THEN move-elementBROWSE-2 = varmviBROWSE-2.
     4771     END.
     4772     RUN re-move-clmnBROWSE-2 (cur-clmn-loc, 1).
     4773   END PROCEDURE.
     4774   PROCEDURE mv-brw-defaultBROWSE-2:
     4775   def var old-session as logical no-undo.
     4776     old-session = SESSION:IMMEDIATE-DISPLAY.
     4777     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4778     do varmvlBROWSE-2 = 1 to EXTENT(cur-clmn-numBROWSE-2):
     4779       RUN re-move-clmnBROWSE-2 (cur-clmn-numBROWSE-2[varmvlBROWSE-2], varmvlBROWSE-2).
     4780     END.
     4781     RUN start-mv-clmnBROWSE-2.
     4782     SESSION:IMMEDIATE-DISPLAY = old-session.
     4783   END PROCEDURE.
     4784   .
     4785   if  ( (buf_ord-doc.status_ = 'новый':U ) or
     4786       (  buf_ord-doc.status_ = 'запрос':U and buf_ord-doc.flag_ = false )) then do:
     4787          X_ord-line.order-qnty :visible  in browse BROWSE-2    =  false .
     4788   end.
     4789   else do:
     4790      X_ord-line.order-qnty :visible  in browse BROWSE-2    =  true  .
     4791   end.
     4792   if p-mode  = 'ДОБАВЛЕНИЕ':U then X_ord-line.order-qnty :visible  in browse BROWSE-2    =  false .
     4793   if buf_ord-doc.status_ = 'запрос':U then
     4794     disable b-add b-calc b-del r-cli
     4795             scr-ship-date scr-pay-day
     4796             scr-wrkr  r-wrkr
     4797             scr-agnt  r-agnt
     4798             scr-boss  r-boss
     4799     with frame Dialog-Frame .
     4800   if p-mode <> 'ПРОСМОТР':U  then do:
     4801     if p-mode  = 'ДОБАВЛЕНИЕ':U
     4802     then
     4803          wait-for go  of frame Dialog-Frame focus  scr-ship-date.
     4804     else
     4805         wait-for go  of frame Dialog-Frame focus browse-2.
     4806   end.
     4807   else do:
     4808         wait-for go  of frame Dialog-Frame focus b-exit.
     4809   end.
     4810   END.
     4811   run disable_ui in this-procedure .
     4812   PROCEDURE add-spec-gds :
     4813   define variable ii as integer   no-undo .
     4814   define variable v-i as integer   no-undo .
     4815   define variable t-ret as logical   no-undo .
     4816   define variable r-tmp as recid no-undo .
     4817   define variable r-ord as recid no-undo .
     4818   define variable r-stop as logical no-undo .
     4819   define variable r-exit as logical no-undo .
     4820   define variable v-rid-list as character no-undo .
     4821   define variable v-choice as integer   no-undo .
     4822   define buffer buf_ord-line for ub.ord-line  .
     4823   define buffer bf_contract-specif for ub.contract-specif  .
     4824     do
     4825     on error undo, return error return-value
     4826     :
     4827   if loc-contract = 0 or loc-contract = ? then return .
     4828   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4829   ASSIGN
     4830      i-gl-Host-Code      = 0
     4831      i-gl-Contract-Code  = 0
     4832      i-gl-Extent3        = 0
     4833      .
     4834   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4835       INPUT  v-cntxt-host-code-obj,
     4836       INPUT  loc-contract,
     4837       OUTPUT i-gl-Extent3
     4838      ).
     4839   IF i-gl-Extent3[1] = 2 THEN DO:
     4840      ASSIGN
     4841         i-gl-Host-Code      = i-gl-Extent3[2]
     4842         i-gl-Contract-Code  = i-gl-Extent3[3]
     4843         .
     4844   END. ELSE DO:
     4845      ASSIGN
     4846         i-gl-Host-Code      = v-cntxt-host-code-obj
     4847         i-gl-Contract-Code  = loc-contract
     4848         .
     4849   END.
     4850       FIND FIRST bf_contract-specif
     4851              NO-LOCK
     4852              WHERE
     4853                  bf_contract-specif.Host-code    = i-gl-Host-Code
     4854              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
     4855              NO-ERROR
     4856              .
     4857   if not available bf_contract-specif then return .
     4858         run gbl/d-askw.w
     4859           (input "Данные из спецификации"
     4860           ,input "Выберите один из пунктов для добавления в заказ" + chr(10)
     4861                + "товаров по спецификации к договору" + chr(10)
     4862           ,input "|"
     4863           ,input "Все|Выборочно|Обновить|Отказ"
     4864           ,input "Все недобавленные товары по спецификации|"
     4865                + "Выборочно товары по спецификации|"
     4866                + "Обновить цены из спецификации|"
     4867                + "Отказ от выполнения операции"
     4868           ,input 1
     4869           ,input 4
     4870           ,output v-choice
     4871           ).
     4872         if v-choice = 4 then do:
     4873           return.
     4874         end.
     4875   t-ret =  session:set-wait-state("general") .
     4876   ii = 0.
     4877   case v-choice :
     4878   when 1 then do:
     4879      line-mode = 'ДОБАВЛЕНИЕ':U .
     4880   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4881   ASSIGN
     4882      i-gl-Host-Code      = 0
     4883      i-gl-Contract-Code  = 0
     4884      i-gl-Extent3        = 0
     4885      .
     4886   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4887       INPUT  v-cntxt-host-code-obj,
     4888       INPUT  loc-contract,
     4889       OUTPUT i-gl-Extent3
     4890      ).
     4891   IF i-gl-Extent3[1] = 2 THEN DO:
     4892      ASSIGN
     4893         i-gl-Host-Code      = i-gl-Extent3[2]
     4894         i-gl-Contract-Code  = i-gl-Extent3[3]
     4895         .
     4896   END. ELSE DO:
     4897      ASSIGN
     4898         i-gl-Host-Code      = v-cntxt-host-code-obj
     4899         i-gl-Contract-Code  = loc-contract
     4900         .
     4901   END.
     4902   FOR EACH
     4903       ub.contract-specif
     4904        NO-LOCK
     4905        WHERE
     4906            ub.contract-specif.Host-code    = i-gl-Host-Code
     4907        AND ub.contract-specif.Contract-num = i-gl-Contract-Code
     4908        :
     4909          find first  buf_ord-line  exclusive-lock      where
     4910                   buf_ord-line.gds-code = ub.contract-specif.gds-code  and
     4911                   buf_ord-line.doc-code = loc-ord-num
     4912                   no-error .
     4913             if available buf_ord-line then do:
     4914                run cus/ord-frmo.w (parParentProc , input ?  , input recid ( buf_ord-line)  , input 'ИЗМЕНЕНИЕ':U,  output r-stop , output r-exit ) no-error .
     4915             end.
     4916             else do:
     4917                 ii = ii + 1 .
     4918                 run create-tmp-contr-sp in this-procedure  ( input (recid(ub.contract-specif)) , output r-tmp , output r-ord).
     4919                 if not t-auto then do:
     4920                       run cus/ord-frmo.w
     4921                         ( input parParentProc ,
     4922                           input r-tmp  ,
     4923                           input r-ord  ,
     4924                           input line-mode,
     4925                           output r-stop ,
     4926                           output r-exit ) .
     4927                         if r-stop then do:
     4928                             run p-delete in this-procedure
     4929                               ( r-tmp , input-output ii).
     4930                             leave.
     4931                         end.
     4932                         if r-exit then do:
     4933                             run p-delete in this-procedure
     4934                                 ( r-tmp , input-output ii ) .
     4935                         end.
     4936                 end.
     4937             end.
     4938      end.
     4939   end.
     4940   when 2 then do:
     4941      run str/contspec.w (input parparentproc,
     4942                         input "b-sel,b-mark",
     4943                         input 'ПРОСМОТР':U,
     4944                         input v-cntxt-host-code-obj,
     4945                         input loc-contract,
     4946                         output v-rid-list) .
     4947         if v-rid-list = '':u then do:
     4948           message "Нет выбранных товаров по спецификации."
     4949             view-as alert-box.
     4950         end.
     4951       line-mode = 'ДОБАВЛЕНИЕ':U .
     4952       do v-i = 1 to num-entries(v-rid-list) :
     4953        find ub.contract-specif where recid(ub.contract-specif) = integer(entry(v-i, v-rid-list)) no-lock no-error.
     4954        if error-status :error then next.
     4955        ii = ii + 1 .
     4956        run create-tmp-contr-sp in this-procedure  (input recid(ub.contract-specif), output r-tmp , output r-ord).
     4957           find first tmp#zakaz where
     4958                      tmp#zakaz.gds-code = ub.contract-specif.gds-code no-error .
     4959           if not  error-status :error  and not t-auto then do:
     4960               r-tmp = recid ( tmp#zakaz   ) .
     4961               run cus/ord-frmo.w
     4962                 ( input parParentProc ,
     4963                   input r-tmp  ,
     4964                   input r-ord  ,
     4965                   input line-mode,
     4966                   output r-stop ,
     4967                   output r-exit ) .
     4968               if r-stop then do:
     4969                 run p-delete ( r-tmp , input-output ii).
     4970                 leave.
     4971               end.
     4972               if r-exit then do:
     4973                  run p-delete( r-tmp ,input-output ii ) .
     4974               end.
     4975           end.
     4976      end.
     4977   end.
     4978   when 3 then do:
     4979      v-update-price = 0 .
     4980      for each tmp#zakaz :
     4981   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4982   ASSIGN
     4983      i-gl-Host-Code      = 0
     4984      i-gl-Contract-Code  = 0
     4985      i-gl-Extent3        = 0
     4986      .
     4987   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4988       INPUT  v-cntxt-host-code-obj,
     4989       INPUT  loc-contract,
     4990       OUTPUT i-gl-Extent3
     4991      ).
     4992   IF i-gl-Extent3[1] = 2 THEN DO:
     4993      ASSIGN
     4994         i-gl-Host-Code      = i-gl-Extent3[2]
     4995         i-gl-Contract-Code  = i-gl-Extent3[3]
     4996         .
     4997   END. ELSE DO:
     4998      ASSIGN
     4999         i-gl-Host-Code      = v-cntxt-host-code-obj
     5000         i-gl-Contract-Code  = loc-contract
     5001         .
     5002   END.
     5003       FIND FIRST ub.contract-specif
     5004              NO-LOCK
     5005              WHERE
     5006                  ub.contract-specif.Host-code    = i-gl-Host-Code
     5007              AND ub.contract-specif.Contract-num = i-gl-Contract-Code
     5008              AND ub.contract-specif.Gds-code     = tmp#zakaz.gds-code
     5009              NO-ERROR
     5010              .
     5011      if not available ub.contract-specif then next .
     5012        ii = ii + 1 .
     5013        run create-tmp-contr-sp in this-procedure  ( input recid(ub.contract-specif) , output r-tmp , output r-ord).
     5014      end.
     5015   end.
     5016   end case.
     5017   choice = ?.
     5018   run openbr in this-procedure  .
     5019   t-ret =  session:set-wait-state("") .
     5020   message
     5021   ( if v-choice = 3
     5022     then substitute("Исправлено  &1 из " ,v-update-price )
     5023     else  'Добавлено'  )
     5024     ii 'товаров'
     5025     view-as alert-box information
     5026     .
     5027     ii = 0.
     5028     v-update-price = 0 .
     5029   end.
     5030   END PROCEDURE.
     5031   PROCEDURE create-ord-doc :
     5032    do
     5033    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5034    :
     5035   define input parameter p-doc-code   like  ub.ord-doc.doc-code  no-undo .
     5036   define input parameter p-cli-code   like  ub.ord-doc.cli-code  no-undo .
     5037   define input parameter p-cli-type   like  ub.ord-doc.cli-type  no-undo .
     5038   define input parameter p-cli-name   like  ub.ord-doc.cli-name  no-undo .
     5039   define input parameter p-cons-code  like  ub.ord-doc.cons-code no-undo .
     5040   define input parameter p-host-code  like  ub.ord-doc.host-code no-undo .
     5041   define input parameter p-obj-code   like  ub.ord-doc.obj-code  no-undo .
     5042   define input parameter p-obj-type   like  ub.ord-doc.obj-type  no-undo .
     5043   define input parameter p-doc-type   like  ub.ord-doc.doc-type  no-undo .
     5044   define input parameter p-status_    like  ub.ord-doc.status_   no-undo .
     5045   define input parameter p-doc-date   like  ub.ord-doc.doc-date  no-undo .
     5046   define input parameter p-ship-date  like  ub.ord-doc.ship-date no-undo .
     5047   define input parameter p-order-type like  ub.ord-doc.order-type    no-undo .
     5048   define input parameter p-contract-code like  ub.ord-doc.contract-code    no-undo .
     5049   define output parameter p-recid as recid no-undo .
     5050   define variable v-i-doc as character no-undo .
     5051   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5052   run proc-ord-code in this-procedure
     5053    (input   'main' ,
     5054     input   v-cntxt-db-num ,
     5055     input   v-cntxt-obj-type ,
     5056     input   v-cntxt-obj-code ,
     5057     input   v-i-doc ,
     5058     output  loc-ord-num
     5059    ) .
     5060      create ub.ord-doc.
     5061      assign
     5062         ub.ord-doc.doc-code   = p-doc-code
     5063         ub.ord-doc.cli-code   = p-cli-code
     5064         ub.ord-doc.cli-type   = p-cli-type
     5065         ub.ord-doc.cli-name   = p-cli-name
     5066         ub.ord-doc.cons-code  = p-cons-code
     5067         ub.ord-doc.host-code  = p-host-code
     5068         ub.ord-doc.obj-code   = p-obj-code
     5069         ub.ord-doc.obj-type   = p-obj-type
     5070         ub.ord-doc.doc-type   = p-doc-type
     5071         ub.ord-doc.status_    = p-status_
     5072         ub.ord-doc.doc-date   = p-doc-date
     5073         ub.ord-doc.ship-date  = p-ship-date
     5074         ub.ord-doc.order-type = p-order-type
     5075         ub.ord-doc.contract-code = p-contract-code
     5076         p-recid = recid (ub.ord-doc)
     5077         .
     5078     end.
     5079   END PROCEDURE.
     5080   PROCEDURE create-tmp :
     5081    do
     5082    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5083    :
     5084   define input parameter tt     as char no-undo.
     5085   define input parameter t      as char no-undo.
     5086   define output parameter p-tmp as recid no-undo .
     5087   define output parameter p-ord as recid no-undo .
     5088   define variable prod-type#   like ub.ord-line.prod-type no-undo .
     5089   define variable prod-code#   like ub.ord-line.prod-code no-undo .
     5090   define variable artic#       like ub.ord-line.artic     no-undo .
     5091   define buffer ll-buf_ord-line for ub.ord-line .
     5092   define variable p-recid as recid no-undo .
     5093         find first ub.goods where
     5094               ub.goods.artic     = tt-gds-list.artic     and
     5095               ub.goods.prod-type = tt-gds-list.prod-type and
     5096               ub.goods.prod-code = tt-gds-list.prod-code no-lock no-error.
     5097               if error-status :error  then do:
     5098                   message vss-workfile vss-revision vss-description skip
     5099                   error-status :get-message(1)
     5100                   "Плохо ! tt-gds-list не = ub.goods !"
     5101                   1
     5102                   view-as alert-box error .
     5103               end.
     5104         find  first ub.gds-obj  where
     5105               ub.gds-obj.obj-type  = v-cntxt-obj-type and
     5106               ub.gds-obj.obj-code  = v-cntxt-obj-code and
     5107               ub.gds-obj.artic     = tt-gds-list.artic      and
     5108               ub.gds-obj.prod-type = tt-gds-list.prod-type  and
     5109               ub.gds-obj.prod-code = tt-gds-list.prod-code  no-lock no-error.
     5110   define buffer bufff-units for ub.units.
     5111   define variable t-type as character no-undo .
     5112   find first tmp#zakaz   where
     5113              tmp#zakaz.prod-type = ub.goods.prod-type and
     5114              tmp#zakaz.prod-code = ub.goods.prod-code and
     5115              tmp#zakaz.artic     = ub.goods.artic     no-error.
     5116    if not available tmp#zakaz  then  create tmp#zakaz .
     5117     assign
     5118       tmp#zakaz.doc-code      = loc-ord-num
     5119       tmp#zakaz.gds-code      = ub.goods.gds-code
     5120       tmp#zakaz.prod-type     = ub.goods.prod-type
     5121       tmp#zakaz.prod-code     = ub.goods.prod-code
     5122       tmp#zakaz.artic         = ub.goods.artic
     5123       tmp#zakaz.gds-name      = ub.goods.gds-name
     5124       tmp#zakaz.deadline      = ub.goods.deadline
     5125       tmp#zakaz.unit-cli      = ub.goods.unit-cli
     5126       tmp#zakaz.unit-base     = ub.goods.unit-base
     5127       tmp#zakaz.negative-rest = ub.goods.negative-rest
     5128       tmp#zakaz.cli-base-rate = 1
     5129       tmp#zakaz.cli-qnty = 1
     5130       tmp#zakaz.qnty = 1
     5131       tmp#zakaz.ms-cart       = ub.goods.qnty-cart
     5132       .
     5133       define variable max-num as integer no-undo .
     5134       max-num = 0.
     5135       for each  ll-buf_ord-line no-lock  where ll-buf_ord-line.doc-code = loc-ord-num :
     5136           if max-num < ll-buf_ord-line.line-num then
     5137              max-num = ll-buf_ord-line.line-num .
     5138       end.
     5139       tmp#zakaz.line-num = max-num + 1.
     5140   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5142     (input  ub.goods.gds-code
     5143     ,input  '1':U
     5144     ,input  ?
     5145     ,input  v-cntxt-host-code-obj
     5146     ,input  v-cntxt-obj-type
     5147     ,input  v-cntxt-obj-code
     5148     ,output tmp#zakaz.vat-pc
     5149     ) no-error .
     5150     .
     5151     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     5152     if available bufff-units then
     5153     assign
     5154       tmp#zakaz.unit-type       = bufff-units.type .
     5155     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     5156     if available bufff-units then
     5157     assign
     5158       tmp#zakaz.unit-cli-type       = bufff-units.type .
     5159   define variable v1-host-code as integer   no-undo .
     5160   define variable v1-obj-type as character no-undo .
     5161   define variable v1-obj-code as integer   no-undo .
     5162   if flag = false  then do:
     5163       if v-ord-askp then
     5164           message
     5165             substitute ( "Цена берется с объекта РЦ &1&2 ? " , loc-cli-type , loc-cli-code )
     5166             view-as alert-box question
     5167             buttons yes-no
     5168             update v-quest
     5169             .
     5170       else
     5171         v-quest = false .
     5172        flag = true .
     5173   end.
     5174   if v-quest then do:
     5175       find first ub.gds-obj no-lock    where
     5176           ub.gds-obj.obj-type   = loc-cli-type and
     5177           ub.gds-obj.obj-code   = loc-cli-code and
     5178           ub.gds-obj.prod-type  = ub.goods.prod-type and
     5179           ub.gds-obj.prod-code  = ub.goods.prod-code and
     5180           ub.gds-obj.artic      = ub.goods.artic
     5181           no-error.
     5182       if error-status :error then do:
     5183         message  substitute( "Неизвестна ИНФОРМАЦИЯ по товару &4 &1 по объекту &2&3 берем с текущего", ub.goods.gds-name, loc-cli-type, loc-cli-code , ub.goods.artic )   view-as alert-box information .
     5184         v1-obj-type = v-cntxt-obj-type.
     5185         v1-obj-code = v-cntxt-obj-code.
     5186       end.
     5187       ELSE DO:
     5188         v1-obj-type = loc-cli-type.
     5189         v1-obj-code = loc-cli-code.
     5190       END.
     5191   end.
     5192   else do:
     5193     v1-obj-type = v-cntxt-obj-type.
     5194     v1-obj-code = v-cntxt-obj-code.
     5195   end.
     5196   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5197   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5198     (input  v1-obj-type
     5199     ,input  v1-obj-code
     5200     ,output v1-host-code
     5201     )  .
     5202   find first ub.gds-obj no-lock    where
     5203       ub.gds-obj.obj-type        = v1-obj-type and
     5204       ub.gds-obj.obj-code        = v1-obj-code and
     5205       ub.gds-obj.prod-type       = ub.goods.prod-type and
     5206       ub.gds-obj.prod-code       = ub.goods.prod-code and
     5207       ub.gds-obj.artic           = ub.goods.artic
     5208       no-error.
     5209       if available ub.gds-obj then do:
     5210           define variable v-baz-val     as integer no-undo .
     5211           define variable v-base-rate   as decimal no-undo .
     5212           define variable v-base-scale  as decimal no-undo .
     5213           define variable p-r-b-abbr    as character no-undo .
     5214   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5215   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5216     (input  v1-host-code
     5217     ,output v-baz-val
     5218     )  .
     5219   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5221     (output p-r-b-abbr
     5222     )  .
     5223           if p-r-b-abbr = 'rubl':U then do:
     5224                 if v-baz-val = 0 then
     5225                     assign
     5226                       tmp#zakaz.price-base = ub.gds-obj.price-sale
     5227                       tmp#zakaz.price-rubl = ub.gds-obj.price-sale
     5228                       tmp#zakaz.price-cli  = ub.gds-obj.price-sale
     5229                     .
     5230                   else do:
     5231   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5233     (input  v1-host-code
     5234     ,input  today
     5235     ,output v-base-rate
     5236     ,output v-base-scale
     5237     )  .
     5238                     assign
     5239                       tmp#zakaz.price-rubl = ub.gds-obj.price-sale
     5240                       tmp#zakaz.price-base = tmp#zakaz.price-rubl /( v-base-rate * v-base-scale )
     5241                       tmp#zakaz.price-cli  = tmp#zakaz.price-rubl
     5242                     .
     5243                   end.
     5244             end.
     5245             else do:
     5246   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5248     (input  v1-host-code
     5249     ,input  today
     5250     ,output v-base-rate
     5251     ,output v-base-scale
     5252     )  .
     5253                     assign
     5254                       tmp#zakaz.price-base = ub.gds-obj.price-sale
     5255                       tmp#zakaz.price-rubl = tmp#zakaz.price-base * ( v-base-rate / v-base-scale )
     5256                       tmp#zakaz.price-cli  = tmp#zakaz.price-base
     5257                     .
     5258             end.
     5259      end.
     5260      else do:
     5261      assign
     5262        tmp#zakaz.price-base = 0
     5263        tmp#zakaz.price-rubl = 0
     5264        tmp#zakaz.price-cli  = 0
     5265      .
     5266      end.
     5267   find first shar_ord-line   exclusive-lock   where
     5268             shar_ord-line.doc-code        = loc-ord-num    and
     5269             shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     5270             shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     5271             shar_ord-line.artic           = tmp#zakaz.artic     no-error.
     5272    if not available shar_ord-line  then
     5273          create shar_ord-line  .
     5274    buffer-copy tmp#zakaz to shar_ord-line
     5275          assign shar_ord-line.doc-code    = loc-ord-num
     5276     .
     5277     p-tmp = recid ( tmp#zakaz   ) .
     5278     p-ord = recid ( shar_ord-line  ) .
     5279     end.
     5280   END PROCEDURE.
     5281   PROCEDURE disable_UI :
     5282     HIDE FRAME Dialog-Frame.
     5283   END PROCEDURE.
     5284   PROCEDURE enable_UI :
     5285     DISPLAY scr-cli scr-wrkr scr-ship-date scr-pay-day scr-agnt scr-boss
     5286             scr-e-method t-auto scr-obj-name scr-cli-name scr-contract
     5287             scr-wrkr-name scr-agnt-name scr-boss-name scr-sum-qnty
     5288         WITH FRAME Dialog-Frame.
     5289     ENABLE b-exit b-quit B-delivery B-help B-spec r-cli B-contract scr-wrkr
     5290            scr-ship-date r-wrkr scr-pay-day scr-agnt r-agnt scr-boss r-boss
     5291            scr-e-method b-add B-chg B-del B-calc b-renum t-auto BROWSE-2
     5292            scr-obj-name scr-cli-name scr-contract scr-wrkr-name scr-agnt-name
     5293            scr-boss-name scr-sum-qnty
     5294         WITH FRAME Dialog-Frame.
     5295     VIEW FRAME Dialog-Frame.
     5296     OPEN QUERY BROWSE-2 FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     5297   END PROCEDURE.
     5298   PROCEDURE init-gds-rec :
     5299    do
     5300    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5301    :
     5302     find current x_goods no-lock no-error .
     5303     gds-rec = recid(x_goods) .
     5304     end.
     5305   END PROCEDURE.
     5306   PROCEDURE init-proc :
     5307    do
     5308    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5309    :
     5310   define buffer buf_2clients for ub.clients  .
     5311    find first buf_2clients no-lock where
     5312               buf_2clients.obj-code = buf_ord-doc.cli-code and
     5313               buf_2clients.obj-type = buf_ord-doc.cli-type
     5314               no-error .
     5315    find first buf_clients no-lock where
     5316               buf_clients.obj-code = buf_ord-doc.obj-code and
     5317               buf_clients.obj-type = buf_ord-doc.obj-type
     5318               no-error .
     5319               if error-status :error then do:
     5320               message vss-workfile vss-revision vss-description skip
     5321                      "Ошибка  " skip
     5322                       skip
     5323                       error-status :get-message(1) skip
     5324                       return-value skip
     5325                       view-as alert-box error
     5326               .
     5327               return error .
     5328               end.
     5329    assign
     5330     loc-contract     = buf_ord-doc.contract-code
     5331     v-deliv-type-code     =  buf_ord-doc.deliv-type-code
     5332     v-point-obj-code      =  buf_ord-doc.obj-point-code
     5333     v-point-cli-code      =  buf_ord-doc.cli-point-code
     5334     v-point-obj-db-num    =  buf_ord-doc.obj-point-db-num
     5335     v-point-cli-db-num    =  buf_ord-doc.cli-point-db-num
     5336     v-transport-host-code =  buf_ord-doc.transport-host-code
     5337     v-transport-cli-type  =  buf_ord-doc.transport-cli-type
     5338     v-transport-cli-code  =  buf_ord-doc.transport-cli-code
     5339     v-transport-contract  =  buf_ord-doc.transport-contract
     5340     v-transport-condition =  buf_ord-doc.transport-condition
     5341     v-transport-value     =  buf_ord-doc.transport-value
     5342     v-transport-sum       =  buf_ord-doc.sum-ship
     5343     v-transport-vat       =  buf_ord-doc.transport-vat
     5344     scr-contract     = if loc-contract = 0 then "" else  "Вн.№ дог. " + string(buf_ord-doc.contract-code)
     5345     scr-ship-date    = buf_ord-doc.ship-date
     5346     scr-pay-day      = buf_ord-doc.pay-day
     5347     pay-day          = buf_ord-doc.pay-day
     5348     loc-date-ship    = scr-ship-date
     5349     scr-e-method     = buf_ord-doc.e-method
     5350     e-method         = buf_ord-doc.e-method
     5351     loc-obj-code     = buf_ord-doc.obj-code
     5352     loc-obj-type     = buf_ord-doc.obj-type
     5353     loc-cli-code     = buf_ord-doc.cli-code
     5354     loc-cli-type     = buf_ord-doc.cli-type
     5355     loc-doc-type     = buf_ord-doc.doc-type
     5356     scr-obj-name     = buf_clients.obj-name
     5357     loc-ord-num      = buf_ord-doc.doc-code
     5358     scr-wrkr         = buf_ord-doc.wrkr
     5359     scr-boss         = buf_ord-doc.boss
     5360     scr-agnt         = buf_ord-doc.agnt
     5361     scr-cli          = buf_ord-doc.cli-code
     5362     scr-cli-name     = if available buf_2clients then buf_2clients.obj-name else ""
     5363    .
     5364    run leave-proc-wrkr in this-procedure .
     5365    run leave-proc-boss in this-procedure .
     5366    run leave-proc-agnt in this-procedure .
     5367        ASSIGN frame Dialog-Frame:TITLE = "Заказ  № " + loc-ord-num
     5368      + " Тип: " +     buf_ord-doc.doc-type
     5369      + " Статус: "  +  buf_ord-doc.status_
     5370      + " - " + caps(p-mode).
     5371   assign
     5372     scr-agnt:label in frame Dialog-Frame    = "И&сп"
     5373     scr-agnt:tooltip in frame Dialog-Frame  = "Код исполнителя"
     5374     scr-wrkr:label in frame Dialog-Frame    = "К&л-к"
     5375     scr-wrkr:tooltip in frame Dialog-Frame  = "Код кладовщика"
     5376     scr-boss:label in frame Dialog-Frame    = "&М-р"
     5377     scr-boss:tooltip in frame Dialog-Frame  = "Код менеджера"
     5378     .
     5379     end.
     5380   END PROCEDURE.
     5381   PROCEDURE my-enable-lkp :
     5382    do
     5383    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5384    :
     5385     run init-proc in this-procedure .
     5386     X_ord-line.qnty:read-only in browse BROWSE-2  = true .
     5387     DISPLAY scr-ship-date scr-obj-name
     5388             scr-e-method scr-sum-qnty
     5389             scr-cli-name
     5390             scr-cli
     5391             scr-pay-day
     5392             scr-contract
     5393         WITH FRAME Dialog-Frame.
     5394     ENABLE b-exit b-next b-prev B-delivery b-contract B-help BROWSE-2 scr-e-method
     5395          b-spec
     5396          WITH FRAME Dialog-Frame.
     5397       VIEW FRAME Dialog-Frame.
     5398         hide  b-quit in FRAME Dialog-Frame.
     5399         b-exit:label = "&Выход" .
     5400     run openbr in this-procedure .
     5401     end.
     5402   END PROCEDURE.
     5403   PROCEDURE my-enable_UI :
     5404    do
     5405    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5406    :
     5407     run init-proc in this-procedure .
     5408     display scr-ship-date scr-obj-name
     5409             scr-e-method
     5410             scr-sum-qnty
     5411             scr-wrkr-name
     5412             scr-agnt-name
     5413             scr-boss-name
     5414             scr-cli-name
     5415             t-auto
     5416             scr-cli
     5417             scr-pay-day
     5418             scr-contract
     5419             with frame dialog-frame.
     5420     enable b-exit b-quit b-help
     5421         B-delivery b-contract
     5422            b-spec
     5423            scr-ship-date b-add b-chg b-del
     5424            b-calc browse-2 b-renum t-auto
     5425            scr-e-method
     5426            scr-wrkr r-wrkr
     5427            scr-agnt r-agnt
     5428            scr-boss r-boss
     5429            r-cli
     5430            scr-pay-day
     5431            b-spec-gds
     5432            with frame dialog-frame.
     5433     view frame dialog-frame.
     5434     run openbr in this-procedure .
     5435     end.
     5436   END PROCEDURE.
     5437   PROCEDURE next-focus :
     5438   do
     5439   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5440   :
     5441   define input parameter p-widget-handle as handle no-undo .
     5442   define variable l-apply-entry as logical no-undo .
     5443   assign
     5444     l-apply-entry =   true
     5445   .
     5446   do with frame Dialog-Frame :
     5447     if scr-ship-date :handle = p-widget-handle then do:  if  scr-wrkr  :sensitive then do: apply "entry":u to scr-wrkr       . return . end. end.
     5448     if scr-wrkr      :handle = p-widget-handle then do:  if  scr-agnt  :sensitive then do: apply "entry":u to scr-agnt       . return . end. end.
     5449     if scr-agnt      :handle = p-widget-handle then do:  if  scr-boss  :sensitive then do: apply "entry":u to scr-boss       . return . end. end.
     5450     if scr-boss      :handle = p-widget-handle then do:  if  b-add     :sensitive then do: apply "entry":u to b-add          . return . end. end.
     5451     if b-add         :handle = p-widget-handle then do:  if  B-exit    :sensitive then do: apply "entry":u to B-exit    .      return . end. end.
     5452     end.
     5453     end.
     5454   END PROCEDURE.
     5455   PROCEDURE openbr :
     5456    do
     5457    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5458    :
     5459   case sort-column-name :
     5460     when "X_ord-line.line-num" then do:
     5461           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.line-num .
     5462     end.
     5463     when "X_goods.gds-code" then do:
     5464           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.gds-code .
     5465     end.
     5466     when "X_ord-line.artic" then do:
     5467           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.artic .
     5468     end.
     5469     when "X_goods.gds-name" then do:
     5470           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.gds-name .
     5471     end.
     5472     when "X_ord-line.qnty" then do:
     5473           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.qnty .
     5474     end.
     5475     when "X_goods.unit-base" then do:
     5476           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.unit-base .
     5477     end.
     5478     when "( if X_ord-line.temp-rash <> 0 then X_ord-line.order-qnty / X_ord-line.temp-rash  else 0 )" then do:
     5479           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by ( if X_ord-line.temp-rash <> 0 then X_ord-line.order-qnty / X_ord-line.temp-rash  else 0 ) .
     5480     end.
     5481     when "v-rc-qnty" then do:
     5482           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by v-rc-qnty .
     5483     end.
     5484     when "(chr(int(X_ord-line.add-cli-qnty)) + string(X_ord-line.add-qnty))" then do:
     5485           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by (chr(int(X_ord-line.add-cli-qnty)) + string(X_ord-line.add-qnty)) .
     5486     end.
     5487     when "(chr(int(X_ord-line.cancel-cli-qnty)) + string(X_ord-line.cancel-qnty))" then do:
     5488           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by (chr(int(X_ord-line.cancel-cli-qnty)) + string(X_ord-line.cancel-qnty)) .
     5489     end.
     5490     when "X_ord-line.temp-rash" then do:
     5491           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.temp-rash .
     5492     end.
     5493     when "v-rc-qnty-free" then do:
     5494           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by v-rc-qnty-free .
     5495     end.
     5496     when "X_ord-line.qnty-stk" then do:
     5497           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.qnty-stk .
     5498     end.
     5499     when "( if X_ord-line.temp-rash <> 0 then X_ord-line.qnty-stk / X_ord-line.temp-rash  else 0 )" then do:
     5500           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by ( if X_ord-line.temp-rash <> 0 then X_ord-line.qnty-stk / X_ord-line.temp-rash  else 0 ) .
     5501     end.
     5502     when "X_ord-line.initial-qnty" then do:
     5503           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.initial-qnty .
     5504     end.
     5505     when "X_ord-line.order-qnty" then do:
     5506           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.order-qnty .
     5507     end.
     5508   otherwise do:
     5509     OPEN QUERY BROWSE-2 FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     5510   end.
     5511   end case.
     5512     end.
     5513   END PROCEDURE.
     5514   PROCEDURE p-cont :
     5515   define variable o-host-code as integer   no-undo .
     5516   define variable c-host-code as integer   no-undo .
     5517   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5519     (input  loc-obj-type
     5520     ,input  loc-obj-code
     5521     ,output o-host-code
     5522     )  .
     5523   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5525     (input  loc-cli-type
     5526     ,input  loc-cli-code
     5527     ,output c-host-code
     5528     )  .
     5529      if o-host-code <> c-host-code  then do:
     5530       run check-contract-code in this-procedure
     5531        (input  "choose":u,
     5532         input  o-host-code,
     5533         input  'орг':U,
     5534         input  c-host-code,
     5535         input  ?,
     5536         input  parparentproc,
     5537         input  doc-date ,
     5538         input  'при':U ,
     5539         output loc-contract) no-error.
     5540         if error-status :error then
     5541             message
     5542               vss-workfile vss-revision vss-description skip
     5543               error-status :get-message(1) skip
     5544               return-value skip
     5545               "Ошибка проверки договора"
     5546               view-as alert-box error
     5547             .
     5548      end.
     5549      else do:
     5550        loc-contract = 0 .
     5551      end.
     5552     scr-contract = "".
     5553     if loc-contract <> 0 then do:
     5554        find first buf_contract no-lock where
     5555                   buf_contract.contract-code = loc-contract and
     5556                   buf_contract.host-code = o-host-code  no-error .
     5557        if error-status :error then message
     5558          vss-workfile vss-revision vss-description skip
     5559          error-status :get-message(1) skip
     5560          return-value skip
     5561          "не найден договор" skip
     5562          "№договора "  loc-contract        skip
     5563          "фирма " o-host-code         skip
     5564          view-as alert-box error
     5565        .
     5566        scr-contract = "Вн.№ дог. " + string(loc-contract).
     5567        assign
     5568           v-transport-cli-code     =  buf_contract.transport-cli-code
     5569           v-transport-cli-type     =  buf_contract.transport-cli-type
     5570           v-transport-host-code    =  buf_contract.transport-host
     5571           v-transport-contract     =  buf_contract.transport-contract
     5572           v-transport-condition    =  buf_contract.transport-uslov
     5573           v-transport-value        =  buf_contract.transport-value
     5574           .
     5575     end.
     5576     display scr-contract with frame Dialog-Frame .
     5577   END PROCEDURE.
     5578   PROCEDURE p-delete :
     5579    do
     5580    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5581    :
     5582   define input parameter tmp-recid as recid no-undo .
     5583   define input-output parameter ii as integer no-undo . .
     5584       find first tmp#zakaz where recid(tmp#zakaz) = tmp-recid no-error .
     5585       if not avail tmp#zakaz then return error.
     5586       find first shar_ord-line  exclusive-lock    where
     5587           shar_ord-line.doc-code        = loc-ord-num    and
     5588           shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     5589           shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     5590           shar_ord-line.artic           = tmp#zakaz.artic     no-error.
     5591       if not available shar_ord-line  then  return error .
     5592       delete shar_ord-line .
     5593       delete tmp#zakaz .
     5594       ii = ii - 1 .
     5595     end.
     5596   END PROCEDURE.
     5597   PROCEDURE proc-b-add :
     5598    do
     5599    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5600    :
     5601   define variable ii as int init 0 no-undo.
     5602   define variable r-tmp as recid no-undo .
     5603   define variable r-ord as recid no-undo .
     5604   define variable r-stop as logical no-undo .
     5605   define variable r-exit as logical no-undo .
     5606   define variable l-g#type as character no-undo .
     5607   define variable l-g#status as character no-undo .
     5608   define variable t-ret as logical no-undo .
     5609   define variable varschartic       like ub.price-list.artic initial " " no-undo.
     5610   define variable v-ref-list  as char                     no-undo.
     5611   define buffer buf_ord-line for ub.ord-line  .
     5612       run str/chsgdsls.w
     5613          (
     5614           input parparentproc,
     5615           input "order" + 'ОР':U ,
     5616           input "Строка документа № " + loc-ord-num ,
     5617           input ? ,
     5618           input ? ,
     5619           input v-cntxt-host-code-obj,
     5620           input-output varschartic,
     5621           output v-ref-list,
     5622           output table tt-gds-list ,
     5623           input false) no-error.
     5624       if error-status :error then do:
     5625       message vss-workfile vss-revision vss-description skip
     5626              "Ошибка procedure chsgdsls.w " skip
     5627               skip
     5628               error-status :get-message(1) skip
     5629               return-value skip
     5630               view-as alert-box error
     5631       .
     5632       return error  .
     5633       end.
     5634      t-ret =  session:set-wait-state("general") .
     5635      line-mode = 'ДОБАВЛЕНИЕ':U .
     5636      for each tt-gds-list no-lock :
     5637        ii = ii + 1 .
     5638        if ii > 1 then assign line-mode = "ЦИКЛ":u.
     5639       find first  buf_ord-line  exclusive-lock      where
     5640                   buf_ord-line.gds-code = tt-gds-list.gds-code  and
     5641                   buf_ord-line.doc-code = loc-ord-num
     5642                   no-error .
     5643             if available buf_ord-line then do:
     5644                 run cus/ord-frmp.w
     5645                    (input parParentProc ,
     5646                     input ?  ,
     5647                     input recid ( buf_ord-line)  ,
     5648                     input 'ИЗМЕНЕНИЕ':U,
     5649                     output r-stop ,
     5650                     output r-exit )
     5651                     no-error .
     5652             end.
     5653             else do:
     5654                 run create-tmp in this-procedure  (input "tt-gds-list":u, "" , output r-tmp , output r-ord).
     5655                 if not t-auto then do:
     5656                       run cus/ord-frmo.w
     5657                         ( input parParentProc ,
     5658                           input r-tmp  ,
     5659                           input r-ord  ,
     5660                           input line-mode,
     5661                           output r-stop ,
     5662                           output r-exit ) .
     5663                         if r-stop then do:
     5664                             run p-delete in this-procedure
     5665                               ( r-tmp , input-output ii).
     5666                             leave.
     5667                             end.
     5668                         if r-exit then do:
     5669                             run p-delete in this-procedure
     5670                                 ( r-tmp , input-output ii ) .
     5671                             end.
     5672                 end.
     5673             end.
     5674      end.
     5675     run openbr in this-procedure .
     5676     t-ret =  session:set-wait-state("") .
     5677     message "Добавлено " + string(ii) + " товаров".
     5678     end.
     5679   END PROCEDURE.
     5680   PROCEDURE proc-renum :
     5681    do
     5682    on error undo, return error return-value
     5683    :
     5684   define variable g-ok as logical no-undo .
     5685   define variable g as integer no-undo .
     5686   define buffer buf_ord-line for ub.ord-line.
     5687    message " Перенумеровать список товаров ? "
     5688       view-as alert-box question
     5689       buttons yes-no
     5690       UPDATE g-ok
     5691       .
     5692       if g-ok = false then return.
     5693       g = 0 .
     5694       for each buf_ord-line  exclusive-lock  where buf_ord-line.doc-code = loc-ord-num  by buf_ord-line.line-num :
     5695           g = g + 1.
     5696           buf_ord-line.line-num = g.
     5697       end.
     5698       run openbr in this-procedure .
     5699    end.
     5700   END PROCEDURE.
     5701   PROCEDURE recalc-head :
     5702    do
     5703    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5704    :
     5705   define buffer buf_ord-line for ub.ord-line.
     5706   define variable s-1 as decimal init 0 no-undo .
     5707   define variable s-2 as decimal init 0 no-undo .
     5708   define variable s-0 as decimal init 0 no-undo .
     5709        assign frame Dialog-Frame
     5710        scr-ship-date
     5711        scr-e-method
     5712   .
     5713   for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     5714       s-1  = s-1  + buf_ord-line.sum-rubl .
     5715       s-2  = s-2  + buf_ord-line.sum-base .
     5716       s-0  = s-0  + buf_ord-line.qnty     .
     5717   end.
     5718   assign
     5719     scr-sum-qnty = s-0
     5720     scr-sum-rubl = s-1
     5721     scr-sum-base = s-2
     5722   .
     5723   display
     5724    scr-sum-qnty
     5725    with frame Dialog-Frame .
     5726     end.
     5727   END PROCEDURE.
     5728   PROCEDURE step-next :
     5729    do
     5730    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5731    :
     5732     if valid-handle (br-handle) then do:
     5733     g#log = br-handle:select-next-row () no-error .
     5734     if error-status :error then do:
     5735        message "Это режим просмотра одного документа." .
     5736        g#log = false .
     5737        end.
     5738     if not g#log then message "Это последний документ списка.".
     5739   end.
     5740       p-ord-doc-recid = recid ( buf-or_ord-doc ).
     5741       next-prev = yes.
     5742     end.
     5743   END PROCEDURE.
     5744   PROCEDURE step-prev :
     5745    do
     5746    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5747    :
     5748     if valid-handle (br-handle) then do:
     5749     g#log = br-handle:select-prev-row() no-error .
     5750     if error-status :error then do:
     5751        message "Это режим просмотра одного документа." .
     5752        g#log = false .
     5753     end.
     5754     if not g#log then do: message "Это первый документ списка.".   end.
     5755   end.
     5756   p-ord-doc-recid = recid (buf-or_ord-doc).
     5757   next-prev = yes .
     5758     end.
     5759   END PROCEDURE.
     5760   PROCEDURE x-delete :
     5761    do
     5762    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5763    :
     5764   define input parameter p-recid as recid no-undo .
     5765   define input-output parameter ii as integer no-undo . .
     5766       find first shar_ord-line  exclusive-lock  where recid(shar_ord-line) = p-recid  .
     5767       if not available shar_ord-line  then  return error .
     5768       find first tmp#zakaz   where
     5769                   tmp#zakaz.prod-type = shar_ord-line.prod-type         and
     5770                   tmp#zakaz.prod-code = shar_ord-line.prod-code         and
     5771                   tmp#zakaz.artic     = shar_ord-line.artic             no-error.
     5772       if  avail tmp#zakaz then delete tmp#zakaz .
     5773       delete shar_ord-line .
     5774       ii = ii - 1 .
     5775     end.
     5776   END PROCEDURE.
     5777   FUNCTION f-zapr-qnty RETURNS decimal
     5778     ( buffer buf_ord-line for ub.ord-line , par-type as char ) :
     5779   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv .
     5780   define buffer buf_ord-line-rcv for ub.ord-line-rcv .
     5781   define buffer buf_doc-line          for ub.doc-line .
     5782   define buffer buf_trn-doc           for ub.trn-doc  .
     5783   define variable  res as decimal no-undo init 0 .
     5784   for each buf_ord-line-rcv no-lock
     5785       where buf_ord-line-rcv.doc-code  = buf_ord-line.doc-code  and
     5786             buf_ord-line-rcv.artic     = buf_ord-line.artic     and
     5787             buf_ord-line-rcv.prod-type = buf_ord-line.prod-type and
     5788             buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     5789             on error undo, return error :
     5790             find first buf_ord-doc-rcv no-lock where
     5791                       buf_ord-doc-rcv.rcv-code  = buf_ord-line-rcv.rcv-code  and
     5792                       buf_ord-doc-rcv.doc-code  = buf_ord-line-rcv.doc-code  no-error .
     5793                       if error-status :error then next .
     5794      for each ub.ord-chain no-lock where
     5795               ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     5796               ub.ord-chain.doc-type = 'rcv'                  and
     5797               ub.ord-chain.rel-doc-type = 'trn'
     5798               :
     5799             find first buf_trn-doc no-lock  where
     5800                        buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code and
     5801                        buf_trn-doc.doc-type = par-type
     5802                                 no-error .
     5803             if not available buf_trn-doc then next .
     5804             if buf_trn-doc.doc-type = 'при':U then
     5805                if buf_trn-doc.status_ <>  'запрос':U then next.
     5806             find first buf_doc-line no-lock where
     5807                        buf_doc-line.doc-code  = buf_trn-doc.doc-code  and
     5808                        buf_doc-line.artic     = buf_ord-line.artic     and
     5809                        buf_doc-line.prod-type = buf_ord-line.prod-type and
     5810                        buf_doc-line.prod-code = buf_ord-line.prod-code  no-error .
     5811                        if error-status :error then next .
     5812             res  = res  + buf_doc-line.fact-qnty .
     5813            end.
     5814   end.
     5815     RETURN res .
     5816   END FUNCTION.
     5817   PROCEDURE create-tmp-contr-sp :
     5818   define input  parameter p-recid as recid no-undo .
     5819   define output parameter p-tmp as recid no-undo .
     5820   define output parameter p-ord as recid no-undo .
     5821   define buffer buf_contract-specif for ub.contract-specif  .
     5822   define variable prod-type#   like ub.ord-line.prod-type no-undo .
     5823   define variable prod-code#   like ub.ord-line.prod-code no-undo .
     5824   define variable artic#       like ub.ord-line.artic     no-undo .
     5825   define variable v-base-rate   as decimal no-undo .
     5826   define variable v-base-scale  as decimal no-undo .
     5827   define buffer ll-buf_ord-line for ub.ord-line .
     5828    do
     5829    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5830    :
     5831    find first buf_contract-specif no-lock where
     5832               recid(buf_contract-specif)  = p-recid no-error .
     5833               if error-status :error then return error return-value .
     5834   find first ub.goods where
     5835         ub.goods.gds-code  = buf_contract-specif.gds-code
     5836         no-lock no-error.
     5837         if error-status :error  then return error return-value .
     5838   define buffer bufff-units for ub.units.
     5839   define variable t-type as character no-undo .
     5840   find first tmp#zakaz   where
     5841              tmp#zakaz.prod-type = ub.goods.prod-type and
     5842              tmp#zakaz.prod-code = ub.goods.prod-code and
     5843              tmp#zakaz.artic     = ub.goods.artic     no-error.
     5844    if not available tmp#zakaz  then  create tmp#zakaz .
     5845   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5846   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5847     (input  v-cntxt-host-code-obj
     5848     ,input  today
     5849     ,output v-base-rate
     5850     ,output v-base-scale
     5851     )  .
     5852     assign
     5853       tmp#zakaz.doc-code      = loc-ord-num
     5854       tmp#zakaz.gds-code      = ub.goods.gds-code
     5855       tmp#zakaz.prod-type     = ub.goods.prod-type
     5856       tmp#zakaz.prod-code     = ub.goods.prod-code
     5857       tmp#zakaz.artic         = ub.goods.artic
     5858       tmp#zakaz.gds-name      = ub.goods.gds-name
     5859       tmp#zakaz.deadline      = ub.goods.deadline
     5860       tmp#zakaz.unit-cli      = buf_contract-specif.unit-base
     5861       tmp#zakaz.unit-base     = ub.goods.unit-base
     5862       tmp#zakaz.negative-rest = ub.goods.negative-rest
     5863       tmp#zakaz.cli-base-rate = ( if buf_contract-specif.cli-base-rate = 0 or buf_contract-specif.cli-base-rate = ? then 1 else buf_contract-specif.cli-base-rate)
     5864       tmp#zakaz.ms-cart       = ub.goods.qnty-cart
     5865       tmp#zakaz.vat-pc        = buf_contract-specif.vat-pc
     5866       tmp#zakaz.price-cli     = buf_contract-specif.price-cli
     5867       tmp#zakaz.price-rubl    = buf_contract-specif.price-cli / tmp#zakaz.cli-base-rate
     5868       tmp#zakaz.price-base    = tmp#zakaz.price-rubl * v-base-rate / v-base-scale
     5869       tmp#zakaz.cli-qnty      = ( if buf_contract-specif.qnty = 0 or buf_contract-specif.qnty = ? then 1 else buf_contract-specif.qnty)
     5870       tmp#zakaz.qnty          = tmp#zakaz.cli-qnty * tmp#zakaz.cli-base-rate
     5871       .
     5872       define variable max-num as integer no-undo .
     5873       max-num = 0.
     5874       for each  ll-buf_ord-line no-lock  where ll-buf_ord-line.doc-code = loc-ord-num :
     5875           if max-num < ll-buf_ord-line.line-num then
     5876              max-num = ll-buf_ord-line.line-num .
     5877       end.
     5878       tmp#zakaz.line-num = max-num + 1.
     5879     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     5880     if available bufff-units then
     5881     assign
     5882       tmp#zakaz.unit-type       = bufff-units.type .
     5883     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     5884     if available bufff-units then
     5885     assign
     5886       tmp#zakaz.unit-cli-type       = bufff-units.type .
     5887   find first shar_ord-line   exclusive-lock   where
     5888             shar_ord-line.doc-code        = loc-ord-num    and
     5889             shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     5890             shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     5891             shar_ord-line.artic           = tmp#zakaz.artic     no-error.
     5892    if not available shar_ord-line  then
     5893          create shar_ord-line  .
     5894    buffer-copy tmp#zakaz to shar_ord-line
     5895          assign shar_ord-line.doc-code    = loc-ord-num
     5896     .
     5897     p-tmp = recid ( tmp#zakaz   ) .
     5898     p-ord = recid ( shar_ord-line  ) .
     5899     end.
     5900   END PROCEDURE.
