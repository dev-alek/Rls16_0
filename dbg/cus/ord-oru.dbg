     2686   ON VALUE-CHANGED OF t-auto IN FRAME Dialog-Frame
     2687   DO:
     2688     assign   frame Dialog-Frame t-auto.
     2689   END.
     2690   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2691   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2692   assign
     2693     scr-sum-rubl :label = "Итого сумма (руб)"
     2694   .
     2695   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2696   do:
     2697     BROWSE-2 :SET-REPOSITIONED-ROW(8, "CONDITIONAL") .
     2698   end.
     2699   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2700   on ' ' of scr-ship-date in frame Dialog-Frame
     2701   do:
     2702     if (can-query (self, "sensitive")
     2703        and
     2704        self :sensitive = true
     2705        )
     2706     or (can-query (self, "read-only")
     2707        and
     2708        self :read-only = false
     2709        )
     2710     then do:
     2711       assign
     2712         self :screen-value = ?
     2713       .
     2714     end.
     2715     return no-apply.
     2716   end.
     2717   on delete-character of scr-ship-date in frame Dialog-Frame
     2718   do:
     2719     if (can-query (self, "sensitive")
     2720        and
     2721        self :sensitive = true
     2722        )
     2723     or (can-query (self, "read-only")
     2724        and
     2725        self :read-only = false
     2726        )
     2727     then do:
     2728       assign
     2729         self :screen-value = ?
     2730       .
     2731     end.
     2732     return no-apply.
     2733   end.
     2734   on ctrl-d of scr-ship-date in frame Dialog-Frame
     2735   do:
     2736     define variable v-curr-sv-date as date no-undo .
     2737     if (can-query (self, "sensitive")
     2738        and
     2739        self :sensitive = true
     2740        )
     2741     or (can-query (self, "read-only")
     2742        and
     2743        self :read-only = false
     2744        )
     2745     then do:
     2746       if self :handle <> focus :handle
     2747       then do:
     2748         apply "entry":u to self .
     2749       end.
     2750       run gbl/getcurdt.p
     2751         (output v-curr-sv-date
     2752         ) .
     2753       assign
     2754         self :screen-value = string(v-curr-sv-date) .
     2755       .
     2756     end.
     2757     return no-apply.
     2758   end.
     2759   on ctrl-b of scr-ship-date in frame Dialog-Frame
     2760   do:
     2761     if (can-query (self, "sensitive")
     2762        and
     2763        self :sensitive = true
     2764        )
     2765     or (can-query (self, "read-only")
     2766        and
     2767        self :read-only = false
     2768        )
     2769     then do:
     2770       if self :handle <> focus :handle
     2771       then do:
     2772         apply "entry":u to self .
     2773       end.
     2774       define variable v-curr-sv-date as date no-undo .
     2775       define variable v-new-sv-date  as date no-undo .
     2776       assign
     2777         v-curr-sv-date = date(self :screen-value) no-error
     2778       .
     2779       if v-curr-sv-date = ?
     2780       then do:
     2781         run gbl/getcurdt.p
     2782           (output v-curr-sv-date
     2783           ) .
     2784       end.
     2785       if v-curr-sv-date <> ?
     2786       then do:
     2787         assign
     2788           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2789         .
     2790         assign
     2791           self :screen-value = string(v-new-sv-date) .
     2792         .
     2793       end.
     2794     end.
     2795     return no-apply .
     2796   end.
     2797   on ctrl-e of scr-ship-date in frame Dialog-Frame
     2798   do:
     2799     if (can-query (self, "sensitive")
     2800        and
     2801        self :sensitive = true
     2802        )
     2803     or (can-query (self, "read-only")
     2804        and
     2805        self :read-only = false
     2806        )
     2807     then do:
     2808       if self :handle <> focus :handle
     2809       then do:
     2810         apply "entry":u to self .
     2811       end.
     2812       define variable v-curr-sv-date as date no-undo .
     2813       define variable v-new-sv-date  as date no-undo .
     2814       assign
     2815         v-curr-sv-date = date(self :screen-value) no-error
     2816       .
     2817       if v-curr-sv-date = ?
     2818       then do:
     2819         run gbl/getcurdt.p
     2820           (output v-curr-sv-date
     2821           ) .
     2822       end.
     2823       if v-curr-sv-date <> ?
     2824       then do:
     2825         run gbl/lastdate.p
     2826           (input  v-curr-sv-date
     2827           ,output v-new-sv-date
     2828           ).
     2829         assign
     2830           self :screen-value = string(v-new-sv-date) .
     2831         .
     2832       end.
     2833     end.
     2834     return no-apply .
     2835   end.
     2836   on ctrl-f of scr-ship-date in frame Dialog-Frame
     2837   do:
     2838     if (can-query (self, "sensitive")
     2839        and
     2840        self :sensitive = true
     2841        )
     2842     or (can-query (self, "read-only")
     2843        and
     2844        self :read-only = false
     2845        )
     2846     then do:
     2847       if self :handle <> focus :handle
     2848       then do:
     2849         apply "entry":u to self .
     2850       end.
     2851       define variable v-ok            as logical   no-undo .
     2852       define variable v-curr-sv-date  as date      no-undo .
     2853       define variable v-description   as character no-undo .
     2854       assign
     2855         v-curr-sv-date = date(self :screen-value) no-error
     2856       .
     2857       if v-curr-sv-date = ?
     2858       then do:
     2859         run gbl/getcurdt.p
     2860           (output v-curr-sv-date
     2861           ) .
     2862       end.
     2863       if v-curr-sv-date <> ?
     2864       then do:
     2865         run gbl/d-inpday.w
     2866           (input ?
     2867           ,input "Выбор даты"
     2868           ,input v-description
     2869           ,input ""
     2870           ,input-output v-curr-sv-date
     2871           ,output v-ok
     2872           ).
     2873         if v-ok = true
     2874         then do:
     2875           assign
     2876             self :screen-value = string(v-curr-sv-date) .
     2877           .
     2878         end.
     2879       end.
     2880     end.
     2881     return no-apply .
     2882   end.
     2883     define MENU m-ed-date26
     2884       MENU-ITEM m-ed-date26-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2885       MENU-ITEM m-ed-date26-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2886       MENU-ITEM m-ed-date26-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2887       MENU-ITEM m-ed-date26-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
