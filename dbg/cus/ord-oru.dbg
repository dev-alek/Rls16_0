     1841      v-size-col5  = decimal (entry ( 6 , v-uf-List_ ,chr(4))) no-error.
     1842      v-size-col6  = decimal (entry ( 7 , v-uf-List_ ,chr(4))) no-error.
     1843      v-size-col7  = decimal (entry ( 8, v-uf-List_  ,chr(4))) no-error.
     1844      v-size-col8  = decimal (entry ( 9, v-uf-List_ ,chr(4))) no-error.
