      611   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   procedure cmptime :
      613   do
      614   on error undo, return error
      615   :
      616   define output parameter p-difference as decimal      no-undo.
      617   define variable v-srv-time      as decimal           no-undo.
      618   define variable v-cli-time      as decimal           no-undo.
      619   assign
      620       session :time-source = "ub":U
      621       v-srv-time = integer(today) + ( time / 86400 )
      622   .
      623   assign
      624       session :time-source = "LOCAL":U
      625       v-cli-time = integer(today) + ( time / 86400 )
      626   .
      627   assign
      628       p-difference = ( v-srv-time - v-cli-time ) * 1440
      629   .
      630   end.
      631   end procedure.
      632   procedure cmptime-time-diff :
      633   do
      634   on error undo, return error
      635   :
      636   define input parameter p-date1          as date         no-undo.
      637   define input parameter p-time1          as integer      no-undo.
      638   define input parameter p-date2          as date         no-undo.
      639   define input parameter p-time2          as integer      no-undo.
      640   define output parameter p-difference    as decimal      no-undo.
      641       assign
      642           p-difference = ( integer( p-date2 ) - integer( p-date1 ) + ( ( p-time2 - p-time1 ) / 86400 ) ) * 1440
      643       .
      644   end.
      645   end procedure.
      646   procedure cmptime-string-to-hms :
      647   do
      648   on error undo, return error
      649   :
      650   define input parameter p-time-string as character    no-undo.
      651   define input parameter p-format      as character    no-undo.
      652   define output parameter p-hour as integer      no-undo.
      653   define output parameter p-min  as integer      no-undo.
      654   define output parameter p-sec  as integer      no-undo.
      655   if p-format <> "hh:mm" and p-format <> "hh:mm:ss"
      656   then do:
      657       message
      658         "cmptime.i: Ошибка преобразования строки даты"
      659         skip return-value
      660         skip trim(error-status :get-message(1))
      661              trim(error-status :get-message(2))
      662              trim(error-status :get-message(3))
      663              trim(error-status :get-message(4))
      664              trim(error-status :get-message(5))
      665       view-as alert-box error.
      666       undo, return error .
      667   end.
      668   assign
      669       p-hour      = integer ( entry( 1, p-time-string, ":" ) )
      670       p-min       = integer ( entry( 2, p-time-string, ":" ) )
      671       p-sec       = ( if p-format = "hh:mm:ss"
      672                       then integer ( entry( 3, p-time-string, ":" ) )
      673                       else 0
      674                     )
      675   .
      676   end.
      677   end procedure.
      678   procedure cmptime-hms-to-integer :
      679   do
      680   on error undo, return error
      681   :
      682   define input parameter p-hour   as integer      no-undo.
      683   define input parameter p-min    as integer      no-undo.
      684   define input parameter p-sec    as integer      no-undo.
      685   define output parameter p-time  as integer      no-undo.
      686       assign
      687           p-time = p-hour * 3600 + ( p-min * 60 ) + p-sec
      688       .
      689   end.
      690   end procedure.
      691   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   define  stream PrnLibStream.
      693   procedure prn-lib-prn-file :
      694     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      695     define input parameter p-DIsabledoptions as integer no-undo .
      696     define variable v-report-name as character no-undo .
      697     define variable v-user-action as character no-undo .
      698     define variable v-printed     as logical   no-undo .
      699     define variable v-exist       as logical   no-undo .
      700     do
      701       on error undo, return error
      702       :
      703       run prn-lib-get-report-name  in this-procedure (
      704         input parParentProc
      705         ,output v-report-name
      706         ).
      707   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      709     (input  v-report-name
      710     ,input  2
      711     ,output v-exist
      712     )  .
      713       if NOT v-exist then
      714       DO:
      715         Message
      716           "Нет заданий на печать ! "
      717           view-as alert-box .
      718         Return  .
      719       End.
      720       run gbl/prnfilen.w
      721         (input  ""
      722         ,input  p-DisabledOptions
      723         ,input  string(v-report-name )
      724         ,input  7
      725         ,output v-user-action
      726         ,output v-printed
      727         ) .
      728       if v-printed then
      729       do:
      730         return "YES" .
      731       end.
      732       else
      733       do:
      734         return "NO" .
      735       end.
      736     end.
      737   end procedure.
      738   procedure prn-lib-open-stream :
      739     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      740     define input parameter p-page-size    as integer no-undo .
      741     define input parameter p-is-stream    as logical no-undo .
      742     define input parameter p-append       as logical no-undo .
      743     define variable v-report-name as character no-undo .
      744     do
      745       on error undo, return error
      746       :
      747       run prn-lib-get-report-name  in this-procedure (
      748         input parParentProc
      749         ,output v-report-name
      750         ).
      751       if p-is-stream then
      752       do:
      753         if p-append then
      754         do:
      755           output stream PrnLibStream to value( v-report-name )
      756             page-size value(p-page-size) append .
      757         end.
      758         if not p-append then
      759         do:
      760           output stream PrnLibStream to value( v-report-name )
      761             page-size value(p-page-size) .
      762         end.
      763       end.
      764       if not p-is-stream then
      765       do:
      766         if p-append then
      767         do:
      768           output to value( v-report-name )
      769             page-size value(p-page-size) append .
      770         end.
      771         if not p-append then
      772         do:
      773           output to value( v-report-name )
      774             page-size value(p-page-size) .
      775         end.
      776       end.
      777     end.
      778   end procedure.
      779   procedure prn-lib-open-exp :
      780     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      781     define input parameter p-is-stream    as logical no-undo .
      782     define input parameter p-is-append    as logical no-undo .
      783     define output parameter p-ReportFileName as char init "report" no-undo.
      784     define output parameter p-process as logical no-undo .
      785     define variable glog as logical no-undo .
      786     do
      787       on error undo, return error
      788       :
      789       SYSTEM-DIALOG GET-FILE p-ReportFileName
      790         TITLE      "Укажите путь"
      791         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      792         ASK-OVERWRITE
      793         CREATE-TEST-FILE
      794         SAVE-AS
      795         USE-FILENAME
      796         DEFAULT-EXTENSION "txt"
      797         UPDATE glog
      798         .
      799       if not glog then  return.
      800       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      801       if p-is-stream then
      802       do:
      803         if p-is-append then
      804         do:
      805           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      806         end.
      807         else
      808         do:
      809           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      810         end.
      811       end.
      812       else
      813       do:
      814         if p-is-append then
      815         do:
      816           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      817         end.
      818         else
      819         do:
      820           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      821         end.
      822       end.
      823       p-process = yes.
      824     end.
      825   end procedure.
      826   procedure prn-lib-get-report-name :
      827     define input parameter parParentProc  as widget-handle no-undo.
      828     define output parameter p-report-name as character no-undo .
      829     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      830   end procedure.
      831   procedure prn-lib-reportviewer-report-name :
      832     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      833     define input parameter p-report-name-html as character no-undo .
      834     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      835   end procedure.
      836   procedure prn-lib-reportviewer :
      837     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      838     define input parameter p-report-name-html as character no-undo .
      839     define input parameter p-param        as character no-undo .
      840     define variable v-excel           as character no-undo init 'TRUE' .
      841     define variable v-value-character as character no-undo .
      842     define variable v-value-integer   as character no-undo .
      843     define variable v-value-date      as date      no-undo .
      844     define variable v-value-decimal   as decimal   no-undo .
      845     define variable rep-excel         as logical   no-undo .
      846     define variable excel-string      as character no-undo .
      847     define variable v-param-type      as character no-undo .
      848     define variable v-tth             as handle    no-undo .
      849     run adm/shattri.p (
      850       input "get":U
      851       ,input  ""
      852       ,input  0
      853       ,input  'report-glob':U
      854       ,input  'rep-excel':U
      855       ,output v-value-character
      856       ,output v-value-date
      857       ,output v-value-decimal
      858       ,output v-value-integer
      859       ,output rep-excel
      860       ,output v-param-type
      861       ,INPUT-OUTPUT table-handle v-tth
      862       )  .
      863     if rep-excel then v-excel = "TRUE" .
      864     else v-excel = "FALSE" .
      865     if p-param eq ""
      866     then
      867        p-param = "EXCEL:" + v-excel.
      868     else
      869        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      870     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      871   end procedure.
      872   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      873     if num-entries(string(p-dec), '.') = 2
      874       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      875       else return( string(p-dec)) .
      876   end function.
      877   function format-point-to-comma returns char (input orig as char ) .
      878   define variable rtext as character no-undo .
      879   define variable strt as integer no-undo .
      880   define variable leng as integer no-undo .
      881   assign rtext = orig .
      882   repeat:
      883     strt =  index(rtext,'.').
      884     if strt = 0 then leave.
      885     leng = 1.
      886     substring(rtext,strt,leng,"character") = v-delim .
      887   end.
      888   return rtext.
      889   end function.
      890   function format-excel-text returns char ( input start-text as char ) :
      891   def var  i    as int no-undo.
      892   def var  ch   as char no-undo.
      893   def var  n    as int no-undo.
      894   def var  ipos as int no-undo.
      895     n = num-entries(trim(start-text), chr(10)) - 1 .
      896     do i = 1 to n :
      897       ipos = index( start-text, chr(10)).
      898       if ipos > 0 then
      899         substr( start-text, ipos, 1 ) = ' '.
      900     end.
      901     n = num-entries(trim(start-text), chr(13)) - 1 .
      902     do i = 1 to n :
      903       ipos = index( start-text, chr(13)).
      904       if ipos > 0 then
      905         substr( start-text, ipos, 1 ) = ' '.
      906     end.
      907     if index( start-text, '"' ) = 0 then
      908       start-text =  '="'   + trim( start-text) + '"'   .
      909       else do:
      910         n = num-entries(trim(start-text), '"') - 1.
      911         do i = 1 to n :
      912           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      913         end.
      914         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      915         start-text = '="'  + ch  + '"' .
      916       end.
      917     return start-text.
      918   end.
      919   function excel-sum returns char (input p-dec as decimal ).
      920     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      921   end function.
      922   function excel-qnty returns char (input p-dec as decimal ).
      923     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      924   end function.
      925   function format-excel-text-macr returns char ( input start-text as char ) :
      926   def var  i    as int no-undo.
      927   def var  ch   as char no-undo.
      928   def var  n    as int no-undo.
      929   def var  ipos as int no-undo.
      930     n = num-entries(trim(start-text), chr(10)) - 1 .
      931     do i = 1 to n :
      932       ipos = index( start-text, chr(10)).
      933       if ipos > 0 then
      934         substring( start-text, ipos , 1 ) = ' '.
      935     end.
      936     n = num-entries(trim(start-text), chr(13)) - 1 .
      937     do i = 1 to n :
      938       ipos = index( start-text, chr(13)).
      939       if ipos > 0 then
      940         substring( start-text, ipos, 1 ) = ' '.
      941     end.
      942     if index( start-text, '"' ) = 0 then
      943       start-text =  '"'   + trim( start-text) + '"'   .
      944       else do:
      945         n = num-entries(trim(start-text), '"') - 1.
      946         do i = 1 to n :
      947           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      948         end.
      949         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      950         start-text = '"'  + ch  + '"' .
      951       end.
      952     n = num-entries(trim(start-text), chr(10)) - 1 .
      953     do i = 1 to n :
      954       ipos = index( start-text, chr(10)).
      955       if ipos > 0 then
      956         substring( start-text, ipos , 1 ) = ' '.
      957     end.
      958       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      959     return start-text.
      960   end.
      961   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   procedure cur-time :
      963      define output parameter p-today as date      no-undo .
      964      define output parameter p-time  as integer   no-undo .
      965     do
      966     on error undo, return error
      967     :
      968       define variable v-date1 as date      no-undo .
      969       define variable v-date2 as date      no-undo .
      970       define variable v-time  as integer   no-undo .
      971       assign
      972         v-date1 = today
      973         v-time  = time
      974         v-date2 = today
      975       .
      976       if v-date1 <> v-date2
      977       then do:
      978         assign
      979           v-date1 = today
      980           v-time  = v-time
      981         .
      982       end.
      983       assign
      984         p-today = v-date1
      985         p-time  = v-time
      986       .
      987     end.
      988   end.
      989   function cur-time-date returns character
      990   :
      991     return string(today, '99/99/9999':U) .
      992   end.
      993   function cur-time-mjd returns decimal
      994   :
      995     define variable v-date as date      no-undo .
      996     define variable v-time as integer   no-undo .
      997     run cur-time in this-procedure
      998       (output v-date
      999       ,output v-time
     1000       ) .
     1001     return integer(v-date) - 2400002 + (v-time / 86400) .
     1002   end.
     1003   function cur-time-get-ending-index returns integer
     1004   (input p-number as integer
     1005   )
     1006   :
     1007     if p-number < 0
     1008     or p-number = ?
     1009     then do:
     1010       return 1 .
     1011     end.
     1012     define variable v-rest as integer   no-undo .
     1013     assign
     1014       p-number = p-number modulo 100
     1015     .
     1016     if p-number < 20
     1017     then do:
     1018       assign
     1019         v-rest = p-number
     1020       .
     1021     end.
     1022     else do:
     1023       assign
     1024         v-rest = p-number modulo 10
     1025       .
     1026     end.
     1027     case v-rest :
     1028       when 1
     1029       then do:
     1030         return 2 .
     1031       end.
     1032       when 2 or
     1033       when 3 or
     1034       when 4
     1035       then do:
     1036         return 3 .
     1037       end.
     1038       otherwise do:
     1039         return 1 .
     1040       end.
     1041     end case .
     1042   end.
     1043   procedure cur-time-mjd-to-date :
     1044      define input  parameter i-mjd-diff as decimal no-undo.
     1045      define output parameter o-Date     as date    no-undo.
     1046      define output parameter o-Time     as integer no-undo.
     1047      define variable v-day-number as integer   no-undo .
     1048      if    i-mjd-diff < 0
     1049         or i-mjd-diff = ?
     1050      then do:
     1051         return "?" .
     1052      end.
     1053      assign
     1054         v-day-number = truncate(i-mjd-diff,0).
     1055         o-Date = date(v-day-number + 2400002).
     1056         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1057     .
     1058   end.
     1059   function cur-time-mjd-to-string returns character
     1060   (input p-mjd-diff as decimal
     1061   )
     1062   :
     1063     define variable v-day-number as integer   no-undo .
     1064     define variable v-seconds    as integer   no-undo .
     1065     define variable v-hour       as integer   no-undo .
     1066     define variable v-min        as integer   no-undo .
     1067     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1068     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1069     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1070     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1071     if p-mjd-diff < 0
     1072     or p-mjd-diff = ?
     1073     then do:
     1074       return "?" .
     1075     end.
     1076     assign
     1077       v-day-number = integer(truncate(p-mjd-diff,0))
     1078       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1079     .
     1080     if v-seconds > 86400
     1081     then do:
     1082       assign
     1083         v-seconds = 86400 - 1
     1084       .
     1085     end.
     1086     if v-seconds < 0
     1087     then do:
     1088       assign
     1089         v-seconds = 0
     1090       .
     1091     end.
     1092     assign
     1093       v-hour = truncate(v-seconds / 3600, 0)
     1094     .
     1095     assign
     1096       v-seconds = v-seconds modulo 3600
     1097     .
     1098     assign
     1099       v-min = truncate(v-seconds / 60, 0)
     1100     .
     1101     assign
     1102       v-seconds = v-seconds modulo 60
     1103     .
     1104     return
     1105         (if v-day-number <> 0
     1106           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1107           else ""
     1108         )
     1109       + (if v-day-number <> 0 or v-hour <> 0
     1110           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1111           else ""
     1112         )
     1113       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1114           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1115           else ""
     1116         )
     1117       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1118       .
     1119   end.
     1120   function cur-time-string returns character
     1121   :
     1122     define variable v-date as date      no-undo .
     1123     define variable v-time as integer   no-undo .
     1124     run cur-time in this-procedure
     1125       (output v-date
     1126       ,output v-time
     1127       ) .
     1128     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1129   end.
     1130   function cur-time-string-sec returns character
     1131   :
     1132     define variable v-date as date      no-undo .
     1133     define variable v-time as integer   no-undo .
     1134     run cur-time in this-procedure
     1135       (output v-date
     1136       ,output v-time
     1137       ) .
     1138     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1139   end.
     1140   function cur-time-custom  returns character
     1141   (input p-prefix as character
     1142   ,input p-date-format as character
     1143   ,input p-delimiter as character
     1144   ,input p-time-format as character
     1145   ,input p-suffix as character
     1146   )
     1147   :
     1148     define variable v-date as date      no-undo .
     1149     define variable v-time as integer   no-undo .
     1150     run cur-time in this-procedure
     1151       (output v-date
     1152       ,output v-time
     1153       ) .
     1154     return
     1155       p-prefix
     1156       + string(v-date, p-date-format)
     1157       + p-delimiter
     1158       + string(v-time, p-time-format)
     1159       + p-suffix
     1160       .
     1161   end.
     1162   function cur-time-print  returns character
     1163   :
     1164     define variable v-date as date      no-undo .
     1165     define variable v-time as integer   no-undo .
     1166     run cur-time in this-procedure
     1167       (output v-date
     1168       ,output v-time
     1169       ) .
     1170     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1171   end.
     1172   function cur-time-datetime returns datetime
     1173   :
     1174     define variable v-char as character no-undo .
     1175     define variable v-datetime as datetime no-undo .
     1176     v-char = cur-time-string().
     1177     v-datetime = datetime(v-char).
     1178     return  v-datetime.
     1179   end.
     1180   function cur-time-string-msec returns character
     1181   :
     1182     define variable v-date as datetime  no-undo .
     1183     v-date = now.
     1184     return string(v-date) .
     1185   end.
     1186   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1188   procedure paramls-clear :
     1189     define buffer buf_temp-param for temp-param .
     1190     do
     1191     on error undo, return error return-value
     1192     :
     1193       for each buf_temp-param
     1194       on error undo, return error
     1195       :
     1196         delete buf_temp-param .
     1197       end.
     1198     end.
     1199   end procedure.
     1200   procedure paramls-write :
     1201     define input  parameter p-code     as character no-undo .
     1202     define input  parameter p-sub-code as character no-undo .
     1203     define input  parameter p-value    as character no-undo .
     1204     define buffer buf_temp-param for temp-param .
     1205     do
     1206     on error undo, return error return-value
     1207     :
     1208       find first buf_temp-param
     1209         where buf_temp-param.param-code     = p-code
     1210           and buf_temp-param.param-sub-code = p-sub-code
     1211         no-error .
     1212       if not available buf_temp-param then do:
     1213         create buf_temp-param .
     1214         assign
     1215           buf_temp-param.param-code     = p-code
     1216           buf_temp-param.param-sub-code = p-sub-code
     1217         .
     1218       end.
     1219       assign
     1220         buf_temp-param.param-value = p-value
     1221       .
     1222     end.
     1223   end procedure.
     1224   procedure paramls-read :
     1225     define input  parameter p-code          as character no-undo .
     1226     define input  parameter p-sub-code      as character no-undo .
     1227     define input  parameter p-default-value as character no-undo .
     1228     define output parameter p-value         as character no-undo .
     1229     define buffer buf_temp-param for temp-param .
     1230     do
     1231     on error undo, return error return-value
     1232     :
     1233       find first buf_temp-param
     1234         where buf_temp-param.param-code     = p-code
     1235           and buf_temp-param.param-sub-code = p-sub-code
     1236         no-error .
     1237       if available buf_temp-param then do:
     1238         assign
     1239           p-value = buf_temp-param.param-value
     1240         .
     1241       end.
     1242       else do:
     1243         assign
     1244           p-value = p-default-value
     1245         .
     1246       end.
     1247     end.
     1248   end procedure.
     1249   procedure paramls-append :
     1250     define input  parameter p-code     as character no-undo .
     1251     define input  parameter p-sub-code as character no-undo .
     1252     define input  parameter p-value    as character no-undo .
     1253     define buffer buf_temp-param for temp-param .
     1254     do
     1255     on error undo, return error return-value
     1256     :
     1257       find first buf_temp-param
     1258            where buf_temp-param.param-code     = p-code
     1259              and buf_temp-param.param-sub-code = p-sub-code
     1260         no-error .
     1261       if not available buf_temp-param then do:
     1262         create buf_temp-param .
     1263         assign
     1264           buf_temp-param.param-code     = p-code
     1265           buf_temp-param.param-sub-code = p-sub-code
     1266           buf_temp-param.param-value    = p-value
     1267         .
     1268       end.
     1269       else do:
     1270           assign
     1271               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1272           .
     1273       end.
     1274     end.
     1275   end procedure.
     1276   define temp-table temp-font no-undo
     1277     field fontnum  as integer
     1278     field fontname as character
     1279     field fontsize as character
     1280     field fonttype as character
     1281     field font-h   as integer
     1282     field font-w   as integer
     1283     field v-row    as integer
     1284     field v-col    as integer
     1285     field v-row-lans as integer
     1286     field v-col-lans as integer
     1287   index pi fontnum
     1288   .
     1289   procedure get-font-ini :
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293   define variable ii as integer   no-undo .
     1294   define variable v-font7 as character no-undo .
     1295   define variable v-font as character no-undo .
     1296   define variable loc-name as character no-undo .
     1297   define variable loc-size as character no-undo .
     1298   define variable loc-type as character no-undo .
     1299   define variable old_H as integer   no-undo .
     1300   define variable old_w as integer   no-undo .
     1301   define variable old-row  as integer   no-undo .
     1302   define variable old-col  as integer   no-undo .
     1303   define variable old-row-lans  as integer   no-undo .
     1304   define variable old-col-lans  as integer   no-undo .
     1305   define variable vv as integer   no-undo .
     1306   empty temp-table temp-font.
     1307     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1308       case num-entries (v-font7) :
     1309         when 4 then do:
     1310             assign
     1311               loc-name = entry ( 1 , v-font7 )
     1312               loc-size = entry ( 2 , v-font7 )
     1313               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1314             .
     1315         end.
     1316         when 3 then do:
     1317             assign
     1318               loc-name = entry ( 1 , v-font7 )
     1319               loc-size = entry ( 2 , v-font7 )
     1320               loc-type = entry ( 3 , v-font7 )
     1321             .
     1322         end.
     1323         when 2 then  do:
     1324             assign
     1325               loc-name = entry ( 1 , v-font7 )
     1326               loc-size = entry ( 2 , v-font7 )
     1327               loc-type = ""
     1328             .
     1329         end.
     1330         when 1 then do:
     1331             assign
     1332               loc-name = trim(entry ( 1 , v-font7 ))
     1333               loc-size = ""
     1334               loc-type = ""
     1335             .
     1336         end.
     1337       end case.
     1338     create temp-font.
     1339     assign
     1340       temp-font.fontnum  = 7
     1341       temp-font.fontname = trim(loc-name)
     1342       temp-font.fontsize = trim(loc-size)
     1343       temp-font.fonttype = trim(loc-type)
     1344       temp-font.v-row    = 62
     1345       temp-font.v-col    = 136
     1346       temp-font.v-row-lans = 43
     1347       temp-font.v-col-lans = 198
     1348     .
     1349     repeat ii = 16 to 100 :
     1350       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1351       if v-font = "" or v-font = ? then leave.
     1352       case num-entries (v-font) :
     1353         when 4 then do:
     1354             assign
     1355               loc-name = entry ( 1 , v-font )
     1356               loc-size = entry ( 2 , v-font )
     1357               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1358             .
     1359         end.
     1360         when 3 then do:
     1361             assign
     1362               loc-name = entry ( 1 , v-font )
     1363               loc-size = entry ( 2 , v-font )
     1364               loc-type = entry ( 3 , v-font )
     1365             .
     1366         end.
     1367         when 2 then do:
     1368             assign
     1369               loc-name = entry ( 1 , v-font )
     1370               loc-size = entry ( 2 , v-font )
     1371               loc-type = ""
     1372             .
     1373         end.
     1374         when 1 then do:
     1375             assign
     1376               loc-name = trim(entry ( 1 , v-font ))
     1377               loc-size = ""
     1378               loc-type = ""
     1379             .
     1380         end.
     1381       end case.
     1382     create temp-font.
     1383     assign
     1384       temp-font.fontnum  = ii
     1385       temp-font.fontname = trim(loc-name)
     1386       temp-font.fontsize = trim(loc-size)
     1387       temp-font.fonttype = trim(loc-type)
     1388     .
     1389     end.
     1390       for each temp-font :
     1391          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1392          if  vv = ? then vv =  0 .
     1393           run rep/exfont.p (
     1394             input   temp-font.fontname ,
     1395             input   vv ,
     1396             input   temp-font.fonttype ,
     1397             output  temp-font.font-h   ,
     1398             output  temp-font.font-w   )
     1399           .
     1400       end.
     1401   find first temp-font where  temp-font.fontnum  = 7  .
     1402   old_H = temp-font.font-H .
     1403   old_w = temp-font.font-W .
     1404   old-row = temp-font.v-row .
     1405   old-col = temp-font.v-col .
     1406   old-row-lans = temp-font.v-row-lans .
     1407   old-col-lans = temp-font.v-col-lans .
     1408       for each temp-font where
     1409                temp-font.fontnum  <> 7 :
     1410           assign
     1411               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1412               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1413               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1414               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1415           .
     1416       end.
     1417     end.
     1418   end procedure.
     1419   PROCEDURE How-name :
     1420   define input  parameter h as integer no-undo .
     1421   define input  parameter w as integer no-undo .
     1422   define output parameter n as character  no-undo .
     1423   define variable A4port-H as integer   no-undo init 63.
     1424   define variable A4port-W as integer   no-undo init 136.
     1425   define variable A4lans-H as integer   no-undo init 43.
     1426   define variable A4lans-W as integer   no-undo init 198.
     1427   define variable Strim-W  as integer   no-undo init 278.
     1428   run define-a4-size (
     1429        input ReportFontNum
     1430       ,output A4port-H
     1431       ,output A4port-W
     1432       ,output A4lans-H
     1433       ,output A4lans-W ).
     1434   If w >= 1 and w <= A4port-W Then DO:
     1435     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1436     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1437     If h > A4port-H              Then n = "to-file":U.
     1438   End.
     1439   If w > A4port-W and w <= A4lans-W Then DO:
     1440     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1441     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1442     If h > A4port-H              Then n = "to-file":U.
     1443   End.
     1444   If w > A4lans-W and w <= Strim-W Then DO:
     1445     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1446     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1447     If h > A4port-H              Then n = "to-file":U.
     1448   End.
     1449   If w > Strim-W Then DO:
     1450      n = "to-file":U.
     1451   End.
     1452   END PROCEDURE.
     1453   PROCEDURE define-a4-size :
     1454   define input  parameter p-ReportFontNum as integer   no-undo .
     1455   define output parameter A4port-H as integer   no-undo .
     1456   define output parameter A4port-W as integer   no-undo .
     1457   define output parameter A4lans-H as integer   no-undo .
     1458   define output parameter A4lans-W as integer   no-undo .
     1459   if not can-find (first temp-font ) then do:
     1460      run get-font-ini .
     1461   end.
     1462   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1463   if available temp-font then do:
     1464   assign
     1465     A4port-H = temp-font.v-row
     1466     A4port-W = temp-font.v-col
     1467     A4lans-H = temp-font.v-row-lans
     1468     A4lans-W = temp-font.v-col-lans
     1469   .
     1470   end.
     1471   else do:
     1472   assign
     1473     A4port-H = 63
     1474     A4port-W = 136
     1475     A4lans-H = 43
     1476     A4lans-W = 198
     1477   .
     1478   end.
     1479   END PROCEDURE.
     1480   define variable v-file-name as character no-undo .
     1481   define variable v-ind       as integer   no-undo .
     1482   define variable num#col# as integer no-undo .
     1483   define variable var-1 as integer no-undo .
     1484   define variable var-2 as integer no-undo .
     1485   define variable C-c    as integer no-undo .
     1486   define variable C-str  as character no-undo .
     1487   define variable str--1 as character Format "x(60)" no-undo.
     1488   define variable str--2 as integer no-undo .
     1489   define variable C-i    as integer no-undo .
     1490   define variable p-var  as integer no-undo .
     1491   define stream  macr_excel .
     1492   do
     1493   on error undo, return error
     1494   :
     1495     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     1496     ASSIGN parParentProc =  my-handle .
     1497     define variable g#report-num as integer   no-undo .
     1498     run get-report-num  in parParentProc ( output g#report-num ).
     1499     define buffer buf_ord-doc      for ub.ord-doc.
     1500     define buffer buf_ord-line     for ub.ord-line.
     1501     define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv.
     1502     define buffer buf_ord-line-rcv for ub.ord-line-rcv.
     1503     define buffer buf_goods        for ub.goods.
     1504     define buffer buf_trn-doc      for ub.trn-doc.
     1505     define buffer buf_doc-line     for ub.doc-line.
     1506     define buffer buf_clients      for ub.clients.
     1507     define temp-table Temp-i no-undo
     1508       field i-num-doc    like ub.ord-doc-rcv.doc-code
     1509       field i-num-rcv    like ub.ord-doc-rcv.rcv-code
     1510       field i-val-nakl   as decimal
     1511       field i-date-nakl  as date
     1512       field i-time-nakl  as char
     1513       field i-cost-nakl  as decimal
     1514       index PI IS PRIMARY i-num-doc  i-num-rcv
     1515     .
     1516     define variable Counter as integer .
     1517   define variable v-account as integer init 0 no-undo .
     1518   define variable v-account-lavel as character no-undo .
     1519   define variable v-button-stop as logical no-undo .
     1520   define variable v-kol-spice as integer no-undo .
     1521   define variable v-kol-spice2 as integer no-undo .
     1522   define variable v-kol-spice3 as integer no-undo .
     1523   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1524   DEFINE BUTTON StopBtn AUTO-END-KEY
     1525        LABEL "Стоп"
     1526        SIZE 10 BY 1.
     1527   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1528        LABEL "Обработано записей"
     1529         VIEW-AS TEXT
     1530        SIZE 14 BY .67 NO-UNDO.
     1531   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1532         VIEW-AS TEXT
     1533        SIZE 53.25 BY .67
     1534        FGCOLOR 1  NO-UNDO.
     1535   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1536         VIEW-AS TEXT
     1537        SIZE 53.25 BY .67
     1538        FGCOLOR 1  NO-UNDO.
     1539   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1540         VIEW-AS TEXT
