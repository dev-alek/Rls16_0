      168   def
      169    shared
      170   temp-table  obj-list no-undo
      171     field obj-type like ub.clients.obj-type
      172     field obj-code like ub.clients.obj-code
      173     field obj-name like ub.clients.obj-name
      174     field obj-id   as integer
