     1784           for each Temp-i:  delete Temp-i .  end.
     1785           for each buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.doc-code  = buf_ord-doc.doc-code :
     1786             if p-post-2 = 2 then do:
