     1555            TITLE "Процесс"
     1556            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1557   define variable mFrameView      as logical   no-undo init yes.
     1558     define variable mFramHandle as handle no-undo.
     1559     mFramHandle = frame InfoFrame:handle.
     1560     if  log-manager:logfile-name ne ?
