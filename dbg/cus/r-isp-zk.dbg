     1881             view-as alert-box error.
     1882             undo, return error .
     1883           end.
     1884          find first ub.ext-artic no-lock where
     1885                 ub.ext-artic.gds-code = buf_ord-line.gds-code and
     1886                 ub.ext-artic.cli-type = buf_ord-doc.Cli-type and
     1887                 ub.ext-artic.cli-code = buf_ord-doc.Cli-code and
     1888                 ub.ext-artic.status_  = 'тек':U no-error .
