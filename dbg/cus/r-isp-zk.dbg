     2211   procedure proc-print-header-my :
     2212    do
     2213    on error undo, return error return-value
     2214    :
     2215      find first sheetf .
     2216        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2217        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2218        var-1 =  num#str# .
     2219        repeat c-c = 1 to sheetf.excel-row-title :
     2220        num#str# = num#str# + 1 .
     2221        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2222        do c-i = 1 to p-var :
     2223           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2224           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2225           num#col# = c-i .
     2226           run macr_excel_char ( str--1  , num#str# , num#col#  ) .
     2227           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2228        end.
     2229       c-i = 0.
     2230       end.
     2231       run macr_cell_format (
     2232           10       ,
     2233           true     ,
     2234           false    ,
     2235           35       ,
     2236           var-1 + 1,
     2237           1        ,
     2238           num#str# ,
     2239           num#col# )
     2240           .
     2241     put  stream macr_excel unformatted
     2242          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2243           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2244          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2245          .
     2246    end.
     2247   end procedure.
     2248   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2249   procedure macr_excel_char :
     2250    do
     2251    on error undo, return error return-value
     2252    :
     2253    define input parameter  p-val as character no-undo .
     2254    define input parameter  p-row as integer no-undo .
     2255    define input parameter  p-col as integer no-undo .
     2256    if p-val = ? then p-val = "" .
     2257       put stream macr_excel unformatted
     2258             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2259    end.
     2260   end procedure.
     2261   procedure macr_excel_char_with_format :
     2262    do
     2263    on error undo, return error return-value
     2264    :
     2265    define input parameter  p-val as character no-undo .
     2266    define input parameter  p-row as integer no-undo .
     2267    define input parameter  p-col as integer no-undo .
     2268    if p-val = ? then p-val = "" .
     2269       put stream macr_excel unformatted
     2270             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2271       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2272       put stream macr_excel unformatted
     2273             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2274    end.
     2275   end procedure.
     2276   procedure macr_excel_cell_format :
     2277    do
     2278    on error undo, return error return-value
     2279    :
     2280    define input parameter  p-val    as character no-undo .
     2281    define input parameter  p-row    as integer   no-undo .
     2282    define input parameter  p-col    as integer   no-undo .
     2283    define input parameter  p-format as character no-undo .
     2284    if p-val = ? then p-val = "" .
     2285       put stream macr_excel unformatted
     2286             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2287       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2288       put stream macr_excel unformatted
     2289             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2290    end.
     2291   end procedure.
     2292   procedure macr_excel_sum :
     2293    do
     2294    on error undo, return error return-value
     2295    :
     2296    define input parameter  p-row as integer no-undo .
     2297    define input parameter  p-col as integer no-undo .
     2298    define input parameter  p-row1 as integer no-undo .
     2299    define input parameter  p-col1 as integer no-undo .
     2300    define input parameter  p-row2 as integer no-undo .
     2301    define input parameter  p-col2 as integer no-undo .
     2302       put stream macr_excel unformatted
     2303             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2304    end.
     2305   end procedure.
     2306   procedure macr_excel_dec :
     2307    do
     2308    on error undo, return error return-value
     2309    :
     2310    define input parameter  p-val as character no-undo .
     2311    define input parameter  p-row as integer   no-undo .
     2312    define input parameter  p-col as integer   no-undo .
     2313     if p-val = ? then p-val =  "" .
     2314      put  stream macr_excel unformatted
     2315           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2316    end.
     2317   end procedure.
     2318   procedure macr_cell_format :
     2319    do
     2320    on error undo, return error return-value
     2321    :
     2322    define input parameter  p-size   as integer   no-undo .
     2323    define input parameter  p-bold   as logical   no-undo .
     2324    define input parameter  p-italic as logical   no-undo .
     2325    define input parameter  p-color  as integer   no-undo .
     2326    define input parameter  p-row    as integer   no-undo .
     2327    define input parameter  p-col    as integer   no-undo .
     2328    define input parameter  p-row-2  as integer   no-undo .
     2329    define input parameter  p-col-2  as integer   no-undo .
     2330     if p-size = ? then p-size = 10 .
     2331     if p-bold = ? then p-bold = false .
     2332     if p-italic = ? then p-italic = false .
     2333     if p-row-2 = ? then p-row-2 = p-row .
     2334     if p-col-2 = ? then p-col-2 = p-col .
     2335     put  stream macr_excel unformatted
     2336      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2337     if p-color <> ? then do:
     2338        put  stream macr_excel unformatted
     2339          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2340     end.
     2341     put  stream macr_excel unformatted
     2342          substitute('format.font(,&1,&2,&3)' , p-size,
     2343                                           string ( p-bold  , "true/false" ) ,
     2344                                           string ( p-italic , "true/false" )
     2345                                           ) + chr(10) .
     2346    end.
     2347   end procedure.
     2348   procedure macr_cell_size :
     2349    do
     2350    on error undo, return error return-value
     2351    :
     2352    define input parameter  p-w   as integer   no-undo .
     2353    define input parameter  p-l   as integer   no-undo .
     2354    define input parameter  p-row    as integer   no-undo .
     2355    define input parameter  p-col    as integer   no-undo .
     2356    define input parameter  p-row-2  as integer   no-undo .
     2357    define input parameter  p-col-2  as integer   no-undo .
     2358     if p-row-2 = ? then p-row-2 = p-row .
     2359     if p-col-2 = ? then p-col-2 = p-col .
     2360     if p-w = ? then    p-w = 0 .
     2361     if p-l = ? then    p-l = 0 .
     2362    define variable s-w as character no-undo .
     2363    define variable s-l as character no-undo .
     2364    if p-w = 0 then s-w = "" .
     2365               else s-w = string(p-w)  .
     2366    if p-l = 0 then s-l = "" .
     2367               else s-l = string(p-l)  .
     2368   put  stream macr_excel unformatted
     2369        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2370   put  stream macr_excel unformatted
     2371        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2372   put  stream macr_excel unformatted
     2373        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2374    end.
     2375   end procedure.
     2376   procedure proc-print-header :
     2377    do
     2378    on error undo, return error return-value
     2379    :
     2380      find first sheetf .
     2381        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2382        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2383        var-1 =  num#str# .
     2384        repeat c-c = 1 to sheetf.excel-row-title :
     2385        num#str# = num#str# + 1 .
     2386        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2387        do c-i = 1 to p-var :
     2388           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2389           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2390           num#col# = c-i .
     2391           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2392           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2393        end.
     2394       c-i = 0.
     2395       end.
     2396       run macr_cell_format (
     2397           10       ,
     2398           true     ,
     2399           false    ,
     2400           35       ,
     2401           var-1 + 1,
     2402           1        ,
     2403           num#str# ,
     2404           num#col# )
     2405           .
     2406     put  stream macr_excel unformatted
     2407          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2408          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2409          .
     2410    end.
     2411   end procedure.
     2412   procedure end-proc :
     2413    do
     2414    on error undo, return error return-value
     2415    :
     2416     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2417     OUTPUT to VALUE (v-file-name) .
     2418     for each temp-param :
     2419       export  temp-param  .
     2420     end.
     2421    end.
     2422   end procedure.
