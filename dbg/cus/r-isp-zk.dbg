     1795                 run cmptime-time-diff ( buf_trn-doc.fact-date, buf_ord-doc-rcv.fact-ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1796                 if p-time >= ABSOLUTE( v-difference ) then next TT .
     1797               end.
     1798               find first buf_doc-line no-lock
     1799                 where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     1800                   and buf_doc-line.artic     = buf_ord-line.artic
     1801                   and buf_doc-line.prod-type = buf_ord-line.prod-type
     1802                   and buf_doc-line.prod-code = buf_ord-line.prod-code
     1803                   no-error
     1804                 .
     1805               if available buf_doc-line then do:
     1806                 create Temp-i no-error .
     1807                 assign
     1808                   Temp-i.i-num-doc    = buf_ord-doc.doc-code
     1809                   Temp-i.i-num-rcv    = buf_ord-doc-rcv.rcv-code
     1810                   Temp-i.i-val-nakl   = buf_doc-line.fact-qnty
     1811                   Temp-i.i-date-nakl  = buf_trn-doc.fact-date
     1812                   Temp-i.i-time-nakl  = string(buf_ord-doc-rcv.fact-ship-time, "HH:MM")
     1813                 .
     1814                 if x-SET_val_TYPE = 1 then assign Temp-i.i-cost-nakl = buf_doc-line.price-rubl .
     1815                 else                       assign Temp-i.i-cost-nakl = buf_doc-line.price-base .
     1816               end.
     1817             end.
     1818             end.
     1819             else do:
     1820               if p-otkl = 4 or p-otkl = 5 then do:
     1821                 run cmptime-time-diff ( buf_ord-doc-rcv.ship-date, buf_ord-doc-rcv.ship-time, buf_ord-doc.ship-date, buf_ord-doc.ship-time,output v-difference) .
     1822                 if p-time >= ABSOLUTE( v-difference ) then next TT .
     1823               end.
     1824               find first buf_ord-line-rcv no-lock
     1825                 where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
     1826                   and buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
     1827                   and buf_ord-line-rcv.artic     = buf_ord-line.artic
     1828                   and buf_ord-line-rcv.prod-type = buf_ord-line.prod-type
     1829                   and buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     1830                   no-error
     1831                 .
     1832               if available buf_ord-line-rcv then do:
     1833                 create Temp-i no-error .
     1834                 assign
     1835                   Temp-i.i-num-doc    = buf_ord-doc-rcv.doc-code
     1836                   Temp-i.i-num-rcv    = buf_ord-doc-rcv.rcv-code
     1837                   Temp-i.i-val-nakl   = buf_ord-line-rcv.qnty
     1838                   Temp-i.i-date-nakl  = buf_ord-doc-rcv.ship-date
     1839                   Temp-i.i-time-nakl  = string(buf_ord-doc-rcv.ship-time, "HH:MM")
     1840                 .
     1841                 if x-SET_val_TYPE = 1 then assign Temp-i.i-cost-nakl = buf_ord-line-rcv.price-rubl .
     1842                 else                       assign Temp-i.i-cost-nakl = buf_ord-line-rcv.price-base .
