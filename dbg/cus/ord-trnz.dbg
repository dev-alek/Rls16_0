     1033   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1034   define temp-table tt-parts    no-undo like ub.parts.
     1035   procedure lib-trn_copy-inqu :
     1036   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
