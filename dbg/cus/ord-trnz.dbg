     1041   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1042   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1043   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1044   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1045   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1046   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1047   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1048   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1049   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1050   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1051   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
