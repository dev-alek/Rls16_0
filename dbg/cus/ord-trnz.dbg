        1   block-level on error undo, throw.
        2   define input parameter parParentProc   as widget-handle no-undo.
        3   define input parameter tp-rec as recid no-undo .
        4   define input parameter par-type as character no-undo .
        5   define input parameter par-doc-code as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
