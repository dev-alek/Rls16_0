       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: ord-trnz.p $ $Revision: aea5316774be, 0, rls $".
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83     define variable v-cntxt-db-num        as integer   no-undo .
       84     define variable v-cntxt-userid        as character no-undo .
       85     define variable v-cntxt-level         as character no-undo .
       86     define variable v-cntxt-host-code-obj as integer   no-undo .
       87     define variable v-cntxt-obj-type      as character no-undo .
       88     define variable v-cntxt-obj-code      as integer   no-undo .
       89     define variable v-cntxt-db-num-obj    as integer   no-undo .
       90     define variable v-cntxt-is-admin      as logical   no-undo .
       91   define new global shared variable g#lib-trn  as handle no-undo .
       92   define new global shared variable g#lib-trn2 as handle no-undo .
       93   define new global shared variable g#lib-trn3 as handle no-undo .
       94   define new global shared variable g#lib-trn4 as handle no-undo .
       95   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define variable to-day       as date no-undo .
       97   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   procedure doc-code:
       99   define input  parameter parmode          as   character           no-undo.
      100   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      101   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      102   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      103   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      104   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      105   define variable vardb-remote     as   logical             no-undo.
      106   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      107   define variable v-delimiter as character no-undo .
      108   do
      109   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      110   :
      111   find first buf_sys-ctrl no-lock .
      112   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      113     CASE parmode:
      114       when "main":u then do:
      115         if vardb-remote then do:
      116           assign
      117             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      118         end.
      119         else do:
      120           assign
      121             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      122         end.
      123       end.
      124       when "trio" then do:
      125         assign
      126           pardoc-code = replace (parroot-doc-code, "=", "*").
      127       end.
      128       otherwise do:
      129         assign
      130         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      131         no-error
      132         .
      133         if error-status:error  then do:
      134           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      135                                         ,chr(10)
      136                                         ,parmode
      137                                         ).
      138         end.
      139         if num-entries(parmode) = 1
      140         and parmode <> "chip":U
      141         and parmode <> "chip_s":U
      142         then do:
      143           assign
      144           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      145         end.
      146         else if (lookup("chip":U, parmode) > 0
      147                  or
      148                  lookup("chip_s":U, parmode) > 0) then do:
      149           assign
      150             vartemp-doc-code = parroot-doc-code.
      151           do while true:
      152             if index (vartemp-doc-code , ".") = 0 then
      153               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      154             else
      155               vartemp-doc-code  =
      156               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      157               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      158               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      159             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      160           end.
      161           assign
      162             pardoc-code = vartemp-doc-code.
      163         end.
      164       end.
      165     end CASE.
      166     if pardoc-code = '':U
      167     or (parroot-doc-code <> '':U
      168     and pardoc-code = parroot-doc-code) then do:
      169       undo, return error substitute("Ошибка при генерации номера документа&1"
      170                                     ,chr(10)).
      171     end.
      172   end.
      173   end. // procedure/method
      174   function get-doc-code-int64 returns int64
      175     ( input p-doc-code as character ) :
      176     define variable v-ind              as integer   no-undo .
      177     define variable v-num-entries      as integer   no-undo .
      178     define variable v-doc-code-int64   as int64     no-undo .
      179     define variable v-canonic-doc-code as character no-undo .
      180     assign
      181       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      182       v-canonic-doc-code = p-doc-code
      183     .
      184     do v-ind = 1 to v-num-entries
      185     :
      186       assign
      187         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      188       .
      189     end.
      190     assign
      191       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      192     .
      193     return v-doc-code-int64 .
      194   end. // function/method
      195   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   define variable v-waitfram-action01         as character   no-undo .
      197   define variable v-waitfram-action02         as character   no-undo .
      198   define variable v-waitfram-action03         as character   no-undo .
      199   define variable mWaitFramTextBeg            as character   no-undo.
      200   define variable mWaitFramTextEnd            as character   no-undo.
      201   define variable mWaitFramView               as logical     no-undo.
      202   define variable mWaitProcEvent              as logical     no-undo init yes.
      203   define variable mWaitFramInterval           as integer     no-undo init 1 .
      204   define variable mWaitFramStop               as logical     no-undo.
      205   define variable mWaitFramStopUser           as logical     no-undo.
      206   define variable mWaitFramStopTimeOut        as logical     no-undo.
      207   define variable mWaitFramStartProc          as datetime-tz no-undo.
      208   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      209   define button B-WaitFramStop auto-end-key
      210        label "Стоп"
      211        size 10 by 1 tooltip "Остоновить процесс".
      212   define button B-viewProcInfo
      213        label "Информация"
      214        size 15 by 1 tooltip "Информация о процесс".
      215   define frame waitfram
      216     v-waitfram-action01 format "x(72)" no-label skip
      217     v-waitfram-action02 format "x(72)" no-label skip
      218     v-waitfram-action03 format "x(72)" no-label skip
      219     B-viewProcInfo
      220     B-WaitFramStop at row 4 col 30
      221     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      222     .
      223   define new global shared variable mBatchMode as logical no-undo init ?.
      224   define variable mFramBachModHandle as handle no-undo.
      225   mFramBachModHandle = frame waitfram:handle.
      226   define variable mFameOldVis as logical no-undo.
      227   define variable mVisCUrentVin as logical no-undo.
      228   if session:batch-mode
      229   then
      230      mBatchMode = yes.
      231   if mBatchMode = ? then do:
      232     mVisCUrentVin = current-window:visible.
      233     mFameOldVis = mFramBachModHandle:visible.
      234     mFramBachModHandle:visible  = yes.
      235     mBatchMode = mFramBachModHandle:visible ne yes.
      236     mFramBachModHandle:visible = mFameOldVis.
      237     current-window:visible = mVisCUrentVin.
      238   end.
      239    if  log-manager:logfile-name ne ?
      240     then DO:
      241         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      242         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      243         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      244     end.
      245   on choose of B-WaitFramStop in frame waitfram
      246   do:
      247     mWaitFramStop = yes.
      248     mWaitFramStopUser = yes.
      249   end.
      250   function waitfram-check-timeout returns logical():
      251      define variable vtime as int64 no-undo.
      252      if mWaitFramStopTimeOut
      253      then
      254         return yes.
      255      vtime = ( now - mWaitFramStartProc ) / 1000 .
      256      if     mWaitFramTimeOut ne ?
      257         and mWaitFramTimeOut ne 0
      258         and mWaitFramTimeOut lt vtime
      259      then do:
      260         mWaitFramStopTimeOut = yes.
      261      end.
      262      return mWaitFramStopTimeOut.
      263   end.
      264   procedure waitfram-hide :
      265     if not session:batch-mode
      266     then do
      267     on error undo, return error return-value
      268     :
      269       pause 0 before-hide .
      270       if not mBatchMode then
      271         hide frame waitfram .
      272     if     not mWaitFramView
      273        and mWaitProcEvent
      274     then
      275       process events .
      276     end.
      277   end procedure.
      278   procedure waitfram-show :
      279     define input  parameter p-message as character no-undo .
      280     define variable v-left-margin as integer   no-undo .
      281     if not session:batch-mode
      282     then do
      283     on error undo, return error return-value
      284     :
      285       if length(p-message) <= 70 then do:
      286         assign
      287           v-left-margin = integer((70 - length(p-message)) / 2)
      288         .
      289         assign
      290           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      291         .
      292         assign
      293           v-waitfram-action01 = " "
      294           v-waitfram-action02 = " "
      295                                    + fill(" ", v-left-margin)
      296                                    + p-message
      297           v-waitfram-action03 = " "
      298         .
      299       end.
      300       else do:
      301         define variable vRindex1 as integer no-undo.
      302         define variable vRindex2 as integer no-undo.
      303         vRindex1 = r-index(p-message," ",70).
      304         if vRindex1 = 0
      305         then
      306            vRindex1 = 70.
      307         if length(p-message)  <= vRindex1 + 70 then do:
      308           assign
      309             v-waitfram-action01 = " "
      310             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      311             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      312           .
      313         end.
      314         else do:
      315           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      316           if vRindex2 <= vRindex1
      317           then
      318              vRindex2 = vRindex1 + 70.
      319           assign
      320             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      321             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      322             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      323           .
      324         end.
      325       end.
      326       B-viewProcInfo:visible   in frame waitfram = no.
      327       B-viewProcInfo:sensitive in frame waitfram = no.
      328       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      329       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      330       if  (   mWaitFramView
      331          or  mWaitProcEvent)
      332          and not mBatchMode
      333       then
      334          display
      335             v-waitfram-action01 skip
      336             v-waitfram-action02 skip
      337             v-waitfram-action03 skip
      338          with frame waitfram .
      339       if     mWaitFramView
      340          then do:
      341             if     mWaitFramInterval ne ?
      342                and not mBatchMode
      343             then
      344                wait-for go of frame waitfram pause mWaitFramInterval.
      345          end.
      346          else
      347             if     mWaitProcEvent
      348                and not mBatchMode
      349             then
      350                process events .
      351     end.
      352   end procedure.
      353      procedure waitfram-show-this:
      354         define input  parameter iInterval as int64 no-undo.
      355         define variable vtime as int64 no-undo.
      356         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      357         mWaitFramInterval = iInterval.
      358         run waitfram-show (substitute("&1&2 &3&4" ,
      359                                       mWaitFramTextBeg ,
      360                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      361                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      362                                       mWaitFramTextEnd
      363                                      )
      364                           ).
      365      end.
      366      procedure WaitFramRunPause:
      367         define input  parameter iInterval as dec no-undo.
      368         define variable vStart  as datetime-tz no-undo.
      369         define variable vend    as datetime-tz no-undo.
      370         define variable vint as int64 no-undo.
      371         define variable vOk as logical no-undo.
      372         vStart = now.
      373         vend   = vStart.
      374         publish "WaitFramPause" (iInterval,output vOk).
      375         vend   =  now.
      376         vint = vend - vStart.
      377         vint = iInterval - vint / 1000.
      378         if     not mWaitFramStop
      379            and (   vint > 0
      380                 or (    not vOk
      381                     and iInterval eq ?
      382                     )
      383                 )
      384         then
      385            run waitfram-show-this (iInterval).
      386         vend   =  now.
      387         vint = vend - vStart.
      388         vint = iInterval - vint / 1000.
      389         if     not mWaitFramStop
      390            and vint > 0
      391         then do:
      392            run gbl/pause.p (vint * 1000).
      393         end.
      394         if iInterval ne ?
      395         then
      396            publish "WaitFramStop".
      397         waitfram-check-timeout().
      398      end.
      399      procedure WaitFramWaitFor:
      400         define input  parameter iInterval as dec no-undo.
      401         assign
      402            mWaitFramStartProc   = now
      403            mWaitFramStopUser    = no
      404            mWaitFramStopTimeOut = no
      405         .
      406         block-wait:
      407         do while not mWaitFramStop:
      408            run WaitFramRunPause (iInterval).
      409            if  waitfram-check-timeout()
      410            then do:
      411               leave block-wait.
      412            end.
      413         end.
      414         run waitfram-hide.
      415      end.
      416   procedure waitfram-join :
      417     define input  parameter p-line-1  as character no-undo .
      418     define input  parameter p-line-2  as character no-undo .
      419     define input  parameter p-line-3  as character no-undo .
      420     define output parameter p-message as character no-undo .
      421     do
      422     on error undo, return error return-value
      423     :
      424       assign
      425         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      426                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      427                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      428       .
      429     end.
      430   end procedure.
      431   function waitfram-join-function returns character
      432     (input p-line-1 as character
      433     ,input p-line-2 as character
      434     ,input p-line-3 as character
      435     ).
      436     define variable v-message as character no-undo .
      437     run waitfram-join in this-procedure
      438       (input  p-line-1
      439       ,input  p-line-2
      440       ,input  p-line-3
      441       ,output v-message
      442       ) .
      443     return v-message .
      444   end function .
      445   function cross-list returns logical (
      446     input parfirst-stream  as character,
      447     input parsecond-stream as character,
      448     input pardelim         as character).
      449     if pardelim = ""
      450     or pardelim = ?
      451     then do:
      452       assign
      453         pardelim = ","
      454       .
      455     end.
      456     define variable vari            as integer no-undo .
      457     define variable varresult-cross as logical no-undo .
      458     assign
      459       varresult-cross = no
      460     .
      461     def var v-num-parfirst-stream as integer no-undo .
      462     assign
      463       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      464     .
      465     do vari = 1 to v-num-parfirst-stream
      466     :
      467       if lookup(entry(vari, parfirst-stream, pardelim)
      468                ,parsecond-stream
      469                ,pardelim
      470                ) > 0 then do:
      471         assign
      472           varresult-cross = yes
      473         .
      474         leave.
      475       end.
      476     end.
      477     return varresult-cross .
      478   end function.
      479   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   define new global shared variable g#attr-lib  as handle no-undo .
      481   define variable v-attr-lib-variable as handle no-undo .
      482   procedure clntattr-code :
      483     define input  parameter p-code           as character no-undo .
      484     define output parameter p-type           as character no-undo .
      485     define output parameter p-format         as character no-undo .
      486     define output parameter p-label          as character no-undo .
      487     define output parameter p-user-can-edit  as logical   no-undo .
      488     define output parameter p-output-display as logical   no-undo .
      489     define output parameter p-other          as character no-undo .
      490     do
      491     on error undo, return error return-value
      492     :
      493           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      494         (input  p-code
      495         ,output p-type
      496         ,output p-format
      497         ,output p-label
      498         ,output p-user-can-edit
      499         ,output p-output-display
      500         ,output p-other
      501         ) no-error .
      502       if error-status :error
      503       then do:
      504         undo, return error return-value .
