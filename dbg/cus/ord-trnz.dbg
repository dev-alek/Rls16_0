     1056   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1057   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1058   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1059   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1060   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1061   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1062   define input parameter table for tt-doc-line.
     1063   define input parameter table for tt-gds-dtl.
     1064   define input parameter table for tt-parts.
     1065   define input parameter paruse-parts       as   logical                no-undo.
     1066   define input parameter parall-qnty        as   logical                no-undo.
     1067   define input parameter parfix-price       as   logical                no-undo.
     1068   define buffer crt_trn-doc  for ub.trn-doc.
     1069   define buffer crt_goods    for ub.goods.
     1070   define buffer crt_doc-line for ub.doc-line.
     1071   define buffer crt_gds-dtl  for ub.gds-dtl.
     1072   define variable end-price    as   logical              no-undo.
     1073   define variable real-type    like ub.goods.gds-type    no-undo.
     1074   define variable legal-node   like ub.gds-prt.node-code no-undo.
