      761   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   function octal-to-char return character
      763   ( p-string as character ) :
      764     def var v-asc     as integer no-undo .
      765     def var v-new-asc as integer no-undo .
      766     def var ind       as integer no-undo .
      767     if length(p-string) <> 3 then do:
      768       return ? .
      769     end.
      770     assign
      771       v-asc = 0
      772     .
      773     do ind = 1 to length(p-string)
      774     :
      775       assign
      776         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      777       .
      778       if v-new-asc < 0 or v-new-asc >= 8 then do:
      779         return ? .
      780       end.
      781       assign
      782         v-asc = v-asc * 8 + v-new-asc
      783       .
      784     end.
      785     return chr(v-asc) .
      786   end function .
      787   function char-to-octal return character
      788   ( p-chr as character ) :
      789     def var v-asc    as integer   no-undo .
      790     def var ind      as integer   no-undo .
      791     def var v-string as character no-undo .
      792     if length(p-chr) <> 1 then do:
      793       return ? .
      794     end.
      795     assign
      796       v-asc    = asc(p-chr)
      797       v-string = ""
      798     .
      799     do ind = 1 to 3
      800     :
      801       assign
      802         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      803       .
      804       assign
      805         v-asc = truncate(v-asc / 8, 0)
      806       .
      807     end.
      808     return v-string .
      809   end.
      810   function str-encode return character
      811   (   p-init-string       as character
      812     , p-encode-char       as character
      813     , p-special-char-list as character
      814   ) :
      815     def var p-encode-string as character no-undo .
      816     def var ind                as integer no-undo .
      817     def var v-num-special-char as integer no-undo .
      818     def var v-special-char     as character no-undo .
      819     if p-encode-char = ?
      820     or p-encode-char = "" then do:
      821       assign
      822         p-encode-char = "~~"
      823       .
      824     end.
      825     if p-init-string = ? then do:
      826       return "?" .
      827     end.
      828     if p-init-string = "?" then do:
      829       return p-encode-char + char-to-octal("?") .
      830     end.
      831     assign
      832       v-num-special-char = length(p-special-char-list)
      833       p-encode-string    = replace(p-init-string
      834                                   ,p-encode-char
      835                                   ,p-encode-char + char-to-octal(p-encode-char)
      836                                   )
      837     .
      838     do ind = 1 to v-num-special-char
      839     :
      840       assign
      841         v-special-char = substring(p-special-char-list, ind, 1)
      842       .
      843       if v-special-char <> p-encode-char then do:
      844         assign
      845           p-encode-string = replace (p-encode-string
      846                                     ,v-special-char
      847                                     ,p-encode-char + char-to-octal(v-special-char)
      848                                     )
      849         .
      850       end.
      851     end.
      852     return p-encode-string .
      853   end.
      854   function str-decode returns character
      855     (p-init-string   as character
      856     ,p-encode-char   as character
      857     ) :
      858     def var p-decode-string as character no-undo .
      859     def var ind                       as integer no-undo .
      860     def var v-num-entries-init-string as integer no-undo .
      861     def var v-sub-phrase              as character no-undo .
      862     def var v-special-char            as character no-undo .
      863     if p-encode-char = ?
      864     or p-encode-char = "" then do:
      865       assign
      866         p-encode-char = "~~"
      867       .
      868     end.
      869     if p-init-string = "?" then do:
      870       return ? .
      871     end.
      872     assign
      873       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      874     .
      875     if v-num-entries-init-string > 1 then do:
      876       assign
      877         p-decode-string = entry(1, p-init-string, p-encode-char)
      878       .
      879       do ind = 2 to v-num-entries-init-string
      880       :
      881         assign
      882           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      883         .
      884         assign
      885           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      886         .
      887         if v-special-char <> ? then do:
      888           assign
      889             p-decode-string = p-decode-string
      890                             + v-special-char
      891                             + substring(v-sub-phrase, 4)
      892           .
      893         end.
      894         else do:
      895           assign
      896             p-decode-string = p-decode-string
      897                             + p-encode-char
      898                             + v-sub-phrase
      899           .
      900         end.
      901       end.
      902     end.
      903     else do:
      904       assign
      905         p-decode-string = p-init-string
      906       .
      907     end.
      908     return p-decode-string .
      909   end.
      910   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      912   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      913     field cst-code                like ub.trn-doc.cst-code
      914     field part-code               like ub.parts.part-code
      915     .
      916   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      917   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      918   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      919   function hvrdtax return logical (input parrecid as recid):
      920   define variable varresult as logical no-undo.
      921   run hvrdtax-proc (input parrecid, output varresult).
      922   return varresult.
      923   end function.
      924   procedure hvrdtax-proc:
      925   define input  parameter parrecid  as recid   no-undo.
      926   define output parameter parresult as logical no-undo.
      927   define buffer bf_goods for ub.goods.
      928   define buffer bf_units for ub.units.
      929   define buffer rt_tax   for ub.tax.
      930   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      931   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      932   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      933   if available rt_tax and
      934       can-find(first ub.tax-units No-LOCK WHERE
      935                      ub.tax-units.tax-code = rt_tax.tax-code AND
      936                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      937                                                       else assign parresult = no.
      938   end procedure.
      939   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940   define new global shared variable g#lib-calc as handle no-undo .
      941   procedure plgdsfnd :
      942     define input  parameter p-chk-and-chs    as logical               no-undo .
      943     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      944     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      945     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      946     define output parameter p-reserv-pl-code as   logical             no-undo .
      947     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      948     define buffer buf_goods         for ub.goods .
      949     define buffer buf_pl-gds        for ub.pl-gds .
      950     define buffer buf_second_pl-gds for ub.pl-gds .
      951     find first buf_goods no-lock where
      952                buf_goods.gds-code = p-gds-code no-error .
      953     if not available buf_goods
      954     then do:
      955       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      956     end.
      957   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      959     (input  p-obj-type
      960     ,input  p-obj-code
      961     ,input  buf_goods.artic
      962     ,input  buf_goods.prod-type
      963     ,input  buf_goods.prod-code
      964     ,input  'place-rsrv=request'
      965     ,output p-reserv-pl-code
      966     ) no-error .
      967     if error-status :error
      968     then do:
      969       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      970     end.
      971     if p-reserv-pl-code = no
      972     then do:
      973       return .
      974     end.
      975     if p-chk-and-chs <> yes
      976     then do:
      977       return .
      978     end.
      979     find first buf_pl-gds no-lock where
      980                buf_pl-gds.obj-type = p-obj-type and
      981                buf_pl-gds.obj-code = p-obj-code and
      982                buf_pl-gds.gds-code = p-gds-code no-error .
      983     if not available buf_pl-gds
      984     then do:
      985       return error "К товару не привязано ни одного места хранения" .
      986     end.
      987     find first buf_second_pl-gds no-lock where
      988                buf_second_pl-gds.obj-type  = p-obj-type          and
      989                buf_second_pl-gds.obj-code  = p-obj-code          and
      990                buf_second_pl-gds.gds-code  = p-gds-code          and
      991                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      992     if not available buf_second_pl-gds
      993     then do:
      994       assign
      995         p-pl-code = buf_pl-gds.pl-code
      996       .
      997     end.
      998     else do:
      999       if not valid-handle( parparentproc )
     1000       then do:
     1001         return error "Не выбрано место хранения " + chr(10) .
     1002       end.
     1003       run str/plgdssel.p
     1004         (
     1005            input parparentproc
     1006         ,  input p-obj-type
     1007         ,  input p-obj-code
     1008         ,  input p-gds-code
     1009         , output p-pl-code
     1010         ) no-error .
     1011       if error-status :error
     1012       then do:
     1013         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1014                                , 'plgdssel.p':U
     1015                                , chr(10)
     1016                                , error-status :get-message( 1 )
     1017                                , return-value
     1018                                ) .
     1019       end.
     1020       if p-pl-code = ? or
     1021          p-pl-code = 0
     1022       then do:
     1023         return error "Не выбрано место хранения " + chr(10) .
     1024       end.
     1025     end.
     1026   end procedure.
     1027   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
