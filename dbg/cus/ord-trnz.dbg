     1079   define variable mem-qnty like chg-qnty no-undo.
     1080   define variable dflt-cd as character no-undo .
     1081   c-l:
     1082   do on error undo, return error return-value :
     1083   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1084   assign
     1085       paruse-parts = false
     1086       .
     1087   assign
     1088     end-price = no.
     1089   if parinp-discnt-type = yes and
     1090      parinp-discnt-pc   = 0   and
     1091      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1092      then do:
     1093     assign
     1094       crt_trn-doc.tot-calc    = partot-calc
     1095       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1096       crt_trn-doc.discnt-type = pardiscnt-type.
     1097   end.
     1098   if parinp-agnt = ? then do:
     1099     assign
     1100       crt_trn-doc.agnt = paragnt.
     1101   end.
     1102   if parinp-boss = ? then do:
     1103     assign
     1104       crt_trn-doc.boss = parboss.
     1105   end.
     1106   if parinp-wrkr = ? then do:
     1107     assign
     1108       crt_trn-doc.wrkr = parwrkr.
     1109   end.
     1110   if parinp-base-rate  = ? then do:
     1111     assign
     1112       crt_trn-doc.base-rate  = parbase-rate.
     1113   end.
     1114   if parinp-base-scale = ? then do:
     1115     assign
     1116       crt_trn-doc.base-scale = parbase-scale.
     1117   end.
     1118   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1119   if available tt-doc-line then do:
     1120     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1121                      and crt_goods.prod-type = tt-doc-line.prod-type
     1122                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1123     if crt_goods.gds-type = 'у':U and
     1124        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1125       return error "В данный документ нельзя копировать услуги.".
     1126     end.
     1127     assign
     1128       real-type = crt_goods.gds-type.
     1129     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1130     if available crt_doc-line then do:
     1131       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1132                        and crt_goods.prod-type = crt_doc-line.prod-type
     1133                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1134       if crt_goods.gds-type <> real-type then do:
     1135         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1136       end.
     1137     end.
     1138     else do:
     1139       assign
     1140         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1141     end.
     1142   end.
     1143   r-l:
     1144   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1145     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1146                      and crt_goods.prod-type = tt-doc-line.prod-type
     1147                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1148   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1149      (
     1150       input crt_trn-doc.doc-code
     1151      ,input crt_trn-doc.obj-type
     1152      ,input crt_trn-doc.obj-code
     1153      ,input crt_goods.artic
     1154      ,input crt_goods.prod-type
     1155      ,input crt_goods.prod-code
     1156      ,input crt_goods.gds-name
     1157      ,input crt_goods.prt-root
     1158      ,input ?
     1159      ,input ?
     1160      ,input parcash-pay      ) no-error.
     1161     if error-status:error then do:
     1162       undo c-l, return error return-value.
     1163     end.
     1164     if return-value = "next" then do:
     1165       next r-l.
     1166     end.
     1167     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1168                                   crt_doc-line.artic     = crt_goods.artic      and
     1169                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1170                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1171     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1172                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1173                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1174                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1175                               break by tt-gds-dtl.artic
     1176                                     by tt-gds-dtl.prod-type
     1177                                     by tt-gds-dtl.prod-code
     1178                               :
     1179   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1180     ( input  tt-gds-dtl.artic
     1181      ,input  tt-gds-dtl.prod-type
     1182      ,input  tt-gds-dtl.prod-code
     1183      ,input  tt-gds-dtl.prt-code
     1184      ,input  tt-doc-line.obj-type
     1185      ,input  tt-doc-line.obj-code
     1186      ,output legal-node
     1187     ) no-error .
     1188       if error-status:error then do:
     1189          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1190       end.
     1191   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1192     ( input crt_trn-doc.obj-code
     1193      ,input crt_trn-doc.obj-type
     1194      ,input crt_trn-doc.doc-code
     1195      ,input crt_goods.artic
     1196      ,input crt_goods.prod-code
     1197      ,input crt_goods.prod-type
     1198      ,input legal-node
     1199      ,input yes
     1200     ) no-error .
     1201        if error-status:error then do:
     1202           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1203        end.
     1204        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1205                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1206                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1207                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1208                                     crt_gds-dtl.prt-code  = legal-node.
     1209       assign
     1210         crt_gds-dtl.ov             = parfix-price
     1211         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1212         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1213         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1214         .
     1215       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1216         assign
     1217           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1218           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1219           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1220           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1221       end.
     1222       if end-price then do:
     1223         assign
     1224           crt_gds-dtl.ov             = yes
     1225           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1226           crt_gds-dtl.discnt-base    = 0
     1227           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1228           crt_gds-dtl.discnt-rubl    = 0
     1229           crt_gds-dtl.discnt-pc      = 0
     1230           crt_gds-dtl.discnt-type    = yes.
     1231       end.
     1232   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1233   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1234     ( input recid(crt_gds-dtl)
     1235     , input no
     1236     , input ?
     1237     ) no-error.
     1238           if error-status:error then do:
     1239             undo c-l, return error return-value.
     1240           end.
     1241       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1242          crt_gds-dtl.ov then do:
     1243         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1244       end.
     1245       if paruse-parts then do:
     1246          if first-of (tt-gds-dtl.prod-code) then do:
     1247            for each tt-parts :
     1248              assign
     1249                chg-qnty = tt-parts.fact-qnty
     1250                mem-qnty = chg-qnty.
     1251              assign
     1252              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1253              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1254            end.
     1255            assign
     1256              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1257              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1258            assign
     1259              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1260              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1261            if crt_gds-dtl.doc-qnty = 0 then do:
     1262              delete crt_gds-dtl.
     1263            end.
     1264          end.
     1265       end.
     1266       else do:
     1267         assign
     1268           chg-qnty = tt-gds-dtl.fact-qnty
     1269           mem-qnty = chg-qnty.
     1270         assign
     1271           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1272           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1273           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1274           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1275         assign
     1276         varchg-qnty  = varchg-qnty  + chg-qnty
     1277         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1278         if crt_gds-dtl.doc-qnty = 0 then do:
     1279           delete crt_gds-dtl.
     1280         end.
     1281       end.
     1282     end.
     1283     if crt_doc-line.doc-qnty = 0 then do:
     1284       delete crt_doc-line.
     1285     end.
     1286   end.
     1287   end.
     1288   end procedure.
     1289   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1290   procedure create-chain :
     1291   define input  parameter p-doc-code as character no-undo .
     1292   define input  parameter p-doc-type as character no-undo .
     1293   define input  parameter p-rel-doc-code as character no-undo .
     1294   define input  parameter p-rel-doc-type as character no-undo .
     1295   define input  parameter p-type as character no-undo .
     1296   define input  parameter p-ps as character no-undo .
     1297   define variable v-db-num as integer   no-undo .
     1298     do
     1299     on error undo, return error return-value
     1300     :
     1301     find first ub.sys-ctrl no-lock .
     1302     v-db-num = ub.sys-ctrl.db-num .
     1303     find first ub.ord-chain no-lock where
     1304       ub.ord-chain.doc-code     = p-doc-code     and
     1305       ub.ord-chain.doc-type     = p-doc-type     and
     1306       ub.ord-chain.rel-type     = p-type         and
     1307       ub.ord-chain.rel-doc-code = p-rel-doc-code and
     1308       ub.ord-chain.rel-doc-type = p-rel-doc-type   no-error .
     1309     if available ub.ord-chain then return .
     1310     create ub.ord-chain.
     1311     assign
     1312       ub.ord-chain.doc-code     = p-doc-code
     1313       ub.ord-chain.doc-type     = p-doc-type
     1314       ub.ord-chain.ps           = p-ps
