     1023     .
     1024   define new global shared variable mBatchMode as logical no-undo init ?.
     1025   define variable mFramBachModHandle as handle no-undo.
     1026   mFramBachModHandle = frame waitfram:handle.
     1027   define variable mFameOldVis as logical no-undo.
     1028   define variable mVisCUrentVin as logical no-undo.
     1029   if session:batch-mode
     1030   then
     1031      mBatchMode = yes.
     1032   if mBatchMode = ? then do:
     1033     mVisCUrentVin = current-window:visible.
     1034     mFameOldVis = mFramBachModHandle:visible.
     1035     mFramBachModHandle:visible  = yes.
     1036     mBatchMode = mFramBachModHandle:visible ne yes.
     1037     mFramBachModHandle:visible = mFameOldVis.
     1038     current-window:visible = mVisCUrentVin.
     1039   end.
     1040    if  log-manager:logfile-name ne ?
     1041     then DO:
     1042         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1043         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1044         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1045     end.
     1046   on choose of B-WaitFramStop in frame waitfram
     1047   do:
     1048     mWaitFramStop = yes.
     1049     mWaitFramStopUser = yes.
     1050   end.
     1051   function waitfram-check-timeout returns logical():
     1052      define variable vtime as int64 no-undo.
     1053      if mWaitFramStopTimeOut
     1054      then
     1055         return yes.
     1056      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1057      if     mWaitFramTimeOut ne ?
     1058         and mWaitFramTimeOut ne 0
     1059         and mWaitFramTimeOut lt vtime
     1060      then do:
     1061         mWaitFramStopTimeOut = yes.
     1062      end.
     1063      return mWaitFramStopTimeOut.
     1064   end.
     1065   procedure waitfram-hide :
     1066     if not session:batch-mode
     1067     then do
     1068     on error undo, return error return-value
     1069     :
     1070       pause 0 before-hide .
     1071       if not mBatchMode then
     1072         hide frame waitfram .
     1073     if     not mWaitFramView
     1074        and mWaitProcEvent
     1075     then
     1076       process events .
     1077     end.
     1078   end procedure.
     1079   procedure waitfram-show :
     1080     define input  parameter p-message as character no-undo .
     1081     define variable v-left-margin as integer   no-undo .
     1082     if not session:batch-mode
     1083     then do
     1084     on error undo, return error return-value
     1085     :
     1086       if length(p-message) <= 70 then do:
     1087         assign
     1088           v-left-margin = integer((70 - length(p-message)) / 2)
     1089         .
     1090         assign
     1091           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1092         .
     1093         assign
     1094           v-waitfram-action01 = " "
     1095           v-waitfram-action02 = " "
     1096                                    + fill(" ", v-left-margin)
     1097                                    + p-message
     1098           v-waitfram-action03 = " "
     1099         .
     1100       end.
     1101       else do:
     1102         define variable vRindex1 as integer no-undo.
     1103         define variable vRindex2 as integer no-undo.
     1104         vRindex1 = r-index(p-message," ",70).
     1105         if vRindex1 = 0
     1106         then
     1107            vRindex1 = 70.
     1108         if length(p-message)  <= vRindex1 + 70 then do:
     1109           assign
     1110             v-waitfram-action01 = " "
     1111             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1112             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1113           .
     1114         end.
     1115         else do:
     1116           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1117           if vRindex2 <= vRindex1
     1118           then
     1119              vRindex2 = vRindex1 + 70.
     1120           assign
     1121             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1122             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1123             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1124           .
     1125         end.
     1126       end.
     1127       B-viewProcInfo:visible   in frame waitfram = no.
     1128       B-viewProcInfo:sensitive in frame waitfram = no.
     1129       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1130       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1131       if  (   mWaitFramView
     1132          or  mWaitProcEvent)
     1133          and not mBatchMode
     1134       then
     1135          display
     1136             v-waitfram-action01 skip
     1137             v-waitfram-action02 skip
     1138             v-waitfram-action03 skip
     1139          with frame waitfram .
     1140       if     mWaitFramView
     1141          then do:
     1142             if     mWaitFramInterval ne ?
     1143                and not mBatchMode
     1144             then
     1145                wait-for go of frame waitfram pause mWaitFramInterval.
     1146          end.
     1147          else
     1148             if     mWaitProcEvent
     1149                and not mBatchMode
     1150             then
     1151                process events .
     1152     end.
     1153   end procedure.
     1154      procedure waitfram-show-this:
     1155         define input  parameter iInterval as int64 no-undo.
     1156         define variable vtime as int64 no-undo.
     1157         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1158         mWaitFramInterval = iInterval.
     1159         run waitfram-show (substitute("&1&2 &3&4" ,
     1160                                       mWaitFramTextBeg ,
     1161                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1162                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1163                                       mWaitFramTextEnd
     1164                                      )
     1165                           ).
     1166      end.
     1167      procedure WaitFramRunPause:
     1168         define input  parameter iInterval as dec no-undo.
     1169         define variable vStart  as datetime-tz no-undo.
     1170         define variable vend    as datetime-tz no-undo.
     1171         define variable vint as int64 no-undo.
     1172         define variable vOk as logical no-undo.
     1173         vStart = now.
     1174         vend   = vStart.
     1175         publish "WaitFramPause" (iInterval,output vOk).
     1176         vend   =  now.
     1177         vint = vend - vStart.
     1178         vint = iInterval - vint / 1000.
     1179         if     not mWaitFramStop
     1180            and (   vint > 0
     1181                 or (    not vOk
     1182                     and iInterval eq ?
     1183                     )
     1184                 )
     1185         then
     1186            run waitfram-show-this (iInterval).
     1187         vend   =  now.
     1188         vint = vend - vStart.
     1189         vint = iInterval - vint / 1000.
     1190         if     not mWaitFramStop
     1191            and vint > 0
     1192         then do:
     1193            run gbl/pause.p (vint * 1000).
     1194         end.
     1195         if iInterval ne ?
     1196         then
     1197            publish "WaitFramStop".
     1198         waitfram-check-timeout().
     1199      end.
     1200      procedure WaitFramWaitFor:
     1201         define input  parameter iInterval as dec no-undo.
     1202         assign
     1203            mWaitFramStartProc   = now
     1204            mWaitFramStopUser    = no
     1205            mWaitFramStopTimeOut = no
     1206         .
     1207         block-wait:
     1208         do while not mWaitFramStop:
     1209            run WaitFramRunPause (iInterval).
     1210            if  waitfram-check-timeout()
     1211            then do:
     1212               leave block-wait.
     1213            end.
     1214         end.
     1215         run waitfram-hide.
     1216      end.
     1217   procedure waitfram-join :
     1218     define input  parameter p-line-1  as character no-undo .
     1219     define input  parameter p-line-2  as character no-undo .
     1220     define input  parameter p-line-3  as character no-undo .
     1221     define output parameter p-message as character no-undo .
     1222     do
     1223     on error undo, return error return-value
     1224     :
     1225       assign
     1226         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1227                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1228                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1229       .
     1230     end.
     1231   end procedure.
     1232   function waitfram-join-function returns character
     1233     (input p-line-1 as character
     1234     ,input p-line-2 as character
     1235     ,input p-line-3 as character
     1236     ).
     1237     define variable v-message as character no-undo .
     1238     run waitfram-join in this-procedure
     1239       (input  p-line-1
     1240       ,input  p-line-2
     1241       ,input  p-line-3
     1242       ,output v-message
     1243       ) .
     1244     return v-message .
     1245   end function .
