     1552     "11"  + chr(44) +
     1553     "20"  + chr(44) +
     1554     "9"  + chr(44) +
     1555     "20"  + chr(44) +
     1556     "10"  + chr(44) +
     1557     "11"  + chr(44) +
     1558     "15"  + chr(44) +
     1559     "15"  + chr(44) +
     1560     "15"  + chr(44) +
     1561     "15"  + chr(44) +
     1562     "18"
     1563     str2 = " "
     1564     Sheetf.colformat = "1=@;4=@" + chr(4) + '':U + chr(4) + 'Оборот по обслуживанию по датам'
     1565     .
     1566   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1567    PUT STREAM PrnLibStream UNFORMATTED
     1568   "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip "      Дата       :   Смена   :        Чек         :№ карты :   Товар/ услуга    :  Кол-во  :   Цена    :Стоимость на ТО:   Оплачено    :   Оплачено    :  Начислено    :    Оператор      " skip "                 :           :                    :        :                    :          :           :               :  наличными    :   бонусами    :   бонусов     :                  " skip "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------".
     1569     run rep/extitle.p ( input 3) .
     1570     run cus/r-bon1-2.p ( input parparentproc
     1571                    , input p-schema-code
     1572                    , input p-cdpay-code
     1573                    , input p-curr-code
     1574                    , input 3
     1575                    ) no-error.
     1576   end.
     1577   if Make-Excel then output stream ForExcel close.
     1578   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1579   Output stream PrnLibStream close.
     1580   run waitfram-hide in this-procedure .
     1581   run prn-lib-prn-file in this-procedure (
     1582                                             input parParentProc
     1583                                             ,input 8
     1584                                             ).
     1585   procedure first-line :
     1586   define input parameter  vartog as integer no-undo .
     1587   PUT STREAM PrnLibStream UNFORMATTED skip.
     1588   End procedure.
     1589   procedure prepare-table :
     1590   define variable kk as integer no-undo .
     1591   DEFINE VARIABLE JJ as integer No-UNDO.
     1592   DEFINE VARIABLE JJP as integer No-UNDO.
     1593   DEFINE VARIABLE JJO as integer No-UNDO.
     1594   DEFINE VARIABLE pay-sum as decimal No-UNDO.
     1595   DEFINE VARIABLE dop-sump as decimal No-UNDO.
     1596   DEFINE VARIABLE dop-sumg as decimal No-UNDO.
     1597   DEFINE VARIABLE dop-sumk as decimal No-UNDO.
     1598   DEFINE VARIABLE v-line-num as integer no-undo .
     1599   define variable v-curr-r-b as character no-undo .
     1600   define variable v-base-code like ub.sysconf.base-code no-undo .
     1601   define variable v-curr-code like ub.currency.curr-code no-undo init ?.
     1602   define variable v-one-curr-code as logical no-undo .
     1603   define variable v-host-code as integer no-undo .
     1604   define buffer buf_temp-bon1 for temp-bon1.
     1605   define buffer buf_inkas for ub.inkas.
     1606   define buffer buf_chk-doc for ub.chk-doc.
     1607   define buffer buf_chk-gds for ub.chk-gds.
     1608   define buffer buf_chk-discnt for ub.chk-discnt .
     1609   define buffer buf_bar-code for ub.bar-code.
     1610   define buffer buf_goods for ub.goods.
     1611   define buffer buf_temp-bon1-gds for temp-bon1-gds.
     1612   define buffer obj-grp-op_temp-bon1 for temp-bon1.
     1613   define buffer obj-grp_temp-bon1 for temp-bon1.
     1614   define buffer obj-op_temp-bon1 for temp-bon1.
     1615   define buffer obj_temp-bon1 for temp-bon1.
     1616   define buffer buf0_chk-pay for ub.chk-pay.
     1617   define buffer buf_chk-pay for ub.chk-pay.
     1618   define buffer buf_cash-pay for ub.cash-pay.
     1619   DEFINE BUFFER buf_treal-3 for treal-3.
     1620   define buffer b3-treal-3 for treal-3.
     1621     do
     1622     on error undo, return error return-value
     1623     :
     1624       for each treal-3:
     1625         delete treal-3.
     1626       end.
     1627       for each temp-bon1:
     1628         delete temp-bon1.
     1629       end.
     1630   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1632     (output v-curr-r-b
     1633     )  .
     1634       for each obj-list no-lock,
     1635          each buf_inkas no-lock where
     1636             buf_inkas.obj-type = obj-list.obj-type
     1637         and buf_inkas.obj-code = obj-list.obj-code
     1638         and buf_inkas.shift-date >= X-date-start
     1639         and buf_inkas.shift-date <= X-date-end:
     1640          _discnt:
     1641         for each buf_chk-discnt no-lock where
     1642               buf_chk-discnt.obj-type = obj-list.obj-type
     1643           and buf_chk-discnt.obj-code = obj-list.obj-code
     1644           and buf_chk-discnt.out-code = buf_inkas.inkas-code
     1645           and buf_chk-discnt.record-type = 5,
     1646           first buf_chk-doc no-lock where
     1647                 buf_chk-doc.doc-code = buf_chk-discnt.doc-code:
     1648           if p-schema-code > 0
     1649           and buf_chk-discnt.discnt-type <> p-schema-code then next _discnt.
     1650           create buf_temp-bon1.
     1651           assign
     1652           buf_temp-bon1.obj-type = obj-list.obj-type
     1653           buf_temp-bon1.obj-code = obj-list.obj-code
     1654           buf_temp-bon1.chk-date = buf_chk-doc.chk-date
     1655           buf_temp-bon1.chk-time = buf_chk-doc.chk-time
     1656           buf_temp-bon1.doc-code = buf_chk-doc.doc-code
     1657           buf_temp-bon1.line-num = buf_chk-discnt.line-num
     1658           buf_temp-bon1.discnt-id = buf_chk-discnt.discnt-id
     1659           buf_temp-bon1.object-line-num = buf_chk-discnt.object-line-num
     1660           buf_temp-bon1.shift-date = buf_chk-doc.shift-date
     1661           buf_temp-bon1.shift-num = buf_chk-doc.shift-num
     1662           buf_temp-bon1.d-card = buf_chk-discnt.d-card
     1663           buf_temp-bon1.op-code = 2
     1664           buf_temp-bon1.discnt-value-abs = buf_chk-discnt.discnt-value-abs
     1665           buf_temp-bon1.cashier-psn-code = buf_chk-doc.cashier-psn-code
     1666           buf_temp-bon1.level = 0
     1667           .
     1668           find first buf_chk-gds no-lock where
     1669                     buf_chk-gds.doc-code = buf_chk-discnt.doc-code
     1670                 and buf_chk-gds.line-num = buf_chk-discnt.object-line-num no-error.
     1671           if available buf_chk-gds then do:
     1672             assign
     1673             buf_temp-bon1.item-type =(if buf_chk-gds.pump > 0 then 1 else 2)
     1674             buf_temp-bon1.src-qnty = buf_chk-gds.src-qnty
     1675             buf_temp-bon1.src-price = buf_chk-gds.src-price
     1676             buf_temp-bon1.src-sum  = buf_chk-gds.src-price * buf_chk-gds.src-qnty
     1677             buf_temp-bon1.pay-sum  = (buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty
     1678             .
     1679           end.
     1680           else do:
     1681             assign
     1682             buf_temp-bon1.src-qnty = buf_chk-discnt.object-qnty
     1683             buf_temp-bon1.pay-sum = buf_chk-discnt.object-sum
     1684             buf_temp-bon1.src-sum = buf_chk-discnt.object-sum
     1685             buf_temp-bon1.src-price = buf_chk-discnt.object-sum / buf_chk-gds.src-qnty
     1686             .
     1687           end.
     1688           find first buf_bar-code no-lock where
     1689                     buf_bar-code.b-code = buf_chk-gds.b-code no-error.
     1690           if available buf_bar-code then do:
     1691             assign
     1692             buf_temp-bon1.gds-code = buf_bar-code.gds-code.
     1693             if buf_temp-bon1.item-type = 1 then do:
     1694               find first buf_temp-bon1-gds no-lock where
     1695                       buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code no-error.
     1696               if not available buf_temp-bon1-gds then do:
     1697                 find first buf_goods no-lock where
     1698                           buf_goods.gds-code = buf_temp-bon1.gds-code no-error.
     1699                 create buf_temp-bon1-gds.
     1700                 assign
     1701                 buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code
     1702                 buf_temp-bon1-gds.gds-name = (if available buf_goods
     1703                                                then buf_goods.gds-name
     1704                                                else substitute("Неизвестное топливо &1", buf_temp-bon1.gds-code))
     1705                 buf_temp-bon1.item-name = buf_temp-bon1-gds.gds-name
     1706                 .
     1707               end.
     1708               else do:
     1709                 assign
     1710                 buf_temp-bon1.item-name = buf_temp-bon1-gds.gds-name
     1711                 .
     1712               end.
     1713             end .
     1714           end.
     1715           if buf_temp-bon1.item-type = 2 then do:
     1716             assign
     1717             buf_temp-bon1.item-name = "Соп. товары"
     1718             .
     1719           end.
     1720           find first obj-grp-op_temp-bon1 where
     1721                     obj-grp-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1722                 and obj-grp-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1723                 and obj-grp-op_temp-bon1.item-name = buf_temp-bon1.item-name
     1724                 and obj-grp-op_temp-bon1.item-type = buf_temp-bon1.item-type
     1725                 and obj-grp-op_temp-bon1.gds-code = -1
     1726                 and obj-grp-op_temp-bon1.op-code = buf_temp-bon1.op-code no-error.
     1727           if not available obj-grp-op_temp-bon1  then do:
     1728             create obj-grp-op_temp-bon1 .
     1729             assign
     1730             obj-grp-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1731             obj-grp-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1732             obj-grp-op_temp-bon1.item-name = buf_temp-bon1.item-name
     1733             obj-grp-op_temp-bon1.item-type = buf_temp-bon1.item-type
     1734             obj-grp-op_temp-bon1.gds-code = -1
     1735             obj-grp-op_temp-bon1.op-code = buf_temp-bon1.op-code
     1736             obj-grp-op_temp-bon1.level = 2
     1737             .
     1738           end.
     1739           assign
     1740           obj-grp-op_temp-bon1.src-qnty = obj-grp-op_temp-bon1.src-qnty + buf_chk-discnt.object-qnty
     1741           obj-grp-op_temp-bon1.pay-sum = obj-grp-op_temp-bon1.pay-sum + buf_chk-discnt.object-sum
     1742           obj-grp-op_temp-bon1.src-sum = obj-grp-op_temp-bon1.src-sum + buf_chk-discnt.object-sum
     1743           obj-grp-op_temp-bon1.discnt-value-abs = obj-grp-op_temp-bon1.discnt-value-abs + buf_chk-discnt.discnt-value-abs
     1744           .
     1745           find first obj-grp_temp-bon1 where
     1746                     obj-grp_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1747                 and obj-grp_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1748                 and obj-grp_temp-bon1.item-name = buf_temp-bon1.item-name
     1749                 and obj-grp_temp-bon1.item-type = buf_temp-bon1.item-type
     1750                 and obj-grp_temp-bon1.gds-code = -1
     1751                 and obj-grp_temp-bon1.op-code = 0 no-error.
     1752           if not available obj-grp_temp-bon1  then do:
     1753             create obj-grp_temp-bon1 .
     1754             assign
     1755             obj-grp_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1756             obj-grp_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1757             obj-grp_temp-bon1.item-name = buf_temp-bon1.item-name
     1758             obj-grp_temp-bon1.item-type = buf_temp-bon1.item-type
     1759             obj-grp_temp-bon1.gds-code = -1
     1760             obj-grp_temp-bon1.op-code = 0
     1761             obj-grp_temp-bon1.level = 3
     1762             .
     1763           end.
     1764           assign
     1765           obj-grp_temp-bon1.src-qnty = obj-grp_temp-bon1.src-qnty + buf_chk-discnt.object-qnty
     1766           obj-grp_temp-bon1.pay-sum = obj-grp_temp-bon1.pay-sum + buf_chk-discnt.object-sum
     1767           obj-grp_temp-bon1.src-sum = obj-grp_temp-bon1.src-sum + buf_chk-discnt.object-sum
     1768           obj-grp_temp-bon1.discnt-value-abs = obj-grp_temp-bon1.discnt-value-abs + buf_chk-discnt.discnt-value-abs
     1769           .
     1770           find first obj-op_temp-bon1 where
     1771                     obj-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1772                 and obj-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1773                 and obj-op_temp-bon1.item-type = 0
     1774                 and obj-op_temp-bon1.item-name = '':U
     1775                 and obj-op_temp-bon1.gds-code = -1
     1776                 and obj-op_temp-bon1.op-code = buf_temp-bon1.op-code no-error.
     1777           if not available obj-op_temp-bon1  then do:
     1778             create obj-op_temp-bon1 .
     1779             assign
     1780             obj-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1781             obj-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1782             obj-op_temp-bon1.item-name = '':U
     1783             obj-op_temp-bon1.item-type = 0
     1784             obj-op_temp-bon1.gds-code = -1
     1785             obj-op_temp-bon1.op-code = buf_temp-bon1.op-code
     1786             obj-op_temp-bon1.level = 4
     1787             .
     1788           end.
     1789           assign
     1790           obj-op_temp-bon1.src-qnty = obj-op_temp-bon1.src-qnty + buf_chk-discnt.object-qnty
     1791           obj-op_temp-bon1.pay-sum = obj-op_temp-bon1.pay-sum + buf_chk-discnt.object-sum
     1792           obj-op_temp-bon1.src-sum = obj-op_temp-bon1.src-sum + buf_chk-discnt.discnt-value-abs
     1793           .
     1794           find first obj_temp-bon1 where
     1795                     obj_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1796                 and obj_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1797                 and obj_temp-bon1.item-name = '':U
     1798                 and obj_temp-bon1.item-type = 0
     1799                 and obj_temp-bon1.gds-code = -1
     1800                 and obj_temp-bon1.op-code = 0 no-error.
     1801           if not available obj_temp-bon1  then do:
     1802             create obj_temp-bon1 .
     1803             assign
     1804             obj_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1805             obj_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1806             obj_temp-bon1.item-name = '':U
     1807             obj_temp-bon1.item-type = 0
     1808             obj_temp-bon1.gds-code = -1
     1809             obj_temp-bon1.op-code = 0
     1810             obj_temp-bon1.level = 5
     1811             .
     1812           end.
     1813           assign
     1814           obj_temp-bon1.src-qnty = obj_temp-bon1.src-qnty + buf_chk-discnt.object-qnty
     1815           obj_temp-bon1.pay-sum = obj_temp-bon1.pay-sum + buf_chk-discnt.object-sum
     1816           obj_temp-bon1.src-sum = obj_temp-bon1.src-sum + buf_chk-discnt.object-sum
     1817           obj_temp-bon1.discnt-value-abs = obj_temp-bon1.discnt-value-abs + buf_chk-discnt.discnt-value-abs
     1818           .
     1819         end.
     1820       end.
     1821       for each obj-list no-lock:
     1822         for each buf_inkas no-lock where
     1823             buf_inkas.obj-type = obj-list.obj-type
     1824         and buf_inkas.obj-code = obj-list.obj-code
     1825         and buf_inkas.shift-date >= X-date-start
     1826         and buf_inkas.shift-date <= X-date-end:
     1827           _chk-doc:
     1828           for each buf0_chk-pay no-lock where
     1829                   buf0_chk-pay.out-code = buf_inkas.inkas-code
     1830               and buf0_chk-pay.pay-code = p-cdpay-code
     1831               and buf0_chk-pay.curr-code = p-curr-code,
     1832             first buf_chk-doc no-lock where
     1833                 buf_chk-doc.doc-code = buf0_chk-pay.doc-code:
     1834             for EACH buf_chk-pay NO-LOCK WHERE
     1835                    buf_chk-pay.doc-code = buf_chk-doc.doc-code
     1836             BREAK
     1837             BY buf_CHK-pay.DOC-CODE
     1838             BY buf_CHK-pay.LINE-NUM:
     1839               if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1840                                                                                                                           define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1841   if first-of(buf_CHK-pay.DOC-CODE) THEN Do:
     1842     assign
     1843     kk = 0
     1844     jj = 1
     1845     jjp = 0
     1846     jjo = 0
     1847     pay-sum = buf_chk-doc.netto
     1848     dop-sumg = 0
     1849     .
     1850     for each buf_treal-3:
     1851       delete buf_treal-3.
     1852     end.
     1853     for each temp-chk-gds:
     1854       delete temp-chk-gds.
     1855     end.
     1856     for each temp-chk-pay:
     1857       delete temp-chk-pay.
     1858     end.
     1859     FOR EACH buf_chk-gds No-LOCK WHERE
     1860              buf_chk-gds.doc-code = buf_chk-pay.doc-code
     1861     BY buf_chk-gds.line-num:
     1862     if buf_chk-gds.write-off-code <> ?
     1863     and buf_chk-gds.write-off-code > 0 then NEXT.
     1864       find first temp-chk-gds where
     1865                 temp-chk-gds.b-code = buf_chk-gds.b-code
     1866             AND  temp-chk-gds.doc-code = buf_chk-gds.doc-code
     1867             and temp-chk-gds.price-base = buf_chk-gds.price-base no-error.
     1868       IF AVAILABLE TEMP-CHK-GDS THEN DO:
     1869         assign
     1870         temp-chk-gds.qnty = temp-chk-gds.qnty  + buf_chk-gds.DOC-qnty
     1871         temp-chk-gds.sum  = temp-chk-gds.sum  + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt + buf_chk-gds.price-service)
     1872         temp-chk-gds.sum-change = temp-chk-gds.sum
     1873         .
     1874       end.
     1875       else do:
     1876         find first temp-chk-gds where temp-chk-gds.jj_ = jj use-index ijj no-error.
     1877         if not available temp-chk-gds then do:
     1878           create temp-chk-gds.
     1879           assign
     1880           temp-chk-gds.jj_ = jj
     1881           temp-chk-gds.qnty = 0
     1882           temp-chk-gds.sum = 0
     1883           temp-chk-gds.sum-change = temp-chk-gds.sum
     1884           jj = jj + 1
     1885           .
     1886         end.
     1887         else do:
     1888           assign
     1889           jj = jj + 1
     1890           temp-chk-gds.qnty = 0
     1891           temp-chk-gds.sum = 0
     1892           temp-chk-gds.sum-change = temp-chk-gds.sum
     1893           .
     1894         end.
     1895         ASSIGN
     1896         temp-chk-gds.doc-code = buf_chk-gds.doc-code
     1897         temp-chk-gds.b-code = buf_chk-gds.b-code
     1898         temp-chk-gds.price-base = buf_chk-gds.price-base
     1899         temp-chk-gds.qnty = temp-chk-gds.qnty  + buf_chk-gds.DOC-qnty
     1900         temp-chk-gds.sum  = temp-chk-gds.sum  + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt + buf_chk-gds.price-service)
     1901         temp-chk-gds.sum-change = temp-chk-gds.sum
     1902         temp-chk-gds.gds-type =  (if buf_chk-gds.pump > 0
     1903                                   then 1
     1904                                   else 2)
     1905         jjo = jjo + (if buf_chk-gds.pump > 0
     1906                      then 0
     1907                      else 1)
     1908         jjp = jjp + (if buf_chk-gds.pump > 0
     1909                      then 1
     1910                      else 0)
     1911         temp-chk-gds.jjp_  = (if buf_chk-gds.pump > 0
     1912                              then jjp
     1913                              else 0)
     1914         temp-chk-gds.jjo_  = (if buf_chk-gds.pump > 0
     1915                               then 0
     1916                               else jjo)
     1917         .
     1918       end.
     1919     END.
     1920   end.
     1921   FIND FIRST buf_cash-pay No-LOCK WHERE
     1922             buf_cash-pay.cdpay-code = buf_chk-pay.pay-code AND
     1923             buf_cash-pay.curr-code = buf_chk-pay.curr-code No-ERROR.
     1924   if available buf_cash-pay then do:
     1925     find first temp-chk-pay use-index pi where
     1926             temp-chk-pay.line-num = buf_chk-pay.line-num no-error.
     1927     if not available temp-chk-pay then do:
     1928       create temp-chk-pay.
     1929     end.
     1930     buffer-copy buf_chk-pay to temp-chk-pay
     1931     assign
     1932     temp-chk-pay.pet-good = integer(buf_cash-pay.atr64) * 2 + integer( buf_cash-pay.is-cash)
     1933     temp-chk-pay.obj-name = buf_cash-pay.obj-name
     1934     temp-chk-pay.is-cash  = buf_cash-pay.is-cash
     1935     .
     1936   end.
     1937   if last-of(buf_chk-pay.doc-code) then do:
     1938     for each temp-chk-pay where
     1939             temp-chk-pay.doc-code = buf_chk-pay.doc-code
     1940     by temp-chk-pay.pet-good descending
     1941     by temp-chk-pay.line-num:
     1942       assign
     1943       dop-sump = (if v-curr-r-b = 'rubl':U then temp-chk-pay.tot-rubl else temp-chk-pay.tot-base)
     1944       .
     1945       _repeat:
     1946       REPEAT WHILE  abs(dop-sump) > 0 :
     1947         if dop-sumg = 0 then do:
     1948           assign
     1949           kk = kk + 1
     1950           .
     1951           if kk >= jj then LEAVE _repeat.
     1952           if kk <= jjp then
     1953           find first temp-chk-gds where
     1954                     temp-chk-gds.doc-code = buf_chk-doc.doc-code
     1955               AND  temp-chk-gds.jjp_ = kk no-error .
     1956           else
     1957           find first temp-chk-gds where
     1958                     temp-chk-gds.doc-code = buf_chk-doc.doc-code
     1959               AND  temp-chk-gds.jjo_ = kk - jjp no-error .
     1960           if not available temp-chk-gds or temp-chk-gds.sum = 0 then do:
     1961             NEXT _repeat.
     1962           end.
     1963           assign
     1964           dop-sumg = temp-chk-gds.sum
     1965           .
     1966         end.
     1967         assign
     1968         dop-sumk = min(abs(dop-sumg), abs(dop-sump))  * (if dop-sump > 0 then 1 else -1 )
     1969         pay-sum = pay-sum - dop-sumk
     1970         dop-sump = dop-sump - dop-sumk
     1971         dop-sumg = dop-sumg - dop-sumk
     1972         .
     1973         FIND FIRST buf_bar-code No-LOCK WHERE
     1974                  buf_bar-code.b-code =  temp-chk-gds.b-code No-ERROR.
     1975         IF NOT AVAIL buf_bar-code then NEXT _repeat.
     1976         FIND FIRST buf_treal-3 No-LOCK WHERE
     1977                   buf_treal-3.gds-code = buf_bar-code.gds-code
     1978               AND buf_treal-3.cpay-code = temp-chk-pay.pay-code
     1979               AND buf_treal-3.curr-code = temp-chk-pay.curr-code
     1980               AND buf_treal-3.d-card = temp-chk-pay.pay-card No-ERROR.
     1981         IF NOT AVAIL  buf_treal-3 then do:
     1982           FIND last b3-treal-3 No-LOCK WHERE
     1983                     b3-treal-3.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
     1984           create buf_treal-3.
     1985           assign
     1986           buf_treal-3.gds-code = buf_bar-code.gds-code
     1987           buf_treal-3.cpay-code = temp-chk-pay.pay-code
     1988           buf_treal-3.curr-code = temp-chk-pay.curr-code
     1989           buf_treal-3.price-base = temp-chk-gds.price-base
     1990           buf_treal-3.rec-type = temp-chk-gds.GDS-type
     1991           buf_treal-3.d-card  = temp-chk-pay.pay-card
     1992           buf_treal-3.line-num = temp-chk-pay.line-num
     1993           buf_treal-3.ii  = (if avail b3-treal-3
     1994                             then b3-treal-3.ii + 1
     1995                             else 1)
     1996           .
     1997         END.
     1998         assign
     1999         buf_treal-3.netto = buf_treal-3.netto + dop-sumk
     2000         buf_treal-3.qnty1 = buf_treal-3.qnty1 + temp-chk-gds.qnty * (dop-sumk / temp-chk-gds.sum)
     2001         .
     2002         if dop-sumg <= 0 then do:
     2003           assign
     2004           kk = kk + 1.
     2005           if kk >= jj then LEAVE _repeat.
     2006           if kk <= jjp then do:
     2007             find first temp-chk-gds where
     2008                       temp-chk-gds.doc-code = buf_chk-doc.doc-code
     2009                 AND  temp-chk-gds.jjp_ = kk no-error .
     2010           end.
     2011           else do:
     2012             find first temp-chk-gds where
     2013                       temp-chk-gds.doc-code = buf_chk-doc.doc-code
     2014                 AND  temp-chk-gds.jjo_ = kk - jjp no-error .
     2015             if not available temp-chk-gds then do:
     2016               LEAVE _repeat.
     2017             end.
     2018           end.
     2019           dop-sumg = temp-chk-gds.sum.
     2020           dop-sumg = temp-chk-gds.sum.
     2021         end.
     2022       END.
     2023     end.
     2024   end.
     2025               if last-of(buf_chk-pay.doc-code) then do:
     2026                  define variable v-gds-ii as integer no-undo .
     2027                  v-gds-ii = 0.
     2028                   for each buf_treal-3:
     2029                   if (buf_treal-3.cpay-code = p-cdpay-code
     2030                   and buf_treal-3.curr-code = p-curr-code) then do:
     2031                     create buf_temp-bon1.
     2032                     assign
     2033                     buf_temp-bon1.obj-type = obj-list.obj-type
     2034                     buf_temp-bon1.obj-code = obj-list.obj-code
     2035                     buf_temp-bon1.chk-date = buf_chk-doc.chk-date
     2036                     buf_temp-bon1.chk-time = buf_chk-doc.chk-time
     2037                     buf_temp-bon1.doc-code = buf_chk-doc.doc-code
     2038                     buf_temp-bon1.line-num = buf_treal-3.line-num
     2039                     buf_temp-bon1.discnt-id = v-gds-ii
     2040                     v-gds-ii = v-gds-ii + 1
     2041                     buf_temp-bon1.object-line-num = buf_treal-3.ii
     2042                     buf_temp-bon1.shift-date = buf_chk-doc.shift-date
     2043                     buf_temp-bon1.shift-num = buf_chk-doc.shift-num
     2044                     buf_temp-bon1.d-card = buf_treal-3.d-card
     2045                     buf_temp-bon1.op-code = 1
     2046                     buf_temp-bon1.discnt-value-abs = 0
     2047                     buf_temp-bon1.cashier-psn-code = buf_chk-doc.cashier-psn-code
     2048                     buf_temp-bon1.level = 0
     2049                     buf_temp-bon1.item-type = buf_treal-3.rec-type
     2050                     buf_temp-bon1.src-qnty = buf_treal-3.qnty1
     2051                     buf_temp-bon1.src-price = buf_treal-3.price-base
     2052                     buf_temp-bon1.pay-sum  = buf_treal-3.netto
     2053                     buf_temp-bon1.gds-code = buf_treal-3.gds-code
     2054                     buf_temp-bon1.src-sum  = buf_temp-bon1.src-qnty * buf_temp-bon1.src-price
     2055                     .
     2056                     if buf_temp-bon1.item-type = 1 then do:
     2057                       find first buf_temp-bon1-gds no-lock where
     2058                               buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code no-error.
     2059                       if not available buf_temp-bon1-gds then do:
     2060                         find first buf_goods no-lock where
     2061                                   buf_goods.gds-code = buf_temp-bon1.gds-code no-error.
     2062                         create buf_temp-bon1-gds.
     2063                         assign
     2064                         buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code
     2065                         buf_temp-bon1-gds.gds-name = (if available buf_goods
     2066                                                       then buf_goods.gds-name
     2067                                                       else substitute("Неизвестное топливо &1", buf_temp-bon1.gds-code))
     2068                         buf_temp-bon1.item-name = buf_temp-bon1-gds.gds-name
     2069                         .
     2070                       end.
     2071                       else do:
     2072                         assign
     2073                         buf_temp-bon1.item-name = buf_temp-bon1-gds.gds-name
     2074                         .
     2075                       end.
     2076                     end .
     2077                     if buf_temp-bon1.item-type = 2 then do:
     2078                       assign
     2079                       buf_temp-bon1.item-name = "Соп. товары"
     2080                       .
     2081                     end.
     2082                     find first obj-grp-op_temp-bon1 where
     2083                               obj-grp-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2084                           and obj-grp-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2085                           and obj-grp-op_temp-bon1.item-name = buf_temp-bon1.item-name
     2086                           and obj-grp-op_temp-bon1.item-type = buf_temp-bon1.item-type
     2087                           and obj-grp-op_temp-bon1.gds-code = -1
     2088                           and obj-grp-op_temp-bon1.op-code = buf_temp-bon1.op-code no-error.
     2089                     if not available obj-grp-op_temp-bon1  then do:
     2090                       create obj-grp-op_temp-bon1 .
     2091                       assign
     2092                       obj-grp-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2093                       obj-grp-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2094                       obj-grp-op_temp-bon1.item-name = buf_temp-bon1.item-name
     2095                       obj-grp-op_temp-bon1.item-type = buf_temp-bon1.item-type
     2096                       obj-grp-op_temp-bon1.gds-code = -1
     2097                       obj-grp-op_temp-bon1.op-code = buf_temp-bon1.op-code
     2098                       obj-grp-op_temp-bon1.level = 2
     2099                     .
     2100                   end.
     2101                     assign
     2102                     obj-grp-op_temp-bon1.src-qnty = obj-grp-op_temp-bon1.src-qnty + buf_temp-bon1.src-qnty
     2103                     obj-grp-op_temp-bon1.pay-sum = obj-grp-op_temp-bon1.pay-sum + buf_temp-bon1.pay-sum
     2104                     obj-grp-op_temp-bon1.src-sum = obj-grp-op_temp-bon1.src-sum + buf_temp-bon1.src-sum
     2105                     .
     2106                     find first obj-grp_temp-bon1 where
     2107                               obj-grp_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2108                           and obj-grp_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2109                           and obj-grp_temp-bon1.item-name = buf_temp-bon1.item-name
     2110                           and obj-grp_temp-bon1.item-type = buf_temp-bon1.item-type
     2111                           and obj-grp_temp-bon1.gds-code = -1
     2112                           and obj-grp_temp-bon1.op-code = 0 no-error.
     2113                     if not available obj-grp_temp-bon1  then do:
     2114                       create obj-grp_temp-bon1 .
     2115                       assign
     2116                       obj-grp_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2117                       obj-grp_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2118                       obj-grp_temp-bon1.item-name = buf_temp-bon1.item-name
     2119                       obj-grp_temp-bon1.item-type = buf_temp-bon1.item-type
     2120                       obj-grp_temp-bon1.gds-code = -1
     2121                       obj-grp_temp-bon1.op-code = 0
     2122                       obj-grp_temp-bon1.level = 3
     2123                       .
     2124                     end.
     2125                     assign
     2126                     obj-grp_temp-bon1.src-qnty = obj-grp_temp-bon1.src-qnty + buf_temp-bon1.src-qnty
     2127                     obj-grp_temp-bon1.pay-sum = obj-grp_temp-bon1.pay-sum + buf_temp-bon1.pay-sum
     2128                     obj-grp_temp-bon1.src-sum = obj-grp_temp-bon1.src-sum + buf_temp-bon1.src-sum
     2129                     .
     2130                     find first obj-op_temp-bon1 where
     2131                               obj-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2132                           and obj-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2133                           and obj-op_temp-bon1.item-type = 0
     2134                           and obj-op_temp-bon1.item-name = '':U
     2135                           and obj-op_temp-bon1.gds-code = -1
     2136                           and obj-op_temp-bon1.op-code = buf_temp-bon1.op-code no-error.
     2137                     if not available obj-op_temp-bon1  then do:
     2138                       create obj-op_temp-bon1 .
     2139                       assign
     2140                       obj-op_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2141                       obj-op_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2142                       obj-op_temp-bon1.item-name = '':U
     2143                       obj-op_temp-bon1.item-type = 0
     2144                       obj-op_temp-bon1.gds-code = -1
     2145                       obj-op_temp-bon1.op-code = buf_temp-bon1.op-code
     2146                       obj-op_temp-bon1.level = 4
     2147                       .
     2148                     end.
     2149                     assign
     2150                     obj-op_temp-bon1.src-qnty = obj-op_temp-bon1.src-qnty + buf_temp-bon1.src-qnty
     2151                     obj-op_temp-bon1.pay-sum = obj-op_temp-bon1.pay-sum + buf_temp-bon1.pay-sum
     2152                     obj-op_temp-bon1.src-sum = obj-op_temp-bon1.src-sum + buf_temp-bon1.src-sum
     2153                     .
     2154                     find first obj_temp-bon1 where
     2155                               obj_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2156                           and obj_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2157                           and obj_temp-bon1.item-name = '':U
     2158                           and obj_temp-bon1.item-type = 0
     2159                           and obj_temp-bon1.gds-code = -1
     2160                           and obj_temp-bon1.op-code = 0 no-error.
     2161                     if not available obj_temp-bon1  then do:
     2162                       create obj_temp-bon1 .
     2163                       assign
     2164                       obj_temp-bon1.obj-type = buf_temp-bon1.obj-type
     2165                       obj_temp-bon1.obj-code = buf_temp-bon1.obj-code
     2166                       obj_temp-bon1.item-name = '':U
     2167                       obj_temp-bon1.item-type = 0
     2168                       obj_temp-bon1.gds-code = -1
     2169                       obj_temp-bon1.op-code = 0
     2170                       obj_temp-bon1.level = 5
     2171                       .
     2172                     end.
     2173                     assign
     2174                     obj_temp-bon1.src-qnty = obj_temp-bon1.src-qnty + buf_temp-bon1.src-qnty
     2175                     obj_temp-bon1.pay-sum = obj_temp-bon1.pay-sum + buf_temp-bon1.pay-sum
     2176                     obj_temp-bon1.src-sum = obj_temp-bon1.src-sum + buf_temp-bon1.src-sum
     2177                     .
     2178                   end.
     2179                   end.
     2180               end.
     2181             end.
     2182           end.
     2183         end.
     2184       end.
     2185     end.
     2186   end procedure.
