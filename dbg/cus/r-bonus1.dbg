     1010   define button B-WaitFramStop auto-end-key
     1011        label "Стоп"
     1012        size 10 by 1 tooltip "Остоновить процесс".
     1013   define button B-viewProcInfo
     1014        label "Информация"
     1015        size 15 by 1 tooltip "Информация о процесс".
     1016   define frame waitfram
     1017     v-waitfram-action01 format "x(72)" no-label skip
     1018     v-waitfram-action02 format "x(72)" no-label skip
     1019     v-waitfram-action03 format "x(72)" no-label skip
     1020     B-viewProcInfo
