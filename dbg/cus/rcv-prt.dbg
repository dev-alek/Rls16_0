      602   define buffer rt_tax            for ub.tax.
      603   DEFINE BUTTON b-exit AUTO-GO
      604        LABEL "&Выход ":L
      605        SIZE 7.5 BY 1.
      606   DEFINE BUTTON b-help
      607        LABEL "Помо&щь":L
      608        SIZE 7.5 BY 1.
      609   DEFINE VARIABLE base-curr AS CHARACTER FORMAT "X(3)":U
      610         VIEW-AS TEXT
      611        SIZE 4 BY 1
      612        FGCOLOR 4  NO-UNDO.
      613   DEFINE VARIABLE cli-curr AS CHARACTER FORMAT "X(3)":U
      614         VIEW-AS TEXT
      615        SIZE 4 BY 1
      616        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      617   DEFINE VARIABLE tot-base AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
      618         VIEW-AS TEXT
      619        SIZE 19.25 BY 1
      620        FGCOLOR 4  NO-UNDO.
      621   DEFINE VARIABLE tot-cli AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
      622         VIEW-AS TEXT
      623        SIZE 18.13 BY 1
      624        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      625   DEFINE VARIABLE tot-rubl AS DECIMAL FORMAT "->>,>>>,>>>,>>>,>>9.99" INITIAL 0
      626        LABEL "Сумма"
      627         VIEW-AS TEXT
      628        SIZE 23.25 BY .6
      629        FGCOLOR 4  NO-UNDO.
      630   DEFINE RECTANGLE RECT-1
