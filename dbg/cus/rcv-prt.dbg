      632        SIZE 97.88 BY 4.17.
      633   DEFINE RECTANGLE RECT-2
      634        EDGE-PIXELS 2 GRAPHIC-EDGE
      635        SIZE 19.75 BY 4.04
      636        BGCOLOR 3 FGCOLOR 15 .
      637   DEFINE RECTANGLE RECT-3
      638        EDGE-PIXELS 2 GRAPHIC-EDGE
      639        SIZE 27 BY 1.25
      640        BGCOLOR 3 FGCOLOR 15 .
      641   DEFINE RECTANGLE RECT-4
