      646        SIZE 97.75 BY 4.33.
      647   DEFINE FRAME d-out-prt
      648        b-exit AT ROW 1.29 COL 2
      649        b-help AT ROW 2.29 COL 2
      650        b-ord-gds-dtl.qnty AT ROW 9.21 COL 82.88 COLON-ALIGNED NO-LABEL
      651             VIEW-AS FILL-IN NATIVE
      652             SIZE 13 BY 1
      653             FGCOLOR 4
      654        b-ord-gds-dtl.price-rubl AT ROW 9.29 COL 6.63 COLON-ALIGNED
      655             LABEL "Цена"
      656             VIEW-AS FILL-IN NATIVE
      657             SIZE 17 BY 1
      658             FGCOLOR 4
      659        b-ord-gds-dtl.price-base AT ROW 9.29 COL 30.5 COLON-ALIGNED NO-LABEL
      660             VIEW-AS FILL-IN  NATIVE
      661             SIZE 17 BY 1
      662             FGCOLOR 4
      663        b-ord-gds-dtl.price-cli AT ROW 9.29 COL 50.5 COLON-ALIGNED NO-LABEL
      664             VIEW-AS FILL-IN  NATIVE
      665             SIZE 18.13 BY 1
      666             BGCOLOR 15 FGCOLOR 4
      667        b-ord-gds-dtl.cli-qnty AT ROW 10.38 COL 82.88 COLON-ALIGNED NO-LABEL
      668             VIEW-AS FILL-IN  NATIVE
      669             SIZE 13 BY 1
      670             FGCOLOR 4
      671        b-ord-gds-dtl.artic AT ROW 1.67 COL 9.38 COLON-ALIGNED NO-LABEL
      672              VIEW-AS TEXT
      673             SIZE 16.5 BY 1
      674        ub.goods.gds-name AT ROW 1.67 COL 26.5 COLON-ALIGNED NO-LABEL
      675              VIEW-AS TEXT
      676             SIZE 68.88 BY 1
      677             FGCOLOR 4
      678        b-ord-gds-dtl.prod-code AT ROW 3 COL 9.25 COLON-ALIGNED NO-LABEL
      679              VIEW-AS TEXT
      680             SIZE 12.63 BY 1
      681        b-ord-gds-dtl.prod-type AT ROW 3 COL 22.13 COLON-ALIGNED NO-LABEL
      682              VIEW-AS TEXT
      683             SIZE 16.63 BY 1
      684        ub.clients.obj-name AT ROW 3 COL 39 COLON-ALIGNED NO-LABEL
      685              VIEW-AS TEXT
      686             SIZE 56.25 BY 1
      687             FGCOLOR 4
      688        ub.bar-code.b-code AT ROW 4.79 COL 17 COLON-ALIGNED
      689              VIEW-AS TEXT
      690             SIZE 10 BY .58
      691             FGCOLOR 4
      692        ub.gds-prt.f-name AT ROW 4.79 COL 27.88 COLON-ALIGNED NO-LABEL
      693              VIEW-AS TEXT
      694             SIZE 39.75 BY .58
      695             FGCOLOR 4
      696        ub.prt-obj.free-qnty AT ROW 4.79 COL 78.88 COLON-ALIGNED
      697              VIEW-AS TEXT
      698             SIZE 16.25 BY .58
      699             FGCOLOR 4
      700        ub.price-list.doc-num AT ROW 5.63 COL 16.88 COLON-ALIGNED
      701              VIEW-AS TEXT
      702             SIZE 16 BY .58
      703        ub.goods.unit-base AT ROW 9.29 COL 77.75 COLON-ALIGNED NO-LABEL
      704              VIEW-AS TEXT
      705             SIZE 4 BY 1
      706             FGCOLOR 4
      707        ub.goods.unit-cli AT ROW 10.38 COL 77.63 COLON-ALIGNED NO-LABEL
      708              VIEW-AS TEXT
      709             SIZE 4 BY 1
      710             BGCOLOR 3 FGCOLOR 15
      711        tot-base AT ROW 10.46 COL 30.5 COLON-ALIGNED NO-LABEL
      712        tot-cli AT ROW 10.46 COL 50.5 COLON-ALIGNED NO-LABEL
      713        tot-rubl AT ROW 10.71 COL 6.38 COLON-ALIGNED
      714        ub.goods.qnty-cart AT ROW 11.58 COL 96.88 RIGHT-ALIGNED
      715             LABEL "Кол.в упак."
      716              VIEW-AS TEXT
      717             SIZE 13 BY .6
      718             FGCOLOR 4
      719        cli-curr AT ROW 11.75 COL 50.75 COLON-ALIGNED NO-LABEL
      720        base-curr AT ROW 11.83 COL 30.5 COLON-ALIGNED NO-LABEL
      721        RECT-5 AT ROW 4.42 COL 1.13
      722        RECT-4 AT ROW 1.25 COL 9.75
      723        RECT-3 AT ROW 10.29 COL 71.88
      724        RECT-1 AT ROW 8.79 COL 1
      725        "РУБ" VIEW-AS TEXT
      726             SIZE 4 BY 1 AT ROW 11.83 COL 8.63
      727             FGCOLOR 4
      728        RECT-2 AT ROW 8.92 COL 51.75
      729        SPACE(27.49) SKIP(0.16)
      730       WITH VIEW-AS DIALOG-BOX
      731            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      732            TITLE ""
      733            DEFAULT-BUTTON b-exit.
      734   ASSIGN
      735          FRAME d-out-prt:SCROLLABLE       = FALSE.
      736   find b-ord-line where
      737                             b-ord-line.doc-code   = b-ord-gds-dtl.doc-code
      738                         and b-ord-line.rcv-code   = b-ord-gds-dtl.rcv-code
      739                         and b-ord-line.prod-code  = b-ord-gds-dtl.prod-code
      740                         and b-ord-line.prod-type  = b-ord-gds-dtl.prod-type
      741                         and b-ord-line.artic      = b-ord-gds-dtl.artic
      742                         no-lock.
      743   assign
      744     loc-cli-base-rate = b-ord-line.cli-base-rate.
      745   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   ON LEAVE OF b-ord-gds-dtl.cli-qnty IN FRAME d-out-prt
      747   DO:
      748   define variable varprt-obj_free-qnty like ub.prt-obj.free-qnty no-undo.
      749   IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-cli
      750                       and LOOKUP('шту':U, ub.units.type) > 0 )  AND
      751      TRUNC(input frame d-out-prt b-ord-gds-dtl.cli-qnty, 0)
      752      <>    input frame d-out-prt b-ord-gds-dtl.cli-qnty
      753      THEN DO:
      754         MESSAGE "Единица изм поставщика " ub.goods.unit-cli " - штучная." skip
      755                 "Кол-во должно быть целым."
      756         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      757         RETURN NO-APPLY.
      758     END.
      759   if ub.goods.qnty-cart <> 0 then do:
      760     if input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart -
      761     truncate ( input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart , 0 ) <> 0 then do:
      762         g#log = yes.
      763         message "Товар рекомендуется выписывать упаковками." skip (2)
      764                 "Округлить до целого числа упаковок ?"
      765                  view-as alert-box question buttons yes-no update g#log .
      766         if g#log then do:
      767           if round (input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart, 0) = 0 then do:
      768             display
      769                 ub.goods.qnty-cart @ b-ord-gds-dtl.cli-qnty
      770                 with frame d-out-prt.
      771           end.
      772           else do:
      773             display
      774               round ( input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart, 0) * ub.goods.qnty-cart @ b-ord-gds-dtl.cli-qnty
      775               with frame d-out-prt.
      776           end.
      777         end.
      778     end.
      779   end.
      780      KK = b-ord-line.cli-base-rate.
      781     if lookup('cli-base-rate',parcli-qnty-calc) = 0 then do:
      782     assign
      783       tot-cli = input frame d-out-prt b-ord-gds-dtl.price-cli * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      784       b-ord-gds-dtl.qnty = ( input frame d-out-prt b-ord-gds-dtl.cli-qnty ) * kk .
      785       DISPLAY  tot-cli b-ord-gds-dtl.qnty   WITH FRAME d-out-prt.
      786     apply "leave" to b-ord-gds-dtl.qnty .
      787     DISPLAY  tot-cli b-ord-gds-dtl.qnty WITH FRAME d-out-prt.
      788     run ass-var in this-procedure .
      789     end.
      790   END.
      791   ON LEAVE OF b-ord-gds-dtl.qnty IN FRAME d-out-prt
      792   DO:
      793    IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-base
      794                       and LOOKUP('шту':U, ub.units.type) > 0)  AND
      795      TRUNC(input frame d-out-prt b-ord-gds-dtl.qnty, 0)
      796      <>    input frame d-out-prt b-ord-gds-dtl.qnty
      797      THEN DO:
      798         MESSAGE "Базовая единица товара " ub.goods.unit-base " - штучная." skip
      799                 "Кол-во по факту должно быть целым."
      800         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      801         RETURN no-apply.
      802     END.
      803    if pardoc-qnty-input = true then do:
      804       if lookup('cli-base-rate',parcli-qnty-calc) > 0 then do:
      805        assign
      806           kk = (input frame d-out-prt b-ord-gds-dtl.qnty) / (input frame d-out-prt b-ord-gds-dtl.cli-qnty )
      807        .
      808        if kk  = ? then kk = 1.
      809        b-ord-line.cli-base-rate = kk  .
      810       end.
      811       else do:
      812           if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
      813             kk = ub.goods.cli-base-rate .
      814             else KK = b-ord-line.cli-base-rate .
      815           assign
      816               b-ord-gds-dtl.cli-qnty = input frame d-out-prt b-ord-gds-dtl.qnty / kk
      817               tot-cli = input frame d-out-prt b-ord-gds-dtl.price-cli * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      818               .
      819               DISPLAY  tot-cli b-ord-gds-dtl.cli-qnty   WITH FRAME d-out-prt.
      820          end.
      821     run ass-var in this-procedure .
      822     end.
      823   END.
      824   ON LEAVE OF b-ord-gds-dtl.price-base IN FRAME d-out-prt
      825   DO:
      826   if input frame d-out-prt b-ord-gds-dtl.price-base > 5000 and base-code = 1 then
      827     message "Внимание !!!" skip (2)
      828                     "ВАЛЮТНАЯ цена превышает 5,000 !" skip (2)
      829                     "Вы не ошиблись ?".
      830   if b-ord-gds-dtl.price-base <> input frame d-out-prt b-ord-gds-dtl.price-base then
      831     assign
      832       b-ord-gds-dtl.price-rubl = input frame d-out-prt b-ord-gds-dtl.price-base * loc-base-rate / loc-base-scale
      833       b-ord-gds-dtl.price-cli  = b-ord-gds-dtl.price-rubl / loc-exch-rate * loc-exch-scale *
      834        loc-cli-base-rate
      835       .
      836       DISPLAY
      837       b-ord-gds-dtl.price-RUBL
      838       b-ord-gds-dtl.price-cli
      839       WITH FRAME d-out-prt .
      840    run ass-var in this-procedure  .
      841   END.
      842   ON LEAVE OF b-ord-gds-dtl.price-rubl IN FRAME d-out-prt
      843   DO:
      844   if b-ord-gds-dtl.price-rubl <> input frame d-out-prt b-ord-gds-dtl.price-rubl then
      845     assign
      846       b-ord-gds-dtl.price-base = input frame d-out-prt b-ord-gds-dtl.price-rubl / loc-base-rate * loc-base-scale
      847       b-ord-gds-dtl.price-cli  = input frame d-out-prt b-ord-gds-dtl.price-rubl / loc-exch-rate * loc-exch-scale /
      848        loc-cli-base-rate
      849       .
      850       DISPLAY
      851       b-ord-gds-dtl.price-base
      852       b-ord-gds-dtl.price-cli
      853       WITH FRAME d-out-prt .
      854       run ass-var in this-procedure .
      855   END.
      856   ON LEAVE OF b-ord-gds-dtl.price-cli IN FRAME d-out-prt
      857   DO:
      858   if b-ord-gds-dtl.price-cli <> input frame d-out-prt b-ord-gds-dtl.price-cli then
      859     assign
      860       tot-cli = input frame d-out-prt b-ord-gds-dtl.price-cli *  input frame d-out-prt b-ord-gds-dtl.cli-qnty
      861       .
      862    run ass-var in this-procedure .
      863   END.
      864   procedure ass-var :
      865    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      866    assign
      867       pargds-code =  ub.goods.gds-code
      868       parobj-type =  loc-store-type
      869       parobj-code =  loc-store-code
      870    .
      871   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_kndinpin in g#lib-calc
      872     (
      873      input  pargds-code
      874     ,input  loc-cli-type
      875     ,input  loc-cli-code
      876     ,input  parobj-type
      877     ,input  parobj-code
      878     ,output parext-gds-type
      879     ,output parcli-qnty-input
      880     ,output pardensity-input
      881     ,output parcli-base-rate-input
      882     ,output pardoc-qnty-input
      883     ,output parfact-qnty-input
      884     ,output parprice-cli-input
      885     ,output parbase-price-input
      886     ,output partax-3-input
      887     ,output parcli-qnty-calc
      888     ,output pardensity-calc
      889     ,output parcli-base-rate-calc
      890     ,output pardoc-qnty-calc
      891     ,output parfact-qnty-calc
      892     ,output parprice-cli-calc
      893     ,output parbase-price-calc
      894     ,output partax-3-calc
      895     ,output parround
      896     ) no-error.
      897   if error-status :error then message
      898     vss-workfile vss-revision vss-description skip
      899     error-status :get-message(1) skip
      900     return-value skip
      901     "1"
      902     view-as alert-box error
      903   .
      904   if  parext-gds-type =  'sg':U then
      905     do:
      906      assign
      907       parcli-qnty-input   = true
      908       parprice-cli-input  = true
      909      .
      910     end.
      911   if g#type =  'ОФ':U then
      912   assign
      913   parbase-price-my = false
      914   parbase-price-input = false
      915   parprice-cli-input  = false
      916   .
      917   else
      918   assign
      919     parbase-price-my = true
      920   .
      921   if parbase-price-calc = 'cli-price' then do:
      922    assign  frame d-out-prt  b-ord-gds-dtl.price-rubl b-ord-gds-dtl.price-base .
      923    assign
      924       b-ord-gds-dtl.sum-rubl = input frame d-out-prt b-ord-gds-dtl.price-rubl  * input frame d-out-prt b-ord-gds-dtl.qnty
      925       b-ord-gds-dtl.sum-base = b-ord-gds-dtl.price-base  * input frame d-out-prt b-ord-gds-dtl.qnty
      926       b-ord-gds-dtl.sum-cli  = b-ord-gds-dtl.price-cli   * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      927       tot-rubl     = input frame d-out-prt b-ord-gds-dtl.price-rubl * input frame d-out-prt b-ord-gds-dtl.qnty
      928       tot-base     = b-ord-gds-dtl.price-base * input frame d-out-prt b-ord-gds-dtl.qnty
      929       tot-cli      = b-ord-gds-dtl.price-cli  * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      930       .
      931   end.
      932   else do:
      933    assign
      934       b-ord-gds-dtl.sum-rubl = b-ord-gds-dtl.price-rubl  * input frame d-out-prt b-ord-gds-dtl.qnty
      935       b-ord-gds-dtl.sum-base = b-ord-gds-dtl.price-base  * input frame d-out-prt b-ord-gds-dtl.qnty
      936       b-ord-gds-dtl.sum-cli  = input frame d-out-prt b-ord-gds-dtl.price-cli   * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      937       tot-rubl     = b-ord-gds-dtl.price-rubl * input frame d-out-prt b-ord-gds-dtl.qnty
      938       tot-base     = b-ord-gds-dtl.price-base * input frame d-out-prt b-ord-gds-dtl.qnty
      939       tot-cli      = input frame d-out-prt b-ord-gds-dtl.price-cli  * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      940       .
      941   end.
      942     DISPLAY
      943       b-ord-gds-dtl.price-rubl
      944       b-ord-gds-dtl.price-base
      945       b-ord-gds-dtl.price-cli
      946       tot-cli
      947       tot-rubl
      948       tot-base WITH FRAME d-out-prt.
      949    end.
      950   end procedure.
      951   PROCEDURE apply-focus-next-entry :
      952   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      953     define input parameter p-widget-handle as handle no-undo .
      954     do with frame d-out-prt :
      955         if b-ord-gds-dtl.cli-qnty :handle = p-widget-handle then apply "entry":u to b-ord-gds-dtl.price-cli .
      956     end.
      957   end.
      958   END PROCEDURE.
      959   ON CHOOSE OF b-exit IN FRAME d-out-prt
      960   DO:
      961   assign
      962     prt-rec = recid (b-ord-gds-dtl)
      963     cur-rec = recid (ub.gds-prt)
      964     gds-rec = recid (ub.goods).
      965   find b-ord-line where
      966                             b-ord-line.doc-code   = b-ord-gds-dtl.doc-code
      967                         and b-ord-line.rcv-code   = b-ord-gds-dtl.rcv-code
      968                         and b-ord-line.prod-code  = b-ord-gds-dtl.prod-code
      969                         and b-ord-line.prod-type  = b-ord-gds-dtl.prod-type
      970                         and b-ord-line.artic      = b-ord-gds-dtl.artic
      971                         no-lock.
      972   line-rec = recid (b-ord-line).
      973   assign
      974     b-ord-gds-dtl.sum-cli = b-ord-gds-dtl.cli-qnty * b-ord-gds-dtl.price-cli
      975     b-ord-gds-dtl.sum-base = b-ord-gds-dtl.qnty * b-ord-gds-dtl.price-base
      976     b-ord-gds-dtl.sum-rubl = b-ord-gds-dtl.qnty * b-ord-gds-dtl.price-rubl
      977     .
      978   END.
      979   on end-error, stop of frame d-out-prt do:
      980     apply "choose" to b-exit in frame d-out-prt.
      981     return no-apply.
      982   end.
      983   ON RETURN OF b-ord-gds-dtl.cli-qnty IN FRAME d-out-prt
      984   DO:
      985    run apply-focus-next-entry in this-procedure  (input  b-ord-gds-dtl.cli-qnty:handle ) .
      986    return no-apply .
      987   END.
      988   ON RETURN OF b-ord-gds-dtl.qnty IN FRAME d-out-prt
      989   DO:
      990   apply "choose" to b-exit in frame d-out-prt.
      991   END.
      992   ON RETURN OF b-ord-gds-dtl.price-rubl IN FRAME d-out-prt
      993   DO:
      994   apply "choose" to b-exit in frame d-out-prt.
      995   END.
      996   ON RETURN OF b-ord-gds-dtl.price-base IN FRAME d-out-prt
      997   DO:
      998   apply "choose" to b-exit in frame d-out-prt.
      999   END.
     1000   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-out-prt:PARENT eq ?
     1001   THEN FRAME d-out-prt:PARENT = ACTIVE-WINDOW.
     1002   ON WINDOW-CLOSE OF FRAME d-out-prt APPLY "END-ERROR":U TO SELF.
     1003   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   on help of frame d-out-prt
     1005   do:
     1006     run gbl/app_help.p
     1007       (input this-procedure :file-name
     1008       ,input ''
     1009       ,input ?
     1010       ) no-error.
     1011     if error-status :error then do:
     1012       message
     1013         "Ошибка при вызове помощи"
     1014         error-status :get-message(1)
     1015         view-as alert-box .
     1016     end.
     1017   end.
     1018   run minbtn-set in this-procedure .
     1019   on choose of b-help in frame d-out-prt
     1020   do:
     1021     apply "help":u to frame d-out-prt .
     1022   end.
     1023   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   procedure minbtn-set :
     1025       do
     1026           on error undo, return error return-value
     1027           :
     1028           define variable ii              as integer       no-undo .
     1029           define variable fh              as widget-handle no-undo .
     1030           define variable hh              as widget-handle no-undo .
     1031           define variable v-h             as handle        extent 4 no-undo .
     1032           define variable v-name-button   as character     no-undo .
     1033           define variable v-help-old-x    as decimal       no-undo .
     1034           define variable v-help-old-y    as decimal       no-undo .
     1035           define variable v-help-old-size as decimal       no-undo .
     1036           define variable v-frame-width   as decimal       no-undo .
     1037           define variable jj              as integer       no-undo .
     1038           do
     1039               on error undo, return error
     1040               :
     1041               assign
     1042                   v-frame-width = frame d-out-prt:width - 0.3
     1043                   fh            = frame d-out-prt:first-child
     1044                   hh            = fh:first-child
     1045                   ii            = 1
     1046                   .
     1047               do while valid-handle(hh):
     1048                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1049                   do:
     1050                       case lc(hh:name) :
     1051                           when "b-help" then
     1052                               do:
     1053                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1054                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1055                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1056                                   hh:TOOLTIP = "Помощь" .
     1057                                   v-help-old-x = hh:column .
     1058                                   v-help-old-y = hh:row    .
     1059                                   v-help-old-size = hh:width .
     1060                                   hh:width-chars = 2.5 .
     1061                               end.
     1062                           when "b-print" then
     1063                               do:
     1064                                   hh:load-image("cmp/b-print.bmp":u) .
     1065                                   hh:TOOLTIP = "Печать" .
     1066                                   v-h[ii] = hh:handle .
     1067                                   ii = ii + 1 .
     1068                                   hh:width-chars = 3 .
     1069                               end.
     1070                           when "b-history" or
     1071                           when "b-hist" then
     1072                               do:
     1073                                   hh:load-image("cmp/b-hist.bmp":u) .
     1074                                   hh:TOOLTIP = "История" .
     1075                                   v-h[ii] = hh:handle .
     1076                                   ii = ii + 1 .
     1077                                   hh:width-chars = 3 .
     1078                               end.
     1079                           when "b-sch" then
     1080                               do:
     1081                                   hh:load-image("cmp/b-sch.bmp":u) .
     1082                                   hh:TOOLTIP = "Установка Фильтра" .
     1083                                   v-h[ii] = hh:handle .
     1084                                   ii = ii + 1 .
     1085                                   hh:width-chars = 3 .
     1086                               end.
     1087                           when "b-hist-user" then
     1088                               do:
     1089                                   hh:load-image("cmp/b-hist.bmp":u) .
     1090                                   hh:TOOLTIP = "История пользователя" .
     1091                                   ii = ii + 1 .
     1092                               end.
     1093                       end case.
     1094                   end.
     1095                   hh = hh:next-sibling.
     1096               end.
     1097               b-help:column = v-frame-width - b-help:width-chars.
     1098               jj = 0.
     1099               repeat ii = 4 to 1 by -1 :
     1100                   if valid-handle (v-h[ii] ) then
     1101                   do:
     1102                       jj  = jj + 1 .
     1103                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1104                       v-h[ii]:row    = v-help-old-y .
     1105                   end.
     1106               end.
     1107           end.
     1108       end.
     1109   end procedure.
     1110   MAIN-BLOCK:
     1111   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1112      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1113   g#type = loc-doc-type.
     1114   find ub.gds-prt where recid (ub.gds-prt) = cur-rec no-lock.
     1115   if prt-mode = 'ШКАЛА':U and node-type <> 'терм':U then do:
     1116     message "В режиме ШКАЛА можно указывать количества только по самым подробным признакам.".
     1117     undo, return error.
     1118   end.
     1119   find ub.goods where recid (ub.goods) = gds-rec no-lock.
     1120   find ub.clients where ub.clients.obj-code = ub.goods.prod-code
     1121                  and ub.clients.obj-type = ub.goods.prod-type no-lock.
     1122   find ub.prt-obj where ub.prt-obj.prt-code = ub.gds-prt.node-code
     1123                       and ub.prt-obj.prod-code = ub.goods.prod-code
     1124                       and ub.prt-obj.prod-type = ub.goods.prod-type
     1125                       and ub.prt-obj.artic     = ub.goods.artic
     1126                       and ub.prt-obj.obj-code  = store-code
     1127                       and ub.prt-obj.obj-type  = store-type
     1128                       no-lock no-error.
     1129     find b-ord-line where recid (b-ord-line) = line-rec.
     1130     find b-ord-gds-dtl where b-ord-gds-dtl.node-code = ub.gds-prt.node-code
     1131                         and b-ord-gds-dtl.prod-code = b-ord-line.prod-code
     1132                         and b-ord-gds-dtl.prod-type = b-ord-line.prod-type
     1133                         and b-ord-gds-dtl.artic     = b-ord-line.artic
     1134                         and b-ord-gds-dtl.doc-code  = b-ord-line.doc-code
     1135                         and b-ord-gds-dtl.rcv-code  = b-ord-line.rcv-code
     1136                          exclusive-lock   no-error.
     1137   if not available b-ord-gds-dtl then do:
     1138     if ub.gds-prt.upper-code = ub.goods.prt-root
     1139        or prt-mode = 'ПРОСМОТР':U then do:
     1140       message "Товара с таким признаком нет в данном заказе.".
     1141       undo, return error.
     1142     end.
     1143     run create_gds-dtl in this-procedure (b-ord-line.rcv-code,
     1144                         b-ord-line.doc-code,
     1145                         ub.gds-prt.f-name,
     1146                         b-ord-line.artic,
     1147                         b-ord-line.prod-code,
     1148                         b-ord-line.prod-type,
     1149                         ub.gds-prt.node-code
     1150                        ) no-error.
     1151     if error-status:error then do:
     1152        message "Ошибка при создании признака." skip
     1153                return-value error-status:error
     1154        view-as alert-box error.
     1155         undo , return error.
     1156     end.
     1157    find first b-ord-gds-dtl where
     1158                             b-ord-gds-dtl.doc-code  = b-ord-line.doc-code     and
     1159                             b-ord-gds-dtl.rcv-code  = b-ord-line.rcv-code     and
     1160                             b-ord-gds-dtl.artic     = b-ord-line.artic     and
     1161                             b-ord-gds-dtl.prod-code = b-ord-line.prod-code and
     1162                             b-ord-gds-dtl.prod-type = b-ord-line.prod-type and
     1163                             b-ord-gds-dtl.node-code = ub.gds-prt.node-code  exclusive-lock  .
     1164    run last-price in this-procedure  (
     1165         input  g#host-code ,
     1166         input  b-ord-gds-dtl.artic ,
     1167         input  b-ord-gds-dtl.prod-type ,
     1168         input  b-ord-gds-dtl.prod-code ,
     1169         input  loc-cli-code  ,
     1170         input  loc-cli-type  ,
     1171         input  b-ord-line.cli-base-rate ,
     1172         input  LOC-EXCH-CODE ,
     1173         output b-ord-gds-dtl.price-base ,
     1174         output b-ord-gds-dtl.price-rubl ,
     1175         output b-ord-gds-dtl.price-cli )
     1176         no-error  .
     1177         if error-status :error then message  error-status :get-message(1) .
     1178     if prt-mode = 'ШКАЛА':U then do:
     1179       find first g-d-b-ord-dtl where g-d-b-ord-dtl.prod-type = b-ord-line.prod-type
     1180                          and g-d-b-ord-dtl.prod-code = b-ord-line.prod-code
     1181                          and g-d-b-ord-dtl.artic     = b-ord-line.artic
     1182                          and g-d-b-ord-dtl.doc-code  = b-ord-line.doc-code
     1183                          and g-d-b-ord-dtl.rcv-code  = b-ord-line.rcv-code
     1184                          and g-d-b-ord-dtl.node-code  <> ub.gds-prt.node-code no-lock no-error.
     1185       if AVAILABLE g-d-b-ord-dtl then
     1186       assign
     1187         b-ord-gds-dtl.cli-qnty   = g-d-b-ord-dtl.cli-qnty
     1188         b-ord-gds-dtl.qnty       = g-d-b-ord-dtl.qnty
     1189         .
     1190     end.
     1191   end.
     1192   frame d-out-prt:title = "Заказ №  " + loc-ord-num + "    " +  'строка':U + "     " + prt-mode.
     1193   cli-curr  = "" .
     1194   base-curr = "".
     1195   find first ub.currency where ub.currency.curr-code = base-code no-lock no-error.
     1196     if available ub.currency then base-curr = ub.currency.curr-abbr .
     1197   find first ub.currency where ub.currency.curr-code = LOC-EXCH-CODE no-lock no-error.
     1198     if available ub.currency then cli-curr = ub.currency.curr-abbr .
     1199     disp cli-curr base-curr with frame d-out-prt .
     1200   run UI-on in this-procedure .
     1201   if prt-mode = 'ПРОСМОТР':U then WAIT-FOR GO OF FRAME d-out-prt focus b-exit.
     1202   else  DO:
     1203       WAIT-FOR GO OF FRAME d-out-prt focus b-ord-gds-dtl.cli-qnty.
     1204         chg-qnty = input frame d-out-prt b-ord-gds-dtl.qnty - b-ord-gds-dtl.qnty.
     1205         b-ord-line.qnty   = b-ord-line.qnty + chg-qnty  .
     1206         b-ord-gds-dtl.qnty  = b-ord-gds-dtl.qnty + chg-qnty .
     1207         chg-qnty = input frame d-out-prt b-ord-gds-dtl.cli-qnty - b-ord-gds-dtl.cli-qnty.
     1208         b-ord-line.cli-qnty   = b-ord-line.cli-qnty + chg-qnty  .
     1209         b-ord-gds-dtl.cli-qnty  = b-ord-gds-dtl.cli-qnty + chg-qnty .
     1210         b-ord-gds-dtl.price-rubl  = input frame d-out-prt b-ord-gds-dtl.price-rubl .
     1211         b-ord-gds-dtl.price-base  = input frame d-out-prt b-ord-gds-dtl.price-base .
     1212   End.
     1213   prt-rec = recid (b-ord-gds-dtl).
     1214   if prt-mode <> 'ПРОСМОТР':U then do:
     1215     if b-ord-gds-dtl.cli-qnty = 0 and b-ord-gds-dtl.qnty = 0 then do:
     1216       message "Удаляем строку, т.к. количество = 0.".
     1217       delete b-ord-gds-dtl.
     1218       prt-rec = ?.
     1219     end.
     1220   end.
     1221   END.
     1222   run disable_UI in this-procedure .
     1223   PROCEDURE disable_UI :
     1224     HIDE FRAME d-out-prt.
     1225   END PROCEDURE.
     1226   PROCEDURE UI-on :
     1227   disable all with frame d-out-prt.
     1228   enable
     1229         b-exit
     1230         b-help
     1231         b-ord-gds-dtl.price-cli
     1232         b-ord-gds-dtl.cli-qnty
     1233         with frame d-out-prt.
     1234    run tax-name in this-procedure ( input 'rdt':U, output varroad-tax-label) no-error.
     1235   IF AVAILABLE ub.prt-obj    THEN DISPLAY ub.prt-obj.free-qnty   WITH FRAME d-out-prt.
     1236   IF AVAILABLE ub.price-list THEN DISPLAY ub.price-list.doc-num  WITH FRAME d-out-prt.
     1237   g#log = true .
     1238   if g#log and paytype <> g#ret-sup-pay or
     1239       (paytype = g#ret-sup-pay) then
     1240       if prt-mode = 'ПРОСМОТР':U then hide ub.prt-obj.free-qnty ub.price-list.doc-num in frame d-out-prt.
     1241   assign
     1242     tot-rubl = b-ord-gds-dtl.qnty     * b-ord-gds-dtl.price-rubl
     1243     tot-base = b-ord-gds-dtl.qnty     * b-ord-gds-dtl.price-base
     1244     tot-cli  = b-ord-gds-dtl.cli-qnty * b-ord-gds-dtl.price-cli
     1245     .
     1246   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1248     (input  ub.goods.gds-code
     1249     ,input  b-ord-gds-dtl.node-code
     1250     ,input  ''
     1251     ,input  ''
     1252     ,input  ub.goods.unit-base
     1253     ,input  1
     1254     ,output varis-new
     1255     ,buffer b-c-b
     1256     )  .
     1257   display b-c-b.b-code @ ub.bar-code.b-code with frame d-out-prt.
     1258   disp tot-rubl
     1259        tot-base
     1260        tot-cli
     1261        base-curr
     1262        cli-curr
     1263        ub.clients.obj-name
     1264        ub.gds-prt.f-name
     1265        b-ord-gds-dtl.artic
     1266        b-ord-gds-dtl.prod-code
     1267        b-ord-gds-dtl.prod-type
     1268        b-ord-gds-dtl.price-rubl
     1269        b-ord-gds-dtl.price-base
     1270        b-ord-gds-dtl.price-cli
     1271        b-ord-gds-dtl.cli-qnty
     1272        b-ord-gds-dtl.qnty
     1273        ub.goods.gds-name
     1274        ub.goods.unit-base
     1275        ub.goods.qnty-cart
     1276        ub.goods.unit-cli
     1277        with frame d-out-prt.
     1278   if ub.gds-prt.upper-code = ub.goods.prt-root then hide ub.gds-prt.f-name in frame d-out-prt.
     1279   END PROCEDURE.
     1280   procedure create_gds-dtl :
     1281   define input parameter p-rcv-code  like ub.ord-doc-rcv.rcv-code  no-undo.
     1282   define input parameter p-doc-code  like ub.ord-doc-rcv.doc-code  no-undo.
     1283   define input parameter parname    as character no-undo .
     1284   define input parameter parartic     like ub.goods.artic       no-undo.
     1285   define input parameter parprod-code like ub.goods.prod-code   no-undo.
     1286   define input parameter parprod-type like ub.goods.prod-type   no-undo.
     1287   define input parameter parprt-code  like ub.gds-dtl.prt-code  no-undo.
     1288   define buffer bf_gds-dtl for ub.ord-dtl-rcv.
     1289   define buffer bf_clients for ub.clients.
     1290   define buffer bf_goods   for ub.goods.
     1291   error-status:error = false .
     1292   find first bf_gds-dtl where bf_gds-dtl.artic      = parartic
     1293                           and bf_gds-dtl.prod-code  = parprod-code
     1294                           and bf_gds-dtl.prod-type  = parprod-type
     1295                           and bf_gds-dtl.rcv-code   = p-rcv-code
     1296                           and bf_gds-dtl.doc-code   = p-doc-code
     1297                           and bf_gds-dtl.node-code  = parprt-code   no-error.
     1298   if not available bf_gds-dtl then do:
     1299      find first bf_goods where bf_goods.artic     = parartic     and
     1300                                bf_goods.prod-type = parprod-type and
     1301                                bf_goods.prod-code = parprod-code no-lock no-error.
     1302      if not available bf_goods then do:
     1303         return error subst("Создание признака невозможно. Не найден товар &1 &2 &3.", parartic, parprod-code, parprod-code).
     1304      end.
     1305   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1306   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1307     (input  bf_goods.gds-code
     1308     ,input  parprt-code
     1309     ,input  ''
     1310     ,input  ''
     1311     ,input  bf_goods.unit-base
     1312     ,input  ?
     1313     ,output varis-new
     1314     ,buffer ub.bar-code
     1315     ) no-error .
     1316     create bf_gds-dtl.
     1317       assign
     1318         bf_gds-dtl.rcv-code       = p-rcv-code
     1319         bf_gds-dtl.doc-code       = p-doc-code
     1320         bf_gds-dtl.artic          = parartic
     1321         bf_gds-dtl.prod-code      = parprod-code
     1322         bf_gds-dtl.prod-type      = parprod-type
     1323         bf_gds-dtl.node-code      = parprt-code
     1324       .
     1325   end.
     1326   else do:
     1327       assign
     1328         bf_gds-dtl.rcv-code      = p-rcv-code
     1329         bf_gds-dtl.doc-code      = p-doc-code
     1330         bf_gds-dtl.artic         = parartic
     1331         bf_gds-dtl.prod-code     = parprod-code
     1332         bf_gds-dtl.prod-type     = parprod-type
     1333         bf_gds-dtl.node-code     = parprt-code
     1334      .
     1335   end.
     1336   end procedure.
