      322   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      324   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      325   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      326   ASSIGN
      327      v-S_CONTRACT                = "Contract":U
      328      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      329      v-DELIM_CHR_3               = ","
      330      .
      331   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      332   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      333   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      334   FUNCTION Can-Find-Spec RETURN LOGICAL (
      335      INPUT iHost-Code    AS INTEGER,
      336      INPUT iContract-Num AS INTEGER,
      337      INPUT iGds-Code     AS INTEGER ):
      338      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      339      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      340      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      341      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      342      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      343      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      344          INPUT  iHost-Code,
      345          INPUT  iContract-Num,
      346          OUTPUT iTmp-Extent3
      347          ).
      348      IF iTmp-Extent3[1] = 2 THEN DO:
      349         ASSIGN
      350            iTmp-Host-Code      = iTmp-Extent3[2]
      351            iTmp-Contract-Num   = iTmp-Extent3[3]
      352            .
      353      END. ELSE DO:
      354         ASSIGN
      355            iTmp-Host-Code      = iHost-Code
      356            iTmp-Contract-Num   = iContract-Num
      357            .
      358      END.
      359      IF iGds-Code = ? THEN DO:
      360         ASSIGN
      361            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      362                                  buf_Spec.Host-Code     = iTmp-Host-Code
      363                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      364                           ).
      365      END. ELSE DO:
      366            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      367                                  buf_Spec.Host-Code     = iTmp-Host-Code
      368                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      369                              AND buf_Spec.Gds-Code      = iGds-Code
      370                            ).
      371      END.
      372      RETURN (lRet).
      373   END FUNCTION.
      374   PROCEDURE MS-Contract-EXTENT-3:
      375      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      376      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      377      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      378      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      379      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      380      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      381      FIND FIRST buf_Cont-2 WHERE
      382                 buf_Cont-2.Host-Code      = i-Host-Code
      383             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      384           NO-LOCK NO-ERROR.
      385      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      386         RETURN.
      387      END.
      388      FOR FIRST buf_Ext-Classif WHERE
      389                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      390           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      391                                               STRING(i-Contract-code)
      392           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      393          NO-LOCK,
      394          EACH buf_Cont WHERE
      395               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      396           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      397          NO-LOCK:
      398          ASSIGN
      399             i-Ret[1] = 1
      400             i-Ret[2] = buf_Cont.Host-code
      401             i-Ret[3] = buf_Cont.Contract-code
      402             .
      403          LEAVE.
      404      END.
      405      IF i-Ret[1] <> 1 THEN DO:
      406         FOR FIRST buf_Ext-Classif WHERE
      407                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      408              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      409                                                  STRING(i-Contract-code)
      410              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      411             NO-LOCK,
      412             EACH buf_Cont WHERE
      413                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      414              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      415             NO-LOCK:
      416             ASSIGN
      417                i-Ret[1] = 2
      418                i-Ret[2] = buf_Cont.Host-code
      419                i-Ret[3] = buf_Cont.Contract-code
      420                .
      421             LEAVE.
      422         END.
      423      END.
      424      RETURN.
      425   END PROCEDURE.
      426   define  buffer buf_ord-doc    for ub.ord-doc.
      427   define  buffer t-doc-rcv      for ub.ord-doc-rcv .
      428   define  buffer t-ord-doc-rcv  for ub.ord-doc-rcv.
