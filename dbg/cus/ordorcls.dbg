      447   define variable sum-trn like ub.ord-line.qnty no-undo .
      448   define variable old-state like ub.ord-doc.status_ no-undo .
      449   define variable old-flag like ub.ord-doc.flag_ no-undo .
      450   define stream   errStream  .
