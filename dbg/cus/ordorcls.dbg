      433   define  buffer obj_clients     for ub.clients .
      434   define  buffer cli_clients     for ub.clients .
      435   define  buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      436   define  buffer buf_trn-doc     for ub.trn-doc .
      437   define  buffer buf_doc-line    for ub.doc-line .
      438   define  buffer buf_ord-line    for ub.ord-line .
      439   define temp-table temp-obj-list no-undo
