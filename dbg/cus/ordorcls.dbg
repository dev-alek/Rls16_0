      456   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      458     (input  v-cntxt-obj-type
      459     ,input  v-cntxt-obj-code
      460     ,output to-day
      461     )  .
      462    find first buf_ord-doc where recid (buf_ord-doc) = p-rec exclusive-lock no-error.
      463    if error-status :error then return error 'не найден заказ'.
      464    assign
      465     old-state = buf_ord-doc.status_
      466     old-flag  = buf_ord-doc.flag_
      467     .
      468     if buf_ord-doc.ship-date = ? then do:
      469        if p-ask then
      470         message "Не задана дата заказа ! "
      471                 skip
      472                 "Документ" buf_ord-doc.doc-code skip
      473                 view-as alert-box error .
      474         return error.
      475     end.
      476     define variable t-date  as date      no-undo .
      477     define variable t-time  as integer   no-undo .
      478     run cur-time in this-procedure (output  t-date , output  t-time ).
      479     if buf_ord-doc.date-sale-1 > buf_ord-doc.date-sale-2 then do:
      480        if p-ask then
      481           message "Не верно задан интервал продаж !  "
      482                   skip
      483                   "Документ" buf_ord-doc.doc-code skip
      484                   view-as alert-box error .
      485         return error.
      486     end.
      487   define buffer bf_contract-specif for ub.contract-specif  .
      488         if buf_ord-doc.contract-code > 0 then do:
      489   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   ASSIGN
      491      i-gl-Host-Code      = 0
      492      i-gl-Contract-Code  = 0
      493      i-gl-Extent3        = 0
      494      .
      495   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      496       INPUT  buf_ord-doc.host-code,
      497       INPUT  buf_ord-doc.contract-code,
      498       OUTPUT i-gl-Extent3
      499      ).
      500   IF i-gl-Extent3[1] = 2 THEN DO:
      501      ASSIGN
      502         i-gl-Host-Code      = i-gl-Extent3[2]
      503         i-gl-Contract-Code  = i-gl-Extent3[3]
      504         .
      505   END. ELSE DO:
      506      ASSIGN
      507         i-gl-Host-Code      = buf_ord-doc.host-code
      508         i-gl-Contract-Code  = buf_ord-doc.contract-code
      509         .
      510   END.
      511       FIND FIRST bf_contract-specif
      512              NO-LOCK
      513              WHERE
      514                  bf_contract-specif.Host-code    = i-gl-Host-Code
      515              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
      516              NO-ERROR
      517              .
      518             if available bf_contract-specif then do:
      519                for each ub.ord-line no-lock where
      520                         ub.ord-line.doc-code = buf_ord-doc.doc-code :
      521                   if not
      522                   Can-Find-Spec  (buf_ord-doc.host-code,
      523                                   buf_ord-doc.contract-code ,
      524                                   ub.ord-line.gds-code)
      525                   then do:
      526                                             if p-ask then
      527                                             message
      528                                               "Выбран Договор со спецификацией !!!" skip
      529                                               "Несоответствие списка товаров заказа и спецификации " skip
      530                                               "Заказ      :" buf_ord-doc.doc-code        skip
      531                                               "код товара :" ub.ord-line.gds-code skip
      532                                               "артикл     :" ub.ord-line.artic skip
      533                                               view-as alert-box error .
      534                                               return error.
      535                                          end.
      536                end.
      537             end.
      538         end.
      539        if buf_ord-doc.status_ = 'новый':U
      540          then do:
      541           for each ub.ord-line no-lock where
      542              ub.ord-line.doc-code = buf_ord-doc.doc-code :
      543   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
      545     (input  buf_ord-doc.doc-type
      546     ,input  ub.ord-line.gds-code
      547     ,input  buf_ord-doc.obj-type
      548     ,input  buf_ord-doc.obj-code
      549     ,input  false
      550     ,output v-Ok
      551     ,output v-mess
      552     ) no-error.
      553               if v-Ok = false then do:
      554                 if p-ask then
      555                 message
      556                   v-mess skip
      557                   "Товар не может быть включен в заказ " skip
      558                   "Заказ      :" buf_ord-doc.doc-code        skip
      559                   "код товара :" ub.ord-line.gds-code skip
      560                   "артикул    :" ub.ord-line.artic skip
      561                   view-as alert-box error .
      562                   return error substitute("izt &1" ,v-mess ) .
      563               end.
      564               v-event-code = substitute("cli_&1",buf_ord-doc.doc-type) .
      565   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
      567     (input  v-event-code
      568     ,input  ub.ord-line.gds-code
      569     ,input  buf_ord-doc.cli-type
      570     ,input  buf_ord-doc.cli-code
      571     ,input  false
      572     ,output v-ok
      573     ,output v-mess
      574     ) no-error.
      575                 if v-ok = false then do:
      576                   if p-ask then
      577                   message
      578                     v-mess skip
      579                     "Товар не может быть включен в заказ " skip
      580                     "Заказ      :" buf_ord-doc.doc-code        skip
      581                     "код товара :" ub.ord-line.gds-code skip
      582                     "артикул    :" ub.ord-line.artic skip
      583                     view-as alert-box error .
      584                     return error substitute("izt &1" ,v-mess ) .
      585                 end.
      586           end.
      587     end.
      588   define variable o-host-code as integer   no-undo .
      589   define variable c-host-code as integer   no-undo .
      590   define variable o-base-code as integer   no-undo .
      591   define variable c-base-code as integer   no-undo .
      592   define variable v-find      as logical   no-undo .
      593   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      595     (input  buf_ord-doc.obj-type
      596     ,input  buf_ord-doc.obj-code
      597     ,output o-host-code
      598     )  .
      599   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      601     (input  buf_ord-doc.cli-type
      602     ,input  buf_ord-doc.cli-code
      603     ,output c-host-code
      604     )  .
      605   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      607     (input  o-host-code
      608     ,output o-base-code
      609     )  .
      610   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      612     (input  c-host-code
      613     ,output c-base-code
      614     )  .
      615   if o-base-code <> c-base-code then do:
      616     if p-ask then
      617     message "Контрагенты имеют разную базовую валюту. Создание заказа не возможно ! " view-as alert-box error .
      618     return error.
      619   end.
      620    case buf_ord-doc.status_ :
      621         when 'отказ':U then do:
      622         if p-ask then
      623           message
      624             "Нельзя закрыть заказ"
      625             "в статусе " caps(buf_ord-doc.status_)
      626             skip
      627             "Документ" buf_ord-doc.doc-code view-as alert-box information
      628             .
      629           return .
      630         end.
      631         when 'новый':U then do:
      632                 if can-find
      633                   ( first   t-doc-line no-lock where t-doc-line.doc-code  = buf_ord-doc.doc-code    and
      634                           ( t-doc-line.qnty  =  0 or t-doc-line.qnty  = ?)) then do:
      635                     if p-ask then
      636                         Message "В заказе есть строки с количеством равным 0 или ? ! "
      637                                 skip
      638                                 "Документ" buf_ord-doc.doc-code skip
      639                                 view-as alert-box error .
      640                     return error.
      641                 end.
      642                 if buf_ord-doc.ship-date < t-date then do:
      643                     g#log  = false .
      644                     if p-ask then
      645                         Message "Дата заказа меньше текущей даты ! " skip
      646                             string(buf_ord-doc.ship-date, "99/99/9999" ) skip
      647                             "Сегодня" string(t-date, "99/99/9999" )
      648                             skip
      649                             "Документ" buf_ord-doc.doc-code skip
      650                             " Будем закрывать ? "
      651                             view-as alert-box question
      652                             buttons yes-no
      653                             title "Закрыть заказ "
      654                             update g#log
      655                           .
      656                     if not g#log then return.
      657                 end.
      658                 find first  t-doc-line where t-doc-line.doc-code  = buf_ord-doc.doc-code no-lock no-error .
      659                 if not available t-doc-line then do:
      660                     if p-ask then
      661                     message "Заказ"  buf_ord-doc.doc-code  " не содержит ни одной записи ! "
      662                             view-as alert-box information  title "Внимание!!! " .
      663                     return.
      664                  end.
      665                 for each buf_ord-line exclusive-lock where buf_ord-line.doc-code = buf_ord-doc.doc-code :
      666                     buf_ord-line.order-qnty =  buf_ord-line.qnty .
      667                 end.
      668                 assign
      669                     buf_ord-doc.status_ = 'запрос':U
      670                     buf_ord-doc.flag_ = true
      671                     .
      672                 return.
      673           end.
      674          when 'запрос':U then do :
      675           find first obj_clients no-lock where
      676                      obj_clients.obj-type = buf_ord-doc.obj-type and
      677                      obj_clients.obj-code = buf_ord-doc.obj-code no-error .
      678           find first cli_clients no-lock where
      679                      cli_clients.obj-type = buf_ord-doc.cli-type and
      680                      cli_clients.obj-code = buf_ord-doc.cli-code no-error .
      681            if obj_clients.db-num = v-cntxt-db-num  and obj_clients.db-num <> cli_clients.db-num then do:
      682                     if p-ask then
      683                     message "Заказ передан на сторону контрагента. Перевод в другой статус невозможен" .
      684                     return.
      685            end.
      686            v-find = false .
      687            v-flaf-n = true .
      688             for each buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code ,
      689                 each ub.ord-chain no-lock where
      690                      ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
      691                      ub.ord-chain.doc-type = 'rcv'                    and
      692                      ub.ord-chain.rel-doc-type = 'trn' ,
      693                 first buf_trn-doc     no-lock where buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code :
      694                   for each buf_ord-line no-lock where buf_ord-line.doc-code = buf_ord-doc.doc-code :
      695                       find first buf_doc-line no-lock where
      696                             buf_doc-line.doc-code  = buf_trn-doc.doc-code and
      697                             buf_doc-line.artic     = buf_ord-line.artic      and
      698                             buf_doc-line.prod-type = buf_ord-line.prod-type  and
      699                             buf_doc-line.prod-code = buf_ord-line.prod-code
      700                       no-error .
      701                       if not available buf_doc-line then v-flaf-n = false .
      702                       else do:
      703                           if buf_doc-line.fact-qnty <> buf_ord-line.qnty then  v-flaf-n = false .
      704                       end.
      705                   end.
      706                   v-find = true  .
      707                   leave.
      708             end.
      709             if v-find = true then
      710               assign
      711                   buf_ord-doc.status_ = 'разрешено':U
      712                   buf_ord-doc.flag_ = v-flaf-n
      713                   .
      714             else do:
      715                   if p-ask then
      716                      message "Расходная Накладная не создана !!!" view-as alert-box information .
      717                      return.
      718             end.
      719             return .
      720           end.
      721          when 'разрешено':U then do :
      722               find first obj_clients no-lock where
      723                         obj_clients.obj-type = buf_ord-doc.obj-type and
      724                         obj_clients.obj-code = buf_ord-doc.obj-code no-error .
      725               find first cli_clients no-lock where
      726                         cli_clients.obj-type = buf_ord-doc.cli-type and
      727                         cli_clients.obj-code = buf_ord-doc.cli-code no-error .
      728               if obj_clients.db-num = v-cntxt-db-num and obj_clients.db-num <> cli_clients.db-num then do:
      729                         if p-ask then
      730                           message "Заказ передан на сторону контрагента. Перевод в другой статус невозможен"  .
      731                   return.
      732               end.
      733            define variable v-find2 as logical   no-undo .
      734            v-find2 = false .
      735             for each  buf_ord-doc-rcv no-lock where
      736                       buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code ,
      737                 each ub.ord-chain no-lock where
      738                      ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
      739                      ub.ord-chain.doc-type = 'rcv'                    and
      740                      ub.ord-chain.rel-doc-type = 'trn' ,
      741                 first buf_trn-doc     no-lock where
      742                       buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code and
      743                       buf_trn-doc.status_ = 'факт':U
      744                       :
      745                 v-find2 = true  .
      746                 leave.
      747              end.
      748             if v-find2  = true then do:
      749                v-find   = false .
      750                v-flaf-n = true  .
      751                   for each buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code ,
      752                       each ub.ord-chain no-lock where
      753                           ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
      754                           ub.ord-chain.doc-type = 'rcv'                    and
      755                           ub.ord-chain.rel-doc-type = 'trn' ,
      756                       first buf_trn-doc     no-lock where buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code and
      757                                                           buf_trn-doc.status_ = 'факт':U
      758                       :
      759                         for each buf_ord-line no-lock where buf_ord-line.doc-code = buf_ord-doc.doc-code :
      760                             find first buf_doc-line no-lock where
      761                                   buf_doc-line.doc-code  = buf_trn-doc.doc-code and
      762                                   buf_doc-line.artic     = buf_ord-line.artic      and
      763                                   buf_doc-line.prod-type = buf_ord-line.prod-type  and
      764                                   buf_doc-line.prod-code = buf_ord-line.prod-code
      765                             no-error .
      766                             if not available buf_doc-line then v-flaf-n = false .
      767                             else do:
      768                                 if buf_doc-line.fact-qnty <> buf_ord-line.qnty then  v-flaf-n = false .
      769                             end.
      770                         end.
      771                         v-find = true  .
      772                         leave.
      773                   end.
      774               assign
      775                   buf_ord-doc.status_ = 'отгружено':U
      776                   buf_ord-doc.flag_ = v-flaf-n
      777                   .
      778             end.
      779             else do:
      780                   if p-ask then
      781                      message "Приходная Накладная не создана !!!" view-as alert-box information .
      782                      return.
      783             end.
      784             return .
      785           end.
      786          when 'отгружено':U then do :
      787               for each t-ord-doc-rcv where  t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code no-lock :
      788                   for each ub.ord-chain no-lock where
      789                      ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      790                      ub.ord-chain.doc-type = 'rcv'                    and
      791                      ub.ord-chain.rel-doc-type = 'trn' :
      792                    for each t-trn-doc no-lock where
      793                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      794                             t-trn-doc.doc-type  = 'при':U and
      795                             t-trn-doc.status_  <> 'факт':U  :
      796                     if p-ask then
      797                     message "Документ ПН" t-trn-doc.doc-code " имеет статус " CAPS(t-trn-doc.status_)
      798                             "Закройте ПН до статуса ФАКТ " view-as alert-box error
      799                             title "Закрыть заказ "
      800                             .
      801                     return error.
      802                    end.
      803               end.
      804               end.
      805               for each t-ord-doc-rcv where  t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code no-lock :
      806                   for each ub.ord-chain no-lock where
      807                      ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      808                      ub.ord-chain.doc-type = 'rcv'                    and
      809                      ub.ord-chain.rel-doc-type = 'trn' :
      810                    for each t-trn-doc no-lock where
      811                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      812                             t-trn-doc.doc-type  = 'рас':U and
      813                             t-trn-doc.status_  <> 'факт':U  :
      814                     if p-ask then
      815                     message "Документ РН" t-trn-doc.doc-code " имеет статус " CAPS(t-trn-doc.status_)
      816                             "Закройте РН до статуса ФАКТ (создайте ПН) " view-as alert-box error
      817                             title "Закрыть заказ "
      818                             .
      819                     return error.
      820                    end.
      821               end.
      822               end.
      823               v-flaf-n = true .
      824               for each t-ord-doc-rcv where  t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code no-lock :
      825                   for each ub.ord-chain no-lock where
      826                      ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      827                      ub.ord-chain.doc-type = 'rcv'                    and
      828                      ub.ord-chain.rel-doc-type = 'trn' :
      829                    for each t-trn-doc no-lock where
      830                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      831                             t-trn-doc.doc-type  = 'при':U and
      832                             t-trn-doc.status_  = 'факт':U  :
      833                       for each buf_ord-line no-lock where buf_ord-line.doc-code = buf_ord-doc.doc-code :
      834                           find first buf_doc-line no-lock where
      835                                      buf_doc-line.doc-code  = t-trn-doc.doc-code and
      836                                      buf_doc-line.artic     = buf_ord-line.artic      and
      837                                      buf_doc-line.prod-type = buf_ord-line.prod-type  and
      838                                      buf_doc-line.prod-code = buf_ord-line.prod-code
      839                                      no-error .
      840                           if not available buf_doc-line then v-flaf-n = false .
      841                           else do:
      842                               if buf_doc-line.fact-qnty <> buf_ord-line.qnty then  v-flaf-n = false .
      843                           end.
      844                       end.
      845                    end.
      846                 end.
      847               end.
      848               assign
      849                 buf_ord-doc.status_ = 'факт':U
      850                 buf_ord-doc.flag_   = v-flaf-n
      851                 buf_ord-doc.fact-date = to-day.
      852               .
      853               for each t-ord-doc-rcv   exclusive-lock  where  t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code :
      854                   assign
      855                     t-ord-doc-rcv.status_   = 'факт':U
      856                     t-ord-doc-rcv.fact-date = to-day
      857                   .
      858               end.
      859             return .
      860           end.
      861    end case.
