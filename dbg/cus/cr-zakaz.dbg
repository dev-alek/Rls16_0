     3345   run create-temp-zakaz in this-procedure no-error.
     3346   procedure calc-temp-zakaz :
     3347   define input parameter p-calc-metod as character.
     3348   define input parameter p-ord-type   as character.
     3349   v-nn = num-entries(p-calc-metod) .
     3350     do i = 1 to v-nn :
     3351        case  entry(1,(entry(i,p-calc-metod)), "=" ) :
     3352           when string( "v-round-m" )              then v-round-m = entry(2,(entry(i,p-calc-metod)), "=" )           .
     3353           when string( "v-round-base" )           then v-round-base = decimal(entry(2,(entry(i,p-calc-metod)), "=" ) )          .
     3354           when string( "R-min-rest" )             then R-min-rest = integer(entry(2,(entry(i,p-calc-metod)), "=" )).
     3355           when string( "R-algoritm" )             then R-algoritm = integer(entry(2,(entry(i,p-calc-metod)), "=" )).
     3356           when string( "R-algoritm2" )            then R-algoritm2 = integer(entry(2,(entry(i,p-calc-metod)), "=" )).
     3357           when string( "tmp-sale.tmp-code" )      then do:
     3358                find first tmp-sale no-lock where tmp-sale.tmp-code = entry(2,(entry(i,p-calc-metod)), "=" ) no-error.
     3359                if available tmp-sale then do:
     3360                  p-code = tmp-sale.tmp-code.
     3361                end.
     3362                else do:
     3363                end.
     3364           end.
     3365           when string( "SelectObject" ) then  do:
     3366                   SelectObject = string(entry(2,(entry(i,p-calc-metod)), "=" )) no-error .
     3367                end.
     3368           when string( "date-p-1" )     then  date-p-1   = date(entry(2,(entry(i,p-calc-metod)), "=" )).
     3369           when string( "date-p-2" )     then  date-p-2   = date(entry(2,(entry(i,p-calc-metod)), "=" )).
     3370           when string( "t-way"   )      then  t-way      = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false.
     3371           when string( "t-rcv"   )      then  t-rcv      = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false.
     3372           when string( "t-clos"   )     then  t-clos     = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false.
     3373           when string( "t-rv"   )       then  t-rv       = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false.
     3374           when string( "t-rvz"  )       then  t-rvz      = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3375           when string( "t-rvc"  )       then  t-rvc      = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false  .
     3376           when string( "t-rvzc" )       then  t-rvzc     = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false  .
     3377           when string( "t-sp"   )       then  t-sp       = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false  .
     3378           when string( "t-sppv" )       then  t-sppv     = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false  .
     3379           when string( "t-sppv-2")      then  t-sppv-2   = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false.
     3380           when string( "t-sppv-3")      then  t-sppv-3   = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3381           when string( "t-sppv-4")      then  t-sppv-4   = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3382           when string( "p-neg-sale")    then  p-neg-sale = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3383           when string( "t-gar")         then  t-gar      = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3384           when string( "t-min-ost")     then  t-min-ost  = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3385           when string( "t-min-zapas")   then  t-min-zapas = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3386           when string( "R-min-rest3")   then  R-min-rest3 = if (entry(2,(entry(i,p-calc-metod)), "=" )) = "yes" then true else false .
     3387           otherwise do:
     3388           end.
     3389        end case.
     3390     end.
     3391     assign
     3392     pay-day = p-day-sale
     3393     .
     3394      run ord-mm in this-procedure .
     3395       if p-ord-type = 'ФП':U    then  do:
     3396         run cus/qnty-obj.p  (
     3397               input parparentproc
     3398             , input v-round-m
     3399             , input v-round-base
     3400             , input e-method
     3401             , input "":U
     3402             , input v#doc-code
     3403             , input date-p-1
     3404             , input date-p-2
     3405             , input ""
     3406             , input no
     3407             , input R-algoritm
     3408             , input R-algoritm2
     3409             , input R-min-rest
     3410             , input R-min-rest3
     3411             , input p-code
     3412             , input t-rv
     3413             , input t-rvz
     3414             , input t-rvc
     3415             , input t-rvzc
     3416             , input t-sp
     3417             , input t-sppv
     3418             , input t-sppv-2
     3419             , input t-sppv-3
     3420             , input t-sppv-4
     3421             , input t-way
     3422             , input t-rcv
     3423             , input t-clos
     3424             , input table tt-date
     3425             , input table temp-abc-day
     3426             , input p-neg-sale
     3427             , input t-gar
     3428             , input t-min-zapas
     3429             , input t-min-ost
     3430             , input v-cntxt-obj-type
     3431             , input v-cntxt-obj-code
     3432             , input p-ord-type
     3433             , input no
     3434             ) no-error .
     3435             if error-status :error then do:
     3436                 return error error-status :get-message(1) .
     3437             end.
     3438       end.
     3439       else  do:
     3440         run cus/qntysale.p (
     3441               input parparentproc
     3442             , input v-round-m
     3443             , input v-round-base
     3444             , input e-method
     3445             , input "":U
     3446             , input v#doc-code
     3447             , input date-p-1
     3448             , input date-p-2
     3449             , input ""
     3450             , input no
     3451             , input R-algoritm
     3452             , input R-algoritm2
     3453             , input R-min-rest
     3454             , input R-min-rest3
     3455             , input p-code
     3456             , input t-rv
     3457             , input t-rvz
     3458             , input t-rvc
     3459             , input t-rvzc
     3460             , input t-sp
     3461             , input t-sppv
     3462             , input t-sppv-2
     3463             , input t-sppv-3
     3464             , input t-sppv-4
     3465             , input t-way
     3466             , input t-rcv
     3467             , input t-clos
     3468             , input table tt-date
     3469             , input table temp-abc-day
     3470             , input p-neg-sale
     3471             , input t-gar
     3472             , input t-min-zapas
     3473             , input t-min-ost
     3474             , input v-cntxt-obj-type
     3475             , input v-cntxt-obj-code
     3476             , input p-ord-type
     3477             , input no
     3478             ) no-error .
     3479             if error-status :error then do:
     3480                 return error error-status :get-message(1) .
     3481             end.
     3482       end.
     3483   end procedure .
     3484   procedure create-ord-line :
     3485   define input parameter p-contract-code like ub.contract.contract-code no-undo.
     3486   define buffer buf_contract for ub.contract .
     3487   define variable v-e-m   as character no-undo .
     3488   define variable k            as   integer   no-undo init 0.
     3489   define variable is-edoc-nn-doc  as logical   no-undo .
     3490   define variable is-edi-doc      as logical   no-undo .
     3491   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     3493     (input  g#host-code
     3494     ,input  to-day
     3495     ,output v-base-rate
     3496     ,output v-base-scale
     3497     )  .
     3498     assign k = 0 .
     3499     for each tmp#zakaz no-lock
     3500      :
     3501         v-e-m = ''.
     3502         assign
     3503           k = k + 1
     3504         .
     3505         find first bf-units-cli where bf-units-cli.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     3506         create shar_ord-line no-error.
     3507         assign
     3508           shar_ord-line.doc-code    = v#doc-code
     3509           shar_ord-line.prod-type   = tmp#zakaz.prod-type
     3510           shar_ord-line.prod-code   = tmp#zakaz.prod-code
     3511           shar_ord-line.artic       = tmp#zakaz.artic
     3512           shar_ord-line.gds-code    = tmp#zakaz.gds-code
     3513           shar_ord-line.cli-art     = tmp#zakaz.cli-art
     3514           shar_ord-line.qnty        = tmp#zakaz.qnty
     3515           shar_ord-line.order-qnty  = tmp#zakaz.qnty
     3516           shar_ord-line.initial-qnty  = tmp#zakaz.qnty
     3517           shar_ord-line.cli-qnty    = ( if lookup('шту':U, bf-units-cli.type) > 0
     3518             and  trunc (tmp#zakaz.qnty / tmp#zakaz.cli-base-rate, 0) <> tmp#zakaz.qnty / tmp#zakaz.cli-base-rate
     3519             then trunc (tmp#zakaz.qnty / tmp#zakaz.cli-base-rate, 0)
     3520             else tmp#zakaz.qnty / tmp#zakaz.cli-base-rate )
     3521           shar_ord-line.price-cli   = tmp#zakaz.price-cli * tmp#zakaz.cli-base-rate
     3522           shar_ord-line.sum-cli     = shar_ord-line.price-cli * shar_ord-line.cli-qnty
     3523           shar_ord-line.price-rubl  = tmp#zakaz.price-cli
     3524           shar_ord-line.price-base  = ( tmp#zakaz.price-cli ) / v-base-rate * v-base-scale
     3525           shar_ord-line.sum-rubl    = shar_ord-line.price-rubl * shar_ord-line.qnty
     3526           shar_ord-line.sum-base    = shar_ord-line.price-base * shar_ord-line.qnty
     3527           shar_ord-line.unit-cli    = tmp#zakaz.unit-cli
     3528           shar_ord-line.line-num    = k
     3529           shar_ord-line.vat-pc      = tmp#zakaz.vat-pc
     3530           .
     3531     end.
     3532     find first for-cli no-lock
     3533          where for-cli.obj-code = p-cli-code
     3534            and for-cli.obj-type = p-cli-type
     3535            no-error.
     3536     create shar_ord-doc.
     3537     assign
     3538         shar_ord-doc.doc-code     = v#doc-code
     3539         shar_ord-doc.doc-date     = to-day
     3540         shar_ord-doc.cli-code     = for-cli.obj-code
     3541         shar_ord-doc.cli-name     = for-cli.obj-name
     3542         shar_ord-doc.cli-type     = for-cli.obj-type
     3543         shar_ord-doc.creid        = "автозаказ"
     3544         shar_ord-doc.agnt         = ?
     3545         shar_ord-doc.boss         = ?
     3546         shar_ord-doc.fact-date    = ?
     3547         shar_ord-doc.pay-code     = g#out-pay
     3548         shar_ord-doc.ship-date    = to-day + p-day-before-rvs
     3549         shar_ord-doc.sum-service  = 0
     3550         shar_ord-doc.sum-ship     = 0
     3551         shar_ord-doc.flag_        = false
     3552         shar_ord-doc.status_      = 'новый':U
     3553         shar_ord-doc.wrkr         = ?
     3554         shar_ord-doc.host-code    = g#host-code
     3555         shar_ord-doc.doc-type     = p-g#type
     3556         shar_ord-doc.order-type   = 0
     3557         shar_ord-doc.cycle-day    = 0
     3558         shar_ord-doc.start-date   = to-day + p-day-before-rvs
     3559         shar_ord-doc.end-date     = max (to-day, to-day + p-day-before-rvs + p-day-sale - 1)
     3560         shar_ord-doc.date-sale-1  = to-day + p-day-before-rvs
     3561         shar_ord-doc.date-sale-2  = max (to-day, to-day + p-day-before-rvs + p-day-sale - 1)
     3562         shar_ord-doc.pay-day      = p-day-sale
     3563         shar_ord-doc.obj-code     = v-cntxt-obj-code
     3564         shar_ord-doc.obj-type     = v-cntxt-obj-type
     3565         shar_ord-doc.slt-type     = 'без':U
     3566         shar_ord-doc.vat-type     = 'в т. ч.':U
     3567         shar_ord-doc.exch-code    = loc-exch-code
     3568         shar_ord-doc.exch-date    = to-day
     3569         shar_ord-doc.e-method     = v-e-m
     3570         shar_ord-doc.base-rate    = v-base-rate
     3571         shar_ord-doc.base-scale   = v-base-scale
     3572         shar_ord-doc.tot-lines    = k
     3573         .
     3574       find ub.currency where ub.currency.curr-code = 0 no-lock no-error.
     3575       find last ub.curr-accnt where ub.curr-accnt.curr-code = ub.currency.curr-code  use-index pi no-lock no-error.
     3576         if available ub.curr-accnt then
     3577             assign
     3578               shar_ord-doc.exch-rate  = ub.curr-accnt.exch-rate
     3579               shar_ord-doc.exch-scale = ub.curr-accnt.exch-scale
     3580             .
     3581        find first buf_contract no-lock
     3582             where buf_contract.contract-code = p-contract-code
     3583               and buf_contract.host-code = g#host-code
     3584               no-error.
     3585        if available buf_contract then do:
     3586          assign shar_ord-doc.contract-code = buf_contract.contract-code.
     3587        end.
     3588     if p-send-esys and p-g#type = 'ОП':U then do:
     3589       if can-find (first shar_ord-line
     3590                    where shar_ord-line.doc-code = shar_ord-doc.doc-code
     3591                      and ( shar_ord-line.cli-art  = ""
     3592                       or shar_ord-line.cli-art  = ? )
     3593                    ) then do:
     3594        return error
     3595          substitute("в заказе есть линия без артикула поставщика &1 &2&3&4, &5 заказ не может быть направлен по EDI\EDOC",
     3596            shar_ord-line.artic
     3597          , shar_ord-line.prod-type
     3598          , shar_ord-line.prod-code
     3599          , shar_ord-line.cli-art
     3600          , chr(10)
     3601          )
     3602        .
     3603       end.
     3604       for each shar_ord-line
     3605          where shar_ord-line.doc-code = shar_ord-doc.doc-code
     3606         :
     3607         if can-find (first ub.ord-line where ub.ord-line.doc-code = shar_ord-doc.doc-code
     3608            and recid(shar_ord-line) <> recid (ub.ord-line)
     3609            and shar_ord-line.cli-art = ub.ord-line.cli-art
     3610         ) then do:
     3611           return error
     3612            substitute( "в заказе есть линии c одинаковым артикулом поставщика &1 &2&3&4, &5 заказ не может быть направлен по EDI\EDOC",
     3613            shar_ord-line.artic
     3614          , shar_ord-line.prod-type
     3615          , shar_ord-line.prod-code
     3616          , shar_ord-line.cli-art
     3617          , chr(10)
     3618           )
     3619           .
     3620         end.
     3621       end.
     3622       assign
     3623       is-edoc-nn-doc = status-is-edoc-nn ( input is-edoc-nn
     3624                                           , input p-cli-type
     3625                                           , input p-cli-code
     3626                                           , input p-obj-type
     3627                                           , input p-obj-code
     3628                                           ) .
     3629       assign
     3630       is-edi-doc = status-is-edi ( input is-edi
     3631                                   , input p-cli-type
     3632                                   , input p-cli-code
     3633                                   , input p-obj-type
     3634                                   , input p-obj-code
     3635                                   , output v-dm-edi
     3636                                   ) .
     3637       if ( is-edoc-nn-doc and shar_ord-doc.ord-int1 = integer('0':U) )
     3638       or ( is-edi-doc     and shar_ord-doc.ord-int1 = integer('0':U)  ) and
     3639         shar_ord-doc.doc-type = 'ОП':U and
     3640         shar_ord-doc.status_  = 'новый':U
     3641       then do:
     3642           if is-edoc-nn-doc then do :
     3643             assign
     3644               shar_ord-doc.whole-send-news = integer('1':U)
     3645             .
     3646           end.
     3647           if is-edi-doc then do :
     3648             assign
     3649               shar_ord-doc.whole-send-news = integer('2':U)
     3650             .
     3651           end.
     3652           run cus/edocsord.p (  input parParentProc
     3653                               , input recid(shar_ord-doc)
     3654                               , input 'ord-doc':U
     3655                               , input yes
     3656                               )  .
     3657       end.
     3658     end.
     3659   end procedure.
     3660   procedure create-temp-zakaz :
     3661   define variable v-not-contract   as logical no-undo.
     3662   define variable v-i              as integer no-undo.
     3663   define variable v-iTmp           as integer no-undo init 0 extent 3.
     3664   define variable v-contract-code  as integer no-undo.
     3665   define variable v-host-code      as integer no-undo.
     3666   define variable v-iTmp1          as integer no-undo init 0 extent 3.
     3667   define variable v-contract-code1 as integer no-undo.
     3668   define variable v-host-code1     as integer no-undo.
     3669   define buffer bf_contract  for ub.contract .
     3670   define buffer buf_goods    for ub.goods .
     3671   define buffer bf1_contract for ub.contract .
     3672   define buffer bf1_contract-specif for ub.contract-specif .
     3673   assign v-not-contract = true.
     3674   for each bf_contract no-lock
     3675       where bf_contract.cli-code = p-cli-code
     3676         and bf_contract.cli-type = p-cli-type
     3677         and bf_contract.status_ = 'тек':U
     3678         and bf_contract.host-code = g#host-code
     3679         and not bf_contract.contract-date-beg > loc-date-ship
     3680         and ( bf_contract.contract-date-end = ? or not bf_contract.contract-date-end < loc-date-ship )
     3681         and not p-g#type = 'ОФ':U
     3682         and (p-contra-code = 0 or p-contra-code = ? or bf_contract.contract-code = p-contra-code)
     3683         break by bf_contract.contract-date-beg
     3684   :
     3685     assign
     3686       v-not-contract  = false
     3687       v-contract-code = bf_contract.contract-code
     3688       v-host-code     = bf_contract.host-code
     3689     .
     3690      run MS-Contract-EXTENT-3 in this-procedure(
     3691          bf_contract.host-code,
     3692          bf_contract.contract-code,
     3693          output v-iTmp ).
     3694      if v-iTmp[1] = 2 then do:
     3695         assign
     3696           v-host-code     = v-iTmp[2]
     3697           v-contract-code = v-iTmp[3]
     3698         .
     3699      end.
     3700     _contract-specif :
     3701     for each buf_contract-specif no-lock
     3702       where buf_contract-specif.contract-num = v-contract-code
     3703         and buf_contract-specif.host-code = v-host-code
     3704     :
     3705         for each bf1_contract no-lock
     3706             where bf1_contract.cli-code = p-cli-code
     3707               and bf1_contract.cli-type = p-cli-type
     3708               and bf1_contract.status_ = 'тек':U
     3709               and bf1_contract.host-code = g#host-code
     3710               and recid(bf1_contract) <> recid(bf_contract)
     3711               and bf1_contract.contract-date-beg > bf_contract.contract-date-beg
     3712               :
     3713               assign
     3714                 v-contract-code1 = bf1_contract.contract-code
     3715                 v-host-code1     = bf1_contract.host-code
     3716               .
     3717               run MS-Contract-EXTENT-3 in this-procedure(
     3718                   bf1_contract.host-code,
     3719                   bf1_contract.contract-code,
     3720                   output v-iTmp1 ).
     3721               if v-iTmp1[1] = 2 then do:
     3722                  assign
     3723                    v-host-code1     = v-iTmp1[2]
     3724                    v-contract-code1 = v-iTmp1[3]
     3725                  .
     3726               end.
     3727               if can-find (first bf1_contract-specif
     3728                           where bf1_contract-specif.contract-num = v-contract-code1
     3729                             and bf1_contract-specif.host-code = v-host-code1
     3730                             and bf1_contract-specif.gds-code  = buf_contract-specif.gds-code
     3731               ) then do:
     3732                 next _contract-specif.
     3733               end.
     3734         end.
     3735       do v-i = 1 to num-entries(p-grp-code):
     3736          for each goods no-lock
     3737          where goods.artic     = buf_contract-specif.artic
     3738            and goods.prod-code = buf_contract-specif.prod-code
     3739            and goods.prod-type = buf_contract-specif.prod-type
     3740            and goods.grp-code  = int(entry(v-i, p-grp-code))
     3741            :
     3742            run fill-temp-zakaz in this-procedure (
     3743                input goods.gds-code
     3744                , input ?
     3745                , input v-contract-code
     3746                , input v-host-code
     3747            ) no-error.
     3748          end.
     3749       end.
     3750     end.
     3751     if can-find (first tmp#zakaz ) then do:
     3752   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3753   run proc-ord-code in this-procedure
     3754    (input   'main' ,
     3755     input   v-cntxt-db-num ,
     3756     input   v-cntxt-obj-type ,
     3757     input   v-cntxt-obj-code ,
     3758     input   v-i-doc ,
     3759     output  v#doc-code
     3760    ) .
     3761       run calc-temp-zakaz in this-procedure (
     3762           input p-val
     3763         , input p-g#type
     3764         ) no-error.
     3765       for each tmp#zakaz where p-delnull and tmp#zakaz.qnty = 0 :
     3766         delete tmp#zakaz.
     3767       end.
     3768       for each tmp#zakaz where p-addextart and tmp#zakaz.cli-art  = ""
     3769                       or tmp#zakaz.cli-art  = ?:
     3770         delete tmp#zakaz.
     3771       end.
     3772       for each tmp#zakaz:
     3773         if p-g#type <> 'ПО':U
     3774           and p-g#type <> 'ФП':U  then
     3775         do:
     3776           var-ok-assort-pol = true .
     3777   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3778   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     3779     (input  p-g#type
     3780     ,input  tmp#zakaz.gds-code
     3781     ,input  p-obj-type
     3782     ,input  p-obj-code
     3783     ,input  false
     3784     ,output var-ok-assort-pol
     3785     ,output var-mess-assort-pol
     3786     ) .
     3787           if var-ok-assort-pol = false then
     3788           do:
     3789             delete tmp#zakaz .
     3790           end.
     3791         end.
     3792       end.
     3793       if can-find (first tmp#zakaz ) then do:
     3794           run create-ord-line in this-procedure (
     3795               input v-contract-code
     3796            ) no-error.
     3797           if not error-status:error then do:
     3798              run write-log-and-file in p-log-handle (
     3799                 input 1
     3800               , input log-file-name
     3801               , input 1
     3802               , input "Создан заказ N " + v#doc-code ) .
     3803           end.
     3804           else do:
     3805              run write-log-and-file in p-log-handle (
     3806                 input 1
     3807               , input log-file-name
     3808               , input 1
     3809               , input "Ошибка создания: " + return-value ) .
     3810           end.
     3811       end.
     3812       for each tmp#zakaz :
     3813         delete tmp#zakaz.
     3814       end.
     3815     end.
     3816   end.
     3817   if v-not-contract then do:
     3818     if p-g#type = 'ОП':U or p-g#type = 'ФП':U then do:
     3819         for each cli-gds no-lock
     3820         where cli-gds.cli-code = p-cli-code
     3821         and cli-gds.cli-type = p-cli-type
     3822         :
     3823            do v-i = 1 to num-entries(p-grp-code):
     3824                for each buf_goods no-lock
     3825                where buf_goods.artic     = cli-gds.artic
     3826                  and buf_goods.prod-code = cli-gds.prod-code
     3827                  and buf_goods.prod-type = cli-gds.prod-type
     3828                  and buf_goods.grp-code  = int(entry(v-i, p-grp-code))
     3829                  :
     3830                  run fill-temp-zakaz in this-procedure (
     3831                      input buf_goods.gds-code
     3832                    , input recid(cli-gds)
     3833                    , input ?
     3834                    , input ?
     3835                  ) .
     3836                end.
     3837            end.
     3838         end.
     3839     end.
     3840     else do:
     3841        do v-i = 1 to num-entries(p-grp-code):
     3842            for each buf_goods no-lock
     3843            where buf_goods.grp-code  = int(entry(v-i, p-grp-code))
     3844              :
     3845              run fill-temp-zakaz-rc in this-procedure (
     3846                  input buf_goods.gds-code
     3847              ) .
     3848            end.
     3849        end.
     3850     end.
     3851     if can-find (first tmp#zakaz ) then do:
     3852   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3853   run proc-ord-code in this-procedure
     3854    (input   'main' ,
     3855     input   v-cntxt-db-num ,
     3856     input   v-cntxt-obj-type ,
     3857     input   v-cntxt-obj-code ,
     3858     input   v-i-doc ,
     3859     output  v#doc-code
     3860    ) .
     3861       run calc-temp-zakaz in this-procedure (
     3862           input p-val
     3863         , input p-g#type
     3864         ) no-error.
     3865       for each tmp#zakaz where p-delnull and tmp#zakaz.qnty = 0 :
     3866         delete tmp#zakaz.
     3867       end.
     3868       for each tmp#zakaz where p-addextart and tmp#zakaz.cli-art  = ""
     3869                       or tmp#zakaz.cli-art  = ?:
     3870         delete tmp#zakaz.
     3871       end.
     3872       for each tmp#zakaz:
     3873         if p-g#type <> 'ПО':U
     3874           and p-g#type <> 'ФП':U  then
     3875         do:
     3876           var-ok-assort-pol = true .
     3877   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3878   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     3879     (input  p-g#type
     3880     ,input  tmp#zakaz.gds-code
     3881     ,input  p-obj-type
     3882     ,input  p-obj-code
     3883     ,input  false
     3884     ,output var-ok-assort-pol
     3885     ,output var-mess-assort-pol
     3886     ) .
     3887           if var-ok-assort-pol = false then
     3888           do:
     3889             delete tmp#zakaz .
     3890           end.
     3891         end.
     3892       end.
     3893       if can-find (first tmp#zakaz ) then do:
     3894           run create-ord-line in this-procedure (
     3895               input ?
     3896             ) no-error.
     3897           if not error-status:error then do:
     3898              run write-log-and-file in p-log-handle (
     3899                 input 1
     3900               , input log-file-name
     3901               , input 1
     3902               , input "Создан заказ N " + v#doc-code ) .
     3903           end.
     3904           else do:
     3905              run write-log-and-file in p-log-handle (
     3906                 input 1
     3907               , input log-file-name
     3908               , input 1
     3909               , input "Ошибка создания: " + return-value ) .
     3910           end.
     3911       end.
     3912       for each tmp#zakaz :
     3913         delete tmp#zakaz.
     3914       end.
     3915     end.
     3916   end.
     3917   end procedure.
     3918   procedure fill-temp-zakaz :
     3919   define input parameter p-gds-code like ub.goods.gds-code no-undo.
     3920   define input parameter p-recid    as recid no-undo.
     3921   define input parameter p-contract-code like ub.contract.contract-code no-undo.
     3922   define input parameter p-host-code as integer no-undo.
     3923   define buffer ll-tmp#zakaz for tmp#zakaz .
     3924   define buffer bufff-units  for ub.units  .
     3925   define buffer sb-cli-gds   for ub.cli-gds  .
     3926   define buffer buf_contract for ub.contract  .
     3927   define buffer buf_contract-specif for ub.contract-specif  .
     3928   define variable max-num as integer no-undo .
     3929   for each goods no-lock
     3930   where goods.gds-code = p-gds-code
     3931   :
     3932   find first tmp#zakaz
     3933        where tmp#zakaz.prod-type = goods.prod-type
     3934          and tmp#zakaz.prod-code = goods.prod-code
     3935          and tmp#zakaz.artic     = goods.artic
     3936          no-error.
     3937     if not available tmp#zakaz then do:
     3938       assign max-num = 0.
     3939       for each  ll-tmp#zakaz  where ll-tmp#zakaz.doc-code = loc-ord-num and
     3940                                     ll-tmp#zakaz.gds-code <> goods.gds-code :
     3941           if max-num < ll-tmp#zakaz.line-num then
     3942              max-num = ll-tmp#zakaz.line-num .
     3943       end.
     3944       create tmp#zakaz .
     3945       assign
     3946         tmp#zakaz.doc-code        = loc-ord-num
     3947         tmp#zakaz.prod-type       = goods.prod-type
     3948         tmp#zakaz.prod-code       = goods.prod-code
     3949         tmp#zakaz.artic           = goods.artic
     3950         tmp#zakaz.line-num        = max-num + 1
     3951       .
     3952     end.
     3953     assign
     3954       tmp#zakaz.doc-code        = loc-ord-num
     3955       tmp#zakaz.gds-code        = goods.gds-code
     3956       tmp#zakaz.gds-name        = goods.gds-name
     3957       tmp#zakaz.negative-rest   = goods.negative-rest
     3958       tmp#zakaz.deadline        = goods.deadline
     3959       tmp#zakaz.unit-base       = goods.unit-base
     3960       tmp#zakaz.unit-cli        = goods.unit-cli
     3961       tmp#zakaz.cli-base-rate   = goods.cli-base-rate
     3962       tmp#zakaz.ms-cart         = goods.qnty-cart
     3963       .
     3964     find first ext-artic no-lock
     3965           where ext-artic.cli-type    = p-cli-type
     3966             and ext-artic.cli-code    = p-cli-code
     3967             and ext-artic.gds-code    = goods.gds-code
     3968             and ext-artic.status_    <> 'удал':U no-error .
     3969     if available ext-artic then do:
     3970       assign tmp#zakaz.cli-art = ext-artic.ext-artic.
     3971     end.
     3972     else do:
     3973       assign tmp#zakaz.cli-art = ''.
     3974     end.
     3975     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     3976     if available bufff-units then
     3977     assign tmp#zakaz.unit-type       = bufff-units.type .
     3978     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     3979     if available bufff-units then
     3980     assign tmp#zakaz.unit-cli-type   = bufff-units.type .
     3981     if p-recid <> ? then do:
     3982       find first sb-cli-gds where recid(sb-cli-gds) = p-recid no-lock no-error .
     3983       if available sb-cli-gds then do:
     3984             assign
     3985               tmp#zakaz.cancel-date     = sb-cli-gds.cancel-date
     3986               tmp#zakaz.in-qnty         = sb-cli-gds.in-qnty
     3987               tmp#zakaz.out-qnty        = sb-cli-gds.out-qnty
     3988               tmp#zakaz.ret-qnty        = sb-cli-gds.ret-qnty
     3989               tmp#zakaz.in-base         = sb-cli-gds.in-base
     3990               tmp#zakaz.in-rubl         = sb-cli-gds.in-rubl
     3991               tmp#zakaz.out-sum         = sb-cli-gds.out-sum
     3992               tmp#zakaz.ret-sum         = sb-cli-gds.ret-sum
     3993               tmp#zakaz.in-code         = sb-cli-gds.in-code
     3994               tmp#zakaz.last-curr-code  = sb-cli-gds.exch-code
     3995               tmp#zakaz.supp-qnty       = sb-cli-gds.supp-qnty
     3996               tmp#zakaz.supp-base       = sb-cli-gds.supp-base
     3997               tmp#zakaz.supp-rubl       = sb-cli-gds.supp-rubl
     3998               loc-exch-code             = sb-cli-gds.exch-code
     3999             .
     4000             find first buf_doc-line no-lock where
     4001                       buf_doc-line.doc-code  = sb-cli-gds.in-code and
     4002                       buf_doc-line.artic     = sb-cli-gds.artic and
     4003                       buf_doc-line.prod-type = sb-cli-gds.prod-type and
     4004                       buf_doc-line.prod-code = sb-cli-gds.prod-code
     4005                       no-error .
     4006             if available buf_doc-line  then do:
     4007                 assign
     4008                   tmp#zakaz.unit-cli        = buf_doc-line.unit-cli
     4009                   tmp#zakaz.cli-base-rate   = buf_doc-line.cli-base-rate
     4010                   .
     4011             end.
     4012       end.
     4013   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4014   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4015     (input  goods.gds-code
     4016     ,input  '1':U
     4017     ,input  ?
     4018     ,input  g#host-code
     4019     ,input  p-obj-type
     4020     ,input  p-obj-code
     4021     ,output tmp#zakaz.vat-pc
     4022     ) no-error .
     4023       if error-status :error then return error error-status :get-message(1) .
     4024       run last-price (
     4025           input  g#host-code ,
     4026           input  tmp#zakaz.artic ,
     4027           input  tmp#zakaz.prod-type ,
     4028           input  tmp#zakaz.prod-code ,
     4029           input  p-cli-code  ,
     4030           input  p-cli-type  ,
     4031           input  tmp#zakaz.cli-base-rate ,
     4032           input  loc-exch-code ,
     4033           output tmp#zakaz.price-base ,
     4034           output tmp#zakaz.price-rubl ,
     4035           output tmp#zakaz.price-cli   )
     4036       no-error  .
     4037     end.
     4038     else do:
     4039   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4041     (input  g#host-code
     4042     ,input  to-day
     4043     ,output loc-exch-rate
     4044     ,output loc-base-scale
     4045     )  .
     4046       for each buf_contract no-lock
     4047          where buf_contract.contract-code = p-contract-code
     4048            and buf_contract.host-code     = p-host-code ,
     4049           first buf_contract-specif no-lock
     4050          where buf_contract-specif.contract-num = p-contract-code
     4051            and buf_contract-specif.host-code    = p-host-code
     4052            and buf_contract-specif.gds-code     = goods.gds-code
     4053            :
     4054             assign
     4055             loc-exch-code           = buf_contract.curr-code
     4056             tmp#zakaz.vat-pc        = buf_contract-specif.vat-pc
     4057             tmp#zakaz.price-cli     = buf_contract-specif.price-cli
     4058             tmp#zakaz.cli-base-rate = buf_contract-specif.cli-base-rate
     4059             tmp#zakaz.unit-cli      = buf_contract-specif.unit-base
     4060             .
     4061       end.
     4062     end.
     4063   end.
     4064   end procedure.
     4065   procedure fill-temp-zakaz-rc :
     4066   define input parameter p-gds-code like ub.goods.gds-code no-undo.
     4067   define buffer ll-tmp#zakaz for tmp#zakaz .
     4068   define buffer bufff-units  for ub.units  .
     4069   define variable max-num as integer no-undo .
     4070   for each goods no-lock
