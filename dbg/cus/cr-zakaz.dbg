      377   def
      378    shared
      379   temp-table  obj-list no-undo
      380     field obj-type like ub.clients.obj-type
      381     field obj-code like ub.clients.obj-code
      382     field obj-name like ub.clients.obj-name
      383     field obj-id   as integer
      384     field db-num   as integer
      385     index pi is primary unique obj-id
      386     index ie1 obj-type obj-code
      387     index ie2 obj-name
      388   .
      389   procedure create_obj-list :
      390      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      391      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      392      do
      393      on error undo, return error return-value
      394      :
      395         define buffer cli-obj for ub.clients .
      396         define variable p-var as integer no-undo .
      397         define buffer buf_obj-list for obj-list .
      398         find last buf_obj-list  use-index pi no-error .
      399         if available buf_obj-list
      400         then
      401            p-var = buf_obj-list.obj-id + 1.
      402         else
      403            p-var = 1.
      404         find first cli-obj where
      405                   cli-obj.obj-type = p-obj-type
      406               and cli-obj.obj-code = p-obj-code
      407         no-lock no-error.
      408         if available cli-obj
      409         then do:
      410            create buf_obj-list.
      411            assign
      412               buf_obj-list.obj-id   = p-var
      413               buf_obj-list.obj-code = cli-obj.obj-code
      414               buf_obj-list.obj-type = cli-obj.obj-type
      415               buf_obj-list.obj-name = cli-obj.obj-name
      416               buf_obj-list.db-num   = cli-obj.db-num
      417            .
      418         end.
      419      end.
      420   end.
      421   define  shared temp-table X-init_obj-list no-undo
      422   field obj-type like ub.clients.obj-type
      423   field obj-code like ub.clients.obj-code
      424   index pi is unique primary obj-type obj-code.
