      820   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   procedure cur-time :
      822      define output parameter p-today as date      no-undo .
      823      define output parameter p-time  as integer   no-undo .
      824     do
      825     on error undo, return error
      826     :
      827       define variable v-date1 as date      no-undo .
      828       define variable v-date2 as date      no-undo .
      829       define variable v-time  as integer   no-undo .
      830       assign
      831         v-date1 = today
      832         v-time  = time
      833         v-date2 = today
      834       .
      835       if v-date1 <> v-date2
      836       then do:
      837         assign
      838           v-date1 = today
      839           v-time  = v-time
      840         .
      841       end.
      842       assign
      843         p-today = v-date1
      844         p-time  = v-time
      845       .
      846     end.
      847   end.
      848   function cur-time-date returns character
      849   :
      850     return string(today, '99/99/9999':U) .
      851   end.
      852   function cur-time-mjd returns decimal
      853   :
      854     define variable v-date as date      no-undo .
      855     define variable v-time as integer   no-undo .
      856     run cur-time in this-procedure
      857       (output v-date
      858       ,output v-time
      859       ) .
      860     return integer(v-date) - 2400002 + (v-time / 86400) .
      861   end.
      862   function cur-time-get-ending-index returns integer
      863   (input p-number as integer
      864   )
      865   :
      866     if p-number < 0
      867     or p-number = ?
      868     then do:
      869       return 1 .
      870     end.
      871     define variable v-rest as integer   no-undo .
      872     assign
      873       p-number = p-number modulo 100
      874     .
      875     if p-number < 20
      876     then do:
      877       assign
      878         v-rest = p-number
      879       .
      880     end.
      881     else do:
      882       assign
      883         v-rest = p-number modulo 10
      884       .
      885     end.
      886     case v-rest :
      887       when 1
      888       then do:
      889         return 2 .
      890       end.
      891       when 2 or
      892       when 3 or
      893       when 4
      894       then do:
      895         return 3 .
      896       end.
      897       otherwise do:
      898         return 1 .
      899       end.
      900     end case .
      901   end.
      902   procedure cur-time-mjd-to-date :
      903      define input  parameter i-mjd-diff as decimal no-undo.
      904      define output parameter o-Date     as date    no-undo.
      905      define output parameter o-Time     as integer no-undo.
      906      define variable v-day-number as integer   no-undo .
      907      if    i-mjd-diff < 0
      908         or i-mjd-diff = ?
      909      then do:
      910         return "?" .
      911      end.
      912      assign
      913         v-day-number = truncate(i-mjd-diff,0).
      914         o-Date = date(v-day-number + 2400002).
      915         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      916     .
      917   end.
      918   function cur-time-mjd-to-string returns character
      919   (input p-mjd-diff as decimal
      920   )
      921   :
      922     define variable v-day-number as integer   no-undo .
      923     define variable v-seconds    as integer   no-undo .
      924     define variable v-hour       as integer   no-undo .
      925     define variable v-min        as integer   no-undo .
      926     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      927     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      928     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      929     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      930     if p-mjd-diff < 0
      931     or p-mjd-diff = ?
      932     then do:
      933       return "?" .
      934     end.
      935     assign
      936       v-day-number = integer(truncate(p-mjd-diff,0))
      937       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      938     .
      939     if v-seconds > 86400
      940     then do:
      941       assign
      942         v-seconds = 86400 - 1
      943       .
      944     end.
      945     if v-seconds < 0
      946     then do:
      947       assign
      948         v-seconds = 0
      949       .
      950     end.
      951     assign
      952       v-hour = truncate(v-seconds / 3600, 0)
      953     .
      954     assign
      955       v-seconds = v-seconds modulo 3600
      956     .
      957     assign
      958       v-min = truncate(v-seconds / 60, 0)
      959     .
      960     assign
      961       v-seconds = v-seconds modulo 60
      962     .
      963     return
      964         (if v-day-number <> 0
      965           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      966           else ""
      967         )
      968       + (if v-day-number <> 0 or v-hour <> 0
      969           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      970           else ""
      971         )
      972       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      973           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      974           else ""
      975         )
      976       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      977       .
      978   end.
      979   function cur-time-string returns character
      980   :
      981     define variable v-date as date      no-undo .
      982     define variable v-time as integer   no-undo .
      983     run cur-time in this-procedure
      984       (output v-date
      985       ,output v-time
      986       ) .
      987     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      988   end.
      989   function cur-time-string-sec returns character
      990   :
      991     define variable v-date as date      no-undo .
      992     define variable v-time as integer   no-undo .
      993     run cur-time in this-procedure
      994       (output v-date
      995       ,output v-time
      996       ) .
      997     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      998   end.
      999   function cur-time-custom  returns character
     1000   (input p-prefix as character
     1001   ,input p-date-format as character
     1002   ,input p-delimiter as character
     1003   ,input p-time-format as character
     1004   ,input p-suffix as character
     1005   )
     1006   :
     1007     define variable v-date as date      no-undo .
     1008     define variable v-time as integer   no-undo .
     1009     run cur-time in this-procedure
     1010       (output v-date
     1011       ,output v-time
     1012       ) .
     1013     return
     1014       p-prefix
     1015       + string(v-date, p-date-format)
     1016       + p-delimiter
     1017       + string(v-time, p-time-format)
     1018       + p-suffix
     1019       .
     1020   end.
     1021   function cur-time-print  returns character
     1022   :
     1023     define variable v-date as date      no-undo .
     1024     define variable v-time as integer   no-undo .
     1025     run cur-time in this-procedure
     1026       (output v-date
     1027       ,output v-time
     1028       ) .
     1029     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1030   end.
     1031   function cur-time-datetime returns datetime
     1032   :
     1033     define variable v-char as character no-undo .
     1034     define variable v-datetime as datetime no-undo .
     1035     v-char = cur-time-string().
     1036     v-datetime = datetime(v-char).
     1037     return  v-datetime.
     1038   end.
     1039   function cur-time-string-msec returns character
     1040   :
     1041     define variable v-date as datetime  no-undo .
     1042     v-date = now.
     1043     return string(v-date) .
     1044   end.
