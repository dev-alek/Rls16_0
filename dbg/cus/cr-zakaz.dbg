     1491      define output parameter p-user-can-edit  as logical   no-undo .
     1492      define output parameter p-output-display as logical   no-undo .
     1493      define output parameter p-other          as character no-undo .
     1494      define output parameter p-prop-list      as character no-undo .
     1495      define output parameter p-prop-type-list as character no-undo .
     1496      define output parameter p-prop-label-list as character no-undo .
     1497      define output parameter p-global          as logical no-undo .
     1498      define output parameter p-host           as logical no-undo .
     1499      define output parameter p-shop           as logical no-undo .
     1500      define output parameter p-store          as logical no-undo .
     1501      define output parameter p-db             as logical no-undo .
     1502      define variable p-region as logical no-undo.
     1503      run thbjattr_code_reg in this-procedure (
     1504                                               p-upper-code,
     1505                                               p-code,
     1506                                               output p-label,
     1507                                               output p-user-can-edit,
     1508                                               output p-output-display,
     1509                                               output p-other,
     1510                                               output p-prop-list,
     1511                                               output p-prop-type-list,
     1512                                               output p-prop-label-list,
     1513                                               output p-global,
     1514                                               output p-host,
     1515                                               output p-shop,
     1516                                               output p-store,
     1517                                               output p-db,
     1518                                               output p-region
     1519                                               ).
     1520   end procedure.
     1521   procedure thbjattr_code_reg :
     1522   define input  parameter p-upper-code     as character no-undo .
     1523   define input  parameter p-code           as character no-undo .
     1524   define output parameter p-label          as character no-undo .
     1525   define output parameter p-user-can-edit  as logical   no-undo .
     1526   define output parameter p-output-display as logical   no-undo .
     1527   define output parameter p-other          as character no-undo .
     1528   define output parameter p-prop-list      as character no-undo .
     1529   define output parameter p-prop-type-list as character no-undo .
     1530   define output parameter p-prop-label-list as character no-undo .
     1531   define output parameter p-global          as logical no-undo .
     1532   define output parameter p-host           as logical no-undo .
     1533   define output parameter p-shop           as logical no-undo .
     1534   define output parameter p-store          as logical no-undo .
     1535   define output parameter p-db             as logical no-undo .
     1536   define output parameter p-region         as logical no-undo .
     1537   do
     1538   on error undo, return error return-value
     1539   :
     1540       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1541       (input  p-upper-code
     1542       ,input  p-code
     1543       ,output p-label
     1544       ,output p-user-can-edit
     1545       ,output p-output-display
     1546       ,output p-other
     1547       ,output p-prop-list
     1548       ,output p-prop-type-list
     1549       ,output p-prop-label-list
     1550       ,output p-global
     1551       ,output p-host
     1552       ,output p-shop
     1553       ,output p-store
     1554       ,output p-db
     1555       ,output p-region
     1556       ) no-error .
     1557     if error-status :error
     1558     then do:
     1559       undo, return error substitute( "&1. &2&3&4", vss-include-info14, return-value, chr(10), error-status :get-message (1)).
     1560     end.
     1561   end.
     1562   end procedure.
