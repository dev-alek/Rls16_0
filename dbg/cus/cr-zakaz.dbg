     2790        where buf_clients.obj-type = p-cli-type
     2791          and buf_clients.obj-code = p-cli-code
     2792          no-error .
     2793   if not available buf_clients then do:
     2794     return no .
     2795   end.
     2796   run gen-key-rec IN THIS-PROCEDURE ( input 'clients':U
     2797                                     , input (buffer buf_clients:handle)
     2798                                     , output v-uniq-key-rec).
     2799   find first buf_ext-classif no-lock
     2800        where buf_ext-classif.uniq-key-rec    = v-uniq-key-rec
     2801          and buf_ext-classif.classif-subject = 'clients':U
     2802          and buf_ext-classif.classif-name    = 'clients-edoc-nn':U
     2803          no-error.
     2804   if available buf_ext-classif then do :
     2805     return yes .
     2806   end.
     2807   return no.
     2808   END FUNCTION.
     2809   FUNCTION status-is-edi RETURN logical ( input p-is-edi as logical
     2810                                            , input p-cli-type as character
     2811                                            , input p-cli-code as integer
     2812                                            , input p-obj-type     as character
     2813                                            , input p-obj-code     as integer
     2814                                            , output p-dm-edi as integer
     2815                                            ) .
     2816   define variable v-obj-db-num   as integer   no-undo .
     2817   define variable v-uniq-key-rec as character no-undo .
     2818   define variable v-obj-uniq-key-rec as character no-undo .
     2819   define buffer buf_clients     for ub.clients .
     2820   define buffer obj_clients     for ub.clients .
     2821   define buffer buf_ext-classif for ub.ext-classif .
     2822   define buffer buf2_ext-classif for ub.ext-classif .
     2823   define buffer buf_ext-system  for ub.ext-system  .
     2824   if not p-is-edi then do:
     2825     return no.
     2826   end.
     2827   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2828   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2829     (input  p-obj-type
     2830     ,input  p-obj-code
     2831     ,output v-obj-db-num
     2832     )  .
     2833   find first buf_clients no-lock
     2834        where buf_clients.obj-type = p-cli-type
     2835          and buf_clients.obj-code = p-cli-code
     2836          no-error .
     2837   if not available buf_clients then do:
