     4092       .
     4093     end.
     4094     assign
     4095       tmp#zakaz.doc-code        = loc-ord-num
     4096       tmp#zakaz.gds-code        = goods.gds-code
     4097       tmp#zakaz.gds-name        = goods.gds-name
     4098       tmp#zakaz.negative-rest   = goods.negative-rest
     4099       tmp#zakaz.deadline        = goods.deadline
     4100       tmp#zakaz.unit-base       = goods.unit-base
     4101       tmp#zakaz.unit-cli        = goods.unit-cli
     4102       tmp#zakaz.cli-base-rate   = goods.cli-base-rate
     4103       tmp#zakaz.ms-cart         = goods.qnty-cart
     4104       .
     4105       assign tmp#zakaz.cli-art = ''.
     4106     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     4107     if available bufff-units then
     4108     assign tmp#zakaz.unit-type       = bufff-units.type .
     4109     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     4110     if available bufff-units then
     4111     assign tmp#zakaz.unit-cli-type   = bufff-units.type .
