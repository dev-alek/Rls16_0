     1436   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1437   procedure proc-ord-code :
     1438   define input  parameter  p-type as character no-undo .
     1439   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1440   define input  parameter  v-cntxt-obj-type as character no-undo .
     1441   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1442   define input  parameter  p-i-doc    as character no-undo .
     1443   define output parameter  p-ord-doc  as character no-undo .
     1444   define variable          v-idop     as character no-undo .
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448   case p-type :
     1449       when "main-no-ver" then do:
     1450         if  (v-cntxt-db-num <> 0) then
     1451           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1452         else
     1453           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1454       end.
     1455       when "main" then do:
     1456             do while true:
     1457             if  (v-cntxt-db-num <> 0) then
     1458               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1459             else
     1460               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1461             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1462             End.
     1463       end.
     1464       when "chip" then do:
     1465         assign
     1466           v-idop = p-i-doc .
     1467         do while true :
     1468           if index (v-idop , ".") = 0 then
     1469             v-idop  = replace (v-idop , "-", "-1.").
     1470           else
     1471             v-idop  =
     1472             substring (v-idop , 1, index (v-idop, "-")) +
     1473             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1474             substring (v-idop, index (v-idop, ".")).
     1475           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1476         end.
     1477         assign
     1478           p-ord-doc = v-idop.
     1479       end.
     1480   end case.
     1481     end.
     1482   end procedure.
     1483   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1484   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1485   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
