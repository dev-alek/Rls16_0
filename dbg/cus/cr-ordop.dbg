        1   block-level on error undo, throw.
        2   define input  parameter  parParentProc   AS WIDGET-HANDLE NO-UNDO.
        3   define input  parameter  par-ord-type    as character no-undo .
        4   define input  parameter  par-cli-code    as integer   no-undo .
        5   define input  parameter  par-cli-type    as character no-undo .
        6   define input  parameter  par-date-post   as date   no-undo .
        7   define input  parameter  par-date-1      as date   no-undo .
        8   define input  parameter  par-date-2      as date   no-undo .
        9   define input  parameter  p-recid         as character no-undo .
       10   define output parameter  par-ord-doc-recid  as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cr-ordop.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: cus/cr-ordop.p $":U .
       16   define variable vss-description as character no-undo init "создание заказа".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure create-ord-line :
       88   define input parameter  p-doc-code       like ub.ord-doc.doc-code         no-undo .
       89   define input parameter  p-line-num       like ub.ord-line.line-num        no-undo .
       90   define input parameter  p-artic          like ub.ord-line.artic           no-undo .
       91   define input parameter  p-prod-code      like ub.ord-line.prod-code       no-undo .
       92   define input parameter  p-prod-type      like ub.ord-line.prod-type       no-undo .
       93   define input parameter  p-cli-base-rate  like ub.ord-line.cli-base-rate   no-undo .
       94   define input parameter  p-qnty           like ub.ord-line.qnty            no-undo .
       95   define input parameter  p-unit-cli       like ub.ord-line.unit-cli        no-undo .
       96    do
       97    on error undo, return error return-value
       98    :
       99    define variable p-cli-qnty               like ub.ord-line.cli-qnty        no-undo .
      100    define buffer bbb_ord-doc for ub.ord-doc  .
      101    define buffer tt-goods for ub.goods       .
      102    find first bbb_ord-doc where bbb_ord-doc.doc-code = p-doc-code no-lock no-error .
      103    if error-status :error then do:
      104         message vss-workfile vss-revision vss-description skip
      105                 error-status :get-message(1)
      106                 view-as alert-box error .
      107                 undo, return error.
      108    end.
      109    find first tt-goods where
      110         tt-goods.artic             =   p-artic          and
      111         tt-goods.prod-code         =   p-prod-code      and
      112         tt-goods.prod-type         =   p-prod-type      no-lock no-error .
      113    if error-status :error then do:
      114         message vss-workfile vss-revision vss-description skip
      115                 error-status :get-message(1)
      116                 view-as alert-box error .
      117                 undo, return error.
      118    end.
      119   find first ub.ord-line where ub.ord-line.artic     = tt-goods.artic     and
      120                             ub.ord-line.prod-type = tt-goods.prod-type and
      121                             ub.ord-line.prod-code = tt-goods.prod-code and
      122                             ub.ord-line.doc-code  = p-doc-code   exclusive-lock    no-error.
      123   if not available ub.ord-line then do:
      124     create  ub.ord-line.
      125   end.
      126         assign
      127           ub.ord-line.gds-code       = tt-goods.gds-code
      128           ub.ord-line.doc-code       = p-doc-code
      129           ub.ord-line.line-num       = p-line-num
      130           ub.ord-line.artic          = p-artic
      131           ub.ord-line.prod-code      = p-prod-code
      132           ub.ord-line.prod-type      = p-prod-type
      133           ub.ord-line.cli-base-rate  = p-cli-base-rate
      134           ub.ord-line.qnty           = p-qnty
      135           ub.ord-line.cli-qnty       = ub.ord-line.qnty  / ub.ord-line.cli-base-rate
      136           ub.ord-line.unit-cli       = p-unit-cli
      137       .
      138    if ub.ord-line.price-rubl = 0 or ub.ord-line.price-rubl = ? then
      139    run last-price in this-procedure (
      140         input  bbb_ord-doc.host-code ,
      141         input  ub.ord-line.artic ,
      142         input  ub.ord-line.prod-type ,
      143         input  ub.ord-line.prod-code ,
      144         input  bbb_ord-doc.cli-code  ,
      145         input  bbb_ord-doc.cli-type  ,
      146         input  ub.ord-line.cli-base-rate ,
      147         input  bbb_ord-doc.exch-code ,
      148         output ub.ord-line.price-base ,
      149         output ub.ord-line.price-rubl ,
      150         output ub.ord-line.price-cli   )
      151         no-error  .
      152         if error-status :error then
      153         message
      154           vss-workfile vss-revision vss-description skip
      155           error-status :get-message(1) skip
      156           return-value skip
      157           ""
      158           view-as alert-box error
      159         .
      160   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      162     (input  tt-goods.gds-code
      163     ,input  '1':U
      164     ,input  ?
      165     ,input  bbb_ord-doc.host-code
      166     ,input  bbb_ord-doc.obj-type
      167     ,input  bbb_ord-doc.obj-code
      168     ,output ub.ord-line.vat-pc
      169     ) no-error .
      170     if error-status :error then
      171     message
      172       vss-workfile vss-revision vss-description skip
      173       error-status :get-message(1) skip
      174       return-value skip
      175       ""
      176       view-as alert-box error
      177     .
      178        ub.ord-line.sum-rubl = ub.ord-line.qnty * ub.ord-line.price-rubl .
      179        ub.ord-line.sum-base = ub.ord-line.qnty * ub.ord-line.price-base .
      180        ub.ord-line.sum-cli  = ub.ord-line.cli-qnty * ub.ord-line.price-cli .
      181    end.
      182   end procedure.
      183   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   procedure last-price :
      185   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      186   define input parameter  p-host-code     as integer no-undo .
      187   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
      188   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
      189   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
      190   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
      191   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
      192   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
      193   define input parameter  p-curr-code  as integer   no-undo .
      194   define output parameter p-price-base like ub.doc-line.price-base no-undo .
      195   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
      196   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
      197   define buffer buf-lib-doc-line for ub.doc-line.
      198   define buffer buf_cli-gds for ub.cli-gds .
      199   define buffer buf_trn-doc for ub.trn-doc  .
      200   define variable vp-curr-code  like ub.trn-doc.exch-code.
      201   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
      202   define variable vp-exch-scale like ub.trn-doc.exch-scale.
      203   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
      204   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
      205   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
      206   define variable v-cli-base-rate as decimal   no-undo .
      207    find first buf_cli-gds no-lock where
      208               buf_cli-gds.cli-type   = p-cli-type    and
      209               buf_cli-gds.cli-code   = p-cli-code    and
      210               buf_cli-gds.host-code  = p-host-code   and
      211               buf_cli-gds.artic      = p-artic       and
      212               buf_cli-gds.prod-type  = p-prod-type   and
      213               buf_cli-gds.prod-code  = p-prod-code
      214               no-error .
      215   if available buf_cli-gds then do:
      216       find first buf_trn-doc no-lock
      217            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
      218        if available buf_trn-doc then do:
      219           vp-curr-code  = buf_trn-doc.exch-code.
      220           vp-exch-rate  = buf_trn-doc.exch-rate.
      221           vp-exch-scale = buf_trn-doc.exch-scale.
      222        end.
      223       find first buf-lib-doc-line no-lock
      224         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
      225           and buf-lib-doc-line.artic     = p-artic
      226           and buf-lib-doc-line.prod-type = p-prod-type
      227           and buf-lib-doc-line.prod-code = p-prod-code
      228         no-error .
      229   end.
      230   else do:
      231   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      233     (input  p-host-code
      234     ,input  p-artic
      235     ,input  p-prod-type
      236     ,input  p-prod-code
      237     ,output v-last-in-code
      238     ,output v-last-obj-type
      239     ,output v-last-obj-code
      240     )  .
      241       find first buf_trn-doc no-lock
      242            where buf_trn-doc.doc-code  = v-last-in-code no-error .
      243        if available buf_trn-doc then do:
      244           vp-curr-code  = buf_trn-doc.exch-code.
      245           vp-exch-rate  = buf_trn-doc.exch-rate.
      246           vp-exch-scale = buf_trn-doc.exch-scale.
      247        end.
      248       find first buf-lib-doc-line no-lock
      249         where buf-lib-doc-line.doc-code  = v-last-in-code
      250           and buf-lib-doc-line.artic     = p-artic
      251           and buf-lib-doc-line.prod-type = p-prod-type
      252           and buf-lib-doc-line.prod-code = p-prod-code
      253         no-error .
      254   end.
      255       if available buf-lib-doc-line then do:
      256         assign
      257           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
      258           p-price-base = buf-lib-doc-line.price-base
      259           p-price-rubl = buf-lib-doc-line.price-rubl
      260           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
      261         .
      262         if v-cli-base-rate <> p-cli-base-rate
      263         then do:
      264             p-price-cli  = p-price-cli / v-cli-base-rate  .
      265         end.
      266          if p-curr-code <> vp-curr-code then do:
      267             p-price-cli  = p-price-rubl  .
      268         end.
      269       end.
      270       Else do:
      271         assign
      272           p-price-base = 0
      273           p-price-rubl = 0
      274           p-price-cli  = 0
      275         .
      276       end.
      277     end.
      278   end procedure.
      279   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      280   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   define new global shared variable g#attr-lib  as handle no-undo .
      282   define variable v-attr-lib-variable as handle no-undo .
      283   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      284   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
