      417       (input  p-obj-type
      418       ,input  p-obj-code
      419       ,input  p-upper-code
      420       ,input  p-code
      421       ,output p-value-character
      422       ,output p-value-date
      423       ,output p-value-decimal
      424       ,output p-value-integer
      425       ,output p-value-logical
      426       ,output p-type
      427       ,output p-found
      428       ) no-error .
      429     if error-status :error
      430     then do:
      431       undo, return error return-value .
      432     end.
      433   end.
      434   end procedure.
