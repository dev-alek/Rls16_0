     1143   procedure calc-zakz :
     1144     do
     1145     on error undo, return error return-value
     1146     :
     1147   define output parameter par-ord-qnty as decimal   no-undo .
     1148   define variable v-temp      as decimal   no-undo .
     1149   define variable v-min-stock as decimal   no-undo .
     1150   define variable v-min-order as decimal   no-undo .
     1151   define variable v-qnty-stk  as decimal   no-undo .
     1152   define variable v-corr-coeff as decimal  no-undo init 1.
     1153   define variable       v-neg-sale     as logical   no-undo .
     1154   define variable       v-gds-way-all  as decimal   no-undo .
     1155   define variable       v-min-zapas    as logical   no-undo .
     1156   define variable       v-min-ost      as logical   no-undo .
     1157   define variable       v-deadline     as logical   no-undo .
     1158   define variable p-return-AssMin         as logical   no-undo .
     1159   define variable p-return-igt            as character no-undo .
     1160   define variable p-grop-max-stock        as decimal   no-undo .
     1161   define variable p-grop-level-always-presence     as decimal   no-undo .
     1162   define variable to-day        as date      no-undo .
     1163   define variable vs-min-stock  as decimal   no-undo .
     1164   define variable vs-min-order  as decimal   no-undo .
     1165   pay-day  = par-date-2 - par-date-1  + 1 .
     1166   all-day = pay-day .
     1167   if par-ord-type = 'ОП':U then do:
     1168       find first buf_abc-analysis-gds-obj no-lock where
     1169                  buf_abc-analysis-gds-obj.abc-id   =  buf_abc-analysis-obj.abc-id and
     1170                  buf_abc-analysis-gds-obj.db-num   =  buf_abc-analysis-obj.db-num and
     1171                  buf_abc-analysis-gds-obj.obj-code =  buf_abc-analysis-obj.obj-code and
     1172                  buf_abc-analysis-gds-obj.obj-type =  buf_abc-analysis-obj.obj-type and
     1173                  buf_abc-analysis-gds-obj.gds-code =  buf_goods.gds-code
     1174                  no-error .
     1175     if available buf_abc-analysis-gds-obj then do:
     1176   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1178     (input  buf_abc-analysis-gds-obj.obj-type
     1179     ,input  buf_abc-analysis-gds-obj.obj-code
     1180     ,input  ?
     1181     ,input  ?
     1182     ,input  ?
     1183     ,input  buf_abc-analysis-gds-obj.gds-code
     1184     ,output p-return-AssMin
     1185     ,output p-return-igt
     1186     ,output v-min-stock
     1187     ,output p-grop-max-stock
     1188     ,output p-grop-level-always-presence
     1189     ,output v-min-order
     1190     )  .
     1191   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1193     (input  buf_abc-analysis-gds-obj.obj-type
     1194     ,input  buf_abc-analysis-gds-obj.obj-code
     1195     ,output to-day
     1196     )  .
     1197       ship-day = par-date-post - to-day .
     1198       v-temp     = buf_abc-analysis-gds-obj.abog-temp-sale-goods.
     1199       v-qnty-stk = buf_abc-analysis-gds-obj.abog-stock-qnty .
     1200   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1201   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     1202   Assign
     1203     l-Ostatok-today =  v-qnty-stk
     1204     l-negative-rest =  buf_goods.negative-rest
     1205     l-qnty-day      =  ship-day
     1206     l-pay-day       =  pay-day
     1207     l-Temp-rash     = if v-temp < 0  then 0 else v-temp
     1208     l-min-zap       =  v-min-stock
     1209     l-negative-sale =  v-neg-sale
     1210     l-goods-way     =  v-gds-way-all
     1211     l-tog-min-order =  v-min-zapas
     1212     l-min-order     =  v-min-order
     1213     loc-unit-base   =  buf_goods.unit-base
     1214     l-min-ost       =  v-min-ost
     1215     l-TOG-deadline  =  v-deadline
     1216     l-deadline      =  buf_goods.deadline
     1217     l-type-MR       =  v-e-method
     1218     l-corr-coeff    =  v-corr-coeff
     1219     .
     1220   if l-Temp-rash = ? then l-Temp-rash = 0.
     1221     if par-ord-min-ost = yes then do:
     1222       assign l-min-zap = l-Temp-rash * l-corr-coeff * v-min-stock .
     1223     end.
     1224     assign L-a = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * l-qnty-day) .
     1225     if L-a  <= 0 then do:
     1226       if l-negative-rest = true then do:
     1227         if l-negative-sale then do:
     1228           Assign
     1229             l-a = 0
     1230             l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     1231           .
     1232         end.
     1233         else do:
     1234           assign l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff).
     1235         end.
     1236       end.
     1237       else do:
     1238         Assign
     1239           l-a = 0
     1240           l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     1241         .
     1242       end.
     1243     end.
     1244     Else do :
     1245       assign l-b = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * (l-qnty-day + l-pay-day ) ) .
     1246             if l-b >= l-min-zap then l-order = 0.
     1247                                 else DO:
     1248                                 If l-b < 0 Then l-order = absolute(l-b) + l-min-zap.
     1249                                            Else l-order = l-min-zap - absolute(l-b).
     1250                                 End.
     1251      End.
     1252    assign
     1253     v-protocol-date = today
     1254     v-protocol-time = time
     1255    .
     1256   if is-log = true then  put stream stream_order unformatted
     1257   ">> Базовый способ расчета заказа "  v-protocol-date " " string(v-protocol-time,"hh:mm:ss") skip
     1258      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     1259      "Остаток на сегодня:" l-Ostatok-today skip
     1260      "Отриц.остатки     :" l-negative-rest skip
     1261      "дней до доставки  :" l-qnty-day      skip
     1262      "дней в продаже    :" l-pay-day       skip
     1263      "Темп продаж       :" l-Temp-rash     skip
     1264      "Коррект.коэфф.    :" l-corr-coeff    skip
     1265      "Дней без продажи  :" l-null-day      skip
     1266      "MIN остаток       :" l-min-zap       skip
     1267      "отриц.продажа     :" l-negative-sale skip
     1268      "рассчитано заказа :" l-order         skip
     1269      "_________________  "                 skip
     1270      "min заказ         :" l-min-order     skip
     1271      "товар в пути      :" l-goods-way     skip
     1272      "срок хранения     :" l-deadline      skip
     1273      .
     1274   l-type-MR = entry(2, entry(1,l-type-MR,";"),":") no-error .
     1275   if l-type-MR = ? then l-type-MR = "Базовый способ расчета заказа" .
     1276   v-stroka-protocol = "" .
     1277   v-stroka-protocol =
     1278      "00.Метод расчета заказа:" + l-type-MR  + chr(4) +
     1279      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     1280      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     1281      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     1282      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     1283      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     1284      "05.1>>Коррект.коэфф. :" + string(l-corr-coeff   ) + chr(4) +
     1285      "06.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     1286      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     1287      "08.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     1288      "09.рассчитано заказа :" + string(l-order        ) + chr(4) +
     1289      "10.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     1290      "11.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     1291      "12.срок хранения     :" + string(l-deadline     ) + chr(4) .
     1292     v-media-qnty = l-order .
     1293     if (l-order - l-goods-way) < 0 then
     1294        par-ord-qnty = 0 .
     1295     else
     1296        par-ord-qnty = l-order - l-goods-way .
     1297    assign v-stroka-protocol = v-stroka-protocol + "13.1>>После учета товара в пути:" + string(par-ord-qnty) + chr(4)  .
     1298     if l-min-ost = true then do:
     1299         if l-Ostatok-today > l-min-zap then
     1300             par-ord-qnty = 0 .
     1301         assign v-stroka-protocol = v-stroka-protocol + "13.2>>После проверки на MIN остаток:" + string(par-ord-qnty) + chr(4)  .
     1302     end.
     1303   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     1304       and lookup('шту':U, ub.units.type) > 0)
     1305       and trunc( par-ord-qnty, 0 ) <> par-ord-qnty then do:
     1306           par-ord-qnty = trunc( par-ord-qnty, 0 ) + 1 .
     1307           assign v-stroka-protocol = v-stroka-protocol + "13.3>>После округления до штук + 1:" + string(par-ord-qnty) + chr(4)  .
     1308       end.
     1309     if  l-deadline > 0 and l-tog-deadline = true   then do:
     1310        par-ord-qnty = min(par-ord-qnty, l-Temp-rash * l-deadline ) .
     1311        v-stroka-protocol = v-stroka-protocol + "13.4>>После проверки на срок хронения:" + string(par-ord-qnty) + chr(4)  .
     1312    end .
     1313    if l-tog-min-order then do:
     1314     if ( par-ord-qnty - l-min-order) < 0 and l-min-order > 0 then
     1315        par-ord-qnty = 0 .
     1316        assign v-stroka-protocol = v-stroka-protocol + "13.5>>После проверки на MIN заказ:" + string(par-ord-qnty) + chr(4)  .
     1317    end .
     1318   if par-ord-qnty = ? then par-ord-qnty = 0 .
     1319   if is-log = true then  put STREAM  stream_order unformatted "Итого (БЕЗ ОКР)"  par-ord-qnty skip
     1320    .
     1321   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     1322    assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(par-ord-qnty) .
     1323      end.
     1324   end.
     1325   if par-ord-type = 'ФП':U then do:
     1326   v-temp     = 0 .
     1327   v-qnty-stk = 0 .
     1328   vs-min-stock = 0 .
     1329   vs-min-order = 0 .
     1330       for each   buf_abc-analysis-obj no-lock where
     1331                  buf_abc-analysis-obj.abc-id =  v-abc-id and
     1332                  buf_abc-analysis-obj.db-num =  v-abc-db-num
     1333                  :
     1334   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1336     (input  buf_abc-analysis-obj.obj-type
     1337     ,input  buf_abc-analysis-obj.obj-code
     1338     ,input  ?
     1339     ,input  ?
     1340     ,input  ?
     1341     ,input  buf_goods.gds-code
     1342     ,output p-return-AssMin
     1343     ,output p-return-igt
     1344     ,output v-min-stock
     1345     ,output p-grop-max-stock
     1346     ,output p-grop-level-always-presence
     1347     ,output v-min-order
     1348     )  .
     1349       vs-min-stock  = vs-min-stock + v-min-stock .
     1350       vs-min-order  = vs-min-order + v-min-order.
     1351       v-temp     = v-temp     +  buf_abc-analysis-goods.abcg-temp-sale-goods.
     1352       v-qnty-stk = v-qnty-stk +  buf_abc-analysis-goods.abcg-stock-qnty .
     1353   end.
     1354   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1355   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     1356   Assign
     1357     l-Ostatok-today =  v-qnty-stk
     1358     l-negative-rest =  buf_goods.negative-rest
     1359     l-qnty-day      =  ship-day
     1360     l-pay-day       =  pay-day
     1361     l-Temp-rash     = if v-temp < 0  then 0 else v-temp
     1362     l-min-zap       =  vs-min-stock
     1363     l-negative-sale =  v-neg-sale
     1364     l-goods-way     =  v-gds-way-all
     1365     l-tog-min-order =  v-min-zapas
     1366     l-min-order     =  vs-min-order
     1367     loc-unit-base   =  buf_goods.unit-base
     1368     l-min-ost       =  v-min-ost
     1369     l-TOG-deadline  =  v-deadline
     1370     l-deadline      =  buf_goods.deadline
     1371     l-type-MR       =  v-e-method
     1372     l-corr-coeff    =  v-corr-coeff
     1373     .
     1374   if l-Temp-rash = ? then l-Temp-rash = 0.
     1375     if par-ord-min-ost = yes then do:
     1376       assign l-min-zap = l-Temp-rash * l-corr-coeff * vs-min-stock .
     1377     end.
     1378     assign L-a = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * l-qnty-day) .
     1379     if L-a  <= 0 then do:
     1380       if l-negative-rest = true then do:
     1381         if l-negative-sale then do:
     1382           Assign
     1383             l-a = 0
     1384             l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     1385           .
     1386         end.
     1387         else do:
     1388           assign l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff).
     1389         end.
     1390       end.
     1391       else do:
     1392         Assign
     1393           l-a = 0
     1394           l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     1395         .
     1396       end.
     1397     end.
     1398     Else do :
     1399       assign l-b = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * (l-qnty-day + l-pay-day ) ) .
     1400             if l-b >= l-min-zap then l-order = 0.
     1401                                 else DO:
     1402                                 If l-b < 0 Then l-order = absolute(l-b) + l-min-zap.
     1403                                            Else l-order = l-min-zap - absolute(l-b).
     1404                                 End.
     1405      End.
     1406    assign
     1407     v-protocol-date = today
     1408     v-protocol-time = time
     1409    .
     1410   if is-log = true then  put stream stream_order unformatted
     1411   ">> Базовый способ расчета заказа "  v-protocol-date " " string(v-protocol-time,"hh:mm:ss") skip
     1412      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     1413      "Остаток на сегодня:" l-Ostatok-today skip
     1414      "Отриц.остатки     :" l-negative-rest skip
     1415      "дней до доставки  :" l-qnty-day      skip
     1416      "дней в продаже    :" l-pay-day       skip
     1417      "Темп продаж       :" l-Temp-rash     skip
     1418      "Коррект.коэфф.    :" l-corr-coeff    skip
     1419      "Дней без продажи  :" l-null-day      skip
     1420      "MIN остаток       :" l-min-zap       skip
     1421      "отриц.продажа     :" l-negative-sale skip
     1422      "рассчитано заказа :" l-order         skip
     1423      "_________________  "                 skip
     1424      "min заказ         :" l-min-order     skip
     1425      "товар в пути      :" l-goods-way     skip
     1426      "срок хранения     :" l-deadline      skip
     1427      .
     1428   l-type-MR = entry(2, entry(1,l-type-MR,";"),":") no-error .
     1429   if l-type-MR = ? then l-type-MR = "Базовый способ расчета заказа" .
     1430   v-stroka-protocol = "" .
     1431   v-stroka-protocol =
     1432      "00.Метод расчета заказа:" + l-type-MR  + chr(4) +
     1433      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     1434      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     1435      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     1436      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     1437      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     1438      "05.1>>Коррект.коэфф. :" + string(l-corr-coeff   ) + chr(4) +
     1439      "06.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     1440      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     1441      "08.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     1442      "09.рассчитано заказа :" + string(l-order        ) + chr(4) +
     1443      "10.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     1444      "11.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     1445      "12.срок хранения     :" + string(l-deadline     ) + chr(4) .
     1446     v-media-qnty = l-order .
     1447     if (l-order - l-goods-way) < 0 then
     1448        par-ord-qnty = 0 .
     1449     else
     1450        par-ord-qnty = l-order - l-goods-way .
     1451    assign v-stroka-protocol = v-stroka-protocol + "13.1>>После учета товара в пути:" + string(par-ord-qnty) + chr(4)  .
     1452     if l-min-ost = true then do:
     1453         if l-Ostatok-today > l-min-zap then
     1454             par-ord-qnty = 0 .
     1455         assign v-stroka-protocol = v-stroka-protocol + "13.2>>После проверки на MIN остаток:" + string(par-ord-qnty) + chr(4)  .
     1456     end.
     1457   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     1458       and lookup('шту':U, ub.units.type) > 0)
     1459       and trunc( par-ord-qnty, 0 ) <> par-ord-qnty then do:
     1460           par-ord-qnty = trunc( par-ord-qnty, 0 ) + 1 .
     1461           assign v-stroka-protocol = v-stroka-protocol + "13.3>>После округления до штук + 1:" + string(par-ord-qnty) + chr(4)  .
     1462       end.
     1463     if  l-deadline > 0 and l-tog-deadline = true   then do:
     1464        par-ord-qnty = min(par-ord-qnty, l-Temp-rash * l-deadline ) .
     1465        v-stroka-protocol = v-stroka-protocol + "13.4>>После проверки на срок хронения:" + string(par-ord-qnty) + chr(4)  .
     1466    end .
     1467    if l-tog-min-order then do:
     1468     if ( par-ord-qnty - l-min-order) < 0 and l-min-order > 0 then
     1469        par-ord-qnty = 0 .
     1470        assign v-stroka-protocol = v-stroka-protocol + "13.5>>После проверки на MIN заказ:" + string(par-ord-qnty) + chr(4)  .
     1471    end .
     1472   if par-ord-qnty = ? then par-ord-qnty = 0 .
     1473   if is-log = true then  put STREAM  stream_order unformatted "Итого (БЕЗ ОКР)"  par-ord-qnty skip
     1474    .
     1475   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     1476    assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(par-ord-qnty) .
     1477   end.
     1478     end.
     1479   end procedure.
