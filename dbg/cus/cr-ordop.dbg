      573   define variable l-qnty-day       as integer   no-undo .
      574   define variable l-pay-day        as integer   no-undo .
      575   define variable l-Temp-rash      as decimal   no-undo .
      576   define variable l-null-day       as integer   no-undo init 0 .
      577   define variable l-min-zap        as decimal   no-undo .
      578   define variable l-order          as decimal   no-undo .
      579   define variable l-a              as decimal   no-undo .
      580   define variable l-b              as decimal   no-undo .
      581   define variable l-negative-sale  as logical   no-undo .
      582   define variable l-goods-way      as decimal   no-undo .
      583   define variable l-min-order      as decimal   no-undo .
      584   define variable l-tog-min-order  as logical   no-undo .
      585   define variable loc-unit-base    as character no-undo .
      586   define variable l-min-ost        as logical   no-undo .
      587   define variable l-tog-deadline   as logical   no-undo .
      588   define variable l-deadline       as integer   no-undo .
      589   define variable l-type-MR        as character no-undo .
      590   define variable par-ord-min-ost  as logical   no-undo .
      591   define variable v-media-qnty     as decimal   no-undo .
      592   define variable l-corr-coeff     as decimal   no-undo .
      593   define stream stream_order .
      594   define variable is-log             as logical   no-undo .
      595   define variable p-val              as character no-undo .
      596   define variable p-type             as character no-undo .
      597   define variable v-value-character  as character no-undo .
      598   define variable v-value-date       as date      no-undo .
      599   define variable v-value-decimal    as decimal   no-undo .
      600   define variable v-value-integer    as integer   no-undo .
      601   define variable v-stroka-protocol  as character no-undo .
      602   define variable v-protocol-date    as date      no-undo .
      603   define variable v-protocol-time    as integer   no-undo .
      604   run adm/shattri.p (
      605     input "get":U
      606     ,input ""
      607     ,input 0
      608     ,input 'ord-global':U
      609     ,input 'ord-log':U
      610     ,output v-value-character
      611     ,output v-value-date
      612     ,output v-value-decimal
      613     ,output v-value-integer
      614     ,output is-log
      615     ,output p-type
      616     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      617     ) no-error .
      618     if error-status :error then is-log = false .
      619   run adm/shattri.p (
      620     input "get":U
      621     ,input ""
      622     ,input 0
      623     ,input 'ord-global':U
      624     ,input 'ord-min-ost-day':U
      625     ,output v-value-character
      626     ,output v-value-date
      627     ,output v-value-decimal
      628     ,output v-value-integer
      629     ,output par-ord-min-ost
      630     ,output p-type
      631     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      632     ) no-error .
      633     if error-status :error then par-ord-min-ost = false .
      634   procedure recalc-cli-qnty :
      635     do
      636     on error undo, return error return-value
      637     :
      638   define input  parameter p-gds-code      as integer   no-undo .
      639   define input  parameter p-round-m       as character no-undo .
      640   define input  parameter p-round-base    as decimal   no-undo .
      641   define input  parameter p-unit-cli      as character no-undo .
      642   define input  parameter p-cli-base-rate as decimal   no-undo .
      643   define input  parameter p-price-cli     as decimal   no-undo .
      644   define input  parameter p-price-rubl    as decimal   no-undo .
      645   define input  parameter p-price-base    as decimal   no-undo .
      646   define input-output parameter p-cli-qnty as decimal   no-undo .
      647   define input-output parameter p-qnty     as decimal   no-undo .
      648   define input-output parameter p-sum-cli  as decimal   no-undo .
      649   define input-output parameter p-sum-rubl as decimal   no-undo .
      650   define input-output parameter p-sum-base as decimal   no-undo .
      651   define buffer buf_goods for ub.goods  .
      652   define buffer buf_units for ub.units  .
      653   define variable v-cli-qnty as decimal   no-undo .
      654   find first buf_goods no-lock where
      655              buf_goods.gds-code = p-gds-code no-error .
      656   v-cli-qnty = p-cli-qnty .
      657   if can-find (
      658   first buf_units where
      659         buf_units.unit-name = p-unit-cli and
      660         lookup ('шту':U, buf_units.type) > 0 ) and
      661     truncate ( p-cli-qnty, 0 ) <> p-cli-qnty then do:
      662     assign
      663       v-cli-qnty = trunc( p-cli-qnty, 0 ) .
      664   end.
      665      case p-round-m :
      666             when 'Кол-во_в_коробке':U then do:
      667              if buf_goods.qnty-cart  <> 0 then do:
      668                   if ( p-qnty  > 0 and p-qnty <  buf_goods.qnty-cart ) then p-qnty = buf_goods.qnty-cart .
      669                   assign
      670                     p-qnty     = round ( p-qnty / buf_goods.qnty-cart, 0 ) *  buf_goods.qnty-cart
      671                     .
      672                     if ( p-qnty > 0 and p-qnty <  buf_goods.qnty-cart ) then p-qnty = buf_goods.qnty-cart .
      673                   assign
      674                     p-cli-qnty = p-qnty / p-cli-base-rate
      675                     p-sum-cli  = p-price-cli  * p-cli-qnty
      676                     p-sum-rubl = p-price-rubl * p-qnty
      677                     p-sum-base = p-price-base * p-qnty
      678                   .
      679                end.
      680                else do:
      681                   assign
      682                     p-qnty     = v-cli-qnty   * p-cli-base-rate
      683                     p-sum-cli  = p-price-cli  * v-cli-qnty
      684                     p-sum-rubl = p-price-rubl * p-qnty
      685                     p-sum-base = p-price-base * p-qnty
      686                   .
      687                end.
      688             end.
      689             when 'Без-дробных':U then do:
      690                 if can-find(first buf_units where
      691                         buf_units.unit-name = p-unit-cli and
      692                         lookup ('шту':U, buf_units.type) > 0 ) and
      693                         trunc ( p-cli-qnty, 0 ) <> p-cli-qnty then do:
      694                         assign
      695                           p-cli-qnty = trunc( p-cli-qnty, 0 ) + 1
      696                           p-qnty     = p-cli-qnty   * p-cli-base-rate
      697                           p-sum-cli  = p-price-cli  * p-cli-qnty
      698                           p-sum-rubl = p-price-rubl * p-qnty
      699                           p-sum-base = p-price-base * p-qnty
      700                         .
      701                 end.
      702                 else do:
      703                         assign
      704                           p-cli-qnty = round( p-cli-qnty, 0 )
      705                           p-qnty     = p-cli-qnty   * p-cli-base-rate
      706                           p-sum-cli  = p-price-cli  * p-cli-qnty
      707                           p-sum-rubl = p-price-rubl * p-qnty
      708                           p-sum-base = p-price-base * p-qnty
      709                         .
      710                 end.
      711             end.
      712             when 'Произвольно':U then do:
      713               if p-round-base <> 0 then do:
      714                 assign
      715                   p-cli-qnty = round ( p-cli-qnty / p-round-base , 0 ) * p-round-base
      716                 .
      717               end.
      718               assign
      719                   p-qnty     = p-cli-qnty   * p-cli-base-rate
      720                   p-sum-cli  = p-price-cli  * p-cli-qnty
      721                   p-sum-rubl = p-price-rubl * p-qnty
      722                   p-sum-base = p-price-base * p-qnty
      723                 .
      724             end.
      725             when 'Отключено':U or when ""  then do:
      726               assign
      727                   p-cli-qnty = v-cli-qnty
      728                   p-qnty     = p-cli-qnty   * p-cli-base-rate
      729                   p-sum-cli  = p-price-cli  * p-cli-qnty
      730                   p-sum-rubl = p-price-rubl * p-qnty
      731                   p-sum-base = p-price-base * p-qnty
      732                 .
      733             end.
      734      end case.
      735   if is-log = true then  Output stream stream_order to value ("order_raschet.txt") APPEND .
      736   if is-log = true then  put stream stream_order unformatted
      737           " После округления кол-во в баз.ед. изм. : " p-qnty  skip
      738           " Метод округления :  " p-round-m
      739             ( if p-round-m = 'Произвольно':U
      740                 then  string(p-round-base)
      741                 else  "" )
      742             ( if p-round-m = 'Кол-во_в_коробке':U
      743                 then  string(buf_goods.qnty-cart)
      744                 else  "" ) skip
      745           "__________________________________________________"     skip  .
      746   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
      747   v-stroka-protocol = v-stroka-protocol + chr(4) +
      748                     "18.Метод округления : " +  p-round-m +
      749                       ( if p-round-m = 'Произвольно':U
      750                           then  string(p-round-base)
      751                           else  " " )  +
      752                       ( if p-round-m = 'Кол-во_в_коробке':U
      753                           then  string(buf_goods.qnty-cart)
      754                           else  "" ) + chr(4) +
      755                     "19.После округления кол-во в баз.ед. изм. : " + string( p-qnty)
      756                       .
      757     end.
      758   end procedure.
      759   procedure create-protocol :
      760   define input  parameter p-ord-doc  as character no-undo .
      761   define input  parameter p-gds-code as integer   no-undo .
      762   define input  parameter p-date     as date     no-undo .
      763   define input  parameter p-time     as integer   no-undo .
      764   define input  parameter p-obj-type as character no-undo .
      765   define input  parameter p-obj-code as integer   no-undo .
      766   define input  parameter p-str      as character no-undo .
      767   define buffer buf_ord-line-attr for ub.ord-line-attr  .
      768     do
      769     on error undo, return error return-value
      770     :
      771     if p-gds-code = ? or p-gds-code = 0 then return.
      772     if p-ord-doc = ? or p-ord-doc = ""   then return.
      773     if p-obj-type = ?  then return.
      774     if p-obj-code = ?  then return.
      775     if p-date = ?  then return.
      776       find first buf_ord-line-attr exclusive-lock where
      777                 buf_ord-line-attr.doc-code = p-ord-doc  and
      778                 buf_ord-line-attr.gds-code = p-gds-code and
      779                 buf_ord-line-attr.attr-code =  "protocol"           + chr(4) +
      780                                                 p-obj-type          + chr(4) +
      781                                                 string(p-obj-code)  + chr(4) +
      782                                                 string(p-date, "99-99-9999" )  + chr(4) +
      783                                                 string(p-time,"hh:mm:ss"  )
      784                                                 no-error .
      785       if not available buf_ord-line-attr then do:
      786          create buf_ord-line-attr no-error .
      787       end.
      788       if available buf_ord-line-attr then do:
      789       assign
      790         buf_ord-line-attr.doc-code  = p-ord-doc
      791         buf_ord-line-attr.gds-code  = p-gds-code
      792         buf_ord-line-attr.attr-code =  "protocol"           + chr(4) +
      793                                         p-obj-type          + chr(4) +
      794                                         string(p-obj-code)  + chr(4) +
      795                                         string(p-date, "99-99-9999" )  + chr(4) +
      796                                         string(p-time, "hh:mm:ss"  )
      797         buf_ord-line-attr.attr-value  = p-str
      798         no-error
      799       .
      800       end.
      801     end.
      802   end procedure.
      803   procedure create-obj-temp :
      804   define input  parameter p-ord-doc as character no-undo .
      805   define input  parameter p-gds-code as integer   no-undo .
      806   define input  parameter p-obj-type as character no-undo .
      807   define input  parameter p-obj-code as integer   no-undo .
      808   define input  parameter p-qnty as decimal   no-undo .
      809   define buffer buf_ord-line-attr for ub.ord-line-attr  .
      810     do
      811     on error undo, return error return-value
      812     :
      813     if p-gds-code = ? or p-gds-code = 0 then return.
      814     if p-ord-doc = ? or p-ord-doc = "" then return.
      815     if p-obj-type = ?  then return.
      816     if p-obj-code = ?  then return.
      817       find first buf_ord-line-attr exclusive-lock where
      818                 buf_ord-line-attr.doc-code = p-ord-doc  and
      819                 buf_ord-line-attr.gds-code = p-gds-code and
      820                 buf_ord-line-attr.attr-code =  "objqnty"   + chr(4) +
      821                                                 p-obj-type + chr(4) +
      822                                                 string(p-obj-code)  no-error .
      823       if not available buf_ord-line-attr then do:
      824          create buf_ord-line-attr no-error .
      825       end.
      826       assign
      827         buf_ord-line-attr.doc-code  = p-ord-doc
      828         buf_ord-line-attr.gds-code  = p-gds-code
      829         buf_ord-line-attr.attr-code = "objqnty"  + chr(4) +
      830                                       p-obj-type + chr(4) +
      831                                       string(p-obj-code)
      832         buf_ord-line-attr.attr-value = string( p-qnty )
      833         no-error
      834       .
      835     end.
      836   end procedure.
      837   procedure create-min-stock-gds-way :
      838   define input  parameter p-ord-doc   as character no-undo .
      839   define input  parameter p-gds-code  as integer   no-undo .
      840   define input  parameter p-min-stock as decimal   no-undo .
      841   define input  parameter p-gds-way   as decimal   no-undo .
      842   define buffer buf_ord-line-attr for ub.ord-line-attr  .
      843     do
      844     on error undo, return error return-value
      845     :
      846     if p-gds-code = ? or p-gds-code = 0 then return.
      847     if p-ord-doc  = ? or p-ord-doc = "" then return.
      848       find first buf_ord-line-attr exclusive-lock where
      849                 buf_ord-line-attr.doc-code = p-ord-doc  and
      850                 buf_ord-line-attr.gds-code = p-gds-code and
      851                 buf_ord-line-attr.attr-code = 'min-stock':U
      852                                                no-error .
      853       if not available buf_ord-line-attr then do:
      854          create buf_ord-line-attr no-error .
      855       end.
      856       if available buf_ord-line-attr then do:
      857       assign
      858         buf_ord-line-attr.doc-code  = p-ord-doc
      859         buf_ord-line-attr.gds-code  = p-gds-code
      860         buf_ord-line-attr.attr-code = 'min-stock':U
      861         buf_ord-line-attr.attr-value = string (p-min-stock)
      862         no-error
      863       .
      864       end.
      865       find first buf_ord-line-attr exclusive-lock where
      866                 buf_ord-line-attr.doc-code = p-ord-doc  and
      867                 buf_ord-line-attr.gds-code = p-gds-code and
      868                 buf_ord-line-attr.attr-code = 'gds-way':U
      869                                                no-error .
      870       if not available buf_ord-line-attr then do:
      871          create buf_ord-line-attr no-error .
      872       end.
      873       if available buf_ord-line-attr then do:
      874       assign
      875         buf_ord-line-attr.doc-code  = p-ord-doc
      876         buf_ord-line-attr.gds-code  = p-gds-code
      877         buf_ord-line-attr.attr-code = 'gds-way':U
      878         buf_ord-line-attr.attr-value = string (p-gds-way)
      879         no-error
      880       .
      881       end.
      882     end.
      883   end procedure.
      884   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   procedure proc-ord-code :
      886   define input  parameter  p-type as character no-undo .
      887   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      888   define input  parameter  v-cntxt-obj-type as character no-undo .
      889   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      890   define input  parameter  p-i-doc    as character no-undo .
      891   define output parameter  p-ord-doc  as character no-undo .
      892   define variable          v-idop     as character no-undo .
      893     do
      894     on error undo, return error return-value
      895     :
      896   case p-type :
      897       when "main-no-ver" then do:
      898         if  (v-cntxt-db-num <> 0) then
      899           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      900         else
      901           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      902       end.
      903       when "main" then do:
      904             do while true:
      905             if  (v-cntxt-db-num <> 0) then
      906               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      907             else
      908               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      909             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      910             End.
      911       end.
      912       when "chip" then do:
      913         assign
      914           v-idop = p-i-doc .
      915         do while true :
      916           if index (v-idop , ".") = 0 then
      917             v-idop  = replace (v-idop , "-", "-1.").
      918           else
      919             v-idop  =
      920             substring (v-idop , 1, index (v-idop, "-")) +
      921             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      922             substring (v-idop, index (v-idop, ".")).
      923           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      924         end.
      925         assign
      926           p-ord-doc = v-idop.
      927       end.
      928   end case.
      929     end.
      930   end procedure.
      931   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
