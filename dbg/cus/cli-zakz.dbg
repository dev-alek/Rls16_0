     2383   procedure clntattr-value :
     2384     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2385     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2386     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2387     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
     2388     define output parameter p-type     as character no-undo .
     2389     do
     2390     on error undo, return error return-value
     2391     :
     2392           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
     2393         (input  p-obj-type
     2394         ,input  p-obj-code
     2395         ,input  p-code
     2396         ,output p-value
     2397         ,output p-type
     2398         ) no-error .
