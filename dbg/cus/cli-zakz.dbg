    10988   procedure proc-eq-tmp-price :
    10989   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10990   define input parameter p-recid as recid no-undo .
    10991   define input parameter tt as character no-undo  .
    10992   define buffer bufff-units  for ub.units     .
    10993   define buffer ll-tmp#zakaz for tmp#zakaz    .
    10994   define buffer buf_doc-line for ub.doc-line  .
    10995   define variable max-num as integer no-undo .
    10996   define variable t-type as character no-undo .
    10997   find first tmp#zakaz   where
    10998              tmp#zakaz.prod-type = ub.goods.prod-type and
    10999              tmp#zakaz.prod-code = ub.goods.prod-code and
    11000              tmp#zakaz.artic     = ub.goods.artic
    11001              no-error.
    11002    if not available tmp#zakaz  then  do:
    11003       max-num = 0.
    11004       for each  ll-tmp#zakaz  where ll-tmp#zakaz.doc-code        = loc-ord-num and
    11005                                     ll-tmp#zakaz.gds-code        <> ub.goods.gds-code :
    11006           if max-num < ll-tmp#zakaz.line-num then
    11007              max-num = ll-tmp#zakaz.line-num .
    11008       end.
    11009     create tmp#zakaz .
    11010     assign
    11011       tmp#zakaz.doc-code        = loc-ord-num
    11012       tmp#zakaz.gds-code        = ub.goods.gds-code
    11013       tmp#zakaz.prod-type       = ub.goods.prod-type
    11014       tmp#zakaz.prod-code       = ub.goods.prod-code
    11015       tmp#zakaz.artic           = ub.goods.artic
    11016       tmp#zakaz.line-num        = max-num + 1
    11017     .
    11018    end.
    11019     assign
    11020       tmp#zakaz.doc-code        = loc-ord-num
    11021       tmp#zakaz.gds-code        = ub.goods.gds-code
    11022       tmp#zakaz.prod-type       = ub.goods.prod-type
    11023       tmp#zakaz.prod-code       = ub.goods.prod-code
    11024       tmp#zakaz.artic           = ub.goods.artic
    11025       tmp#zakaz.gds-name        = ub.goods.gds-name
    11026       tmp#zakaz.negative-rest   = ub.goods.negative-rest
    11027       tmp#zakaz.deadline        = ub.goods.deadline
    11028       tmp#zakaz.unit-base       = ub.goods.unit-base
    11029       tmp#zakaz.unit-cli        = ub.goods.unit-cli
    11030       tmp#zakaz.cli-base-rate   = ub.goods.cli-base-rate
    11031       tmp#zakaz.ms-cart         = ub.goods.qnty-cart
    11032       .
    11033      find first ub.ext-artic where ub.ext-artic.cli-type    = loc-cli-type
    11034                             and ub.ext-artic.cli-code    = loc-cli-code
    11035                             and ub.ext-artic.gds-code    = ub.goods.gds-code
    11036                             and ub.ext-artic.gds-code    = ub.goods.gds-code
    11037                             and ub.ext-artic.status_    <> 'удал':U no-error .
    11038     if available ub.ext-artic then do:
    11039        tmp#zakaz.cli-art = ub.ext-artic.ext-artic.
    11040     end.
    11041     else do:
    11042        tmp#zakaz.cli-art = ''.
    11043     end.
    11044   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11045   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    11046     (input  ub.goods.gds-code
    11047     ,input  '1':U
    11048     ,input  ?
    11049     ,input  v-cntxt-host-code-obj
    11050     ,input  loc-store-type
    11051     ,input  loc-store-code
    11052     ,output tmp#zakaz.vat-pc
    11053     ) no-error .
    11054     if error-status :error then message
    11055       vss-workfile vss-revision vss-description skip
    11056       error-status :get-message(1) skip
    11057       return-value skip
    11058       ""
    11059       view-as alert-box error
    11060     .
    11061     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
    11062     if available bufff-units then
    11063     assign
    11064       tmp#zakaz.unit-type       = bufff-units.type .
    11065     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
    11066     if available bufff-units then
    11067     assign
    11068       tmp#zakaz.unit-cli-type       = bufff-units.type .
    11069     find first sb-cli-gds where recid(sb-cli-gds) = p-recid no-lock no-error .
    11070     if available sb-cli-gds then do:
    11071           assign
    11072             tmp#zakaz.cancel-date     = sb-cli-gds.cancel-date
    11073             tmp#zakaz.in-qnty         = sb-cli-gds.in-qnty
    11074             tmp#zakaz.out-qnty        = sb-cli-gds.out-qnty
    11075             tmp#zakaz.ret-qnty        = sb-cli-gds.ret-qnty
    11076             tmp#zakaz.in-base         = sb-cli-gds.in-base
    11077             tmp#zakaz.in-rubl         = sb-cli-gds.in-rubl
    11078             tmp#zakaz.out-sum         = sb-cli-gds.out-sum
    11079             tmp#zakaz.ret-sum         = sb-cli-gds.ret-sum
    11080             tmp#zakaz.in-code         = sb-cli-gds.in-code
    11081             tmp#zakaz.last-curr-code  = sb-cli-gds.exch-code
    11082             tmp#zakaz.supp-qnty       = sb-cli-gds.supp-qnty
    11083             tmp#zakaz.supp-base       = sb-cli-gds.supp-base
    11084             tmp#zakaz.supp-rubl       = sb-cli-gds.supp-rubl
    11085           .
    11086           find first buf_doc-line no-lock where
    11087                      buf_doc-line.doc-code  = sb-cli-gds.in-code and
    11088                      buf_doc-line.artic     = sb-cli-gds.artic and
    11089                      buf_doc-line.prod-type = sb-cli-gds.prod-type and
    11090                      buf_doc-line.prod-code = sb-cli-gds.prod-code
    11091                      no-error .
    11092           if available buf_doc-line  then do:
    11093               assign
    11094                 tmp#zakaz.unit-cli        = buf_doc-line.unit-cli
    11095                 tmp#zakaz.cli-base-rate   = buf_doc-line.cli-base-rate
    11096                 .
    11097           end.
    11098     end.
    11099     else do:
    11100     end.
    11101    run last-price (
    11102         input  v-cntxt-host-code-obj ,
    11103         input  tmp#zakaz.artic ,
    11104         input  tmp#zakaz.prod-type ,
    11105         input  tmp#zakaz.prod-code ,
    11106         input  loc-cli-code  ,
    11107         input  loc-cli-type  ,
    11108         input  tmp#zakaz.cli-base-rate ,
    11109         input  loc-exch-code ,
    11110         output tmp#zakaz.price-base ,
    11111         output tmp#zakaz.price-rubl ,
    11112         output tmp#zakaz.price-cli   )
    11113    no-error  .
    11114    if error-status :error then do:
    11115    end.
    11116     If tt <> "doc"  then do:
    11117         find first shar_ord-line   where
    11118             shar_ord-line.doc-code        = loc-ord-num    and
    11119             shar_ord-line.prod-type       = tmp#zakaz.prod-type and
    11120             shar_ord-line.prod-code       = tmp#zakaz.prod-code and
    11121             shar_ord-line.artic           = tmp#zakaz.artic     no-error.
    11122             if not available shar_ord-line  then
    11123                create shar_ord-line .
    11124                buffer-copy tmp#zakaz to shar_ord-line
    11125                  assign shar_ord-line.doc-code    = loc-ord-num
    11126                  no-error .
    11127     end.
    11128     if error-status :error then do:
    11129     message
    11130       vss-workfile vss-revision vss-description skip
    11131       error-status :get-message(1) skip
    11132       return-value skip
    11133       "ошибка"
    11134       view-as alert-box error
    11135     .
    11136     end .
    11137    end.
    11138   end procedure.
    11139   procedure choose-menu-add2 :
    11140   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    11141   define variable ii         as integer init 0 no-undo.
    11142   define variable r-tmp      as recid no-undo .
    11143   define variable r-stop     as logical no-undo .
    11144   define variable r-exit     as logical no-undo .
    11145   define variable l-g#type   as character no-undo .
    11146   define variable l-g#status as character no-undo .
    11147   l-g#status = g#stat.
    11148   l-g#type = g#type.
    11149   define variable varschartic  as character initial " " no-undo.
    11150   define variable v-ref-list  as character  no-undo.
    11151       run str/chsgdsls.w (
    11152           parParentProc ,
    11153           input "order" + g#type ,
    11154           input "Строка документа № "  ,
    11155           input loc-cli-type ,
    11156           input loc-cli-code ,
    11157           input v-cntxt-host-code-obj,
    11158           input-output varschartic,
    11159           output v-ref-list,
    11160           output table tt-gds-list,
    11161           false
    11162           ) no-error.
    11163      g#type = l-g#type.
    11164      g#stat = l-g#status.
    11165      t-ret =  session:set-wait-state("general") .
    11166      line-mode = 'ДОБАВЛЕНИЕ':U .
    11167    _tt:  for each tt-gds-list :
    11168        ii = ii + 1 .
    11169        if ii > 1 then assign line-mode = "ЦИКЛ":u.
    11170   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11171   ASSIGN
    11172      i-gl-Host-Code      = 0
    11173      i-gl-Contract-Code  = 0
    11174      i-gl-Extent3        = 0
    11175      .
    11176   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
    11177       INPUT  v-cntxt-host-code-obj,
    11178       INPUT  loc-contract,
    11179       OUTPUT i-gl-Extent3
    11180      ).
    11181   IF i-gl-Extent3[1] = 2 THEN DO:
    11182      ASSIGN
    11183         i-gl-Host-Code      = i-gl-Extent3[2]
    11184         i-gl-Contract-Code  = i-gl-Extent3[3]
    11185         .
    11186   END. ELSE DO:
    11187      ASSIGN
    11188         i-gl-Host-Code      = v-cntxt-host-code-obj
    11189         i-gl-Contract-Code  = loc-contract
    11190         .
    11191   END.
    11192       FIND FIRST contract-specif
    11193              NO-LOCK
    11194              WHERE
    11195                  contract-specif.Host-code    = i-gl-Host-Code
    11196              AND contract-specif.Contract-num = i-gl-Contract-Code
    11197              AND contract-specif.Gds-code     = tt-gds-list.gds-code
    11198              NO-ERROR
    11199              .
    11200        if  available contract-specif then do:
    11201             run create-tmp in this-procedure  (input "contract-spec":u, "" ) no-error .
    11202        end.
    11203        else run create-tmp in this-procedure  (input "tt-gds-list":u, "" ) no-error .
    11204        if error-status :error then message
    11205          vss-workfile vss-revision vss-description skip
    11206          error-status :get-message(1) skip
    11207          return-value skip
    11208          "create-tmp"
    11209          view-as alert-box error
    11210        .
    11211        release tmp#zakaz.
    11212        find tmp#zakaz where tmp#zakaz.gds-code = tt-gds-list.gds-code no-error .
    11213           if not  error-status :error  and not t-auto then do:
    11214               run cus/ord-frm.w ( input ParParentProc,  input recid ( tmp#zakaz ) , input line-mode , output r-stop , output r-exit) no-error .
    11215               if r-stop then do:
    11216                 run p-delete ( recid ( tmp#zakaz ), input-output ii) .
    11217                 leave _tt.
    11218               end.
    11219               if r-exit then do:
    11220                  run p-delete ( recid ( tmp#zakaz ) ,input-output ii ) .
    11221               end.
    11222           end.
    11223      end.
    11224      if ii > 0 then disable loc-cli-code loc-cli-type loc-obj-name r-clients with frame dialog-frame.
    11225       choice = ?.
    11226       run openbr in this-procedure  .
    11227       t-ret =  session:set-wait-state("") .
    11228       message "Добавлено " + string(ii) + " товаров".
    11229    end.
    11230   end procedure.
    11231   procedure my-proc-mouse-dbl-click-loc-name :
    11232    do
    11233    on error undo, return error return-value
    11234    :
    11235     assign
    11236     frame dialog-frame loc-name.
    11237       if last-event:label = "Ctrl-J" then
    11238         find next tmp#zakaz where
    11239                   tmp#zakaz.gds-name begins loc-name no-error.
    11240       else
    11241         find first tmp#zakaz where
    11242                    tmp#zakaz.gds-name begins loc-name no-error.
    11243         if not avail tmp#zakaz then return.
    11244         find first shar_ord-line no-lock
    11245               where shar_ord-line.doc-code = loc-ord-num  and
    11246                     shar_ord-line.artic      = tmp#zakaz.artic     and
    11247                     shar_ord-line.prod-type  = tmp#zakaz.prod-type and
    11248                     shar_ord-line.prod-code  = tmp#zakaz.prod-code no-error .
    11249       if available tmp#zakaz and available shar_ord-line then do:
    11250         line-rec = recid (shar_ord-line).
    11251         reposition br-docs to recid line-rec no-error.
    11252       end.
    11253       else do:
    11254         message "Строка не найдена."
    11255                 view-as alert-box error.
    11256       end.
    11257     apply "entry" to loc-name in frame dialog-frame.
    11258    end.
    11259   end procedure.
    11260   procedure init-gds-rec :
    11261    do
    11262    on error undo, return error return-value
    11263    :
    11264    define buffer bb_goods for ub.goods.
    11265    gds-rec = ? .
    11266     find current shar_ord-line  no-lock  no-error .
    11267     if not avail shar_ord-line then return.
    11268     find first TMP#zakaz no-lock    where
    11269                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
    11270                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
    11271                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
    11272     if not available TMP#zakaz   then do:
    11273          return.
    11274     end.
    11275     if available tmp#zakaz then do:
    11276         find first bb_goods no-lock where bb_goods.gds-code = tmp#zakaz.gds-code no-error .
    11277         gds-rec = recid (bb_goods).
    11278      end.
    11279    end.
    11280   end procedure.
    11281   procedure p-delete :
    11282    do
    11283    on error undo, return error return-value
    11284    :
    11285      find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
    11286      if available shar_ord-doc
    11287       and (( is-edoc-nn and ( shar_ord-doc.ord-int1 = integer('3':U) or shar_ord-doc.ord-int1 = integer('4':U)))
    11288        or  ( is-edi     and   shar_ord-doc.ord-int1 = integer('3':U)))
    11289       then do:
    11290          message "Заказ по системе EDOC/EDI не должен корректироватся в этом статусе. Только НОВЫЙ желтый! " view-as alert-box information .
    11291          return .
    11292       end.
    11293       define input parameter tmp-recid as recid no-undo .
    11294       define input-output parameter ii as integer no-undo . .
    11295       find first tmp#zakaz where recid(tmp#zakaz) = tmp-recid no-error .
    11296       if not avail tmp#zakaz then return error.
    11297       find first shar_ord-line   where
    11298           shar_ord-line.doc-code        = loc-ord-num    and
    11299           shar_ord-line.prod-type       = tmp#zakaz.prod-type and
    11300           shar_ord-line.prod-code       = tmp#zakaz.prod-code and
    11301           shar_ord-line.artic           = tmp#zakaz.artic     no-error.
    11302       if not available shar_ord-line  then  return error .
    11303       delete shar_ord-line .
    11304       delete tmp#zakaz .
    11305       ii = ii - 1 .
    11306    end.
    11307   end procedure.
    11308   procedure CHOOSE-MENU-way1 :
    11309    do
    11310    on error undo, return error return-value
    11311    :
    11312    assign frame dialog-frame LOC-DATE-SHIP
    11313                               DATE-sale-1
    11314                               DATE-sale-2 .
    11315    run ver-date  in this-procedure .
    11316    if return-value <> "" then return.
    11317    find current shar_ord-line no-lock no-error .
    11318    if not avail shar_ord-line then return.
    11319    run cus/ord-way.w (    pARPARENTPROC,
    11320                       shar_ord-line.artic     ,
    11321                      shar_ord-line.prod-type ,
    11322                      shar_ord-line.prod-code ,
    11323                      1,
    11324                       LOC-DATE-SHIP  ,
    11325                       DATE-sale-1    ,
    11326                       DATE-sale-2    ,
    11327                       loc-store-type ,
    11328                       loc-store-code ,
    11329                       loc-doc-type  ) .
    11330    end.
    11331   end procedure.
    11332   procedure CHOOSE-MENU-way2 :
