     4907       return no-apply .
     4908   END.
     4909   ON LEAVE OF loc-time-ship IN FRAME Dialog-Frame
     4910   DO:
     4911      run leave-loc-time-ship in this-procedure .
     4912   END.
     4913   ON  return OF loc-time-ship IN FRAME Dialog-Frame
     4914   DO:
     4915      run apply-focus-next-entry in this-procedure  (input  PAYTYPE:handle ) .
     4916      return no-apply .
     4917   END.
     4918   ON VALUE-CHANGED of TOG-type IN FRAME dialog-frame
     4919   DO:
     4920     run vg-TOG-type in this-procedure .
     4921   End.
     4922   ON LEAVE  OF loc-cli-type IN FRAME Dialog-Frame
     4923   DO:
     4924     run LEAVE-loc-cli-type in this-procedure.
     4925   END.
     4926   ON  RETURN OF loc-cli-type IN FRAME Dialog-Frame
     4927   DO:
     4928     run apply-focus-next-entry in this-procedure  (input  loc-cli-code :handle ) .
     4929   END.
     4930   ON LEAVE OF loc-cli-code IN FRAME Dialog-Frame
     4931   DO:
     4932     run LEAVE-loc-cli-code in this-procedure no-error .
     4933     if error-status :error then do:
     4934        apply "choose" to r-clients in frame dialog-frame .
     4935     end.
     4936     if can-find (first ub.contract where ub.contract.cli-code = loc-cli-code and ub.contract.cli-type = loc-cli-type and ub.contract.host-code = v-cntxt-host-code-obj) then do:
     4937       if loc-cli-code <> ? then do:
     4938         run r-contract-choose in this-procedure no-error .
     4939         if error-status :error then return no-apply .
     4940       end.
     4941     end.
     4942   END.
     4943   ON  RETURN OF loc-cli-code IN FRAME Dialog-Frame
     4944   DO:
     4945     run apply-focus-next-entry in this-procedure  (input  loc-cli-code :handle ) .
     4946     return no-apply .
     4947   END.
     4948   ON any-key OF loc-cli-code IN FRAME Dialog-Frame
     4949   DO:
     4950     v-fl = false .
     4951   END.
     4952   on end-error, stop of frame dialog-frame do:
     4953     apply "choose" to b-exit in frame dialog-frame.
     4954     ERROR-STATUS:ERROR = false .
     4955     return .
     4956   end.
     4957   ON MOUSE-SELECT-DBLCLICK OF loc-cli-code IN FRAME dialog-frame
     4958   DO:
     4959     apply "choose" to r-clients in frame dialog-frame.
     4960     apply "entry" to loc-date-ship  in frame dialog-frame.
     4961   end.
     4962   ON MOUSE-SELECT-DBLCLICK OF paytype IN FRAME dialog-frame
     4963   DO:
     4964     apply "choose" to r-paytype in frame dialog-frame.
     4965     apply "entry" to wrkr  in frame dialog-frame.
     4966   end.
     4967   ON CHOOSE OF r-clients IN FRAME Dialog-Frame
     4968   DO:
     4969     run r-clients-ch in this-procedure no-error  .
     4970     if error-status :error then return no-apply.
     4971     if can-find (first ub.contract where ub.contract.cli-code = loc-cli-code and ub.contract.cli-type = loc-cli-type and ub.contract.host-code = v-cntxt-host-code-obj) then do:
     4972       if loc-cli-code <> ? then do:
     4973         run r-contract-choose in this-procedure no-error .
     4974         if error-status :error then return no-apply .
     4975       end.
     4976     end.
     4977   END.
     4978   ON value-changed OF slt_type IN FRAME dialog-frame
     4979   OR value-changed OF VAT_type IN FRAME dialog-frame run val-ch-type in this-procedure (input self:name) no-error.
     4980   ON LEAVE, return OF loc-exch-rate  IN FRAME dialog-frame
     4981   OR LEAVE, return OF loc-exch-scale IN FRAME dialog-frame
     4982   OR LEAVE, return OF loc-base-rate  IN FRAME dialog-frame
     4983   OR LEAVE, return OF loc-base-scale IN FRAME dialog-frame
     4984   DO:
     4985      run update-rate-doc in this-procedure no-error.
     4986      if error-status:error then do:
     4987         run disp-exch in this-procedure .
     4988         return no-apply.
     4989      end.
     4990   END.
     4991   ON RETURN, leave OF loc-exch-code IN FRAME dialog-frame
     4992   DO:
     4993      run choice-currency in this-procedure no-error.
     4994      if error-status:error then return no-apply.
     4995      run update-rate-doc in this-procedure no-error.
     4996   END.
     4997   ON CHOOSE OF r-currency IN FRAME dialog-frame
     4998   DO:
     4999   run r-proc-currency in this-procedure no-error.
     5000   if error-status:error then return no-apply.
     5001   END.
     5002   ON CHOOSE OF r-acc IN FRAME dialog-frame
     5003   DO:
     5004    run r-acc-proc in this-procedure .
     5005   END.
     5006   ON LEAVE OF loc-base-rate  IN FRAME dialog-frame OR
     5007      LEAVE OF loc-base-scale IN FRAME dialog-frame DO:
     5008      run check-rate in this-procedure no-error.
     5009      if error-status:error then return no-apply.
     5010      run UI-on in this-procedure .
     5011   END.
     5012   ON CURSOR-DOWN OF loc-hour IN FRAME Dialog-Frame
     5013   DO:
     5014     assign  frame dialog-frame loc-hour .
     5015     loc-hour = loc-hour -  1.
     5016     if loc-hour < 0 then return no-apply.
     5017     display loc-hour with frame dialog-frame.
     5018   END.
     5019   ON CURSOR-UP OF loc-hour IN FRAME Dialog-Frame
     5020   DO:
     5021     assign  frame dialog-frame loc-hour .
     5022     loc-hour = loc-hour +  1.
     5023     if loc-hour > 24 then return no-apply.
     5024     display loc-hour with frame dialog-frame.
     5025   END.
     5026   ON LEAVE OF loc-hour IN FRAME Dialog-Frame
     5027   DO:
     5028     assign frame dialog-frame loc-hour .
     5029      if loc-hour > 24 then do:
     5030      message "Часы должны быть   до 24 ! " .
     5031      return no-apply.
     5032      end.
     5033       if loc-hour < 0 then do:
     5034      message "Часы должны быть  от 0 до 24 ! " .
     5035      return no-apply.
     5036      end.
     5037   END.
     5038   ON CURSOR-DOWN OF loc-min IN FRAME Dialog-Frame
     5039   DO:
     5040     assign  frame dialog-frame loc-min .
     5041     loc-min = loc-min -  1.
     5042     if loc-min < 0 then return no-apply.
     5043     display loc-min with frame dialog-frame.
     5044   END.
     5045   ON CURSOR-UP OF loc-min IN FRAME Dialog-Frame
     5046   DO:
     5047      assign  frame dialog-frame loc-min .
     5048     loc-min = loc-min +  1.
     5049     if loc-min > 59 then return no-apply.
     5050     display loc-min with frame dialog-frame.
     5051   END.
     5052   ON LEAVE OF loc-min IN FRAME Dialog-Frame
     5053   DO:
     5054    run leave-loc-min in this-procedure   no-error .
     5055        if error-status :error then return no-apply.
     5056   END.
     5057   procedure vg-TOG-type :
     5058     Assign frame  dialog-frame
     5059     tog-type .
     5060      If tog-type = 1  then Do:
     5061         view    t          in   frame dialog-frame
     5062                 cycle-day  in   frame dialog-frame .
     5063         display t cycle-day  with frame dialog-frame .
     5064         Enable  t cycle-day  with frame dialog-frame .
     5065         display t cycle-day  with frame dialog-frame .
     5066      End.
     5067      Else DO: Hide  t  cycle-day  in frame dialog-frame. End.
     5068   end procedure.
     5069   procedure leave-loc-min:
     5070      assign frame dialog-frame loc-min .
     5071      if loc-min > 59 then do:
     5072         message "Минуты должны быть  от 0 до 59 ! " .
     5073         return error.
     5074         end.
     5075   end procedure.
     5076   procedure leave-loc-time-ship :
     5077     Assign frame dialog-frame loc-time-ship .
     5078       if integer(entry(1,loc-time-ship,":")) > 24 then
     5079         DO:
     5080             Message "Неправильно задано время !" view-as alert-box error .
     5081             apply "entry" to loc-time-ship  in frame dialog-frame.
     5082         End.
     5083       if integer(entry(2,loc-time-ship,":")) > 60 then
     5084         DO:
     5085             Message "Неправильно задано время !" view-as alert-box error .
     5086             apply "entry" to loc-time-ship  in frame dialog-frame.
     5087         End.
     5088   end procedure.
     5089   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5090   procedure last-price :
     5091   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     5092   define input parameter  p-host-code     as integer no-undo .
     5093   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
     5094   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
     5095   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
     5096   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
     5097   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
     5098   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
     5099   define input parameter  p-curr-code  as integer   no-undo .
     5100   define output parameter p-price-base like ub.doc-line.price-base no-undo .
     5101   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
     5102   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
     5103   define buffer buf-lib-doc-line for ub.doc-line.
     5104   define buffer buf_cli-gds for ub.cli-gds .
     5105   define buffer buf_trn-doc for ub.trn-doc  .
     5106   define variable vp-curr-code  like ub.trn-doc.exch-code.
     5107   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
     5108   define variable vp-exch-scale like ub.trn-doc.exch-scale.
     5109   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
     5110   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
     5111   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
     5112   define variable v-cli-base-rate as decimal   no-undo .
     5113    find first buf_cli-gds no-lock where
     5114               buf_cli-gds.cli-type   = p-cli-type    and
     5115               buf_cli-gds.cli-code   = p-cli-code    and
     5116               buf_cli-gds.host-code  = p-host-code   and
     5117               buf_cli-gds.artic      = p-artic       and
     5118               buf_cli-gds.prod-type  = p-prod-type   and
     5119               buf_cli-gds.prod-code  = p-prod-code
     5120               no-error .
     5121   if available buf_cli-gds then do:
     5122       find first buf_trn-doc no-lock
     5123            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
     5124        if available buf_trn-doc then do:
     5125           vp-curr-code  = buf_trn-doc.exch-code.
     5126           vp-exch-rate  = buf_trn-doc.exch-rate.
     5127           vp-exch-scale = buf_trn-doc.exch-scale.
     5128        end.
     5129       find first buf-lib-doc-line no-lock
     5130         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
     5131           and buf-lib-doc-line.artic     = p-artic
     5132           and buf-lib-doc-line.prod-type = p-prod-type
     5133           and buf-lib-doc-line.prod-code = p-prod-code
     5134         no-error .
     5135   end.
     5136   else do:
     5137   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
     5139     (input  p-host-code
     5140     ,input  p-artic
     5141     ,input  p-prod-type
     5142     ,input  p-prod-code
     5143     ,output v-last-in-code
     5144     ,output v-last-obj-type
     5145     ,output v-last-obj-code
     5146     )  .
     5147       find first buf_trn-doc no-lock
     5148            where buf_trn-doc.doc-code  = v-last-in-code no-error .
     5149        if available buf_trn-doc then do:
     5150           vp-curr-code  = buf_trn-doc.exch-code.
     5151           vp-exch-rate  = buf_trn-doc.exch-rate.
     5152           vp-exch-scale = buf_trn-doc.exch-scale.
     5153        end.
     5154       find first buf-lib-doc-line no-lock
     5155         where buf-lib-doc-line.doc-code  = v-last-in-code
     5156           and buf-lib-doc-line.artic     = p-artic
     5157           and buf-lib-doc-line.prod-type = p-prod-type
     5158           and buf-lib-doc-line.prod-code = p-prod-code
     5159         no-error .
     5160   end.
     5161       if available buf-lib-doc-line then do:
     5162         assign
     5163           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
     5164           p-price-base = buf-lib-doc-line.price-base
     5165           p-price-rubl = buf-lib-doc-line.price-rubl
     5166           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
     5167         .
     5168         if v-cli-base-rate <> p-cli-base-rate
     5169         then do:
     5170             p-price-cli  = p-price-cli / v-cli-base-rate  .
     5171         end.
     5172          if p-curr-code <> vp-curr-code then do:
     5173             p-price-cli  = p-price-rubl  .
     5174         end.
     5175       end.
     5176       Else do:
     5177         assign
     5178           p-price-base = 0
     5179           p-price-rubl = 0
     5180           p-price-cli  = 0
     5181         .
     5182       end.
     5183     end.
     5184   end procedure.
     5185   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
