    11355   end procedure.
    11356   procedure CHOOSE-MENU-way3 :
    11357    do
    11358    on error undo, return error return-value
    11359    :
    11360    assign frame dialog-frame LOC-DATE-SHIP
    11361                               DATE-sale-1
    11362                               DATE-sale-2 .
    11363    run ver-date  in this-procedure .
    11364    if return-value <> "" then return.
