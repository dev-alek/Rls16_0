     8792             input v-deliv-type-code   ,
     8793             input v-point-obj-code    ,
     8794             input v-point-cli-code    ,
     8795             input v-point-obj-db-num  ,
     8796             input v-point-cli-db-num  ,
     8797             input v-transport-host-code    ,
     8798             input v-transport-cli-type    ,
     8799             input v-transport-cli-code    ,
     8800             input v-transport-contract ,
     8801             input v-transport-condition,
     8802             input v-transport-value    ,
     8803             input v-transport-sum      ,
     8804             input v-transport-vat    ,
     8805             input  if v-err-ext then false else is-edoc-nn-doc  ,
     8806             input  if v-err-ext then false else is-edi-doc      ,
     8807             input v-dm-edi                                      )
     8808             no-error .
     8809        if error-status :error then return error return-value .
     8810      end.
     8811    end.
     8812   end procedure.
     8813   procedure proc-b-mark :
     8814    do
     8815    on error undo, return error return-value
     8816    :
     8817   define variable tt-rec as recid no-undo .
     8818     find current shar_ord-line  no-lock  no-error .
     8819     if not avail shar_ord-line then return.
     8820     find first tmp#zakaz no-lock    where
     8821                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8822                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8823                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8824      if not avail tmp#zakaz   then do:
     8825          message error-status :get-message(1) .
     8826          return.
     8827          end.
     8828    tt-rec = recid (shar_ord-line) .
     8829    if tmp#zakaz.local-mark = "*" then do :
     8830       tmp#zakaz.local-mark = "".
     8831       end.
     8832     else do:
     8833      tmp#zakaz.local-mark = "*" .
     8834     end.
     8835   if br-docs:refresh() in frame dialog-frame  then.
     8836   reposition br-docs to recid tt-rec no-error.
     8837   g#log = br-docs:select-next-row () in frame dialog-frame.
     8838   apply "entry" to br-docs in frame dialog-frame.
     8839    end.
     8840   end procedure.
     8841   procedure ver-gds-flor :
     8842    do
     8843    on error undo, return error return-value
     8844    :
     8845   define input  parameter p-gds-code as integer   no-undo .
     8846   define output parameter  v-nabor   as logical   no-undo .
     8847   v-nabor = false .
     8848      run ver-gds-grp-nabor( input p-gds-code, output v-nabor) .
     8849   end.
     8850   end procedure.
     8851   procedure chg-action :
     8852   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     8853   define buffer buff_contract for ub.contract.
     8854   t-ret =  session:set-wait-state("general") .
     8855    find first buf-cli where recid(buf-cli) = rep-rec no-lock no-error.
     8856    find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     8857    p-doc-code  = shar_ord-doc.doc-code.
     8858     if available shar_ord-doc then  do:
     8859        find first for-obj where for-obj.obj-code = shar_ord-doc.obj-code and
     8860                                 for-obj.obj-type = shar_ord-doc.obj-type no-lock no-error .
     8861        if error-status :error then return error.
     8862       assign
     8863         date-1 = shar_ord-doc.start-date
     8864         date-2 = shar_ord-doc.end-date no-error .
     8865         if error-status :error then
     8866            assign
     8867               date-1 = to-day - 7
     8868               date-2 = to-day.
     8869       assign
     8870         loc-obj-name-2  = "(" + shar_ord-doc.obj-type + " " + string(shar_ord-doc.obj-code ) + ")" + for-obj.obj-name
     8871         wrkr            = shar_ord-doc.wrkr
     8872         agnt            = shar_ord-doc.agnt
     8873         boss            = shar_ord-doc.boss
     8874         loc-time-ship   = string(shar_ord-doc.ship-time,"hh:mm")
     8875         loc-hour        = integer (entry(1,string(shar_ord-doc.ship-time,"hh:mm"),":"))
     8876         loc-min         = integer (entry(2,string(shar_ord-doc.ship-time,"hh:mm"),":"))
     8877         date-sale-1     = shar_ord-doc.date-sale-1
     8878         date-sale-2     = shar_ord-doc.date-sale-2
     8879         e-method        = shar_ord-doc.e-method
     8880         temp-e-method   = e-method
     8881         loc-date-ship   = shar_ord-doc.ship-date
     8882         loc-status      = shar_ord-doc.status_
     8883         paytype         = shar_ord-doc.pay-code
     8884         loc-service     = shar_ord-doc.sum-service
     8885         cycle-day       = shar_ord-doc.cycle-day
     8886         pay-day         = shar_ord-doc.pay-day
     8887         tog-type        = shar_ord-doc.order-type
     8888         loc-base-rate   = shar_ord-doc.base-rate
     8889         loc-base-scale  = shar_ord-doc.base-scale
     8890         loc-cli-qnty    = shar_ord-doc.cli-qnty
     8891         loc-qnty        = shar_ord-doc.qnty
     8892         loc-sum-base    = shar_ord-doc.sum-base
     8893         loc-sum-cli     = shar_ord-doc.sum-cli
     8894         loc-sum-rubl    = shar_ord-doc.sum-rubl
     8895         loc-tot-lines   = shar_ord-doc.tot-lines
     8896         loc-exch-code         = shar_ord-doc.exch-code
     8897         loc-exch-rate         = shar_ord-doc.exch-rate
     8898         loc-exch-scale        = shar_ord-doc.exch-scale
     8899         loc-out-code          = shar_ord-doc.out-code
     8900         doc-date              = shar_ord-doc.doc-date
     8901         loc-doc-type          = shar_ord-doc.doc-type
     8902         fact-date             = shar_ord-doc.fact-date
     8903         vat_type              = shar_ord-doc.vat-type
     8904         slt_type              = shar_ord-doc.slt-type
     8905         loc-print-rubl        = true
     8906         loc-store-code        = shar_ord-doc.obj-code
     8907         loc-store-type        = shar_ord-doc.obj-type
     8908         v-deliv-type-code     = shar_ord-doc.deliv-type-code
     8909         v-point-obj-code      = shar_ord-doc.obj-point-code
     8910         v-point-cli-code      = shar_ord-doc.cli-point-code
     8911         v-point-obj-db-num    = shar_ord-doc.obj-point-db-num
     8912         v-point-cli-db-num    = shar_ord-doc.cli-point-db-num
     8913         v-transport-host-code = shar_ord-doc.transport-host-code
     8914         v-transport-cli-type  = shar_ord-doc.transport-cli-type
     8915         v-transport-cli-code  = shar_ord-doc.transport-cli-code
     8916         v-transport-contract  = shar_ord-doc.transport-contract
     8917         v-transport-condition = shar_ord-doc.transport-condition
     8918         v-transport-value     = shar_ord-doc.transport-value
     8919         v-transport-sum       = shar_ord-doc.sum-ship
     8920         v-transport-vat       = shar_ord-doc.transport-vat
     8921         loc-cli-out-doc       = entry(1, shar_ord-doc.cli-out-doc, chr(4))
     8922         .
     8923       find first buff_contract no-lock where buff_contract.host-code     = shar_ord-doc.host-code and
     8924                                              buff_contract.contract-code = shar_ord-doc.contract-code no-error .
     8925       if available buff_contract then
     8926           assign
     8927             loc-exch-code       = buff_contract.curr-code
     8928             loc-contract        = buff_contract.contract-code
     8929           .
     8930         find ub.currency where ub.currency.curr-code = loc-exch-code no-lock no-error.
     8931           if available ub.currency then disp ub.currency.curr-abbr with frame dialog-frame.
     8932                                 else disp ? @ ub.currency.curr-abbr with frame dialog-frame.
     8933      end.
     8934      find ub.pay-type where ub.pay-type.obj-code = shar_ord-doc.pay-code no-lock no-error.
     8935      if available ub.pay-type then  do:
     8936       assign
     8937       loc-pay-type = ub.pay-type.obj-name  .
     8938       end.
     8939       if available buf-cli then
     8940       assign
     8941           loc-cli-code = buf-cli.obj-code
     8942           loc-cli-type = buf-cli.obj-type
     8943           loc-obj-name = buf-cli.obj-name
     8944           .
     8945        else
     8946        assign
     8947           loc-cli-code = ?
     8948           loc-cli-type = ?
     8949           loc-obj-name = ?
     8950           .
     8951       if t-action = "copy":u
     8952          then do:
     8953   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8954   run proc-ord-code in this-procedure
     8955    (input   'main' ,
     8956     input   v-cntxt-db-num ,
     8957     input   v-cntxt-obj-type ,
     8958     input   v-cntxt-obj-code ,
     8959     input   v-i-doc ,
     8960     output  loc-ord-num
     8961    ) .
     8962          assign
     8963             loc-status  = 'новый':U
     8964             loc-date-ship = ?
     8965             date-sale-2   = ?
     8966             date-sale-1   = ?
     8967          .
     8968          end.
     8969          else assign loc-ord-num = shar_ord-doc.doc-code
     8970                      loc-status  = shar_ord-doc.status_  .
     8971       find first clients-doc where clients-doc.obj-code = wrkr
     8972                                and clients-doc.obj-type = 'чел':U no-lock no-error.
     8973            if  error-status :error then error-status :error = false .
     8974           if avail clients-doc then do:
     8975            wrkr-name = clients-doc.obj-name.
     8976          end.
     8977       find first clients-doc1 where clients-doc1.obj-code = agnt
     8978                                and clients-doc1.obj-type = 'чел':U no-lock no-error.
     8979            if  error-status :error then error-status :error = false .
     8980            if avail clients-doc1 then agnt-name = clients-doc1.obj-name.
     8981       find first clients-doc2 where clients-doc2.obj-code = boss
     8982                                and clients-doc2.obj-type = 'чел':U no-lock no-error.
     8983        if  error-status :error then error-status :error = false .
     8984        if avail clients-doc2 then boss-name = clients-doc2.obj-name.
     8985        if  error-status :error then error-status :error = false .
     8986       disable loc-cli-code
     8987               loc-cli-type
     8988               loc-obj-name
     8989               r-clients with frame dialog-frame.
     8990        display
     8991           wrkr agnt boss
     8992           wrkr-name agnt-name
     8993           boss-name
     8994           with frame dialog-frame.
     8995     for each shar_ord-line where shar_ord-line.doc-code = shar_ord-doc.doc-code  no-lock :
     8996        run create-tmp in this-procedure  (input "doc":u,"") no-error .
     8997        if error-status :error then message
     8998            vss-workfile vss-revision vss-description skip
     8999            error-status :get-message(1)  skip
     9000           "Ошибка вызова процедуры create-tmp"  skip
     9001           .
     9002     end.
     9003     run create-tmp-dtl  .
     9004     run openbr in this-procedure  .
     9005     run enable_ui.
     9006    t-ret =  session:set-wait-state("") .
     9007   end.
     9008   end procedure.
     9009   procedure create-tmp :
     9010   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9011   define input parameter tt as character no-undo.
     9012   define input parameter t  as character no-undo.
     9013   define variable prod-type#   like ub.ord-line.prod-type no-undo .
     9014   define variable prod-code#   like ub.ord-line.prod-code no-undo .
     9015   define variable artic#       like ub.ord-line.artic     no-undo .
     9016   define variable v-price-exel as decimal   no-undo .
     9017   define variable p-recid as recid no-undo .
     9018   define buffer buf_ord-dtl  for ub.ord-dtl.
     9019   define buffer ll-tmp#zakaz for tmp#zakaz .
     9020   define buffer bufff-units  for ub.units     .
     9021    case tt :
     9022       when "price":u  then do:
     9023         find  first sb-cli-gds  where
     9024               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9025               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9026               sb-cli-gds.host-code = v-cntxt-host-code-obj  and
     9027               sb-cli-gds.artic     = ub.goods.artic      and
     9028               sb-cli-gds.prod-type = ub.goods.prod-type  and
     9029               sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error.
     9030               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9031               else do:
     9032                   find first sb-cli-gds where
     9033                         sb-cli-gds.artic     = ub.goods.artic      and
     9034                         sb-cli-gds.prod-type = ub.goods.prod-type  and
     9035                         sb-cli-gds.prod-code = ub.goods.prod-code  and
     9036                         sb-cli-gds.host-code = v-cntxt-host-code-obj
     9037                         no-lock no-error.
     9038                         if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9039                         else p-recid = ?.
     9040               end.
     9041               run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9042               if error-status :error
     9043               then do:
     9044                   message vss-workfile vss-revision vss-description skip
     9045                   error-status :get-message(1)
     9046                   'proc-eq-tmp-price 67'
     9047                   view-as alert-box error .
     9048               end.
     9049          end.
     9050       when "goods":u  then do:
     9051         find  first sb-cli-gds  where
     9052               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9053               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9054               sb-cli-gds.host-code = v-cntxt-host-code-obj  and
     9055               sb-cli-gds.artic     = ub.goods.artic      and
     9056               sb-cli-gds.prod-type = ub.goods.prod-type  and
     9057               sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error.
     9058               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9059               else p-recid = ?.
     9060               run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9061               if error-status :error
     9062               then do:
     9063                   message vss-workfile vss-revision vss-description skip
     9064                   error-status :get-message(1)
     9065                   232
     9066                   view-as alert-box error .
     9067               end.
     9068       end.
     9069       when "gds-list":u  then do:
     9070         find first ub.goods where
     9071               gds-list.artic     = ub.goods.artic     and
     9072               gds-list.prod-type = ub.goods.prod-type and
     9073               gds-list.prod-code = ub.goods.prod-code no-lock no-error.
     9074               if error-status :error
     9075               then do:
     9076                   message vss-workfile vss-revision vss-description skip
     9077                   error-status :get-message(1)
     9078                   "Плохо ! gds-list не = goods !"
     9079                   123
     9080                   view-as alert-box error .
     9081               end.
     9082         find  first sb-cli-gds  where
     9083               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9084               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9085               sb-cli-gds.artic     = gds-list.artic      and
     9086               sb-cli-gds.host-code = v-cntxt-host-code-obj         and
     9087               sb-cli-gds.prod-type = gds-list.prod-type  and
     9088               sb-cli-gds.prod-code = gds-list.prod-code  no-lock no-error.
     9089               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9090               else p-recid = ?.
     9091               run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9092               if error-status :error
     9093               then do:
     9094                   message vss-workfile vss-revision vss-description skip
     9095                   error-status :get-message(1)
     9096                   "Плохо !  Ошибка в proc-eq-tmp-price !"
     9097                   333
     9098                   view-as alert-box error .
     9099               end.
     9100       end.
     9101       when "tt-gds-list":u  then do:
     9102         find first ub.goods where
     9103               ub.goods.artic     = tt-gds-list.artic     and
     9104               ub.goods.prod-type = tt-gds-list.prod-type and
     9105               ub.goods.prod-code = tt-gds-list.prod-code no-lock no-error.
     9106               if error-status :error  then do:
     9107                   message vss-workfile vss-revision vss-description skip
     9108                   error-status :get-message(1)
     9109                   "Плохо ! tt-gds-list не = goods !"
     9110                   1
     9111                   view-as alert-box error .
     9112               end.
     9113         find  first sb-cli-gds  where
     9114               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9115               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9116               sb-cli-gds.artic     = tt-gds-list.artic      and
     9117               sb-cli-gds.host-code = v-cntxt-host-code-obj         and
     9118               sb-cli-gds.prod-type = tt-gds-list.prod-type  and
     9119               sb-cli-gds.prod-code = tt-gds-list.prod-code  no-lock no-error.
     9120               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9121               else p-recid = ?.
     9122               run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9123               if error-status :error
     9124               then do:
     9125                   message vss-workfile vss-revision vss-description skip
     9126                   error-status :get-message(1)
     9127                   "Плохо !  Ошибка в proc-eq-tmp-price !"
     9128                   333
     9129                   view-as alert-box error .
     9130               end.
     9131       end.
     9132       when "contract-spec":u  then do:
     9133         find first ub.goods where
     9134               ub.goods.gds-code  = ub.contract-specif.gds-code  no-lock no-error.
     9135               if error-status :error  then do:
     9136                   message vss-workfile vss-revision vss-description skip
     9137                           "При добавлении товаров из спецификации по договору произошла ошибка :" skip
     9138                           "Нет товара с кодом : " ub.contract-specif.gds-code
     9139                           view-as alert-box error .
     9140               end.
     9141         find  first sb-cli-gds  where
     9142               sb-cli-gds.host-code = v-cntxt-host-code-obj and
     9143               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9144               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9145               sb-cli-gds.artic     = ub.goods.artic      and
     9146               sb-cli-gds.prod-type = ub.goods.prod-type  and
     9147               sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error.
     9148               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9149               else p-recid = ?.
     9150               if not available tmp#zakaz then do:
     9151                     run proc-eq-tmp-price ( p-recid, tt)  no-error .
     9152               end.
     9153               case t :
     9154                 when "only-price" then do:
     9155                   if ub.contract-specif.price-cli <> tmp#zakaz.price-cli
     9156                   or ub.contract-specif.vat-pc    <> tmp#zakaz.vat-pc
     9157                   then do:
     9158                     assign v-update-price = v-update-price + 1 .
     9159                   end.
     9160                 end.
     9161                 when "only-qnty" then do:
     9162                   if ub.contract-specif.qnty <> tmp#zakaz.cli-qnty
     9163                   then do:
     9164                     assign v-update-price = v-update-price + 1 .
     9165                   end.
     9166                 end.
     9167                 when "" then do:
     9168                   if ub.contract-specif.qnty      <> tmp#zakaz.cli-qnty
     9169                   or ub.contract-specif.price-cli <> tmp#zakaz.price-cli
     9170                   or ub.contract-specif.vat-pc    <> tmp#zakaz.vat-pc
     9171                   then do:
     9172                     assign v-update-price = v-update-price + 1 .
     9173                   end.
     9174                 end.
     9175               end case.
     9176                if t <> "only-qnty"  then do:
     9177                   run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9178                end .
     9179               if ub.contract-specif.cli-base-rate <> 0 then do:
     9180                 assign
     9181                   tmp#zakaz.cli-base-rate = ub.contract-specif.cli-base-rate
     9182                   tmp#zakaz.unit-cli      = ub.contract-specif.unit-base
     9183                 .
     9184               end.
     9185               if t <> "only-price"  then do:
     9186                   if  ub.contract-specif.qnty <> 0 then do:
     9187                     assign
     9188                       tmp#zakaz.cli-qnty = ub.contract-specif.qnty
     9189                     .
     9190                   end.
     9191               end.
     9192               if t <> "only-qnty"  then do:
     9193                 assign
     9194                   tmp#zakaz.vat-pc     =  ub.contract-specif.vat-pc
     9195                   tmp#zakaz.price-cli  =  ub.contract-specif.price-cli
     9196                 .
     9197               end.
     9198             assign
     9199                 tmp#zakaz.qnty       =  tmp#zakaz.cli-qnty   * tmp#zakaz.cli-base-rate
     9200                 tmp#zakaz.price-rubl =  tmp#zakaz.price-cli  * loc-exch-rate / loc-exch-scale / tmp#zakaz.cli-base-rate
     9201                 tmp#zakaz.price-base =  tmp#zakaz.price-rubl / loc-base-rate * loc-base-scale
     9202                 tmp#zakaz.sum        =  tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9203                 tmp#zakaz.sum-rubl   =  tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9204                 tmp#zakaz.sum-base   =  tmp#zakaz.price-base * tmp#zakaz.qnty
     9205                 tmp#zakaz.sum-cli    =  tmp#zakaz.price-cli  * tmp#zakaz.cli-qnty
     9206                 .
     9207       end.
     9208       when "doc":u  then do:
     9209           find first ub.goods where
     9210                   ub.goods.artic     = shar_ord-line.artic     and
     9211                   ub.goods.prod-type = shar_ord-line.prod-type and
     9212                   ub.goods.prod-code = shar_ord-line.prod-code no-lock no-error.
     9213          if not (line-mode = "" and  t-action = "chg":U  )  then do:
     9214                 if available ub.goods then do:
     9215                       p-recid = ?.
     9216                       find first sb-cli-gds  where
     9217                           sb-cli-gds.cli-type  = buf-cli.obj-type and
     9218                           sb-cli-gds.cli-code  = buf-cli.obj-code and
     9219                           sb-cli-gds.host-code = v-cntxt-host-code-obj      and
     9220                           sb-cli-gds.artic     = ub.goods.artic      and
     9221                           sb-cli-gds.prod-type = ub.goods.prod-type  and
     9222                           sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error .
     9223                           if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9224                           else p-recid = ?.
     9225                       run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9226                       if error-status :error then message vss-workfile vss-revision vss-description skip
     9227                                                           error-status :get-message(1)  skip
     9228                                                           "Ошибка вызова процедуры proc-eq-tmp-price"  skip
     9229                                                           .
     9230                 end.
     9231              buffer-copy shar_ord-line to tmp#zakaz.
     9232           end.
     9233           else do:
     9234              create  tmp#zakaz.
     9235              buffer-copy shar_ord-line to tmp#zakaz
     9236                assign
     9237                   tmp#zakaz.gds-name      = ub.goods.gds-name
     9238                   tmp#zakaz.negative-rest = ub.goods.negative-rest
     9239                   tmp#zakaz.unit-base     = ub.goods.unit-base
     9240                   tmp#zakaz.sum           = tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9241              .
     9242               find first buf_ord-line-attr where buf_ord-line-attr.doc-code = shar_ord-line.doc-code
     9243                 and buf_ord-line-attr.gds-code = shar_ord-line.gds-code
     9244                 and buf_ord-line-attr.attr-code = 'min-stock':U no-error.
     9245               if available buf_ord-line-attr then tmp#zakaz.min-stock-old = decimal(buf_ord-line-attr.attr-value).
     9246               find first buf_ord-line-attr where buf_ord-line-attr.doc-code = shar_ord-line.doc-code
     9247                 and buf_ord-line-attr.gds-code = shar_ord-line.gds-code
     9248                 and buf_ord-line-attr.attr-code = 'gds-way':U no-error.
     9249               if available buf_ord-line-attr then tmp#zakaz.gds-way = decimal(buf_ord-line-attr.attr-value).
     9250               find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     9251               if available bufff-units then
     9252               assign
     9253                 tmp#zakaz.unit-type       = bufff-units.type .
     9254               find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     9255               if available bufff-units then
     9256               assign
     9257                 tmp#zakaz.unit-cli-type       = bufff-units.type .
     9258           end.
     9259       end.
     9260       when "excel":u  then do:
     9261   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9262    Assign
     9263    artic#           = chWorkSheet:Range ("A" + T):Value
     9264    prod-type#       = chWorkSheet:Range ("B" + T):Value
     9265    prod-code#       = chWorkSheet:Range ("C" + T):Value  no-error.
     9266     Find FIRST TMP#zakaz   where
     9267       TMP#zakaz.artic           = artic#      and
     9268       TMP#zakaz.prod-type       = prod-type#  and
     9269       TMP#zakaz.prod-code       = prod-code#  no-error.
     9270     if not available TMP#zakaz  THEN  CREATE TMP#zakaz .
     9271     ASSIGN
     9272       TMP#zakaz.artic           = chWorkSheet:Range ("A" + T):Value
     9273       TMP#zakaz.prod-type       = chWorkSheet:Range ("B" + T):Value
     9274       TMP#zakaz.prod-code       = chWorkSheet:Range ("C" + T):Value
     9275       TMP#zakaz.cli-art         = chWorkSheet:Range ("E" + T):Value
     9276       TMP#zakaz.price-cli       = chWorkSheet:Range ("F" + T):Value
     9277       TMP#zakaz.qnty            = chWorkSheet:Range ("G" + T):Value
     9278       TMP#zakaz.initial-qnty    = chWorkSheet:Range ("G" + T):Value no-error .
     9279     if error-status :error then do:
     9280         message "Файл не соответствует заданному формату." view-as alert-box error .
     9281         return error .
     9282     end.
     9283     FIND FIRST ub.goods No-LOCK WHERE ub.goods.prod-type = TMP#zakaz.prod-type AND
     9284                                    ub.goods.prod-code = TMP#zakaz.prod-code AND
     9285                                    ub.goods.artic     = TMP#zakaz.artic   NO-ERROR.
     9286      if error-status :error then return error .
     9287          V-PRICE-EXEL = tmp#zakaz.price-cli.
     9288          find  first sb-cli-gds  where
     9289               sb-cli-gds.host-code = v-cntxt-host-code-obj and
     9290               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9291               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9292               sb-cli-gds.artic     = ub.goods.artic      and
     9293               sb-cli-gds.prod-type = ub.goods.prod-type  and
     9294               sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error.
     9295               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9296               else p-recid = ?.
     9297          run proc-eq-tmp-price ( p-recid , tt)  no-error .
     9298          if error-status :error then message vss-workfile vss-revision vss-description skip
     9299                                              error-status :get-message(1)  skip
     9300                                             "Ошибка вызова процедуры proc-eq-tmp-price exel 2"  skip
     9301                                             .
     9302             assign
     9303               tmp#zakaz.price-cli  = IF V-PRICE-EXEL = 0 OR V-PRICE-EXEL = ? THEN tmp#zakaz.price-cli ELSE V-PRICE-EXEL * tmp#zakaz.cli-base-rate
     9304               tmp#zakaz.price-RUBL = IF V-PRICE-EXEL = 0 OR V-PRICE-EXEL = ? THEN tmp#zakaz.price-RUBL ELSE V-PRICE-EXEL
     9305               tmp#zakaz.cli-qnty   = tmp#zakaz.qnty       / tmp#zakaz.cli-base-rate
     9306               tmp#zakaz.sum        = tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9307               tmp#zakaz.sum-rubl   = tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9308               tmp#zakaz.sum-cli    = tmp#zakaz.price-cli  * tmp#zakaz.cli-qnty
     9309               .
     9310       end.
     9311       when "excel2":u  then do:
     9312   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9313    Assign
     9314    artic#           = chWorkSheet2:Range ("A" + T):Value
     9315    prod-type#       = chWorkSheet2:Range ("B" + T):Value
     9316    prod-code#       = chWorkSheet2:Range ("C" + T):Value  no-error.
     9317     Find FIRST TMP#zakaz   where
     9318       TMP#zakaz.artic           = artic#      and
     9319       TMP#zakaz.prod-type       = prod-type#  and
     9320       TMP#zakaz.prod-code       = prod-code#  no-error.
     9321     if not available TMP#zakaz  THEN  CREATE TMP#zakaz .
     9322     ASSIGN
     9323       TMP#zakaz.artic           = chWorkSheet2:Range ("A" + T):Value
     9324       TMP#zakaz.prod-type       = chWorkSheet2:Range ("B" + T):Value
     9325       TMP#zakaz.prod-code       = chWorkSheet2:Range ("C" + T):Value
     9326       TMP#zakaz.cli-art         = chWorkSheet2:Range ("E" + T):Value
     9327       TMP#zakaz.price-cli       = chWorkSheet2:Range ("F" + T):Value
     9328       TMP#zakaz.qnty            = chWorkSheet2:Range ("G" + T):Value
     9329       TMP#zakaz.initial-qnty    = chWorkSheet2:Range ("G" + T):Value no-error .
     9330     if error-status :error then do:
     9331         message "Файл не соответствует заданному формату." view-as alert-box error .
     9332         return error .
     9333     end.
     9334     FIND FIRST ub.goods No-LOCK WHERE ub.goods.prod-type = TMP#zakaz.prod-type AND
     9335                                    ub.goods.prod-code = TMP#zakaz.prod-code AND
     9336                                    ub.goods.artic     = TMP#zakaz.artic   NO-ERROR.
     9337      if error-status :error then return error .
     9338          V-PRICE-EXEL = tmp#zakaz.price-cli .
     9339         find  first sb-cli-gds  where
     9340               sb-cli-gds.host-code = v-cntxt-host-code-obj and
     9341               sb-cli-gds.cli-type  = buf-cli.obj-type and
     9342               sb-cli-gds.cli-code  = buf-cli.obj-code and
     9343               sb-cli-gds.artic     = ub.goods.artic      and
     9344               sb-cli-gds.prod-type = ub.goods.prod-type  and
     9345               sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error.
     9346               if available sb-cli-gds then p-recid = recid(sb-cli-gds).
     9347               else p-recid = ?.
     9348          run proc-eq-tmp-price ( p-recid,tt)  no-error .
     9349         if error-status :error then message vss-workfile vss-revision vss-description skip
     9350                                             error-status :get-message(1)  skip
     9351                                             "Ошибка вызова процедуры proc-eq-tmp-price exel2 "  skip
     9352                                             .
     9353         assign
     9354           tmp#zakaz.price-cli = IF V-PRICE-EXEL = 0 OR V-PRICE-EXEL = ? THEN tmp#zakaz.price-cli ELSE V-PRICE-EXEL * tmp#zakaz.cli-base-rate
     9355           tmp#zakaz.price-RUBL = IF V-PRICE-EXEL = 0 OR V-PRICE-EXEL = ? THEN tmp#zakaz.price-RUBL ELSE V-PRICE-EXEL
     9356           tmp#zakaz.cli-qnty  =   tmp#zakaz.qnty  / tmp#zakaz.cli-base-rate
     9357           tmp#zakaz.sum       =   tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9358           tmp#zakaz.sum-rubl       =   tmp#zakaz.price-rubl * tmp#zakaz.qnty
     9359           tmp#zakaz.sum-cli   =   tmp#zakaz.price-cli  * tmp#zakaz.cli-qnty
     9360           .
     9361       end.
     9362    end case.
     9363     tmp#zakaz.doc-code        = loc-ord-num   .
     9364     find first buf_ord-dtl  no-lock where
     9365           buf_ord-dtl.artic       = tmp#zakaz.artic     and
     9366           buf_ord-dtl.prod-code   = tmp#zakaz.prod-code and
     9367           buf_ord-dtl.prod-type   = tmp#zakaz.prod-type
     9368       no-error .
     9369       if available buf_ord-dtl
     9370         then assign tmp#zakaz.prt-ok   =   true .
     9371         else assign tmp#zakaz.prt-ok   =   false  .
     9372       find first shar_ord-line exclusive-lock  where
     9373                  shar_ord-line.doc-code  = loc-ord-num    and
     9374                  shar_ord-line.prod-type = tmp#zakaz.prod-type and
     9375                  shar_ord-line.prod-code = tmp#zakaz.prod-code and
     9376                  shar_ord-line.artic     = tmp#zakaz.artic
     9377       no-error.
     9378       if not available shar_ord-line  then  do:
     9379          create shar_ord-line  .
     9380       end.
     9381       if (lookup('шту':U, tmp#zakaz.unit-cli-type) > 0
     9382       or lookup('сер':U, tmp#zakaz.unit-cli-type) > 0 ) and
     9383           tmp#zakaz.cli-qnty <> truncate(tmp#zakaz.cli-qnty, 0) then do:
     9384           tmp#zakaz.cli-qnty = truncate(tmp#zakaz.cli-qnty, 0) + 1 .
     9385           tmp#zakaz.sum-cli  = tmp#zakaz.cli-qnty * tmp#zakaz.price-cli .
     9386           tmp#zakaz.qnty     = tmp#zakaz.cli-qnty * tmp#zakaz.cli-base-rate .
     9387           tmp#zakaz.sum-rubl = tmp#zakaz.qnty * tmp#zakaz.price-rubl .
     9388           tmp#zakaz.sum-base = tmp#zakaz.qnty * tmp#zakaz.price-base .
     9389       end.
     9390       buffer-copy tmp#zakaz to shar_ord-line
     9391            assign shar_ord-line.doc-code    = loc-ord-num
     9392         .
     9393     if tmp#zakaz.line-num = 0 or
     9394        tmp#zakaz.line-num = ? or
     9395        shar_ord-line.line-num = 0 then do:
     9396          find last ll-tmp#zakaz where ll-tmp#zakaz.gds-code  <> tmp#zakaz.gds-code use-index idx-ln no-lock no-error.
     9397           if available ll-tmp#zakaz
     9398               then tmp#zakaz.line-num = ll-tmp#zakaz.line-num + 1.
     9399               else tmp#zakaz.line-num = 1.
     9400          find current shar_ord-line  exclusive-lock  no-error .
     9401          if not error-status :error  then
     9402             shar_ord-line.line-num = tmp#zakaz.line-num .
     9403     end.
     9404   end .
     9405   end procedure.
     9406   procedure disable_ui :
     9407   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9408     hide frame dialog-frame.
     9409   end.
     9410   end procedure.
     9411   procedure enable_ui :
     9412   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9413   if g#type <> 'ОФ':U then do:
     9414     display  loc-cli-type loc-cli-code  doc-date fact-date paytype wrkr tog-type  agnt r-agnt loc-date-ship loc-service boss r-boss loc-qnty loc-exch-code r-currency loc-cli-qnty loc-exch-rate loc-exch-scale r-acc loc-sum-rubl loc-base-rate loc-base-scale loc-sum-base  loc-contract loc-tot-lines  loc-sum-cli slt_type vat_type br-docs e-method br-docs-2 loc-obj-name loc-obj-name-2 loc-pay-type loc-cli-out-doc t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2  loc-hour loc-min  b-contract B-protocol      with frame dialog-frame.
     9415     enable   rect-4 rect-5  rect-7 rect-6 b-exit doc-date fact-date paytype r-paytype r-contract b-contract B-protocol wrkr tog-type  r-wrkr agnt r-agnt loc-date-ship loc-service boss r-boss  loc-qnty loc-exch-code r-currency loc-cli-qnty loc-exch-rate loc-exch-scale r-acc loc-sum-rubl loc-base-rate loc-base-scale  loc-sum-base loc-tot-lines  loc-sum-cli slt_type vat_type br-docs   br-docs-2 b-add b-spec b-way b-del b-chg b-main-calc b-producer b-sch b-alt-post b-gds-prt b-notes  b-uf b-remove  b-renum  b-mark  b-help b-itogs b-export b-import loc-obj-name wrkr-name e-method  a-n-c loc-pay-type loc-cli-out-doc t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2 loc-hour loc-min doc-date      with frame dialog-frame.
     9416   end.
     9417   else do:
     9418     display loc-cli-type loc-cli-code  doc-date fact-date  wrkr tog-type  agnt r-agnt loc-date-ship boss r-boss loc-qnty loc-cli-qnty loc-tot-lines  br-docs e-method br-docs-2 loc-obj-name loc-obj-name-2 loc-pay-type loc-cli-out-doc t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2  loc-hour loc-min      with frame dialog-frame.
     9419     enable  rect-4 rect-5  rect-7 rect-6 b-exit doc-date fact-date  B-protocol wrkr tog-type  r-wrkr agnt r-agnt loc-date-ship boss r-boss  loc-qnty loc-cli-qnty loc-tot-lines  br-docs br-docs-2 b-add b-way b-del b-chg b-main-calc b-producer b-sch b-alt-post b-gds-prt b-notes b-uf b-remove  b-renum  b-mark  b-help b-itogs b-export b-import loc-obj-name wrkr-name e-method  a-n-c t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2 loc-hour loc-min      with frame dialog-frame.
     9420   end.
     9421     if t-action = "add":u  and  g#type <> 'ОФ':U  then do :
     9422        enable  loc-cli-code r-clients with frame dialog-frame .
     9423        disable b-add b-way b-main-calc b-del b-chg b-producer b-alt-post b-export b-import with frame dialog-frame .
     9424     end.
     9425   hide pay-day loc-out-code loc-time-ship b-sch  b-itogs
     9426       in frame dialog-frame .
     9427    disable b-gds-prt with frame dialog-frame .
     9428   if g#type = 'ОФ':U then do:
     9429     hide  loc-exch-code
     9430           loc-exch-rate
     9431           loc-base-rate
     9432           ub.currency.curr-abbr
     9433           loc-exch-scale
     9434           loc-base-scale
     9435           paytype
     9436           loc-pay-type
     9437           loc-cli-out-doc
     9438           r-paytype
     9439           loc-service
     9440           loc-sum-rubl
     9441           loc-sum-base
     9442           loc-sum-cli
     9443           loc-contract
     9444           slt_type
     9445           vat_type
     9446           r-currency
     9447           r-acc
     9448           in frame dialog-frame .
     9449   end.
     9450   view frame dialog-frame.
     9451   end.
     9452   end procedure.
     9453   procedure enable_ui_2 :
     9454   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9455   if g#type <> 'ОФ':U then do:
     9456     display  loc-cli-type loc-cli-code  doc-date fact-date paytype wrkr tog-type  agnt r-agnt loc-date-ship loc-service boss r-boss loc-qnty loc-exch-code r-currency loc-cli-qnty loc-exch-rate loc-exch-scale r-acc loc-sum-rubl loc-base-rate loc-base-scale loc-sum-base  loc-contract loc-tot-lines  loc-sum-cli slt_type vat_type br-docs e-method br-docs-2 loc-obj-name loc-obj-name-2 loc-pay-type loc-cli-out-doc t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2  loc-hour loc-min  b-contract B-protocol      with frame dialog-frame.
     9457     enable   rect-4 rect-5  rect-7 rect-6 b-exit doc-date fact-date paytype r-paytype r-contract b-contract B-protocol wrkr tog-type  r-wrkr agnt r-agnt loc-date-ship loc-service boss r-boss  loc-qnty loc-exch-code r-currency loc-cli-qnty loc-exch-rate loc-exch-scale r-acc loc-sum-rubl loc-base-rate loc-base-scale  loc-sum-base loc-tot-lines  loc-sum-cli slt_type vat_type br-docs   br-docs-2 b-add b-spec b-way b-del b-chg b-main-calc b-producer b-sch b-alt-post b-gds-prt b-notes  b-uf b-remove  b-renum  b-mark  b-help b-itogs b-export b-import loc-obj-name wrkr-name e-method  a-n-c loc-pay-type loc-cli-out-doc t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2 loc-hour loc-min doc-date      with frame dialog-frame.
     9458   end.
     9459   else do:
     9460     display loc-cli-type loc-cli-code  doc-date fact-date  wrkr tog-type  agnt r-agnt loc-date-ship boss r-boss loc-qnty loc-cli-qnty loc-tot-lines  br-docs e-method br-docs-2 loc-obj-name loc-obj-name-2 loc-pay-type loc-cli-out-doc t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2  loc-hour loc-min      with frame dialog-frame.
     9461     enable  rect-4 rect-5  rect-7 rect-6 b-exit doc-date fact-date  B-protocol wrkr tog-type  r-wrkr agnt r-agnt loc-date-ship boss r-boss  loc-qnty loc-cli-qnty loc-tot-lines  br-docs br-docs-2 b-add b-way b-del b-chg b-main-calc b-producer b-sch b-alt-post b-gds-prt b-notes b-uf b-remove  b-renum  b-mark  b-help b-itogs b-export b-import loc-obj-name wrkr-name e-method  a-n-c t agnt-name boss-name prod-name goods-name t-auto date-sale-1 date-sale-2 loc-hour loc-min      with frame dialog-frame.
     9462   end.
     9463   disable   all      with frame dialog-frame.
     9464     enable b-exit  b-producer b-sch b-alt-post  b-notes  b-help b-gds-prt
     9465            br-docs b-export a-n-c
     9466         with frame dialog-frame.
     9467      enable e-method with frame dialog-frame.
     9468      e-method:read-only = true .
     9469    disable b-gds-prt with frame dialog-frame .
     9470     display
     9471      b-exit  b-producer b-sch b-alt-post  b-notes  b-help b-gds-prt
     9472      br-docs b-export  a-n-c
     9473     with frame dialog-frame.
     9474     view frame dialog-frame.
     9475   end.
     9476   end procedure.
     9477   procedure openbr :
     9478   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9479   t-ret =  session:set-wait-state("general") .
     9480   define variable l-query-was-opened as logical no-undo .
     9481   for each tmp#zakaz :
     9482     if (lookup('шту':U, tmp#zakaz.unit-cli-type) > 0
     9483     or lookup('сер':U, tmp#zakaz.unit-cli-type) > 0 ) and
     9484       tmp#zakaz.cli-qnty <> truncate(tmp#zakaz.cli-qnty, 0) then do:
     9485       assign
     9486         tmp#zakaz.cli-qnty = truncate(tmp#zakaz.cli-qnty, 0) + 1 .
     9487       end.
     9488     if (lookup('шту':U, tmp#zakaz.unit-type) > 0
     9489     or lookup('сер':U, tmp#zakaz.unit-type) > 0 ) and
     9490       tmp#zakaz.qnty <> truncate(tmp#zakaz.qnty, 0) then do:
     9491       assign
     9492         tmp#zakaz.qnty = truncate(tmp#zakaz.qnty, 0) + 1 .
     9493       end.
     9494     if tmp#zakaz.cli-base-rate = 0 or tmp#zakaz.cli-base-rate = ? then   do:
     9495     find first ub.goods where
     9496                            tmp#zakaz.artic = ub.goods.artic and
     9497                            tmp#zakaz.prod-type = ub.goods.prod-type and
     9498                            tmp#zakaz.prod-code = ub.goods.prod-code no-lock no-error  .
     9499        if error-status :error then do:
     9500           find first shar_ord-line   where
     9501               shar_ord-line.doc-code        = loc-ord-num    and
     9502               shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     9503               shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     9504               shar_ord-line.artic           = tmp#zakaz.artic   exclusive-lock  no-error.
     9505            if available shar_ord-line  then  delete shar_ord-line  .
     9506            delete tmp#zakaz.
     9507            next.
     9508            end.
     9509        tmp#zakaz.cli-base-rate  = ub.goods.cli-base-rate.
     9510     end.
     9511   end.
     9512   define variable sort-column-phrase as character no-undo .
     9513   case sort-column-name :
     9514     when "" then do:
     9515       assign
     9516         sort-column-phrase = ""
     9517       .
     9518     end.
     9519     otherwise do:
     9520       assign
     9521         sort-column-phrase = "by " + sort-column-name
     9522       .
     9523     end.
     9524   end case.
     9525   case list-mode:
     9526       when 'Контрагент,Обороты':U or when 'Контрагент,Остатки':U then do:
     9527           assign frame dialog-frame:title =  " по фирме :" + v-cntxt-host-name-obj +
     9528           ( if g#type = 'ОФ':U then  " ЗАЯВКА № "
     9529           else
     9530           " ЗАКАЗ  № "  )
     9531           + loc-ord-num
     9532           filter-point = "Заказ_поставщику_new".
     9533           if t-action = "add":u then  frame dialog-frame:title = frame dialog-frame:title + "  - " + 'ДОБАВЛЕНИЕ':U.
     9534           if t-action = "chg":u then  frame dialog-frame:title = frame dialog-frame:title + "  - " + 'ИЗМЕНЕНИЕ':U.
     9535           if t-action = "lkp":u then  frame dialog-frame:title = frame dialog-frame:title + "  - " + 'ПРОСМОТР':U.
     9536           open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code by tmp#zakaz.line-num .
     9537       end.
     9538   end case.
     9539   run select-good-scala in this-procedure .
     9540    apply "home" to br-docs in frame dialog-frame.
     9541   assign
     9542         loc-cli-qnty    = 0
     9543         loc-qnty        = 0
     9544         loc-sum-base    = 0
     9545         loc-sum-cli     = 0
     9546         loc-sum-rubl    = 0
     9547         loc-tot-lines   = 0
     9548        .
     9549   for each tmp#zakaz :
     9550   assign
     9551         loc-cli-qnty    = loc-cli-qnty  +  tmp#zakaz.cli-qnty
     9552         loc-qnty        = loc-qnty      +  tmp#zakaz.qnty
     9553         loc-sum-base    = loc-sum-base  +  tmp#zakaz.sum-base
     9554         loc-sum-cli     = loc-sum-cli   +  tmp#zakaz.sum-cli
     9555         loc-sum-rubl    = loc-sum-rubl  +  tmp#zakaz.sum-rubl
     9556         loc-tot-lines   = loc-tot-lines + 1
     9557        .
     9558   end.
     9559   display
     9560     loc-cli-qnty
     9561     loc-qnty
     9562     loc-sum-base
     9563     loc-sum-cli
     9564     loc-sum-rubl
     9565     loc-tot-lines
     9566     with frame dialog-frame .
     9567     if t-action = "lkp":U then run enable_ui_2 .
     9568     t-ret =  session:set-wait-state("") .
     9569     error-status :error = false .
     9570   end.
     9571   end procedure.
     9572   procedure set-filter-name :
     9573   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9574     define input parameter p-filter-name as character no-undo .
     9575     do with frame dialog-frame:
     9576       if p-filter-name > "" then do:
     9577         assign
     9578           frame dialog-frame:title
     9579             = frame dialog-frame:title + "   ФИЛЬТР: " + p-filter-name.
     9580         .
     9581         assign
     9582           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     9583         .
     9584       end.
     9585       else do:
     9586         assign
     9587           b-sch :tooltip = ""
     9588         .
     9589       end.
     9590     end.
     9591   end.
     9592   end procedure.
     9593   procedure ex-file :
     9594   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9595   define input parameter ff as character no-undo .
     9596   define input parameter ex as logical no-undo .
     9597     if ex = false then do:
     9598         create "excel.application" chexcelapplication connect no-error.
     9599        if error-status:error then
     9600        do:
     9601           create "excel.application" chexcelapplication no-error.
     9602           if error-status :error then
     9603           do:
     9604              message
     9605                 "Ошибка при запуске Excel" skip
     9606                 error-status :get-message(1) skip
     9607                 view-as alert-box error .
     9608              undo, return error .
     9609           end.
     9610        end.
     9611       if ff = ""  then do:
     9612         chworkbook   = chexcelapplication:workbooks:add( ).
     9613       end.
     9614       else do:
     9615         chworkbook   = chexcelapplication:workbooks:open( ff ).
     9616       end.
     9617     end.
     9618     assign     chexcelapplication:interactive = false      chexcelapplication:screenupdating = false      chexcelapplication:visible = false  .
     9619     chworksheet  = chexcelapplication:sheets:item (1).
     9620   end.
     9621   end procedure.
     9622   procedure export-proc :
     9623   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9624   define input parameter numbersheet as integer no-undo .
     9625   define variable ii as integer init 6 no-undo.
     9626   t-ret =  session:set-wait-state("general") .
     9627   mm:
     9628    repeat   :
     9629       ii = ii  + 1.
     9630           if numbersheet = 1 then do:
     9631              if (chworksheet:range("a" + string(ii)):value ="" or chworksheet:range("a" + string(ii)):value = ?) then leave mm.
     9632                 run create-tmp in this-procedure  (input "excel":u , string (ii)  ).
     9633              end.
     9634           if numbersheet = 2 then do:
     9635              if (chworksheet2:range("a" + string(ii)):value ="" or chworksheet2:range("a" + string(ii)):value = ?) then leave mm.
     9636                 run create-tmp in this-procedure  (input "excel2":u , string (ii)  ).
     9637              end.
     9638     end.
     9639     if ii = 6 then disable  loc-cli-code loc-cli-type loc-obj-name r-clients with frame dialog-frame.
     9640     t-ret =  session:set-wait-state("") .
     9641     run openbr in this-procedure  .
     9642     message "Импортировано " + string (ii - 7) + " товаров".
     9643     end.
     9644   end.
     9645   procedure p-b-itogs :
     9646   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9647     g#log = true  .
     9648     tmp-rec = recid( tmp#zakaz ).
     9649     do while available tmp#zakaz :
     9650           get prev br-docs.
     9651     end.
     9652     run cus/z-tot.p
     9653       (input parparentproc,
     9654        input "":u,
     9655        input date-1,
     9656        input date-2) .
     9657     reposition br-docs to recid tmp-rec no-error.
     9658   end.
     9659   end procedure.
     9660   procedure  b-import-excel :
     9661   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9662      define variable ff as character no-undo.
     9663      define variable var-name-sheet as character no-undo .
     9664     message "Импорт из excel данных по заказу ."
     9665     "При импорте используется работа с COM объектом Excel, поэтому не прерывайте работу Excel и не нарушайте уже законнекченную связь!"
     9666     skip "Продолжать ?"
     9667              view-as alert-box question
     9668              buttons
     9669              ok-cancel update g#log.
     9670              if not g#log then return no-apply.
     9671      var#import = true.
     9672      chworkbook = chexcelapplication:activeworkbook no-error.
     9673      g#log = false .
     9674      if chworkbook = 0 or chworkbook = ? then  do:
     9675           define variable okpressed as logical initial true no-undo.
     9676           system-dialog get-file ff
     9677               title      "Выберите файл ..."
     9678               filters    "excel (*.xls)"   "*.xls"
     9679                           use-filename
     9680                           must-exist
     9681                           update okpressed.
     9682                           if okpressed = true then
     9683                              do: run ex-file in this-procedure   (ff, false) . end.
     9684                           else return no-apply .
     9685      end.
     9686      chworkbook = chexcelapplication:activeworkbook no-error.
     9687      chworksheet  = chexcelapplication:sheets:item(1):select  no-error.
     9688      chworksheet  = chexcelapplication:sheets:item(1) no-error.
     9689      assign
     9690      g#log = true  .
     9691       var-name-sheet = chexcelapplication:sheets:item(1):name no-error.
     9692       if   var-name-sheet = "Результат" then do:
     9693       message "Начинаем экспорт  " skip
     9694               "файл:  " chworkbook:fullname  skip
     9695               "закладка: "  var-name-sheet  skip
     9696               "Продолжить ? "
     9697                view-as alert-box question buttons ok-cancel update g#log.
     9698                if g#log = true then  run export-proc in this-procedure  (1).
     9699           end.
     9700      else do:
     9701       message "Начинаем экспорт  " skip
     9702               "Файл сделан не в системе 'ЗАКАЗЫ' !!! "
     9703               "файл:  " chworkbook:fullname  skip
     9704                 "Продолжить ? "
     9705                view-as alert-box question buttons ok-cancel update g#log.
     9706                if g#log = true then  run export-proc in this-procedure  (1).
     9707      end.
     9708     RELEASE OBJECT chWorksheet2 NO-ERROR.
     9709     RELEASE OBJECT chWorksheet NO-ERROR.
     9710     RELEASE OBJECT chWorkbook NO-ERROR.
     9711     chExcelApplication :QUIT().
     9712     RELEASE OBJECT  chExcelApplication  NO-ERROR.
     9713   end.
     9714   end procedure.
     9715   procedure r-clients-ch :
     9716   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9717   define variable bttns     as   character no-undo.
     9718   define variable rid-list    as  character no-undo .
     9719     run ref/cli-all.w (input parparentproc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list) no-error .
     9720      if error-status :error or rid-list = '' then return error return-value .
     9721       assign
     9722        rep-rec = integer(rid-list)
     9723        no-error.
     9724     find first buf-cli where recid(buf-cli) = rep-rec no-lock no-error.
     9725     if not( buf-cli.obj-type = 'орг':U or buf-cli.obj-type = 'чел':U ) then do:
     9726       message "Заказать можно только у ОРГАНИЗАЦИЙ или Физ.лиц" view-as alert-box .
     9727       return error return-value .
     9728     end.
     9729     find first ub.clients where recid(ub.clients) = rep-rec no-lock no-error.
     9730     assign
     9731     loc-cli-code = buf-cli.obj-code
     9732     loc-cli-type = buf-cli.obj-type
     9733     loc-obj-name = buf-cli.obj-name
     9734     loc-cli-code:screen-value in frame dialog-frame = string( buf-cli.obj-code)
     9735     loc-cli-type:screen-value in frame dialog-frame = buf-cli.obj-type
     9736     loc-obj-name:screen-value in frame dialog-frame = buf-cli.obj-name no-error.
     9737       if avail buf-cli then do:
     9738           enable  b-spec  b-add b-way b-main-calc b-del b-chg b-producer b-alt-post b-export b-import with frame dialog-frame.
     9739           disable
     9740              loc-cli-code
     9741              loc-cli-type
     9742              loc-obj-name
     9743              r-clients
     9744              with frame dialog-frame.
     9745             run ver-clients  in this-procedure ( input loc-cli-type , input loc-cli-code , output v-err) .
     9746             if  v-err then return error.
     9747       end.
     9748       else return error .
     9749       display loc-cli-code loc-cli-type loc-obj-name
     9750       with frame dialog-frame.
     9751   end.
     9752   end procedure.
     9753   procedure b-export-ch :
     9754   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9755     message "Экспорт в excel ." skip "Продолжать ?"
     9756              view-as alert-box question buttons ok-cancel update g#log.
     9757              if not g#log then return no-apply.
     9758         run cus/z-tot1.p (PARPARENTPROC , loc-ord-num , v-cntxt-obj-type , v-cntxt-obj-code ).
     9759   end.
     9760   end procedure.
     9761   procedure leave-loc-cli-code.
     9762   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9763    assign frame dialog-frame loc-cli-code loc-cli-type .
     9764    if v-fl = false  then do:
     9765     assign frame dialog-frame loc-cli-code  .
     9766       if loc-cli-type = ? or loc-cli-type = "" then loc-cli-type = 'орг':U .
     9767       find first buf-cli no-lock where  buf-cli.obj-type = loc-cli-type
     9768                                     and buf-cli.obj-code = loc-cli-code  no-error.
     9769       rep-rec = recid (buf-cli) no-error.
     9770       find first ub.clients where recid(ub.clients) = rep-rec no-lock no-error.
     9771       if avail ub.clients then do:
     9772             loc-obj-name = ub.clients.obj-name .
     9773             display  loc-cli-code loc-cli-type loc-obj-name with frame dialog-frame.
     9774             enable   b-spec b-add b-way b-main-calc b-del b-chg b-producer b-alt-post b-export b-import with frame dialog-frame.
     9775             disable  loc-cli-code loc-cli-type loc-obj-name r-clients  with frame dialog-frame.
     9776           end.
     9777           else do:
     9778             assign
     9779             loc-obj-name:screen-value = ""
     9780             loc-cli-type:screen-value = ""
     9781             loc-cli-code:screen-value = ?
     9782             .
     9783             disable b-add b-way b-del b-chg b-producer b-alt-post b-main-calc b-export b-import with frame dialog-frame.
     9784             return error .
     9785           end.
     9786    end.
     9787    else v-fl = false .
     9788     assign
     9789     is-edoc-nn-doc = status-is-edoc-nn ( input is-edoc-nn
     9790                                         , input loc-cli-type
     9791                                         , input loc-cli-code
     9792                                         , input loc-store-type
     9793                                         , input loc-store-code
     9794                                         ) .
     9795     assign
     9796     is-edi-doc = status-is-edi ( input is-edi
     9797                                 , input loc-cli-type
     9798                                 , input loc-cli-code
     9799                                 , input loc-store-type
     9800                                 , input loc-store-code
     9801                                 , output v-dm-edi
     9802                                 ) .
     9803   end.
     9804   end procedure.
     9805   procedure leave-loc-cli-type :
     9806   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9807     assign frame dialog-frame loc-cli-type .
     9808     if loc-cli-code <> ? or loc-cli-code <> 0 then do:
     9809       find first buf-cli where loc-cli-type = buf-cli.obj-type  and loc-cli-code = buf-cli.obj-code  no-lock no-error.
     9810       rep-rec = recid(buf-cli)  no-error.
     9811       find first ub.clients where recid ( ub.clients) = rep-rec no-lock no-error.
     9812       if available ub.clients then do:
     9813           loc-obj-name = ub.clients.obj-name .
     9814           display  loc-cli-code loc-cli-type loc-obj-name with frame dialog-frame.
     9815           enable b-spec b-add b-way b-del b-chg b-producer b-alt-post b-main-calc with frame dialog-frame.
     9816           end.
     9817           else do:
     9818             assign
     9819             loc-obj-name:screen-value = ""
     9820             loc-cli-type:screen-value = ""
     9821             loc-cli-code:screen-value = ?
     9822             .
     9823             message "Неправильно задан код или тип Поставщика !".
     9824             disable b-add b-way b-del b-chg b-producer b-alt-post b-main-calc with frame dialog-frame.
     9825           end.
     9826       end.
     9827     assign
     9828     is-edoc-nn-doc = status-is-edoc-nn ( input is-edoc-nn
     9829                                         , input loc-cli-type
     9830                                         , input loc-cli-code
     9831                                         , input loc-store-type
     9832                                         , input loc-store-code
     9833                                         ) .
     9834     assign
     9835     is-edi-doc = status-is-edi ( input is-edi
     9836                                 , input loc-cli-type
     9837                                 , input loc-cli-code
     9838                                 , input loc-store-type
     9839                                 , input loc-store-code
     9840                                 , output v-dm-edi
     9841                                 ) .
     9842   end.
     9843   end procedure.
     9844   procedure choose-menu-add1 :
     9845   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9846   if lookup( date-sale-2 :type in frame dialog-frame
     9847            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     9848            ) = 0
     9849   then do:
     9850     message
     9851       "Указанному интерфейсному элементу фокус не может быть передан" skip
     9852       "Интерфейсный элемент" date-sale-2 :name  in frame dialog-frame skip
     9853       "Тип" date-sale-2 :type  in frame dialog-frame skip
     9854       "Процедура" this-procedure :file-name skip
     9855       view-as alert-box .
     9856   end.
     9857   else do:
     9858     apply "entry":u to date-sale-2  in frame dialog-frame .
     9859     assign frame dialog-frame LOC-DATE-SHIP
     9860                                DATE-sale-1
     9861                                DATE-sale-2
     9862                                doc-date
     9863                                .
     9864   end.
     9865   define variable ii as integer init 0 no-undo.
     9866   define variable r-tmp as recid no-undo .
     9867   define variable r-stop as logical no-undo .
     9868   define variable r-exit as logical no-undo .
     9869   if g#type = 'ОФ':U then do:
     9870      message "Режим не доступен для Заявок."  view-as alert-box information.
     9871      return.
     9872      end.
     9873   t-ret =  session:set-wait-state("general") .
     9874    line-mode = 'ДОБАВЛЕНИЕ':U .
     9875     find first buf-cli where recid(buf-cli) = rep-rec no-lock no-error.
     9876     for each sb-cli-gds where sb-cli-gds.host-code = v-cntxt-host-code-obj
     9877                               and sb-cli-gds.cli-type = buf-cli.obj-type
     9878                               and sb-cli-gds.cli-code = buf-cli.obj-code
     9879                               and ( sb-cli-gds.cancel-date = ?  or  sb-cli-gds.cancel-date > to-day ) no-lock :
     9880        find first ub.goods  where ub.goods.prod-type = sb-cli-gds.prod-type and
     9881                                   ub.goods.prod-code = sb-cli-gds.prod-code and
     9882                                   ub.goods.artic =     sb-cli-gds.artic no-lock no-error.
     9883        ii = ii  + 1.
     9884        if ii > 1 then assign line-mode = "ЦИКЛ":u.
     9885        run create-tmp in this-procedure  (input "price":u ,"") no-error .
     9886         if not  error-status :error  and not t-auto then do:
     9887               run cus/ord-frm.w ( input ParParentProc,  input recid ( tmp#zakaz ) , input line-mode , output r-stop , output r-exit) .
     9888               if r-stop then do:
     9889                  run p-delete( recid ( tmp#zakaz ) ,input-output ii ) .
     9890                  leave.
     9891                  end.
     9892               if r-exit then do:
     9893                  run p-delete( recid ( tmp#zakaz ) ,input-output ii ) .
     9894                  end.
     9895           end.
     9896     end.
     9897     if ii > 0 then disable  loc-cli-code loc-cli-type loc-obj-name r-clients with frame dialog-frame.
     9898     t-ret =  session:set-wait-state("") .
     9899     run openbr in this-procedure  .
     9900     reposition br-docs to recid tmp-rec no-error.
     9901     message "Добавлено по поставщику " + string (ii) + " товаров".
     9902   end.
     9903   end procedure.
     9904   procedure apply-focus-next-entry :
     9905   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9906     define input parameter p-widget-handle as handle no-undo .
     9907     define variable l-apply-entry as logical no-undo .
     9908     assign
     9909       l-apply-entry =   true
     9910     .
     9911     do with frame dialog-frame:
     9912     if loc-cli-type :handle = p-widget-handle then do:   if loc-cli-code :sensitive then do:  apply "entry":u to loc-cli-code. return . end. end.
     9913     if loc-cli-code :handle = p-widget-handle then do:   if wrkr         :sensitive then do:  apply "entry":u to wrkr        . return . end. end.
     9914     if wrkr    :handle       = p-widget-handle then do:  if agnt         :sensitive then do:  apply "entry":u to agnt        . return . end. end.
     9915     if agnt    :handle = p-widget-handle then do:        if boss         :sensitive then do:  apply "entry":u to boss        . return . end. end.
     9916     if boss    :handle = p-widget-handle then do:
     9917                if paytype      :sensitive then do:
     9918                   apply "entry":u to paytype     . return .
     9919                end.
     9920                else do:
     9921                   apply "entry":u to  b-add  . return .
     9922                end.
     9923     end.
     9924     if paytype :handle = p-widget-handle then do:      if b-add  :sensitive then do:  apply "choose":u to b-add .  return . end. end.
     9925     if r-contract :handle = p-widget-handle then do:   if b-spec :sensitive then do:  apply "choose":u to b-spec . return . end. end.
     9926     end.
     9927   end.
     9928   end procedure.
     9929   procedure create-tmp-dtl :
     9930   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9931     if not avail  shar_ord-doc  then return.
     9932           for each shar_ord-dtl where shar_ord-dtl.doc-code = shar_ord-doc.doc-code no-lock :
     9933             find first ub.gds-prt where ub.gds-prt.node-code =  shar_ord-dtl.node-code no-lock no-error .
     9934             if avail ub.gds-prt then do :
     9935              create tmp#zakaz-dtl no-error.
     9936              if error-status :error then do:
     9937                 find first  tmp#zakaz-dtl where
     9938                       tmp#zakaz-dtl.artic       = shar_ord-dtl.artic     and
     9939                       tmp#zakaz-dtl.prod-code   = shar_ord-dtl.prod-code and
     9940                       tmp#zakaz-dtl.prod-type   = shar_ord-dtl.prod-type and
     9941                       tmp#zakaz-dtl.node-code   = shar_ord-dtl.node-code no-error .
     9942                 end.
     9943              assign
     9944                 tmp#zakaz-dtl.prt-name               = ub.gds-prt.f-name
     9945                 tmp#zakaz-dtl.artic                  = shar_ord-dtl.artic
     9946                 tmp#zakaz-dtl.prod-code              = shar_ord-dtl.prod-code
     9947                 tmp#zakaz-dtl.prod-type              = shar_ord-dtl.prod-type
     9948                 tmp#zakaz-dtl.node-code              = shar_ord-dtl.node-code
     9949                 tmp#zakaz-dtl.cancel-cli-qnty        = shar_ord-dtl.cancel-cli-qnty
     9950                 tmp#zakaz-dtl.cancel-qnty            = shar_ord-dtl.cancel-qnty
     9951                 tmp#zakaz-dtl.qnty                   = shar_ord-dtl.qnty
     9952                 tmp#zakaz-dtl.cli-qnty               = shar_ord-dtl.cli-qnty
     9953                 tmp#zakaz-dtl.doc-code               = shar_ord-dtl.doc-code
     9954                 tmp#zakaz-dtl.initial-cli-qnty       = shar_ord-dtl.initial-cli-qnty
     9955                 tmp#zakaz-dtl.initial-qnty           = shar_ord-dtl.initial-qnty
     9956                 tmp#zakaz-dtl.add-cli-qnty           = shar_ord-dtl.add-cli-qnty
     9957                 tmp#zakaz-dtl.add-qnty               = shar_ord-dtl.add-qnty
     9958                 tmp#zakaz-dtl.order-cli-qnty         = shar_ord-dtl.order-cli-qnty
     9959                 tmp#zakaz-dtl.order-qnty             = shar_ord-dtl.order-qnty
     9960                 tmp#zakaz-dtl.price-base             = shar_ord-dtl.price-base
     9961                 tmp#zakaz-dtl.price-cli              = shar_ord-dtl.price-cli
     9962                 tmp#zakaz-dtl.price-rubl             = shar_ord-dtl.price-rubl
     9963                 tmp#zakaz-dtl.receive-cli-qnty       = shar_ord-dtl.receive-cli-qnty
     9964                 tmp#zakaz-dtl.receive-qnty           = shar_ord-dtl.receive-qnty
     9965                 tmp#zakaz-dtl.sum-base               = shar_ord-dtl.sum-base
     9966                 tmp#zakaz-dtl.sum-cli                = shar_ord-dtl.sum-cli
     9967                 tmp#zakaz-dtl.sum-rubl               = shar_ord-dtl.sum-rubl
     9968                 no-error  .
     9969                if error-status :error then message 'error create tmp#zakaz-dtl'.
     9970                 find first  tmp#zakaz where
     9971                       tmp#zakaz.artic       = shar_ord-dtl.artic     and
     9972                       tmp#zakaz.prod-code   = shar_ord-dtl.prod-code and
     9973                       tmp#zakaz.prod-type   = shar_ord-dtl.prod-type
     9974                       no-error .
     9975                  if avail tmp#zakaz then
     9976                  assign tmp#zakaz.prt-ok   =   true .
     9977              end.
     9978     end.
     9979   end.
     9980   end procedure.
     9981   procedure select-good-scala :
     9982   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     9983     find current shar_ord-line  no-lock  no-error .
     9984     if not avail shar_ord-line then return.
     9985     find first TMP#zakaz no-lock    where
     9986                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     9987                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     9988                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     9989     if not avail TMP#zakaz   then do:
     9990        return.
     9991     end.
     9992   assign
     9993       x-prod-type = tmp#zakaz.prod-type
     9994       x-prod-code = tmp#zakaz.prod-code
     9995       x-artic     = tmp#zakaz.artic
     9996       .
     9997   open query br-docs-2 for each tmp#zakaz-dtl no-lock where tmp#zakaz-dtl.artic = x-artic and tmp#zakaz-dtl.prod-type = x-prod-type and tmp#zakaz-dtl.prod-code = x-prod-code .
     9998     find first for-cli no-lock where for-cli.obj-type = tmp#zakaz.prod-type and
     9999                                      for-cli.obj-code = tmp#zakaz.prod-code no-error.
    10000     if avail for-cli then do:
    10001         display for-cli.obj-name      @ prod-name
    10002                 tmp#zakaz.gds-name    @ goods-name
    10003                 with frame dialog-frame .
    10004     end.
    10005     else do:
    10006         display "" @ prod-name  with frame dialog-frame.
    10007     end.
    10008     if error-status :error  then message "123-" error-status :error.
    10009   end.
    10010   end procedure .
    10011   procedure check-exch :
    10012   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10013     find ub.currency where ub.currency.curr-code = (input frame dialog-frame loc-exch-code   ) no-lock no-error.
    10014     if not available ub.currency then do:
    10015       message "Неправильная валюта поставщика - такой валюты нет.".
    10016       apply "entry" to loc-exch-code in frame dialog-frame.
    10017       return error.
    10018     end.
    10019     if loc-exch-code <> ub.currency.curr-code then do:
    10020       if ub.currency.curr-code = 0 then do:
    10021         if (loc-exch-rate <> ? and loc-exch-scale <> ? and
    10022             (loc-exch-rate <> 1 or loc-exch-scale <> 1)) then do:
    10023           g#log = no.
    10024           message "Пересчитать цены поставщика в рубли по курсу поставщика ?"
    10025                           view-as alert-box question buttons yes-no update g#log.
    10026           if g#log then do:
    10027             run waitfram-show ("Пересчет цен поставщика в рубли. Ждите...").
    10028             for each tmp#zakaz where :
    10029               tmp#zakaz.price-cli = tmp#zakaz.price-cli * loc-exch-rate / loc-exch-scale.
    10030             end.
    10031             run waitfram-hide.
    10032           end.
    10033         end.
    10034         loc-print-rubl = yes.
    10035         assign
    10036           loc-exch-rate = 1
    10037           loc-exch-scale = 1
    10038           .
    10039         disable loc-exch-rate loc-exch-scale r-acc with frame dialog-frame.
    10040       end.
    10041       else do:
    10042         find last ub.curr-accnt where ub.curr-accnt.curr-code = ub.currency.curr-code
    10043                                use-index pi no-lock no-error.
    10044         if available ub.curr-accnt then assign
    10045             loc-exch-rate = ub.curr-accnt.exch-rate
    10046             loc-exch-scale = ub.curr-accnt.exch-scale.
    10047         else assign
    10048             loc-exch-rate = ?
    10049             loc-exch-scale = ?.
    10050         if loc-exch-code = 0 and
    10051           (loc-exch-rate  <> ? and
    10052            loc-exch-scale <> ? and
    10053            (loc-exch-rate <> 1 or loc-exch-scale <> 1)
    10054           ) then do:
    10055           g#log = no.
    10056           message "Пересчитать цены поставщика в валюту ГТД по курсу ММВБ (справочника) ?"
    10057                           view-as alert-box question buttons yes-no update g#log.
    10058           if g#log then do:
    10059             run waitfram-show ("Пересчет цен поставщика в валюту ГТД. Ждите...").
    10060               for each tmp#zakaz where  :
    10061               tmp#zakaz.price-cli = tmp#zakaz.price-cli / loc-exch-rate * loc-exch-scale.
    10062             end.
    10063             run waitfram-hide.
    10064           end.
    10065         end.
    10066         loc-print-rubl = no.
    10067         enable loc-exch-rate loc-exch-scale r-acc with frame dialog-frame.
    10068       end.
    10069        loc-exch-code = ub.currency.curr-code.
    10070        run enable_Ui.
    10071         enable b-add b-way b-main-calc b-del b-chg b-producer b-alt-post b-export b-import  with frame dialog-frame .
    10072         disable  loc-cli-code loc-cli-type r-clients  with frame dialog-frame .
    10073     end.
    10074   end.
    10075   end procedure.
    10076   procedure row-leave-br-doc :
    10077   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10078     find current shar_ord-line  no-lock  no-error .
    10079          if not avail shar_ord-line then return.
    10080     find first TMP#zakaz no-lock    where
    10081               tmp#zakaz.prod-type = shar_ord-line.prod-type       and
    10082               tmp#zakaz.prod-code = shar_ord-line.prod-code       and
    10083               tmp#zakaz.artic     = shar_ord-line.artic           no-error  .
    10084     if not avail TMP#zakaz   then do:
    10085          message  vss-workfile vss-revision vss-description skip
    10086           error-status :get-message(1)    skip
    10087          "Ни чего не могу найти !!!".
    10088          return.
    10089          end.
    10090     if (lookup('шту':U, tmp#zakaz.unit-cli-type) > 0
    10091     or lookup('сер':U, tmp#zakaz.unit-cli-type) > 0 ) and
    10092        dec(tmp#zakaz.cli-qnty:screen-value in browse br-docs) <> truncate(dec(tmp#zakaz.cli-qnty:screen-value in browse br-docs), 0) then do:
    10093           message "Количество заказа не может быть дробным ! " view-as alert-box .
    10094             tmp#zakaz.cli-qnty:screen-value in browse br-docs = string(truncate(dec(tmp#zakaz.cli-qnty:screen-value in browse br-docs), 0) + 1).
    10095     end.
    10096     if not current-changed(tmp#zakaz) then
    10097     assign tmp#zakaz.cli-art = tmp#zakaz.cli-art:screen-value in browse br-docs
    10098            tmp#zakaz.cli-qnty = decimal(tmp#zakaz.cli-qnty:screen-value in browse br-docs)
    10099            tmp#zakaz.sum-cli  = tmp#zakaz.cli-qnty * tmp#zakaz.price-cli
    10100            tmp#zakaz.sum-cli:screen-value in browse br-docs = string (tmp#zakaz.sum-cli , "->>>>>>>>>>>9.99") no-error.
    10101   end.
    10102   end procedure.
    10103   procedure make-obj-list :
    10104   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10105       if x-mode = "obj":u then do:
    10106   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10107   run create_obj-list in this-procedure
    10108    ( input v-cntxt-obj-type ,
    10109      input v-cntxt-obj-code )
    10110     no-error .
    10111       end.
    10112       else do:
    10113         for each ub.shop where ub.shop.host-code   = v-cntxt-host-code-obj:
    10114   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10115   run create_obj-list in this-procedure
    10116    ( input 'маг':U ,
    10117      input ub.shop.obj-code )
    10118     no-error .
    10119         end.
    10120         for each ub.store where ub.store.host-code  = v-cntxt-host-code-obj:
    10121   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10122   run create_obj-list in this-procedure
    10123    ( input 'скл':U ,
    10124      input ub.store.obj-code )
    10125     no-error .
    10126         end.
    10127        end.
    10128   end.
    10129   end procedure.
    10130   procedure val-ch-type:
    10131   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10132   define input parameter parself-name as character no-undo.
    10133   if caps(parself-name) = "slt_type" then run val-ch-slt-type no-error.
    10134   else do:
    10135      if caps(parself-name) = "vat_type" then run val-ch-vat-type no-error.
    10136         else do:
    10137             message "Неверный self:name " parself-name
    10138                     " при передаче в процедуру val-ch-type."
    10139             view-as alert-box error.
    10140             return error.
    10141         end.
    10142   end.
    10143   if error-status:error then do:
    10144         display slt_type with frame dialog-frame.
    10145         display vat_type with frame dialog-frame.
    10146         return no-apply.
    10147   end.
    10148   end.
    10149   end procedure.
    10150   procedure r-proc-currency :
    10151   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10152   assign
    10153   ref-rec = ?.
    10154   run ref/currency.w ( input parparentproc, "b-sel", input-output ref-rec ).
    10155   if ref-rec = ? then return .
    10156   find ub.currency where recid ( ub.currency ) = ref-rec no-lock.
    10157     if ub.currency.curr-code <> loc-exch-code then do:
    10158       run check-update no-error.
    10159       if error-status :error then do:
    10160           message
    10161             vss-workfile vss-revision vss-description skip
    10162             error-status :get-message(1) skip
    10163             return-value skip
    10164             ""
    10165             view-as alert-box error
    10166           .
    10167          return error.
    10168       end.
    10169     end.
    10170   run exch-rate.
    10171   run full-recount.
    10172   display loc-sum-rubl
    10173          loc-sum-base
    10174          loc-sum-cli
    10175          loc-exch-code
    10176          with frame dialog-frame .
    10177   run openbr in this-procedure  .
    10178   end.
    10179   end procedure.
    10180   procedure update-rate-doc:
    10181   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10182   if input frame dialog-frame loc-exch-rate  <> loc-exch-rate  or
    10183      input frame dialog-frame loc-exch-scale <> loc-exch-scale or
    10184      input frame dialog-frame loc-base-rate  <> loc-base-rate  or
    10185      input frame dialog-frame loc-base-scale <> loc-base-scale then
    10186      do transaction on error     undo, return error
    10187                       on end-key undo, return error
    10188                       on stop    undo, return error :
    10189        run check-exch.
    10190        run check-update.
    10191        run check-rate.
    10192       end.
    10193       run ui-on .
    10194   end.
    10195   end procedure.
    10196   procedure choice-currency:
    10197   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10198   assign frame  dialog-frame cycle-day loc-date-ship  loc-service date-sale-1 date-sale-2 .
    10199   find ub.currency where ub.currency.curr-code = input frame dialog-frame loc-exch-code no-error.
    10200   if not available ub.currency then do:
    10201     assign
    10202     ref-rec = ?.
    10203     run ref/currency.w ( input parparentproc, "b-sel", input-output ref-rec ).
    10204     if ref-rec = ? then return error.
    10205     find ub.currency where recid ( ub.currency ) = ref-rec.
    10206   end.
    10207   run exch-rate.
    10208   end.
    10209   end procedure.
    10210   procedure exch-rate:
    10211   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10212   disp ub.currency.curr-code @ loc-exch-code with frame dialog-frame.
    10213   do transaction on error   undo, return no-apply
    10214                  on end-key undo, return no-apply
    10215                  on stop    undo, return no-apply:
    10216      run check-exch.
    10217      run check-rate.
    10218      run full-recount.
    10219           display loc-sum-rubl
    10220                   loc-sum-base
    10221                   loc-sum-cli
    10222                   loc-exch-code
    10223                   with frame dialog-frame .
    10224             run openbr in this-procedure  .
    10225   end.
    10226   run ui-on .
    10227   end.
    10228   end procedure.
    10229   procedure full-recount:
    10230   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10231   define variable     varprice-cli                    like ub.doc-line.price-base no-undo .
    10232   define variable     varprice-cli-unit-base          like ub.doc-line.price-base no-undo .
    10233   define variable     varprice-road-tax               like ub.doc-line.price-base no-undo .
    10234   define variable     varprice-other-exp              like ub.doc-line.price-base no-undo .
    10235   define variable     varprice-transport-exp          like ub.doc-line.price-base no-undo .
    10236   define variable     varprice-without-abs            like ub.doc-line.price-base no-undo .
    10237   define variable     varprice-slt                    like ub.doc-line.price-base no-undo .
    10238   define variable     varprice-no-slt                 like ub.doc-line.price-base no-undo .
    10239   define variable     varprice-vat                    like ub.doc-line.price-base no-undo .
    10240   define variable     varprice-no-vat-slt             like ub.doc-line.price-base no-undo .
    10241   define variable     varprice-rubl                   like ub.doc-line.price-base no-undo .
    10242   define variable     varprice-road-tax-rubl          like ub.doc-line.price-base no-undo .
    10243   define variable     varprice-other-exp-rubl         like ub.doc-line.price-base no-undo .
    10244   define variable     varprice-transport-exp-rubl     like ub.doc-line.price-base no-undo .
    10245   define variable     varprice-without-abs-rubl       like ub.doc-line.price-base no-undo .
    10246   define variable     varprice-slt-rubl               like ub.doc-line.price-base no-undo .
    10247   define variable     varprice-no-slt-rubl            like ub.doc-line.price-base no-undo .
    10248   define variable     varprice-vat-rubl               like ub.doc-line.price-base no-undo .
    10249   define variable     varprice-no-vat-slt-rubl        like ub.doc-line.price-base no-undo .
    10250   define variable     varprice-base                   like ub.doc-line.price-base no-undo .
    10251   define variable     varprice-road-tax-base          like ub.doc-line.price-base no-undo .
    10252   define variable     varprice-other-exp-base         like ub.doc-line.price-base no-undo .
    10253   define variable     varprice-transport-exp-base     like ub.doc-line.price-base no-undo .
    10254   define variable     varprice-without-abs-base       like ub.doc-line.price-base no-undo .
    10255   define variable     varprice-slt-base               like ub.doc-line.price-base no-undo .
    10256   define variable     varprice-no-slt-base            like ub.doc-line.price-base no-undo .
    10257   define variable     varprice-vat-base               like ub.doc-line.price-base no-undo .
    10258   define variable     varprice-no-vat-slt-base        like ub.doc-line.price-base no-undo .
    10259      assign
    10260         loc-sum-rubl  = 0
    10261         loc-sum-base  = 0
    10262         loc-sum-cli   = 0
    10263      .
    10264   for each tmp#zakaz  :
    10265       if vat_type = 'без':U then  do:
    10266          tmp#zakaz.vat-pc = 0.
    10267       end.
    10268       if slt_type = 'без':U then  do:
    10269          tmp#zakaz.slt-pc = 0.
    10270       end.
    10271   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
    10272     (
    10273      input   'zakaz':u
    10274     ,input   loc-base-rate
    10275     ,input   loc-base-scale
    10276     ,input   loc-exch-rate
    10277     ,input   loc-exch-scale
    10278     ,input   vat_type
    10279     ,input   slt_type
    10280     ,input   tmp#zakaz.artic
    10281     ,input   tmp#zakaz.prod-type
    10282     ,input   tmp#zakaz.prod-code
    10283     ,input   tmp#zakaz.price-cli
    10284     ,input   tmp#zakaz.cli-base-rate
    10285     ,input   tmp#zakaz.price-rubl
    10286     ,input   tmp#zakaz.vat-pc
    10287     ,input   tmp#zakaz.slt-pc
    10288     ,input   tmp#zakaz.road-tax
    10289     ,input   tmp#zakaz.transport-rubl
    10290     ,input   tmp#zakaz.other-rubl
    10291     ,output  varprice-cli
    10292     ,output  varprice-cli-unit-base
    10293     ,output  varprice-road-tax
    10294     ,output  varprice-other-exp
    10295     ,output  varprice-transport-exp
    10296     ,output  varprice-without-abs
    10297     ,output  varprice-slt
    10298     ,output  varprice-no-slt
    10299     ,output  varprice-vat
    10300     ,output  varprice-no-vat-slt
    10301     ,output  varprice-rubl
    10302     ,output  varprice-road-tax-rubl
    10303     ,output  varprice-other-exp-rubl
    10304     ,output  varprice-transport-exp-rubl
    10305     ,output  varprice-without-abs-rubl
    10306     ,output  varprice-slt-rubl
    10307     ,output  varprice-no-slt-rubl
    10308     ,output  varprice-vat-rubl
    10309     ,output  varprice-no-vat-slt-rubl
    10310     ,output  varprice-base
    10311     ,output  varprice-road-tax-base
    10312     ,output  varprice-other-exp-base
    10313     ,output  varprice-transport-exp-base
    10314     ,output  varprice-without-abs-base
    10315     ,output  varprice-slt-base
    10316     ,output  varprice-no-slt-base
    10317     ,output  varprice-vat-base
    10318     ,output  varprice-no-vat-slt-base
    10319     ) no-error.
    10320     if error-status:error then do:
    10321        return error substitute("Ошибка при пересчете линии ЗАКАЗА , &1" , return-value  ) .
    10322     end.
    10323     assign tmp#zakaz.price-cli  = round(varprice-cli,2)
    10324            tmp#zakaz.price-rubl = round(varprice-rubl,2)
    10325            tmp#zakaz.price-base = round(varprice-base,2)
    10326            tmp#zakaz.sum-vat    = if var-report-r-b = "rubl" then round(varprice-vat-rubl,2)
    10327                                                              else round(varprice-vat-base,2)
    10328            tmp#zakaz.sum-cli    = round(varprice-cli ,2) * tmp#zakaz.cli-qnty
    10329            tmp#zakaz.sum-rubl   = round(varprice-rubl,2) * tmp#zakaz.qnty
    10330            tmp#zakaz.sum        = round(varprice-rubl,2) * tmp#zakaz.qnty
    10331            tmp#zakaz.sum-base   = round(varprice-base,2) * tmp#zakaz.qnty
    10332            .
    10333       find first shar_ord-line  exclusive-lock   where
    10334           shar_ord-line.doc-code   = loc-ord-num    and
    10335           shar_ord-line.prod-type  = tmp#zakaz.prod-type and
    10336           shar_ord-line.prod-code  = tmp#zakaz.prod-code and
    10337           shar_ord-line.artic      = tmp#zakaz.artic
    10338           no-error  .
    10339       if not available shar_ord-line then
    10340       message
    10341         vss-workfile vss-revision vss-description skip
    10342         error-status :get-message(1) skip
    10343         return-value skip
    10344         "Ошибка!"
    10345         view-as alert-box error
    10346       .
    10347     assign shar_ord-line.price-cli  = round(varprice-cli ,2)
    10348            shar_ord-line.price-rubl = round(varprice-rubl,2)
    10349            shar_ord-line.price-base = round(varprice-base,2)
    10350            shar_ord-line.sum-vat    = if var-report-r-b = "rubl" then round(varprice-vat-rubl ,2 )
    10351                                                                  else round(varprice-vat-base ,2 )
    10352            shar_ord-line.sum-cli    = round(varprice-cli ,2) * shar_ord-line.cli-qnty
    10353            shar_ord-line.sum-rubl   = round(varprice-rubl,2) * shar_ord-line.qnty
    10354            shar_ord-line.sum-base   = round(varprice-base,2) * shar_ord-line.qnty
    10355            shar_ord-line.vat-pc     = tmp#zakaz.vat-pc
    10356            shar_ord-line.slt-pc     = tmp#zakaz.slt-pc
    10357            .
    10358      assign
    10359         loc-sum-rubl  = loc-sum-rubl + shar_ord-line.sum-rubl
    10360         loc-sum-base  = loc-sum-base + shar_ord-line.sum-base
    10361         loc-sum-cli   = loc-sum-cli  + shar_ord-line.sum-cli
    10362      .
    10363     end.
    10364    end.
    10365   end procedure.
    10366   procedure check-rate :
    10367   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10368   define variable flag-recount as logical initial no no-undo.
    10369   if input frame dialog-frame loc-exch-rate  <> loc-exch-rate  or
    10370      input frame dialog-frame loc-exch-scale <> loc-exch-scale or
    10371      input frame dialog-frame loc-base-rate  <> loc-base-rate  or
    10372      input frame dialog-frame loc-base-scale <> loc-base-scale then flag-recount = yes.
    10373   if input frame dialog-frame loc-base-rate = ? or
    10374      input frame dialog-frame loc-base-rate = 0 then do:
    10375     message "Не задан курс базовой валюты.".
    10376     apply "entry" to loc-base-rate in frame dialog-frame.
    10377     return error.
    10378   end.
    10379   if input frame dialog-frame loc-base-scale = ? or
    10380      input frame dialog-frame loc-base-scale = 0 then do:
    10381     message "Не задан масштаб базовой валюты.".
    10382     apply "entry" to loc-base-scale in frame dialog-frame.
    10383     return error.
    10384   end.
    10385   assign  frame dialog-frame
    10386     loc-base-rate
    10387     loc-base-scale.
    10388   if input frame dialog-frame loc-exch-rate = ? or
    10389      input frame dialog-frame loc-exch-rate = 0 then do:
    10390     message "Не задан курс валюты поставщика.".
    10391     apply "entry" to loc-exch-rate in frame dialog-frame.
    10392     return error.
    10393   end.
    10394   if input frame dialog-frame loc-exch-scale = ? or
    10395      input frame dialog-frame loc-exch-scale = 0 then do:
    10396     message "Не задан масштаб валюты поставщика.".
    10397     apply "entry" to loc-exch-scale in frame dialog-frame.
    10398     return error.
    10399   end.
    10400   assign
    10401     loc-exch-rate
    10402     loc-exch-scale.
    10403   run waitfram-show ("ЖДИТЕ.  Пересчет документа ...").
    10404   if flag-recount then do:
    10405      run full-recount.
    10406    display loc-sum-rubl
    10407           loc-sum-base
    10408           loc-sum-cli
    10409           loc-exch-code
    10410           with frame dialog-frame .
    10411     run openbr in this-procedure  .
    10412   end.
    10413   run waitfram-hide.
    10414   end.
    10415   end procedure.
    10416   procedure val-ch-vat-type:
    10417   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10418   define buffer d-l-b    for tmp#zakaz.
    10419   define buffer bf-goods for ub.goods.
    10420   define variable old-vat         like ub.trn-doc.vat-type .
    10421   define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
    10422   define variable v-host-code     like ub.sysconf.host-code  no-undo.
    10423     run check-update no-error.
    10424     if error-status:error then return error.
    10425   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10427     (input  loc-store-type
    10428     ,input  loc-store-code
    10429     ,output v-host-code
    10430     )  .
    10431     assign
    10432       old-vat = vat_type
    10433     .
    10434     assign frame dialog-frame vat_type.
    10435     find first d-l-b no-lock no-error.
    10436     if available d-l-b then do:
    10437        if vat_type = 'без':U and
    10438           old-vat <> 'без':U then do:
    10439           message "НДС в строках устанавливаем в 0" view-as alert-box information.
    10440           for each d-l-b :
    10441               assign d-l-b.vat-pc = 0.
    10442           end.
    10443        end.
    10444        else if vat_type <> 'без':U and
    10445                old-vat  =  'без':U then do:
    10446           message "НДС в строках устанавливаем из товара " view-as alert-box information.
    10447           for each d-l-b ,
    10448                    first bf-goods where bf-goods.artic     = d-l-b.artic and
    10449                                         bf-goods.prod-type = d-l-b.prod-type and
    10450                                         bf-goods.prod-code = d-l-b.prod-code:
    10451   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    10453     (input  bf-goods.gds-code
    10454     ,input  '1':U
    10455     ,input  ?
    10456     ,input  v-host-code
    10457     ,input  loc-store-type
    10458     ,input  loc-store-code
    10459     ,output v-vat-pc
    10460     ) no-error .
    10461               assign d-l-b.vat-pc = v-vat-pc.
    10462           end.
    10463        end.
    10464       end.
    10465       run check-rate no-error.
    10466       if error-status:error then  message      error-status :get-message(1) skip 1 .
    10467       run full-recount no-error.
    10468       if error-status:error then  message      error-status :get-message(1) skip 2 .
    10469    display loc-sum-rubl
    10470           loc-sum-base
    10471           loc-sum-cli
    10472           loc-exch-code
    10473           with frame dialog-frame .
    10474     run openbr in this-procedure  .
    10475     run ui-on.
    10476   end.
    10477   end procedure.
    10478   procedure val-ch-slt-type:
    10479   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10480   define buffer d-l-b    for tmp#zakaz.
    10481   define buffer bf-goods for ub.goods.
