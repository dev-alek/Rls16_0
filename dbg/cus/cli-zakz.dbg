     7724   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7725   on ' ' of doc-date in frame dialog-frame
     7726   do:
     7727     if (can-query (self, "sensitive")
     7728        and
     7729        self :sensitive = true
     7730        )
     7731     or (can-query (self, "read-only")
     7732        and
     7733        self :read-only = false
     7734        )
     7735     then do:
     7736       assign
     7737         self :screen-value = ?
     7738       .
     7739     end.
     7740     return no-apply.
     7741   end.
     7742   on delete-character of doc-date in frame dialog-frame
     7743   do:
     7744     if (can-query (self, "sensitive")
     7745        and
     7746        self :sensitive = true
     7747        )
     7748     or (can-query (self, "read-only")
     7749        and
     7750        self :read-only = false
     7751        )
     7752     then do:
     7753       assign
     7754         self :screen-value = ?
     7755       .
     7756     end.
     7757     return no-apply.
     7758   end.
     7759   on ctrl-d of doc-date in frame dialog-frame
     7760   do:
     7761     define variable v-curr-sv-date as date no-undo .
     7762     if (can-query (self, "sensitive")
     7763        and
     7764        self :sensitive = true
     7765        )
     7766     or (can-query (self, "read-only")
     7767        and
     7768        self :read-only = false
     7769        )
     7770     then do:
     7771       if self :handle <> focus :handle
     7772       then do:
     7773         apply "entry":u to self .
     7774       end.
     7775       run gbl/getcurdt.p
     7776         (output v-curr-sv-date
     7777         ) .
     7778       assign
     7779         self :screen-value = string(v-curr-sv-date) .
     7780       .
     7781     end.
     7782     return no-apply.
     7783   end.
     7784   on ctrl-b of doc-date in frame dialog-frame
     7785   do:
     7786     if (can-query (self, "sensitive")
     7787        and
     7788        self :sensitive = true
     7789        )
     7790     or (can-query (self, "read-only")
     7791        and
     7792        self :read-only = false
     7793        )
     7794     then do:
     7795       if self :handle <> focus :handle
     7796       then do:
     7797         apply "entry":u to self .
     7798       end.
     7799       define variable v-curr-sv-date as date no-undo .
     7800       define variable v-new-sv-date  as date no-undo .
     7801       assign
     7802         v-curr-sv-date = date(self :screen-value) no-error
     7803       .
     7804       if v-curr-sv-date = ?
     7805       then do:
     7806         run gbl/getcurdt.p
     7807           (output v-curr-sv-date
     7808           ) .
     7809       end.
     7810       if v-curr-sv-date <> ?
     7811       then do:
     7812         assign
     7813           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     7814         .
     7815         assign
     7816           self :screen-value = string(v-new-sv-date) .
     7817         .
     7818       end.
     7819     end.
     7820     return no-apply .
     7821   end.
     7822   on ctrl-e of doc-date in frame dialog-frame
     7823   do:
     7824     if (can-query (self, "sensitive")
     7825        and
     7826        self :sensitive = true
     7827        )
     7828     or (can-query (self, "read-only")
     7829        and
     7830        self :read-only = false
     7831        )
     7832     then do:
     7833       if self :handle <> focus :handle
     7834       then do:
     7835         apply "entry":u to self .
     7836       end.
     7837       define variable v-curr-sv-date as date no-undo .
     7838       define variable v-new-sv-date  as date no-undo .
     7839       assign
     7840         v-curr-sv-date = date(self :screen-value) no-error
     7841       .
     7842       if v-curr-sv-date = ?
     7843       then do:
     7844         run gbl/getcurdt.p
     7845           (output v-curr-sv-date
     7846           ) .
     7847       end.
     7848       if v-curr-sv-date <> ?
     7849       then do:
     7850         run gbl/lastdate.p
     7851           (input  v-curr-sv-date
     7852           ,output v-new-sv-date
     7853           ).
     7854         assign
     7855           self :screen-value = string(v-new-sv-date) .
     7856         .
     7857       end.
     7858     end.
     7859     return no-apply .
     7860   end.
     7861   on ctrl-f of doc-date in frame dialog-frame
     7862   do:
     7863     if (can-query (self, "sensitive")
     7864        and
     7865        self :sensitive = true
     7866        )
     7867     or (can-query (self, "read-only")
     7868        and
     7869        self :read-only = false
     7870        )
     7871     then do:
     7872       if self :handle <> focus :handle
     7873       then do:
     7874         apply "entry":u to self .
     7875       end.
     7876       define variable v-ok            as logical   no-undo .
     7877       define variable v-curr-sv-date  as date      no-undo .
     7878       define variable v-description   as character no-undo .
     7879       assign
     7880         v-curr-sv-date = date(self :screen-value) no-error
     7881       .
     7882       if v-curr-sv-date = ?
     7883       then do:
     7884         run gbl/getcurdt.p
     7885           (output v-curr-sv-date
     7886           ) .
     7887       end.
     7888       if v-curr-sv-date <> ?
     7889       then do:
     7890         run gbl/d-inpday.w
     7891           (input ?
     7892           ,input "Выбор даты"
     7893           ,input v-description
     7894           ,input ""
     7895           ,input-output v-curr-sv-date
     7896           ,output v-ok
     7897           ).
     7898         if v-ok = true
     7899         then do:
     7900           assign
     7901             self :screen-value = string(v-curr-sv-date) .
     7902           .
     7903         end.
     7904       end.
     7905     end.
     7906     return no-apply .
     7907   end.
