     5554   ON return OF loc-code IN FRAME dialog-frame do:
     5555     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     5556     return no-apply.
     5557   end.
     5558   ON return, Ctrl-J OF loc-name IN FRAME dialog-frame do:
