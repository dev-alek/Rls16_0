     5383   on choose of menu-item m_del2
     5384   do:
     5385     run del-2 in this-procedure .
     5386   end.
     5387   on choose of menu-item m_spec1
     5388   do:
     5389     run spec1 in this-procedure .
     5390   end.
     5391   on choose of menu-item m_spec2
     5392   do:
     5393     run spec2 in this-procedure .
     5394   end.
     5395   on choose of menu-item m_del4
     5396   do:
     5397   run proc-del4 in this-procedure no-error .
     5398    if error-status :error then return no-apply.
     5399   end.
     5400   on choose of menu-item m_del1
     5401   do:
     5402      run proc-menu-item-m_del1.
     5403   end.
     5404   on choose of b-notes in frame dialog-frame
     5405   do:
     5406    run proc-d-notes in this-procedure .
     5407   end.
     5408   ON CHOOSE OF b-uf IN FRAME dialog-frame
     5409   DO:
     5410     run gbl/vi-coll.w ( input Parparentproc, input this-procedure , input 'cli-zakz-p':U + g#type , input  head-col ) .
     5411   END.
     5412   on choose of b-remove in frame dialog-frame
     5413   do:
     5414   run proc-b-remove.
     5415   end.
     5416   on choose of b-itogs in frame dialog-frame
     5417   do:
     5418    run p-b-itogs in this-procedure no-error .
     5419   end.
     5420   on choose of b-main-calc in frame dialog-frame
     5421   do:
     5422    assign frame  dialog-frame cycle-day loc-date-ship loc-service date-sale-1 date-sale-2 loc-cli-out-doc doc-date .
     5423    run ver-date  in this-procedure .
     5424    if return-value <> "" then return.
     5425    if LOC-DATE-SHIP < to-day then do:
     5426         message "Дата доставки меньше текущей !!! "
     5427         view-as alert-box information .
     5428         return  .
     5429     end.
     5430      find first tmp#zakaz no-error  .
     5431        if avail tmp#zakaz then do:
     5432        if e-method <> "" then do:
     5433          message  "Заказ уже был рассчитан ! Вы хотите повторно пересчитать заказ ? "
     5434          view-as alert-box question buttons ok-cancel update g#log.
     5435              if not g#log then return no-apply.
     5436        end.
     5437        run cus/ord-m.w ( input PARPARENTPROC , input ? , input g#type ) .
     5438        run openbr in this-procedure .
     5439        enable  e-method with frame dialog-frame .
     5440        display e-method with frame dialog-frame .
     5441        end.
     5442   end.
     5443   on end-error, stop of frame dialog-frame  do:
     5444     apply "choose" to b-exit in frame dialog-frame .
     5445     return no-apply.
     5446   end.
     5447   on choose of b-exit in frame dialog-frame
     5448   do:
     5449     t-ret =  session:set-wait-state("general") .
     5450     run proc-b-exit no-error .
     5451     if error-status :error then do:
     5452        t-ret =  session:set-wait-state("") .
     5453        if return-value = "no-calc"  then do:
     5454           message "Заказ не был рассчитан !!! Вернитесь в режим расчета." view-as alert-box information .
     5455           apply "choose" to b-main-calc in frame dialog-frame .
     5456           return no-apply .
     5457        end.
     5458        else do:
     5459          return no-apply .
     5460        end.
     5461     end.
     5462     else do:
     5463         t-ret =  session:set-wait-state("") .
     5464         apply "window-close" to self.
     5465         return .
     5466     end.
     5467   end.
     5468   on value-changed of t-auto in frame dialog-frame
     5469   do:
     5470     assign t-auto.
     5471     if t-auto then apply "choose":u to b-main-calc .
     5472   end.
     5473   on choose of menu-item m_way1
     5474   do:
     5475     run choose-menu-way1 in this-procedure.
     5476   end.
     5477   on choose of menu-item m_way2
     5478   do:
     5479     run choose-menu-way2 in this-procedure.
     5480   end.
     5481   on choose of menu-item m_way3
     5482   do:
     5483     run choose-menu-way3 in this-procedure.
     5484   end.
     5485   on choose of menu-item m_way4
     5486   do:
     5487     run choose-menu-way4 in this-procedure.
     5488   end.
     5489   on window-close of frame dialog-frame
     5490   do:
     5491     apply "end-error":u to self.
     5492     return .
     5493   end.
     5494   on row-leave of br-docs in frame dialog-frame
     5495   do:
     5496      run row-leave-br-doc.
     5497   end.
     5498   ON ROW-DISPLAY OF BR-DOCS  in frame dialog-frame
     5499   DO:
     5500      run  row-display-br-doc.
     5501   end.
     5502   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5503   define variable varscales-pref54 as character no-undo .
     5504   define variable varpgscales-pref54 as character no-undo.
     5505   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5506   define variable varscales-pref-type55 as character no-undo.
     5507   varscales-pref54  = ?.
     5508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5509     (input  'sclspref':u
     5510     ,input  '':u
