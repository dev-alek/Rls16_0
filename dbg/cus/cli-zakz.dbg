     5562   PROCEDURE proc-valchg-a-n-c:
     5563     case input frame dialog-frame a-n-c :
     5564       when "art" then do:
     5565         apply "entry" to br-docs in frame dialog-frame.
     5566         hide loc-name loc-code
     5567         in frame dialog-frame.
     5568         loc-art = "".
     5569       end.
     5570       when "name" then do:
     5571         enable loc-name with frame dialog-frame.
     5572         disp loc-name with frame dialog-frame.
     5573         hide loc-art loc-code
     5574         in frame dialog-frame.
     5575         apply "entry" to loc-name in frame dialog-frame.
     5576       end.
     5577       when "code"
     5578    or when "DataMatrix" then
     5579       do:
     5580         enable loc-code with frame dialog-frame.
     5581         disp loc-code with frame dialog-frame.
     5582         hide loc-art loc-name
     5583         in frame dialog-frame.
     5584         apply "entry" to loc-code in frame dialog-frame.
     5585       end.
     5586     end CASE.
     5587   END PROCEDURE.
     5588   PROCEDURE proc-any-printable-br-docs :
     5589     if input frame dialog-frame a-n-c = "art" then do:
     5590       if last-event:label = " " and
     5591          loc-art = "" then
     5592       return error.
     5593       find first l-shar_ord-line where
     5594                  l-shar_ord-line.doc-code = loc-ord-num and l-shar_ord-line.artic begins (loc-art + last-event:label)
     5595                  no-lock no-error.
     5596       if available l-shar_ord-line then do:
     5597         loc-art = loc-art + last-event:label.
     5598         disp loc-art with frame dialog-frame.
     5599         line-rec = recid (l-shar_ord-line).
     5600         reposition br-docs to recid line-rec no-error.
     5601       end.
     5602     end.
     5603   END PROCEDURE.
     5604   PROCEDURE proc-backspace-br-docs:
     5605     if input frame dialog-frame a-n-c = "art" then do:
     5606       if loc-art = "" then
     5607         return error.
     5608       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     5609       find first l-shar_ord-line where
     5610                  l-shar_ord-line.doc-code = loc-ord-num and l-shar_ord-line.artic begins loc-art
     5611                  no-lock.
     5612       disp loc-art with frame dialog-frame.
     5613       line-rec = recid (l-shar_ord-line).
     5614       reposition br-docs to recid line-rec no-error.
     5615     end.
     5616   END PROCEDURE.
     5617   PROCEDURE proc-mouse-dbl-click-loc-code:
     5618   def var str-code as integer no-undo.
     5619   define variable varresult   as character         no-undo.
     5620   define variable vartype-bc  as character         no-undo.
     5621   define variable varweight   as decimal           no-undo.
     5622   define buffer l-goods for ub.goods.
     5623   define buffer l-bar-code for ub.bar-code.
     5624   define buffer buf_bar-code for ub.bar-code .
     5625   define buffer buf_prod-bc for ub.prod-bc.
     5626   define buffer buf_place for ub.place.
     5627     assign
     5628     frame dialog-frame
     5629     loc-code
     5630     a-n-c.
     5631     if a-n-c = "datamatrix"
     5632     then do:
     5633   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     5634   (
     5635    input  parparentproc
     5636   ,input  loc-code
     5637   ,input  ?
     5638   ,input  store-type
     5639   ,input  store-code
     5640   ,input  yes
     5641   ,input  no
     5642   ,input  varscales-pref54
     5643   ,input  varpgscales-pref54
     5644   ,output varresult
     5645   ,output vartype-bc
     5646   ,output varweight
     5647   ,buffer buf_bar-code
     5648   ,buffer buf_prod-bc
     5649   ,buffer buf_place
     5650   ) no-error.
     5651        if varresult eq "prod-bc"
     5652        then
     5653           loc-code:screen-value in frame dialog-frame = buf_prod-bc.b-str.
     5654     end.
     5655     else do:
     5656   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     5657   (
     5658    input  parparentproc
     5659   ,input  loc-code
     5660   ,input  ?
     5661   ,input  store-type
     5662   ,input  store-code
     5663   ,input  yes
     5664   ,input  no
     5665   ,input  varscales-pref54
     5666   ,input  varpgscales-pref54
     5667   ,output varresult
     5668   ,output vartype-bc
     5669   ,output varweight
     5670   ,buffer buf_bar-code
     5671   ,buffer buf_prod-bc
     5672   ,buffer buf_place
     5673   ) no-error.
     5674   end.
     5675     if available buf_bar-code then do:
     5676           find first l-goods where
     5677                     l-goods.gds-code =
     5678     buf_bar-code.gds-code No-LOCK.
     5679           find first l-shar_ord-line where l-shar_ord-line.doc-code = loc-ord-num and
     5680                     l-shar_ord-line.artic = l-goods.artic AND
     5681                     l-shar_ord-line.prod-type = l-goods.prod-type AND
     5682                     l-shar_ord-line.prod-code = l-goods.prod-code no-lock no-error.
     5683       if available l-shar_ord-line then do:
     5684         line-rec = recid (l-shar_ord-line).
     5685         reposition br-docs to recid line-rec no-error.
     5686       end.
     5687       else do:
     5688         message "Строка не найдена."
     5689                 view-as alert-box error.
     5690       end.
     5691     end.
     5692     else
     5693       message "Бар-код не найден."
     5694               view-as alert-box error.
     5695     apply "entry" to loc-code in frame dialog-frame.
     5696   END PROCEDURE.
     5697   PROCEDURE  proc-mouse-dbl-click-loc-name:
     5698     assign
     5699     frame dialog-frame
     5700     loc-name.
     5701       if last-event:label = "Ctrl-J" then
     5702         find next l-shar_ord-line where l-shar_ord-line.doc-code = loc-ord-num and
     5703                   can-find (ub.goods where ub.goods.artic = l-shar_ord-line.artic and
     5704                   ub.goods.prod-type = l-shar_ord-line.prod-type and
     5705                   ub.goods.prod-code = l-shar_ord-line.prod-code and
     5706                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     5707       else
     5708         find first l-shar_ord-line where l-shar_ord-line.doc-code = loc-ord-num and
     5709                   can-find (ub.goods where ub.goods.artic = l-shar_ord-line.artic and
     5710                   ub.goods.prod-type = l-shar_ord-line.prod-type and
     5711                   ub.goods.prod-code = l-shar_ord-line.prod-code and
     5712                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     5713       if available l-shar_ord-line then do:
     5714         line-rec = recid (l-shar_ord-line).
     5715         reposition br-docs to recid line-rec no-error.
     5716       end.
     5717       else do:
     5718         message "Строка не найдена."
     5719                 view-as alert-box error.
     5720       end.
     5721     apply "entry" to loc-name in frame dialog-frame.
     5722   END PROCEDURE.
     5723   on value-changed of br-docs in frame dialog-frame do:
     5724   if not available shar_ord-line or recid (shar_ord-line) <> line-rec then do:
     5725       hide loc-art in frame dialog-frame.
     5726       loc-art = "".
     5727   end.
     5728   end.
     5729   on value-changed of br-docs in frame dialog-frame
     5730   do:
     5731      run select-good-scala .
     5732   end.
     5733   ON LEAVE OF date-sale-2 IN FRAME dialog-frame
