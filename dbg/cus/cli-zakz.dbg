     5292    end.
     5293   on choose of b-del in frame dialog-frame
     5294   do:
     5295      find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     5296      if available shar_ord-doc
     5297      and (( is-edoc-nn and ( shar_ord-doc.ord-int1 = integer('3':U)   or shar_ord-doc.ord-int1 = integer('4':U)))
     5298       or  ( is-edi     and ( shar_ord-doc.ord-int1 = integer('3':U) or shar_ord-doc.ord-int1 = integer('5':U))))
     5299       then do:
     5300          message "Заказ по системе EDOC/EDI не должен корректироватся в этом статусе. Только НОВЫЙ желтый! " view-as alert-box information .
     5301          return .
     5302       end.
     5303       if choice = ? then do:
     5304         run gbl/pop-up.p (self:handle, no) no-error.
     5305         if error-status:error then return no-apply.
     5306      end.
     5307   end.
     5308   on choose of b-chg in frame dialog-frame
     5309   or mouse-select-dblclick of br-docs in frame dialog-frame
     5310   do:
     5311    run proc_ch_b-chg.
     5312   end.
     5313   on choose of b-add in frame dialog-frame
     5314   do:
     5315      find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     5316      if available shar_ord-doc
     5317      and (( is-edoc-nn and ( shar_ord-doc.ord-int1 = integer('3':U) or shar_ord-doc.ord-int1 = integer('4':U)))
     5318       or  ( is-edi     and   shar_ord-doc.ord-int1 = integer('3':U)))
     5319       then do:
     5320          message "Заказ по системе EDOC/EDI не должен корректироватся в этом статусе. Только НОВЫЙ желтый! " view-as alert-box information .
     5321          return .
     5322       end.
     5323      line-mode = 'ДОБАВЛЕНИЕ':U.
     5324      assign frame dialog-frame loc-date-ship date-sale-1 date-sale-2 loc-service doc-date .
     5325      run choose-menu-add2 in this-procedure.
     5326   end.
     5327   on choose of b-spec in frame dialog-frame
