     3319   procedure ver-clients-calc :
     3320   define input  parameter p-cli-type as character no-undo .
     3321   define input  parameter p-cli-code as integer   no-undo .
     3322   define input  parameter p-obj-type as character no-undo .
     3323   define input  parameter p-obj-code as integer   no-undo .
     3324   define input  parameter p-method   as character no-undo .
     3325   define output parameter p-error    as logical   no-undo .
     3326   define variable v-not-corr-op as character no-undo .
     3327   define variable v-type as character no-undo .
     3328     do
     3329     on error undo, return error return-value
     3330     :
     3331    p-error = false .
     3332    v-not-corr-op  = 'no' .
     3333    run clntattr-value (
     3334       input   p-obj-type
     3335     , input   p-obj-code
     3336     , input   'not-corr-op':U
     3337     , output  v-not-corr-op
     3338     , output  v-type
     3339     ) no-error .
     3340     if error-status :error then v-not-corr-op  = 'no' .
     3341     if v-not-corr-op = 'yes' and  p-method = ""  then do:
     3342       assign v-not-corr-op = 'no' .
     3343       run clntattr-value (
     3344       input   p-cli-type
     3345     , input   p-cli-code
     3346     , input   'not-corr-op':U
     3347     , output  v-not-corr-op
     3348     , output  v-type
     3349     ) no-error .
     3350     if error-status :error then v-not-corr-op  = 'no' .
     3351     if v-not-corr-op = 'yes'  and  p-method = ""  then p-error = true .
     3352     end.
     3353     end.
     3354   end procedure.
