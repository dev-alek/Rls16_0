     5768   end.
     5769   if valid-handle(active-window) and frame dialog-frame:parent eq ?
     5770   then frame dialog-frame:parent = active-window.
     5771   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5772   on help of frame dialog-frame
     5773   do:
     5774     run gbl/app_help.p
     5775       (input this-procedure :file-name
     5776       ,input ''
     5777       ,input ?
     5778       ) no-error.
     5779     if error-status :error then do:
     5780       message
     5781         "Ошибка при вызове помощи"
     5782         error-status :get-message(1)
     5783         view-as alert-box .
     5784     end.
     5785   end.
     5786   run minbtn-set in this-procedure .
     5787   on choose of b-help in frame dialog-frame
     5788   do:
     5789     apply "help":u to frame dialog-frame .
     5790   end.
     5791   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5792   procedure minbtn-set :
     5793       do
     5794           on error undo, return error return-value
     5795           :
     5796           define variable ii              as integer       no-undo .
     5797           define variable fh              as widget-handle no-undo .
     5798           define variable hh              as widget-handle no-undo .
     5799           define variable v-h             as handle        extent 4 no-undo .
     5800           define variable v-name-button   as character     no-undo .
     5801           define variable v-help-old-x    as decimal       no-undo .
     5802           define variable v-help-old-y    as decimal       no-undo .
     5803           define variable v-help-old-size as decimal       no-undo .
     5804           define variable v-frame-width   as decimal       no-undo .
     5805           define variable jj              as integer       no-undo .
     5806           do
     5807               on error undo, return error
     5808               :
     5809               assign
     5810                   v-frame-width = frame dialog-frame:width - 0.3
     5811                   fh            = frame dialog-frame:first-child
     5812                   hh            = fh:first-child
     5813                   ii            = 1
     5814                   .
     5815               do while valid-handle(hh):
     5816                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5817                   do:
     5818                       case lc(hh:name) :
     5819                           when "b-help" then
     5820                               do:
     5821                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5822                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5823                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5824                                   hh:TOOLTIP = "Помощь" .
     5825                                   v-help-old-x = hh:column .
     5826                                   v-help-old-y = hh:row    .
     5827                                   v-help-old-size = hh:width .
     5828                                   hh:width-chars = 2.5 .
     5829                               end.
     5830                           when "b-print" then
     5831                               do:
     5832                                   hh:load-image("cmp/b-print.bmp":u) .
     5833                                   hh:TOOLTIP = "Печать" .
     5834                                   v-h[ii] = hh:handle .
     5835                                   ii = ii + 1 .
     5836                                   hh:width-chars = 3 .
     5837                               end.
     5838                           when "b-history" or
     5839                           when "b-hist" then
     5840                               do:
     5841                                   hh:load-image("cmp/b-hist.bmp":u) .
     5842                                   hh:TOOLTIP = "История" .
     5843                                   v-h[ii] = hh:handle .
     5844                                   ii = ii + 1 .
     5845                                   hh:width-chars = 3 .
     5846                               end.
     5847                           when "b-sch" then
     5848                               do:
     5849                                   hh:load-image("cmp/b-sch.bmp":u) .
     5850                                   hh:TOOLTIP = "Установка Фильтра" .
     5851                                   v-h[ii] = hh:handle .
     5852                                   ii = ii + 1 .
     5853                                   hh:width-chars = 3 .
     5854                               end.
     5855                           when "b-hist-user" then
     5856                               do:
     5857                                   hh:load-image("cmp/b-hist.bmp":u) .
     5858                                   hh:TOOLTIP = "История пользователя" .
     5859                                   ii = ii + 1 .
     5860                               end.
     5861                       end case.
     5862                   end.
     5863                   hh = hh:next-sibling.
     5864               end.
     5865               b-help:column = v-frame-width - b-help:width-chars.
     5866               jj = 0.
     5867               repeat ii = 4 to 1 by -1 :
     5868                   if valid-handle (v-h[ii] ) then
     5869                   do:
     5870                       jj  = jj + 1 .
     5871                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5872                       v-h[ii]:row    = v-help-old-y .
     5873                   end.
     5874               end.
     5875           end.
     5876       end.
     5877   end procedure.
     5878   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5879   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5880   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5881   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5882   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5883   define variable v-diasize-current-frame-height as decimal   no-undo .
     5884   define variable v-diasize-change-size          as logical   no-undo .
     5885   define variable v-diasize-resize-button        as handle    no-undo .
     5886   define variable v-diasize-wndmax               as logical   no-undo .
     5887   define variable v-diasize-wndstore             as logical   no-undo .
     5888   define variable v-diasize-proc-name            as character no-undo .
     5889   define variable v-diasize-browse-handle        as handle    no-undo .
     5890   define variable v-diasize-browse-number        as integer   no-undo .
     5891   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5892   define temp-table temp-diasize-handle no-undo
     5893     field handle-value  as handle
     5894     field save-position as decimal
     5895     index xpk is primary unique handle-value
     5896     .
     5897   define temp-table temp-browse-handle no-undo
     5898     field browse-type   as character
     5899     field browse-number as integer
     5900     field browse-handle as handle
     5901     field original-size as decimal
     5902     index xpk is primary unique browse-type browse-number
     5903     index xie browse-type browse-handle
     5904   .
     5905   procedure diasize_change-height :
     5906     define input  parameter p-change-value  as decimal   no-undo .
     5907     define input  parameter p-move-resize   as logical   no-undo .
     5908     define variable v-field-group-handle    as handle    no-undo .
     5909     define variable v-object-handle         as handle    no-undo .
     5910     define variable v-frame-height          as decimal   no-undo .
     5911     define variable v-frame-virtual-height  as decimal   no-undo .
     5912     define variable v-browse-height         as decimal   no-undo .
     5913     define variable v-window-height         as decimal   no-undo .
     5914     define variable v-window-virtual-height as decimal   no-undo .
     5915     define variable v-change-sign           as integer   no-undo .
     5916     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5917     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5918     if p-change-value > 0
     5919     then do:
     5920       if frame dialog-frame :height + p-change-value
     5921           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5922       then do:
     5923         assign
     5924           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5925                           - (frame dialog-frame :height-chars)
     5926         .
     5927         if p-change-value <= 0
     5928         then do:
     5929           run diasize_position-resize-button in this-procedure .
     5930           return .
     5931         end.
     5932       end.
     5933     end.
     5934     if p-change-value < 0
     5935     then do:
     5936       if frame dialog-frame :height + p-change-value < v-diasize-orig-frame-height
     5937       then do:
     5938         assign
     5939           p-change-value = v-diasize-orig-frame-height
     5940                          - (frame dialog-frame :height-chars)
     5941         .
     5942         if p-change-value >= 0
     5943         then do:
     5944           run diasize_position-resize-button in this-procedure .
     5945           return .
     5946         end.
     5947       end.
     5948     end.
     5949     if p-change-value >= 0
     5950     then do:
     5951       assign
     5952         v-change-sign = 1
     5953       .
     5954     end.
     5955     else do:
     5956       assign
     5957         v-change-sign = -1
     5958       .
     5959     end.
     5960     assign
     5961       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5962     .
     5963     if p-change-value = 0
     5964     then do:
     5965       run diasize_position-resize-button in this-procedure .
     5966       return .
     5967     end.
     5968     move_block:
     5969     do
     5970     on error undo move_block, retry move_block
     5971     :
     5972       if retry
     5973       then do:
     5974         do
     5975         on error undo move_block, leave move_block
     5976         :
     5977           if p-change-value > 0
     5978           then do:
     5979             for each buf_temp-diasize-handle
     5980             on error undo, next
     5981             :
     5982               assign
     5983                 v-object-handle = buf_temp-diasize-handle.handle-value
     5984               .
     5985               if v-object-handle <> v-diasize-resize-button
     5986               then do:
     5987                 assign
     5988                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5989                 .
     5990               end.
     5991             end.
     5992             assign
     5993               v-diasize-browse-handle :height = v-browse-height
     5994             .
     5995             for each buf_temp-browse-handle
     5996               where buf_temp-browse-handle.browse-type = 'height':u
     5997             on error undo, next
     5998             :
     5999               assign
     6000                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6001               .
     6002             end.
     6003             assign
     6004               frame dialog-frame :height = v-frame-height
     6005             .
     6006             if frame dialog-frame :scrollable = true
     6007             then do:
     6008               assign
     6009                 frame dialog-frame :virtual-height = v-frame-virtual-height
     6010               .
     6011             end.
     6012             run diasize_position-resize-button in this-procedure .
     6013           end.
     6014           else do:
     6015             if frame dialog-frame :scrollable = true
     6016             then do:
     6017               assign
     6018                 frame dialog-frame :virtual-height = v-frame-virtual-height
     6019               .
     6020             end.
     6021             assign
     6022               frame dialog-frame :height = v-frame-height
     6023             .
     6024             assign
     6025               v-diasize-browse-handle :height = v-browse-height
     6026             .
     6027             for each buf_temp-browse-handle
     6028               where buf_temp-browse-handle.browse-type = 'height':u
     6029             on error undo, next
     6030             :
     6031               assign
     6032                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6033               .
     6034             end.
     6035             for each buf_temp-diasize-handle
     6036             on error undo, next
     6037             :
     6038               assign
     6039                 v-object-handle = buf_temp-diasize-handle.handle-value
     6040               .
     6041               if v-object-handle <> v-diasize-resize-button
     6042               then do:
     6043                 assign
     6044                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6045                 .
     6046               end.
     6047             end.
     6048             run diasize_position-resize-button in this-procedure .
     6049           end.
     6050           assign
     6051             v-diasize-change-size = false
     6052           .
     6053           leave move_block .
     6054         end.
     6055       end.
     6056       assign
     6057         v-diasize-need-full-display = true
     6058       .
     6059       if v-diasize-change-size = false
     6060       then do:
     6061         assign
     6062           v-diasize-change-size = true
     6063         .
     6064       end.
     6065       else do:
     6066         return .
     6067       end.
     6068       assign
     6069         v-frame-height = frame dialog-frame :height
     6070         v-frame-virtual-height = frame dialog-frame :virtual-height
     6071         v-browse-height = v-diasize-browse-handle :height
     6072       .
     6073       for each buf_temp-browse-handle
     6074         where buf_temp-browse-handle.browse-type = 'height':u
     6075       :
     6076         assign
     6077           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6078         .
     6079       end.
     6080       for each buf_temp-diasize-handle
     6081       :
     6082         delete buf_temp-diasize-handle .
     6083       end.
     6084       assign
     6085         v-field-group-handle = frame dialog-frame :first-child
     6086       .
     6087       do while valid-handle(v-field-group-handle)
     6088       :
     6089         assign
     6090           v-object-handle = v-field-group-handle :first-child
     6091         .
     6092         do while valid-handle(v-object-handle)
     6093         :
     6094           if  v-object-handle <> v-diasize-browse-handle :handle
     6095           and can-query(v-object-handle, "row")
     6096           and can-query(v-object-handle, "height")
     6097           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6098           then do:
     6099             find first buf_temp-browse-handle
     6100               where buf_temp-browse-handle.browse-type   = 'height':u
     6101                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6102               no-error .
     6103             if available buf_temp-browse-handle
     6104             then do:
     6105             end.
     6106             else do:
     6107               create buf_temp-diasize-handle .
     6108               assign
     6109                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6110                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6111               .
     6112             end.
     6113           end.
     6114           assign
     6115             v-object-handle = v-object-handle :next-sibling
     6116           .
     6117         end.
     6118         assign
     6119           v-field-group-handle = v-field-group-handle :next-sibling
     6120         .
     6121       end.
     6122       do with frame dialog-frame
     6123       :
     6124         hide v-diasize-resize-button .
     6125         assign
     6126           v-diasize-resize-button :row    = 1
     6127           v-diasize-resize-button :column = 1
     6128         .
     6129       end.
     6130       if p-change-value > 0
     6131       then do:
     6132         if frame dialog-frame :scrollable = true
     6133         then do:
     6134           assign
     6135             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     6136             no-error .
     6137           if error-status :error
     6138           or error-status :get-message(1) <> ""
     6139           then do:
     6140             undo move_block, retry move_block .
     6141           end.
     6142         end.
     6143         assign
     6144           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     6145           no-error .
     6146         if error-status :error
     6147         or error-status :get-message(1) <> ""
     6148         then do:
     6149           undo move_block, retry move_block .
     6150         end.
     6151         assign
     6152           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6153           no-error .
     6154         if error-status :error
     6155         or error-status :get-message(1) <> ""
     6156         then do:
     6157           undo move_block, retry move_block .
     6158         end.
     6159         for each buf_temp-browse-handle
     6160           where buf_temp-browse-handle.browse-type = 'height':u
     6161         on error undo move_block, retry move_block
     6162         :
     6163           assign
     6164             buf_temp-browse-handle.browse-handle :height
     6165               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6166             no-error .
     6167           if error-status :error
     6168           or error-status :get-message(1) <> ""
     6169           then do:
     6170             undo move_block, retry move_block .
     6171           end.
     6172         end.
     6173         for each buf_temp-diasize-handle
     6174         on error undo move_block, retry move_block
     6175         :
     6176           assign
     6177             v-object-handle = buf_temp-diasize-handle.handle-value
     6178           .
     6179           if v-object-handle <> v-diasize-resize-button
     6180           then do:
     6181             assign
     6182               v-object-handle :row = v-object-handle :row + p-change-value
     6183               no-error .
     6184             if error-status :error
     6185             or error-status :get-message(1) <> ""
     6186             then do:
     6187               undo move_block, retry move_block .
     6188             end.
     6189           end.
     6190         end.
     6191       end.
     6192       else do:
     6193         for each buf_temp-diasize-handle
     6194         on error undo move_block, retry move_block
     6195         :
     6196           assign
     6197             v-object-handle = buf_temp-diasize-handle.handle-value
     6198           .
     6199           if v-object-handle <> v-diasize-resize-button
     6200           then do:
     6201             assign
     6202               v-object-handle :row = v-object-handle :row + p-change-value
     6203               no-error .
     6204             if error-status :error
     6205             or error-status :get-message(1) <> ""
     6206             then do:
     6207               undo move_block, retry move_block .
     6208             end.
     6209           end.
     6210         end.
     6211         assign
     6212           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6213           no-error .
     6214         if error-status :error
     6215         or error-status :get-message(1) <> ""
     6216         then do:
     6217           undo move_block, retry move_block .
     6218         end.
     6219         for each buf_temp-browse-handle
     6220           where buf_temp-browse-handle.browse-type = 'height':u
     6221         on error undo move_block, retry move_block
     6222         :
     6223           assign
     6224             buf_temp-browse-handle.browse-handle :height
     6225               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6226             no-error .
     6227           if error-status :error
     6228           or error-status :get-message(1) <> ""
     6229           then do:
     6230             undo move_block, retry move_block .
     6231           end.
     6232         end.
     6233         assign
     6234           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     6235           no-error .
     6236         if error-status :error
     6237         or error-status :get-message(1) <> ""
     6238         then do:
     6239           undo move_block, retry move_block .
     6240         end.
     6241         if frame dialog-frame :scrollable = true
     6242         then do:
     6243           assign
     6244             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     6245             no-error .
     6246           if error-status :error
     6247           or error-status :get-message(1) <> ""
     6248           then do:
     6249             undo move_block, retry move_block .
     6250           end.
     6251         end.
     6252       end.
     6253       if p-move-resize = true
     6254       then do:
     6255         run diasize_position-resize-button in this-procedure .
     6256       end.
     6257       if v-diasize-wndstore = true
     6258       then do:
     6259         if connected("ub") = true
     6260         then do:
     6261           define variable v-cntxt-db-num        as integer   no-undo .
     6262           define variable v-cntxt-userid        as character no-undo .
     6263           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6264                                             , OUTPUT v-cntxt-userid
     6265                                             ) .
     6266           run gbl/wndsizew.p
     6267             (input  v-cntxt-db-num
     6268             ,input  v-cntxt-userid
     6269             ,input  v-diasize-proc-name
     6270             ,input  'height':u
     6271             ,input  string(frame dialog-frame :height - v-diasize-orig-frame-height)
     6272             ) .
     6273         end.
     6274       end.
     6275     end.
     6276     assign
     6277       v-diasize-change-size = false
     6278     .
     6279   end procedure.
     6280   procedure diasize_set-height :
     6281     define input  parameter p-new-height  as decimal   no-undo .
     6282     define input  parameter p-move-resize as logical   no-undo .
     6283     do
     6284     on error undo, return error return-value
     6285     :
     6286       run diasize_change-height in this-procedure
     6287         (input  (p-new-height - frame dialog-frame :height)
     6288         ,input  p-move-resize
     6289         ) .
     6290     end.
     6291   end procedure.
     6292   procedure diasize_change-width :
     6293     define input  parameter p-change-value as decimal   no-undo .
     6294     define input  parameter p-move-resize  as logical   no-undo .
     6295     define variable v-field-group-handle   as handle    no-undo .
     6296     define variable v-object-handle        as handle    no-undo .
     6297     define variable v-frame-width          as decimal   no-undo .
     6298     define variable v-frame-virtual-width  as decimal   no-undo .
     6299     define variable v-browse-width         as decimal   no-undo .
     6300     define variable v-window-width         as decimal   no-undo .
     6301     define variable v-window-virtual-width as decimal   no-undo .
     6302     define variable v-change-sign          as integer   no-undo .
     6303     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6304     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6305     if p-change-value > 0
     6306     then do:
     6307       if frame dialog-frame :width + p-change-value >
     6308           session :width-chars
     6309       then do:
     6310         assign
     6311           p-change-value = session :width-chars - frame dialog-frame :width
     6312         .
     6313         if p-change-value <= 0
     6314         then do:
     6315           run diasize_position-resize-button in this-procedure .
     6316           return .
     6317         end.
     6318       end.
     6319     end.
     6320     if p-change-value < 0
     6321     then do:
     6322       if frame dialog-frame :width + p-change-value < v-diasize-orig-frame-width
     6323       then do:
     6324         assign
     6325           p-change-value = v-diasize-orig-frame-width
     6326                          - frame dialog-frame :width
     6327         .
     6328         if p-change-value >= 0
     6329         then do:
     6330           run diasize_position-resize-button in this-procedure .
     6331           return .
     6332         end.
     6333       end.
     6334     end.
     6335     if p-change-value >= 0
     6336     then do:
     6337       assign
     6338         v-change-sign = 1
     6339       .
     6340     end.
     6341     else do:
     6342       assign
     6343         v-change-sign = -1
     6344       .
     6345     end.
     6346     assign
     6347       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6348     .
     6349     if p-change-value = 0
     6350     then do:
     6351       run diasize_position-resize-button in this-procedure .
     6352       return .
     6353     end.
     6354     move_block:
     6355     do
     6356     on error undo move_block, leave move_block
     6357     :
     6358       if retry
     6359       then do:
     6360         do
     6361         on error undo move_block, leave move_block
     6362         :
     6363           if p-change-value > 0
     6364           then do:
     6365             for each buf_temp-diasize-handle
     6366             on error undo, next
     6367             :
     6368               assign
     6369                 v-object-handle = buf_temp-diasize-handle.handle-value
     6370               .
     6371               if v-object-handle <> v-diasize-resize-button
     6372               then do:
     6373                 assign
     6374                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6375                 .
     6376               end.
     6377             end.
     6378             assign
     6379               v-diasize-browse-handle :width = v-browse-width
     6380             .
     6381             for each buf_temp-browse-handle
     6382               where buf_temp-browse-handle.browse-type = 'width':u
     6383             on error undo, next
     6384             :
     6385               assign
     6386                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6387               .
     6388             end.
     6389             assign
     6390               frame dialog-frame :width = v-frame-width
     6391             .
     6392             if frame dialog-frame :scrollable = true
     6393             then do:
     6394               assign
     6395                 frame dialog-frame :virtual-width = v-frame-virtual-width
     6396               .
     6397             end.
     6398             run diasize_position-resize-button in this-procedure .
     6399           end.
     6400           else do:
     6401             if frame dialog-frame :scrollable = true
     6402             then do:
     6403               assign
     6404                 frame dialog-frame :virtual-width = v-frame-virtual-width
     6405               .
     6406             end.
     6407             assign
     6408               frame dialog-frame :width = v-frame-width
     6409             .
     6410             for each buf_temp-browse-handle
     6411               where buf_temp-browse-handle.browse-type = 'width':u
     6412             on error undo, next
     6413             :
     6414               assign
     6415                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6416               .
     6417             end.
     6418             assign
     6419               v-diasize-browse-handle :width = v-browse-width
     6420             .
     6421             for each buf_temp-diasize-handle
     6422             on error undo, next
     6423             :
     6424               assign
     6425                 v-object-handle = buf_temp-diasize-handle.handle-value
     6426               .
     6427               if v-object-handle <> v-diasize-resize-button
     6428               then do:
     6429                 assign
     6430                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6431                 .
     6432               end.
     6433             end.
     6434             run diasize_position-resize-button in this-procedure .
     6435           end.
     6436           assign
     6437             v-diasize-change-size = false
     6438           .
     6439           leave move_block .
     6440         end.
     6441       end.
     6442       assign
     6443         v-diasize-need-full-display = true
     6444       .
     6445       if v-diasize-change-size = false
     6446       then do:
     6447         assign
     6448           v-diasize-change-size = true
     6449         .
     6450       end.
     6451       else do:
     6452         return .
     6453       end.
     6454       assign
     6455         v-frame-width = frame dialog-frame :width
     6456         v-frame-virtual-width = frame dialog-frame :virtual-width
     6457         v-browse-width = v-diasize-browse-handle :width
     6458       .
     6459       for each buf_temp-browse-handle
     6460         where buf_temp-browse-handle.browse-type = 'width':u
     6461       :
     6462         assign
     6463           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6464         .
     6465       end.
     6466       for each buf_temp-diasize-handle
     6467       :
     6468         delete buf_temp-diasize-handle .
     6469       end.
     6470       assign
     6471         v-field-group-handle = frame dialog-frame :first-child
     6472       .
     6473       do while valid-handle(v-field-group-handle)
     6474       :
     6475         assign
     6476           v-object-handle = v-field-group-handle :first-child
     6477         .
     6478         do while valid-handle(v-object-handle)
     6479         :
     6480           if  v-object-handle <> v-diasize-browse-handle :handle
     6481           and v-object-handle <> v-diasize-resize-button
     6482           and can-query(v-object-handle, "row")
     6483           and can-query(v-object-handle, "height")
     6484           and ( v-object-handle :col + v-object-handle :width
     6485                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6486               )
     6487           then do:
     6488             find first buf_temp-browse-handle
     6489               where buf_temp-browse-handle.browse-type   = 'width':u
     6490                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6491               no-error .
     6492             if available buf_temp-browse-handle
     6493             then do:
     6494             end.
     6495             else do:
     6496               create buf_temp-diasize-handle .
     6497               assign
     6498                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6499                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6500               .
     6501             end.
     6502           end.
     6503           assign
     6504             v-object-handle = v-object-handle :next-sibling
     6505           .
     6506         end.
     6507         assign
     6508           v-field-group-handle = v-field-group-handle :next-sibling
     6509         .
     6510       end.
     6511       do with frame dialog-frame
     6512       :
     6513         hide v-diasize-resize-button .
     6514         v-diasize-resize-button :row = 1.
     6515         v-diasize-resize-button :column = 1.
     6516       end.
     6517       if p-change-value > 0
     6518       then do:
     6519         if frame dialog-frame :scrollable = true
     6520         then do:
     6521           assign
     6522             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     6523             no-error .
     6524           if error-status :error
     6525           or error-status :get-message(1) <> ""
     6526           then do:
     6527             undo move_block, retry move_block.
     6528           end.
     6529         end.
     6530         assign
     6531           frame dialog-frame :width = v-frame-width + p-change-value
     6532           no-error .
     6533         if error-status :error
     6534         or error-status :get-message(1) <> ""
     6535         then do:
     6536           undo move_block, retry move_block.
     6537         end.
     6538         assign
     6539           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6540         no-error .
     6541         if error-status :error
     6542         or error-status :get-message(1) <> ""
     6543         then do:
     6544           undo move_block, retry move_block.
     6545         end.
     6546         for each buf_temp-browse-handle
     6547           where buf_temp-browse-handle.browse-type = 'width':u
     6548         on error undo move_block, retry move_block
     6549         :
     6550           assign
     6551             buf_temp-browse-handle.browse-handle :width
     6552               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6553             no-error .
     6554           if error-status :error
     6555           or error-status :get-message(1) <> ""
     6556           then do:
     6557             undo move_block, retry move_block .
     6558           end.
     6559         end.
     6560         for each buf_temp-diasize-handle
     6561         on error undo move_block, retry move_block
     6562         :
     6563           assign
     6564             v-object-handle = buf_temp-diasize-handle.handle-value
     6565           .
     6566           if v-object-handle <> v-diasize-resize-button
     6567           then do:
     6568             assign
     6569               v-object-handle :col = v-object-handle :col + p-change-value
     6570               no-error .
     6571             if error-status :error
     6572             or error-status :get-message(1) <> ""
     6573             then do:
     6574               undo move_block, retry move_block .
     6575             end.
     6576           end.
     6577         end.
     6578       end.
     6579       else do:
     6580         for each buf_temp-diasize-handle
     6581         on error undo move_block, retry move_block
     6582         :
     6583           assign
     6584             v-object-handle = buf_temp-diasize-handle.handle-value
     6585           .
     6586           if v-object-handle <> v-diasize-resize-button
     6587           then do:
     6588             assign
     6589               v-object-handle :col = v-object-handle :col + p-change-value
     6590               no-error .
     6591             if error-status :error
     6592             or error-status :get-message(1) <> ""
     6593             then do:
     6594               undo move_block, retry move_block .
     6595             end.
     6596           end.
     6597         end.
     6598         for each buf_temp-browse-handle
     6599           where buf_temp-browse-handle.browse-type = 'width':u
     6600         on error undo move_block, retry move_block
     6601         :
     6602           assign
     6603             buf_temp-browse-handle.browse-handle :width
     6604               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6605             no-error .
     6606           if error-status :error
     6607           or error-status :get-message(1) <> ""
     6608           then do:
     6609             undo move_block, retry move_block .
     6610           end.
     6611         end.
     6612         assign
     6613           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6614           no-error .
     6615         if error-status :error
     6616         or error-status :get-message(1) <> ""
     6617         then do:
     6618           undo move_block, retry move_block.
     6619         end.
     6620         assign
     6621           frame dialog-frame :width = frame dialog-frame :width + p-change-value
     6622         no-error .
     6623         if error-status :error
     6624         or error-status :get-message(1) <> ""
     6625         then do:
     6626           undo move_block, retry move_block.
     6627         end.
     6628         if frame dialog-frame :scrollable = true
     6629         then do:
     6630           assign
     6631             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     6632           no-error .
     6633           if error-status :error
     6634           or error-status :get-message(1) <> ""
     6635           then do:
     6636             undo move_block, retry move_block.
     6637           end.
     6638         end.
     6639       end.
     6640       if p-move-resize
     6641       then do:
     6642         run diasize_position-resize-button in this-procedure .
     6643       end.
     6644       if v-diasize-wndstore = true
     6645       then do:
     6646         if connected("ub") = true
     6647         then do:
     6648           define variable v-cntxt-db-num        as integer   no-undo .
     6649           define variable v-cntxt-userid        as character no-undo .
     6650           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6651                                             , OUTPUT v-cntxt-userid
     6652                                             ) .
     6653           run gbl/wndsizew.p
     6654             (input  v-cntxt-db-num
     6655             ,input  v-cntxt-userid
     6656             ,input  v-diasize-proc-name
     6657             ,input  'width':u
     6658             ,input  string(frame dialog-frame :width - v-diasize-orig-frame-width)
     6659             ) .
     6660         end.
     6661       end.
     6662     end.
     6663     assign
     6664       v-diasize-change-size = false
     6665     .
     6666   end procedure.
     6667   procedure diasize_set-width :
     6668     define input  parameter p-new-width  as decimal   no-undo .
     6669     define input  parameter p-move-resize as logical   no-undo .
     6670     do
     6671     on error undo, return error return-value
     6672     :
     6673       run diasize_change-width in this-procedure
     6674         (input  (p-new-width - frame dialog-frame :width)
     6675         ,input  p-move-resize
     6676         ) .
     6677     end.
     6678   end procedure.
     6679   procedure diasize_position-resize-button :
     6680     do with frame dialog-frame
     6681     :
     6682       hide v-diasize-resize-button .
     6683       assign
     6684         v-diasize-resize-button :row = frame dialog-frame :height - v-diasize-resize-button :height
     6685                     - 1
     6686                     - (frame dialog-frame :border-bottom-pixels / session :pixels-per-row)
     6687         v-diasize-resize-button :col = frame dialog-frame :width - v-diasize-resize-button :width
     6688                     - 1
     6689                     - (frame dialog-frame :border-right-pixels / session :pixels-per-column)
     6690       .
     6691       view v-diasize-resize-button .
     6692     end.
     6693   end procedure.
     6694   on alt-right anywhere
     6695   do:
     6696     run diasize_change-width in this-procedure
     6697       (input 1
     6698       ,input true
     6699       ) .
     6700     return no-apply .
     6701   end.
     6702   on alt-left anywhere
     6703   do:
     6704     run diasize_change-width in this-procedure
     6705       (input -1
     6706       ,input true
     6707       ) .
     6708     return no-apply .
     6709   end.
     6710   on alt-down anywhere
     6711   do:
     6712     run diasize_change-height in this-procedure
     6713       (input 1
     6714       ,input true
     6715       ) .
     6716     return no-apply .
     6717   end.
     6718   on alt-up anywhere
     6719   do:
     6720     run diasize_change-height in this-procedure
     6721       (input -1
     6722       ,input true
     6723       ) .
     6724     return no-apply .
     6725   end.
     6726   on alt-enter of frame dialog-frame
     6727   do:
     6728     run diasize_maximize in this-procedure
     6729       (input  ?
     6730       ).
     6731     return no-apply .
     6732   end.
     6733   procedure diasize_end-move :
     6734     do
     6735     on error undo, return error return-value
     6736     :
     6737       define variable v-row-delta as decimal   no-undo .
     6738       define variable v-col-delta as decimal   no-undo .
     6739       define variable v-new-row as decimal   no-undo .
     6740       define variable v-new-col as decimal   no-undo .
     6741       assign
     6742         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6743         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6744       .
     6745       assign
     6746         v-row-delta = v-new-row - frame dialog-frame :height
     6747         v-col-delta = v-new-col - frame dialog-frame :width
     6748       .
     6749       run diasize_change-height in this-procedure
     6750         (input v-row-delta
     6751         ,input true
     6752         ) .
     6753       run diasize_change-width in this-procedure
     6754         (input v-col-delta
     6755         ,input true
     6756         ) .
     6757     end.
     6758   end procedure.
     6759   procedure diasize_maximize :
     6760     define input  parameter p-action as logical   no-undo .
     6761     do
     6762     on error undo, return error return-value
     6763     :
     6764       if p-action = ?
     6765       then do:
     6766         if v-diasize-need-maximize = true
     6767         then do:
     6768           assign
     6769             p-action = true
     6770           .
     6771         end.
     6772         else do:
     6773           assign
     6774             p-action = false
     6775           .
     6776         end.
     6777       end.
     6778       if p-action = true
     6779       then do:
     6780         run diasize_change-height in this-procedure
     6781           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6782               - frame dialog-frame :height-chars
     6783           ,input true
     6784           ) .
     6785         run diasize_change-width in this-procedure
     6786           (input session :width-chars
     6787               - frame dialog-frame :width-chars
     6788           ,input true
     6789           ) .
     6790         assign
     6791           v-diasize-need-maximize = false
     6792         .
     6793       end.
     6794       else do:
     6795         run diasize_change-width in this-procedure
     6796           (input v-diasize-orig-frame-width
     6797               - frame dialog-frame :width-chars
     6798           ,input true
     6799           ) .
     6800         run diasize_change-height in this-procedure
     6801           (input v-diasize-orig-frame-height
     6802               - frame dialog-frame :height-chars
     6803           ,input true
     6804           ) .
     6805         assign
     6806           v-diasize-need-maximize = true
     6807         .
     6808       end.
     6809     end.
     6810   end procedure.
     6811   procedure diasize_restore-orig-size :
     6812     do
     6813     on error undo, return error return-value
     6814     :
     6815       assign
     6816         v-diasize-current-frame-width  = frame dialog-frame :width
     6817         v-diasize-current-frame-height = frame dialog-frame :height
     6818       .
     6819       run diasize_set-height in this-procedure
     6820         (input  v-diasize-orig-frame-height
     6821         ,input  true
     6822         ) .
     6823       run diasize_set-width in this-procedure
     6824         (input  v-diasize-orig-frame-width
     6825         ,input  true
     6826         ) .
     6827     end.
     6828   end procedure.
     6829   procedure diasize_restore-current-size :
     6830     do
     6831     on error undo, return error return-value
     6832     :
     6833       run diasize_set-height in this-procedure
     6834         (input  v-diasize-current-frame-height
     6835         ,input  true
     6836         ) .
     6837       run diasize_set-width in this-procedure
     6838         (input  v-diasize-current-frame-width
     6839         ,input  true
     6840         ) .
     6841     end.
     6842   end procedure.
     6843   procedure diasize_set-browse-handle :
     6844     define input  parameter p-browse-handle as handle   no-undo .
     6845     define buffer buf_temp-browse-handle for temp-browse-handle .
     6846     do
     6847     on error undo, return error return-value
     6848     :
     6849       assign
     6850         v-diasize-browse-handle = p-browse-handle
     6851       .
     6852       for each buf_temp-browse-handle
     6853       on error undo, return error return-value
     6854       :
     6855         delete buf_temp-browse-handle .
     6856       end.
     6857     end.
     6858   end procedure.
     6859   procedure diasize_add_browse :
     6860     define input  parameter p-browse-type   as character no-undo .
     6861     define input  parameter p-browse-handle as handle    no-undo .
     6862     define buffer buf_temp-browse-handle for temp-browse-handle .
     6863     do
     6864     on error undo, return error return-value
     6865     :
     6866       assign
     6867         v-diasize-browse-number = v-diasize-browse-number + 1
     6868       .
     6869       create buf_temp-browse-handle .
     6870       assign
     6871         buf_temp-browse-handle.browse-type   = p-browse-type
     6872         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6873         buf_temp-browse-handle.browse-handle = p-browse-handle
     6874       .
     6875     end.
     6876   end procedure.
     6877   procedure diasize_init :
     6878     define variable v-default-value    as logical   no-undo .
     6879     define variable v-restore-saved    as logical   no-undo .
     6880     define variable v-resize-value-str as character no-undo .
     6881     do
     6882     on error undo, return error return-value
     6883     :
     6884       do with frame dialog-frame
     6885       :
     6886         assign
     6887           v-diasize-orig-frame-height = frame dialog-frame :height
     6888           v-diasize-orig-frame-width  = frame dialog-frame :width
     6889           v-diasize-browse-handle     = browse br-docs :handle
     6890         .
     6891         create button v-diasize-resize-button
     6892         assign
     6893           parent        = frame dialog-frame :first-child
     6894           label         = "s"
     6895           height-pixels = 16
     6896           width-pixels  = 16
     6897           visible       = true
     6898           sensitive     = true
     6899           movable       = true
     6900           triggers:
     6901             on end-move persistent run diasize_end-move in this-procedure .
     6902           end triggers.
     6903         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6904         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6905         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6906         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6907         assign
     6908           v-diasize-wndmax = false
     6909         .
     6910         if connected("ub") = true
     6911         then do:
     6912           define variable v-cntxt-db-num        as integer   no-undo .
     6913           define variable v-cntxt-userid        as character no-undo .
     6914           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6915                                             , OUTPUT v-cntxt-userid
     6916                                             ) .
     6917           run gbl/wndpar_r.p
     6918             (input  v-cntxt-db-num
     6919             ,input  v-cntxt-userid
     6920             ,input  'wndmax':U
     6921             ,output v-diasize-wndmax
     6922             ,output v-default-value
     6923             ) .
     6924         end.
     6925         assign
     6926           v-diasize-wndstore = false
     6927         .
     6928         if connected("ub") = true
     6929         then do:
     6930           run gbl/wndpar_r.p
     6931             (input  v-cntxt-db-num
     6932             ,input  v-cntxt-userid
     6933             ,input  'wndstore':U
     6934             ,output v-diasize-wndstore
     6935             ,output v-default-value
     6936             ) .
     6937         end.
     6938         assign
     6939           v-diasize-proc-name = entry(1, program-name(2), '.')
     6940         .
     6941         if v-diasize-wndstore = true
     6942         then do:
     6943           assign
     6944             v-restore-saved = false
     6945           .
     6946           if connected("ub") = true
     6947           then do:
     6948             run gbl/wndsizer.p
     6949               (input  v-cntxt-db-num
     6950               ,input  v-cntxt-userid
     6951               ,input  v-diasize-proc-name
     6952               ,input  'height':u
     6953               ,output v-resize-value-str
     6954               ) .
     6955             if v-resize-value-str <> '':U
     6956             then do:
     6957               run diasize_change-height in this-procedure
     6958                 (input  integer(v-resize-value-str)
     6959                 ,input  true
     6960                 ) .
     6961               assign
     6962                 v-restore-saved = true
     6963               .
     6964             end.
     6965           end.
     6966           if connected("ub") = true
     6967           then do:
     6968             run gbl/wndsizer.p
     6969               (input  v-cntxt-db-num
     6970               ,input  v-cntxt-userid
     6971               ,input  v-diasize-proc-name
     6972               ,input  'width':u
     6973               ,output v-resize-value-str
     6974               ) .
     6975             if v-resize-value-str <> '':U
     6976             then do:
     6977               run diasize_change-width in this-procedure
     6978                 (input  integer(v-resize-value-str)
     6979                 ,input  true
     6980                 ) .
     6981               assign
     6982                 v-restore-saved = true
     6983               .
     6984             end.
     6985           end.
     6986           if v-restore-saved <> true
     6987           then do:
     6988             if v-diasize-wndmax = true
     6989             then do:
     6990               run diasize_maximize in this-procedure
     6991                 (input  true
     6992                 ) .
     6993             end.
     6994           end.
     6995         end.
     6996         else do:
     6997           if v-diasize-wndmax = true
     6998           then do:
     6999             run diasize_maximize in this-procedure
     7000               (input  true
     7001               ) .
     7002           end.
     7003         end.
     7004       end.
     7005     end.
     7006   end procedure.
     7007   procedure diasize_need-full-display :
     7008     define output parameter p-need-full-display as logical   no-undo .
     7009     do
     7010     on error undo, return error return-value
     7011     :
     7012       assign
     7013         p-need-full-display = v-diasize-need-full-display
     7014       .
     7015       assign
     7016         v-diasize-need-full-display = false
     7017       .
     7018     end.
     7019   end procedure.
     7020   procedure get-context :
     7021      define output parameter p-db-num as integer          no-undo.
     7022      define output parameter p-user-id as character        no-undo.
     7023      define variable v-login               as character    no-undo.
     7024      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7025      define buffer buf_user-login  for ub.user-login .
     7026      do
     7027      on error undo, return error
     7028      :
     7029            FIND FIRST buf_sys-ctrl no-lock.
     7030            ASSIGN
     7031               v-login = USERID("ub")
     7032               p-db-num = buf_sys-ctrl.db-num
     7033            .
     7034            FIND FIRST buf_user-login
     7035                 WHERE buf_user-login.db-num = p-db-num
     7036                   AND buf_user-login.user-login = v-login
     7037                 no-lock
     7038                 no-error
     7039                 .
     7040            IF AVAILABLE buf_user-login
     7041            THEN DO:
     7042               assign
     7043                  p-user-id = buf_user-login.user-id
     7044               .
     7045            END.
     7046      end.
     7047   end procedure.
     7048       run diasize_init in this-procedure .
     7049   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7050   on f5 of frame dialog-frame anywhere
     7051   do:
     7052     open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code by tmp#zakaz.line-num .
     7053       apply "VALUE-CHANGED" to br-docs.
     7054   end.
     7055   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7056   on ' ' of loc-date-ship in frame dialog-frame
     7057   do:
     7058     if (can-query (self, "sensitive")
     7059        and
     7060        self :sensitive = true
     7061        )
     7062     or (can-query (self, "read-only")
     7063        and
     7064        self :read-only = false
     7065        )
     7066     then do:
     7067       assign
     7068         self :screen-value = ?
     7069       .
     7070     end.
     7071     return no-apply.
     7072   end.
     7073   on delete-character of loc-date-ship in frame dialog-frame
     7074   do:
     7075     if (can-query (self, "sensitive")
     7076        and
     7077        self :sensitive = true
     7078        )
     7079     or (can-query (self, "read-only")
     7080        and
     7081        self :read-only = false
     7082        )
     7083     then do:
     7084       assign
     7085         self :screen-value = ?
     7086       .
     7087     end.
