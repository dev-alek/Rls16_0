     4861   Procedure proc-r-boss :
     4862    do
     4863    on error undo, return error return-value
     4864    :
     4865     define variable rid-list    as  char no-undo .
     4866     def buffer boss#clients for ub.clients.
     4867       run ref/cli-all.w
     4868       ( input parParentProc,
     4869         input "b-sel",
     4870         input 'чел':U,
     4871         input ?,
     4872         input ?,
     4873         input ref-rec ,
     4874         input ",,,,,,NO"   ,
     4875         input "lock-cli-type",
     4876         output  rid-list
     4877         ) .
     4878       Assign
     4879         rep-rec2 = integer(rid-list)
     4880         ref-rec = integer(rid-list)
     4881         no-error.
     4882       find first boss#clients WHERE recid(boss#clients) = rep-rec2 No-LOCK No-ERROR.
     4883       if avail boss#clients then
     4884           Assign
     4885               boss = boss#clients.obj-code
     4886               boss-name = boss#clients.obj-name .
     4887       Enable  boss boss-name with frame dialog-frame .
     4888       Display boss boss-name with frame dialog-frame .
     4889   end.
     4890   end procedure.
