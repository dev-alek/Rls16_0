     1653               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1654               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1655               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1656               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1657               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1658                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1659               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1660         otherwise do:
     1661           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1662         end.
     1663       end CASE.
     1664     end.
     1665   end procedure.
     1666   procedure uf-get :
     1667     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1668     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1669     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1670     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1671     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1672     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1673     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1674     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1675     do
     1676     on error undo, return error
     1677     :
     1678       define buffer buf_usr-flt for ubflt.usr-flt .
     1679       define variable v-use-List_     as logical   no-undo .
     1680       define variable v-type-List_     as character no-undo .
     1681       define variable v-format-List_   as character no-undo .
     1682       define variable v-use-Naim      as logical   no-undo .
     1683       define variable v-type-Naim      as character no-undo .
     1684       define variable v-format-Naim    as character no-undo .
     1685       define variable v-use-print-graft as logical   no-undo .
     1686       define variable v-use-sort-gr     as logical   no-undo .
     1687       define variable v-use-type-price  as logical   no-undo .
     1688       define variable v-use-type-val    as logical   no-undo .
     1689       define variable v-label          as character no-undo .
     1690       define variable v-tooltip        as character no-undo .
     1691       define variable v-user-can-edit  as logical   no-undo .
     1692       define variable v-output-display as logical   no-undo .
     1693       define variable v-other          as character no-undo .
     1694       run uf-name in this-procedure
     1695          (input  entry(1, p-code, chr(4))
     1696         ,output v-use-List_
     1697         ,output v-type-List_
     1698         ,output v-format-List_
     1699         ,output v-use-Naim
     1700         ,output v-type-Naim
     1701         ,output v-format-Naim
     1702         ,output v-use-print-graft
     1703         ,output v-use-sort-gr
     1704         ,output v-use-type-price
     1705         ,output v-use-type-val
     1706         ,output v-label
     1707         ,output v-tooltip
     1708         ,output v-user-can-edit
     1709         ,output v-output-display
     1710         ,output v-other
     1711         ) no-error .
     1712       if error-status :error then do:
     1713         undo, return error return-value .
     1714       end.
     1715       find first buf_usr-flt no-lock where
     1716                  buf_usr-flt.Call-point     = p-code AND
     1717                  buf_usr-flt.user-name       = p-user-name
     1718         no-error .
     1719       if avail buf_usr-flt then do:
     1720         assign
     1721         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1722         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1723         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1724         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1725         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1726         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1727         .
     1728       end.
     1729       else do:
     1730         assign
     1731         p-List_        = (if v-use-List_       then "":U                    else ?)
     1732         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1733         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1734         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1735         p-type-price   = (if v-use-type-price  then no                      else ?)
     1736         p-type-val     = (if v-use-List_       then no                      else ?)
     1737         .
     1738       end.
     1739     end.
     1740   end procedure.
     1741   procedure uf-set :
     1742     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1743     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1744     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1745     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1746     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1747     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1748     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1749     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1750     do
     1751     on error undo, return error
     1752     :
     1753       define buffer buf_usr-flt for ubflt.usr-flt .
     1754       define variable v-use-List_     as logical   no-undo .
     1755       define variable v-type-List_     as character no-undo .
     1756       define variable v-format-List_   as character no-undo .
     1757       define variable v-use-Naim      as logical   no-undo .
     1758       define variable v-type-Naim      as character no-undo .
     1759       define variable v-format-Naim    as character no-undo .
     1760       define variable v-use-print-graft as logical   no-undo .
     1761       define variable v-use-sort-gr   as logical   no-undo .
     1762       define variable v-use-type-price as logical   no-undo .
     1763       define variable v-use-type-val  as logical   no-undo .
     1764       define variable v-tooltip        as character no-undo .
     1765       define variable v-label          as character no-undo .
     1766       define variable v-user-can-edit  as logical   no-undo .
     1767       define variable v-output-display as logical   no-undo .
     1768       define variable v-other          as character no-undo .
     1769       run uf-name in this-procedure
     1770         (input  entry(1, p-code, chr(4))
     1771         ,output v-use-List_
     1772         ,output v-type-List_
     1773         ,output v-format-List_
     1774         ,output v-use-Naim
     1775         ,output v-type-Naim
     1776         ,output v-format-Naim
     1777         ,output v-use-print-graft
     1778         ,output v-use-sort-gr
     1779         ,output v-use-type-price
     1780         ,output v-use-type-val
     1781         ,output v-label
     1782         ,output v-tooltip
     1783         ,output v-user-can-edit
     1784         ,output v-output-display
     1785         ,output v-other
     1786         ) no-error .
     1787       if error-status :error then do:
     1788         undo, return error return-value .
     1789       end.
     1790       find first buf_usr-flt where
     1791                  buf_usr-flt.Call-point     = p-code AND
     1792                  buf_usr-flt.user-name       = p-user-name
     1793         no-error .
     1794       if not avail buf_usr-flt then do:
     1795           create buf_usr-flt .
     1796           assign
     1797           buf_usr-flt.call-point = p-code
     1798           buf_usr-flt.user-name  = p-user-name
     1799           .
     1800       end.
     1801       if avail buf_usr-flt then do:
     1802        assign
     1803        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1804        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1805        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1806        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1807        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1808        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1809       .
     1810       release buf_usr-flt.
     1811       end.
     1812       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1813     end.
     1814   end procedure.
     1815   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1817   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1818   define variable par-type          as character no-undo.
     1819   define variable v-value-character as character no-undo .
     1820   define variable v-value-date      as date      no-undo .
     1821   define variable v-value-decimal   as decimal   no-undo .
     1822   define variable v-value-integer   as integer   no-undo .
     1823   define variable v-value-logical   as logical   no-undo .
     1824   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1826   procedure gen-key-rec :
     1827     define input  parameter p-tbl-name    as character no-undo.
     1828     define input  parameter p-bh_tbl-name as handle    no-undo.
     1829     define output parameter p-key-rec     as character no-undo.
     1830     do
     1831     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1832     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1833     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1834     :
     1835       define variable fh               as handle    no-undo .
     1836       define variable v-ok             as logical   no-undo .
     1837       define variable v-inform         as character no-undo .
     1838       define variable v-ind            as integer   no-undo .
     1839       define variable v-idx-field-qnty as integer   no-undo .
     1840       if p-tbl-name = ?
     1841         or p-tbl-name = "":U
     1842       then do:
     1843         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info21 ).
     1844       end.
     1845       if not p-bh_tbl-name:available then do:
     1846         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info21, p-tbl-name ).
     1847       end.
     1848       assign
     1849         p-key-rec = p-tbl-name
     1850         v-inform  = p-bh_tbl-name:index-information(1)
     1851         v-ind     = 2
     1852       .
     1853       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1854       on error undo, return error
     1855       :
     1856         assign
     1857           v-inform = p-bh_tbl-name:index-information( v-ind )
     1858           v-ind    = v-ind + 1
     1859         .
     1860       end.
     1861       if v-inform = ?
     1862         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1863         or entry( 3, v-inform, ",":U ) <> "1":U
     1864       then do:
     1865         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, p-tbl-name ).
     1866       end.
     1867       else do:
     1868         assign
     1869           v-idx-field-qnty = num-entries( v-inform ) - 4
     1870         .
     1871         if v-idx-field-qnty < 2 then do:
     1872           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, p-tbl-name ).
     1873         end.
     1874         do v-ind = 1 to v-idx-field-qnty by 2
     1875         on error undo, return error
     1876         :
     1877           assign
     1878             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1879             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1880           .
     1881         end.
     1882       end.
     1883       if p-key-rec = ? then do:
     1884         assign
     1885           p-key-rec = "":U
     1886         .
     1887         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info21, p-tbl-name ).
     1888       end.
     1889     end.
     1890     return.
     1891   end procedure.
     1892   procedure gen-where-keyr-tab :
     1893     define input  parameter i-tableSerach as character no-undo.
     1894     define input  parameter i-tablekey   as character  no-undo.
     1895     define input  parameter p-key-rec    as character  no-undo.
     1896     define input  parameter p-key-handle as handle     no-undo .
     1897     define input  parameter p-db-name    as character  no-undo .
     1898     define input  parameter p-tt-handle  as handle     no-undo .
     1899     define output parameter o-Where      as character  no-undo.
     1900     do
     1901     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1902     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1903     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1904     :
     1905       define variable v-full-tbl-name  as character no-undo .
     1906       define variable bh_tbl-name      as handle    no-undo .
     1907       define variable fh_key           as handle    no-undo .
     1908       define variable fh_search        as handle    no-undo .
     1909       define variable v-field-num      as integer   no-undo .
     1910       define variable v-count-fld      as integer   no-undo .
     1911       define variable v-inform         as character no-undo .
     1912       define variable v-ind            as integer   no-undo .
     1913       define variable v-idx-field-qnty as integer   no-undo .
     1914       define variable v-field-name     as character no-undo .
     1915       define variable v-field-val      as character no-undo .
     1916       define variable v-word-link      as character no-undo .
     1917       define variable vTable           as character no-undo.
     1918       define variable bh_tbl-key       as handle    no-undo .
     1919       assign
     1920         p-key-rec = trim( p-key-rec )
     1921       .
     1922       if p-key-handle <> ? then do:
     1923         if not valid-handle(p-key-handle)
     1924            or p-key-handle:type <> "buffer"
     1925         then do:
     1926           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info21 ).
     1927         end.
     1928         if num-entries( p-key-rec, chr(3) ) > 1
     1929           or p-key-rec = ?
     1930           or p-key-rec = "":U
     1931         then do:
     1932           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info21, p-key-rec ).
     1933         end.
     1934       end.
     1935       else do:
     1936         if p-key-rec = ?
     1937           or p-key-rec = "":U
     1938         then do:
     1939           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info21 ).
     1940         end.
     1941       end.
     1942       assign
     1943         vTable = entry( 1 , p-key-rec, chr(3) )
     1944       .
     1945       if p-tt-handle <> ?
     1946         and ( not valid-handle(p-tt-handle)
     1947               or p-tt-handle:type <> "buffer"
     1948             )
     1949       then do:
     1950         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info21, vTable, chr(10) ).
     1951       end.
     1952       if p-tt-handle = ? then do:
     1953         assign
     1954           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1955         .
     1956         create buffer bh_tbl-name for table v-full-tbl-name .
     1957       end.
     1958       else do:
     1959         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1960       end.
     1961       assign
     1962         v-inform = bh_tbl-name:index-information(1)
     1963         v-ind    = 2
     1964       .
     1965       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1966       on error undo, return error
     1967       :
     1968         assign
     1969           v-inform = bh_tbl-name:index-information( v-ind )
     1970           v-ind    = v-ind + 1
     1971         .
     1972       end.
     1973       if v-inform = ?
     1974         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1975         or entry( 3, v-inform, ",":U ) <> "1":U
     1976       then do:
     1977         delete object bh_tbl-name no-error.
     1978         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info21, vTable ).
     1979       end.
     1980       assign
     1981         v-idx-field-qnty = num-entries( v-inform ) - 4
     1982       .
     1983       if v-idx-field-qnty < 2 then do:
     1984         delete object bh_tbl-name no-error.
     1985         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, vTable ).
     1986       end.
     1987       assign
     1988         o-where     = "where":U
     1989         v-word-link = "":U
     1990         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1991         v-count-fld = 0
     1992       .
     1993       if i-tablekey ne "" and i-tablekey ne ?
     1994       then do:
     1995         assign
     1996           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1997         .
     1998         create buffer bh_tbl-key for table v-full-tbl-name .
     1999       end.
     2000       if i-tableSerach ne "" and i-tableSerach ne ?
     2001       then do:
     2002         delete object bh_tbl-name no-error.
     2003         assign
     2004           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2005         .
     2006         create buffer bh_tbl-name for table v-full-tbl-name .
     2007       end.
     2008       block_where:
     2009       do v-ind = 1 to v-idx-field-qnty by 2
     2010       on error undo, return error
     2011       :
     2012         assign
     2013           v-count-fld = v-count-fld + 1
     2014         .
     2015         if p-key-handle = ?
     2016           and v-count-fld > v-field-num
     2017         then do:
     2018           leave block_where.
     2019         end.
     2020         define variable VfieldKeyTable as handle no-undo.
     2021         assign
     2022           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2023           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2024         .
     2025         if     bh_tbl-key ne ?
     2026         then do:
     2027            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2028            if VfieldKeyTable eq ?
     2029            then next block_where.
     2030         end.
     2031         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2032         then
     2033            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2034         else
     2035            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2036         if p-key-handle = ? then do:
     2037           assign
     2038             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2039           .
     2040         end.
     2041         else do:
     2042           assign
     2043             fh_key = p-key-handle:buffer-field( v-field-name )
     2044           .
     2045           if fh_key = ?
     2046             or not valid-handle( fh_key )
     2047           then do:
     2048             delete object bh_tbl-name.
     2049             if     bh_tbl-key ne ?
     2050             then
     2051                delete object bh_tbl-key.
     2052             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info21, p-key-handle:name, v-field-name ).
     2053           end.
     2054           assign
     2055             v-field-val = fh_key:buffer-value
     2056           .
     2057         end.
     2058         if fh_search:data-type ="character":U then do:
     2059           assign
     2060             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2061             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2062             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2063             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2064             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2065             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2066             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2067             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2068             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2069             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2070             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2071             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2072             v-field-val = substitute( '"&1"', v-field-val )
     2073           .
     2074         end.
     2075         assign
     2076           o-where = substitute( "&1 &2", o-where, v-field-val )
     2077         .
     2078         if v-word-link = "":U then do:
     2079           assign
     2080             v-word-link = "and":U
     2081           .
     2082         end.
     2083       end.
     2084       delete object bh_tbl-name.
     2085       if     bh_tbl-key ne ?
     2086       then
     2087          delete object bh_tbl-key.
     2088       if p-key-handle = ?
     2089         and v-count-fld <> v-field-num
     2090       then do:
     2091         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info21, vTable ).
     2092       end.
     2093     end.
     2094   end procedure.
     2095   procedure gen-hn-keyr-tab :
     2096     define input  parameter i-tableSerach as character no-undo.
     2097     define input  parameter i-tablekey   as character no-undo.
     2098     define input  parameter p-key-rec    as character no-undo.
     2099     define input  parameter p-key-handle as handle    no-undo .
     2100     define input  parameter p-db-name    as character no-undo .
     2101     define input  parameter p-tt-handle  as handle    no-undo .
     2102     define input  parameter p-stts-lock  as integer   no-undo .
     2103     define output parameter o-hn         as handle    no-undo.
     2104     define variable v-full-tbl-name as character no-undo.
     2105     define variable v-where         as character no-undo.
     2106     define variable bh_tbl-name     as handle    no-undo.
     2107     define variable vTable          as character no-undo.
     2108     do
     2109     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2110     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2111     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2112         run gen-where-keyr-tab(i-tableSerach,
     2113                                i-tablekey,
     2114                                p-key-rec,
     2115                                p-key-handle,
     2116                                p-db-name,
     2117                                p-tt-handle,
     2118                                output v-where).
     2119         if i-tableSerach ne "" and i-tableSerach ne ?
     2120         then do:
     2121            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2122            create buffer bh_tbl-name for table v-full-tbl-name .
     2123         end.
     2124         else do:
     2125            if p-tt-handle = ? then do:
     2126               assign
     2127                  vTable = entry( 1 , p-key-rec, chr(3) )
     2128               .
     2129               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2130               create buffer bh_tbl-name for table v-full-tbl-name .
     2131            end.
     2132            else do:
     2133               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2134            end.
     2135         end.
     2136         if p-tt-handle = ? then do:
     2137            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2138         end.
     2139         else do:
     2140            bh_tbl-name:find-first( v-where ) no-error .
     2141         end.
     2142         o-hn = bh_tbl-name.
     2143      end.
     2144   end procedure.
     2145   procedure gen-hn-keyr :
     2146     define input  parameter p-key-rec    as character no-undo.
     2147     define input  parameter p-key-handle as handle    no-undo .
     2148     define input  parameter p-db-name    as character no-undo .
     2149     define input  parameter p-tt-handle  as handle    no-undo .
     2150     define input  parameter p-stts-lock  as integer   no-undo .
     2151     define output parameter o-hn         as handle    no-undo.
     2152     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2153   end.
     2154   procedure gen-row-keyr :
     2155     define input  parameter p-key-rec    as character no-undo.
     2156     define input  parameter p-key-handle as handle    no-undo .
     2157     define input  parameter p-db-name    as character no-undo .
     2158     define input  parameter p-tt-handle  as handle    no-undo .
     2159     define input  parameter p-stts-lock  as integer   no-undo .
     2160     define output parameter p-tbl-row    as rowid     no-undo.
     2161     define output parameter p-tbl-name   as character no-undo.
     2162     define variable vHn as handle no-undo.
     2163       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2164       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2165       p-tbl-name =  vHn:table.
     2166       delete object vHn no-error.
     2167     if p-tbl-row = ? then do:
     2168       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info21, p-tbl-name, p-key-rec ).
     2169     end.
     2170     else do:
     2171       return.
     2172     end.
     2173   end procedure.
     2174   procedure gen-key-fv :
     2175     define input  parameter p-key-rec    as character no-undo .
     2176     define output parameter p-field-list as character no-undo .
     2177     define output parameter p-value-list as character no-undo.
     2178     do
     2179     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2180     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2181     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2182     :
     2183       define variable v-full-tbl-name  as character no-undo .
     2184       define variable bh_tbl-name      as handle    no-undo .
     2185       define variable v-tbl-name       as character no-undo .
     2186       define variable v-field-num      as integer   no-undo .
     2187       define variable v-count-fld      as integer   no-undo .
     2188       define variable v-inform         as character no-undo .
     2189       define variable v-ind            as integer   no-undo .
     2190       define variable v-idx-field-qnty as integer   no-undo .
     2191       define variable v-delim-key      as character no-undo .
     2192       if p-key-rec = ?
     2193         or p-key-rec = "":U
     2194       then do:
     2195         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info21 ).
     2196       end.
     2197       assign
     2198         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2199         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2200       .
     2201       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2202       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info21 ).
     2203       assign
     2204         v-inform = bh_tbl-name:index-information(1)
     2205         v-ind    = 2
     2206       .
     2207       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2208       on error undo, return error
     2209       :
     2210         assign
     2211           v-inform = bh_tbl-name:index-information( v-ind )
     2212           v-ind    = v-ind + 1
     2213         .
     2214       end.
     2215       if v-inform = ?
     2216         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2217         or entry( 3, v-inform, ",":U ) <> "1":U
     2218       then do:
     2219         delete object bh_tbl-name no-error.
     2220         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, v-tbl-name ).
     2221       end.
     2222       assign
     2223         v-idx-field-qnty = num-entries( v-inform ) - 4
     2224       .
     2225       if v-idx-field-qnty < 2 then do:
     2226         delete object bh_tbl-name no-error.
     2227         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, v-tbl-name ).
     2228       end.
     2229       assign
     2230         p-field-list = "":U
     2231         p-value-list = "":U
     2232         v-delim-key  = "":U
     2233         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2234         v-count-fld  = 0
     2235       .
     2236       block_where:
     2237       do v-ind = 1 to v-idx-field-qnty by 2
     2238       on error undo, return error
     2239       :
     2240         assign
     2241           v-count-fld = v-count-fld + 1
     2242         .
     2243         if v-count-fld > v-field-num then do:
     2244           leave block_where.
     2245         end.
     2246         assign
     2247           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2248           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2249         .
     2250         if v-ind = 1 then do:
     2251           assign
     2252             v-delim-key = chr(3)
     2253           .
     2254         end.
     2255       end.
     2256       delete object bh_tbl-name.
     2257       if v-count-fld <> v-field-num then do:
     2258         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info21, v-tbl-name ).
     2259       end.
     2260     end.
     2261   end procedure.
     2262   procedure gen-key-field :
     2263     define input  parameter p-table      as character no-undo .
     2264     define output parameter p-field-list as character no-undo .
     2265     do
     2266     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2267     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2268     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2269     :
     2270       define variable v-full-tbl-name  as character no-undo .
     2271       define variable bh_tbl-name      as handle    no-undo .
     2272       define variable v-tbl-name       as character no-undo .
     2273       define variable v-field-num      as integer   no-undo .
     2274       define variable v-count-fld      as integer   no-undo .
     2275       define variable v-inform         as character no-undo .
     2276       define variable v-ind            as integer   no-undo .
     2277       define variable v-idx-field-qnty as integer   no-undo .
     2278       define variable v-delim-key      as character no-undo .
     2279       if p-table = ?
     2280         or p-table = "":U
     2281       then do:
     2282         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info21 ).
     2283       end.
     2284       assign
     2285         v-tbl-name      = p-table
     2286         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2287       .
     2288       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2289       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info21 ).
     2290       assign
     2291         v-inform = bh_tbl-name:index-information(1)
     2292         v-ind    = 2
     2293       .
     2294       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2295       on error undo, return error
     2296       :
     2297         assign
     2298           v-inform = bh_tbl-name:index-information( v-ind )
     2299           v-ind    = v-ind + 1
     2300         .
     2301       end.
     2302       if v-inform = ?
     2303         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2304         or entry( 3, v-inform, ",":U ) <> "1":U
     2305       then do:
     2306         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, v-tbl-name ).
     2307       end.
     2308       assign
     2309         v-idx-field-qnty = num-entries( v-inform ) - 4
     2310       .
     2311       if v-idx-field-qnty < 2 then do:
     2312         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, v-tbl-name ).
     2313       end.
     2314       assign
     2315         p-field-list = "":U
     2316         v-delim-key  = "":U
     2317         v-count-fld  = 0
     2318       .
     2319       block_where:
     2320       do v-ind = 1 to v-idx-field-qnty by 2
     2321       on error undo, return error
     2322       :
     2323         assign
     2324           v-count-fld = v-count-fld + 1
     2325         .
     2326         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2327         if v-ind = 1 then do:
     2328           assign
     2329             v-delim-key = chr(3)
     2330           .
     2331         end.
     2332       end.
     2333       delete object bh_tbl-name.
     2334     end.
     2335   end procedure.
     2336   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2337   define new global shared variable g#attr-lib  as handle no-undo .
     2338   define variable v-attr-lib-variable as handle no-undo .
     2339   procedure clntattr-code :
     2340     define input  parameter p-code           as character no-undo .
     2341     define output parameter p-type           as character no-undo .
     2342     define output parameter p-format         as character no-undo .
     2343     define output parameter p-label          as character no-undo .
     2344     define output parameter p-user-can-edit  as logical   no-undo .
     2345     define output parameter p-output-display as logical   no-undo .
     2346     define output parameter p-other          as character no-undo .
     2347     do
     2348     on error undo, return error return-value
     2349     :
     2350           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     2351         (input  p-code
     2352         ,output p-type
     2353         ,output p-format
     2354         ,output p-label
     2355         ,output p-user-can-edit
     2356         ,output p-output-display
     2357         ,output p-other
