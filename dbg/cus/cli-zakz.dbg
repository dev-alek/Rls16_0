     2404   end procedure.
     2405   procedure clntattr-write :
     2406     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2407     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2408     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2409     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
     2410     do
