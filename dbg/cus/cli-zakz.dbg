     3204   procedure gds-obj-normal-wastage :
     3205     define input  parameter p-gds-code    like ub.gds-obj-attr.gds-code no-undo .
     3206     define input  parameter p-obj-type    like ub.gds-obj-attr.obj-type no-undo .
