     5199   ON CHOOSE OF b-protocol IN FRAME Dialog-Frame
     5200   DO:
     5201   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5202   if lookup(self :type
     5203            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5204            ) = 0
