     8723                                       shar_ord-line.artic      =   tmp#zakaz.artic and
     8724                                       shar_ord-line.prod-type  =   tmp#zakaz.prod-type and
     8725                                       shar_ord-line.prod-code  =   tmp#zakaz.prod-code no-error .
     8726                             delete shar_ord-line .
     8727                             delete tmp#zakaz.
     8728                       end.
     8729               end.
     8730          end.
     8731     end.
     8732      is-error = false  .
     8733      is-em = "" .
     8734      assign  frame dialog-frame wrkr loc-exch-code
     8735             agnt boss loc-date-ship loc-time-ship loc-service
     8736             paytype  cycle-day tog-type pay-day loc-tot-lines
     8737             date-sale-1 date-sale-2 loc-cli-out-doc doc-date
     8738             no-error .
     8739      if error-status:error then do:
     8740        is-error = true .
     8741        is-em = error-status :get-message(1) .
     8742      end.
     8743      if date-sale-1 = loc-date-ship then do:
     8744        pay-day = date-sale-2 - date-sale-1  .
     8745      end.
     8746      else do:
     8747        pay-day = date-sale-2 - date-sale-1 + 1 .
     8748      end.
     8749      run ver-date  in this-procedure .
     8750      if ( is-edoc-nn-doc = false and shar_ord-doc.ord-int1 = int('0':U) )
     8751      or ( is-edi-doc     = false and shar_ord-doc.ord-int1 = int('0':U)  )
     8752      then do:
     8753        find first shar_ord-line  no-lock  where
     8754                   shar_ord-line.doc-code   =  loc-ord-num   and
     8755                   shar_ord-line.artic      =   tmp#zakaz.artic and
     8756                   shar_ord-line.prod-type  =   tmp#zakaz.prod-type and
     8757                   shar_ord-line.prod-code  =   tmp#zakaz.prod-code no-error .
     8758         if available shar_ord-line then do:
     8759             run ver-clients-calc in this-procedure (
     8760               input loc-cli-type
     8761             , input loc-cli-code
     8762             , input store-type
     8763             , input store-code
     8764             , input e-method
     8765             , output v-err
     8766             ) .
     8767             if v-err then return error 'no-calc'.
     8768         end.
     8769         run ver-calc no-error .
     8770         if error-status :error then do:
     8771           is-error = true .
     8772           is-em    =  substitute("Была корректировка рассчитанного заказа!&1Пересчитайте заказ  " , chr(10)) .
     8773           message "Документ не может быть сохранен в базу данных ! " skip
     8774                   is-em  skip
     8775                   view-as alert-box error  .
     8776           return error return-value .
     8777         end.
     8778      end.
     8779      if is-error = true then do:
     8780           message "Документ в базу не добавлен ! " skip
     8781           is-em  skip
     8782           return-value skip
     8783           view-as alert-box information .
     8784           error-status:error = false .
     8785      end.
     8786      else do:
     8787        run full-recount in this-procedure no-error.
     8788        run local-conf-rd in this-procedure .
     8789        run cus/ord-save.p (
     8790             input parParentProc ,
