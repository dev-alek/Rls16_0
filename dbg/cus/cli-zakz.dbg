      235   def
      236   new shared
      237   temp-table  obj-list no-undo
      238     field obj-type like ub.clients.obj-type
      239     field obj-code like ub.clients.obj-code
      240     field obj-name like ub.clients.obj-name
      241     field obj-id   as integer
