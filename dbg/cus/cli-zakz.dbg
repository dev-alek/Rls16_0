     2809   procedure grp-obj-notcorr-value :
     2810   do
     2811   on error undo, return error
     2812   :
     2813   define input parameter p-node-code             as integer      no-undo.
     2814   define input parameter p-obj-type              as character    no-undo.
     2815   define input parameter p-obj-code              as integer      no-undo.
     2816   define output parameter p-notcorr              as character    no-undo init ?.
     2817   define output parameter p-range-notcorr     as integer      no-undo.
     2818   define output parameter p-exists-notcorr    as logical      no-undo.
     2819   define variable v-host-code as integer      no-undo.
     2820   DEFINE VARIABLE v-found as logical no-undo .
     2821   DEFINE VARIABLE v-exists as logical no-undo .
     2822   DEFINE VARIABLE v-range as integer no-undo .
     2823   DEFINE VARIABLE jj as integer no-undo .
     2824   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2825   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2826   define buffer buf_gds-grp for ub.gds-grp.
     2827   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2828   find first buf_gds-grp no-lock where
     2829              buf_gds-grp.node-code = p-node-code no-error .
     2830   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2831     message
     2832       vss-workfile vss-revision vss-description
     2833       skip "Не удалось найти группу товаров с кодом" p-node-code
     2834       view-as alert-box error .
     2835     undo, return error .
     2836   end.
     2837   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2838   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2839     (input  p-obj-type
     2840     ,input  p-obj-code
     2841     ,output v-host-code
     2842     ) no-error .
     2843   if error-status :error
     2844   then do:
     2845       message
     2846         vss-workfile vss-revision vss-description
     2847         skip "Не удалось найти фирму объекта"
     2848         skip p-obj-type p-obj-code
     2849         skip return-value
     2850         skip trim(error-status :get-message(1))
     2851       view-as alert-box error.
     2852       undo, return error .
     2853   end.
     2854   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2855   do while v-found = no and jj < 2:
     2856     if v-range <> 3 then do:
     2857       find first buf_gds-grp-obj no-lock
     2858           where buf_gds-grp-obj.node-code = p-node-code
     2859             and buf_gds-grp-obj.host-code = v-host-code
     2860             and buf_gds-grp-obj.obj-type  = p-obj-type
     2861             and buf_gds-grp-obj.obj-code  = p-obj-code
     2862       no-error .
     2863     end.
     2864     if v-range = 3 or not available buf_gds-grp-obj
     2865     then do:
     2866        if v-range <> 2 then do:
     2867           find first buf_gds-grp-obj no-lock
     2868               where buf_gds-grp-obj.node-code = p-node-code
     2869                 and buf_gds-grp-obj.host-code = v-host-code
     2870                 and buf_gds-grp-obj.obj-type  = ""
     2871                 and buf_gds-grp-obj.obj-code  = 0
     2872           no-error .
     2873         end.
     2874         if v-range = 2 or not available buf_gds-grp-obj
     2875         then do:
     2876             if v-range <> 1 then do:
     2877               find first buf_gds-grp-obj no-lock
     2878                   where buf_gds-grp-obj.node-code = p-node-code
     2879                   and buf_gds-grp-obj.host-code = 0
     2880                   and buf_gds-grp-obj.obj-type  = ""
     2881                   and buf_gds-grp-obj.obj-code  = 0
     2882               no-error .
     2883             end.
     2884             if v-range = 1 or not available buf_gds-grp-obj
     2885             then do:
     2886                 assign
     2887                     v-exists = no
     2888                 .
     2889             end.
     2890             else do:
     2891                 assign
     2892                     v-exists = yes
     2893                     v-range = 1
     2894                 .
     2895             end.
     2896         end.
     2897         else do:
     2898             assign
     2899                 v-exists = yes
     2900                 v-range  = 2
     2901             .
     2902         end.
     2903     end.
     2904     else do:
     2905         assign
     2906             v-exists = yes
     2907             v-range  = 3
     2908         .
     2909     end.
     2910     if available buf_gds-grp-obj
     2911     then do:
     2912       find first buf_gds-grp-obj-attr no-lock
     2913         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2914           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2915           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2916           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2917           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2918         no-error .
     2919       if available buf_gds-grp-obj-attr then do:
     2920         assign
     2921           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2922         .
     2923       end.
     2924       else do:
     2925         assign
     2926           v-notcorr-value = ?
     2927         .
     2928       end.
     2929       assign
     2930       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2931                           then yes
     2932                           else p-exists-notcorr)
     2933       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2934                         then v-range
     2935                         else p-range-notcorr
     2936       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2937                         then v-notcorr-value
     2938                         else p-notcorr
     2939       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2940       jj = jj + 1
     2941       .
     2942     end.
     2943     else do:
     2944       assign
     2945       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2946       jj = jj + 1
     2947       .
     2948     end.
     2949   end.
     2950   end.
     2951   end procedure.
     2952   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2953   procedure ver-clients :
     2954   define input  parameter p-obj-type as character no-undo .
     2955   define input  parameter p-obj-code as integer   no-undo .
     2956   define output parameter p-error as logical   no-undo .
     2957   define variable v-veto-man-doc as character no-undo .
     2958   define variable v-type        as character no-undo .
     2959     do
     2960     on error undo, return error return-value
     2961     :
     2962     p-error = false .
     2963   run clntattr-value in this-procedure (
     2964    input p-obj-type ,
     2965    input p-obj-code ,
     2966    input 'veto-man-doc':U     ,
     2967    output v-veto-man-doc ,
     2968    output v-type        ) no-error .
     2969    if error-status :error then message
     2970      error-status :get-message(1) skip
     2971      return-value skip
     2972      "Ошибка clntattr-veto-man-doc"
     2973      view-as alert-box error
     2974    .
     2975     if v-veto-man-doc = 'ALL' then do:
     2976         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     2977         p-error = true .
     2978     end.
     2979    end.
     2980   end procedure.
