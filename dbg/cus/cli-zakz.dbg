    11342    if not avail shar_ord-line then return.
    11343    run cus/ord-way.w (   pARPARENTPROC,
    11344                      shar_ord-line.artic     ,
    11345                      shar_ord-line.prod-type ,
    11346                      shar_ord-line.prod-code ,
    11347                      2,
    11348                       LOC-DATE-SHIP  ,
    11349                       DATE-sale-1    ,
    11350                       DATE-sale-2    ,
    11351                       loc-store-type ,
