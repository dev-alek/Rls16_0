      246   .
      247   procedure create_obj-list :
      248      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      249      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      250      do
      251      on error undo, return error return-value
      252      :
      253         define buffer cli-obj for ub.clients .
      254         define variable p-var as integer no-undo .
      255         define buffer buf_obj-list for obj-list .
      256         find last buf_obj-list  use-index pi no-error .
      257         if available buf_obj-list
      258         then
      259            p-var = buf_obj-list.obj-id + 1.
      260         else
      261            p-var = 1.
      262         find first cli-obj where
      263                   cli-obj.obj-type = p-obj-type
      264               and cli-obj.obj-code = p-obj-code
      265         no-lock no-error.
      266         if available cli-obj
      267         then do:
      268            create buf_obj-list.
      269            assign
      270               buf_obj-list.obj-id   = p-var
      271               buf_obj-list.obj-code = cli-obj.obj-code
      272               buf_obj-list.obj-type = cli-obj.obj-type
      273               buf_obj-list.obj-name = cli-obj.obj-name
      274               buf_obj-list.db-num   = cli-obj.db-num
      275            .
      276         end.
      277      end.
      278   end.
