      943   define new global shared variable g#lib-trn4 as handle no-undo .
      944   define new global shared variable g#libbcrcn as handle no-undo .
      945   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   define variable v-waitfram-action01         as character   no-undo .
      947   define variable v-waitfram-action02         as character   no-undo .
      948   define variable v-waitfram-action03         as character   no-undo .
      949   define variable mWaitFramTextBeg            as character   no-undo.
      950   define variable mWaitFramTextEnd            as character   no-undo.
      951   define variable mWaitFramView               as logical     no-undo.
      952   define variable mWaitProcEvent              as logical     no-undo init yes.
      953   define variable mWaitFramInterval           as integer     no-undo init 1 .
      954   define variable mWaitFramStop               as logical     no-undo.
      955   define variable mWaitFramStopUser           as logical     no-undo.
      956   define variable mWaitFramStopTimeOut        as logical     no-undo.
      957   define variable mWaitFramStartProc          as datetime-tz no-undo.
      958   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      959   define button B-WaitFramStop auto-end-key
      960        label "Стоп"
      961        size 10 by 1 tooltip "Остоновить процесс".
      962   define button B-viewProcInfo
      963        label "Информация"
      964        size 15 by 1 tooltip "Информация о процесс".
      965   define frame waitfram
      966     v-waitfram-action01 format "x(72)" no-label skip
      967     v-waitfram-action02 format "x(72)" no-label skip
      968     v-waitfram-action03 format "x(72)" no-label skip
      969     B-viewProcInfo
      970     B-WaitFramStop at row 4 col 30
      971     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      972     .
      973   define new global shared variable mBatchMode as logical no-undo init ?.
      974   define variable mFramBachModHandle as handle no-undo.
      975   mFramBachModHandle = frame waitfram:handle.
      976   define variable mFameOldVis as logical no-undo.
      977   define variable mVisCUrentVin as logical no-undo.
      978   if session:batch-mode
      979   then
      980      mBatchMode = yes.
      981   if mBatchMode = ? then do:
      982     mVisCUrentVin = current-window:visible.
      983     mFameOldVis = mFramBachModHandle:visible.
      984     mFramBachModHandle:visible  = yes.
      985     mBatchMode = mFramBachModHandle:visible ne yes.
      986     mFramBachModHandle:visible = mFameOldVis.
      987     current-window:visible = mVisCUrentVin.
      988   end.
      989    if  log-manager:logfile-name ne ?
      990     then DO:
      991         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      992         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      993         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      994     end.
      995   on choose of B-WaitFramStop in frame waitfram
      996   do:
      997     mWaitFramStop = yes.
      998     mWaitFramStopUser = yes.
      999   end.
     1000   function waitfram-check-timeout returns logical():
     1001      define variable vtime as int64 no-undo.
     1002      if mWaitFramStopTimeOut
     1003      then
     1004         return yes.
     1005      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1006      if     mWaitFramTimeOut ne ?
     1007         and mWaitFramTimeOut ne 0
     1008         and mWaitFramTimeOut lt vtime
     1009      then do:
     1010         mWaitFramStopTimeOut = yes.
     1011      end.
     1012      return mWaitFramStopTimeOut.
     1013   end.
     1014   procedure waitfram-hide :
     1015     if not session:batch-mode
     1016     then do
     1017     on error undo, return error return-value
     1018     :
     1019       pause 0 before-hide .
     1020       if not mBatchMode then
     1021         hide frame waitfram .
     1022     if     not mWaitFramView
     1023        and mWaitProcEvent
     1024     then
     1025       process events .
     1026     end.
     1027   end procedure.
     1028   procedure waitfram-show :
     1029     define input  parameter p-message as character no-undo .
     1030     define variable v-left-margin as integer   no-undo .
     1031     if not session:batch-mode
     1032     then do
     1033     on error undo, return error return-value
     1034     :
     1035       if length(p-message) <= 70 then do:
     1036         assign
     1037           v-left-margin = integer((70 - length(p-message)) / 2)
     1038         .
     1039         assign
     1040           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1041         .
     1042         assign
     1043           v-waitfram-action01 = " "
     1044           v-waitfram-action02 = " "
     1045                                    + fill(" ", v-left-margin)
     1046                                    + p-message
     1047           v-waitfram-action03 = " "
     1048         .
     1049       end.
     1050       else do:
     1051         define variable vRindex1 as integer no-undo.
     1052         define variable vRindex2 as integer no-undo.
     1053         vRindex1 = r-index(p-message," ",70).
     1054         if vRindex1 = 0
     1055         then
     1056            vRindex1 = 70.
     1057         if length(p-message)  <= vRindex1 + 70 then do:
     1058           assign
     1059             v-waitfram-action01 = " "
     1060             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1061             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1062           .
     1063         end.
     1064         else do:
     1065           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1066           if vRindex2 <= vRindex1
     1067           then
     1068              vRindex2 = vRindex1 + 70.
     1069           assign
     1070             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1071             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1072             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1073           .
     1074         end.
     1075       end.
     1076       B-viewProcInfo:visible   in frame waitfram = no.
     1077       B-viewProcInfo:sensitive in frame waitfram = no.
     1078       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1079       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1080       if  (   mWaitFramView
     1081          or  mWaitProcEvent)
     1082          and not mBatchMode
     1083       then
     1084          display
     1085             v-waitfram-action01 skip
     1086             v-waitfram-action02 skip
     1087             v-waitfram-action03 skip
     1088          with frame waitfram .
     1089       if     mWaitFramView
     1090          then do:
     1091             if     mWaitFramInterval ne ?
     1092                and not mBatchMode
     1093             then
     1094                wait-for go of frame waitfram pause mWaitFramInterval.
     1095          end.
     1096          else
     1097             if     mWaitProcEvent
     1098                and not mBatchMode
     1099             then
     1100                process events .
     1101     end.
     1102   end procedure.
     1103      procedure waitfram-show-this:
     1104         define input  parameter iInterval as int64 no-undo.
     1105         define variable vtime as int64 no-undo.
     1106         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1107         mWaitFramInterval = iInterval.
     1108         run waitfram-show (substitute("&1&2 &3&4" ,
     1109                                       mWaitFramTextBeg ,
     1110                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1111                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1112                                       mWaitFramTextEnd
     1113                                      )
     1114                           ).
     1115      end.
     1116      procedure WaitFramRunPause:
     1117         define input  parameter iInterval as dec no-undo.
     1118         define variable vStart  as datetime-tz no-undo.
     1119         define variable vend    as datetime-tz no-undo.
     1120         define variable vint as int64 no-undo.
     1121         define variable vOk as logical no-undo.
     1122         vStart = now.
     1123         vend   = vStart.
     1124         publish "WaitFramPause" (iInterval,output vOk).
     1125         vend   =  now.
     1126         vint = vend - vStart.
     1127         vint = iInterval - vint / 1000.
     1128         if     not mWaitFramStop
     1129            and (   vint > 0
     1130                 or (    not vOk
     1131                     and iInterval eq ?
     1132                     )
     1133                 )
     1134         then
     1135            run waitfram-show-this (iInterval).
     1136         vend   =  now.
     1137         vint = vend - vStart.
     1138         vint = iInterval - vint / 1000.
     1139         if     not mWaitFramStop
     1140            and vint > 0
     1141         then do:
     1142            run gbl/pause.p (vint * 1000).
     1143         end.
     1144         if iInterval ne ?
     1145         then
     1146            publish "WaitFramStop".
     1147         waitfram-check-timeout().
     1148      end.
     1149      procedure WaitFramWaitFor:
     1150         define input  parameter iInterval as dec no-undo.
     1151         assign
     1152            mWaitFramStartProc   = now
     1153            mWaitFramStopUser    = no
     1154            mWaitFramStopTimeOut = no
     1155         .
     1156         block-wait:
     1157         do while not mWaitFramStop:
     1158            run WaitFramRunPause (iInterval).
     1159            if  waitfram-check-timeout()
     1160            then do:
     1161               leave block-wait.
     1162            end.
     1163         end.
     1164         run waitfram-hide.
     1165      end.
     1166   procedure waitfram-join :
     1167     define input  parameter p-line-1  as character no-undo .
     1168     define input  parameter p-line-2  as character no-undo .
     1169     define input  parameter p-line-3  as character no-undo .
     1170     define output parameter p-message as character no-undo .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       assign
     1175         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1176                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1177                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1178       .
     1179     end.
     1180   end procedure.
     1181   function waitfram-join-function returns character
     1182     (input p-line-1 as character
     1183     ,input p-line-2 as character
     1184     ,input p-line-3 as character
     1185     ).
     1186     define variable v-message as character no-undo .
     1187     run waitfram-join in this-procedure
     1188       (input  p-line-1
     1189       ,input  p-line-2
     1190       ,input  p-line-3
     1191       ,output v-message
     1192       ) .
     1193     return v-message .
     1194   end function .
     1195   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   procedure grp-attr-name :
     1197   do
     1198     on error undo, return error
     1199     :
     1200     define input  parameter p-code           as character no-undo .
     1201     define output parameter p-type           as character no-undo .
     1202     define output parameter p-format         as character no-undo .
     1203     define output parameter p-label          as character no-undo .
     1204     define output parameter p-user-can-edit  as logical   no-undo .
     1205     define output parameter p-output-display as logical   no-undo .
     1206     define output parameter p-other          as character no-undo .
     1207       case p-code :
     1208               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1209         otherwise do:
     1210           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1211         end.
     1212       end.
     1213     end.
     1214   end procedure.
     1215   procedure grp-attr-tooltip :
     1216   do
     1217     on error undo, return error
     1218     :
     1219       define input  parameter p-code    as character no-undo .
     1220       define output parameter p-tooltip as character no-undo .
     1221       define output parameter p-label   as character no-undo .
     1222       case p-code :
     1223               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
     1224         otherwise do:
     1225               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1226         end.
     1227       end.
     1228     end.
     1229   end procedure.
     1230   procedure grp-attr-value :
     1231   do
     1232   on error undo, return error
     1233   :
     1234   define input  parameter p-node-code   as integer    no-undo.
     1235   define input  parameter p-code        as character  no-undo.
     1236   define input  parameter p-host-code   as integer    no-undo.
     1237   define input  parameter p-obj-type    as character  no-undo.
     1238   define input  parameter p-obj-code    as integer    no-undo.
     1239   define output parameter p-value       as character  no-undo.
     1240   define output parameter p-type        as character  no-undo.
     1241       define variable v-format         as character no-undo .
     1242       define variable v-label          as character no-undo .
     1243       define variable v-user-can-edit  as logical   no-undo .
     1244       define variable v-output-display as logical   no-undo .
     1245       define variable v-other          as character no-undo .
     1246       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
     1247       run grp-attr-name in this-procedure (
     1248             input  p-code
     1249           , output p-type
     1250           , output v-format
     1251           , output v-label
     1252           , output v-user-can-edit
     1253           , output v-output-display
     1254           , output v-other
     1255       ) no-error .
     1256       if error-status :error
     1257       then do:
     1258           undo, return error return-value .
     1259       end.
     1260       find first buf_gds-grp-attr no-lock
     1261            where buf_gds-grp-attr.node-code = p-node-code
     1262              and buf_gds-grp-attr.attr-code = p-code
     1263              and buf_gds-grp-attr.host-code = p-host-code
     1264              and buf_gds-grp-attr.obj-type  = p-obj-type
     1265              and buf_gds-grp-attr.obj-code  = p-obj-code
     1266       no-error .
     1267       if available buf_gds-grp-attr
     1268       then do:
     1269           assign
     1270               p-value = buf_gds-grp-attr.attr-value
     1271           .
     1272       end.
     1273       else do:
     1274           assign
     1275               p-value = if p-type = 'L':U then "no":U else ""
     1276           .
     1277       end.
     1278   end.
     1279   end procedure.
     1280   procedure grp-attr-write :
     1281   do
     1282   on error undo, return error
     1283   :
     1284   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
     1285   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
     1286   define input parameter p-host-code  as integer                          no-undo.
     1287   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     1288   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     1289   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
     1290       define variable v-type              as character                no-undo.
     1291       define variable v-format            as character                no-undo.
     1292       define variable v-label             as character                no-undo.
     1293       define variable v-user-can-edit     as logical                  no-undo.
     1294       define variable v-output-display    as logical                  no-undo.
     1295       define variable v-other             as character                no-undo.
     1296       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     1297       run grp-attr-name in this-procedure (
     1298                         input  p-code
     1299                       , output v-type
     1300                       , output v-format
     1301                       , output v-label
     1302                       , output v-user-can-edit
     1303                       , output v-output-display
     1304                       , output v-other
     1305       ) no-error.
     1306       if error-status :error
     1307       then do:
     1308           undo, return error return-value.
     1309       end.
     1310       find first buf_gds-grp-attr exclusive-lock
     1311            where buf_gds-grp-attr.node-code  = p-node-code
     1312              and buf_gds-grp-attr.attr-code  = p-code
     1313              and buf_gds-grp-attr.host-code  = p-host-code
     1314              and buf_gds-grp-attr.obj-type   = p-obj-type
     1315              and buf_gds-grp-attr.obj-code   = p-obj-code
     1316       no-error.
     1317       if not available buf_gds-grp-attr
     1318       then do:
     1319           create buf_gds-grp-attr.
     1320           assign
     1321                   buf_gds-grp-attr.node-code  = p-node-code
     1322                   buf_gds-grp-attr.attr-code  = p-code
     1323                   buf_gds-grp-attr.host-code  = p-host-code
     1324                   buf_gds-grp-attr.obj-type   = p-obj-type
     1325                   buf_gds-grp-attr.obj-code   = p-obj-code
     1326                   buf_gds-grp-attr.attr-value = p-value
     1327           .
     1328       end.
     1329       else do:
     1330           assign
     1331               buf_gds-grp-attr.attr-value = p-value
     1332           .
     1333       end.
     1334   end.
     1335   end procedure.
     1336   procedure grp-attr-delete :
     1337   do
     1338   on error undo, return error
     1339   :
     1340   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
     1341   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
     1342   define input parameter p-host-code  as integer                      no-undo.
     1343   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
     1344   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
     1345   define output parameter p-deleted   as logical                      no-undo.
     1346       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     1347       define variable v-type              as character                no-undo.
     1348       define variable v-format            as character                no-undo.
     1349       define variable v-label             as character                no-undo.
     1350       define variable v-user-can-edit     as logical                  no-undo.
     1351       define variable v-output-display    as logical                  no-undo.
     1352       define variable v-other             as character                no-undo.
     1353       run grp-attr-name in this-procedure
     1354       ( input  p-code
     1355       , output v-type
     1356       , output v-format
     1357       , output v-label
     1358       , output v-user-can-edit
     1359       , output v-output-display
     1360       , output v-other
     1361       ) no-error .
     1362       if error-status :error then do:
     1363           undo, return error return-value .
     1364       end.
     1365       find first buf_gds-grp-attr exclusive-lock
     1366            where buf_gds-grp-attr.node-code  = p-node-code
     1367              and buf_gds-grp-attr.attr-code  = p-code
     1368              and buf_gds-grp-attr.host-code  = p-host-code
     1369              and buf_gds-grp-attr.obj-type   = p-obj-type
     1370              and buf_gds-grp-attr.obj-code   = p-obj-code
     1371       no-error.
     1372       if not available buf_gds-grp-attr
     1373       then do:
     1374           assign
     1375               p-deleted = no
     1376           .
     1377       end.
     1378       else do:
     1379          delete buf_gds-grp-attr.
     1380          assign
     1381               p-deleted = yes
     1382           .
     1383       end.
     1384   end.
     1385   end procedure.
     1386   procedure grp-attr-news :
     1387   do
     1388   on error undo, return error
     1389   :
     1390       define input  parameter p-code           as character no-undo .
     1391       define output parameter p-news           as logical   no-undo .
     1392       case p-code :
     1393               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
     1394         otherwise do:
     1395           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
     1396         end.
     1397       end.
     1398   end.
     1399   end procedure.
     1400   procedure grp-attr-obj-value :
     1401   do
     1402   on error undo, return error
     1403   :
     1404   define input parameter p-node-code as integer      no-undo.
     1405   define input parameter p-obj-type  as character    no-undo.
     1406   define input parameter p-obj-code  as integer      no-undo.
     1407   define input parameter p-attr-code as character    no-undo .
     1408   define output parameter p-attr-value     as character   no-undo.
     1409   define output parameter p-range     as integer      no-undo.
     1410   define output parameter p-exists    as logical      no-undo.
     1411   define variable v-host-code as integer      no-undo.
     1412   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1414     (input  p-obj-type
     1415     ,input  p-obj-code
     1416     ,output v-host-code
     1417     ) no-error .
     1418   if error-status :error
     1419   then do:
     1420       message
     1421         vss-workfile vss-revision vss-description
     1422         skip "Не удалось найти фирму объекта"
     1423         skip p-obj-type p-obj-code
     1424         skip return-value
     1425         skip trim(error-status :get-message(1))
     1426              trim(error-status :get-message(2))
     1427              trim(error-status :get-message(3))
     1428              trim(error-status :get-message(4))
     1429              trim(error-status :get-message(5))
     1430       view-as alert-box error.
     1431       undo, return error .
     1432   end.
     1433   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
     1434   find first buf_gds-grp-attr no-lock
     1435        where buf_gds-grp-attr.node-code = p-node-code
     1436          and buf_gds-grp-attr.attr-code = p-attr-code
     1437          and buf_gds-grp-attr.host-code = v-host-code
     1438          and buf_gds-grp-attr.obj-type  = p-obj-type
     1439          and buf_gds-grp-attr.obj-code  = p-obj-code
     1440   no-error .
     1441   if not available buf_gds-grp-attr
     1442   then do:
     1443       find first buf_gds-grp-attr no-lock
     1444            where buf_gds-grp-attr.node-code = p-node-code
     1445              and buf_gds-grp-attr.attr-code = p-attr-code
     1446              and buf_gds-grp-attr.host-code = v-host-code
     1447              and buf_gds-grp-attr.obj-type  = ""
     1448              and buf_gds-grp-attr.obj-code  = 0
     1449       no-error .
     1450       if not available buf_gds-grp-attr
     1451       then do:
     1452           find first buf_gds-grp-attr no-lock
     1453               where buf_gds-grp-attr.node-code = p-node-code
     1454               and buf_gds-grp-attr.attr-code = p-attr-code
     1455               and buf_gds-grp-attr.host-code = 0
     1456               and buf_gds-grp-attr.obj-type  = ""
     1457               and buf_gds-grp-attr.obj-code  = 0
     1458           no-error .
     1459           if not available buf_gds-grp-attr
     1460           then do:
     1461               assign
     1462                   p-exists = no
     1463               .
     1464           end.
     1465           else do:
     1466               assign
     1467                   p-exists = yes
     1468                   p-range  = 1
     1469               .
     1470           end.
     1471       end.
     1472       else do:
     1473           assign
     1474               p-exists = yes
     1475               p-range  = 2
     1476           .
     1477       end.
     1478   end.
     1479   else do:
     1480       assign
     1481           p-exists = yes
     1482           p-range  = 3
     1483       .
     1484   end.
     1485   if available buf_gds-grp-attr
     1486   then do:
     1487     assign
     1488     p-attr-value = buf_gds-grp-attr.attr-value
     1489     .
     1490   end.
     1491   end.
     1492   end procedure.
     1493   procedure ver-gds-grp-nabor :
     1494   do
     1495   on error undo, return error return-value
     1496   :
     1497   define input  parameter p-gds-code as integer   no-undo .
     1498   define output parameter p-nabor as logical   no-undo .
     1499   define buffer buf_goods for ub.goods.
     1500   p-nabor = false .
     1501   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1502   if error-status :error then return error .
     1503   define variable v-value       as character  no-undo.
     1504   define variable v-type        as character  no-undo.
     1505     run grp-attr-value (
     1506        input   buf_goods.grp-code
     1507       ,input   'gds-grp-nabor':U
     1508       ,input   0
     1509       ,input   ""
     1510       ,input   0
     1511       ,output  v-value
     1512       ,output  v-type       ) no-error .
     1513       if error-status :error then return error .
     1514     if v-value = "yes" then p-nabor = true  .
     1515   end.
     1516   end procedure.
