     5225   if lookup(self :type
     5226            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5227            ) = 0
     5228   then do:
     5229     message
     5230       "$Workfile$"
     5231       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5232       "Интерфейсный элемент" self :name  skip
     5233       "Тип" self :type  skip
     5234       "Процедура" this-procedure :file-name skip
     5235       view-as alert-box .
