    11378   procedure CHOOSE-MENU-way4 :
    11379    do
    11380    on error undo, return error return-value
    11381    :
    11382    assign frame dialog-frame LOC-DATE-SHIP
    11383                               DATE-sale-1
    11384                               DATE-sale-2 .
    11385    run ver-date  in this-procedure .
    11386    if return-value <> "" then return.
    11387    find current shar_ord-line no-lock no-error .
    11388    if not avail shar_ord-line then return.
    11389    run cus/ord-waya.w (   PARPARENTPROC,
    11390                       shar_ord-line.doc-code  ,
    11391                      2,
    11392                       LOC-DATE-SHIP  ,
    11393                       DATE-sale-1    ,
