    10483   define variable v-slt-pc        like ub.doc-line.slt-pc    no-undo.
    10484   define variable v-host-code     like ub.sysconf.host-code  no-undo.
    10485     run check-update no-error.
    10486     if error-status:error then return error.
    10487   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10489     (input  loc-store-type
    10490     ,input  loc-store-code
    10491     ,output v-host-code
    10492     )  .
    10493     assign
    10494       old-slt = slt_type
    10495     .
    10496     assign frame dialog-frame slt_type.
    10497     find first d-l-b no-lock no-error.
    10498     if available d-l-b then do:
    10499        if slt_type = 'без':U and
    10500           old-slt <> 'без':U then do:
    10501           message "Налог с продаж в строках устанавливаем в 0" view-as alert-box information.
    10502           for each d-l-b :
    10503               assign d-l-b.slt-pc = 0.
    10504           end.
    10505        end.
    10506        else if slt_type <> 'без':U and
    10507                old-slt = 'без':U then do:
    10508           message "Налог с продаж в строках устанавливаем из товара " view-as alert-box information.
    10509           for each d-l-b ,
    10510                    first bf-goods where bf-goods.artic     = d-l-b.artic and
    10511                                         bf-goods.prod-type = d-l-b.prod-type and
    10512                                         bf-goods.prod-code = d-l-b.prod-code:
    10513   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    10515     (input  bf-goods.gds-code
    10516     ,input  '2':U
    10517     ,input  ?
    10518     ,input  v-host-code
    10519     ,input  loc-store-type
    10520     ,input  loc-store-code
    10521     ,output v-slt-pc
    10522     ) no-error .
    10523               assign d-l-b.slt-pc = v-slt-pc.
    10524           end.
    10525        end.
    10526        run check-rate no-error.
    10527        if error-status :error then message error-status:error error-status :get-message(1)  skip 3.
    10528        run full-recount no-error.
    10529        if error-status :error then message error-status:error error-status :get-message(1)  skip 4 .
    10530         display loc-sum-rubl
    10531                 loc-sum-base
    10532                 loc-sum-cli
    10533                 loc-exch-code
    10534                 with frame dialog-frame .
    10535           run openbr in this-procedure  .
    10536     end.
    10537   run ui-on .
    10538   end.
    10539   end procedure.
    10540   procedure check-update:
    10541   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10542   assign frame  dialog-frame cycle-day loc-date-ship  loc-service date-sale-1 date-sale-2 loc-cli-out-doc.
    10543     define buffer ch-ord-line for tmp#zakaz.
    10544     define buffer ch-goods    for ub.goods.
    10545     define buffer ch-units    for ub.units.
    10546     define variable p-same-price as logical no-undo.
    10547     define variable v-insalepr   as logical   no-undo .
    10548     for each ch-ord-line :
    10549         find first ch-goods where ch-goods.artic     = ch-ord-line.artic     and
    10550                                   ch-goods.prod-type = ch-ord-line.prod-type and
    10551                                   ch-goods.prod-code = ch-ord-line.prod-code no-lock.
    10552         find ch-units where ch-units.unit-name = ch-goods.unit-base no-lock.
    10553   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    10555     (input  ch-ord-line.obj-type
    10556     ,input  ch-ord-line.obj-code
    10557     ,input  ch-ord-line.artic
    10558     ,input  ch-ord-line.prod-type
    10559     ,input  ch-ord-line.prod-code
    10560     ,input  'insalepr=request':U
    10561     ,output v-insalepr
    10562     )  .
    10563         if v-insalepr = true then do:
    10564            message "Товар " ch-goods.artic " " ch-goods.prod-type " " ch-goods.prod-code
    10565                    " принимается по продажной цене. Смена цен недопустима."
    10566                    view-as alert-box error.
    10567            return error.
    10568         end.
    10569     end.
    10570   end.
    10571   end procedure.
    10572   procedure disp-exch:
    10573   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10574   display
    10575    loc-exch-rate
    10576    loc-exch-scale
    10577    loc-base-rate
    10578    loc-base-scale
    10579    with frame dialog-frame.
    10580    end.
    10581   end procedure.
    10582   procedure r-acc-proc :
    10583   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10584   run check-update no-error.
    10585   if error-status:error then return no-apply.
    10586   run check-exch no-error.
    10587   if error-status:error then return no-apply.
    10588   g#log = yes.
    10589   message "Подставить БИРЖЕВЫЕ курсы базовой валюты :" base-abbr "и валюты поставщика :"
    10590                    ub.currency.curr-abbr "на дату растаможивания ?"
    10591                     view-as alert-box question buttons ok-cancel
    10592                     update g#log.
    10593   if g#log <> true then return no-apply.
    10594   find last ub.curr-accnt where ub.curr-accnt.curr-code = base-code
    10595           use-index pi no-lock no-error.
    10596   if not available ub.curr-accnt then do:
    10597     message "На эту дату неизвестен курс базовой валюты.".
    10598     apply "entry" to loc-base-rate in frame dialog-frame.
    10599     return no-apply.
    10600   end.
    10601        loc-base-rate  = ub.curr-accnt.exch-rate .
    10602        loc-base-scale = ub.curr-accnt.exch-scale.
    10603        loc-base-rate:screen-value  = string(curr-accnt.exch-rate) .
    10604        loc-base-scale:screen-value = string(curr-accnt.exch-scale).
    10605   display loc-base-rate
    10606           loc-base-scale
    10607        with frame d-in-doc.
    10608   find last ub.curr-accnt where ub.curr-accnt.curr-code = input loc-exch-code
    10609              use-index pi no-lock no-error.
    10610   if not available ub.curr-accnt then do:
    10611     message "На дату "  + " неизвестен курс валюты поставщика.".
    10612     apply "entry" to loc-exch-rate.
    10613     return no-apply.
    10614   end.
    10615    loc-exch-rate  = ub.curr-accnt.exch-rate .
    10616    loc-exch-scale = ub.curr-accnt.exch-scale.
    10617    loc-exch-rate:screen-value  = string(curr-accnt.exch-rate ).
    10618    loc-exch-scale:screen-value = string(curr-accnt.exch-scale).
    10619   disp loc-exch-rate
    10620        loc-exch-scale with frame d-in-doc.
    10621   run check-rate.
    10622   run ui-on.
    10623   run disp-exch.
    10624   end.
    10625   end procedure.
    10626   procedure ui-on :
    10627    do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10628   run vg-TOG-type.
    10629   hide loc-art in frame dialog-frame
    10630    loc-name
    10631    loc-code .
    10632    loc-art  = "" .
    10633   if g#type <> 'ОФ':U then do:
    10634       if curclivalue <> "no" then do:
    10635               if loc-exch-code <> 0 then enable r-acc loc-exch-rate loc-exch-scale with frame dialog-frame.
    10636               enable loc-exch-code r-currency with frame dialog-frame.
    10637       end.
    10638       else do:
    10639             hide r-acc r-currency in frame dialog-frame.
    10640       end.
    10641       enable loc-base-rate loc-base-scale with frame dialog-frame.
    10642       if curclivalue <> "no" then do:
    10643               find ub.currency where ub.currency.curr-code = loc-exch-code no-lock no-error.
    10644               if available ub.currency then disp ub.currency.curr-abbr with frame dialog-frame.
    10645                                     else disp ? @ ub.currency.curr-abbr with frame dialog-frame.
    10646       end.
    10647       else DO:
    10648         hide ub.currency.curr-abbr in frame dialog-frame.
    10649       END.
    10650   if multdtypvalue <> "no"
    10651       then enable  vat_type slt_type with frame dialog-frame.
    10652       else disable  vat_type slt_type with frame dialog-frame.
    10653   end.
    10654   end.
    10655   end procedure .
    10656   procedure paytype-leave-proc:
    10657   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10658   define buffer paytype-clients for ub.pay-type.
    10659       if g#type <> 'ОФ':U then do:
    10660         assign  frame dialog-frame  paytype .
    10661               if paytype <> ? or paytype <> 0 then do:
    10662                       find first paytype-clients where paytype = paytype-clients.obj-code  no-lock no-error.
    10663                       if error-status :error then error-status :error = false .
    10664                       if avail paytype-clients then do:
    10665                             loc-pay-type = paytype-clients.obj-name .
    10666                             loc-pay-type:screen-value  = paytype-clients.obj-name .
    10667                             display  paytype loc-pay-type with frame dialog-frame.
    10668                             enable   paytype loc-pay-type b-chg b-producer b-alt-post with frame dialog-frame.
    10669                       end.
    10670                       else do:
    10671                             find first paytype-clients where paytype = v-cntxp-in-pay no-lock no-error.
    10672                             if available paytype-clients then do:
    10673                               assign
    10674                                 paytype = v-cntxp-in-pay
    10675                                 loc-pay-type = paytype-clients.obj-name
    10676                                 .
    10677                                 if available shar_ord-doc then
    10678                                    shar_ord-doc.pay-code = v-cntxp-in-pay
    10679                               .
    10680                               display  paytype loc-pay-type with frame dialog-frame.
    10681                             end.
    10682                       end.
    10683               end.
    10684       end.
    10685   end.
    10686   end procedure.
    10687   procedure  r-paytype-choose :
    10688   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10689   define variable rid-list    as  character no-undo .
    10690   define buffer paytype# for ub.pay-type.
    10691     run ref/paytype.w (input parparentproc, input "b-sel", output  rid-list).
    10692     assign rep-rec3 = integer(rid-list) no-error.
    10693     find first paytype# where recid(paytype#) = rep-rec3 no-lock no-error.
    10694     if avail paytype# then
    10695       assign
    10696         paytype = paytype#.obj-code
    10697         loc-pay-type= paytype#.obj-name
    10698         .
    10699     enable  loc-pay-type paytype  with frame dialog-frame.
    10700     display loc-pay-type paytype with frame dialog-frame.
    10701   end.
    10702   end procedure.
    10703   procedure local-conf-rd:
    10704   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10705   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10706   empty temp-table thbjattr_thbj-attr.
    10707   run adm/shattri.p (
    10708      input "get":U
    10709     ,input ''
    10710     ,input 0
    10711     ,input 'nakl-glob':U
    10712     ,input  ""
    10713     ,output v-value-character
    10714     ,output v-value-date
    10715     ,output v-value-decimal
    10716     ,output v-value-integer
    10717     ,output v-value-logical
    10718     ,output par-type
    10719     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10720     ) no-error .
    10721   for each thbjattr_thbj-attr :
    10722     if thbjattr_thbj-attr.prop-code = 'multdtyp':U then multdtypvalue = string (thbjattr_thbj-attr.property-value-logical) .
    10723     if thbjattr_thbj-attr.prop-code = 'curcli':U   then curclivalue   = string (thbjattr_thbj-attr.property-value-logical) .
    10724   end.
    10725   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10726   empty temp-table thbjattr_thbj-attr.
    10727   run adm/shattri.p (
    10728      input "get":U
    10729     ,input ''
    10730     ,input 0
    10731     ,input 'ord-global':U
    10732     ,input  ""
    10733     ,output v-value-character
    10734     ,output v-value-date
    10735     ,output v-value-decimal
    10736     ,output v-value-integer
    10737     ,output v-value-logical
    10738     ,output par-type
    10739     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10740     ) no-error .
    10741   for each thbjattr_thbj-attr :
    10742     if thbjattr_thbj-attr.prop-code = 'ordshipd':U then v-dayship = thbjattr_thbj-attr.property-value-integer .
    10743   end.
    10744   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10745   empty temp-table thbjattr_thbj-attr.
    10746   run adm/shattri.p (
    10747      input "get":U
    10748     ,input v-cntxt-obj-type
    10749     ,input v-cntxt-obj-code
    10750     ,input 'contr-in':U
    10751     ,input  ""
    10752     ,output v-value-character
    10753     ,output v-value-date
    10754     ,output v-value-decimal
    10755     ,output v-value-integer
    10756     ,output v-value-logical
    10757     ,output par-type
    10758     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10759     ) no-error .
    10760   for each thbjattr_thbj-attr :
    10761     if thbjattr_thbj-attr.prop-code = 'contr-in-income':U then v-mastc = thbjattr_thbj-attr.property-value-logical .
    10762   end.
    10763   empty temp-table thbjattr_thbj-attr.
    10764   if v-mastc = true then varcontract = "yes"  .
    10765   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10766     (input  'edoc-nn'
    10767     ,input  ''
    10768     ,input  ''
    10769     ,input  0
    10770     ,input  ''
    10771     ,input  ''
    10772     ,input  ''
    10773     ,input  no
    10774     ,output par-is-edoc-nn
    10775     ,output par-type
    10776     ) no-error .
    10777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10778     (input  'is-edi'
    10779     ,input  ''
    10780     ,input  ''
    10781     ,input  0
    10782     ,input  ''
    10783     ,input  ''
    10784     ,input  ''
    10785     ,input  no
    10786     ,output par-is-edi
    10787     ,output par-type
    10788     ) no-error .
    10789   assign
    10790   is-edoc-nn = lookup(par-is-edoc-nn, "true,yes":U) > 0
    10791   is-edi     = lookup(par-is-edi,     "true,yes":U) > 0
    10792   .
    10793   end.
    10794   end procedure.
    10795   procedure mode-on :
    10796   do on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
    10797     define buffer buf_contract for ub.contract  .
    10798     define buffer buf_sysconf for ub.sysconf  .
    10799   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10801     (input  v-cntxt-obj-type
    10802     ,input  v-cntxt-obj-code
    10803     ,output to-day
    10804     )  .
    10805     enable b-delivery with frame dialog-frame .
    10806     if g#type = 'ОФ':U then do:
    10807         t-auto = true .
    10808         display t-auto with frame  dialog-frame.
    10809     end.
    10810     if g#type <> 'ОФ':U then do:
    10811         t-auto = true .
    10812         display t-auto with frame  dialog-frame.
    10813     end.
    10814       if t-action = "add":u then do:
    10815         find first buf_sysconf no-lock where buf_sysconf.host-code = v-cntxt-host-code-obj .
    10816   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
