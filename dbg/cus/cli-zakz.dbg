     4664   ON CHOOSE OF r-wrkr IN FRAME Dialog-Frame
     4665   DO:
     4666      run proc-r-wrkr in this-procedure .
     4667   END.
     4668   ON LEAVE OF wrkr IN FRAME Dialog-Frame
     4669   DO:
     4670   run leave-proc-wrkr in this-procedure .
     4671   END.
     4672   procedure leave-proc-wrkr :
     4673    do
     4674    on error undo, return error return-value
     4675    :
     4676     Assign frame dialog-frame wrkr .
     4677     def buffer wrkr-clients for ub.clients.
     4678     if wrkr <> ? OR wrkr <> 0 THEN DO:
     4679       find first wrkr-clients WHERE wrkr-clients.obj-type = 'чел':U  AND wrkr = wrkr-clients.obj-code  No-LOCK No-ERROR.
     4680       if error-status :error then error-status :error = false .
     4681       if avail wrkr-clients Then DO:
     4682             wrkr-name = wrkr-clients.obj-name .
     4683             wrkr-name:screen-value  = wrkr-clients.obj-name .
     4684             Display  wrkr wrkr-name with frame dialog-frame.
     4685             Enable wrkr wrkr-name b-producer B-Alt-post with frame dialog-frame.
     4686           End.
     4687           Else DO:
     4688             Assign
     4689             wrkr-name:screen-value = ""
     4690             wrkr:screen-value = ?
     4691             .
     4692             apply "entry" to wrkr in frame dialog-frame.
     4693           End.
     4694       End.
     4695   end.
     4696   end procedure.
     4697   ON  RETURN OF wrkr IN FRAME Dialog-Frame
     4698   DO:
     4699       if wrkr = ? then run proc-r-wrkr in this-procedure .
     4700       run apply-focus-next-entry in this-procedure  (input  wrkr:handle ) .
     4701       return no-apply .
     4702   END.
     4703   ON MOUSE-SELECT-DBLCLICK OF wrkr IN FRAME dialog-frame
     4704   DO:
     4705     apply "choose" to r-wrkr in frame dialog-frame.
     4706     apply "entry" to wrkr in frame dialog-frame.
     4707       return no-apply .
     4708   end.
     4709   Procedure proc-r-wrkr :
     4710    do
     4711    on error undo, return error return-value
     4712    :
     4713     define variable rid-list    as  char no-undo .
     4714     def buffer wrkr#clients for ub.clients.
     4715       run ref/cli-all.w
     4716       ( input parParentProc,
     4717         input "b-sel",
     4718         input 'чел':U,
     4719         input ?,
     4720         input ?,
     4721         input ref-rec ,
     4722         input ",,,,,,NO"   ,
     4723         input "lock-cli-type",
     4724         output  rid-list
     4725         ) .
     4726       Assign
     4727         rep-rec2 = integer(rid-list)
     4728         ref-rec = integer(rid-list)
     4729         no-error.
     4730       find first wrkr#clients WHERE recid(wrkr#clients) = rep-rec2 No-LOCK No-ERROR.
     4731       if avail wrkr#clients then
     4732           Assign
     4733               wrkr = wrkr#clients.obj-code
     4734               wrkr-name = wrkr#clients.obj-name .
     4735       Enable  wrkr wrkr-name with frame dialog-frame .
     4736       Display wrkr wrkr-name with frame dialog-frame .
     4737   end.
     4738   end procedure.
