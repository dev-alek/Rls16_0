     5207       "$Workfile$"
     5208       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5209       "Интерфейсный элемент" self :name  skip
     5210       "Тип" self :type  skip
     5211       "Процедура" this-procedure :file-name skip
     5212       view-as alert-box .
     5213   end.
     5214   else do:
     5215     apply "entry":u to self  .
     5216     if focus :handle <> self :handle  then do:
     5217       return no-apply .
     5218     end.
     5219   end.
     5220     run show-protocol in this-procedure .
     5221   END.
