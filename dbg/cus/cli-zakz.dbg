     4155   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4156   procedure proc-ord-code :
     4157   define input  parameter  p-type as character no-undo .
     4158   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     4159   define input  parameter  v-cntxt-obj-type as character no-undo .
     4160   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     4161   define input  parameter  p-i-doc    as character no-undo .
     4162   define output parameter  p-ord-doc  as character no-undo .
     4163   define variable          v-idop     as character no-undo .
     4164     do
     4165     on error undo, return error return-value
     4166     :
     4167   case p-type :
     4168       when "main-no-ver" then do:
     4169         if  (v-cntxt-db-num <> 0) then
     4170           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     4171         else
     4172           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     4173       end.
     4174       when "main" then do:
     4175             do while true:
     4176             if  (v-cntxt-db-num <> 0) then
     4177               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     4178             else
     4179               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     4180             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     4181             End.
     4182       end.
     4183       when "chip" then do:
     4184         assign
     4185           v-idop = p-i-doc .
     4186         do while true :
     4187           if index (v-idop , ".") = 0 then
     4188             v-idop  = replace (v-idop , "-", "-1.").
     4189           else
     4190             v-idop  =
     4191             substring (v-idop , 1, index (v-idop, "-")) +
     4192             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     4193             substring (v-idop, index (v-idop, ".")).
     4194           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     4195         end.
     4196         assign
     4197           p-ord-doc = v-idop.
     4198       end.
     4199   end case.
     4200     end.
     4201   end procedure.
