     8716                           ord-qnty = ord-qnty + tmp#zakaz.qnty
     8717                           ord-sum-cli = ord-sum-cli + ( tmp#zakaz.qnty * tmp#zakaz.price-cli )
     8718                           .
     8719                       end.
     8720                       else do:
