     7947   def var sort-labelbr-docs   as character no-undo .
     7948   def var sort-clmnbr-docs    as handle    no-undo .
     7949   def var cur-clmnbr-docs     as handle    no-undo .
     7950   def var cur-clmn-locbr-docs as integer   no-undo .
     7951   def var re-querybr-docs     as logical   initial no no-undo .
     7952   on start-search, ctrl-o of br-docs in frame dialog-frame do:
     7953      run sort-brbr-docs
     7954        (input (if available shar_ord-line
     7955                then recid(shar_ord-line)
     7956                else ?
     7957               )
     7958        ).
     7959   end.
     7960   PROCEDURE sort-brbr-docs :
     7961     define input parameter p-recid as recid no-undo .
     7962     if re-querybr-docs = no then do:
     7963       assign
     7964          cur-clmnbr-docs = br-docs:current-column in frame dialog-frame
     7965       .
     7966       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     7967       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     7968         assign
     7969            sort-labelbr-docs = ""
     7970            sort-clmnbr-docs = ?
     7971         .
     7972        end.
     7973        else do:
     7974          assign
     7975            sort-labelbr-docs = cur-clmnbr-docs:label
     7976            sort-clmnbr-docs  = cur-clmnbr-docs
     7977            sort-clmnbr-docs:column-fgcolor = 4
     7978          .
     7979        end.
     7980      end.
     7981     assign
     7982       cur-clmn-locbr-docs = 1
     7983     .
     7984     def var column-handle as handle no-undo .
     7985     column-handle = br-docs:first-column.
     7986     do while valid-handle(column-handle) :
     7987       if column-handle = cur-clmnbr-docs then do:
     7988         leave .
     7989       end.
     7990       column-handle = column-handle:NEXT-COLUMN.
     7991       assign
     7992         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     7993       .
     7994     end.
     7995     case sort-labelbr-docs:
     7996           when 'ш! '  then DO:   assign     sort-column-name = "tmp#zakaz.prt-ok"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.prt-ok .   . END.
     7997           when 'Артикул! '  then DO:   assign     sort-column-name = "tmp#zakaz.artic"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.artic .   . END.
     7998           when 'Название! '  then DO:   assign     sort-column-name = "tmp#zakaz.gds-name"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.gds-name .   . END.
     7999           when 'Е.и.!пост'  then DO:   assign     sort-column-name = "tmp#zakaz.unit-cli"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.unit-cli .   . END.
     8000           when 'Заказ!ед.пост'  then DO:   assign     sort-column-name = "tmp#zakaz.cli-qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.cli-qnty .   . END.
     8001           when 'Последн.цена!пост-ка'  then DO:   assign     sort-column-name = "tmp#zakaz.price-cli"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.price-cli .   . END.
     8002           when 'Сумма!ед.пост'  then DO:   assign     sort-column-name = "tmp#zakaz.sum-cli"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.sum-cli .   . END.
     8003           when 'Артикул!поставщика'  then DO:   assign     sort-column-name = "tmp#zakaz.cli-art"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.cli-art .   . END.
     8004           when 'Е.и.!баз.'  then DO:   assign     sort-column-name = "tmp#zakaz.unit-base"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.unit-base .   . END.
     8005           when 'Заказ! '  then DO:   assign     sort-column-name = "tmp#zakaz.qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.qnty .   . END.
     8006           when 'Цена!(руб)'  then DO:   assign     sort-column-name = "tmp#zakaz.price-rubl"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.price-rubl .   . END.
     8007           when 'Сумма!(руб) '  then DO:   assign     sort-column-name = "tmp#zakaz.sum-rubl"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.sum-rubl .   . END.
     8008           when 'Темп продаж!при расчете'  then DO:   assign     sort-column-name = "tmp#zakaz.temp-rash"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.temp-rash .   . END.
     8009           when 'Объем продаж!за период'  then DO:   assign     sort-column-name = "tmp#zakaz.qnty-sale"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.qnty-sale .   . END.
     8010           when 'Кол-во остатки!при расчете'  then DO:   assign     sort-column-name = "tmp#zakaz.qnty-stk"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.qnty-stk .   . END.
     8011           when 'Минимальный!запас'  then DO:   assign     sort-column-name = "tmp#zakaz.min-stock"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.min-stock .   . END.
     8012           when 'x! '  then DO:   assign     sort-column-name = "(if tmp#zakaz.cancel-date = ? then '' else '*' )"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY (if tmp#zakaz.cancel-date = ? then '' else '*' ) .   . END.
     8013           when '№!п/п'  then DO:   assign     sort-column-name = "tmp#zakaz.line-num"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.line-num .   . END.
     8014           when 'Код!товара'  then DO:   assign     sort-column-name = "tmp#zakaz.gds-code"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.gds-code .   . END.
     8015           when '*! '  then DO:   assign     sort-column-name = "tmp#zakaz.local-mark"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.local-mark .   . END.
     8016           when 'Запрошено!количество'  then DO:   assign     sort-column-name = "tmp#zakaz.order-cli-qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.order-cli-qnty .   . END.
     8017           when 'Запрошена!цена'  then DO:   assign     sort-column-name = "tmp#zakaz.ord-dec1"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.ord-dec1 .   . END.
     8018           when 'Расcчитн.!кол-во'  then DO:   assign     sort-column-name = "tmp#zakaz.initial-qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.initial-qnty .   . END.
     8019           when 'Мин.!остаток'  then DO:   assign     sort-column-name = "tmp#zakaz.min-stock-old"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.min-stock-old .   . END.
     8020           when 'Тов.!в пути'  then DO:   assign     sort-column-name = "tmp#zakaz.gds-way"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code BY tmp#zakaz.gds-way .   . END.
     8021       otherwise do:
     8022         assign
     8023           sort-column-name = ""
     8024         .
     8025         open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code by tmp#zakaz.line-num .
     8026         if sort-labelbr-docs <> "" then do:
     8027           assign
     8028             cur-clmnbr-docs:column-fgcolor = 0
     8029           .
     8030         end.
     8031         assign
     8032           cur-clmn-locbr-docs = ?
     8033         .
     8034       end.
     8035     end case.
     8036     if p-recid <> ? then do:
     8037       reposition br-docs to recid p-recid no-error.
     8038       apply "value-changed" to br-docs in frame dialog-frame.
     8039     end.
     8040     apply "entry" to br-docs in frame dialog-frame.
     8041   END PROCEDURE.
     8042   procedure re-open-query-srt-clmnbr-docs:
     8043   if cur-clmnbr-docs = ? then do:
     8044      open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = loc-ord-num ,each tmp#zakaz where tmp#zakaz.artic = shar_ord-line.artic and tmp#zakaz.prod-type = shar_ord-line.prod-type and tmp#zakaz.prod-code = shar_ord-line.prod-code by tmp#zakaz.line-num .
     8045   end.
     8046   else do:
     8047      assign re-querybr-docs = yes.
     8048      run sort-brbr-docs
     8049        (input (if available shar_ord-line
     8050                then recid(shar_ord-line)
     8051                else ?
     8052               )
     8053        ).
     8054      assign re-querybr-docs = no.
     8055   end.
     8056   end.
     8057   main-block:
     8058   do on error   undo main-block, leave main-block
     8059      on end-key undo main-block, leave main-block
     8060      on stop    undo main-block, leave main-block :
     8061     run local-conf-rd no-error.
     8062     if error-status:error then return error.
     8063     run make-obj-list no-error .
     8064     if error-status:error then return error.
     8065         tmp#zakaz.artic:RESIZABLE in browse br-docs =  true .
     8066         tmp#zakaz.gds-name:RESIZABLE in browse br-docs =  true .
     8067     if t-action <> "lkp":u then
     8068       assign
     8069         tmp#zakaz.cli-art   :read-only in browse br-docs =   true
     8070         tmp#zakaz.cli-qnty  :read-only in browse br-docs =  false
     8071         tmp#zakaz.price-cli :read-only in browse br-docs =  false
     8072         no-error .
     8073         if error-status :error then error-status :error = false .
     8074    run mode-on in this-procedure .
     8075     t#query-was-opened = true .
     8076      if not (g#type = 'ОП':U or g#type = 'ОФ':U) then do:
     8077         tmp#zakaz.temp-rash:visible in browse br-docs = false .
     8078         tmp#zakaz.qnty-stk:visible  in browse br-docs = false .
     8079      end.
     8080    v-fl = true .
     8081    if t-action = "add":u  then  run enable_ui .
     8082    if t-action <> "lkp":u then  run ui-on     .
     8083    run edoc-edi-proc in this-procedure .
     8084   run init-browse-p  in this-procedure .
     8085   apply "VALUE-CHANGED" to br-docs in frame dialog-frame.
     8086   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8087   DEF VAR cur-clmn-numbr-docs as INT EXTENT 25 no-undo.
     8088   DEF VAR varmvibr-docs       as INT no-undo.
     8089   DEF VAR varmvjbr-docs       as INT no-undo.
     8090   DEF VAR varmvkbr-docs       as INT no-undo.
     8091   DEF VAR varmvlbr-docs       as INT no-undo.
     8092   DEF VAR move-elementbr-docs as INT no-undo.
     8093   def var jjbr-docs           as int no-undo.
     8094   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     8095     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     8096   END.
     8097   RUN start-mv-clmnbr-docs.
     8098   PROCEDURE start-mv-clmnbr-docs:
     8099   def var old-session as logical no-undo.
     8100      old-session = SESSION:IMMEDIATE-DISPLAY.
     8101      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     8102          IF  true = true  THEN DO:
     8103      DO jjbr-docs = NUM-ENTRIES(v-order-column) TO 1 BY -1:
     8104        RUN re-move-clmnbr-docs ( cur-clmn-numbr-docs[INTEGER(ENTRY (jjbr-docs, v-order-column))] , 1).
     8105      END.
     8106          END.
     8107      SESSION:IMMEDIATE-DISPLAY = old-session.
     8108   END.
     8109   ON ctrl-cursor-right OF BROWSE br-docs do:
     8110     RUN re-move-clmnbr-docs ( 1, 25).
     8111   END.
     8112   ON ctrl-cursor-left OF BROWSE br-docs do:
     8113     RUN re-move-clmnbr-docs (25, 1).
     8114   END.
     8115   PROCEDURE re-move-clmnbr-docs:
     8116     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     8117     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     8118     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     8119       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     8120     END.
     8121     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME dialog-frame then.
     8122     if source-column > target-column THEN
     8123     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     8124       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     8125           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     8126             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     8127           END.
     8128       END.
     8129     END.
     8130     ELSE
     8131     DO varmvjbr-docs = source-column + 1 to target-column:
     8132       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     8133         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     8134           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     8135         END.
     8136       END.
     8137     END.
     8138     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     8139       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     8140     END.
     8141   END PROCEDURE.
     8142   PROCEDURE ch-clmnbr-docs:
     8143     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     8144     if cur-clmn-loc <= 1 then do:
     8145       return .
     8146     end.
     8147     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     8148       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     8149     END.
     8150     RUN re-move-clmnbr-docs (cur-clmn-loc, 1).
     8151   END PROCEDURE.
     8152   PROCEDURE mv-brw-defaultbr-docs:
     8153   def var old-session as logical no-undo.
     8154     old-session = SESSION:IMMEDIATE-DISPLAY.
     8155     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     8156     do varmvlbr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     8157       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     8158     END.
     8159     RUN start-mv-clmnbr-docs.
     8160     SESSION:IMMEDIATE-DISPLAY = old-session.
     8161   END PROCEDURE.
     8162   .
     8163   if tog-type = 4 then disable tog-type with frame dialog-frame .
     8164      else  v-ok = tog-type:disable("О") in frame dialog-frame .
     8165     if t-action = "add":u then do:
     8166         if g#type = 'ОФ':U then do:
     8167            frame dialog-frame:visible = true .
     8168              wait-for go of frame dialog-frame focus  wrkr .
     8169         end.
     8170         else do:
     8171              wait-for go of frame dialog-frame focus loc-cli-code.
     8172         end.
     8173     end.
     8174     else do:
     8175       WAIT-FOR GO OF FRAME dialog-frame focus br-docs .
     8176     end.
     8177   end.
     8178   run disable_ui  in this-procedure  .
     8179   procedure pp-1 :
     8180    do
     8181    on error undo, return error return-value
     8182    :
     8183     find current shar_ord-line  no-lock  no-error .
     8184     if not avail shar_ord-line then return.
     8185     find first tmp#zakaz no-lock    where
     8186                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8187                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8188                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8189     if not avail tmp#zakaz   then do:
     8190          message error-status :get-message(1) .
     8191          return.
     8192          end.
     8193    run cus/cli-othr.w (
     8194    input tmp#zakaz.artic,
     8195    input tmp#zakaz.prod-type,
     8196    input tmp#zakaz.prod-code,
     8197    input buf-cli.obj-type ,
     8198    input buf-cli.obj-code ).
     8199    end.
     8200   end procedure.
     8201   procedure pp-2 :
     8202    do
     8203    on error undo, return error return-value
     8204    :
     8205     find current shar_ord-line  no-lock  no-error .
     8206     if not avail shar_ord-line then return.
     8207     find first tmp#zakaz no-lock    where
     8208                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8209                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8210                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8211     if not avail tmp#zakaz   then do:
     8212          message error-status :get-message(1) .
     8213          return.
     8214          end.
     8215       run ref/showcli.p
     8216       (input parparentproc
     8217       ,input tmp#zakaz.prod-type
     8218       ,input tmp#zakaz.prod-code
     8219       ).
     8220    end.
     8221   end procedure.
     8222   procedure proc-d-notes :
     8223    do
     8224    on error undo, return error return-value
     8225    :
     8226    find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     8227      notes = shar_ord-doc.ps.
     8228       run gbl/d-prompt.w (
     8229           'title=примечание\'
     8230         + 'type=editor\'
     8231         + 'fillin_width=96\'
     8232         + 'fillin_height=15\'
     8233         , input-output notes).
     8234         if return-value = 'false':u
     8235         then do:
     8236           return .
     8237         end.
     8238       if shar_ord-doc.ps <> notes then do:
     8239         do on stop undo, return error:
     8240           find shar_ord-doc where recid (shar_ord-doc) = doc-rec exclusive-lock no-error .
     8241           shar_ord-doc.ps = notes.
     8242         end.
     8243       end.
     8244       find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     8245    end.
     8246   end procedure.
     8247   procedure proc-del4 :
     8248    do
     8249    on error undo, return error return-value
     8250    :
     8251      find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     8252      if available shar_ord-doc
     8253      and (( is-edoc-nn and ( shar_ord-doc.ord-int1 = integer('3':U) or shar_ord-doc.ord-int1 = integer('4':U)))
     8254       or  ( is-edi     and   shar_ord-doc.ord-int1 = integer('3':U)))
     8255       then do:
     8256          message "Заказ по системе EDOC/EDI не должен корректироватся в этом статусе. Только НОВЫЙ желтый! " view-as alert-box information .
     8257          return .
     8258       end.
     8259   define variable ii as integer init 0 no-undo.
     8260     find current shar_ord-line  no-lock  no-error .
     8261     if not avail shar_ord-line then return.
     8262     find first tmp#zakaz no-lock    where
     8263                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8264                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8265                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8266     if not avail tmp#zakaz   then do:
     8267          message error-status :get-message(1) .
     8268          return.
     8269          end.
     8270      if not avail tmp#zakaz then do:
     8271      message "Не выбрана строка" view-as alert-box information .
     8272      return error.
     8273      end.
     8274      if avail tmp#zakaz then do:
     8275         message "Удалять товар " + tmp#zakaz.artic + ' ' +   tmp#zakaz.gds-name + " из заказа ? " skip "Продолжать?"
     8276              view-as alert-box question buttons ok-cancel update g#log.
     8277              if not g#log then return no-apply.
     8278               do transaction :
     8279                   find first shar_ord-line  exclusive-lock   where
     8280                       shar_ord-line.doc-code        = loc-ord-num    and
     8281                       shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8282                       shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8283                       shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8284                   delete  shar_ord-line  no-error.
     8285                   for each tmp#zakaz-dtl where
     8286                       tmp#zakaz-dtl.doc-code        = loc-ord-num    and
     8287                       tmp#zakaz-dtl.prod-type       = tmp#zakaz.prod-type and
     8288                       tmp#zakaz-dtl.prod-code       = tmp#zakaz.prod-code and
     8289                       tmp#zakaz-dtl.artic           = tmp#zakaz.artic   :
     8290                       delete tmp#zakaz-dtl .
     8291                   end.
     8292                   delete  tmp#zakaz     no-error.
     8293               end.
     8294         run openbr  in this-procedure  .
     8295         end.
     8296    end.
     8297   end procedure.
     8298   procedure proc-menu-item-m_del1 :
     8299    do
     8300    on error undo, return error return-value
     8301    :
     8302   find first shar_ord-doc where recid(shar_ord-doc) = doc-rec no-lock no-error.
     8303   if available shar_ord-doc
     8304   and (( is-edoc-nn and ( shar_ord-doc.ord-int1 = integer('3':U) or shar_ord-doc.ord-int1 = integer('4':U)))
     8305    or  ( is-edi     and   shar_ord-doc.ord-int1 = integer('3':U)))
     8306   then do:
     8307       message "Заказ по системе EDOC/EDI не должен корректироватся в этом статусе. Только НОВЫЙ желтый! " view-as alert-box information .
     8308       return .
     8309   end.
     8310   define variable ii as integer init 0 no-undo.
     8311      t-ret =  session:set-wait-state("general") .
     8312      for each    tmp#zakaz  where
     8313                  tmp#zakaz.qnty = 0  or
     8314                  tmp#zakaz.qnty = ? :
     8315          ii = ii + 1.
     8316               do transaction :
     8317                   find first shar_ord-line  exclusive-lock   where
     8318                       shar_ord-line.doc-code        = loc-ord-num    and
     8319                       shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8320                       shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8321                       shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8322                   delete  shar_ord-line  no-error.
     8323                   for each tmp#zakaz-dtl where
     8324                       tmp#zakaz-dtl.doc-code        = loc-ord-num    and
     8325                       tmp#zakaz-dtl.prod-type       = tmp#zakaz.prod-type and
     8326                       tmp#zakaz-dtl.prod-code       = tmp#zakaz.prod-code and
     8327                       tmp#zakaz-dtl.artic           = tmp#zakaz.artic   :
     8328                       delete tmp#zakaz-dtl .
     8329                   end.
     8330                   delete  tmp#zakaz     no-error.
     8331               end.
     8332      end.
     8333      t-ret =  session:set-wait-state("") .
     8334      choice = ?.
     8335      run openbr  in this-procedure  .
     8336      message "Удалено " + string(ii) + " товаров".
     8337    end.
     8338   end procedure.
     8339   procedure proc-b-remove :
     8340    do
     8341    on error undo, return error return-value
     8342    :
     8343   define variable tt-rec as recid no-undo .
     8344     find current shar_ord-line  exclusive-lock  no-error .
     8345     if not avail shar_ord-line then return.
     8346     find first tmp#zakaz no-lock    where
     8347                 shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     8348                 shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     8349                 shar_ord-line.artic           = tmp#zakaz.artic        no-error  .
     8350      if not avail tmp#zakaz   then do:
     8351          message error-status :get-message(1) .
     8352          return.
     8353          end.
     8354    tt-rec = recid (shar_ord-line) .
     8355    if tmp#zakaz.cancel-date = ? then do :
     8356     message "Товар " + tmp#zakaz.artic + ' ' +
     8357      tmp#zakaz.gds-name
     8358      + " больше не будет заказываться у Поставщика " + loc-obj-name + " ! " skip "  Вы уверены ?"
     8359              view-as alert-box question buttons ok-cancel update g#log.
     8360              if not g#log then return no-apply.
     8361       tmp#zakaz.cancel-date = to-day.
     8362       end.
     8363     else do:
     8364       message "Снять отметку с товара " + tmp#zakaz.artic + ' ' +
     8365       tmp#zakaz.gds-name
     8366       + " ? " skip "  Вы уверены ?"
     8367              view-as alert-box question buttons ok-cancel update g#log.
     8368              if not g#log then return no-apply.
     8369       tmp#zakaz.cancel-date = ? .
     8370     end.
     8371    shar_ord-line.cancel-date = tmp#zakaz.cancel-date .
     8372    find current shar_ord-line  no-lock  no-error .
     8373     run openbr  in this-procedure  .
     8374     reposition br-docs to recid tt-rec no-error.
     8375    end.
     8376   end procedure.
     8377   procedure proc-b-exit :
     8378    do
     8379    on error undo, return error return-value
     8380    :
     8381   define variable t-sum like tmp#zakaz.qnty no-undo .
     8382   define variable ord-qnty    as decimal    no-undo .
     8383   define variable ord-sum-cli as decimal    no-undo .
     8384   define variable k           as integer    no-undo .
     8385   define variable p-nabor     as logical    no-undo .
     8386   define variable v-list-new  as character  no-undo .
     8387   define buffer buf_contract for ub.contract.
     8388   next-prev = ?.
     8389   assign frame dialog-frame tog-type cycle-day doc-date
     8390   .
     8391   if tog-type = 1 and cycle-day  = 0 then do:
     8392      message "Внимание ! Задайте количество дней для цикличного заказа !" view-as alert-box .
     8393      return error.
     8394   end.
     8395   run leave-loc-cli-code in this-procedure no-error .
     8396   if error-status :error then do:
     8397       message "Документ будет удален"   view-as alert-box information .
     8398       find first shar_ord-doc  exclusive-lock where shar_ord-doc.doc-code = loc-ord-num  no-error  .
     8399       if available shar_ord-doc then  delete shar_ord-doc.
     8400       return .
     8401   end.
     8402   if ( loc-cli-type = 'маг':U or loc-cli-type = 'скл':U ) and t-action <> "lkp":u then do:
     8403       message "Неправильно задан КОНТРАГЕНТ !" loc-cli-type view-as alert-box.
     8404       return error.
     8405   end.
     8406   run ver-clients  in this-procedure ( input loc-cli-type , input loc-cli-code , output v-err) .
     8407   if  v-err then return error.
     8408   define variable varcontract       as character no-undo .
     8409   define variable varcontract-type  as character no-undo .
     8410   if v-mastc = true then varcontract = "yes"  .
     8411   if v-mastc = true and loc-contract = 0 and
     8412     ( g#type = 'ОП':U or g#type = 'ФП':U )
     8413     then do:
     8414       message "Не задан договор !" view-as alert-box.
     8415       run r-contract-choose no-error .
     8416       if error-status :error then return error.
     8417   end.
     8418   if loc-contract > 0 and ( g#type = 'ОП':U or g#type = 'ФП':U ) then do:
     8419   find first buf_contract no-lock where
     8420              buf_contract.host-code = v-cntxt-host-code-obj and
     8421              buf_contract.contract-code = loc-contract no-error .
     8422       if available buf_contract  then do:
     8423         if loc-exch-code  <> buf_contract.curr-code then do:
     8424           message "Валюта договора не совпадает с валютой заказа !" skip loc-contract view-as alert-box error .
     8425           return error.
     8426         end.
     8427         if loc-cli-code  <> buf_contract.cli-code or
     8428           loc-cli-type  <> buf_contract.cli-type then do:
     8429           message "Плательщик договора не совпадает с Контрагентом заказа !" skip loc-contract view-as alert-box error .
     8430           return error.
     8431         end.
     8432       end.
     8433   end.
     8434   if loc-contract = 0 and ( g#type = 'ОП':U or g#type = 'ФП':U ) and tog-type = 4 then do:
     8435   define buffer buff_ord-doc-attr for ub.ord-doc-attr  .
     8436   define variable ev-exch-rate  as decimal   no-undo .
     8437   define variable ev-exch-scale as decimal   no-undo .
     8438   define variable ev-curr-abbr  as character no-undo .
     8439     for each buff_ord-doc-attr no-lock where
     8440              buff_ord-doc-attr.doc-code   begins  string( loc-ord-num + chr(4) ) and
     8441              buff_ord-doc-attr.attr-code = 'exch-code':U :
     8442           if integer(buff_ord-doc-attr.attr-value) <> loc-exch-code then do:
     8443   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     8445     (input  integer(buff_ord-doc-attr.attr-value)
     8446     ,input  today
