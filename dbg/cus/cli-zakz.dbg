    10896             shar_ord-doc.creid        = v-cntxt-userid
    10897             shar_ord-doc.agnt         = agnt
    10898             shar_ord-doc.boss         = boss
    10899             shar_ord-doc.fact-date   = ?
    10900             shar_ord-doc.pay-code    = paytype
    10901             shar_ord-doc.ship-date   = loc-date-ship
    10902             shar_ord-doc.sum-service = loc-service
    10903             shar_ord-doc.flag_        = false
    10904             shar_ord-doc.status_      = 'новый':U
    10905             shar_ord-doc.wrkr         = wrkr
    10906             shar_ord-doc.host-code    = v-cntxt-host-code-obj
    10907             shar_ord-doc.doc-type     = loc-doc-type
    10908             shar_ord-doc.order-type   = tog-type
    10909             shar_ord-doc.cycle-day    = cycle-day
    10910             shar_ord-doc.pay-day      = pay-day
    10911             shar_ord-doc.obj-type     = loc-store-type
    10912             shar_ord-doc.obj-code     = loc-store-code
    10913             shar_ord-doc.vat-type     = vat_type
    10914             shar_ord-doc.slt-type     = slt_type
    10915             shar_ord-doc.base-rate   =  loc-base-rate
    10916             shar_ord-doc.base-scale  =  loc-base-scale
    10917             shar_ord-doc.cli-qnty    =  loc-cli-qnty
    10918             shar_ord-doc.exch-code   =  loc-exch-code
    10919             shar_ord-doc.exch-rate   =  loc-exch-rate
    10920             shar_ord-doc.exch-scale  =  loc-exch-scale
    10921             shar_ord-doc.out-code    =  loc-out-code
    10922             shar_ord-doc.qnty        =  loc-qnty
    10923             shar_ord-doc.sum-base    =  loc-sum-base
    10924             shar_ord-doc.sum-cli     =  loc-sum-cli
    10925             shar_ord-doc.sum-rubl    =  loc-sum-rubl
    10926             shar_ord-doc.tot-lines   =  loc-tot-lines
    10927             shar_ord-doc.e-method    =  e-method
    10928             shar_ord-doc.date-sale-1  = date-sale-1
    10929             shar_ord-doc.date-sale-2  = date-sale-2
    10930             shar_ord-doc.deliv-type-code    = v-deliv-type-code
    10931             shar_ord-doc.obj-point-code     = v-point-obj-code
    10932             shar_ord-doc.cli-point-code     = v-point-cli-code
    10933             shar_ord-doc.obj-point-db-num   = v-point-obj-db-num
    10934             shar_ord-doc.cli-point-db-num   = v-point-cli-db-num
    10935             shar_ord-doc.transport-host-code    = v-transport-host-code
    10936             shar_ord-doc.transport-cli-type     = v-transport-cli-type
