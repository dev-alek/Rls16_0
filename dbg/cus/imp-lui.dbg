      915   define variable I-Artic AS CHAR NO-UNDO.
      916   define variable I-Name AS CHAR NO-UNDO.
      917   define variable I-Vol AS CHAR NO-UNDO.
      918   define variable I-Prix AS CHAR NO-UNDO.
      919   define variable I-Price AS CHAR NO-UNDO.
      920   define variable I-Eng-Name AS CHAR NO-UNDO.
      921   define variable Var-Dec AS DEC NO-UNDO.
      922   DEFINE var i-grp-code AS integer NO-UNDO.
      923   DEFINE var i-grp-name as char INIT "test"  no-undo.
      924   DEFINE var i-scale as char INIT "_Пустая шкала" no-undo.
      925   DEFINE var i-Cli-type as char INIT "орг"  no-undo.
      926   DEFINE var i-Cli-code as INTEGER INIT 4  no-undo.
      927   DEFINE var i-city as CHAR INIT "FR" no-undo.
