        1   define input  parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Импорт из текстового файла".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure gen-b-code :
       68     define input  parameter type-code like ub.code-range.range-type no-undo .
       69     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       70     do
       71     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       72     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       73     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       74     :
       75       define buffer buf_thbj-attr     for ub.thbj-attr .
       76       define buffer buf_sys-ctrl   for ub.sys-ctrl .
       77       define buffer buf_code-range for ub.code-range .
       78       define variable l-code         as   integer              no-undo .
       79       define variable v-db-num       like ub.db.db-num         no-undo .
       80       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
       81       if type-code = 'sslc':U
       82       or type-code = 'ssgb':U
       83       then do:
       84         message
       85           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
       86           "Обратитесь к администратору системы."
       87           view-as alert-box error .
       88         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
       89       end.
       90       run trg/getpcode.p ( input  type-code
       91                      ,output cfg-param-code
       92                     ).
       93       run get-next-seq( input  type-code,
       94                         output l-code
       95                       ).
       96       find first buf_sys-ctrl no-lock.
       97       if type-code = 'sclc':U
       98       or type-code = 'pglc':U
       99       then do:
      100         assign
      101           v-db-num = 0
      102         .
      103       end.
      104       else do:
      105         assign
      106           v-db-num = buf_sys-ctrl.db-num
      107         .
      108       end.
      109       find first buf_code-range no-lock
      110         where buf_code-range.db-num     = v-db-num
      111           and buf_code-range.range-type = type-code
      112           and buf_code-range.stts       = "a"
      113         use-index stts
      114         no-error .
      115       if available buf_code-range
      116          and l-code <= buf_code-range.last-code
      117          and l-code >= buf_code-range.first-code then do:
      118         assign
      119           p-b-code = l-code
      120         .
      121       end.
      122       else do:
      123         if available buf_code-range
      124            and l-code < buf_code-range.last-code then do:
      125           message
      126             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      127             "Обратитесь к администратору системы."
      128             view-as alert-box error .
      129           undo, return error "sequence":U .
      130         end.
      131         do transaction
      132         on error undo, return error
      133         :
      134           find first buf_thbj-attr exclusive-lock
      135             where buf_thbj-attr.upper-prop-code = 'code-range':U
      136               and buf_thbj-attr.prop-code = cfg-param-code
      137               and buf_thbj-attr.obj-type   = 'БД':U
      138               and buf_thbj-attr.obj-code   = v-db-num
      139             no-error .
      140           if not available buf_thbj-attr then do:
      141             find first buf_thbj-attr exclusive-lock
      142               where buf_thbj-attr.upper-prop-code = 'code-range':U
      143                 and buf_thbj-attr.prop-code = cfg-param-code
      144                 and buf_thbj-attr.obj-type   = ''
      145                 and buf_thbj-attr.obj-code   = 0
      146               no-error .
      147             if not available buf_thbj-attr then do:
      148               if not locked buf_thbj-attr then do:
      149                 message
      150                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      151                   "Обратитесь к администратору системы."
      152                   view-as alert-box error .
      153               end.
      154               undo, return error "config":U .
      155             end.
      156           end.
      157           run get-next-seq( input type-code,
      158                             output l-code
      159                           ).
      160           find first buf_code-range
      161             where buf_code-range.db-num     = v-db-num
      162               and buf_code-range.range-type = type-code
      163               and buf_code-range.stts       = "a"
      164             use-index stts
      165             no-error .
      166           if available buf_code-range
      167           and l-code <= buf_code-range.last-code
      168           and l-code >= buf_code-range.first-code
      169           then do:
      170             assign
      171               p-b-code = l-code
      172             .
      173           end.
      174           else do:
      175             if available buf_code-range then do:
      176               assign
      177                 buf_code-range.stts = "u"
      178               .
      179             end.
      180             find first buf_code-range
      181               where buf_code-range.db-num     = v-db-num
      182                 and buf_code-range.range-type = type-code
      183                 and buf_code-range.stts       = "f"
      184               use-index stts
      185               no-error .
      186             if not available buf_code-range then do:
      187               message
      188                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      189                 "Обратитесь к администратору системы"
      190                 view-as alert-box error .
      191               undo, return error "code-range":U .
      192             end.
      193             assign
      194               buf_code-range.stts           = "a"
      195             .
      196             if buf_code-range.first-code = 1 then do:
      197               run set-seq-cr( input type-code,
      198                               input buf_code-range.first-code
      199                             ).
      200               assign
      201                 p-b-code = 1
      202               .
      203             end.
      204             else do:
      205               run set-seq-cr( input type-code,
      206                               input ( buf_code-range.first-code - 1 )
      207                             ).
      208               run get-next-seq( input type-code,
      209                                 output p-b-code
      210                               ).
      211             end.
      212           end.
      213         end.
      214       end.
      215     end.
      216   end procedure.
      217   procedure get-next-seq :
      218     define input  parameter type-code like ub.code-range.range-type no-undo .
      219     define output parameter next-seq  as   integer                  no-undo .
      220     do
      221     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      222     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      223     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      224     :
      225       case type-code:
      226         when 'bcgb':U then do:
      227           assign
      228             next-seq = next-value(s-bcgb-code, ub)
      229           .
      230         end.
      231         when 'scgb':U then do:
      232           assign
      233             next-seq = next-value(s-scgb-code, ub)
      234           .
      235         end.
      236         when 'sclc':U then do:
      237           assign
      238             next-seq = next-value(s-sclc-code, ub)
      239           .
      240         end.
      241         when 'pglc':U then do:
      242           assign
      243             next-seq = next-value(s-pglc-code, ub)
      244           .
      245         end.
      246         when 'dcgb':U then do:
      247           assign
      248             next-seq = next-value(s-dcgb-code, ub)
      249           .
      250         end.
      251         when 'ctgb':U then do:
      252           assign
      253             next-seq = next-value(s-ctgb-code, ub)
      254           .
      255         end.
      256         when 'drgb':U then do:
      257           assign
      258             next-seq = next-value(s-drgb-code, ub)
      259           .
      260         end.
      261         when 'fmgb':U then do:
      262           assign
      263             next-seq = next-value(s-fmgb-code, ub)
      264           .
      265         end.
      266         when 'pngb':U then do:
      267           assign
      268             next-seq = next-value(s-pngb-code, ub)
      269           .
      270         end.
      271         when 'cagb':U then do:
      272           assign
      273             next-seq = next-value(s-cagb-code, ub)
      274           .
      275         end.
      276         when 'fdgb':U then do:
      277           assign
      278             next-seq = next-value(s-fin-doc, ub)
      279           .
      280         end.
      281       end case.
      282     end.
      283   end procedure.
      284   procedure set-seq-cr :
      285     define input parameter type-code like ub.code-range.range-type no-undo .
      286     define input parameter set-val   like ub.code-range.first-code no-undo .
      287     do
      288     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      289     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      290     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      291     :
      292       case type-code:
      293         when 'bcgb':U then do:
      294           assign
      295             current-value(s-bcgb-code, ub) = set-val
      296           .
      297         end.
      298         when 'scgb':U then do:
      299           assign
      300             current-value(s-scgb-code, ub) = set-val
      301           .
      302         end.
      303         when 'sclc':U then do:
      304           assign
      305             current-value(s-sclc-code, ub) = set-val
      306           .
      307         end.
      308         when 'pglc':U then do:
      309           assign
      310             current-value(s-pglc-code, ub) = set-val
      311           .
      312         end.
      313         when 'dcgb':U then do:
      314           assign
      315             current-value(s-dcgb-code, ub) = set-val
      316           .
      317         end.
      318         when 'ctgb':U then do:
      319           assign
      320             current-value(s-ctgb-code, ub) = set-val
      321           .
      322         end.
      323         when 'drgb':U then do:
      324           assign
      325             current-value(s-drgb-code, ub) = set-val
      326           .
      327         end.
      328         when 'fmgb':U then do:
      329           assign
      330             current-value(s-fmgb-code, ub) = set-val
      331           .
      332         end.
      333         when 'pngb':U then do:
      334           assign
      335             current-value(s-pngb-code, ub) = set-val
      336           .
      337         end.
      338         when 'cagb':U then do:
      339           assign
      340             current-value(s-cagb-code, ub) = set-val
      341           .
      342         end.
      343         when 'fdgb':U then do:
      344           assign
      345             current-value(s-fin-doc, ub) = set-val
      346           .
      347         end.
      348       end case.
      349     end.
      350   end procedure.
      351   procedure new-bcod-gen-code-range :
      352     do
      353     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      354     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      355     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      356     :
      357       define input parameter p-db-num  like ub.db.db-num             no-undo .
      358       define input parameter type-code like ub.code-range.range-type no-undo .
      359       define buffer buf_code-range      for ub.code-range .
      360       define buffer last_code-range     for ub.code-range .
      361       define buffer last-1_code-range   for ub.code-range .
      362       define buffer last-2_code-range   for ub.code-range .
      363       define buffer last-3_code-range   for ub.code-range .
      364       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      365       define variable conf-par       as character no-undo .
      366       define variable par-type       as character no-undo .
      367       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      368       define variable v-cre-cdrg as logical   no-undo .
      369       define variable v-cre-str  as character no-undo .
      370       define variable v-cr1      as integer no-undo .
      371       define variable v-cr2      as integer no-undo .
      372       define variable v-cr3      as integer no-undo .
      373       define variable v-cmax     as integer no-undo .
      374       find first buf_sys-ctrl no-lock .
      375       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      376         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      377                                       ,vss-workfile
      378                                       ,vss-revision
      379                                       ,vss-description
      380                                       ,chr(10)
      381                                       , p-db-num
      382                                      ).
      383       end.
      384       run trg/getpcode.p ( input  type-code
      385                      ,output cfg-param-code
      386                     ).
      387       for each buf_code-range
      388         where buf_code-range.db-num     = -1
      389           and buf_code-range.range-type = type-code
      390           and buf_code-range.stts       = "f"
      391       by buf_code-range.first-code
      392       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      393       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      394       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      395       :
      396         assign
      397           buf_code-range.db-num = p-db-num
      398         .
      399         return .
      400       end.
      401       assign
      402         v-cre-cdrg = TRUE
      403       .
      404       case type-code:
      405         when 'sclc':U
      406         or when 'scgb':U
      407         or when 'pglc':U
      408         then do:
      409           find last last-1_code-range no-lock
      410             where last-1_code-range.range-type = 'sclc':U
      411             no-error .
      412           if available last-1_code-range then do:
      413             v-cr1 = last-1_code-range.last-code.
      414           end.
      415           find last last-2_code-range no-lock
      416             where last-2_code-range.range-type = 'scgb':U
      417             no-error .
      418           if available last-2_code-range then do:
      419             v-cr2 = last-2_code-range.last-code.
      420             end.
      421           find last last-3_code-range no-lock
      422             where last-3_code-range.range-type = 'pglc':U
      423             no-error .
      424           if available last-3_code-range then do:
      425             v-cr3 = last-3_code-range.last-code.
      426           end.
      427           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      428           .
      429           if v-cmax = v-cr1  then do:
      430               find last last_code-range no-lock
      431                 where recid( last_code-range ) = recid( last-1_code-range )
      432                 .
      433             end.
      434           if v-cmax = v-cr2  then do:
      435               find last last_code-range no-lock
      436                 where recid( last_code-range ) = recid( last-2_code-range )
      437                 .
      438             end.
      439           if v-cmax = v-cr3  then do:
      440             find last last_code-range no-lock
      441               where recid( last_code-range ) = recid( last-3_code-range )
      442               .
      443           end.
      444           if last_code-range.last-code + 1 > 99999 then do:
      445             assign
      446               v-cre-cdrg = FALSE
      447             .
      448           end.
      449         end.
      450         when 'bcgb':U
      451         or when 'sslc':U
      452         or when 'ssgb':U
      453         then do:
      454           find last last-1_code-range no-lock
      455             where last-1_code-range.range-type = 'sslc':U
      456             no-error .
      457           if available last-1_code-range then do:
      458             v-cr1 = last-1_code-range.last-code.
      459           end.
      460           find last last-2_code-range no-lock
      461             where last-2_code-range.range-type = 'bcgb':U
      462             no-error .
      463           if available last-2_code-range then do:
      464             v-cr2 = last-2_code-range.last-code.
      465             end.
      466           find last last-3_code-range no-lock
      467             where last-3_code-range.range-type = 'ssgb':U
      468             no-error .
      469           if available last-3_code-range then do:
      470             v-cr3 = last-3_code-range.last-code.
      471           end.
      472           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      473           .
      474           if v-cmax = v-cr1  then do:
      475               find last last_code-range no-lock
      476                 where recid( last_code-range ) = recid( last-1_code-range )
      477                 .
      478             end.
      479           if v-cmax = v-cr2  then do:
      480               find last last_code-range no-lock
      481                 where recid( last_code-range ) = recid( last-2_code-range )
      482                 .
      483             end.
      484           if v-cmax = v-cr3  then do:
      485             find last last_code-range no-lock
      486               where recid( last_code-range ) = recid( last-3_code-range )
      487               .
      488           end.
      489         end.
      490         otherwise do:
      491           find last last_code-range no-lock
      492             where last_code-range.range-type = type-code
      493             no-error .
      494         end.
      495       end case.
      496       if not available last_code-range then do:
      497         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      498                                       ,vss-workfile
      499                                       ,vss-revision
      500                                       ,vss-description
      501                                       , chr(10)
      502                                       , type-code
      503                                      ) .
      504       end.
      505       define variable v-mes0 as character no-undo .
      506       define variable v-param-type0 as character no-undo .
      507       define variable v-value-character0 as INTEGER no-undo .
      508       define variable v-value-date0 as date no-undo .
      509       define variable v-value-decimal0 as decimal no-undo .
      510       define variable v-value-integer0 AS integer no-undo .
      511       define variable v-value-logical0 AS LOGICAL no-undo .
      512       define variable v-tth0 as handle no-undo .
      513       run adm/shattri.p (
      514           input "get":U
      515           ,input  'БД':U
      516           ,input  p-db-num
      517           ,input  'code-range':U
      518           ,input  cfg-param-code
      519           ,output v-value-character0
      520           ,output v-value-date0
      521           ,output v-value-decimal0
      522           ,output v-value-integer0
      523           ,output v-value-logical0
      524           ,output v-param-type0
      525           ,INPUT-OUTPUT table-handle v-tth0
      526           ) no-error .
      527       if error-status :error then do:
      528         delete object v-tth0.
      529         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      530                            , error-status:get-message(1)
      531                            , chr(10)
      532                            , return-value ).
      533         undo, return error v-mes0.
      534       end.
      535       delete object v-tth0.
      536       if v-cre-cdrg = TRUE then do:
      537         create buf_code-range .
      538         assign
      539           buf_code-range.db-num     = p-db-num
      540           buf_code-range.range-type = type-code
      541           buf_code-range.stts       = "f"
      542           buf_code-range.first-code = last_code-range.last-code + 1
      543           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      544           v-cre-str = "Свободный диапазон успешно создан"
      545         .
      546       end.
      547       else do:
      548         assign
      549           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      550                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      551         .
      552       end.
      553     end.
      554     return v-cre-str .
      555   end procedure.
      556   procedure gen-new-code-range-if-neces :
      557     define input parameter v-db-num           like ub.db.db-num             no-undo .
      558     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      559     define input parameter v-cur-code         as   integer                  no-undo .
      560     define input parameter v-g#news           as   logical                  no-undo .
      561     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      562     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      563     do
      564     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      565     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      566     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      567     :
      568       define variable l-code-range-exist as logical   no-undo init false .
      569       define variable v-db-for-send      as character no-undo .
      570       define buffer buf_code-range  for ub.code-range .
      571       define buffer buf1_code-range for ub.code-range .
      572       define buffer buf_db          for ub.db .
      573       find first buf_code-range
      574         where buf_code-range.range-type = v-range-type
      575           and buf_code-range.last-code >= v-cur-code
      576         use-index last-codei
      577         no-error .
      578       if
      579       (
      580          available buf_code-range
      581          and
      582         (buf_code-range.db-num = v-db-num
      583           and
      584         buf_code-range.first-code <= v-cur-code
      585         )
      586       or
      587         (
      588           v-range-type = 'drgb':U
      589           AND
      590           v-cur-code = 0
      591         )
      592      )
      593      then do:
      594         assign
      595           l-code-range-exist = true
      596         .
      597         if v-g#news
      598         and buf_code-range.stts = "f" then do:
      599           assign
      600             buf_code-range.stts = "u"
      601           .
      602         end.
      603       end.
      604       if not l-code-range-exist
      605          and v-g#news-source-db <> 0
      606       then do:
      607         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      608                                       ,vss-workfile
      609                                       ,vss-revision
      610                                       ,vss-description
      611                                       ,chr(10)
      612                                       ,v-db-num
      613                                       ,v-range-type
      614                                       ,v-cur-code
      615                                      ).
      616       end.
      617       if (not l-code-range-exist
      618           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      619          )
      620       and ( not can-find (first buf1_code-range no-lock
      621                           where buf1_code-range.db-num = v-db-num
      622                             and buf1_code-range.range-type = v-range-type
      623                             and buf1_code-range.stts = "f"
      624                          )
      625           )
      626       then do:
      627         if v-g#db-num = 0 then do:
      628           run new-bcod-gen-code-range in this-procedure
      629             (input v-db-num,
      630              input v-range-type
      631             ) no-error .
      632           if error-status :error then do:
      633             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      634                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      635                                           ,v-db-num
      636                                           ,v-range-type
      637                                           ,v-cur-code
      638                                           ,chr(10)
      639                                           ,error-status:get-message(1)
      640                                           ,return-value
      641                                          ).
      642           end.
      643         end.
      644         else do:
      645           if v-range-type = 'sclc':U
      646           or v-range-type = 'pglc':U
      647           then do:
      648             assign
      649               v-db-for-send = "":U
      650             .
      651             if v-g#db-num = 0 then do:
      652               for each buf_db no-lock
      653                 where buf_db.db-num > 0
      654                   and buf_db.db-num <> v-g#news-source-db
      655               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      656               :
      657                 assign
      658                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      659                 .
      660               end.
      661               assign
      662                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      663               .
      664             end.
      665             else do:
      666               if not v-g#news then do:
      667                 assign
      668                   v-db-for-send = "0":U
      669                 .
      670               end.
      671             end.
      672             run nws/cr-route.p ( input 'send-cmd':U
      673                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      674                                  "code-range":U + chr(1) +
      675                                  (if v-range-type = 'sclc':U
      676                                   then string( current-value(s-sclc-code, ub))
      677                                   else string( current-value(s-pglc-code, ub))
      678                                   ) + chr(1) +
      679                                   v-range-type)
      680                           ,input ?
      681                           ,input v-db-for-send
      682                           ) no-error .
      683             if error-status :error then do:
      684               undo, return error return-value.
      685             end.
      686           end.
      687         end.
      688       end.
      689     end.
      690   end procedure.
      691   procedure cre-loc-sc-code-range :
      692     define input parameter v-cur-code as integer no-undo .
      693   define input parameter p-cdrg-type as character no-undo .
      694     do
      695     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      696     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      697     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      698     :
      699       define buffer buf_code-range for ub.code-range .
      700       find first buf_code-range
      701            where buf_code-range.range-type = p-cdrg-type
      702              and buf_code-range.first-code >= v-cur-code
      703            no-error .
      704       if not available buf_code-range then do:
      705         run new-bcod-gen-code-range in this-procedure
      706           ( input 0,
      707             input p-cdrg-type
      708           ) no-error .
      709         if error-status :error then do:
      710           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      711                                          + "Код &2&1&3 &4"
      712                                         , chr(10)
      713                                         , v-cur-code
      714                                         , error-status:get-message(1)
      715                                         , return-value
      716                                        ) .
      717         end.
      718       end.
      719     end.
      720   end procedure.
      721   procedure mark-used-if-need :
      722   define input parameter p-cur-code as integer no-undo .
      723   define input parameter p-range-type like ub.code-range.range-type no-undo .
      724   define input parameter p-db-num like ub.code-range.db-num no-undo .
      725     do
      726     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      727     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      728     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      729     :
      730       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      731       define buffer buf_code-range for ub.code-range .
      732       assign
      733       v-db-num = if p-range-type = 'sclc':U
      734                  then 0
      735                  else p-db-num
      736       .
      737   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   define buffer locK-batchprocess1 for ub.batchprocess.
      739   run gbl/lock-prc.p
      740       (input 'lscc':U
      741       ,input 0
      742       ,input 0
      743       ,input 0
      744       ,input ""
      745       ,input ""
      746       ,input ""
      747       ,input (
      748               ",,,Вкл/выкл лок. вес. кодов"
      749              )
      750       ,input true
      751       ,buffer lock-batchprocess1
      752       ) no-error .
      753     if error-status :error then do:
      754       message
      755         vss-workfile vss-revision vss-description skip
      756         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      757         view-as alert-box error .
      758       undo, return error .
      759     end.
      760       find first buf_code-range
      761            where buf_code-range.range-type = p-range-type
      762              and buf_code-range.first-code >= p-cur-code
      763              and buf_code-range.last-code <= p-cur-code
      764              and buf_code-range.db-num = v-db-num
      765            no-error .
      766       if not available buf_code-range then do:
      767         message
      768           vss-workfile vss-revision vss-description skip
      769           "Ошибка при создании поиске диапазона" skip
      770           "База данных" p-db-num skip
      771           "Код" p-cur-code skip
      772           "Тип" p-range-type
      773           error-status :get-message(1) skip
      774           return-value skip
      775           view-as alert-box error .
      776         undo, return error .
      777       end.
      778       if buf_code-range.stts = "f":U then do:
      779         assign
      780         buf_code-range.stts = "u":U
      781         .
      782       end.
      783     end.
      784   end procedure.
      785     define new shared temp-table  tt-tax no-undo
