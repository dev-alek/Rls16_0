      814   initial "@(#)$Workfile$ $Revision$".
      815   procedure grplib-get-full-name :
      816      define input parameter p-node-code  as integer      no-undo.
      817      define output parameter p-full-name as character    no-undo.
      818      do
      819   on error undo, return error
      820   :
      821       define variable v-upper-code    as integer           no-undo.
      822       define buffer buf_gds-grp       for ub.gds-grp.
      823       define buffer buf_upper_gds-grp for ub.gds-grp.
      824       find first buf_gds-grp no-lock
      825            where buf_gds-grp.node-code = p-node-code
      826       no-error.
      827       if not available buf_gds-grp
      828       then do:
      829           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      830       end.
      831       assign
      832           p-full-name  = ""
      833           v-upper-code = 1
      834       .
      835       do while buf_gds-grp.upper-code <> 0
      836       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      837       :
      838           assign
      839               p-full-name  = buf_gds-grp.node-name
      840                            + (if p-full-name <> "" then chr(47) else "")
      841                            + p-full-name
      842               v-upper-code = buf_gds-grp.upper-code
      843           .
      844           find first buf_gds-grp no-lock
      845                where buf_gds-grp.node-code = v-upper-code
      846           no-error.
      847           if not available buf_gds-grp
      848           then do:
      849               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      850                                   + string( v-upper-code )
      851                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      852           end.
      853       end.
      854       assign
      855       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      856       .
      857   end.
      858   end .
      859   procedure grplib-get-node-from-full-name :
      860   define input parameter p-full-name as character no-undo .
      861   define output parameter p-node-code as integer no-undo .
      862   define variable v-ii as integer no-undo .
      863   define variable v-upper-code as integer no-undo .
      864   define variable v-root-code as integer no-undo .
      865   define variable v-entry as character no-undo .
      866   define buffer buf_gds-grp       for ub.gds-grp.
      867   do
      868   on error undo, return error
      869   :
      870     find first buf_gds-grp no-lock
      871         where buf_gds-grp.upper-code = 0
      872     no-error .
      873     if not available buf_gds-grp
      874     then do:
      875         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      876     end.
      877     else do:
      878       assign
      879       v-root-code = buf_gds-grp.node-code
      880       .
      881     end.
      882     v-upper-code = v-root-code.
      883     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      884       assign
      885       v-entry = entry(v-ii, p-full-name, chr(47)).
      886       if v-entry = '' then leave.
      887       find first buf_gds-grp no-lock where
      888                 buf_gds-grp.node-name = v-entry
      889             and buf_gds-grp.upper-code = v-upper-code
      890             no-error.
      891       if not available buf_gds-grp then do:
      892         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      893       end.
      894       else do:
      895         p-node-code = buf_gds-grp.node-code.
      896         v-upper-code = buf_gds-grp.node-code.
      897       end.
      898     end.
      899   end.
      900   end .
      901   define buffer buf_bar-code  for ub.bar-code.
      902   define buffer buf_price-doc for ub.price-doc.
      903   define buffer buf_sys-ctrl  for ub.sys-ctrl.
