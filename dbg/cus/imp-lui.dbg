      805     define variable v-cntxt-db-num        as integer   no-undo .
      806     define variable v-cntxt-userid        as character no-undo .
      807     define variable v-cntxt-level         as character no-undo .
      808     define variable v-cntxt-host-code-obj as integer   no-undo .
      809     define variable v-cntxt-obj-type      as character no-undo .
      810     define variable v-cntxt-obj-code      as integer   no-undo .
      811     define variable v-cntxt-db-num-obj    as integer   no-undo .
