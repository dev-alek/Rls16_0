      938   def stream txt-temp.
      939   DEFINE BUTTON B-file
      940        IMAGE-UP FILE "btn-down-arrow":U
      941        IMAGE-DOWN FILE "btn-down-arrow":U
      942        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      943        LABEL ""
      944        SIZE 3 BY 1.
      945   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      946        LABEL "Выход"
      947        SIZE 15 BY 1.13
      948        BGCOLOR 8 .
      949   DEFINE BUTTON Btn_OK
      950        LABEL "Выполнить"
      951        SIZE 15 BY 1.13
      952        BGCOLOR 8 .
      953   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      954        LABEL "Файл для импорта"
      955        VIEW-AS FILL-IN
      956        SIZE 52.5 BY 1 NO-UNDO.
      957   DEFINE VARIABLE Tumbler AS INTEGER
      958        VIEW-AS RADIO-SET VERTICAL
      959        RADIO-BUTTONS
      960             "В справочник товаров", 1,
      961   "В документ переоценки", 2,
      962   "В файл для последующей загрузки в приходный документ", 3
      963        SIZE 56 BY 2 NO-UNDO.
      964   DEFINE FRAME Dialog-Frame
      965        file-name AT ROW 2.25 COL 1
      966        B-file AT ROW 2.25 COL 71.5
      967        Tumbler AT ROW 5 COL 15 NO-LABEL
      968        Btn_OK AT ROW 7.25 COL 16
      969        Btn_Cancel AT ROW 7.25 COL 41
      970        "              Куда будем импортировать данные из файла" VIEW-AS TEXT
      971             SIZE 73.5 BY 1 AT ROW 3.5 COL 1
      972             BGCOLOR 8
      973        "          Укажите файл из которого необходимо произвести импорт" VIEW-AS TEXT
      974             SIZE 73.5 BY .67 AT ROW 1.25 COL 1
      975             BGCOLOR 8
      976        SPACE(0.24) SKIP(6.74)
      977       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      978            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      979            TITLE "Импорт из текстового файла"
      980            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      981   ASSIGN
      982          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      983          FRAME Dialog-Frame:HIDDEN           = TRUE.
      984   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      985   DO:
      986     APPLY "END-ERROR":U TO SELF.
      987   END.
      988   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      989   DO:
      990       DEF VAR ll_commit AS LOG    NO-UNDO INIT NO.
      991       SYSTEM-DIALOG GET-FILE v_os-file
      992           TITLE "Выберите файл для импорта"
      993                 FILTERS "Excel (*.xls)" "*.xls"
      994                 MUST-EXIST
      995                 USE-FILENAME
      996           update ll_commit
      997           default-extension "xls"
      998           .
      999       IF ll_commit <> YES THEN do:
     1000          RETURN NO-APPLY.
     1001       end.
     1002       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     1003           BELL.
     1004           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1005           RETURN NO-APPLY.
     1006       END.
     1007       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     1008       DISP file-name WITH FRAME Dialog-Frame.
     1009   END.
     1010   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1011   DO:
     1012       assign
     1013           Tumbler.
     1014       if  trim(file-name) = "" then do:
     1015               message "Не задан файл для импорта "
     1016               view-as alert-box ERROR.
     1017               return no-apply.
     1018       end.
     1019       create "Excel.Application" chExcelApplication no-error.
     1020       if error-status :error then do:
     1021           message
     1022           "Ошибка при запуске Excel" skip
     1023           error-status :get-message(1) skip
     1024           view-as alert-box error .
     1025           return no-apply .
     1026       end.
     1027       assign
     1028          chExcelApplication:interactive = false
     1029          chExcelApplication:ScreenUpdating = FALSE
     1030          chExcelApplication:visible = FALSE
     1031          i-line       = 0
     1032          impc-save    = 0
     1033          impc-update  = 0
     1034        .
     1035       chWorkBook   = chExcelApplication:WorkBooks:open( file-name ).
     1036       chWorkSheet  = chExcelApplication:Sheets:item (1).
     1037       if Tumbler = 2  THEN do:
     1038           run str/pr-docs.w (input parparentproc
     1039                       ,input "b-sel":U
     1040                       ,input 'работа':U
     1041                       ,input 'новый':U
     1042                       ,input v-cntxt-obj-type
     1043                       ,input v-cntxt-obj-code
     1044                       ,input ""
     1045                       ,output loc-ref-list).
     1046           if loc-ref-list  = '':U
     1047           or loc-ref-list  = ?
     1048           then do:
     1049             message
     1050               "Переоценка не выбрана."
     1051             view-as alert-box error.
     1052             return .
     1053           end.
     1054           find buf_price-doc no-lock
     1055             where recid (buf_price-doc) = integer(entry(1, loc-ref-list))
     1056           no-error .
     1057           if not available buf_price-doc then do:
     1058             message
     1059               substitute("Переоценка с recid &1 не найдена", integer(entry(1, loc-ref-list)))
     1060             view-as alert-box .
     1061             return .
     1062           end.
     1063           if buf_price-doc.status_ <> 'новый':U then do:
     1064             message
     1065               "Статус переоценки должен быть 'новый'."
     1066             view-as alert-box error.
     1067             return .
     1068           end.
     1069           i-doc-num = buf_price-doc.doc-num.
     1070       END.
     1071       ELSE if Tumbler = 3  THEN do:
     1072           system-dialog get-file f-name
     1073               TITLE "Экспорт в файл для последующей загрузки в приходный документ"
     1074             filters "Файл для экспорта (*.adb) " "*.adb"
     1075             ask-overwrite
     1076             save-as
     1077             use-filename
     1078             update v-log
     1079             default-extension "adb".
     1080           if not v-log then return.
     1081       END.
     1082       repeat:
     1083           i-line = i-line + 1.
     1084           I-Artic   = (chWorkSheet:range ("A" + string(i-LINE)):value) no-error.
     1085           I-Eng-Name = (chWorkSheet:range ("B" + string(i-LINE)):value) no-error.
     1086           I-Vol     = (chWorkSheet:range ("C" + string(i-LINE)):value) no-error.
     1087           I-Prix    = (chWorkSheet:range ("D" + string(i-LINE)):value) no-error.
     1088           I-Price   = (chWorkSheet:range ("E" + string(i-LINE)):value) no-error.
     1089           I-Name    = (chWorkSheet:range ("F" + string(i-LINE)):value) no-error.
     1090           if error-status :error then message "Не верно задана строка " i-LINE  view-as alert-box information .
     1091           IF I-Artic = "AARCOD" THEN DO:
     1092               NEXT.
     1093           END.
     1094           IF DEC (I-Vol) = ? THEN do:
     1095               i-line = i-line - 1.
     1096               LEAVE.
     1097           END.
     1098           display
     1099                    i-line       label "Работаю со строкой":U
     1100                    impc-save    label "Сохранено":U
     1101                    impc-update  label "Изменено":U
     1102              with frame ff view-as dialog-box
     1103           title ": Импорт из файла".
     1104           pause 0.
     1105           IF TRIM(i-artic) = "" THEN DO:
     1106               OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1107               put stream Err unformatted
     1108                   string(today, "99/99/9999") " "
     1109                   string(time, "HH:MM")
     1110                   " Строка - " i-line " - ячейка АРТИКУЛ (A) не должна быть пустой" skip .
     1111               output stream Err close.
     1112               next.
     1113           END.
     1114           IF TRIM(I-Name) = "" THEN DO:
     1115               OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1116               put stream Err unformatted
     1117                   string(today, "99/99/9999") " "
     1118                   string(time, "HH:MM")
     1119                   " Строка - " i-line " - ячейка НАИМЕНОВАНИЕ (F) не должна быть пустой" skip .
     1120               output stream Err close.
     1121               next.
     1122           END.
     1123           find buf_goods where
     1124                buf_goods.artic = i-artic and
     1125                buf_goods.prod-type = i-cli-type and
     1126                buf_goods.prod-code = i-cli-code
     1127           no-lock no-error.
     1128           if not available buf_goods then do:
     1129               if Tumbler = 1 then do:
     1130                     run proc-imp-goods in this-procedure ( input 'ДОБАВЛЕНИЕ':U , input ? ).
     1131               end.
     1132               if Tumbler = 2 OR Tumbler = 3 then DO:
     1133                   OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1134                   put stream ERR UNFORMATTED
     1135                       string(today, "99/99/9999") " "
     1136                       string(time, "HH:MM")
     1137                       " Строка - " i-line " - товар отсутствует в БД, пропускаем" skip.
     1138                   output stream Err close.
     1139                   NEXT.
     1140               END.
     1141           END.
     1142           ELSE DO:
     1143               if Tumbler = 1 then DO:
     1144                 run proc-imp-goods in this-procedure ( input 'ИЗМЕНЕНИЕ':U , input buf_goods.gds-code ).
     1145                 assign
     1146                   impc-update = impc-update + 1
     1147                 .
     1148               END.
     1149           END.
     1150           if Tumbler = 2  THEN do:
     1151                 Var-Dec = DEC (I-Price) NO-ERROR.
     1152                 IF ERROR-STATUS:ERROR OR Var-Dec <= 0 THEN DO:
     1153                     OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1154                     put stream Err unformatted
     1155                         string(today, "99/99/9999") " "
     1156                         string(time, "HH:MM")
     1157                         " Строка - " i-line " - в ячейке ЦЕНА (E) стоит что-то не перевариваемое" skip .
     1158                     output stream Err close.
     1159                     next.
     1160                 END.
     1161                 find first buf_bar-code no-lock
     1162                   where buf_bar-code.gds-code = buf_goods.gds-code
     1163                 no-error .
     1164                 if not available buf_bar-code
     1165                 then do:
     1166                    OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1167                    put stream Err unformatted
     1168                        string(today, "99/99/9999") " "
     1169                        string(time, "HH:MM")
     1170                        " Строка - " i-line " - У товара нет собственного Бар-Кода" skip .
     1171                    output stream Err close.
     1172                    next.
     1173                 end.
     1174                 run proc-imp-price .
     1175           end.
     1176           ELSE if Tumbler = 3 THEN do:
     1177                Var-Dec = DEC (I-Vol) NO-ERROR.
     1178                IF ERROR-STATUS:ERROR OR Var-Dec <= 0 THEN DO:
     1179                   OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1180                   put stream Err unformatted
     1181                       string(today, "99/99/9999") " "
     1182                       string(time, "HH:MM")
     1183                       " Строка - " i-line " - в ячейке КОЛИЧЕСТВО (C) стоит что-то не перевариваемое" skip .
     1184                   output stream Err close.
     1185                   next.
     1186                END.
     1187                Var-Dec = DEC (I-Prix) NO-ERROR.
     1188                IF ERROR-STATUS:ERROR OR Var-Dec <= 0 THEN DO:
     1189                   OUTPUT stream Err TO value ("Imp_Lui.err") append.
     1190                   put stream Err unformatted
     1191                       string(today, "99/99/9999") " "
     1192                       string(time, "HH:MM")
     1193                       " Строка - " i-line " - в ячейке ЦЕНА ПРИХОДА (D) стоит что-то не перевариваемое" skip .
     1194                   output stream Err close.
     1195                   next.
     1196                END.
     1197                OUTPUT stream txt-temp TO value (f-name) append.
     1198                    put stream txt-temp  unformatted
     1199                        "ITEM:" +
     1200                         buf_goods.artic + ";" +
     1201                         trim(string(buf_goods.prod-code)) + ";;;;" +
     1202                         trim(string(I-Prix)) + ";" +
     1203                         trim(string(I-Vol)) + ";;;;;;;;;" SKIP.
     1204                output stream txt-temp close.
     1205                impc-save = impc-save + 1.
     1206           end.
     1207       END.
     1208       OUTPUT stream err close.
     1209       release object chWorkSheet   no-error .
     1210       RELEASE object chWorkBook   no-error .
     1211       assign
     1212          v-ok = chExcelApplication:Quit() no-error
     1213        .
     1214       release object chExcelApplication   no-error .
     1215       message ("Импорт из файла " + file-name + " закончен" + chr(10) + "прочитано " + string(i-line) +
     1216                ",  сохранено " + string(impc-save) + ", из них изменено " + string(impc-update) + '.' +
     1217                chr(10) + " Все ошибки выведены в файл - Imp_Lui.err" )
     1218       view-as alert-box  INFORMATION.
     1219   END.
     1220   ON LEAVE OF file-name IN FRAME Dialog-Frame
     1221   DO:
     1222       ASSIGN file-name.
     1223       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
     1224           ASSIGN FILE-INFO:FILE-NAME = file-name.
     1225           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
     1226           DISP file-name WITH FRAME Dialog-Frame.
     1227       END.
     1228       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
     1229   END.
     1230   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1231   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1232   MAIN-BLOCK:
     1233   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1234      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1235      message  "Импорт из Excel данных по товарам." skip
     1236              "При импорте используется работа с Excel, поэтому не прерывайте работу Excel и не нарушайте уже установленную связь!"
     1237              skip "Продолжать ?"
     1238              view-as alert-box question buttons ok-cancel update v-ok .
     1239      if v-ok <> TRUE THEN DO:
     1240          return no-apply.
     1241      END.
     1242      message  "Прежде чем продолжить работу данной программы убедитесь, что в файле, который вы ":U skip
     1243               "хотите закачать в ТН, колонка, содержащая АРТИКУЛ, была отформатирована как числовая ":U SKIP
     1244               "без десятичных знаков. В случае если артикул будет состоять из одних цифр, например 111011,":U SKIP
     1245                "в ТН он закачается как 111011.00. ":U
     1246              skip "Продолжать ?":U
     1247              view-as alert-box WARNING  buttons OK-CANCEL TITLE "В Н И М А Н И Е" update v-ok .
     1248      if v-ok <> TRUE THEN DO:
     1249          return no-apply.
     1250      END.
     1251      find first buf_sys-ctrl.
     1252      if buf_sys-ctrl.db-num <> 0 then do:
     1253        message "Данная утилита может работать только в ГБД.". PAUSE.
     1254        return.
     1255      end.
     1256      find first buf_gds-prt no-lock
     1257       where buf_gds-prt.root      = YES
     1258         and buf_gds-prt.node-name = i-scale
     1259      no-error.
     1260      if not available buf_gds-prt then do:
     1261          message "Нет шкалы " i-scale. pause.
     1262          return.
     1263      END.
     1264      find first buf_gds-grp no-lock
     1265       where buf_gds-grp.lvl-num   = buf_gds-grp.upper-code
     1266         and buf_gds-grp.node-name = i-grp-name
     1267      no-error.
     1268      if not avail buf_gds-grp then do:
     1269          message "Нет группы " i-grp-name. pause.
     1270          return.
     1271      END.
     1272      find first buf_clients no-lock
     1273       where buf_clients.obj-type = i-cli-type
     1274         and buf_clients.obj-code = i-cli-code
     1275      no-error.
     1276      if not available buf_clients then do:
     1277          message "Нет клиента " i-cli-type i-cli-code. pause.
     1278          return.
     1279      END.
     1280   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281     run mainmenu_getcntxt in parparentproc
     1282       (output v-cntxt-db-num
     1283       ,output v-cntxt-userid
     1284       ,output v-cntxt-level
     1285       ,output v-cntxt-host-code-obj
     1286       ,output v-cntxt-obj-type
     1287       ,output v-cntxt-obj-code
     1288       ,output v-cntxt-db-num-obj
     1289       ,output v-cntxt-is-admin
     1290       ) .
     1291          RUN enable_UI.
     1292      WAIT-FOR GO OF FRAME Dialog-Frame.
     1293   END.
     1294   RUN disable_UI.
     1295   PROCEDURE disable_UI :
     1296     HIDE FRAME Dialog-Frame.
     1297   END PROCEDURE.
     1298   PROCEDURE enable_UI :
     1299     DISPLAY file-name Tumbler
     1300         WITH FRAME Dialog-Frame.
     1301     ENABLE file-name B-file Tumbler Btn_OK Btn_Cancel
     1302         WITH FRAME Dialog-Frame.
     1303     VIEW FRAME Dialog-Frame.
     1304   END PROCEDURE.
     1305   PROCEDURE proc-imp-goods :
     1306   define input  parameter p-mode      as character            no-undo .
     1307   define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     1308      if p-mode <> 'ДОБАВЛЕНИЕ':U and p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1309       message
     1310         "Неверное значение параметра p-mode в процедуре proc-imp-goods = " p-mode
     1311       view-as alert-box error.
     1312       return.
     1313      end.
     1314      do transaction:
     1315               if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     1316                 run ref/dtaxgdss.p ( input no
     1317                                    , input "шт":U
     1318                                    , input buf_gds-grp.node-code
     1319                                    , input ?
     1320                                    , input ?
     1321                                    , input v-cntxt-host-code-obj
     1322                                    , input v-cntxt-obj-type
     1323                                    , input v-cntxt-obj-code
     1324                                    ).
     1325               end.
     1326               run ref/goods01.p (
     1327                     input parparentproc
     1328                   , input p-mode
     1329                   , input no
     1330                   , input 0
     1331                   , input no
     1332                   , input yes
     1333                   , input no
     1334                   , input no
     1335                   , input yes
     1336                   , input v-cntxt-host-code-obj
     1337                   , input v-cntxt-obj-type
     1338                   , input v-cntxt-obj-code
     1339                   , input yes
     1340                   , input ?
     1341                   , input p-gds-code
     1342                   , input i-artic
     1343                   , input i-cli-type
     1344                   , input i-cli-code
     1345                   , input buf_gds-prt.node-code
     1346                   , input buf_gds-grp.node-code
     1347                   , input i-name
     1348                   , input ""
     1349                   , input I-Eng-Name
     1350                   , input i-name
     1351                   , input replace( replace( i-name, chr( 39 ), "" ), chr( 34 ), "" )
     1352                   , input i-city
     1353                   , input "шт"
     1354                   , input "шт"
     1355                   , input 0.0
     1356                   , input 0.0
     1357                   , input 1
     1358                   , input 1
     1359                   , input 0
     1360                   , input 0
     1361                   , input 0
     1362                   , input 0
     1363                   , input 'Группа':U
     1364                   , input 0
     1365                   , input yes
     1366                   , input 0
     1367                   , input 0
     1368                   , input ""
     1369                   , input ""
     1370                   , input ""
     1371                   , input ""
     1372                   , input ""
     1373                   , input ""
     1374                   , input 0
     1375                   , input 0
     1376                   , input ""
     1377                   , input 0.0
     1378                   , input 0
     1379                   , input 0
     1380                   , input ""
     1381                   , input ""
     1382                   , input ""
     1383                   , input 0
     1384                   , input ?
     1385                   , input ""
     1386                   , input no
     1387                   , input no
     1388                   , input no
     1389                   , input no
     1390                   , input "no"
     1391                   , input yes
     1392                   , input no
     1393                   , input no
     1394                   , input 0
     1395                   , input-output v-recid
     1396                   , output j-gds-code
     1397               ) no-error .
     1398               if error-status :error
     1399               then do:
     1400                   message
     1401                            vss-workfile vss-revision vss-description
     1402                       skip string(
     1403                                   if p-mode = 'ДОБАВЛЕНИЕ':U then "Ошибка создания карточки товара.":U
     1404                                   else "Ошибка редактирования карточки товара.":U
     1405                                  )
     1406                       skip return-value
     1407                       skip i-artic
     1408                       skip trim(error-status :get-message(1))
     1409                            trim(error-status :get-message(2))
     1410                            trim(error-status :get-message(3))
     1411                   view-as alert-box error.
     1412               end.
     1413               ELSE
     1414                  ASSIGN
     1415                     impc-save = impc-save + 1.
     1416      end.
     1417   END PROCEDURE.
     1418   PROCEDURE proc-imp-price :
     1419     define buffer buf_price-list for ub.price-list.
     1420   do
     1421   on error undo, return error return-value
     1422   :
     1423     find buf_price-list
     1424       where buf_price-list.doc-num    = i-doc-num       and
     1425             buf_price-list.price-type = ""              and
     1426             buf_price-list.b-code     = buf_bar-code.b-code
     1427     no-error.
     1428     if available buf_price-list then do:
     1429       next.
     1430     end.
     1431     else do:
     1432       create buf_price-list.
     1433       assign
     1434         buf_price-list.doc-num     = i-doc-num
     1435         buf_price-list.b-code      = buf_bar-code.b-code
     1436         buf_price-list.artic       = buf_goods.artic
     1437         buf_price-list.prod-type   = buf_goods.prod-type
     1438         buf_price-list.prod-code   = buf_goods.prod-code
     1439         buf_price-list.main-price  = yes
     1440         buf_price-list.calc-method = 'Отсутствует':U
     1441         buf_price-list.obj-code    = buf_price-doc.obj-code
     1442         buf_price-list.obj-type    = buf_price-doc.obj-type
     1443       .
     1444     end.
     1445     assign
     1446       buf_price-list.price-sale = dec(I-Price)
     1447       impc-save = impc-save + 1
     1448     .
     1449   end.
     1450   END PROCEDURE.
