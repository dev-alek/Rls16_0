     1291   run display-month-name in this-procedure .
     1292   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   on help of frame D-Dialog
     1294   do:
     1295     run gbl/app_help.p
     1296       (input this-procedure :file-name
     1297       ,input ''
     1298       ,input ?
     1299       ) no-error.
     1300     if error-status :error then do:
     1301       message
     1302         "Ошибка при вызове помощи"
     1303         error-status :get-message(1)
     1304         view-as alert-box .
     1305     end.
     1306   end.
     1307   run minbtn-set in this-procedure .
     1308   on choose of b-help in frame D-Dialog
     1309   do:
     1310     apply "help":u to frame D-Dialog .
     1311   end.
     1312   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   procedure minbtn-set :
     1314       do
     1315           on error undo, return error return-value
     1316           :
     1317           define variable ii              as integer       no-undo .
     1318           define variable fh              as widget-handle no-undo .
     1319           define variable hh              as widget-handle no-undo .
     1320           define variable v-h             as handle        extent 4 no-undo .
     1321           define variable v-name-button   as character     no-undo .
     1322           define variable v-help-old-x    as decimal       no-undo .
     1323           define variable v-help-old-y    as decimal       no-undo .
     1324           define variable v-help-old-size as decimal       no-undo .
     1325           define variable v-frame-width   as decimal       no-undo .
     1326           define variable jj              as integer       no-undo .
     1327           do
     1328               on error undo, return error
     1329               :
     1330               assign
     1331                   v-frame-width = frame D-Dialog:width - 0.3
     1332                   fh            = frame D-Dialog:first-child
     1333                   hh            = fh:first-child
     1334                   ii            = 1
     1335                   .
     1336               do while valid-handle(hh):
     1337                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1338                   do:
     1339                       case lc(hh:name) :
     1340                           when "b-help" then
     1341                               do:
     1342                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1343                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1344                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1345                                   hh:TOOLTIP = "Помощь" .
     1346                                   v-help-old-x = hh:column .
     1347                                   v-help-old-y = hh:row    .
     1348                                   v-help-old-size = hh:width .
     1349                                   hh:width-chars = 2.5 .
     1350                               end.
     1351                           when "b-print" then
     1352                               do:
     1353                                   hh:load-image("cmp/b-print.bmp":u) .
     1354                                   hh:TOOLTIP = "Печать" .
     1355                                   v-h[ii] = hh:handle .
     1356                                   ii = ii + 1 .
     1357                                   hh:width-chars = 3 .
     1358                               end.
     1359                           when "b-history" or
     1360                           when "b-hist" then
     1361                               do:
     1362                                   hh:load-image("cmp/b-hist.bmp":u) .
     1363                                   hh:TOOLTIP = "История" .
     1364                                   v-h[ii] = hh:handle .
     1365                                   ii = ii + 1 .
     1366                                   hh:width-chars = 3 .
     1367                               end.
     1368                           when "b-sch" then
     1369                               do:
     1370                                   hh:load-image("cmp/b-sch.bmp":u) .
     1371                                   hh:TOOLTIP = "Установка Фильтра" .
     1372                                   v-h[ii] = hh:handle .
     1373                                   ii = ii + 1 .
     1374                                   hh:width-chars = 3 .
     1375                               end.
     1376                           when "b-hist-user" then
     1377                               do:
     1378                                   hh:load-image("cmp/b-hist.bmp":u) .
     1379                                   hh:TOOLTIP = "История пользователя" .
     1380                                   ii = ii + 1 .
     1381                               end.
     1382                       end case.
     1383                   end.
     1384                   hh = hh:next-sibling.
     1385               end.
     1386               b-help:column = v-frame-width - b-help:width-chars.
     1387               jj = 0.
     1388               repeat ii = 4 to 1 by -1 :
     1389                   if valid-handle (v-h[ii] ) then
     1390                   do:
     1391                       jj  = jj + 1 .
     1392                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1393                       v-h[ii]:row    = v-help-old-y .
     1394                   end.
     1395               end.
     1396           end.
     1397       end.
     1398   end procedure.
     1399   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     1400       MESSAGE "A SmartDialog is not intended ":U SKIP
     1401               "to be run Persistent or to be placed ":U SKIP
     1402               "in another SmartObject at UIB design time.":U
     1403               VIEW-AS ALERT-BOX ERROR.
     1404       RUN disable_UI.
     1405       DELETE PROCEDURE THIS-PROCEDURE.
     1406       RETURN.
     1407   END.
     1408   RUN dispatch ('create-objects':U).
     1409   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     1410   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     1411   MAIN-BLOCK:
     1412   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1413      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1414     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     1415     WAIT-FOR GO OF FRAME D-Dialog.
     1416   END.
     1417   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     1418   PROCEDURE adm-create-objects :
     1419   END PROCEDURE.
     1420   PROCEDURE adm-row-available :
     1421     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1422     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1423     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1424     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1425     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1426     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1427     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1428     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1429     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1430     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1431     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1432     IF adm-updating-record THEN RETURN.
     1433     RUN get-attribute ('FIELDS-ENABLED':U).
     1434     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1435     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1436         OUTPUT link-handle) NO-ERROR.
     1437     IF link-handle = "":U THEN
     1438         RETURN.
     1439     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1440     IF NUM-ENTRIES(link-handle) > 1 THEN
     1441         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1442             "encountered more than one RECORD-SOURCE.":U SKIP
     1443             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1444                VIEW-AS ALERT-BOX ERROR.
     1445     RUN get-attribute ('Key-Name':U).
     1446     key-name = RETURN-VALUE.
     1447     IF key-name = "":U THEN key-name = ?.
     1448     IF key-name NE ? THEN DO:
     1449       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1450         NO-ERROR.
     1451       IF key-value NE ? THEN
     1452         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1453     END.
     1454   IF VALID-HANDLE (adm-object-hdl) THEN
     1455       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1456   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1457   END PROCEDURE.
     1458   PROCEDURE disable_UI :
     1459     HIDE FRAME D-Dialog.
     1460   END PROCEDURE.
     1461   PROCEDURE display-calendar :
     1462     assign
     1463       v-curr-month   = integer(cb-month :screen-value in frame D-Dialog)
     1464       v-curr-year    = integer(fi-year :screen-value  in frame D-Dialog)
     1465       v-month-begin  = date(v-curr-month
     1466                            ,1
     1467                            ,v-curr-year
     1468                            )
     1469       v-month-offset = (weekday(v-month-begin) + 5) mod 7
     1470     .
     1471     run gbl/lastday.p
     1472       (input  v-month-begin
     1473       ,output v-last-day
     1474       ).
     1475     if v-curr-day > v-last-day then do:
     1476       assign
     1477         v-curr-day = v-last-day
     1478       .
     1479     end.
     1480     if v-curr-day = ?
     1481     or v-curr-day <= 0 then do:
     1482       assign
     1483         v-curr-day = 1
     1484       .
     1485     end.
     1486     do with frame D-Dialog:
     1487       assign
     1488         FI-date :screen-value = string( date (v-curr-month, v-curr-day, v-curr-year) )
     1489       .
     1490     end.
     1491     define variable ind as integer no-undo .
     1492     define variable l-immediate-display as logical no-undo .
     1493     assign
     1494       l-immediate-display        = session :immediate-display
     1495       session :immediate-display = false
     1496     .
     1497     v-curr-day = ? .
     1498     do ind = 1 to 42 :
     1499       run set-box-state in this-procedure
     1500         (input ind
     1501         ,input  (if ind  >= v-month-offset + 1
     1502                 and ind <= v-month-offset + v-last-day
     1503                 then ind - v-month-offset
     1504                 else 0
     1505                )
     1506         ).
     1507     end.
     1508     assign
     1509       session :immediate-display = l-immediate-display
     1510     .
     1511   END PROCEDURE.
     1512   PROCEDURE display-month-name :
     1513     define variable v-month-name as character no-undo .
     1514     do with frame D-Dialog:
     1515       run gbl/monthnam.p
     1516         (input integer(cb-month :screen-value)
     1517         ,output v-month-name
     1518         ).
     1519       assign
     1520         fi-month-name :screen-value = v-month-name
     1521       .
     1522     end.
     1523     run display-calendar .
     1524   END PROCEDURE.
     1525   PROCEDURE enable_UI :
     1526     DISPLAY CB-Month FI-Year
     1527         WITH FRAME D-Dialog.
     1528     ENABLE b-exit b-quit b-help CB-Month b-prev-month b-next-month FI-Year
     1529            b-prev-year b-next-year fi-month-name
     1530         WITH FRAME D-Dialog.
     1531     VIEW FRAME D-Dialog.
     1532   END PROCEDURE.
     1533   PROCEDURE select-month :
     1534     define input parameter p-shift-value as integer no-undo .
     1535     define variable v-current-month as integer no-undo .
     1536     do with frame D-Dialog:
     1537       assign
     1538         v-current-month = integer (cb-month :screen-value)
     1539       .
     1540       assign
     1541         v-current-month = v-current-month + p-shift-value
     1542       .
     1543       if v-current-month < 1 then do:
     1544         assign
     1545           v-current-month = 1
     1546         .
     1547       end.
     1548       if v-current-month > 12 then do:
     1549         assign
     1550           v-current-month = 12
     1551         .
     1552       end.
     1553       assign
     1554         cb-month :screen-value = string(v-current-month)
     1555       .
     1556     end.
     1557     run display-month-name .
     1558   END PROCEDURE.
     1559   PROCEDURE select-year :
     1560     define input parameter p-shift-value as integer no-undo .
     1561     define variable v-current-year as integer no-undo .
     1562     do with frame D-Dialog:
     1563       assign
     1564         v-current-year = integer (fi-year :screen-value)
     1565       .
     1566       assign
     1567         v-current-year = v-current-year + p-shift-value
     1568       .
     1569       if v-current-year < 0 then do:
     1570         assign
     1571           v-current-year = 0
     1572         .
     1573       end.
     1574       if v-current-year > 9999 then do:
     1575         assign
     1576           v-current-year = 9999
     1577         .
     1578       end.
     1579       assign
     1580         fi-year :screen-value = string(v-current-year)
     1581       .
     1582     end.
     1583     run display-month-name .
     1584   END PROCEDURE.
     1585   PROCEDURE send-records :
     1586   END PROCEDURE.
     1587   PROCEDURE set-box-state :
     1588     define input parameter v-box-number as integer no-undo .
     1589     define input parameter v-display-day as integer no-undo .
     1590     if v-display-day = 0
     1591     or v-display-day = ? then do:
     1592       if v-day-handle  [v-box-number] :visible <> false then do:
     1593         assign
     1594           v-day-handle  [v-box-number] :visible = false
     1595         .
     1596       end.
     1597       if v-day-handle  [v-box-number] :screen-value <> "" then do:
     1598         assign
     1599           v-day-handle  [v-box-number] :screen-value = ""
     1600         .
     1601       end.
     1602       if v-rect-handle  [v-box-number] :sensitive <> false then do:
     1603         assign
     1604           v-rect-handle  [v-box-number] :sensitive = false
     1605         .
     1606       end.
     1607       if v-rect-handle [v-box-number] :visible <> false then do:
     1608         assign
     1609           v-rect-handle [v-box-number] :visible = false
     1610         .
     1611       end.
     1612     end.
     1613     else do:
     1614       if v-day-handle  [v-box-number] :visible <> true then do:
     1615         assign
     1616           v-day-handle  [v-box-number] :visible = true
     1617         .
     1618       end.
     1619       if v-day-handle  [v-box-number] :screen-value <> string(v-display-day) then do:
     1620         assign
     1621           v-day-handle  [v-box-number] :screen-value = string(v-display-day)
     1622         .
     1623       end.
     1624       if v-display-day = v-curr-day then do:
     1625           if v-old-mode then do:
     1626              v-rect-handle [v-box-number] :bgcolor = RED_COLOR .
     1627           end.
     1628           else do:
     1629              v-rect-handle [v-box-number] :bgcolor =  BLUE_COLOR .
     1630           end.
     1631       end.
     1632       else do:
     1633         assign
     1634           v-rect-handle [v-box-number] :bgcolor = GREY_COLOR
     1635         .
     1636       end.
     1637       if v-rect-handle [v-box-number] :visible <> true then do:
     1638         assign
     1639           v-rect-handle [v-box-number] :visible = true
     1640         .
     1641       end.
     1642       if v-rect-handle  [v-box-number] :sensitive <> true then do:
     1643         assign
     1644           v-rect-handle  [v-box-number] :sensitive = true
     1645         .
     1646       end.
     1647     end.
     1648   END PROCEDURE.
     1649   PROCEDURE del-box-state :
     1650     define input parameter v-box-number as integer no-undo .
     1651     define input parameter v-display-day as integer no-undo .
     1652     if v-display-day = 0
     1653     or v-display-day = ? then do:
     1654       if v-day-handle  [v-box-number] :visible <> false then do:
     1655         assign
     1656           v-day-handle  [v-box-number] :visible = false
     1657         .
     1658       end.
     1659       if v-day-handle  [v-box-number] :screen-value <> "" then do:
     1660         assign
     1661           v-day-handle  [v-box-number] :screen-value = ""
     1662         .
     1663       end.
     1664       if v-rect-handle  [v-box-number] :sensitive <> false then do:
     1665         assign
     1666           v-rect-handle  [v-box-number] :sensitive = false
     1667         .
     1668       end.
     1669       if v-rect-handle [v-box-number] :visible <> false then do:
     1670         assign
     1671           v-rect-handle [v-box-number] :visible = false
     1672         .
     1673       end.
     1674     end.
     1675     else do:
     1676       if v-day-handle  [v-box-number] :visible <> true then do:
     1677         assign
     1678           v-day-handle  [v-box-number] :visible = true
     1679         .
     1680       end.
     1681       if v-day-handle  [v-box-number] :screen-value <> string(v-display-day) then do:
     1682         assign
     1683           v-day-handle  [v-box-number] :screen-value = string(v-display-day)
     1684         .
     1685       end.
     1686       if v-display-day = v-curr-day then do:
     1687         assign
     1688           v-rect-handle [v-box-number] :bgcolor = Grey_COLOR
     1689         .
     1690       end.
     1691       else do:
     1692         assign
     1693           v-rect-handle [v-box-number] :bgcolor = GREY_COLOR
     1694         .
     1695       end.
     1696       if v-rect-handle [v-box-number] :visible <> true then do:
     1697         assign
     1698           v-rect-handle [v-box-number] :visible = true
     1699         .
     1700       end.
     1701       if v-rect-handle  [v-box-number] :sensitive <> true then do:
     1702         assign
     1703           v-rect-handle  [v-box-number] :sensitive = true
     1704         .
     1705       end.
     1706     end.
     1707   END PROCEDURE.
     1708   PROCEDURE set-curr-day :
     1709     define input parameter p-rect-name as character no-undo .
     1710     define variable v-box-ind as integer no-undo .
     1711     assign
     1712       v-box-ind = integer (substring (p-rect-name, 6))
     1713     .
     1714     define variable v-new-day as integer no-undo .
     1715     define variable v-old-day as integer no-undo .
     1716     assign
     1717       v-new-day = if  v-box-ind >= v-month-offset + 1
     1718                   and v-box-ind <= v-month-offset + v-last-day
     1719                   then v-box-ind - v-month-offset
     1720                   else 0
     1721     .
     1722     if  v-new-day <> 0
     1723     and v-new-day <> v-curr-day then do:
     1724       assign
     1725         v-old-day = v-curr-day
     1726         v-curr-day = v-new-day
     1727       .
     1728       if v-old-mode = true then do:
     1729           run set-box-state
     1730             (input v-old-day + v-month-offset
     1731             ,input v-old-day
     1732             ).
     1733       end.
     1734      run set-box-state
     1735         (input v-new-day + v-month-offset
     1736         ,input v-new-day
     1737         ).
     1738       if v-old-mode = false  then do:
     1739        if not can-find (first temp-dates where temp-dates.dates = date(v-curr-month, v-curr-day, v-curr-year) ) then do:
     1740             create temp-dates no-error .
     1741             assign temp-dates.dates = date(v-curr-month, v-curr-day, v-curr-year) no-error .
     1742           end.
     1743           Else do:
     1744               run del-box-state
     1745                 (input v-new-day + v-month-offset
     1746                 ,input v-new-day  ).
     1747                find first temp-dates where temp-dates.dates = date(v-curr-month, v-curr-day, v-curr-year) no-error .
     1748                delete temp-dates no-error .
     1749                v-rect-handle [v-curr-day] :bgcolor = GREY_COLOR.
     1750           end.
     1751       end.
     1752               do with frame D-Dialog:
     1753                 assign
     1754                   FI-date :screen-value = string( date (v-curr-month, v-curr-day, v-curr-year) )
     1755                 .
     1756               end.
     1757     end.
     1758   END PROCEDURE.
     1759   PROCEDURE state-changed :
     1760     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1761     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1762   END PROCEDURE.
