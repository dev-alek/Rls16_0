        1   CREATE WIDGET-POOL.
        2   define temp-table temp-dates no-undo
        3   field dates as date
        4   index pi is unique primary   dates .
        5   define input        parameter p-buttons  as character no-undo .
        6   define input        parameter p-title    as character no-undo .
        7   define input        parameter h-callback as handle    no-undo .
        8   define input-output parameter p-date     as date      no-undo .
        9   define output       parameter p-ok       as logical   no-undo .
       10   define input-output parameter table for  temp-dates append   .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "выбор несколько дат".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       73   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       74   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       75   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       76   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       77   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       78   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       79   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       80   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       81   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       82   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       83   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       84   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       85   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       86   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       87   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       88   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   procedure proc-alt-shift-f2:
       94     if not ibs.th.gbl.gbl-var:rcode
       95   then
       96     run gbl\inidebug.p .
       97   end.
       98   procedure proc-alt-shift-f3:
       99     run gbl/prvssinf.p
      100       ( input this-procedure
      101       ) .
      102   end.
      103   define variable v-inform-launched as logical no-undo initial false .
      104   procedure proc-alt-shift-f4:
      105     define variable v-action as character no-undo .
      106     if v-inform-launched = false then do:
      107       assign
      108         v-inform-launched = true
      109       .
      110       run gbl/d-inform.w
      111         (  input self
      112         ,  input this-procedure
      113         , output v-action
      114         ) no-error .
      115       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      116       assign
      117         v-inform-launched = false
      118       .
      119     end.
      120   end.
      121   procedure proc-alt-f1:
      122     run gbl/corrhelp.p
      123       (input this-procedure
      124       ) .
      125   end .
      126   on alt-shift-f2 anywhere do:
      127     run proc-alt-shift-f2.
      128   end.
      129   on alt-shift-f3 anywhere do:
      130     run proc-alt-shift-f3 in this-procedure .
      131   end.
      132   on alt-shift-f4 anywhere do:
      133     run proc-alt-shift-f4 in this-procedure.
      134   end.
      135   on alt-f1 anywhere do:
      136     run proc-alt-f1 in this-procedure .
      137   end.
      138   define variable v-date         as date no-undo .
      139   define variable v-curr-day     as integer no-undo .
      140   define variable v-month-begin as date no-undo .
      141   define variable v-curr-month  as integer no-undo .
      142   define variable v-curr-year   as integer no-undo .
      143   define variable v-last-day    as integer no-undo .
      144   define variable v-month-offset as integer no-undo .
      145   define variable v-day-handle   as handle no-undo extent 42 .
      146   define variable v-rect-handle  as handle no-undo extent 42 .
      147   define variable v-old-mode as logical no-undo .
      148   DEFINE BUTTON b-exit AUTO-GO
      149        LABEL "&Ввод"
      150        SIZE 10 BY 1
      151        BGCOLOR 8 .
      152   DEFINE BUTTON b-help
      153        LABEL "Помо&щь"
      154        SIZE 10 BY 1
      155        BGCOLOR 8 .
      156   DEFINE BUTTON b-next-month
      157        LABEL "&>>"
      158        SIZE 4 BY 1.
      159   DEFINE BUTTON b-next-year
      160        LABEL "&>>"
      161        SIZE 4 BY 1.
      162   DEFINE BUTTON b-prev-month
      163        LABEL "&<<"
      164        SIZE 4 BY 1.
      165   DEFINE BUTTON b-prev-year
      166        LABEL "&<<"
      167        SIZE 4 BY 1.
      168   DEFINE BUTTON b-quit AUTO-END-KEY
      169        LABEL "&Отмена"
      170        SIZE 10 BY 1
      171        BGCOLOR 8 .
