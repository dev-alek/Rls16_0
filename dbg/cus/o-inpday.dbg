      556        RECT-15 AT ROW 11.5 COL 6
      557        RECT-14 AT ROW 9.5 COL 47.25
      558        RECT-13 AT ROW 9.5 COL 40.25
      559        RECT-12 AT ROW 9.5 COL 33.5
      560        RECT-10 AT ROW 9.5 COL 19.75
      561        RECT-9 AT ROW 9.5 COL 13
      562        RECT-8 AT ROW 9.5 COL 6
      563        RECT-7 AT ROW 7.58 COL 47.25
      564        RECT-6 AT ROW 7.58 COL 40.25
      565        RECT-5 AT ROW 7.58 COL 33.5
      566        RECT-4 AT ROW 7.58 COL 26.75
      567        RECT-3 AT ROW 7.58 COL 19.75
      568        RECT-2 AT ROW 7.58 COL 13
      569        SPACE(41.87) SKIP(11.78)
      570       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      571            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      572            TITLE "Введите месяц и год"
      573            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      574   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      575   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      576   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      577   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      578   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      579   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      580   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      581   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      582       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      583   RUN ensure-broker.
      584   THIS-PROCEDURE:ADM-DATA =
      585        'ADM1.1~`':U +
      586        'SmartDialog~`':U +
      587        'DIALOG-BOX~`':U +
      588        'NO ~`':U +
      589        '~`':U +
      590        '~`':U +
      591        '~`':U +
      592        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      593           + "~`":U +
      594        'Layout,Hide-on-Init~`':U +
      595        '~`':U +
      596        '~`':U +
      597        '~`~`~`~`~`~`~`~`~`~`~`':U +
      598        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      599            THEN "^^":U
      600        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      601             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      602   PROCEDURE adm-apply-entry :
      603     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      604   END PROCEDURE.
      605   PROCEDURE adm-destroy :
      606    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      607   END PROCEDURE.
      608   PROCEDURE adm-disable :
      609       DISABLE b-exit b-quit b-help CB-Month b-prev-month b-next-month FI-Year b-prev-year b-next-year fi-month-name WITH FRAME D-Dialog.
      610       RUN dispatch ('disable-fields':U).
      611       RUN set-attribute-list ('ENABLED=no':U).
      612       RETURN.
      613   END PROCEDURE.
      614   PROCEDURE adm-edit-attribute-list :
      615         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      616         RETURN.
      617   END PROCEDURE.
      618   PROCEDURE adm-enable :
      619       ENABLE UNLESS-HIDDEN b-exit b-quit b-help CB-Month b-prev-month b-next-month FI-Year b-prev-year b-next-year fi-month-name WITH FRAME D-Dialog.
      620       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      621       RUN set-attribute-list ('ENABLED=yes':U).
      622       RETURN.
      623   END PROCEDURE.
      624   PROCEDURE adm-exit :
      625        RUN notify ('exit':U).
      626     RETURN.
      627   END PROCEDURE.
      628   PROCEDURE adm-hide :
      629     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      630   END PROCEDURE.
      631   PROCEDURE adm-initialize :
      632     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      633   END PROCEDURE.
      634   PROCEDURE adm-show-errors :
      635       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      636       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      637           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      638       END.
      639       RETURN.
      640   END PROCEDURE.
      641   PROCEDURE adm-UIB-mode :
      642     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      643   END PROCEDURE.
      644   PROCEDURE adm-view :
      645     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      646   END PROCEDURE.
      647   PROCEDURE dispatch :
      648       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      649       RUN broker-dispatch IN adm-broker-hdl
      650           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      651       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      652   END PROCEDURE.
      653   PROCEDURE ensure-broker :
      654   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      655   IF RETURN-VALUE NE "ADM-Broker":U THEN
      656   DO:
      657       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      658       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      659   END.
      660   END PROCEDURE.
      661   PROCEDURE get-attribute :
      662     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      663     RUN broker-get-attribute IN adm-broker-hdl
      664         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      665     RETURN RETURN-VALUE.
      666   END PROCEDURE.
      667   PROCEDURE get-attribute-list :
      668     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      669     RUN broker-get-attribute-list IN adm-broker-hdl
      670         (INPUT THIS-PROCEDURE,
      671          INPUT ?,
      672          OUTPUT p-attr-list) NO-ERROR.
      673     RETURN.
      674   END PROCEDURE.
      675   PROCEDURE new-state :
      676     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      677     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      678     RETURN.
      679   END PROCEDURE.
      680   PROCEDURE notify :
      681     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      682     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      683     IF RETURN-VALUE = "ADM-ERROR":U THEN
      684         RETURN "ADM-ERROR":U.
      685     RETURN.
      686   END PROCEDURE.
      687   PROCEDURE set-attribute-list :
      688     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      689     RUN ensure-broker.
      690     RUN broker-set-attribute-list IN adm-broker-hdl
      691         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      692     RETURN.
      693   END PROCEDURE.
      694   PROCEDURE set-position :
      695       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      696       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      697       IF VALID-HANDLE(adm-object-hdl) THEN
      698       DO:
      699           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      700           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      701           DO:
      702             IF p-row = 0 THEN p-row =
      703               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      704             IF p-col = 0 THEN p-col =
      705               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      706           END.
      707           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      708           DO:
      709             parent-hdl = adm-object-hdl:PARENT.
      710             IF p-row = 0 THEN p-row =
      711               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      712                 parent-hdl:ROW.
      713             IF p-col = 0 THEN p-col =
      714               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      715                 parent-hdl:COL.
      716           END.
      717           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      718           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      719         ASSIGN adm-object-hdl:ROW    =   p-row
      720                adm-object-hdl:COLUMN =   p-col.
      721       END.
      722       RETURN.
      723   END PROCEDURE.
      724   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      725       STRING(adm-object-hdl)).
      726   PAUSE 0 BEFORE-HIDE.
      727   PROCEDURE adm-change-page :
      728     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      729     END PROCEDURE.
      730   PROCEDURE delete-page :
      731     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      732     RUN broker-delete-page IN adm-broker-hdl
      733         (INPUT THIS-PROCEDURE, INPUT p-page#).
      734     END PROCEDURE.
      735   PROCEDURE init-object :
      736     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      737     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      738     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      739     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      740     RUN broker-init-object IN adm-broker-hdl
      741         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      742          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      743     RETURN.
      744   END PROCEDURE.
      745   PROCEDURE init-pages :
      746     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      747     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      748         INPUT p-page-list) NO-ERROR.
      749     END PROCEDURE.
      750   PROCEDURE select-page :
      751     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      752     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      753         INPUT p-page#) NO-ERROR.
      754     END PROCEDURE.
      755   PROCEDURE view-page :
      756     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      757     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      758         INPUT p-page#).
      759     END PROCEDURE.
