      931   ON GO OF FRAME D-Dialog
      932   DO:
      933     define variable v-new-month as integer no-undo .
      934     define variable v-new-day   as integer no-undo .
      935     define variable v-new-year  as integer no-undo .
      936     assign
      937       v-new-month = integer (cb-month :screen-value)
      938       v-new-year  = integer (fi-year  :screen-value)
      939       v-new-day   = v-curr-day
      940     .
      941     assign
      942       v-date = date(v-new-month, v-new-day, v-new-year)
      943     .
      944     if v-date = ? then do:
      945       message
      946         "Недопустимая дата" skip
      947         "месяц" v-new-month skip
      948         "день"  v-new-day   skip
      949         "год"   v-new-year  skip
      950         view-as alert-box error .
      951       return no-apply .
      952     end.
      953     if  h-callback <> ?
      954     and valid-handle(h-callback)
      955     then do:
      956       if h-callback :get-signature("validate-month-year") <> ""
      957       then do:
      958         define variable lok as logical no-undo .
      959         run validate-month-year in h-callback
      960           (input v-date
      961           ,output lok
      962           ) no-error .
      963         if error-status :error then do:
      964           message
      965             vss-workfile vss-revision vss-description skip
      966             "Ошибка при вызове процедуры проверки допустимости месяца и года" skip
      967             "файл" h-callback :file-name skip
      968             "процедура" "validate-month-year" skip
      969             error-status :get-message(1) skip
      970             return-value skip
      971             view-as alert-box error .
      972           return no-apply .
      973         end.
      974         if lok <> true then do:
      975           return no-apply .
      976         end.
      977       end.
      978       else do:
      979         message
      980           vss-workfile vss-revision vss-description skip
      981           "Программе был передан указатель на процедуру для проверки диапазона дат" skip
      982           "В указанной процедуре отсутствует внутренняя процедура validate-month-year " skip
      983           "файл" h-callback :file-name skip
      984           view-as alert-box error .
      985         return no-apply .
      986       end.
      987     end.
      988     assign
      989       p-date  = v-date
      990       p-ok = true
      991     .
      992   END.
