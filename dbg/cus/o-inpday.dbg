      529        RECT-41 AT ROW 17.33 COL 40.25
      530        RECT-40 AT ROW 17.33 COL 33.5
      531        RECT-39 AT ROW 17.33 COL 26.75
      532        RECT-38 AT ROW 17.33 COL 19.75
      533        RECT-37 AT ROW 17.33 COL 13
      534        RECT-36 AT ROW 17.33 COL 6
      535        RECT-35 AT ROW 15.33 COL 47.25
      536        RECT-11 AT ROW 9.5 COL 26.75
      537        RECT-34 AT ROW 15.33 COL 40.25
      538        RECT-33 AT ROW 15.33 COL 33.5
      539        RECT-32 AT ROW 15.33 COL 26.75
      540        RECT-31 AT ROW 15.33 COL 19.75
      541        RECT-30 AT ROW 15.33 COL 13
      542        RECT-29 AT ROW 15.33 COL 6
      543        RECT-28 AT ROW 13.42 COL 47.25
      544        RECT-27 AT ROW 13.42 COL 40.25
      545        RECT-26 AT ROW 13.42 COL 33.5
      546        RECT-25 AT ROW 13.42 COL 26.75
      547        RECT-24 AT ROW 13.42 COL 19.75
      548        RECT-23 AT ROW 13.42 COL 13
      549        RECT-22 AT ROW 13.42 COL 6
      550        RECT-21 AT ROW 11.5 COL 47.25
      551        RECT-20 AT ROW 11.5 COL 40.25
      552        RECT-19 AT ROW 11.5 COL 33.5
      553        RECT-18 AT ROW 11.5 COL 26.75
      554        RECT-17 AT ROW 11.5 COL 19.75
