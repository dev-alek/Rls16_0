     1783       .
     1784   procedure print-line :
     1785   do on error undo, return error return-value :
     1786     assign
     1787        Lines_Counter = Lines_Counter + 1
     1788       .
     1789     if line-counter ( OutStream ) + 2 > page-size ( OutStream ) then do:
     1790        run p-line.
     1791        page stream OutStream.
     1792        PUT STREAM OutStream UNFORMATTED
     1793            string ( "Лист " + string ( PAGE-NUMBER (OutStream) , ">>>>9") ) AT 100 format "X (13)" SKIP .
     1794        run print-1.
     1795        end.
     1796     if line-counter ( OutStream ) < Tmp_Counter then
     1797       assign
     1798       .
     1799     assign
     1800       Tmp_Counter  = line-counter ( OutStream )
     1801       num-ln = num-ln + 1
     1802     .
     1803     if line-counter ( OutStream ) + j > page-size ( OutStream ) then  PAGE STREAM OutStream.
     1804   PUT STREAM OutStream UNFORMATTED
     1805       sym1                format "X (1)" space (0)
     1806       string (tt-temp.pay-desk)      format "X (7)"
     1807       sym2                format "X (1)" space (0)
     1808       string (tt-temp.psn-name )     format "X (22)"
     1809       sym3                format "X (1)" space (0)
     1810      string (tt-temp.fact-date,"99/99/99") + " " + tt-temp.fact-time   format "X (22)"
     1811      sym4                format "X (1)" space (0)
     1812       string (tt-temp.src-code  )    format "X (15)"
     1813       sym5                format "X (1)" space (0)
     1814       string (tt-temp.d-card     )   format "X (18)"
     1815       sym6                format "X (1)" space (0)
     1816       string (tt-temp.sum-rubl    )  format "X (15)"
     1817       .
     1818       if p-par = "'6':U" then do:
     1819          PUT STREAM OutStream UNFORMATTED
     1820          sym10                format "X (1)" space (0)
     1821          string (tt-temp.vid    )  format "X (57)"
     1822         .
     1823       end.
     1824       PUT STREAM OutStream UNFORMATTED
     1825       sym7                format "X (1)" space (0)
     1826       string (tt-temp.sale-code)     format "X (10)"
     1827       sym8                format "X (1)" space (0)
     1828       string (tt-temp.sale-name )    format "X (20)"
     1829       sym9                format "X (1)" space (0)
     1830       skip
     1831   .
     1832       num#col# = 1.
     1833       num#str# = num#str# + 1.
     1834      run macr_excel_char (  tt-temp.pay-desk     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1835      run macr_excel_char (  tt-temp.psn-name     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1836      run macr_excel_char (  string (tt-temp.fact-date,"99/99/99") + " " + tt-temp.fact-time   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1837      run macr_excel_char (   tt-temp.src-code    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1838      run macr_excel_char (   tt-temp.d-card      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1839      run macr_excel_dec  (   tt-temp.sum-rubl    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1840      if p-par = "'6':U" then do:
     1841         run macr_excel_char (   tt-temp.VID      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1842      end.
     1843      run macr_excel_char (   string (tt-temp.sale-code)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1844      run macr_excel_char (   tt-temp.sale-name   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1845      vv-sum   = vv-sum   + tt-temp.sum-rubl .
     1846   end.
     1847   end procedure.
     1848   procedure print-all-itog :
     1849   end procedure.
     1850   procedure PrintTitul :
     1851     do  on error undo, return error return-value  :
     1852     define variable cc as integer no-undo .
     1853     define variable tt as integer no-undo .
     1854     define variable pp as integer no-undo .
     1855   PUT STREAM OutStream UNFORMATTED
     1856   space (1)
     1857      ReportNAme skip
     1858      "по фирме "  ub.clients.obj-name skip
     1859      "за период "  x-date-start " по " x-date-end  skip
     1860      "Дата составления " + cur-time-date ()  skip
     1861       .
     1862     define variable i as integer no-undo .
     1863     define variable v-nn as integer   no-undo .
     1864     v-nn = num-entries (reportheader,chr (10)) .
     1865     repeat i = 1 to v-nn :
     1866       put stream outstream unformatted  entry (i,reportheader,chr (10))  at 1 format "x (90)" skip.
     1867     end.
     1868       num#str# = 1.
     1869       num#col# = 1.
     1870       run macr_excel_char ( Reportname , num#str# , num#col#   ) .
     1871       num#str# = num#str# + 1.
     1872       run macr_excel_char ( "по фирме " + CAPS ( ub.clients.obj-name)   , num#str# , num#col#   ) .
     1873       num#str# = num#str# + 1.
     1874       run macr_excel_char ( "За период " + string (x-date-start) + " по " +  string (x-date-end)  , num#str# , num#col# ) .
     1875       num#str# = num#str# + 1.
     1876       run macr_excel_char ( ReportHeader , num#str# , num#col#   ) .
     1877       num#str# = num#str# + 1.
     1878       run macr_excel_char ("Дата составления " + cur-time-date ()   , num#str# , num#col#   ) .
     1879       num#str# = num#str# + 1.
     1880       run macr_excel_char ("№ кассы"  , num#str# , num#col#   ) .    run macr_cell_size  ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1881       num#col# = 2.
     1882       run macr_excel_char ("ФИО кассира"  , num#str# , num#col#   ) .  run macr_cell_size  ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1883       num#col# = 3.
     1884       run macr_excel_char ("Дата и время операции"  , num#str# , num#col#   ) . run macr_cell_size  ( 30 , ? , num#str# , num#col# , ?, ? ) .
     1885       num#col# = 4.
     1886       run macr_excel_char ("Код товара"  , num#str# , num#col#   ) . run macr_cell_size  ( 16 , ? , num#str# , num#col# , ?, ? ) .
     1887       num#col# = 5.
     1888       run macr_excel_char ("№ Дисконтной карты"  , num#str# , num#col#   ) . run macr_cell_size  ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1889       num#col# = 6.
     1890       run macr_excel_char (v-shap  , num#str# , num#col#   ) . run macr_cell_size  ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1891       if p-par = "'6':U" then do:
     1892         num#col# = num#col# + 1.
     1893         run macr_excel_char (  "Вид оплаты"      , num#str# , num#col#   ) . run macr_cell_size  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1894       end.
     1895       num#col# = num#col# + 1.
     1896       run macr_excel_char ("№ продавца"  , num#str# , num#col#   ) . run macr_cell_size  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1897       num#col# = num#col# + 1.
     1898       run macr_excel_char ("ФИО продавца"  , num#str# , num#col#   ) . run macr_cell_size  ( 35 , ? , num#str# , num#col# , ?, ? ) .
     1899     run print-1 .
     1900       run macr_cell_format
     1901        ( 10    ,
     1902         true  ,
     1903         false  ,
     1904         ?    ,
     1905         1 ,
     1906         1 ,
     1907         num#str# ,
     1908         num#col# ) .
     1909        put  stream macr_excel unformatted
     1910          substitute ('select ("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1911          'BORDER ( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1912          'ALIGNMENT (3 , , 4 , 4 ,)'  + chr(10)
     1913          .
     1914       put  stream macr_excel unformatted
     1915          substitute ('select ("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     1916          'BORDER ( 2, , , , , , , , , , ) '  + chr(10) .
     1917     end.
     1918   end procedure.
     1919   procedure PrintPodval :
     1920     do on error undo, return error return-value  :
     1921     define variable pp as integer no-undo .
     1922     define variable rr as integer no-undo .
     1923     end.
     1924   end procedure.
     1925   PROCEDURE on-same-page :
     1926     define input parameter p-line-number as integer  no-undo .
     1927     if p-line-number > page-size ( OutStream ) then return .
     1928     if line-counter ( OutStream ) + p-line-number > page-size ( OutStream ) then do:
     1929       run p-line .
     1930       page stream OutStream .
     1931       end.
     1932   end procedure.
     1933   procedure print-1 :
     1934     do
     1935     on error undo, return error return-value
     1936     :
     1937       run p-line .
     1938       PUT STREAM OutStream UNFORMATTED  ":№ кассы"  AT 1          format "X (8)" .
     1939       PUT STREAM OutStream UNFORMATTED  ":ФИО кассира"            format "X (23)" .
     1940       PUT STREAM OutStream UNFORMATTED  ":Дата и время операции"  format "X (23)" .
     1941       PUT STREAM OutStream UNFORMATTED  ":Код товара"             format "X (16)" .
     1942       PUT STREAM OutStream UNFORMATTED  ":№ Дисконтной карты"     format "X (19)" .
     1943       PUT STREAM OutStream UNFORMATTED  ":" + v-shap              format "X (16)" .
     1944       if p-par = "'6':U" then do:
     1945          PUT STREAM OutStream UNFORMATTED  ":Вид оплаты"          format "X (59)" .
     1946       end.
     1947       PUT STREAM OutStream UNFORMATTED  ":№ продавца"             format "X (11)" .
     1948       PUT STREAM OutStream UNFORMATTED  ":ФИО продавца        :"  format "X (22)" .
     1949       PUT STREAM OutStream UNFORMATTED  skip .
     1950       run p-line .
     1951     end.
     1952   end procedure.
     1953   procedure p-line :
     1954     do
     1955     on error undo, return error return-value
     1956     :
     1957       PUT STREAM OutStream UNFORMATTED  fill ("-",8)  AT 1  format "X (8)".
     1958       PUT STREAM OutStream UNFORMATTED  fill ("-",23)        format "X (23)".
     1959       PUT STREAM OutStream UNFORMATTED  fill ("-",23)        format "X (23)".
     1960       PUT STREAM OutStream UNFORMATTED  fill ("-",16)        format "X (16)".
     1961       PUT STREAM OutStream UNFORMATTED  fill ("-",19)        format "X (19)".
     1962       PUT STREAM OutStream UNFORMATTED  fill ("-",16)        format "X (16)".
     1963       if p-par = "'6':U" then do:
     1964          PUT STREAM OutStream UNFORMATTED  fill ("-",60)        format "X (59)".
     1965       end.
     1966       PUT STREAM OutStream UNFORMATTED  fill ("-",11)        format "X (11)".
     1967       PUT STREAM OutStream UNFORMATTED  fill ("-",22)        format "X (22)".
     1968       PUT STREAM OutStream UNFORMATTED  skip .
     1969     end.
     1970   end procedure.
     1971   procedure print-obj :
     1972     do
     1973     on error undo, return error return-value
     1974     :
     1975     PUT STREAM OutStream UNFORMATTED  Obj-list.obj-name  at 1    format "X (26)" skip.
     1976       num#str# = num#str# + 1 .
     1977       num#col# = 1.
     1978       run macr_excel_char ( Obj-list.obj-name  , num#str# , num#col#   ) .
     1979       run macr_cell_size  ( 26 , ? , num#str# , num#col# , ?, ? ) .
     1980     end.
     1981   end procedure.
     1982   procedure make-tt :
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986   define buffer buf_chk-doc for ub.chk-doc  .
     1987   define buffer buf_chk-gds for ub.chk-gds  .
     1988   define buffer buf_psn-clients for ub.clients  .
     1989   define buffer buf_sale-clients for ub.clients  .
     1990   define buffer buf_chk-pay for ub.chk-pay  .
     1991   define variable v-sum as decimal   no-undo .
     1992   define variable jj as integer   no-undo init 0.
     1993   define variable v-vid as character no-undo .
     1994   define variable vvv as integer   no-undo .
     1995   define variable v-par as character no-undo .
     1996   v-par = trim (p-par,"':u").
     1997   v-par = LEFT-TRIM (v-par,"'").
     1998   for each obj-list :
     1999     for each buf_chk-doc no-lock where
     2000         buf_chk-doc.obj-type = obj-list.obj-type and
     2001         buf_chk-doc.obj-code = obj-list.obj-code and
     2002         buf_chk-doc.chk-date <= x-date-end and
     2003         buf_chk-doc.chk-date >= x-date-start
     2004         and
     2005         buf_chk-doc.chk-type = int (v-par)
     2006     :
     2007   find first buf_psn-clients no-lock  where
     2008              buf_psn-clients.obj-code = buf_chk-doc.cashier-psn-code  and
     2009              buf_psn-clients.obj-type = 'чел':U no-error .
     2010   find first buf_sale-clients no-lock  where
     2011              buf_sale-clients.obj-code = buf_chk-doc.salesman-psn-code  and
     2012              buf_sale-clients.obj-type = 'чел':U no-error .
     2013   v-vid = "" .
     2014   for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code break
     2015        by  buf_chk-pay.pay-code
     2016        by  buf_chk-pay.curr-code
     2017   :
     2018    if first-of (buf_chk-pay.curr-code) then do:
     2019       find first ub.cash-pay no-lock where
     2020          ub.cash-pay.cdpay-code =   buf_chk-pay.pay-code and
     2021          ub.cash-pay.curr-code  =   buf_chk-pay.curr-code  no-error .
     2022          if available ub.cash-pay then
     2023             v-vid = v-vid +  ub.cash-pay.obj-name +  ","  .
     2024    end.
     2025   end.
     2026   v-vid =  trim (v-vid,",") .
     2027           for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code :
     2028           if p-par = "'8':U"  then
     2029              v-sum =  (buf_chk-gds.src-price * buf_chk-gds.src-qnty) -  (buf_chk-gds.src-discnt * buf_chk-gds.src-qnty) .
     2030           else
     2031              v-sum =  (buf_chk-gds.price-base * buf_chk-gds.doc-qnty) -  (buf_chk-gds.discnt * buf_chk-gds.doc-qnty) .
     2032               jj = jj + 1.
     2033   IF ( JJ modulo v-account = 0 )  then DO:
     2034    Assign
     2035       v-kol-spice = (50 - LENGTH(obj-list.obj-name)) / 2
     2036       RecordsString = fill(' ',v-kol-spice) + string(obj-list.obj-name)
     2037       .
     2038             if  log-manager:logfile-name ne ?
     2039             then DO:
     2040                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2041             end.
     2042              if mFrameView
     2043              then do:
     2044               DISPLAY
     2045                 JJ @ RecordsDone
     2046                 RecordsString   @ RecordsString
     2047                 WITH FRAME InfoFrame.
     2048              end.
     2049   End.
     2050      if v-button-stop then  DO:
     2051            if mFrameView
     2052            then
     2053               PROCESS EVENTS.
     2054            IF StopProcessing THEN DO:
     2055            RETURN error.
     2056            End.
     2057      end.
     2058             create tt-temp.
     2059             assign
     2060                 tt-temp.pay-desk  = buf_chk-doc.pay-desk
     2061                 tt-temp.psn-name  = if available  buf_psn-clients then buf_psn-clients.obj-name else ""
     2062                 tt-temp.fact-date = buf_chk-doc.chk-date
     2063                 tt-temp.fact-time = string  ( buf_chk-doc.chk-time , "hh:mm" )
     2064                 tt-temp.src-code  = buf_chk-gds.src-code
     2065                 tt-temp.d-card    = if  buf_chk-doc.d-card = ? then  buf_chk-doc.src-d-card else  buf_chk-doc.d-card
     2066                 tt-temp.sum-rubl  = v-sum
     2067                 tt-temp.obj-code  = buf_chk-doc.obj-code
     2068                 tt-temp.obj-type  = buf_chk-doc.obj-type
     2069                 tt-temp.sale-code = if buf_chk-doc.salesman-psn-code <> ? then string (buf_chk-doc.salesman-psn-code) else ""
     2070                 tt-temp.sale-name = if available buf_sale-clients then buf_sale-clients.obj-name else ""
     2071                 tt-temp.vid       = v-vid
     2072             .
     2073           end.
     2074        end.
     2075     end.
     2076   end.
     2077   end procedure.
     2078   procedure print-obj-itog :
     2079     do
     2080     on error undo, return error return-value
     2081     :
     2082     run p-line .
     2083     PUT STREAM OutStream UNFORMATTED  "Итого по " + Obj-list.obj-name + " : "  + string (vv-sum) + " " + v-base-type  at 1    format "X (100)" skip.
     2084       num#str# = num#str# + 1 .
     2085       num#col# = 1.
     2086       run macr_excel_char ( "Итого по " + Obj-list.obj-name + " : "  + string (vv-sum) + " " +  v-base-type ,  num#str# , num#col#   ) .
     2087       run macr_cell_size  ( 26 , ? , num#str# , num#col# , ?, ? ) .
     2088       vv-sum   = 0 .
     2089       vv-count = 0 .
     2090      run p-line .
     2091     end.
     2092   end procedure.
     2093   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2094   procedure macr_excel_char :
     2095    do
     2096    on error undo, return error return-value
     2097    :
     2098    define input parameter  p-val as character no-undo .
     2099    define input parameter  p-row as integer no-undo .
     2100    define input parameter  p-col as integer no-undo .
     2101    if p-val = ? then p-val = "" .
     2102       put stream macr_excel unformatted
     2103             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2104    end.
     2105   end procedure.
     2106   procedure macr_excel_char_with_format :
     2107    do
     2108    on error undo, return error return-value
     2109    :
     2110    define input parameter  p-val as character no-undo .
     2111    define input parameter  p-row as integer no-undo .
     2112    define input parameter  p-col as integer no-undo .
     2113    if p-val = ? then p-val = "" .
     2114       put stream macr_excel unformatted
     2115             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2116       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2117       put stream macr_excel unformatted
     2118             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2119    end.
     2120   end procedure.
     2121   procedure macr_excel_cell_format :
     2122    do
     2123    on error undo, return error return-value
     2124    :
     2125    define input parameter  p-val    as character no-undo .
     2126    define input parameter  p-row    as integer   no-undo .
     2127    define input parameter  p-col    as integer   no-undo .
     2128    define input parameter  p-format as character no-undo .
     2129    if p-val = ? then p-val = "" .
     2130       put stream macr_excel unformatted
     2131             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2132       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2133       put stream macr_excel unformatted
     2134             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2135    end.
     2136   end procedure.
     2137   procedure macr_excel_sum :
     2138    do
     2139    on error undo, return error return-value
     2140    :
     2141    define input parameter  p-row as integer no-undo .
     2142    define input parameter  p-col as integer no-undo .
     2143    define input parameter  p-row1 as integer no-undo .
     2144    define input parameter  p-col1 as integer no-undo .
     2145    define input parameter  p-row2 as integer no-undo .
     2146    define input parameter  p-col2 as integer no-undo .
     2147       put stream macr_excel unformatted
     2148             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2149    end.
     2150   end procedure.
     2151   procedure macr_excel_dec :
     2152    do
     2153    on error undo, return error return-value
     2154    :
     2155    define input parameter  p-val as character no-undo .
     2156    define input parameter  p-row as integer   no-undo .
     2157    define input parameter  p-col as integer   no-undo .
     2158     if p-val = ? then p-val =  "" .
     2159      put  stream macr_excel unformatted
     2160           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2161    end.
     2162   end procedure.
     2163   procedure macr_cell_format :
     2164    do
     2165    on error undo, return error return-value
     2166    :
     2167    define input parameter  p-size   as integer   no-undo .
     2168    define input parameter  p-bold   as logical   no-undo .
     2169    define input parameter  p-italic as logical   no-undo .
     2170    define input parameter  p-color  as integer   no-undo .
     2171    define input parameter  p-row    as integer   no-undo .
     2172    define input parameter  p-col    as integer   no-undo .
     2173    define input parameter  p-row-2  as integer   no-undo .
     2174    define input parameter  p-col-2  as integer   no-undo .
     2175     if p-size = ? then p-size = 10 .
     2176     if p-bold = ? then p-bold = false .
     2177     if p-italic = ? then p-italic = false .
     2178     if p-row-2 = ? then p-row-2 = p-row .
     2179     if p-col-2 = ? then p-col-2 = p-col .
     2180     put  stream macr_excel unformatted
     2181      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2182     if p-color <> ? then do:
     2183        put  stream macr_excel unformatted
     2184          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2185     end.
     2186     put  stream macr_excel unformatted
     2187          substitute('format.font(,&1,&2,&3)' , p-size,
     2188                                           string ( p-bold  , "true/false" ) ,
     2189                                           string ( p-italic , "true/false" )
     2190                                           ) + chr(10) .
     2191    end.
     2192   end procedure.
     2193   procedure macr_cell_size :
     2194    do
     2195    on error undo, return error return-value
     2196    :
     2197    define input parameter  p-w   as integer   no-undo .
     2198    define input parameter  p-l   as integer   no-undo .
     2199    define input parameter  p-row    as integer   no-undo .
     2200    define input parameter  p-col    as integer   no-undo .
     2201    define input parameter  p-row-2  as integer   no-undo .
     2202    define input parameter  p-col-2  as integer   no-undo .
     2203     if p-row-2 = ? then p-row-2 = p-row .
     2204     if p-col-2 = ? then p-col-2 = p-col .
     2205     if p-w = ? then    p-w = 0 .
     2206     if p-l = ? then    p-l = 0 .
     2207    define variable s-w as character no-undo .
     2208    define variable s-l as character no-undo .
     2209    if p-w = 0 then s-w = "" .
     2210               else s-w = string(p-w)  .
     2211    if p-l = 0 then s-l = "" .
     2212               else s-l = string(p-l)  .
     2213   put  stream macr_excel unformatted
     2214        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2215   put  stream macr_excel unformatted
     2216        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2217   put  stream macr_excel unformatted
     2218        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2219    end.
     2220   end procedure.
     2221   procedure proc-print-header :
     2222    do
     2223    on error undo, return error return-value
     2224    :
     2225      find first sheetf .
     2226        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2227        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2228        var-1 =  num#str# .
     2229        repeat c-c = 1 to sheetf.excel-row-title :
     2230        num#str# = num#str# + 1 .
     2231        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2232        do c-i = 1 to p-var :
     2233           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2234           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2235           num#col# = c-i .
     2236           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2237           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2238        end.
     2239       c-i = 0.
     2240       end.
     2241       run macr_cell_format (
     2242           10       ,
     2243           true     ,
     2244           false    ,
     2245           35       ,
     2246           var-1 + 1,
     2247           1        ,
     2248           num#str# ,
     2249           num#col# )
     2250           .
     2251     put  stream macr_excel unformatted
     2252          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2253          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2254          .
     2255    end.
     2256   end procedure.
     2257   procedure end-proc :
     2258    do
     2259    on error undo, return error return-value
     2260    :
     2261     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2262     OUTPUT to VALUE (v-file-name) .
     2263     for each temp-param :
     2264       export  temp-param  .
     2265     end.
     2266    end.
     2267   end procedure.
