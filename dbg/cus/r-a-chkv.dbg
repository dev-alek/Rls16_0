     1697   define variable temp1 as integer   no-undo.
     1698   define variable t-1 as character no-undo .
     1699   define variable t-2 as character no-undo .
     1700   define variable t-3 as character no-undo .
     1701   define variable t-4 as character no-undo .
     1702   define variable t-5 as character no-undo .
     1703   define variable v-shap as character no-undo .
     1704   if p-par = "'8':U"   then  v-shap = "Сумма аннуляции" .
     1705   if p-par = "'6':U" then v-shap = "Сумма возврата" .
     1706   DEFINE FRAME plan-menu
     1707       HEADER
     1708       string ( "Лист " + string ( PAGE-NUMBER (OutStream) , ">>>>9") ) AT 80 format "X (13)" SKIP
     1709       UndLine format "X (80)" AT 1
     1710       with width 235 down stream-io use-text NO-UNDERLINE  NO-BOX no-labels.
     1711     if session:set-wait-state ("compiler") then.
