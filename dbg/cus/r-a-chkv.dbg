      834   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      836   procedure paramls-clear :
      837     define buffer buf_temp-param for temp-param .
      838     do
      839     on error undo, return error return-value
      840     :
      841       for each buf_temp-param
      842       on error undo, return error
      843       :
      844         delete buf_temp-param .
      845       end.
      846     end.
      847   end procedure.
      848   procedure paramls-write :
      849     define input  parameter p-code     as character no-undo .
      850     define input  parameter p-sub-code as character no-undo .
      851     define input  parameter p-value    as character no-undo .
      852     define buffer buf_temp-param for temp-param .
      853     do
      854     on error undo, return error return-value
      855     :
      856       find first buf_temp-param
      857         where buf_temp-param.param-code     = p-code
      858           and buf_temp-param.param-sub-code = p-sub-code
      859         no-error .
      860       if not available buf_temp-param then do:
      861         create buf_temp-param .
      862         assign
      863           buf_temp-param.param-code     = p-code
      864           buf_temp-param.param-sub-code = p-sub-code
      865         .
      866       end.
      867       assign
      868         buf_temp-param.param-value = p-value
      869       .
      870     end.
      871   end procedure.
      872   procedure paramls-read :
      873     define input  parameter p-code          as character no-undo .
      874     define input  parameter p-sub-code      as character no-undo .
      875     define input  parameter p-default-value as character no-undo .
      876     define output parameter p-value         as character no-undo .
      877     define buffer buf_temp-param for temp-param .
      878     do
      879     on error undo, return error return-value
      880     :
      881       find first buf_temp-param
      882         where buf_temp-param.param-code     = p-code
      883           and buf_temp-param.param-sub-code = p-sub-code
      884         no-error .
      885       if available buf_temp-param then do:
      886         assign
      887           p-value = buf_temp-param.param-value
      888         .
      889       end.
      890       else do:
      891         assign
      892           p-value = p-default-value
      893         .
      894       end.
      895     end.
      896   end procedure.
      897   procedure paramls-append :
      898     define input  parameter p-code     as character no-undo .
      899     define input  parameter p-sub-code as character no-undo .
      900     define input  parameter p-value    as character no-undo .
      901     define buffer buf_temp-param for temp-param .
      902     do
      903     on error undo, return error return-value
      904     :
      905       find first buf_temp-param
      906            where buf_temp-param.param-code     = p-code
      907              and buf_temp-param.param-sub-code = p-sub-code
      908         no-error .
      909       if not available buf_temp-param then do:
      910         create buf_temp-param .
      911         assign
      912           buf_temp-param.param-code     = p-code
      913           buf_temp-param.param-sub-code = p-sub-code
      914           buf_temp-param.param-value    = p-value
      915         .
      916       end.
      917       else do:
      918           assign
      919               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      920           .
      921       end.
      922     end.
      923   end procedure.
      924   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      925     if num-entries(string(p-dec), '.') = 2
      926       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      927       else return( string(p-dec)) .
      928   end function.
      929   function format-point-to-comma returns char (input orig as char ) .
      930   define variable rtext as character no-undo .
      931   define variable strt as integer no-undo .
      932   define variable leng as integer no-undo .
      933   assign rtext = orig .
      934   repeat:
      935     strt =  index(rtext,'.').
      936     if strt = 0 then leave.
      937     leng = 1.
      938     substring(rtext,strt,leng,"character") = v-delim .
      939   end.
      940   return rtext.
      941   end function.
      942   function format-excel-text returns char ( input start-text as char ) :
      943   def var  i    as int no-undo.
      944   def var  ch   as char no-undo.
      945   def var  n    as int no-undo.
      946   def var  ipos as int no-undo.
      947     n = num-entries(trim(start-text), chr(10)) - 1 .
      948     do i = 1 to n :
      949       ipos = index( start-text, chr(10)).
      950       if ipos > 0 then
      951         substr( start-text, ipos, 1 ) = ' '.
      952     end.
      953     n = num-entries(trim(start-text), chr(13)) - 1 .
      954     do i = 1 to n :
      955       ipos = index( start-text, chr(13)).
      956       if ipos > 0 then
      957         substr( start-text, ipos, 1 ) = ' '.
      958     end.
      959     if index( start-text, '"' ) = 0 then
      960       start-text =  '="'   + trim( start-text) + '"'   .
      961       else do:
      962         n = num-entries(trim(start-text), '"') - 1.
      963         do i = 1 to n :
      964           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      965         end.
      966         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      967         start-text = '="'  + ch  + '"' .
      968       end.
      969     return start-text.
      970   end.
      971   function excel-sum returns char (input p-dec as decimal ).
      972     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      973   end function.
      974   function excel-qnty returns char (input p-dec as decimal ).
      975     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      976   end function.
      977   function format-excel-text-macr returns char ( input start-text as char ) :
      978   def var  i    as int no-undo.
      979   def var  ch   as char no-undo.
      980   def var  n    as int no-undo.
      981   def var  ipos as int no-undo.
      982     n = num-entries(trim(start-text), chr(10)) - 1 .
      983     do i = 1 to n :
      984       ipos = index( start-text, chr(10)).
      985       if ipos > 0 then
      986         substring( start-text, ipos , 1 ) = ' '.
      987     end.
      988     n = num-entries(trim(start-text), chr(13)) - 1 .
      989     do i = 1 to n :
      990       ipos = index( start-text, chr(13)).
      991       if ipos > 0 then
      992         substring( start-text, ipos, 1 ) = ' '.
      993     end.
      994     if index( start-text, '"' ) = 0 then
      995       start-text =  '"'   + trim( start-text) + '"'   .
      996       else do:
      997         n = num-entries(trim(start-text), '"') - 1.
      998         do i = 1 to n :
      999           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1000         end.
     1001         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1002         start-text = '"'  + ch  + '"' .
     1003       end.
     1004     n = num-entries(trim(start-text), chr(10)) - 1 .
     1005     do i = 1 to n :
     1006       ipos = index( start-text, chr(10)).
     1007       if ipos > 0 then
     1008         substring( start-text, ipos , 1 ) = ' '.
     1009     end.
     1010       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1011     return start-text.
     1012   end.
