      800   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   function breakstr returns character ( input        for-name    as character,
      802                                         input        line-length as integer,
      803                                         input-output line1       as character,
      804                                         input-output line2       as character ) :
      805     define variable ii as integer no-undo.
      806     if length( for-name ) > line-length then do:
      807       assign ii    = 1
      808              line1 = "":u
      809              line2 = "":u.
      810       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      811         assign line1 =       substring( for-name, 1, line-length     )
      812                line2 = trim( substring( for-name,    line-length + 1 ) ).
      813       end.                                                     else do:
      814         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      815           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      816                  ii    = ii    + 1.
      817           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      818             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      819           end.
      820         end.
      821         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      822       end.
      823     end.                                else do:
      824       assign line1 = for-name
      825              line2 = "":u.
      826     end.
      827     return ( line1 ).
      828   end function.
      829       def var t-addres        like ub.firm.addres1   no-undo.
      830       def var t-phone         like ub.firm.phone     no-undo.
      831       def var t-inn           like ub.firm.inn       no-undo.
      832       def var t-okpo          like ub.firm.okpo      no-undo.
