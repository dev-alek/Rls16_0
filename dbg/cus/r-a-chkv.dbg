     1676   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1677   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1678   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1679   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1680   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1681   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1682   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1683   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1684   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1685   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1686   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1687   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1688   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
