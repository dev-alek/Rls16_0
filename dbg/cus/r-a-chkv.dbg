     1764   end.
     1765       run paramls-write in this-procedure
     1766            (input "charcol"
     1767           ,input ""
     1768           ,input "2,3,4,5,7"
     1769           ) .
     1770     run end-proc .
     1771     define variable v-user-action as character no-undo .
