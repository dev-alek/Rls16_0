     1206   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   procedure factord :
     1208     define input  parameter p-fact-date            as date    no-undo .
     1209     define input  parameter p-fact-time            as integer no-undo .
     1210     define input  parameter p-fact-num             as integer no-undo .
     1211     define input  parameter p-shift-date           as date    no-undo .
     1212     define input  parameter p-shift-num            as integer no-undo .
     1213     define input  parameter p-shift-on             as logical no-undo .
     1214     define output parameter p-fact-order           as decimal no-undo .
     1215     define output parameter p-shift-end-fact-order as decimal no-undo .
     1216     define output parameter p-day-end-fact-order   as decimal no-undo .
     1217     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1218     if p-fact-date = ?
     1219     then do:
     1220       return error "Не указана фактическая дата" .
     1221     end.
     1222     define variable v-fact-date-num as integer no-undo .
     1223     assign
     1224       v-fact-date-num = integer(p-fact-date)
     1225     .
     1226     if p-fact-num = ?
     1227     or p-fact-num = 0
     1228     then do:
     1229       return error "Не задан p-fact-num " + string(p-fact-num) .
     1230     end.
     1231     if p-fact-num < 0
     1232     then do:
     1233       return error "Отрицательный fact-num " + string(p-fact-num) .
     1234     end.
     1235     if p-fact-num >= 100000000
     1236     then do:
     1237       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1238     end.
     1239     if p-shift-on = true
     1240     then do:
     1241       if p-shift-date = ?
     1242       then do:
     1243         return error "Не задана дата смены" .
     1244       end.
     1245       if p-shift-num = ?
     1246       or p-shift-num = 0
     1247       then do:
     1248         return error "Не задан номер смены" .
     1249       end.
     1250     end.
     1251     else do:
     1252       assign
     1253         p-shift-date = p-fact-date
     1254         p-shift-num  = 24
     1255       .
     1256     end.
     1257     define variable v-shift-offset as integer no-undo .
     1258     if p-shift-date = p-fact-date
     1259     then do:
     1260       assign
     1261         v-shift-offset = 1
     1262       .
     1263     end.
     1264     if p-shift-date < p-fact-date
     1265     then do:
     1266       assign
     1267         v-shift-offset = 0
     1268       .
     1269     end.
     1270     if p-shift-date > p-fact-date
     1271     then do:
     1272       message
     1273         vss-workfile vss-revision vss-description skip
     1274         "Неправильная дата закрытия смены" skip
     1275         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1276         view-as alert-box error .
     1277       undo, return error
     1278         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1279           ,string(p-fact-date, '99/99/9999':U)
     1280           ,string(p-shift-date, '99/99/9999':U)
     1281           )
     1282       .
     1283     end.
     1284     if p-shift-num < 1
     1285     or p-shift-num > 24
     1286     then do:
     1287       message
     1288         vss-workfile vss-revision vss-description skip
     1289         "Неправильный номер смены" skip
     1290         "p-shift-num" p-shift-num skip
     1291         view-as alert-box error .
     1292       undo, return error return-value .
     1293     end.
     1294     assign
     1295       p-fact-order           = v-fact-date-num
     1296                              + v-shift-offset * 0.5
     1297                              + p-shift-num    * 0.02 - 0.01
     1298                              + p-fact-num     * 0.0000000001
     1299       p-shift-end-fact-order = v-fact-date-num
     1300                              + v-shift-offset * 0.5
     1301                              + p-shift-num    * 0.02
     1302       p-day-end-fact-order   = v-fact-date-num
     1303                              + 0.99
     1304     .
     1305     if p-fact-order           <= v-fact-date-num
     1306     or p-shift-end-fact-order <= v-fact-date-num
     1307     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1308     or p-shift-end-fact-order >= p-day-end-fact-order
     1309     then do:
     1310       message
     1311         vss-workfile vss-revision vss-description skip
     1312         "Внутренняя ошибка при генерации фактического номера" skip
     1313         "p-fact-date"            p-fact-date            skip
     1314         "p-fact-time"            p-fact-time            skip
     1315         "p-fact-num"             p-fact-num             skip
     1316         "p-shift-date"           p-shift-date           skip
     1317         "p-shift-num"            p-shift-num            skip
     1318         "p-shift-on"             p-shift-on             skip
     1319         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1320         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1321         "v-fact-date-num"        v-fact-date-num        skip
     1322         view-as alert-box error .
     1323       undo, return error return-value .
     1324     end.
     1325   end procedure.
     1326   procedure day-begin-fact-order :
     1327     define input  parameter p-fact-date            as date    no-undo .
     1328     define output parameter p-day-begin-fact-order as decimal no-undo .
     1329     do
     1330     on error undo, return error return-value
     1331     :
     1332       if p-fact-date = ?
     1333       then do:
     1334         assign
     1335           p-day-begin-fact-order = 0
     1336         .
     1337       end.
     1338       else do:
     1339         assign
     1340           p-day-begin-fact-order = integer(p-fact-date)
     1341         .
     1342       end.
     1343     end.
     1344   end procedure.
     1345   procedure factord-max-fact-order :
     1346     define output parameter p-max-fact-order as decimal   no-undo .
     1347     do
     1348     on error undo, return error return-value
     1349     :
     1350       run day-begin-fact-order in this-procedure
     1351         (input  date(1, 1, 5000)
     1352         ,output p-max-fact-order
     1353         ) .
     1354     end.
     1355   end procedure.
     1356   procedure factord-cut-archive :
     1357     define input  parameter p-obj-type             as character no-undo .
     1358     define input  parameter p-obj-code             as integer   no-undo .
     1359     define input  parameter p-fact-date            as date      no-undo .
     1360     define output parameter p-shift-on             as logical   no-undo .
     1361     define output parameter p-shift-date           as date      no-undo .
     1362     define output parameter p-shift-num            as integer   no-undo .
     1363     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1364     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1365     define variable v-fact-order as decimal   no-undo .
     1366     define buffer buf_shift-obj for ub.shift-obj .
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1372     (input  p-obj-type
     1373     ,input  p-obj-code
     1374     ,input  'shift-on=request'
     1375     ,output p-shift-on
     1376     ) no-error .
     1377       if error-status :error
     1378       then do:
     1379         message
     1380           vss-workfile vss-revision vss-description skip
     1381           "Ошибка при определении атрибута объекта" skip
     1382           "Объект" p-obj-type p-obj-code skip
     1383           error-status :get-message(1) skip
     1384           return-value skip
     1385           view-as alert-box error .
     1386         undo, return error return-value .
     1387       end.
     1388       if p-shift-on = false
     1389       then do:
     1390         assign
     1391           p-shift-date               = ?
     1392           p-shift-num                = 0
     1393         .
     1394       end.
     1395       else do:
     1396         find first buf_shift-obj share-lock
     1397           where buf_shift-obj.obj-type   = p-obj-type
     1398             and buf_shift-obj.obj-code   = p-obj-code
     1399             and buf_shift-obj.shift-date > p-fact-date
     1400           use-index pi
     1401           no-error .
     1402         if not available buf_shift-obj
     1403         or buf_shift-obj.status_ <> 'зкр':U
     1404         then do:
     1405           message
     1406             vss-workfile vss-revision vss-description skip
     1407             "Невозможно вычислить последнюю смену" skip
     1408             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1409             "Объект" p-obj-type p-obj-code skip
     1410             "Дата" p-fact-date skip
     1411             view-as alert-box error .
     1412           undo, return error return-value .
     1413         end.
     1414         find last buf_shift-obj share-lock
     1415           where buf_shift-obj.obj-type = p-obj-type
     1416             and buf_shift-obj.obj-code = p-obj-code
     1417             and buf_shift-obj.shift-date <= p-fact-date
     1418           use-index pi
     1419           no-error .
     1420         if available buf_shift-obj
     1421         then do:
     1422           if  buf_shift-obj.status_ = 'зкр':U
     1423           then do:
     1424             assign
     1425               p-shift-date = buf_shift-obj.shift-date
     1426               p-shift-num  = buf_shift-obj.shift-num
     1427             .
     1428           end.
     1429           else do:
     1430             message
     1431               vss-workfile vss-revision vss-description skip
     1432               "Невозможно вычислить последнюю смену" skip
     1433               "Статус смены отличен от статуса" 'зкр':U skip
     1434               "Объект" p-obj-type p-obj-code skip
     1435               "Дата" p-fact-date skip
     1436               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1437               view-as alert-box error .
     1438             undo, return error return-value .
     1439           end.
     1440         end.
     1441         else do:
     1442           assign
     1443             p-shift-date = p-fact-date - 1
     1444             p-shift-num  = 1
     1445           .
     1446         end.
     1447       end.
     1448       run factord in this-procedure
     1449         (input  p-fact-date
     1450         ,input  1
     1451         ,input  1
     1452         ,input  p-shift-date
     1453         ,input  p-shift-num
     1454         ,input  p-shift-on
     1455         ,output v-fact-order
     1456         ,output p-shift-end-fact-order
     1457         ,output p-day-end-fact-order
     1458         ) no-error .
     1459       if error-status :error
     1460       then do:
     1461         message
     1462           vss-workfile vss-revision vss-description skip
     1463           "Ошибка при вызове процедуры factord"
     1464           error-status :get-message(1) skip
     1465           return-value skip
     1466           view-as alert-box error .
     1467         undo, return error return-value .
     1468       end.
     1469     end.
     1470   end procedure.
     1471   procedure factord-lock-shift :
     1472     define input  parameter p-obj-type  as character no-undo .
     1473     define input  parameter p-obj-code  as integer   no-undo .
     1474     define input  parameter p-fact-date as date      no-undo .
     1475     define parameter buffer buf_shift-obj for ub.shift-obj .
     1476     define variable v-shift-on      as logical   no-undo .
     1477     define variable v-extra-message as character no-undo .
     1478     define variable v-error as character no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1484     (input  p-obj-type
     1485     ,input  p-obj-code
     1486     ,input  'shift-on=request'
     1487     ,output v-shift-on
     1488     ) no-error .
     1489       if error-status :error
     1490       then do:
     1491         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1492         undo, return error v-error .
     1493       end.
     1494       if v-shift-on = true
     1495       then do:
     1496         find first buf_shift-obj share-lock
     1497           where buf_shift-obj.obj-type   = p-obj-type
     1498             and buf_shift-obj.obj-code   = p-obj-code
     1499             and buf_shift-obj.shift-date > p-fact-date
     1500           use-index pi
     1501           no-error .
     1502         if not available buf_shift-obj
     1503         or buf_shift-obj.status_ <> 'зкр':U
     1504         then do:
     1505           find last buf_shift-obj
     1506             where buf_shift-obj.obj-type = p-obj-type
     1507               and buf_shift-obj.obj-code = p-obj-code
     1508               and buf_shift-obj.status_  = 'зкр':U
     1509             use-index stts
     1510             no-error .
     1511           if available buf_shift-obj
     1512           then do:
     1513             assign
     1514               v-extra-message =
     1515                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1516                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1517                               )
     1518             .
     1519           end.
     1520           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1521           undo, return error v-error .
     1522         end.
     1523       end.
     1524     end.
     1525   end procedure.
     1526   procedure factord-end-day :
     1527     define input  parameter p-fact-date            as date    no-undo .
     1528     define output parameter p-day-end-fact-order   as decimal no-undo .
     1529     do
     1530     on error undo, return error return-value
     1531     :
     1532       if p-fact-date = ?
     1533       then do:
     1534         return error "Не указана фактическая дата" .
     1535       end.
     1536       assign
     1537         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1538       .
     1539     end.
     1540   end procedure.
     1541   procedure factord-to-date :
     1542     define input  parameter p-fact-order as decimal no-undo .
     1543     define output parameter p-fact-date  as date    no-undo .
     1544     define variable v-ref-date  as date      no-undo .
     1545     define variable v-ref-delta as integer   no-undo .
     1546     do
     1547     on error undo, return error return-value
     1548     :
     1549       if p-fact-order = ?
     1550       or p-fact-order = 0
     1551       then do:
     1552         return error "Не указан fact-order" .
     1553       end.
     1554       assign
     1555         v-ref-date  = date(1, 1, 2000)
     1556       .
     1557       assign
     1558         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1559       .
     1560       assign
     1561         p-fact-date = v-ref-date + v-ref-delta
     1562       .
     1563     end.
     1564   end procedure.
     1565   procedure factord-to-fact-num :
     1566     define input  parameter p-fact-order as decimal no-undo .
     1567     define output parameter p-fact-num   as integer no-undo .
     1568     define variable v-fact-order-trunc as decimal no-undo .
     1569     do
     1570     on error undo, return error return-value
     1571     :
     1572       if p-fact-order = ?
     1573       or p-fact-order = 0
     1574       then do:
     1575         return error "Не указан fact-order" .
     1576       end.
     1577       assign
     1578        v-fact-order-trunc = truncate(p-fact-order, 2)
     1579       .
     1580       assign
     1581         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1582       .
     1583     end.
     1584   end procedure.
     1585   procedure factord-to-shift-num :
     1586     define input  parameter p-fact-order as decimal no-undo .
     1587     define output parameter p-shift-num   as integer no-undo .
     1588     define variable  p-shift-numd  as decimal   no-undo .
     1589     define variable v-fact-order-trunc as decimal no-undo .
     1590     do
     1591     on error undo, return error return-value
     1592     :
     1593       if p-fact-order = ?
     1594       or p-fact-order = 0
     1595       then do:
     1596         return error "Не указан fact-order" .
     1597       end.
     1598       assign
     1599        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1600       .
     1601       if v-fact-order-trunc < 0.5 then do:
     1602         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1603       end.
     1604       assign
     1605         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1606         .
     1607        assign
     1608         p-shift-num = truncate (p-shift-numd , 0)
     1609       .
     1610     end.
     1611   end procedure.
