     1041        SIZE 55.13 BY 4.46.
     1042   DEFINE FRAME InfoFrame
     1043        StopBtn AT ROW 4.25 COL 21.75
     1044        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1045        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1046        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1047        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1048        RECT-1 AT ROW 1 COL 1
     1049       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1050            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1051            TITLE "Процесс"
     1052            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1053   define variable mFrameView      as logical   no-undo init yes.
     1054     define variable mFramHandle as handle no-undo.
     1055     mFramHandle = frame InfoFrame:handle.
     1056     if  log-manager:logfile-name ne ?
     1057     then DO:
     1058         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1059         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1060         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1061     end.
     1062     mFrameView = not session:batch-mode and mFramHandle:visible.
     1063     if mFrameView
     1064     then do:
     1065       ASSIGN
     1066          FRAME InfoFrame:HIDDEN                           = TRUE
     1067          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1068     end.
     1069   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1070   DO:
     1071     IF not StopProcessing THEN
     1072       Message "Вы действительно хотите прервать" SKIP
     1073               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1074                 UPDATE StopProcessing.
     1075     IF StopProcessing THEN do:
     1076        if mFrameView
     1077        then do:
     1078           HIDE FRAME InfoFrame.
     1079        end.
     1080     End.
     1081   END.
     1082   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1083     if  log-manager:logfile-name ne ?
     1084     then DO:
     1085         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1086     end.
     1087     if not session:batch-mode then
     1088     do:
     1089       VIEW FRAME InfoFrame.
     1090       mFrameView = true.
     1091     end.
     1092      v-button-stop = false .
     1093         if mFrameView
     1094         then do:
     1095         if v-button-stop then view STOPBTN in frame InfoFrame.
     1096                          else Hide STOPBTN in frame InfoFrame.
     1097         end.
