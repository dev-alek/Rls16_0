     1742         for each tt-temp where tt-temp.obj-type = obj-list.obj-type and tt-temp.obj-code = obj-list.obj-code :
     1743             run print-line .
     1744         end.
     1745         run print-obj-itog.
     1746     end.
     1747     run print-all-itog in this-procedure .
