     1731   FORM with frame plan-menu .
     1732       Output stream Macr_Excel  close .
     1733       num#str# = 0 .
     1734       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1735       output stream macr_excel to value (v-file-name)   .
     1736       v-ind = v-ind + 1.
     1737     find ub.clients      where ub.clients.obj-type     = 'орг':U            and ub.clients.obj-code      = parhost-code no-lock .
     1738     run PrintTitul in this-procedure .
