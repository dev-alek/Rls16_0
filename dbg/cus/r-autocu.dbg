      685   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   define variable v-waitfram-action01         as character   no-undo .
      687   define variable v-waitfram-action02         as character   no-undo .
      688   define variable v-waitfram-action03         as character   no-undo .
      689   define variable mWaitFramTextBeg            as character   no-undo.
      690   define variable mWaitFramTextEnd            as character   no-undo.
      691   define variable mWaitFramView               as logical     no-undo.
      692   define variable mWaitProcEvent              as logical     no-undo init yes.
      693   define variable mWaitFramInterval           as integer     no-undo init 1 .
      694   define variable mWaitFramStop               as logical     no-undo.
      695   define variable mWaitFramStopUser           as logical     no-undo.
      696   define variable mWaitFramStopTimeOut        as logical     no-undo.
      697   define variable mWaitFramStartProc          as datetime-tz no-undo.
      698   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      699   define button B-WaitFramStop auto-end-key
      700        label "Стоп"
      701        size 10 by 1 tooltip "Остоновить процесс".
      702   define button B-viewProcInfo
      703        label "Информация"
      704        size 15 by 1 tooltip "Информация о процесс".
      705   define frame waitfram
      706     v-waitfram-action01 format "x(72)" no-label skip
      707     v-waitfram-action02 format "x(72)" no-label skip
      708     v-waitfram-action03 format "x(72)" no-label skip
      709     B-viewProcInfo
      710     B-WaitFramStop at row 4 col 30
      711     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      712     .
      713   define new global shared variable mBatchMode as logical no-undo init ?.
      714   define variable mFramBachModHandle as handle no-undo.
      715   mFramBachModHandle = frame waitfram:handle.
      716   define variable mFameOldVis as logical no-undo.
      717   define variable mVisCUrentVin as logical no-undo.
      718   if session:batch-mode
      719   then
      720      mBatchMode = yes.
      721   if mBatchMode = ? then do:
      722     mVisCUrentVin = current-window:visible.
      723     mFameOldVis = mFramBachModHandle:visible.
      724     mFramBachModHandle:visible  = yes.
      725     mBatchMode = mFramBachModHandle:visible ne yes.
      726     mFramBachModHandle:visible = mFameOldVis.
      727     current-window:visible = mVisCUrentVin.
      728   end.
      729    if  log-manager:logfile-name ne ?
      730     then DO:
      731         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      732         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      733         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      734     end.
      735   on choose of B-WaitFramStop in frame waitfram
      736   do:
      737     mWaitFramStop = yes.
      738     mWaitFramStopUser = yes.
      739   end.
      740   function waitfram-check-timeout returns logical():
      741      define variable vtime as int64 no-undo.
      742      if mWaitFramStopTimeOut
      743      then
      744         return yes.
      745      vtime = ( now - mWaitFramStartProc ) / 1000 .
      746      if     mWaitFramTimeOut ne ?
      747         and mWaitFramTimeOut ne 0
      748         and mWaitFramTimeOut lt vtime
      749      then do:
      750         mWaitFramStopTimeOut = yes.
      751      end.
      752      return mWaitFramStopTimeOut.
      753   end.
      754   procedure waitfram-hide :
      755     if not session:batch-mode
      756     then do
      757     on error undo, return error return-value
      758     :
      759       pause 0 before-hide .
      760       if not mBatchMode then
      761         hide frame waitfram .
      762     if     not mWaitFramView
      763        and mWaitProcEvent
      764     then
      765       process events .
      766     end.
      767   end procedure.
      768   procedure waitfram-show :
      769     define input  parameter p-message as character no-undo .
      770     define variable v-left-margin as integer   no-undo .
      771     if not session:batch-mode
      772     then do
      773     on error undo, return error return-value
      774     :
      775       if length(p-message) <= 70 then do:
      776         assign
      777           v-left-margin = integer((70 - length(p-message)) / 2)
      778         .
      779         assign
      780           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      781         .
      782         assign
      783           v-waitfram-action01 = " "
      784           v-waitfram-action02 = " "
      785                                    + fill(" ", v-left-margin)
      786                                    + p-message
      787           v-waitfram-action03 = " "
      788         .
      789       end.
      790       else do:
      791         define variable vRindex1 as integer no-undo.
      792         define variable vRindex2 as integer no-undo.
      793         vRindex1 = r-index(p-message," ",70).
      794         if vRindex1 = 0
      795         then
      796            vRindex1 = 70.
      797         if length(p-message)  <= vRindex1 + 70 then do:
      798           assign
      799             v-waitfram-action01 = " "
      800             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      801             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      802           .
      803         end.
      804         else do:
      805           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      806           if vRindex2 <= vRindex1
      807           then
      808              vRindex2 = vRindex1 + 70.
      809           assign
      810             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      811             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      812             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      813           .
      814         end.
      815       end.
      816       B-viewProcInfo:visible   in frame waitfram = no.
      817       B-viewProcInfo:sensitive in frame waitfram = no.
      818       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      819       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      820       if  (   mWaitFramView
      821          or  mWaitProcEvent)
      822          and not mBatchMode
      823       then
      824          display
      825             v-waitfram-action01 skip
      826             v-waitfram-action02 skip
      827             v-waitfram-action03 skip
      828          with frame waitfram .
      829       if     mWaitFramView
      830          then do:
      831             if     mWaitFramInterval ne ?
      832                and not mBatchMode
      833             then
      834                wait-for go of frame waitfram pause mWaitFramInterval.
      835          end.
      836          else
      837             if     mWaitProcEvent
      838                and not mBatchMode
      839             then
      840                process events .
      841     end.
      842   end procedure.
      843      procedure waitfram-show-this:
      844         define input  parameter iInterval as int64 no-undo.
      845         define variable vtime as int64 no-undo.
      846         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      847         mWaitFramInterval = iInterval.
      848         run waitfram-show (substitute("&1&2 &3&4" ,
      849                                       mWaitFramTextBeg ,
      850                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      851                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      852                                       mWaitFramTextEnd
      853                                      )
      854                           ).
      855      end.
      856      procedure WaitFramRunPause:
      857         define input  parameter iInterval as dec no-undo.
      858         define variable vStart  as datetime-tz no-undo.
      859         define variable vend    as datetime-tz no-undo.
      860         define variable vint as int64 no-undo.
      861         define variable vOk as logical no-undo.
      862         vStart = now.
      863         vend   = vStart.
      864         publish "WaitFramPause" (iInterval,output vOk).
      865         vend   =  now.
      866         vint = vend - vStart.
      867         vint = iInterval - vint / 1000.
      868         if     not mWaitFramStop
      869            and (   vint > 0
      870                 or (    not vOk
      871                     and iInterval eq ?
      872                     )
      873                 )
      874         then
      875            run waitfram-show-this (iInterval).
      876         vend   =  now.
      877         vint = vend - vStart.
      878         vint = iInterval - vint / 1000.
      879         if     not mWaitFramStop
      880            and vint > 0
      881         then do:
      882            run gbl/pause.p (vint * 1000).
      883         end.
      884         if iInterval ne ?
      885         then
      886            publish "WaitFramStop".
      887         waitfram-check-timeout().
      888      end.
      889      procedure WaitFramWaitFor:
      890         define input  parameter iInterval as dec no-undo.
      891         assign
      892            mWaitFramStartProc   = now
      893            mWaitFramStopUser    = no
      894            mWaitFramStopTimeOut = no
      895         .
      896         block-wait:
      897         do while not mWaitFramStop:
      898            run WaitFramRunPause (iInterval).
      899            if  waitfram-check-timeout()
      900            then do:
      901               leave block-wait.
      902            end.
      903         end.
      904         run waitfram-hide.
      905      end.
      906   procedure waitfram-join :
      907     define input  parameter p-line-1  as character no-undo .
      908     define input  parameter p-line-2  as character no-undo .
      909     define input  parameter p-line-3  as character no-undo .
      910     define output parameter p-message as character no-undo .
      911     do
      912     on error undo, return error return-value
      913     :
      914       assign
      915         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      916                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      917                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      918       .
      919     end.
      920   end procedure.
      921   function waitfram-join-function returns character
      922     (input p-line-1 as character
      923     ,input p-line-2 as character
      924     ,input p-line-3 as character
      925     ).
      926     define variable v-message as character no-undo .
      927     run waitfram-join in this-procedure
      928       (input  p-line-1
      929       ,input  p-line-2
      930       ,input  p-line-3
      931       ,output v-message
      932       ) .
      933     return v-message .
      934   end function .
      935   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      936   define  stream PrnLibStream.
