      654   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   define NEW SHARED temp-table temp-cpa-pcep no-undo
      656   field cdpay-code like ub.cash-pay.cdpay-code
      657   field curr-code like ub.cash-pay.cdpay-code
