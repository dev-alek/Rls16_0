        1   block-level on error undo, throw.
        2   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision: aea5316774be, 0, rls $":U.
        3   define variable vss-author      AS CHAR NO-UNDO INIT "$Author: expertek $":U.
        4   define variable vss-date        AS CHAR NO-UNDO INIT "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        5   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile: r-autocu.p $":U.
        6   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive: cus/r-autocu.p $":U.
        7   define variable vss-description AS CHAR NO-UNDO INIT "$Отчет для лотереи АВТОКУШ $":U.
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   def
       79    shared
       80   temp-table  obj-list no-undo
       81     field obj-type like ub.clients.obj-type
       82     field obj-code like ub.clients.obj-code
       83     field obj-name like ub.clients.obj-name
       84     field obj-id   as integer
       85     field db-num   as integer
       86     index pi is primary unique obj-id
       87     index ie1 obj-type obj-code
       88     index ie2 obj-name
       89   .
       90   procedure create_obj-list :
       91      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       92      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       93      do
       94      on error undo, return error return-value
       95      :
       96         define buffer cli-obj for ub.clients .
       97         define variable p-var as integer no-undo .
       98         define buffer buf_obj-list for obj-list .
       99         find last buf_obj-list  use-index pi no-error .
      100         if available buf_obj-list
      101         then
      102            p-var = buf_obj-list.obj-id + 1.
      103         else
      104            p-var = 1.
      105         find first cli-obj where
      106                   cli-obj.obj-type = p-obj-type
      107               and cli-obj.obj-code = p-obj-code
      108         no-lock no-error.
      109         if available cli-obj
      110         then do:
      111            create buf_obj-list.
      112            assign
      113               buf_obj-list.obj-id   = p-var
      114               buf_obj-list.obj-code = cli-obj.obj-code
      115               buf_obj-list.obj-type = cli-obj.obj-type
      116               buf_obj-list.obj-name = cli-obj.obj-name
      117               buf_obj-list.db-num   = cli-obj.db-num
      118            .
      119         end.
      120      end.
      121   end.
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   procedure cur-time :
      125      define output parameter p-today as date      no-undo .
      126      define output parameter p-time  as integer   no-undo .
      127     do
      128     on error undo, return error
      129     :
      130       define variable v-date1 as date      no-undo .
      131       define variable v-date2 as date      no-undo .
      132       define variable v-time  as integer   no-undo .
      133       assign
      134         v-date1 = today
      135         v-time  = time
      136         v-date2 = today
      137       .
      138       if v-date1 <> v-date2
      139       then do:
      140         assign
      141           v-date1 = today
      142           v-time  = v-time
      143         .
      144       end.
      145       assign
      146         p-today = v-date1
      147         p-time  = v-time
      148       .
      149     end.
      150   end.
      151   function cur-time-date returns character
      152   :
      153     return string(today, '99/99/9999':U) .
      154   end.
      155   function cur-time-mjd returns decimal
      156   :
      157     define variable v-date as date      no-undo .
      158     define variable v-time as integer   no-undo .
      159     run cur-time in this-procedure
      160       (output v-date
      161       ,output v-time
      162       ) .
      163     return integer(v-date) - 2400002 + (v-time / 86400) .
      164   end.
      165   function cur-time-get-ending-index returns integer
      166   (input p-number as integer
      167   )
      168   :
      169     if p-number < 0
      170     or p-number = ?
      171     then do:
      172       return 1 .
      173     end.
      174     define variable v-rest as integer   no-undo .
      175     assign
      176       p-number = p-number modulo 100
      177     .
      178     if p-number < 20
      179     then do:
      180       assign
      181         v-rest = p-number
      182       .
      183     end.
      184     else do:
      185       assign
      186         v-rest = p-number modulo 10
      187       .
      188     end.
      189     case v-rest :
      190       when 1
      191       then do:
      192         return 2 .
      193       end.
      194       when 2 or
      195       when 3 or
      196       when 4
      197       then do:
      198         return 3 .
      199       end.
      200       otherwise do:
      201         return 1 .
      202       end.
      203     end case .
      204   end.
      205   procedure cur-time-mjd-to-date :
      206      define input  parameter i-mjd-diff as decimal no-undo.
      207      define output parameter o-Date     as date    no-undo.
      208      define output parameter o-Time     as integer no-undo.
      209      define variable v-day-number as integer   no-undo .
      210      if    i-mjd-diff < 0
      211         or i-mjd-diff = ?
      212      then do:
      213         return "?" .
      214      end.
      215      assign
      216         v-day-number = truncate(i-mjd-diff,0).
      217         o-Date = date(v-day-number + 2400002).
      218         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      219     .
      220   end.
      221   function cur-time-mjd-to-string returns character
      222   (input p-mjd-diff as decimal
      223   )
      224   :
      225     define variable v-day-number as integer   no-undo .
      226     define variable v-seconds    as integer   no-undo .
      227     define variable v-hour       as integer   no-undo .
      228     define variable v-min        as integer   no-undo .
      229     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      230     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      231     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      232     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      233     if p-mjd-diff < 0
      234     or p-mjd-diff = ?
      235     then do:
      236       return "?" .
      237     end.
      238     assign
      239       v-day-number = integer(truncate(p-mjd-diff,0))
      240       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      241     .
      242     if v-seconds > 86400
      243     then do:
      244       assign
      245         v-seconds = 86400 - 1
      246       .
      247     end.
      248     if v-seconds < 0
      249     then do:
      250       assign
      251         v-seconds = 0
      252       .
      253     end.
      254     assign
      255       v-hour = truncate(v-seconds / 3600, 0)
      256     .
      257     assign
      258       v-seconds = v-seconds modulo 3600
      259     .
      260     assign
      261       v-min = truncate(v-seconds / 60, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 60
      265     .
      266     return
      267         (if v-day-number <> 0
      268           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      269           else ""
      270         )
      271       + (if v-day-number <> 0 or v-hour <> 0
      272           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      273           else ""
      274         )
      275       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      276           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      277           else ""
      278         )
      279       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      280       .
      281   end.
      282   function cur-time-string returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-string-sec returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      301   end.
      302   function cur-time-custom  returns character
      303   (input p-prefix as character
      304   ,input p-date-format as character
      305   ,input p-delimiter as character
      306   ,input p-time-format as character
      307   ,input p-suffix as character
      308   )
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return
      317       p-prefix
      318       + string(v-date, p-date-format)
      319       + p-delimiter
      320       + string(v-time, p-time-format)
      321       + p-suffix
      322       .
      323   end.
      324   function cur-time-print  returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      333   end.
      334   function cur-time-datetime returns datetime
      335   :
      336     define variable v-char as character no-undo .
      337     define variable v-datetime as datetime no-undo .
      338     v-char = cur-time-string().
      339     v-datetime = datetime(v-char).
      340     return  v-datetime.
      341   end.
      342   function cur-time-string-msec returns character
      343   :
      344     define variable v-date as datetime  no-undo .
      345     v-date = now.
      346     return string(v-date) .
      347   end.
      348   procedure cp-attr-code :
      349     do
      350     on error undo, return error
      351     :
      352       define input  parameter p-code           as character no-undo .
      353       define output parameter p-type           as character no-undo .
      354       define output parameter p-format         as character no-undo .
      355       define output parameter p-label          as character no-undo .
      356       define output parameter p-range          as integer   no-undo .
      357       define output parameter p-user-can-edit  as logical   no-undo .
      358       define output parameter p-output-display as logical   no-undo .
      359       define output parameter p-other          as character no-undo .
      360       case p-code :
      361               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      362               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      363               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      364               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      365               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      366               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      367               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      368               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      369               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      370               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      371         otherwise do:
      372           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      373         end.
      374       end.
      375     end.
      376   end procedure.
      377   procedure cp-attr-tooltip :
      378     do
      379     on error undo, return error
      380     :
      381       define input  parameter p-code    as character no-undo .
      382       define output parameter p-tooltip as character no-undo .
      383       define output parameter p-label   as character no-undo .
      384       case p-code :
      385               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      386               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      387               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      388               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      389               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      390               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      391               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      392               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      393               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      394               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      395         otherwise do:
      396           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      397         end.
      398       end.
      399     end.
      400   end procedure.
      401   procedure cp-attr-value :
      402     do
      403     on error undo, return error
      404     :
      405       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      406       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      407       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      408       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      409       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      410       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      411       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      412       define output parameter p-type        as character no-undo .
      413       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      414       define variable v-format         as character no-undo .
      415       define variable v-label          as character no-undo .
      416       define variable v-range          as integer   no-undo .
      417       define variable v-user-can-edit  as logical   no-undo .
      418       define variable v-output-display as logical   no-undo .
      419       define variable v-other          as character no-undo .
      420       run cp-attr-code in this-procedure
      421         (input  p-code
      422         ,output p-type
      423         ,output v-format
      424         ,output v-label
      425         ,output v-range
      426         ,output v-user-can-edit
      427         ,output v-output-display
      428         ,output v-other
      429         ) no-error .
      430       if error-status :error then do:
      431         undo, return error return-value .
      432       end.
      433       find first buf_cash-pay-attr no-lock
      434         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      435           and buf_cash-pay-attr.curr-code  = p-curr-code
      436           and buf_cash-pay-attr.host-code  = p-host-code
      437           and buf_cash-pay-attr.obj-type   = p-obj-type
      438           and buf_cash-pay-attr.obj-code   = p-obj-code
      439           and buf_cash-pay-attr.attr-code  = p-code
      440         no-error .
      441       if avail buf_cash-pay-attr then do:
      442         assign
      443           p-value =  buf_cash-pay-attr.attr-value
      444         .
      445       end.
      446       else do:
      447         assign
      448           p-value = if p-type = 'L':U then "no":U else ""
      449         .
      450       end.
      451     end.
      452   end procedure.
      453   procedure cp-attr-write :
      454     do
      455     on error undo, return error
      456     :
      457       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      458       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      459       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      460       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      461       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      462       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      463       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      464       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      465       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      466       define variable v-type           as character no-undo .
      467       define variable v-format         as character no-undo .
      468       define variable v-label          as character no-undo .
      469       define variable v-range          as integer   no-undo .
      470       define variable v-user-can-edit  as logical   no-undo .
      471       define variable v-output-display as logical   no-undo .
      472       define variable v-other          as character no-undo .
      473       run cp-attr-code in this-procedure
      474         (input  p-code
      475         ,output v-type
      476         ,output v-format
      477         ,output v-label
      478         ,output v-range
      479         ,output v-user-can-edit
      480         ,output v-output-display
      481         ,output v-other
      482         ) no-error .
      483       if error-status :error then do:
      484         undo, return error return-value .
      485       end.
      486       find first buf_cash-pay-attr exclusive-lock
      487         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      488           and buf_cash-pay-attr.curr-code  = p-curr-code
      489           and buf_cash-pay-attr.host-code  = p-host-code
      490           and buf_cash-pay-attr.obj-type   = p-obj-type
      491           and buf_cash-pay-attr.obj-code   = p-obj-code
      492           and buf_cash-pay-attr.attr-code = p-code
      493         no-error .
      494       if not available buf_cash-pay-attr then do:
      495         create buf_cash-pay-attr .
      496         assign
      497         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      498         buf_cash-pay-attr.curr-code  = p-curr-code
      499         buf_cash-pay-attr.host-code  = p-host-code
      500         buf_cash-pay-attr.obj-type   = p-obj-type
      501         buf_cash-pay-attr.obj-code   = p-obj-code
      502         buf_cash-pay-attr.attr-code = p-code
      503         .
      504       end.
      505       assign
      506         buf_cash-pay-attr.attr-value = p-value
      507       .
      508       release buf_cash-pay-attr no-error .
      509       if error-status:error then do:
      510         undo, return error return-value .
      511       end.
      512     end.
      513   end procedure.
      514   procedure cp-attr-exist :
