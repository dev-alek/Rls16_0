      559   procedure cp-attr-delete :
      560     do
      561     on error undo, return error
      562     :
      563       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      564       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      565       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      566       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      567       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      568       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      569       define output parameter p-deleted  as logical no-undo.
      570       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      571       define variable v-type           as character no-undo .
      572       define variable v-format         as character no-undo .
      573       define variable v-label          as character no-undo .
      574       define variable v-range          as integer   no-undo .
      575       define variable v-user-can-edit  as logical   no-undo .
      576       define variable v-output-display as logical   no-undo .
      577       define variable v-other          as character no-undo .
      578       run cp-attr-code in this-procedure
      579         (input  p-code
      580         ,output v-type
      581         ,output v-format
      582         ,output v-label
      583         ,output v-range
      584         ,output v-user-can-edit
      585         ,output v-output-display
      586         ,output v-other
      587         ) no-error .
      588       if error-status :error then do:
      589         undo, return error return-value .
      590       end.
      591       find first buf_cash-pay-attr exclusive-lock
      592         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      593           and buf_cash-pay-attr.curr-code  = p-curr-code
      594           and buf_cash-pay-attr.host-code  = p-host-code
      595           and buf_cash-pay-attr.obj-type   = p-obj-type
      596           and buf_cash-pay-attr.obj-code   = p-obj-code
      597           and buf_cash-pay-attr.attr-code = p-code
      598         no-error NO-WAIT.
      599       if not available buf_cash-pay-attr then do:
      600         p-deleted = no.
      601       end.
      602       else do:
      603         delete buf_cash-pay-attr no-error .
      604         if error-status:error then do:
      605           undo, return error return-value .
      606         end.
      607         p-deleted = yes.
      608       end.
      609     end.
      610   end procedure.
      611   procedure cp-attr-news :
      612     do
      613     on error undo, return error
      614     :
      615       define input  parameter p-code           as character no-undo .
      616       define output parameter p-news           as logical   no-undo .
      617       case p-code :
      618               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      619               when 'grp-code':U then do:     assign     p-news = true.   end.
      620               when 'is-use':U then do:     assign     p-news = true.   end.
      621               when 'dop-doc':U then do:     assign     p-news = true.   end.
      622               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      623               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      624               when 'form_km3':U then do:     assign     p-news = false.   end.
      625               when 'bal_malina':U then do:     assign     p-news = false.   end.
      626               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      627               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      628         otherwise do:
      629           p-news = no.
      630         end.
      631       end.
      632     end.
      633   end procedure.
