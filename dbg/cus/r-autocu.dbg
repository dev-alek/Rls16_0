      970         ,output v-printed
      971         ) .
      972       if v-printed then
      973       do:
      974         return "YES" .
      975       end.
      976       else
      977       do:
      978         return "NO" .
      979       end.
      980     end.
      981   end procedure.
      982   procedure prn-lib-open-stream :
      983     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      984     define input parameter p-page-size    as integer no-undo .
      985     define input parameter p-is-stream    as logical no-undo .
      986     define input parameter p-append       as logical no-undo .
      987     define variable v-report-name as character no-undo .
      988     do
      989       on error undo, return error
      990       :
      991       run prn-lib-get-report-name  in this-procedure (
      992         input parParentProc
      993         ,output v-report-name
      994         ).
      995       if p-is-stream then
      996       do:
      997         if p-append then
      998         do:
      999           output stream PrnLibStream to value( v-report-name )
     1000             page-size value(p-page-size) append .
     1001         end.
     1002         if not p-append then
     1003         do:
     1004           output stream PrnLibStream to value( v-report-name )
     1005             page-size value(p-page-size) .
     1006         end.
     1007       end.
     1008       if not p-is-stream then
     1009       do:
     1010         if p-append then
     1011         do:
     1012           output to value( v-report-name )
     1013             page-size value(p-page-size) append .
     1014         end.
     1015         if not p-append then
     1016         do:
     1017           output to value( v-report-name )
     1018             page-size value(p-page-size) .
     1019         end.
     1020       end.
     1021     end.
     1022   end procedure.
     1023   procedure prn-lib-open-exp :
     1024     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1025     define input parameter p-is-stream    as logical no-undo .
     1026     define input parameter p-is-append    as logical no-undo .
     1027     define output parameter p-ReportFileName as char init "report" no-undo.
     1028     define output parameter p-process as logical no-undo .
     1029     define variable glog as logical no-undo .
     1030     do
     1031       on error undo, return error
     1032       :
     1033       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1034         TITLE      "Укажите путь"
     1035         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1036         ASK-OVERWRITE
     1037         CREATE-TEST-FILE
     1038         SAVE-AS
     1039         USE-FILENAME
     1040         DEFAULT-EXTENSION "txt"
     1041         UPDATE glog
     1042         .
     1043       if not glog then  return.
     1044       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1045       if p-is-stream then
     1046       do:
     1047         if p-is-append then
     1048         do:
     1049           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1050         end.
     1051         else
     1052         do:
     1053           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1054         end.
     1055       end.
     1056       else
     1057       do:
     1058         if p-is-append then
     1059         do:
     1060           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1061         end.
     1062         else
     1063         do:
     1064           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1065         end.
     1066       end.
     1067       p-process = yes.
     1068     end.
     1069   end procedure.
     1070   procedure prn-lib-get-report-name :
     1071     define input parameter parParentProc  as widget-handle no-undo.
     1072     define output parameter p-report-name as character no-undo .
     1073     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1074   end procedure.
     1075   procedure prn-lib-reportviewer-report-name :
     1076     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1077     define input parameter p-report-name-html as character no-undo .
     1078     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1079   end procedure.
     1080   procedure prn-lib-reportviewer :
     1081     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1082     define input parameter p-report-name-html as character no-undo .
     1083     define input parameter p-param        as character no-undo .
     1084     define variable v-excel           as character no-undo init 'TRUE' .
     1085     define variable v-value-character as character no-undo .
     1086     define variable v-value-integer   as character no-undo .
     1087     define variable v-value-date      as date      no-undo .
     1088     define variable v-value-decimal   as decimal   no-undo .
     1089     define variable rep-excel         as logical   no-undo .
     1090     define variable excel-string      as character no-undo .
     1091     define variable v-param-type      as character no-undo .
     1092     define variable v-tth             as handle    no-undo .
     1093     run adm/shattri.p (
     1094       input "get":U
     1095       ,input  ""
     1096       ,input  0
     1097       ,input  'report-glob':U
     1098       ,input  'rep-excel':U
     1099       ,output v-value-character
     1100       ,output v-value-date
     1101       ,output v-value-decimal
     1102       ,output v-value-integer
     1103       ,output rep-excel
     1104       ,output v-param-type
     1105       ,INPUT-OUTPUT table-handle v-tth
     1106       )  .
     1107     if rep-excel then v-excel = "TRUE" .
     1108     else v-excel = "FALSE" .
     1109     if p-param eq ""
     1110     then
     1111        p-param = "EXCEL:" + v-excel.
     1112     else
     1113        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1114     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1115   end procedure.
