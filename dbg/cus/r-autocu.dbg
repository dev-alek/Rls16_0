      546       find first buf_cash-pay-attr exclusive-lock
      547         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      548           and buf_cash-pay-attr.curr-code  = p-curr-code
      549           and buf_cash-pay-attr.host-code  = p-host-code
      550           and buf_cash-pay-attr.obj-type   = p-obj-type
      551           and buf_cash-pay-attr.obj-code   = p-obj-code
