     1836   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1837     (output v-curr-r-b
     1838     )  .
     1839   run cpapcep in this-procedure .
     1840   p-date-start = X-date-start.
     1841   p-date-end = X-date-end.
     1842   parparentproc = my-handle.
     1843   define variable v-param-type as character no-undo .
     1844   define variable v-value-date as date no-undo .
     1845   define variable v-value-decimal as decimal no-undo .
     1846   define variable v-value-integer as INTEGER no-undo .
     1847   define variable v-value-logical AS LOGICAL no-undo .
     1848   define variable v-tth as handle no-undo .
     1849   run adm/shattri.p (
     1850       input "get":U
     1851       ,input  ''
     1852       ,input  0
     1853       ,input  'report-glob':U
     1854       ,input  'rep-sort':U
     1855       ,output rep-sort
     1856       ,output v-value-date
     1857       ,output v-value-decimal
     1858       ,output v-value-integer
     1859       ,output v-value-logical
     1860       ,output v-param-type
     1861       ,INPUT-OUTPUT table-handle v-tth
     1862       ) no-error .
     1863   if error-status:error or rep-sort = "":U then do:
     1864     delete object v-tth.
     1865     define variable v-tooltip as character no-undo .
     1866     define variable v-label as character no-undo .
     1867     define variable v-tooltip-code as character no-undo .
     1868     run thbjattr_tooltip in this-procedure (
     1869                                               input  'report-glob':U
     1870                                              ,input  'rep-sort':U
     1871                                              ,output v-tooltip
     1872                                              ,output v-label
     1873                                              ,output v-tooltip-code ) no-error.
     1874     if error-status:error then do:
     1875       assign
     1876       v-tooltip-code = 'rep-sort':U
     1877       v-tooltip = 'report-glob':U
     1878       .
     1879     end.
     1880     message
     1881     substitute("Не найден или незаполнен параметр:&2&1&2Секция <&3>"
     1882                , v-tooltip-code
     1883                , chr(10)
     1884                ,v-tooltip)
     1885     view-as alert-box error .
     1886     return .
     1887   end.
     1888   delete object v-tth.
     1889   run adm/shattri.p (
     1890       input "get":U
     1891       ,input  ''
     1892       ,input  0
     1893       ,input  'report-glob':U
     1894       ,input  'cplot':U
     1895       ,output cplot
     1896       ,output v-value-date
     1897       ,output v-value-decimal
     1898       ,output v-value-integer
     1899       ,output v-value-logical
     1900       ,output v-param-type
     1901       ,INPUT-OUTPUT table-handle v-tth
     1902       ) no-error .
     1903   if error-status:error or cplot = "":U then do:
     1904     delete object v-tth.
     1905     run thbjattr_tooltip in this-procedure (
     1906                                               input  'report-glob':U
     1907                                              ,input  'cplot':U
     1908                                              ,output v-tooltip
     1909                                              ,output v-label
     1910                                              ,output v-tooltip-code ) no-error.
     1911     if error-status:error then do:
     1912       assign
     1913       v-tooltip-code = 'cplot':U
     1914       v-tooltip = 'report-glob':U
     1915       .
     1916     end.
     1917     message
     1918     substitute("Не найден или незаполнен параметр:&2&1&2Секция <&3>"
     1919                , v-tooltip-code
     1920                , chr(10)
     1921                ,v-tooltip)
     1922     view-as alert-box error .
     1923     return .
     1924   end.
     1925   delete object v-tth.
     1926   run waitfram-show in this-procedure ("Ждите...").
     1927   for each buf_temp-acush:
     1928     delete buf_temp-acush.
     1929   end.
     1930   for each obj-list :
     1931     run waitfram-show in this-procedure ( substitute("Ждите...Обработка чеков по &1&2", obj-list.obj-type, obj-list.obj-code)).
     1932     run rep/rpychk0.p ( input "r-autocu"
     1933                         ,input obj-list.obj-type
     1934                         ,input obj-list.obj-code
     1935                         ,input p-date-start
     1936                         ,input p-date-end
     1937                         ,input ?
     1938                         ,input ?
     1939                         ,input ?
     1940                         ,input ?
     1941                         ,input ?
     1942                         ).
     1943     _chk-gds-pay:
     1944     FOR EACH buf_chk-doc No-LOCK WHERE
     1945             buf_chk-doc.obj-type = obj-list.obj-type
     1946         and buf_chk-doc.obj-code = obj-list.obj-code
     1947         and buf_chk-doc.chk-date >= p-date-start
     1948         and buf_chk-doc.chk-date <= p-date-end,
     1949        each buf_chk-gds-pay no-lock where
     1950             buf_chk-gds-pay.doc-code = buf_chk-doc.doc-code
     1951         and buf_chk-gds-pay.algo-num = "1.8"
     1952             :
     1953       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds-pay.
     1954       if v-doc-code <> buf_chk-doc.doc-code then do:
     1955         v-num-units = ''.
     1956         v-doc-code = buf_chk-doc.doc-code.
     1957       end.
     1958       if replace(replace(replace(replace(buf_chk-doc.office, 'у':U, ''), 'т':U, ''), 'смн-ош':U, ''), chr(44), '') <> '' then next _chk-gds-pay.
     1959       if buf_chk-gds-pay.rec-type <> 1 then next _chk-gds-pay.
     1960       find first buf_temp-acush where
     1961                   buf_temp-acush.b-code = buf_chk-gds-pay.b-code
     1962               and buf_temp-acush.cdpay-code = buf_chk-gds-pay.pay-code
     1963               and buf_temp-acush.curr-code = buf_chk-gds-pay.curr-code
     1964               and buf_temp-acush.prefix = buf_chk-gds-pay.pay-card no-error.
     1965       if not available buf_temp-acush then do:
     1966         find first buf_bar-code no-lock where
     1967                   buf_bar-code.b-code = buf_chk-gds-pay.b-code no-error.
     1968         if available buf_bar-code then do:
     1969           find first buf_goods no-lock where
     1970                     buf_goods.gds-code = buf_bar-code.b-code no-error.
     1971         end.
     1972         find first buf_prod-bc no-lock where
     1973                   buf_prod-bc.b-code = buf_chk-gds-pay.b-code no-error.
     1974         create buf_temp-acush.
     1975         assign
     1976         buf_temp-acush.b-code = buf_chk-gds-pay.b-code
     1977         buf_temp-acush.gds-code = (if available buf_goods
     1978                                    then buf_goods.gds-code
     1979                                    else 0)
     1980         buf_temp-acush.cdpay-code = buf_chk-gds-pay.pay-code
     1981         buf_temp-acush.curr-code = buf_chk-gds-pay.curr-code
     1982         buf_temp-acush.prefix = buf_chk-gds-pay.pay-card
     1983         .
     1984       end.
     1985       assign
     1986       buf_temp-acush.qnty = buf_temp-acush.qnty +  buf_chk-gds-pay.eff-doc-qnty
     1987       buf_temp-acush.sum = buf_temp-acush.sum + buf_chk-gds-pay.tot-r-b * (if v-curr-r-b = 'rubl':U then 1 else  buf_chk-gds-pay.eff-base-rate)
     1988       buf_temp-acush.num-units = buf_temp-acush.num-units +
     1989                                  (if lookup(string(buf_chk-gds-pay.cpline-num), v-num-units) = 0 then 1 else 0) +
     1990                                  (if num-entries(buf_chk-gds-pay.line-type, chr(4)) > 2
     1991                                   then
     1992                                   integer(entry(3, buf_chk-gds-pay.line-type, chr(4))) - 1
     1993                                   else 0)
     1994       v-num-units = v-num-units + chr(44) + string(buf_chk-gds-pay.cpline-num)
     1995       .
     1996     end.
     1997   end.
     1998   find first buf_temp-acush no-error.
     1999   if not available buf_temp-acush then do:
     2000     run waitfram-hide in this-procedure .
     2001     message
     2002     "Не найдено данных для отчета в заданном периоде времени"
     2003     view-as alert-box warning.
     2004     return.
     2005   end.
     2006   assign
     2007   sheetf.Excel-Column-Lable =  "Топливо,Оплата,Л,Сумма,Количество"
     2008   sheetf.colformat = ""
     2009   sheetf.sizes = "40,45,16,15,11"
     2010   str3 = string( "(Все суммы в рублях)" )
     2011   .
     2012   DEFINE FRAME OutFrame
     2013   buf_goods.gds-name column-label "Топливо" format "X(40)"
     2014   buf_cash-pay.obj-name column-label "Оплата" format "X(45)"
     2015   buf_temp-acush.qnty column-label "Л" format "->>>,>>>,>>>9.999"
     2016   buf_temp-acush.sum column-label "Сумма" format "->>>,>>>,>>9.99"
     2017   buf_temp-acush.num-units column-label "Количество" format "->>,>>>,>>9"
     2018   HEADER
     2019   cur-time-print() AT 5 format "X(35)"
     2020   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>>>>9" ) ) AT 70 format "X(23)" SKIP
     2021   Line format "X(134)" AT 1
     2022   with width 136 down stream-io.
     2023   FORM HEADER
     2024   Line format "X(134)" AT 1 SKIP
     2025   "Продолжение - на следующей странице" AT 60 SKIP
     2026   with FRAME BottomFrame width 136
     2027   PAGE-BOTTOM no-labels no-box.
     2028   run prn-lib-open-stream  in this-procedure (
     2029                                               input parParentProc
     2030                                               ,input 43
     2031                                               ,input yes
     2032                                               ,input no
     2033                                               ).
     2034   run rep/extitle.p ( input 1).
     2035   run waitfram-show in this-procedure ("Ждите..." ).
     2036   PUT stream PrnLibStream UNFORMATTED
     2037   "Отчет о продажах топлива по лотерейным билетам АВТОКУШ"
     2038   format "x(60)" SKIP(1).
     2039   PUT stream PrnLibStream UNFORMATTED
     2040   str1 skip
     2041   str2 skip
     2042   str4 skip
     2043   str3 skip
     2044   .
     2045   PUT stream PrnLibStream UNFORMATTED
     2046   reportheader SKIP(0).
     2047   FORM with FRAME OutFrame.
     2048   VIEW STREAM PrnLibStream FRAME BottomFrame .
     2049   VIEW STREAM PrnLibStream FRAME OutFrame .
     2050   do v-ii = 1 to num-entries(rep-sort):
     2051     assign
     2052     v-current-gds-code = integer(entry(v-ii, rep-sort)).
     2053     do v-jj = 1 to num-entries(cplot):
     2054       assign
     2055       v-current-cdpay-code = entry(v-jj, cplot).
     2056       for each buf_temp-acush where
     2057                 buf_temp-acush.gds-code = v-current-gds-code
     2058            and  buf_temp-acush.cdpay-code = integer(v-current-cdpay-code)
     2059            and buf_temp-acush.curr-code = 0:
     2060         find first all_temp-acush where
     2061                     all_temp-acush.b-code = 0
     2062                 and all_temp-acush.cdpay-code = 0
     2063                 and all_temp-acush.curr-code = 0
     2064                 and all_temp-acush.prefix = '' no-error.
     2065         if not available all_temp-acush then do:
     2066           create all_temp-acush.
     2067           assign
     2068           all_temp-acush.b-code = 0
     2069           all_temp-acush.cdpay-code = 0
     2070           all_temp-acush.curr-code = 0
     2071           all_temp-acush.prefix = ''
     2072           .
     2073         end.
     2074         assign
     2075         all_temp-acush.qnty = all_temp-acush.qnty +  buf_temp-acush.qnty
     2076         all_temp-acush.sum = all_temp-acush.sum + buf_temp-acush.sum
     2077         all_temp-acush.num-units = all_temp-acush.num-units + buf_temp-acush.num-units
     2078         .
     2079         find first buf_goods no-lock where
     2080                   buf_goods.gds-code = buf_temp-acush.gds-code no-error.
     2081         find first buf_cash-pay no-lock where
     2082                   buf_cash-pay.cdpay-code = buf_temp-acush.cdpay-code
     2083               and buf_cash-pay.curr-code = buf_temp-acush.curr-code no-error.
     2084         DISPLAY STREAM PrnLibStream
     2085         (if available buf_goods
     2086         then buf_goods.gds-name
     2087         else substitute("Топливо - код товара &1", buf_temp-acush.gds-code)) @ buf_goods.gds-name
     2088         (if available buf_cash-pay
     2089         then (buf_cash-pay.obj-name + buf_temp-acush.prefix)
     2090         else substitute("Тип касс.платежа &1/&2", buf_temp-acush.cdpay-code, buf_temp-acush.prefix) ) @ buf_cash-pay.obj-name
     2091         buf_temp-acush.qnty
     2092         buf_temp-acush.sum
     2093         buf_temp-acush.num-units
     2094         WITH FRAME OutFrame.
     2095         down stream PrnLibstream 1
     2096         with frame OutFrame.
     2097         if Make-Excel then  put   stream ForExcel unformatted
     2098         (if available buf_goods
     2099         then buf_goods.gds-name
     2100         else substitute("Топливо - код товара &1", buf_temp-acush.gds-code)) CHR(9)
     2101         (if available buf_cash-pay
     2102         then (buf_cash-pay.obj-name + buf_temp-acush.prefix)
     2103         else substitute("Тип касс.платежа &1/&2", buf_temp-acush.cdpay-code, buf_temp-acush.prefix) ) CHR(9)
     2104         round(buf_temp-acush.qnty, 3) CHR(9)
     2105         round(buf_temp-acush.sum, 2) CHR(9)
     2106         buf_temp-acush.num-units
     2107         skip.
     2108       end.
     2109     end.
     2110   end.
     2111   underline stream prnlibstream
     2112   buf_goods.gds-name
     2113   buf_cash-pay.obj-name
     2114   buf_temp-acush.qnty
     2115   buf_temp-acush.sum
     2116   buf_temp-acush.num-units
     2117   WITH FRAME OutFrame.
     2118   find first all_temp-acush where
     2119              all_temp-acush.gds-code = 0
     2120         and  all_temp-acush.cdpay-code = 0
     2121         and  all_temp-acush.curr-code = 0
     2122         and  all_temp-acush.prefix = '' no-error.
     2123   DISPLAY STREAM PrnLibStream
     2124   "ИТОГО" @ buf_goods.gds-name
     2125   (if available all_temp-acush
     2126   then all_temp-acush.qnty
     2127   else 0) @  buf_temp-acush.qnty
     2128   (if available all_temp-acush
     2129   then all_temp-acush.sum
     2130   else 0) @  buf_temp-acush.sum
     2131   (if available all_temp-acush
     2132   then all_temp-acush.num-units
     2133   else 0) @  buf_temp-acush.num-units
     2134   WITH FRAME OutFrame.
     2135   down stream PrnLibstream 1
     2136   with frame OutFrame.
     2137   if Make-Excel then  put   stream ForExcel unformatted
     2138   "ИТОГО" CHR(9)
     2139   "" CHR(9)
     2140   (if available all_temp-acush
     2141   then round(all_temp-acush.qnty, 3)
     2142   else 0)  CHR(9)
     2143   (if available all_temp-acush
     2144   then round(all_temp-acush.sum, 2)
     2145   else 0) CHR(9)
     2146   (if available all_temp-acush
     2147   then all_temp-acush.num-units
     2148   else 0)
     2149   skip.
     2150   run waitfram-hide in this-procedure .
     2151   HIDE STREAM PrnLibStream FRAME BottomFrame .
     2152   OUTPUT STREAM PrnLibStream CLOSE.
     2153   if Make-Excel then output stream ForExcel close.
     2154   run prn-lib-prn-file in this-procedure (
     2155                                             input parParentProc
     2156                                             ,input 8
     2157                                             ).
     2158   define variable v-report-name as character no-undo .
