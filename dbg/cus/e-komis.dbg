      960   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      961   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      962   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      963   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      964   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      965   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      966   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      967   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      968       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
      969   RUN ensure-broker.
      970   THIS-PROCEDURE:ADM-DATA =
      971        'ADM1.1~`':U +
      972        'SmartObject~`':U +
      973        'FRAME~`':U +
      974        'NO ~`':U +
      975        '~`':U +
      976        '~`':U +
      977        '~`':U +
      978        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      979           + "~`":U +
      980        'Layout,Hide-on-Init~`':U +
      981        '~`':U +
      982        '~`':U +
      983        '~`~`~`~`~`~`~`~`~`~`~`':U +
      984        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      985            THEN "^^":U
      986        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      987             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      988   PROCEDURE adm-apply-entry :
      989     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      990   END PROCEDURE.
      991   PROCEDURE adm-destroy :
      992    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      993   END PROCEDURE.
      994   PROCEDURE adm-disable :
      995       DISABLE RECT-parts RECT-purpose RECT-columns RECT-supp RECT-by RS-purpose T-prod T-price-without-tax-cost T-sum-without-tax-cost button-supp T-sum-VAT-cost E-supp T-price-without-tax-sale T-sum-without-tax-sale T-sum-VAT-sale RS-By T-sum-SLT-sale T-sum-with-tax-sale T-parts WITH FRAME F-Main.
      996       RUN dispatch ('disable-fields':U).
      997       RUN set-attribute-list ('ENABLED=no':U).
      998       RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE adm-edit-attribute-list :
     1001         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1002         RETURN.
     1003   END PROCEDURE.
     1004   PROCEDURE adm-enable :
     1005       ENABLE UNLESS-HIDDEN RECT-parts RECT-purpose RECT-columns RECT-supp RECT-by RS-purpose T-prod T-price-without-tax-cost T-sum-without-tax-cost button-supp T-sum-VAT-cost E-supp T-price-without-tax-sale T-sum-without-tax-sale T-sum-VAT-sale RS-By T-sum-SLT-sale T-sum-with-tax-sale T-parts WITH FRAME F-Main.
     1006       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1007       RUN set-attribute-list ('ENABLED=yes':U).
     1008       RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-exit :
     1011        RUN notify ('exit':U).
     1012     RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE adm-hide :
     1015     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1016   END PROCEDURE.
     1017   PROCEDURE adm-initialize :
     1018     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1019   END PROCEDURE.
     1020   PROCEDURE adm-show-errors :
     1021       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1022       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1023           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1024       END.
     1025       RETURN.
     1026   END PROCEDURE.
     1027   PROCEDURE adm-UIB-mode :
     1028     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1029   END PROCEDURE.
     1030   PROCEDURE adm-view :
     1031     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1032   END PROCEDURE.
     1033   PROCEDURE dispatch :
     1034       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1035       RUN broker-dispatch IN adm-broker-hdl
     1036           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1037       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1038   END PROCEDURE.
     1039   PROCEDURE ensure-broker :
     1040   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1041   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1042   DO:
     1043       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1044       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1045   END.
     1046   END PROCEDURE.
     1047   PROCEDURE get-attribute :
     1048     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1049     RUN broker-get-attribute IN adm-broker-hdl
     1050         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1051     RETURN RETURN-VALUE.
     1052   END PROCEDURE.
     1053   PROCEDURE get-attribute-list :
     1054     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1055     RUN broker-get-attribute-list IN adm-broker-hdl
     1056         (INPUT THIS-PROCEDURE,
     1057          INPUT ?,
     1058          OUTPUT p-attr-list) NO-ERROR.
     1059     RETURN.
     1060   END PROCEDURE.
     1061   PROCEDURE new-state :
     1062     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1063     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1064     RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE notify :
     1067     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1068     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1069     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1070         RETURN "ADM-ERROR":U.
     1071     RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE set-attribute-list :
     1074     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1075     RUN ensure-broker.
     1076     RUN broker-set-attribute-list IN adm-broker-hdl
     1077         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1078     RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE set-position :
     1081       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1082       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1083       IF VALID-HANDLE(adm-object-hdl) THEN
     1084       DO:
     1085           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1086           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1087           DO:
     1088             IF p-row = 0 THEN p-row =
     1089               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1090             IF p-col = 0 THEN p-col =
     1091               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1092           END.
     1093           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1094           DO:
     1095             parent-hdl = adm-object-hdl:PARENT.
     1096             IF p-row = 0 THEN p-row =
     1097               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1098                 parent-hdl:ROW.
     1099             IF p-col = 0 THEN p-col =
     1100               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1101                 parent-hdl:COL.
     1102           END.
     1103           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1104           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1105         ASSIGN adm-object-hdl:ROW    =   p-row
     1106                adm-object-hdl:COLUMN =   p-col.
     1107       END.
     1108       RETURN.
     1109   END PROCEDURE.
     1110   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1111       STRING(adm-object-hdl)).
     1112   PAUSE 0 BEFORE-HIDE.
     1113   PROCEDURE adm-change-page :
     1114     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1115     END PROCEDURE.
     1116   PROCEDURE delete-page :
     1117     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1118     RUN broker-delete-page IN adm-broker-hdl
     1119         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1120     END PROCEDURE.
     1121   PROCEDURE init-object :
     1122     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1123     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1124     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1125     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1126     RUN broker-init-object IN adm-broker-hdl
     1127         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1128          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1129     RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE init-pages :
     1132     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1133     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1134         INPUT p-page-list) NO-ERROR.
     1135     END PROCEDURE.
     1136   PROCEDURE select-page :
     1137     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1138     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1139         INPUT p-page#) NO-ERROR.
     1140     END PROCEDURE.
     1141   PROCEDURE view-page :
     1142     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1143     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1144         INPUT p-page#).
     1145     END PROCEDURE.
     1146   ASSIGN
     1147          E-supp:READ-ONLY IN FRAME F-Main        = TRUE.
     1148   ASSIGN
     1149          T-neg:HIDDEN IN FRAME F-Main           = TRUE.
     1150   ON CHOOSE OF button-supp IN FRAME F-Main
     1151   DO:
     1152     CASE rs-purpose:
     1153       when  1 then do:
     1154         run ref/cli-all.w (   input my-handle
     1155                         ,input "b-sel"
     1156                         ,input 'все':U
     1157                         ,input 'все':U
     1158                         ,input 'текущие':U
     1159                         ,input (if avail cli_supp then recid(cli_supp) else ?)
     1160                         ,input ",,,,,,NO,,"
     1161                         ,input ?
     1162                         , output cli-list ) .
     1163         if cli-list <> ""
     1164         then do:
     1165           FIND FIRST cli_supp WHERE recid( cli_supp ) = int( cli-list ) NO-LOCK .
     1166           assign
     1167           E-supp:screen-value = cli_supp.obj-name.
     1168         end.
     1169         else do:
     1170           assign
     1171           E-supp:screen-value = "".
     1172         end.
     1173       end.
     1174       when 2 then do:
     1175         run str/cli-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     1176         run get-str-supp in this-procedure .
     1177         assign
     1178         E-supp:screen-value = str-supp-name.
     1179       end.
     1180     END CASE.
     1181   END.
     1182   ON VALUE-CHANGED OF RS-purpose IN FRAME F-Main
     1183   DO:
     1184     assign
     1185     RS-purpose.
     1186     CASE rs-purpose:
     1187       when 1 then do:
     1188         if available cli_supp then do:
     1189           assign
     1190           E-supp:screen-value = cli_supp.obj-name.
     1191         end.
     1192         else do:
     1193           assign
     1194           E-supp:screen-value = "".
     1195         end.
     1196         display
     1197         T-parts
     1198         T-price-without-slt-sale
     1199         T-price-without-tax-cost
     1200         T-price-without-tax-sale
     1201         T-prod
     1202         T-sum-SLT-sale
     1203         T-sum-VAT-cost
     1204         T-sum-VAT-sale
     1205         T-sum-without-tax-cost
     1206         T-sum-without-tax-sale
     1207         T-sum-with-tax-cost
     1208         T-sum-with-tax-sale
     1209         RECT-columns
     1210         RECT-parts
     1211         with frame F-Main.
     1212       end.
     1213       when 2 then do:
     1214         assign
     1215         E-supp:screen-value = str-supp-name.
     1216         HIDE
     1217         T-parts
     1218         T-price-without-slt-sale
     1219         T-price-without-tax-cost
     1220         T-price-without-tax-sale
     1221         T-prod
     1222         T-sum-SLT-sale
     1223         T-sum-VAT-cost
     1224         T-sum-VAT-sale
     1225         T-sum-without-tax-cost
     1226         T-sum-without-tax-sale
     1227         T-sum-with-tax-cost
     1228         T-sum-with-tax-sale
     1229         RECT-columns
     1230         RECT-parts
     1231         in frame F-Main.
     1232       end.
     1233     END CASE.
     1234   END.
     1235   ON VALUE-CHANGED OF T-parts IN FRAME F-Main
     1236   DO:
     1237       ASSIGN T-parts.
     1238   END.
     1239   ON VALUE-CHANGED OF T-price-without-slt-sale IN FRAME F-Main
     1240   DO:
     1241       ASSIGN T-price-without-slt-sale.
     1242   END.
     1243   ON VALUE-CHANGED OF T-price-without-tax-cost IN FRAME F-Main
     1244   DO:
     1245       ASSIGN T-price-without-tax-cost.
     1246   END.
     1247   ON VALUE-CHANGED OF T-price-without-tax-sale IN FRAME F-Main
     1248   DO:
     1249       ASSIGN T-price-without-tax-sale.
     1250   END.
     1251   ON VALUE-CHANGED OF T-prod IN FRAME F-Main
     1252   DO:
     1253     ASSIGN T-prod.
     1254   END.
     1255   ON VALUE-CHANGED OF T-sum-SLT-sale IN FRAME F-Main
     1256   DO:
     1257       ASSIGN T-sum-SLT-sale.
     1258   END.
     1259   ON VALUE-CHANGED OF T-sum-VAT-cost IN FRAME F-Main
     1260   DO:
     1261       ASSIGN T-sum-VAT-cost.
     1262   END.
     1263   ON VALUE-CHANGED OF T-sum-VAT-sale IN FRAME F-Main
     1264   DO:
     1265       ASSIGN T-sum-VAT-sale.
     1266   END.
     1267   ON VALUE-CHANGED OF T-sum-with-tax-cost IN FRAME F-Main
     1268   DO:
     1269       ASSIGN T-sum-with-tax-cost.
     1270   END.
     1271   ON VALUE-CHANGED OF T-sum-with-tax-sale IN FRAME F-Main
     1272   DO:
     1273       ASSIGN T-sum-with-tax-sale.
     1274   END.
     1275   ON VALUE-CHANGED OF T-sum-without-tax-cost IN FRAME F-Main
     1276   DO:
     1277       ASSIGN T-sum-without-tax-cost.
     1278   END.
     1279   ON VALUE-CHANGED OF T-sum-without-tax-sale IN FRAME F-Main
     1280   DO:
     1281       ASSIGN T-sum-without-tax-sale.
     1282   END.
     1283   if not this-procedure :persistent
     1284   then do:
     1285     message
     1286       vss-workfile vss-revision vss-description skip
     1287       "Ошибка при запуске процедуры" skip
     1288       "Данную процедуру следует запускать только с параметром persistent" skip
     1289       view-as alert-box error .
     1290     undo, return error .
     1291   end.
     1292   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293     run mainmenu_getcntxt in my-handle
     1294       (output v-cntxt-db-num
     1295       ,output v-cntxt-userid
     1296       ,output v-cntxt-level
     1297       ,output v-cntxt-host-code-obj
     1298       ,output v-cntxt-obj-type
     1299       ,output v-cntxt-obj-code
     1300       ,output v-cntxt-db-num-obj
     1301       ,output v-cntxt-is-admin
     1302       ) .
     1303   PROCEDURE adm-create-objects :
     1304   END PROCEDURE.
     1305   PROCEDURE adm-row-available :
     1306     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1307     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1308     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1309     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1310     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1311     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1312     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1313     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1314     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1315     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1316     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1317     IF adm-updating-record THEN RETURN.
     1318     RUN get-attribute ('FIELDS-ENABLED':U).
     1319     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1320     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1321         OUTPUT link-handle) NO-ERROR.
     1322     IF link-handle = "":U THEN
     1323         RETURN.
     1324     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1325     IF NUM-ENTRIES(link-handle) > 1 THEN
     1326         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1327             "encountered more than one RECORD-SOURCE.":U SKIP
     1328             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1329                VIEW-AS ALERT-BOX ERROR.
     1330     RUN get-attribute ('Key-Name':U).
     1331     key-name = RETURN-VALUE.
     1332     IF key-name = "":U THEN key-name = ?.
     1333     IF key-name NE ? THEN DO:
     1334       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1335         NO-ERROR.
     1336       IF key-value NE ? THEN
     1337         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1338     END.
     1339   IF VALID-HANDLE (adm-object-hdl) THEN
     1340       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1341   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1342   END PROCEDURE.
     1343   PROCEDURE disable_UI :
     1344     HIDE FRAME F-Main.
     1345     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1346   END PROCEDURE.
     1347   PROCEDURE enable_UI :
     1348     DISPLAY RS-purpose T-prod T-price-without-tax-cost T-sum-without-tax-cost
     1349             T-sum-VAT-cost E-supp T-sum-with-tax-cost T-price-without-tax-sale
     1350             T-sum-without-tax-sale T-sum-VAT-sale T-price-without-slt-sale RS-By
     1351             T-sum-SLT-sale T-sum-with-tax-sale T-parts
     1352         WITH FRAME F-Main.
     1353     ENABLE RECT-parts RECT-purpose RECT-columns RECT-supp RECT-by RS-purpose
     1354            T-prod T-price-without-tax-cost T-sum-without-tax-cost button-supp
     1355            T-sum-VAT-cost E-supp T-price-without-tax-sale T-sum-without-tax-sale
     1356            T-sum-VAT-sale RS-By T-sum-SLT-sale T-sum-with-tax-sale T-parts
     1357         WITH FRAME F-Main.
     1358   END PROCEDURE.
     1359   PROCEDURE get-str-supp :
     1360    Assign
     1361    STR-supp-name = "":U
     1362    STR-supp = "":U
     1363    .
     1364   For each cli-list no-lock:
     1365    Assign
     1366    STR-supp-name = STR-supp-name + cli-list.obj-name + chr(10)
     1367    STR-supp = STR-supp +  cli-list.obj-type + '#' + string(cli-list.obj-code)  + ',' .
     1368   End.
     1369   END PROCEDURE.
     1370   PROCEDURE local-initialize :
     1371     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1372     APPLY "VALUE-CHANGED" to RS-purpose in frame F-Main.
     1373   END PROCEDURE.
     1374   PROCEDURE My-report :
     1375   DEFINE VARIABLE v-report-header as character no-undo .
     1376   DEFINE VARIABLE v-frame-width as integer no-undo .
     1377   define variable glog as logical no-undo .
     1378   define variable v-host-code like ub.sysconf.host-code no-undo .
     1379   define variable v-host-name like ub.clients.obj-name no-undo .
     1380   run My-var.
     1381   CASE rs-purpose:
     1382     when 1 then do:
     1383       if NOT avail cli_supp then do:
     1384         message "Не выбран поставщик"
     1385         view-as alert-box ERROR.
     1386         return.
     1387       end.
     1388       glog = no.
     1389       assign
     1390       use-column[1] = yes
     1391       use-column[2] = yes
     1392       use-column[3] = yes
     1393       use-column[4] = T-prod
     1394       use-column[5] = yes
     1395       use-column[6] = yes
     1396       use-column[7] = T-price-without-tax-cost
     1397       use-column[8] = T-sum-without-tax-cost
     1398       use-column[9] = T-sum-VAT-cost
     1399       use-column[10] = T-sum-with-tax-cost
     1400       use-column[11] = T-price-without-tax-sale
     1401       use-column[12] = T-sum-without-tax-sale
     1402       use-column[13] = T-sum-VAT-sale
     1403       use-column[14] = T-price-without-slt-sale
     1404       use-column[15] = T-sum-SLT-sale
     1405       use-column[16] = T-sum-with-tax-sale
     1406       frame F-Main RS-by
     1407       .
     1408   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1410     (input  v-cntxt-obj-type
     1411     ,input  v-cntxt-obj-code
     1412     ,output v-host-code
     1413     ,output v-host-name
     1414     )  .
     1415       assign
     1416       ReportHeader = "":U
     1417       ReportName = "Отчет"
     1418       str1 =  "о продаже товаров принятых на комиссию" + chr(32) +
     1419               v-host-name + chr(32) +
     1420               "от фирмы" + chr(32) +
     1421               (if available cli_supp
     1422                 then cli_supp.obj-name
     1423                 else "( поставщик не определен) ")
     1424       str2 =    "за период с" + chr(32) + string(X-date-start, "99/99/9999") + chr(32)  +
     1425                 "по" + chr(32) + string(X-date-end, "99/99/9999") + chr(32) +
     1426                 "произведена продажа следующего товара"
     1427       str3 =  "Источник формирования: " +
     1428                   radio-label(string(RS-BY), RS-BY:radio-buttons)
     1429       str4 = "":U
     1430       v-report-header = ReportName + chr(10) +
     1431                         str1 + chr(10) +
     1432                         str2 + chr(10) +
     1433                         str3
     1434                         .
     1435       run cus/r-komis.p (
     1436                      input my-handle
     1437                     ,input v-host-name
     1438                     ,input cli_supp.obj-type
     1439                     ,input cli_supp.obj-code
     1440                     ,input cli_supp.obj-name
     1441                     ,input RS-by
     1442                     ,input T-parts
     1443                     ,input v-report-header
     1444                     ,output v-frame-width
     1445                     ).
     1446     end.
     1447     when 2 then do:
     1448       if not can-find( first cli-list no-lock) then do:
     1449         message "Не выбрано ни одного поставщика"
     1450         view-as alert-box ERROR.
     1451         return.
     1452       end.
     1453       assign
     1454       ReportHeader = "":U
     1455       str3 =  "Источник формирования: " +
     1456                radio-label(string(RS-BY), RS-BY:radio-buttons)
     1457       ReportName = "Акт о реализации комиссионного товара"
     1458       v-report-header = ReportName + chr(10) +
     1459                         str1 + chr(10) +
     1460                         str4 + chr(10) +
     1461                         "Источник формирования: " +
     1462                         radio-label(string(RS-BY), RS-BY:radio-buttons)
     1463                         .
     1464       run cus/r-komisl.p (
     1465                      input my-handle
     1466                     ,input v-host-name
     1467                     ,input RS-by
     1468                     ,input v-report-header
     1469                     ,output v-frame-width
     1470                     ).
     1471     end.
     1472   end.
     1473   END PROCEDURE.
     1474   PROCEDURE My-var :
     1475   Assign
     1476   frame F-Main T-neg
     1477   frame F-Main T-parts
     1478   frame F-Main RS-by
     1479   frame F-Main RS-purpose
     1480   frame F-Main T-price-without-slt-sale
     1481   frame F-Main T-price-without-tax-cost
     1482   frame F-Main T-price-without-tax-sale
     1483   frame F-Main T-sum-SLT-sale
     1484   frame F-Main T-sum-VAT-cost
     1485   frame F-Main T-sum-VAT-sale
     1486   frame F-Main T-sum-without-tax-cost
     1487   frame F-Main T-sum-without-tax-sale
     1488   frame F-Main T-sum-with-tax-cost
     1489   frame F-Main T-sum-with-tax-sale
     1490   frame F-Main T-prod
     1491   .
     1492   Assign
     1493    STR-obj-type = ''
     1494    STR-obj-code = ''
     1495    STR-obj-name = ''
     1496    STR-obj      = ''.
     1497   For each obj-list no-lock:
     1498    Assign
     1499    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1500    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1501    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1502    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1503   End.
     1504   run get-str-supp in this-procedure .
     1505   Reportname = "РЕАЛИЗАЦИЯ КОМИССИОННОГО ТОВАРА".
     1506   ReportHeader =  "Источник формирования: " +
     1507                   radio-label(string(RS-BY), RS-BY:radio-buttons) + chr(10) +
     1508                   (if RS-purpose = 1 then
     1509                   ("Поставщик: " +
     1510                   (if available cli_supp
     1511                     then cli_supp.obj-name
     1512                     else "( поставщик не определен) "))
     1513                     else str-supp) +
     1514                   chr(10) +
     1515                   (if T-neg then t-neg:label else "") + chr(10) +
     1516                   (if T-parts then t-parts:label else "")                .
     1517   END PROCEDURE.
     1518   PROCEDURE send-records :
     1519   END PROCEDURE.
     1520   PROCEDURE state-changed :
     1521     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1522     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1523   END PROCEDURE.
