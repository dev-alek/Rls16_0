        1   block-level on error undo, throw.
        2   define input  parameter parParentProc  as widget-handle no-undo.
        3   define input  parameter p-recid as recid no-undo .
        4   define output parameter loc-ord-num as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: ord-shoo.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: cus/ord-shoo.p $":U .
       10   define variable vss-description as character no-undo init "—оздание щепки заказа".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure proc-ord-code :
      127   define input  parameter  p-type as character no-undo .
      128   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      129   define input  parameter  v-cntxt-obj-type as character no-undo .
      130   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      131   define input  parameter  p-i-doc    as character no-undo .
      132   define output parameter  p-ord-doc  as character no-undo .
      133   define variable          v-idop     as character no-undo .
      134     do
      135     on error undo, return error return-value
      136     :
      137   case p-type :
      138       when "main-no-ver" then do:
      139         if  (v-cntxt-db-num <> 0) then
      140           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      141         else
      142           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      143       end.
      144       when "main" then do:
      145             do while true:
      146             if  (v-cntxt-db-num <> 0) then
      147               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      148             else
      149               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      150             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      151             End.
      152       end.
      153       when "chip" then do:
      154         assign
      155           v-idop = p-i-doc .
      156         do while true :
      157           if index (v-idop , ".") = 0 then
      158             v-idop  = replace (v-idop , "-", "-1.").
      159           else
      160             v-idop  =
      161             substring (v-idop , 1, index (v-idop, "-")) +
      162             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      163             substring (v-idop, index (v-idop, ".")).
      164           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      165         end.
      166         assign
      167           p-ord-doc = v-idop.
      168       end.
      169   end case.
      170     end.
      171   end procedure.
      172   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173     run mainmenu_getcntxt in parparentproc
      174       (output v-cntxt-db-num
      175       ,output v-cntxt-userid
      176       ,output v-cntxt-level
      177       ,output v-cntxt-host-code-obj
      178       ,output v-cntxt-obj-type
      179       ,output v-cntxt-obj-code
      180       ,output v-cntxt-db-num-obj
      181       ,output v-cntxt-is-admin
      182       ) .
      183   define buffer buf_ord-doc for ub.ord-doc.
      184   define buffer buf_ord-line for ub.ord-line.
      185   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
      186   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
      187   define buffer   buf2-ord-doc-rcv  for ub.ord-doc-rcv .
      188   define buffer   buf2-doc-line     for ub.doc-line     .
      189   define temp-table temp-ord-line  no-undo like ub.ord-line.
      190   find first  buf_ord-doc no-lock where recid (buf_ord-doc) = p-recid no-error .
      191   if error-status :error then return .
      192   define variable v-qnty as decimal no-undo .
      193   define variable v-sum-qnty as decimal no-undo .
      194   define variable kk as integer init 0 no-undo .
      195   define variable k-q      as decimal init 0 no-undo .
      196   define variable k-s-rubl as decimal init 0 no-undo .
      197   define variable k-s-base as decimal init 0 no-undo .
      198   define variable v-temp as character no-undo .
      199   define buffer new_ord-doc for ub.ord-doc.
      200   define buffer new_ord-line for ub.ord-line.
      201   for each temp-ord-line
      202       on error undo, return error :
      203       delete temp-ord-line .
      204   end.
      205   for each buf_ord-line no-lock where
      206            buf_ord-line.doc-code = buf_ord-doc.doc-code
      207        :
      208           v-qnty = 0 .
      209           v-sum-qnty = 0 .
      210           for each buf_ord-line-rcv no-lock
      211               where buf_ord-line-rcv.doc-code = buf_ord-doc.doc-code and
      212                     buf_ord-line-rcv.artic     = buf_ord-line.artic and
      213                     buf_ord-line-rcv.prod-type = buf_ord-line.prod-type and
      214                     buf_ord-line-rcv.prod-code = buf_ord-line.prod-code,
      215                     first buf2-ord-doc-rcv no-lock where
      216                           buf2-ord-doc-rcv.rcv-code =  buf_ord-line-rcv.rcv-code and
      217                           buf2-ord-doc-rcv.doc-code =  buf_ord-line-rcv.doc-code    ,
      218                     each ub.ord-chain no-lock where
      219                               ub.ord-chain.doc-code = buf2-ord-doc-rcv.rcv-code and
      220                               ub.ord-chain.doc-type = 'rcv'                  and
      221                               ub.ord-chain.rel-doc-type = 'trn'              ,
      222                     first buf2-doc-line no-lock where
      223                           buf2-doc-line.doc-code     =  ub.ord-chain.rel-doc-code  and
      224                           buf2-doc-line.artic        =  buf_ord-line-rcv.artic    and
      225                           buf2-doc-line.prod-code    =  buf_ord-line-rcv.prod-code and
      226                           buf2-doc-line.prod-type    =  buf_ord-line-rcv.prod-type
      227                     :
      228                     v-sum-qnty = v-sum-qnty + buf2-doc-line.fact-qnty .
      229           end.
      230           if (v-sum-qnty < buf_ord-line.qnty) and
      231             (buf_ord-line.qnty - v-sum-qnty) <> ? then do:
      232             kk = kk + 1.
      233             create temp-ord-line .
      234             buffer-copy buf_ord-line to temp-ord-line
      235             assign
      236               temp-ord-line.qnty      = buf_ord-line.qnty - v-sum-qnty
      237               temp-ord-line.cli-qnty  = temp-ord-line.qnty / temp-ord-line.cli-base-rate
      238               temp-ord-line.sum-rubl  = temp-ord-line.qnty  * temp-ord-line.price-rubl
      239               temp-ord-line.sum-base  = temp-ord-line.qnty  * temp-ord-line.price-base
      240             .
      241             assign
      242               k-q      = k-q + temp-ord-line.qnty
      243               k-s-rubl = k-s-rubl + temp-ord-line.sum-rubl
      244               k-s-base = k-s-base + temp-ord-line.sum-base
      245             .
      246           end.
      247   end.
      248   if kk > 0 then do:
      249   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   run proc-ord-code in this-procedure
      251    (input   'chip' ,
      252     input   v-cntxt-db-num ,
      253     input   buf_ord-doc.obj-type ,
      254     input   buf_ord-doc.obj-code ,
      255     input   buf_ord-doc.doc-code ,
      256     output  loc-ord-num
      257    ) .
      258     create new_ord-doc.
      259     BUFFER-COPY buf_ord-doc to new_ord-doc
      260     assign
      261       new_ord-doc.doc-code = loc-ord-num
      262       new_ord-doc.doc-date = today
      263       new_ord-doc.status_  = 'новый':U
      264       new_ord-doc.flag_    = true
      265       new_ord-doc.creid    = v-cntxt-userid
      266       new_ord-doc.qnty     = k-q
      267       new_ord-doc.sum-rubl = k-s-rubl
      268       new_ord-doc.sum-base = k-s-base
      269       new_ord-doc.tot-lines = kk
      270         .
      271     for each temp-ord-line
      272         on error undo, return error :
      273       create new_ord-line.
      274       BUFFER-COPY temp-ord-line to new_ord-line
      275       assign
      276        new_ord-line.doc-code = loc-ord-num
      277       .
      278     end.
      279     message "Ќе все количество товаров удалось распределить из заказа " buf_ord-doc.doc-code skip
      280              "ќстальное количество товара перенесено в новый заказ "  loc-ord-num
      281               view-as alert-box .
      282   end.
