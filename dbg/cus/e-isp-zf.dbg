      666        LABEL "Итоги по заказам"
      667        VIEW-AS TOGGLE-BOX
      668        SIZE 25.25 BY .83 TOOLTIP "Раздельно по заказам" NO-UNDO.
      669   DEFINE FRAME F-Main
      670        RAD-otkl AT ROW 2.08 COL 32.38 NO-LABEL
      671        RAD-Post AT ROW 2.25 COL 1.88 NO-LABEL
      672        Ed-otkl-prc AT ROW 3.79 COL 58.5 COLON-ALIGNED NO-LABEL
      673        Ed-otkl-prc-2 AT ROW 5.33 COL 58.5 COLON-ALIGNED NO-LABEL
      674        Ed-otkl-tmh AT ROW 6.96 COL 57.5 COLON-ALIGNED NO-LABEL
      675        Ed-otkl-tmm AT ROW 6.96 COL 63.38 COLON-ALIGNED NO-LABEL
      676        RAD-Post-2 AT ROW 7.04 COL 1.88 NO-LABEL
      677        tg-zay AT ROW 11.25 COL 2.75
      678        "Выбор товаров:" VIEW-AS TEXT
      679             SIZE 19.38 BY .67 AT ROW 1.25 COL 37.75
      680             FGCOLOR 4
      681        "Выбор заказов:" VIEW-AS TEXT
      682             SIZE 19.38 BY .67 AT ROW 1.33 COL 7.13
      683             FGCOLOR 4
      684        ":" VIEW-AS TEXT
      685             SIZE .75 BY .96 TOOLTIP ":" AT ROW 6.96 COL 64.5
      686        "Сравнение:" VIEW-AS TEXT
      687             SIZE 19.38 BY .67 AT ROW 6.13 COL 7.13
      688             FGCOLOR 4
