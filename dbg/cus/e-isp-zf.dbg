      179   procedure create_obj-list :
      180      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      181      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      182      do
      183      on error undo, return error return-value
      184      :
      185         define buffer cli-obj for ub.clients .
      186         define variable p-var as integer no-undo .
      187         define buffer buf_obj-list for obj-list .
      188         find last buf_obj-list  use-index pi no-error .
      189         if available buf_obj-list
      190         then
      191            p-var = buf_obj-list.obj-id + 1.
      192         else
      193            p-var = 1.
      194         find first cli-obj where
      195                   cli-obj.obj-type = p-obj-type
      196               and cli-obj.obj-code = p-obj-code
      197         no-lock no-error.
      198         if available cli-obj
      199         then do:
      200            create buf_obj-list.
      201            assign
      202               buf_obj-list.obj-id   = p-var
      203               buf_obj-list.obj-code = cli-obj.obj-code
      204               buf_obj-list.obj-type = cli-obj.obj-type
      205               buf_obj-list.obj-name = cli-obj.obj-name
      206               buf_obj-list.db-num   = cli-obj.db-num
      207            .
      208         end.
      209      end.
      210   end.
