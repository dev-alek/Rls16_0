      690        RECT-9 AT ROW 5.88 COL 1.75
      691        RECT-8 AT ROW 10.63 COL 1.75
      692        RECT-5 AT ROW 1 COL 31
      693       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      694            SIDE-LABELS NO-UNDERLINE THREE-D
      695            AT COL 1 ROW 1 SCROLLABLE .
      696   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      697   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      698   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      699   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      700   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      701   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      702   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      703   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      704         adm-object-hdl = FRAME F-Main:HANDLE.
      705   RUN ensure-broker.
      706   THIS-PROCEDURE:ADM-DATA =
      707        'ADM1.1~`':U +
      708        'SmartObject~`':U +
      709        '~`':U +
      710        'NO ~`':U +
      711        '~`':U +
      712        '~`':U +
      713        '~`':U +
      714        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      715           + "~`":U +
      716        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      717        'Record-Source,Record-Target,TableIO-Target~`':U +
      718        '~`':U +
      719        '~`~`~`~`~`~`~`~`~`~`~`':U +
      720        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      721            THEN "^^":U
      722        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      723             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      724   PROCEDURE adm-apply-entry :
      725     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      726   END PROCEDURE.
      727   PROCEDURE adm-destroy :
      728    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      729   END PROCEDURE.
      730   PROCEDURE adm-disable :
      731       DISABLE RECT-7 RECT-9 RECT-8 RECT-5 RAD-otkl RAD-Post Ed-otkl-prc Ed-otkl-prc-2 Ed-otkl-tmh Ed-otkl-tmm RAD-Post-2 tg-zay WITH FRAME F-Main.
      732       RUN dispatch ('disable-fields':U).
      733       RUN set-attribute-list ('ENABLED=no':U).
      734       RETURN.
      735   END PROCEDURE.
      736   PROCEDURE adm-edit-attribute-list :
      737         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      738         RETURN.
      739   END PROCEDURE.
      740   PROCEDURE adm-enable :
      741       ENABLE UNLESS-HIDDEN RECT-7 RECT-9 RECT-8 RECT-5 RAD-otkl RAD-Post Ed-otkl-prc Ed-otkl-prc-2 Ed-otkl-tmh Ed-otkl-tmm RAD-Post-2 tg-zay WITH FRAME F-Main.
      742       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      743       RUN set-attribute-list ('ENABLED=yes':U).
      744       RETURN.
      745   END PROCEDURE.
      746   PROCEDURE adm-exit :
      747        RUN notify ('exit':U).
      748     RETURN.
      749   END PROCEDURE.
      750   PROCEDURE adm-hide :
      751     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      752   END PROCEDURE.
      753   PROCEDURE adm-initialize :
      754     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      755   END PROCEDURE.
      756   PROCEDURE adm-show-errors :
      757       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      758       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      759           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      760       END.
      761       RETURN.
      762   END PROCEDURE.
      763   PROCEDURE adm-UIB-mode :
      764     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      765   END PROCEDURE.
      766   PROCEDURE adm-view :
      767     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      768   END PROCEDURE.
      769   PROCEDURE dispatch :
      770       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      771       RUN broker-dispatch IN adm-broker-hdl
      772           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      773       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      774   END PROCEDURE.
      775   PROCEDURE ensure-broker :
      776   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      777   IF RETURN-VALUE NE "ADM-Broker":U THEN
      778   DO:
      779       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      780       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      781   END.
      782   END PROCEDURE.
      783   PROCEDURE get-attribute :
      784     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      785     RUN broker-get-attribute IN adm-broker-hdl
      786         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      787     RETURN RETURN-VALUE.
      788   END PROCEDURE.
      789   PROCEDURE get-attribute-list :
      790     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      791     RUN broker-get-attribute-list IN adm-broker-hdl
      792         (INPUT THIS-PROCEDURE,
      793          INPUT ?,
      794          OUTPUT p-attr-list) NO-ERROR.
      795     RETURN.
      796   END PROCEDURE.
      797   PROCEDURE new-state :
      798     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      799     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      800     RETURN.
      801   END PROCEDURE.
      802   PROCEDURE notify :
      803     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      804     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      805     IF RETURN-VALUE = "ADM-ERROR":U THEN
      806         RETURN "ADM-ERROR":U.
      807     RETURN.
      808   END PROCEDURE.
      809   PROCEDURE set-attribute-list :
      810     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      811     RUN ensure-broker.
      812     RUN broker-set-attribute-list IN adm-broker-hdl
      813         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      814     RETURN.
      815   END PROCEDURE.
      816   PROCEDURE set-position :
      817       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      818       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      819       IF VALID-HANDLE(adm-object-hdl) THEN
      820       DO:
      821         ASSIGN adm-object-hdl:ROW    =   p-row
      822                adm-object-hdl:COLUMN =   p-col.
      823       END.
      824       RETURN.
      825   END PROCEDURE.
      826   PROCEDURE adm-display-fields :
      827       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      828       RETURN.
      829   END PROCEDURE.
      830   PROCEDURE adm-open-query :
      831     RETURN.
      832   END PROCEDURE.
      833   PROCEDURE adm-row-changed :
      834         IF VALID-HANDLE(adm-object-hdl) THEN
      835           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      836         RUN notify ('row-available':U).
      837         RETURN.
      838   END PROCEDURE.
      839   PROCEDURE reposition-query :
      840       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      841       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      842       RETURN.
      843   END PROCEDURE.
      844     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      845     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      846     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      847     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      848     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      849     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      850     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      851     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      852     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      853     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      854     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      855     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      856     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      857     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      858     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      859     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      860     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      861     IF "":U = "":U THEN
      862       RUN modify-list-attribute IN adm-broker-hdl
      863         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      864     RUN use-create-on-add(?).
      865   PROCEDURE adm-add-record :
      866       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      867          "must have at least one Enabled Table to perform Add.":U
      868          VIEW-AS ALERT-BOX ERROR.
      869       RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-assign-record :
