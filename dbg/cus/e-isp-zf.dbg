      873          "Object ":U THIS-PROCEDURE:FILE-NAME
      874            "must have at least one Enabled Table to perform Assign.":U
      875              VIEW-AS ALERT-BOX ERROR.
      876      RETURN.
      877     END PROCEDURE.
      878   PROCEDURE adm-assign-statement :
      879     RETURN.
      880   END PROCEDURE.
      881   PROCEDURE adm-cancel-record :
      882      RETURN.
      883     END PROCEDURE.
      884   PROCEDURE adm-copy-record :
      885       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      886        "must have at least one Enabled Table to perform Copy.":U
      887          VIEW-AS ALERT-BOX ERROR.
      888       RETURN.
      889   END PROCEDURE.
      890   PROCEDURE adm-create-record :
      891      RETURN.
      892   END PROCEDURE.
      893   PROCEDURE adm-current-changed :
      894     RETURN.
      895   END PROCEDURE.
      896   PROCEDURE adm-delete-record :
      897    MESSAGE
      898          "Object ":U THIS-PROCEDURE:FILE-NAME
      899            "must have at least one Enabled Table to perform Delete.":U
      900              VIEW-AS ALERT-BOX ERROR.
      901       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      902       RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-disable-fields :
      905         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      906       RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-enable-fields :
      909       RETURN.
      910   END PROCEDURE.
      911   PROCEDURE adm-end-update :
      912     RETURN.
      913   END PROCEDURE.
      914   PROCEDURE adm-reset-record :
      915       RETURN.
      916   END PROCEDURE.
      917   PROCEDURE adm-update-record :
      918       MESSAGE
      919         "Object ":U THIS-PROCEDURE:FILE-NAME
      920           "must have at least one Enabled Table to perform Update.":U
      921             VIEW-AS ALERT-BOX ERROR.
      922      RETURN.
      923   END PROCEDURE.
      924   PROCEDURE check-modified :
      925   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      926   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      927   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      928   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      929     IF check-state = "check":U THEN
      930     DO:
      931       RUN get-link-handle IN adm-broker-hdl
      932         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      933            OUTPUT group-target-list).
      934       IF group-target-list NE "":U THEN
      935       DO i = 1 TO NUM-ENTRIES(group-target-list):
      936         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      937         RUN check-modified IN curr-widget ('group-check':U).
      938         IF RETURN-VALUE NE "":U THEN
      939         DO:
      940           RUN check-modified-message(RETURN-VALUE).
      941           RETURN "":U.
      942         END.
      943       END.
      944     END.
      945     RETURN "":U.
      946   END PROCEDURE.
      947   PROCEDURE check-modified-message :
      948     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      949        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      950           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      951        IF RETURN-VALUE = "YES":U THEN
      952           RUN notify ('view,CONTAINER-SOURCE':U).
      953        MESSAGE IF p-changed-table NE ? THEN
      954           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      955           ELSE "Current values have been changed."
      956           SKIP "  Do you wish to save those changes?"
      957           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      958        IF ANS THEN
      959        DO:
      960           IF group-assign-target THEN
      961             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      962           ELSE RUN dispatch('update-record':U).
      963           IF RETURN-VALUE = "ADM-ERROR":U THEN
      964           DO:
      965               MESSAGE "Changes to the previous record were not saved."
      966                 VIEW-AS ALERT-BOX ERROR.
      967               IF group-assign-target THEN
      968                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      969               ELSE RUN dispatch ('cancel-record':U).
      970           END.
      971        END.
      972        ELSE DO:
      973          IF group-assign-target THEN
      974             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      975          ELSE RUN dispatch('cancel-record':U).
      976        END.
      977        RETURN.
      978   END PROCEDURE.
      979   PROCEDURE get-rowid :
      980       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      981       ASSIGN
      982       p-table   =   adm-first-table.
      983       RETURN.
      984   END PROCEDURE.
      985   PROCEDURE init-group-assign :
      986       RUN request-attribute IN adm-broker-hdl
      987         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      988       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      989         group-assign-target = yes.
      990       ELSE group-assign-target = no.
      991       RETURN.
      992   END PROCEDURE.
      993   PROCEDURE set-editors :
      994       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      995       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      996       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      997       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      998       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      999       DO WHILE VALID-HANDLE (curr-widget):
     1000           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1001              curr-widget:HIDDEN = no THEN DO:
     1002             CASE p-field-setting:
     1003               WHEN "INITIALIZE":U THEN
     1004               DO:
     1005                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1006                     read-only-list +
     1007                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1008                        STRING(curr-widget).
     1009               END.
     1010               WHEN "DISABLE":U OR
     1011               WHEN "ENABLE":U THEN
     1012               DO:
     1013                   curr-widget:SENSITIVE = yes.
     1014                   RUN get-attribute ('Read-Only-Editors':U).
     1015                   IF RETURN-VALUE = ? OR
     1016                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1017                       curr-widget:READ-ONLY =
     1018                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1019               END.
     1020               WHEN "CLEAR":U THEN
     1021                   curr-widget:SCREEN-VALUE = "":U.
     1022             END CASE.
     1023           END.
     1024           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1025       END.
     1026       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1027         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1028           + '"':U).
     1029       RETURN.
     1030   END PROCEDURE.
     1031   PROCEDURE use-check-modified-all :
     1032    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1033     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1034     RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE use-create-on-add :
     1037   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1038      RETURN.
     1039   END PROCEDURE.
     1040   PROCEDURE use-initial-lock :
     1041     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1042     ASSIGN adm-initial-lock = p-attr-value.
     1043     RETURN.
     1044   END PROCEDURE.
     1045     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1046   ASSIGN
     1047          FRAME F-Main:SCROLLABLE       = FALSE
     1048          FRAME F-Main:HIDDEN           = TRUE.
     1049   ON VALUE-CHANGED OF RAD-otkl IN FRAME F-Main
     1050   DO:
     1051    assign RAD-otkl.
     1052    assign Ed-otkl-prc.
     1053    assign Ed-otkl-tmh.
     1054    assign Ed-otkl-tmm.
     1055   END.
     1056   ON VALUE-CHANGED OF RAD-Post IN FRAME F-Main
     1057   DO:
     1058     Assign RAD-Post.
     1059     Case RAD-Post :
     1060       when 2 then
     1061       do:
     1062           run ref/cli-all.w ( input my-handle
     1063                         ,input "b-sel,b-mark"
     1064                         ,input 'про':U
     1065                         ,input 'все':U
     1066                         ,input 'текущие':U
     1067                         ,input ?
     1068                         ,input ",,,,,,NO,,"
     1069                         ,input ?
     1070                         ,output cli-lst ) .
     1071           if cli-lst = "" then do:
     1072             Assign  RAD-Post = 1.
     1073             Display RAD-Post with frame F-Main .
     1074           end.
     1075       end.
     1076     End case.
     1077   END.
     1078   if not this-procedure :persistent
     1079   then do:
     1080     message
     1081       vss-workfile vss-revision vss-description skip
     1082       "Ошибка при запуске процедуры" skip
     1083       "Данную процедуру следует запускать только с параметром persistent" skip
     1084       view-as alert-box error .
     1085     undo, return error .
     1086   end.
     1087   PROCEDURE disable_UI :
     1088     HIDE FRAME F-Main.
     1089     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1090   END PROCEDURE.
     1091   PROCEDURE local-initialize :
     1092     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1093   END PROCEDURE.
     1094   PROCEDURE my-report :
     1095    define variable Ed-otkl-tm as integer   no-undo initial 0 .
     1096    case RAD-otkl :
     1097      when 3 then do:
     1098        assign
     1099          Ed-otkl-prc = Ed-otkl-prc-2
     1100        .
     1101      end.
     1102      when 4 then do:
     1103        assign
     1104          Ed-otkl-tm = Ed-otkl-tmh * 60 + Ed-otkl-tmm
     1105        .
     1106      end.
     1107      when 5 then do:
     1108        assign
     1109          Ed-otkl-tm  = 0
     1110          Ed-otkl-prc = 0
     1111        .
     1112      end.
     1113    end.
     1114    run cus/r-isp-zf.p ( RAD-Post, cli-lst, tg-zay, RAD-otkl, Ed-otkl-prc, Ed-otkl-tm, RAD-Post-2) .
     1115   END PROCEDURE.
     1116   PROCEDURE my-var :
     1117     assign frame F-Main   RAD-Post .
     1118     assign frame F-Main   RAD-Post-2 .
     1119     assign frame F-Main   RAD-otkl .
     1120     assign frame F-Main   Ed-otkl-prc .
     1121     assign frame F-Main   Ed-otkl-tmm .
     1122     assign frame F-Main   Ed-otkl-tmh .
     1123     assign frame F-Main   tg-zay .
     1124     str1 = "Выбор заказов: " .
     1125     case RAD-otkl :
     1126       when 1 then do:
     1127         str1 = str1 + "все" .
     1128       end.
     1129       when 2 then do:
     1130         str1 = str1 + "от выбранных поставщиков" .
     1131       end.
     1132     end.
     1133     str2 = "Выбор товаров: " .
     1134     case RAD-otkl :
     1135       when 1 then do:
     1136         str2 = str2 + "все" .
     1137       end.
     1138       when 2 then do:
     1139         str2 = str2 + "отклонения по кол-ву больше " + String(Ed-otkl-prc) + "  %" .
     1140       end.
     1141       when 3 then do:
     1142         str2 = str2 + "отклонения по кол-ву больше " + String(Ed-otkl-prc) + "  %" .
     1143       end.
     1144       when 4 then do:
     1145         str2 = str2 + "отклонения по времени больше " + String(Ed-otkl-tmh) + " ч. " + String(Ed-otkl-tmm) + " м. " .
     1146       end.
     1147       when 5 then do:
     1148         str2 = str2 + "все отклонения" .
     1149       end.
     1150     end.
     1151     case RAD-post-2 :
     1152       when 1 then do:
     1153         str3 = "Сравнивать по поставкам" .
     1154       end.
     1155       when 2 then do:
     1156         str3 = "Сравнивать по накладным" .
     1157       end.
     1158     end.
     1159    ReportNAme   = "Отчет по исполнению заказов" .
     1160   END PROCEDURE.
     1161   PROCEDURE state-changed :
     1162     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1163     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1164     CASE p-state:
     1165     END CASE.
     1166   END PROCEDURE.
