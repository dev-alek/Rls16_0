      590   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   define  stream PrnLibStream.
      592   procedure prn-lib-prn-file :
      593     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      594     define input parameter p-DIsabledoptions as integer no-undo .
      595     define variable v-report-name as character no-undo .
      596     define variable v-user-action as character no-undo .
      597     define variable v-printed     as logical   no-undo .
      598     define variable v-exist       as logical   no-undo .
      599     do
      600       on error undo, return error
      601       :
      602       run prn-lib-get-report-name  in this-procedure (
      603         input parParentProc
      604         ,output v-report-name
      605         ).
      606   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      608     (input  v-report-name
      609     ,input  2
      610     ,output v-exist
      611     )  .
      612       if NOT v-exist then
      613       DO:
      614         Message
      615           "Нет заданий на печать ! "
      616           view-as alert-box .
      617         Return  .
      618       End.
      619       run gbl/prnfilen.w
      620         (input  ""
      621         ,input  p-DisabledOptions
      622         ,input  string(v-report-name )
      623         ,input  7
      624         ,output v-user-action
      625         ,output v-printed
      626         ) .
      627       if v-printed then
      628       do:
      629         return "YES" .
      630       end.
      631       else
      632       do:
      633         return "NO" .
      634       end.
      635     end.
      636   end procedure.
      637   procedure prn-lib-open-stream :
      638     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      639     define input parameter p-page-size    as integer no-undo .
      640     define input parameter p-is-stream    as logical no-undo .
      641     define input parameter p-append       as logical no-undo .
      642     define variable v-report-name as character no-undo .
      643     do
      644       on error undo, return error
      645       :
      646       run prn-lib-get-report-name  in this-procedure (
      647         input parParentProc
      648         ,output v-report-name
      649         ).
      650       if p-is-stream then
      651       do:
      652         if p-append then
      653         do:
      654           output stream PrnLibStream to value( v-report-name )
      655             page-size value(p-page-size) append .
      656         end.
      657         if not p-append then
      658         do:
      659           output stream PrnLibStream to value( v-report-name )
      660             page-size value(p-page-size) .
      661         end.
      662       end.
      663       if not p-is-stream then
      664       do:
      665         if p-append then
      666         do:
      667           output to value( v-report-name )
      668             page-size value(p-page-size) append .
      669         end.
      670         if not p-append then
      671         do:
      672           output to value( v-report-name )
      673             page-size value(p-page-size) .
      674         end.
      675       end.
      676     end.
      677   end procedure.
      678   procedure prn-lib-open-exp :
      679     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      680     define input parameter p-is-stream    as logical no-undo .
      681     define input parameter p-is-append    as logical no-undo .
      682     define output parameter p-ReportFileName as char init "report" no-undo.
      683     define output parameter p-process as logical no-undo .
      684     define variable glog as logical no-undo .
      685     do
      686       on error undo, return error
      687       :
      688       SYSTEM-DIALOG GET-FILE p-ReportFileName
      689         TITLE      "Укажите путь"
      690         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      691         ASK-OVERWRITE
      692         CREATE-TEST-FILE
      693         SAVE-AS
      694         USE-FILENAME
      695         DEFAULT-EXTENSION "txt"
      696         UPDATE glog
      697         .
      698       if not glog then  return.
      699       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      700       if p-is-stream then
      701       do:
      702         if p-is-append then
      703         do:
      704           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      705         end.
      706         else
      707         do:
      708           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      709         end.
      710       end.
      711       else
      712       do:
      713         if p-is-append then
      714         do:
      715           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      716         end.
      717         else
      718         do:
      719           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      720         end.
      721       end.
      722       p-process = yes.
      723     end.
      724   end procedure.
      725   procedure prn-lib-get-report-name :
      726     define input parameter parParentProc  as widget-handle no-undo.
      727     define output parameter p-report-name as character no-undo .
      728     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      729   end procedure.
      730   procedure prn-lib-reportviewer-report-name :
      731     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      732     define input parameter p-report-name-html as character no-undo .
      733     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      734   end procedure.
      735   procedure prn-lib-reportviewer :
      736     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      737     define input parameter p-report-name-html as character no-undo .
      738     define input parameter p-param        as character no-undo .
      739     define variable v-excel           as character no-undo init 'TRUE' .
      740     define variable v-value-character as character no-undo .
      741     define variable v-value-integer   as character no-undo .
      742     define variable v-value-date      as date      no-undo .
      743     define variable v-value-decimal   as decimal   no-undo .
      744     define variable rep-excel         as logical   no-undo .
      745     define variable excel-string      as character no-undo .
      746     define variable v-param-type      as character no-undo .
      747     define variable v-tth             as handle    no-undo .
      748     run adm/shattri.p (
      749       input "get":U
      750       ,input  ""
      751       ,input  0
      752       ,input  'report-glob':U
      753       ,input  'rep-excel':U
      754       ,output v-value-character
      755       ,output v-value-date
      756       ,output v-value-decimal
      757       ,output v-value-integer
      758       ,output rep-excel
      759       ,output v-param-type
      760       ,INPUT-OUTPUT table-handle v-tth
      761       )  .
      762     if rep-excel then v-excel = "TRUE" .
      763     else v-excel = "FALSE" .
      764     if p-param eq ""
      765     then
      766        p-param = "EXCEL:" + v-excel.
      767     else
      768        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      769     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      770   end procedure.
      771   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      772   define variable v-waitfram-action01         as character   no-undo .
      773   define variable v-waitfram-action02         as character   no-undo .
      774   define variable v-waitfram-action03         as character   no-undo .
      775   define variable mWaitFramTextBeg            as character   no-undo.
      776   define variable mWaitFramTextEnd            as character   no-undo.
      777   define variable mWaitFramView               as logical     no-undo.
      778   define variable mWaitProcEvent              as logical     no-undo init yes.
      779   define variable mWaitFramInterval           as integer     no-undo init 1 .
      780   define variable mWaitFramStop               as logical     no-undo.
      781   define variable mWaitFramStopUser           as logical     no-undo.
      782   define variable mWaitFramStopTimeOut        as logical     no-undo.
      783   define variable mWaitFramStartProc          as datetime-tz no-undo.
      784   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      785   define button B-WaitFramStop auto-end-key
      786        label "Стоп"
      787        size 10 by 1 tooltip "Остоновить процесс".
      788   define button B-viewProcInfo
      789        label "Информация"
      790        size 15 by 1 tooltip "Информация о процесс".
      791   define frame waitfram
      792     v-waitfram-action01 format "x(72)" no-label skip
      793     v-waitfram-action02 format "x(72)" no-label skip
      794     v-waitfram-action03 format "x(72)" no-label skip
      795     B-viewProcInfo
      796     B-WaitFramStop at row 4 col 30
      797     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      798     .
      799   define new global shared variable mBatchMode as logical no-undo init ?.
      800   define variable mFramBachModHandle as handle no-undo.
      801   mFramBachModHandle = frame waitfram:handle.
      802   define variable mFameOldVis as logical no-undo.
      803   define variable mVisCUrentVin as logical no-undo.
      804   if session:batch-mode
      805   then
      806      mBatchMode = yes.
      807   if mBatchMode = ? then do:
      808     mVisCUrentVin = current-window:visible.
      809     mFameOldVis = mFramBachModHandle:visible.
      810     mFramBachModHandle:visible  = yes.
      811     mBatchMode = mFramBachModHandle:visible ne yes.
      812     mFramBachModHandle:visible = mFameOldVis.
      813     current-window:visible = mVisCUrentVin.
      814   end.
      815    if  log-manager:logfile-name ne ?
      816     then DO:
      817         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      818         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      819         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      820     end.
      821   on choose of B-WaitFramStop in frame waitfram
      822   do:
      823     mWaitFramStop = yes.
      824     mWaitFramStopUser = yes.
      825   end.
      826   function waitfram-check-timeout returns logical():
      827      define variable vtime as int64 no-undo.
      828      if mWaitFramStopTimeOut
      829      then
      830         return yes.
      831      vtime = ( now - mWaitFramStartProc ) / 1000 .
      832      if     mWaitFramTimeOut ne ?
      833         and mWaitFramTimeOut ne 0
      834         and mWaitFramTimeOut lt vtime
      835      then do:
      836         mWaitFramStopTimeOut = yes.
      837      end.
      838      return mWaitFramStopTimeOut.
      839   end.
      840   procedure waitfram-hide :
      841     if not session:batch-mode
      842     then do
      843     on error undo, return error return-value
      844     :
      845       pause 0 before-hide .
      846       if not mBatchMode then
      847         hide frame waitfram .
      848     if     not mWaitFramView
      849        and mWaitProcEvent
      850     then
      851       process events .
      852     end.
      853   end procedure.
      854   procedure waitfram-show :
      855     define input  parameter p-message as character no-undo .
      856     define variable v-left-margin as integer   no-undo .
      857     if not session:batch-mode
      858     then do
      859     on error undo, return error return-value
      860     :
      861       if length(p-message) <= 70 then do:
      862         assign
      863           v-left-margin = integer((70 - length(p-message)) / 2)
      864         .
      865         assign
      866           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      867         .
      868         assign
      869           v-waitfram-action01 = " "
      870           v-waitfram-action02 = " "
      871                                    + fill(" ", v-left-margin)
      872                                    + p-message
      873           v-waitfram-action03 = " "
      874         .
      875       end.
      876       else do:
      877         define variable vRindex1 as integer no-undo.
      878         define variable vRindex2 as integer no-undo.
      879         vRindex1 = r-index(p-message," ",70).
      880         if vRindex1 = 0
      881         then
      882            vRindex1 = 70.
      883         if length(p-message)  <= vRindex1 + 70 then do:
      884           assign
      885             v-waitfram-action01 = " "
      886             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      887             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      888           .
      889         end.
      890         else do:
      891           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      892           if vRindex2 <= vRindex1
      893           then
      894              vRindex2 = vRindex1 + 70.
      895           assign
      896             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      897             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      898             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      899           .
      900         end.
      901       end.
      902       B-viewProcInfo:visible   in frame waitfram = no.
      903       B-viewProcInfo:sensitive in frame waitfram = no.
      904       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      905       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      906       if  (   mWaitFramView
      907          or  mWaitProcEvent)
      908          and not mBatchMode
      909       then
      910          display
      911             v-waitfram-action01 skip
      912             v-waitfram-action02 skip
      913             v-waitfram-action03 skip
      914          with frame waitfram .
      915       if     mWaitFramView
      916          then do:
      917             if     mWaitFramInterval ne ?
      918                and not mBatchMode
      919             then
      920                wait-for go of frame waitfram pause mWaitFramInterval.
      921          end.
      922          else
      923             if     mWaitProcEvent
      924                and not mBatchMode
      925             then
      926                process events .
      927     end.
      928   end procedure.
      929      procedure waitfram-show-this:
      930         define input  parameter iInterval as int64 no-undo.
      931         define variable vtime as int64 no-undo.
      932         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      933         mWaitFramInterval = iInterval.
      934         run waitfram-show (substitute("&1&2 &3&4" ,
      935                                       mWaitFramTextBeg ,
      936                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      937                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      938                                       mWaitFramTextEnd
      939                                      )
      940                           ).
      941      end.
      942      procedure WaitFramRunPause:
      943         define input  parameter iInterval as dec no-undo.
      944         define variable vStart  as datetime-tz no-undo.
      945         define variable vend    as datetime-tz no-undo.
      946         define variable vint as int64 no-undo.
      947         define variable vOk as logical no-undo.
      948         vStart = now.
      949         vend   = vStart.
      950         publish "WaitFramPause" (iInterval,output vOk).
      951         vend   =  now.
      952         vint = vend - vStart.
      953         vint = iInterval - vint / 1000.
      954         if     not mWaitFramStop
      955            and (   vint > 0
      956                 or (    not vOk
      957                     and iInterval eq ?
      958                     )
      959                 )
      960         then
      961            run waitfram-show-this (iInterval).
      962         vend   =  now.
      963         vint = vend - vStart.
      964         vint = iInterval - vint / 1000.
      965         if     not mWaitFramStop
      966            and vint > 0
      967         then do:
      968            run gbl/pause.p (vint * 1000).
      969         end.
      970         if iInterval ne ?
      971         then
      972            publish "WaitFramStop".
      973         waitfram-check-timeout().
      974      end.
      975      procedure WaitFramWaitFor:
      976         define input  parameter iInterval as dec no-undo.
      977         assign
      978            mWaitFramStartProc   = now
      979            mWaitFramStopUser    = no
      980            mWaitFramStopTimeOut = no
      981         .
      982         block-wait:
      983         do while not mWaitFramStop:
      984            run WaitFramRunPause (iInterval).
      985            if  waitfram-check-timeout()
      986            then do:
      987               leave block-wait.
      988            end.
      989         end.
      990         run waitfram-hide.
      991      end.
      992   procedure waitfram-join :
      993     define input  parameter p-line-1  as character no-undo .
      994     define input  parameter p-line-2  as character no-undo .
      995     define input  parameter p-line-3  as character no-undo .
      996     define output parameter p-message as character no-undo .
      997     do
      998     on error undo, return error return-value
      999     :
     1000       assign
     1001         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1002                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1003                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1004       .
     1005     end.
     1006   end procedure.
     1007   function waitfram-join-function returns character
     1008     (input p-line-1 as character
     1009     ,input p-line-2 as character
     1010     ,input p-line-3 as character
     1011     ).
     1012     define variable v-message as character no-undo .
     1013     run waitfram-join in this-procedure
     1014       (input  p-line-1
     1015       ,input  p-line-2
     1016       ,input  p-line-3
     1017       ,output v-message
     1018       ) .
     1019     return v-message .
     1020   end function .
     1021   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   procedure cur-time :
     1023      define output parameter p-today as date      no-undo .
     1024      define output parameter p-time  as integer   no-undo .
     1025     do
     1026     on error undo, return error
     1027     :
     1028       define variable v-date1 as date      no-undo .
     1029       define variable v-date2 as date      no-undo .
     1030       define variable v-time  as integer   no-undo .
     1031       assign
     1032         v-date1 = today
     1033         v-time  = time
     1034         v-date2 = today
     1035       .
     1036       if v-date1 <> v-date2
     1037       then do:
     1038         assign
     1039           v-date1 = today
     1040           v-time  = v-time
     1041         .
     1042       end.
     1043       assign
     1044         p-today = v-date1
     1045         p-time  = v-time
     1046       .
     1047     end.
     1048   end.
     1049   function cur-time-date returns character
     1050   :
     1051     return string(today, '99/99/9999':U) .
     1052   end.
     1053   function cur-time-mjd returns decimal
     1054   :
     1055     define variable v-date as date      no-undo .
     1056     define variable v-time as integer   no-undo .
     1057     run cur-time in this-procedure
     1058       (output v-date
     1059       ,output v-time
     1060       ) .
     1061     return integer(v-date) - 2400002 + (v-time / 86400) .
     1062   end.
     1063   function cur-time-get-ending-index returns integer
     1064   (input p-number as integer
     1065   )
     1066   :
     1067     if p-number < 0
     1068     or p-number = ?
     1069     then do:
     1070       return 1 .
     1071     end.
     1072     define variable v-rest as integer   no-undo .
     1073     assign
     1074       p-number = p-number modulo 100
     1075     .
     1076     if p-number < 20
     1077     then do:
     1078       assign
     1079         v-rest = p-number
     1080       .
     1081     end.
     1082     else do:
     1083       assign
     1084         v-rest = p-number modulo 10
     1085       .
     1086     end.
     1087     case v-rest :
     1088       when 1
     1089       then do:
     1090         return 2 .
     1091       end.
     1092       when 2 or
     1093       when 3 or
     1094       when 4
     1095       then do:
     1096         return 3 .
     1097       end.
     1098       otherwise do:
     1099         return 1 .
     1100       end.
     1101     end case .
     1102   end.
     1103   procedure cur-time-mjd-to-date :
     1104      define input  parameter i-mjd-diff as decimal no-undo.
     1105      define output parameter o-Date     as date    no-undo.
     1106      define output parameter o-Time     as integer no-undo.
     1107      define variable v-day-number as integer   no-undo .
     1108      if    i-mjd-diff < 0
     1109         or i-mjd-diff = ?
     1110      then do:
     1111         return "?" .
     1112      end.
     1113      assign
     1114         v-day-number = truncate(i-mjd-diff,0).
     1115         o-Date = date(v-day-number + 2400002).
     1116         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1117     .
     1118   end.
     1119   function cur-time-mjd-to-string returns character
     1120   (input p-mjd-diff as decimal
     1121   )
     1122   :
     1123     define variable v-day-number as integer   no-undo .
     1124     define variable v-seconds    as integer   no-undo .
     1125     define variable v-hour       as integer   no-undo .
     1126     define variable v-min        as integer   no-undo .
     1127     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1128     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1129     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1130     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1131     if p-mjd-diff < 0
     1132     or p-mjd-diff = ?
     1133     then do:
     1134       return "?" .
     1135     end.
     1136     assign
     1137       v-day-number = integer(truncate(p-mjd-diff,0))
     1138       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1139     .
     1140     if v-seconds > 86400
     1141     then do:
     1142       assign
     1143         v-seconds = 86400 - 1
     1144       .
     1145     end.
     1146     if v-seconds < 0
     1147     then do:
     1148       assign
     1149         v-seconds = 0
     1150       .
     1151     end.
     1152     assign
     1153       v-hour = truncate(v-seconds / 3600, 0)
     1154     .
     1155     assign
     1156       v-seconds = v-seconds modulo 3600
     1157     .
     1158     assign
     1159       v-min = truncate(v-seconds / 60, 0)
     1160     .
     1161     assign
     1162       v-seconds = v-seconds modulo 60
     1163     .
     1164     return
     1165         (if v-day-number <> 0
     1166           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1167           else ""
     1168         )
     1169       + (if v-day-number <> 0 or v-hour <> 0
     1170           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1171           else ""
     1172         )
     1173       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1174           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1175           else ""
     1176         )
     1177       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1178       .
     1179   end.
     1180   function cur-time-string returns character
     1181   :
     1182     define variable v-date as date      no-undo .
     1183     define variable v-time as integer   no-undo .
     1184     run cur-time in this-procedure
     1185       (output v-date
     1186       ,output v-time
     1187       ) .
     1188     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1189   end.
     1190   function cur-time-string-sec returns character
     1191   :
     1192     define variable v-date as date      no-undo .
     1193     define variable v-time as integer   no-undo .
     1194     run cur-time in this-procedure
     1195       (output v-date
     1196       ,output v-time
     1197       ) .
     1198     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1199   end.
     1200   function cur-time-custom  returns character
     1201   (input p-prefix as character
     1202   ,input p-date-format as character
     1203   ,input p-delimiter as character
     1204   ,input p-time-format as character
     1205   ,input p-suffix as character
     1206   )
     1207   :
     1208     define variable v-date as date      no-undo .
     1209     define variable v-time as integer   no-undo .
     1210     run cur-time in this-procedure
     1211       (output v-date
     1212       ,output v-time
     1213       ) .
     1214     return
     1215       p-prefix
     1216       + string(v-date, p-date-format)
     1217       + p-delimiter
     1218       + string(v-time, p-time-format)
     1219       + p-suffix
     1220       .
     1221   end.
     1222   function cur-time-print  returns character
     1223   :
     1224     define variable v-date as date      no-undo .
     1225     define variable v-time as integer   no-undo .
     1226     run cur-time in this-procedure
     1227       (output v-date
     1228       ,output v-time
     1229       ) .
     1230     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1231   end.
     1232   function cur-time-datetime returns datetime
     1233   :
     1234     define variable v-char as character no-undo .
     1235     define variable v-datetime as datetime no-undo .
     1236     v-char = cur-time-string().
     1237     v-datetime = datetime(v-char).
     1238     return  v-datetime.
     1239   end.
     1240   function cur-time-string-msec returns character
     1241   :
     1242     define variable v-date as datetime  no-undo .
     1243     v-date = now.
     1244     return string(v-date) .
     1245   end.
     1246   DEFINE VARIABLE v-main-code like ub.bar-code.b-code no-undo .
     1247   DEFINE VARIABLE line as character no-undo .
     1248   DEFINE VARIABLE date_string as character no-undo .
     1249   DEFINE VARIABLE for-time as character no-undo .
     1250   DEFINE VARIABLE accum-count as integer no-undo .
     1251   DEFINE VARIABLE accum-netto as decimal no-undo .
     1252   DEFINE VARIABLE v-slt-sum as decimal no-undo .
     1253   DEFINE VARIABLE v-agent-profit as decimal no-undo .
     1254   DEFINE VARIABLE v-principial-profit as decimal no-undo .
     1255   define variable v-header-base-curr as character no-undo .
     1256   define variable v-base-code like ub.sysconf.base-code no-undo .
     1257   define buffer buf_goods for ub.goods.
     1258   define buffer buf_chk-gds  for ub.chk-gds.
     1259   define buffer buf_chk-doc  for ub.chk-doc.
     1260   define buffer buf_currency for ub.currency.
     1261   define buffer buf_clients for ub.clients.
     1262   find first buf_goods no-lock where
     1263              buf_goods.gds-code = p-gds-code.
     1264   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1265     (input  p-gds-code
     1266     ,input  ?
     1267     ,output v-main-code
     1268     ) no-error .
     1269   if error-status:error then do:
     1270     return .
     1271   end.
     1272   define variable v-curr-r-b as character no-undo .
     1273   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1274   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1275     (output v-curr-r-b
     1276     )  .
     1277   if v-curr-r-b = 'base':U then do:
     1278   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1280     (input  p-curr-host-code
     1281     ,output v-base-code
     1282     )  .
     1283     find first buf_currency no-lock where
     1284             buf_currency.curr-code = v-base-code.
     1285     assign
     1286     v-header-base-curr = string( "( Б.Вал. - " + caps( buf_currency.curr-abbr) + " )" )
     1287     .
     1288   end.
     1289   find first buf_clients where
     1290               buf_clients.obj-type = 'орг':U
     1291           AND buf_clients.obj-code = p-curr-host-code.
     1292   DEFINE FRAME Chk-List
     1293   buf_chk-doc.doc-code      column-label "Номер_чека"  format "X(23)"
     1294   buf_chk-doc.chk-num       column-label "N_по кассе" format ">>>>>>9"
     1295   buf_chk-doc.pay-desk      column-label "Касса"
     1296   buf_chk-doc.chk-date      column-label "Дата" format "99/99/9999"
     1297   for-time                  column-label "Время"   format "X(5)"
     1298   buf_chk-doc.netto         column-label "Сумма_оплат"
     1299   HEADER  date_string AT 1 format "X(35)"
     1300   v-header-base-curr        format "X(20)"
     1301   string( "Страница " ) format "X(9)" AT 59 PAGE-NUMBER(PrnLibStream) AT 69 FORMAT ">>9" SKIP
     1302   Line format "X(73)" AT 1
     1303   with width 232 down stream-io use-text    .
     1304   Line = fill("-", 73).
     1305   date_string = cur-time-print() .
     1306   assign
     1307   Sheetf.Excel-Column-Lable =
     1308   "Номер чека"  + chr(44) +
     1309   "N по кассе" + chr(44) +
     1310   "Касса" + chr(44) +
     1311   "Дата" + chr(44) +
     1312   "Время" + chr(44) +
     1313   "Сумма оплат"
     1314   sheetf.sizes =
     1315   "23" + chr(44) +
     1316   "7"  +  chr(44) +
     1317   "5" + chr(44) +
     1318   "10" + chr(44) +
     1319   "5" + chr(44) +
     1320   "13"
     1321   .
     1322   run prn-lib-open-stream  in this-procedure (
     1323                                                input parParentProc
     1324                                               ,input 62
     1325                                               ,input yes
     1326                                               ,input no
     1327                                               ).
     1328   run rep/extitle.p (1).
     1329   FORM with FRAME CHk-list .
     1330   PUT stream PrnLibStream UNFORMATTED
     1331   SPACE(10)
     1332   p-Report-header
     1333   SKIP(1).
     1334   FORM HEADER
     1335   Line format "X(73)" AT 1 SKIP
     1336   "Продолжение - на следующей странице" AT 30 SKIP
     1337   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1338   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1339   FORM with FRAME Chk-List  .
     1340   run waitfram-show in this-procedure ("Ждите...").
     1341   for each obj-list no-lock:
     1342     _chk-gds:
     1343     for each buf_chk-gds no-lock where
     1344             buf_chk-gds.b-code = v-main-code,
     1345       FIRST buf_chk-doc No-LOCK WHERE
     1346             buf_chk-doc.doc-code = buf_chk-gds.doc-code
     1347         AND buf_chk-doc.obj-type = obj-list.obj-type
     1348         AND buf_chk-doc.obj-code = obj-list.obj-code
     1349         AND buf_chk-doc.chk-date >= X-date-start
     1350         AND buf_chk-doc.chk-date <= X-date-end:
     1351       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1352       display stream PrnLibStream
     1353       buf_chk-doc.doc-code
     1354       buf_chk-doc.pay-desk
     1355       buf_chk-doc.chk-num
     1356       buf_chk-doc.chk-date
     1357       string(buf_chk-doc.chk-time, "HH:MM") @ for-time
     1358       buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt) @ buf_chk-doc.netto
     1359       with frame chk-list.
     1360       DOWN STREAM PrnLibStream 1
     1361       with FRAME CHk-List  .
     1362       if Make-Excel then  put   stream ForExcel unformatted
     1363       buf_chk-doc.doc-code                                                   CHR(9)
     1364       buf_chk-doc.pay-desk                                                   CHR(9)
     1365       buf_chk-doc.chk-num                                                    CHR(9)
     1366       buf_chk-doc.chk-date                                                   CHR(9)
     1367       string(buf_chk-doc.chk-time, "HH:MM")                                  CHR(9)
     1368       buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     1369       skip.
     1370       assign
     1371       accum-count      = accum-count + 1
     1372       accum-netto      = accum-netto + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     1373       .
     1374     end.
     1375   end.
     1376   underline stream PrnLibStream
     1377   buf_chk-doc.doc-code
     1378   buf_chk-doc.pay-desk
     1379   buf_chk-doc.chk-num
     1380   buf_chk-doc.chk-date
     1381   for-time
     1382   buf_chk-doc.netto
     1383   with frame chk-list.
     1384   DOWN STREAM PrnLibStream 1
     1385   with FRAME CHk-List  .
     1386   assign
     1387   v-slt-sum = (if T-slt-sum
     1388                then accum-netto / (100 + f-slt-pc ) * f-slt-pc
     1389                else 0)
     1390   v-agent-profit = accum-netto * 0.01
     1391   v-principial-profit = accum-netto - v-slt-sum - v-agent-profit
     1392   .
     1393   display stream PrnLibStream
     1394   "Итого" + chr(32) + string(accum-count) + chr(32) + "чеков" @ buf_chk-doc.doc-code
     1395   "на" @ buf_chk-doc.chk-num
     1396   "сумму" @ buf_chk-doc.pay-desk
     1397   accum-netto @ buf_chk-doc.netto
     1398   with frame chk-list.
     1399   DOWN STREAM PrnLibStream 1
     1400   with FRAME CHk-List  .
     1401   if Make-Excel then  put   stream ForExcel unformatted
     1402   ("Итого" + chr(32) + string(accum-count) + chr(32) + "чеков")  CHR(9)
     1403   "на"                                                                       CHR(9)
     1404   "сумму"                                                                    CHR(9)
     1405                                                                              CHR(9)
     1406                                                                              CHR(9)
     1407   accum-netto
     1408   skip.
     1409   put stream PrnLibStream unformatted
     1410   skip(2)
     1411   string("ИТОГО продано на сумму", "x(45)")
     1412   string(accum-netto, "->>>,>>>,>>9.99") skip(0)
     1413   (if T-SLt-sum
     1414   then (
     1415         string(("в том числе НсП" + chr(32) +
     1416                 string(f-slt-pc, ">9.99%") + chr(32)), "X(45)") +
     1417         string(v-slt-sum, "->>>,>>>,>>9.99") + chr(10)
     1418         )
     1419   else "":U)
     1420   string("Сумма агентского вознаграждения составляет", "X(45)")
     1421   string(v-agent-profit , "->>>,>>>,>>9.99") skip(0)
     1422   string("Подлежит перечислению принципиалу", "X(45)")
     1423   string(v-principial-profit , "->>>,>>>,>>9.99") skip(2)
     1424   string("От имени Агента", "X(20)") chr(32) string(buf_clients.obj-name, "X(25)") chr(32)
     1425   "отчет сдал" chr(32) fill("_", 15)
     1426   skip(0)
     1427   fill(chr(32), 58)
     1428   "(подпись)"
     1429   skip(0)
     1430   fill(chr(32), 49) "М.П."
     1431   skip(2)
     1432   string("От имени Принципиала", "X(20)") chr(32) string(buf_goods.gds-name, "X(25)") chr(32)
     1433   "отчет принял" chr(32) fill("_", 13)
     1434   skip(0)
     1435   fill(chr(32), 58)
     1436   "(подпись)"
     1437   skip
     1438   fill(chr(32), 49) "М.П."
     1439   skip.
     1440   if Make-Excel then  put   stream ForExcel unformatted
     1441   skip(2)
     1442   "ИТОГО продано на сумму"                         CHR(9)
     1443                                                    CHR(9)
     1444                                                    CHR(9)
     1445                                                    CHR(9)
     1446                                                    CHR(9)
     1447   string(accum-netto, "->>>,>>>,>>9.99") skip(0)
     1448   (if T-SLt-sum
     1449   then (
     1450         "в том числе НсП" + CHR(9) +
     1451                             CHR(9) +
     1452         string(f-slt-pc, ">9.99%")  + CHR(9) +
     1453                                       CHR(9) +
     1454                                       CHR(9) +
     1455         string(v-slt-sum, "->>>,>>>,>>9.99") + chr(10)
     1456         )
     1457   else "":U)
     1458   "Сумма агентского вознаграждения составляет"       CHR(9)
     1459                                                      CHR(9)
     1460                                                      CHR(9)
     1461                                                      CHR(9)
     1462                                                      CHR(9)
     1463   string(v-agent-profit , "->>>,>>>,>>9.99") skip(0)
     1464   "Подлежит перечислению принципиалу"                 CHR(9)
     1465                                                       CHR(9)
     1466                                                       CHR(9)
     1467                                                       CHR(9)
     1468                                                       CHR(9)
     1469   string(v-principial-profit , "->>>,>>>,>>9.99") skip(2)
     1470   "От имени Агента"                                   CHR(9)
     1471   string(buf_clients.obj-name, "X(25)")
     1472   SKIP
     1473                                                       CHR(9)
     1474                                                       CHR(9)
     1475                                                       CHR(9)
     1476   "отчет сдал"                                        CHR(9)
     1477   fill("_", 15)
     1478   skip(0)
     1479                                                      CHR(9)
     1480                                                      CHR(9)
     1481                                                      CHR(9)
     1482                                                      CHR(9)
     1483                                                      CHR(9)
     1484   "(подпись)"
     1485   skip(0)
     1486                                                      CHR(9)
     1487                                                      CHR(9)
     1488                                                      CHR(9)
     1489                                                      CHR(9)
     1490                                                      CHR(9)
     1491    "М.П."
     1492   skip(2)
     1493   "От имени Принципиала"                             CHR(9)
     1494    buf_goods.gds-name
     1495    SKIP
     1496                                                      CHR(9)
     1497                                                      CHR(9)
     1498                                                      CHR(9)
     1499   "отчет принял"                                     CHR(9)
     1500    fill("_", 13)
     1501   skip(0)
     1502                                                      CHR(9)
     1503                                                      CHR(9)
     1504                                                      CHR(9)
     1505                                                      CHR(9)
     1506                                                      CHR(9)
     1507   "(подпись)"
     1508   skip
     1509                                                      CHR(9)
     1510                                                      CHR(9)
     1511                                                      CHR(9)
     1512                                                      CHR(9)
