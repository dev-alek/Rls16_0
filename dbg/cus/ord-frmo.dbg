      463        SIZE 14 BY .67 TOOLTIP "Коэффициент пересчета баз.ед.изм. в ед.изм.поставщика"
      464        FGCOLOR 1  NO-UNDO.
      465   DEFINE QUERY Dialog-Frame FOR
      466         ub.ord-line SCROLLING.
      467   DEFINE FRAME Dialog-Frame
      468        b-save AT ROW 1 COL 1
      469        b-quit AT ROW 1 COL 12
      470        b-exit-cycl AT ROW 1 COL 22
      471        B-help AT ROW 1 COL 78.38
      472        scr-qnty AT ROW 5.38 COL 17.38 COLON-ALIGNED
      473        scr-price-rubl AT ROW 8 COL 17.5 COLON-ALIGNED
      474        scr-price-base AT ROW 9 COL 17.5 COLON-ALIGNED
      475        scr-artic AT ROW 2.79 COL 17.38 COLON-ALIGNED
      476        scr-gds-name AT ROW 2.79 COL 36 COLON-ALIGNED NO-LABEL
      477        scr-prod-code AT ROW 3.83 COL 17.38 COLON-ALIGNED
      478        scr-prod-type AT ROW 3.88 COL 29 COLON-ALIGNED NO-LABEL
      479        scr-prod-name AT ROW 3.92 COL 35.75 COLON-ALIGNED NO-LABEL
      480        scr-unit-base AT ROW 5.54 COL 30.75 COLON-ALIGNED NO-LABEL
      481        v-cli-base-rate AT ROW 5.75 COL 37.5 COLON-ALIGNED NO-LABEL
      482        scr-val AT ROW 6.42 COL 76.75 COLON-ALIGNED NO-LABEL
      483        scr-unit-cli AT ROW 6.63 COL 30.75 COLON-ALIGNED NO-LABEL
      484        scr-cli-qnty AT ROW 6.67 COL 17.38 COLON-ALIGNED
      485        scr-sum-rubl AT ROW 8 COL 64.5 COLON-ALIGNED
      486        scr-sum-base AT ROW 8.83 COL 64.5 COLON-ALIGNED
      487        SPACE(1.12) SKIP(6.24)
      488       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      489            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      490            TITLE "<insert dialog title>".
      491   ASSIGN
      492          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      493          FRAME Dialog-Frame:HIDDEN           = TRUE.
      494   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      495   DO:
      496     APPLY "END-ERROR":U TO SELF.
      497   END.
      498   ON CHOOSE OF b-exit-cycl IN FRAME Dialog-Frame
      499   DO:
      500      assign
      501        stp-cycle  =  true
      502        stp-exit  =  false.
      503        .
      504   END.
      505   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      506   DO:
      507   if p-line-mode = 'ПРОСМОТР':U then do:
      508       stp-cycle  =  false.
      509       stp-exit  =  true .
      510       return.
      511   end.
      512   define variable compare-log as logical no-undo .
      513   if p-line-mode <> "ЦИКЛ":u   then do:
      514       if compare-log = false then do:
      515           message "Вы действительно хотите выйти без сохранения изменений ?" view-as alert-box question
      516                   buttons yes-no   update jjj as logical .
      517                   if jjj = true then
      518       end.
      519   end.
      520       stp-cycle  =  false.
      521       stp-exit  =  true .
      522       return "error".
      523   END.
      524   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      525   DO:
      526       stp-cycle  =  false.
      527       stp-exit   =  false.
      528       assign frame Dialog-Frame scr-qnty .
      529       if scr-price-rubl:SENSITIVE then  assign frame Dialog-Frame scr-price-rubl .
      530       if scr-price-base:SENSITIVE then  assign frame Dialog-Frame scr-price-base .
      531       assign
      532         shar_ord-line.qnty       = scr-qnty
      533         shar_ord-line.cli-qnty   = scr-qnty
      534         shar_ord-line.cli-base-rate   = 1
      535         shar_ord-line.price-rubl = scr-price-rubl
      536         shar_ord-line.price-base = scr-price-base
      537         shar_ord-line.price-cli  = shar_ord-line.price-rubl
      538         shar_ord-line.sum-rubl = shar_ord-line.price-rubl * shar_ord-line.qnty
      539         shar_ord-line.sum-base = shar_ord-line.price-base * shar_ord-line.qnty
      540         shar_ord-line.sum-cli  = shar_ord-line.price-cli  * shar_ord-line.qnty
      541       .
      542   END.
      543   ON LEAVE OF scr-price-base IN FRAME Dialog-Frame
      544   DO:
      545   if scr-price-base:modified = false then return .
      546    assign  frame Dialog-Frame scr-price-base .
      547       scr-price-rubl = scr-price-base * ( p-exch-rate  / p-exch-scale )     .
      548       scr-sum-rubl =  scr-price-rubl * scr-qnty .
      549       scr-sum-base =  scr-price-base  * scr-qnty .
      550       display scr-price-rubl  scr-sum-base scr-sum-rubl with frame Dialog-Frame .
      551   END.
      552   ON return OF scr-price-base IN FRAME Dialog-Frame
      553   DO:
      554       run next-focus in this-procedure  (input  scr-price-base:handle ) .
      555     return no-apply .
      556   END.
      557   ON LEAVE OF scr-price-rubl IN FRAME Dialog-Frame
      558   DO:
      559      if scr-price-rubl:modified = false then return .
      560       assign  frame Dialog-Frame  scr-price-rubl.
      561       scr-price-base = scr-price-rubl / ( p-exch-rate  * p-exch-scale )     .
      562       scr-sum-rubl =  scr-price-rubl * scr-qnty .
      563       scr-sum-base =  scr-price-base  * scr-qnty .
      564       display scr-price-base  scr-sum-base scr-sum-rubl with frame Dialog-Frame .
      565   END.
      566   ON return OF scr-price-rubl IN FRAME Dialog-Frame
      567   DO:
      568       run next-focus in this-procedure  (input  scr-price-rubl:handle ) .
      569     return no-apply .
      570   END.
      571   ON LEAVE OF scr-qnty IN FRAME Dialog-Frame
      572   DO:
      573     assign frame Dialog-Frame scr-qnty .
      574    IF CAN-FIND ( FIRST ub.units WHERE ub.units.unit-name = scr-unit-base
      575                       and LOOKUP('шту':U, ub.units.type) > 0   AND
      576                          TRUNC(scr-qnty, 0)   <>    scr-qnty         )
      577      THEN DO:
      578         MESSAGE "Базовая единица товара " scr-unit-base " - штучная." skip
      579                 "Кол-во  должно быть целым."
      580         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      581         RETURN no-apply.
      582     END.
      583       scr-sum-rubl =  scr-price-rubl * scr-qnty .
      584       scr-sum-base =  scr-price-base * scr-qnty .
      585       scr-cli-qnty =  scr-qnty / v-cli-base-rate .
      586    IF CAN-FIND ( FIRST ub.units WHERE ub.units.unit-name = scr-unit-cli
      587                       and LOOKUP('шту':U, ub.units.type) > 0   AND
      588                          TRUNC(scr-cli-qnty, 0)   <>    scr-cli-qnty         )
      589      THEN DO:
      590         MESSAGE
      591                 "Единица товара поставщика" scr-unit-cli " - штучная." skip
      592                 "Получается не полная единица измерения поставщика !!!."
      593         view-as alert-box information
      594         title "внимание".
      595     END.
      596       display  scr-cli-qnty  scr-sum-base scr-sum-rubl with frame Dialog-Frame .
      597   END.
      598   ON return OF scr-qnty IN FRAME Dialog-Frame
      599   DO:
      600       run next-focus in this-procedure  (input  scr-qnty:handle ) .
      601     return no-apply .
      602   END.
      603   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      604   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      605   assign
      606     scr-price-rubl :label = "Цена (руб)"
      607     scr-sum-rubl   :label = "Сумма в руб"
      608   .
      609   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   on help of frame Dialog-Frame
      611   do:
      612     run gbl/app_help.p
      613       (input this-procedure :file-name
      614       ,input ''
      615       ,input ?
      616       ) no-error.
      617     if error-status :error then do:
      618       message
      619         "Ошибка при вызове помощи"
      620         error-status :get-message(1)
      621         view-as alert-box .
      622     end.
      623   end.
      624   run minbtn-set in this-procedure .
      625   on choose of b-help in frame Dialog-Frame
      626   do:
      627     apply "help":u to frame Dialog-Frame .
      628   end.
      629   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   procedure minbtn-set :
      631       do
      632           on error undo, return error return-value
      633           :
      634           define variable ii              as integer       no-undo .
      635           define variable fh              as widget-handle no-undo .
      636           define variable hh              as widget-handle no-undo .
      637           define variable v-h             as handle        extent 4 no-undo .
      638           define variable v-name-button   as character     no-undo .
      639           define variable v-help-old-x    as decimal       no-undo .
      640           define variable v-help-old-y    as decimal       no-undo .
      641           define variable v-help-old-size as decimal       no-undo .
      642           define variable v-frame-width   as decimal       no-undo .
      643           define variable jj              as integer       no-undo .
      644           do
      645               on error undo, return error
      646               :
      647               assign
      648                   v-frame-width = frame Dialog-Frame:width - 0.3
      649                   fh            = frame Dialog-Frame:first-child
      650                   hh            = fh:first-child
      651                   ii            = 1
      652                   .
      653               do while valid-handle(hh):
      654                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      655                   do:
      656                       case lc(hh:name) :
      657                           when "b-help" then
      658                               do:
      659                                   hh:load-image-up("cmp/b-help.bmp":u) .
      660                                   hh:load-image-down("cmp/b-help.bmp":u) .
      661                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      662                                   hh:TOOLTIP = "Помощь" .
      663                                   v-help-old-x = hh:column .
      664                                   v-help-old-y = hh:row    .
      665                                   v-help-old-size = hh:width .
      666                                   hh:width-chars = 2.5 .
      667                               end.
      668                           when "b-print" then
      669                               do:
      670                                   hh:load-image("cmp/b-print.bmp":u) .
      671                                   hh:TOOLTIP = "Печать" .
      672                                   v-h[ii] = hh:handle .
      673                                   ii = ii + 1 .
      674                                   hh:width-chars = 3 .
      675                               end.
      676                           when "b-history" or
      677                           when "b-hist" then
      678                               do:
      679                                   hh:load-image("cmp/b-hist.bmp":u) .
      680                                   hh:TOOLTIP = "История" .
      681                                   v-h[ii] = hh:handle .
      682                                   ii = ii + 1 .
      683                                   hh:width-chars = 3 .
      684                               end.
      685                           when "b-sch" then
      686                               do:
      687                                   hh:load-image("cmp/b-sch.bmp":u) .
      688                                   hh:TOOLTIP = "Установка Фильтра" .
      689                                   v-h[ii] = hh:handle .
      690                                   ii = ii + 1 .
      691                                   hh:width-chars = 3 .
      692                               end.
      693                           when "b-hist-user" then
      694                               do:
      695                                   hh:load-image("cmp/b-hist.bmp":u) .
      696                                   hh:TOOLTIP = "История пользователя" .
      697                                   ii = ii + 1 .
      698                               end.
      699                       end case.
      700                   end.
      701                   hh = hh:next-sibling.
      702               end.
      703               b-help:column = v-frame-width - b-help:width-chars.
      704               jj = 0.
      705               repeat ii = 4 to 1 by -1 :
      706                   if valid-handle (v-h[ii] ) then
      707                   do:
      708                       jj  = jj + 1 .
      709                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      710                       v-h[ii]:row    = v-help-old-y .
      711                   end.
      712               end.
      713           end.
      714       end.
      715   end procedure.
      716   MAIN-BLOCK:
      717   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      718      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      719   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      721     (input  g#host-code
      722     ,output p-curr-code
      723     )  .
      724   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      726     (input  p-curr-code
      727     ,input  p-curr-date
      728     ,output p-exch-rate
      729     ,output p-exch-scale
      730     ,output p-curr-abbr
      731     )  .
      732       run init-proc.
      733       if p-line-mode = 'ПРОСМОТР':U then run lkp-enable.
      734                                  else RUN my-enable.
      735   END.
      736   RUN disable_UI.
      737   PROCEDURE disable_UI :
      738     HIDE FRAME Dialog-Frame.
      739   END PROCEDURE.
      740   PROCEDURE enable_UI :
      741     OPEN QUERY Dialog-Frame FOR EACH ub.ord-line SHARE-LOCK.
      742     GET FIRST Dialog-Frame.
      743     DISPLAY scr-qnty scr-price-rubl scr-price-base scr-artic scr-gds-name
      744             scr-prod-code scr-prod-type scr-prod-name scr-unit-base
      745             v-cli-base-rate scr-val scr-unit-cli scr-cli-qnty scr-sum-rubl
      746             scr-sum-base
      747         WITH FRAME Dialog-Frame.
      748     ENABLE b-save b-quit b-exit-cycl B-help scr-qnty scr-price-rubl
      749            scr-price-base scr-artic scr-gds-name scr-prod-code scr-prod-type
      750            scr-prod-name scr-unit-base scr-val scr-unit-cli scr-cli-qnty
      751            scr-sum-rubl scr-sum-base
      752         WITH FRAME Dialog-Frame.
      753     VIEW FRAME Dialog-Frame.
      754   END PROCEDURE.
      755   PROCEDURE init-proc :
      756    do
      757    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      758    :
      759     define buffer buf_goods for ub.goods.
      760     define buffer buf_clients for ub.clients.
      761     if p-line-mode = 'ПРОСМОТР':U then
      762        find first shar_ord-line no-lock where recid(shar_ord-line) = par-ord no-error .
      763     else
      764        find first shar_ord-line  exclusive-lock  where recid(shar_ord-line) = par-ord no-error .
      765             if error-status :error then do:
      766             message vss-workfile vss-revision vss-description skip
      767                   "Ошибка  " skip
      768                     "p-line-mode" p-line-mode    skip
      769                     error-status :get-message(1) skip
      770                     return-value skip
      771                     view-as alert-box error
      772             .
      773             return error .
      774             end.
      775      ASSIGN frame Dialog-Frame:TITLE = "Строка заказа  № " + shar_ord-line.doc-code  + " - " + caps(p-line-mode).
      776     find first buf_goods no-lock  WHERE
      777               buf_goods.artic     = shar_ord-line.artic      and
      778               buf_goods.prod-code = shar_ord-line.prod-code  and
      779               buf_goods.prod-type = shar_ord-line.prod-type no-error .
      780             if error-status :error then do:
      781                return error .
      782             end.
      783     find first buf_clients no-lock  WHERE
      784               buf_clients.obj-code = shar_ord-line.prod-code  and
      785               buf_clients.obj-type = shar_ord-line.prod-type no-error .
      786             if error-status :error then do:
      787                return error .
      788             end.
      789          assign
      790             scr-qnty       = shar_ord-line.qnty
      791             scr-price-rubl = shar_ord-line.price-rubl
      792             scr-price-base = shar_ord-line.price-base
      793             scr-artic      = shar_ord-line.artic
      794             scr-gds-name   = buf_goods.gds-name
      795             scr-prod-code  = shar_ord-line.prod-code
      796             scr-prod-type  = shar_ord-line.prod-type
      797             scr-prod-name  = buf_clients.obj-name
      798             scr-unit-base  = buf_goods.unit-base
      799             scr-val        = p-curr-abbr
      800             scr-cli-qnty   = scr-qnty / buf_goods.cli-base-rate
      801             scr-unit-cli   = shar_ord-line.unit-cli
      802             scr-sum-rubl   = scr-qnty  *  scr-price-rubl
      803             scr-sum-base   = scr-qnty  *  scr-price-base
      804             v-cli-base-rate = buf_goods.cli-base-rate
      805          .
      806     end.
      807   END PROCEDURE.
      808   PROCEDURE lkp-enable :
      809    do
      810    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      811    :
      812     DISPLAY scr-qnty scr-price-rubl scr-price-base scr-artic scr-gds-name
      813             scr-prod-code scr-prod-type scr-prod-name scr-unit-base scr-val
      814             scr-cli-qnty scr-unit-cli scr-sum-rubl scr-sum-base v-cli-base-rate
      815         WITH FRAME Dialog-Frame.
      816     ENABLE b-quit
      817            B-help
      818         WITH FRAME Dialog-Frame.
      819     VIEW FRAME Dialog-Frame.
      820     WAIT-FOR GO OF FRAME Dialog-Frame .
      821     end.
      822   END PROCEDURE.
      823   PROCEDURE my-enable :
      824    do
      825    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      826    :
      827   define variable p-r-b-abbr as character no-undo .
      828   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      829   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      830     (output p-r-b-abbr
      831     )  .
      832     DISPLAY scr-qnty scr-price-rubl scr-price-base scr-artic scr-gds-name
      833             scr-prod-code scr-prod-type scr-prod-name scr-unit-base scr-val
      834             scr-cli-qnty scr-unit-cli scr-sum-rubl scr-sum-base v-cli-base-rate
      835         WITH FRAME Dialog-Frame.
      836     ENABLE b-save
      837            b-quit
      838            b-exit-cycl   when p-line-mode = "ЦИКЛ":u
      839            B-help
      840            scr-qnty
      841            scr-price-rubl when p-r-b-abbr = 'rubl':U
      842            scr-price-base when p-r-b-abbr <> 'rubl':U
      843         WITH FRAME Dialog-Frame.
      844     VIEW FRAME Dialog-Frame.
      845     if p-line-mode <> "ЦИКЛ":u  then hide b-exit-cycl in frame Dialog-Frame .
      846     WAIT-FOR GO OF FRAME Dialog-Frame focus scr-qnty .
      847     end.
      848   END PROCEDURE.
      849   PROCEDURE next-focus :
      850    do
      851    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      852    :
      853   define input parameter p-widget-handle as handle no-undo .
      854   define variable l-apply-entry as logical no-undo .
      855   assign
      856     l-apply-entry =   true
      857   .
      858   do with frame Dialog-Frame :
      859     if  scr-qnty       :handle = p-widget-handle then do:  if scr-price-rubl     :sensitive then do:       apply "entry":u to scr-price-rubl   .        return . end.
      860                                                            if scr-price-base     :sensitive then do:       apply "entry":u to scr-price-base   .        return . end.
      861                                                       end.
      862     if  scr-price-rubl :handle = p-widget-handle then do:  if B-save    :sensitive then do:       apply "entry":u to B-save    .        return . end. end.
      863     if  scr-price-base :handle = p-widget-handle then do:  if B-save    :sensitive then do:       apply "entry":u to B-save    .        return . end. end.
      864     end.
      865     end.
      866   END PROCEDURE.
