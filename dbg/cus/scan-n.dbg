        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-doc-code   like ub.ord-doc.doc-code no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: scan-n.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/scan-n.p $":U .
        9   define variable vss-description as character no-undo init "Единая процедура работы с мобильным сканером".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   procedure last-price :
      301   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      302   define input parameter  p-host-code     as integer no-undo .
      303   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
      304   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
      305   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
      306   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
      307   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
      308   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
      309   define input parameter  p-curr-code  as integer   no-undo .
      310   define output parameter p-price-base like ub.doc-line.price-base no-undo .
      311   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
      312   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
      313   define buffer buf-lib-doc-line for ub.doc-line.
      314   define buffer buf_cli-gds for ub.cli-gds .
      315   define buffer buf_trn-doc for ub.trn-doc  .
      316   define variable vp-curr-code  like ub.trn-doc.exch-code.
      317   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
      318   define variable vp-exch-scale like ub.trn-doc.exch-scale.
      319   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
      320   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
      321   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
      322   define variable v-cli-base-rate as decimal   no-undo .
      323    find first buf_cli-gds no-lock where
      324               buf_cli-gds.cli-type   = p-cli-type    and
      325               buf_cli-gds.cli-code   = p-cli-code    and
      326               buf_cli-gds.host-code  = p-host-code   and
      327               buf_cli-gds.artic      = p-artic       and
      328               buf_cli-gds.prod-type  = p-prod-type   and
      329               buf_cli-gds.prod-code  = p-prod-code
      330               no-error .
      331   if available buf_cli-gds then do:
      332       find first buf_trn-doc no-lock
      333            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
      334        if available buf_trn-doc then do:
      335           vp-curr-code  = buf_trn-doc.exch-code.
      336           vp-exch-rate  = buf_trn-doc.exch-rate.
      337           vp-exch-scale = buf_trn-doc.exch-scale.
      338        end.
      339       find first buf-lib-doc-line no-lock
      340         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
      341           and buf-lib-doc-line.artic     = p-artic
      342           and buf-lib-doc-line.prod-type = p-prod-type
      343           and buf-lib-doc-line.prod-code = p-prod-code
      344         no-error .
      345   end.
      346   else do:
      347   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      349     (input  p-host-code
      350     ,input  p-artic
      351     ,input  p-prod-type
      352     ,input  p-prod-code
      353     ,output v-last-in-code
      354     ,output v-last-obj-type
      355     ,output v-last-obj-code
      356     )  .
      357       find first buf_trn-doc no-lock
      358            where buf_trn-doc.doc-code  = v-last-in-code no-error .
      359        if available buf_trn-doc then do:
      360           vp-curr-code  = buf_trn-doc.exch-code.
      361           vp-exch-rate  = buf_trn-doc.exch-rate.
      362           vp-exch-scale = buf_trn-doc.exch-scale.
      363        end.
      364       find first buf-lib-doc-line no-lock
      365         where buf-lib-doc-line.doc-code  = v-last-in-code
      366           and buf-lib-doc-line.artic     = p-artic
      367           and buf-lib-doc-line.prod-type = p-prod-type
      368           and buf-lib-doc-line.prod-code = p-prod-code
      369         no-error .
      370   end.
      371       if available buf-lib-doc-line then do:
      372         assign
      373           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
      374           p-price-base = buf-lib-doc-line.price-base
      375           p-price-rubl = buf-lib-doc-line.price-rubl
      376           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
      377         .
      378         if v-cli-base-rate <> p-cli-base-rate
      379         then do:
      380             p-price-cli  = p-price-cli / v-cli-base-rate  .
      381         end.
      382          if p-curr-code <> vp-curr-code then do:
      383             p-price-cli  = p-price-rubl  .
      384         end.
      385       end.
      386       Else do:
      387         assign
      388           p-price-base = 0
      389           p-price-rubl = 0
      390           p-price-cli  = 0
      391         .
      392       end.
      393     end.
      394   end procedure.
      395   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   procedure create-ord-line :
      397   define input parameter  p-doc-code       like ub.ord-doc.doc-code         no-undo .
      398   define input parameter  p-line-num       like ub.ord-line.line-num        no-undo .
      399   define input parameter  p-artic          like ub.ord-line.artic           no-undo .
      400   define input parameter  p-prod-code      like ub.ord-line.prod-code       no-undo .
      401   define input parameter  p-prod-type      like ub.ord-line.prod-type       no-undo .
      402   define input parameter  p-cli-base-rate  like ub.ord-line.cli-base-rate   no-undo .
      403   define input parameter  p-qnty           like ub.ord-line.qnty            no-undo .
      404   define input parameter  p-unit-cli       like ub.ord-line.unit-cli        no-undo .
      405    do
      406    on error undo, return error return-value
      407    :
      408    define variable p-cli-qnty               like ub.ord-line.cli-qnty        no-undo .
      409    define buffer bbb_ord-doc for ub.ord-doc  .
      410    define buffer tt-goods for ub.goods       .
      411    find first bbb_ord-doc where bbb_ord-doc.doc-code = p-doc-code no-lock no-error .
      412    if error-status :error then do:
      413         message vss-workfile vss-revision vss-description skip
      414                 error-status :get-message(1)
      415                 view-as alert-box error .
      416                 undo, return error.
      417    end.
      418    find first tt-goods where
      419         tt-goods.artic             =   p-artic          and
      420         tt-goods.prod-code         =   p-prod-code      and
      421         tt-goods.prod-type         =   p-prod-type      no-lock no-error .
      422    if error-status :error then do:
      423         message vss-workfile vss-revision vss-description skip
      424                 error-status :get-message(1)
      425                 view-as alert-box error .
      426                 undo, return error.
      427    end.
      428   find first ub.ord-line where ub.ord-line.artic     = tt-goods.artic     and
      429                             ub.ord-line.prod-type = tt-goods.prod-type and
      430                             ub.ord-line.prod-code = tt-goods.prod-code and
      431                             ub.ord-line.doc-code  = p-doc-code   exclusive-lock    no-error.
      432   if not available ub.ord-line then do:
      433     create  ub.ord-line.
      434   end.
      435         assign
      436           ub.ord-line.gds-code       = tt-goods.gds-code
      437           ub.ord-line.doc-code       = p-doc-code
      438           ub.ord-line.line-num       = p-line-num
      439           ub.ord-line.artic          = p-artic
      440           ub.ord-line.prod-code      = p-prod-code
      441           ub.ord-line.prod-type      = p-prod-type
      442           ub.ord-line.cli-base-rate  = p-cli-base-rate
      443           ub.ord-line.qnty           = p-qnty
      444           ub.ord-line.cli-qnty       = ub.ord-line.qnty  / ub.ord-line.cli-base-rate
      445           ub.ord-line.unit-cli       = p-unit-cli
      446       .
      447    if ub.ord-line.price-rubl = 0 or ub.ord-line.price-rubl = ? then
      448    run last-price in this-procedure (
      449         input  bbb_ord-doc.host-code ,
      450         input  ub.ord-line.artic ,
      451         input  ub.ord-line.prod-type ,
      452         input  ub.ord-line.prod-code ,
      453         input  bbb_ord-doc.cli-code  ,
      454         input  bbb_ord-doc.cli-type  ,
      455         input  ub.ord-line.cli-base-rate ,
      456         input  bbb_ord-doc.exch-code ,
      457         output ub.ord-line.price-base ,
      458         output ub.ord-line.price-rubl ,
      459         output ub.ord-line.price-cli   )
      460         no-error  .
      461         if error-status :error then
      462         message
      463           vss-workfile vss-revision vss-description skip
      464           error-status :get-message(1) skip
      465           return-value skip
      466           ""
      467           view-as alert-box error
      468         .
      469   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      471     (input  tt-goods.gds-code
      472     ,input  '1':U
      473     ,input  ?
      474     ,input  bbb_ord-doc.host-code
      475     ,input  bbb_ord-doc.obj-type
      476     ,input  bbb_ord-doc.obj-code
      477     ,output ub.ord-line.vat-pc
      478     ) no-error .
      479     if error-status :error then
      480     message
      481       vss-workfile vss-revision vss-description skip
      482       error-status :get-message(1) skip
      483       return-value skip
      484       ""
      485       view-as alert-box error
      486     .
      487        ub.ord-line.sum-rubl = ub.ord-line.qnty * ub.ord-line.price-rubl .
      488        ub.ord-line.sum-base = ub.ord-line.qnty * ub.ord-line.price-base .
      489        ub.ord-line.sum-cli  = ub.ord-line.cli-qnty * ub.ord-line.price-cli .
      490    end.
      491   end procedure.
      492   define variable add-sens as logical init true  no-undo.
      493   define variable bar-str as char no-undo.
      494   define variable pl-str as char no-undo.
      495   define variable qnty-str as char no-undo.
      496   define variable part-list as char no-undo init "".
      497   define variable b-c as int no-undo.
      498   define variable rate as dec no-undo.
      499   define variable conf-par as char no-undo.
      500   define variable par-type as char no-undo.
      501   define variable varplace as logical no-undo.
      502   define variable is-err as log initial no no-undo.
      503   define variable v-cli-base-rate like ub.goods.cli-base-rate no-undo.
      504   define variable v-unit-cli like ub.goods.unit-cli no-undo.
      505   define buffer sb-cli-gds  for ub.cli-gds   .
      506   define buffer buf_doc-line for ub.doc-line  .
      507   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   DEFINE TEMP-TABLE in-bc NO-UNDO
      509        FIELD nm        as INTEGER
      510        FIELD bar-str   AS CHARACTER
      511        FIELD bar-code  as CHARACTER
      512        FIELD rez       as CHARACTER
      513        FIELD err-msg   as CHARACTER
      514        FIELD des       as CHARACTER
      515        INDEX pi IS PRIMARY nm.
      516   DEFINE new SHARED TEMP-TABLE un-bc NO-UNDO
      517        FIELD nm             as INTEGER
      518        FIELD bar-code       as CHARACTER
      519        FIELD entity         as character
      520        FIELD b-c            as INTEGER
      521        FIELD rate           as DECIMAL
      522        FIELD TYPE-bc        as CHARACTER
      523        FIELD wt             as DECIMAL
      524        FIELD file-qnty      as decimal
      525        FIELD scn-qnty       as DECIMAL
      526        FIELD scn-pl         as CHARACTER
      527        FIELD artic          LIKE ub.goods.artic
      528        FIELD prod-type      LIKE ub.goods.prod-type
      529        FIELD prod-code      LIKE ub.goods.prod-code
      530        FIELD gds-name       LIKE ub.goods.gds-name
      531        FIELD prod-name      LIKE ub.clients.obj-name
      532        FIELD unit-base      LIKE ub.goods.unit-base
      533        FIELD units-type     LIKE ub.units.type
      534        FIELD f-name         LIKE ub.gds-prt.f-name
      535        FIELD in-code        LIKE ub.parts.in-code
      536        FIELD fact-date      LIKE ub.parts.fact-date
      537        FIELD part-code      LIKE ub.parts.part-code
      538        FIELD rez            as CHARACTER
      539        FIELD err-msg        as CHARACTER
      540        FIELD des            as CHARACTER
      541        FIELD pl-name        AS CHARACTER
      542        FIELD loc1           AS CHARACTER
      543        FIELD loc2           AS CHARACTER
      544        FIELD loc3           AS CHARACTER
      545        FIELD loc4           AS CHARACTER
      546        FIELD unit-name      LIKE ub.units.unit-name
      547        FIELD long-name      LIKE ub.units.long-name
      548        FIELD b-c-base       LIKE ub.bar-code.b-code
      549        FIELD unit-name-base LIKE ub.units.unit-name
      550        FIELD long-name-base LIKE ub.units.long-name
      551        INDEX pi IS PRIMARY  nm
      552        INDEX bar-code bar-code
      553        INDEX b-c b-c
      554        INDEX file-qnty file-qnty.
      555   DEFINE new SHARED TEMP-TABLE anlz-bc NO-UNDO
      556        FIELD nm       as INTEGER
      557        FIELD b-c      as integer
      558        FIELD scn-qnty as DECIMAL
      559        FIELD scn-pl   as CHARACTER
      560        FIELD rez      as CHARACTER
      561        FIELD err-msg  as CHARACTER
      562        FIELD des      as CHARACTER
      563        FIELD upd-line as logical initial no
      564        INDEX pi IS PRIMARY nm
      565        INDEX b-c b-c.
      566   DEFINE new SHARED TEMP-TABLE main-bc NO-UNDO
      567        FIELD nm       as INTEGER
      568        FIELD b-c      as integer
      569        FIELD scn-qnty as DECIMAL
      570        FIELD scn-pl   as CHARACTER
      571        FIELD rez      as CHARACTER
      572        FIELD des      as CHARACTER
      573        INDEX pi IS PRIMARY nm
      574        INDEX b-c b-c.
      575   def stream cur.
      576   def stream log.
      577   def stream err.
      578   define variable scan-txt as char no-undo.
      579   define variable scan-name as char no-undo.
      580   define variable g-type as char no-undo init ?.
      581   def  buffer buf_ord-doc  for ub.ord-doc.
      582   def  buffer buf_ord-line for ub.ord-line.
      583   define variable is-all as log no-undo.
      584   define variable i as int no-undo.
      585   define variable j as int no-undo.
      586   define variable varerr as logical no-undo.
      587   define variable mess as char no-undo.
      588   define variable glog as logical no-undo .
      589   def frame a
      590       i format ">>>>9"  label "Просмотрено" space (20) skip
      591       j format ">>>>9" label "Обработано"
      592       with view-as dialog-box side-labels three-d title "".
      593   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   define variable varscales-pref as character no-undo .
      595   define variable varpgscales-pref as character no-undo .
      596   define variable varscales-pref-type6 as character no-undo.
      597   varscales-pref  = ?.
      598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      599     (input  'sclspref':u
      600     ,input  '':u
      601     ,input  '':u
      602     ,input  0
      603     ,input  '':u
      604     ,input  '':u
      605     ,input  '':u
      606     ,input  no
      607     ,output varscales-pref
      608     ,output varscales-pref-type6
      609     ) no-error .
      610   if varscales-pref = ? then do:
      611     assign
      612     varscales-pref = '21,23,25':U.
      613   end.
      614   define variable varpgscales-pref-type6 as character no-undo.
      615   varpgscales-pref  = ?.
      616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      617     (input  'scpgpref':u
      618     ,input  '':u
      619     ,input  '':u
      620     ,input  0
      621     ,input  '':u
      622     ,input  '':u
      623     ,input  '':u
      624     ,input  no
      625     ,output varpgscales-pref
      626     ,output varpgscales-pref-type6
      627     ) no-error .
      628   if varpgscales-pref = ? then do:
      629     assign
      630     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
      631   end.
      632   system-dialog get-file scan-txt
      633     title "Выберите файл со сканера"
      634          filters "workabout ms15" "*.dbs",
      635                    "workabout" "*.imp",
      636                    "Инвентаризация с кассы" "*.inv",
      637                    "Все файлы" "*.*"
      638          update glog.
      639   if not glog then return.
      640   if entry (2, scan-txt, ".") = "err" then do:
      641     message "Файл с расширением '.err' не может быть обработан. Переименуйте его.".
      642     return.
      643   end.
      644   message "yes - переписать количество со сканера для всех товаров" skip
      645           "no - прибавить количество со сканера для всех товаров"   skip
      646           "cancel - спрашивать для каждого товара"
      647           view-as alert-box question buttons yes-no-cancel update is-all.
      648   scan-name = entry (1, scan-txt, ".").
      649   frame a:title = "Разбор файла : " + scan-txt.
      650   output stream log to value (scan-name + ".log") append.
      651   output stream err to value (scan-name + ".err") append.
      652   put stream log unformatted "  " skip.
      653   put stream log unformatted cur-time-string-sec() skip.
      654   find first buf_ord-doc where buf_ord-doc.doc-code = p-doc-code no-lock no-error.
      655        if error-status :error then return error.
      656     put stream log unformatted " " skip skip
      657           "Документ "     buf_ord-doc.doc-code
      658           " Тип: "        buf_ord-doc.doc-type
      659           " Статус: "     buf_ord-doc.status_
      660           " ОК: " string (buf_ord-doc.flag_, "+/-")
      661                   skip skip.
      662       g-type =  'т':U .
      663   view frame a.
      664   input stream cur from value (scan-txt).
      665     input stream cur from value (scan-txt).
      666     run str/bc-anlz.p
      667        (input parparentproc,
      668         input "file",
      669         input scan-txt,
      670         input yes,
      671         output varerr,
      672         output table in-bc
      673         ) no-error.
      674     if error-status:error then do:
      675        message "Ошибка при обработке файла сканера." skip
      676                error-status:get-message(1)
      677           view-as alert-box error buttons ok.
      678        return error.
      679     end.
      680     if varerr = yes then is-err = yes.
      681     for each in-bc:
      682         if in-bc.rez = "err" then do:
      683            put stream log unformatted in-bc.err-msg skip.
      684            put stream err unformatted in-bc.bar-str skip.
      685            assign is-err = yes.
      686         end.
      687         if in-bc.des <> "" and in-bc.des <> ? then put stream log unformatted in-bc.des.
      688     end.
      689     for each un-bc:
      690         if un-bc.rez = "err" then do:
      691            put stream log unformatted un-bc.err-msg skip.
      692            put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
      693            assign is-err = yes.
      694         end.
      695     end.
      696     i = 0 .
      697     j = 0 .
      698     for each main-bc:
      699       i = i + 1.
      700       disp i with frame a.
      701       find ub.bar-code where ub.bar-code.b-code = main-bc.b-c no-lock.
      702       find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code no-lock.
      703         assign bar-str  = string(main-bc.b-c)
      704                qnty-str = string(main-bc.scn-qnty)
      705                rate     = 1
      706                pl-str   = main-bc.scn-pl
      707                mess     = main-bc.des.
      708         run proc-code in this-procedure ( input main-bc.nm
      709                                          ,input ""
      710                                          ,input varscales-pref
      711                                          ,input varpgscales-pref
      712                                          ) no-error.
      713         if error-status:error then do:
      714            assign is-err = yes.
      715         end.
      716     end.
      717   message "Просмотрено :" i skip "Обработано :" j.
      718   if is-err then
      719       message "Во время загрузки файла:" scan-txt "обнаружены ошибки." skip
      720               "Смотрите log файл."
      721       view-as alert-box error buttons ok.
      722   procedure proc-code :
      723   define input parameter n-pp   as integer no-undo .
      724   DEFine INPUT PARAMeter mode-proc as CHAR NO-UNDO.
      725   define input parameter parscales-pref as character no-undo.
      726   define input parameter parpgscales-pref as character no-undo .
      727   define variable  pl-str as char no-undo.
      728   define buffer b-bar-code for ub.bar-code.
      729   define buffer pc-goods   for ub.goods.
      730   DEFINE VARIABLE mode-create      as LOGICAL NO-UNDO.
      731   DEFINE VARIABLE rec-old          as RECID NO-UNDO.
      732   define variable varres           as logical         no-undo.
      733   define variable var-code-temp    like ub.place.pl-code no-undo.
      734   define variable g-log-char       as character no-undo.
      735   define variable varprice-cli-old        like ub.ord-line.price-cli no-undo.
      736   define variable varprice-rubl-old       like ub.ord-line.price-cli no-undo.
      737   define variable varprice-base-old       like ub.ord-line.price-cli no-undo.
      738   define variable varcli-qnty-old         like ub.ord-line.cli-qnty  no-undo.
      739   define variable varcli-base-rate-old    like ub.ord-line.cli-qnty  no-undo.
      740   define variable varfact-qnty-old        like ub.ord-line.cli-qnty  no-undo.
      741   define variable p-qnty                  like ub.ord-line.cli-qnty  no-undo.
      742   define variable vardoc-qnty-old         like ub.ord-line.cli-qnty  no-undo.
      743   define variable varvat-pc-old           like ub.ord-line.vat-pc    no-undo.
      744   define variable varslt-pc-old           like ub.ord-line.vat-pc    no-undo.
      745   define variable varroad-tax-old         like ub.ord-line.price-cli no-undo.
      746   define variable varexcise-old           like ub.ord-line.price-cli no-undo.
      747   define variable vartransport-rubl-old   like ub.ord-line.price-cli no-undo.
      748   define variable varother-rubl-old       like ub.ord-line.price-cli no-undo.
      749   define variable is-1 as logical no-undo .
      750   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751       assign g-log-char = "yes".
      752       do transaction on error undo , leave:
      753          define variable tempmess as character no-undo.
      754          find first buf_ord-line where buf_ord-line.artic = ub.goods.artic     and
      755                                    buf_ord-line.prod-type = ub.goods.prod-type and
      756                                    buf_ord-line.prod-code = ub.goods.prod-code and
      757                                    buf_ord-line.doc-code  = p-doc-code    no-error.
      758          if available buf_ord-line then do:
      759             assign
      760             mode-create = no
      761             varprice-cli-old       = buf_ord-line.price-cli
      762             varprice-rubl-old      = buf_ord-line.price-rubl
      763             varprice-base-old      = buf_ord-line.price-base
      764             varcli-qnty-old        = buf_ord-line.cli-qnty
      765             varcli-base-rate-old   = buf_ord-line.cli-base-rate
      766             varfact-qnty-old       = buf_ord-line.qnty
      767             varvat-pc-old          = buf_ord-line.vat-pc
      768             varslt-pc-old          = buf_ord-line.slt-pc
      769             varroad-tax-old        = buf_ord-line.road-tax
      770             varexcise-old          = buf_ord-line.excise
      771             vartransport-rubl-old  = buf_ord-line.transport-rubl
      772             varother-rubl-old      = buf_ord-line.other-rubl.
      773          end.
      774          else mode-create = yes.
      775     if is-all = true then p-qnty =  decimal(qnty-str) .
      776     if is-all = false then p-qnty =   decimal(qnty-str)  + varfact-qnty-old .
      777     if is-all = ? then do:
      778         message "ТОВАР "
      779                 ub.goods.artic
      780                 ub.goods.prod-type
      781                 ub.goods.prod-code  skip
      782                 ub.goods.gds-name   skip  " "
      783                 skip
      784                 "YES - переписать количество со сканера товара = " decimal(qnty-str) skip
      785                 "NO - прибавить количество со сканера для товара = " decimal(qnty-str)  + varfact-qnty-old  skip
      786                 view-as alert-box question buttons yes-no update is-1.
      787             if is-1 = true then p-qnty =  decimal(qnty-str) .
      788             if is-1 = false then p-qnty =   decimal(qnty-str)  + varfact-qnty-old .
      789     end.
      790           find  first sb-cli-gds  where
      791                 sb-cli-gds.cli-type  = buf_ord-doc.cli-type and
      792                 sb-cli-gds.cli-code  = buf_ord-doc.cli-code and
      793                 sb-cli-gds.host-code = buf_ord-doc.host-code  and
      794                 sb-cli-gds.artic     = ub.goods.artic      and
      795                 sb-cli-gds.prod-type = ub.goods.prod-type  and
      796                 sb-cli-gds.prod-code = ub.goods.prod-code  no-lock no-error.
      797           find first buf_doc-line no-lock where
      798                      buf_doc-line.doc-code  = sb-cli-gds.in-code and
      799                      buf_doc-line.artic     = sb-cli-gds.artic and
      800                      buf_doc-line.prod-type = sb-cli-gds.prod-type and
      801                      buf_doc-line.prod-code = sb-cli-gds.prod-code
      802                      no-error .
      803           if available buf_doc-line  then do:
      804               assign
      805                 v-unit-cli        = buf_doc-line.unit-cli
      806                 v-cli-base-rate   = buf_doc-line.cli-base-rate
      807                 .
      808           end.
      809           else do:
      810             assign
      811               v-cli-base-rate = ub.goods.cli-base-rate
      812               v-unit-cli      = ub.goods.unit-cli
      813             .
      814           end.
      815      run create-ord-line (
      816           p-doc-code              ,
      817           n-pp                    ,
      818           ub.goods.artic             ,
      819           ub.goods.prod-code         ,
      820           ub.goods.prod-type         ,
      821           v-cli-base-rate         ,
      822           p-qnty                  ,
      823           v-unit-cli )
      824           .
      825          assign
      826          mess = mess + tempmess.
      827          if error-status:error then do:
      828            assign
      829            mess = mess + return-value.
      830            put stream err unformatted bar-str "," qnty-str skip.
      831            put stream log unformatted "***" mess " - ошибка" skip.
      832            return error.
      833          end.
      834          else do:
      835            put stream log unformatted mess " - успешно" skip.
      836            if pl-str <> "" then run store-place in this-procedure  ( input pl-str
      837                                                                     ,input parscales-pref
      838                                                                     ,input parpgscales-pref
      839                                                                     ).
      840            j = j + 1.
      841            disp j with frame a.
      842          end.
      843       if substring(g-log-char, 1, 4) = "qnty" then do:
      844             put stream err unformatted bar-str "," ENTRY(2, g-log-char, "=") skip.
      845             put stream log unformatted "***" mess " - не все количество зарезервировано" skip.
      846       end.
      847     end.
      848   end procedure.
      849   procedure store-place :
      850   DEFine INPUT PARAMETER pl-str as CHAR NO-UNDO.
      851   define input parameter parscales-pref as character no-undo.
      852   define input parameter parpgscales-pref as character no-undo .
      853   define variable varres        as logical         no-undo.
      854   define variable var-code-temp like ub.place.pl-code no-undo.
      855   define buffer pc-goods for ub.goods.
      856   define variable bc-frmt as character no-undo .
      857   define variable bc-pfx  as character no-undo .
      858   define variable pl-frmt as character no-undo .
      859   define variable pl-pfx  as character no-undo .
      860   define variable str-gen as character no-undo.
      861   define variable src-gen-int as integer no-undo.
      862   define variable rid_    as recid no-undo.
      863   release ub.prod-bc.
      864   release ub.bar-code.
      865   release ub.place.
      866   define variable v-ii as integer no-undo .
      867   do v-ii = 1 to num-entries(parpgscales-pref):
      868     entry(v-ii, parpgscales-pref) = substring(entry(v-ii, parpgscales-pref), 1, 2).
      869   end.
      870   if (lookup (substr (pl-str, 1, 2), parscales-pref) > 0
      871   or lookup (substr (pl-str, 1, 2), parpgscales-pref) > 0
      872   )
      873   and
      874      length (pl-str) = 13 then do:
      875     find first ub.prod-bc where
      876                ub.prod-bc.b-str = string (int (substr (pl-str, 3, 5)), "99999") and
      877                ub.prod-bc.bc-on = yes no-lock no-error.
      878   end.
      879   if not available ub.prod-bc then
      880     find first ub.prod-bc where
      881                ub.prod-bc.b-str = pl-str and
      882                ub.prod-bc.bc-on = yes no-lock no-error.
      883   if not available ub.prod-bc and
      884      length (pl-str) < 5 then
      885     find first ub.prod-bc where
      886                ub.prod-bc.b-str = string (int (pl-str), "99999") and
      887                ub.prod-bc.bc-on = yes no-lock no-error.
      888   if available ub.prod-bc then DO:
      889     rid_ = recid (prod-bc).
      890   end.
      891   else
      892     rid_ = ?.
      893   if (rid_ <> ?          and
      894       ub.prod-bc.b-str = pl-str) or rid_ = ? then do:
      895     find first ub.prod-bc where
      896                ub.prod-bc.b-str = pl-str and
      897                recid (ub.prod-bc) <> rid_ no-lock no-error.
      898     if available ub.prod-bc then do:
      899       if rid_ = ? then do:
      900          rid_ = recid (prod-bc).
      901       end.
      902       run ref/bc-rcnz.w (input parparentproc,
      903                      input buf_ord-doc.obj-type,
      904                      input buf_ord-doc.obj-code,
      905                      input pl-str,
      906                      input  0,
      907                      input "choose",
      908                      input-output rid_).
      909     end.
      910     find ub.prod-bc where
      911          recid (ub.prod-bc) = rid_ no-lock no-error.
      912   end.
      913   if available ub.prod-bc then do:
      914     find ub.bar-code where
      915          ub.bar-code.b-code = ub.prod-bc.b-code no-lock.
      916   end.
      917   else do:
      918   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      919     (input  'bc-frmt'
      920     ,input  ''
      921     ,input  ''
      922     ,input  0
      923     ,input  ''
      924     ,input  ''
      925     ,input  ''
      926     ,input  yes
      927     ,output bc-frmt
      928     ,output par-type
      929     ) no-error .
      930   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      931     (input  'bc-pfx'
      932     ,input  ''
      933     ,input  ''
      934     ,input  0
      935     ,input  ''
      936     ,input  ''
      937     ,input  ''
      938     ,input  yes
      939     ,output bc-pfx
      940     ,output par-type
      941     ) no-error .
      942     if not error-status:error and
      943        par-type = "C":U and
      944        lookup (bc-frmt, "EAN8,EAN13") > 0 then do:
      945       if length (pl-str) = 13 and
      946          bc-frmt = "EAN13" or
      947          length (pl-str) = 8 and
      948          bc-frmt = "EAN8" then do:
      949         if par-type = "C":U     and
      950            length (bc-pfx) <= 3 then do:
      951           if substr (pl-str, 1, length (bc-pfx)) = bc-pfx then
      952             pl-str = substr (pl-str, length (bc-pfx) + 1, length (pl-str) - length (bc-pfx) - 1).
      953         end.
      954         else
      955           message "Ошибка параметра bc-pfx - нет префикса для собственных бар-кодов."
      956                   view-as alert-box error.
      957       end.
      958     end.
      959     else
      960       message "Ошибка параметра bc-frmt - нет формата для собственных бар-кодов."
      961               view-as alert-box error.
      962     if length (pl-str) < 10 or
      963        length (pl-str) = 10 and
      964        pl-str <= "2147483647" then do:
      965       find ub.bar-code where
      966            ub.bar-code.b-code = int (pl-str) no-lock no-error.
      967       if available ub.bar-code then do:
      968       end.
      969     end.
      970   end.
      971   if not available ub.bar-code then do:
      972   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      973     (input  'pl-frmt'
      974     ,input  ''
      975     ,input  ''
      976     ,input  0
      977     ,input  ''
      978     ,input  ''
      979     ,input  ''
      980     ,input  no
      981     ,output pl-frmt
      982     ,output par-type
      983     ) no-error .
      984     if not error-status:error and
      985        par-type = "C":U and
      986        lookup (pl-frmt, "EAN8,EAN13") > 0 then do:
      987       if length (pl-str) = 13 and
      988          pl-frmt = "EAN13" or
      989          length (pl-str) = 8 and
      990          pl-frmt = "EAN8" then do:
      991   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      992     (input  'pl-pfx'
      993     ,input  ''
      994     ,input  ''
      995     ,input  0
      996     ,input  ''
      997     ,input  ''
      998     ,input  ''
      999     ,input  no
     1000     ,output pl-pfx
     1001     ,output par-type
     1002     ) no-error .
     1003         if not error-status:error and
     1004            par-type = "C":U then do:
     1005           if substr (pl-str, 1, length (pl-pfx)) = pl-pfx then
     1006             pl-str = substr (pl-str, length (pl-pfx) + 1, length (pl-str) - length (pl-pfx) - 1).
     1007         end.
     1008       end.
     1009     end.
     1010     if length (pl-str) < 10 or
     1011        length (pl-str) = 10 and
     1012        pl-str <= "2147483647" then do:
     1013       find ub.place where
     1014            ub.place.obj-type = buf_ord-doc.obj-type and
     1015            ub.place.obj-code = buf_ord-doc.obj-code and
     1016            ub.place.pl-code = int (pl-str) no-lock no-error.
     1017     end.
     1018   end.
     1019   IF not available ub.bar-code and
     1020      not available ub.place    THEN DO:
     1021      assign src-gen-int = integer (pl-str) no-error.
     1022      if not error-status:error then do:
     1023     define variable tmp-str  as character no-undo.
     1024     define variable tmp-num  as character no-undo.
     1025     define variable i        as integer   no-undo.
     1026     define variable sum      as integer   no-undo.
     1027     define variable len-code as integer   no-undo.
     1028     define variable varcont  as logical   initial yes no-undo.
     1029     CASE bc-frmt :
     1030       WHEN "EAN13" THEN do:
     1031         assign
     1032           tmp-str = string( src-gen-int, "999999999999" )
     1033         .
     1034       end.
     1035       WHEN "EAN8" THEN do:
     1036         assign
     1037           tmp-str = string( src-gen-int, "9999999" )
     1038         .
     1039       end.
     1040       OTHERWISE DO:
     1041             assign str-gen     = ""
     1042                    varcont = no.
     1043       END.
     1044     END CASE.
     1045     if varcont = yes then do:
     1046       if integer( substring( tmp-str, 1, length( bc-pfx ) ) ) <> 0
     1047       then do:
     1048            assign str-gen     = ""
     1049                   varcont = no.
     1050       end.
     1051       else do:
     1052         assign
     1053           str-gen = bc-pfx + substring( tmp-str, length( bc-pfx ) + 1, length( tmp-str ) - length( bc-pfx ) )
     1054           len-code    = length( str-gen )
     1055         .
     1056         define variable v-sum-char as character no-undo .
     1057         assign
     1058           sum = 0
     1059         .
     1060         do i = 1 to len-code by 2
     1061         :
     1062           assign
     1063             v-sum-char = substr(str-gen, len-code - i + 1, 1)
     1064           .
     1065           if v-sum-char < "0"
     1066           or v-sum-char > "9"
     1067           then do:
     1068                assign str-gen     = ""
     1069                       varcont = no.
     1070           end.
     1071           assign
     1072             sum = sum + integer(v-sum-char)
     1073           .
     1074         end.
     1075         if varcont = yes then do:
     1076           assign
     1077             sum = sum * 3
     1078           .
     1079           do i = 2 to len-code by 2
     1080           :
     1081             assign
     1082               v-sum-char = substr(str-gen, len-code - i + 1, 1)
     1083             .
     1084             if v-sum-char < "0"
     1085             or v-sum-char > "9"
     1086             then do:
     1087                  assign str-gen     = ""
     1088                         varcont = no.
     1089             end.
     1090             assign
     1091               sum = sum + integer(v-sum-char)
     1092             .
     1093           end.
     1094           if varcont = yes then do:
     1095              if sum mod 10 = 0 then do:
     1096                assign
     1097                  str-gen = str-gen + '0'
     1098                .
     1099              end.
     1100              else do:
     1101                assign
     1102                  str-gen = str-gen + string(10 - sum mod 10)
     1103                .
     1104              end.
     1105           end.
     1106         end.
     1107       end.
     1108     end.
     1109         if str-gen <> ""          then do:
     1110            find first ub.prod-bc where
     1111                       ub.prod-bc.b-str = str-gen and
     1112                       ub.prod-bc.bc-on = yes     no-lock no-error.
     1113            if available ub.prod-bc then do:
     1114               find ub.bar-code where ub.bar-code.b-code = ub.prod-bc.b-code no-lock.
     1115            end.
     1116         end.
     1117      end.
     1118   END.
     1119   if available ub.place then do:
     1120     find ub.bar-code where ub.bar-code.b-code  = b-c no-lock.
     1121     find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
     1122     run plgdsfnd (input  no,
     1123                   input  buf_ord-doc.obj-type,
     1124                   input  buf_ord-doc.obj-code,
     1125                   input  pc-goods.gds-code,
     1126                   output varres,
     1127                   output var-code-temp) no-error.
     1128     if varres = yes or error-status:error then do:
     1129         put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
     1130             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     1131             " по объкту " buf_ord-doc.obj-type " " buf_ord-doc.obj-code " "  skip.
     1132         put stream err unformatted bar-str "," qnty-str "," pl-str skip.
     1133     end.
     1134     else
     1135   end.
     1136   end procedure.
     1137   procedure plgdsfnd :
     1138     define input  parameter p-chk-and-chs    as logical               no-undo.
     1139     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo.
     1140     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo.
     1141     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo.
     1142     define output parameter p-reserv-pl-code as   logical             no-undo.
     1143     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo.
     1144     define buffer buf_goods         for ub.goods .
     1145     define buffer buf_pl-gds        for ub.pl-gds .
     1146     define buffer buf_second_pl-gds for ub.pl-gds .
     1147     find first buf_goods no-lock
     1148       where buf_goods.gds-code = p-gds-code
     1149       no-error .
     1150     if not available buf_goods then do:
     1151       return error "Не найден товар. Первичный бар-код " + string(p-gds-code) .
     1152     end.
     1153   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1155     (input  p-obj-type
     1156     ,input  p-obj-code
     1157     ,input  buf_goods.artic
     1158     ,input  buf_goods.prod-type
     1159     ,input  buf_goods.prod-code
     1160     ,input  'place-rsrv=request'
     1161     ,output p-reserv-pl-code
     1162     ) no-error .
     1163   if error-status :error then do:
     1164     return error "Ошибка при запросе атрибута place-rsrv товара на объекте " .
     1165   end.
     1166     if p-reserv-pl-code = false then do:
     1167       return .
     1168     end.
     1169     if p-chk-and-chs <> yes then do:
     1170       return .
     1171     end.
     1172     find first buf_pl-gds no-lock
     1173       where buf_pl-gds.obj-type = p-obj-type
     1174         and buf_pl-gds.obj-code = p-obj-code
     1175         and buf_pl-gds.gds-code = p-gds-code
     1176       no-error .
     1177     if not available buf_pl-gds then do:
     1178       return error "К товару не привязано ни одного места хранения" .
     1179     end.
     1180     find first buf_second_pl-gds no-lock
     1181       where buf_second_pl-gds.obj-type = p-obj-type
     1182         and buf_second_pl-gds.obj-code = p-obj-code
     1183         and buf_second_pl-gds.gds-code = p-gds-code
     1184         and recid(buf_second_pl-gds) <> recid(buf_pl-gds)
     1185       no-error .
     1186     if not available buf_second_pl-gds then do:
     1187       assign
     1188         p-pl-code = buf_pl-gds.pl-code
     1189       .
     1190     end.
     1191     else do:
     1192       run str/plgdssel.p
     1193         (input  parparentproc
     1194         ,input  p-obj-type
     1195         ,input  p-obj-code
     1196         ,input  p-gds-code
     1197         ,output p-pl-code
     1198         ) no-error .
     1199       if error-status :error then do:
     1200         return error
     1201           "Ошибка при вызове программы plgdssel.p" + chr(10)
     1202           + error-status :get-message(1) + chr(10)
     1203           + return-value + chr(10) .
     1204       end.
     1205       if p-pl-code = ?
     1206       or p-pl-code = 0 then do:
     1207         return error
     1208           "Не выбрано место хранения " + chr(10) .
     1209       end.
     1210     end.
     1211   END PROCEDURE.
