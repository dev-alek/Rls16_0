     2473           buf_temp-prt-obj.prt-code         = p-prt-code
     2474           buf_temp-prt-obj.price-sale       = ?
     2475           buf_temp-prt-obj.fact-qnty        = 0
     2476           buf_temp-prt-obj.price-list-qnty  = ?
     2477           buf_temp-prt-obj.prt-obj-recid    = ?
     2478           buf_temp-prt-obj.price-list-recid = ?
     2479         .
     2480         find first buf_gds-prt no-lock
     2481           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2482           .
     2483         assign
     2484           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2485         .
     2486         if buf_temp-prt-obj.is-term
     2487         then do:
     2488           assign
     2489             buf_temp-prt-obj.price-sale = 0
     2490           .
     2491         end.
     2492       end.
     2493     end.
     2494   end procedure.
     2495   procedure prdoclib-init-temp-prt-obj :
     2496     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2497     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2498     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2499     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2500     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2501     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2502     define buffer buf_prt-obj      for ub.prt-obj .
     2503     define buffer buf_temp-prt-obj for temp-prt-obj .
     2504     do
     2505     on error undo, return error return-value
     2506     :
     2507       run prdoclib-clear-temp-prt-obj in this-procedure .
     2508       for each buf_prt-obj
     2509         where buf_prt-obj.obj-type  = p-obj-type
     2510           and buf_prt-obj.obj-code  = p-obj-code
     2511           and buf_prt-obj.artic     = p-artic
     2512           and buf_prt-obj.prod-type = p-prod-type
     2513           and buf_prt-obj.prod-code = p-prod-code
     2514       on error undo, return error return-value
     2515       :
     2516         run prdoclib-create-temp-prt-obj in this-procedure
     2517           (input  p-root-price-sale
     2518           ,buffer buf_prt-obj
     2519           ,buffer buf_temp-prt-obj
     2520           ).
     2521       end.
     2522     end.
     2523   end procedure.
     2524   procedure prdoclib-calc-fact-sale :
     2525     define input  parameter p-price-list-recid   as recid     no-undo .
     2526     define output parameter p-fact-qnty          as decimal   no-undo .
     2527     define output parameter p-cur-base           as decimal   no-undo .
