     2550           vss-include-info16 skip
     2551           "Ошибка задания входных параметров" skip
     2552           "Не найдена строка переоценки" skip
     2553           "Код записи (recid)" p-price-list-recid skip
     2554           view-as alert-box error .
     2555         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2556       end.
     2557       if buf_main_price-list.main-price <> true
     2558       then do:
     2559         message
     2560           vss-workfile vss-revision vss-description skip
     2561           vss-include-info16 skip
     2562           "Ошибка задания входных параметров" skip
     2563           "Строка переоценки не является основной" skip
