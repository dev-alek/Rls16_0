      458   procedure prn-lib-reportviewer :
      459     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      460     define input parameter p-report-name-html as character no-undo .
      461     define input parameter p-param        as character no-undo .
      462     define variable v-excel           as character no-undo init 'TRUE' .
      463     define variable v-value-character as character no-undo .
      464     define variable v-value-integer   as character no-undo .
      465     define variable v-value-date      as date      no-undo .
      466     define variable v-value-decimal   as decimal   no-undo .
      467     define variable rep-excel         as logical   no-undo .
      468     define variable excel-string      as character no-undo .
      469     define variable v-param-type      as character no-undo .
      470     define variable v-tth             as handle    no-undo .
      471     run adm/shattri.p (
      472       input "get":U
      473       ,input  ""
      474       ,input  0
      475       ,input  'report-glob':U
      476       ,input  'rep-excel':U
      477       ,output v-value-character
      478       ,output v-value-date
      479       ,output v-value-decimal
      480       ,output v-value-integer
      481       ,output rep-excel
      482       ,output v-param-type
      483       ,INPUT-OUTPUT table-handle v-tth
      484       )  .
      485     if rep-excel then v-excel = "TRUE" .
      486     else v-excel = "FALSE" .
      487     if p-param eq ""
      488     then
      489        p-param = "EXCEL:" + v-excel.
      490     else
      491        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      492     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      493   end procedure.
