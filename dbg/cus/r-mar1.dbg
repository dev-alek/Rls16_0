      567   procedure create_obj-list :
      568      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      569      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      570      do
      571      on error undo, return error return-value
      572      :
      573         define buffer cli-obj for ub.clients .
      574         define variable p-var as integer no-undo .
      575         define buffer buf_obj-list for obj-list .
      576         find last buf_obj-list  use-index pi no-error .
      577         if available buf_obj-list
      578         then
      579            p-var = buf_obj-list.obj-id + 1.
      580         else
      581            p-var = 1.
      582         find first cli-obj where
      583                   cli-obj.obj-type = p-obj-type
      584               and cli-obj.obj-code = p-obj-code
      585         no-lock no-error.
      586         if available cli-obj
      587         then do:
      588            create buf_obj-list.
      589            assign
      590               buf_obj-list.obj-id   = p-var
      591               buf_obj-list.obj-code = cli-obj.obj-code
      592               buf_obj-list.obj-type = cli-obj.obj-type
      593               buf_obj-list.obj-name = cli-obj.obj-name
      594               buf_obj-list.db-num   = cli-obj.db-num
      595            .
      596         end.
      597      end.
      598   end.
