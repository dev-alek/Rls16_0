     2540     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2541     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2542     :
     2543       find first buf_main_price-list no-lock
     2544         where recid(buf_main_price-list) = p-price-list-recid
     2545         no-error .
