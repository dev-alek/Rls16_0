     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430       find first buf_temp-prt-obj
     2431         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2432         no-error .
     2433       if not available buf_temp-prt-obj
     2434       then do:
     2435         create buf_temp-prt-obj .
     2436         assign
     2437           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2438           buf_temp-prt-obj.price-sale       = ?
     2439           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2440           buf_temp-prt-obj.price-list-qnty  = ?
     2441           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2442           buf_temp-prt-obj.price-list-recid = ?
     2443         .
     2444         find first buf_gds-prt no-lock
     2445           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2446           .
     2447         assign
     2448           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2449         .
     2450         if buf_temp-prt-obj.is-term
     2451         then do:
     2452           assign
     2453             buf_temp-prt-obj.price-sale = p-root-price-sale
     2454           .
     2455         end.
     2456       end.
     2457     end.
     2458   end procedure.
     2459   procedure prdoclib-temp-prt-obj-by-prt-root :
