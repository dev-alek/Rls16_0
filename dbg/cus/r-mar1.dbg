     2868               p-cur-SLT-base      = p-cur-SLT-base
     2869                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2870               p-cur-road-tax-base = p-cur-road-tax-base
     2871                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2872               p-cur-excise-base   = p-cur-excise-base
     2873                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2874             .
     2875           end.
     2876         end.
     2877     end.
     2878   end procedure.
     2879   procedure prdoclib-calc-prc :
     2880     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2881     define input  parameter p-cons-pay        as   integer                no-undo.
     2882     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2883     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2884     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2885     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2886     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2887     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2888     do
     2889     on error undo, return error return-value
     2890     :
     2891       define buffer buf_price-doc       for ub.price-doc .
     2892       define buffer buf_price-list      for ub.price-list .
     2893       define buffer buf_parts           for ub.parts .
     2894       define variable v-ov-qnty     as decimal   no-undo .
     2895       define variable v-ov-base     as decimal   no-undo .
     2896       define variable v-ov-VAT-base as decimal   no-undo .
     2897       define variable v-ov-SLT-base as decimal   no-undo .
     2898       define variable v-cons-qnty   as decimal   no-undo .
     2899       define variable v-prch-qnty   as decimal   no-undo .
     2900       define variable v-cons-mult   as decimal   no-undo .
     2901       define variable v-prch-mult   as decimal   no-undo .
     2902       find first buf_price-doc no-lock
     2903         where recid(buf_price-doc) = p-price-doc-recid
     2904         no-error .
     2905       if not available buf_price-doc
     2906       then do:
     2907         message
     2908           vss-workfile vss-revision vss-description skip
     2909           vss-include-info16 skip
     2910           "Ошибка задания входных параметров" skip
     2911           "Не найден документ переоценки" skip
     2912           "Код записи (recid)" p-price-doc-recid skip
     2913           view-as alert-box error .
     2914         undo, return error .
     2915       end.
     2916       for each buf_price-list no-lock
     2917         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2918           and buf_price-list.main-price = true
     2919       on error undo, return error return-value
     2920       :
     2921         run prdoclib-calc-ov
     2922           (input recid(buf_price-list)
     2923           ,output v-ov-qnty
     2924           ,output v-ov-base
     2925           ,output v-ov-VAT-base
     2926           ,output v-ov-SLT-base
     2927           ) no-error .
     2928         if error-status :error
     2929         then do:
     2930           if error-status :get-message(1) <> ""
     2931           then do:
     2932             message
     2933               vss-workfile vss-revision vss-description skip
     2934               vss-include-info16 skip
     2935               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2936               error-status :get-message(1) skip
     2937               return-value skip
     2938               view-as alert-box error .
     2939           end.
     2940           undo, return error return-value .
     2941         end.
     2942         assign
     2943           v-cons-qnty = 0
     2944           v-prch-qnty = 0
     2945         .
     2946         for each buf_parts no-lock
     2947           where buf_parts.out-code  = buf_price-list.doc-num
     2948             and buf_parts.obj-type  = buf_price-list.obj-type
     2949             and buf_parts.obj-code  = buf_price-list.obj-code
     2950             and buf_parts.artic     = buf_price-list.artic
     2951             and buf_parts.prod-type = buf_price-list.prod-type
     2952             and buf_parts.prod-code = buf_price-list.prod-code
     2953         on error undo, return error return-value
     2954         :
     2955           if buf_parts.pay-code = p-cons-pay
     2956           then do:
     2957             assign
     2958               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2959             .
     2960           end.
     2961           else do:
     2962             assign
     2963               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2964             .
     2965           end.
     2966         end.
     2967         if (v-cons-qnty + v-prch-qnty) = 0
     2968         then do:
     2969           assign
     2970             v-cons-mult = 0
     2971             v-prch-mult = 1
     2972           .
     2973         end.
     2974         else do:
     2975           assign
     2976             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2977             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2978           .
     2979         end.
     2980         assign
     2981           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2982           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2983           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2984           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2985           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2986           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2987         .
     2988       end.
     2989     end.
     2990   end procedure.
     2991   procedure prdoclib-calc-ov :
     2992     define input  parameter p-price-list-recid as recid     no-undo .
     2993     define output parameter p-fact-qnty        as decimal   no-undo .
     2994     define output parameter p-ov-base          as decimal   no-undo .
     2995     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2996     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2997     do
     2998     on error undo, return error return-value
     2999     :
     3000       define buffer buf_main_price-list    for ub.price-list .
     3001       define buffer buf_prev_price-list    for ub.price-list .
     3002       define buffer buf_special_price-list for ub.price-list .
     3003       define buffer buf_goods              for ub.goods .
     3004       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3005       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3006       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3007       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3008       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3009       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3010       define variable v-prev-price-list-recid as   recid                  no-undo.
     3011       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3012       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3013       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3014       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3015       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3016       find first buf_main_price-list no-lock
     3017         where recid(buf_main_price-list) = p-price-list-recid
     3018         no-error .
     3019       if not available buf_main_price-list
     3020       then do:
     3021         message
     3022           vss-workfile vss-revision vss-description skip
     3023           vss-include-info16 skip
     3024           "Ошибка задания входных параметров" skip
     3025           "Не найдена строка переоценки" skip
     3026           "Код записи (recid)" p-price-list-recid skip
     3027           view-as alert-box error .
     3028         undo, return error .
     3029       end.
     3030       if buf_main_price-list.main-price <> true
     3031       then do:
     3032         message
     3033           vss-workfile vss-revision vss-description skip
     3034           vss-include-info16 skip
     3035           "Ошибка задания входных параметров" skip
     3036           "Строка переоценки не является основной" skip
     3037           "Код записи (recid)" p-price-list-recid skip
     3038           "Переоценка" buf_main_price-list.doc-num skip
     3039           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3040           "Бар-код" buf_main_price-list.b-code skip
     3041           view-as alert-box error .
     3042         undo, return error .
     3043       end.
     3044       run prdoclib-calc-fact-sale in this-procedure
     3045         (input  recid(buf_main_price-list)
     3046         ,output v-fact-qnty
     3047         ,output v-cur-base
     3048         ,output v-cur-VAT-base
     3049         ,output v-cur-SLT-base
     3050         ,output v-cur-road-tax-base
     3051         ,output v-cur-excise-base
     3052         ) no-error.
     3053       if error-status :error
     3054       then do:
     3055         message
     3056           vss-workfile vss-revision vss-description skip
     3057           vss-include-info16 skip
     3058           "Ошибка при расчете сумм переоценки." skip
     3059           "Документ переоценки" buf_main_price-list.doc-num skip
     3060           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3061           error-status :get-message(1) skip
     3062           return-value skip
     3063           view-as alert-box error .
     3064         undo, return error .
     3065       end.
     3066   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3067   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3068     (input  buf_main_price-list.obj-type
     3069     ,input  buf_main_price-list.obj-code
     3070     ,input  buf_main_price-list.b-code
     3071     ,input  buf_main_price-list.b-code
     3072     ,input  buf_main_price-list.fact-order
     3073     ,output v-prev-price-list-recid
     3074     ,output v-prev-cli-base-rate
     3075     ) no-error .
     3076       if error-status :error
     3077       then do:
     3078         message
     3079           vss-workfile vss-revision vss-description skip
     3080           vss-include-info16 skip
     3081           "Ошибка при поиске предыдущей переоценки." skip
     3082           "Документ переоценки " buf_main_price-list.doc-num skip
     3083           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3084           error-status :get-message(1) skip
     3085           return-value skip
     3086           view-as alert-box error .
     3087         undo, return error .
     3088       end.
     3089       if v-prev-price-list-recid <> ?
     3090       then do:
     3091         find first buf_prev_price-list no-lock
     3092           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3093           .
     3094         find first buf_special_price-list no-lock
     3095           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3096             and buf_special_price-list.main-price = false
     3097             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3098             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3099             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3100             and buf_special_price-list.doc-qnty   <> ?
     3101           no-error .
     3102         if available buf_special_price-list
     3103         then do:
     3104           message
     3105             "Товар имеет специальные цены на признаки" skip
     3106             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3107             "Переоценка" buf_prev_price-list.doc-num skip
     3108             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3109             view-as alert-box error .
     3110           undo, return error .
     3111         end.
     3112         find first buf_goods no-lock
     3113           where buf_goods.artic     = buf_main_price-list.artic
     3114             and buf_goods.prod-type = buf_main_price-list.prod-type
     3115             and buf_goods.prod-code = buf_main_price-list.prod-code
     3116           no-error .
     3117         if not available buf_goods
     3118         then do:
     3119           message
     3120             vss-workfile vss-revision vss-description skip
     3121             vss-include-info16 skip
     3122             "Не найден товар" skip
     3123             "Переоценка" buf_main_price-list.doc-num skip
     3124             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3125             view-as alert-box error .
     3126           undo, return error .
     3127         end.
     3128         if buf_prev_price-list.vat-pc = ?
     3129         or buf_prev_price-list.slt-pc = ?
     3130         then do:
     3131           message
     3132             "В переоценке не заданы налоги товара" skip
     3133             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3134             "Переоценка" buf_prev_price-list.doc-num skip
     3135             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3136             "НДС" buf_prev_price-list.vat-pc skip
     3137             "НП" buf_prev_price-list.slt-pc skip
     3138             view-as alert-box error .
     3139           undo, return error return-value .
     3140         end.
     3141         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3142         assign
     3143           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3144         .
     3145         assign
     3146           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3147           v-prev-cur-VAT-base = v-fact-qnty
     3148                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3149                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3150           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3151         .
     3152         assign
     3153           p-fact-qnty   = v-fact-qnty
     3154           p-ov-base     = v-cur-base     - v-prev-cur-base
     3155           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3156           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3157         .
     3158       end.
     3159       else do:
     3160         assign
     3161           v-prev-cur-base     = 0
     3162           v-prev-cur-VAT-base = 0
     3163           v-prev-cur-SLT-base = 0
     3164           .
     3165         assign
     3166           p-fact-qnty   = v-fact-qnty
     3167           p-ov-base     = v-cur-base     - v-prev-cur-base
     3168           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3169           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3170         .
     3171       end.
     3172     end.
     3173   end procedure.
     3174   procedure prdoclib-init-prt-obj-by-factord :
     3175     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3176     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3177     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3178     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3179     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3180     define input parameter p-fact-order         as decimal   no-undo .
     3181     define input parameter p-include-fact-order as logical   no-undo .
     3182     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3183     define buffer buf_gds-obj      for ub.gds-obj .
     3184     define buffer buf_doc-line     for ub.doc-line .
     3185     define buffer buf_temp-prt-obj for temp-prt-obj .
     3186     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3187     do
     3188     on error undo, return error return-value
     3189     :
     3190       do transaction
     3191       on error undo, return error return-value
     3192       :
     3193   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3194   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3195     (input  p-obj-type
     3196     ,input  p-obj-code
     3197     ,input  p-artic
     3198     ,input  p-prod-type
     3199     ,input  p-prod-code
     3200     ,buffer buf_gds-obj
     3201     ) no-error .
     3202         if error-status :error
     3203         then do:
     3204           message
     3205             vss-workfile vss-revision vss-description skip
     3206             vss-include-info16 skip
     3207             "Невозможно найти gds-obj" skip
     3208             error-status :get-message(1) skip
     3209             return-value skip
     3210             view-as alert-box error .
     3211           undo, return error .
     3212         end.
     3213         find current buf_gds-obj exclusive-lock .
     3214       end.
     3215       run prdoclib-init-temp-prt-obj in this-procedure
     3216         (input p-obj-type
     3217         ,input p-obj-code
     3218         ,input p-artic
     3219         ,input p-prod-type
     3220         ,input p-prod-code
     3221         ,input 0
     3222         ) .
     3223       for each buf_temp-prt-obj
     3224         where buf_temp-prt-obj.is-term <> true
     3225       on error undo, return error return-value
     3226       :
     3227         delete buf_temp-prt-obj .
     3228       end.
     3229       if p-include-fact-order = true
     3230       then do:
     3231         assign
     3232          p-fact-order = p-fact-order - 0.0000000001
     3233         .
     3234       end.
     3235       for each buf_doc-line no-lock
     3236         where buf_doc-line.obj-type   = p-obj-type
     3237           and buf_doc-line.obj-code   = p-obj-code
     3238           and buf_doc-line.artic      = p-artic
     3239           and buf_doc-line.prod-type  = p-prod-type
     3240           and buf_doc-line.prod-code  = p-prod-code
     3241           and buf_doc-line.status_    = 'факт':U
     3242           and buf_doc-line.fact-order >= p-fact-order
     3243       on error undo, return error return-value
     3244       :
     3245         run prdoclib-process-document in this-procedure
     3246           (input  buf_doc-line.doc-code
     3247           ,input  p-obj-type
     3248           ,input  p-obj-code
     3249           ,input  p-artic
     3250           ,input  p-prod-type
     3251           ,input  p-prod-code
     3252           ,output v-total-gds-dtl-qnty
     3253           ) .
     3254       end.
     3255     end.
     3256   end procedure.
     3257   procedure prdoclib-process-document :
     3258     define input  parameter p-doc-code           as character no-undo .
     3259     define input  parameter p-obj-type           as character no-undo .
     3260     define input  parameter p-obj-code           as integer   no-undo .
     3261     define input  parameter p-artic              as character no-undo .
     3262     define input  parameter p-prod-type          as character no-undo .
     3263     define input  parameter p-prod-code          as integer   no-undo .
     3264     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3265     define buffer buf_trn-doc      for ub.trn-doc .
     3266     define buffer buf_gds-dtl      for ub.gds-dtl .
     3267     define buffer buf_temp-prt-obj for temp-prt-obj .
     3268     do
     3269     on error undo, return error return-value
     3270     :
     3271       find first buf_trn-doc no-lock
     3272         where buf_trn-doc.doc-code = p-doc-code
     3273         no-error .
     3274       if not available buf_trn-doc then do:
     3275         message
     3276           vss-workfile vss-revision vss-description skip
     3277           vss-include-info16 skip
     3278           "Ошибка при поиске документа" skip
     3279           "Документ" p-doc-code skip
     3280           "Объект" p-obj-type p-obj-code skip
     3281           "Артикул" p-artic p-prod-type p-prod-code skip
     3282           view-as alert-box error .
     3283         undo, return error .
     3284       end.
     3285       assign
     3286         p-total-gds-dtl-qnty = 0
     3287       .
     3288       for each buf_gds-dtl no-lock
     3289         where buf_gds-dtl.doc-code  = p-doc-code
     3290           and buf_gds-dtl.artic     = p-artic
     3291           and buf_gds-dtl.prod-type = p-prod-type
     3292           and buf_gds-dtl.prod-code = p-prod-code
     3293       on error undo, return error
     3294       :
     3295         define variable v-term-node as integer   no-undo .
     3296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3297     (input  buf_gds-dtl.prt-code
     3298     ,output v-term-node
     3299     )  .
     3300         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3301           (input  v-term-node
     3302           ,buffer buf_temp-prt-obj
     3303           ) .
     3304         if buf_temp-prt-obj.is-term <> true then do:
     3305           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3306                                        ,buf_gds-dtl.prt-code
     3307                                        ) .
     3308         end.
     3309         case buf_trn-doc.doc-type :
     3310           when 'при':U or
     3311           when 'возврат':U
     3312           then do:
     3313             assign
     3314               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3315                                           - buf_gds-dtl.fact-qnty
     3316               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3317                                           - buf_gds-dtl.fact-qnty
     3318             .
     3319           end.
     3320           when 'рас':U or
     3321           when 'спи':U
     3322           then do:
     3323             assign
     3324               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3325                                           + buf_gds-dtl.fact-qnty
     3326               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3327                                           + buf_gds-dtl.fact-qnty
     3328             .
     3329           end.
     3330           when 'инв':U
     3331           then do:
     3332             assign
     3333               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3334                                           - buf_gds-dtl.doc-qnty
     3335               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3336                                           - buf_gds-dtl.doc-qnty
     3337             .
     3338           end.
     3339           otherwise do:
     3340             undo, return error substitute("Неизвестный тип документа &1"
     3341                                          ,buf_trn-doc.doc-type
     3342                                          ) .
     3343           end.
     3344         end.
     3345       end.
     3346     end.
     3347   end procedure.
     3348   procedure prdoclib-prc-pl-document :
     3349     define input  parameter p-doc-code              as character no-undo .
     3350     define input  parameter p-obj-type              as character no-undo .
     3351     define input  parameter p-obj-code              as integer   no-undo .
     3352     define input  parameter p-gds-code              as integer   no-undo .
     3353     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3354     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3355     do
     3356     on error undo, return error return-value
     3357     :
     3358       define buffer buf_trn-doc      for ub.trn-doc .
     3359       define buffer buf_doc-pl       for ub.doc-pl .
     3360       define buffer buf_temp-pl-gds for temp-pl-gds .
     3361       define variable v-sign as decimal   no-undo .
     3362       find first buf_trn-doc no-lock
     3363         where buf_trn-doc.doc-code = p-doc-code
     3364         no-error .
     3365       if not available buf_trn-doc then do:
     3366         message
     3367           vss-workfile vss-revision vss-description skip
     3368           vss-include-info16 skip
     3369           "Ошибка при поиске документа" skip
     3370           "Документ" p-doc-code skip
     3371           "Объект" p-obj-type p-obj-code skip
     3372           "Товар" p-gds-code skip
     3373           view-as alert-box error .
     3374         undo, return error .
     3375       end.
     3376       assign
     3377         p-total-pl-gds-qnty     = 0
     3378         p-total-pl-gds-cli-qnty = 0
     3379       .
     3380       for each buf_doc-pl no-lock
     3381         where buf_doc-pl.out-code  = p-doc-code
     3382           and buf_doc-pl.gds-code  = p-gds-code
     3383       on error undo, return error return-value
     3384       :
     3385         find first buf_temp-pl-gds
     3386           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3387             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3388             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3389           .
     3390         case buf_trn-doc.doc-type :
     3391           when 'при':U
     3392           or when 'возврат':U
     3393           or when 'инв':U
     3394           then do:
     3395             assign
     3396               v-sign = -1.0
     3397             .
     3398           end.
     3399           when 'рас':U or
     3400           when 'спи':U
     3401           then do:
     3402             assign
     3403               v-sign = 1.0
     3404             .
     3405           end.
     3406           otherwise do:
     3407             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3408           end.
     3409         end case.
     3410         assign
     3411           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3412           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3413           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3414           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3415         .
     3416       end.
     3417     end.
     3418   end procedure.
     3419   procedure prdoclib-init-prt-obj-by-date :
     3420     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3421     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3422     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3423     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3424     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3425     define input parameter p-fact-date  as date      no-undo .
     3426     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3427     do
     3428     on error undo, return error return-value
     3429     :
     3430       define variable v-fact-order                as decimal   no-undo .
     3431       define variable v-shift-end-fact-order      as decimal   no-undo .
     3432       define variable v-day-end-fact-order        as decimal   no-undo .
     3433       run factord in this-procedure
     3434         (input  p-fact-date
     3435         ,input  1
     3436         ,input  1
     3437         ,input  ?
     3438         ,input  0
     3439         ,input  false
     3440         ,output v-fact-order
     3441         ,output v-shift-end-fact-order
     3442         ,output v-day-end-fact-order
     3443         ) no-error .
     3444       if error-status :error
     3445       then do:
     3446         message
     3447           vss-workfile vss-revision vss-description skip
     3448           vss-include-info16 skip
     3449           "Ошибка при определении момента времени, на который требуется остаток" skip
     3450           "Объект" p-obj-type p-obj-code skip
     3451           "Артикул" p-artic p-prod-type p-prod-code skip
     3452           "Дата" p-fact-date skip
     3453           view-as alert-box error .
     3454         undo, return error .
     3455       end.
     3456       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3457         (input p-obj-type
     3458         ,input p-obj-code
     3459         ,input p-artic
     3460         ,input p-prod-type
     3461         ,input p-prod-code
     3462         ,input v-day-end-fact-order
     3463         ,input false
     3464         ) no-error .
     3465       if error-status :error
     3466       then do:
     3467         message
     3468           vss-workfile vss-revision vss-description skip
     3469           vss-include-info16 skip
     3470           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3471           "Объект" p-obj-type p-obj-code skip
     3472           "Артикул" p-artic p-prod-type p-prod-code skip
     3473           "Дата" p-fact-date skip
     3474           view-as alert-box error .
     3475         undo, return error .
     3476       end.
     3477     end.
     3478   end procedure.
     3479   procedure prdoclib-calc-temp-fact-sale :
     3480     define input  parameter p-obj-type           as character no-undo .
     3481     define input  parameter p-obj-code           as integer   no-undo .
     3482     define input  parameter p-gds-code           as integer   no-undo .
     3483     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3484     define input  parameter p-curr-r-b           as character no-undo .
     3485     define output parameter p-fact-qnty          as decimal   no-undo .
     3486     define output parameter p-cur-base           as decimal   no-undo .
     3487     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3488     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3489     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3490     define output parameter p-cur-excise-base    as decimal   no-undo .
     3491     define buffer buf_temp-prt-obj for temp-prt-obj .
     3492     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3493     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3494     define variable parrecid-prl        as recid     no-undo .
     3495     define variable v-fact-qnty         as decimal   no-undo .
     3496     define variable v-cur-base          as decimal   no-undo .
     3497     define variable v-cur-VAT-base      as decimal   no-undo .
     3498     define variable v-cur-SLT-base      as decimal   no-undo .
     3499     define variable v-cur-road-tax-base as decimal   no-undo .
     3500     define variable v-cur-excise-base   as decimal   no-undo .
     3501     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3502     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3503     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3504     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3505     define variable vat-base-sale-prl               as decimal   no-undo .
     3506     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3507     define variable vat-base-buyer-prl              as decimal   no-undo .
     3508     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3509     define variable slt-base-sale-prl               as decimal   no-undo .
     3510     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3511     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3512     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3513     define variable excise-base-sale-prl            as decimal   no-undo .
     3514     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3515     define variable discnt-base-sale-prl            as decimal   no-undo .
     3516     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3517     do
     3518     on error undo, return error return-value
     3519     :
     3520       for each buf_temp-prt-obj no-lock
     3521       on error undo, return error return-value
     3522       :
     3523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3524     (input  p-gds-code
     3525     ,input  buf_temp-prt-obj.prt-code
     3526     ,output v-prt-b-code
     3527     ) no-error .
     3528         if error-status :error
     3529         then do:
     3530           message
     3531             vss-workfile vss-revision vss-description skip
     3532             "Ошибка при определении бар-кода признака" skip
     3533             "Код товара"   p-gds-code skip
     3534             "Код признака" buf_temp-prt-obj.prt-code skip
     3535             error-status :get-message(1) skip
     3536             return-value skip
     3537             view-as alert-box error .
     3538           undo, return error .
     3539         end.
     3540   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3542     (input  p-obj-type
     3543     ,input  p-obj-code
     3544     ,input  v-prt-b-code
     3545     ,input  0
     3546     ,input  p-day-end-fact-order
     3547     ,output parrecid-prl
     3548     ,output v-cli-base-rate
     3549     ) no-error .
     3550         if error-status :error
     3551         then do:
     3552           message
     3553             vss-workfile vss-revision vss-description skip
     3554             "Ошибка при определении цены бар-кода" skip
     3555             "Объект" p-obj-type p-obj-code skip
     3556             "Бар-код" v-prt-b-code skip
     3557             "fact-order" p-day-end-fact-order skip
     3558             error-status :get-message(1) skip
     3559             return-value skip
     3560             view-as alert-box error .
     3561           undo, return error .
     3562         end.
     3563         if parrecid-prl <> ?
     3564         then do:
     3565           run prl-vat in this-procedure
     3566             (input  parrecid-prl
     3567             ,output price-rubl-with-tax-sale-prl
     3568             ,output price-base-with-tax-sale-prl
     3569             ,output price-rubl-without-tax-sale-prl
     3570             ,output price-base-without-tax-sale-prl
     3571             ,output vat-base-sale-prl
     3572             ,output vat-rubl-sale-prl
     3573             ,output vat-base-buyer-prl
     3574             ,output vat-rubl-buyer-prl
     3575             ,output slt-base-sale-prl
     3576             ,output slt-rubl-sale-prl
     3577             ,output road-tax-base-sale-prl
     3578             ,output road-tax-rubl-sale-prl
     3579             ,output excise-base-sale-prl
     3580             ,output excise-rubl-sale-prl
     3581             ,output discnt-base-sale-prl
     3582             ,output discnt-rubl-sale-prl
     3583             ) no-error .
     3584           if error-status :error
     3585           then do:
     3586             message
     3587               vss-workfile vss-revision vss-description skip
     3588               "Ошибка при вызове процеды prl-vat" skip
     3589               "Объект" p-obj-type p-obj-code skip
     3590               "Код товара" p-gds-code skip
     3591               "Указатель на запись переоценки" parrecid-prl skip
     3592               error-status :get-message(1) skip
     3593               return-value skip
     3594               view-as alert-box error .
     3595             undo, return error .
     3596           end.
     3597         end.
     3598         else do:
     3599           assign
     3600             price-rubl-with-tax-sale-prl    = 0
     3601             price-base-with-tax-sale-prl    = 0
     3602             price-rubl-without-tax-sale-prl = 0
     3603             price-base-without-tax-sale-prl = 0
     3604             vat-base-sale-prl               = 0
     3605             vat-rubl-sale-prl               = 0
     3606             slt-base-sale-prl               = 0
     3607             slt-rubl-sale-prl               = 0
     3608             road-tax-base-sale-prl          = 0
     3609             road-tax-rubl-sale-prl          = 0
     3610             excise-base-sale-prl            = 0
     3611             excise-rubl-sale-prl            = 0
     3612             discnt-base-sale-prl            = 0
     3613             discnt-rubl-sale-prl            = 0
     3614           .
     3615         end.
     3616         assign
     3617           v-fact-qnty         = v-fact-qnty
     3618                               + buf_temp-prt-obj.fact-qnty
     3619           v-cur-base          = v-cur-base
     3620                               + (if p-curr-r-b = 'base':U
     3621                                   then price-base-with-tax-sale-prl
     3622                                   else price-rubl-with-tax-sale-prl
     3623                                 )
     3624                               * buf_temp-prt-obj.fact-qnty
     3625           v-cur-VAT-base      = v-cur-VAT-base
     3626                               + (if p-curr-r-b = 'base':U
     3627                                   then vat-base-sale-prl
     3628                                   else vat-rubl-sale-prl
     3629                                 )
     3630                               * buf_temp-prt-obj.fact-qnty
     3631           v-cur-SLT-base      = v-cur-SLT-base
     3632                               + (if p-curr-r-b = 'base':U
     3633                                   then slt-base-sale-prl
     3634                                   else slt-rubl-sale-prl
     3635                                 )
     3636                               * buf_temp-prt-obj.fact-qnty
     3637           v-cur-road-tax-base = v-cur-road-tax-base
     3638                               + (if p-curr-r-b = 'base':U
     3639                                   then road-tax-base-sale-prl
     3640                                   else road-tax-rubl-sale-prl
     3641                                 )
     3642                               * buf_temp-prt-obj.fact-qnty
     3643           v-cur-excise-base   = v-cur-excise-base
     3644                               + (if p-curr-r-b = 'base':U
     3645                                   then excise-base-sale-prl
     3646                                   else excise-rubl-sale-prl
     3647                                 )
     3648                               * buf_temp-prt-obj.fact-qnty
     3649         .
     3650       end.
     3651       assign
     3652         p-fact-qnty         = v-fact-qnty
     3653         p-cur-base          = v-cur-base
     3654         p-cur-VAT-base      = v-cur-VAT-base
     3655         p-cur-SLT-base      = v-cur-SLT-base
     3656         p-cur-road-tax-base = v-cur-road-tax-base
     3657         p-cur-excise-base   = v-cur-excise-base
     3658       .
     3659     end.
     3660   end procedure.
     3661   procedure prdoclib-clear-temp-pl-gds :
     3662     define buffer buf_temp-pl-gds for temp-pl-gds .
     3663     do
     3664     on error undo, return error return-value
     3665     :
     3666       for each buf_temp-pl-gds
     3667       on error undo, return error return-value
     3668       :
     3669         delete buf_temp-pl-gds .
     3670       end.
     3671     end.
     3672   end procedure.
     3673   procedure prdoclib-init-temp-pl-gds :
     3674     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3675     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3676     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3677     define buffer buf_pl-gds      for ub.pl-gds .
     3678     define buffer buf_temp-pl-gds for temp-pl-gds .
     3679     do
     3680     on error undo, return error return-value
     3681     :
     3682       run prdoclib-clear-temp-pl-gds in this-procedure .
     3683       for each buf_pl-gds
     3684         where buf_pl-gds.obj-type = p-obj-type
     3685           and buf_pl-gds.obj-code = p-obj-code
     3686           and buf_pl-gds.gds-code = p-gds-code
     3687       on error undo, return error return-value
     3688       :
     3689         create buf_temp-pl-gds .
     3690         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3691       end.
     3692     end.
     3693   end procedure.
     3694   procedure prdoclib-init-pl-gds-by-factord :
     3695     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3696     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3697     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3698     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3699     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3700     define input parameter p-fact-order         as decimal   no-undo .
     3701     define input parameter p-include-fact-order as logical   no-undo .
     3702     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3703     define buffer buf_goods       for ub.goods .
     3704     define buffer buf_gds-obj     for ub.gds-obj .
     3705     define buffer buf_doc-line    for ub.doc-line .
     3706     define buffer buf_temp-pl-gds for temp-pl-gds .
     3707     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3708     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3709     do
     3710     on error undo, return error return-value
     3711     :
     3712       do transaction
     3713       on error undo, return error return-value
     3714       :
     3715   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3717     (input  p-obj-type
     3718     ,input  p-obj-code
     3719     ,input  p-artic
     3720     ,input  p-prod-type
     3721     ,input  p-prod-code
     3722     ,buffer buf_gds-obj
     3723     ) no-error .
     3724         if error-status :error
     3725         then do:
     3726           message
     3727             vss-workfile vss-revision vss-description skip
     3728             vss-include-info16 skip
     3729             "Невозможно найти gds-obj" skip
     3730             error-status :get-message(1) skip
     3731             return-value skip
     3732             view-as alert-box error .
     3733           undo, return error return-value .
     3734         end.
     3735         find current buf_gds-obj exclusive-lock .
     3736       end.
     3737       find first buf_goods no-lock
     3738         where buf_goods.artic     = p-artic
     3739           and buf_goods.prod-type = p-prod-type
     3740           and buf_goods.prod-code = p-prod-code
     3741         .
     3742       run prdoclib-init-temp-pl-gds in this-procedure
     3743         (input p-obj-type
     3744         ,input p-obj-code
     3745         ,input buf_goods.gds-code
     3746         ) .
     3747       if p-include-fact-order = true
     3748       then do:
     3749         assign
     3750          p-fact-order = p-fact-order - 0.0000000001
     3751         .
     3752       end.
     3753       for each buf_doc-line no-lock
     3754         where buf_doc-line.obj-type   = p-obj-type
     3755           and buf_doc-line.obj-code   = p-obj-code
     3756           and buf_doc-line.artic      = p-artic
     3757           and buf_doc-line.prod-type  = p-prod-type
     3758           and buf_doc-line.prod-code  = p-prod-code
     3759           and buf_doc-line.status_    = 'факт':U
     3760           and buf_doc-line.fact-order >= p-fact-order
     3761       on error undo, return error return-value
     3762       :
     3763         run prdoclib-prc-pl-document in this-procedure
     3764           ( input  buf_doc-line.doc-code
     3765            ,input  p-obj-type
     3766            ,input  p-obj-code
     3767            ,input  buf_goods.gds-code
     3768            ,output v-total-pl-gds-qnty
     3769            ,output v-total-pl-gds-cli-qnty
     3770           ) .
     3771       end.
     3772     end.
     3773   end procedure.
     3774   define variable date_string     as      char    no-undo.
     3775   define stream PrnLibStream .
     3776   define buffer buf_clients for ub.clients.
     3777   def temp-table sj-bar-code no-undo
     3778   field b-code like ub.bar-code.b-code
     3779   field gds-code like ub.bar-code.b-code
     3780   field node-code like ub.bar-code.node-code
     3781   field in-sale-date-from as date
     3782   field in-sale-date-to as date
     3783   field is-qnty as logical
     3784   INDEX pi IS PRIMARY
     3785         gds-code
     3786         node-code
     3787         in-sale-date-to
     3788   INDEX ishow
     3789         gds-code
     3790         b-code
     3791         in-sale-date-to
     3792   .
     3793   def temp-table sj-goods no-undo
     3794   field b-code like ub.bar-code.b-code
     3795   field gds-code like ub.bar-code.b-code
     3796   field gds-name like ub.goods.gds-name
     3797   field node-code like ub.bar-code.node-code
     3798   field artic     like ub.goods.artic
     3799   field prod-type like ub.goods.prod-type
     3800   field prod-code like ub.goods.prod-code
     3801   field in-sale-days as integer
     3802   INDEX pi IS PRIMARY
     3803         gds-code
     3804         b-code
     3805   index iartic
     3806         artic
     3807         prod-type
     3808         prod-code
     3809         b-code
     3810   index igds-name
     3811         gds-name
     3812         gds-code
     3813         b-code
     3814   .
     3815   def temp-table temp-prt-in-sale no-undo
     3816   field obj as character
     3817   field gds-code like ub.goods.gds-code
     3818   field prt-code like ub.prt-obj.prt-code
     3819   field evening as logical
     3820   field fact-qnty as decimal
     3821   field cr as integer
     3822   index pi is primary
     3823   gds-code
     3824   prt-code
     3825   obj
     3826   index icreate
     3827   cr
     3828   .
     3829   assign
     3830   date_string = cur-time-print() .
     3831   do
     3832   on error undo, return error
     3833   :
     3834     if g#db-num <> 0 then do:
     3835       for each obj-list no-lock,
     3836           first buf_clients no-lock where
     3837                 buf_clients.obj-type = obj-list.obj-type
     3838             AND buf_clients.obj-code = obj-list.obj-code:
     3839         if buf_clients.db-num <> g#db-num then do:
     3840           message
     3841           "Отчет может быть запущен только для объектов БД" g#db-num skip
     3842           "или же в ГБД"
     3843           view-as alert-box error .
     3844           return .
     3845         end.
     3846       end.
     3847     end.
     3848     define variable v-start-date-order      as decimal   no-undo .
     3849     define variable v-end-date-order        as decimal   no-undo .
     3850     run day-begin-fact-order  in this-procedure (
     3851                                                     input p-start-date
     3852                                                     ,output v-start-date-order) no-error .
     3853     run factord-end-day  in this-procedure (
     3854                                              input p-end-date
     3855                                             ,output v-end-date-order) no-error .
     3856     run cr-sj-bar-code in this-procedure .
     3857     if can-find(first sj-bar-code) then do:
     3858       if p-sort-method = "artic":U
     3859       or p-sort-method = "name":U then do:
     3860         run cr-sj-goods in this-procedure .
     3861       end.
     3862       run printproc in this-procedure .
     3863     end.
     3864     else do:
     3865       message
     3866       "Нет данных для отчета - " skip
     3867       "ни один из выбранных товаров не был в продаже за запрошенный период времени" skip
     3868       string(if p-zero then "а опция <Выводить товары с нулевым значением> не включена" else "":U)
     3869       view-as alert-box warning.
     3870     end.
     3871   end.
     3872   procedure cr-sj-bar-code :
     3873   define buffer buf_temp-prt-in-sale for temp-prt-in-sale.
     3874   define buffer buf_goods for ub.goods.
     3875     do
     3876     on error undo, return error
     3877     :
     3878       CASE p-select-good:
     3879         when 1 then do:
     3880           for each buf_goods no-lock:
     3881             run process-one-good in this-procedure(
     3882                                                      input buf_goods.gds-code
     3883                                                     ,input buf_goods.artic
     3884                                                     ,input buf_goods.prod-type
     3885                                                     ,input buf_goods.prod-code
     3886                                                     ,input buf_goods.unit-base
     3887                                                     ,input v-start-date-order
     3888                                                     ,input v-end-date-order
     3889                                                   ).
     3890           end.
     3891         end.
     3892         when 2 then do:
     3893           for each tmp#grp  no-lock where
     3894                   tmp#grp.is-term = yes,
     3895               each buf_goods no-lock where
     3896                     buf_goods.grp-code = tmp#grp.node-code:
     3897             run process-one-good in this-procedure(
     3898                                                         input buf_goods.gds-code
     3899                                                       ,  input buf_goods.artic
     3900                                                       ,  input buf_goods.prod-type
     3901                                                       ,  input buf_goods.prod-code
     3902                                                       ,  input buf_goods.unit-base
     3903                                                       ,  input v-start-date-order
     3904                                                       ,  input v-end-date-order
     3905                                                     ).
     3906           end.
     3907         end.
     3908         when 3 then do:
     3909           for each g#cli no-lock,
     3910               each buf_goods no-lock where
     3911                   buf_goods.prod-type = g#cli.obj-type
     3912               AND  buf_goods.prod-code = g#cli.obj-code:
     3913                 run process-one-good in this-procedure(
     3914                                                         input buf_goods.gds-code
     3915                                                       ,  input buf_goods.artic
     3916                                                       ,  input buf_goods.prod-type
     3917                                                       ,  input buf_goods.prod-code
     3918                                                       ,  input buf_goods.unit-base
     3919                                                       ,  input v-start-date-order
     3920                                                       ,  input v-end-date-order
     3921                                                     ).
     3922             end.
     3923           end.
     3924           when 5
     3925           or
     3926           when 4
     3927           or
     3928           when 7
     3929           then do:
     3930             for each gds-list no-lock:
     3931               run process-one-good in this-procedure(
     3932                                                         input gds-list.gds-code
     3933                                                       ,  input gds-list.artic
     3934                                                       ,  input gds-list.prod-type
     3935                                                       ,  input gds-list.prod-code
     3936                                                       ,  input gds-list.unit-base
     3937                                                       ,  input v-start-date-order
     3938                                                       ,  input v-end-date-order
     3939                                                     ).
     3940             end.
     3941           end.
     3942       END CASE.
     3943       run waitfram-hide in this-procedure .
     3944     end.
     3945   end procedure.
     3946   procedure process-one-good :
     3947   define input parameter p-gds-code    like ub.goods.gds-code  no-undo .
     3948   define input parameter p-artic       like ub.goods.artic     no-undo .
     3949   define input parameter p-prod-type   like ub.goods.prod-type no-undo .
     3950   define input parameter p-prod-code   like ub.goods.prod-code no-undo .
     3951   define input parameter p-unit-base   like ub.goods.unit-base no-undo .
     3952   define input parameter p-start-date-order as decimal no-undo .
     3953   define input parameter p-end-date-order as decimal no-undo .
     3954   define buffer buf_gds-obj for ub.gds-obj.
     3955   define buffer buf_goods for ub.goods.
     3956     do
     3957     on error undo, return error
     3958     :
     3959        run waitfram-show in this-procedure ("Обрабатывается товар" + chr(32) + p-artic + chr(32) + p-prod-type + string(p-prod-code) ).
     3960        find first buf_goods no-lock where
     3961                  buf_goods.gds-code = p-gds-code no-error .
     3962        if error-status:error then do:
     3963          undo, return error substitute("Не найден товар с кодом &1", P-GDS-CODE).
     3964        end.
     3965        _OBJ-LIST:
     3966        for each obj-list no-lock:
     3967           find first buf_gds-obj no-lock where
     3968                     buf_gds-obj.gds-code = p-gds-code
     3969                 AND buf_gds-obj.obj-type = obj-list.obj-type
     3970                 AND buf_gds-obj.obj-code = obj-list.obj-code no-error .
     3971           if not available buf_gds-obj then do:
     3972             Next _OBJ-LIST.
     3973           END.
     3974           run prdoclib-init-prt-obj-by-factord
     3975                                             in this-procedure (
     3976                                                                input obj-list.obj-type
     3977                                                               ,input obj-list.obj-code
     3978                                                               ,input buf_goods.artic
     3979                                                               ,input buf_goods.prod-type
     3980                                                               ,input buf_goods.prod-code
     3981                                                               ,input p-end-date-order
     3982                                                               ,input no
     3983                                                               ) .
     3984           run write-temp-prt-to-sj in this-procedure (
     3985                                                        input p-end-date
     3986                                                       ,input p-end-date
     3987                                                       ,input p-gds-code
     3988                                                       ,input p-unit-base
     3989                                                       ) no-error .
     3990           run decrement-prt-obj in this-procedure (
     3991                                                    input obj-list.obj-type
     3992                                                   ,input obj-list.obj-code
     3993                                                   ,input p-gds-code
     3994                                                   ,input buf_goods.artic
     3995                                                   ,input buf_goods.prod-type
     3996                                                   ,input buf_goods.prod-code
     3997                                                   ,input p-unit-base
     3998                                                   ,input p-start-date-order
     3999                                                   ,input p-end-date-order) .
     4000       end.
     4001     end.
     4002   end procedure.
     4003   procedure cr-sj-goods :
     4004   define buffer buf_goods for ub.goods.
     4005   define variable f-gds-name as character no-undo .
     4006   define variable f-in-sale-days as integer no-undo .
     4007   define variable f-artic like ub.goods.artic no-undo .
     4008   define variable f-prod-type like ub.goods.prod-type no-undo .
     4009   define variable f-prod-code like ub.goods.prod-code no-undo .
     4010     do
     4011     on error undo, return error
     4012     :
     4013        run waitfram-show in this-procedure ("Ждите..." ).
     4014        for each sj-bar-code no-lock
     4015        break
     4016        by sj-bar-code.gds-code
     4017        by sj-bar-code.b-code
     4018        by sj-bar-code.in-sale-date-to :
     4019           if first-of(sj-bar-code.gds-code) then do:
     4020               find first buf_goods no-lock where
     4021                        buf_goods.gds-code = sj-bar-code.gds-code.
     4022             assign
     4023             f-gds-name = buf_goods.gds-name
     4024             f-artic    = buf_goods.artic
     4025             f-prod-type = buf_goods.prod-type
     4026             f-prod-code = buf_goods.prod-code
     4027             .
     4028           end.
     4029           if first-of (sj-bar-code.b-code) then do:
     4030             assign
     4031             f-in-sale-days = 0
     4032             .
     4033           end.
     4034           if sj-bar-code.is-qnty then
     4035           assign
     4036           f-in-sale-days = f-in-sale-days +
     4037                            if sj-bar-code.is-qnty
     4038                            then (sj-bar-code.in-sale-date-to - sj-bar-code.in-sale-date-from + 1)
     4039                            else 0
     4040           .
     4041           if last-of(sj-bar-code.b-code) then do:
     4042             find first sj-goods where
     4043                       sj-goods.gds-code = sj-bar-code.gds-code
     4044                  AND  sj-goods.b-code = sj-bar-code.b-code no-error .
     4045             if not available sj-goods then do:
     4046               create sj-goods.
     4047               buffer-copy sj-bar-code to sj-goods
     4048               assign
     4049               sj-goods.gds-name = f-gds-name
     4050               sj-goods.artic     = f-artic
     4051               sj-goods.prod-type = f-prod-type
     4052               sj-goods.prod-code = f-prod-code
     4053               sj-goods.in-sale-days = f-in-sale-days
     4054               .
     4055             end.
     4056           end.
     4057        end.
     4058        run waitfram-hide in this-procedure .
     4059     end.
     4060   end procedure.
     4061   procedure printproc :
     4062   define variable f-prod-name as character no-undo .
     4063   define variable f-grp-name as character no-undo .
     4064   define variable f-prt-name as character no-undo .
     4065   define variable f-gds-name as character no-undo .
     4066   define variable f-artic as character no-undo .
     4067   define variable f-in-sale-days as integer no-undo .
     4068   define variable line as character no-undo .
     4069   define variable ii-excel as integer no-undo .
     4070   define variable ii-page as integer no-undo init 1.
     4071   define buffer buf1_sheetf for sheetf.
     4072   define buffer buf_sheetf for sheetf.
     4073   define buffer buf_goods for ub.goods.
     4074   define buffer buf_clients for ub.clients.
     4075   define buffer buf_gds-prt for ub.gds-prt.
     4076     do
     4077     on error undo, return error
     4078     :
     4079       DEFINE FRAME OutFrame
     4080       sj-goods.b-code COLUMN-LABEL "Код"
     4081       sj-goods.artic  COLUMN-LABEL "Артикул"
     4082       f-gds-name COLUMn-LABEL "Название товара"  format "X(40)"
     4083       f-prt-name COLUMn-LABEL "Шкальный признак" format "X(20)"
     4084       f-prod-name COLUMn-LABEL "Производитель" format "X(30)"
     4085       f-grp-name  COLUMn-LABEL "Группа" format "X(50)"
     4086       f-in-sale-days COLUMN-LABEL "Дней в продаже" format ">>>9"
     4087       HEADER
     4088           cur-time-print() AT 5 format "X(35)"
     4089           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>>>>9" ) ) AT 170 format "X(13)" SKIP
     4090           Line format "X(195)" AT 1
     4091       with width 232 down stream-io.
     4092       FORM HEADER
     4093       Line format "X(195)" AT 1 SKIP
     4094       "Продолжение - на следующей странице" AT 60 SKIP
     4095       with FRAME BottomFrame width 232
     4096       PAGE-BOTTOM no-labels no-box.
     4097       run waitfram-show in this-procedure ("Ждите..." ).
     4098       run prn-lib-open-stream  in this-procedure (
     4099                                                   input parParentProc
     4100                                                   ,input 43
     4101                                                   ,input yes
     4102                                                   ,input no
     4103                                                   ).
     4104       run rep/extitle.p (1).
     4105       find first buf1_sheetf no-lock where buf1_sheetf.sheet-num = 1 or buf1_sheetf.sheet-num = 0.
     4106       PUT stream PrnLibStream UNFORMATTED
     4107       ("Дни продажи товара" +
     4108       string( p-start-date, "99/99/9999" ) + " по " + string(p-end-date, "99/99/9999") + ".")
     4109       format "x(110)" SKIP(1).
     4110       PUT stream PrnLibStream UNFORMATTED
     4111       str1 skip
     4112       str2 skip
     4113       str4 skip.
     4114       PUT stream PrnLibStream UNFORMATTED
     4115       p-report-header SKIP(0).
     4116       VIEW STREAM PrnLibStream FRAME BottomFrame .
     4117       FORM with FRAME OutFrame.
     4118       CASE P-sort-method:
     4119         when "code":U then do:
     4120           for each sj-bar-code no-lock
     4121           break
     4122           by sj-bar-code.gds-code
     4123           by sj-bar-code.b-code
     4124           by sj-bar-code.in-sale-date-to
     4125           :
     4126             if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     4127             if first-of(sj-bar-code.gds-code) then do:
     4128               assign
     4129               f-in-sale-days = 0
     4130               .
     4131               find first buf_goods no-lock where
     4132                         buf_goods.gds-code = sj-bar-code.gds-code.
     4133               find first buf_clients no-lock where
     4134                         buf_Clients.obj-type = buf_goods.prod-type
     4135                     AND buf_Clients.obj-code = buf_goods.prod-code no-error .
     4136               assign
     4137               f-prod-name = buf_clients.obj-name
     4138               f-gds-name = buf_goods.gds-name
     4139               f-grp-name = buf_goods.grp-name
     4140               f-artic = buf_goods.artic
     4141               .
     4142             end.
     4143             if first-of (sj-bar-code.b-code) then do:
     4144               find first buf_gds-prt no-lock where
     4145                         buf_gds-prt.node-code = sj-bar-code.node-code.
     4146               assign
     4147               f-prt-name = buf_gds-prt.f-name
     4148               .
     4149               assign
     4150               f-in-sale-days = 0
     4151               .
     4152             end.
     4153             assign
     4154             f-in-sale-days = f-in-sale-days +
     4155                              if sj-bar-code.is-qnty
     4156                              then (sj-bar-code.in-sale-date-to - sj-bar-code.in-sale-date-from + 1)
     4157                              else 0
     4158             .
     4159             if last-of(sj-bar-code.b-code) then do:
     4160               if f-in-sale-days > 0 or p-zero then
     4161               display stream PrnLibStream
     4162               sj-bar-code.b-code @ sj-goods.b-code
     4163               f-artic  @ sj-goods.artic
     4164               f-gds-name
     4165               f-prt-name
     4166               f-prod-name
     4167               f-grp-name
     4168               f-in-sale-days
     4169               with frame OutFrame.
     4170               DOWN STREAM PrnLibStream
     4171               1 with FRAME OutFrame .
     4172               if Make-Excel then  put   stream ForExcel unformatted
     4173               sj-bar-code.b-code CHR(9)
     4174               (chr(1) + f-artic)            CHR(9)
     4175               f-gds-name         CHR(9)
     4176               f-prt-name         CHR(9)
     4177               f-prod-name        CHR(9)
     4178               f-grp-name         CHR(9)
     4179               f-in-sale-days
     4180               skip.
     4181               assign
     4182               ii-excel = ii-excel + 1
     4183               .
     4184             end.
     4185           end.
     4186         end.
     4187         when "Artic":U then do:
     4188           for each sj-goods no-lock
     4189           break
     4190           by sj-goods.artic
     4191           by sj-goods.prod-type
     4192           by sj-goods.prod-code
     4193           by sj-goods.b-code
     4194           :
     4195             if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end  .
     4196             if first-of(sj-goods.prod-code) then do:
     4197               find first buf_goods no-lock where
     4198                         buf_goods.gds-code = sj-goods.gds-code.
     4199               find first buf_clients no-lock where
     4200                         buf_Clients.obj-type = buf_goods.prod-type
     4201                     AND buf_Clients.obj-code = buf_goods.prod-code no-error .
     4202               assign
     4203               f-prod-name = buf_clients.obj-name
     4204               f-gds-name = buf_goods.gds-name
     4205               f-grp-name = buf_goods.grp-name
     4206               .
     4207             end.
     4208             find first buf_gds-prt no-lock where
     4209                       buf_gds-prt.node-code = sj-goods.node-code.
     4210             assign
     4211             f-prt-name = buf_gds-prt.f-name
     4212             .
     4213             if sj-goods.in-sale-days > 0 or p-zero then
     4214             display stream PrnLibStream
     4215             sj-goods.b-code
     4216             sj-goods.artic
     4217             f-gds-name
     4218             f-prt-name
     4219             f-prod-name
     4220             f-grp-name
     4221             sj-goods.in-sale-days @ f-in-sale-days
     4222             with frame OutFrame.
     4223             DOWN STREAM PrnLibStream
     4224             1 with FRAME OutFrame .
     4225             if Make-Excel then  put   stream ForExcel unformatted
     4226             sj-goods.b-code         CHR(9)
     4227             (chr(1) + sj-goods.artic)          CHR(9)
     4228             f-gds-name              CHR(9)
     4229             f-prt-name              CHR(9)
     4230             f-prod-name             CHR(9)
     4231             f-grp-name              CHR(9)
     4232             sj-goods.in-sale-days
     4233             skip.
     4234               assign
     4235               ii-excel = ii-excel + 1
     4236               .
     4237           end.
     4238         end.
     4239         when "name":U then do:
     4240           for each sj-goods no-lock
     4241           break
     4242           by sj-goods.gds-name
     4243           by sj-goods.gds-code
     4244           by sj-goods.b-code
     4245           :
     4246             if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end   .
     4247             if first-of(sj-goods.gds-code) then do:
     4248               find first buf_goods no-lock where
     4249                         buf_goods.gds-code = sj-goods.gds-code.
     4250               find first buf_clients no-lock where
     4251                         buf_Clients.obj-type = buf_goods.prod-type
     4252                     AND buf_Clients.obj-code = buf_goods.prod-code no-error .
     4253               assign
     4254               f-prod-name = buf_clients.obj-name
     4255               f-gds-name = buf_goods.gds-name
     4256               f-grp-name = buf_goods.grp-name
     4257               .
     4258             end.
     4259             find first buf_gds-prt no-lock where
     4260                       buf_gds-prt.node-code = sj-goods.node-code.
     4261             assign
     4262             f-prt-name = buf_gds-prt.f-name
     4263             .
     4264             if sj-goods.in-sale-days > 0 or p-zero then
     4265             display  stream PrnLibStream
     4266             sj-goods.b-code
     4267             sj-goods.artic
     4268             f-gds-name
     4269             f-prt-name
     4270             f-prod-name
     4271             f-grp-name
     4272             sj-goods.in-sale-days @ f-in-sale-days
     4273             with frame OutFrame.
     4274             DOWN STREAM PrnLibStream
     4275             1 with FRAME OutFrame .
     4276             if Make-Excel then  put   stream ForExcel unformatted
     4277             sj-goods.b-code         CHR(9)
     4278             (chr(1) + sj-goods.artic)          CHR(9)
     4279             f-gds-name              CHR(9)
     4280             f-prt-name              CHR(9)
     4281             f-prod-name             CHR(9)
     4282             f-grp-name              CHR(9)
     4283             sj-goods.in-sale-days
     4284             skip.
     4285             assign
     4286             ii-excel = ii-excel + 1
     4287             .
     4288           end.
     4289         end.
     4290       END CASE.
     4291       HIDE STREAM PrnLibStream FRAME BottomFrame .
     4292       OUTPUT STREAM PrnLibStream CLOSE.
     4293       if Make-Excel then output stream ForExcel close.
     4294       run waitfram-hide in this-procedure .
     4295       run prn-lib-prn-file in this-procedure (
     4296                                                 input parParentProc
     4297                                                 ,input 8
     4298                                                 ).
     4299     end.
     4300   end procedure.
     4301   procedure write-temp-prt-to-sj :
     4302   define input parameter p-in-sale-date-to as date no-undo .
     4303   define input parameter p-in-sale-date-from as date no-undo .
     4304   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     4305   define input parameter p-unit-cli like ub.goods.unit-base no-undo .
     4306   define variable v-was-sj as logical no-undo .
     4307   define buffer buf_temp-prt-obj for temp-prt-obj.
     4308   define buffer buf_sj-bar-code for sj-bar-code.
     4309   define buffer buf_bar-code for ub.bar-code.
     4310     do
     4311     on error undo, return error
     4312     :
     4313       for each buf_temp-prt-obj:
     4314         if buf_temp-prt-obj.fact-qnty > 0 or p-zero then do:
     4315           find first buf_sj-bar-code where
     4316                     buf_sj-bar-code.gds-code = p-gds-code
     4317                 AND  buf_sj-bar-code.node-code = buf_temp-prt-obj.prt-code
     4318                 AND  buf_sj-bar-code.in-sale-date-to <= p-in-sale-date-to
     4319                 no-error .
     4320           if not available buf_sj-bar-code then do:
     4321             find first buf_bar-code no-lock
     4322               where buf_bar-code.gds-code  = p-gds-code
     4323                 and buf_bar-code.node-code = buf_temp-prt-obj.prt-code
     4324                 and buf_bar-code.part-code = "":U
     4325                 and buf_bar-code.in-code   = "":U
     4326                 and buf_bar-code.unit-cli  = p-unit-cli
     4327               .
     4328             create buf_sj-bar-code.
     4329             assign
     4330             buf_sj-bar-code.gds-code = p-gds-code
     4331             buf_sj-bar-code.node-code = buf_temp-prt-obj.prt-code
     4332             buf_sj-bar-code.b-code   = (if avail buf_bar-code then buf_bar-code.b-code else buf_sj-bar-code.gds-code)
     4333             buf_sj-bar-code.in-sale-date-to   = p-in-sale-date-to
     4334             buf_sj-bar-code.in-sale-date-from = p-in-sale-date-to
     4335             .
     4336           end.
     4337           else do:
     4338             assign
     4339             v-was-sj = yes
     4340             .
     4341           end.
     4342           assign
     4343           buf_sj-bar-code.is-qnty =  if avail buf_bar-code or v-was-sj
     4344                                     then buf_sj-bar-code.is-qnty OR (if buf_temp-prt-obj.fact-qnty > 0
     4345                                                                     then yes
     4346                                                                     else no)
     4347                                     else ?
     4348           buf_sj-bar-code.in-sale-date-from = (if buf_temp-prt-obj.fact-qnty > 0 and buf_sj-bar-code.in-sale-date-from >= p-in-sale-date-from
     4349                                                then p-in-sale-date-from
     4350                                                else buf_sj-bar-code.in-sale-date-from)
     4351           .
     4352         end.
     4353       end.
     4354     end.
     4355   end procedure.
     4356   procedure write-temp-prt-in-sale-to-sj :
     4357   define input parameter p-in-sale-date as date no-undo .
     4358   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     4359   define input parameter p-cr       as integer no-undo .
     4360   define input parameter p-unit-cli like ub.goods.unit-base no-undo .
     4361   define variable v-was-sj as logical no-undo .
     4362   define buffer buf_temp-prt-in-sale for temp-prt-in-sale.
     4363   define buffer buf_sj-bar-code for sj-bar-code.
     4364   define buffer buf_bar-code for ub.bar-code.
     4365     do
     4366     on error undo, return error
     4367     :
     4368       for each buf_temp-prt-in-sale where
     4369              buf_temp-prt-in-sale.gds-code = p-gds-code
     4370          AND buf_temp-prt-in-sale.cr < (p-cr + 1)
     4371              :
     4372         if buf_temp-prt-in-sale.evening and p-in-sale-date < p-end-date then do:
     4373           find first buf_sj-bar-code where
     4374                     buf_sj-bar-code.gds-code = p-gds-code
     4375                 AND  buf_sj-bar-code.node-code = buf_temp-prt-in-sale.prt-code
     4376                 AND  buf_sj-bar-code.in-sale-date-to > p-in-sale-date
     4377                 no-error .
     4378         end.
     4379         else do:
     4380           find first buf_sj-bar-code where
     4381                     buf_sj-bar-code.gds-code = p-gds-code
     4382                 AND  buf_sj-bar-code.node-code = buf_temp-prt-in-sale.prt-code
     4383                 AND  buf_sj-bar-code.in-sale-date-to = p-in-sale-date
     4384                 no-error .
     4385         end.
     4386         assign
     4387         v-was-sj = no.
     4388         if not available buf_sj-bar-code then do:
     4389           find first buf_bar-code no-lock
     4390             where buf_bar-code.gds-code  = p-gds-code
     4391               and buf_bar-code.node-code = buf_temp-prt-in-sale.prt-code
     4392               and buf_bar-code.part-code = "":U
     4393               and buf_bar-code.in-code   = "":U
     4394               and buf_bar-code.unit-cli  = p-unit-cli
     4395             .
     4396           create buf_sj-bar-code.
     4397           assign
     4398           buf_sj-bar-code.gds-code = p-gds-code
     4399           buf_sj-bar-code.node-code = buf_temp-prt-in-sale.prt-code
     4400           buf_sj-bar-code.b-code   = (if avail buf_bar-code then buf_bar-code.b-code else buf_sj-bar-code.gds-code)
     4401           buf_sj-bar-code.in-sale-date-to = if buf_temp-prt-in-sale.evening
     4402                                             then (p-in-sale-date + 1)
     4403                                             else  p-in-sale-date
     4404           .
     4405         end.
     4406         else do:
     4407           assign
     4408           v-was-sj = yes
     4409           .
     4410         end.
     4411         assign
     4412         buf_sj-bar-code.in-sale-date-from = if buf_sj-bar-code.in-sale-date-from = ?
     4413                                             then p-in-sale-date
     4414                                             else minimum(p-in-sale-date, buf_sj-bar-code.in-sale-date-from)
     4415         buf_sj-bar-code.is-qnty =  if avail buf_bar-code or v-was-sj then
     4416                                     buf_sj-bar-code.is-qnty OR TRUE
     4417                                     else ?
     4418         .
     4419       end.
     4420     end.
     4421   end procedure.
     4422   procedure decrement-prt-obj :
     4423   define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4424   define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4425   define input parameter p-gds-code           like ub.goods.gds-code    no-undo .
     4426   define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     4427   define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     4428   define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     4429   define input parameter p-unit-cli           like ub.goods.unit-base   no-undo .
     4430   define input parameter p-start-date-order   as decimal no-undo .
     4431   define input parameter p-end-date-order   as decimal no-undo .
     4432   define variable cr0 as integer no-undo .
     4433   define variable v-fact-date as date no-undo .
     4434   define variable v-evening as logical no-undo .
     4435   define variable v-before as logical no-undo .
     4436   define variable v-first-processing as logical no-undo .
     4437   define variable v-obj as character no-undo .
     4438   define variable v-not-found-trn-doc as logical no-undo init yes.
     4439   define buffer buf_trn-doc for ub.trn-doc.
     4440   define buffer buf_doc-line for ub.doc-line.
     4441   define buffer buf_gds-dtl for ub.gds-dtl.
     4442   define buffer buf_temp-prt-obj for temp-prt-obj.
     4443   define buffer buf_temp-prt-in-sale for temp-prt-in-sale.
     4444   define buffer buf_sj-bar-code for sj-bar-code.
     4445     do
     4446     on error undo, return error
     4447     :
     4448        assign
     4449        v-obj = p-obj-type + string(p-obj-code)
     4450        .
     4451       _buf_doc-line:
     4452       for each buf_doc-line no-lock
     4453         where buf_doc-line.obj-type   = p-obj-type
     4454           and buf_doc-line.obj-code   = p-obj-code
     4455           and buf_doc-line.artic      = p-artic
     4456           and buf_doc-line.prod-type  = p-prod-type
     4457           and buf_doc-line.prod-code  = p-prod-code
     4458           and buf_doc-line.status_    = 'факт':U
     4459           and buf_doc-line.fact-order >= p-start-date-order
     4460           and buf_doc-line.fact-order <= p-end-date-order
     4461       by buf_doc-line.fact-order descending
     4462       on error undo, return error
     4463       :
     4464         assign
     4465         v-not-found-trn-doc = no
     4466         .
     4467         find first buf_trn-doc no-lock
     4468           where buf_trn-doc.doc-code = buf_doc-line.doc-code
     4469           no-error .
     4470         if not available buf_trn-doc then do:
     4471           message
     4472             vss-workfile vss-revision vss-description skip
     4473             "Ошибка при поиске документа" skip
     4474             "Документ" buf_doc-line.doc-code skip
     4475             "Объект" p-obj-type p-obj-code skip
     4476             "Артикул" p-artic p-prod-type p-prod-code skip
     4477             "p-fact-order" buf_doc-line.fact-order skip
     4478             view-as alert-box error .
     4479           undo, return error .
     4480         end.
     4481         if v-fact-date <> buf_trn-doc.fact-date
     4482         and v-fact-date <> ?
     4483         and cr0 > 0
     4484         then do:
     4485           run write-temp-prt-in-sale-to-sj in this-procedure (
     4486                                                                  input v-fact-date
     4487                                                                 ,input p-gds-code
     4488                                                                 ,input cr0
     4489                                                                 ,input p-unit-cli
     4490                                                                   ).
     4491           assign
     4492           cr0 = 0
     4493           .
     4494         end.
     4495         _buf_gds-dtl:
     4496         for each buf_gds-dtl no-lock
     4497           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     4498             and buf_gds-dtl.artic     = p-artic
     4499             and buf_gds-dtl.prod-type = p-prod-type
     4500             and buf_gds-dtl.prod-code = p-prod-code
     4501         on error undo, return error
     4502         :
     4503           if buf_trn-doc.fact-date < p-end-date then do:
     4504             find first buf_sj-bar-code no-lock where
     4505                       buf_sj-bar-code.gds-code = p-gds-code
     4506                   and buf_sj-bar-code.node-code = buf_gds-dtl.prt-code
     4507                   AND buf_sj-bar-code.in-sale-date-to >= buf_trn-doc.fact-date no-error .
     4508             if available buf_sj-bar-code and
     4509             buf_sj-bar-code.in-sale-date-from <= buf_trn-doc.fact-date then next _buf_gds-dtl.
     4510           end.
     4511           define variable v-term-node as integer   no-undo .
     4512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     4513     (input  buf_gds-dtl.prt-code
     4514     ,output v-term-node
     4515     )  .
     4516           run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     4517             (input v-term-node
     4518             ,buffer buf_temp-prt-obj
     4519             ) .
     4520           if buf_temp-prt-obj.is-term <> true then do:
     4521             message
     4522               vss-workfile vss-revision vss-description skip
     4523               "Внутренняя ошибка при обработке документа" skip
     4524               "Документ ссылается на нетерминальный признак" skip
     4525               "Документ" buf_gds-dtl.doc-code skip
     4526               "Артикул" buf_gds-dtl.artic buf_gds-dtl.prod-type buf_gds-dtl.prod-code skip
     4527               "Признак" buf_gds-dtl.prt-code skip
     4528               view-as alert-box error .
     4529             undo, return error .
     4530           end.
     4531           assign
     4532           v-before = yes
     4533           .
     4534           if buf_temp-prt-obj.fact-qnty > 0 then do:   find first buf_temp-prt-in-sale where             buf_temp-prt-in-sale.gds-code = p-gds-code         AND  buf_temp-prt-in-sale.prt-code = buf_temp-prt-obj.prt-code         AND buf_temp-prt-in-sale.obj    = v-obj         AND buf_temp-prt-in-sale.cr < (cr0  + 1) no-error.   if not available buf_temp-prt-in-sale then do:     assign     v-evening = V-BEFORE        v-first-processing = yes     .     find first buf_temp-prt-in-sale where               buf_temp-prt-in-sale.cr = (cr0 + 1) use-index icreate no-error.     if not available buf_temp-prt-in-sale then do:         create buf_temp-prt-in-sale.         assign         buf_temp-prt-in-sale.cr = cr0 + 1         cr0 = cr0 + 1         .     end.     else do:       assign       cr0 = cr0 + 1       .     end.   end.   else do:     assign      v-evening = no     v-first-processing = no     .   end.    assign    buf_temp-prt-in-sale.evening  = if v-evening                                   then (buf_temp-prt-obj.fact-qnty > 0)                                   else (if v-first-processing then no else buf_temp-prt-in-sale.evening )   buf_temp-prt-in-sale.gds-code = p-gds-code   buf_temp-prt-in-sale.prt-code = buf_temp-prt-obj.prt-code   buf_temp-prt-in-sale.obj      = v-obj   buf_temp-prt-in-sale.fact-qnty = buf_temp-prt-obj.fact-qnty   .    end .
     4535           case buf_trn-doc.doc-type :
     4536             when 'при':U or
     4537             when 'возврат':U
     4538             then do:
     4539               assign
     4540                 buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
     4541                                            - buf_gds-dtl.fact-qnty
     4542               .
     4543             end.
     4544             when 'рас':U or
     4545             when 'спи':U
     4546             then do:
     4547               assign
     4548                 buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
     4549                                            + buf_gds-dtl.fact-qnty
     4550               .
     4551             end.
     4552             when 'инв':U
     4553             then do:
     4554               assign
     4555                 buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
     4556                                            - buf_gds-dtl.doc-qnty
     4557               .
     4558             end.
     4559             otherwise do:
     4560               message
     4561                 vss-workfile vss-revision vss-description skip
     4562                 "Внутренняя ошибка" skip
     4563                 "Неизвестный тип документа" skip
     4564                 "Документ" buf_trn-doc.doc-code skip
     4565                 "Тип документа" buf_trn-doc.doc-type skip
     4566                 "Объект" p-obj-type p-obj-code skip
     4567                 "Артикул" p-artic p-prod-type p-prod-code skip
     4568                 "fact-order" buf_doc-line.fact-order skip
     4569                 view-as alert-box error .
     4570               undo, return error .
     4571             end.
     4572           end.
     4573           assign
     4574           v-before = no
     4575           v-evening = no
     4576           .
     4577           if buf_temp-prt-obj.fact-qnty > 0 then do:   find first buf_temp-prt-in-sale where             buf_temp-prt-in-sale.gds-code = p-gds-code         AND  buf_temp-prt-in-sale.prt-code = buf_temp-prt-obj.prt-code         AND buf_temp-prt-in-sale.obj    = v-obj         AND buf_temp-prt-in-sale.cr < (cr0  + 1) no-error.   if not available buf_temp-prt-in-sale then do:     assign     v-evening = V-BEFORE        v-first-processing = yes     .     find first buf_temp-prt-in-sale where               buf_temp-prt-in-sale.cr = (cr0 + 1) use-index icreate no-error.     if not available buf_temp-prt-in-sale then do:         create buf_temp-prt-in-sale.         assign         buf_temp-prt-in-sale.cr = cr0 + 1         cr0 = cr0 + 1         .     end.     else do:       assign       cr0 = cr0 + 1       .     end.   end.   else do:     assign      v-evening = no     v-first-processing = no     .   end.    assign    buf_temp-prt-in-sale.evening  = if v-evening                                   then (buf_temp-prt-obj.fact-qnty > 0)                                   else (if v-first-processing then no else buf_temp-prt-in-sale.evening )   buf_temp-prt-in-sale.gds-code = p-gds-code   buf_temp-prt-in-sale.prt-code = buf_temp-prt-obj.prt-code   buf_temp-prt-in-sale.obj      = v-obj   buf_temp-prt-in-sale.fact-qnty = buf_temp-prt-obj.fact-qnty   .    end .
     4578         end.
     4579         assign
     4580         v-fact-date = buf_trn-doc.fact-date.
     4581       end.
     4582       if cr0 > 0
     4583       then do:
     4584         run write-temp-prt-in-sale-to-sj in this-procedure (
     4585                                                                input v-fact-date
     4586                                                               ,input p-gds-code
     4587                                                               ,input cr0
     4588                                                               ,input p-unit-cli
     4589                                                                 ).
     4590       end.
     4591       run write-temp-prt-to-sj  in this-procedure (
     4592                                                       input p-end-date
     4593                                                       ,input p-start-date
     4594                                                       ,input p-gds-code
     4595                                                       ,input p-unit-cli).
     4596     end.
     4597   end procedure.
