      996   function diff-list returns character (
      997     input parfirst-list  as character,
      998     input parsecond-list as character,
      999     input pardelim       as character).
     1000     if pardelim = ""
     1001     or pardelim = ?
     1002     then do:
     1003       assign
     1004         pardelim = ","
     1005       .
     1006     end.
     1007     def var ind as integer no-undo .
     1008     def var v-elem as character no-undo .
     1009     def var v-result-list as character no-undo init "".
     1010     def var v-num-parfirst-list as integer no-undo .
     1011     assign
     1012       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1013     .
     1014     do ind = 1 to v-num-parfirst-list
     1015     :
     1016       assign
     1017         v-elem = entry(ind, parfirst-list, pardelim)
     1018       .
     1019       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1020         assign
     1021           v-result-list = v-result-list
     1022                         + (if v-result-list > "" then pardelim else "")
     1023                         + v-elem
     1024         .
     1025       end.
     1026     end.
     1027     return v-result-list .
     1028   end function.
     1029   function add-list returns character (
     1030    input parfirst-list  as character,
     1031    input parsecond-list as character,
     1032    input pardelim       as character).
     1033     if pardelim = ""
     1034     or pardelim = ?
     1035     then do:
     1036       assign
     1037         pardelim = ","
     1038       .
     1039     end.
     1040     def var ind as integer no-undo .
     1041     def var v-elem as character no-undo .
     1042     def var v-result-list as character no-undo init "".
     1043     def var v-num-parfirst-list as integer no-undo .
     1044     assign
     1045       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1046     .
     1047     do ind = 1 to v-num-parfirst-list
     1048     :
     1049       assign
     1050         v-elem = entry(ind, parfirst-list, pardelim)
     1051       .
     1052       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1053         assign
     1054           v-result-list = v-result-list
     1055                         + (if v-result-list > "" then pardelim else "")
     1056                         + v-elem
     1057         .
     1058       end.
     1059     end.
     1060     def var v-num-parsecond-list as integer no-undo .
     1061     assign
     1062       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1063     .
     1064     do ind = 1 to v-num-parsecond-list
     1065     :
     1066       assign
     1067         v-elem = entry(ind, parsecond-list, pardelim)
     1068       .
     1069       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1070         assign
     1071           v-result-list = v-result-list
     1072                         + (if v-result-list > "" then pardelim else "")
     1073                         + v-elem
     1074         .
     1075       end.
     1076     end.
     1077     return v-result-list .
     1078   end function.
     1079   function cross-list returns character (
     1080    input parfirst-list  as character,
     1081    input parsecond-list as character,
     1082    input pardelim       as character).
     1083     if pardelim = ""
     1084     or pardelim = ?
     1085     then do:
     1086       assign
     1087         pardelim = ","
     1088       .
     1089     end.
     1090     def var ind as integer no-undo .
     1091     def var v-elem as character no-undo .
     1092     def var v-result-list as character no-undo init "".
     1093     def var v-num-parfirst-list as integer no-undo .
     1094     assign
     1095       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1096     .
     1097     do ind = 1 to v-num-parfirst-list
     1098     :
     1099       assign
     1100         v-elem = entry(ind, parfirst-list, pardelim)
     1101       .
     1102       if lookup(v-elem, v-result-list, pardelim) = 0
     1103       and lookup(v-elem, parsecond-list, pardelim) > 0
     1104       then do:
     1105         assign
     1106           v-result-list = v-result-list
     1107                         + (if v-result-list > "" then pardelim else "")
     1108                         + v-elem
     1109         .
     1110       end.
     1111     end.
     1112     return v-result-list .
     1113   end function.
     1114   function radio-label returns character (
     1115    input par-rs-value  as character,
     1116    input par-rs-radio-buttons as character)
     1117    .
     1118    DEFINE variable v-result-label as character no-undo.
     1119    assign
     1120    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1121                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1122                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1123                             ), par-rs-radio-buttons
     1124                           )
     1125    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1126    .
     1127   return v-result-label.
     1128   end function.
     1129   function m-radio-label returns character (
     1130    input par-rs-value  as character,
     1131    input par-rs-radio-buttons as character,
     1132    input par-delim as character
     1133    )
     1134    .
     1135    DEFINE variable v-result-label as character no-undo.
     1136    assign
     1137    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1138                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1139                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1140                             ), par-rs-radio-buttons, par-delim
     1141                           )
     1142    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1143    .
     1144   return v-result-label.
     1145   end function.
     1146   FUNCTION mixlist returns character
     1147   (
     1148    input parfirst-list  as character
     1149    ,input parsecond-list as character
     1150    ,input pardelim       as character
     1151    ,input pardelim-result as character ) :
     1152     if pardelim = ""
     1153     or pardelim = ?
     1154     then do:
     1155       assign
     1156         pardelim = ","
     1157       .
     1158     end.
     1159     def var ind as integer no-undo .
     1160     def var v-elem1 as character no-undo .
     1161     def var v-elem2 as character no-undo .
     1162     def var v-result-list as character no-undo init "".
     1163     do ind = 1 to num-entries(parfirst-list, pardelim)
     1164     :
     1165       assign
     1166         v-elem1 = entry(ind, parfirst-list, pardelim)
     1167         v-elem2 = entry(ind, parsecond-list, pardelim)
     1168       .
     1169         assign
     1170           v-result-list = v-result-list
     1171                         + (if v-result-list > "" then pardelim-result else "")
     1172                         + v-elem1 + pardelim-result + v-elem2
     1173         .
     1174     end.
     1175     return v-result-list .
     1176   END FUNCTION.
     1177   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1178     if num-entries(string(p-dec), '.') = 2
     1179       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1180       else return( string(p-dec)) .
     1181   end function.
     1182   function format-point-to-comma returns char (input orig as char ) .
     1183   define variable rtext as character no-undo .
     1184   define variable strt as integer no-undo .
     1185   define variable leng as integer no-undo .
     1186   assign rtext = orig .
     1187   repeat:
     1188     strt =  index(rtext,'.').
     1189     if strt = 0 then leave.
     1190     leng = 1.
     1191     substring(rtext,strt,leng,"character") = v-delim .
     1192   end.
     1193   return rtext.
     1194   end function.
     1195   function format-excel-text returns char ( input start-text as char ) :
     1196   def var  i    as int no-undo.
     1197   def var  ch   as char no-undo.
     1198   def var  n    as int no-undo.
     1199   def var  ipos as int no-undo.
     1200     n = num-entries(trim(start-text), chr(10)) - 1 .
     1201     do i = 1 to n :
     1202       ipos = index( start-text, chr(10)).
     1203       if ipos > 0 then
     1204         substr( start-text, ipos, 1 ) = ' '.
     1205     end.
     1206     n = num-entries(trim(start-text), chr(13)) - 1 .
     1207     do i = 1 to n :
     1208       ipos = index( start-text, chr(13)).
     1209       if ipos > 0 then
     1210         substr( start-text, ipos, 1 ) = ' '.
     1211     end.
     1212     if index( start-text, '"' ) = 0 then
     1213       start-text =  '="'   + trim( start-text) + '"'   .
     1214       else do:
     1215         n = num-entries(trim(start-text), '"') - 1.
     1216         do i = 1 to n :
     1217           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1218         end.
     1219         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1220         start-text = '="'  + ch  + '"' .
     1221       end.
     1222     return start-text.
     1223   end.
     1224   function excel-sum returns char (input p-dec as decimal ).
     1225     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1226   end function.
     1227   function excel-qnty returns char (input p-dec as decimal ).
     1228     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1229   end function.
     1230   function format-excel-text-macr returns char ( input start-text as char ) :
     1231   def var  i    as int no-undo.
     1232   def var  ch   as char no-undo.
     1233   def var  n    as int no-undo.
     1234   def var  ipos as int no-undo.
     1235     n = num-entries(trim(start-text), chr(10)) - 1 .
     1236     do i = 1 to n :
     1237       ipos = index( start-text, chr(10)).
     1238       if ipos > 0 then
     1239         substring( start-text, ipos , 1 ) = ' '.
     1240     end.
     1241     n = num-entries(trim(start-text), chr(13)) - 1 .
     1242     do i = 1 to n :
     1243       ipos = index( start-text, chr(13)).
     1244       if ipos > 0 then
     1245         substring( start-text, ipos, 1 ) = ' '.
     1246     end.
     1247     if index( start-text, '"' ) = 0 then
     1248       start-text =  '"'   + trim( start-text) + '"'   .
     1249       else do:
     1250         n = num-entries(trim(start-text), '"') - 1.
     1251         do i = 1 to n :
     1252           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1253         end.
     1254         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1255         start-text = '"'  + ch  + '"' .
     1256       end.
     1257     n = num-entries(trim(start-text), chr(10)) - 1 .
     1258     do i = 1 to n :
     1259       ipos = index( start-text, chr(10)).
     1260       if ipos > 0 then
     1261         substring( start-text, ipos , 1 ) = ' '.
     1262     end.
     1263       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1264     return start-text.
     1265   end.
     1266   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1267   FUNCTION IsEngFrm RETURNS Logical  ( INPUT p-str as char) :
     1268   DEFINE VARIABLE ii as integer no-undo .
     1269   DEFINE VARIABLE v-int as integer no-undo .
     1270   DEFINE VARIABLE v-char as character no-undo .
     1271   DEFINE VARIABLE v-dec as decimal no-undo .
     1272   if p-str begins '0':U then return yes.
     1273   if index(p-str, "E":U ) = 0 then return no.
     1274   if index(p-str, "+":U ) = 0
     1275   AND index(p-str, "-":U ) = 0 then return no.
     1276   assign
     1277   v-dec = decimal(entry(1, p-str, "E":U))
     1278   no-error .
     1279   if error-status:error then return no.
     1280   assign
     1281   v-int = integer(entry(2, p-str, "E":U))
     1282   no-error .
     1283   if error-status:error then return no.
     1284   assign
     1285   v-char = entry(2, p-str, "E":U)
     1286   .
     1287   if (substr(v-char, 1, 1) = "+":U and index(v-char, "-":U) = 0 )
     1288   OR
     1289   (substr(v-char, 1, 1) = "-":U and index(v-char, "+":U) = 0 )
     1290   then return yes.
     1291   END FUNCTION.
     1292   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   define variable v-waitfram-action01         as character   no-undo .
     1294   define variable v-waitfram-action02         as character   no-undo .
     1295   define variable v-waitfram-action03         as character   no-undo .
     1296   define variable mWaitFramTextBeg            as character   no-undo.
     1297   define variable mWaitFramTextEnd            as character   no-undo.
     1298   define variable mWaitFramView               as logical     no-undo.
     1299   define variable mWaitProcEvent              as logical     no-undo init yes.
     1300   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1301   define variable mWaitFramStop               as logical     no-undo.
     1302   define variable mWaitFramStopUser           as logical     no-undo.
     1303   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1304   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1305   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1306   define button B-WaitFramStop auto-end-key
     1307        label "Стоп"
     1308        size 10 by 1 tooltip "Остоновить процесс".
     1309   define button B-viewProcInfo
     1310        label "Информация"
     1311        size 15 by 1 tooltip "Информация о процесс".
     1312   define frame waitfram
     1313     v-waitfram-action01 format "x(72)" no-label skip
     1314     v-waitfram-action02 format "x(72)" no-label skip
     1315     v-waitfram-action03 format "x(72)" no-label skip
     1316     B-viewProcInfo
     1317     B-WaitFramStop at row 4 col 30
     1318     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1319     .
     1320   define new global shared variable mBatchMode as logical no-undo init ?.
     1321   define variable mFramBachModHandle as handle no-undo.
     1322   mFramBachModHandle = frame waitfram:handle.
     1323   define variable mFameOldVis as logical no-undo.
     1324   define variable mVisCUrentVin as logical no-undo.
     1325   if session:batch-mode
     1326   then
     1327      mBatchMode = yes.
     1328   if mBatchMode = ? then do:
     1329     mVisCUrentVin = current-window:visible.
     1330     mFameOldVis = mFramBachModHandle:visible.
     1331     mFramBachModHandle:visible  = yes.
     1332     mBatchMode = mFramBachModHandle:visible ne yes.
     1333     mFramBachModHandle:visible = mFameOldVis.
     1334     current-window:visible = mVisCUrentVin.
     1335   end.
     1336    if  log-manager:logfile-name ne ?
     1337     then DO:
     1338         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1339         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1340         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1341     end.
     1342   on choose of B-WaitFramStop in frame waitfram
     1343   do:
     1344     mWaitFramStop = yes.
     1345     mWaitFramStopUser = yes.
     1346   end.
     1347   function waitfram-check-timeout returns logical():
     1348      define variable vtime as int64 no-undo.
     1349      if mWaitFramStopTimeOut
     1350      then
     1351         return yes.
     1352      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1353      if     mWaitFramTimeOut ne ?
     1354         and mWaitFramTimeOut ne 0
     1355         and mWaitFramTimeOut lt vtime
     1356      then do:
     1357         mWaitFramStopTimeOut = yes.
     1358      end.
     1359      return mWaitFramStopTimeOut.
     1360   end.
     1361   procedure waitfram-hide :
     1362     if not session:batch-mode
     1363     then do
     1364     on error undo, return error return-value
     1365     :
     1366       pause 0 before-hide .
     1367       if not mBatchMode then
     1368         hide frame waitfram .
     1369     if     not mWaitFramView
     1370        and mWaitProcEvent
     1371     then
     1372       process events .
     1373     end.
     1374   end procedure.
     1375   procedure waitfram-show :
     1376     define input  parameter p-message as character no-undo .
     1377     define variable v-left-margin as integer   no-undo .
     1378     if not session:batch-mode
     1379     then do
     1380     on error undo, return error return-value
     1381     :
     1382       if length(p-message) <= 70 then do:
     1383         assign
     1384           v-left-margin = integer((70 - length(p-message)) / 2)
     1385         .
     1386         assign
     1387           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1388         .
     1389         assign
     1390           v-waitfram-action01 = " "
     1391           v-waitfram-action02 = " "
     1392                                    + fill(" ", v-left-margin)
     1393                                    + p-message
     1394           v-waitfram-action03 = " "
     1395         .
     1396       end.
     1397       else do:
     1398         define variable vRindex1 as integer no-undo.
     1399         define variable vRindex2 as integer no-undo.
     1400         vRindex1 = r-index(p-message," ",70).
     1401         if vRindex1 = 0
     1402         then
     1403            vRindex1 = 70.
     1404         if length(p-message)  <= vRindex1 + 70 then do:
     1405           assign
     1406             v-waitfram-action01 = " "
     1407             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1408             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1409           .
     1410         end.
     1411         else do:
     1412           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1413           if vRindex2 <= vRindex1
     1414           then
     1415              vRindex2 = vRindex1 + 70.
     1416           assign
     1417             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1418             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1419             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1420           .
     1421         end.
     1422       end.
     1423       B-viewProcInfo:visible   in frame waitfram = no.
     1424       B-viewProcInfo:sensitive in frame waitfram = no.
     1425       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1426       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1427       if  (   mWaitFramView
     1428          or  mWaitProcEvent)
     1429          and not mBatchMode
     1430       then
     1431          display
     1432             v-waitfram-action01 skip
     1433             v-waitfram-action02 skip
     1434             v-waitfram-action03 skip
     1435          with frame waitfram .
     1436       if     mWaitFramView
     1437          then do:
     1438             if     mWaitFramInterval ne ?
     1439                and not mBatchMode
     1440             then
     1441                wait-for go of frame waitfram pause mWaitFramInterval.
     1442          end.
     1443          else
     1444             if     mWaitProcEvent
     1445                and not mBatchMode
     1446             then
     1447                process events .
     1448     end.
     1449   end procedure.
     1450      procedure waitfram-show-this:
     1451         define input  parameter iInterval as int64 no-undo.
     1452         define variable vtime as int64 no-undo.
     1453         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1454         mWaitFramInterval = iInterval.
     1455         run waitfram-show (substitute("&1&2 &3&4" ,
     1456                                       mWaitFramTextBeg ,
     1457                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1458                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1459                                       mWaitFramTextEnd
     1460                                      )
     1461                           ).
     1462      end.
     1463      procedure WaitFramRunPause:
     1464         define input  parameter iInterval as dec no-undo.
     1465         define variable vStart  as datetime-tz no-undo.
     1466         define variable vend    as datetime-tz no-undo.
     1467         define variable vint as int64 no-undo.
     1468         define variable vOk as logical no-undo.
     1469         vStart = now.
     1470         vend   = vStart.
     1471         publish "WaitFramPause" (iInterval,output vOk).
     1472         vend   =  now.
     1473         vint = vend - vStart.
     1474         vint = iInterval - vint / 1000.
     1475         if     not mWaitFramStop
     1476            and (   vint > 0
     1477                 or (    not vOk
     1478                     and iInterval eq ?
     1479                     )
     1480                 )
     1481         then
     1482            run waitfram-show-this (iInterval).
     1483         vend   =  now.
     1484         vint = vend - vStart.
     1485         vint = iInterval - vint / 1000.
     1486         if     not mWaitFramStop
     1487            and vint > 0
     1488         then do:
     1489            run gbl/pause.p (vint * 1000).
     1490         end.
     1491         if iInterval ne ?
     1492         then
     1493            publish "WaitFramStop".
     1494         waitfram-check-timeout().
     1495      end.
     1496      procedure WaitFramWaitFor:
     1497         define input  parameter iInterval as dec no-undo.
     1498         assign
     1499            mWaitFramStartProc   = now
     1500            mWaitFramStopUser    = no
     1501            mWaitFramStopTimeOut = no
     1502         .
     1503         block-wait:
     1504         do while not mWaitFramStop:
     1505            run WaitFramRunPause (iInterval).
     1506            if  waitfram-check-timeout()
     1507            then do:
     1508               leave block-wait.
     1509            end.
     1510         end.
     1511         run waitfram-hide.
     1512      end.
     1513   procedure waitfram-join :
     1514     define input  parameter p-line-1  as character no-undo .
     1515     define input  parameter p-line-2  as character no-undo .
     1516     define input  parameter p-line-3  as character no-undo .
     1517     define output parameter p-message as character no-undo .
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       assign
     1522         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1523                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1524                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1525       .
     1526     end.
     1527   end procedure.
     1528   function waitfram-join-function returns character
     1529     (input p-line-1 as character
     1530     ,input p-line-2 as character
     1531     ,input p-line-3 as character
     1532     ).
     1533     define variable v-message as character no-undo .
     1534     run waitfram-join in this-procedure
     1535       (input  p-line-1
     1536       ,input  p-line-2
     1537       ,input  p-line-3
     1538       ,output v-message
     1539       ) .
     1540     return v-message .
     1541   end function .
     1542   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1543   procedure factord :
     1544     define input  parameter p-fact-date            as date    no-undo .
     1545     define input  parameter p-fact-time            as integer no-undo .
     1546     define input  parameter p-fact-num             as integer no-undo .
     1547     define input  parameter p-shift-date           as date    no-undo .
     1548     define input  parameter p-shift-num            as integer no-undo .
     1549     define input  parameter p-shift-on             as logical no-undo .
     1550     define output parameter p-fact-order           as decimal no-undo .
     1551     define output parameter p-shift-end-fact-order as decimal no-undo .
     1552     define output parameter p-day-end-fact-order   as decimal no-undo .
     1553     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1554     if p-fact-date = ?
     1555     then do:
     1556       return error "Не указана фактическая дата" .
     1557     end.
     1558     define variable v-fact-date-num as integer no-undo .
     1559     assign
     1560       v-fact-date-num = integer(p-fact-date)
     1561     .
     1562     if p-fact-num = ?
     1563     or p-fact-num = 0
     1564     then do:
     1565       return error "Не задан p-fact-num " + string(p-fact-num) .
     1566     end.
     1567     if p-fact-num < 0
     1568     then do:
     1569       return error "Отрицательный fact-num " + string(p-fact-num) .
     1570     end.
     1571     if p-fact-num >= 100000000
     1572     then do:
     1573       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1574     end.
     1575     if p-shift-on = true
     1576     then do:
     1577       if p-shift-date = ?
     1578       then do:
     1579         return error "Не задана дата смены" .
     1580       end.
     1581       if p-shift-num = ?
     1582       or p-shift-num = 0
     1583       then do:
     1584         return error "Не задан номер смены" .
     1585       end.
     1586     end.
     1587     else do:
     1588       assign
     1589         p-shift-date = p-fact-date
     1590         p-shift-num  = 24
     1591       .
     1592     end.
     1593     define variable v-shift-offset as integer no-undo .
     1594     if p-shift-date = p-fact-date
     1595     then do:
     1596       assign
     1597         v-shift-offset = 1
     1598       .
     1599     end.
     1600     if p-shift-date < p-fact-date
     1601     then do:
     1602       assign
     1603         v-shift-offset = 0
     1604       .
     1605     end.
     1606     if p-shift-date > p-fact-date
     1607     then do:
     1608       message
     1609         vss-workfile vss-revision vss-description skip
     1610         "Неправильная дата закрытия смены" skip
     1611         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1612         view-as alert-box error .
     1613       undo, return error
     1614         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1615           ,string(p-fact-date, '99/99/9999':U)
     1616           ,string(p-shift-date, '99/99/9999':U)
     1617           )
     1618       .
     1619     end.
     1620     if p-shift-num < 1
     1621     or p-shift-num > 24
     1622     then do:
     1623       message
     1624         vss-workfile vss-revision vss-description skip
     1625         "Неправильный номер смены" skip
     1626         "p-shift-num" p-shift-num skip
     1627         view-as alert-box error .
     1628       undo, return error return-value .
     1629     end.
     1630     assign
     1631       p-fact-order           = v-fact-date-num
     1632                              + v-shift-offset * 0.5
     1633                              + p-shift-num    * 0.02 - 0.01
     1634                              + p-fact-num     * 0.0000000001
     1635       p-shift-end-fact-order = v-fact-date-num
     1636                              + v-shift-offset * 0.5
     1637                              + p-shift-num    * 0.02
     1638       p-day-end-fact-order   = v-fact-date-num
     1639                              + 0.99
     1640     .
     1641     if p-fact-order           <= v-fact-date-num
     1642     or p-shift-end-fact-order <= v-fact-date-num
     1643     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1644     or p-shift-end-fact-order >= p-day-end-fact-order
     1645     then do:
     1646       message
     1647         vss-workfile vss-revision vss-description skip
     1648         "Внутренняя ошибка при генерации фактического номера" skip
     1649         "p-fact-date"            p-fact-date            skip
     1650         "p-fact-time"            p-fact-time            skip
     1651         "p-fact-num"             p-fact-num             skip
     1652         "p-shift-date"           p-shift-date           skip
     1653         "p-shift-num"            p-shift-num            skip
     1654         "p-shift-on"             p-shift-on             skip
     1655         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1656         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1657         "v-fact-date-num"        v-fact-date-num        skip
     1658         view-as alert-box error .
     1659       undo, return error return-value .
     1660     end.
     1661   end procedure.
     1662   procedure day-begin-fact-order :
     1663     define input  parameter p-fact-date            as date    no-undo .
     1664     define output parameter p-day-begin-fact-order as decimal no-undo .
     1665     do
     1666     on error undo, return error return-value
     1667     :
     1668       if p-fact-date = ?
     1669       then do:
     1670         assign
     1671           p-day-begin-fact-order = 0
     1672         .
     1673       end.
     1674       else do:
     1675         assign
     1676           p-day-begin-fact-order = integer(p-fact-date)
     1677         .
     1678       end.
     1679     end.
     1680   end procedure.
     1681   procedure factord-max-fact-order :
     1682     define output parameter p-max-fact-order as decimal   no-undo .
     1683     do
     1684     on error undo, return error return-value
     1685     :
     1686       run day-begin-fact-order in this-procedure
     1687         (input  date(1, 1, 5000)
     1688         ,output p-max-fact-order
     1689         ) .
     1690     end.
     1691   end procedure.
     1692   procedure factord-cut-archive :
     1693     define input  parameter p-obj-type             as character no-undo .
     1694     define input  parameter p-obj-code             as integer   no-undo .
     1695     define input  parameter p-fact-date            as date      no-undo .
     1696     define output parameter p-shift-on             as logical   no-undo .
     1697     define output parameter p-shift-date           as date      no-undo .
     1698     define output parameter p-shift-num            as integer   no-undo .
     1699     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1700     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1701     define variable v-fact-order as decimal   no-undo .
     1702     define buffer buf_shift-obj for ub.shift-obj .
     1703     do
     1704     on error undo, return error return-value
     1705     :
     1706   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1708     (input  p-obj-type
     1709     ,input  p-obj-code
     1710     ,input  'shift-on=request'
     1711     ,output p-shift-on
     1712     ) no-error .
     1713       if error-status :error
     1714       then do:
     1715         message
     1716           vss-workfile vss-revision vss-description skip
     1717           "Ошибка при определении атрибута объекта" skip
     1718           "Объект" p-obj-type p-obj-code skip
     1719           error-status :get-message(1) skip
     1720           return-value skip
     1721           view-as alert-box error .
     1722         undo, return error return-value .
     1723       end.
     1724       if p-shift-on = false
     1725       then do:
     1726         assign
     1727           p-shift-date               = ?
     1728           p-shift-num                = 0
     1729         .
     1730       end.
     1731       else do:
     1732         find first buf_shift-obj share-lock
     1733           where buf_shift-obj.obj-type   = p-obj-type
     1734             and buf_shift-obj.obj-code   = p-obj-code
     1735             and buf_shift-obj.shift-date > p-fact-date
     1736           use-index pi
     1737           no-error .
     1738         if not available buf_shift-obj
     1739         or buf_shift-obj.status_ <> 'зкр':U
     1740         then do:
     1741           message
     1742             vss-workfile vss-revision vss-description skip
     1743             "Невозможно вычислить последнюю смену" skip
     1744             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1745             "Объект" p-obj-type p-obj-code skip
     1746             "Дата" p-fact-date skip
     1747             view-as alert-box error .
     1748           undo, return error return-value .
     1749         end.
     1750         find last buf_shift-obj share-lock
     1751           where buf_shift-obj.obj-type = p-obj-type
     1752             and buf_shift-obj.obj-code = p-obj-code
     1753             and buf_shift-obj.shift-date <= p-fact-date
     1754           use-index pi
     1755           no-error .
     1756         if available buf_shift-obj
     1757         then do:
     1758           if  buf_shift-obj.status_ = 'зкр':U
     1759           then do:
     1760             assign
     1761               p-shift-date = buf_shift-obj.shift-date
     1762               p-shift-num  = buf_shift-obj.shift-num
     1763             .
     1764           end.
     1765           else do:
     1766             message
     1767               vss-workfile vss-revision vss-description skip
     1768               "Невозможно вычислить последнюю смену" skip
     1769               "Статус смены отличен от статуса" 'зкр':U skip
     1770               "Объект" p-obj-type p-obj-code skip
     1771               "Дата" p-fact-date skip
     1772               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1773               view-as alert-box error .
     1774             undo, return error return-value .
     1775           end.
     1776         end.
     1777         else do:
     1778           assign
     1779             p-shift-date = p-fact-date - 1
     1780             p-shift-num  = 1
     1781           .
     1782         end.
     1783       end.
     1784       run factord in this-procedure
     1785         (input  p-fact-date
     1786         ,input  1
     1787         ,input  1
     1788         ,input  p-shift-date
     1789         ,input  p-shift-num
     1790         ,input  p-shift-on
     1791         ,output v-fact-order
     1792         ,output p-shift-end-fact-order
     1793         ,output p-day-end-fact-order
     1794         ) no-error .
     1795       if error-status :error
     1796       then do:
     1797         message
     1798           vss-workfile vss-revision vss-description skip
     1799           "Ошибка при вызове процедуры factord"
     1800           error-status :get-message(1) skip
     1801           return-value skip
     1802           view-as alert-box error .
     1803         undo, return error return-value .
     1804       end.
     1805     end.
     1806   end procedure.
     1807   procedure factord-lock-shift :
     1808     define input  parameter p-obj-type  as character no-undo .
     1809     define input  parameter p-obj-code  as integer   no-undo .
     1810     define input  parameter p-fact-date as date      no-undo .
     1811     define parameter buffer buf_shift-obj for ub.shift-obj .
     1812     define variable v-shift-on      as logical   no-undo .
     1813     define variable v-extra-message as character no-undo .
     1814     define variable v-error as character no-undo .
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1819   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1820     (input  p-obj-type
     1821     ,input  p-obj-code
     1822     ,input  'shift-on=request'
     1823     ,output v-shift-on
     1824     ) no-error .
     1825       if error-status :error
     1826       then do:
     1827         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1828         undo, return error v-error .
     1829       end.
     1830       if v-shift-on = true
     1831       then do:
     1832         find first buf_shift-obj share-lock
     1833           where buf_shift-obj.obj-type   = p-obj-type
     1834             and buf_shift-obj.obj-code   = p-obj-code
     1835             and buf_shift-obj.shift-date > p-fact-date
     1836           use-index pi
     1837           no-error .
     1838         if not available buf_shift-obj
     1839         or buf_shift-obj.status_ <> 'зкр':U
     1840         then do:
     1841           find last buf_shift-obj
     1842             where buf_shift-obj.obj-type = p-obj-type
     1843               and buf_shift-obj.obj-code = p-obj-code
     1844               and buf_shift-obj.status_  = 'зкр':U
     1845             use-index stts
     1846             no-error .
     1847           if available buf_shift-obj
     1848           then do:
     1849             assign
     1850               v-extra-message =
     1851                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1852                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1853                               )
     1854             .
     1855           end.
     1856           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1857           undo, return error v-error .
     1858         end.
     1859       end.
     1860     end.
     1861   end procedure.
     1862   procedure factord-end-day :
     1863     define input  parameter p-fact-date            as date    no-undo .
     1864     define output parameter p-day-end-fact-order   as decimal no-undo .
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868       if p-fact-date = ?
     1869       then do:
     1870         return error "Не указана фактическая дата" .
     1871       end.
     1872       assign
     1873         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1874       .
     1875     end.
     1876   end procedure.
     1877   procedure factord-to-date :
     1878     define input  parameter p-fact-order as decimal no-undo .
     1879     define output parameter p-fact-date  as date    no-undo .
     1880     define variable v-ref-date  as date      no-undo .
     1881     define variable v-ref-delta as integer   no-undo .
     1882     do
     1883     on error undo, return error return-value
     1884     :
     1885       if p-fact-order = ?
     1886       or p-fact-order = 0
     1887       then do:
     1888         return error "Не указан fact-order" .
     1889       end.
     1890       assign
     1891         v-ref-date  = date(1, 1, 2000)
     1892       .
     1893       assign
     1894         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1895       .
     1896       assign
     1897         p-fact-date = v-ref-date + v-ref-delta
     1898       .
     1899     end.
     1900   end procedure.
     1901   procedure factord-to-fact-num :
     1902     define input  parameter p-fact-order as decimal no-undo .
     1903     define output parameter p-fact-num   as integer no-undo .
     1904     define variable v-fact-order-trunc as decimal no-undo .
     1905     do
     1906     on error undo, return error return-value
     1907     :
     1908       if p-fact-order = ?
     1909       or p-fact-order = 0
     1910       then do:
     1911         return error "Не указан fact-order" .
     1912       end.
     1913       assign
     1914        v-fact-order-trunc = truncate(p-fact-order, 2)
     1915       .
     1916       assign
     1917         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1918       .
     1919     end.
     1920   end procedure.
     1921   procedure factord-to-shift-num :
     1922     define input  parameter p-fact-order as decimal no-undo .
     1923     define output parameter p-shift-num   as integer no-undo .
     1924     define variable  p-shift-numd  as decimal   no-undo .
     1925     define variable v-fact-order-trunc as decimal no-undo .
     1926     do
     1927     on error undo, return error return-value
     1928     :
     1929       if p-fact-order = ?
     1930       or p-fact-order = 0
     1931       then do:
     1932         return error "Не указан fact-order" .
     1933       end.
     1934       assign
     1935        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1936       .
     1937       if v-fact-order-trunc < 0.5 then do:
     1938         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1939       end.
     1940       assign
     1941         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1942         .
     1943        assign
     1944         p-shift-num = truncate (p-shift-numd , 0)
     1945       .
     1946     end.
     1947   end procedure.
