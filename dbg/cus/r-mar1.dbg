     2648           ,output price-base-with-tax-sale-prl
     2649           ,output price-rubl-without-tax-sale-prl
     2650           ,output price-base-without-tax-sale-prl
     2651           ,output vat-base-sale-prl
     2652           ,output vat-rubl-sale-prl
     2653           ,output vat-base-buyer-prl
     2654           ,output vat-rubl-buyer-prl
     2655           ,output slt-base-sale-prl
     2656           ,output slt-rubl-sale-prl
     2657           ,output road-tax-base-sale-prl
     2658           ,output road-tax-rubl-sale-prl
     2659           ,output excise-base-sale-prl
     2660           ,output excise-rubl-sale-prl
     2661           ,output discnt-base-sale-prl
     2662           ,output discnt-rubl-sale-prl
     2663           ) no-error .
     2664         if error-status :error
