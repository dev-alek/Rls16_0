     2410   procedure prdoclib-clear-temp-prt-obj :
     2411     define buffer buf_temp-prt-obj for temp-prt-obj .
     2412     do
     2413     on error undo, return error return-value
     2414     :
     2415       for each buf_temp-prt-obj
     2416       on error undo, return error return-value
     2417       :
     2418         delete buf_temp-prt-obj .
     2419       end.
     2420     end.
     2421   end procedure.
     2422   procedure prdoclib-create-temp-prt-obj :
     2423     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2424     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2425     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
