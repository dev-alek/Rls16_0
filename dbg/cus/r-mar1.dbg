      314   define  stream PrnLibStream.
      315   procedure prn-lib-prn-file :
      316     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      317     define input parameter p-DIsabledoptions as integer no-undo .
      318     define variable v-report-name as character no-undo .
      319     define variable v-user-action as character no-undo .
      320     define variable v-printed     as logical   no-undo .
      321     define variable v-exist       as logical   no-undo .
      322     do
      323       on error undo, return error
      324       :
      325       run prn-lib-get-report-name  in this-procedure (
      326         input parParentProc
      327         ,output v-report-name
      328         ).
      329   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      331     (input  v-report-name
      332     ,input  2
      333     ,output v-exist
      334     )  .
      335       if NOT v-exist then
      336       DO:
      337         Message
      338           "Нет заданий на печать ! "
      339           view-as alert-box .
      340         Return  .
      341       End.
      342       run gbl/prnfilen.w
      343         (input  ""
      344         ,input  p-DisabledOptions
      345         ,input  string(v-report-name )
      346         ,input  7
      347         ,output v-user-action
      348         ,output v-printed
      349         ) .
      350       if v-printed then
      351       do:
      352         return "YES" .
      353       end.
      354       else
      355       do:
      356         return "NO" .
      357       end.
      358     end.
      359   end procedure.
      360   procedure prn-lib-open-stream :
      361     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      362     define input parameter p-page-size    as integer no-undo .
      363     define input parameter p-is-stream    as logical no-undo .
      364     define input parameter p-append       as logical no-undo .
      365     define variable v-report-name as character no-undo .
      366     do
      367       on error undo, return error
      368       :
      369       run prn-lib-get-report-name  in this-procedure (
      370         input parParentProc
      371         ,output v-report-name
      372         ).
      373       if p-is-stream then
      374       do:
      375         if p-append then
      376         do:
      377           output stream PrnLibStream to value( v-report-name )
      378             page-size value(p-page-size) append .
      379         end.
      380         if not p-append then
      381         do:
      382           output stream PrnLibStream to value( v-report-name )
      383             page-size value(p-page-size) .
      384         end.
      385       end.
      386       if not p-is-stream then
      387       do:
      388         if p-append then
      389         do:
      390           output to value( v-report-name )
      391             page-size value(p-page-size) append .
      392         end.
      393         if not p-append then
      394         do:
      395           output to value( v-report-name )
      396             page-size value(p-page-size) .
      397         end.
      398       end.
      399     end.
      400   end procedure.
      401   procedure prn-lib-open-exp :
      402     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      403     define input parameter p-is-stream    as logical no-undo .
      404     define input parameter p-is-append    as logical no-undo .
      405     define output parameter p-ReportFileName as char init "report" no-undo.
      406     define output parameter p-process as logical no-undo .
      407     define variable glog as logical no-undo .
      408     do
      409       on error undo, return error
      410       :
      411       SYSTEM-DIALOG GET-FILE p-ReportFileName
      412         TITLE      "Укажите путь"
      413         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      414         ASK-OVERWRITE
      415         CREATE-TEST-FILE
      416         SAVE-AS
      417         USE-FILENAME
      418         DEFAULT-EXTENSION "txt"
      419         UPDATE glog
      420         .
      421       if not glog then  return.
      422       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      423       if p-is-stream then
      424       do:
      425         if p-is-append then
      426         do:
      427           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      428         end.
      429         else
      430         do:
      431           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      432         end.
      433       end.
      434       else
      435       do:
      436         if p-is-append then
      437         do:
      438           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      439         end.
      440         else
      441         do:
      442           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      443         end.
      444       end.
      445       p-process = yes.
      446     end.
      447   end procedure.
      448   procedure prn-lib-get-report-name :
      449     define input parameter parParentProc  as widget-handle no-undo.
      450     define output parameter p-report-name as character no-undo .
      451     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      452   end procedure.
      453   procedure prn-lib-reportviewer-report-name :
      454     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      455     define input parameter p-report-name-html as character no-undo .
