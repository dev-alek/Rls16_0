     2567           "Бар-код" buf_main_price-list.b-code skip
     2568           view-as alert-box error .
     2569         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2570       end.
     2571       find first buf_goods no-lock
     2572         where buf_goods.artic     = buf_main_price-list.artic
     2573           and buf_goods.prod-type = buf_main_price-list.prod-type
     2574           and buf_goods.prod-code = buf_main_price-list.prod-code
     2575         no-error .
     2576       if not available buf_goods
     2577       then do:
     2578         message
     2579           vss-workfile vss-revision vss-description skip
     2580           vss-include-info16 skip
     2581           "Не найден товар" skip
     2582           "Переоценка" buf_main_price-list.doc-num skip
     2583           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2584           view-as alert-box error .
     2585         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2586       end.
