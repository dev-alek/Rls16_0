      347   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348     define variable v-cntxt-db-num        as integer   no-undo .
      349     define variable v-cntxt-userid        as character no-undo .
      350     define variable v-cntxt-level         as character no-undo .
      351     define variable v-cntxt-host-code-obj as integer   no-undo .
      352     define variable v-cntxt-obj-type      as character no-undo .
      353     define variable v-cntxt-obj-code      as integer   no-undo .
      354     define variable v-cntxt-db-num-obj    as integer   no-undo .
      355     define variable v-cntxt-is-admin      as logical   no-undo .
      356   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357     run mainmenu_getcntxt in parparentproc
      358       (output v-cntxt-db-num
      359       ,output v-cntxt-userid
      360       ,output v-cntxt-level
      361       ,output v-cntxt-host-code-obj
      362       ,output v-cntxt-obj-type
      363       ,output v-cntxt-obj-code
      364       ,output v-cntxt-db-num-obj
      365       ,output v-cntxt-is-admin
      366       ) .
      367   define variable g#report-num as integer   no-undo .
      368   run get-report-num in parParentProc ( output g#report-num ).
      369   define  buffer buf_ord-doc    for ub.ord-doc.
      370   define  buffer t-doc-rcv      for ub.ord-doc-rcv .
      371   define  buffer t-ord-doc-rcv  for ub.ord-doc-rcv.
      372   define  buffer t-doc-line     for ub.ord-line.
      373   define  buffer t-doc-line-rcv for ub.ord-line-rcv.
      374   define  buffer t-trn-line     for ub.doc-line.
      375   define  buffer t-trn-doc      for ub.trn-doc.
      376   define  buffer buf_contract   for ub.contract.
      377   define temp-table temp-obj-list no-undo
      378   field obj-type like ub.clients.obj-type
      379   field obj-code like ub.clients.obj-code
      380   .
      381   define variable sum-ord    like ub.ord-line.qnty   no-undo .
      382   define variable sum-rcv    like ub.ord-line.qnty   no-undo .
      383   define variable sum-trn    like ub.ord-line.qnty   no-undo .
      384   define variable old-state  like ub.ord-doc.status_ no-undo .
      385   define variable old-flag   like ub.ord-doc.flag_   no-undo .
      386   define variable v-value-character as character  no-undo .
      387   define variable v-value-date      as date       no-undo .
      388   define variable v-value-decimal   as decimal    no-undo .
      389   define variable v-value-integer   as integer    no-undo .
      390   define variable v-value-logical   as logical    no-undo .
      391   define variable v-param-type      as character  no-undo .
      392   define variable v-tth             as handle     no-undo .
      393   define stream  errStream  .
      394   define variable v-log as logical   no-undo .
      395   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      397     (input  v-cntxt-obj-type
      398     ,input  v-cntxt-obj-code
      399     ,output to-day
      400     )  .
      401    find first buf_ord-doc exclusive-lock
      402    where recid (buf_ord-doc) = p-rec  no-error.
      403    assign
      404     old-state = buf_ord-doc.status_
      405     old-flag  = buf_ord-doc.flag_
      406     .
      407     if buf_ord-doc.ship-date = ? then do:
      408         if p-ask then
      409         Message "Не задана дата заказа ! "
      410         skip
      411         "Документ" buf_ord-doc.doc-code skip
      412         view-as alert-box error .
      413         return.
      414     end.
      415     if buf_ord-doc.transport-contract  <> 0 and buf_ord-doc.transport-contract  <> ? then do:
      416       find first buf_contract no-lock where
      417                   buf_contract.host-code     =  buf_ord-doc.transport-host-code and
      418                   buf_contract.contract-code =  buf_ord-doc.transport-contract no-error .
      419       if not available buf_contract then do:
      420           message
      421             "Неверно задан договор грузоперевозчика" skip
      422             "Грузоперевозчик: " buf_ord-doc.transport-host-code      skip
      423             "Договор:         " buf_ord-doc.transport-contract  skip
      424             view-as alert-box error
      425           .
      426           return error  .
      427           end.
      428     end.
      429     define variable t-date  as date      no-undo .
      430     define variable t-time  as integer   no-undo .
      431     run cur-time in this-procedure ( output  t-date , output  t-time ).
      432     if can-find
      433       ( first t-doc-line no-lock where
      434               t-doc-line.doc-code = buf_ord-doc.doc-code and
      435             ( t-doc-line.qnty  =  0 or t-doc-line.qnty  = ?)) then do:
      436         if p-ask then
      437         Message "В заказе есть строки с количеством равным 0 или ? ! "
      438         skip
      439         "Документ" buf_ord-doc.doc-code skip
      440         view-as alert-box error .
      441         return.
      442     end.
      443    case buf_ord-doc.status_ :
      444           when 'закрыто':U
      445           or when 'поставка':U
      446           then do :
      447               for each t-ord-doc-rcv exclusive-lock
      448                  where t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code
      449                    and t-ord-doc-rcv.status_ = 'поставка':U
      450                         :
      451                 assign
      452                   sum-rcv = 0
      453                   sum-trn = 0
      454                   .
      455                 for each t-doc-line-rcv no-lock
      456                    where t-doc-line-rcv.doc-code  = t-ord-doc-rcv.doc-code
      457                     and  t-doc-line-rcv.rcv-code  = t-ord-doc-rcv.rcv-code
      458                           :
      459                   for each ub.ord-chain no-lock
      460                      where ub.ord-chain.doc-code     = t-doc-line-rcv.rcv-code
      461                        and ub.ord-chain.doc-type     = 'rcv'
      462                        and ub.ord-chain.rel-doc-type = 'trn'
      463                           :
      464                    find first t-trn-doc no-lock
      465                       where t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code
      466                         and t-trn-doc.status_   = 'факт':U
      467                         and t-trn-doc.doc-type  = 'при':U
      468                         and t-trn-doc.internal  = false
      469                           no-error.
      470                         if not available  t-trn-doc then next .
      471                           for each t-trn-line no-lock
      472                              where t-trn-line.doc-code  = t-trn-doc.doc-code
      473                                and t-trn-line.artic     = t-doc-line-rcv.artic
      474                                and t-trn-line.prod-type = t-doc-line-rcv.prod-type
      475                                and t-trn-line.prod-code = t-doc-line-rcv.prod-code
      476                                :
      477                               assign sum-trn = sum-trn + t-trn-line.fact-qnty.
      478                           end.
      479                   end.
      480                   assign sum-rcv = sum-rcv + t-doc-line-rcv.qnty.
      481                 end.
      482                 if sum-trn >= sum-rcv
      483                 and sum-rcv <> 0
      484                 then do:
      485                   assign
      486                     t-ord-doc-rcv.status_   = 'факт':U
      487                     t-ord-doc-rcv.fact-date = to-day
      488                   .
      489                 end.
      490               end.
      491               for each t-ord-doc-rcv where  t-ord-doc-rcv.doc-code     = buf_ord-doc.doc-code no-lock :
      492                 for each ub.ord-chain no-lock
      493                    where ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code
      494                      and ub.ord-chain.doc-type = 'rcv'
      495                      and ub.ord-chain.rel-doc-type = 'trn'
      496                        :
      497                   for each t-trn-doc no-lock
      498                      where t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code
      499                        and t-trn-doc.doc-type  = 'при':U
      500                        and t-trn-doc.status_  <> 'факт':U
      501                         :
      502                     if p-ask then
      503                     message "Документ ПН" t-trn-doc.doc-code " имеет статус " CAPS(t-trn-doc.status_)
      504                             "Закройте ПН до статуса ФАКТ " view-as alert-box error
      505                             title "Закрыть заказ "
      506                             .
      507                     return.
      508                    end.
      509                 end.
      510               end.
      511            assign
      512              sum-ord = 0
      513              sum-rcv = 0
      514              sum-trn = 0
      515             .
      516              for each t-doc-line no-lock
      517                 where t-doc-line.doc-code = buf_ord-doc.doc-code
      518                  :
      519                 for each t-doc-line-rcv no-lock
      520                   where t-doc-line-rcv.doc-code  = t-doc-line.doc-code
      521                     and t-doc-line-rcv.artic     = t-doc-line.artic
      522                     and t-doc-line-rcv.prod-type = t-doc-line.prod-type
      523                     and t-doc-line-rcv.prod-code = t-doc-line.prod-code,
      524                       first t-doc-rcv no-lock
      525                       where t-doc-line-rcv.doc-code = t-doc-rcv.doc-code
      526                        and  t-doc-line-rcv.rcv-code = t-doc-rcv.rcv-code
      527                           :
      528                   for each ub.ord-chain no-lock
      529                      where ub.ord-chain.doc-code     = t-doc-line-rcv.rcv-code
      530                        and ub.ord-chain.doc-type     = 'rcv'
      531                        and ub.ord-chain.rel-doc-type = 'trn'
      532                           :
      533                    find first t-trn-doc no-lock
      534                       where t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code
      535                         and t-trn-doc.status_   = 'факт':U
      536                         and t-trn-doc.doc-type  = 'при':U
      537                         and t-trn-doc.internal  = false
      538                           no-error.
      539                         if not available  t-trn-doc then next .
      540                           for each t-trn-line no-lock
      541                              where t-trn-line.doc-code  = t-trn-doc.doc-code
      542                                and t-trn-line.artic     = t-doc-line-rcv.artic
      543                                and t-trn-line.prod-type = t-doc-line-rcv.prod-type
      544                                and t-trn-line.prod-code = t-doc-line-rcv.prod-code
      545                                :
      546                               assign sum-trn = sum-trn + t-trn-line.fact-qnty.
      547                           end.
      548                   end.
      549                   assign sum-rcv = sum-rcv + t-doc-line-rcv.qnty.
      550                 end.
      551                 assign sum-ord = sum-ord + t-doc-line.qnty.
      552              end.
      553              if sum-trn = 0  then do:
      554                 v-log = false .
      555                 if p-ask then
      556                   message "Заказ " buf_ord-doc.doc-code " не имеет внешней ПН !" skip
      557                   "Закрыть в статус (ФАКТ-) ? " skip
      558                     view-as alert-box question
      559                     buttons yes-no
      560                     title "Закрыть заказ"
      561                     update v-log
      562                   .
      563                 if not v-log then return.
      564                 assign buf_ord-doc.flag_ = false .
      565              end.
      566             run adm/shattri.p ( input "get":U
      567                               , input  buf_ord-doc.obj-type
      568                               , input  buf_ord-doc.obj-code
      569                               , input  'ord-obj':U
      570                               , input  'ord-comp-prc':U
      571                               , output v-value-character
      572                               , output v-value-date
      573                               , output v-value-decimal
      574                               , output v-value-integer
      575                               , output v-value-logical
      576                               , output v-param-type
      577                               , input-output table-handle v-tth
      578                               ) no-error .
      579              if  sum-ord > sum-trn
      580              then do:
      581                   v-log = false .
      582                   if p-ask then
      583                     message  "Заказ "  buf_ord-doc.doc-code " не покрыт внешней ПН полностью !" skip
      584                       "Закрыть в статус (ФАКТ-) ? " skip
      585                       "Сумма заказа               " sum-ord skip
      586                       "Сумма накладной            " sum-trn
      587                       view-as alert-box question
      588                       buttons yes-no
      589                       title "Закрыть заказ"
      590                       update v-log
      591                     .
      592                   else do:
      593                     if  v-value-decimal <> 0  and v-value-decimal <> ?
      594                       and v-value-decimal * sum-ord / 100.0 <= sum-trn
      595                     then assign v-log = yes.
      596                     else assign v-log = no.
      597                   end.
      598                   if not v-log then return.
      599                   buf_ord-doc.flag_ = false .
      600              end.
      601              if  sum-ord =  sum-trn then do:
      602                   buf_ord-doc.flag_ = true  .
      603              end.
      604              if  sum-ord <  sum-trn then do:
      605                     v-log = false .
      606                     if p-ask then
      607                   message "На  Заказ"  buf_ord-doc.doc-code " превышено количество по ПН !" skip
      608                     "Закрыть в статус (ФАКТ+) ? " skip
      609                     sum-ord skip
      610                     sum-trn
      611                     view-as alert-box question
      612                     buttons yes-no
      613                     title "Закрыть заказ"
      614                     update v-log
      615                   .
      616                   if not v-log then return.
      617                   buf_ord-doc.flag_ = true  .
      618              end.
      619              assign
      620                 buf_ord-doc.status_ = 'факт':U
      621                 buf_ord-doc.fact-date = to-day
      622              .
      623              for each t-ord-doc-rcv exclusive-lock
      624                 where  t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code
      625                   and t-ord-doc-rcv.status_ <> 'факт':U
      626                  :
      627                 for each ub.ord-chain no-lock
      628                    where ub.ord-chain.doc-code     = t-ord-doc-rcv.rcv-code
      629                      and ub.ord-chain.doc-type     = 'rcv'
      630                      and ub.ord-chain.rel-doc-type = 'trn'
      631                       :
      632                    for each t-trn-doc no-lock
      633                       where t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code
      634                         and t-trn-doc.doc-type  = 'при':U
      635                         and t-trn-doc.status_   = 'факт':U  :
      636                           assign
      637                             t-ord-doc-rcv.status_   = 'факт':U
      638                             t-ord-doc-rcv.fact-date = to-day
      639                           .
      640                    end.
      641                 end.
      642              end.
      643         end.
      644    end case.
