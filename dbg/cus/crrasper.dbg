     1906   define variable n-d as character no-undo .
     1907     v-ext-doc-type = 'ev':U .
     1908     run doc-code in this-procedure
     1909       (input  "main":U,
     1910        input  v-cntxt-obj-type,
     1911        input  v-cntxt-obj-code,
     1912        input  par-doc-code,
     1913        output n-d ) no-error.
     1914     if error-status:error then do:
     1915       if not is-rt  then message "Ошибка при генерации номера документа. chip" view-as alert-box.
     1916       return error "Ошибка при генерации номера документа. chip".
     1917     end.
     1918     create  tt-trn-doc.
     1919     buffer-copy  old_trn-ord-doc  to    tt-trn-doc
     1920       assign
     1921        tt-trn-doc.pay-code       = v-cntxp-out-pay
     1922        tt-trn-doc.status_        = "temp"
     1923        tt-trn-doc.doc-code       = n-d
     1924        tt-trn-doc.doc-date       = to-day
     1925        tt-trn-doc.doc-type       = 'рас':U
