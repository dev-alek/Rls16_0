     2291      .
     2292    run create-chain in this-procedure (
     2293        loc-ord-num
     2294        ,'rcv'
     2295        ,new_trn-doc.doc-code
     2296        ,'trn'
     2297        ,''
     2298        ,'' ).
     2299   run clos-trn in this-procedure (new_trn-doc.doc-code) no-error .
     2300   if not error-status :error then do:
     2301    run cus/ordorcls.p ( input parparentproc, input recid(old_trn-ord-doc) , input false ) no-error .
     2302    if  old_trn-ord-doc.status_ = 'запрос':U or error-status :error then do:
     2303       run waitfram-hide in this-procedure .
     2304       UNDO MAIN-BLOCK, return error substitute(" Нельзя закрыть заказ! &1 &2" , return-value , error-status :get-message(1)   ) .
     2305    end.
     2306   end.
     2307   else do:
     2308       run waitfram-hide in this-procedure .
     2309       UNDO MAIN-BLOCK, return error 'Нельзя закрыть накладную !'.
     2310   end.
