     1933        tt-trn-doc.out-code       = old_trn-ord-doc.doc-code
     1934        tt-trn-doc.PS             = "Сформирована по заказу № " +  old_trn-ord-doc.doc-code + " " + old_trn-ord-doc.doc-type + " " + old_trn-ord-doc.PS
     1935        tt-trn-doc.creid          = v-cntxt-userid
     1936        tt-trn-doc.flag_          = false
