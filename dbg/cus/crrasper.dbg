      740   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   function octal-to-char return character
      742   ( p-string as character ) :
      743     def var v-asc     as integer no-undo .
      744     def var v-new-asc as integer no-undo .
      745     def var ind       as integer no-undo .
      746     if length(p-string) <> 3 then do:
      747       return ? .
      748     end.
      749     assign
      750       v-asc = 0
      751     .
      752     do ind = 1 to length(p-string)
      753     :
      754       assign
      755         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      756       .
      757       if v-new-asc < 0 or v-new-asc >= 8 then do:
      758         return ? .
      759       end.
      760       assign
      761         v-asc = v-asc * 8 + v-new-asc
      762       .
      763     end.
      764     return chr(v-asc) .
      765   end function .
      766   function char-to-octal return character
      767   ( p-chr as character ) :
      768     def var v-asc    as integer   no-undo .
      769     def var ind      as integer   no-undo .
      770     def var v-string as character no-undo .
      771     if length(p-chr) <> 1 then do:
      772       return ? .
      773     end.
      774     assign
      775       v-asc    = asc(p-chr)
      776       v-string = ""
      777     .
      778     do ind = 1 to 3
      779     :
      780       assign
      781         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      782       .
      783       assign
      784         v-asc = truncate(v-asc / 8, 0)
      785       .
      786     end.
      787     return v-string .
      788   end.
      789   function str-encode return character
      790   (   p-init-string       as character
      791     , p-encode-char       as character
      792     , p-special-char-list as character
      793   ) :
      794     def var p-encode-string as character no-undo .
      795     def var ind                as integer no-undo .
      796     def var v-num-special-char as integer no-undo .
      797     def var v-special-char     as character no-undo .
      798     if p-encode-char = ?
      799     or p-encode-char = "" then do:
      800       assign
      801         p-encode-char = "~~"
      802       .
      803     end.
      804     if p-init-string = ? then do:
      805       return "?" .
      806     end.
      807     if p-init-string = "?" then do:
      808       return p-encode-char + char-to-octal("?") .
      809     end.
      810     assign
      811       v-num-special-char = length(p-special-char-list)
      812       p-encode-string    = replace(p-init-string
      813                                   ,p-encode-char
      814                                   ,p-encode-char + char-to-octal(p-encode-char)
      815                                   )
      816     .
      817     do ind = 1 to v-num-special-char
      818     :
      819       assign
      820         v-special-char = substring(p-special-char-list, ind, 1)
      821       .
      822       if v-special-char <> p-encode-char then do:
      823         assign
      824           p-encode-string = replace (p-encode-string
      825                                     ,v-special-char
      826                                     ,p-encode-char + char-to-octal(v-special-char)
      827                                     )
      828         .
      829       end.
      830     end.
      831     return p-encode-string .
      832   end.
      833   function str-decode returns character
      834     (p-init-string   as character
      835     ,p-encode-char   as character
      836     ) :
      837     def var p-decode-string as character no-undo .
      838     def var ind                       as integer no-undo .
      839     def var v-num-entries-init-string as integer no-undo .
      840     def var v-sub-phrase              as character no-undo .
      841     def var v-special-char            as character no-undo .
      842     if p-encode-char = ?
      843     or p-encode-char = "" then do:
      844       assign
      845         p-encode-char = "~~"
      846       .
      847     end.
      848     if p-init-string = "?" then do:
      849       return ? .
      850     end.
      851     assign
      852       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      853     .
      854     if v-num-entries-init-string > 1 then do:
      855       assign
      856         p-decode-string = entry(1, p-init-string, p-encode-char)
      857       .
      858       do ind = 2 to v-num-entries-init-string
      859       :
      860         assign
      861           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      862         .
      863         assign
      864           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      865         .
      866         if v-special-char <> ? then do:
      867           assign
      868             p-decode-string = p-decode-string
      869                             + v-special-char
      870                             + substring(v-sub-phrase, 4)
      871           .
      872         end.
      873         else do:
      874           assign
      875             p-decode-string = p-decode-string
      876                             + p-encode-char
      877                             + v-sub-phrase
      878           .
      879         end.
      880       end.
      881     end.
      882     else do:
      883       assign
      884         p-decode-string = p-init-string
      885       .
      886     end.
      887     return p-decode-string .
      888   end.
      889   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      891   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      892     field cst-code                like ub.trn-doc.cst-code
      893     field part-code               like ub.parts.part-code
      894     .
      895   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      896   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      897   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      898   function hvrdtax return logical (input parrecid as recid):
      899   define variable varresult as logical no-undo.
      900   run hvrdtax-proc (input parrecid, output varresult).
      901   return varresult.
      902   end function.
      903   procedure hvrdtax-proc:
      904   define input  parameter parrecid  as recid   no-undo.
      905   define output parameter parresult as logical no-undo.
      906   define buffer bf_goods for ub.goods.
      907   define buffer bf_units for ub.units.
      908   define buffer rt_tax   for ub.tax.
      909   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      910   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      911   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      912   if available rt_tax and
      913       can-find(first ub.tax-units No-LOCK WHERE
      914                      ub.tax-units.tax-code = rt_tax.tax-code AND
      915                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      916                                                       else assign parresult = no.
      917   end procedure.
      918   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   define new global shared variable g#lib-calc as handle no-undo .
      920   procedure plgdsfnd :
      921     define input  parameter p-chk-and-chs    as logical               no-undo .
      922     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      923     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      924     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      925     define output parameter p-reserv-pl-code as   logical             no-undo .
      926     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      927     define buffer buf_goods         for ub.goods .
      928     define buffer buf_pl-gds        for ub.pl-gds .
      929     define buffer buf_second_pl-gds for ub.pl-gds .
      930     find first buf_goods no-lock where
      931                buf_goods.gds-code = p-gds-code no-error .
      932     if not available buf_goods
      933     then do:
      934       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      935     end.
      936   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      938     (input  p-obj-type
      939     ,input  p-obj-code
      940     ,input  buf_goods.artic
      941     ,input  buf_goods.prod-type
      942     ,input  buf_goods.prod-code
      943     ,input  'place-rsrv=request'
      944     ,output p-reserv-pl-code
      945     ) no-error .
      946     if error-status :error
      947     then do:
      948       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      949     end.
      950     if p-reserv-pl-code = no
      951     then do:
      952       return .
      953     end.
      954     if p-chk-and-chs <> yes
      955     then do:
      956       return .
      957     end.
      958     find first buf_pl-gds no-lock where
      959                buf_pl-gds.obj-type = p-obj-type and
      960                buf_pl-gds.obj-code = p-obj-code and
      961                buf_pl-gds.gds-code = p-gds-code no-error .
      962     if not available buf_pl-gds
      963     then do:
      964       return error "К товару не привязано ни одного места хранения" .
      965     end.
      966     find first buf_second_pl-gds no-lock where
      967                buf_second_pl-gds.obj-type  = p-obj-type          and
      968                buf_second_pl-gds.obj-code  = p-obj-code          and
      969                buf_second_pl-gds.gds-code  = p-gds-code          and
      970                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      971     if not available buf_second_pl-gds
      972     then do:
      973       assign
      974         p-pl-code = buf_pl-gds.pl-code
      975       .
      976     end.
      977     else do:
      978       if not valid-handle( parparentproc )
      979       then do:
      980         return error "Не выбрано место хранения " + chr(10) .
      981       end.
      982       run str/plgdssel.p
      983         (
      984            input parparentproc
      985         ,  input p-obj-type
      986         ,  input p-obj-code
      987         ,  input p-gds-code
      988         , output p-pl-code
      989         ) no-error .
      990       if error-status :error
      991       then do:
      992         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
      993                                , 'plgdssel.p':U
      994                                , chr(10)
      995                                , error-status :get-message( 1 )
      996                                , return-value
      997                                ) .
      998       end.
      999       if p-pl-code = ? or
     1000          p-pl-code = 0
     1001       then do:
     1002         return error "Не выбрано место хранения " + chr(10) .
     1003       end.
     1004     end.
     1005   end procedure.
     1006   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1008   define temp-table tt-doc-line no-undo like ub.doc-line
     1009   field cst-code like ub.trn-doc.cst-code
     1010   .
     1011   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1012   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1013   define temp-table tt-parts    no-undo like ub.parts.
     1014   procedure lib-trn_copy-inqu :
     1015   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1016   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1017   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1018   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1019   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1020   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1021   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1022   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1023   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1024   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1025   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1026   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1027   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1028   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1029   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1030   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1031   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1032   define input parameter parinp-discnt-type as   logical                no-undo.
     1033   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1034   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1035   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1036   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1037   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1038   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1039   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1040   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1041   define input parameter table for tt-doc-line.
     1042   define input parameter table for tt-gds-dtl.
     1043   define input parameter table for tt-parts.
     1044   define input parameter paruse-parts       as   logical                no-undo.
     1045   define input parameter parall-qnty        as   logical                no-undo.
     1046   define input parameter parfix-price       as   logical                no-undo.
     1047   define buffer crt_trn-doc  for ub.trn-doc.
     1048   define buffer crt_goods    for ub.goods.
     1049   define buffer crt_doc-line for ub.doc-line.
     1050   define buffer crt_gds-dtl  for ub.gds-dtl.
     1051   define variable end-price    as   logical              no-undo.
     1052   define variable real-type    like ub.goods.gds-type    no-undo.
     1053   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1054   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1055   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1056   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1057   define variable g-log        as   logical              no-undo.
     1058   define variable mem-qnty like chg-qnty no-undo.
     1059   define variable dflt-cd as character no-undo .
     1060   c-l:
     1061   do on error undo, return error return-value :
     1062   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1063   assign
     1064       paruse-parts = false
     1065       .
     1066   assign
     1067     end-price = no.
     1068   if parinp-discnt-type = yes and
     1069      parinp-discnt-pc   = 0   and
     1070      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1071      then do:
     1072     assign
     1073       crt_trn-doc.tot-calc    = partot-calc
     1074       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1075       crt_trn-doc.discnt-type = pardiscnt-type.
     1076   end.
     1077   if parinp-agnt = ? then do:
     1078     assign
     1079       crt_trn-doc.agnt = paragnt.
     1080   end.
     1081   if parinp-boss = ? then do:
     1082     assign
     1083       crt_trn-doc.boss = parboss.
     1084   end.
     1085   if parinp-wrkr = ? then do:
     1086     assign
     1087       crt_trn-doc.wrkr = parwrkr.
     1088   end.
     1089   if parinp-base-rate  = ? then do:
     1090     assign
     1091       crt_trn-doc.base-rate  = parbase-rate.
     1092   end.
     1093   if parinp-base-scale = ? then do:
     1094     assign
     1095       crt_trn-doc.base-scale = parbase-scale.
     1096   end.
     1097   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1098   if available tt-doc-line then do:
     1099     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1100                      and crt_goods.prod-type = tt-doc-line.prod-type
     1101                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1102     if crt_goods.gds-type = 'у':U and
     1103        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1104       return error "В данный документ нельзя копировать услуги.".
     1105     end.
     1106     assign
     1107       real-type = crt_goods.gds-type.
     1108     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1109     if available crt_doc-line then do:
     1110       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1111                        and crt_goods.prod-type = crt_doc-line.prod-type
     1112                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1113       if crt_goods.gds-type <> real-type then do:
     1114         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1115       end.
     1116     end.
     1117     else do:
     1118       assign
     1119         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1120     end.
     1121   end.
     1122   r-l:
     1123   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1124     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1125                      and crt_goods.prod-type = tt-doc-line.prod-type
     1126                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1127   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1128      (
     1129       input crt_trn-doc.doc-code
     1130      ,input crt_trn-doc.obj-type
     1131      ,input crt_trn-doc.obj-code
     1132      ,input crt_goods.artic
     1133      ,input crt_goods.prod-type
     1134      ,input crt_goods.prod-code
     1135      ,input crt_goods.gds-name
     1136      ,input crt_goods.prt-root
     1137      ,input ?
     1138      ,input ?
     1139      ,input parcash-pay      ) no-error.
     1140     if error-status:error then do:
     1141       undo c-l, return error return-value.
     1142     end.
     1143     if return-value = "next" then do:
     1144       next r-l.
     1145     end.
     1146     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1147                                   crt_doc-line.artic     = crt_goods.artic      and
     1148                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1149                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1150     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1151                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1152                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1153                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1154                               break by tt-gds-dtl.artic
     1155                                     by tt-gds-dtl.prod-type
     1156                                     by tt-gds-dtl.prod-code
     1157                               :
     1158   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1159     ( input  tt-gds-dtl.artic
     1160      ,input  tt-gds-dtl.prod-type
     1161      ,input  tt-gds-dtl.prod-code
     1162      ,input  tt-gds-dtl.prt-code
     1163      ,input  tt-doc-line.obj-type
     1164      ,input  tt-doc-line.obj-code
     1165      ,output legal-node
     1166     ) no-error .
     1167       if error-status:error then do:
     1168          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1169       end.
     1170   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1171     ( input crt_trn-doc.obj-code
     1172      ,input crt_trn-doc.obj-type
     1173      ,input crt_trn-doc.doc-code
     1174      ,input crt_goods.artic
     1175      ,input crt_goods.prod-code
     1176      ,input crt_goods.prod-type
     1177      ,input legal-node
     1178      ,input yes
     1179     ) no-error .
     1180        if error-status:error then do:
     1181           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1182        end.
     1183        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1184                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1185                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1186                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1187                                     crt_gds-dtl.prt-code  = legal-node.
     1188       assign
     1189         crt_gds-dtl.ov             = parfix-price
     1190         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1191         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1192         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1193         .
     1194       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1195         assign
     1196           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1197           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1198           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1199           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1200       end.
     1201       if end-price then do:
     1202         assign
     1203           crt_gds-dtl.ov             = yes
     1204           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1205           crt_gds-dtl.discnt-base    = 0
     1206           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1207           crt_gds-dtl.discnt-rubl    = 0
     1208           crt_gds-dtl.discnt-pc      = 0
     1209           crt_gds-dtl.discnt-type    = yes.
     1210       end.
     1211   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1213     ( input recid(crt_gds-dtl)
     1214     , input no
     1215     , input ?
     1216     ) no-error.
     1217           if error-status:error then do:
     1218             undo c-l, return error return-value.
     1219           end.
     1220       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1221          crt_gds-dtl.ov then do:
     1222         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1223       end.
     1224       if paruse-parts then do:
     1225          if first-of (tt-gds-dtl.prod-code) then do:
     1226            for each tt-parts :
     1227              assign
     1228                chg-qnty = tt-parts.fact-qnty
     1229                mem-qnty = chg-qnty.
     1230              assign
     1231              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1232              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1233            end.
     1234            assign
     1235              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1236              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1237            assign
     1238              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1239              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1240            if crt_gds-dtl.doc-qnty = 0 then do:
     1241              delete crt_gds-dtl.
     1242            end.
     1243          end.
     1244       end.
     1245       else do:
     1246         assign
     1247           chg-qnty = tt-gds-dtl.fact-qnty
     1248           mem-qnty = chg-qnty.
     1249         assign
     1250           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1251           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1252           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1253           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1254         assign
     1255         varchg-qnty  = varchg-qnty  + chg-qnty
     1256         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1257         if crt_gds-dtl.doc-qnty = 0 then do:
     1258           delete crt_gds-dtl.
     1259         end.
     1260       end.
     1261     end.
     1262     if crt_doc-line.doc-qnty = 0 then do:
     1263       delete crt_doc-line.
     1264     end.
     1265   end.
     1266   end.
     1267   end procedure.
     1268   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269     define variable v-cntxt-db-num        as integer   no-undo .
     1270     define variable v-cntxt-userid        as character no-undo .
     1271     define variable v-cntxt-level         as character no-undo .
     1272     define variable v-cntxt-host-code-obj as integer   no-undo .
     1273     define variable v-cntxt-obj-type      as character no-undo .
     1274     define variable v-cntxt-obj-code      as integer   no-undo .
     1275     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1276     define variable v-cntxt-is-admin      as logical   no-undo .
     1277   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278     run mainmenu_getcntxt in parparentproc
     1279       (output v-cntxt-db-num
     1280       ,output v-cntxt-userid
     1281       ,output v-cntxt-level
     1282       ,output v-cntxt-host-code-obj
     1283       ,output v-cntxt-obj-type
     1284       ,output v-cntxt-obj-code
     1285       ,output v-cntxt-db-num-obj
