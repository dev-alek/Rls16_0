     1287       ) .
     1288   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     1290     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     1291     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     1292     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     1293     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     1294     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     1295     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     1296     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     1297     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     1298     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     1299     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     1300     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     1301     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     1302     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     1303     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     1304     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     1305     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     1306     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     1307     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1308     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
