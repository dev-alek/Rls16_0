     1881   run waitfram-show in this-procedure ("Формирование временных таблиц для копирования....") .
     1882      find first old_trn-ord-doc exclusive-lock where old_trn-ord-doc.doc-code = par-doc-code no-error .
     1883      if not available old_trn-ord-doc then return error.
     1884   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1885   define variable v-param-type21 as character no-undo .
     1886   define variable v-value-date21 as date no-undo .
