     2315    end.
     2316   end.
     2317   procedure clos-trn :
     2318     do
     2319     on error undo, return error return-value
     2320     :
     2321   define input parameter p-trn-code as character no-undo .
     2322   define buffer buf_s-trn-doc for ub.trn-doc.
     2323   define variable varmode            as   character           no-undo.
     2324   define variable varstatus          like ub.trn-doc.status_  no-undo.
     2325   define variable varflag            like ub.trn-doc.flag     no-undo.
     2326   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     2327   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     2328   define variable varcheck-return as logical no-undo .
     2329   define variable varchg-inv as logical no-undo .
     2330   assign
     2331     varmode         = '<закрытие документа>':U
     2332     varstatus       = 'запрос':U
     2333     varflag         = true
     2334     varcopystatus   = 'новый':U
     2335     varcopyflag     = false
     2336     varcheck-return = true
     2337     varchg-inv      = true
     2338     .
     2339   run str/trn-graf.p
     2340     ( input  p-trn-code ,
     2341       input  v-cntxt-db-num ,
     2342       input  varmode ,
     2343       output varstatus ,
     2344       output varflag ,
     2345       output varcopystatus ,
     2346       output varcopyflag
     2347     ) no-error .
     2348   if error-status:error then do:
     2349      if error-status :get-message(1) <> "" or  return-value = ""
     2350         then do:
     2351        if not is-rt  then
     2352        message "Ошибка при вызове trn-graf.p." skip
     2353        error-status :get-message(1) skip
     2354        return-value skip
     2355        view-as alert-box error.
     2356      end.
     2357      else do:
     2358       if not is-rt  then
     2359        message return-value
     2360        view-as alert-box error.
     2361      end.
     2362      return error return-value + error-status :get-message(1) .
     2363   end.
     2364   run str/trn-stat.p (
     2365       input  parparentproc ,
     2366       input  this-procedure ,
     2367       input  varmode,
     2368       input  p-trn-code,
     2369       input  varcheck-return,
     2370       input  v-cntxt-db-num,
     2371       input  v-cntxt-in-ov,
     2372       input  v-cntxt-rsrv-time,
     2373       input  v-cntxt-load-time,
     2374       input  v-cntxt-holidays,
     2375       input  NO,
     2376       output varchg-inv,
     2377       output table gds-list)
     2378       no-error.
     2379   if error-status:error then do:
     2380      if not is-rt then
     2381      message
     2382        vss-workfile vss-revision vss-description skip
     2383        "Ошибка при принудительном закрытии документа " p-trn-code skip
     2384        skip
     2385        return-value skip
     2386        trim(error-status :get-message(1))
     2387        trim(error-status :get-message(2))
     2388        trim(error-status :get-message(3))
     2389        trim(error-status :get-message(4))
     2390        trim(error-status :get-message(5)) skip
     2391        view-as alert-box error.
     2392      return error "Ошибка при принудительном закрытии документа " + return-value  + error-status :get-message(1) .
     2393   end.
     2394     end.
     2395   end procedure.
     2396   procedure cloce-ord :
     2397   define output parameter p-ask as logical   no-undo .
     2398     do
     2399     on error undo, return error return-value
     2400     :
     2401     p-ask = true .
     2402     end.
     2403   end procedure.
     2404   procedure cb_cloce-quest-neg :
     2405   define output parameter p-is-negostmess as logical   no-undo .
     2406     do
     2407     on error undo, return error return-value
     2408     :
