     2410         p-is-negostmess = false .
     2411      else
     2412         p-is-negostmess = true  .
     2413     end.
     2414   end procedure.
     2415   procedure corr-rcv-from-rt :
     2416   define input  parameter p-ord-doc as character no-undo .
     2417   define variable v-b-code        as integer   no-undo .
     2418   define variable v-set-qnty      as decimal   no-undo .
     2419   define variable v-new-price-cli as decimal   no-undo .
     2420   define buffer buf_batchprocess for ub.batchprocess  .
     2421   define buffer buf_goods        for ub.goods  .
     2422   define buffer buf_bar-code     for ub.bar-code  .
     2423   define buffer buf_ord-line-rcv for ub.ord-line-rcv  .
     2424   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv  .
     2425   define variable is-exist  as logical   no-undo .
     2426   define variable v-is-ex as logical   no-undo .
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430     if not is-rt then return .
     2431       for each buf_batchprocess exclusive-lock
     2432           where buf_batchprocess.bp_type     = 'rt-line':U
     2433             and buf_batchprocess.bp_status   = 'N':U
     2434             and buf_batchprocess.charkey_one = p-ord-doc
     2435             on error undo , return error substitute(" buf_batchprocess &1" , return-value)
     2436             :
     2437             run waitfram-show in this-procedure ("Проверка данных присланных с РТ....") .
     2438              release buf_batchprocess.
     2439       end.
     2440      v-is-ex = false .
     2441      for each tt-doc-line :
     2442           find first buf_goods no-lock where
     2443                      buf_goods.artic     =  tt-doc-line.artic     and
     2444                      buf_goods.prod-type =  tt-doc-line.prod-type and
     2445                      buf_goods.prod-code =  tt-doc-line.prod-code no-error .
     2446           v-is-ex = false .
     2447           for each buf_bar-code no-lock where
     2448                    buf_bar-code.gds-code = buf_goods.gds-code :
     2449               find first  buf_batchprocess no-lock
     2450                     where buf_batchprocess.bp_type     = 'rt-line':U
     2451                       and buf_batchprocess.bp_status   = 'N':U
     2452                       and buf_batchprocess.charkey_one = p-ord-doc
     2453                       and buf_batchprocess.key#_one    = buf_bar-code.b-code
     2454                       no-error .
     2455                   if  available buf_batchprocess then do:
     2456                       v-is-ex = true .
     2457                   end.
     2458            end.
     2459            if v-is-ex = false  then do:
     2460               run delete-tt (
     2461                   input buf_goods.artic  ,
     2462                   input buf_goods.prod-type,
     2463                   input buf_goods.prod-code
     2464                   ) .
     2465            end.
     2466        end.
     2467         for each buf_batchprocess no-lock
     2468           where buf_batchprocess.bp_type     = 'rt-line':U
     2469             and buf_batchprocess.bp_status   = 'N':U
     2470             and buf_batchprocess.charkey_one = p-ord-doc
     2471         on error undo , return error substitute(" buf_batchprocess &1" , return-value)
     2472         :
     2473           assign
     2474             v-b-code        = buf_batchprocess.key#_one
     2475             v-set-qnty      = decimal ( buf_batchprocess.bp_execsystime )
     2476             v-new-price-cli = decimal ( buf_batchprocess.charkey_three  )
     2477             .
     2478           find first buf_bar-code no-lock where
     2479                      buf_bar-code.b-code = v-b-code no-error .
     2480           find first buf_goods no-lock where
     2481                      buf_goods.gds-code = buf_bar-code.gds-code no-error .
     2482           find first  tt-doc-line  where
     2483                       tt-doc-line.artic     = buf_goods.artic and
     2484                       tt-doc-line.prod-type = buf_goods.prod-type and
     2485                       tt-doc-line.prod-code = buf_goods.prod-code no-error .
     2486           if available tt-doc-line then do:
     2487              if v-set-qnty  = 0 then do:
     2488                run delete-tt (
     2489                   input buf_goods.artic  ,
     2490                   input buf_goods.prod-type,
     2491                   input buf_goods.prod-code
     2492                   ).
     2493              end.
     2494              else do:
     2495                 tt-doc-line.doc-qnty  = v-set-qnty * tt-doc-line.cli-base-rate.
     2496                 tt-doc-line.fact-qnty = v-set-qnty * tt-doc-line.cli-base-rate.
     2497                 tt-doc-line.cli-qnty  = v-set-qnty.
     2498                 for each tt-gds-dtl where
     2499                       tt-gds-dtl.artic     = buf_goods.artic and
     2500                       tt-gds-dtl.prod-type = buf_goods.prod-type and
     2501                       tt-gds-dtl.prod-code = buf_goods.prod-code
     2502                       :
     2503                    assign
     2504                         tt-gds-dtl.doc-qnty    = tt-doc-line.doc-qnty
     2505                         tt-gds-dtl.fact-qnty   = tt-doc-line.fact-qnty
     2506                       .
     2507                 end.
     2508                 for each tt-parts where
     2509                       tt-parts.artic     = buf_goods.artic and
     2510                       tt-parts.prod-type = buf_goods.prod-type and
     2511                       tt-parts.prod-code = buf_goods.prod-code :
     2512                       assign
     2513                         tt-parts.cli-qnty    = tt-doc-line.cli-qnty
     2514                         tt-parts.qnty        = tt-doc-line.doc-qnty
     2515                         tt-parts.fact-qnty   = tt-doc-line.fact-qnty
     2516                         tt-parts.price-cli   = tt-doc-line.price-cli
     2517                         tt-parts.price-rubl  = tt-doc-line.price-rubl
     2518                         tt-parts.price-base  = tt-doc-line.price-base
     2519                       .
     2520                 end.
     2521              end.
     2522           end.
     2523       end.
     2524    end.
     2525   end procedure.
     2526   procedure delete-tt :
     2527   define input  parameter p-artic as character no-undo .
     2528   define input  parameter p-prod-type as character no-undo .
     2529   define input  parameter p-prod-code as integer   no-undo .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533     define buffer b_tt-doc-line for tt-doc-line  .
     2534       for each tt-gds-dtl where
     2535                tt-gds-dtl.artic     = p-artic and
     2536                tt-gds-dtl.prod-type = p-prod-type and
     2537                tt-gds-dtl.prod-code = p-prod-code
     2538                :
     2539         delete tt-gds-dtl.
     2540       end.
     2541       for each tt-parts where
     2542                tt-parts.artic     = p-artic and
     2543                tt-parts.prod-type = p-prod-type and
     2544                tt-parts.prod-code = p-prod-code
     2545                :
     2546         delete tt-parts.
     2547       end.
     2548       for each b_tt-doc-line  where
     2549                b_tt-doc-line.artic     = p-artic and
     2550                b_tt-doc-line.prod-type = p-prod-type and
     2551                b_tt-doc-line.prod-code = p-prod-code
     2552                :
     2553         delete b_tt-doc-line .
     2554       end.
     2555     end.
     2556   end procedure.
