     1817   define buffer buf_sysconf for ub.sysconf  .
     1818   define buffer buf_goods for ub.goods  .
     1819   find first buf_sysconf where buf_sysconf.host-code = v-cntxt-host-code-obj no-lock.
     1820   define variable v-cntxt-cash-pay as integer   no-undo .
     1821   define variable v-cntxt-in-ov as logical   no-undo .
     1822   define variable v-cntxt-base-code as integer   no-undo .
     1823   define variable v-cntxt-rsrv-time  as integer   no-undo .
     1824   define variable v-cntxt-load-time  as integer   no-undo .
     1825   define variable v-cntxt-holidays  as character no-undo .
     1826   define variable v-no-ask as logical   no-undo .
     1827   define variable v-Ok       as logical   no-undo .
     1828   define variable v-mess as character no-undo .
     1829   define variable v-event-code as character no-undo .
     1830   define stream str.
     1831   output stream str to value('no-price.txt') .
     1832   assign
     1833     v-cntxt-cash-pay   = buf_sysconf.cash-pay
     1834     v-cntxt-base-code  = buf_sysconf.base-code
     1835     v-cntxt-in-ov      = buf_sysconf.in-ov
     1836     v-cntxt-rsrv-time  = buf_sysconf.rsrv-time
     1837     v-cntxt-load-time  = buf_sysconf.load-time
     1838     v-cntxt-holidays   = buf_sysconf.holidays
     1839   .
     1840   MAIN-BLOCK:
     1841   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1842      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1843   define variable v-ext-doc-type as character no-undo .
