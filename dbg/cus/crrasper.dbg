        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle no-undo .
        3   define input parameter par-doc-code as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: crrasper.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/crrasper.p $":U .
        9   define variable vss-description as character no-undo init "Создание внутреннего расхода  по временной таблице".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable to-day       as date no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure doc-code:
       78   define input  parameter parmode          as   character           no-undo.
       79   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       80   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       81   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       82   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       83   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       84   define variable vardb-remote     as   logical             no-undo.
       85   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       86   define variable v-delimiter as character no-undo .
       87   do
       88   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       89   :
       90   find first buf_sys-ctrl no-lock .
       91   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       92     CASE parmode:
       93       when "main":u then do:
       94         if vardb-remote then do:
       95           assign
       96             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
       97         end.
       98         else do:
       99           assign
      100             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      101         end.
      102       end.
      103       when "trio" then do:
      104         assign
      105           pardoc-code = replace (parroot-doc-code, "=", "*").
      106       end.
      107       otherwise do:
      108         assign
      109         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      110         no-error
      111         .
      112         if error-status:error  then do:
      113           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      114                                         ,chr(10)
      115                                         ,parmode
      116                                         ).
      117         end.
      118         if num-entries(parmode) = 1
      119         and parmode <> "chip":U
      120         and parmode <> "chip_s":U
      121         then do:
      122           assign
      123           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      124         end.
      125         else if (lookup("chip":U, parmode) > 0
      126                  or
      127                  lookup("chip_s":U, parmode) > 0) then do:
      128           assign
      129             vartemp-doc-code = parroot-doc-code.
      130           do while true:
      131             if index (vartemp-doc-code , ".") = 0 then
      132               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      133             else
      134               vartemp-doc-code  =
      135               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      136               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      137               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      138             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      139           end.
      140           assign
      141             pardoc-code = vartemp-doc-code.
      142         end.
      143       end.
      144     end CASE.
      145     if pardoc-code = '':U
      146     or (parroot-doc-code <> '':U
      147     and pardoc-code = parroot-doc-code) then do:
      148       undo, return error substitute("Ошибка при генерации номера документа&1"
      149                                     ,chr(10)).
      150     end.
      151   end.
      152   end. // procedure/method
      153   function get-doc-code-int64 returns int64
      154     ( input p-doc-code as character ) :
      155     define variable v-ind              as integer   no-undo .
      156     define variable v-num-entries      as integer   no-undo .
      157     define variable v-doc-code-int64   as int64     no-undo .
      158     define variable v-canonic-doc-code as character no-undo .
      159     assign
      160       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      161       v-canonic-doc-code = p-doc-code
      162     .
      163     do v-ind = 1 to v-num-entries
      164     :
      165       assign
      166         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      167       .
      168     end.
      169     assign
      170       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      171     .
      172     return v-doc-code-int64 .
      173   end. // function/method
      174   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   define variable v-waitfram-action01         as character   no-undo .
      176   define variable v-waitfram-action02         as character   no-undo .
      177   define variable v-waitfram-action03         as character   no-undo .
      178   define variable mWaitFramTextBeg            as character   no-undo.
      179   define variable mWaitFramTextEnd            as character   no-undo.
      180   define variable mWaitFramView               as logical     no-undo.
      181   define variable mWaitProcEvent              as logical     no-undo init yes.
      182   define variable mWaitFramInterval           as integer     no-undo init 1 .
      183   define variable mWaitFramStop               as logical     no-undo.
      184   define variable mWaitFramStopUser           as logical     no-undo.
      185   define variable mWaitFramStopTimeOut        as logical     no-undo.
      186   define variable mWaitFramStartProc          as datetime-tz no-undo.
      187   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      188   define button B-WaitFramStop auto-end-key
      189        label "Стоп"
      190        size 10 by 1 tooltip "Остоновить процесс".
      191   define button B-viewProcInfo
      192        label "Информация"
      193        size 15 by 1 tooltip "Информация о процесс".
      194   define frame waitfram
      195     v-waitfram-action01 format "x(72)" no-label skip
      196     v-waitfram-action02 format "x(72)" no-label skip
      197     v-waitfram-action03 format "x(72)" no-label skip
      198     B-viewProcInfo
      199     B-WaitFramStop at row 4 col 30
      200     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      201     .
      202   define new global shared variable mBatchMode as logical no-undo init ?.
      203   define variable mFramBachModHandle as handle no-undo.
      204   mFramBachModHandle = frame waitfram:handle.
      205   define variable mFameOldVis as logical no-undo.
      206   define variable mVisCUrentVin as logical no-undo.
      207   if session:batch-mode
      208   then
      209      mBatchMode = yes.
      210   if mBatchMode = ? then do:
      211     mVisCUrentVin = current-window:visible.
      212     mFameOldVis = mFramBachModHandle:visible.
      213     mFramBachModHandle:visible  = yes.
      214     mBatchMode = mFramBachModHandle:visible ne yes.
      215     mFramBachModHandle:visible = mFameOldVis.
      216     current-window:visible = mVisCUrentVin.
      217   end.
      218    if  log-manager:logfile-name ne ?
      219     then DO:
      220         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      221         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      222         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      223     end.
      224   on choose of B-WaitFramStop in frame waitfram
      225   do:
      226     mWaitFramStop = yes.
      227     mWaitFramStopUser = yes.
      228   end.
      229   function waitfram-check-timeout returns logical():
      230      define variable vtime as int64 no-undo.
      231      if mWaitFramStopTimeOut
      232      then
      233         return yes.
      234      vtime = ( now - mWaitFramStartProc ) / 1000 .
      235      if     mWaitFramTimeOut ne ?
      236         and mWaitFramTimeOut ne 0
      237         and mWaitFramTimeOut lt vtime
      238      then do:
      239         mWaitFramStopTimeOut = yes.
      240      end.
      241      return mWaitFramStopTimeOut.
      242   end.
      243   procedure waitfram-hide :
      244     if not session:batch-mode
      245     then do
      246     on error undo, return error return-value
      247     :
      248       pause 0 before-hide .
      249       if not mBatchMode then
      250         hide frame waitfram .
      251     if     not mWaitFramView
      252        and mWaitProcEvent
      253     then
      254       process events .
      255     end.
      256   end procedure.
      257   procedure waitfram-show :
      258     define input  parameter p-message as character no-undo .
      259     define variable v-left-margin as integer   no-undo .
      260     if not session:batch-mode
      261     then do
      262     on error undo, return error return-value
      263     :
      264       if length(p-message) <= 70 then do:
      265         assign
      266           v-left-margin = integer((70 - length(p-message)) / 2)
      267         .
      268         assign
      269           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      270         .
      271         assign
      272           v-waitfram-action01 = " "
      273           v-waitfram-action02 = " "
      274                                    + fill(" ", v-left-margin)
      275                                    + p-message
      276           v-waitfram-action03 = " "
      277         .
      278       end.
      279       else do:
      280         define variable vRindex1 as integer no-undo.
      281         define variable vRindex2 as integer no-undo.
      282         vRindex1 = r-index(p-message," ",70).
      283         if vRindex1 = 0
      284         then
      285            vRindex1 = 70.
      286         if length(p-message)  <= vRindex1 + 70 then do:
      287           assign
      288             v-waitfram-action01 = " "
      289             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      290             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      291           .
      292         end.
      293         else do:
      294           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      295           if vRindex2 <= vRindex1
      296           then
      297              vRindex2 = vRindex1 + 70.
      298           assign
      299             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      300             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      301             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      302           .
      303         end.
      304       end.
      305       B-viewProcInfo:visible   in frame waitfram = no.
      306       B-viewProcInfo:sensitive in frame waitfram = no.
      307       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      308       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      309       if  (   mWaitFramView
      310          or  mWaitProcEvent)
      311          and not mBatchMode
      312       then
      313          display
      314             v-waitfram-action01 skip
      315             v-waitfram-action02 skip
      316             v-waitfram-action03 skip
      317          with frame waitfram .
      318       if     mWaitFramView
      319          then do:
      320             if     mWaitFramInterval ne ?
      321                and not mBatchMode
      322             then
      323                wait-for go of frame waitfram pause mWaitFramInterval.
      324          end.
      325          else
      326             if     mWaitProcEvent
      327                and not mBatchMode
      328             then
      329                process events .
      330     end.
      331   end procedure.
      332      procedure waitfram-show-this:
      333         define input  parameter iInterval as int64 no-undo.
      334         define variable vtime as int64 no-undo.
      335         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      336         mWaitFramInterval = iInterval.
      337         run waitfram-show (substitute("&1&2 &3&4" ,
      338                                       mWaitFramTextBeg ,
      339                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      340                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      341                                       mWaitFramTextEnd
      342                                      )
      343                           ).
      344      end.
      345      procedure WaitFramRunPause:
      346         define input  parameter iInterval as dec no-undo.
      347         define variable vStart  as datetime-tz no-undo.
      348         define variable vend    as datetime-tz no-undo.
      349         define variable vint as int64 no-undo.
      350         define variable vOk as logical no-undo.
      351         vStart = now.
      352         vend   = vStart.
      353         publish "WaitFramPause" (iInterval,output vOk).
      354         vend   =  now.
      355         vint = vend - vStart.
      356         vint = iInterval - vint / 1000.
      357         if     not mWaitFramStop
      358            and (   vint > 0
      359                 or (    not vOk
      360                     and iInterval eq ?
      361                     )
      362                 )
      363         then
      364            run waitfram-show-this (iInterval).
      365         vend   =  now.
      366         vint = vend - vStart.
      367         vint = iInterval - vint / 1000.
      368         if     not mWaitFramStop
      369            and vint > 0
      370         then do:
      371            run gbl/pause.p (vint * 1000).
      372         end.
      373         if iInterval ne ?
      374         then
      375            publish "WaitFramStop".
      376         waitfram-check-timeout().
      377      end.
      378      procedure WaitFramWaitFor:
      379         define input  parameter iInterval as dec no-undo.
      380         assign
      381            mWaitFramStartProc   = now
      382            mWaitFramStopUser    = no
      383            mWaitFramStopTimeOut = no
      384         .
      385         block-wait:
      386         do while not mWaitFramStop:
      387            run WaitFramRunPause (iInterval).
      388            if  waitfram-check-timeout()
      389            then do:
      390               leave block-wait.
      391            end.
      392         end.
      393         run waitfram-hide.
      394      end.
      395   procedure waitfram-join :
      396     define input  parameter p-line-1  as character no-undo .
      397     define input  parameter p-line-2  as character no-undo .
      398     define input  parameter p-line-3  as character no-undo .
      399     define output parameter p-message as character no-undo .
      400     do
      401     on error undo, return error return-value
      402     :
      403       assign
      404         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      405                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      406                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      407       .
      408     end.
      409   end procedure.
      410   function waitfram-join-function returns character
      411     (input p-line-1 as character
      412     ,input p-line-2 as character
      413     ,input p-line-3 as character
      414     ).
      415     define variable v-message as character no-undo .
      416     run waitfram-join in this-procedure
      417       (input  p-line-1
      418       ,input  p-line-2
      419       ,input  p-line-3
      420       ,output v-message
      421       ) .
      422     return v-message .
      423   end function .
      424   function cross-list returns logical (
      425     input parfirst-stream  as character,
      426     input parsecond-stream as character,
      427     input pardelim         as character).
      428     if pardelim = ""
      429     or pardelim = ?
      430     then do:
      431       assign
      432         pardelim = ","
      433       .
      434     end.
      435     define variable vari            as integer no-undo .
      436     define variable varresult-cross as logical no-undo .
      437     assign
      438       varresult-cross = no
      439     .
      440     def var v-num-parfirst-stream as integer no-undo .
      441     assign
      442       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      443     .
      444     do vari = 1 to v-num-parfirst-stream
      445     :
      446       if lookup(entry(vari, parfirst-stream, pardelim)
      447                ,parsecond-stream
      448                ,pardelim
      449                ) > 0 then do:
      450         assign
      451           varresult-cross = yes
      452         .
      453         leave.
      454       end.
      455     end.
      456     return varresult-cross .
      457   end function.
      458   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   define new global shared variable g#attr-lib  as handle no-undo .
      460   define variable v-attr-lib-variable as handle no-undo .
      461   procedure clntattr-code :
      462     define input  parameter p-code           as character no-undo .
      463     define output parameter p-type           as character no-undo .
      464     define output parameter p-format         as character no-undo .
      465     define output parameter p-label          as character no-undo .
      466     define output parameter p-user-can-edit  as logical   no-undo .
      467     define output parameter p-output-display as logical   no-undo .
      468     define output parameter p-other          as character no-undo .
      469     do
      470     on error undo, return error return-value
      471     :
      472           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      473         (input  p-code
      474         ,output p-type
      475         ,output p-format
      476         ,output p-label
      477         ,output p-user-can-edit
      478         ,output p-output-display
      479         ,output p-other
      480         ) no-error .
      481       if error-status :error
      482       then do:
      483         undo, return error return-value .
      484       end.
      485     end.
      486   end procedure.
      487   procedure clntattr-tooltip :
      488     define input  parameter p-code    as character no-undo .
      489     define output parameter p-tooltip as character no-undo .
      490     define output parameter p-label   as character no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      495         (input  p-code
      496         ,output p-tooltip
      497         ,output p-label
      498         ) no-error .
      499       if error-status :error
      500       then do:
      501         undo, return error return-value .
      502       end.
      503     end.
      504   end procedure.
      505   procedure clntattr-value :
      506     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      507     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
