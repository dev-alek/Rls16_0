     1385             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     1386             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     1387             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     1388             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     1389             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
