     1955      find first ub.sysconf where ub.sysconf.host-code = v-cntxt-host-code-obj no-lock.
     1956      if lookup (string(ub.sysconf.purch-code), '1,2,3':U) = 0 then do:
     1957        if not is-rt then
     1958    message "Неверный код типа приобретения по умолчанию. " skip
     1959                 "Допустимые типы: "
     1960         view-as alert-box error.
     1961         return error "Неверный код типа приобретения по умолчанию. ".
     1962      end.
     1963   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     1964   (input tt-trn-doc.acc-date
     1965   ,input tt-trn-doc.bge-date
