     1366             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1367             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1368             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1369             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1370             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1371             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     1372             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1373             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1374             .
     1375         end.
     1376         when 'маг':U then do:
     1377           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     1378           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     1379           assign
