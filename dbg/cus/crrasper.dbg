     2219   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220   run lib-trn_copy-inqu (
     2221       input new_trn-doc.doc-code
     2222     , input new_trn-doc.doc-type
     2223     , input new_trn-doc.status_
