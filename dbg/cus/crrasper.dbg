     1404     end.
     1405   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   procedure proc-ord-code :
     1407   define input  parameter  p-type as character no-undo .
     1408   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1409   define input  parameter  v-cntxt-obj-type as character no-undo .
     1410   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1411   define input  parameter  p-i-doc    as character no-undo .
     1412   define output parameter  p-ord-doc  as character no-undo .
     1413   define variable          v-idop     as character no-undo .
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417   case p-type :
     1418       when "main-no-ver" then do:
     1419         if  (v-cntxt-db-num <> 0) then
     1420           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1421         else
     1422           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1423       end.
     1424       when "main" then do:
     1425             do while true:
     1426             if  (v-cntxt-db-num <> 0) then
     1427               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1428             else
     1429               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1430             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1431             End.
     1432       end.
     1433       when "chip" then do:
     1434         assign
     1435           v-idop = p-i-doc .
     1436         do while true :
     1437           if index (v-idop , ".") = 0 then
     1438             v-idop  = replace (v-idop , "-", "-1.").
     1439           else
     1440             v-idop  =
     1441             substring (v-idop , 1, index (v-idop, "-")) +
     1442             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1443             substring (v-idop, index (v-idop, ".")).
     1444           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1445         end.
     1446         assign
     1447           p-ord-doc = v-idop.
     1448       end.
     1449   end case.
     1450     end.
     1451   end procedure.
     1452   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1453   procedure create-chain :
     1454   define input  parameter p-doc-code as character no-undo .
     1455   define input  parameter p-doc-type as character no-undo .
     1456   define input  parameter p-rel-doc-code as character no-undo .
     1457   define input  parameter p-rel-doc-type as character no-undo .
     1458   define input  parameter p-type as character no-undo .
     1459   define input  parameter p-ps as character no-undo .
     1460   define variable v-db-num as integer   no-undo .
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464     find first ub.sys-ctrl no-lock .
     1465     v-db-num = ub.sys-ctrl.db-num .
     1466     find first ub.ord-chain no-lock where
     1467       ub.ord-chain.doc-code     = p-doc-code     and
     1468       ub.ord-chain.doc-type     = p-doc-type     and
     1469       ub.ord-chain.rel-type     = p-type         and
     1470       ub.ord-chain.rel-doc-code = p-rel-doc-code and
     1471       ub.ord-chain.rel-doc-type = p-rel-doc-type   no-error .
     1472     if available ub.ord-chain then return .
     1473     create ub.ord-chain.
     1474     assign
     1475       ub.ord-chain.doc-code     = p-doc-code
     1476       ub.ord-chain.doc-type     = p-doc-type
     1477       ub.ord-chain.ps           = p-ps
     1478       ub.ord-chain.rel-doc-code = p-rel-doc-code
     1479       ub.ord-chain.rel-doc-type = p-rel-doc-type
     1480       ub.ord-chain.rel-id       = next-value( s-ord-ch, ub )
     1481       ub.ord-chain.db-num       = v-db-num
     1482       ub.ord-chain.rel-type     = p-type
     1483       .
     1484     end.
     1485   end procedure.
