     2015         new_trn-doc.hold-doc-code-parent = "no-hold":u
     2016         parrec-doc = recid(new_trn-doc)
     2017      .
     2018   define variable v-err2 as logical   no-undo .
     2019     v-err2 = false .
     2020     for each  old_doc-ord-line no-lock  where
     2021               old_doc-ord-line.doc-code = old_trn-ord-doc.doc-code :
     2022              find first buf_goods no-lock where
     2023                         buf_goods.artic     =  old_doc-ord-line.artic and
     2024                         buf_goods.prod-type =  old_doc-ord-line.prod-type and
     2025                         buf_goods.prod-code =  old_doc-ord-line.prod-code
     2026                         no-error .
     2027       if buf_goods.stts <> 0 then do:
     2028             if LENGTH(new_trn-doc.Ps) < 31900 then do:
     2029                 new_trn-doc.Ps = trim(new_trn-doc.Ps) + chr(10) + 'товар удален '  + old_doc-ord-line.artic.
     2030             end.
     2031             put stream str unformatted
