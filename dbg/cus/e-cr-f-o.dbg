     1538     end.
     1539     ON CHOOSE OF MENU-ITEM m-ed-date17-1 in menu m-ed-date17 DO:
     1540       apply "ctrl-b":U to date-sale-2 in frame F-Main .
     1541     END.
     1542     ON CHOOSE OF MENU-ITEM m-ed-date17-2 in menu m-ed-date17 DO:
     1543       apply "ctrl-d":U to date-sale-2 in frame F-Main .
     1544     END.
     1545     ON CHOOSE OF MENU-ITEM m-ed-date17-3 in menu m-ed-date17 DO:
     1546       apply "ctrl-e":U to date-sale-2 in frame F-Main .
     1547     END.
     1548     ON CHOOSE OF MENU-ITEM m-ed-date17-4 in menu m-ed-date17 DO:
     1549       apply "ctrl-f":U to date-sale-2 in frame F-Main .
     1550     END.
     1551   PROCEDURE adm-row-available :
     1552     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1553     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1554     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1555     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1556     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1557     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1558     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1559     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1560     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1561     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1562     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1563     IF adm-updating-record THEN RETURN.
     1564     RUN get-attribute ('FIELDS-ENABLED':U).
     1565     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1566     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1567         OUTPUT link-handle) NO-ERROR.
     1568     IF link-handle = "":U THEN
     1569         RETURN.
     1570     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1571     IF NUM-ENTRIES(link-handle) > 1 THEN
     1572         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1573             "encountered more than one RECORD-SOURCE.":U SKIP
     1574             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1575                VIEW-AS ALERT-BOX ERROR.
     1576     RUN get-attribute ('Key-Name':U).
     1577     key-name = RETURN-VALUE.
     1578     IF key-name = "":U THEN key-name = ?.
     1579     IF key-name NE ? THEN DO:
     1580       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1581         NO-ERROR.
     1582       IF key-value NE ? THEN
     1583         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1584     END.
     1585   IF VALID-HANDLE (adm-object-hdl) THEN
     1586       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1587   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1588   END PROCEDURE.
     1589   PROCEDURE disable_UI :
     1590     HIDE FRAME F-Main.
     1591     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1592   END PROCEDURE.
     1593   PROCEDURE my-report :
     1594   run cus/o-cr-f-o.p
     1595          ( input T-sale,
     1596            input date-sale-1 ,
     1597            input date-sale-2 ) .
     1598   END PROCEDURE.
     1599   PROCEDURE my-var :
     1600   assign frame F-Main date-sale-1 date-sale-2 T-sale .
     1601    ReportHeader =
     1602    (if t-sale then "По периоду продаж  с " + string(date-sale-1,"99/99/9999") + " по " + string(date-sale-2,"99/99/9999")  else "" ).
     1603   END PROCEDURE.
     1604   PROCEDURE send-records :
     1605   END PROCEDURE.
     1606   PROCEDURE state-changed :
     1607     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1608     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1609     CASE p-state:
     1610       WHEN 'update-begin':U THEN DO:
     1611           RUN dispatch('enable-fields':U).
     1612           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1613           DO:
     1614             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1615             RUN new-state('update-complete':U).
     1616           END.
     1617           ELSE RUN new-state ('update':U).
     1618       END.
     1619       WHEN 'update-complete':U THEN DO:
     1620           RUN new-state ('update-complete':U).
     1621       END.
     1622     END CASE.
     1623   END PROCEDURE.
