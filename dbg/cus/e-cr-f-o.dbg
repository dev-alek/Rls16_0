      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   RUN set-attribute-list (
      679       'Keys-Accepted = "",
      680        Keys-Supplied = ""':U).
      681   DEFINE VARIABLE date-sale-1 AS DATE FORMAT "99/99/9999":U
      682        LABEL "c"
      683        VIEW-AS FILL-IN NATIVE
      684        SIZE 11.38 BY 1 NO-UNDO.
      685   DEFINE VARIABLE date-sale-2 AS DATE FORMAT "99/99/9999":U
      686        LABEL "по"
      687        VIEW-AS FILL-IN NATIVE
      688        SIZE 11.38 BY 1 NO-UNDO.
      689   DEFINE RECTANGLE RECT-9
      690        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      691        SIZE 77.63 BY 17.38.
      692   DEFINE VARIABLE T-sale AS LOGICAL INITIAL no
      693        LABEL "Отбор по периоду продаж"
      694        VIEW-AS TOGGLE-BOX
      695        SIZE 26.13 BY .83 NO-UNDO.
      696   DEFINE FRAME F-Main
      697        T-sale AT ROW 1.38 COL 2.13
      698        date-sale-1 AT ROW 2.63 COL 12.63 COLON-ALIGNED
      699        date-sale-2 AT ROW 3.83 COL 12.63 COLON-ALIGNED
      700        RECT-9 AT ROW 1.04 COL 1.13
      701       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      702            SIDE-LABELS NO-UNDERLINE THREE-D
      703            AT COL 1 ROW 1 SCROLLABLE .
      704   ASSIGN
      705          FRAME F-Main:SCROLLABLE       = FALSE
      706          FRAME F-Main:HIDDEN           = TRUE.
      707   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      708   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      709   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      710   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      711   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      712   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      713   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      714   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      715         adm-object-hdl = FRAME F-Main:HANDLE.
      716   RUN ensure-broker.
      717   THIS-PROCEDURE:ADM-DATA =
      718        'ADM1.1~`':U +
      719        'SmartObject~`':U +
      720        '~`':U +
      721        'NO ~`':U +
      722        '~`':U +
      723        '~`':U +
      724        '~`':U +
      725        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      726           + "~`":U +
      727        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      728        'Record-Source,Record-Target,TableIO-Target~`':U +
      729        '~`':U +
      730        '~`~`~`~`~`~`~`~`~`~`~`':U +
      731        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      732            THEN "^^":U
      733        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      734             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      735   PROCEDURE adm-apply-entry :
      736     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      737   END PROCEDURE.
      738   PROCEDURE adm-destroy :
      739    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      740   END PROCEDURE.
      741   PROCEDURE adm-disable :
      742       DISABLE RECT-9 T-sale WITH FRAME F-Main.
      743       RUN dispatch ('disable-fields':U).
      744       RUN set-attribute-list ('ENABLED=no':U).
      745       RETURN.
      746   END PROCEDURE.
      747   PROCEDURE adm-edit-attribute-list :
      748         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      749         RETURN.
      750   END PROCEDURE.
      751   PROCEDURE adm-enable :
      752       ENABLE UNLESS-HIDDEN RECT-9 T-sale WITH FRAME F-Main.
      753       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      754       RUN set-attribute-list ('ENABLED=yes':U).
      755       RETURN.
      756   END PROCEDURE.
      757   PROCEDURE adm-exit :
      758        RUN notify ('exit':U).
      759     RETURN.
      760   END PROCEDURE.
      761   PROCEDURE adm-hide :
      762     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      763   END PROCEDURE.
      764   PROCEDURE adm-initialize :
      765     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      766   END PROCEDURE.
      767   PROCEDURE adm-show-errors :
      768       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      769       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      770           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      771       END.
      772       RETURN.
      773   END PROCEDURE.
      774   PROCEDURE adm-UIB-mode :
      775     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      776   END PROCEDURE.
      777   PROCEDURE adm-view :
      778     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      779   END PROCEDURE.
      780   PROCEDURE dispatch :
      781       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      782       RUN broker-dispatch IN adm-broker-hdl
      783           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      784       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      785   END PROCEDURE.
      786   PROCEDURE ensure-broker :
      787   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      788   IF RETURN-VALUE NE "ADM-Broker":U THEN
      789   DO:
      790       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      791       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      792   END.
      793   END PROCEDURE.
      794   PROCEDURE get-attribute :
      795     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      796     RUN broker-get-attribute IN adm-broker-hdl
      797         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      798     RETURN RETURN-VALUE.
      799   END PROCEDURE.
      800   PROCEDURE get-attribute-list :
      801     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      802     RUN broker-get-attribute-list IN adm-broker-hdl
      803         (INPUT THIS-PROCEDURE,
      804          INPUT ?,
      805          OUTPUT p-attr-list) NO-ERROR.
      806     RETURN.
      807   END PROCEDURE.
      808   PROCEDURE new-state :
      809     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      810     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      811     RETURN.
      812   END PROCEDURE.
      813   PROCEDURE notify :
      814     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      815     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      816     IF RETURN-VALUE = "ADM-ERROR":U THEN
      817         RETURN "ADM-ERROR":U.
      818     RETURN.
      819   END PROCEDURE.
      820   PROCEDURE set-attribute-list :
      821     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      822     RUN ensure-broker.
      823     RUN broker-set-attribute-list IN adm-broker-hdl
      824         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      825     RETURN.
      826   END PROCEDURE.
      827   PROCEDURE set-position :
      828       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      829       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      830       IF VALID-HANDLE(adm-object-hdl) THEN
      831       DO:
      832         ASSIGN adm-object-hdl:ROW    =   p-row
      833                adm-object-hdl:COLUMN =   p-col.
      834       END.
      835       RETURN.
      836   END PROCEDURE.
      837   PROCEDURE adm-display-fields :
      838       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      839       RETURN.
      840   END PROCEDURE.
      841   PROCEDURE adm-open-query :
      842     RETURN.
      843   END PROCEDURE.
      844   PROCEDURE adm-row-changed :
      845         IF VALID-HANDLE(adm-object-hdl) THEN
      846           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      847         RUN notify ('row-available':U).
      848         RETURN.
      849   END PROCEDURE.
      850   PROCEDURE reposition-query :
      851       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      852       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      853       RETURN.
      854   END PROCEDURE.
      855     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      856     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      857     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      858     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      859     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      860     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      861     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      862     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      863     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      864     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      865     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      866     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      867     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      868     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      869     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      870     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      871     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      872     IF "":U = "":U THEN
      873       RUN modify-list-attribute IN adm-broker-hdl
      874         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      875     RUN use-create-on-add(?).
      876   PROCEDURE adm-add-record :
      877       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      878          "must have at least one Enabled Table to perform Add.":U
      879          VIEW-AS ALERT-BOX ERROR.
      880       RETURN.
      881   END PROCEDURE.
      882   PROCEDURE adm-assign-record :
      883    MESSAGE
      884          "Object ":U THIS-PROCEDURE:FILE-NAME
      885            "must have at least one Enabled Table to perform Assign.":U
      886              VIEW-AS ALERT-BOX ERROR.
      887      RETURN.
      888     END PROCEDURE.
      889   PROCEDURE adm-assign-statement :
      890     RETURN.
      891   END PROCEDURE.
      892   PROCEDURE adm-cancel-record :
      893      RETURN.
      894     END PROCEDURE.
      895   PROCEDURE adm-copy-record :
      896       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      897        "must have at least one Enabled Table to perform Copy.":U
      898          VIEW-AS ALERT-BOX ERROR.
      899       RETURN.
      900   END PROCEDURE.
      901   PROCEDURE adm-create-record :
      902      RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-current-changed :
      905     RETURN.
      906   END PROCEDURE.
      907   PROCEDURE adm-delete-record :
      908    MESSAGE
      909          "Object ":U THIS-PROCEDURE:FILE-NAME
      910            "must have at least one Enabled Table to perform Delete.":U
      911              VIEW-AS ALERT-BOX ERROR.
      912       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      913       RETURN.
      914   END PROCEDURE.
      915   PROCEDURE adm-disable-fields :
      916         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      917       RETURN.
      918   END PROCEDURE.
      919   PROCEDURE adm-enable-fields :
      920       RETURN.
      921   END PROCEDURE.
      922   PROCEDURE adm-end-update :
      923     RETURN.
      924   END PROCEDURE.
      925   PROCEDURE adm-reset-record :
      926       RETURN.
      927   END PROCEDURE.
      928   PROCEDURE adm-update-record :
      929       MESSAGE
      930         "Object ":U THIS-PROCEDURE:FILE-NAME
      931           "must have at least one Enabled Table to perform Update.":U
      932             VIEW-AS ALERT-BOX ERROR.
      933      RETURN.
      934   END PROCEDURE.
      935   PROCEDURE check-modified :
      936   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      937   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      938   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      939   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      940     IF check-state = "check":U THEN
      941     DO:
      942       RUN get-link-handle IN adm-broker-hdl
      943         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      944            OUTPUT group-target-list).
      945       IF group-target-list NE "":U THEN
      946       DO i = 1 TO NUM-ENTRIES(group-target-list):
      947         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      948         RUN check-modified IN curr-widget ('group-check':U).
      949         IF RETURN-VALUE NE "":U THEN
      950         DO:
      951           RUN check-modified-message(RETURN-VALUE).
      952           RETURN "":U.
      953         END.
      954       END.
      955     END.
      956     RETURN "":U.
      957   END PROCEDURE.
      958   PROCEDURE check-modified-message :
      959     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      960        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      961           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      962        IF RETURN-VALUE = "YES":U THEN
      963           RUN notify ('view,CONTAINER-SOURCE':U).
      964        MESSAGE IF p-changed-table NE ? THEN
      965           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      966           ELSE "Current values have been changed."
      967           SKIP "  Do you wish to save those changes?"
      968           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      969        IF ANS THEN
      970        DO:
      971           IF group-assign-target THEN
      972             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      973           ELSE RUN dispatch('update-record':U).
      974           IF RETURN-VALUE = "ADM-ERROR":U THEN
      975           DO:
      976               MESSAGE "Changes to the previous record were not saved."
      977                 VIEW-AS ALERT-BOX ERROR.
      978               IF group-assign-target THEN
      979                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      980               ELSE RUN dispatch ('cancel-record':U).
      981           END.
      982        END.
      983        ELSE DO:
      984          IF group-assign-target THEN
      985             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      986          ELSE RUN dispatch('cancel-record':U).
      987        END.
      988        RETURN.
      989   END PROCEDURE.
      990   PROCEDURE get-rowid :
      991       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      992       ASSIGN
      993       p-table   =   adm-first-table.
      994       RETURN.
      995   END PROCEDURE.
      996   PROCEDURE init-group-assign :
      997       RUN request-attribute IN adm-broker-hdl
      998         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      999       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1000         group-assign-target = yes.
     1001       ELSE group-assign-target = no.
     1002       RETURN.
     1003   END PROCEDURE.
     1004   PROCEDURE set-editors :
     1005       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1006       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1007       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1008       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1009       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1010       DO WHILE VALID-HANDLE (curr-widget):
     1011           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1012              curr-widget:HIDDEN = no THEN DO:
     1013             CASE p-field-setting:
     1014               WHEN "INITIALIZE":U THEN
     1015               DO:
     1016                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1017                     read-only-list +
     1018                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1019                        STRING(curr-widget).
     1020               END.
     1021               WHEN "DISABLE":U OR
     1022               WHEN "ENABLE":U THEN
     1023               DO:
     1024                   curr-widget:SENSITIVE = yes.
     1025                   RUN get-attribute ('Read-Only-Editors':U).
     1026                   IF RETURN-VALUE = ? OR
     1027                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1028                       curr-widget:READ-ONLY =
     1029                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1030               END.
     1031               WHEN "CLEAR":U THEN
     1032                   curr-widget:SCREEN-VALUE = "":U.
     1033             END CASE.
     1034           END.
     1035           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1036       END.
     1037       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1038         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1039           + '"':U).
     1040       RETURN.
     1041   END PROCEDURE.
     1042   PROCEDURE use-check-modified-all :
     1043    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1044     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1045     RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE use-create-on-add :
     1048   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1049      RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE use-initial-lock :
     1052     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1053     ASSIGN adm-initial-lock = p-attr-value.
     1054     RETURN.
     1055   END PROCEDURE.
     1056     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1057   ON LEAVE OF date-sale-1 IN FRAME F-Main
     1058   DO :
     1059     assign date-sale-1 date-sale-2 .
     1060     if ( date-sale-2 <> ? and    date-sale-1 <> ? ) and
     1061        ( date-sale-1 > date-sale-2 ) then do:
     1062                                      message "Дата начала не верна!" view-as alert-box .
     1063                                      return no-apply.
     1064                                      end.
     1065   END .
     1066   ON LEAVE OF date-sale-2 IN FRAME F-Main
     1067   DO:
     1068       assign date-sale-1 date-sale-2 .
     1069     if ( date-sale-2 <> ? and    date-sale-1 <> ? ) and
     1070        ( date-sale-1 > date-sale-2 ) then do: message "Дата конца введена не верно!" view-as alert-box . .
     1071        return no-apply.
     1072        end.
     1073   END.
     1074   ON VALUE-CHANGED OF T-sale IN FRAME F-Main
     1075   DO:
     1076    assign frame F-Main  T-sale .
     1077   if T-sale = true  then do:
     1078           display  date-sale-1 date-sale-2 with frame F-Main .
     1079           enable  date-sale-1 date-sale-2 with frame F-Main .
     1080   end.
     1081   else do:
     1082           display  date-sale-1 date-sale-2 with frame F-Main .
     1083           disable  date-sale-1 date-sale-2 with frame F-Main .
     1084   end.
     1085   END.
     1086   if not this-procedure :persistent
     1087   then do:
     1088     message
     1089       vss-workfile vss-revision vss-description skip
     1090       "Ошибка при запуске процедуры" skip
     1091       "Данную процедуру следует запускать только с параметром persistent" skip
     1092       view-as alert-box error .
     1093     undo, return error .
     1094   end.
     1095   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1097     (input  v-cntxt-obj-type
