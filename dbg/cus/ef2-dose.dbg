        1   block-level on error undo, throw.
        2   define input  parameter p-rid  as recid no-undo.
        3   define output parameter p-dose as decimal no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: ef2-dose.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/ef2-dose.p $":U .
        9   define variable vss-description as character no-undo init "Определение допустимой дозы для EasyFuel2".
       10   define buffer buf_cd-doc for ub.cd-doc.
       11   do:
       12     find first buf_cd-doc no-lock where recid(buf_cd-doc) = p-rid no-error.
       13     if available buf_cd-doc then p-dose = buf_cd-doc.DecKey_One - buf_cd-doc.DecKey_Two - buf_cd-doc.DecKey_Three.
       14     else p-dose = ?.
       15   end.
