      219   procedure last-price :
      220   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      221   define input parameter  p-host-code     as integer no-undo .
      222   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
      223   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
      224   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
      225   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
      226   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
      227   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
      228   define input parameter  p-curr-code  as integer   no-undo .
      229   define output parameter p-price-base like ub.doc-line.price-base no-undo .
      230   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
      231   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
      232   define buffer buf-lib-doc-line for ub.doc-line.
      233   define buffer buf_cli-gds for ub.cli-gds .
      234   define buffer buf_trn-doc for ub.trn-doc  .
      235   define variable vp-curr-code  like ub.trn-doc.exch-code.
      236   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
      237   define variable vp-exch-scale like ub.trn-doc.exch-scale.
      238   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
      239   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
      240   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
      241   define variable v-cli-base-rate as decimal   no-undo .
      242    find first buf_cli-gds no-lock where
      243               buf_cli-gds.cli-type   = p-cli-type    and
      244               buf_cli-gds.cli-code   = p-cli-code    and
      245               buf_cli-gds.host-code  = p-host-code   and
      246               buf_cli-gds.artic      = p-artic       and
      247               buf_cli-gds.prod-type  = p-prod-type   and
      248               buf_cli-gds.prod-code  = p-prod-code
      249               no-error .
      250   if available buf_cli-gds then do:
      251       find first buf_trn-doc no-lock
      252            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
      253        if available buf_trn-doc then do:
      254           vp-curr-code  = buf_trn-doc.exch-code.
      255           vp-exch-rate  = buf_trn-doc.exch-rate.
      256           vp-exch-scale = buf_trn-doc.exch-scale.
      257        end.
      258       find first buf-lib-doc-line no-lock
      259         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
      260           and buf-lib-doc-line.artic     = p-artic
      261           and buf-lib-doc-line.prod-type = p-prod-type
      262           and buf-lib-doc-line.prod-code = p-prod-code
      263         no-error .
      264   end.
      265   else do:
      266   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      267   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      268     (input  p-host-code
      269     ,input  p-artic
      270     ,input  p-prod-type
      271     ,input  p-prod-code
      272     ,output v-last-in-code
      273     ,output v-last-obj-type
      274     ,output v-last-obj-code
      275     )  .
      276       find first buf_trn-doc no-lock
      277            where buf_trn-doc.doc-code  = v-last-in-code no-error .
      278        if available buf_trn-doc then do:
      279           vp-curr-code  = buf_trn-doc.exch-code.
      280           vp-exch-rate  = buf_trn-doc.exch-rate.
      281           vp-exch-scale = buf_trn-doc.exch-scale.
      282        end.
      283       find first buf-lib-doc-line no-lock
      284         where buf-lib-doc-line.doc-code  = v-last-in-code
      285           and buf-lib-doc-line.artic     = p-artic
      286           and buf-lib-doc-line.prod-type = p-prod-type
      287           and buf-lib-doc-line.prod-code = p-prod-code
      288         no-error .
      289   end.
      290       if available buf-lib-doc-line then do:
      291         assign
      292           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
      293           p-price-base = buf-lib-doc-line.price-base
      294           p-price-rubl = buf-lib-doc-line.price-rubl
      295           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
      296         .
      297         if v-cli-base-rate <> p-cli-base-rate
      298         then do:
      299             p-price-cli  = p-price-cli / v-cli-base-rate  .
      300         end.
      301          if p-curr-code <> vp-curr-code then do:
      302             p-price-cli  = p-price-rubl  .
      303         end.
      304       end.
      305       Else do:
      306         assign
      307           p-price-base = 0
      308           p-price-rubl = 0
      309           p-price-cli  = 0
      310         .
      311       end.
      312     end.
      313   end procedure.
