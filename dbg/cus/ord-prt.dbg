      642        SIZE 97.75 BY 4.33.
      643   DEFINE FRAME d-out-prt
      644        b-exit AT ROW 1.29 COL 2
      645        b-help AT ROW 2.29 COL 2
      646        b-ord-gds-dtl.qnty AT ROW 9.21 COL 82.88 COLON-ALIGNED NO-LABEL
      647             VIEW-AS FILL-IN NATIVE
      648             SIZE 13 BY 1
      649             FGCOLOR 4
      650        b-ord-gds-dtl.price-rubl AT ROW 9.29 COL 6.63 COLON-ALIGNED
      651             LABEL "Цена"
      652             VIEW-AS FILL-IN NATIVE
      653             SIZE 17 BY 1
      654             FGCOLOR 4
      655        b-ord-gds-dtl.price-base AT ROW 9.29 COL 30.5 COLON-ALIGNED NO-LABEL
      656             VIEW-AS FILL-IN  NATIVE
      657             SIZE 17 BY 1
      658             FGCOLOR 4
      659        b-ord-gds-dtl.price-cli AT ROW 9.29 COL 50.5 COLON-ALIGNED NO-LABEL
      660             VIEW-AS FILL-IN  NATIVE
      661             SIZE 18.13 BY 1
      662             BGCOLOR 15 FGCOLOR 4
      663        b-ord-gds-dtl.cli-qnty AT ROW 10.38 COL 82.88 COLON-ALIGNED NO-LABEL
      664             VIEW-AS FILL-IN  NATIVE
      665             SIZE 13 BY 1
      666             FGCOLOR 4
      667        b-ord-gds-dtl.artic AT ROW 1.67 COL 9.38 COLON-ALIGNED NO-LABEL
      668              VIEW-AS TEXT
      669             SIZE 16.5 BY 1
      670        ub.goods.gds-name AT ROW 1.67 COL 26.5 COLON-ALIGNED NO-LABEL
      671              VIEW-AS TEXT
      672             SIZE 68.88 BY 1
      673             FGCOLOR 4
      674        b-ord-gds-dtl.prod-code AT ROW 3 COL 9.25 COLON-ALIGNED NO-LABEL
      675              VIEW-AS TEXT
      676             SIZE 12.63 BY 1
      677        b-ord-gds-dtl.prod-type AT ROW 3 COL 22.13 COLON-ALIGNED NO-LABEL
      678              VIEW-AS TEXT
      679             SIZE 16.63 BY 1
      680        ub.clients.obj-name AT ROW 3 COL 39 COLON-ALIGNED NO-LABEL
      681              VIEW-AS TEXT
      682             SIZE 56.25 BY 1
      683             FGCOLOR 4
      684        ub.bar-code.b-code AT ROW 4.79 COL 17 COLON-ALIGNED
      685              VIEW-AS TEXT
      686             SIZE 10 BY .58
      687             FGCOLOR 4
      688        ub.gds-prt.f-name AT ROW 4.79 COL 27.88 COLON-ALIGNED NO-LABEL
      689              VIEW-AS TEXT
      690             SIZE 39.75 BY .58
      691             FGCOLOR 4
      692        ub.prt-obj.free-qnty AT ROW 4.79 COL 78.88 COLON-ALIGNED
      693              VIEW-AS TEXT
      694             SIZE 16.25 BY .58
      695             FGCOLOR 4
      696        ub.price-list.doc-num AT ROW 5.63 COL 16.88 COLON-ALIGNED
      697              VIEW-AS TEXT
      698             SIZE 16 BY .58
      699        ub.goods.unit-base AT ROW 9.29 COL 77.75 COLON-ALIGNED NO-LABEL
      700              VIEW-AS TEXT
      701             SIZE 4 BY 1
      702             FGCOLOR 4
      703        ub.goods.unit-cli AT ROW 10.38 COL 77.63 COLON-ALIGNED NO-LABEL
      704              VIEW-AS TEXT
      705             SIZE 4 BY 1
      706             BGCOLOR 3 FGCOLOR 15
      707        tot-base AT ROW 10.46 COL 30.5 COLON-ALIGNED NO-LABEL
      708        tot-cli AT ROW 10.46 COL 50.5 COLON-ALIGNED NO-LABEL
      709        tot-rubl AT ROW 10.71 COL 6.38 COLON-ALIGNED
      710        ub.goods.qnty-cart AT ROW 11.58 COL 96.88 RIGHT-ALIGNED
      711             LABEL "Кол.в упак."
      712              VIEW-AS TEXT
      713             SIZE 13 BY .6
      714             FGCOLOR 4
      715        cli-curr AT ROW 11.75 COL 50.75 COLON-ALIGNED NO-LABEL
      716        base-curr AT ROW 11.83 COL 30.5 COLON-ALIGNED NO-LABEL
      717        RECT-5 AT ROW 4.42 COL 1.13
      718        RECT-4 AT ROW 1.25 COL 9.75
      719        RECT-3 AT ROW 10.29 COL 71.88
      720        RECT-1 AT ROW 8.79 COL 1
      721        "РУБ" VIEW-AS TEXT
      722             SIZE 4 BY 1 AT ROW 11.83 COL 8.63
      723             FGCOLOR 4
      724        RECT-2 AT ROW 8.92 COL 51.75
      725        SPACE(27.49) SKIP(0.16)
      726       WITH VIEW-AS DIALOG-BOX
      727            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      728            TITLE ""
      729            DEFAULT-BUTTON b-exit.
      730   ASSIGN
      731          FRAME d-out-prt:SCROLLABLE       = FALSE.
      732   find b-ord-line where     b-ord-line.prod-code  = b-ord-gds-dtl.prod-code
      733                         and b-ord-line.prod-type  = b-ord-gds-dtl.prod-type
      734                         and b-ord-line.artic      = b-ord-gds-dtl.artic
      735                         no-lock.
      736   assign
      737     loc-cli-base-rate = b-ord-line.cli-base-rate.
      738   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   ON LEAVE OF b-ord-gds-dtl.cli-qnty IN FRAME d-out-prt
      740   DO:
      741   define variable varprt-obj_free-qnty like ub.prt-obj.free-qnty no-undo.
      742   IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-cli
      743                       and LOOKUP('шту':U, ub.units.type) > 0 )  AND
      744      TRUNC(input frame d-out-prt b-ord-gds-dtl.cli-qnty, 0)
      745      <>    input frame d-out-prt b-ord-gds-dtl.cli-qnty
      746      THEN DO:
      747         MESSAGE "Единица изм поставщика " ub.goods.unit-cli " - штучная." skip
      748                 "Кол-во должно быть целым."
      749         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      750         RETURN NO-APPLY.
      751     END.
      752   if ub.goods.qnty-cart <> 0 then do:
      753     if input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart -
      754     truncate ( input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart , 0 ) <> 0 then do:
      755         g#log = yes.
      756         message "Товар рекомендуется выписывать упаковками." skip (2)
      757                 "Округлить до целого числа упаковок ?"
      758                  view-as alert-box question buttons yes-no update g#log .
      759         if g#log then do:
      760           if round (input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart, 0) = 0 then do:
      761             display
      762                 ub.goods.qnty-cart @ b-ord-gds-dtl.cli-qnty
      763                 with frame d-out-prt.
      764           end.
      765           else do:
      766             display
      767               round ( input frame d-out-prt b-ord-gds-dtl.cli-qnty / ub.goods.qnty-cart, 0) * ub.goods.qnty-cart @ b-ord-gds-dtl.cli-qnty
      768               with frame d-out-prt.
      769           end.
      770         end.
      771     end.
      772   end.
      773      KK = b-ord-line.cli-base-rate.
      774     if lookup('cli-base-rate',parcli-qnty-calc) = 0 then do:
      775     assign
      776       tot-cli = input frame d-out-prt b-ord-gds-dtl.price-cli * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      777       b-ord-gds-dtl.qnty = ( input frame d-out-prt b-ord-gds-dtl.cli-qnty ) * kk .
      778       DISPLAY  tot-cli b-ord-gds-dtl.qnty   WITH FRAME d-out-prt.
      779     apply "leave" to b-ord-gds-dtl.qnty .
      780     DISPLAY  tot-cli b-ord-gds-dtl.qnty WITH FRAME d-out-prt.
      781     run ass-var in this-procedure .
      782     end.
      783   END.
      784   ON LEAVE OF b-ord-gds-dtl.qnty IN FRAME d-out-prt
      785   DO:
      786    IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-base
      787                       and LOOKUP('шту':U, ub.units.type) > 0)  AND
      788      TRUNC(input frame d-out-prt b-ord-gds-dtl.qnty, 0)
      789      <>    input frame d-out-prt b-ord-gds-dtl.qnty
      790      THEN DO:
      791         MESSAGE "Базовая единица товара " ub.goods.unit-base " - штучная." skip
      792                 "Кол-во по факту должно быть целым."
      793         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      794         RETURN no-apply.
      795     END.
      796    if pardoc-qnty-input = true then do:
      797       if lookup('cli-base-rate',parcli-qnty-calc) > 0 then do:
      798        assign
      799           kk = (input frame d-out-prt b-ord-gds-dtl.qnty) / (input frame d-out-prt b-ord-gds-dtl.cli-qnty )
      800        .
      801        if kk  = ? then kk = 1.
      802        b-ord-line.cli-base-rate = kk  .
      803       end.
      804       else do:
      805           if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
      806             kk = ub.goods.cli-base-rate .
      807             else KK = b-ord-line.cli-base-rate .
      808           assign
      809               b-ord-gds-dtl.cli-qnty = input frame d-out-prt b-ord-gds-dtl.qnty / kk
      810               tot-cli = input frame d-out-prt b-ord-gds-dtl.price-cli * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      811               .
      812               DISPLAY  tot-cli b-ord-gds-dtl.cli-qnty   WITH FRAME d-out-prt.
      813          end.
      814     run ass-var in this-procedure .
      815     end.
      816   END.
      817   ON LEAVE OF b-ord-gds-dtl.price-base IN FRAME d-out-prt
      818   DO:
      819   if input frame d-out-prt b-ord-gds-dtl.price-base > 5000 and base-code = 1 then
      820     message "Внимание !!!" skip (2)
      821                     "ВАЛЮТНАЯ цена превышает 5,000 !" skip (2)
      822                     "Вы не ошиблись ?".
      823   if b-ord-gds-dtl.price-base <> input frame d-out-prt b-ord-gds-dtl.price-base then
      824     assign
      825       b-ord-gds-dtl.price-rubl = input frame d-out-prt b-ord-gds-dtl.price-base * loc-base-rate / loc-base-scale
      826       b-ord-gds-dtl.price-cli  = b-ord-gds-dtl.price-rubl / loc-exch-rate * loc-exch-scale *
      827        loc-cli-base-rate
      828       .
      829       DISPLAY
      830       b-ord-gds-dtl.price-RUBL
      831       b-ord-gds-dtl.price-cli
      832       WITH FRAME d-out-prt .
      833    run ass-var in this-procedure  .
      834   END.
      835   ON LEAVE OF b-ord-gds-dtl.price-rubl IN FRAME d-out-prt
      836   DO:
      837   if b-ord-gds-dtl.price-rubl <> input frame d-out-prt b-ord-gds-dtl.price-rubl then
      838     assign
      839       b-ord-gds-dtl.price-base = input frame d-out-prt b-ord-gds-dtl.price-rubl / loc-base-rate * loc-base-scale
      840       b-ord-gds-dtl.price-cli  = input frame d-out-prt b-ord-gds-dtl.price-rubl / loc-exch-rate * loc-exch-scale /
      841        loc-cli-base-rate
      842       .
      843       DISPLAY
      844       b-ord-gds-dtl.price-base
      845       b-ord-gds-dtl.price-cli
      846       WITH FRAME d-out-prt .
      847       run ass-var in this-procedure .
      848   END.
      849   ON LEAVE OF b-ord-gds-dtl.price-cli IN FRAME d-out-prt
      850   DO:
      851   if b-ord-gds-dtl.price-cli <> input frame d-out-prt b-ord-gds-dtl.price-cli then
      852     assign
      853       tot-cli = input frame d-out-prt b-ord-gds-dtl.price-cli *  input frame d-out-prt b-ord-gds-dtl.cli-qnty
      854       .
      855    run ass-var in this-procedure .
      856   END.
      857   procedure ass-var :
      858    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      859    assign
      860       pargds-code =  ub.goods.gds-code
      861       parobj-type =  loc-store-type
      862       parobj-code =  loc-store-code
      863    .
      864   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_kndinpin in g#lib-calc
      865     (
      866      input  pargds-code
      867     ,input  loc-cli-type
      868     ,input  loc-cli-code
      869     ,input  parobj-type
      870     ,input  parobj-code
      871     ,output parext-gds-type
      872     ,output parcli-qnty-input
      873     ,output pardensity-input
      874     ,output parcli-base-rate-input
      875     ,output pardoc-qnty-input
      876     ,output parfact-qnty-input
      877     ,output parprice-cli-input
      878     ,output parbase-price-input
      879     ,output partax-3-input
      880     ,output parcli-qnty-calc
      881     ,output pardensity-calc
      882     ,output parcli-base-rate-calc
      883     ,output pardoc-qnty-calc
      884     ,output parfact-qnty-calc
      885     ,output parprice-cli-calc
      886     ,output parbase-price-calc
      887     ,output partax-3-calc
      888     ,output parround
      889     ) no-error.
      890   if error-status :error then message
      891     vss-workfile vss-revision vss-description skip
      892     error-status :get-message(1) skip
      893     return-value skip
      894     "1"
      895     view-as alert-box error
      896   .
      897   if  parext-gds-type =  'sg':U then
      898     do:
      899      assign
      900       parcli-qnty-input   = true
      901       parprice-cli-input  = true
      902      .
      903     end.
      904   if g#type =  'ОФ':U then
      905   assign
      906   parbase-price-my = false
      907   parbase-price-input = false
      908   parprice-cli-input  = false
      909   .
      910   else
      911   assign
      912     parbase-price-my = true
      913   .
      914   if parbase-price-calc = 'cli-price' then do:
      915    assign  frame d-out-prt  b-ord-gds-dtl.price-rubl b-ord-gds-dtl.price-base .
      916    assign
      917       b-ord-gds-dtl.sum-rubl = input frame d-out-prt b-ord-gds-dtl.price-rubl  * input frame d-out-prt b-ord-gds-dtl.qnty
      918       b-ord-gds-dtl.sum-base = b-ord-gds-dtl.price-base  * input frame d-out-prt b-ord-gds-dtl.qnty
      919       b-ord-gds-dtl.sum-cli  = b-ord-gds-dtl.price-cli   * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      920       tot-rubl     = input frame d-out-prt b-ord-gds-dtl.price-rubl * input frame d-out-prt b-ord-gds-dtl.qnty
      921       tot-base     = b-ord-gds-dtl.price-base * input frame d-out-prt b-ord-gds-dtl.qnty
      922       tot-cli      = b-ord-gds-dtl.price-cli  * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      923       .
      924   end.
      925   else do:
      926    assign
      927       b-ord-gds-dtl.sum-rubl = b-ord-gds-dtl.price-rubl  * input frame d-out-prt b-ord-gds-dtl.qnty
      928       b-ord-gds-dtl.sum-base = b-ord-gds-dtl.price-base  * input frame d-out-prt b-ord-gds-dtl.qnty
      929       b-ord-gds-dtl.sum-cli  = input frame d-out-prt b-ord-gds-dtl.price-cli   * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      930       tot-rubl     = b-ord-gds-dtl.price-rubl * input frame d-out-prt b-ord-gds-dtl.qnty
      931       tot-base     = b-ord-gds-dtl.price-base * input frame d-out-prt b-ord-gds-dtl.qnty
      932       tot-cli      = input frame d-out-prt b-ord-gds-dtl.price-cli  * input frame d-out-prt b-ord-gds-dtl.cli-qnty
      933       .
      934   end.
      935     DISPLAY
      936       b-ord-gds-dtl.price-rubl
      937       b-ord-gds-dtl.price-base
      938       b-ord-gds-dtl.price-cli
      939       tot-cli
      940       tot-rubl
      941       tot-base WITH FRAME d-out-prt.
      942    end.
      943   end procedure.
      944   PROCEDURE apply-focus-next-entry :
      945   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
      946     define input parameter p-widget-handle as handle no-undo .
      947     do with frame d-out-prt :
      948         if b-ord-gds-dtl.cli-qnty :handle = p-widget-handle then apply "entry":u to b-ord-gds-dtl.price-cli .
      949     end.
      950   end.
      951   END PROCEDURE.
      952   ON CHOOSE OF b-exit IN FRAME d-out-prt
      953   DO:
      954   assign
      955     prt-rec = recid (b-ord-gds-dtl)
      956     cur-rec = recid (ub.gds-prt)
      957     gds-rec = recid (ub.goods).
      958   find b-ord-line where     b-ord-line.prod-code  = b-ord-gds-dtl.prod-code
      959                         and b-ord-line.prod-type  = b-ord-gds-dtl.prod-type
      960                         and b-ord-line.artic      = b-ord-gds-dtl.artic
      961                         no-lock.
      962   line-rec = recid (b-ord-line).
      963   assign
      964     b-ord-gds-dtl.sum-cli = b-ord-gds-dtl.cli-qnty * b-ord-gds-dtl.price-cli
      965     b-ord-gds-dtl.sum-base = b-ord-gds-dtl.qnty * b-ord-gds-dtl.price-base
      966     b-ord-gds-dtl.sum-rubl = b-ord-gds-dtl.qnty * b-ord-gds-dtl.price-rubl
      967     .
      968   END.
      969   on end-error, stop of frame d-out-prt do:
      970     apply "choose" to b-exit in frame d-out-prt.
      971     return no-apply.
      972   end.
      973   ON RETURN OF b-ord-gds-dtl.cli-qnty IN FRAME d-out-prt
      974   DO:
      975    run apply-focus-next-entry in this-procedure  (input  b-ord-gds-dtl.cli-qnty:handle ) .
      976    return no-apply .
      977   END.
      978   ON RETURN OF b-ord-gds-dtl.qnty IN FRAME d-out-prt
      979   DO:
      980   apply "choose" to b-exit in frame d-out-prt.
      981   END.
      982   ON RETURN OF b-ord-gds-dtl.price-rubl IN FRAME d-out-prt
      983   DO:
      984   apply "choose" to b-exit in frame d-out-prt.
      985   END.
      986   ON RETURN OF b-ord-gds-dtl.price-base IN FRAME d-out-prt
      987   DO:
      988   apply "choose" to b-exit in frame d-out-prt.
      989   END.
      990   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-out-prt:PARENT eq ?
      991   THEN FRAME d-out-prt:PARENT = ACTIVE-WINDOW.
      992   ON WINDOW-CLOSE OF FRAME d-out-prt APPLY "END-ERROR":U TO SELF.
      993   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   on help of frame d-out-prt
      995   do:
      996     run gbl/app_help.p
      997       (input this-procedure :file-name
      998       ,input ''
      999       ,input ?
     1000       ) no-error.
     1001     if error-status :error then do:
     1002       message
     1003         "Ошибка при вызове помощи"
     1004         error-status :get-message(1)
     1005         view-as alert-box .
     1006     end.
     1007   end.
     1008   run minbtn-set in this-procedure .
     1009   on choose of b-help in frame d-out-prt
     1010   do:
     1011     apply "help":u to frame d-out-prt .
     1012   end.
     1013   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   procedure minbtn-set :
     1015       do
     1016           on error undo, return error return-value
     1017           :
     1018           define variable ii              as integer       no-undo .
     1019           define variable fh              as widget-handle no-undo .
     1020           define variable hh              as widget-handle no-undo .
     1021           define variable v-h             as handle        extent 4 no-undo .
     1022           define variable v-name-button   as character     no-undo .
     1023           define variable v-help-old-x    as decimal       no-undo .
     1024           define variable v-help-old-y    as decimal       no-undo .
     1025           define variable v-help-old-size as decimal       no-undo .
     1026           define variable v-frame-width   as decimal       no-undo .
     1027           define variable jj              as integer       no-undo .
     1028           do
     1029               on error undo, return error
     1030               :
     1031               assign
     1032                   v-frame-width = frame d-out-prt:width - 0.3
     1033                   fh            = frame d-out-prt:first-child
     1034                   hh            = fh:first-child
     1035                   ii            = 1
     1036                   .
     1037               do while valid-handle(hh):
     1038                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1039                   do:
     1040                       case lc(hh:name) :
     1041                           when "b-help" then
     1042                               do:
     1043                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1044                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1045                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1046                                   hh:TOOLTIP = "Помощь" .
     1047                                   v-help-old-x = hh:column .
     1048                                   v-help-old-y = hh:row    .
     1049                                   v-help-old-size = hh:width .
     1050                                   hh:width-chars = 2.5 .
     1051                               end.
     1052                           when "b-print" then
     1053                               do:
     1054                                   hh:load-image("cmp/b-print.bmp":u) .
     1055                                   hh:TOOLTIP = "Печать" .
     1056                                   v-h[ii] = hh:handle .
     1057                                   ii = ii + 1 .
     1058                                   hh:width-chars = 3 .
     1059                               end.
     1060                           when "b-history" or
     1061                           when "b-hist" then
     1062                               do:
     1063                                   hh:load-image("cmp/b-hist.bmp":u) .
     1064                                   hh:TOOLTIP = "История" .
     1065                                   v-h[ii] = hh:handle .
     1066                                   ii = ii + 1 .
     1067                                   hh:width-chars = 3 .
     1068                               end.
     1069                           when "b-sch" then
     1070                               do:
     1071                                   hh:load-image("cmp/b-sch.bmp":u) .
     1072                                   hh:TOOLTIP = "Установка Фильтра" .
     1073                                   v-h[ii] = hh:handle .
     1074                                   ii = ii + 1 .
     1075                                   hh:width-chars = 3 .
     1076                               end.
     1077                           when "b-hist-user" then
     1078                               do:
     1079                                   hh:load-image("cmp/b-hist.bmp":u) .
     1080                                   hh:TOOLTIP = "История пользователя" .
     1081                                   ii = ii + 1 .
     1082                               end.
     1083                       end case.
     1084                   end.
     1085                   hh = hh:next-sibling.
     1086               end.
     1087               b-help:column = v-frame-width - b-help:width-chars.
     1088               jj = 0.
     1089               repeat ii = 4 to 1 by -1 :
     1090                   if valid-handle (v-h[ii] ) then
     1091                   do:
     1092                       jj  = jj + 1 .
     1093                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1094                       v-h[ii]:row    = v-help-old-y .
     1095                   end.
     1096               end.
     1097           end.
     1098       end.
     1099   end procedure.
     1100   MAIN-BLOCK:
     1101   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1102      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1103    g#type = loc-doc-type.
     1104   find ub.gds-prt where recid (gds-prt) = cur-rec no-lock.
     1105   if prt-mode = 'ШКАЛА':U and node-type <> 'терм':U then do:
     1106     message "В режиме ШКАЛА можно указывать количества только по самым подробным признакам.".
     1107     undo, return error.
     1108   end.
     1109   find ub.goods where recid (ub.goods) = gds-rec no-lock.
     1110   find ub.clients where ub.clients.obj-code = ub.goods.prod-code
     1111                  and ub.clients.obj-type = ub.goods.prod-type no-lock.
     1112   find ub.prt-obj where ub.prt-obj.prt-code = ub.gds-prt.node-code
     1113                       and ub.prt-obj.prod-code = ub.goods.prod-code
     1114                       and ub.prt-obj.prod-type = ub.goods.prod-type
     1115                       and ub.prt-obj.artic     = ub.goods.artic
     1116                       and ub.prt-obj.obj-code  = store-code
     1117                       and ub.prt-obj.obj-type  = store-type
     1118                       no-lock no-error.
     1119     find b-ord-line where recid (b-ord-line) = line-rec.
     1120     find b-ord-gds-dtl where b-ord-gds-dtl.node-code = ub.gds-prt.node-code
     1121                         and b-ord-gds-dtl.prod-code = b-ord-line.prod-code
     1122                         and b-ord-gds-dtl.prod-type = b-ord-line.prod-type
     1123                         and b-ord-gds-dtl.artic     = b-ord-line.artic
     1124                         no-lock no-error.
     1125   if not available b-ord-gds-dtl then do:
     1126     if ub.gds-prt.upper-code = ub.goods.prt-root
     1127        or prt-mode = 'ПРОСМОТР':U then do:
     1128       message "Товара с таким признаком нет в данном заказе.".
     1129       undo, return error.
     1130     end.
     1131     run create_gds-dtl in this-procedure
     1132                        (ub.gds-prt.f-name,
     1133                         b-ord-line.artic,
     1134                         b-ord-line.prod-code,
     1135                         b-ord-line.prod-type,
     1136                         ub.gds-prt.node-code
     1137                        ) no-error.
     1138     if error-status:error then do:
     1139        message "Ошибка при создании признака." skip
     1140                return-value error-status:error
     1141        view-as alert-box error.
     1142         undo , return error.
     1143     end.
     1144    find first b-ord-gds-dtl where
     1145                             b-ord-gds-dtl.artic     = b-ord-line.artic     and
     1146                             b-ord-gds-dtl.prod-code = b-ord-line.prod-code and
     1147                             b-ord-gds-dtl.prod-type = b-ord-line.prod-type and
     1148                             b-ord-gds-dtl.node-code = ub.gds-prt.node-code.
     1149    run last-price in this-procedure
     1150    (    input g#host-code ,
     1151         input b-ord-gds-dtl.artic ,
     1152         input b-ord-gds-dtl.prod-type ,
     1153         input b-ord-gds-dtl.prod-code ,
     1154         input  loc-cli-code  ,
     1155         input  loc-cli-type  ,
     1156         input  b-ord-line.cli-base-rate ,
     1157         input  loc-exch-code ,
     1158         output b-ord-gds-dtl.price-base ,
     1159         output b-ord-gds-dtl.price-rubl ,
     1160         output b-ord-gds-dtl.price-cli ) no-error  .
     1161         if error-status :error then message  error-status :get-message(1) .
     1162     if prt-mode = 'ШКАЛА':U then do:
     1163       find first g-d-b-ord-dtl where g-d-b-ord-dtl.prod-type = b-ord-line.prod-type
     1164                          and g-d-b-ord-dtl.prod-code = b-ord-line.prod-code
     1165                          and g-d-b-ord-dtl.artic     = b-ord-line.artic
     1166                          and g-d-b-ord-dtl.node-code  <> ub.gds-prt.node-code no-lock no-error.
     1167       if AVAILABLE g-d-b-ord-dtl then
     1168       assign
     1169         b-ord-gds-dtl.cli-qnty   = g-d-b-ord-dtl.cli-qnty
     1170         b-ord-gds-dtl.qnty       = g-d-b-ord-dtl.qnty
     1171         .
     1172     end.
     1173   end.
     1174   frame d-out-prt:title = "Заказ №  " + loc-ord-num + "    " +  'строка':U + "     " + prt-mode.
     1175   cli-curr  = "" .
     1176   base-curr = "".
     1177   find first ub.currency where ub.currency.curr-code = base-code no-lock no-error.
     1178     if available ub.currency then base-curr = ub.currency.curr-abbr .
     1179   find first ub.currency where ub.currency.curr-code = LOC-EXCH-CODE no-lock no-error.
     1180     if available ub.currency then cli-curr = ub.currency.curr-abbr .
     1181   disp cli-curr base-curr with frame d-out-prt .
     1182   run UI-on in this-procedure .
     1183   if prt-mode = 'ПРОСМОТР':U then WAIT-FOR GO OF FRAME d-out-prt focus b-exit.
     1184   else  DO:
     1185       WAIT-FOR GO OF FRAME d-out-prt focus b-ord-gds-dtl.cli-qnty.
     1186         chg-qnty = input frame d-out-prt b-ord-gds-dtl.qnty - b-ord-gds-dtl.qnty.
     1187         b-ord-line.qnty   = b-ord-line.qnty + chg-qnty  .
     1188         b-ord-gds-dtl.qnty  = b-ord-gds-dtl.qnty + chg-qnty .
     1189         chg-qnty = input frame d-out-prt b-ord-gds-dtl.cli-qnty - b-ord-gds-dtl.cli-qnty.
     1190         b-ord-line.cli-qnty   = b-ord-line.cli-qnty + chg-qnty  .
     1191         b-ord-gds-dtl.cli-qnty  = b-ord-gds-dtl.cli-qnty + chg-qnty .
     1192         b-ord-gds-dtl.price-rubl  = input frame d-out-prt b-ord-gds-dtl.price-rubl .
     1193         b-ord-gds-dtl.price-base  = input frame d-out-prt b-ord-gds-dtl.price-base .
     1194   End.
     1195   prt-rec = recid (b-ord-gds-dtl).
     1196   if prt-mode <> 'ПРОСМОТР':U then do:
     1197     if b-ord-gds-dtl.cli-qnty = 0 and b-ord-gds-dtl.qnty = 0 then do:
     1198       message "Удаляем строку, т.к. количество = 0.".
     1199       delete b-ord-gds-dtl.
     1200       prt-rec = ?.
     1201     end.
     1202   end.
     1203   END.
     1204   run disable_UI in this-procedure .
     1205   PROCEDURE disable_UI :
     1206     HIDE FRAME d-out-prt.
     1207   END PROCEDURE.
     1208   PROCEDURE UI-on :
     1209   disable all with frame d-out-prt.
     1210   enable
     1211         b-exit
     1212         b-help
     1213         b-ord-gds-dtl.price-cli
     1214         b-ord-gds-dtl.cli-qnty
     1215         with frame d-out-prt.
     1216    run tax-name in this-procedure (input 'rdt':U, output varroad-tax-label) no-error.
     1217   IF AVAILABLE ub.prt-obj    THEN DISPLAY ub.prt-obj.free-qnty   WITH FRAME d-out-prt.
     1218   IF AVAILABLE ub.price-list THEN DISPLAY ub.price-list.doc-num  WITH FRAME d-out-prt.
     1219   g#log = true .
     1220    define variable g#ret-sup-pay as integer   no-undo .
     1221    define buffer buf_sysconf for ub.sysconf.
     1222    find first buf_sysconf no-lock where buf_sysconf.host-code = g#host-code no-error .
     1223    g#ret-sup-pay = buf_sysconf.ret-sup-pay .
     1224   if g#log and paytype <> g#ret-sup-pay or
     1225       (paytype = g#ret-sup-pay) then
     1226   if prt-mode = 'ПРОСМОТР':U then hide ub.prt-obj.free-qnty ub.price-list.doc-num in frame d-out-prt.
     1227   assign
     1228     tot-rubl = b-ord-gds-dtl.qnty     * b-ord-gds-dtl.price-rubl
     1229     tot-base = b-ord-gds-dtl.qnty     * b-ord-gds-dtl.price-base
     1230     tot-cli  = b-ord-gds-dtl.cli-qnty * b-ord-gds-dtl.price-cli
     1231     .
     1232   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1234     (input  ub.goods.gds-code
     1235     ,input  b-ord-gds-dtl.node-code
     1236     ,input  ''
     1237     ,input  ''
     1238     ,input  ub.goods.unit-base
     1239     ,input  1
     1240     ,output varis-new
     1241     ,buffer b-c-b
     1242     )  .
     1243   display b-c-b.b-code @ ub.bar-code.b-code with frame d-out-prt.
     1244   display tot-rubl
     1245        tot-base
     1246        tot-cli
     1247        base-curr
     1248        cli-curr
     1249        ub.clients.obj-name
     1250        ub.gds-prt.f-name
     1251        b-ord-gds-dtl.artic
     1252        b-ord-gds-dtl.prod-code
     1253        b-ord-gds-dtl.prod-type
     1254        b-ord-gds-dtl.price-rubl
     1255        b-ord-gds-dtl.price-base
     1256        b-ord-gds-dtl.price-cli
     1257        b-ord-gds-dtl.cli-qnty
     1258        b-ord-gds-dtl.qnty
     1259        ub.goods.gds-name
     1260        ub.goods.unit-base
     1261        ub.goods.qnty-cart
     1262        ub.goods.unit-cli
     1263        with frame d-out-prt.
     1264   if ub.gds-prt.upper-code = ub.goods.prt-root then hide ub.gds-prt.f-name in frame d-out-prt.
     1265   END PROCEDURE.
     1266   procedure create_gds-dtl :
     1267   define input parameter parname    as character no-undo .
     1268   define input parameter parartic     like ub.goods.artic       no-undo.
     1269   define input parameter parprod-code like ub.goods.prod-code   no-undo.
     1270   define input parameter parprod-type like ub.goods.prod-type   no-undo.
     1271   define input parameter parprt-code  like ub.gds-dtl.prt-code  no-undo.
     1272   define buffer bf_gds-dtl for tmp#zakaz-dtl1.
     1273   define buffer bf_clients for ub.clients.
     1274   define buffer bf_goods   for ub.goods.
     1275   error-status:error = false .
     1276   find first bf_gds-dtl where bf_gds-dtl.artic      = parartic
     1277                           and bf_gds-dtl.prod-code  = parprod-code
     1278                           and bf_gds-dtl.prod-type  = parprod-type
     1279                           and bf_gds-dtl.node-code  = parprt-code   no-error.
     1280   if not available bf_gds-dtl then do:
     1281      find first bf_goods where bf_goods.artic     = parartic     and
     1282                                bf_goods.prod-type = parprod-type and
     1283                                bf_goods.prod-code = parprod-code no-lock no-error.
     1284      if not available bf_goods then do:
     1285         return error subst("Создание признака невозможно. Не найден товар &1 &2 &3.", parartic, parprod-code, parprod-code).
     1286      end.
     1287   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1289     (input  bf_goods.gds-code
     1290     ,input  parprt-code
     1291     ,input  ''
     1292     ,input  ''
     1293     ,input  bf_goods.unit-base
     1294     ,input  ?
     1295     ,output varis-new
     1296     ,buffer ub.bar-code
     1297     ) no-error .
     1298     create bf_gds-dtl.
     1299         assign
     1300           bf_gds-dtl.artic         = parartic
     1301           bf_gds-dtl.prt-name      = parname
     1302           bf_gds-dtl.prod-code     = parprod-code
     1303           bf_gds-dtl.prod-type     = parprod-type
     1304           bf_gds-dtl.node-code     = parprt-code
     1305           bf_gds-dtl.doc-code      = loc-ord-num
     1306           .
     1307   end.
     1308   else do:
     1309         assign
     1310           bf_gds-dtl.artic         = parartic
     1311           bf_gds-dtl.prt-name      = parname
     1312           bf_gds-dtl.prod-code     = parprod-code
     1313           bf_gds-dtl.prod-type     = parprod-type
     1314           bf_gds-dtl.node-code     = parprt-code
     1315           bf_gds-dtl.doc-code      = loc-ord-num
     1316           .
     1317   end.
     1318   end procedure.
