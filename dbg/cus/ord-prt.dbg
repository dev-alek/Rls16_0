      606         VIEW-AS TEXT
      607        SIZE 4 BY 1
      608        FGCOLOR 4  NO-UNDO.
      609   DEFINE VARIABLE cli-curr AS CHARACTER FORMAT "X(3)":U
      610         VIEW-AS TEXT
      611        SIZE 4 BY 1
      612        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      613   DEFINE VARIABLE tot-base AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
      614         VIEW-AS TEXT
      615        SIZE 19.25 BY 1
      616        FGCOLOR 4  NO-UNDO.
      617   DEFINE VARIABLE tot-cli AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
      618         VIEW-AS TEXT
      619        SIZE 18.13 BY 1
      620        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      621   DEFINE VARIABLE tot-rubl AS DECIMAL FORMAT "->>,>>>,>>>,>>>,>>9.99" INITIAL 0
      622        LABEL "Сумма"
      623         VIEW-AS TEXT
      624        SIZE 23.25 BY .6
      625        FGCOLOR 4  NO-UNDO.
      626   DEFINE RECTANGLE RECT-1
