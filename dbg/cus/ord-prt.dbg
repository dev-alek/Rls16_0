      594   DEFINE QUERY br-dtl FOR b-ord-gds-dtl, ub.gds-prt, ub.goods, ub.bar-code SCROLLING.
      595   define variable varis-new     as logical             no-undo.
      596   define buffer bf_goods          for ub.goods.
