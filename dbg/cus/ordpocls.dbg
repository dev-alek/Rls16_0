      369   define  buffer buf_ord-doc    for ub.ord-doc.
      370   define  buffer t-doc-rcv      for ub.ord-doc-rcv .
      371   define  buffer t-ord-doc-rcv  for ub.ord-doc-rcv.
      372   define  buffer t-doc-line     for ub.ord-line.
      373   define  buffer t-doc-line-rcv for ub.ord-line-rcv.
      374   define  buffer t-trn-line     for ub.doc-line.
      375   define  buffer t-trn-doc      for ub.trn-doc.
      376   define  buffer buf_contract for ub.contract  .
      377   define temp-table temp-obj-list no-undo
      378   field obj-type like ub.clients.obj-type
      379   field obj-code like ub.clients.obj-code
      380   .
      381   define variable v-num-chip as character no-undo .
      382   define variable  sum-ord like ub.ord-line.qnty no-undo .
      383   define variable  sum-rcv like ub.ord-line.qnty no-undo .
      384   define variable  sum-trn like ub.ord-line.qnty no-undo .
      385   define variable old-state like ub.ord-doc.status_ no-undo .
      386   define variable old-flag like ub.ord-doc.flag_ no-undo .
      387   define stream  errStream  .
      388   define variable v-log as logical   no-undo .
      389   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      391     (input  v-cntxt-obj-type
      392     ,input  v-cntxt-obj-code
      393     ,output to-day
      394     )  .
      395    find first buf_ord-doc where recid (buf_ord-doc) = p-rec exclusive-lock no-error.
      396    assign
      397     old-state = buf_ord-doc.status_
      398     old-flag  = buf_ord-doc.flag_
      399     .
      400     if buf_ord-doc.ship-date = ? then do:
      401         if p-ask then
      402         Message "Не задана дата заказа ! "
      403         skip
      404         "Документ" buf_ord-doc.doc-code skip
      405         view-as alert-box error .
      406         return.
      407     end.
      408     if buf_ord-doc.transport-contract  <> 0 and buf_ord-doc.transport-contract  <> ? then do:
      409       find first buf_contract no-lock where
      410                   buf_contract.host-code     =  buf_ord-doc.transport-host-code and
      411                   buf_contract.contract-code =  buf_ord-doc.transport-contract no-error .
      412       if not available buf_contract then do:
      413           message
      414             "Не верно задан договор грузоперевозчика" skip
      415             "Грузоперевозчик: " buf_ord-doc.transport-host-code      skip
      416             "Договор:         " buf_ord-doc.transport-contract  skip
      417             view-as alert-box error
      418           .
      419           return error  .
      420           end.
      421     end.
      422     define variable t-date  as date      no-undo .
      423     define variable t-time  as integer   no-undo .
      424     run cur-time in this-procedure ( output  t-date , output  t-time ).
      425     if can-find
      426       ( first t-doc-line no-lock where
      427               t-doc-line.doc-code = buf_ord-doc.doc-code and
      428             ( t-doc-line.qnty  =  0 or t-doc-line.qnty  = ?)) then do:
      429         if p-ask then
      430         Message "В заказе есть строки с количеством равным 0 или ? ! "
      431         skip
      432         "Документ" buf_ord-doc.doc-code skip
      433         view-as alert-box error .
      434         return.
      435     end.
      436    case buf_ord-doc.status_ :
      437         when 'отказ':U then do :
      438           if p-ask then
      439           Message
      440             "Нельзя закрыть заказ"
      441             "в статусе " caps(buf_ord-doc.status_) skip
      442             "Документ" buf_ord-doc.doc-code view-as alert-box information.
      443           return.
      444         end.
      445         when 'новый':U then do :
      446           if buf_ord-doc.flag_ = false  then do:
      447                 if buf_ord-doc.ship-date < t-date then do:
      448                     if p-ask then
      449                     Message "Дата заказа меньше текущей даты ! " skip
      450                     string(buf_ord-doc.ship-date, "99/99/9999" ) skip
      451                     "Сегодня" string(t-date, "99/99/9999" )
      452                     skip
      453                     "Документ" buf_ord-doc.doc-code skip
      454                     view-as alert-box error .
      455                     return.
      456                 end.
      457                 find first  t-doc-line where t-doc-line.doc-code  = buf_ord-doc.doc-code no-lock no-error .
      458                 if not available t-doc-line then do:
      459                     if p-ask then
      460                     message   "Заказ"  buf_ord-doc.doc-code  "  не содержит ни одной записи ! "
      461                     view-as alert-box information
      462                     title "Внимание!!! "
      463                   .
      464                     return.
      465                  end.
      466                 find first  t-doc-line where
      467                       t-doc-line.doc-code  = buf_ord-doc.doc-code and
      468                     ( t-doc-line.price-rubl  <= 0 or
      469                       t-doc-line.price-rubl   = ? )
      470                       no-lock no-error .
      471                 if available t-doc-line then do:
      472                     if p-ask then
      473                     message   " Заказ"  buf_ord-doc.doc-code  "   содержит товары с неопределенной ценой (руб)! "
      474                               view-as alert-box information
      475                               title "Закрыть заказ "   .
      476                     return.
      477                 end.
      478             define variable v_ok as logical no-undo .
      479             define buffer buf_clients for ub.clients .
      480             find first buf_clients no-lock where
      481                        buf_clients.obj-code = buf_ord-doc.obj-code and
      482                        buf_clients.obj-type = buf_ord-doc.obj-type no-error .
      483             if not available buf_clients then do:
      484                     if p-ask then
      485                     message   " Не правильно задан объект"  skip
      486                                 buf_ord-doc.obj-code skip
      487                                 buf_ord-doc.obj-type
      488                                 view-as alert-box information
      489                                 title "Закрыть заказ "   .
      490                     return.
      491             end.
      492             define buffer buf1_clients for ub.clients .
      493             find first buf1_clients no-lock where
      494                        buf1_clients.obj-code = buf_ord-doc.cli-code and
      495                        buf1_clients.obj-type = buf_ord-doc.cli-type no-error .
      496             if not available buf1_clients then do:
      497                     if p-ask then
      498                     message   " Не правильно задан контрагент"  skip
      499                                 buf_ord-doc.cli-code skip
      500                                 buf_ord-doc.cli-type
      501                                 view-as alert-box information
      502                                 title "Закрыть заказ "   .
      503                     return.
      504             end.
      505             assign
      506                 buf_ord-doc.status_ = 'новый':U
      507                 buf_ord-doc.flag_ = true
      508                 .
      509                 return.
      510           end.
      511               if buf_ord-doc.flag_ = true  then do:
      512                 run cus/ord-espo.p
      513                     ( input parParentProc ,
      514                       input recid (buf_ord-doc) ,
      515                       output v-num-chip )
      516                       no-error .
      517                 if error-status :error then
      518                 message vss-workfile vss-revision vss-description skip
      519                         "Ошибка ord-espo.p " skip
      520                         skip
      521                         error-status :get-message(1) skip
      522                         return-value skip
      523                         view-as alert-box error
      524                 .
      525                 if buf_ord-doc.contract-code <> 0 then do:
      526                   find first buf_contract no-lock where
      527                              buf_contract.contract-code = buf_ord-doc.contract-code and
      528                              buf_contract.host-code     = buf_ord-doc.host-code no-error .
      529                              if error-status :error then do:
      530                                 if p-ask then
      531                                           message
      532                                               substitute ( "Не найден договор &1 на фирме &2" ,buf_ord-doc.contract-code , buf_ord-doc.host-code ) skip
      533                                               "Заказ № " buf_ord-doc.doc-code skip
      534                                               view-as alert-box error .
      535                                 return error .
      536                              end.
      537                     case buf_contract.usl-opl:
      538                       when 'Предоплата':U then do:
      539                            assign
      540                             buf_ord-doc.need-fo  = 1
      541                             buf_ord-doc.need-fo2 = 0
      542                            .
      543                       end.
      544                       when 'Предоплата(%)':U then do:
      545                             assign
      546                               buf_ord-doc.need-fo  = 1
      547                               buf_ord-doc.need-fo2 = 1
      548                             .
      549                       end.
      550                       when 'Не определено':U then do:
      551                             assign
      552                               buf_ord-doc.need-fo  = 2
      553                               buf_ord-doc.need-fo2 = 0
      554                             .
      555                       end.
      556                       otherwise do:
      557                             assign
      558                               buf_ord-doc.need-fo  = 0
      559                               buf_ord-doc.need-fo2 = 0
      560                             .
      561                       end.
      562                     end case.
      563                 end.
      564                 else do:
      565                   assign
      566                     buf_ord-doc.need-fo  = 0
      567                     buf_ord-doc.need-fo2 = 0
      568                   .
      569                 end.
      570                 buf_ord-doc.out-code = v-num-chip .
      571                 return .
      572               end.
      573           end.
      574           when 'поставка':U
      575           then do :
      576               for each t-ord-doc-rcv exclusive-lock
      577                  where t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code
      578                    and t-ord-doc-rcv.status_  = 'поставка':U
      579                         :
      580                 assign
      581                   sum-rcv = 0
      582                   sum-trn = 0
      583                   .
      584                 for each t-doc-line-rcv no-lock
      585                    where t-doc-line-rcv.doc-code  = t-ord-doc-rcv.doc-code
      586                     and  t-doc-line-rcv.rcv-code  = t-ord-doc-rcv.rcv-code
      587                           :
      588                   for each ub.ord-chain no-lock
      589                      where ub.ord-chain.doc-code     = t-doc-line-rcv.rcv-code
      590                        and ub.ord-chain.doc-type     = 'rcv'
      591                        and ub.ord-chain.rel-doc-type = 'trn'
      592                           :
      593                    find first t-trn-doc no-lock
      594                       where t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code
      595                         and t-trn-doc.status_   = 'факт':U
      596                         and t-trn-doc.doc-type  = 'рас':U
      597                         and t-trn-doc.internal  = false
      598                           no-error.
      599                         if not available  t-trn-doc then next .
      600                           for each t-trn-line no-lock
      601                              where t-trn-line.doc-code  = t-trn-doc.doc-code
      602                                and t-trn-line.artic     = t-doc-line-rcv.artic
      603                                and t-trn-line.prod-type = t-doc-line-rcv.prod-type
      604                                and t-trn-line.prod-code = t-doc-line-rcv.prod-code
      605                                :
      606                               assign sum-trn = sum-trn + t-trn-line.fact-qnty.
      607                           end.
      608                   end.
      609                   assign sum-rcv = sum-rcv + t-doc-line-rcv.qnty.
      610                 end.
      611                 if sum-trn >= sum-rcv
      612                 and sum-rcv <> 0
      613                 then do:
      614                   assign
      615                     t-ord-doc-rcv.status_   = 'факт':U
      616                     t-ord-doc-rcv.fact-date = to-day
      617                   .
      618                 end.
      619               end.
      620               for each t-ord-doc-rcv where  t-ord-doc-rcv.doc-code     = buf_ord-doc.doc-code no-lock :
      621                 for each ub.ord-chain no-lock where
      622                           ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      623                           ub.ord-chain.doc-type = 'rcv'                  and
      624                           ub.ord-chain.rel-doc-type = 'trn'
      625                           :
      626                   for each t-trn-doc no-lock where
      627                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      628                             t-trn-doc.doc-type  = 'рас':U and
      629                             t-trn-doc.status_  <> 'факт':U  :
      630                     if p-ask then
      631                     message "Документ РН" t-trn-doc.doc-code " имеет статус " CAPS(t-trn-doc.status_)
      632                             "Закройте РН до статуса ФАКТ " view-as alert-box error
      633                             title "Закрыть заказ "
      634                             .
      635                     return.
      636                    end.
      637                    end.
      638               end.
      639                 if buf_ord-doc.contract-code <> 0 then do:
      640                   find first buf_contract no-lock where
      641                              buf_contract.contract-code = buf_ord-doc.contract-code and
      642                              buf_contract.host-code     = buf_ord-doc.host-code no-error .
      643                              if error-status :error then do:
      644                                 if p-ask then
      645                                             message
      646                                               substitute ( "Не найден договор Вн№ &1 на фирме &2  Заказ№ &3 " ,buf_ord-doc.contract-code , buf_ord-doc.host-code , buf_ord-doc.doc-code )
      647                                               view-as alert-box error .
      648                                 return error substitute ( "Не найден договор Вн№ &1 на фирме &2  Заказ№ &3 " ,buf_ord-doc.contract-code , buf_ord-doc.host-code , buf_ord-doc.doc-code ).
      649                              end.
      650                     case buf_contract.usl-opl:
      651                       when 'Предоплата':U or
      652                       when 'Предоплата(%)':U
      653                       then do:
      654                            if buf_ord-doc.need-fo =  1 and  buf_ord-doc.cr-fo = false then do:
      655                               if p-ask then
      656                               message substitute ("Не создано Финансовое Обязательство по договору  Вн№  &1 условие &2 ",buf_ord-doc.contract-code,caps(buf_contract.usl-opl))
      657                                       view-as alert-box error .
      658                               return error 'error,':U + substitute ("Не создано Финансовое обязательство по договору  Вн№  &1 условие &2 ",buf_ord-doc.contract-code,caps(buf_contract.usl-opl)) .
      659                            end.
      660                            if buf_ord-doc.need-fo2 <> 1 and buf_contract.usl-opl  = 'Предоплата(%)':U then buf_ord-doc.need-fo2 = 1 .
      661                       end.
      662                     end case.
      663                 end.
      664            assign
      665              sum-ord = 0
      666              sum-rcv = 0
      667              sum-trn = 0
      668             .
      669              for each t-doc-line     where t-doc-line.doc-code     = buf_ord-doc.doc-code  no-lock :
      670                  for each  t-doc-line-rcv where t-doc-line-rcv.doc-code = t-doc-line.doc-code and
      671                                            t-doc-line-rcv.artic      = t-doc-line.artic         and
      672                                            t-doc-line-rcv.prod-type  = t-doc-line.prod-type   and
      673                                            t-doc-line-rcv.prod-code  = t-doc-line.prod-code no-lock ,
      674                    first t-doc-rcv where t-doc-line-rcv.doc-code = t-doc-rcv.doc-code  and
      675                                          t-doc-line-rcv.rcv-code = t-doc-rcv.rcv-code  no-lock :
      676                 for each ub.ord-chain no-lock where
      677                           ub.ord-chain.doc-code = t-doc-rcv.rcv-code and
      678                           ub.ord-chain.doc-type = 'rcv'                  and
      679                           ub.ord-chain.rel-doc-type = 'trn'
      680                           :
      681                    find first t-trn-doc no-lock where
      682                               t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      683                               t-trn-doc.obj-type  = t-doc-rcv.obj-type and
      684                               t-trn-doc.obj-code  = t-doc-rcv.obj-code and
      685                               t-trn-doc.status_   = 'факт':U   and
      686                               t-trn-doc.doc-type  = 'рас':U  and
      687                               t-trn-doc.internal  = false
      688                               no-error .
      689                      if not available  t-trn-doc then next .
      690                           for each  t-trn-line where
      691                                     t-trn-line.doc-code  = t-trn-doc.doc-code          and
      692                                     t-trn-line.obj-code  = buf_ord-doc.obj-code        and
      693                                     t-trn-line.obj-type  = buf_ord-doc.obj-type        and
      694                                     t-trn-line.artic     = t-doc-line-rcv.artic        and
      695                                     t-trn-line.prod-type = t-doc-line-rcv.prod-type    and
      696                                     t-trn-line.prod-code = t-doc-line-rcv.prod-code    no-lock :
      697                               sum-trn = sum-trn + t-trn-line.fact-qnty.
      698                           end.
      699                      end.
      700                     sum-rcv = sum-rcv + t-doc-line-rcv.qnty.
      701                   end.
      702                   sum-ord = sum-ord + t-doc-line.qnty.
      703              end.
      704               if  sum-trn = 0  then do:
      705                     v-log = false .
      706                     if p-ask then
      707                       message "Заказ " buf_ord-doc.doc-code " не имеет внешней РН !" skip
      708                       "Закрыть в статус (ФАКТ-) ? " skip
      709                         view-as alert-box question
      710                         buttons yes-no
      711                         title "Закрыть заказ"
      712                         update v-log
      713                       .
      714                   if not v-log then return.
      715                   buf_ord-doc.flag_ = false .
      716               end.
      717               if  sum-ord > sum-trn then do:
      718                     v-log = false .
      719                     if p-ask then
      720                   message  "Заказ "  buf_ord-doc.doc-code " не покрыт внешней РН полностью !" skip
      721                     "Закрыть в статус (ФАКТ-) ? " skip
      722                     "Сумма заказа               " sum-ord skip
      723                     "Сумма накл. перемещения    " sum-trn
      724                     view-as alert-box question
      725                     buttons yes-no
      726                     title "Закрыть заказ"
      727                     update v-log
      728                   .
      729                   if not v-log then return.
      730                   buf_ord-doc.flag_ = false .
      731               end.
      732               if  sum-ord =  sum-trn then do:
      733                   buf_ord-doc.flag_ = true  .
      734               end.
      735               if  sum-ord <  sum-trn then do:
      736                     v-log = false .
      737                     if p-ask then
      738                   message "На  Заказ"  buf_ord-doc.doc-code " превышено количество по РН !" skip
      739                     "Закрыть в статус (ФАКТ+) ? " skip
      740                     sum-ord skip
      741                     sum-trn
      742                     view-as alert-box question
      743                     buttons yes-no
      744                     title "Закрыть заказ"
      745                     update v-log
      746                   .
      747                   if not v-log then return.
      748                   buf_ord-doc.flag_ = true  .
      749               end.
      750               assign
      751                 buf_ord-doc.status_ = 'факт':U
      752                 buf_ord-doc.fact-date = to-day
      753                 .
      754               for each t-ord-doc-rcv   exclusive-lock
      755                  where t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code
      756                    and t-ord-doc-rcv.status_  <> 'факт':U
      757                  :
      758                 for each ub.ord-chain no-lock where
      759                           ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      760                           ub.ord-chain.doc-type = 'rcv'                  and
      761                           ub.ord-chain.rel-doc-type = 'trn'
      762                           :
      763                    for each t-trn-doc no-lock where
      764                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      765                             t-trn-doc.doc-type  = 'рас':U and
      766                             t-trn-doc.status_   = 'факт':U  :
      767                           assign
      768                             t-ord-doc-rcv.status_   = 'факт':U
      769                             t-ord-doc-rcv.fact-date = to-day
      770                             .
      771                    end.
      772                    end.
      773               end.
      774         end.
      775    end case.
