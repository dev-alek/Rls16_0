      347   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348     define variable v-cntxt-db-num        as integer   no-undo .
      349     define variable v-cntxt-userid        as character no-undo .
      350     define variable v-cntxt-level         as character no-undo .
