     1334   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   procedure on-same-page :
     1336     define input parameter p-line-number as integer no-undo .
     1337     if p-line-number > page-size( PrnLibStream ) then do:
     1338       return .
     1339     end.
     1340     if line-counter( PrnLibStream ) + p-line-number > page-size( PrnLibStream ) then do:
     1341       page stream PrnLibStream .
     1342     end.
     1343   end procedure.
     1344   DEFINE FRAME FRAME-1
     1345   pol1 column-label "1":c12 format "X(12)"
     1346   pol2 column-label "2":c17 format "X(17)"
     1347   pol3 column-label "3":c11 format "X(11)"
     1348   pol4 column-label "4":c20 format "X(20)"
     1349   pol5 column-label "5":c9 format "X(9)"
     1350   pol6 column-label "6":c14 format "X(14)"
     1351   pol7 column-label "7":c20 format "X(20)"
     1352   pol8 column-label "8":c10 format "->>,>>9.99"
     1353   pol9 column-label "9":c11 format ">>>,>>9.99"
     1354   pol10 column-label "10":c15 format "->>>,>>>,>>9.99"
     1355   pol11 column-label "11":c15 format "->>>,>>>,>>9.99"
     1356   pol12 column-label "12":c15 format "->>>,>>>,>>9.99"
     1357   pol13 column-label "13":c18 format "X(18)"
     1358   with width 232 down stream-io use-text NO-BOX.
     1359   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   form header
     1361    skip(4)
     1362   with frame TopFrameSystem width 232 page-top no-labels no-box.
     1363   view stream PrnLibStream frame TopFrameSystem.
     1364   for each obj-list no-lock:
     1365     for each buf_temp-bon1 where
     1366             buf_temp-bon1.obj-type = obj-list.obj-type
     1367         and buf_temp-bon1.obj-code = obj-list.obj-code
     1368         and buf_temp-bon1.level = 0
     1369     break
     1370     by buf_temp-bon1.obj-type
     1371     by buf_temp-bon1.obj-code
     1372     by buf_temp-bon1.item-type
     1373     by buf_temp-bon1.item-name
     1374     by buf_temp-bon1.op-code
     1375     by buf_temp-bon1.chk-date
     1376     by buf_temp-bon1.chk-time :
     1377       if first-of(buf_temp-bon1.item-name) then do:
     1378         display stream PrnLibStream
     1379         buf_temp-bon1.item-name @ pol1
     1380         WITH FRAME FRAME-1
     1381         .
     1382         DOWN STREAM PrnLibStream
     1383         with frame frame-1.
     1384         if Make-Excel then  put   stream ForExcel unformatted
     1385         buf_temp-bon1.item-name
     1386         skip.
     1387       end.
     1388       find first buf_temp-bon1-gds where
     1389                 buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code no-error.
     1390       if not available buf_temp-bon1-gds then do:
     1391         find first buf_goods no-lock where
     1392                 buf_goods.gds-code = buf_temp-bon1.gds-code no-error.
     1393         create buf_temp-bon1-gds.
     1394         assign
     1395         buf_temp-bon1-gds.gds-code = buf_temp-bon1.gds-code
     1396         buf_temp-bon1-gds.gds-name = (if available buf_goods
     1397                                       then buf_goods.gds-name
     1398                                       else substitute("Неизвестный товар &1", buf_temp-bon1.gds-code))
     1399         .
     1400       end.
     1401       find first buf_temp-bon1-cashier where
     1402                 buf_temp-bon1-cashier.cashier-psn-code = buf_temp-bon1.cashier-psn-code no-error.
     1403       if not available buf_temp-bon1-cashier then do:
     1404         find first buf_clients no-lock where
     1405                 buf_clients.obj-type = 'чел':U
     1406             and buf_clients.obj-code = buf_temp-bon1.cashier-psn-code no-error.
     1407         create buf_temp-bon1-cashier.
     1408         assign
     1409         buf_temp-bon1-cashier.cashier-psn-code = buf_temp-bon1.cashier-psn-code
     1410         buf_temp-bon1-cashier.obj-name = (if available buf_clients
     1411                                       then buf_clients.obj-name
     1412                                       else substitute("Неизвестный кассир чел&1", buf_temp-bon1.cashier-psn-code))
     1413         .
     1414       end.
     1415       display stream PrnLibStream
     1416       (string(buf_temp-bon1.chk-date, "99.99.99") + chr(32) + string(buf_temp-bon1.chk-time, "HH:MM:SS")) @ pol2
     1417       (string(buf_temp-bon1.shift-date, "99.99.99") + chr(32) + string(buf_temp-bon1.shift-name, "X(2)")) @ pol3
     1418       buf_temp-bon1.doc-code @ pol4
     1419       buf_temp-bon1.d-card @ pol5
     1420       (if buf_temp-bon1.op-code = 1
     1421        then "Бонус (безнал)"
     1422        else "Бонус (нал)") @ pol6
     1423        buf_temp-bon1-gds.gds-name @ pol7
     1424        buf_temp-bon1.src-qnty @ pol8
     1425        buf_temp-bon1.src-price @ pol9
     1426        (buf_temp-bon1.src-price * buf_temp-bon1.src-qnty) @ pol10
     1427        buf_temp-bon1.src-sum @ pol11
     1428        buf_temp-bon1.discnt-value-abs @ pol12
     1429        buf_temp-bon1-cashier.obj-name @ pol13
     1430       WITH FRAME FRAME-1
     1431       .
     1432       DOWN STREAM PRnLibStream
     1433       with frame frame-1.
     1434       if Make-Excel then  put   stream ForExcel unformatted
     1435       CHR(9)
     1436       (string(buf_temp-bon1.chk-date, "99.99.99") + chr(32) + string(buf_temp-bon1.chk-time, "HH:MM:SS")) CHR(9)
     1437       (string(buf_temp-bon1.shift-date, "99.99.99") + chr(32) + string(buf_temp-bon1.shift-name, "X(2)")) CHR(9)
     1438       buf_temp-bon1.doc-code CHR(9)
     1439       buf_temp-bon1.d-card CHR(9)
     1440       (if buf_temp-bon1.op-code = 1
     1441        then "Бонус (безнал)"
     1442        else "Бонус (нал)") CHR(9)
     1443        buf_temp-bon1-gds.gds-name CHR(9)
     1444        buf_temp-bon1.src-qnty CHR(9)
     1445        buf_temp-bon1.src-price CHR(9)
     1446        (buf_temp-bon1.src-price * buf_temp-bon1.src-qnty) CHR(9)
     1447        buf_temp-bon1.src-sum CHR(9)
     1448        buf_temp-bon1.discnt-value-abs CHR(9)
     1449        buf_temp-bon1-cashier.obj-name
     1450        skip.
     1451       if last-of (buf_temp-bon1.item-name) then do:
     1452         underline stream PrnLibstream
     1453         pol1 pol2 pol3 pol4 pol5 pol6 pol7 pol8 pol9 pol10 pol11 pol12 pol13
     1454         with frame frame-1 .
     1455         DOWN STREAM PRnLibStream
     1456         with frame frame-1.
     1457         find first item_temp-bon1 no-lock where
     1458                   item_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1459               and item_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1460               and item_temp-bon1.item-type = buf_temp-bon1.item-type
     1461               and item_temp-bon1.item-name = buf_temp-bon1.item-name
     1462               and item_temp-bon1.gds-code = -1
     1463               and item_temp-bon1.op-code = 1 no-error.
     1464         DOWN STREAM PRnLibStream
     1465         with frame frame-1.
     1466         display stream PrnLibStream
     1467         "Итого" @ pol1
     1468         buf_temp-bon1.item-name @ pol2
     1469         "Бонус (безнал)" @ pol6
     1470         (if available item_temp-bon1
     1471          then item_temp-bon1.src-qnty
     1472          else 0.0)  @ pol8
     1473         (if available item_temp-bon1
     1474          then item_temp-bon1.src-sum
     1475          else 0.0) @ pol11
     1476         WITH FRAME FRAME-1.
     1477         DOWN STREAM PrnLibStream
     1478         with frame frame-1.
     1479         if Make-Excel then  put   stream ForExcel unformatted
     1480         "Итого" CHR(9)
     1481         buf_temp-bon1.item-name CHR(9)
     1482         CHR(9)
     1483         CHR(9)
     1484         CHR(9)
     1485         "Бонус (безнал)" CHR(9)
     1486         CHR(9)
     1487         (if available item_temp-bon1
     1488          then item_temp-bon1.src-qnty
     1489          else 0.0)  CHR(9)
     1490          CHR(9)
     1491          CHR(9)
     1492         (if available item_temp-bon1
     1493          then item_temp-bon1.src-sum
     1494          else 0.0) CHR(9)
     1495          skip.
     1496         find first item_temp-bon1 no-lock where
     1497                   item_temp-bon1.obj-type = buf_temp-bon1.obj-type
     1498               and item_temp-bon1.obj-code = buf_temp-bon1.obj-code
     1499               and item_temp-bon1.item-type = buf_temp-bon1.item-type
     1500               and item_temp-bon1.item-name = buf_temp-bon1.item-name
     1501               and item_temp-bon1.gds-code = -1
     1502               and item_temp-bon1.op-code = 2 no-error.
     1503         display stream PrnLibStream
     1504         "Итого" @ pol1
     1505         buf_temp-bon1.item-name @ pol2
     1506         "Бонус (нал)" @ pol6
     1507         (if available item_temp-bon1
     1508          then item_temp-bon1.src-qnty
     1509          else 0.0)  @ pol8
     1510         (if available item_temp-bon1
     1511          then item_temp-bon1.src-sum
     1512          else 0.0) @ pol11
     1513         (if available item_temp-bon1
     1514         then item_temp-bon1.discnt-value-abs
     1515         else 0.0) @ pol12
     1516         WITH FRAME FRAME-1.
     1517         DOWN STREAM PrnLibStream
     1518         with frame frame-1.
     1519         if Make-Excel then  put   stream ForExcel unformatted
     1520         "Итого" CHR(9)
     1521         buf_temp-bon1.item-name CHR(9)
     1522         CHR(9)
     1523         CHR(9)
     1524         CHR(9)
     1525         "Бонус (нал)" CHR(9)
     1526         CHR(9)
     1527         (if available item_temp-bon1
     1528          then item_temp-bon1.src-qnty
     1529          else 0.0)  CHR(9)
     1530          CHR(9)
     1531          CHR(9)
