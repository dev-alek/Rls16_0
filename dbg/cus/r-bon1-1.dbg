     1318   define variable pol6 as character no-undo .
     1319   define variable pol7 as character no-undo .
     1320   define variable pol8 as decimal   no-undo .
     1321   define variable pol9 as decimal   no-undo .
     1322   define variable pol10 as decimal  no-undo .
     1323   define variable pol11 as decimal  no-undo .
     1324   define variable pol12 as decimal  no-undo .
