      815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      816     (output var-report-r-b
      817     )  .
      818   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   function func-get-name-from-ext-type   returns char
      820     ( p-ext-type as character   ,
      821       p-caps     as logical ).
      822   define variable v-ext-name as character no-undo .
      823   run get-name-from-ext-type in this-procedure (
      824       input p-ext-type  ,
      825       input p-caps  ,
      826       output v-ext-name )
      827       no-error .
      828       if error-status :error then do:
      829          assign
      830            v-ext-name = p-ext-type
      831          .
      832       end.
      833    return (v-ext-name) .
      834   end.
      835   procedure get-name-from-ext-type :
      836    do
      837    on error undo, return error return-value
      838    :
      839   define input  parameter p-ext-type as character no-undo .
      840   define input  parameter p-caps     as logical no-undo   .
      841   define output parameter p-ext-name as character no-undo .
      842   define variable v-num as integer no-undo .
      843     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      844       message
      845         vss-include-info8 skip
      846         "Неправильно задано значение входящего параметра! "
      847         "Нет такого типа документов " p-ext-type
      848         view-as alert-box error .
      849         undo, return error .
      850     end.
      851     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      852     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      853     if p-caps  = true then do :
      854        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      855     end .
      856     end.
      857   end procedure.
      858   define variable vss-include-info9 as character format "X(65)" no-undo
      859   initial "@(#)$Workfile$ $Revision$".
      860   procedure grplib-get-full-name :
      861      define input parameter p-node-code  as integer      no-undo.
      862      define output parameter p-full-name as character    no-undo.
      863      do
      864   on error undo, return error
      865   :
      866       define variable v-upper-code    as integer           no-undo.
      867       define buffer buf_gds-grp       for ub.gds-grp.
      868       define buffer buf_upper_gds-grp for ub.gds-grp.
      869       find first buf_gds-grp no-lock
      870            where buf_gds-grp.node-code = p-node-code
      871       no-error.
      872       if not available buf_gds-grp
      873       then do:
      874           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      875       end.
      876       assign
      877           p-full-name  = ""
      878           v-upper-code = 1
      879       .
      880       do while buf_gds-grp.upper-code <> 0
      881       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      882       :
      883           assign
      884               p-full-name  = buf_gds-grp.node-name
      885                            + (if p-full-name <> "" then chr(47) else "")
      886                            + p-full-name
      887               v-upper-code = buf_gds-grp.upper-code
      888           .
      889           find first buf_gds-grp no-lock
      890                where buf_gds-grp.node-code = v-upper-code
      891           no-error.
      892           if not available buf_gds-grp
      893           then do:
      894               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      895                                   + string( v-upper-code )
      896                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      897           end.
      898       end.
      899       assign
      900       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      901       .
      902   end.
      903   end .
      904   procedure grplib-get-node-from-full-name :
      905   define input parameter p-full-name as character no-undo .
      906   define output parameter p-node-code as integer no-undo .
      907   define variable v-ii as integer no-undo .
      908   define variable v-upper-code as integer no-undo .
      909   define variable v-root-code as integer no-undo .
      910   define variable v-entry as character no-undo .
      911   define buffer buf_gds-grp       for ub.gds-grp.
      912   do
      913   on error undo, return error
      914   :
      915     find first buf_gds-grp no-lock
      916         where buf_gds-grp.upper-code = 0
      917     no-error .
      918     if not available buf_gds-grp
      919     then do:
      920         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      921     end.
      922     else do:
      923       assign
      924       v-root-code = buf_gds-grp.node-code
      925       .
      926     end.
      927     v-upper-code = v-root-code.
      928     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      929       assign
      930       v-entry = entry(v-ii, p-full-name, chr(47)).
      931       if v-entry = '' then leave.
      932       find first buf_gds-grp no-lock where
      933                 buf_gds-grp.node-name = v-entry
      934             and buf_gds-grp.upper-code = v-upper-code
      935             no-error.
      936       if not available buf_gds-grp then do:
      937         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      938       end.
      939       else do:
      940         p-node-code = buf_gds-grp.node-code.
      941         v-upper-code = buf_gds-grp.node-code.
      942       end.
      943     end.
      944   end.
      945   end .
      946   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   define variable v-waitfram-action01         as character   no-undo .
      948   define variable v-waitfram-action02         as character   no-undo .
      949   define variable v-waitfram-action03         as character   no-undo .
      950   define variable mWaitFramTextBeg            as character   no-undo.
      951   define variable mWaitFramTextEnd            as character   no-undo.
      952   define variable mWaitFramView               as logical     no-undo.
      953   define variable mWaitProcEvent              as logical     no-undo init yes.
      954   define variable mWaitFramInterval           as integer     no-undo init 1 .
      955   define variable mWaitFramStop               as logical     no-undo.
      956   define variable mWaitFramStopUser           as logical     no-undo.
      957   define variable mWaitFramStopTimeOut        as logical     no-undo.
      958   define variable mWaitFramStartProc          as datetime-tz no-undo.
      959   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      960   define button B-WaitFramStop auto-end-key
      961        label "Стоп"
      962        size 10 by 1 tooltip "Остоновить процесс".
      963   define button B-viewProcInfo
      964        label "Информация"
      965        size 15 by 1 tooltip "Информация о процесс".
      966   define frame waitfram
      967     v-waitfram-action01 format "x(72)" no-label skip
      968     v-waitfram-action02 format "x(72)" no-label skip
      969     v-waitfram-action03 format "x(72)" no-label skip
      970     B-viewProcInfo
      971     B-WaitFramStop at row 4 col 30
      972     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      973     .
      974   define new global shared variable mBatchMode as logical no-undo init ?.
      975   define variable mFramBachModHandle as handle no-undo.
      976   mFramBachModHandle = frame waitfram:handle.
      977   define variable mFameOldVis as logical no-undo.
      978   define variable mVisCUrentVin as logical no-undo.
      979   if session:batch-mode
      980   then
      981      mBatchMode = yes.
      982   if mBatchMode = ? then do:
      983     mVisCUrentVin = current-window:visible.
      984     mFameOldVis = mFramBachModHandle:visible.
      985     mFramBachModHandle:visible  = yes.
      986     mBatchMode = mFramBachModHandle:visible ne yes.
      987     mFramBachModHandle:visible = mFameOldVis.
      988     current-window:visible = mVisCUrentVin.
      989   end.
      990    if  log-manager:logfile-name ne ?
      991     then DO:
      992         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      993         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      994         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      995     end.
      996   on choose of B-WaitFramStop in frame waitfram
      997   do:
      998     mWaitFramStop = yes.
      999     mWaitFramStopUser = yes.
     1000   end.
     1001   function waitfram-check-timeout returns logical():
     1002      define variable vtime as int64 no-undo.
     1003      if mWaitFramStopTimeOut
     1004      then
     1005         return yes.
     1006      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1007      if     mWaitFramTimeOut ne ?
     1008         and mWaitFramTimeOut ne 0
     1009         and mWaitFramTimeOut lt vtime
     1010      then do:
     1011         mWaitFramStopTimeOut = yes.
     1012      end.
     1013      return mWaitFramStopTimeOut.
     1014   end.
     1015   procedure waitfram-hide :
     1016     if not session:batch-mode
     1017     then do
     1018     on error undo, return error return-value
     1019     :
     1020       pause 0 before-hide .
     1021       if not mBatchMode then
     1022         hide frame waitfram .
     1023     if     not mWaitFramView
     1024        and mWaitProcEvent
     1025     then
     1026       process events .
     1027     end.
     1028   end procedure.
     1029   procedure waitfram-show :
     1030     define input  parameter p-message as character no-undo .
     1031     define variable v-left-margin as integer   no-undo .
     1032     if not session:batch-mode
     1033     then do
     1034     on error undo, return error return-value
     1035     :
     1036       if length(p-message) <= 70 then do:
     1037         assign
     1038           v-left-margin = integer((70 - length(p-message)) / 2)
     1039         .
     1040         assign
     1041           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1042         .
     1043         assign
     1044           v-waitfram-action01 = " "
     1045           v-waitfram-action02 = " "
     1046                                    + fill(" ", v-left-margin)
     1047                                    + p-message
     1048           v-waitfram-action03 = " "
     1049         .
     1050       end.
     1051       else do:
     1052         define variable vRindex1 as integer no-undo.
     1053         define variable vRindex2 as integer no-undo.
     1054         vRindex1 = r-index(p-message," ",70).
     1055         if vRindex1 = 0
     1056         then
     1057            vRindex1 = 70.
     1058         if length(p-message)  <= vRindex1 + 70 then do:
     1059           assign
     1060             v-waitfram-action01 = " "
     1061             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1062             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1063           .
     1064         end.
     1065         else do:
     1066           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1067           if vRindex2 <= vRindex1
     1068           then
     1069              vRindex2 = vRindex1 + 70.
     1070           assign
     1071             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1072             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1073             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1074           .
     1075         end.
     1076       end.
     1077       B-viewProcInfo:visible   in frame waitfram = no.
     1078       B-viewProcInfo:sensitive in frame waitfram = no.
     1079       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1080       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1081       if  (   mWaitFramView
     1082          or  mWaitProcEvent)
     1083          and not mBatchMode
     1084       then
     1085          display
     1086             v-waitfram-action01 skip
     1087             v-waitfram-action02 skip
     1088             v-waitfram-action03 skip
     1089          with frame waitfram .
     1090       if     mWaitFramView
     1091          then do:
     1092             if     mWaitFramInterval ne ?
     1093                and not mBatchMode
     1094             then
     1095                wait-for go of frame waitfram pause mWaitFramInterval.
     1096          end.
     1097          else
     1098             if     mWaitProcEvent
     1099                and not mBatchMode
     1100             then
     1101                process events .
     1102     end.
     1103   end procedure.
     1104      procedure waitfram-show-this:
     1105         define input  parameter iInterval as int64 no-undo.
     1106         define variable vtime as int64 no-undo.
     1107         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1108         mWaitFramInterval = iInterval.
     1109         run waitfram-show (substitute("&1&2 &3&4" ,
     1110                                       mWaitFramTextBeg ,
     1111                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1112                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1113                                       mWaitFramTextEnd
     1114                                      )
     1115                           ).
     1116      end.
     1117      procedure WaitFramRunPause:
     1118         define input  parameter iInterval as dec no-undo.
     1119         define variable vStart  as datetime-tz no-undo.
     1120         define variable vend    as datetime-tz no-undo.
     1121         define variable vint as int64 no-undo.
     1122         define variable vOk as logical no-undo.
     1123         vStart = now.
     1124         vend   = vStart.
     1125         publish "WaitFramPause" (iInterval,output vOk).
     1126         vend   =  now.
     1127         vint = vend - vStart.
     1128         vint = iInterval - vint / 1000.
     1129         if     not mWaitFramStop
     1130            and (   vint > 0
     1131                 or (    not vOk
     1132                     and iInterval eq ?
     1133                     )
     1134                 )
     1135         then
     1136            run waitfram-show-this (iInterval).
     1137         vend   =  now.
     1138         vint = vend - vStart.
     1139         vint = iInterval - vint / 1000.
     1140         if     not mWaitFramStop
     1141            and vint > 0
     1142         then do:
     1143            run gbl/pause.p (vint * 1000).
     1144         end.
     1145         if iInterval ne ?
     1146         then
     1147            publish "WaitFramStop".
     1148         waitfram-check-timeout().
     1149      end.
     1150      procedure WaitFramWaitFor:
     1151         define input  parameter iInterval as dec no-undo.
     1152         assign
     1153            mWaitFramStartProc   = now
     1154            mWaitFramStopUser    = no
     1155            mWaitFramStopTimeOut = no
     1156         .
     1157         block-wait:
     1158         do while not mWaitFramStop:
     1159            run WaitFramRunPause (iInterval).
     1160            if  waitfram-check-timeout()
     1161            then do:
     1162               leave block-wait.
     1163            end.
     1164         end.
     1165         run waitfram-hide.
     1166      end.
     1167   procedure waitfram-join :
     1168     define input  parameter p-line-1  as character no-undo .
     1169     define input  parameter p-line-2  as character no-undo .
     1170     define input  parameter p-line-3  as character no-undo .
     1171     define output parameter p-message as character no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175       assign
     1176         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1177                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1178                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1179       .
     1180     end.
     1181   end procedure.
     1182   function waitfram-join-function returns character
     1183     (input p-line-1 as character
     1184     ,input p-line-2 as character
     1185     ,input p-line-3 as character
     1186     ).
     1187     define variable v-message as character no-undo .
     1188     run waitfram-join in this-procedure
     1189       (input  p-line-1
     1190       ,input  p-line-2
     1191       ,input  p-line-3
     1192       ,output v-message
     1193       ) .
     1194     return v-message .
     1195   end function .
     1196   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   procedure grp-obj-write :
     1198   do
     1199   on error undo, return error
     1200   :
     1201   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
     1202   define input parameter p-host-code  as integer                          no-undo.
     1203   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     1204   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     1205   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
     1206   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
     1207   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
     1208   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
     1209   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
     1210   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
     1211   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
     1212   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
     1213   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     1214       find first buf_gds-grp-obj exclusive-lock
     1215            where buf_gds-grp-obj.node-code  = p-node-code
     1216              and buf_gds-grp-obj.host-code  = p-host-code
     1217              and buf_gds-grp-obj.obj-type   = p-obj-type
     1218              and buf_gds-grp-obj.obj-code   = p-obj-code
     1219       no-error.
     1220       if not available buf_gds-grp-obj
     1221       then do:
     1222           create buf_gds-grp-obj.
     1223           assign
     1224                   buf_gds-grp-obj.node-code  = p-node-code
     1225                   buf_gds-grp-obj.host-code  = p-host-code
     1226                   buf_gds-grp-obj.obj-type   = p-obj-type
     1227                   buf_gds-grp-obj.obj-code   = p-obj-code
     1228           .
     1229       end.
     1230       assign
     1231       buf_gds-grp-obj.min-increase = p-min-increase
     1232       buf_gds-grp-obj.max-increase = p-max-increase
     1233       buf_gds-grp-obj.increase-pc = p-increase-pc
     1234       buf_gds-grp-obj.calc-method = p-calc-method
     1235       buf_gds-grp-obj.round-method = p-round-method
     1236       buf_gds-grp-obj.round-coef = p-round-coef
     1237       buf_gds-grp-obj.cli-type   = p-cli-type
     1238       buf_gds-grp-obj.cli-code   = p-cli-code
     1239       .
     1240   end.
     1241   end procedure.
     1242   procedure grp-obj-margin-value :
     1243   do
     1244   on error undo, return error
     1245   :
     1246   define input parameter p-node-code as integer      no-undo.
     1247   define input parameter p-obj-type  as character    no-undo.
     1248   define input parameter p-obj-code  as integer      no-undo.
     1249   define output parameter p-min-value as decimal      no-undo init ?.
     1250   define output parameter p-max-value as decimal      no-undo init ?.
     1251   define output parameter p-increase-pc as decimal      no-undo init ?.
     1252   define output parameter p-round-method as character no-undo init "":U.
     1253   define output parameter p-base as decimal no-undo init ?.
     1254   define output parameter p-range-margin     as integer      no-undo.
     1255   define output parameter p-exists-margin    as logical      no-undo.
     1256   define output parameter p-range-increase     as integer      no-undo.
     1257   define output parameter p-exists-increase    as logical      no-undo.
     1258   define output parameter p-range-rmethod     as integer no-undo .
     1259   define output parameter p-exists-rmethod    as logical no-undo .
     1260   define variable v-host-code as integer      no-undo.
     1261   DEFINE VARIABLE v-found as logical no-undo .
     1262   DEFINE VARIABLE v-exists as logical no-undo .
     1263   DEFINE VARIABLE v-range as integer no-undo .
     1264   DEFINE VARIABLE jj as integer no-undo .
     1265   DEFINE VARIABLE v-margin-found as logical no-undo .
     1266   DEFINE VARIABLE v-increase-found as logical no-undo .
     1267   DEFINE VARIABLE v-min-value as decimal      no-undo.
     1268   DEFINE VARIABLE v-max-value as decimal      no-undo.
     1269   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
     1270   define variable v-round-method as character no-undo .
     1271   define variable v-base as decimal no-undo .
     1272   define variable v-print-code as character no-undo .
     1273   define buffer buf_gds-grp for ub.gds-grp.
     1274   find first buf_gds-grp no-lock where
     1275              buf_gds-grp.node-code = p-node-code no-error .
     1276   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1277     message
     1278       vss-workfile vss-revision vss-description
     1279       skip "Не удалось найти группу товаров с кодом" p-node-code
     1280       view-as alert-box error .
     1281     undo, return error .
     1282   end.
     1283   if p-obj-type <> '' then do:
     1284   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1286     (input  p-obj-type
     1287     ,input  p-obj-code
     1288     ,output v-host-code
     1289     ) no-error .
     1290     if error-status :error
     1291     then do:
     1292         message
     1293           vss-workfile vss-revision vss-description
     1294           skip "Не удалось найти фирму объекта"
     1295           skip p-obj-type p-obj-code
     1296           skip return-value
     1297           skip trim(error-status :get-message(1))
     1298               trim(error-status :get-message(2))
     1299               trim(error-status :get-message(3))
     1300               trim(error-status :get-message(4))
     1301               trim(error-status :get-message(5))
     1302         view-as alert-box error.
     1303         undo, return error .
     1304     end.
     1305   end.
     1306   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1307   do while v-found = no and jj < 2:
     1308     if v-range <> 3 then do:
     1309       find first buf_gds-grp-obj no-lock
     1310           where buf_gds-grp-obj.node-code = p-node-code
     1311             and buf_gds-grp-obj.host-code = v-host-code
     1312             and buf_gds-grp-obj.obj-type  = p-obj-type
     1313             and buf_gds-grp-obj.obj-code  = p-obj-code
     1314       no-error .
     1315     end.
     1316     if v-range = 3 or not available buf_gds-grp-obj
     1317     then do:
     1318        if v-range <> 2 then do:
     1319           find first buf_gds-grp-obj no-lock
     1320               where buf_gds-grp-obj.node-code = p-node-code
     1321                 and buf_gds-grp-obj.host-code = v-host-code
     1322                 and buf_gds-grp-obj.obj-type  = ""
     1323                 and buf_gds-grp-obj.obj-code  = 0
     1324           no-error .
     1325         end.
     1326         if v-range = 2 or not available buf_gds-grp-obj
     1327         then do:
     1328             if v-range <> 1 then do:
     1329               find first buf_gds-grp-obj no-lock
     1330                   where buf_gds-grp-obj.node-code = p-node-code
     1331                   and buf_gds-grp-obj.host-code = 0
     1332                   and buf_gds-grp-obj.obj-type  = ""
     1333                   and buf_gds-grp-obj.obj-code  = 0
     1334               no-error .
     1335             end.
     1336             if v-range = 1 or not available buf_gds-grp-obj
     1337             then do:
     1338                 assign
     1339                     v-exists = no
     1340                 .
     1341             end.
     1342             else do:
     1343                 assign
     1344                     v-exists = yes
     1345                     v-range = 1
     1346                 .
     1347             end.
     1348         end.
     1349         else do:
     1350             assign
     1351                 v-exists = yes
     1352                 v-range  = 2
     1353             .
     1354         end.
     1355     end.
     1356     else do:
     1357         assign
     1358             v-exists = yes
     1359             v-range  = 3
     1360         .
     1361     end.
     1362     if available buf_gds-grp-obj
     1363     then do:
     1364       assign
     1365       v-min-value    = buf_gds-grp-obj.min-increase
     1366       v-max-value    = buf_gds-grp-obj.max-increase
     1367       v-increase-pc  = buf_gds-grp-obj.increase-pc
     1368       v-round-method = buf_gds-grp-obj.round-method
     1369       v-base         = buf_gds-grp-obj.round-coef
     1370       .
     1371       assign
     1372       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
     1373                           then yes
     1374                           else p-exists-margin)
     1375       p-range-margin = if p-exists-margin and p-min-value = ?
     1376                         then v-range
     1377                         else p-range-margin
     1378       p-min-value   =  if p-exists-margin and  p-min-value = ?
     1379                         then v-min-value
     1380                         else p-min-value
     1381       p-max-value   =  if p-exists-margin and  p-max-value = ?
     1382                         then v-max-value
     1383                         else p-max-value
     1384       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     1385                           then yes
     1386                           else p-exists-increase)
     1387       p-range-increase = if p-exists-increase and p-increase-pc = ?
     1388                         then v-range
     1389                         else p-range-increase
     1390       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     1391                         then v-increase-pc
     1392                         else p-increase-pc)
     1393       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     1394                           then yes
     1395                           else p-exists-rmethod
     1396       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     1397                           then v-range
     1398                           else p-range-rmethod)
     1399       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     1400                           then v-round-method
     1401                           else p-round-method)
     1402       p-base          = (if p-exists-rmethod and p-base = ?
     1403                           then v-base
     1404                           else p-base)
     1405       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1406       jj = jj + 1
     1407       .
     1408     end.
     1409     else do:
     1410       assign
     1411       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1412       jj = jj + 1
     1413       .
     1414     end.
     1415   end.
     1416   end.
     1417   end procedure.
     1418   procedure grp-obj-income-cli-value :
     1419   do
     1420   on error undo, return error
     1421   :
     1422   define input parameter p-node-code as integer      no-undo.
     1423   define input parameter p-obj-type  as character    no-undo.
     1424   define input parameter p-obj-code  as integer      no-undo.
     1425   define output parameter p-cli-type as character    no-undo init ?.
     1426   define output parameter p-cli-code as integer      no-undo init ?.
     1427   define output parameter p-range-income-cli     as integer      no-undo.
     1428   define output parameter p-exists-income-cli    as logical      no-undo.
     1429   define variable v-host-code as integer      no-undo.
     1430   DEFINE VARIABLE v-found as logical no-undo .
     1431   DEFINE VARIABLE v-exists as logical no-undo .
     1432   DEFINE VARIABLE v-range as integer no-undo .
     1433   DEFINE VARIABLE jj as integer no-undo .
     1434   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     1435   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     1436   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     1437   define buffer buf_gds-grp for ub.gds-grp.
     1438   find first buf_gds-grp no-lock where
     1439              buf_gds-grp.node-code = p-node-code no-error .
     1440   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1441     message
     1442       vss-workfile vss-revision vss-description
     1443       skip "Не удалось найти группу товаров с кодом" p-node-code
     1444       view-as alert-box error .
     1445     undo, return error .
     1446   end.
     1447   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1449     (input  p-obj-type
     1450     ,input  p-obj-code
     1451     ,output v-host-code
     1452     ) no-error .
     1453   if error-status :error
     1454   then do:
     1455       message
     1456         vss-workfile vss-revision vss-description
     1457         skip "Не удалось найти фирму объекта"
     1458         skip p-obj-type p-obj-code
     1459         skip return-value
     1460         skip trim(error-status :get-message(1))
     1461              trim(error-status :get-message(2))
     1462              trim(error-status :get-message(3))
     1463              trim(error-status :get-message(4))
     1464              trim(error-status :get-message(5))
     1465       view-as alert-box error.
     1466       undo, return error .
     1467   end.
     1468   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1469   do while v-found = no and jj < 2:
     1470     if v-range <> 3 then do:
     1471       find first buf_gds-grp-obj no-lock
     1472           where buf_gds-grp-obj.node-code = p-node-code
     1473             and buf_gds-grp-obj.host-code = v-host-code
     1474             and buf_gds-grp-obj.obj-type  = p-obj-type
     1475             and buf_gds-grp-obj.obj-code  = p-obj-code
     1476       no-error .
     1477     end.
     1478     if v-range = 3 or not available buf_gds-grp-obj
     1479     then do:
     1480        if v-range <> 2 then do:
     1481           find first buf_gds-grp-obj no-lock
     1482               where buf_gds-grp-obj.node-code = p-node-code
     1483                 and buf_gds-grp-obj.host-code = v-host-code
     1484                 and buf_gds-grp-obj.obj-type  = ""
     1485                 and buf_gds-grp-obj.obj-code  = 0
     1486           no-error .
     1487         end.
     1488         if v-range = 2 or not available buf_gds-grp-obj
     1489         then do:
     1490             if v-range <> 1 then do:
     1491               find first buf_gds-grp-obj no-lock
     1492                   where buf_gds-grp-obj.node-code = p-node-code
     1493                   and buf_gds-grp-obj.host-code = 0
     1494                   and buf_gds-grp-obj.obj-type  = ""
     1495                   and buf_gds-grp-obj.obj-code  = 0
     1496               no-error .
     1497             end.
     1498             if v-range = 1 or not available buf_gds-grp-obj
     1499             then do:
     1500                 assign
     1501                     v-exists = no
     1502                 .
     1503             end.
     1504             else do:
     1505                 assign
     1506                     v-exists = yes
     1507                     v-range = 1
     1508                 .
     1509             end.
     1510         end.
     1511         else do:
     1512             assign
     1513                 v-exists = yes
     1514                 v-range  = 2
     1515             .
     1516         end.
     1517     end.
     1518     else do:
     1519         assign
     1520             v-exists = yes
     1521             v-range  = 3
     1522         .
     1523     end.
     1524     if available buf_gds-grp-obj
     1525     then do:
     1526       assign
     1527       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1528       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1529       .
     1530       assign
     1531       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1532                           then yes
     1533                           else p-exists-income-cli)
     1534       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1535                         then v-range
     1536                         else p-range-income-cli
     1537       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1538                         then v-cli-type-value
     1539                         else p-cli-type
     1540       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1541                         then v-cli-code-value
     1542                         else p-cli-code
     1543       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1544       jj = jj + 1
     1545       .
     1546     end.
     1547     else do:
     1548       assign
     1549       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1550       jj = jj + 1
     1551       .
     1552     end.
     1553   end.
     1554   end.
     1555   end procedure.
     1556   procedure proc-alt-shift-f2:
     1557     if not ibs.th.gbl.gbl-var:rcode
     1558   then
     1559     run gbl\inidebug.p .
     1560   end.
     1561   procedure proc-alt-shift-f3:
     1562     run gbl/prvssinf.p
     1563       ( input this-procedure
     1564       ) .
     1565   end.
     1566   define variable v-inform-launched as logical no-undo initial false .
     1567   procedure proc-alt-shift-f4:
     1568     define variable v-action as character no-undo .
     1569     if v-inform-launched = false then do:
     1570       assign
     1571         v-inform-launched = true
     1572       .
     1573       run gbl/d-inform.w
     1574         (  input self
     1575         ,  input this-procedure
     1576         , output v-action
     1577         ) no-error .
     1578       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1579       assign
     1580         v-inform-launched = false
     1581       .
     1582     end.
     1583   end.
     1584   procedure proc-alt-f1:
     1585     run gbl/corrhelp.p
     1586       (input this-procedure
     1587       ) .
     1588   end .
     1589   on alt-shift-f2 anywhere do:
     1590     run proc-alt-shift-f2.
     1591   end.
     1592   on alt-shift-f3 anywhere do:
     1593     run proc-alt-shift-f3 in this-procedure .
     1594   end.
     1595   on alt-shift-f4 anywhere do:
     1596     run proc-alt-shift-f4 in this-procedure.
     1597   end.
     1598   on alt-f1 anywhere do:
     1599     run proc-alt-f1 in this-procedure .
     1600   end.
     1601   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1602     define variable v-cntxt-db-num        as integer   no-undo .
     1603     define variable v-cntxt-userid        as character no-undo .
     1604     define variable v-cntxt-level         as character no-undo .
     1605     define variable v-cntxt-host-code-obj as integer   no-undo .
     1606     define variable v-cntxt-obj-type      as character no-undo .
     1607     define variable v-cntxt-obj-code      as integer   no-undo .
     1608     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1609     define variable v-cntxt-is-admin      as logical   no-undo .
     1610   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611   procedure proc-ord-code :
     1612   define input  parameter  p-type as character no-undo .
     1613   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1614   define input  parameter  v-cntxt-obj-type as character no-undo .
     1615   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1616   define input  parameter  p-i-doc    as character no-undo .
     1617   define output parameter  p-ord-doc  as character no-undo .
     1618   define variable          v-idop     as character no-undo .
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622   case p-type :
     1623       when "main-no-ver" then do:
     1624         if  (v-cntxt-db-num <> 0) then
     1625           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1626         else
     1627           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1628       end.
     1629       when "main" then do:
     1630             do while true:
     1631             if  (v-cntxt-db-num <> 0) then
     1632               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1633             else
     1634               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1635             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1636             End.
     1637       end.
     1638       when "chip" then do:
     1639         assign
     1640           v-idop = p-i-doc .
     1641         do while true :
     1642           if index (v-idop , ".") = 0 then
     1643             v-idop  = replace (v-idop , "-", "-1.").
     1644           else
     1645             v-idop  =
     1646             substring (v-idop , 1, index (v-idop, "-")) +
     1647             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1648             substring (v-idop, index (v-idop, ".")).
     1649           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1650         end.
     1651         assign
     1652           p-ord-doc = v-idop.
     1653       end.
     1654   end case.
     1655     end.
     1656   end procedure.
     1657   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
