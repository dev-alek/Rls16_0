     1948   define variable to-arm      as character no-undo .
     1949   define variable store-type   as character no-undo .
     1950   define variable store-code   as integer   no-undo .
     1951   define variable g#db-remote as logical   no-undo .
     1952   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1953     run mainmenu_getcntxt in parparentproc
     1954       (output v-cntxt-db-num
     1955       ,output v-cntxt-userid
     1956       ,output v-cntxt-level
     1957       ,output v-cntxt-host-code-obj
     1958       ,output v-cntxt-obj-type
     1959       ,output v-cntxt-obj-code
     1960       ,output v-cntxt-db-num-obj
     1961       ,output v-cntxt-is-admin
     1962       ) .
     1963   assign
     1964     store-type    = v-cntxt-obj-type
     1965     store-code    = v-cntxt-obj-code
     1966     g#db-remote   = (v-cntxt-db-num <> 0)
     1967   .
     1968   define variable rid-list as character no-undo .
     1969   define buffer buf_ord-doc for ub.ord-doc.
     1970   DEFINE BUFFER buf_goods FOR ub.goods.
     1971   DEFINE BUFFER X_doc-line FOR ub.doc-line.
     1972   DEFINE BUFFER X_gds-obj FOR ub.gds-obj.
     1973   DEFINE BUFFER X_goods FOR ub.goods.
     1974   DEFINE BUFFER X_ord-doc-rcv FOR ub.ord-doc-rcv.
     1975   DEFINE BUFFER buf_ord-doc-rcv FOR ub.ord-doc-rcv.
     1976   DEFINE BUFFER buf_ord-line-rcv FOR ub.ord-line-rcv.
     1977   DEFINE BUFFER X_ord-line FOR ub.ord-line.
     1978   DEFINE BUFFER X_trn-doc FOR ub.trn-doc.
     1979   define buffer   buf2-ord-doc-rcv  for ub.ord-doc-rcv .
     1980   define buffer   buf2-doc-line     for ub.doc-line     .
     1981   define temp-table temp-rcv-line no-undo like ub.ord-line-rcv
     1982   field cli-type as character
     1983   field cli-code as integer
     1984   .
     1985   find first buf_ord-doc  exclusive-lock  where
     1986              recid(buf_ord-doc) = p-ord-doc-recid
     1987              no-error .
     1988   if error-status :error then do:
     1989   message vss-workfile vss-revision vss-description skip
     1990       "Ошибка  " skip
     1991         skip
     1992         error-status :get-message(1) skip
     1993         return-value skip
     1994         view-as alert-box error
     1995   .
     1996   return error.
     1997   end.
     1998   define variable  v-cli-type as character no-undo .
     1999   define variable  v-cli-code as integer no-undo .
     2000   define variable  v-node-code as integer no-undo .
     2001   define variable v-recid as recid no-undo .
     2002   define variable  v-range-income-cli     as integer      no-undo.
     2003   define variable  v-exists-income-cli    as logical      no-undo.
     2004   define variable v-old-qnty                as decimal no-undo .
     2005   define variable v-delta                   as decimal no-undo .
     2006   define variable v-temp-rcv-line_qnty      as decimal no-undo .
     2007   define variable  par-type    as character no-undo.
     2008   define variable par-ord-oobj as logical no-undo .
     2009   define variable varpurch-code as integer no-undo.
     2010   define buffer buf_clients for ub.clients.
     2011   define variable v-value-character  as character no-undo .
     2012   define variable v-value-date       as date      no-undo .
     2013   define variable v-value-decimal    as decimal   no-undo .
     2014   define variable v-value-integer    as integer   no-undo .
     2015   run adm/shattri.p (
     2016     input "get":U
     2017     ,input ""
     2018     ,input 0
     2019     ,input 'ord-global':U
     2020     ,input 'ord-oobj':U
     2021     ,output v-value-character
     2022     ,output v-value-date
     2023     ,output v-value-decimal
     2024     ,output v-value-integer
     2025     ,output par-ord-oobj
     2026     ,output par-type
     2027     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2028     ) no-error .
     2029     if error-status :error then par-ord-oobj = false .
     2030   for each x_ord-line no-lock where
     2031       x_ord-line.doc-code = buf_ord-doc.doc-code,
     2032          each buf_goods no-lock where
     2033               buf_goods.prod-type =  x_ord-line.prod-type and
     2034               buf_goods.prod-code =  x_ord-line.prod-code and
     2035               buf_goods.artic     =  x_ord-line.artic
     2036               break by buf_goods.grp-code
     2037               on error undo, return error :
     2038               if first-of(buf_goods.grp-code) then do:
     2039                  run grp-obj-income-cli-value in this-procedure
     2040                    (
     2041                     input buf_goods.grp-code   ,
     2042                     input buf_ord-doc.obj-type ,
     2043                     input buf_ord-doc.obj-code ,
     2044                     output v-cli-type          ,
     2045                     output v-cli-code          ,
     2046                     output v-range-income-cli  ,
     2047                     output v-exists-income-cli   ) .
     2048               end.
     2049            if not v-exists-income-cli  then next.
     2050            find first buf_clients no-lock where
     2051                       buf_clients.obj-type = v-cli-type and
     2052                       buf_clients.obj-code = v-cli-code no-error .
     2053                       if error-status :error then do:
     2054                         message "На группу " buf_goods.grp-name " не верно задан внутренний поставщик " .
     2055                         next.
     2056                       end.
     2057            v-old-qnty = 0 .
     2058            for each buf_ord-doc-rcv no-lock where
     2059                buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     2060                on error undo, return error :
     2061                for each buf_ord-line-rcv no-lock where
     2062                        buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code and
     2063                        buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code and
     2064                        buf_ord-line-rcv.prod-type = x_ord-line.prod-type and
     2065                        buf_ord-line-rcv.prod-code = x_ord-line.prod-code and
     2066                        buf_ord-line-rcv.artic     = x_ord-line.artic ,
     2067                     first buf2-ord-doc-rcv no-lock where
     2068                           buf2-ord-doc-rcv.rcv-code =  buf_ord-line-rcv.rcv-code and
     2069                           buf2-ord-doc-rcv.doc-code =  buf_ord-line-rcv.doc-code    ,
     2070                     each ub.ord-chain no-lock where
     2071                           ub.ord-chain.doc-code = buf2-ord-doc-rcv.rcv-code and
     2072                           ub.ord-chain.doc-type = 'rcv'                     and
     2073                           ub.ord-chain.rel-doc-type = 'trn'              ,
     2074                     first buf2-doc-line no-lock where
     2075                           buf2-doc-line.doc-code     =  ub.ord-chain.rel-doc-code  and
     2076                           buf2-doc-line.artic        =  buf_ord-line-rcv.artic    and
     2077                           buf2-doc-line.prod-code    =  buf_ord-line-rcv.prod-code and
     2078                           buf2-doc-line.prod-type    =  buf_ord-line-rcv.prod-type
     2079                    on error undo, return error :
     2080                    v-old-qnty = v-old-qnty + buf2-doc-line.fact-qnty .
     2081                end.
     2082            end.
     2083            v-delta = x_ord-line.qnty - v-old-qnty .
     2084           if v-delta <= 0 then next.
     2085           v-temp-rcv-line_qnty      = 0.
     2086           if par-ord-oobj  = true then do :
     2087                 find first x_gds-obj no-lock where
     2088                             x_gds-obj.obj-type  = v-cli-type and
     2089                             x_gds-obj.obj-code  = v-cli-code and
     2090                             x_gds-obj.prod-type = x_ord-line.prod-type and
     2091                             x_gds-obj.prod-code = x_ord-line.prod-code and
     2092                             x_gds-obj.artic     = x_ord-line.artic no-error .
     2093                             .
     2094                 if available x_gds-obj and x_gds-obj.free-qnty  > 0 then do:
     2095                     v-temp-rcv-line_qnty      = MINIMUM (x_gds-obj.free-qnty , v-delta).
     2096                 end.
     2097           end.
     2098           else do:
     2099             v-temp-rcv-line_qnty      = v-delta .
     2100           end.
     2101            if v-temp-rcv-line_qnty  <= 0 then next .
     2102           create temp-rcv-line.
     2103           BUFFER-COPY x_ord-line to temp-rcv-line
     2104            assign
     2105             temp-rcv-line.rcv-code = "temp"
     2106             temp-rcv-line.cli-type = v-cli-type
     2107             temp-rcv-line.cli-code = v-cli-code
     2108             temp-rcv-line.qnty     = v-temp-rcv-line_qnty
     2109            .
     2110   end.
     2111   for each temp-rcv-line break by  temp-rcv-line.cli-type by temp-rcv-line.cli-code
     2112       on error undo, return error :
     2113       if first-of(temp-rcv-line.cli-code) then do:
     2114           run make-rcv in this-procedure (
     2115               input temp-rcv-line.cli-type ,
     2116               input temp-rcv-line.cli-code ,
     2117               output v-recid
     2118               ) .
     2119       end.
     2120   end.
     2121    run exit-proc in this-procedure .
     2122   PROCEDURE exit-proc :
     2123    do
     2124    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2125    :
     2126   define variable glob-gen as logical init false  no-undo .
     2127   define variable v-kk as integer no-undo .
     2128   define buffer buf_ver_ord-doc-rcv  for ub.ord-doc-rcv.
     2129   define buffer buf_ver_doc-line for ub.doc-line.
     2130   define buffer buf_ver_trn-doc  for ub.trn-doc.
     2131   define variable t-log-4 as logical no-undo .
     2132   define variable varchip-code      as integer   no-undo.
     2133   t-log-4 = false .
     2134   for each buf_ver_ord-doc-rcv no-lock where
     2135            buf_ver_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     2136            on error undo, return error :
     2137           v-kk = 0 .
     2138           for each ub.ord-chain no-lock where
     2139                     ub.ord-chain.doc-code = buf_ver_ord-doc-rcv.rcv-code and
     2140                     ub.ord-chain.doc-type = 'rcv'                  and
     2141                     ub.ord-chain.rel-doc-type = 'trn'
     2142                     :
     2143                 for each buf_ver_doc-line no-lock where
     2144                     buf_ver_doc-line.doc-code = ub.ord-chain.rel-doc-code
     2145                     on error undo, return error :
     2146                     v-kk = v-kk + 1 .
     2147                 end.
     2148           end.
     2149           if v-kk = 0 then do:
     2150           for each ub.ord-chain no-lock where
     2151                     ub.ord-chain.doc-code = buf_ver_ord-doc-rcv.rcv-code and
     2152                     ub.ord-chain.doc-type = 'rcv'                  and
     2153                     ub.ord-chain.rel-doc-type = 'trn'
     2154                     :
     2155              find first buf_ver_trn-doc no-lock where
     2156                         buf_ver_trn-doc.doc-code = ub.ord-chain.rel-doc-code no-error .
     2157              if available buf_ver_trn-doc then
     2158                 run str/del-doc.p
     2159                   ( input  parParentProc,
     2160                     input  buf_ver_trn-doc.doc-code,
     2161                     input  v-cntxt-db-num,
     2162                     input  "del-doc.err",
     2163                     input  ?,
     2164                     input  ?,
     2165                     input  v-cntxt-userid,
     2166                     input  buf_ver_trn-doc.doc-code,
     2167                     input  ?,
     2168                     output varchip-code ) .
     2169             find x_ord-doc-rcv  exclusive-lock where recid(x_ord-doc-rcv) = recid(buf_ver_ord-doc-rcv) no-error .
     2170             if available x_ord-doc-rcv then
     2171                delete x_ord-doc-rcv.
     2172           end.
     2173           end.
     2174   end.
     2175   if buf_ord-doc.status_ = 'запрос':U and buf_ord-doc.flag_ = false  then do:
     2176       if can-find(first X_ord-doc-rcv no-lock where X_ord-doc-rcv.doc-code = buf_ord-doc.doc-code ) = true
     2177         then glob-gen = true .
     2178       if  glob-gen = true  then do:
     2179               message "Закрываем заказ до статуса " + caps( 'запрос':U ) +  "+ ? " view-as alert-box question
     2180               buttons yes-no title "" update t-log-4 .
     2181               if t-log-4 = true then do:
     2182                 run cus/ordoocls.p (
     2183                     input parParentProc ,
     2184                     input recid(buf_ord-doc) ,
     2185                     input true )
     2186                      .
     2187               end.
     2188       end.
     2189   end.
     2190     end.
     2191   END PROCEDURE.
     2192   PROCEDURE make-rcv :
     2193    do
     2194    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2195    :
     2196   define input parameter p-cli-type as character no-undo .
     2197   define input parameter p-cli-code as integer no-undo .
     2198   define output parameter  r-rec as recid no-undo.
     2199   define variable l-recid as recid no-undo.
     2200   define variable v-root-node as integer no-undo .
     2201   define variable ks          as  integer no-undo .
     2202   define variable loc-rcv-num as  character no-undo .
     2203   define variable ii          as  integer no-undo .
     2204   define buffer   b-goods     for ub.goods .
     2205   define buffer   bfp-ord-doc for ub.ord-doc .
     2206   define buffer   buf2-ord-line-rcv for ub.ord-line-rcv.
     2207   define buffer   buf_gds-obj for ub.gds-obj.
     2208   define variable last-all-rcv as decimal no-undo .
     2209   define variable v-i-doc as character no-undo .
     2210   define buffer buf_ord-doc-rcv for  ub.ord-doc-rcv.
     2211   define buffer buf_ord-line for ub.ord-line.
     2212   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
     2213   define buffer buf_ord-dtl-rcv  for ub.ord-dtl-rcv.
     2214   ks = 0.
     2215   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2216   run proc-ord-code in this-procedure
     2217    (input   'main' ,
     2218     input   v-cntxt-db-num ,
     2219     input   v-cntxt-obj-type ,
     2220     input   v-cntxt-obj-code ,
     2221     input   v-i-doc ,
     2222     output  loc-rcv-num
     2223    ) .
     2224     find first bfp-ord-doc where    recid(bfp-ord-doc) = p-ord-doc-recid
     2225          no-lock no-error.
     2226          if error-status :error  then return.
     2227      loc-ord-num = bfp-ord-doc.doc-code.
     2228      if not( bfp-ord-doc.status_  = 'запрос':U and
     2229              bfp-ord-doc.flag_    = false  )
     2230      then do:
     2231           message "Нелязя делать ЗАПРОС по   Заказу в статусе " caps(bfp-ord-doc.status_) string(bfp-ord-doc.flag_,"+/-") " !"
     2232                    view-as alert-box information .
     2233           return.
     2234      end.
     2235   create buf_ord-doc-rcv.
     2236   buffer-copy bfp-ord-doc to buf_ord-doc-rcv
     2237      assign
     2238         buf_ord-doc-rcv.rcv-code  = loc-rcv-num
     2239         buf_ord-doc-rcv.doc-type  = 'запрос':U
     2240         buf_ord-doc-rcv.doc-date  = today
     2241         buf_ord-doc-rcv.status_   = 'новый':U
     2242         buf_ord-doc-rcv.cli-code = p-cli-code
     2243         buf_ord-doc-rcv.cli-type = p-cli-type
     2244      .
     2245    if
     2246    buf_ord-doc-rcv.cli-code = buf_ord-doc-rcv.obj-code and
     2247    buf_ord-doc-rcv.cli-type = buf_ord-doc-rcv.obj-type then do:
     2248           message "Неверно заданы контрагенты !"
     2249                    view-as alert-box information .
     2250           undo,return error.
     2251    end.
     2252      for each temp-rcv-line no-lock where
     2253          temp-rcv-line.cli-type = p-cli-type and
     2254          temp-rcv-line.cli-code = p-cli-code by temp-rcv-line.line-num :
     2255           ks = ks + 1 .
     2256   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2258     (input  temp-rcv-line.artic
     2259     ,input  temp-rcv-line.prod-type
     2260     ,input  temp-rcv-line.prod-code
     2261     ,output v-root-node
     2262     )  .
     2263            create buf_ord-line-rcv.
     2264            buffer-copy temp-rcv-line to buf_ord-line-rcv
     2265            assign
     2266              buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
     2267              buf_ord-line-rcv.line-num  = ks
     2268              buf_ord-line-rcv.cli-qnty  = buf_ord-line-rcv.qnty / buf_ord-line-rcv.cli-base-rate
     2269            .
     2270            create buf_ord-dtl-rcv.
     2271            buffer-copy buf_ord-line-rcv to buf_ord-dtl-rcv
     2272               assign
     2273                 buf_ord-dtl-rcv.node-code = v-root-node
     2274               .
     2275            l-recid = recid(buf_ord-line-rcv).
     2276   end.
     2277   if ks > 0 then do:
     2278       r-rec = recid(buf_ord-doc-rcv).
     2279       run cus/ord-trnz.p (parParentProc ,
     2280                       input r-rec ,
     2281                       input 'при':U,
     2282                       input "" ) no-error .
     2283       if error-status :error then do:
     2284         message vss-workfile vss-revision vss-description skip
     2285                "Ошибка ord-trnz.p " skip
     2286                 skip
     2287                 error-status :get-message(1) skip
     2288                 return-value skip
     2289                 view-as alert-box error
     2290         .
     2291         delete buf_ord-doc-rcv .
     2292         return error .
     2293       end.
     2294      end.
     2295    else do:
     2296      find first buf_ord-doc-rcv where buf_ord-doc-rcv.rcv-code  = loc-ord-num  exclusive-lock  .
     2297      delete buf_ord-doc-rcv .
     2298      r-rec = ?.
     2299   end.
     2300   rid-list = "" .
     2301   end.
     2302   END PROCEDURE.
