      366   def
      367   new shared
      368   temp-table  obj-list no-undo
      369     field obj-type like ub.clients.obj-type
      370     field obj-code like ub.clients.obj-code
      371     field obj-name like ub.clients.obj-name
      372     field obj-id   as integer
      373     field db-num   as integer
      374     index pi is primary unique obj-id
      375     index ie1 obj-type obj-code
      376     index ie2 obj-name
      377   .
      378   procedure create_obj-list :
      379      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      380      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      381      do
      382      on error undo, return error return-value
      383      :
      384         define buffer cli-obj for ub.clients .
      385         define variable p-var as integer no-undo .
      386         define buffer buf_obj-list for obj-list .
      387         find last buf_obj-list  use-index pi no-error .
      388         if available buf_obj-list
      389         then
      390            p-var = buf_obj-list.obj-id + 1.
      391         else
      392            p-var = 1.
      393         find first cli-obj where
      394                   cli-obj.obj-type = p-obj-type
      395               and cli-obj.obj-code = p-obj-code
      396         no-lock no-error.
      397         if available cli-obj
      398         then do:
      399            create buf_obj-list.
      400            assign
      401               buf_obj-list.obj-id   = p-var
      402               buf_obj-list.obj-code = cli-obj.obj-code
      403               buf_obj-list.obj-type = cli-obj.obj-type
      404               buf_obj-list.obj-name = cli-obj.obj-name
      405               buf_obj-list.db-num   = cli-obj.db-num
      406            .
      407         end.
      408      end.
      409   end.
