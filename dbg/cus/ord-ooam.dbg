     1852       (input  p-obj-type
     1853       ,input  p-obj-code
     1854       ,input  p-upper-code
     1855       ,input  p-code
     1856       ,input  p-value-character
     1857       ,input  p-value-date
     1858       ,input  p-value-decimal
     1859       ,input  p-value-integer
     1860       ,input  p-value-logical
     1861       ) no-error .
     1862     if error-status :error
     1863     then do:
     1864       undo, return error return-value .
     1865     end.
     1866   end.
     1867   end procedure.
     1868   procedure thbjattr_set-section :
     1869   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     1870   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1871   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
     1872   define input  parameter table-handle p-tth.
     1873   do
     1874   on error undo, return error return-value
     1875   :
     1876       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
     1877       (input  p-obj-type
     1878       ,input  p-obj-code
     1879       ,input  p-upper-code
     1880       ,input  table-handle p-tth
     1881       ) no-error .
     1882     if error-status :error
     1883     then do:
     1884       delete object p-tth.
     1885       undo, return error return-value .
     1886     end.
     1887     delete object p-tth.
     1888   end.
     1889   end procedure.
