      501               return.
      502             end.
      503             else do:
      504                   return.
      505               end.
      506         end.
      507       end.
      508    case buf_ord-doc.status_ :
      509         when 'отказ':U then do :
      510           if p-ask then
      511           Message
      512             "Нельзя закрыть заказ"
      513             "в статусе " caps(buf_ord-doc.status_)
      514             skip
