      431   define variable f-TBAGN  as logical   no-undo init false .
      432   define variable v-erase  as logical   no-undo .
      433   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      435     (input  v-cntxt-obj-type
      436     ,input  v-cntxt-obj-code
      437     ,output to-day
      438     )  .
      439    find first buf_ord-doc where recid (buf_ord-doc) = p-rec exclusive-lock no-error.
      440    assign
      441     old-state = buf_ord-doc.status_
      442     old-flag  = buf_ord-doc.flag_
      443     .
      444     if buf_ord-doc.ship-date = ? then do:
      445         if p-ask then
      446         Message "Не задана дата заказа ! "
      447         skip
      448         "Документ" buf_ord-doc.doc-code skip
      449         view-as alert-box error .
      450         return.
      451     end.
      452     define variable t-date  as date      no-undo .
      453     define variable t-time  as integer   no-undo .
      454     run cur-time in this-procedure ( output  t-date , output  t-time ).
      455     if buf_ord-doc.date-sale-1 > buf_ord-doc.date-sale-2 then do:
      456         if p-ask then
      457         Message "Не верно задан интервал продаж !  "
      458         skip
      459         "Документ" buf_ord-doc.doc-code skip
      460         view-as alert-box error .
      461         return.
      462     end.
      463     for each t-doc-line no-lock
      464        where t-doc-line.doc-code  = buf_ord-doc.doc-code
      465          and ( t-doc-line.qnty  =  0 or t-doc-line.qnty  = ?)
      466          :
      467             run creat-tt (t-doc-line.gds-code , substitute("В заказе есть строки с количеством равным 0 или ? ! Документ &1", buf_ord-doc.doc-code )) .
      468             v-erase = true.
      469     end.
      470     if v-erase then do:
      471         if p-ask then do:
      472           run view-exept-gds ( substitute("В заказе есть строки с количеством равным 0 или ? ! !&1Просмотреть список ?", chr(10))) .
      473           return.
      474         end.
      475         else do:
      476           return.
      477         end.
      478     end.
      479       if  buf_ord-doc.status_ = 'запрос':U and
      480           buf_ord-doc.status_ = 'новый':U then do:
      481         for each ub.ord-line no-lock where
      482                 ub.ord-line.doc-code = buf_ord-doc.doc-code :
      483   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
      485     (input  buf_ord-doc.doc-type
      486     ,input  ub.ord-line.gds-code
      487     ,input  buf_ord-doc.obj-type
      488     ,input  buf_ord-doc.obj-code
      489     ,input  false
      490     ,output v-Ok
      491     ,output v-mess
