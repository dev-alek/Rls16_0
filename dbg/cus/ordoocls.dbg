      521               for each ub.ord-line no-lock where
      522                       ub.ord-line.doc-code = buf_ord-doc.doc-code :
      523                   if (ub.ord-line.cli-qnty * ub.ord-line.cli-base-rate <> ub.ord-line.qnty) then do:
      524                     run creat-tt (ub.ord-line.gds-code ,
      525                         substitute (
      526                         " Документ &1, По товару неправильное соотношение количеств в единицах поставщика &2 &8 (коэфф.&3)  и в базовых единицах измерения &4 ! Товар &5 &6&7",
      527                         buf_ord-doc.doc-code ,
      528                         ub.ord-line.cli-qnty ,
      529                         ub.ord-line.cli-base-rate ,
      530                         ub.ord-line.qnty  ,
      531                         ub.ord-line.artic ,
      532                         ub.ord-line.prod-type ,
      533                         ub.ord-line.prod-code ,
      534                         ub.ord-line.unit-cli )) .
      535                     v-erase = true.
      536                   end.
      537               end.
      538               if v-erase then do:
      539                   if p-ask then do:
      540                     run view-exept-gds ( substitute("В заказе есть некорректные линии !&1Просмотреть список ?", chr(10))) .
      541                     return.
      542                   end.
      543                   else do:
      544                      return .
      545                   end.
      546               end.
      547                 if buf_ord-doc.ship-date < t-date then do:
      548                     g#log  = false .
      549                     if p-ask then
      550                         Message "Дата заказа меньше текущей даты ! " skip
      551                             string(buf_ord-doc.ship-date, "99/99/9999" ) skip
      552                             "Сегодня" string(t-date, "99/99/9999" )
      553                             skip
      554                             "Документ" buf_ord-doc.doc-code skip
      555                           " Будем закрывать ? "
      556                             view-as alert-box question
      557                             buttons yes-no
      558                             title "Закрыть заказ "
      559                             update g#log
      560                           .
      561                     if not g#log then return.
      562                  end.
      563                 find first  t-doc-line where t-doc-line.doc-code  = buf_ord-doc.doc-code no-lock no-error .
      564                 if not available t-doc-line then do:
      565                     if p-ask then
      566                     message   "Заказ"  buf_ord-doc.doc-code  "  не содержит ни одной записи ! "
      567                     view-as alert-box information
      568                     title "Внимание!!! "
      569                   .
      570                     return.
      571                  end.
      572                 for each t-doc-line no-lock
      573                    where t-doc-line.doc-code  = buf_ord-doc.doc-code
      574                    and ( t-doc-line.price-rubl <= 0 or t-doc-line.price-rubl = ? )
      575                    :
      576                       run creat-tt (t-doc-line.gds-code , substitute("В заказе &1 цена (руб) на товар &2 не определена ! ", buf_ord-doc.doc-code, t-doc-line.gds-code) ) .
      577                       v-erase = true.
      578                 end.
      579                 if v-erase then do:
      580                    if p-ask then do:
      581                       run view-exept-gds ( substitute("В заказе &2 есть товары с неопределенной ценой (руб) !&1Просмотреть список ?", chr(10), buf_ord-doc.doc-code)) .
      582                       return.
      583                    end.
      584                    else do:
      585                       return.
      586                    end.
      587                 end.
      588                 define variable v_ok as logical no-undo .
      589                 run verif_1 in this-procedure ( output v_ok ) no-error .
      590                 if not v_ok then do:
      591                     v-log = false .
      592                     if p-ask then
      593                     message "В "  (if buf_ord-doc.doc-type  =  'ОФ':U then " Заявке " else " Заказе" ) buf_ord-doc.doc-code " есть  повторный заказ на товары в пути ! Закрывать такой документ ? "
      594                       view-as alert-box question
      595                       buttons yes-no
      596                       title "Закрыть "  + (if buf_ord-doc.doc-type  =  'ОФ':U then " заявку " else "заказ" )
      597                       update v-log
      598                     .
      599                     if not v-log then return.
      600                 end.
      601             define buffer buf_clients for ub.clients .
      602             find first buf_clients no-lock where
      603                        buf_clients.obj-code = buf_ord-doc.obj-code and
      604                        buf_clients.obj-type = buf_ord-doc.obj-type no-error .
      605             if v-cntxt-db-num = 0 and
      606                buf_ord-doc.order-type = 3  and
      607                buf_clients.db-num = 0
      608             then do:
      609                     if p-ask then
      610                     message "В Заказе"  buf_ord-doc.doc-code
      611                     "Указано распределение по запросам в УБД. "
      612                     "После закрытия , Заказ будет направлен по СПН и "
      613                     "дальнейшее закрытие и распределение "
      614                     "становится невозможным в текущей БД ." skip
      615                     "Но объект принадлежит главной базе !!!  "
      616                     "Перенаправьте распределение в ГБД ."
      617                       view-as alert-box error
      618                       title "Закрыть заказ "
      619                     .
      620                     return.
      621             end.
      622             if v-cntxt-db-num = 0 and buf_ord-doc.order-type = 3 then do:
      623                     v-log = false .
      624                     if p-ask then
      625                     message "В Заказе"  buf_ord-doc.doc-code
      626                     "Указано распределение по запросам в УБД. "
      627                     "После закрытия , Заказ будет направлен по СПН и "
      628                     "дальнейшее закрытие и распределение "
      629                     "становится невозможным в текущей БД " skip
      630                     "Закрывать заказ ? "
      631                       view-as alert-box question
      632                       buttons yes-no
      633                       title "Закрыть заказ "
      634                       update v-log
      635                     .
      636                     if not v-log then return.
      637             end.
      638             if v-cntxt-db-num <> 0 and buf_ord-doc.order-type = 2 then do:
      639                     v-log = false .
      640                     if p-ask then
      641                     message "В Заказе"  buf_ord-doc.doc-code
      642                     "Указано распределение по запросам в ГБД. "
      643                     "После закрытия , Заказ будет направлен по СПН и "
      644                     "дальнейшее закрытие и распределение "
      645                     "становится невозможным в текущей БД " skip
      646                     "Закрывать заказ ? "
      647                       view-as alert-box question
      648                       buttons yes-no
      649                       title "Закрыть заказ "
      650                       update v-log
      651                     .
      652                     if not v-log then return.
      653             end.
      654             assign
      655                 buf_ord-doc.status_ = 'новый':U
      656                 buf_ord-doc.flag_ = true
      657                 .
      658                 return.
      659           end.
      660           if buf_ord-doc.flag_ = true  then do:
      661             if v-cntxt-db-num = 0  and buf_ord-doc.order-type = 3 or
      662                v-cntxt-db-num <> 0 and buf_ord-doc.order-type = 2
      663             then do:
      664                     if p-ask then
      665                     message "В Заказе"  buf_ord-doc.doc-code
      666                         "Указано распределение по запросам в "  entry ( buf_ord-doc.order-type , " ,ГБД,УБД")
      667                         "Нельзя перейти в следующий статус в текущей БД !"
      668                         view-as alert-box information
      669                         .
      670                     return .
      671             end.
      672             assign
      673                 buf_ord-doc.status_ = 'запрос':U
      674                 buf_ord-doc.flag_ = false
      675              .
      676           end.
      677          end.
      678          when 'запрос':U then do :
      679           if buf_ord-doc.flag_ = false   then do:
      680              if not can-find(first t-ord-doc-rcv no-lock where t-ord-doc-rcv.doc-code = buf_ord-doc.doc-code ) = true
      681              then do:
      682               if p-ask then
      683                 message "Закрыть до статуса ЗАПР+ нельзя ! Нет созданных запросов ." skip
      684                   skip
      685                   "Заказ " buf_ord-doc.doc-code skip
      686                   view-as alert-box error .
      687                 return.
      688              end.
      689               assign
      690                   buf_ord-doc.status_ = 'запрос':U
      691                   buf_ord-doc.flag_ = true
      692                   .
      693              run cus/ord-shoo.p
      694                 ( parParentProc ,
      695                   recid(buf_ord-doc) ,
      696                   output v-num-chip )
      697                   no-error .
      698              if error-status :error then
      699              message vss-workfile vss-revision vss-description skip
      700                     "Ошибка ord-shoo.p " skip
      701                      skip
      702                      error-status :get-message(1) skip
      703                      return-value skip
      704                      view-as alert-box error
      705              .
      706              buf_ord-doc.out-code = v-num-chip .
      707             return .
      708           end.
      709           if buf_ord-doc.flag_ = true  then do:
      710               for each t-ord-doc-rcv where  t-ord-doc-rcv.doc-code     = buf_ord-doc.doc-code no-lock :
      711               for each ub.ord-chain no-lock where
      712                         ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      713                         ub.ord-chain.doc-type = 'rcv'                  and
      714                         ub.ord-chain.rel-doc-type = 'trn'
      715                         :
      716                    for each t-trn-doc no-lock where
      717                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      718                             t-trn-doc.doc-type  = 'рас':U and
      719                             t-trn-doc.status_  <> 'факт':U  :
      720                     if p-ask then
      721                     message "Документ РН" t-trn-doc.doc-code " имеет статус " CAPS(t-trn-doc.status_)
      722                             "Закройте РН до статуса ФАКТ " view-as alert-box error
      723                             title "Закрыть заказ "
      724                             .
      725                     return.
      726                    end.
      727                    end.
      728               end.
      729            assign
      730              sum-ord = 0
      731              sum-rcv = 0
      732              sum-trn = 0
      733              sum-trn1 = 0
      734              f-TBAGN = false
      735             .
      736              for each t-doc-line     where t-doc-line.doc-code     = buf_ord-doc.doc-code  no-lock :
      737                  for each  t-doc-line-rcv where t-doc-line-rcv.doc-code = t-doc-line.doc-code and
      738                                            t-doc-line-rcv.artic      = t-doc-line.artic         and
      739                                            t-doc-line-rcv.prod-type  = t-doc-line.prod-type   and
      740                                            t-doc-line-rcv.prod-code  = t-doc-line.prod-code no-lock ,
      741                    first t-doc-rcv where t-doc-line-rcv.doc-code = t-doc-rcv.doc-code  and
      742                                          t-doc-line-rcv.rcv-code = t-doc-rcv.rcv-code  no-lock :
      743                   for each ub.ord-chain no-lock where
      744                             ub.ord-chain.doc-code = t-doc-rcv.rcv-code and
      745                             ub.ord-chain.doc-type = 'rcv'                  and
      746                             ub.ord-chain.rel-doc-type = 'trn'
      747                             :
      748                    find first t-trn-doc no-lock where
      749                               t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      750                               t-trn-doc.obj-type  = t-doc-rcv.obj-type and
      751                               t-trn-doc.obj-code  = t-doc-rcv.obj-code and
      752                               t-trn-doc.status_     = 'факт':U   and
      753                               ( t-trn-doc.doc-type  = 'рас':U or
      754                                 t-trn-doc.doc-type  = 'при':U) and
      755                                 t-trn-doc.internal  = true
      756                                 no-error .
      757                      if not available  t-trn-doc then next .
      758                      for each  t-trn-line where
      759                                t-trn-line.doc-code  = t-trn-doc.doc-code          and
      760                                t-trn-line.obj-code  = buf_ord-doc.obj-code        and
      761                                t-trn-line.obj-type  = buf_ord-doc.obj-type        and
      762                                t-trn-line.artic     = t-doc-line-rcv.artic        and
      763                                t-trn-line.prod-type = t-doc-line-rcv.prod-type    and
      764                                t-trn-line.prod-code = t-doc-line-rcv.prod-code    no-lock :
      765                         sum-trn = sum-trn + t-trn-line.fact-qnty.
      766                         sum-trn1 = sum-trn1 + t-trn-line.fact-qnty.
      767                      end.
      768                      end.
      769                     sum-rcv = sum-rcv + t-doc-line-rcv.qnty.
      770                   end.
      771                   sum-ord = sum-ord + t-doc-line.qnty.
      772                   if t-doc-line.qnty <>  sum-trn1 then  f-TBAGN = true .
      773                   sum-trn1 = 0 .
      774              end.
      775               if  sum-trn = 0  then do:
      776                     v-log = false .
      777                     if p-ask then
      778                       message  "Заказ "  buf_ord-doc.doc-code " не имеет внутренних РН/ПН !" skip
      779                       "Закрыть в статус (ФАКТ-) ? " skip
      780                         view-as alert-box question
      781                         buttons yes-no
      782                         title "Закрыть заказ"
      783                         update v-log
      784                       .
      785                   if not v-log then return.
      786                   buf_ord-doc.flag_ = false .
      787               end.
      788               if  sum-ord > sum-trn then do:
      789                     v-log = false .
      790                     if p-ask then
      791                   message  "Заказ "  buf_ord-doc.doc-code " не покрыт внутренними РН/ПН полностью !" skip
      792                     "Закрыть в статус (ФАКТ-) ? " skip
      793                     "Сумма заказа               " sum-ord skip
      794                     "Сумма накл. перемещения    " sum-trn
      795                     view-as alert-box question
      796                     buttons yes-no
      797                     title "Закрыть заказ"
      798                     update v-log
      799                   .
      800                   if not v-log then return.
      801                   buf_ord-doc.flag_ = false .
      802               end.
      803               if  sum-ord =  sum-trn  and f-TBAGN = false then do:
      804                   buf_ord-doc.flag_ = true  .
      805               end.
      806               if  sum-ord = sum-trn  and f-TBAGN = true then do:
      807                     v-log = false .
      808                     if p-ask then
      809                   message "На  Заказ"  buf_ord-doc.doc-code " расходится количество по заказу и накладной по строкам !" skip
      810                     "Закрыть в статус (ФАКТ-) ? " skip
      811                     view-as alert-box question
      812                     buttons yes-no
      813                     title "Закрыть заказ"
      814                     update v-log
      815                   .
      816                   if not v-log then return.
      817                   buf_ord-doc.flag_ = false  .
      818               end.
      819               if  sum-ord <  sum-trn then do:
      820                     v-log = false .
      821                     if p-ask then
      822                   message "На  Заказ"  buf_ord-doc.doc-code " превышено количество по РН/ПН !" skip
      823                     "Закрыть в статус (ФАКТ-) ? " skip
      824                     sum-ord skip
      825                     sum-trn
      826                     view-as alert-box question
      827                     buttons yes-no
      828                     title "Закрыть заказ"
      829                     update v-log
      830                   .
      831                   if not v-log then return.
      832                   buf_ord-doc.flag_ = false  .
      833               end.
      834               assign
      835                      buf_ord-doc.status_ = 'факт':U
      836                      buf_ord-doc.fact-date = to-day.
      837                 .
      838               for each t-ord-doc-rcv   exclusive-lock  where  t-ord-doc-rcv.doc-code     = buf_ord-doc.doc-code :
      839                   for each ub.ord-chain no-lock where
      840                             ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      841                             ub.ord-chain.doc-type = 'rcv'                  and
      842                             ub.ord-chain.rel-doc-type = 'trn'
      843                             :
      844                    for each t-trn-doc no-lock where
      845                             t-trn-doc.doc-code  = ub.ord-chain.rel-doc-code and
      846                             (t-trn-doc.doc-type  = 'рас':U or
      847                             t-trn-doc.doc-type  = 'при':U  )and
      848                             t-trn-doc.status_   = 'факт':U  :
      849                           assign
      850                                 t-ord-doc-rcv.status_   = 'факт':U
      851                                 t-ord-doc-rcv.fact-date = to-day.
      852                             .
      853                    end.
      854                    end.
      855               end.
      856          end.
      857         end.
      858    end case.
      859   procedure verif_1 :
      860   do
      861   on error undo, return error return-value
      862   :
      863   define output parameter v-ret as logical no-undo .
      864    v-ret = true .
      865   define buffer later-ord-doc  for  ub.ord-doc  .
      866   define buffer later-ord-line for  ub.ord-line .
      867   define buffer today-ord-line for  ub.ord-line .
      868   define variable v-qnty as decimal no-undo .
      869   define variable v-exis as logical no-undo .
      870   define variable v-txt as character no-undo .
      871   output stream errStream to value( string( session:temp-directory +
      872                                        "rpt" + string( g#report-num ) ) )
      873                                        page-size 62 .
      874   v-exis = false .
      875    for each  temp-obj-list : delete temp-obj-list . end.
      876   define variable str-pos as integer no-undo .
      877   define variable str-pos2 as integer no-undo .
      878   define variable str-1 as character no-undo .
      879   define variable i as integer no-undo .
      880   define variable e1 as character no-undo .
      881   define variable e2 as integer no-undo .
      882   define variable k1 as integer no-undo .
      883   if buf_ord-doc.doc-type = 'ФП':U then do:
      884       k1 = 0 .
      885       str-pos = index (  buf_ord-doc.e-method , "&" ) .
      886       str-pos2 = LENGTH ( buf_ord-doc.e-method ) - str-pos .
      887       str-1 = substring (buf_ord-doc.e-method , str-pos + 1 , str-pos2 ).
      888       define variable v-nn as integer   no-undo .
      889       v-nn = num-entries (str-1).
      890       do i = 1 to v-nn :
      891           assign
      892             e1 = entry(1, (entry( i , str-1, "," )) , " ")
      893             e2 = integer(entry(2, (entry( i , str-1, "," )), " " ))
      894             no-error .
      895             if error-status :error then next.
      896             k1 = k1 + 1.
      897             create temp-obj-list.
      898             assign
      899               temp-obj-list.obj-type = e1
      900               temp-obj-list.obj-code = e2
      901             .
      902       end .
      903       if k1 < 1 then do :
      904          run sss in this-procedure .
      905       end.
      906   end.
      907   else do:
      908      create temp-obj-list.
      909      assign
      910        temp-obj-list.obj-type = buf_ord-doc.obj-type
      911        temp-obj-list.obj-code = buf_ord-doc.obj-code
      912      .
      913   end.
      914   for each today-ord-line where today-ord-line.doc-code = buf_ord-doc.doc-code and today-ord-line.qnty > 0 no-lock :
      915         v-qnty = 0.
      916         v-txt  = "" .
      917           for each later-ord-line where
      918                                   later-ord-line.artic     = today-ord-line.artic     and
      919                                   later-ord-line.prod-type = today-ord-line.prod-type and
      920                                   later-ord-line.prod-code = today-ord-line.prod-code no-lock ,
      921               each  later-ord-doc where  later-ord-line.doc-code = later-ord-doc.doc-code and
      922                                 ( later-ord-doc.status_ = 'согласование':U or
      923                                   later-ord-doc.status_ = 'поставка':U or
      924                                   later-ord-doc.status_ = 'закрыто':U
      925                                   ) and
      926                                   later-ord-doc.doc-code <> today-ord-line.doc-code and
      927                                   ( if buf_ord-doc.cons-code <> "" then
      928                                      later-ord-doc.cons-code <> buf_ord-doc.cons-code
      929                                      else
      930                                      true = true )
      931                                    and
      932                                   later-ord-doc.date-sale-1 <= buf_ord-doc.date-sale-2  and
      933                                   later-ord-doc.date-sale-2 >= buf_ord-doc.date-sale-1   and
      934                                   later-ord-doc.host-code = buf_ord-doc.host-code   no-lock ,
      935                each temp-obj-list where temp-obj-list.obj-code = later-ord-doc.obj-code and
      936                                         temp-obj-list.obj-type = later-ord-doc.obj-type no-lock :
      937             v-qnty = v-qnty +  later-ord-line.qnty .
      938             v-txt  = v-txt  + trim( later-ord-line.doc-code) + ";" .
      939           end.
      940           if v-qnty > 0 then do:
      941             find first ub.goods where
      942                   today-ord-line.artic     = ub.goods.artic      and
      943                   today-ord-line.prod-type = ub.goods.prod-type  and
      944                   today-ord-line.prod-code = ub.goods.prod-code  no-lock no-error.
      945             Put  stream  errStream unformatted
      946             "По объекту :"  buf_ord-doc.obj-type buf_ord-doc.obj-code  skip
      947             "По товару :"  today-ord-line.artic       today-ord-line.prod-type       today-ord-line.prod-code skip
      948             ub.goods.gds-name skip
      949             "По документам :"    v-txt skip
      950             "Уже заказано (в пути) :" v-qnty    " "    ub.goods.unit-base   skip
      951             skip
      952             "По текущему документу № " buf_ord-doc.doc-code  " кол-во заказа : " today-ord-line.qnty " " ub.goods.unit-base skip
      953             "Анализируемый период продаж с " buf_ord-doc.date-sale-1 " по " buf_ord-doc.date-sale-2 skip
      954             "Итого :"  ( v-qnty  + today-ord-line.qnty )   skip
      955             "--------------------------------------------------------------------"
      956             skip.
      957             v-exis = true.
      958           end.
      959   end.
      960   if v-exis = true then do:
      961       define variable v-user-action   as character no-undo .
      962       define variable v-printed       as logical no-undo .
      963        if p-ask then do:
      964         message
      965          "При проверке товаров по периоду продаж были обнаружены повторы ! " skip
      966          "Вы можете просмотреть и распечатать их список . "
      967           skip
      968           "Документ" buf_ord-doc.doc-code skip
      969          view-as alert-box error .
      970      Output stream errStream   close .
      971       run gbl/prnfilen.w
      972         (input  "Повторы, обнаруженные при проверке товаров по периоду продаж"
      973         ,input  0
      974         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
      975         ,input  7
      976         ,output v-user-action
      977         ,output v-printed
      978         ) .
      979          if not ( lookup( ' экран':L, v-user-action ,";")  > 0 or
      980                   lookup( ' принтер':L, v-user-action ,";")  > 0  ) then do:
      981                      message "Внимание вы не просмотрели список повторных заказов ! "  .
      982                   end.
      983         v-ret = false .
      984         return.
      985   end.
      986   end.
      987   v-ret = true .
      988   return.
      989   end.
      990   end procedure.
      991   procedure sss :
      992     define variable v-object-available as logical   no-undo .
      993     define buffer buf_clients for ub.clients .
      994     do
      995     on error undo, return error return-value
      996     :
      997       for each buf_clients no-lock
      998         where buf_clients.host-code = v-cntxt-host-code-obj
      999           and ( ( buf_clients.db-num = v-cntxt-db-num ) or v-cntxt-db-num = 0 )
     1000       on error undo, return error return-value
     1001       :
     1002   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1003   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1004     (input  v-cntxt-db-num
     1005     ,input  0
     1006     ,input  v-cntxt-userid
     1007     ,input  buf_clients.obj-type
     1008     ,input  buf_clients.obj-code
     1009     ,output v-object-available
     1010     ) no-error .
     1011         if error-status :error
     1012         then do:
     1013           message
     1014             vss-workfile vss-revision vss-description skip
     1015             "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1016             error-status :get-message(1) skip
     1017             return-value skip
     1018             view-as alert-box error .
     1019           undo, return no-apply .
     1020         end.
     1021         if v-object-available = true
     1022         then do:
     1023           create temp-obj-list.
     1024           assign
     1025             temp-obj-list.obj-type = buf_clients.obj-type
     1026             temp-obj-list.obj-code = buf_clients.obj-code
     1027           .
     1028         end.
     1029       end.
     1030     end.
     1031   end procedure.
