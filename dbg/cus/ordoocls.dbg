      360   .
      361   procedure view-exept-gds :
      362   define input  parameter p-str as character no-undo .
      363   define variable loc-ok as logical   no-undo .
      364     do
      365     on error undo, return error return-value
      366     :
      367     message p-str
      368              view-as alert-box question
      369              buttons yes-no
      370              update loc-ok
      371               .
      372   if loc-ok then
      373       run gbl/tt-view.w
      374       ( input table  temp-err ).
      375     end.
      376   end procedure.
      377   procedure creat-tt :
      378     do
      379     on error undo, return error return-value
      380     :
      381       define input  parameter p-gds-code as integer   no-undo .
      382       define input  parameter p-str as character no-undo .
      383       find first temp-err where
      384                  temp-err.gds-code = p-gds-code no-error .
      385                  if available temp-err then return .
      386       if p-str  <> "" then do:
      387          create temp-err.
      388          assign
      389            temp-err.gds-code = p-gds-code
      390            temp-err.str = p-str
      391        .
      392       end.
      393     end.
      394   end procedure.
