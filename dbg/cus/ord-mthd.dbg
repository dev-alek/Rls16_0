     2887         :
     2888           assign
     2889             buf_temp-browse-handle.browse-handle :width
     2890               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2891             no-error .
     2892           if error-status :error
     2893           or error-status :get-message(1) <> ""
     2894           then do:
     2895             undo move_block, retry move_block .
     2896           end.
     2897         end.
     2898         for each buf_temp-diasize-handle
     2899         on error undo move_block, retry move_block
     2900         :
     2901           assign
     2902             v-object-handle = buf_temp-diasize-handle.handle-value
     2903           .
     2904           if v-object-handle <> v-diasize-resize-button
     2905           then do:
     2906             assign
     2907               v-object-handle :col = v-object-handle :col + p-change-value
     2908               no-error .
     2909             if error-status :error
     2910             or error-status :get-message(1) <> ""
     2911             then do:
     2912               undo move_block, retry move_block .
     2913             end.
     2914           end.
     2915         end.
     2916       end.
     2917       else do:
     2918         for each buf_temp-diasize-handle
     2919         on error undo move_block, retry move_block
     2920         :
     2921           assign
     2922             v-object-handle = buf_temp-diasize-handle.handle-value
     2923           .
     2924           if v-object-handle <> v-diasize-resize-button
     2925           then do:
     2926             assign
     2927               v-object-handle :col = v-object-handle :col + p-change-value
     2928               no-error .
     2929             if error-status :error
     2930             or error-status :get-message(1) <> ""
     2931             then do:
     2932               undo move_block, retry move_block .
     2933             end.
     2934           end.
     2935         end.
     2936         for each buf_temp-browse-handle
     2937           where buf_temp-browse-handle.browse-type = 'width':u
     2938         on error undo move_block, retry move_block
     2939         :
     2940           assign
     2941             buf_temp-browse-handle.browse-handle :width
     2942               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2943             no-error .
     2944           if error-status :error
     2945           or error-status :get-message(1) <> ""
     2946           then do:
     2947             undo move_block, retry move_block .
     2948           end.
     2949         end.
     2950         assign
     2951           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2952           no-error .
     2953         if error-status :error
     2954         or error-status :get-message(1) <> ""
     2955         then do:
     2956           undo move_block, retry move_block.
     2957         end.
     2958         assign
     2959           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2960         no-error .
     2961         if error-status :error
     2962         or error-status :get-message(1) <> ""
     2963         then do:
     2964           undo move_block, retry move_block.
     2965         end.
     2966         if frame Dialog-Frame :scrollable = true
     2967         then do:
     2968           assign
     2969             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2970           no-error .
     2971           if error-status :error
     2972           or error-status :get-message(1) <> ""
     2973           then do:
     2974             undo move_block, retry move_block.
     2975           end.
     2976         end.
     2977       end.
     2978       if p-move-resize
     2979       then do:
     2980         run diasize_position-resize-button in this-procedure .
     2981       end.
     2982       if v-diasize-wndstore = true
     2983       then do:
     2984         if connected("ub") = true
     2985         then do:
     2986           define variable v-cntxt-db-num        as integer   no-undo .
     2987           define variable v-cntxt-userid        as character no-undo .
     2988           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2989                                             , OUTPUT v-cntxt-userid
     2990                                             ) .
     2991           run gbl/wndsizew.p
     2992             (input  v-cntxt-db-num
     2993             ,input  v-cntxt-userid
     2994             ,input  v-diasize-proc-name
     2995             ,input  'width':u
     2996             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2997             ) .
     2998         end.
     2999       end.
     3000     end.
     3001     assign
     3002       v-diasize-change-size = false
     3003     .
     3004   end procedure.
     3005   procedure diasize_set-width :
     3006     define input  parameter p-new-width  as decimal   no-undo .
     3007     define input  parameter p-move-resize as logical   no-undo .
     3008     do
     3009     on error undo, return error return-value
     3010     :
     3011       run diasize_change-width in this-procedure
     3012         (input  (p-new-width - frame Dialog-Frame :width)
     3013         ,input  p-move-resize
     3014         ) .
     3015     end.
     3016   end procedure.
     3017   procedure diasize_position-resize-button :
     3018     do with frame Dialog-Frame
     3019     :
     3020       hide v-diasize-resize-button .
     3021       assign
     3022         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3023                     - 1
     3024                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3025         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3026                     - 1
     3027                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3028       .
     3029       view v-diasize-resize-button .
     3030     end.
     3031   end procedure.
     3032   on alt-right anywhere
     3033   do:
     3034     run diasize_change-width in this-procedure
     3035       (input 1
     3036       ,input true
     3037       ) .
     3038     return no-apply .
     3039   end.
     3040   on alt-left anywhere
     3041   do:
     3042     run diasize_change-width in this-procedure
     3043       (input -1
     3044       ,input true
     3045       ) .
     3046     return no-apply .
     3047   end.
     3048   on alt-down anywhere
     3049   do:
     3050     run diasize_change-height in this-procedure
     3051       (input 1
     3052       ,input true
     3053       ) .
     3054     return no-apply .
     3055   end.
     3056   on alt-up anywhere
     3057   do:
     3058     run diasize_change-height in this-procedure
     3059       (input -1
     3060       ,input true
     3061       ) .
     3062     return no-apply .
     3063   end.
     3064   on alt-enter of frame Dialog-Frame
     3065   do:
     3066     run diasize_maximize in this-procedure
     3067       (input  ?
     3068       ).
     3069     return no-apply .
     3070   end.
     3071   procedure diasize_end-move :
     3072     do
     3073     on error undo, return error return-value
     3074     :
     3075       define variable v-row-delta as decimal   no-undo .
     3076       define variable v-col-delta as decimal   no-undo .
     3077       define variable v-new-row as decimal   no-undo .
     3078       define variable v-new-col as decimal   no-undo .
     3079       assign
     3080         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3081         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3082       .
     3083       assign
     3084         v-row-delta = v-new-row - frame Dialog-Frame :height
     3085         v-col-delta = v-new-col - frame Dialog-Frame :width
     3086       .
     3087       run diasize_change-height in this-procedure
     3088         (input v-row-delta
     3089         ,input true
     3090         ) .
     3091       run diasize_change-width in this-procedure
     3092         (input v-col-delta
     3093         ,input true
     3094         ) .
     3095     end.
     3096   end procedure.
     3097   procedure diasize_maximize :
     3098     define input  parameter p-action as logical   no-undo .
     3099     do
     3100     on error undo, return error return-value
     3101     :
     3102       if p-action = ?
     3103       then do:
     3104         if v-diasize-need-maximize = true
     3105         then do:
     3106           assign
     3107             p-action = true
     3108           .
     3109         end.
     3110         else do:
     3111           assign
     3112             p-action = false
     3113           .
     3114         end.
     3115       end.
     3116       if p-action = true
     3117       then do:
     3118         run diasize_change-height in this-procedure
     3119           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3120               - frame Dialog-Frame :height-chars
     3121           ,input true
     3122           ) .
     3123         run diasize_change-width in this-procedure
     3124           (input session :width-chars
     3125               - frame Dialog-Frame :width-chars
     3126           ,input true
     3127           ) .
     3128         assign
     3129           v-diasize-need-maximize = false
     3130         .
     3131       end.
     3132       else do:
     3133         run diasize_change-width in this-procedure
     3134           (input v-diasize-orig-frame-width
     3135               - frame Dialog-Frame :width-chars
     3136           ,input true
     3137           ) .
     3138         run diasize_change-height in this-procedure
     3139           (input v-diasize-orig-frame-height
     3140               - frame Dialog-Frame :height-chars
     3141           ,input true
     3142           ) .
     3143         assign
     3144           v-diasize-need-maximize = true
     3145         .
     3146       end.
     3147     end.
     3148   end procedure.
     3149   procedure diasize_restore-orig-size :
     3150     do
     3151     on error undo, return error return-value
     3152     :
     3153       assign
     3154         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3155         v-diasize-current-frame-height = frame Dialog-Frame :height
     3156       .
     3157       run diasize_set-height in this-procedure
     3158         (input  v-diasize-orig-frame-height
     3159         ,input  true
     3160         ) .
     3161       run diasize_set-width in this-procedure
     3162         (input  v-diasize-orig-frame-width
     3163         ,input  true
     3164         ) .
     3165     end.
     3166   end procedure.
     3167   procedure diasize_restore-current-size :
     3168     do
     3169     on error undo, return error return-value
     3170     :
     3171       run diasize_set-height in this-procedure
     3172         (input  v-diasize-current-frame-height
     3173         ,input  true
     3174         ) .
     3175       run diasize_set-width in this-procedure
     3176         (input  v-diasize-current-frame-width
     3177         ,input  true
     3178         ) .
     3179     end.
     3180   end procedure.
     3181   procedure diasize_set-browse-handle :
     3182     define input  parameter p-browse-handle as handle   no-undo .
     3183     define buffer buf_temp-browse-handle for temp-browse-handle .
     3184     do
     3185     on error undo, return error return-value
     3186     :
     3187       assign
     3188         v-diasize-browse-handle = p-browse-handle
     3189       .
     3190       for each buf_temp-browse-handle
     3191       on error undo, return error return-value
     3192       :
     3193         delete buf_temp-browse-handle .
     3194       end.
     3195     end.
     3196   end procedure.
     3197   procedure diasize_add_browse :
     3198     define input  parameter p-browse-type   as character no-undo .
     3199     define input  parameter p-browse-handle as handle    no-undo .
     3200     define buffer buf_temp-browse-handle for temp-browse-handle .
     3201     do
     3202     on error undo, return error return-value
     3203     :
     3204       assign
     3205         v-diasize-browse-number = v-diasize-browse-number + 1
     3206       .
     3207       create buf_temp-browse-handle .
     3208       assign
     3209         buf_temp-browse-handle.browse-type   = p-browse-type
     3210         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3211         buf_temp-browse-handle.browse-handle = p-browse-handle
     3212       .
     3213     end.
     3214   end procedure.
     3215   procedure diasize_init :
     3216     define variable v-default-value    as logical   no-undo .
     3217     define variable v-restore-saved    as logical   no-undo .
     3218     define variable v-resize-value-str as character no-undo .
     3219     do
     3220     on error undo, return error return-value
     3221     :
     3222       do with frame Dialog-Frame
     3223       :
     3224         assign
     3225           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3226           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3227           v-diasize-browse-handle     = browse BROWSE-1 :handle
     3228         .
     3229         create button v-diasize-resize-button
     3230         assign
     3231           parent        = frame Dialog-Frame :first-child
     3232           label         = "s"
     3233           height-pixels = 16
     3234           width-pixels  = 16
     3235           visible       = true
     3236           sensitive     = true
     3237           movable       = true
     3238           triggers:
     3239             on end-move persistent run diasize_end-move in this-procedure .
     3240           end triggers.
     3241         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3242         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3243         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3244         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3245         assign
     3246           v-diasize-wndmax = false
     3247         .
     3248         if connected("ub") = true
     3249         then do:
     3250           define variable v-cntxt-db-num        as integer   no-undo .
     3251           define variable v-cntxt-userid        as character no-undo .
     3252           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3253                                             , OUTPUT v-cntxt-userid
     3254                                             ) .
     3255           run gbl/wndpar_r.p
     3256             (input  v-cntxt-db-num
     3257             ,input  v-cntxt-userid
     3258             ,input  'wndmax':U
     3259             ,output v-diasize-wndmax
     3260             ,output v-default-value
     3261             ) .
     3262         end.
     3263         assign
     3264           v-diasize-wndstore = false
     3265         .
     3266         if connected("ub") = true
     3267         then do:
     3268           run gbl/wndpar_r.p
     3269             (input  v-cntxt-db-num
     3270             ,input  v-cntxt-userid
     3271             ,input  'wndstore':U
     3272             ,output v-diasize-wndstore
     3273             ,output v-default-value
     3274             ) .
     3275         end.
     3276         assign
     3277           v-diasize-proc-name = entry(1, program-name(2), '.')
     3278         .
     3279         if v-diasize-wndstore = true
     3280         then do:
     3281           assign
     3282             v-restore-saved = false
     3283           .
     3284           if connected("ub") = true
     3285           then do:
     3286             run gbl/wndsizer.p
     3287               (input  v-cntxt-db-num
     3288               ,input  v-cntxt-userid
     3289               ,input  v-diasize-proc-name
     3290               ,input  'height':u
     3291               ,output v-resize-value-str
     3292               ) .
     3293             if v-resize-value-str <> '':U
     3294             then do:
     3295               run diasize_change-height in this-procedure
     3296                 (input  integer(v-resize-value-str)
     3297                 ,input  true
     3298                 ) .
     3299               assign
     3300                 v-restore-saved = true
     3301               .
     3302             end.
     3303           end.
     3304           if connected("ub") = true
     3305           then do:
     3306             run gbl/wndsizer.p
     3307               (input  v-cntxt-db-num
     3308               ,input  v-cntxt-userid
     3309               ,input  v-diasize-proc-name
     3310               ,input  'width':u
     3311               ,output v-resize-value-str
     3312               ) .
     3313             if v-resize-value-str <> '':U
     3314             then do:
     3315               run diasize_change-width in this-procedure
     3316                 (input  integer(v-resize-value-str)
     3317                 ,input  true
     3318                 ) .
     3319               assign
     3320                 v-restore-saved = true
     3321               .
     3322             end.
     3323           end.
     3324           if v-restore-saved <> true
     3325           then do:
     3326             if v-diasize-wndmax = true
     3327             then do:
     3328               run diasize_maximize in this-procedure
     3329                 (input  true
     3330                 ) .
     3331             end.
     3332           end.
     3333         end.
     3334         else do:
     3335           if v-diasize-wndmax = true
     3336           then do:
     3337             run diasize_maximize in this-procedure
     3338               (input  true
     3339               ) .
     3340           end.
     3341         end.
     3342       end.
     3343     end.
     3344   end procedure.
     3345   procedure diasize_need-full-display :
     3346     define output parameter p-need-full-display as logical   no-undo .
     3347     do
     3348     on error undo, return error return-value
     3349     :
     3350       assign
     3351         p-need-full-display = v-diasize-need-full-display
     3352       .
     3353       assign
     3354         v-diasize-need-full-display = false
     3355       .
     3356     end.
     3357   end procedure.
     3358   procedure get-context :
     3359      define output parameter p-db-num as integer          no-undo.
     3360      define output parameter p-user-id as character        no-undo.
     3361      define variable v-login               as character    no-undo.
     3362      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3363      define buffer buf_user-login  for ub.user-login .
     3364      do
     3365      on error undo, return error
     3366      :
     3367            FIND FIRST buf_sys-ctrl no-lock.
     3368            ASSIGN
     3369               v-login = USERID("ub")
     3370               p-db-num = buf_sys-ctrl.db-num
     3371            .
     3372            FIND FIRST buf_user-login
     3373                 WHERE buf_user-login.db-num = p-db-num
     3374                   AND buf_user-login.user-login = v-login
     3375                 no-lock
     3376                 no-error
     3377                 .
     3378            IF AVAILABLE buf_user-login
     3379            THEN DO:
     3380               assign
     3381                  p-user-id = buf_user-login.user-id
     3382               .
     3383            END.
     3384      end.
     3385   end procedure.
     3386       run diasize_init in this-procedure .
     3387   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3388   on ' ' of date-p-1 in frame Dialog-Frame
     3389   do:
     3390     if (can-query (self, "sensitive")
     3391        and
     3392        self :sensitive = true
     3393        )
     3394     or (can-query (self, "read-only")
     3395        and
     3396        self :read-only = false
     3397        )
     3398     then do:
     3399       assign
     3400         self :screen-value = ?
     3401       .
     3402     end.
     3403     return no-apply.
     3404   end.
     3405   on delete-character of date-p-1 in frame Dialog-Frame
     3406   do:
     3407     if (can-query (self, "sensitive")
     3408        and
     3409        self :sensitive = true
     3410        )
     3411     or (can-query (self, "read-only")
     3412        and
     3413        self :read-only = false
     3414        )
     3415     then do:
     3416       assign
     3417         self :screen-value = ?
     3418       .
     3419     end.
     3420     return no-apply.
     3421   end.
     3422   on ctrl-d of date-p-1 in frame Dialog-Frame
     3423   do:
     3424     define variable v-curr-sv-date as date no-undo .
     3425     if (can-query (self, "sensitive")
     3426        and
     3427        self :sensitive = true
     3428        )
     3429     or (can-query (self, "read-only")
     3430        and
     3431        self :read-only = false
     3432        )
     3433     then do:
     3434       if self :handle <> focus :handle
     3435       then do:
     3436         apply "entry":u to self .
     3437       end.
     3438       run gbl/getcurdt.p
     3439         (output v-curr-sv-date
     3440         ) .
     3441       assign
     3442         self :screen-value = string(v-curr-sv-date) .
     3443       .
     3444     end.
     3445     return no-apply.
     3446   end.
     3447   on ctrl-b of date-p-1 in frame Dialog-Frame
     3448   do:
     3449     if (can-query (self, "sensitive")
     3450        and
     3451        self :sensitive = true
     3452        )
     3453     or (can-query (self, "read-only")
     3454        and
     3455        self :read-only = false
     3456        )
     3457     then do:
     3458       if self :handle <> focus :handle
     3459       then do:
     3460         apply "entry":u to self .
     3461       end.
     3462       define variable v-curr-sv-date as date no-undo .
     3463       define variable v-new-sv-date  as date no-undo .
     3464       assign
     3465         v-curr-sv-date = date(self :screen-value) no-error
     3466       .
     3467       if v-curr-sv-date = ?
     3468       then do:
     3469         run gbl/getcurdt.p
     3470           (output v-curr-sv-date
     3471           ) .
     3472       end.
     3473       if v-curr-sv-date <> ?
     3474       then do:
     3475         assign
     3476           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3477         .
     3478         assign
     3479           self :screen-value = string(v-new-sv-date) .
     3480         .
     3481       end.
     3482     end.
     3483     return no-apply .
     3484   end.
     3485   on ctrl-e of date-p-1 in frame Dialog-Frame
     3486   do:
     3487     if (can-query (self, "sensitive")
     3488        and
     3489        self :sensitive = true
     3490        )
     3491     or (can-query (self, "read-only")
     3492        and
     3493        self :read-only = false
     3494        )
     3495     then do:
     3496       if self :handle <> focus :handle
     3497       then do:
     3498         apply "entry":u to self .
     3499       end.
     3500       define variable v-curr-sv-date as date no-undo .
     3501       define variable v-new-sv-date  as date no-undo .
     3502       assign
     3503         v-curr-sv-date = date(self :screen-value) no-error
     3504       .
     3505       if v-curr-sv-date = ?
     3506       then do:
     3507         run gbl/getcurdt.p
     3508           (output v-curr-sv-date
     3509           ) .
     3510       end.
     3511       if v-curr-sv-date <> ?
     3512       then do:
     3513         run gbl/lastdate.p
     3514           (input  v-curr-sv-date
     3515           ,output v-new-sv-date
     3516           ).
     3517         assign
