     1585   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586     run mainmenu_getcntxt in parparentproc
     1587       (output v-cntxt-db-num
     1588       ,output v-cntxt-userid
     1589       ,output v-cntxt-level
     1590       ,output v-cntxt-host-code-obj
