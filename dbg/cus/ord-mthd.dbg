     1861        FILL-IN-4 AT ROW 1.21 COL 32 NO-LABEL
     1862        t-1 AT ROW 10 COL 3.88 NO-LABEL
     1863        t-2 AT ROW 10 COL 7.75 NO-LABEL
     1864        t-3 AT ROW 10 COL 11.38 NO-LABEL
     1865        t-4 AT ROW 10 COL 15.13 NO-LABEL
     1866        t-5 AT ROW 10 COL 19 NO-LABEL
     1867        t-6 AT ROW 10 COL 23.13 NO-LABEL
     1868        t-7 AT ROW 10 COL 26.5 NO-LABEL
     1869        RECT-8 AT ROW 6.04 COL 1.5
     1870        RECT-11 AT ROW 7.38 COL 1.5
     1871        RECT-12 AT ROW 2.40 COL 31.75
     1872        SPACE(40.99) SKIP(1.15)
     1873       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1874            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1875            TITLE "Параметры расчета заказа"
     1876            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
     1877   ASSIGN
     1878          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1879          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1880   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1881   DO:
     1882     APPLY "END-ERROR":U TO SELF.
     1883   END.
     1884   ON CHOOSE OF B-1 IN FRAME Dialog-Frame
     1885   DO:
     1886     run p-calc in this-procedure (input-output t-1 ,input 1) .
     1887     display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1888   END.
     1889   ON CHOOSE OF B-10 IN FRAME Dialog-Frame
     1890   DO:
     1891      for each tt-date :
     1892            delete tt-date.
     1893      end.
     1894      assign
     1895       t-1 = false
     1896       t-2 = false
     1897       t-3 = false
     1898       t-4 = false
     1899       t-5 = false
     1900       t-6 = false
     1901       t-7 = false
     1902    .
     1903    display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1904     OPEN QUERY BROWSE-1 FOR EACH tt-date NO-LOCK.
     1905   END.
     1906   ON CHOOSE OF B-12 IN FRAME Dialog-Frame
     1907   OR MOUSE-SELECT-DBLCLICK OF BROWSE-1 in frame Dialog-Frame
     1908   DO:
     1909     find current tt-date no-error.
     1910     if error-status :error then return no-apply.
     1911     if available    tt-date then   delete tt-date.
     1912     OPEN QUERY BROWSE-1 FOR EACH tt-date NO-LOCK.
     1913   END.
     1914   ON CHOOSE OF B-2 IN FRAME Dialog-Frame
     1915   DO:
     1916       run p-calc in this-procedure (input-output t-2 ,input 2) .
     1917      display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1918   END.
     1919   ON CHOOSE OF B-3 IN FRAME Dialog-Frame
     1920   DO:
     1921       run p-calc in this-procedure (input-output t-3 ,input 3) .
     1922      display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1923   END.
     1924   ON CHOOSE OF B-4 IN FRAME Dialog-Frame
     1925   DO:
     1926       run p-calc in this-procedure ( input-output t-4 ,input 4) .
     1927      display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1928   END.
     1929   ON CHOOSE OF B-5 IN FRAME Dialog-Frame
     1930   DO:
     1931       run p-calc in this-procedure ( input-output t-5 ,input 5) .
     1932      display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1933   END.
     1934   ON CHOOSE OF B-6 IN FRAME Dialog-Frame
     1935   DO:
     1936       run p-calc in this-procedure ( input-output t-6 ,input 6) .
     1937      display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1938   END.
     1939   ON CHOOSE OF B-7 IN FRAME Dialog-Frame
     1940   DO:
     1941       run p-calc in this-procedure ( input-output t-7 , input 0) .
     1942      display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     1943   END.
     1944   ON CHOOSE OF B-8 IN FRAME Dialog-Frame
