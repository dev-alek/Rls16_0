     1197   function diff-list returns character (
     1198     input parfirst-list  as character,
     1199     input parsecond-list as character,
     1200     input pardelim       as character).
     1201     if pardelim = ""
     1202     or pardelim = ?
     1203     then do:
     1204       assign
     1205         pardelim = ","
     1206       .
     1207     end.
     1208     def var ind as integer no-undo .
     1209     def var v-elem as character no-undo .
     1210     def var v-result-list as character no-undo init "".
     1211     def var v-num-parfirst-list as integer no-undo .
     1212     assign
     1213       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1214     .
     1215     do ind = 1 to v-num-parfirst-list
     1216     :
     1217       assign
     1218         v-elem = entry(ind, parfirst-list, pardelim)
     1219       .
     1220       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1221         assign
     1222           v-result-list = v-result-list
     1223                         + (if v-result-list > "" then pardelim else "")
     1224                         + v-elem
     1225         .
     1226       end.
     1227     end.
     1228     return v-result-list .
     1229   end function.
     1230   function add-list returns character (
     1231    input parfirst-list  as character,
     1232    input parsecond-list as character,
     1233    input pardelim       as character).
     1234     if pardelim = ""
     1235     or pardelim = ?
     1236     then do:
     1237       assign
     1238         pardelim = ","
     1239       .
     1240     end.
     1241     def var ind as integer no-undo .
     1242     def var v-elem as character no-undo .
     1243     def var v-result-list as character no-undo init "".
     1244     def var v-num-parfirst-list as integer no-undo .
     1245     assign
     1246       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1247     .
     1248     do ind = 1 to v-num-parfirst-list
     1249     :
     1250       assign
     1251         v-elem = entry(ind, parfirst-list, pardelim)
     1252       .
     1253       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1254         assign
     1255           v-result-list = v-result-list
     1256                         + (if v-result-list > "" then pardelim else "")
     1257                         + v-elem
     1258         .
     1259       end.
     1260     end.
     1261     def var v-num-parsecond-list as integer no-undo .
     1262     assign
     1263       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1264     .
     1265     do ind = 1 to v-num-parsecond-list
     1266     :
     1267       assign
     1268         v-elem = entry(ind, parsecond-list, pardelim)
     1269       .
     1270       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1271         assign
     1272           v-result-list = v-result-list
     1273                         + (if v-result-list > "" then pardelim else "")
     1274                         + v-elem
     1275         .
     1276       end.
     1277     end.
     1278     return v-result-list .
     1279   end function.
     1280   function cross-list returns character (
     1281    input parfirst-list  as character,
     1282    input parsecond-list as character,
     1283    input pardelim       as character).
     1284     if pardelim = ""
     1285     or pardelim = ?
     1286     then do:
     1287       assign
     1288         pardelim = ","
     1289       .
     1290     end.
     1291     def var ind as integer no-undo .
     1292     def var v-elem as character no-undo .
     1293     def var v-result-list as character no-undo init "".
     1294     def var v-num-parfirst-list as integer no-undo .
     1295     assign
     1296       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1297     .
     1298     do ind = 1 to v-num-parfirst-list
     1299     :
     1300       assign
     1301         v-elem = entry(ind, parfirst-list, pardelim)
     1302       .
     1303       if lookup(v-elem, v-result-list, pardelim) = 0
     1304       and lookup(v-elem, parsecond-list, pardelim) > 0
     1305       then do:
     1306         assign
     1307           v-result-list = v-result-list
     1308                         + (if v-result-list > "" then pardelim else "")
     1309                         + v-elem
     1310         .
     1311       end.
     1312     end.
     1313     return v-result-list .
     1314   end function.
     1315   function radio-label returns character (
     1316    input par-rs-value  as character,
     1317    input par-rs-radio-buttons as character)
     1318    .
     1319    DEFINE variable v-result-label as character no-undo.
     1320    assign
     1321    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1322                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1323                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1324                             ), par-rs-radio-buttons
     1325                           )
     1326    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1327    .
     1328   return v-result-label.
     1329   end function.
     1330   function m-radio-label returns character (
     1331    input par-rs-value  as character,
     1332    input par-rs-radio-buttons as character,
     1333    input par-delim as character
     1334    )
     1335    .
     1336    DEFINE variable v-result-label as character no-undo.
     1337    assign
     1338    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1339                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1340                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1341                             ), par-rs-radio-buttons, par-delim
     1342                           )
     1343    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1344    .
     1345   return v-result-label.
     1346   end function.
     1347   FUNCTION mixlist returns character
     1348   (
     1349    input parfirst-list  as character
     1350    ,input parsecond-list as character
     1351    ,input pardelim       as character
     1352    ,input pardelim-result as character ) :
     1353     if pardelim = ""
     1354     or pardelim = ?
     1355     then do:
     1356       assign
     1357         pardelim = ","
     1358       .
     1359     end.
     1360     def var ind as integer no-undo .
     1361     def var v-elem1 as character no-undo .
     1362     def var v-elem2 as character no-undo .
     1363     def var v-result-list as character no-undo init "".
     1364     do ind = 1 to num-entries(parfirst-list, pardelim)
     1365     :
     1366       assign
     1367         v-elem1 = entry(ind, parfirst-list, pardelim)
     1368         v-elem2 = entry(ind, parsecond-list, pardelim)
     1369       .
     1370         assign
     1371           v-result-list = v-result-list
     1372                         + (if v-result-list > "" then pardelim-result else "")
     1373                         + v-elem1 + pardelim-result + v-elem2
     1374         .
     1375     end.
     1376     return v-result-list .
     1377   END FUNCTION.
