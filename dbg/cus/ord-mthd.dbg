     2099   ON VALUE-CHANGED OF t-sppv IN FRAME Dialog-Frame
     2100   DO:   assign frame Dialog-Frame   t-sppv .   display t-sppv  with FRAME Dialog-Frame  .  END.
     2101   ON VALUE-CHANGED OF t-sppv-2 IN FRAME Dialog-Frame
     2102   DO:   assign frame Dialog-Frame   t-sppv-2 .   display t-sppv-2  with FRAME Dialog-Frame  .  END.
     2103   ON VALUE-CHANGED OF t-sppv-3 IN FRAME Dialog-Frame
     2104   DO:   assign frame Dialog-Frame   t-sppv-3 .   display t-sppv-3  with FRAME Dialog-Frame  .  END.
     2105   ON VALUE-CHANGED OF t-sppv-4 IN FRAME Dialog-Frame
     2106   DO:   assign frame Dialog-Frame   t-sppv-4 .   display t-sppv-4  with FRAME Dialog-Frame  .  END.
     2107   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2108   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2109   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2110   on help of frame Dialog-Frame
     2111   do:
     2112     run gbl/app_help.p
     2113       (input this-procedure :file-name
     2114       ,input ''
     2115       ,input ?
     2116       ) no-error.
     2117     if error-status :error then do:
     2118       message
     2119         "Ошибка при вызове помощи"
     2120         error-status :get-message(1)
     2121         view-as alert-box .
     2122     end.
     2123   end.
     2124   run minbtn-set in this-procedure .
     2125   on choose of b-help in frame Dialog-Frame
     2126   do:
     2127     apply "help":u to frame Dialog-Frame .
     2128   end.
     2129   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2130   procedure minbtn-set :
     2131       do
     2132           on error undo, return error return-value
     2133           :
     2134           define variable ii              as integer       no-undo .
     2135           define variable fh              as widget-handle no-undo .
     2136           define variable hh              as widget-handle no-undo .
     2137           define variable v-h             as handle        extent 4 no-undo .
     2138           define variable v-name-button   as character     no-undo .
     2139           define variable v-help-old-x    as decimal       no-undo .
     2140           define variable v-help-old-y    as decimal       no-undo .
     2141           define variable v-help-old-size as decimal       no-undo .
     2142           define variable v-frame-width   as decimal       no-undo .
     2143           define variable jj              as integer       no-undo .
     2144           do
     2145               on error undo, return error
     2146               :
     2147               assign
     2148                   v-frame-width = frame Dialog-Frame:width - 0.3
     2149                   fh            = frame Dialog-Frame:first-child
     2150                   hh            = fh:first-child
     2151                   ii            = 1
     2152                   .
     2153               do while valid-handle(hh):
     2154                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2155                   do:
     2156                       case lc(hh:name) :
     2157                           when "b-help" then
     2158                               do:
     2159                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2160                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2161                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2162                                   hh:TOOLTIP = "Помощь" .
     2163                                   v-help-old-x = hh:column .
     2164                                   v-help-old-y = hh:row    .
     2165                                   v-help-old-size = hh:width .
     2166                                   hh:width-chars = 2.5 .
     2167                               end.
     2168                           when "b-print" then
     2169                               do:
     2170                                   hh:load-image("cmp/b-print.bmp":u) .
     2171                                   hh:TOOLTIP = "Печать" .
     2172                                   v-h[ii] = hh:handle .
     2173                                   ii = ii + 1 .
     2174                                   hh:width-chars = 3 .
     2175                               end.
     2176                           when "b-history" or
     2177                           when "b-hist" then
     2178                               do:
     2179                                   hh:load-image("cmp/b-hist.bmp":u) .
     2180                                   hh:TOOLTIP = "История" .
     2181                                   v-h[ii] = hh:handle .
     2182                                   ii = ii + 1 .
     2183                                   hh:width-chars = 3 .
     2184                               end.
     2185                           when "b-sch" then
     2186                               do:
     2187                                   hh:load-image("cmp/b-sch.bmp":u) .
     2188                                   hh:TOOLTIP = "Установка Фильтра" .
     2189                                   v-h[ii] = hh:handle .
     2190                                   ii = ii + 1 .
     2191                                   hh:width-chars = 3 .
     2192                               end.
     2193                           when "b-hist-user" then
     2194                               do:
     2195                                   hh:load-image("cmp/b-hist.bmp":u) .
     2196                                   hh:TOOLTIP = "История пользователя" .
     2197                                   ii = ii + 1 .
     2198                               end.
     2199                       end case.
     2200                   end.
     2201                   hh = hh:next-sibling.
     2202               end.
     2203               b-help:column = v-frame-width - b-help:width-chars.
     2204               jj = 0.
     2205               repeat ii = 4 to 1 by -1 :
     2206                   if valid-handle (v-h[ii] ) then
     2207                   do:
     2208                       jj  = jj + 1 .
     2209                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2210                       v-h[ii]:row    = v-help-old-y .
     2211                   end.
     2212               end.
     2213           end.
     2214       end.
     2215   end procedure.
     2216   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2217   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2218   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2219   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2220   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2221   define variable v-diasize-current-frame-height as decimal   no-undo .
     2222   define variable v-diasize-change-size          as logical   no-undo .
     2223   define variable v-diasize-resize-button        as handle    no-undo .
     2224   define variable v-diasize-wndmax               as logical   no-undo .
     2225   define variable v-diasize-wndstore             as logical   no-undo .
     2226   define variable v-diasize-proc-name            as character no-undo .
     2227   define variable v-diasize-browse-handle        as handle    no-undo .
     2228   define variable v-diasize-browse-number        as integer   no-undo .
     2229   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2230   define temp-table temp-diasize-handle no-undo
     2231     field handle-value  as handle
     2232     field save-position as decimal
     2233     index xpk is primary unique handle-value
     2234     .
     2235   define temp-table temp-browse-handle no-undo
     2236     field browse-type   as character
     2237     field browse-number as integer
     2238     field browse-handle as handle
     2239     field original-size as decimal
     2240     index xpk is primary unique browse-type browse-number
     2241     index xie browse-type browse-handle
     2242   .
     2243   procedure diasize_change-height :
     2244     define input  parameter p-change-value  as decimal   no-undo .
     2245     define input  parameter p-move-resize   as logical   no-undo .
     2246     define variable v-field-group-handle    as handle    no-undo .
     2247     define variable v-object-handle         as handle    no-undo .
     2248     define variable v-frame-height          as decimal   no-undo .
     2249     define variable v-frame-virtual-height  as decimal   no-undo .
     2250     define variable v-browse-height         as decimal   no-undo .
     2251     define variable v-window-height         as decimal   no-undo .
     2252     define variable v-window-virtual-height as decimal   no-undo .
     2253     define variable v-change-sign           as integer   no-undo .
     2254     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2255     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2256     if p-change-value > 0
     2257     then do:
     2258       if frame Dialog-Frame :height + p-change-value
     2259           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2260       then do:
     2261         assign
     2262           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2263                           - (frame Dialog-Frame :height-chars)
     2264         .
     2265         if p-change-value <= 0
     2266         then do:
     2267           run diasize_position-resize-button in this-procedure .
