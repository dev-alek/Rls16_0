     3833   MAIN-BLOCK:
     3834   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3835      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3836     run enable_ui in this-procedure .
     3837     hide b-12 in frame Dialog-Frame .
     3838     pay-day = date-sale-2 - date-sale-1 + 1 .
     3839     frame Dialog-Frame:title = "Параметры расчета темпов продаж на объектах для формирования поставок ".
     3840     SelectObject = SelectObject:screen-value in frame Dialog-Frame .
     3841     run select-objects-proc in this-procedure ( e-method ).
     3842     run v-c-alg in this-procedure .
     3843     run v-c-way in this-procedure .
     3844     hide t-way in frame Dialog-Frame .
     3845     WAIT-FOR GO OF FRAME Dialog-Frame.
     3846   END.
     3847   run disable_ui in this-procedure .
     3848   PROCEDURE disable_UI :
     3849     HIDE FRAME Dialog-Frame.
     3850   END PROCEDURE.
     3851   PROCEDURE enable_UI :
     3852     OPEN QUERY Dialog-Frame FOR EACH ub.tmp-sale SHARE-LOCK.
     3853     GET FIRST Dialog-Frame.
     3854     reposition Dialog-Frame to recid rr no-error  .
     3855     find first ub.tmp-sale where rr = recid( ub.tmp-sale) no-lock no-error .
     3856     DISPLAY  R-algoritm t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp
     3857             t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1
     3858             FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 t-way t-clos t-rcv
     3859         WITH FRAME Dialog-Frame.
     3860        if g#type = 'ФП':U then display   FILL-IN-4 SelectObject  br-obj-list  BUTTON-obj
     3861           WITH FRAME Dialog-Frame.
     3862     IF AVAILABLE ub.tmp-sale THEN
     3863       DISPLAY ub.tmp-sale.tmp-code ub.tmp-sale.desc_
     3864         WITH FRAME Dialog-Frame.
     3865     ENABLE RECT-8 RECT-11  R-algoritm t-rv date-p-1 date-p-2 t-rvz
     3866            t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 B-Help Btn_OK
     3867            Btn_Cancel FILL-IN-1 FILL-IN-3 t-way t-clos t-rcv
     3868         WITH FRAME Dialog-Frame.
     3869     if g#type = 'ФП':U then ENABLE SelectObject  br-obj-list  BUTTON-obj WITH FRAME Dialog-Frame.
     3870                        else   hide  SelectObject  br-obj-list rect-12  BUTTON-obj in frame Dialog-Frame .
     3871     VIEW FRAME Dialog-Frame.
     3872     OPEN QUERY BR-obj-list FOR EACH obj-list  NO-LOCK.    OPEN QUERY BROWSE-1 FOR EACH tt-date NO-LOCK.
     3873     hide t-sppv-2  in frame Dialog-Frame .
     3874   END PROCEDURE.
     3875   PROCEDURE Loc-init :
     3876   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3877   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3878   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3879     (input  store-type
     3880     ,input  store-code
     3881     ,output to-day
     3882     )  .
     3883   define variable i as integer no-undo .
     3884   define buffer buf-fp_ord-doc for ub.ord-doc.
     3885   find first  buf-fp_ord-doc where recid ( buf-fp_ord-doc ) = v-mode-recid no-lock no-error .
     3886   find first ubflt.usr-flt  no-lock where
     3887            ubflt.usr-flt.user-name = buf-fp_ord-doc.doc-code and
     3888            ubflt.usr-flt.call-point   = "ord-m":U    no-error .
     3889   if avail ubflt.usr-flt  then do:
     3890     run init-screen in this-procedure ( ubflt.usr-flt.list_ ) .
     3891   end.
     3892   else do:
     3893       assign
     3894           date-p-1  = to-day - 30
     3895           date-p-2  = to-day
     3896           t-rv   = true
     3897           t-rvz  = true
     3898           t-rvc  = true
     3899           t-rvzc = true
     3900           r-algoritm = 1
     3901       .
     3902       find first ub.tmp-sale no-lock no-error .
     3903       if error-status :error then do:
     3904             create  ub.tmp-sale.
     3905             assign  ub.tmp-sale.tmp-code = "1"
     3906                     ub.tmp-sale.desc_    = "Пустой"
     3907                     .
     3908       end.
     3909       find current ub.tmp-sale no-lock no-error .
     3910       if available ub.tmp-sale then
     3911           display  ub.tmp-sale.tmp-code
     3912                     ub.tmp-sale.desc_   with frame Dialog-Frame .
     3913   end.
     3914    rr = recid(ub.tmp-sale) .
     3915    display R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     3916    run v-c-alg in this-procedure .
     3917   END PROCEDURE.
     3918   procedure v-c-alg :
     3919    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     3920     assign frame   Dialog-Frame   r-algoritm.
     3921     case  r-algoritm:
     3922     when 1 or when 4 then do:
     3923            enable date-p-1 date-p-2
     3924           t-rv  t-rvz t-rvc t-rvzc t-sp t-sppv
     3925           t-sppv-2 t-sppv-3 t-sppv-4
     3926            with frame Dialog-Frame .
     3927            disable RECT-11 BROWSE-1 B-1 B-2 B-3 B-4 B-5 B-6 B-7 B-8  B-10 B-12 t-1 t-2 t-3 t-4 t-5 t-6 t-7 RECT-8 ub.tmp-sale.tmp-code ub.tmp-sale.desc_ B-spis  with frame Dialog-Frame .
     3928            BROWSE-1:bgcolor  in frame Dialog-Frame  = 8 .
     3929     end.
     3930     when 2 then do:
     3931           enable  RECT-8 ub.tmp-sale.tmp-code ub.tmp-sale.desc_ B-spis with frame Dialog-Frame .
     3932           disable  date-p-1 date-p-2 RECT-11 BROWSE-1 B-1 B-2 B-3 B-4 B-5 B-6 B-7 B-8  B-10 B-12 t-1 t-2 t-3 t-4 t-5 t-6 t-7
     3933           t-rv  t-rvz t-rvc t-rvzc t-sp t-sppv
     3934           t-sppv-2 t-sppv-3 t-sppv-4
     3935           with frame Dialog-Frame .
     3936           BROWSE-1:bgcolor  in frame Dialog-Frame  = 8 .
     3937     end.
     3938     when 3 then do:
     3939           enable   date-p-1 date-p-2 RECT-11 BROWSE-1 B-1 B-2 B-3 B-4 B-5 B-6 B-7 B-8  B-10 B-12 t-1 t-2 t-3 t-4 t-5 t-6 t-7
     3940           t-rv  t-rvz t-rvc t-rvzc t-sp t-sppv
     3941           t-sppv-2 t-sppv-3 t-sppv-4
     3942             with frame Dialog-Frame .
     3943           disable  RECT-8 ub.tmp-sale.tmp-code ub.tmp-sale.desc_ B-spis with frame Dialog-Frame .
     3944           BROWSE-1:bgcolor  in frame Dialog-Frame  = ? .
     3945      end.
     3946      otherwise do:
     3947      end.
     3948     end case.
     3949    display  RECT-11 BROWSE-1 B-1 B-2 B-3 B-4 B-5 B-6 B-7 B-8  B-10 B-12 t-1 t-2 t-3 t-4 t-5 t-6 t-7 RECT-8 ub.tmp-sale.tmp-code ub.tmp-sale.desc_ B-spis date-p-1 date-p-2 with frame Dialog-Frame .
     3950    hide t-sppv-2 in frame Dialog-Frame .
     3951    end.
     3952   end procedure.
     3953   PROCEDURE p-calc :
     3954   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     3955   define input-output parameter n-day as logical no-undo .
     3956   define input parameter n-i as integer no-undo .
     3957   define variable p-modulo as integer no-undo .
     3958   define variable t-i as date no-undo.
     3959   assign frame Dialog-Frame
     3960      date-p-1 date-p-2.
     3961     if date-p-1 = ? or  date-p-2 = ? then
     3962     apply "entry " to date-p-1 .
     3963   if date-p-1 <> ? and  date-p-2 <> ? then do:
     3964     if n-day = true then do:
     3965           n-day = false.
     3966            repeat t-i = date-p-1 To date-p-2 :
     3967            p-modulo = if (integer(t-i) MODULO 7 ) = 0 then 7 else (integer(t-i) MODULO 7 ).
     3968               if p-modulo = n-i then do:
     3969                    find first tt-date where  tt-date.exch-date =  t-i no-error.
     3970                       if available  tt-date then delete tt-date.
     3971               end.
     3972            end.
     3973     end.
     3974     else do:
     3975           n-day = true.
     3976            repeat t-i = date-p-1 To date-p-2 :
     3977            p-modulo = if (integer(t-i) MODULO 7 ) = 0 then 7 else (integer(t-i) MODULO 7 ).
     3978               if p-modulo = n-i then do:
     3979                   if not can-find ( first tt-date where tt-date.exch-date =  t-i ) then do:
     3980                       create tt-date.
     3981                       assign tt-date.exch-date =  t-i.
     3982                       end.
     3983               end.
     3984            end.
     3985     end.
     3986      OPEN QUERY BROWSE-1 FOR EACH tt-date NO-LOCK.
     3987     end.
     3988    end.
     3989   end procedure.
     3990   PROCEDURE select-objects-proc :
     3991    do
     3992    on error undo, return error return-value
     3993    :
     3994   define input parameter p-m as character no-undo .
     3995   define variable n-vv as integer   no-undo .
     3996   define variable v-all-object as logical   no-undo .
     3997   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3998   for each obj-list :
     3999    delete obj-list.
     4000   end.
     4001   str-obj#  = "" .
     4002   str-obj2# = "" .
     4003   str-obj3# = "" .
     4004   case selectobject :
     4005   when "currency":U then do:
     4006    run verify-check.
     4007   end.
     4008   when 'все':U then   do:
     4009    run sss.
     4010   end.
     4011   when "all" then   do:
     4012    run sss.
     4013   end.
     4014   when "firm":U then   do:
     4015    run sss.
     4016   end.
     4017   when "choice":U then do:
     4018     for each obj-list :
     4019         delete obj-list.
     4020     end.
     4021     define variable v-object-exist as logical   no-undo .
     4022   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4023   run userobjs_object-exist in this-procedure
     4024     (output v-object-exist
     4025     )  .
     4026     if not params-only and v-object-exist = false then do:
     4027   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4028   run userobjs_append in this-procedure
     4029     (input  v-cntxt-obj-type
     4030     ,input  v-cntxt-obj-code
     4031     )  .
     4032        v-object-exist = true .
     4033     end.
     4034     if my-request     = false
     4035     or v-object-exist = false
     4036     then do:
     4037       define variable v-user-select as logical   no-undo .
     4038       define variable v-recids as character no-undo .
     4039       if params-only then do:
     4040       run ref/thobjs.w
     4041           ( input my-handle
     4042           , input this-procedure:handle
     4043           , input (if params-only-mode = 'ПРОСМОТР':U then "b-mark-hidden" else "b-mark,b-sel")
     4044           , input 'все':U
     4045           , input ''
     4046           , input ?
     4047           , input ?
     4048           , input-output v-recids ) no-error .
     4049        end.
     4050        else do:
     4051   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4052   run userobjs_select-many in this-procedure
     4053     (input  my-handle
     4054     ,input  v-cntxt-db-num
     4055     ,input  v-cntxt-userid
     4056     ,input  v-cntxt-host-code-obj
     4057     ,input  v-cntxt-obj-type
     4058     ,input  v-cntxt-obj-code
     4059     ,output v-user-select
     4060     )  .
     4061        end.
     4062     end.
     4063     my-request = true .
     4064   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4065   run userobjs_object-exist in this-procedure
     4066     (output v-object-exist
     4067     )  .
     4068     if v-object-exist = false
     4069     then do:
     4070       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u then do:
     4071         assign selectobject = "firm":U .
     4072       end.
     4073       else do:
     4074         assign selectobject =  "currency":u .
     4075       end.
     4076       display selectobject with frame Dialog-Frame .
     4077       disable button-obj   with frame Dialog-Frame .
     4078       find cli-obj where cli-obj.obj-type = v-cntxt-obj-type and
     4079                           cli-obj.obj-code = v-cntxt-obj-code no-lock .
     4080       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u
     4081       then do:
     4082         run sss.
     4083       end.
     4084       else do:
     4085         run verify-check.
     4086       end.
     4087     end.
     4088     else do:
     4089         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4090         define buffer buf_clients for ub.clients .
     4091         define buffer buf_db for ub.db .
     4092         define buffer buf_shop for ub.shop .
     4093         define buffer buf_store for ub.store .
     4094         define buffer buf_sysconf for ub.sysconf .
     4095         for each buf_userobjs_temp-user-obj
     4096         :
     4097           find first buf_clients no-lock
     4098             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     4099               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     4100             .
     4101             if verify-send-check  and buf_clients.db-num <> v-cntxt-db-num  and v-all-object = false then do:
     4102                   find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     4103                   if buf_db.send-check = false then do:
     4104                     str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     4105                     next.
     4106                   end.
     4107             end.
     4108             if temp-param-obj-type = 'shop':u and v-all-object = false then do:
     4109                 if buf_userobjs_temp-user-obj.obj-type = 'скл':U then do:
     4110                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     4111                     next.
     4112                   end.
     4113             end.
     4114             if temp-param-obj-type = 'stock':u and v-all-object = false then do:
     4115                 if buf_userobjs_temp-user-obj.obj-type = 'маг':U then do:
     4116                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     4117                     next.
     4118                 end.
     4119             end.
     4120             case buf_userobjs_temp-user-obj.obj-type:
     4121                 when 'скл':U then
     4122                     do:
     4123                         find buf_store where buf_store.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     4124                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
     4125                         find first buf_clients no-lock where
     4126                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     4127                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     4128                             .
     4129                         if buf_sysconf.base-code = base-code or v-all-object = true
     4130                             then do:
     4131   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4132   run create_obj-list in this-procedure
     4133    ( input buf_userobjs_temp-user-obj.obj-type ,
     4134      input buf_userobjs_temp-user-obj.obj-code )
     4135      .
     4136                             end.
     4137                             else do:
     4138                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     4139                             end.
     4140                     end.
     4141                 when 'маг':U then
     4142                     do:
     4143                         find first buf_shop where buf_shop.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     4144                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
     4145                         find first buf_clients no-lock where
     4146                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     4147                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     4148                         if buf_sysconf.base-code = base-code or v-all-object = true
     4149                               then do:
     4150   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4151   run create_obj-list in this-procedure
     4152    ( input buf_userobjs_temp-user-obj.obj-type ,
     4153      input buf_userobjs_temp-user-obj.obj-code )
     4154      .
     4155                             end.
     4156                             else do:
     4157                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     4158                             end.
     4159                     end.
     4160             end case.
     4161           end.
     4162       end.
     4163   end.
     4164   end case.
     4165   if SelectObject = "currency":U  or g#type <> 'ФП':U then do:
     4166       for each  obj-list : delete obj-list . end.
     4167   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4168   run create_obj-list in this-procedure
     4169    ( input store-type ,
     4170      input store-code )
     4171      .
     4172   end.
     4173   if SelectObject = 'order':U then do:
     4174       for each  obj-list : delete obj-list . end.
     4175       define variable str-pos as integer no-undo .
     4176       define variable str-pos2 as integer no-undo .
     4177       define variable str-1 as character no-undo .
     4178       define variable i as integer no-undo .
     4179       define variable e1 as character no-undo .
     4180       define variable e2 as integer no-undo .
     4181       str-pos = index (  p-m , "&" ) .
     4182       str-pos2 = LENGTH ( p-m ) - str-pos .
     4183       str-1 = substring (p-m , str-pos + 1 , str-pos2 ).
     4184       n-vv = num-entries (str-1) .
     4185       do i = 1 to n-vv :
     4186           assign
     4187             e1 = entry(1, (entry( i , str-1, "," )) , " ")
     4188             e2 = integer(entry(2, (entry( i , str-1, "," )), " " ))
     4189             no-error .
     4190             if error-status :error then next.
     4191   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4192   run create_obj-list in this-procedure
     4193    ( input e1 ,
     4194      input e2 )
     4195      .
     4196       end.
     4197   end.
     4198   OPEN QUERY BR-obj-list FOR EACH obj-list  NO-LOCK.
     4199     end.
     4200   END PROCEDURE.
     4201   procedure verify-check :
     4202    do
     4203    on error undo, return error return-value
     4204    :
     4205    end.
     4206   end procedure.
     4207   procedure sss :
     4208     do
     4209     on error undo, return error return-value
     4210     :
     4211   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4212     for each obj-list :  delete obj-list.  end.
     4213     assign
     4214       str-obj#  = ''
     4215       str-obj2# = ''
     4216       str-obj3# = ''.
     4217     define buffer buf_user-obj for ub.user-obj .
     4218     for each buf_user-obj no-lock
     4219       where buf_user-obj.db-num  = v-cntxt-db-num
     4220         and buf_user-obj.user-id = v-cntxt-userid
     4221     ,each cli-obj no-lock
     4222       where cli-obj.obj-type = buf_user-obj.obj-type
     4223         and cli-obj.obj-code = buf_user-obj.obj-code
     4224         and ( ( cli-obj.db-num = g#db-num ) or g#db-num = 0 )
     4225     :
     4226             find first ub.clients no-lock
     4227               where ub.clients.obj-type = buf_user-obj.obj-type
     4228                 and ub.clients.obj-code = buf_user-obj.obj-code
     4229               no-error .
     4230             if verify-send-check  and ub.clients.db-num <> g#db-num  then do:
     4231                find first ub.db where ub.db.db-num = ub.clients.db-num no-lock.
     4232                if ub.db.send-check = false
     4233                then do:
     4234                  assign
     4235                    str-obj2# = str-obj2#  + " " + ub.clients.obj-name + ","
     4236                  .
     4237                  next.
     4238                end.
     4239             end.
     4240             if temp-param-obj-type = 'shop':u
     4241             then do:
     4242               if buf_user-obj.obj-type = 'скл':U
     4243               then do:
     4244                 assign
     4245                   str-obj# = str-obj#  +  " " + ub.clients.obj-name + ","
     4246                 .
     4247                 next.
     4248               end.
     4249             end.
     4250             if temp-param-obj-type = 'stock':u
     4251             then do:
     4252               if buf_user-obj.obj-type = 'маг':U then do:
     4253                 assign
     4254                   str-obj# = str-obj#  +  " " +  ub.clients.obj-name + ","
     4255                 .
     4256                 next.
     4257               end.
     4258             end.
     4259                   case buf_user-obj.obj-type
     4260                   :
     4261                       when 'скл':U then
     4262                           do:
     4263                               find ub.store where ub.store.obj-code = buf_user-obj.obj-code no-lock.
     4264                               if selectobject = "firm":U then do:
     4265                                 if ub.store.host-code <> g#host-code then do:
     4266                                     str-obj3# = str-obj3#  + " " + ub.clients.obj-name + ",".
     4267                                     next.
     4268                                     end.
     4269                               end.
     4270                               find first ub.sysconf no-lock where ub.sysconf.host-code = ub.store.host-code no-error.
     4271                               find first ub.clients no-lock
     4272                                 where ub.clients.obj-type = buf_user-obj.obj-type
     4273                                   and ub.clients.obj-code = buf_user-obj.obj-code
     4274                                 no-error .
     4275                               if ub.sysconf.base-code = base-code then
     4276                                   do:
     4277   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4278   run create_obj-list in this-procedure
     4279    ( input buf_user-obj.obj-type ,
     4280      input buf_user-obj.obj-code )
     4281      .
     4282                                   end.
     4283                                   else str-obj# = str-obj#  +  " " +   ub.clients.obj-name + "," .
     4284                           end.
     4285                       when 'маг':U then
     4286                           do:
     4287                               find ub.shop where ub.shop.obj-code = buf_user-obj.obj-code no-lock.
     4288                               if selectobject = "firm":U then do:
     4289                                 if ub.shop.host-code <> g#host-code then do:
     4290                                     str-obj3# = str-obj3#  + " " + ub.clients.obj-name + ",".
     4291                                     next.
     4292                                     end.
     4293                               end.
     4294                               find first ub.sysconf no-lock where ub.sysconf.host-code = ub.shop.host-code no-error.
     4295                               find first ub.clients no-lock where
     4296                                           ub.clients.obj-type = buf_user-obj.obj-type and
     4297                                           ub.clients.obj-code = buf_user-obj.obj-code no-error.
     4298                               if ub.sysconf.base-code = base-code
     4299                               then do:
     4300   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4301   run create_obj-list in this-procedure
     4302    ( input buf_user-obj.obj-type ,
     4303      input buf_user-obj.obj-code )
     4304      .
     4305                               end.
     4306                               else do:
     4307                                 assign
     4308                                   str-obj# = str-obj#  +  " " +  ub.clients.obj-name +  ","
     4309                                 .
     4310                               end.
     4311                           end.
     4312                   end case.
     4313     end.
     4314     end.
     4315   end procedure.
     4316   PROCEDURE init-screen :
     4317    do
     4318    on error undo, return error return-value
     4319    :
     4320   define input parameter p-val as character no-undo .
     4321   define variable i as integer no-undo .
     4322   define variable R-algoritm2 as integer init 0 no-undo .
     4323   define variable v-nn as integer   no-undo .
     4324   v-nn = num-entries (p-val) .
     4325     do i = 1 to v-nn :
     4326        case  entry(1,(entry(i,p-val)), "=" ) :
     4327           when string( "R-algoritm" )             then do:
     4328                 if  integer(entry(2,(entry(i,p-val)), "=" )) = 2 then
     4329                     R-algoritm2 = 2.
     4330                 end.
     4331           when string( "R-algoritm2" )            then do:
     4332                case integer(entry(2,(entry(i,p-val)), "=" ))  :
     4333                   when 1 then  R-algoritm =  1  .
     4334                   when 2 then  R-algoritm =  4  .
     4335                   when 3 then  R-algoritm =  3  .
     4336                end case.
     4337                if R-algoritm2 = 2 then  R-algoritm = 2.
     4338                end.
     4339           when string( "tmp-sale.tmp-code" )      then do:
     4340                find first ub.tmp-sale no-lock where ub.tmp-sale.tmp-code = entry(2,(entry(i,p-val)), "=" ) no-error.
     4341                if available ub.tmp-sale then do:
     4342                   rr = recid( ub.tmp-sale) .
     4343                    display  ub.tmp-sale.tmp-code
     4344                                ub.tmp-sale.desc_   with frame Dialog-Frame .
     4345                    reposition Dialog-Frame to recid rr no-error  .
     4346                    if error-status :error then error-status :get-message(1) .
     4347                end.
     4348                else do:
     4349                find first ub.tmp-sale no-lock  .
     4350                   if available ub.tmp-sale then rr = recid(ub.tmp-sale) .
     4351                end.
     4352           end.
     4353           when string( "SelectObject" ) then  do:
     4354                SelectObject = string(entry(2,(entry(i,p-val)), "=" )).
     4355                   if SelectObject = "choice":U then SelectObject = "order":U .
     4356                   run select-objects-proc in this-procedure ( input p-val ).
     4357                end.
     4358           when string( "date-p-1" ) then  date-p-1 = date(entry(2,(entry(i,p-val)), "=" )).
     4359           when string( "date-p-2" ) then  date-p-2 = date(entry(2,(entry(i,p-val)), "=" )).
     4360           when string( "t-way"   )   then  t-way    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4361           when string( "t-rcv"   )   then  t-rcv    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4362           when string( "t-clos"   )   then  t-clos    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4363           when string( "t-rv"   )   then  t-rv    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4364           when string( "t-rvz"  )   then  t-rvz   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4365           when string( "t-rvc"  )   then  t-rvc   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4366           when string( "t-rvzc" )   then  t-rvzc  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4367           when string( "t-sp"   )   then  t-sp    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4368           when string( "t-sppv" )   then  t-sppv  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4369           when string( "t-sppv-2")  then  t-sppv-2 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4370           when string( "t-sppv-3")  then  t-sppv-3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4371           when string( "t-sppv-4")  then  t-sppv-4 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4372       end case.
     4373       g#log = SelectObject:disable(radio-label('все':U , SelectObject:radio-buttons)).
     4374     end.
     4375   end.
     4376   END PROCEDURE.
     4377   procedure v-c-way :
     4378     do
     4379     on error undo, return error return-value
     4380     :
     4381   assign frame Dialog-Frame
     4382     t-way
     4383     t-rcv
     4384     t-clos
     4385    .
     4386           if t-way  then do:
     4387               enable
     4388                 t-rcv
     4389                 t-clos
     4390                 with frame Dialog-Frame .
     4391               display
     4392                 t-rcv
     4393                 t-clos
     4394                 with frame Dialog-Frame .
     4395           end.
     4396           else do:
     4397             hide
     4398               t-rcv
     4399               t-clos
     4400               in frame Dialog-Frame .
     4401           end.
     4402     end.
     4403   end procedure.
