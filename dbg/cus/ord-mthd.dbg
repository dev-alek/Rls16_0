      756   def
      757    shared
      758   temp-table  obj-list no-undo
      759     field obj-type like ub.clients.obj-type
      760     field obj-code like ub.clients.obj-code
      761     field obj-name like ub.clients.obj-name
      762     field obj-id   as integer
