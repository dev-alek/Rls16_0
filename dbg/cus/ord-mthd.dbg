     1946        message  'Режим отключен'.
     1947   END.
     1948   ON CHOOSE OF B-spis IN FRAME Dialog-Frame
     1949   DO:
     1950   define variable t-recid as recid no-undo .
     1951     run ref/tmp-sale.w
     1952        ( parParentProc ,
     1953         input "b-sel",
     1954         output t-recid
     1955         ).
     1956     rr = t-recid.
     1957     find first ub.tmp-sale  where recid( ub.tmp-sale) = int(t-recid) no-lock no-error .
     1958        if available  ub.tmp-sale and not error-status :error  then
     1959        display  ub.tmp-sale.tmp-code
     1960                 ub.tmp-sale.desc_
     1961                 with frame Dialog-Frame .
     1962   END.
     1963   ON CHOOSE OF BUTTON-obj IN FRAME Dialog-Frame
     1964   DO:
     1965     assign SelectObject.
     1966     my-request = false .
     1967     run select-objects-proc in this-procedure ( e-method ) .
     1968   END.
     1969   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1970   DO:
     1971   define variable p-code as character no-undo .
     1972   define variable p-desc as character no-undo .
     1973   define variable t-type as character no-undo .
     1974   define variable loc-sum-min as decimal no-undo .
     1975   Assign frame Dialog-Frame R-algoritm ub.tmp-sale.tmp-code ub.tmp-sale.desc_ t-rv date-p-1 date-p-2 t-rvz t-rvc t-rvzc t-sp t-sppv t-sppv-2 t-sppv-3 t-sppv-4 FILL-IN-1 FILL-IN-3 t-1 t-2 t-3 t-4 t-5 t-6 t-7 SelectObject
     1976   date-p-1
     1977   date-p-2
     1978   no-error .
     1979   assign
     1980   date-p-1 = date(date-p-1:screen-value)
     1981   date-p-2 = date(date-p-2:screen-value)
     1982   SelectObject    = SelectObject:screen-value
     1983   t-way  = if t-way:screen-value  = "no" then false else true  .
     1984   t-clos = if t-clos:screen-value = "no" then false else true  .
     1985   t-rcv  = if t-rcv:screen-value  = "no" then false else true  .
     1986   .
     1987   if error-status :error then error-status :error = false  .
     1988   if t-way = false then
     1989   assign
     1990     t-clos  = false
     1991     t-rcv   = false
     1992   .
     1993   display t-clos
     1994           t-rcv  with frame Dialog-Frame .
     1995   if NOT ( t-way = true and  ( t-clos  = true  or  t-rcv  = true  )
     1996            or
     1997            t-way = false )
     1998   then do:
     1999   message "При учете предыдущих заказов надо выбрать хотя бы один статус !"
     2000     view-as alert-box information.
     2001      return no-apply.
     2002   end.
     2003   if R-algoritm = 3 and R-algoritm:visible and  not can-find (  first  tt-date  )  then do:
     2004   message "При календарном методе расчета должна быть заполнена таблица - даты"
     2005     view-as alert-box information.
     2006   return no-apply.
     2007   end.
     2008   assign
     2009       p-code = ub.tmp-sale.tmp-code
     2010       p-desc = ub.tmp-sale.desc_
     2011       no-error .
     2012   for each tmp#zakaz :
     2013      loc-sum-min = 0 .
     2014      tmp#zakaz.min-stock = 0 .
     2015   end.
     2016   e-method =  fill-in-1 + " : " + entry(R-algoritm * 2 - 1 , R-algoritm:RADIO-BUTTONS) +  ";" + chr(10) +
     2017              (  if R-algoritm = 2 then ( p-desc   + chr(10)) else "" ) +
     2018              (  if date-p-1 <> ? and R-algoritm <> 2 then "c  "  + string(date-p-1,"99/99/9999") else " " ) +
     2019              (  if date-p-2 <> ? and R-algoritm <> 2 then " по " + string(date-p-2,"99/99/9999") else " " ) +  ";" +  chr(10) +
     2020              (  if t-1 then " " + b-1:label   else "") +
     2021              (  if t-2 then " " + b-2:label   else "") +
     2022              (  if t-3 then " " + b-3:label   else "") +
     2023              (  if t-4 then " " + b-4:label   else "") +
     2024              (  if t-5 then " " + b-5:label   else "") +
     2025              (  if t-6 then " " + b-6:label   else "") +
     2026              (  if t-7 then " " + b-7:label   else "") +
     2027               chr(10) +
     2028               FILL-IN-3 + " : " .
     2029    e-method = e-method +
     2030            ( if  t-rv     then  " " + t-rv  :label     else "" ) +
     2031            ( if  t-rvz    then  " " + t-rvz :label     else "" ) +
     2032            ( if  t-rvc    then  " " + t-rvc :label     else "" ) +
     2033            ( if  t-rvzc   then  " " + t-rvzc:label     else "" ) +
     2034            ( if  t-sp     then  " " + t-sp  :label     else "" ) +
     2035            ( if  t-sppv   then  " " + t-sppv:label     else "" ) +
     2036            ( if  t-sppv-2 then  " " + t-sppv-2:label   else "" ) +
     2037            ( if  t-sppv-3 then  " " + t-sppv-3:label   else "" ) +
     2038            ( if  t-sppv-4 then  " " + t-sppv-4:label   else "" )
     2039              .
     2040    e-method = e-method +   chr(10) +
     2041            ( if  t-way    then  " " + t-way  :label + " : "    else "" ) +
     2042            ( if  t-rcv    then  " " + t-rcv  :label            else "" ) +
     2043            ( if  t-clos   then  " " + t-clos :label            else "" ) + ";"
     2044            .
     2045    e-method = e-method +  chr(10) + "Объекты :&"  .
     2046             for each obj-list :
     2047                     e-method = e-method +  obj-list.obj-type + " " + string(obj-list.obj-code) + ","    .
     2048             end.
     2049       define variable Ret as logical no-undo .
     2050        t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2051        define variable obj-jj as integer no-undo .
     2052        for each obj-list :
     2053          obj-jj = obj-jj + 1.
     2054        end.
     2055           run cus/make-rcv.p
     2056                      ( input parParentProc,
     2057                        input v-mode-recid ,
     2058                        input date-p-1,
     2059                        input date-p-2,
     2060                        input "calc":U,
     2061                        input no,
     2062                        input R-algoritm,
     2063                        input p-code,
     2064                        input t-rv,
     2065                        input t-rvz,
     2066                        input t-rvc ,
     2067                        input t-rvzc ,
     2068                        input t-sp   ,
     2069                        input t-sppv ,
     2070                        input t-sppv-2,
     2071                        input t-sppv-3,
     2072                        input t-sppv-4,
     2073                        input t-way,
     2074                        input t-rcv,
     2075                        input t-clos,
     2076                        input table tt-date     ).
     2077   END.
     2078   ON VALUE-CHANGED OF R-algoritm IN FRAME Dialog-Frame
