     1384     define variable v-cntxt-obj-code      as integer   no-undo .
     1385     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1386     define variable v-cntxt-is-admin      as logical   no-undo .
     1387   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1388   define temp-table userobjs_temp-user-obj no-undo
     1389     field obj-type as character
     1390     field obj-code as integer
     1391     index xpk is primary unique obj-type obj-code
     1392     .
     1393   procedure userobjs_clear :
     1394     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1395     do
     1396     on error undo, return error return-value
     1397     :
     1398       for each buf_userobjs_temp-user-obj
     1399       on error undo, return error return-value
     1400       :
     1401         delete buf_userobjs_temp-user-obj .
     1402       end.
     1403     end.
     1404   end .
     1405   procedure userobjs_object-count :
     1406     define output parameter p-total-count as integer   no-undo .
     1407     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1408     do
     1409     on error undo, return error return-value
     1410     :
     1411       assign
     1412         p-total-count = 0
     1413       .
     1414       for each buf_userobjs_temp-user-obj
     1415       on error undo, return error return-value
     1416       :
     1417         assign
     1418           p-total-count = p-total-count + 1
     1419         .
     1420       end.
     1421     end.
     1422   end.
     1423   procedure userobjs_append :
     1424      define input  parameter p-obj-type as character no-undo .
     1425      define input  parameter p-obj-code as integer   no-undo .
     1426     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1427     do
     1428     on error undo, return error return-value
     1429     :
     1430       find first buf_userobjs_temp-user-obj
     1431         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1432           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1433         no-error .
     1434       if not available buf_userobjs_temp-user-obj
     1435       then do:
     1436         create buf_userobjs_temp-user-obj .
     1437         assign
     1438           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1439           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1440         .
     1441       end.
     1442     end.
     1443   end.
     1444   procedure userobjs_object-exist :
     1445     define output parameter p-object-exist as logical   no-undo .
     1446     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1447     do
     1448     on error undo, return error return-value
     1449     :
     1450       find first buf_userobjs_temp-user-obj
     1451         no-error .
     1452       if not available buf_userobjs_temp-user-obj
     1453       then do:
     1454         assign
     1455           p-object-exist = false
     1456         .
     1457       end.
     1458       else do:
     1459         assign
     1460           p-object-exist = true
     1461         .
     1462       end.
     1463     end.
     1464   end.
     1465   procedure userobjs_transfer :
     1466     define input  parameter p-callback-handle as handle no-undo .
     1467     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1468     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472       if valid-handle(p-callback-handle) <> true
     1473       then do:
     1474         message
     1475           vss-workfile vss-revision vss-description skip
     1476           "Ошибка задания входных параметров" skip
     1477           "Неизвестный указатель на процедуру" skip
     1478           view-as alert-box error .
     1479         undo, return error return-value .
     1480       end.
     1481       if p-callback-handle :get-signature("userobjs_append") = ""
     1482       then do:
     1483         message
     1484           vss-workfile vss-revision vss-description skip
     1485           "Ошибка задания входных параметров" skip
     1486           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1487                     ,p-callback-handle :file-name
     1488                     ) skip
     1489           view-as alert-box error .
     1490         undo, return error return-value .
     1491       end.
     1492       for each buf_userobjs_temp-user-obj
     1493       on error undo, return error return-value
     1494       :
     1495         run userobjs_append in p-callback-handle
     1496           (input  buf_userobjs_temp-user-obj.obj-type
     1497           ,input  buf_userobjs_temp-user-obj.obj-code
     1498           ) .
     1499       end.
     1500     end.
     1501   end procedure.
     1502   procedure userobjs_select-one :
     1503      define input  parameter parparentproc     as widget-handle no-undo .
     1504      define input  parameter p-db-num          as integer   no-undo .
     1505      define input  parameter p-user-id         as character no-undo .
     1506      define input  parameter p-host-code-obj   as integer   no-undo .
     1507      define input  parameter p-obj-type        as character no-undo .
     1508      define input  parameter p-obj-code        as integer   no-undo .
     1509      define output parameter p-user-select     as logical   no-undo .
     1510      define output parameter p-select-obj-type as character no-undo .
     1511      define output parameter p-select-obj-code as character no-undo .
     1512     do
     1513     on error undo, return error return-value
     1514     :
     1515       run gbl/userobjs.w
     1516         (input  parparentproc
     1517         ,input  this-procedure :handle
     1518         ,input  p-db-num
     1519         ,input  p-user-id
     1520         ,input  p-host-code-obj
     1521         ,input  p-obj-type
     1522         ,input  p-obj-code
     1523         ,INPUT  "b-sel"
     1524         ,output p-user-select
     1525         ,output p-select-obj-type
     1526         ,output p-select-obj-code
     1527         ) .
     1528     end.
     1529   end.
     1530   procedure userobjs_select-many :
     1531     define input  parameter parparentproc   as widget-handle no-undo .
     1532     define input  parameter p-db-num        as integer   no-undo .
     1533     define input  parameter p-user-id       as character no-undo .
     1534     define input  parameter p-host-code-obj as integer   no-undo .
     1535     define input  parameter p-obj-type      as character no-undo .
     1536     define input  parameter p-obj-code      as integer   no-undo .
     1537     define output parameter p-user-select   as logical   no-undo .
     1538     define variable v-select-obj-type as character no-undo .
     1539     define variable v-select-obj-code as integer   no-undo .
     1540     do
     1541     on error undo, return error return-value
     1542     :
     1543       run gbl/userobjs.w
     1544         (input  parparentproc
     1545         ,input  this-procedure :handle
     1546         ,input  p-db-num
     1547         ,input  p-user-id
     1548         ,input  p-host-code-obj
     1549         ,input  p-obj-type
     1550         ,input  p-obj-code
     1551         ,INPUT  "b-sel,b-mark"
     1552         ,output p-user-select
     1553         ,output v-select-obj-type
     1554         ,output v-select-obj-code
     1555         ) .
     1556     end.
     1557   end.
     1558   procedure thobjs :
     1559      define input        parameter parparentproc     as widget-handle no-undo .
     1560      define input        parameter i-bttns           as character     no-undo .
     1561      define input        parameter i-list-mode       as character     no-undo.
     1562      define input        parameter i-obj-type        as character     no-undo.
     1563      define input        parameter i-db-num          as integer       no-undo.
     1564      define input        parameter i-host-code       as integer       no-undo.
     1565      define input-output parameter p-rid-list        as character     no-undo .
     1566   run ref/thobjs.p
     1567           ( input parparentproc
     1568            ,input  this-procedure :handle
     1569           , input i-bttns
     1570           , input i-list-mode
     1571           , input i-obj-type
     1572           , input i-db-num
     1573           , input i-host-code
     1574           , input-output p-rid-list ) no-error .
     1575   end.
     1576   define input  parameter parParentProc   as widget-handle no-undo.
     1577   define input  parameter v-mode-recid    as recid no-undo .
     1578   define input  parameter g#type          as character no-undo .
     1579   my-handle  = parParentProc .
