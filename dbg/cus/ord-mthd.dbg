     2623     :
     2624       run diasize_change-height in this-procedure
     2625         (input  (p-new-height - frame Dialog-Frame :height)
     2626         ,input  p-move-resize
     2627         ) .
     2628     end.
     2629   end procedure.
     2630   procedure diasize_change-width :
     2631     define input  parameter p-change-value as decimal   no-undo .
     2632     define input  parameter p-move-resize  as logical   no-undo .
