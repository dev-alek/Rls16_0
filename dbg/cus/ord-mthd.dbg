      367     do
      368     on error undo, return error
      369     :
      370           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
      371         (input  p-code
      372         ,output p-type
      373         ,output p-format
      374         ,output p-label
      375         ,output p-user-can-edit
      376         ,output p-output-display
      377         ,output p-other
      378         ) no-error .
      379       if error-status :error
      380       then do:
      381         undo, return error return-value .
      382       end.
      383     end.
      384   end.
