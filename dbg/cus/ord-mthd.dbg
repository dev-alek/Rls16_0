     2641     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2642     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2643     if p-change-value > 0
     2644     then do:
     2645       if frame Dialog-Frame :width + p-change-value >
     2646           session :width-chars
     2647       then do:
