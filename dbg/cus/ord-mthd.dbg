      767   .
      768   procedure create_obj-list :
      769      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      770      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      771      do
      772      on error undo, return error return-value
      773      :
      774         define buffer cli-obj for ub.clients .
      775         define variable p-var as integer no-undo .
      776         define buffer buf_obj-list for obj-list .
      777         find last buf_obj-list  use-index pi no-error .
      778         if available buf_obj-list
      779         then
      780            p-var = buf_obj-list.obj-id + 1.
      781         else
      782            p-var = 1.
      783         find first cli-obj where
      784                   cli-obj.obj-type = p-obj-type
      785               and cli-obj.obj-code = p-obj-code
      786         no-lock no-error.
      787         if available cli-obj
      788         then do:
      789            create buf_obj-list.
      790            assign
      791               buf_obj-list.obj-id   = p-var
      792               buf_obj-list.obj-code = cli-obj.obj-code
      793               buf_obj-list.obj-type = cli-obj.obj-type
      794               buf_obj-list.obj-name = cli-obj.obj-name
      795               buf_obj-list.db-num   = cli-obj.db-num
      796            .
      797         end.
      798      end.
      799   end.
