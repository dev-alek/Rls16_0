      835   define variable var-report-r-b as character no-undo .
      836   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      838     (output var-report-r-b
      839     )  .
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      842   define new shared variable RepPathName        as character no-undo .
      843   define new shared variable PrintRubl          as logical   no-undo .
      844   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define  stream PrnLibStream.
      846   procedure prn-lib-prn-file :
      847     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      848     define input parameter p-DIsabledoptions as integer no-undo .
      849     define variable v-report-name as character no-undo .
      850     define variable v-user-action as character no-undo .
      851     define variable v-printed     as logical   no-undo .
      852     define variable v-exist       as logical   no-undo .
      853     do
      854       on error undo, return error
      855       :
      856       run prn-lib-get-report-name  in this-procedure (
      857         input parParentProc
      858         ,output v-report-name
      859         ).
      860   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      862     (input  v-report-name
      863     ,input  2
      864     ,output v-exist
      865     )  .
      866       if NOT v-exist then
      867       DO:
      868         Message
      869           "Нет заданий на печать ! "
      870           view-as alert-box .
      871         Return  .
      872       End.
      873       run gbl/prnfilen.w
      874         (input  ""
      875         ,input  p-DisabledOptions
      876         ,input  string(v-report-name )
      877         ,input  7
      878         ,output v-user-action
      879         ,output v-printed
      880         ) .
      881       if v-printed then
      882       do:
      883         return "YES" .
      884       end.
      885       else
      886       do:
      887         return "NO" .
      888       end.
      889     end.
      890   end procedure.
      891   procedure prn-lib-open-stream :
      892     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      893     define input parameter p-page-size    as integer no-undo .
      894     define input parameter p-is-stream    as logical no-undo .
      895     define input parameter p-append       as logical no-undo .
      896     define variable v-report-name as character no-undo .
      897     do
      898       on error undo, return error
      899       :
      900       run prn-lib-get-report-name  in this-procedure (
      901         input parParentProc
      902         ,output v-report-name
      903         ).
      904       if p-is-stream then
      905       do:
      906         if p-append then
      907         do:
      908           output stream PrnLibStream to value( v-report-name )
      909             page-size value(p-page-size) append .
      910         end.
      911         if not p-append then
      912         do:
      913           output stream PrnLibStream to value( v-report-name )
      914             page-size value(p-page-size) .
      915         end.
      916       end.
      917       if not p-is-stream then
      918       do:
      919         if p-append then
      920         do:
      921           output to value( v-report-name )
      922             page-size value(p-page-size) append .
      923         end.
      924         if not p-append then
      925         do:
      926           output to value( v-report-name )
      927             page-size value(p-page-size) .
      928         end.
      929       end.
      930     end.
      931   end procedure.
      932   procedure prn-lib-open-exp :
      933     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      934     define input parameter p-is-stream    as logical no-undo .
      935     define input parameter p-is-append    as logical no-undo .
      936     define output parameter p-ReportFileName as char init "report" no-undo.
      937     define output parameter p-process as logical no-undo .
      938     define variable glog as logical no-undo .
      939     do
      940       on error undo, return error
      941       :
      942       SYSTEM-DIALOG GET-FILE p-ReportFileName
      943         TITLE      "Укажите путь"
      944         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      945         ASK-OVERWRITE
      946         CREATE-TEST-FILE
      947         SAVE-AS
      948         USE-FILENAME
      949         DEFAULT-EXTENSION "txt"
      950         UPDATE glog
      951         .
      952       if not glog then  return.
      953       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      954       if p-is-stream then
      955       do:
      956         if p-is-append then
      957         do:
      958           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      959         end.
      960         else
      961         do:
      962           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      963         end.
      964       end.
      965       else
      966       do:
      967         if p-is-append then
      968         do:
      969           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      970         end.
      971         else
      972         do:
      973           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      974         end.
      975       end.
      976       p-process = yes.
      977     end.
      978   end procedure.
      979   procedure prn-lib-get-report-name :
      980     define input parameter parParentProc  as widget-handle no-undo.
      981     define output parameter p-report-name as character no-undo .
      982     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      983   end procedure.
      984   procedure prn-lib-reportviewer-report-name :
      985     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      986     define input parameter p-report-name-html as character no-undo .
      987     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      988   end procedure.
      989   procedure prn-lib-reportviewer :
      990     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      991     define input parameter p-report-name-html as character no-undo .
      992     define input parameter p-param        as character no-undo .
      993     define variable v-excel           as character no-undo init 'TRUE' .
      994     define variable v-value-character as character no-undo .
      995     define variable v-value-integer   as character no-undo .
      996     define variable v-value-date      as date      no-undo .
      997     define variable v-value-decimal   as decimal   no-undo .
      998     define variable rep-excel         as logical   no-undo .
      999     define variable excel-string      as character no-undo .
     1000     define variable v-param-type      as character no-undo .
     1001     define variable v-tth             as handle    no-undo .
     1002     run adm/shattri.p (
     1003       input "get":U
     1004       ,input  ""
     1005       ,input  0
     1006       ,input  'report-glob':U
     1007       ,input  'rep-excel':U
     1008       ,output v-value-character
     1009       ,output v-value-date
     1010       ,output v-value-decimal
     1011       ,output v-value-integer
     1012       ,output rep-excel
     1013       ,output v-param-type
     1014       ,INPUT-OUTPUT table-handle v-tth
     1015       )  .
     1016     if rep-excel then v-excel = "TRUE" .
     1017     else v-excel = "FALSE" .
     1018     if p-param eq ""
     1019     then
     1020        p-param = "EXCEL:" + v-excel.
     1021     else
     1022        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1023     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1024   end procedure.
     1025   function diff-list returns character (
     1026     input parfirst-list  as character,
     1027     input parsecond-list as character,
     1028     input pardelim       as character).
     1029     if pardelim = ""
     1030     or pardelim = ?
     1031     then do:
     1032       assign
     1033         pardelim = ","
     1034       .
     1035     end.
     1036     def var ind as integer no-undo .
     1037     def var v-elem as character no-undo .
     1038     def var v-result-list as character no-undo init "".
     1039     def var v-num-parfirst-list as integer no-undo .
     1040     assign
     1041       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1042     .
     1043     do ind = 1 to v-num-parfirst-list
     1044     :
     1045       assign
     1046         v-elem = entry(ind, parfirst-list, pardelim)
     1047       .
     1048       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1049         assign
     1050           v-result-list = v-result-list
     1051                         + (if v-result-list > "" then pardelim else "")
     1052                         + v-elem
     1053         .
     1054       end.
     1055     end.
     1056     return v-result-list .
     1057   end function.
     1058   function add-list returns character (
     1059    input parfirst-list  as character,
     1060    input parsecond-list as character,
     1061    input pardelim       as character).
     1062     if pardelim = ""
     1063     or pardelim = ?
     1064     then do:
     1065       assign
     1066         pardelim = ","
     1067       .
     1068     end.
     1069     def var ind as integer no-undo .
     1070     def var v-elem as character no-undo .
     1071     def var v-result-list as character no-undo init "".
     1072     def var v-num-parfirst-list as integer no-undo .
     1073     assign
     1074       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1075     .
     1076     do ind = 1 to v-num-parfirst-list
     1077     :
     1078       assign
     1079         v-elem = entry(ind, parfirst-list, pardelim)
     1080       .
     1081       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1082         assign
     1083           v-result-list = v-result-list
     1084                         + (if v-result-list > "" then pardelim else "")
     1085                         + v-elem
     1086         .
     1087       end.
     1088     end.
     1089     def var v-num-parsecond-list as integer no-undo .
     1090     assign
     1091       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1092     .
     1093     do ind = 1 to v-num-parsecond-list
     1094     :
     1095       assign
     1096         v-elem = entry(ind, parsecond-list, pardelim)
     1097       .
     1098       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1099         assign
     1100           v-result-list = v-result-list
     1101                         + (if v-result-list > "" then pardelim else "")
     1102                         + v-elem
     1103         .
     1104       end.
     1105     end.
     1106     return v-result-list .
     1107   end function.
     1108   function cross-list returns character (
     1109    input parfirst-list  as character,
     1110    input parsecond-list as character,
     1111    input pardelim       as character).
     1112     if pardelim = ""
     1113     or pardelim = ?
     1114     then do:
     1115       assign
     1116         pardelim = ","
     1117       .
     1118     end.
     1119     def var ind as integer no-undo .
     1120     def var v-elem as character no-undo .
     1121     def var v-result-list as character no-undo init "".
     1122     def var v-num-parfirst-list as integer no-undo .
     1123     assign
     1124       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1125     .
     1126     do ind = 1 to v-num-parfirst-list
     1127     :
     1128       assign
     1129         v-elem = entry(ind, parfirst-list, pardelim)
     1130       .
     1131       if lookup(v-elem, v-result-list, pardelim) = 0
     1132       and lookup(v-elem, parsecond-list, pardelim) > 0
     1133       then do:
     1134         assign
     1135           v-result-list = v-result-list
     1136                         + (if v-result-list > "" then pardelim else "")
     1137                         + v-elem
     1138         .
     1139       end.
     1140     end.
     1141     return v-result-list .
     1142   end function.
     1143   function radio-label returns character (
     1144    input par-rs-value  as character,
     1145    input par-rs-radio-buttons as character)
     1146    .
     1147    DEFINE variable v-result-label as character no-undo.
     1148    assign
     1149    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1150                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1151                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1152                             ), par-rs-radio-buttons
     1153                           )
     1154    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1155    .
     1156   return v-result-label.
     1157   end function.
     1158   function m-radio-label returns character (
     1159    input par-rs-value  as character,
     1160    input par-rs-radio-buttons as character,
     1161    input par-delim as character
     1162    )
     1163    .
     1164    DEFINE variable v-result-label as character no-undo.
     1165    assign
     1166    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1167                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1168                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1169                             ), par-rs-radio-buttons, par-delim
     1170                           )
     1171    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1172    .
     1173   return v-result-label.
     1174   end function.
     1175   FUNCTION mixlist returns character
     1176   (
     1177    input parfirst-list  as character
     1178    ,input parsecond-list as character
     1179    ,input pardelim       as character
     1180    ,input pardelim-result as character ) :
     1181     if pardelim = ""
     1182     or pardelim = ?
     1183     then do:
     1184       assign
     1185         pardelim = ","
     1186       .
     1187     end.
     1188     def var ind as integer no-undo .
     1189     def var v-elem1 as character no-undo .
     1190     def var v-elem2 as character no-undo .
     1191     def var v-result-list as character no-undo init "".
     1192     do ind = 1 to num-entries(parfirst-list, pardelim)
     1193     :
     1194       assign
     1195         v-elem1 = entry(ind, parfirst-list, pardelim)
     1196         v-elem2 = entry(ind, parsecond-list, pardelim)
     1197       .
     1198         assign
     1199           v-result-list = v-result-list
     1200                         + (if v-result-list > "" then pardelim-result else "")
     1201                         + v-elem1 + pardelim-result + v-elem2
     1202         .
     1203     end.
     1204     return v-result-list .
     1205   END FUNCTION.
     1206   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   define variable v-waitfram-action01         as character   no-undo .
     1208   define variable v-waitfram-action02         as character   no-undo .
     1209   define variable v-waitfram-action03         as character   no-undo .
     1210   define variable mWaitFramTextBeg            as character   no-undo.
     1211   define variable mWaitFramTextEnd            as character   no-undo.
     1212   define variable mWaitFramView               as logical     no-undo.
     1213   define variable mWaitProcEvent              as logical     no-undo init yes.
     1214   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1215   define variable mWaitFramStop               as logical     no-undo.
     1216   define variable mWaitFramStopUser           as logical     no-undo.
     1217   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1218   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1219   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1220   define button B-WaitFramStop auto-end-key
     1221        label "Стоп"
     1222        size 10 by 1 tooltip "Остоновить процесс".
     1223   define button B-viewProcInfo
     1224        label "Информация"
     1225        size 15 by 1 tooltip "Информация о процесс".
     1226   define frame waitfram
     1227     v-waitfram-action01 format "x(72)" no-label skip
     1228     v-waitfram-action02 format "x(72)" no-label skip
     1229     v-waitfram-action03 format "x(72)" no-label skip
     1230     B-viewProcInfo
     1231     B-WaitFramStop at row 4 col 30
     1232     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1233     .
     1234   define new global shared variable mBatchMode as logical no-undo init ?.
     1235   define variable mFramBachModHandle as handle no-undo.
     1236   mFramBachModHandle = frame waitfram:handle.
     1237   define variable mFameOldVis as logical no-undo.
     1238   define variable mVisCUrentVin as logical no-undo.
     1239   if session:batch-mode
     1240   then
     1241      mBatchMode = yes.
     1242   if mBatchMode = ? then do:
     1243     mVisCUrentVin = current-window:visible.
     1244     mFameOldVis = mFramBachModHandle:visible.
     1245     mFramBachModHandle:visible  = yes.
     1246     mBatchMode = mFramBachModHandle:visible ne yes.
     1247     mFramBachModHandle:visible = mFameOldVis.
     1248     current-window:visible = mVisCUrentVin.
     1249   end.
     1250    if  log-manager:logfile-name ne ?
     1251     then DO:
     1252         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1253         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1254         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1255     end.
     1256   on choose of B-WaitFramStop in frame waitfram
     1257   do:
     1258     mWaitFramStop = yes.
     1259     mWaitFramStopUser = yes.
     1260   end.
     1261   function waitfram-check-timeout returns logical():
     1262      define variable vtime as int64 no-undo.
     1263      if mWaitFramStopTimeOut
     1264      then
     1265         return yes.
     1266      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1267      if     mWaitFramTimeOut ne ?
     1268         and mWaitFramTimeOut ne 0
     1269         and mWaitFramTimeOut lt vtime
     1270      then do:
     1271         mWaitFramStopTimeOut = yes.
     1272      end.
     1273      return mWaitFramStopTimeOut.
     1274   end.
     1275   procedure waitfram-hide :
     1276     if not session:batch-mode
     1277     then do
     1278     on error undo, return error return-value
     1279     :
     1280       pause 0 before-hide .
     1281       if not mBatchMode then
     1282         hide frame waitfram .
     1283     if     not mWaitFramView
     1284        and mWaitProcEvent
     1285     then
     1286       process events .
     1287     end.
     1288   end procedure.
     1289   procedure waitfram-show :
     1290     define input  parameter p-message as character no-undo .
     1291     define variable v-left-margin as integer   no-undo .
     1292     if not session:batch-mode
     1293     then do
     1294     on error undo, return error return-value
     1295     :
     1296       if length(p-message) <= 70 then do:
     1297         assign
     1298           v-left-margin = integer((70 - length(p-message)) / 2)
     1299         .
     1300         assign
     1301           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1302         .
     1303         assign
     1304           v-waitfram-action01 = " "
     1305           v-waitfram-action02 = " "
     1306                                    + fill(" ", v-left-margin)
     1307                                    + p-message
     1308           v-waitfram-action03 = " "
     1309         .
     1310       end.
     1311       else do:
     1312         define variable vRindex1 as integer no-undo.
     1313         define variable vRindex2 as integer no-undo.
     1314         vRindex1 = r-index(p-message," ",70).
     1315         if vRindex1 = 0
     1316         then
     1317            vRindex1 = 70.
     1318         if length(p-message)  <= vRindex1 + 70 then do:
     1319           assign
     1320             v-waitfram-action01 = " "
     1321             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1322             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1323           .
     1324         end.
     1325         else do:
     1326           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1327           if vRindex2 <= vRindex1
     1328           then
     1329              vRindex2 = vRindex1 + 70.
     1330           assign
     1331             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1332             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1333             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1334           .
     1335         end.
     1336       end.
     1337       B-viewProcInfo:visible   in frame waitfram = no.
     1338       B-viewProcInfo:sensitive in frame waitfram = no.
     1339       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1340       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1341       if  (   mWaitFramView
     1342          or  mWaitProcEvent)
     1343          and not mBatchMode
     1344       then
     1345          display
     1346             v-waitfram-action01 skip
     1347             v-waitfram-action02 skip
     1348             v-waitfram-action03 skip
     1349          with frame waitfram .
     1350       if     mWaitFramView
     1351          then do:
     1352             if     mWaitFramInterval ne ?
     1353                and not mBatchMode
     1354             then
     1355                wait-for go of frame waitfram pause mWaitFramInterval.
     1356          end.
     1357          else
     1358             if     mWaitProcEvent
     1359                and not mBatchMode
     1360             then
     1361                process events .
     1362     end.
     1363   end procedure.
     1364      procedure waitfram-show-this:
     1365         define input  parameter iInterval as int64 no-undo.
     1366         define variable vtime as int64 no-undo.
     1367         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1368         mWaitFramInterval = iInterval.
     1369         run waitfram-show (substitute("&1&2 &3&4" ,
     1370                                       mWaitFramTextBeg ,
     1371                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1372                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1373                                       mWaitFramTextEnd
     1374                                      )
     1375                           ).
     1376      end.
     1377      procedure WaitFramRunPause:
     1378         define input  parameter iInterval as dec no-undo.
     1379         define variable vStart  as datetime-tz no-undo.
     1380         define variable vend    as datetime-tz no-undo.
     1381         define variable vint as int64 no-undo.
     1382         define variable vOk as logical no-undo.
     1383         vStart = now.
     1384         vend   = vStart.
     1385         publish "WaitFramPause" (iInterval,output vOk).
     1386         vend   =  now.
     1387         vint = vend - vStart.
     1388         vint = iInterval - vint / 1000.
     1389         if     not mWaitFramStop
     1390            and (   vint > 0
     1391                 or (    not vOk
     1392                     and iInterval eq ?
     1393                     )
     1394                 )
     1395         then
     1396            run waitfram-show-this (iInterval).
     1397         vend   =  now.
     1398         vint = vend - vStart.
     1399         vint = iInterval - vint / 1000.
     1400         if     not mWaitFramStop
     1401            and vint > 0
     1402         then do:
     1403            run gbl/pause.p (vint * 1000).
     1404         end.
     1405         if iInterval ne ?
     1406         then
     1407            publish "WaitFramStop".
     1408         waitfram-check-timeout().
     1409      end.
     1410      procedure WaitFramWaitFor:
     1411         define input  parameter iInterval as dec no-undo.
     1412         assign
     1413            mWaitFramStartProc   = now
     1414            mWaitFramStopUser    = no
     1415            mWaitFramStopTimeOut = no
     1416         .
     1417         block-wait:
     1418         do while not mWaitFramStop:
     1419            run WaitFramRunPause (iInterval).
     1420            if  waitfram-check-timeout()
     1421            then do:
     1422               leave block-wait.
     1423            end.
     1424         end.
     1425         run waitfram-hide.
     1426      end.
     1427   procedure waitfram-join :
     1428     define input  parameter p-line-1  as character no-undo .
     1429     define input  parameter p-line-2  as character no-undo .
     1430     define input  parameter p-line-3  as character no-undo .
     1431     define output parameter p-message as character no-undo .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       assign
     1436         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1437                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1438                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1439       .
     1440     end.
     1441   end procedure.
     1442   function waitfram-join-function returns character
     1443     (input p-line-1 as character
     1444     ,input p-line-2 as character
     1445     ,input p-line-3 as character
     1446     ).
     1447     define variable v-message as character no-undo .
     1448     run waitfram-join in this-procedure
     1449       (input  p-line-1
     1450       ,input  p-line-2
     1451       ,input  p-line-3
     1452       ,output v-message
     1453       ) .
     1454     return v-message .
     1455   end function .
     1456   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   procedure factord :
     1458     define input  parameter p-fact-date            as date    no-undo .
     1459     define input  parameter p-fact-time            as integer no-undo .
     1460     define input  parameter p-fact-num             as integer no-undo .
     1461     define input  parameter p-shift-date           as date    no-undo .
     1462     define input  parameter p-shift-num            as integer no-undo .
     1463     define input  parameter p-shift-on             as logical no-undo .
     1464     define output parameter p-fact-order           as decimal no-undo .
     1465     define output parameter p-shift-end-fact-order as decimal no-undo .
     1466     define output parameter p-day-end-fact-order   as decimal no-undo .
     1467     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1468     if p-fact-date = ?
     1469     then do:
     1470       return error "Не указана фактическая дата" .
     1471     end.
     1472     define variable v-fact-date-num as integer no-undo .
     1473     assign
     1474       v-fact-date-num = integer(p-fact-date)
     1475     .
     1476     if p-fact-num = ?
     1477     or p-fact-num = 0
     1478     then do:
     1479       return error "Не задан p-fact-num " + string(p-fact-num) .
     1480     end.
     1481     if p-fact-num < 0
     1482     then do:
     1483       return error "Отрицательный fact-num " + string(p-fact-num) .
     1484     end.
     1485     if p-fact-num >= 100000000
     1486     then do:
     1487       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1488     end.
     1489     if p-shift-on = true
     1490     then do:
     1491       if p-shift-date = ?
     1492       then do:
     1493         return error "Не задана дата смены" .
     1494       end.
     1495       if p-shift-num = ?
     1496       or p-shift-num = 0
     1497       then do:
     1498         return error "Не задан номер смены" .
     1499       end.
     1500     end.
     1501     else do:
     1502       assign
     1503         p-shift-date = p-fact-date
     1504         p-shift-num  = 24
     1505       .
     1506     end.
     1507     define variable v-shift-offset as integer no-undo .
     1508     if p-shift-date = p-fact-date
     1509     then do:
     1510       assign
     1511         v-shift-offset = 1
     1512       .
     1513     end.
     1514     if p-shift-date < p-fact-date
     1515     then do:
     1516       assign
     1517         v-shift-offset = 0
     1518       .
     1519     end.
     1520     if p-shift-date > p-fact-date
     1521     then do:
     1522       message
     1523         vss-workfile vss-revision vss-description skip
     1524         "Неправильная дата закрытия смены" skip
     1525         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1526         view-as alert-box error .
     1527       undo, return error
     1528         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1529           ,string(p-fact-date, '99/99/9999':U)
     1530           ,string(p-shift-date, '99/99/9999':U)
     1531           )
     1532       .
     1533     end.
     1534     if p-shift-num < 1
     1535     or p-shift-num > 24
     1536     then do:
     1537       message
     1538         vss-workfile vss-revision vss-description skip
     1539         "Неправильный номер смены" skip
     1540         "p-shift-num" p-shift-num skip
     1541         view-as alert-box error .
     1542       undo, return error return-value .
     1543     end.
     1544     assign
     1545       p-fact-order           = v-fact-date-num
     1546                              + v-shift-offset * 0.5
     1547                              + p-shift-num    * 0.02 - 0.01
     1548                              + p-fact-num     * 0.0000000001
     1549       p-shift-end-fact-order = v-fact-date-num
     1550                              + v-shift-offset * 0.5
     1551                              + p-shift-num    * 0.02
     1552       p-day-end-fact-order   = v-fact-date-num
     1553                              + 0.99
     1554     .
     1555     if p-fact-order           <= v-fact-date-num
     1556     or p-shift-end-fact-order <= v-fact-date-num
     1557     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1558     or p-shift-end-fact-order >= p-day-end-fact-order
     1559     then do:
     1560       message
     1561         vss-workfile vss-revision vss-description skip
     1562         "Внутренняя ошибка при генерации фактического номера" skip
     1563         "p-fact-date"            p-fact-date            skip
     1564         "p-fact-time"            p-fact-time            skip
     1565         "p-fact-num"             p-fact-num             skip
     1566         "p-shift-date"           p-shift-date           skip
     1567         "p-shift-num"            p-shift-num            skip
     1568         "p-shift-on"             p-shift-on             skip
     1569         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1570         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1571         "v-fact-date-num"        v-fact-date-num        skip
     1572         view-as alert-box error .
     1573       undo, return error return-value .
     1574     end.
     1575   end procedure.
     1576   procedure day-begin-fact-order :
     1577     define input  parameter p-fact-date            as date    no-undo .
     1578     define output parameter p-day-begin-fact-order as decimal no-undo .
     1579     do
     1580     on error undo, return error return-value
     1581     :
     1582       if p-fact-date = ?
     1583       then do:
     1584         assign
     1585           p-day-begin-fact-order = 0
     1586         .
     1587       end.
     1588       else do:
     1589         assign
     1590           p-day-begin-fact-order = integer(p-fact-date)
     1591         .
     1592       end.
     1593     end.
     1594   end procedure.
     1595   procedure factord-max-fact-order :
     1596     define output parameter p-max-fact-order as decimal   no-undo .
     1597     do
     1598     on error undo, return error return-value
     1599     :
     1600       run day-begin-fact-order in this-procedure
     1601         (input  date(1, 1, 5000)
     1602         ,output p-max-fact-order
     1603         ) .
     1604     end.
     1605   end procedure.
     1606   procedure factord-cut-archive :
     1607     define input  parameter p-obj-type             as character no-undo .
     1608     define input  parameter p-obj-code             as integer   no-undo .
     1609     define input  parameter p-fact-date            as date      no-undo .
     1610     define output parameter p-shift-on             as logical   no-undo .
     1611     define output parameter p-shift-date           as date      no-undo .
     1612     define output parameter p-shift-num            as integer   no-undo .
     1613     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1614     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1615     define variable v-fact-order as decimal   no-undo .
     1616     define buffer buf_shift-obj for ub.shift-obj .
     1617     do
     1618     on error undo, return error return-value
     1619     :
     1620   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1622     (input  p-obj-type
     1623     ,input  p-obj-code
     1624     ,input  'shift-on=request'
     1625     ,output p-shift-on
     1626     ) no-error .
     1627       if error-status :error
     1628       then do:
     1629         message
     1630           vss-workfile vss-revision vss-description skip
     1631           "Ошибка при определении атрибута объекта" skip
     1632           "Объект" p-obj-type p-obj-code skip
     1633           error-status :get-message(1) skip
     1634           return-value skip
     1635           view-as alert-box error .
     1636         undo, return error return-value .
     1637       end.
     1638       if p-shift-on = false
     1639       then do:
     1640         assign
     1641           p-shift-date               = ?
     1642           p-shift-num                = 0
     1643         .
     1644       end.
     1645       else do:
     1646         find first buf_shift-obj share-lock
     1647           where buf_shift-obj.obj-type   = p-obj-type
     1648             and buf_shift-obj.obj-code   = p-obj-code
     1649             and buf_shift-obj.shift-date > p-fact-date
     1650           use-index pi
     1651           no-error .
     1652         if not available buf_shift-obj
     1653         or buf_shift-obj.status_ <> 'зкр':U
     1654         then do:
     1655           message
     1656             vss-workfile vss-revision vss-description skip
     1657             "Невозможно вычислить последнюю смену" skip
     1658             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1659             "Объект" p-obj-type p-obj-code skip
     1660             "Дата" p-fact-date skip
     1661             view-as alert-box error .
     1662           undo, return error return-value .
     1663         end.
     1664         find last buf_shift-obj share-lock
     1665           where buf_shift-obj.obj-type = p-obj-type
     1666             and buf_shift-obj.obj-code = p-obj-code
     1667             and buf_shift-obj.shift-date <= p-fact-date
     1668           use-index pi
     1669           no-error .
     1670         if available buf_shift-obj
     1671         then do:
     1672           if  buf_shift-obj.status_ = 'зкр':U
     1673           then do:
     1674             assign
     1675               p-shift-date = buf_shift-obj.shift-date
     1676               p-shift-num  = buf_shift-obj.shift-num
     1677             .
     1678           end.
     1679           else do:
     1680             message
     1681               vss-workfile vss-revision vss-description skip
     1682               "Невозможно вычислить последнюю смену" skip
     1683               "Статус смены отличен от статуса" 'зкр':U skip
     1684               "Объект" p-obj-type p-obj-code skip
     1685               "Дата" p-fact-date skip
     1686               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1687               view-as alert-box error .
     1688             undo, return error return-value .
     1689           end.
     1690         end.
     1691         else do:
     1692           assign
     1693             p-shift-date = p-fact-date - 1
     1694             p-shift-num  = 1
     1695           .
     1696         end.
     1697       end.
     1698       run factord in this-procedure
     1699         (input  p-fact-date
     1700         ,input  1
     1701         ,input  1
     1702         ,input  p-shift-date
     1703         ,input  p-shift-num
     1704         ,input  p-shift-on
     1705         ,output v-fact-order
     1706         ,output p-shift-end-fact-order
     1707         ,output p-day-end-fact-order
     1708         ) no-error .
     1709       if error-status :error
     1710       then do:
     1711         message
     1712           vss-workfile vss-revision vss-description skip
     1713           "Ошибка при вызове процедуры factord"
     1714           error-status :get-message(1) skip
     1715           return-value skip
     1716           view-as alert-box error .
     1717         undo, return error return-value .
     1718       end.
     1719     end.
     1720   end procedure.
     1721   procedure factord-lock-shift :
     1722     define input  parameter p-obj-type  as character no-undo .
     1723     define input  parameter p-obj-code  as integer   no-undo .
     1724     define input  parameter p-fact-date as date      no-undo .
     1725     define parameter buffer buf_shift-obj for ub.shift-obj .
     1726     define variable v-shift-on      as logical   no-undo .
     1727     define variable v-extra-message as character no-undo .
     1728     define variable v-error as character no-undo .
     1729     do
     1730     on error undo, return error return-value
     1731     :
     1732   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1733   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1734     (input  p-obj-type
     1735     ,input  p-obj-code
     1736     ,input  'shift-on=request'
     1737     ,output v-shift-on
     1738     ) no-error .
     1739       if error-status :error
     1740       then do:
     1741         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1742         undo, return error v-error .
     1743       end.
     1744       if v-shift-on = true
     1745       then do:
     1746         find first buf_shift-obj share-lock
     1747           where buf_shift-obj.obj-type   = p-obj-type
     1748             and buf_shift-obj.obj-code   = p-obj-code
     1749             and buf_shift-obj.shift-date > p-fact-date
     1750           use-index pi
     1751           no-error .
     1752         if not available buf_shift-obj
     1753         or buf_shift-obj.status_ <> 'зкр':U
     1754         then do:
     1755           find last buf_shift-obj
     1756             where buf_shift-obj.obj-type = p-obj-type
     1757               and buf_shift-obj.obj-code = p-obj-code
     1758               and buf_shift-obj.status_  = 'зкр':U
     1759             use-index stts
     1760             no-error .
     1761           if available buf_shift-obj
     1762           then do:
     1763             assign
     1764               v-extra-message =
     1765                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1766                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1767                               )
     1768             .
     1769           end.
     1770           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1771           undo, return error v-error .
     1772         end.
     1773       end.
     1774     end.
     1775   end procedure.
     1776   procedure factord-end-day :
     1777     define input  parameter p-fact-date            as date    no-undo .
     1778     define output parameter p-day-end-fact-order   as decimal no-undo .
     1779     do
     1780     on error undo, return error return-value
     1781     :
     1782       if p-fact-date = ?
     1783       then do:
     1784         return error "Не указана фактическая дата" .
     1785       end.
     1786       assign
     1787         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1788       .
     1789     end.
     1790   end procedure.
     1791   procedure factord-to-date :
     1792     define input  parameter p-fact-order as decimal no-undo .
     1793     define output parameter p-fact-date  as date    no-undo .
     1794     define variable v-ref-date  as date      no-undo .
     1795     define variable v-ref-delta as integer   no-undo .
     1796     do
     1797     on error undo, return error return-value
     1798     :
     1799       if p-fact-order = ?
     1800       or p-fact-order = 0
     1801       then do:
     1802         return error "Не указан fact-order" .
     1803       end.
     1804       assign
     1805         v-ref-date  = date(1, 1, 2000)
     1806       .
     1807       assign
     1808         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1809       .
     1810       assign
     1811         p-fact-date = v-ref-date + v-ref-delta
     1812       .
     1813     end.
     1814   end procedure.
     1815   procedure factord-to-fact-num :
     1816     define input  parameter p-fact-order as decimal no-undo .
     1817     define output parameter p-fact-num   as integer no-undo .
     1818     define variable v-fact-order-trunc as decimal no-undo .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       if p-fact-order = ?
     1823       or p-fact-order = 0
     1824       then do:
     1825         return error "Не указан fact-order" .
     1826       end.
     1827       assign
     1828        v-fact-order-trunc = truncate(p-fact-order, 2)
     1829       .
     1830       assign
     1831         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1832       .
     1833     end.
     1834   end procedure.
     1835   procedure factord-to-shift-num :
     1836     define input  parameter p-fact-order as decimal no-undo .
     1837     define output parameter p-shift-num   as integer no-undo .
     1838     define variable  p-shift-numd  as decimal   no-undo .
     1839     define variable v-fact-order-trunc as decimal no-undo .
     1840     do
     1841     on error undo, return error return-value
     1842     :
     1843       if p-fact-order = ?
     1844       or p-fact-order = 0
     1845       then do:
     1846         return error "Не указан fact-order" .
     1847       end.
     1848       assign
     1849        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1850       .
     1851       if v-fact-order-trunc < 0.5 then do:
     1852         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1853       end.
     1854       assign
     1855         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1856         .
     1857        assign
     1858         p-shift-num = truncate (p-shift-numd , 0)
     1859       .
     1860     end.
     1861   end procedure.
     1862   define variable parparentproc as widget-handle no-undo .
     1863   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1864     define variable v-cntxt-db-num        as integer   no-undo .
     1865     define variable v-cntxt-userid        as character no-undo .
     1866     define variable v-cntxt-level         as character no-undo .
     1867     define variable v-cntxt-host-code-obj as integer   no-undo .
     1868     define variable v-cntxt-obj-type      as character no-undo .
     1869     define variable v-cntxt-obj-code      as integer   no-undo .
     1870     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1871     define variable v-cntxt-is-admin      as logical   no-undo .
     1872   define variable State-source as Widget-Handle.
     1873   DEFINE SHARED VARIABLE cas-shft as logical no-undo init no.
     1874   define variable cas-num as integer no-undo.
     1875   define variable found as logical no-undo.
     1876   DEFINE VARIABLE ByOperations AS INTEGER
     1877        VIEW-AS RADIO-SET VERTICAL
     1878        RADIO-BUTTONS
     1879             "Продажи", 1,
     1880   "Возвраты", -1,
     1881   "Продажи + возвраты", 0
     1882        SIZE 21.38 BY 3 NO-UNDO.
     1883   DEFINE RECTANGLE RECT-checks
     1884        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1885        SIZE 36.5 BY 5.92.
     1886   DEFINE FRAME F-Main
     1887        ByOperations AT ROW 8.54 COL 2.88 NO-LABEL
     1888        "Просмотреть операции ( чеки ):" VIEW-AS TEXT
     1889             SIZE 30.25 BY .92 AT ROW 7.17 COL 4
     1890             FGCOLOR 4
     1891        RECT-checks AT ROW 6.5 COL 1.63
     1892       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1893            SIDE-LABELS NO-UNDERLINE THREE-D
     1894            AT COL 1 ROW 1
     1895            SIZE 56.88 BY 11.83.
     1896   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1897   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1898   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1899   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1900   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1901   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1902   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1903   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1904       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1905   RUN ensure-broker.
     1906   THIS-PROCEDURE:ADM-DATA =
     1907        'ADM1.1~`':U +
     1908        'SmartObject~`':U +
     1909        'FRAME~`':U +
     1910        'NO ~`':U +
     1911        '~`':U +
     1912        '~`':U +
     1913        '~`':U +
     1914        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1915           + "~`":U +
     1916        'Layout,Hide-on-Init~`':U +
     1917        '~`':U +
     1918        '~`':U +
     1919        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1920        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1921            THEN "^^":U
     1922        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1923             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1924   PROCEDURE adm-apply-entry :
     1925     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1926   END PROCEDURE.
     1927   PROCEDURE adm-destroy :
     1928    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1929   END PROCEDURE.
     1930   PROCEDURE adm-disable :
     1931       DISABLE RECT-checks ByOperations WITH FRAME F-Main.
     1932       RUN dispatch ('disable-fields':U).
     1933       RUN set-attribute-list ('ENABLED=no':U).
     1934       RETURN.
     1935   END PROCEDURE.
     1936   PROCEDURE adm-edit-attribute-list :
     1937         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1938         RETURN.
     1939   END PROCEDURE.
     1940   PROCEDURE adm-enable :
     1941       ENABLE UNLESS-HIDDEN RECT-checks ByOperations WITH FRAME F-Main.
     1942       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1943       RUN set-attribute-list ('ENABLED=yes':U).
     1944       RETURN.
     1945   END PROCEDURE.
     1946   PROCEDURE adm-exit :
     1947        RUN notify ('exit':U).
     1948     RETURN.
     1949   END PROCEDURE.
     1950   PROCEDURE adm-hide :
     1951     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1952   END PROCEDURE.
     1953   PROCEDURE adm-initialize :
     1954     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1955   END PROCEDURE.
     1956   PROCEDURE adm-show-errors :
     1957       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1958       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1959           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1960       END.
     1961       RETURN.
     1962   END PROCEDURE.
     1963   PROCEDURE adm-UIB-mode :
     1964     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1965   END PROCEDURE.
     1966   PROCEDURE adm-view :
     1967     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1968   END PROCEDURE.
     1969   PROCEDURE dispatch :
     1970       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1971       RUN broker-dispatch IN adm-broker-hdl
     1972           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1973       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1974   END PROCEDURE.
     1975   PROCEDURE ensure-broker :
     1976   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1977   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1978   DO:
     1979       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1980       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1981   END.
     1982   END PROCEDURE.
     1983   PROCEDURE get-attribute :
     1984     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1985     RUN broker-get-attribute IN adm-broker-hdl
     1986         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1987     RETURN RETURN-VALUE.
     1988   END PROCEDURE.
     1989   PROCEDURE get-attribute-list :
     1990     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1991     RUN broker-get-attribute-list IN adm-broker-hdl
     1992         (INPUT THIS-PROCEDURE,
     1993          INPUT ?,
     1994          OUTPUT p-attr-list) NO-ERROR.
     1995     RETURN.
     1996   END PROCEDURE.
     1997   PROCEDURE new-state :
     1998     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1999     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2000     RETURN.
     2001   END PROCEDURE.
     2002   PROCEDURE notify :
     2003     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2004     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2005     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2006         RETURN "ADM-ERROR":U.
     2007     RETURN.
     2008   END PROCEDURE.
     2009   PROCEDURE set-attribute-list :
     2010     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2011     RUN ensure-broker.
     2012     RUN broker-set-attribute-list IN adm-broker-hdl
     2013         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2014     RETURN.
     2015   END PROCEDURE.
     2016   PROCEDURE set-position :
     2017       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2018       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2019       IF VALID-HANDLE(adm-object-hdl) THEN
     2020       DO:
     2021           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     2022           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     2023           DO:
     2024             IF p-row = 0 THEN p-row =
     2025               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     2026             IF p-col = 0 THEN p-col =
     2027               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     2028           END.
     2029           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     2030           DO:
     2031             parent-hdl = adm-object-hdl:PARENT.
     2032             IF p-row = 0 THEN p-row =
     2033               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     2034                 parent-hdl:ROW.
     2035             IF p-col = 0 THEN p-col =
     2036               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     2037                 parent-hdl:COL.
     2038           END.
     2039           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     2040           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     2041         ASSIGN adm-object-hdl:ROW    =   p-row
     2042                adm-object-hdl:COLUMN =   p-col.
     2043       END.
     2044       RETURN.
     2045   END PROCEDURE.
     2046   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2047       STRING(adm-object-hdl)).
     2048   PAUSE 0 BEFORE-HIDE.
     2049   PROCEDURE adm-change-page :
     2050     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2051     END PROCEDURE.
     2052   PROCEDURE delete-page :
     2053     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2054     RUN broker-delete-page IN adm-broker-hdl
     2055         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2056     END PROCEDURE.
     2057   PROCEDURE init-object :
     2058     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2059     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2060     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2061     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2062     RUN broker-init-object IN adm-broker-hdl
     2063         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2064          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2065     RETURN.
     2066   END PROCEDURE.
     2067   PROCEDURE init-pages :
     2068     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2069     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2070         INPUT p-page-list) NO-ERROR.
     2071     END PROCEDURE.
     2072   PROCEDURE select-page :
     2073     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     2074     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2075         INPUT p-page#) NO-ERROR.
     2076     END PROCEDURE.
     2077   PROCEDURE view-page :
     2078     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2079     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2080         INPUT p-page#).
     2081     END PROCEDURE.
     2082   ON VALUE-CHANGED OF ByOperations IN FRAME F-Main
     2083   DO:
     2084       assign ByOperations .
     2085   END.
     2086   if not this-procedure :persistent
     2087   then do:
     2088     message
     2089       vss-workfile vss-revision vss-description skip
     2090       "Ошибка при запуске процедуры" skip
     2091       "Данную процедуру следует запускать только с параметром persistent" skip
     2092       view-as alert-box error .
     2093     undo, return error .
     2094   end.
     2095   parparentproc = my-handle.
     2096   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2097     run mainmenu_getcntxt in parparentproc
     2098       (output v-cntxt-db-num
     2099       ,output v-cntxt-userid
     2100       ,output v-cntxt-level
     2101       ,output v-cntxt-host-code-obj
     2102       ,output v-cntxt-obj-type
     2103       ,output v-cntxt-obj-code
     2104       ,output v-cntxt-db-num-obj
     2105       ,output v-cntxt-is-admin
     2106       ) .
     2107   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2108   PROCEDURE no-benq.
     2109   DEFINE OUTPUT PARAMETER found as logical init no.
     2110   define buffer buf_chk-doc for ub.chk-doc.
     2111   FOR EACH obj-list WHERE
     2112           obj-list.obj-type = 'маг':U NO-LOCK :
     2113     CASE X-Radio-Task > 1 :
     2114       WHEN YES THEN DO:
     2115         FOR EACH buf_chk-doc NO-LOCK WHERE
     2116                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2117                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2118                 (
     2119                   buf_chk-doc.shift-date >= X-date-start AND
     2120                   buf_chk-doc.shift-date <= X-date-end)
     2121                   AND
     2122                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2123           IF X-Radio-Task = 3 AND
     2124           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     2125             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2126           IF X-Radio-Task = 4 AND
     2127           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2128           found = yes.
     2129           return.
     2130         END.
     2131       END.
     2132       WHEN NO THEN DO:
     2133         FOR EACH buf_chk-doc NO-LOCK WHERE
     2134               buf_chk-doc.obj-type = obj-list.obj-type AND
     2135               buf_chk-doc.obj-code = obj-list.obj-code AND
     2136               buf_chk-doc.chk-date >= X-date-start AND
     2137               buf_chk-doc.chk-date <= X-date-end   AND
     2138               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2139           found = yes.
     2140           return.
     2141         END.
     2142        END.
     2143      END CASE.
     2144    END.
     2145   END PROCEDURE.
     2146   PROCEDURE no-benqi.
     2147   DEFINE OUTPUT PARAMETER found as logical init no.
     2148   define buffer buf_chk-doc for ub.chk-doc.
     2149   define buffer buf_inkas for ub.inkas.
     2150   FOR EACH obj-list WHERE
     2151         obj-list.obj-type = 'маг':U NO-LOCK :
     2152     CASE X-Radio-Task > 1 :
     2153       WHEN YES THEN DO:
     2154         FOR EACH buf_chk-doc No-LOCK WHERE
     2155                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2156                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2157                 (
     2158                   buf_chk-doc.shift-date >= X-date-start AND
     2159                   buf_chk-doc.shift-date <= X-date-end)
     2160                   AND
     2161                   buf_Chk-doc.out-code = ? AND
     2162                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2163           IF X-Radio-Task = 3 AND
     2164           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     2165             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2166           IF X-Radio-Task = 4 AND
     2167           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2168           found = yes.
     2169           return.
     2170         END.
     2171         FOR EACH buf_inkas No-LOCK WHERE
     2172                   buf_inkas.obj-type = obj-list.obj-type AND
     2173                   buf_inkas.obj-code = obj-list.obj-code AND
     2174                   (
     2175                   buf_inkas.shift-date >= X-date-start AND
     2176                   buf_inkas.shift-date <= X-date-end):
     2177           if buf_inkas.status_ = 'факт':U
     2178           or buf_inkas.status_ = 'запрос':U then next.
     2179           IF X-Radio-Task = 3 AND
     2180           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     2181             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     2182           IF X-Radio-Task = 4 AND
     2183           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     2184           found = yes.
     2185           return.
     2186         END.
     2187       END.
     2188       WHEN NO THEN DO:
     2189         FOR EACH buf_chk-doc NO-LOCK WHERE
     2190                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2191                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2192                 buf_chk-doc.chk-date >= X-date-start AND
     2193                 buf_chk-doc.chk-date <= X-date-end   AND
     2194                 buf_Chk-doc.out-code = ? AND
     2195                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2196           found = yes.
     2197           return.
     2198         END.
     2199         FOR EACH buf_inkas NO-LOCK WHERE
     2200                 buf_inkas.obj-type = obj-list.obj-type AND
     2201                 buf_inkas.obj-code = obj-list.obj-code AND
     2202                 buf_inkas.doc-date >= X-date-start AND
     2203                 buf_inkas.doc-date <= X-date-end :
     2204           if buf_inkas.status_ = 'факт':U
     2205           or buf_inkas.status_ = 'запрос':U then next.
     2206           found = yes.
     2207           return.
     2208         END.
     2209       END.
     2210     END CASE.
     2211   END.
     2212   END PROCEDURE.
     2213   PROCEDURE no-benq-i.
     2214   DEFINE OUTPUT PARAMETER found as logical init no.
     2215   define buffer buf_inkas for ub.inkas.
     2216   CASE X-Radio-Task > 1:
     2217     WHEN YES then do:
     2218       FOR EACH obj-list WHERE
     2219               obj-list.obj-type = 'маг':U NO-LOCK :
     2220         FOR EACH buf_inkas NO-LOCK WHERE
     2221                 buf_inkas.obj-type = obj-list.obj-type AND
     2222                 buf_inkas.obj-code = obj-list.obj-code AND
     2223                 buf_inkas.status_ = 'факт':U AND
     2224                 (
     2225                 buf_inkas.shift-date >= X-date-start AND
     2226                 buf_inkas.shift-date <= X-date-end):
     2227           IF X-Radio-Task = 3 AND
     2228           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     2229             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     2230           IF X-Radio-Task = 4 AND
     2231           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     2232           found = yes.
     2233           return.
     2234         END.
     2235     END.
     2236     END.
     2237     WHEN NO THEN DO:
     2238       FOR EACH obj-list WHERE
     2239               obj-list.obj-type = 'маг':U NO-LOCK :
     2240         FOR EACH buf_inkas NO-LOCK WHERE
     2241                 buf_inkas.obj-type = obj-list.obj-type AND
     2242                 buf_inkas.obj-code = obj-list.obj-code AND
     2243                 buf_inkas.status_ = 'факт':U AND
     2244                 buf_inkas.doc-date >= X-date-start AND
     2245                 buf_inkas.doc-date <= X-date-end :
     2246            found = yes.
     2247            return.
     2248         END.
     2249       END.
     2250     END.
     2251   END CASE.
     2252   END PROCEDURE.
     2253   PROCEDURE no-benq-i-office.
     2254   DEFINE OUTPUT PARAMETER found as logical init no.
     2255   define buffer buf_sale-doc for ub.sale-doc.
     2256   CASE X-Radio-Task > 1:
     2257     WHEN YES then do:
     2258       FOR EACH obj-list WHERE
     2259               obj-list.obj-type = 'маг':U NO-LOCK :
     2260         FOR EACH buf_sale-doc NO-LOCK WHERE
     2261                  buf_Sale-doc.obj-type = obj-list.obj-type
     2262              AND buf_sale-doc.obj-code = obj-list.obj-code
     2263              AND buf_sale-doc.status_ = 'факт':U
     2264              AND buf_sale-doc.chr-office = 'у':U
     2265              AND (
     2266                 buf_sale-doc.shift-date >= X-date-start
     2267                 AND
     2268                 buf_sale-doc.shift-date <= X-date-end):
     2269           IF X-Radio-Task = 3 AND
     2270           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     2271             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     2272           IF X-Radio-Task = 4 AND
     2273           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2274           found = yes.
     2275           return.
     2276         END.
     2277       END.
     2278     END.
     2279     WHEN NO THEN DO:
     2280       FOR EACH obj-list WHERE
     2281               obj-list.obj-type = 'маг':U NO-LOCK :
     2282         FOR EACH buf_sale-doc NO-LOCK WHERE
     2283                 buf_sale-doc.obj-type = obj-list.obj-type
     2284            AND  buf_sale-doc.obj-code = obj-list.obj-code
     2285            AND  buf_sale-doc.status_ = 'факт':U
     2286            AND  buf_sale-doc.chr-office = 'у':U
     2287            AND  buf_sale-doc.doc-date >= X-date-start
     2288            AND  buf_sale-doc.doc-date <= X-date-end :
     2289           found = yes.
     2290           return.
     2291         END.
     2292       END.
     2293     END.
     2294   END CASE.
     2295   END PROCEDURE.
     2296   PROCEDURE adm-create-objects :
     2297   END PROCEDURE.
     2298   PROCEDURE adm-row-available :
     2299     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2300     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2301     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2302     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2303     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2304     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2305     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2306     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2307     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2308     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2309     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2310     IF adm-updating-record THEN RETURN.
     2311     RUN get-attribute ('FIELDS-ENABLED':U).
     2312     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2313     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2314         OUTPUT link-handle) NO-ERROR.
     2315     IF link-handle = "":U THEN
     2316         RETURN.
     2317     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2318     IF NUM-ENTRIES(link-handle) > 1 THEN
     2319         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2320             "encountered more than one RECORD-SOURCE.":U SKIP
     2321             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2322                VIEW-AS ALERT-BOX ERROR.
     2323     RUN get-attribute ('Key-Name':U).
     2324     key-name = RETURN-VALUE.
     2325     IF key-name = "":U THEN key-name = ?.
     2326     IF key-name NE ? THEN DO:
     2327       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2328         NO-ERROR.
     2329       IF key-value NE ? THEN
     2330         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2331     END.
     2332   IF VALID-HANDLE (adm-object-hdl) THEN
     2333       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2334   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2335   END PROCEDURE.
     2336   PROCEDURE disable_UI :
     2337     HIDE FRAME F-Main.
     2338     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2339   END PROCEDURE.
     2340   PROCEDURE enable_UI :
     2341     DISPLAY ByOperations
     2342         WITH FRAME F-Main.
     2343     ENABLE RECT-checks ByOperations
     2344         WITH FRAME F-Main.
     2345   END PROCEDURE.
     2346   PROCEDURE My-Report :
     2347   DEFINE VARIABLE Line                as      char    no-undo.
     2348   DEFINE VARIABLE date_string     as      char    no-undo.
     2349   DEFINE VARIABLE v-b-code like ub.bar-code.b-code no-undo .
     2350   DEFINE VARIABLE v-grp-name like ub.goods.grp-name no-undo .
     2351   DEFINE VARIABLE v-node-name like ub.gds-prt.f-name no-undo .
     2352   DEFINE VARIABLE v-root-name like ub.gds-prt.node-name no-undo .
     2353   DEFINE VARIABLE v-artic like ub.goods.artic no-undo .
     2354   DEFINE VARIABLE v-prod-type like ub.goods.prod-type no-undo .
     2355   DEFINE VARIABLE v-prod-code as character no-undo .
     2356   DEFINE VARIABLE v-fact-order like ub.price-list.fact-order no-undo .
     2357   DEFINE VARIABLE v-ini-fact-order like ub.price-list.fact-order no-undo .
     2358   DEFINE VARIABLE v-start-fact-order like ub.price-list.fact-order no-undo .
     2359   DEFINE VARIABLE v-end-fact-order like ub.price-list.fact-order no-undo .
     2360   DEFINE VARIABLE v-doc-time like ub.chk-doc.chk-time no-undo .
     2361   DEFINE VARIABLE v-price-sale like ub.price-list.price-sale no-undo .
     2362   DEFINE VARIABLE v-road-tax like ub.price-list.road-tax no-undo .
     2363   DEFINE VARIABLE v-excise like ub.price-list.excise no-undo .
     2364   DEFINE VARIABLE v-doc-num like ub.price-list.doc-num no-undo .
     2365   DEFINE VARIABLE v-prod-name like ub.clients.obj-name no-undo .
     2366   DEFINE VARIABLE v-chk-sum as decimal no-undo .
     2367   DEFINE VARIABLE v-price-list-sum as decimal no-undo .
     2368   DEFINE VARIABLE v-chk-sum-r as decimal no-undo .
     2369   DEFINE VARIABLE v-price-list-sum-r as decimal no-undo .
     2370   DEFINE VARIABLE v-chk-sum-v as decimal no-undo .
     2371   DEFINE VARIABLE v-price-list-sum-v as decimal no-undo .
     2372   define variable g#report-num as integer no-undo .
     2373   DEFINE VARIABLE v-add as logical no-undo.
     2374   DEFINE VARIABLE found as logical init yes no-undo .
     2375   DEFINE VARIABLE v-found as logical no-undo .
     2376   DEFINE VARIABLE NotInc as logical no-undo .
     2377   define buffer buf_chk-doc for ub.chk-doc.
     2378   define buffer root_gds-prt for ub.gds-prt.
     2379   define buffer buf_chk-gds for ub.chk-gds.
     2380   define buffer buf_price-list for ub.price-list.
     2381   define buffer buf_price-doc for ub.price-doc.
     2382   define buffer buf_clients for ub.clients.
     2383   define buffer buf_goods for ub.goods.
     2384   define buffer buf_bar-code for ub.bar-code.
     2385   run no-benq(output found).
     2386   if NOT found then do:
     2387     run waitfram-hide in this-procedure.
     2388     message "Не было никакой выручки  в течение заданного Вами периода времени." view-as alert-box.
     2389     return.
     2390   end.
     2391   do
     2392   on error undo, return error
     2393   :
     2394     assign
     2395     Sheetf.ColFOrmat = '5=@;15=@;16=dd/mm/yyyy'
     2396     .
     2397     run day-begin-fact-order in this-procedure(
     2398                                                 input  01/01/1990
     2399                                                ,output v-ini-fact-order
     2400                                               ) .
     2401     run waitfram-show in this-procedure ("Ждите...").
     2402     assign
     2403     sheetf.Excel-Column-Lable =
     2404     "ГРУППА ТОВАРОВ"  + chr(44) +
     2405     "ГЛАВНЫЙ КОД ТОВАРА"  + chr(44) +
     2406     "БАР-КОД ПРИЗНАКА"  + chr(44) +
     2407     "ШКАЛА/ПРИЗНАК"  + chr(44) +
     2408     "АРТИКУЛ"  + chr(44) +
     2409     "ПР-ЛЬ"  + chr(44) +
     2410     "НАЗВАНИЕ ПРОИЗВОДИТЕЛЯ"  + chr(44) +
     2411     "КОЛИЧЕСТВО"  + chr(44) +
     2412     "ЦЕНА В ЧЕКЕ"  + chr(44) +
     2413     "ЦЕНА ПО ПРАЙС-ЛИСТУ"  + chr(44) +
     2414     "СУММА ПО ЧЕКУ" + chr(44) +
     2415     "СУММА С ЦЕНОЙ ПРАЙС-ЛИСТА" + chr(44) +
     2416     "РАЗНИЦА (СУММА ПО ЧЕКУ - СУММА С ЦЕНОЙ ПРАЙС-ЛИСТА))" + chr(44) +
     2417     "КОД КАССИРА"  + chr(44) +
     2418     "НОМЕР ЧЕКА"  + chr(44) +
     2419     "ДАТА ЧЕКА"
     2420     sheetf.sizes =
     2421     "100"  + chr(44) +
     2422     "16"  + chr(44) +
     2423     "15"  + chr(44) +
     2424     "100"  + chr(44) +
     2425     "16"  + chr(44) +
     2426     "12"  + chr(44) +
     2427     "40"  + chr(44) +
     2428     "16"  + chr(44) +
     2429     "16"  + chr(44) +
     2430     "16"  + chr(44) +
     2431     "16"  + chr(44) +
     2432     "16"  + chr(44) +
     2433     "16"  + chr(44) +
     2434     "16"  + chr(44) +
     2435     "25"  + chr(44) +
     2436     "10"
     2437     str1 = string(( if NotInc
     2438                     then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )"
     2439                     else " " ), "X(40)")
     2440     str3 = " "
     2441     .
     2442     run rep/extitle.p (1) .
     2443     FOR EACH obj-list No-LOCK:
     2444       assign
     2445       v-chk-sum           = 0
     2446       v-price-list-sum    = 0
     2447       v-chk-sum-r         = 0
     2448       v-price-list-sum-r  = 0
     2449       v-chk-sum-v         = 0
     2450       v-price-list-sum-v  = 0
     2451       .
     2452       FIND FIRST buf_clients NO-LOCK WHERE
     2453                   buf_clients.obj-type = obj-list.obj-type AND
     2454                   buf_clients.obj-code = obj-list.obj-code No-ERROR.
     2455       if Make-Excel then  put   stream ForExcel unformatted
     2456       (IF AVAIL buf_clients
     2457         then buf_clients.obj-name
     2458         else ("Магазин N " + string(obj-list.obj-code))
     2459       )
     2460       SKIP.
     2461     _chk-gds:
     2462       FOR EACH buf_chk-doc No-LOCK WHERE
     2463                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2464                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2465                 buf_chk-doc.out-code <> ? AND
     2466                 buf_chk-doc.chk-date >= X-date-start AND
     2467                 buf_chk-doc.chk-date <= X-date-end:
     2468         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     2469         if ByOperations = - 1 and buf_chk-doc.netto >= 0 then NEXT.
     2470         if ByOperations = 1 and buf_chk-doc.netto < 0 then NEXT.
     2471         run day-begin-fact-order in this-procedure(
     2472                                                     input  buf_chk-doc.chk-date
     2473                                                     ,output v-start-fact-order
     2474                                                   ) .
     2475         run day-begin-fact-order in this-procedure(
     2476                                                     input  (buf_chk-doc.chk-date + 1)
     2477                                                     ,output v-end-fact-order
     2478                                                   ) .
     2479         FOR EACH buf_chk-gds No-LOCK WHERE
     2480                 buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     2481             FIRST buf_bar-code No-LOCK WHERE
     2482                   buf_bar-code.b-code = buf_chk-gds.b-code:
     2483           ACCUMULATE buf_chk-gds.doc-code (COUNT).
     2484           assign
     2485           v-b-code = ?
     2486           .
     2487   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2488     (input  buf_bar-code.gds-code
     2489     ,input  ?
     2490     ,output v-b-code
     2491     ) no-error .
     2492           assign
     2493           v-doc-time = 0
     2494           v-fact-order = v-start-fact-order
     2495           v-add = yes
     2496           v-found = no
     2497           .
     2498           FOR EACH buf_price-list No-LOCK WHERE
     2499                     buf_price-list.obj-type = obj-list.obj-type AND
     2500                     buf_price-list.obj-code = obj-list.obj-code AND
     2501                     buf_price-list.b-code = v-b-code AND
     2502                     buf_price-list.price-type = "":U AND
     2503                     buf_price-list.fact-order >= v-start-fact-order AND
     2504                     buf_price-list.fact-order < v-end-fact-order use-index fact-close,
     2505               first buf_price-doc No-LOCK where
     2506                     buf_price-doc.doc-num = buf_price-list.doc-num :
     2507             if v-doc-time < buf_chk-doc.chk-time and
     2508                buf_price-doc.fact-time > buf_chk-doc.chk-time and
     2509                v-doc-time <> 0 then do:
     2510               assign
     2511               v-fact-order = buf_price-list.fact-order
     2512               v-add = no
     2513               .
     2514               LEAVE.
     2515             end.
     2516             assign
     2517             v-doc-time = buf_price-doc.fact-time
     2518             v-fact-order = buf_price-list.fact-order
     2519             v-found = yes
     2520             .
     2521           END.
     2522           if NOT (FOUND and v-doc-time < buf_chk-doc.chk-time) and
     2523               not available buf_price-list then do:
     2524             FIND LAST buf_price-list No-LOCK WHERE
     2525                       buf_price-list.obj-type = obj-list.obj-type AND
     2526                       buf_price-list.obj-code = obj-list.obj-code AND
     2527                       buf_price-list.b-code = v-b-code AND
     2528                       buf_price-list.fact-order < v-start-fact-order AND
     2529                       buf_price-list.price-type = "":U use-index fact-close no-error .
     2530             if available buf_price-list then do:
     2531               assign
     2532               v-fact-order = buf_price-list.fact-order
     2533               .
     2534             end.
     2535             else do:
     2536               assign
     2537               v-fact-order = v-ini-fact-order
     2538               .
     2539             end.
     2540           end.
     2541           assign
     2542           v-price-sale = ?
     2543           v-fact-order = v-fact-order + (if v-add = no then 0 else 0.0000000001)
     2544           .
     2545   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2547     (input  obj-list.obj-type
     2548     ,input  obj-list.obj-code
     2549     ,input  buf_chk-gds.b-code
     2550     ,input  v-b-code
     2551     ,input  v-fact-order
     2552     ,output v-doc-num
     2553     ,output v-price-sale
     2554     ,output v-road-tax
     2555     ,output v-excise
     2556     ) no-error .
     2557           if v-price-sale = ? or
     2558             v-price-sale <> buf_chk-gds.price-base then do:
     2559             find first ub.gds-prt No-LOCK WHERE
     2560                       ub.gds-prt.node-code = ub.bar-code.node-code no-error .
     2561             if avail ub.gds-prt then do:
     2562               assign
     2563               v-node-name =  ub.gds-prt.f-name
     2564               .
     2565             end.
     2566             else do:
     2567               assign
     2568               v-node-name ="?":U
     2569               .
     2570             end.
     2571             FIND FIRST buf_goods no-lock where
     2572                       buf_goods.gds-code = bar-code.gds-code No-error.
     2573             if avail buf_goods then do:
     2574               assign
     2575               v-grp-name = buf_goods.grp-name
     2576               v-artic = buf_goods.artic
     2577               v-prod-type = buf_goods.prod-type
     2578               v-prod-code = string(buf_goods.prod-code)
     2579               .
     2580               find first root_gds-prt no-lock where
     2581                         root_gds-prt.upper-code = buf_goods.prt-root no-error .
     2582               if available root_gds-prt then do:
     2583                 assign
     2584                 v-root-name = root_gds-prt.node-name
     2585                 .
     2586               end.
     2587               else do:
     2588                 assign
     2589                 v-root-name = "?":U
     2590                 .
     2591               end.
     2592               find first buf_clients no-lock where
     2593                          buf_clients.obj-type = buf_goods.prod-type AND
     2594                          buf_clients.obj-code = buf_goods.prod-code no-error .
     2595               if avail buf_clients then do:
     2596                 assign
     2597                 v-prod-name = string(buf_clients.obj-name, "X(40)")
     2598                 .
     2599               end.
     2600               else do:
     2601                 assign
     2602                 v-prod-name = "?":U
     2603                 .
     2604               end.
     2605             end.
     2606             else do:
     2607               assign
     2608               v-grp-name = "?":U
     2609               v-root-name = "?":U
     2610               .
     2611             end.
     2612             if Make-Excel then  put   stream ForExcel unformatted
     2613             v-grp-name  CHR(9)
     2614             v-b-code CHR(9)
     2615             buf_chk-gds.b-code CHR(9)
     2616             (v-root-name + (if v-node-name = "":U then "":U else chr(47)) + v-node-name) CHR(9)
     2617             v-artic CHR(9)
     2618             v-prod-type + string(v-prod-code) CHR(9)
     2619             v-prod-name CHR(9)
     2620             buf_chk-gds.doc-qnty CHR(9)
     2621             buf_chk-gds.price-base CHR(9)
     2622             v-price-sale CHR(9)
     2623             buf_chk-gds.price-base * buf_chk-gds.doc-qnty CHR(9)
     2624             v-price-sale * buf_chk-gds.doc-qnty CHR(9)
     2625             (buf_chk-gds.price-base *  abs(buf_chk-gds.doc-qnty)  - v-price-sale *  abs(buf_chk-gds.doc-qnty))   CHR(9)
     2626             buf_chk-doc.cashier CHR(9)
     2627             buf_chk-doc.doc-code  CHR(9)
     2628             string(buf_chk-doc.chk-date, "99/99/9999")
     2629             SKIP
     2630             .
     2631             assign
     2632             v-chk-sum = v-chk-sum + buf_chk-gds.price-base * (buf_chk-gds.doc-qnty )
     2633             v-price-list-sum = v-price-list-sum +
     2634                                (if v-price-sale <> ?
     2635                                 then v-price-sale * ( buf_chk-gds.doc-qnty )
     2636                                 else 0)
     2637             .
     2638             if buf_chk-doc.netto >= 0 then do:
     2639               assign
     2640               v-chk-sum-r = v-chk-sum-r + buf_chk-gds.price-base * ( buf_chk-gds.doc-qnty )
     2641               v-price-list-sum-r = v-price-list-sum-r +
     2642                                 (if v-price-sale <> ?
     2643                                   then v-price-sale * ( buf_chk-gds.doc-qnty )
     2644                                   else 0)
     2645               .
     2646             end.
     2647             else do:
     2648               assign
     2649               v-chk-sum-v = v-chk-sum-v + buf_chk-gds.price-base * ( buf_chk-gds.doc-qnty )
     2650               v-price-list-sum-v = v-price-list-sum-v +
     2651                                 (if v-price-sale <> ?
     2652                                   then v-price-sale * ( buf_chk-gds.doc-qnty )
     2653                                   else 0)
     2654               .
     2655             end.
     2656           end.
     2657           IF (ACCUM COUNT buf_chk-gds.doc-code) MODULO 50 = 0 then
     2658           run waitfram-show in this-procedure ("Ждите..." + "Объект " + string(obj-list.obj-code) + " Обработано " +
     2659                         string(ACCUM COUNT buf_chk-gds.doc-code) + " строк чеков").
     2660         END.
     2661       END.
     2662       if ByOperations = 0 or
     2663        ByOperations = 1 then do:
     2664         if Make-Excel then  put   stream ForExcel unformatted
     2665         "ИТОГО по чекам расхода"
     2666         CHR(9)
     2667         CHR(9)
     2668         CHR(9)
     2669         CHR(9)
     2670         CHR(9)
     2671         CHR(9)
     2672         CHR(9)
     2673         CHR(9)
     2674         CHR(9)
     2675         CHR(9)
     2676         v-chk-sum-r CHR(9)
     2677         v-price-list-sum-r CHR(9)
     2678         v-chk-sum-r - v-price-list-sum-r CHR(9)
     2679         CHR(9)
     2680         CHR(9)
     2681         SKIP
     2682         .
     2683       end.
     2684       if ByOperations = 0 or
     2685        ByOperations = 2 then do:
     2686         if Make-Excel then  put   stream ForExcel unformatted
     2687         "ИТОГО по чекам возврата"
     2688         CHR(9)
     2689         CHR(9)
     2690         CHR(9)
     2691         CHR(9)
     2692         CHR(9)
     2693         CHR(9)
     2694         CHR(9)
     2695         CHR(9)
     2696         CHR(9)
     2697         CHR(9)
     2698         v-chk-sum-v CHR(9)
     2699         v-price-list-sum-v CHR(9)
     2700         (- (v-chk-sum-v - v-price-list-sum-v)) CHR(9)
     2701         CHR(9)
     2702         CHR(9)
     2703         SKIP
     2704         .
     2705       end.
     2706       if ByOperations = 0 then do:
     2707         if Make-Excel then  put   stream ForExcel unformatted
     2708         "ИТОГО по чекам расхода и возврата"
     2709         CHR(9)
     2710         CHR(9)
     2711         CHR(9)
     2712         CHR(9)
     2713         CHR(9)
     2714         CHR(9)
     2715         CHR(9)
     2716         CHR(9)
     2717         CHR(9)
     2718         CHR(9)
     2719         v-chk-sum CHR(9)
     2720         v-price-list-sum CHR(9)
     2721         v-chk-sum - v-price-list-sum CHR(9)
     2722         CHR(9)
     2723         CHR(9)
     2724         SKIP
     2725         .
     2726       end.
     2727     END.
     2728     if Make-Excel then output stream ForExcel close.
     2729   end.
     2730   run waitfram-hide in this-procedure.
     2731   run get-report-num  in parParentProc(output  g#report-num).
     2732   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     2733   END PROCEDURE.
     2734   PROCEDURE My-var :
     2735    assign
     2736    FRAME F-Main ByOperations
     2737    .
     2738   Assign
     2739    STR-obj-type = ''
     2740    STR-obj-code = ''
     2741    STR-obj-name = ''
     2742    STR-obj      = ''.
     2743   For each obj-list no-lock:
     2744    Assign
     2745    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2746    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2747    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2748    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2749   End.
     2750   ReportHeader =
     2751                  "Операции : " + (if ByOperations = 0
     2752                                   then "Продажи + возвраты"
     2753                                   else if ByOperations = 1
     2754                                        then "Продажи"
     2755                                        else "Возвраты")
     2756                  .
     2757   END PROCEDURE.
     2758   PROCEDURE send-records :
     2759   END PROCEDURE.
     2760   PROCEDURE state-changed :
     2761     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2762     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2763   END PROCEDURE.
