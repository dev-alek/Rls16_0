      667   define  shared  variable loc-store-code like ub.ord-doc.obj-code no-undo .
      668   define  shared  variable loc-store-type like ub.ord-doc.obj-type no-undo .
      669   define  shared  variable loc-doc-type   like ub.ord-doc.doc-type no-undo .
      670   define  shared  variable temp-e-method  as character no-undo .
      671   define  shared  variable x-tog-artic as logical   no-undo .
      672   define  shared  variable x-tog-grp    as logical   no-undo .
      673   define input parameter ord-line-fact-qnty like ub.ord-line.qnty no-undo .
      674   define input parameter ord-line-cli-qnty  like ub.ord-line.cli-qnty no-undo .
      675   define buffer b-ord-line     for Tmp#zakaz1.
      676   define buffer b-ord-gds-dtl  for Tmp#zakaz-dtl1.
      677   DEFINE QUERY br-dtl FOR b-ord-gds-dtl, ub.gds-prt, ub.goods, ub.bar-code SCROLLING.
      678   def work-table prt-tree no-undo
      679     field bc        like ub.bar-code.b-code    format "9999999999" column-label "Осн. код"
      680     field n-code    like ub.gds-prt.node-code
      681     field n-name    like ub.gds-prt.node-name
      682     field rid       as   recid
      683     field visible   as   log
      684     field exp       as   log
      685     field is-term   like ub.gds-prt.is-term
      686     field is-root   like ub.gds-prt.root
      687     field level     as   integer
      688     field mark      as   char
      689     field doc-amnt  like ub.gds-dtl.doc-qnty   format "->>>,>>>,>>>.<<<" init 0 column-label "Заказ(ед.баз.)"
      690     field cli-amnt  like ub.gds-dtl.fact-qnty  format "->>>,>>>,>>>.<<<" init 0 column-label "Заказ(ед.пост)"
      691     field free-qnty like ub.prt-obj.free-qnty  format "->>>,>>>,>>>.<<<" init 0 column-label "Свободно"
      692     field fact-qnty like ub.prt-obj.fact-qnty  format "->>>,>>>,>>>.<<<" init 0 column-label "Остаток"
      693     field price     like ub.prt-obj.price-sale format ">>>,>>>,>>9.99"   init ? column-label "Цена на объекте"
      694     field price-r-b like ub.gds-dtl.price-rubl format ">>>,>>>,>>9.99"   init ? column-label "Цена заказа"
      695     .
      696   define variable tree-level  as   integer           no-undo.
      697   define variable gds-prt-row as   integer init 1    no-undo.
      698   define variable old_qnty    like ub.doc-line.doc-qnty no-undo.
      699   define variable shift-name  as   char              no-undo.
      700   define variable flt-amnt    as   log               no-undo.
      701   define variable rec-list    as   char              no-undo.
      702   define variable print-option as character no-undo.
      703   define variable varr-b as character no-undo.
      704   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      705   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      706     (output varr-b
      707     )  .
      708   FUNCTION fnc-shift-name RETURN char (cur-lev  as integer,
      709                                        cur-mark as char,
      710                                        cur-name as char).
      711     return (fill ("  ", cur-lev) +
      712             cur-mark +
      713             " " +
      714             cur-name).
      715   END FUNCTION.
      716   def  query   br-gds-prt for prt-tree SCROLLING.
      717   def  browse  br-gds-prt
      718          query br-gds-prt
      719          disp
      720          fnc-shift-name (prt-tree.level, prt-tree.mark, prt-tree.n-name) @ shift-name
      721          format "x(23)" column-label "Признак"
      722          prt-tree.doc-amnt
      723          prt-tree.cli-amnt
      724          prt-tree.price-r-b
      725          prt-tree.free-qnty
      726          prt-tree.fact-qnty
      727          prt-tree.price
      728          prt-tree.bc
      729   WITH SIZE 93 BY 15 separators.
      730   DEFINE BUTTON b-exit AUTO-go
      731        LABEL "&Выход ":L
      732        SIZE 9 BY 1.
      733   DEFINE BUTTON b-sel AUTO-go
      734        LABEL "Вы&бор ":L
      735        SIZE 9 BY 1.
      736   DEFINE BUTTON b-del
      737        LABEL "&Удалить ":L
      738        SIZE 9 BY 1.
      739   DEFINE BUTTON b-exp-nd
      740        LABEL "&>>":L
      741        SIZE 4.5 BY 1.
      742   DEFINE BUTTON b-exp-tree
      743        LABEL ">>&->>":L
      744        SIZE 9 BY 1.
      745   DEFINE BUTTON b-amnt
      746        LABEL "&Колич":L
      747        SIZE 9 BY 1.
      748   DEFINE BUTTON b-codes
      749        LABEL "&Коды":L
      750        SIZE 9 BY 1.
      751   DEFINE MENU m-alt
      752          MENU-ITEM m-alt-current  LABEL "Существующие неосновные цены"
      753          MENU-ITEM m-alt-all      LABEL "Все неосновные коды"
      754          rule
      755          MENU-ITEM m-prod-all     LABEL "Дополнительные коды"
      756          .
      757   DEFINE MENU MENU-b-print
      758          MENU-ITEM m_hor          LABEL "Уровни по горизонтали"
      759          MENU-ITEM m_vert         LABEL "Уровни по вертикали"
      760          .
      761   DEFINE BUTTON b-alt
      762        LABEL "&Неос/Доп":L
      763        SIZE 9 BY 1.
      764   DEFINE BUTTON b-rest
      765        LABEL "&Остатки":L
      766        SIZE 9 BY 1.
      767   DEFINE MENU m-inf
      768          MENU-ITEM m-inf-prt      LABEL "По признаку"
      769          MENU-ITEM m-inf-gds      LABEL "По товару"
      770          .
      771   DEFINE BUTTON b-info
      772        LABEL "&Архив":L
      773        SIZE 9 BY 1.
      774   DEFINE BUTTON b-print
      775        LABEL "Пе&чать":L
      776        SIZE 9 BY 1.
      777   DEFINE BUTTON b-help
      778        LABEL "Помо&щь":L
      779        SIZE 9 BY 1.
      780   DEFINE FRAME d-gds-prt
      781     b-exit     AT ROW 1.25  COL 1
      782     b-sel      AT ROW 1.25  COL 10
      783     b-del      AT ROW 1.25  COL 19
      784     b-exp-nd   AT ROW 1.25  COL 28
      785     b-exp-tree AT ROW 1.25  COL 32.5
      786     b-amnt     AT ROW 1.25  COL 41.5
      787     b-codes    AT ROW 1.25  COL 50.5
      788     b-alt      AT ROW 1.25  COL 59.5
      789     b-rest     AT ROW 1.25  COL 68.5
      790     b-info     AT ROW 1.25  COL 77.5
      791     b-print    AT ROW 1.25  COL 76.5
      792     b-help     AT ROW 1.25  COL 78.5
      793      ord-line-cli-qnty   at row 2.5   col 10  label "Заказ(ед.пост)"  format "->>>,>>>,>>9.<<<"
      794      ord-line-fact-qnty  at row 2.5   col 39  label "Заказ"           format "->>>,>>>,>>9.<<<"
      795     ub.goods.unit-base at row 2.5   col 70  no-label      format "x(3)"
      796     flt-amnt        at row 3.5   col 5   label "Только с количествами" view-as toggle-box
      797     br-gds-prt      AT ROW 4.5   COL 2
      798     WITH size 96 by 21 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      799     ASSIGN
      800     b-print:POPUP-MENU IN FRAME d-gds-prt       = MENU MENU-b-print:HANDLE.
      801     br-gds-prt :set-repositioned-row (10, "conditional").
      802     b-print:MENU-MOUSE in frame d-gds-prt  = 1.
      803     ASSIGN
      804       FRAME d-gds-prt:SCROLLABLE = FALSE
      805       b-info    :POPUP-MENU IN FRAME d-gds-prt         = MENU m-inf  :HANDLE
      806       b-info    :MENU-MOUSE                                = 1
      807       b-alt     :POPUP-MENU IN FRAME d-gds-prt         = MENU m-alt  :HANDLE
      808       b-alt     :MENU-MOUSE                                = 1
      809       .
      810   on value-changed of flt-amnt do:
      811     gds-prt-row = current-result-row ("br-gds-prt").
      812     find first prt-tree.
      813     if input frame d-gds-prt flt-amnt then
      814       run exp-tree.
      815       run UI-on.
      816   end.
      817   on row-display of br-gds-prt do:
      818     if prt-tree.is-root then
      819       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      820     else
      821       if not prt-tree.is-term then
      822         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      823   end.
      824   ON CHOOSE OF b-exit IN FRAME d-gds-prt  DO:
      825     prt-rec = prt-tree.rid.
      826     return "exit":U.
      827   END.
      828   ON CHOOSE OF b-sel IN FRAME d-gds-prt  DO:
      829     prt-rec = prt-tree.rid.
      830   END.
      831   ON choose of b-del IN FRAME d-gds-prt DO:
      832      def var gds-prt-recid as recid   no-undo.
      833      def var chg-qnty      as decimal no-undo.
      834   END.
      835   ON choose of b-exp-nd IN FRAME d-gds-prt DO:
      836     gds-prt-row = current-result-row ("br-gds-prt").
      837     run exp-nd (?).
      838     run UI-on.
      839   END.
      840   ON choose of b-exp-tree IN FRAME d-gds-prt DO:
      841     gds-prt-row = current-result-row ("br-gds-prt").
      842     run exp-tree.
      843     run UI-on.
      844   END.
      845   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME d-gds-prt DO:
      846     gds-prt-row = current-result-row ("br-gds-prt").
      847     if prt-tree.is-term then do:
      848       if b-amnt:sensitive then
      849         apply "choose" to b-amnt in frame d-gds-prt.
      850     end.
      851     else
      852       apply "choose" to b-exp-nd in frame d-gds-prt.
      853     return no-apply.
      854   END.
      855   ON CHOOSE OF b-amnt IN FRAME d-gds-prt  DO:
      856     DEFINE VARIABLE rid-list as character no-undo .
      857     gds-prt-row = current-result-row ("br-gds-prt").
      858     if not prt-tree.is-root and
      859        not prt-tree.is-term then do:
      860       message "Данный признак промежуточный и не может быть выбран."
      861               view-as alert-box error.
      862       return no-apply.
      863     end.
      864       if "ord" = "rcv" then do:
      865       run cus/rcv-prt.w
      866                    ( parParentProc ,
      867                      doc-rec       ,
      868                      line-rec      ,
      869                      gds-rec       ,
      870                      prt-mode      ,
      871                      prt-tree.rid  ,
      872                     ( if prt-tree.is-term then  'терм':U  else   'корн':U )
      873                      ) no-error.
      874       end.
      875       if "ord" = "ord" then do:
      876       run cus/ord-prt.w
      877                    ( parParentProc ,
      878                      doc-rec       ,
      879                      line-rec      ,
      880                      gds-rec       ,
      881                      prt-mode      ,
      882                      prt-tree.rid  ,
      883                     ( if prt-tree.is-term then  'терм':U else   'корн':U )
      884                     ) no-error.
      885       end.
      886     if not error-status:error then do:
      887       run clc-nd (buffer prt-tree).
      888       disp
      889             prt-tree.doc-amnt prt-tree.cli-amnt prt-tree.price-r-b
      890             prt-tree.bc
      891             with browse br-gds-prt.
      892       find first prt-tree.
      893       run calc-tree (output prt-tree.doc-amnt, output prt-tree.cli-amnt).
      894       run ui-on.
      895     end.
      896   END.
      897   ON CHOOSE OF b-codes IN FRAME d-gds-prt do:
      898     run cre-code no-error.
      899     if error-status :error then
      900       return no-apply.
      901     prt-rec = prt-tree.rid.
      902     run ref/alt-bc.w (
      903                   input parParentProc
      904                 , input store-type
      905                 , input store-code
      906                 , input prt-tree.bc).
      907     apply "entry" to br-gds-prt in frame d-gds-prt.
      908   END.
      909   ON CHOOSE OF menu-item m-alt-current do:
      910     run cre-code no-error.
      911     if error-status :error then
      912       return no-apply.
      913     run ref/alt-cds.w ( input parParentProc
      914                        ,input store-type
      915                        ,input store-code
      916                        ,input "code-current"
      917                        ,input ub.goods.gds-code
      918                        ,input prt-tree.bc
      919                        ,output rec-list).
      920     apply "entry" to br-gds-prt in frame d-gds-prt.
      921   END.
      922   ON CHOOSE OF menu-item m-alt-all do:
      923     run cre-code no-error.
      924     if error-status :error then
      925       return no-apply.
      926     run ref/alt-cds.w ( input parParentProc
      927                        ,input store-type
      928                        ,input store-code
      929                        ,input "code-all"
      930                        ,input ub.goods.gds-code
      931                        ,input prt-tree.bc
      932                        ,output rec-list).
      933     apply "entry" to br-gds-prt in frame d-gds-prt.
      934   END.
      935   ON CHOOSE OF menu-item m-prod-all do:
      936     run cre-code no-error.
      937     if error-status :error then
      938       return no-apply.
      939     run ref/prod-cds.w (parParentProc, store-type, store-code,
      940                     "code-all", ub.goods.gds-code, prt-tree.bc, output rec-list).
      941     apply "entry" to br-gds-prt in frame d-gds-prt.
      942   END.
      943   ON CHOOSE OF menu-item m-inf-prt
      944   do:
      945   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   do:
      947     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      948       (input  v-cntxt-db-num
      949       ,input  v-cntxt-userid
      950       ,input  0
      951       ,input  'actn_reference_archive':U
      952       ,input  'firm':U
      953       ,input  v-cntxt-host-code-obj
      954       ,input  '':U
      955       ,input  0
      956       ,input  0
      957       ,input  0
      958       ,input  0
      959       ,input  true
      960       ,output g#log
      961       )  .
      962   end.
      963     if g#log then
      964       run ref/prt_inf.w (buffer ub.goods,
      965                      input prt-tree.n-code,
      966                      input store-type,
      967                      input store-code).
      968     apply "entry" to br-gds-prt in frame d-gds-prt.
      969   END.
      970   ON CHOOSE OF menu-item m-inf-gds do:
      971      run local-gds_inf.
      972   END.
      973   ON CHOOSE OF b-rest IN FRAME d-gds-prt do:
      974     prt-rec = prt-tree.rid.
      975       run rep/gds-objs.w (parparentproc, ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, g#host-code, prt-tree.n-code).
      976     apply "entry" to br-gds-prt in frame d-gds-prt.
      977   END.
      978   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      979     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      980   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981   on help of frame d-gds-prt
      982   do:
      983     run gbl/app_help.p
      984       (input this-procedure :file-name
      985       ,input ''
      986       ,input ?
      987       ) no-error.
      988     if error-status :error then do:
      989       message
      990         "Ошибка при вызове помощи"
      991         error-status :get-message(1)
      992         view-as alert-box .
      993     end.
      994   end.
      995   run minbtn-set in this-procedure .
      996   on choose of b-help in frame d-gds-prt
      997   do:
      998     apply "help":u to frame d-gds-prt .
      999   end.
     1000   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   procedure minbtn-set :
     1002       do
     1003           on error undo, return error return-value
     1004           :
     1005           define variable ii              as integer       no-undo .
     1006           define variable fh              as widget-handle no-undo .
     1007           define variable hh              as widget-handle no-undo .
     1008           define variable v-h             as handle        extent 4 no-undo .
     1009           define variable v-name-button   as character     no-undo .
     1010           define variable v-help-old-x    as decimal       no-undo .
     1011           define variable v-help-old-y    as decimal       no-undo .
     1012           define variable v-help-old-size as decimal       no-undo .
     1013           define variable v-frame-width   as decimal       no-undo .
     1014           define variable jj              as integer       no-undo .
     1015           do
     1016               on error undo, return error
     1017               :
     1018               assign
     1019                   v-frame-width = frame d-gds-prt:width - 0.3
     1020                   fh            = frame d-gds-prt:first-child
     1021                   hh            = fh:first-child
     1022                   ii            = 1
     1023                   .
     1024               do while valid-handle(hh):
     1025                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1026                   do:
     1027                       case lc(hh:name) :
     1028                           when "b-help" then
     1029                               do:
     1030                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1031                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1032                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1033                                   hh:TOOLTIP = "Помощь" .
     1034                                   v-help-old-x = hh:column .
     1035                                   v-help-old-y = hh:row    .
     1036                                   v-help-old-size = hh:width .
     1037                                   hh:width-chars = 2.5 .
     1038                               end.
     1039                           when "b-print" then
     1040                               do:
     1041                                   hh:load-image("cmp/b-print.bmp":u) .
     1042                                   hh:TOOLTIP = "Печать" .
     1043                                   v-h[ii] = hh:handle .
     1044                                   ii = ii + 1 .
     1045                                   hh:width-chars = 3 .
     1046                               end.
     1047                           when "b-history" or
     1048                           when "b-hist" then
     1049                               do:
     1050                                   hh:load-image("cmp/b-hist.bmp":u) .
     1051                                   hh:TOOLTIP = "История" .
     1052                                   v-h[ii] = hh:handle .
     1053                                   ii = ii + 1 .
     1054                                   hh:width-chars = 3 .
     1055                               end.
     1056                           when "b-sch" then
     1057                               do:
     1058                                   hh:load-image("cmp/b-sch.bmp":u) .
     1059                                   hh:TOOLTIP = "Установка Фильтра" .
     1060                                   v-h[ii] = hh:handle .
     1061                                   ii = ii + 1 .
     1062                                   hh:width-chars = 3 .
     1063                               end.
     1064                           when "b-hist-user" then
     1065                               do:
     1066                                   hh:load-image("cmp/b-hist.bmp":u) .
     1067                                   hh:TOOLTIP = "История пользователя" .
     1068                                   ii = ii + 1 .
     1069                               end.
     1070                       end case.
     1071                   end.
     1072                   hh = hh:next-sibling.
     1073               end.
     1074               b-help:column = v-frame-width - b-help:width-chars.
     1075               jj = 0.
     1076               repeat ii = 4 to 1 by -1 :
     1077                   if valid-handle (v-h[ii] ) then
     1078                   do:
     1079                       jj  = jj + 1 .
     1080                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1081                       v-h[ii]:row    = v-help-old-y .
     1082                   end.
     1083               end.
     1084           end.
     1085       end.
     1086   end procedure.
     1087   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
     1088   find ub.goods no-lock where
     1089        recid (ub.goods) = gds-rec.
     1090   find ub.gds-prt no-lock where
     1091        ub.gds-prt.upper-code = ub.goods.prt-root.
     1092   find first b-ord-line where b-ord-line.artic = ub.goods.artic and
     1093        b-ord-line.prod-code = ub.goods.prod-code and
     1094        b-ord-line.prod-type = ub.goods.prod-type no-error .
     1095   assign
     1096   store-type = b-ord-line.obj-type
     1097   store-code = b-ord-line.obj-code
     1098   .
     1099   g#log = session:set-wait-state ("COMPILER") .
     1100   ENABLE br-gds-prt
     1101          b-exit
     1102          b-help
     1103          b-rest
     1104          b-exp-nd
     1105          b-exp-tree with FRAME d-gds-prt.
     1106   run cre-nd (buffer  ub.gds-prt, buffer prt-tree, 0).
     1107   find first prt-tree.
     1108   run exp-nd (yes).
     1109   FRAME d-gds-prt:title =
     1110     ub.goods.artic + " " + ub.goods.gds-name + "  -  " + prt-mode.
     1111   ENABLE b-sel when prt-mode = 'выбор':U
     1112          b-info
     1113          b-codes b-alt b-amnt
     1114          with FRAME d-gds-prt.
     1115   ENABLE flt-amnt with FRAME d-gds-prt.
     1116   find first prt-tree.
     1117   run calc-tree (output prt-tree.doc-amnt, output prt-tree.cli-amnt).
     1118   run ui-on.
     1119   g#log = session:set-wait-state ( "" ) .
     1120   do on endkey undo, leave  on error undo, leave:
     1121     WAIT-FOR GO OF FRAME d-gds-prt.
     1122   end.
     1123   run disable_ui.
     1124   PROCEDURE disable_UI :
     1125     HIDE FRAME d-gds-prt.
     1126   END PROCEDURE.
     1127   PROCEDURE UI-on :
     1128   find  ub.prt-obj where  ub.prt-obj.prt-code  =  ub.gds-prt.node-code
     1129                  and  ub.prt-obj.prod-code = ub.goods.prod-code
     1130                  and  ub.prt-obj.prod-type = ub.goods.prod-type
     1131                  and  ub.prt-obj.artic     = ub.goods.artic
     1132                  and  ub.prt-obj.obj-code  = store-code
     1133                  and  ub.prt-obj.obj-type  = store-type
     1134                  no-lock no-error.
     1135   find first b-ord-line where b-ord-line.artic = ub.goods.artic and
     1136        b-ord-line.prod-code = ub.goods.prod-code and
     1137        b-ord-line.prod-type = ub.goods.prod-type no-error .
     1138   disp ub.goods.unit-base
     1139        ord-line-fact-qnty
     1140        ord-line-cli-qnty
     1141       with frame d-gds-prt.
     1142   if input frame d-gds-prt flt-amnt then
     1143     OPEN QUERY br-gds-prt
     1144       FOR EACH  prt-tree where
     1145                 prt-tree.visible = yes and
     1146                 (prt-tree.is-term = no or
     1147                 prt-tree.doc-amnt <> 0 or
     1148                 prt-tree.cli-amnt <> 0
     1149                 ) no-lock.
     1150   else
     1151   OPEN QUERY  br-gds-prt
     1152     FOR EACH  prt-tree where
     1153               prt-tree.visible = yes no-lock.
     1154   reposition br-gds-prt to row gds-prt-row no-error.
     1155   apply "ENTRY":U to br-gds-prt in frame d-gds-prt.
     1156   END PROCEDURE.
     1157   PROCEDURE calc-tree:
     1158   def output param doc-accum like ub.gds-dtl.doc-qnty no-undo.
     1159   def output param cli-accum like  ub.gds-dtl.fact-qnty no-undo.
     1160   find first b-ord-line where b-ord-line.artic = ub.goods.artic and
     1161        b-ord-line.prod-code = ub.goods.prod-code and
     1162        b-ord-line.prod-type = ub.goods.prod-type no-error .
     1163   for each b-ord-gds-dtl no-lock where
     1164            b-ord-gds-dtl.doc-code  = b-ord-line.doc-code and
     1165            b-ord-gds-dtl.artic     = b-ord-line.artic and
     1166            b-ord-gds-dtl.prod-type = b-ord-line.prod-type and
     1167            b-ord-gds-dtl.prod-code = b-ord-line.prod-code:
     1168     accumulate
     1169                b-ord-gds-dtl.qnty (total)
     1170                b-ord-gds-dtl.cli-qnty (total)
     1171                .
     1172   end.
     1173   assign
     1174     doc-accum  = (accum total b-ord-gds-dtl.qnty)
     1175     cli-accum  = (accum total b-ord-gds-dtl.cli-qnty)
     1176     .
     1177   END PROCEDURE.
     1178   PROCEDURE exp-nd :
     1179   def input param make-visible as logical no-undo.
     1180   define variable nd-level as integer no-undo.
     1181   def buffer b-prt-tree for prt-tree.
     1182   if prt-tree.exp then do:
     1183     nd-level = prt-tree.level.
     1184     find b-prt-tree where
     1185          recid (b-prt-tree) = recid (prt-tree).
     1186     inverse:
     1187     do while true:
     1188       find next b-prt-tree no-error.
     1189       if not available b-prt-tree then
     1190         leave inverse.
     1191       if b-prt-tree.level > nd-level then do:
     1192         if make-visible = ? then
     1193           make-visible = not (b-prt-tree.visible).
     1194         if not make-visible or
     1195            b-prt-tree.level - nd-level = 1 then do:
     1196           b-prt-tree.visible = make-visible.
     1197           if not b-prt-tree.is-term then
     1198             b-prt-tree.mark = "»".
     1199         end.
     1200       end.
     1201       else
     1202         leave inverse.
     1203     end.
     1204   end.
     1205   else do:
     1206     prt-tree.exp = yes.
     1207     run cre-level (recid (prt-tree), prt-tree.level + 1).
     1208     make-visible = yes.
     1209   end.
     1210   if not prt-tree.is-term then
     1211     if make-visible then
     1212       prt-tree.mark = " ".
     1213     else
     1214       prt-tree.mark = "»".
     1215   END PROCEDURE.
     1216   PROCEDURE exp-tree :
     1217     define variable rid as recid no-undo.
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       tree-level = prt-tree.level.
     1222       run waitfram-show in this-procedure
     1223         (input "Раскрывается шкала. Ждите..."
     1224         ).
     1225       tree:
     1226       do while true:
     1227         rid = recid (prt-tree).
     1228         run exp-nd (yes).
     1229         find prt-tree where rid = recid (prt-tree).
     1230         find next prt-tree no-error.
     1231         if not available prt-tree or
     1232           prt-tree.level <= tree-level
     1233           then
     1234           leave tree.
     1235       end.
     1236       run waitfram-hide in this-procedure .
     1237     end.
     1238   END PROCEDURE.
     1239   PROCEDURE cre-level:
     1240   def input param prt-tree-rec as recid   no-undo.
     1241   def input param cur-lev      as integer no-undo.
     1242   def buffer b-gds-prt  for  ub.gds-prt.
     1243   def buffer b-prt-tree for prt-tree.
     1244   define variable up-code like  ub.gds-prt.node-code no-undo.
     1245   find b-prt-tree where
     1246        recid (b-prt-tree) = prt-tree-rec.
     1247   up-code = b-prt-tree.n-code.
     1248   for each b-gds-prt no-lock where
     1249            b-gds-prt.upper-code = up-code
     1250            by b-gds-prt.prt-num:
     1251     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
     1252   end.
     1253   END PROCEDURE.
     1254   PROCEDURE cre-nd:
     1255   def param buffer b-gds-prt  for  ub.gds-prt.
     1256   def param buffer b-prt-tree for prt-tree.
     1257   def input param cur-lev as integer no-undo.
     1258   create b-prt-tree.
     1259   assign
     1260     b-prt-tree.n-code   = b-gds-prt.node-code
     1261     b-prt-tree.level    = cur-lev
     1262     b-prt-tree.n-name   = b-gds-prt.node-name
     1263     b-prt-tree.rid      = recid (b-gds-prt)
     1264     b-prt-tree.visible  = yes
     1265     b-prt-tree.is-term  = b-gds-prt.is-term
     1266     b-prt-tree.is-root  = b-gds-prt.root
     1267     .
     1268   if b-gds-prt.is-term then
     1269     assign
     1270       b-prt-tree.mark = " "
     1271       b-prt-tree.exp = yes
     1272       .
     1273   else
     1274     assign
     1275       b-prt-tree.mark = "»"
     1276       b-prt-tree.exp = no
     1277       .
     1278   run clc-nd (buffer b-prt-tree).
     1279   END PROCEDURE.
     1280   PROCEDURE clc-nd:
     1281   def param buffer b-prt-tree for prt-tree.
     1282   def buffer b-gds-prt for  ub.gds-prt.
     1283   find b-gds-prt no-lock where
     1284        recid (b-gds-prt) = b-prt-tree.rid.
     1285   find  ub.prt-obj no-lock where
     1286          ub.prt-obj.prt-code  = b-gds-prt.node-code and
     1287          ub.prt-obj.obj-type  = store-type and
     1288          ub.prt-obj.obj-code  = store-code and
     1289          ub.prt-obj.artic     = ub.goods.artic and
     1290          ub.prt-obj.prod-type = ub.goods.prod-type and
     1291          ub.prt-obj.prod-code = ub.goods.prod-code no-error.
     1292   if available  ub.prt-obj then do:
     1293     assign
     1294       b-prt-tree.free-qnty  =  ub.prt-obj.free-qnty
     1295       b-prt-tree.fact-qnty  =  ub.prt-obj.fact-qnty
     1296       .
     1297     b-prt-tree.price =  ub.prt-obj.price-sale.
     1298   end.
     1299   find first b-ord-gds-dtl no-lock where
     1300        b-ord-gds-dtl.doc-code   = b-ord-line.doc-code  and
     1301        b-ord-gds-dtl.artic      = b-ord-line.artic     and
     1302        b-ord-gds-dtl.prod-code  = b-ord-line.prod-code and
     1303        b-ord-gds-dtl.prod-type  = b-ord-line.prod-type and
     1304        b-ord-gds-dtl.node-code  = b-gds-prt.node-code no-error.
     1305   if available b-ord-gds-dtl then do:
     1306     assign
     1307       b-prt-tree.cli-amnt     = b-ord-gds-dtl.cli-qnty
     1308       b-prt-tree.doc-amnt     = b-ord-gds-dtl.qnty
     1309       b-prt-tree.price-r-b    = (if varr-b = "rubl":u then b-ord-gds-dtl.price-rubl else b-ord-gds-dtl.price-base)
     1310       .
     1311   end.
     1312   find  ub.bar-code no-lock where
     1313         ub.bar-code.gds-code  = ub.goods.gds-code and
     1314         ub.bar-code.node-code = b-gds-prt.node-code and
     1315         ub.bar-code.part-code = "" and
     1316         ub.bar-code.in-code   = "" and
     1317         ub.bar-code.unit-cli  = ub.goods.unit-base no-error.
     1318   if available ub.bar-code then
     1319     b-prt-tree.bc = ub.bar-code.b-code.
     1320   else
     1321     b-prt-tree.bc = ?.
     1322   END PROCEDURE.
     1323   PROCEDURE cre-code:
     1324   define variable is-new as log no-undo.
     1325   def buffer buf_bar-code for ub.bar-code.
     1326     if not prt-tree.is-term and
     1327        not prt-tree.is-root then do:
     1328       message
     1329         "Узел промежуточный. Работа с кодами запрещена."
     1330         view-as alert-box error.
     1331       return error.
     1332     end.
     1333     if prt-tree.bc = ? then do:
     1334       g#log = no.
     1335       message "Основной код для данного признака отсутствует. Создать код?"
     1336               view-as alert-box question buttons YES-NO update g#log.
     1337       if not g#log then
     1338         return error.
     1339   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1340   do:
     1341     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1342       (input  v-cntxt-db-num
     1343       ,input  v-cntxt-userid
     1344       ,input  0
     1345       ,input  'actn_main-barcode_preparation':U
     1346       ,input  'global':U
     1347       ,input  0
     1348       ,input  '':U
     1349       ,input  0
     1350       ,input  0
     1351       ,input  0
     1352       ,input  0
     1353       ,input  true
     1354       ,output g#log
     1355       )  .
     1356   end.
     1357       if not g#log then do:
     1358         return error.
     1359       END.
     1360   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1362     (input  ub.goods.gds-code
     1363     ,input  prt-tree.n-code
     1364     ,input  ''
     1365     ,input  ''
     1366     ,input  ub.goods.unit-base
     1367     ,input  1
     1368     ,output is-new
     1369     ,buffer buf_bar-code
     1370     ) no-error .
     1371       if error-status :error then do:
     1372         message
     1373           "Ошибка поиска / создания основного кода." skip
     1374           "Код товара:"        ub.goods.gds-code skip
     1375           "Код признака:"      prt-tree.n-code skip
     1376           "Единица измерения:" ub.goods.unit-base skip
     1377           error-status :get-message(1) skip
     1378           return-value skip
     1379           view-as alert-box error.
     1380         return error.
     1381       end.
     1382       prt-tree.bc = buf_bar-code.b-code.
     1383       disp prt-tree.bc with browse br-gds-prt.
     1384     end.
     1385   end.
     1386   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   procedure local-gds_inf :
     1388     for each tt-goods
     1389     :
     1390       delete tt-goods.
     1391     end.
     1392     for each tt-clients
     1393     :
     1394       delete tt-clients.
     1395     end.
     1396     create tt-goods.
     1397     buffer-copy ub.goods to tt-goods.
     1398     create tt-clients.
     1399     assign
     1400       tt-clients.obj-type = store-type
     1401       tt-clients.obj-code = store-code
     1402     .
     1403     define variable v-ok as logical   no-undo .
     1404     define variable v-chk-act-host-code as integer   no-undo .
     1405   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
