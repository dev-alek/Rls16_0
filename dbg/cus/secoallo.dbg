      583        tog-23 AT ROW 8 COL 41.5 WIDGET-ID 46
      584        tog-7 AT ROW 9 COL 2.5 WIDGET-ID 14
      585        tog-24 AT ROW 9 COL 41.5 WIDGET-ID 48
      586        tog-8 AT ROW 10 COL 2.5 WIDGET-ID 16
      587        tog-25 AT ROW 10 COL 41.5 WIDGET-ID 50
      588        tog-9 AT ROW 11 COL 2.5 WIDGET-ID 18
      589        tog-26 AT ROW 11 COL 41.5 WIDGET-ID 52
      590        tog-10 AT ROW 12 COL 2.5 WIDGET-ID 20
      591        tog-27 AT ROW 12 COL 41.5 WIDGET-ID 54
      592        tog-11 AT ROW 13 COL 2.5 WIDGET-ID 22
      593        tog-28 AT ROW 13 COL 41.5 WIDGET-ID 56
      594        tog-12 AT ROW 14 COL 2.5 WIDGET-ID 24
      595        tog-29 AT ROW 14 COL 41.5 WIDGET-ID 58
      596        tog-13 AT ROW 15 COL 2.5 WIDGET-ID 26
      597        tog-30 AT ROW 15 COL 41.5 WIDGET-ID 60
      598        tog-14 AT ROW 16 COL 2.5 WIDGET-ID 28
      599        tog-31 AT ROW 16 COL 41.5 WIDGET-ID 62
      600        tog-15 AT ROW 17 COL 2.5 WIDGET-ID 30
      601        tog-32 AT ROW 17 COL 41.5 WIDGET-ID 64
      602        tog-16 AT ROW 18 COL 2.5 WIDGET-ID 32
      603        tog-33 AT ROW 18 COL 41.5 WIDGET-ID 66
      604        tog-17 AT ROW 19 COL 2.5 WIDGET-ID 34
      605        tog-34 AT ROW 19 COL 41.5 WIDGET-ID 68
      606        SPACE(39.62) SKIP(2.08)
      607       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      608            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      609            TITLE "Выбор колонок для печати в режиме РАСЧЕТ потребности товара"
      610            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
      611   ASSIGN
      612          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      613          FRAME Dialog-Frame:HIDDEN           = TRUE.
      614   ON GO OF FRAME Dialog-Frame
      615   DO:
      616     RUN save-proc NO-ERROR.
      617     if error-status :error then
      618        return no-apply.
      619   END.
      620   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      621   DO:
      622     APPLY "END-ERROR":U TO SELF.
      623   END.
      624   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      625   OR HELP OF FRAME Dialog-Frame
      626   DO:
      627   END.
      628   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      629   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      630   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   on help of frame Dialog-Frame
      632   do:
      633     run gbl/app_help.p
      634       (input this-procedure :file-name
      635       ,input ''
      636       ,input ?
      637       ) no-error.
      638     if error-status :error then do:
      639       message
      640         "Ошибка при вызове помощи"
      641         error-status :get-message(1)
      642         view-as alert-box .
      643     end.
      644   end.
      645   run minbtn-set in this-procedure .
      646   on choose of b-help in frame Dialog-Frame
      647   do:
      648     apply "help":u to frame Dialog-Frame .
      649   end.
      650   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   procedure minbtn-set :
      652       do
      653           on error undo, return error return-value
      654           :
      655           define variable ii              as integer       no-undo .
      656           define variable fh              as widget-handle no-undo .
      657           define variable hh              as widget-handle no-undo .
      658           define variable v-h             as handle        extent 4 no-undo .
      659           define variable v-name-button   as character     no-undo .
      660           define variable v-help-old-x    as decimal       no-undo .
      661           define variable v-help-old-y    as decimal       no-undo .
      662           define variable v-help-old-size as decimal       no-undo .
      663           define variable v-frame-width   as decimal       no-undo .
      664           define variable jj              as integer       no-undo .
      665           do
      666               on error undo, return error
      667               :
      668               assign
      669                   v-frame-width = frame Dialog-Frame:width - 0.3
      670                   fh            = frame Dialog-Frame:first-child
      671                   hh            = fh:first-child
      672                   ii            = 1
      673                   .
      674               do while valid-handle(hh):
      675                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      676                   do:
      677                       case lc(hh:name) :
      678                           when "b-help" then
      679                               do:
      680                                   hh:load-image-up("cmp/b-help.bmp":u) .
      681                                   hh:load-image-down("cmp/b-help.bmp":u) .
      682                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      683                                   hh:TOOLTIP = "Помощь" .
      684                                   v-help-old-x = hh:column .
      685                                   v-help-old-y = hh:row    .
      686                                   v-help-old-size = hh:width .
      687                                   hh:width-chars = 2.5 .
      688                               end.
      689                           when "b-print" then
      690                               do:
      691                                   hh:load-image("cmp/b-print.bmp":u) .
      692                                   hh:TOOLTIP = "Печать" .
      693                                   v-h[ii] = hh:handle .
      694                                   ii = ii + 1 .
      695                                   hh:width-chars = 3 .
      696                               end.
      697                           when "b-history" or
      698                           when "b-hist" then
      699                               do:
      700                                   hh:load-image("cmp/b-hist.bmp":u) .
      701                                   hh:TOOLTIP = "История" .
      702                                   v-h[ii] = hh:handle .
      703                                   ii = ii + 1 .
      704                                   hh:width-chars = 3 .
      705                               end.
      706                           when "b-sch" then
      707                               do:
      708                                   hh:load-image("cmp/b-sch.bmp":u) .
      709                                   hh:TOOLTIP = "Установка Фильтра" .
      710                                   v-h[ii] = hh:handle .
      711                                   ii = ii + 1 .
      712                                   hh:width-chars = 3 .
      713                               end.
      714                           when "b-hist-user" then
      715                               do:
      716                                   hh:load-image("cmp/b-hist.bmp":u) .
      717                                   hh:TOOLTIP = "История пользователя" .
      718                                   ii = ii + 1 .
      719                               end.
      720                       end case.
      721                   end.
      722                   hh = hh:next-sibling.
      723               end.
      724               b-help:column = v-frame-width - b-help:width-chars.
      725               jj = 0.
      726               repeat ii = 4 to 1 by -1 :
      727                   if valid-handle (v-h[ii] ) then
      728                   do:
      729                       jj  = jj + 1 .
      730                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      731                       v-h[ii]:row    = v-help-old-y .
      732                   end.
      733               end.
      734           end.
      735       end.
      736   end procedure.
      737   MAIN-BLOCK:
      738   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      739      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      740       RUN make_tt  .
      741       RUN enable_UI.
      742     WAIT-FOR GO OF FRAME Dialog-Frame.
      743   END.
      744   RUN disable_UI.
      745   PROCEDURE disable_UI :
      746     HIDE FRAME Dialog-Frame.
      747   END PROCEDURE.
      748   PROCEDURE enable_UI :
      749     DISPLAY tog-1 tog-18 tog-2 tog-19 tog-3 tog-20 tog-4 tog-21 tog-5 tog-22 tog-6
      750             tog-23 tog-7 tog-24 tog-8 tog-25 tog-9 tog-26 tog-10 tog-27 tog-11
      751             tog-28 tog-12 tog-29 tog-13 tog-30 tog-14 tog-31 tog-15 tog-32 tog-16
      752             tog-33 tog-17 tog-34
      753         WITH FRAME Dialog-Frame.
      754     ENABLE B-OK B-Cancel B-Help tog-1 tog-18 tog-2 tog-19 tog-20 tog-4 tog-21
      755            tog-5 tog-22 tog-6 tog-23 tog-7 tog-24 tog-8 tog-9 tog-26 tog-10
      756            tog-27 tog-11 tog-28 tog-12 tog-29 tog-13 tog-30 tog-14 tog-31 tog-15
      757            tog-32 tog-16 tog-33 tog-17 tog-34
      758         WITH FRAME Dialog-Frame.
      759     VIEW FRAME Dialog-Frame.
      760   END PROCEDURE.
      761   PROCEDURE make_tt :
      762   define variable v-list as character no-undo.
      763   find first ubflt.usr-flt  no-lock where
      764            ubflt.usr-flt.user-name    = v-cntxt-userid and
      765            ubflt.usr-flt.call-point   = "selcolallo":U    no-error .
      766            if available ubflt.usr-flt then do :
      767               assign v-uf-List_ = ubflt.usr-flt.list_ .
      768            end.
      769   if v-uf-List_ <> "" then do:
      770     if entry( 1  , v-uf-List_, chr(4)) <> "" then do : assign tog-1  = logical(entry( 1  , v-uf-List_, chr(4))). end.
      771     if entry( 2  , v-uf-List_, chr(4)) <> "" then do : assign tog-2  = logical(entry( 2  , v-uf-List_, chr(4))). end.
      772     if entry( 4  , v-uf-List_, chr(4)) <> "" then do : assign tog-4  = logical(entry( 4  , v-uf-List_, chr(4))). end.
      773     if entry( 5  , v-uf-List_, chr(4)) <> "" then do : assign tog-5  = logical(entry( 5  , v-uf-List_, chr(4))). end.
      774     if entry( 6  , v-uf-List_, chr(4)) <> "" then do : assign tog-6  = logical(entry( 6  , v-uf-List_, chr(4))). end.
      775     if entry( 7  , v-uf-List_, chr(4)) <> "" then do : assign tog-7  = logical(entry( 7  , v-uf-List_, chr(4))). end.
      776     if entry( 8  , v-uf-List_, chr(4)) <> "" then do : assign tog-8  = logical(entry( 8  , v-uf-List_, chr(4))). end.
      777     if entry( 9  , v-uf-List_, chr(4)) <> "" then do : assign tog-9  = logical(entry( 9  , v-uf-List_, chr(4))). end.
      778     if entry( 10 , v-uf-List_, chr(4)) <> "" then do : assign tog-10 = logical(entry( 10 , v-uf-List_, chr(4))). end.
      779     if entry( 11 , v-uf-List_, chr(4)) <> "" then do : assign tog-11 = logical(entry( 11 , v-uf-List_, chr(4))). end.
      780     if entry( 12 , v-uf-List_, chr(4)) <> "" then do : assign tog-12 = logical(entry( 12 , v-uf-List_, chr(4))). end.
      781     if entry( 13 , v-uf-List_, chr(4)) <> "" then do : assign tog-13 = logical(entry( 13 , v-uf-List_, chr(4))). end.
      782     if entry( 14 , v-uf-List_, chr(4)) <> "" then do : assign tog-14 = logical(entry( 14 , v-uf-List_, chr(4))). end.
      783     if entry( 15 , v-uf-List_, chr(4)) <> "" then do : assign tog-15 = logical(entry( 15 , v-uf-List_, chr(4))). end.
      784     if entry( 16 , v-uf-List_, chr(4)) <> "" then do : assign tog-16 = logical(entry( 16 , v-uf-List_, chr(4))). end.
      785     if entry( 17 , v-uf-List_, chr(4)) <> "" then do : assign tog-17 = logical(entry( 17 , v-uf-List_, chr(4))). end.
      786     if entry( 18 , v-uf-List_, chr(4)) <> "" then do : assign tog-18 = logical(entry( 18 , v-uf-List_, chr(4))). end.
      787     if entry( 19 , v-uf-List_, chr(4)) <> "" then do : assign tog-19 = logical(entry( 19 , v-uf-List_, chr(4))). end.
      788     if entry( 20 , v-uf-List_, chr(4)) <> "" then do : assign tog-20 = logical(entry( 20 , v-uf-List_, chr(4))). end.
      789     if entry( 21 , v-uf-List_, chr(4)) <> "" then do : assign tog-21 = logical(entry( 21 , v-uf-List_, chr(4))). end.
      790     if entry( 22 , v-uf-List_, chr(4)) <> "" then do : assign tog-22 = logical(entry( 22 , v-uf-List_, chr(4))). end.
      791     if entry( 23 , v-uf-List_, chr(4)) <> "" then do : assign tog-23 = logical(entry( 23 , v-uf-List_, chr(4))). end.
      792     if entry( 24 , v-uf-List_, chr(4)) <> "" then do : assign tog-24 = logical(entry( 24 , v-uf-List_, chr(4))). end.
      793     if entry( 26 , v-uf-List_, chr(4)) <> "" then do : assign tog-26 = logical(entry( 26 , v-uf-List_, chr(4))). end.
      794     if entry( 27 , v-uf-List_, chr(4)) <> "" then do : assign tog-27 = logical(entry( 27 , v-uf-List_, chr(4))). end.
      795     if entry( 28 , v-uf-List_, chr(4)) <> "" then do : assign tog-28 = logical(entry( 28 , v-uf-List_, chr(4))). end.
      796     if entry( 29 , v-uf-List_, chr(4)) <> "" then do : assign tog-29 = logical(entry( 29 , v-uf-List_, chr(4))). end.
      797     if entry( 30 , v-uf-List_, chr(4)) <> "" then do : assign tog-30 = logical(entry( 30 , v-uf-List_, chr(4))). end.
      798     if entry( 31 , v-uf-List_, chr(4)) <> "" then do : assign tog-31 = logical(entry( 31 , v-uf-List_, chr(4))). end.
      799     if entry( 32 , v-uf-List_, chr(4)) <> "" then do : assign tog-32 = logical(entry( 32 , v-uf-List_, chr(4))). end.
      800     if entry( 33 , v-uf-List_, chr(4)) <> "" then do : assign tog-33 = logical(entry( 33 , v-uf-List_, chr(4))). end.
      801     if entry( 34 , v-uf-List_, chr(4)) <> "" then do : assign tog-34 = logical(entry( 34 , v-uf-List_, chr(4))). end.
      802   assign
      803     tog-3  = yes
      804     tog-25 = yes
      805   no-error .
      806   end.
      807   END PROCEDURE.
      808   PROCEDURE save-proc :
      809   define variable v-str as character no-undo .
      810   define variable v-i   as integer   no-undo .
      811    do with frame Dialog-Frame :
      812    assign tog-1 tog-2 tog-3 tog-4 tog-5 tog-6 tog-7 tog-8 tog-9 tog-10
      813           tog-11 tog-12 tog-13 tog-14 tog-15 tog-16 tog-17 tog-18 tog-19 tog-20
      814           tog-21 tog-22 tog-23 tog-24 tog-25 tog-26 tog-27 tog-28 tog-29 tog-30
      815           tog-31 tog-32 tog-33 tog-34
      816           .
      817    end.
      818   v-str = '' .
      819   v-i = 0 .
      820   v-str = string(tog-1  , "yes/no") + chr(4) +
      821           string(tog-2  , "yes/no") + chr(4) +
      822           string(tog-3  , "yes/no") + chr(4) +
      823           string(tog-4  , "yes/no") + chr(4) +
      824           string(tog-5  , "yes/no") + chr(4) +
      825           string(tog-6  , "yes/no") + chr(4) +
      826           string(tog-7  , "yes/no") + chr(4) +
      827           string(tog-8  , "yes/no") + chr(4) +
      828           string(tog-9  , "yes/no") + chr(4) +
      829           string(tog-10 , "yes/no") + chr(4) +
      830           string(tog-11 , "yes/no") + chr(4) +
      831           string(tog-12 , "yes/no") + chr(4) +
      832           string(tog-13 , "yes/no") + chr(4) +
      833           string(tog-14 , "yes/no") + chr(4) +
      834           string(tog-15 , "yes/no") + chr(4) +
      835           string(tog-16 , "yes/no") + chr(4) +
      836           string(tog-17 , "yes/no") + chr(4) +
      837           string(tog-18 , "yes/no") + chr(4) +
      838           string(tog-19 , "yes/no") + chr(4) +
      839           string(tog-20 , "yes/no") + chr(4) +
      840           string(tog-21 , "yes/no") + chr(4) +
      841           string(tog-22 , "yes/no") + chr(4) +
      842           string(tog-23 , "yes/no") + chr(4) +
      843           string(tog-24 , "yes/no") + chr(4) +
      844           string(tog-25 , "yes/no") + chr(4) +
      845           string(tog-26 , "yes/no") + chr(4) +
      846           string(tog-27 , "yes/no") + chr(4) +
      847           string(tog-28 , "yes/no") + chr(4) +
      848           string(tog-29 , "yes/no") + chr(4) +
      849           string(tog-30 , "yes/no") + chr(4) +
      850           string(tog-31 , "yes/no") + chr(4) +
      851           string(tog-32 , "yes/no") + chr(4) +
      852           string(tog-33 , "yes/no") + chr(4) +
      853           string(tog-34 , "yes/no") + chr(4)
      854     .
      855   find first ubflt.usr-flt where
      856            ubflt.usr-flt.user-name    = v-cntxt-userid and
      857            ubflt.usr-flt.call-point   = "selcolallo":U
      858            no-error .
      859            if not available ubflt.usr-flt  then do:
      860                 create  ubflt.usr-flt.
      861                 assign
      862                   ubflt.usr-flt.user-name  = v-cntxt-userid
      863                   ubflt.usr-flt.call-point = "selcolallo":U
      864                 .
      865            end.
      866            assign
      867               ubflt.usr-flt.list_ = v-str
      868            .
      869   END PROCEDURE.
