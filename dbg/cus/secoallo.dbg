      164               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      165         otherwise do:
      166           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      167         end.
      168       end CASE.
      169     end.
      170   end procedure.
      171   procedure uf-get :
      172     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      173     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      174     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      175     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      176     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      177     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      178     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      179     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      180     do
      181     on error undo, return error
      182     :
      183       define buffer buf_usr-flt for ubflt.usr-flt .
      184       define variable v-use-List_     as logical   no-undo .
      185       define variable v-type-List_     as character no-undo .
      186       define variable v-format-List_   as character no-undo .
      187       define variable v-use-Naim      as logical   no-undo .
      188       define variable v-type-Naim      as character no-undo .
      189       define variable v-format-Naim    as character no-undo .
      190       define variable v-use-print-graft as logical   no-undo .
      191       define variable v-use-sort-gr     as logical   no-undo .
      192       define variable v-use-type-price  as logical   no-undo .
      193       define variable v-use-type-val    as logical   no-undo .
      194       define variable v-label          as character no-undo .
      195       define variable v-tooltip        as character no-undo .
      196       define variable v-user-can-edit  as logical   no-undo .
      197       define variable v-output-display as logical   no-undo .
      198       define variable v-other          as character no-undo .
      199       run uf-name in this-procedure
      200          (input  entry(1, p-code, chr(4))
      201         ,output v-use-List_
      202         ,output v-type-List_
      203         ,output v-format-List_
      204         ,output v-use-Naim
      205         ,output v-type-Naim
      206         ,output v-format-Naim
      207         ,output v-use-print-graft
      208         ,output v-use-sort-gr
      209         ,output v-use-type-price
      210         ,output v-use-type-val
      211         ,output v-label
      212         ,output v-tooltip
      213         ,output v-user-can-edit
      214         ,output v-output-display
      215         ,output v-other
      216         ) no-error .
      217       if error-status :error then do:
      218         undo, return error return-value .
      219       end.
      220       find first buf_usr-flt no-lock where
      221                  buf_usr-flt.Call-point     = p-code AND
      222                  buf_usr-flt.user-name       = p-user-name
      223         no-error .
      224       if avail buf_usr-flt then do:
      225         assign
      226         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      227         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      228         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      229         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      230         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      231         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      232         .
      233       end.
      234       else do:
      235         assign
      236         p-List_        = (if v-use-List_       then "":U                    else ?)
      237         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      238         p-print-graft  = (if v-use-print-graft then no                      else ?)
      239         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      240         p-type-price   = (if v-use-type-price  then no                      else ?)
      241         p-type-val     = (if v-use-List_       then no                      else ?)
      242         .
      243       end.
      244     end.
      245   end procedure.
      246   procedure uf-set :
      247     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      248     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      249     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      250     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      251     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      252     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      253     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      254     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      255     do
      256     on error undo, return error
      257     :
      258       define buffer buf_usr-flt for ubflt.usr-flt .
      259       define variable v-use-List_     as logical   no-undo .
      260       define variable v-type-List_     as character no-undo .
      261       define variable v-format-List_   as character no-undo .
      262       define variable v-use-Naim      as logical   no-undo .
      263       define variable v-type-Naim      as character no-undo .
      264       define variable v-format-Naim    as character no-undo .
      265       define variable v-use-print-graft as logical   no-undo .
      266       define variable v-use-sort-gr   as logical   no-undo .
      267       define variable v-use-type-price as logical   no-undo .
      268       define variable v-use-type-val  as logical   no-undo .
      269       define variable v-tooltip        as character no-undo .
      270       define variable v-label          as character no-undo .
      271       define variable v-user-can-edit  as logical   no-undo .
      272       define variable v-output-display as logical   no-undo .
      273       define variable v-other          as character no-undo .
      274       run uf-name in this-procedure
      275         (input  entry(1, p-code, chr(4))
      276         ,output v-use-List_
      277         ,output v-type-List_
      278         ,output v-format-List_
      279         ,output v-use-Naim
      280         ,output v-type-Naim
      281         ,output v-format-Naim
      282         ,output v-use-print-graft
      283         ,output v-use-sort-gr
      284         ,output v-use-type-price
      285         ,output v-use-type-val
      286         ,output v-label
      287         ,output v-tooltip
      288         ,output v-user-can-edit
      289         ,output v-output-display
      290         ,output v-other
      291         ) no-error .
      292       if error-status :error then do:
      293         undo, return error return-value .
      294       end.
      295       find first buf_usr-flt where
      296                  buf_usr-flt.Call-point     = p-code AND
      297                  buf_usr-flt.user-name       = p-user-name
      298         no-error .
      299       if not avail buf_usr-flt then do:
      300           create buf_usr-flt .
      301           assign
      302           buf_usr-flt.call-point = p-code
      303           buf_usr-flt.user-name  = p-user-name
      304           .
      305       end.
      306       if avail buf_usr-flt then do:
      307        assign
      308        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      309        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      310        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      311        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      312        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      313        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      314       .
      315       release buf_usr-flt.
      316       end.
      317       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      318     end.
      319   end procedure.
      320   procedure proc-alt-shift-f2:
      321     if not ibs.th.gbl.gbl-var:rcode
      322   then
      323     run gbl\inidebug.p .
      324   end.
      325   procedure proc-alt-shift-f3:
      326     run gbl/prvssinf.p
      327       ( input this-procedure
      328       ) .
      329   end.
      330   define variable v-inform-launched as logical no-undo initial false .
      331   procedure proc-alt-shift-f4:
      332     define variable v-action as character no-undo .
      333     if v-inform-launched = false then do:
      334       assign
      335         v-inform-launched = true
      336       .
      337       run gbl/d-inform.w
      338         (  input self
      339         ,  input this-procedure
      340         , output v-action
      341         ) no-error .
      342       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      343       assign
      344         v-inform-launched = false
      345       .
      346     end.
      347   end.
      348   procedure proc-alt-f1:
      349     run gbl/corrhelp.p
      350       (input this-procedure
      351       ) .
      352   end .
      353   on alt-shift-f2 anywhere do:
      354     run proc-alt-shift-f2.
      355   end.
      356   on alt-shift-f3 anywhere do:
      357     run proc-alt-shift-f3 in this-procedure .
      358   end.
      359   on alt-shift-f4 anywhere do:
      360     run proc-alt-shift-f4 in this-procedure.
      361   end.
      362   on alt-f1 anywhere do:
      363     run proc-alt-f1 in this-procedure .
      364   end.
