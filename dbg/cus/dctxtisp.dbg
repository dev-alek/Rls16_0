      411   procedure schedule-attr-name :
      412   do
      413     on error undo, return error
      414     :
      415     define input  parameter p-code           as character no-undo .
      416     define output parameter p-type           as character no-undo .
      417     define output parameter p-format         as character no-undo .
      418     define output parameter p-label          as character no-undo .
      419     define output parameter p-user-can-edit  as logical   no-undo .
      420     define output parameter p-output-display as logical   no-undo .
      421     define output parameter p-other          as character no-undo .
      422       if index(p-code, chr(4)) > 0 then do:
      423         p-code = entry(1, p-code, chr(4)).
      424       end.
      425       case p-code :
      426               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      427               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      428               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      429               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      430               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      431               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      432               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      433               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      434               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      435         otherwise do:
      436           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      437         end.
      438       end.
      439     end.
      440   end procedure.
      441   procedure schedule-attr-tooltip :
      442   do
      443     on error undo, return error
      444     :
      445       define input  parameter p-code    as character no-undo .
      446       define output parameter p-tooltip as character no-undo .
      447       define output parameter p-label   as character no-undo .
      448       if index(p-code, chr(4)) > 0 then do:
      449         p-code = entry(1, p-code, chr(4)).
      450       end.
      451       case p-code :
      452               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      453               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      454               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      455               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      456               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      457               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      458               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      459               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      460               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      461         otherwise do:
      462               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      463         end.
      464       end.
      465     end.
      466   end procedure.
      467   procedure schedule-attr-value :
      468   do
      469   on error undo, return error return-value
      470   :
      471   define input parameter  p-cre-db-num as integer    no-undo.
      472   define input parameter  p-task-type  as character  no-undo.
      473   define input parameter  p-task-num   as integer    no-undo.
      474   define input parameter  p-code       as character  no-undo.
      475   define output parameter p-value      as character  no-undo.
      476   define output parameter p-type       as character  no-undo.
      477       define variable v-format         as character no-undo .
      478       define variable v-label          as character no-undo .
      479       define variable v-user-can-edit  as logical   no-undo .
      480       define variable v-output-display as logical   no-undo .
      481       define variable v-other          as character no-undo .
      482       define buffer buf_schedule-attr for ub.schedule-attr.
      483       run schedule-attr-name in this-procedure (
      484             input  p-code
      485           , output p-type
      486           , output v-format
      487           , output v-label
      488           , output v-user-can-edit
      489           , output v-output-display
      490           , output v-other
      491       ) no-error .
      492       if error-status :error
      493       then do:
      494           undo, return error return-value .
      495       end.
      496       if p-code begins ('schd-free-id':U + chr(4))
      497       and entry(2, p-code, chr(4)) = '':U then do:
      498         find first buf_schedule-attr no-lock
      499             where buf_schedule-attr.cre-db-num = p-cre-db-num
      500               and buf_schedule-attr.task-type  = p-task-type
      501               and buf_schedule-attr.task-num   = p-task-num
      502               and buf_schedule-attr.attr-code  begins p-code
      503         no-error .
      504       end.
      505       else do:
      506         find first buf_schedule-attr no-lock
      507             where buf_schedule-attr.cre-db-num = p-cre-db-num
      508               and buf_schedule-attr.task-type  = p-task-type
      509               and buf_schedule-attr.task-num   = p-task-num
      510               and buf_schedule-attr.attr-code  = p-code
      511         no-error .
      512       end.
      513       if available buf_schedule-attr
      514       then do:
      515           assign
      516               p-value = buf_schedule-attr.attr-value
      517           .
      518       end.
      519       else do:
      520         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      521            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      522         end.
      523         else do:
      524           assign
      525               p-value = if p-type = 'L':U then "no":U else ""
      526           .
      527         end.
      528       end.
      529   end.
      530   end procedure.
      531   procedure schedule-attr-write :
      532   do
      533   on error undo, return error
      534   :
      535   define input parameter p-cre-db-num  as integer   no-undo.
      536   define input parameter p-task-type   as character no-undo.
      537   define input parameter p-task-num    as integer   no-undo.
      538   define input parameter p-code        as character no-undo.
      539   define input parameter p-value       as character no-undo.
      540       define variable v-type              as character                no-undo.
      541       define variable v-format            as character                no-undo.
      542       define variable v-label             as character                no-undo.
      543       define variable v-user-can-edit     as logical                  no-undo.
      544       define variable v-output-display    as logical                  no-undo.
      545       define variable v-other             as character                no-undo.
      546       define buffer buf_schedule-attr for ub.schedule-attr .
      547       run schedule-attr-name in this-procedure (
      548             input  p-code
      549           , output v-type
      550           , output v-format
      551           , output v-label
      552           , output v-user-can-edit
      553           , output v-output-display
      554           , output v-other
      555       ) no-error.
      556       if error-status :error
      557       then do:
      558           undo, return error return-value.
      559       end.
      560       find first buf_schedule-attr exclusive-lock
      561            where buf_schedule-attr.cre-db-num = p-cre-db-num
      562              and buf_schedule-attr.task-type  = p-task-type
      563              and buf_schedule-attr.task-num   = p-task-num
      564              and buf_schedule-attr.attr-code  = p-code
      565       no-error.
      566       if not available buf_schedule-attr
      567       then do:
      568           create buf_schedule-attr.
      569           assign
      570             buf_schedule-attr.cre-db-num = p-cre-db-num
      571             buf_schedule-attr.task-type  = p-task-type
      572             buf_schedule-attr.task-num   = p-task-num
      573             buf_schedule-attr.attr-code  = p-code
      574             buf_schedule-attr.attr-value = p-value
      575           .
      576       end.
      577       else do:
      578           assign
      579               buf_schedule-attr.attr-value = p-value
      580           .
      581       end.
      582   end.
      583   end procedure.
      584   procedure schedule-attr-delete :
      585   do
      586   on error undo, return error
      587   :
      588   define input  parameter p-cre-db-num  as integer   no-undo.
      589   define input  parameter p-task-type   as character no-undo.
      590   define input  parameter p-task-num    as integer   no-undo.
      591   define input  parameter p-code        as character no-undo.
      592   define output parameter p-deleted     as logical   no-undo.
      593       define buffer buf_schedule-attr for ub.schedule-attr .
      594       define variable v-type              as character                no-undo.
      595       define variable v-format            as character                no-undo.
      596       define variable v-label             as character                no-undo.
      597       define variable v-user-can-edit     as logical                  no-undo.
      598       define variable v-output-display    as logical                  no-undo.
      599       define variable v-other             as character                no-undo.
      600       run schedule-attr-name in this-procedure (
      601             input p-code
      602           , output v-type
      603           , output v-format
      604           , output v-label
      605           , output v-user-can-edit
      606           , output v-output-display
      607           , output v-other
      608       ) no-error .
      609       if error-status :error
      610       then do:
      611           undo, return error return-value .
      612       end.
      613       find first buf_schedule-attr exclusive-lock
      614            where buf_schedule-attr.cre-db-num = p-cre-db-num
      615              and buf_schedule-attr.task-type  = p-task-type
      616              and buf_schedule-attr.task-num   = p-task-num
      617              and buf_schedule-attr.attr-code  = p-code
      618       no-error.
      619       if not available buf_schedule-attr
      620       then do:
      621           assign
      622               p-deleted = no
      623           .
      624       end.
      625       else do:
      626           delete buf_schedule-attr.
      627           assign
      628               p-deleted = yes
      629           .
      630       end.
      631   end.
      632   end procedure.
      633   procedure schedule-attr-news :
      634   do
      635   on error undo, return error
      636   :
      637       define input  parameter p-code           as character no-undo .
      638       define output parameter p-news           as logical   no-undo .
      639       if index(p-code, chr(4)) > 0 then do:
      640         p-code = entry(1, p-code, chr(4)).
      641       end.
      642       case p-code :
      643               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      644               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      645               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      646               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      647               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      648               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      649               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      650               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      651               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      652         otherwise do:
      653           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      654         end.
      655       end.
      656   end.
      657   end procedure.
      658   procedure schedule-attr-extract-logical :
      659   do
      660   on error undo, return error
      661   :
      662   define input  parameter p-parameter-number   as integer      no-undo.
      663   define input  parameter p-parameter-list     as character    no-undo.
      664   define output parameter p-parameter-value   as logical      no-undo.
      665       if num-entries( p-parameter-list ) > p-parameter-number - 1
      666       then do:
      667           assign
      668               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      669           .
      670       end.
      671       else do:
      672           assign
      673               p-parameter-value   = no
      674           .
      675       end.
      676   end.
      677   end procedure.
      678   procedure schedule-attr-get-free-id :
      679   do
      680   on error undo, return error return-value
      681   :
      682     define input  parameter p-cre-db-num  as integer   no-undo.
      683     define input  parameter p-task-type   as character no-undo.
      684     define input  parameter p-task-num    as integer   no-undo.
      685     define output parameter p-free-id     as character no-undo.
      686     define buffer buf_schedule-attr for ub.schedule-attr.
      687     find first buf_schedule-attr no-lock
      688         where buf_schedule-attr.cre-db-num = p-cre-db-num
      689           and buf_schedule-attr.task-type  = p-task-type
      690           and buf_schedule-attr.task-num   = p-task-num
      691           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      692     no-error .
      693     if available buf_schedule-attr then
      694     assign
      695     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      696     no-error
      697     .
      698   end.
      699   end procedure.
      700   procedure schedule-attr-get-free-props :
      701     define input parameter p-free-id as character no-undo .
      702     define output parameter p-value as character no-undo .
      703     define buffer buf_temp-schedule-free for temp-schedule-free.
      704     do
      705     on error undo, return error return-value
      706     :
      707       find first buf_temp-schedule-free no-lock no-error .
      708       if not available buf_temp-schedule-free then do:
      709         run schedule-attr-fill-free-props in this-procedure .
      710       end.
      711       find first buf_temp-schedule-free where
      712               buf_temp-schedule-free.free-id = p-free-id no-error.
      713       if available buf_temp-schedule-free then do:
      714         assign
      715         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      716                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      717                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      718                   buf_temp-schedule-free.conf-param           + chr(4) +
      719                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      720                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      721                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      722                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      723                   buf_temp-schedule-free.other-info
      724         .
      725       end.
      726       else do:
      727        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      728                              "id произвольной задачи - &5"
      729                              ,vss-workfile
      730                              ,vss-revision
      731                              ,vss-description
      732                              ,chr(10)
      733                              ,p-free-id).
      734       end.
      735     end.
      736   end procedure.
      737   procedure schedule-attr-is-rum-free-id :
      738   define input parameter p-free-id as character no-undo .
      739   define output parameter p-is-rum as logical no-undo .
      740   define buffer buf_temp-schedule-free for temp-schedule-free.
      741   do
      742   on error undo, return error
      743   :
      744       find first buf_temp-schedule-free no-lock no-error .
      745       if not available buf_temp-schedule-free then do:
      746         run schedule-attr-fill-free-props in this-procedure .
      747       end.
      748       find first buf_temp-schedule-free where
      749               buf_temp-schedule-free.free-id = p-free-id no-error.
      750       if available buf_temp-schedule-free
      751       and buf_temp-schedule-free.is-rum
      752       then do:
      753         p-is-rum = yes.
      754       end.
      755   end.
      756   end procedure.
      757   procedure schedule-attr-fill-free-props :
      758   define variable v-path                    as character                no-undo .
      759   DEFINE VARIABLE v-full-path               as character                no-undo .
      760   DEFINE VARIABLE v-file-name               as character                no-undo .
      761   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      762   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      763   define buffer buf_temp-schedule-free for temp-schedule-free.
      764   define variable v-answer as logical no-undo .
      765     do
      766     on error undo, return error substitute("&1 &2 &3&4&5&4"
      767                                           ,vss-workfile
      768                                           ,vss-revision
      769                                           ,vss-description
      770                                           ,chr(10)
      771                                           ,error-status:get-message(1) )
      772     :
      773       run gbl/filename.p (
      774                       input 'cmp/shd-free.d'
      775                     ,output v-full-path
      776                     ,output v-path
      777                     ,output v-file-name
      778                     ,output v-file-name-no-ext
      779                     ,output v-file-name-ext
      780                     ) .
      781       input from value(v-full-path).
      782       repeat :
      783         create buf_temp-schedule-free.
      784         import buf_temp-schedule-free.
      785       END.
      786       input close.
      787       _ff:
      788       for each buf_temp-schedule-free :
      789         if buf_temp-schedule-free.free-id = '':U then do:
      790            delete buf_temp-schedule-free.
      791            next _ff.
      792          end.
      793          run schedule-attr-check-enc in this-procedure (
      794                                                       input  buf_temp-schedule-free.free-id
      795                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      796                                                               buf_temp-schedule-free.proc-param-edit-name +
      797                                                               buf_temp-schedule-free.conf-param +
      798                                                               string(buf_temp-schedule-free.is-gbd) +
      799                                                               string(buf_temp-schedule-free.is-ubd) +
      800                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      801                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      802                                                               string(buf_temp-schedule-free.other-info)
      803                                                               )
      804                                                       ,input  buf_temp-schedule-free.enc-key
      805                                                       ,output v-answer    ) no-error .
      806          if error-status:error
      807          or not v-answer then delete buf_temp-schedule-free.
      808        end.
      809     end.
      810   end procedure.
      811   Function schedule-attr-reverse returns character (str as character).
      812      define variable rev_incl_s as character init "" no-undo .
      813      define variable rev_incl_i as integer no-undo .
      814      define variable rev_incl_l as integer no-undo .
      815      rev_incl_l = length(str).
      816      do rev_incl_i = 1 to rev_incl_l:
      817         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      818      end.
      819      return rev_incl_s.
      820   end.
      821   procedure schedule-attr-check-enc.
      822     define input  parameter p-free-id   as character no-undo .
      823     define input  parameter p-value     as character no-undo .
      824     define input  parameter p-enc-value as character no-undo .
      825     define output parameter p-answer    as logical   no-undo .
      826     define variable tmp         as character no-undo .
      827     define variable v-enc-value as character no-undo .
      828     assign
      829     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      830     .
      831     run schedule-attr-pswd-enc in this-procedure
      832       ( input tmp
      833        ,output v-enc-value
      834       ) no-error .
      835     if error-status:error then do:
      836       message
      837         vss-workfile vss-revision vss-description skip
      838         "Ошибка при вызове процедуры pswd-enc" skip
      839         return-value skip
      840         error-status :get-message(1) skip
      841         view-as alert-box error .
      842       undo, return error .
      843     end.
      844     if v-enc-value = p-enc-value then do:
      845       assign
      846         p-answer = true
      847       .
      848     end.
      849     else do:
      850       assign
      851         p-answer = false
      852       .
      853     end.
      854   end.
      855   procedure schedule-attr-conf-enc.
      856     define input  parameter p-free-id   as character no-undo .
      857     define input  parameter p-value     as character no-undo .
      858     define output parameter p-enc-value as character no-undo .
      859     define variable tmp         as character no-undo .
      860     assign
      861       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      862     .
      863     run schedule-attr-pswd-enc in this-procedure
      864       ( input tmp
      865        ,output p-enc-value
      866       ) no-error .
      867     if error-status:error then do:
      868       message
      869         vss-workfile vss-revision vss-description skip
      870         "Ошибка при вызове процедуры pswd-enc" skip
      871         return-value skip
      872         error-status :get-message(1) skip
      873         view-as alert-box error .
      874       undo, return error .
      875     end.
      876   end procedure.
      877   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   procedure schedule-attr-pswd-enc :
      879     define input parameter  pswd     as character no-undo .
      880     define output parameter enc-pswd as character no-undo .
      881     do
      882     on error undo, return error return-value
      883     :
      884       assign
      885         enc-pswd = encode(pswd + string(index(pswd, "k")))
      886       .
      887     end.
      888   end procedure.
      889   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   procedure cur-time :
      891      define output parameter p-today as date      no-undo .
      892      define output parameter p-time  as integer   no-undo .
      893     do
      894     on error undo, return error
      895     :
      896       define variable v-date1 as date      no-undo .
      897       define variable v-date2 as date      no-undo .
      898       define variable v-time  as integer   no-undo .
      899       assign
      900         v-date1 = today
      901         v-time  = time
      902         v-date2 = today
      903       .
      904       if v-date1 <> v-date2
      905       then do:
      906         assign
      907           v-date1 = today
      908           v-time  = v-time
      909         .
      910       end.
      911       assign
      912         p-today = v-date1
      913         p-time  = v-time
      914       .
      915     end.
      916   end.
      917   function cur-time-date returns character
      918   :
      919     return string(today, '99/99/9999':U) .
      920   end.
      921   function cur-time-mjd returns decimal
      922   :
      923     define variable v-date as date      no-undo .
      924     define variable v-time as integer   no-undo .
      925     run cur-time in this-procedure
      926       (output v-date
      927       ,output v-time
      928       ) .
      929     return integer(v-date) - 2400002 + (v-time / 86400) .
      930   end.
      931   function cur-time-get-ending-index returns integer
      932   (input p-number as integer
      933   )
      934   :
      935     if p-number < 0
      936     or p-number = ?
      937     then do:
      938       return 1 .
      939     end.
      940     define variable v-rest as integer   no-undo .
      941     assign
      942       p-number = p-number modulo 100
      943     .
      944     if p-number < 20
      945     then do:
      946       assign
      947         v-rest = p-number
      948       .
      949     end.
      950     else do:
      951       assign
      952         v-rest = p-number modulo 10
      953       .
      954     end.
      955     case v-rest :
      956       when 1
      957       then do:
      958         return 2 .
      959       end.
      960       when 2 or
      961       when 3 or
      962       when 4
      963       then do:
      964         return 3 .
      965       end.
      966       otherwise do:
      967         return 1 .
      968       end.
      969     end case .
      970   end.
      971   procedure cur-time-mjd-to-date :
      972      define input  parameter i-mjd-diff as decimal no-undo.
      973      define output parameter o-Date     as date    no-undo.
      974      define output parameter o-Time     as integer no-undo.
      975      define variable v-day-number as integer   no-undo .
      976      if    i-mjd-diff < 0
      977         or i-mjd-diff = ?
      978      then do:
      979         return "?" .
      980      end.
      981      assign
      982         v-day-number = truncate(i-mjd-diff,0).
      983         o-Date = date(v-day-number + 2400002).
      984         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      985     .
      986   end.
      987   function cur-time-mjd-to-string returns character
      988   (input p-mjd-diff as decimal
      989   )
      990   :
      991     define variable v-day-number as integer   no-undo .
      992     define variable v-seconds    as integer   no-undo .
      993     define variable v-hour       as integer   no-undo .
      994     define variable v-min        as integer   no-undo .
      995     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      996     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      997     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      998     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      999     if p-mjd-diff < 0
     1000     or p-mjd-diff = ?
     1001     then do:
     1002       return "?" .
     1003     end.
     1004     assign
     1005       v-day-number = integer(truncate(p-mjd-diff,0))
     1006       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1007     .
     1008     if v-seconds > 86400
     1009     then do:
     1010       assign
     1011         v-seconds = 86400 - 1
     1012       .
     1013     end.
     1014     if v-seconds < 0
     1015     then do:
     1016       assign
     1017         v-seconds = 0
     1018       .
     1019     end.
     1020     assign
     1021       v-hour = truncate(v-seconds / 3600, 0)
     1022     .
     1023     assign
     1024       v-seconds = v-seconds modulo 3600
     1025     .
     1026     assign
     1027       v-min = truncate(v-seconds / 60, 0)
     1028     .
     1029     assign
     1030       v-seconds = v-seconds modulo 60
     1031     .
     1032     return
     1033         (if v-day-number <> 0
     1034           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1035           else ""
     1036         )
     1037       + (if v-day-number <> 0 or v-hour <> 0
     1038           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1039           else ""
     1040         )
     1041       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1042           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1043           else ""
     1044         )
     1045       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1046       .
     1047   end.
     1048   function cur-time-string returns character
     1049   :
     1050     define variable v-date as date      no-undo .
     1051     define variable v-time as integer   no-undo .
     1052     run cur-time in this-procedure
     1053       (output v-date
     1054       ,output v-time
     1055       ) .
     1056     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1057   end.
     1058   function cur-time-string-sec returns character
     1059   :
     1060     define variable v-date as date      no-undo .
     1061     define variable v-time as integer   no-undo .
     1062     run cur-time in this-procedure
     1063       (output v-date
     1064       ,output v-time
     1065       ) .
     1066     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1067   end.
     1068   function cur-time-custom  returns character
     1069   (input p-prefix as character
     1070   ,input p-date-format as character
     1071   ,input p-delimiter as character
     1072   ,input p-time-format as character
     1073   ,input p-suffix as character
     1074   )
     1075   :
     1076     define variable v-date as date      no-undo .
     1077     define variable v-time as integer   no-undo .
     1078     run cur-time in this-procedure
     1079       (output v-date
     1080       ,output v-time
     1081       ) .
     1082     return
     1083       p-prefix
     1084       + string(v-date, p-date-format)
     1085       + p-delimiter
     1086       + string(v-time, p-time-format)
     1087       + p-suffix
     1088       .
     1089   end.
     1090   function cur-time-print  returns character
     1091   :
     1092     define variable v-date as date      no-undo .
     1093     define variable v-time as integer   no-undo .
     1094     run cur-time in this-procedure
     1095       (output v-date
     1096       ,output v-time
     1097       ) .
     1098     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1099   end.
     1100   function cur-time-datetime returns datetime
     1101   :
     1102     define variable v-char as character no-undo .
     1103     define variable v-datetime as datetime no-undo .
     1104     v-char = cur-time-string().
     1105     v-datetime = datetime(v-char).
     1106     return  v-datetime.
     1107   end.
     1108   function cur-time-string-msec returns character
     1109   :
     1110     define variable v-date as datetime  no-undo .
     1111     v-date = now.
     1112     return string(v-date) .
     1113   end.
     1114   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   PROCEDURE verify-ini-entry:
     1116   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1117   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1118   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1119   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1120   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1121   define variable v-mess as character no-undo .
     1122   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1123   if ini-entry-value = ? and ini-key-name begins "spl"
     1124   then
     1125   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1126   if ini-entry-value = ? and ini-key-name begins "sav"
     1127   then
     1128   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1129   if ini-entry-value = ? then do:
     1130     assign
     1131     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1132                       , chr(10)
     1133                       , ini-section-name
     1134                       , ini-key-name
     1135                       , error-msg-text).
     1136       if not silence then do:
     1137         message
     1138         v-mess
     1139         view-as alert-box ERROR  .
     1140         return error.
     1141       end.
     1142       else do:
     1143         return error v-mess.
     1144       end.
     1145   end.
     1146   END PROCEDURE.
     1147   PROCEDURE verify-file:
     1148   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1149   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1150   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1151   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1152   file-info:file-name = filename.
     1153   found = NOT (file-info:full-pathname = ?).
     1154   if NOT found  then do:
     1155     if not silence then do:
     1156       message error-msg-text
     1157       view-as alert-box ERROR.
     1158       return error.
     1159     end.
     1160     else return error error-msg-text.
     1161   end.
     1162   END PROCEDURE.
     1163   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164     define variable v-cntxt-db-num        as integer   no-undo .
     1165     define variable v-cntxt-userid        as character no-undo .
     1166     define variable v-cntxt-level         as character no-undo .
     1167     define variable v-cntxt-host-code-obj as integer   no-undo .
     1168     define variable v-cntxt-obj-type      as character no-undo .
     1169     define variable v-cntxt-obj-code      as integer   no-undo .
     1170     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1171     define variable v-cntxt-is-admin      as logical   no-undo .
     1172   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   procedure gen-key-rec :
     1174     define input  parameter p-tbl-name    as character no-undo.
     1175     define input  parameter p-bh_tbl-name as handle    no-undo.
     1176     define output parameter p-key-rec     as character no-undo.
     1177     do
     1178     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1179     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1180     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1181     :
     1182       define variable fh               as handle    no-undo .
     1183       define variable v-ok             as logical   no-undo .
     1184       define variable v-inform         as character no-undo .
     1185       define variable v-ind            as integer   no-undo .
     1186       define variable v-idx-field-qnty as integer   no-undo .
     1187       if p-tbl-name = ?
     1188         or p-tbl-name = "":U
     1189       then do:
     1190         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
     1191       end.
     1192       if not p-bh_tbl-name:available then do:
     1193         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
     1194       end.
     1195       assign
     1196         p-key-rec = p-tbl-name
     1197         v-inform  = p-bh_tbl-name:index-information(1)
     1198         v-ind     = 2
     1199       .
     1200       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1201       on error undo, return error
     1202       :
     1203         assign
     1204           v-inform = p-bh_tbl-name:index-information( v-ind )
     1205           v-ind    = v-ind + 1
     1206         .
     1207       end.
     1208       if v-inform = ?
     1209         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1210         or entry( 3, v-inform, ",":U ) <> "1":U
     1211       then do:
     1212         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
     1213       end.
     1214       else do:
     1215         assign
     1216           v-idx-field-qnty = num-entries( v-inform ) - 4
     1217         .
     1218         if v-idx-field-qnty < 2 then do:
     1219           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
     1220         end.
     1221         do v-ind = 1 to v-idx-field-qnty by 2
     1222         on error undo, return error
     1223         :
     1224           assign
     1225             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1226             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1227           .
     1228         end.
     1229       end.
     1230       if p-key-rec = ? then do:
     1231         assign
     1232           p-key-rec = "":U
     1233         .
     1234         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
     1235       end.
     1236     end.
     1237     return.
     1238   end procedure.
     1239   procedure gen-where-keyr-tab :
     1240     define input  parameter i-tableSerach as character no-undo.
     1241     define input  parameter i-tablekey   as character  no-undo.
     1242     define input  parameter p-key-rec    as character  no-undo.
     1243     define input  parameter p-key-handle as handle     no-undo .
     1244     define input  parameter p-db-name    as character  no-undo .
     1245     define input  parameter p-tt-handle  as handle     no-undo .
     1246     define output parameter o-Where      as character  no-undo.
     1247     do
     1248     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1249     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1250     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1251     :
     1252       define variable v-full-tbl-name  as character no-undo .
     1253       define variable bh_tbl-name      as handle    no-undo .
     1254       define variable fh_key           as handle    no-undo .
     1255       define variable fh_search        as handle    no-undo .
     1256       define variable v-field-num      as integer   no-undo .
     1257       define variable v-count-fld      as integer   no-undo .
     1258       define variable v-inform         as character no-undo .
     1259       define variable v-ind            as integer   no-undo .
     1260       define variable v-idx-field-qnty as integer   no-undo .
     1261       define variable v-field-name     as character no-undo .
     1262       define variable v-field-val      as character no-undo .
     1263       define variable v-word-link      as character no-undo .
     1264       define variable vTable           as character no-undo.
     1265       define variable bh_tbl-key       as handle    no-undo .
     1266       assign
     1267         p-key-rec = trim( p-key-rec )
     1268       .
     1269       if p-key-handle <> ? then do:
     1270         if not valid-handle(p-key-handle)
     1271            or p-key-handle:type <> "buffer"
     1272         then do:
     1273           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
     1274         end.
     1275         if num-entries( p-key-rec, chr(3) ) > 1
     1276           or p-key-rec = ?
     1277           or p-key-rec = "":U
     1278         then do:
     1279           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
     1280         end.
     1281       end.
     1282       else do:
     1283         if p-key-rec = ?
     1284           or p-key-rec = "":U
     1285         then do:
     1286           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1287         end.
     1288       end.
     1289       assign
     1290         vTable = entry( 1 , p-key-rec, chr(3) )
     1291       .
     1292       if p-tt-handle <> ?
     1293         and ( not valid-handle(p-tt-handle)
     1294               or p-tt-handle:type <> "buffer"
     1295             )
     1296       then do:
     1297         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
     1298       end.
     1299       if p-tt-handle = ? then do:
     1300         assign
     1301           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1302         .
     1303         create buffer bh_tbl-name for table v-full-tbl-name .
     1304       end.
     1305       else do:
     1306         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1307       end.
     1308       assign
     1309         v-inform = bh_tbl-name:index-information(1)
     1310         v-ind    = 2
     1311       .
     1312       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1313       on error undo, return error
     1314       :
     1315         assign
     1316           v-inform = bh_tbl-name:index-information( v-ind )
     1317           v-ind    = v-ind + 1
     1318         .
     1319       end.
     1320       if v-inform = ?
     1321         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1322         or entry( 3, v-inform, ",":U ) <> "1":U
     1323       then do:
     1324         delete object bh_tbl-name no-error.
     1325         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
     1326       end.
     1327       assign
     1328         v-idx-field-qnty = num-entries( v-inform ) - 4
     1329       .
     1330       if v-idx-field-qnty < 2 then do:
     1331         delete object bh_tbl-name no-error.
     1332         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
     1333       end.
     1334       assign
     1335         o-where     = "where":U
     1336         v-word-link = "":U
     1337         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1338         v-count-fld = 0
     1339       .
     1340       if i-tablekey ne "" and i-tablekey ne ?
     1341       then do:
     1342         assign
     1343           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1344         .
     1345         create buffer bh_tbl-key for table v-full-tbl-name .
     1346       end.
     1347       if i-tableSerach ne "" and i-tableSerach ne ?
     1348       then do:
     1349         delete object bh_tbl-name no-error.
     1350         assign
     1351           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1352         .
     1353         create buffer bh_tbl-name for table v-full-tbl-name .
     1354       end.
     1355       block_where:
     1356       do v-ind = 1 to v-idx-field-qnty by 2
     1357       on error undo, return error
     1358       :
     1359         assign
     1360           v-count-fld = v-count-fld + 1
     1361         .
     1362         if p-key-handle = ?
     1363           and v-count-fld > v-field-num
     1364         then do:
     1365           leave block_where.
     1366         end.
     1367         define variable VfieldKeyTable as handle no-undo.
     1368         assign
     1369           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1370           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1371         .
     1372         if     bh_tbl-key ne ?
     1373         then do:
     1374            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1375            if VfieldKeyTable eq ?
     1376            then next block_where.
     1377         end.
     1378         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1379         then
     1380            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1381         else
     1382            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1383         if p-key-handle = ? then do:
     1384           assign
     1385             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1386           .
     1387         end.
     1388         else do:
     1389           assign
     1390             fh_key = p-key-handle:buffer-field( v-field-name )
     1391           .
     1392           if fh_key = ?
     1393             or not valid-handle( fh_key )
     1394           then do:
     1395             delete object bh_tbl-name.
     1396             if     bh_tbl-key ne ?
     1397             then
     1398                delete object bh_tbl-key.
     1399             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
     1400           end.
     1401           assign
     1402             v-field-val = fh_key:buffer-value
     1403           .
     1404         end.
     1405         if fh_search:data-type ="character":U then do:
     1406           assign
     1407             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1408             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1409             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1410             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1411             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1412             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1413             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1414             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1415             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1416             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1417             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1418             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1419             v-field-val = substitute( '"&1"', v-field-val )
     1420           .
     1421         end.
     1422         assign
     1423           o-where = substitute( "&1 &2", o-where, v-field-val )
     1424         .
     1425         if v-word-link = "":U then do:
     1426           assign
     1427             v-word-link = "and":U
     1428           .
     1429         end.
     1430       end.
     1431       delete object bh_tbl-name.
     1432       if     bh_tbl-key ne ?
     1433       then
     1434          delete object bh_tbl-key.
     1435       if p-key-handle = ?
     1436         and v-count-fld <> v-field-num
     1437       then do:
     1438         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
     1439       end.
     1440     end.
     1441   end procedure.
     1442   procedure gen-hn-keyr-tab :
     1443     define input  parameter i-tableSerach as character no-undo.
     1444     define input  parameter i-tablekey   as character no-undo.
     1445     define input  parameter p-key-rec    as character no-undo.
     1446     define input  parameter p-key-handle as handle    no-undo .
     1447     define input  parameter p-db-name    as character no-undo .
     1448     define input  parameter p-tt-handle  as handle    no-undo .
     1449     define input  parameter p-stts-lock  as integer   no-undo .
     1450     define output parameter o-hn         as handle    no-undo.
     1451     define variable v-full-tbl-name as character no-undo.
     1452     define variable v-where         as character no-undo.
     1453     define variable bh_tbl-name     as handle    no-undo.
     1454     define variable vTable          as character no-undo.
     1455     do
     1456     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1457     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1458     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1459         run gen-where-keyr-tab(i-tableSerach,
     1460                                i-tablekey,
     1461                                p-key-rec,
     1462                                p-key-handle,
     1463                                p-db-name,
     1464                                p-tt-handle,
     1465                                output v-where).
     1466         if i-tableSerach ne "" and i-tableSerach ne ?
     1467         then do:
     1468            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1469            create buffer bh_tbl-name for table v-full-tbl-name .
     1470         end.
     1471         else do:
     1472            if p-tt-handle = ? then do:
     1473               assign
     1474                  vTable = entry( 1 , p-key-rec, chr(3) )
     1475               .
     1476               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1477               create buffer bh_tbl-name for table v-full-tbl-name .
     1478            end.
     1479            else do:
     1480               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1481            end.
     1482         end.
     1483         if p-tt-handle = ? then do:
     1484            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1485         end.
     1486         else do:
     1487            bh_tbl-name:find-first( v-where ) no-error .
     1488         end.
     1489         o-hn = bh_tbl-name.
     1490      end.
     1491   end procedure.
     1492   procedure gen-hn-keyr :
     1493     define input  parameter p-key-rec    as character no-undo.
     1494     define input  parameter p-key-handle as handle    no-undo .
     1495     define input  parameter p-db-name    as character no-undo .
     1496     define input  parameter p-tt-handle  as handle    no-undo .
     1497     define input  parameter p-stts-lock  as integer   no-undo .
     1498     define output parameter o-hn         as handle    no-undo.
     1499     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1500   end.
     1501   procedure gen-row-keyr :
     1502     define input  parameter p-key-rec    as character no-undo.
     1503     define input  parameter p-key-handle as handle    no-undo .
     1504     define input  parameter p-db-name    as character no-undo .
     1505     define input  parameter p-tt-handle  as handle    no-undo .
     1506     define input  parameter p-stts-lock  as integer   no-undo .
     1507     define output parameter p-tbl-row    as rowid     no-undo.
     1508     define output parameter p-tbl-name   as character no-undo.
     1509     define variable vHn as handle no-undo.
     1510       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1511       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1512       p-tbl-name =  vHn:table.
     1513       delete object vHn no-error.
     1514     if p-tbl-row = ? then do:
     1515       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
     1516     end.
     1517     else do:
     1518       return.
     1519     end.
     1520   end procedure.
     1521   procedure gen-key-fv :
     1522     define input  parameter p-key-rec    as character no-undo .
     1523     define output parameter p-field-list as character no-undo .
     1524     define output parameter p-value-list as character no-undo.
     1525     do
     1526     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1527     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1528     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1529     :
     1530       define variable v-full-tbl-name  as character no-undo .
     1531       define variable bh_tbl-name      as handle    no-undo .
     1532       define variable v-tbl-name       as character no-undo .
     1533       define variable v-field-num      as integer   no-undo .
     1534       define variable v-count-fld      as integer   no-undo .
     1535       define variable v-inform         as character no-undo .
     1536       define variable v-ind            as integer   no-undo .
     1537       define variable v-idx-field-qnty as integer   no-undo .
     1538       define variable v-delim-key      as character no-undo .
     1539       if p-key-rec = ?
     1540         or p-key-rec = "":U
     1541       then do:
     1542         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1543       end.
     1544       assign
     1545         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1546         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1547       .
     1548       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1549       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
     1550       assign
     1551         v-inform = bh_tbl-name:index-information(1)
     1552         v-ind    = 2
     1553       .
     1554       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1555       on error undo, return error
     1556       :
     1557         assign
     1558           v-inform = bh_tbl-name:index-information( v-ind )
     1559           v-ind    = v-ind + 1
     1560         .
     1561       end.
     1562       if v-inform = ?
     1563         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1564         or entry( 3, v-inform, ",":U ) <> "1":U
     1565       then do:
     1566         delete object bh_tbl-name no-error.
     1567         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1568       end.
     1569       assign
     1570         v-idx-field-qnty = num-entries( v-inform ) - 4
     1571       .
     1572       if v-idx-field-qnty < 2 then do:
     1573         delete object bh_tbl-name no-error.
     1574         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1575       end.
     1576       assign
     1577         p-field-list = "":U
     1578         p-value-list = "":U
     1579         v-delim-key  = "":U
     1580         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1581         v-count-fld  = 0
     1582       .
     1583       block_where:
     1584       do v-ind = 1 to v-idx-field-qnty by 2
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-count-fld = v-count-fld + 1
     1589         .
     1590         if v-count-fld > v-field-num then do:
     1591           leave block_where.
     1592         end.
     1593         assign
     1594           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1595           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1596         .
     1597         if v-ind = 1 then do:
     1598           assign
     1599             v-delim-key = chr(3)
     1600           .
     1601         end.
     1602       end.
     1603       delete object bh_tbl-name.
     1604       if v-count-fld <> v-field-num then do:
     1605         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     1606       end.
     1607     end.
     1608   end procedure.
     1609   procedure gen-key-field :
     1610     define input  parameter p-table      as character no-undo .
     1611     define output parameter p-field-list as character no-undo .
     1612     do
     1613     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1614     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1615     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1616     :
     1617       define variable v-full-tbl-name  as character no-undo .
     1618       define variable bh_tbl-name      as handle    no-undo .
     1619       define variable v-tbl-name       as character no-undo .
     1620       define variable v-field-num      as integer   no-undo .
     1621       define variable v-count-fld      as integer   no-undo .
     1622       define variable v-inform         as character no-undo .
     1623       define variable v-ind            as integer   no-undo .
     1624       define variable v-idx-field-qnty as integer   no-undo .
     1625       define variable v-delim-key      as character no-undo .
     1626       if p-table = ?
     1627         or p-table = "":U
     1628       then do:
     1629         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     1630       end.
     1631       assign
     1632         v-tbl-name      = p-table
     1633         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1634       .
     1635       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1636       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     1637       assign
     1638         v-inform = bh_tbl-name:index-information(1)
     1639         v-ind    = 2
     1640       .
     1641       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1642       on error undo, return error
     1643       :
     1644         assign
     1645           v-inform = bh_tbl-name:index-information( v-ind )
     1646           v-ind    = v-ind + 1
     1647         .
     1648       end.
     1649       if v-inform = ?
     1650         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1651         or entry( 3, v-inform, ",":U ) <> "1":U
     1652       then do:
     1653         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1654       end.
     1655       assign
     1656         v-idx-field-qnty = num-entries( v-inform ) - 4
     1657       .
     1658       if v-idx-field-qnty < 2 then do:
     1659         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1660       end.
     1661       assign
     1662         p-field-list = "":U
     1663         v-delim-key  = "":U
     1664         v-count-fld  = 0
     1665       .
     1666       block_where:
     1667       do v-ind = 1 to v-idx-field-qnty by 2
     1668       on error undo, return error
     1669       :
     1670         assign
     1671           v-count-fld = v-count-fld + 1
     1672         .
     1673         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1674         if v-ind = 1 then do:
     1675           assign
     1676             v-delim-key = chr(3)
     1677           .
     1678         end.
     1679       end.
     1680       delete object bh_tbl-name.
     1681     end.
     1682   end procedure.
     1683   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1686   FUNCTION get-region RETURNS CHARACTER
     1687     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1688     define variable par-region as character no-undo.
     1689     if parhost-code = 0 and
     1690          parobj-type = "":U and
     1691          parobj-code = 0 then do:
     1692          par-region = "Глобально".
     1693          return par-region.
     1694       end.
     1695       if parobj-type = 'орг':U then do:
     1696          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1697          return par-region.
     1698       end.
     1699       if parobj-type = 'регион':U
     1700       then do:
     1701          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1702          return par-region.
     1703       end.
     1704       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1705       return par-region.
     1706   END FUNCTION.
     1707   FUNCTION get-objregion RETURNS CHARACTER
     1708     (  input parobj-type as character, input parobj-code as integer ) :
     1709     define variable par-region as character no-undo.
     1710     if  parobj-type = "":U and
     1711         parobj-code = 0
     1712     then do:
     1713        par-region = "Глобально".
     1714     end.
     1715     else if parobj-type = 'орг':U
     1716     then do:
     1717        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1718     end.
     1719     else if parobj-type = 'регион':U
     1720     then do:
     1721        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1722     end.
     1723     else
     1724        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1725     return par-region.
     1726   END FUNCTION.
     1727   FUNCTION calldscr returns character ( input p-call-id as character):
     1728   define variable v-descr as character no-undo .
     1729   define variable v-field-list as character no-undo .
     1730   define variable v-value-list as character no-undo.
     1731   define variable v-prop-label as character no-undo .
     1732   define variable v-node-label as character no-undo .
     1733   define variable v-dt-code as integer no-undo .
     1734   define variable v-host-code as integer no-undo .
     1735   define variable v-obj-type as character no-undo .
     1736   define variable v-obj-code as integer no-undo .
     1737   define variable v-label as character no-undo .
     1738   define variable v-node-code as integer no-undo .
     1739   define buffer buf_prop-head for ub.prop-head.
     1740   define buffer buf_prop-ref for ub.prop-ref.
     1741   define buffer buf_prop-map for ub.prop-map.
     1742   run gen-key-fv in this-procedure ( input p-call-id
     1743                                     ,output v-field-list
     1744                                     ,output v-value-list) no-error .
     1745   if error-status:error then return p-call-id.
     1746   CASE entry(1, p-call-id, chr(3)):
     1747     when 'dis-card-type':U then do:
     1748       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1749                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1750                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1751                            ).
     1752     end.
     1753     when 'dis-card':U then do:
     1754       v-descr = substitute("ДК: № &1"
     1755                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1756                            ).
     1757     end.
     1758     when 'dis-card-property':U then do:
     1759       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1760       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1761       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1762       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1763       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1764       find first buf_prop-ref no-lock where
     1765                 buf_prop-ref.dt-code = v-dt-code no-error .
     1766       if available buf_prop-ref then do:
     1767         find first buf_prop-head no-lock where
     1768                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1769         v-prop-label = buf_prop-head.prop-label.
     1770         find first buf_prop-map no-lock where
     1771                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1772               and buf_prop-map.node-code = v-node-code no-error .
     1773         if available buf_prop-map then do:
     1774           v-label = buf_prop-map.node-label.
     1775         end.
     1776       end.
     1777       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1778                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1779                            ,v-prop-label
     1780                            ,v-label
     1781                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1782                            ).
     1783     end.
     1784     when 'clients':U then do:
     1785       v-descr = substitute("&1&2"
     1786                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1787                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1788                            ).
     1789     end.
     1790     when 'ext-system':U then do:
     1791       v-descr = substitute("Внешняя система &1"
     1792                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1793                            ).
     1794     end.
     1795     WHEN 'thbj-attr':U then do:
     1796       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1797       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1798       then do:
     1799         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1800           v-descr = "Операции с товарами".
     1801         end.
     1802         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1803           v-descr = "Операции с клиентами".
     1804         end.
     1805         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1806           v-descr = "Операции с группами товаров".
     1807         end.
     1808         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1809           v-descr = "Операции с группами клиентов".
     1810         end.
     1811         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1812           v-descr = "Операции с чеками на POS IBS-TH".
     1813         end.
     1814         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1815           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1816         end.
     1817         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1818           v-descr = "Операции в системе электронного документооборота".
     1819         end.
     1820         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1821           v-descr = "Операции со справочниками".
     1822         end.
     1823         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1824           v-descr = "Операции с ДНЦ и переоценками".
     1825         end.
     1826         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1827           v-descr = "Отчеты".
     1828         end.
     1829         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1830           v-descr = "Операции с заказами".
     1831         end.
     1832       end.
     1833     end.
     1834     when 'cash-desk':U then do:
     1835       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1836                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1837                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1838                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1839                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1840                            ).
     1841     end.
     1842     when 'ext-file':U then do:
     1843       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1844                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1845                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1846                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1847                            ).
     1848     end.
     1849   end case.
     1850   return v-descr.
     1851   end function.
     1852   DEFINE VARIABLE v-dir AS CHARACTER NO-UNDO.
     1853   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     1854   DEFINE VARIABLE v-dc-type AS CHARACTER NO-UNDO.
     1855   define variable v-emitent-host-code like ub.dis-card-type.emitent-host-code no-undo .
     1856   define variable v-rule-profile-id as integer no-undo init 12.
     1857   define variable v-codex-id as integer no-undo init 5.
     1858   define variable v-ruleset-id as integer no-undo init 1.
     1859   DEFINE BUTTON b-dc-type
     1860        IMAGE-UP FILE "btn-down-arrow":U
     1861        IMAGE-DOWN FILE "btn-down-arrow":U
     1862        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1863        LABEL "..."
     1864        SIZE 3.6 BY 1.03.
     1865   DEFINE BUTTON b-dir-sel
     1866        IMAGE-UP FILE "btn-down-arrow":U
     1867        IMAGE-DOWN FILE "btn-down-arrow":U
     1868        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1869        LABEL "..."
     1870        SIZE 3.6 BY 1.03.
     1871   DEFINE BUTTON B-exit AUTO-GO
     1872        LABEL "&Ввод"
     1873        SIZE 10 BY 1
     1874        BGCOLOR 8 .
     1875   DEFINE BUTTON B-Help
     1876        LABEL "Помо&щь"
     1877        SIZE 3 BY 1
     1878        BGCOLOR 8 .
     1879   DEFINE BUTTON b-param
     1880        LABEL "&Параметры"
     1881        SIZE 10 BY 1.
     1882   DEFINE BUTTON b-quit AUTO-END-KEY
     1883        LABEL "&Отмена"
     1884        SIZE 10 BY 1
     1885        BGCOLOR 8 .
     1886   DEFINE BUTTON b-rule-profile
     1887        IMAGE-UP FILE "btn-down-arrow":U
     1888        IMAGE-DOWN FILE "btn-down-arrow":U
     1889        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1890        LABEL "..."
     1891        SIZE 3.6 BY 1.03.
     1892   DEFINE VARIABLE f-dc-type-label AS CHARACTER FORMAT "X(256)":U INITIAL "Тип ДК при импорте новой карты"
     1893         VIEW-AS TEXT
     1894        SIZE 33.5 BY .67
     1895        FGCOLOR 4  NO-UNDO.
     1896   DEFINE VARIABLE f-file-name-label AS CHARACTER FORMAT "X(256)":U INITIAL "(Допускается маска имени файла)"
     1897         VIEW-AS TEXT
     1898        SIZE 32 BY .67
     1899        FGCOLOR 4  NO-UNDO.
     1900   DEFINE VARIABLE f-rs-dir-label AS CHARACTER FORMAT "X(256)":U INITIAL "Настройка директории импорта данных"
     1901         VIEW-AS TEXT
     1902        SIZE 40 BY .67
     1903        FGCOLOR 4  NO-UNDO.
     1904   DEFINE VARIABLE f-rs-file-rule-label AS CHARACTER FORMAT "X(256)":U INITIAL "Настройка имени файла импорта"
     1905         VIEW-AS TEXT
     1906        SIZE 45.5 BY .67
     1907        FGCOLOR 4  NO-UNDO.
     1908   DEFINE VARIABLE file-name-1 AS CHARACTER FORMAT "X(256)":U
     1909        LABEL "Имя файла"
     1910        VIEW-AS FILL-IN
     1911        SIZE 14 BY 1 NO-UNDO.
     1912   DEFINE VARIABLE v-dir-name AS CHARACTER FORMAT "X(256)":U
     1913        LABEL "Директория"
     1914        VIEW-AS FILL-IN
     1915        SIZE 82.5 BY 1
     1916        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1917   DEFINE VARIABLE rs-dir AS CHARACTER
     1918        VIEW-AS RADIO-SET VERTICAL
     1919        RADIO-BUTTONS
     1920             "берется из Ini-файла ([schedule-free] dctxt-i=in)", "ini",
     1921   "привязана к строке расписания", "shd-attr"
     1922        SIZE 55 BY 2 NO-UNDO.
     1923   DEFINE QUERY Dialog-Frame FOR
     1924         X_rule-profile,
     1925         ub.rule,
     1926         X_dis-card-type SCROLLING.
     1927   DEFINE FRAME Dialog-Frame
     1928        B-exit AT ROW 1 COL 1
     1929        b-quit AT ROW 1 COL 11
     1930        B-Help AT ROW 1 COL 94.8
     1931        rs-dir AT ROW 4 COL 2 NO-LABEL
     1932        b-dir-sel AT ROW 5 COL 60
     1933        v-dir-name AT ROW 6.27 COL 13 COLON-ALIGNED
     1934        file-name-1 AT ROW 9 COL 3.5
     1935        b-rule-profile AT ROW 10.5 COL 90 WIDGET-ID 26
     1936        X_rule-profile.name AT ROW 10.57 COL 8 COLON-ALIGNED WIDGET-ID 10
     1937             LABEL "Профайл"
     1938             VIEW-AS FILL-IN
     1939             SIZE 79 BY 1
     1940        ub.X_rule.name AT ROW 11.67 COL 10 NO-LABEL WIDGET-ID 18
     1941             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1942             SIZE 79.5 BY 2
     1943        b-dc-type AT ROW 15.93 COL 13.5
     1944        b-param AT ROW 15.93 COL 39 WIDGET-ID 14
     1945        X_dis-card-type.type AT ROW 16.03 COL 2.5 NO-LABEL
     1946             VIEW-AS FILL-IN
     1947             SIZE 10 BY 1
     1948             BGCOLOR 8
     1949        f-rs-dir-label AT ROW 2.77 COL 2.5 COLON-ALIGNED NO-LABEL
     1950        f-rs-file-rule-label AT ROW 7.77 COL 1 COLON-ALIGNED NO-LABEL
     1951        f-file-name-label AT ROW 9.27 COL 29.5 COLON-ALIGNED NO-LABEL
     1952        f-dc-type-label AT ROW 14.87 COL 2 NO-LABEL
     1953        X_dis-card-type.emitent-host-code AT ROW 16.2 COL 25.5 COLON-ALIGNED WIDGET-ID 22
     1954             LABEL "Эмитент"
     1955              VIEW-AS TEXT
     1956             SIZE 6 BY .67
     1957        "Правило:" VIEW-AS TEXT
     1958             SIZE 8.5 BY 1 AT ROW 11.67 COL 1 WIDGET-ID 20
     1959        SPACE(88.29) SKIP(10.02)
     1960       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1961            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1962            TITLE "Параметры импорта данных по продажам по ДК из текстового файл"
     1963            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1964   ASSIGN
     1965          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1966          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1967   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1968   DO:
     1969     APPLY "END-ERROR":U TO SELF.
     1970   END.
     1971   ON CHOOSE OF b-dc-type IN FRAME Dialog-Frame
     1972   DO:
     1973    RUN proc-b-type IN THIS-PROCEDURE NO-ERROR.
     1974    IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1975   END.
     1976   ON CHOOSE OF b-dir-sel IN FRAME Dialog-Frame
     1977   DO:
     1978     define variable c-dir-name  as character no-undo.
     1979     define variable c-dir-type  as character no-undo.
     1980     define variable l-can-write as logical   no-undo.
     1981   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1982   if lookup(self :type
     1983            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1984            ) = 0
     1985   then do:
     1986     message
     1987       "$Workfile$"
     1988       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1989       "Интерфейсный элемент" self :name  skip
     1990       "Тип" self :type  skip
     1991       "Процедура" this-procedure :file-name skip
     1992       view-as alert-box .
     1993   end.
     1994   else do:
     1995     apply "entry":u to self  .
     1996     if focus :handle <> self :handle  then do:
     1997       return no-apply .
     1998     end.
     1999   end.
     2000     run gbl/dir-sel.p ( output c-dir-name, output c-dir-type, output l-can-write ).
     2001     if c-dir-name = '':U or c-dir-name = ? or
     2002        c-dir-type = '':U or c-dir-type = ? then do:
     2003       return no-apply.
     2004     end.
     2005     if l-can-write <> yes then do:
     2006       message 'Вы не имеете права писать в выбранную директорию:' c-dir-name view-as alert-box error.
     2007       return no-apply.
     2008     end.
     2009     assign  v-dir-name = c-dir-name.
     2010     display v-dir-name with frame Dialog-Frame.
     2011       .
     2012   END.
     2013   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2014   DO:
     2015     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2016     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2017     APPLY "GO" TO FRAME Dialog-Frame.
     2018   END.
     2019   ON CHOOSE OF b-param IN FRAME Dialog-Frame
     2020   DO:
     2021       RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     2022       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2023   END.
     2024   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2025   DO:
     2026         assign
     2027           p-cancel = yes
     2028       .
     2029   END.
     2030   ON CHOOSE OF b-rule-profile IN FRAME Dialog-Frame
     2031   DO:
     2032     run proc-rule-profile in this-procedure no-error.
     2033     if error-status:error then return no-apply.
     2034   END.
     2035   ON VALUE-CHANGED OF rs-dir IN FRAME Dialog-Frame
     2036   DO:
     2037     ASSIGN
     2038     rs-dir.
     2039     CASE rs-dir:
     2040         WHEN 'ini' THEN DO:
     2041            HIDE
     2042            b-dir-sel
     2043            IN FRAME Dialog-Frame.
     2044         END.
     2045         OTHERWISE DO:
     2046             DISPLAY
     2047             b-dir-sel
     2048             with FRAME Dialog-Frame.
     2049             ENABLE
     2050             b-dir-sel
     2051             with FRAME Dialog-Frame.
     2052        END.
     2053     END CASE.
     2054   END.
     2055   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2056   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2057   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   on help of frame Dialog-Frame
     2059   do:
     2060     run gbl/app_help.p
     2061       (input this-procedure :file-name
     2062       ,input ''
     2063       ,input ?
     2064       ) no-error.
     2065     if error-status :error then do:
     2066       message
     2067         "Ошибка при вызове помощи"
     2068         error-status :get-message(1)
     2069         view-as alert-box .
     2070     end.
     2071   end.
     2072   run minbtn-set in this-procedure .
     2073   on choose of b-help in frame Dialog-Frame
     2074   do:
     2075     apply "help":u to frame Dialog-Frame .
     2076   end.
     2077   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2078   procedure minbtn-set :
     2079       do
     2080           on error undo, return error return-value
     2081           :
     2082           define variable ii              as integer       no-undo .
     2083           define variable fh              as widget-handle no-undo .
     2084           define variable hh              as widget-handle no-undo .
     2085           define variable v-h             as handle        extent 4 no-undo .
     2086           define variable v-name-button   as character     no-undo .
     2087           define variable v-help-old-x    as decimal       no-undo .
     2088           define variable v-help-old-y    as decimal       no-undo .
     2089           define variable v-help-old-size as decimal       no-undo .
     2090           define variable v-frame-width   as decimal       no-undo .
     2091           define variable jj              as integer       no-undo .
     2092           do
     2093               on error undo, return error
     2094               :
     2095               assign
     2096                   v-frame-width = frame Dialog-Frame:width - 0.3
     2097                   fh            = frame Dialog-Frame:first-child
     2098                   hh            = fh:first-child
     2099                   ii            = 1
     2100                   .
     2101               do while valid-handle(hh):
     2102                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2103                   do:
     2104                       case lc(hh:name) :
     2105                           when "b-help" then
     2106                               do:
     2107                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2108                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2109                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2110                                   hh:TOOLTIP = "Помощь" .
     2111                                   v-help-old-x = hh:column .
     2112                                   v-help-old-y = hh:row    .
     2113                                   v-help-old-size = hh:width .
     2114                                   hh:width-chars = 2.5 .
     2115                               end.
     2116                           when "b-print" then
     2117                               do:
     2118                                   hh:load-image("cmp/b-print.bmp":u) .
     2119                                   hh:TOOLTIP = "Печать" .
     2120                                   v-h[ii] = hh:handle .
     2121                                   ii = ii + 1 .
     2122                                   hh:width-chars = 3 .
     2123                               end.
     2124                           when "b-history" or
     2125                           when "b-hist" then
     2126                               do:
     2127                                   hh:load-image("cmp/b-hist.bmp":u) .
     2128                                   hh:TOOLTIP = "История" .
     2129                                   v-h[ii] = hh:handle .
     2130                                   ii = ii + 1 .
     2131                                   hh:width-chars = 3 .
     2132                               end.
     2133                           when "b-sch" then
     2134                               do:
     2135                                   hh:load-image("cmp/b-sch.bmp":u) .
     2136                                   hh:TOOLTIP = "Установка Фильтра" .
     2137                                   v-h[ii] = hh:handle .
     2138                                   ii = ii + 1 .
     2139                                   hh:width-chars = 3 .
     2140                               end.
     2141                           when "b-hist-user" then
     2142                               do:
     2143                                   hh:load-image("cmp/b-hist.bmp":u) .
     2144                                   hh:TOOLTIP = "История пользователя" .
     2145                                   ii = ii + 1 .
     2146                               end.
     2147                       end case.
     2148                   end.
     2149                   hh = hh:next-sibling.
     2150               end.
     2151               b-help:column = v-frame-width - b-help:width-chars.
     2152               jj = 0.
     2153               repeat ii = 4 to 1 by -1 :
     2154                   if valid-handle (v-h[ii] ) then
     2155                   do:
     2156                       jj  = jj + 1 .
     2157                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2158                       v-h[ii]:row    = v-help-old-y .
     2159                   end.
     2160               end.
     2161           end.
     2162       end.
     2163   end procedure.
     2164   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2165     run mainmenu_getcntxt in parparentproc
     2166       (output v-cntxt-db-num
     2167       ,output v-cntxt-userid
     2168       ,output v-cntxt-level
     2169       ,output v-cntxt-host-code-obj
     2170       ,output v-cntxt-obj-type
     2171       ,output v-cntxt-obj-code
     2172       ,output v-cntxt-db-num-obj
     2173       ,output v-cntxt-is-admin
     2174       ) .
     2175   MAIN-BLOCK:
     2176   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2177      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2178     IF NOT g#db-num = 0  THEN DO:
     2179       MESSAGE
     2180       "Импорт данных по ДК не может быть вызван в УБД"
     2181        VIEW-AS ALERT-BOX ERROR.
     2182        UNDO, RETURN ERROR.
     2183     END.
     2184     if p-mode = 'shd':U then do:
     2185       assign
     2186       frame Dialog-Frame :title = frame Dialog-Frame :title +
     2187                         substitute(". &1: Задача номер &2"
     2188                         , p-task-type
     2189                         , p-task-num )
     2190       .
     2191     end.
     2192     run init-param-values in this-procedure (
     2193         input p-cre-db-num
     2194       , input p-task-type
     2195       , input p-task-num
     2196       , output v-rule-profile-id
     2197       , OUTPUT v-dir-name) no-error .
     2198     if error-status :error then undo, return error .
     2199     RUN init-fields in this-procedure no-error.
     2200     if error-status :error then undo, return error .
     2201     RUN Myenable.
     2202     apply "value-changed" to rs-dir.
     2203     WAIT-FOR GO OF FRAME Dialog-Frame.
     2204   END.
     2205   RUN disable_UI.
     2206   PROCEDURE attach-attr-to-schedule-line :
     2207   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     2208   define buffer buf_schedule      for ub.schedule.
     2209   define buffer buf_schedule-attr for ub.schedule-attr.
     2210   define buffer lock-batchprocess for ub.batchprocess.
     2211   CASE p-mode:
     2212     when 'shd':U then do:
     2213         run gbl/lock-prc.p
     2214             (input 'schd':U
     2215             ,input 'dctxt-i':U
     2216             ,input 0
     2217             ,input 0
     2218             ,input '':U
     2219             ,input ""
     2220             ,input ""
     2221             ,input "Импорт данных по ДК из текстового файла"
     2222             ,input yes
     2223             ,buffer lock-batchprocess
     2224             ) no-error .
     2225         FIND FIRST buf_schedule-attr NO-LOCK WHERE
     2226                    buf_schedule-attr.cre-db-num = p-cre-db-num
     2227                and buf_schedule-attr.task-type  = p-task-type
     2228                and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'dctxt-i') NO-ERROR.
     2229         find first buf_schedule no-lock
     2230              where buf_schedule.cre-db-num = p-cre-db-num
     2231                and buf_schedule.task-type  = p-task-type
     2232                and buf_schedule.task-num   = p-task-num
     2233         no-error.
     2234         if not available buf_schedule
     2235         and (  p-task-type   <> 'autofree':U
     2236             or p-task-num    <> -1 )
     2237         then do:
     2238             message
     2239               vss-workfile vss-revision vss-description
     2240               skip "Не найдена строка расписания."
     2241               skip return-value
     2242               skip trim(error-status :get-message(1))
     2243                    trim(error-status :get-message(2))
     2244                    trim(error-status :get-message(3))
     2245             view-as alert-box error.
     2246             undo, return error .
     2247         end.
     2248       run schedule-attr-write in this-procedure (
     2249             input p-cre-db-num
     2250           , input p-task-type
     2251           , input p-task-num
     2252           , input 'schedule-param-list':U
     2253           , input p-param-list
     2254       ).
     2255     end.
     2256     when 'run':U then do:
     2257       p-params = p-param-list.
     2258     end.
     2259   END CASE.
     2260   END PROCEDURE.
     2261   PROCEDURE disable_UI :
     2262     HIDE FRAME Dialog-Frame.
     2263   END PROCEDURE.
     2264   PROCEDURE enable_UI :
     2265     OPEN QUERY Dialog-Frame FOR EACH X_rule-profile SHARE-LOCK,       EACH ub.rule WHERE TRUE  SHARE-LOCK,       EACH X_dis-card-type WHERE TRUE  SHARE-LOCK.
     2266     GET FIRST Dialog-Frame.
     2267     DISPLAY rs-dir v-dir-name file-name-1 f-rs-dir-label f-rs-file-rule-label
     2268             f-file-name-label f-dc-type-label
     2269         WITH FRAME Dialog-Frame.
     2270     IF AVAILABLE X_dis-card-type THEN
     2271       DISPLAY X_dis-card-type.type X_dis-card-type.emitent-host-code
     2272         WITH FRAME Dialog-Frame.
     2273     IF AVAILABLE X_rule THEN
     2274       DISPLAY X_rule.name
     2275         WITH FRAME Dialog-Frame.
     2276     IF AVAILABLE X_rule-profile THEN
     2277       DISPLAY X_rule-profile.name
     2278         WITH FRAME Dialog-Frame.
     2279     ENABLE B-exit b-quit B-Help rs-dir b-dir-sel b-rule-profile
     2280            X_rule-profile.name X_rule.name b-dc-type b-param
     2281            X_dis-card-type.emitent-host-code
     2282         WITH FRAME Dialog-Frame.
     2283     VIEW FRAME Dialog-Frame.
     2284   END PROCEDURE.
     2285   PROCEDURE init-fields :
     2286   DEFINE VARIABLE v-in AS CHARACTER NO-UNDO.
     2287   DEFINE VARIABLE glog AS logical NO-UNDO.
     2288   DEFINE BUFFER buf_clients FOR ub.clients.
     2289   ASSIGN
     2290   rs-dir = (if v-dir = 'ini' then v-dir else 'other').
     2291   IF rs-dir = "ini":u THEN DO:
     2292       run verify-ini-entry in this-procedure (
     2293                                            INPUT  'dctxt-i_in'
     2294                                           ,INPUT  'schedule-free'
     2295                                           ,INPUT substitute("отсутствует параметр &1 секция &2 в ini-файле"
     2296                                                             , 'dctxt-i_in'
     2297                                                             , 'schedule-free')
     2298                                           ,INPUT no
     2299                                           ,output v-in) no-error .
     2300       if error-status:error or v-in = ? then return error return-value .
     2301       RUN verify-file in this-procedure
     2302                                         (input v-in
     2303                                         ,input substitute("Не найден каталог &1 параметр &2, секция &3 ini-файла"
     2304                                                       , v-in
     2305                                                       , 'schedule-free'
     2306                                                      , 'dctxt-i_in')
     2307                                         ,input no
     2308                                         ,output glog) no-error.
     2309       if error-status:error or not glog then return error return-value .
     2310     v-dir-name = v-in.
     2311   END.
     2312   ELSE DO:
     2313       RUN verify-file in this-procedure
     2314                                         (input v-dir
     2315                                         ,input substitute("Не найден каталог &1"
     2316                                                       , v-dir
     2317                                                       )
     2318                                         ,input no
     2319                                         ,output glog) no-error.
     2320       if error-status:error or not glog then do:
     2321          v-dir-name = '':U.
     2322       end.
     2323       else
     2324      v-dir-name = v-dir.
     2325   END.
     2326   ASSIGN
     2327   file-name-1 = v-file-name
     2328   .
     2329   END PROCEDURE.
     2330   PROCEDURE init-param-values :
     2331   do
     2332   on error undo, return error
     2333   :
     2334   define input parameter p-cre-db-num             as integer      no-undo .
     2335   define input parameter p-task-type              as character    no-undo.
     2336   define input parameter p-task-num               as integer      no-undo.
     2337   define output parameter p-profile-id as integer  no-undo.
     2338   define output parameter p-dir                   as character    no-undo.
     2339   define variable v-param-list    as character     no-undo.
     2340   define variable v-param-type    as character     no-undo.
     2341   define variable v-entry  as character no-undo .
     2342   define variable v-task-num as integer   no-undo .
     2343   define variable v-other-params as character no-undo .
     2344   define variable v-local-rule-profile-id as integer no-undo.
     2345   define buffer buf_schedule for ub.schedule.
     2346   define buffer buf_schedule-attr for ub.schedule-attr.
     2347     CASE p-mode:
     2348       when 'shd':U then do:
     2349         if p-task-num > 0 then do:
     2350           v-task-num = p-task-num.
     2351         end.
     2352         else do:
     2353           for each buf_schedule no-lock where
     2354                   buf_schedule.cre-db-num = p-cre-db-num
     2355               AND buf_schedule.task-type = p-task-type
     2356               AND buf_schedule.task-num > 0,
     2357               first buf_schedule-attr no-lock where
     2358                     buf_schedule-attr.cre-db-num = p-cre-db-num
     2359                 AND buf_schedule-attr.task-type = p-task-type
     2360                 AND buf_schedule-attr.task-num = buf_schedule.task-num
     2361                 AND buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'dctxt-i') :
     2362              v-task-num = buf_schedule.task-num.
     2363           end.
     2364         end.
     2365         if v-task-num <> 0 then
     2366           run schedule-attr-value in this-procedure (
     2367                 input p-cre-db-num
     2368               , input p-task-type
     2369               , input v-task-num
     2370               , input 'schedule-param-list':U
     2371               , output v-param-list
     2372               , output v-param-type
     2373           ) NO-ERROR.
     2374         if v-param-list = '':U THEN DO:
     2375            v-param-list = string(12) + chr(4) + 'ini' + chr(4) + "f?.txt" + chr(4) + chr(4) + chr(4) +
     2376                   chr(4) + chr(4) + string(TODAY) + chr(4) + chr(63).
     2377         END.
     2378       END.
     2379       WHEN 'run' THEN DO:
     2380         assign
     2381         v-param-list = string(12) + chr(4) + 'ini' + chr(4) + "f?.txt" + chr(4) + chr(4) + chr(4) +
     2382                         chr(4) + chr(4) + string(TODAY) + chr(4) + chr(63).
     2383       END.
     2384     END CASE.
     2385     ASSIGN
     2386     v-local-rule-profile-id = integer(entry(1, v-param-list, chr(4)))
     2387     v-dir = entry(2, v-param-list, chr(4))
     2388     v-file-name = entry(3, v-param-list, chr(4))
     2389     v-emitent-host-code = integer(entry(4, v-param-list, chr(4)))
     2390     v-dc-type = entry(5, v-param-list, chr(4))
     2391     v-other-params = v-param-list
     2392     .
     2393     ENTRY(1, v-other-params, chr(4)) = '':U.
     2394     ENTRY(2, v-other-params, chr(4)) = '':U.
     2395     ENTRY(3, v-other-params, chr(4)) = '':U.
     2396     ENTRY(4, v-other-params, chr(4)) = '':U.
     2397     v-other-params = substring(v-other-params, 5).
     2398     run set-rule-profile in this-procedure ( input v-local-rule-profile-id) no-error.
     2399     if error-status:error then undo, return error.
     2400     p-profile-id = v-local-rule-profile-id.
     2401     IF v-dc-type <> '':U THEN DO:
     2402       run set-dc-type in this-procedure ( input v-other-params
     2403                                          ,input v-dc-type
     2404                                          ,input v-emitent-host-code).
     2405     END.
     2406   END.
     2407   END PROCEDURE.
     2408   PROCEDURE MyEnable :
     2409   CASE p-mode:
     2410       WHEN 'run':U THEN DO:
     2411           ASSIGN
     2412           rs-dir:RADIO-BUTTONS IN FRAME Dialog-Frame
     2413                                = "берется из Ini-файла ([schedule-free] dctxt-i_in=)" + chr(44) +
     2414                                  "ini":U + chr(44) +
     2415                                  "задать директорию импорта" + chr(44) +
     2416                                  "other".
     2417       END.
     2418       WHEN 'shd':U THEN DO:
     2419           ASSIGN
     2420           rs-dir:RADIO-BUTTONS = "берется из Ini-файла ([schedule-free] dctxt-i_in=)" + chr(44) +
     2421                                  "ini":U + chr(44) +
     2422                                  "привязываются  к строке расписания" + chr(44) +
     2423                                  "other".
     2424       END.
     2425   END CASE.
     2426   IF AVAILABLE X_dis-card-type THEN DO:
     2427     DISPLAY
     2428     X_dis-card-type.TYPE
     2429     X_dis-card-type.emitent-host-code
     2430     WITH FRAME Dialog-Frame.
     2431   END.
     2432   DISPLAY
     2433   X_rule-profile.NAME
     2434   X_rule.NAME
     2435   rs-dir
     2436   f-rs-dir-label
     2437   v-dir-name
     2438   file-name-1
     2439   f-file-name-label
     2440   f-dc-type-label
     2441   (if available X_rule-profile then X_rule-profile.name else '') @ X_rule-profile.name
     2442   (if available X_dis-card-type then X_Dis-card-type.type else '') @ X_dis-card-type.type
     2443   X_rule.name when available X_rule
     2444   WITH FRAME Dialog-Frame.
     2445   ENABLE
     2446   B-exit
     2447   b-quit
     2448   B-Help
     2449   rs-dir
     2450   b-dir-sel WHEN rs-dir <> 'Ini':U
     2451   b-dc-type
     2452   b-param
     2453   file-name-1
     2454   b-rule-profile
     2455   WITH FRAME Dialog-Frame.
     2456   VIEW FRAME Dialog-Frame.
     2457   END PROCEDURE.
     2458   PROCEDURE proc-b-param :
     2459   define variable v-param-form as character no-undo .
     2460   define variable v-list-mode as character no-undo .
     2461   define buffer buf_rule-profile for ub.rule-profile.
     2462   find first buf_rule-profile no-lock where
     2463             buf_rule-profile.profile_id = X_rp-by-call.profile_id.
     2464   assign
     2465   v-param-form = (if buf_rule-profile.custom-param-form > 0
     2466                   then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     2467                   else "ref/rulercps.w")
     2468   v-list-mode = (if buf_rule-profile.custom-param-form > 0
     2469                  then 'rp-rule-param':U
     2470                  else 'rule-call-param':U)
     2471   .
     2472   run ref/rulercps.w (
     2473                        input parparentproc
     2474                       ,input this-procedure:handle
     2475                       ,input "b-chg":U
     2476                       ,input 'ИЗМЕНЕНИЕ':U
     2477                       ,input v-list-mode
     2478                       ,input 0
     2479                       ,input ?
     2480                       ,input X_rp-by-call.call_id
     2481                       ,input X_rule-by-profile.codex_id
     2482                       ,input X_rule-by-profile.ruleset_id
     2483                       ,input ?
     2484                       ,input X_rule-by-profile.RULE_id
     2485                       ,INput substitute("Правило &1 &2", X_rule-by-profile.RULE_id, calldscr(X_rp-by-call.call_id))
     2486                       ,input-output table tt0-rule-call-param  ) no-error.
     2487   END PROCEDURE.
     2488   PROCEDURE proc-b-type :
     2489   define variable v-rid-list as character no-undo.
     2490   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     2491   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     2492   define buffer buf_rule for ub.rule.
     2493   define buffer buf_ruledict for ub.ruledict.
     2494   define buffer buf_rule-call-param for ub.rule-call-param.
     2495   define buffer buf_ruledict-param for ub.ruledict-param.
     2496   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2497   IF AVAILABLE X_rp-by-call THEN DO:
     2498      ASSIGN
     2499      v-rid-list = STRING(RECID(X_rp-by-call)).
     2500   END.
     2501   run rul/rp-by-call-s.w ( INPUT parparentproc
     2502                           ,INPUT "b-sel":U
     2503                           ,INPUT "profile-id"
     2504                           ,INPUT X_rule-by-profile.profile_id
     2505                           ,INPUT '':U
     2506                           ,input ''
     2507                           ,input 0
     2508                           ,input 0
     2509                           ,INPUT-OUTPUT v-rid-list
     2510                           ) NO-ERROR.
     2511   if v-rid-list = "" then return error.
     2512   find first buf_rp-by-call no-lock where
     2513             recid(buf_rp-by-call) = integer(v-rid-list) no-error.
     2514   if not available buf_rp-by-call then do:
     2515     message
     2516     substitute("Не найдена привязка правила rp-by-call с recid &1" , v-rid-list)
     2517     view-as alert-box error .
     2518     return.
     2519   end.
     2520   FIND FIRST X_rp-by-call WHERE RECID(X_rp-by-call) = RECID(buf_rp-by-call).
     2521   FIND FIRST X_dis-card-type WHERE
     2522           X_dis-card-type.uniq-key-rec = buf_rp-by-call.call_id.
     2523   display
     2524   X_dis-card-type.type
     2525   X_dis-card-type.emitent-host-code
     2526   with frame Dialog-Frame.
     2527   FOR EACH buf_tt0-rule-call-param:
     2528     DELETE buf_tt0-rule-call-param.
     2529   END.
     2530   for each buf_Rule-call-param no-lock where
     2531         buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     2532    and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     2533    and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     2534    and  buf_rule-call-param.rule_id = X_rule-by-profile.rule_id:
     2535   create buf_tt0-rule-call-param.
     2536   buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     2537   end.
     2538   RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     2539   END PROCEDURE.
     2540   PROCEDURE proc-rule-profile :
     2541   define variable v-rid-list as character no-undo .
     2542    define buffer buf_rule-profile for ub.rule-profile.
     2543     do
     2544     on error undo, return error return-value
     2545     :
     2546      find first buf_rule-profile no-lock where
     2547                 buf_rule-profile.profile_id = v-rule-profile-id no-error.
     2548      if available buf_rule-profile then do:
     2549         assign
     2550         v-rid-list = string(recid(buf_rule-profile)).
     2551      end.
     2552      run rul/rule-profile-s.w (
     2553                             input parparentproc
     2554                           , input 'b-sel'
     2555                           , input "general-view"
     2556                           , input 'dis-card-type':U
     2557                           , input-output v-rid-list ) no-error.
     2558       if v-rid-list <> '':U
     2559       and v-rid-list <> string(recid(buf_rule-profile)) then do:
     2560         find first buf_rule-profile no-lock where
     2561                  recid(buf_rule-profile) = integer(v-rid-list) no-error.
     2562         if available buf_rule-profile then do:
     2563           run set-rule-profile in this-procedure ( input buf_rule-profile.profile_id).
     2564         end.
     2565       end.
     2566     end.
     2567   END PROCEDURE.
     2568   PROCEDURE proc-save :
     2569   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2570   DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
     2571   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     2572   define variable v-dop-file-name as character no-undo .
     2573   define variable v-obj-list as character no-undo .
     2574   define variable ii as integer   no-undo .
     2575   define variable c-dir-type as character no-undo .
     2576   define variable l-can-write as logical no-undo .
     2577   DEFINE VARIABLE v-other-param AS CHARACTER NO-UNDO.
     2578   DEFINE BUFFER buf_tt0-rule-call-param FOR tt0-rule-call-param.
     2579   ASSIGN
     2580   FRAME Dialog-Frame
     2581   rs-dir
     2582   file-name-1
     2583   .
     2584   IF rs-dir <> 'ini' THEN DO:
     2585       ASSIGN
     2586       v-dir-name.
     2587       RUN verify-file in this-procedure
     2588                                         ( input v-dir-name
     2589                                         , input substitute("Не найден каталог &1"
     2590                                                       , v-dir-name)
     2591                                         ,input no
     2592                                         ,output glog) no-error.
     2593       if error-status:error or not glog then return error return-value .
     2594   END.
     2595   RUN verify-file in this-procedure
     2596                                     ( input (trim(v-dir-name, chr(92)) + '\save\')
     2597                                     , input substitute("Не найден подкаталог save в каталоге &1&2он необходим для сохранения копии обработанного файла"
     2598                                                   , v-dir-name
     2599                                                   , chr(10)
     2600                                                   )
     2601                                     ,input no
     2602                                     ,output glog) no-error.
     2603   if error-status:error or not glog then return error return-value .
     2604   assign
     2605   file-info :file-name = (trim(v-dir-name, chr(92)) + '\save\')
     2606   .
     2607   if index( file-info:file-type, "W" ) = 0  then do:
     2608     message
     2609     'Вы не имеете права писать в директорию для сохранения копий обработанных файлов: '
     2610     trim(v-dir-name, chr(92)) + '\save\' view-as alert-box error.
     2611     return error.
     2612   end.
     2613   v-dop-file-name = replace(replace(file-name-1, chr(63), '':U), "*", '':U).
     2614   do ii = 1 to length('\/:*?"<>|':U):
     2615     if index(v-dop-file-name, substring('\/:*?"<>|':U, ii, 1)) > 0 then do:
     2616       message
     2617       substitute("Введенное имя файла содержит недопустимый символ &1", substring('\/:*?"<>|':U, ii, 1))
     2618       view-as alert-box error .
     2619       return error.
     2620     end.
     2621   end.
     2622   if trim(v-dop-file-name) = '':U then do:
     2623    message
     2624    "Не задано имя файла для импорта"
     2625    view-as alert-box error .
     2626    return error.
     2627   end.
     2628   if NOT AVAILABLE X_dis-card-type then do:
     2629    message
     2630    "Не задан тип ДК для импорта новых карт"
     2631    view-as alert-box error .
     2632    return error.
     2633   end.
     2634   FOR EACH buf_tt0-rule-call-param
     2635   BY buf_tt0-rule-call-param.param-num:
     2636     ASSIGN
     2637     v-other-param = v-other-param + (IF buf_tt0-rule-call-param.param-num = 1
     2638                                      THEN '':U
     2639                                      ELSE chr(4)) +
     2640     SUBSTITUTE("&1",  BUFFER buf_tt0-rule-call-param:HANDLE:BUFFER-FIELD(SUBSTITUTE("param-value-&1"
     2641                                                                                     , buf_tt0-rule-call-param.param-data-type)):BUFFER-VALUE).
     2642   END.
     2643   ASSIGN
     2644   v-param-list = (string(v-rule-profile-id) + chr(4) +
     2645                   IF rs-dir = 'ini' THEN 'ini' ELSE v-dir-name) + chr(4) +
     2646                   file-name-1 + chr(4) +
     2647                   string(X_dis-card-type.emitent-host-code) + chr(4) +
     2648                   X_dis-card-type.type + chr(4) +
     2649                   v-other-param
     2650   .
     2651   IF p-mode = 'shd' THEN DO:
     2652       run attach-attr-to-schedule-line in this-procedure (
     2653             INPUT v-param-list
     2654        ) NO-ERROR.
     2655     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2656   END.
     2657   END PROCEDURE.
     2658   PROCEDURE set-dc-type :
     2659   define input parameter p-other-params as character no-undo.
     2660   define input parameter p-dc-type as character no-undo.
     2661   define input parameter p-emitent-host-code as integer no-undo.
     2662   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     2663   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     2664   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     2665   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     2666   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     2667   define variable v-ok as logical no-undo .
     2668   define variable v-rid-list as character no-undo .
     2669   define variable v-local-rule-profile-id as integer no-undo.
     2670   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2671   define buffer buf_rule-call-param for ub.rule-call-param.
     2672         FIND FIRST X_dis-card-type NO-LOCK WHERE
     2673                   X_dis-card-type.emitent-host-code = p-emitent-host-code
     2674             AND   X_dis-card-type.type = p-dc-type
     2675             AND X_dis-card-type.host-code = 0
     2676             AND X_dis-card-type.obj-type = '':U
     2677             AND X_dis-card-type.obj-code = 0 NO-ERROR.
     2678       IF NOT AVAILABLE X_dis-card-type  THEN DO:
     2679         MESSAGE
     2680         substitute("Неизвестный тип ДК &1 эмитент &2"
     2681                    , p-dc-type
     2682                    , p-emitent-host-code)
     2683         VIEW-AS ALERT-BOX ERROR.
     2684         UNDO, RETURN ERROR.
     2685       END.
     2686       FIND FIRST X_rp-by-call NO-LOCK WHERE
     2687                 X_rp-by-call.profile_id = 12
     2688           AND   X_rp-by-call.call_id = X_dis-card-type.uniq-key-rec NO-ERROR.
     2689       IF NOT AVAILABLE X_rp-by-call THEN DO:
     2690           MESSAGE
     2691           substitute("Тип ДК &1 эмитент &2 не привязан к профайлу импорта-экспорта в текстового файл"
     2692                      , p-dc-type
     2693                      , p-emitent-host-code)
     2694           VIEW-AS ALERT-BOX ERROR.
     2695           UNDO, RETURN ERROR.
     2696       END.
     2697       find X_rule-by-call where
     2698           X_rule-by-call.call#_id = X_rp-by-call.call#_id
     2699        and X_rule-by-call.rule_id = X_rule-by-profile.rule_id
     2700        and X_rule-by-call.profile_id = X_rule-by-profile.profile_id no-error .
     2701       if ambiguous X_rule-by-call then do:
     2702         message
     2703         "Выберите какой вызов правила Вас необходим"
     2704         view-as alert-box .
     2705         run rul/rule-by-call-s.w ( input parparentproc
     2706                                   ,input "b-sel"
     2707                                   ,input "call_id"
     2708                                   ,input X_rp-by-call.call_id
     2709                                   ,input X_rule-by-profile.codex_id
     2710                                   ,input X_rule-by-profile.ruleset_id
     2711                                   ,input X_rule-by-profile.rule_id
     2712                                   ,input-output v-rid-list) no-error .
     2713         if v-rid-list = '':u then do:
     2714           UNDO, RETURN ERROR.
     2715         end.
     2716         find first X_rule-by-call no-lock where
     2717                   recid(X_rule-by-call) = integer(v-rid-list) no-error .
     2718         if not available X_rule-by-call then do:
     2719           UNDO, RETURN ERROR.
     2720         end.
     2721       end.
     2722       FOR each buf_Rule-call-param no-lock where
     2723             buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     2724        and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     2725        and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     2726        and  buf_rule-call-param.order_id = X_rule-by-call.order_id :
     2727         create buf_tt0-rule-call-param.
     2728         buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     2729         CASE buf_rule-call-param.param-data-type:
     2730           WHEN 'character':U THEN DO:
     2731              ASSIGN
     2732              buf_tt0-rule-call-param.param-value-character = ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4))
     2733              NO-ERROR.
     2734           END.
     2735           WHEN 'date':U THEN DO:
     2736              ASSIGN
     2737              buf_tt0-rule-call-param.param-value-date = IF entry(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)) = chr(63)
     2738                                                         THEN ?
     2739                                                         ELSE DATE(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2740              NO-ERROR.
     2741           END.
     2742           WHEN 'decimal':U THEN DO:
     2743              ASSIGN
     2744              buf_tt0-rule-call-param.param-value-decimal = decimal(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2745              NO-ERROR.
     2746           END.
     2747           WHEN 'integer':U THEN DO:
     2748              ASSIGN
     2749              buf_tt0-rule-call-param.param-value-integer = integer(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2750              NO-ERROR.
     2751           END.
     2752           WHEN 'logical':U THEN DO:
     2753              ASSIGN
     2754              buf_tt0-rule-call-param.param-value-logical = logical(ENTRY(buf_tt0-rule-call-param.param-num, p-other-params, chr(4)))
     2755              NO-ERROR.
     2756           END.
     2757         END CASE.
     2758         IF ERROR-STATUS:ERROR THEN DO:
     2759            MESSAGE
     2760            substitute("Некорректное значение параметра &1=&2"
     2761                       ,buf_tt0-rule-call-param.param-label
     2762                       ,BUFFER buf_tt0-rule-call-param:HANDLE:BUFFER-FIELD(substitute("param-value-&1", buf_tt0-rule-call-param.param-data-type)):buffer-value)
     2763            VIEW-AS ALERT-BOX ERROR.
     2764            UNDO, RETURN ERROR.
     2765         END.
     2766         if buf_tt0-rule-call-param.param-2-data-type <> '':U then do:
     2767           assign
     2768           v-ok = no
     2769           v-value-character = buf_tt0-rule-call-param.param-value-character
     2770           v-value-date = buf_tt0-rule-call-param.param-value-date
     2771           v-value-decimal = buf_tt0-rule-call-param.param-value-decimal
     2772           v-value-integer = buf_tt0-rule-call-param.param-value-integer
     2773           v-value-logical = buf_tt0-rule-call-param.param-value-logical
     2774           .
     2775           run ref/rule-dtt.p (
     2776                               input ?
     2777                               ,input 'ПРОВЕРКА':U
     2778                               ,input 'dis-card-type':U
     2779                               ,input buf_tt0-rule-call-param.param-data-type
     2780                               ,input buf_tt0-rule-call-param.param-2-data-type
     2781                               ,input buf_tt0-rule-call-param.param-3-data-type
     2782                               ,input buf_tt0-rule-call-param.p-index
     2783                               ,input-output v-value-character
     2784                               ,input-output v-value-date
     2785                               ,input-output v-value-decimal
     2786                               ,input-output v-value-integer
     2787                               ,input-output v-value-logical
     2788                               ,output v-ok
     2789                               ) no-error.
     2790           if error-status:error
     2791           or not v-ok then do:
     2792             undo,  return error substitute("Неверное значение параметра № &1(&8) для вызова правила &2:&3" +
     2793                                                 "точка вызова &4, кодекс &5, набор правил &6, порядок вызова &7"
     2794                                                 , buf_tt0-rule-call-param.param-num
     2795                                                 , tt0-rule-call-param.rule_id
     2796                                                 , chr(10)
     2797                                                 , X_dis-card-type.uniq-key-rec
     2798                                                 , tt0-rule-call-param.codex_id
     2799                                                 , tt0-rule-call-param.ruleset_id
     2800                                                 , tt0-rule-call-param.order_id
     2801                                                 , buf_tt0-rule-call-param.param-name
     2802                                                 ).
     2803           end.
     2804         end.
     2805       end.
     2806       assign
     2807       v-dc-type = p-dc-type
     2808       v-emitent-host-code = p-emitent-host-code.
     2809   END PROCEDURE.
     2810   PROCEDURE set-rule-profile :
     2811   define input parameter p-profile-id as integer no-undo.
     2812   define buffer buf_rule-profile for ub.rule-profile.
     2813   define buffer buf_rule-by-profile for ub.rule-by-profile.
     2814   define buffer buf_rule for ub.rule.
     2815     FIND FIRST buf_rule-profile NO-LOCK WHERE
     2816               buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     2817     IF NOT AVAILABLE buf_rule-profile THEN DO:
     2818        MESSAGE
     2819        "Не найден профайл для работы экспорта в текстовый файл"
     2820         VIEW-AS ALERT-BOX ERROR.
     2821        UNDO, RETURN ERROR.
     2822     END.
     2823     FIND FIRST buf_rule-by-profile NO-LOCK WHERE
     2824             buf_rule-by-profile.profile_id = p-profile-id
     2825         AND buf_rule-by-profile.codex_id = v-codex-id
     2826         AND buf_rule-by-profile.ruleset_id = v-ruleset-id NO-ERROR.
     2827     IF NOT AVAILABLE buf_rule-by-profile THEN DO:
     2828        MESSAGE
     2829        "Не найдено или неопределено правило для импорта из текстового файла"
     2830         VIEW-AS ALERT-BOX ERROR.
     2831        UNDO, RETURN ERROR.
     2832     END.
     2833     FIND FIRST buf_rule NO-LOCK WHERE
     2834           buf_rule.rule_id = buf_rule-by-profile.rule_id no-error.
     2835     IF NOT AVAILABLE buf_rule THEN DO:
     2836        MESSAGE
     2837        substitute("Не найдено правило &1 для импорта из текстового файла", buf_rule-by-profile.rule_id)
     2838         VIEW-AS ALERT-BOX ERROR.
     2839        UNDO, RETURN ERROR.
     2840     END.
     2841   find first X_rule-profile no-lock where
     2842           recid(X_rule-profile) = recid(buf_rule-profile).
     2843   find first X_rule-by-profile no-lock where
     2844           recid(X_rule-by-profile) = recid(buf_rule-by-profile).
     2845   find first X_rule no-lock where
     2846           recid(X_rule) = recid(buf_rule).
     2847   v-rule-profile-id = p-profile-id.
     2848   END PROCEDURE.
