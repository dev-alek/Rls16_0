     1208   procedure uf-get :
     1209     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1210     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1211     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1212     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1213     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1214     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1215     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1216     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1217     do
     1218     on error undo, return error
     1219     :
     1220       define buffer buf_usr-flt for ubflt.usr-flt .
     1221       define variable v-use-List_     as logical   no-undo .
     1222       define variable v-type-List_     as character no-undo .
     1223       define variable v-format-List_   as character no-undo .
     1224       define variable v-use-Naim      as logical   no-undo .
     1225       define variable v-type-Naim      as character no-undo .
     1226       define variable v-format-Naim    as character no-undo .
     1227       define variable v-use-print-graft as logical   no-undo .
     1228       define variable v-use-sort-gr     as logical   no-undo .
     1229       define variable v-use-type-price  as logical   no-undo .
     1230       define variable v-use-type-val    as logical   no-undo .
     1231       define variable v-label          as character no-undo .
     1232       define variable v-tooltip        as character no-undo .
     1233       define variable v-user-can-edit  as logical   no-undo .
     1234       define variable v-output-display as logical   no-undo .
     1235       define variable v-other          as character no-undo .
     1236       run uf-name in this-procedure
     1237          (input  entry(1, p-code, chr(4))
     1238         ,output v-use-List_
     1239         ,output v-type-List_
     1240         ,output v-format-List_
     1241         ,output v-use-Naim
     1242         ,output v-type-Naim
     1243         ,output v-format-Naim
     1244         ,output v-use-print-graft
     1245         ,output v-use-sort-gr
     1246         ,output v-use-type-price
     1247         ,output v-use-type-val
     1248         ,output v-label
     1249         ,output v-tooltip
     1250         ,output v-user-can-edit
     1251         ,output v-output-display
     1252         ,output v-other
     1253         ) no-error .
     1254       if error-status :error then do:
     1255         undo, return error return-value .
     1256       end.
     1257       find first buf_usr-flt no-lock where
     1258                  buf_usr-flt.Call-point     = p-code AND
     1259                  buf_usr-flt.user-name       = p-user-name
     1260         no-error .
     1261       if avail buf_usr-flt then do:
     1262         assign
     1263         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1264         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1265         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1266         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1267         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1268         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1269         .
     1270       end.
     1271       else do:
     1272         assign
     1273         p-List_        = (if v-use-List_       then "":U                    else ?)
     1274         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1275         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1276         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1277         p-type-price   = (if v-use-type-price  then no                      else ?)
     1278         p-type-val     = (if v-use-List_       then no                      else ?)
     1279         .
     1280       end.
     1281     end.
     1282   end procedure.
     1283   procedure uf-set :
     1284     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1285     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1286     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1287     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1288     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1289     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1290     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1291     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1292     do
     1293     on error undo, return error
     1294     :
     1295       define buffer buf_usr-flt for ubflt.usr-flt .
     1296       define variable v-use-List_     as logical   no-undo .
     1297       define variable v-type-List_     as character no-undo .
     1298       define variable v-format-List_   as character no-undo .
     1299       define variable v-use-Naim      as logical   no-undo .
     1300       define variable v-type-Naim      as character no-undo .
     1301       define variable v-format-Naim    as character no-undo .
     1302       define variable v-use-print-graft as logical   no-undo .
     1303       define variable v-use-sort-gr   as logical   no-undo .
     1304       define variable v-use-type-price as logical   no-undo .
     1305       define variable v-use-type-val  as logical   no-undo .
     1306       define variable v-tooltip        as character no-undo .
     1307       define variable v-label          as character no-undo .
     1308       define variable v-user-can-edit  as logical   no-undo .
     1309       define variable v-output-display as logical   no-undo .
     1310       define variable v-other          as character no-undo .
     1311       run uf-name in this-procedure
     1312         (input  entry(1, p-code, chr(4))
     1313         ,output v-use-List_
     1314         ,output v-type-List_
     1315         ,output v-format-List_
     1316         ,output v-use-Naim
     1317         ,output v-type-Naim
     1318         ,output v-format-Naim
     1319         ,output v-use-print-graft
     1320         ,output v-use-sort-gr
     1321         ,output v-use-type-price
     1322         ,output v-use-type-val
     1323         ,output v-label
     1324         ,output v-tooltip
     1325         ,output v-user-can-edit
     1326         ,output v-output-display
     1327         ,output v-other
     1328         ) no-error .
     1329       if error-status :error then do:
     1330         undo, return error return-value .
     1331       end.
     1332       find first buf_usr-flt where
     1333                  buf_usr-flt.Call-point     = p-code AND
     1334                  buf_usr-flt.user-name       = p-user-name
     1335         no-error .
     1336       if not avail buf_usr-flt then do:
     1337           create buf_usr-flt .
     1338           assign
     1339           buf_usr-flt.call-point = p-code
     1340           buf_usr-flt.user-name  = p-user-name
     1341           .
     1342       end.
     1343       if avail buf_usr-flt then do:
     1344        assign
     1345        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1346        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1347        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1348        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1349        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1350        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1351       .
     1352       release buf_usr-flt.
     1353       end.
     1354       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1355     end.
     1356   end procedure.
     1357   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358     define variable v-cntxt-db-num        as integer   no-undo .
     1359     define variable v-cntxt-userid        as character no-undo .
     1360     define variable v-cntxt-level         as character no-undo .
     1361     define variable v-cntxt-host-code-obj as integer   no-undo .
     1362     define variable v-cntxt-obj-type      as character no-undo .
     1363     define variable v-cntxt-obj-code      as integer   no-undo .
     1364     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1365     define variable v-cntxt-is-admin      as logical   no-undo .
     1366   define variable parparentproc   as widget-handle no-undo .
     1367   DEFINE new shared TEMP-TABLE tt-cash-pay  no-undo LIKE ub.cash-pay.
     1368   FUNCTION display-cp RETURNS CHARACTER
     1369     ( input p-obj-code as integer, input p-obj-name as character )  FORWARD.
     1370   DEFINE BUTTON b-cp
     1371        IMAGE-UP FILE "btn-down-arrow":U
     1372        IMAGE-DOWN FILE "btn-down-arrow":U
     1373        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1374        LABEL "Btn 1"
     1375        SIZE 3 BY 1.
     1376   DEFINE VARIABLE E-cp AS CHARACTER
     1377        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1378        SIZE 50 BY 9.6 NO-UNDO.
     1379   DEFINE VARIABLE f-pay-card AS CHARACTER FORMAT "X(19)":U
     1380        LABEL "№ плат. карты"
     1381        VIEW-AS FILL-IN
     1382        SIZE 20 BY 1 NO-UNDO.
     1383   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Учитываемые в отчете типы кассовых платежей"
     1384         VIEW-AS TEXT
     1385        SIZE 50 BY .67
     1386        FGCOLOR 4  NO-UNDO.
     1387   DEFINE VARIABLE T-discnt-dtl AS LOGICAL INITIAL no
     1388        LABEL "Детализация по видам скидок"
     1389        VIEW-AS TOGGLE-BOX
     1390        SIZE 46.1 BY 1 NO-UNDO.
     1391   DEFINE FRAME F-Main
     1392        b-cp AT ROW 2 COL 2 WIDGET-ID 4
     1393        E-cp AT ROW 2.07 COL 6 NO-LABEL WIDGET-ID 2
     1394        T-discnt-dtl AT ROW 12.73 COL 2.5
     1395        f-pay-card AT ROW 13.8 COL 4 WIDGET-ID 6
     1396        FILL-IN-1 AT ROW 1 COL 4 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1397       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1398            SIDE-LABELS NO-UNDERLINE THREE-D
     1399            AT COL 1 ROW 1
     1400            SIZE 67.88 BY 16.21.
     1401   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1402   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1403   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1404   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1405   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1406   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1407   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1408   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1409       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1410   RUN ensure-broker.
     1411   THIS-PROCEDURE:ADM-DATA =
     1412        'ADM1.1~`':U +
     1413        'SmartObject~`':U +
     1414        'FRAME~`':U +
     1415        'NO ~`':U +
     1416        '~`':U +
     1417        '~`':U +
     1418        '~`':U +
     1419        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1420           + "~`":U +
     1421        'Layout,Hide-on-Init~`':U +
     1422        '~`':U +
     1423        '~`':U +
     1424        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1425        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1426            THEN "^^":U
     1427        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1428             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1429   PROCEDURE adm-apply-entry :
     1430     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1431   END PROCEDURE.
     1432   PROCEDURE adm-destroy :
     1433    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1434   END PROCEDURE.
     1435   PROCEDURE adm-disable :
     1436       DISABLE b-cp E-cp T-discnt-dtl f-pay-card FILL-IN-1 WITH FRAME F-Main.
     1437       RUN dispatch ('disable-fields':U).
     1438       RUN set-attribute-list ('ENABLED=no':U).
     1439       RETURN.
     1440   END PROCEDURE.
     1441   PROCEDURE adm-edit-attribute-list :
     1442         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1443         RETURN.
     1444   END PROCEDURE.
     1445   PROCEDURE adm-enable :
     1446       ENABLE UNLESS-HIDDEN b-cp E-cp T-discnt-dtl f-pay-card FILL-IN-1 WITH FRAME F-Main.
     1447       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1448       RUN set-attribute-list ('ENABLED=yes':U).
     1449       RETURN.
     1450   END PROCEDURE.
     1451   PROCEDURE adm-exit :
     1452        RUN notify ('exit':U).
     1453     RETURN.
     1454   END PROCEDURE.
     1455   PROCEDURE adm-hide :
     1456     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1457   END PROCEDURE.
     1458   PROCEDURE adm-initialize :
     1459     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1460   END PROCEDURE.
     1461   PROCEDURE adm-show-errors :
     1462       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1463       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1464           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1465       END.
     1466       RETURN.
     1467   END PROCEDURE.
     1468   PROCEDURE adm-UIB-mode :
     1469     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1470   END PROCEDURE.
     1471   PROCEDURE adm-view :
     1472     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1473   END PROCEDURE.
     1474   PROCEDURE dispatch :
     1475       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1476       RUN broker-dispatch IN adm-broker-hdl
     1477           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1478       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1479   END PROCEDURE.
     1480   PROCEDURE ensure-broker :
     1481   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1482   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1483   DO:
     1484       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1485       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1486   END.
     1487   END PROCEDURE.
     1488   PROCEDURE get-attribute :
     1489     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1490     RUN broker-get-attribute IN adm-broker-hdl
     1491         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1492     RETURN RETURN-VALUE.
     1493   END PROCEDURE.
     1494   PROCEDURE get-attribute-list :
     1495     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1496     RUN broker-get-attribute-list IN adm-broker-hdl
     1497         (INPUT THIS-PROCEDURE,
     1498          INPUT ?,
     1499          OUTPUT p-attr-list) NO-ERROR.
     1500     RETURN.
     1501   END PROCEDURE.
     1502   PROCEDURE new-state :
     1503     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1504     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1505     RETURN.
     1506   END PROCEDURE.
     1507   PROCEDURE notify :
     1508     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1509     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1510     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1511         RETURN "ADM-ERROR":U.
     1512     RETURN.
     1513   END PROCEDURE.
     1514   PROCEDURE set-attribute-list :
     1515     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1516     RUN ensure-broker.
     1517     RUN broker-set-attribute-list IN adm-broker-hdl
     1518         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1519     RETURN.
     1520   END PROCEDURE.
     1521   PROCEDURE set-position :
     1522       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1523       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1524       IF VALID-HANDLE(adm-object-hdl) THEN
     1525       DO:
     1526           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1527           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1528           DO:
     1529             IF p-row = 0 THEN p-row =
     1530               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1531             IF p-col = 0 THEN p-col =
     1532               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1533           END.
     1534           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1535           DO:
     1536             parent-hdl = adm-object-hdl:PARENT.
     1537             IF p-row = 0 THEN p-row =
     1538               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1539                 parent-hdl:ROW.
     1540             IF p-col = 0 THEN p-col =
     1541               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1542                 parent-hdl:COL.
     1543           END.
     1544           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1545           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1546         ASSIGN adm-object-hdl:ROW    =   p-row
     1547                adm-object-hdl:COLUMN =   p-col.
     1548       END.
     1549       RETURN.
     1550   END PROCEDURE.
     1551   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1552       STRING(adm-object-hdl)).
     1553   PAUSE 0 BEFORE-HIDE.
     1554   PROCEDURE adm-change-page :
     1555     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1556     END PROCEDURE.
     1557   PROCEDURE delete-page :
     1558     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1559     RUN broker-delete-page IN adm-broker-hdl
     1560         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1561     END PROCEDURE.
     1562   PROCEDURE init-object :
     1563     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1564     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1565     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1566     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1567     RUN broker-init-object IN adm-broker-hdl
     1568         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1569          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1570     RETURN.
     1571   END PROCEDURE.
     1572   PROCEDURE init-pages :
     1573     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1574     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1575         INPUT p-page-list) NO-ERROR.
     1576     END PROCEDURE.
     1577   PROCEDURE select-page :
     1578     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1579     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1580         INPUT p-page#) NO-ERROR.
     1581     END PROCEDURE.
     1582   PROCEDURE view-page :
     1583     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1584     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1585         INPUT p-page#).
     1586     END PROCEDURE.
     1587   ON CHOOSE OF b-cp IN FRAME F-Main
     1588   DO:
     1589     run select-cash-pays in this-procedure no-error.
     1590   END.
     1591   if not this-procedure :persistent
     1592   then do:
     1593     message
     1594       vss-workfile vss-revision vss-description skip
     1595       "Ошибка при запуске процедуры" skip
     1596       "Данную процедуру следует запускать только с параметром persistent" skip
     1597       view-as alert-box error .
     1598     undo, return error .
     1599   end.
     1600   PROCEDURE adm-create-objects :
     1601   END PROCEDURE.
     1602   PROCEDURE adm-row-available :
     1603     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1604     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1605     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1606     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1607     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1608     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1609     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1610     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1611     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1612     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1613     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1614     IF adm-updating-record THEN RETURN.
     1615     RUN get-attribute ('FIELDS-ENABLED':U).
     1616     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1617     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1618         OUTPUT link-handle) NO-ERROR.
     1619     IF link-handle = "":U THEN
     1620         RETURN.
     1621     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1622     IF NUM-ENTRIES(link-handle) > 1 THEN
     1623         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1624             "encountered more than one RECORD-SOURCE.":U SKIP
     1625             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1626                VIEW-AS ALERT-BOX ERROR.
     1627     RUN get-attribute ('Key-Name':U).
     1628     key-name = RETURN-VALUE.
     1629     IF key-name = "":U THEN key-name = ?.
     1630     IF key-name NE ? THEN DO:
     1631       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1632         NO-ERROR.
     1633       IF key-value NE ? THEN
     1634         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1635     END.
     1636   IF VALID-HANDLE (adm-object-hdl) THEN
     1637       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1638   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1639   END PROCEDURE.
     1640   PROCEDURE disable_UI :
     1641     HIDE FRAME F-Main.
     1642     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1643   END PROCEDURE.
     1644   PROCEDURE enable_UI :
     1645     DISPLAY E-cp T-discnt-dtl f-pay-card FILL-IN-1
     1646         WITH FRAME F-Main.
     1647     ENABLE b-cp E-cp T-discnt-dtl f-pay-card FILL-IN-1
     1648         WITH FRAME F-Main.
     1649   END PROCEDURE.
     1650   PROCEDURE get-cash-group :
     1651   define variable v-grp-int-code as integer no-undo.
     1652   define variable v-grp-name as character no-undo.
     1653   define variable v-cash-pay-list as character no-undo.
     1654   define variable ii as integer no-undo.
     1655   run uf-get in this-procedure(
     1656        input  'pychk-rep':U
     1657       ,input  g#userid
     1658       ,output v-uf-List_
     1659       ,output v-uf-Naim
     1660       ,output v-uf-print-graft
     1661       ,output v-uf-sort-gr
     1662       ,output v-uf-type-price
     1663       ,output v-uf-type-val
     1664   )  no-error.
     1665   if not error-status:error then do:
     1666       do ii = 1 to num-entries (v-uf-list_, chr(4)):
     1667           assign
     1668           v-grp-int-code = integer(entry(1, entry(ii, v-uf-list_, chr(4)), "=":U))
     1669           v-grp-name = entry(2, entry(ii, v-uf-list_, chr(4)), "=":U)
     1670           v-cash-pay-list = entry(ii, v-uf-Naim, chr(4))
     1671           .
     1672           run proc-add-cash-group in this-procedure (chr(4) + string(v-grp-int-code), v-grp-name, v-cash-pay-list) no-error.
     1673           if error-status:error then undo, return error.
     1674       end.
     1675   end.
     1676   END PROCEDURE.
     1677   PROCEDURE local-apply-layout :
     1678     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1679   for each tt-cash-pay:
     1680       delete tt-cash-pay.
     1681   end.
     1682   END PROCEDURE.
     1683   PROCEDURE local-initialize :
     1684     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1685     parparentproc = my-handle.
     1686   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1687     run mainmenu_getcntxt in parparentproc
     1688       (output v-cntxt-db-num
     1689       ,output v-cntxt-userid
     1690       ,output v-cntxt-level
     1691       ,output v-cntxt-host-code-obj
     1692       ,output v-cntxt-obj-type
     1693       ,output v-cntxt-obj-code
     1694       ,output v-cntxt-db-num-obj
     1695       ,output v-cntxt-is-admin
     1696       ) .
     1697   END PROCEDURE.
     1698   PROCEDURE My-report :
     1699   find first tt-cash-pay no-error.
     1700   if not available tt-cash-pay then do:
     1701     message
     1702     "Не выбран ни один тип кассового платежа"
     1703     view-as alert-box error .
     1704     return .
     1705   end.
     1706   run My-var IN THIS-PROCEDURE.
     1707   if return-value = "error":U then return.
     1708   run cus/r-cpych.p ( input my-handle
     1709                       ,input T-discnt-dtl
     1710                       ,input f-pay-card) no-error.
     1711   END PROCEDURE.
     1712   PROCEDURE My-var :
     1713   Assign
     1714   frame F-Main t-discnt-dtl
     1715   f-pay-card
     1716   .
     1717   Assign
     1718    STR-obj-type = ''
     1719    STR-obj-code = ''
     1720    STR-obj-name = ''
     1721    STR-obj      = ''.
     1722   For each obj-list no-lock:
     1723    Assign
     1724    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1725    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1726    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1727    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1728   End.
     1729   Reportname = "Отчет по продажам в разрезе платежных карт "
     1730   .
     1731   ReportHeader =  (if t-discnt-dtl
     1732                     then "С детализацией по типам скидок"
     1733                    else "":U) + chr(10) +
     1734                   (if f-pay-card <> ''
     1735                    then substitute("Для платежной карты &1", f-pay-card)
     1736                    else '':U) + chr(10) +
     1737                    "Учитываемые типы кассовых платежей:"
     1738   .
     1739   for each tt-cash-pay:
     1740     assign
     1741     reportHeader = reportHeader +  chr(10) +
     1742                    substitute("&1 - &2"
     1743                               , string(tt-cash-pay.cdpay-code, ">>>>9")
     1744                               , tt-cash-pay.obj-name )
     1745     .
     1746   end.
     1747   For each obj-list no-lock:
     1748    Assign
     1749    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1750    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1751    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1752    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1753   End.
     1754   END PROCEDURE.
     1755   PROCEDURE select-cash-pays :
     1756   define variable v-ii as integer   no-undo .
     1757   define variable v-rid-list as character no-undo .
     1758   define variable glog AS LOGICAL no-undo .
     1759   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1760   DEFINE BUFFER buf_tt-cash-pay FOR tt-cash-pay.
     1761   ASSIGN
     1762   e-cp:SCREEN-VALUE IN FRAME F-Main = ''.
     1763   FOR EACH buf_tt-cash-pay:
     1764      FIND FIRST buf_cash-pay NO-LOCK WHERE
     1765                   buf_cash-pay.cdpay-code = buf_tt-cash-pay.cdpay-code
     1766          AND buf_cash-pay.curr-code = buf_tt-cash-pay.curr-code NO-ERROR.
     1767      IF AVAILABLE buf_cash-pay THEN DO:
     1768          v-rid-list = v-rid-list + (IF v-rid-list = '' THEN '' ELSE chr(44)) + STRING(RECID(buf_cash-pay)).
     1769      END.
     1770   END.
     1771   empty temp-table tt-cash-pay.
     1772   run ref/cashpays.w
     1773       ( input parparentproc
     1774       , input "b-mark,b-sel"
     1775       , input 'все':U
     1776       , input v-cntxt-host-code-obj
     1777       , input v-cntxt-obj-type
     1778       , input v-cntxt-obj-code
     1779       , output v-rid-list ) no-error .
     1780   if v-rid-list <> '' then do:
     1781     do v-ii = 1 to num-entries(v-rid-list):
     1782       find first buf_cash-pay no-lock where
     1783                 recid(buf_cash-pay) = integer(entry(v-ii, v-rid-list)) no-error.
     1784       if available buf_cash-pay then do:
     1785          FIND FIRST buf_tt-cash-pay NO-LOCK WHERE
     1786                   buf_tt-cash-pay.cdpay-code = buf_cash-pay.cdpay-code
     1787              AND buf_tt-cash-pay.curr-code = buf_cash-pay.curr-code NO-ERROR.
     1788          IF NOT AVAILABLE buf_tt-cash-pay  THEN DO:
     1789             CREATE buf_tt-cash-pay.
     1790             BUFFER-COPY buf_cash-pay TO buf_tt-cash-pay.
     1791          END.
     1792          glog = e-cp:INSERT-STRING ( display-cp(
     1793                                                    buf_tt-cash-pay.cdpay-code
     1794                                                    , buf_tt-cash-pay.obj-name )) in frame F-Main .
     1795          glog = e-cp:INSERT-STRING ( chr(10) ) in frame F-Main .
     1796          release buf_tt-cash-pay.
     1797       end.
     1798     end.
     1799   end.
     1800   else do:
     1801     undo, return error .
     1802   end.
     1803   END PROCEDURE.
     1804   PROCEDURE send-records :
     1805   END PROCEDURE.
     1806   PROCEDURE state-changed :
     1807     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1808     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1809   END PROCEDURE.
     1810   FUNCTION display-cp RETURNS CHARACTER
     1811     ( input p-obj-code as integer, input p-obj-name as character ) :
     1812   define variable v-string as character no-undo .
     1813   v-string = substitute("&1   &2",  string(p-obj-code, ">>>>9"), p-obj-name).
     1814   return v-string.
     1815   END FUNCTION.
