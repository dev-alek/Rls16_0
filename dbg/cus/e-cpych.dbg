      412   def
      413    shared
      414   temp-table  obj-list no-undo
      415     field obj-type like ub.clients.obj-type
      416     field obj-code like ub.clients.obj-code
      417     field obj-name like ub.clients.obj-name
      418     field obj-id   as integer
