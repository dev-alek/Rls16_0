      424   procedure create_obj-list :
      425      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      426      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      427      do
      428      on error undo, return error return-value
      429      :
      430         define buffer cli-obj for ub.clients .
      431         define variable p-var as integer no-undo .
      432         define buffer buf_obj-list for obj-list .
      433         find last buf_obj-list  use-index pi no-error .
      434         if available buf_obj-list
      435         then
      436            p-var = buf_obj-list.obj-id + 1.
      437         else
      438            p-var = 1.
      439         find first cli-obj where
      440                   cli-obj.obj-type = p-obj-type
      441               and cli-obj.obj-code = p-obj-code
      442         no-lock no-error.
      443         if available cli-obj
      444         then do:
      445            create buf_obj-list.
      446            assign
      447               buf_obj-list.obj-id   = p-var
      448               buf_obj-list.obj-code = cli-obj.obj-code
      449               buf_obj-list.obj-type = cli-obj.obj-type
      450               buf_obj-list.obj-name = cli-obj.obj-name
      451               buf_obj-list.db-num   = cli-obj.db-num
      452            .
      453         end.
      454      end.
      455   end.
