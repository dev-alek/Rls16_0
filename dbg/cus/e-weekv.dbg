      367   def
      368    shared
      369   temp-table  obj-list no-undo
      370     field obj-type like ub.clients.obj-type
      371     field obj-code like ub.clients.obj-code
      372     field obj-name like ub.clients.obj-name
      373     field obj-id   as integer
