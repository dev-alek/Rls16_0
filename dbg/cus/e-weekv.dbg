      379   procedure create_obj-list :
      380      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      381      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      382      do
      383      on error undo, return error return-value
      384      :
      385         define buffer cli-obj for ub.clients .
      386         define variable p-var as integer no-undo .
      387         define buffer buf_obj-list for obj-list .
      388         find last buf_obj-list  use-index pi no-error .
      389         if available buf_obj-list
      390         then
      391            p-var = buf_obj-list.obj-id + 1.
      392         else
      393            p-var = 1.
      394         find first cli-obj where
      395                   cli-obj.obj-type = p-obj-type
      396               and cli-obj.obj-code = p-obj-code
      397         no-lock no-error.
      398         if available cli-obj
      399         then do:
      400            create buf_obj-list.
      401            assign
      402               buf_obj-list.obj-id   = p-var
      403               buf_obj-list.obj-code = cli-obj.obj-code
      404               buf_obj-list.obj-type = cli-obj.obj-type
      405               buf_obj-list.obj-name = cli-obj.obj-name
      406               buf_obj-list.db-num   = cli-obj.db-num
      407            .
      408         end.
      409      end.
      410   end.
