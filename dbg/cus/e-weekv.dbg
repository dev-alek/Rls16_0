     1477   obj-code
     1478   doc-date
     1479   .
     1480   FUNCTION get-weekday-name RETURNS CHARACTER
     1481     ( input p-weekday as integer )  FORWARD.
     1482   FUNCTION get-weekday-name-short RETURNS CHARACTER
     1483     ( input p-weekday as integer )  FORWARD.
     1484   DEFINE VARIABLE RS_wdays AS INTEGER
     1485        VIEW-AS RADIO-SET VERTICAL
     1486        RADIO-BUTTONS
     1487             "Item 2", 2,
     1488   "Item 3", 3,
     1489   "Item 4", 4,
     1490   "Item 5", 5,
     1491   "Item 6", 6,
     1492   "Item 7", 7,
     1493   "Item 1", 1
     1494        SIZE 24.88 BY 6.92 NO-UNDO.
     1495   DEFINE RECTANGLE RECT-1
     1496        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1497        SIZE 29.13 BY 8.88.
     1498   DEFINE FRAME F-Main
     1499        RS_wdays AT ROW 3.21 COL 3.88 NO-LABEL
     1500        "Начало отчетной недели" VIEW-AS TEXT
     1501             SIZE 23.38 BY .71 AT ROW 2.13 COL 4
     1502             FGCOLOR 4
     1503        RECT-1 AT ROW 1.92 COL 2
     1504       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1505            SIDE-LABELS NO-UNDERLINE THREE-D
     1506            AT COL 1 ROW 1
     1507            SIZE 32.25 BY 11.88.
     1508   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1509   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1510   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1511   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1512   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1513   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1514   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1515   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1516       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1517   RUN ensure-broker.
     1518   THIS-PROCEDURE:ADM-DATA =
     1519        'ADM1.1~`':U +
     1520        'SmartObject~`':U +
     1521        'FRAME~`':U +
     1522        'NO ~`':U +
     1523        '~`':U +
     1524        '~`':U +
     1525        '~`':U +
     1526        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1527           + "~`":U +
     1528        'Layout,Hide-on-Init~`':U +
     1529        '~`':U +
     1530        '~`':U +
     1531        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1532        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1533            THEN "^^":U
     1534        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1535             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1536   PROCEDURE adm-apply-entry :
     1537     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1538   END PROCEDURE.
     1539   PROCEDURE adm-destroy :
     1540    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1541   END PROCEDURE.
     1542   PROCEDURE adm-disable :
     1543       DISABLE RECT-1 RS_wdays WITH FRAME F-Main.
     1544       RUN dispatch ('disable-fields':U).
     1545       RUN set-attribute-list ('ENABLED=no':U).
     1546       RETURN.
     1547   END PROCEDURE.
     1548   PROCEDURE adm-edit-attribute-list :
     1549         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1550         RETURN.
     1551   END PROCEDURE.
     1552   PROCEDURE adm-enable :
     1553       ENABLE UNLESS-HIDDEN RECT-1 RS_wdays WITH FRAME F-Main.
     1554       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1555       RUN set-attribute-list ('ENABLED=yes':U).
     1556       RETURN.
     1557   END PROCEDURE.
     1558   PROCEDURE adm-exit :
     1559        RUN notify ('exit':U).
     1560     RETURN.
     1561   END PROCEDURE.
     1562   PROCEDURE adm-hide :
     1563     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1564   END PROCEDURE.
     1565   PROCEDURE adm-initialize :
     1566     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1567   END PROCEDURE.
     1568   PROCEDURE adm-show-errors :
     1569       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1570       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1571           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1572       END.
     1573       RETURN.
     1574   END PROCEDURE.
     1575   PROCEDURE adm-UIB-mode :
     1576     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1577   END PROCEDURE.
     1578   PROCEDURE adm-view :
     1579     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1580   END PROCEDURE.
     1581   PROCEDURE dispatch :
     1582       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1583       RUN broker-dispatch IN adm-broker-hdl
     1584           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1585       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1586   END PROCEDURE.
     1587   PROCEDURE ensure-broker :
     1588   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1589   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1590   DO:
     1591       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1592       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1593   END.
     1594   END PROCEDURE.
     1595   PROCEDURE get-attribute :
     1596     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1597     RUN broker-get-attribute IN adm-broker-hdl
     1598         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1599     RETURN RETURN-VALUE.
     1600   END PROCEDURE.
     1601   PROCEDURE get-attribute-list :
     1602     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1603     RUN broker-get-attribute-list IN adm-broker-hdl
     1604         (INPUT THIS-PROCEDURE,
     1605          INPUT ?,
     1606          OUTPUT p-attr-list) NO-ERROR.
     1607     RETURN.
     1608   END PROCEDURE.
     1609   PROCEDURE new-state :
     1610     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1611     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1612     RETURN.
     1613   END PROCEDURE.
     1614   PROCEDURE notify :
     1615     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1616     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1617     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1618         RETURN "ADM-ERROR":U.
     1619     RETURN.
     1620   END PROCEDURE.
     1621   PROCEDURE set-attribute-list :
     1622     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1623     RUN ensure-broker.
     1624     RUN broker-set-attribute-list IN adm-broker-hdl
     1625         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1626     RETURN.
     1627   END PROCEDURE.
     1628   PROCEDURE set-position :
     1629       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1630       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1631       IF VALID-HANDLE(adm-object-hdl) THEN
     1632       DO:
     1633           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1634           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1635           DO:
     1636             IF p-row = 0 THEN p-row =
     1637               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1638             IF p-col = 0 THEN p-col =
     1639               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1640           END.
     1641           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1642           DO:
     1643             parent-hdl = adm-object-hdl:PARENT.
     1644             IF p-row = 0 THEN p-row =
     1645               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1646                 parent-hdl:ROW.
     1647             IF p-col = 0 THEN p-col =
     1648               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1649                 parent-hdl:COL.
     1650           END.
     1651           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1652           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1653         ASSIGN adm-object-hdl:ROW    =   p-row
     1654                adm-object-hdl:COLUMN =   p-col.
     1655       END.
     1656       RETURN.
     1657   END PROCEDURE.
     1658   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1659       STRING(adm-object-hdl)).
     1660   PAUSE 0 BEFORE-HIDE.
     1661   PROCEDURE adm-change-page :
     1662     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1663     END PROCEDURE.
     1664   PROCEDURE delete-page :
     1665     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1666     RUN broker-delete-page IN adm-broker-hdl
     1667         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1668     END PROCEDURE.
     1669   PROCEDURE init-object :
     1670     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1671     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1672     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1673     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1674     RUN broker-init-object IN adm-broker-hdl
     1675         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1676          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1677     RETURN.
     1678   END PROCEDURE.
     1679   PROCEDURE init-pages :
     1680     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1681     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1682         INPUT p-page-list) NO-ERROR.
     1683     END PROCEDURE.
     1684   PROCEDURE select-page :
     1685     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1686     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1687         INPUT p-page#) NO-ERROR.
     1688     END PROCEDURE.
     1689   PROCEDURE view-page :
     1690     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1691     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1692         INPUT p-page#).
     1693     END PROCEDURE.
     1694   ON LEAVE OF RS_wdays IN FRAME F-Main
     1695   DO:
     1696     assign
     1697       RS_wdays
     1698       .
     1699   END.
     1700   if not this-procedure :persistent
     1701   then do:
     1702     message
     1703       vss-workfile vss-revision vss-description skip
     1704       "Ошибка при запуске процедуры" skip
     1705       "Данную процедуру следует запускать только с параметром persistent" skip
     1706       view-as alert-box error .
     1707     undo, return error .
     1708   end.
     1709   PROCEDURE adm-create-objects :
     1710   END PROCEDURE.
     1711   PROCEDURE adm-row-available :
     1712     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1713     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1714     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1715     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1716     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1717     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1718     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1719     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1720     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1721     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1722     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1723     IF adm-updating-record THEN RETURN.
     1724     RUN get-attribute ('FIELDS-ENABLED':U).
     1725     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1726     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1727         OUTPUT link-handle) NO-ERROR.
     1728     IF link-handle = "":U THEN
     1729         RETURN.
     1730     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1731     IF NUM-ENTRIES(link-handle) > 1 THEN
     1732         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1733             "encountered more than one RECORD-SOURCE.":U SKIP
     1734             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1735                VIEW-AS ALERT-BOX ERROR.
     1736     RUN get-attribute ('Key-Name':U).
     1737     key-name = RETURN-VALUE.
     1738     IF key-name = "":U THEN key-name = ?.
     1739     IF key-name NE ? THEN DO:
     1740       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1741         NO-ERROR.
     1742       IF key-value NE ? THEN
     1743         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1744     END.
     1745   IF VALID-HANDLE (adm-object-hdl) THEN
     1746       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1747   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1748   END PROCEDURE.
     1749   PROCEDURE check-dates :
     1750   DEFINE INPUT-OUTPUT PARAMETER p-Date-Start as date no-undo.
     1751   DEFINE INPUT-OUTPUT PARAMETER p-Date-END as date no-undo.
     1752   define input parameter p-week-start as integer no-undo .
     1753   DEFINE INPUT PARAMETER loud as logical no-undo.
     1754   define variable new-X-date-start as date no-undo.
     1755   define variable new-X-date-end as date no-undo.
     1756   define variable new1-X-date-start as date no-undo.
     1757   define variable new1-X-date-end as date no-undo.
     1758   define variable new2-X-date-start as date no-undo.
     1759   define variable new2-X-date-end as date no-undo.
     1760   DEFINE VARIABLE v-week-end as integer no-undo .
     1761   define variable jj as integer no-undo.
     1762   define variable loud1 as logical no-undo.
     1763   define variable loud2 as logical no-undo.
     1764   DEFINE VARIABLE v-today as date no-undo .
     1765   DEFINE VARIABLE v-time as integer no-undo .
     1766   run cur-time in this-procedure(output v-today, output v-time).
     1767   assign
     1768   v-week-end = (if p-week-start = 1
     1769                 then 7
     1770                 else (p-week-start - 1)
     1771                 )
     1772   .
     1773    if p-date-start < 01/01/1990 then do:
     1774     message
     1775     "Вы выбрали слишком большой период времени" skip
     1776     "уменьшаем"
     1777     view-as alert-box WARNING.
     1778     assign
     1779     p-date-start = 01/01/1990
     1780     .
     1781    end.
     1782   IF weekday(p-date-start)  <> p-week-start then do:
     1783       assign loud1 = yes.
     1784       do jj = 1 to  7:
     1785           assign
     1786           new1-x-date-start = p-date-start - jj
     1787           .
     1788           if weekday(new1-x-date-start) = p-week-start then do:
     1789               LEAVE.
     1790           end.
     1791       end.
     1792       do jj = 1 to  7:
     1793           assign
     1794           new2-x-date-start = p-date-start + jj
     1795           .
     1796           if weekday(new2-x-date-start) = p-week-start then do:
     1797               LEAVE.
     1798           end.
     1799       end.
     1800   end.
     1801   else do:
     1802     assign
     1803     new1-x-date-start = p-date-start
     1804     new2-x-date-start = p-date-start
     1805     new-x-date-start = p-date-start
     1806     .
     1807   end.
     1808   IF weekday(p-date-end)  <> v-week-end then do:
     1809       assign loud2 = yes.
     1810       do jj = 1 to  7:
     1811           assign
     1812           new1-x-date-end = p-date-end + jj
     1813           .
     1814           if weekday(new1-x-date-end) = v-week-end then do:
     1815               LEAVE.
     1816           end.
     1817       end.
     1818       do jj = 1 to  7:
     1819           assign
     1820           new2-x-date-end = p-date-end - jj
     1821           .
     1822           if weekday(new2-x-date-end) = v-week-end then do:
     1823               LEAVE.
     1824           end.
     1825       end.
     1826   end.
     1827   else do:
     1828     assign
     1829     new1-x-date-end = p-date-end
     1830     new2-x-date-end = p-date-end
     1831     new-x-date-end = p-date-end
     1832     .
     1833   end.
     1834    if loud1 then do:
     1835       assign
     1836       new-x-date-start = (if (abs(p-date-start - new2-x-date-start) < abs(p-date-start - new2-x-date-start)) AND new2-x-date-start < new2-x-date-end
     1837                                     then new2-x-date-start
     1838                                     else new1-x-date-start)
     1839       .
     1840   end.
     1841    if loud2 then do:
     1842       assign
     1843       new-x-date-end = (if (abs(p-date-end - new1-x-date-end) < abs(p-date-end - new2-x-date-end)) or new2-x-date-end <= new2-x-date-start
     1844                                     then new1-x-date-end
     1845                                     else new2-x-date-end)
     1846       .
     1847     end.
     1848    if new-x-date-end > v-today then do:
     1849     assign
     1850     new-x-date-start = new-x-date-start - 7
     1851     new-x-date-end = new-x-date-end - 7
     1852     loud1 = yes
     1853     loud2 = yes
     1854     .
     1855    end.
     1856       if loud and loud1 then
     1857       message "Дата начала периода должна быть" get-weekday-name(p-week-start) skip
     1858               "Заменяем" p-date-start " на " new-x-date-start
     1859       view-as alert-box ERROR.
     1860       if loud and loud2 then
     1861       message "Дата конца периода должна быть" get-weekday-name(v-week-end) skip
     1862               "Заменяем" p-date-end " на " new-x-date-end
     1863       view-as alert-box ERROR.
     1864       assign
     1865       p-date-start = if loud1
     1866                            then new-X-date-start
     1867                             else p-date-start
     1868       p-date-end = if loud2
     1869                           then new-X-date-end
     1870                            else p-date-end
     1871       .
     1872   END PROCEDURE.
     1873   PROCEDURE disable_UI :
     1874     HIDE FRAME F-Main.
     1875     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1876   END PROCEDURE.
     1877   PROCEDURE enable_UI :
     1878     DISPLAY RS_wdays
     1879         WITH FRAME F-Main.
     1880     ENABLE RECT-1 RS_wdays
     1881         WITH FRAME F-Main.
