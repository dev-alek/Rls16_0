      803   define variable var-report-r-b as character no-undo .
      804   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      806     (output var-report-r-b
      807     )  .
      808   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   define  stream PrnLibStream.
      810   procedure prn-lib-prn-file :
      811     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      812     define input parameter p-DIsabledoptions as integer no-undo .
      813     define variable v-report-name as character no-undo .
      814     define variable v-user-action as character no-undo .
      815     define variable v-printed     as logical   no-undo .
      816     define variable v-exist       as logical   no-undo .
      817     do
      818       on error undo, return error
      819       :
      820       run prn-lib-get-report-name  in this-procedure (
      821         input parParentProc
      822         ,output v-report-name
      823         ).
      824   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      826     (input  v-report-name
      827     ,input  2
      828     ,output v-exist
      829     )  .
      830       if NOT v-exist then
      831       DO:
      832         Message
      833           "Нет заданий на печать ! "
      834           view-as alert-box .
      835         Return  .
      836       End.
      837       run gbl/prnfilen.w
      838         (input  ""
      839         ,input  p-DisabledOptions
      840         ,input  string(v-report-name )
      841         ,input  7
      842         ,output v-user-action
      843         ,output v-printed
      844         ) .
      845       if v-printed then
      846       do:
      847         return "YES" .
      848       end.
      849       else
      850       do:
      851         return "NO" .
      852       end.
      853     end.
      854   end procedure.
      855   procedure prn-lib-open-stream :
      856     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      857     define input parameter p-page-size    as integer no-undo .
      858     define input parameter p-is-stream    as logical no-undo .
      859     define input parameter p-append       as logical no-undo .
      860     define variable v-report-name as character no-undo .
      861     do
      862       on error undo, return error
      863       :
      864       run prn-lib-get-report-name  in this-procedure (
      865         input parParentProc
      866         ,output v-report-name
      867         ).
      868       if p-is-stream then
      869       do:
      870         if p-append then
      871         do:
      872           output stream PrnLibStream to value( v-report-name )
      873             page-size value(p-page-size) append .
      874         end.
      875         if not p-append then
      876         do:
      877           output stream PrnLibStream to value( v-report-name )
      878             page-size value(p-page-size) .
      879         end.
      880       end.
      881       if not p-is-stream then
      882       do:
      883         if p-append then
      884         do:
      885           output to value( v-report-name )
      886             page-size value(p-page-size) append .
      887         end.
      888         if not p-append then
      889         do:
      890           output to value( v-report-name )
      891             page-size value(p-page-size) .
      892         end.
      893       end.
      894     end.
      895   end procedure.
      896   procedure prn-lib-open-exp :
      897     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      898     define input parameter p-is-stream    as logical no-undo .
      899     define input parameter p-is-append    as logical no-undo .
      900     define output parameter p-ReportFileName as char init "report" no-undo.
      901     define output parameter p-process as logical no-undo .
      902     define variable glog as logical no-undo .
      903     do
      904       on error undo, return error
      905       :
      906       SYSTEM-DIALOG GET-FILE p-ReportFileName
      907         TITLE      "Укажите путь"
      908         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      909         ASK-OVERWRITE
      910         CREATE-TEST-FILE
      911         SAVE-AS
      912         USE-FILENAME
      913         DEFAULT-EXTENSION "txt"
      914         UPDATE glog
      915         .
      916       if not glog then  return.
      917       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      918       if p-is-stream then
      919       do:
      920         if p-is-append then
      921         do:
      922           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      923         end.
      924         else
      925         do:
      926           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      927         end.
      928       end.
      929       else
      930       do:
      931         if p-is-append then
      932         do:
      933           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      934         end.
      935         else
      936         do:
      937           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      938         end.
      939       end.
      940       p-process = yes.
      941     end.
      942   end procedure.
      943   procedure prn-lib-get-report-name :
      944     define input parameter parParentProc  as widget-handle no-undo.
      945     define output parameter p-report-name as character no-undo .
      946     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      947   end procedure.
      948   procedure prn-lib-reportviewer-report-name :
      949     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      950     define input parameter p-report-name-html as character no-undo .
      951     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      952   end procedure.
      953   procedure prn-lib-reportviewer :
      954     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      955     define input parameter p-report-name-html as character no-undo .
      956     define input parameter p-param        as character no-undo .
      957     define variable v-excel           as character no-undo init 'TRUE' .
      958     define variable v-value-character as character no-undo .
      959     define variable v-value-integer   as character no-undo .
      960     define variable v-value-date      as date      no-undo .
      961     define variable v-value-decimal   as decimal   no-undo .
      962     define variable rep-excel         as logical   no-undo .
      963     define variable excel-string      as character no-undo .
      964     define variable v-param-type      as character no-undo .
      965     define variable v-tth             as handle    no-undo .
      966     run adm/shattri.p (
      967       input "get":U
      968       ,input  ""
      969       ,input  0
      970       ,input  'report-glob':U
      971       ,input  'rep-excel':U
      972       ,output v-value-character
      973       ,output v-value-date
      974       ,output v-value-decimal
      975       ,output v-value-integer
      976       ,output rep-excel
      977       ,output v-param-type
      978       ,INPUT-OUTPUT table-handle v-tth
      979       )  .
      980     if rep-excel then v-excel = "TRUE" .
      981     else v-excel = "FALSE" .
      982     if p-param eq ""
      983     then
      984        p-param = "EXCEL:" + v-excel.
      985     else
      986        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      987     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      988   end procedure.
      989   function diff-list returns character (
      990     input parfirst-list  as character,
      991     input parsecond-list as character,
      992     input pardelim       as character).
      993     if pardelim = ""
      994     or pardelim = ?
      995     then do:
      996       assign
      997         pardelim = ","
      998       .
      999     end.
     1000     def var ind as integer no-undo .
     1001     def var v-elem as character no-undo .
     1002     def var v-result-list as character no-undo init "".
     1003     def var v-num-parfirst-list as integer no-undo .
     1004     assign
     1005       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1006     .
     1007     do ind = 1 to v-num-parfirst-list
     1008     :
     1009       assign
     1010         v-elem = entry(ind, parfirst-list, pardelim)
     1011       .
     1012       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1013         assign
     1014           v-result-list = v-result-list
     1015                         + (if v-result-list > "" then pardelim else "")
     1016                         + v-elem
     1017         .
     1018       end.
     1019     end.
     1020     return v-result-list .
     1021   end function.
     1022   function add-list returns character (
     1023    input parfirst-list  as character,
     1024    input parsecond-list as character,
     1025    input pardelim       as character).
     1026     if pardelim = ""
     1027     or pardelim = ?
     1028     then do:
     1029       assign
     1030         pardelim = ","
     1031       .
     1032     end.
     1033     def var ind as integer no-undo .
     1034     def var v-elem as character no-undo .
     1035     def var v-result-list as character no-undo init "".
     1036     def var v-num-parfirst-list as integer no-undo .
     1037     assign
     1038       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1039     .
     1040     do ind = 1 to v-num-parfirst-list
     1041     :
     1042       assign
     1043         v-elem = entry(ind, parfirst-list, pardelim)
     1044       .
     1045       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1046         assign
     1047           v-result-list = v-result-list
     1048                         + (if v-result-list > "" then pardelim else "")
     1049                         + v-elem
     1050         .
     1051       end.
     1052     end.
     1053     def var v-num-parsecond-list as integer no-undo .
     1054     assign
     1055       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1056     .
     1057     do ind = 1 to v-num-parsecond-list
     1058     :
     1059       assign
     1060         v-elem = entry(ind, parsecond-list, pardelim)
     1061       .
     1062       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1063         assign
     1064           v-result-list = v-result-list
     1065                         + (if v-result-list > "" then pardelim else "")
     1066                         + v-elem
     1067         .
     1068       end.
     1069     end.
     1070     return v-result-list .
     1071   end function.
     1072   function cross-list returns character (
     1073    input parfirst-list  as character,
     1074    input parsecond-list as character,
     1075    input pardelim       as character).
     1076     if pardelim = ""
     1077     or pardelim = ?
     1078     then do:
     1079       assign
     1080         pardelim = ","
     1081       .
     1082     end.
     1083     def var ind as integer no-undo .
     1084     def var v-elem as character no-undo .
     1085     def var v-result-list as character no-undo init "".
     1086     def var v-num-parfirst-list as integer no-undo .
     1087     assign
     1088       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1089     .
     1090     do ind = 1 to v-num-parfirst-list
     1091     :
     1092       assign
     1093         v-elem = entry(ind, parfirst-list, pardelim)
     1094       .
     1095       if lookup(v-elem, v-result-list, pardelim) = 0
     1096       and lookup(v-elem, parsecond-list, pardelim) > 0
     1097       then do:
     1098         assign
     1099           v-result-list = v-result-list
     1100                         + (if v-result-list > "" then pardelim else "")
     1101                         + v-elem
     1102         .
     1103       end.
     1104     end.
     1105     return v-result-list .
     1106   end function.
     1107   function radio-label returns character (
     1108    input par-rs-value  as character,
     1109    input par-rs-radio-buttons as character)
     1110    .
     1111    DEFINE variable v-result-label as character no-undo.
     1112    assign
     1113    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1114                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1115                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1116                             ), par-rs-radio-buttons
     1117                           )
     1118    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1119    .
     1120   return v-result-label.
     1121   end function.
     1122   function m-radio-label returns character (
     1123    input par-rs-value  as character,
     1124    input par-rs-radio-buttons as character,
     1125    input par-delim as character
     1126    )
     1127    .
     1128    DEFINE variable v-result-label as character no-undo.
     1129    assign
     1130    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1131                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1132                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1133                             ), par-rs-radio-buttons, par-delim
     1134                           )
     1135    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1136    .
     1137   return v-result-label.
     1138   end function.
     1139   FUNCTION mixlist returns character
     1140   (
     1141    input parfirst-list  as character
     1142    ,input parsecond-list as character
     1143    ,input pardelim       as character
     1144    ,input pardelim-result as character ) :
     1145     if pardelim = ""
     1146     or pardelim = ?
     1147     then do:
     1148       assign
     1149         pardelim = ","
     1150       .
     1151     end.
     1152     def var ind as integer no-undo .
     1153     def var v-elem1 as character no-undo .
     1154     def var v-elem2 as character no-undo .
     1155     def var v-result-list as character no-undo init "".
     1156     do ind = 1 to num-entries(parfirst-list, pardelim)
     1157     :
     1158       assign
     1159         v-elem1 = entry(ind, parfirst-list, pardelim)
     1160         v-elem2 = entry(ind, parsecond-list, pardelim)
     1161       .
     1162         assign
     1163           v-result-list = v-result-list
     1164                         + (if v-result-list > "" then pardelim-result else "")
     1165                         + v-elem1 + pardelim-result + v-elem2
     1166         .
     1167     end.
     1168     return v-result-list .
     1169   END FUNCTION.
     1170   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1171   define variable v-waitfram-action01         as character   no-undo .
     1172   define variable v-waitfram-action02         as character   no-undo .
     1173   define variable v-waitfram-action03         as character   no-undo .
     1174   define variable mWaitFramTextBeg            as character   no-undo.
     1175   define variable mWaitFramTextEnd            as character   no-undo.
     1176   define variable mWaitFramView               as logical     no-undo.
     1177   define variable mWaitProcEvent              as logical     no-undo init yes.
     1178   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1179   define variable mWaitFramStop               as logical     no-undo.
     1180   define variable mWaitFramStopUser           as logical     no-undo.
     1181   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1182   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1183   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1184   define button B-WaitFramStop auto-end-key
     1185        label "Стоп"
     1186        size 10 by 1 tooltip "Остоновить процесс".
     1187   define button B-viewProcInfo
     1188        label "Информация"
     1189        size 15 by 1 tooltip "Информация о процесс".
     1190   define frame waitfram
     1191     v-waitfram-action01 format "x(72)" no-label skip
     1192     v-waitfram-action02 format "x(72)" no-label skip
     1193     v-waitfram-action03 format "x(72)" no-label skip
     1194     B-viewProcInfo
     1195     B-WaitFramStop at row 4 col 30
     1196     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1197     .
     1198   define new global shared variable mBatchMode as logical no-undo init ?.
     1199   define variable mFramBachModHandle as handle no-undo.
     1200   mFramBachModHandle = frame waitfram:handle.
     1201   define variable mFameOldVis as logical no-undo.
     1202   define variable mVisCUrentVin as logical no-undo.
     1203   if session:batch-mode
     1204   then
     1205      mBatchMode = yes.
     1206   if mBatchMode = ? then do:
     1207     mVisCUrentVin = current-window:visible.
     1208     mFameOldVis = mFramBachModHandle:visible.
     1209     mFramBachModHandle:visible  = yes.
     1210     mBatchMode = mFramBachModHandle:visible ne yes.
     1211     mFramBachModHandle:visible = mFameOldVis.
     1212     current-window:visible = mVisCUrentVin.
     1213   end.
     1214    if  log-manager:logfile-name ne ?
     1215     then DO:
     1216         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1217         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1218         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1219     end.
     1220   on choose of B-WaitFramStop in frame waitfram
     1221   do:
     1222     mWaitFramStop = yes.
     1223     mWaitFramStopUser = yes.
     1224   end.
     1225   function waitfram-check-timeout returns logical():
     1226      define variable vtime as int64 no-undo.
     1227      if mWaitFramStopTimeOut
     1228      then
     1229         return yes.
     1230      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1231      if     mWaitFramTimeOut ne ?
     1232         and mWaitFramTimeOut ne 0
     1233         and mWaitFramTimeOut lt vtime
     1234      then do:
     1235         mWaitFramStopTimeOut = yes.
     1236      end.
     1237      return mWaitFramStopTimeOut.
     1238   end.
     1239   procedure waitfram-hide :
     1240     if not session:batch-mode
     1241     then do
     1242     on error undo, return error return-value
     1243     :
     1244       pause 0 before-hide .
     1245       if not mBatchMode then
     1246         hide frame waitfram .
     1247     if     not mWaitFramView
     1248        and mWaitProcEvent
     1249     then
     1250       process events .
     1251     end.
     1252   end procedure.
     1253   procedure waitfram-show :
     1254     define input  parameter p-message as character no-undo .
     1255     define variable v-left-margin as integer   no-undo .
     1256     if not session:batch-mode
     1257     then do
     1258     on error undo, return error return-value
     1259     :
     1260       if length(p-message) <= 70 then do:
     1261         assign
     1262           v-left-margin = integer((70 - length(p-message)) / 2)
     1263         .
     1264         assign
     1265           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1266         .
     1267         assign
     1268           v-waitfram-action01 = " "
     1269           v-waitfram-action02 = " "
     1270                                    + fill(" ", v-left-margin)
     1271                                    + p-message
     1272           v-waitfram-action03 = " "
     1273         .
     1274       end.
     1275       else do:
     1276         define variable vRindex1 as integer no-undo.
     1277         define variable vRindex2 as integer no-undo.
     1278         vRindex1 = r-index(p-message," ",70).
     1279         if vRindex1 = 0
     1280         then
     1281            vRindex1 = 70.
     1282         if length(p-message)  <= vRindex1 + 70 then do:
     1283           assign
     1284             v-waitfram-action01 = " "
     1285             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1286             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1287           .
     1288         end.
     1289         else do:
     1290           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1291           if vRindex2 <= vRindex1
     1292           then
     1293              vRindex2 = vRindex1 + 70.
     1294           assign
     1295             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1296             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1297             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1298           .
     1299         end.
     1300       end.
     1301       B-viewProcInfo:visible   in frame waitfram = no.
     1302       B-viewProcInfo:sensitive in frame waitfram = no.
     1303       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1304       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1305       if  (   mWaitFramView
     1306          or  mWaitProcEvent)
     1307          and not mBatchMode
     1308       then
     1309          display
     1310             v-waitfram-action01 skip
     1311             v-waitfram-action02 skip
     1312             v-waitfram-action03 skip
     1313          with frame waitfram .
     1314       if     mWaitFramView
     1315          then do:
     1316             if     mWaitFramInterval ne ?
     1317                and not mBatchMode
     1318             then
     1319                wait-for go of frame waitfram pause mWaitFramInterval.
     1320          end.
     1321          else
     1322             if     mWaitProcEvent
     1323                and not mBatchMode
     1324             then
     1325                process events .
     1326     end.
     1327   end procedure.
     1328      procedure waitfram-show-this:
     1329         define input  parameter iInterval as int64 no-undo.
     1330         define variable vtime as int64 no-undo.
     1331         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1332         mWaitFramInterval = iInterval.
     1333         run waitfram-show (substitute("&1&2 &3&4" ,
     1334                                       mWaitFramTextBeg ,
     1335                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1336                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1337                                       mWaitFramTextEnd
     1338                                      )
     1339                           ).
     1340      end.
     1341      procedure WaitFramRunPause:
     1342         define input  parameter iInterval as dec no-undo.
     1343         define variable vStart  as datetime-tz no-undo.
     1344         define variable vend    as datetime-tz no-undo.
     1345         define variable vint as int64 no-undo.
     1346         define variable vOk as logical no-undo.
     1347         vStart = now.
     1348         vend   = vStart.
     1349         publish "WaitFramPause" (iInterval,output vOk).
     1350         vend   =  now.
     1351         vint = vend - vStart.
     1352         vint = iInterval - vint / 1000.
     1353         if     not mWaitFramStop
     1354            and (   vint > 0
     1355                 or (    not vOk
     1356                     and iInterval eq ?
     1357                     )
     1358                 )
     1359         then
     1360            run waitfram-show-this (iInterval).
     1361         vend   =  now.
     1362         vint = vend - vStart.
     1363         vint = iInterval - vint / 1000.
     1364         if     not mWaitFramStop
     1365            and vint > 0
     1366         then do:
     1367            run gbl/pause.p (vint * 1000).
     1368         end.
     1369         if iInterval ne ?
     1370         then
     1371            publish "WaitFramStop".
     1372         waitfram-check-timeout().
     1373      end.
     1374      procedure WaitFramWaitFor:
     1375         define input  parameter iInterval as dec no-undo.
     1376         assign
     1377            mWaitFramStartProc   = now
     1378            mWaitFramStopUser    = no
     1379            mWaitFramStopTimeOut = no
     1380         .
     1381         block-wait:
     1382         do while not mWaitFramStop:
     1383            run WaitFramRunPause (iInterval).
     1384            if  waitfram-check-timeout()
     1385            then do:
     1386               leave block-wait.
     1387            end.
     1388         end.
     1389         run waitfram-hide.
     1390      end.
     1391   procedure waitfram-join :
     1392     define input  parameter p-line-1  as character no-undo .
     1393     define input  parameter p-line-2  as character no-undo .
     1394     define input  parameter p-line-3  as character no-undo .
     1395     define output parameter p-message as character no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       assign
     1400         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1401                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1402                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1403       .
     1404     end.
     1405   end procedure.
     1406   function waitfram-join-function returns character
     1407     (input p-line-1 as character
     1408     ,input p-line-2 as character
     1409     ,input p-line-3 as character
     1410     ).
     1411     define variable v-message as character no-undo .
     1412     run waitfram-join in this-procedure
     1413       (input  p-line-1
     1414       ,input  p-line-2
     1415       ,input  p-line-3
     1416       ,output v-message
     1417       ) .
     1418     return v-message .
     1419   end function .
     1420   procedure proc-alt-shift-f2:
     1421     if not ibs.th.gbl.gbl-var:rcode
     1422   then
     1423     run gbl\inidebug.p .
     1424   end.
     1425   procedure proc-alt-shift-f3:
     1426     run gbl/prvssinf.p
     1427       ( input this-procedure
     1428       ) .
     1429   end.
     1430   define variable v-inform-launched as logical no-undo initial false .
     1431   procedure proc-alt-shift-f4:
     1432     define variable v-action as character no-undo .
     1433     if v-inform-launched = false then do:
     1434       assign
     1435         v-inform-launched = true
     1436       .
     1437       run gbl/d-inform.w
     1438         (  input self
     1439         ,  input this-procedure
     1440         , output v-action
     1441         ) no-error .
     1442       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1443       assign
     1444         v-inform-launched = false
     1445       .
     1446     end.
     1447   end.
     1448   procedure proc-alt-f1:
     1449     run gbl/corrhelp.p
     1450       (input this-procedure
     1451       ) .
     1452   end .
     1453   on alt-shift-f2 anywhere do:
     1454     run proc-alt-shift-f2.
     1455   end.
     1456   on alt-shift-f3 anywhere do:
     1457     run proc-alt-shift-f3 in this-procedure .
     1458   end.
     1459   on alt-shift-f4 anywhere do:
     1460     run proc-alt-shift-f4 in this-procedure.
     1461   end.
     1462   on alt-f1 anywhere do:
     1463     run proc-alt-f1 in this-procedure .
     1464   end.
     1465   define variable g#report-num as integer no-undo .
     1466   define variable my-x-date-start as date no-undo.
     1467   define variable my-x-date-end as date no-undo.
     1468   define variable State-source as Widget-Handle.
     1469   define temp-table temp-sum no-undo
     1470   FIELD obj-type like ub.clients.obj-type
     1471   FIELD obj-code like ub.clients.obj-code
     1472   FIELD doc-date like ub.inkas.doc-date
     1473   FIELD tot-sum like ub.inkas.netto
     1474   FIELD tot-chk like ub.inkas.num-chk
