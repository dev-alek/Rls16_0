     1887     entry(2, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(2 ) + chr(44) +
     1888   entry(3, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(3 ) + chr(44) +
     1889   entry(4, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(4 ) + chr(44) +
     1890   entry(5, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(5 ) + chr(44) +
     1891   entry(6, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(6 ) + chr(44) +
     1892   entry(7, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(7 ) + chr(44) +
     1893   entry(1, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота") + chr(44) + string(1 ).
     1894     assign
     1895     RS_wdays  = 2
     1896     .
     1897   END PROCEDURE.
     1898   PROCEDURE My-Report :
     1899   DEFINE VARIABLE accum-tot-sum like ub.inkas.netto no-undo .
     1900   DEFINE VARIABLE accum-tot-chk like ub.inkas.num-chk no-undo .
     1901   DEFINE VARIABLE accum-week-tot-sum like ub.inkas.netto no-undo .
     1902   DEFINE VARIABLE accum-week-tot-chk like ub.inkas.num-chk no-undo .
     1903   DEFINE VARIABLE accum-all-tot-sum like ub.inkas.netto no-undo .
     1904   DEFINE VARIABLE accum-all-tot-chk like ub.inkas.num-chk no-undo .
     1905   DEFINE VARIABLE v-print-date as date no-undo .
     1906   DEFINE VARIABLE v-week-start as integer no-undo .
     1907   DEFINE VARIABLE v-week-end as integer no-undo .
     1908   DEFINE VARIABLE Strbuf as character no-undo .
     1909   DEFINE VARIABLE v-col-num as integer no-undo .
     1910   define variable date_string as character no-undo.
     1911   DEFINE VARIABLE kol_obj as integer no-undo .
     1912   define variable glog as logical no-undo .
     1913   define variable chk-amount as integer no-undo .
     1914   define variable nf-chk-amount as integer no-undo .
     1915   define buffer cli_shop for ub.clients .
     1916   define buffer buf_inkas for ub.inkas.
     1917   for each temp-sum:
     1918     delete temp-sum.
     1919   end.
     1920   glog = no.
     1921   FOR EACH obj-list NO-LOCK,
     1922       FIRST buf_inkas where
     1923           buf_inkas.doc-date >= my-X-Date-Start AND
     1924           buf_inkas.doc-date <= my-X-Date-End AND
     1925           buf_inkas.obj-type = obj-list.obj-type AND
     1926           buf_inkas.obj-code = obj-list.obj-code AND
     1927           buf_inkas.status_ = 'факт':U NO-LOCK:
     1928     glog = (if glog = no then yes else glog) .
     1929   END.
     1930   if NOT glog then do:
     1931       message "Не было никаких закрытых продаж на выбранных объектах в течение заданного Вами периода времени." view-as alert-box.
     1932       return.
     1933   end.
     1934   assign
     1935   v-week-start = RS_wdays
     1936   v-week-end = (if v-week-start = 1
     1937                 then 7
     1938                 else (v-week-start - 1)
     1939                 )
     1940   .
     1941   date_string = cur-time-print() .
     1942   run waitfram-show in this-procedure ("Ждите...").
     1943   assign
     1944   sheetf.Excel-COlumn-Lable = string( "Дата", "x(10)" ) + chr(44) +
     1945                               string("День недели", "X(11)") + chr(44)
     1946   sheetf.sizes = "10" + chr(44) +
     1947                  "11" + chr(44)
     1948   sheetf.MergeCellsH = "":U
     1949   sheetf.MergeCellsV = "":U
     1950   .
     1951   for each obj-list no-lock:
     1952     find first cli_shop no-lock where
     1953                cli_shop.obj-code = obj-list.obj-code
     1954            AND cli_shop.obj-type = obj-list.obj-type no-error .
     1955     assign
     1956     sheetf.Excel-COlumn-Lable = sheetf.Excel-Column-Lable +
     1957                                string(replace(cli_shop.obj-name, chr(44), chr(32)), "x(15)" ) + chr(44) +
     1958                                fill (chr(32), 12) + chr(44) +
     1959                                fill (chr(32), 12) + chr(44)
     1960     sheetf.sizes = sheetf.sizes +
     1961                   "6" + chr(44) +
     1962                   "12" + chr(44) +
     1963                   "12" + chr(44)
     1964     kol_obj = kol_obj + 1
     1965     .
     1966   end.
     1967   assign
     1968   sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable +
     1969                             string("Итог дня", "X(8)") +  chr(44) +
     1970                             fill( chr(32), 15 ) + chr(44) +
     1971                             string("Итог недели", "X(11)") + chr(44) +
     1972                             fill(chr(32), 15 )
     1973   sheetf.sizes = sheetf.sizes +
     1974                 "8" + chr(44) +
     1975                 "15" + chr(44) +
     1976                 "11" + chr(44) +
     1977                 "15"
     1978   .
     1979   assign
     1980   sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + chr(10) +
     1981                               chr(44) +
     1982                               chr(44)
     1983   .
     1984   assign
     1985   v-col-num = 3
     1986   .
     1987   for each obj-list no-lock:
     1988     find first cli_shop no-lock where
     1989                cli_shop.obj-code = obj-list.obj-code
     1990            AND cli_shop.obj-type = obj-list.obj-type no-error .
     1991     assign
     1992     sheetf.Excel-COlumn-Lable = sheetf.Excel-Column-Lable +
     1993                                string("Чеки", "x(6)" ) + chr(44) +
     1994                                string("Сред. покупка", "X(12)") + chr(44) +
     1995                                string("Выручка", "X(12)") + chr(44)
     1996     sheetf.MergeCellsH = Sheetf.MergeCellsH + (if Sheetf.MergeCellsH = "":U then "":U else chr(44)) +
     1997                          string(v-col-num)+ ":":U + string(v-col-num + 2)
     1998     v-col-num = v-col-num + 3
     1999     .
     2000   end.
     2001   assign
     2002   sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable +
     2003                               string("Чеки", "X(8)") + chr(44) +
     2004                               string("Выручка", "X(15)") +  chr(44) +
     2005                               string("Чеки", "X(11)") + chr(44) +
     2006                               string("Выручка", "X(15)")
     2007   sheetf.MergeCellsH = Sheetf.MergeCellsH + (if Sheetf.MergeCellsH = "":U then "":U else chr(44)) +
     2008                          string(v-col-num)+ ":":U + string(v-col-num + 1) + chr(44) +
     2009                          string(v-col-num + 2)+ ":":U + string(v-col-num + 3)
     2010   sheetf.MergeCellsV =  "1=1:2/2=1:2":U
     2011   Sheetf.colformat = "1=dd/mm/yy":U
     2012   .
     2013   Sheetf.Bas-File = "exe/e-weekv.bas".
     2014   run rep/extitle.p (1).
     2015   assign
     2016   Sheetf.Bas-Params = string(kol_obj) + chr(4) + string(Sheetf.Excel-Row-Heder + 2  )
     2017   .
     2018   FOR EACH obj-list NO-LOCK,
     2019       EACH buf_inkas NO-LOCK where
     2020           buf_inkas.doc-date >= my-X-Date-Start AND
     2021           buf_inkas.doc-date <= my-X-Date-End AND
     2022           buf_inkas.obj-type = obj-list.obj-type AND
     2023           buf_inkas.obj-code = obj-list.obj-code AND
     2024           buf_inkas.status_ = 'факт':U
     2025   BREAK
     2026   by buf_inkas.obj-type
     2027   by buf_inkas.obj-code
     2028   by buf_inkas.status_
     2029   by buf_inkas.doc-date
     2030   :
     2031     if first-of(buf_inkas.doc-date) then do:
     2032       assign
     2033       accum-tot-sum = 0
     2034       accum-tot-chk = 0
     2035       .
     2036     end.
     2037     nf-chk-amount = 0.
     2038     assign
     2039     accum-tot-sum = accum-tot-sum + buf_inkas.netto
     2040     accum-tot-chk = accum-tot-chk + buf_inkas.num-chk - buf_inkas.num-chk-nff
     2041     .
     2042     if last-of(buf_inkas.doc-date) then do:
     2043       find first temp-sum no-lock where
     2044                  temp-sum.obj-type = obj-list.obj-type
     2045              AND temp-sum.obj-code = obj-list.obj-code
     2046              AND temp-sum.doc-date = buf_inkas.doc-date no-error .
     2047       if not avail temp-sum then do:
     2048         create temp-sum.
     2049         assign
     2050         temp-sum.doc-date = buf_inkas.doc-date
     2051         temp-sum.obj-type = obj-list.obj-type
     2052         temp-sum.obj-code = obj-list.obj-code
     2053         temp-sum.tot-sum = accum-tot-sum
     2054         temp-sum.tot-chk = accum-tot-chk
     2055         .
     2056       end.
     2057     end.
     2058   END.
     2059   do v-print-date = my-x-date-start to my-x-date-end:
     2060     if weekday(v-print-date) = v-week-start then do:
     2061       assign
     2062       accum-week-tot-sum = 0
     2063       accum-week-tot-chk = 0
     2064       .
     2065     end.
     2066     assign
     2067     accum-tot-sum = 0
     2068     accum-tot-chk = 0
     2069     .
     2070     if Make-Excel then  put   stream ForExcel unformatted
     2071     string(v-print-date, "99/99/99":U) CHR(9)
     2072     get-weekday-name-short(weekday(v-print-date)) CHR(9)
     2073     .
     2074     for each obj-list no-lock:
     2075       find first temp-sum no-lock where
     2076                  temp-sum.obj-type = obj-list.obj-type
     2077             AND temp-sum.obj-code = obj-list.obj-code
     2078             AND temp-sum.doc-date = v-print-date no-error .
     2079       assign
     2080       StrBuf =
     2081                 (if avail temp-sum
     2082                 then (string(temp-sum.tot-chk) + CHR(9) +
     2083                       string(ROUND((temp-sum.tot-sum / temp-sum.tot-chk), 2)) + CHR(9) +
     2084                       string(temp-sum.tot-sum) + CHR(9))
     2085                 else  (CHR(9) +
     2086                        CHR(9) +
     2087                        CHR(9))
     2088                )
     2089       accum-tot-sum = accum-tot-sum + (if avail temp-sum then temp-sum.tot-sum else 0)
     2090       accum-tot-chk = accum-tot-chk + (if avail temp-sum then temp-sum.tot-chk else 0)
     2091       accum-week-tot-sum = accum-week-tot-sum + (if avail temp-sum then temp-sum.tot-sum else 0)
     2092       accum-week-tot-chk = accum-week-tot-chk + (if avail temp-sum then temp-sum.tot-chk else 0)
     2093       accum-all-tot-sum = accum-all-tot-sum + (if avail temp-sum then temp-sum.tot-sum else 0)
     2094       accum-all-tot-chk = accum-all-tot-chk + (if avail temp-sum then temp-sum.tot-chk else 0)
     2095       .
     2096       if Make-Excel then  put   stream ForExcel unformatted
     2097       Strbuf
     2098       .
     2099     end.
     2100     if weekday(v-print-date) = v-week-end then do:
     2101       if Make-Excel then  put   stream ForExcel unformatted
     2102       (if accum-tot-chk <> 0 then string(accum-tot-chk) else "":U) CHR(9)
     2103       (if accum-tot-chk <> 0 then string(accum-tot-sum) else "":U) CHR(9)
     2104       (if accum-week-tot-chk <> 0 then string(accum-week-tot-chk) else "":U) CHR(9)
     2105       (if accum-week-tot-chk <> 0 then string(accum-week-tot-sum) else "":U)
     2106       SKIP.
     2107     end.
     2108     else do:
     2109       if Make-Excel then  put   stream ForExcel unformatted
     2110       (if accum-tot-chk <> 0 then string(accum-tot-chk) else "":U) CHR(9)
     2111       (if accum-tot-chk <> 0 then string(accum-tot-sum) else "":U) CHR(9)
     2112       CHR(9)
     2113       SKIP.
     2114     end.
     2115   end.
     2116   if Make-Excel then  put   stream ForExcel unformatted
     2117   "ИТОГО" CHR(9)
     2118   CHR(9)
     2119   .
     2120   for each obj-list no-lock:
     2121     if Make-Excel then  put   stream ForExcel unformatted
     2122     CHR(9)
     2123     CHR(9)
     2124     CHR(9)
     2125     .
     2126   end.
     2127   if Make-Excel then  put   stream ForExcel unformatted
     2128   CHR(9)
     2129   CHR(9)
     2130   accum-all-tot-chk CHR(9)
     2131   accum-all-tot-sum
     2132   skip
     2133   .
     2134   if Make-Excel then output stream ForExcel close.
     2135   run waitfram-hide in this-procedure .
     2136   run get-report-num  in my-handle(output g#report-num).
     2137   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     2138   END PROCEDURE.
     2139   PROCEDURE My-var :
     2140   define variable State-source as handle.
     2141   define variable my#x-date-start  like  x-date-start no-undo.
     2142   define variable my#x-date-end    like  x-date-end   no-undo.
     2143   Assign FRAME F-Main RS_wdays .
     2144   Assign
     2145    STR-obj-type = ''
     2146    STR-obj-code = ''
     2147    STR-obj-name = ''
     2148    STR-obj      = ''.
     2149   For each obj-list no-lock:
     2150    Assign
     2151    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2152    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2153    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2154    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2155   End.
     2156   assign
     2157   ReportNAme = "Понедельный отчет по выручке"
     2158   ReportHeader =  ("Началом отчетной недели считается" + chr(32) +
     2159   radio-label(string(RS_wdays), RS_wdays:radio-buttons))
     2160   .
     2161   assign
     2162   my-x-date-start = x-date-start
     2163   my-x-date-end = x-date-end
     2164   my#x-date-start = x-date-start
     2165   my#x-date-end = x-date-end
     2166   .
     2167   run check-dates(input-output my-X-date-Start, input-output my-X-date-End, RS_wdays,  yes).
     2168   x-date-start = my-x-date-start  .
     2169   x-date-end   = my-x-date-end    .
     2170    IF ( my#x-date-start <> my-x-date-start
     2171      OR my#x-date-end <> my-x-date-end) THEN DO:
     2172     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     2173     IF RETURN-VALUE NE "DESIGN" THEN DO:
     2174       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     2175       State-source = WIDGET-HANDLE ( source-str ).
     2176       IF not VALID-HANDLE ( State-source ) THEN
     2177         Message "Не определен линк " 'State':U view-as alert-box error.
     2178     END.
     2179      Run Select1 IN State-source.
     2180      Return error 'First-page':U.
     2181   End.
     2182   END PROCEDURE.
     2183   PROCEDURE Print-Proc :
     2184   END PROCEDURE.
     2185   PROCEDURE send-records :
     2186   END PROCEDURE.
     2187   PROCEDURE state-changed :
     2188     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2189     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2190   END PROCEDURE.
     2191   FUNCTION get-weekday-name RETURNS CHARACTER
     2192     ( input p-weekday as integer ) :
     2193     RETURN entry(p-weekday, "Воскресенье,Понедельник,Вторник,Среда,Четверг,Пятница,Суббота").
     2194   END FUNCTION.
     2195   FUNCTION get-weekday-name-short RETURNS CHARACTER
     2196     ( input p-weekday as integer ) :
     2197     RETURN entry(p-weekday, "вс,пн,вт,ср,чт,пн,сб").
     2198   END FUNCTION.
