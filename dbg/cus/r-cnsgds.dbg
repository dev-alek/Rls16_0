     1015   field max-qnty    like ub.place.max-qnty
     1016   field brutto-qnty like ub.rvs-line.state-brutto-qnty
     1017   field free-qnty   like ub.rvs-line.state-brutto-qnty
     1018   field temp-sale   as decimal
     1019   field qnty-of     like ub.ord-line.qnty
     1020   field time-of     as char
     1021   field ord-code    as character
     1022   field qnty-fp     like ub.ord-line.qnty
     1023   field cli-cod     as character
     1024   field cli-name    as character
     1025   field rcv-code    as character
     1026   field time-rcv    as char
     1027   field qnty-rcv    like ub.ord-line.qnty
     1028   field nnn as integer
     1029   INDEX pi IS UNIQUE PRIMARY
     1030     obj-type
     1031     nnn
     1032     gds-code
     1033     ord-code
     1034     rcv-code
     1035         .
     1036   FUNCTION excel-qnty-null RETURNS char (INPUT p-dec as decimal ).
     1037   if p-dec = 0 then Return ("").
     1038      else RETURN(format-excel-text(excel-format-dec-to-char(Round(p-dec,3)))) .
     1039   END FUNCTION.
     1040   main-block :
     1041   do on error undo main-block, return error
     1042   :
     1043   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1044     if  log-manager:logfile-name ne ?
     1045     then DO:
     1046         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1047     end.
     1048     if not session:batch-mode then
     1049     do:
     1050       VIEW FRAME InfoFrame.
     1051       mFrameView = true.
     1052     end.
     1053      v-button-stop = false .
     1054         if mFrameView
     1055         then do:
     1056         if v-button-stop then view STOPBTN in frame InfoFrame.
     1057                          else Hide STOPBTN in frame InfoFrame.
     1058         end.
     1059     os-delete value( string( session:temp-directory ) +
     1060                                  "rpt" + string( g#report-num ) + ".txt":U ) .
     1061     os-delete value( string( session:temp-directory ) +
     1062                                  "rpt" + string( g#report-num ) + ".frm":U ) .
     1063     output stream forexcel to value( string( session:temp-directory ) +
     1064                                  "rpt" + string( g#report-num ) + ".txt":U ) .
     1065   Make-Excel = true .
     1066   find first  bf_ord-cons where recid(bf_ord-cons) = c-rc no-lock no-error .
     1067   Reportname   =  "Совокупная заявка по товарам по фирме № " + bf_ord-cons.cons-code + " от " + string(bf_ord-cons.doc-date,"99/99/9999").
     1068   Reportheader =   cur-time-print() .
     1069        Sheetf.Sizes = "16,30," .
     1070        Sheetf.Sizes = Sheetf.Sizes + ("12,") .
     1071        Sheetf.Sizes = Sheetf.Sizes + ("8,")  .
     1072        Sheetf.Sizes = Sheetf.Sizes + ("12,") .
     1073        Sheetf.Sizes = Sheetf.Sizes + ("8,")  .
     1074        Sheetf.Sizes = Sheetf.Sizes + ("20,") .
     1075        Sheetf.Sizes = Sheetf.Sizes + ("8,")  .
     1076        Sheetf.Sizes = Sheetf.Sizes + ("12,") .
     1077        Sheetf.Excel-Column-Lable =  "Артикл ,Наименование товара"
     1078       + ",Заявленное количество"
     1079       + ",Предполагаемое время завоза"
     1080       + ",Заказанное у поставщика кол-во в целом от фирмы "
     1081       + ",Код поставщика"
     1082       + ",Наименование поставщика "
     1083       + ",Согласованное время завоза (поставок)"
     1084       + ",Количество в поставке"
     1085         .
     1086   sheetf.make-correct =  "" .
     1087   run rep/extitle.p (1) .
     1088   run make-tt .
     1089   for each  bf_ord-doc no-lock  where bf_ord-doc.cons-code = bf_ord-cons.cons-code,
     1090        first ub.clients  where ub.clients.obj-code =  bf_ord-doc.obj-code
     1091                        and  ub.clients.obj-type =  bf_ord-doc.obj-type no-lock
     1092                        break by ub.clients.obj-type by ub.clients.obj-code:
     1093        if first-of(ub.clients.obj-code) then do:
     1094          old-l-ord-code = "".
     1095               if Make-Excel then  put   stream ForExcel unformatted
     1096                 format-excel-text(ub.clients.obj-type + " " + string(ub.clients.obj-code))  CHR(9)
     1097                 format-excel-text(ub.clients.obj-name) chr(10)
     1098               .
     1099            for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,    first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic                                           and bf_ord-cons-gds.prod-type = ub.goods.prod-type                               and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1100               last-line = false .
     1101               for each   temp-tt where temp-tt.obj-type = ub.clients.obj-type + " " + string(ub.clients.obj-code) and
     1102                                       temp-tt.gds-code = ub.goods.gds-code break by temp-tt.gds-code:
     1103                       if first (temp-tt.gds-code) then do:
     1104                           if Make-Excel then  put   stream ForExcel unformatted ub.goods.artic CHR(9)
     1105                                       ub.goods.gds-name CHR(9)
     1106                                       .
     1107                       end.
     1108                       else do:
     1109                       last-line = true  .
     1110                       if Make-Excel then  put   stream ForExcel unformatted
     1111                         CHR(9)
     1112                         CHR(9)
     1113                         .
     1114                         end.
     1115                        if Make-Excel then  put   stream ForExcel unformatted
     1116                         excel-qnty-null(temp-tt.qnty-of  )   CHR(9)
     1117                         format-excel-text(temp-tt.time-of)   CHR(9)
     1118                         excel-qnty-null (temp-tt.qnty-fp  )  CHR(9)
     1119                         format-excel-text(temp-tt.cli-cod)   CHR(9)
     1120                         format-excel-text(temp-tt.cli-name)  CHR(9)
     1121                         format-excel-text(temp-tt.time-rcv)  CHR(9)
     1122                         excel-qnty-null(temp-tt.qnty-rcv)    chr(10)
     1123                       .
     1124                       if last (temp-tt.gds-code) and last-line = true  then do:
     1125                         run sub-gds.
     1126                         end.
     1127                       end.
     1128            end.
     1129        end.
     1130        if last-of(ub.clients.obj-code) then do:
     1131           run sub-itog.
     1132        end.
     1133   end.
     1134   if Make-Excel then  put   stream ForExcel unformatted  "ИТОГО"    CHR(9)
     1135                           CHR(9)
     1136                           .
     1137             assign
     1138                 s-max-qnty    = 0
     1139                 s-brutto-qnty = 0
     1140                 s-free-qnty   = 0
     1141                 s-qnty-of     = 0
     1142                 s-qnty-fp     = 0
     1143                 s-qnty-rcv    = 0
     1144                 .
     1145               for each   temp-tt  :
     1146               assign
     1147                 s-max-qnty    = s-max-qnty    + temp-tt.max-qnty
     1148                 s-brutto-qnty = s-brutto-qnty + temp-tt.brutto-qnty
     1149                 s-free-qnty   = s-free-qnty   + temp-tt.free-qnty
     1150                 s-qnty-of     = s-qnty-of     + temp-tt.qnty-of
     1151                 s-qnty-fp     = s-qnty-fp     + temp-tt.qnty-fp
     1152                 s-qnty-rcv    = s-qnty-rcv    + temp-tt.qnty-rcv
     1153                 .
     1154               end.
     1155               if Make-Excel then  put   stream ForExcel unformatted
     1156                   s-qnty-of     CHR(9)
     1157                                 CHR(9)
     1158                   CHR(9)
     1159                                 CHR(9)
     1160                                 CHR(9)
     1161                                 CHR(9)
     1162                   s-qnty-rcv    chr(10)
     1163                 .
     1164    if Make-Excel then  put   stream ForExcel unformatted  chr(10).
     1165   run cur-time in this-procedure ( output v-today, output v-time ).
     1166     if Make-Excel then  put   stream ForExcel unformatted " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     1167     if Make-Excel then output stream ForExcel close.
     1168   if mFrameView
     1169   then do:
     1170      HIDE FRAME InfoFrame.
     1171   end.
     1172     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1173   end.
     1174   procedure make-tt :
     1175   define variable tt-line  as logical no-undo .
     1176   define variable ttt-line as logical no-undo .
     1177   for each  bf_ord-doc no-lock  where bf_ord-doc.cons-code = bf_ord-cons.cons-code
     1178                                   and bf_ord-doc.doc-type = 'ОФ':U  ,
     1179     first ub.clients  where ub.clients.obj-code =  bf_ord-doc.obj-code
     1180                     and  ub.clients.obj-type =  bf_ord-doc.obj-type no-lock
     1181                     break by ub.clients.obj-type by ub.clients.obj-code:
     1182     if first-of(ub.clients.obj-code) then do:
     1183        ii = 0 .
     1184       for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,
     1185         first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic
     1186               and bf_ord-cons-gds.prod-type = ub.goods.prod-type
     1187               and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1188               assign
     1189                 l-nn = 0
     1190                 l-qnty-of = 0
     1191                 l-time-of = 0
     1192               .
     1193           for each  z_ord-doc no-lock  where z_ord-doc.cons-code = bf_ord-cons.cons-code
     1194                                               and z_ord-doc.doc-type = 'ОФ':U
     1195                                               and ub.clients.obj-code =  z_ord-doc.obj-code
     1196                                               and ub.clients.obj-type =  z_ord-doc.obj-type
     1197                                              ,
     1198                   each z_ord-line no-lock where z_ord-doc.doc-code   = z_ord-line.doc-code and
     1199                                                   z_ord-line.artic     = bf_ord-cons-gds.artic      and
     1200                                                   z_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1201                                                   z_ord-line.prod-code = bf_ord-cons-gds.prod-code :
     1202                     l-qnty-of = l-qnty-of + z_ord-line.qnty.
     1203                     l-time-of =  z_ord-doc.ship-time.
     1204           end.
     1205           assign
     1206           l-cli-code  = ""
     1207           l-cli-name  = ""
     1208           l-ord-code  = ""
     1209           ttt-line = false
     1210           l-qnty-fp = 0
     1211           .
     1212           for each loc_ord-doc no-lock  where loc_ord-doc.cons-code =  bf_ord-cons.cons-code
     1213                                     and loc_ord-doc.doc-type = 'ФП':U
     1214                                     ,
     1215           first b_clients  where b_clients.obj-code =  loc_ord-doc.cli-code
     1216                             and  b_clients.obj-type =  loc_ord-doc.cli-type no-lock ,
     1217           each loc_ord-line no-lock where loc_ord-doc.doc-code   = loc_ord-line.doc-code and
     1218                                           loc_ord-line.artic     = bf_ord-cons-gds.artic      and
     1219                                           loc_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1220                                           loc_ord-line.prod-code = bf_ord-cons-gds.prod-code
     1221                         break by  loc_ord-doc.doc-code   :
     1222               l-qnty-fp = l-qnty-fp + loc_ord-line.qnty.
     1223               if first-of ( loc_ord-doc.doc-code ) then do:
     1224               l-cli-code  =  b_clients.obj-type + " "  + string( b_clients.obj-code).
     1225               l-cli-name  =  b_clients.obj-name.
     1226               l-ord-code  = loc_ord-line.doc-code.
     1227                   tt-line = false  .
     1228                   for each loc_ord-doc-rcv no-lock  where loc_ord-doc-rcv.cons-code =  bf_ord-cons.cons-code
     1229                                                     and loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code
     1230                                                     and ub.clients.obj-code = loc_ord-doc-rcv.obj-code
     1231                                                     and ub.clients.obj-type = loc_ord-doc-rcv.obj-type
     1232                                                     ,
     1233                         each loc_ord-line-rcv no-lock where loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code and
     1234                               loc_ord-doc-rcv.rcv-code   = loc_ord-line-rcv.rcv-code and
     1235                               loc_ord-line-rcv.artic     = bf_ord-cons-gds.artic      and
     1236                               loc_ord-line-rcv.prod-type = bf_ord-cons-gds.prod-type  and
     1237                               loc_ord-line-rcv.prod-code = bf_ord-cons-gds.prod-code  :
     1238                               l-rcv-code  = loc_ord-line-rcv.rcv-code.
     1239                               l-time-rcv  = loc_ord-doc-rcv.ship-time.
     1240                               l-qnty-rcv =  loc_ord-line-rcv.qnty.
     1241                           run create-tt-line.
     1242                           assign
     1243                             tt-line = true
     1244                             l-rcv-code = ""
     1245                             l-time-rcv = 0
     1246                             l-qnty-rcv = 0
     1247                           .
     1248                   end.
     1249                 if tt-line = false then run create-tt-line.
     1250               end.
     1251             ttt-line = true .
     1252             if last-of ( loc_ord-doc.doc-code ) then l-qnty-fp = 0.
     1253           end.
     1254             if ttt-line = false then  run create-tt-line.
     1255       end.
     1256     end.
     1257   end.
     1258   end procedure .
     1259   procedure create-tt-line :
     1260   ii = ii + 1.
     1261   IF ( ii modulo v-account = 0 )  then DO:
     1262    Assign
     1263       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1264       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1265       .
     1266    Assign
     1267       v-kol-spice = (50 - LENGTH(ub.clients.obj-name)) / 2
     1268       RecordsString2 = fill(' ',v-kol-spice) + string(ub.clients.obj-name)
     1269       .
     1270    Assign
     1271       v-kol-spice = (50 - LENGTH(ub.goods.gds-name)) / 2
     1272       RecordsString3 = fill(' ',v-kol-spice) + string(ub.goods.gds-name)
     1273       .
     1274             if  log-manager:logfile-name ne ?
     1275             then DO:
     1276                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1277             end.
     1278              if mFrameView
     1279              then do:
     1280               DISPLAY
     1281                 ii @ RecordsDone
     1282                 RecordsString   @ RecordsString
     1283                 RecordsString2  @ RecordsString2
     1284                 RecordsString3  @ RecordsString3
     1285                 WITH FRAME InfoFrame.
     1286              end.
     1287   End.
     1288      if v-button-stop then  DO:
     1289            if mFrameView
     1290            then
     1291               PROCESS EVENTS.
     1292            IF StopProcessing THEN DO:
     1293            RETURN error.
     1294            End.
     1295      end.
     1296    l-nn = l-nn + 1 .
     1297   create temp-tt .
     1298   assign
     1299    temp-tt.nnn         = l-nn
     1300    temp-tt.obj-type    = ub.clients.obj-type + " " + string(ub.clients.obj-code)
     1301    temp-tt.obj-name    = ub.clients.obj-name
     1302    temp-tt.gds-code    = ub.goods.gds-code
     1303    .
     1304    If l-nn = 1 then Do:
     1305       run calc-var(input ub.clients.obj-type,
     1306                    input ub.clients.obj-code,
     1307                    input ub.goods.gds-code,
     1308                    output l-max,
     1309                    output l-ost,
     1310                    output l-temp-sale).
     1311         assign
     1312             temp-tt.max-qnty    = l-max
     1313             temp-tt.brutto-qnty = l-ost
     1314             temp-tt.free-qnty   = temp-tt.max-qnty  - temp-tt.brutto-qnty
     1315             temp-tt.temp-sale   = l-temp-sale
     1316             temp-tt.qnty-of     = l-qnty-of
     1317             temp-tt.time-of     = (if l-time-of  = 0 then " " else string(l-time-of,"HH:MM"))
     1318             .
     1319          end.
     1320    else
     1321         assign
     1322             temp-tt.max-qnty    = 0
     1323             temp-tt.brutto-qnty = 0
     1324             temp-tt.free-qnty   = 0
     1325             temp-tt.temp-sale   = 0
     1326             temp-tt.qnty-of     = 0
     1327             temp-tt.time-of     = " "
     1328             .
     1329    if old-l-ord-code <> l-ord-code then do:
     1330       assign
     1331           temp-tt.qnty-fp     = l-qnty-fp
     1332           temp-tt.cli-cod     = l-cli-code
     1333           temp-tt.cli-name    = l-cli-name
     1334           .
     1335    end.
     1336    else do:
     1337       assign
     1338           temp-tt.qnty-fp     = 0
     1339           temp-tt.cli-cod     = ""
     1340           temp-tt.cli-name    = ""
     1341           .
     1342    end.
     1343    assign
     1344       temp-tt.ord-code    = l-ord-code
     1345       old-l-ord-code      = l-ord-code
     1346       temp-tt.rcv-code    = l-rcv-code
     1347       temp-tt.time-rcv    = (if l-time-rcv  = 0 then  " " else string(l-time-rcv,"HH:MM"))
     1348       temp-tt.qnty-rcv    = l-qnty-rcv
     1349   .
     1350   end procedure .
     1351   procedure max-col :
     1352   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1353   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1354   define output parameter p-max as integer no-undo .
     1355        p-max = 0 .
     1356        for each temp-tt where temp-tt.obj-type = p-obj-type  + " " + string(p-obj-code)
     1357          break by temp-tt.nnn DESCENDING :
     1358          p-max = temp-tt.nnn.
     1359          leave.
     1360        end.
     1361   end procedure .
     1362   procedure calc-var :
     1363   define input  parameter  m-type   like ub.clients.obj-type   no-undo .
     1364   define input  parameter  m-code   like ub.clients.obj-code   no-undo .
     1365   define input  parameter  m-gds-code  like ub.goods.gds-code  no-undo .
     1366   define output parameter  m-max       like l-max           no-undo .
     1367   define output parameter  m-ost       like l-ost           no-undo .
     1368   define output parameter  m-temp-sale like l-temp-sale     no-undo .
     1369   for each ub.place no-lock where
     1370         ub.place.obj-code =  m-code and
     1371         ub.place.obj-type =  m-type ,
     1372         first ub.pl-gds no-lock where
     1373               ub.pl-gds.gds-code = m-gds-code and
     1374               ub.pl-gds.obj-code = ub.place.obj-code          and
     1375               ub.pl-gds.obj-type = ub.place.obj-type          and
     1376               ub.pl-gds.pl-code  = ub.place.pl-code          :
     1377         m-max = m-max + ub.place.max-qnty.
     1378         find last ub.rvs-line no-lock where
     1379         ub.rvs-line.gds-code = ub.pl-gds.gds-code  and
     1380         ub.rvs-line.obj-code = ub.pl-gds.obj-code  and
     1381         ub.rvs-line.obj-type = ub.pl-gds.obj-type  and
     1382         ub.rvs-line.pl-code  = ub.pl-gds.pl-code
     1383         use-index gds-pl-code no-error .
     1384         if avail rvs-line then
     1385            m-ost = m-ost +  ub.rvs-line.state-brutto-qnty.
     1386   end.
     1387   end procedure .
     1388   procedure sub-itog :
     1389   define variable m-max-qnty    like  l-max         no-undo .
     1390   define variable m-brutto-qnty like  l-ost         no-undo .
     1391   define variable m-free-qnty   like  l-free        no-undo .
     1392   define variable m-qnty-of     like  l-qnty-of     no-undo .
     1393   define variable m-qnty-fp     like  l-qnty-fp     no-undo .
     1394   define variable m-qnty-rcv    like  l-qnty-rcv    no-undo .
     1395   define buffer temp-ll for temp-tt.
     1396   if Make-Excel then  put   stream ForExcel unformatted  "Итого по объекту"    CHR(9)
     1397                ub.clients.obj-name      CHR(9)
     1398                           .
     1399             assign
     1400                 m-max-qnty    = 0
     1401                 m-brutto-qnty = 0
     1402                 m-free-qnty   = 0
     1403                 m-qnty-of     = 0
     1404                 m-qnty-fp     = 0
     1405                 m-qnty-rcv    = 0
     1406                 .
     1407               for each   temp-ll where temp-ll.obj-type = ub.clients.obj-type + " " + string(ub.clients.obj-code) :
     1408               assign
     1409                 m-max-qnty    = m-max-qnty    + temp-ll.max-qnty
     1410                 m-brutto-qnty = m-brutto-qnty + temp-ll.brutto-qnty
     1411                 m-free-qnty   = m-free-qnty   + temp-ll.free-qnty
     1412                 m-qnty-of     = m-qnty-of     + temp-ll.qnty-of
     1413                 m-qnty-fp     = m-qnty-fp     + temp-ll.qnty-fp
     1414                 m-qnty-rcv    = m-qnty-rcv    + temp-ll.qnty-rcv
     1415                 .
     1416               end.
     1417               if Make-Excel then  put   stream ForExcel unformatted
     1418                   m-qnty-of     CHR(9)
     1419                                 CHR(9)
     1420                   m-qnty-fp     CHR(9)
     1421                                 CHR(9)
     1422                                 CHR(9)
     1423                                 CHR(9)
     1424                   m-qnty-rcv    chr(10)
     1425                 .
     1426   end procedure.
     1427   procedure sub-gds :
     1428   define variable m-max-qnty    like  l-max         no-undo .
     1429   define variable m-brutto-qnty like  l-ost         no-undo .
     1430   define variable m-free-qnty   like  l-free        no-undo .
     1431   define variable m-qnty-of     like  l-qnty-of     no-undo .
     1432   define variable m-qnty-fp     like  l-qnty-fp     no-undo .
     1433   define variable m-qnty-rcv    like  l-qnty-rcv    no-undo .
     1434   define buffer temp-ll for temp-tt.
     1435   if Make-Excel then  put   stream ForExcel unformatted                                     CHR(9)
     1436                "Итого по :" + ub.goods.gds-name      CHR(9)
     1437                           .
     1438             assign
     1439                 m-max-qnty    = 0
     1440                 m-brutto-qnty = 0
     1441                 m-free-qnty   = 0
     1442                 m-qnty-of     = 0
     1443                 m-qnty-fp     = 0
     1444                 m-qnty-rcv    = 0
     1445                 .
     1446               for each   temp-ll where temp-ll.obj-type = ub.clients.obj-type + " " + string(ub.clients.obj-code)
     1447                                    and temp-ll.gds-code = ub.goods.gds-code :
     1448               assign
     1449                 m-max-qnty    = m-max-qnty    + temp-ll.max-qnty
     1450                 m-brutto-qnty = m-brutto-qnty + temp-ll.brutto-qnty
     1451                 m-free-qnty   = m-free-qnty   + temp-ll.free-qnty
     1452                 m-qnty-of     = m-qnty-of     + temp-ll.qnty-of
     1453                 m-qnty-fp     = m-qnty-fp     + temp-ll.qnty-fp
     1454                 m-qnty-rcv    = m-qnty-rcv    + temp-ll.qnty-rcv
     1455                 .
     1456               end.
     1457               if Make-Excel then  put   stream ForExcel unformatted
     1458                   m-qnty-of     CHR(9)
     1459                                 CHR(9)
     1460                   m-qnty-fp     CHR(9)
     1461                                 CHR(9)
     1462                                 CHR(9)
     1463                                 CHR(9)
     1464                   m-qnty-rcv    chr(10)
     1465                 .
     1466   end procedure.
