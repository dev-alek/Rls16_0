      588   procedure cur-time :
      589      define output parameter p-today as date      no-undo .
      590      define output parameter p-time  as integer   no-undo .
      591     do
      592     on error undo, return error
      593     :
      594       define variable v-date1 as date      no-undo .
      595       define variable v-date2 as date      no-undo .
      596       define variable v-time  as integer   no-undo .
      597       assign
      598         v-date1 = today
      599         v-time  = time
      600         v-date2 = today
      601       .
      602       if v-date1 <> v-date2
      603       then do:
      604         assign
      605           v-date1 = today
      606           v-time  = v-time
      607         .
      608       end.
      609       assign
      610         p-today = v-date1
      611         p-time  = v-time
      612       .
      613     end.
      614   end.
      615   function cur-time-date returns character
      616   :
      617     return string(today, '99/99/9999':U) .
      618   end.
      619   function cur-time-mjd returns decimal
      620   :
      621     define variable v-date as date      no-undo .
      622     define variable v-time as integer   no-undo .
      623     run cur-time in this-procedure
      624       (output v-date
      625       ,output v-time
      626       ) .
      627     return integer(v-date) - 2400002 + (v-time / 86400) .
      628   end.
      629   function cur-time-get-ending-index returns integer
      630   (input p-number as integer
      631   )
      632   :
      633     if p-number < 0
      634     or p-number = ?
      635     then do:
      636       return 1 .
      637     end.
      638     define variable v-rest as integer   no-undo .
      639     assign
      640       p-number = p-number modulo 100
      641     .
      642     if p-number < 20
      643     then do:
      644       assign
      645         v-rest = p-number
      646       .
      647     end.
      648     else do:
      649       assign
      650         v-rest = p-number modulo 10
      651       .
      652     end.
      653     case v-rest :
      654       when 1
      655       then do:
      656         return 2 .
      657       end.
      658       when 2 or
      659       when 3 or
      660       when 4
      661       then do:
      662         return 3 .
      663       end.
      664       otherwise do:
      665         return 1 .
      666       end.
      667     end case .
      668   end.
      669   procedure cur-time-mjd-to-date :
      670      define input  parameter i-mjd-diff as decimal no-undo.
      671      define output parameter o-Date     as date    no-undo.
      672      define output parameter o-Time     as integer no-undo.
      673      define variable v-day-number as integer   no-undo .
      674      if    i-mjd-diff < 0
      675         or i-mjd-diff = ?
      676      then do:
      677         return "?" .
      678      end.
      679      assign
      680         v-day-number = truncate(i-mjd-diff,0).
      681         o-Date = date(v-day-number + 2400002).
      682         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      683     .
      684   end.
      685   function cur-time-mjd-to-string returns character
      686   (input p-mjd-diff as decimal
      687   )
      688   :
      689     define variable v-day-number as integer   no-undo .
      690     define variable v-seconds    as integer   no-undo .
      691     define variable v-hour       as integer   no-undo .
      692     define variable v-min        as integer   no-undo .
      693     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      694     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      695     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      696     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      697     if p-mjd-diff < 0
      698     or p-mjd-diff = ?
      699     then do:
      700       return "?" .
      701     end.
      702     assign
      703       v-day-number = integer(truncate(p-mjd-diff,0))
      704       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      705     .
      706     if v-seconds > 86400
      707     then do:
      708       assign
      709         v-seconds = 86400 - 1
      710       .
      711     end.
      712     if v-seconds < 0
      713     then do:
      714       assign
      715         v-seconds = 0
      716       .
      717     end.
      718     assign
      719       v-hour = truncate(v-seconds / 3600, 0)
      720     .
      721     assign
      722       v-seconds = v-seconds modulo 3600
      723     .
      724     assign
      725       v-min = truncate(v-seconds / 60, 0)
      726     .
      727     assign
      728       v-seconds = v-seconds modulo 60
      729     .
      730     return
      731         (if v-day-number <> 0
      732           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      733           else ""
      734         )
      735       + (if v-day-number <> 0 or v-hour <> 0
      736           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      737           else ""
      738         )
      739       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      740           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      741           else ""
      742         )
      743       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      744       .
      745   end.
      746   function cur-time-string returns character
      747   :
      748     define variable v-date as date      no-undo .
      749     define variable v-time as integer   no-undo .
      750     run cur-time in this-procedure
      751       (output v-date
      752       ,output v-time
      753       ) .
      754     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      755   end.
      756   function cur-time-string-sec returns character
      757   :
      758     define variable v-date as date      no-undo .
      759     define variable v-time as integer   no-undo .
      760     run cur-time in this-procedure
      761       (output v-date
      762       ,output v-time
      763       ) .
      764     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      765   end.
      766   function cur-time-custom  returns character
      767   (input p-prefix as character
      768   ,input p-date-format as character
      769   ,input p-delimiter as character
      770   ,input p-time-format as character
      771   ,input p-suffix as character
      772   )
      773   :
      774     define variable v-date as date      no-undo .
      775     define variable v-time as integer   no-undo .
      776     run cur-time in this-procedure
      777       (output v-date
      778       ,output v-time
      779       ) .
      780     return
      781       p-prefix
      782       + string(v-date, p-date-format)
      783       + p-delimiter
      784       + string(v-time, p-time-format)
      785       + p-suffix
      786       .
      787   end.
      788   function cur-time-print  returns character
      789   :
      790     define variable v-date as date      no-undo .
      791     define variable v-time as integer   no-undo .
      792     run cur-time in this-procedure
      793       (output v-date
      794       ,output v-time
      795       ) .
      796     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      797   end.
      798   function cur-time-datetime returns datetime
      799   :
      800     define variable v-char as character no-undo .
      801     define variable v-datetime as datetime no-undo .
      802     v-char = cur-time-string().
      803     v-datetime = datetime(v-char).
      804     return  v-datetime.
      805   end.
      806   function cur-time-string-msec returns character
      807   :
      808     define variable v-date as datetime  no-undo .
      809     v-date = now.
      810     return string(v-date) .
      811   end.
      812   define variable v-account as integer init 0 no-undo .
      813   define variable v-account-lavel as character no-undo .
      814   define variable v-button-stop as logical no-undo .
      815   define variable v-kol-spice as integer no-undo .
      816   define variable v-kol-spice2 as integer no-undo .
      817   define variable v-kol-spice3 as integer no-undo .
      818   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      819   DEFINE BUTTON StopBtn AUTO-END-KEY
      820        LABEL "Стоп"
      821        SIZE 10 BY 1.
      822   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      823        LABEL "Обработано записей"
      824         VIEW-AS TEXT
      825        SIZE 14 BY .67 NO-UNDO.
      826   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      827         VIEW-AS TEXT
      828        SIZE 53.25 BY .67
      829        FGCOLOR 1  NO-UNDO.
      830   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      831         VIEW-AS TEXT
      832        SIZE 53.25 BY .67
      833        FGCOLOR 1  NO-UNDO.
      834   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      835         VIEW-AS TEXT
      836        SIZE 53.25 BY .67
      837        FGCOLOR 1  NO-UNDO.
      838   DEFINE RECTANGLE RECT-1
      839        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      840        SIZE 55.13 BY 4.46.
      841   DEFINE FRAME InfoFrame
      842        StopBtn AT ROW 4.25 COL 21.75
      843        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      844        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      845        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      846        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      847        RECT-1 AT ROW 1 COL 1
      848       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      849            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      850            TITLE "Процесс"
      851            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      852   define variable mFrameView      as logical   no-undo init yes.
      853     define variable mFramHandle as handle no-undo.
      854     mFramHandle = frame InfoFrame:handle.
      855     if  log-manager:logfile-name ne ?
      856     then DO:
      857         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      858         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      859         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      860     end.
      861     mFrameView = not session:batch-mode and mFramHandle:visible.
      862     if mFrameView
      863     then do:
      864       ASSIGN
      865          FRAME InfoFrame:HIDDEN                           = TRUE
      866          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      867     end.
      868   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      869   DO:
      870     IF not StopProcessing THEN
      871       Message "Вы действительно хотите прервать" SKIP
      872               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      873                 UPDATE StopProcessing.
      874     IF StopProcessing THEN do:
      875        if mFrameView
      876        then do:
      877           HIDE FRAME InfoFrame.
      878        end.
      879     End.
      880   END.
      881   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      882     if num-entries(string(p-dec), '.') = 2
      883       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      884       else return( string(p-dec)) .
      885   end function.
      886   function format-point-to-comma returns char (input orig as char ) .
      887   define variable rtext as character no-undo .
      888   define variable strt as integer no-undo .
      889   define variable leng as integer no-undo .
      890   assign rtext = orig .
      891   repeat:
      892     strt =  index(rtext,'.').
      893     if strt = 0 then leave.
      894     leng = 1.
      895     substring(rtext,strt,leng,"character") = v-delim .
      896   end.
      897   return rtext.
      898   end function.
      899   function format-excel-text returns char ( input start-text as char ) :
      900   def var  i    as int no-undo.
      901   def var  ch   as char no-undo.
      902   def var  n    as int no-undo.
      903   def var  ipos as int no-undo.
      904     n = num-entries(trim(start-text), chr(10)) - 1 .
      905     do i = 1 to n :
      906       ipos = index( start-text, chr(10)).
      907       if ipos > 0 then
      908         substr( start-text, ipos, 1 ) = ' '.
      909     end.
      910     n = num-entries(trim(start-text), chr(13)) - 1 .
      911     do i = 1 to n :
      912       ipos = index( start-text, chr(13)).
      913       if ipos > 0 then
      914         substr( start-text, ipos, 1 ) = ' '.
      915     end.
      916     if index( start-text, '"' ) = 0 then
      917       start-text =  '="'   + trim( start-text) + '"'   .
      918       else do:
      919         n = num-entries(trim(start-text), '"') - 1.
      920         do i = 1 to n :
      921           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      922         end.
      923         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      924         start-text = '="'  + ch  + '"' .
      925       end.
      926     return start-text.
      927   end.
      928   function excel-sum returns char (input p-dec as decimal ).
      929     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      930   end function.
      931   function excel-qnty returns char (input p-dec as decimal ).
      932     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      933   end function.
      934   function format-excel-text-macr returns char ( input start-text as char ) :
      935   def var  i    as int no-undo.
      936   def var  ch   as char no-undo.
      937   def var  n    as int no-undo.
      938   def var  ipos as int no-undo.
      939     n = num-entries(trim(start-text), chr(10)) - 1 .
      940     do i = 1 to n :
      941       ipos = index( start-text, chr(10)).
      942       if ipos > 0 then
      943         substring( start-text, ipos , 1 ) = ' '.
      944     end.
      945     n = num-entries(trim(start-text), chr(13)) - 1 .
      946     do i = 1 to n :
      947       ipos = index( start-text, chr(13)).
      948       if ipos > 0 then
      949         substring( start-text, ipos, 1 ) = ' '.
      950     end.
      951     if index( start-text, '"' ) = 0 then
      952       start-text =  '"'   + trim( start-text) + '"'   .
      953       else do:
      954         n = num-entries(trim(start-text), '"') - 1.
      955         do i = 1 to n :
      956           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      957         end.
      958         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      959         start-text = '"'  + ch  + '"' .
      960       end.
      961     n = num-entries(trim(start-text), chr(10)) - 1 .
      962     do i = 1 to n :
      963       ipos = index( start-text, chr(10)).
      964       if ipos > 0 then
      965         substring( start-text, ipos , 1 ) = ' '.
      966     end.
      967       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      968     return start-text.
      969   end.
