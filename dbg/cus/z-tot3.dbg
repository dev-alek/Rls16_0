     1395   num#col# = num#col# + 1 .
     1396   p-name = "Сумма Налог с продаж" .
     1397   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     1398   num#col# = num#col# + 1 .
     1399   p-name = "Сумма НДС" .
     1400   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     1401   num#col# = num#col# + 1 .
     1402   p-name = "Название группы товаров" .
     1403   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     1404       run macr_cell_format in this-procedure (
     1405           10       ,
     1406           true     ,
     1407           false    ,
     1408           35       ,
     1409           num#str# ,
     1410           1        ,
     1411           num#str# ,
     1412           num#col# )
     1413           .
     1414     put  stream macr_excel unformatted
     1415          substitute('select("r&1c&2:r&3c&4 ")' , num#str#  , 1 , num#str# ,  num#col# ) + chr(10)  +
     1416           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1417          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1418          .
     1419   num#col# =  0.
     1420   for each  buf_ord-line-rcv no-lock where  buf_ord-line-rcv.rcv-code = buf_ord-doc-rcv.rcv-code and
     1421                                     buf_ord-line-rcv.doc-code = buf_ord-doc-rcv.doc-code break by buf_ord-line-rcv.line-num  :
     1422   find first ub.goods no-lock where
     1423         ub.goods.artic     = buf_ord-line-rcv.artic     and
     1424         ub.goods.prod-type = buf_ord-line-rcv.prod-type and
     1425         ub.goods.prod-code = buf_ord-line-rcv.prod-code no-error .
     1426         if error-status :error then next.
     1427   find first ub.clients no-lock where
     1428         ub.goods.prod-type = ub.clients.obj-type and
     1429         ub.goods.prod-code = ub.clients.obj-code no-error .
     1430   num#col# = 1 .
     1431   num#str# = num#str# + 1 .
     1432   run macr_excel_char_with_format in this-procedure ( buf_ord-line-rcv.artic , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1433   run macr_excel_char_with_format in this-procedure ( buf_ord-line-rcv.prod-type , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1434   run macr_excel_char_with_format in this-procedure ( buf_ord-line-rcv.prod-code , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1435   run macr_excel_char_with_format in this-procedure ( ub.goods.gds-name , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1436   run macr_excel_char_with_format in this-procedure ( ub.clients.obj-name , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1437   run macr_excel_char_with_format in this-procedure ( ub.goods.unit-base  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1438   run macr_excel_char_with_format in this-procedure ( buf_ord-line-rcv.unit-cli   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1439   run macr_excel_dec in this-procedure              ( buf_ord-line-rcv.cli-qnty   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1440   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.qnty       , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1441   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.price-base , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1442   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.price-cli  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1443   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.price-rubl , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1444   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.SLT-pc     , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1445   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.VAT-pc     , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1446   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.sum-base   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1447   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.sum-cli    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1448   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.sum-rubl   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1449   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.sum-SLT    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1450   run macr_excel_dec in this-procedure ( buf_ord-line-rcv.sum-VAT    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1451   run macr_excel_char_with_format in this-procedure ( ub.goods.grp-name , num#str# , num#col#  ). num#col# = num#col# + 1 .
     1452   end.
     1453   run cur-time in this-procedure ( output v-today, output v-time ).
     1454       num#str# = num#str# + 1.
     1455       num#col# =  1.
     1456   run macr_excel_char in this-procedure (  " Печать закончена : " + string(v-time,"HH:MM:SS"), num#str# , num#col#     )   .
     1457     Output stream OutStream   close .
     1458     Output stream Macr_Excel  close .
     1459   if mFrameView
     1460   then do:
     1461      HIDE FRAME InfoFrame.
     1462   end.
     1463       run paramls-write in this-procedure
     1464         (input "file"
     1465         ,input string(v-ind)
     1466         ,input v-file-name
     1467         ) .
     1468       run paramls-write in this-procedure
     1469           (input "charcol"
     1470           ,input ""
     1471           ,input "1,2,4,5,6,7,20"
     1472           ) .
     1473    run end-proc in this-procedure  .
     1474    run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1475    end.
     1476   procedure new-tmp-page :
     1477    do
     1478    on error undo, return error return-value
     1479    :
     1480       if   num#str#  >= 63000 then do:
     1481           Output stream Macr_Excel  close .
     1482           run paramls-write in this-procedure
     1483             (input "file"
     1484             ,input string(v-ind)
     1485             ,input v-file-name
     1486             ) .
     1487           run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1488           output stream  Macr_Excel to value(v-file-name) .
     1489           v-ind = v-ind + 1 .
     1490           num#str# = 0 .
     1491           run proc-print-header in this-procedure .
     1492       end.
     1493    end.
     1494   end procedure.
     1495   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   procedure macr_excel_char :
     1497    do
     1498    on error undo, return error return-value
     1499    :
     1500    define input parameter  p-val as character no-undo .
     1501    define input parameter  p-row as integer no-undo .
     1502    define input parameter  p-col as integer no-undo .
     1503    if p-val = ? then p-val = "" .
     1504       put stream macr_excel unformatted
     1505             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1506    end.
     1507   end procedure.
     1508   procedure macr_excel_char_with_format :
     1509    do
     1510    on error undo, return error return-value
     1511    :
     1512    define input parameter  p-val as character no-undo .
     1513    define input parameter  p-row as integer no-undo .
     1514    define input parameter  p-col as integer no-undo .
     1515    if p-val = ? then p-val = "" .
     1516       put stream macr_excel unformatted
     1517             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1518       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1519       put stream macr_excel unformatted
     1520             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1521    end.
     1522   end procedure.
     1523   procedure macr_excel_cell_format :
     1524    do
     1525    on error undo, return error return-value
     1526    :
     1527    define input parameter  p-val    as character no-undo .
     1528    define input parameter  p-row    as integer   no-undo .
     1529    define input parameter  p-col    as integer   no-undo .
     1530    define input parameter  p-format as character no-undo .
     1531    if p-val = ? then p-val = "" .
     1532       put stream macr_excel unformatted
     1533             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1534       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1535       put stream macr_excel unformatted
     1536             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1537    end.
     1538   end procedure.
     1539   procedure macr_excel_sum :
     1540    do
     1541    on error undo, return error return-value
     1542    :
     1543    define input parameter  p-row as integer no-undo .
     1544    define input parameter  p-col as integer no-undo .
     1545    define input parameter  p-row1 as integer no-undo .
     1546    define input parameter  p-col1 as integer no-undo .
     1547    define input parameter  p-row2 as integer no-undo .
     1548    define input parameter  p-col2 as integer no-undo .
     1549       put stream macr_excel unformatted
     1550             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1551    end.
     1552   end procedure.
     1553   procedure macr_excel_dec :
     1554    do
     1555    on error undo, return error return-value
     1556    :
     1557    define input parameter  p-val as character no-undo .
     1558    define input parameter  p-row as integer   no-undo .
     1559    define input parameter  p-col as integer   no-undo .
     1560     if p-val = ? then p-val =  "" .
     1561      put  stream macr_excel unformatted
     1562           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1563    end.
     1564   end procedure.
     1565   procedure macr_cell_format :
     1566    do
     1567    on error undo, return error return-value
     1568    :
     1569    define input parameter  p-size   as integer   no-undo .
     1570    define input parameter  p-bold   as logical   no-undo .
     1571    define input parameter  p-italic as logical   no-undo .
     1572    define input parameter  p-color  as integer   no-undo .
     1573    define input parameter  p-row    as integer   no-undo .
     1574    define input parameter  p-col    as integer   no-undo .
     1575    define input parameter  p-row-2  as integer   no-undo .
     1576    define input parameter  p-col-2  as integer   no-undo .
     1577     if p-size = ? then p-size = 10 .
     1578     if p-bold = ? then p-bold = false .
     1579     if p-italic = ? then p-italic = false .
     1580     if p-row-2 = ? then p-row-2 = p-row .
     1581     if p-col-2 = ? then p-col-2 = p-col .
     1582     put  stream macr_excel unformatted
     1583      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1584     if p-color <> ? then do:
     1585        put  stream macr_excel unformatted
     1586          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1587     end.
     1588     put  stream macr_excel unformatted
     1589          substitute('format.font(,&1,&2,&3)' , p-size,
     1590                                           string ( p-bold  , "true/false" ) ,
     1591                                           string ( p-italic , "true/false" )
     1592                                           ) + chr(10) .
     1593    end.
     1594   end procedure.
     1595   procedure macr_cell_size :
     1596    do
     1597    on error undo, return error return-value
     1598    :
     1599    define input parameter  p-w   as integer   no-undo .
     1600    define input parameter  p-l   as integer   no-undo .
     1601    define input parameter  p-row    as integer   no-undo .
     1602    define input parameter  p-col    as integer   no-undo .
     1603    define input parameter  p-row-2  as integer   no-undo .
     1604    define input parameter  p-col-2  as integer   no-undo .
     1605     if p-row-2 = ? then p-row-2 = p-row .
     1606     if p-col-2 = ? then p-col-2 = p-col .
     1607     if p-w = ? then    p-w = 0 .
     1608     if p-l = ? then    p-l = 0 .
     1609    define variable s-w as character no-undo .
     1610    define variable s-l as character no-undo .
     1611    if p-w = 0 then s-w = "" .
     1612               else s-w = string(p-w)  .
     1613    if p-l = 0 then s-l = "" .
     1614               else s-l = string(p-l)  .
     1615   put  stream macr_excel unformatted
     1616        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1617   put  stream macr_excel unformatted
     1618        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1619   put  stream macr_excel unformatted
     1620        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1621    end.
     1622   end procedure.
     1623   procedure proc-print-header :
     1624    do
     1625    on error undo, return error return-value
     1626    :
     1627      find first sheetf .
     1628        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1629        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1630        var-1 =  num#str# .
     1631        repeat c-c = 1 to sheetf.excel-row-title :
     1632        num#str# = num#str# + 1 .
     1633        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1634        do c-i = 1 to p-var :
     1635           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1636           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1637           num#col# = c-i .
     1638           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1639           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1640        end.
     1641       c-i = 0.
     1642       end.
     1643       run macr_cell_format (
     1644           10       ,
     1645           true     ,
     1646           false    ,
     1647           35       ,
     1648           var-1 + 1,
     1649           1        ,
     1650           num#str# ,
     1651           num#col# )
     1652           .
     1653     put  stream macr_excel unformatted
     1654          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1655          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1656          .
     1657    end.
     1658   end procedure.
     1659   procedure end-proc :
     1660    do
     1661    on error undo, return error return-value
     1662    :
     1663     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1664     OUTPUT to VALUE (v-file-name) .
     1665     for each temp-param :
     1666       export  temp-param  .
     1667     end.
     1668    end.
     1669   end procedure.
