     1241   FUNCTION excel-qnty-null RETURNS char (INPUT p-dec as decimal ).
     1242   if p-dec = 0 then Return ("").
     1243      else RETURN(format-excel-text(excel-format-dec-to-char(Round(p-dec,3)))) .
     1244   END FUNCTION.
     1245   main-block :
     1246   do on error undo main-block, return error
     1247   :
     1248   p-file-name =  string( session:temp-directory + "rpt" + string( g#report-num ) + ".txt" ) .
     1249   output stream outstream to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) )      .
     1250   output stream outstream2 to value(p-file-name).
     1251   run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1252   output stream macr_excel to value(v-file-name)   .
     1253   v-ind = 1    .
     1254   num#str# = 1 .
     1255   num#col# = 1 .
     1256   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1257     if  log-manager:logfile-name ne ?
     1258     then DO:
     1259         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1260     end.
     1261     if not session:batch-mode then
     1262     do:
     1263       VIEW FRAME InfoFrame.
     1264       mFrameView = true.
     1265     end.
     1266      v-button-stop = false .
     1267         if mFrameView
     1268         then do:
     1269         if v-button-stop then view STOPBTN in frame InfoFrame.
     1270                          else Hide STOPBTN in frame InfoFrame.
     1271         end.
