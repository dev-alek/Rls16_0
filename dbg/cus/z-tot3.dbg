      589   procedure cur-time :
      590      define output parameter p-today as date      no-undo .
      591      define output parameter p-time  as integer   no-undo .
      592     do
      593     on error undo, return error
      594     :
      595       define variable v-date1 as date      no-undo .
      596       define variable v-date2 as date      no-undo .
      597       define variable v-time  as integer   no-undo .
      598       assign
      599         v-date1 = today
      600         v-time  = time
      601         v-date2 = today
      602       .
      603       if v-date1 <> v-date2
      604       then do:
      605         assign
      606           v-date1 = today
      607           v-time  = v-time
      608         .
      609       end.
      610       assign
      611         p-today = v-date1
      612         p-time  = v-time
      613       .
      614     end.
      615   end.
      616   function cur-time-date returns character
      617   :
      618     return string(today, '99/99/9999':U) .
      619   end.
      620   function cur-time-mjd returns decimal
      621   :
      622     define variable v-date as date      no-undo .
      623     define variable v-time as integer   no-undo .
      624     run cur-time in this-procedure
      625       (output v-date
      626       ,output v-time
      627       ) .
      628     return integer(v-date) - 2400002 + (v-time / 86400) .
      629   end.
      630   function cur-time-get-ending-index returns integer
      631   (input p-number as integer
      632   )
      633   :
      634     if p-number < 0
      635     or p-number = ?
      636     then do:
      637       return 1 .
      638     end.
      639     define variable v-rest as integer   no-undo .
      640     assign
      641       p-number = p-number modulo 100
      642     .
      643     if p-number < 20
      644     then do:
      645       assign
      646         v-rest = p-number
      647       .
      648     end.
      649     else do:
      650       assign
      651         v-rest = p-number modulo 10
      652       .
      653     end.
      654     case v-rest :
      655       when 1
      656       then do:
      657         return 2 .
      658       end.
      659       when 2 or
      660       when 3 or
      661       when 4
      662       then do:
      663         return 3 .
      664       end.
      665       otherwise do:
      666         return 1 .
      667       end.
      668     end case .
      669   end.
      670   procedure cur-time-mjd-to-date :
      671      define input  parameter i-mjd-diff as decimal no-undo.
      672      define output parameter o-Date     as date    no-undo.
      673      define output parameter o-Time     as integer no-undo.
      674      define variable v-day-number as integer   no-undo .
      675      if    i-mjd-diff < 0
      676         or i-mjd-diff = ?
      677      then do:
      678         return "?" .
      679      end.
      680      assign
      681         v-day-number = truncate(i-mjd-diff,0).
      682         o-Date = date(v-day-number + 2400002).
      683         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      684     .
      685   end.
      686   function cur-time-mjd-to-string returns character
      687   (input p-mjd-diff as decimal
      688   )
      689   :
      690     define variable v-day-number as integer   no-undo .
      691     define variable v-seconds    as integer   no-undo .
      692     define variable v-hour       as integer   no-undo .
      693     define variable v-min        as integer   no-undo .
      694     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      695     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      696     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      697     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      698     if p-mjd-diff < 0
      699     or p-mjd-diff = ?
      700     then do:
      701       return "?" .
      702     end.
      703     assign
      704       v-day-number = integer(truncate(p-mjd-diff,0))
      705       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      706     .
      707     if v-seconds > 86400
      708     then do:
      709       assign
      710         v-seconds = 86400 - 1
      711       .
      712     end.
      713     if v-seconds < 0
      714     then do:
      715       assign
      716         v-seconds = 0
      717       .
      718     end.
      719     assign
      720       v-hour = truncate(v-seconds / 3600, 0)
      721     .
      722     assign
      723       v-seconds = v-seconds modulo 3600
      724     .
      725     assign
      726       v-min = truncate(v-seconds / 60, 0)
      727     .
      728     assign
      729       v-seconds = v-seconds modulo 60
      730     .
      731     return
      732         (if v-day-number <> 0
      733           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      734           else ""
      735         )
      736       + (if v-day-number <> 0 or v-hour <> 0
      737           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      738           else ""
      739         )
      740       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      741           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      742           else ""
      743         )
      744       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      745       .
      746   end.
      747   function cur-time-string returns character
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      756   end.
      757   function cur-time-string-sec returns character
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      766   end.
      767   function cur-time-custom  returns character
      768   (input p-prefix as character
      769   ,input p-date-format as character
      770   ,input p-delimiter as character
      771   ,input p-time-format as character
      772   ,input p-suffix as character
      773   )
      774   :
      775     define variable v-date as date      no-undo .
      776     define variable v-time as integer   no-undo .
      777     run cur-time in this-procedure
      778       (output v-date
      779       ,output v-time
      780       ) .
      781     return
      782       p-prefix
      783       + string(v-date, p-date-format)
      784       + p-delimiter
      785       + string(v-time, p-time-format)
      786       + p-suffix
      787       .
      788   end.
      789   function cur-time-print  returns character
      790   :
      791     define variable v-date as date      no-undo .
      792     define variable v-time as integer   no-undo .
      793     run cur-time in this-procedure
      794       (output v-date
      795       ,output v-time
      796       ) .
      797     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      798   end.
      799   function cur-time-datetime returns datetime
      800   :
      801     define variable v-char as character no-undo .
      802     define variable v-datetime as datetime no-undo .
      803     v-char = cur-time-string().
      804     v-datetime = datetime(v-char).
      805     return  v-datetime.
      806   end.
      807   function cur-time-string-msec returns character
      808   :
      809     define variable v-date as datetime  no-undo .
      810     v-date = now.
      811     return string(v-date) .
      812   end.
      813   define variable v-account as integer init 0 no-undo .
      814   define variable v-account-lavel as character no-undo .
      815   define variable v-button-stop as logical no-undo .
      816   define variable v-kol-spice as integer no-undo .
      817   define variable v-kol-spice2 as integer no-undo .
      818   define variable v-kol-spice3 as integer no-undo .
      819   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      820   DEFINE BUTTON StopBtn AUTO-END-KEY
      821        LABEL "Стоп"
      822        SIZE 10 BY 1.
      823   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      824        LABEL "Обработано записей"
      825         VIEW-AS TEXT
      826        SIZE 14 BY .67 NO-UNDO.
      827   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      828         VIEW-AS TEXT
      829        SIZE 53.25 BY .67
      830        FGCOLOR 1  NO-UNDO.
      831   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      832         VIEW-AS TEXT
      833        SIZE 53.25 BY .67
      834        FGCOLOR 1  NO-UNDO.
      835   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      836         VIEW-AS TEXT
      837        SIZE 53.25 BY .67
      838        FGCOLOR 1  NO-UNDO.
      839   DEFINE RECTANGLE RECT-1
      840        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      841        SIZE 55.13 BY 4.46.
      842   DEFINE FRAME InfoFrame
      843        StopBtn AT ROW 4.25 COL 21.75
      844        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      845        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      846        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      847        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      848        RECT-1 AT ROW 1 COL 1
      849       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      850            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      851            TITLE "Процесс"
      852            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      853   define variable mFrameView      as logical   no-undo init yes.
      854     define variable mFramHandle as handle no-undo.
      855     mFramHandle = frame InfoFrame:handle.
      856     if  log-manager:logfile-name ne ?
      857     then DO:
      858         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      859         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      860         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      861     end.
      862     mFrameView = not session:batch-mode and mFramHandle:visible.
      863     if mFrameView
      864     then do:
      865       ASSIGN
      866          FRAME InfoFrame:HIDDEN                           = TRUE
      867          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      868     end.
      869   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      870   DO:
      871     IF not StopProcessing THEN
      872       Message "Вы действительно хотите прервать" SKIP
      873               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      874                 UPDATE StopProcessing.
      875     IF StopProcessing THEN do:
      876        if mFrameView
      877        then do:
      878           HIDE FRAME InfoFrame.
      879        end.
      880     End.
      881   END.
      882   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      883     if num-entries(string(p-dec), '.') = 2
      884       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      885       else return( string(p-dec)) .
      886   end function.
      887   function format-point-to-comma returns char (input orig as char ) .
      888   define variable rtext as character no-undo .
      889   define variable strt as integer no-undo .
      890   define variable leng as integer no-undo .
      891   assign rtext = orig .
      892   repeat:
      893     strt =  index(rtext,'.').
      894     if strt = 0 then leave.
      895     leng = 1.
      896     substring(rtext,strt,leng,"character") = v-delim .
      897   end.
      898   return rtext.
      899   end function.
      900   function format-excel-text returns char ( input start-text as char ) :
      901   def var  i    as int no-undo.
      902   def var  ch   as char no-undo.
      903   def var  n    as int no-undo.
      904   def var  ipos as int no-undo.
      905     n = num-entries(trim(start-text), chr(10)) - 1 .
      906     do i = 1 to n :
      907       ipos = index( start-text, chr(10)).
      908       if ipos > 0 then
      909         substr( start-text, ipos, 1 ) = ' '.
      910     end.
      911     n = num-entries(trim(start-text), chr(13)) - 1 .
      912     do i = 1 to n :
      913       ipos = index( start-text, chr(13)).
      914       if ipos > 0 then
      915         substr( start-text, ipos, 1 ) = ' '.
      916     end.
      917     if index( start-text, '"' ) = 0 then
      918       start-text =  '="'   + trim( start-text) + '"'   .
      919       else do:
      920         n = num-entries(trim(start-text), '"') - 1.
      921         do i = 1 to n :
      922           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      923         end.
      924         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      925         start-text = '="'  + ch  + '"' .
      926       end.
      927     return start-text.
      928   end.
      929   function excel-sum returns char (input p-dec as decimal ).
      930     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      931   end function.
      932   function excel-qnty returns char (input p-dec as decimal ).
      933     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      934   end function.
      935   function format-excel-text-macr returns char ( input start-text as char ) :
      936   def var  i    as int no-undo.
      937   def var  ch   as char no-undo.
      938   def var  n    as int no-undo.
      939   def var  ipos as int no-undo.
      940     n = num-entries(trim(start-text), chr(10)) - 1 .
      941     do i = 1 to n :
      942       ipos = index( start-text, chr(10)).
      943       if ipos > 0 then
      944         substring( start-text, ipos , 1 ) = ' '.
      945     end.
      946     n = num-entries(trim(start-text), chr(13)) - 1 .
      947     do i = 1 to n :
      948       ipos = index( start-text, chr(13)).
      949       if ipos > 0 then
      950         substring( start-text, ipos, 1 ) = ' '.
      951     end.
      952     if index( start-text, '"' ) = 0 then
      953       start-text =  '"'   + trim( start-text) + '"'   .
      954       else do:
      955         n = num-entries(trim(start-text), '"') - 1.
      956         do i = 1 to n :
      957           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      958         end.
      959         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      960         start-text = '"'  + ch  + '"' .
      961       end.
      962     n = num-entries(trim(start-text), chr(10)) - 1 .
      963     do i = 1 to n :
      964       ipos = index( start-text, chr(10)).
      965       if ipos > 0 then
      966         substring( start-text, ipos , 1 ) = ' '.
      967     end.
      968       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      969     return start-text.
      970   end.
      971   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      972   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      973   procedure paramls-clear :
      974     define buffer buf_temp-param for temp-param .
      975     do
      976     on error undo, return error return-value
      977     :
      978       for each buf_temp-param
      979       on error undo, return error
      980       :
      981         delete buf_temp-param .
      982       end.
      983     end.
      984   end procedure.
      985   procedure paramls-write :
      986     define input  parameter p-code     as character no-undo .
      987     define input  parameter p-sub-code as character no-undo .
      988     define input  parameter p-value    as character no-undo .
      989     define buffer buf_temp-param for temp-param .
      990     do
      991     on error undo, return error return-value
      992     :
      993       find first buf_temp-param
      994         where buf_temp-param.param-code     = p-code
      995           and buf_temp-param.param-sub-code = p-sub-code
      996         no-error .
      997       if not available buf_temp-param then do:
      998         create buf_temp-param .
      999         assign
     1000           buf_temp-param.param-code     = p-code
     1001           buf_temp-param.param-sub-code = p-sub-code
     1002         .
     1003       end.
     1004       assign
     1005         buf_temp-param.param-value = p-value
     1006       .
     1007     end.
     1008   end procedure.
     1009   procedure paramls-read :
     1010     define input  parameter p-code          as character no-undo .
     1011     define input  parameter p-sub-code      as character no-undo .
     1012     define input  parameter p-default-value as character no-undo .
     1013     define output parameter p-value         as character no-undo .
     1014     define buffer buf_temp-param for temp-param .
     1015     do
     1016     on error undo, return error return-value
     1017     :
     1018       find first buf_temp-param
     1019         where buf_temp-param.param-code     = p-code
     1020           and buf_temp-param.param-sub-code = p-sub-code
     1021         no-error .
     1022       if available buf_temp-param then do:
     1023         assign
     1024           p-value = buf_temp-param.param-value
     1025         .
     1026       end.
     1027       else do:
     1028         assign
     1029           p-value = p-default-value
     1030         .
     1031       end.
     1032     end.
     1033   end procedure.
     1034   procedure paramls-append :
     1035     define input  parameter p-code     as character no-undo .
     1036     define input  parameter p-sub-code as character no-undo .
     1037     define input  parameter p-value    as character no-undo .
     1038     define buffer buf_temp-param for temp-param .
     1039     do
     1040     on error undo, return error return-value
     1041     :
     1042       find first buf_temp-param
     1043            where buf_temp-param.param-code     = p-code
     1044              and buf_temp-param.param-sub-code = p-sub-code
     1045         no-error .
     1046       if not available buf_temp-param then do:
     1047         create buf_temp-param .
     1048         assign
     1049           buf_temp-param.param-code     = p-code
     1050           buf_temp-param.param-sub-code = p-sub-code
     1051           buf_temp-param.param-value    = p-value
     1052         .
     1053       end.
     1054       else do:
     1055           assign
     1056               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1057           .
     1058       end.
     1059     end.
     1060   end procedure.
