        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: exp-kan2.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cus/exp-kan2.p $":U .
        7   define variable vss-description as character no-undo init "Экспорт текущих остатков по признакам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define temp-table mapobj no-undo
       69   field obj-type as character
       70   field obj-code as integer
       71   field kan-code as character
       72   index pi is unique primary obj-type obj-code.
       73   define variable map-str as character no-undo.
       74   define variable c_obj-type as character no-undo.
       75   define variable i_obj-code as integer no-undo.
       76   define variable c_kan-code as character no-undo.
       77   input from value(search('mapobj.txt')).
       78   repeat:
       79     import unformatted map-str.
       80     assign
       81     c_obj-type = entry(1, entry(1, map-str, ';'), ',')
       82     i_obj-code = integer(entry(2, entry(1, map-str, ';'), ','))
       83     c_kan-code = entry(2, map-str, ';') no-error.
       84     if error-status:error then do:
       85         message "Ошибка при чтении файла mapobj.txt" view-as alert-box error.
       86         return.
       87     end.
       88     create mapobj.
       89     assign
       90     mapobj.obj-type = c_obj-type
       91     mapobj.obj-code = i_obj-code
       92     mapobj.kan-code = c_kan-code.
       93   end.
       94   input close.
       95   define stream txt.
       96   define variable file-name as char no-undo.
       97   define variable obj as char no-undo.
       98   define variable simv as char no-undo.
       99   define variable prt-name as char no-undo.
      100   define variable glog as logical no-undo .
      101   glog = no.
      102   message "Экспорт остатков в файл." skip (2)
      103           "Продолжать ?"
      104          view-as alert-box question buttons OK-Cancel update glog.
      105   if not glog then return.
      106   system-dialog get-file file-name
      107     TITLE "Выберите файл для экспорта"
      108     filters " Текстовые файлы (*.txt) " "*.txt",
      109             " Все файлы (*.*) "         "*.*"
      110     ask-overwrite
      111     save-as
      112     use-filename
      113     update glog
      114     default-extension "txt".
      115   if not glog then return.
      116   if trim(file-name) = "" then do:
      117        message "Не задан файл для экспорта". pause.
      118        return.
      119   end.
      120   output stream txt to value (file-name) no-echo.
      121   put stream txt  unformatted
      122       "SHOP ID;DATE;INDEX-COLOR-SIZE;QUANTITY"
      123   skip.
      124   FIND FIRST sys-ctrl No-LOCK.
      125   FIND FIRST db no-LOCK where
      126              db.db-num = sys-ctrl.db-num.
      127   for each clients where
      128       clients.db-num = db.db-num no-lock:
      129       if clients.obj-type = "маг" then  obj = "R".
      130       else  obj = "W".
      131       for each prt-obj no-lock where
      132                        prt-obj.obj-type  = clients.obj-type
      133                  and prt-obj.obj-code  = clients.obj-code
      134                  and prt-obj.is-term    = yes
      135                  and prt-obj.fact-qnty  <> 0
      136                 use-index pi :
      137                 display
      138                     prt-obj.obj-type
      139                     prt-obj.obj-code
      140                     prt-obj.artic
      141                   with frame ff view-as dialog-box
      142                 title ": Остатки по товарам ".
      143                 pause 0.
      144                 find first mapobj no-lock where mapobj.obj-type = prt-obj.obj-type
      145                                                  and mapobj.obj-code = prt-obj.obj-code no-error.
      146                 if available mapobj then obj = mapobj.kan-code.
      147                 else obj = obj + string(prt-obj.obj-code, "99").
      148                 find gds-prt where gds-prt.node-code = prt-obj.prt-code no-lock no-error.
      149                 if not avail gds-prt then next.
      150                 prt-name = gds-prt.f-name.
      151                 simv  = "-".
      152                 if  r-index(prt-name, "/") > 0 then overlay ( prt-name, r-index(prt-name, "/"), 1) = simv.
      153                 else next.
      154                 put stream txt  unformatted
      155                     trim(string(obj)) + ";" +
      156                     trim(string(year(today), "9999")) + "-" +
      157                     trim(string(month(today), "99")) + "-" +
      158                     trim(string(DAY(today), "99")) + ";" +
      159                     trim(string(prt-obj.artic)) + "-" +
      160                     trim(string(prt-name)) + ";" +
      161                     trim(string(prt-obj.fact-qnty))
      162                 skip.
      163       end.
      164   end.
      165   output close.
      166   message "Экспорт в файл закончен.".
