      847   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   procedure proc-ord-code :
      849   define input  parameter  p-type as character no-undo .
      850   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      851   define input  parameter  v-cntxt-obj-type as character no-undo .
      852   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      853   define input  parameter  p-i-doc    as character no-undo .
      854   define output parameter  p-ord-doc  as character no-undo .
      855   define variable          v-idop     as character no-undo .
      856     do
      857     on error undo, return error return-value
      858     :
      859   case p-type :
      860       when "main-no-ver" then do:
      861         if  (v-cntxt-db-num <> 0) then
      862           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      863         else
      864           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      865       end.
      866       when "main" then do:
      867             do while true:
      868             if  (v-cntxt-db-num <> 0) then
      869               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      870             else
      871               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      872             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      873             End.
      874       end.
      875       when "chip" then do:
      876         assign
      877           v-idop = p-i-doc .
      878         do while true :
      879           if index (v-idop , ".") = 0 then
      880             v-idop  = replace (v-idop , "-", "-1.").
      881           else
      882             v-idop  =
      883             substring (v-idop , 1, index (v-idop, "-")) +
      884             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      885             substring (v-idop, index (v-idop, ".")).
      886           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      887         end.
      888         assign
      889           p-ord-doc = v-idop.
      890       end.
      891   end case.
      892     end.
      893   end procedure.
