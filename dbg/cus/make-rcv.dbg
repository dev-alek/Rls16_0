      839     define variable v-cntxt-db-num        as integer   no-undo .
      840     define variable v-cntxt-userid        as character no-undo .
      841     define variable v-cntxt-level         as character no-undo .
      842     define variable v-cntxt-host-code-obj as integer   no-undo .
