     1318     ) no-error .
     1319       if error-status :error
     1320       then do:
     1321         message
     1322           vss-workfile vss-revision vss-description skip
     1323           "Ошибка при создании истории по товару на объекте" skip
     1324           error-status :get-message(1) skip
     1325           return-value skip
     1326           view-as alert-box error .
     1327         undo, return error return-value .
     1328       end.
     1329       assign
     1330         p-gds-obj-fact-qnty = buf_gds-obj.fact-qnty
     1331       .
     1332   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   if  buf_gds-obj.first-doc <> ?
     1334   and buf_gds-obj.first-doc > p-fact-date then do:
     1335     assign
     1336       buf_gds-obj.first-doc  = p-fact-date
     1337     .
     1338   end.
     1339   if  buf_gds-obj.last-doc <> ?
     1340   and buf_gds-obj.last-doc < p-fact-date then do:
     1341     assign
     1342       buf_gds-obj.last-doc   = p-fact-date
     1343     .
     1344   end.
     1345       for each buf_temp-prt-obj
     1346       ,first buf_prt-obj exclusive-lock
     1347         where recid(buf_prt-obj) = buf_temp-prt-obj.prt-obj-recid
     1348       on error undo, return error return-value
     1349       :
     1350         assign
     1351           buf_prt-obj.price-sale = buf_temp-prt-obj.price-sale
     1352         .
     1353       end.
     1354     end.
     1355   end procedure.
     1356   procedure prdoclib-clear-temp-prt-obj :
     1357     define buffer buf_temp-prt-obj for temp-prt-obj .
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       for each buf_temp-prt-obj
     1362       on error undo, return error return-value
     1363       :
     1364         delete buf_temp-prt-obj .
     1365       end.
     1366     end.
     1367   end procedure.
     1368   procedure prdoclib-create-temp-prt-obj :
     1369     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1370     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1371     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1372     define buffer buf_gds-prt for ub.gds-prt .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       find first buf_temp-prt-obj
     1377         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1378         no-error .
     1379       if not available buf_temp-prt-obj
     1380       then do:
     1381         create buf_temp-prt-obj .
     1382         assign
     1383           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1384           buf_temp-prt-obj.price-sale       = ?
     1385           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1386           buf_temp-prt-obj.price-list-qnty  = ?
     1387           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1388           buf_temp-prt-obj.price-list-recid = ?
     1389         .
     1390         find first buf_gds-prt no-lock
     1391           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1392           .
     1393         assign
     1394           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1395         .
     1396         if buf_temp-prt-obj.is-term
     1397         then do:
     1398           assign
     1399             buf_temp-prt-obj.price-sale = p-root-price-sale
     1400           .
     1401         end.
     1402       end.
     1403     end.
     1404   end procedure.
     1405   procedure prdoclib-temp-prt-obj-by-prt-root :
     1406     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1407     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1408     define buffer buf_gds-prt for ub.gds-prt .
     1409     do
     1410     on error undo, return error return-value
     1411     :
     1412       find first buf_temp-prt-obj
     1413         where buf_temp-prt-obj.prt-code = p-prt-code
     1414         no-error .
     1415       if not available buf_temp-prt-obj
     1416       then do:
     1417         create buf_temp-prt-obj .
     1418         assign
     1419           buf_temp-prt-obj.prt-code         = p-prt-code
     1420           buf_temp-prt-obj.price-sale       = ?
     1421           buf_temp-prt-obj.fact-qnty        = 0
     1422           buf_temp-prt-obj.price-list-qnty  = ?
     1423           buf_temp-prt-obj.prt-obj-recid    = ?
     1424           buf_temp-prt-obj.price-list-recid = ?
     1425         .
     1426         find first buf_gds-prt no-lock
     1427           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1428           .
     1429         assign
     1430           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1431         .
     1432         if buf_temp-prt-obj.is-term
     1433         then do:
     1434           assign
     1435             buf_temp-prt-obj.price-sale = 0
     1436           .
     1437         end.
     1438       end.
     1439     end.
     1440   end procedure.
     1441   procedure prdoclib-init-temp-prt-obj :
     1442     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1443     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1444     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1445     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1446     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1447     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1448     define buffer buf_prt-obj      for ub.prt-obj .
     1449     define buffer buf_temp-prt-obj for temp-prt-obj .
     1450     do
     1451     on error undo, return error return-value
     1452     :
     1453       run prdoclib-clear-temp-prt-obj in this-procedure .
     1454       for each buf_prt-obj
     1455         where buf_prt-obj.obj-type  = p-obj-type
     1456           and buf_prt-obj.obj-code  = p-obj-code
     1457           and buf_prt-obj.artic     = p-artic
     1458           and buf_prt-obj.prod-type = p-prod-type
     1459           and buf_prt-obj.prod-code = p-prod-code
     1460       on error undo, return error return-value
     1461       :
     1462         run prdoclib-create-temp-prt-obj in this-procedure
     1463           (input  p-root-price-sale
     1464           ,buffer buf_prt-obj
     1465           ,buffer buf_temp-prt-obj
     1466           ).
     1467       end.
     1468     end.
     1469   end procedure.
     1470   procedure prdoclib-calc-fact-sale :
     1471     define input  parameter p-price-list-recid   as recid     no-undo .
     1472     define output parameter p-fact-qnty          as decimal   no-undo .
     1473     define output parameter p-cur-base           as decimal   no-undo .
     1474     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1475     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1476     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1477     define output parameter p-cur-excise-base    as decimal   no-undo .
     1478     define buffer buf_main_price-list for ub.price-list .
     1479     define buffer buf_price-list      for ub.price-list .
     1480     define buffer buf_goods           for ub.goods .
     1481     define buffer buf_gds-obj         for ub.gds-obj .
     1482     define buffer buf_bar-code        for ub.bar-code .
     1483     define variable l-empty-scale   as logical   no-undo .
     1484     do
     1485     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1486     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1487     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1488     :
     1489       find first buf_main_price-list no-lock
     1490         where recid(buf_main_price-list) = p-price-list-recid
     1491         no-error .
     1492       if not available buf_main_price-list
     1493       then do:
     1494         message
     1495           vss-workfile vss-revision vss-description skip
     1496           vss-include-info10 skip
     1497           "Ошибка задания входных параметров" skip
     1498           "Не найдена строка переоценки" skip
     1499           "Код записи (recid)" p-price-list-recid skip
     1500           view-as alert-box error .
     1501         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1502       end.
     1503       if buf_main_price-list.main-price <> true
     1504       then do:
     1505         message
     1506           vss-workfile vss-revision vss-description skip
     1507           vss-include-info10 skip
     1508           "Ошибка задания входных параметров" skip
     1509           "Строка переоценки не является основной" skip
     1510           "Код записи (recid)" p-price-list-recid skip
     1511           "Переоценка" buf_main_price-list.doc-num skip
     1512           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1513           "Бар-код" buf_main_price-list.b-code skip
     1514           view-as alert-box error .
     1515         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1516       end.
     1517       find first buf_goods no-lock
     1518         where buf_goods.artic     = buf_main_price-list.artic
     1519           and buf_goods.prod-type = buf_main_price-list.prod-type
     1520           and buf_goods.prod-code = buf_main_price-list.prod-code
     1521         no-error .
     1522       if not available buf_goods
     1523       then do:
     1524         message
     1525           vss-workfile vss-revision vss-description skip
     1526           vss-include-info10 skip
     1527           "Не найден товар" skip
     1528           "Переоценка" buf_main_price-list.doc-num skip
     1529           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1530           view-as alert-box error .
     1531         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1532       end.
     1533   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1535     (input  buf_main_price-list.artic
     1536     ,input  buf_main_price-list.prod-type
     1537     ,input  buf_main_price-list.prod-code
     1538     ,input  'empty-scale=request':u
     1539     ,output l-empty-scale
     1540     ) no-error .
     1541       if error-status :error
     1542       then do:
     1543         message
     1544           vss-workfile vss-revision vss-description skip
     1545           vss-include-info10 skip
     1546           "Ошибка при определении атрибута товара" skip
     1547           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1548           'empty-scale=request':u skip
     1549           error-status :get-message(1) skip
     1550           return-value skip
     1551           view-as alert-box error .
     1552         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1553       end.
     1554       find first buf_gds-obj no-lock
     1555         where buf_gds-obj.gds-code = buf_goods.gds-code
     1556           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     1557           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     1558         no-error .
     1559         if not available buf_gds-obj then do:
     1560   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1562     (input  buf_main_price-list.obj-type
     1563     ,input  buf_main_price-list.obj-code
     1564     ,input  buf_goods.artic
     1565     ,input  buf_goods.prod-type
     1566     ,input  buf_goods.prod-code
     1567     ,buffer buf_gds-obj
     1568     ) no-error .
     1569           if error-status :error then do:
     1570              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1571           end.
     1572         end.
     1573       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1574       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1575       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1576       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1577       define variable vat-base-sale-prl               as decimal   no-undo .
     1578       define variable vat-rubl-sale-prl               as decimal   no-undo .
     1579       define variable vat-base-buyer-prl              as decimal   no-undo .
     1580       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1581       define variable slt-base-sale-prl               as decimal   no-undo .
     1582       define variable slt-rubl-sale-prl               as decimal   no-undo .
     1583       define variable road-tax-base-sale-prl          as decimal   no-undo .
     1584       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1585       define variable excise-base-sale-prl            as decimal   no-undo .
     1586       define variable excise-rubl-sale-prl            as decimal   no-undo .
     1587       define variable discnt-base-sale-prl            as decimal   no-undo .
     1588       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1589       if buf_main_price-list.doc-qnty <> 0
     1590       then do:
     1591         run prl-vat in this-procedure
     1592           (input  recid(buf_main_price-list)
     1593           ,output price-rubl-with-tax-sale-prl
     1594           ,output price-base-with-tax-sale-prl
     1595           ,output price-rubl-without-tax-sale-prl
     1596           ,output price-base-without-tax-sale-prl
     1597           ,output vat-base-sale-prl
     1598           ,output vat-rubl-sale-prl
     1599           ,output vat-base-buyer-prl
     1600           ,output vat-rubl-buyer-prl
     1601           ,output slt-base-sale-prl
     1602           ,output slt-rubl-sale-prl
     1603           ,output road-tax-base-sale-prl
     1604           ,output road-tax-rubl-sale-prl
     1605           ,output excise-base-sale-prl
     1606           ,output excise-rubl-sale-prl
     1607           ,output discnt-base-sale-prl
     1608           ,output discnt-rubl-sale-prl
     1609           ) no-error .
     1610         if error-status :error
     1611         then do:
     1612           message
     1613             vss-workfile vss-revision vss-description skip
     1614             vss-include-info10 skip
     1615             "Ошибка при вызове процеды prl-vat" skip
     1616             "Документ" buf_main_price-list.doc-num skip
     1617             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1618             error-status :get-message(1) skip
     1619             return-value skip
     1620             view-as alert-box error .
     1621           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1622         end.
     1623       end.
     1624       else do:
     1625         assign
     1626           price-rubl-with-tax-sale-prl    = 0
     1627           price-base-with-tax-sale-prl    = 0
     1628           price-rubl-without-tax-sale-prl = 0
     1629           price-base-without-tax-sale-prl = 0
     1630           vat-base-sale-prl               = 0
     1631           vat-rubl-sale-prl               = 0
     1632           vat-base-buyer-prl              = 0
     1633           vat-rubl-buyer-prl              = 0
     1634           slt-base-sale-prl               = 0
     1635           slt-rubl-sale-prl               = 0
     1636           road-tax-base-sale-prl          = 0
     1637           road-tax-rubl-sale-prl          = 0
     1638           excise-base-sale-prl            = 0
     1639           excise-rubl-sale-prl            = 0
     1640           discnt-base-sale-prl            = 0
     1641           discnt-rubl-sale-prl            = 0
     1642         .
     1643       end.
     1644       define variable v-curr-r-b as character no-undo .
     1645   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1647     (output v-curr-r-b
     1648     )  .
     1649       if v-curr-r-b = 'base':U
     1650       then do:
     1651         assign
     1652           p-fact-qnty         = buf_main_price-list.doc-qnty
     1653           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1654           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1655           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1656           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1657           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1658         .
     1659       end.
     1660       else do:
     1661         assign
     1662           p-fact-qnty         = buf_main_price-list.doc-qnty
     1663           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1664           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1665           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1666           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1667           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1668         .
     1669       end.
     1670         define variable v-unit-base like ub.goods.unit-base no-undo .
     1671   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1673     (input  buf_goods.gds-code
     1674     ,output v-unit-base
     1675     ) no-error .
     1676         if error-status :error
     1677         then do:
     1678           message
     1679             vss-workfile vss-revision vss-description skip
     1680             vss-include-info10 skip
     1681             "Ошибка при определении базовой единицы измерения товара" skip
     1682             "Код товара" buf_goods.gds-code skip
     1683             error-status :get-message(1) skip
     1684             return-value skip
     1685             view-as alert-box error .
     1686           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1687         end.
     1688         for each buf_price-list no-lock
     1689           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1690             and buf_price-list.main-price = false
     1691             and buf_price-list.artic      = buf_main_price-list.artic
     1692             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1693             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1694         :
     1695           if buf_price-list.doc-qnty = ?
     1696           then do:
     1697             find first buf_bar-code no-lock
     1698               where buf_bar-code.b-code = buf_price-list.b-code
     1699               no-error .
     1700             if available buf_bar-code
     1701             and buf_bar-code.unit-cli = v-unit-base
     1702             then do:
     1703               message
     1704                 vss-workfile vss-revision vss-description skip
     1705                 vss-include-info10 skip
     1706                 "Ошибка при закрытии переоценки" skip
     1707                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1708                 "Переоценка" buf_main_price-list.doc-num skip
     1709                 "Бар-код" buf_price-list.b-code skip
     1710                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1711                 "Количество" buf_price-list.doc-qnty skip
     1712                 "Основная единица измерения" v-unit-base skip
     1713                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1714                 view-as alert-box error .
     1715               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1716             end.
     1717             next .
     1718           end.
     1719           if not can-find
     1720             (first buf_bar-code
     1721             where buf_bar-code.b-code = buf_price-list.b-code
     1722             )
     1723           then do:
     1724             message
     1725               vss-workfile vss-revision vss-description skip
     1726               vss-include-info10 skip
     1727               "В переоценке задан несуществующий бар-код" skip
     1728               "Переоценка" buf_price-list.doc-num skip
     1729               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1730               "Бар-код" buf_price-list.b-code skip
     1731               view-as alert-box error .
     1732             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1733           end.
     1734           if buf_price-list.doc-qnty <> 0
     1735           then do:
     1736             run prl-vat in this-procedure
     1737               (input  recid(buf_price-list)
     1738               ,output price-rubl-with-tax-sale-prl
     1739               ,output price-base-with-tax-sale-prl
     1740               ,output price-rubl-without-tax-sale-prl
     1741               ,output price-base-without-tax-sale-prl
     1742               ,output vat-base-sale-prl
     1743               ,output vat-rubl-sale-prl
     1744               ,output vat-base-buyer-prl
     1745               ,output vat-rubl-buyer-prl
     1746               ,output slt-base-sale-prl
     1747               ,output slt-rubl-sale-prl
     1748               ,output road-tax-base-sale-prl
     1749               ,output road-tax-rubl-sale-prl
     1750               ,output excise-base-sale-prl
     1751               ,output excise-rubl-sale-prl
     1752               ,output discnt-base-sale-prl
     1753               ,output discnt-rubl-sale-prl
     1754               ) no-error .
     1755             if error-status :error
     1756             then do:
     1757               message
     1758                 vss-workfile vss-revision vss-description skip
     1759                 vss-include-info10 skip
     1760                 "Ошибка при вызове процеды prl-vat" skip
     1761                 "Документ" buf_price-list.doc-num skip
     1762                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1763                 error-status :get-message(1) skip
     1764                 return-value skip
     1765                 view-as alert-box error .
     1766               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1767             end.
     1768           end.
     1769           else do:
     1770             assign
     1771               price-rubl-with-tax-sale-prl    = 0
     1772               price-base-with-tax-sale-prl    = 0
     1773               price-rubl-without-tax-sale-prl = 0
     1774               price-base-without-tax-sale-prl = 0
     1775               vat-base-sale-prl               = 0
     1776               vat-rubl-sale-prl               = 0
     1777               vat-base-buyer-prl              = 0
     1778               vat-rubl-buyer-prl              = 0
     1779               slt-base-sale-prl               = 0
     1780               slt-rubl-sale-prl               = 0
     1781               road-tax-base-sale-prl          = 0
     1782               road-tax-rubl-sale-prl          = 0
     1783               excise-base-sale-prl            = 0
     1784               excise-rubl-sale-prl            = 0
     1785               discnt-base-sale-prl            = 0
     1786               discnt-rubl-sale-prl            = 0
     1787             .
     1788           end.
     1789           if v-curr-r-b = 'base':U
     1790           then do:
     1791             assign
     1792               p-fact-qnty         = p-fact-qnty
     1793                                   + buf_price-list.doc-qnty
     1794               p-cur-base          = p-cur-base
     1795                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1796               p-cur-VAT-base      = p-cur-VAT-base
     1797                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1798               p-cur-SLT-base      = p-cur-SLT-base
     1799                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1800               p-cur-road-tax-base = p-cur-road-tax-base
     1801                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1802               p-cur-excise-base   = p-cur-excise-base
     1803                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1804             .
     1805           end.
     1806           else do:
     1807             assign
     1808               p-fact-qnty         = p-fact-qnty
     1809                                   + buf_price-list.doc-qnty
     1810               p-cur-base          = p-cur-base
     1811                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1812               p-cur-VAT-base      = p-cur-VAT-base
     1813                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1814               p-cur-SLT-base      = p-cur-SLT-base
     1815                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1816               p-cur-road-tax-base = p-cur-road-tax-base
     1817                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1818               p-cur-excise-base   = p-cur-excise-base
     1819                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1820             .
     1821           end.
     1822         end.
     1823     end.
     1824   end procedure.
     1825   procedure prdoclib-calc-prc :
     1826     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1827     define input  parameter p-cons-pay        as   integer                no-undo.
     1828     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1829     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1830     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1831     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1832     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1833     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1834     do
     1835     on error undo, return error return-value
     1836     :
     1837       define buffer buf_price-doc       for ub.price-doc .
     1838       define buffer buf_price-list      for ub.price-list .
     1839       define buffer buf_parts           for ub.parts .
     1840       define variable v-ov-qnty     as decimal   no-undo .
     1841       define variable v-ov-base     as decimal   no-undo .
     1842       define variable v-ov-VAT-base as decimal   no-undo .
     1843       define variable v-ov-SLT-base as decimal   no-undo .
     1844       define variable v-cons-qnty   as decimal   no-undo .
     1845       define variable v-prch-qnty   as decimal   no-undo .
     1846       define variable v-cons-mult   as decimal   no-undo .
     1847       define variable v-prch-mult   as decimal   no-undo .
     1848       find first buf_price-doc no-lock
     1849         where recid(buf_price-doc) = p-price-doc-recid
     1850         no-error .
     1851       if not available buf_price-doc
     1852       then do:
     1853         message
     1854           vss-workfile vss-revision vss-description skip
     1855           vss-include-info10 skip
     1856           "Ошибка задания входных параметров" skip
     1857           "Не найден документ переоценки" skip
     1858           "Код записи (recid)" p-price-doc-recid skip
     1859           view-as alert-box error .
     1860         undo, return error .
     1861       end.
     1862       for each buf_price-list no-lock
     1863         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1864           and buf_price-list.main-price = true
     1865       on error undo, return error return-value
     1866       :
     1867         run prdoclib-calc-ov
     1868           (input recid(buf_price-list)
     1869           ,output v-ov-qnty
     1870           ,output v-ov-base
     1871           ,output v-ov-VAT-base
     1872           ,output v-ov-SLT-base
     1873           ) no-error .
     1874         if error-status :error
     1875         then do:
     1876           if error-status :get-message(1) <> ""
     1877           then do:
     1878             message
     1879               vss-workfile vss-revision vss-description skip
     1880               vss-include-info10 skip
     1881               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1882               error-status :get-message(1) skip
     1883               return-value skip
     1884               view-as alert-box error .
     1885           end.
     1886           undo, return error return-value .
     1887         end.
     1888         assign
     1889           v-cons-qnty = 0
     1890           v-prch-qnty = 0
     1891         .
     1892         for each buf_parts no-lock
     1893           where buf_parts.out-code  = buf_price-list.doc-num
     1894             and buf_parts.obj-type  = buf_price-list.obj-type
     1895             and buf_parts.obj-code  = buf_price-list.obj-code
     1896             and buf_parts.artic     = buf_price-list.artic
     1897             and buf_parts.prod-type = buf_price-list.prod-type
     1898             and buf_parts.prod-code = buf_price-list.prod-code
     1899         on error undo, return error return-value
     1900         :
     1901           if buf_parts.pay-code = p-cons-pay
     1902           then do:
     1903             assign
     1904               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1905             .
     1906           end.
     1907           else do:
     1908             assign
     1909               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1910             .
     1911           end.
     1912         end.
     1913         if (v-cons-qnty + v-prch-qnty) = 0
     1914         then do:
     1915           assign
     1916             v-cons-mult = 0
     1917             v-prch-mult = 1
     1918           .
     1919         end.
     1920         else do:
     1921           assign
     1922             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1923             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1924           .
     1925         end.
     1926         assign
     1927           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1928           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1929           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1930           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1931           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1932           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1933         .
     1934       end.
     1935     end.
     1936   end procedure.
     1937   procedure prdoclib-calc-ov :
     1938     define input  parameter p-price-list-recid as recid     no-undo .
     1939     define output parameter p-fact-qnty        as decimal   no-undo .
     1940     define output parameter p-ov-base          as decimal   no-undo .
     1941     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1942     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1943     do
     1944     on error undo, return error return-value
     1945     :
     1946       define buffer buf_main_price-list    for ub.price-list .
     1947       define buffer buf_prev_price-list    for ub.price-list .
     1948       define buffer buf_special_price-list for ub.price-list .
     1949       define buffer buf_goods              for ub.goods .
     1950       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1951       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1952       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1953       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1954       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1955       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1956       define variable v-prev-price-list-recid as   recid                  no-undo.
     1957       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1958       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1959       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1960       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1961       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1962       find first buf_main_price-list no-lock
     1963         where recid(buf_main_price-list) = p-price-list-recid
     1964         no-error .
     1965       if not available buf_main_price-list
     1966       then do:
     1967         message
     1968           vss-workfile vss-revision vss-description skip
     1969           vss-include-info10 skip
     1970           "Ошибка задания входных параметров" skip
     1971           "Не найдена строка переоценки" skip
     1972           "Код записи (recid)" p-price-list-recid skip
     1973           view-as alert-box error .
     1974         undo, return error .
     1975       end.
     1976       if buf_main_price-list.main-price <> true
     1977       then do:
     1978         message
     1979           vss-workfile vss-revision vss-description skip
     1980           vss-include-info10 skip
     1981           "Ошибка задания входных параметров" skip
     1982           "Строка переоценки не является основной" skip
     1983           "Код записи (recid)" p-price-list-recid skip
     1984           "Переоценка" buf_main_price-list.doc-num skip
     1985           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1986           "Бар-код" buf_main_price-list.b-code skip
     1987           view-as alert-box error .
     1988         undo, return error .
     1989       end.
     1990       run prdoclib-calc-fact-sale in this-procedure
     1991         (input  recid(buf_main_price-list)
     1992         ,output v-fact-qnty
     1993         ,output v-cur-base
     1994         ,output v-cur-VAT-base
     1995         ,output v-cur-SLT-base
     1996         ,output v-cur-road-tax-base
     1997         ,output v-cur-excise-base
     1998         ) no-error.
     1999       if error-status :error
     2000       then do:
     2001         message
     2002           vss-workfile vss-revision vss-description skip
     2003           vss-include-info10 skip
     2004           "Ошибка при расчете сумм переоценки." skip
     2005           "Документ переоценки" buf_main_price-list.doc-num skip
     2006           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2007           error-status :get-message(1) skip
     2008           return-value skip
     2009           view-as alert-box error .
     2010         undo, return error .
     2011       end.
     2012   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2014     (input  buf_main_price-list.obj-type
     2015     ,input  buf_main_price-list.obj-code
     2016     ,input  buf_main_price-list.b-code
     2017     ,input  buf_main_price-list.b-code
     2018     ,input  buf_main_price-list.fact-order
     2019     ,output v-prev-price-list-recid
     2020     ,output v-prev-cli-base-rate
     2021     ) no-error .
     2022       if error-status :error
     2023       then do:
     2024         message
     2025           vss-workfile vss-revision vss-description skip
     2026           vss-include-info10 skip
     2027           "Ошибка при поиске предыдущей переоценки." skip
     2028           "Документ переоценки " buf_main_price-list.doc-num skip
     2029           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2030           error-status :get-message(1) skip
     2031           return-value skip
     2032           view-as alert-box error .
     2033         undo, return error .
     2034       end.
     2035       if v-prev-price-list-recid <> ?
     2036       then do:
     2037         find first buf_prev_price-list no-lock
     2038           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2039           .
     2040         find first buf_special_price-list no-lock
     2041           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2042             and buf_special_price-list.main-price = false
     2043             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2044             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2045             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2046             and buf_special_price-list.doc-qnty   <> ?
     2047           no-error .
     2048         if available buf_special_price-list
     2049         then do:
     2050           message
     2051             "Товар имеет специальные цены на признаки" skip
     2052             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2053             "Переоценка" buf_prev_price-list.doc-num skip
     2054             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2055             view-as alert-box error .
     2056           undo, return error .
     2057         end.
     2058         find first buf_goods no-lock
     2059           where buf_goods.artic     = buf_main_price-list.artic
     2060             and buf_goods.prod-type = buf_main_price-list.prod-type
     2061             and buf_goods.prod-code = buf_main_price-list.prod-code
     2062           no-error .
     2063         if not available buf_goods
     2064         then do:
     2065           message
     2066             vss-workfile vss-revision vss-description skip
     2067             vss-include-info10 skip
     2068             "Не найден товар" skip
     2069             "Переоценка" buf_main_price-list.doc-num skip
     2070             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2071             view-as alert-box error .
     2072           undo, return error .
     2073         end.
     2074         if buf_prev_price-list.vat-pc = ?
     2075         or buf_prev_price-list.slt-pc = ?
     2076         then do:
     2077           message
     2078             "В переоценке не заданы налоги товара" skip
     2079             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2080             "Переоценка" buf_prev_price-list.doc-num skip
     2081             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2082             "НДС" buf_prev_price-list.vat-pc skip
     2083             "НП" buf_prev_price-list.slt-pc skip
     2084             view-as alert-box error .
     2085           undo, return error return-value .
     2086         end.
     2087         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2088         assign
     2089           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2090         .
     2091         assign
     2092           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2093           v-prev-cur-VAT-base = v-fact-qnty
     2094                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2095                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2096           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2097         .
     2098         assign
     2099           p-fact-qnty   = v-fact-qnty
     2100           p-ov-base     = v-cur-base     - v-prev-cur-base
     2101           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2102           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2103         .
     2104       end.
     2105       else do:
     2106         assign
     2107           v-prev-cur-base     = 0
     2108           v-prev-cur-VAT-base = 0
     2109           v-prev-cur-SLT-base = 0
     2110           .
     2111         assign
     2112           p-fact-qnty   = v-fact-qnty
     2113           p-ov-base     = v-cur-base     - v-prev-cur-base
     2114           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2115           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2116         .
     2117       end.
     2118     end.
     2119   end procedure.
     2120   procedure prdoclib-init-prt-obj-by-factord :
     2121     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2122     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2123     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2124     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2125     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2126     define input parameter p-fact-order         as decimal   no-undo .
     2127     define input parameter p-include-fact-order as logical   no-undo .
     2128     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2129     define buffer buf_gds-obj      for ub.gds-obj .
     2130     define buffer buf_doc-line     for ub.doc-line .
     2131     define buffer buf_temp-prt-obj for temp-prt-obj .
     2132     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       do transaction
     2137       on error undo, return error return-value
     2138       :
     2139   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2140   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2141     (input  p-obj-type
     2142     ,input  p-obj-code
     2143     ,input  p-artic
     2144     ,input  p-prod-type
     2145     ,input  p-prod-code
     2146     ,buffer buf_gds-obj
     2147     ) no-error .
     2148         if error-status :error
     2149         then do:
     2150           message
     2151             vss-workfile vss-revision vss-description skip
     2152             vss-include-info10 skip
     2153             "Невозможно найти gds-obj" skip
     2154             error-status :get-message(1) skip
     2155             return-value skip
     2156             view-as alert-box error .
     2157           undo, return error .
     2158         end.
     2159         find current buf_gds-obj exclusive-lock .
     2160       end.
     2161       run prdoclib-init-temp-prt-obj in this-procedure
     2162         (input p-obj-type
     2163         ,input p-obj-code
     2164         ,input p-artic
     2165         ,input p-prod-type
     2166         ,input p-prod-code
     2167         ,input 0
     2168         ) .
     2169       for each buf_temp-prt-obj
     2170         where buf_temp-prt-obj.is-term <> true
     2171       on error undo, return error return-value
     2172       :
     2173         delete buf_temp-prt-obj .
     2174       end.
     2175       if p-include-fact-order = true
     2176       then do:
     2177         assign
     2178          p-fact-order = p-fact-order - 0.0000000001
     2179         .
     2180       end.
     2181       for each buf_doc-line no-lock
     2182         where buf_doc-line.obj-type   = p-obj-type
     2183           and buf_doc-line.obj-code   = p-obj-code
     2184           and buf_doc-line.artic      = p-artic
     2185           and buf_doc-line.prod-type  = p-prod-type
     2186           and buf_doc-line.prod-code  = p-prod-code
     2187           and buf_doc-line.status_    = 'факт':U
     2188           and buf_doc-line.fact-order >= p-fact-order
     2189       on error undo, return error return-value
     2190       :
     2191         run prdoclib-process-document in this-procedure
     2192           (input  buf_doc-line.doc-code
     2193           ,input  p-obj-type
     2194           ,input  p-obj-code
     2195           ,input  p-artic
     2196           ,input  p-prod-type
     2197           ,input  p-prod-code
     2198           ,output v-total-gds-dtl-qnty
     2199           ) .
     2200       end.
     2201     end.
     2202   end procedure.
     2203   procedure prdoclib-process-document :
     2204     define input  parameter p-doc-code           as character no-undo .
     2205     define input  parameter p-obj-type           as character no-undo .
     2206     define input  parameter p-obj-code           as integer   no-undo .
     2207     define input  parameter p-artic              as character no-undo .
     2208     define input  parameter p-prod-type          as character no-undo .
     2209     define input  parameter p-prod-code          as integer   no-undo .
     2210     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2211     define buffer buf_trn-doc      for ub.trn-doc .
     2212     define buffer buf_gds-dtl      for ub.gds-dtl .
     2213     define buffer buf_temp-prt-obj for temp-prt-obj .
     2214     do
     2215     on error undo, return error return-value
     2216     :
     2217       find first buf_trn-doc no-lock
     2218         where buf_trn-doc.doc-code = p-doc-code
     2219         no-error .
     2220       if not available buf_trn-doc then do:
     2221         message
     2222           vss-workfile vss-revision vss-description skip
     2223           vss-include-info10 skip
     2224           "Ошибка при поиске документа" skip
     2225           "Документ" p-doc-code skip
     2226           "Объект" p-obj-type p-obj-code skip
     2227           "Артикул" p-artic p-prod-type p-prod-code skip
     2228           view-as alert-box error .
     2229         undo, return error .
     2230       end.
     2231       assign
     2232         p-total-gds-dtl-qnty = 0
     2233       .
     2234       for each buf_gds-dtl no-lock
     2235         where buf_gds-dtl.doc-code  = p-doc-code
     2236           and buf_gds-dtl.artic     = p-artic
     2237           and buf_gds-dtl.prod-type = p-prod-type
     2238           and buf_gds-dtl.prod-code = p-prod-code
     2239       on error undo, return error
     2240       :
     2241         define variable v-term-node as integer   no-undo .
     2242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2243     (input  buf_gds-dtl.prt-code
     2244     ,output v-term-node
     2245     )  .
     2246         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2247           (input  v-term-node
     2248           ,buffer buf_temp-prt-obj
     2249           ) .
     2250         if buf_temp-prt-obj.is-term <> true then do:
     2251           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2252                                        ,buf_gds-dtl.prt-code
     2253                                        ) .
     2254         end.
     2255         case buf_trn-doc.doc-type :
     2256           when 'при':U or
     2257           when 'возврат':U
     2258           then do:
     2259             assign
     2260               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2261                                           - buf_gds-dtl.fact-qnty
     2262               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2263                                           - buf_gds-dtl.fact-qnty
     2264             .
     2265           end.
     2266           when 'рас':U or
     2267           when 'спи':U
     2268           then do:
     2269             assign
     2270               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2271                                           + buf_gds-dtl.fact-qnty
     2272               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2273                                           + buf_gds-dtl.fact-qnty
     2274             .
     2275           end.
     2276           when 'инв':U
     2277           then do:
     2278             assign
     2279               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2280                                           - buf_gds-dtl.doc-qnty
     2281               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2282                                           - buf_gds-dtl.doc-qnty
     2283             .
     2284           end.
     2285           otherwise do:
     2286             undo, return error substitute("Неизвестный тип документа &1"
     2287                                          ,buf_trn-doc.doc-type
     2288                                          ) .
     2289           end.
     2290         end.
     2291       end.
     2292     end.
     2293   end procedure.
     2294   procedure prdoclib-prc-pl-document :
     2295     define input  parameter p-doc-code              as character no-undo .
     2296     define input  parameter p-obj-type              as character no-undo .
     2297     define input  parameter p-obj-code              as integer   no-undo .
     2298     define input  parameter p-gds-code              as integer   no-undo .
     2299     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2300     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2301     do
     2302     on error undo, return error return-value
     2303     :
     2304       define buffer buf_trn-doc      for ub.trn-doc .
     2305       define buffer buf_doc-pl       for ub.doc-pl .
     2306       define buffer buf_temp-pl-gds for temp-pl-gds .
     2307       define variable v-sign as decimal   no-undo .
     2308       find first buf_trn-doc no-lock
     2309         where buf_trn-doc.doc-code = p-doc-code
     2310         no-error .
     2311       if not available buf_trn-doc then do:
     2312         message
     2313           vss-workfile vss-revision vss-description skip
     2314           vss-include-info10 skip
     2315           "Ошибка при поиске документа" skip
     2316           "Документ" p-doc-code skip
     2317           "Объект" p-obj-type p-obj-code skip
     2318           "Товар" p-gds-code skip
     2319           view-as alert-box error .
     2320         undo, return error .
     2321       end.
     2322       assign
     2323         p-total-pl-gds-qnty     = 0
     2324         p-total-pl-gds-cli-qnty = 0
     2325       .
     2326       for each buf_doc-pl no-lock
     2327         where buf_doc-pl.out-code  = p-doc-code
     2328           and buf_doc-pl.gds-code  = p-gds-code
     2329       on error undo, return error return-value
     2330       :
     2331         find first buf_temp-pl-gds
     2332           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2333             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2334             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2335           .
     2336         case buf_trn-doc.doc-type :
     2337           when 'при':U
     2338           or when 'возврат':U
     2339           or when 'инв':U
     2340           then do:
     2341             assign
     2342               v-sign = -1.0
     2343             .
     2344           end.
     2345           when 'рас':U or
     2346           when 'спи':U
     2347           then do:
     2348             assign
     2349               v-sign = 1.0
     2350             .
     2351           end.
     2352           otherwise do:
     2353             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2354           end.
     2355         end case.
     2356         assign
     2357           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2358           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2359           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2360           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2361         .
     2362       end.
     2363     end.
     2364   end procedure.
     2365   procedure prdoclib-init-prt-obj-by-date :
     2366     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2367     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2368     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2369     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2370     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2371     define input parameter p-fact-date  as date      no-undo .
     2372     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2373     do
     2374     on error undo, return error return-value
     2375     :
     2376       define variable v-fact-order                as decimal   no-undo .
     2377       define variable v-shift-end-fact-order      as decimal   no-undo .
     2378       define variable v-day-end-fact-order        as decimal   no-undo .
     2379       run factord in this-procedure
     2380         (input  p-fact-date
     2381         ,input  1
     2382         ,input  1
     2383         ,input  ?
     2384         ,input  0
     2385         ,input  false
     2386         ,output v-fact-order
     2387         ,output v-shift-end-fact-order
     2388         ,output v-day-end-fact-order
     2389         ) no-error .
     2390       if error-status :error
     2391       then do:
     2392         message
     2393           vss-workfile vss-revision vss-description skip
     2394           vss-include-info10 skip
     2395           "Ошибка при определении момента времени, на который требуется остаток" skip
     2396           "Объект" p-obj-type p-obj-code skip
     2397           "Артикул" p-artic p-prod-type p-prod-code skip
     2398           "Дата" p-fact-date skip
     2399           view-as alert-box error .
     2400         undo, return error .
     2401       end.
     2402       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2403         (input p-obj-type
     2404         ,input p-obj-code
     2405         ,input p-artic
     2406         ,input p-prod-type
     2407         ,input p-prod-code
     2408         ,input v-day-end-fact-order
     2409         ,input false
     2410         ) no-error .
     2411       if error-status :error
     2412       then do:
     2413         message
     2414           vss-workfile vss-revision vss-description skip
     2415           vss-include-info10 skip
     2416           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2417           "Объект" p-obj-type p-obj-code skip
     2418           "Артикул" p-artic p-prod-type p-prod-code skip
     2419           "Дата" p-fact-date skip
     2420           view-as alert-box error .
     2421         undo, return error .
     2422       end.
     2423     end.
     2424   end procedure.
     2425   procedure prdoclib-calc-temp-fact-sale :
     2426     define input  parameter p-obj-type           as character no-undo .
     2427     define input  parameter p-obj-code           as integer   no-undo .
     2428     define input  parameter p-gds-code           as integer   no-undo .
     2429     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2430     define input  parameter p-curr-r-b           as character no-undo .
     2431     define output parameter p-fact-qnty          as decimal   no-undo .
     2432     define output parameter p-cur-base           as decimal   no-undo .
     2433     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2434     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2435     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2436     define output parameter p-cur-excise-base    as decimal   no-undo .
     2437     define buffer buf_temp-prt-obj for temp-prt-obj .
     2438     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2439     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2440     define variable parrecid-prl        as recid     no-undo .
     2441     define variable v-fact-qnty         as decimal   no-undo .
     2442     define variable v-cur-base          as decimal   no-undo .
     2443     define variable v-cur-VAT-base      as decimal   no-undo .
     2444     define variable v-cur-SLT-base      as decimal   no-undo .
     2445     define variable v-cur-road-tax-base as decimal   no-undo .
     2446     define variable v-cur-excise-base   as decimal   no-undo .
     2447     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2448     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2449     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2450     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2451     define variable vat-base-sale-prl               as decimal   no-undo .
     2452     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2453     define variable vat-base-buyer-prl              as decimal   no-undo .
     2454     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2455     define variable slt-base-sale-prl               as decimal   no-undo .
     2456     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2457     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2458     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2459     define variable excise-base-sale-prl            as decimal   no-undo .
     2460     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2461     define variable discnt-base-sale-prl            as decimal   no-undo .
     2462     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2463     do
     2464     on error undo, return error return-value
     2465     :
     2466       for each buf_temp-prt-obj no-lock
     2467       on error undo, return error return-value
     2468       :
     2469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2470     (input  p-gds-code
     2471     ,input  buf_temp-prt-obj.prt-code
     2472     ,output v-prt-b-code
     2473     ) no-error .
     2474         if error-status :error
     2475         then do:
     2476           message
     2477             vss-workfile vss-revision vss-description skip
     2478             "Ошибка при определении бар-кода признака" skip
     2479             "Код товара"   p-gds-code skip
     2480             "Код признака" buf_temp-prt-obj.prt-code skip
     2481             error-status :get-message(1) skip
     2482             return-value skip
     2483             view-as alert-box error .
     2484           undo, return error .
     2485         end.
     2486   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2487   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2488     (input  p-obj-type
     2489     ,input  p-obj-code
     2490     ,input  v-prt-b-code
     2491     ,input  0
     2492     ,input  p-day-end-fact-order
     2493     ,output parrecid-prl
     2494     ,output v-cli-base-rate
     2495     ) no-error .
     2496         if error-status :error
     2497         then do:
     2498           message
     2499             vss-workfile vss-revision vss-description skip
     2500             "Ошибка при определении цены бар-кода" skip
     2501             "Объект" p-obj-type p-obj-code skip
     2502             "Бар-код" v-prt-b-code skip
     2503             "fact-order" p-day-end-fact-order skip
     2504             error-status :get-message(1) skip
     2505             return-value skip
     2506             view-as alert-box error .
     2507           undo, return error .
     2508         end.
     2509         if parrecid-prl <> ?
     2510         then do:
     2511           run prl-vat in this-procedure
     2512             (input  parrecid-prl
     2513             ,output price-rubl-with-tax-sale-prl
     2514             ,output price-base-with-tax-sale-prl
     2515             ,output price-rubl-without-tax-sale-prl
     2516             ,output price-base-without-tax-sale-prl
     2517             ,output vat-base-sale-prl
     2518             ,output vat-rubl-sale-prl
     2519             ,output vat-base-buyer-prl
     2520             ,output vat-rubl-buyer-prl
     2521             ,output slt-base-sale-prl
     2522             ,output slt-rubl-sale-prl
     2523             ,output road-tax-base-sale-prl
     2524             ,output road-tax-rubl-sale-prl
     2525             ,output excise-base-sale-prl
     2526             ,output excise-rubl-sale-prl
     2527             ,output discnt-base-sale-prl
     2528             ,output discnt-rubl-sale-prl
     2529             ) no-error .
     2530           if error-status :error
     2531           then do:
     2532             message
     2533               vss-workfile vss-revision vss-description skip
     2534               "Ошибка при вызове процеды prl-vat" skip
     2535               "Объект" p-obj-type p-obj-code skip
     2536               "Код товара" p-gds-code skip
     2537               "Указатель на запись переоценки" parrecid-prl skip
     2538               error-status :get-message(1) skip
     2539               return-value skip
     2540               view-as alert-box error .
     2541             undo, return error .
     2542           end.
     2543         end.
     2544         else do:
     2545           assign
     2546             price-rubl-with-tax-sale-prl    = 0
     2547             price-base-with-tax-sale-prl    = 0
     2548             price-rubl-without-tax-sale-prl = 0
     2549             price-base-without-tax-sale-prl = 0
     2550             vat-base-sale-prl               = 0
     2551             vat-rubl-sale-prl               = 0
     2552             slt-base-sale-prl               = 0
     2553             slt-rubl-sale-prl               = 0
     2554             road-tax-base-sale-prl          = 0
     2555             road-tax-rubl-sale-prl          = 0
     2556             excise-base-sale-prl            = 0
     2557             excise-rubl-sale-prl            = 0
     2558             discnt-base-sale-prl            = 0
     2559             discnt-rubl-sale-prl            = 0
     2560           .
     2561         end.
     2562         assign
     2563           v-fact-qnty         = v-fact-qnty
     2564                               + buf_temp-prt-obj.fact-qnty
     2565           v-cur-base          = v-cur-base
     2566                               + (if p-curr-r-b = 'base':U
     2567                                   then price-base-with-tax-sale-prl
     2568                                   else price-rubl-with-tax-sale-prl
     2569                                 )
     2570                               * buf_temp-prt-obj.fact-qnty
     2571           v-cur-VAT-base      = v-cur-VAT-base
     2572                               + (if p-curr-r-b = 'base':U
     2573                                   then vat-base-sale-prl
     2574                                   else vat-rubl-sale-prl
     2575                                 )
     2576                               * buf_temp-prt-obj.fact-qnty
     2577           v-cur-SLT-base      = v-cur-SLT-base
     2578                               + (if p-curr-r-b = 'base':U
     2579                                   then slt-base-sale-prl
     2580                                   else slt-rubl-sale-prl
     2581                                 )
     2582                               * buf_temp-prt-obj.fact-qnty
     2583           v-cur-road-tax-base = v-cur-road-tax-base
     2584                               + (if p-curr-r-b = 'base':U
     2585                                   then road-tax-base-sale-prl
     2586                                   else road-tax-rubl-sale-prl
     2587                                 )
     2588                               * buf_temp-prt-obj.fact-qnty
     2589           v-cur-excise-base   = v-cur-excise-base
     2590                               + (if p-curr-r-b = 'base':U
     2591                                   then excise-base-sale-prl
     2592                                   else excise-rubl-sale-prl
     2593                                 )
     2594                               * buf_temp-prt-obj.fact-qnty
     2595         .
     2596       end.
     2597       assign
     2598         p-fact-qnty         = v-fact-qnty
     2599         p-cur-base          = v-cur-base
     2600         p-cur-VAT-base      = v-cur-VAT-base
     2601         p-cur-SLT-base      = v-cur-SLT-base
     2602         p-cur-road-tax-base = v-cur-road-tax-base
     2603         p-cur-excise-base   = v-cur-excise-base
     2604       .
     2605     end.
     2606   end procedure.
     2607   procedure prdoclib-clear-temp-pl-gds :
     2608     define buffer buf_temp-pl-gds for temp-pl-gds .
     2609     do
     2610     on error undo, return error return-value
     2611     :
     2612       for each buf_temp-pl-gds
     2613       on error undo, return error return-value
     2614       :
     2615         delete buf_temp-pl-gds .
     2616       end.
     2617     end.
     2618   end procedure.
     2619   procedure prdoclib-init-temp-pl-gds :
     2620     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2621     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2622     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2623     define buffer buf_pl-gds      for ub.pl-gds .
     2624     define buffer buf_temp-pl-gds for temp-pl-gds .
     2625     do
     2626     on error undo, return error return-value
     2627     :
     2628       run prdoclib-clear-temp-pl-gds in this-procedure .
     2629       for each buf_pl-gds
     2630         where buf_pl-gds.obj-type = p-obj-type
     2631           and buf_pl-gds.obj-code = p-obj-code
     2632           and buf_pl-gds.gds-code = p-gds-code
     2633       on error undo, return error return-value
     2634       :
     2635         create buf_temp-pl-gds .
     2636         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2637       end.
     2638     end.
     2639   end procedure.
     2640   procedure prdoclib-init-pl-gds-by-factord :
     2641     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2642     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2643     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2644     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2645     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2646     define input parameter p-fact-order         as decimal   no-undo .
     2647     define input parameter p-include-fact-order as logical   no-undo .
     2648     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2649     define buffer buf_goods       for ub.goods .
     2650     define buffer buf_gds-obj     for ub.gds-obj .
     2651     define buffer buf_doc-line    for ub.doc-line .
     2652     define buffer buf_temp-pl-gds for temp-pl-gds .
     2653     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2654     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2655     do
     2656     on error undo, return error return-value
     2657     :
     2658       do transaction
     2659       on error undo, return error return-value
     2660       :
     2661   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2663     (input  p-obj-type
     2664     ,input  p-obj-code
     2665     ,input  p-artic
     2666     ,input  p-prod-type
     2667     ,input  p-prod-code
     2668     ,buffer buf_gds-obj
     2669     ) no-error .
     2670         if error-status :error
     2671         then do:
     2672           message
     2673             vss-workfile vss-revision vss-description skip
     2674             vss-include-info10 skip
     2675             "Невозможно найти gds-obj" skip
     2676             error-status :get-message(1) skip
     2677             return-value skip
     2678             view-as alert-box error .
     2679           undo, return error return-value .
     2680         end.
     2681         find current buf_gds-obj exclusive-lock .
     2682       end.
     2683       find first buf_goods no-lock
     2684         where buf_goods.artic     = p-artic
     2685           and buf_goods.prod-type = p-prod-type
     2686           and buf_goods.prod-code = p-prod-code
     2687         .
     2688       run prdoclib-init-temp-pl-gds in this-procedure
     2689         (input p-obj-type
     2690         ,input p-obj-code
     2691         ,input buf_goods.gds-code
     2692         ) .
     2693       if p-include-fact-order = true
     2694       then do:
     2695         assign
     2696          p-fact-order = p-fact-order - 0.0000000001
     2697         .
     2698       end.
     2699       for each buf_doc-line no-lock
     2700         where buf_doc-line.obj-type   = p-obj-type
     2701           and buf_doc-line.obj-code   = p-obj-code
     2702           and buf_doc-line.artic      = p-artic
     2703           and buf_doc-line.prod-type  = p-prod-type
     2704           and buf_doc-line.prod-code  = p-prod-code
     2705           and buf_doc-line.status_    = 'факт':U
     2706           and buf_doc-line.fact-order >= p-fact-order
     2707       on error undo, return error return-value
     2708       :
     2709         run prdoclib-prc-pl-document in this-procedure
     2710           ( input  buf_doc-line.doc-code
     2711            ,input  p-obj-type
     2712            ,input  p-obj-code
     2713            ,input  buf_goods.gds-code
     2714            ,output v-total-pl-gds-qnty
     2715            ,output v-total-pl-gds-cli-qnty
     2716           ) .
     2717       end.
     2718     end.
     2719   end procedure.
     2720   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2721   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     2722      IF parundefine-var = ? THEN RETURN 0.00.
     2723                             ELSE RETURN parundefine-var.
     2724   END FUNCTION.
     2725   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     2726      IF p-undef-char = ? THEN do:
     2727        RETURN "?".
     2728      end.
     2729      ELSE do:
     2730        RETURN p-undef-char .
     2731      end.
     2732   END FUNCTION.
     2733   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2734   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2735   procedure factord :
     2736     define input  parameter p-fact-date            as date    no-undo .
     2737     define input  parameter p-fact-time            as integer no-undo .
     2738     define input  parameter p-fact-num             as integer no-undo .
     2739     define input  parameter p-shift-date           as date    no-undo .
     2740     define input  parameter p-shift-num            as integer no-undo .
     2741     define input  parameter p-shift-on             as logical no-undo .
     2742     define output parameter p-fact-order           as decimal no-undo .
     2743     define output parameter p-shift-end-fact-order as decimal no-undo .
     2744     define output parameter p-day-end-fact-order   as decimal no-undo .
     2745     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2746     if p-fact-date = ?
     2747     then do:
     2748       return error "Не указана фактическая дата" .
     2749     end.
     2750     define variable v-fact-date-num as integer no-undo .
     2751     assign
     2752       v-fact-date-num = integer(p-fact-date)
     2753     .
     2754     if p-fact-num = ?
     2755     or p-fact-num = 0
     2756     then do:
     2757       return error "Не задан p-fact-num " + string(p-fact-num) .
     2758     end.
     2759     if p-fact-num < 0
     2760     then do:
     2761       return error "Отрицательный fact-num " + string(p-fact-num) .
     2762     end.
     2763     if p-fact-num >= 100000000
     2764     then do:
     2765       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2766     end.
     2767     if p-shift-on = true
     2768     then do:
     2769       if p-shift-date = ?
     2770       then do:
     2771         return error "Не задана дата смены" .
     2772       end.
     2773       if p-shift-num = ?
     2774       or p-shift-num = 0
     2775       then do:
     2776         return error "Не задан номер смены" .
     2777       end.
     2778     end.
     2779     else do:
     2780       assign
     2781         p-shift-date = p-fact-date
     2782         p-shift-num  = 24
     2783       .
     2784     end.
     2785     define variable v-shift-offset as integer no-undo .
     2786     if p-shift-date = p-fact-date
     2787     then do:
     2788       assign
     2789         v-shift-offset = 1
     2790       .
     2791     end.
     2792     if p-shift-date < p-fact-date
     2793     then do:
     2794       assign
     2795         v-shift-offset = 0
     2796       .
     2797     end.
     2798     if p-shift-date > p-fact-date
     2799     then do:
     2800       message
     2801         vss-workfile vss-revision vss-description skip
     2802         "Неправильная дата закрытия смены" skip
     2803         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2804         view-as alert-box error .
     2805       undo, return error
     2806         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2807           ,string(p-fact-date, '99/99/9999':U)
     2808           ,string(p-shift-date, '99/99/9999':U)
     2809           )
     2810       .
     2811     end.
     2812     if p-shift-num < 1
     2813     or p-shift-num > 24
     2814     then do:
     2815       message
     2816         vss-workfile vss-revision vss-description skip
     2817         "Неправильный номер смены" skip
     2818         "p-shift-num" p-shift-num skip
     2819         view-as alert-box error .
     2820       undo, return error return-value .
     2821     end.
     2822     assign
     2823       p-fact-order           = v-fact-date-num
     2824                              + v-shift-offset * 0.5
     2825                              + p-shift-num    * 0.02 - 0.01
     2826                              + p-fact-num     * 0.0000000001
     2827       p-shift-end-fact-order = v-fact-date-num
     2828                              + v-shift-offset * 0.5
     2829                              + p-shift-num    * 0.02
     2830       p-day-end-fact-order   = v-fact-date-num
     2831                              + 0.99
     2832     .
     2833     if p-fact-order           <= v-fact-date-num
     2834     or p-shift-end-fact-order <= v-fact-date-num
     2835     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2836     or p-shift-end-fact-order >= p-day-end-fact-order
     2837     then do:
     2838       message
     2839         vss-workfile vss-revision vss-description skip
     2840         "Внутренняя ошибка при генерации фактического номера" skip
     2841         "p-fact-date"            p-fact-date            skip
     2842         "p-fact-time"            p-fact-time            skip
     2843         "p-fact-num"             p-fact-num             skip
     2844         "p-shift-date"           p-shift-date           skip
     2845         "p-shift-num"            p-shift-num            skip
     2846         "p-shift-on"             p-shift-on             skip
     2847         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2848         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2849         "v-fact-date-num"        v-fact-date-num        skip
     2850         view-as alert-box error .
     2851       undo, return error return-value .
     2852     end.
     2853   end procedure.
     2854   procedure day-begin-fact-order :
     2855     define input  parameter p-fact-date            as date    no-undo .
     2856     define output parameter p-day-begin-fact-order as decimal no-undo .
     2857     do
     2858     on error undo, return error return-value
     2859     :
     2860       if p-fact-date = ?
     2861       then do:
     2862         assign
     2863           p-day-begin-fact-order = 0
     2864         .
     2865       end.
     2866       else do:
     2867         assign
     2868           p-day-begin-fact-order = integer(p-fact-date)
     2869         .
     2870       end.
     2871     end.
     2872   end procedure.
     2873   procedure factord-max-fact-order :
     2874     define output parameter p-max-fact-order as decimal   no-undo .
     2875     do
     2876     on error undo, return error return-value
     2877     :
     2878       run day-begin-fact-order in this-procedure
     2879         (input  date(1, 1, 5000)
     2880         ,output p-max-fact-order
     2881         ) .
     2882     end.
     2883   end procedure.
     2884   procedure factord-cut-archive :
     2885     define input  parameter p-obj-type             as character no-undo .
     2886     define input  parameter p-obj-code             as integer   no-undo .
     2887     define input  parameter p-fact-date            as date      no-undo .
     2888     define output parameter p-shift-on             as logical   no-undo .
     2889     define output parameter p-shift-date           as date      no-undo .
     2890     define output parameter p-shift-num            as integer   no-undo .
     2891     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2892     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2893     define variable v-fact-order as decimal   no-undo .
     2894     define buffer buf_shift-obj for ub.shift-obj .
     2895     do
     2896     on error undo, return error return-value
     2897     :
     2898   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2900     (input  p-obj-type
     2901     ,input  p-obj-code
     2902     ,input  'shift-on=request'
     2903     ,output p-shift-on
     2904     ) no-error .
     2905       if error-status :error
     2906       then do:
     2907         message
     2908           vss-workfile vss-revision vss-description skip
     2909           "Ошибка при определении атрибута объекта" skip
     2910           "Объект" p-obj-type p-obj-code skip
     2911           error-status :get-message(1) skip
     2912           return-value skip
     2913           view-as alert-box error .
     2914         undo, return error return-value .
     2915       end.
     2916       if p-shift-on = false
     2917       then do:
     2918         assign
     2919           p-shift-date               = ?
     2920           p-shift-num                = 0
     2921         .
     2922       end.
     2923       else do:
     2924         find first buf_shift-obj share-lock
     2925           where buf_shift-obj.obj-type   = p-obj-type
     2926             and buf_shift-obj.obj-code   = p-obj-code
     2927             and buf_shift-obj.shift-date > p-fact-date
     2928           use-index pi
     2929           no-error .
     2930         if not available buf_shift-obj
     2931         or buf_shift-obj.status_ <> 'зкр':U
     2932         then do:
     2933           message
     2934             vss-workfile vss-revision vss-description skip
     2935             "Невозможно вычислить последнюю смену" skip
     2936             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2937             "Объект" p-obj-type p-obj-code skip
     2938             "Дата" p-fact-date skip
     2939             view-as alert-box error .
     2940           undo, return error return-value .
     2941         end.
     2942         find last buf_shift-obj share-lock
     2943           where buf_shift-obj.obj-type = p-obj-type
     2944             and buf_shift-obj.obj-code = p-obj-code
     2945             and buf_shift-obj.shift-date <= p-fact-date
     2946           use-index pi
     2947           no-error .
     2948         if available buf_shift-obj
     2949         then do:
     2950           if  buf_shift-obj.status_ = 'зкр':U
     2951           then do:
     2952             assign
     2953               p-shift-date = buf_shift-obj.shift-date
     2954               p-shift-num  = buf_shift-obj.shift-num
     2955             .
     2956           end.
     2957           else do:
     2958             message
     2959               vss-workfile vss-revision vss-description skip
     2960               "Невозможно вычислить последнюю смену" skip
     2961               "Статус смены отличен от статуса" 'зкр':U skip
     2962               "Объект" p-obj-type p-obj-code skip
     2963               "Дата" p-fact-date skip
     2964               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2965               view-as alert-box error .
     2966             undo, return error return-value .
     2967           end.
     2968         end.
     2969         else do:
     2970           assign
     2971             p-shift-date = p-fact-date - 1
     2972             p-shift-num  = 1
     2973           .
     2974         end.
     2975       end.
     2976       run factord in this-procedure
     2977         (input  p-fact-date
     2978         ,input  1
     2979         ,input  1
     2980         ,input  p-shift-date
     2981         ,input  p-shift-num
     2982         ,input  p-shift-on
     2983         ,output v-fact-order
     2984         ,output p-shift-end-fact-order
     2985         ,output p-day-end-fact-order
     2986         ) no-error .
     2987       if error-status :error
     2988       then do:
     2989         message
     2990           vss-workfile vss-revision vss-description skip
     2991           "Ошибка при вызове процедуры factord"
     2992           error-status :get-message(1) skip
     2993           return-value skip
     2994           view-as alert-box error .
     2995         undo, return error return-value .
     2996       end.
     2997     end.
     2998   end procedure.
     2999   procedure factord-lock-shift :
     3000     define input  parameter p-obj-type  as character no-undo .
     3001     define input  parameter p-obj-code  as integer   no-undo .
     3002     define input  parameter p-fact-date as date      no-undo .
     3003     define parameter buffer buf_shift-obj for ub.shift-obj .
     3004     define variable v-shift-on      as logical   no-undo .
     3005     define variable v-extra-message as character no-undo .
     3006     define variable v-error as character no-undo .
     3007     do
     3008     on error undo, return error return-value
     3009     :
     3010   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3011   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3012     (input  p-obj-type
     3013     ,input  p-obj-code
     3014     ,input  'shift-on=request'
     3015     ,output v-shift-on
     3016     ) no-error .
     3017       if error-status :error
     3018       then do:
     3019         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3020         undo, return error v-error .
     3021       end.
     3022       if v-shift-on = true
     3023       then do:
     3024         find first buf_shift-obj share-lock
     3025           where buf_shift-obj.obj-type   = p-obj-type
     3026             and buf_shift-obj.obj-code   = p-obj-code
     3027             and buf_shift-obj.shift-date > p-fact-date
     3028           use-index pi
     3029           no-error .
     3030         if not available buf_shift-obj
     3031         or buf_shift-obj.status_ <> 'зкр':U
     3032         then do:
     3033           find last buf_shift-obj
     3034             where buf_shift-obj.obj-type = p-obj-type
     3035               and buf_shift-obj.obj-code = p-obj-code
     3036               and buf_shift-obj.status_  = 'зкр':U
     3037             use-index stts
     3038             no-error .
     3039           if available buf_shift-obj
     3040           then do:
     3041             assign
     3042               v-extra-message =
     3043                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3044                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3045                               )
     3046             .
     3047           end.
     3048           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3049           undo, return error v-error .
     3050         end.
     3051       end.
     3052     end.
     3053   end procedure.
     3054   procedure factord-end-day :
     3055     define input  parameter p-fact-date            as date    no-undo .
     3056     define output parameter p-day-end-fact-order   as decimal no-undo .
     3057     do
     3058     on error undo, return error return-value
     3059     :
     3060       if p-fact-date = ?
     3061       then do:
     3062         return error "Не указана фактическая дата" .
     3063       end.
     3064       assign
     3065         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3066       .
     3067     end.
     3068   end procedure.
     3069   procedure factord-to-date :
     3070     define input  parameter p-fact-order as decimal no-undo .
     3071     define output parameter p-fact-date  as date    no-undo .
     3072     define variable v-ref-date  as date      no-undo .
     3073     define variable v-ref-delta as integer   no-undo .
     3074     do
     3075     on error undo, return error return-value
     3076     :
     3077       if p-fact-order = ?
     3078       or p-fact-order = 0
     3079       then do:
     3080         return error "Не указан fact-order" .
     3081       end.
     3082       assign
     3083         v-ref-date  = date(1, 1, 2000)
     3084       .
     3085       assign
     3086         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3087       .
     3088       assign
     3089         p-fact-date = v-ref-date + v-ref-delta
     3090       .
     3091     end.
     3092   end procedure.
     3093   procedure factord-to-fact-num :
     3094     define input  parameter p-fact-order as decimal no-undo .
     3095     define output parameter p-fact-num   as integer no-undo .
     3096     define variable v-fact-order-trunc as decimal no-undo .
     3097     do
     3098     on error undo, return error return-value
     3099     :
     3100       if p-fact-order = ?
     3101       or p-fact-order = 0
     3102       then do:
     3103         return error "Не указан fact-order" .
     3104       end.
     3105       assign
     3106        v-fact-order-trunc = truncate(p-fact-order, 2)
     3107       .
     3108       assign
     3109         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3110       .
     3111     end.
     3112   end procedure.
     3113   procedure factord-to-shift-num :
     3114     define input  parameter p-fact-order as decimal no-undo .
     3115     define output parameter p-shift-num   as integer no-undo .
     3116     define variable  p-shift-numd  as decimal   no-undo .
     3117     define variable v-fact-order-trunc as decimal no-undo .
     3118     do
     3119     on error undo, return error return-value
     3120     :
     3121       if p-fact-order = ?
     3122       or p-fact-order = 0
     3123       then do:
     3124         return error "Не указан fact-order" .
     3125       end.
     3126       assign
     3127        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3128       .
     3129       if v-fact-order-trunc < 0.5 then do:
     3130         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3131       end.
     3132       assign
     3133         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3134         .
     3135        assign
     3136         p-shift-num = truncate (p-shift-numd , 0)
     3137       .
     3138     end.
     3139   end procedure.
     3140   define temp-table temp-gds-qnty no-undo
     3141   field day as date
     3142   field prih as decimal
     3143   field rash as decimal
     3144   field ost  as decimal
     3145   field qnty-day as integer
     3146   index pi is unique primary day
     3147   index by-ost ost .
     3148   define variable qnty-lib-v-fact-order-2 as decimal no-undo .
     3149   procedure qnty-lib-clear-tt :
     3150    do
     3151    on error undo, return error return-value
     3152    :
     3153    for each temp-gds-qnty :
     3154        delete temp-gds-qnty .
     3155    end.
     3156    end.
     3157   end procedure.
     3158   procedure qnty-lib-create-tt :
     3159    do
     3160    on error undo, return error return-value
     3161    :
     3162   define input parameter p-fact-order-1 as decimal no-undo .
     3163   define input parameter p-fact-order-2 as decimal no-undo .
     3164   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3165   define input parameter p-obj-type as character no-undo .
     3166   define input parameter p-obj-code as integer no-undo .
     3167   define variable p-include-fact-order as logical no-undo .
     3168   define buffer buf_goods for ub.goods .
     3169   define variable quantity      as decimal no-undo .
     3170   define variable p-fact-date   as date no-undo .
     3171   define variable p-fact-date-0 as date no-undo .
     3172   define variable p-fact-date-2 as date no-undo .
     3173   define buffer p-doc-line for ub.doc-line .
     3174   define variable p-prih as decimal no-undo .
     3175   define variable p-rash as decimal no-undo .
     3176   qnty-lib-v-fact-order-2 = p-fact-order-2.
     3177   p-include-fact-order = true .
     3178   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     3179        if error-status :error then return error .
     3180          run prdoclib-init-prt-obj-by-factord in this-procedure
     3181               (input  p-obj-type
     3182               ,input  p-obj-code
     3183               ,input  buf_goods.artic
     3184               ,input  buf_goods.prod-type
     3185               ,input  buf_goods.prod-code
     3186               ,input  p-fact-order-1  + 0.99
     3187               ,input  p-include-fact-order
     3188               ) .
     3189         for each temp-prt-obj :
     3190             quantity   = quantity + temp-prt-obj.fact-qnty.
     3191         end.
     3192         run prdoclib-clear-temp-prt-obj in this-procedure .
     3193       run factord-to-date in this-procedure
     3194                           (  input  p-fact-order-1  ,
     3195                              output p-fact-date-0     ).
     3196       find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date-0 no-error .
     3197        if not available temp-gds-qnty then do:
     3198             create temp-gds-qnty.
     3199             assign
     3200               temp-gds-qnty.day      = p-fact-date-0
     3201               temp-gds-qnty.prih     = 0
     3202               temp-gds-qnty.rash     = 0
     3203               temp-gds-qnty.ost      = quantity
     3204               temp-gds-qnty.qnty-day = 0
     3205             .
     3206        end.
     3207        else do:
     3208             assign
     3209               temp-gds-qnty.day      = p-fact-date-0
     3210               temp-gds-qnty.prih     = 0
     3211               temp-gds-qnty.rash     = 0
     3212               temp-gds-qnty.ost      =  temp-gds-qnty.ost + quantity
     3213               temp-gds-qnty.qnty-day = 0
     3214             .
     3215       end.
     3216     run factord-to-date in this-procedure
     3217                         (  input  p-fact-order-2  ,
     3218                            output p-fact-date     ).
     3219      find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date no-error .
     3220        if not available temp-gds-qnty then do:
     3221             create temp-gds-qnty.
     3222             assign
     3223               temp-gds-qnty.day      = p-fact-date
     3224               temp-gds-qnty.prih     = 0
     3225               temp-gds-qnty.rash     = 0
     3226               temp-gds-qnty.ost      = 0
     3227               temp-gds-qnty.qnty-day = 0
     3228             .
     3229        end.
     3230   assign
     3231     p-prih  = 0
     3232     p-rash  = 0
     3233   .
     3234   define variable i as integer no-undo .
     3235          for each p-doc-line no-lock where
     3236                   p-doc-line.obj-type    = p-obj-type
     3237               and p-doc-line.obj-code    = p-obj-code
     3238               and p-doc-line.artic       = buf_goods.artic
     3239               and p-doc-line.prod-type   = buf_goods.prod-type
     3240               and p-doc-line.prod-code   = buf_goods.prod-code
     3241               and p-doc-line.status_     = 'факт':U
     3242               and p-doc-line.fact-order >= p-fact-order-1
     3243               and p-doc-line.fact-order <= p-fact-order-2 break by integer(p-doc-line.fact-order) :
     3244           case p-doc-line.ext-doc-type:
     3245                when   'ie':U  or
     3246                when   'im':U     then
     3247                  do:
     3248                     assign p-prih   = p-prih  +  p-doc-line.fact-qnty.
     3249                  end.
     3250                 when  'we':U      then if  p-t-sp      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3251                 when  'wm':U       then if  p-t-sppv    then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3252                 when  'em':U       then if  p-t-sppv-2  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3253                 when  'ev':U      then if  p-t-sppv-3  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3254                 when  'rv':U  then if  p-t-sppv-4  then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     3255                 when  'ee':U      then if  p-t-rv      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3256                 when  're':U  then if  p-t-rvz     then assign p-rash   = p-rash  -  p-doc-line.fact-qnty.
     3257                 when  'es':U     then if p-t-rvc  then assign p-rash  = p-rash  +  p-doc-line.fact-qnty.
     3258                 when  'rs':U then if p-t-rvzc then assign p-rash  = p-rash  -  p-doc-line.fact-qnty.
     3259             end case.
     3260             assign
     3261               p-rash  = p-rash
     3262             .
     3263             if last-of(integer(p-doc-line.fact-order)) then do:
     3264               run factord-to-date in this-procedure (  input  p-doc-line.fact-order  ,
     3265                                      output p-fact-date-2   ).
     3266                   find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date-2 no-error .
     3267                   if not available temp-gds-qnty then do:
     3268                       create temp-gds-qnty.
     3269                       assign
     3270                         temp-gds-qnty.day      = p-fact-date-2
     3271                         temp-gds-qnty.prih     = p-prih
     3272                         temp-gds-qnty.rash     = p-rash
     3273                         temp-gds-qnty.ost      = 0
     3274                         temp-gds-qnty.qnty-day = 0
     3275                       .
     3276                   end.
     3277                   else do:
     3278                       assign
     3279                         temp-gds-qnty.prih     = temp-gds-qnty.prih + p-prih
     3280                         temp-gds-qnty.rash     = temp-gds-qnty.rash + p-rash
     3281                         temp-gds-qnty.ost      = temp-gds-qnty.ost
     3282                         temp-gds-qnty.qnty-day = 0
     3283                       .
     3284                   end.
     3285                   if temp-gds-qnty.rash <> 0  and
     3286                      p-fact-date-2 + 1  <  p-fact-date then  do:
     3287                      find first temp-gds-qnty where
     3288                                 temp-gds-qnty.day      = p-fact-date-2 + 1 no-error .
     3289                       if not available temp-gds-qnty then do:
     3290                           create temp-gds-qnty.
     3291                           assign
     3292                             temp-gds-qnty.day      = p-fact-date-2 + 1
     3293                             temp-gds-qnty.prih     = 0
     3294                             temp-gds-qnty.rash     = 0
     3295                             temp-gds-qnty.ost      = 0
     3296                             temp-gds-qnty.qnty-day = 0
     3297                           .
     3298                       end.
     3299                    end.
     3300                   assign
     3301                     p-prih  = 0
     3302                     p-rash  = 0
     3303                   .
     3304             end.
     3305       end.
     3306    define variable old-ost as decimal no-undo .
     3307    old-ost = 0 .
     3308    for each temp-gds-qnty break by temp-gds-qnty.day :
     3309       if  temp-gds-qnty.day      <> p-fact-date-0 then do:
     3310                 assign
     3311                    temp-gds-qnty.ost    = old-ost +    temp-gds-qnty.prih  - temp-gds-qnty.rash
     3312                 .
     3313                 end.
     3314       assign
     3315         old-ost = temp-gds-qnty.ost
     3316       .
     3317    end.
     3318    end.
     3319   end procedure.
     3320   procedure qnty-lib-2 :
     3321    do
     3322    on error undo, return error return-value
     3323    :
     3324   define variable p-fact-date-3 as date no-undo .
     3325   define variable old-day as date no-undo .
     3326   run factord-to-date in this-procedure (  input  qnty-lib-v-fact-order-2  ,
     3327                          output p-fact-date-3   ).
     3328    old-day = p-fact-date-3 + 1.
     3329    for each temp-gds-qnty break by temp-gds-qnty.day DESCENDING :
     3330       assign
     3331         temp-gds-qnty.qnty-day  =  old-day - temp-gds-qnty.day
     3332         old-day = temp-gds-qnty.day
     3333       .
     3334    end .
     3335    end.
     3336   end procedure.
     3337   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3338     run mainmenu_getcntxt in parparentproc
     3339       (output v-cntxt-db-num
     3340       ,output v-cntxt-userid
     3341       ,output v-cntxt-level
     3342       ,output v-cntxt-host-code-obj
     3343       ,output v-cntxt-obj-type
     3344       ,output v-cntxt-obj-code
     3345       ,output v-cntxt-db-num-obj
     3346       ,output v-cntxt-is-admin
     3347       ) .
     3348   define var  fact-order-1       like UB.stk-tot.fact-order no-undo.
     3349   define var  fact-order-2       like UB.stk-tot.fact-order no-undo.
     3350   define var  fact-order-today   like UB.stk-tot.fact-order no-undo.
     3351   define buffer buf-fp_ord-doc  for UB.ord-doc .
     3352   define buffer buf-fp_ord-line for UB.ord-line .
     3353   define buffer buf-fp_ord-dtl  for UB.ord-dtl .
     3354   define variable t-temp as decimal no-undo .
     3355   define variable doc-rcv-recid as recid no-undo .
     3356   define var all-day     as int init 0 no-undo.
     3357   define temp-table temp-abc-day no-undo
     3358   field abc-type as character
     3359   field gar-day  as decimal
     3360   index pi abc-type
     3361   .
     3362   define new global shared temp-table tt-obj-gds no-undo
     3363   field obj-type  like ub.clients.obj-type
     3364   field obj-code  like ub.clients.obj-code
     3365   field artic     like ub.ord-line.artic
     3366   field prod-type like ub.ord-line.prod-type
     3367   field prod-code like ub.ord-line.prod-code
     3368   field t-temp    as decimal
     3369   index pi obj-type
     3370            obj-code
     3371            artic
     3372            prod-type
     3373            prod-code
     3374            .
     3375   define temp-table tt-gds no-undo
     3376   field artic     like ub.ord-line.artic
     3377   field prod-type like ub.ord-line.prod-type
     3378   field prod-code like ub.ord-line.prod-code
     3379   field t-temp    as decimal
     3380   index pi prod-type
     3381            prod-code
     3382            .
     3383   find first  buf-fp_ord-doc where recid(buf-fp_ord-doc ) = fp-recid no-lock no-error .
     3384   if not available buf-fp_ord-doc then return error.
     3385     IF p-r-algoritm = 1 Then do:
     3386       all-day = xdate-2 - xdate-1  + 1.
     3387     end.
     3388     IF p-r-algoritm = 3 Then do:
     3389       all-day = 0 .
     3390       for each temp-dates :
     3391           all-day = all-day  + 1.
     3392       end.
     3393     end.
     3394      assign
     3395        fact-order-1 = integer( xdate-1 - 1 ) + 0.99
     3396        fact-order-2 = integer( xdate-2 ) + 0.99
     3397      .
     3398   if not can-find ( first obj-list ) then do:
     3399       message "Ни задан ни один объект для расчета" view-as alert-box error .
     3400       return.
     3401   end.
     3402   define variable p-R-algoritm2 as integer   no-undo .
     3403   case p-r-algoritm :
     3404     when 1 then do:
     3405         p-R-algoritm = 1 .
     3406         p-R-algoritm2 = 1 .
     3407     end.
     3408     when 4 then do:
     3409       p-R-algoritm = 1 .
     3410       p-R-algoritm2 = 2 .
     3411     end.
     3412     when 2 then do:
     3413         p-R-algoritm = 2 .
     3414         p-R-algoritm2 = 1 .
     3415     end.
     3416     when 3 then do:
     3417         p-R-algoritm = 1 .
     3418         p-R-algoritm2 = 3 .
     3419     end.
     3420   end.
     3421   empty temp-table tmp#zakaz .
     3422   for each buf-fp_ord-line where buf-fp_ord-line.doc-code = buf-fp_ord-doc.doc-code no-lock :
     3423       create tmp#zakaz.
     3424       buffer-copy buf-fp_ord-line to tmp#zakaz .
     3425   end.
     3426   run cus/qnty-obj.p (
     3427       input parparentproc ,
     3428       input ?    ,
     3429       input ?    ,
     3430       input buf-fp_ord-doc.e-method   ,
     3431       input "rcv-ord"    ,
     3432       input buf-fp_ord-doc.doc-code  ,
     3433       input xdate-1    ,
     3434       input xdate-2    ,
     3435       input "calc":U      ,
     3436       input yes           ,
     3437       input p-R-algoritm  ,
     3438       input p-R-algoritm2  ,
     3439       input 1  ,
     3440       input no ,
     3441       input p-code     ,
     3442       input p-t-rv     ,
     3443       input p-t-rvz    ,
     3444       input p-t-rvc    ,
     3445       input p-t-rvzc   ,
     3446       input p-t-sp     ,
     3447       input p-t-sppv-2 ,
     3448       input p-t-sppv-2 ,
     3449       input p-t-sppv-3 ,
     3450       input p-t-sppv-4 ,
     3451       input p-t-way      ,
     3452       input p-t-rcv      ,
     3453       input p-t-clos     ,
     3454       input table temp-dates ,
     3455       input table temp-abc-day ,
     3456       input no    ,
     3457       input no    ,
     3458       input no    ,
     3459       input no    ,
     3460       input no    ,
     3461       v-cntxt-obj-type,
     3462       v-cntxt-obj-code,
     3463       'ФП':U          ,
     3464       input no
     3465           ) no-error .
     3466   if error-status :error then
     3467   message
     3468     vss-workfile vss-revision vss-description skip
     3469     error-status :get-message(1) skip
     3470     return-value skip
     3471     ""
     3472     view-as alert-box error
     3473   .
     3474   for each buf-fp_ord-line where buf-fp_ord-line.doc-code = buf-fp_ord-doc.doc-code no-lock :
     3475        run make-gds in this-procedure
     3476                     ( input buf-fp_ord-line.artic ,
     3477                       input buf-fp_ord-line.prod-type ,
     3478                       input buf-fp_ord-line.prod-code   )
     3479                       no-error  .
     3480   end.
     3481   for each buf-fp_ord-line where buf-fp_ord-line.doc-code = buf-fp_ord-doc.doc-code no-lock :
     3482        for each obj-list  no-lock :
     3483               for each tt-obj-gds where
     3484                 tt-obj-gds.obj-type  = obj-list.obj-type and
     3485                 tt-obj-gds.obj-code  = obj-list.obj-code and
     3486                 tt-obj-gds.artic     = buf-fp_ord-line.artic and
     3487                 tt-obj-gds.prod-type = buf-fp_ord-line.prod-type and
     3488                 tt-obj-gds.prod-code = buf-fp_ord-line.prod-code  and
     3489                 tt-obj-gds.t-temp    > 0  no-lock :
     3490                     run create-ord-doc-rcv in this-procedure
     3491                                            (input tt-obj-gds.obj-type ,
     3492                                             input tt-obj-gds.obj-code ,
     3493                                             output loc-ord-num ) .
     3494                     find first tt-gds where
     3495                         tt-gds.artic     = buf-fp_ord-line.artic and
     3496                         tt-gds.prod-type = buf-fp_ord-line.prod-type and
     3497                         tt-gds.prod-code = buf-fp_ord-line.prod-code no-lock no-error .
     3498                     IF not AVAILABLE TT-GDS then next.
     3499                     run create-ord-line-rcv in this-procedure
     3500                     (   input tt-obj-gds.t-temp ,
     3501                         input tt-gds.t-temp ,
     3502                         input loc-ord-num  ).
     3503                     run create-ord-dtl-rcv in this-procedure .
     3504               end.
     3505        end.
     3506   end.
     3507   procedure make-gds :
     3508    do
     3509    on error undo, return error return-value
     3510    :
     3511   define input  parameter p-artic     like ub.ord-line.artic     no-undo .
     3512   define input  parameter p-prod-type like ub.ord-line.prod-type no-undo .
     3513   define input  parameter p-prod-code like ub.ord-line.prod-code no-undo .
     3514   define variable l-ppp as decimal no-undo .
     3515   l-ppp = 0.
     3516    for each tt-obj-gds where
     3517       tt-obj-gds.artic      = p-artic      and
     3518       tt-obj-gds.prod-type  = p-prod-type  and
     3519       tt-obj-gds.prod-code  = p-prod-code  :
     3520        l-ppp = l-ppp + tt-obj-gds.t-temp .
     3521     end.
     3522     if l-ppp <=0 or l-ppp = ? then return.
     3523     create tt-gds.
     3524     assign
     3525       tt-gds.artic      = p-artic
     3526       tt-gds.prod-type  = p-prod-type
     3527       tt-gds.prod-code  = p-prod-code
     3528       tt-gds.t-temp     = l-ppp
     3529     .
     3530    end.
     3531   end procedure.
     3532   procedure create-ord-doc-rcv :
     3533    do
     3534    on error undo, return error return-value
     3535    :
     3536   define input parameter  p-obj-type like ub.clients.obj-type no-undo .
     3537   define input parameter  p-obj-code like ub.clients.obj-code no-undo .
     3538   define output parameter loc-ord-num as character no-undo .
     3539   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3541     (input  p-obj-type
     3542     ,input  p-obj-code
     3543     ,output to-day
     3544     )  .
     3545   loc-ord-num = "" .
     3546   find first  ub.ord-doc-rcv where
     3547         ub.ord-doc-rcv.doc-code  = buf-fp_ord-doc.doc-code and
     3548         ub.ord-doc-rcv.obj-code  = p-obj-code and
     3549         ub.ord-doc-rcv.obj-type  = p-obj-type no-lock no-error  .
     3550   if available ub.ord-doc-rcv  then do:
     3551     loc-ord-num = ub.ord-doc-rcv.rcv-code .
     3552     return.
     3553   end.
     3554   define variable i-doc-code as character no-undo .
     3555   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3556   run proc-ord-code in this-procedure
     3557    (input   'main' ,
     3558     input   v-cntxt-db-num ,
     3559     input   p-obj-type ,
     3560     input   p-obj-code ,
     3561     input   i-doc-code ,
     3562     output  loc-ord-num
     3563    ) .
     3564      create ub.ord-doc-rcv.
     3565      buffer-copy buf-fp_ord-doc to ub.ord-doc-rcv.
     3566      assign
     3567         ub.ord-doc-rcv.rcv-code  = loc-ord-num
     3568         ub.ord-doc-rcv.doc-type  = 'out':U
     3569         ub.ord-doc-rcv.doc-date  = to-day
     3570         ub.ord-doc-rcv.creid     = v-cntxt-userid
     3571         ub.ord-doc-rcv.status_   = 'новый':U
     3572         ub.ord-doc-rcv.obj-code  = p-obj-code
     3573         ub.ord-doc-rcv.obj-type  = p-obj-type
     3574      .
     3575    end.
     3576   end procedure.
     3577   procedure create-ord-line-rcv :
     3578    do
     3579    on error undo, return error return-value
     3580    :
     3581    define input parameter tt-gds as decimal no-undo .
     3582    define input parameter tt-all-gds as decimal no-undo .
     3583    define input parameter p-rcv-code as character no-undo .
     3584    define buffer b-ord-doc-rcv for ub.ord-doc-rcv.
     3585    define buffer b-ord-line-rcv for ub.ord-line-rcv.
     3586    define buffer buf_goods for ub.goods.
     3587   find first buf_goods where
     3588       buf_goods.artic      = buf-fp_ord-line.artic      and
     3589       buf_goods.prod-type  = buf-fp_ord-line.prod-type  and
     3590       buf_goods.prod-code  = buf-fp_ord-line.prod-code
     3591       no-lock no-error .
     3592    create b-ord-line-rcv .
     3593    BUFFER-COPY buf-fp_ord-line to b-ord-line-rcv
     3594    assign
     3595      b-ord-line-rcv.gds-code  = buf_goods.gds-code
     3596      b-ord-line-rcv.rcv-code  = p-rcv-code
     3597      b-ord-line-rcv.qnty      = ( buf-fp_ord-line.qnty * tt-gds ) / tt-all-gds
     3598      .
     3599    if can-find(first ub.units where ub.units.unit-name = buf_goods.unit-base
     3600       and lookup('шту':U, ub.units.type) > 0)
     3601       and trunc( b-ord-line-rcv.qnty, 0 ) <> b-ord-line-rcv.qnty then do:
     3602           b-ord-line-rcv.qnty = trunc( b-ord-line-rcv.qnty, 0 ) + 1 .
     3603       end.
     3604      b-ord-line-rcv.cli-qnty  = b-ord-line-rcv.qnty / b-ord-line-rcv.cli-base-rate .
     3605    end.
     3606   end procedure.
     3607   procedure create-ord-dtl-rcv :
     3608    do
     3609    on error undo, return error return-value
     3610    :
     3611    end.
     3612   end procedure.
