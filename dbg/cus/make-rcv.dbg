      174   procedure create_obj-list :
      175      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      176      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      177      do
      178      on error undo, return error return-value
      179      :
      180         define buffer cli-obj for ub.clients .
      181         define variable p-var as integer no-undo .
      182         define buffer buf_obj-list for obj-list .
      183         find last buf_obj-list  use-index pi no-error .
      184         if available buf_obj-list
      185         then
      186            p-var = buf_obj-list.obj-id + 1.
      187         else
      188            p-var = 1.
      189         find first cli-obj where
      190                   cli-obj.obj-type = p-obj-type
      191               and cli-obj.obj-code = p-obj-code
      192         no-lock no-error.
      193         if available cli-obj
      194         then do:
      195            create buf_obj-list.
      196            assign
      197               buf_obj-list.obj-id   = p-var
      198               buf_obj-list.obj-code = cli-obj.obj-code
      199               buf_obj-list.obj-type = cli-obj.obj-type
      200               buf_obj-list.obj-name = cli-obj.obj-name
      201               buf_obj-list.db-num   = cli-obj.db-num
      202            .
      203         end.
      204      end.
      205   end.
