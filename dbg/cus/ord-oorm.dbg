     1215       assign
     1216         v-inform-launched = true
     1217       .
     1218       run gbl/d-inform.w
     1219         (  input self
     1220         ,  input this-procedure
     1221         , output v-action
     1222         ) no-error .
     1223       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1224       assign
     1225         v-inform-launched = false
     1226       .
     1227     end.
     1228   end.
     1229   procedure proc-alt-f1:
