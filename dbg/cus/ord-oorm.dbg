     1323      run thbjattr_code_reg in this-procedure (
     1324                                               p-upper-code,
     1325                                               p-code,
     1326                                               output p-label,
     1327                                               output p-user-can-edit,
     1328                                               output p-output-display,
     1329                                               output p-other,
     1330                                               output p-prop-list,
     1331                                               output p-prop-type-list,
     1332                                               output p-prop-label-list,
     1333                                               output p-global,
     1334                                               output p-host,
     1335                                               output p-shop,
     1336                                               output p-store,
     1337                                               output p-db,
     1338                                               output p-region
     1339                                               ).
     1340   end procedure.
     1341   procedure thbjattr_code_reg :
     1342   define input  parameter p-upper-code     as character no-undo .
     1343   define input  parameter p-code           as character no-undo .
     1344   define output parameter p-label          as character no-undo .
     1345   define output parameter p-user-can-edit  as logical   no-undo .
     1346   define output parameter p-output-display as logical   no-undo .
     1347   define output parameter p-other          as character no-undo .
     1348   define output parameter p-prop-list      as character no-undo .
     1349   define output parameter p-prop-type-list as character no-undo .
     1350   define output parameter p-prop-label-list as character no-undo .
     1351   define output parameter p-global          as logical no-undo .
     1352   define output parameter p-host           as logical no-undo .
     1353   define output parameter p-shop           as logical no-undo .
     1354   define output parameter p-store          as logical no-undo .
     1355   define output parameter p-db             as logical no-undo .
     1356   define output parameter p-region         as logical no-undo .
     1357   do
     1358   on error undo, return error return-value
     1359   :
     1360       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1361       (input  p-upper-code
     1362       ,input  p-code
     1363       ,output p-label
     1364       ,output p-user-can-edit
     1365       ,output p-output-display
     1366       ,output p-other
     1367       ,output p-prop-list
     1368       ,output p-prop-type-list
     1369       ,output p-prop-label-list
     1370       ,output p-global
     1371       ,output p-host
     1372       ,output p-shop
     1373       ,output p-store
     1374       ,output p-db
     1375       ,output p-region
     1376       ) no-error .
     1377     if error-status :error
     1378     then do:
     1379       undo, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1)).
     1380     end.
     1381   end.
     1382   end procedure.
     1383   procedure thbjattr_tooltip :
     1384   define input  parameter p-upper-code  as character no-undo .
