     1405   procedure thbjattr_legacy :
     1406   define input  parameter p-upper-code     as character no-undo .
     1407   define output parameter p-level-way      as character no-undo .
     1408   define output parameter p-up-way         as character no-undo .
     1409   do
     1410   on error undo, return error return-value
     1411   :
     1412       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_legacy in g#attr-lib
     1413       (input  p-upper-code
     1414       ,output p-level-way
     1415       ,output p-up-way
     1416       ) no-error .
     1417     if error-status :error
     1418     then do:
     1419       undo, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1)).
     1420     end.
     1421   end.
     1422   end procedure.
