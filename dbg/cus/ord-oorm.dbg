      371   def
      372   new shared
      373   temp-table  obj-list no-undo
      374     field obj-type like ub.clients.obj-type
      375     field obj-code like ub.clients.obj-code
      376     field obj-name like ub.clients.obj-name
      377     field obj-id   as integer
      378     field db-num   as integer
      379     index pi is primary unique obj-id
      380     index ie1 obj-type obj-code
      381     index ie2 obj-name
      382   .
      383   procedure create_obj-list :
      384      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      385      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      386      do
      387      on error undo, return error return-value
      388      :
      389         define buffer cli-obj for ub.clients .
      390         define variable p-var as integer no-undo .
      391         define buffer buf_obj-list for obj-list .
      392         find last buf_obj-list  use-index pi no-error .
      393         if available buf_obj-list
      394         then
      395            p-var = buf_obj-list.obj-id + 1.
      396         else
      397            p-var = 1.
      398         find first cli-obj where
      399                   cli-obj.obj-type = p-obj-type
      400               and cli-obj.obj-code = p-obj-code
      401         no-lock no-error.
      402         if available cli-obj
      403         then do:
      404            create buf_obj-list.
      405            assign
      406               buf_obj-list.obj-id   = p-var
      407               buf_obj-list.obj-code = cli-obj.obj-code
      408               buf_obj-list.obj-type = cli-obj.obj-type
      409               buf_obj-list.obj-name = cli-obj.obj-name
      410               buf_obj-list.db-num   = cli-obj.db-num
      411            .
      412         end.
      413      end.
      414   end.
      415   define new shared temp-table X-init_obj-list no-undo
