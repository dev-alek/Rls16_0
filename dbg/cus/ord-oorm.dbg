     1246   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247     define variable v-cntxt-db-num        as integer   no-undo .
     1248     define variable v-cntxt-userid        as character no-undo .
     1249     define variable v-cntxt-level         as character no-undo .
     1250     define variable v-cntxt-host-code-obj as integer   no-undo .
     1251     define variable v-cntxt-obj-type      as character no-undo .
     1252     define variable v-cntxt-obj-code      as integer   no-undo .
     1253     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1254     define variable v-cntxt-is-admin      as logical   no-undo .
     1255   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1256   procedure proc-ord-code :
     1257   define input  parameter  p-type as character no-undo .
     1258   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1259   define input  parameter  v-cntxt-obj-type as character no-undo .
     1260   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1261   define input  parameter  p-i-doc    as character no-undo .
     1262   define output parameter  p-ord-doc  as character no-undo .
     1263   define variable          v-idop     as character no-undo .
     1264     do
     1265     on error undo, return error return-value
     1266     :
     1267   case p-type :
     1268       when "main-no-ver" then do:
     1269         if  (v-cntxt-db-num <> 0) then
     1270           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1271         else
     1272           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1273       end.
     1274       when "main" then do:
     1275             do while true:
     1276             if  (v-cntxt-db-num <> 0) then
     1277               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1278             else
     1279               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1280             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1281             End.
     1282       end.
     1283       when "chip" then do:
     1284         assign
     1285           v-idop = p-i-doc .
     1286         do while true :
     1287           if index (v-idop , ".") = 0 then
     1288             v-idop  = replace (v-idop , "-", "-1.").
     1289           else
     1290             v-idop  =
     1291             substring (v-idop , 1, index (v-idop, "-")) +
     1292             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1293             substring (v-idop, index (v-idop, ".")).
     1294           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1295         end.
     1296         assign
     1297           p-ord-doc = v-idop.
     1298       end.
     1299   end case.
     1300     end.
     1301   end procedure.
     1302   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1303   define new global shared variable g#attr-lib  as handle no-undo .
     1304   define variable v-attr-lib-variable as handle no-undo .
     1305   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1306   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1307   procedure thbjattr_code :
     1308      define input  parameter p-upper-code     as character no-undo .
     1309      define input  parameter p-code           as character no-undo .
     1310      define output parameter p-label          as character no-undo .
     1311      define output parameter p-user-can-edit  as logical   no-undo .
     1312      define output parameter p-output-display as logical   no-undo .
     1313      define output parameter p-other          as character no-undo .
     1314      define output parameter p-prop-list      as character no-undo .
     1315      define output parameter p-prop-type-list as character no-undo .
     1316      define output parameter p-prop-label-list as character no-undo .
     1317      define output parameter p-global          as logical no-undo .
     1318      define output parameter p-host           as logical no-undo .
     1319      define output parameter p-shop           as logical no-undo .
     1320      define output parameter p-store          as logical no-undo .
     1321      define output parameter p-db             as logical no-undo .
