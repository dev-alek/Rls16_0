      820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      821     (output var-report-r-b
      822     )  .
      823   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   function func-get-name-from-ext-type   returns char
      825     ( p-ext-type as character   ,
      826       p-caps     as logical ).
      827   define variable v-ext-name as character no-undo .
      828   run get-name-from-ext-type in this-procedure (
      829       input p-ext-type  ,
      830       input p-caps  ,
      831       output v-ext-name )
      832       no-error .
      833       if error-status :error then do:
      834          assign
      835            v-ext-name = p-ext-type
      836          .
      837       end.
      838    return (v-ext-name) .
      839   end.
      840   procedure get-name-from-ext-type :
      841    do
      842    on error undo, return error return-value
      843    :
      844   define input  parameter p-ext-type as character no-undo .
      845   define input  parameter p-caps     as logical no-undo   .
      846   define output parameter p-ext-name as character no-undo .
      847   define variable v-num as integer no-undo .
      848     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      849       message
      850         vss-include-info8 skip
      851         "Неправильно задано значение входящего параметра! "
      852         "Нет такого типа документов " p-ext-type
      853         view-as alert-box error .
      854         undo, return error .
      855     end.
      856     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      857     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      858     if p-caps  = true then do :
      859        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      860     end .
      861     end.
      862   end procedure.
      863   define variable vss-include-info9 as character format "X(65)" no-undo
      864   initial "@(#)$Workfile$ $Revision$".
      865   procedure grplib-get-full-name :
      866      define input parameter p-node-code  as integer      no-undo.
      867      define output parameter p-full-name as character    no-undo.
      868      do
      869   on error undo, return error
      870   :
      871       define variable v-upper-code    as integer           no-undo.
      872       define buffer buf_gds-grp       for ub.gds-grp.
      873       define buffer buf_upper_gds-grp for ub.gds-grp.
      874       find first buf_gds-grp no-lock
      875            where buf_gds-grp.node-code = p-node-code
      876       no-error.
      877       if not available buf_gds-grp
      878       then do:
      879           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      880       end.
      881       assign
      882           p-full-name  = ""
      883           v-upper-code = 1
      884       .
      885       do while buf_gds-grp.upper-code <> 0
      886       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      887       :
      888           assign
      889               p-full-name  = buf_gds-grp.node-name
      890                            + (if p-full-name <> "" then chr(47) else "")
      891                            + p-full-name
      892               v-upper-code = buf_gds-grp.upper-code
      893           .
      894           find first buf_gds-grp no-lock
      895                where buf_gds-grp.node-code = v-upper-code
      896           no-error.
      897           if not available buf_gds-grp
      898           then do:
      899               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      900                                   + string( v-upper-code )
      901                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      902           end.
      903       end.
      904       assign
      905       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      906       .
      907   end.
      908   end .
      909   procedure grplib-get-node-from-full-name :
      910   define input parameter p-full-name as character no-undo .
      911   define output parameter p-node-code as integer no-undo .
      912   define variable v-ii as integer no-undo .
      913   define variable v-upper-code as integer no-undo .
      914   define variable v-root-code as integer no-undo .
      915   define variable v-entry as character no-undo .
      916   define buffer buf_gds-grp       for ub.gds-grp.
      917   do
      918   on error undo, return error
      919   :
      920     find first buf_gds-grp no-lock
      921         where buf_gds-grp.upper-code = 0
      922     no-error .
      923     if not available buf_gds-grp
      924     then do:
      925         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      926     end.
      927     else do:
      928       assign
      929       v-root-code = buf_gds-grp.node-code
      930       .
      931     end.
      932     v-upper-code = v-root-code.
      933     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      934       assign
      935       v-entry = entry(v-ii, p-full-name, chr(47)).
      936       if v-entry = '' then leave.
      937       find first buf_gds-grp no-lock where
      938                 buf_gds-grp.node-name = v-entry
      939             and buf_gds-grp.upper-code = v-upper-code
      940             no-error.
      941       if not available buf_gds-grp then do:
      942         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      943       end.
      944       else do:
      945         p-node-code = buf_gds-grp.node-code.
      946         v-upper-code = buf_gds-grp.node-code.
      947       end.
      948     end.
      949   end.
      950   end .
      951   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   define variable v-waitfram-action01         as character   no-undo .
      953   define variable v-waitfram-action02         as character   no-undo .
      954   define variable v-waitfram-action03         as character   no-undo .
      955   define variable mWaitFramTextBeg            as character   no-undo.
      956   define variable mWaitFramTextEnd            as character   no-undo.
      957   define variable mWaitFramView               as logical     no-undo.
      958   define variable mWaitProcEvent              as logical     no-undo init yes.
      959   define variable mWaitFramInterval           as integer     no-undo init 1 .
      960   define variable mWaitFramStop               as logical     no-undo.
      961   define variable mWaitFramStopUser           as logical     no-undo.
      962   define variable mWaitFramStopTimeOut        as logical     no-undo.
      963   define variable mWaitFramStartProc          as datetime-tz no-undo.
      964   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      965   define button B-WaitFramStop auto-end-key
      966        label "Стоп"
      967        size 10 by 1 tooltip "Остоновить процесс".
      968   define button B-viewProcInfo
      969        label "Информация"
      970        size 15 by 1 tooltip "Информация о процесс".
      971   define frame waitfram
      972     v-waitfram-action01 format "x(72)" no-label skip
      973     v-waitfram-action02 format "x(72)" no-label skip
      974     v-waitfram-action03 format "x(72)" no-label skip
      975     B-viewProcInfo
      976     B-WaitFramStop at row 4 col 30
      977     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      978     .
      979   define new global shared variable mBatchMode as logical no-undo init ?.
      980   define variable mFramBachModHandle as handle no-undo.
      981   mFramBachModHandle = frame waitfram:handle.
      982   define variable mFameOldVis as logical no-undo.
      983   define variable mVisCUrentVin as logical no-undo.
      984   if session:batch-mode
      985   then
      986      mBatchMode = yes.
      987   if mBatchMode = ? then do:
      988     mVisCUrentVin = current-window:visible.
      989     mFameOldVis = mFramBachModHandle:visible.
      990     mFramBachModHandle:visible  = yes.
      991     mBatchMode = mFramBachModHandle:visible ne yes.
      992     mFramBachModHandle:visible = mFameOldVis.
      993     current-window:visible = mVisCUrentVin.
      994   end.
      995    if  log-manager:logfile-name ne ?
      996     then DO:
      997         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      998         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      999         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1000     end.
     1001   on choose of B-WaitFramStop in frame waitfram
     1002   do:
     1003     mWaitFramStop = yes.
     1004     mWaitFramStopUser = yes.
     1005   end.
     1006   function waitfram-check-timeout returns logical():
     1007      define variable vtime as int64 no-undo.
     1008      if mWaitFramStopTimeOut
     1009      then
     1010         return yes.
     1011      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1012      if     mWaitFramTimeOut ne ?
     1013         and mWaitFramTimeOut ne 0
     1014         and mWaitFramTimeOut lt vtime
     1015      then do:
     1016         mWaitFramStopTimeOut = yes.
     1017      end.
     1018      return mWaitFramStopTimeOut.
     1019   end.
     1020   procedure waitfram-hide :
     1021     if not session:batch-mode
     1022     then do
     1023     on error undo, return error return-value
     1024     :
     1025       pause 0 before-hide .
     1026       if not mBatchMode then
     1027         hide frame waitfram .
     1028     if     not mWaitFramView
     1029        and mWaitProcEvent
     1030     then
     1031       process events .
     1032     end.
     1033   end procedure.
     1034   procedure waitfram-show :
     1035     define input  parameter p-message as character no-undo .
     1036     define variable v-left-margin as integer   no-undo .
     1037     if not session:batch-mode
     1038     then do
     1039     on error undo, return error return-value
     1040     :
     1041       if length(p-message) <= 70 then do:
     1042         assign
     1043           v-left-margin = integer((70 - length(p-message)) / 2)
     1044         .
     1045         assign
     1046           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1047         .
     1048         assign
     1049           v-waitfram-action01 = " "
     1050           v-waitfram-action02 = " "
     1051                                    + fill(" ", v-left-margin)
     1052                                    + p-message
     1053           v-waitfram-action03 = " "
     1054         .
     1055       end.
     1056       else do:
     1057         define variable vRindex1 as integer no-undo.
     1058         define variable vRindex2 as integer no-undo.
     1059         vRindex1 = r-index(p-message," ",70).
     1060         if vRindex1 = 0
     1061         then
     1062            vRindex1 = 70.
     1063         if length(p-message)  <= vRindex1 + 70 then do:
     1064           assign
     1065             v-waitfram-action01 = " "
     1066             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1067             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1068           .
     1069         end.
     1070         else do:
     1071           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1072           if vRindex2 <= vRindex1
     1073           then
     1074              vRindex2 = vRindex1 + 70.
     1075           assign
     1076             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1077             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1078             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1079           .
     1080         end.
     1081       end.
     1082       B-viewProcInfo:visible   in frame waitfram = no.
     1083       B-viewProcInfo:sensitive in frame waitfram = no.
     1084       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1085       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1086       if  (   mWaitFramView
     1087          or  mWaitProcEvent)
     1088          and not mBatchMode
     1089       then
     1090          display
     1091             v-waitfram-action01 skip
     1092             v-waitfram-action02 skip
     1093             v-waitfram-action03 skip
     1094          with frame waitfram .
     1095       if     mWaitFramView
     1096          then do:
     1097             if     mWaitFramInterval ne ?
     1098                and not mBatchMode
     1099             then
     1100                wait-for go of frame waitfram pause mWaitFramInterval.
     1101          end.
     1102          else
     1103             if     mWaitProcEvent
     1104                and not mBatchMode
     1105             then
     1106                process events .
     1107     end.
     1108   end procedure.
     1109      procedure waitfram-show-this:
     1110         define input  parameter iInterval as int64 no-undo.
     1111         define variable vtime as int64 no-undo.
     1112         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1113         mWaitFramInterval = iInterval.
     1114         run waitfram-show (substitute("&1&2 &3&4" ,
     1115                                       mWaitFramTextBeg ,
     1116                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1117                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1118                                       mWaitFramTextEnd
     1119                                      )
     1120                           ).
     1121      end.
     1122      procedure WaitFramRunPause:
     1123         define input  parameter iInterval as dec no-undo.
     1124         define variable vStart  as datetime-tz no-undo.
     1125         define variable vend    as datetime-tz no-undo.
     1126         define variable vint as int64 no-undo.
     1127         define variable vOk as logical no-undo.
     1128         vStart = now.
     1129         vend   = vStart.
     1130         publish "WaitFramPause" (iInterval,output vOk).
     1131         vend   =  now.
     1132         vint = vend - vStart.
     1133         vint = iInterval - vint / 1000.
     1134         if     not mWaitFramStop
     1135            and (   vint > 0
     1136                 or (    not vOk
     1137                     and iInterval eq ?
     1138                     )
     1139                 )
     1140         then
     1141            run waitfram-show-this (iInterval).
     1142         vend   =  now.
     1143         vint = vend - vStart.
     1144         vint = iInterval - vint / 1000.
     1145         if     not mWaitFramStop
     1146            and vint > 0
     1147         then do:
     1148            run gbl/pause.p (vint * 1000).
     1149         end.
     1150         if iInterval ne ?
     1151         then
     1152            publish "WaitFramStop".
     1153         waitfram-check-timeout().
     1154      end.
     1155      procedure WaitFramWaitFor:
     1156         define input  parameter iInterval as dec no-undo.
     1157         assign
     1158            mWaitFramStartProc   = now
     1159            mWaitFramStopUser    = no
     1160            mWaitFramStopTimeOut = no
     1161         .
     1162         block-wait:
     1163         do while not mWaitFramStop:
     1164            run WaitFramRunPause (iInterval).
     1165            if  waitfram-check-timeout()
     1166            then do:
     1167               leave block-wait.
     1168            end.
     1169         end.
     1170         run waitfram-hide.
     1171      end.
     1172   procedure waitfram-join :
     1173     define input  parameter p-line-1  as character no-undo .
     1174     define input  parameter p-line-2  as character no-undo .
     1175     define input  parameter p-line-3  as character no-undo .
     1176     define output parameter p-message as character no-undo .
     1177     do
     1178     on error undo, return error return-value
     1179     :
     1180       assign
     1181         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1182                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1183                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1184       .
     1185     end.
     1186   end procedure.
     1187   function waitfram-join-function returns character
     1188     (input p-line-1 as character
     1189     ,input p-line-2 as character
     1190     ,input p-line-3 as character
     1191     ).
     1192     define variable v-message as character no-undo .
     1193     run waitfram-join in this-procedure
     1194       (input  p-line-1
     1195       ,input  p-line-2
     1196       ,input  p-line-3
     1197       ,output v-message
     1198       ) .
     1199     return v-message .
     1200   end function .
     1201   procedure proc-alt-shift-f2:
     1202     if not ibs.th.gbl.gbl-var:rcode
     1203   then
     1204     run gbl\inidebug.p .
     1205   end.
     1206   procedure proc-alt-shift-f3:
