     1646   FUNCTION f-zapr-qnty RETURNS decimal
     1647     ( buffer buf_ord-line for ub.ord-line )  FORWARD.
     1648   FUNCTION mark-string RETURNS CHARACTER
     1649   (buffer fl for x_ord-line, input m as char) FORWARD.
     1650   DEFINE BUTTON B-chg
     1651        LABEL "Изменить"
     1652        SIZE 9 BY 1.
     1653   DEFINE BUTTON B-del
     1654        LABEL "Удалить"
     1655        SIZE 8 BY 1.
     1656   DEFINE BUTTON b-exit AUTO-GO
     1657        LABEL "&Выход"
     1658        SIZE 10 BY 1.
     1659   DEFINE BUTTON B-grp
     1660        LABEL "&Группы"
     1661        SIZE 8 BY 1 TOOLTIP "Отметить товары по группам".
     1662   DEFINE BUTTON B-hand
     1663        LABEL "Генерация"
     1664        SIZE 14 BY 1 TOOLTIP "Создать запросы".
     1665   DEFINE BUTTON B-help
     1666        LABEL "Помо&щь"
     1667        SIZE 10 BY 1.
     1668   DEFINE BUTTON B-lkp
     1669        LABEL "Просмотр"
     1670        SIZE 9 BY 1.
     1671   DEFINE BUTTON B-mark
     1672        LABEL "&*"
     1673        SIZE 3 BY 1 TOOLTIP "Отметить товары".
     1674   DEFINE VARIABLE FI-all-str AS CHARACTER FORMAT "X(16)":U INITIAL "на объект"
     1675         VIEW-AS TEXT
     1676        SIZE 8.38 BY .67
     1677        FONT 4 NO-UNDO.
     1678   DEFINE VARIABLE FI-all-str-3 AS CHARACTER FORMAT "X(16)":U INITIAL "запрошено"
     1679         VIEW-AS TEXT
     1680        SIZE 8.13 BY .67
     1681        FONT 4 NO-UNDO.
     1682   DEFINE VARIABLE FILL-IN-22 AS CHARACTER FORMAT "X(256)":U INITIAL "Товары заказа"
     1683         VIEW-AS TEXT
     1684        SIZE 14 BY .67
     1685        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1686   DEFINE VARIABLE FILL-IN-23 AS CHARACTER FORMAT "X(256)":U INITIAL "Остатки по объектам"
     1687         VIEW-AS TEXT
     1688        SIZE 20 BY .67
     1689        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1690   DEFINE VARIABLE FILL-IN-26 AS CHARACTER FORMAT "X(256)":U INITIAL "Запросы"
     1691         VIEW-AS TEXT
     1692        SIZE 14 BY .67
     1693        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1694   DEFINE VARIABLE FILL-IN-27 AS CHARACTER FORMAT "X(256)":U INITIAL "Товары запроса"
     1695         VIEW-AS TEXT
     1696        SIZE 14 BY .67
     1697        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1698   DEFINE VARIABLE scr-all-qnty AS DECIMAL FORMAT ">>>>>>>9.<<<":U INITIAL 0
     1699         VIEW-AS TEXT
     1700        SIZE 11.75 BY .67 TOOLTIP "Запрошено по запросам"
     1701        FGCOLOR 4  NO-UNDO.
     1702   DEFINE VARIABLE scr-main-num AS CHARACTER FORMAT "X(16)":U
     1703        LABEL "По заказу и его щепкам"
     1704         VIEW-AS TEXT
     1705        SIZE 14 BY .67 TOOLTIP "Головной заказ и его щепки"
     1706        FGCOLOR 4  NO-UNDO.
     1707   DEFINE VARIABLE scr-obj AS CHARACTER FORMAT "X(9)":U
     1708         VIEW-AS TEXT
     1709        SIZE 8.38 BY .67
     1710        FGCOLOR 4 FONT 4 NO-UNDO.
     1711   DEFINE VARIABLE scr-obj-name AS CHARACTER FORMAT "X(256)":U
     1712        LABEL "Заказывает"
     1713         VIEW-AS TEXT
     1714        SIZE 24 BY .67
     1715        FGCOLOR 1  NO-UNDO.
     1716   DEFINE VARIABLE src-ext-doc-type AS CHARACTER FORMAT "x(30)"
     1717         VIEW-AS TEXT
     1718        SIZE 33.75 BY .67
     1719        FGCOLOR 4 FONT 4 NO-UNDO.
     1720   DEFINE VARIABLE src-gds-name AS CHARACTER FORMAT "x(40)"
     1721         VIEW-AS TEXT
     1722        SIZE 40 BY .67
     1723        FGCOLOR 4 FONT 4 NO-UNDO.
     1724   DEFINE VARIABLE src-obj-list-name AS CHARACTER FORMAT "x(24)"
     1725         VIEW-AS TEXT
     1726        SIZE 24.75 BY .67
     1727        FGCOLOR 4  NO-UNDO.
     1728   DEFINE RECTANGLE RECT-1
     1729        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1730        SIZE 26 BY .92
     1731        BGCOLOR 4 .
     1732   DEFINE QUERY BR-gds-obj FOR
     1733         X_gds-obj SCROLLING.
     1734   DEFINE QUERY BR-goods FOR
     1735         X_ord-line,
     1736         X_goods SCROLLING.
     1737   DEFINE QUERY BR-line-trn FOR
     1738         X_doc-line,
     1739         buf_goods SCROLLING.
     1740   DEFINE QUERY BR-obj-list FOR
     1741         obj-list SCROLLING.
     1742   DEFINE QUERY BR-rcv FOR
     1743         X_ord-doc-rcv,
     1744         X_ord-chain,
     1745         X_trn-doc SCROLLING.
     1746   DEFINE BROWSE BR-gds-obj
     1747     QUERY BR-gds-obj DISPLAY
     1748         SUBSTRING (X_gds-obj.obj-type,1,1) COLUMN-LABEL "T" FORMAT "x(1)"
     1749         X_gds-obj.obj-code
     1750         X_gds-obj.fact-qnty COLUMN-LABEL "Факт"         FORMAT "->>>>>>>>9.<<<"
     1751         X_gds-obj.free-qnty COLUMN-LABEL "Свободно" FORMAT "->>>>>>>>9.<<<"
     1752       WITH NO-ROW-MARKERS SEPARATORS SIZE 34.25 BY 8.5.
     1753   DEFINE BROWSE BR-goods
     1754     QUERY BR-goods NO-LOCK DISPLAY
     1755         mark-string(buffer X_ord-line, rid-list)                  COLUMN-LABEL  '*' FORMAT "X(1)"
     1756         X_ord-line.artic         COLUMN-LABEL  'Артикул' FORMAT "X(16)"
     1757         X_goods.gds-name   COLUMN-LABEL  'Название'  FORMAT "X(18)"
     1758         X_ord-line.qnty     COLUMN-LABEL  'Количество'  FORMAT ">>>>>>>9.<<<"
     1759         f-zapr-qnty (buffer X_ord-line )    COLUMN-LABEL "Запрошено" FORMAT ">>>>>>>>.<<<"
     1760     ENABLE
     1761         X_ord-line.qnty
     1762       WITH NO-ROW-MARKERS SEPARATORS SIZE 59.75 BY 8.5.
     1763   DEFINE BROWSE BR-line-trn
     1764     QUERY BR-line-trn NO-LOCK DISPLAY
     1765         X_doc-line.artic
     1766         buf_goods.gds-name FORMAT "X(20)"
     1767         X_doc-line.fact-qnty FORMAT "->>>>>>>9.<<<" column-label "Количество"
     1768       WITH NO-ROW-MARKERS SEPARATORS SIZE 50.38 BY 7.67.
     1769   DEFINE BROWSE BR-obj-list
     1770     QUERY BR-obj-list DISPLAY
     1771         substring(obj-list.obj-type,1,1) format "x(1)"
     1772         string(obj-list.obj-code)  Column-label "Объект" format "x(5)"
     1773         string(obj-list.db-num)  Column-label "БД"
     1774       WITH NO-ROW-MARKERS SEPARATORS SIZE 10.38 BY 7.67 TOOLTIP "Выбор объекта; Поиск по номеру объекта, BACKSPACE - очистить поиск".
     1775   DEFINE BROWSE BR-rcv
     1776     QUERY BR-rcv DISPLAY
     1777         substring(X_ord-doc-rcv.cli-type,1,1) COLUMN-LABEL "Т" format "x(1)"
     1778         X_ord-doc-rcv.cli-code COLUMN-LABEL "Объект" Format "99999"
     1779         X_trn-doc.doc-code format "x(14)"
     1780         substring(X_trn-doc.status_,1,4) + string(X_trn-doc.flag_ ,"+/-") COLUMN-LABEL "Статус" Format "x(6)"
     1781       WITH NO-ROW-MARKERS SEPARATORS SIZE 33.5 BY 7.67.
     1782   DEFINE FRAME Dialog-Frame
     1783        b-exit AT ROW 1 COL 1
     1784        B-mark AT ROW 1 COL 11.13
     1785        B-grp AT ROW 1 COL 14.25
     1786        B-hand AT ROW 1 COL 22.25
     1787        B-help AT ROW 1 COL 36.38
     1788        BR-goods AT ROW 3.79 COL 1
     1789        BR-gds-obj AT ROW 3.79 COL 61.13
     1790        B-del AT ROW 14.13 COL 1
     1791        B-lkp AT ROW 14.13 COL 9
     1792        B-chg AT ROW 14.13 COL 18
     1793        BR-rcv AT ROW 15.25 COL 1
     1794        BR-line-trn AT ROW 15.25 COL 34.75
     1795        BR-obj-list AT ROW 15.25 COL 85
     1796        scr-obj-name AT ROW 1.21 COL 63.5 COLON-ALIGNED
     1797        src-obj-list-name AT ROW 2.13 COL 89.88 RIGHT-ALIGNED NO-LABEL
     1798        FILL-IN-22 AT ROW 3 COL 1.75 NO-LABEL
     1799        FILL-IN-23 AT ROW 3 COL 61.38 NO-LABEL
     1800        src-gds-name AT ROW 12.38 COL 1.38 NO-LABEL
     1801        scr-main-num AT ROW 12.42 COL 79 COLON-ALIGNED
     1802        FI-all-str AT ROW 13.17 COL 55.5 COLON-ALIGNED NO-LABEL
     1803        scr-obj AT ROW 13.17 COL 64.13 COLON-ALIGNED NO-LABEL
     1804        FI-all-str-3 AT ROW 13.17 COL 72.63 COLON-ALIGNED NO-LABEL
     1805        scr-all-qnty AT ROW 13.17 COL 81.25 COLON-ALIGNED NO-LABEL
     1806        FILL-IN-26 AT ROW 13.42 COL 1.75 NO-LABEL
     1807        FILL-IN-27 AT ROW 13.79 COL 34.88 NO-LABEL
     1808        src-ext-doc-type AT ROW 22.92 COL 1 NO-LABEL
     1809        RECT-1 AT ROW 2 COL 65.5
     1810        SPACE(5.62) SKIP(20.74)
     1811       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1812            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1813            TITLE "Распределение заказа по запросам на объекты".
     1814   ASSIGN
     1815          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1816          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1817   ON GO OF FRAME Dialog-Frame
     1818   DO:
     1819      run exit-proc in this-procedure .
     1820   END.
     1821   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1822   DO:
     1823     APPLY "END-ERROR":U TO SELF.
     1824   END.
     1825   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1826   DO:
     1827      if available x_trn-doc and
     1828                   x_trn-doc.doc-type = 'при':U and
     1829                   x_trn-doc.status_  = 'запрос':U      then do:
     1830           run gbl/calc-trn.p ( input parParentProc , input recid(x_trn-doc)).
     1831           run cus/ord-outu.p ( input parParentProc , input recid(x_trn-doc)).
     1832           OPEN QUERY BR-line-trn FOR EACH X_doc-line NO-LOCK where      X_doc-line.doc-code =X_trn-doc.doc-code ,        EACH buf_goods OF X_doc-line NO-LOCK.
     1833           OPEN QUERY BR-goods FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     1834     end.
     1835   END.
     1836   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1837   DO:
     1838     run del-trn in this-procedure .
     1839   END.
     1840   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1841   DO:
     1842       next-prev = ?.
     1843   END.
     1844   ON CHOOSE OF B-grp IN FRAME Dialog-Frame
     1845   DO:
     1846       message "Отметить товары по группам ?"
     1847              view-as alert-box question
     1848               buttons yes-no
     1849              update g-log
     1850              .
     1851     if g-log = false then return.
     1852      run grp-num in this-procedure .
     1853      run OpenBr in this-procedure .
     1854   END.
     1855   ON CHOOSE OF B-hand IN FRAME Dialog-Frame
     1856   DO:
     1857   define variable g-ok as logical no-undo .
     1858   define variable v-rowid as integer no-undo .
     1859     find current x_ord-line no-lock no-error .
     1860     find current obj-list no-error .
     1861     if error-status :error then do:
     1862           message "Подтвердите Объект заказа !"
     1863           view-as alert-box .
     1864           return .
     1865        end.
     1866     if r-gener = 1 then do:
     1867        if num-entries (rid-list) = 0 then do:
     1868           message "Не отмечены товары в заказе !"
     1869           view-as alert-box .
     1870           return .
     1871        end.
     1872        if obj-list.obj-code = buf_ord-doc.obj-code and
     1873           obj-list.obj-type = buf_ord-doc.obj-type then do:
     1874           message "Нельзя перемещать на тот же объект "  obj-list.obj-name "!"
     1875           view-as alert-box .
     1876           return .
     1877        end.
     1878         message "Сформировать запрос на объект"  obj-list.obj-name " ? "
     1879                 view-as alert-box question
     1880                 buttons yes-no
     1881                 update g-ok
     1882                 .
     1883     end.
     1884     if g-ok = false then return.
     1885     .
     1886     run make-trn-doc in this-procedure .
     1887     run OpenBr in this-procedure .
     1888   END.
     1889   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1890   DO:
     1891      if available x_trn-doc then
     1892         run str/showdoc.p
     1893             (input parparentproc
     1894             ,input x_trn-doc.doc-code
     1895             ,input ""
     1896             ,input ""
     1897             ,input 0
     1898             ,input true
     1899             ) .
     1900   END.
     1901   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1902   DO:
     1903           if available x_ord-line then do:
     1904   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1905   define variable v-str-recid18 as character no-undo .
     1906   define variable v-num-entry18 as integer   no-undo .
     1907   assign
     1908     v-str-recid18 = trim( string( recid( x_ord-line ) , "->>>>>>>>>>>9":U ) )
     1909     v-num-entry18 = lookup( v-str-recid18 , rid-list )
     1910   .
     1911   if v-num-entry18 > 0 then do:
     1912     assign
     1913       entry( v-num-entry18, rid-list ) = "":U
     1914       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1915     .
     1916   end.
     1917   else do:
     1918     assign
     1919       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid18
     1920     .
     1921   end.
     1922           g-log = br-goods:refresh() .
     1923           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1924               g-log = br-goods:select-next-row ().
     1925               apply "VALUE-CHANGED" to br-goods in frame Dialog-Frame.
     1926           end.
     1927       end.
     1928       apply "entry" to br-goods in frame Dialog-Frame.
     1929   END.
     1930   ON VALUE-CHANGED OF BR-gds-obj IN FRAME Dialog-Frame
     1931   DO:
     1932   run proc-gds-obj in this-procedure .
     1933   END.
     1934   ON VALUE-CHANGED OF BR-goods IN FRAME Dialog-Frame
     1935   DO:
     1936   src-gds-name = "" .
     1937   if available x_goods then do:
     1938      src-gds-name = x_goods.gds-name .
     1939      OPEN QUERY BR-gds-obj FOR EACH X_gds-obj NO-LOCK where x_gds-obj.artic = x_ord-line.artic and x_gds-obj.prod-code = x_ord-line.prod-code and x_gds-obj.prod-type = x_ord-line.prod-type and x_gds-obj.host-code = p-host-code and not ( x_gds-obj.fact-qnty = 0 and x_gds-obj.free-qnty = 0 )  .
     1940      run proc-gds-obj in this-procedure .
     1941   end.
     1942   display src-gds-name  with frame Dialog-Frame.
     1943   END.
     1944   ON ANY-PRINTABLE OF BR-obj-list IN FRAME Dialog-Frame
     1945   DO:
     1946     v-poisk = v-poisk + last-event:label.
     1947     find first obj-list where string(obj-list.obj-code ) begins v-poisk  no-error .
     1948     if available  obj-list then
     1949        reposition BR-obj-list to recid recid(obj-list) no-error .
     1950     apply "VALUE-CHANGED" TO BR-obj-list IN FRAME Dialog-Frame.
     1951   END.
     1952   ON BACKSPACE OF BR-obj-list IN FRAME Dialog-Frame
     1953   DO:
     1954     v-poisk = "".
     1955   END.
     1956   ON VALUE-CHANGED OF BR-obj-list IN FRAME Dialog-Frame
     1957   DO:
     1958     if available obj-list then do:
     1959       src-obj-list-name = "у " + obj-list.obj-name.
     1960       display src-obj-list-name with frame Dialog-Frame.
     1961       run proc-gds-obj in this-procedure .
     1962     end.
     1963   END.
     1964   ON VALUE-CHANGED OF BR-rcv IN FRAME Dialog-Frame
     1965   DO:
     1966     OPEN QUERY BR-line-trn FOR EACH X_doc-line NO-LOCK where      X_doc-line.doc-code =X_trn-doc.doc-code ,        EACH buf_goods OF X_doc-line NO-LOCK.
     1967   if available x_trn-doc  then do:
     1968      src-ext-doc-type = func-get-name-from-ext-type (x_trn-doc.ext-doc-type,no) .
     1969   end.
     1970   display src-ext-doc-type with frame Dialog-Frame.
     1971   END.
     1972   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1973   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1974   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1975   on help of frame Dialog-Frame
     1976   do:
     1977     run gbl/app_help.p
     1978       (input this-procedure :file-name
     1979       ,input ''
     1980       ,input ?
     1981       ) no-error.
     1982     if error-status :error then do:
     1983       message
     1984         "Ошибка при вызове помощи"
     1985         error-status :get-message(1)
     1986         view-as alert-box .
     1987     end.
     1988   end.
     1989   run minbtn-set in this-procedure .
     1990   on choose of b-help in frame Dialog-Frame
     1991   do:
     1992     apply "help":u to frame Dialog-Frame .
     1993   end.
     1994   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1995   procedure minbtn-set :
     1996       do
     1997           on error undo, return error return-value
     1998           :
     1999           define variable ii              as integer       no-undo .
     2000           define variable fh              as widget-handle no-undo .
     2001           define variable hh              as widget-handle no-undo .
     2002           define variable v-h             as handle        extent 4 no-undo .
     2003           define variable v-name-button   as character     no-undo .
     2004           define variable v-help-old-x    as decimal       no-undo .
     2005           define variable v-help-old-y    as decimal       no-undo .
     2006           define variable v-help-old-size as decimal       no-undo .
     2007           define variable v-frame-width   as decimal       no-undo .
     2008           define variable jj              as integer       no-undo .
     2009           do
     2010               on error undo, return error
     2011               :
     2012               assign
     2013                   v-frame-width = frame Dialog-Frame:width - 0.3
     2014                   fh            = frame Dialog-Frame:first-child
     2015                   hh            = fh:first-child
     2016                   ii            = 1
     2017                   .
     2018               do while valid-handle(hh):
     2019                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2020                   do:
     2021                       case lc(hh:name) :
     2022                           when "b-help" then
     2023                               do:
     2024                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2025                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2026                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2027                                   hh:TOOLTIP = "Помощь" .
     2028                                   v-help-old-x = hh:column .
     2029                                   v-help-old-y = hh:row    .
     2030                                   v-help-old-size = hh:width .
     2031                                   hh:width-chars = 2.5 .
     2032                               end.
     2033                           when "b-print" then
     2034                               do:
     2035                                   hh:load-image("cmp/b-print.bmp":u) .
     2036                                   hh:TOOLTIP = "Печать" .
     2037                                   v-h[ii] = hh:handle .
     2038                                   ii = ii + 1 .
     2039                                   hh:width-chars = 3 .
     2040                               end.
     2041                           when "b-history" or
     2042                           when "b-hist" then
     2043                               do:
     2044                                   hh:load-image("cmp/b-hist.bmp":u) .
     2045                                   hh:TOOLTIP = "История" .
     2046                                   v-h[ii] = hh:handle .
     2047                                   ii = ii + 1 .
     2048                                   hh:width-chars = 3 .
     2049                               end.
     2050                           when "b-sch" then
     2051                               do:
     2052                                   hh:load-image("cmp/b-sch.bmp":u) .
     2053                                   hh:TOOLTIP = "Установка Фильтра" .
     2054                                   v-h[ii] = hh:handle .
     2055                                   ii = ii + 1 .
     2056                                   hh:width-chars = 3 .
     2057                               end.
     2058                           when "b-hist-user" then
     2059                               do:
     2060                                   hh:load-image("cmp/b-hist.bmp":u) .
     2061                                   hh:TOOLTIP = "История пользователя" .
     2062                                   ii = ii + 1 .
     2063                               end.
     2064                       end case.
     2065                   end.
     2066                   hh = hh:next-sibling.
     2067               end.
     2068               b-help:column = v-frame-width - b-help:width-chars.
     2069               jj = 0.
     2070               repeat ii = 4 to 1 by -1 :
     2071                   if valid-handle (v-h[ii] ) then
     2072                   do:
     2073                       jj  = jj + 1 .
     2074                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2075                       v-h[ii]:row    = v-help-old-y .
     2076                   end.
     2077               end.
     2078           end.
     2079       end.
     2080   end procedure.
     2081   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2082   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2083   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2084   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2085   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2086   define variable v-diasize-current-frame-height as decimal   no-undo .
     2087   define variable v-diasize-change-size          as logical   no-undo .
     2088   define variable v-diasize-resize-button        as handle    no-undo .
     2089   define variable v-diasize-wndmax               as logical   no-undo .
     2090   define variable v-diasize-wndstore             as logical   no-undo .
     2091   define variable v-diasize-proc-name            as character no-undo .
     2092   define variable v-diasize-browse-handle        as handle    no-undo .
     2093   define variable v-diasize-browse-number        as integer   no-undo .
     2094   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2095   define temp-table temp-diasize-handle no-undo
     2096     field handle-value  as handle
     2097     field save-position as decimal
     2098     index xpk is primary unique handle-value
     2099     .
     2100   define temp-table temp-browse-handle no-undo
     2101     field browse-type   as character
     2102     field browse-number as integer
     2103     field browse-handle as handle
     2104     field original-size as decimal
     2105     index xpk is primary unique browse-type browse-number
     2106     index xie browse-type browse-handle
     2107   .
     2108   procedure diasize_change-height :
     2109     define input  parameter p-change-value  as decimal   no-undo .
     2110     define input  parameter p-move-resize   as logical   no-undo .
     2111     define variable v-field-group-handle    as handle    no-undo .
     2112     define variable v-object-handle         as handle    no-undo .
     2113     define variable v-frame-height          as decimal   no-undo .
     2114     define variable v-frame-virtual-height  as decimal   no-undo .
     2115     define variable v-browse-height         as decimal   no-undo .
     2116     define variable v-window-height         as decimal   no-undo .
     2117     define variable v-window-virtual-height as decimal   no-undo .
     2118     define variable v-change-sign           as integer   no-undo .
     2119     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2120     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2121     if p-change-value > 0
     2122     then do:
     2123       if frame Dialog-Frame :height + p-change-value
     2124           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2125       then do:
     2126         assign
     2127           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2128                           - (frame Dialog-Frame :height-chars)
     2129         .
     2130         if p-change-value <= 0
     2131         then do:
     2132           run diasize_position-resize-button in this-procedure .
     2133           return .
     2134         end.
     2135       end.
     2136     end.
     2137     if p-change-value < 0
     2138     then do:
     2139       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2140       then do:
     2141         assign
     2142           p-change-value = v-diasize-orig-frame-height
     2143                          - (frame Dialog-Frame :height-chars)
     2144         .
     2145         if p-change-value >= 0
     2146         then do:
     2147           run diasize_position-resize-button in this-procedure .
     2148           return .
     2149         end.
     2150       end.
     2151     end.
     2152     if p-change-value >= 0
     2153     then do:
     2154       assign
     2155         v-change-sign = 1
     2156       .
     2157     end.
     2158     else do:
     2159       assign
     2160         v-change-sign = -1
     2161       .
     2162     end.
     2163     assign
     2164       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2165     .
     2166     if p-change-value = 0
     2167     then do:
     2168       run diasize_position-resize-button in this-procedure .
     2169       return .
     2170     end.
     2171     move_block:
     2172     do
     2173     on error undo move_block, retry move_block
     2174     :
     2175       if retry
     2176       then do:
     2177         do
     2178         on error undo move_block, leave move_block
     2179         :
     2180           if p-change-value > 0
     2181           then do:
     2182             for each buf_temp-diasize-handle
     2183             on error undo, next
     2184             :
     2185               assign
     2186                 v-object-handle = buf_temp-diasize-handle.handle-value
     2187               .
     2188               if v-object-handle <> v-diasize-resize-button
     2189               then do:
     2190                 assign
     2191                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2192                 .
     2193               end.
     2194             end.
     2195             assign
     2196               v-diasize-browse-handle :height = v-browse-height
     2197             .
     2198             for each buf_temp-browse-handle
     2199               where buf_temp-browse-handle.browse-type = 'height':u
     2200             on error undo, next
     2201             :
     2202               assign
     2203                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2204               .
     2205             end.
     2206             assign
     2207               frame Dialog-Frame :height = v-frame-height
     2208             .
     2209             if frame Dialog-Frame :scrollable = true
     2210             then do:
     2211               assign
     2212                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2213               .
     2214             end.
     2215             run diasize_position-resize-button in this-procedure .
     2216           end.
     2217           else do:
     2218             if frame Dialog-Frame :scrollable = true
     2219             then do:
     2220               assign
     2221                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2222               .
     2223             end.
     2224             assign
     2225               frame Dialog-Frame :height = v-frame-height
     2226             .
     2227             assign
     2228               v-diasize-browse-handle :height = v-browse-height
     2229             .
     2230             for each buf_temp-browse-handle
     2231               where buf_temp-browse-handle.browse-type = 'height':u
     2232             on error undo, next
     2233             :
     2234               assign
     2235                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2236               .
     2237             end.
     2238             for each buf_temp-diasize-handle
     2239             on error undo, next
     2240             :
     2241               assign
     2242                 v-object-handle = buf_temp-diasize-handle.handle-value
     2243               .
     2244               if v-object-handle <> v-diasize-resize-button
     2245               then do:
     2246                 assign
     2247                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2248                 .
     2249               end.
     2250             end.
     2251             run diasize_position-resize-button in this-procedure .
     2252           end.
     2253           assign
     2254             v-diasize-change-size = false
     2255           .
     2256           leave move_block .
     2257         end.
     2258       end.
     2259       assign
     2260         v-diasize-need-full-display = true
     2261       .
     2262       if v-diasize-change-size = false
     2263       then do:
     2264         assign
     2265           v-diasize-change-size = true
     2266         .
     2267       end.
     2268       else do:
     2269         return .
     2270       end.
     2271       assign
     2272         v-frame-height = frame Dialog-Frame :height
     2273         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2274         v-browse-height = v-diasize-browse-handle :height
     2275       .
     2276       for each buf_temp-browse-handle
     2277         where buf_temp-browse-handle.browse-type = 'height':u
     2278       :
     2279         assign
     2280           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2281         .
     2282       end.
     2283       for each buf_temp-diasize-handle
     2284       :
     2285         delete buf_temp-diasize-handle .
     2286       end.
     2287       assign
     2288         v-field-group-handle = frame Dialog-Frame :first-child
     2289       .
     2290       do while valid-handle(v-field-group-handle)
     2291       :
     2292         assign
     2293           v-object-handle = v-field-group-handle :first-child
     2294         .
     2295         do while valid-handle(v-object-handle)
     2296         :
     2297           if  v-object-handle <> v-diasize-browse-handle :handle
     2298           and can-query(v-object-handle, "row")
     2299           and can-query(v-object-handle, "height")
     2300           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2301           then do:
     2302             find first buf_temp-browse-handle
     2303               where buf_temp-browse-handle.browse-type   = 'height':u
     2304                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2305               no-error .
     2306             if available buf_temp-browse-handle
     2307             then do:
     2308             end.
     2309             else do:
     2310               create buf_temp-diasize-handle .
     2311               assign
     2312                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2313                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2314               .
     2315             end.
     2316           end.
     2317           assign
     2318             v-object-handle = v-object-handle :next-sibling
     2319           .
     2320         end.
     2321         assign
     2322           v-field-group-handle = v-field-group-handle :next-sibling
     2323         .
     2324       end.
     2325       do with frame Dialog-Frame
     2326       :
     2327         hide v-diasize-resize-button .
     2328         assign
     2329           v-diasize-resize-button :row    = 1
     2330           v-diasize-resize-button :column = 1
     2331         .
     2332       end.
     2333       if p-change-value > 0
     2334       then do:
     2335         if frame Dialog-Frame :scrollable = true
     2336         then do:
     2337           assign
     2338             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2339             no-error .
     2340           if error-status :error
     2341           or error-status :get-message(1) <> ""
     2342           then do:
     2343             undo move_block, retry move_block .
     2344           end.
     2345         end.
     2346         assign
     2347           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2348           no-error .
     2349         if error-status :error
     2350         or error-status :get-message(1) <> ""
     2351         then do:
     2352           undo move_block, retry move_block .
     2353         end.
     2354         assign
     2355           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2356           no-error .
     2357         if error-status :error
     2358         or error-status :get-message(1) <> ""
     2359         then do:
     2360           undo move_block, retry move_block .
     2361         end.
     2362         for each buf_temp-browse-handle
     2363           where buf_temp-browse-handle.browse-type = 'height':u
     2364         on error undo move_block, retry move_block
     2365         :
     2366           assign
     2367             buf_temp-browse-handle.browse-handle :height
     2368               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2369             no-error .
     2370           if error-status :error
     2371           or error-status :get-message(1) <> ""
     2372           then do:
     2373             undo move_block, retry move_block .
     2374           end.
     2375         end.
     2376         for each buf_temp-diasize-handle
     2377         on error undo move_block, retry move_block
     2378         :
     2379           assign
     2380             v-object-handle = buf_temp-diasize-handle.handle-value
     2381           .
     2382           if v-object-handle <> v-diasize-resize-button
     2383           then do:
     2384             assign
     2385               v-object-handle :row = v-object-handle :row + p-change-value
     2386               no-error .
     2387             if error-status :error
     2388             or error-status :get-message(1) <> ""
     2389             then do:
     2390               undo move_block, retry move_block .
     2391             end.
     2392           end.
     2393         end.
     2394       end.
     2395       else do:
     2396         for each buf_temp-diasize-handle
     2397         on error undo move_block, retry move_block
     2398         :
     2399           assign
     2400             v-object-handle = buf_temp-diasize-handle.handle-value
     2401           .
     2402           if v-object-handle <> v-diasize-resize-button
     2403           then do:
     2404             assign
     2405               v-object-handle :row = v-object-handle :row + p-change-value
     2406               no-error .
     2407             if error-status :error
     2408             or error-status :get-message(1) <> ""
     2409             then do:
     2410               undo move_block, retry move_block .
     2411             end.
     2412           end.
     2413         end.
     2414         assign
     2415           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2416           no-error .
     2417         if error-status :error
     2418         or error-status :get-message(1) <> ""
     2419         then do:
     2420           undo move_block, retry move_block .
     2421         end.
     2422         for each buf_temp-browse-handle
     2423           where buf_temp-browse-handle.browse-type = 'height':u
     2424         on error undo move_block, retry move_block
     2425         :
     2426           assign
     2427             buf_temp-browse-handle.browse-handle :height
     2428               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2429             no-error .
     2430           if error-status :error
     2431           or error-status :get-message(1) <> ""
     2432           then do:
     2433             undo move_block, retry move_block .
     2434           end.
     2435         end.
     2436         assign
     2437           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2438           no-error .
     2439         if error-status :error
     2440         or error-status :get-message(1) <> ""
     2441         then do:
     2442           undo move_block, retry move_block .
     2443         end.
     2444         if frame Dialog-Frame :scrollable = true
     2445         then do:
     2446           assign
     2447             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2448             no-error .
     2449           if error-status :error
     2450           or error-status :get-message(1) <> ""
     2451           then do:
     2452             undo move_block, retry move_block .
     2453           end.
     2454         end.
     2455       end.
     2456       if p-move-resize = true
     2457       then do:
     2458         run diasize_position-resize-button in this-procedure .
     2459       end.
     2460       if v-diasize-wndstore = true
     2461       then do:
     2462         if connected("ub") = true
     2463         then do:
     2464           define variable v-cntxt-db-num        as integer   no-undo .
     2465           define variable v-cntxt-userid        as character no-undo .
     2466           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2467                                             , OUTPUT v-cntxt-userid
     2468                                             ) .
     2469           run gbl/wndsizew.p
     2470             (input  v-cntxt-db-num
     2471             ,input  v-cntxt-userid
     2472             ,input  v-diasize-proc-name
     2473             ,input  'height':u
     2474             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2475             ) .
     2476         end.
     2477       end.
     2478     end.
     2479     assign
     2480       v-diasize-change-size = false
     2481     .
     2482   end procedure.
     2483   procedure diasize_set-height :
     2484     define input  parameter p-new-height  as decimal   no-undo .
     2485     define input  parameter p-move-resize as logical   no-undo .
     2486     do
     2487     on error undo, return error return-value
     2488     :
     2489       run diasize_change-height in this-procedure
     2490         (input  (p-new-height - frame Dialog-Frame :height)
     2491         ,input  p-move-resize
     2492         ) .
     2493     end.
     2494   end procedure.
     2495   procedure diasize_change-width :
     2496     define input  parameter p-change-value as decimal   no-undo .
     2497     define input  parameter p-move-resize  as logical   no-undo .
     2498     define variable v-field-group-handle   as handle    no-undo .
     2499     define variable v-object-handle        as handle    no-undo .
     2500     define variable v-frame-width          as decimal   no-undo .
     2501     define variable v-frame-virtual-width  as decimal   no-undo .
     2502     define variable v-browse-width         as decimal   no-undo .
     2503     define variable v-window-width         as decimal   no-undo .
     2504     define variable v-window-virtual-width as decimal   no-undo .
     2505     define variable v-change-sign          as integer   no-undo .
     2506     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2507     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2508     if p-change-value > 0
     2509     then do:
     2510       if frame Dialog-Frame :width + p-change-value >
     2511           session :width-chars
     2512       then do:
     2513         assign
     2514           p-change-value = session :width-chars - frame Dialog-Frame :width
     2515         .
     2516         if p-change-value <= 0
     2517         then do:
     2518           run diasize_position-resize-button in this-procedure .
     2519           return .
     2520         end.
     2521       end.
     2522     end.
     2523     if p-change-value < 0
     2524     then do:
     2525       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2526       then do:
     2527         assign
     2528           p-change-value = v-diasize-orig-frame-width
     2529                          - frame Dialog-Frame :width
     2530         .
     2531         if p-change-value >= 0
     2532         then do:
     2533           run diasize_position-resize-button in this-procedure .
     2534           return .
     2535         end.
     2536       end.
     2537     end.
     2538     if p-change-value >= 0
     2539     then do:
     2540       assign
     2541         v-change-sign = 1
     2542       .
     2543     end.
     2544     else do:
     2545       assign
     2546         v-change-sign = -1
     2547       .
     2548     end.
     2549     assign
     2550       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2551     .
     2552     if p-change-value = 0
     2553     then do:
     2554       run diasize_position-resize-button in this-procedure .
     2555       return .
     2556     end.
     2557     move_block:
     2558     do
     2559     on error undo move_block, leave move_block
     2560     :
     2561       if retry
     2562       then do:
     2563         do
     2564         on error undo move_block, leave move_block
     2565         :
     2566           if p-change-value > 0
     2567           then do:
     2568             for each buf_temp-diasize-handle
     2569             on error undo, next
     2570             :
     2571               assign
     2572                 v-object-handle = buf_temp-diasize-handle.handle-value
     2573               .
     2574               if v-object-handle <> v-diasize-resize-button
     2575               then do:
     2576                 assign
     2577                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2578                 .
     2579               end.
     2580             end.
     2581             assign
     2582               v-diasize-browse-handle :width = v-browse-width
     2583             .
     2584             for each buf_temp-browse-handle
     2585               where buf_temp-browse-handle.browse-type = 'width':u
     2586             on error undo, next
     2587             :
     2588               assign
     2589                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2590               .
     2591             end.
     2592             assign
     2593               frame Dialog-Frame :width = v-frame-width
     2594             .
     2595             if frame Dialog-Frame :scrollable = true
     2596             then do:
     2597               assign
     2598                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2599               .
     2600             end.
     2601             run diasize_position-resize-button in this-procedure .
     2602           end.
     2603           else do:
     2604             if frame Dialog-Frame :scrollable = true
     2605             then do:
     2606               assign
     2607                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2608               .
     2609             end.
     2610             assign
     2611               frame Dialog-Frame :width = v-frame-width
     2612             .
     2613             for each buf_temp-browse-handle
     2614               where buf_temp-browse-handle.browse-type = 'width':u
     2615             on error undo, next
     2616             :
     2617               assign
     2618                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2619               .
     2620             end.
     2621             assign
     2622               v-diasize-browse-handle :width = v-browse-width
     2623             .
     2624             for each buf_temp-diasize-handle
     2625             on error undo, next
     2626             :
     2627               assign
     2628                 v-object-handle = buf_temp-diasize-handle.handle-value
     2629               .
     2630               if v-object-handle <> v-diasize-resize-button
     2631               then do:
     2632                 assign
     2633                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2634                 .
     2635               end.
     2636             end.
     2637             run diasize_position-resize-button in this-procedure .
     2638           end.
     2639           assign
     2640             v-diasize-change-size = false
     2641           .
     2642           leave move_block .
     2643         end.
     2644       end.
     2645       assign
     2646         v-diasize-need-full-display = true
     2647       .
     2648       if v-diasize-change-size = false
     2649       then do:
     2650         assign
     2651           v-diasize-change-size = true
     2652         .
     2653       end.
     2654       else do:
     2655         return .
     2656       end.
     2657       assign
     2658         v-frame-width = frame Dialog-Frame :width
     2659         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2660         v-browse-width = v-diasize-browse-handle :width
     2661       .
     2662       for each buf_temp-browse-handle
     2663         where buf_temp-browse-handle.browse-type = 'width':u
     2664       :
     2665         assign
     2666           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2667         .
     2668       end.
     2669       for each buf_temp-diasize-handle
     2670       :
     2671         delete buf_temp-diasize-handle .
     2672       end.
     2673       assign
     2674         v-field-group-handle = frame Dialog-Frame :first-child
     2675       .
     2676       do while valid-handle(v-field-group-handle)
     2677       :
     2678         assign
     2679           v-object-handle = v-field-group-handle :first-child
     2680         .
     2681         do while valid-handle(v-object-handle)
     2682         :
     2683           if  v-object-handle <> v-diasize-browse-handle :handle
     2684           and v-object-handle <> v-diasize-resize-button
     2685           and can-query(v-object-handle, "row")
     2686           and can-query(v-object-handle, "height")
     2687           and ( v-object-handle :col + v-object-handle :width
     2688                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2689               )
     2690           then do:
     2691             find first buf_temp-browse-handle
     2692               where buf_temp-browse-handle.browse-type   = 'width':u
     2693                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2694               no-error .
     2695             if available buf_temp-browse-handle
     2696             then do:
     2697             end.
     2698             else do:
     2699               create buf_temp-diasize-handle .
     2700               assign
     2701                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2702                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2703               .
     2704             end.
     2705           end.
     2706           assign
     2707             v-object-handle = v-object-handle :next-sibling
     2708           .
     2709         end.
     2710         assign
     2711           v-field-group-handle = v-field-group-handle :next-sibling
     2712         .
     2713       end.
     2714       do with frame Dialog-Frame
     2715       :
     2716         hide v-diasize-resize-button .
     2717         v-diasize-resize-button :row = 1.
     2718         v-diasize-resize-button :column = 1.
     2719       end.
     2720       if p-change-value > 0
     2721       then do:
     2722         if frame Dialog-Frame :scrollable = true
     2723         then do:
     2724           assign
     2725             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2726             no-error .
     2727           if error-status :error
     2728           or error-status :get-message(1) <> ""
     2729           then do:
     2730             undo move_block, retry move_block.
     2731           end.
     2732         end.
     2733         assign
     2734           frame Dialog-Frame :width = v-frame-width + p-change-value
     2735           no-error .
     2736         if error-status :error
     2737         or error-status :get-message(1) <> ""
     2738         then do:
     2739           undo move_block, retry move_block.
     2740         end.
     2741         assign
     2742           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2743         no-error .
     2744         if error-status :error
     2745         or error-status :get-message(1) <> ""
     2746         then do:
     2747           undo move_block, retry move_block.
     2748         end.
     2749         for each buf_temp-browse-handle
     2750           where buf_temp-browse-handle.browse-type = 'width':u
     2751         on error undo move_block, retry move_block
     2752         :
     2753           assign
     2754             buf_temp-browse-handle.browse-handle :width
     2755               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2756             no-error .
     2757           if error-status :error
     2758           or error-status :get-message(1) <> ""
     2759           then do:
     2760             undo move_block, retry move_block .
     2761           end.
     2762         end.
     2763         for each buf_temp-diasize-handle
     2764         on error undo move_block, retry move_block
     2765         :
     2766           assign
     2767             v-object-handle = buf_temp-diasize-handle.handle-value
     2768           .
     2769           if v-object-handle <> v-diasize-resize-button
     2770           then do:
     2771             assign
     2772               v-object-handle :col = v-object-handle :col + p-change-value
     2773               no-error .
     2774             if error-status :error
     2775             or error-status :get-message(1) <> ""
     2776             then do:
     2777               undo move_block, retry move_block .
     2778             end.
     2779           end.
     2780         end.
     2781       end.
     2782       else do:
     2783         for each buf_temp-diasize-handle
     2784         on error undo move_block, retry move_block
     2785         :
     2786           assign
     2787             v-object-handle = buf_temp-diasize-handle.handle-value
     2788           .
     2789           if v-object-handle <> v-diasize-resize-button
     2790           then do:
     2791             assign
     2792               v-object-handle :col = v-object-handle :col + p-change-value
     2793               no-error .
     2794             if error-status :error
     2795             or error-status :get-message(1) <> ""
     2796             then do:
     2797               undo move_block, retry move_block .
     2798             end.
     2799           end.
     2800         end.
     2801         for each buf_temp-browse-handle
     2802           where buf_temp-browse-handle.browse-type = 'width':u
     2803         on error undo move_block, retry move_block
     2804         :
     2805           assign
     2806             buf_temp-browse-handle.browse-handle :width
     2807               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2808             no-error .
     2809           if error-status :error
     2810           or error-status :get-message(1) <> ""
     2811           then do:
     2812             undo move_block, retry move_block .
     2813           end.
     2814         end.
     2815         assign
     2816           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2817           no-error .
     2818         if error-status :error
     2819         or error-status :get-message(1) <> ""
     2820         then do:
     2821           undo move_block, retry move_block.
     2822         end.
     2823         assign
     2824           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2825         no-error .
     2826         if error-status :error
     2827         or error-status :get-message(1) <> ""
     2828         then do:
     2829           undo move_block, retry move_block.
     2830         end.
     2831         if frame Dialog-Frame :scrollable = true
     2832         then do:
     2833           assign
     2834             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2835           no-error .
     2836           if error-status :error
     2837           or error-status :get-message(1) <> ""
     2838           then do:
     2839             undo move_block, retry move_block.
     2840           end.
     2841         end.
     2842       end.
     2843       if p-move-resize
     2844       then do:
     2845         run diasize_position-resize-button in this-procedure .
     2846       end.
     2847       if v-diasize-wndstore = true
     2848       then do:
     2849         if connected("ub") = true
     2850         then do:
     2851           define variable v-cntxt-db-num        as integer   no-undo .
     2852           define variable v-cntxt-userid        as character no-undo .
     2853           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2854                                             , OUTPUT v-cntxt-userid
     2855                                             ) .
     2856           run gbl/wndsizew.p
     2857             (input  v-cntxt-db-num
     2858             ,input  v-cntxt-userid
     2859             ,input  v-diasize-proc-name
     2860             ,input  'width':u
     2861             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2862             ) .
     2863         end.
     2864       end.
     2865     end.
     2866     assign
     2867       v-diasize-change-size = false
     2868     .
     2869   end procedure.
     2870   procedure diasize_set-width :
     2871     define input  parameter p-new-width  as decimal   no-undo .
     2872     define input  parameter p-move-resize as logical   no-undo .
     2873     do
     2874     on error undo, return error return-value
     2875     :
     2876       run diasize_change-width in this-procedure
     2877         (input  (p-new-width - frame Dialog-Frame :width)
     2878         ,input  p-move-resize
     2879         ) .
     2880     end.
     2881   end procedure.
     2882   procedure diasize_position-resize-button :
     2883     do with frame Dialog-Frame
     2884     :
     2885       hide v-diasize-resize-button .
     2886       assign
     2887         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2888                     - 1
     2889                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2890         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2891                     - 1
     2892                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2893       .
     2894       view v-diasize-resize-button .
     2895     end.
     2896   end procedure.
     2897   on alt-right anywhere
     2898   do:
     2899     run diasize_change-width in this-procedure
     2900       (input 1
     2901       ,input true
     2902       ) .
     2903     return no-apply .
     2904   end.
     2905   on alt-left anywhere
     2906   do:
     2907     run diasize_change-width in this-procedure
     2908       (input -1
     2909       ,input true
     2910       ) .
     2911     return no-apply .
     2912   end.
     2913   on alt-down anywhere
     2914   do:
     2915     run diasize_change-height in this-procedure
     2916       (input 1
     2917       ,input true
     2918       ) .
     2919     return no-apply .
     2920   end.
     2921   on alt-up anywhere
     2922   do:
     2923     run diasize_change-height in this-procedure
     2924       (input -1
     2925       ,input true
     2926       ) .
     2927     return no-apply .
     2928   end.
     2929   on alt-enter of frame Dialog-Frame
     2930   do:
     2931     run diasize_maximize in this-procedure
     2932       (input  ?
     2933       ).
     2934     return no-apply .
     2935   end.
     2936   procedure diasize_end-move :
     2937     do
     2938     on error undo, return error return-value
     2939     :
     2940       define variable v-row-delta as decimal   no-undo .
     2941       define variable v-col-delta as decimal   no-undo .
     2942       define variable v-new-row as decimal   no-undo .
     2943       define variable v-new-col as decimal   no-undo .
     2944       assign
     2945         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2946         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2947       .
     2948       assign
     2949         v-row-delta = v-new-row - frame Dialog-Frame :height
     2950         v-col-delta = v-new-col - frame Dialog-Frame :width
     2951       .
     2952       run diasize_change-height in this-procedure
     2953         (input v-row-delta
     2954         ,input true
     2955         ) .
     2956       run diasize_change-width in this-procedure
     2957         (input v-col-delta
     2958         ,input true
     2959         ) .
     2960     end.
     2961   end procedure.
     2962   procedure diasize_maximize :
     2963     define input  parameter p-action as logical   no-undo .
     2964     do
     2965     on error undo, return error return-value
     2966     :
     2967       if p-action = ?
     2968       then do:
     2969         if v-diasize-need-maximize = true
     2970         then do:
     2971           assign
     2972             p-action = true
     2973           .
     2974         end.
     2975         else do:
     2976           assign
     2977             p-action = false
     2978           .
     2979         end.
     2980       end.
     2981       if p-action = true
     2982       then do:
     2983         run diasize_change-height in this-procedure
     2984           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2985               - frame Dialog-Frame :height-chars
     2986           ,input true
     2987           ) .
     2988         run diasize_change-width in this-procedure
     2989           (input session :width-chars
     2990               - frame Dialog-Frame :width-chars
     2991           ,input true
     2992           ) .
     2993         assign
     2994           v-diasize-need-maximize = false
     2995         .
     2996       end.
     2997       else do:
     2998         run diasize_change-width in this-procedure
     2999           (input v-diasize-orig-frame-width
     3000               - frame Dialog-Frame :width-chars
     3001           ,input true
     3002           ) .
     3003         run diasize_change-height in this-procedure
     3004           (input v-diasize-orig-frame-height
     3005               - frame Dialog-Frame :height-chars
     3006           ,input true
     3007           ) .
     3008         assign
     3009           v-diasize-need-maximize = true
     3010         .
     3011       end.
     3012     end.
     3013   end procedure.
     3014   procedure diasize_restore-orig-size :
     3015     do
     3016     on error undo, return error return-value
     3017     :
     3018       assign
     3019         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3020         v-diasize-current-frame-height = frame Dialog-Frame :height
     3021       .
     3022       run diasize_set-height in this-procedure
     3023         (input  v-diasize-orig-frame-height
     3024         ,input  true
     3025         ) .
     3026       run diasize_set-width in this-procedure
     3027         (input  v-diasize-orig-frame-width
     3028         ,input  true
     3029         ) .
     3030     end.
     3031   end procedure.
     3032   procedure diasize_restore-current-size :
     3033     do
     3034     on error undo, return error return-value
     3035     :
     3036       run diasize_set-height in this-procedure
     3037         (input  v-diasize-current-frame-height
     3038         ,input  true
     3039         ) .
     3040       run diasize_set-width in this-procedure
     3041         (input  v-diasize-current-frame-width
     3042         ,input  true
     3043         ) .
     3044     end.
     3045   end procedure.
     3046   procedure diasize_set-browse-handle :
     3047     define input  parameter p-browse-handle as handle   no-undo .
     3048     define buffer buf_temp-browse-handle for temp-browse-handle .
     3049     do
     3050     on error undo, return error return-value
     3051     :
     3052       assign
     3053         v-diasize-browse-handle = p-browse-handle
     3054       .
     3055       for each buf_temp-browse-handle
     3056       on error undo, return error return-value
     3057       :
     3058         delete buf_temp-browse-handle .
     3059       end.
     3060     end.
     3061   end procedure.
     3062   procedure diasize_add_browse :
     3063     define input  parameter p-browse-type   as character no-undo .
     3064     define input  parameter p-browse-handle as handle    no-undo .
     3065     define buffer buf_temp-browse-handle for temp-browse-handle .
     3066     do
     3067     on error undo, return error return-value
     3068     :
     3069       assign
     3070         v-diasize-browse-number = v-diasize-browse-number + 1
     3071       .
     3072       create buf_temp-browse-handle .
     3073       assign
     3074         buf_temp-browse-handle.browse-type   = p-browse-type
     3075         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3076         buf_temp-browse-handle.browse-handle = p-browse-handle
     3077       .
     3078     end.
     3079   end procedure.
     3080   procedure diasize_init :
     3081     define variable v-default-value    as logical   no-undo .
     3082     define variable v-restore-saved    as logical   no-undo .
     3083     define variable v-resize-value-str as character no-undo .
     3084     do
     3085     on error undo, return error return-value
     3086     :
     3087       do with frame Dialog-Frame
     3088       :
     3089         assign
     3090           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3091           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3092           v-diasize-browse-handle     = browse BR-gds-obj :handle
     3093         .
     3094         create button v-diasize-resize-button
     3095         assign
     3096           parent        = frame Dialog-Frame :first-child
     3097           label         = "s"
     3098           height-pixels = 16
     3099           width-pixels  = 16
     3100           visible       = true
     3101           sensitive     = true
     3102           movable       = true
     3103           triggers:
     3104             on end-move persistent run diasize_end-move in this-procedure .
     3105           end triggers.
     3106         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3107         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3108         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3109         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3110         assign
     3111           v-diasize-wndmax = false
     3112         .
     3113         if connected("ub") = true
     3114         then do:
     3115           define variable v-cntxt-db-num        as integer   no-undo .
     3116           define variable v-cntxt-userid        as character no-undo .
     3117           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3118                                             , OUTPUT v-cntxt-userid
     3119                                             ) .
     3120           run gbl/wndpar_r.p
     3121             (input  v-cntxt-db-num
     3122             ,input  v-cntxt-userid
     3123             ,input  'wndmax':U
     3124             ,output v-diasize-wndmax
     3125             ,output v-default-value
     3126             ) .
     3127         end.
     3128         assign
     3129           v-diasize-wndstore = false
     3130         .
     3131         if connected("ub") = true
     3132         then do:
     3133           run gbl/wndpar_r.p
     3134             (input  v-cntxt-db-num
     3135             ,input  v-cntxt-userid
     3136             ,input  'wndstore':U
     3137             ,output v-diasize-wndstore
     3138             ,output v-default-value
     3139             ) .
     3140         end.
     3141         assign
     3142           v-diasize-proc-name = entry(1, program-name(2), '.')
     3143         .
     3144         if v-diasize-wndstore = true
     3145         then do:
     3146           assign
     3147             v-restore-saved = false
     3148           .
     3149           if connected("ub") = true
     3150           then do:
     3151             run gbl/wndsizer.p
     3152               (input  v-cntxt-db-num
     3153               ,input  v-cntxt-userid
     3154               ,input  v-diasize-proc-name
     3155               ,input  'height':u
     3156               ,output v-resize-value-str
     3157               ) .
     3158             if v-resize-value-str <> '':U
     3159             then do:
     3160               run diasize_change-height in this-procedure
     3161                 (input  integer(v-resize-value-str)
     3162                 ,input  true
     3163                 ) .
     3164               assign
     3165                 v-restore-saved = true
     3166               .
     3167             end.
     3168           end.
     3169           if connected("ub") = true
     3170           then do:
     3171             run gbl/wndsizer.p
     3172               (input  v-cntxt-db-num
     3173               ,input  v-cntxt-userid
     3174               ,input  v-diasize-proc-name
     3175               ,input  'width':u
     3176               ,output v-resize-value-str
     3177               ) .
     3178             if v-resize-value-str <> '':U
     3179             then do:
     3180               run diasize_change-width in this-procedure
     3181                 (input  integer(v-resize-value-str)
     3182                 ,input  true
     3183                 ) .
     3184               assign
     3185                 v-restore-saved = true
     3186               .
     3187             end.
     3188           end.
     3189           if v-restore-saved <> true
     3190           then do:
     3191             if v-diasize-wndmax = true
     3192             then do:
     3193               run diasize_maximize in this-procedure
     3194                 (input  true
     3195                 ) .
     3196             end.
     3197           end.
     3198         end.
     3199         else do:
     3200           if v-diasize-wndmax = true
     3201           then do:
     3202             run diasize_maximize in this-procedure
     3203               (input  true
     3204               ) .
     3205           end.
     3206         end.
     3207       end.
     3208     end.
     3209   end procedure.
     3210   procedure diasize_need-full-display :
     3211     define output parameter p-need-full-display as logical   no-undo .
     3212     do
     3213     on error undo, return error return-value
     3214     :
     3215       assign
     3216         p-need-full-display = v-diasize-need-full-display
     3217       .
     3218       assign
     3219         v-diasize-need-full-display = false
     3220       .
     3221     end.
     3222   end procedure.
     3223   procedure get-context :
     3224      define output parameter p-db-num as integer          no-undo.
     3225      define output parameter p-user-id as character        no-undo.
     3226      define variable v-login               as character    no-undo.
     3227      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3228      define buffer buf_user-login  for ub.user-login .
     3229      do
     3230      on error undo, return error
     3231      :
     3232            FIND FIRST buf_sys-ctrl no-lock.
     3233            ASSIGN
     3234               v-login = USERID("ub")
     3235               p-db-num = buf_sys-ctrl.db-num
     3236            .
     3237            FIND FIRST buf_user-login
     3238                 WHERE buf_user-login.db-num = p-db-num
     3239                   AND buf_user-login.user-login = v-login
     3240                 no-lock
     3241                 no-error
     3242                 .
     3243            IF AVAILABLE buf_user-login
     3244            THEN DO:
     3245               assign
     3246                  p-user-id = buf_user-login.user-id
     3247               .
     3248            END.
     3249      end.
     3250   end procedure.
     3251       run diasize_init in this-procedure .
     3252   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3253   on F9 of frame Dialog-Frame anywhere do:
     3254     run init-gds-rec.
     3255     if gds-rec = ? then
     3256       return no-apply.
     3257     run ref/gds-form.w ( input parParentProc
     3258                         ,input 'ПРОСМОТР':U
     3259                         ,input ?
     3260                         ,input ?
     3261                         ,input ?
     3262                         ,input-output gds-rec).
     3263     apply "entry" to BR-goods in frame Dialog-Frame.
     3264     return no-apply.
     3265   end.
     3266   on end-error, stop of frame Dialog-Frame  do:
     3267     apply "choose" to b-exit in frame Dialog-Frame .
     3268     return no-apply.
     3269   end.
     3270   MAIN-BLOCK:
     3271   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3272      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3273          find first buf_ord-doc  exclusive-lock  where
     3274            recid(buf_ord-doc) = p-ord-doc-recid no-error .
     3275            if error-status :error then do:
     3276            message vss-workfile vss-revision vss-description skip
     3277                   "Ошибка  " skip
     3278                    skip
     3279                    error-status :get-message(1) skip
     3280                    return-value skip
     3281                    view-as alert-box error
     3282            .
     3283            return error.
     3284            end.
     3285   X_ord-line.qnty:read-only in browse br-goods = true .
     3286     run init-proc in this-procedure .
     3287     run enable_UI in this-procedure .
     3288     run openbr in this-procedure .
     3289     wait-for go of frame Dialog-Frame.
     3290   End.
     3291   run disable_UI in this-procedure .
     3292   PROCEDURE del-trn :
     3293    do
     3294    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3295    :
     3296   define buffer x_ord-doc-line-rcv for ub.ord-line-rcv.
     3297   define variable varchip-code as integer no-undo.
     3298       if available x_ord-doc-rcv then do:
     3299          find current x_ord-doc-rcv exclusive-lock no-error.
     3300               if avail x_ord-doc-rcv then do:
     3301                  for each ub.ord-chain no-lock where
     3302                         ub.ord-chain.doc-code = x_ord-doc-rcv.rcv-code and
     3303                         ub.ord-chain.doc-type = 'rcv'                  and
     3304                         ub.ord-chain.rel-doc-type = 'trn'
     3305                         :
     3306                       find first x_trn-doc  no-lock  where
     3307                             x_trn-doc.doc-code = ub.ord-chain.rel-doc-code no-error .
     3308                         if available x_trn-doc then do:
     3309                               if not ( x_trn-doc.status_ = 'запрос':U  and
     3310                                       x_trn-doc.flag_   = false )  then do :
     3311                                         message "Статус " x_trn-doc.status_   + string( x_trn-doc.flag_ , "+/-")  " удалять нельзя! "
     3312                                                 view-as alert-box error .
     3313                                                 return.
     3314                               end.
     3315                               message "Удалить накладную №"  x_trn-doc.doc-code "?" view-as alert-box
     3316                                       question buttons yes-no title "Вопрос" update g-log.
     3317                             if g-log then do:
     3318                                 run str/del-doc.p
     3319                                     ( input  parParentProc,
     3320                                       input  x_trn-doc.doc-code,
     3321                                       input  v-cntxt-db-num,
     3322                                       input  "del-doc.err",
     3323                                       input  ?,
     3324                                       input  ?,
     3325                                       input  v-cntxt-userid,
     3326                                       input  x_trn-doc.doc-code,
     3327                                       input  ?,
     3328                                       output varchip-code )
     3329                                       .
     3330                                 if x_ord-doc-rcv.status_ <> 'новый':U then do :
     3331                                     for each  x_ord-doc-line-rcv  exclusive-lock  where
     3332                                               x_ord-doc-line-rcv.doc-code = x_ord-doc-rcv.doc-code and
     3333                                               x_ord-doc-line-rcv.rcv-code = x_ord-doc-rcv.rcv-code
     3334                                               on error undo, return error :
     3335                                               delete x_ord-doc-line-rcv.
     3336                                     end.
     3337                                     assign
     3338                                       x_ord-doc-rcv.status_ = 'факт':U
     3339                                     .
     3340                                 end.
     3341                                 else do:
     3342                                   delete  x_ord-doc-rcv .
     3343                                 end.
     3344                                 run Openbr in this-procedure .
     3345                             end.
     3346                       end.
     3347                    end.
     3348                 end.
     3349                 else do:
     3350                   message "Удалить запись ?" view-as alert-box
     3351                         question buttons yes-no title "Вопрос" update g-log.
     3352                         if g-log then
     3353                           delete  x_ord-doc-rcv .
     3354                 end.
     3355     end.
     3356     end.
     3357   END PROCEDURE.
     3358   PROCEDURE disable_UI :
     3359     HIDE FRAME Dialog-Frame.
     3360   END PROCEDURE.
     3361   PROCEDURE enable_UI :
     3362     DISPLAY scr-obj-name src-obj-list-name FILL-IN-22 FILL-IN-23 src-gds-name
     3363             scr-main-num FI-all-str scr-obj FI-all-str-3 scr-all-qnty FILL-IN-26
     3364             FILL-IN-27 src-ext-doc-type
     3365         WITH FRAME Dialog-Frame.
     3366     ENABLE b-exit RECT-1 B-mark B-grp B-hand B-help BR-goods BR-gds-obj B-del
     3367            B-lkp B-chg BR-rcv BR-line-trn BR-obj-list scr-obj-name
     3368            src-obj-list-name FILL-IN-22 FILL-IN-23 src-gds-name scr-main-num
     3369            FI-all-str scr-obj FI-all-str-3 scr-all-qnty FILL-IN-26 FILL-IN-27
     3370            src-ext-doc-type
     3371         WITH FRAME Dialog-Frame.
     3372     VIEW FRAME Dialog-Frame.
     3373     OPEN QUERY BR-gds-obj FOR EACH X_gds-obj NO-LOCK where x_gds-obj.artic = x_ord-line.artic and x_gds-obj.prod-code = x_ord-line.prod-code and x_gds-obj.prod-type = x_ord-line.prod-type and x_gds-obj.host-code = p-host-code and not ( x_gds-obj.fact-qnty = 0 and x_gds-obj.free-qnty = 0 )  .    OPEN QUERY BR-goods FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.    OPEN QUERY BR-line-trn FOR EACH X_doc-line NO-LOCK where      X_doc-line.doc-code =X_trn-doc.doc-code ,        EACH buf_goods OF X_doc-line NO-LOCK.    OPEN QUERY BR-obj-list FOR EACH obj-list NO-LOCK WHERE BY obj-list.obj-code .    OPEN QUERY BR-rcv FOR EACH X_ord-doc-rcv NO-LOCK where X_ord-doc-rcv.doc-code = loc-ord-num ,        each X_ord-chain NO-LOCK where     x_ord-chain.doc-code = X_ord-doc-rcv.rcv-code and     x_ord-chain.doc-type = 'rcv'                  and     x_ord-chain.rel-doc-type = 'trn'    ,        each X_trn-doc NO-LOCK         where X_trn-doc.doc-code = x_ord-chain.rel-doc-code  .
     3374   END PROCEDURE.
     3375   PROCEDURE exit-proc :
     3376    do
     3377    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3378    :
     3379   define variable glob-gen as logical init false  no-undo .
     3380   define variable v-kk as integer no-undo .
     3381   define buffer buf_ver_ord-doc-rcv  for ub.ord-doc-rcv.
     3382   define buffer buf_ver_doc-line for ub.doc-line.
     3383   define buffer buf_ver_trn-doc  for ub.trn-doc.
     3384   define variable varchip-code as integer no-undo.
     3385   for each buf_ver_ord-doc-rcv no-lock where
     3386            buf_ver_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     3387            on error undo, return error :
     3388           v-kk = 0 .
     3389           for each ub.ord-chain no-lock where
     3390                     ub.ord-chain.doc-code = buf_ver_ord-doc-rcv.rcv-code and
     3391                     ub.ord-chain.doc-type = 'rcv'                  and
     3392                     ub.ord-chain.rel-doc-type = 'trn'
     3393                     :
     3394                 for each buf_ver_doc-line no-lock where
     3395                          buf_ver_doc-line.doc-code = ub.ord-chain.rel-doc-code
     3396                          on error undo, return error :
     3397                          v-kk = v-kk + 1 .
     3398                 end.
     3399           end.
     3400           if v-kk = 0 then do:
     3401           for each ub.ord-chain no-lock where
     3402                     ub.ord-chain.doc-code = buf_ver_ord-doc-rcv.rcv-code and
     3403                     ub.ord-chain.doc-type = 'rcv'                  and
     3404                     ub.ord-chain.rel-doc-type = 'trn'
     3405                     :
     3406              find first buf_ver_trn-doc no-lock where buf_ver_trn-doc.doc-code = ub.ord-chain.rel-doc-code no-error .
     3407              if available buf_ver_trn-doc then
     3408                 run str/del-doc.p
     3409                   ( input  parParentProc,
     3410                     input  buf_ver_trn-doc.doc-code,
     3411                     input  v-cntxt-db-num,
     3412                     input  "del-doc.err",
     3413                     input  ?,
     3414                     input  ?,
     3415                     input  v-cntxt-userid,
     3416                     input  buf_ver_trn-doc.doc-code,
     3417                     input  ?,
     3418                     output varchip-code ) .
     3419              find x_ord-doc-rcv  exclusive-lock where recid(x_ord-doc-rcv) = recid(buf_ver_ord-doc-rcv) no-error .
     3420              if available x_ord-doc-rcv then
     3421                 delete x_ord-doc-rcv.
     3422           end.
     3423           end.
     3424   end.
     3425   if buf_ord-doc.status_ = 'запрос':U and buf_ord-doc.flag_ = false  then do:
     3426       if can-find(first X_ord-doc-rcv no-lock where X_ord-doc-rcv.doc-code = buf_ord-doc.doc-code ) = true
     3427         then glob-gen = true .
     3428       if  glob-gen = true  then do:
     3429         message "Закрываем заказ до статуса " + caps( 'запрос':U ) +  "+ ? " view-as alert-box question
     3430               buttons yes-no title "" update t-log-4 .
     3431               if t-log-4 = true then do:
     3432                 run cus/ordoocls.p
     3433                   ( input parParentProc ,
     3434                     input recid(buf_ord-doc) ,
     3435                     input true )
     3436                      .
     3437               end.
     3438       end.
     3439   end.
     3440     end.
     3441   END PROCEDURE.
     3442   PROCEDURE grp-num :
     3443    do
     3444    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3445    :
     3446    define variable v-grp-recid as character no-undo .
     3447    define buffer buf_gds-grp for ub.gds-grp .
     3448    define buffer buf_goods   for ub.goods .
     3449    define buffer buf_ord-line for ub.ord-line.
     3450    rid-list = "" .
     3451    run ref/gds-grp.w ( parParentProc, "b-sel,b-mark", store-type, store-code, input-output v-grp-recid ).
     3452    if num-entries( v-grp-recid ) = 0  then do :
     3453       message "Ни чего не выбрано !"  view-as alert-box .
     3454       return .
     3455    end.
     3456   define variable v-ind as integer   no-undo .
     3457   define variable  Grp_Name as character no-undo .
     3458   define variable v-nn as integer   no-undo .
     3459   v-nn = num-entries( v-grp-recid ) .
     3460       repeat v-ind = 1 to v-nn
     3461       :
     3462         FIND buf_gds-grp no-lock  WHERE recid ( buf_gds-grp ) = integer ( Entry(v-ind,v-grp-recid )) .
     3463         run grplib-get-full-name in this-procedure( input buf_gds-grp.node-code, output Grp_Name ).
     3464               for each buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num ,
     3465                   each buf_goods no-lock where buf_goods.artic = buf_ord-line.artic   and
     3466                                       buf_goods.prod-code = buf_ord-line.prod-code   and
     3467                                       buf_goods.prod-type = buf_ord-line.prod-type   and
     3468                                       buf_goods.grp-name begins grp_name
     3469                   on error undo, return error :
     3470                   find first x_ord-line no-lock where
     3471                         recid(x_ord-line) = recid(buf_ord-line) no-error .
     3472                         if available  x_ord-line then
     3473                             apply "CHOOSE" to b-mark in frame Dialog-Frame .
     3474               end.
     3475       end.
     3476   end.
     3477   END PROCEDURE.
     3478   PROCEDURE init-gds-rec :
     3479    do
     3480    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3481    :
     3482     find current x_goods no-lock no-error .
     3483     gds-rec = recid(x_goods) .
     3484     end.
     3485   END PROCEDURE.
     3486   PROCEDURE init-proc :
     3487    do
     3488    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3489    :
     3490    find first buf_clients no-lock where
     3491               buf_clients.obj-code = buf_ord-doc.obj-code and
     3492               buf_clients.obj-type = buf_ord-doc.obj-type
     3493               no-error .
     3494               if error-status :error then do:
     3495               message vss-workfile vss-revision vss-description skip
     3496                      "Ошибка  " skip
     3497                       skip
     3498                       error-status :get-message(1) skip
     3499                       return-value skip
     3500                       view-as alert-box error
     3501               .
     3502               return error .
     3503               end.
     3504    assign
     3505     scr-obj-name     = buf_clients.obj-name
     3506     loc-ord-num      = buf_ord-doc.doc-code
     3507    .
     3508        ASSIGN frame Dialog-Frame:TITLE = frame  Dialog-Frame:TITLE + " Заказ  № " + loc-ord-num  .
     3509     for each obj-list   :
     3510        delete obj-list .
     3511     end.
     3512     for each ub.shop where ub.shop.host-code   = p-host-code:
     3513   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3514   run create_obj-list in this-procedure
     3515    ( input 'маг':U ,
     3516      input ub.shop.obj-code )
     3517     no-error .
     3518     end.
     3519     for each ub.store where ub.store.host-code  = p-host-code:
     3520   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3521   run create_obj-list in this-procedure
     3522    ( input 'скл':U ,
     3523      input ub.store.obj-code )
     3524     no-error .
     3525     end.
     3526   run main-ord (  input loc-ord-num  ,  output scr-main-num  ) .
     3527   define variable par-type     as char no-undo.
     3528   define variable v-value-character  as character no-undo .
     3529   define variable v-value-date       as date      no-undo .
     3530   define variable v-value-decimal    as decimal   no-undo .
     3531   define variable v-value-integer    as integer   no-undo .
     3532   run adm/shattri.p (
     3533     input "get":U
     3534     ,input ""
     3535     ,input 0
     3536     ,input 'ord-global':U
     3537     ,input 'ord-oobj':U
     3538     ,output v-value-character
     3539     ,output v-value-date
     3540     ,output v-value-decimal
     3541     ,output v-value-integer
     3542     ,output par-ord-oobj
     3543     ,output par-type
     3544     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3545     ) no-error .
     3546     if error-status :error then par-ord-oobj = false .
     3547     end.
     3548   END PROCEDURE.
     3549   PROCEDURE main-ord :
     3550    do
     3551    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3552    :
     3553   define input parameter   p-in-ord-num as character no-undo .
     3554   define output parameter  p-out-ord-num as character no-undo .
     3555   if num-entries(p-in-ord-num , "." ) = 1 then
     3556      p-out-ord-num = p-in-ord-num .
     3557      else do:
     3558        p-out-ord-num = entry(1, entry( 1 , p-in-ord-num , "." ) , "-" )  + "-" + entry( 2 , p-in-ord-num , "."  ) .
     3559      end.
     3560     end.
     3561   END PROCEDURE.
     3562   PROCEDURE make-rcv :
     3563    do
     3564    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3565    :
     3566   define input parameter p-cli-type as character no-undo .
     3567   define input parameter p-cli-code as integer no-undo .
     3568   define output parameter  r-rec as recid no-undo.
     3569   define variable l-recid as recid no-undo.
     3570   define variable v-root-node as integer no-undo .
     3571   define variable ks          as  integer no-undo .
     3572   define variable loc-rcv-num as  character no-undo .
     3573   define variable ii          as  integer no-undo .
     3574   define buffer   b-goods     for ub.goods .
     3575   define buffer   bfp-ord-doc for ub.ord-doc .
     3576   define buffer   buf2-ord-line-rcv for ub.ord-line-rcv.
     3577   define buffer   buf2-ord-doc-rcv  for ub.ord-doc-rcv .
     3578   define buffer   buf2-doc-line     for ub.doc-line     .
     3579   define buffer   buf_gds-obj       for ub.gds-obj.
     3580   define variable last-all-rcv as decimal no-undo .
     3581   define buffer buf_ord-doc-rcv  for  ub.ord-doc-rcv.
     3582   define buffer buf_ord-line     for ub.ord-line.
     3583   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
     3584   define buffer buf_ord-dtl-rcv  for ub.ord-dtl-rcv.
     3585   ks = 0.
     3586   define variable v-i-doc as character no-undo .
     3587   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3588   run proc-ord-code in this-procedure
     3589    (input   'main' ,
     3590     input   v-cntxt-db-num ,
     3591     input   v-cntxt-obj-type ,
     3592     input   v-cntxt-obj-code ,
     3593     input   v-i-doc ,
     3594     output  loc-rcv-num
     3595    ) .
     3596     find first bfp-ord-doc where bfp-ord-doc.doc-code = loc-ord-num no-lock no-error.
     3597          if error-status :error  then return.
     3598      if not( bfp-ord-doc.status_  = 'запрос':U and
     3599              bfp-ord-doc.flag_    = false  )
     3600      then do:
     3601           message "Нелязя делать ЗАПРОС по   Заказу в статусе " caps(bfp-ord-doc.status_) string(bfp-ord-doc.flag_,"+/-") " !"
     3602                    view-as alert-box information .
     3603           return.
     3604      end.
     3605   create buf_ord-doc-rcv.
     3606   buffer-copy bfp-ord-doc to buf_ord-doc-rcv
     3607      assign
     3608         buf_ord-doc-rcv.rcv-code  = loc-rcv-num
     3609         buf_ord-doc-rcv.doc-type  = 'запрос':U
     3610         buf_ord-doc-rcv.doc-date  = today
     3611         buf_ord-doc-rcv.status_   = 'новый':U
     3612         buf_ord-doc-rcv.cli-code = p-cli-code
     3613         buf_ord-doc-rcv.cli-type = p-cli-type
     3614      .
     3615      for each buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  and
     3616          lookup( string( recid( buf_ord-line ) ) , rid-list ) > 0   :
     3617           ks = ks + 1 .
     3618           if not can-find  (first buf_ord-line-rcv where
     3619             buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code and
     3620             buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code and
     3621             buf_ord-line-rcv.artic     = buf_ord-line.artic and
     3622             buf_ord-line-rcv.prod-code = buf_ord-line.prod-code and
     3623             buf_ord-line-rcv.prod-type = buf_ord-line.prod-type no-lock ) then do:
     3624             last-all-rcv = 0 .
     3625           for each buf2-ord-line-rcv where
     3626             buf2-ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code and
     3627             buf2-ord-line-rcv.artic     = buf_ord-line.artic and
     3628             buf2-ord-line-rcv.prod-code = buf_ord-line.prod-code and
     3629             buf2-ord-line-rcv.prod-type = buf_ord-line.prod-type no-lock ,
     3630               first buf2-ord-doc-rcv no-lock where
     3631                      buf2-ord-doc-rcv.rcv-code =  buf2-ord-line-rcv.rcv-code and
     3632                      buf2-ord-doc-rcv.doc-code =  buf2-ord-line-rcv.doc-code    ,
     3633              each ub.ord-chain no-lock where
     3634                       ub.ord-chain.doc-code = buf2-ord-doc-rcv.rcv-code and
     3635                       ub.ord-chain.doc-type = 'rcv'                  and
     3636                       ub.ord-chain.rel-doc-type = 'trn' ,
     3637               first buf2-doc-line no-lock where
     3638                      buf2-doc-line.doc-code     =  ub.ord-chain.rel-doc-code  and
     3639                      buf2-doc-line.artic        =  buf2-ord-line-rcv.artic    and
     3640                      buf2-doc-line.prod-code    =  buf2-ord-line-rcv.prod-code and
     3641                      buf2-doc-line.prod-type    =  buf2-ord-line-rcv.prod-type
     3642                :
     3643                 last-all-rcv =  last-all-rcv + buf2-doc-line.fact-qnty .
     3644           end.
     3645   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3647     (input  buf_ord-line.artic
     3648     ,input  buf_ord-line.prod-type
     3649     ,input  buf_ord-line.prod-code
     3650     ,output v-root-node
     3651     )  .
     3652            create buf_ord-line-rcv.
     3653            buffer-copy buf_ord-line to buf_ord-line-rcv
     3654            assign
     3655              buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
     3656              buf_ord-line-rcv.line-num  = ks
     3657              buf_ord-line-rcv.qnty      = if (buf_ord-line.qnty - last-all-rcv) < 0 then 0
     3658                                                                                     else  (buf_ord-line.qnty - last-all-rcv)
     3659              buf_ord-line-rcv.cli-qnty  = buf_ord-line-rcv.qnty / buf_ord-line-rcv.cli-base-rate
     3660            .
     3661            if par-ord-oobj  = true then do :
     3662                 find first buf_gds-obj no-lock
     3663                         where buf_gds-obj.artic     = buf_ord-line.artic and
     3664                               buf_gds-obj.prod-code = buf_ord-line.prod-code and
     3665                               buf_gds-obj.prod-type = buf_ord-line.prod-type and
     3666                               buf_gds-obj.obj-code  = buf_ord-doc-rcv.cli-code and
     3667                               buf_gds-obj.obj-type  = buf_ord-doc-rcv.cli-type and
     3668                               buf_gds-obj.host-code = p-host-code no-error .
     3669                 if available buf_gds-obj and buf_gds-obj.free-qnty > 0 then do:
     3670                     if buf_ord-line-rcv.qnty > buf_gds-obj.free-qnty then do:
     3671                         assign
     3672                           buf_ord-line-rcv.qnty = buf_gds-obj.free-qnty
     3673                         .
     3674                     end.
     3675                     buf_ord-line-rcv.cli-qnty  = buf_ord-line-rcv.qnty / buf_ord-line-rcv.cli-base-rate    .
     3676                 end.
     3677                 else do:
     3678                   assign
     3679                       buf_ord-line-rcv.qnty = 0
     3680                       buf_ord-line-rcv.cli-qnty = 0
     3681                   .
     3682                 end.
     3683            end.
     3684            create buf_ord-dtl-rcv.
     3685            buffer-copy buf_ord-line-rcv to buf_ord-dtl-rcv
     3686               assign
     3687                 buf_ord-dtl-rcv.node-code = v-root-node
     3688               .
     3689               define variable l-terminal-prt as logical   no-undo .
     3690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3691     (input  buf_ord-dtl-rcv.node-code
     3692     ,input  'terminal-prt=request':u
     3693     ,output l-terminal-prt
     3694     )  .
     3695            if not l-terminal-prt then do:
     3696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3697     (input  buf_ord-dtl-rcv.node-code
     3698     ,output buf_ord-dtl-rcv.node-code
     3699     )  .
     3700            end.
     3701            l-recid = recid(buf_ord-line-rcv).
     3702            end.
     3703   end.
     3704   if ks > 0 then do:
     3705       r-rec = recid(buf_ord-doc-rcv).
     3706       run cus/ord-trnz.p (parParentProc ,
     3707                       input r-rec ,
     3708                       input 'при':U,
     3709                       input "" ) no-error .
     3710       if error-status :error then do:
     3711         message vss-workfile vss-revision vss-description skip
     3712                "Ошибка ord-trnz.p " skip
     3713                 skip
     3714                 error-status :get-message(1) skip
     3715                 return-value skip
     3716                 view-as alert-box error
     3717         .
     3718         delete buf_ord-doc-rcv .
     3719         return error .
     3720       end.
     3721      end.
     3722    else do:
     3723      find first buf_ord-doc-rcv where buf_ord-doc-rcv.rcv-code  = loc-ord-num  exclusive-lock  .
     3724      delete buf_ord-doc-rcv .
     3725      r-rec = ?.
     3726   end.
     3727   rid-list = "" .
     3728   end.
     3729   END PROCEDURE.
     3730   PROCEDURE make-rcv-avto :
     3731    do
     3732    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3733    :
     3734     end.
     3735   END PROCEDURE.
     3736   PROCEDURE make-trn-doc :
     3737    do
     3738    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3739    :
     3740   define variable p-recid as recid no-undo .
     3741   run waitfram-show in this-procedure ("Формирование связки заказ - запрос....") .
     3742   if r-gener = 1 then do:
     3743       run make-rcv in this-procedure (
     3744         input obj-list.obj-type ,
     3745         input obj-list.obj-code ,
     3746         output p-recid )
     3747         .
     3748    end.
     3749   OPEN QUERY BR-rcv FOR EACH X_ord-doc-rcv NO-LOCK where X_ord-doc-rcv.doc-code = loc-ord-num ,        each X_ord-chain NO-LOCK where     x_ord-chain.doc-code = X_ord-doc-rcv.rcv-code and     x_ord-chain.doc-type = 'rcv'                  and     x_ord-chain.rel-doc-type = 'trn'    ,        each X_trn-doc NO-LOCK         where X_trn-doc.doc-code = x_ord-chain.rel-doc-code  .
     3750     apply "VALUE-CHANGED" TO BR-rcv IN FRAME Dialog-Frame.
     3751     apply "entry" TO BR-rcv IN FRAME Dialog-Frame.
     3752   OPEN QUERY BR-line-trn FOR EACH X_doc-line NO-LOCK where      X_doc-line.doc-code =X_trn-doc.doc-code ,        EACH buf_goods OF X_doc-line NO-LOCK.
     3753   run waitfram-hide in this-procedure .
     3754     end.
     3755   END PROCEDURE.
     3756   PROCEDURE openbr :
     3757     OPEN QUERY BR-gds-obj FOR EACH X_gds-obj NO-LOCK where x_gds-obj.artic = x_ord-line.artic and x_gds-obj.prod-code = x_ord-line.prod-code and x_gds-obj.prod-type = x_ord-line.prod-type and x_gds-obj.host-code = p-host-code and not ( x_gds-obj.fact-qnty = 0 and x_gds-obj.free-qnty = 0 )  .    OPEN QUERY BR-goods FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.    OPEN QUERY BR-line-trn FOR EACH X_doc-line NO-LOCK where      X_doc-line.doc-code =X_trn-doc.doc-code ,        EACH buf_goods OF X_doc-line NO-LOCK.    OPEN QUERY BR-obj-list FOR EACH obj-list NO-LOCK WHERE BY obj-list.obj-code .    OPEN QUERY BR-rcv FOR EACH X_ord-doc-rcv NO-LOCK where X_ord-doc-rcv.doc-code = loc-ord-num ,        each X_ord-chain NO-LOCK where     x_ord-chain.doc-code = X_ord-doc-rcv.rcv-code and     x_ord-chain.doc-type = 'rcv'                  and     x_ord-chain.rel-doc-type = 'trn'    ,        each X_trn-doc NO-LOCK         where X_trn-doc.doc-code = x_ord-chain.rel-doc-code  .
     3758     apply "VALUE-CHANGED" TO BR-goods IN FRAME Dialog-Frame.
     3759     apply "VALUE-CHANGED" TO BR-gds-obj IN FRAME Dialog-Frame.
     3760     apply "VALUE-CHANGED" TO BR-rcv IN FRAME Dialog-Frame.
     3761     apply "VALUE-CHANGED" TO BR-obj-list IN FRAME Dialog-Frame.
     3762     apply "entry" TO BR-gds-obj IN FRAME Dialog-Frame.
     3763   END PROCEDURE.
     3764   PROCEDURE proc-gds-obj :
     3765    do
     3766    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3767    :
     3768   define buffer buf_all-ord-doc for ub.ord-doc .
     3769   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv .
     3770   define buffer buf_ord-line-rcv for ub.ord-line-rcv .
     3771   define buffer buf_doc-line          for ub.doc-line .
     3772   define buffer buf_trn-doc for ub.trn-doc.
     3773   define variable temp-number as character no-undo .
     3774   define variable v-doc-rec as recid no-undo .
     3775   scr-obj = "" .
     3776    if not available x_gds-obj then return.
     3777      find current obj-list no-error .
     3778      if available  obj-list then do:
     3779         v-doc-rec = recid(obj-list) .
     3780         reposition br-obj-list to recid v-doc-rec no-error .
     3781         apply "value-changed" to br-obj-list in frame Dialog-Frame .
     3782         apply "entry" to br-obj-list in frame Dialog-Frame    .
     3783         scr-obj = obj-list.obj-type + " " + string(obj-list.obj-code) .
     3784         scr-all-qnty = 0.
     3785             for each buf_all-ord-doc no-lock
     3786                 where buf_all-ord-doc.doc-code begins entry( 1 , loc-ord-num , "-" ) and
     3787                       buf_all-ord-doc.obj-type =  store-type and
     3788                       buf_all-ord-doc.obj-code =  store-code
     3789                 on error undo, return error :
     3790                   run main-ord in this-procedure (  input buf_all-ord-doc.doc-code  ,  output  temp-number ) .
     3791                   if temp-number <> scr-main-num then next .
     3792                   for each buf_ord-line-rcv no-lock
     3793                       where buf_ord-line-rcv.doc-code  = buf_all-ord-doc.doc-code  and
     3794                             buf_ord-line-rcv.artic     = x_gds-obj.artic     and
     3795                             buf_ord-line-rcv.prod-type = x_gds-obj.prod-type and
     3796                             buf_ord-line-rcv.prod-code = x_gds-obj.prod-code
     3797                             on error undo, return error :
     3798                             find first buf_ord-doc-rcv no-lock where
     3799                                       buf_ord-doc-rcv.rcv-code  = buf_ord-line-rcv.rcv-code  and
     3800                                       buf_ord-doc-rcv.doc-code  = buf_ord-line-rcv.doc-code  no-error .
     3801                                       if error-status :error then return error .
     3802                             for each ub.ord-chain no-lock where
     3803                                       ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     3804                                       ub.ord-chain.doc-type = 'rcv'                  and
     3805                                       ub.ord-chain.rel-doc-type = 'trn'
     3806                                       :
     3807                                     find first buf_trn-doc no-lock where
     3808                                             buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code  and
     3809                                             buf_trn-doc.doc-type = 'при':U           and
     3810                                             buf_trn-doc.cli-type =  x_gds-obj.obj-type and
     3811                                             buf_trn-doc.cli-code =  x_gds-obj.obj-code no-error .
     3812                                   if not available buf_trn-doc then next.
     3813                                   find first buf_doc-line no-lock where
     3814                                             buf_doc-line.doc-code  = buf_trn-doc.doc-code  and
     3815                                             buf_doc-line.artic     = buf_ord-line-rcv.artic     and
     3816                                             buf_doc-line.prod-type = buf_ord-line-rcv.prod-type and
     3817                                             buf_doc-line.prod-code = buf_ord-line-rcv.prod-code
     3818                                             no-error .
     3819                                   if available buf_doc-line then do:
     3820                                     scr-all-qnty  = scr-all-qnty  + buf_doc-line.fact-qnty .
     3821                                   end.
     3822                             end.
     3823                   end.
     3824             end.
     3825      end.
     3826   display scR-obj scr-all-qnty  with frame Dialog-Frame.
     3827     end.
     3828   END PROCEDURE.
     3829   FUNCTION f-zapr-qnty RETURNS decimal
     3830     ( buffer buf_ord-line for ub.ord-line ) :
     3831   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv .
     3832   define buffer buf_ord-line-rcv for ub.ord-line-rcv .
     3833   define buffer buf_doc-line     for ub.doc-line .
     3834   define buffer buf_trn-doc      for ub.trn-doc  .
     3835   define variable  res as decimal no-undo init 0 .
     3836   for each buf_ord-line-rcv no-lock
     3837       where buf_ord-line-rcv.doc-code  = buf_ord-line.doc-code  and
     3838             buf_ord-line-rcv.artic     = buf_ord-line.artic     and
     3839             buf_ord-line-rcv.prod-type = buf_ord-line.prod-type and
     3840             buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     3841             on error undo, return error :
     3842             find first buf_ord-doc-rcv no-lock where
     3843                       buf_ord-doc-rcv.rcv-code  = buf_ord-line-rcv.rcv-code  and
     3844                       buf_ord-doc-rcv.doc-code  = buf_ord-line-rcv.doc-code  no-error .
     3845                       if error-status :error then next.
     3846             for each ub.ord-chain no-lock where
     3847                      ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     3848                      ub.ord-chain.doc-type = 'rcv'                    and
     3849                      ub.ord-chain.rel-doc-type = 'trn'
     3850                      :
     3851             find first buf_trn-doc no-lock  where
     3852                        buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code  and
     3853                        buf_trn-doc.doc-type = 'при':U and
     3854                        buf_trn-doc.status_  = 'запрос':U
     3855                        no-error .
     3856             if not available buf_trn-doc then next .
     3857             find first buf_doc-line no-lock where
     3858                        buf_doc-line.doc-code = ub.ord-chain.rel-doc-code  and
     3859                        buf_doc-line.artic     = buf_ord-line.artic       and
     3860                        buf_doc-line.prod-type = buf_ord-line.prod-type   and
     3861                        buf_doc-line.prod-code = buf_ord-line.prod-code   no-error .
     3862                        if error-status :error then next .
     3863             res  = res  + buf_doc-line.fact-qnty .
     3864            end.
     3865   end.
     3866     RETURN res .
     3867   END FUNCTION.
     3868   FUNCTION mark-string RETURNS CHARACTER
     3869   (buffer fl for x_ord-line, input m as char):
     3870   if lookup(string(recid(fl)),m) > 0 then return chr(42).
     3871   else return chr(32).
     3872   END FUNCTION.
