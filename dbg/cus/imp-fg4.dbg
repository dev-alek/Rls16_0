        1   block-level on error undo, throw.
        2   define input  parameter file-name as char no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: imp-fg4.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: cus/imp-fg4.p $":U .
        8   define variable vss-description as character no-undo init "Экспорт в файл для последующей закачки из него в приходный документ ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define buffer buf_goods for ub.goods .
       68   define stream txt-temp.
       69   define stream imp.
       70   define stream err.
       71   define variable text-string        as    char no-undo .
       72   define variable glog as logical no-undo .
       73   define variable f-name     as character no-undo .
       74   DEF VAR loc-ref-list      as    char no-undo .
       75   define variable i-price         like doc-line.price-cli     no-undo.
       76   DEF var impc as integer No-UNDO.
       77   DEF var imp-save as integer No-UNDO.
       78   DEF var i-qnty AS DEC NO-UNDO.
       79   DEF var i-scale as char no-undo.
       80   DEF var i-prod-bc as char no-undo.
       81   DEF var i-artic as char no-undo.
       82   DEF var i-prod-code like goods.prod-code  no-undo.
       83   DEFINE VAR  N-param AS DEC NO-UNDO.
       84   DEF var i-t1 as char no-undo.
       85   DEF var i-t2 as char no-undo.
       86   DEF var i-t3 as char no-undo.
       87   system-dialog get-file f-name
       88       TITLE "Экспорт в файл для последующей загрузки в приходный документ"
       89     filters "Файл для экспорта (*.adb) " "*.adb"
       90     ask-overwrite
       91     save-as
       92     use-filename
       93     update glog
       94     default-extension "adb".
       95   if not glog then return.
       96   if trim(f-name) = "" then do:
       97        message "Не задан файл для экспорта". pause.
       98        return.
       99   end.
      100   input stream imp from value (file-name) .
      101   repeat:
      102         text-string = "".
      103         IMPORT stream imp UNFORMATTED text-string NO-ERROR.
      104         if trim(text-string) = "" then leave.
      105         impc = impc + 1.
      106         if num-entries (text-string, ";") <> 24 then do:
      107           N-param = num-entries (text-string, ";").
      108           OUTPUT stream Err TO value ("Imp_Doc.err") append.
      109              put stream Err unformatted
      110                string(today, "99/99/9999") " "
      111                string(time, "HH:MM")
      112                " Неправильное число параметров в строке, должно быть 22, а у вас " N-param skip.
      113              export stream  Err text-string .
      114           output stream Err close.
      115           next.
      116         end.
      117         IF trim(ENTRY( 9, text-string, ";")) = "Article name" THEN NEXT.
      118         display
      119                    impc  label "Прочитано"
      120                    imp-save label "Сохранено"
      121                    i-artic format "x(10)" label "Артикул"
      122                    text-string format "x(40)" label "Строка файла"
      123            with frame ff view-as dialog-box
      124         title ": Импорт справочника товаров из файла".
      125         pause 0.
      126         IF trim(ENTRY( 9, text-string, ";")) = "" THEN DO:
      127              OUTPUT stream Err TO value ("Imp_Doc.err") append.
      128                 put stream Err unformatted
      129                   string(today, "99/99/9999") " "
      130                   string(time, "HH:MM")
      131                   " Не задан артикул товара, см. строку " impc skip.
      132                 export stream  Err text-string .
      133              output stream Err close.
      134              next.
      135         end.
      136         i-t1 = ENTRY( 17, text-string, ";").
      137         REPEAT:
      138            IF INDEX(i-t1, " ") = 0 THEN LEAVE.
      139            i-t2 = SUBSTRING ( i-t1, 1 , INDEX(i-t1, " ") - 1).
      140            i-t3 = SUBSTRING ( i-t1, INDEX(i-t1, " ") + 1).
      141            i-t1 = i-t2 + i-t3.
      142         END.
      143         IF INDEX(i-t1, ",") <> 0 THEN DO:
      144           ASSIGN
      145             i-t2 = SUBSTRING ( i-t1, 1 , INDEX(i-t1, ",") - 1).
      146             i-t3 = SUBSTRING ( i-t1, INDEX(i-t1, ",") + 1).
      147             i-t1 = i-t2 + "." + i-t3.
      148         END.
      149         i-price = dec(i-t1).
      150         i-t1  = ENTRY( 18, text-string, ";").
      151         REPEAT:
      152            IF INDEX(i-t1, " ") = 0 THEN LEAVE.
      153            i-t2 = SUBSTRING ( i-t1, 1 , INDEX(i-t1, " ") - 1).
      154            i-t3 = SUBSTRING ( i-t1, INDEX(i-t1, " ") + 1).
      155            i-t1 = i-t2 + i-t3.
      156         END.
      157         IF INDEX(i-t1, ",") <> 0 THEN DO:
      158           ASSIGN
      159             i-t2 = SUBSTRING ( i-t1, 1 , INDEX(i-t1, ",") - 1).
      160             i-t3 = SUBSTRING ( i-t1, INDEX(i-t1, ",") + 1).
      161             i-t1 = i-t2 + "." + i-t3.
      162         END.
      163         i-qnty = dec(i-t1).
      164         assign
      165               i-artic = trim(ENTRY( 9, text-string, ";") + "-" + ENTRY( 10, text-string, ";"))
      166               i-prod-code = dec(ENTRY( 22, text-string, ";"))
      167               i-scale = ENTRY( 11, text-string, ";") + "/" + ENTRY( 13, text-string, ";")
      168               i-prod-bc = ENTRY( 19, text-string, ";")
      169         .
      170         DISP i-artic i-prod-bc i-price i-qnty (i-price / i-qnty). PAUSE.
      171         ASSIGN i-price = i-price / i-qnty.
      172         find first goods where
      173           goods.prod-type = "орг" and
      174           goods.prod-code = i-prod-code and
      175           goods.artic     = i-artic
      176         no-lock no-error.
      177         if not avail goods then do:
      178              OUTPUT stream Err TO value ("Imp_Doc.err") append.
      179                 put stream Err unformatted
      180                   string(today, "99/99/9999") " "
      181                   string(time, "HH:MM")
      182                   " Товар не найден в справочнике товаров, см. строку " impc skip.
      183                 export stream  Err text-string .
      184              output stream Err close.
      185              next.
      186         end.
      187         if i-price <= 0 or i-price = ? then do:
      188              OUTPUT stream Err TO value ("Imp_Doc.err") append.
      189                 put stream Err unformatted
      190                   string(today, "99/99/9999") " "
      191                   string(time, "HH:MM")
      192                   " У товара нет цены, см. строку " impc skip.
      193                 export stream  Err text-string .
      194              output stream Err close.
      195              next.
      196         end.
      197         OUTPUT stream txt-temp TO value (f-name) append.
      198         put stream txt-temp  unformatted
      199                     "SCALE:" +
      200                     trim(i-artic) + ";" + string(i-prod-code) + ";" +
      201                     trim(i-scale) + ";;" +
      202                     trim(i-prod-bc) + ";" +
      203                     trim(string(i-price)) + ";" +
      204                     trim(string(i-qnty)) + ";;;;;;;;;"
      205         skip.
      206         output stream txt-temp close.
      207         imp-save = imp-save + 1.
      208   end.
      209   input stream imp close.
      210   message ("Экспорт из файла " + file-name + " закончен, прочитано " + string(impc) +
      211            ",  сохранено в файле " + string(imp-save)  + "строк" ) skip
      212            "Все строки из файла которые не удалось импортировать можно посмотреть в файле Imp_Doc.err "
      213   view-as alert-box  INFORMATION.
