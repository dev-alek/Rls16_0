     4360        b-exit:column = 1.
     4361     end.
     4362        loc-line-rcv.price-cli:label in frame Dialog-Frame = "Цена пост. (" + abbr-cli + ")" .
     4363        loc-line-rcv.price-rubl:label in frame Dialog-Frame ="Цена (руб) " .
