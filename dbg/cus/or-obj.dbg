      992             FGCOLOR 4
      993        loc-type-doc AT ROW 2.25 COL 4 COLON-ALIGNED
      994        loc-doc-rcv.doc-code AT ROW 2.25 COL 18.5 COLON-ALIGNED
      995             LABEL "Заказ №"
      996              VIEW-AS TEXT
      997             SIZE 15 BY .63
      998             FGCOLOR 4
      999        post_obj-name AT ROW 3 COL 29.25 COLON-ALIGNED NO-LABEL
     1000        obj_obj-name AT ROW 4.17 COL 29.25 COLON-ALIGNED NO-LABEL
     1001        abbr-base AT ROW 7 COL 10.5 COLON-ALIGNED
     1002        loc-doc-rcv.base-rate AT ROW 7 COL 15 COLON-ALIGNED NO-LABEL
