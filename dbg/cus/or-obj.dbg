      474   procedure create-chain :
      475   define input  parameter p-doc-code as character no-undo .
      476   define input  parameter p-doc-type as character no-undo .
      477   define input  parameter p-rel-doc-code as character no-undo .
      478   define input  parameter p-rel-doc-type as character no-undo .
      479   define input  parameter p-type as character no-undo .
      480   define input  parameter p-ps as character no-undo .
      481   define variable v-db-num as integer   no-undo .
      482     do
      483     on error undo, return error return-value
      484     :
      485     find first ub.sys-ctrl no-lock .
      486     v-db-num = ub.sys-ctrl.db-num .
      487     find first ub.ord-chain no-lock where
      488       ub.ord-chain.doc-code     = p-doc-code     and
      489       ub.ord-chain.doc-type     = p-doc-type     and
      490       ub.ord-chain.rel-type     = p-type         and
      491       ub.ord-chain.rel-doc-code = p-rel-doc-code and
      492       ub.ord-chain.rel-doc-type = p-rel-doc-type   no-error .
      493     if available ub.ord-chain then return .
      494     create ub.ord-chain.
      495     assign
      496       ub.ord-chain.doc-code     = p-doc-code
      497       ub.ord-chain.doc-type     = p-doc-type
      498       ub.ord-chain.ps           = p-ps
      499       ub.ord-chain.rel-doc-code = p-rel-doc-code
      500       ub.ord-chain.rel-doc-type = p-rel-doc-type
      501       ub.ord-chain.rel-id       = next-value( s-ord-ch, ub )
      502       ub.ord-chain.db-num       = v-db-num
      503       ub.ord-chain.rel-type     = p-type
      504       .
      505     end.
      506   end procedure.
      507   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      511   define variable par-type          as character no-undo.
      512   define variable v-value-character as character no-undo .
      513   define variable v-value-date      as date      no-undo .
      514   define variable v-value-decimal   as decimal   no-undo .
      515   define variable v-value-integer   as integer   no-undo .
      516   define variable v-value-logical   as logical   no-undo .
      517   procedure ver-qnty-rcv-from-ord :
      518   define input  parameter p-ord-doc as character no-undo .
      519   define output parameter p-is-lim as logical    no-undo .
      520   define buffer buf_ord-doc     for ub.ord-doc      .
      521   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      522   define variable v-kol as integer   no-undo .
      523   define variable v-ver as logical   no-undo .
      524     do
      525     on error undo, return error return-value
      526     :
      527      p-is-lim = false .
      528     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = p-ord-doc no-error .
      529     if buf_ord-doc.doc-type <> 'ОП':U then return .
      530   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   empty temp-table thbjattr_thbj-attr.
      532   run adm/shattri.p (
      533      input "get":U
      534     ,input buf_ord-doc.obj-type
      535     ,input buf_ord-doc.obj-code
      536     ,input 'ord-obj':U
      537     ,input  ""
      538     ,output v-value-character
      539     ,output v-value-date
      540     ,output v-value-decimal
      541     ,output v-value-integer
      542     ,output v-value-logical
      543     ,output par-type
      544     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      545     ) no-error .
      546     for each thbjattr_thbj-attr :
      547         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
      548     end.
      549   v-kol = 0.
      550     if v-ver then do:
      551        for each buf_ord-doc-rcv no-lock where
      552                 buf_ord-doc-rcv.doc-code = p-ord-doc :
      553          v-kol = v-kol + 1.
      554          leave.
      555        end.
      556      if v-kol > 0 then p-is-lim = true .
      557     end.
      558   end.
      559   end procedure.
      560   procedure ver-qnty-trn-from-rcv :
      561   define input  parameter p-rcv-code as character no-undo .
      562   define output parameter p-is-lim as logical   no-undo .
      563   define buffer buf_ord-doc for ub.ord-doc  .
      564   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      565   define buffer buf_ord-chain for ub.ord-chain .
      566   define buffer buf_trn-doc for ub.trn-doc  .
      567   define variable v-kol as integer   no-undo .
      568   define variable v-ver as logical   no-undo .
      569     do
      570     on error undo, return error return-value
      571     :
      572      p-is-lim = false .
      573     find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.rcv-code = p-rcv-code no-error .
      574     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
      575     if buf_ord-doc.doc-type <> 'ОП':U then return .
      576   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   empty temp-table thbjattr_thbj-attr.
      578   run adm/shattri.p (
      579      input "get":U
      580     ,input buf_ord-doc.obj-type
      581     ,input buf_ord-doc.obj-code
      582     ,input 'ord-obj':U
      583     ,input  ""
      584     ,output v-value-character
      585     ,output v-value-date
      586     ,output v-value-decimal
      587     ,output v-value-integer
      588     ,output v-value-logical
      589     ,output par-type
      590     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      591     ) no-error .
      592     for each thbjattr_thbj-attr :
      593         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
      594     end.
      595       if v-ver then do:
      596       v-kol = 0.
      597           for each buf_ord-chain no-lock where
      598                   buf_ord-chain.doc-code = p-rcv-code and
      599                   buf_ord-chain.doc-type = 'rcv' and
      600                   buf_ord-chain.rel-doc-type = 'trn' ,
      601               first buf_trn-doc NO-LOCK where
      602                     buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code
      603                     :
      604               v-kol = v-kol + 1.
      605               leave.
      606           end.
      607           if v-kol > 0 then p-is-lim = true .
      608       end.
      609     end.
      610   end procedure.
