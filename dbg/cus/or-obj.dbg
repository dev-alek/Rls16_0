      666   define variable v-point-cli-db-num   as integer   no-undo .
      667   define variable v-transport-host-code     as integer   no-undo .
      668   define variable v-transport-cli-type     as character no-undo .
      669   define variable v-transport-cli-code   as integer   no-undo .
      670   define variable v-transport-contract   as integer   no-undo .
