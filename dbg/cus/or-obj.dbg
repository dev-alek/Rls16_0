     2285   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2286   procedure minbtn-set :
     2287       do
     2288           on error undo, return error return-value
     2289           :
     2290           define variable ii              as integer       no-undo .
     2291           define variable fh              as widget-handle no-undo .
     2292           define variable hh              as widget-handle no-undo .
     2293           define variable v-h             as handle        extent 4 no-undo .
     2294           define variable v-name-button   as character     no-undo .
     2295           define variable v-help-old-x    as decimal       no-undo .
     2296           define variable v-help-old-y    as decimal       no-undo .
     2297           define variable v-help-old-size as decimal       no-undo .
     2298           define variable v-frame-width   as decimal       no-undo .
     2299           define variable jj              as integer       no-undo .
     2300           do
     2301               on error undo, return error
     2302               :
     2303               assign
     2304                   v-frame-width = frame Dialog-Frame:width - 0.3
     2305                   fh            = frame Dialog-Frame:first-child
     2306                   hh            = fh:first-child
     2307                   ii            = 1
     2308                   .
     2309               do while valid-handle(hh):
     2310                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2311                   do:
     2312                       case lc(hh:name) :
     2313                           when "b-help" then
     2314                               do:
     2315                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2316                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2317                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2318                                   hh:TOOLTIP = "Помощь" .
     2319                                   v-help-old-x = hh:column .
     2320                                   v-help-old-y = hh:row    .
     2321                                   v-help-old-size = hh:width .
     2322                                   hh:width-chars = 2.5 .
     2323                               end.
     2324                           when "b-print" then
     2325                               do:
     2326                                   hh:load-image("cmp/b-print.bmp":u) .
     2327                                   hh:TOOLTIP = "Печать" .
     2328                                   v-h[ii] = hh:handle .
     2329                                   ii = ii + 1 .
     2330                                   hh:width-chars = 3 .
     2331                               end.
     2332                           when "b-history" or
     2333                           when "b-hist" then
     2334                               do:
     2335                                   hh:load-image("cmp/b-hist.bmp":u) .
     2336                                   hh:TOOLTIP = "История" .
     2337                                   v-h[ii] = hh:handle .
     2338                                   ii = ii + 1 .
     2339                                   hh:width-chars = 3 .
     2340                               end.
     2341                           when "b-sch" then
     2342                               do:
     2343                                   hh:load-image("cmp/b-sch.bmp":u) .
     2344                                   hh:TOOLTIP = "Установка Фильтра" .
     2345                                   v-h[ii] = hh:handle .
     2346                                   ii = ii + 1 .
     2347                                   hh:width-chars = 3 .
     2348                               end.
     2349                           when "b-hist-user" then
     2350                               do:
     2351                                   hh:load-image("cmp/b-hist.bmp":u) .
     2352                                   hh:TOOLTIP = "История пользователя" .
     2353                                   ii = ii + 1 .
     2354                               end.
     2355                       end case.
     2356                   end.
     2357                   hh = hh:next-sibling.
     2358               end.
     2359               b-help:column = v-frame-width - b-help:width-chars.
     2360               jj = 0.
     2361               repeat ii = 4 to 1 by -1 :
     2362                   if valid-handle (v-h[ii] ) then
     2363                   do:
     2364                       jj  = jj + 1 .
     2365                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2366                       v-h[ii]:row    = v-help-old-y .
     2367                   end.
     2368               end.
     2369           end.
     2370       end.
     2371   end procedure.
     2372   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2373   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2374   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2375   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2376   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2377   define variable v-diasize-current-frame-height as decimal   no-undo .
     2378   define variable v-diasize-change-size          as logical   no-undo .
     2379   define variable v-diasize-resize-button        as handle    no-undo .
     2380   define variable v-diasize-wndmax               as logical   no-undo .
     2381   define variable v-diasize-wndstore             as logical   no-undo .
     2382   define variable v-diasize-proc-name            as character no-undo .
     2383   define variable v-diasize-browse-handle        as handle    no-undo .
     2384   define variable v-diasize-browse-number        as integer   no-undo .
     2385   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2386   define temp-table temp-diasize-handle no-undo
     2387     field handle-value  as handle
     2388     field save-position as decimal
     2389     index xpk is primary unique handle-value
     2390     .
     2391   define temp-table temp-browse-handle no-undo
     2392     field browse-type   as character
     2393     field browse-number as integer
     2394     field browse-handle as handle
     2395     field original-size as decimal
     2396     index xpk is primary unique browse-type browse-number
     2397     index xie browse-type browse-handle
     2398   .
     2399   procedure diasize_change-height :
     2400     define input  parameter p-change-value  as decimal   no-undo .
     2401     define input  parameter p-move-resize   as logical   no-undo .
     2402     define variable v-field-group-handle    as handle    no-undo .
     2403     define variable v-object-handle         as handle    no-undo .
     2404     define variable v-frame-height          as decimal   no-undo .
     2405     define variable v-frame-virtual-height  as decimal   no-undo .
     2406     define variable v-browse-height         as decimal   no-undo .
     2407     define variable v-window-height         as decimal   no-undo .
     2408     define variable v-window-virtual-height as decimal   no-undo .
     2409     define variable v-change-sign           as integer   no-undo .
     2410     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2411     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2412     if p-change-value > 0
     2413     then do:
     2414       if frame Dialog-Frame :height + p-change-value
     2415           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2416       then do:
     2417         assign
     2418           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2419                           - (frame Dialog-Frame :height-chars)
     2420         .
     2421         if p-change-value <= 0
     2422         then do:
     2423           run diasize_position-resize-button in this-procedure .
     2424           return .
     2425         end.
     2426       end.
     2427     end.
     2428     if p-change-value < 0
     2429     then do:
     2430       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2431       then do:
     2432         assign
     2433           p-change-value = v-diasize-orig-frame-height
     2434                          - (frame Dialog-Frame :height-chars)
     2435         .
     2436         if p-change-value >= 0
     2437         then do:
     2438           run diasize_position-resize-button in this-procedure .
     2439           return .
     2440         end.
     2441       end.
     2442     end.
     2443     if p-change-value >= 0
     2444     then do:
     2445       assign
     2446         v-change-sign = 1
     2447       .
     2448     end.
     2449     else do:
     2450       assign
     2451         v-change-sign = -1
     2452       .
     2453     end.
     2454     assign
     2455       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2456     .
     2457     if p-change-value = 0
     2458     then do:
     2459       run diasize_position-resize-button in this-procedure .
     2460       return .
     2461     end.
     2462     move_block:
     2463     do
     2464     on error undo move_block, retry move_block
     2465     :
     2466       if retry
     2467       then do:
     2468         do
     2469         on error undo move_block, leave move_block
     2470         :
     2471           if p-change-value > 0
     2472           then do:
     2473             for each buf_temp-diasize-handle
     2474             on error undo, next
     2475             :
     2476               assign
     2477                 v-object-handle = buf_temp-diasize-handle.handle-value
     2478               .
     2479               if v-object-handle <> v-diasize-resize-button
     2480               then do:
     2481                 assign
     2482                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2483                 .
     2484               end.
     2485             end.
     2486             assign
     2487               v-diasize-browse-handle :height = v-browse-height
     2488             .
     2489             for each buf_temp-browse-handle
     2490               where buf_temp-browse-handle.browse-type = 'height':u
     2491             on error undo, next
     2492             :
     2493               assign
     2494                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2495               .
     2496             end.
     2497             assign
     2498               frame Dialog-Frame :height = v-frame-height
     2499             .
     2500             if frame Dialog-Frame :scrollable = true
     2501             then do:
     2502               assign
     2503                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2504               .
     2505             end.
     2506             run diasize_position-resize-button in this-procedure .
     2507           end.
     2508           else do:
     2509             if frame Dialog-Frame :scrollable = true
     2510             then do:
     2511               assign
     2512                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2513               .
     2514             end.
     2515             assign
     2516               frame Dialog-Frame :height = v-frame-height
     2517             .
     2518             assign
     2519               v-diasize-browse-handle :height = v-browse-height
     2520             .
     2521             for each buf_temp-browse-handle
     2522               where buf_temp-browse-handle.browse-type = 'height':u
     2523             on error undo, next
     2524             :
     2525               assign
     2526                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2527               .
     2528             end.
     2529             for each buf_temp-diasize-handle
     2530             on error undo, next
     2531             :
     2532               assign
     2533                 v-object-handle = buf_temp-diasize-handle.handle-value
     2534               .
     2535               if v-object-handle <> v-diasize-resize-button
     2536               then do:
     2537                 assign
     2538                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2539                 .
     2540               end.
     2541             end.
     2542             run diasize_position-resize-button in this-procedure .
     2543           end.
