     4410     if loc-doc-rcv.status_ <> 'новый':U  and
     4411         s-doc-mode = 'ИЗМЕНЕНИЕ':U then do:
     4412         enable B-create-trn B-trn B-trn-3 B-trn-2 B-trn-4 l-loc-hour-2 l-loc-min-2  with frame Dialog-Frame .
     4413     end.
     4414   if p-mode = 3  then do:
     4415   disable
     4416       loc-doc-rcv.cli-code
     4417       loc-doc-rcv.cli-type
     4418       post_obj-name
     4419       r-clients
     4420       with frame  Dialog-Frame .
     4421    if g#type = 'ОП':U then
     4422    disable
     4423       loc-doc-rcv.obj-type
     4424       loc-doc-rcv.obj-code
     4425       obj_obj-name
     4426       r-obj
     4427       with frame  Dialog-Frame .
     4428   end.
     4429     view frame frame-a  .
     4430     display  BROWSE-30 with frame  frame-a.
     4431     OPEN QUERY BROWSE-30  FOR EACH post-ord-line-rcv       where post-ord-line-rcv.rcv-code = loc-doc-rcv.rcv-code and             post-ord-line-rcv.doc-code = loc-doc-rcv.doc-code no-lock,         each post-goods where                post-goods.artic  =  post-ord-line-rcv.artic  and                 post-goods.prod-code  =  post-ord-line-rcv.prod-code  and                 post-goods.prod-type  =  post-ord-line-rcv.prod-type   no-lock              by post-ord-line-rcv.line-num .
     4432     find first ub.goods no-lock where ub.goods.gds-code = Post-goods.gds-code no-error .
     4433   end.
     4434   end.
     4435   END PROCEDURE.
     4436   PROCEDURE look-trn-all :
     4437   do
     4438    on error undo, return error return-value
     4439    :
     4440    if frame FRAME-a:visible then do:
     4441    b-trn-2:LOAD-IMAGE-DOWN ("adeicon\save-d":U) in frame dialog-frame .
     4442    b-trn-2:LOAD-IMAGE-UP ("adeicon\save-u":U) in frame dialog-frame .
     4443    b-trn-2:LOAD-IMAGE-INSENSITIVE ("adeicon\save-i":U) in frame dialog-frame .
     4444    b-trn-2:tooltip = "Свернуть данные накладной" .
     4445    b-trn-2:LABEL = "Свернуть накл".
     4446    DISPLAY b-trn-2 WITH frame dialog-frame .
     4447    view frame frame-b  .
     4448    hide frame frame-a  .
     4449    display  browse-32 with frame  frame-b.
     4450    OPEN QUERY BROWSE-32 FOR EACH post-ord-line-rcv where loc-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and loc-doc-rcv.doc-code = post-ord-line-rcv.doc-code NO-LOCK,              EACH Post-goods where             Post-goods.artic  =  post-ord-line-rcv.artic  and             Post-goods.prod-code  =  post-ord-line-rcv.prod-code and             Post-goods.prod-type   =  post-ord-line-rcv.prod-type   NO-LOCK,              EACH ub.doc-line WHERE ub.doc-line.artic = post-ord-line-rcv.artic   AND ub.doc-line.prod-code = post-ord-line-rcv.prod-code   AND ub.doc-line.prod-type = post-ord-line-rcv.prod-type   AND ub.doc-line.doc-code = loc-doc-rcv.trn-code OUTER-JOIN NO-LOCK  .
     4451    end.
     4452    else do:
     4453     b-trn-2:LOAD-IMAGE-DOWN ("adeicon\open-d":U) in frame dialog-frame .
     4454     b-trn-2:LOAD-IMAGE-UP ("adeicon\open-u":U) in frame dialog-frame .
     4455     b-trn-2:LOAD-IMAGE-INSENSITIVE ("adeicon\open-i":U) in frame dialog-frame .
     4456     b-trn-2:tooltip = "Развернуть с накладной" .
     4457     b-trn-2:LABEL = "Показать накл".
     4458    DISPLAY b-trn-2 WITH frame dialog-frame .
     4459    view frame frame-a  .
     4460    hide frame frame-b  .
     4461    display  browse-30 with frame  frame-a.
     4462    OPEN QUERY BROWSE-30  FOR EACH post-ord-line-rcv       where post-ord-line-rcv.rcv-code = loc-doc-rcv.rcv-code and             post-ord-line-rcv.doc-code = loc-doc-rcv.doc-code no-lock,         each post-goods where                post-goods.artic  =  post-ord-line-rcv.artic  and                 post-goods.prod-code  =  post-ord-line-rcv.prod-code  and                 post-goods.prod-type  =  post-ord-line-rcv.prod-type   no-lock              by post-ord-line-rcv.line-num .
     4463   end.
     4464     find first ub.goods  no-lock where ub.goods.gds-code = Post-goods.gds-code no-error .
     4465   end.
     4466   END PROCEDURE.
     4467   PROCEDURE openbr :
     4468    do
     4469    on error undo, return error return-value
     4470    :
     4471   OPEN QUERY BROWSE-30  FOR EACH post-ord-line-rcv       where post-ord-line-rcv.rcv-code = loc-doc-rcv.rcv-code and             post-ord-line-rcv.doc-code = loc-doc-rcv.doc-code no-lock,         each post-goods where                post-goods.artic  =  post-ord-line-rcv.artic  and                 post-goods.prod-code  =  post-ord-line-rcv.prod-code  and                 post-goods.prod-type  =  post-ord-line-rcv.prod-type   no-lock              by post-ord-line-rcv.line-num .
     4472   end.
     4473   END PROCEDURE.
     4474   PROCEDURE r-clients-ch :
     4475   do
     4476    on error undo, return error return-value
     4477    :
     4478   define variable rid-list    as  char no-undo .
     4479     run ref/cli-all.w ( input parParentProc, input "b-sel",'объект':U , ?, ?, ?, ?, ?, output  rid-list ) no-error .
     4480     if num-entries (rid-list) < 1 then return error return-value .
     4481     find first Post-clients no-lock  WHERE recid (post-clients) = integer(rid-list)  No-ERROR.
     4482     if avail Post-clients then
     4483         Assign
     4484             loc-doc-rcv.cli-code = Post-clients.obj-code
     4485             loc-doc-rcv.cli-type = Post-clients.obj-type
     4486             post_obj-name = post-clients.obj-name.
     4487         .
     4488     Display loc-doc-rcv.cli-code loc-doc-rcv.cli-type Post_obj-name with frame Dialog-Frame.
     4489     if loc-doc-rcv.obj-code = loc-doc-rcv.cli-code and
     4490        loc-doc-rcv.obj-type = loc-doc-rcv.cli-type
     4491        then do:
     4492        message "Поставщик и Контрагент должны быть разные ! " view-as alert-box error .
     4493        return no-apply.
     4494        end.
     4495   end.
     4496   END PROCEDURE.
     4497   PROCEDURE r-clients-ob :
     4498   do
     4499    on error undo, return error return-value
     4500    :
     4501   define variable rid-list    as  char no-undo .
     4502     run ref/cli-all.w ( input parParentProc, input "b-sel", 'объект':U, ?, ?, ?, ?, ?,output  rid-list) no-error .
     4503     find first OBJ-clients no-lock WHERE recid(OBJ-clients) = integer(rid-list) No-ERROR.
     4504     if avail OBJ-clients then do:
     4505         Assign
     4506         loc-doc-rcv.obj-code = OBJ-clients.obj-code
     4507         loc-doc-rcv.obj-type = OBJ-clients.obj-type
     4508         obj_obj-name = obj-clients.obj-name.
     4509         .
     4510     end.
     4511     Display loc-doc-rcv.obj-code loc-doc-rcv.obj-type OBJ_obj-name with frame Dialog-Frame.
     4512     if loc-doc-rcv.obj-code = loc-doc-rcv.cli-code and
     4513        loc-doc-rcv.obj-type = loc-doc-rcv.cli-type
     4514        then do:
     4515        message "Поставщик и Контрагент должны быть разные ! " view-as alert-box error .
     4516        return no-apply.
     4517        end.
     4518   end.
     4519   END PROCEDURE.
     4520   PROCEDURE r-cur :
     4521   do
     4522    on error undo, return error return-value
     4523    :
     4524   if p-mode <> 1 then return .
     4525   define variable ref-rec as recid no-undo .
     4526   assign
     4527     ref-rec = ?
     4528     .
     4529   run ref/currency.w ( input parParentProc, "b-sel", input-output ref-rec ).
     4530   if ref-rec = ? then return no-apply.
     4531   find ub.currency where recid ( ub.currency ) = ref-rec no-lock.
     4532   if ub.currency.curr-code <> loc-exch-code then do:
     4533         find last ub.curr-accnt where ub.curr-accnt.curr-code = ub.currency.curr-code
     4534              use-index pi no-lock no-error.
     4535         if available ub.curr-accnt then assign
     4536             loc-doc-rcv.exch-rate  = ub.curr-accnt.exch-rate
     4537             loc-doc-rcv.exch-scale  = ub.curr-accnt.exch-scale
     4538             .
     4539      assign
     4540      loc-exch-code         = ub.currency.curr-code
     4541      loc-doc-rcv.exch-code = ub.currency.curr-code
     4542      loc-exch-rate         = loc-doc-rcv.exch-rate
     4543      loc-exch-scale        = loc-doc-rcv.exch-scale
     4544      abbr-cli              = ub.currency.curr-abbr
     4545      .
     4546    display loc-cli-out-code loc-doc-rcv.cli-code loc-doc-rcv.cli-type loc-doc-rcv.obj-code loc-doc-rcv.obj-type loc-doc-rcv.ship-date l-loc-hour l-loc-min l-loc-hour-2 l-loc-min-2 loc-doc-rcv.rcv-code loc-type-doc loc-doc-rcv.doc-code post_obj-name obj_obj-name abbr-base loc-doc-rcv.base-rate loc-doc-rcv.base-scale abbr-cli loc-doc-rcv.exch-rate loc-doc-rcv.exch-scale loc-doc-rcv.exch-code with frame Dialog-Frame .
     4547    end.
     4548    end.
     4549   END PROCEDURE.
     4550   PROCEDURE ver-value :
     4551   do
     4552    on error undo, return error return-value
     4553    :
     4554   define buffer bf-units-cli for ub.units.
     4555   define buffer bufff-units  for ub.units.
     4556    if  loc-line-rcv.vat-pc:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.vat-pc  <> loc-line-rcv.vat-pc  then apply "leave" to loc-line-rcv.vat-pc  in frame dialog-frame.
     4557    if  loc-line-rcv.slt-pc:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.slt-pc  <> loc-line-rcv.slt-pc  then apply "leave" to loc-line-rcv.slt-pc  in frame dialog-frame.
     4558    if  loc-line-rcv.cli-base-rate:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.cli-base-rate  <> loc-line-rcv.cli-base-rate  then apply "leave" to loc-line-rcv.cli-base-rate  in frame dialog-frame.
     4559    if  loc-line-rcv.qnty:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.qnty  <> loc-line-rcv.qnty  then apply "leave" to loc-line-rcv.qnty  in frame dialog-frame.
     4560     if  loc-line-rcv.cli-qnty:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.cli-qnty  <> loc-line-rcv.cli-qnty  then apply "leave" to loc-line-rcv.cli-qnty  in frame dialog-frame.
     4561    if  loc-line-rcv.price-cli:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.price-cli  <> loc-line-rcv.price-cli  then apply "leave" to loc-line-rcv.price-cli  in frame dialog-frame.
     4562    if  loc-line-rcv.price-base:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.price-base  <> loc-line-rcv.price-base  then apply "leave" to loc-line-rcv.price-base  in frame dialog-frame.
     4563    if  loc-line-rcv.price-rubl:sensitive in frame dialog-frame and input frame dialog-frame loc-line-rcv.price-rubl  <> loc-line-rcv.price-rubl  then apply "leave" to loc-line-rcv.price-rubl  in frame dialog-frame.
     4564     if loc-line-rcv.cli-qnty:sensitive in frame dialog-frame and  (loc-line-rcv.cli-qnty = 0 or loc-line-rcv.cli-qnty = ?)  then do:
     4565       message "Не указано количество в единицах поставщика." view-as alert-box error.
     4566       if loc-line-rcv.cli-qnty:sensitive in frame dialog-frame then apply "entry" to loc-line-rcv.cli-qnty in frame dialog-frame.
     4567                                                                 else apply "entry" to b-ok              in frame dialog-frame.
     4568       return error.
     4569     end.
     4570     if loc-line-rcv.qnty:sensitive in frame dialog-frame and  (loc-line-rcv.qnty = 0 or loc-line-rcv.qnty = ?)  then do:
     4571       message "Не указано количество  в учетных единицах." view-as alert-box error.
     4572       return error.
     4573     end.
     4574     find bufff-units no-lock  where bufff-units.unit-name = ub.goods.unit-base  no-error.
     4575     if  loc-line-rcv.qnty:sensitive in frame dialog-frame and
     4576         lookup('шту':U, bufff-units.type) > 0      and
     4577         trunc(loc-line-rcv.qnty, 0) <> loc-line-rcv.qnty then do:
     4578         message "Базовая единица товара " ub.goods.unit-base " - штучная." skip
     4579                 "Кол-во должно быть целым."
     4580         view-as alert-box error buttons ok.
     4581         return error.
     4582     end.
     4583     find bf-units-cli no-lock where bf-units-cli.unit-name = loc-line-rcv.unit-cli no-error.
     4584     if not available bf-units-cli then do:
     4585       message "Неправильная единица измерения." view-as alert-box error.
     4586       return error.
     4587     end.
     4588     if  loc-line-rcv.cli-qnty:sensitive in frame dialog-frame and
     4589         lookup('шту':U, bf-units-cli.type) > 0  and
     4590         trunc(loc-line-rcv.cli-qnty, 0) <> loc-line-rcv.cli-qnty then do:
     4591         message "Единица поставщика " loc-line-rcv.unit-cli " - штучная." skip
     4592                 "Должно быть указано целое количество в единицах поставщика."
     4593         view-as alert-box error buttons ok.
     4594         return error.
     4595     end.
     4596     release bf-units-cli.
     4597     if loc-line-rcv.cli-base-rate:sensitive in frame dialog-frame and (loc-line-rcv.cli-base-rate = 0 or loc-line-rcv.cli-base-rate = ?) then do:
     4598       message "Не указан коэффициент пересчета единиц измерения." view-as alert-box error.
     4599       return error.
     4600     end.
     4601     if loc-line-rcv.unit-cli = ub.goods.unit-base and
     4602        decimal(loc-line-rcv.cli-base-rate:screen-value)  <> 1 then do:
     4603        message "Коэффициент пересчета единиц измерения должен быть 1, т.к. единицы совпадают." view-as alert-box error.
     4604        return error.
     4605     end.
     4606       if loc-line-rcv.price-cli:sensitive in frame dialog-frame and ( loc-line-rcv.price-cli = 0 or loc-line-rcv.price-cli = ?) then do:
     4607         message "Не указана цена в валюте поставщика." view-as alert-box error.
     4608         return error.
     4609       end.
     4610       if loc-line-rcv.price-cli < 0  then do:
     4611         message "Нельзя указаывать отрицательные цены в валюте поставщика." view-as alert-box error.
     4612         return error.
     4613       end.
     4614       if loc-line-rcv.price-base:sensitive in frame dialog-frame and (loc-line-rcv.price-base = 0 or loc-line-rcv.price-base = ?) then do:
     4615         message "Не указана цена в базовой валюте." view-as alert-box error.
     4616         return error.
     4617       end.
     4618       if loc-line-rcv.price-base < 0  then do:
     4619         message "Отрицательная цена в базовой валюте."  view-as alert-box error.
     4620         return error.
     4621       end.
     4622       if loc-line-rcv.price-base > 5000 and base-code = 1 then
     4623         message "Внимание !!!" skip (2)
     4624                 "ВАЛЮТНАЯ цена превышает 5,000 !" skip (2)
     4625                 "Вы не ошиблись ?"  view-as alert-box question.
     4626       if loc-line-rcv.price-rubl:sensitive in frame dialog-frame and (loc-line-rcv.price-rubl = 0 or loc-line-rcv.price-rubl = ?) then do:
     4627         message "Не указана цена в рублях." view-as alert-box error.
     4628         return error.
     4629       end.
     4630       if loc-line-rcv.price-rubl < 0 then do:
     4631         message "Отрицательная цена в рублях."  view-as alert-box error.
     4632         return error.
     4633       end.
     4634   end.
     4635   end procedure.
