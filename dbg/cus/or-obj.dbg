     3762     END.
     3763     ON CHOOSE OF MENU-ITEM m-ed-date31-4 in menu m-ed-date31 DO:
     3764       apply "ctrl-f":U to loc-doc-rcv.ship-date in frame Dialog-Frame .
     3765     END.
     3766   def var sort-labelBROWSE-30   as character no-undo .
     3767   def var sort-clmnBROWSE-30    as handle    no-undo .
     3768   def var cur-clmnBROWSE-30     as handle    no-undo .
     3769   def var cur-clmn-locBROWSE-30 as integer   no-undo .
     3770   def var re-queryBROWSE-30     as logical   initial no no-undo .
     3771   on start-search, ctrl-o of BROWSE-30 in frame frame-A do:
     3772      run sort-brBROWSE-30
     3773        (input (if available post-ord-line-rcv
     3774                then recid(post-ord-line-rcv)
     3775                else ?
     3776               )
     3777        ).
     3778   end.
     3779   PROCEDURE sort-brBROWSE-30 :
     3780     define input parameter p-recid as recid no-undo .
     3781     if re-queryBROWSE-30 = no then do:
     3782       assign
     3783          cur-clmnBROWSE-30 = BROWSE-30:current-column in frame frame-A
     3784       .
     3785       if sort-clmnBROWSE-30 <> ? then sort-clmnBROWSE-30:column-fgcolor = 0.
     3786       if cur-clmnBROWSE-30 = sort-clmnBROWSE-30 then do:
     3787         assign
     3788            sort-labelBROWSE-30 = ""
     3789            sort-clmnBROWSE-30 = ?
     3790         .
     3791        end.
     3792        else do:
     3793          assign
     3794            sort-labelBROWSE-30 = cur-clmnBROWSE-30:label
     3795            sort-clmnBROWSE-30  = cur-clmnBROWSE-30
     3796            sort-clmnBROWSE-30:column-fgcolor = 4
     3797          .
     3798        end.
     3799      end.
     3800     assign
     3801       cur-clmn-locBROWSE-30 = 1
     3802     .
     3803     def var column-handle as handle no-undo .
     3804     column-handle = BROWSE-30:first-column.
     3805     do while valid-handle(column-handle) :
     3806       if column-handle = cur-clmnBROWSE-30 then do:
     3807         leave .
     3808       end.
     3809       column-handle = column-handle:NEXT-COLUMN.
     3810       assign
     3811         cur-clmn-locBROWSE-30 = cur-clmn-locBROWSE-30 + 1
     3812       .
     3813     end.
     3814     case sort-labelBROWSE-30:
     3815           when post-ord-line-rcv.artic:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.artic"   .   run openbr.   . END.
     3816           when Post-goods.gds-name:label in browse BROWSE-30 then DO:   assign     sort-column-name = "Post-goods.gds-name"   .   run openbr.   . END.
     3817           when Post-goods.unit-base:label in browse BROWSE-30 then DO:   assign     sort-column-name = "Post-goods.unit-base"   .   run openbr.   . END.
     3818           when post-ord-line-rcv.qnty:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.qnty"   .   run openbr.   . END.
     3819           when post-ord-line-rcv.unit-cli:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.unit-cli"   .   run openbr.   . END.
     3820           when post-ord-line-rcv.cli-qnty:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.cli-qnty"   .   run openbr.   . END.
     3821           when post-ord-line-rcv.price-rubl:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.price-rubl"   .   run openbr.   . END.
     3822           when post-ord-line-rcv.price-base:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.price-base"   .   run openbr.   . END.
     3823           when post-ord-line-rcv.price-cli:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.price-cli"   .   run openbr.   . END.
     3824           when post-ord-line-rcv.line-num:label in browse BROWSE-30 then DO:   assign     sort-column-name = "post-ord-line-rcv.line-num"   .   run openbr.   . END.
     3825       otherwise do:
     3826         assign
     3827           sort-column-name = ""
     3828         .
     3829         run openbr.
     3830         if sort-labelBROWSE-30 <> "" then do:
     3831           assign
     3832             cur-clmnBROWSE-30:column-fgcolor = 0
     3833           .
     3834         end.
     3835         assign
     3836           cur-clmn-locBROWSE-30 = ?
     3837         .
     3838       end.
     3839     end case.
     3840       if cur-clmn-locBROWSE-30 <> ? then do:
     3841         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-30') then do:
     3842           run ch-clmnBROWSE-30 in this-procedure (cur-clmn-locBROWSE-30).
     3843         end.
     3844       end.
     3845     if p-recid <> ? then do:
     3846       reposition BROWSE-30 to recid p-recid no-error.
     3847       apply "value-changed" to BROWSE-30 in frame frame-A.
     3848     end.
     3849     apply "entry" to BROWSE-30 in frame frame-A.
     3850   END PROCEDURE.
     3851   procedure re-open-query-srt-clmnBROWSE-30:
     3852   if cur-clmnBROWSE-30 = ? then do:
     3853      run openbr.
     3854   end.
     3855   else do:
     3856      assign re-queryBROWSE-30 = yes.
     3857      run sort-brBROWSE-30
     3858        (input (if available post-ord-line-rcv
     3859                then recid(post-ord-line-rcv)
     3860                else ?
     3861               )
     3862        ).
     3863      assign re-queryBROWSE-30 = no.
     3864   end.
     3865   end.
     3866   ASSIGN
     3867     b-export-2:POPUP-MENU IN FRAME Frame-A       = MENU m-export:HANDLE
     3868     b-export-2:MENU-MOUSE = 1.
     3869   MAIN-BLOCK:
     3870   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3871      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3872      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3873       if p-mode = 1 or p-mode = 3  then do:
     3874          find first ub.ord-doc-rcv  exclusive-lock   where recid(ub.ord-doc-rcv) = p-ord-rec  .
     3875       end.
     3876       if p-mode = 2 then do:
     3877         find first ub.ord-line-rcv no-lock        where recid(ub.ord-line-rcv)  = p-ord-rec  no-error .
     3878         find first ub.ord-doc-rcv  exclusive-lock where ub.ord-doc-rcv.rcv-code = ub.ord-line-rcv.rcv-code no-error .
     3879         find first b-ord-line   no-lock        where recid(b-ord-line)    = p-ord-rec no-error .
     3880       end.
     3881    ASSIGN
     3882     v-deliv-type-code     =  ub.ord-doc-rcv.deliv-type-code
     3883     v-point-obj-code      =  ub.ord-doc-rcv.obj-point-code
     3884     v-point-cli-code      =  ub.ord-doc-rcv.cli-point-code
     3885     v-point-obj-db-num    =  ub.ord-doc-rcv.obj-point-db-num
     3886     v-point-cli-db-num    =  ub.ord-doc-rcv.cli-point-db-num
     3887     v-transport-host-code      =  ub.ord-doc-rcv.transport-host-code
     3888     v-transport-cli-code  =  ub.ord-doc-rcv.transport-cli-code
     3889     v-transport-cli-type  =  ub.ord-doc-rcv.transport-cli-type
     3890     v-transport-contract  =  ub.ord-doc-rcv.transport-contract
     3891     v-transport-condition =  ub.ord-doc-rcv.transport-condition
     3892     v-transport-value     =  ub.ord-doc-rcv.transport-value
     3893     v-transport-sum       =  ub.ord-doc-rcv.sum-ship
     3894     v-transport-vat       =  ub.ord-doc-rcv.transport-vat
     3895     loc-cli-out-code      =  entry(1,ord-doc-rcv.sub-par,chr(4))
     3896     .
     3897     vat_type = entry(2,ord-doc-rcv.sub-par,chr(4)) no-error
     3898     .
     3899     Post-goods.gds-name:resizable in browse browse-30 = true .
     3900     Post-goods.gds-name:resizable in browse browse-32 = true .
     3901     post-ord-line-rcv.artic:resizable in browse browse-30 = true .
     3902     post-ord-line-rcv.artic:resizable in browse browse-32 = true .
     3903     run enable_UI in this-procedure no-error .
     3904     run input-p in this-procedure no-error .
     3905   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3906   DEF VAR cur-clmn-numBROWSE-30 as INT EXTENT 10 no-undo.
     3907   DEF VAR varmviBROWSE-30       as INT no-undo.
     3908   DEF VAR varmvjBROWSE-30       as INT no-undo.
     3909   DEF VAR varmvkBROWSE-30       as INT no-undo.
     3910   DEF VAR varmvlBROWSE-30       as INT no-undo.
     3911   DEF VAR move-elementBROWSE-30 as INT no-undo.
     3912   def var jjBROWSE-30           as int no-undo.
     3913   do varmviBROWSE-30 = 1 to EXTENT(cur-clmn-numBROWSE-30):
     3914     ASSIGN cur-clmn-numBROWSE-30[varmviBROWSE-30] = varmviBROWSE-30.
     3915   END.
     3916   RUN start-mv-clmnBROWSE-30.
     3917   PROCEDURE start-mv-clmnBROWSE-30:
     3918   def var old-session as logical no-undo.
     3919      old-session = SESSION:IMMEDIATE-DISPLAY.
     3920      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3921      SESSION:IMMEDIATE-DISPLAY = old-session.
     3922   END.
     3923   ON ctrl-cursor-right OF BROWSE BROWSE-30 do:
     3924     RUN re-move-clmnBROWSE-30 ( 2, 10).
     3925   END.
     3926   ON ctrl-cursor-left OF BROWSE BROWSE-30 do:
     3927     RUN re-move-clmnBROWSE-30 (10, 2).
     3928   END.
     3929   PROCEDURE re-move-clmnBROWSE-30:
     3930     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3931     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3932     DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     3933       if cur-clmn-numBROWSE-30[varmviBROWSE-30] = source-column THEN cur-clmn-numBROWSE-30[varmviBROWSE-30] = -1.
     3934     END.
     3935     if BROWSE-30:MOVE-COLUMN(source-column, target-column) IN FRAME frame-A then.
     3936     if source-column > target-column THEN
     3937     DO varmvjBROWSE-30 = source-column - 1 to target-column BY -1:
     3938       DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     3939           if cur-clmn-numBROWSE-30[varmviBROWSE-30] = varmvjBROWSE-30 THEN DO:
     3940             cur-clmn-numBROWSE-30[varmviBROWSE-30] = cur-clmn-numBROWSE-30[varmviBROWSE-30] + 1.
     3941           END.
     3942       END.
     3943     END.
     3944     ELSE
     3945     DO varmvjBROWSE-30 = source-column + 1 to target-column:
     3946       DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     3947         if cur-clmn-numBROWSE-30[varmviBROWSE-30] = varmvjBROWSE-30 THEN DO:
     3948           cur-clmn-numBROWSE-30[varmviBROWSE-30] = cur-clmn-numBROWSE-30[varmviBROWSE-30] - 1.
     3949         END.
     3950       END.
     3951     END.
     3952     DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     3953       if cur-clmn-numBROWSE-30[varmviBROWSE-30] = -1 THEN cur-clmn-numBROWSE-30[varmviBROWSE-30] = target-column.
     3954     END.
     3955   END PROCEDURE.
     3956   PROCEDURE ch-clmnBROWSE-30:
     3957     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3958     if cur-clmn-loc <= 2 then do:
     3959       return .
     3960     end.
     3961     DO varmviBROWSE-30 = 1 TO EXTENT(cur-clmn-numBROWSE-30):
     3962       if cur-clmn-numBROWSE-30[varmviBROWSE-30] = cur-clmn-loc THEN move-elementBROWSE-30 = varmviBROWSE-30.
     3963     END.
     3964     RUN re-move-clmnBROWSE-30 (cur-clmn-loc, 2).
     3965   END PROCEDURE.
     3966   PROCEDURE mv-brw-defaultBROWSE-30:
     3967   def var old-session as logical no-undo.
     3968     old-session = SESSION:IMMEDIATE-DISPLAY.
     3969     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3970     do varmvlBROWSE-30 = 2 to EXTENT(cur-clmn-numBROWSE-30):
     3971       RUN re-move-clmnBROWSE-30 (cur-clmn-numBROWSE-30[varmvlBROWSE-30], varmvlBROWSE-30).
     3972     END.
     3973     RUN start-mv-clmnBROWSE-30.
     3974     SESSION:IMMEDIATE-DISPLAY = old-session.
     3975   END PROCEDURE.
     3976   .
     3977   hide b-trn-2 in frame dialog-frame.
     3978   if p-mode = 1   then do:
     3979    run create-ch-box in this-procedure .
     3980    WAIT-FOR GO OF FRAME dialog-frame focus  loc-doc-rcv.cli-code .
     3981   end.
     3982   if p-mode = 3  then do:
     3983     OPEN QUERY BROWSE-37 FOR EACH buf_ord-chain NO-LOCK where                                  buf_ord-chain.doc-code = loc-doc-rcv.rcv-code and                                  buf_ord-chain.doc-type = 'rcv'                  and                                  buf_ord-chain.rel-doc-type = 'trn'   INDEXED-REPOSITION.
     3984     WAIT-FOR GO OF FRAME  dialog-frame  .
     3985   end.
     3986   if p-mode = 2 then do:
     3987   hide b-trn b-trn-3 B-trn-4 b-trn-2 b-create-trn in frame dialog-frame.
     3988    if loc-line-rcv.cli-qnty:sensitive in frame dialog-frame then
     3989        WAIT-FOR GO OF FRAME dialog-FRAME focus  loc-line-rcv.cli-qnty .
     3990     else
     3991        WAIT-FOR GO OF FRAME dialog-FRAME focus  loc-line-rcv.qnty .
     3992   end.
     3993   END.
     3994   run disable_UI  in this-procedure no-error .
     3995   PROCEDURE att-trn :
     3996   do
     3997    on error undo, return error return-value
     3998    :
     3999   define input parameter b-recid as recid no-undo .
     4000   define variable loc-ref-list as character no-undo .
     4001   define variable v-input-output as character no-undo .
     4002   define variable p-trn-code as character no-undo .
     4003   define buffer bub_ord-doc-rcv      for ub.ord-doc-rcv .
     4004   define buffer buf_ord-doc          for ub.ord-doc .
     4005   define buffer loc_buf_ord-line-rcv for ub.ord-line-rcv .
     4006   define buffer loc_buf_doc-line     for ub.doc-line .
     4007   define variable v-type-ord as character no-undo init "".
     4008   find first bub_ord-doc-rcv no-lock  where recid( bub_ord-doc-rcv)  = b-recid no-error .
     4009   if not avail bub_ord-doc-rcv then do:
     4010     message  "Не выбрана поставка !!! " view-as alert-box .
     4011     return .
     4012   end.
     4013   if bub_ord-doc-rcv.status_ <> 'поставка':U then do:
     4014     message "Нельзя сделать накладную на поставку в статусе " caps(bub_ord-doc-rcv.status_) view-as alert-box .
     4015     return.
     4016   end.
     4017   find first buf_ord-doc no-lock where buf_ord-doc.doc-code = bub_ord-doc-rcv.doc-code no-error .
     4018   if available buf_ord-doc then v-type-ord = buf_ord-doc.doc-type .
     4019   doc-rec = ?  .
     4020   if v-type-ord = 'ОП':U or v-type-ord = 'ФП':U then do:
     4021       run str/all-docs.w
     4022      ( input  parparentproc
     4023       ,input   bub_ord-doc-rcv.host-code
     4024       ,input   bub_ord-doc-rcv.obj-type
     4025       ,input   bub_ord-doc-rcv.obj-code
     4026       ,input  'status-all-hold'
     4027       ,input  ?
     4028       ,input  'при':U
     4029       ,input  ?
     4030       ,input  no
     4031       ,input  "b-sel":U
     4032       ,input  'ie':U
     4033       ,input  ?
     4034       ,input  ?
     4035       ,output loc-ref-list
     4036       ) no-error .
     4037       if error-status :error then message
     4038         vss-workfile vss-revision vss-description skip
     4039         error-status :get-message(1) skip
     4040         return-value skip
     4041         ""
     4042         view-as alert-box error
     4043       .
     4044   end.
     4045   else do:
     4046       run str/all-docs.w
     4047       ( input  parparentproc
     4048       ,input   bub_ord-doc-rcv.host-code
     4049       ,input   bub_ord-doc-rcv.obj-type
     4050       ,input   bub_ord-doc-rcv.obj-code
     4051       ,input   'объект':U
     4052       ,input  ?
     4053       ,input  ?
     4054       ,input  ?
     4055       ,input  ?
     4056       ,input  "b-sel":U
     4057       ,input  ?
     4058       ,input  ?
     4059       ,input  ?
     4060       ,output loc-ref-list
     4061       ) no-error .
     4062       if error-status :error then message
     4063         vss-workfile vss-revision vss-description skip
     4064         error-status :get-message(1) skip
     4065         return-value skip
     4066         ""
     4067         view-as alert-box error
     4068       .
     4069   end.
     4070   if loc-ref-list = ? then return.
     4071     find first   buf_trn-doc no-lock where recid(buf_trn-doc) = int(loc-ref-list) no-error .
     4072     if available buf_trn-doc
     4073        then
     4074         assign
     4075           p-trn-code    = buf_trn-doc.doc-code
     4076         .
     4077       else do:
     4078         assign
     4079           p-trn-code    = ?
     4080         .
     4081         return .
     4082       end.
     4083   define variable  j-trn as integer no-undo .
     4084   define variable  j-rcv as integer no-undo .
     4085    j-trn = 0.
     4086    j-rcv = 0.
     4087    for each loc_buf_ord-line-rcv no-lock where
     4088             loc_buf_ord-line-rcv.doc-code =  bub_ord-doc-rcv.doc-code and
     4089             loc_buf_ord-line-rcv.rcv-code =  bub_ord-doc-rcv.rcv-code
     4090             :
     4091       j-rcv = j-rcv + 1.
     4092       if can-find (first loc_buf_doc-line where
     4093                          loc_buf_doc-line.doc-code   = buf_trn-doc.doc-code and
     4094                          loc_buf_ord-line-rcv.artic  = loc_buf_doc-line.artic and
     4095                          loc_buf_ord-line-rcv.prod-type =  loc_buf_doc-line.prod-type and
     4096                          loc_buf_ord-line-rcv.prod-code =  loc_buf_doc-line.prod-code no-lock  ) Then j-trn = j-trn + 1.
     4097    end.
     4098    if j-rcv > j-trn then do:
     4099       message  "Совпадение списка товаров  в выбранной накладной " (J-trn / j-rcv ) * 100  " %  ! "
     4100         skip "Делаем привязку ?"
     4101         view-as alert-box  Question
     4102         buttons yes-no update g#log .
     4103         if not g#log  then return .
     4104     end.
     4105     if not ( bub_ord-doc-rcv.cli-code = buf_trn-doc.cli-code and
     4106              bub_ord-doc-rcv.cli-type = buf_trn-doc.cli-type )
     4107     then do:
     4108       message  "Не совпадает Поставщик в Накладной и Поставке  ! "
     4109         skip "Делаем привязку ?"
     4110         view-as alert-box  Question
     4111         buttons yes-no update g#log .
     4112         if not g#log  then return .
     4113     end.
     4114     if not ( bub_ord-doc-rcv.obj-code = buf_trn-doc.obj-code and
     4115              bub_ord-doc-rcv.obj-type = buf_trn-doc.obj-type )
     4116     then do:
     4117       message  "Не совпадает объект доставки  в Накладной и Поставке  ! "
     4118         skip "Делаем привязку ?"
     4119         view-as alert-box  Question
     4120         buttons yes-no update g#log .
     4121         if not g#log  then return .
     4122     end.
     4123     run create-chain in this-procedure (
     4124         bub_ord-doc-rcv.rcv-code,
     4125         'rcv'      ,
     4126         p-trn-code ,
     4127         'trn' ,
     4128         ''    ,
     4129         '' )  no-error .
     4130         if error-status :error then message
     4131           vss-workfile vss-revision vss-description skip
     4132           error-status :get-message(1) skip
     4133           return-value skip
     4134           "create-chain"
     4135           view-as alert-box error
     4136         .
     4137       if v-cntxt-db-num > 0 then do:
     4138           find first buf_trn-doc no-lock where recid(buf_trn-doc) = int(loc-ref-list) no-error .
     4139           for each  buf_ord-chain where
     4140                     buf_ord-chain.rel-doc-code = buf_trn-doc.doc-code and
     4141                     buf_ord-chain.rel-doc-type = 'trn'
     4142                     :
     4143              run nws/cr-route.p ( input 'send-tbl':U, input 'ord-chain':U, input ( buffer buf_ord-chain:handle) , input "0" ) no-error.
     4144           end.
     4145       end.
     4146   end.
     4147   END PROCEDURE.
     4148   PROCEDURE create-ch-box :
     4149    do
     4150    on error undo, return error return-value
     4151    :
     4152        define variable g-log as logical   no-undo .
     4153   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4154   do:
     4155     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4156       (input  v-cntxt-db-num
     4157       ,input  v-cntxt-userid
     4158       ,input  0
     4159       ,input  'actn_ord-rcv_h-wbill':U
     4160       ,input  'object':U
     4161       ,input  v-cntxt-host-code-obj
     4162       ,input  v-cntxt-obj-type
     4163       ,input  v-cntxt-obj-code
     4164       ,input  0
     4165       ,input  0
     4166       ,input  0
     4167       ,input  true
     4168       ,output g-log
     4169       )  .
     4170   end.
     4171      create RADIO-SET type-pr
     4172      assign
     4173       row    = 10.5
     4174       column = 2
     4175       RADIO-BUTTONS = "Формировать строки автоматически без подтверждения,1,Формировать строки автоматически c подтверждением,2,Импорт из файла мобильного сканера,3" +
     4176   ( if g-log then ",Закрыть поставку и создать накладную,4" else "" )
     4177       frame  = frame Dialog-Frame:handle
     4178    .
     4179   if valid-handle(type-pr) = false then do:
     4180       message "не могу создать radio-button !!!" skip
     4181       view-as alert-box information .
     4182       return error.
     4183    end.
     4184     type-pr:sensitive = yes  .
     4185     type-pr:visible   = yes  .
     4186     hide loc-cli-out-code loc-line-rcv.price-cli loc-line-rcv.cli-qnty loc-line-rcv.cli-base-rate loc-line-rcv.price-rubl loc-line-rcv.qnty loc-line-rcv.price-base loc-line-rcv.SLT-pc loc-line-rcv.VAT-pc loc-type-doc loc-doc-rcv.doc-code post_obj-name obj_obj-name
     4187    ub.goods.gds-name
     4188    ub.goods.unit-base
     4189     loc-line-rcv.artic
     4190     loc-line-rcv.prod-type
     4191     loc-line-rcv.prod-code
     4192     in frame Dialog-Frame .
     4193        frame Dialog-Frame:title  = "Формирование поставки по заказу" .
     4194     end.
     4195   END PROCEDURE.
     4196   PROCEDURE disable_UI :
     4197     HIDE FRAME Dialog-Frame.
     4198     HIDE FRAME FRAME-A.
     4199     HIDE FRAME FRAME-B.
     4200   END PROCEDURE.
     4201   PROCEDURE enable_UI :
     4202     OPEN QUERY Dialog-Frame FOR EACH loc-doc-rcv ,              EACH loc-line-rcv where       loc-doc-rcv.rcv-code = loc-line-rcv.rcv-code and loc-doc-rcv.doc-code = loc-line-rcv.doc-code  OUTER-JOIN,              EACH post-clients WHERE       loc-doc-rcv.cli-code = post-clients.obj-code and loc-doc-rcv.cli-type = post-clients.obj-type  no-LOCK ,              EACH obj-clients WHERE        loc-doc-rcv.obj-code = obj-clients.obj-code and  loc-doc-rcv.obj-type = obj-clients.obj-type  no-LOCK,              each ub.goods where              loc-line-rcv.artic = ub.goods.artic and             loc-line-rcv.prod-code = ub.goods.prod-code and                       loc-line-rcv.prod-type  = ub.goods.prod-type no-lock.
     4203     GET FIRST Dialog-Frame.
     4204     DISPLAY loc-cli-out-code l-loc-hour l-loc-min l-loc-hour-2 l-loc-min-2
     4205             loc-type-doc post_obj-name obj_obj-name abbr-base abbr-cli
     4206         WITH FRAME Dialog-Frame.
     4207     IF AVAILABLE ub.goods THEN
     4208       DISPLAY ub.goods.gds-name ub.goods.unit-base
     4209         WITH FRAME Dialog-Frame.
     4210     IF AVAILABLE loc-doc-rcv THEN
     4211       DISPLAY loc-doc-rcv.cli-code loc-doc-rcv.cli-type loc-doc-rcv.obj-code
     4212             loc-doc-rcv.obj-type loc-doc-rcv.ship-date loc-doc-rcv.exch-code
     4213             loc-doc-rcv.rcv-code loc-doc-rcv.doc-code loc-doc-rcv.base-rate
     4214             loc-doc-rcv.base-scale loc-doc-rcv.exch-rate loc-doc-rcv.exch-scale
     4215         WITH FRAME Dialog-Frame.
     4216     IF AVAILABLE loc-line-rcv THEN
     4217       DISPLAY loc-line-rcv.price-cli loc-line-rcv.cli-qnty
     4218             loc-line-rcv.cli-base-rate loc-line-rcv.price-rubl loc-line-rcv.qnty
     4219             loc-line-rcv.price-base loc-line-rcv.SLT-pc loc-line-rcv.VAT-pc
     4220             loc-line-rcv.artic loc-line-rcv.prod-type loc-line-rcv.prod-code
     4221             loc-line-rcv.unit-cli
     4222         WITH FRAME Dialog-Frame.
     4223     ENABLE B-OK B-exit B-stop B-delivery B-Help RECT-1 RECT-3 loc-cli-out-code
     4224            BROWSE-37 B-create-trn B-trn loc-doc-rcv.obj-code loc-doc-rcv.obj-type
     4225            r-obj B-trn-3 loc-doc-rcv.ship-date l-loc-hour l-loc-min B-trn-2
     4226            B-trn-4 r-curr loc-line-rcv.price-cli loc-line-rcv.cli-qnty
     4227            loc-line-rcv.cli-base-rate loc-doc-rcv.rcv-code loc-type-doc
     4228            loc-doc-rcv.doc-code post_obj-name obj_obj-name abbr-base
     4229            loc-doc-rcv.base-rate loc-doc-rcv.base-scale abbr-cli
     4230            loc-doc-rcv.exch-rate loc-doc-rcv.exch-scale loc-line-rcv.artic
     4231            loc-line-rcv.prod-type loc-line-rcv.prod-code ub.goods.gds-name
     4232            loc-line-rcv.unit-cli ub.goods.unit-base
     4233         WITH FRAME Dialog-Frame.
     4234     VIEW FRAME Dialog-Frame.
     4235     OPEN QUERY BROWSE-37 FOR EACH buf_ord-chain NO-LOCK where                                  buf_ord-chain.doc-code = loc-doc-rcv.rcv-code and                                  buf_ord-chain.doc-type = 'rcv'                  and                                  buf_ord-chain.rel-doc-type = 'trn'   INDEXED-REPOSITION.
     4236     ENABLE b-chg b-lkp b-del b-scl b-export-2 BROWSE-30
     4237         WITH FRAME FRAME-A.
     4238     OPEN QUERY BROWSE-30  FOR EACH post-ord-line-rcv       where post-ord-line-rcv.rcv-code = loc-doc-rcv.rcv-code and             post-ord-line-rcv.doc-code = loc-doc-rcv.doc-code no-lock,         each post-goods where                post-goods.artic  =  post-ord-line-rcv.artic  and                 post-goods.prod-code  =  post-ord-line-rcv.prod-code  and                 post-goods.prod-type  =  post-ord-line-rcv.prod-type   no-lock              by post-ord-line-rcv.line-num .
     4239     ENABLE b-chg-2 b-lkp-2 b-del-2 b-scl-2 BROWSE-32
     4240         WITH FRAME FRAME-B.
     4241     OPEN QUERY BROWSE-32 FOR EACH post-ord-line-rcv where loc-doc-rcv.rcv-code = post-ord-line-rcv.rcv-code and loc-doc-rcv.doc-code = post-ord-line-rcv.doc-code NO-LOCK,              EACH Post-goods where             Post-goods.artic  =  post-ord-line-rcv.artic  and             Post-goods.prod-code  =  post-ord-line-rcv.prod-code and             Post-goods.prod-type   =  post-ord-line-rcv.prod-type   NO-LOCK,              EACH ub.doc-line WHERE ub.doc-line.artic = post-ord-line-rcv.artic   AND ub.doc-line.prod-code = post-ord-line-rcv.prod-code   AND ub.doc-line.prod-type = post-ord-line-rcv.prod-type   AND ub.doc-line.doc-code = loc-doc-rcv.trn-code OUTER-JOIN NO-LOCK  .
     4242   END PROCEDURE.
     4243   PROCEDURE input-p :
     4244   do
     4245    on error undo, return error return-value
     4246    :
     4247   define buffer b_trn-doc for ub.trn-doc .
     4248   define variable s-doc-mode as character no-undo .
     4249   HIDE FRAME FRAME-B.
     4250   find first  loc-doc-rcv  exclusive-lock   .
     4251   find first post-clients no-lock where
     4252              post-clients.obj-code = loc-doc-rcv.cli-code   and
     4253              post-clients.obj-type = loc-doc-rcv.cli-type
     4254              no-error .
     4255              if error-status :error then return error return-value .
     4256              post_obj-name = post-clients.obj-name.
     4257   find first obj-clients no-lock where
     4258              loc-doc-rcv.obj-code = obj-clients.obj-code and
     4259              loc-doc-rcv.obj-type = obj-clients.obj-type
     4260              no-error .
     4261              if error-status :error then return error return-value .
     4262              obj_obj-name = obj-clients.obj-name.
     4263   find first ub.currency no-lock   where ub.currency.curr-code = loc-doc-rcv.EXCH-CODE no-error.
     4264   if available ub.currency then abbr-cli = ub.currency.curr-abbr .
     4265   define variable   p-exch-rate  as decimal   no-undo .
     4266   define variable   p-exch-scale as decimal   no-undo .
     4267   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4268   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4269     (input  base-code
     4270     ,input  today
     4271     ,output p-exch-rate
     4272     ,output p-exch-scale
     4273     ,output abbr-base
     4274     )  .
     4275   s-doc-mode = line-mode .
     4276   display  abbr-base abbr-cli loc-doc-rcv.EXCH-CODE with frame Dialog-Frame .
     4277   loc-doc-type = loc-doc-rcv.doc-type.
     4278   if p-mode = 2 then do:
     4279   find first loc-line-rcv no-error .
     4280   find first ub.goods no-lock where
     4281              ub.goods.artic      = loc-line-rcv.artic     and
     4282              ub.goods.prod-code  = loc-line-rcv.prod-code and
     4283              ub.goods.prod-type  = loc-line-rcv.prod-type
     4284               no-error.
     4285      if error-status :error then return error return-value .
     4286      run ass-var  in this-procedure no-error .
     4287   end.
     4288   define buffer buf_ord-doc for ub.ord-doc  .
     4289   find first buf_ord-doc no-lock where
     4290              buf_ord-doc.doc-code = loc-doc-rcv.doc-code no-error .
     4291   Assign
     4292      loc-time       = string( loc-doc-rcv.ship-time ,"HH:MM")
     4293      loc-time-2     = string( loc-doc-rcv.fact-ship-time ,"HH:MM")
     4294      l-loc-hour     = integer (entry(1,loc-time,":"))
     4295      l-loc-min      = integer (entry(2,loc-time,":"))
     4296      l-loc-hour-2   = if integer (entry(1,loc-time-2,":")) = 0 then 10 else integer (entry(1,loc-time-2,":"))
     4297      l-loc-min-2    = integer (entry(2,loc-time-2,":"))
     4298      loc-type-doc    = IF (loc-doc-rcv.doc-type = "out":U) THEN ("внешн") ELSE ("внутр")
     4299      loc-cli-out-code   = entry(1,loc-doc-rcv.sub-par,chr(4))
     4300      vat_type           = entry(2,ub.ord-doc-rcv.sub-par,chr(4))
     4301      loc-base-rate   = loc-doc-rcv.base-rate
     4302      loc-base-scale  = loc-doc-rcv.base-scale
     4303      loc-exch-code   = loc-doc-rcv.exch-code
     4304      loc-exch-rate   = loc-doc-rcv.exch-rate
     4305      loc-exch-scale  = loc-doc-rcv.exch-scale
     4306      no-error .
     4307   if p-mode = 1  then do:
     4308      if line-mode = 'ИЗМЕНЕНИЕ':U  then
     4309         enable      loc-cli-out-code loc-doc-rcv.cli-code loc-doc-rcv.cli-type loc-doc-rcv.obj-code loc-doc-rcv.obj-type loc-doc-rcv.ship-date l-loc-hour l-loc-min l-loc-hour-2 l-loc-min-2 loc-doc-rcv.rcv-code loc-type-doc loc-doc-rcv.doc-code post_obj-name obj_obj-name abbr-base loc-doc-rcv.base-rate loc-doc-rcv.base-scale abbr-cli loc-doc-rcv.exch-rate loc-doc-rcv.exch-scale r-obj loc-doc-rcv.exch-code with frame  Dialog-Frame .
     4310   disable
     4311       loc-doc-rcv.cli-code
     4312       loc-doc-rcv.cli-type
     4313       post_obj-name
     4314       r-clients
     4315       with frame  Dialog-Frame .
