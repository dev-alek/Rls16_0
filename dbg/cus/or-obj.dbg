     3152             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3153             ) .
     3154         end.
     3155       end.
     3156     end.
     3157     assign
     3158       v-diasize-change-size = false
     3159     .
     3160   end procedure.
     3161   procedure diasize_set-width :
     3162     define input  parameter p-new-width  as decimal   no-undo .
     3163     define input  parameter p-move-resize as logical   no-undo .
     3164     do
     3165     on error undo, return error return-value
     3166     :
     3167       run diasize_change-width in this-procedure
     3168         (input  (p-new-width - frame Dialog-Frame :width)
     3169         ,input  p-move-resize
     3170         ) .
     3171     end.
     3172   end procedure.
     3173   procedure diasize_position-resize-button :
     3174     do with frame Dialog-Frame
     3175     :
     3176       hide v-diasize-resize-button .
     3177       assign
     3178         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3179                     - 1
     3180                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3181         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3182                     - 1
     3183                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3184       .
     3185       view v-diasize-resize-button .
     3186     end.
     3187   end procedure.
     3188   on alt-right anywhere
     3189   do:
     3190     run diasize_change-width in this-procedure
     3191       (input 1
     3192       ,input true
     3193       ) .
     3194     return no-apply .
     3195   end.
     3196   on alt-left anywhere
     3197   do:
     3198     run diasize_change-width in this-procedure
     3199       (input -1
     3200       ,input true
     3201       ) .
     3202     return no-apply .
     3203   end.
     3204   on alt-down anywhere
     3205   do:
     3206     run diasize_change-height in this-procedure
     3207       (input 1
     3208       ,input true
     3209       ) .
     3210     return no-apply .
     3211   end.
     3212   on alt-up anywhere
     3213   do:
     3214     run diasize_change-height in this-procedure
     3215       (input -1
     3216       ,input true
     3217       ) .
     3218     return no-apply .
     3219   end.
     3220   on alt-enter of frame Dialog-Frame
     3221   do:
     3222     run diasize_maximize in this-procedure
     3223       (input  ?
     3224       ).
     3225     return no-apply .
     3226   end.
     3227   procedure diasize_end-move :
     3228     do
     3229     on error undo, return error return-value
     3230     :
     3231       define variable v-row-delta as decimal   no-undo .
     3232       define variable v-col-delta as decimal   no-undo .
     3233       define variable v-new-row as decimal   no-undo .
     3234       define variable v-new-col as decimal   no-undo .
     3235       assign
     3236         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3237         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3238       .
     3239       assign
     3240         v-row-delta = v-new-row - frame Dialog-Frame :height
     3241         v-col-delta = v-new-col - frame Dialog-Frame :width
     3242       .
     3243       run diasize_change-height in this-procedure
     3244         (input v-row-delta
     3245         ,input true
     3246         ) .
     3247       run diasize_change-width in this-procedure
     3248         (input v-col-delta
     3249         ,input true
     3250         ) .
     3251     end.
     3252   end procedure.
     3253   procedure diasize_maximize :
     3254     define input  parameter p-action as logical   no-undo .
     3255     do
     3256     on error undo, return error return-value
     3257     :
     3258       if p-action = ?
     3259       then do:
     3260         if v-diasize-need-maximize = true
     3261         then do:
     3262           assign
     3263             p-action = true
     3264           .
     3265         end.
     3266         else do:
     3267           assign
     3268             p-action = false
     3269           .
     3270         end.
     3271       end.
     3272       if p-action = true
     3273       then do:
     3274         run diasize_change-height in this-procedure
     3275           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3276               - frame Dialog-Frame :height-chars
     3277           ,input true
     3278           ) .
     3279         run diasize_change-width in this-procedure
     3280           (input session :width-chars
     3281               - frame Dialog-Frame :width-chars
     3282           ,input true
     3283           ) .
     3284         assign
     3285           v-diasize-need-maximize = false
     3286         .
     3287       end.
     3288       else do:
     3289         run diasize_change-width in this-procedure
     3290           (input v-diasize-orig-frame-width
     3291               - frame Dialog-Frame :width-chars
     3292           ,input true
     3293           ) .
     3294         run diasize_change-height in this-procedure
     3295           (input v-diasize-orig-frame-height
     3296               - frame Dialog-Frame :height-chars
     3297           ,input true
     3298           ) .
     3299         assign
     3300           v-diasize-need-maximize = true
     3301         .
     3302       end.
     3303     end.
     3304   end procedure.
     3305   procedure diasize_restore-orig-size :
     3306     do
     3307     on error undo, return error return-value
     3308     :
     3309       assign
     3310         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3311         v-diasize-current-frame-height = frame Dialog-Frame :height
     3312       .
     3313       run diasize_set-height in this-procedure
     3314         (input  v-diasize-orig-frame-height
     3315         ,input  true
     3316         ) .
     3317       run diasize_set-width in this-procedure
     3318         (input  v-diasize-orig-frame-width
     3319         ,input  true
     3320         ) .
     3321     end.
     3322   end procedure.
     3323   procedure diasize_restore-current-size :
     3324     do
     3325     on error undo, return error return-value
     3326     :
     3327       run diasize_set-height in this-procedure
     3328         (input  v-diasize-current-frame-height
     3329         ,input  true
     3330         ) .
     3331       run diasize_set-width in this-procedure
     3332         (input  v-diasize-current-frame-width
     3333         ,input  true
     3334         ) .
     3335     end.
     3336   end procedure.
     3337   procedure diasize_set-browse-handle :
     3338     define input  parameter p-browse-handle as handle   no-undo .
     3339     define buffer buf_temp-browse-handle for temp-browse-handle .
     3340     do
     3341     on error undo, return error return-value
     3342     :
     3343       assign
     3344         v-diasize-browse-handle = p-browse-handle
     3345       .
     3346       for each buf_temp-browse-handle
     3347       on error undo, return error return-value
     3348       :
     3349         delete buf_temp-browse-handle .
     3350       end.
     3351     end.
     3352   end procedure.
     3353   procedure diasize_add_browse :
     3354     define input  parameter p-browse-type   as character no-undo .
     3355     define input  parameter p-browse-handle as handle    no-undo .
     3356     define buffer buf_temp-browse-handle for temp-browse-handle .
     3357     do
     3358     on error undo, return error return-value
     3359     :
     3360       assign
     3361         v-diasize-browse-number = v-diasize-browse-number + 1
     3362       .
     3363       create buf_temp-browse-handle .
     3364       assign
     3365         buf_temp-browse-handle.browse-type   = p-browse-type
     3366         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3367         buf_temp-browse-handle.browse-handle = p-browse-handle
     3368       .
     3369     end.
     3370   end procedure.
     3371   procedure diasize_init :
     3372     define variable v-default-value    as logical   no-undo .
     3373     define variable v-restore-saved    as logical   no-undo .
     3374     define variable v-resize-value-str as character no-undo .
     3375     do
     3376     on error undo, return error return-value
     3377     :
     3378       do with frame Dialog-Frame
     3379       :
     3380         assign
     3381           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3382           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3383           v-diasize-browse-handle     = browse BROWSE-30 :handle
     3384         .
     3385         create button v-diasize-resize-button
     3386         assign
     3387           parent        = frame Dialog-Frame :first-child
     3388           label         = "s"
     3389           height-pixels = 16
     3390           width-pixels  = 16
     3391           visible       = true
     3392           sensitive     = true
     3393           movable       = true
     3394           triggers:
     3395             on end-move persistent run diasize_end-move in this-procedure .
     3396           end triggers.
     3397         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3398         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3399         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3400         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3401         assign
     3402           v-diasize-wndmax = false
     3403         .
     3404         if connected("ub") = true
     3405         then do:
     3406           define variable v-cntxt-db-num        as integer   no-undo .
     3407           define variable v-cntxt-userid        as character no-undo .
     3408           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3409                                             , OUTPUT v-cntxt-userid
     3410                                             ) .
     3411           run gbl/wndpar_r.p
     3412             (input  v-cntxt-db-num
     3413             ,input  v-cntxt-userid
     3414             ,input  'wndmax':U
     3415             ,output v-diasize-wndmax
     3416             ,output v-default-value
     3417             ) .
     3418         end.
     3419         assign
     3420           v-diasize-wndstore = false
     3421         .
     3422         if connected("ub") = true
     3423         then do:
     3424           run gbl/wndpar_r.p
     3425             (input  v-cntxt-db-num
     3426             ,input  v-cntxt-userid
     3427             ,input  'wndstore':U
     3428             ,output v-diasize-wndstore
     3429             ,output v-default-value
     3430             ) .
     3431         end.
     3432         assign
     3433           v-diasize-proc-name = entry(1, program-name(2), '.')
     3434         .
     3435         if v-diasize-wndstore = true
     3436         then do:
     3437           assign
     3438             v-restore-saved = false
     3439           .
     3440           if connected("ub") = true
     3441           then do:
     3442             run gbl/wndsizer.p
     3443               (input  v-cntxt-db-num
     3444               ,input  v-cntxt-userid
     3445               ,input  v-diasize-proc-name
     3446               ,input  'height':u
     3447               ,output v-resize-value-str
     3448               ) .
     3449             if v-resize-value-str <> '':U
     3450             then do:
     3451               run diasize_change-height in this-procedure
     3452                 (input  integer(v-resize-value-str)
     3453                 ,input  true
     3454                 ) .
     3455               assign
     3456                 v-restore-saved = true
     3457               .
     3458             end.
     3459           end.
     3460           if connected("ub") = true
     3461           then do:
     3462             run gbl/wndsizer.p
     3463               (input  v-cntxt-db-num
     3464               ,input  v-cntxt-userid
     3465               ,input  v-diasize-proc-name
     3466               ,input  'width':u
     3467               ,output v-resize-value-str
     3468               ) .
     3469             if v-resize-value-str <> '':U
     3470             then do:
     3471               run diasize_change-width in this-procedure
     3472                 (input  integer(v-resize-value-str)
     3473                 ,input  true
     3474                 ) .
     3475               assign
     3476                 v-restore-saved = true
     3477               .
     3478             end.
     3479           end.
     3480           if v-restore-saved <> true
     3481           then do:
     3482             if v-diasize-wndmax = true
     3483             then do:
     3484               run diasize_maximize in this-procedure
     3485                 (input  true
     3486                 ) .
     3487             end.
     3488           end.
     3489         end.
     3490         else do:
     3491           if v-diasize-wndmax = true
     3492           then do:
     3493             run diasize_maximize in this-procedure
     3494               (input  true
     3495               ) .
     3496           end.
     3497         end.
     3498       end.
     3499     end.
     3500   end procedure.
     3501   procedure diasize_need-full-display :
     3502     define output parameter p-need-full-display as logical   no-undo .
     3503     do
     3504     on error undo, return error return-value
     3505     :
     3506       assign
     3507         p-need-full-display = v-diasize-need-full-display
     3508       .
     3509       assign
     3510         v-diasize-need-full-display = false
     3511       .
     3512     end.
     3513   end procedure.
     3514   procedure get-context :
     3515      define output parameter p-db-num as integer          no-undo.
     3516      define output parameter p-user-id as character        no-undo.
     3517      define variable v-login               as character    no-undo.
     3518      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3519      define buffer buf_user-login  for ub.user-login .
     3520      do
     3521      on error undo, return error
     3522      :
     3523            FIND FIRST buf_sys-ctrl no-lock.
     3524            ASSIGN
     3525               v-login = USERID("ub")
     3526               p-db-num = buf_sys-ctrl.db-num
     3527            .
     3528            FIND FIRST buf_user-login
     3529                 WHERE buf_user-login.db-num = p-db-num
     3530                   AND buf_user-login.user-login = v-login
     3531                 no-lock
     3532                 no-error
     3533                 .
     3534            IF AVAILABLE buf_user-login
     3535            THEN DO:
     3536               assign
     3537                  p-user-id = buf_user-login.user-id
     3538               .
     3539            END.
     3540      end.
     3541   end procedure.
     3542       run diasize_init in this-procedure .
