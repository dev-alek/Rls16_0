      678   define variable kk like ub.goods.cli-base-rate no-undo .
      679   if p-mode = 1 or p-mode = 3  then do:
      680      find first ub.ord-doc-rcv no-lock  where recid(ub.ord-doc-rcv) = p-ord-rec .
      681   end.
      682   if p-mode = 2 then do:
      683   if doc-mode = 'ПРОСМОТР':U and line-mode = 'ПРОСМОТР':U then do:
      684       find first ub.ord-line-rcv no-lock  where recid(ub.ord-line-rcv) = p-ord-rec no-error .
      685       find first ub.ord-doc-rcv  no-lock  where ub.ord-line-rcv.rcv-code = ub.ord-doc-rcv.rcv-code  no-error .
      686       find first b-ord-line   no-lock  where recid(b-ord-line) = p-ord-rec no-error .
      687     end.
      688     else do:
      689       find first ub.ord-line-rcv  exclusive-lock    where recid(ub.ord-line-rcv) = p-ord-rec no-error .
      690       find first ub.ord-doc-rcv   exclusive-lock    where ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code  no-error .
      691       find first b-ord-line    exclusive-lock    where recid(b-ord-line) = p-ord-rec no-error .
      692     end.
      693   end.
      694   if not available  ub.ord-doc-rcv  then do:
      695      return error.
      696   end.
      697   if not (available  ub.ord-doc-rcv and avail ub.ord-doc-rcv)  and p-mode = 2 then do:
      698      return error.
      699   end.
      700   create loc-doc-rcv.
      701   buffer-copy ub.ord-doc-rcv to loc-doc-rcv  .
      702   define buffer bufi_ord-doc for ub.ord-doc  .
      703   find first bufi_ord-doc no-lock where
      704              bufi_ord-doc.doc-code = ub.ord-doc-rcv.doc-code no-error .
      705   if available bufi_ord-doc then do:
      706      g#stat  = bufi_ord-doc.status_ .
      707      g#type  = bufi_ord-doc.doc-type.
      708   end.
      709   if p-mode = 2 then do:
      710     create loc-line-rcv.
      711     buffer-copy ub.ord-line-rcv to loc-line-rcv.
      712   end.
