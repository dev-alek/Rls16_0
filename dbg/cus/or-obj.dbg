     1018        loc-line-rcv.artic AT ROW 10.13 COL 1 NO-LABEL
     1019              VIEW-AS TEXT
     1020             SIZE 14.75 BY 1
     1021             BGCOLOR 3 FGCOLOR 15
     1022        loc-line-rcv.prod-type AT ROW 10.13 COL 14 COLON-ALIGNED NO-LABEL
     1023              VIEW-AS TEXT
     1024             SIZE 4.63 BY 1
     1025             BGCOLOR 3 FGCOLOR 15
     1026        loc-line-rcv.prod-code AT ROW 10.13 COL 18.88 COLON-ALIGNED NO-LABEL
     1027              VIEW-AS TEXT
     1028             SIZE 10 BY 1
     1029             BGCOLOR 3 FGCOLOR 15
     1030       ub.goods.gds-name AT ROW 10.13 COL 29.25 COLON-ALIGNED NO-LABEL
     1031              VIEW-AS TEXT
     1032             SIZE 66.88 BY 1
     1033             BGCOLOR 3 FGCOLOR 15
     1034        tot-cli AT ROW 10.17 COL 95.13 COLON-ALIGNED NO-LABEL
     1035        tot-rubl AT ROW 10.21 COL 94.75 COLON-ALIGNED NO-LABEL
     1036        tot-base AT ROW 10.33 COL 95.13 COLON-ALIGNED NO-LABEL
     1037        loc-line-rcv.unit-cli AT ROW 11.88 COL 31.38 COLON-ALIGNED NO-LABEL
     1038              VIEW-AS TEXT
     1039             SIZE 4 BY .67
     1040             FGCOLOR 4
     1041       ub.goods.unit-base AT ROW 12.92 COL 31.38 COLON-ALIGNED NO-LABEL
     1042              VIEW-AS TEXT
     1043             SIZE 4 BY .67
     1044        " НАКЛАДНАЯ" VIEW-AS TEXT
     1045             SIZE 11.5 BY .67 AT ROW 2.25 COL 73.5
     1046             BGCOLOR 3 FGCOLOR 15
     1047        ":" VIEW-AS TEXT
     1048             SIZE 1.25 BY 1 AT ROW 5.5 COL 39.25
     1049             FGCOLOR 1
     1050        ":" VIEW-AS TEXT
     1051             SIZE 1.25 BY 1 AT ROW 7.96 COL 93.13
     1052             FGCOLOR 1
     1053        RECT-1 AT ROW 10.04 COL 1.13
     1054        RECT-3 AT ROW 2.25 COL 60.5
     1055        SPACE(0.11) SKIP(14.46)
     1056       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1057            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1058            TITLE "Поставка по заказу".
     1059   DEFINE FRAME FRAME-A
     1060        b-chg AT ROW 1 COL 1
     1061        b-lkp AT ROW 1 COL 11
     1062        b-del AT ROW 1 COL 21
     1063        b-scl AT ROW 1 COL 31
     1064        b-export-2 AT ROW 1 COL 41
     1065        b-flt AT ROW 1 COL 54.5
     1066        BROWSE-30 AT ROW 2 COL 1
     1067       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
     1068            SIDE-LABELS NO-UNDERLINE THREE-D
     1069            AT COL 1 ROW 9
     1070            SIZE 98 BY 14.21
     1071            TITLE "Строки поставки".
     1072   DEFINE FRAME FRAME-B
     1073        b-chg-2 AT ROW 1 COL 1
     1074        b-lkp-2 AT ROW 1 COL 11
     1075        b-del-2 AT ROW 1 COL 21
     1076        b-scl-2 AT ROW 1 COL 31
     1077        BROWSE-32 AT ROW 2 COL 1
     1078       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
     1079            SIDE-LABELS NO-UNDERLINE THREE-D
     1080            AT COL 1 ROW 9
     1081            SIZE 98 BY 14.33
     1082            TITLE "Строки поставки и накладной".
     1083   ASSIGN FRAME FRAME-A:FRAME = FRAME Dialog-Frame:HANDLE
     1084          FRAME FRAME-B:FRAME = FRAME Dialog-Frame:HANDLE.
     1085   ASSIGN
     1086          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1087          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1088   ASSIGN
     1089          r-clients:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1090   ASSIGN
     1091          tot-base:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1092   ASSIGN
     1093          tot-cli:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1094   ASSIGN
     1095          tot-rubl:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1096   ASSIGN
     1097          FRAME FRAME-A:HIDDEN           = TRUE.
     1098   ASSIGN
     1099          b-export-2:POPUP-MENU IN FRAME FRAME-A       = MENU m-export:HANDLE.
     1100   ASSIGN
     1101          b-flt:HIDDEN IN FRAME FRAME-A           = TRUE.
     1102   ASSIGN
     1103          BROWSE-30:NUM-LOCKED-COLUMNS IN FRAME FRAME-A     = 2.
     1104   ASSIGN
     1105          FRAME FRAME-B:HIDDEN           = TRUE.
     1106   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1107   DO:
     1108     APPLY "END-ERROR":U TO SELF.
     1109   END.
     1110   ON CHOOSE OF b-chg IN FRAME FRAME-A
     1111   DO:
     1112   define variable  L-RECID AS RECID NO-UNDO.
     1113   find current post-ord-line-rcv no-lock  no-error.
     1114     if avail post-ord-line-rcv then do:
     1115       L-RECID = RECID(post-ord-line-rcv) .
     1116       run cus/or-obj.w
     1117       ( parParentProc
     1118       , p-host-code
     1119       , recid(post-ord-line-rcv)
     1120       , 2
     1121       , 'ИЗМЕНЕНИЕ':U
     1122       , 'ИЗМЕНЕНИЕ':U
     1123       , input-output doc-mode
     1124       ) no-error  .
     1125       if error-status :error then
     1126       message
     1127         vss-workfile vss-revision vss-description skip
     1128         error-status :get-message(1) skip
     1129         return-value skip
     1130         "Ошибка при корректировке строки поставки"
     1131         view-as alert-box error
     1132       .
     1133       g#log =  BROWSE-30:refresh() .
     1134     end.
     1135   END.
     1136   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137   on F9 of frame frame-a anywhere do:
     1138     if not available ub.goods then
     1139       return no-apply.
     1140     gds-rec = recid (ub.goods).
     1141     run ref/gds-form.w ( input parparentproc
     1142                         ,input 'ПРОСМОТР':U
     1143                         ,input ?
     1144                         ,input ?
     1145                         ,input ?
     1146                         ,input-output gds-rec).
     1147     apply "entry" to browse-30 in frame frame-a.
     1148     return no-apply.
     1149   end.
     1150   assign
     1151     loc-cli-base-rate = if available loc-line-rcv then loc-line-rcv.cli-base-rate else 1.
     1152   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   ON LEAVE OF loc-line-rcv.cli-qnty IN FRAME dialog-frame
     1154   DO:
     1155   define variable varprt-obj_free-qnty like ub.prt-obj.free-qnty no-undo.
     1156   IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-cli
     1157                       and LOOKUP('шту':U, ub.units.type) > 0 )  AND
     1158      TRUNC(input frame dialog-frame loc-line-rcv.cli-qnty, 0)
     1159      <>    input frame dialog-frame loc-line-rcv.cli-qnty
     1160      THEN DO:
     1161         MESSAGE "Единица изм поставщика " ub.goods.unit-cli " - штучная." skip
     1162                 "Кол-во должно быть целым."
     1163         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1164         RETURN NO-APPLY.
     1165     END.
     1166   if ub.goods.qnty-cart <> 0 then do:
     1167     if input frame dialog-frame loc-line-rcv.cli-qnty / ub.goods.qnty-cart -
     1168     truncate ( input frame dialog-frame loc-line-rcv.cli-qnty / ub.goods.qnty-cart , 0 ) <> 0 then do:
     1169         g#log = yes.
     1170         message "Товар рекомендуется выписывать упаковками." skip (2)
     1171                 "Округлить до целого числа упаковок ?"
     1172                  view-as alert-box question buttons yes-no update g#log .
     1173         if g#log then do:
     1174           if round (input frame dialog-frame loc-line-rcv.cli-qnty / ub.goods.qnty-cart, 0) = 0 then do:
     1175             display
     1176                 ub.goods.qnty-cart @ loc-line-rcv.cli-qnty
     1177                 with frame dialog-frame.
     1178           end.
     1179           else do:
     1180             display
     1181               round ( input frame dialog-frame loc-line-rcv.cli-qnty / ub.goods.qnty-cart, 0) * ub.goods.qnty-cart @ loc-line-rcv.cli-qnty
     1182               with frame dialog-frame.
     1183           end.
     1184         end.
     1185     end.
     1186   end.
     1187    if loc-line-rcv.cli-base-rate:sensitive in frame dialog-frame then do:
     1188       assign
     1189         KK = input frame dialog-frame loc-line-rcv.cli-base-rate
     1190         loc-line-rcv.cli-base-rate = input frame dialog-frame loc-line-rcv.cli-base-rate.
     1191       .
     1192       end.
     1193    else do:
     1194       if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
     1195       kk = ub.goods.cli-base-rate.
     1196       else KK = b-ord-line.cli-base-rate.
     1197     end.
     1198     if lookup('cli-base-rate',parcli-qnty-calc) = 0 then do:
     1199     assign
     1200       tot-cli = input frame dialog-frame loc-line-rcv.price-cli * input frame dialog-frame loc-line-rcv.cli-qnty
     1201       loc-line-rcv.qnty = ( input frame dialog-frame loc-line-rcv.cli-qnty ) * kk .
     1202       DISPLAY  tot-cli loc-line-rcv.qnty   WITH FRAME dialog-frame.
     1203     apply "leave" to loc-line-rcv.qnty .
     1204     DISPLAY  tot-cli loc-line-rcv.qnty WITH FRAME dialog-frame.
     1205     run ass-var in this-procedure .
     1206     end.
     1207   END.
     1208   ON LEAVE OF loc-line-rcv.qnty IN FRAME dialog-frame
     1209   DO:
     1210    IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-base
     1211                       and LOOKUP('шту':U, ub.units.type) > 0)  AND
     1212      TRUNC(input frame dialog-frame loc-line-rcv.qnty, 0)
     1213      <>    input frame dialog-frame loc-line-rcv.qnty
     1214      THEN DO:
     1215         MESSAGE "Базовая единица товара " ub.goods.unit-base " - штучная." skip
     1216                 "Кол-во по факту должно быть целым."
     1217         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1218         RETURN no-apply.
     1219     END.
     1220    if pardoc-qnty-input = true then do:
     1221       if lookup('cli-base-rate',parcli-qnty-calc) > 0 then do:
     1222        assign
     1223           kk = (input frame dialog-frame loc-line-rcv.qnty) / (input frame dialog-frame loc-line-rcv.cli-qnty )
     1224        .
     1225        if kk  = ? then kk = 1.
     1226        b-ord-line.cli-base-rate = kk  .
     1227       end.
     1228       else do:
     1229           if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
     1230             kk = ub.goods.cli-base-rate .
     1231             else KK = b-ord-line.cli-base-rate .
     1232           assign
     1233               loc-line-rcv.cli-qnty = input frame dialog-frame loc-line-rcv.qnty / kk
     1234               tot-cli = input frame dialog-frame loc-line-rcv.price-cli * input frame dialog-frame loc-line-rcv.cli-qnty
     1235               .
     1236               DISPLAY  tot-cli loc-line-rcv.cli-qnty   WITH FRAME dialog-frame.
     1237          end.
     1238     run ass-var in this-procedure .
     1239     end.
     1240   END.
     1241   ON LEAVE OF loc-line-rcv.price-base IN FRAME dialog-frame
     1242   DO:
     1243   if input frame dialog-frame loc-line-rcv.price-base > 5000 and base-code = 1 then
     1244     message "Внимание !!!" skip (2)
     1245                     "ВАЛЮТНАЯ цена превышает 5,000 !" skip (2)
     1246                     "Вы не ошиблись ?".
     1247   if loc-line-rcv.price-base <> input frame dialog-frame loc-line-rcv.price-base then
     1248     assign
     1249       loc-line-rcv.price-rubl = input frame dialog-frame loc-line-rcv.price-base * loc-base-rate / loc-base-scale
     1250       loc-line-rcv.price-cli  = loc-line-rcv.price-rubl / loc-exch-rate * loc-exch-scale *
     1251        loc-cli-base-rate
     1252       .
     1253       DISPLAY
     1254       loc-line-rcv.price-RUBL
     1255       loc-line-rcv.price-cli
     1256       WITH FRAME dialog-frame .
     1257    run ass-var in this-procedure  .
     1258   END.
     1259   ON LEAVE OF loc-line-rcv.price-rubl IN FRAME dialog-frame
     1260   DO:
     1261   if loc-line-rcv.price-rubl <> input frame dialog-frame loc-line-rcv.price-rubl then
     1262     assign
     1263       loc-line-rcv.price-base = input frame dialog-frame loc-line-rcv.price-rubl / loc-base-rate * loc-base-scale
     1264       loc-line-rcv.price-cli  = input frame dialog-frame loc-line-rcv.price-rubl / loc-exch-rate * loc-exch-scale /
     1265        loc-cli-base-rate
     1266       .
     1267       DISPLAY
     1268       loc-line-rcv.price-base
     1269       loc-line-rcv.price-cli
     1270       WITH FRAME dialog-frame .
     1271       run ass-var in this-procedure .
     1272   END.
     1273   ON LEAVE OF loc-line-rcv.price-cli IN FRAME dialog-frame
     1274   DO:
     1275   if loc-line-rcv.price-cli <> input frame dialog-frame loc-line-rcv.price-cli then
     1276     assign
     1277       tot-cli = input frame dialog-frame loc-line-rcv.price-cli *  input frame dialog-frame loc-line-rcv.cli-qnty
     1278       .
     1279    run ass-var in this-procedure .
     1280   END.
     1281   procedure ass-var :
     1282    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     1283   if loc-line-rcv.qnty:sensitive in frame dialog-frame         then loc-line-rcv.qnty           = input frame dialog-frame loc-line-rcv.qnty         .
     1284   if loc-line-rcv.cli-qnty:sensitive in frame dialog-frame     then loc-line-rcv.cli-qnty       = input frame dialog-frame loc-line-rcv.cli-qnty     .
     1285   if loc-line-rcv.price-base:sensitive  in frame dialog-frame  then loc-line-rcv.price-base     = input frame dialog-frame loc-line-rcv.price-base   .
     1286   if loc-line-rcv.price-rubl:sensitive in frame dialog-frame   then loc-line-rcv.price-rubl     = input frame dialog-frame loc-line-rcv.price-rubl   .
     1287   if loc-line-rcv.price-cli:sensitive  in frame dialog-frame   then loc-line-rcv.price-cli      = input frame dialog-frame loc-line-rcv.price-cli    .
     1288   if loc-line-rcv.cli-base-rate:sensitive in frame dialog-frame then loc-line-rcv.cli-base-rate = input frame dialog-frame loc-line-rcv.cli-base-rate.
     1289    loc-store-type =  loc-doc-rcv.obj-type .
     1290    loc-store-code =  loc-doc-rcv.obj-code .
     1291    assign
     1292       pargds-code =  ub.goods.gds-code
     1293       parobj-type =  loc-store-type
     1294       parobj-code =  loc-store-code
     1295    .
     1296   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_kndinpin in g#lib-calc
     1297     (
     1298      input  pargds-code
     1299     ,input  loc-cli-type
     1300     ,input  loc-cli-code
     1301     ,input  parobj-type
     1302     ,input  parobj-code
     1303     ,output parext-gds-type
     1304     ,output parcli-qnty-input
     1305     ,output pardensity-input
     1306     ,output parcli-base-rate-input
     1307     ,output pardoc-qnty-input
     1308     ,output parfact-qnty-input
     1309     ,output parprice-cli-input
     1310     ,output parbase-price-input
     1311     ,output partax-3-input
     1312     ,output parcli-qnty-calc
     1313     ,output pardensity-calc
     1314     ,output parcli-base-rate-calc
     1315     ,output pardoc-qnty-calc
     1316     ,output parfact-qnty-calc
     1317     ,output parprice-cli-calc
     1318     ,output parbase-price-calc
     1319     ,output partax-3-calc
     1320     ,output parround
     1321     ) no-error.
     1322   if error-status :error then message
     1323     vss-workfile vss-revision vss-description skip
     1324     error-status :get-message(1) skip
     1325     return-value skip
     1326     "1"
     1327     view-as alert-box error
     1328   .
     1329   if  parext-gds-type =  'sg':U then
     1330     do:
     1331      assign
     1332       parcli-qnty-input   = true
     1333       parprice-cli-input  = true
     1334      .
     1335     end.
     1336   if g#type =  'ОФ':U then
     1337   assign
     1338   parbase-price-my = false
     1339   parbase-price-input = false
     1340   parprice-cli-input  = false
     1341   .
     1342   else
     1343   assign
     1344     parbase-price-my = true
     1345   .
     1346   if parbase-price-calc = 'cli-price' then do:
     1347    assign  frame dialog-frame  loc-line-rcv.price-rubl loc-line-rcv.price-base .
     1348    assign
     1349       loc-line-rcv.sum-rubl = input frame dialog-frame loc-line-rcv.price-rubl  * input frame dialog-frame loc-line-rcv.qnty
     1350       loc-line-rcv.sum-base = loc-line-rcv.price-base  * input frame dialog-frame loc-line-rcv.qnty
     1351       loc-line-rcv.sum-cli  = loc-line-rcv.price-cli   * input frame dialog-frame loc-line-rcv.cli-qnty
     1352       tot-rubl     = input frame dialog-frame loc-line-rcv.price-rubl * input frame dialog-frame loc-line-rcv.qnty
     1353       tot-base     = loc-line-rcv.price-base * input frame dialog-frame loc-line-rcv.qnty
     1354       tot-cli      = loc-line-rcv.price-cli  * input frame dialog-frame loc-line-rcv.cli-qnty
     1355       .
     1356   end.
     1357   else do:
     1358    assign
     1359       loc-line-rcv.sum-rubl = loc-line-rcv.price-rubl  * input frame dialog-frame loc-line-rcv.qnty
     1360       loc-line-rcv.sum-base = loc-line-rcv.price-base  * input frame dialog-frame loc-line-rcv.qnty
     1361       loc-line-rcv.sum-cli  = input frame dialog-frame loc-line-rcv.price-cli   * input frame dialog-frame loc-line-rcv.cli-qnty
     1362       tot-rubl     = loc-line-rcv.price-rubl * input frame dialog-frame loc-line-rcv.qnty
     1363       tot-base     = loc-line-rcv.price-base * input frame dialog-frame loc-line-rcv.qnty
     1364       tot-cli      = input frame dialog-frame loc-line-rcv.price-cli  * input frame dialog-frame loc-line-rcv.cli-qnty
     1365       .
     1366   end.
     1367     DISPLAY
     1368       loc-line-rcv.price-rubl
     1369       loc-line-rcv.price-base
     1370       loc-line-rcv.price-cli
     1371       tot-cli
     1372       tot-rubl
     1373       tot-base WITH FRAME dialog-frame.
     1374     assign  frame dialog-frame
     1375       loc-line-rcv.qnty
     1376       loc-line-rcv.cli-qnty
     1377       loc-line-rcv.price-base
     1378       loc-line-rcv.price-rubl
     1379       loc-line-rcv.price-cli
     1380       loc-line-rcv.cli-base-rate
     1381    .
     1382     assign
     1383    loc-line-rcv.price-base:screen-value = string(loc-line-rcv.price-base)
     1384    loc-line-rcv.price-rubl:screen-value = string(loc-line-rcv.price-rubl)
     1385    loc-line-rcv.price-cli:screen-value  = string(loc-line-rcv.price-cli )
     1386     .
     1387    run disp-total in this-procedure  no-error .
     1388    if error-status :error then do:
     1389       message error-status :error error-status :get-message(1) .
     1390       return.
     1391       end.
     1392    enable
     1393         loc-line-rcv.qnty when pardoc-qnty-input = true
     1394         loc-line-rcv.cli-qnty when parcli-qnty-input = true
     1395         loc-line-rcv.price-base     when parbase-price-input = true and     loc-doc-type = "out":u
     1396         loc-line-rcv.price-rubl     when parbase-price-input = true and     loc-doc-type = "out":u
     1397         loc-line-rcv.price-cli      when parprice-cli-input  = true and     loc-doc-type = "out":u
     1398         loc-line-rcv.vat-pc         when parbase-price-input = true and     loc-doc-type = "out":u
     1399         loc-line-rcv.slt-pc         when parbase-price-input = true and     loc-doc-type = "out":u
     1400         loc-line-rcv.cli-base-rate  when parcli-base-rate-input = true
     1401        with frame dialog-frame .
     1402   disable
     1403         loc-line-rcv.qnty when pardoc-qnty-input = false
     1404         loc-line-rcv.cli-qnty when parcli-qnty-input = false
     1405         loc-line-rcv.price-base when parbase-price-input = false or          loc-doc-type = "in":u
     1406         loc-line-rcv.price-rubl when parbase-price-input = false or          loc-doc-type = "in":u
     1407         loc-line-rcv.vat-pc when parbase-price-input = false or          loc-doc-type = "in":u
     1408         loc-line-rcv.slt-pc when parbase-price-input = false or          loc-doc-type = "in":u
     1409         loc-line-rcv.price-cli  when parprice-cli-input  = false or          loc-doc-type = "in":u
     1410         loc-line-rcv.cli-base-rate  when parcli-base-rate-input = false
     1411        with frame dialog-frame .
     1412         if loc-doc-type = 'ОФ':U  Then do:
     1413         display
     1414               loc-line-rcv.qnty
     1415               loc-line-rcv.cli-qnty
     1416               loc-line-rcv.cli-base-rate
     1417               with frame dialog-frame .
     1418               end.
     1419         else do:
     1420         display
     1421               loc-line-rcv.qnty
     1422               loc-line-rcv.cli-qnty
     1423               loc-line-rcv.price-rubl
     1424               loc-line-rcv.price-base
     1425               loc-line-rcv.price-cli
     1426               loc-line-rcv.cli-base-rate
     1427               with frame dialog-frame .
     1428         end.
     1429         Hide tot-cli  tot-rubl tot-base in FRAME dialog-frame.
     1430    end.
     1431   end procedure.
     1432   PROCEDURE apply-focus-next-entry :
     1433   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     1434     define input parameter p-widget-handle as handle no-undo .
     1435     do with frame dialog-frame :
     1436     end.
     1437   end.
     1438   END PROCEDURE.
     1439   procedure disp-total:
     1440   define variable varprice-cli-dt                like ub.doc-line.price-rubl no-undo.
     1441   define variable varprice-cli-unit-base-dt      like ub.doc-line.price-rubl no-undo.
     1442   define variable varprice-road-tax-dt           like ub.doc-line.price-rubl no-undo.
     1443   define variable varprice-other-exp-dt          like ub.doc-line.price-rubl no-undo.
     1444   define variable varprice-transport-exp-dt      like ub.doc-line.price-rubl no-undo.
     1445   define variable varprice-without-abs-dt        like ub.doc-line.price-rubl no-undo.
     1446   define variable varprice-slt-dt                like ub.doc-line.price-rubl no-undo.
     1447   define variable varprice-no-slt-dt             like ub.doc-line.price-rubl no-undo.
     1448   define variable varprice-vat-dt                like ub.doc-line.price-rubl no-undo.
     1449   define variable varprice-no-vat-slt-dt         like ub.doc-line.price-rubl no-undo.
     1450   define variable varprice-rubl-dt               like ub.doc-line.price-rubl no-undo.
     1451   define variable varprice-road-tax-rubl-dt      like ub.doc-line.price-rubl no-undo.
     1452   define variable varprice-other-exp-rubl-dt     like ub.doc-line.price-rubl no-undo.
     1453   define variable varprice-transport-exp-rubl-dt like ub.doc-line.price-rubl no-undo.
     1454   define variable varprice-without-abs-rubl-dt   like ub.doc-line.price-rubl no-undo.
     1455   define variable varprice-slt-rubl-dt           like ub.doc-line.price-rubl no-undo.
     1456   define variable varprice-no-slt-rubl-dt        like ub.doc-line.price-rubl no-undo.
     1457   define variable varprice-vat-rubl-dt           like ub.doc-line.price-rubl no-undo.
     1458   define variable varprice-no-vat-slt-rubl-dt    like ub.doc-line.price-rubl no-undo.
     1459   define variable varprice-base-dt               like ub.doc-line.price-base no-undo.
     1460   define variable varprice-road-tax-base-dt      like ub.doc-line.price-base no-undo.
     1461   define variable varprice-other-exp-base-dt     like ub.doc-line.price-base no-undo.
     1462   define variable varprice-transport-exp-base-dt like ub.doc-line.price-base no-undo.
     1463   define variable varprice-without-abs-base-dt   like ub.doc-line.price-base no-undo.
     1464   define variable varprice-slt-base-dt           like ub.doc-line.price-base no-undo.
     1465   define variable varprice-no-slt-base-dt        like ub.doc-line.price-base no-undo.
     1466   define variable varprice-vat-base-dt           like ub.doc-line.price-base no-undo.
     1467   define variable varprice-no-vat-slt-base-dt    like ub.doc-line.price-base no-undo.
     1468   if  loc-base-rate =  0  and
     1469       loc-base-scale = 0  and
     1470       loc-exch-rate  = 0  and
     1471       loc-exch-scale = 0  then return.
     1472   if vat_type = "" or vat_type = ? then do:
     1473   assign
     1474        vat_type   = 'в т. ч.':U
     1475        slt_type   = 'без':U
     1476   .
     1477   end.
     1478   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
     1479     (
     1480      input   'zakaz':u
     1481     ,input   loc-base-rate
     1482     ,input   loc-base-scale
     1483     ,input   loc-exch-rate
     1484     ,input   loc-exch-scale
     1485     ,input   vat_type
     1486     ,input   slt_type
     1487     ,input   loc-line-rcv.artic
     1488     ,input   loc-line-rcv.prod-type
     1489     ,input   loc-line-rcv.prod-code
     1490     ,input   loc-line-rcv.price-cli
     1491     ,input   loc-line-rcv.cli-base-rate
     1492     ,input   loc-line-rcv.price-rubl
     1493     ,input   loc-line-rcv.vat-pc
     1494     ,input   loc-line-rcv.slt-pc
     1495     ,input   loc-line-rcv.road-tax
     1496     ,input   loc-line-rcv.transport-rubl
     1497     ,input   loc-line-rcv.other-rubl
     1498     ,output  varprice-cli-dt
     1499     ,output  varprice-cli-unit-base-dt
     1500     ,output  varprice-road-tax-dt
     1501     ,output  varprice-other-exp-dt
     1502     ,output  varprice-transport-exp-dt
     1503     ,output  varprice-without-abs-dt
     1504     ,output  varprice-slt-dt
     1505     ,output  varprice-no-slt-dt
     1506     ,output  varprice-vat-dt
     1507     ,output  varprice-no-vat-slt-dt
     1508     ,output  varprice-rubl-dt
     1509     ,output  varprice-road-tax-rubl-dt
     1510     ,output  varprice-other-exp-rubl-dt
     1511     ,output  varprice-transport-exp-rubl-dt
     1512     ,output  varprice-without-abs-rubl-dt
     1513     ,output  varprice-slt-rubl-dt
     1514     ,output  varprice-no-slt-rubl-dt
     1515     ,output  varprice-vat-rubl-dt
     1516     ,output  varprice-no-vat-slt-rubl-dt
     1517     ,output  varprice-base-dt
     1518     ,output  varprice-road-tax-base-dt
     1519     ,output  varprice-other-exp-base-dt
     1520     ,output  varprice-transport-exp-base-dt
     1521     ,output  varprice-without-abs-base-dt
     1522     ,output  varprice-slt-base-dt
     1523     ,output  varprice-no-slt-base-dt
     1524     ,output  varprice-vat-base-dt
     1525     ,output  varprice-no-vat-slt-base-dt
     1526     ) no-error.
     1527       if error-status:error then do:
     1528         return error "Ошибка при пересчете линии ПОСТАВКИ".
     1529       end.
     1530     assign
     1531       loc-line-rcv.sum-vat    = varprice-vat-dt  * input frame dialog-frame loc-line-rcv.cli-qnty
     1532       loc-line-rcv.sum-slt    = varprice-slt-dt
     1533       loc-line-rcv.road-tax   = if var-report-r-b = "rubl" then   varprice-road-tax-rubl-dt else varprice-road-tax-base-dt
     1534       loc-line-rcv.other-base = varprice-other-exp-base-dt
     1535       loc-line-rcv.other-rubl = varprice-other-exp-rubl-dt
     1536       loc-line-rcv.price-rubl = varprice-rubl-dt
     1537       loc-line-rcv.price-base = varprice-base-dt
     1538       loc-line-rcv.price-cli  = varprice-cli-dt
     1539        .
     1540   end procedure.
     1541   on F2 of frame dialog-frame anywhere do:
     1542   return no-apply.
     1543   end.
     1544   ON LEAVE OF loc-line-rcv.cli-base-rate IN FRAME dialog-frame  do:
     1545      apply 'LEAVE' to loc-line-rcv.cli-qnty in frame dialog-frame .
     1546   end.
     1547   ON CHOOSE OF b-chg-2 IN FRAME FRAME-B
     1548   DO:
     1549   DEF VAR L-RECID AS RECID NO-UNDO.
     1550   find current post-ord-line-rcv no-error.
     1551       if avail post-ord-line-rcv then do:
     1552       L-RECID = RECID(post-ord-line-rcv) .
     1553      run cus/or-obj.w
     1554      (  parParentProc
     1555       , p-host-code
     1556       , recid(post-ord-line-rcv)
     1557       , 2
     1558       , 'ИЗМЕНЕНИЕ':U
     1559       , 'ИЗМЕНЕНИЕ':U
     1560       , input-output doc-mode
     1561       ) no-error  .
     1562       if error-status :error then
     1563       message
     1564         vss-workfile vss-revision vss-description skip
     1565         error-status :get-message(1) skip
     1566         return-value skip
     1567         "Ошибка при корректировке строки поставки"
     1568         view-as alert-box error
     1569       .
     1570       g#log =  BROWSE-32:refresh() .
     1571       end.
     1572   END.
     1573   ON CHOOSE OF B-create-trn IN FRAME Dialog-Frame
     1574   DO:
     1575    define variable g-log as logical   no-undo .
     1576    define variable v-obj-db-num as integer   no-undo .
     1577    define buffer b_ord-doc-rcv for  ub.ord-doc-rcv .
     1578    define buffer buf_ord-doc   for  ub.ord-doc     .
     1579    define buffer buf_doc-line  for  ub.doc-line    .
     1580    define variable v-ord-type as character no-undo .
     1581    define variable v-empty-trn as logical   no-undo .
     1582    define variable v-current-trn as character no-undo .
     1583    define variable varchip-code  as integer   no-undo .
     1584    find first b_ord-doc-rcv no-lock  where b_ord-doc-rcv.rcv-code = loc-doc-rcv.rcv-code  no-error .
     1585    if not available b_ord-doc-rcv then return .
     1586    find first buf_ord-doc no-lock where buf_ord-doc.doc-code   = b_ord-doc-rcv.doc-code no-error .
     1587    if available buf_ord-doc then  v-ord-type = buf_ord-doc.doc-type .
     1588   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1590     (input  b_ord-doc-rcv.obj-type
     1591     ,input  b_ord-doc-rcv.obj-code
     1592     ,output v-obj-db-num
     1593     )  .
     1594         if v-cntxt-db-num <> v-obj-db-num then do:
     1595           message "Создание накладных по заказу ОП возможно на БД №" v-obj-db-num view-as alert-box information .
     1596           return .
     1597         end.
     1598   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1599   do:
     1600     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1601       (input  v-cntxt-db-num
     1602       ,input  v-cntxt-userid
     1603       ,input  0
     1604       ,input  'actn_ord-rcv_h-wbill':U
     1605       ,input  'object':U
     1606       ,input  v-cntxt-host-code-obj
     1607       ,input  v-cntxt-obj-type
     1608       ,input  v-cntxt-obj-code
     1609       ,input  0
     1610       ,input  0
     1611       ,input  0
     1612       ,input  true
     1613       ,output g-log
     1614       )  .
     1615   end.
     1616    if not g-log then  return .
     1617        if avail b_ord-doc-rcv then do:
     1618           if b_ord-doc-rcv.status_ <> 'поставка':U then do:
     1619             message "Нельзя сделать накладную на поставку в статусе " caps(b_ord-doc-rcv.status_) view-as alert-box .
     1620             return no-apply.
     1621           end.
     1622           define variable v-is-limit as logical   no-undo .
     1623           run ver-qnty-trn-from-rcv ( input b_ord-doc-rcv.rcv-code , output v-is-limit ) .
     1624           if v-is-limit then do:
     1625               message "Нельзя делать Накладную на Поставку. Система настроена на работу 1:1."
     1626                       view-as alert-box information .
     1627               return no-apply.
     1628           end.
     1629           if b_ord-doc-rcv.doc-type = "in":U and
     1630             ( b_ord-doc-rcv.obj-code = store-code and
     1631               b_ord-doc-rcv.obj-type = store-type )
     1632               then do:
     1633                   message "Нельзя сделать накладную на поставку " caps(b_ord-doc-rcv.rcv-code) skip
     1634                   "Здесь может быть только внутренний приход"
     1635                   view-as alert-box .
     1636                   return no-apply.
     1637               end.
     1638           run cus/ord-trn.p ( parParentProc ,  recid(b_ord-doc-rcv) , yes ) no-error .
     1639           assign
     1640             v-current-trn = string(current-value (s-trn-doc, ub)) + "-" +
     1641             (if v-cntxt-db-num-obj = 0 then "" else (string(v-cntxt-obj-code) + substring(v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1))) .
     1642             v-empty-trn   = yes.
     1643           .
     1644           find first buf_trn-doc
     1645                where buf_trn-doc.doc-code = v-current-trn
     1646                no-error .
     1647           if available buf_trn-doc then do:
     1648             for each buf_doc-line
     1649                where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1650                no-lock :
     1651                   assign v-empty-trn = no .
     1652                end.
     1653              if v-empty-trn then do:
     1654                 message "Созданная накладная не содержит линий и будет удалена!"
     1655                 view-as alert-box information title "Внимание!" .
     1656                 run str/del-doc.p
     1657                   ( input  parParentProc,
     1658                     input  buf_trn-doc.doc-code,
     1659                     input  v-cntxt-db-num,
     1660                     input  "del-doc.err",
     1661                     input  ?,
     1662                     input  ?,
     1663                     input  v-cntxt-userid,
     1664                     input  buf_trn-doc.doc-code,
     1665                     input  ?,
     1666                     output varchip-code ) .
     1667              end.
     1668           end.
     1669           OPEN QUERY BROWSE-37 FOR EACH buf_ord-chain NO-LOCK where                                  buf_ord-chain.doc-code = loc-doc-rcv.rcv-code and                                  buf_ord-chain.doc-type = 'rcv'                  and                                  buf_ord-chain.rel-doc-type = 'trn'   INDEXED-REPOSITION.
     1670        end.
     1671   END.
     1672   ON CHOOSE OF b-del IN FRAME FRAME-A
     1673   DO:
     1674    if avail post-ord-line-rcv then do:
     1675                   message "Удалить строку в поставке №" post-ord-line-rcv.rcv-code
     1676                   skip
     1677                   " По товару "
     1678                   post-ord-line-rcv.artic
     1679                   post-ord-line-rcv.prod-type
     1680                   post-ord-line-rcv.prod-code
     1681                   view-as alert-box
     1682                           question buttons yes-no title "Вопрос" update g#log.
     1683                       if g#log then do:
     1684                               find current post-ord-line-rcv exclusive-lock .
     1685                                delete post-ord-line-rcv .
     1686                               OPEN QUERY BROWSE-30  FOR EACH post-ord-line-rcv       where post-ord-line-rcv.rcv-code = loc-doc-rcv.rcv-code and             post-ord-line-rcv.doc-code = loc-doc-rcv.doc-code no-lock,         each post-goods where                post-goods.artic  =  post-ord-line-rcv.artic  and                 post-goods.prod-code  =  post-ord-line-rcv.prod-code  and                 post-goods.prod-type  =  post-ord-line-rcv.prod-type   no-lock              by post-ord-line-rcv.line-num .
     1687                        end.
     1688     end.
     1689   END.
     1690   ON CHOOSE OF b-del-2 IN FRAME FRAME-B
     1691   DO:
     1692    if avail post-ord-line-rcv then do:
     1693                   message "Удалить строку в поставке №" post-ord-line-rcv.rcv-code
     1694                   skip
     1695                   " По товару "
     1696                   post-ord-line-rcv.artic
     1697                   post-ord-line-rcv.prod-type
     1698                   post-ord-line-rcv.prod-code
     1699                   view-as alert-box
     1700                           question buttons yes-no title "Вопрос" update g#log.
     1701                       if g#log then do:
     1702                               find current post-ord-line-rcv exclusive-lock.
     1703                                delete post-ord-line-rcv .
     1704                               OPEN QUERY BROWSE-30  FOR EACH post-ord-line-rcv       where post-ord-line-rcv.rcv-code = loc-doc-rcv.rcv-code and             post-ord-line-rcv.doc-code = loc-doc-rcv.doc-code no-lock,         each post-goods where                post-goods.artic  =  post-ord-line-rcv.artic  and                 post-goods.prod-code  =  post-ord-line-rcv.prod-code  and                 post-goods.prod-type  =  post-ord-line-rcv.prod-type   no-lock              by post-ord-line-rcv.line-num .
     1705                        end.
     1706     end.
     1707   END.
     1708   ON CHOOSE OF B-delivery IN FRAME Dialog-Frame
     1709   DO:
     1710   define buffer buf_ord-doc for ub.ord-doc  .
     1711   define variable type-mode as character no-undo .
     1712   if loc-doc-rcv.doc-type = "in" then type-mode = "rcv" + 'ОО':U .
     1713   else do:
     1714     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = loc-doc-rcv.doc-code no-error .
     1715       if not available buf_ord-doc  then do:
     1716          type-mode = "ord" + 'ОО':U .
     1717       end.
     1718       else do:
     1719         type-mode = "ord" + buf_ord-doc.doc-type .
     1720         if buf_ord-doc.doc-type = 'ФП':U then do:
     1721            type-mode = "rcv" + buf_ord-doc.doc-type .
     1722         end.
     1723       end.
     1724   end.
     1725       run cus/pardeliv.w
     1726         (input        parParentproc
     1727         ,input        doc-mode
     1728         ,input        type-mode
     1729         ,input        loc-doc-rcv.obj-type
     1730         ,input        loc-doc-rcv.obj-code
     1731         ,input        loc-doc-rcv.cli-type
     1732         ,input        loc-doc-rcv.cli-code
     1733         ,input-output v-deliv-type-code
     1734         ,input-output v-point-obj-code
     1735         ,input-output v-point-obj-db-num
     1736         ,input-output v-point-cli-code
     1737         ,input-output v-point-cli-db-num
     1738         ,input-output v-transport-host-code
     1739         ,input-output v-transport-cli-type
     1740         ,input-output v-transport-cli-code
     1741         ,input-output v-transport-contract
     1742         ,input-output v-transport-condition
     1743         ,input-output v-transport-value
     1744         ,input-output v-transport-sum
     1745         ,input-output v-transport-vat
     1746            ) no-error  .
     1747            if error-status :error then message
     1748              vss-workfile vss-revision vss-description skip
     1749              error-status :get-message(1) skip
     1750              return-value skip
     1751              "Ошибка"
     1752              view-as alert-box error
     1753            .
     1754   END.
     1755   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1756   DO:
     1757    doc-mode = "cancel":U.
     1758    x-make-avto = 2 .
     1759   END.
     1760   ON CHOOSE OF b-export-2 IN FRAME FRAME-A
     1761   DO:
     1762      run cus/z-tot3.p ( parParentProc , input ub.ord-doc-rcv.rcv-code , input ub.ord-doc-rcv.doc-code ) .
     1763   end.
     1764   ON CHOOSE OF b-lkp IN FRAME FRAME-A
     1765   DO:
     1766     find current post-ord-line-rcv no-error.
     1767     if avail post-ord-line-rcv then do:
     1768       run cus/or-obj.w
     1769       ( parParentProc
     1770       , p-host-code
     1771       , recid(post-ord-line-rcv)
     1772       , 2
     1773       , 'ПРОСМОТР':U
     1774       , 'ПРОСМОТР':U
     1775       , input-output doc-mode
     1776       ) no-error  .
     1777       if error-status :error then
     1778       message
     1779         vss-workfile vss-revision vss-description skip
     1780         error-status :get-message(1) skip
     1781         return-value skip
     1782         "Ошибка при корректировке строки поставки"
     1783         view-as alert-box error
     1784       .
     1785     end.
     1786   END.
     1787   ON CHOOSE OF b-lkp-2 IN FRAME FRAME-B
     1788   DO:
     1789     find current post-ord-line-rcv no-error.
     1790     if avail post-ord-line-rcv then do:
     1791       run cus/or-obj.w
     1792       ( parParentProc
     1793       , p-host-code
     1794       , recid(post-ord-line-rcv)
     1795       , 2
     1796       , 'ПРОСМОТР':U
     1797       , 'ПРОСМОТР':U
     1798       , input-output doc-mode
     1799       ) no-error  .
     1800       if error-status :error then
     1801       message
     1802         vss-workfile vss-revision vss-description skip
     1803         error-status :get-message(1) skip
     1804         return-value skip
     1805         "Ошибка при корректировке строки поставки"
     1806         view-as alert-box error
     1807       .
     1808     end.
     1809   END.
     1810   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
     1811   DO:
     1812   define variable  l-ok as logical no-undo .
     1813     x-make-avto = 2 .
     1814     if type-pr <> ? then do:
     1815        case  type-pr:screen-value :
     1816        when "1" then x-make-avto = 1 .
     1817        when "4" then x-make-avto = 4 .
     1818        when "2" then x-make-avto = 2  .
     1819        when "3" then x-make-avto = 3 .
     1820        end case.
     1821     end .
     1822     if loc-doc-rcv.obj-code = loc-doc-rcv.cli-code and
     1823        loc-doc-rcv.obj-type = loc-doc-rcv.cli-type
     1824        then do:
     1825          message "Поставщик и Контрагент должны быть разные ! " view-as alert-box error .
     1826          return no-apply.
     1827        end.
     1828   if p-mode = 1 then do:
     1829     assign frame  Dialog-Frame loc-cli-out-code loc-doc-rcv.cli-code loc-doc-rcv.cli-type loc-doc-rcv.obj-code loc-doc-rcv.obj-type loc-doc-rcv.ship-date l-loc-hour l-loc-min l-loc-hour-2 l-loc-min-2 loc-doc-rcv.rcv-code loc-type-doc loc-doc-rcv.doc-code post_obj-name obj_obj-name abbr-base loc-doc-rcv.base-rate loc-doc-rcv.base-scale abbr-cli loc-doc-rcv.exch-rate loc-doc-rcv.exch-scale.
     1830         BUFFER-COPY loc-doc-rcv to ub.ord-doc-rcv.
     1831         ub.ord-doc-rcv.ship-time = ( l-loc-hour * 60 * 60 )  + ( l-loc-min * 60 ) .
     1832         ub.ord-doc-rcv.fact-ship-time = ( l-loc-hour-2 * 60 * 60 )  + ( l-loc-min-2 * 60 ) .
     1833         ub.ord-doc-rcv.sub-par        = trim(loc-cli-out-code) + chr(4) + trim(vat_type) + chr(4) .
     1834   end.
     1835   if p-mode = 2 then  do:
     1836       run ver-value in this-procedure no-error .
     1837       if error-status :error then return no-apply.
     1838       assign frame  Dialog-Frame loc-cli-out-code loc-line-rcv.price-cli loc-line-rcv.cli-qnty loc-line-rcv.cli-base-rate loc-line-rcv.price-rubl loc-line-rcv.qnty loc-line-rcv.price-base loc-line-rcv.SLT-pc loc-line-rcv.VAT-pc loc-type-doc loc-doc-rcv.doc-code post_obj-name obj_obj-name.
     1839       buffer-copy loc-line-rcv to ub.ord-line-rcv.
     1840   end.
     1841   if p-mode = 3 then do:
     1842     assign frame  Dialog-Frame loc-cli-out-code loc-doc-rcv.cli-code loc-doc-rcv.cli-type loc-doc-rcv.obj-code loc-doc-rcv.obj-type loc-doc-rcv.ship-date l-loc-hour l-loc-min l-loc-hour-2 l-loc-min-2 loc-doc-rcv.rcv-code loc-type-doc loc-doc-rcv.doc-code post_obj-name obj_obj-name abbr-base loc-doc-rcv.base-rate loc-doc-rcv.base-scale abbr-cli loc-doc-rcv.exch-rate loc-doc-rcv.exch-scale.
     1843         BUFFER-COPY loc-doc-rcv to ub.ord-doc-rcv.
     1844         ub.ord-doc-rcv.ship-time = ( l-loc-hour * 60 * 60 )  + ( l-loc-min * 60 ) .
     1845         ub.ord-doc-rcv.fact-ship-time = ( l-loc-hour-2 * 60 * 60 )  + ( l-loc-min-2 * 60 ) .
     1846         ub.ord-doc-rcv.sub-par          = trim(loc-cli-out-code) + chr(4) + trim(vat_type) + chr(4)  .
     1847         if can-find (first post-ord-line-rcv where
     1848             post-ord-line-rcv.rcv-code = ub.ord-doc-rcv.rcv-code and
     1849             post-ord-line-rcv.qnty = 0) then do:
     1850             l-ok = false .
     1851             message "Есть нулевые строки в поставке! Удалять их ?" view-as alert-box question buttons yes-no update
     1852             l-ok  .
     1853             if l-ok = true  then do:
     1854                for each post-ord-line-rcv exclusive-lock where
     1855                         post-ord-line-rcv.rcv-code = ub.ord-doc-rcv.rcv-code and
     1856                         post-ord-line-rcv.qnty = 0 :
     1857                delete post-ord-line-rcv.
     1858                end.
     1859             end.
     1860             end.
     1861         if not can-find (first post-ord-line-rcv where
     1862             post-ord-line-rcv.rcv-code = ub.ord-doc-rcv.rcv-code ) then do:
     1863             find current ub.ord-doc-rcv  exclusive-lock   no-error .
     1864             if available ub.ord-doc-rcv then do:
     1865                message "Нeт ни одной записи в поставке! Удаляем ее" view-as alert-box information .
     1866                delete ub.ord-doc-rcv.
     1867                end.
     1868             end.
     1869   end.
     1870   if available ub.ord-doc-rcv then do:
     1871   ASSIGN
     1872       ub.ord-doc-rcv.deliv-type-code    = v-deliv-type-code
     1873       ub.ord-doc-rcv.obj-point-code     = v-point-obj-code
     1874       ub.ord-doc-rcv.cli-point-code     = v-point-cli-code
     1875       ub.ord-doc-rcv.obj-point-db-num   = v-point-obj-db-num
     1876       ub.ord-doc-rcv.cli-point-db-num   = v-point-cli-db-num
     1877       ub.ord-doc-rcv.transport-host-code= v-transport-host-code
     1878       ub.ord-doc-rcv.transport-cli-type = v-transport-cli-type
     1879       ub.ord-doc-rcv.transport-cli-code = v-transport-cli-code
     1880       ub.ord-doc-rcv.transport-contract = v-transport-contract
     1881       ub.ord-doc-rcv.transport-condition= v-transport-condition
     1882       ub.ord-doc-rcv.transport-value    = v-transport-value
     1883       ub.ord-doc-rcv.sum-ship           = v-transport-sum
     1884       ub.ord-doc-rcv.transport-vat      = v-transport-vat
     1885     .
     1886   end.
     1887   END.
     1888   ON CHOOSE OF b-scl IN FRAME FRAME-A
     1889   OR CHOOSE OF B-SCL-2 IN FRAME FRAME-B
     1890   DO:
     1891     message "Режим недоступен" view-as alert-box information .
     1892     return .
     1893   END.
     1894   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     1895   DO:
     1896   doc-mode = "stopcycle":U.
     1897   END.
     1898   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
     1899   DO:
     1900   if not available buf_ord-chain then return .
     1901       run str/showdoc.p
     1902         (input parparentproc
     1903         ,input buf_ord-chain.rel-doc-code
     1904         ,input ""
     1905         ,input ""
     1906         ,input 0
     1907         ,input true
     1908         ) no-error  .
     1909         if error-status :error then
     1910          message
     1911             "Вернулась из процедуры showdoc.p "
     1912             error-status :get-message(1)
     1913             view-as alert-box error .
     1914   END.
     1915   ON CHOOSE OF B-trn-2 IN FRAME Dialog-Frame
     1916   DO:
     1917   if not available buf_ord-chain then return .
     1918   find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code no-error .
     1919         if available   buf_trn-doc   then DO:
     1920               case buf_trn-doc.doc-type
     1921               :
     1922                 when 'при':U
     1923                 then do:
     1924   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1925   do:
     1926     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1927       (input  v-cntxt-db-num
     1928       ,input  v-cntxt-userid
     1929       ,input  0
     1930       ,input  'actn_income_lookup':U
     1931       ,input  'object':U
     1932       ,input  buf_trn-doc.host-code
     1933       ,input  buf_trn-doc.obj-type
     1934       ,input  buf_trn-doc.obj-code
     1935       ,input  0
     1936       ,input  0
     1937       ,input  0
     1938       ,input  true
     1939       ,output g#log
     1940       )  .
     1941   end.
     1942                 end.
     1943                 when 'рас':U
     1944                 then do:
     1945   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1946   do:
     1947     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1948       (input  v-cntxt-db-num
     1949       ,input  v-cntxt-userid
     1950       ,input  0
     1951       ,input  'actn_expense_lookup':U
     1952       ,input  'object':U
     1953       ,input  buf_trn-doc.host-code
     1954       ,input  buf_trn-doc.obj-type
     1955       ,input  buf_trn-doc.obj-code
     1956       ,input  0
     1957       ,input  0
     1958       ,input  0
     1959       ,input  true
     1960       ,output g#log
     1961       )  .
     1962   end.
     1963                 end.
     1964                 when 'спи':U
     1965                 then do:
     1966   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1967   do:
     1968     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1969       (input  v-cntxt-db-num
     1970       ,input  v-cntxt-userid
     1971       ,input  0
     1972       ,input  'actn_write-off_lookup':U
     1973       ,input  'object':U
     1974       ,input  buf_trn-doc.host-code
     1975       ,input  buf_trn-doc.obj-type
     1976       ,input  buf_trn-doc.obj-code
     1977       ,input  0
     1978       ,input  0
     1979       ,input  0
     1980       ,input  true
     1981       ,output g#log
     1982       )  .
     1983   end.
     1984                 end.
     1985                 when 'инв':U
     1986                 then do:
     1987   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1988   do:
     1989     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1990       (input  v-cntxt-db-num
     1991       ,input  v-cntxt-userid
     1992       ,input  0
     1993       ,input  'actn_inventory_lookup':U
     1994       ,input  'object':U
     1995       ,input  buf_trn-doc.host-code
     1996       ,input  buf_trn-doc.obj-type
     1997       ,input  buf_trn-doc.obj-code
     1998       ,input  0
     1999       ,input  0
     2000       ,input  0
     2001       ,input  true
     2002       ,output g#log
     2003       )  .
     2004   end.
     2005                 end.
     2006                 when 'возврат':U
     2007                 then do:
     2008   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   do:
     2010     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2011       (input  v-cntxt-db-num
     2012       ,input  v-cntxt-userid
     2013       ,input  0
     2014       ,input  'actn_return_lookup':U
     2015       ,input  'object':U
     2016       ,input  buf_trn-doc.host-code
     2017       ,input  buf_trn-doc.obj-type
     2018       ,input  buf_trn-doc.obj-code
     2019       ,input  0
     2020       ,input  0
     2021       ,input  0
     2022       ,input  true
     2023       ,output g#log
     2024       )  .
     2025   end.
     2026                 end.
     2027                 otherwise do:
     2028                   message
     2029                     vss-workfile vss-revision vss-description skip
     2030                     "Неизвестный тип документа" skip
     2031                     "Тип документа" buf_trn-doc.doc-type skip
     2032                     "Код документа" buf_trn-doc.doc-code skip
     2033                     view-as alert-box error .
     2034                   undo, return no-apply .
     2035                 end.
     2036               end case .
     2037               if not g#log then   return no-apply.
     2038               run look-trn-all in this-procedure no-error.
     2039         end.
     2040   END.
     2041   ON CHOOSE OF B-trn-3 IN FRAME Dialog-Frame
     2042   DO:
     2043   define buffer b_ord-doc-rcv for  ub.ord-doc-rcv .
     2044   define buffer buf_ord-doc   for  ub.ord-doc     .
     2045   define variable v-ord-type as character no-undo .
     2046   define variable v-obj-db-num as integer   no-undo .
     2047    find first b_ord-doc-rcv no-lock  where b_ord-doc-rcv.rcv-code = loc-doc-rcv.rcv-code  no-error .
     2048    if not available b_ord-doc-rcv then return .
     2049    find first buf_ord-doc no-lock where buf_ord-doc.doc-code   = b_ord-doc-rcv.doc-code no-error .
     2050    if available buf_ord-doc then  v-ord-type = buf_ord-doc.doc-type .
     2051   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2053     (input  b_ord-doc-rcv.obj-type
     2054     ,input  b_ord-doc-rcv.obj-code
     2055     ,output v-obj-db-num
     2056     )  .
     2057         if v-cntxt-db-num <> v-obj-db-num then do:
     2058           message "Привязка накладных к заказу возможно на БД №" v-obj-db-num view-as alert-box information .
     2059           return .
     2060         end.
     2061         define variable  v-is-limit as logical   no-undo .
     2062         run ver-qnty-trn-from-rcv ( input b_ord-doc-rcv.rcv-code , output v-is-limit ) .
     2063         if v-is-limit then do:
     2064             message "Нельзя делать Накладную на Поставку. Система настроена на работу 1:1."
     2065                     view-as alert-box information .
     2066             return .
     2067         end.
