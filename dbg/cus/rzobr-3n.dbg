     2182           when 3 then do:
     2183   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2184   if x-selectobject = "currency":u  or  xtog-obj then do:
     2185     for  each gds-obj
