     2422            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2423            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2424            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     2425            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     2426            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2427            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
