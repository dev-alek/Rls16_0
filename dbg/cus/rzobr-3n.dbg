     2541   PROCEDURE Display-title :
     2542   define variable v-nn as integer   no-undo .
     2543      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2544             REPORTNAME  AT 20 format "X(170)" SKIP
     2545             Trim(str1)  AT 35 format "X(75)" SKIP.
     2546        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2547        Repeat i = 1 to v-nn:
     2548         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2549        End.
     2550       i=0.
     2551          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2552        v-nn = NUM-ENTRIES(str4,chr(10)).
     2553        Repeat i = 1 to v-nn :
     2554         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2555        End.
     2556       i=0.
     2557        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2558        Repeat i = 1 to v-nn :
     2559         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2560        End.
     2561       i=0.
     2562       run rep/extitle.p (1) .
     2563   END PROCEDURE.
     2564   PROCEDURE ob-line  :
     2565   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2566   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2567   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2568   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2569   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2570   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2571   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2572   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2573   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2574   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2575   define input  parameter xTog-obj           as log no-undo.
     2576   define variable  tt#          as   int                 no-undo.
     2577    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2578    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2579    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2580     For EAch obj-list  no-lock :
     2581        FOR each ub.ot-line where
     2582                           ub.ot-line.artic         = x-artic
     2583                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2584                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2585                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     2586                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     2587                     AND   ub.ot-line.prod-code    = x-prod-code
     2588                     AND   ub.ot-line.prod-type    = x-prod-type
     2589                     AND   ub.ot-line.sum-type     = x-sum-type
     2590                       no-lock :
     2591       CASE ub.ot-line.ext-doc-type:
     2592                 WHEN        'ie':U  OR
     2593                 WHEN        're':U  OR
     2594                 WHEN        'iv':U    OR
     2595                 WHEN        'rv':U OR
     2596                 WHEN        'im':U     THEN
     2597                 DO:
     2598                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2599                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2600                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2601                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2602                 End.
     2603                 WHEN       'ee':U      OR
     2604                 WHEN       'ep':U    OR
     2605                 WHEN       'ev':U     OR
     2606                 WHEN       'em':U       OR
     2607                 WHEN       'wm':U       OR
     2608                 WHEN       'we':U     THEN
     2609                 DO:
     2610                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2611                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2612                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2613                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2614                 End.
     2615                 WHEN       'es':U  OR
     2616                 WHEN       'rs':U THEN
     2617                 DO:
     2618                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2619                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2620                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2621                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2622                 End.
     2623             WHEN  'vt':U or when 'vp':U     THEN
     2624                 DO:
     2625                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2626                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2627                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2628                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2629                 End.
     2630             WHEN       'ot':U THEN
     2631                 DO:
     2632                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2633                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2634                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2635                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2636                 End.
     2637         End CASE.
     2638      End.
     2639     END.
     2640     if tt# = 6 then DO:
     2641              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2642                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2643                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2644     End.
     2645   END PROCEDURE.
     2646   procedure ost-line :
     2647     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2648     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2649     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2650     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2651     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2652     define input  parameter x-tog-shift  as logical no-undo .
     2653     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2654     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2655     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2656     define input  parameter xtog-obj     as logical no-undo .
     2657     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2658     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2659     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2660     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2661     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2662     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2663     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2664     define buffer buff-obj-list  for obj-list .
     2665     define buffer buff-stk-line  for ub.stk-line .
     2666     assign
     2667       Quantity = 0
     2668       Coast_R  = 0
     2669       Coast_V  = 0
     2670       VAT_R    = 0
     2671       VAT_V    = 0
     2672       SLT_R    = 0
     2673       SLT_V    = 0
     2674     .
     2675     if  x-tog-shift = false then do:
     2676       for each buff-obj-list no-lock
     2677       on error undo, return error
     2678       :
     2679         find last buff-stk-line no-lock
     2680           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2681             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2682             and buff-stk-line.artic      = x-artic
     2683             and buff-stk-line.prod-type  = x-prod-type
     2684             and buff-stk-line.prod-code  = x-prod-code
     2685             and buff-stk-line.sum-type   = x-sum-type
     2686             and buff-stk-line.cat-id     = '##,##':U
     2687             and buff-stk-line.fact-order <= x-fact-order
     2688             and buff-stk-line.shift-num  = 0
     2689           use-index category
     2690           no-error .
     2691         if available buff-stk-line then do:
     2692           assign
     2693             Quantity = Quantity +  buff-stk-line.fact-qnty
     2694             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2695             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2696             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2697             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2698             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2699             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2700           .
     2701         end.
     2702       end.
     2703     end.
     2704     else do:
     2705       for each buff-obj-list no-lock
     2706         where xtog-obj = false
     2707            or (buff-obj-list.obj-type = x-store-type
     2708               and buff-obj-list.obj-code = x-store-code
     2709               )
     2710       on error undo, return error
     2711       :
     2712         find last buff-stk-line no-lock
     2713           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2714             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2715             and buff-stk-line.artic      = x-artic
     2716             and buff-stk-line.prod-type  = x-prod-type
     2717             and buff-stk-line.prod-code  = x-prod-code
     2718             and buff-stk-line.sum-type   = x-sum-type
     2719             and buff-stk-line.cat-id     = '##,##':U
     2720             and buff-stk-line.fact-order <= x-fact-order
     2721             and buff-stk-line.shift-num  > 0
     2722           use-index category
     2723           no-error .
     2724         if available buff-stk-line then do:
     2725           assign
     2726             Quantity = Quantity +  buff-stk-line.fact-qnty
     2727             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2728             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2729             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2730             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2731             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2732             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2733           .
     2734         end.
     2735       end.
     2736     end.
     2737   end procedure.
     2738   procedure ost-lineother-tax :
     2739     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2740     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2741     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2742     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2743     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2744     define input  parameter x-tog-shift  as logical no-undo .
     2745     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2746     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2747     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2748     define input  parameter xTog-obj     as logical no-undo .
     2749     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2750     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2751     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2752     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2753     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2754     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2755     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2756     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2757     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2758     define buffer buff-obj-list  for obj-list .
     2759     define buffer buff-stk-line  for ub.stk-line .
     2760     assign
     2761       Quantity = 0
     2762       Coast_R  = 0
     2763       Coast_V  = 0
     2764       VAT_R    = 0
     2765       VAT_V    = 0
     2766       SLT_R    = 0
     2767       SLT_V    = 0
     2768       other_R  = 0
     2769       other_V  = 0
     2770     .
     2771     if  x-tog-shift = false then do:
     2772       for each buff-obj-list no-lock
     2773       on error undo, return error
     2774       :
     2775         find last buff-stk-line no-lock
     2776           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2777             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2778             and buff-stk-line.artic      = x-artic
     2779             and buff-stk-line.prod-type  = x-prod-type
     2780             and buff-stk-line.prod-code  = x-prod-code
     2781             and buff-stk-line.sum-type   = x-sum-type
     2782             and buff-stk-line.cat-id     = '##,##':U
     2783             and buff-stk-line.fact-order <= x-fact-order
     2784             and buff-stk-line.shift-num  = 0
     2785           use-index category
     2786           no-error .
     2787         if available buff-stk-line then do:
     2788           assign
     2789             Quantity = Quantity +  buff-stk-line.fact-qnty
     2790             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2791             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2792             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2793             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2794             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2795             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2796             other_R  = other_R  +  buff-stk-line.other-rubl
     2797             other_V  = other_V  +  buff-stk-line.other-base
     2798           .
     2799         end.
     2800       end.
     2801     end.
     2802     else do:
     2803       for each buff-obj-list no-lock
     2804         where xtog-obj = false
     2805            or (buff-obj-list.obj-type = x-store-type
     2806               and buff-obj-list.obj-code = x-store-code
     2807               )
     2808       on error undo, return error
     2809       :
     2810         find last buff-stk-line no-lock
     2811           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2812             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2813             and buff-stk-line.artic      = x-artic
     2814             and buff-stk-line.prod-type  = x-prod-type
     2815             and buff-stk-line.prod-code  = x-prod-code
     2816             and buff-stk-line.sum-type   = x-sum-type
     2817             and buff-stk-line.cat-id     = '##,##':U
     2818             and buff-stk-line.fact-order <= x-fact-order
     2819             and buff-stk-line.shift-num  > 0
     2820           use-index category
     2821           no-error .
     2822         if available buff-stk-line then do:
     2823           assign
     2824             Quantity = Quantity +  buff-stk-line.fact-qnty
     2825             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2826             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2827             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2828             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2829             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2830             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2831             other_R = other_R   +  buff-stk-line.other-rubl
     2832             other_V = other_V   +  buff-stk-line.other-base
     2833           .
     2834         end.
     2835       end.
     2836     end.
     2837   end procedure.
     2838   procedure ost-line-kg :
     2839     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2840     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2841     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2842     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2843     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2844     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2845     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2846     define buffer buff-obj-list  for obj-list .
     2847     define buffer buf_doc-line for ub.doc-line .
     2848     define buffer buf_inv-line for ub.inv-line .
     2849     do
     2850     on error undo, return error
     2851     :
     2852       for each buf_doc-line no-lock where
     2853                buf_doc-line.obj-type    = p-obj-type   and
     2854                buf_doc-line.obj-code    = p-obj-code   and
     2855                buf_doc-line.prod-type   = p-prod-type  and
     2856                buf_doc-line.prod-code   = p-prod-code  and
     2857                buf_doc-line.artic       = p-artic      and
     2858                buf_doc-line.status_     = 'факт':U      and
     2859                buf_doc-line.fact-order <= p-fact-order
     2860             by buf_doc-line.fact-order    descending
     2861       :
     2862         find first buf_inv-line no-lock where
     2863                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2864                    buf_inv-line.artic     = buf_doc-line.artic     and
     2865                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2866                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2867         if available buf_inv-line
     2868         then do:
     2869           if buf_inv-line.after-cli-qnty <> ?
     2870           then do:
     2871             assign
     2872               p-quantity-kg = buf_inv-line.after-cli-qnty
     2873             .
     2874             leave .
     2875           end.
     2876         end.
     2877       end.
     2878       if p-quantity-kg = ?
     2879       then do:
     2880         assign
     2881           p-quantity-kg = 0
     2882         .
     2883       end.
     2884     end.
     2885   end procedure.
     2886   PROCEDURE ostatok :
     2887   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2888   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2889   def input parameter x-tog-shift   as   logical             no-undo.
     2890   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2891   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2892   def input parameter x-shift-start as integer               no-undo.
     2893   def input parameter x-shift-end   as integer               no-undo.
     2894   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2895   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2896   def input parameter xTog-obj   as log no-undo.
     2897   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2898   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2899   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2900   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2901   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2902   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2903   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2904   def var              Fact-orderS   as char  no-undo.
     2905   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2906      Assign
     2907         Fact-order   = 0
     2908         Quantity     = 0
     2909         Coast_R      = 0
     2910         Coast_V      = 0
     2911         VAT_R        = 0
     2912         VAT_V        = 0 .
     2913    x-date-start-t  = x-date-start + 1 .
     2914   IF x-date-end = date('') then DO:
     2915      Fact-order = 0 .
     2916      for each obj-list
     2917          where  ( not xtog-obj or
     2918                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2919                 no-lock :
     2920         if  x-tog-shift = false then do:
     2921                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2922                               ub.stk-tot.Fact-date <=  x-date-start
     2923                               and ub.stk-tot.shift-num = 0
     2924                               USE-INDEX fact-date no-lock no-error .
     2925              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2926         End.
     2927         Else  DO :
     2928             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2929              (ub.stk-tot.shift-date  = x-date-start-t and
     2930               ub.stk-tot.shift-num  < x-shift-start or
     2931               ub.stk-tot.shift-date  < x-date-start-t  )
     2932               and ub.stk-tot.shift-num  > 0
     2933               USE-INDEX Shift-num no-lock no-error .
     2934            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2935           END.
     2936       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2937     End.
     2938   End.
     2939   Else DO:
     2940     For each obj-list  WHERE
     2941        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2942         no-lock :
     2943      IF  x-TOG-Shift = False Then DO:
     2944          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2945               ub.stk-tot.Fact-date <= x-date-end
     2946               and ub.stk-tot.shift-num = 0
     2947               USE-INDEX fact-date no-lock no-error.
     2948          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2949      END.
     2950      Else DO:
     2951           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2952               (ub.stk-tot.shift-date  = x-date-end and
     2953               ub.stk-tot.shift-num  <= x-shift-end or
     2954               ub.stk-tot.shift-date  < x-date-end       ) and
     2955               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2956               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2957       End.
     2958       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2959     End.
     2960   End.
     2961   END PROCEDURE.
     2962   PROCEDURE report-exec1  :
     2963      FIND FIRST clients where x-store-type = clients.obj-type AND
     2964                               x-store-code = clients.obj-code no-lock no-error.
     2965     run waitfram-show(clients.obj-name) .
     2966     run calcitog.
     2967     run print-header.
     2968      case retclassify :
     2969        when "prod":u           then run run3.
     2970        otherwise do:
     2971          message "Ошибка вызова!"  view-as alert-box error .
     2972        end.
     2973      end case.
     2974     run print-footer.
     2975     END PROCEDURE.
     2976   PROCEDURE Calc-Sub-itog :
     2977   define input parameter tt as int no-undo.
     2978   define variable b as int no-undo.
     2979   if tt = 6  then Assign
     2980     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     2981     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     2982     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     2983     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     2984     .
     2985   repeat b = 1 to 3:
     2986     Assign
     2987     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     2988     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     2989     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     2990     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     2991     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     2992     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     2993     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     2994     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     2995     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     2996     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     2997     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     2998     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     2999     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     3000     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     3001     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     3002     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     3003     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     3004     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     3005     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     3006     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     3007     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     3008     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     3009   End.
     3010   END PROCEDURE.
     3011   PROCEDURE Clear-item :
     3012   define variable kk as int no-undo.
     3013    gds-zap-other = 0 .
     3014    REPEAT kk = 1 to 9 :
     3015    Assign
     3016       prih            [kk]    = 0
     3017       rash            [kk]    = 0
     3018       kassa           [kk]    = 0
     3019       Inv             [kk]    = 0
     3020       Overturn        [kk]    = 0
     3021       ostatok-end     [kk]    = 0
     3022       ostatok-start   [kk]    = 0 .
     3023          End.
     3024    END PROCEDURE.
     3025   PROCEDURE Item-Goods :
     3026      define input parameter  par-3 as char no-undo.
     3027      define input parameter  par-4 as char no-undo.
     3028        if par-4 = "goods":U  Then DO:
     3029           assign
     3030               gds-zap-unit-base  = Goods.unit-base
     3031               gds-zap-prt-root   = Goods.prt-root
     3032               gds-zap-prod-type  = Goods.prod-type
     3033               gds-zap-prod-code  = Goods.prod-code
     3034               gds-zap-artic      = Goods.artic
     3035               gds-zap-grp-name   = Goods.grp-name
     3036               gds-zap-b-code     = Goods.gds-code
     3037               gds-zap-type       = Goods.gds-type.
     3038           if g#gds-engl then
     3039               assign gds-zap-gds-name = Goods.engl-name.
     3040           else
     3041               assign gds-zap-gds-name = Goods.gds-name.
     3042        End.
     3043        if par-4 = "gds-list":U  Then DO:
     3044           assign
     3045               gds-zap-unit-base  = gds-list.unit-base
     3046               gds-zap-prt-root   = gds-list.prt-root
     3047               gds-zap-prod-type  = gds-list.prod-type
     3048               gds-zap-prod-code  = gds-list.prod-code
     3049               gds-zap-artic      = gds-list.artic
     3050               gds-zap-grp-name   = gds-list.grp-name
     3051               gds-zap-b-code     = gds-list.gds-code
     3052               gds-zap-type       = gds-list.gds-type.
     3053           if g#gds-engl then
     3054               assign gds-zap-gds-name = gds-list.engl-name.
     3055           else
     3056               assign gds-zap-gds-name = gds-list.gds-name.
     3057        End.
     3058       run foreach.
     3059   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3060     (input  gds-zap-b-code
     3061     ,input  ?
     3062     ,output v-bar-code
     3063     )  .
     3064   s-bar-code = string (v-bar-code,"999999999").
     3065       If  break_group = true  and par-3 <> "1"  then DO :
     3066            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3067            gds-zap-prod-name  = clients.obj-name.
     3068             If break_group1 = true  THEN  DO :
     3069               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3070                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3071                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3072               if par-3 = "6"  then  dO:
     3073                  if xTog-obj = true then do:
     3074                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3075                     .
     3076                   end.
     3077                  else do:
     3078                   var-vat-pc = temp-gds-list.vat-pc .
     3079                   end.
     3080                   assign
     3081                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3082                       b1-name = temp-str.
     3083                   end.
     3084               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3085                   fr0 = true .
     3086                   tmp#stroka0 = temp-str.
     3087               End.
     3088             End.
     3089               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3090                 if par-3 = "4"
     3091                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3092                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3093                 if NOT xSumsOnly THEN DO:
     3094                     fr = true .
     3095                 End.
     3096                 break_group1 = false.
     3097               END.
     3098          break_group = false.
     3099       End.
     3100       run display-line.
     3101    END PROCEDURE.
     3102   PROCEDURE Di :
