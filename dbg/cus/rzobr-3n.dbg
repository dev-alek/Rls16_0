     2144                             temp-gds-list.grp-name  = gds-obj.grp-name
     2145                             temp-gds-list.gds-name  = goods.grp-name
     2146                             temp-gds-list.gds-code  = gds-obj.gds-code
     2147                             temp-gds-list.artic     = gds-obj.artic
     2148                           .
     2149                       end.
     2150               end.
     2151       end.
     2152     for each temp-gds-list no-lock
     2153       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2154         break
     2155           by (substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))
     2156       by temp-gds-list.artic :
