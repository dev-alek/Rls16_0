     1906        End.
     1907   END PROCEDURE.
     1908   PROCEDURE display-line :
     1909        i = i + 1.
     1910           if NOT( NOT Show-Negativ-2 and
     1911            ( prih         [1]   = 0 AND
     1912             rash          [1]   = 0 AND
     1913             kassa         [1]   = 0 AND
     1914             Inv           [1]   = 0 AND
     1915             Overturn      [1]   = 0 AND
     1916             Overturn      [5]   = 0 AND
     1917             Overturn      [8]   = 0 ) ) then DO:
     1918           IF  NOT (NOT Show-Negativ  AND (
     1919                 prih          [1]   = 0 AND
     1920                 rash          [1]   = 0 AND
     1921                 kassa         [1]   = 0 AND
     1922                 Inv           [1]   = 0 AND
     1923                 Overturn      [1]   = 0 AND
     1924                 Overturn      [5]   = 0 AND
     1925                 ostatok-start [1]   = 0 AND
     1926                 ostatok-End   [1]   = 0   )) then DO:
     1927           IF NOT Sums-Only then DO:
     1928               if fr0 = true then do:
     1929                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     1930                 if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     1931                 fr0 = false .
     1932               end.
     1933               if fr = true then dO:
     1934                 PUT stream OutStream space(10) temp-str format "X(100)" SKIP.
     1935                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) String(temp-str) skip.
     1936                 fr = false .
     1937               end.
     1938              run display-str1 in this-procedure.
     1939             End.
     1940           End.
     1941        END.
     1942     END PROCEDURE.
     1943   PROCEDURE print-header :
     1944   if NOT FirstLine Then DO:
     1945      run display-title.
     1946      FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1947   End.
     1948    FirstLine = TRUE .
     1949       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1950             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name)  AT 30 format "X(170)" SKIP.
     1951             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name) format "X(170)" SKIP.
     1952         End.
     1953         run clear-b1 .
     1954         run clear-b2.
     1955         run clear-bi .
     1956         break_group = true.
     1957         break_group1 = true.
     1958      END PROCEDURE.
     1959   PROCEDURE Print-Footer :
     1960         If RetClassify = "no-classify":U  then run u-line.
     1961          gds-zap-artic = "ИТОГО" .
     1962          run display-bi.
     1963          run u-line.
     1964          END PROCEDURE.
     1965   PROCEDURE U-LINE :
     1966   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1967           s-bar-code
     1968           gds-zap-artic
     1969           gds-zap-gds-name
     1970           gds-zap-unit-base
     1971           gds-type
     1972           F-ostatok-start
     1973           F-Prih
     1974           F-Rash
     1975           F-KAssa
     1976           F-Inv
     1977           F-Overturn
     1978           F-ostatok-end
     1979           gds-zap-other
     1980           with FRAME ZAPAS .
     1981           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1982           END PROCEDURE.
     1983   PROCEDURE P-LINE :
     1984   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1985           gds-zap-artic
     1986           gds-zap-gds-name
     1987           gds-zap-unit-base
     1988           gds-type
     1989           F-ostatok-start
     1990           F-Prih
     1991           F-Rash
     1992           F-KAssa
     1993           F-Inv
     1994           F-Overturn
     1995           F-ostatok-end
     1996           gds-zap-other
     1997           with FRAME ZAPAS .
     1998           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1999           END PROCEDURE.
     2000   procedure run3 :
     2001         case select-good :
     2002           when 1  then do:
     2003   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2004   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2005       for each gds-obj  where
     2006             gds-obj.obj-type = x-store-type  and
     2007             gds-obj.obj-code = x-store-code
     2008             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2009         no-lock,
     2010   First clients  where  clients.obj-code = gds-obj.prod-code and
     2011                         clients.obj-type = gds-obj.prod-type
     2012                   no-lock,
     2013             First goods  where  gds-obj.gds-code   = goods.gds-code
     2014   no-lock
     2015   BREAK
     2016         BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2017       BY (temp-gds-list.artic) :
     2018         run item-goods ( "2" , "goods" ) .
     2019         if return-value <> "" then NEXT.
     2020           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2021           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2022             Then  Assign
     2023                     S-bar-code   = " Итого по "
     2024                     Gds-zap-artic = Substring(
     2025                                         B1-name
     2026                                         ,1,16)
     2027                     Gds-zap-gds-name = Substring(
     2028                                         B1-name
     2029                                         ,17,40)
     2030                                   .
     2031             Else  Assign
     2032                     S-bar-code   = ""
     2033                     Gds-zap-artic = "        Итого по "
     2034                     Gds-zap-gds-name =  B1-name
     2035                                   .
     2036               Run Display-b1 In This-procedure .
     2037               Run Clear-b1 In This-procedure .
     2038               Assign Break_Group = True.
     2039           End.
     2040       End.
     2041     END.
     2042     Else DO:
     2043      For each obj-list no-lock :
     2044                     FOR EACH gds-obj where
     2045                   gds-obj.obj-type = obj-list.obj-type    and
     2046                   gds-obj.obj-code = obj-list.obj-code
     2047                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2048                   no-lock :
     2049                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2050                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2051                       Create temp-gds-list.
     2052                       Assign
     2053                         temp-gds-list.prod-code = gds-obj.prod-code
     2054                         temp-gds-list.grp-name  = gds-obj.grp-name
     2055                         temp-gds-list.gds-name  = goods.gds-name
     2056                         temp-gds-list.gds-code  = gds-obj.gds-code
     2057                         temp-gds-list.artic     = gds-obj.artic
     2058                       .
     2059                   End.
     2060               End.
     2061     End.
     2062     for each temp-gds-list no-lock
     2063       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2064                                        , First clients   where  clients.obj-code = goods.prod-code and
     2065                                                                 clients.obj-type = goods.prod-type
     2066         BREAK
     2067   BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2068       BY temp-gds-list.artic :
     2069       run item-goods ( "2" , "goods" ) .
     2070         if return-value <> "" then NEXT.
     2071           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2072           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2073             Then  Assign
     2074                     S-bar-code   = " Итого по "
     2075                     Gds-zap-artic = Substring(
     2076                                         B1-name
     2077                                         ,1,16)
     2078                     Gds-zap-gds-name = Substring(
     2079                                         B1-name
     2080                                         ,17,40)
     2081                                   .
     2082             Else  Assign
