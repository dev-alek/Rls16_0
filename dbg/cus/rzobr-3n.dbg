     3149         p3 @ s-bar-code
     3150         p4 @ gds-zap-artic
     3151         p5 @ gds-zap-gds-name
     3152         p6 @ gds-zap-unit-base
     3153         p1 @ gds-type
     3154         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3155         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3156         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
