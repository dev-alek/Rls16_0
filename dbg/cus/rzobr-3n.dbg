     2431            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     2432            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     2433            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     2434            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
