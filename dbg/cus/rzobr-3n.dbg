     2094           when 2  then do:
     2095   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2096     if x-selectobject = "currency":u  or  xtog-obj then do:
     2097         for  each gds-obj
