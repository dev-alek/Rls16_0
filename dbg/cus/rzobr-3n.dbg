     2134                 where  gds-obj.obj-code   = obj-list.obj-code
     2135                   and  gds-obj.obj-type   = obj-list.obj-type
     2136                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2137                 no-lock ,
     2138                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2139                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2140                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2141                           create temp-gds-list.
     2142                           assign
