     2084                     Gds-zap-artic = "        Итого по "
     2085                     Gds-zap-gds-name =  B1-name
     2086                                   .
     2087               Run Display-b1 In This-procedure .
     2088               Run Clear-b1 In This-procedure .
     2089               Assign Break_Group = True.
     2090           End.
     2091     End.
