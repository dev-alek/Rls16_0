     2438   PROCEDURE display-B1  :
     2439         if NOT( NOT Show-Negativ-2 and
     2440            ( b1-prih         [1]   = 0 AND
     2441              b1-rash          [1]   = 0 AND
     2442              b1-kassa         [1]   = 0 AND
     2443              b1-Inv           [1]   = 0 AND
     2444              b1-Overturn      [1]   = 0 AND
     2445              b1-Overturn      [5]   = 0 AND
     2446              b1-Overturn      [8]   = 0 ) ) then DO:
     2447           IF  NOT (NOT Show-Negativ  AND (
     2448                 b1-prih          [1]   = 0 AND
     2449                 b1-rash          [1]   = 0 AND
     2450                 b1-kassa         [1]   = 0 AND
     2451                 b1-Inv           [1]   = 0 AND
     2452                 b1-Overturn      [1]   = 0 AND
     2453                 b1-Overturn      [5]   = 0 AND
     2454                 b1-ostatok-start [1]   = 0 AND
     2455                 b1-ostatok-End   [1]   = 0   )) then DO:
     2456                 if Sums-Only THEN do:
     2457                     if fr0 = true then do:
     2458                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2459                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2460                         fr0 = false .
     2461                       end.
     2462                  end.
     2463           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2464           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2465           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2466           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2467           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2468           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2469           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2470          if not sums-only then run p-line.
     2471    End.
     2472    end.
     2473   END PROCEDURE.
