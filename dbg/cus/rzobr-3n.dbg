     2188                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2189                 no-lock ,
     2190     first g#cli
     2191           where gds-obj.prod-code  = g#cli.obj-code
     2192           and  gds-obj.prod-type   = g#cli.obj-type
     2193           no-lock,
     2194     first goods
     2195           where gds-obj.gds-code = goods.gds-code no-lock
     2196           break
     2197           by ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2198           by temp-gds-list.artic :
     2199           run item-goods ( "2" , "goods" ) .
     2200           if return-value <> "" then next.
     2201           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2202           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2203             Then  Assign
     2204                     S-bar-code   = " Итого по "
     2205                     Gds-zap-artic = Substring(
     2206                                         B1-name
     2207                                         ,1,16)
     2208                     Gds-zap-gds-name = Substring(
     2209                                         B1-name
     2210                                         ,17,40)
     2211                                   .
     2212             Else  Assign
     2213                     S-bar-code   = ""
     2214                     Gds-zap-artic = "        Итого по "
     2215                     Gds-zap-gds-name =  B1-name
     2216                                   .
     2217               Run Display-b1 In This-procedure .
     2218               Run Clear-b1 In This-procedure .
     2219               Assign Break_Group = True.
     2220           End.
     2221         end.
     2222     end.
     2223     else do:
     2224       for each obj-list no-lock :
     2225             for  each gds-obj
     2226               where  gds-obj.obj-code   = obj-list.obj-code
     2227                 and  gds-obj.obj-type   = obj-list.obj-type
     2228                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2229                       no-lock ,
     2230             first g#cli
     2231                 where gds-obj.prod-code  = g#cli.obj-code
     2232                 and  gds-obj.prod-type   = g#cli.obj-type
     2233                 no-lock,
     2234             first goods
     2235                 where gds-obj.gds-code = goods.gds-code no-lock :
     2236                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2237                       create temp-gds-list.
     2238                       assign
     2239                         temp-gds-list.prod-code = gds-obj.prod-code
     2240                         temp-gds-list.grp-name  = gds-obj.grp-name
     2241                         temp-gds-list.gds-name  = goods.gds-name
     2242                         temp-gds-list.gds-code  = gds-obj.gds-code
     2243                         temp-gds-list.artic     = gds-obj.artic
     2244                       .
     2245                   end.
     2246             end.
     2247       end.
     2248         for each temp-gds-list no-lock
     2249           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2250             break
     2251               by ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2252               by temp-gds-list.artic :
     2253           run item-goods ( "2" , "goods" ) .
     2254             if return-value <> "" then next.
     2255           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2256           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
     2257             Then  Assign
     2258                     S-bar-code   = " Итого по "
     2259                     Gds-zap-artic = Substring(
     2260                                         B1-name
     2261                                         ,1,16)
     2262                     Gds-zap-gds-name = Substring(
     2263                                         B1-name
     2264                                         ,17,40)
     2265                                   .
     2266             Else  Assign
     2267                     S-bar-code   = ""
     2268                     Gds-zap-artic = "        Итого по "
     2269                     Gds-zap-gds-name =  B1-name
     2270                                   .
     2271               Run Display-b1 In This-procedure .
     2272               Run Clear-b1 In This-procedure .
     2273               Assign Break_Group = True.
     2274           End.
     2275         end.
     2276   end.
     2277     end.
     2278           otherwise do:
     2279   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2280   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2281       for each gds-obj  where
     2282             gds-obj.obj-type = x-store-type  and
     2283             gds-obj.obj-code = x-store-code
     2284             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2285         no-lock,
     2286   First clients  where  clients.obj-code = gds-obj.prod-code and
     2287                         clients.obj-type = gds-obj.prod-type
     2288                   no-lock,
     2289             First goods  where  gds-obj.gds-code   = goods.gds-code
     2290         no-lock,
     2291   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2292   no-lock
     2293   BREAK
     2294         BY ((substring(clients.obj-name,1,10) + string(gds-list.prod-code)))
     2295       BY (gds-list.artic) :
     2296         run item-goods ( "2" , "gds-list" ) .
     2297         if return-value <> "" then NEXT.
     2298           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     2299           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     2300             Then  Assign
     2301                     S-bar-code   = " Итого по "
     2302                     Gds-zap-artic = Substring(
     2303                                         B1-name
     2304                                         ,1,16)
     2305                     Gds-zap-gds-name = Substring(
     2306                                         B1-name
     2307                                         ,17,40)
     2308                                   .
     2309             Else  Assign
     2310                     S-bar-code   = ""
     2311                     Gds-zap-artic = "        Итого по "
     2312                     Gds-zap-gds-name =  B1-name
     2313                                   .
     2314               Run Display-b1 In This-procedure .
     2315               Run Clear-b1 In This-procedure .
     2316               Assign Break_Group = True.
     2317           End.
     2318       End.
     2319     END.
     2320     Else DO:
     2321      For each obj-list no-lock :
     2322                     FOR EACH gds-obj where
     2323                   gds-obj.obj-type = obj-list.obj-type    and
     2324                   gds-obj.obj-code = obj-list.obj-code
     2325                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2326                   no-lock,
     2327             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2328                   no-lock :
     2329                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2330                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2331                       Create temp-gds-list.
     2332                       Assign
     2333                         temp-gds-list.prod-code = gds-obj.prod-code
     2334                         temp-gds-list.grp-name  = gds-obj.grp-name
     2335                         temp-gds-list.gds-name  = goods.gds-name
     2336                         temp-gds-list.gds-code  = gds-obj.gds-code
     2337                         temp-gds-list.artic     = gds-obj.artic
     2338                       .
     2339                   End.
     2340               End.
     2341     End.
     2342     for each temp-gds-list no-lock
     2343       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2344                                        , First clients   where  clients.obj-code = gds-list.prod-code and
     2345                                                                 clients.obj-type = gds-list.prod-type
     2346         BREAK
     2347   BY ((substring(clients.obj-name,1,10) + string(gds-list.prod-code)))
     2348       BY gds-list.artic :
     2349       run item-goods ( "2" , "gds-list" ) .
     2350         if return-value <> "" then NEXT.
     2351           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     2352           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     2353             Then  Assign
     2354                     S-bar-code   = " Итого по "
     2355                     Gds-zap-artic = Substring(
     2356                                         B1-name
     2357                                         ,1,16)
     2358                     Gds-zap-gds-name = Substring(
     2359                                         B1-name
     2360                                         ,17,40)
     2361                                   .
     2362             Else  Assign
     2363                     S-bar-code   = ""
     2364                     Gds-zap-artic = "        Итого по "
     2365                     Gds-zap-gds-name =  B1-name
     2366                                   .
     2367               Run Display-b1 In This-procedure .
     2368               Run Clear-b1 In This-procedure .
     2369               Assign Break_Group = True.
     2370           End.
     2371     End.
     2372   End.
     2373           end.
     2374        end case.
     2375   end procedure.
     2376   PROCEDURE CalcItog :
     2377       run ostatok (
     2378           input x-store-code  ,
     2379           input x-store-type  ,x-TOG-Shift,
     2380           input x-date-start - 1 ,
     2381           input date('')      , x-Shift-Start,x-Shift-End,
     2382           input 'crsa':U   ,
     2383           input '##,##':U,
     2384           input xTog-obj ,
     2385           output  Quantity1  ,
     2386           output  Coast_R1   ,
     2387           output  Coast_V1   ,
     2388           output  VAT_R1     ,
     2389           output  VAT_V1     ,
     2390           output  Fact-order-1 ).
     2391       run ostatok (
     2392           input x-store-code  ,
     2393           input x-store-type  , x-TOG-Shift,
     2394           input x-date-start  ,
     2395           input x-date-end    , x-Shift-Start,x-Shift-End,
     2396           input 'crsa':U   ,
     2397           input '##,##':U,
     2398           input xTog-obj ,
     2399           output  Quantity1  ,
     2400           output  Coast_R1   ,
     2401           output  Coast_V1   ,
     2402           output  VAT_R1     ,
     2403           output  VAT_V1     ,
     2404           output  Fact-order-2 ).
     2405             Quantity1  = 0.
     2406             Coast_R1   = 0.
     2407             Coast_V1   = 0.
     2408             VAT_R1     = 0.
     2409             VAT_V1     = 0.
     2410   END PROCEDURE.
     2411   PROCEDURE display-str1  :
     2412              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2413            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2414            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2415            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2416            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2417            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2418            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2419   end procedure.
