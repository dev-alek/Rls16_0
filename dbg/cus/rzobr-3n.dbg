     2106                     by temp-gds-list.artic :
     2107                     run item-goods ( input "2" , input "goods" ) .
     2108                     if return-value <> "" then next.
     2109           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
     2110           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))",".")) = "Grp-name"
