     3196         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3197         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3198         with FRAME ZAPAS .
