     1536   procedure lhistprex-print-cli-list-hist-excel :
     1537   define input parameter p-text  as logical no-undo .
     1538   define input parameter p-excel as logical no-undo .
     1539   define input parameter p-sheet-num as integer no-undo .
     1540   define buffer buf_lh-sheetf for sheetf.
     1541   define buffer buf_cli-list-hist for cli-list-hist.
     1542     do
     1543     on error undo, return error
     1544     :
     1545       find first buf_cli-list-hist no-lock where buf_cli-list-hist.id = 0 no-error .
     1546       if p-excel then do:
     1547         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1548         FInd first buf_lh-Sheetf where
     1549                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1550         if not avail buf_lh-sheetf then
     1551         create buf_lh-sheetf.
     1552         assign
     1553         buf_lh-Sheetf.Sheet-num = 2
     1554         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1555         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1556         .
     1557         run rep/extitlee.p (input p-sheet-num
     1558                       , input  substitute("История создания списка &1 &2"
     1559                                   ,
     1560   'клиентов'
     1561                                   ,(if available buf_cli-list-hist
     1562                                   then buf_cli-list-hist.des
     1563                                   else "БЕЗЫМЯННЫЙ"))
     1564                       ) .
     1565       end.
     1566       if p-text then do:
     1567         Page stream PrnLibStream.
     1568         PUT  STREAM PrnLibStream unformatted
     1569         SPACE(25) substitute("История создания списка &1 &2"
     1570                             , 'клиентов'
     1571                             ,(if available buf_cli-list-hist
     1572                             then buf_cli-list-hist.des
     1573                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1574         space(25) cur-time-print() skip(1)
     1575         .
     1576         put stream PrnLibStream unformatted
     1577         string("№", "X(9)") chr(32)
     1578         string("Действие", "X(9)") chr(32)
     1579         string("записей", "X(9)") chr(32)
     1580         string(" = итого", "X(12)") chr(32)
     1581         (if page-size(PrnLibStream) > 43
     1582         then string("Множество", "X(" + string(136 - 43) + ")")
     1583         else string("Множество", "X(" + string(198 - 43) + ")")
     1584         )
     1585         skip(0)
     1586         fill('-':U, 9) chr(32)
     1587         fill('-':U, 9) chr(32)
     1588         fill('-':U, 9) chr(32)
     1589         fill('-':U, 12) chr(32)
     1590         (if page-size(PrnLibStream) > 43
     1591         then fill('-':U, 136 - 43)
     1592         else fill('-':U, 198 - 43))
     1593         skip(0)
     1594         .
     1595       end.
     1596       for each buf_cli-list-hist where buf_cli-list-hist.id > 0
     1597       by buf_cli-list-hist.id
     1598       :
     1599         if p-text then do:
     1600           put stream PrnLibStream unformatted
     1601           (if buf_cli-list-hist.line = 0
     1602           then string(buf_cli-list-hist.id, ">>>>>>>>9")
     1603           else fill(chr(32) , 9)
     1604           )  chr(32)
     1605           (if buf_cli-list-hist.item_ <> '':U
     1606           then string(buf_cli-list-hist.hist-mode, "X(8)")
     1607           else fill( chr(32), 8)) chr(32)
     1608           string(buf_cli-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1609           string(buf_cli-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1610           (if page-size(PrnLibStream) > 43
     1611           then string(buf_cli-list-hist.des, "X(" + string(136 - 43) + ")")
     1612           else string(buf_cli-list-hist.des, "X(" + string(198 - 43) + ")"))
     1613           skip.
     1614         end.
     1615         if p-excel then do:
     1616           if Make-Excel then  put   stream ForExcel unformatted
     1617           (if buf_cli-list-hist.line = 0
     1618           then string(buf_cli-list-hist.id, ">>>>>>>>9")
     1619           else '':U)
     1620           CHR(9)
     1621           (if buf_cli-list-hist.item_ <> '':U
     1622           then buf_cli-list-hist.hist-mode
     1623           else '':U)  CHR(9)
     1624           (if buf_cli-list-hist.item_ <> '':U
     1625           then string(buf_cli-list-hist.num-add, "->>>>>>>>9")
     1626           else '':U)  CHR(9)
     1627           (if buf_cli-list-hist.item_ <> '':U
     1628           then string(buf_cli-list-hist.num-recs, ">>>>>>>>9")
     1629           else '':U)  CHR(9)
     1630           buf_cli-list-hist.des
     1631           skip.
     1632         end.
     1633       end.
     1634     end.
     1635   end procedure.
     1636   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   define variable State-source as Widget-handle no-undo.
     1638   define variable StrBuf              as character         no-undo.
     1639   define variable Line            as character         no-undo.
     1640   define variable sym1            as character   init ":"      no-undo.
     1641   define variable sym2            as character   init ":"      no-undo.
     1642   define variable sym3            as character   init ":"      no-undo.
     1643   define variable ii                      as  integer     no-undo.
     1644   define variable i as integer no-undo.
     1645   define variable namebuf1     as      character    no-undo.
     1646   define variable namebuf2     as      character    no-undo.
     1647   define variable cliMode as character no-undo init "ALL".
     1648   define variable v-curr-r-b as character no-undo .
     1649   DEFINE VARIABLE selectcli AS CHARACTER INITIAL "ALL"
     1650        VIEW-AS RADIO-SET VERTICAL
     1651        RADIO-BUTTONS
     1652             "Все", "All":U,
     1653   "Выборочно по клиентам", "LIST":U
     1654        SIZE 29 BY 2.71 NO-UNDO.
     1655   DEFINE RECTANGLE RECT-client
     1656        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1657        SIZE 32.38 BY 6.92.
     1658   DEFINE VARIABLE t-zero AS LOGICAL INITIAL no
     1659        LABEL "Выводить нулевые обороты"
     1660        VIEW-AS TOGGLE-BOX
     1661        SIZE 28 BY 1 NO-UNDO.
     1662   DEFINE FRAME F-Main
     1663        selectcli AT ROW 2.29 COL 3 NO-LABEL
     1664        t-zero AT ROW 6 COL 3.5
     1665        "Покупатели:" VIEW-AS TEXT
     1666             SIZE 28 BY .96 AT ROW 1.33 COL 3
     1667             FGCOLOR 4
     1668        RECT-client AT ROW 1.13 COL 1.5
     1669       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1670            SIDE-LABELS NO-UNDERLINE THREE-D
     1671            AT COL 1 ROW 1
     1672            SIZE 58.13 BY 15.21.
     1673   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1674   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1675   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1676   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1677   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1678   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1679   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1680   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1681       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1682   RUN ensure-broker.
     1683   THIS-PROCEDURE:ADM-DATA =
     1684        'ADM1.1~`':U +
     1685        'SmartObject~`':U +
     1686        'FRAME~`':U +
     1687        'NO ~`':U +
     1688        '~`':U +
     1689        '~`':U +
     1690        '~`':U +
     1691        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1692           + "~`":U +
     1693        'Layout,Hide-on-Init~`':U +
     1694        '~`':U +
     1695        '~`':U +
     1696        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1697        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1698            THEN "^^":U
     1699        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1700             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1701   PROCEDURE adm-apply-entry :
     1702     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1703   END PROCEDURE.
     1704   PROCEDURE adm-destroy :
     1705    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1706   END PROCEDURE.
     1707   PROCEDURE adm-disable :
     1708       DISABLE RECT-client selectcli t-zero WITH FRAME F-Main.
     1709       RUN dispatch ('disable-fields':U).
     1710       RUN set-attribute-list ('ENABLED=no':U).
     1711       RETURN.
     1712   END PROCEDURE.
     1713   PROCEDURE adm-edit-attribute-list :
     1714         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1715         RETURN.
     1716   END PROCEDURE.
     1717   PROCEDURE adm-enable :
     1718       ENABLE UNLESS-HIDDEN RECT-client selectcli t-zero WITH FRAME F-Main.
     1719       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1720       RUN set-attribute-list ('ENABLED=yes':U).
     1721       RETURN.
     1722   END PROCEDURE.
     1723   PROCEDURE adm-exit :
     1724        RUN notify ('exit':U).
     1725     RETURN.
     1726   END PROCEDURE.
     1727   PROCEDURE adm-hide :
     1728     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1729   END PROCEDURE.
     1730   PROCEDURE adm-initialize :
     1731     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1732   END PROCEDURE.
     1733   PROCEDURE adm-show-errors :
     1734       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1735       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1736           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1737       END.
     1738       RETURN.
     1739   END PROCEDURE.
     1740   PROCEDURE adm-UIB-mode :
     1741     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1742   END PROCEDURE.
     1743   PROCEDURE adm-view :
     1744     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1745   END PROCEDURE.
     1746   PROCEDURE dispatch :
     1747       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1748       RUN broker-dispatch IN adm-broker-hdl
     1749           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1750       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1751   END PROCEDURE.
     1752   PROCEDURE ensure-broker :
     1753   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1754   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1755   DO:
     1756       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1757       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1758   END.
     1759   END PROCEDURE.
     1760   PROCEDURE get-attribute :
     1761     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1762     RUN broker-get-attribute IN adm-broker-hdl
     1763         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1764     RETURN RETURN-VALUE.
     1765   END PROCEDURE.
     1766   PROCEDURE get-attribute-list :
     1767     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1768     RUN broker-get-attribute-list IN adm-broker-hdl
     1769         (INPUT THIS-PROCEDURE,
     1770          INPUT ?,
     1771          OUTPUT p-attr-list) NO-ERROR.
     1772     RETURN.
     1773   END PROCEDURE.
     1774   PROCEDURE new-state :
     1775     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1776     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1777     RETURN.
     1778   END PROCEDURE.
     1779   PROCEDURE notify :
     1780     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1781     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1782     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1783         RETURN "ADM-ERROR":U.
     1784     RETURN.
     1785   END PROCEDURE.
     1786   PROCEDURE set-attribute-list :
     1787     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1788     RUN ensure-broker.
     1789     RUN broker-set-attribute-list IN adm-broker-hdl
     1790         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1791     RETURN.
     1792   END PROCEDURE.
     1793   PROCEDURE set-position :
     1794       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1795       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1796       IF VALID-HANDLE(adm-object-hdl) THEN
     1797       DO:
     1798           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1799           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1800           DO:
     1801             IF p-row = 0 THEN p-row =
     1802               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1803             IF p-col = 0 THEN p-col =
     1804               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1805           END.
     1806           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1807           DO:
     1808             parent-hdl = adm-object-hdl:PARENT.
     1809             IF p-row = 0 THEN p-row =
     1810               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1811                 parent-hdl:ROW.
     1812             IF p-col = 0 THEN p-col =
     1813               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1814                 parent-hdl:COL.
     1815           END.
     1816           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1817           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1818         ASSIGN adm-object-hdl:ROW    =   p-row
     1819                adm-object-hdl:COLUMN =   p-col.
     1820       END.
     1821       RETURN.
     1822   END PROCEDURE.
     1823   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1824       STRING(adm-object-hdl)).
     1825   PAUSE 0 BEFORE-HIDE.
     1826   PROCEDURE adm-change-page :
     1827     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1828     END PROCEDURE.
     1829   PROCEDURE delete-page :
     1830     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1831     RUN broker-delete-page IN adm-broker-hdl
     1832         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1833     END PROCEDURE.
     1834   PROCEDURE init-object :
     1835     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1836     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1837     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1838     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1839     RUN broker-init-object IN adm-broker-hdl
     1840         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1841          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
