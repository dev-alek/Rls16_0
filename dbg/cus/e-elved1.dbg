     1843   END PROCEDURE.
     1844   PROCEDURE init-pages :
     1845     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1846     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1847         INPUT p-page-list) NO-ERROR.
     1848     END PROCEDURE.
     1849   PROCEDURE select-page :
     1850     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1851     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1852         INPUT p-page#) NO-ERROR.
     1853     END PROCEDURE.
     1854   PROCEDURE view-page :
     1855     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1856     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1857         INPUT p-page#).
     1858     END PROCEDURE.
     1859   ON VALUE-CHANGED OF selectcli IN FRAME F-Main
     1860   DO:
     1861     assign selectcli.
     1862     CASE selectcli:
     1863       when "LIST":U then do:
     1864         run str/cli-list.w ( input my-handle
     1865                         ,input v-cntxt-host-code-obj
     1866                         ,input v-cntxt-obj-type
     1867                         ,input v-cntxt-obj-code).
     1868         assign
     1869         cliMode = "LIST":U
     1870         .
     1871         find first cli-list no-lock no-error .
     1872         if not available cli-list then do:
     1873           message
     1874           "В списке клиентов нет ни одного клиента"
     1875           view-as alert-box WARNING.
     1876           assign
     1877           selectcli = "all":U
     1878           cliMode  = "ALL":U
     1879           .
     1880         end.
     1881       end.
     1882       when "all":U then do:
     1883         assign
     1884         cliMode = "ALL":U
     1885         .
     1886       end.
     1887    END CASE.
     1888    display selectcli with frame F-Main.
     1889   END.
     1890   if not this-procedure :persistent
     1891   then do:
     1892     message
     1893       vss-workfile vss-revision vss-description skip
     1894       "Ошибка при запуске процедуры" skip
     1895       "Данную процедуру следует запускать только с параметром persistent" skip
     1896       view-as alert-box error .
     1897     undo, return error .
     1898   end.
     1899   PROCEDURE adm-create-objects :
     1900   END PROCEDURE.
     1901   PROCEDURE adm-row-available :
     1902     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1903     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1904     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1905     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1906     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1907     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1908     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1909     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1910     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1911     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1912     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1913     IF adm-updating-record THEN RETURN.
     1914     RUN get-attribute ('FIELDS-ENABLED':U).
     1915     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1916     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1917         OUTPUT link-handle) NO-ERROR.
     1918     IF link-handle = "":U THEN
     1919         RETURN.
     1920     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1921     IF NUM-ENTRIES(link-handle) > 1 THEN
     1922         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1923             "encountered more than one RECORD-SOURCE.":U SKIP
     1924             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1925                VIEW-AS ALERT-BOX ERROR.
     1926     RUN get-attribute ('Key-Name':U).
     1927     key-name = RETURN-VALUE.
     1928     IF key-name = "":U THEN key-name = ?.
     1929     IF key-name NE ? THEN DO:
     1930       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1931         NO-ERROR.
     1932       IF key-value NE ? THEN
     1933         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1934     END.
     1935   IF VALID-HANDLE (adm-object-hdl) THEN
     1936       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1937   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1938   END PROCEDURE.
     1939   PROCEDURE disable_UI :
     1940     HIDE FRAME F-Main.
     1941     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1942   END PROCEDURE.
     1943   PROCEDURE enable_UI :
     1944     DISPLAY selectcli t-zero
     1945         WITH FRAME F-Main.
     1946     ENABLE RECT-client selectcli t-zero
     1947         WITH FRAME F-Main.
     1948   END PROCEDURE.
     1949   PROCEDURE local-initialize :
     1950     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1951   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1952   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1953     (output v-curr-r-b
     1954     )  .
     1955     parparentproc = my-handle.
     1956   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1957     run mainmenu_getcntxt in parparentproc
     1958       (output v-cntxt-db-num
     1959       ,output v-cntxt-userid
     1960       ,output v-cntxt-level
     1961       ,output v-cntxt-host-code-obj
     1962       ,output v-cntxt-obj-type
     1963       ,output v-cntxt-obj-code
     1964       ,output v-cntxt-db-num-obj
     1965       ,output v-cntxt-is-admin
     1966       ) .
     1967   END PROCEDURE.
     1968   PROCEDURE My-report :
     1969   define variable v-header-base-curr as character no-undo .
     1970   define variable accum-sum-cli      as decimal no-undo .
     1971   define variable v-d-card           like ub.dis-card.d-card no-undo .
     1972   define variable v-ii as integer no-undo .
     1973   define variable stream-pos as integer no-undo .
     1974   define variable v-root-card like ub.dis-card.d-card no-undo .
     1975   define variable ii as integer no-undo .
     1976   define variable v-base-code like ub.sysconf.base-code no-undo .
     1977   define buffer buf_dis-card for ub.dis-card.
     1978   define buffer buf_ext-classif for ub.ext-classif.
     1979   define buffer buf_clients for ub.clients.
     1980   DEFINE FRAME X123
     1981   sym1 column-label ":!:" format "X(1)"
     1982   dcards.cli-name column-label "Наименование организации" format "X(105)"
     1983   sym2 column-label ":!:" format "X(1)"
     1984   dcards.sum column-label "Реализация, руб" format "->,>>>,>>>,>>9.99"
     1985   sym3 column-label ":!:" format "X(1)"
     1986   HEADER
     1987   cur-time-print() AT 5 format "x(35)"
     1988   "Страница " AT 100 PAGE-NUMBER( PrnLibStream ) AT 110 FORMAT ">>>>9" SKIP
     1989   Line format "X(134)" AT 1
     1990   with width 136 down stream-io use-text .
     1991   assign
     1992   sheetf.Excel-Column-Lable =
     1993   "Наименование организации" + chr(44) +
     1994   "Реализация руб"
     1995   sheetf.sizes =
     1996   "105" + chr(44) +
     1997   "16"
     1998   str3 = " "
     1999   .
     2000   assign
     2001   frame F-Main selectcli
     2002   .
     2003   run My-var IN THIS-PROCEDURE.
     2004   run waitfram-show in this-procedure ( "Подождите ..." ) .
     2005   CASE cliMode:
     2006     when "ALL":U then do:
     2007         run cus/e-elvd1q.p (
     2008                         input "ALL":U
     2009                       ,input X-date-Start
     2010                       ,input X-date-End
     2011                       )
     2012                 .
     2013     end.
     2014     when "LIST":U then do:
     2015         run cus/e-elvd1q.p (
     2016                         input "LIST":U
     2017                         ,input X-date-Start
     2018                         ,input X-date-End
     2019                         )
     2020                 .
     2021     end.
     2022   end.
     2023   run waitfram-hide in this-procedure .
     2024   if can-find( first dcards ) then do:
     2025       run rep/extitle.p ( input 1 ).
     2026       run prn-lib-open-stream  in this-procedure (
     2027                                                    input my-handle
     2028                                                   ,input 62
     2029                                                   ,input yes
     2030                                                   ,input no
     2031                                                   ).
     2032       Line = fill( "-", 134 ) .
     2033       FORM HEADER
     2034       Line format "X(134)" AT 1 SKIP
     2035       "Продолжение - на следующей странице" AT 30 SKIP
     2036       with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     2037       VIEW stream PrnLibStream FRAME BottomFrame .
     2038       PUT stream PrnLibStream
     2039       space(40)
     2040       "Сводный баланс" skip
     2041       space(40) str1 format "X(110)" skip(0).
     2042       PUT stream PrnLibStream "" skip .
     2043       CASE cliMode:
     2044         when "ALL":U then do:
     2045           PUT stream PrnLibStream space(20) "По ВСЕМ клиентам." format "x(40)" skip.
     2046         end.
     2047         when "LIST" then do:
     2048          PUT stream PrnLibStream space(10) string("По сформированному списку клиентов") format "x(50)" .
     2049          ii = 0.
     2050          for each cli-list no-lock:
     2051             ii = ii + 1.
     2052          end.
     2053          PUT stream PrnLibStream unformatted substitute("В списке &1 кл.", ii) skip.
     2054        end.
     2055       END CASE.
     2056       form with frame X123.
     2057       _clients:
     2058       FOR EACH buf_clients no-lock
     2059       by buf_clients.obj-name:
     2060         if climode = "LIST" then do:
     2061           find first cli-list no-lock where
     2062                     cli-list.obj-type = buf_clients.obj-type
     2063                 and cli-list.obj-code = buf_clients.obj-code no-error .
     2064           if not available cli-list then next _clients.
     2065         end.
     2066         find first dcards no-lock where
     2067             dcards.cli-type = buf_clients.obj-type
     2068         and dcards.cli-code = buf_clients.obj-code no-error .
     2069         if available dcards then do:
     2070           assign
     2071           accum-sum-cli      = accum-sum-cli + dcards.sum
     2072           .
     2073           DISPLAY stream PrnLibStream
     2074           sym1
     2075           dcards.cli-name
     2076           sym2
     2077           dcards.sum
     2078           sym3
     2079           with frame X123.
     2080           down 1 stream prnlibstream
     2081           with frame X123.
     2082           if Make-Excel then  put   stream ForExcel unformatted
     2083           dcards.cli-name CHR(9)
     2084           dcards.sum
     2085           skip.
     2086         end.
     2087         else do:
     2088           IF t-zero THEN DO:
     2089             if not can-find( first buf_dis-card no-lock
     2090                                where buf_dis-card.cli-type = buf_clients.obj-type
     2091                                  and buf_dis-card.cli-code = buf_clients.obj-code )
     2092             then
     2093               next _clients.
     2094             DISPLAY stream PrnLibStream
     2095             sym1
     2096             buf_clients.obj-name @ dcards.cli-name
     2097             sym2
     2098             0.0 @ dcards.sum
     2099             sym3
     2100             with frame X123.
     2101             down 1 stream prnlibstream
     2102             with frame X123.
     2103             if Make-Excel then  put   stream ForExcel unformatted
     2104             buf_clients.obj-name CHR(9)
     2105             0.0
     2106             skip.
     2107           END.
     2108         end.
     2109       end.
     2110       UNDERLINE stream PrnLibStream
     2111       dcards.cli-name
     2112       dcards.sum
     2113       with frame X123 .
     2114       DISPLAY stream PrnLibStream
     2115       sym1
     2116       "ИТОГО" @ dcards.cli-name
     2117       sym2
     2118       accum-sum-cli  @ dcards.sum
     2119       sym3
     2120       with frame X123.
     2121       if Make-Excel then  put   stream ForExcel unformatted
     2122       "ИТОГО" CHR(9)
     2123       accum-sum-cli
     2124       skip.
     2125       HIDE stream PrnLibStream FRAME BottomFrame .
     2126       if Print-List-hist
     2127       and selectcli = 'LIST' then do:
     2128         run lhistprex-print-cli-list-hist-excel  in this-procedure (input yes, input yes, 2).
     2129       end.
     2130       output stream PrnLibStream CLOSE .
     2131        if Make-Excel then output stream ForExcel close.
     2132      run prn-lib-prn-file in this-procedure (
     2133                                             input my-handle
     2134                                             ,input 0
     2135                                             ).
     2136   end.
     2137   else
     2138   message
     2139   "На выбранных Вами объектах" skip
     2140   "не было продаж постоянным клиентам" skip
     2141   "в течение заданного Вами периода времени."
     2142   view-as alert-box INFORMATION .
     2143   FOR EACH dcards :
     2144       delete dcards .
     2145   END.
     2146   END PROCEDURE.
     2147   PROCEDURE My-Var :
     2148   assign
     2149   frame F-Main selectcli
     2150   t-zero
     2151   .
     2152   Assign
     2153    STR-obj-type = ''
     2154    STR-obj-code = ''
     2155    STR-obj-name = ''
     2156    STR-obj      = ''.
     2157   For each obj-list no-lock:
     2158    Assign
     2159    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2160    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2161    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2162    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2163   End.
     2164   Reportname = "Сводная ведомость по клиентам".
     2165   ReportHeader = SUBSTITUTE("&1", IF t-zero = NO THEN "Нулевые обороты не выводятся" ELSE '':U) + chr(10) +
     2166       "Клиенты: " +
     2167                              radio-label(string(selectcli), selectcli:radio-buttons) + chr(10)
     2168                    .
     2169   END PROCEDURE.
     2170   PROCEDURE send-records :
     2171   END PROCEDURE.
     2172   PROCEDURE state-changed :
     2173     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2174     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2175   END PROCEDURE.
