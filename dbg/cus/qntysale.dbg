     2098   procedure prdoclib-clear-temp-prt-obj :
     2099     define buffer buf_temp-prt-obj for temp-prt-obj .
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       for each buf_temp-prt-obj
     2104       on error undo, return error return-value
     2105       :
     2106         delete buf_temp-prt-obj .
     2107       end.
     2108     end.
     2109   end procedure.
     2110   procedure prdoclib-create-temp-prt-obj :
     2111     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2112     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2113     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2114     define buffer buf_gds-prt for ub.gds-prt .
     2115     do
     2116     on error undo, return error return-value
     2117     :
     2118       find first buf_temp-prt-obj
     2119         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2120         no-error .
     2121       if not available buf_temp-prt-obj
     2122       then do:
     2123         create buf_temp-prt-obj .
     2124         assign
     2125           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2126           buf_temp-prt-obj.price-sale       = ?
     2127           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2128           buf_temp-prt-obj.price-list-qnty  = ?
     2129           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2130           buf_temp-prt-obj.price-list-recid = ?
     2131         .
     2132         find first buf_gds-prt no-lock
     2133           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2134           .
     2135         assign
     2136           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2137         .
     2138         if buf_temp-prt-obj.is-term
     2139         then do:
     2140           assign
     2141             buf_temp-prt-obj.price-sale = p-root-price-sale
     2142           .
     2143         end.
     2144       end.
     2145     end.
     2146   end procedure.
     2147   procedure prdoclib-temp-prt-obj-by-prt-root :
     2148     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2149     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2150     define buffer buf_gds-prt for ub.gds-prt .
     2151     do
     2152     on error undo, return error return-value
     2153     :
     2154       find first buf_temp-prt-obj
     2155         where buf_temp-prt-obj.prt-code = p-prt-code
     2156         no-error .
     2157       if not available buf_temp-prt-obj
     2158       then do:
     2159         create buf_temp-prt-obj .
     2160         assign
     2161           buf_temp-prt-obj.prt-code         = p-prt-code
     2162           buf_temp-prt-obj.price-sale       = ?
     2163           buf_temp-prt-obj.fact-qnty        = 0
     2164           buf_temp-prt-obj.price-list-qnty  = ?
     2165           buf_temp-prt-obj.prt-obj-recid    = ?
     2166           buf_temp-prt-obj.price-list-recid = ?
     2167         .
     2168         find first buf_gds-prt no-lock
     2169           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2170           .
     2171         assign
     2172           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2173         .
     2174         if buf_temp-prt-obj.is-term
     2175         then do:
     2176           assign
     2177             buf_temp-prt-obj.price-sale = 0
     2178           .
     2179         end.
     2180       end.
     2181     end.
     2182   end procedure.
     2183   procedure prdoclib-init-temp-prt-obj :
     2184     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2185     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2186     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2187     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2188     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2189     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2190     define buffer buf_prt-obj      for ub.prt-obj .
     2191     define buffer buf_temp-prt-obj for temp-prt-obj .
     2192     do
     2193     on error undo, return error return-value
     2194     :
     2195       run prdoclib-clear-temp-prt-obj in this-procedure .
     2196       for each buf_prt-obj
     2197         where buf_prt-obj.obj-type  = p-obj-type
     2198           and buf_prt-obj.obj-code  = p-obj-code
     2199           and buf_prt-obj.artic     = p-artic
     2200           and buf_prt-obj.prod-type = p-prod-type
     2201           and buf_prt-obj.prod-code = p-prod-code
     2202       on error undo, return error return-value
     2203       :
     2204         run prdoclib-create-temp-prt-obj in this-procedure
     2205           (input  p-root-price-sale
     2206           ,buffer buf_prt-obj
     2207           ,buffer buf_temp-prt-obj
     2208           ).
     2209       end.
     2210     end.
     2211   end procedure.
     2212   procedure prdoclib-calc-fact-sale :
     2213     define input  parameter p-price-list-recid   as recid     no-undo .
     2214     define output parameter p-fact-qnty          as decimal   no-undo .
     2215     define output parameter p-cur-base           as decimal   no-undo .
     2216     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2217     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2218     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2219     define output parameter p-cur-excise-base    as decimal   no-undo .
     2220     define buffer buf_main_price-list for ub.price-list .
     2221     define buffer buf_price-list      for ub.price-list .
     2222     define buffer buf_goods           for ub.goods .
     2223     define buffer buf_gds-obj         for ub.gds-obj .
     2224     define buffer buf_bar-code        for ub.bar-code .
     2225     define variable l-empty-scale   as logical   no-undo .
     2226     do
     2227     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2228     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2229     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2230     :
     2231       find first buf_main_price-list no-lock
     2232         where recid(buf_main_price-list) = p-price-list-recid
     2233         no-error .
     2234       if not available buf_main_price-list
     2235       then do:
     2236         message
     2237           vss-workfile vss-revision vss-description skip
     2238           vss-include-info12 skip
     2239           "Ошибка задания входных параметров" skip
     2240           "Не найдена строка переоценки" skip
     2241           "Код записи (recid)" p-price-list-recid skip
     2242           view-as alert-box error .
     2243         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2244       end.
     2245       if buf_main_price-list.main-price <> true
     2246       then do:
     2247         message
     2248           vss-workfile vss-revision vss-description skip
     2249           vss-include-info12 skip
     2250           "Ошибка задания входных параметров" skip
     2251           "Строка переоценки не является основной" skip
     2252           "Код записи (recid)" p-price-list-recid skip
     2253           "Переоценка" buf_main_price-list.doc-num skip
     2254           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2255           "Бар-код" buf_main_price-list.b-code skip
     2256           view-as alert-box error .
     2257         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2258       end.
     2259       find first buf_goods no-lock
     2260         where buf_goods.artic     = buf_main_price-list.artic
     2261           and buf_goods.prod-type = buf_main_price-list.prod-type
     2262           and buf_goods.prod-code = buf_main_price-list.prod-code
     2263         no-error .
     2264       if not available buf_goods
     2265       then do:
     2266         message
     2267           vss-workfile vss-revision vss-description skip
     2268           vss-include-info12 skip
     2269           "Не найден товар" skip
     2270           "Переоценка" buf_main_price-list.doc-num skip
     2271           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2272           view-as alert-box error .
     2273         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2274       end.
     2275   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2277     (input  buf_main_price-list.artic
     2278     ,input  buf_main_price-list.prod-type
     2279     ,input  buf_main_price-list.prod-code
     2280     ,input  'empty-scale=request':u
     2281     ,output l-empty-scale
     2282     ) no-error .
     2283       if error-status :error
     2284       then do:
     2285         message
     2286           vss-workfile vss-revision vss-description skip
     2287           vss-include-info12 skip
     2288           "Ошибка при определении атрибута товара" skip
     2289           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2290           'empty-scale=request':u skip
     2291           error-status :get-message(1) skip
     2292           return-value skip
     2293           view-as alert-box error .
     2294         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2295       end.
     2296       find first buf_gds-obj no-lock
     2297         where buf_gds-obj.gds-code = buf_goods.gds-code
     2298           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     2299           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     2300         no-error .
     2301         if not available buf_gds-obj then do:
     2302   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2303   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2304     (input  buf_main_price-list.obj-type
     2305     ,input  buf_main_price-list.obj-code
     2306     ,input  buf_goods.artic
     2307     ,input  buf_goods.prod-type
     2308     ,input  buf_goods.prod-code
     2309     ,buffer buf_gds-obj
     2310     ) no-error .
     2311           if error-status :error then do:
     2312              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2313           end.
     2314         end.
     2315       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2316       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2317       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2318       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2319       define variable vat-base-sale-prl               as decimal   no-undo .
     2320       define variable vat-rubl-sale-prl               as decimal   no-undo .
     2321       define variable vat-base-buyer-prl              as decimal   no-undo .
     2322       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2323       define variable slt-base-sale-prl               as decimal   no-undo .
     2324       define variable slt-rubl-sale-prl               as decimal   no-undo .
     2325       define variable road-tax-base-sale-prl          as decimal   no-undo .
     2326       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2327       define variable excise-base-sale-prl            as decimal   no-undo .
     2328       define variable excise-rubl-sale-prl            as decimal   no-undo .
     2329       define variable discnt-base-sale-prl            as decimal   no-undo .
     2330       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2331       if buf_main_price-list.doc-qnty <> 0
     2332       then do:
     2333         run prl-vat in this-procedure
     2334           (input  recid(buf_main_price-list)
     2335           ,output price-rubl-with-tax-sale-prl
     2336           ,output price-base-with-tax-sale-prl
     2337           ,output price-rubl-without-tax-sale-prl
     2338           ,output price-base-without-tax-sale-prl
     2339           ,output vat-base-sale-prl
     2340           ,output vat-rubl-sale-prl
     2341           ,output vat-base-buyer-prl
     2342           ,output vat-rubl-buyer-prl
     2343           ,output slt-base-sale-prl
     2344           ,output slt-rubl-sale-prl
     2345           ,output road-tax-base-sale-prl
     2346           ,output road-tax-rubl-sale-prl
     2347           ,output excise-base-sale-prl
     2348           ,output excise-rubl-sale-prl
     2349           ,output discnt-base-sale-prl
     2350           ,output discnt-rubl-sale-prl
     2351           ) no-error .
     2352         if error-status :error
     2353         then do:
     2354           message
     2355             vss-workfile vss-revision vss-description skip
     2356             vss-include-info12 skip
     2357             "Ошибка при вызове процеды prl-vat" skip
     2358             "Документ" buf_main_price-list.doc-num skip
     2359             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2360             error-status :get-message(1) skip
     2361             return-value skip
     2362             view-as alert-box error .
     2363           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2364         end.
     2365       end.
     2366       else do:
     2367         assign
     2368           price-rubl-with-tax-sale-prl    = 0
     2369           price-base-with-tax-sale-prl    = 0
     2370           price-rubl-without-tax-sale-prl = 0
     2371           price-base-without-tax-sale-prl = 0
     2372           vat-base-sale-prl               = 0
     2373           vat-rubl-sale-prl               = 0
     2374           vat-base-buyer-prl              = 0
     2375           vat-rubl-buyer-prl              = 0
     2376           slt-base-sale-prl               = 0
     2377           slt-rubl-sale-prl               = 0
     2378           road-tax-base-sale-prl          = 0
     2379           road-tax-rubl-sale-prl          = 0
     2380           excise-base-sale-prl            = 0
     2381           excise-rubl-sale-prl            = 0
     2382           discnt-base-sale-prl            = 0
     2383           discnt-rubl-sale-prl            = 0
     2384         .
     2385       end.
     2386       define variable v-curr-r-b as character no-undo .
     2387   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2389     (output v-curr-r-b
     2390     )  .
     2391       if v-curr-r-b = 'base':U
     2392       then do:
     2393         assign
     2394           p-fact-qnty         = buf_main_price-list.doc-qnty
     2395           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2396           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     2397           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     2398           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     2399           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     2400         .
     2401       end.
     2402       else do:
     2403         assign
     2404           p-fact-qnty         = buf_main_price-list.doc-qnty
     2405           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2406           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     2407           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     2408           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     2409           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     2410         .
     2411       end.
     2412         define variable v-unit-base like ub.goods.unit-base no-undo .
     2413   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2415     (input  buf_goods.gds-code
     2416     ,output v-unit-base
     2417     ) no-error .
     2418         if error-status :error
     2419         then do:
     2420           message
     2421             vss-workfile vss-revision vss-description skip
     2422             vss-include-info12 skip
     2423             "Ошибка при определении базовой единицы измерения товара" skip
     2424             "Код товара" buf_goods.gds-code skip
     2425             error-status :get-message(1) skip
     2426             return-value skip
     2427             view-as alert-box error .
     2428           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2429         end.
     2430         for each buf_price-list no-lock
     2431           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     2432             and buf_price-list.main-price = false
     2433             and buf_price-list.artic      = buf_main_price-list.artic
     2434             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     2435             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     2436         :
     2437           if buf_price-list.doc-qnty = ?
     2438           then do:
     2439             find first buf_bar-code no-lock
     2440               where buf_bar-code.b-code = buf_price-list.b-code
     2441               no-error .
     2442             if available buf_bar-code
     2443             and buf_bar-code.unit-cli = v-unit-base
     2444             then do:
     2445               message
     2446                 vss-workfile vss-revision vss-description skip
     2447                 vss-include-info12 skip
     2448                 "Ошибка при закрытии переоценки" skip
     2449                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2450                 "Переоценка" buf_main_price-list.doc-num skip
     2451                 "Бар-код" buf_price-list.b-code skip
     2452                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2453                 "Количество" buf_price-list.doc-qnty skip
     2454                 "Основная единица измерения" v-unit-base skip
     2455                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2456                 view-as alert-box error .
     2457               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2458             end.
     2459             next .
     2460           end.
     2461           if not can-find
     2462             (first buf_bar-code
     2463             where buf_bar-code.b-code = buf_price-list.b-code
     2464             )
     2465           then do:
     2466             message
     2467               vss-workfile vss-revision vss-description skip
     2468               vss-include-info12 skip
     2469               "В переоценке задан несуществующий бар-код" skip
     2470               "Переоценка" buf_price-list.doc-num skip
     2471               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2472               "Бар-код" buf_price-list.b-code skip
     2473               view-as alert-box error .
     2474             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2475           end.
     2476           if buf_price-list.doc-qnty <> 0
     2477           then do:
     2478             run prl-vat in this-procedure
     2479               (input  recid(buf_price-list)
     2480               ,output price-rubl-with-tax-sale-prl
     2481               ,output price-base-with-tax-sale-prl
     2482               ,output price-rubl-without-tax-sale-prl
     2483               ,output price-base-without-tax-sale-prl
     2484               ,output vat-base-sale-prl
     2485               ,output vat-rubl-sale-prl
     2486               ,output vat-base-buyer-prl
     2487               ,output vat-rubl-buyer-prl
     2488               ,output slt-base-sale-prl
     2489               ,output slt-rubl-sale-prl
     2490               ,output road-tax-base-sale-prl
     2491               ,output road-tax-rubl-sale-prl
     2492               ,output excise-base-sale-prl
     2493               ,output excise-rubl-sale-prl
     2494               ,output discnt-base-sale-prl
     2495               ,output discnt-rubl-sale-prl
     2496               ) no-error .
     2497             if error-status :error
     2498             then do:
     2499               message
     2500                 vss-workfile vss-revision vss-description skip
     2501                 vss-include-info12 skip
     2502                 "Ошибка при вызове процеды prl-vat" skip
     2503                 "Документ" buf_price-list.doc-num skip
     2504                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2505                 error-status :get-message(1) skip
     2506                 return-value skip
     2507                 view-as alert-box error .
     2508               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2509             end.
     2510           end.
     2511           else do:
     2512             assign
     2513               price-rubl-with-tax-sale-prl    = 0
     2514               price-base-with-tax-sale-prl    = 0
     2515               price-rubl-without-tax-sale-prl = 0
     2516               price-base-without-tax-sale-prl = 0
     2517               vat-base-sale-prl               = 0
     2518               vat-rubl-sale-prl               = 0
     2519               vat-base-buyer-prl              = 0
     2520               vat-rubl-buyer-prl              = 0
     2521               slt-base-sale-prl               = 0
     2522               slt-rubl-sale-prl               = 0
     2523               road-tax-base-sale-prl          = 0
     2524               road-tax-rubl-sale-prl          = 0
     2525               excise-base-sale-prl            = 0
     2526               excise-rubl-sale-prl            = 0
     2527               discnt-base-sale-prl            = 0
     2528               discnt-rubl-sale-prl            = 0
     2529             .
     2530           end.
     2531           if v-curr-r-b = 'base':U
     2532           then do:
     2533             assign
     2534               p-fact-qnty         = p-fact-qnty
     2535                                   + buf_price-list.doc-qnty
     2536               p-cur-base          = p-cur-base
     2537                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2538               p-cur-VAT-base      = p-cur-VAT-base
     2539                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2540               p-cur-SLT-base      = p-cur-SLT-base
     2541                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2542               p-cur-road-tax-base = p-cur-road-tax-base
     2543                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2544               p-cur-excise-base   = p-cur-excise-base
     2545                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2546             .
     2547           end.
     2548           else do:
     2549             assign
     2550               p-fact-qnty         = p-fact-qnty
     2551                                   + buf_price-list.doc-qnty
     2552               p-cur-base          = p-cur-base
     2553                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2554               p-cur-VAT-base      = p-cur-VAT-base
     2555                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2556               p-cur-SLT-base      = p-cur-SLT-base
     2557                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2558               p-cur-road-tax-base = p-cur-road-tax-base
     2559                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2560               p-cur-excise-base   = p-cur-excise-base
     2561                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2562             .
     2563           end.
     2564         end.
     2565     end.
     2566   end procedure.
     2567   procedure prdoclib-calc-prc :
     2568     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2569     define input  parameter p-cons-pay        as   integer                no-undo.
     2570     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2571     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2572     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2573     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2574     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2575     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2576     do
     2577     on error undo, return error return-value
     2578     :
     2579       define buffer buf_price-doc       for ub.price-doc .
     2580       define buffer buf_price-list      for ub.price-list .
     2581       define buffer buf_parts           for ub.parts .
     2582       define variable v-ov-qnty     as decimal   no-undo .
     2583       define variable v-ov-base     as decimal   no-undo .
     2584       define variable v-ov-VAT-base as decimal   no-undo .
     2585       define variable v-ov-SLT-base as decimal   no-undo .
     2586       define variable v-cons-qnty   as decimal   no-undo .
     2587       define variable v-prch-qnty   as decimal   no-undo .
     2588       define variable v-cons-mult   as decimal   no-undo .
     2589       define variable v-prch-mult   as decimal   no-undo .
     2590       find first buf_price-doc no-lock
     2591         where recid(buf_price-doc) = p-price-doc-recid
     2592         no-error .
     2593       if not available buf_price-doc
     2594       then do:
     2595         message
     2596           vss-workfile vss-revision vss-description skip
     2597           vss-include-info12 skip
     2598           "Ошибка задания входных параметров" skip
     2599           "Не найден документ переоценки" skip
     2600           "Код записи (recid)" p-price-doc-recid skip
     2601           view-as alert-box error .
     2602         undo, return error .
     2603       end.
     2604       for each buf_price-list no-lock
     2605         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2606           and buf_price-list.main-price = true
     2607       on error undo, return error return-value
     2608       :
     2609         run prdoclib-calc-ov
     2610           (input recid(buf_price-list)
     2611           ,output v-ov-qnty
     2612           ,output v-ov-base
     2613           ,output v-ov-VAT-base
     2614           ,output v-ov-SLT-base
     2615           ) no-error .
     2616         if error-status :error
     2617         then do:
     2618           if error-status :get-message(1) <> ""
     2619           then do:
     2620             message
     2621               vss-workfile vss-revision vss-description skip
     2622               vss-include-info12 skip
     2623               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2624               error-status :get-message(1) skip
     2625               return-value skip
     2626               view-as alert-box error .
     2627           end.
     2628           undo, return error return-value .
     2629         end.
     2630         assign
     2631           v-cons-qnty = 0
     2632           v-prch-qnty = 0
     2633         .
     2634         for each buf_parts no-lock
     2635           where buf_parts.out-code  = buf_price-list.doc-num
     2636             and buf_parts.obj-type  = buf_price-list.obj-type
     2637             and buf_parts.obj-code  = buf_price-list.obj-code
     2638             and buf_parts.artic     = buf_price-list.artic
     2639             and buf_parts.prod-type = buf_price-list.prod-type
     2640             and buf_parts.prod-code = buf_price-list.prod-code
     2641         on error undo, return error return-value
     2642         :
     2643           if buf_parts.pay-code = p-cons-pay
     2644           then do:
     2645             assign
     2646               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2647             .
     2648           end.
     2649           else do:
     2650             assign
     2651               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2652             .
     2653           end.
     2654         end.
     2655         if (v-cons-qnty + v-prch-qnty) = 0
     2656         then do:
     2657           assign
     2658             v-cons-mult = 0
     2659             v-prch-mult = 1
     2660           .
     2661         end.
     2662         else do:
     2663           assign
     2664             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2665             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2666           .
     2667         end.
     2668         assign
     2669           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2670           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2671           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2672           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2673           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2674           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2675         .
     2676       end.
     2677     end.
     2678   end procedure.
     2679   procedure prdoclib-calc-ov :
     2680     define input  parameter p-price-list-recid as recid     no-undo .
     2681     define output parameter p-fact-qnty        as decimal   no-undo .
     2682     define output parameter p-ov-base          as decimal   no-undo .
     2683     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2684     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2685     do
     2686     on error undo, return error return-value
     2687     :
     2688       define buffer buf_main_price-list    for ub.price-list .
     2689       define buffer buf_prev_price-list    for ub.price-list .
     2690       define buffer buf_special_price-list for ub.price-list .
     2691       define buffer buf_goods              for ub.goods .
     2692       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2693       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2694       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2695       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2696       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2697       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2698       define variable v-prev-price-list-recid as   recid                  no-undo.
     2699       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2700       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2701       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2702       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2703       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2704       find first buf_main_price-list no-lock
     2705         where recid(buf_main_price-list) = p-price-list-recid
     2706         no-error .
     2707       if not available buf_main_price-list
     2708       then do:
     2709         message
     2710           vss-workfile vss-revision vss-description skip
     2711           vss-include-info12 skip
     2712           "Ошибка задания входных параметров" skip
     2713           "Не найдена строка переоценки" skip
     2714           "Код записи (recid)" p-price-list-recid skip
     2715           view-as alert-box error .
     2716         undo, return error .
     2717       end.
     2718       if buf_main_price-list.main-price <> true
     2719       then do:
     2720         message
     2721           vss-workfile vss-revision vss-description skip
     2722           vss-include-info12 skip
     2723           "Ошибка задания входных параметров" skip
     2724           "Строка переоценки не является основной" skip
     2725           "Код записи (recid)" p-price-list-recid skip
     2726           "Переоценка" buf_main_price-list.doc-num skip
     2727           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2728           "Бар-код" buf_main_price-list.b-code skip
     2729           view-as alert-box error .
     2730         undo, return error .
     2731       end.
     2732       run prdoclib-calc-fact-sale in this-procedure
     2733         (input  recid(buf_main_price-list)
     2734         ,output v-fact-qnty
     2735         ,output v-cur-base
     2736         ,output v-cur-VAT-base
     2737         ,output v-cur-SLT-base
     2738         ,output v-cur-road-tax-base
     2739         ,output v-cur-excise-base
     2740         ) no-error.
     2741       if error-status :error
     2742       then do:
     2743         message
     2744           vss-workfile vss-revision vss-description skip
     2745           vss-include-info12 skip
     2746           "Ошибка при расчете сумм переоценки." skip
     2747           "Документ переоценки" buf_main_price-list.doc-num skip
     2748           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2749           error-status :get-message(1) skip
     2750           return-value skip
     2751           view-as alert-box error .
     2752         undo, return error .
     2753       end.
     2754   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2756     (input  buf_main_price-list.obj-type
     2757     ,input  buf_main_price-list.obj-code
     2758     ,input  buf_main_price-list.b-code
     2759     ,input  buf_main_price-list.b-code
     2760     ,input  buf_main_price-list.fact-order
     2761     ,output v-prev-price-list-recid
     2762     ,output v-prev-cli-base-rate
     2763     ) no-error .
     2764       if error-status :error
     2765       then do:
     2766         message
     2767           vss-workfile vss-revision vss-description skip
     2768           vss-include-info12 skip
     2769           "Ошибка при поиске предыдущей переоценки." skip
     2770           "Документ переоценки " buf_main_price-list.doc-num skip
     2771           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2772           error-status :get-message(1) skip
     2773           return-value skip
     2774           view-as alert-box error .
     2775         undo, return error .
     2776       end.
     2777       if v-prev-price-list-recid <> ?
     2778       then do:
     2779         find first buf_prev_price-list no-lock
     2780           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2781           .
     2782         find first buf_special_price-list no-lock
     2783           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2784             and buf_special_price-list.main-price = false
     2785             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2786             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2787             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2788             and buf_special_price-list.doc-qnty   <> ?
     2789           no-error .
     2790         if available buf_special_price-list
     2791         then do:
     2792           message
     2793             "Товар имеет специальные цены на признаки" skip
     2794             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2795             "Переоценка" buf_prev_price-list.doc-num skip
     2796             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2797             view-as alert-box error .
     2798           undo, return error .
     2799         end.
     2800         find first buf_goods no-lock
     2801           where buf_goods.artic     = buf_main_price-list.artic
     2802             and buf_goods.prod-type = buf_main_price-list.prod-type
     2803             and buf_goods.prod-code = buf_main_price-list.prod-code
     2804           no-error .
     2805         if not available buf_goods
     2806         then do:
     2807           message
     2808             vss-workfile vss-revision vss-description skip
     2809             vss-include-info12 skip
     2810             "Не найден товар" skip
     2811             "Переоценка" buf_main_price-list.doc-num skip
     2812             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2813             view-as alert-box error .
     2814           undo, return error .
     2815         end.
     2816         if buf_prev_price-list.vat-pc = ?
     2817         or buf_prev_price-list.slt-pc = ?
     2818         then do:
     2819           message
     2820             "В переоценке не заданы налоги товара" skip
     2821             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2822             "Переоценка" buf_prev_price-list.doc-num skip
     2823             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2824             "НДС" buf_prev_price-list.vat-pc skip
     2825             "НП" buf_prev_price-list.slt-pc skip
     2826             view-as alert-box error .
     2827           undo, return error return-value .
     2828         end.
     2829         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2830         assign
     2831           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2832         .
     2833         assign
     2834           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2835           v-prev-cur-VAT-base = v-fact-qnty
     2836                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2837                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2838           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2839         .
     2840         assign
     2841           p-fact-qnty   = v-fact-qnty
     2842           p-ov-base     = v-cur-base     - v-prev-cur-base
     2843           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2844           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2845         .
     2846       end.
     2847       else do:
     2848         assign
     2849           v-prev-cur-base     = 0
     2850           v-prev-cur-VAT-base = 0
     2851           v-prev-cur-SLT-base = 0
     2852           .
     2853         assign
     2854           p-fact-qnty   = v-fact-qnty
     2855           p-ov-base     = v-cur-base     - v-prev-cur-base
     2856           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2857           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2858         .
     2859       end.
     2860     end.
     2861   end procedure.
     2862   procedure prdoclib-init-prt-obj-by-factord :
     2863     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2864     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2865     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2866     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2867     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2868     define input parameter p-fact-order         as decimal   no-undo .
     2869     define input parameter p-include-fact-order as logical   no-undo .
     2870     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2871     define buffer buf_gds-obj      for ub.gds-obj .
     2872     define buffer buf_doc-line     for ub.doc-line .
     2873     define buffer buf_temp-prt-obj for temp-prt-obj .
     2874     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2875     do
     2876     on error undo, return error return-value
     2877     :
     2878       do transaction
     2879       on error undo, return error return-value
     2880       :
     2881   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2882   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2883     (input  p-obj-type
     2884     ,input  p-obj-code
     2885     ,input  p-artic
     2886     ,input  p-prod-type
     2887     ,input  p-prod-code
     2888     ,buffer buf_gds-obj
     2889     ) no-error .
     2890         if error-status :error
     2891         then do:
     2892           message
     2893             vss-workfile vss-revision vss-description skip
     2894             vss-include-info12 skip
     2895             "Невозможно найти gds-obj" skip
     2896             error-status :get-message(1) skip
     2897             return-value skip
     2898             view-as alert-box error .
     2899           undo, return error .
     2900         end.
     2901         find current buf_gds-obj exclusive-lock .
     2902       end.
     2903       run prdoclib-init-temp-prt-obj in this-procedure
     2904         (input p-obj-type
     2905         ,input p-obj-code
     2906         ,input p-artic
     2907         ,input p-prod-type
     2908         ,input p-prod-code
     2909         ,input 0
     2910         ) .
     2911       for each buf_temp-prt-obj
     2912         where buf_temp-prt-obj.is-term <> true
     2913       on error undo, return error return-value
     2914       :
     2915         delete buf_temp-prt-obj .
     2916       end.
     2917       if p-include-fact-order = true
     2918       then do:
     2919         assign
     2920          p-fact-order = p-fact-order - 0.0000000001
     2921         .
     2922       end.
     2923       for each buf_doc-line no-lock
     2924         where buf_doc-line.obj-type   = p-obj-type
     2925           and buf_doc-line.obj-code   = p-obj-code
     2926           and buf_doc-line.artic      = p-artic
     2927           and buf_doc-line.prod-type  = p-prod-type
     2928           and buf_doc-line.prod-code  = p-prod-code
     2929           and buf_doc-line.status_    = 'факт':U
     2930           and buf_doc-line.fact-order >= p-fact-order
     2931       on error undo, return error return-value
     2932       :
     2933         run prdoclib-process-document in this-procedure
     2934           (input  buf_doc-line.doc-code
     2935           ,input  p-obj-type
     2936           ,input  p-obj-code
     2937           ,input  p-artic
     2938           ,input  p-prod-type
     2939           ,input  p-prod-code
     2940           ,output v-total-gds-dtl-qnty
     2941           ) .
     2942       end.
     2943     end.
     2944   end procedure.
     2945   procedure prdoclib-process-document :
     2946     define input  parameter p-doc-code           as character no-undo .
     2947     define input  parameter p-obj-type           as character no-undo .
     2948     define input  parameter p-obj-code           as integer   no-undo .
     2949     define input  parameter p-artic              as character no-undo .
     2950     define input  parameter p-prod-type          as character no-undo .
     2951     define input  parameter p-prod-code          as integer   no-undo .
     2952     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2953     define buffer buf_trn-doc      for ub.trn-doc .
     2954     define buffer buf_gds-dtl      for ub.gds-dtl .
     2955     define buffer buf_temp-prt-obj for temp-prt-obj .
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       find first buf_trn-doc no-lock
     2960         where buf_trn-doc.doc-code = p-doc-code
     2961         no-error .
     2962       if not available buf_trn-doc then do:
     2963         message
     2964           vss-workfile vss-revision vss-description skip
     2965           vss-include-info12 skip
     2966           "Ошибка при поиске документа" skip
     2967           "Документ" p-doc-code skip
     2968           "Объект" p-obj-type p-obj-code skip
     2969           "Артикул" p-artic p-prod-type p-prod-code skip
     2970           view-as alert-box error .
     2971         undo, return error .
     2972       end.
     2973       assign
     2974         p-total-gds-dtl-qnty = 0
     2975       .
     2976       for each buf_gds-dtl no-lock
     2977         where buf_gds-dtl.doc-code  = p-doc-code
     2978           and buf_gds-dtl.artic     = p-artic
     2979           and buf_gds-dtl.prod-type = p-prod-type
     2980           and buf_gds-dtl.prod-code = p-prod-code
     2981       on error undo, return error
     2982       :
     2983         define variable v-term-node as integer   no-undo .
     2984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2985     (input  buf_gds-dtl.prt-code
     2986     ,output v-term-node
     2987     )  .
     2988         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2989           (input  v-term-node
     2990           ,buffer buf_temp-prt-obj
     2991           ) .
     2992         if buf_temp-prt-obj.is-term <> true then do:
     2993           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2994                                        ,buf_gds-dtl.prt-code
     2995                                        ) .
     2996         end.
     2997         case buf_trn-doc.doc-type :
     2998           when 'при':U or
     2999           when 'возврат':U
     3000           then do:
     3001             assign
     3002               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3003                                           - buf_gds-dtl.fact-qnty
     3004               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3005                                           - buf_gds-dtl.fact-qnty
     3006             .
     3007           end.
     3008           when 'рас':U or
     3009           when 'спи':U
     3010           then do:
     3011             assign
     3012               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3013                                           + buf_gds-dtl.fact-qnty
     3014               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3015                                           + buf_gds-dtl.fact-qnty
     3016             .
     3017           end.
     3018           when 'инв':U
     3019           then do:
     3020             assign
     3021               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3022                                           - buf_gds-dtl.doc-qnty
     3023               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3024                                           - buf_gds-dtl.doc-qnty
     3025             .
     3026           end.
     3027           otherwise do:
     3028             undo, return error substitute("Неизвестный тип документа &1"
     3029                                          ,buf_trn-doc.doc-type
     3030                                          ) .
     3031           end.
     3032         end.
     3033       end.
     3034     end.
     3035   end procedure.
     3036   procedure prdoclib-prc-pl-document :
     3037     define input  parameter p-doc-code              as character no-undo .
     3038     define input  parameter p-obj-type              as character no-undo .
     3039     define input  parameter p-obj-code              as integer   no-undo .
     3040     define input  parameter p-gds-code              as integer   no-undo .
     3041     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3042     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3043     do
     3044     on error undo, return error return-value
     3045     :
     3046       define buffer buf_trn-doc      for ub.trn-doc .
     3047       define buffer buf_doc-pl       for ub.doc-pl .
     3048       define buffer buf_temp-pl-gds for temp-pl-gds .
     3049       define variable v-sign as decimal   no-undo .
     3050       find first buf_trn-doc no-lock
     3051         where buf_trn-doc.doc-code = p-doc-code
     3052         no-error .
     3053       if not available buf_trn-doc then do:
     3054         message
     3055           vss-workfile vss-revision vss-description skip
     3056           vss-include-info12 skip
     3057           "Ошибка при поиске документа" skip
     3058           "Документ" p-doc-code skip
     3059           "Объект" p-obj-type p-obj-code skip
     3060           "Товар" p-gds-code skip
     3061           view-as alert-box error .
     3062         undo, return error .
     3063       end.
     3064       assign
     3065         p-total-pl-gds-qnty     = 0
     3066         p-total-pl-gds-cli-qnty = 0
     3067       .
     3068       for each buf_doc-pl no-lock
     3069         where buf_doc-pl.out-code  = p-doc-code
     3070           and buf_doc-pl.gds-code  = p-gds-code
     3071       on error undo, return error return-value
     3072       :
     3073         find first buf_temp-pl-gds
     3074           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3075             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3076             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3077           .
     3078         case buf_trn-doc.doc-type :
     3079           when 'при':U
     3080           or when 'возврат':U
     3081           or when 'инв':U
     3082           then do:
     3083             assign
     3084               v-sign = -1.0
     3085             .
     3086           end.
     3087           when 'рас':U or
     3088           when 'спи':U
     3089           then do:
     3090             assign
     3091               v-sign = 1.0
     3092             .
     3093           end.
     3094           otherwise do:
     3095             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3096           end.
     3097         end case.
     3098         assign
     3099           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3100           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3101           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3102           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3103         .
     3104       end.
     3105     end.
     3106   end procedure.
     3107   procedure prdoclib-init-prt-obj-by-date :
     3108     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3109     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3110     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3111     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3112     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3113     define input parameter p-fact-date  as date      no-undo .
     3114     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3115     do
     3116     on error undo, return error return-value
     3117     :
     3118       define variable v-fact-order                as decimal   no-undo .
     3119       define variable v-shift-end-fact-order      as decimal   no-undo .
     3120       define variable v-day-end-fact-order        as decimal   no-undo .
     3121       run factord in this-procedure
     3122         (input  p-fact-date
     3123         ,input  1
     3124         ,input  1
     3125         ,input  ?
     3126         ,input  0
     3127         ,input  false
     3128         ,output v-fact-order
     3129         ,output v-shift-end-fact-order
     3130         ,output v-day-end-fact-order
     3131         ) no-error .
     3132       if error-status :error
     3133       then do:
     3134         message
     3135           vss-workfile vss-revision vss-description skip
     3136           vss-include-info12 skip
     3137           "Ошибка при определении момента времени, на который требуется остаток" skip
     3138           "Объект" p-obj-type p-obj-code skip
     3139           "Артикул" p-artic p-prod-type p-prod-code skip
     3140           "Дата" p-fact-date skip
     3141           view-as alert-box error .
     3142         undo, return error .
     3143       end.
     3144       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3145         (input p-obj-type
     3146         ,input p-obj-code
     3147         ,input p-artic
     3148         ,input p-prod-type
     3149         ,input p-prod-code
     3150         ,input v-day-end-fact-order
     3151         ,input false
     3152         ) no-error .
     3153       if error-status :error
     3154       then do:
     3155         message
     3156           vss-workfile vss-revision vss-description skip
     3157           vss-include-info12 skip
     3158           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3159           "Объект" p-obj-type p-obj-code skip
     3160           "Артикул" p-artic p-prod-type p-prod-code skip
     3161           "Дата" p-fact-date skip
     3162           view-as alert-box error .
     3163         undo, return error .
     3164       end.
     3165     end.
     3166   end procedure.
     3167   procedure prdoclib-calc-temp-fact-sale :
     3168     define input  parameter p-obj-type           as character no-undo .
     3169     define input  parameter p-obj-code           as integer   no-undo .
     3170     define input  parameter p-gds-code           as integer   no-undo .
     3171     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3172     define input  parameter p-curr-r-b           as character no-undo .
     3173     define output parameter p-fact-qnty          as decimal   no-undo .
     3174     define output parameter p-cur-base           as decimal   no-undo .
     3175     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3176     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3177     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3178     define output parameter p-cur-excise-base    as decimal   no-undo .
     3179     define buffer buf_temp-prt-obj for temp-prt-obj .
     3180     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3181     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3182     define variable parrecid-prl        as recid     no-undo .
     3183     define variable v-fact-qnty         as decimal   no-undo .
     3184     define variable v-cur-base          as decimal   no-undo .
     3185     define variable v-cur-VAT-base      as decimal   no-undo .
     3186     define variable v-cur-SLT-base      as decimal   no-undo .
     3187     define variable v-cur-road-tax-base as decimal   no-undo .
     3188     define variable v-cur-excise-base   as decimal   no-undo .
     3189     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3190     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3191     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3192     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3193     define variable vat-base-sale-prl               as decimal   no-undo .
     3194     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3195     define variable vat-base-buyer-prl              as decimal   no-undo .
     3196     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3197     define variable slt-base-sale-prl               as decimal   no-undo .
     3198     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3199     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3200     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3201     define variable excise-base-sale-prl            as decimal   no-undo .
     3202     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3203     define variable discnt-base-sale-prl            as decimal   no-undo .
     3204     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3205     do
     3206     on error undo, return error return-value
     3207     :
     3208       for each buf_temp-prt-obj no-lock
     3209       on error undo, return error return-value
     3210       :
     3211   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3212     (input  p-gds-code
     3213     ,input  buf_temp-prt-obj.prt-code
     3214     ,output v-prt-b-code
     3215     ) no-error .
     3216         if error-status :error
     3217         then do:
     3218           message
     3219             vss-workfile vss-revision vss-description skip
     3220             "Ошибка при определении бар-кода признака" skip
     3221             "Код товара"   p-gds-code skip
     3222             "Код признака" buf_temp-prt-obj.prt-code skip
     3223             error-status :get-message(1) skip
     3224             return-value skip
     3225             view-as alert-box error .
     3226           undo, return error .
     3227         end.
     3228   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3230     (input  p-obj-type
     3231     ,input  p-obj-code
     3232     ,input  v-prt-b-code
     3233     ,input  0
     3234     ,input  p-day-end-fact-order
     3235     ,output parrecid-prl
     3236     ,output v-cli-base-rate
     3237     ) no-error .
     3238         if error-status :error
     3239         then do:
     3240           message
     3241             vss-workfile vss-revision vss-description skip
     3242             "Ошибка при определении цены бар-кода" skip
     3243             "Объект" p-obj-type p-obj-code skip
     3244             "Бар-код" v-prt-b-code skip
     3245             "fact-order" p-day-end-fact-order skip
     3246             error-status :get-message(1) skip
     3247             return-value skip
     3248             view-as alert-box error .
     3249           undo, return error .
     3250         end.
     3251         if parrecid-prl <> ?
     3252         then do:
     3253           run prl-vat in this-procedure
     3254             (input  parrecid-prl
     3255             ,output price-rubl-with-tax-sale-prl
     3256             ,output price-base-with-tax-sale-prl
     3257             ,output price-rubl-without-tax-sale-prl
     3258             ,output price-base-without-tax-sale-prl
     3259             ,output vat-base-sale-prl
     3260             ,output vat-rubl-sale-prl
     3261             ,output vat-base-buyer-prl
     3262             ,output vat-rubl-buyer-prl
     3263             ,output slt-base-sale-prl
     3264             ,output slt-rubl-sale-prl
     3265             ,output road-tax-base-sale-prl
     3266             ,output road-tax-rubl-sale-prl
     3267             ,output excise-base-sale-prl
     3268             ,output excise-rubl-sale-prl
     3269             ,output discnt-base-sale-prl
     3270             ,output discnt-rubl-sale-prl
     3271             ) no-error .
     3272           if error-status :error
     3273           then do:
     3274             message
     3275               vss-workfile vss-revision vss-description skip
     3276               "Ошибка при вызове процеды prl-vat" skip
     3277               "Объект" p-obj-type p-obj-code skip
     3278               "Код товара" p-gds-code skip
     3279               "Указатель на запись переоценки" parrecid-prl skip
     3280               error-status :get-message(1) skip
     3281               return-value skip
     3282               view-as alert-box error .
     3283             undo, return error .
     3284           end.
     3285         end.
     3286         else do:
     3287           assign
     3288             price-rubl-with-tax-sale-prl    = 0
     3289             price-base-with-tax-sale-prl    = 0
     3290             price-rubl-without-tax-sale-prl = 0
     3291             price-base-without-tax-sale-prl = 0
     3292             vat-base-sale-prl               = 0
     3293             vat-rubl-sale-prl               = 0
     3294             slt-base-sale-prl               = 0
     3295             slt-rubl-sale-prl               = 0
     3296             road-tax-base-sale-prl          = 0
     3297             road-tax-rubl-sale-prl          = 0
     3298             excise-base-sale-prl            = 0
     3299             excise-rubl-sale-prl            = 0
     3300             discnt-base-sale-prl            = 0
     3301             discnt-rubl-sale-prl            = 0
     3302           .
     3303         end.
     3304         assign
     3305           v-fact-qnty         = v-fact-qnty
     3306                               + buf_temp-prt-obj.fact-qnty
     3307           v-cur-base          = v-cur-base
     3308                               + (if p-curr-r-b = 'base':U
     3309                                   then price-base-with-tax-sale-prl
     3310                                   else price-rubl-with-tax-sale-prl
     3311                                 )
     3312                               * buf_temp-prt-obj.fact-qnty
     3313           v-cur-VAT-base      = v-cur-VAT-base
     3314                               + (if p-curr-r-b = 'base':U
     3315                                   then vat-base-sale-prl
     3316                                   else vat-rubl-sale-prl
     3317                                 )
     3318                               * buf_temp-prt-obj.fact-qnty
     3319           v-cur-SLT-base      = v-cur-SLT-base
     3320                               + (if p-curr-r-b = 'base':U
     3321                                   then slt-base-sale-prl
     3322                                   else slt-rubl-sale-prl
     3323                                 )
     3324                               * buf_temp-prt-obj.fact-qnty
     3325           v-cur-road-tax-base = v-cur-road-tax-base
     3326                               + (if p-curr-r-b = 'base':U
     3327                                   then road-tax-base-sale-prl
     3328                                   else road-tax-rubl-sale-prl
     3329                                 )
     3330                               * buf_temp-prt-obj.fact-qnty
     3331           v-cur-excise-base   = v-cur-excise-base
     3332                               + (if p-curr-r-b = 'base':U
     3333                                   then excise-base-sale-prl
     3334                                   else excise-rubl-sale-prl
     3335                                 )
     3336                               * buf_temp-prt-obj.fact-qnty
     3337         .
     3338       end.
     3339       assign
     3340         p-fact-qnty         = v-fact-qnty
     3341         p-cur-base          = v-cur-base
     3342         p-cur-VAT-base      = v-cur-VAT-base
     3343         p-cur-SLT-base      = v-cur-SLT-base
     3344         p-cur-road-tax-base = v-cur-road-tax-base
     3345         p-cur-excise-base   = v-cur-excise-base
     3346       .
     3347     end.
     3348   end procedure.
     3349   procedure prdoclib-clear-temp-pl-gds :
     3350     define buffer buf_temp-pl-gds for temp-pl-gds .
     3351     do
     3352     on error undo, return error return-value
     3353     :
     3354       for each buf_temp-pl-gds
     3355       on error undo, return error return-value
     3356       :
     3357         delete buf_temp-pl-gds .
     3358       end.
     3359     end.
     3360   end procedure.
     3361   procedure prdoclib-init-temp-pl-gds :
     3362     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3363     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3364     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3365     define buffer buf_pl-gds      for ub.pl-gds .
     3366     define buffer buf_temp-pl-gds for temp-pl-gds .
     3367     do
     3368     on error undo, return error return-value
     3369     :
     3370       run prdoclib-clear-temp-pl-gds in this-procedure .
     3371       for each buf_pl-gds
     3372         where buf_pl-gds.obj-type = p-obj-type
     3373           and buf_pl-gds.obj-code = p-obj-code
     3374           and buf_pl-gds.gds-code = p-gds-code
     3375       on error undo, return error return-value
     3376       :
     3377         create buf_temp-pl-gds .
     3378         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3379       end.
     3380     end.
     3381   end procedure.
     3382   procedure prdoclib-init-pl-gds-by-factord :
     3383     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3384     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3385     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3386     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3387     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3388     define input parameter p-fact-order         as decimal   no-undo .
     3389     define input parameter p-include-fact-order as logical   no-undo .
     3390     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3391     define buffer buf_goods       for ub.goods .
     3392     define buffer buf_gds-obj     for ub.gds-obj .
     3393     define buffer buf_doc-line    for ub.doc-line .
     3394     define buffer buf_temp-pl-gds for temp-pl-gds .
     3395     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3396     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3397     do
     3398     on error undo, return error return-value
     3399     :
     3400       do transaction
     3401       on error undo, return error return-value
     3402       :
     3403   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3405     (input  p-obj-type
     3406     ,input  p-obj-code
     3407     ,input  p-artic
     3408     ,input  p-prod-type
     3409     ,input  p-prod-code
     3410     ,buffer buf_gds-obj
     3411     ) no-error .
     3412         if error-status :error
     3413         then do:
     3414           message
     3415             vss-workfile vss-revision vss-description skip
     3416             vss-include-info12 skip
     3417             "Невозможно найти gds-obj" skip
     3418             error-status :get-message(1) skip
     3419             return-value skip
     3420             view-as alert-box error .
     3421           undo, return error return-value .
     3422         end.
     3423         find current buf_gds-obj exclusive-lock .
     3424       end.
     3425       find first buf_goods no-lock
     3426         where buf_goods.artic     = p-artic
     3427           and buf_goods.prod-type = p-prod-type
     3428           and buf_goods.prod-code = p-prod-code
     3429         .
     3430       run prdoclib-init-temp-pl-gds in this-procedure
     3431         (input p-obj-type
     3432         ,input p-obj-code
     3433         ,input buf_goods.gds-code
     3434         ) .
     3435       if p-include-fact-order = true
     3436       then do:
     3437         assign
     3438          p-fact-order = p-fact-order - 0.0000000001
     3439         .
     3440       end.
     3441       for each buf_doc-line no-lock
     3442         where buf_doc-line.obj-type   = p-obj-type
     3443           and buf_doc-line.obj-code   = p-obj-code
     3444           and buf_doc-line.artic      = p-artic
     3445           and buf_doc-line.prod-type  = p-prod-type
     3446           and buf_doc-line.prod-code  = p-prod-code
     3447           and buf_doc-line.status_    = 'факт':U
     3448           and buf_doc-line.fact-order >= p-fact-order
     3449       on error undo, return error return-value
     3450       :
     3451         run prdoclib-prc-pl-document in this-procedure
     3452           ( input  buf_doc-line.doc-code
     3453            ,input  p-obj-type
     3454            ,input  p-obj-code
     3455            ,input  buf_goods.gds-code
     3456            ,output v-total-pl-gds-qnty
     3457            ,output v-total-pl-gds-cli-qnty
     3458           ) .
     3459       end.
     3460     end.
     3461   end procedure.
     3462   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3463   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     3464      IF parundefine-var = ? THEN RETURN 0.00.
     3465                             ELSE RETURN parundefine-var.
     3466   END FUNCTION.
     3467   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     3468      IF p-undef-char = ? THEN do:
     3469        RETURN "?".
     3470      end.
     3471      ELSE do:
     3472        RETURN p-undef-char .
     3473      end.
     3474   END FUNCTION.
     3475   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3476   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3477   procedure factord :
     3478     define input  parameter p-fact-date            as date    no-undo .
     3479     define input  parameter p-fact-time            as integer no-undo .
     3480     define input  parameter p-fact-num             as integer no-undo .
     3481     define input  parameter p-shift-date           as date    no-undo .
     3482     define input  parameter p-shift-num            as integer no-undo .
     3483     define input  parameter p-shift-on             as logical no-undo .
     3484     define output parameter p-fact-order           as decimal no-undo .
     3485     define output parameter p-shift-end-fact-order as decimal no-undo .
     3486     define output parameter p-day-end-fact-order   as decimal no-undo .
     3487     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3488     if p-fact-date = ?
     3489     then do:
     3490       return error "Не указана фактическая дата" .
     3491     end.
     3492     define variable v-fact-date-num as integer no-undo .
     3493     assign
     3494       v-fact-date-num = integer(p-fact-date)
     3495     .
     3496     if p-fact-num = ?
     3497     or p-fact-num = 0
     3498     then do:
     3499       return error "Не задан p-fact-num " + string(p-fact-num) .
     3500     end.
     3501     if p-fact-num < 0
     3502     then do:
     3503       return error "Отрицательный fact-num " + string(p-fact-num) .
     3504     end.
     3505     if p-fact-num >= 100000000
     3506     then do:
     3507       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3508     end.
     3509     if p-shift-on = true
     3510     then do:
     3511       if p-shift-date = ?
     3512       then do:
     3513         return error "Не задана дата смены" .
     3514       end.
     3515       if p-shift-num = ?
     3516       or p-shift-num = 0
     3517       then do:
     3518         return error "Не задан номер смены" .
     3519       end.
     3520     end.
     3521     else do:
     3522       assign
     3523         p-shift-date = p-fact-date
     3524         p-shift-num  = 24
     3525       .
     3526     end.
     3527     define variable v-shift-offset as integer no-undo .
     3528     if p-shift-date = p-fact-date
     3529     then do:
     3530       assign
     3531         v-shift-offset = 1
     3532       .
     3533     end.
     3534     if p-shift-date < p-fact-date
     3535     then do:
     3536       assign
     3537         v-shift-offset = 0
     3538       .
     3539     end.
     3540     if p-shift-date > p-fact-date
     3541     then do:
     3542       message
     3543         vss-workfile vss-revision vss-description skip
     3544         "Неправильная дата закрытия смены" skip
     3545         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3546         view-as alert-box error .
     3547       undo, return error
     3548         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3549           ,string(p-fact-date, '99/99/9999':U)
     3550           ,string(p-shift-date, '99/99/9999':U)
     3551           )
     3552       .
     3553     end.
     3554     if p-shift-num < 1
     3555     or p-shift-num > 24
     3556     then do:
     3557       message
     3558         vss-workfile vss-revision vss-description skip
     3559         "Неправильный номер смены" skip
     3560         "p-shift-num" p-shift-num skip
     3561         view-as alert-box error .
     3562       undo, return error return-value .
     3563     end.
     3564     assign
     3565       p-fact-order           = v-fact-date-num
     3566                              + v-shift-offset * 0.5
     3567                              + p-shift-num    * 0.02 - 0.01
     3568                              + p-fact-num     * 0.0000000001
     3569       p-shift-end-fact-order = v-fact-date-num
     3570                              + v-shift-offset * 0.5
     3571                              + p-shift-num    * 0.02
     3572       p-day-end-fact-order   = v-fact-date-num
     3573                              + 0.99
     3574     .
     3575     if p-fact-order           <= v-fact-date-num
     3576     or p-shift-end-fact-order <= v-fact-date-num
     3577     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3578     or p-shift-end-fact-order >= p-day-end-fact-order
     3579     then do:
     3580       message
     3581         vss-workfile vss-revision vss-description skip
     3582         "Внутренняя ошибка при генерации фактического номера" skip
     3583         "p-fact-date"            p-fact-date            skip
     3584         "p-fact-time"            p-fact-time            skip
     3585         "p-fact-num"             p-fact-num             skip
     3586         "p-shift-date"           p-shift-date           skip
     3587         "p-shift-num"            p-shift-num            skip
     3588         "p-shift-on"             p-shift-on             skip
     3589         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3590         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3591         "v-fact-date-num"        v-fact-date-num        skip
     3592         view-as alert-box error .
     3593       undo, return error return-value .
     3594     end.
     3595   end procedure.
     3596   procedure day-begin-fact-order :
     3597     define input  parameter p-fact-date            as date    no-undo .
     3598     define output parameter p-day-begin-fact-order as decimal no-undo .
     3599     do
     3600     on error undo, return error return-value
     3601     :
     3602       if p-fact-date = ?
     3603       then do:
     3604         assign
     3605           p-day-begin-fact-order = 0
     3606         .
     3607       end.
     3608       else do:
     3609         assign
     3610           p-day-begin-fact-order = integer(p-fact-date)
     3611         .
     3612       end.
     3613     end.
     3614   end procedure.
     3615   procedure factord-max-fact-order :
     3616     define output parameter p-max-fact-order as decimal   no-undo .
     3617     do
     3618     on error undo, return error return-value
     3619     :
     3620       run day-begin-fact-order in this-procedure
     3621         (input  date(1, 1, 5000)
     3622         ,output p-max-fact-order
     3623         ) .
     3624     end.
     3625   end procedure.
     3626   procedure factord-cut-archive :
     3627     define input  parameter p-obj-type             as character no-undo .
     3628     define input  parameter p-obj-code             as integer   no-undo .
     3629     define input  parameter p-fact-date            as date      no-undo .
     3630     define output parameter p-shift-on             as logical   no-undo .
     3631     define output parameter p-shift-date           as date      no-undo .
     3632     define output parameter p-shift-num            as integer   no-undo .
     3633     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3634     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3635     define variable v-fact-order as decimal   no-undo .
     3636     define buffer buf_shift-obj for ub.shift-obj .
     3637     do
     3638     on error undo, return error return-value
     3639     :
     3640   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3641   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3642     (input  p-obj-type
     3643     ,input  p-obj-code
     3644     ,input  'shift-on=request'
     3645     ,output p-shift-on
     3646     ) no-error .
     3647       if error-status :error
     3648       then do:
     3649         message
     3650           vss-workfile vss-revision vss-description skip
     3651           "Ошибка при определении атрибута объекта" skip
     3652           "Объект" p-obj-type p-obj-code skip
     3653           error-status :get-message(1) skip
     3654           return-value skip
     3655           view-as alert-box error .
     3656         undo, return error return-value .
     3657       end.
     3658       if p-shift-on = false
     3659       then do:
     3660         assign
     3661           p-shift-date               = ?
     3662           p-shift-num                = 0
     3663         .
     3664       end.
     3665       else do:
     3666         find first buf_shift-obj share-lock
     3667           where buf_shift-obj.obj-type   = p-obj-type
     3668             and buf_shift-obj.obj-code   = p-obj-code
     3669             and buf_shift-obj.shift-date > p-fact-date
     3670           use-index pi
     3671           no-error .
     3672         if not available buf_shift-obj
     3673         or buf_shift-obj.status_ <> 'зкр':U
     3674         then do:
     3675           message
     3676             vss-workfile vss-revision vss-description skip
     3677             "Невозможно вычислить последнюю смену" skip
     3678             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3679             "Объект" p-obj-type p-obj-code skip
     3680             "Дата" p-fact-date skip
     3681             view-as alert-box error .
     3682           undo, return error return-value .
     3683         end.
     3684         find last buf_shift-obj share-lock
     3685           where buf_shift-obj.obj-type = p-obj-type
     3686             and buf_shift-obj.obj-code = p-obj-code
     3687             and buf_shift-obj.shift-date <= p-fact-date
     3688           use-index pi
     3689           no-error .
     3690         if available buf_shift-obj
     3691         then do:
     3692           if  buf_shift-obj.status_ = 'зкр':U
     3693           then do:
     3694             assign
     3695               p-shift-date = buf_shift-obj.shift-date
     3696               p-shift-num  = buf_shift-obj.shift-num
     3697             .
     3698           end.
     3699           else do:
     3700             message
     3701               vss-workfile vss-revision vss-description skip
     3702               "Невозможно вычислить последнюю смену" skip
     3703               "Статус смены отличен от статуса" 'зкр':U skip
     3704               "Объект" p-obj-type p-obj-code skip
     3705               "Дата" p-fact-date skip
     3706               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3707               view-as alert-box error .
     3708             undo, return error return-value .
     3709           end.
     3710         end.
     3711         else do:
     3712           assign
     3713             p-shift-date = p-fact-date - 1
     3714             p-shift-num  = 1
     3715           .
     3716         end.
     3717       end.
     3718       run factord in this-procedure
     3719         (input  p-fact-date
     3720         ,input  1
     3721         ,input  1
     3722         ,input  p-shift-date
     3723         ,input  p-shift-num
     3724         ,input  p-shift-on
     3725         ,output v-fact-order
     3726         ,output p-shift-end-fact-order
     3727         ,output p-day-end-fact-order
     3728         ) no-error .
     3729       if error-status :error
     3730       then do:
     3731         message
     3732           vss-workfile vss-revision vss-description skip
     3733           "Ошибка при вызове процедуры factord"
     3734           error-status :get-message(1) skip
     3735           return-value skip
     3736           view-as alert-box error .
     3737         undo, return error return-value .
     3738       end.
     3739     end.
     3740   end procedure.
     3741   procedure factord-lock-shift :
     3742     define input  parameter p-obj-type  as character no-undo .
     3743     define input  parameter p-obj-code  as integer   no-undo .
     3744     define input  parameter p-fact-date as date      no-undo .
     3745     define parameter buffer buf_shift-obj for ub.shift-obj .
     3746     define variable v-shift-on      as logical   no-undo .
     3747     define variable v-extra-message as character no-undo .
     3748     define variable v-error as character no-undo .
     3749     do
     3750     on error undo, return error return-value
     3751     :
     3752   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3753   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3754     (input  p-obj-type
     3755     ,input  p-obj-code
     3756     ,input  'shift-on=request'
     3757     ,output v-shift-on
     3758     ) no-error .
     3759       if error-status :error
     3760       then do:
     3761         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3762         undo, return error v-error .
     3763       end.
     3764       if v-shift-on = true
     3765       then do:
     3766         find first buf_shift-obj share-lock
     3767           where buf_shift-obj.obj-type   = p-obj-type
     3768             and buf_shift-obj.obj-code   = p-obj-code
     3769             and buf_shift-obj.shift-date > p-fact-date
     3770           use-index pi
     3771           no-error .
     3772         if not available buf_shift-obj
     3773         or buf_shift-obj.status_ <> 'зкр':U
     3774         then do:
     3775           find last buf_shift-obj
     3776             where buf_shift-obj.obj-type = p-obj-type
     3777               and buf_shift-obj.obj-code = p-obj-code
     3778               and buf_shift-obj.status_  = 'зкр':U
     3779             use-index stts
     3780             no-error .
     3781           if available buf_shift-obj
     3782           then do:
     3783             assign
     3784               v-extra-message =
     3785                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3786                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3787                               )
     3788             .
     3789           end.
     3790           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3791           undo, return error v-error .
     3792         end.
     3793       end.
     3794     end.
     3795   end procedure.
     3796   procedure factord-end-day :
     3797     define input  parameter p-fact-date            as date    no-undo .
     3798     define output parameter p-day-end-fact-order   as decimal no-undo .
     3799     do
     3800     on error undo, return error return-value
     3801     :
     3802       if p-fact-date = ?
     3803       then do:
     3804         return error "Не указана фактическая дата" .
     3805       end.
     3806       assign
     3807         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3808       .
     3809     end.
     3810   end procedure.
     3811   procedure factord-to-date :
     3812     define input  parameter p-fact-order as decimal no-undo .
     3813     define output parameter p-fact-date  as date    no-undo .
     3814     define variable v-ref-date  as date      no-undo .
     3815     define variable v-ref-delta as integer   no-undo .
     3816     do
     3817     on error undo, return error return-value
     3818     :
     3819       if p-fact-order = ?
     3820       or p-fact-order = 0
     3821       then do:
     3822         return error "Не указан fact-order" .
     3823       end.
     3824       assign
     3825         v-ref-date  = date(1, 1, 2000)
     3826       .
     3827       assign
     3828         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3829       .
     3830       assign
     3831         p-fact-date = v-ref-date + v-ref-delta
     3832       .
     3833     end.
     3834   end procedure.
     3835   procedure factord-to-fact-num :
     3836     define input  parameter p-fact-order as decimal no-undo .
     3837     define output parameter p-fact-num   as integer no-undo .
     3838     define variable v-fact-order-trunc as decimal no-undo .
     3839     do
     3840     on error undo, return error return-value
     3841     :
     3842       if p-fact-order = ?
     3843       or p-fact-order = 0
     3844       then do:
     3845         return error "Не указан fact-order" .
     3846       end.
     3847       assign
     3848        v-fact-order-trunc = truncate(p-fact-order, 2)
     3849       .
     3850       assign
     3851         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3852       .
     3853     end.
     3854   end procedure.
     3855   procedure factord-to-shift-num :
     3856     define input  parameter p-fact-order as decimal no-undo .
     3857     define output parameter p-shift-num   as integer no-undo .
     3858     define variable  p-shift-numd  as decimal   no-undo .
     3859     define variable v-fact-order-trunc as decimal no-undo .
     3860     do
     3861     on error undo, return error return-value
     3862     :
     3863       if p-fact-order = ?
     3864       or p-fact-order = 0
     3865       then do:
     3866         return error "Не указан fact-order" .
     3867       end.
     3868       assign
     3869        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3870       .
     3871       if v-fact-order-trunc < 0.5 then do:
     3872         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3873       end.
     3874       assign
     3875         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3876         .
     3877        assign
     3878         p-shift-num = truncate (p-shift-numd , 0)
     3879       .
     3880     end.
     3881   end procedure.
     3882   define temp-table temp-gds-qnty no-undo
     3883   field day as date
     3884   field prih as decimal
     3885   field rash as decimal
     3886   field ost  as decimal
     3887   field qnty-day as integer
     3888   index pi is unique primary day
     3889   index by-ost ost .
     3890   define variable qnty-lib-v-fact-order-2 as decimal no-undo .
     3891   procedure qnty-lib-clear-tt :
     3892    do
     3893    on error undo, return error return-value
     3894    :
     3895    for each temp-gds-qnty :
     3896        delete temp-gds-qnty .
     3897    end.
     3898    end.
     3899   end procedure.
     3900   procedure qnty-lib-create-tt :
     3901    do
     3902    on error undo, return error return-value
     3903    :
     3904   define input parameter p-fact-order-1 as decimal no-undo .
     3905   define input parameter p-fact-order-2 as decimal no-undo .
     3906   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3907   define input parameter p-obj-type as character no-undo .
     3908   define input parameter p-obj-code as integer no-undo .
     3909   define variable p-include-fact-order as logical no-undo .
     3910   define buffer buf_goods for ub.goods .
     3911   define variable quantity      as decimal no-undo .
     3912   define variable p-fact-date   as date no-undo .
     3913   define variable p-fact-date-0 as date no-undo .
     3914   define variable p-fact-date-2 as date no-undo .
     3915   define buffer p-doc-line for ub.doc-line .
     3916   define variable p-prih as decimal no-undo .
     3917   define variable p-rash as decimal no-undo .
     3918   qnty-lib-v-fact-order-2 = p-fact-order-2.
     3919   p-include-fact-order = true .
     3920   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     3921        if error-status :error then return error .
     3922          run prdoclib-init-prt-obj-by-factord in this-procedure
     3923               (input  p-obj-type
     3924               ,input  p-obj-code
     3925               ,input  buf_goods.artic
     3926               ,input  buf_goods.prod-type
     3927               ,input  buf_goods.prod-code
     3928               ,input  p-fact-order-1  + 0.99
     3929               ,input  p-include-fact-order
     3930               ) .
     3931         for each temp-prt-obj :
     3932             quantity   = quantity + temp-prt-obj.fact-qnty.
     3933         end.
     3934         run prdoclib-clear-temp-prt-obj in this-procedure .
     3935       run factord-to-date in this-procedure
     3936                           (  input  p-fact-order-1  ,
     3937                              output p-fact-date-0     ).
     3938       find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date-0 no-error .
     3939        if not available temp-gds-qnty then do:
     3940             create temp-gds-qnty.
     3941             assign
     3942               temp-gds-qnty.day      = p-fact-date-0
     3943               temp-gds-qnty.prih     = 0
     3944               temp-gds-qnty.rash     = 0
     3945               temp-gds-qnty.ost      = quantity
     3946               temp-gds-qnty.qnty-day = 0
     3947             .
     3948        end.
     3949        else do:
     3950             assign
     3951               temp-gds-qnty.day      = p-fact-date-0
     3952               temp-gds-qnty.prih     = 0
     3953               temp-gds-qnty.rash     = 0
     3954               temp-gds-qnty.ost      =  temp-gds-qnty.ost + quantity
     3955               temp-gds-qnty.qnty-day = 0
     3956             .
     3957       end.
     3958     run factord-to-date in this-procedure
     3959                         (  input  p-fact-order-2  ,
     3960                            output p-fact-date     ).
     3961      find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date no-error .
     3962        if not available temp-gds-qnty then do:
     3963             create temp-gds-qnty.
     3964             assign
     3965               temp-gds-qnty.day      = p-fact-date
     3966               temp-gds-qnty.prih     = 0
     3967               temp-gds-qnty.rash     = 0
     3968               temp-gds-qnty.ost      = 0
     3969               temp-gds-qnty.qnty-day = 0
     3970             .
     3971        end.
     3972   assign
     3973     p-prih  = 0
     3974     p-rash  = 0
     3975   .
     3976   define variable i as integer no-undo .
     3977          for each p-doc-line no-lock where
     3978                   p-doc-line.obj-type    = p-obj-type
     3979               and p-doc-line.obj-code    = p-obj-code
     3980               and p-doc-line.artic       = buf_goods.artic
     3981               and p-doc-line.prod-type   = buf_goods.prod-type
     3982               and p-doc-line.prod-code   = buf_goods.prod-code
     3983               and p-doc-line.status_     = 'факт':U
     3984               and p-doc-line.fact-order >= p-fact-order-1
     3985               and p-doc-line.fact-order <= p-fact-order-2 break by integer(p-doc-line.fact-order) :
     3986           case p-doc-line.ext-doc-type:
     3987                when   'ie':U  or
     3988                when   'im':U     then
     3989                  do:
     3990                     assign p-prih   = p-prih  +  p-doc-line.fact-qnty.
     3991                  end.
     3992                 when  'we':U      then if  p-t-sp      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3993                 when  'wm':U       then if  p-t-sppv    then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3994                 when  'em':U       then if  p-t-sppv-2  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3995                 when  'ev':U      then if  p-t-sppv-3  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3996                 when  'rv':U  then if  p-t-sppv-4  then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     3997                 when  'ee':U      then if  p-t-rv      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     3998                 when  're':U  then if  p-t-rvz     then assign p-rash   = p-rash  -  p-doc-line.fact-qnty.
     3999                 when  'es':U     then if p-t-rvc  then assign p-rash  = p-rash  +  p-doc-line.fact-qnty.
     4000                 when  'rs':U then if p-t-rvzc then assign p-rash  = p-rash  -  p-doc-line.fact-qnty.
     4001             end case.
     4002             assign
     4003               p-rash  = p-rash
     4004             .
     4005             if last-of(integer(p-doc-line.fact-order)) then do:
     4006               run factord-to-date in this-procedure (  input  p-doc-line.fact-order  ,
     4007                                      output p-fact-date-2   ).
     4008                   find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date-2 no-error .
     4009                   if not available temp-gds-qnty then do:
     4010                       create temp-gds-qnty.
     4011                       assign
     4012                         temp-gds-qnty.day      = p-fact-date-2
     4013                         temp-gds-qnty.prih     = p-prih
     4014                         temp-gds-qnty.rash     = p-rash
     4015                         temp-gds-qnty.ost      = 0
     4016                         temp-gds-qnty.qnty-day = 0
     4017                       .
     4018                   end.
     4019                   else do:
     4020                       assign
     4021                         temp-gds-qnty.prih     = temp-gds-qnty.prih + p-prih
     4022                         temp-gds-qnty.rash     = temp-gds-qnty.rash + p-rash
     4023                         temp-gds-qnty.ost      = temp-gds-qnty.ost
     4024                         temp-gds-qnty.qnty-day = 0
     4025                       .
     4026                   end.
     4027                   if temp-gds-qnty.rash <> 0  and
     4028                      p-fact-date-2 + 1  <  p-fact-date then  do:
     4029                      find first temp-gds-qnty where
     4030                                 temp-gds-qnty.day      = p-fact-date-2 + 1 no-error .
     4031                       if not available temp-gds-qnty then do:
     4032                           create temp-gds-qnty.
     4033                           assign
     4034                             temp-gds-qnty.day      = p-fact-date-2 + 1
     4035                             temp-gds-qnty.prih     = 0
     4036                             temp-gds-qnty.rash     = 0
     4037                             temp-gds-qnty.ost      = 0
     4038                             temp-gds-qnty.qnty-day = 0
     4039                           .
     4040                       end.
     4041                    end.
     4042                   assign
     4043                     p-prih  = 0
     4044                     p-rash  = 0
     4045                   .
     4046             end.
     4047       end.
     4048    define variable old-ost as decimal no-undo .
     4049    old-ost = 0 .
     4050    for each temp-gds-qnty break by temp-gds-qnty.day :
     4051       if  temp-gds-qnty.day      <> p-fact-date-0 then do:
     4052                 assign
     4053                    temp-gds-qnty.ost    = old-ost +    temp-gds-qnty.prih  - temp-gds-qnty.rash
     4054                 .
     4055                 end.
     4056       assign
     4057         old-ost = temp-gds-qnty.ost
     4058       .
     4059    end.
     4060    end.
     4061   end procedure.
     4062   procedure qnty-lib-2 :
     4063    do
     4064    on error undo, return error return-value
     4065    :
     4066   define variable p-fact-date-3 as date no-undo .
     4067   define variable old-day as date no-undo .
     4068   run factord-to-date in this-procedure (  input  qnty-lib-v-fact-order-2  ,
     4069                          output p-fact-date-3   ).
     4070    old-day = p-fact-date-3 + 1.
     4071    for each temp-gds-qnty break by temp-gds-qnty.day DESCENDING :
     4072       assign
     4073         temp-gds-qnty.qnty-day  =  old-day - temp-gds-qnty.day
     4074         old-day = temp-gds-qnty.day
     4075       .
     4076    end .
     4077    end.
     4078   end procedure.
