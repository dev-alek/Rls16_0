     4290   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4291   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4293     (input  store-type
     4294     ,input  store-code
     4295     ,output to-day
     4296     )  .
     4297     date-today = to-day .
     4298     l-qnty-qnty = ( loc-date-ship - date-today ) .
     4299    if l-qnty-qnty = ? then l-qnty-qnty  = 0 .
     4300    if l-qnty-qnty < 0 and G#type <> 'ОО':U  and G#type <> 'ОР':U then do:
     4301       message "Заказ не может быть рассчитан, разница Дата заказа и текущей датой " l-qnty-qnty " дней !" view-as alert-box error .
     4302       return.
     4303    end.
     4304   if not can-find (first obj-list) then do:
     4305       message "Ни задан ни один объект для расчета" view-as alert-box error .
     4306       return.
     4307   end.
     4308   assign l-action = true .
     4309   if p-mode-calc = ""  then do:
     4310       if  var#import = true   then do:
     4311         message "Данные были введены через ИМПОРТ , делать изменения количества заказа ?" view-as alert-box question
     4312           buttons
     4313           ok-cancel update g#log.
     4314           if g#log = false then return.
     4315           var#import = false.
     4316           end.
     4317       if t-action = "calc":u then do:
     4318         message
     4319          "Пересчитать заказ в соответствии с новыми параметрами расчета ?" skip
     4320          "В результате пересчета количество заказа может измениться."
     4321         view-as alert-box question
     4322           buttons
     4323           ok-cancel update g#log.
     4324           l-action = g#log .
     4325           end.
     4326    end.
     4327   else do:
     4328     var#import = false .
     4329     l-action = true .
     4330   end.
     4331   if  var#import = false  then do:
     4332     IF p-type-qnty-day = 1 Then do:
     4333       all-day = xdate-2 - xdate-1  + 1.
     4334     end.
     4335     IF p-type-qnty-day = 3 Then do:
     4336       all-day = 0 .
     4337       for each temp-dates :
     4338           all-day = all-day  + 1.
     4339       end.
     4340     end.
     4341   run calcitog in this-procedure  no-error .
     4342   for each tmp#zakaz :
     4343       if p-mode-calc <> ""  then do:
     4344           for each obj-list :
     4345               create export-ras.
     4346               BUFFER-COPY tmp#zakaz to export-ras
     4347               assign
     4348                 export-ras.obj-code = obj-list.obj-code
     4349                 export-ras.obj-type = obj-list.obj-type
     4350               .
     4351           end.
     4352       end.
     4353       assign
     4354           prih  = 0
     4355           rash  = 0
     4356           kassa = 0
     4357           ostatok-goods = 0
     4358           v-gds-way-all = 0
     4359         .
     4360         IF p-type-qnty-day = 2 Then do:
     4361           all-day = xdate-2 - xdate-1  + 1 .
     4362           l-null-day = 0 .
     4363           run qnty-lib-clear-tt in this-procedure .
     4364           for each obj-list no-lock :
     4365               run qnty-lib-create-tt in this-procedure
     4366                   ( input  integer(xdate-1)       ,
     4367                     input  fact-order-2       ,
     4368                     input  tmp#zakaz.gds-code ,
     4369                     input  obj-list.obj-type  ,
     4370                     input  obj-list.obj-code  )
     4371                     .
     4372           end.
     4373           run qnty-lib-2 in this-procedure .
     4374           run calc-null-day in this-procedure .
     4375           run calc-sale in this-procedure  .
     4376         end.
     4377         for each obj-list no-lock ,
     4378             each ub.gds-obj no-lock where ub.gds-obj.artic     = tmp#zakaz.artic      and
     4379                                       ub.gds-obj.prod-code = tmp#zakaz.prod-code   and
     4380                                       ub.gds-obj.prod-type = tmp#zakaz.prod-type   and
     4381                                       ub.gds-obj.obj-code  = obj-list.obj-code     and
     4382                                       ub.gds-obj.obj-type  = obj-list.obj-type     :
     4383             ostatok-goods = ostatok-goods + ub.gds-obj.fact-qnty  .
     4384             run goods-way in this-procedure  ( input obj-list.obj-type , input obj-list.obj-code , output  v-gds-way ) .
     4385             v-gds-way-all = v-gds-way-all + v-gds-way .
     4386             tmp#zakaz.gds-way = v-gds-way.
     4387             tmp#zakaz.min-stock-old = tmp#zakaz.min-stock.
     4388         end.
     4389     if p-r-algoritm = 3  then do :
     4390             d-rash  = 0 .
     4391             d-kassa = 0 .
     4392             IF p-type-qnty-day = 1  Then do:
     4393                   run qnty-lib-clear-tt in this-procedure .
     4394                   for each obj-list no-lock :
     4395                       run qnty-lib-create-tt in this-procedure
     4396                           ( input  integer(xdate-1)       ,
     4397                             input  fact-order-2       ,
     4398                             input  tmp#zakaz.gds-code ,
     4399                             input  obj-list.obj-type  ,
     4400                             input  obj-list.obj-code  )
     4401                             .
     4402                   end.
     4403                   run qnty-lib-2 in this-procedure .
     4404                   run calc-sale  in this-procedure .
     4405             end.
     4406             IF p-type-qnty-day = 3   then do :
     4407                       run qnty-lib-clear-tt.
     4408                       for each temp-dates no-lock :
     4409                           d-rash  = 0 .
     4410                           d-kassa = 0 .
     4411                         for each obj-list no-lock :
     4412                           run ob-line in this-procedure  (
     4413                               input   obj-list.obj-code   ,
     4414                               input   obj-list.obj-type   ,
     4415                               input   tmp#zakaz.artic       ,
     4416                               input   tmp#zakaz.prod-code   ,
     4417                               input   tmp#zakaz.prod-type   ,
     4418                               input    integer(temp-dates.exch-date)    ,
     4419                               input    integer(temp-dates.exch-date)  + 0.99  ,
     4420                               input   'cost':U    ,
     4421                               input   '##,##':U ,
     4422                               input   ""    ,
     4423                               input   false ,
     4424                               input   false ,
     4425                               output v-prih ,
     4426                               output v-rash ,
     4427                               output v-kassa
     4428                               )  no-error .
     4429                             assign
     4430                               d-rash  = d-rash  + v-rash
     4431                               d-kassa = d-kassa + v-kassa
     4432                               prih  = prih +  v-prih
     4433                               rash  = rash  + v-rash
     4434                               kassa = kassa + v-kassa
     4435                             .
     4436                             end.
     4437                             if  d-rash + d-kassa <> 0  then
     4438                                 run create-temp-rash in this-procedure  ( temp-dates.exch-date , d-rash + d-kassa ) .
     4439                       end.
     4440             end.
     4441     end.
     4442     if  p-r-algoritm = 4 then do :
     4443             d-rash  = 0 .
     4444             d-kassa = 0 .
     4445             IF p-type-qnty-day = 1  Then do:
     4446                 i-date-start = integer(xdate-1) .
     4447                 i-date-to    = integer(xdate-2) .
     4448                 run qnty-lib-clear-tt .
     4449                 repeat  i-date = i-date-start to i-date-to :
     4450                   d-rash  = 0 .
     4451                   d-kassa = 0 .
     4452                   for each obj-list no-lock :
     4453                     run ob-line (
     4454                       input obj-list.obj-code   ,
     4455                       input obj-list.obj-type   ,
     4456                       input tmp#zakaz.artic     ,
     4457                       input tmp#zakaz.prod-code ,
     4458                       input tmp#zakaz.prod-type ,
     4459                       input i-date              ,
     4460                       input i-date  + 0.99      ,
     4461                       input 'cost':U         ,
     4462                       input '##,##':U      ,
     4463                       input ""                  ,
     4464                       input false               ,
     4465                       input false               ,
     4466                       output v-prih             ,
     4467                       output v-rash             ,
     4468                       output v-kassa
     4469                       )  no-error .
     4470                       assign
     4471                         d-rash  = d-rash  + v-rash
     4472                         d-kassa = d-kassa + v-kassa
     4473                         prih    = prih    + v-prih
     4474                         rash    = rash    + v-rash
     4475                         kassa   = kassa   + v-kassa
     4476                       .
     4477                       end.
     4478                       if  d-rash + d-kassa <> 0  then
     4479                         run create-temp-rash ( date(i-date) , d-rash + d-kassa ) .
     4480                 end.
     4481              end.
     4482             IF p-type-qnty-day = 3   then do :
     4483                   run qnty-lib-clear-tt.
     4484                   for each temp-dates no-lock :
     4485                       d-rash  = 0 .
     4486                       d-kassa = 0 .
     4487                     for each obj-list :
     4488                       run ob-line in this-procedure  (
     4489                           input   obj-list.obj-code     ,
     4490                           input   obj-list.obj-type     ,
     4491                           input   tmp#zakaz.artic       ,
     4492                           input   tmp#zakaz.prod-code   ,
     4493                           input   tmp#zakaz.prod-type   ,
     4494                           input   integer(temp-dates.exch-date) ,
     4495                           input   integer(temp-dates.exch-date)  + 0.99  ,
     4496                           input   'cost':U    ,
     4497                           input   '##,##':U ,
     4498                           input   ""    ,
     4499                           input   false ,
     4500                           input   false ,
     4501                           output v-prih ,
     4502                           output v-rash ,
     4503                           output v-kassa
     4504                           )  no-error .
     4505                         assign
     4506                           d-rash  = d-rash  + v-rash
     4507                           d-kassa = d-kassa + v-kassa
     4508                           prih  = prih +  v-prih
     4509                           rash  = rash  + v-rash
     4510                           kassa = kassa + v-kassa
     4511                         .
     4512                         end.
     4513                         if  d-rash + d-kassa <> 0  then
     4514                             run create-temp-rash in this-procedure  ( temp-dates.exch-date , d-rash + d-kassa ) .
     4515                   end.
     4516             end.
     4517     end.
     4518    IF p-r-algoritm = 1  Then do:
     4519         IF p-type-qnty-day = 1  Then do:
     4520            for each obj-list no-lock :
     4521             run ob-line in this-procedure  (
     4522                 input   obj-list.obj-code   ,
     4523                 input   obj-list.obj-type   ,
     4524                 input   tmp#zakaz.artic       ,
     4525                 input   tmp#zakaz.prod-code   ,
     4526                 input   tmp#zakaz.prod-type   ,
     4527                 input   fact-order-1   ,
     4528                 input   fact-order-2   ,
     4529                 input   'cost':U    ,
     4530                 input   '##,##':U ,
     4531                 input   ""    ,
     4532                 input   false ,
     4533                 input   p-tog-det-prizn ,
     4534                 output v-prih ,
     4535                 output v-rash ,
     4536                 output v-kassa
     4537                 )  no-error .
     4538               assign
     4539                 prih  = prih +  v-prih
     4540                 rash  = rash  + v-rash
     4541                 kassa = kassa + v-kassa
     4542               .
     4543               end.
     4544         end.
     4545         IF p-type-qnty-day = 3 Then do:
     4546                        run qnty-lib-clear-tt.
     4547                       for each temp-dates no-lock :
     4548                         for each obj-list :
     4549                             run ob-line in this-procedure  (
     4550                                 input   obj-list.obj-code   ,
     4551                                 input   obj-list.obj-type   ,
     4552                                 input tmp#zakaz.artic     ,
     4553                                 input tmp#zakaz.prod-code ,
     4554                                 input tmp#zakaz.prod-type ,
     4555                                 input integer(temp-dates.exch-date)         ,
     4556                                 input integer(temp-dates.exch-date) + 0.99  ,
     4557                                 input 'cost':U    ,
     4558                                 input '##,##':U ,
     4559                                 input ""    ,
     4560                                 input false ,
     4561                                 input   p-tog-det-prizn ,
     4562                                 output v-prih ,
     4563                                 output v-rash ,
     4564                                 output v-kassa
     4565                                 )          no-error .
     4566                               assign
     4567                                 prih  = prih +  v-prih
     4568                                 rash  = rash  + v-rash
     4569                                 kassa = kassa + v-kassa
     4570                               .
     4571                           end.
     4572                       end.
     4573         end.
     4574   end.
     4575   if p-mode-calc = ""  then do:
     4576   assign
     4577     tmp#zakaz.qnty-kassa  = kassa
     4578     tmp#zakaz.qnty-prih   = prih
     4579     tmp#zakaz.qnty-rash   = rash
     4580     tmp#zakaz.qnty-stk    = ostatok-goods
     4581     tmp#zakaz.qnty-sale   = (rash + kassa)
     4582     .
     4583   end.
     4584   else do:
     4585   assign
     4586     export-ras.qnty-kassa  = kassa
     4587     export-ras.qnty-prih   = prih
     4588     export-ras.qnty-rash   = rash
     4589     export-ras.qnty-stk    = ostatok-goods
     4590     export-ras.qnty-sale   = (rash + kassa)
     4591     .
     4592   end.
     4593    all-day = all-day - l-null-day.
     4594       IF p-r-algoritm <> 2 Then do :
     4595           if p-mode-calc = ""  then do:
     4596              tmp#zakaz.temp-rash  = (rash + kassa) / all-day  .
     4597              tmp#zakaz.all-day    =  all-day  .
     4598              tmp#zakaz.zero-day    = l-null-day  .
     4599           end.
     4600           else do:
     4601              export-ras.temp-rash  = (rash + kassa) / all-day  .
     4602              export-ras.all-day    =  all-day  .
     4603              export-ras.zero-day    = l-null-day  .
     4604           end.
     4605       end.
     4606       else do:
     4607            if can-find (first temp-abc-day) then do:
     4608            if p-mode-calc <> ""  then export-ras.temp-rash = tmp#zakaz.temp-rash .
     4609         end.
     4610         else do:
     4611         find first ub.tmp-sale-gds where
     4612             ub.tmp-sale-gds.artic     = tmp#zakaz.artic     and
     4613             ub.tmp-sale-gds.prod-code = tmp#zakaz.prod-code and
     4614             ub.tmp-sale-gds.prod-type = tmp#zakaz.prod-type and
     4615             ub.tmp-sale-gds.tmp-code  = p-code no-lock no-error .
     4616             if available ub.tmp-sale-gds then do:
     4617                if p-mode-calc = ""  then do:
     4618                   assign  tmp#zakaz.temp-rash = ub.tmp-sale-gds.tmp-value .
     4619                   end.
     4620                   else do:
     4621                   assign  export-ras.temp-rash = ub.tmp-sale-gds.tmp-value .
     4622                   end.
     4623                end.
     4624                else do:
     4625                  if tmp#zakaz.add-qnty = 0 or tmp#zakaz.add-qnty = ? then do:
     4626                       if p-mode-calc = ""  then do:
     4627                           assign  tmp#zakaz.temp-rash = 0 .
     4628                       end.
     4629                       else do:
     4630                           assign  export-ras.temp-rash = 0 .
     4631                       end.
     4632                   end.
     4633                end.
     4634           end.
     4635       end.
     4636       for each obj-list :
     4637         assign v-corr-coeff = decimal(v-value) * decimal (tmp#zakaz.season-coef).
     4638         if v-corr-coeff = 0 then v-corr-coeff = 1.
     4639       end.
     4640   find first temp-abc-day where
     4641              temp-abc-day.abc-type  = chr(int(tmp#zakaz.add-cli-qnty)) no-error .
     4642   if available  temp-abc-day then do:
     4643      pay-day = temp-abc-day.gar-day .
     4644   end.
     4645   else  pay-day = old-pay-day .
     4646   define variable p-l-max0 as decimal no-undo .
     4647   define variable p-l-max as decimal no-undo .
     4648       if l-action = true  then do :
     4649           if l-action = true  then do :
     4650              if tmp#zakaz.temp-rash = ? then tmp#zakaz.temp-rash = 0 .
     4651              end.
     4652           else do:
     4653             if export-ras.temp-rash = ? then export-ras.temp-rash = 0 .
     4654           end.
     4655             case  p-r-algoritm :
     4656                  when 1  or when 2 then do :
     4657                      run z-qnty in this-procedure .
     4658                      run z-qnty-e in this-procedure .
     4659                  end.
     4660                  when 3 then do :
     4661                      run v-qnty in this-procedure .
     4662                      run v-qnty-e in this-procedure .
     4663                  end.
     4664                  when 4 then do :
     4665                      run m-qnty in this-procedure    (output p-l-max0).
     4666                      run m-qnty-e in this-procedure  (output p-l-max).
     4667                  end.
     4668                  when 5 then do :
     4669                      run u-qnty in this-procedure .
     4670                      run u-qnty-e in this-procedure .
     4671                  end.
     4672              end case.
     4673         if  p-mode-calc = ""   then do:
     4674         assign
     4675             tmp#zakaz.qnty     = l-new-zakaz
     4676             tmp#zakaz.cli-qnty = tmp#zakaz.qnty / tmp#zakaz.cli-base-rate
     4677             tmp#zakaz.sum-cli = tmp#zakaz.price-cli * tmp#zakaz.cli-qnty
     4678             tmp#zakaz.sum-rubl = tmp#zakaz.price-rubl * tmp#zakaz.qnty
     4679             tmp#zakaz.sum-base = tmp#zakaz.price-base * tmp#zakaz.qnty
     4680         .
     4681         end.
     4682         else do:
     4683         assign
     4684             export-ras.qnty     = l-new-zakaz
     4685             export-ras.cli-qnty = export-ras.qnty       / export-ras.cli-base-rate
     4686             export-ras.sum-cli  = export-ras.price-cli  * export-ras.cli-qnty
     4687             export-ras.sum-rubl = export-ras.price-rubl * export-ras.qnty
     4688             export-ras.sum-base = export-ras.price-base * export-ras.qnty
     4689             export-ras.ostatok-today = export-ras.qnty-stk
     4690             export-ras.gds-way-all   = v-gds-way-all
     4691         .
     4692         end.
     4693         if  p-mode-calc = ""   then do:
     4694                 run recalc-cli-qnty in this-procedure  (
     4695                    input        tmp#zakaz.gds-code
     4696                   ,input        p-round-m
     4697                   ,input        p-round-base
     4698                   ,input        tmp#zakaz.unit-cli
     4699                   ,input        tmp#zakaz.cli-base-rate
     4700                   ,input        tmp#zakaz.price-cli
     4701                   ,input        tmp#zakaz.price-rubl
     4702                   ,input        tmp#zakaz.price-base
     4703                   ,input-output tmp#zakaz.cli-qnty
     4704                   ,input-output tmp#zakaz.qnty
     4705                   ,input-output tmp#zakaz.sum-cli
     4706                   ,input-output tmp#zakaz.sum-rubl
     4707                   ,input-output tmp#zakaz.sum-base
     4708                   ).
     4709             tmp#zakaz.initial-qnty = tmp#zakaz.qnty.
     4710             tmp#zakaz.order-qnty = tmp#zakaz.qnty  .
     4711             for each obj-list no-lock :
     4712             run create-obj-temp in this-procedure (
     4713                input p-ord-doc ,
     4714                input tmp#zakaz.gds-code ,
     4715                input obj-list.obj-type ,
     4716                input obj-list.obj-code ,
     4717                input tmp#zakaz.qnty
     4718                ) .
     4719             run create-min-stock-gds-way in this-procedure (
     4720                input p-ord-doc ,
     4721                input tmp#zakaz.gds-code ,
     4722                input tmp#zakaz.min-stock,
     4723                input tmp#zakaz.gds-way
     4724                ) .
     4725         end.
     4726         end.
     4727         else do:
     4728             run recalc-cli-qnty in this-procedure  (
     4729                  input        export-ras.gds-code
     4730                 ,input        p-round-m
     4731                 ,input        p-round-base
     4732                 ,input        export-ras.unit-cli
     4733                 ,input        export-ras.cli-base-rate
     4734                 ,input        export-ras.price-cli
     4735                 ,input        export-ras.price-rubl
     4736                 ,input        export-ras.price-base
     4737                 ,input-output export-ras.cli-qnty
     4738                 ,input-output export-ras.qnty
     4739                 ,input-output export-ras.sum-cli
     4740                 ,input-output export-ras.sum-rubl
     4741                 ,input-output export-ras.sum-base
     4742                 ).
     4743               export-ras.Temp-rash = ( if export-ras.Temp-rash <> ?  then export-ras.Temp-rash else 0 )  .
     4744               if p-r-algoritm = 4 then  export-ras.temp-rash = p-l-max .
     4745               export-ras.initial-qnty = export-ras.qnty.
     4746               export-ras.Temp-rash = ( if export-ras.Temp-rash <> ?  then export-ras.Temp-rash
     4747                                                                       else 0 ) .
     4748           if p-r-algoritm = 4 then  export-ras.temp-rash = p-l-max .
     4749         end.
     4750         if g#type = 'ФП':U then
     4751                 run create-protocol in this-procedure
     4752                 (  input p-ord-doc
     4753                   ,input tmp#zakaz.gds-code
     4754                   ,input v-protocol-date
     4755                   ,input v-protocol-time
     4756                   ,input "По списку"
     4757                   ,input 0
     4758                   ,input v-stroka-protocol).
     4759         else do:
     4760             for each obj-list:
     4761                 run create-protocol in this-procedure
     4762                 (  input p-ord-doc
     4763                   ,input tmp#zakaz.gds-code
     4764                   ,input v-protocol-date
     4765                   ,input v-protocol-time
     4766                   ,input obj-list.obj-type
     4767                   ,input obj-list.obj-code
     4768                   ,input v-stroka-protocol).
     4769             end.
     4770         end.
     4771       end.
     4772       if p-tog-det-prizn then do :
     4773           v-sum-qnty-prt = 0.
     4774           for each tmp#zakaz-prn where tmp#zakaz-prn.artic     = export-ras.artic     and
     4775                                        tmp#zakaz-prn.prod-type = export-ras.prod-type and
     4776                                        tmp#zakaz-prn.prod-code = export-ras.prod-code no-lock
     4777           :
     4778             assign
     4779               tmp#zakaz-prn.qnty-ord = round((export-ras.qnty * (tmp#zakaz-prn.qnty-sale / export-ras.qnty-sale)), 0)
     4780               v-sum-qnty-prt = v-sum-qnty-prt + tmp#zakaz-prn.qnty-ord
     4781             .
     4782             if tmp#zakaz-prn.qnty-ord = ? then tmp#zakaz-prn.qnty-ord = 0 .
     4783           end.
     4784           for each tmp#zakaz-prn where tmp#zakaz-prn.artic     = export-ras.artic     and
     4785                                        tmp#zakaz-prn.prod-type = export-ras.prod-type and
     4786                                        tmp#zakaz-prn.prod-code = export-ras.prod-code no-lock break by tmp#zakaz-prn.prt-code descending
     4787           :
     4788               if v-sum-qnty-prt > export-ras.qnty then
     4789                 assign
     4790                   tmp#zakaz-prn.qnty-ord = tmp#zakaz-prn.qnty-ord - 1
     4791                   v-sum-qnty-prt         = v-sum-qnty-prt         - 1
     4792                 .
     4793               if v-sum-qnty-prt < export-ras.qnty then
     4794                 assign
     4795                   tmp#zakaz-prn.qnty-ord = tmp#zakaz-prn.qnty-ord + 1
     4796                   v-sum-qnty-prt         = v-sum-qnty-prt         + 1
     4797                 .
     4798           end.
     4799       end.
     4800    end.
     4801    if p-mode-calc <> ""  and p-mode-calc <> "all-ord":U  then do:
     4802      run cus/z-tot5.p ( parParentProc , input table export-ras , input p-ord-doc , input p-e-method , input v-show-all-goods ) .
     4803    end.
     4804     if  p-mode-calc = "all-ord":U  then do:
     4805        run cus/z-tot6.p ( parParentProc , input table export-ras , input table tmp#zakaz-prn , g#type ) .
     4806     end.
     4807   end.
     4808   procedure calcitog :
     4809      assign
     4810        fact-order-1 = integer(xdate-1 - 1 ) + 0.99
     4811        fact-order-2 = integer(xdate-2) + 0.99
     4812        fact-order-today = integer(date-today) + 0.99
     4813      .
     4814   end procedure.
     4815   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4816   procedure ob-line  :
     4817   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     4818   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     4819   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     4820   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     4821   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     4822   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     4823   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     4824   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     4825   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     4826   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     4827   define input  parameter xtog-obj         as   logical no-undo.
     4828   define input  parameter xtog-prn         as   logical no-undo.
     4829   define output parameter p-prih  as decimal no-undo .
     4830   define output parameter p-rash  as decimal no-undo .
     4831   define output parameter p-kassa as decimal no-undo .
     4832   define buffer p-doc-line for ub.doc-line.
     4833   define buffer p-gds-dtl  for ub.gds-dtl.
     4834   define variable p-doc-type as character no-undo .
     4835   define variable str-doc-type as character no-undo .
     4836   str-doc-type =
     4837   'ie':U      + "," +
     4838   'im':U     + "," +
     4839   'we':U      + "," +
     4840   'wm':U       + "," +
     4841   'em':U       + "," +
     4842   'ev':U      + "," +
     4843   'rv':U  + "," +
     4844   'ee':U      + "," +
     4845   're':U  + "," +
     4846   'es':U + "," +
     4847   'rs':U .
     4848   assign
     4849     p-prih  = 0
     4850     p-rash  = 0
     4851     p-kassa = 0
     4852   .
     4853   define variable i as integer no-undo .
     4854   define variable v-nn as integer   no-undo .
     4855   v-nn = num-entries( str-doc-type ) .
     4856     repeat i = 1 to v-nn :
     4857       p-doc-type = entry( i, str-doc-type) .
     4858          for each p-doc-line where
     4859                   p-doc-line.obj-type    = x-store-type
     4860               and p-doc-line.obj-code    = x-store-code
     4861               and p-doc-line.artic       = x-artic
     4862               and p-doc-line.prod-type   = x-prod-type
     4863               and p-doc-line.prod-code   = x-prod-code
     4864               and p-doc-line.ext-doc-type = p-doc-type
     4865               and p-doc-line.status_     = 'факт':U
     4866               and p-doc-line.fact-order >= x-fact-order-1
     4867               and p-doc-line.fact-order <= x-fact-order-2 no-lock :
     4868           case p-doc-line.ext-doc-type:
     4869                when   'ie':U  or
     4870                when   'im':U     then
     4871                  do:
     4872                  assign p-prih   = p-prih  +  p-doc-line.fact-qnty.
     4873                  end.
     4874                 when  'we':U      then if  p-t-sp      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4875                 when  'wm':U       then if  p-t-sppv    then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4876                 when  'em':U       then if  p-t-sppv-2  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4877                 when  'ev':U      then if  p-t-sppv-3  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4878                 when  'rv':U  then if  p-t-sppv-4  then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     4879                 when  'ee':U      then if  p-t-rv      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4880                 when  're':U  then if  p-t-rvz     then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     4881                 when  'es':U     then if p-t-rvc  then assign p-kassa  = p-kassa  +  p-doc-line.fact-qnty.
     4882                 when  'rs':U then if p-t-rvzc then assign p-kassa  = p-kassa  -  p-doc-line.fact-qnty.
     4883             end case.
     4884             if xtog-prn then
     4885             for each p-gds-dtl where p-gds-dtl.doc-code  = p-doc-line.doc-code  and
     4886                                      p-gds-dtl.artic     = p-doc-line.artic     and
     4887                                      p-gds-dtl.prod-type = p-doc-line.prod-type and
     4888                                      p-gds-dtl.prod-code = p-doc-line.prod-code no-lock  :
     4889                 find first tmp#zakaz-prn where tmp#zakaz-prn.artic     = p-gds-dtl.artic     and
     4890                                                tmp#zakaz-prn.prod-type = p-gds-dtl.prod-type and
     4891                                                tmp#zakaz-prn.prod-code = p-gds-dtl.prod-code and
     4892                                                tmp#zakaz-prn.obj-type  = p-gds-dtl.obj-type  and
     4893                                                tmp#zakaz-prn.obj-code  = p-gds-dtl.obj-code  and
     4894                                                tmp#zakaz-prn.prt-code  = p-gds-dtl.prt-code  no-lock no-error .
     4895                 if not available tmp#zakaz-prn then do :
     4896                   create tmp#zakaz-prn.
     4897                   assign
     4898                      tmp#zakaz-prn.artic     = p-gds-dtl.artic
     4899                      tmp#zakaz-prn.prod-type = p-gds-dtl.prod-type
     4900                      tmp#zakaz-prn.prod-code = p-gds-dtl.prod-code
     4901                      tmp#zakaz-prn.obj-type  = p-gds-dtl.obj-type
     4902                      tmp#zakaz-prn.obj-code  = p-gds-dtl.obj-code
     4903                      tmp#zakaz-prn.prt-code  = p-gds-dtl.prt-code
     4904                   .
     4905       end.
     4906                 case p-doc-line.ext-doc-type:
     4907                       when  'we':U      then if  p-t-sp      then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4908                       when  'wm':U       then if  p-t-sppv    then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4909                       when  'em':U       then if  p-t-sppv-2  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4910                       when  'ev':U      then if  p-t-sppv-3  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4911                       when  'rv':U  then if  p-t-sppv-4  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   -  p-gds-dtl.fact-qnty.
     4912                       when  'ee':U      then if  p-t-rv      then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4913                       when  're':U  then if  p-t-rvz     then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   -  p-gds-dtl.fact-qnty.
     4914                       when  'es':U     then if p-t-rvc  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4915                       when  'rs':U then if p-t-rvzc then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   -  p-gds-dtl.fact-qnty.
     4916                   end case.
     4917             end.
     4918       end.
     4919     end.
     4920   assign
     4921     p-rash  = p-rash
     4922     p-kassa = p-kassa
     4923   .
     4924   end procedure.
     4925   procedure goods-way :
     4926    do
     4927    on error undo, return error return-value
     4928    :
     4929    define buffer later_ord-doc for ub.ord-doc.
     4930    define buffer later_ord-line for ub.ord-line.
     4931    define buffer later_ord-doc-rcv for ub.ord-doc-rcv.
     4932    define buffer later_ord-line-rcv for ub.ord-line-rcv.
     4933    define input parameter p-obj-type like ub.clients.obj-type no-undo .
     4934    define input parameter p-obj-code like ub.clients.obj-code no-undo .
     4935    define output parameter p-qnty as decimal no-undo .
     4936    p-qnty = 0 .
     4937    if p-t-way = true then do:
     4938      for each later_ord-line no-lock where
     4939               later_ord-line.artic     = tmp#zakaz.artic       and
     4940               later_ord-line.prod-code = tmp#zakaz.prod-code   and
     4941               later_ord-line.prod-type = tmp#zakaz.prod-type  ,
     4942          each later_ord-doc  no-lock where
     4943               later_ord-doc.doc-code  = later_ord-line.doc-code and
     4944               later_ord-doc.ship-date <= loc-date-ship          and
     4945               later_ord-doc.obj-type = p-obj-type               and
     4946               later_ord-doc.obj-code = p-obj-code               and
     4947               later_ord-doc.status_   <>  'новый':U            and
     4948               later_ord-doc.status_   <>  'факт':U            :
     4949             find first later_ord-line-rcv where
     4950                 later_ord-line-rcv.doc-code = later_ord-line.doc-code and
     4951                 later_ord-line-rcv.artic     = tmp#zakaz.artic        and
     4952                 later_ord-line-rcv.prod-code = tmp#zakaz.prod-code    and
     4953                 later_ord-line-rcv.prod-type = tmp#zakaz.prod-type
     4954                 no-error.
     4955             find first later_ord-doc-rcv where
     4956                 later_ord-doc-rcv.doc-code  = later_ord-line.doc-code     and
     4957                 later_ord-doc-rcv.rcv-code  = later_ord-line-rcv.rcv-code and
     4958                 later_ord-doc-rcv.status_   = 'факт':U
     4959                 no-error.
     4960             if available later_ord-doc-rcv then next.
     4961             if  G#type <> 'ОО':U  then do:
     4962                   if ( p-t-rcv  and  later_ord-doc.status_   =  'поставка':U)
     4963                     OR
     4964                     ( p-t-clos  and  later_ord-doc.status_ = 'закрыто':U ) then do:
     4965                         p-qnty = p-qnty +  ( if  later_ord-line.qnty <> ? then later_ord-line.qnty
     4966                                                                               else 0  ) .
     4967                         end.
     4968               end.
     4969               else do:
     4970                 if  p-t-rcv  and  later_ord-doc.status_   =  'запрос':U  and later_ord-doc.doc-type = 'ОО':U  then do:
     4971                       p-qnty = p-qnty +  ( if  later_ord-line.qnty <> ? then later_ord-line.qnty
     4972                                                                         else 0  ) .
     4973                   end.
     4974               end.
     4975        end.
     4976    end.
     4977    end.
     4978   end procedure.
     4979   procedure create-temp-rash :
     4980    do
     4981    on error undo, return error return-value
     4982    :
     4983     define input parameter p-date as date   no-undo .
     4984     define input parameter p-val as decimal no-undo .
     4985     find first temp-gds-qnty where
     4986           temp-gds-qnty.day = p-date no-error
     4987           .
     4988     if not available temp-gds-qnty then do:
     4989        create temp-gds-qnty.
     4990        assign
     4991           temp-gds-qnty.day = p-date
     4992           temp-gds-qnty.rash = p-val
     4993           temp-gds-qnty.qnty-day = 1
     4994           .
     4995     end.
     4996     else do:
     4997        assign
     4998           temp-gds-qnty.rash = temp-gds-qnty.rash + p-val
     4999           temp-gds-qnty.qnty-day = 1
     5000           .
     5001     end.
     5002    end.
     5003   end procedure.
     5004   procedure z-qnty :
     5005    do
     5006    on error undo, return error return-value
     5007    :
     5008     if p-mode-calc = ""  then do:
     5009   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5010   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5011   Assign
     5012     l-Ostatok-today =  tmp#zakaz.qnty-stk
     5013     l-negative-rest =  tmp#zakaz.negative-rest
     5014     l-qnty-day      =  l-qnty-qnty
     5015     l-pay-day       =  pay-day
     5016     l-Temp-rash     = if tmp#zakaz.temp-rash < 0  then 0 else tmp#zakaz.temp-rash
     5017     l-min-zap       =  tmp#zakaz.min-stock
     5018     l-negative-sale =  p-neg-sale
     5019     l-goods-way     =  v-gds-way-all
     5020     l-tog-min-order =  p-t-min-zapas
     5021     l-min-order     =  tmp#zakaz.min-order
     5022     loc-unit-base   =  tmp#zakaz.unit-base
     5023     l-min-ost       =  p-t-min-ost
     5024     l-TOG-deadline  =  p-t-deadline
     5025     l-deadline      =  tmp#zakaz.deadline
     5026     l-type-MR       =  p-e-method
     5027     l-corr-coeff    =  v-corr-coeff
     5028     .
     5029   if l-Temp-rash = ? then l-Temp-rash = 0.
     5030     if par-ord-min-ost = yes then do:
     5031       assign l-min-zap = l-Temp-rash * l-corr-coeff * tmp#zakaz.min-stock .
     5032     end.
     5033     assign L-a = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * l-qnty-day) .
     5034     if L-a  <= 0 then do:
     5035       if l-negative-rest = true then do:
     5036         if l-negative-sale then do:
     5037           Assign
     5038             l-a = 0
     5039             l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5040           .
     5041         end.
     5042         else do:
     5043           assign l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff).
     5044         end.
     5045       end.
     5046       else do:
     5047         Assign
     5048           l-a = 0
     5049           l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5050         .
     5051       end.
     5052     end.
     5053     Else do :
     5054       assign l-b = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * (l-qnty-day + l-pay-day ) ) .
     5055             if l-b >= l-min-zap then l-order = 0.
     5056                                 else DO:
     5057                                 If l-b < 0 Then l-order = absolute(l-b) + l-min-zap.
     5058                                            Else l-order = l-min-zap - absolute(l-b).
     5059                                 End.
     5060      End.
     5061    assign
     5062     v-protocol-date = today
     5063     v-protocol-time = time
     5064    .
     5065   if is-log = true then  put stream stream_order unformatted
     5066   ">> Базовый способ расчета заказа "  v-protocol-date " " string(v-protocol-time,"hh:mm:ss") skip
     5067      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5068      "Остаток на сегодня:" l-Ostatok-today skip
     5069      "Отриц.остатки     :" l-negative-rest skip
     5070      "дней до доставки  :" l-qnty-day      skip
     5071      "дней в продаже    :" l-pay-day       skip
     5072      "Темп продаж       :" l-Temp-rash     skip
     5073      "Коррект.коэфф.    :" l-corr-coeff    skip
     5074      "Дней без продажи  :" l-null-day      skip
     5075      "MIN остаток       :" l-min-zap       skip
     5076      "отриц.продажа     :" l-negative-sale skip
     5077      "рассчитано заказа :" l-order         skip
     5078      "_________________  "                 skip
     5079      "min заказ         :" l-min-order     skip
     5080      "товар в пути      :" l-goods-way     skip
     5081      "срок хранения     :" l-deadline      skip
     5082      .
     5083   l-type-MR = entry(2, entry(1,l-type-MR,";"),":") no-error .
     5084   if l-type-MR = ? then l-type-MR = "Базовый способ расчета заказа" .
     5085   v-stroka-protocol = "" .
     5086   v-stroka-protocol =
     5087      "00.Метод расчета заказа:" + l-type-MR  + chr(4) +
     5088      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5089      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5090      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5091      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5092      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5093      "05.1>>Коррект.коэфф. :" + string(l-corr-coeff   ) + chr(4) +
     5094      "06.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5095      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5096      "08.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5097      "09.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5098      "10.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5099      "11.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5100      "12.срок хранения     :" + string(l-deadline     ) + chr(4) .
     5101     v-media-qnty = l-order .
     5102     if (l-order - l-goods-way) < 0 then
     5103        l-new-zakaz = 0 .
     5104     else
     5105        l-new-zakaz = l-order - l-goods-way .
     5106    assign v-stroka-protocol = v-stroka-protocol + "13.1>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5107     if l-min-ost = true then do:
     5108         if l-Ostatok-today > l-min-zap then
     5109             l-new-zakaz = 0 .
     5110         assign v-stroka-protocol = v-stroka-protocol + "13.2>>После проверки на MIN остаток:" + string(l-new-zakaz) + chr(4)  .
     5111     end.
     5112   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5113       and lookup('шту':U, ub.units.type) > 0)
     5114       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5115           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     5116           assign v-stroka-protocol = v-stroka-protocol + "13.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5117       end.
     5118     if  l-deadline > 0 and l-tog-deadline = true   then do:
     5119        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5120        v-stroka-protocol = v-stroka-protocol + "13.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5121    end .
     5122    if l-tog-min-order then do:
     5123     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5124        l-new-zakaz = 0 .
     5125        assign v-stroka-protocol = v-stroka-protocol + "13.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5126    end .
     5127   if l-new-zakaz = ? then l-new-zakaz = 0 .
     5128   if is-log = true then  put STREAM  stream_order unformatted "Итого (БЕЗ ОКР)"  l-new-zakaz skip
     5129    .
     5130   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5131    assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5132     end.
     5133    end.
     5134   end procedure.
     5135   procedure z-qnty-e :
     5136    do
     5137    on error undo, return error return-value
     5138    :
     5139     if p-mode-calc <> ""  then do:
     5140   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5141   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5142   Assign
     5143     l-Ostatok-today =  export-ras.qnty-stk
     5144     l-negative-rest =  export-ras.negative-rest
     5145     l-qnty-day      =  l-qnty-qnty
     5146     l-pay-day       =  pay-day
     5147     l-Temp-rash     = if export-ras.temp-rash < 0  then 0 else export-ras.temp-rash
     5148     l-min-zap       =  export-ras.min-stock
     5149     l-negative-sale =  p-neg-sale
     5150     l-goods-way     =  v-gds-way-all
     5151     l-tog-min-order =  p-t-min-zapas
     5152     l-min-order     =  export-ras.min-order
     5153     loc-unit-base   =  export-ras.unit-base
     5154     l-min-ost       =  p-t-min-ost
     5155     l-TOG-deadline  =  p-t-deadline
     5156     l-deadline      =  export-ras.deadline
     5157     l-type-MR       =  p-e-method
     5158     l-corr-coeff    =  v-corr-coeff
     5159     .
     5160   if l-Temp-rash = ? then l-Temp-rash = 0.
     5161     if par-ord-min-ost = yes then do:
     5162       assign l-min-zap = l-Temp-rash * l-corr-coeff * export-ras.min-stock .
     5163     end.
     5164     assign L-a = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * l-qnty-day) .
     5165     if L-a  <= 0 then do:
     5166       if l-negative-rest = true then do:
     5167         if l-negative-sale then do:
     5168           Assign
     5169             l-a = 0
     5170             l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5171           .
     5172         end.
     5173         else do:
     5174           assign l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff).
     5175         end.
     5176       end.
     5177       else do:
     5178         Assign
     5179           l-a = 0
     5180           l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5181         .
     5182       end.
     5183     end.
     5184     Else do :
     5185       assign l-b = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * (l-qnty-day + l-pay-day ) ) .
     5186             if l-b >= l-min-zap then l-order = 0.
     5187                                 else DO:
     5188                                 If l-b < 0 Then l-order = absolute(l-b) + l-min-zap.
     5189                                            Else l-order = l-min-zap - absolute(l-b).
     5190                                 End.
     5191      End.
     5192    assign
     5193     v-protocol-date = today
     5194     v-protocol-time = time
     5195    .
     5196   if is-log = true then  put stream stream_order unformatted
     5197   ">> Базовый способ расчета заказа "  v-protocol-date " " string(v-protocol-time,"hh:mm:ss") skip
     5198      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5199      "Остаток на сегодня:" l-Ostatok-today skip
     5200      "Отриц.остатки     :" l-negative-rest skip
     5201      "дней до доставки  :" l-qnty-day      skip
     5202      "дней в продаже    :" l-pay-day       skip
     5203      "Темп продаж       :" l-Temp-rash     skip
     5204      "Коррект.коэфф.    :" l-corr-coeff    skip
     5205      "Дней без продажи  :" l-null-day      skip
     5206      "MIN остаток       :" l-min-zap       skip
     5207      "отриц.продажа     :" l-negative-sale skip
     5208      "рассчитано заказа :" l-order         skip
     5209      "_________________  "                 skip
     5210      "min заказ         :" l-min-order     skip
     5211      "товар в пути      :" l-goods-way     skip
     5212      "срок хранения     :" l-deadline      skip
     5213      .
     5214   l-type-MR = entry(2, entry(1,l-type-MR,";"),":") no-error .
     5215   if l-type-MR = ? then l-type-MR = "Базовый способ расчета заказа" .
     5216   v-stroka-protocol = "" .
     5217   v-stroka-protocol =
     5218      "00.Метод расчета заказа:" + l-type-MR  + chr(4) +
     5219      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5220      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5221      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5222      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5223      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5224      "05.1>>Коррект.коэфф. :" + string(l-corr-coeff   ) + chr(4) +
     5225      "06.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5226      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5227      "08.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5228      "09.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5229      "10.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5230      "11.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5231      "12.срок хранения     :" + string(l-deadline     ) + chr(4) .
     5232     export-ras.order-qnty = l-order .
     5233     if (l-order - l-goods-way) < 0 then
     5234        l-new-zakaz = 0 .
     5235     else
     5236        l-new-zakaz = l-order - l-goods-way .
     5237    assign v-stroka-protocol = v-stroka-protocol + "13.1>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5238     if l-min-ost = true then do:
     5239         if l-Ostatok-today > l-min-zap then
     5240             l-new-zakaz = 0 .
     5241         assign v-stroka-protocol = v-stroka-protocol + "13.2>>После проверки на MIN остаток:" + string(l-new-zakaz) + chr(4)  .
     5242     end.
     5243   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5244       and lookup('шту':U, ub.units.type) > 0)
     5245       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5246           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     5247           assign v-stroka-protocol = v-stroka-protocol + "13.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5248       end.
     5249     if  l-deadline > 0 and l-tog-deadline = true   then do:
     5250        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5251        v-stroka-protocol = v-stroka-protocol + "13.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5252    end .
     5253    if l-tog-min-order then do:
     5254     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5255        l-new-zakaz = 0 .
     5256        assign v-stroka-protocol = v-stroka-protocol + "13.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5257    end .
     5258   if l-new-zakaz = ? then l-new-zakaz = 0 .
     5259   if is-log = true then  put STREAM  stream_order unformatted "Итого (БЕЗ ОКР)"  l-new-zakaz skip
     5260    .
     5261   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5262    assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5263     end.
     5264    end.
     5265   end procedure.
     5266   procedure v-qnty :
     5267    do
     5268    on error undo, return error return-value
     5269    :
     5270     if p-mode-calc = ""  then do:
     5271   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5272   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5273   define variable loc-unit-base    as character no-undo .
     5274   define variable l-gar-zapas      as logical no-undo .
     5275   define variable l-tog-min-order  as logical no-undo .
     5276   define variable l-min-order      as decimal no-undo .
     5277   define variable l-min-ost         as logical   no-undo .
     5278   define variable  v-sigma          as decimal no-undo .
     5279   define variable  loc-rkv as decimal no-undo .
     5280   define variable  loc-q as integer no-undo .
     5281   define variable  p-serv     as decimal   no-undo .
     5282   define variable  p-x     as decimal   no-undo .
     5283   define variable v-norm-obr as decimal   no-undo .
     5284   Assign
     5285     l-Ostatok-today =  tmp#zakaz.qnty-stk
     5286     l-negative-rest =  tmp#zakaz.negative-rest
     5287     l-qnty-day      =  l-qnty-qnty
     5288     l-pay-day       =  pay-day
     5289     l-Temp-rash     = if tmp#zakaz.temp-rash < 0  then 0 else tmp#zakaz.temp-rash
     5290     l-min-zap       =  tmp#zakaz.min-stock
     5291     l-negative-sale =  p-neg-sale
     5292     l-goods-way     =  v-gds-way-all
     5293     p-serv          =  tmp#zakaz.service-order
     5294     l-gar-zapas     =  p-t-gar
     5295     l-tog-min-order =  p-t-min-zapas
     5296     l-min-order     =  tmp#zakaz.min-order
     5297     loc-unit-base   =  tmp#zakaz.unit-base
     5298     l-min-ost       =  p-t-min-ost
     5299     l-TOG-deadline  =  p-t-deadline
     5300     l-deadline      =  tmp#zakaz.deadline
     5301     l-corr-coeff    =  v-corr-coeff
     5302     .
     5303   if l-Temp-rash = ? then l-Temp-rash = 0.
     5304    if par-ord-min-ost = yes then do:
     5305       assign l-min-zap =  l-Temp-rash * l-corr-coeff * tmp#zakaz.min-stock .
     5306    end.
     5307      loc-rkv  = 0 .
     5308      loc-q  = 0 .
     5309      for each temp-gds-qnty :
     5310          loc-rkv = loc-rkv + exp((temp-gds-qnty.rash  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5311          loc-q = loc-q  + temp-gds-qnty.qnty-day.
     5312      end.
     5313      define variable ll-i as integer no-undo .
     5314      if  all-day - loc-q > 0 then do:
     5315         do ll-i = 1 to  (all-day - loc-q) :
     5316            loc-rkv = loc-rkv + exp(( 0  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5317         end.
     5318      end.
     5319      assign v-sigma =   sqrt( loc-rkv / ( all-day  - 1)) .
     5320      if v-sigma = ? then v-sigma = 0 .
     5321      if p-serv = ? or p-serv = 0 or p-serv = 1
     5322      then p-serv = .5 .
     5323      if l-Temp-rash = ? then l-Temp-rash = 0.
     5324      run normobr in this-procedure
     5325      ( input   p-serv    ,
     5326        input   l-Temp-rash * l-corr-coeff  ,
     5327        input   v-sigma ,
     5328        output  p-x     )
     5329        .
     5330        assign v-norm-obr = p-x .
     5331     if  p-x  - l-Temp-rash * l-corr-coeff < 0
     5332         then p-x =  0 .
     5333         else p-x = (p-x  - l-Temp-rash * l-corr-coeff ) * ( l-pay-day + l-qnty-day ) .
     5334     assign L-a = l-Ostatok-today - ( l-Temp-rash * l-corr-coeff * l-qnty-day ) .
     5335     if L-a  <= 0 then do:
     5336             if l-negative-sale = true or l-negative-rest = false  then do:
     5337                 assign
     5338                l-order = p-x + ( l-temp-rash * l-corr-coeff * l-pay-day )  +  l-min-zap .
     5339                end.
     5340                else do:
     5341                  assign
     5342               l-order = p-x + ( l-temp-rash * l-corr-coeff  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     5343                 end.
     5344               end.
     5345      Else do :
     5346         assign l-order = p-x + ( l-Temp-rash * l-corr-coeff * l-pay-day )  - l-a   +  l-min-zap .
     5347      End.
     5348      if  l-order < 0 then l-order = 0 .
     5349    assign
     5350     v-protocol-date = today
     5351     v-protocol-time = time
     5352    .
     5353   if is-log = true then  put stream stream_order unformatted
     5354   ">> Вероятностный способ расчета заказа "  today " " string(time,"hh:mm:ss") skip
     5355      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5356      "Остаток на сегодня:" l-Ostatok-today skip
     5357      "Отриц.остатки     :" l-negative-rest skip
     5358      "дней до доставки  :" l-qnty-day      skip
     5359      "дней в продаже    :" l-pay-day       skip
     5360      "Темп продаж       :" l-Temp-rash     skip
     5361      "Корр.коеффициент  :" l-corr-coeff    skip
     5362      "Уровень пост прис :" p-serv          skip
     5363      "Среднеквадр откл  :" v-sigma         skip
     5364      "F_нормобр         :" v-norm-obr      skip
     5365      "гар.запас         :" p-x             skip
     5366      "Дней без продажи  :" l-null-day      skip
     5367      "MIN остаток       :" l-min-zap       skip
     5368      "отриц.продажа     :" l-negative-sale skip
     5369      "рассчитано заказа :" l-order         skip
     5370      "_________________ "                  skip
     5371      "min заказ         :" l-min-order     skip
     5372      "товар в пути      :" l-goods-way     skip
     5373      "срок хранения     :" l-deadline      skip
     5374      .
     5375   v-stroka-protocol = "" .
     5376   v-stroka-protocol =
     5377      "00.Метод расчета заказа:" + "Вероятностный способ расчета заказа" + chr(4) +
     5378      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5379      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5380      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5381      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5382      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5383      "05.1>>Корр.коэфф.    :" + string(l-corr-coeff   ) + chr(4) +
     5384      "06.Уровень постоянного присутствия :" + string(p-serv) + chr(4) +
     5385      "07.Среднеквадр откл  :" + string(v-sigma        ) + chr(4) +
     5386      "08.F_нормобр         :" + string(v-norm-obr     ) + chr(4) +
     5387      "09.Гарантийный запас :" + string(p-x            ) + chr(4) +
     5388      "10.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5389      "11.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5390      "12.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5391      "13.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5392      "14.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5393      "15.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5394      "16. срок хранения    :" + string(l-deadline     ) + chr(4) .
     5395      v-media-qnty = l-order .
     5396      if l-gar-zapas = true then do:
     5397          if l-Ostatok-today >  p-x then
     5398              assign
     5399              l-order = 0
     5400              l-new-zakaz = 0
     5401              .
     5402         assign v-stroka-protocol = v-stroka-protocol + "16.1>>После проверки на гарантийный запас:" + string(l-order) + chr(4)  .
     5403      end.
     5404      if l-min-ost = true then do:
     5405          if l-Ostatok-today > l-min-zap then
     5406              assign
     5407              l-order = 0
     5408              l-new-zakaz = 0
     5409              .
     5410         assign v-stroka-protocol = v-stroka-protocol + "16.2>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     5411      end.
     5412     if (l-order - l-goods-way) < 0 then
     5413        l-new-zakaz = 0 .
     5414     else
     5415        l-new-zakaz = l-order - l-goods-way .
     5416   assign v-stroka-protocol = v-stroka-protocol + "16.3>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5417   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5418       and lookup('шту':U, ub.units.type) > 0)
     5419       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5420           l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     5421           assign v-stroka-protocol = v-stroka-protocol + "16.4>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5422    end.
     5423    if  l-deadline > 0 and l-tog-deadline = true  then do:
     5424        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5425        v-stroka-protocol = v-stroka-protocol + "16.5>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5426    end .
     5427    if l-tog-min-order then do:
     5428     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5429        l-new-zakaz = 0 .
     5430        assign v-stroka-protocol = v-stroka-protocol + "16.6>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5431    end .
     5432    if l-new-zakaz = ? then l-new-zakaz = 0 .
     5433   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     5434    "__________________________________________________"     skip
     5435    .
     5436   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5437   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5438     end.
     5439    end.
     5440   end procedure.
     5441   procedure v-qnty-e :
     5442    do
     5443    on error undo, return error return-value
     5444    :
     5445     if p-mode-calc <> ""  then do:
     5446   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5447   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5448   define variable loc-unit-base    as character no-undo .
     5449   define variable l-gar-zapas      as logical no-undo .
     5450   define variable l-tog-min-order  as logical no-undo .
     5451   define variable l-min-order      as decimal no-undo .
     5452   define variable l-min-ost         as logical   no-undo .
     5453   define variable  v-sigma          as decimal no-undo .
     5454   define variable  loc-rkv as decimal no-undo .
     5455   define variable  loc-q as integer no-undo .
     5456   define variable  p-serv     as decimal   no-undo .
     5457   define variable  p-x     as decimal   no-undo .
     5458   define variable v-norm-obr as decimal   no-undo .
     5459   Assign
     5460     l-Ostatok-today =  export-ras.qnty-stk
     5461     l-negative-rest =  export-ras.negative-rest
     5462     l-qnty-day      =  l-qnty-qnty
     5463     l-pay-day       =  pay-day
     5464     l-Temp-rash     = if export-ras.temp-rash < 0  then 0 else export-ras.temp-rash
     5465     l-min-zap       =  export-ras.min-stock
     5466     l-negative-sale =  p-neg-sale
     5467     l-goods-way     =  v-gds-way-all
     5468     p-serv          =  export-ras.service-order
     5469     l-gar-zapas     =  p-t-gar
     5470     l-tog-min-order =  p-t-min-zapas
     5471     l-min-order     =  export-ras.min-order
     5472     loc-unit-base   =  export-ras.unit-base
     5473     l-min-ost       =  p-t-min-ost
     5474     l-TOG-deadline  =  p-t-deadline
     5475     l-deadline      =  export-ras.deadline
     5476     l-corr-coeff    =  v-corr-coeff
     5477     .
     5478   if l-Temp-rash = ? then l-Temp-rash = 0.
     5479    if par-ord-min-ost = yes then do:
     5480       assign l-min-zap =  l-Temp-rash * l-corr-coeff * export-ras.min-stock .
     5481    end.
     5482      loc-rkv  = 0 .
     5483      loc-q  = 0 .
     5484      for each temp-gds-qnty :
     5485          loc-rkv = loc-rkv + exp((temp-gds-qnty.rash  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5486          loc-q = loc-q  + temp-gds-qnty.qnty-day.
     5487      end.
     5488      define variable ll-i as integer no-undo .
     5489      if  all-day - loc-q > 0 then do:
     5490         do ll-i = 1 to  (all-day - loc-q) :
     5491            loc-rkv = loc-rkv + exp(( 0  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5492         end.
     5493      end.
     5494      assign v-sigma =   sqrt( loc-rkv / ( all-day  - 1)) .
     5495      if v-sigma = ? then v-sigma = 0 .
     5496      if p-serv = ? or p-serv = 0 or p-serv = 1
     5497      then p-serv = .5 .
     5498      if l-Temp-rash = ? then l-Temp-rash = 0.
     5499      run normobr in this-procedure
     5500      ( input   p-serv    ,
     5501        input   l-Temp-rash * l-corr-coeff  ,
     5502        input   v-sigma ,
     5503        output  p-x     )
     5504        .
     5505        assign v-norm-obr = p-x .
     5506     if  p-x  - l-Temp-rash * l-corr-coeff < 0
     5507         then p-x =  0 .
     5508         else p-x = (p-x  - l-Temp-rash * l-corr-coeff ) * ( l-pay-day + l-qnty-day ) .
     5509     assign L-a = l-Ostatok-today - ( l-Temp-rash * l-corr-coeff * l-qnty-day ) .
     5510     if L-a  <= 0 then do:
     5511             if l-negative-sale = true or l-negative-rest = false  then do:
     5512                 assign
     5513                l-order = p-x + ( l-temp-rash * l-corr-coeff * l-pay-day )  +  l-min-zap .
     5514                end.
     5515                else do:
     5516                  assign
     5517               l-order = p-x + ( l-temp-rash * l-corr-coeff  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     5518                 end.
     5519               end.
     5520      Else do :
     5521         assign l-order = p-x + ( l-Temp-rash * l-corr-coeff * l-pay-day )  - l-a   +  l-min-zap .
     5522      End.
     5523      if  l-order < 0 then l-order = 0 .
     5524    assign
     5525     v-protocol-date = today
     5526     v-protocol-time = time
     5527    .
     5528   if is-log = true then  put stream stream_order unformatted
     5529   ">> Вероятностный способ расчета заказа "  today " " string(time,"hh:mm:ss") skip
     5530      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5531      "Остаток на сегодня:" l-Ostatok-today skip
     5532      "Отриц.остатки     :" l-negative-rest skip
     5533      "дней до доставки  :" l-qnty-day      skip
     5534      "дней в продаже    :" l-pay-day       skip
     5535      "Темп продаж       :" l-Temp-rash     skip
     5536      "Корр.коеффициент  :" l-corr-coeff    skip
     5537      "Уровень пост прис :" p-serv          skip
     5538      "Среднеквадр откл  :" v-sigma         skip
     5539      "F_нормобр         :" v-norm-obr      skip
     5540      "гар.запас         :" p-x             skip
     5541      "Дней без продажи  :" l-null-day      skip
     5542      "MIN остаток       :" l-min-zap       skip
     5543      "отриц.продажа     :" l-negative-sale skip
     5544      "рассчитано заказа :" l-order         skip
     5545      "_________________ "                  skip
     5546      "min заказ         :" l-min-order     skip
     5547      "товар в пути      :" l-goods-way     skip
     5548      "срок хранения     :" l-deadline      skip
     5549      .
     5550   v-stroka-protocol = "" .
     5551   v-stroka-protocol =
     5552      "00.Метод расчета заказа:" + "Вероятностный способ расчета заказа" + chr(4) +
     5553      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5554      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5555      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5556      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5557      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5558      "05.1>>Корр.коэфф.    :" + string(l-corr-coeff   ) + chr(4) +
     5559      "06.Уровень постоянного присутствия :" + string(p-serv) + chr(4) +
     5560      "07.Среднеквадр откл  :" + string(v-sigma        ) + chr(4) +
     5561      "08.F_нормобр         :" + string(v-norm-obr     ) + chr(4) +
     5562      "09.Гарантийный запас :" + string(p-x            ) + chr(4) +
     5563      "10.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5564      "11.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5565      "12.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5566      "13.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5567      "14.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5568      "15.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5569      "16. срок хранения    :" + string(l-deadline     ) + chr(4) .
     5570      export-ras.order-qnty = l-order .
     5571      if l-gar-zapas = true then do:
     5572          if l-Ostatok-today >  p-x then
     5573              assign
     5574              l-order = 0
     5575              l-new-zakaz = 0
     5576              .
     5577         assign v-stroka-protocol = v-stroka-protocol + "16.1>>После проверки на гарантийный запас:" + string(l-order) + chr(4)  .
     5578      end.
     5579      if l-min-ost = true then do:
     5580          if l-Ostatok-today > l-min-zap then
     5581              assign
     5582              l-order = 0
     5583              l-new-zakaz = 0
     5584              .
     5585         assign v-stroka-protocol = v-stroka-protocol + "16.2>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     5586      end.
     5587     if (l-order - l-goods-way) < 0 then
     5588        l-new-zakaz = 0 .
     5589     else
     5590        l-new-zakaz = l-order - l-goods-way .
     5591   assign v-stroka-protocol = v-stroka-protocol + "16.3>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5592   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5593       and lookup('шту':U, ub.units.type) > 0)
     5594       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5595           l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     5596           assign v-stroka-protocol = v-stroka-protocol + "16.4>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5597    end.
     5598    if  l-deadline > 0 and l-tog-deadline = true  then do:
     5599        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5600        v-stroka-protocol = v-stroka-protocol + "16.5>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5601    end .
     5602    if l-tog-min-order then do:
     5603     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5604        l-new-zakaz = 0 .
     5605        assign v-stroka-protocol = v-stroka-protocol + "16.6>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5606    end .
     5607    if l-new-zakaz = ? then l-new-zakaz = 0 .
     5608   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     5609    "__________________________________________________"     skip
     5610    .
     5611   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5612   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5613     end.
     5614    end.
     5615   end procedure.
     5616   procedure m-qnty :
     5617    do
     5618    on error undo, return error return-value
     5619    :
     5620     if p-mode-calc = ""  then do:
     5621   define variable  vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5622   define variable l-gar-zapas      as logical no-undo .
     5623   define variable l-tog-min-order  as logical no-undo .
     5624   define variable l-min-order      as decimal no-undo .
     5625   define variable loc-unit-base  as character no-undo .
     5626   define variable v-sigma    as decimal no-undo .
     5627   define variable loc-max    as decimal no-undo .
     5628   define variable loc-max-old as decimal no-undo .
     5629   define variable loc-q      as integer no-undo .
     5630   define variable p-serv     as decimal   no-undo .
     5631   define variable p-x        as decimal   no-undo .
     5632   define variable l-min-ost         as logical   no-undo .
     5633   define output parameter par-loc-max as decimal no-undo .
     5634   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5635   Assign
     5636     l-Ostatok-today =  tmp#zakaz.qnty-stk
     5637     l-negative-rest =  tmp#zakaz.negative-rest
     5638     l-qnty-day      =  l-qnty-qnty
     5639     l-pay-day       =  pay-day
     5640     l-Temp-rash     =  if tmp#zakaz.temp-rash < 0  then 0 else tmp#zakaz.temp-rash
     5641     l-min-zap       =  tmp#zakaz.min-stock
     5642     l-negative-sale =  p-neg-sale
     5643     l-goods-way     =  v-gds-way-all
     5644     p-serv          =  tmp#zakaz.service-order
     5645     l-gar-zapas     =  p-t-gar
     5646     l-tog-min-order =  p-t-min-zapas
     5647     l-min-order     =  tmp#zakaz.min-order
     5648     loc-unit-base   =  tmp#zakaz.unit-base
     5649     l-min-ost = p-t-min-ost
     5650     l-TOG-deadline  =  p-t-deadline
     5651     l-deadline      =  tmp#zakaz.deadline
     5652     .
     5653   if l-Temp-rash = ? then l-Temp-rash = 0.
     5654      assign
     5655       loc-q  = 0
     5656       loc-max-old = 0
     5657       loc-max = 0
     5658      .
     5659     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     5660         if temp-gds-qnty.rash > loc-max   then   loc-max = temp-gds-qnty.rash  .
     5661         assign loc-max-old = temp-gds-qnty.rash  .
     5662      end.
     5663     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     5664         delete temp-gds-qnty.
     5665      end.
     5666      if loc-max < 0     then loc-max = 0 .
     5667      if loc-max-old < 0 then loc-max-old = 0 .
     5668    if par-ord-min-ost = yes then do:
     5669       assign l-min-zap =  loc-max * tmp#zakaz.min-stock .
     5670    end.
     5671     par-loc-max = loc-max .
     5672     L-a = l-Ostatok-today - ( loc-max  * l-qnty-day ) .
     5673     if L-a  <= 0 then do:
     5674             if l-negative-sale = true or l-negative-rest = false   then do:
     5675                 assign
     5676                     l-order = ( loc-max  * l-pay-day )  +  l-min-zap .
     5677                end.
     5678                else do:
     5679                  assign
     5680                     l-order =  ( loc-max  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     5681                 end.
     5682               end.
     5683      Else do :
     5684           assign l-order = ( loc-max  * l-pay-day )  - l-a   +  l-min-zap .
     5685      End.
     5686      if  l-order < 0 then l-order = 0 .
     5687    assign
     5688     v-protocol-date = today
     5689     v-protocol-time = time
     5690    .
     5691    if is-log = true then  put stream stream_order unformatted
     5692   ">> Расчет заказа по максимальной продаже "  today " " string(time,"hh:mm:ss") skip
     5693      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5694      "Остаток на сегодня:" l-Ostatok-today skip
     5695      "Отриц.остатки     :" l-negative-rest skip
     5696      "отриц.продажа     :" l-negative-sale skip
     5697      "дней до доставки  :" l-qnty-day      skip
     5698      "дней в продаже    :" l-pay-day       skip
     5699      "MAX продажа       :" loc-max         skip
     5700      "MIN остаток       :" l-min-zap       skip
     5701      "рассчитано заказа :" l-order         skip
     5702      "_________________ "                  skip
     5703      "min заказ         :" l-min-order     skip
     5704      "товар в пути      :" l-goods-way     skip
     5705      "срок хранения     :" l-deadline skip
     5706      .
     5707   v-stroka-protocol = "" .
     5708   v-stroka-protocol =
     5709      "00.Метод расчета заказа:" + "Расчет до максимальной продажи" + chr(4) +
     5710      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5711      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5712      "03.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5713      "04.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5714      "05.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5715      "06.MAX продажа       :" + string(loc-max        ) + chr(4) +
     5716      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5717      "08.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5718      "09.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5719      "10.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5720      "11.срок хранения     :" + string(l-deadline     ) + chr(4) .
     5721   v-media-qnty = l-order .
     5722     if l-min-ost = true then do:
     5723        if l-Ostatok-today > l-min-zap then
     5724          assign
     5725           l-order = 0
     5726           l-new-zakaz = 0
     5727           .
     5728        assign v-stroka-protocol = v-stroka-protocol + "12.1>>После проверки на MIN остаток:" + string(l-order) + chr(4).
     5729     end.
     5730     if (l-order - l-goods-way) < 0 then
     5731        l-new-zakaz = 0 .
     5732     else
     5733        l-new-zakaz = l-order - l-goods-way .
     5734     assign v-stroka-protocol = v-stroka-protocol + "12.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5735   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5736     and lookup('шту':U, ub.units.type) > 0)
     5737     and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5738         l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     5739         v-stroka-protocol = v-stroka-protocol + "12.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5740     end.
     5741    if  l-deadline > 0 and l-tog-deadline = true  then do:
     5742        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5743        assign v-stroka-protocol = v-stroka-protocol + "12.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5744    end .
     5745    if l-tog-min-order then do:
     5746       if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5747           l-new-zakaz = 0 .
     5748       assign v-stroka-protocol = v-stroka-protocol + "12.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5749    end .
     5750   if l-new-zakaz = ? then l-new-zakaz = 0 .
     5751   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     5752    "__________________________________________________"     skip
     5753    .
     5754   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5755   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5756     end.
     5757    end.
     5758   end procedure.
     5759   procedure m-qnty-e :
     5760    do
     5761    on error undo, return error return-value
     5762    :
     5763    if p-mode-calc <> ""  then do:
     5764   define variable  vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5765   define variable l-gar-zapas      as logical no-undo .
     5766   define variable l-tog-min-order  as logical no-undo .
     5767   define variable l-min-order      as decimal no-undo .
     5768   define variable loc-unit-base  as character no-undo .
     5769   define variable v-sigma    as decimal no-undo .
     5770   define variable loc-max    as decimal no-undo .
     5771   define variable loc-max-old as decimal no-undo .
     5772   define variable loc-q      as integer no-undo .
     5773   define variable p-serv     as decimal   no-undo .
     5774   define variable p-x        as decimal   no-undo .
     5775   define variable l-min-ost         as logical   no-undo .
     5776   define output parameter par-loc-max as decimal no-undo .
     5777   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5778   Assign
     5779     l-Ostatok-today =  export-ras.qnty-stk
     5780     l-negative-rest =  export-ras.negative-rest
     5781     l-qnty-day      =  l-qnty-qnty
     5782     l-pay-day       =  pay-day
     5783     l-Temp-rash     =  if export-ras.temp-rash < 0  then 0 else export-ras.temp-rash
     5784     l-min-zap       =  export-ras.min-stock
     5785     l-negative-sale =  p-neg-sale
     5786     l-goods-way     =  v-gds-way-all
     5787     p-serv          =  export-ras.service-order
     5788     l-gar-zapas     =  p-t-gar
     5789     l-tog-min-order =  p-t-min-zapas
     5790     l-min-order     =  export-ras.min-order
     5791     loc-unit-base   =  export-ras.unit-base
     5792     l-min-ost = p-t-min-ost
     5793     l-TOG-deadline  =  p-t-deadline
     5794     l-deadline      =  export-ras.deadline
     5795     .
     5796   if l-Temp-rash = ? then l-Temp-rash = 0.
     5797      assign
     5798       loc-q  = 0
     5799       loc-max-old = 0
     5800       loc-max = 0
     5801      .
     5802     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     5803         if temp-gds-qnty.rash > loc-max   then   loc-max = temp-gds-qnty.rash  .
     5804         assign loc-max-old = temp-gds-qnty.rash  .
     5805      end.
     5806     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     5807         delete temp-gds-qnty.
     5808      end.
     5809      if loc-max < 0     then loc-max = 0 .
     5810      if loc-max-old < 0 then loc-max-old = 0 .
     5811    if par-ord-min-ost = yes then do:
     5812       assign l-min-zap =  loc-max * export-ras.min-stock .
     5813    end.
     5814     par-loc-max = loc-max .
     5815     L-a = l-Ostatok-today - ( loc-max  * l-qnty-day ) .
     5816     if L-a  <= 0 then do:
     5817             if l-negative-sale = true or l-negative-rest = false   then do:
     5818                 assign
     5819                     l-order = ( loc-max  * l-pay-day )  +  l-min-zap .
     5820                end.
     5821                else do:
     5822                  assign
     5823                     l-order =  ( loc-max  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     5824                 end.
     5825               end.
     5826      Else do :
     5827           assign l-order = ( loc-max  * l-pay-day )  - l-a   +  l-min-zap .
     5828      End.
     5829      if  l-order < 0 then l-order = 0 .
     5830    assign
     5831     v-protocol-date = today
     5832     v-protocol-time = time
     5833    .
     5834    if is-log = true then  put stream stream_order unformatted
     5835   ">> Расчет заказа по максимальной продаже "  today " " string(time,"hh:mm:ss") skip
     5836      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5837      "Остаток на сегодня:" l-Ostatok-today skip
     5838      "Отриц.остатки     :" l-negative-rest skip
     5839      "отриц.продажа     :" l-negative-sale skip
     5840      "дней до доставки  :" l-qnty-day      skip
     5841      "дней в продаже    :" l-pay-day       skip
     5842      "MAX продажа       :" loc-max         skip
     5843      "MIN остаток       :" l-min-zap       skip
     5844      "рассчитано заказа :" l-order         skip
     5845      "_________________ "                  skip
     5846      "min заказ         :" l-min-order     skip
     5847      "товар в пути      :" l-goods-way     skip
     5848      "срок хранения     :" l-deadline skip
     5849      .
     5850   v-stroka-protocol = "" .
     5851   v-stroka-protocol =
     5852      "00.Метод расчета заказа:" + "Расчет до максимальной продажи" + chr(4) +
     5853      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5854      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5855      "03.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5856      "04.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5857      "05.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5858      "06.MAX продажа       :" + string(loc-max        ) + chr(4) +
     5859      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5860      "08.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5861      "09.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5862      "10.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5863      "11.срок хранения     :" + string(l-deadline     ) + chr(4) .
     5864   export-ras.order-qnty = l-order .
     5865     if l-min-ost = true then do:
     5866        if l-Ostatok-today > l-min-zap then
     5867          assign
     5868           l-order = 0
     5869           l-new-zakaz = 0
     5870           .
     5871        assign v-stroka-protocol = v-stroka-protocol + "12.1>>После проверки на MIN остаток:" + string(l-order) + chr(4).
     5872     end.
     5873     if (l-order - l-goods-way) < 0 then
     5874        l-new-zakaz = 0 .
     5875     else
     5876        l-new-zakaz = l-order - l-goods-way .
     5877     assign v-stroka-protocol = v-stroka-protocol + "12.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5878   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5879     and lookup('шту':U, ub.units.type) > 0)
     5880     and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5881         l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     5882         v-stroka-protocol = v-stroka-protocol + "12.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5883     end.
     5884    if  l-deadline > 0 and l-tog-deadline = true  then do:
     5885        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5886        assign v-stroka-protocol = v-stroka-protocol + "12.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5887    end .
     5888    if l-tog-min-order then do:
     5889       if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5890           l-new-zakaz = 0 .
     5891       assign v-stroka-protocol = v-stroka-protocol + "12.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5892    end .
     5893   if l-new-zakaz = ? then l-new-zakaz = 0 .
     5894   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     5895    "__________________________________________________"     skip
     5896    .
     5897   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5898   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5899     end.
     5900    end.
     5901   end procedure.
     5902   procedure calc-null-day :
     5903    do
     5904    on error undo, return error return-value
     5905    :
     5906    l-null-day = 0 .
     5907    IF p-type-qnty-day = 2   then do :
     5908       for each temp-gds-qnty  :
     5909          if  temp-gds-qnty.rash = 0  and  temp-gds-qnty.ost = 0 then
     5910             l-null-day = l-null-day + temp-gds-qnty.qnty-day  .
     5911        end.
     5912     end.
     5913     end.
     5914   end procedure.
     5915   procedure calc-sale :
     5916    do
     5917    on error undo, return error return-value
     5918    :
     5919         for each obj-list no-lock :
     5920           run ob-line in this-procedure  (
     5921               input   obj-list.obj-code   ,
     5922               input   obj-list.obj-type   ,
     5923               input   tmp#zakaz.artic       ,
     5924               input   tmp#zakaz.prod-code   ,
     5925               input   tmp#zakaz.prod-type   ,
     5926               input    fact-order-1,
     5927               input    fact-order-2,
     5928               input   'cost':U    ,
     5929               input   '##,##':U ,
     5930               input   ""    ,
     5931               input   false ,
     5932               input   false ,
     5933               output v-prih ,
     5934               output v-rash ,
     5935               output v-kassa
     5936               )  no-error .
     5937             assign
     5938               d-rash  = d-rash  + v-rash
     5939               d-kassa = d-kassa + v-kassa
     5940               prih  = prih +  v-prih
     5941               rash  = rash  + v-rash
     5942               kassa = kassa + v-kassa
     5943             .
     5944             end.
     5945    end.
     5946   end procedure.
     5947   procedure u-qnty :
     5948    do
     5949    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5950    :
     5951     if p-mode-calc = ""  then do:
     5952   def var vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5953   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5954   define var l-max-zap        as decimal no-undo .
     5955   define variable l-min-ost         as logical   no-undo .
     5956   Assign
     5957     l-max-zap       =  tmp#zakaz.max-stock
     5958     l-Ostatok-today =  tmp#zakaz.qnty-stk
     5959     l-negative-rest =  tmp#zakaz.negative-rest
     5960     l-min-zap       =  tmp#zakaz.min-stock
     5961     l-negative-sale =  p-neg-sale
     5962     l-goods-way     =  v-gds-way
     5963     l-tog-min-order =  p-t-min-zapas
     5964     l-min-order     =  tmp#zakaz.min-order
     5965     loc-unit-base   =  tmp#zakaz.unit-base
     5966     l-min-ost       =  p-t-min-ost
     5967     l-TOG-deadline  =  p-t-deadline
     5968     l-deadline      =  tmp#zakaz.deadline
     5969     l-Temp-rash     =  tmp#zakaz.temp-rash
     5970     l-corr-coeff    =  v-corr-coeff
     5971     .
     5972   if l-Temp-rash = ? then l-Temp-rash = 0.
     5973    if par-ord-min-ost = yes then do:
     5974       assign l-min-zap =  l-Temp-rash * l-corr-coeff * tmp#zakaz.min-stock .
     5975    end.
     5976     L-a = l-Ostatok-today  .
     5977     if L-a  <= 0 then do:
     5978         if l-negative-rest = true then do:
     5979             if l-negative-sale then do:
     5980               assign
     5981               l-order =  l-max-zap
     5982               .
     5983             end.
     5984             else do:
     5985               assign
     5986                 l-order = absolute(l-a) + l-max-zap
     5987               .
     5988             end.
     5989         end.
     5990         else do:
     5991             assign
     5992               l-order = l-max-zap
     5993               .
     5994         end.
     5995      End.
     5996      Else do :
     5997         if ( l-max-zap - l-Ostatok-today ) >= 0 then  l-order = l-max-zap - l-Ostatok-today .
     5998                                                 else  l-order = 0 .
     5999      End.
     6000    assign
     6001     v-protocol-date = today
     6002     v-protocol-time = time
     6003    .
     6004    if is-log = true then  put stream stream_order unformatted
     6005   ">> Довести заказ до максимального остатка "  today " " string(time,"hh:mm:ss") skip
     6006      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     6007      "Остаток на сегодня:" l-Ostatok-today skip
     6008      "Отриц.остатки     :" l-negative-rest skip
     6009      "MIN остаток       :" l-min-zap       skip
     6010      "MAX остаток       :" l-max-zap       skip
     6011      "отриц.продажа     :" l-negative-sale skip
     6012      "рассчитано заказа :" l-order         skip
     6013      "_________________ "                  skip
     6014      "min заказ         :" l-min-order     skip
     6015      "товар в пути      :" l-goods-way     skip
     6016      "срок хранения     :" l-deadline      skip
     6017      .
     6018   v-stroka-protocol = "" .
     6019   v-stroka-protocol =
     6020      "00.Метод расчета заказа:" + "Довести заказ до максимального остатка" + chr(4) +
     6021      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     6022      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     6023      "03.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     6024      "04.MAX остаток       :" + string(l-max-zap      ) + chr(4) +
     6025      "05.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     6026      "06.рассчитано заказа :" + string(l-order        ) + chr(4) +
     6027      "07.min заказ         :" + string(l-min-order    ) + chr(4) +
     6028      "08.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     6029      "09.срок хранения     :" + string(l-deadline     ) + chr(4) .
     6030   v-media-qnty = l-order .
     6031      if l-min-ost = true then do:
     6032          if l-Ostatok-today > l-min-zap then
     6033              assign
     6034               l-order = 0
     6035               l-new-zakaz = 0
     6036              .
     6037         assign v-stroka-protocol = v-stroka-protocol + "10.1>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     6038      end.
     6039     if (l-order - l-goods-way) < 0 then
     6040        l-new-zakaz = 0 .
     6041     else
     6042        l-new-zakaz = l-order - l-goods-way .
     6043     assign v-stroka-protocol = v-stroka-protocol + "10.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6044   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6045       and lookup('шту':U, ub.units.type) > 0)
     6046       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6047           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     6048           assign v-stroka-protocol = v-stroka-protocol + "10.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6049       end.
     6050     if  l-deadline > 0 and l-tog-deadline = true  then do:
     6051        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6052        v-stroka-protocol = v-stroka-protocol + "10.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6053    end .
     6054    if l-tog-min-order then do:
     6055     if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6056        l-new-zakaz = 0 .
     6057        assign v-stroka-protocol = v-stroka-protocol + "10.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6058    end .
     6059   if l-new-zakaz = ? then l-new-zakaz = 0 .
     6060   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6061    "__________________________________________________"     skip
     6062    .
     6063   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6064   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6065     end.
     6066    end.
     6067   end procedure.
     6068   procedure u-qnty-e :
     6069    do
     6070    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6071    :
     6072     if p-mode-calc <> ""  then do:
     6073   def var vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6074   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     6075   define var l-max-zap        as decimal no-undo .
     6076   define variable l-min-ost         as logical   no-undo .
     6077   Assign
     6078     l-max-zap       =  export-ras.max-stock
     6079     l-Ostatok-today =  export-ras.qnty-stk
     6080     l-negative-rest =  export-ras.negative-rest
     6081     l-min-zap       =  export-ras.min-stock
     6082     l-negative-sale =  p-neg-sale
     6083     l-goods-way     =  v-gds-way
     6084     l-tog-min-order =  p-t-min-zapas
     6085     l-min-order     =  export-ras.min-order
     6086     loc-unit-base   =  export-ras.unit-base
     6087     l-min-ost       =  p-t-min-ost
     6088     l-TOG-deadline  =  p-t-deadline
     6089     l-deadline      =  export-ras.deadline
     6090     l-Temp-rash     =  export-ras.temp-rash
     6091     l-corr-coeff    =  v-corr-coeff
     6092     .
     6093   if l-Temp-rash = ? then l-Temp-rash = 0.
     6094    if par-ord-min-ost = yes then do:
     6095       assign l-min-zap =  l-Temp-rash * l-corr-coeff * export-ras.min-stock .
     6096    end.
     6097     L-a = l-Ostatok-today  .
     6098     if L-a  <= 0 then do:
     6099         if l-negative-rest = true then do:
     6100             if l-negative-sale then do:
     6101               assign
     6102               l-order =  l-max-zap
     6103               .
     6104             end.
     6105             else do:
     6106               assign
     6107                 l-order = absolute(l-a) + l-max-zap
     6108               .
     6109             end.
     6110         end.
     6111         else do:
     6112             assign
     6113               l-order = l-max-zap
     6114               .
     6115         end.
     6116      End.
     6117      Else do :
     6118         if ( l-max-zap - l-Ostatok-today ) >= 0 then  l-order = l-max-zap - l-Ostatok-today .
     6119                                                 else  l-order = 0 .
     6120      End.
     6121    assign
     6122     v-protocol-date = today
     6123     v-protocol-time = time
     6124    .
     6125    if is-log = true then  put stream stream_order unformatted
     6126   ">> Довести заказ до максимального остатка "  today " " string(time,"hh:mm:ss") skip
     6127      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     6128      "Остаток на сегодня:" l-Ostatok-today skip
     6129      "Отриц.остатки     :" l-negative-rest skip
     6130      "MIN остаток       :" l-min-zap       skip
     6131      "MAX остаток       :" l-max-zap       skip
     6132      "отриц.продажа     :" l-negative-sale skip
     6133      "рассчитано заказа :" l-order         skip
     6134      "_________________ "                  skip
     6135      "min заказ         :" l-min-order     skip
     6136      "товар в пути      :" l-goods-way     skip
     6137      "срок хранения     :" l-deadline      skip
     6138      .
     6139   v-stroka-protocol = "" .
     6140   v-stroka-protocol =
     6141      "00.Метод расчета заказа:" + "Довести заказ до максимального остатка" + chr(4) +
     6142      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     6143      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     6144      "03.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     6145      "04.MAX остаток       :" + string(l-max-zap      ) + chr(4) +
     6146      "05.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     6147      "06.рассчитано заказа :" + string(l-order        ) + chr(4) +
     6148      "07.min заказ         :" + string(l-min-order    ) + chr(4) +
     6149      "08.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     6150      "09.срок хранения     :" + string(l-deadline     ) + chr(4) .
     6151   export-ras.order-qnty = l-order .
     6152      if l-min-ost = true then do:
     6153          if l-Ostatok-today > l-min-zap then
     6154              assign
     6155               l-order = 0
     6156               l-new-zakaz = 0
     6157              .
     6158         assign v-stroka-protocol = v-stroka-protocol + "10.1>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     6159      end.
     6160     if (l-order - l-goods-way) < 0 then
     6161        l-new-zakaz = 0 .
     6162     else
     6163        l-new-zakaz = l-order - l-goods-way .
     6164     assign v-stroka-protocol = v-stroka-protocol + "10.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6165   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6166       and lookup('шту':U, ub.units.type) > 0)
     6167       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6168           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     6169           assign v-stroka-protocol = v-stroka-protocol + "10.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6170       end.
     6171     if  l-deadline > 0 and l-tog-deadline = true  then do:
     6172        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6173        v-stroka-protocol = v-stroka-protocol + "10.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6174    end .
     6175    if l-tog-min-order then do:
     6176     if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6177        l-new-zakaz = 0 .
     6178        assign v-stroka-protocol = v-stroka-protocol + "10.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6179    end .
     6180   if l-new-zakaz = ? then l-new-zakaz = 0 .
     6181   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6182    "__________________________________________________"     skip
     6183    .
     6184   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6185   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6186      end.
     6187    end.
     6188   end procedure.
