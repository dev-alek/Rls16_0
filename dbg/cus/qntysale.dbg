      197   procedure create_obj-list :
      198      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      199      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      200      do
      201      on error undo, return error return-value
      202      :
      203         define buffer cli-obj for ub.clients .
      204         define variable p-var as integer no-undo .
      205         define buffer buf_obj-list for obj-list .
      206         find last buf_obj-list  use-index pi no-error .
      207         if available buf_obj-list
      208         then
      209            p-var = buf_obj-list.obj-id + 1.
      210         else
      211            p-var = 1.
      212         find first cli-obj where
      213                   cli-obj.obj-type = p-obj-type
      214               and cli-obj.obj-code = p-obj-code
      215         no-lock no-error.
      216         if available cli-obj
      217         then do:
      218            create buf_obj-list.
      219            assign
      220               buf_obj-list.obj-id   = p-var
      221               buf_obj-list.obj-code = cli-obj.obj-code
      222               buf_obj-list.obj-type = cli-obj.obj-type
      223               buf_obj-list.obj-name = cli-obj.obj-name
      224               buf_obj-list.db-num   = cli-obj.db-num
      225            .
      226         end.
      227      end.
      228   end.
