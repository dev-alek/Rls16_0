     1467   procedure normobr_invers-erf :
     1468     define input  parameter p-x     as decimal   no-undo .
     1469     define output parameter p-value as decimal   no-undo .
     1470     define variable vss-description as character no-undo init "normobr_invers-erf-01: Обратная функция Erf".
     1471     do
     1472     on error undo, return error return-value
     1473     :
     1474       if p-x = ?
     1475       or p-x > 1
     1476       or p-x < -1
     1477       then do:
     1478         message
     1479           vss-workfile vss-revision vss-description skip
     1480           vss-include-info11 skip
     1481           "Ошибка задания входных параметров" skip
     1482           "p-x" p-x skip
     1483           view-as alert-box error .
     1484         undo, return error .
     1485       end.
     1486       define variable p-x-power2  as decimal   no-undo .
     1487       define variable p-x-power4  as decimal   no-undo .
     1488       define variable p-x-power8  as decimal   no-undo .
     1489       define variable p-x-power16 as decimal   no-undo .
     1490       assign
     1491         p-x-power2  = p-x * p-x
     1492         p-x-power4  = p-x-power2 * p-x-power2
     1493         p-x-power8  = p-x-power4 * p-x-power4
     1494         p-x-power16 = p-x-power8 * p-x-power8
     1495       .
     1496       assign
     1497         p-value = 08862269254.5275790 * p-x
     1498                 + 02320136665.3465444 * p-x * p-x-power2
     1499                 + 01275561753.0559793 * p-x * p-x-power4
     1500                 + 00865521292.4154752 * p-x * p-x-power2 * p-x-power4
     1501                 + 00649596177.4538540 * p-x * p-x-power8
     1502                 + 00517312819.8461636 * p-x * p-x-power2 * p-x-power8
     1503                 + 00428367206.5179733 * p-x * p-x-power4 * p-x-power8
     1504                 + 00364659293.0853162 * p-x * p-x-power2 * p-x-power4 * p-x-power8
     1505                 + 00316890050.2160544 * p-x * p-x-power16
     1506                 + 00279806329.6499521 * p-x * p-x-power2 * p-x-power16
     1507                 + 00250222758.4119834 * p-x * p-x-power4 * p-x-power16
     1508                 + 00226098633.1889757 * p-x * p-x-power2 * p-x-power4 * p-x-power16
     1509                 + 00206067803.7905899 * p-x * p-x-power8 * p-x-power16
     1510       .
     1511       assign
     1512         p-value = p-value / 10000000000
     1513       .
     1514     end.
     1515   end procedure.
     1516   procedure normobr :
     1517     define input  parameter p-p     as decimal   no-undo .
     1518     define input  parameter p-m     as decimal   no-undo .
     1519     define input  parameter p-sigma as decimal   no-undo .
     1520     define output parameter p-x     as decimal   no-undo .
     1521     define variable vss-description as character no-undo init "normobr-01: Обратная функция нормального распределения".
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       if p-p > 1
     1526       or p-p < 0
     1527       or p-p = ?
     1528       then do:
     1529         message
     1530           vss-workfile vss-revision vss-description skip
     1531           vss-include-info11 skip
     1532           "Ошибка задания входных параметров" skip
     1533           "Неверные значения парметра p-p  " skip
     1534           "Он не может быть больше нуля и меньше единицы" skip
     1535           "p-p (- уровень постоянного присутствия)              " p-p skip
     1536           "p-m (Темп продаж )                                   " p-m skip
     1537           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1538           view-as alert-box error .
     1539         undo, return error .
     1540       end.
     1541       if p-m = ?
     1542       then do:
     1543         message
     1544           vss-workfile vss-revision vss-description skip
     1545           vss-include-info11 skip
     1546           "Ошибка задания входных параметров" skip
     1547           "Не задано значение парметра p-m" skip
     1548           "p-p (- уровень постоянного присутствия)              " p-p skip
     1549           "p-m (Темп продаж )                                   " p-m skip
     1550           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1551           view-as alert-box error .
     1552         undo, return error .
     1553       end.
     1554       if p-sigma = ?
     1555       then do:
     1556         message
     1557           vss-workfile vss-revision vss-description skip
     1558           vss-include-info11 skip
     1559           "Ошибка задания входных параметров" skip
     1560           "Не задано значение парметра p-sigma" skip
     1561           "p-p (- уровень постоянного присутствия)              " p-p skip
     1562           "p-m (Темп продаж )                                   " p-m skip
     1563           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1564           view-as alert-box error .
     1565         undo, return error .
     1566       end.
     1567       define variable v-inverse-erf as decimal   no-undo .
     1568       run normobr_invers-erf in this-procedure
     1569         (input  1 - 2 * p-p
     1570         ,output v-inverse-erf
     1571         ) no-error .
     1572       if error-status :error then do:
     1573         message
     1574           vss-workfile vss-revision vss-description skip
     1575           "Ошибка при вызове функции normobr_invers-erf" skip
     1576           "p-p (- уровень постоянного присутствия)              " p-p skip
     1577           "p-m (Темп продаж )                                   " p-m skip
     1578           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1579           error-status :get-message(1) skip
     1580           return-value skip
     1581           view-as alert-box error .
     1582         undo, return error .
     1583       end.
     1584       assign
     1585         p-x = p-m - 1.4142135623730950488 * p-Sigma * v-inverse-erf
     1586       .
     1587     end.
     1588   end procedure.
     1589   procedure normobr_test :
