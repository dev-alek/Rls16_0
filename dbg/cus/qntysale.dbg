     1198     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1199     ) no-error .
     1200     if error-status :error then is-log = false .
     1201   run adm/shattri.p (
     1202     input "get":U
     1203     ,input ""
     1204     ,input 0
     1205     ,input 'ord-global':U
     1206     ,input 'ord-min-ost-day':U
     1207     ,output v-value-character
     1208     ,output v-value-date
     1209     ,output v-value-decimal
     1210     ,output v-value-integer
     1211     ,output par-ord-min-ost
     1212     ,output p-type
     1213     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1214     ) no-error .
     1215     if error-status :error then par-ord-min-ost = false .
     1216   procedure recalc-cli-qnty :
     1217     do
     1218     on error undo, return error return-value
     1219     :
     1220   define input  parameter p-gds-code      as integer   no-undo .
     1221   define input  parameter p-round-m       as character no-undo .
     1222   define input  parameter p-round-base    as decimal   no-undo .
     1223   define input  parameter p-unit-cli      as character no-undo .
     1224   define input  parameter p-cli-base-rate as decimal   no-undo .
     1225   define input  parameter p-price-cli     as decimal   no-undo .
     1226   define input  parameter p-price-rubl    as decimal   no-undo .
     1227   define input  parameter p-price-base    as decimal   no-undo .
     1228   define input-output parameter p-cli-qnty as decimal   no-undo .
     1229   define input-output parameter p-qnty     as decimal   no-undo .
     1230   define input-output parameter p-sum-cli  as decimal   no-undo .
     1231   define input-output parameter p-sum-rubl as decimal   no-undo .
     1232   define input-output parameter p-sum-base as decimal   no-undo .
     1233   define buffer buf_goods for ub.goods  .
     1234   define buffer buf_units for ub.units  .
     1235   define variable v-cli-qnty as decimal   no-undo .
     1236   find first buf_goods no-lock where
     1237              buf_goods.gds-code = p-gds-code no-error .
     1238   v-cli-qnty = p-cli-qnty .
     1239   if can-find (
     1240   first buf_units where
     1241         buf_units.unit-name = p-unit-cli and
     1242         lookup ('шту':U, buf_units.type) > 0 ) and
     1243     truncate ( p-cli-qnty, 0 ) <> p-cli-qnty then do:
     1244     assign
     1245       v-cli-qnty = trunc( p-cli-qnty, 0 ) .
     1246   end.
     1247      case p-round-m :
     1248             when 'Кол-во_в_коробке':U then do:
     1249              if buf_goods.qnty-cart  <> 0 then do:
     1250                   if ( p-qnty  > 0 and p-qnty <  buf_goods.qnty-cart ) then p-qnty = buf_goods.qnty-cart .
     1251                   assign
     1252                     p-qnty     = round ( p-qnty / buf_goods.qnty-cart, 0 ) *  buf_goods.qnty-cart
     1253                     .
     1254                     if ( p-qnty > 0 and p-qnty <  buf_goods.qnty-cart ) then p-qnty = buf_goods.qnty-cart .
     1255                   assign
     1256                     p-cli-qnty = p-qnty / p-cli-base-rate
     1257                     p-sum-cli  = p-price-cli  * p-cli-qnty
     1258                     p-sum-rubl = p-price-rubl * p-qnty
     1259                     p-sum-base = p-price-base * p-qnty
     1260                   .
     1261                end.
     1262                else do:
     1263                   assign
     1264                     p-qnty     = v-cli-qnty   * p-cli-base-rate
     1265                     p-sum-cli  = p-price-cli  * v-cli-qnty
     1266                     p-sum-rubl = p-price-rubl * p-qnty
     1267                     p-sum-base = p-price-base * p-qnty
     1268                   .
     1269                end.
     1270             end.
     1271             when 'Без-дробных':U then do:
     1272                 if can-find(first buf_units where
     1273                         buf_units.unit-name = p-unit-cli and
     1274                         lookup ('шту':U, buf_units.type) > 0 ) and
     1275                         trunc ( p-cli-qnty, 0 ) <> p-cli-qnty then do:
     1276                         assign
     1277                           p-cli-qnty = trunc( p-cli-qnty, 0 ) + 1
     1278                           p-qnty     = p-cli-qnty   * p-cli-base-rate
     1279                           p-sum-cli  = p-price-cli  * p-cli-qnty
     1280                           p-sum-rubl = p-price-rubl * p-qnty
     1281                           p-sum-base = p-price-base * p-qnty
     1282                         .
     1283                 end.
     1284                 else do:
     1285                         assign
     1286                           p-cli-qnty = round( p-cli-qnty, 0 )
     1287                           p-qnty     = p-cli-qnty   * p-cli-base-rate
     1288                           p-sum-cli  = p-price-cli  * p-cli-qnty
     1289                           p-sum-rubl = p-price-rubl * p-qnty
     1290                           p-sum-base = p-price-base * p-qnty
     1291                         .
     1292                 end.
     1293             end.
     1294             when 'Произвольно':U then do:
     1295               if p-round-base <> 0 then do:
     1296                 assign
     1297                   p-cli-qnty = round ( p-cli-qnty / p-round-base , 0 ) * p-round-base
     1298                 .
     1299               end.
     1300               assign
     1301                   p-qnty     = p-cli-qnty   * p-cli-base-rate
     1302                   p-sum-cli  = p-price-cli  * p-cli-qnty
     1303                   p-sum-rubl = p-price-rubl * p-qnty
     1304                   p-sum-base = p-price-base * p-qnty
     1305                 .
     1306             end.
     1307             when 'Отключено':U or when ""  then do:
     1308               assign
     1309                   p-cli-qnty = v-cli-qnty
     1310                   p-qnty     = p-cli-qnty   * p-cli-base-rate
     1311                   p-sum-cli  = p-price-cli  * p-cli-qnty
     1312                   p-sum-rubl = p-price-rubl * p-qnty
     1313                   p-sum-base = p-price-base * p-qnty
     1314                 .
     1315             end.
     1316      end case.
     1317   if is-log = true then  Output stream stream_order to value ("order_raschet.txt") APPEND .
     1318   if is-log = true then  put stream stream_order unformatted
     1319           " После округления кол-во в баз.ед. изм. : " p-qnty  skip
     1320           " Метод округления :  " p-round-m
     1321             ( if p-round-m = 'Произвольно':U
     1322                 then  string(p-round-base)
     1323                 else  "" )
     1324             ( if p-round-m = 'Кол-во_в_коробке':U
     1325                 then  string(buf_goods.qnty-cart)
     1326                 else  "" ) skip
     1327           "__________________________________________________"     skip  .
     1328   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     1329   v-stroka-protocol = v-stroka-protocol + chr(4) +
     1330                     "18.Метод округления : " +  p-round-m +
     1331                       ( if p-round-m = 'Произвольно':U
     1332                           then  string(p-round-base)
     1333                           else  " " )  +
     1334                       ( if p-round-m = 'Кол-во_в_коробке':U
     1335                           then  string(buf_goods.qnty-cart)
     1336                           else  "" ) + chr(4) +
     1337                     "19.После округления кол-во в баз.ед. изм. : " + string( p-qnty)
     1338                       .
     1339     end.
     1340   end procedure.
     1341   procedure create-protocol :
     1342   define input  parameter p-ord-doc  as character no-undo .
     1343   define input  parameter p-gds-code as integer   no-undo .
     1344   define input  parameter p-date     as date     no-undo .
     1345   define input  parameter p-time     as integer   no-undo .
     1346   define input  parameter p-obj-type as character no-undo .
