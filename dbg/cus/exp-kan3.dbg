     1323   ON CHOOSE OF B-file IN FRAME Dialog-Frame
     1324   DO:
     1325       DEF VAR ll_commit1 AS LOG    NO-UNDO INIT NO.
     1326       define variable v_os-file1 as char no-undo.
     1327       SYSTEM-DIALOG GET-FILE v_os-file1
     1328           TITLE "Выберите файл для экспорта"
     1329           FILTERS
     1330             " Текстовые файлы (*.txt) " "*.txt",
     1331             " Все файлы (*.*) "                      "*.*"
     1332           save-as
     1333           use-filename
     1334           update ll_commit1
     1335           default-extension "txt"
     1336           .
     1337       IF ll_commit1 <> YES THEN do:
     1338          RETURN NO-APPLY.
     1339       end.
     1340       IF v_os-file1 = PROGRAM-NAME( 1 ) THEN DO:
     1341           BELL.
     1342           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1343           RETURN NO-APPLY.
     1344       END.
     1345       ASSIGN fnrasvn = ( IF SEARCH( v_os-file1 ) = ? THEN   v_os-file1  ELSE SEARCH( v_os-file1 ) ).
     1346       DISP fnrasvn WITH FRAME Dialog-Frame.
     1347   END.
