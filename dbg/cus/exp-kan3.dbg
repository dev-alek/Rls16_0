      408   procedure schedule-attr-name :
      409   do
      410     on error undo, return error
      411     :
      412     define input  parameter p-code           as character no-undo .
      413     define output parameter p-type           as character no-undo .
      414     define output parameter p-format         as character no-undo .
      415     define output parameter p-label          as character no-undo .
      416     define output parameter p-user-can-edit  as logical   no-undo .
      417     define output parameter p-output-display as logical   no-undo .
      418     define output parameter p-other          as character no-undo .
      419       if index(p-code, chr(4)) > 0 then do:
      420         p-code = entry(1, p-code, chr(4)).
      421       end.
      422       case p-code :
      423               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      424               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      425               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      426               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      427               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      428               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      429               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      430               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      431               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      432         otherwise do:
      433           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      434         end.
      435       end.
      436     end.
      437   end procedure.
      438   procedure schedule-attr-tooltip :
      439   do
      440     on error undo, return error
      441     :
      442       define input  parameter p-code    as character no-undo .
      443       define output parameter p-tooltip as character no-undo .
      444       define output parameter p-label   as character no-undo .
      445       if index(p-code, chr(4)) > 0 then do:
      446         p-code = entry(1, p-code, chr(4)).
      447       end.
      448       case p-code :
      449               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      450               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      451               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      452               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      453               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      454               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      455               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      456               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      457               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      458         otherwise do:
      459               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      460         end.
      461       end.
      462     end.
      463   end procedure.
      464   procedure schedule-attr-value :
      465   do
      466   on error undo, return error return-value
      467   :
      468   define input parameter  p-cre-db-num as integer    no-undo.
      469   define input parameter  p-task-type  as character  no-undo.
      470   define input parameter  p-task-num   as integer    no-undo.
      471   define input parameter  p-code       as character  no-undo.
      472   define output parameter p-value      as character  no-undo.
      473   define output parameter p-type       as character  no-undo.
      474       define variable v-format         as character no-undo .
      475       define variable v-label          as character no-undo .
      476       define variable v-user-can-edit  as logical   no-undo .
      477       define variable v-output-display as logical   no-undo .
      478       define variable v-other          as character no-undo .
      479       define buffer buf_schedule-attr for ub.schedule-attr.
      480       run schedule-attr-name in this-procedure (
      481             input  p-code
      482           , output p-type
      483           , output v-format
      484           , output v-label
      485           , output v-user-can-edit
      486           , output v-output-display
      487           , output v-other
      488       ) no-error .
      489       if error-status :error
      490       then do:
      491           undo, return error return-value .
      492       end.
      493       if p-code begins ('schd-free-id':U + chr(4))
      494       and entry(2, p-code, chr(4)) = '':U then do:
      495         find first buf_schedule-attr no-lock
      496             where buf_schedule-attr.cre-db-num = p-cre-db-num
      497               and buf_schedule-attr.task-type  = p-task-type
      498               and buf_schedule-attr.task-num   = p-task-num
      499               and buf_schedule-attr.attr-code  begins p-code
      500         no-error .
      501       end.
      502       else do:
      503         find first buf_schedule-attr no-lock
      504             where buf_schedule-attr.cre-db-num = p-cre-db-num
      505               and buf_schedule-attr.task-type  = p-task-type
      506               and buf_schedule-attr.task-num   = p-task-num
      507               and buf_schedule-attr.attr-code  = p-code
      508         no-error .
      509       end.
      510       if available buf_schedule-attr
      511       then do:
      512           assign
      513               p-value = buf_schedule-attr.attr-value
      514           .
      515       end.
      516       else do:
      517         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      518            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      519         end.
      520         else do:
      521           assign
      522               p-value = if p-type = 'L':U then "no":U else ""
      523           .
      524         end.
      525       end.
      526   end.
      527   end procedure.
      528   procedure schedule-attr-write :
      529   do
      530   on error undo, return error
      531   :
      532   define input parameter p-cre-db-num  as integer   no-undo.
      533   define input parameter p-task-type   as character no-undo.
      534   define input parameter p-task-num    as integer   no-undo.
      535   define input parameter p-code        as character no-undo.
      536   define input parameter p-value       as character no-undo.
      537       define variable v-type              as character                no-undo.
      538       define variable v-format            as character                no-undo.
      539       define variable v-label             as character                no-undo.
      540       define variable v-user-can-edit     as logical                  no-undo.
      541       define variable v-output-display    as logical                  no-undo.
      542       define variable v-other             as character                no-undo.
      543       define buffer buf_schedule-attr for ub.schedule-attr .
      544       run schedule-attr-name in this-procedure (
      545             input  p-code
      546           , output v-type
      547           , output v-format
      548           , output v-label
      549           , output v-user-can-edit
      550           , output v-output-display
      551           , output v-other
      552       ) no-error.
      553       if error-status :error
      554       then do:
      555           undo, return error return-value.
      556       end.
      557       find first buf_schedule-attr exclusive-lock
      558            where buf_schedule-attr.cre-db-num = p-cre-db-num
      559              and buf_schedule-attr.task-type  = p-task-type
      560              and buf_schedule-attr.task-num   = p-task-num
      561              and buf_schedule-attr.attr-code  = p-code
      562       no-error.
      563       if not available buf_schedule-attr
      564       then do:
      565           create buf_schedule-attr.
      566           assign
      567             buf_schedule-attr.cre-db-num = p-cre-db-num
      568             buf_schedule-attr.task-type  = p-task-type
      569             buf_schedule-attr.task-num   = p-task-num
      570             buf_schedule-attr.attr-code  = p-code
      571             buf_schedule-attr.attr-value = p-value
      572           .
      573       end.
      574       else do:
      575           assign
      576               buf_schedule-attr.attr-value = p-value
      577           .
      578       end.
      579   end.
      580   end procedure.
      581   procedure schedule-attr-delete :
      582   do
      583   on error undo, return error
      584   :
      585   define input  parameter p-cre-db-num  as integer   no-undo.
      586   define input  parameter p-task-type   as character no-undo.
      587   define input  parameter p-task-num    as integer   no-undo.
      588   define input  parameter p-code        as character no-undo.
      589   define output parameter p-deleted     as logical   no-undo.
      590       define buffer buf_schedule-attr for ub.schedule-attr .
      591       define variable v-type              as character                no-undo.
      592       define variable v-format            as character                no-undo.
      593       define variable v-label             as character                no-undo.
      594       define variable v-user-can-edit     as logical                  no-undo.
      595       define variable v-output-display    as logical                  no-undo.
      596       define variable v-other             as character                no-undo.
      597       run schedule-attr-name in this-procedure (
      598             input p-code
      599           , output v-type
      600           , output v-format
      601           , output v-label
      602           , output v-user-can-edit
      603           , output v-output-display
      604           , output v-other
      605       ) no-error .
      606       if error-status :error
      607       then do:
      608           undo, return error return-value .
      609       end.
      610       find first buf_schedule-attr exclusive-lock
      611            where buf_schedule-attr.cre-db-num = p-cre-db-num
      612              and buf_schedule-attr.task-type  = p-task-type
      613              and buf_schedule-attr.task-num   = p-task-num
      614              and buf_schedule-attr.attr-code  = p-code
      615       no-error.
      616       if not available buf_schedule-attr
      617       then do:
      618           assign
      619               p-deleted = no
      620           .
      621       end.
      622       else do:
      623           delete buf_schedule-attr.
      624           assign
      625               p-deleted = yes
      626           .
      627       end.
      628   end.
      629   end procedure.
      630   procedure schedule-attr-news :
      631   do
      632   on error undo, return error
      633   :
      634       define input  parameter p-code           as character no-undo .
      635       define output parameter p-news           as logical   no-undo .
      636       if index(p-code, chr(4)) > 0 then do:
      637         p-code = entry(1, p-code, chr(4)).
      638       end.
      639       case p-code :
      640               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      641               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      642               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      643               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      644               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      645               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      646               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      647               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      648               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      649         otherwise do:
      650           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      651         end.
      652       end.
      653   end.
      654   end procedure.
      655   procedure schedule-attr-extract-logical :
      656   do
      657   on error undo, return error
      658   :
      659   define input  parameter p-parameter-number   as integer      no-undo.
      660   define input  parameter p-parameter-list     as character    no-undo.
      661   define output parameter p-parameter-value   as logical      no-undo.
      662       if num-entries( p-parameter-list ) > p-parameter-number - 1
      663       then do:
      664           assign
      665               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      666           .
      667       end.
      668       else do:
      669           assign
      670               p-parameter-value   = no
      671           .
      672       end.
      673   end.
      674   end procedure.
      675   procedure schedule-attr-get-free-id :
      676   do
      677   on error undo, return error return-value
      678   :
      679     define input  parameter p-cre-db-num  as integer   no-undo.
      680     define input  parameter p-task-type   as character no-undo.
      681     define input  parameter p-task-num    as integer   no-undo.
      682     define output parameter p-free-id     as character no-undo.
      683     define buffer buf_schedule-attr for ub.schedule-attr.
      684     find first buf_schedule-attr no-lock
      685         where buf_schedule-attr.cre-db-num = p-cre-db-num
      686           and buf_schedule-attr.task-type  = p-task-type
      687           and buf_schedule-attr.task-num   = p-task-num
      688           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      689     no-error .
      690     if available buf_schedule-attr then
      691     assign
      692     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      693     no-error
      694     .
      695   end.
      696   end procedure.
      697   procedure schedule-attr-get-free-props :
      698     define input parameter p-free-id as character no-undo .
      699     define output parameter p-value as character no-undo .
      700     define buffer buf_temp-schedule-free for temp-schedule-free.
      701     do
      702     on error undo, return error return-value
      703     :
      704       find first buf_temp-schedule-free no-lock no-error .
      705       if not available buf_temp-schedule-free then do:
      706         run schedule-attr-fill-free-props in this-procedure .
      707       end.
      708       find first buf_temp-schedule-free where
      709               buf_temp-schedule-free.free-id = p-free-id no-error.
      710       if available buf_temp-schedule-free then do:
      711         assign
      712         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      713                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      714                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      715                   buf_temp-schedule-free.conf-param           + chr(4) +
      716                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      717                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      718                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      719                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      720                   buf_temp-schedule-free.other-info
      721         .
      722       end.
      723       else do:
      724        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      725                              "id произвольной задачи - &5"
      726                              ,vss-workfile
      727                              ,vss-revision
      728                              ,vss-description
      729                              ,chr(10)
      730                              ,p-free-id).
      731       end.
      732     end.
      733   end procedure.
      734   procedure schedule-attr-is-rum-free-id :
      735   define input parameter p-free-id as character no-undo .
      736   define output parameter p-is-rum as logical no-undo .
      737   define buffer buf_temp-schedule-free for temp-schedule-free.
      738   do
      739   on error undo, return error
      740   :
      741       find first buf_temp-schedule-free no-lock no-error .
      742       if not available buf_temp-schedule-free then do:
      743         run schedule-attr-fill-free-props in this-procedure .
      744       end.
      745       find first buf_temp-schedule-free where
      746               buf_temp-schedule-free.free-id = p-free-id no-error.
      747       if available buf_temp-schedule-free
      748       and buf_temp-schedule-free.is-rum
      749       then do:
      750         p-is-rum = yes.
      751       end.
      752   end.
      753   end procedure.
      754   procedure schedule-attr-fill-free-props :
      755   define variable v-path                    as character                no-undo .
      756   DEFINE VARIABLE v-full-path               as character                no-undo .
      757   DEFINE VARIABLE v-file-name               as character                no-undo .
      758   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      759   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      760   define buffer buf_temp-schedule-free for temp-schedule-free.
      761   define variable v-answer as logical no-undo .
      762     do
      763     on error undo, return error substitute("&1 &2 &3&4&5&4"
      764                                           ,vss-workfile
      765                                           ,vss-revision
      766                                           ,vss-description
      767                                           ,chr(10)
      768                                           ,error-status:get-message(1) )
      769     :
      770       run gbl/filename.p (
      771                       input 'cmp/shd-free.d'
      772                     ,output v-full-path
      773                     ,output v-path
      774                     ,output v-file-name
      775                     ,output v-file-name-no-ext
      776                     ,output v-file-name-ext
      777                     ) .
      778       input from value(v-full-path).
      779       repeat :
      780         create buf_temp-schedule-free.
      781         import buf_temp-schedule-free.
      782       END.
      783       input close.
      784       _ff:
      785       for each buf_temp-schedule-free :
      786         if buf_temp-schedule-free.free-id = '':U then do:
      787            delete buf_temp-schedule-free.
      788            next _ff.
      789          end.
      790          run schedule-attr-check-enc in this-procedure (
      791                                                       input  buf_temp-schedule-free.free-id
      792                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      793                                                               buf_temp-schedule-free.proc-param-edit-name +
      794                                                               buf_temp-schedule-free.conf-param +
      795                                                               string(buf_temp-schedule-free.is-gbd) +
      796                                                               string(buf_temp-schedule-free.is-ubd) +
      797                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      798                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      799                                                               string(buf_temp-schedule-free.other-info)
      800                                                               )
      801                                                       ,input  buf_temp-schedule-free.enc-key
      802                                                       ,output v-answer    ) no-error .
      803          if error-status:error
      804          or not v-answer then delete buf_temp-schedule-free.
      805        end.
      806     end.
      807   end procedure.
      808   Function schedule-attr-reverse returns character (str as character).
      809      define variable rev_incl_s as character init "" no-undo .
      810      define variable rev_incl_i as integer no-undo .
      811      define variable rev_incl_l as integer no-undo .
      812      rev_incl_l = length(str).
      813      do rev_incl_i = 1 to rev_incl_l:
      814         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      815      end.
      816      return rev_incl_s.
      817   end.
      818   procedure schedule-attr-check-enc.
      819     define input  parameter p-free-id   as character no-undo .
      820     define input  parameter p-value     as character no-undo .
      821     define input  parameter p-enc-value as character no-undo .
      822     define output parameter p-answer    as logical   no-undo .
      823     define variable tmp         as character no-undo .
      824     define variable v-enc-value as character no-undo .
      825     assign
      826     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      827     .
      828     run schedule-attr-pswd-enc in this-procedure
      829       ( input tmp
      830        ,output v-enc-value
      831       ) no-error .
      832     if error-status:error then do:
      833       message
      834         vss-workfile vss-revision vss-description skip
      835         "Ошибка при вызове процедуры pswd-enc" skip
      836         return-value skip
      837         error-status :get-message(1) skip
      838         view-as alert-box error .
      839       undo, return error .
      840     end.
      841     if v-enc-value = p-enc-value then do:
      842       assign
      843         p-answer = true
      844       .
      845     end.
      846     else do:
      847       assign
      848         p-answer = false
      849       .
      850     end.
      851   end.
      852   procedure schedule-attr-conf-enc.
      853     define input  parameter p-free-id   as character no-undo .
      854     define input  parameter p-value     as character no-undo .
      855     define output parameter p-enc-value as character no-undo .
      856     define variable tmp         as character no-undo .
      857     assign
      858       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      859     .
      860     run schedule-attr-pswd-enc in this-procedure
      861       ( input tmp
      862        ,output p-enc-value
      863       ) no-error .
      864     if error-status:error then do:
      865       message
      866         vss-workfile vss-revision vss-description skip
      867         "Ошибка при вызове процедуры pswd-enc" skip
      868         return-value skip
      869         error-status :get-message(1) skip
      870         view-as alert-box error .
      871       undo, return error .
      872     end.
      873   end procedure.
      874   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   procedure schedule-attr-pswd-enc :
      876     define input parameter  pswd     as character no-undo .
      877     define output parameter enc-pswd as character no-undo .
      878     do
      879     on error undo, return error return-value
      880     :
      881       assign
      882         enc-pswd = encode(pswd + string(index(pswd, "k")))
      883       .
      884     end.
      885   end procedure.
      886   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   procedure cur-time :
      888      define output parameter p-today as date      no-undo .
      889      define output parameter p-time  as integer   no-undo .
      890     do
      891     on error undo, return error
      892     :
      893       define variable v-date1 as date      no-undo .
      894       define variable v-date2 as date      no-undo .
      895       define variable v-time  as integer   no-undo .
      896       assign
      897         v-date1 = today
      898         v-time  = time
      899         v-date2 = today
      900       .
      901       if v-date1 <> v-date2
      902       then do:
      903         assign
      904           v-date1 = today
      905           v-time  = v-time
      906         .
      907       end.
      908       assign
      909         p-today = v-date1
      910         p-time  = v-time
      911       .
      912     end.
      913   end.
      914   function cur-time-date returns character
      915   :
      916     return string(today, '99/99/9999':U) .
      917   end.
      918   function cur-time-mjd returns decimal
      919   :
      920     define variable v-date as date      no-undo .
      921     define variable v-time as integer   no-undo .
      922     run cur-time in this-procedure
      923       (output v-date
      924       ,output v-time
      925       ) .
      926     return integer(v-date) - 2400002 + (v-time / 86400) .
      927   end.
      928   function cur-time-get-ending-index returns integer
      929   (input p-number as integer
      930   )
      931   :
      932     if p-number < 0
      933     or p-number = ?
      934     then do:
      935       return 1 .
      936     end.
      937     define variable v-rest as integer   no-undo .
      938     assign
      939       p-number = p-number modulo 100
      940     .
      941     if p-number < 20
      942     then do:
      943       assign
      944         v-rest = p-number
      945       .
      946     end.
      947     else do:
      948       assign
      949         v-rest = p-number modulo 10
      950       .
      951     end.
      952     case v-rest :
      953       when 1
      954       then do:
      955         return 2 .
      956       end.
      957       when 2 or
      958       when 3 or
      959       when 4
      960       then do:
      961         return 3 .
      962       end.
      963       otherwise do:
      964         return 1 .
      965       end.
      966     end case .
      967   end.
      968   procedure cur-time-mjd-to-date :
      969      define input  parameter i-mjd-diff as decimal no-undo.
      970      define output parameter o-Date     as date    no-undo.
      971      define output parameter o-Time     as integer no-undo.
      972      define variable v-day-number as integer   no-undo .
      973      if    i-mjd-diff < 0
      974         or i-mjd-diff = ?
      975      then do:
      976         return "?" .
      977      end.
      978      assign
      979         v-day-number = truncate(i-mjd-diff,0).
      980         o-Date = date(v-day-number + 2400002).
      981         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      982     .
      983   end.
      984   function cur-time-mjd-to-string returns character
      985   (input p-mjd-diff as decimal
      986   )
      987   :
      988     define variable v-day-number as integer   no-undo .
      989     define variable v-seconds    as integer   no-undo .
      990     define variable v-hour       as integer   no-undo .
      991     define variable v-min        as integer   no-undo .
      992     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      993     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      994     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      995     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      996     if p-mjd-diff < 0
      997     or p-mjd-diff = ?
      998     then do:
      999       return "?" .
     1000     end.
     1001     assign
     1002       v-day-number = integer(truncate(p-mjd-diff,0))
     1003       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1004     .
     1005     if v-seconds > 86400
     1006     then do:
     1007       assign
     1008         v-seconds = 86400 - 1
     1009       .
     1010     end.
     1011     if v-seconds < 0
     1012     then do:
     1013       assign
     1014         v-seconds = 0
     1015       .
     1016     end.
     1017     assign
     1018       v-hour = truncate(v-seconds / 3600, 0)
     1019     .
     1020     assign
     1021       v-seconds = v-seconds modulo 3600
     1022     .
     1023     assign
     1024       v-min = truncate(v-seconds / 60, 0)
     1025     .
     1026     assign
     1027       v-seconds = v-seconds modulo 60
     1028     .
     1029     return
     1030         (if v-day-number <> 0
     1031           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1032           else ""
     1033         )
     1034       + (if v-day-number <> 0 or v-hour <> 0
     1035           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1036           else ""
     1037         )
     1038       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1039           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1040           else ""
     1041         )
     1042       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1043       .
     1044   end.
     1045   function cur-time-string returns character
     1046   :
     1047     define variable v-date as date      no-undo .
     1048     define variable v-time as integer   no-undo .
     1049     run cur-time in this-procedure
     1050       (output v-date
     1051       ,output v-time
     1052       ) .
     1053     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1054   end.
     1055   function cur-time-string-sec returns character
     1056   :
     1057     define variable v-date as date      no-undo .
     1058     define variable v-time as integer   no-undo .
     1059     run cur-time in this-procedure
     1060       (output v-date
     1061       ,output v-time
     1062       ) .
     1063     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1064   end.
     1065   function cur-time-custom  returns character
     1066   (input p-prefix as character
     1067   ,input p-date-format as character
     1068   ,input p-delimiter as character
     1069   ,input p-time-format as character
     1070   ,input p-suffix as character
     1071   )
     1072   :
     1073     define variable v-date as date      no-undo .
     1074     define variable v-time as integer   no-undo .
     1075     run cur-time in this-procedure
     1076       (output v-date
     1077       ,output v-time
     1078       ) .
     1079     return
     1080       p-prefix
     1081       + string(v-date, p-date-format)
     1082       + p-delimiter
     1083       + string(v-time, p-time-format)
     1084       + p-suffix
     1085       .
     1086   end.
     1087   function cur-time-print  returns character
     1088   :
     1089     define variable v-date as date      no-undo .
     1090     define variable v-time as integer   no-undo .
     1091     run cur-time in this-procedure
     1092       (output v-date
     1093       ,output v-time
     1094       ) .
     1095     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1096   end.
     1097   function cur-time-datetime returns datetime
     1098   :
     1099     define variable v-char as character no-undo .
     1100     define variable v-datetime as datetime no-undo .
     1101     v-char = cur-time-string().
     1102     v-datetime = datetime(v-char).
     1103     return  v-datetime.
     1104   end.
     1105   function cur-time-string-msec returns character
     1106   :
     1107     define variable v-date as datetime  no-undo .
     1108     v-date = now.
     1109     return string(v-date) .
     1110   end.
     1111   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   PROCEDURE verify-ini-entry:
     1113   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1114   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1115   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1116   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1117   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1118   define variable v-mess as character no-undo .
     1119   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1120   if ini-entry-value = ? and ini-key-name begins "spl"
     1121   then
     1122   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1123   if ini-entry-value = ? and ini-key-name begins "sav"
     1124   then
     1125   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1126   if ini-entry-value = ? then do:
     1127     assign
     1128     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1129                       , chr(10)
     1130                       , ini-section-name
     1131                       , ini-key-name
     1132                       , error-msg-text).
     1133       if not silence then do:
     1134         message
     1135         v-mess
     1136         view-as alert-box ERROR  .
     1137         return error.
     1138       end.
     1139       else do:
     1140         return error v-mess.
     1141       end.
     1142   end.
     1143   END PROCEDURE.
     1144   PROCEDURE verify-file:
     1145   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1146   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1147   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1148   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1149   file-info:file-name = filename.
     1150   found = NOT (file-info:full-pathname = ?).
     1151   if NOT found  then do:
     1152     if not silence then do:
     1153       message error-msg-text
     1154       view-as alert-box ERROR.
     1155       return error.
     1156     end.
     1157     else return error error-msg-text.
     1158   end.
     1159   END PROCEDURE.
