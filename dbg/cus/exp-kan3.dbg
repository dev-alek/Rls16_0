     1496       DISP fnperesort WITH FRAME Dialog-Frame.
     1497   END.
     1498   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1499   DO:
     1500       ASSIGN
     1501       staff
     1502       peresort
     1503       prihod
     1504       rasvn
     1505       rasvne
     1506       udal
     1507       fnsoot
     1508       fnkassir
     1509       fnperesort
     1510       fnprih
     1511       fnrasvn
     1512       fnudal
     1513       fnrasvne
     1514       dateb
     1515       dateend
     1516       e-mail.
     1517       if (staff = true and fnkassir = "") or (peresort = true and fnperesort = "")
     1518       or (prihod = true and fnprih = "") or (rasvn = true and fnrasvn = "")  or (udal = true and fnudal = "")
     1519       or (rasvne = true and fnrasvne = "")
     1520       then
     1521       do:
     1522           message "Необходимо ввести путь для выгрузок по флагам".
     1523           return no-apply.
     1524       end.
     1525       if (staff    = false and trim(fnkassir)   <> "")  then assign fnkassir   = "".
     1526       if (peresort = false and trim(fnperesort) <> "")  then assign fnperesort = "".
     1527       if (prihod   = false and trim(fnprih)     <> "")  then assign fnprih     = "".
     1528       if (rasvn    = false and trim(fnrasvn)    <> "")  then assign fnrasvn    = "".
     1529       if (udal     = false and trim(fnudal)     <> "")  then assign fnudal     = "".
     1530       if (rasvne   = false and trim (fnrasvne)  <> "")  then assign fnrasvne   = "".
     1531       IF trim(fnsoot) = "" THEN
     1532       DO:
     1533           MESSAGE "Необходимо ввести путь для файла соответствий".
     1534           return no-apply.
     1535       END.
     1536       if not peresort and not prihod and not rasvn and not rasvne and not staff and not udal then
     1537           do:
     1538               message "Вы не отметили ни одну из выгрузок отчётов!" skip
     1539                       "Необходимо отметить галочкой хотя бы один отчёт." view-as alert-box.
     1540               return no-apply.
     1541           end.
     1542       if dateb = ? or dateend = ? then
     1543           do:
     1544               message "Не введены даты периода, повторите попытку." view-as alert-box.
     1545               return no-apply.
     1546           end.
     1547       if dateb>dateend then
     1548       do:
     1549       message "Период начала не может быть больше периода конца".
     1550       return no-apply.
     1551       end.
     1552       else
     1553       do:
     1554       MESSAGE "Произвести выгрузку?"
     1555       VIEW-AS ALERT-BOX QUESTION
     1556       BUTTONS yes-no UPDATE continue-ok AS LOGICAL.
     1557       IF continue-ok THEN DO:
     1558       run waitfram-show in this-procedure ("Ждите... Вывод информации...").
     1559       RUN cus\exp-kanp.p(par1, par2 , loghandle, 0, "noauto;" + string(dateb) + ";" + string(dateend) + ";" + fnrasvn + ";" + fnudal + ";" + fnprih + ";" + fnsoot + ";" + fnkassir + ";" + fnperesort + ";" + fnrasvne + ";" + "; !" + e-mail , 0 , 0).
     1560       run waitfram-hide in this-procedure .
     1561       END.
     1562       else
     1563       return no-apply.
     1564       END.
     1565   END.
     1566   ON LEAVE OF fnkassir IN FRAME Dialog-Frame
     1567   DO:
     1568       ASSIGN fnkassir.
     1569       IF SEARCH( fnkassir ) <> ? AND SEARCH( fnkassir ) <> "":U THEN DO:
     1570           ASSIGN FILE-INFO:FILE-NAME = file-name.
     1571           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnkassir = FILE-INFO:FULL-PATHNAME.
     1572           DISP fnkassir WITH FRAME Dialog-Frame.
     1573       END.
     1574       APPLY "TAB":U TO fnkassir IN FRAME Dialog-Frame.
     1575   END.
     1576   ON LEAVE OF fnperesort IN FRAME Dialog-Frame
     1577   DO:
     1578       ASSIGN fnperesort.
     1579       IF SEARCH( fnperesort ) <> ? AND SEARCH( fnperesort ) <> "":U THEN DO:
     1580           ASSIGN FILE-INFO:FILE-NAME = fnperesort.
     1581           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnperesort = FILE-INFO:FULL-PATHNAME.
     1582           DISP fnperesort WITH FRAME Dialog-Frame.
     1583       END.
     1584       APPLY "TAB":U TO fnperesort IN FRAME Dialog-Frame.
     1585   END.
     1586   ON LEAVE OF fnprih IN FRAME Dialog-Frame
     1587   DO:
     1588       ASSIGN fnprih.
     1589       IF SEARCH( fnprih ) <> ? AND SEARCH( fnprih ) <> "":U THEN DO:
     1590           ASSIGN FILE-INFO:FILE-NAME =fnprih.
     1591           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnprih = FILE-INFO:FULL-PATHNAME.
     1592           DISP fnprih WITH FRAME Dialog-Frame.
     1593       END.
     1594       APPLY "TAB":U TO fnprih IN FRAME Dialog-Frame.
     1595   END.
     1596   ON LEAVE OF fnrasvn IN FRAME Dialog-Frame
     1597   DO:
     1598       ASSIGN fnrasvn.
     1599       IF SEARCH( fnrasvn ) <> ? AND SEARCH( fnrasvn ) <> "":U THEN DO:
     1600           ASSIGN FILE-INFO:FILE-NAME = fnrasvn.
     1601           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnrasvn = FILE-INFO:FULL-PATHNAME.
     1602           DISP fnrasvn WITH FRAME Dialog-Frame.
     1603       END.
     1604       APPLY "TAB":U TO fnrasvn IN FRAME Dialog-Frame.
     1605   END.
     1606   ON LEAVE OF fnrasvne IN FRAME Dialog-Frame
     1607   DO:
     1608       ASSIGN fnrasvne.
     1609       IF SEARCH( fnrasvne ) <> ? AND SEARCH( fnrasvne ) <> "":U THEN DO:
     1610           ASSIGN FILE-INFO:FILE-NAME = fnrasvne.
     1611           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnrasvne = FILE-INFO:FULL-PATHNAME.
     1612           DISP fnrasvne WITH FRAME Dialog-Frame.
     1613       END.
     1614       APPLY "TAB":U TO fnrasvne IN FRAME Dialog-Frame.
     1615   END.
     1616   ON LEAVE OF fnudal IN FRAME Dialog-Frame
     1617   DO:
     1618       ASSIGN fnudal.
     1619       IF SEARCH( fnudal ) <> ? AND SEARCH( fnudal ) <> "":U THEN DO:
     1620           ASSIGN FILE-INFO:FILE-NAME = fnudal.
     1621           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnudal = FILE-INFO:FULL-PATHNAME.
     1622           DISP fnudal WITH FRAME Dialog-Frame.
     1623       END.
     1624       APPLY "TAB":U TO fnudal IN FRAME Dialog-Frame.
     1625   END.
     1626   ON VALUE-CHANGED OF peresort IN FRAME Dialog-Frame
     1627   DO:
     1628      assign peresort.
     1629      disable fnperesort b-file-9 WITH FRAME Dialog-Frame.
     1630      enable fnperesort   when peresort = true
     1631             b-file-9     when peresort = true
     1632      WITH FRAME Dialog-Frame.
     1633   END.
     1634   ON VALUE-CHANGED OF prihod IN FRAME Dialog-Frame
     1635   DO:
     1636       assign prihod.
     1637       disable fnprih b-file-3 WITH FRAME Dialog-Frame.
     1638       enable fnprih   when prihod = true
     1639              b-file-3 when prihod = true
     1640       WITH FRAME Dialog-Frame.
     1641   END.
     1642   ON VALUE-CHANGED OF rasvn IN FRAME Dialog-Frame
     1643   DO:
     1644       assign rasvn.
     1645       disable fnrasvn b-file WITH FRAME Dialog-Frame.
     1646       enable fnrasvn   when rasvn = true
     1647             b-file when rasvn = true
     1648       WITH FRAME Dialog-Frame.
     1649   END.
     1650   ON VALUE-CHANGED OF rasvne IN FRAME Dialog-Frame
     1651   DO:
     1652       assign rasvne.
     1653       disable fnrasvne B-file-5 WITH FRAME Dialog-Frame.
     1654       enable fnrasvne when rasvne = true
     1655              B-file-5 when rasvne = true
     1656       WITH FRAME Dialog-Frame.
     1657   END.
     1658   ON VALUE-CHANGED OF staff IN FRAME Dialog-Frame
     1659   DO:
     1660      assign staff.
     1661      disable fnkassir b-file-6 WITH FRAME Dialog-Frame.
     1662      enable fnkassir   when staff = true
     1663             b-file-6 when staff = true
     1664      WITH FRAME Dialog-Frame.
     1665   END.
     1666   ON VALUE-CHANGED OF udal IN FRAME Dialog-Frame
     1667   DO:
     1668      assign udal.
     1669      disable fnudal b-file-2 WITH FRAME Dialog-Frame.
     1670      enable fnudal   when udal = true
     1671             b-file-2 when udal = true
     1672      WITH FRAME Dialog-Frame.
     1673   END.
     1674   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1675   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1676   MAIN-BLOCK:
     1677   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1678      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1679     RUN enable_UI.
     1680     run my-enable .
     1681      WAIT-FOR GO OF FRAME Dialog-Frame.
     1682   END.
     1683   RUN disable_UI.
     1684   PROCEDURE disable_UI :
     1685     HIDE FRAME Dialog-Frame.
     1686   END PROCEDURE.
     1687   PROCEDURE enable_UI :
     1688     DISPLAY dateb dateend staff fnkassir peresort fnperesort rasvn fnrasvn udal
     1689             fnudal prihod fnprih rasvne fnrasvne fnsoot e-mail
     1690         WITH FRAME Dialog-Frame.
     1691     ENABLE dateb dateend staff peresort rasvn udal prihod rasvne fnsoot B-file-4
     1692            e-mail Btn_OK Btn_Cancel
     1693         WITH FRAME Dialog-Frame.
     1694     VIEW FRAME Dialog-Frame.
     1695   END PROCEDURE.
     1696   PROCEDURE my-enable :
     1697     disable fnkassir
     1698            B-file-6
     1699            fnperesort
     1700            B-file-9
     1701            fnrasvn
     1702            B-file
     1703            fnudal
     1704            B-file-2
     1705            fnprih
     1706            B-file-3
     1707            fnrasvne
     1708            B-file-5
     1709        WITH FRAME Dialog-Frame.
     1710     ENABLE fnkassir when staff = true
     1711            B-file-6 when staff = true
     1712            fnperesort when peresort = true
     1713            B-file-9 when peresort = true
     1714            fnrasvn when rasvn = true
     1715            B-file when rasvn = true
     1716            fnudal when udal = true
     1717            B-file-2 when udal = true
     1718            fnprih when prihod = true
     1719            B-file-3 when prihod =true
     1720            fnrasvne when rasvne = true
     1721            B-file-5 when rasvne = true
     1722           WITH FRAME Dialog-Frame.
     1723   end procedure.
     1724   PROCEDURE proc-save :
     1725   END PROCEDURE.
