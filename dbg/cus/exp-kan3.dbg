      357   define new global shared variable g#vssrevis-logger as handle    no-undo .
      358   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      359   define variable v-vssrevis-logger                   as handle    no-undo .
      360   procedure vss-logevent :
      361     define input  parameter p-extra-paramters as character no-undo .
      362     define variable v-vssrevis-parameters as character no-undo .
      363     do
      364     on error undo, return error return-value
      365     :
      366       if  valid-handle(v-vssrevis-logger)
      367       and v-vssrevis-logger :get-signature("logevent") <> ""
      368       then do:
      369         run vss-get-parameters in this-procedure
      370           (output v-vssrevis-parameters
      371           ).
      372         run logevent in v-vssrevis-logger
      373           (input vss-workfile
      374           ,input vss-revision
      375           ,input v-vssrevis-parameters
      376           ,input p-extra-paramters
      377           ).
      378       end.
      379     end.
      380   end procedure.
      381   assign
      382     v-vssrevis-logger = g#vssrevis-logger
      383   .
      384   if  valid-handle(v-vssrevis-logger)
      385   and v-vssrevis-logger :get-signature("logevent") <> ""
      386   then do:
      387     assign
      388       v-vssrevis-logevent = true
      389     .
      390     run vss-logevent in this-procedure (input vss-description) .
      391   end.
