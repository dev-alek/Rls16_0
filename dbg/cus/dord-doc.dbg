     3036           v-fltopend-rowid[1] = ?
     3037         .
     3038       end.
     3039       else do:
     3040         assign
     3041         parameter-2-23 = (if p-find-next then "true":u else "false":u )
     3042         parameter-3-23 =  "FOR EACH buf_doc-list"
