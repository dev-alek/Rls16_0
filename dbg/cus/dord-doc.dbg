     3048           )
     3049         parameter-5-23 = (" " + "" + " " + ", EACH buf_ord-doc NO-LOCK  where buf_ord-doc.doc-code = buf_doc-list.doc-code" + " " + p-find-condition)
     3050         parameter-6-23 = if sort-phrase-23 = ''
     3051                              then
     3052           (
     3053           " " + " " +
     3054             " " + sort-column-phrase +
     3055           " " + " "
     3056           )
     3057                              else
     3058           (
     3059           " " + " " +
     3060             " " + sort-column-phrase +
     3061           " " + sort-phrase-23
     3062           )
     3063         parameter-7-23 =
     3064           "   "
     3065       .
     3066         run fltopend_fltfindq in this-procedure  (
     3067                             input this-procedure:handle
     3068                             ,input query BROWSE-AM:handle
     3069                             ,input logical(parameter-2-23)
     3070                             ,input no-lock
     3071                             ,input parameter-3-23
     3072                             ,input parameter-4-23
     3073                             ,input parameter-5-23
     3074                             ,input parameter-6-23
     3075                             ,input parameter-7-23
     3076                             ,output v-fltopend-rowid
     3077                             ) no-error.
     3078         .
     3079         doc-rec = ?.
     3080       end.
     3081       assign
     3082         l-query-was-opened = true
     3083       .
     3084     end.
     3085   end.
     3086     run waitfram-hide in this-procedure .
     3087       end.
     3088       else do:
     3089         frame Dialog-Frame:TITLE = title0 + "Статус: " + p-sts .
     3090   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
