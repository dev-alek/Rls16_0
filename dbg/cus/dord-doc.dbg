      883   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      884   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      885   procedure fltopend_fltopend :
      886   define input parameter p-parent-handle as handle no-undo .
      887   define input parameter p-qh as handle no-undo .
      888   define input parameter p-flt-open-open-query  as character no-undo .
      889   define input parameter p-where-cond as character no-undo .
      890   define input parameter p-use-indFIRST-query-tail as character no-undo .
      891   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      892   define input parameter p-indexed-reposition as character no-undo .
      893     do
      894     on error undo, return error
      895     :
      896   define variable v-prepare-string as character no-undo .
      897   define variable glog as logical no-undo .
      898   assign
      899   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      900                      p-where-cond + chr(32)  +
      901                      p-use-indFIRST-query-tail + chr(32) +
      902                      p-use-ind-sort-clmn-by + chr(32) +
      903                      p-indexed-reposition
      904   .
      905   assign
      906   glog = p-qh:query-prepare(v-prepare-string) no-error .
      907   if not glog
      908   or error-status:error then do:
      909     message error-status:get-message(1) view-as alert-box .
      910     undo, return error .
      911   end.
      912   assign
      913   glog = p-qh:query-open no-error .
      914   if not glog
      915   or error-status:error then do:
      916     message error-status:get-message(1) view-as alert-box .
      917     undo, return error .
      918   end.
      919     end.
      920   end procedure.
      921   procedure fltopend_fltfindd :
      922   define input parameter p-parent-handle as handle no-undo .
      923   define input parameter p-qh as handle no-undo .
      924   define input parameter p-rowid as rowid no-undo .
      925   define input parameter p-next as logical no-undo .
      926   define input parameter p-lock as integer no-undo .
      927   define input parameter p-bh as handle no-undo .
      928   define input parameter p-where-cond as character no-undo .
      929   define input parameter p-use-index-phrase as character no-undo .
      930   define variable glog as logical no-undo .
      931   define variable v-qh as handle no-undo .
      932   define variable v-bh as handle no-undo .
      933   define variable v-recid as recid no-undo .
      934   define variable v-prepare-string as character no-undo .
      935   do
      936   on error undo, return error
      937   on stop undo, return error
      938   :
      939     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      940     create buffer v-bh for table p-bh buffer-name p-bh:name.
      941     create query v-qh.
      942     v-qh:set-buffers(v-bh).
      943     v-prepare-string = substitute("for each &1 &2 &3"
      944                                     ,v-bh:name
      945                                     ,p-where-cond
      946                                     ,p-use-index-phrase).
      947     glog = v-qh:query-prepare(v-prepare-string) no-error.
      948     if not glog then do:
      949       delete object v-qh.
      950       delete object v-bh.
      951       undo, return error .
      952     end.
      953     glog = v-qh:query-open no-error .
      954     if not glog then do:
      955       delete object v-qh.
      956       delete object v-bh.
      957       undo, return error .
      958     end.
      959     if p-next then do:
      960       v-qh:reposition-to-rowid(p-rowid) no-error .
      961       glog = v-qh:get-next( p-lock) no-error .
      962       glog = v-qh:get-next( p-lock) no-error .
      963       if not glog or v-qh:query-off-end = yes then do:
      964         glog = v-qh:get-first( p-lock) no-error .
      965       end.
      966     end.
      967     else do:
      968       glog = v-qh:get-first( p-lock) no-error .
      969     end.
      970     v-recid = v-bh:recid no-error .
      971     delete object v-qh.
      972     delete object v-bh.
      973     return string(v-recid) .
      974   end.
      975   end procedure.
      976   procedure fltopend_fltfindq :
      977   define input parameter p-parent-handle as handle no-undo .
      978   define input parameter p-qh as handle no-undo .
      979   define input parameter p-next as logical no-undo .
      980   define input parameter p-lock as integer no-undo .
      981   define input parameter p-flt-open-open-query  as character no-undo .
      982   define input parameter p-where-cond as character no-undo .
      983   define input parameter p-use-indFIRST-query-tail as character no-undo .
      984   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      985   define input parameter p-indexed-reposition as character no-undo .
      986   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      987   define variable glog as logical no-undo .
      988   define variable v-qh as handle no-undo .
      989   define variable v-bh as handle no-undo extent 18.
      990   define variable v-rowid as rowid no-undo extent 18.
      991   define variable v-ii as integer no-undo .
      992   define variable v-prepare-string as character no-undo .
      993   do
      994   on error undo, return error
      995   on stop undo, return error
      996   :
      997     create query v-qh.
      998     do v-ii = 1 to p-qh:num-buffers:
      999       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1000       assign
     1001       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1002       no-error.
     1003       v-qh:add-buffer(v-bh[v-ii]).
     1004     end.
     1005     assign
     1006     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1007                       p-where-cond + chr(32)  +
     1008                       p-use-indFIRST-query-tail + chr(32) +
     1009                       p-use-ind-sort-clmn-by + chr(32) +
     1010                       p-indexed-reposition
     1011     .
     1012     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1013     if not glog then do:
     1014       delete object v-qh.
     1015       do v-ii = 1 to p-qh:num-buffers:
     1016         delete object v-bh[v-ii].
     1017       end.
     1018       undo, return error .
     1019     end.
     1020     glog = v-qh:query-open no-error .
     1021     if not glog then do:
     1022       delete object v-qh.
     1023       do v-ii = 1 to p-qh:num-buffers:
     1024         delete object v-bh[v-ii].
     1025       end.
     1026       undo, return error .
     1027     end.
     1028     if p-next then do:
     1029       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1030       glog = v-qh:get-next( p-lock) no-error .
     1031       glog = v-qh:get-next( p-lock) no-error .
     1032       if not glog or v-qh:query-off-end = yes then do:
     1033         glog = v-qh:get-first( p-lock) no-error .
     1034       end.
     1035     end.
     1036     else do:
     1037       glog = v-qh:get-first( p-lock) no-error .
     1038     end.
     1039     do v-ii = 1 to p-qh:num-buffers:
     1040       assign
     1041       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1042       no-error.
     1043     end.
     1044     delete object v-qh.
     1045     do v-ii = 1 to p-qh:num-buffers:
     1046       delete object v-bh[v-ii].
     1047     end.
     1048   end.
     1049   end procedure.
