     1089        LABEL "Помо&щь"
     1090        SIZE 10 BY 1
     1091        BGCOLOR 8 .
     1092   DEFINE BUTTON B-lookup
     1093        LABEL "&Просмотр"
     1094        SIZE 10 BY 1.
     1095   DEFINE BUTTON B-mark
     1096        LABEL "&*"
     1097        SIZE 3 BY 1.
     1098   DEFINE BUTTON B-print
     1099        LABEL "Пе&чать"
     1100        SIZE 10 BY 1.
     1101   DEFINE BUTTON b-quit AUTO-END-KEY
     1102        LABEL "&Выход"
     1103        SIZE 10 BY 1
     1104        BGCOLOR 8 .
     1105   DEFINE BUTTON B-sel AUTO-GO
     1106        LABEL "Вы&бор"
     1107        SIZE 10 BY 1.
     1108   DEFINE VARIABLE v-PS LIKE ub.ord-doc.PS
     1109        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1110        SIZE 97 BY 2.54 NO-UNDO.
     1111   DEFINE VARIABLE F-doc-code AS CHARACTER FORMAT "X(256)":U
     1112        LABEL "Поиск по № заказа"
     1113        VIEW-AS FILL-IN
     1114        SIZE 18 BY 1
     1115        FGCOLOR 4  NO-UNDO.
     1116   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     1117         VIEW-AS TEXT
     1118        SIZE 7.5 BY 1
     1119        FGCOLOR 4  NO-UNDO.
     1120   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Тип:"
     1121         VIEW-AS TEXT
     1122        SIZE 4.5 BY 1
     1123        FGCOLOR 4  NO-UNDO.
     1124   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1125         VIEW-AS TEXT
     1126        SIZE 3 BY 1
     1127        FGCOLOR 4  NO-UNDO.
     1128   DEFINE VARIABLE RS-sts AS CHARACTER
     1129        VIEW-AS RADIO-SET HORIZONTAL
     1130        RADIO-BUTTONS
     1131             "Item 1", "1",
     1132   "Item 2", "2",
     1133   "Item 3", "3"
     1134        SIZE 85 BY 1 NO-UNDO.
     1135   DEFINE VARIABLE RS-type AS CHARACTER
     1136        VIEW-AS RADIO-SET HORIZONTAL
     1137        RADIO-BUTTONS
     1138             "Item 1", "1",
     1139   "Item 2", "2",
     1140   "Item 3", "3"
     1141        SIZE 84.5 BY 1 NO-UNDO.
     1142   DEFINE NEW SHARED QUERY BROWSE-AM FOR
     1143         buf_doc-list,
     1144         buf_ord-doc SCROLLING.
     1145   DEFINE BROWSE BROWSE-AM
     1146     QUERY BROWSE-AM NO-LOCK DISPLAY
     1147         mark-string(recid(buf_ord-doc),p-rid-list) COLUMN-LABEL '*' FORMAT "X(1)":U
     1148      buf_ord-doc.doc-code COLUMN-LABEL 'Номер' FORMAT "X(14)":U
     1149      buf_ord-doc.doc-type COLUMN-LABEL 'Тип' FORMAT "X(3)":U
     1150      buf_ord-doc.status_ COLUMN-LABEL 'Статус' FORMAT "X(9)":U
     1151      buf_ord-doc.doc-date COLUMN-LABEL 'Дата' FORMAT "99/99/99":U
     1152      buf_ord-doc.obj-type + ' ' + string(buf_ord-doc.obj-code) COLUMN-LABEL 'Объект' FORMAT  "X(10)":U
     1153      buf_ord-doc.cli-type + ' ' + string(buf_ord-doc.cli-code) COLUMN-LABEL 'Контрагент' FORMAT  "X(10)":U
     1154      buf_ord-doc.ship-date COLUMN-LABEL 'Доставка' FORMAT  "99/99/99":U
     1155      string(buf_ord-doc.ship-time, 'hh:mm') COLUMN-LABEL 'Время' FORMAT  "X(5)":U
     1156      buf_ord-doc.date-sale-1 COLUMN-LABEL 'Для продажи с' FORMAT  "99/99/99":U
     1157      buf_ord-doc.date-sale-2 COLUMN-LABEL ' - по' FORMAT  "99/99/99":U
     1158     ENABLE
     1159         buf_ord-doc.doc-code
     1160       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 13.5 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
     1161   DEFINE FRAME Dialog-Frame
     1162        b-quit AT ROW 1 COL 1
     1163        B-mark AT ROW 1 COL 11
     1164        B-sel AT ROW 1 COL 17.5
     1165        B-lookup AT ROW 1 COL 27.5
     1166        B-del AT ROW 1 COL 37.5
     1167        B-close AT ROW 1 COL 47.5
     1168        B-print AT ROW 1 COL 77.5
     1169        B-Help AT ROW 1 COL 87.5
     1170        RS-sts AT ROW 2.5 COL 11.5 NO-LABEL
     1171        RS-type AT ROW 3.5 COL 11.5 NO-LABEL
     1172        F-doc-code AT ROW 4.5 COL 20 COLON-ALIGNED
     1173        BROWSE-AM AT ROW 5.75 COL 1.5
     1174        v-PS AT ROW 19.25 COL 1.5 HELP
     1175             "" NO-LABEL
     1176        B-add AT ROW 20.75 COL 76
     1177        B-chg AT ROW 20.75 COL 87.5
     1178        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
     1179        FILL-IN-1 AT ROW 2.5 COL 3.5 NO-LABEL
     1180        FILL-IN-2 AT ROW 3.5 COL 6.5 NO-LABEL
     1181        SPACE(87.74) SKIP(17.29)
     1182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1184            TITLE "Список заказов".
     1185   ASSIGN
     1186          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1187          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1188   ASSIGN
     1189          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-print:HANDLE.
     1190   ASSIGN
     1191          BROWSE-AM:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1192   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1193   OR ENDKEY OF FRAME Dialog-Frame DO:
     1194       run gbl/markqwa.p (
     1195            input b-mark:sensitive
     1196          , input p-rid-list) no-error.
     1197       if error-status:error then return no-apply.
     1198       APPLY "END-ERROR":U TO SELF.
     1199   END.
     1200   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1201   DO:
     1202    define variable loc#log as logical no-undo.
     1203    define variable loc-doc-rec as recid no-undo .
     1204   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   do:
     1206     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1207       (input  v-cntxt-db-num
     1208       ,input  v-cntxt-userid
     1209       ,input  0
     1210       ,input  'actn_pmnt-ord-doc_add-def':U
     1211       ,input  'object':U
     1212       ,input  v-cntxt-host-code-obj
     1213       ,input  v-cntxt-obj-type
     1214       ,input  v-cntxt-obj-code
     1215       ,input  0
     1216       ,input  0
     1217       ,input  0
     1218       ,input  true
     1219       ,output loc#log
     1220       )  .
     1221   end.
     1222     if not loc#log then return no-apply.
     1223     if loc-doc-rec <> ? THEN DO:
     1224         run openbr in this-procedure .
     1225         reposition BROWSE-AM to recid loc-doc-rec no-error.
     1226         if error-status:error then do:                           find first pos_ord-doc no-lock where                                   recid(pos_ord-doc) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ЗАКАЗОВ" skip                            string(if avail pos_ord-doc                                     then  substitute("№ заказа: &1"                                                     , pos_ord-doc.doc-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1227     END.
     1228     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1229     apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1230   END.
     1231   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1232   DO:
     1233   define variable loc#log as logical no-undo.
     1234   define variable loc-doc-rec as recid no-undo .
     1235   if not available buf_doc-list then return no-apply.
     1236   assign
     1237     loc-doc-rec = recid(buf_doc-list)
     1238     .
     1239   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   do:
     1241     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1242       (input  v-cntxt-db-num
     1243       ,input  v-cntxt-userid
     1244       ,input  0
     1245       ,input  'actn_pmnt-ord-doc_add-def':U
     1246       ,input  'object':U
     1247       ,input  v-cntxt-host-code-obj
     1248       ,input  v-cntxt-obj-type
     1249       ,input  v-cntxt-obj-code
     1250       ,input  0
     1251       ,input  0
     1252       ,input  0
     1253       ,input  true
     1254       ,output loc#log
     1255       )  .
     1256   end.
     1257       if not loc#log then return no-apply.
     1258       if loc-doc-rec <> ? THEN DO:
     1259             run openbr in this-procedure .
     1260             reposition BROWSE-AM to recid loc-doc-rec no-error.
     1261             if error-status:error then do:                           find first pos_ord-doc no-lock where                                   recid(pos_ord-doc) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ЗАКАЗОВ" skip                            string(if avail pos_ord-doc                                     then  substitute("№ заказа: &1"                                                     , pos_ord-doc.doc-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1262       END.
     1263       apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1264       apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1265   END.
     1266   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     1267   DO:
     1268     run proc-b-close in this-procedure .
     1269   END.
     1270   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1271   DO:
     1272       run proc-b-del in this-procedure no-error.
     1273       if error-status:error then return no-apply.
     1274   END.
     1275   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1276   DO:
     1277   define variable loc#log as logical no-undo .
     1278   if not available buf_doc-list then return no-apply.
     1279   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   do:
     1281     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1282       (input  v-cntxt-db-num
     1283       ,input  v-cntxt-userid
     1284       ,input  0
     1285       ,input  'actn_pmnt-ord-doc_lookup':U
     1286       ,input  'object':U
     1287       ,input  v-cntxt-host-code-obj
     1288       ,input  v-cntxt-obj-type
     1289       ,input  v-cntxt-obj-code
     1290       ,input  0
     1291       ,input  0
     1292       ,input  0
     1293       ,input  true
     1294       ,output loc#log
     1295       )  .
     1296   end.
     1297     if not loc#log
     1298     then do:
     1299       return .
     1300     end.
     1301   next-prev = no.
     1302   br-handle = BROWSE-AM:handle.
     1303   define variable  doc-rec as recid no-undo .
     1304   do while next-prev <> ?:
     1305     if not available buf_ord-doc then do:
     1306       message "Неправильный выбор документа.".
     1307       return no-apply.
     1308     end.
     1309     find first shar-buf_ord-doc no-lock where recid(shar-buf_ord-doc) = recid(buf_ord-doc) .
     1310     find first buf-or_ord-doc   no-lock where recid(buf-or_ord-doc)   = recid(buf_ord-doc) .
     1311     find first buf-OO_ord-doc   no-lock where recid(buf-OO_ord-doc)   = recid(buf_ord-doc) .
     1312       bf-handle = buffer buf_ord-doc:handle .
     1313       run cus/ord-zakz.p
     1314         ( input  parParentProc ,
     1315           input  'ПРОСМОТР':U ,
     1316           input  buf_ord-doc.doc-type ,
     1317           output doc-rec  ,
     1318           input-output  br-handle ,
     1319           input-output  bf-handle ,
     1320           input-output  next-prev
     1321           ) .
     1322   end.
     1323   if br-handle = ? then reposition BROWSE-AM to recid doc-rec no-error.
     1324   apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1325   END.
     1326   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1327   DO:
     1328     define variable loc#log as logical no-undo .
     1329     if AVAILABLE buf_doc-list  then do:
     1330   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   define variable v-str-recid17 as character no-undo .
     1332   define variable v-num-entry17 as integer   no-undo .
     1333   assign
     1334     v-str-recid17 = trim( string( recid( buf_doc-list ) , "->>>>>>>>>>>9":U ) )
     1335     v-num-entry17 = lookup( v-str-recid17 , p-rid-list )
     1336   .
     1337   if v-num-entry17 > 0 then do:
     1338     assign
     1339       entry( v-num-entry17, p-rid-list ) = "":U
     1340       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1341     .
     1342   end.
     1343   else do:
     1344     assign
     1345       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1346     .
     1347   end.
     1348       loc#log = BROWSE-AM:refresh() .
     1349       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1350           loc#log = BROWSE-AM:select-next-row ().
     1351           apply "VALUE-CHANGED" to BROWSE-AM in frame Dialog-Frame.
     1352       end.
     1353       if num-entries( p-rid-list ) = 0
     1354       then
     1355           hide mark-num in frame Dialog-Frame.
     1356       else
     1357           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1358     end.
     1359     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1360   END.
     1361   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1362   DO:
     1363       run gbl/pop-up.p (self:handle, no) no-error.
     1364       if error-status:error then return no-apply.
     1365   END.
     1366   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1367   DO:
     1368     IF  p-rid-list = "" THEN DO:
     1369         IF AVAILABLE buf_ord-doc THEN p-rid-list = string(RECID(buf_ord-doc)).
     1370     END.
     1371   END.
     1372   ON ROW-DISPLAY OF BROWSE-AM IN FRAME Dialog-Frame
     1373   DO:
     1374   END.
     1375   ON VALUE-CHANGED OF BROWSE-AM IN FRAME Dialog-Frame
     1376   DO:
     1377       v-PS = "" .
     1378       IF AVAILABLE buf_ord-doc THEN DO:
     1379           v-PS = buf_ord-doc.ps.
     1380       END.
     1381           DISPLAY
     1382                v-PS WITH FRAME Dialog-Frame.
     1383   END.
     1384   ON LEAVE OF F-doc-code IN FRAME Dialog-Frame
     1385   or return OF F-doc-code IN FRAME Dialog-Frame
     1386   DO:
     1387    define variable v-recid as recid no-undo .
     1388     ASSIGN f-doc-code .
     1389     find first doc-list where doc-list.doc-code begins f-doc-code no-error .
     1390     if available doc-list then do:
     1391        v-recid = recid( doc-list ) .
     1392         reposition BROWSE-AM to recid v-recid no-error.
     1393         apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1394         apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1395     end.
     1396   END.
     1397   ON CHOOSE OF MENU-ITEM m_print-1
     1398   DO:
     1399    IF AVAILABLE buf_doc-list THEN DO:
     1400        run cus/torg-26.p ( parParentProc , recid(buf_ord-doc) ).
     1401    END.
     1402   END.
     1403   ON CHOOSE OF MENU-ITEM m_print-2
     1404   DO:
     1405     run proc-b-print in this-procedure .
     1406   END.
     1407   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1408   DO:
     1409     assign RS-sts .
     1410     run openbr in this-procedure no-error.
     1411     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1412   END.
     1413   ON VALUE-CHANGED OF RS-type IN FRAME Dialog-Frame
     1414   DO:
     1415     assign
     1416       RS-type
     1417     .
     1418     run openbr in this-procedure no-error.
     1419     if error-status:error  then return no-apply.
     1420   END.
     1421   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1422   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1423   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   on help of frame Dialog-Frame
     1425   do:
     1426     run gbl/app_help.p
     1427       (input this-procedure :file-name
     1428       ,input ''
     1429       ,input ?
     1430       ) no-error.
     1431     if error-status :error then do:
     1432       message
     1433         "Ошибка при вызове помощи"
     1434         error-status :get-message(1)
     1435         view-as alert-box .
     1436     end.
     1437   end.
     1438   run minbtn-set in this-procedure .
     1439   on choose of b-help in frame Dialog-Frame
     1440   do:
     1441     apply "help":u to frame Dialog-Frame .
     1442   end.
     1443   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   procedure minbtn-set :
     1445       do
     1446           on error undo, return error return-value
     1447           :
     1448           define variable ii              as integer       no-undo .
     1449           define variable fh              as widget-handle no-undo .
     1450           define variable hh              as widget-handle no-undo .
     1451           define variable v-h             as handle        extent 4 no-undo .
     1452           define variable v-name-button   as character     no-undo .
     1453           define variable v-help-old-x    as decimal       no-undo .
     1454           define variable v-help-old-y    as decimal       no-undo .
     1455           define variable v-help-old-size as decimal       no-undo .
     1456           define variable v-frame-width   as decimal       no-undo .
     1457           define variable jj              as integer       no-undo .
     1458           do
     1459               on error undo, return error
     1460               :
     1461               assign
     1462                   v-frame-width = frame Dialog-Frame:width - 0.3
     1463                   fh            = frame Dialog-Frame:first-child
     1464                   hh            = fh:first-child
     1465                   ii            = 1
     1466                   .
     1467               do while valid-handle(hh):
     1468                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1469                   do:
     1470                       case lc(hh:name) :
     1471                           when "b-help" then
     1472                               do:
     1473                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1474                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1475                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1476                                   hh:TOOLTIP = "Помощь" .
     1477                                   v-help-old-x = hh:column .
     1478                                   v-help-old-y = hh:row    .
     1479                                   v-help-old-size = hh:width .
     1480                                   hh:width-chars = 2.5 .
     1481                               end.
     1482                           when "b-print" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-print.bmp":u) .
     1485                                   hh:TOOLTIP = "Печать" .
     1486                                   v-h[ii] = hh:handle .
     1487                                   ii = ii + 1 .
     1488                                   hh:width-chars = 3 .
     1489                               end.
     1490                           when "b-history" or
     1491                           when "b-hist" then
     1492                               do:
     1493                                   hh:load-image("cmp/b-hist.bmp":u) .
     1494                                   hh:TOOLTIP = "История" .
     1495                                   v-h[ii] = hh:handle .
     1496                                   ii = ii + 1 .
     1497                                   hh:width-chars = 3 .
     1498                               end.
     1499                           when "b-sch" then
     1500                               do:
     1501                                   hh:load-image("cmp/b-sch.bmp":u) .
     1502                                   hh:TOOLTIP = "Установка Фильтра" .
     1503                                   v-h[ii] = hh:handle .
     1504                                   ii = ii + 1 .
     1505                                   hh:width-chars = 3 .
     1506                               end.
     1507                           when "b-hist-user" then
     1508                               do:
     1509                                   hh:load-image("cmp/b-hist.bmp":u) .
     1510                                   hh:TOOLTIP = "История пользователя" .
     1511                                   ii = ii + 1 .
     1512                               end.
     1513                       end case.
     1514                   end.
     1515                   hh = hh:next-sibling.
     1516               end.
     1517               b-help:column = v-frame-width - b-help:width-chars.
     1518               jj = 0.
     1519               repeat ii = 4 to 1 by -1 :
     1520                   if valid-handle (v-h[ii] ) then
     1521                   do:
     1522                       jj  = jj + 1 .
     1523                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1524                       v-h[ii]:row    = v-help-old-y .
     1525                   end.
     1526               end.
     1527           end.
     1528       end.
     1529   end procedure.
     1530   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1531   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1532   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1533   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1534   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1535   define variable v-diasize-current-frame-height as decimal   no-undo .
     1536   define variable v-diasize-change-size          as logical   no-undo .
     1537   define variable v-diasize-resize-button        as handle    no-undo .
     1538   define variable v-diasize-wndmax               as logical   no-undo .
     1539   define variable v-diasize-wndstore             as logical   no-undo .
     1540   define variable v-diasize-proc-name            as character no-undo .
     1541   define variable v-diasize-browse-handle        as handle    no-undo .
     1542   define variable v-diasize-browse-number        as integer   no-undo .
     1543   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1544   define temp-table temp-diasize-handle no-undo
     1545     field handle-value  as handle
     1546     field save-position as decimal
     1547     index xpk is primary unique handle-value
     1548     .
     1549   define temp-table temp-browse-handle no-undo
     1550     field browse-type   as character
     1551     field browse-number as integer
     1552     field browse-handle as handle
     1553     field original-size as decimal
     1554     index xpk is primary unique browse-type browse-number
     1555     index xie browse-type browse-handle
     1556   .
     1557   procedure diasize_change-height :
     1558     define input  parameter p-change-value  as decimal   no-undo .
     1559     define input  parameter p-move-resize   as logical   no-undo .
     1560     define variable v-field-group-handle    as handle    no-undo .
     1561     define variable v-object-handle         as handle    no-undo .
     1562     define variable v-frame-height          as decimal   no-undo .
     1563     define variable v-frame-virtual-height  as decimal   no-undo .
     1564     define variable v-browse-height         as decimal   no-undo .
     1565     define variable v-window-height         as decimal   no-undo .
     1566     define variable v-window-virtual-height as decimal   no-undo .
     1567     define variable v-change-sign           as integer   no-undo .
     1568     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1569     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1570     if p-change-value > 0
     1571     then do:
     1572       if frame Dialog-Frame :height + p-change-value
     1573           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1574       then do:
     1575         assign
     1576           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1577                           - (frame Dialog-Frame :height-chars)
     1578         .
     1579         if p-change-value <= 0
     1580         then do:
     1581           run diasize_position-resize-button in this-procedure .
     1582           return .
     1583         end.
     1584       end.
     1585     end.
     1586     if p-change-value < 0
     1587     then do:
     1588       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1589       then do:
     1590         assign
     1591           p-change-value = v-diasize-orig-frame-height
     1592                          - (frame Dialog-Frame :height-chars)
     1593         .
     1594         if p-change-value >= 0
     1595         then do:
     1596           run diasize_position-resize-button in this-procedure .
     1597           return .
     1598         end.
     1599       end.
     1600     end.
     1601     if p-change-value >= 0
     1602     then do:
     1603       assign
     1604         v-change-sign = 1
     1605       .
     1606     end.
     1607     else do:
     1608       assign
     1609         v-change-sign = -1
     1610       .
     1611     end.
     1612     assign
     1613       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1614     .
     1615     if p-change-value = 0
     1616     then do:
     1617       run diasize_position-resize-button in this-procedure .
     1618       return .
     1619     end.
     1620     move_block:
     1621     do
     1622     on error undo move_block, retry move_block
     1623     :
     1624       if retry
     1625       then do:
     1626         do
     1627         on error undo move_block, leave move_block
     1628         :
     1629           if p-change-value > 0
     1630           then do:
     1631             for each buf_temp-diasize-handle
     1632             on error undo, next
     1633             :
     1634               assign
     1635                 v-object-handle = buf_temp-diasize-handle.handle-value
     1636               .
     1637               if v-object-handle <> v-diasize-resize-button
     1638               then do:
     1639                 assign
     1640                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1641                 .
     1642               end.
     1643             end.
     1644             assign
     1645               v-diasize-browse-handle :height = v-browse-height
     1646             .
     1647             for each buf_temp-browse-handle
     1648               where buf_temp-browse-handle.browse-type = 'height':u
     1649             on error undo, next
     1650             :
     1651               assign
     1652                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1653               .
     1654             end.
     1655             assign
     1656               frame Dialog-Frame :height = v-frame-height
     1657             .
     1658             if frame Dialog-Frame :scrollable = true
     1659             then do:
     1660               assign
     1661                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1662               .
     1663             end.
     1664             run diasize_position-resize-button in this-procedure .
     1665           end.
     1666           else do:
     1667             if frame Dialog-Frame :scrollable = true
     1668             then do:
     1669               assign
     1670                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1671               .
     1672             end.
     1673             assign
     1674               frame Dialog-Frame :height = v-frame-height
     1675             .
     1676             assign
     1677               v-diasize-browse-handle :height = v-browse-height
     1678             .
     1679             for each buf_temp-browse-handle
     1680               where buf_temp-browse-handle.browse-type = 'height':u
     1681             on error undo, next
     1682             :
     1683               assign
     1684                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1685               .
     1686             end.
     1687             for each buf_temp-diasize-handle
     1688             on error undo, next
     1689             :
     1690               assign
     1691                 v-object-handle = buf_temp-diasize-handle.handle-value
     1692               .
     1693               if v-object-handle <> v-diasize-resize-button
     1694               then do:
     1695                 assign
     1696                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1697                 .
     1698               end.
     1699             end.
     1700             run diasize_position-resize-button in this-procedure .
     1701           end.
     1702           assign
     1703             v-diasize-change-size = false
     1704           .
     1705           leave move_block .
     1706         end.
     1707       end.
     1708       assign
     1709         v-diasize-need-full-display = true
     1710       .
     1711       if v-diasize-change-size = false
     1712       then do:
     1713         assign
     1714           v-diasize-change-size = true
     1715         .
     1716       end.
     1717       else do:
     1718         return .
     1719       end.
     1720       assign
     1721         v-frame-height = frame Dialog-Frame :height
     1722         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1723         v-browse-height = v-diasize-browse-handle :height
     1724       .
     1725       for each buf_temp-browse-handle
     1726         where buf_temp-browse-handle.browse-type = 'height':u
     1727       :
     1728         assign
     1729           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1730         .
     1731       end.
     1732       for each buf_temp-diasize-handle
     1733       :
     1734         delete buf_temp-diasize-handle .
     1735       end.
     1736       assign
     1737         v-field-group-handle = frame Dialog-Frame :first-child
     1738       .
     1739       do while valid-handle(v-field-group-handle)
     1740       :
     1741         assign
     1742           v-object-handle = v-field-group-handle :first-child
     1743         .
     1744         do while valid-handle(v-object-handle)
     1745         :
     1746           if  v-object-handle <> v-diasize-browse-handle :handle
     1747           and can-query(v-object-handle, "row")
     1748           and can-query(v-object-handle, "height")
     1749           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1750           then do:
     1751             find first buf_temp-browse-handle
     1752               where buf_temp-browse-handle.browse-type   = 'height':u
     1753                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1754               no-error .
     1755             if available buf_temp-browse-handle
     1756             then do:
     1757             end.
     1758             else do:
     1759               create buf_temp-diasize-handle .
     1760               assign
     1761                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1762                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1763               .
     1764             end.
     1765           end.
     1766           assign
     1767             v-object-handle = v-object-handle :next-sibling
     1768           .
     1769         end.
     1770         assign
     1771           v-field-group-handle = v-field-group-handle :next-sibling
     1772         .
     1773       end.
     1774       do with frame Dialog-Frame
     1775       :
     1776         hide v-diasize-resize-button .
     1777         assign
     1778           v-diasize-resize-button :row    = 1
     1779           v-diasize-resize-button :column = 1
     1780         .
     1781       end.
     1782       if p-change-value > 0
     1783       then do:
     1784         if frame Dialog-Frame :scrollable = true
     1785         then do:
     1786           assign
     1787             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1788             no-error .
     1789           if error-status :error
     1790           or error-status :get-message(1) <> ""
     1791           then do:
     1792             undo move_block, retry move_block .
     1793           end.
     1794         end.
     1795         assign
     1796           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1797           no-error .
     1798         if error-status :error
     1799         or error-status :get-message(1) <> ""
     1800         then do:
     1801           undo move_block, retry move_block .
     1802         end.
     1803         assign
     1804           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1805           no-error .
     1806         if error-status :error
     1807         or error-status :get-message(1) <> ""
     1808         then do:
     1809           undo move_block, retry move_block .
     1810         end.
     1811         for each buf_temp-browse-handle
     1812           where buf_temp-browse-handle.browse-type = 'height':u
     1813         on error undo move_block, retry move_block
     1814         :
     1815           assign
     1816             buf_temp-browse-handle.browse-handle :height
     1817               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1818             no-error .
     1819           if error-status :error
     1820           or error-status :get-message(1) <> ""
     1821           then do:
     1822             undo move_block, retry move_block .
     1823           end.
     1824         end.
     1825         for each buf_temp-diasize-handle
     1826         on error undo move_block, retry move_block
     1827         :
     1828           assign
     1829             v-object-handle = buf_temp-diasize-handle.handle-value
     1830           .
     1831           if v-object-handle <> v-diasize-resize-button
     1832           then do:
     1833             assign
     1834               v-object-handle :row = v-object-handle :row + p-change-value
     1835               no-error .
     1836             if error-status :error
     1837             or error-status :get-message(1) <> ""
     1838             then do:
     1839               undo move_block, retry move_block .
     1840             end.
     1841           end.
     1842         end.
     1843       end.
     1844       else do:
     1845         for each buf_temp-diasize-handle
     1846         on error undo move_block, retry move_block
     1847         :
     1848           assign
     1849             v-object-handle = buf_temp-diasize-handle.handle-value
     1850           .
     1851           if v-object-handle <> v-diasize-resize-button
     1852           then do:
     1853             assign
     1854               v-object-handle :row = v-object-handle :row + p-change-value
     1855               no-error .
     1856             if error-status :error
     1857             or error-status :get-message(1) <> ""
     1858             then do:
     1859               undo move_block, retry move_block .
     1860             end.
     1861           end.
     1862         end.
     1863         assign
     1864           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1865           no-error .
     1866         if error-status :error
     1867         or error-status :get-message(1) <> ""
     1868         then do:
     1869           undo move_block, retry move_block .
     1870         end.
     1871         for each buf_temp-browse-handle
     1872           where buf_temp-browse-handle.browse-type = 'height':u
     1873         on error undo move_block, retry move_block
     1874         :
     1875           assign
     1876             buf_temp-browse-handle.browse-handle :height
     1877               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1878             no-error .
     1879           if error-status :error
     1880           or error-status :get-message(1) <> ""
     1881           then do:
     1882             undo move_block, retry move_block .
     1883           end.
     1884         end.
     1885         assign
     1886           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1887           no-error .
     1888         if error-status :error
     1889         or error-status :get-message(1) <> ""
     1890         then do:
     1891           undo move_block, retry move_block .
     1892         end.
     1893         if frame Dialog-Frame :scrollable = true
     1894         then do:
     1895           assign
     1896             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1897             no-error .
     1898           if error-status :error
     1899           or error-status :get-message(1) <> ""
     1900           then do:
     1901             undo move_block, retry move_block .
     1902           end.
     1903         end.
     1904       end.
     1905       if p-move-resize = true
     1906       then do:
     1907         run diasize_position-resize-button in this-procedure .
     1908       end.
     1909       if v-diasize-wndstore = true
     1910       then do:
     1911         if connected("ub") = true
     1912         then do:
     1913           define variable v-cntxt-db-num        as integer   no-undo .
     1914           define variable v-cntxt-userid        as character no-undo .
     1915           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1916                                             , OUTPUT v-cntxt-userid
     1917                                             ) .
     1918           run gbl/wndsizew.p
     1919             (input  v-cntxt-db-num
     1920             ,input  v-cntxt-userid
     1921             ,input  v-diasize-proc-name
     1922             ,input  'height':u
     1923             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1924             ) .
     1925         end.
     1926       end.
     1927     end.
     1928     assign
     1929       v-diasize-change-size = false
     1930     .
     1931   end procedure.
     1932   procedure diasize_set-height :
     1933     define input  parameter p-new-height  as decimal   no-undo .
     1934     define input  parameter p-move-resize as logical   no-undo .
     1935     do
     1936     on error undo, return error return-value
     1937     :
     1938       run diasize_change-height in this-procedure
     1939         (input  (p-new-height - frame Dialog-Frame :height)
     1940         ,input  p-move-resize
     1941         ) .
     1942     end.
     1943   end procedure.
     1944   procedure diasize_change-width :
     1945     define input  parameter p-change-value as decimal   no-undo .
     1946     define input  parameter p-move-resize  as logical   no-undo .
     1947     define variable v-field-group-handle   as handle    no-undo .
     1948     define variable v-object-handle        as handle    no-undo .
     1949     define variable v-frame-width          as decimal   no-undo .
     1950     define variable v-frame-virtual-width  as decimal   no-undo .
     1951     define variable v-browse-width         as decimal   no-undo .
     1952     define variable v-window-width         as decimal   no-undo .
     1953     define variable v-window-virtual-width as decimal   no-undo .
     1954     define variable v-change-sign          as integer   no-undo .
     1955     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1956     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1957     if p-change-value > 0
     1958     then do:
     1959       if frame Dialog-Frame :width + p-change-value >
     1960           session :width-chars
     1961       then do:
     1962         assign
     1963           p-change-value = session :width-chars - frame Dialog-Frame :width
     1964         .
     1965         if p-change-value <= 0
     1966         then do:
     1967           run diasize_position-resize-button in this-procedure .
     1968           return .
     1969         end.
     1970       end.
     1971     end.
     1972     if p-change-value < 0
     1973     then do:
     1974       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1975       then do:
     1976         assign
     1977           p-change-value = v-diasize-orig-frame-width
     1978                          - frame Dialog-Frame :width
     1979         .
     1980         if p-change-value >= 0
     1981         then do:
     1982           run diasize_position-resize-button in this-procedure .
     1983           return .
     1984         end.
     1985       end.
     1986     end.
     1987     if p-change-value >= 0
     1988     then do:
     1989       assign
     1990         v-change-sign = 1
     1991       .
     1992     end.
     1993     else do:
     1994       assign
     1995         v-change-sign = -1
     1996       .
     1997     end.
     1998     assign
     1999       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2000     .
     2001     if p-change-value = 0
     2002     then do:
     2003       run diasize_position-resize-button in this-procedure .
     2004       return .
     2005     end.
     2006     move_block:
     2007     do
     2008     on error undo move_block, leave move_block
     2009     :
     2010       if retry
     2011       then do:
     2012         do
     2013         on error undo move_block, leave move_block
     2014         :
     2015           if p-change-value > 0
     2016           then do:
     2017             for each buf_temp-diasize-handle
     2018             on error undo, next
     2019             :
     2020               assign
     2021                 v-object-handle = buf_temp-diasize-handle.handle-value
     2022               .
     2023               if v-object-handle <> v-diasize-resize-button
     2024               then do:
     2025                 assign
     2026                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2027                 .
     2028               end.
     2029             end.
     2030             assign
     2031               v-diasize-browse-handle :width = v-browse-width
     2032             .
     2033             for each buf_temp-browse-handle
     2034               where buf_temp-browse-handle.browse-type = 'width':u
     2035             on error undo, next
     2036             :
     2037               assign
     2038                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2039               .
     2040             end.
     2041             assign
     2042               frame Dialog-Frame :width = v-frame-width
     2043             .
     2044             if frame Dialog-Frame :scrollable = true
     2045             then do:
     2046               assign
     2047                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2048               .
     2049             end.
     2050             run diasize_position-resize-button in this-procedure .
     2051           end.
     2052           else do:
     2053             if frame Dialog-Frame :scrollable = true
     2054             then do:
     2055               assign
     2056                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2057               .
     2058             end.
     2059             assign
     2060               frame Dialog-Frame :width = v-frame-width
     2061             .
     2062             for each buf_temp-browse-handle
     2063               where buf_temp-browse-handle.browse-type = 'width':u
     2064             on error undo, next
     2065             :
     2066               assign
     2067                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2068               .
     2069             end.
     2070             assign
     2071               v-diasize-browse-handle :width = v-browse-width
     2072             .
     2073             for each buf_temp-diasize-handle
     2074             on error undo, next
     2075             :
     2076               assign
     2077                 v-object-handle = buf_temp-diasize-handle.handle-value
     2078               .
     2079               if v-object-handle <> v-diasize-resize-button
     2080               then do:
     2081                 assign
     2082                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2083                 .
     2084               end.
     2085             end.
     2086             run diasize_position-resize-button in this-procedure .
     2087           end.
     2088           assign
     2089             v-diasize-change-size = false
     2090           .
     2091           leave move_block .
     2092         end.
     2093       end.
     2094       assign
     2095         v-diasize-need-full-display = true
     2096       .
     2097       if v-diasize-change-size = false
     2098       then do:
     2099         assign
     2100           v-diasize-change-size = true
     2101         .
     2102       end.
     2103       else do:
     2104         return .
     2105       end.
     2106       assign
     2107         v-frame-width = frame Dialog-Frame :width
     2108         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2109         v-browse-width = v-diasize-browse-handle :width
     2110       .
     2111       for each buf_temp-browse-handle
     2112         where buf_temp-browse-handle.browse-type = 'width':u
     2113       :
     2114         assign
     2115           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2116         .
     2117       end.
     2118       for each buf_temp-diasize-handle
     2119       :
     2120         delete buf_temp-diasize-handle .
     2121       end.
     2122       assign
     2123         v-field-group-handle = frame Dialog-Frame :first-child
     2124       .
     2125       do while valid-handle(v-field-group-handle)
     2126       :
     2127         assign
     2128           v-object-handle = v-field-group-handle :first-child
     2129         .
     2130         do while valid-handle(v-object-handle)
     2131         :
     2132           if  v-object-handle <> v-diasize-browse-handle :handle
     2133           and v-object-handle <> v-diasize-resize-button
     2134           and can-query(v-object-handle, "row")
     2135           and can-query(v-object-handle, "height")
     2136           and ( v-object-handle :col + v-object-handle :width
     2137                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2138               )
     2139           then do:
     2140             find first buf_temp-browse-handle
     2141               where buf_temp-browse-handle.browse-type   = 'width':u
     2142                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2143               no-error .
     2144             if available buf_temp-browse-handle
     2145             then do:
     2146             end.
     2147             else do:
     2148               create buf_temp-diasize-handle .
     2149               assign
     2150                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2151                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2152               .
     2153             end.
     2154           end.
     2155           assign
     2156             v-object-handle = v-object-handle :next-sibling
     2157           .
     2158         end.
     2159         assign
     2160           v-field-group-handle = v-field-group-handle :next-sibling
     2161         .
     2162       end.
     2163       do with frame Dialog-Frame
     2164       :
     2165         hide v-diasize-resize-button .
     2166         v-diasize-resize-button :row = 1.
     2167         v-diasize-resize-button :column = 1.
     2168       end.
     2169       if p-change-value > 0
     2170       then do:
     2171         if frame Dialog-Frame :scrollable = true
     2172         then do:
     2173           assign
     2174             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2175             no-error .
     2176           if error-status :error
     2177           or error-status :get-message(1) <> ""
     2178           then do:
     2179             undo move_block, retry move_block.
     2180           end.
     2181         end.
     2182         assign
     2183           frame Dialog-Frame :width = v-frame-width + p-change-value
     2184           no-error .
     2185         if error-status :error
     2186         or error-status :get-message(1) <> ""
     2187         then do:
     2188           undo move_block, retry move_block.
     2189         end.
     2190         assign
     2191           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2192         no-error .
     2193         if error-status :error
     2194         or error-status :get-message(1) <> ""
     2195         then do:
     2196           undo move_block, retry move_block.
     2197         end.
     2198         for each buf_temp-browse-handle
     2199           where buf_temp-browse-handle.browse-type = 'width':u
     2200         on error undo move_block, retry move_block
     2201         :
     2202           assign
     2203             buf_temp-browse-handle.browse-handle :width
     2204               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2205             no-error .
     2206           if error-status :error
     2207           or error-status :get-message(1) <> ""
     2208           then do:
     2209             undo move_block, retry move_block .
     2210           end.
     2211         end.
     2212         for each buf_temp-diasize-handle
     2213         on error undo move_block, retry move_block
     2214         :
     2215           assign
     2216             v-object-handle = buf_temp-diasize-handle.handle-value
     2217           .
     2218           if v-object-handle <> v-diasize-resize-button
     2219           then do:
     2220             assign
     2221               v-object-handle :col = v-object-handle :col + p-change-value
     2222               no-error .
     2223             if error-status :error
     2224             or error-status :get-message(1) <> ""
     2225             then do:
     2226               undo move_block, retry move_block .
     2227             end.
     2228           end.
     2229         end.
     2230       end.
     2231       else do:
     2232         for each buf_temp-diasize-handle
     2233         on error undo move_block, retry move_block
     2234         :
     2235           assign
     2236             v-object-handle = buf_temp-diasize-handle.handle-value
     2237           .
     2238           if v-object-handle <> v-diasize-resize-button
     2239           then do:
     2240             assign
     2241               v-object-handle :col = v-object-handle :col + p-change-value
     2242               no-error .
     2243             if error-status :error
     2244             or error-status :get-message(1) <> ""
     2245             then do:
     2246               undo move_block, retry move_block .
     2247             end.
     2248           end.
     2249         end.
     2250         for each buf_temp-browse-handle
     2251           where buf_temp-browse-handle.browse-type = 'width':u
     2252         on error undo move_block, retry move_block
     2253         :
     2254           assign
     2255             buf_temp-browse-handle.browse-handle :width
     2256               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2257             no-error .
     2258           if error-status :error
     2259           or error-status :get-message(1) <> ""
     2260           then do:
     2261             undo move_block, retry move_block .
     2262           end.
     2263         end.
     2264         assign
     2265           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2266           no-error .
     2267         if error-status :error
     2268         or error-status :get-message(1) <> ""
     2269         then do:
     2270           undo move_block, retry move_block.
     2271         end.
     2272         assign
     2273           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2274         no-error .
     2275         if error-status :error
     2276         or error-status :get-message(1) <> ""
     2277         then do:
     2278           undo move_block, retry move_block.
     2279         end.
     2280         if frame Dialog-Frame :scrollable = true
     2281         then do:
     2282           assign
     2283             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2284           no-error .
     2285           if error-status :error
     2286           or error-status :get-message(1) <> ""
     2287           then do:
     2288             undo move_block, retry move_block.
     2289           end.
     2290         end.
     2291       end.
     2292       if p-move-resize
     2293       then do:
     2294         run diasize_position-resize-button in this-procedure .
     2295       end.
     2296       if v-diasize-wndstore = true
     2297       then do:
     2298         if connected("ub") = true
     2299         then do:
     2300           define variable v-cntxt-db-num        as integer   no-undo .
     2301           define variable v-cntxt-userid        as character no-undo .
     2302           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2303                                             , OUTPUT v-cntxt-userid
     2304                                             ) .
     2305           run gbl/wndsizew.p
     2306             (input  v-cntxt-db-num
     2307             ,input  v-cntxt-userid
     2308             ,input  v-diasize-proc-name
     2309             ,input  'width':u
     2310             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2311             ) .
     2312         end.
     2313       end.
     2314     end.
     2315     assign
     2316       v-diasize-change-size = false
     2317     .
     2318   end procedure.
     2319   procedure diasize_set-width :
     2320     define input  parameter p-new-width  as decimal   no-undo .
     2321     define input  parameter p-move-resize as logical   no-undo .
     2322     do
     2323     on error undo, return error return-value
     2324     :
     2325       run diasize_change-width in this-procedure
     2326         (input  (p-new-width - frame Dialog-Frame :width)
     2327         ,input  p-move-resize
     2328         ) .
     2329     end.
     2330   end procedure.
     2331   procedure diasize_position-resize-button :
     2332     do with frame Dialog-Frame
     2333     :
     2334       hide v-diasize-resize-button .
     2335       assign
     2336         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2337                     - 1
     2338                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2339         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2340                     - 1
     2341                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2342       .
     2343       view v-diasize-resize-button .
     2344     end.
     2345   end procedure.
     2346   on alt-right anywhere
     2347   do:
     2348     run diasize_change-width in this-procedure
     2349       (input 1
     2350       ,input true
     2351       ) .
     2352     return no-apply .
     2353   end.
     2354   on alt-left anywhere
     2355   do:
     2356     run diasize_change-width in this-procedure
     2357       (input -1
     2358       ,input true
     2359       ) .
     2360     return no-apply .
     2361   end.
     2362   on alt-down anywhere
     2363   do:
     2364     run diasize_change-height in this-procedure
     2365       (input 1
     2366       ,input true
     2367       ) .
     2368     return no-apply .
     2369   end.
     2370   on alt-up anywhere
     2371   do:
     2372     run diasize_change-height in this-procedure
     2373       (input -1
     2374       ,input true
     2375       ) .
     2376     return no-apply .
     2377   end.
     2378   on alt-enter of frame Dialog-Frame
     2379   do:
     2380     run diasize_maximize in this-procedure
     2381       (input  ?
     2382       ).
     2383     return no-apply .
     2384   end.
     2385   procedure diasize_end-move :
     2386     do
     2387     on error undo, return error return-value
     2388     :
     2389       define variable v-row-delta as decimal   no-undo .
     2390       define variable v-col-delta as decimal   no-undo .
     2391       define variable v-new-row as decimal   no-undo .
     2392       define variable v-new-col as decimal   no-undo .
     2393       assign
     2394         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2395         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2396       .
     2397       assign
     2398         v-row-delta = v-new-row - frame Dialog-Frame :height
     2399         v-col-delta = v-new-col - frame Dialog-Frame :width
     2400       .
     2401       run diasize_change-height in this-procedure
     2402         (input v-row-delta
     2403         ,input true
     2404         ) .
     2405       run diasize_change-width in this-procedure
     2406         (input v-col-delta
     2407         ,input true
     2408         ) .
     2409     end.
     2410   end procedure.
     2411   procedure diasize_maximize :
     2412     define input  parameter p-action as logical   no-undo .
     2413     do
     2414     on error undo, return error return-value
     2415     :
     2416       if p-action = ?
     2417       then do:
     2418         if v-diasize-need-maximize = true
     2419         then do:
     2420           assign
     2421             p-action = true
     2422           .
     2423         end.
     2424         else do:
     2425           assign
     2426             p-action = false
     2427           .
     2428         end.
     2429       end.
     2430       if p-action = true
     2431       then do:
     2432         run diasize_change-height in this-procedure
     2433           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2434               - frame Dialog-Frame :height-chars
     2435           ,input true
     2436           ) .
     2437         run diasize_change-width in this-procedure
     2438           (input session :width-chars
     2439               - frame Dialog-Frame :width-chars
     2440           ,input true
     2441           ) .
     2442         assign
     2443           v-diasize-need-maximize = false
     2444         .
     2445       end.
     2446       else do:
     2447         run diasize_change-width in this-procedure
     2448           (input v-diasize-orig-frame-width
     2449               - frame Dialog-Frame :width-chars
     2450           ,input true
     2451           ) .
     2452         run diasize_change-height in this-procedure
     2453           (input v-diasize-orig-frame-height
     2454               - frame Dialog-Frame :height-chars
     2455           ,input true
     2456           ) .
     2457         assign
     2458           v-diasize-need-maximize = true
     2459         .
     2460       end.
     2461     end.
     2462   end procedure.
     2463   procedure diasize_restore-orig-size :
     2464     do
     2465     on error undo, return error return-value
     2466     :
     2467       assign
     2468         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2469         v-diasize-current-frame-height = frame Dialog-Frame :height
     2470       .
     2471       run diasize_set-height in this-procedure
     2472         (input  v-diasize-orig-frame-height
     2473         ,input  true
     2474         ) .
     2475       run diasize_set-width in this-procedure
     2476         (input  v-diasize-orig-frame-width
     2477         ,input  true
     2478         ) .
     2479     end.
     2480   end procedure.
     2481   procedure diasize_restore-current-size :
     2482     do
     2483     on error undo, return error return-value
     2484     :
     2485       run diasize_set-height in this-procedure
     2486         (input  v-diasize-current-frame-height
     2487         ,input  true
     2488         ) .
     2489       run diasize_set-width in this-procedure
     2490         (input  v-diasize-current-frame-width
     2491         ,input  true
     2492         ) .
     2493     end.
     2494   end procedure.
     2495   procedure diasize_set-browse-handle :
     2496     define input  parameter p-browse-handle as handle   no-undo .
     2497     define buffer buf_temp-browse-handle for temp-browse-handle .
     2498     do
     2499     on error undo, return error return-value
     2500     :
     2501       assign
     2502         v-diasize-browse-handle = p-browse-handle
     2503       .
     2504       for each buf_temp-browse-handle
     2505       on error undo, return error return-value
     2506       :
     2507         delete buf_temp-browse-handle .
     2508       end.
     2509     end.
     2510   end procedure.
     2511   procedure diasize_add_browse :
     2512     define input  parameter p-browse-type   as character no-undo .
     2513     define input  parameter p-browse-handle as handle    no-undo .
     2514     define buffer buf_temp-browse-handle for temp-browse-handle .
     2515     do
     2516     on error undo, return error return-value
     2517     :
     2518       assign
     2519         v-diasize-browse-number = v-diasize-browse-number + 1
     2520       .
     2521       create buf_temp-browse-handle .
     2522       assign
     2523         buf_temp-browse-handle.browse-type   = p-browse-type
     2524         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2525         buf_temp-browse-handle.browse-handle = p-browse-handle
     2526       .
     2527     end.
     2528   end procedure.
     2529   procedure diasize_init :
     2530     define variable v-default-value    as logical   no-undo .
     2531     define variable v-restore-saved    as logical   no-undo .
     2532     define variable v-resize-value-str as character no-undo .
     2533     do
     2534     on error undo, return error return-value
     2535     :
     2536       do with frame Dialog-Frame
     2537       :
     2538         assign
     2539           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2540           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2541           v-diasize-browse-handle     = browse BROWSE-AM :handle
     2542         .
     2543         create button v-diasize-resize-button
     2544         assign
     2545           parent        = frame Dialog-Frame :first-child
     2546           label         = "s"
     2547           height-pixels = 16
     2548           width-pixels  = 16
     2549           visible       = true
     2550           sensitive     = true
     2551           movable       = true
     2552           triggers:
     2553             on end-move persistent run diasize_end-move in this-procedure .
     2554           end triggers.
     2555         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2556         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2557         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2558         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2559         assign
     2560           v-diasize-wndmax = false
     2561         .
     2562         if connected("ub") = true
     2563         then do:
     2564           define variable v-cntxt-db-num        as integer   no-undo .
     2565           define variable v-cntxt-userid        as character no-undo .
     2566           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2567                                             , OUTPUT v-cntxt-userid
     2568                                             ) .
     2569           run gbl/wndpar_r.p
     2570             (input  v-cntxt-db-num
     2571             ,input  v-cntxt-userid
     2572             ,input  'wndmax':U
     2573             ,output v-diasize-wndmax
     2574             ,output v-default-value
     2575             ) .
     2576         end.
     2577         assign
     2578           v-diasize-wndstore = false
     2579         .
     2580         if connected("ub") = true
     2581         then do:
     2582           run gbl/wndpar_r.p
     2583             (input  v-cntxt-db-num
     2584             ,input  v-cntxt-userid
     2585             ,input  'wndstore':U
     2586             ,output v-diasize-wndstore
     2587             ,output v-default-value
     2588             ) .
     2589         end.
     2590         assign
     2591           v-diasize-proc-name = entry(1, program-name(2), '.')
     2592         .
     2593         if v-diasize-wndstore = true
     2594         then do:
     2595           assign
     2596             v-restore-saved = false
     2597           .
     2598           if connected("ub") = true
     2599           then do:
     2600             run gbl/wndsizer.p
     2601               (input  v-cntxt-db-num
     2602               ,input  v-cntxt-userid
     2603               ,input  v-diasize-proc-name
     2604               ,input  'height':u
     2605               ,output v-resize-value-str
     2606               ) .
     2607             if v-resize-value-str <> '':U
     2608             then do:
     2609               run diasize_change-height in this-procedure
     2610                 (input  integer(v-resize-value-str)
     2611                 ,input  true
     2612                 ) .
     2613               assign
     2614                 v-restore-saved = true
     2615               .
     2616             end.
     2617           end.
     2618           if connected("ub") = true
     2619           then do:
     2620             run gbl/wndsizer.p
     2621               (input  v-cntxt-db-num
     2622               ,input  v-cntxt-userid
     2623               ,input  v-diasize-proc-name
     2624               ,input  'width':u
     2625               ,output v-resize-value-str
     2626               ) .
     2627             if v-resize-value-str <> '':U
     2628             then do:
     2629               run diasize_change-width in this-procedure
     2630                 (input  integer(v-resize-value-str)
     2631                 ,input  true
     2632                 ) .
     2633               assign
     2634                 v-restore-saved = true
     2635               .
     2636             end.
     2637           end.
     2638           if v-restore-saved <> true
     2639           then do:
     2640             if v-diasize-wndmax = true
     2641             then do:
     2642               run diasize_maximize in this-procedure
     2643                 (input  true
     2644                 ) .
     2645             end.
     2646           end.
     2647         end.
     2648         else do:
     2649           if v-diasize-wndmax = true
     2650           then do:
     2651             run diasize_maximize in this-procedure
     2652               (input  true
     2653               ) .
     2654           end.
     2655         end.
     2656       end.
     2657     end.
     2658   end procedure.
     2659   procedure diasize_need-full-display :
     2660     define output parameter p-need-full-display as logical   no-undo .
     2661     do
     2662     on error undo, return error return-value
     2663     :
     2664       assign
     2665         p-need-full-display = v-diasize-need-full-display
     2666       .
     2667       assign
     2668         v-diasize-need-full-display = false
     2669       .
     2670     end.
     2671   end procedure.
     2672   procedure get-context :
     2673      define output parameter p-db-num as integer          no-undo.
     2674      define output parameter p-user-id as character        no-undo.
     2675      define variable v-login               as character    no-undo.
     2676      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2677      define buffer buf_user-login  for ub.user-login .
     2678      do
     2679      on error undo, return error
     2680      :
     2681            FIND FIRST buf_sys-ctrl no-lock.
     2682            ASSIGN
     2683               v-login = USERID("ub")
     2684               p-db-num = buf_sys-ctrl.db-num
     2685            .
     2686            FIND FIRST buf_user-login
     2687                 WHERE buf_user-login.db-num = p-db-num
     2688                   AND buf_user-login.user-login = v-login
     2689                 no-lock
     2690                 no-error
     2691                 .
     2692            IF AVAILABLE buf_user-login
     2693            THEN DO:
     2694               assign
     2695                  p-user-id = buf_user-login.user-id
     2696               .
     2697            END.
     2698      end.
     2699   end procedure.
     2700       run diasize_init in this-procedure .
     2701   def var sort-labelBROWSE-AM   as character no-undo .
     2702   def var sort-clmnBROWSE-AM    as handle    no-undo .
     2703   def var cur-clmnBROWSE-AM     as handle    no-undo .
     2704   def var cur-clmn-locBROWSE-AM as integer   no-undo .
     2705   def var re-queryBROWSE-AM     as logical   initial no no-undo .
     2706   on start-search, ctrl-o of BROWSE-AM in frame Dialog-Frame do:
     2707      run sort-brBROWSE-AM
     2708        (input (if available buf_ord-doc
     2709                then recid(buf_ord-doc)
     2710                else ?
     2711               )
     2712        ).
     2713   end.
     2714   PROCEDURE sort-brBROWSE-AM :
     2715     define input parameter p-recid as recid no-undo .
     2716     if re-queryBROWSE-AM = no then do:
     2717       assign
     2718          cur-clmnBROWSE-AM = BROWSE-AM:current-column in frame Dialog-Frame
     2719       .
     2720       if sort-clmnBROWSE-AM <> ? then sort-clmnBROWSE-AM:column-fgcolor = 0.
     2721       if cur-clmnBROWSE-AM = sort-clmnBROWSE-AM then do:
     2722         assign
     2723            sort-labelBROWSE-AM = ""
     2724            sort-clmnBROWSE-AM = ?
     2725         .
     2726        end.
     2727        else do:
     2728          assign
     2729            sort-labelBROWSE-AM = cur-clmnBROWSE-AM:label
     2730            sort-clmnBROWSE-AM  = cur-clmnBROWSE-AM
     2731            sort-clmnBROWSE-AM:column-fgcolor = 4
     2732          .
     2733        end.
     2734      end.
     2735     assign
     2736       cur-clmn-locBROWSE-AM = 1
     2737     .
     2738     def var column-handle as handle no-undo .
     2739     column-handle = BROWSE-AM:first-column.
     2740     do while valid-handle(column-handle) :
     2741       if column-handle = cur-clmnBROWSE-AM then do:
     2742         leave .
     2743       end.
     2744       column-handle = column-handle:NEXT-COLUMN.
     2745       assign
     2746         cur-clmn-locBROWSE-AM = cur-clmn-locBROWSE-AM + 1
     2747       .
     2748     end.
     2749     case sort-labelBROWSE-AM:
     2750           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_ord-doc) , &1&2&1 ) ' , chr(34) , p-rid-list)     .     run OpenBr.   . END.
     2751           when 'Номер'  then DO:    assign       sort-column-name = "buf_ord-doc.doc-code"     .     run OpenBr.   . END.
     2752           when 'Тип'  then DO:    assign       sort-column-name = "buf_ord-doc.doc-type"     .     run OpenBr.   . END.
     2753           when 'Статус'  then DO:    assign       sort-column-name = "buf_ord-doc.status_"     .     run OpenBr.   . END.
     2754           when 'Дата'  then DO:    assign       sort-column-name = "buf_ord-doc.doc-date"     .     run OpenBr.   . END.
     2755           when 'Объект'  then DO:    assign       sort-column-name = "buf_ord-doc.obj-type + ' ' + string(buf_ord-doc.obj-code)"     .     run OpenBr.   . END.
     2756           when 'Контрагент'  then DO:    assign       sort-column-name = "buf_ord-doc.cli-type + ' ' + string(buf_ord-doc.cli-code)"     .     run OpenBr.   . END.
     2757           when 'Доставка'  then DO:    assign       sort-column-name = "buf_ord-doc.ship-date"     .     run OpenBr.   . END.
     2758           when 'Время'  then DO:    assign       sort-column-name = "string(buf_ord-doc.ship-time, 'hh:mm')"     .     run OpenBr.   . END.
     2759           when 'Для продажи с'  then DO:    assign       sort-column-name = "buf_ord-doc.date-sale-1"     .     run OpenBr.   . END.
     2760           when ' - по'  then DO:    assign       sort-column-name = "buf_ord-doc.date-sale-2"     .     run OpenBr.   . END.
     2761       otherwise do:
     2762         assign
     2763           sort-column-name = ""
     2764         .
     2765         run OpenBr.
     2766         if sort-labelBROWSE-AM <> "" then do:
     2767           assign
     2768             cur-clmnBROWSE-AM:column-fgcolor = 0
     2769           .
     2770         end.
     2771         assign
     2772           cur-clmn-locBROWSE-AM = ?
     2773         .
     2774       end.
     2775     end case.
     2776     if p-recid <> ? then do:
     2777       reposition BROWSE-AM to recid p-recid no-error.
     2778       apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     2779     end.
     2780     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     2781   END PROCEDURE.
     2782   procedure re-open-query-srt-clmnBROWSE-AM:
     2783   if cur-clmnBROWSE-AM = ? then do:
     2784      run OpenBr.
     2785   end.
     2786   else do:
     2787      assign re-queryBROWSE-AM = yes.
     2788      run sort-brBROWSE-AM
     2789        (input (if available buf_ord-doc
     2790                then recid(buf_ord-doc)
     2791                else ?
     2792               )
     2793        ).
     2794      assign re-queryBROWSE-AM = no.
     2795   end.
     2796   end.
     2797   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2798   do:
     2799     BROWSE-AM :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2800   end.
     2801   MAIN-BLOCK:
     2802   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2803      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2804     run my_enable in this-procedure .
     2805     HIDE mark-num in frame Dialog-Frame .
     2806     if v-doc-rec <> ? then
     2807     REPOSITION BROWSE-AM to recid v-doc-rec No-ERROR.
     2808   ASSIGN b-print:POPUP-MENU IN FRAME Dialog-Frame = MENU m-print:HANDLE.
     2809   ASSIGN b-print:MENU-MOUSE = 1.
     2810     WAIT-FOR GO OF FRAME Dialog-Frame.
     2811   END.
     2812   run disable_ui in this-procedure .
     2813   PROCEDURE disable_UI :
     2814     HIDE FRAME Dialog-Frame.
     2815   END PROCEDURE.
     2816   PROCEDURE enable_UI :
     2817     DISPLAY RS-sts RS-type F-doc-code v-PS mark-num FILL-IN-1 FILL-IN-2
     2818         WITH FRAME Dialog-Frame.
     2819     ENABLE b-quit B-mark B-sel B-lookup B-del B-close B-print B-Help RS-sts
     2820            RS-type F-doc-code BROWSE-AM v-PS B-add B-chg mark-num FILL-IN-1
     2821            FILL-IN-2
     2822         WITH FRAME Dialog-Frame.
     2823     VIEW FRAME Dialog-Frame.
     2824     OPEN QUERY BROWSE-AM FOR EACH     buf_doc-list ,            EACH buf_ord-doc NO-LOCK WHERE buf_ord-doc.doc-code = buf_doc-list.doc-code .
     2825   END PROCEDURE.
     2826   PROCEDURE my_enable :
     2827   buf_ord-doc.doc-code:read-only in browse BROWSE-AM = true .
     2828   ASSIGN
     2829   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2830             "Все" + chr(44) + 'все':U            + chr(44) +
     2831   'новый':U        + chr(44) + 'новый':U        + chr(44) +
     2832   'запрос':U        + chr(44) + 'запрос':U        + chr(44) +
     2833   'распределение':U      + chr(44) + 'распределение':U      + chr(44) +
     2834   'согласование':U     + chr(44) + 'согласование':U     + chr(44) +
     2835   'отказ':U  + chr(44) + 'отказ':U  + chr(44) +
     2836   'поставка':U        + chr(44) + 'поставка':U        + chr(44) +
     2837   'закрыто':U      + chr(44) + 'закрыто':U
     2838   .
     2839   rs-type:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2840                 "Все" + chr(44) + 'все':U + chr(44) +
     2841               'Фирма-Поставщик':U + chr(44) +   'ФП':U + chr(44) +
     2842               'Объект-Фирма':U + chr(44) +   'ОФ':U + chr(44) +
     2843               'Объект-Поставщик':U + chr(44) +   'ОП':U + chr(44) +
     2844               'Объект-РЦ':U + chr(44) +   'ОР':U + chr(44) +
     2845               'Объект-Объект':U + chr(44) +   'ОО':U
     2846   .
     2847   rs-sts = 'все':U .
     2848   rs-type = 'все':U .
     2849   DISPLAY mark-num
     2850   FILL-IN-1
     2851   FILL-IN-2
     2852   RS-sts
     2853   RS-type
     2854   WITH FRAME Dialog-Frame.
     2855   hide B-chg B-add in frame Dialog-Frame .
     2856   ENABLE
     2857   b-quit
     2858   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2859   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2860   B-lookup
     2861   B-del
     2862   B-print
     2863   B-Help
     2864   b-close
     2865   BROWSE-AM
     2866   mark-num
     2867   RS-sts
     2868   RS-type
     2869   f-doc-code
     2870   with FRAME Dialog-Frame.
     2871   VIEW FRAME Dialog-Frame.
     2872   run openbr in this-procedure no-error.
     2873   if error-status:error  then return error.
     2874   END PROCEDURE.
     2875   PROCEDURE openBr :
     2876   define variable  p-open-query       as logical   no-undo init true .
     2877   define variable  l-query-was-opened as logical no-undo .
     2878   define variable  doc-rec            as recid     no-undo .
     2879   define variable  p-find-next        as logical   no-undo .
     2880   define variable  p-find-condition   as character no-undo .
     2881   ASSIGN  FRAME Dialog-Frame
     2882     rs-sts
     2883     rs-type
     2884       .
     2885   ASSIGN
     2886     p-sts = (IF rs-sts = 'все':U THEN ? ELSE rs-sts)
     2887     v-type = (IF rs-type = 'все':U THEN ? ELSE rs-type)
     2888     .
     2889   define variable sort-column-phrase as character no-undo .
     2890   case sort-column-name :
     2891     when "" then do:
     2892       assign
     2893         sort-column-phrase = ""
     2894       .
     2895     end.
     2896     otherwise do:
     2897       assign
     2898         sort-column-phrase = "by " + sort-column-name
     2899       .
     2900     end.
     2901   end case.
     2902   define variable title0 as character no-undo init "Список открытых заказов по отобранным товарам ".
     2903   if v-type = ? then do:
     2904       if p-sts = ? then do:
     2905           frame Dialog-Frame:TITLE = title0  .
     2906   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2907   define variable  l-disable-where-23  as logical   no-undo .
     2908   define variable  l-filter-open-23    as logical   .
     2909   define variable  flt-rec-23       as recid     no-undo .
     2910   define variable  filter-name-23      as character no-undo .
     2911   define variable  where-phrase-23     as character no-undo .
     2912   define variable  sort-phrase-23      as character no-undo .
     2913   define variable  where-phrase-rus-23 as character no-undo .
     2914   define variable  sort-phrase-rus-23  as character no-undo .
     2915     run waitfram-show in this-procedure
     2916       (input "ЖДИТЕ ..."
     2917       ).
     2918   run gbl/flt-get.p
     2919     (input filter-point
     2920     ,output flt-rec-23
     2921     ,output filter-name-23
     2922     ,output where-phrase-23
     2923     ,output sort-phrase-23
     2924     ,output where-phrase-rus-23
     2925     ,output sort-phrase-rus-23
     2926     ).
     2927   if p-open-query then do:
     2928     assign
     2929       l-filter-open-23 = false
     2930     .
     2931     if flt-rec-23 <> ?
     2932       or sort-column-phrase > ""
     2933     then do:
     2934       define variable  parameter-2-23 as character no-undo .
     2935       define variable  parameter-3-23 as character no-undo .
     2936       define variable  parameter-4-23 as character no-undo .
     2937       define variable  parameter-5-23 as character no-undo .
     2938       define variable  parameter-6-23 as character no-undo .
     2939       define variable  parameter-7-23 as character no-undo .
     2940         assign
     2941         parameter-3-23 =
     2942                                 "FOR EACH buf_doc-list"
     2943         parameter-4-23 =
     2944           (
     2945             if (" " + " " + where-phrase-23) <> ""
     2946             then  'yes'  + " " + where-phrase-23
     2947             else "true"
     2948           )
     2949         parameter-5-23 = (" " + "" + " " + ", EACH buf_ord-doc NO-LOCK  where buf_ord-doc.doc-code = buf_doc-list.doc-code")
     2950         parameter-6-23 = if sort-phrase-23 = ''
     2951                              then
     2952           (
     2953           " " + " " +
     2954             " " + sort-column-phrase +
     2955           " " + " "
     2956           )
     2957                              else
     2958           (
     2959           " " + " " +
     2960             " " + sort-column-phrase +
     2961           " " + sort-phrase-23
     2962           )
     2963         parameter-7-23 =
     2964           "   "
     2965       .
     2966       do
     2967       on stop undo, leave
     2968       on error undo, leave
     2969       :
     2970         assign
     2971           l-disable-where-23 =
     2972             (" " + " " + where-phrase-23 = "")
     2973         .
     2974         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2975                             ,input query BROWSE-AM:handle
     2976                             ,input parameter-3-23
     2977                             ,input parameter-4-23
     2978                             ,input parameter-5-23
     2979                             ,input parameter-6-23
     2980                             ,input parameter-7-23
     2981                             )
     2982         .
     2983         assign
     2984           l-filter-open-23 = true
     2985         .
     2986       end.
     2987       if l-filter-open-23 = false then do:
     2988         message
     2989           "Ошибка при фильтрации / сортировке" skip
     2990           "Будут показаны записи без учета фильтра" skip
     2991           view-as alert-box .
     2992       end.
     2993       else do:
     2994           assign
     2995             l-query-was-opened = true
     2996           .
     2997       end.
     2998     end.
     2999     if l-filter-open-23 = false then do:
     3000       OPEN QUERY BROWSE-AM  FOR EACH buf_doc-list
     3001       , EACH buf_ord-doc NO-LOCK  where buf_ord-doc.doc-code = buf_doc-list.doc-code
     3002     .
     3003         assign
     3004           l-query-was-opened = true
     3005         .
     3006     end.
     3007   end.
     3008   else do:
     3009     assign
     3010       doc-rec = recid( buf_doc-list )
     3011     .
     3012     do
     3013     on stop undo, leave
     3014     on error undo, leave
     3015     :
     3016       if query BROWSE-AM:handle:get-buffer-handle(1) = (buffer buf_doc-list:handle) then do:
     3017         assign
     3018         parameter-2-23 = (if p-find-next then "true":u else "false":u )
     3019         parameter-4-23 =
     3020           "where ":u +  'yes'  + " ":u + where-phrase-23 + " ":u + p-find-condition + " " + ""
     3021         parameter-5-23 = " "
     3022       .
     3023         run fltopend_fltfindd in this-procedure  (
     3024                             input this-procedure:handle
     3025                             ,input query BROWSE-AM:handle
     3026                             ,input rowid(buf_doc-list)
     3027                             ,input logical(parameter-2-23)
