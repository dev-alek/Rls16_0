      879   FUNCTION mark-string RETURNS CHARACTER
      880     ( input p-recid as recid, input mark-list as character  ) :
      881     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
