     3648   PROCEDURE proc-b-close :
     3649   define variable loc-doc-rec as recid no-undo .
     3650   define variable v-log as logical   no-undo .
     3651   if not available buf_ord-doc then return.
     3652     loc-doc-rec = recid(buf_ord-doc).
     3653     run cus/ord-clos.p (
     3654         input parParentProc  ,
     3655         input loc-doc-rec    ,
     3656         input v-cntxt-obj-type ,
     3657         input v-cntxt-obj-code ,
     3658         input g#db-num        ,
     3659         input false           ,
     3660         input  "no"            )
     3661         no-error .
     3662     if error-status:error then do:
     3663        message
     3664          error-status :get-message(1) skip
     3665          return-value skip
     3666          ""
     3667          view-as alert-box error
     3668        .
     3669        undo, return error.
     3670     end.
     3671     run openbr in this-procedure .
     3672     reposition BROWSE-AM to recid loc-doc-rec no-error.
     3673     if available buf_ord-doc then do:
     3674       v-log = BROWSE-AM:select-focused-row( ) in frame Dialog-Frame.
     3675     end.
     3676     apply "ENTRY" to BROWSE-AM.
     3677   END PROCEDURE.
     3678   PROCEDURE proc-b-del :
     3679   do
     3680   on error undo, return error
     3681   on stop undo, return error
     3682   :
     3683   define variable loc#log as logical no-undo.
     3684   define variable v-sts like ub.ord-doc.status_ no-undo .
     3685   define variable loc-doc-rec as recid no-undo.
     3686   define variable g#log as logical   no-undo .
     3687   if not available buf_ord-doc then return error.
     3688   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3689   do:
     3690     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3691       (input  v-cntxt-db-num
     3692       ,input  v-cntxt-userid
     3693       ,input  0
     3694       ,input  'actn_pmnt-ord-doc_deletion':U
     3695       ,input  'object':U
     3696       ,input  v-cntxt-host-code-obj
     3697       ,input  v-cntxt-obj-type
     3698       ,input  v-cntxt-obj-code
     3699       ,input  0
     3700       ,input  0
     3701       ,input  0
     3702       ,input  true
     3703       ,output loc#log
     3704       )  .
     3705   end.
     3706   if not loc#log then return error.
     3707       find current buf_ord-doc exclusive-lock .
     3708       if error-status :error then return .
     3709       if buf_ord-doc.status_ <> 'новый':U  then do:
     3710         message "Заказ в статусе" buf_ord-doc.status_ "удалять нельзя! " view-as alert-box error .
     3711         return .
     3712       end.
     3713       g#log = no.
     3714       message "Удалить документ №" buf_ord-doc.doc-code  " из базы данных ?   Вы уверены ?"
     3715                       view-as alert-box question buttons OK-Cancel update g#log.
     3716       if g#log then do:
     3717         delete buf_ord-doc no-error .
     3718       end.
     3719     if error-status:error then undo, return error.
     3720     run openbr in this-procedure .
     3721     reposition BROWSE-AM to recid loc-doc-rec no-error.
     3722     if available buf_ord-doc then do:
     3723       loc#log = BROWSE-AM:select-focused-row( ) in frame Dialog-Frame.
     3724     end.
     3725     apply "ENTRY" to BROWSE-AM.
     3726   end.
     3727   END PROCEDURE.
     3728   PROCEDURE proc-b-print :
     3729   define variable v-doc-rec   as recid     no-undo .
     3730   define variable accum-count as integer   no-undo .
     3731   define variable date_string as character no-undo .
     3732   define variable Line        as character no-undo .
     3733   define variable v-st        as character no-undo .
     3734   DEFINE FRAME buf_ord-doc-list
     3735         buf_ord-doc.doc-code  COLUMN-LABEL 'Номер' FORMAT "X(14)":U
     3736         buf_ord-doc.doc-type  COLUMN-LABEL 'Тип' FORMAT "X(3)":U
     3737         buf_ord-doc.status_   COLUMN-LABEL 'Статус' FORMAT "X(8)":U
     3738         buf_ord-doc.doc-date  COLUMN-LABEL 'Дата' FORMAT "99/99/99":U
     3739         v-obj                 COLUMN-LABEL 'Объект' FORMAT  "X(10)":U
     3740         v-cli                 COLUMN-LABEL 'Контрагент' FORMAT  "X(10)":U
     3741         buf_ord-doc.ship-date COLUMN-LABEL 'Доставка' FORMAT  "99/99/99":U
     3742         v-st                  COLUMN-LABEL 'Время' FORMAT  "X(5)":U
     3743         buf_ord-doc.date-sale-1 COLUMN-LABEL 'Для продажи с' FORMAT  "99/99/99":U
     3744         buf_ord-doc.date-sale-2 COLUMN-LABEL ' - по' FORMAT  "99/99/99":U
     3745   HEADER  date_string AT 5 format "X(35)"
     3746    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3747   Line format "X(195)" AT 1
     3748   with width 232 down stream-io use-text    .
     3749   Line = fill("-", 195).
     3750   date_string = cur-time-print() .
     3751   run prn-lib-open-stream  in this-procedure (
     3752                             input parParentProc
     3753                           ,input 43
     3754                           ,input yes
     3755                           ,input no
     3756                           ).
     3757   PUT  STREAM PrnLibStream
     3758   SPACE(25) ( frame Dialog-Frame:title )
     3759   format "x(90)" SKIP(1) .
     3760   FORM HEADER
     3761   Line format "X(195)" AT 1 SKIP
     3762   "Продолжение - на следующей странице" AT 30 SKIP
     3763   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3764   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3765   FORM with FRAME buf_ord-doc-list  .
     3766   run waitfram-show in this-procedure ("Ждите...").
     3767   v-doc-rec = recid(buf_ord-doc).
     3768   DO WHILE available buf_ord-doc :
     3769     GET prev BROWSE-AM.
     3770   END.
     3771   GET next BROWSE-AM.
     3772   DO WHILE available buf_ord-doc :
     3773     Display STREAM PrnLibStream
     3774         buf_ord-doc.doc-code
     3775         buf_ord-doc.doc-type
     3776         buf_ord-doc.status_
     3777         buf_ord-doc.doc-date
     3778         buf_ord-doc.obj-type + ' ' + string(buf_ord-doc.obj-code)  @ v-obj
     3779         buf_ord-doc.cli-type + ' ' + string(buf_ord-doc.cli-code)  @ v-cli
     3780         buf_ord-doc.ship-date
     3781          string(buf_ord-doc.ship-time, "hh:mm") @ v-st
     3782          buf_ord-doc.date-sale-1
     3783          buf_ord-doc.date-sale-2
     3784   with FRAME buf_ord-doc-list .
     3785     DOWN STREAM PrnLibStream 1
     3786     with FRAME buf_ord-doc-list  .
     3787     assign
     3788     accum-count = accum-count + 1
     3789     .
     3790     GET next BROWSE-AM.
     3791   END.
     3792   UNDERLINE  STREAM PrnLibStream
     3793         buf_ord-doc.doc-code
     3794         buf_ord-doc.doc-type
     3795         buf_ord-doc.status_
     3796         buf_ord-doc.doc-date
     3797         v-obj
     3798         v-cli
     3799         buf_ord-doc.ship-date
     3800         v-st
     3801         buf_ord-doc.date-sale-1
     3802         buf_ord-doc.date-sale-2
     3803   with frame buf_ord-doc-list .
     3804   display stream prnlibstream
     3805   with frame buf_ord-doc-list.
     3806   hide  stream prnlibstream frame bottomframe .
     3807   hide  stream prnlibstream frame buf_ord-doc-list.
     3808   output  stream prnlibstream close.
     3809   reposition BROWSE-AM to recid v-doc-rec no-error.
     3810   apply "ENTRY" to BROWSE-AM.
     3811   run waitfram-hide in this-procedure .
     3812   run prn-lib-prn-file in this-procedure
     3813       ( input parParentProc
     3814        ,input 8
     3815       ).
     3816   END PROCEDURE.
     3817   PROCEDURE proc-br :
     3818   END PROCEDURE.
