      377   define new global shared variable g#vssrevis-logger as handle    no-undo .
      378   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      379   define variable v-vssrevis-logger                   as handle    no-undo .
      380   procedure vss-logevent :
      381     define input  parameter p-extra-paramters as character no-undo .
      382     define variable v-vssrevis-parameters as character no-undo .
      383     do
      384     on error undo, return error return-value
      385     :
      386       if  valid-handle(v-vssrevis-logger)
      387       and v-vssrevis-logger :get-signature("logevent") <> ""
      388       then do:
      389         run vss-get-parameters in this-procedure
      390           (output v-vssrevis-parameters
      391           ).
      392         run logevent in v-vssrevis-logger
      393           (input vss-workfile
      394           ,input vss-revision
      395           ,input v-vssrevis-parameters
      396           ,input p-extra-paramters
      397           ).
      398       end.
      399     end.
      400   end procedure.
      401   assign
      402     v-vssrevis-logger = g#vssrevis-logger
      403   .
      404   if  valid-handle(v-vssrevis-logger)
      405   and v-vssrevis-logger :get-signature("logevent") <> ""
      406   then do:
      407     assign
      408       v-vssrevis-logevent = true
      409     .
      410     run vss-logevent in this-procedure (input vss-description) .
      411   end.
      412   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   define temp-table temp-schedule-free no-undo
      414   field free-id as character
