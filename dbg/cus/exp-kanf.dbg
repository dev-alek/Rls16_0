     1342           save-as
     1343           use-filename
     1344           update ll_commit1
     1345           default-extension "txt"
     1346           .
     1347       IF ll_commit1 <> YES THEN do:
     1348          RETURN NO-APPLY.
     1349       end.
     1350       IF v_os-file1 = PROGRAM-NAME( 1 ) THEN DO:
     1351           BELL.
     1352           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1353           RETURN NO-APPLY.
     1354       END.
     1355       ASSIGN fnrasvn = ( IF SEARCH( v_os-file1 ) = ? THEN   v_os-file1  ELSE SEARCH( v_os-file1 ) ).
