        1    define variable vss-revision    as character no-undo init "$Revision$":U .
        2    define variable vss-author      as character no-undo init "$Author$":U .
        3    define variable vss-date        as character no-undo init "$Date$":U .
        4    define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5    define variable vss-archive     as character no-undo init "$Archive$":U .
        6    define variable vss-description as character no-undo init "Экспорт текущих остатков, товарных накладных, внешних расходных накладных ".
        7     define variable v-param-type                as character    no-undo.
        8   define input parameter parparentproc as widget-handle no-undo .
        9   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
       10   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
       11   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
       12   define input PARAMETER p-mode           AS CHARACTER NO-UNDO.
       13   define input parameter p-db-num-char    as character    no-undo.
       14   define input parameter p-task-type      as character    no-undo.
       15   define input parameter p-task-num       as integer      no-undo.
       16   define input parameter p-action         as character    no-undo.
       17   define output parameter p-cancel        as logical      no-undo.
       18   define output parameter p-params        as character    no-undo.
       19     DEFINE BUFFER tt0-rp-by-call FOR rp-by-call.
       20   DEFINE TEMP-TABLE tt0-rule-by-call NO-UNDO LIKE rule-by-call.
       21   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE rule-call-param.
       22   DEFINE BUFFER X_dis-card-type FOR dis-card-type.
