      428   procedure schedule-attr-name :
      429   do
      430     on error undo, return error
      431     :
      432     define input  parameter p-code           as character no-undo .
      433     define output parameter p-type           as character no-undo .
      434     define output parameter p-format         as character no-undo .
      435     define output parameter p-label          as character no-undo .
      436     define output parameter p-user-can-edit  as logical   no-undo .
      437     define output parameter p-output-display as logical   no-undo .
      438     define output parameter p-other          as character no-undo .
      439       if index(p-code, chr(4)) > 0 then do:
      440         p-code = entry(1, p-code, chr(4)).
      441       end.
      442       case p-code :
      443               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      444               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      445               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      446               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      447               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      448               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      449               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      450               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      451               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      452         otherwise do:
      453           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      454         end.
      455       end.
      456     end.
      457   end procedure.
      458   procedure schedule-attr-tooltip :
      459   do
      460     on error undo, return error
      461     :
      462       define input  parameter p-code    as character no-undo .
      463       define output parameter p-tooltip as character no-undo .
      464       define output parameter p-label   as character no-undo .
      465       if index(p-code, chr(4)) > 0 then do:
      466         p-code = entry(1, p-code, chr(4)).
      467       end.
      468       case p-code :
      469               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      470               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      471               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      472               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      473               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      474               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      475               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      476               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      477               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      478         otherwise do:
      479               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      480         end.
      481       end.
      482     end.
      483   end procedure.
      484   procedure schedule-attr-value :
      485   do
      486   on error undo, return error return-value
      487   :
      488   define input parameter  p-cre-db-num as integer    no-undo.
      489   define input parameter  p-task-type  as character  no-undo.
      490   define input parameter  p-task-num   as integer    no-undo.
      491   define input parameter  p-code       as character  no-undo.
      492   define output parameter p-value      as character  no-undo.
      493   define output parameter p-type       as character  no-undo.
      494       define variable v-format         as character no-undo .
      495       define variable v-label          as character no-undo .
      496       define variable v-user-can-edit  as logical   no-undo .
      497       define variable v-output-display as logical   no-undo .
      498       define variable v-other          as character no-undo .
      499       define buffer buf_schedule-attr for ub.schedule-attr.
      500       run schedule-attr-name in this-procedure (
      501             input  p-code
      502           , output p-type
      503           , output v-format
      504           , output v-label
      505           , output v-user-can-edit
      506           , output v-output-display
      507           , output v-other
      508       ) no-error .
      509       if error-status :error
      510       then do:
      511           undo, return error return-value .
      512       end.
      513       if p-code begins ('schd-free-id':U + chr(4))
      514       and entry(2, p-code, chr(4)) = '':U then do:
      515         find first buf_schedule-attr no-lock
      516             where buf_schedule-attr.cre-db-num = p-cre-db-num
      517               and buf_schedule-attr.task-type  = p-task-type
      518               and buf_schedule-attr.task-num   = p-task-num
      519               and buf_schedule-attr.attr-code  begins p-code
      520         no-error .
      521       end.
      522       else do:
      523         find first buf_schedule-attr no-lock
      524             where buf_schedule-attr.cre-db-num = p-cre-db-num
      525               and buf_schedule-attr.task-type  = p-task-type
      526               and buf_schedule-attr.task-num   = p-task-num
      527               and buf_schedule-attr.attr-code  = p-code
      528         no-error .
      529       end.
      530       if available buf_schedule-attr
      531       then do:
      532           assign
      533               p-value = buf_schedule-attr.attr-value
      534           .
      535       end.
      536       else do:
      537         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      538            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      539         end.
      540         else do:
      541           assign
      542               p-value = if p-type = 'L':U then "no":U else ""
      543           .
      544         end.
      545       end.
      546   end.
      547   end procedure.
      548   procedure schedule-attr-write :
      549   do
      550   on error undo, return error
      551   :
      552   define input parameter p-cre-db-num  as integer   no-undo.
      553   define input parameter p-task-type   as character no-undo.
      554   define input parameter p-task-num    as integer   no-undo.
      555   define input parameter p-code        as character no-undo.
      556   define input parameter p-value       as character no-undo.
      557       define variable v-type              as character                no-undo.
      558       define variable v-format            as character                no-undo.
      559       define variable v-label             as character                no-undo.
      560       define variable v-user-can-edit     as logical                  no-undo.
      561       define variable v-output-display    as logical                  no-undo.
      562       define variable v-other             as character                no-undo.
      563       define buffer buf_schedule-attr for ub.schedule-attr .
      564       run schedule-attr-name in this-procedure (
      565             input  p-code
      566           , output v-type
      567           , output v-format
      568           , output v-label
      569           , output v-user-can-edit
      570           , output v-output-display
      571           , output v-other
      572       ) no-error.
      573       if error-status :error
      574       then do:
      575           undo, return error return-value.
      576       end.
      577       find first buf_schedule-attr exclusive-lock
      578            where buf_schedule-attr.cre-db-num = p-cre-db-num
      579              and buf_schedule-attr.task-type  = p-task-type
      580              and buf_schedule-attr.task-num   = p-task-num
      581              and buf_schedule-attr.attr-code  = p-code
      582       no-error.
      583       if not available buf_schedule-attr
      584       then do:
      585           create buf_schedule-attr.
      586           assign
      587             buf_schedule-attr.cre-db-num = p-cre-db-num
      588             buf_schedule-attr.task-type  = p-task-type
      589             buf_schedule-attr.task-num   = p-task-num
      590             buf_schedule-attr.attr-code  = p-code
      591             buf_schedule-attr.attr-value = p-value
      592           .
      593       end.
      594       else do:
      595           assign
      596               buf_schedule-attr.attr-value = p-value
      597           .
      598       end.
      599   end.
      600   end procedure.
      601   procedure schedule-attr-delete :
      602   do
      603   on error undo, return error
      604   :
      605   define input  parameter p-cre-db-num  as integer   no-undo.
      606   define input  parameter p-task-type   as character no-undo.
      607   define input  parameter p-task-num    as integer   no-undo.
      608   define input  parameter p-code        as character no-undo.
      609   define output parameter p-deleted     as logical   no-undo.
      610       define buffer buf_schedule-attr for ub.schedule-attr .
      611       define variable v-type              as character                no-undo.
      612       define variable v-format            as character                no-undo.
      613       define variable v-label             as character                no-undo.
      614       define variable v-user-can-edit     as logical                  no-undo.
      615       define variable v-output-display    as logical                  no-undo.
      616       define variable v-other             as character                no-undo.
      617       run schedule-attr-name in this-procedure (
      618             input p-code
      619           , output v-type
      620           , output v-format
      621           , output v-label
      622           , output v-user-can-edit
      623           , output v-output-display
      624           , output v-other
      625       ) no-error .
      626       if error-status :error
      627       then do:
      628           undo, return error return-value .
      629       end.
      630       find first buf_schedule-attr exclusive-lock
      631            where buf_schedule-attr.cre-db-num = p-cre-db-num
      632              and buf_schedule-attr.task-type  = p-task-type
      633              and buf_schedule-attr.task-num   = p-task-num
      634              and buf_schedule-attr.attr-code  = p-code
      635       no-error.
      636       if not available buf_schedule-attr
      637       then do:
      638           assign
      639               p-deleted = no
      640           .
      641       end.
      642       else do:
      643           delete buf_schedule-attr.
      644           assign
      645               p-deleted = yes
      646           .
      647       end.
      648   end.
      649   end procedure.
      650   procedure schedule-attr-news :
      651   do
      652   on error undo, return error
      653   :
      654       define input  parameter p-code           as character no-undo .
      655       define output parameter p-news           as logical   no-undo .
      656       if index(p-code, chr(4)) > 0 then do:
      657         p-code = entry(1, p-code, chr(4)).
      658       end.
      659       case p-code :
      660               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      661               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      662               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      663               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      664               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      665               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      666               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      667               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      668               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      669         otherwise do:
      670           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      671         end.
      672       end.
      673   end.
      674   end procedure.
      675   procedure schedule-attr-extract-logical :
      676   do
      677   on error undo, return error
      678   :
      679   define input  parameter p-parameter-number   as integer      no-undo.
      680   define input  parameter p-parameter-list     as character    no-undo.
      681   define output parameter p-parameter-value   as logical      no-undo.
      682       if num-entries( p-parameter-list ) > p-parameter-number - 1
      683       then do:
      684           assign
      685               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      686           .
      687       end.
      688       else do:
      689           assign
      690               p-parameter-value   = no
      691           .
      692       end.
      693   end.
      694   end procedure.
      695   procedure schedule-attr-get-free-id :
      696   do
      697   on error undo, return error return-value
      698   :
      699     define input  parameter p-cre-db-num  as integer   no-undo.
      700     define input  parameter p-task-type   as character no-undo.
      701     define input  parameter p-task-num    as integer   no-undo.
      702     define output parameter p-free-id     as character no-undo.
      703     define buffer buf_schedule-attr for ub.schedule-attr.
      704     find first buf_schedule-attr no-lock
      705         where buf_schedule-attr.cre-db-num = p-cre-db-num
      706           and buf_schedule-attr.task-type  = p-task-type
      707           and buf_schedule-attr.task-num   = p-task-num
      708           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      709     no-error .
      710     if available buf_schedule-attr then
      711     assign
      712     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      713     no-error
      714     .
      715   end.
      716   end procedure.
      717   procedure schedule-attr-get-free-props :
      718     define input parameter p-free-id as character no-undo .
      719     define output parameter p-value as character no-undo .
      720     define buffer buf_temp-schedule-free for temp-schedule-free.
      721     do
      722     on error undo, return error return-value
      723     :
      724       find first buf_temp-schedule-free no-lock no-error .
      725       if not available buf_temp-schedule-free then do:
      726         run schedule-attr-fill-free-props in this-procedure .
      727       end.
      728       find first buf_temp-schedule-free where
      729               buf_temp-schedule-free.free-id = p-free-id no-error.
      730       if available buf_temp-schedule-free then do:
      731         assign
      732         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      733                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      734                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      735                   buf_temp-schedule-free.conf-param           + chr(4) +
      736                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      737                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      738                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      739                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      740                   buf_temp-schedule-free.other-info
      741         .
      742       end.
      743       else do:
      744        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      745                              "id произвольной задачи - &5"
      746                              ,vss-workfile
      747                              ,vss-revision
      748                              ,vss-description
      749                              ,chr(10)
      750                              ,p-free-id).
      751       end.
      752     end.
      753   end procedure.
      754   procedure schedule-attr-is-rum-free-id :
      755   define input parameter p-free-id as character no-undo .
      756   define output parameter p-is-rum as logical no-undo .
      757   define buffer buf_temp-schedule-free for temp-schedule-free.
      758   do
      759   on error undo, return error
      760   :
      761       find first buf_temp-schedule-free no-lock no-error .
      762       if not available buf_temp-schedule-free then do:
      763         run schedule-attr-fill-free-props in this-procedure .
      764       end.
      765       find first buf_temp-schedule-free where
      766               buf_temp-schedule-free.free-id = p-free-id no-error.
      767       if available buf_temp-schedule-free
      768       and buf_temp-schedule-free.is-rum
      769       then do:
      770         p-is-rum = yes.
      771       end.
      772   end.
      773   end procedure.
      774   procedure schedule-attr-fill-free-props :
      775   define variable v-path                    as character                no-undo .
      776   DEFINE VARIABLE v-full-path               as character                no-undo .
      777   DEFINE VARIABLE v-file-name               as character                no-undo .
      778   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      779   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      780   define buffer buf_temp-schedule-free for temp-schedule-free.
      781   define variable v-answer as logical no-undo .
      782     do
      783     on error undo, return error substitute("&1 &2 &3&4&5&4"
      784                                           ,vss-workfile
      785                                           ,vss-revision
      786                                           ,vss-description
      787                                           ,chr(10)
      788                                           ,error-status:get-message(1) )
      789     :
      790       run gbl/filename.p (
      791                       input 'cmp/shd-free.d'
      792                     ,output v-full-path
      793                     ,output v-path
      794                     ,output v-file-name
      795                     ,output v-file-name-no-ext
      796                     ,output v-file-name-ext
      797                     ) .
      798       input from value(v-full-path).
      799       repeat :
      800         create buf_temp-schedule-free.
      801         import buf_temp-schedule-free.
      802       END.
      803       input close.
      804       _ff:
      805       for each buf_temp-schedule-free :
      806         if buf_temp-schedule-free.free-id = '':U then do:
      807            delete buf_temp-schedule-free.
      808            next _ff.
      809          end.
      810          run schedule-attr-check-enc in this-procedure (
      811                                                       input  buf_temp-schedule-free.free-id
      812                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      813                                                               buf_temp-schedule-free.proc-param-edit-name +
      814                                                               buf_temp-schedule-free.conf-param +
      815                                                               string(buf_temp-schedule-free.is-gbd) +
      816                                                               string(buf_temp-schedule-free.is-ubd) +
      817                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      818                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      819                                                               string(buf_temp-schedule-free.other-info)
      820                                                               )
      821                                                       ,input  buf_temp-schedule-free.enc-key
      822                                                       ,output v-answer    ) no-error .
      823          if error-status:error
      824          or not v-answer then delete buf_temp-schedule-free.
      825        end.
      826     end.
      827   end procedure.
      828   Function schedule-attr-reverse returns character (str as character).
      829      define variable rev_incl_s as character init "" no-undo .
      830      define variable rev_incl_i as integer no-undo .
      831      define variable rev_incl_l as integer no-undo .
      832      rev_incl_l = length(str).
      833      do rev_incl_i = 1 to rev_incl_l:
      834         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      835      end.
      836      return rev_incl_s.
      837   end.
      838   procedure schedule-attr-check-enc.
      839     define input  parameter p-free-id   as character no-undo .
      840     define input  parameter p-value     as character no-undo .
      841     define input  parameter p-enc-value as character no-undo .
      842     define output parameter p-answer    as logical   no-undo .
      843     define variable tmp         as character no-undo .
      844     define variable v-enc-value as character no-undo .
      845     assign
      846     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      847     .
      848     run schedule-attr-pswd-enc in this-procedure
      849       ( input tmp
      850        ,output v-enc-value
      851       ) no-error .
      852     if error-status:error then do:
      853       message
      854         vss-workfile vss-revision vss-description skip
      855         "Ошибка при вызове процедуры pswd-enc" skip
      856         return-value skip
      857         error-status :get-message(1) skip
      858         view-as alert-box error .
      859       undo, return error .
      860     end.
      861     if v-enc-value = p-enc-value then do:
      862       assign
      863         p-answer = true
      864       .
      865     end.
      866     else do:
      867       assign
      868         p-answer = false
      869       .
      870     end.
      871   end.
      872   procedure schedule-attr-conf-enc.
      873     define input  parameter p-free-id   as character no-undo .
      874     define input  parameter p-value     as character no-undo .
      875     define output parameter p-enc-value as character no-undo .
      876     define variable tmp         as character no-undo .
      877     assign
      878       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      879     .
      880     run schedule-attr-pswd-enc in this-procedure
      881       ( input tmp
      882        ,output p-enc-value
      883       ) no-error .
      884     if error-status:error then do:
      885       message
      886         vss-workfile vss-revision vss-description skip
      887         "Ошибка при вызове процедуры pswd-enc" skip
      888         return-value skip
      889         error-status :get-message(1) skip
      890         view-as alert-box error .
      891       undo, return error .
      892     end.
      893   end procedure.
      894   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   procedure schedule-attr-pswd-enc :
      896     define input parameter  pswd     as character no-undo .
      897     define output parameter enc-pswd as character no-undo .
      898     do
      899     on error undo, return error return-value
      900     :
      901       assign
      902         enc-pswd = encode(pswd + string(index(pswd, "k")))
      903       .
      904     end.
      905   end procedure.
      906   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      907   procedure cur-time :
      908      define output parameter p-today as date      no-undo .
      909      define output parameter p-time  as integer   no-undo .
      910     do
      911     on error undo, return error
      912     :
      913       define variable v-date1 as date      no-undo .
      914       define variable v-date2 as date      no-undo .
      915       define variable v-time  as integer   no-undo .
      916       assign
      917         v-date1 = today
      918         v-time  = time
      919         v-date2 = today
      920       .
      921       if v-date1 <> v-date2
      922       then do:
      923         assign
      924           v-date1 = today
      925           v-time  = v-time
      926         .
      927       end.
      928       assign
      929         p-today = v-date1
      930         p-time  = v-time
      931       .
      932     end.
      933   end.
      934   function cur-time-date returns character
      935   :
      936     return string(today, '99/99/9999':U) .
      937   end.
      938   function cur-time-mjd returns decimal
      939   :
      940     define variable v-date as date      no-undo .
      941     define variable v-time as integer   no-undo .
      942     run cur-time in this-procedure
      943       (output v-date
      944       ,output v-time
      945       ) .
      946     return integer(v-date) - 2400002 + (v-time / 86400) .
      947   end.
      948   function cur-time-get-ending-index returns integer
      949   (input p-number as integer
      950   )
      951   :
      952     if p-number < 0
      953     or p-number = ?
      954     then do:
      955       return 1 .
      956     end.
      957     define variable v-rest as integer   no-undo .
      958     assign
      959       p-number = p-number modulo 100
      960     .
      961     if p-number < 20
      962     then do:
      963       assign
      964         v-rest = p-number
      965       .
      966     end.
      967     else do:
      968       assign
      969         v-rest = p-number modulo 10
      970       .
      971     end.
      972     case v-rest :
      973       when 1
      974       then do:
      975         return 2 .
      976       end.
      977       when 2 or
      978       when 3 or
      979       when 4
      980       then do:
      981         return 3 .
      982       end.
      983       otherwise do:
      984         return 1 .
      985       end.
      986     end case .
      987   end.
      988   procedure cur-time-mjd-to-date :
      989      define input  parameter i-mjd-diff as decimal no-undo.
      990      define output parameter o-Date     as date    no-undo.
      991      define output parameter o-Time     as integer no-undo.
      992      define variable v-day-number as integer   no-undo .
      993      if    i-mjd-diff < 0
      994         or i-mjd-diff = ?
      995      then do:
      996         return "?" .
      997      end.
      998      assign
      999         v-day-number = truncate(i-mjd-diff,0).
     1000         o-Date = date(v-day-number + 2400002).
     1001         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1002     .
     1003   end.
     1004   function cur-time-mjd-to-string returns character
     1005   (input p-mjd-diff as decimal
     1006   )
     1007   :
     1008     define variable v-day-number as integer   no-undo .
     1009     define variable v-seconds    as integer   no-undo .
     1010     define variable v-hour       as integer   no-undo .
     1011     define variable v-min        as integer   no-undo .
     1012     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1013     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1014     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1015     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1016     if p-mjd-diff < 0
     1017     or p-mjd-diff = ?
     1018     then do:
     1019       return "?" .
     1020     end.
     1021     assign
     1022       v-day-number = integer(truncate(p-mjd-diff,0))
     1023       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1024     .
     1025     if v-seconds > 86400
     1026     then do:
     1027       assign
     1028         v-seconds = 86400 - 1
     1029       .
     1030     end.
     1031     if v-seconds < 0
     1032     then do:
     1033       assign
     1034         v-seconds = 0
     1035       .
     1036     end.
     1037     assign
     1038       v-hour = truncate(v-seconds / 3600, 0)
     1039     .
     1040     assign
     1041       v-seconds = v-seconds modulo 3600
     1042     .
     1043     assign
     1044       v-min = truncate(v-seconds / 60, 0)
     1045     .
     1046     assign
     1047       v-seconds = v-seconds modulo 60
     1048     .
     1049     return
     1050         (if v-day-number <> 0
     1051           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1052           else ""
     1053         )
     1054       + (if v-day-number <> 0 or v-hour <> 0
     1055           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1056           else ""
     1057         )
     1058       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1059           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1060           else ""
     1061         )
     1062       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1063       .
     1064   end.
     1065   function cur-time-string returns character
     1066   :
     1067     define variable v-date as date      no-undo .
     1068     define variable v-time as integer   no-undo .
     1069     run cur-time in this-procedure
     1070       (output v-date
     1071       ,output v-time
     1072       ) .
     1073     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1074   end.
     1075   function cur-time-string-sec returns character
     1076   :
     1077     define variable v-date as date      no-undo .
     1078     define variable v-time as integer   no-undo .
     1079     run cur-time in this-procedure
     1080       (output v-date
     1081       ,output v-time
     1082       ) .
     1083     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1084   end.
     1085   function cur-time-custom  returns character
     1086   (input p-prefix as character
     1087   ,input p-date-format as character
     1088   ,input p-delimiter as character
     1089   ,input p-time-format as character
     1090   ,input p-suffix as character
     1091   )
     1092   :
     1093     define variable v-date as date      no-undo .
     1094     define variable v-time as integer   no-undo .
     1095     run cur-time in this-procedure
     1096       (output v-date
     1097       ,output v-time
     1098       ) .
     1099     return
     1100       p-prefix
     1101       + string(v-date, p-date-format)
     1102       + p-delimiter
     1103       + string(v-time, p-time-format)
     1104       + p-suffix
     1105       .
     1106   end.
     1107   function cur-time-print  returns character
     1108   :
     1109     define variable v-date as date      no-undo .
     1110     define variable v-time as integer   no-undo .
     1111     run cur-time in this-procedure
     1112       (output v-date
     1113       ,output v-time
     1114       ) .
     1115     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1116   end.
     1117   function cur-time-datetime returns datetime
     1118   :
     1119     define variable v-char as character no-undo .
     1120     define variable v-datetime as datetime no-undo .
     1121     v-char = cur-time-string().
     1122     v-datetime = datetime(v-char).
     1123     return  v-datetime.
     1124   end.
     1125   function cur-time-string-msec returns character
     1126   :
     1127     define variable v-date as datetime  no-undo .
     1128     v-date = now.
     1129     return string(v-date) .
     1130   end.
     1131   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   PROCEDURE verify-ini-entry:
     1133   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1134   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1135   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1136   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1137   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1138   define variable v-mess as character no-undo .
     1139   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1140   if ini-entry-value = ? and ini-key-name begins "spl"
     1141   then
     1142   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1143   if ini-entry-value = ? and ini-key-name begins "sav"
     1144   then
     1145   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1146   if ini-entry-value = ? then do:
     1147     assign
     1148     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1149                       , chr(10)
     1150                       , ini-section-name
     1151                       , ini-key-name
     1152                       , error-msg-text).
     1153       if not silence then do:
     1154         message
     1155         v-mess
     1156         view-as alert-box ERROR  .
     1157         return error.
     1158       end.
     1159       else do:
     1160         return error v-mess.
     1161       end.
     1162   end.
     1163   END PROCEDURE.
     1164   PROCEDURE verify-file:
     1165   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1166   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1167   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1168   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1169   file-info:file-name = filename.
     1170   found = NOT (file-info:full-pathname = ?).
     1171   if NOT found  then do:
     1172     if not silence then do:
     1173       message error-msg-text
     1174       view-as alert-box ERROR.
     1175       return error.
     1176     end.
     1177     else return error error-msg-text.
     1178   end.
     1179   END PROCEDURE.
