       26   DEFINE BUFFER X_rule-by-profile FOR rule-by-profile.
       27   DEFINE BUFFER X_rule-profile FOR rule-profile.
       28      DEFINE variable loghandle AS HANDLE no-undo.
       29      DEFINE VARIABLE logstring AS CHARACTER no-undo.
       30      define variable par1 as widget-handle  no-undo.
       31      define variable par2 as widget-handle  no-undo.
       32      define variable file-name as char no-undo.
       33      define variable v-paramdop as char no-undo.
       34      DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
