     1494           update ll_commit9
     1495           default-extension "txt"
     1496           .
     1497       IF ll_commit9 <> YES THEN do:
     1498          RETURN NO-APPLY.
     1499       end.
     1500       IF v_os-file9 = PROGRAM-NAME( 1 ) THEN DO:
     1501           BELL.
     1502           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1503           RETURN NO-APPLY.
     1504       END.
     1505       ASSIGN fnperesort = ( IF SEARCH( v_os-file9 ) = ? THEN   v_os-file9  ELSE SEARCH( v_os-file9 ) ).
     1506       DISP fnperesort WITH FRAME Dialog-Frame.
     1507   END.
     1508   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1509   DO:
     1510       define variable v-obj-list as character no-undo .
     1511      ASSIGN
     1512       staff
     1513       peresort
     1514       prihod
     1515       rasvn
     1516       rasvne
     1517       udal
     1518       fnsoot
     1519       fnkassir
     1520       fnperesort
     1521       fnprih
     1522       fnrasvn
     1523       fnrasvne
     1524       fnudal
     1525       e-mail.
     1526       if (staff = true and fnkassir = "") or (peresort = true and fnperesort = "")
     1527       or (prihod = true and fnprih = "") or (rasvn = true and fnrasvn = "")  or (udal = true and fnudal = "")
     1528       then
     1529       do:
     1530       message "Необходимо ввести путь для выгрузок по флагам".
     1531       return no-apply.
     1532       end.
     1533       if (staff    = false and trim(fnkassir)   <> "")  then assign fnkassir   = "".
     1534       if (peresort = false and trim(fnperesort) <> "")  then assign fnperesort = "".
     1535       if (prihod   = false and trim(fnprih)     <> "")  then assign fnprih     = "".
     1536       if (rasvn    = false and trim(fnrasvn)    <> "")  then assign fnrasvn    = "".
     1537       if (udal     = false and trim(fnudal)     <> "")  then assign fnudal     = "".
     1538       if (rasvne   = false and trim(fnrasvne)   <> "")  then assign fnrasvne   = "".
     1539      IF trim(fnsoot) = "" THEN
     1540       DO:
     1541           MESSAGE "Необходимо ввести путь для файла соответствий".
     1542           return no-apply.
     1543       END.
     1544           ELSE
     1545           DO:
     1546       MESSAGE "Сохранить настройки?"
     1547          VIEW-AS ALERT-BOX QUESTION
     1548       BUTTONS yes-no UPDATE continue-ok AS LOGICAL.
     1549       IF continue-ok THEN DO:
     1550          v-param-list = (fnrasvn + "!" + fnudal + "!" + fnprih + "!" + fnsoot + "!" + fnkassir + "!" + fnperesort + "!" + e-mail + "!" + fnrasvne ).
     1551        run attach-attr-to-schedule-line in this-procedure (
     1552                                                            INPUT v-param-list
     1553       ) .
     1554       Message "Настройки сохранены" VIEW-AS ALERT-BOX QUESTION.
     1555       END.
     1556       else
     1557       return no-apply.
     1558       END.
     1559   END.
     1560   ON LEAVE OF fnkassir IN FRAME Dialog-Frame
     1561   DO:
     1562       ASSIGN fnkassir.
     1563       IF SEARCH( fnkassir ) <> ? AND SEARCH( fnkassir ) <> "":U THEN DO:
     1564           ASSIGN FILE-INFO:FILE-NAME = file-name.
     1565           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnkassir = FILE-INFO:FULL-PATHNAME.
     1566           DISP fnkassir WITH FRAME Dialog-Frame.
     1567       END.
     1568       APPLY "TAB":U TO fnkassir IN FRAME Dialog-Frame.
     1569   END.
     1570   ON LEAVE OF fnperesort IN FRAME Dialog-Frame
     1571   DO:
     1572       ASSIGN fnperesort.
     1573       IF SEARCH( fnperesort ) <> ? AND SEARCH( fnperesort ) <> "":U THEN DO:
     1574           ASSIGN FILE-INFO:FILE-NAME = fnperesort.
     1575           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnperesort = FILE-INFO:FULL-PATHNAME.
     1576           DISP fnperesort WITH FRAME Dialog-Frame.
     1577       END.
     1578       APPLY "TAB":U TO fnperesort IN FRAME Dialog-Frame.
     1579   END.
     1580   ON LEAVE OF fnprih IN FRAME Dialog-Frame
     1581   DO:
     1582       ASSIGN fnprih.
     1583       IF SEARCH( fnprih ) <> ? AND SEARCH( fnprih ) <> "":U THEN DO:
     1584           ASSIGN FILE-INFO:FILE-NAME =fnprih.
     1585           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnprih = FILE-INFO:FULL-PATHNAME.
     1586           DISP fnprih WITH FRAME Dialog-Frame.
     1587       END.
     1588       APPLY "TAB":U TO fnprih IN FRAME Dialog-Frame.
     1589   END.
     1590   ON LEAVE OF fnrasvn IN FRAME Dialog-Frame
     1591   DO:
     1592       ASSIGN fnrasvn.
     1593       IF SEARCH( fnrasvn ) <> ? AND SEARCH( fnrasvn ) <> "":U THEN DO:
     1594           ASSIGN FILE-INFO:FILE-NAME = fnrasvn.
     1595           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnrasvn = FILE-INFO:FULL-PATHNAME.
     1596           DISP fnrasvn WITH FRAME Dialog-Frame.
     1597       END.
     1598       APPLY "TAB":U TO fnrasvn IN FRAME Dialog-Frame.
     1599   END.
     1600   ON LEAVE OF fnrasvne IN FRAME Dialog-Frame
     1601   DO:
     1602       ASSIGN fnrasvne.
     1603       IF SEARCH( fnrasvne ) <> ? AND SEARCH( fnrasvne ) <> "":U THEN DO:
     1604           ASSIGN FILE-INFO:FILE-NAME = fnrasvne.
     1605           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnrasvne = FILE-INFO:FULL-PATHNAME.
     1606           DISP fnrasvne WITH FRAME Dialog-Frame.
     1607       END.
     1608       APPLY "TAB":U TO fnrasvne IN FRAME Dialog-Frame.
     1609   END.
     1610   ON LEAVE OF fnudal IN FRAME Dialog-Frame
     1611   DO:
     1612       ASSIGN fnudal.
     1613       IF SEARCH( fnudal ) <> ? AND SEARCH( fnudal ) <> "":U THEN DO:
     1614           ASSIGN FILE-INFO:FILE-NAME = fnudal.
     1615           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN fnudal = FILE-INFO:FULL-PATHNAME.
     1616           DISP fnudal WITH FRAME Dialog-Frame.
     1617       END.
     1618       APPLY "TAB":U TO fnudal IN FRAME Dialog-Frame.
     1619   END.
     1620   ON VALUE-CHANGED OF peresort IN FRAME Dialog-Frame
     1621   DO:
     1622      assign peresort.
     1623      disable fnperesort b-file-9 WITH FRAME Dialog-Frame.
     1624      enable fnperesort   when peresort = true
     1625             b-file-9     when peresort = true
     1626      WITH FRAME Dialog-Frame.
     1627   END.
     1628   ON VALUE-CHANGED OF prihod IN FRAME Dialog-Frame
     1629   DO:
     1630       assign prihod.
     1631       disable fnprih b-file-3 WITH FRAME Dialog-Frame.
     1632       enable fnprih   when prihod = true
     1633              b-file-3 when prihod = true
     1634       WITH FRAME Dialog-Frame.
     1635   END.
     1636   ON VALUE-CHANGED OF rasvn IN FRAME Dialog-Frame
     1637   DO:
     1638       assign rasvn.
     1639       disable fnrasvn b-file WITH FRAME Dialog-Frame.
     1640       enable fnrasvn   when rasvn = true
     1641             b-file when rasvn = true
     1642       WITH FRAME Dialog-Frame.
     1643   END.
     1644   ON VALUE-CHANGED OF rasvne IN FRAME Dialog-Frame
     1645   DO:
     1646       assign rasvne.
     1647       disable fnrasvne B-file-5 WITH FRAME Dialog-Frame.
     1648       enable fnrasvne when rasvne = true
     1649              B-file-5 when rasvne = true
     1650       WITH FRAME Dialog-Frame.
     1651   END.
     1652   ON VALUE-CHANGED OF staff IN FRAME Dialog-Frame
     1653   DO:
     1654      assign staff.
     1655      disable fnkassir b-file-6 WITH FRAME Dialog-Frame.
     1656      enable fnkassir   when staff = true
     1657             b-file-6 when staff = true
     1658      WITH FRAME Dialog-Frame.
     1659     END.
     1660   ON VALUE-CHANGED OF udal IN FRAME Dialog-Frame
     1661   DO:
     1662      assign udal.
     1663      disable fnudal b-file-2 WITH FRAME Dialog-Frame.
     1664      enable fnudal   when udal = true
     1665             b-file-2 when udal = true
     1666      WITH FRAME Dialog-Frame.
     1667   END.
     1668   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1669   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1670   MAIN-BLOCK:
     1671   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1672      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1673     RUN enable_UI.
     1674     run getschedule.
     1675     run my-enable .
     1676      WAIT-FOR GO OF FRAME Dialog-Frame.
     1677   END.
     1678   RUN disable_UI.
     1679   procedure getschedule:
     1680       run schedule-attr-value in this-procedure (
     1681             input integer(p-db-num-char)
     1682           , input p-task-type
     1683           , input p-task-num
     1684           , input 'schedule-param-list':U
     1685           , output v-param-list
     1686           , output v-param-type
     1687       ) no-error.
     1688          if v-param-list <> "" then
     1689           do:
     1690        assign fnrasvn    = entry ( 1 , v-param-list , "!" )
     1691               fnudal     = entry ( 2 , v-param-list , "!" )
     1692               fnprih     = entry ( 3 , v-param-list , "!" )
     1693               fnsoot     = entry ( 4 , v-param-list , "!" )
     1694               fnkassir   = entry ( 5 , v-param-list , "!" )
     1695               fnperesort = entry ( 6 , v-param-list , "!" )
     1696               e-mail     = entry ( 7 , v-param-list , "!" )
     1697               fnrasvne   = entry ( 8 , v-param-list , "!" ).
     1698           end.
     1699               if fnrasvn    <> "" then  rasvn = true.
     1700               if fnudal     <> "" then  udal = true.
     1701               if fnprih     <> "" then  prihod = true.
     1702               if fnkassir   <> "" then  staff = true.
     1703               if fnperesort <> "" then  peresort = true.
     1704               if fnrasvne   <> "" then  rasvne = true.
     1705           disp rasvn udal prihod staff peresort rasvne fnrasvne fnrasvn fnudal fnprih fnsoot fnkassir fnperesort e-mail WITH FRAME Dialog-Frame.
     1706   end.
     1707   PROCEDURE attach-attr-to-schedule-line :
     1708   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1709   define buffer buf_schedule      for schedule.
     1710   define buffer buf_schedule-attr for schedule-attr.
     1711   define buffer lock-batchprocess for ub.batchprocess.
     1712          run gbl/lock-prc.p
     1713             (input 'schd':U
     1714             ,input 'exp-sale':U
     1715             ,input 0
     1716             ,input 0
     1717             ,input '':U
     1718             ,input ""
     1719             ,input ""
     1720             ,input (
     1721                     "выгрузки для kan3"
     1722                   )
     1723             ,input yes
     1724             ,buffer lock-batchprocess
     1725             ) no-error .
     1726         FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1727                    buf_schedule-attr.task-type   = p-task-type
     1728                and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
     1729                and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'kan3') NO-ERROR.
     1730         IF AVAILABLE  buf_schedule-attr
     1731             AND buf_schedule-attr.task-num <> p-task-num
     1732             AND buf_schedule-attr.task-num <> - 1
     1733             and p-task-num <> - 1
     1734             THEN DO:
     1735           MESSAGE
     1736           substitute("Уже есть расписание выгрузки для kan3 для БД &1&2" +
     1737                      "номер расписания &3"
     1738                      ,buf_schedule-attr.cre-db-num
     1739                      ,chr(10)
     1740                      ,buf_schedule-attr.task-num)
     1741           VIEW-AS ALERT-BOX ERROR.
     1742           UNDO, RETURN ERROR.
     1743         END.
     1744         find first buf_schedule no-lock
     1745              where buf_schedule.task-type   = p-task-type
     1746                and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     1747                and buf_schedule.task-num    = p-task-num
     1748         no-error.
     1749         if not available buf_schedule
     1750         and (  p-task-type   <> 'autofree':U
     1751             or p-db-num-char <> p-db-num-char
     1752             or p-task-num    <> -1 )
     1753         then do:
     1754             message
     1755               vss-workfile vss-revision vss-description
     1756               skip "Не найдена строка расписания."
     1757               skip return-value
     1758               skip trim(error-status :get-message(1))
     1759                    trim(error-status :get-message(2))
     1760                    trim(error-status :get-message(3))
     1761             view-as alert-box error.
     1762             undo, return error .
     1763         end.
     1764       run schedule-attr-write in this-procedure (
     1765             input INTEGER(p-db-num-char)
     1766           , input p-task-type
     1767           , input p-task-num
     1768           , input 'schedule-param-list':U
     1769           , input p-param-list
     1770       ).
     1771    END PROCEDURE.
     1772   PROCEDURE disable_UI :
     1773     HIDE FRAME Dialog-Frame.
     1774   END PROCEDURE.
     1775   PROCEDURE enable_UI :
     1776     DISPLAY staff fnkassir peresort fnperesort rasvn fnrasvn udal fnudal prihod
     1777             fnprih fnsoot fnrasvne rasvne
     1778         WITH FRAME Dialog-Frame.
     1779     ENABLE staff peresort rasvn udal prihod fnsoot B-file-4 Btn_OK Btn_Cancel e-mail fnrasvne fnrasvn rasvne
     1780         WITH FRAME Dialog-Frame.
     1781     VIEW FRAME Dialog-Frame.
     1782   END PROCEDURE.
     1783   PROCEDURE my-enable :
     1784     disable fnkassir
     1785            B-file-6
     1786            fnperesort
     1787            B-file-9
     1788            fnrasvn
     1789            B-file
     1790            fnudal
     1791            B-file-2
     1792            fnprih
     1793            B-file-3
     1794            fnrasvne
     1795            B-file-5
     1796        WITH FRAME Dialog-Frame.
     1797     ENABLE fnkassir when staff = true
     1798            B-file-6 when staff = true
     1799            fnperesort when peresort = true
     1800            B-file-9 when peresort = true
     1801            fnrasvn when rasvn = true
     1802            B-file when rasvn = true
     1803            fnudal when udal = true
     1804            B-file-2 when udal = true
     1805            fnprih when prihod = true
     1806            B-file-3 when prihod =true
     1807            fnrasvne when rasvne = true
     1808            B-file-5 when rasvne = true
     1809           WITH FRAME Dialog-Frame.
     1810   end procedure.
     1811   PROCEDURE proc-save :
     1812   END PROCEDURE.
