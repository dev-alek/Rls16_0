     1680       rid-list = string( recid( buf-OR_ord-doc ) ) .
     1681   END.
     1682   ON VALUE-CHANGED OF br-docs IN FRAME Dialog-Frame
     1683   DO:
     1684    if not available buf-OR_ord-doc then return .
     1685    define buffer buf_clients for ub.clients.
     1686   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1688     (input  buf-OR_ord-doc.creid
     1689     ,output loc-creid
     1690     )  .
     1691    find first buf_clients no-lock where
     1692            buf_clients.obj-type = 'чел':U  and
     1693            buf_clients.obj-code  = buf-OR_ord-doc.boss no-error.
     1694       if available buf_clients then loc-boss = buf_clients.obj-name.
     1695       else loc-boss = "".
     1696    find first buf_clients no-lock where
     1697            buf_clients.obj-type = 'чел':U  and
     1698            buf_clients.obj-code  = buf-OR_ord-doc.agnt no-error.
     1699       if available buf_clients then loc-agnt = buf_clients.obj-name.
     1700       else loc-agnt = "".
     1701    find first buf_clients no-lock where
     1702            buf_clients.obj-type = 'чел':U  and
     1703            buf_clients.obj-code  = buf-OR_ord-doc.wrkr no-error.
     1704       if available buf_clients then loc-wrkr = buf_clients.obj-name.
     1705       else loc-wrkr = "".
     1706     loc-ps = trim(buf-OR_ord-doc.PS) .
     1707     display loc-creid
     1708       loc-boss
     1709       loc-agnt
     1710       loc-wrkr
     1711       loc-ps
     1712     with frame Dialog-Frame.
     1713     OPEN QUERY br-zapr FOR EACH buf-OR_ord-doc-rcv WHERE                   buf-OR_ord-doc-rcv.doc-code = buf-OR_ord-doc.doc-code NO-LOCK,         each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-OR_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'          ,          EACH buf-OR_trn-doc  where        buf-OR_trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     1714   END.
     1715   ON return OF sch-code IN FRAME Dialog-Frame
