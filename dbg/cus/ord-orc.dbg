     1781   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1782   on ' ' of sch-date in frame Dialog-Frame
     1783   do:
     1784     if (can-query (self, "sensitive")
     1785        and
     1786        self :sensitive = true
     1787        )
     1788     or (can-query (self, "read-only")
     1789        and
     1790        self :read-only = false
     1791        )
     1792     then do:
     1793       assign
     1794         self :screen-value = ?
     1795       .
     1796     end.
     1797     return no-apply.
     1798   end.
     1799   on delete-character of sch-date in frame Dialog-Frame
     1800   do:
     1801     if (can-query (self, "sensitive")
     1802        and
     1803        self :sensitive = true
     1804        )
     1805     or (can-query (self, "read-only")
     1806        and
     1807        self :read-only = false
     1808        )
     1809     then do:
     1810       assign
     1811         self :screen-value = ?
     1812       .
     1813     end.
     1814     return no-apply.
     1815   end.
     1816   on ctrl-d of sch-date in frame Dialog-Frame
     1817   do:
     1818     define variable v-curr-sv-date as date no-undo .
     1819     if (can-query (self, "sensitive")
     1820        and
     1821        self :sensitive = true
     1822        )
     1823     or (can-query (self, "read-only")
     1824        and
     1825        self :read-only = false
     1826        )
     1827     then do:
     1828       if self :handle <> focus :handle
     1829       then do:
     1830         apply "entry":u to self .
     1831       end.
     1832       run gbl/getcurdt.p
     1833         (output v-curr-sv-date
     1834         ) .
     1835       assign
     1836         self :screen-value = string(v-curr-sv-date) .
     1837       .
     1838     end.
     1839     return no-apply.
     1840   end.
     1841   on ctrl-b of sch-date in frame Dialog-Frame
     1842   do:
     1843     if (can-query (self, "sensitive")
     1844        and
     1845        self :sensitive = true
     1846        )
     1847     or (can-query (self, "read-only")
     1848        and
     1849        self :read-only = false
     1850        )
     1851     then do:
     1852       if self :handle <> focus :handle
     1853       then do:
     1854         apply "entry":u to self .
     1855       end.
     1856       define variable v-curr-sv-date as date no-undo .
     1857       define variable v-new-sv-date  as date no-undo .
     1858       assign
     1859         v-curr-sv-date = date(self :screen-value) no-error
     1860       .
     1861       if v-curr-sv-date = ?
     1862       then do:
     1863         run gbl/getcurdt.p
     1864           (output v-curr-sv-date
     1865           ) .
     1866       end.
     1867       if v-curr-sv-date <> ?
     1868       then do:
     1869         assign
     1870           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1871         .
     1872         assign
     1873           self :screen-value = string(v-new-sv-date) .
     1874         .
     1875       end.
     1876     end.
     1877     return no-apply .
     1878   end.
     1879   on ctrl-e of sch-date in frame Dialog-Frame
     1880   do:
     1881     if (can-query (self, "sensitive")
     1882        and
     1883        self :sensitive = true
     1884        )
     1885     or (can-query (self, "read-only")
     1886        and
     1887        self :read-only = false
     1888        )
     1889     then do:
     1890       if self :handle <> focus :handle
     1891       then do:
     1892         apply "entry":u to self .
     1893       end.
     1894       define variable v-curr-sv-date as date no-undo .
     1895       define variable v-new-sv-date  as date no-undo .
     1896       assign
     1897         v-curr-sv-date = date(self :screen-value) no-error
     1898       .
     1899       if v-curr-sv-date = ?
     1900       then do:
     1901         run gbl/getcurdt.p
     1902           (output v-curr-sv-date
     1903           ) .
     1904       end.
     1905       if v-curr-sv-date <> ?
     1906       then do:
     1907         run gbl/lastdate.p
     1908           (input  v-curr-sv-date
     1909           ,output v-new-sv-date
     1910           ).
     1911         assign
     1912           self :screen-value = string(v-new-sv-date) .
     1913         .
     1914       end.
     1915     end.
     1916     return no-apply .
     1917   end.
     1918   on ctrl-f of sch-date in frame Dialog-Frame
     1919   do:
     1920     if (can-query (self, "sensitive")
     1921        and
     1922        self :sensitive = true
     1923        )
     1924     or (can-query (self, "read-only")
     1925        and
     1926        self :read-only = false
     1927        )
     1928     then do:
     1929       if self :handle <> focus :handle
     1930       then do:
     1931         apply "entry":u to self .
     1932       end.
     1933       define variable v-ok            as logical   no-undo .
     1934       define variable v-curr-sv-date  as date      no-undo .
     1935       define variable v-description   as character no-undo .
     1936       assign
     1937         v-curr-sv-date = date(self :screen-value) no-error
     1938       .
     1939       if v-curr-sv-date = ?
     1940       then do:
     1941         run gbl/getcurdt.p
     1942           (output v-curr-sv-date
