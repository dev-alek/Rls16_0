      132   define new global shared variable g#library  as handle no-undo .
      133   define new global shared variable g#library2 as handle no-undo .
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define variable c-point  as character no-undo .
      136   define variable tbl      as character no-undo .
      137   define variable join-tbl as character no-undo .
      138   define variable fld      as character no-undo .
      139   define variable lab      as character no-undo .
      140   define variable spr      as character no-undo .
      141   define variable dim      as character no-undo .
      142   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   procedure cur-time :
      144      define output parameter p-today as date      no-undo .
      145      define output parameter p-time  as integer   no-undo .
      146     do
      147     on error undo, return error
      148     :
      149       define variable v-date1 as date      no-undo .
      150       define variable v-date2 as date      no-undo .
      151       define variable v-time  as integer   no-undo .
      152       assign
      153         v-date1 = today
      154         v-time  = time
      155         v-date2 = today
      156       .
      157       if v-date1 <> v-date2
      158       then do:
      159         assign
      160           v-date1 = today
      161           v-time  = v-time
      162         .
      163       end.
      164       assign
      165         p-today = v-date1
      166         p-time  = v-time
      167       .
      168     end.
      169   end.
      170   function cur-time-date returns character
      171   :
      172     return string(today, '99/99/9999':U) .
      173   end.
      174   function cur-time-mjd returns decimal
      175   :
      176     define variable v-date as date      no-undo .
      177     define variable v-time as integer   no-undo .
      178     run cur-time in this-procedure
      179       (output v-date
      180       ,output v-time
      181       ) .
      182     return integer(v-date) - 2400002 + (v-time / 86400) .
      183   end.
      184   function cur-time-get-ending-index returns integer
      185   (input p-number as integer
      186   )
      187   :
      188     if p-number < 0
      189     or p-number = ?
      190     then do:
      191       return 1 .
      192     end.
      193     define variable v-rest as integer   no-undo .
      194     assign
      195       p-number = p-number modulo 100
      196     .
      197     if p-number < 20
      198     then do:
      199       assign
      200         v-rest = p-number
      201       .
      202     end.
      203     else do:
      204       assign
      205         v-rest = p-number modulo 10
      206       .
      207     end.
      208     case v-rest :
      209       when 1
      210       then do:
      211         return 2 .
      212       end.
      213       when 2 or
      214       when 3 or
      215       when 4
      216       then do:
      217         return 3 .
      218       end.
      219       otherwise do:
      220         return 1 .
      221       end.
      222     end case .
      223   end.
      224   procedure cur-time-mjd-to-date :
      225      define input  parameter i-mjd-diff as decimal no-undo.
      226      define output parameter o-Date     as date    no-undo.
      227      define output parameter o-Time     as integer no-undo.
      228      define variable v-day-number as integer   no-undo .
      229      if    i-mjd-diff < 0
      230         or i-mjd-diff = ?
      231      then do:
      232         return "?" .
      233      end.
      234      assign
      235         v-day-number = truncate(i-mjd-diff,0).
      236         o-Date = date(v-day-number + 2400002).
      237         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      238     .
      239   end.
      240   function cur-time-mjd-to-string returns character
      241   (input p-mjd-diff as decimal
      242   )
      243   :
      244     define variable v-day-number as integer   no-undo .
      245     define variable v-seconds    as integer   no-undo .
      246     define variable v-hour       as integer   no-undo .
      247     define variable v-min        as integer   no-undo .
      248     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      249     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      250     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      251     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      252     if p-mjd-diff < 0
      253     or p-mjd-diff = ?
      254     then do:
      255       return "?" .
      256     end.
      257     assign
      258       v-day-number = integer(truncate(p-mjd-diff,0))
      259       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      260     .
      261     if v-seconds > 86400
      262     then do:
      263       assign
      264         v-seconds = 86400 - 1
      265       .
      266     end.
      267     if v-seconds < 0
      268     then do:
      269       assign
      270         v-seconds = 0
      271       .
      272     end.
      273     assign
      274       v-hour = truncate(v-seconds / 3600, 0)
      275     .
      276     assign
      277       v-seconds = v-seconds modulo 3600
      278     .
      279     assign
      280       v-min = truncate(v-seconds / 60, 0)
      281     .
      282     assign
      283       v-seconds = v-seconds modulo 60
      284     .
      285     return
      286         (if v-day-number <> 0
      287           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      288           else ""
      289         )
      290       + (if v-day-number <> 0 or v-hour <> 0
      291           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      292           else ""
      293         )
      294       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      295           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      296           else ""
      297         )
      298       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      299       .
      300   end.
      301   function cur-time-string returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      310   end.
      311   function cur-time-string-sec returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      320   end.
      321   function cur-time-custom  returns character
      322   (input p-prefix as character
      323   ,input p-date-format as character
      324   ,input p-delimiter as character
      325   ,input p-time-format as character
      326   ,input p-suffix as character
      327   )
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return
      336       p-prefix
      337       + string(v-date, p-date-format)
      338       + p-delimiter
      339       + string(v-time, p-time-format)
      340       + p-suffix
      341       .
      342   end.
      343   function cur-time-print  returns character
      344   :
      345     define variable v-date as date      no-undo .
      346     define variable v-time as integer   no-undo .
      347     run cur-time in this-procedure
      348       (output v-date
      349       ,output v-time
      350       ) .
      351     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      352   end.
      353   function cur-time-datetime returns datetime
      354   :
      355     define variable v-char as character no-undo .
      356     define variable v-datetime as datetime no-undo .
      357     v-char = cur-time-string().
      358     v-datetime = datetime(v-char).
      359     return  v-datetime.
      360   end.
      361   function cur-time-string-msec returns character
      362   :
      363     define variable v-date as datetime  no-undo .
      364     v-date = now.
      365     return string(v-date) .
      366   end.
      367   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      369   define new shared variable RepPathName        as character no-undo .
      370   define new shared variable PrintRubl          as logical   no-undo .
      371   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   procedure fltfield-clear :
      373     define output parameter loc-fld as character no-undo.
      374     define output parameter loc-lab as character no-undo .
      375     define output parameter loc-spr as character no-undo .
      376     define output parameter loc-dim as character no-undo .
      377     assign
      378       loc-fld = ""
      379       loc-lab = ""
      380       loc-spr = ""
      381       loc-dim = "0"
      382     .
      383   end procedure .
      384   procedure fltfield-add :
      385     define input        parameter par-fld as character no-undo.
      386     define input        parameter par-lab as character no-undo .
      387     define input        parameter par-spr as character no-undo .
      388     define input-output parameter loc-fld as character no-undo.
      389     define input-output parameter loc-lab as character no-undo .
      390     define input-output parameter loc-spr as character no-undo .
      391     define input-output parameter loc-dim as character no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       assign
      396       loc-fld = if loc-dim = '0'
      397                 then par-fld
      398                 else (loc-fld + chr(44) + par-fld)
      399       loc-lab = if loc-dim = '0'
      400                 then par-lab
      401                 else (loc-lab + chr(44) + par-lab)
      402       loc-spr = if loc-dim = '0'
      403                 then par-spr
      404                 else (loc-spr + chr(44) + par-spr)
      405       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      406                 string(integer(if num-entries(loc-dim) > 1
      407                               then entry(2, loc-dim)
      408                               else entry(1, loc-dim)
      409                               ) + 1)
      410       no-error
      411       .
      412     end.
      413   end procedure.
      414   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   define  stream PrnLibStream.
      416   procedure prn-lib-prn-file :
      417     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      418     define input parameter p-DIsabledoptions as integer no-undo .
      419     define variable v-report-name as character no-undo .
      420     define variable v-user-action as character no-undo .
      421     define variable v-printed     as logical   no-undo .
      422     define variable v-exist       as logical   no-undo .
      423     do
      424       on error undo, return error
      425       :
      426       run prn-lib-get-report-name  in this-procedure (
      427         input parParentProc
      428         ,output v-report-name
      429         ).
      430   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      432     (input  v-report-name
      433     ,input  2
      434     ,output v-exist
      435     )  .
      436       if NOT v-exist then
      437       DO:
      438         Message
      439           "Нет заданий на печать ! "
      440           view-as alert-box .
      441         Return  .
      442       End.
      443       run gbl/prnfilen.w
      444         (input  ""
      445         ,input  p-DisabledOptions
      446         ,input  string(v-report-name )
      447         ,input  7
      448         ,output v-user-action
      449         ,output v-printed
      450         ) .
      451       if v-printed then
      452       do:
      453         return "YES" .
      454       end.
      455       else
      456       do:
      457         return "NO" .
      458       end.
      459     end.
      460   end procedure.
      461   procedure prn-lib-open-stream :
      462     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      463     define input parameter p-page-size    as integer no-undo .
      464     define input parameter p-is-stream    as logical no-undo .
      465     define input parameter p-append       as logical no-undo .
      466     define variable v-report-name as character no-undo .
      467     do
      468       on error undo, return error
      469       :
      470       run prn-lib-get-report-name  in this-procedure (
      471         input parParentProc
      472         ,output v-report-name
      473         ).
      474       if p-is-stream then
      475       do:
      476         if p-append then
      477         do:
      478           output stream PrnLibStream to value( v-report-name )
      479             page-size value(p-page-size) append .
      480         end.
      481         if not p-append then
      482         do:
      483           output stream PrnLibStream to value( v-report-name )
      484             page-size value(p-page-size) .
      485         end.
      486       end.
      487       if not p-is-stream then
      488       do:
      489         if p-append then
      490         do:
      491           output to value( v-report-name )
      492             page-size value(p-page-size) append .
      493         end.
      494         if not p-append then
      495         do:
      496           output to value( v-report-name )
      497             page-size value(p-page-size) .
      498         end.
      499       end.
      500     end.
      501   end procedure.
      502   procedure prn-lib-open-exp :
      503     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      504     define input parameter p-is-stream    as logical no-undo .
      505     define input parameter p-is-append    as logical no-undo .
      506     define output parameter p-ReportFileName as char init "report" no-undo.
      507     define output parameter p-process as logical no-undo .
      508     define variable glog as logical no-undo .
      509     do
      510       on error undo, return error
      511       :
      512       SYSTEM-DIALOG GET-FILE p-ReportFileName
      513         TITLE      "Укажите путь"
      514         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      515         ASK-OVERWRITE
      516         CREATE-TEST-FILE
      517         SAVE-AS
      518         USE-FILENAME
      519         DEFAULT-EXTENSION "txt"
      520         UPDATE glog
      521         .
      522       if not glog then  return.
      523       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      524       if p-is-stream then
      525       do:
      526         if p-is-append then
      527         do:
      528           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      529         end.
      530         else
      531         do:
      532           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      533         end.
      534       end.
      535       else
      536       do:
      537         if p-is-append then
      538         do:
      539           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      540         end.
      541         else
      542         do:
      543           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      544         end.
      545       end.
      546       p-process = yes.
      547     end.
      548   end procedure.
      549   procedure prn-lib-get-report-name :
      550     define input parameter parParentProc  as widget-handle no-undo.
      551     define output parameter p-report-name as character no-undo .
      552     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      553   end procedure.
      554   procedure prn-lib-reportviewer-report-name :
