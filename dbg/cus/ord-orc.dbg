     4154             (" buf-OR_ord-doc.host-code = par-host-code and buf-OR_ord-doc.obj-code = p-obj-code and buf-OR_ord-doc.obj-type = p-obj-type and buf-OR_ord-doc.doc-type = p-doc-type  and buf-OR_ord-doc.status_= p-status_ " + " " + where-phrase-33 = "")
     4155         .
