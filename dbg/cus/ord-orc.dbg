     2072        self :read-only = false
     2073        )
     2074     then do:
     2075       if self :handle <> focus :handle
     2076       then do:
     2077         apply "entry":u to self .
     2078       end.
     2079       define variable v-curr-sv-date as date no-undo .
     2080       define variable v-new-sv-date  as date no-undo .
     2081       assign
     2082         v-curr-sv-date = date(self :screen-value) no-error
     2083       .
     2084       if v-curr-sv-date = ?
     2085       then do:
     2086         run gbl/getcurdt.p
     2087           (output v-curr-sv-date
     2088           ) .
     2089       end.
     2090       if v-curr-sv-date <> ?
     2091       then do:
     2092         assign
     2093           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2094         .
     2095         assign
     2096           self :screen-value = string(v-new-sv-date) .
     2097         .
     2098       end.
     2099     end.
     2100     return no-apply .
     2101   end.
     2102   on ctrl-e of sch-fact in frame Dialog-Frame
     2103   do:
     2104     if (can-query (self, "sensitive")
     2105        and
     2106        self :sensitive = true
     2107        )
     2108     or (can-query (self, "read-only")
     2109        and
     2110        self :read-only = false
     2111        )
     2112     then do:
     2113       if self :handle <> focus :handle
     2114       then do:
     2115         apply "entry":u to self .
     2116       end.
     2117       define variable v-curr-sv-date as date no-undo .
     2118       define variable v-new-sv-date  as date no-undo .
     2119       assign
     2120         v-curr-sv-date = date(self :screen-value) no-error
     2121       .
     2122       if v-curr-sv-date = ?
     2123       then do:
     2124         run gbl/getcurdt.p
     2125           (output v-curr-sv-date
     2126           ) .
     2127       end.
     2128       if v-curr-sv-date <> ?
     2129       then do:
     2130         run gbl/lastdate.p
     2131           (input  v-curr-sv-date
     2132           ,output v-new-sv-date
     2133           ).
     2134         assign
     2135           self :screen-value = string(v-new-sv-date) .
     2136         .
     2137       end.
     2138     end.
     2139     return no-apply .
     2140   end.
     2141   on ctrl-f of sch-fact in frame Dialog-Frame
     2142   do:
     2143     if (can-query (self, "sensitive")
     2144        and
     2145        self :sensitive = true
     2146        )
     2147     or (can-query (self, "read-only")
     2148        and
     2149        self :read-only = false
     2150        )
     2151     then do:
     2152       if self :handle <> focus :handle
     2153       then do:
     2154         apply "entry":u to self .
     2155       end.
     2156       define variable v-ok            as logical   no-undo .
     2157       define variable v-curr-sv-date  as date      no-undo .
     2158       define variable v-description   as character no-undo .
     2159       assign
     2160         v-curr-sv-date = date(self :screen-value) no-error
     2161       .
     2162       if v-curr-sv-date = ?
     2163       then do:
     2164         run gbl/getcurdt.p
     2165           (output v-curr-sv-date
     2166           ) .
     2167       end.
     2168       if v-curr-sv-date <> ?
     2169       then do:
     2170         run gbl/d-inpday.w
     2171           (input ?
     2172           ,input "Выбор даты"
     2173           ,input v-description
     2174           ,input ""
     2175           ,input-output v-curr-sv-date
     2176           ,output v-ok
     2177           ).
     2178         if v-ok = true
     2179         then do:
     2180           assign
     2181             self :screen-value = string(v-curr-sv-date) .
     2182           .
     2183         end.
     2184       end.
     2185     end.
     2186     return no-apply .
     2187   end.
     2188     define MENU m-ed-date25
     2189       MENU-ITEM m-ed-date25-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2190       MENU-ITEM m-ed-date25-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2191       MENU-ITEM m-ed-date25-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2192       MENU-ITEM m-ed-date25-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2193       .
     2194     if sch-fact :POPUP-MENU in frame Dialog-Frame = ?
     2195     then do:
     2196       ASSIGN
     2197         sch-fact :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date25 :HANDLE
     2198         sch-fact :MENU-MOUSE in frame Dialog-Frame = 3
     2199       .
     2200     end.
     2201     define variable v-label-handle25 as handle no-undo .
     2202     assign
     2203       v-label-handle25 = sch-fact :side-label-handle in frame Dialog-Frame
     2204     .
     2205     if valid-handle (v-label-handle25)
     2206     then do:
     2207       if v-label-handle25 :tooltip = ""
     2208       or v-label-handle25 :tooltip = ?
     2209       then do:
     2210         assign
     2211           v-label-handle25 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2212         .
     2213       end.
     2214     end.
     2215     ON CHOOSE OF MENU-ITEM m-ed-date25-1 in menu m-ed-date25 DO:
     2216       apply "ctrl-b":U to sch-fact in frame Dialog-Frame .
     2217     END.
     2218     ON CHOOSE OF MENU-ITEM m-ed-date25-2 in menu m-ed-date25 DO:
     2219       apply "ctrl-d":U to sch-fact in frame Dialog-Frame .
     2220     END.
     2221     ON CHOOSE OF MENU-ITEM m-ed-date25-3 in menu m-ed-date25 DO:
     2222       apply "ctrl-e":U to sch-fact in frame Dialog-Frame .
     2223     END.
     2224     ON CHOOSE OF MENU-ITEM m-ed-date25-4 in menu m-ed-date25 DO:
     2225       apply "ctrl-f":U to sch-fact in frame Dialog-Frame .
     2226     END.
     2227   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2228   on help of frame Dialog-Frame
     2229   do:
     2230     run gbl/app_help.p
     2231       (input this-procedure :file-name
     2232       ,input ''
     2233       ,input ?
     2234       ) no-error.
     2235     if error-status :error then do:
     2236       message
     2237         "Ошибка при вызове помощи"
     2238         error-status :get-message(1)
     2239         view-as alert-box .
     2240     end.
     2241   end.
     2242   run minbtn-set in this-procedure .
     2243   on choose of b-help in frame Dialog-Frame
     2244   do:
     2245     apply "help":u to frame Dialog-Frame .
     2246   end.
     2247   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2248   procedure minbtn-set :
     2249       do
     2250           on error undo, return error return-value
     2251           :
     2252           define variable ii              as integer       no-undo .
     2253           define variable fh              as widget-handle no-undo .
     2254           define variable hh              as widget-handle no-undo .
     2255           define variable v-h             as handle        extent 4 no-undo .
     2256           define variable v-name-button   as character     no-undo .
     2257           define variable v-help-old-x    as decimal       no-undo .
     2258           define variable v-help-old-y    as decimal       no-undo .
     2259           define variable v-help-old-size as decimal       no-undo .
     2260           define variable v-frame-width   as decimal       no-undo .
     2261           define variable jj              as integer       no-undo .
     2262           do
     2263               on error undo, return error
     2264               :
     2265               assign
     2266                   v-frame-width = frame Dialog-Frame:width - 0.3
     2267                   fh            = frame Dialog-Frame:first-child
     2268                   hh            = fh:first-child
     2269                   ii            = 1
     2270                   .
     2271               do while valid-handle(hh):
     2272                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2273                   do:
     2274                       case lc(hh:name) :
     2275                           when "b-help" then
     2276                               do:
     2277                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2278                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2279                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2280                                   hh:TOOLTIP = "Помощь" .
     2281                                   v-help-old-x = hh:column .
     2282                                   v-help-old-y = hh:row    .
     2283                                   v-help-old-size = hh:width .
     2284                                   hh:width-chars = 2.5 .
     2285                               end.
     2286                           when "b-print" then
     2287                               do:
     2288                                   hh:load-image("cmp/b-print.bmp":u) .
     2289                                   hh:TOOLTIP = "Печать" .
     2290                                   v-h[ii] = hh:handle .
     2291                                   ii = ii + 1 .
     2292                                   hh:width-chars = 3 .
     2293                               end.
     2294                           when "b-history" or
     2295                           when "b-hist" then
     2296                               do:
     2297                                   hh:load-image("cmp/b-hist.bmp":u) .
     2298                                   hh:TOOLTIP = "История" .
     2299                                   v-h[ii] = hh:handle .
     2300                                   ii = ii + 1 .
     2301                                   hh:width-chars = 3 .
     2302                               end.
     2303                           when "b-sch" then
     2304                               do:
     2305                                   hh:load-image("cmp/b-sch.bmp":u) .
     2306                                   hh:TOOLTIP = "Установка Фильтра" .
     2307                                   v-h[ii] = hh:handle .
     2308                                   ii = ii + 1 .
     2309                                   hh:width-chars = 3 .
     2310                               end.
     2311                           when "b-hist-user" then
     2312                               do:
     2313                                   hh:load-image("cmp/b-hist.bmp":u) .
     2314                                   hh:TOOLTIP = "История пользователя" .
     2315                                   ii = ii + 1 .
     2316                               end.
     2317                       end case.
     2318                   end.
     2319                   hh = hh:next-sibling.
     2320               end.
     2321               b-help:column = v-frame-width - b-help:width-chars.
     2322               jj = 0.
     2323               repeat ii = 4 to 1 by -1 :
     2324                   if valid-handle (v-h[ii] ) then
     2325                   do:
     2326                       jj  = jj + 1 .
     2327                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2328                       v-h[ii]:row    = v-help-old-y .
     2329                   end.
     2330               end.
     2331           end.
     2332       end.
     2333   end procedure.
     2334   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2335   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2336   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2337   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2338   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2339   define variable v-diasize-current-frame-height as decimal   no-undo .
     2340   define variable v-diasize-change-size          as logical   no-undo .
     2341   define variable v-diasize-resize-button        as handle    no-undo .
     2342   define variable v-diasize-wndmax               as logical   no-undo .
     2343   define variable v-diasize-wndstore             as logical   no-undo .
     2344   define variable v-diasize-proc-name            as character no-undo .
     2345   define variable v-diasize-browse-handle        as handle    no-undo .
     2346   define variable v-diasize-browse-number        as integer   no-undo .
     2347   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2348   define temp-table temp-diasize-handle no-undo
     2349     field handle-value  as handle
     2350     field save-position as decimal
     2351     index xpk is primary unique handle-value
     2352     .
     2353   define temp-table temp-browse-handle no-undo
     2354     field browse-type   as character
     2355     field browse-number as integer
     2356     field browse-handle as handle
     2357     field original-size as decimal
     2358     index xpk is primary unique browse-type browse-number
     2359     index xie browse-type browse-handle
     2360   .
     2361   procedure diasize_change-height :
     2362     define input  parameter p-change-value  as decimal   no-undo .
     2363     define input  parameter p-move-resize   as logical   no-undo .
     2364     define variable v-field-group-handle    as handle    no-undo .
     2365     define variable v-object-handle         as handle    no-undo .
     2366     define variable v-frame-height          as decimal   no-undo .
     2367     define variable v-frame-virtual-height  as decimal   no-undo .
     2368     define variable v-browse-height         as decimal   no-undo .
     2369     define variable v-window-height         as decimal   no-undo .
     2370     define variable v-window-virtual-height as decimal   no-undo .
     2371     define variable v-change-sign           as integer   no-undo .
     2372     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2373     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2374     if p-change-value > 0
     2375     then do:
     2376       if frame Dialog-Frame :height + p-change-value
     2377           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2378       then do:
     2379         assign
     2380           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2381                           - (frame Dialog-Frame :height-chars)
     2382         .
     2383         if p-change-value <= 0
     2384         then do:
     2385           run diasize_position-resize-button in this-procedure .
     2386           return .
     2387         end.
     2388       end.
     2389     end.
     2390     if p-change-value < 0
     2391     then do:
     2392       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2393       then do:
     2394         assign
     2395           p-change-value = v-diasize-orig-frame-height
     2396                          - (frame Dialog-Frame :height-chars)
     2397         .
     2398         if p-change-value >= 0
     2399         then do:
     2400           run diasize_position-resize-button in this-procedure .
     2401           return .
     2402         end.
     2403       end.
     2404     end.
     2405     if p-change-value >= 0
     2406     then do:
     2407       assign
     2408         v-change-sign = 1
     2409       .
     2410     end.
     2411     else do:
     2412       assign
     2413         v-change-sign = -1
     2414       .
     2415     end.
     2416     assign
     2417       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2418     .
     2419     if p-change-value = 0
     2420     then do:
     2421       run diasize_position-resize-button in this-procedure .
     2422       return .
     2423     end.
     2424     move_block:
     2425     do
     2426     on error undo move_block, retry move_block
     2427     :
     2428       if retry
     2429       then do:
     2430         do
     2431         on error undo move_block, leave move_block
     2432         :
     2433           if p-change-value > 0
     2434           then do:
     2435             for each buf_temp-diasize-handle
     2436             on error undo, next
     2437             :
     2438               assign
     2439                 v-object-handle = buf_temp-diasize-handle.handle-value
     2440               .
     2441               if v-object-handle <> v-diasize-resize-button
     2442               then do:
     2443                 assign
     2444                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2445                 .
     2446               end.
     2447             end.
     2448             assign
     2449               v-diasize-browse-handle :height = v-browse-height
     2450             .
     2451             for each buf_temp-browse-handle
     2452               where buf_temp-browse-handle.browse-type = 'height':u
     2453             on error undo, next
     2454             :
     2455               assign
     2456                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2457               .
     2458             end.
     2459             assign
     2460               frame Dialog-Frame :height = v-frame-height
     2461             .
     2462             if frame Dialog-Frame :scrollable = true
     2463             then do:
     2464               assign
     2465                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2466               .
     2467             end.
     2468             run diasize_position-resize-button in this-procedure .
     2469           end.
     2470           else do:
     2471             if frame Dialog-Frame :scrollable = true
     2472             then do:
     2473               assign
     2474                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2475               .
     2476             end.
     2477             assign
     2478               frame Dialog-Frame :height = v-frame-height
     2479             .
     2480             assign
     2481               v-diasize-browse-handle :height = v-browse-height
     2482             .
     2483             for each buf_temp-browse-handle
     2484               where buf_temp-browse-handle.browse-type = 'height':u
     2485             on error undo, next
     2486             :
     2487               assign
     2488                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2489               .
     2490             end.
     2491             for each buf_temp-diasize-handle
     2492             on error undo, next
     2493             :
     2494               assign
     2495                 v-object-handle = buf_temp-diasize-handle.handle-value
     2496               .
     2497               if v-object-handle <> v-diasize-resize-button
     2498               then do:
     2499                 assign
     2500                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2501                 .
     2502               end.
     2503             end.
     2504             run diasize_position-resize-button in this-procedure .
     2505           end.
     2506           assign
     2507             v-diasize-change-size = false
     2508           .
     2509           leave move_block .
     2510         end.
     2511       end.
     2512       assign
     2513         v-diasize-need-full-display = true
     2514       .
     2515       if v-diasize-change-size = false
     2516       then do:
     2517         assign
     2518           v-diasize-change-size = true
     2519         .
     2520       end.
     2521       else do:
     2522         return .
     2523       end.
     2524       assign
     2525         v-frame-height = frame Dialog-Frame :height
     2526         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2527         v-browse-height = v-diasize-browse-handle :height
     2528       .
     2529       for each buf_temp-browse-handle
     2530         where buf_temp-browse-handle.browse-type = 'height':u
     2531       :
     2532         assign
     2533           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2534         .
     2535       end.
     2536       for each buf_temp-diasize-handle
     2537       :
     2538         delete buf_temp-diasize-handle .
     2539       end.
     2540       assign
     2541         v-field-group-handle = frame Dialog-Frame :first-child
     2542       .
     2543       do while valid-handle(v-field-group-handle)
     2544       :
     2545         assign
     2546           v-object-handle = v-field-group-handle :first-child
     2547         .
     2548         do while valid-handle(v-object-handle)
     2549         :
     2550           if  v-object-handle <> v-diasize-browse-handle :handle
     2551           and can-query(v-object-handle, "row")
     2552           and can-query(v-object-handle, "height")
     2553           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2554           then do:
     2555             find first buf_temp-browse-handle
     2556               where buf_temp-browse-handle.browse-type   = 'height':u
     2557                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2558               no-error .
     2559             if available buf_temp-browse-handle
     2560             then do:
     2561             end.
     2562             else do:
     2563               create buf_temp-diasize-handle .
     2564               assign
     2565                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2566                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2567               .
     2568             end.
     2569           end.
     2570           assign
     2571             v-object-handle = v-object-handle :next-sibling
     2572           .
     2573         end.
     2574         assign
     2575           v-field-group-handle = v-field-group-handle :next-sibling
     2576         .
     2577       end.
     2578       do with frame Dialog-Frame
     2579       :
     2580         hide v-diasize-resize-button .
     2581         assign
     2582           v-diasize-resize-button :row    = 1
     2583           v-diasize-resize-button :column = 1
     2584         .
     2585       end.
     2586       if p-change-value > 0
     2587       then do:
     2588         if frame Dialog-Frame :scrollable = true
     2589         then do:
     2590           assign
     2591             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2592             no-error .
     2593           if error-status :error
     2594           or error-status :get-message(1) <> ""
     2595           then do:
     2596             undo move_block, retry move_block .
     2597           end.
     2598         end.
     2599         assign
     2600           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2601           no-error .
     2602         if error-status :error
     2603         or error-status :get-message(1) <> ""
     2604         then do:
     2605           undo move_block, retry move_block .
     2606         end.
     2607         assign
     2608           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2609           no-error .
     2610         if error-status :error
     2611         or error-status :get-message(1) <> ""
     2612         then do:
     2613           undo move_block, retry move_block .
     2614         end.
     2615         for each buf_temp-browse-handle
     2616           where buf_temp-browse-handle.browse-type = 'height':u
     2617         on error undo move_block, retry move_block
     2618         :
     2619           assign
     2620             buf_temp-browse-handle.browse-handle :height
     2621               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2622             no-error .
     2623           if error-status :error
     2624           or error-status :get-message(1) <> ""
     2625           then do:
     2626             undo move_block, retry move_block .
     2627           end.
     2628         end.
     2629         for each buf_temp-diasize-handle
     2630         on error undo move_block, retry move_block
     2631         :
     2632           assign
     2633             v-object-handle = buf_temp-diasize-handle.handle-value
     2634           .
     2635           if v-object-handle <> v-diasize-resize-button
     2636           then do:
     2637             assign
     2638               v-object-handle :row = v-object-handle :row + p-change-value
     2639               no-error .
     2640             if error-status :error
     2641             or error-status :get-message(1) <> ""
     2642             then do:
     2643               undo move_block, retry move_block .
     2644             end.
     2645           end.
     2646         end.
     2647       end.
     2648       else do:
     2649         for each buf_temp-diasize-handle
     2650         on error undo move_block, retry move_block
     2651         :
     2652           assign
     2653             v-object-handle = buf_temp-diasize-handle.handle-value
     2654           .
     2655           if v-object-handle <> v-diasize-resize-button
     2656           then do:
     2657             assign
     2658               v-object-handle :row = v-object-handle :row + p-change-value
     2659               no-error .
     2660             if error-status :error
     2661             or error-status :get-message(1) <> ""
     2662             then do:
     2663               undo move_block, retry move_block .
     2664             end.
     2665           end.
     2666         end.
     2667         assign
     2668           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2669           no-error .
     2670         if error-status :error
     2671         or error-status :get-message(1) <> ""
     2672         then do:
     2673           undo move_block, retry move_block .
     2674         end.
     2675         for each buf_temp-browse-handle
     2676           where buf_temp-browse-handle.browse-type = 'height':u
     2677         on error undo move_block, retry move_block
     2678         :
     2679           assign
     2680             buf_temp-browse-handle.browse-handle :height
     2681               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2682             no-error .
     2683           if error-status :error
     2684           or error-status :get-message(1) <> ""
     2685           then do:
     2686             undo move_block, retry move_block .
     2687           end.
     2688         end.
     2689         assign
     2690           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2691           no-error .
     2692         if error-status :error
     2693         or error-status :get-message(1) <> ""
     2694         then do:
     2695           undo move_block, retry move_block .
     2696         end.
     2697         if frame Dialog-Frame :scrollable = true
     2698         then do:
     2699           assign
     2700             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2701             no-error .
     2702           if error-status :error
     2703           or error-status :get-message(1) <> ""
     2704           then do:
     2705             undo move_block, retry move_block .
     2706           end.
     2707         end.
     2708       end.
     2709       if p-move-resize = true
     2710       then do:
     2711         run diasize_position-resize-button in this-procedure .
     2712       end.
     2713       if v-diasize-wndstore = true
     2714       then do:
     2715         if connected("ub") = true
     2716         then do:
     2717           define variable v-cntxt-db-num        as integer   no-undo .
     2718           define variable v-cntxt-userid        as character no-undo .
     2719           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2720                                             , OUTPUT v-cntxt-userid
     2721                                             ) .
     2722           run gbl/wndsizew.p
     2723             (input  v-cntxt-db-num
     2724             ,input  v-cntxt-userid
     2725             ,input  v-diasize-proc-name
     2726             ,input  'height':u
     2727             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2728             ) .
     2729         end.
     2730       end.
     2731     end.
     2732     assign
     2733       v-diasize-change-size = false
     2734     .
     2735   end procedure.
     2736   procedure diasize_set-height :
     2737     define input  parameter p-new-height  as decimal   no-undo .
     2738     define input  parameter p-move-resize as logical   no-undo .
     2739     do
     2740     on error undo, return error return-value
     2741     :
     2742       run diasize_change-height in this-procedure
     2743         (input  (p-new-height - frame Dialog-Frame :height)
     2744         ,input  p-move-resize
     2745         ) .
     2746     end.
     2747   end procedure.
     2748   procedure diasize_change-width :
     2749     define input  parameter p-change-value as decimal   no-undo .
     2750     define input  parameter p-move-resize  as logical   no-undo .
     2751     define variable v-field-group-handle   as handle    no-undo .
     2752     define variable v-object-handle        as handle    no-undo .
     2753     define variable v-frame-width          as decimal   no-undo .
     2754     define variable v-frame-virtual-width  as decimal   no-undo .
     2755     define variable v-browse-width         as decimal   no-undo .
     2756     define variable v-window-width         as decimal   no-undo .
     2757     define variable v-window-virtual-width as decimal   no-undo .
     2758     define variable v-change-sign          as integer   no-undo .
     2759     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2760     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2761     if p-change-value > 0
     2762     then do:
     2763       if frame Dialog-Frame :width + p-change-value >
     2764           session :width-chars
     2765       then do:
     2766         assign
     2767           p-change-value = session :width-chars - frame Dialog-Frame :width
     2768         .
     2769         if p-change-value <= 0
     2770         then do:
     2771           run diasize_position-resize-button in this-procedure .
     2772           return .
     2773         end.
     2774       end.
     2775     end.
     2776     if p-change-value < 0
     2777     then do:
     2778       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2779       then do:
     2780         assign
     2781           p-change-value = v-diasize-orig-frame-width
     2782                          - frame Dialog-Frame :width
     2783         .
     2784         if p-change-value >= 0
     2785         then do:
     2786           run diasize_position-resize-button in this-procedure .
     2787           return .
     2788         end.
     2789       end.
     2790     end.
     2791     if p-change-value >= 0
     2792     then do:
     2793       assign
     2794         v-change-sign = 1
     2795       .
     2796     end.
     2797     else do:
     2798       assign
     2799         v-change-sign = -1
     2800       .
     2801     end.
     2802     assign
     2803       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2804     .
     2805     if p-change-value = 0
     2806     then do:
     2807       run diasize_position-resize-button in this-procedure .
     2808       return .
     2809     end.
     2810     move_block:
     2811     do
     2812     on error undo move_block, leave move_block
     2813     :
     2814       if retry
     2815       then do:
     2816         do
     2817         on error undo move_block, leave move_block
     2818         :
     2819           if p-change-value > 0
     2820           then do:
     2821             for each buf_temp-diasize-handle
     2822             on error undo, next
     2823             :
     2824               assign
     2825                 v-object-handle = buf_temp-diasize-handle.handle-value
     2826               .
     2827               if v-object-handle <> v-diasize-resize-button
     2828               then do:
     2829                 assign
     2830                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2831                 .
     2832               end.
     2833             end.
     2834             assign
     2835               v-diasize-browse-handle :width = v-browse-width
     2836             .
     2837             for each buf_temp-browse-handle
     2838               where buf_temp-browse-handle.browse-type = 'width':u
     2839             on error undo, next
     2840             :
     2841               assign
     2842                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2843               .
     2844             end.
     2845             assign
     2846               frame Dialog-Frame :width = v-frame-width
     2847             .
     2848             if frame Dialog-Frame :scrollable = true
     2849             then do:
     2850               assign
     2851                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2852               .
     2853             end.
     2854             run diasize_position-resize-button in this-procedure .
     2855           end.
     2856           else do:
     2857             if frame Dialog-Frame :scrollable = true
     2858             then do:
     2859               assign
     2860                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2861               .
     2862             end.
     2863             assign
     2864               frame Dialog-Frame :width = v-frame-width
     2865             .
     2866             for each buf_temp-browse-handle
     2867               where buf_temp-browse-handle.browse-type = 'width':u
     2868             on error undo, next
     2869             :
     2870               assign
     2871                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2872               .
     2873             end.
     2874             assign
     2875               v-diasize-browse-handle :width = v-browse-width
     2876             .
     2877             for each buf_temp-diasize-handle
     2878             on error undo, next
     2879             :
     2880               assign
     2881                 v-object-handle = buf_temp-diasize-handle.handle-value
     2882               .
     2883               if v-object-handle <> v-diasize-resize-button
     2884               then do:
     2885                 assign
     2886                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2887                 .
     2888               end.
     2889             end.
     2890             run diasize_position-resize-button in this-procedure .
     2891           end.
     2892           assign
     2893             v-diasize-change-size = false
     2894           .
     2895           leave move_block .
     2896         end.
     2897       end.
     2898       assign
     2899         v-diasize-need-full-display = true
     2900       .
     2901       if v-diasize-change-size = false
     2902       then do:
     2903         assign
     2904           v-diasize-change-size = true
     2905         .
     2906       end.
     2907       else do:
     2908         return .
     2909       end.
     2910       assign
     2911         v-frame-width = frame Dialog-Frame :width
     2912         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2913         v-browse-width = v-diasize-browse-handle :width
     2914       .
     2915       for each buf_temp-browse-handle
     2916         where buf_temp-browse-handle.browse-type = 'width':u
     2917       :
     2918         assign
     2919           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2920         .
     2921       end.
     2922       for each buf_temp-diasize-handle
     2923       :
     2924         delete buf_temp-diasize-handle .
     2925       end.
     2926       assign
     2927         v-field-group-handle = frame Dialog-Frame :first-child
     2928       .
     2929       do while valid-handle(v-field-group-handle)
     2930       :
     2931         assign
     2932           v-object-handle = v-field-group-handle :first-child
     2933         .
     2934         do while valid-handle(v-object-handle)
     2935         :
     2936           if  v-object-handle <> v-diasize-browse-handle :handle
     2937           and v-object-handle <> v-diasize-resize-button
     2938           and can-query(v-object-handle, "row")
     2939           and can-query(v-object-handle, "height")
     2940           and ( v-object-handle :col + v-object-handle :width
     2941                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2942               )
     2943           then do:
     2944             find first buf_temp-browse-handle
     2945               where buf_temp-browse-handle.browse-type   = 'width':u
     2946                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2947               no-error .
     2948             if available buf_temp-browse-handle
     2949             then do:
     2950             end.
     2951             else do:
     2952               create buf_temp-diasize-handle .
     2953               assign
     2954                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2955                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2956               .
     2957             end.
     2958           end.
     2959           assign
     2960             v-object-handle = v-object-handle :next-sibling
     2961           .
     2962         end.
     2963         assign
     2964           v-field-group-handle = v-field-group-handle :next-sibling
     2965         .
     2966       end.
     2967       do with frame Dialog-Frame
     2968       :
     2969         hide v-diasize-resize-button .
     2970         v-diasize-resize-button :row = 1.
     2971         v-diasize-resize-button :column = 1.
     2972       end.
     2973       if p-change-value > 0
     2974       then do:
     2975         if frame Dialog-Frame :scrollable = true
     2976         then do:
     2977           assign
     2978             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2979             no-error .
     2980           if error-status :error
     2981           or error-status :get-message(1) <> ""
     2982           then do:
     2983             undo move_block, retry move_block.
     2984           end.
     2985         end.
     2986         assign
     2987           frame Dialog-Frame :width = v-frame-width + p-change-value
     2988           no-error .
     2989         if error-status :error
     2990         or error-status :get-message(1) <> ""
     2991         then do:
     2992           undo move_block, retry move_block.
     2993         end.
     2994         assign
     2995           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2996         no-error .
     2997         if error-status :error
     2998         or error-status :get-message(1) <> ""
     2999         then do:
     3000           undo move_block, retry move_block.
     3001         end.
     3002         for each buf_temp-browse-handle
     3003           where buf_temp-browse-handle.browse-type = 'width':u
     3004         on error undo move_block, retry move_block
     3005         :
     3006           assign
     3007             buf_temp-browse-handle.browse-handle :width
     3008               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3009             no-error .
     3010           if error-status :error
     3011           or error-status :get-message(1) <> ""
     3012           then do:
     3013             undo move_block, retry move_block .
     3014           end.
     3015         end.
     3016         for each buf_temp-diasize-handle
     3017         on error undo move_block, retry move_block
     3018         :
     3019           assign
     3020             v-object-handle = buf_temp-diasize-handle.handle-value
     3021           .
     3022           if v-object-handle <> v-diasize-resize-button
     3023           then do:
     3024             assign
     3025               v-object-handle :col = v-object-handle :col + p-change-value
     3026               no-error .
     3027             if error-status :error
     3028             or error-status :get-message(1) <> ""
     3029             then do:
     3030               undo move_block, retry move_block .
     3031             end.
     3032           end.
     3033         end.
     3034       end.
     3035       else do:
     3036         for each buf_temp-diasize-handle
     3037         on error undo move_block, retry move_block
     3038         :
     3039           assign
     3040             v-object-handle = buf_temp-diasize-handle.handle-value
     3041           .
     3042           if v-object-handle <> v-diasize-resize-button
     3043           then do:
     3044             assign
     3045               v-object-handle :col = v-object-handle :col + p-change-value
     3046               no-error .
     3047             if error-status :error
     3048             or error-status :get-message(1) <> ""
     3049             then do:
     3050               undo move_block, retry move_block .
     3051             end.
     3052           end.
     3053         end.
     3054         for each buf_temp-browse-handle
     3055           where buf_temp-browse-handle.browse-type = 'width':u
     3056         on error undo move_block, retry move_block
     3057         :
     3058           assign
     3059             buf_temp-browse-handle.browse-handle :width
     3060               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3061             no-error .
     3062           if error-status :error
     3063           or error-status :get-message(1) <> ""
     3064           then do:
     3065             undo move_block, retry move_block .
     3066           end.
     3067         end.
     3068         assign
     3069           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3070           no-error .
     3071         if error-status :error
     3072         or error-status :get-message(1) <> ""
     3073         then do:
     3074           undo move_block, retry move_block.
     3075         end.
     3076         assign
     3077           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3078         no-error .
     3079         if error-status :error
     3080         or error-status :get-message(1) <> ""
     3081         then do:
     3082           undo move_block, retry move_block.
     3083         end.
     3084         if frame Dialog-Frame :scrollable = true
     3085         then do:
     3086           assign
     3087             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3088           no-error .
     3089           if error-status :error
     3090           or error-status :get-message(1) <> ""
     3091           then do:
     3092             undo move_block, retry move_block.
     3093           end.
     3094         end.
     3095       end.
     3096       if p-move-resize
     3097       then do:
     3098         run diasize_position-resize-button in this-procedure .
     3099       end.
     3100       if v-diasize-wndstore = true
     3101       then do:
     3102         if connected("ub") = true
     3103         then do:
     3104           define variable v-cntxt-db-num        as integer   no-undo .
     3105           define variable v-cntxt-userid        as character no-undo .
     3106           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3107                                             , OUTPUT v-cntxt-userid
     3108                                             ) .
     3109           run gbl/wndsizew.p
     3110             (input  v-cntxt-db-num
     3111             ,input  v-cntxt-userid
     3112             ,input  v-diasize-proc-name
     3113             ,input  'width':u
     3114             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3115             ) .
     3116         end.
     3117       end.
     3118     end.
     3119     assign
     3120       v-diasize-change-size = false
     3121     .
     3122   end procedure.
     3123   procedure diasize_set-width :
     3124     define input  parameter p-new-width  as decimal   no-undo .
     3125     define input  parameter p-move-resize as logical   no-undo .
     3126     do
     3127     on error undo, return error return-value
     3128     :
     3129       run diasize_change-width in this-procedure
     3130         (input  (p-new-width - frame Dialog-Frame :width)
     3131         ,input  p-move-resize
     3132         ) .
     3133     end.
     3134   end procedure.
     3135   procedure diasize_position-resize-button :
     3136     do with frame Dialog-Frame
     3137     :
     3138       hide v-diasize-resize-button .
     3139       assign
     3140         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3141                     - 1
     3142                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3143         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3144                     - 1
     3145                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3146       .
     3147       view v-diasize-resize-button .
     3148     end.
     3149   end procedure.
     3150   on alt-right anywhere
     3151   do:
     3152     run diasize_change-width in this-procedure
     3153       (input 1
     3154       ,input true
     3155       ) .
     3156     return no-apply .
     3157   end.
     3158   on alt-left anywhere
     3159   do:
     3160     run diasize_change-width in this-procedure
     3161       (input -1
     3162       ,input true
     3163       ) .
     3164     return no-apply .
     3165   end.
     3166   on alt-down anywhere
     3167   do:
     3168     run diasize_change-height in this-procedure
     3169       (input 1
     3170       ,input true
     3171       ) .
     3172     return no-apply .
     3173   end.
     3174   on alt-up anywhere
     3175   do:
     3176     run diasize_change-height in this-procedure
     3177       (input -1
     3178       ,input true
     3179       ) .
     3180     return no-apply .
     3181   end.
     3182   on alt-enter of frame Dialog-Frame
     3183   do:
     3184     run diasize_maximize in this-procedure
     3185       (input  ?
     3186       ).
     3187     return no-apply .
     3188   end.
     3189   procedure diasize_end-move :
     3190     do
     3191     on error undo, return error return-value
     3192     :
     3193       define variable v-row-delta as decimal   no-undo .
     3194       define variable v-col-delta as decimal   no-undo .
     3195       define variable v-new-row as decimal   no-undo .
     3196       define variable v-new-col as decimal   no-undo .
     3197       assign
     3198         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3199         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3200       .
     3201       assign
     3202         v-row-delta = v-new-row - frame Dialog-Frame :height
     3203         v-col-delta = v-new-col - frame Dialog-Frame :width
     3204       .
     3205       run diasize_change-height in this-procedure
     3206         (input v-row-delta
     3207         ,input true
     3208         ) .
     3209       run diasize_change-width in this-procedure
     3210         (input v-col-delta
     3211         ,input true
     3212         ) .
     3213     end.
     3214   end procedure.
     3215   procedure diasize_maximize :
     3216     define input  parameter p-action as logical   no-undo .
     3217     do
     3218     on error undo, return error return-value
     3219     :
     3220       if p-action = ?
     3221       then do:
     3222         if v-diasize-need-maximize = true
     3223         then do:
     3224           assign
     3225             p-action = true
     3226           .
     3227         end.
     3228         else do:
     3229           assign
     3230             p-action = false
     3231           .
     3232         end.
     3233       end.
     3234       if p-action = true
     3235       then do:
     3236         run diasize_change-height in this-procedure
     3237           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3238               - frame Dialog-Frame :height-chars
     3239           ,input true
     3240           ) .
     3241         run diasize_change-width in this-procedure
     3242           (input session :width-chars
     3243               - frame Dialog-Frame :width-chars
     3244           ,input true
     3245           ) .
     3246         assign
     3247           v-diasize-need-maximize = false
     3248         .
     3249       end.
     3250       else do:
     3251         run diasize_change-width in this-procedure
     3252           (input v-diasize-orig-frame-width
     3253               - frame Dialog-Frame :width-chars
     3254           ,input true
     3255           ) .
     3256         run diasize_change-height in this-procedure
     3257           (input v-diasize-orig-frame-height
     3258               - frame Dialog-Frame :height-chars
     3259           ,input true
     3260           ) .
     3261         assign
     3262           v-diasize-need-maximize = true
     3263         .
     3264       end.
     3265     end.
     3266   end procedure.
     3267   procedure diasize_restore-orig-size :
     3268     do
     3269     on error undo, return error return-value
     3270     :
     3271       assign
     3272         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3273         v-diasize-current-frame-height = frame Dialog-Frame :height
     3274       .
     3275       run diasize_set-height in this-procedure
     3276         (input  v-diasize-orig-frame-height
     3277         ,input  true
     3278         ) .
     3279       run diasize_set-width in this-procedure
     3280         (input  v-diasize-orig-frame-width
     3281         ,input  true
     3282         ) .
     3283     end.
     3284   end procedure.
     3285   procedure diasize_restore-current-size :
     3286     do
     3287     on error undo, return error return-value
     3288     :
     3289       run diasize_set-height in this-procedure
     3290         (input  v-diasize-current-frame-height
     3291         ,input  true
     3292         ) .
     3293       run diasize_set-width in this-procedure
     3294         (input  v-diasize-current-frame-width
     3295         ,input  true
     3296         ) .
     3297     end.
     3298   end procedure.
     3299   procedure diasize_set-browse-handle :
     3300     define input  parameter p-browse-handle as handle   no-undo .
     3301     define buffer buf_temp-browse-handle for temp-browse-handle .
     3302     do
     3303     on error undo, return error return-value
     3304     :
     3305       assign
     3306         v-diasize-browse-handle = p-browse-handle
     3307       .
     3308       for each buf_temp-browse-handle
     3309       on error undo, return error return-value
     3310       :
     3311         delete buf_temp-browse-handle .
     3312       end.
     3313     end.
     3314   end procedure.
     3315   procedure diasize_add_browse :
     3316     define input  parameter p-browse-type   as character no-undo .
     3317     define input  parameter p-browse-handle as handle    no-undo .
     3318     define buffer buf_temp-browse-handle for temp-browse-handle .
     3319     do
     3320     on error undo, return error return-value
     3321     :
     3322       assign
     3323         v-diasize-browse-number = v-diasize-browse-number + 1
     3324       .
     3325       create buf_temp-browse-handle .
     3326       assign
     3327         buf_temp-browse-handle.browse-type   = p-browse-type
     3328         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3329         buf_temp-browse-handle.browse-handle = p-browse-handle
     3330       .
     3331     end.
     3332   end procedure.
     3333   procedure diasize_init :
     3334     define variable v-default-value    as logical   no-undo .
     3335     define variable v-restore-saved    as logical   no-undo .
     3336     define variable v-resize-value-str as character no-undo .
     3337     do
     3338     on error undo, return error return-value
     3339     :
     3340       do with frame Dialog-Frame
     3341       :
     3342         assign
     3343           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3344           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3345           v-diasize-browse-handle     = browse BR-docs :handle
     3346         .
     3347         create button v-diasize-resize-button
     3348         assign
     3349           parent        = frame Dialog-Frame :first-child
     3350           label         = "s"
     3351           height-pixels = 16
     3352           width-pixels  = 16
     3353           visible       = true
     3354           sensitive     = true
     3355           movable       = true
     3356           triggers:
     3357             on end-move persistent run diasize_end-move in this-procedure .
     3358           end triggers.
     3359         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3360         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3361         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3362         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3363         assign
     3364           v-diasize-wndmax = false
     3365         .
     3366         if connected("ub") = true
     3367         then do:
     3368           define variable v-cntxt-db-num        as integer   no-undo .
     3369           define variable v-cntxt-userid        as character no-undo .
     3370           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3371                                             , OUTPUT v-cntxt-userid
     3372                                             ) .
     3373           run gbl/wndpar_r.p
     3374             (input  v-cntxt-db-num
     3375             ,input  v-cntxt-userid
     3376             ,input  'wndmax':U
     3377             ,output v-diasize-wndmax
     3378             ,output v-default-value
     3379             ) .
     3380         end.
     3381         assign
     3382           v-diasize-wndstore = false
     3383         .
     3384         if connected("ub") = true
     3385         then do:
     3386           run gbl/wndpar_r.p
     3387             (input  v-cntxt-db-num
     3388             ,input  v-cntxt-userid
     3389             ,input  'wndstore':U
     3390             ,output v-diasize-wndstore
     3391             ,output v-default-value
     3392             ) .
     3393         end.
     3394         assign
     3395           v-diasize-proc-name = entry(1, program-name(2), '.')
     3396         .
     3397         if v-diasize-wndstore = true
     3398         then do:
     3399           assign
     3400             v-restore-saved = false
     3401           .
     3402           if connected("ub") = true
     3403           then do:
     3404             run gbl/wndsizer.p
     3405               (input  v-cntxt-db-num
     3406               ,input  v-cntxt-userid
     3407               ,input  v-diasize-proc-name
     3408               ,input  'height':u
     3409               ,output v-resize-value-str
     3410               ) .
     3411             if v-resize-value-str <> '':U
     3412             then do:
     3413               run diasize_change-height in this-procedure
     3414                 (input  integer(v-resize-value-str)
     3415                 ,input  true
     3416                 ) .
     3417               assign
     3418                 v-restore-saved = true
     3419               .
     3420             end.
     3421           end.
     3422           if connected("ub") = true
     3423           then do:
     3424             run gbl/wndsizer.p
     3425               (input  v-cntxt-db-num
     3426               ,input  v-cntxt-userid
     3427               ,input  v-diasize-proc-name
     3428               ,input  'width':u
     3429               ,output v-resize-value-str
     3430               ) .
     3431             if v-resize-value-str <> '':U
     3432             then do:
     3433               run diasize_change-width in this-procedure
     3434                 (input  integer(v-resize-value-str)
     3435                 ,input  true
     3436                 ) .
     3437               assign
     3438                 v-restore-saved = true
     3439               .
     3440             end.
     3441           end.
     3442           if v-restore-saved <> true
     3443           then do:
     3444             if v-diasize-wndmax = true
     3445             then do:
     3446               run diasize_maximize in this-procedure
     3447                 (input  true
     3448                 ) .
     3449             end.
     3450           end.
     3451         end.
     3452         else do:
     3453           if v-diasize-wndmax = true
     3454           then do:
     3455             run diasize_maximize in this-procedure
     3456               (input  true
     3457               ) .
     3458           end.
     3459         end.
     3460       end.
     3461     end.
     3462   end procedure.
     3463   procedure diasize_need-full-display :
     3464     define output parameter p-need-full-display as logical   no-undo .
     3465     do
     3466     on error undo, return error return-value
     3467     :
     3468       assign
     3469         p-need-full-display = v-diasize-need-full-display
     3470       .
     3471       assign
     3472         v-diasize-need-full-display = false
     3473       .
     3474     end.
     3475   end procedure.
     3476   procedure get-context :
     3477      define output parameter p-db-num as integer          no-undo.
     3478      define output parameter p-user-id as character        no-undo.
     3479      define variable v-login               as character    no-undo.
     3480      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3481      define buffer buf_user-login  for ub.user-login .
     3482      do
     3483      on error undo, return error
     3484      :
     3485            FIND FIRST buf_sys-ctrl no-lock.
     3486            ASSIGN
     3487               v-login = USERID("ub")
     3488               p-db-num = buf_sys-ctrl.db-num
     3489            .
     3490            FIND FIRST buf_user-login
     3491                 WHERE buf_user-login.db-num = p-db-num
     3492                   AND buf_user-login.user-login = v-login
     3493                 no-lock
     3494                 no-error
     3495                 .
     3496            IF AVAILABLE buf_user-login
     3497            THEN DO:
     3498               assign
     3499                  p-user-id = buf_user-login.user-id
     3500               .
     3501            END.
     3502      end.
     3503   end procedure.
     3504   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3505   DEF VAR cur-clmn-numbr-docs as INT EXTENT 10 no-undo.
     3506   DEF VAR varmvibr-docs       as INT no-undo.
     3507   DEF VAR varmvjbr-docs       as INT no-undo.
     3508   DEF VAR varmvkbr-docs       as INT no-undo.
     3509   DEF VAR varmvlbr-docs       as INT no-undo.
     3510   DEF VAR move-elementbr-docs as INT no-undo.
     3511   def var jjbr-docs           as int no-undo.
     3512   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3513     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3514   END.
     3515   RUN start-mv-clmnbr-docs.
     3516   PROCEDURE start-mv-clmnbr-docs:
     3517   def var old-session as logical no-undo.
     3518      old-session = SESSION:IMMEDIATE-DISPLAY.
     3519      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3520      SESSION:IMMEDIATE-DISPLAY = old-session.
     3521   END.
     3522   ON ctrl-cursor-right OF BROWSE br-docs do:
     3523     RUN re-move-clmnbr-docs ( 5, 10).
     3524   END.
     3525   ON ctrl-cursor-left OF BROWSE br-docs do:
     3526     RUN re-move-clmnbr-docs (10, 5).
     3527   END.
     3528   PROCEDURE re-move-clmnbr-docs:
     3529     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3530     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3531     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3532       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3533     END.
     3534     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3535     if source-column > target-column THEN
     3536     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3537       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3538           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3539             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3540           END.
     3541       END.
     3542     END.
     3543     ELSE
     3544     DO varmvjbr-docs = source-column + 1 to target-column:
     3545       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3546         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3547           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3548         END.
     3549       END.
     3550     END.
     3551     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3552       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3553     END.
     3554   END PROCEDURE.
     3555   PROCEDURE ch-clmnbr-docs:
     3556     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3557     if cur-clmn-loc <= 5 then do:
     3558       return .
     3559     end.
     3560     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3561       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3562     END.
     3563     RUN re-move-clmnbr-docs (cur-clmn-loc, 5).
     3564   END PROCEDURE.
     3565   PROCEDURE mv-brw-defaultbr-docs:
     3566   def var old-session as logical no-undo.
     3567     old-session = SESSION:IMMEDIATE-DISPLAY.
     3568     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3569     do varmvlbr-docs = 5 to EXTENT(cur-clmn-numbr-docs):
     3570       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3571     END.
     3572     RUN start-mv-clmnbr-docs.
     3573     SESSION:IMMEDIATE-DISPLAY = old-session.
     3574   END PROCEDURE.
     3575   .
     3576   def var sort-labelbr-docs   as character no-undo .
     3577   def var sort-clmnbr-docs    as handle    no-undo .
     3578   def var cur-clmnbr-docs     as handle    no-undo .
     3579   def var cur-clmn-locbr-docs as integer   no-undo .
     3580   def var re-querybr-docs     as logical   initial no no-undo .
     3581   on start-search, ctrl-o of br-docs in frame Dialog-Frame do:
     3582      run sort-brbr-docs
     3583        (input (if available buf-OR_ord-doc
     3584                then recid(buf-OR_ord-doc)
     3585                else ?
     3586               )
     3587        ).
     3588   end.
     3589   PROCEDURE sort-brbr-docs :
     3590     define input parameter p-recid as recid no-undo .
     3591     if re-querybr-docs = no then do:
     3592       assign
     3593          cur-clmnbr-docs = br-docs:current-column in frame Dialog-Frame
     3594       .
     3595       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     3596       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     3597         assign
     3598            sort-labelbr-docs = ""
     3599            sort-clmnbr-docs = ?
     3600         .
     3601        end.
     3602        else do:
     3603          assign
     3604            sort-labelbr-docs = cur-clmnbr-docs:label
     3605            sort-clmnbr-docs  = cur-clmnbr-docs
     3606            sort-clmnbr-docs:column-fgcolor = 4
     3607          .
     3608        end.
     3609      end.
     3610     assign
     3611       cur-clmn-locbr-docs = 1
     3612     .
     3613     def var column-handle as handle no-undo .
     3614     column-handle = br-docs:first-column.
     3615     do while valid-handle(column-handle) :
     3616       if column-handle = cur-clmnbr-docs then do:
     3617         leave .
     3618       end.
     3619       column-handle = column-handle:NEXT-COLUMN.
     3620       assign
     3621         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     3622       .
     3623     end.
     3624     case sort-labelbr-docs:
     3625           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf-or_ord-doc), &1&2&1)', chr(34), rid-list)     .     run OpenBr(yes, no, '':U).   . END.
     3626           when 'Статус'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.status_"     .     run OpenBr(yes, no, '':U).   . END.
     3627           when 'OK'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.flag_"     .     run OpenBr(yes, no, '':U).   . END.
     3628           when '№ док-та'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3629           when 'Создан'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     3630           when 'Факт'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3631           when 'Объект'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.obj-code"     .     run OpenBr(yes, no, '':U).   . END.
     3632           when 'Тип'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.obj-type"     .     run OpenBr(yes, no, '':U).   . END.
     3633           when 'РЦ'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.cli-type + string (buf-OR_ord-doc.cli-code)"     .     run OpenBr(yes, no, '':U).   . END.
     3634           when 'Количество'  then DO:    assign       sort-column-name = "buf-OR_ord-doc.qnty"     .     run OpenBr(yes, no, '':U).   . END.
     3635           when '>'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-direct&1, recid(buf-or_ord-doc))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3636           when 'Наименование'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-nameo&1, recid(buf-or_ord-doc))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3637       otherwise do:
     3638         assign
     3639           sort-column-name = ""
     3640         .
     3641         run OpenBr(yes, no, '':U).
     3642           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     3643             run mv-brw-defaultbr-docs.
     3644           end.
     3645         if sort-labelbr-docs <> "" then do:
     3646           assign
     3647             cur-clmnbr-docs:column-fgcolor = 0
     3648           .
     3649         end.
     3650         assign
     3651           cur-clmn-locbr-docs = ?
     3652         .
     3653       end.
     3654     end case.
     3655       if cur-clmn-locbr-docs <> ? then do:
     3656         if can-do( this-procedure:internal-entries, 'ch-clmnbr-docs') then do:
     3657           run ch-clmnbr-docs in this-procedure (cur-clmn-locbr-docs).
     3658         end.
     3659       end.
     3660     if p-recid <> ? then do:
     3661       reposition br-docs to recid p-recid no-error.
     3662       apply "value-changed" to br-docs in frame Dialog-Frame.
     3663     end.
     3664     apply "entry" to br-docs in frame Dialog-Frame.
     3665   END PROCEDURE.
     3666   procedure re-open-query-srt-clmnbr-docs:
     3667   if cur-clmnbr-docs = ? then do:
     3668      run OpenBr(yes, no, '':U).
     3669   end.
     3670   else do:
     3671      assign re-querybr-docs = yes.
     3672      run sort-brbr-docs
     3673        (input (if available buf-OR_ord-doc
     3674                then recid(buf-OR_ord-doc)
     3675                else ?
     3676               )
     3677        ).
     3678      assign re-querybr-docs = no.
     3679   end.
     3680   end.
     3681   MAIN-BLOCK:
     3682   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3683      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3684      buf-OR_ord-doc.status_:read-only in browse br-docs = true .
     3685      define buffer find_code for ub.ord-doc.
     3686         if pardoc-rec <> ? then do:
     3687         FIND FIRST find_code No-LOCK where
     3688                    recid(find_code) = pardoc-rec No-ERROR.
     3689         if not avail find_code then do:
     3690           message
     3691           vss-workfile vss-revision vss-description skip
     3692           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3693           view-as alert-box error .
     3694           return error.
     3695         end.
     3696         doc-rec = pardoc-rec.
     3697       end.
     3698     run my-enable_ui in this-procedure .
     3699     run openbr in this-procedure (yes, no, '':u).
     3700     if pardoc-rec <> ? then
     3701     reposition br-docs to recid doc-rec no-error.
     3702     run diasize_add_browse in this-procedure
     3703         (input  'width':u
     3704         ,input  browse br-zapr :handle
     3705         ) .
     3706     run diasize_init in this-procedure .
     3707     WAIT-FOR GO OF FRAME Dialog-Frame focus br-docs.
     3708   END.
     3709   run disable_ui in this-procedure .
     3710   PROCEDURE close-zapr :
     3711    do
     3712    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3713    :
     3714   define input parameter p-trn-code as character no-undo .
     3715   define buffer buf_s-trn-doc for ub.trn-doc.
     3716   define variable varmode            as   character           no-undo.
     3717   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3718   define variable varflag            like ub.trn-doc.flag     no-undo.
     3719   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3720   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3721   define variable varcheck-return as logical no-undo .
     3722   define variable varchg-inv as logical no-undo .
     3723   assign
     3724     varmode         = '<закрытие документа>':U
     3725     varstatus       = 'новый':U
     3726     varflag         = false
     3727     varcopystatus   = 'новый':U
     3728     varcopyflag     = true
     3729     varcheck-return = true
     3730     varchg-inv      = true
     3731     .
     3732   run str/trn-graf.p
     3733       (input  p-trn-code,
     3734       input  v-cntxt-db-num,
     3735       input  varmode,
     3736       output varstatus,
     3737       output varflag,
     3738       output varcopystatus,
     3739       output varcopyflag
     3740     ) no-error.
     3741   if error-status:error then do:
     3742      if error-status :get-message(1) <> "" or
     3743         return-value = ""                  then do:
     3744        message "Ошибка при вызове trn-graf.p." skip
     3745        error-status :get-meSSAGE(1) skip
     3746        return-value skip
     3747        view-as alert-box error.
     3748      end.
     3749      else do:
     3750        message return-value
     3751        view-as alert-box error.
     3752      end.
     3753      return error.
     3754   end.
     3755   run str/trn-stat.p (
     3756                   input  parparentproc ,
     3757                   input this-procedure ,
     3758                   input  varmode,
     3759                   input  p-trn-code,
     3760                   input  varcheck-return,
     3761                   input  v-cntxt-db-num,
     3762                   input  v-cntxt-in-ov,
     3763                   input  v-cntxt-rsrv-time,
     3764                   input  v-cntxt-load-time,
     3765                   input  v-cntxt-holidays,
     3766                   input  yes,
     3767                   output varchg-inv,
     3768                   output table gds-list) no-error.
     3769   if error-status:error then do:
     3770      message
     3771        vss-workfile vss-revision vss-description skip
     3772        "Ошибка при принудительном закрытии документа " p-trn-code skip
     3773        return-value skip
     3774        trim(error-status :get-message(1))
     3775        trim(error-status :get-message(2))
     3776        trim(error-status :get-message(3))
     3777        trim(error-status :get-message(4))
     3778        trim(error-status :get-message(5)) skip
     3779        view-as alert-box error.
     3780      return error.
     3781   end.
     3782     end.
     3783   END PROCEDURE.
     3784   PROCEDURE disable_UI :
     3785     HIDE FRAME Dialog-Frame.
     3786   END PROCEDURE.
     3787   PROCEDURE enable_UI :
     3788     DISPLAY sch-code sch-date sch-fact loc-ps sch-num loc-boss loc-agnt loc-wrkr
     3789             loc-creid
     3790         WITH FRAME Dialog-Frame.
     3791     ENABLE b-quit b-sel b-rep b-close b-PS b-sch b-print b-hist b-help b-mark b-add
     3792            b-lkp b-chg b-del b-open sch-code sch-date sch-fact br-docs loc-ps
     3793            B-lkp-2 br-zapr sch-num loc-boss loc-agnt loc-wrkr loc-creid b-reject
     3794         WITH FRAME Dialog-Frame.
     3795     VIEW FRAME Dialog-Frame.
     3796     OPEN QUERY br-docs FOR EACH buf-OR_ord-doc NO-LOCK.    OPEN QUERY br-zapr FOR EACH buf-OR_ord-doc-rcv WHERE                   buf-OR_ord-doc-rcv.doc-code = buf-OR_ord-doc.doc-code NO-LOCK,         each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-OR_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'          ,          EACH buf-OR_trn-doc  where        buf-OR_trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     3797   END PROCEDURE.
     3798   PROCEDURE main-ord :
     3799    do
     3800    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3801    :
     3802   define input parameter   p-in-ord-num as character no-undo .
     3803   define output parameter  p-out-ord-num as character no-undo .
     3804   if num-entries(p-in-ord-num , "." ) = 1 then
     3805      p-out-ord-num = p-in-ord-num .
     3806      else do:
     3807        p-out-ord-num = entry(1, entry( 1 , p-in-ord-num , "." ) , "-" )  + "-" + entry( 2 , p-in-ord-num , "."  ) .
     3808      end.
     3809     end.
     3810   END PROCEDURE.
     3811   PROCEDURE my-enable_UI :
     3812    do
     3813    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3814    :
     3815     DISPLAY
     3816         sch-code
     3817         sch-date
     3818         sch-fact
     3819         B-rez
     3820         loc-ps
     3821         WITH FRAME Dialog-Frame.
     3822     ENABLE b-quit
     3823            b-mark       when lookup("b-mark":U,  bttns) > 0
     3824            b-sel        when lookup("b-sel":U,   bttns) > 0
     3825            b-sch
     3826            b-hist
     3827            b-help
     3828            b-add        when lookup("b-add":U,  bttns) > 0 and not ( par-mode begins "rc" )
     3829            b-lkp
     3830            b-lkp-2
     3831            b-chg        when lookup("b-chg":U,  bttns) > 0
     3832            b-del        when lookup("b-del":U,  bttns) > 0
     3833            b-close
     3834            b-reject     when par-mode begins "rc"
     3835            b-open
     3836            b-print
     3837            sch-code
     3838            sch-date
     3839            sch-fact
     3840            br-docs
     3841            br-zapr
     3842            B-rez
     3843            b-rep
     3844            b-PS
     3845            loc-ps
     3846         WITH FRAME Dialog-Frame.
     3847     VIEW FRAME Dialog-Frame.
     3848     hide b-open in frame dialog-frame.
     3849   define variable  m-i-rc  as widget-handle.
     3850   define variable  m-i-rc2  as widget-handle.
     3851   create widget-pool "my-pool" persistent no-error .
     3852   if par-mode begins "rc"  then do:
     3853   create menu-item m-i-rc in widget-pool "my-pool"
     3854     assign parent = menu m-rep:handle
     3855     label = "Отчет о выполнении РЦ заказов на товары"
     3856     .
     3857   on choose of m-i-rc persistent run run-rep (1) .
     3858   end.
     3859   create menu-item m-i-rc2 in widget-pool "my-pool"
     3860     assign parent = menu m-rep:handle
     3861     label = "Отчет по заказам на РЦ"
     3862     .
     3863   on choose of m-i-rc2 persistent run run-rep (2) .
     3864     end.
     3865   END PROCEDURE.
     3866   PROCEDURE OpenBr :
     3867    do
     3868    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3869    :
     3870   define input  parameter p-open-query     as logical   no-undo .
     3871   define input  parameter p-find-next      as logical   no-undo .
     3872   define input  parameter p-find-condition as character no-undo .
     3873   define variable l-query-was-opened as logical no-undo .
     3874   define variable title0 as character no-undo.
     3875   define variable p-file-label as character no-undo .
     3876   p-file-label = "Заказы Объект-РЦ".
     3877   title0 = caps(p-file-label) + chr(32).
     3878   define variable sort-column-phrase as character no-undo .
     3879   case sort-column-name :
     3880     when "" then do:
     3881       assign
     3882         sort-column-phrase = ""
     3883       .
     3884     end.
     3885     otherwise do:
     3886       assign
     3887         sort-column-phrase = "by " + sort-column-name
     3888       .
     3889     end.
     3890   end case.
     3891   define variable l-open-query as logical   no-undo .
     3892   find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3893   if not available buf_clients then return .
     3894   filter-point = filter-point0 + par-mode.
     3895     CASE par-mode :
     3896       WHEN 'объ':U THEN DO:
     3897          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name
     3898                                             + " Объект: " +  p-obj-type
     3899                                             + "  " +   string (p-obj-code)
     3900                                             .
     3901   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3902   define variable  l-disable-where-31  as logical   no-undo .
     3903   define variable  l-filter-open-31    as logical   .
     3904   define variable  flt-rec-31       as recid     no-undo .
     3905   define variable  filter-name-31      as character no-undo .
     3906   define variable  where-phrase-31     as character no-undo .
     3907   define variable  sort-phrase-31      as character no-undo .
     3908   define variable  where-phrase-rus-31 as character no-undo .
     3909   define variable  sort-phrase-rus-31  as character no-undo .
     3910   run gbl/flt-get.p
     3911     (input filter-point
     3912     ,output flt-rec-31
     3913     ,output filter-name-31
     3914     ,output where-phrase-31
     3915     ,output sort-phrase-31
     3916     ,output where-phrase-rus-31
     3917     ,output sort-phrase-rus-31
     3918     ).
     3919   if p-open-query then do:
     3920       run set-filter-name in this-procedure
     3921         (INPUT filter-name-31
     3922         ) no-error .
     3923     assign
     3924       l-filter-open-31 = false
     3925     .
     3926     if flt-rec-31 <> ?
     3927       or sort-column-phrase > ""
     3928     then do:
     3929       define variable  parameter-2-31 as character no-undo .
     3930       define variable  parameter-3-31 as character no-undo .
     3931       define variable  parameter-4-31 as character no-undo .
     3932       define variable  parameter-5-31 as character no-undo .
     3933       define variable  parameter-6-31 as character no-undo .
     3934       define variable  parameter-7-31 as character no-undo .
     3935         assign
     3936         parameter-3-31 =
     3937                                 "FOR EACH buf-or_ord-doc"
     3938         parameter-4-31 =
     3939           (
     3940             if (" buf-OR_ord-doc.host-code = par-host-code and buf-OR_ord-doc.obj-code = p-obj-code and buf-OR_ord-doc.obj-type = p-obj-type and buf-OR_ord-doc.doc-type = p-doc-type " + " " + where-phrase-31) <> ""
     3941             then  substitute(' buf-OR_ord-doc.host-code = &2 and                         buf-OR_ord-doc.obj-code = &3  and                                       buf-OR_ord-doc.obj-type = &1&4&1  and                                    buf-OR_ord-doc.doc-type = &1&5&1' , chr(34) , par-host-code , p-obj-code, p-obj-type , p-doc-type)  + " " + where-phrase-31
     3942             else "true"
     3943           )
     3944         parameter-5-31 = (" " + "" + " " + "")
     3945         parameter-6-31 = if sort-phrase-31 = ''
     3946                              then
     3947           (
     3948           " " + " USE-INDEX by-obj " +
     3949             " " + sort-column-phrase +
     3950           " " + " "
     3951           )
     3952                              else
     3953           (
     3954           " " + " USE-INDEX by-obj " +
     3955             " " + sort-column-phrase +
     3956           " " + sort-phrase-31
     3957           )
     3958         parameter-7-31 =
     3959           "   "
     3960       .
     3961       do
     3962       on stop undo, leave
     3963       on error undo, leave
     3964       :
     3965         assign
     3966           l-disable-where-31 =
     3967             (" buf-OR_ord-doc.host-code = par-host-code and buf-OR_ord-doc.obj-code = p-obj-code and buf-OR_ord-doc.obj-type = p-obj-type and buf-OR_ord-doc.doc-type = p-doc-type " + " " + where-phrase-31 = "")
     3968         .
     3969         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3970                             ,input query br-docs:handle
     3971                             ,input parameter-3-31
     3972                             ,input parameter-4-31
     3973                             ,input parameter-5-31
     3974                             ,input parameter-6-31
     3975                             ,input parameter-7-31
     3976                             )
     3977         .
     3978         assign
     3979           l-filter-open-31 = true
     3980         .
     3981       end.
     3982       if l-filter-open-31 = false then do:
     3983         message
     3984           "Ошибка при фильтрации / сортировке" skip
     3985           "Будут показаны записи без учета фильтра" skip
     3986           view-as alert-box .
     3987       end.
     3988       else do:
     3989           assign
     3990             l-query-was-opened = true
     3991           .
     3992       end.
     3993     end.
     3994     if l-filter-open-31 = false then do:
     3995       OPEN QUERY br-docs FOR EACH buf-OR_ord-doc
     3996         where  buf-OR_ord-doc.host-code = par-host-code and buf-OR_ord-doc.obj-code = p-obj-code and buf-OR_ord-doc.obj-type = p-obj-type and buf-OR_ord-doc.doc-type = p-doc-type
     3997          USE-INDEX by-obj
     3998     .
     3999         assign
     4000           l-query-was-opened = true
     4001         .
     4002     end.
     4003   end.
     4004   else do:
     4005     assign
     4006       doc-rec = recid( buf-OR_ord-doc )
     4007     .
     4008     do
     4009     on stop undo, leave
     4010     on error undo, leave
     4011     :
     4012       if query br-docs:handle:get-buffer-handle(1) = (buffer buf-or_ord-doc:handle) then do:
     4013         assign
     4014         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4015         parameter-4-31 =
     4016           "where ":u +  substitute(' buf-OR_ord-doc.host-code = &2 and                         buf-OR_ord-doc.obj-code = &3  and                                       buf-OR_ord-doc.obj-type = &1&4&1  and                                    buf-OR_ord-doc.doc-type = &1&5&1' , chr(34) , par-host-code , p-obj-code, p-obj-type , p-doc-type)  + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     4017         parameter-5-31 = " USE-INDEX by-obj "
     4018       .
     4019         run fltopend_fltfindd in this-procedure  (
     4020                             input this-procedure:handle
     4021                             ,input query br-docs:handle
     4022                             ,input rowid(buf-OR_ord-doc)
     4023                             ,input logical(parameter-2-31)
     4024                             ,input no-lock
     4025                             ,input (buffer buf-OR_ord-doc:handle)
     4026                             ,input parameter-4-31
     4027                             ,input parameter-5-31
     4028                             ) no-error.
     4029         .
     4030         assign
     4031           doc-rec = integer(return-value)
     4032           v-fltopend-rowid[1] = ?
     4033         .
     4034       end.
     4035       else do:
     4036         assign
     4037         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4038         parameter-3-31 =  "FOR EACH buf-or_ord-doc"
     4039         parameter-4-31 =
     4040           (
     4041             if (" buf-OR_ord-doc.host-code = par-host-code and buf-OR_ord-doc.obj-code = p-obj-code and buf-OR_ord-doc.obj-type = p-obj-type and buf-OR_ord-doc.doc-type = p-doc-type " + " " + where-phrase-31) <> ""
     4042             then  substitute(' buf-OR_ord-doc.host-code = &2 and                         buf-OR_ord-doc.obj-code = &3  and                                       buf-OR_ord-doc.obj-type = &1&4&1  and                                    buf-OR_ord-doc.doc-type = &1&5&1' , chr(34) , par-host-code , p-obj-code, p-obj-type , p-doc-type)  + " " + where-phrase-31
     4043             else "true"
     4044           )
     4045         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     4046         parameter-6-31 = if sort-phrase-31 = ''
     4047                              then
     4048           (
     4049           " " + " USE-INDEX by-obj " +
     4050             " " + sort-column-phrase +
     4051           " " + " "
     4052           )
     4053                              else
     4054           (
     4055           " " + " USE-INDEX by-obj " +
     4056             " " + sort-column-phrase +
     4057           " " + sort-phrase-31
     4058           )
     4059         parameter-7-31 =
     4060           "   "
     4061       .
     4062         run fltopend_fltfindq in this-procedure  (
     4063                             input this-procedure:handle
     4064                             ,input query br-docs:handle
     4065                             ,input logical(parameter-2-31)
     4066                             ,input no-lock
     4067                             ,input parameter-3-31
     4068                             ,input parameter-4-31
     4069                             ,input parameter-5-31
     4070                             ,input parameter-6-31
     4071                             ,input parameter-7-31
     4072                             ,output v-fltopend-rowid
     4073                             ) no-error.
     4074         .
     4075         doc-rec = ?.
     4076       end.
     4077       assign
     4078         l-query-was-opened = true
     4079       .
     4080     end.
     4081   end.
     4082       END.
     4083       WHEN "status":U THEN DO:
     4084          ASSIGN frame Dialog-Frame:TITLE = title0 + "  ФИРМА: " + buf_clients.obj-name
     4085                                             + " Объект: " +  p-obj-type
     4086                                             + "  " +   string (p-obj-code)
     4087                                             + "   Статус: " +  string(p-status_) .
     4088   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
