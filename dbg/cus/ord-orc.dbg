     4655   PROCEDURE ord-close :
     4656    do
     4657    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4658    :
     4659   define input parameter p-loc-recid as recid no-undo .
     4660   if par-mode begins "rc" and
     4661      buf-or_ord-doc.status_ = 'новый':U
     4662       then do:
     4663           message "Заказ в статусе Новый закрывается на стороне создания" view-as alert-box information .
     4664           return.
     4665       end.
     4666   message "Закрыть заказ ?"
     4667   view-as alert-box question
     4668   buttons yes-no
     4669   update g-log.
     4670   if g-log = false then return .
     4671     run cus/ordorcls.p (parparentproc, p-loc-recid , true ) no-error .
     4672     if error-status :error then do:
     4673         message vss-workfile vss-revision vss-description skip
     4674               "Ошибка из ordorcls.p " skip
     4675                 skip
     4676                 error-status :get-message(1) skip
     4677                 return-value skip
     4678                 view-as alert-box error
     4679                .
     4680         return .
     4681     end.
     4682     else do:
     4683       run openbr in this-procedure ( yes, no, '':u).
     4684     end.
     4685     end.
     4686   END PROCEDURE.
     4687   PROCEDURE ord-del :
     4688    do
     4689    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4690    :
     4691   define input parameter p-loc-recid as recid no-undo .
     4692   find current buf-OR_ord-doc  exclusive-lock    no-error .
     4693   if not available buf-OR_ord-doc  then return .
     4694   define variable g-log as log no-undo.
     4695   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4696   do:
     4697     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4698       (input  v-cntxt-db-num
     4699       ,input  v-cntxt-userid
     4700       ,input  0
     4701       ,input  'actn_o-r_deletion':U
     4702       ,input  'object':U
     4703       ,input  v-cntxt-host-code-obj
     4704       ,input  p-obj-type
     4705       ,input  p-obj-code
     4706       ,input  0
     4707       ,input  0
     4708       ,input  0
     4709       ,input  true
     4710       ,output g-log
     4711       )  .
     4712   end.
     4713   if not g-log then  return .
     4714   if  buf-OR_ord-doc.status_ = 'факт':U  then do:
     4715       message "Заказ в статусе ФАКТ не может быть удален !!!"
     4716       view-as alert-box information .
     4717       return error .
     4718   end.
     4719   message "Удалить запись ?"
     4720   view-as alert-box question
     4721   buttons yes-no
     4722   update g-log.
     4723   if g-log = false then return no-apply.
     4724   delete buf-OR_ord-doc .
     4725   run openbr in this-procedure (yes, no, '':u).
     4726     end.
     4727   END PROCEDURE.
     4728   PROCEDURE ord-open :
     4729    do
     4730    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4731    :
     4732   define input parameter p-loc-recid as recid no-undo .
     4733   message "Открыть заказ ?"
     4734   view-as alert-box question
     4735   buttons yes-no
     4736   update g-log.
     4737   if g-log = false then return no-apply.
     4738     end.
     4739   END PROCEDURE.
     4740   PROCEDURE proc-add :
     4741    do
     4742    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4743    :
     4744   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4745   do:
     4746     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4747       (input  v-cntxt-db-num
     4748       ,input  v-cntxt-userid
     4749       ,input  0
     4750       ,input  'actn_o-r_add-def':U
     4751       ,input  'object':U
     4752       ,input  par-host-code
     4753       ,input  p-obj-type
     4754       ,input  p-obj-code
     4755       ,input  0
     4756       ,input  0
     4757       ,input  0
     4758       ,input  true
     4759       ,output g-log
     4760       )  .
     4761   end.
     4762   if not g-log then  return .
     4763   define variable rr as recid no-undo .
     4764     rr = ? .
     4765     run cus/ord-oru.w
     4766        (input parparentproc,
     4767         input-output rr ,
     4768         input 'ДОБАВЛЕНИЕ':U ,
     4769         input-output br-handle ,
     4770         input-output next-prev
     4771         ).
     4772     v-doc-rec = rr .
     4773     run openbr in this-procedure ( yes, no, '':u).
     4774     reposition br-docs to recid v-doc-rec no-error .
     4775     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     4776     end.
     4777   END PROCEDURE.
     4778   PROCEDURE proc-b-sch :
     4779    do
     4780    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4781    :
     4782   assign
     4783     tbl = 'ord-doc'
     4784     join-tbl = 'buf-OR_ord-doc'
     4785     fld = ""
     4786     lab = ""
     4787     spr = ""
     4788     dim = '0'
     4789     .
     4790   run fltfield-add in this-procedure('doc-code'                      , '№ заказа'  , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4791   run fltfield-add in this-procedure('status_'                       , 'Статус'    , 'order-status-all',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4792   run fltfield-add in this-procedure('flag_'                         , 'ОК'        , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4793   run fltfield-add in this-procedure('doc-date'                      , 'Дата док-та', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4794   run fltfield-add in this-procedure('fact-date'                     , 'Дата факт'  , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4795   run fltfield-add in this-procedure('cli-type*cli-code'  , 'Контрагент' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4796   run fltfield-add in this-procedure('obj-type*obj-code'  , 'Объект'     , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4797   run fltfield-add in this-procedure('agnt'                          , 'Исполнитель', 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4798   run fltfield-add in this-procedure('boss'                          , 'Менеджер'   , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4799   run fltfield-add in this-procedure('wrkr'                          , 'Кладовщик'  , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4800   run fltfield-add in this-procedure('creid'                         , 'Создал'     , 'usr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4801   run fltfield-add in this-procedure('host-code'                     , 'Фирма'      , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4802   run fltfield-add in this-procedure('pay-code'                      , 'Код оплаты' , 'pay',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4803   run fltfield-add in this-procedure('ship-date'                     , 'Дата отгрузки' , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4804   run fltfield-add in this-procedure('PS'                            , 'Примечание', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4805   run fltfield-add in this-procedure('contract-code'                  , 'Вн.№ договора', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4806   run fltfield-add in this-procedure('exch-code'                      , 'Валюта','curr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4807   run fltfield-add in this-procedure('user-name'                      , 'Правил', 'usr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4808   Filter-Block:
     4809   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4810       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4811       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4812     run gbl/filter.w ( input parparentproc, input filter-point, input tbl, input join-tbl, input fld, input lab, input spr, input dim ).
     4813     run openbr in this-procedure (yes, no, '':u).
     4814   END.
     4815     end.
     4816   END PROCEDURE.
     4817   PROCEDURE proc-sch-code :
     4818    do
     4819    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4820    :
     4821   define input parameter par-next as logical no-undo.
     4822   define input parameter pardoc-code as character no-undo.
     4823   display "" @ sch-date with frame Dialog-Frame.
     4824   display "" @ sch-fact with frame Dialog-Frame.
     4825   assign
     4826     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4827   run OpenBr in this-procedure
     4828       (input false
     4829       ,input par-next
     4830       ,input substitute("and buf-OR_ord-doc.doc-code begins &1 "
     4831         , pardoc-code)
     4832       ) no-error .
     4833       if error-status :error or return-value = ? then
     4834          message "Не найдено ни одной записи !" view-as alert-box .
     4835    apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     4836     end.
     4837   END PROCEDURE.
     4838   PROCEDURE proc-sch-date :
     4839    do
     4840    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4841    :
     4842   define input parameter par-next as logical no-undo.
     4843   define input parameter pardoc-code as date no-undo.
     4844   define variable ppp as character no-undo .
     4845   display "" @ sch-fact with frame Dialog-Frame.
     4846   display "" @ sch-code with frame Dialog-Frame.
     4847   ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4848   run OpenBr in this-procedure
     4849       (input false
     4850       ,input par-next
     4851       ,input substitute("and buf-OR_ord-doc.doc-date = &1 "
     4852         , ppp )
     4853       ) no-error .
     4854       if error-status :error or return-value = ? then
     4855          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4856   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     4857     end.
     4858   END PROCEDURE.
     4859   PROCEDURE proc-sch-fact :
     4860    do
     4861    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4862    :
     4863   define input parameter par-next as logical no-undo.
     4864   define input parameter pardoc-code as date no-undo.
     4865   define variable ppp as character no-undo .
     4866   display "" @ sch-date with frame Dialog-Frame.
     4867   display "" @ sch-code with frame Dialog-Frame.
     4868   ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4869   run OpenBr in this-procedure
     4870       (input false
     4871       ,input par-next
     4872       ,input substitute("and buf-OR_ord-doc.fact-date = &1 "
     4873         , ppp )
     4874       ) no-error .
     4875       if error-status :error or return-value = ? then
     4876          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4877   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     4878     end.
     4879   END PROCEDURE.
     4880   PROCEDURE run-rep :
     4881   define input parameter j as integer no-undo .
     4882   if j = 1 then run cus/g-ordrc1.p (ParParentproc).
     4883   if j = 2 then do :
     4884      if par-mode begins "rc" then run cus/g-ordrc2.p (ParParentproc , "RC":U ).
     4885      else  run cus/g-ordrc2.p (ParParentproc, "" ).
     4886   end.
     4887   END PROCEDURE.
     4888   PROCEDURE UI-on :
     4889    do
     4890    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4891    :
     4892    run openbr in this-procedure (yes, no, '':u).
     4893     end.
     4894   END PROCEDURE.
     4895   FUNCTION f-direct RETURNS CHARACTER
     4896   ( par1 as recid ):
     4897   define buffer fl for ub.ord-doc.
     4898   define variable v-res as character no-undo .
     4899   define variable v-res-0 as character no-undo .
     4900   find first fl no-lock where recid(fl) = par1 no-error .
     4901   if error-status :error then return chr(32) .
     4902   v-res = chr(42) .
     4903   v-res-0 = chr(32) .
     4904   if v-cntxt-db-num = 0 then
     4905       if fl.order-type = 3  then return v-res.
     4906         else return v-res-0 .
     4907   else
     4908      if fl.order-type = 2  then return v-res.
     4909         else return v-res-0 .
     4910   END FUNCTION.
