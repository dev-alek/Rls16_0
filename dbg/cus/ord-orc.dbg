     1948           (input ?
     1949           ,input "Выбор даты"
     1950           ,input v-description
     1951           ,input ""
     1952           ,input-output v-curr-sv-date
     1953           ,output v-ok
     1954           ).
     1955         if v-ok = true
     1956         then do:
     1957           assign
     1958             self :screen-value = string(v-curr-sv-date) .
     1959           .
     1960         end.
     1961       end.
     1962     end.
     1963     return no-apply .
     1964   end.
