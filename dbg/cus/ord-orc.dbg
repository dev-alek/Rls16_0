     4122         assign
     4123         parameter-3-33 =
     4124                                 "FOR EACH buf-or_ord-doc"
     4125         parameter-4-33 =
     4126           (
     4127             if (" buf-OR_ord-doc.host-code = par-host-code and buf-OR_ord-doc.obj-code = p-obj-code and buf-OR_ord-doc.obj-type = p-obj-type and buf-OR_ord-doc.doc-type = p-doc-type  and buf-OR_ord-doc.status_= p-status_ " + " " + where-phrase-33) <> ""
     4128             then  substitute(' buf-OR_ord-doc.host-code = &2 and                         buf-OR_ord-doc.obj-code = &3     and                          buf-OR_ord-doc.obj-type = &1&4&1 and                          buf-OR_ord-doc.doc-type = &1&5&1 and                          buf-OR_ord-doc.status_  = &1&6&1 ' , chr(34) , par-host-code , p-obj-code, p-obj-type , p-doc-type , p-status_ )  + " " + where-phrase-33
     4129             else "true"
     4130           )
     4131         parameter-5-33 = (" " + "" + " " + "")
     4132         parameter-6-33 = if sort-phrase-33 = ''
     4133                              then
     4134           (
     4135           " " + " USE-INDEX by-obj-type " +
     4136             " " + sort-column-phrase +
     4137           " " + "  "
     4138           )
     4139                              else
     4140           (
     4141           " " + " USE-INDEX by-obj-type " +
     4142             " " + sort-column-phrase +
     4143           " " + sort-phrase-33
     4144           )
     4145         parameter-7-33 =
     4146           "   "
     4147       .
     4148       do
     4149       on stop undo, leave
     4150       on error undo, leave
