      904   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      905   procedure fltopend_fltopend :
      906   define input parameter p-parent-handle as handle no-undo .
      907   define input parameter p-qh as handle no-undo .
      908   define input parameter p-flt-open-open-query  as character no-undo .
      909   define input parameter p-where-cond as character no-undo .
      910   define input parameter p-use-indFIRST-query-tail as character no-undo .
      911   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      912   define input parameter p-indexed-reposition as character no-undo .
      913     do
      914     on error undo, return error
      915     :
      916   define variable v-prepare-string as character no-undo .
      917   define variable glog as logical no-undo .
      918   assign
      919   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      920                      p-where-cond + chr(32)  +
      921                      p-use-indFIRST-query-tail + chr(32) +
      922                      p-use-ind-sort-clmn-by + chr(32) +
      923                      p-indexed-reposition
      924   .
      925   assign
      926   glog = p-qh:query-prepare(v-prepare-string) no-error .
      927   if not glog
      928   or error-status:error then do:
      929     message error-status:get-message(1) view-as alert-box .
      930     undo, return error .
      931   end.
      932   assign
      933   glog = p-qh:query-open no-error .
      934   if not glog
      935   or error-status:error then do:
      936     message error-status:get-message(1) view-as alert-box .
      937     undo, return error .
      938   end.
      939     end.
      940   end procedure.
      941   procedure fltopend_fltfindd :
      942   define input parameter p-parent-handle as handle no-undo .
      943   define input parameter p-qh as handle no-undo .
      944   define input parameter p-rowid as rowid no-undo .
      945   define input parameter p-next as logical no-undo .
      946   define input parameter p-lock as integer no-undo .
      947   define input parameter p-bh as handle no-undo .
      948   define input parameter p-where-cond as character no-undo .
      949   define input parameter p-use-index-phrase as character no-undo .
      950   define variable glog as logical no-undo .
      951   define variable v-qh as handle no-undo .
      952   define variable v-bh as handle no-undo .
      953   define variable v-recid as recid no-undo .
      954   define variable v-prepare-string as character no-undo .
      955   do
      956   on error undo, return error
      957   on stop undo, return error
      958   :
      959     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      960     create buffer v-bh for table p-bh buffer-name p-bh:name.
      961     create query v-qh.
      962     v-qh:set-buffers(v-bh).
      963     v-prepare-string = substitute("for each &1 &2 &3"
      964                                     ,v-bh:name
      965                                     ,p-where-cond
      966                                     ,p-use-index-phrase).
      967     glog = v-qh:query-prepare(v-prepare-string) no-error.
      968     if not glog then do:
      969       delete object v-qh.
      970       delete object v-bh.
      971       undo, return error .
      972     end.
      973     glog = v-qh:query-open no-error .
      974     if not glog then do:
      975       delete object v-qh.
      976       delete object v-bh.
      977       undo, return error .
      978     end.
      979     if p-next then do:
      980       v-qh:reposition-to-rowid(p-rowid) no-error .
      981       glog = v-qh:get-next( p-lock) no-error .
      982       glog = v-qh:get-next( p-lock) no-error .
      983       if not glog or v-qh:query-off-end = yes then do:
      984         glog = v-qh:get-first( p-lock) no-error .
      985       end.
      986     end.
      987     else do:
      988       glog = v-qh:get-first( p-lock) no-error .
      989     end.
      990     v-recid = v-bh:recid no-error .
      991     delete object v-qh.
      992     delete object v-bh.
      993     return string(v-recid) .
      994   end.
      995   end procedure.
      996   procedure fltopend_fltfindq :
      997   define input parameter p-parent-handle as handle no-undo .
      998   define input parameter p-qh as handle no-undo .
      999   define input parameter p-next as logical no-undo .
     1000   define input parameter p-lock as integer no-undo .
     1001   define input parameter p-flt-open-open-query  as character no-undo .
     1002   define input parameter p-where-cond as character no-undo .
     1003   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1004   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1005   define input parameter p-indexed-reposition as character no-undo .
     1006   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1007   define variable glog as logical no-undo .
     1008   define variable v-qh as handle no-undo .
     1009   define variable v-bh as handle no-undo extent 18.
     1010   define variable v-rowid as rowid no-undo extent 18.
     1011   define variable v-ii as integer no-undo .
     1012   define variable v-prepare-string as character no-undo .
     1013   do
     1014   on error undo, return error
     1015   on stop undo, return error
     1016   :
     1017     create query v-qh.
     1018     do v-ii = 1 to p-qh:num-buffers:
     1019       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1020       assign
     1021       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1022       no-error.
     1023       v-qh:add-buffer(v-bh[v-ii]).
     1024     end.
     1025     assign
     1026     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1027                       p-where-cond + chr(32)  +
     1028                       p-use-indFIRST-query-tail + chr(32) +
     1029                       p-use-ind-sort-clmn-by + chr(32) +
     1030                       p-indexed-reposition
     1031     .
     1032     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1033     if not glog then do:
     1034       delete object v-qh.
     1035       do v-ii = 1 to p-qh:num-buffers:
     1036         delete object v-bh[v-ii].
     1037       end.
     1038       undo, return error .
     1039     end.
     1040     glog = v-qh:query-open no-error .
     1041     if not glog then do:
     1042       delete object v-qh.
     1043       do v-ii = 1 to p-qh:num-buffers:
     1044         delete object v-bh[v-ii].
     1045       end.
     1046       undo, return error .
     1047     end.
     1048     if p-next then do:
     1049       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1050       glog = v-qh:get-next( p-lock) no-error .
     1051       glog = v-qh:get-next( p-lock) no-error .
     1052       if not glog or v-qh:query-off-end = yes then do:
     1053         glog = v-qh:get-first( p-lock) no-error .
     1054       end.
     1055     end.
     1056     else do:
     1057       glog = v-qh:get-first( p-lock) no-error .
     1058     end.
     1059     do v-ii = 1 to p-qh:num-buffers:
     1060       assign
     1061       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1062       no-error.
     1063     end.
     1064     delete object v-qh.
     1065     do v-ii = 1 to p-qh:num-buffers:
     1066       delete object v-bh[v-ii].
     1067     end.
     1068   end.
     1069   end procedure.
     1070   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1071   FUNCTION mark-string RETURNS CHARACTER
     1072     ( input p-recid as recid, input mark-list as character  ) :
     1073     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1074   END FUNCTION.
     1075   function f-nameo returns character ( par1 as recid ) :
     1076   define buffer fl for ub.ord-doc.
     1077   define buffer buf_obj for ub.clients.
     1078   find first fl no-lock where recid(fl) = par1 no-error .
     1079   find first buf_obj no-lock where
     1080              buf_obj.obj-code = fl.obj-code and
     1081              buf_obj.obj-type = fl.obj-type
     1082              no-error .
     1083   if error-status :error then return "" .
     1084   return buf_obj.obj-name.
     1085   end function.
     1086   define buffer buf_sysconf for ub.sysconf  .
     1087   find first buf_sysconf where buf_sysconf.host-code = par-host-code no-lock.
     1088   define variable v-cntxt-cash-pay as integer   no-undo .
     1089   define variable v-cntxt-in-ov as logical   no-undo .
     1090   define variable v-cntxt-base-code as integer   no-undo .
     1091   define variable v-cntxt-rsrv-time  as integer   no-undo .
     1092   define variable v-cntxt-load-time  as integer   no-undo .
     1093   define variable v-cntxt-holidays  as character no-undo .
     1094   define variable g#log as logical   no-undo .
     1095   assign
     1096     v-cntxt-cash-pay   = buf_sysconf.cash-pay
     1097     v-cntxt-base-code  = buf_sysconf.base-code
     1098     v-cntxt-in-ov      = buf_sysconf.in-ov
     1099     v-cntxt-rsrv-time  = buf_sysconf.rsrv-time
     1100     v-cntxt-load-time  = buf_sysconf.load-time
     1101     v-cntxt-holidays   = buf_sysconf.holidays
     1102   .
     1103   define variable filter-point as character no-undo init "Список заказов ОРЦ" .
     1104   define variable filter-point0 as character no-undo init "Заказы ОРЦ" .
     1105   define variable sort-column-name as character no-undo .
     1106   define variable print-type as character no-undo.
     1107   define variable del-type as character no-undo.
     1108   define variable deleted as logical no-undo init no.
     1109   DEFINE VARIABLE change-type as character init "" no-undo .
     1110   define variable br-handle as handle  no-undo .
     1111   DEFINE new SHARED VARIABLE Sort-gr AS LOGICAL
     1112        LABEL "Сортировать по группам товаров"
     1113        VIEW-AS TOGGLE-BOX
     1114        size 42.25 by 0.75 NO-UNDO init false .
     1115   DEFINE new Shared VARIABLE print-graft AS LOGICAL
     1116        LABEL "Отладочная печать"
     1117        VIEW-AS TOGGLE-BOX
     1118        size 42.25 by 0.75 NO-UNDO init true .
     1119   FUNCTION f-direct RETURNS CHARACTER
     1120   ( par1 as recid ) FORWARD.
     1121   DEFINE BUTTON b-add
     1122        LABEL "&Добавить":L
     1123        SIZE 9 BY 1 TOOLTIP "Добавить новый заказ".
     1124   DEFINE BUTTON b-chg
     1125        LABEL "&Изменить":L
     1126        SIZE 12 BY 1 TOOLTIP "Корректировка заказа".
     1127   DEFINE BUTTON b-close
     1128        LABEL "&Закрыть":L
     1129        SIZE 12 BY 1 TOOLTIP "Закрыть заказ".
     1130   DEFINE BUTTON B-close-trn
     1131        LABEL "Закр&ыть"
     1132        SIZE 10 BY 1 TOOLTIP "Закрыть накладную".
     1133   DEFINE BUTTON b-del
     1134        LABEL "&Удалить":L
     1135        SIZE 12 BY 1 TOOLTIP "Удалитиь заказ".
     1136   DEFINE BUTTON b-help
     1137        LABEL "Помо&щь":L
     1138        SIZE 2.88 BY 1.
     1139   DEFINE BUTTON b-hist
     1140        LABEL "Ис&тория":L
     1141        SIZE 2.88 BY 1.
     1142   DEFINE BUTTON b-lkp
     1143        LABEL "&Просмотр":L
     1144        SIZE 12 BY 1 TOOLTIP "Просмотр заказа без корректировки".
     1145   DEFINE BUTTON B-lkp-2
     1146        LABEL "Просмо&тр"
     1147        SIZE 10 BY 1 TOOLTIP "Просмотр накладной".
     1148   DEFINE BUTTON b-mark
     1149        LABEL "&*":L
     1150        SIZE 3 BY 1.
     1151   DEFINE BUTTON b-open
     1152        LABEL "&Открыть":L
     1153        SIZE 12 BY 1 TOOLTIP "Открыть запр+ до запр-".
     1154   DEFINE BUTTON b-print
     1155        LABEL "Пе&чать":L
     1156        SIZE 3 BY 1 TOOLTIP "Печать заказа".
     1157   DEFINE BUTTON b-PS
     1158        LABEL "&Примечание":L
     1159        SIZE 12 BY 1 TOOLTIP "Просмотр Примечания по заказу".
     1160   DEFINE BUTTON b-quit AUTO-GO
     1161        LABEL "&Выход ":L
     1162        SIZE 12 BY 1 TOOLTIP "Выход из режима".
     1163   DEFINE BUTTON b-reject
     1164        LABEL "От&казать":L
     1165        SIZE 12 BY 1 TOOLTIP "Проставить на заказ статус <<Отказать>>".
     1166   DEFINE BUTTON b-rep
     1167        LABEL "О&тчеты":L
     1168        SIZE 12 BY 1 TOOLTIP "Список отчетов по заказам".
     1169   DEFINE BUTTON B-rez
     1170        LABEL "Накл"
     1171        SIZE 10 BY 1 TOOLTIP "Создать расходную накладную для РЦ ".
     1172   DEFINE BUTTON b-sch
     1173        LABEL "&Фильтр":L
     1174        SIZE 3 BY 1 TOOLTIP "Фильтр по списку заказов".
     1175   DEFINE BUTTON b-sel
     1176        LABEL "Вы&бор ":L
     1177        SIZE 12 BY 1 TOOLTIP "Выход из режима и выбор текущего номера  заказа".
     1178   DEFINE VARIABLE loc-ps AS CHARACTER
     1179        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1180        SIZE 94.5 BY 1.75 TOOLTIP "Примечание"
     1181        FGCOLOR 4  NO-UNDO.
     1182   DEFINE VARIABLE loc-agnt AS CHARACTER FORMAT "X(256)":U
     1183        LABEL "Исп"
     1184         VIEW-AS TEXT
     1185        SIZE 17.25 BY .67
     1186        FGCOLOR 4  NO-UNDO.
     1187   DEFINE VARIABLE loc-boss AS CHARACTER FORMAT "X(256)":U
     1188        LABEL "М-р"
     1189         VIEW-AS TEXT
     1190        SIZE 17.25 BY .67
     1191        FGCOLOR 4  NO-UNDO.
     1192   DEFINE VARIABLE loc-creid AS CHARACTER FORMAT "X(256)":U
     1193        LABEL "Создал"
     1194         VIEW-AS TEXT
     1195        SIZE 15.25 BY .67
     1196        FGCOLOR 4  NO-UNDO.
     1197   DEFINE VARIABLE loc-wrkr AS CHARACTER FORMAT "X(256)":U
     1198        LABEL "Кл-к"
     1199         VIEW-AS TEXT
     1200        SIZE 17.25 BY .67
     1201        FGCOLOR 4  NO-UNDO.
     1202   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "x(12)"
     1203        LABEL "&Начало номера"
     1204        VIEW-AS FILL-IN
     1205        SIZE 12 BY 1 NO-UNDO.
     1206   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999"
     1207        LABEL "Д&ата"
     1208        VIEW-AS FILL-IN
     1209        SIZE 12 BY 1 NO-UNDO.
     1210   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999"
     1211        LABEL "Фа&кт"
     1212        VIEW-AS FILL-IN
     1213        SIZE 12 BY 1 NO-UNDO.
     1214   DEFINE VARIABLE sch-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1215         VIEW-AS TEXT
     1216        SIZE 14 BY .67 NO-UNDO.
     1217   DEFINE new shared QUERY br-docs FOR
     1218         buf-OR_ord-doc SCROLLING.
     1219   DEFINE QUERY br-zapr FOR
     1220         buf-OR_ord-doc-rcv,
     1221         ub.ord-chain,
     1222         buf-OR_trn-doc SCROLLING.
     1223   DEFINE BROWSE br-docs
     1224     QUERY br-docs NO-LOCK DISPLAY
     1225         mark-string(recid( buf-OR_ord-doc), rid-list)  COLUMN-LABEL '*' FORMAT "X(1)"
     1226         buf-OR_ord-doc.status_  COLUMN-LABEL 'Статус' Format "X(6)"
     1227         buf-OR_ord-doc.flag_  COLUMN-LABEL 'OK' format "+/-"
     1228         buf-OR_ord-doc.doc-code  COLUMN-LABEL '№ док-та'
     1229         buf-OR_ord-doc.doc-date  COLUMN-LABEL 'Создан' FORMAT "99/99/99"
     1230         buf-OR_ord-doc.fact-date  COLUMN-LABEL 'Факт' FORMAT "99/99/99"
     1231         buf-OR_ord-doc.obj-code  COLUMN-LABEL 'Объект' format ">>>>9"
     1232         buf-OR_ord-doc.obj-type  COLUMN-LABEL 'Тип' format "x(3)"
     1233         buf-OR_ord-doc.cli-type + string (buf-OR_ord-doc.cli-code)  COLUMN-LABEL 'РЦ'
     1234         buf-OR_ord-doc.qnty COLUMN-LABEL 'Количество'
     1235         if trim (buf-OR_ord-doc.ps) <> "" then "+" else "" @ c-ps  COLUMN-LABEL "П" format "x(1)"
     1236         f-nameo(recid(buf-OR_ord-doc)) COLUMN-LABEL 'Наименование' Format "X(26)"
     1237     ENABLE
     1238          buf-OR_ord-doc.status_
     1239       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.38 BY 9.83
     1240            BGCOLOR 15 .
     1241   DEFINE BROWSE br-zapr
     1242     QUERY br-zapr NO-LOCK DISPLAY
     1243         buf-OR_trn-doc.doc-code
     1244         buf-OR_trn-doc.doc-type FORMAT "X(3)"
     1245         buf-OR_trn-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)"
     1246         buf-OR_trn-doc.flag_ COLUMN-LABEL "Ок" FORMAT "+/-"
     1247         buf-OR_trn-doc.cli-type + string(buf-OR_trn-doc.cli-code)  COLUMN-LABEL "Контрагент"
     1248         buf-OR_trn-doc.obj-type + string(buf-OR_trn-doc.obj-code)  COLUMN-LABEL "Объект"
     1249         buf-OR_trn-doc.doc-date
     1250         buf-OR_trn-doc.fact-date
     1251         buf-OR_trn-doc.tot-lines
     1252         buf-OR_trn-doc.fact-qnty COLUMN-LABEL "Количество" FORMAT ">>>>>>>>9.<<<"
     1253         buf-OR_trn-doc.tot-rubl  COLUMN-LABEL "Сумма руб." FORMAT ">>>>>>>>>9.99"
     1254         buf-OR_trn-doc.contract-code COLUMN-LABEL "Вн.№ дог."
     1255       WITH NO-ROW-MARKERS SEPARATORS SIZE 94.75 BY 5.71.
     1256   DEFINE FRAME Dialog-Frame
     1257        b-quit AT ROW 1 COL 2
     1258        b-sel AT ROW 1 COL 14
     1259        b-rep AT ROW 1 COL 26
     1260        b-close AT ROW 1 COL 38
     1261        b-PS AT ROW 1 COL 50 WIDGET-ID 2
     1262        b-reject AT ROW 1 COL 62 WIDGET-ID 6
     1263        b-sch AT ROW 1 COL 84.5
     1264        b-print AT ROW 1 COL 87.5
     1265        b-hist AT ROW 1 COL 90.5
     1266        b-help AT ROW 1 COL 93.5
     1267        b-mark AT ROW 2 COL 2
     1268        b-add AT ROW 2 COL 5
     1269        b-lkp AT ROW 2 COL 14
     1270        b-chg AT ROW 2 COL 26
     1271        b-del AT ROW 2 COL 38
     1272        b-open AT ROW 2 COL 50
     1273        sch-code AT ROW 3.08 COL 26 COLON-ALIGNED
     1274        sch-date AT ROW 3.08 COL 47 COLON-ALIGNED
     1275        sch-fact AT ROW 3.08 COL 65.75 COLON-ALIGNED
     1276        br-docs AT ROW 4.21 COL 1
     1277        loc-ps AT ROW 15.08 COL 1.5 NO-LABEL WIDGET-ID 4
     1278        B-rez AT ROW 16.92 COL 1
     1279        B-lkp-2 AT ROW 16.92 COL 11
     1280        B-close-trn AT ROW 16.92 COL 21
     1281        br-zapr AT ROW 18 COL 1.5
     1282        sch-num AT ROW 3.25 COL 80.38 COLON-ALIGNED NO-LABEL
     1283        loc-boss AT ROW 14.25 COL 4.63 COLON-ALIGNED
     1284        loc-agnt AT ROW 14.25 COL 27.88 COLON-ALIGNED
     1285        loc-wrkr AT ROW 14.25 COL 53 COLON-ALIGNED
     1286        loc-creid AT ROW 14.25 COL 78.75 COLON-ALIGNED
     1287        " Поиск по:" VIEW-AS TEXT
     1288             SIZE 10.13 BY .67 AT ROW 3.25 COL 1.63
     1289             BGCOLOR 3 FGCOLOR 15
     1290        SPACE(84.62) SKIP(19.79)
     1291       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1292            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1293            TITLE "Список заказов ОРЦ".
     1294   ASSIGN
     1295          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1296          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1297   ASSIGN
     1298          B-close-trn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1299   ASSIGN
     1300          B-rez:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1301   ASSIGN
     1302          br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     1303   ASSIGN
     1304          loc-ps:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1305   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1306   DO:
     1307     delete widget-pool "my-pool" no-error  .
     1308     APPLY "END-ERROR":U TO SELF.
     1309   END.
     1310   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1311   DO:
     1312     run proc-add in this-procedure .
     1313   END.
     1314   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1315   DO:
     1316   do on stop undo, return no-apply :
     1317     find current buf-OR_ord-doc exclusive-lock no-error .
     1318   end.
     1319   define variable rr as recid no-undo .
     1320   define buffer buf_clients for ub.clients.
     1321   define buffer obj_clients for ub.clients.
     1322   define variable aobj-type as character no-undo .
     1323   define variable aobj-code as integer   no-undo .
     1324    if not available buf-or_ord-doc then return.
     1325      if not (
     1326      ( buf-OR_ord-doc.status_ = 'новый':U and buf-OR_ord-doc.flag_ = false ) or
     1327      ( buf-OR_ord-doc.status_ = 'запрос':U and buf-OR_ord-doc.flag_ = true  )
     1328      ) then do:
     1329         message "Нельзя корректировать заказ! " view-as alert-box  .
     1330         return.
     1331     end.
     1332     aobj-type  = buf-OR_ord-doc.obj-type .
     1333     aobj-code  = buf-OR_ord-doc.obj-code .
     1334   if buf-OR_ord-doc.status_ = 'запрос':U then do:
     1335         find first buf_clients no-lock where
     1336                   buf_clients.obj-code = buf-OR_ord-doc.cli-code and
     1337                   buf_clients.obj-type = buf-OR_ord-doc.cli-type
     1338                   no-error .
     1339     aobj-type  = buf-OR_ord-doc.cli-type .
     1340     aobj-code  = buf-OR_ord-doc.cli-code .
     1341         find first obj_clients no-lock where
     1342                   obj_clients.obj-code = buf-OR_ord-doc.obj-code and
     1343                   obj_clients.obj-type = buf-OR_ord-doc.obj-type
     1344                   no-error .
     1345         if buf_clients.db-num <> v-cntxt-db-num then do:
     1346             message "Корректировать возможно только в БД:"  buf_clients.db-num view-as alert-box error .
     1347             return .
     1348         end.
     1349         if  p-obj-code = buf-OR_ord-doc.obj-code and
     1350             p-obj-type = buf-OR_ord-doc.obj-type then do:
     1351           message "Корректирование в этом статусе возможно на объекте: "
     1352               buf-OR_ord-doc.cli-code
     1353               buf-OR_ord-doc.cli-type
     1354               view-as alert-box error .
     1355               return .
     1356         end.
     1357   end.
     1358     if   buf-OR_ord-doc.status_ = 'новый':U  and
     1359           not (p-obj-code = buf-OR_ord-doc.obj-code and
     1360                p-obj-type = buf-OR_ord-doc.obj-type ) then do:
     1361       message "Корректирование в этом статусе возможно на объекте: "
     1362           buf-OR_ord-doc.obj-code
     1363           buf-OR_ord-doc.obj-type
     1364           view-as alert-box error .
     1365           return .
     1366     end.
     1367   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1368   do:
     1369     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1370       (input  v-cntxt-db-num
     1371       ,input  v-cntxt-userid
     1372       ,input  0
     1373       ,input  'actn_o-r_update':U
     1374       ,input  'object':U
     1375       ,input  v-cntxt-host-code-obj
     1376       ,input  p-obj-type
     1377       ,input  p-obj-code
     1378       ,input  0
     1379       ,input  0
     1380       ,input  0
     1381       ,input  true
     1382       ,output g-log
     1383       )  .
     1384   end.
     1385     if not g-log then  return .
     1386     rr = recid(buf-or_ord-doc) .
     1387     run cus/ord-oru.w
     1388       ( input parparentproc,
     1389         input-output rr ,
     1390         input 'ИЗМЕНЕНИЕ':U ,
     1391    input-output br-handle ,
     1392    input-output next-prev
     1393         ) .
     1394     v-doc-rec = rr .
     1395     g#log =  br-docs:refresh() .
     1396     apply "value-changed" to br-docs in frame dialog-frame.
     1397     apply "entry" to br-docs in frame dialog-frame.
     1398   END.
     1399   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     1400   DO:
     1401   define variable rr as recid no-undo .
     1402     if not available buf-or_ord-doc then return.
     1403     rr = recid(buf-or_ord-doc) .
     1404       if buf-or_ord-doc.status_ <> 'новый':U  then do:
     1405       end.
     1406     run ord-close in this-procedure (recid(buf-or_ord-doc)) .
     1407     run openbr in this-procedure (yes, no, '':u).
     1408     reposition br-docs to recid rr no-error.
     1409     apply "value-changed" to br-docs in frame dialog-frame.
     1410     apply "entry" to br-docs in frame dialog-frame.
     1411   END.
     1412   ON CHOOSE OF B-close-trn IN FRAME Dialog-Frame
     1413   DO:
     1414    if not available buf-OR_trn-doc   then return.
     1415    message "Закрыть накладную ?"
     1416     view-as alert-box question
     1417     buttons yes-no
     1418     update g-log.
     1419     if g-log = false then return no-apply.
     1420       run close-zapr in this-procedure ( input buf-OR_trn-doc.doc-code ) .
     1421      OPEN QUERY br-zapr FOR EACH buf-OR_ord-doc-rcv WHERE                   buf-OR_ord-doc-rcv.doc-code = buf-OR_ord-doc.doc-code NO-LOCK,         each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-OR_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'          ,          EACH buf-OR_trn-doc  where        buf-OR_trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     1422   END.
     1423   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1424   DO:
     1425     if not available buf-OR_ord-doc then return.
     1426   do on stop undo, return no-apply :
     1427     find current buf-OR_ord-doc exclusive-lock .
     1428   end.
     1429     if not( buf-OR_ord-doc.status_ = 'новый':U and buf-OR_ord-doc.flag_ = false ) then do:
     1430       if buf-OR_ord-doc.cli-code = p-obj-code and
     1431          buf-OR_ord-doc.cli-type = p-obj-type and
     1432          buf-OR_ord-doc.status_  = 'запрос':U
     1433          then do:
     1434             run ord-del (recid(buf-OR_ord-doc)) .
     1435             return .
     1436       end.
     1437       message "Нельзя удалять заказ ! " view-as alert-box  .
     1438       return .
     1439     end.
     1440     if   not (p-obj-code = buf-OR_ord-doc.obj-code and
     1441               p-obj-type = buf-OR_ord-doc.obj-type ) then do:
     1442       message "Удалить этом статусе возможно на объекте: "
     1443           buf-OR_ord-doc.obj-code
     1444           buf-OR_ord-doc.obj-type
     1445           view-as alert-box error .
     1446           return .
     1447     end.
     1448     run ord-del in this-procedure ( recid ( buf-OR_ord-doc ) ) .
     1449   END.
     1450   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1451   DO:
     1452   if not available buf-OR_ord-doc then return .
     1453       run cus/ordcdoc.w
     1454       (
     1455       parParentProc,
     1456       buf-OR_ord-doc.host-code,
     1457       buf-OR_ord-doc.doc-code,
     1458       "" ) .
     1459   END.
     1460   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1461   DO:
     1462    if not available buf-OR_ord-doc then return .
     1463    define variable rr as recid no-undo .
     1464    rr = recid(buf-OR_ord-doc) .
     1465         br-handle = br-docs:handle in frame Dialog-Frame .
     1466         next-prev = no.
     1467         do while next-prev <> ?:
     1468           if not available buf-OR_ord-doc then do:
     1469             message "Неправильный выбор документа.".
     1470             return no-apply.
     1471           end.
     1472             run cus/ord-oru.w
     1473                ( input parparentproc,
     1474                  input-output rr ,
     1475                  input 'ПРОСМОТР':U ,
     1476                  input-output br-handle ,
     1477                  input-output next-prev
     1478                  ).
     1479             v-doc-rec = rr .
     1480           if br-handle = ? then reposition br-docs to recid rr no-error.
     1481         end.
     1482   apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1483   END.
     1484   ON CHOOSE OF B-lkp-2 IN FRAME Dialog-Frame
     1485   DO:
     1486      if not available buf-or_trn-doc then return .
     1487         run str/showdoc.p
     1488             (input parparentproc
     1489             ,input buf-or_trn-doc.doc-code
     1490             ,input ""
     1491             ,input ""
     1492             ,input 0
     1493             ,input true
     1494             ) no-error .
     1495             if error-status :error then message
     1496               vss-workfile vss-revision vss-description skip
     1497               error-status :get-message(1) skip
     1498               return-value skip
     1499               "Ошибка из showdoc.p"
     1500               view-as alert-box error
     1501             .
     1502   END.
     1503   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1504   DO:
     1505           if available buf-OR_ord-doc then do:
     1506   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   define variable v-str-recid17 as character no-undo .
     1508   define variable v-num-entry17 as integer   no-undo .
     1509   assign
     1510     v-str-recid17 = trim( string( recid( buf-OR_ord-doc ) , "->>>>>>>>>>>9":U ) )
     1511     v-num-entry17 = lookup( v-str-recid17 , rid-list )
     1512   .
     1513   if v-num-entry17 > 0 then do:
     1514     assign
     1515       entry( v-num-entry17, rid-list ) = "":U
     1516       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1517     .
     1518   end.
     1519   else do:
     1520     assign
     1521       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1522     .
     1523   end.
     1524           g-log = br-docs:refresh() .
     1525           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1526               g-log = br-docs:select-next-row ().
     1527               apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1528           end.
     1529       end.
     1530       apply "entry" to br-docs in frame Dialog-Frame.
     1531   END.
     1532   ON CHOOSE OF b-open IN FRAME Dialog-Frame
     1533   DO:
     1534     define variable rr as recid no-undo .
     1535     if not available buf-OR_ord-doc then return.
     1536     rr = recid(buf-OR_ord-doc) .
     1537     run ord-open in this-procedure (recid(buf-OR_ord-doc)) .
     1538     run openbr in this-procedure (yes, no, '':u).
     1539     reposition br-docs to recid rr no-error.
     1540     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1541     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1542   END.
     1543   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1544   DO:
     1545     find current buf-OR_ord-doc no-lock no-error .
     1546     if available buf-OR_ord-doc then
     1547         run cus/torg-26.p
     1548           ( input parParentProc ,
     1549             recid (buf-or_ord-doc) ).
     1550   END.
     1551   ON CHOOSE OF b-PS IN FRAME Dialog-Frame
     1552   DO:
     1553    if not available buf-OR_ord-doc then return .
     1554    define variable notes as character no-undo.
     1555       notes = buf-OR_ord-doc.ps .
     1556       run gbl/notes.w ( input 'ПРОСМОТР':U , input-output notes).
     1557   END.
     1558   ON CHOOSE OF b-reject IN FRAME Dialog-Frame
     1559   DO:
     1560   define variable rr as recid no-undo .
     1561     if not available buf-or_ord-doc then return.
     1562       rr = recid(buf-or_ord-doc) .
     1563       if buf-or_ord-doc.status_ <> 'запрос':U then do:
     1564          message "Отказать можно в статусе ЗАПРОС !" view-as alert-box  .
     1565          return .
     1566       end.
     1567    message "Вы действительно хотите поставить статус ОТКАЗАТЬ на заказ ?"
     1568      view-as alert-box question
     1569     buttons yes-no
     1570     update g-log.
     1571     if g-log = false then return .
     1572     find current buf-or_ord-doc exclusive-lock no-error .
     1573     if available buf-or_ord-doc then do:
     1574        buf-or_ord-doc.status_ =  'отказ':U .
     1575     end.
     1576     run openbr in this-procedure (yes, no, '':u).
     1577     reposition br-docs to recid rr no-error.
     1578     apply "value-changed" to br-docs in frame dialog-frame.
     1579     apply "entry" to br-docs in frame dialog-frame.
     1580   END.
     1581   ON CHOOSE OF b-rep IN FRAME Dialog-Frame
     1582   DO:
     1583     run gbl/pop-up.p ( self:handle, no) no-error.
     1584     if error-status:error then return no-apply.
     1585   END.
     1586   ON CHOOSE OF B-rez IN FRAME Dialog-Frame
     1587   DO:
     1588   if not available buf-OR_ord-doc then return .
     1589   do transaction :
     1590     find current buf-OR_ord-doc exclusive-lock .
     1591     if not available buf-OR_ord-doc then do:
     1592       message
     1593         vss-workfile vss-revision vss-description skip
     1594         error-status :get-message(1) skip
     1595         return-value skip
     1596         "3"
     1597         view-as alert-box error
     1598       .
     1599       return .
     1600   end.
     1601   g#log =  br-docs:refresh() .
     1602   define variable v-ok  as logical   no-undo .
     1603   define buffer buf_clients for ub.clients.
     1604   define buffer obj_clients for ub.clients.
     1605   if not available buf-OR_ord-doc then return .
     1606   if buf-OR_ord-doc.status_ <> 'запрос':U then  do:
     1607       message "Создание накладной невозможно в этом статусе !" view-as alert-box error .
     1608       return .
     1609   end.
     1610   find first buf_clients no-lock where
     1611              buf_clients.obj-code = buf-OR_ord-doc.cli-code and
     1612              buf_clients.obj-type = buf-OR_ord-doc.cli-type
     1613              no-error .
     1614   find first obj_clients no-lock where
     1615              obj_clients.obj-code = buf-OR_ord-doc.obj-code and
     1616              obj_clients.obj-type = buf-OR_ord-doc.obj-type
     1617              no-error .
     1618    if buf_clients.db-num <> v-cntxt-db-num then do:
     1619       message "Создание накладной возможно только в БД:"  buf_clients.db-num view-as alert-box error .
     1620       return .
     1621    end.
     1622    if p-obj-code = buf-OR_ord-doc.obj-code and
     1623       p-obj-type = buf-OR_ord-doc.obj-type then do:
     1624     message "Создание накладной возможно на объекте: "
     1625         buf-OR_ord-doc.cli-code
     1626         buf-OR_ord-doc.cli-type
     1627         view-as alert-box error .
     1628         return .
     1629    end.
     1630    if obj_clients.host-code <> buf_clients.host-code then do:
     1631           message "Создавать накладную межфирменного перемещения ?"
     1632           view-as alert-box question
     1633           buttons yes-no
     1634           update v-ok
     1635           .
     1636           if v-ok  = false then return .
     1637           run cus/crhldr.p
     1638             ( input parparentproc ,
     1639               input buf-OR_ord-doc.doc-code ) no-error .
     1640           if error-status :error then
     1641           message
     1642             vss-workfile vss-revision vss-description skip
     1643             error-status :get-message(1) skip
     1644             return-value skip
     1645             "ошибка из crhldr.p"
     1646             view-as alert-box error
     1647           .
     1648        end.
     1649       else do:
     1650           message "Создавать внутреннюю расходную накладную ?"
     1651             view-as alert-box question
     1652             buttons yes-no
     1653             update v-ok
     1654             .
     1655           if v-ok  = false then return .
     1656           run cus/crrasper.p
     1657             ( input parparentproc ,
     1658               input buf-OR_ord-doc.doc-code ) no-error .
     1659           if error-status :error then
     1660           message
     1661             vss-workfile vss-revision vss-description skip
     1662             error-status :get-message(1) skip
     1663             return-value skip
     1664             "ошибка из crrasper.p"
     1665             view-as alert-box error
     1666           .
     1667       end.
     1668     end.
     1669     g#log =  br-docs:refresh() .
     1670     OPEN QUERY br-zapr FOR EACH buf-OR_ord-doc-rcv WHERE                   buf-OR_ord-doc-rcv.doc-code = buf-OR_ord-doc.doc-code NO-LOCK,         each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-OR_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'          ,          EACH buf-OR_trn-doc  where        buf-OR_trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     1671   END.
