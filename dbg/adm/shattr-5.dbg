      955   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      956   define variable v-date-str as character no-undo .
      957   assign
      958   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      959                string(Month(p-date), "99":U) + chr(47) +
      960                string(DAY(p-date), "99":U).
      961   return v-date-str.
      962   END FUNCTION.
      963   function dct-algo-string-to-date returns date ( input p-string  as character):
      964     define variable v-date as date no-undo .
      965     assign
      966     v-date = date(integer(substring(p-string, 6, 2))
      967                   ,integer(substring(p-string, 9, 2))
      968                   ,integer(substring(p-string, 1, 4))
      969                  ) no-error .
      970     if error-status:error then return ?.
      971     return v-date.
      972   END FUNCTION.
      973   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      974   define buffer buf_prop-ref for ub.prop-ref.
      975   find first buf_prop-ref no-lock where
      976             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      977   if not available buf_prop-ref then do:
      978     return chr(63).
      979   end.
      980   return buf_prop-ref.sum-id.
      981   END FUNCTION.
      982   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      983   define variable v-des as character no-undo .
      984   define buffer buf_prop-ref for ub.prop-ref.
      985   define buffer buf_prop-head for ub.prop-head.
      986   find first buf_prop-ref no-lock where
      987             buf_prop-ref.dt-code = p-dt-code no-error.
      988   if not available buf_prop-ref then do:
      989     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      990   end.
      991   find first buf_prop-head no-lock where
      992           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      993   if not available buf_prop-head then do:
      994     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      995   end.
      996   assign
      997   v-des = substitute("&1  &2 &3"
      998                     , buf_prop-head.prop-name
      999                     , buf_prop-ref.sum-id
     1000                     , buf_prop-ref.caller_id).
     1001   return v-des.
     1002   end FUNCTION.
     1003   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     1004                                                               ,input p-dt-code as integer
     1005                                                               ,input p-node-code as integer
     1006                                                               ):
     1007   define variable v-des as character no-undo .
     1008   define buffer buf_prop-ref for ub.prop-ref.
     1009   define buffer buf_prop-head for ub.prop-head.
     1010   define buffer buf_prop-map for ub.prop-map.
     1011   find first buf_prop-ref no-lock where
     1012             buf_prop-ref.dt-code = p-dt-code no-error.
     1013   if not available buf_prop-ref then do:
     1014     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1015   end.
     1016   find first buf_prop-head no-lock where
     1017           buf_prop-head.dtm-code = p-dtm-code no-error.
     1018   if not available buf_prop-head then do:
     1019     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     1020   end.
     1021   find first buf_prop-map no-lock where
     1022           buf_prop-map.dtm-code = p-dtm-code
     1023       and buf_prop-map.node-code = p-node-code no-error .
     1024   if not available buf_prop-map then do:
     1025     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     1026                       , p-dt-code
     1027                       , buf_prop-head.prop-label
     1028                       , p-node-code).
     1029   end.
     1030   assign
     1031   v-des = substitute("&1.&2 &3 &4"
     1032                     , buf_prop-head.prop-label
     1033                     , buf_prop-map.node-label
     1034                     , buf_prop-ref.sum-id
     1035                     , buf_prop-ref.caller_id).
     1036   return v-des.
     1037   end FUNCTION.
     1038   function dct-algo-get-prev-sum-id RETURNS integer (
     1039                                                       input p-dt-code as integer
     1040                                                      ):
     1041   define variable v-dtm-code as integer no-undo .
     1042   define variable v-sum-id as character no-undo .
     1043   define variable v-caller-id as character no-undo .
     1044   define buffer buf_prop-ref for ub.prop-ref.
     1045   find first buf_prop-ref no-lock where
     1046           buf_prop-ref.dt-code = p-dt-code no-error.
     1047   if not available buf_prop-ref then return ?.
     1048   assign
     1049   v-dtm-code = buf_prop-ref.dtm-code
     1050   v-sum-id = buf_prop-ref.sum-id.
     1051   v-caller-id = buf_prop-ref.caller_id.
     1052   find last buf_prop-ref no-lock where
     1053             buf_prop-ref.dtm-code = v-dtm-code
     1054        and  buf_prop-ref.sum-id < v-sum-id
     1055        and  buf_prop-ref.caller_id = v-caller-id
     1056        no-error.
     1057   if available buf_prop-ref then return buf_prop-ref.dt-code.
     1058   return -1 .
     1059   END FUNCTION.
     1060   FUNCTION dct-algo-get_dcproperty-value returns logical (
     1061                                                             input p-prop-name as character
     1062                                                           , input p-d-card    as character
     1063                                                           , input p-host-code as integer
     1064                                                           , input p-obj-type  as character
     1065                                                           , input p-obj-code  as integer
     1066                                                           , output p-value-character as character
     1067                                                           , output p-value-date   as date
     1068                                                           , output p-value-integer as integer
     1069                                                           , output p-value-decimal as decimal
     1070                                                           , output p-value-logical as logical):
     1071     return no.
     1072   END FUNCTION.
     1073   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     1074                                                             input p-d-card    as character
     1075                                                           , input p-emitent-host-code as integer
     1076                                                           , input p-type as character
     1077                                                           , input p-host-code as integer
     1078                                                           , input p-obj-type  as character
     1079                                                           , input p-obj-code  as integer
     1080                                                           , output p-value-chr as character):
     1081   define variable v-dt-code as integer no-undo .
     1082   define variable v-node-code as integer no-undo .
     1083   define variable v-field-name as character no-undo .
     1084   define variable v-storage-place as character no-undo .
     1085   define variable v-sum-id-value as character no-undo .
     1086   define variable v-sum-id-output as logical no-undo .
     1087   define variable v-value-chr as character no-undo .
     1088   define variable v-ii as integer no-undo .
     1089   define buffer buf_dis-card-property for ub.dis-card-property.
     1090   define buffer buf_dis-host for ub.dis-host.
     1091   define buffer buf_dis-obj for ub.dis-obj.
     1092   run get-cd-sumid in this-procedure (
     1093                                         input p-emitent-host-code
     1094                                        ,input p-type
     1095                                        ,input p-host-code
     1096                                        ,input p-obj-type
     1097                                        ,input p-obj-code
     1098                                        ,output v-sum-id-value
     1099                                        ,output v-sum-id-output
     1100                                       ) no-error.
     1101   if not v-sum-id-output then do:
     1102     return no.
     1103   end.
     1104   do v-ii = 1 to num-entries(v-sum-id-value):
     1105     assign
     1106     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     1107     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     1108     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     1109     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     1110     no-error .
     1111     if not error-status:error then do:
     1112       case v-storage-place:
     1113         when 'dis-card-property':U then do:
     1114           find first buf_dis-card-property no-lock where
     1115                     buf_dis-card-property.d-card = p-d-card
     1116               and  buf_dis-card-property.host-code = p-host-code
     1117               and  buf_dis-card-property.obj-type = p-obj-type
     1118               and  buf_dis-card-property.obj-code = p-obj-code
     1119               and  buf_dis-card-property.dt-code = v-dt-code
     1120               and  buf_dis-card-property.node-code = v-node-code no-error .
     1121           if available buf_dis-card-property then do:
     1122             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     1123           end.
     1124           else do:
     1125             v-value-chr = chr(63).
     1126           end.
     1127         end.
     1128         when 'dis-obj':U then do:
     1129           find first buf_dis-obj no-lock where
     1130                     buf_dis-obj.d-card = p-d-card
     1131               and  buf_dis-obj.obj-type = p-obj-type
     1132               and  buf_dis-obj.obj-code = p-obj-code
     1133               and  buf_dis-obj.dt-code = v-dt-code no-error .
     1134           if available buf_dis-obj then do:
     1135             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     1136           end.
     1137           else do:
     1138             v-value-chr = chr(63).
     1139           end.
     1140         end.
     1141         when 'dis-host':U then do:
     1142           find first buf_dis-host no-lock where
     1143                     buf_dis-host.d-card = p-d-card
     1144               and  buf_dis-host.host-code = p-host-code
     1145               and  buf_dis-host.dt-code = v-dt-code no-error .
     1146           if available buf_dis-host then do:
     1147             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     1148           end.
     1149           else do:
     1150             v-value-chr = chr(63).
     1151           end.
     1152         end.
     1153       end.
     1154     end.
     1155     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     1156   end.
     1157   END FUNCTION.
     1158   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     1159     ( INPUT p-custom-sent as character ) :
     1160   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     1161   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     1162   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     1163   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     1164   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     1165   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     1166   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1167   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     1168   assign
     1169   v-storage-place = entry(1, p-custom-sent, chr(4))
     1170   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     1171   v-sum-id   = entry(3, p-custom-sent, chr(4))
     1172   v-caller-id = entry(4, p-custom-sent, chr(4))
     1173   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     1174   no-error .
     1175   IF ERROR-STATUS:ERROR THEN DO:
     1176     MESSAGE
     1177     "Не могу разобрать строку, описывающую итог"
     1178      VIEW-AS ALERT-BOX WARNING.
     1179     RETURN chr(63).
     1180   END.
     1181   FIND FIRST buf_prop-ref NO-LOCK WHERE
     1182             buf_prop-ref.dtm-code = v-dtm-code
     1183        AND  buf_prop-ref.sum-id = v-sum-id
     1184        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1185   IF NOT AVAILABLE buf_prop-ref THEN DO:
     1186     FIND FIRST buf_prop-ref NO-LOCK WHERE
     1187               buf_prop-ref.dtm-code = v-dtm-code
     1188         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1189     IF NOT AVAILABLE buf_prop-ref THEN DO:
     1190         MESSAGE
     1191         "Не могу разобрать строку, описывающую итог"
     1192          VIEW-AS ALERT-BOX WARNING.
     1193         RETURN chr(63).
     1194      end.
     1195   end.
     1196   ASSIGN
     1197   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     1198                                                          ,buf_prop-ref.dt-code
     1199                                                          ,v-node-code).
     1200   RETURN v-sum-id-description.
     1201   END FUNCTION.
     1202   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   procedure gen-key-rec :
     1204     define input  parameter p-tbl-name    as character no-undo.
     1205     define input  parameter p-bh_tbl-name as handle    no-undo.
     1206     define output parameter p-key-rec     as character no-undo.
     1207     do
     1208     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1209     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1210     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1211     :
     1212       define variable fh               as handle    no-undo .
     1213       define variable v-ok             as logical   no-undo .
     1214       define variable v-inform         as character no-undo .
     1215       define variable v-ind            as integer   no-undo .
     1216       define variable v-idx-field-qnty as integer   no-undo .
     1217       if p-tbl-name = ?
     1218         or p-tbl-name = "":U
     1219       then do:
     1220         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
     1221       end.
     1222       if not p-bh_tbl-name:available then do:
     1223         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
     1224       end.
     1225       assign
     1226         p-key-rec = p-tbl-name
     1227         v-inform  = p-bh_tbl-name:index-information(1)
     1228         v-ind     = 2
     1229       .
     1230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1231       on error undo, return error
     1232       :
     1233         assign
     1234           v-inform = p-bh_tbl-name:index-information( v-ind )
     1235           v-ind    = v-ind + 1
     1236         .
     1237       end.
     1238       if v-inform = ?
     1239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1240         or entry( 3, v-inform, ",":U ) <> "1":U
     1241       then do:
     1242         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1243       end.
     1244       else do:
     1245         assign
     1246           v-idx-field-qnty = num-entries( v-inform ) - 4
     1247         .
     1248         if v-idx-field-qnty < 2 then do:
     1249           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1250         end.
     1251         do v-ind = 1 to v-idx-field-qnty by 2
     1252         on error undo, return error
     1253         :
     1254           assign
     1255             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1256             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1257           .
     1258         end.
     1259       end.
     1260       if p-key-rec = ? then do:
     1261         assign
     1262           p-key-rec = "":U
     1263         .
     1264         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1265       end.
     1266     end.
     1267     return.
     1268   end procedure.
     1269   procedure gen-where-keyr-tab :
     1270     define input  parameter i-tableSerach as character no-undo.
     1271     define input  parameter i-tablekey   as character  no-undo.
     1272     define input  parameter p-key-rec    as character  no-undo.
     1273     define input  parameter p-key-handle as handle     no-undo .
     1274     define input  parameter p-db-name    as character  no-undo .
     1275     define input  parameter p-tt-handle  as handle     no-undo .
     1276     define output parameter o-Where      as character  no-undo.
     1277     do
     1278     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1279     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1280     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1281     :
     1282       define variable v-full-tbl-name  as character no-undo .
     1283       define variable bh_tbl-name      as handle    no-undo .
     1284       define variable fh_key           as handle    no-undo .
     1285       define variable fh_search        as handle    no-undo .
     1286       define variable v-field-num      as integer   no-undo .
     1287       define variable v-count-fld      as integer   no-undo .
     1288       define variable v-inform         as character no-undo .
     1289       define variable v-ind            as integer   no-undo .
     1290       define variable v-idx-field-qnty as integer   no-undo .
     1291       define variable v-field-name     as character no-undo .
     1292       define variable v-field-val      as character no-undo .
     1293       define variable v-word-link      as character no-undo .
     1294       define variable vTable           as character no-undo.
     1295       define variable bh_tbl-key       as handle    no-undo .
     1296       assign
     1297         p-key-rec = trim( p-key-rec )
     1298       .
     1299       if p-key-handle <> ? then do:
     1300         if not valid-handle(p-key-handle)
     1301            or p-key-handle:type <> "buffer"
     1302         then do:
     1303           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1304         end.
     1305         if num-entries( p-key-rec, chr(3) ) > 1
     1306           or p-key-rec = ?
     1307           or p-key-rec = "":U
     1308         then do:
     1309           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1310         end.
     1311       end.
     1312       else do:
     1313         if p-key-rec = ?
     1314           or p-key-rec = "":U
     1315         then do:
     1316           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1317         end.
     1318       end.
     1319       assign
     1320         vTable = entry( 1 , p-key-rec, chr(3) )
     1321       .
     1322       if p-tt-handle <> ?
     1323         and ( not valid-handle(p-tt-handle)
     1324               or p-tt-handle:type <> "buffer"
     1325             )
     1326       then do:
     1327         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1328       end.
     1329       if p-tt-handle = ? then do:
     1330         assign
     1331           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1332         .
     1333         create buffer bh_tbl-name for table v-full-tbl-name .
     1334       end.
     1335       else do:
     1336         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1337       end.
     1338       assign
     1339         v-inform = bh_tbl-name:index-information(1)
     1340         v-ind    = 2
     1341       .
     1342       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1343       on error undo, return error
     1344       :
     1345         assign
     1346           v-inform = bh_tbl-name:index-information( v-ind )
     1347           v-ind    = v-ind + 1
     1348         .
     1349       end.
     1350       if v-inform = ?
     1351         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1352         or entry( 3, v-inform, ",":U ) <> "1":U
     1353       then do:
     1354         delete object bh_tbl-name no-error.
     1355         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1356       end.
     1357       assign
     1358         v-idx-field-qnty = num-entries( v-inform ) - 4
     1359       .
     1360       if v-idx-field-qnty < 2 then do:
     1361         delete object bh_tbl-name no-error.
     1362         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1363       end.
     1364       assign
     1365         o-where     = "where":U
     1366         v-word-link = "":U
     1367         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1368         v-count-fld = 0
     1369       .
     1370       if i-tablekey ne "" and i-tablekey ne ?
     1371       then do:
     1372         assign
     1373           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1374         .
     1375         create buffer bh_tbl-key for table v-full-tbl-name .
     1376       end.
     1377       if i-tableSerach ne "" and i-tableSerach ne ?
     1378       then do:
     1379         delete object bh_tbl-name no-error.
     1380         assign
     1381           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1382         .
     1383         create buffer bh_tbl-name for table v-full-tbl-name .
     1384       end.
     1385       block_where:
     1386       do v-ind = 1 to v-idx-field-qnty by 2
     1387       on error undo, return error
     1388       :
     1389         assign
     1390           v-count-fld = v-count-fld + 1
     1391         .
     1392         if p-key-handle = ?
     1393           and v-count-fld > v-field-num
     1394         then do:
     1395           leave block_where.
     1396         end.
     1397         define variable VfieldKeyTable as handle no-undo.
     1398         assign
     1399           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1400           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1401         .
     1402         if     bh_tbl-key ne ?
     1403         then do:
     1404            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1405            if VfieldKeyTable eq ?
     1406            then next block_where.
     1407         end.
     1408         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1409         then
     1410            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1411         else
     1412            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1413         if p-key-handle = ? then do:
     1414           assign
     1415             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1416           .
     1417         end.
     1418         else do:
     1419           assign
     1420             fh_key = p-key-handle:buffer-field( v-field-name )
     1421           .
     1422           if fh_key = ?
     1423             or not valid-handle( fh_key )
     1424           then do:
     1425             delete object bh_tbl-name.
     1426             if     bh_tbl-key ne ?
     1427             then
     1428                delete object bh_tbl-key.
     1429             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1430           end.
     1431           assign
     1432             v-field-val = fh_key:buffer-value
     1433           .
     1434         end.
     1435         if fh_search:data-type ="character":U then do:
     1436           assign
     1437             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1438             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1439             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1440             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1441             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1442             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1443             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1444             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1445             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1446             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1447             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1448             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1449             v-field-val = substitute( '"&1"', v-field-val )
     1450           .
     1451         end.
     1452         assign
     1453           o-where = substitute( "&1 &2", o-where, v-field-val )
     1454         .
     1455         if v-word-link = "":U then do:
     1456           assign
     1457             v-word-link = "and":U
     1458           .
     1459         end.
     1460       end.
     1461       delete object bh_tbl-name.
     1462       if     bh_tbl-key ne ?
     1463       then
     1464          delete object bh_tbl-key.
     1465       if p-key-handle = ?
     1466         and v-count-fld <> v-field-num
     1467       then do:
     1468         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1469       end.
     1470     end.
     1471   end procedure.
     1472   procedure gen-hn-keyr-tab :
     1473     define input  parameter i-tableSerach as character no-undo.
     1474     define input  parameter i-tablekey   as character no-undo.
     1475     define input  parameter p-key-rec    as character no-undo.
     1476     define input  parameter p-key-handle as handle    no-undo .
     1477     define input  parameter p-db-name    as character no-undo .
     1478     define input  parameter p-tt-handle  as handle    no-undo .
     1479     define input  parameter p-stts-lock  as integer   no-undo .
     1480     define output parameter o-hn         as handle    no-undo.
     1481     define variable v-full-tbl-name as character no-undo.
     1482     define variable v-where         as character no-undo.
     1483     define variable bh_tbl-name     as handle    no-undo.
     1484     define variable vTable          as character no-undo.
     1485     do
     1486     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1487     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1488     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1489         run gen-where-keyr-tab(i-tableSerach,
     1490                                i-tablekey,
     1491                                p-key-rec,
     1492                                p-key-handle,
     1493                                p-db-name,
     1494                                p-tt-handle,
     1495                                output v-where).
     1496         if i-tableSerach ne "" and i-tableSerach ne ?
     1497         then do:
     1498            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1499            create buffer bh_tbl-name for table v-full-tbl-name .
     1500         end.
     1501         else do:
     1502            if p-tt-handle = ? then do:
     1503               assign
     1504                  vTable = entry( 1 , p-key-rec, chr(3) )
     1505               .
     1506               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1507               create buffer bh_tbl-name for table v-full-tbl-name .
     1508            end.
     1509            else do:
     1510               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1511            end.
     1512         end.
     1513         if p-tt-handle = ? then do:
     1514            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1515         end.
     1516         else do:
     1517            bh_tbl-name:find-first( v-where ) no-error .
     1518         end.
     1519         o-hn = bh_tbl-name.
     1520      end.
     1521   end procedure.
     1522   procedure gen-hn-keyr :
     1523     define input  parameter p-key-rec    as character no-undo.
     1524     define input  parameter p-key-handle as handle    no-undo .
     1525     define input  parameter p-db-name    as character no-undo .
     1526     define input  parameter p-tt-handle  as handle    no-undo .
     1527     define input  parameter p-stts-lock  as integer   no-undo .
     1528     define output parameter o-hn         as handle    no-undo.
     1529     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1530   end.
     1531   procedure gen-row-keyr :
     1532     define input  parameter p-key-rec    as character no-undo.
     1533     define input  parameter p-key-handle as handle    no-undo .
     1534     define input  parameter p-db-name    as character no-undo .
     1535     define input  parameter p-tt-handle  as handle    no-undo .
     1536     define input  parameter p-stts-lock  as integer   no-undo .
     1537     define output parameter p-tbl-row    as rowid     no-undo.
     1538     define output parameter p-tbl-name   as character no-undo.
     1539     define variable vHn as handle no-undo.
     1540       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1541       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1542       p-tbl-name =  vHn:table.
     1543       delete object vHn no-error.
     1544     if p-tbl-row = ? then do:
     1545       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1546     end.
     1547     else do:
     1548       return.
     1549     end.
     1550   end procedure.
     1551   procedure gen-key-fv :
     1552     define input  parameter p-key-rec    as character no-undo .
     1553     define output parameter p-field-list as character no-undo .
     1554     define output parameter p-value-list as character no-undo.
     1555     do
     1556     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1557     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1558     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1559     :
     1560       define variable v-full-tbl-name  as character no-undo .
     1561       define variable bh_tbl-name      as handle    no-undo .
     1562       define variable v-tbl-name       as character no-undo .
     1563       define variable v-field-num      as integer   no-undo .
     1564       define variable v-count-fld      as integer   no-undo .
     1565       define variable v-inform         as character no-undo .
     1566       define variable v-ind            as integer   no-undo .
     1567       define variable v-idx-field-qnty as integer   no-undo .
     1568       define variable v-delim-key      as character no-undo .
     1569       if p-key-rec = ?
     1570         or p-key-rec = "":U
     1571       then do:
     1572         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1573       end.
     1574       assign
     1575         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1576         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1577       .
     1578       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1579       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1580       assign
     1581         v-inform = bh_tbl-name:index-information(1)
     1582         v-ind    = 2
     1583       .
     1584       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-inform = bh_tbl-name:index-information( v-ind )
     1589           v-ind    = v-ind + 1
     1590         .
     1591       end.
     1592       if v-inform = ?
     1593         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1594         or entry( 3, v-inform, ",":U ) <> "1":U
     1595       then do:
     1596         delete object bh_tbl-name no-error.
     1597         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1598       end.
     1599       assign
     1600         v-idx-field-qnty = num-entries( v-inform ) - 4
     1601       .
     1602       if v-idx-field-qnty < 2 then do:
     1603         delete object bh_tbl-name no-error.
     1604         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1605       end.
     1606       assign
     1607         p-field-list = "":U
     1608         p-value-list = "":U
     1609         v-delim-key  = "":U
     1610         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1611         v-count-fld  = 0
     1612       .
     1613       block_where:
     1614       do v-ind = 1 to v-idx-field-qnty by 2
     1615       on error undo, return error
     1616       :
     1617         assign
     1618           v-count-fld = v-count-fld + 1
     1619         .
     1620         if v-count-fld > v-field-num then do:
     1621           leave block_where.
     1622         end.
     1623         assign
     1624           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1625           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1626         .
     1627         if v-ind = 1 then do:
     1628           assign
     1629             v-delim-key = chr(3)
     1630           .
     1631         end.
     1632       end.
     1633       delete object bh_tbl-name.
     1634       if v-count-fld <> v-field-num then do:
     1635         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1636       end.
     1637     end.
     1638   end procedure.
     1639   procedure gen-key-field :
     1640     define input  parameter p-table      as character no-undo .
     1641     define output parameter p-field-list as character no-undo .
     1642     do
     1643     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1644     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1645     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1646     :
     1647       define variable v-full-tbl-name  as character no-undo .
     1648       define variable bh_tbl-name      as handle    no-undo .
     1649       define variable v-tbl-name       as character no-undo .
     1650       define variable v-field-num      as integer   no-undo .
     1651       define variable v-count-fld      as integer   no-undo .
     1652       define variable v-inform         as character no-undo .
     1653       define variable v-ind            as integer   no-undo .
     1654       define variable v-idx-field-qnty as integer   no-undo .
     1655       define variable v-delim-key      as character no-undo .
     1656       if p-table = ?
     1657         or p-table = "":U
     1658       then do:
     1659         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1660       end.
     1661       assign
     1662         v-tbl-name      = p-table
     1663         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1664       .
     1665       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1666       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1667       assign
     1668         v-inform = bh_tbl-name:index-information(1)
     1669         v-ind    = 2
     1670       .
     1671       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1672       on error undo, return error
     1673       :
     1674         assign
     1675           v-inform = bh_tbl-name:index-information( v-ind )
     1676           v-ind    = v-ind + 1
     1677         .
     1678       end.
     1679       if v-inform = ?
     1680         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1681         or entry( 3, v-inform, ",":U ) <> "1":U
     1682       then do:
     1683         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1684       end.
     1685       assign
     1686         v-idx-field-qnty = num-entries( v-inform ) - 4
     1687       .
     1688       if v-idx-field-qnty < 2 then do:
     1689         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1690       end.
     1691       assign
     1692         p-field-list = "":U
     1693         v-delim-key  = "":U
     1694         v-count-fld  = 0
     1695       .
     1696       block_where:
     1697       do v-ind = 1 to v-idx-field-qnty by 2
     1698       on error undo, return error
     1699       :
     1700         assign
     1701           v-count-fld = v-count-fld + 1
     1702         .
     1703         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1704         if v-ind = 1 then do:
     1705           assign
     1706             v-delim-key = chr(3)
     1707           .
     1708         end.
     1709       end.
     1710       delete object bh_tbl-name.
     1711     end.
     1712   end procedure.
     1713   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
     1714   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
     1715   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
     1716   DEFINE VARIABLE l-name-2cd-init AS CHARACTER NO-UNDO.
     1717   DEFINE VARIABLE v-rid-list      AS CHARACTER NO-UNDO.
     1718   DEFINE VARIABLE v-ok            AS logical   NO-UNDO.
     1719   define variable v-tbl-row       as rowid     no-undo .
     1720   define variable v-tbl-name      as character no-undo .
     1721   define buffer buf_ext-system for ub.ext-system.
     1722   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1723   define variable v-tth as handle no-undo .
     1724   assign
     1725   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1726   define temp-table br-thbj-attr no-undo like ub.thbj-attr
     1727   field prop-code-label as character
     1728   field prop-value-label as character
     1729   .
     1730   DEFINE BUTTON b-chg
     1731        LABEL "&Изменить"
     1732        SIZE 10 BY 1.
     1733   DEFINE BUTTON B-exit AUTO-GO
     1734        LABEL "&Ввод"
     1735        SIZE 10 BY 1
     1736        BGCOLOR 8 .
     1737   DEFINE BUTTON B-Help
     1738        LABEL "Помо&щь"
     1739        SIZE 3 BY 1
     1740        BGCOLOR 8 .
     1741   DEFINE BUTTON b-quit AUTO-END-KEY
     1742        LABEL "&Отмена"
     1743        SIZE 10 BY 1
     1744        BGCOLOR 8 .
     1745   DEFINE BUTTON b-system
     1746        IMAGE-UP FILE "btn-down-arrow":U
     1747        IMAGE-DOWN FILE "btn-down-arrow":U
     1748        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1749        LABEL ""
     1750        SIZE 3 BY .88.
     1751   DEFINE VARIABLE code_system AS CHARACTER FORMAT "X(256)":U
     1752        LABEL "Код внешней системы для передачи соответствий на кассу"
     1753        VIEW-AS FILL-IN
     1754        SIZE 20 BY 1 NO-UNDO.
     1755   DEFINE VARIABLE l-amntdisc AS CHARACTER FORMAT "X(256)":U INITIAL "Тип скидки на товар на кассе"
     1756         VIEW-AS TEXT
     1757        SIZE 31.5 BY .67 NO-UNDO.
     1758   DEFINE VARIABLE l-chk-name AS CHARACTER FORMAT "X(256)":U
     1759        LABEL "задано назв. на чеке"
     1760         VIEW-AS TEXT
     1761        SIZE 24.5 BY .67
     1762        FGCOLOR 4  NO-UNDO.
     1763   DEFINE VARIABLE l-name-2cd AS CHARACTER FORMAT "X(256)":U INITIAL "Что посылать на кассу как дополн. назв. товара"
     1764         VIEW-AS TEXT
     1765        SIZE 92 BY .67 NO-UNDO.
     1766   DEFINE VARIABLE l-no-chk-name AS CHARACTER FORMAT "X(256)":U
     1767        LABEL "не задано название на чеке"
     1768         VIEW-AS TEXT
     1769        SIZE 18 BY .67
     1770        FGCOLOR 4  NO-UNDO.
     1771   DEFINE VARIABLE l-no-part AS CHARACTER FORMAT "X(256)":U
     1772        LABEL "при продаже не по партиям"
     1773         VIEW-AS TEXT
     1774        SIZE 18 BY .67
     1775        FGCOLOR 4  NO-UNDO.
     1776   DEFINE VARIABLE l-part AS CHARACTER FORMAT "X(256)":U
     1777        LABEL "при продаже по партиям"
     1778         VIEW-AS TEXT
     1779        SIZE 19 BY .67
     1780        FGCOLOR 4  NO-UNDO.
     1781   DEFINE VARIABLE t-cp-is-use-2 AS CHARACTER FORMAT "X(256)":U INITIAL "касс.платежей с атриб-м ИСПОЛЬЗУЕТСЯ"
     1782         VIEW-AS TEXT
     1783        SIZE 37.5 BY .67 NO-UNDO.
     1784   DEFINE VARIABLE RS-amntdisc AS INTEGER
     1785        VIEW-AS RADIO-SET VERTICAL
     1786        RADIO-BUTTONS
     1787             "Категорийная", 0,
     1788   "Скидка на количество - POS IBM", 1,
     1789   "Категорийная и скидка на кол-во - POS IBM spool = 6", 2,
     1790   "Скидка на количество - POS NCR", 3
     1791        SIZE 55.5 BY 3.5 NO-UNDO.
     1792   DEFINE VARIABLE RS-name-2cd AS CHARACTER INITIAL "name"
     1793        VIEW-AS RADIO-SET HORIZONTAL
     1794        RADIO-BUTTONS
     1795             "Англ. название", "name",
     1796   "Локальный код/код партии ", "code",
     1797   "Код ГТД", "GTD",
     1798   "Страна|Код ГТД", "alpha1|GTD",
     1799   "PLU кассы", "PLU"
     1800        SIZE 92.5 BY 1 NO-UNDO.
     1801   DEFINE RECTANGLE RECT-dopname
     1802        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1803        SIZE 96 BY 5.88.
     1804   DEFINE RECTANGLE RECT-name
     1805        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1806        SIZE 96 BY 4.42.
     1807   DEFINE VARIABLE t-cod-pcod AS LOGICAL INITIAL no
     1808        LABEL "Как дополн. назв. при передаче на кассу - локальный код товара или код партии"
     1809        VIEW-AS TOGGLE-BOX
     1810        SIZE 79.5 BY 1 NO-UNDO.
     1811   DEFINE VARIABLE t-cp-is-use AS LOGICAL INITIAL no
     1812        LABEL "На кассу передавать только типы касс. платежей с атрибутом ИСПОЛЬЗУЕТСЯ"
     1813        VIEW-AS TOGGLE-BOX
     1814        SIZE 37 BY 1 NO-UNDO.
     1815   DEFINE VARIABLE t-nam-2str AS LOGICAL INITIAL no
     1816        LABEL "Передача основного названия товара на кассу в две строки"
     1817        VIEW-AS TOGGLE-BOX
     1818        SIZE 83 BY 1 NO-UNDO.
     1819   DEFINE VARIABLE t-nam-artc AS LOGICAL INITIAL no
     1820        LABEL "Как основн. назв. при передаче на кассу - англ. название товара или артикул"
     1821        VIEW-AS TOGGLE-BOX
     1822        SIZE 82 BY 1 NO-UNDO.
     1823   DEFINE VARIABLE t-tax-cass AS LOGICAL INITIAL no
     1824        LABEL "Передача налогов на кассу"
     1825        VIEW-AS TOGGLE-BOX
     1826        SIZE 83 BY 1 NO-UNDO.
     1827   DEFINE QUERY br-how-disc FOR
     1828         br-thbj-attr SCROLLING.
     1829   DEFINE BROWSE br-how-disc
     1830     QUERY br-how-disc DISPLAY
     1831         br-thbj-attr.prop-code-label COLUMn-LABEL "Тип скидки" format "X(45)"
     1832   br-thbj-attr.prop-value-label COLUMn-LABEL "Способ задания" format "X(45)"
     1833       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 4.63 FIT-LAST-COLUMN.
     1834   DEFINE FRAME Dialog-Frame
     1835        B-exit AT ROW 1 COL 1
     1836        b-quit AT ROW 1 COL 11
     1837        B-Help AT ROW 1 COL 95
     1838        t-tax-cass AT ROW 2.25 COL 3.5
     1839        t-nam-2str AT ROW 3.42 COL 3.5
     1840        t-nam-artc AT ROW 4.5 COL 3.5
     1841        t-cod-pcod AT ROW 8.08 COL 3.5
     1842        RS-name-2cd AT ROW 10.08 COL 4.5 NO-LABEL
     1843        t-cp-is-use AT ROW 14 COL 61
     1844        RS-amntdisc AT ROW 14.92 COL 4 NO-LABEL
     1845        code_system AT ROW 18.5 COL 58.13 COLON-ALIGNED WIDGET-ID 10
     1846        b-system AT ROW 18.5 COL 80.75 WIDGET-ID 8
     1847        b-chg AT ROW 18.58 COL 89 WIDGET-ID 4
     1848        br-how-disc AT ROW 19.58 COL 1 WIDGET-ID 100
     1849        l-no-chk-name AT ROW 6.58 COL 29.5 COLON-ALIGNED
     1850        l-chk-name AT ROW 6.58 COL 70 COLON-ALIGNED
     1851        l-name-2cd AT ROW 9.29 COL 2 COLON-ALIGNED NO-LABEL
     1852        l-no-part AT ROW 12.58 COL 30 COLON-ALIGNED
     1853        l-part AT ROW 12.58 COL 75 COLON-ALIGNED
     1854        l-amntdisc AT ROW 13.92 COL 2.5 COLON-ALIGNED NO-LABEL
     1855        t-cp-is-use-2 AT ROW 15 COL 59 COLON-ALIGNED NO-LABEL WIDGET-ID 2
     1856        "При данных настройках на кассу как допл. назв. товара будет передано" VIEW-AS TEXT
     1857             SIZE 92 BY 1 AT ROW 11.08 COL 4.5
     1858             FGCOLOR 4
     1859        "При данных настройках на кассу как основн. назв. товара будет передано" VIEW-AS TEXT
     1860             SIZE 92 BY 1 AT ROW 5.42 COL 3.5
     1861             FGCOLOR 4
     1862        RECT-dopname AT ROW 7.92 COL 2
     1863        RECT-name AT ROW 3.25 COL 2
     1864        SPACE(1.24) SKIP(16.57)
     1865       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1866            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1867            TITLE "Опции передачи данных на кассу"
     1868            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1869   ASSIGN
     1870          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1871          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1872   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1873   DO:
     1874     APPLY "END-ERROR":U TO SELF.
     1875   END.
     1876   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1877   DO:
     1878   define variable v-attr-codes as character no-undo.
     1879   define variable v-attr-labels as character no-undo.
     1880   define variable v-sel-codes as character no-undo.
     1881   define variable v-role-discnt as character no-undo.
     1882   define variable v-rec as recid no-undo.
     1883   define buffer buf_br-thbj-attr for br-thbj-attr.
     1884   if not available br-thbj-attr then do:
     1885     return no-apply.
     1886   end.
     1887   assign
     1888   v-role-discnt = replace(br-thbj-attr.prop-code, "how-", "").
     1889   assign
     1890   v-attr-codes = v-role-discnt + chr(4) +
     1891                  v-role-discnt + "-pdf".
     1892   assign
     1893   v-attr-labels = entry (lookup (v-role-discnt, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) + chr(4) + entry (lookup ((v-role-discnt + "-pdf"), 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     1894   run gbl/d-list.w ( input "b-sel"
     1895                     ,input "Выберите способ задания скидки на товар"
     1896                     ,input v-attr-codes
     1897                     ,input v-attr-labels
     1898                     ,input chr(4)
     1899                     ,input br-thbj-attr.property-value-character
     1900                     ,output v-sel-codes) no-error.
     1901   if error-status:error
     1902   or v-sel-codes = ''
     1903   then do:
     1904     return no-apply.
     1905   end.
     1906   if v-sel-codes <> br-thbj-attr.property-value-character then do:
     1907     v-rec = recid(br-thbj-attr).
     1908     find first buf_br-thbj-attr where
     1909             recid(buf_br-thbj-attr) = recid(br-thbj-attr).
     1910     assign
     1911     buf_br-thbj-attr.property-value-character = v-sel-codes.
     1912     if index(buf_br-thbj-attr.property-value-character, "-pdf") > 0 then do:
     1913           buf_br-thbj-attr.prop-value-label = entry (lookup (buf_br-thbj-attr.property-value-character, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     1914     end.
     1915     else do:
     1916           buf_br-thbj-attr.prop-value-label = entry (lookup (buf_br-thbj-attr.property-value-character, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1917     end.
     1918     OPEN QUERY br-how-disc FOR EACH br-thbj-attr where br-thbj-attr.prop-code begins "how".
     1919     reposition br-how-disc to recid v-rec no-error.
     1920   end.
     1921   END.
     1922   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1923   DO:
     1924     run proc-save IN THIS-PROCEDURE NO-ERROR.
     1925     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1926   END.
     1927   ON CHOOSE OF b-system IN FRAME Dialog-Frame
     1928   DO:
     1929       define variable v-ii as integer no-undo .
     1930       run bge/oxmlexts.p (
     1931         input parparentproc,
     1932         input 1,
     1933         input substitute("esys-type > &1", '0':U),
     1934         input "",
     1935         output v-rid-list,
     1936         output v-ok).
     1937       if v-rid-list = "" or v-ok <> true then message "Не была выбрана внешняя система." view-as alert-box.
     1938       if v-ok = true then
     1939       do:
     1940         code_system = "" .
     1941         do v-ii = 1 to num-entries(v-rid-list):
     1942           run gen-row-keyr in this-procedure
     1943             ( input entry(v-ii, v-rid-list)
     1944             ,input ?
     1945             ,input "ub"
     1946             ,input ?
     1947             ,input no-lock
     1948             ,output v-tbl-row
     1949             ,output v-tbl-name
     1950             ).
     1951           find first buf_ext-system no-lock where
     1952             rowid(buf_ext-system) = v-tbl-row.
     1953         code_system = code_system + "," + entry(2,string(entry(v-ii, v-rid-list)),chr(3)) .
     1954         end.
     1955       end.
     1956       else
     1957       do:
     1958         undo, return no-apply .
     1959       end.
     1960       code_system = trim(code_system,",") .
     1961       code_system:screen-value =  code_system no-error.
     1962     end.
