     1991   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1992   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1993   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1994   on help of frame Dialog-Frame
     1995   do:
     1996     run gbl/app_help.p
     1997       (input this-procedure :file-name
     1998       ,input ''
     1999       ,input ?
     2000       ) no-error.
     2001     if error-status :error then do:
     2002       message
     2003         "Ошибка при вызове помощи"
     2004         error-status :get-message(1)
     2005         view-as alert-box .
     2006     end.
     2007   end.
     2008   run minbtn-set in this-procedure .
     2009   on choose of b-help in frame Dialog-Frame
     2010   do:
     2011     apply "help":u to frame Dialog-Frame .
     2012   end.
     2013   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2014   procedure minbtn-set :
     2015       do
     2016           on error undo, return error return-value
     2017           :
     2018           define variable ii              as integer       no-undo .
     2019           define variable fh              as widget-handle no-undo .
     2020           define variable hh              as widget-handle no-undo .
     2021           define variable v-h             as handle        extent 4 no-undo .
     2022           define variable v-name-button   as character     no-undo .
     2023           define variable v-help-old-x    as decimal       no-undo .
     2024           define variable v-help-old-y    as decimal       no-undo .
     2025           define variable v-help-old-size as decimal       no-undo .
     2026           define variable v-frame-width   as decimal       no-undo .
     2027           define variable jj              as integer       no-undo .
     2028           do
     2029               on error undo, return error
     2030               :
     2031               assign
     2032                   v-frame-width = frame Dialog-Frame:width - 0.3
     2033                   fh            = frame Dialog-Frame:first-child
     2034                   hh            = fh:first-child
     2035                   ii            = 1
     2036                   .
     2037               do while valid-handle(hh):
     2038                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2039                   do:
     2040                       case lc(hh:name) :
     2041                           when "b-help" then
     2042                               do:
     2043                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2044                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2045                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2046                                   hh:TOOLTIP = "Помощь" .
     2047                                   v-help-old-x = hh:column .
     2048                                   v-help-old-y = hh:row    .
     2049                                   v-help-old-size = hh:width .
     2050                                   hh:width-chars = 2.5 .
     2051                               end.
     2052                           when "b-print" then
     2053                               do:
     2054                                   hh:load-image("cmp/b-print.bmp":u) .
     2055                                   hh:TOOLTIP = "Печать" .
     2056                                   v-h[ii] = hh:handle .
     2057                                   ii = ii + 1 .
     2058                                   hh:width-chars = 3 .
     2059                               end.
     2060                           when "b-history" or
     2061                           when "b-hist" then
     2062                               do:
     2063                                   hh:load-image("cmp/b-hist.bmp":u) .
     2064                                   hh:TOOLTIP = "История" .
     2065                                   v-h[ii] = hh:handle .
     2066                                   ii = ii + 1 .
     2067                                   hh:width-chars = 3 .
     2068                               end.
     2069                           when "b-sch" then
     2070                               do:
     2071                                   hh:load-image("cmp/b-sch.bmp":u) .
     2072                                   hh:TOOLTIP = "Установка Фильтра" .
     2073                                   v-h[ii] = hh:handle .
     2074                                   ii = ii + 1 .
     2075                                   hh:width-chars = 3 .
     2076                               end.
     2077                           when "b-hist-user" then
     2078                               do:
     2079                                   hh:load-image("cmp/b-hist.bmp":u) .
     2080                                   hh:TOOLTIP = "История пользователя" .
     2081                                   ii = ii + 1 .
     2082                               end.
     2083                       end case.
     2084                   end.
     2085                   hh = hh:next-sibling.
     2086               end.
     2087               b-help:column = v-frame-width - b-help:width-chars.
     2088               jj = 0.
     2089               repeat ii = 4 to 1 by -1 :
     2090                   if valid-handle (v-h[ii] ) then
     2091                   do:
     2092                       jj  = jj + 1 .
     2093                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2094                       v-h[ii]:row    = v-help-old-y .
     2095                   end.
     2096               end.
     2097           end.
     2098       end.
     2099   end procedure.
     2100   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2101   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2102   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2103   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2104   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2105   define variable v-diasize-current-frame-height as decimal   no-undo .
     2106   define variable v-diasize-change-size          as logical   no-undo .
     2107   define variable v-diasize-resize-button        as handle    no-undo .
     2108   define variable v-diasize-wndmax               as logical   no-undo .
     2109   define variable v-diasize-wndstore             as logical   no-undo .
     2110   define variable v-diasize-proc-name            as character no-undo .
     2111   define variable v-diasize-browse-handle        as handle    no-undo .
     2112   define variable v-diasize-browse-number        as integer   no-undo .
     2113   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2114   define temp-table temp-diasize-handle no-undo
     2115     field handle-value  as handle
     2116     field save-position as decimal
     2117     index xpk is primary unique handle-value
     2118     .
     2119   define temp-table temp-browse-handle no-undo
     2120     field browse-type   as character
     2121     field browse-number as integer
     2122     field browse-handle as handle
     2123     field original-size as decimal
     2124     index xpk is primary unique browse-type browse-number
     2125     index xie browse-type browse-handle
     2126   .
     2127   procedure diasize_change-height :
     2128     define input  parameter p-change-value  as decimal   no-undo .
     2129     define input  parameter p-move-resize   as logical   no-undo .
     2130     define variable v-field-group-handle    as handle    no-undo .
     2131     define variable v-object-handle         as handle    no-undo .
     2132     define variable v-frame-height          as decimal   no-undo .
     2133     define variable v-frame-virtual-height  as decimal   no-undo .
     2134     define variable v-browse-height         as decimal   no-undo .
     2135     define variable v-window-height         as decimal   no-undo .
     2136     define variable v-window-virtual-height as decimal   no-undo .
     2137     define variable v-change-sign           as integer   no-undo .
     2138     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2139     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2140     if p-change-value > 0
     2141     then do:
     2142       if frame Dialog-Frame :height + p-change-value
     2143           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2144       then do:
     2145         assign
     2146           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2147                           - (frame Dialog-Frame :height-chars)
     2148         .
     2149         if p-change-value <= 0
     2150         then do:
     2151           run diasize_position-resize-button in this-procedure .
     2152           return .
     2153         end.
     2154       end.
     2155     end.
     2156     if p-change-value < 0
     2157     then do:
     2158       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2159       then do:
     2160         assign
     2161           p-change-value = v-diasize-orig-frame-height
     2162                          - (frame Dialog-Frame :height-chars)
     2163         .
     2164         if p-change-value >= 0
     2165         then do:
     2166           run diasize_position-resize-button in this-procedure .
     2167           return .
     2168         end.
     2169       end.
     2170     end.
     2171     if p-change-value >= 0
     2172     then do:
     2173       assign
     2174         v-change-sign = 1
     2175       .
     2176     end.
     2177     else do:
     2178       assign
     2179         v-change-sign = -1
     2180       .
     2181     end.
     2182     assign
     2183       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2184     .
     2185     if p-change-value = 0
     2186     then do:
     2187       run diasize_position-resize-button in this-procedure .
     2188       return .
     2189     end.
     2190     move_block:
     2191     do
     2192     on error undo move_block, retry move_block
     2193     :
     2194       if retry
     2195       then do:
     2196         do
     2197         on error undo move_block, leave move_block
     2198         :
     2199           if p-change-value > 0
     2200           then do:
     2201             for each buf_temp-diasize-handle
     2202             on error undo, next
     2203             :
     2204               assign
     2205                 v-object-handle = buf_temp-diasize-handle.handle-value
     2206               .
     2207               if v-object-handle <> v-diasize-resize-button
     2208               then do:
     2209                 assign
     2210                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2211                 .
     2212               end.
     2213             end.
     2214             assign
     2215               v-diasize-browse-handle :height = v-browse-height
     2216             .
     2217             for each buf_temp-browse-handle
     2218               where buf_temp-browse-handle.browse-type = 'height':u
     2219             on error undo, next
     2220             :
     2221               assign
     2222                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2223               .
     2224             end.
     2225             assign
     2226               frame Dialog-Frame :height = v-frame-height
     2227             .
     2228             if frame Dialog-Frame :scrollable = true
     2229             then do:
     2230               assign
     2231                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2232               .
     2233             end.
     2234             run diasize_position-resize-button in this-procedure .
     2235           end.
     2236           else do:
     2237             if frame Dialog-Frame :scrollable = true
     2238             then do:
     2239               assign
     2240                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2241               .
     2242             end.
     2243             assign
     2244               frame Dialog-Frame :height = v-frame-height
     2245             .
     2246             assign
     2247               v-diasize-browse-handle :height = v-browse-height
     2248             .
     2249             for each buf_temp-browse-handle
     2250               where buf_temp-browse-handle.browse-type = 'height':u
     2251             on error undo, next
     2252             :
     2253               assign
     2254                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2255               .
     2256             end.
     2257             for each buf_temp-diasize-handle
     2258             on error undo, next
     2259             :
     2260               assign
     2261                 v-object-handle = buf_temp-diasize-handle.handle-value
     2262               .
     2263               if v-object-handle <> v-diasize-resize-button
     2264               then do:
     2265                 assign
     2266                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2267                 .
     2268               end.
     2269             end.
     2270             run diasize_position-resize-button in this-procedure .
     2271           end.
     2272           assign
     2273             v-diasize-change-size = false
     2274           .
     2275           leave move_block .
     2276         end.
     2277       end.
     2278       assign
     2279         v-diasize-need-full-display = true
     2280       .
     2281       if v-diasize-change-size = false
     2282       then do:
     2283         assign
     2284           v-diasize-change-size = true
     2285         .
     2286       end.
     2287       else do:
     2288         return .
     2289       end.
     2290       assign
     2291         v-frame-height = frame Dialog-Frame :height
     2292         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2293         v-browse-height = v-diasize-browse-handle :height
     2294       .
     2295       for each buf_temp-browse-handle
     2296         where buf_temp-browse-handle.browse-type = 'height':u
     2297       :
     2298         assign
     2299           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2300         .
     2301       end.
     2302       for each buf_temp-diasize-handle
     2303       :
     2304         delete buf_temp-diasize-handle .
     2305       end.
     2306       assign
     2307         v-field-group-handle = frame Dialog-Frame :first-child
     2308       .
     2309       do while valid-handle(v-field-group-handle)
     2310       :
     2311         assign
     2312           v-object-handle = v-field-group-handle :first-child
     2313         .
     2314         do while valid-handle(v-object-handle)
     2315         :
     2316           if  v-object-handle <> v-diasize-browse-handle :handle
     2317           and can-query(v-object-handle, "row")
     2318           and can-query(v-object-handle, "height")
     2319           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2320           then do:
     2321             find first buf_temp-browse-handle
     2322               where buf_temp-browse-handle.browse-type   = 'height':u
     2323                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2324               no-error .
     2325             if available buf_temp-browse-handle
     2326             then do:
     2327             end.
     2328             else do:
     2329               create buf_temp-diasize-handle .
     2330               assign
     2331                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2332                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2333               .
     2334             end.
     2335           end.
     2336           assign
     2337             v-object-handle = v-object-handle :next-sibling
     2338           .
     2339         end.
     2340         assign
     2341           v-field-group-handle = v-field-group-handle :next-sibling
     2342         .
     2343       end.
     2344       do with frame Dialog-Frame
     2345       :
     2346         hide v-diasize-resize-button .
     2347         assign
     2348           v-diasize-resize-button :row    = 1
     2349           v-diasize-resize-button :column = 1
     2350         .
     2351       end.
     2352       if p-change-value > 0
     2353       then do:
     2354         if frame Dialog-Frame :scrollable = true
     2355         then do:
     2356           assign
     2357             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2358             no-error .
     2359           if error-status :error
     2360           or error-status :get-message(1) <> ""
     2361           then do:
     2362             undo move_block, retry move_block .
     2363           end.
     2364         end.
     2365         assign
     2366           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2367           no-error .
     2368         if error-status :error
     2369         or error-status :get-message(1) <> ""
     2370         then do:
     2371           undo move_block, retry move_block .
     2372         end.
     2373         assign
     2374           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2375           no-error .
     2376         if error-status :error
     2377         or error-status :get-message(1) <> ""
     2378         then do:
     2379           undo move_block, retry move_block .
     2380         end.
     2381         for each buf_temp-browse-handle
     2382           where buf_temp-browse-handle.browse-type = 'height':u
     2383         on error undo move_block, retry move_block
     2384         :
     2385           assign
     2386             buf_temp-browse-handle.browse-handle :height
     2387               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2388             no-error .
     2389           if error-status :error
     2390           or error-status :get-message(1) <> ""
     2391           then do:
     2392             undo move_block, retry move_block .
     2393           end.
     2394         end.
     2395         for each buf_temp-diasize-handle
     2396         on error undo move_block, retry move_block
     2397         :
     2398           assign
     2399             v-object-handle = buf_temp-diasize-handle.handle-value
     2400           .
     2401           if v-object-handle <> v-diasize-resize-button
     2402           then do:
     2403             assign
     2404               v-object-handle :row = v-object-handle :row + p-change-value
     2405               no-error .
     2406             if error-status :error
     2407             or error-status :get-message(1) <> ""
     2408             then do:
     2409               undo move_block, retry move_block .
     2410             end.
     2411           end.
     2412         end.
     2413       end.
     2414       else do:
     2415         for each buf_temp-diasize-handle
     2416         on error undo move_block, retry move_block
     2417         :
     2418           assign
     2419             v-object-handle = buf_temp-diasize-handle.handle-value
     2420           .
     2421           if v-object-handle <> v-diasize-resize-button
     2422           then do:
     2423             assign
     2424               v-object-handle :row = v-object-handle :row + p-change-value
     2425               no-error .
     2426             if error-status :error
     2427             or error-status :get-message(1) <> ""
     2428             then do:
     2429               undo move_block, retry move_block .
     2430             end.
     2431           end.
     2432         end.
     2433         assign
     2434           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2435           no-error .
     2436         if error-status :error
     2437         or error-status :get-message(1) <> ""
     2438         then do:
     2439           undo move_block, retry move_block .
     2440         end.
     2441         for each buf_temp-browse-handle
     2442           where buf_temp-browse-handle.browse-type = 'height':u
     2443         on error undo move_block, retry move_block
     2444         :
     2445           assign
     2446             buf_temp-browse-handle.browse-handle :height
     2447               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2448             no-error .
     2449           if error-status :error
     2450           or error-status :get-message(1) <> ""
     2451           then do:
     2452             undo move_block, retry move_block .
     2453           end.
     2454         end.
     2455         assign
     2456           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2457           no-error .
     2458         if error-status :error
     2459         or error-status :get-message(1) <> ""
     2460         then do:
     2461           undo move_block, retry move_block .
     2462         end.
     2463         if frame Dialog-Frame :scrollable = true
     2464         then do:
     2465           assign
     2466             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2467             no-error .
     2468           if error-status :error
     2469           or error-status :get-message(1) <> ""
     2470           then do:
     2471             undo move_block, retry move_block .
     2472           end.
     2473         end.
     2474       end.
     2475       if p-move-resize = true
     2476       then do:
     2477         run diasize_position-resize-button in this-procedure .
     2478       end.
     2479       if v-diasize-wndstore = true
     2480       then do:
     2481         if connected("ub") = true
     2482         then do:
     2483           define variable v-cntxt-db-num        as integer   no-undo .
     2484           define variable v-cntxt-userid        as character no-undo .
     2485           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2486                                             , OUTPUT v-cntxt-userid
     2487                                             ) .
     2488           run gbl/wndsizew.p
     2489             (input  v-cntxt-db-num
     2490             ,input  v-cntxt-userid
     2491             ,input  v-diasize-proc-name
     2492             ,input  'height':u
     2493             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2494             ) .
     2495         end.
     2496       end.
     2497     end.
     2498     assign
     2499       v-diasize-change-size = false
     2500     .
     2501   end procedure.
     2502   procedure diasize_set-height :
     2503     define input  parameter p-new-height  as decimal   no-undo .
     2504     define input  parameter p-move-resize as logical   no-undo .
     2505     do
     2506     on error undo, return error return-value
     2507     :
     2508       run diasize_change-height in this-procedure
     2509         (input  (p-new-height - frame Dialog-Frame :height)
     2510         ,input  p-move-resize
     2511         ) .
     2512     end.
     2513   end procedure.
     2514   procedure diasize_change-width :
     2515     define input  parameter p-change-value as decimal   no-undo .
     2516     define input  parameter p-move-resize  as logical   no-undo .
     2517     define variable v-field-group-handle   as handle    no-undo .
     2518     define variable v-object-handle        as handle    no-undo .
     2519     define variable v-frame-width          as decimal   no-undo .
     2520     define variable v-frame-virtual-width  as decimal   no-undo .
     2521     define variable v-browse-width         as decimal   no-undo .
     2522     define variable v-window-width         as decimal   no-undo .
     2523     define variable v-window-virtual-width as decimal   no-undo .
     2524     define variable v-change-sign          as integer   no-undo .
     2525     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2526     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2527     if p-change-value > 0
     2528     then do:
     2529       if frame Dialog-Frame :width + p-change-value >
     2530           session :width-chars
     2531       then do:
     2532         assign
     2533           p-change-value = session :width-chars - frame Dialog-Frame :width
     2534         .
     2535         if p-change-value <= 0
     2536         then do:
     2537           run diasize_position-resize-button in this-procedure .
     2538           return .
     2539         end.
     2540       end.
     2541     end.
     2542     if p-change-value < 0
     2543     then do:
     2544       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2545       then do:
     2546         assign
     2547           p-change-value = v-diasize-orig-frame-width
     2548                          - frame Dialog-Frame :width
     2549         .
     2550         if p-change-value >= 0
     2551         then do:
     2552           run diasize_position-resize-button in this-procedure .
     2553           return .
     2554         end.
     2555       end.
     2556     end.
     2557     if p-change-value >= 0
     2558     then do:
     2559       assign
     2560         v-change-sign = 1
     2561       .
     2562     end.
     2563     else do:
     2564       assign
     2565         v-change-sign = -1
     2566       .
     2567     end.
     2568     assign
     2569       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2570     .
     2571     if p-change-value = 0
     2572     then do:
     2573       run diasize_position-resize-button in this-procedure .
     2574       return .
     2575     end.
     2576     move_block:
     2577     do
     2578     on error undo move_block, leave move_block
     2579     :
     2580       if retry
     2581       then do:
     2582         do
     2583         on error undo move_block, leave move_block
     2584         :
     2585           if p-change-value > 0
     2586           then do:
     2587             for each buf_temp-diasize-handle
     2588             on error undo, next
     2589             :
     2590               assign
     2591                 v-object-handle = buf_temp-diasize-handle.handle-value
     2592               .
     2593               if v-object-handle <> v-diasize-resize-button
     2594               then do:
     2595                 assign
     2596                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2597                 .
     2598               end.
     2599             end.
     2600             assign
     2601               v-diasize-browse-handle :width = v-browse-width
     2602             .
     2603             for each buf_temp-browse-handle
     2604               where buf_temp-browse-handle.browse-type = 'width':u
     2605             on error undo, next
     2606             :
     2607               assign
     2608                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2609               .
     2610             end.
     2611             assign
     2612               frame Dialog-Frame :width = v-frame-width
     2613             .
     2614             if frame Dialog-Frame :scrollable = true
     2615             then do:
     2616               assign
     2617                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2618               .
     2619             end.
     2620             run diasize_position-resize-button in this-procedure .
     2621           end.
     2622           else do:
     2623             if frame Dialog-Frame :scrollable = true
     2624             then do:
     2625               assign
     2626                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2627               .
     2628             end.
     2629             assign
     2630               frame Dialog-Frame :width = v-frame-width
     2631             .
     2632             for each buf_temp-browse-handle
     2633               where buf_temp-browse-handle.browse-type = 'width':u
     2634             on error undo, next
     2635             :
     2636               assign
     2637                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2638               .
     2639             end.
     2640             assign
     2641               v-diasize-browse-handle :width = v-browse-width
     2642             .
     2643             for each buf_temp-diasize-handle
     2644             on error undo, next
     2645             :
     2646               assign
     2647                 v-object-handle = buf_temp-diasize-handle.handle-value
     2648               .
     2649               if v-object-handle <> v-diasize-resize-button
     2650               then do:
     2651                 assign
     2652                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2653                 .
     2654               end.
     2655             end.
     2656             run diasize_position-resize-button in this-procedure .
     2657           end.
     2658           assign
     2659             v-diasize-change-size = false
     2660           .
     2661           leave move_block .
     2662         end.
     2663       end.
     2664       assign
     2665         v-diasize-need-full-display = true
     2666       .
     2667       if v-diasize-change-size = false
     2668       then do:
     2669         assign
     2670           v-diasize-change-size = true
     2671         .
     2672       end.
     2673       else do:
     2674         return .
     2675       end.
     2676       assign
     2677         v-frame-width = frame Dialog-Frame :width
     2678         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2679         v-browse-width = v-diasize-browse-handle :width
     2680       .
     2681       for each buf_temp-browse-handle
     2682         where buf_temp-browse-handle.browse-type = 'width':u
     2683       :
     2684         assign
     2685           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2686         .
     2687       end.
     2688       for each buf_temp-diasize-handle
     2689       :
     2690         delete buf_temp-diasize-handle .
     2691       end.
     2692       assign
     2693         v-field-group-handle = frame Dialog-Frame :first-child
     2694       .
     2695       do while valid-handle(v-field-group-handle)
     2696       :
     2697         assign
     2698           v-object-handle = v-field-group-handle :first-child
     2699         .
     2700         do while valid-handle(v-object-handle)
     2701         :
     2702           if  v-object-handle <> v-diasize-browse-handle :handle
     2703           and v-object-handle <> v-diasize-resize-button
     2704           and can-query(v-object-handle, "row")
     2705           and can-query(v-object-handle, "height")
     2706           and ( v-object-handle :col + v-object-handle :width
     2707                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2708               )
     2709           then do:
     2710             find first buf_temp-browse-handle
     2711               where buf_temp-browse-handle.browse-type   = 'width':u
     2712                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2713               no-error .
     2714             if available buf_temp-browse-handle
     2715             then do:
     2716             end.
     2717             else do:
     2718               create buf_temp-diasize-handle .
     2719               assign
     2720                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2721                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2722               .
     2723             end.
     2724           end.
     2725           assign
     2726             v-object-handle = v-object-handle :next-sibling
     2727           .
     2728         end.
     2729         assign
     2730           v-field-group-handle = v-field-group-handle :next-sibling
     2731         .
     2732       end.
     2733       do with frame Dialog-Frame
     2734       :
     2735         hide v-diasize-resize-button .
     2736         v-diasize-resize-button :row = 1.
     2737         v-diasize-resize-button :column = 1.
     2738       end.
     2739       if p-change-value > 0
     2740       then do:
     2741         if frame Dialog-Frame :scrollable = true
     2742         then do:
     2743           assign
     2744             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2745             no-error .
     2746           if error-status :error
     2747           or error-status :get-message(1) <> ""
     2748           then do:
     2749             undo move_block, retry move_block.
     2750           end.
     2751         end.
     2752         assign
     2753           frame Dialog-Frame :width = v-frame-width + p-change-value
     2754           no-error .
     2755         if error-status :error
     2756         or error-status :get-message(1) <> ""
     2757         then do:
     2758           undo move_block, retry move_block.
     2759         end.
     2760         assign
     2761           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2762         no-error .
     2763         if error-status :error
     2764         or error-status :get-message(1) <> ""
     2765         then do:
     2766           undo move_block, retry move_block.
     2767         end.
     2768         for each buf_temp-browse-handle
     2769           where buf_temp-browse-handle.browse-type = 'width':u
     2770         on error undo move_block, retry move_block
     2771         :
     2772           assign
     2773             buf_temp-browse-handle.browse-handle :width
     2774               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2775             no-error .
     2776           if error-status :error
     2777           or error-status :get-message(1) <> ""
     2778           then do:
     2779             undo move_block, retry move_block .
     2780           end.
     2781         end.
     2782         for each buf_temp-diasize-handle
     2783         on error undo move_block, retry move_block
     2784         :
     2785           assign
     2786             v-object-handle = buf_temp-diasize-handle.handle-value
     2787           .
     2788           if v-object-handle <> v-diasize-resize-button
     2789           then do:
     2790             assign
     2791               v-object-handle :col = v-object-handle :col + p-change-value
     2792               no-error .
     2793             if error-status :error
     2794             or error-status :get-message(1) <> ""
     2795             then do:
     2796               undo move_block, retry move_block .
     2797             end.
     2798           end.
     2799         end.
     2800       end.
     2801       else do:
     2802         for each buf_temp-diasize-handle
     2803         on error undo move_block, retry move_block
     2804         :
     2805           assign
     2806             v-object-handle = buf_temp-diasize-handle.handle-value
     2807           .
     2808           if v-object-handle <> v-diasize-resize-button
     2809           then do:
     2810             assign
     2811               v-object-handle :col = v-object-handle :col + p-change-value
     2812               no-error .
     2813             if error-status :error
     2814             or error-status :get-message(1) <> ""
     2815             then do:
     2816               undo move_block, retry move_block .
     2817             end.
     2818           end.
     2819         end.
     2820         for each buf_temp-browse-handle
     2821           where buf_temp-browse-handle.browse-type = 'width':u
     2822         on error undo move_block, retry move_block
     2823         :
     2824           assign
     2825             buf_temp-browse-handle.browse-handle :width
     2826               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2827             no-error .
     2828           if error-status :error
     2829           or error-status :get-message(1) <> ""
     2830           then do:
     2831             undo move_block, retry move_block .
     2832           end.
     2833         end.
     2834         assign
     2835           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2836           no-error .
     2837         if error-status :error
     2838         or error-status :get-message(1) <> ""
     2839         then do:
     2840           undo move_block, retry move_block.
     2841         end.
     2842         assign
     2843           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2844         no-error .
     2845         if error-status :error
     2846         or error-status :get-message(1) <> ""
     2847         then do:
     2848           undo move_block, retry move_block.
     2849         end.
     2850         if frame Dialog-Frame :scrollable = true
     2851         then do:
     2852           assign
     2853             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2854           no-error .
     2855           if error-status :error
     2856           or error-status :get-message(1) <> ""
     2857           then do:
     2858             undo move_block, retry move_block.
     2859           end.
     2860         end.
     2861       end.
     2862       if p-move-resize
     2863       then do:
     2864         run diasize_position-resize-button in this-procedure .
     2865       end.
     2866       if v-diasize-wndstore = true
     2867       then do:
     2868         if connected("ub") = true
     2869         then do:
     2870           define variable v-cntxt-db-num        as integer   no-undo .
     2871           define variable v-cntxt-userid        as character no-undo .
     2872           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2873                                             , OUTPUT v-cntxt-userid
     2874                                             ) .
     2875           run gbl/wndsizew.p
     2876             (input  v-cntxt-db-num
     2877             ,input  v-cntxt-userid
     2878             ,input  v-diasize-proc-name
     2879             ,input  'width':u
     2880             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2881             ) .
     2882         end.
     2883       end.
     2884     end.
     2885     assign
     2886       v-diasize-change-size = false
     2887     .
     2888   end procedure.
     2889   procedure diasize_set-width :
     2890     define input  parameter p-new-width  as decimal   no-undo .
     2891     define input  parameter p-move-resize as logical   no-undo .
     2892     do
     2893     on error undo, return error return-value
     2894     :
     2895       run diasize_change-width in this-procedure
     2896         (input  (p-new-width - frame Dialog-Frame :width)
     2897         ,input  p-move-resize
     2898         ) .
     2899     end.
     2900   end procedure.
     2901   procedure diasize_position-resize-button :
     2902     do with frame Dialog-Frame
     2903     :
     2904       hide v-diasize-resize-button .
     2905       assign
     2906         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2907                     - 1
     2908                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2909         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2910                     - 1
     2911                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2912       .
     2913       view v-diasize-resize-button .
     2914     end.
     2915   end procedure.
     2916   on alt-right anywhere
     2917   do:
     2918     run diasize_change-width in this-procedure
     2919       (input 1
     2920       ,input true
     2921       ) .
     2922     return no-apply .
     2923   end.
     2924   on alt-left anywhere
     2925   do:
     2926     run diasize_change-width in this-procedure
     2927       (input -1
     2928       ,input true
     2929       ) .
     2930     return no-apply .
     2931   end.
     2932   on alt-down anywhere
     2933   do:
     2934     run diasize_change-height in this-procedure
     2935       (input 1
     2936       ,input true
     2937       ) .
     2938     return no-apply .
     2939   end.
     2940   on alt-up anywhere
     2941   do:
     2942     run diasize_change-height in this-procedure
     2943       (input -1
     2944       ,input true
     2945       ) .
     2946     return no-apply .
     2947   end.
     2948   on alt-enter of frame Dialog-Frame
     2949   do:
     2950     run diasize_maximize in this-procedure
     2951       (input  ?
     2952       ).
     2953     return no-apply .
     2954   end.
     2955   procedure diasize_end-move :
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       define variable v-row-delta as decimal   no-undo .
     2960       define variable v-col-delta as decimal   no-undo .
     2961       define variable v-new-row as decimal   no-undo .
     2962       define variable v-new-col as decimal   no-undo .
     2963       assign
     2964         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2965         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2966       .
     2967       assign
     2968         v-row-delta = v-new-row - frame Dialog-Frame :height
     2969         v-col-delta = v-new-col - frame Dialog-Frame :width
     2970       .
     2971       run diasize_change-height in this-procedure
     2972         (input v-row-delta
     2973         ,input true
     2974         ) .
     2975       run diasize_change-width in this-procedure
     2976         (input v-col-delta
     2977         ,input true
     2978         ) .
     2979     end.
     2980   end procedure.
     2981   procedure diasize_maximize :
     2982     define input  parameter p-action as logical   no-undo .
     2983     do
     2984     on error undo, return error return-value
     2985     :
     2986       if p-action = ?
     2987       then do:
     2988         if v-diasize-need-maximize = true
     2989         then do:
     2990           assign
     2991             p-action = true
     2992           .
     2993         end.
     2994         else do:
     2995           assign
     2996             p-action = false
     2997           .
     2998         end.
     2999       end.
     3000       if p-action = true
     3001       then do:
     3002         run diasize_change-height in this-procedure
     3003           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3004               - frame Dialog-Frame :height-chars
     3005           ,input true
     3006           ) .
     3007         run diasize_change-width in this-procedure
     3008           (input session :width-chars
     3009               - frame Dialog-Frame :width-chars
     3010           ,input true
     3011           ) .
     3012         assign
     3013           v-diasize-need-maximize = false
     3014         .
     3015       end.
     3016       else do:
     3017         run diasize_change-width in this-procedure
     3018           (input v-diasize-orig-frame-width
     3019               - frame Dialog-Frame :width-chars
     3020           ,input true
     3021           ) .
     3022         run diasize_change-height in this-procedure
     3023           (input v-diasize-orig-frame-height
     3024               - frame Dialog-Frame :height-chars
     3025           ,input true
     3026           ) .
     3027         assign
     3028           v-diasize-need-maximize = true
     3029         .
     3030       end.
     3031     end.
     3032   end procedure.
     3033   procedure diasize_restore-orig-size :
     3034     do
     3035     on error undo, return error return-value
     3036     :
     3037       assign
     3038         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3039         v-diasize-current-frame-height = frame Dialog-Frame :height
     3040       .
     3041       run diasize_set-height in this-procedure
     3042         (input  v-diasize-orig-frame-height
     3043         ,input  true
     3044         ) .
     3045       run diasize_set-width in this-procedure
     3046         (input  v-diasize-orig-frame-width
     3047         ,input  true
     3048         ) .
     3049     end.
     3050   end procedure.
     3051   procedure diasize_restore-current-size :
     3052     do
     3053     on error undo, return error return-value
     3054     :
     3055       run diasize_set-height in this-procedure
     3056         (input  v-diasize-current-frame-height
     3057         ,input  true
     3058         ) .
     3059       run diasize_set-width in this-procedure
     3060         (input  v-diasize-current-frame-width
     3061         ,input  true
     3062         ) .
     3063     end.
     3064   end procedure.
     3065   procedure diasize_set-browse-handle :
     3066     define input  parameter p-browse-handle as handle   no-undo .
     3067     define buffer buf_temp-browse-handle for temp-browse-handle .
     3068     do
     3069     on error undo, return error return-value
     3070     :
     3071       assign
     3072         v-diasize-browse-handle = p-browse-handle
     3073       .
     3074       for each buf_temp-browse-handle
     3075       on error undo, return error return-value
     3076       :
     3077         delete buf_temp-browse-handle .
     3078       end.
     3079     end.
     3080   end procedure.
     3081   procedure diasize_add_browse :
     3082     define input  parameter p-browse-type   as character no-undo .
     3083     define input  parameter p-browse-handle as handle    no-undo .
     3084     define buffer buf_temp-browse-handle for temp-browse-handle .
     3085     do
     3086     on error undo, return error return-value
     3087     :
     3088       assign
     3089         v-diasize-browse-number = v-diasize-browse-number + 1
     3090       .
     3091       create buf_temp-browse-handle .
     3092       assign
     3093         buf_temp-browse-handle.browse-type   = p-browse-type
     3094         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3095         buf_temp-browse-handle.browse-handle = p-browse-handle
     3096       .
     3097     end.
     3098   end procedure.
     3099   procedure diasize_init :
     3100     define variable v-default-value    as logical   no-undo .
     3101     define variable v-restore-saved    as logical   no-undo .
     3102     define variable v-resize-value-str as character no-undo .
     3103     do
     3104     on error undo, return error return-value
     3105     :
     3106       do with frame Dialog-Frame
     3107       :
     3108         assign
     3109           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3110           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3111           v-diasize-browse-handle     = browse br-how-disc :handle
     3112         .
     3113         create button v-diasize-resize-button
     3114         assign
     3115           parent        = frame Dialog-Frame :first-child
     3116           label         = "s"
     3117           height-pixels = 16
     3118           width-pixels  = 16
     3119           visible       = true
     3120           sensitive     = true
     3121           movable       = true
     3122           triggers:
     3123             on end-move persistent run diasize_end-move in this-procedure .
     3124           end triggers.
     3125         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3126         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3127         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3128         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3129         assign
     3130           v-diasize-wndmax = false
     3131         .
     3132         if connected("ub") = true
     3133         then do:
     3134           define variable v-cntxt-db-num        as integer   no-undo .
     3135           define variable v-cntxt-userid        as character no-undo .
     3136           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3137                                             , OUTPUT v-cntxt-userid
     3138                                             ) .
     3139           run gbl/wndpar_r.p
     3140             (input  v-cntxt-db-num
     3141             ,input  v-cntxt-userid
     3142             ,input  'wndmax':U
     3143             ,output v-diasize-wndmax
     3144             ,output v-default-value
     3145             ) .
     3146         end.
     3147         assign
     3148           v-diasize-wndstore = false
     3149         .
     3150         if connected("ub") = true
     3151         then do:
     3152           run gbl/wndpar_r.p
     3153             (input  v-cntxt-db-num
     3154             ,input  v-cntxt-userid
     3155             ,input  'wndstore':U
     3156             ,output v-diasize-wndstore
     3157             ,output v-default-value
     3158             ) .
     3159         end.
     3160         assign
     3161           v-diasize-proc-name = entry(1, program-name(2), '.')
     3162         .
     3163         if v-diasize-wndstore = true
     3164         then do:
     3165           assign
     3166             v-restore-saved = false
     3167           .
     3168           if connected("ub") = true
     3169           then do:
     3170             run gbl/wndsizer.p
     3171               (input  v-cntxt-db-num
     3172               ,input  v-cntxt-userid
     3173               ,input  v-diasize-proc-name
     3174               ,input  'height':u
     3175               ,output v-resize-value-str
     3176               ) .
     3177             if v-resize-value-str <> '':U
     3178             then do:
     3179               run diasize_change-height in this-procedure
     3180                 (input  integer(v-resize-value-str)
     3181                 ,input  true
     3182                 ) .
     3183               assign
     3184                 v-restore-saved = true
     3185               .
     3186             end.
     3187           end.
     3188           if connected("ub") = true
     3189           then do:
     3190             run gbl/wndsizer.p
     3191               (input  v-cntxt-db-num
     3192               ,input  v-cntxt-userid
     3193               ,input  v-diasize-proc-name
     3194               ,input  'width':u
     3195               ,output v-resize-value-str
     3196               ) .
     3197             if v-resize-value-str <> '':U
     3198             then do:
     3199               run diasize_change-width in this-procedure
     3200                 (input  integer(v-resize-value-str)
     3201                 ,input  true
     3202                 ) .
     3203               assign
     3204                 v-restore-saved = true
     3205               .
     3206             end.
     3207           end.
     3208           if v-restore-saved <> true
     3209           then do:
     3210             if v-diasize-wndmax = true
     3211             then do:
     3212               run diasize_maximize in this-procedure
     3213                 (input  true
     3214                 ) .
     3215             end.
     3216           end.
     3217         end.
     3218         else do:
     3219           if v-diasize-wndmax = true
     3220           then do:
     3221             run diasize_maximize in this-procedure
     3222               (input  true
     3223               ) .
     3224           end.
     3225         end.
     3226       end.
     3227     end.
     3228   end procedure.
     3229   procedure diasize_need-full-display :
     3230     define output parameter p-need-full-display as logical   no-undo .
     3231     do
     3232     on error undo, return error return-value
     3233     :
     3234       assign
     3235         p-need-full-display = v-diasize-need-full-display
     3236       .
     3237       assign
     3238         v-diasize-need-full-display = false
     3239       .
     3240     end.
     3241   end procedure.
     3242   procedure get-context :
     3243      define output parameter p-db-num as integer          no-undo.
     3244      define output parameter p-user-id as character        no-undo.
     3245      define variable v-login               as character    no-undo.
     3246      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3247      define buffer buf_user-login  for ub.user-login .
     3248      do
     3249      on error undo, return error
     3250      :
     3251            FIND FIRST buf_sys-ctrl no-lock.
     3252            ASSIGN
     3253               v-login = USERID("ub")
     3254               p-db-num = buf_sys-ctrl.db-num
     3255            .
     3256            FIND FIRST buf_user-login
     3257                 WHERE buf_user-login.db-num = p-db-num
     3258                   AND buf_user-login.user-login = v-login
     3259                 no-lock
     3260                 no-error
     3261                 .
     3262            IF AVAILABLE buf_user-login
     3263            THEN DO:
     3264               assign
     3265                  p-user-id = buf_user-login.user-id
     3266               .
     3267            END.
     3268      end.
     3269   end procedure.
     3270       run diasize_init in this-procedure .
     3271   MAIN-BLOCK:
     3272   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3273      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3274   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3275     run mainmenu_getcntxt in parparentproc
     3276       (output v-cntxt-db-num
     3277       ,output v-cntxt-userid
     3278       ,output v-cntxt-level
     3279       ,output v-cntxt-host-code-obj
     3280       ,output v-cntxt-obj-type
     3281       ,output v-cntxt-obj-code
     3282       ,output v-cntxt-db-num-obj
     3283       ,output v-cntxt-is-admin
     3284       ) .
     3285   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3286   ON TAB ANYWHERE
     3287   DO:
     3288   define variable ii as integer no-undo .
     3289   define variable fh as widget-handle no-undo .
     3290   define variable hh as widget-handle no-undo .
     3291   define variable v-next-widget-name as character no-undo .
     3292   if v-tab-order <> '' then do:
     3293     if self:type = "TOGGLE-BOX" then
     3294     self:BGCOLOR = ?.
     3295     assign
     3296     ii = lookup(self:name, v-tab-order).
     3297     assign
     3298     ii = ii + 1
     3299     v-next-widget-name = entry(ii, v-tab-order)
     3300     no-error .
     3301     if error-status:error then do:
     3302       assign
     3303       ii = 1
     3304       v-next-widget-name = entry( ii, v-tab-order)
     3305       .
     3306     end.
     3307     assign
     3308     fh = frame Dialog-Frame:first-child
     3309     hh = fh:first-child
     3310     .
     3311     do while valid-handle(hh):
     3312       if hh:name = v-next-widget-name then do:
     3313         if hh:sensitive  = yes
     3314         AND hh:visible = yes then do:
     3315           if hh:type = "TOGGLE-BOX":U then do:
     3316             assign
     3317             hh:BGcolor = 1
     3318             .
     3319           end.
     3320           APPLY "ENTRY" to hh.
     3321           return no-apply.
     3322         end.
     3323         else do:
     3324           APPLY "TAB" to hh.
     3325           return no-apply.
     3326         end.
     3327       end.
     3328       hh = hh:next-sibling.
     3329     end.
     3330   end.
     3331   END.
     3332   ON BACK-TAB ANYWHERE
     3333   DO:
     3334   define variable ii as integer no-undo .
     3335   define variable fh as widget-handle no-undo .
     3336   define variable hh as widget-handle no-undo .
     3337   define variable v-next-widget-name as character no-undo .
     3338   if v-tab-order <> '' then do:
     3339     assign
     3340     ii = lookup(self:name, v-tab-order).
     3341     .
     3342     assign
     3343     ii = (if ii = 1
     3344           then  num-entries(v-tab-order)
     3345           else ii - 1
     3346           )
     3347     v-next-widget-name = entry(ii, v-tab-order)
     3348     .
     3349     assign
     3350     fh = frame Dialog-Frame:first-child
     3351     hh = fh:first-child
     3352     .
     3353     do while valid-handle(hh):
     3354       if hh:name = v-next-widget-name then do:
     3355         if hh:sensitive  = yes
     3356         AND hh:visible = yes then do:
     3357           if hh:type = "TOGGLE-BOX":U then do:
     3358             assign
     3359             hh:BGcolor = 1
     3360             .
     3361           end.
     3362           APPLY "ENTRY" to hh.
     3363           return no-apply.
     3364         end.
     3365         else do:
     3366         APPLY "BACK-TAB" to hh.
     3367         return no-apply.
     3368         end.
     3369       end.
     3370       hh = hh:next-sibling.
     3371     end.
     3372     end.
     3373   END.
     3374   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3375   ON RETURN ANYWHERE
     3376   DO:
     3377   define variable ii as integer no-undo .
     3378   define variable fh as widget-handle no-undo .
     3379   define variable hh as widget-handle no-undo .
     3380   define variable v-next-widget-name as character no-undo .
     3381     if v-tab-order <> '' then do:
     3382       assign
     3383       ii = lookup(self:name, v-tab-order).
     3384       if ii = num-entries(v-tab-order) then do:
     3385           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3386           return no-apply.
     3387       end.
     3388       if self:type <> "BUTTON" and
     3389         self:type <> "EDITOR"  then do:
     3390         run proc-move-forward in this-procedure .
     3391         return no-apply.
     3392       end.
     3393       if self:type = "BUTTON" then do:
     3394         APPLY "CHOOSE" to self.
     3395       end.
     3396       if self:type = "TOGGLE-BOX" then
     3397       self:BGCOLOR = ?.
     3398       assign
     3399       ii = ii + 1
     3400       v-next-widget-name = entry(ii, v-tab-order)
     3401       no-error .
     3402       if error-status:error then do:
     3403         assign
     3404         ii = 1
     3405         v-next-widget-name = entry( ii, v-tab-order)
     3406         .
     3407       end.
     3408       assign
     3409       fh = frame Dialog-Frame:first-child
     3410       hh = fh:first-child
     3411       .
     3412       do while valid-handle(hh):
     3413         if hh:name = v-next-widget-name then do:
     3414           if hh:sensitive  = yes
     3415           AND hh:visible = yes then do:
     3416             if hh:type = "TOGGLE-BOX":U then do:
     3417               assign
     3418               hh:BGcolor = 1
     3419               .
     3420             end.
     3421             APPLY "ENTRY" to hh.
     3422             return no-apply.
     3423           end.
     3424           else do:
     3425             APPLY "TAB" to hh.
     3426             return no-apply.
     3427           end.
     3428         end.
     3429         hh = hh:next-sibling.
     3430       end.
     3431     end.
     3432   END.
     3433   procedure proc-move-forward :
     3434   define variable ii as integer no-undo .
     3435   define variable fh as widget-handle no-undo .
     3436   define variable hh as widget-handle no-undo .
     3437   define variable v-next-widget-name as character no-undo .
     3438   do
     3439   on error undo, return error
     3440   :
     3441     if v-tab-order <> '' then do:
     3442       if self:type = "TOGGLE-BOX" then
     3443       self:BGCOLOR = ?.
     3444       assign
     3445       ii = lookup(self:name, v-tab-order).
     3446       assign
     3447       ii = ii + 1
     3448       v-next-widget-name = entry(ii, v-tab-order)
     3449       no-error .
     3450       if error-status:error then do:
     3451         assign
     3452         ii = 1
     3453         v-next-widget-name = entry( ii, v-tab-order)
     3454         .
     3455       end.
     3456       assign
     3457       fh = frame Dialog-Frame:first-child
     3458       hh = fh:first-child
     3459       .
     3460       do while valid-handle(hh):
     3461         if hh:name = v-next-widget-name then do:
     3462           if hh:sensitive  = yes
     3463           AND hh:visible = yes then do:
     3464             if hh:type = "TOGGLE-BOX":U then do:
     3465               assign
     3466               hh:BGcolor = 1
     3467               .
     3468             end.
     3469             APPLY "ENTRY" to hh.
     3470             return.
     3471           end.
     3472           else do:
     3473             assign
     3474             ii = ii + 1
     3475             v-next-widget-name = entry(ii, v-tab-order)
     3476             no-error .
     3477             if error-status:error then do:
     3478               assign
     3479               ii = 1
     3480               v-next-widget-name = entry( ii, v-tab-order)
     3481               .
     3482             end.
     3483           end.
     3484         end.
     3485         hh = hh:next-sibling.
     3486       end.
     3487     end.
     3488   end.
     3489   end procedure.
     3490     IF p-mode <> 'ПРОСМОТР':U
     3491     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3492         MESSAGE
     3493         vss-workfile vss-revision vss-description skip
     3494         "Неверное значение параметра p-mode" p-mode
     3495         VIEW-AS ALERT-BOX ERROR.
     3496         UNDO, RETURN ERROR.
     3497     END.
     3498     IF p-obj-type <> 'маг':U
     3499     and p-obj-type <> 'орг':U
     3500     and p-obj-type <> '':U
     3501     THEN DO:
     3502         MESSAGE
     3503         vss-workfile vss-revision vss-description skip
     3504         "Неверное значение параметра p-obj-type" p-obj-type
     3505         VIEW-AS ALERT-BOX ERROR.
     3506         UNDO, RETURN ERROR.
     3507     END.
     3508     if p-obj-type = 'маг':U then do:
     3509       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     3510       IF NOT AVAILABLE X_shop THEN DO:
     3511           MESSAGE
     3512           vss-workfile vss-revision vss-description skip
     3513           "Неверное значение параметра p-obj-code" p-obj-code
     3514           VIEW-AS ALERT-BOX ERROR.
     3515           UNDO, RETURN ERROR.
     3516       END.
     3517   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3519     (input  'маг':U
     3520     ,input  p-obj-code
     3521     ,output v-db-num
     3522     )  .
     3523       IF v-db-num <> v-cntxt-db-num
     3524       AND v-cntxt-db-num <> 0
     3525       and p-mode <> 'ПРОСМОТР':U
     3526       THEN DO:
     3527           MESSAGE
     3528           "Нельзя менять параметры магазина в чужой БД" skip
     3529           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3530           VIEW-AS ALERT-BOX ERROR.
     3531           UNDO, RETURN ERROR.
     3532       END.
     3533     end.
     3534     if p-obj-type = 'орг':U then do:
     3535       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     3536       IF NOT AVAILABLE X_sysconf THEN DO:
     3537           MESSAGE
     3538           vss-workfile vss-revision vss-description skip
     3539           "Неверное значение параметра p-obj-code" p-obj-code
     3540           VIEW-AS ALERT-BOX ERROR.
     3541           UNDO, RETURN ERROR.
     3542       END.
     3543       if v-cntxt-db-num <> 0
     3544       and p-mode <> 'ПРОСМОТР':U
     3545       then do:
     3546           MESSAGE
     3547           "Нельзя менять параметры ФИРМЫ в УБД" skip
     3548           VIEW-AS ALERT-BOX ERROR.
     3549           UNDO, RETURN ERROR.
     3550       end.
     3551     end.
     3552     if p-obj-type = '':U then do:
     3553       if v-cntxt-db-num <> 0
     3554       and p-mode <> 'ПРОСМОТР':U
     3555       then do:
     3556           MESSAGE
     3557           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3558           VIEW-AS ALERT-BOX ERROR.
     3559           UNDO, RETURN ERROR.
     3560       end.
     3561     end.
     3562     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3563       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3564                 LOCKED_thbj-attr.obj-type = p-obj-type
     3565           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3566           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-inf-send':U
     3567           AND   Locked_thbj-attr.prop-code = '':U
     3568           NO-WAIT NO-ERROR.
     3569        if locked locked_thbj-attr then do:
     3570           message
     3571           vss-workfile vss-revision vss-description skip
     3572            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3573           view-as alert-box error .
     3574           undo, return error.
     3575         end.
     3576     END.
     3577     ELSE DO:
     3578         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3579             LOCKED_thbj-attr.obj-type = p-obj-type
     3580       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3581       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-inf-send':U
     3582       AND   locked_thbj-attr.prop-code = '':U
     3583       NO-ERROR.
     3584     END.
     3585     if not available locked_thbj-attr then do:
     3586       ASSIGN
     3587       v-to-create  = YES.
     3588       message
     3589       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3590                   chr(10))
     3591       view-as alert-box WARNING.
     3592     end.
     3593     run FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3594     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3595     RUN Myenable in this-procedure .
     3596     WAIT-FOR GO OF FRAME Dialog-Frame.
     3597   END.
     3598   run disable_UI in this-procedure .
     3599   PROCEDURE disable_UI :
     3600     HIDE FRAME Dialog-Frame.
     3601   END PROCEDURE.
     3602   PROCEDURE enable_UI :
     3603     DISPLAY t-tax-cass t-nam-2str t-nam-artc t-cod-pcod RS-name-2cd t-cp-is-use
     3604             RS-amntdisc code_system l-no-chk-name l-chk-name l-name-2cd l-no-part
     3605             l-part l-amntdisc t-cp-is-use-2
     3606         WITH FRAME Dialog-Frame.
     3607     ENABLE B-exit b-quit B-Help RECT-dopname RECT-name t-tax-cass t-nam-2str
     3608            t-nam-artc t-cod-pcod RS-name-2cd t-cp-is-use RS-amntdisc code_system
     3609            b-system b-chg br-how-disc l-no-chk-name l-chk-name l-name-2cd
     3610            l-no-part l-part l-amntdisc
     3611         WITH FRAME Dialog-Frame.
     3612     VIEW FRAME Dialog-Frame.
     3613     OPEN QUERY br-how-disc FOR EACH br-thbj-attr where br-thbj-attr.prop-code begins "how".
     3614   END PROCEDURE.
     3615   PROCEDURE fill-widgets :
     3616   define variable v-tooltip          as character no-undo .
     3617   define variable v-label          as character no-undo .
     3618   define variable v-tooltip-code          as character no-undo .
     3619   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3620   define variable v-value-character as character no-undo .
     3621   define variable v-value-date as date no-undo .
     3622   define variable v-value-decimal as decimal no-undo .
     3623   define variable v-value-integer as INTEGER no-undo .
     3624   define variable v-value-logical AS LOGICAL no-undo .
     3625   define variable v-param-type as character no-undo .
     3626   FOR EACH thbjattr_thbj-attr:
     3627     delete thbjattr_thbj-attr.
     3628   end.
     3629   FOR EACH temp-thbj-attr:
     3630     delete temp-thbj-attr.
     3631   end.
     3632   run adm/shattri.p
     3633     (input "init":U
     3634     ,input p-obj-type
     3635     ,input p-obj-code
     3636     ,input 'cd-inf-send':U
     3637     ,input "":U
     3638     ,output v-value-character
     3639     ,output v-value-date
     3640     ,output v-value-decimal
     3641     ,output v-value-integer
     3642     ,output v-value-logical
     3643     ,output v-param-type
     3644     ,INPUT-OUTPUT TABLE-handle v-tth
     3645     )no-error .
     3646   if error-status:error
     3647   and not available locked_thbj-attr then do:
     3648     message
     3649     "Не удалось получить начальные значения настроек" skip
     3650     error-status:get-message(1) return-value
     3651     view-as alert-box error .
     3652     undo, return error .
     3653   end.
     3654   for each thbjattr_thbj-attr:
     3655     ASSIGN
     3656     v-entry = thbjattr_thbj-attr.prop-code.
     3657     IF v-entry = 'amntdisc':U THEN DO:
     3658       ASSIGN
     3659       RS-amntdisc = thbjattr_thbj-attr.property-value-INTEGER
     3660       rs-amntdisc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3661       .
     3662     END.
     3663       IF v-entry = 'code-system':U THEN
     3664       DO:
     3665         ASSIGN
     3666           code_system                                     = thbjattr_thbj-attr.property-value-character
     3667           code_system:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3668           .
     3669       END.
     3670     IF v-entry = 'cod-pcod':U THEN DO:
     3671       ASSIGN
     3672       t-cod-pcod = thbjattr_thbj-attr.property-value-logical
     3673       t-cod-pcod:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3674       .
     3675     END.
     3676     IF v-entry = 'nam-2str':U THEN DO:
     3677       ASSIGN
     3678       t-nam-2str = thbjattr_thbj-attr.property-value-logical
     3679       t-nam-2str:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3680       .
     3681     END.
     3682     IF v-entry = 'nam-artc':U THEN DO:
     3683       ASSIGN
     3684       t-nam-artc = thbjattr_thbj-attr.property-value-logical
     3685       t-nam-artc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3686       .
     3687     END.
     3688     IF v-entry = 'tax-cass':U THEN DO:
     3689       ASSIGN
     3690       t-tax-cass = thbjattr_thbj-attr.property-value-logical
     3691       t-tax-cass:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3692       .
     3693     END.
     3694     IF v-entry = 'name-2cd':U THEN DO:
     3695       ASSIGN
     3696       RS-name-2cd = thbjattr_thbj-attr.property-value-character
     3697       rs-name-2cd:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3698       .
     3699     END.
     3700     IF v-entry = 'cp-is-use':U THEN DO:
     3701       ASSIGN
     3702       t-cp-is-use = thbjattr_thbj-attr.property-value-logical
     3703       t-cp-is-use:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3704       .
     3705     END.
     3706     if v-entry begins "how-" then do:
     3707       create br-thbj-attr.
     3708       buffer-copy thbjattr_thbj-attr to br-thbj-attr.
     3709       run thbjattr_tooltip in this-procedure (
     3710                                             input  'cd-inf-send':U
     3711                                            ,input  thbjattr_thbj-attr.prop-code
     3712                                            ,output v-tooltip
     3713                                            ,output br-thbj-attr.prop-code-label
     3714                                            ,output v-tooltip-code).
     3715       br-thbj-attr.prop-code-label = (if num-entries(br-thbj-attr.prop-code-label, ":") > 1
     3716                                       then entry(2, br-thbj-attr.prop-code-label, ":")
     3717                                       else br-thbj-attr.prop-code-label).
     3718       if index(br-thbj-attr.property-value-character, "-pdf") > 0 then do:
     3719               br-thbj-attr.prop-value-label = entry (lookup (br-thbj-attr.property-value-character, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     3720       end.
     3721       else do:
     3722               br-thbj-attr.prop-value-label = entry (lookup (br-thbj-attr.property-value-character, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     3723       end.
     3724     end.
     3725     create temp-thbj-attr.
     3726     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3727   END.
     3728   END PROCEDURE.
     3729   PROCEDURE MyEnable :
     3730   define variable dflt-cd as character no-undo .
     3731   define variable conf-attr as character no-undo .
     3732   define variable conf-par as character no-undo .
     3733   define variable par-type as character no-undo .
     3734   define variable v-value-character as character no-undo .
     3735   define variable v-value-date as date no-undo .
     3736   define variable v-value-decimal as decimal no-undo .
     3737   define variable v-value-integer as INTEGER no-undo .
     3738   define variable v-value-logical AS LOGICAL no-undo .
     3739   if p-obj-type = 'маг':U
     3740   then do:
     3741     run adm/shattri.p
     3742       (input "get":u
     3743       ,input p-obj-type
     3744       ,input p-obj-code
     3745       ,input  'cd-sending':u
     3746       ,input  "dflt-cd":u
     3747       ,output v-value-character
     3748       ,output v-value-date
     3749       ,output v-value-decimal
     3750       ,output v-value-integer
     3751       ,output v-value-logical
     3752       ,output par-type
     3753       ,input-output TABLE-handle v-tth
     3754       ) no-error .
     3755     if not error-status:error
     3756     then do:
     3757       assign
     3758         dflt-cd = conf-par
     3759       .
     3760     end.
     3761   end.
     3762   ASSIGN
     3763   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     3764   v-tab-order = "t-tax-cass,t-nam-2str,t-nam-artc,t-cod-pcod,RS-name-2cd,RS-amntdisc,t-cp-is-use,f-sum-id-output".
     3765   l-name-2cd-init = l-name-2cd.
     3766   DISPLAY
     3767   t-tax-cass
     3768   t-nam-2str
     3769   t-nam-artc
     3770   t-cod-pcod
     3771   RS-name-2cd
     3772   RS-amntdisc
     3773   l-name-2cd
     3774   l-amntdisc
     3775   t-cp-is-use
     3776   t-cp-is-use-2
     3777   b-system
     3778       code_system
     3779   WITH FRAME Dialog-Frame.
     3780   ENABLE
     3781   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3782   b-quit
     3783   B-Help
     3784   b-system
     3785       WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3786       code_system
     3787       WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3788   t-tax-cass WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3789   t-nam-2str WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3790   t-nam-artc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3791   t-cod-pcod WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3792   RS-name-2cd WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3793   RS-amntdisc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3794   t-cp-is-use WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3795   br-how-disc
     3796   b-chg WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3797   WITH FRAME Dialog-Frame.
     3798   OPEN QUERY br-how-disc FOR EACH br-thbj-attr where br-thbj-attr.prop-code begins "how".
     3799   VIEW FRAME Dialog-Frame.
     3800   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3801       HIDE
     3802       b-exit
     3803       IN FRAME Dialog-Frame.
     3804       ASSIGN
     3805       b-quit:LABEL = "&Выход"
     3806       b-quit:col = 1
     3807       .
     3808   END.
     3809   APPLY "VALUE-CHANGED" TO t-nam-2str.
     3810   APPLY "VALUE-CHANGED" TO t-cod-pcod.
     3811   END PROCEDURE.
     3812   PROCEDURE proc-save :
     3813   define variable v-value-character as character no-undo .
     3814   define variable v-value-date as date no-undo .
     3815   define variable v-value-decimal as decimal no-undo .
     3816   define variable v-value-integer as INTEGER no-undo .
     3817   define variable v-value-logical AS LOGICAL no-undo .
     3818   define variable v-param-type as character no-undo .
     3819   define variable wh as widget-handle no-undo .
     3820   define variable fh as widget-handle no-undo .
     3821   define variable v-same as logical no-undo .
     3822   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3823   ASSIGN
     3824   FRAME Dialog-Frame
     3825   t-tax-cass
     3826   t-nam-2str
     3827   t-nam-artc
     3828   t-cod-pcod
     3829   RS-name-2cd
     3830   RS-amntdisc
     3831   t-cp-is-use
     3832   code_system
     3833   .
     3834   assign
     3835   fh = frame Dialog-Frame:first-child
     3836   wh = fh:first-child
     3837   .
     3838   for each thbjattr_thbj-attr where
     3839           thbjattr_thbj-attr.upper-prop-code <> 'cd-inf-send':U:
     3840     delete thbjattr_thbj-attr.
     3841   end.
     3842   for each thbjattr_thbj-attr where
     3843           thbjattr_thbj-attr.prop-code begins "how-",
     3844      first br-thbj-attr where
     3845           br-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3846     assign
     3847     thbjattr_thbj-attr.property-value-character = br-thbj-attr.property-value-character.
     3848   end.
     3849   do while valid-handle(wh):
     3850     if wh:private-data begins "recid=" then do:
     3851       find first thbjattr_thbj-attr where
     3852                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     3853       assign
     3854       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3855     end.
     3856     wh = wh:next-sibling.
     3857   end.
     3858   release thbjattr_thbj-attr.
     3859   v-same = yes.
     3860   for each thbjattr_thbj-attr,
     3861       first temp-thbj-attr where
     3862             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3863         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3864         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3865         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3866      buffer-compare
     3867      thbjattr_thbj-attr
     3868      to temp-thbj-attr
     3869      save result in v-same.
     3870      if not v-same then leave.
     3871   end.
     3872   v-same = no.
     3873   IF v-same  and not v-to-create THEN RETURN.
     3874   run adm/shattri.p (
     3875                 input "check":U
     3876               , input p-obj-type
     3877               , input p-obj-code
     3878               , input 'cd-inf-send':U
     3879               , INPUT '':U
     3880                , output v-value-character
     3881                , output v-value-date
     3882                , output v-value-decimal
     3883                , output v-value-integer
     3884                , output v-value-logical
     3885                , output v-param-type
     3886                , input-output TABLE-handle v-tth
     3887                ) no-error .
     3888   if error-status:error then do:
     3889     message
     3890     "Некорректное значение ПАРАМЕТРОВ" skip
     3891     error-status:get-message(1) skip
     3892     return-value
     3893     view-as alert-box error .
     3894     undo, return error .
     3895   end.
     3896   do TRANSACTION
     3897   on error undo, return error return-value
     3898   :
     3899     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3900          input p-obj-type
     3901         ,input p-obj-code
     3902         ,input 'cd-inf-send':U
     3903         ,INPUT table thbjattr_thbj-attr
     3904     ) NO-ERROR.
     3905     IF ERROR-STATUS:error THEN do:
     3906       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3907       RETURN-VALUE
     3908       VIEW-AS ALERT-BOX.
     3909       UNDO, RETURN ERROR.
     3910     END.
     3911   end.
     3912   END PROCEDURE.
     3913   PROCEDURE view-results-name :
     3914   DEFINE INPUT PARAMETER p-nam-artc AS LOGICAL NO-UNDO.
     3915   DEFINE INPUT PARAMETER p-nam-2str AS LOGICAL NO-UNDO.
     3916   l-no-chk-name = IF p-nam-artc
     3917                             then "Артикул"
     3918                             else "Название товара"
     3919                   .
     3920    l-name-2cd = l-name-2cd-init + (IF p-nam-2str THEN (chr(32) + "(На POS IBM посылаться не будет!!!)") ELSE "":U).
     3921   l-chk-name = IF p-nam-artc
     3922                              then "Артикул"
     3923                else "Название товара НА ЧЕКЕ".
     3924   DISPLAY
     3925   l-no-chk-name
     3926   l-name-2cd
     3927   l-chk-name
     3928   WITH FRAME Dialog-Frame.
     3929   END PROCEDURE.
     3930   PROCEDURE view-results-name2 :
     3931   DEFINE INPUT PARAMETER p-cod-pcod AS LOGICAL NO-UNDO.
     3932   DEFINE INPUT PARAMETER p-name-2cd AS CHARACTER NO-UNDO.
     3933   DEFINE VARIABLE v-gtd AS CHARACTER NO-UNDO.
     3934   l-no-part = name-2cdf(
     3935                         input p-name-2cd
     3936                       , input NO
     3937                       , input p-cod-pcod
     3938                       , input 0
     3939                       , input 0
     3940                       , input "":U
     3941                       , input "":U
     3942                       , input "":U
     3943                       , input "":U
     3944                       , input "":U
     3945                       , input 0
     3946                       , input '':U
     3947                       , output v-gtd
     3948                       ).
     3949   l-part = name-2cdf(
     3950                           input p-name-2cd
     3951                       , input NO
     3952                       , input p-cod-pcod
     3953                       , input 0
     3954                       , input 0
     3955                       , input "":U
     3956                       , input "":U
     3957                       , input "":U
     3958                       , input "XXX":U
     3959                       , input "":U
     3960                       , input 0
     3961                       , input '':U
     3962                       , output v-gtd
     3963                       ).
     3964   DISPLAY
     3965   l-no-part
     3966   l-part
     3967   WITH FRAME Dialog-Frame.
     3968   END PROCEDURE.
