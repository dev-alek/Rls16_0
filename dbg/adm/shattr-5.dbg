      615   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   procedure gdcstcod_cst-code :
      617     define input  parameter p-obj-type  as character no-undo .
      618     define input  parameter p-obj-code  as integer   no-undo .
      619     define input  parameter p-gds-code  as integer   no-undo .
      620     define input  parameter p-in-code   as character no-undo .
      621     define input  parameter p-part-code as character no-undo .
      622     define output parameter p-cst-code  as character no-undo .
      623     define buffer buf_goods for ub.goods .
      624     define buffer buf_parts for ub.parts .
      625     do
      626     on error undo, return error return-value
      627     :
      628       assign
      629         p-cst-code = ''
      630       .
      631       find first buf_goods no-lock
      632         where buf_goods.gds-code = p-gds-code
      633         no-error .
      634       if not available buf_goods
      635       then do:
      636         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
      637       end.
      638       if p-in-code = ?
      639       then do:
      640         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
      641       end.
      642       if p-part-code = ?
      643       then do:
      644         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
      645       end.
      646       if p-in-code = '':u
      647       then do:
      648         find first buf_parts no-lock
      649           where buf_parts.obj-type  = p-obj-type
      650             and buf_parts.obj-code  = p-obj-code
      651             and buf_parts.artic     = buf_goods.artic
      652             and buf_parts.prod-type = buf_goods.prod-type
      653             and buf_parts.prod-code = buf_goods.prod-code
      654             and buf_parts.out-code  = 'free-zone':U
      655             and buf_parts.status_   = false
      656           no-error .
      657         if available buf_parts
      658         then do:
      659           assign
      660             p-cst-code = buf_parts.cst-code
      661           .
      662         end.
      663       end.
      664       else do:
      665         find first buf_parts no-lock
      666           where buf_parts.obj-type  = p-obj-type
      667             and buf_parts.obj-code  = p-obj-code
      668             and buf_parts.artic     = buf_goods.artic
      669             and buf_parts.prod-type = buf_goods.prod-type
      670             and buf_parts.prod-code = buf_goods.prod-code
      671             and buf_parts.out-code  = 'free-zone':U
      672             and buf_parts.in-code   = p-in-code
      673             and buf_parts.part-code = p-part-code
      674           no-error .
      675         if available buf_parts
      676         then do:
      677           assign
      678             p-cst-code = buf_parts.cst-code
      679           .
      680         end.
      681       end.
      682     end.
      683   end procedure.
      684   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      685   FUNCTION name-2cdf returns character
      686                      (  input p-name-2cd as character
      687                       , input p-mode as logical
      688                       , input p-cod-pcod as logical
      689                       , input p-b-code  as integer
      690                       , input p-gds-code as integer
      691                       , input p-artic   as character
      692                       , input p-engl-name  as character
      693                       , input p-in-code as character
      694                       , input p-part-code as character
      695                       , input p-obj-type as character
      696                       , input p-obj-code as integer
      697                       , input p-alpha1 as character
      698                       , output p-gtd as character
      699                       ) :
      700   define variable v-name-2cd as character no-undo .
      701   define variable v-dop-alt-name as character no-undo.
      702   define variable v-type as character no-undo.
      703   define buffer buf_parts for ub.parts.
      704   define buffer buf_code for ub.code.
      705   if not p-mode and p-name-2cd = "PLU":U then do:
      706     return "PLU кассы":U.
      707   end.
      708   if not p-mode then do:
      709     if p-name-2cd <> "GTD":U
      710     and  p-name-2cd <> "alpha1|gtd":U
      711     then do:
      712     assign
      713     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
      714   end.
      715   end.
      716   if p-part-code = "":U or p-cod-pcod = no then do:
      717     run gdsoattr-value in this-procedure (
      718       'dt-seasons':U,
      719       p-gds-code,
      720       p-obj-type,
      721       p-obj-code,
      722       output v-dop-alt-name,
      723       output v-type
      724     ) no-error.
      725     if v-dop-alt-name <> "" then do:
      726       find first buf_code where
      727                  buf_code.parent = "DTSeasons"
      728              and buf_code.code   = v-dop-alt-name
      729            no-lock no-error.
      730       if available buf_code then
      731         assign
      732           p-engl-name = ""
      733           v-dop-alt-name =  buf_code.misc1
      734         .
      735     end.
      736     else do:
      737       run gdsoattr-value in this-procedure
      738                           ( input  'dop-alt-name-o':U
      739                            ,input  p-gds-code
      740                            ,input  p-obj-type
      741                            ,input  p-obj-code
      742                            ,output v-dop-alt-name
      743                            ,output v-type
      744                           ) no-error .
      745     end.
      746     CASE p-name-2cd:
      747       when "name" then do:
      748         if p-mode then return p-engl-name + v-dop-alt-name.
      749         return "Англ. название".
      750       end.
      751       when "code":U then do:
      752         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
      753         return "Лок. код товара"  .
      754       end.
      755       when "GTD":U
      756       or
      757       when "name-GTD":U
      758       or
      759       when "code-GTD":U
      760       or
      761       when "alpha1|gtd":U
      762       or
      763       when "name-alpha1|gtd":U
      764       or
      765       when "code-alpha1|gtd":U
      766       then do:
      767         if p-mode then do:
      768           run gdcstcod_cst-code  in this-procedure (
      769                                                       input  p-obj-type
      770                                                       ,input  p-obj-code
      771                                                       ,input  p-gds-code
      772                                                       ,input  p-in-code
      773                                                       ,input  p-part-code
      774                                                       ,output p-gtd
      775                                                       ) no-error .
      776         end.
      777         if p-name-2cd = "name-gtd":U then do:
      778           if p-mode then return p-engl-name  + v-dop-alt-name.
      779           return "Англ. название".
      780         end.
      781         if p-name-2cd = "name-alpha1|gtd":U then do:
      782           if p-mode then return p-engl-name  + v-dop-alt-name.
      783           return "Англ. название".
      784         end.
      785         if p-name-2cd = "code-GTD":U then do:
      786           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
      787           return "Лок. код товара"  .
      788         end.
      789         if p-name-2cd = "code-alpha1|gtd":U then do:
      790           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
      791           return "Лок. код товара"  .
      792         end.
      793         if p-mode then do:
      794           if p-name-2cd = "GTD" then  return p-gtd.
      795           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
      796         end.
      797         if p-name-2cd = "GTD" then  return "Код ГТД".
      798         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
      799       end.
      800     END CASE.
      801   end.
      802   else do:
      803     if p-name-2cd = "name-gtd":U
      804     or p-name-2cd = "code-GTD":U
      805     or p-name-2cd = "name-alpha1|GTD":U
      806     or p-name-2cd = "code-alpha1|GTD":U
      807     or p-name-2cd = "alpha1|GTD":U
      808     then do:
      809       if p-mode then do:
      810         run gdcstcod_cst-code  in this-procedure (
      811                                                      input  p-obj-type
      812                                                     ,input  p-obj-code
      813                                                     ,input  p-gds-code
      814                                                     ,input  p-in-code
      815                                                     ,input  p-part-code
      816                                                     ,output p-gtd
      817                                                     ) no-error .
      818       end.
      819       else do:
      820         if p-name-2cd = "gtd":U then
      821         p-gtd = "Код ГТД".
      822         if p-name-2cd = "alpha1|Gtd":U then
      823         p-gtd = "Страна|Код ГТД".
      824       end.
      825     end.
      826     if p-mode then  return p-part-code.
      827     return "Код партии".
      828   end.
      829   END FUNCTION.
      830   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
      831                                            ,input p-nam-2str as logical
      832                                            ,input p-nam-artc as logical
      833                                            ,input p-unit-cli-type as character
      834                                            ,input p-unit-base as character
      835                                            ,input p-unit-cli as character
      836                                            ,input p-cli-base-rate as decimal
      837                                            ,input p-artic as character
      838                                            ,input p-f-name as character
      839                                            ,input p-gds-name as character
      840                                            ,input p-gds-name1 as character
      841                                            ,output p-second-name as character):
      842   define variable v-length as integer no-undo .
      843   define variable nam-2str-shift as integer no-undo .
      844   define variable chk_name as character no-undo .
      845   assign
      846   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
      847   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
      848   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
      849               then 5
      850               else v-length)
      851   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
      852   nam-2str-shift = (if p-nam-2str then v-length else 0)
      853   .
      854   if p-nam-artc then do:
      855     assign
      856     chk_name = substitute("&1 &2", p-artic, p-f-name)
      857       .
      858   end.
      859   else  do:
      860     assign
      861     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
      862     .
      863   end.
      864   if p-unit-base <> p-unit-cli then do:
      865     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
      866     assign
      867     chk_name = string(substr(chk_name
      868                               ,1
      869                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
      870                       "*":U +
      871                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
      872   end.
      873   else do:
      874     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
      875   end.
      876   if p-nam-2str then do:
      877     assign
      878     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
      879     chk_name = substr(chk_name, 1, v-length)
      880     .
      881   end.
      882   else do:
      883     assign
      884     p-second-name = replace(p-gds-name1, chr(39), "":U)
      885     p-second-name =   (chr(34) +
      886                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
      887                       + chr(34) )
      888     .
      889   end.
      890   return chk_name.
      891   end function.
      892   procedure proc-alt-shift-f2:
      893     if not ibs.th.gbl.gbl-var:rcode
      894   then
      895     run gbl\inidebug.p .
      896   end.
      897   procedure proc-alt-shift-f3:
      898     run gbl/prvssinf.p
      899       ( input this-procedure
      900       ) .
      901   end.
      902   define variable v-inform-launched as logical no-undo initial false .
      903   procedure proc-alt-shift-f4:
      904     define variable v-action as character no-undo .
      905     if v-inform-launched = false then do:
      906       assign
      907         v-inform-launched = true
      908       .
      909       run gbl/d-inform.w
      910         (  input self
      911         ,  input this-procedure
      912         , output v-action
      913         ) no-error .
      914       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      915       assign
      916         v-inform-launched = false
      917       .
      918     end.
      919   end.
      920   procedure proc-alt-f1:
      921     run gbl/corrhelp.p
      922       (input this-procedure
      923       ) .
      924   end .
      925   on alt-shift-f2 anywhere do:
      926     run proc-alt-shift-f2.
      927   end.
      928   on alt-shift-f3 anywhere do:
      929     run proc-alt-shift-f3 in this-procedure .
      930   end.
      931   on alt-shift-f4 anywhere do:
      932     run proc-alt-shift-f4 in this-procedure.
      933   end.
      934   on alt-f1 anywhere do:
      935     run proc-alt-f1 in this-procedure .
      936   end.
