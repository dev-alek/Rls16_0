      333      define output parameter p-user-can-edit  as logical   no-undo .
      334      define output parameter p-output-display as logical   no-undo .
      335      define output parameter p-other          as character no-undo .
      336      define output parameter p-prop-list      as character no-undo .
      337      define output parameter p-prop-type-list as character no-undo .
