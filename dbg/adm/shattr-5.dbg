      938     define variable v-cntxt-db-num        as integer   no-undo .
      939     define variable v-cntxt-userid        as character no-undo .
      940     define variable v-cntxt-level         as character no-undo .
      941     define variable v-cntxt-host-code-obj as integer   no-undo .
      942     define variable v-cntxt-obj-type      as character no-undo .
      943     define variable v-cntxt-obj-code      as integer   no-undo .
      944     define variable v-cntxt-db-num-obj    as integer   no-undo .
      945     define variable v-cntxt-is-admin      as logical   no-undo .
      946   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
