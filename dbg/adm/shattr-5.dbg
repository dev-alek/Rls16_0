      363   procedure thbjattr_code_reg :
      364   define input  parameter p-upper-code     as character no-undo .
      365   define input  parameter p-code           as character no-undo .
      366   define output parameter p-label          as character no-undo .
      367   define output parameter p-user-can-edit  as logical   no-undo .
      368   define output parameter p-output-display as logical   no-undo .
      369   define output parameter p-other          as character no-undo .
      370   define output parameter p-prop-list      as character no-undo .
      371   define output parameter p-prop-type-list as character no-undo .
      372   define output parameter p-prop-label-list as character no-undo .
      373   define output parameter p-global          as logical no-undo .
      374   define output parameter p-host           as logical no-undo .
      375   define output parameter p-shop           as logical no-undo .
      376   define output parameter p-store          as logical no-undo .
      377   define output parameter p-db             as logical no-undo .
      378   define output parameter p-region         as logical no-undo .
      379   do
      380   on error undo, return error return-value
      381   :
      382       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      383       (input  p-upper-code
      384       ,input  p-code
      385       ,output p-label
      386       ,output p-user-can-edit
      387       ,output p-output-display
      388       ,output p-other
      389       ,output p-prop-list
      390       ,output p-prop-type-list
      391       ,output p-prop-label-list
      392       ,output p-global
      393       ,output p-host
      394       ,output p-shop
      395       ,output p-store
      396       ,output p-db
      397       ,output p-region
      398       ) no-error .
      399     if error-status :error
      400     then do:
      401       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      402     end.
      403   end.
      404   end procedure.
