        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-layout-id as character no-undo .
        6   define input parameter        p-layout-type as character no-undo .
        7   define input parameter        p-device-type as character no-undo .
        8   define input parameter        p-layout-name as character no-undo .
        9   define input parameter        p-is-default as integer no-undo .
       10   define input  parameter       p-des as character no-undo .
       11   define temp-table tt-rule-by-call no-undo like ub.rule-by-call.
       12   DEFINE INPUT PARAMETER TABLE FOR tt-rule-by-call.
       13   define temp-table tt-layout-elem-rule no-undo like ub.layout-elem-rule.
       14   DEFINE INPUT PARAMETER TABLE FOR tt-layout-elem-rule.
       15   define temp-table tt-rule-call-param no-undo like ub.rule-call-param.
       16   DEFINE INPUT PARAMETER TABLE FOR tt-rule-call-param.
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: layout1.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: adm/layout1.p $":U .
       22   define variable vss-description as character no-undo init "Сохранение раскладки".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure gen-key-rec :
       94     define input  parameter p-tbl-name    as character no-undo.
       95     define input  parameter p-bh_tbl-name as handle    no-undo.
       96     define output parameter p-key-rec     as character no-undo.
       97     do
       98     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       99     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      100     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      101     :
      102       define variable fh               as handle    no-undo .
      103       define variable v-ok             as logical   no-undo .
      104       define variable v-inform         as character no-undo .
      105       define variable v-ind            as integer   no-undo .
      106       define variable v-idx-field-qnty as integer   no-undo .
      107       if p-tbl-name = ?
      108         or p-tbl-name = "":U
      109       then do:
      110         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      111       end.
      112       if not p-bh_tbl-name:available then do:
      113         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      114       end.
      115       assign
      116         p-key-rec = p-tbl-name
      117         v-inform  = p-bh_tbl-name:index-information(1)
      118         v-ind     = 2
      119       .
      120       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      121       on error undo, return error
      122       :
      123         assign
      124           v-inform = p-bh_tbl-name:index-information( v-ind )
      125           v-ind    = v-ind + 1
      126         .
      127       end.
      128       if v-inform = ?
      129         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      130         or entry( 3, v-inform, ",":U ) <> "1":U
      131       then do:
      132         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      133       end.
      134       else do:
      135         assign
      136           v-idx-field-qnty = num-entries( v-inform ) - 4
      137         .
      138         if v-idx-field-qnty < 2 then do:
      139           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      140         end.
      141         do v-ind = 1 to v-idx-field-qnty by 2
      142         on error undo, return error
      143         :
      144           assign
      145             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      146             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      147           .
      148         end.
      149       end.
      150       if p-key-rec = ? then do:
      151         assign
      152           p-key-rec = "":U
      153         .
      154         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      155       end.
      156     end.
      157     return.
      158   end procedure.
      159   procedure gen-where-keyr-tab :
      160     define input  parameter i-tableSerach as character no-undo.
      161     define input  parameter i-tablekey   as character  no-undo.
      162     define input  parameter p-key-rec    as character  no-undo.
      163     define input  parameter p-key-handle as handle     no-undo .
      164     define input  parameter p-db-name    as character  no-undo .
      165     define input  parameter p-tt-handle  as handle     no-undo .
      166     define output parameter o-Where      as character  no-undo.
      167     do
      168     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      169     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      170     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      171     :
      172       define variable v-full-tbl-name  as character no-undo .
      173       define variable bh_tbl-name      as handle    no-undo .
      174       define variable fh_key           as handle    no-undo .
      175       define variable fh_search        as handle    no-undo .
      176       define variable v-field-num      as integer   no-undo .
      177       define variable v-count-fld      as integer   no-undo .
      178       define variable v-inform         as character no-undo .
      179       define variable v-ind            as integer   no-undo .
      180       define variable v-idx-field-qnty as integer   no-undo .
      181       define variable v-field-name     as character no-undo .
      182       define variable v-field-val      as character no-undo .
      183       define variable v-word-link      as character no-undo .
      184       define variable vTable           as character no-undo.
      185       define variable bh_tbl-key       as handle    no-undo .
      186       assign
      187         p-key-rec = trim( p-key-rec )
      188       .
      189       if p-key-handle <> ? then do:
      190         if not valid-handle(p-key-handle)
      191            or p-key-handle:type <> "buffer"
      192         then do:
      193           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      194         end.
      195         if num-entries( p-key-rec, chr(3) ) > 1
      196           or p-key-rec = ?
      197           or p-key-rec = "":U
      198         then do:
      199           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      200         end.
      201       end.
      202       else do:
      203         if p-key-rec = ?
      204           or p-key-rec = "":U
      205         then do:
      206           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      207         end.
      208       end.
      209       assign
      210         vTable = entry( 1 , p-key-rec, chr(3) )
      211       .
      212       if p-tt-handle <> ?
      213         and ( not valid-handle(p-tt-handle)
      214               or p-tt-handle:type <> "buffer"
      215             )
      216       then do:
      217         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      218       end.
      219       if p-tt-handle = ? then do:
      220         assign
      221           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      222         .
      223         create buffer bh_tbl-name for table v-full-tbl-name .
      224       end.
      225       else do:
      226         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      227       end.
      228       assign
      229         v-inform = bh_tbl-name:index-information(1)
      230         v-ind    = 2
      231       .
      232       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      233       on error undo, return error
      234       :
      235         assign
      236           v-inform = bh_tbl-name:index-information( v-ind )
      237           v-ind    = v-ind + 1
      238         .
      239       end.
      240       if v-inform = ?
      241         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      242         or entry( 3, v-inform, ",":U ) <> "1":U
      243       then do:
      244         delete object bh_tbl-name no-error.
      245         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      246       end.
      247       assign
      248         v-idx-field-qnty = num-entries( v-inform ) - 4
      249       .
      250       if v-idx-field-qnty < 2 then do:
      251         delete object bh_tbl-name no-error.
      252         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      253       end.
      254       assign
      255         o-where     = "where":U
      256         v-word-link = "":U
      257         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      258         v-count-fld = 0
      259       .
      260       if i-tablekey ne "" and i-tablekey ne ?
      261       then do:
      262         assign
      263           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      264         .
      265         create buffer bh_tbl-key for table v-full-tbl-name .
      266       end.
      267       if i-tableSerach ne "" and i-tableSerach ne ?
      268       then do:
      269         delete object bh_tbl-name no-error.
      270         assign
      271           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      272         .
      273         create buffer bh_tbl-name for table v-full-tbl-name .
      274       end.
      275       block_where:
      276       do v-ind = 1 to v-idx-field-qnty by 2
      277       on error undo, return error
      278       :
      279         assign
      280           v-count-fld = v-count-fld + 1
      281         .
      282         if p-key-handle = ?
      283           and v-count-fld > v-field-num
      284         then do:
      285           leave block_where.
      286         end.
      287         define variable VfieldKeyTable as handle no-undo.
      288         assign
      289           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      290           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      291         .
      292         if     bh_tbl-key ne ?
      293         then do:
      294            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      295            if VfieldKeyTable eq ?
      296            then next block_where.
      297         end.
      298         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      299         then
      300            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      301         else
      302            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      303         if p-key-handle = ? then do:
      304           assign
      305             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      306           .
      307         end.
      308         else do:
      309           assign
      310             fh_key = p-key-handle:buffer-field( v-field-name )
      311           .
      312           if fh_key = ?
      313             or not valid-handle( fh_key )
      314           then do:
      315             delete object bh_tbl-name.
      316             if     bh_tbl-key ne ?
      317             then
      318                delete object bh_tbl-key.
      319             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      320           end.
      321           assign
      322             v-field-val = fh_key:buffer-value
      323           .
      324         end.
      325         if fh_search:data-type ="character":U then do:
      326           assign
      327             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      328             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      329             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      330             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      331             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      332             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      333             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      334             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      335             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      336             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      337             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      338             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      339             v-field-val = substitute( '"&1"', v-field-val )
      340           .
      341         end.
      342         assign
      343           o-where = substitute( "&1 &2", o-where, v-field-val )
      344         .
      345         if v-word-link = "":U then do:
      346           assign
      347             v-word-link = "and":U
      348           .
      349         end.
      350       end.
      351       delete object bh_tbl-name.
      352       if     bh_tbl-key ne ?
      353       then
      354          delete object bh_tbl-key.
      355       if p-key-handle = ?
      356         and v-count-fld <> v-field-num
      357       then do:
      358         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      359       end.
      360     end.
      361   end procedure.
      362   procedure gen-hn-keyr-tab :
      363     define input  parameter i-tableSerach as character no-undo.
      364     define input  parameter i-tablekey   as character no-undo.
      365     define input  parameter p-key-rec    as character no-undo.
      366     define input  parameter p-key-handle as handle    no-undo .
      367     define input  parameter p-db-name    as character no-undo .
      368     define input  parameter p-tt-handle  as handle    no-undo .
      369     define input  parameter p-stts-lock  as integer   no-undo .
      370     define output parameter o-hn         as handle    no-undo.
      371     define variable v-full-tbl-name as character no-undo.
      372     define variable v-where         as character no-undo.
      373     define variable bh_tbl-name     as handle    no-undo.
      374     define variable vTable          as character no-undo.
      375     do
      376     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      377     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      378     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      379         run gen-where-keyr-tab(i-tableSerach,
      380                                i-tablekey,
      381                                p-key-rec,
      382                                p-key-handle,
      383                                p-db-name,
      384                                p-tt-handle,
      385                                output v-where).
      386         if i-tableSerach ne "" and i-tableSerach ne ?
      387         then do:
      388            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      389            create buffer bh_tbl-name for table v-full-tbl-name .
      390         end.
      391         else do:
      392            if p-tt-handle = ? then do:
      393               assign
      394                  vTable = entry( 1 , p-key-rec, chr(3) )
      395               .
      396               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      397               create buffer bh_tbl-name for table v-full-tbl-name .
      398            end.
      399            else do:
      400               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      401            end.
      402         end.
      403         if p-tt-handle = ? then do:
      404            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      405         end.
      406         else do:
      407            bh_tbl-name:find-first( v-where ) no-error .
      408         end.
      409         o-hn = bh_tbl-name.
      410      end.
      411   end procedure.
      412   procedure gen-hn-keyr :
      413     define input  parameter p-key-rec    as character no-undo.
      414     define input  parameter p-key-handle as handle    no-undo .
      415     define input  parameter p-db-name    as character no-undo .
      416     define input  parameter p-tt-handle  as handle    no-undo .
      417     define input  parameter p-stts-lock  as integer   no-undo .
      418     define output parameter o-hn         as handle    no-undo.
      419     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      420   end.
      421   procedure gen-row-keyr :
      422     define input  parameter p-key-rec    as character no-undo.
      423     define input  parameter p-key-handle as handle    no-undo .
      424     define input  parameter p-db-name    as character no-undo .
      425     define input  parameter p-tt-handle  as handle    no-undo .
      426     define input  parameter p-stts-lock  as integer   no-undo .
      427     define output parameter p-tbl-row    as rowid     no-undo.
      428     define output parameter p-tbl-name   as character no-undo.
      429     define variable vHn as handle no-undo.
      430       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      431       p-tbl-row = if vHn:available then vHn:rowid else ?.
      432       p-tbl-name =  vHn:table.
      433       delete object vHn no-error.
      434     if p-tbl-row = ? then do:
      435       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      436     end.
      437     else do:
      438       return.
      439     end.
      440   end procedure.
      441   procedure gen-key-fv :
      442     define input  parameter p-key-rec    as character no-undo .
      443     define output parameter p-field-list as character no-undo .
      444     define output parameter p-value-list as character no-undo.
      445     do
      446     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      447     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      448     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      449     :
      450       define variable v-full-tbl-name  as character no-undo .
      451       define variable bh_tbl-name      as handle    no-undo .
      452       define variable v-tbl-name       as character no-undo .
      453       define variable v-field-num      as integer   no-undo .
      454       define variable v-count-fld      as integer   no-undo .
      455       define variable v-inform         as character no-undo .
      456       define variable v-ind            as integer   no-undo .
      457       define variable v-idx-field-qnty as integer   no-undo .
      458       define variable v-delim-key      as character no-undo .
      459       if p-key-rec = ?
      460         or p-key-rec = "":U
      461       then do:
      462         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      463       end.
      464       assign
      465         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      466         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      467       .
      468       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      469       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      470       assign
      471         v-inform = bh_tbl-name:index-information(1)
      472         v-ind    = 2
      473       .
      474       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      475       on error undo, return error
      476       :
      477         assign
      478           v-inform = bh_tbl-name:index-information( v-ind )
      479           v-ind    = v-ind + 1
      480         .
      481       end.
      482       if v-inform = ?
      483         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      484         or entry( 3, v-inform, ",":U ) <> "1":U
      485       then do:
      486         delete object bh_tbl-name no-error.
      487         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      488       end.
      489       assign
      490         v-idx-field-qnty = num-entries( v-inform ) - 4
      491       .
      492       if v-idx-field-qnty < 2 then do:
      493         delete object bh_tbl-name no-error.
      494         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      495       end.
      496       assign
      497         p-field-list = "":U
      498         p-value-list = "":U
      499         v-delim-key  = "":U
      500         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      501         v-count-fld  = 0
      502       .
      503       block_where:
      504       do v-ind = 1 to v-idx-field-qnty by 2
      505       on error undo, return error
      506       :
      507         assign
      508           v-count-fld = v-count-fld + 1
      509         .
      510         if v-count-fld > v-field-num then do:
      511           leave block_where.
      512         end.
      513         assign
      514           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      515           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      516         .
      517         if v-ind = 1 then do:
      518           assign
      519             v-delim-key = chr(3)
      520           .
      521         end.
      522       end.
      523       delete object bh_tbl-name.
      524       if v-count-fld <> v-field-num then do:
      525         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      526       end.
      527     end.
      528   end procedure.
      529   procedure gen-key-field :
      530     define input  parameter p-table      as character no-undo .
      531     define output parameter p-field-list as character no-undo .
      532     do
      533     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      534     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      535     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      536     :
      537       define variable v-full-tbl-name  as character no-undo .
      538       define variable bh_tbl-name      as handle    no-undo .
      539       define variable v-tbl-name       as character no-undo .
      540       define variable v-field-num      as integer   no-undo .
      541       define variable v-count-fld      as integer   no-undo .
      542       define variable v-inform         as character no-undo .
      543       define variable v-ind            as integer   no-undo .
      544       define variable v-idx-field-qnty as integer   no-undo .
      545       define variable v-delim-key      as character no-undo .
      546       if p-table = ?
      547         or p-table = "":U
      548       then do:
      549         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      550       end.
      551       assign
      552         v-tbl-name      = p-table
      553         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      554       .
      555       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      556       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      557       assign
      558         v-inform = bh_tbl-name:index-information(1)
      559         v-ind    = 2
      560       .
      561       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      562       on error undo, return error
      563       :
      564         assign
      565           v-inform = bh_tbl-name:index-information( v-ind )
      566           v-ind    = v-ind + 1
      567         .
      568       end.
      569       if v-inform = ?
      570         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      571         or entry( 3, v-inform, ",":U ) <> "1":U
      572       then do:
      573         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      574       end.
      575       assign
      576         v-idx-field-qnty = num-entries( v-inform ) - 4
      577       .
      578       if v-idx-field-qnty < 2 then do:
      579         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      580       end.
      581       assign
      582         p-field-list = "":U
      583         v-delim-key  = "":U
      584         v-count-fld  = 0
      585       .
      586       block_where:
      587       do v-ind = 1 to v-idx-field-qnty by 2
      588       on error undo, return error
      589       :
      590         assign
      591           v-count-fld = v-count-fld + 1
      592         .
      593         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      594         if v-ind = 1 then do:
      595           assign
      596             v-delim-key = chr(3)
      597           .
      598         end.
      599       end.
      600       delete object bh_tbl-name.
      601     end.
      602   end procedure.
      603   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   procedure cur-time :
      605      define output parameter p-today as date      no-undo .
      606      define output parameter p-time  as integer   no-undo .
      607     do
      608     on error undo, return error
      609     :
      610       define variable v-date1 as date      no-undo .
      611       define variable v-date2 as date      no-undo .
      612       define variable v-time  as integer   no-undo .
      613       assign
      614         v-date1 = today
      615         v-time  = time
      616         v-date2 = today
      617       .
      618       if v-date1 <> v-date2
      619       then do:
      620         assign
      621           v-date1 = today
      622           v-time  = v-time
      623         .
      624       end.
      625       assign
      626         p-today = v-date1
      627         p-time  = v-time
      628       .
      629     end.
      630   end.
      631   function cur-time-date returns character
      632   :
      633     return string(today, '99/99/9999':U) .
      634   end.
      635   function cur-time-mjd returns decimal
      636   :
      637     define variable v-date as date      no-undo .
      638     define variable v-time as integer   no-undo .
      639     run cur-time in this-procedure
      640       (output v-date
      641       ,output v-time
      642       ) .
      643     return integer(v-date) - 2400002 + (v-time / 86400) .
      644   end.
      645   function cur-time-get-ending-index returns integer
      646   (input p-number as integer
      647   )
      648   :
      649     if p-number < 0
      650     or p-number = ?
      651     then do:
      652       return 1 .
      653     end.
      654     define variable v-rest as integer   no-undo .
      655     assign
      656       p-number = p-number modulo 100
      657     .
      658     if p-number < 20
      659     then do:
      660       assign
      661         v-rest = p-number
      662       .
      663     end.
      664     else do:
      665       assign
      666         v-rest = p-number modulo 10
      667       .
      668     end.
      669     case v-rest :
      670       when 1
      671       then do:
      672         return 2 .
      673       end.
      674       when 2 or
      675       when 3 or
      676       when 4
      677       then do:
      678         return 3 .
      679       end.
      680       otherwise do:
      681         return 1 .
      682       end.
      683     end case .
      684   end.
      685   procedure cur-time-mjd-to-date :
      686      define input  parameter i-mjd-diff as decimal no-undo.
      687      define output parameter o-Date     as date    no-undo.
      688      define output parameter o-Time     as integer no-undo.
      689      define variable v-day-number as integer   no-undo .
      690      if    i-mjd-diff < 0
      691         or i-mjd-diff = ?
      692      then do:
      693         return "?" .
      694      end.
      695      assign
      696         v-day-number = truncate(i-mjd-diff,0).
      697         o-Date = date(v-day-number + 2400002).
      698         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      699     .
      700   end.
      701   function cur-time-mjd-to-string returns character
      702   (input p-mjd-diff as decimal
      703   )
      704   :
      705     define variable v-day-number as integer   no-undo .
      706     define variable v-seconds    as integer   no-undo .
      707     define variable v-hour       as integer   no-undo .
      708     define variable v-min        as integer   no-undo .
      709     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      710     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      711     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      712     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      713     if p-mjd-diff < 0
      714     or p-mjd-diff = ?
      715     then do:
      716       return "?" .
      717     end.
      718     assign
      719       v-day-number = integer(truncate(p-mjd-diff,0))
      720       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      721     .
      722     if v-seconds > 86400
      723     then do:
      724       assign
      725         v-seconds = 86400 - 1
      726       .
      727     end.
      728     if v-seconds < 0
      729     then do:
      730       assign
      731         v-seconds = 0
      732       .
      733     end.
      734     assign
      735       v-hour = truncate(v-seconds / 3600, 0)
      736     .
      737     assign
      738       v-seconds = v-seconds modulo 3600
      739     .
      740     assign
      741       v-min = truncate(v-seconds / 60, 0)
      742     .
      743     assign
      744       v-seconds = v-seconds modulo 60
      745     .
      746     return
      747         (if v-day-number <> 0
      748           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      749           else ""
      750         )
      751       + (if v-day-number <> 0 or v-hour <> 0
      752           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      753           else ""
      754         )
      755       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      756           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      757           else ""
      758         )
      759       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      760       .
      761   end.
      762   function cur-time-string returns character
      763   :
      764     define variable v-date as date      no-undo .
      765     define variable v-time as integer   no-undo .
      766     run cur-time in this-procedure
      767       (output v-date
      768       ,output v-time
      769       ) .
      770     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      771   end.
      772   function cur-time-string-sec returns character
      773   :
      774     define variable v-date as date      no-undo .
      775     define variable v-time as integer   no-undo .
      776     run cur-time in this-procedure
      777       (output v-date
      778       ,output v-time
      779       ) .
      780     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      781   end.
      782   function cur-time-custom  returns character
      783   (input p-prefix as character
      784   ,input p-date-format as character
      785   ,input p-delimiter as character
      786   ,input p-time-format as character
      787   ,input p-suffix as character
      788   )
      789   :
      790     define variable v-date as date      no-undo .
      791     define variable v-time as integer   no-undo .
      792     run cur-time in this-procedure
      793       (output v-date
      794       ,output v-time
      795       ) .
      796     return
      797       p-prefix
      798       + string(v-date, p-date-format)
      799       + p-delimiter
      800       + string(v-time, p-time-format)
      801       + p-suffix
      802       .
      803   end.
      804   function cur-time-print  returns character
      805   :
      806     define variable v-date as date      no-undo .
      807     define variable v-time as integer   no-undo .
      808     run cur-time in this-procedure
      809       (output v-date
      810       ,output v-time
      811       ) .
      812     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      813   end.
      814   function cur-time-datetime returns datetime
      815   :
      816     define variable v-char as character no-undo .
      817     define variable v-datetime as datetime no-undo .
      818     v-char = cur-time-string().
      819     v-datetime = datetime(v-char).
      820     return  v-datetime.
      821   end.
      822   function cur-time-string-msec returns character
      823   :
      824     define variable v-date as datetime  no-undo .
      825     v-date = now.
      826     return string(v-date) .
      827   end.
      828   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      829   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      830   procedure layouth_create-layout_h :
      831   define input parameter p-mode as character no-undo .
      832   define input parameter p-layout-id as character no-undo .
      833   define parameter buffer buf_layout for ub.layout.
      834   define output parameter p-chip-num as integer no-undo .
      835   define variable v-chip-num as integer no-undo .
      836   DEFINE VARIABLE v-today as date no-undo .
      837   DEFINE VARIABLE v-time as integer no-undo .
      838   define buffer buf_c-layout for ub.c-layout.
      839   do
      840   on error undo, return error
      841   :
      842     run cur-time in this-procedure ( output v-today, output v-time).
      843     find last buf_c-layout no-lock where
      844               buf_c-layout.layout-id = p-layout-id
      845          and  buf_c-layout.corr-user-db-num = g#db-num
      846          use-index pi no-error.
      847     assign
      848     v-chip-num = (if available buf_c-layout
      849                   then buf_c-layout.chip-num + 1
      850                   else 0).
      851     create buf_c-layout.
      852     if available buf_layout
      853     and p-mode <> 'ДОБАВЛЕНИЕ':U
      854     then do:
      855       buffer-copy buf_layout
      856       to buf_c-layout.
      857     end.
      858     if not available buf_layout then do:
      859       assign
      860       buf_c-layout.layout-id = p-layout-id
      861       .
      862     end.
      863     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      864       assign
      865       buf_c-layout.layout-id = p-layout-id
      866       .
      867     end.
      868     assign
      869     buf_c-layout.subject = 'layout':U
      870     buf_c-layout.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
      871                            then integer('1':U)
      872                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
      873                                  then integer('2':U)
      874                                  else integer('99':U)
      875                                  )
      876                           )
      877     buf_c-layout.chip-num = v-chip-num
      878     buf_c-layout.corr-user-db-num = g#db-num
      879     buf_c-layout.corr-user-name = g#userid
      880     buf_c-layout.corr-date = v-today
      881     buf_c-layout.corr-time = v-time
      882     p-chip-num = v-chip-num
      883     .
      884   end.
      885   end procedure.
      886   procedure layouth_create-layout-elem-rule_h :
      887   define input parameter p-mode as character no-undo .
      888   define input parameter p-layout-id as character no-undo .
      889   define input parameter p-mode-id as character no-undo .
      890   define input parameter p-widget-id as character no-undo .
      891   define parameter buffer buf_layout-elem-rule for ub.layout-elem-rule.
      892   define input parameter p-chip-num as integer no-undo .
      893   DEFINE VARIABLE v-today as date no-undo .
      894   DEFINE VARIABLE v-time as integer no-undo .
      895   define buffer buf_c-layout-elem-rule for ub.c-layout-elem-rule.
      896   do
      897   on error undo, return error
      898   :
      899     run cur-time in this-procedure ( output v-today, output v-time).
      900     create buf_c-layout-elem-rule.
      901     if available buf_layout-elem-rule
      902     and p-mode <> 'ДОБАВЛЕНИЕ':U
      903     then do:
      904       buffer-copy buf_layout-elem-rule
      905       to buf_c-layout-elem-rule.
      906     end.
      907     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      908       assign
      909       buf_c-layout-elem-rule.layout-id = p-layout-id
      910       buf_c-layout-elem-rule.mode-id = p-mode-id
      911       buf_c-layout-elem-rule.widget-id = p-widget-id
      912       .
      913     end.
      914     assign
      915     buf_c-layout-elem-rule.subject = 'layout-elem-rule':U
      916     buf_c-layout-elem-rule.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
      917                            then integer('1':U)
      918                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
      919                                  then integer('2':U)
      920                                  else integer('99':U)
      921                                  )
      922                           )
      923     buf_c-layout-elem-rule.chip-num = p-chip-num
      924     buf_c-layout-elem-rule.corr-user-db-num = g#db-num
      925     buf_c-layout-elem-rule.corr-user-name = g#userid
      926     buf_c-layout-elem-rule.corr-date = v-today
      927     buf_c-layout-elem-rule.corr-time = v-time
      928     .
      929   end.
      930   end procedure.
      931   procedure layouth_create-rule-call-param_h :
      932   define input parameter p-mode as character no-undo .
      933   define input parameter p-call#-id as integer no-undo .
      934   define input parameter p-codex-id as integer no-undo .
      935   define input parameter p-ruleset-id as integer no-undo .
      936   define input parameter p-order-id as integer no-undo .
      937   define input parameter p-param-name as character no-undo .
      938   define input parameter p-index as integer no-undo .
      939   define input parameter p-call-id as character no-undo .
      940   define parameter buffer buf_rule-call-param for ub.rule-call-param.
      941   define input parameter p-chip-num as integer no-undo .
      942   DEFINE VARIABLE v-today as date no-undo .
      943   DEFINE VARIABLE v-time as integer no-undo .
      944   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
      945   do
      946   on error undo, return error
      947   :
      948     run cur-time in this-procedure ( output v-today, output v-time).
      949     create buf_c-rule-call-param.
      950     if available buf_rule-call-param
      951     and p-mode <> 'ДОБАВЛЕНИЕ':U
      952     then do:
      953       buffer-copy buf_rule-call-param
      954       to buf_c-rule-call-param.
      955     end.
      956     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      957       assign
      958       buf_c-rule-call-param.call#_id = p-call#-id
      959       buf_c-rule-call-param.codex_id = p-codex-id
      960       buf_c-rule-call-param.ruleset_id = p-ruleset-id
      961       buf_c-rule-call-param.order_id = p-order-id
      962       buf_c-rule-call-param.param-name = p-param-name
      963       buf_c-rule-call-param.p-index = p-index
      964       buf_c-rule-call-param.call_id = p-call-id
      965       .
      966     end.
      967     assign
      968     buf_c-rule-call-param.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
      969                                     then integer('1':U)
      970                                     else (if p-mode = 'удаление':U
      971                                           then integer('99':U)
      972                                           else integer('2':U)
      973                                           )
      974                                     )
      975     buf_c-rule-call-param.chip-num = p-chip-num
      976     buf_c-rule-call-param.corr-user-db-num = g#db-num
      977     buf_c-rule-call-param.corr-user-name = g#userid
      978     buf_c-rule-call-param.corr-date = v-today
      979     buf_c-rule-call-param.corr-time = v-time
      980     .
      981   end.
      982   end procedure.
      983   define variable v-admin as logical no-undo .
      984   define variable v-ii as integer no-undo .
      985   define variable v-mess as character no-undo .
      986   define variable v-last-id-int as integer no-undo .
      987   define variable v-layout-id as character no-undo .
      988   define variable v-uniq-key-rec as character no-undo .
      989   define variable v-rbc-uniq-key-rec as character no-undo .
      990   define variable v-call#-id as integer no-undo .
      991   define variable v-cmp as logical no-undo .
      992   DEFINE VARIABLE v-today as date no-undo .
      993   DEFINE VARIABLE v-time as integer no-undo .
      994   define variable v-chip-num as integer no-undo .
      995   define buffer buf_layout for ub.layout.
      996   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
      997   define buffer buf_rule-call-param for ub.rule-call-param.
      998   define buffer buf_rule-by-call for ub.rule-by-call.
      999   define buffer buf_tt-layout-elem-rule for tt-layout-elem-rule.
     1000   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1001   define buffer buf_tt-rule-by-call for tt-rule-by-call.
     1002   define buffer buf_wi-mode for ub.wi-mode.
     1003   define buffer buf_layout-elem  for ub.layout-elem.
     1004   define buffer buf2_layout for ub.layout.
     1005   define buffer buf2_layout-elem-rule for ub.layout-elem-rule.
     1006   define buffer buf_rule for ub.rule.
     1007   if lookup('admin', p-mode) > 0 then do:
     1008     v-admin = yes.
     1009     p-mode = trim(replace(p-mode, 'admin', ''), chr(44)).
     1010   end.
     1011   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1012   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1013     message vss-workfile vss-revision vss-description skip
     1014             "Неверный параметр p-mode - " p-mode
     1015     view-as alert-box error .
     1016     return error '':u.
     1017   end.
     1018   if g#db-num <> 0
     1019   and (p-is-default = integer('1':U)
     1020        or
     1021        p-is-default = integer('-1':U))
     1022   then do:
     1023     message vss-workfile vss-revision vss-description skip
     1024             "Запрещено в УБД редактировать дефолтные и обязательные раскладки"
     1025     view-as alert-box error .
     1026     return error '':u.
     1027   end.
     1028   _main:
     1029   do for buf_layout
     1030   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1031   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1032   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1033   :
     1034     if lookup(string(p-is-default), '0,1,-1':U) = 0 then do:
     1035       assign
     1036       v-mess = substitute("Неверное значение параметра p-is-default=&1", p-is-default).
     1037       run err-mess in this-procedure ( input-output v-mess).
     1038       undo _main, return error (if p-silent = yes then v-mess else 'is-default':U).
     1039     end.
     1040     if p-layout-name = '' then do:
     1041       assign
     1042       v-mess = substitute("Не задано название раскладки").
     1043       run err-mess in this-procedure ( input-output v-mess).
     1044       undo _main, return error (if p-silent = yes then v-mess else 'layout-name':U).
     1045     end.
     1046     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1047       if p-is-default = integer('0':U) then do:
     1048         v-last-id-int = next-value(s-layout-id, ub).
     1049         if g#db-num = 0 then do:
     1050           v-layout-id = substitute("&1", string(v-last-id-int)).
     1051         end.
     1052         else do:
     1053           v-layout-id = substitute("&1-&2", string(v-last-id-int), g#db-num).
     1054         end.
     1055       end.
     1056       else do:
     1057         if p-is-default = integer('-1':U) then do:
     1058           if can-find(first ub.layout no-lock where
     1059                            ub.layout.layout-type = p-layout-type
     1060                         and ub.layout.device-type = p-device-type) then do:
     1061             assign
     1062             v-mess = substitute("Уже существует обязательная раскладка с типом &1 для &2"
     1063                                , p-layout-type
     1064                                , p-device-type
     1065                                ).
     1066             run err-mess in this-procedure ( input-output v-mess).
     1067             undo _main, return error (if p-silent = yes then v-mess else '':U).
     1068           end.
     1069         end.
     1070        _do:
     1071         do v-ii = 9 to 1 by -1:
     1072           find last buf_layout no-lock where
     1073                  buf_layout.layout-id >= substitute("_1&1"
     1074                                                      ,fill("0", v-ii - 1)
     1075                                                      )
     1076                and buf_layout.layout-id <= substitute("_&1"
     1077                                                      ,fill("9", v-ii)
     1078                                                      )
     1079                    no-error.
     1080           if available buf_layout then do:
     1081             v-last-id-int = integer(left-trim(entry(1, buf_layout.layout-id), "_")).
     1082             leave _do.
     1083           end.
     1084           else do:
     1085             next _do.
     1086           end.
     1087         end.
     1088         v-layout-id = substitute("_&1", string(v-last-id-int + 1)).
     1089       end.
     1090       find first buf_layout no-lock where
     1091                 buf_layout.layout-id = v-layout-id no-error .
     1092       if available buf_layout then do:
     1093         assign
     1094         v-mess = substitute("Уже существует раскладка c id = &1", v-layout-id).
     1095         run err-mess in this-procedure ( input-output v-mess).
     1096         undo _main, return error (if p-silent = yes then v-mess else '':U).
     1097       end.
     1098       if lookup( entry(1, p-layout-type, "_") , 'th-pos-screen,th-pos-keyboard':U) = 0 then do:
     1099         assign
     1100         v-mess = substitute("Неверный тип раскладки &1", p-layout-type).
     1101         run err-mess in this-procedure ( input-output v-mess).
     1102         undo _main, return error (if p-silent = yes then v-mess else 'layout-type':U).
     1103       end.
     1104       case p-layout-type:
     1105         WHEN 'th-pos-keyboard':U  THEN DO:
     1106           if lookup(p-device-type, 'IBM-50':U) = 0 then do:
     1107             assign
     1108             v-mess = substitute("Неверный тип устройства &1 для раскладки &2"
     1109                               , p-device-type
     1110                               , p-layout-type).
     1111             run err-mess in this-procedure ( input-output v-mess).
     1112             undo _main, return error (if p-silent = yes then v-mess else 'device-type':U).
     1113           end.
     1114         END.
     1115         WHEN 'th-pos-screen':U  THEN DO:
     1116           if lookup(p-device-type, 'Screen,TouchScreen':U) = 0 then do:
     1117             assign
     1118             v-mess = substitute("Неверный тип устройства &1 для раскладки &2"
     1119                               , p-device-type
     1120                               , p-layout-type).
     1121             run err-mess in this-procedure ( input-output v-mess).
     1122             undo _main, return error (if p-silent = yes then v-mess else 'device-type':U).
     1123           end.
     1124         END.
     1125       end case.
     1126       create buf_layout.
     1127       assign
     1128       buf_layout.layout-type = p-layout-type
     1129       buf_layout.layout-id = v-layout-id
     1130       buf_layout.device-type = p-device-type
     1131       buf_layout.des = p-des
     1132       .
     1133     end.
     1134     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1135       v-layout-id = p-layout-id.
     1136       find first buf_layout exclusive-lock where
     1137                 recid(buf_layout) = p-rec .
     1138       if buf_layout.layout-type <> p-layout-type
     1139       or buf_layout.device-type <> p-device-type
     1140       or buf_layout.layout-id <> p-layout-id
     1141       then do:
     1142         assign
     1143         v-mess = substitute("Для уже существующей расладки невозможно измененить тип раскладки, тип устройства, идентификатор раскладки&1"
     1144                                 , chr(10)
     1145                                 )
     1146         .
     1147         run err-mess in this-procedure ( input-output v-mess).
     1148         undo _main, return error (if p-silent = yes then v-mess else '':U).
     1149       end.
     1150     end.
     1151     run  layouth_create-layout_h  in this-procedure (
     1152                                                     input p-mode
     1153                                                    ,input v-layout-id
     1154                                                    ,buffer buf_layout
     1155                                                    ,output v-chip-num).
     1156     assign
     1157     buf_layout.is-default = p-is-default
     1158     buf_layout.layout-name = p-layout-name
     1159     p-rec = recid(buf_layout)
     1160     .
     1161     if p-is-default = integer('0':U)
     1162     or p-is-default = integer('1':U)
     1163     then do:
     1164       find first buf2_layout share-lock where
     1165                 buf2_layout.layout-type = p-layout-type
     1166             and buf2_layout.device-type = p-device-type
     1167             and buf2_layout.is-default = integer('-1':U) no-error.
     1168     end.
     1169     for each buf_tt-layout-elem-rule:
     1170       find first buf_wi-mode no-lock where
     1171                 buf_wi-mode.mode-type = 'cd-IBS-TH':U
     1172             and buf_wi-mode.mode-id = buf_tt-layout-elem-rule.mode-id no-error.
     1173       if not available buf_wi-mode then do:
     1174         v-mess = substitute("Не найден режим &1 для элемента раскладки &2"
     1175                             , buf_tt-layout-elem-rule.mode-id
     1176                             , buf_tt-layout-elem-rule.widget-id
     1177                                                       ).
     1178         run err-mess in this-procedure ( input-output v-mess).
     1179         undo _main, return error (if p-silent = yes then v-mess else '':U).
     1180       end.
     1181        find first buf_layout-elem no-lock where
     1182                 buf_layout-elem.layout-type = p-layout-type
     1183             and buf_layout-elem.device-type = p-device-type
     1184             and buf_layout-elem.mode-id = buf_tt-layout-elem-rule.mode-id
     1185             and buf_layout-elem.widget-id = buf_tt-layout-elem-rule.widget-id no-error.
     1186       if not available buf_layout-elem then do:
     1187         v-mess = substitute("Не найден элемент раскладки &1 для режима &2"
     1188                             , buf_tt-layout-elem-rule.widget-id
     1189                             , buf_tt-layout-elem-rule.mode-id
     1190                                                       ).
     1191         run err-mess in this-procedure ( input-output v-mess).
     1192         undo _main, return error (if p-silent = yes then v-mess else '':U).
     1193       end.
     1194       if buf_layout-elem.elem-type = integer('-1':U) then do:
     1195         v-mess = substitute("Элемент раскладки &1 для режима &2 является НЕПРОГРАММИРУЕМЫМ"
     1196                             , buf_tt-layout-elem-rule.widget-id
     1197                             , buf_tt-layout-elem-rule.mode-id
     1198                                                       ).
     1199         run err-mess in this-procedure ( input-output v-mess).
     1200         undo _main, return error (if p-silent = yes then v-mess else '':U).
     1201       end.
     1202       if available buf2_layout then do:
     1203         find first buf2_layout-elem-rule no-lock where
     1204                   buf2_layout-elem-rule.layout-id = buf2_layout.layout-id
     1205               and buf2_layout-elem-rule.mode-id = buf_tt-layout-elem-rule.mode-id
     1206               and buf2_layout-elem-rule.widget-id = buf_tt-layout-elem-rule.widget-id no-error.
     1207         if available buf2_layout-elem-rule
     1208         and buf2_layout-elem-rule.rule_id <> buf_tt-layout-elem-rule.rule_id then do:
     1209           find first buf_rule no-lock where buf_rule.rule_id = buf2_layout-elem-rule.rule_id no-error.
     1210           v-mess = substitute("Элемент раскладки &1 для режима &2 является ОБЯЗАТЕЛЬНЫМ&3с привязанным к нему правилом &4"
     1211                             , buf_tt-layout-elem-rule.widget-id
     1212                             , buf_tt-layout-elem-rule.mode-id
     1213                             , chr(10)
     1214                             , (if available buf_rule then buf_rule.name else string(buf2_layout-elem-rule.rule_id))
     1215                                                       ).
     1216           run err-mess in this-procedure ( input-output v-mess).
     1217           undo _main, return error (if p-silent = yes then v-mess else '':U).
     1218         end.
     1219       end.
     1220       find first buf_tt-rule-by-call where
     1221                 buf_tt-rule-by-call.call_id = buf_tt-layout-elem-rule.uniq-key-rec no-error .
     1222       if not available buf_tt-rule-by-call then do:
     1223         message
     1224         substitute("Внутренняя ошибка - не найдена точка вызова для &1", buf_tt-layout-elem-rule.uniq-key-rec)
     1225         view-as alert-box error .
     1226         undo _main, return error .
     1227       end.
     1228       assign
     1229       buf_tt-layout-elem-rule.layout-id = v-layout-id.
     1230       run gen-key-rec in this-procedure ( input 'layout-elem-rule':U
     1231                                           ,input (buffer  buf_tt-layout-elem-rule:handle)
     1232                                           ,output v-uniq-key-rec).
     1233       for each buf_tt-rule-call-param where
     1234               buf_tt-rule-call-param.call_id = buf_tt-rule-by-call.call_id
     1235           and buf_tt-rule-call-param.codex_id = buf_tt-rule-by-call.codex_id
     1236           and buf_tt-rule-call-param.ruleset_id = buf_tt-rule-by-call.ruleset_id
     1237           and buf_tt-rule-call-param.order_id = buf_tt-rule-by-call.order_id:
     1238         assign
     1239         buf_tt-rule-call-param.call_id = v-uniq-key-rec.
     1240       end.
     1241       assign
     1242       buf_tt-layout-elem-rule.uniq-key-rec = v-uniq-key-rec
     1243       buf_tt-rule-by-call.call_id = v-uniq-key-rec
     1244       .
     1245     end.
     1246     for each buf2_layout-elem-rule no-lock where
     1247             buf2_layout-elem-rule.layout-id = buf2_layout.layout-id
     1248     on error  undo, return error:
     1249       find first buf_tt-layout-elem-rule where
     1250                 buf_tt-layout-elem-rule.layout-id = v-layout-id
     1251           and buf_tt-layout-elem-rule.mode-id = buf2_layout-elem-rule.mode-id
     1252           and buf_tt-layout-elem-rule.widget-id = buf2_layout-elem-rule.widget-id no-error.
     1253       if not available buf_tt-layout-elem-rule
     1254       or buf_tt-layout-elem-rule.rule_id <> buf2_layout-elem-rule.rule_id then do:
     1255         v-mess = substitute("Не найден ОБЯЗАТЕЛЬНЫЙ элемент раскладки &1 для режима &2"
     1256                             , buf2_layout-elem-rule.mode-id
     1257                             , buf2_layout-elem-rule.widget-id
     1258                                                       ).
     1259         run err-mess in this-procedure ( input-output v-mess).
     1260         undo _main, return error (if p-silent = yes then v-mess else '':U).
     1261       end.
     1262       assign
     1263       buf_tt-layout-elem-rule.is-mandatory = integer('1':U)
     1264       .
     1265     end.
     1266     for each buf_tt-layout-elem-rule where
     1267             buf_tt-layout-elem-rule.layout-id = v-layout-id
     1268     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1269     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1270     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1271     :
     1272       find first buf_tt-rule-by-call where
     1273                 buf_tt-rule-by-call.call_id = buf_tt-layout-elem-rule.uniq-key-rec.
     1274        find first buf_wi-mode no-lock where
     1275                 buf_wi-mode.mode-type = 'cd-IBS-TH':U
     1276             and buf_wi-mode.mode-id = buf_tt-layout-elem-rule.mode-id no-error.
     1277        if not available buf_wi-mode then do:
     1278          v-mess = substitute("Не найден режим работы &1", buf_tt-layout-elem-rule.mode-id).
     1279           run err-mess in this-procedure ( input-output v-mess).
     1280           undo _main, return error (if p-silent = yes then v-mess else '':U).
     1281        end.
     1282        find first buf_rule-by-call share-lock where
     1283                 buf_rule-by-call.call_id = buf_tt-layout-elem-rule.uniq-key-rec
     1284             and buf_rule-by-call.codex_id = buf_wi-mode.codex_id
     1285             and buf_rule-by-call.ruleset_id = buf_wi-mode.ruleset_id
     1286             and buf_rule-by-call.order_id = 0 no-error.
     1287        v-cmp = yes.
     1288        if not available buf_rule-by-call then do:
     1289          run rul/g-callid.p (
     1290                              input (if p-is-default = integer('0':U)
     1291                                     then 'layout-elem-rule':U
     1292                                     else 'layout-elem-rule':U + chr(44) + "minus")
     1293                             ,input buf_tt-layout-elem-rule.uniq-key-rec
     1294                             ,output v-call#-id).
     1295          create buf_rule-by-call.
     1296          assign
     1297          buf_rule-by-call.call_id = buf_tt-layout-elem-rule.uniq-key-rec
     1298          buf_rule-by-call.call#_id = v-call#-id
     1299          buf_rule-by-call.codex_id = buf_wi-mode.codex_id
     1300          buf_rule-by-call.ruleset_id = buf_wi-mode.ruleset_id
     1301          buf_rule-by-call.order_id = 0
     1302          .
     1303          run gen-key-rec in this-procedure ( input 'rule-by-call':U
     1304                                             ,input (buffer  buf_rule-by-call:handle)
     1305                                             ,output v-rbc-uniq-key-rec).
     1306          buf_rule-by-call.uniq-key-rec = v-rbc-uniq-key-rec.
     1307          v-cmp = no.
     1308        end.
     1309        else do:
     1310          buffer-compare buf_rule-by-call to buf_tt-rule-by-call
     1311          case-sensitive
     1312          save result in v-cmp.
     1313          v-call#-id = buf_rule-by-call.call#_id.
     1314        end.
     1315        if not v-cmp then do:
     1316          buffer-copy buf_tt-rule-by-call
     1317          except call_id call#_id codex_id ruleset_id uniq-key-rec
     1318          to buf_rule-by-call.
     1319        end.
     1320        v-cmp = yes.
     1321        find first buf_layout-elem-rule share-lock where
     1322                 buf_layout-elem-rule.layout-id = v-layout-id
     1323             and buf_layout-elem-rule.mode-id = buf_tt-layout-elem-rule.mode-id
     1324             and buf_layout-elem-rule.widget-id = buf_tt-layout-elem-rule.widget-id no-error.
     1325        if not available buf_layout-elem-rule then do:
     1326          create buf_layout-elem-rule.
     1327          assign
     1328          buf_layout-elem-rule.layout-id = v-layout-id
     1329          v-cmp = no.
     1330        end.
     1331        else do:
     1332           buffer-compare buf_layout-elem-rule to buf_tt-layout-elem-rule
     1333           case-sensitive
     1334           save result in v-cmp.
     1335        end.
     1336        if not v-cmp then do:
     1337           run  layouth_create-layout-elem-rule_h  in this-procedure (
     1338                                                           input (if new(buf_layout-elem-rule)
     1339                                                                  then 'ДОБАВЛЕНИЕ':U
     1340                                                                  else 'ИЗМЕНЕНИЕ':U)
     1341                                                         ,input buf_tt-layout-elem-rule.layout-id
     1342                                                         ,input buf_tt-layout-elem-rule.mode-id
     1343                                                         ,input buf_tt-layout-elem-rule.widget-id
     1344                                                         ,buffer buf_layout-elem-rule
     1345                                                         ,input v-chip-num).
     1346          buffer-copy buf_tt-layout-elem-rule
     1347          except layout-id cr-db-num
     1348          to buf_layout-elem-rule.
     1349        end.
     1350        for each buf_tt-rule-call-param where
     1351                 buf_tt-rule-call-param.call_id = buf_tt-rule-by-call.call_id
     1352             and buf_tt-rule-call-param.codex_id = buf_tt-rule-by-call.codex_id
     1353             and buf_tt-rule-call-param.ruleset_id = buf_tt-rule-by-call.ruleset_id
     1354             and buf_tt-rule-call-param.order_id = buf_tt-rule-by-call.order_id
     1355         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1356         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1357         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ):
     1358           v-cmp = yes.
     1359           find first buf_rule-call-param share-lock where
     1360                 buf_rule-call-param.call_id = buf_tt-rule-by-call.call_id
     1361             and buf_rule-call-param.codex_id = buf_tt-rule-by-call.codex_id
     1362             and buf_rule-call-param.ruleset_id = buf_tt-rule-by-call.ruleset_id
     1363             and buf_rule-call-param.order_id = buf_tt-rule-by-call.order_id
     1364             and buf_rule-call-param.param-name = buf_tt-rule-call-param.param-name
     1365             and buf_rule-call-param.p-index = buf_tt-rule-call-param.p-index no-error.
     1366         if not available(buf_rule-call-param) then do:
     1367          create buf_rule-call-param.
     1368          assign
     1369          buf_rule-call-param.call_id = buf_tt-rule-by-call.call_id
     1370          buf_rule-call-param.codex_id = buf_tt-rule-by-call.codex_id
     1371          buf_rule-call-param.ruleset_id = buf_tt-rule-by-call.ruleset_id
     1372          buf_rule-call-param.order_id = buf_tt-rule-by-call.order_id
     1373          buf_rule-call-param.param-name = buf_tt-rule-call-param.param-name
     1374          buf_rule-call-param.p-index = buf_tt-rule-call-param.p-index
     1375          buf_rule-call-param.call#_id = v-call#-id
     1376          v-cmp = no
     1377          .
     1378         end.
     1379         else do:
     1380            buffer-compare buf_rule-call-param to buf_tt-rule-call-param
     1381            case-sensitive
     1382            save result in v-cmp.
     1383         end.
     1384         if not v-cmp then do:
     1385           run  layouth_create-rule-call-param_h  in this-procedure (
     1386                                                           input (if new(buf_rule-call-param)
     1387                                                                  then 'ДОБАВЛЕНИЕ':U
     1388                                                                  else 'ИЗМЕНЕНИЕ':U)
     1389                                                         ,input buf_rule-call-param.call#_id
     1390                                                         ,input buf_tt-rule-call-param.codex_id
     1391                                                         ,input buf_tt-rule-call-param.ruleset_id
     1392                                                         ,input buf_tt-rule-call-param.order_id
     1393                                                         ,input buf_tt-rule-call-param.param-name
     1394                                                         ,input buf_tt-rule-call-param.p-index
     1395                                                         ,input buf_tt-rule-call-param.call_id
     1396                                                         ,buffer buf_rule-call-param
     1397                                                         ,input v-chip-num).
     1398           buffer-copy buf_tt-rule-call-param
     1399           except call_id call#_id codex_id ruleset_id order_id param-name p-index
     1400           to buf_rule-call-param.
     1401         end.
     1402       end.
     1403        for each buf_rule-call-param where
     1404                 buf_rule-call-param.call_id = buf_tt-rule-by-call.call_id
     1405             and buf_rule-call-param.codex_id = buf_tt-rule-by-call.codex_id
     1406             and buf_rule-call-param.ruleset_id = buf_tt-rule-by-call.ruleset_id
     1407             and buf_rule-call-param.order_id = buf_tt-rule-by-call.order_id
     1408         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1409         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1410         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ):
     1411           find first buf_tt-rule-call-param share-lock where
     1412                 buf_tt-rule-call-param.call_id = buf_tt-rule-by-call.call_id
     1413             and buf_tt-rule-call-param.codex_id = buf_tt-rule-by-call.codex_id
     1414             and buf_tt-rule-call-param.ruleset_id = buf_tt-rule-by-call.ruleset_id
     1415             and buf_tt-rule-call-param.order_id = buf_tt-rule-by-call.order_id
     1416             and buf_tt-rule-call-param.param-name = buf_rule-call-param.param-name
     1417             and buf_tt-rule-call-param.p-index = buf_rule-call-param.p-index no-error.
     1418         if not available(buf_tt-rule-call-param) then do:
     1419           run  layouth_create-rule-call-param_h  in this-procedure (
     1420                                                           input 'удаление':U
     1421                                                         ,input buf_rule-call-param.call#_id
     1422                                                         ,input buf_rule-call-param.codex_id
     1423                                                         ,input buf_rule-call-param.ruleset_id
     1424                                                         ,input buf_rule-call-param.order_id
     1425                                                         ,input buf_rule-call-param.param-name
     1426                                                         ,input buf_rule-call-param.p-index
     1427                                                         ,input buf_rule-call-param.call_id
     1428                                                         ,buffer buf_rule-call-param
     1429                                                         ,input v-chip-num).
     1430           delete buf_rule-call-param.
     1431         end.
     1432       end.
     1433     end.
     1434     for each buf_layout-elem-rule share-lock where
     1435             buf_layout-elem-rule.layout-id = v-layout-id
     1436     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1437     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1438     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1439     :
     1440        find first buf_tt-layout-elem-rule where
     1441                 buf_tt-layout-elem-rule.layout-id = buf_layout-elem-rule.layout-id
     1442             and buf_tt-layout-elem-rule.mode-id = buf_layout-elem-rule.mode-id
     1443             and buf_tt-layout-elem-rule.widget-id = buf_layout-elem-rule.widget-id no-error.
     1444       if not available buf_tt-layout-elem-rule then do:
     1445         find first buf_rule-by-call share-lock where
     1446                   buf_rule-by-call.call_id = buf_layout-elem-rule.uniq-key-rec no-error.
     1447         for each buf_rule-call-param where
     1448                   buf_rule-call-param.call_id = buf_layout-elem-rule.uniq-key-rec
     1449           on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1450           on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1451           on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ):
     1452           run  layouth_create-rule-call-param_h  in this-procedure (
     1453                                                           input 'удаление':U
     1454                                                         ,input buf_rule-call-param.call#_id
     1455                                                         ,input buf_rule-call-param.codex_id
     1456                                                         ,input buf_rule-call-param.ruleset_id
     1457                                                         ,input buf_rule-call-param.order_id
     1458                                                         ,input buf_rule-call-param.param-name
     1459                                                         ,input buf_rule-call-param.p-index
     1460                                                         ,input buf_rule-call-param.call_id
     1461                                                         ,buffer buf_rule-call-param
     1462                                                         ,input v-chip-num).
     1463           delete buf_rule-call-param.
     1464         end.
     1465         if available buf_rule-by-call then do:
     1466           delete buf_rule-by-call.
     1467         end.
     1468         run  layouth_create-layout-elem-rule_h  in this-procedure (
     1469                                                         input 'удаление':U
     1470                                                       ,input buf_layout-elem-rule.layout-id
     1471                                                       ,input buf_layout-elem-rule.mode-id
     1472                                                       ,input buf_layout-elem-rule.widget-id
     1473                                                       ,buffer buf_layout-elem-rule
     1474                                                       ,input v-chip-num).
     1475         delete buf_layout-elem-rule.
     1476       end.
     1477     end.
     1478     find first buf_layout-elem-rule no-lock where
     1479              buf_layout-elem-rule.layout-id = buf_layout.layout-id
     1480          and buf_layout-elem-rule.sts <> integer('0':U) no-error.
     1481     if not available buf_layout-elem-rule
     1482     and buf_layout.sts <> integer('99':U)
     1483     then do:
     1484       buf_layout.sts = integer('0':U).
     1485     end.
     1486     assign
     1487     buf_layout.whole-send-news = 1
     1488     .
     1489     release buf_layout no-error.
     1490     if error-status:error then do:
     1491       v-mess = substitute("Ошибка при сохранении шапки раскладки:&1&2&1&3"
     1492                            , chr(10)
     1493                            , error-status:get-message(1)
     1494                            , return-value ).
     1495       run err-mess in this-procedure ( input-output v-mess).
     1496       undo _main, return error (if p-silent = yes then v-mess else '':U).
     1497     end.
     1498   end.
     1499   PROCEDURE err-mess:
     1500     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1501     CASE p-silent:
     1502       when yes then do:
     1503         assign
     1504         p-mess = substitute("Раскладка: тип &1 id &2 для устройства &3:&4&5"
     1505                            , p-layout-type
     1506                            , p-layout-id
     1507                            , p-device-type
     1508                            , chr(10)
     1509                            , p-mess)
     1510         .
     1511       end.
     1512       when no then do:
     1513         message
     1514         p-mess
     1515         view-as alert-box error .
     1516       end.
     1517     end.
     1518   END PROCEDURE.
