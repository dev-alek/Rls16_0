        1   DEFINE BUFFER locked_hist-nws-option FOR ub.hist-nws-option.
        2   DEFINE TEMP-TABLE tt-hist-nws-option NO-UNDO LIKE ub.hist-nws-option
        3          field hist-to-nws-is-on as logical
        4          field nws-to-hist-is-on as logical
        5          field get-hist-from-nws-is-on as logical
        6          field hist-to-nws-can as logical
        7          field nws-to-hist-can as logical
        8          field get-hist-from-nws-can as logical.
        9   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       10   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
       11   DEFINE INPUT PARAMETER p-db-num AS integer NO-UNDO.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Опции записи истории и маршрутизации для БД".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   define new global shared variable g#language as character no-undo .
      323   if g#language <> '' and g#language <> 'rus':U then do:
      324     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      325   end.
      326   define new global shared variable g#library  as handle no-undo .
      327   define new global shared variable g#library2 as handle no-undo .
      328   define   shared variable g#auto as logical no-undo.
      329   define   shared variable g#news as logical no-undo.
      330   define   shared variable g#oxml as logical no-undo.
      331   define   shared variable g#esys as logical no-undo.
      332   define   shared variable g#news-source-db as integer no-undo.
      333   define   shared variable g#esys-source-esys as integer no-undo.
      334   define   shared variable g#db-num as integer   no-undo .
      335   define   shared variable g#userid as character no-undo .
      336   define   shared variable g#passwd as character no-undo .
      337   procedure proc-alt-shift-f2:
      338     if not ibs.th.gbl.gbl-var:rcode
      339   then
      340     run gbl\inidebug.p .
      341   end.
      342   procedure proc-alt-shift-f3:
      343     run gbl/prvssinf.p
      344       ( input this-procedure
      345       ) .
      346   end.
      347   define variable v-inform-launched as logical no-undo initial false .
      348   procedure proc-alt-shift-f4:
      349     define variable v-action as character no-undo .
      350     if v-inform-launched = false then do:
      351       assign
      352         v-inform-launched = true
      353       .
      354       run gbl/d-inform.w
      355         (  input self
      356         ,  input this-procedure
      357         , output v-action
      358         ) no-error .
      359       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      360       assign
      361         v-inform-launched = false
      362       .
      363     end.
      364   end.
      365   procedure proc-alt-f1:
      366     run gbl/corrhelp.p
      367       (input this-procedure
      368       ) .
      369   end .
      370   on alt-shift-f2 anywhere do:
      371     run proc-alt-shift-f2.
      372   end.
      373   on alt-shift-f3 anywhere do:
      374     run proc-alt-shift-f3 in this-procedure .
      375   end.
      376   on alt-shift-f4 anywhere do:
      377     run proc-alt-shift-f4 in this-procedure.
      378   end.
      379   on alt-f1 anywhere do:
      380     run proc-alt-f1 in this-procedure .
      381   end.
      382   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   procedure cur-time :
      384      define output parameter p-today as date      no-undo .
      385      define output parameter p-time  as integer   no-undo .
      386     do
      387     on error undo, return error
      388     :
      389       define variable v-date1 as date      no-undo .
      390       define variable v-date2 as date      no-undo .
      391       define variable v-time  as integer   no-undo .
      392       assign
      393         v-date1 = today
      394         v-time  = time
      395         v-date2 = today
      396       .
      397       if v-date1 <> v-date2
      398       then do:
      399         assign
      400           v-date1 = today
      401           v-time  = v-time
      402         .
      403       end.
      404       assign
      405         p-today = v-date1
      406         p-time  = v-time
      407       .
      408     end.
      409   end.
      410   function cur-time-date returns character
      411   :
      412     return string(today, '99/99/9999':U) .
      413   end.
      414   function cur-time-mjd returns decimal
      415   :
      416     define variable v-date as date      no-undo .
      417     define variable v-time as integer   no-undo .
      418     run cur-time in this-procedure
      419       (output v-date
      420       ,output v-time
      421       ) .
      422     return integer(v-date) - 2400002 + (v-time / 86400) .
      423   end.
      424   function cur-time-get-ending-index returns integer
      425   (input p-number as integer
      426   )
      427   :
      428     if p-number < 0
      429     or p-number = ?
      430     then do:
      431       return 1 .
      432     end.
      433     define variable v-rest as integer   no-undo .
      434     assign
      435       p-number = p-number modulo 100
      436     .
      437     if p-number < 20
      438     then do:
      439       assign
      440         v-rest = p-number
      441       .
      442     end.
      443     else do:
      444       assign
      445         v-rest = p-number modulo 10
      446       .
      447     end.
      448     case v-rest :
      449       when 1
      450       then do:
      451         return 2 .
      452       end.
      453       when 2 or
      454       when 3 or
      455       when 4
      456       then do:
      457         return 3 .
      458       end.
      459       otherwise do:
      460         return 1 .
      461       end.
      462     end case .
      463   end.
      464   procedure cur-time-mjd-to-date :
      465      define input  parameter i-mjd-diff as decimal no-undo.
      466      define output parameter o-Date     as date    no-undo.
      467      define output parameter o-Time     as integer no-undo.
      468      define variable v-day-number as integer   no-undo .
      469      if    i-mjd-diff < 0
      470         or i-mjd-diff = ?
      471      then do:
      472         return "?" .
      473      end.
      474      assign
      475         v-day-number = truncate(i-mjd-diff,0).
      476         o-Date = date(v-day-number + 2400002).
      477         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      478     .
      479   end.
      480   function cur-time-mjd-to-string returns character
      481   (input p-mjd-diff as decimal
      482   )
      483   :
      484     define variable v-day-number as integer   no-undo .
      485     define variable v-seconds    as integer   no-undo .
      486     define variable v-hour       as integer   no-undo .
      487     define variable v-min        as integer   no-undo .
      488     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      489     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      490     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      491     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      492     if p-mjd-diff < 0
      493     or p-mjd-diff = ?
      494     then do:
      495       return "?" .
      496     end.
      497     assign
      498       v-day-number = integer(truncate(p-mjd-diff,0))
      499       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      500     .
      501     if v-seconds > 86400
      502     then do:
      503       assign
      504         v-seconds = 86400 - 1
      505       .
      506     end.
      507     if v-seconds < 0
      508     then do:
      509       assign
      510         v-seconds = 0
      511       .
      512     end.
      513     assign
      514       v-hour = truncate(v-seconds / 3600, 0)
      515     .
      516     assign
      517       v-seconds = v-seconds modulo 3600
      518     .
      519     assign
      520       v-min = truncate(v-seconds / 60, 0)
      521     .
      522     assign
      523       v-seconds = v-seconds modulo 60
      524     .
      525     return
      526         (if v-day-number <> 0
      527           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      528           else ""
      529         )
      530       + (if v-day-number <> 0 or v-hour <> 0
      531           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      532           else ""
      533         )
      534       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      535           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      536           else ""
      537         )
      538       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      539       .
      540   end.
      541   function cur-time-string returns character
      542   :
      543     define variable v-date as date      no-undo .
      544     define variable v-time as integer   no-undo .
      545     run cur-time in this-procedure
      546       (output v-date
      547       ,output v-time
      548       ) .
      549     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      550   end.
      551   function cur-time-string-sec returns character
      552   :
      553     define variable v-date as date      no-undo .
      554     define variable v-time as integer   no-undo .
      555     run cur-time in this-procedure
      556       (output v-date
      557       ,output v-time
      558       ) .
      559     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      560   end.
      561   function cur-time-custom  returns character
      562   (input p-prefix as character
      563   ,input p-date-format as character
      564   ,input p-delimiter as character
      565   ,input p-time-format as character
      566   ,input p-suffix as character
      567   )
      568   :
      569     define variable v-date as date      no-undo .
      570     define variable v-time as integer   no-undo .
      571     run cur-time in this-procedure
      572       (output v-date
      573       ,output v-time
      574       ) .
      575     return
      576       p-prefix
      577       + string(v-date, p-date-format)
      578       + p-delimiter
      579       + string(v-time, p-time-format)
      580       + p-suffix
      581       .
      582   end.
      583   function cur-time-print  returns character
      584   :
      585     define variable v-date as date      no-undo .
      586     define variable v-time as integer   no-undo .
      587     run cur-time in this-procedure
      588       (output v-date
      589       ,output v-time
      590       ) .
      591     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      592   end.
      593   function cur-time-datetime returns datetime
      594   :
      595     define variable v-char as character no-undo .
      596     define variable v-datetime as datetime no-undo .
      597     v-char = cur-time-string().
      598     v-datetime = datetime(v-char).
      599     return  v-datetime.
      600   end.
      601   function cur-time-string-msec returns character
      602   :
      603     define variable v-date as datetime  no-undo .
      604     v-date = now.
      605     return string(v-date) .
      606   end.
      607   define variable v-col as widget-handle extent 3.
      608   DEFINE VARIABLE v-groups AS CHARACTER NO-UNDO.
      609   DEFINE VARIABLE v-subject-group AS CHARACTER NO-UNDO.
      610   DEFINE VARIABLE v-col-tbl-name AS WIDGET-HANDLE NO-UNDO.
      611   FUNCTION get-hn-group-label RETURNS CHARACTER
      612     ( INPUT p-subject-group AS CHARACTER )  FORWARD.
      613   FUNCTION get-hn-label RETURNS CHARACTER
      614     ( INPUT p-hn-option AS integer )  FORWARD.
      615   DEFINE BUTTON b-copyrdb
      616        LABEL "&Копир.на все УБД"
      617        SIZE 20 BY 1.
      618   DEFINE BUTTON B-exit AUTO-GO
      619        LABEL "&Ввод"
      620        SIZE 10 BY 1
      621        BGCOLOR 8 .
      622   DEFINE BUTTON B-Help
      623        LABEL "Помо&щь"
      624        SIZE 3 BY 1
      625        BGCOLOR 8 .
      626   DEFINE BUTTON b-hist
      627        LABEL "Ис&тория"
      628        SIZE 3 BY 1.
      629   DEFINE BUTTON b-quit AUTO-END-KEY
      630        LABEL "&Отмена"
      631        SIZE 10 BY 1
      632        BGCOLOR 8 .
      633   DEFINE VARIABLE CB-subject-group AS CHARACTER FORMAT "X(256)":U
      634        LABEL "Группы данных"
      635        VIEW-AS COMBO-BOX INNER-LINES 5
      636        LIST-ITEMS "Item 1"
      637        DROP-DOWN-LIST
      638        SIZE 32 BY 1 NO-UNDO.
      639   DEFINE VARIABLE last-modify AS CHARACTER FORMAT "X(256)":U
      640        LABEL "Дата и время посл. обновления"
      641        VIEW-AS FILL-IN
      642        SIZE 21 BY 1
      643        FGCOLOR 4  NO-UNDO.
      644   DEFINE QUERY BR-option FOR
      645         tt-hist-nws-option SCROLLING.
      646   DEFINE BROWSE BR-option
      647     QUERY BR-option DISPLAY
      648         get-hn-group-label(tt-hist-nws-option.subject-group) FORMAT "X(40)" COLUMN-LABEL "Группа данных"
      649   tt-hist-nws-option.option-descr FORMAT "X(40)" COLUMN-LABEL "Сущность"
      650   get-hn-label(tt-hist-nws-option.hist-to-nws) FORMAT "X(15)" COLUMN-LABEL "Пересылка ист.!в другие БД"
      651   tt-hist-nws-option.hist-to-nws-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      652   get-hn-label(tt-hist-nws-option.nws-to-hist) FORMAT "X(15)" COLUMN-LABEL "Создание ист.!при приеме!по СПН"
      653   tt-hist-nws-option.nws-to-hist-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      654   get-hn-label(tt-hist-nws-option.get-hist-from-nws) FORMAT "X(15)" COLUMN-LABEL "Прием истории!из другой!УБД"
      655   tt-hist-nws-option.get-hist-from-nws-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      656   ENABLE
      657   tt-hist-nws-option.hist-to-nws-is-on
      658   tt-hist-nws-option.nws-to-hist-is-on
      659   tt-hist-nws-option.get-hist-from-nws-is-on
      660       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.37 FIT-LAST-COLUMN.
      661   DEFINE FRAME Dialog-Frame
      662        B-exit AT ROW 1 COL 1
      663        b-quit AT ROW 1 COL 11
      664        CB-subject-group AT ROW 1 COL 35 COLON-ALIGNED WIDGET-ID 4
      665        b-copyrdb AT ROW 1 COL 69
      666        b-hist AT ROW 1 COL 92 WIDGET-ID 8
      667        B-Help AT ROW 1 COL 95
      668        last-modify AT ROW 2.07 COL 74 COLON-ALIGNED WIDGET-ID 6
      669        BR-option AT ROW 3.27 COL 1
      670        SPACE(0.24) SKIP(0.00)
      671       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      672            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      673            TITLE "Опции записи истории и маршрутизации для БД"
      674            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      675   ASSIGN
      676          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      677          FRAME Dialog-Frame:HIDDEN           = TRUE.
      678   ASSIGN
      679          CB-subject-group:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      680   ASSIGN
      681          last-modify:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      682   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      683   DO:
      684     APPLY "END-ERROR":U TO SELF.
      685   END.
      686   ON CHOOSE OF b-copyrdb IN FRAME Dialog-Frame
      687   DO:
      688     IF NOT AVAILABLE tt-hist-nws-option THEN RETURN NO-APPLY.
      689     RUN proc-copy-udb IN THIS-PROCEDURE ( BUFFER tt-hist-nws-option) NO-ERROR.
      690     if error-status:error then do:
      691       message
      692       error-status:get-message(1)
      693       substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      694       view-as alert-box error .
      695       return no-apply.
      696     end.
      697   END.
      698   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      699   DO:
      700     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      701     if error-status:error then do:
      702       message
      703       error-status:get-message(1)
      704       substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      705       view-as alert-box error .
      706       return no-apply.
      707     end.
      708   END.
      709   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
      710   DO:
      711   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      712     IF NOT AVAILABLE tt-hist-nws-option THEN RETURN NO-APPLY.
      713     IF tt-hist-nws-option.table-name = '':U  THEN DO:
      714        run ref/hstcnws.w ( INPUT parparentproc
      715                           ,INPUT "":U
      716                           ,INPUT "subject-group-db"
      717                           ,INPUT tt-hist-nws-option.db-num
      718                           ,INPUT tt-hist-nws-option.subject-group
      719                           ,INPUT '':U
      720                           ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
      721     END.
      722     ELSE DO:
      723         run ref/hstcnws.w ( INPUT parparentproc
      724                            ,INPUT "":U
      725                            ,INPUT "one-db"
      726                            ,INPUT tt-hist-nws-option.db-num
      727                            ,INPUT '':U
      728                            ,INPUT tt-hist-nws-option.table-name
      729                            ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
      730     END.
      731     APPLY "ENTRY" TO br-option.
      732   END.
      733   ON VALUE-CHANGED OF CB-subject-group IN FRAME Dialog-Frame
      734   DO:
      735    RUN switch-subject IN THIS-PROCEDURE .
      736    RUN Openbr IN THIS-PROCEDURE.
      737   END.
      738   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      739   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      740   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   on help of frame Dialog-Frame
      742   do:
      743     run gbl/app_help.p
      744       (input this-procedure :file-name
      745       ,input ''
      746       ,input ?
      747       ) no-error.
      748     if error-status :error then do:
      749       message
      750         "Ошибка при вызове помощи"
      751         error-status :get-message(1)
      752         view-as alert-box .
      753     end.
      754   end.
      755   run minbtn-set in this-procedure .
      756   on choose of b-help in frame Dialog-Frame
      757   do:
      758     apply "help":u to frame Dialog-Frame .
      759   end.
      760   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   procedure minbtn-set :
      762       do
      763           on error undo, return error return-value
      764           :
      765           define variable ii              as integer       no-undo .
      766           define variable fh              as widget-handle no-undo .
      767           define variable hh              as widget-handle no-undo .
      768           define variable v-h             as handle        extent 4 no-undo .
      769           define variable v-name-button   as character     no-undo .
      770           define variable v-help-old-x    as decimal       no-undo .
      771           define variable v-help-old-y    as decimal       no-undo .
      772           define variable v-help-old-size as decimal       no-undo .
      773           define variable v-frame-width   as decimal       no-undo .
      774           define variable jj              as integer       no-undo .
      775           do
      776               on error undo, return error
      777               :
      778               assign
      779                   v-frame-width = frame Dialog-Frame:width - 0.3
      780                   fh            = frame Dialog-Frame:first-child
      781                   hh            = fh:first-child
      782                   ii            = 1
      783                   .
      784               do while valid-handle(hh):
      785                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      786                   do:
      787                       case lc(hh:name) :
      788                           when "b-help" then
      789                               do:
      790                                   hh:load-image-up("cmp/b-help.bmp":u) .
      791                                   hh:load-image-down("cmp/b-help.bmp":u) .
      792                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      793                                   hh:TOOLTIP = "Помощь" .
      794                                   v-help-old-x = hh:column .
      795                                   v-help-old-y = hh:row    .
      796                                   v-help-old-size = hh:width .
      797                                   hh:width-chars = 2.5 .
      798                               end.
      799                           when "b-print" then
      800                               do:
      801                                   hh:load-image("cmp/b-print.bmp":u) .
      802                                   hh:TOOLTIP = "Печать" .
      803                                   v-h[ii] = hh:handle .
      804                                   ii = ii + 1 .
      805                                   hh:width-chars = 3 .
      806                               end.
      807                           when "b-history" or
      808                           when "b-hist" then
      809                               do:
      810                                   hh:load-image("cmp/b-hist.bmp":u) .
      811                                   hh:TOOLTIP = "История" .
      812                                   v-h[ii] = hh:handle .
      813                                   ii = ii + 1 .
      814                                   hh:width-chars = 3 .
      815                               end.
      816                           when "b-sch" then
      817                               do:
      818                                   hh:load-image("cmp/b-sch.bmp":u) .
      819                                   hh:TOOLTIP = "Установка Фильтра" .
      820                                   v-h[ii] = hh:handle .
      821                                   ii = ii + 1 .
      822                                   hh:width-chars = 3 .
      823                               end.
      824                           when "b-hist-user" then
      825                               do:
      826                                   hh:load-image("cmp/b-hist.bmp":u) .
      827                                   hh:TOOLTIP = "История пользователя" .
      828                                   ii = ii + 1 .
      829                               end.
      830                       end case.
      831                   end.
      832                   hh = hh:next-sibling.
      833               end.
      834               b-help:column = v-frame-width - b-help:width-chars.
      835               jj = 0.
      836               repeat ii = 4 to 1 by -1 :
      837                   if valid-handle (v-h[ii] ) then
      838                   do:
      839                       jj  = jj + 1 .
      840                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      841                       v-h[ii]:row    = v-help-old-y .
      842                   end.
      843               end.
      844           end.
      845       end.
      846   end procedure.
      847   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      848   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      849   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      850   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      851   define variable v-diasize-current-frame-width  as decimal   no-undo .
      852   define variable v-diasize-current-frame-height as decimal   no-undo .
      853   define variable v-diasize-change-size          as logical   no-undo .
      854   define variable v-diasize-resize-button        as handle    no-undo .
      855   define variable v-diasize-wndmax               as logical   no-undo .
      856   define variable v-diasize-wndstore             as logical   no-undo .
      857   define variable v-diasize-proc-name            as character no-undo .
      858   define variable v-diasize-browse-handle        as handle    no-undo .
      859   define variable v-diasize-browse-number        as integer   no-undo .
      860   define variable v-diasize-need-full-display    as logical   no-undo init false .
      861   define temp-table temp-diasize-handle no-undo
      862     field handle-value  as handle
      863     field save-position as decimal
      864     index xpk is primary unique handle-value
      865     .
      866   define temp-table temp-browse-handle no-undo
      867     field browse-type   as character
      868     field browse-number as integer
      869     field browse-handle as handle
      870     field original-size as decimal
      871     index xpk is primary unique browse-type browse-number
      872     index xie browse-type browse-handle
      873   .
      874   procedure diasize_change-height :
      875     define input  parameter p-change-value  as decimal   no-undo .
      876     define input  parameter p-move-resize   as logical   no-undo .
      877     define variable v-field-group-handle    as handle    no-undo .
      878     define variable v-object-handle         as handle    no-undo .
      879     define variable v-frame-height          as decimal   no-undo .
      880     define variable v-frame-virtual-height  as decimal   no-undo .
      881     define variable v-browse-height         as decimal   no-undo .
      882     define variable v-window-height         as decimal   no-undo .
      883     define variable v-window-virtual-height as decimal   no-undo .
      884     define variable v-change-sign           as integer   no-undo .
      885     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      886     define buffer buf_temp-browse-handle  for temp-browse-handle .
      887     if p-change-value > 0
      888     then do:
      889       if frame Dialog-Frame :height + p-change-value
      890           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      891       then do:
      892         assign
      893           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      894                           - (frame Dialog-Frame :height-chars)
      895         .
      896         if p-change-value <= 0
      897         then do:
      898           run diasize_position-resize-button in this-procedure .
      899           return .
      900         end.
      901       end.
      902     end.
      903     if p-change-value < 0
      904     then do:
      905       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      906       then do:
      907         assign
      908           p-change-value = v-diasize-orig-frame-height
      909                          - (frame Dialog-Frame :height-chars)
      910         .
      911         if p-change-value >= 0
      912         then do:
      913           run diasize_position-resize-button in this-procedure .
      914           return .
      915         end.
      916       end.
      917     end.
      918     if p-change-value >= 0
      919     then do:
      920       assign
      921         v-change-sign = 1
      922       .
      923     end.
      924     else do:
      925       assign
      926         v-change-sign = -1
      927       .
      928     end.
      929     assign
      930       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      931     .
      932     if p-change-value = 0
      933     then do:
      934       run diasize_position-resize-button in this-procedure .
      935       return .
      936     end.
      937     move_block:
      938     do
      939     on error undo move_block, retry move_block
      940     :
      941       if retry
      942       then do:
      943         do
      944         on error undo move_block, leave move_block
      945         :
      946           if p-change-value > 0
      947           then do:
      948             for each buf_temp-diasize-handle
      949             on error undo, next
      950             :
      951               assign
      952                 v-object-handle = buf_temp-diasize-handle.handle-value
      953               .
      954               if v-object-handle <> v-diasize-resize-button
      955               then do:
      956                 assign
      957                   v-object-handle :row = buf_temp-diasize-handle.save-position
      958                 .
      959               end.
      960             end.
      961             assign
      962               v-diasize-browse-handle :height = v-browse-height
      963             .
      964             for each buf_temp-browse-handle
      965               where buf_temp-browse-handle.browse-type = 'height':u
      966             on error undo, next
      967             :
      968               assign
      969                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      970               .
      971             end.
      972             assign
      973               frame Dialog-Frame :height = v-frame-height
      974             .
      975             if frame Dialog-Frame :scrollable = true
      976             then do:
      977               assign
      978                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      979               .
      980             end.
      981             run diasize_position-resize-button in this-procedure .
      982           end.
      983           else do:
      984             if frame Dialog-Frame :scrollable = true
      985             then do:
      986               assign
      987                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      988               .
      989             end.
      990             assign
      991               frame Dialog-Frame :height = v-frame-height
      992             .
      993             assign
      994               v-diasize-browse-handle :height = v-browse-height
      995             .
      996             for each buf_temp-browse-handle
      997               where buf_temp-browse-handle.browse-type = 'height':u
      998             on error undo, next
      999             :
     1000               assign
     1001                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1002               .
     1003             end.
     1004             for each buf_temp-diasize-handle
     1005             on error undo, next
     1006             :
     1007               assign
     1008                 v-object-handle = buf_temp-diasize-handle.handle-value
     1009               .
     1010               if v-object-handle <> v-diasize-resize-button
     1011               then do:
     1012                 assign
     1013                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1014                 .
     1015               end.
     1016             end.
     1017             run diasize_position-resize-button in this-procedure .
     1018           end.
     1019           assign
     1020             v-diasize-change-size = false
     1021           .
     1022           leave move_block .
     1023         end.
     1024       end.
     1025       assign
     1026         v-diasize-need-full-display = true
     1027       .
     1028       if v-diasize-change-size = false
     1029       then do:
     1030         assign
     1031           v-diasize-change-size = true
     1032         .
     1033       end.
     1034       else do:
     1035         return .
     1036       end.
     1037       assign
     1038         v-frame-height = frame Dialog-Frame :height
     1039         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1040         v-browse-height = v-diasize-browse-handle :height
     1041       .
     1042       for each buf_temp-browse-handle
     1043         where buf_temp-browse-handle.browse-type = 'height':u
     1044       :
     1045         assign
     1046           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1047         .
     1048       end.
     1049       for each buf_temp-diasize-handle
     1050       :
     1051         delete buf_temp-diasize-handle .
     1052       end.
     1053       assign
     1054         v-field-group-handle = frame Dialog-Frame :first-child
     1055       .
     1056       do while valid-handle(v-field-group-handle)
     1057       :
     1058         assign
     1059           v-object-handle = v-field-group-handle :first-child
     1060         .
     1061         do while valid-handle(v-object-handle)
     1062         :
     1063           if  v-object-handle <> v-diasize-browse-handle :handle
     1064           and can-query(v-object-handle, "row")
     1065           and can-query(v-object-handle, "height")
     1066           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1067           then do:
     1068             find first buf_temp-browse-handle
     1069               where buf_temp-browse-handle.browse-type   = 'height':u
     1070                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1071               no-error .
     1072             if available buf_temp-browse-handle
     1073             then do:
     1074             end.
     1075             else do:
     1076               create buf_temp-diasize-handle .
     1077               assign
     1078                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1079                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1080               .
     1081             end.
     1082           end.
     1083           assign
     1084             v-object-handle = v-object-handle :next-sibling
     1085           .
     1086         end.
     1087         assign
     1088           v-field-group-handle = v-field-group-handle :next-sibling
     1089         .
     1090       end.
     1091       do with frame Dialog-Frame
     1092       :
     1093         hide v-diasize-resize-button .
     1094         assign
     1095           v-diasize-resize-button :row    = 1
     1096           v-diasize-resize-button :column = 1
     1097         .
     1098       end.
     1099       if p-change-value > 0
     1100       then do:
     1101         if frame Dialog-Frame :scrollable = true
     1102         then do:
     1103           assign
     1104             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1105             no-error .
     1106           if error-status :error
     1107           or error-status :get-message(1) <> ""
     1108           then do:
     1109             undo move_block, retry move_block .
     1110           end.
     1111         end.
     1112         assign
     1113           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1114           no-error .
     1115         if error-status :error
     1116         or error-status :get-message(1) <> ""
     1117         then do:
     1118           undo move_block, retry move_block .
     1119         end.
     1120         assign
     1121           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1122           no-error .
     1123         if error-status :error
     1124         or error-status :get-message(1) <> ""
     1125         then do:
     1126           undo move_block, retry move_block .
     1127         end.
     1128         for each buf_temp-browse-handle
     1129           where buf_temp-browse-handle.browse-type = 'height':u
     1130         on error undo move_block, retry move_block
     1131         :
     1132           assign
     1133             buf_temp-browse-handle.browse-handle :height
     1134               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1135             no-error .
     1136           if error-status :error
     1137           or error-status :get-message(1) <> ""
     1138           then do:
     1139             undo move_block, retry move_block .
     1140           end.
     1141         end.
     1142         for each buf_temp-diasize-handle
     1143         on error undo move_block, retry move_block
     1144         :
     1145           assign
     1146             v-object-handle = buf_temp-diasize-handle.handle-value
     1147           .
     1148           if v-object-handle <> v-diasize-resize-button
     1149           then do:
     1150             assign
     1151               v-object-handle :row = v-object-handle :row + p-change-value
     1152               no-error .
     1153             if error-status :error
     1154             or error-status :get-message(1) <> ""
     1155             then do:
     1156               undo move_block, retry move_block .
     1157             end.
     1158           end.
     1159         end.
     1160       end.
     1161       else do:
     1162         for each buf_temp-diasize-handle
     1163         on error undo move_block, retry move_block
     1164         :
     1165           assign
     1166             v-object-handle = buf_temp-diasize-handle.handle-value
     1167           .
     1168           if v-object-handle <> v-diasize-resize-button
     1169           then do:
     1170             assign
     1171               v-object-handle :row = v-object-handle :row + p-change-value
     1172               no-error .
     1173             if error-status :error
     1174             or error-status :get-message(1) <> ""
     1175             then do:
     1176               undo move_block, retry move_block .
     1177             end.
     1178           end.
     1179         end.
     1180         assign
     1181           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1182           no-error .
     1183         if error-status :error
     1184         or error-status :get-message(1) <> ""
     1185         then do:
     1186           undo move_block, retry move_block .
     1187         end.
     1188         for each buf_temp-browse-handle
     1189           where buf_temp-browse-handle.browse-type = 'height':u
     1190         on error undo move_block, retry move_block
     1191         :
     1192           assign
     1193             buf_temp-browse-handle.browse-handle :height
     1194               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1195             no-error .
     1196           if error-status :error
     1197           or error-status :get-message(1) <> ""
     1198           then do:
     1199             undo move_block, retry move_block .
     1200           end.
     1201         end.
     1202         assign
     1203           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1204           no-error .
     1205         if error-status :error
     1206         or error-status :get-message(1) <> ""
     1207         then do:
     1208           undo move_block, retry move_block .
     1209         end.
     1210         if frame Dialog-Frame :scrollable = true
     1211         then do:
     1212           assign
     1213             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1214             no-error .
     1215           if error-status :error
     1216           or error-status :get-message(1) <> ""
     1217           then do:
     1218             undo move_block, retry move_block .
     1219           end.
     1220         end.
     1221       end.
     1222       if p-move-resize = true
     1223       then do:
     1224         run diasize_position-resize-button in this-procedure .
     1225       end.
     1226       if v-diasize-wndstore = true
     1227       then do:
     1228         if connected("ub") = true
     1229         then do:
     1230           define variable v-cntxt-db-num        as integer   no-undo .
     1231           define variable v-cntxt-userid        as character no-undo .
     1232           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1233                                             , OUTPUT v-cntxt-userid
     1234                                             ) .
     1235           run gbl/wndsizew.p
     1236             (input  v-cntxt-db-num
     1237             ,input  v-cntxt-userid
     1238             ,input  v-diasize-proc-name
     1239             ,input  'height':u
     1240             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1241             ) .
     1242         end.
     1243       end.
     1244     end.
     1245     assign
     1246       v-diasize-change-size = false
     1247     .
     1248   end procedure.
     1249   procedure diasize_set-height :
     1250     define input  parameter p-new-height  as decimal   no-undo .
     1251     define input  parameter p-move-resize as logical   no-undo .
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       run diasize_change-height in this-procedure
     1256         (input  (p-new-height - frame Dialog-Frame :height)
     1257         ,input  p-move-resize
     1258         ) .
     1259     end.
     1260   end procedure.
     1261   procedure diasize_change-width :
     1262     define input  parameter p-change-value as decimal   no-undo .
     1263     define input  parameter p-move-resize  as logical   no-undo .
     1264     define variable v-field-group-handle   as handle    no-undo .
     1265     define variable v-object-handle        as handle    no-undo .
     1266     define variable v-frame-width          as decimal   no-undo .
     1267     define variable v-frame-virtual-width  as decimal   no-undo .
     1268     define variable v-browse-width         as decimal   no-undo .
     1269     define variable v-window-width         as decimal   no-undo .
     1270     define variable v-window-virtual-width as decimal   no-undo .
     1271     define variable v-change-sign          as integer   no-undo .
     1272     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1273     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1274     if p-change-value > 0
     1275     then do:
     1276       if frame Dialog-Frame :width + p-change-value >
     1277           session :width-chars
     1278       then do:
     1279         assign
     1280           p-change-value = session :width-chars - frame Dialog-Frame :width
     1281         .
     1282         if p-change-value <= 0
     1283         then do:
     1284           run diasize_position-resize-button in this-procedure .
     1285           return .
     1286         end.
     1287       end.
     1288     end.
     1289     if p-change-value < 0
     1290     then do:
     1291       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1292       then do:
     1293         assign
     1294           p-change-value = v-diasize-orig-frame-width
     1295                          - frame Dialog-Frame :width
     1296         .
     1297         if p-change-value >= 0
     1298         then do:
     1299           run diasize_position-resize-button in this-procedure .
     1300           return .
     1301         end.
     1302       end.
     1303     end.
     1304     if p-change-value >= 0
     1305     then do:
     1306       assign
     1307         v-change-sign = 1
     1308       .
     1309     end.
     1310     else do:
     1311       assign
     1312         v-change-sign = -1
     1313       .
     1314     end.
     1315     assign
     1316       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1317     .
     1318     if p-change-value = 0
     1319     then do:
     1320       run diasize_position-resize-button in this-procedure .
     1321       return .
     1322     end.
     1323     move_block:
     1324     do
     1325     on error undo move_block, leave move_block
     1326     :
     1327       if retry
     1328       then do:
     1329         do
     1330         on error undo move_block, leave move_block
     1331         :
     1332           if p-change-value > 0
     1333           then do:
     1334             for each buf_temp-diasize-handle
     1335             on error undo, next
     1336             :
     1337               assign
     1338                 v-object-handle = buf_temp-diasize-handle.handle-value
     1339               .
     1340               if v-object-handle <> v-diasize-resize-button
     1341               then do:
     1342                 assign
     1343                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1344                 .
     1345               end.
     1346             end.
     1347             assign
     1348               v-diasize-browse-handle :width = v-browse-width
     1349             .
     1350             for each buf_temp-browse-handle
     1351               where buf_temp-browse-handle.browse-type = 'width':u
     1352             on error undo, next
     1353             :
     1354               assign
     1355                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1356               .
     1357             end.
     1358             assign
     1359               frame Dialog-Frame :width = v-frame-width
     1360             .
     1361             if frame Dialog-Frame :scrollable = true
     1362             then do:
     1363               assign
     1364                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1365               .
     1366             end.
     1367             run diasize_position-resize-button in this-procedure .
     1368           end.
     1369           else do:
     1370             if frame Dialog-Frame :scrollable = true
     1371             then do:
     1372               assign
     1373                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1374               .
     1375             end.
     1376             assign
     1377               frame Dialog-Frame :width = v-frame-width
     1378             .
     1379             for each buf_temp-browse-handle
     1380               where buf_temp-browse-handle.browse-type = 'width':u
     1381             on error undo, next
     1382             :
     1383               assign
     1384                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1385               .
     1386             end.
     1387             assign
     1388               v-diasize-browse-handle :width = v-browse-width
     1389             .
     1390             for each buf_temp-diasize-handle
     1391             on error undo, next
     1392             :
     1393               assign
     1394                 v-object-handle = buf_temp-diasize-handle.handle-value
     1395               .
     1396               if v-object-handle <> v-diasize-resize-button
     1397               then do:
     1398                 assign
     1399                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1400                 .
     1401               end.
     1402             end.
     1403             run diasize_position-resize-button in this-procedure .
     1404           end.
     1405           assign
     1406             v-diasize-change-size = false
     1407           .
     1408           leave move_block .
     1409         end.
     1410       end.
     1411       assign
     1412         v-diasize-need-full-display = true
     1413       .
     1414       if v-diasize-change-size = false
     1415       then do:
     1416         assign
     1417           v-diasize-change-size = true
     1418         .
     1419       end.
     1420       else do:
     1421         return .
     1422       end.
     1423       assign
     1424         v-frame-width = frame Dialog-Frame :width
     1425         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1426         v-browse-width = v-diasize-browse-handle :width
     1427       .
     1428       for each buf_temp-browse-handle
     1429         where buf_temp-browse-handle.browse-type = 'width':u
     1430       :
     1431         assign
     1432           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1433         .
     1434       end.
     1435       for each buf_temp-diasize-handle
     1436       :
     1437         delete buf_temp-diasize-handle .
     1438       end.
     1439       assign
     1440         v-field-group-handle = frame Dialog-Frame :first-child
     1441       .
     1442       do while valid-handle(v-field-group-handle)
     1443       :
     1444         assign
     1445           v-object-handle = v-field-group-handle :first-child
     1446         .
     1447         do while valid-handle(v-object-handle)
     1448         :
     1449           if  v-object-handle <> v-diasize-browse-handle :handle
     1450           and v-object-handle <> v-diasize-resize-button
     1451           and can-query(v-object-handle, "row")
     1452           and can-query(v-object-handle, "height")
     1453           and ( v-object-handle :col + v-object-handle :width
     1454                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1455               )
     1456           then do:
     1457             find first buf_temp-browse-handle
     1458               where buf_temp-browse-handle.browse-type   = 'width':u
     1459                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1460               no-error .
     1461             if available buf_temp-browse-handle
     1462             then do:
     1463             end.
     1464             else do:
     1465               create buf_temp-diasize-handle .
     1466               assign
     1467                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1468                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1469               .
     1470             end.
     1471           end.
     1472           assign
     1473             v-object-handle = v-object-handle :next-sibling
     1474           .
     1475         end.
     1476         assign
     1477           v-field-group-handle = v-field-group-handle :next-sibling
     1478         .
     1479       end.
     1480       do with frame Dialog-Frame
     1481       :
     1482         hide v-diasize-resize-button .
     1483         v-diasize-resize-button :row = 1.
     1484         v-diasize-resize-button :column = 1.
     1485       end.
     1486       if p-change-value > 0
     1487       then do:
     1488         if frame Dialog-Frame :scrollable = true
     1489         then do:
     1490           assign
     1491             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1492             no-error .
     1493           if error-status :error
     1494           or error-status :get-message(1) <> ""
     1495           then do:
     1496             undo move_block, retry move_block.
     1497           end.
     1498         end.
     1499         assign
     1500           frame Dialog-Frame :width = v-frame-width + p-change-value
     1501           no-error .
     1502         if error-status :error
     1503         or error-status :get-message(1) <> ""
     1504         then do:
     1505           undo move_block, retry move_block.
     1506         end.
     1507         assign
     1508           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1509         no-error .
     1510         if error-status :error
     1511         or error-status :get-message(1) <> ""
     1512         then do:
     1513           undo move_block, retry move_block.
     1514         end.
     1515         for each buf_temp-browse-handle
     1516           where buf_temp-browse-handle.browse-type = 'width':u
     1517         on error undo move_block, retry move_block
     1518         :
     1519           assign
     1520             buf_temp-browse-handle.browse-handle :width
     1521               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1522             no-error .
     1523           if error-status :error
     1524           or error-status :get-message(1) <> ""
     1525           then do:
     1526             undo move_block, retry move_block .
     1527           end.
     1528         end.
     1529         for each buf_temp-diasize-handle
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             v-object-handle = buf_temp-diasize-handle.handle-value
     1534           .
     1535           if v-object-handle <> v-diasize-resize-button
     1536           then do:
     1537             assign
     1538               v-object-handle :col = v-object-handle :col + p-change-value
     1539               no-error .
     1540             if error-status :error
     1541             or error-status :get-message(1) <> ""
     1542             then do:
     1543               undo move_block, retry move_block .
     1544             end.
     1545           end.
     1546         end.
     1547       end.
     1548       else do:
     1549         for each buf_temp-diasize-handle
     1550         on error undo move_block, retry move_block
     1551         :
     1552           assign
     1553             v-object-handle = buf_temp-diasize-handle.handle-value
     1554           .
     1555           if v-object-handle <> v-diasize-resize-button
     1556           then do:
     1557             assign
     1558               v-object-handle :col = v-object-handle :col + p-change-value
     1559               no-error .
     1560             if error-status :error
     1561             or error-status :get-message(1) <> ""
     1562             then do:
     1563               undo move_block, retry move_block .
     1564             end.
     1565           end.
     1566         end.
     1567         for each buf_temp-browse-handle
     1568           where buf_temp-browse-handle.browse-type = 'width':u
     1569         on error undo move_block, retry move_block
     1570         :
     1571           assign
     1572             buf_temp-browse-handle.browse-handle :width
     1573               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1574             no-error .
     1575           if error-status :error
     1576           or error-status :get-message(1) <> ""
     1577           then do:
     1578             undo move_block, retry move_block .
     1579           end.
     1580         end.
     1581         assign
     1582           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1583           no-error .
     1584         if error-status :error
     1585         or error-status :get-message(1) <> ""
     1586         then do:
     1587           undo move_block, retry move_block.
     1588         end.
     1589         assign
     1590           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1591         no-error .
     1592         if error-status :error
     1593         or error-status :get-message(1) <> ""
     1594         then do:
     1595           undo move_block, retry move_block.
     1596         end.
     1597         if frame Dialog-Frame :scrollable = true
     1598         then do:
     1599           assign
     1600             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1601           no-error .
     1602           if error-status :error
     1603           or error-status :get-message(1) <> ""
     1604           then do:
     1605             undo move_block, retry move_block.
     1606           end.
     1607         end.
     1608       end.
     1609       if p-move-resize
     1610       then do:
     1611         run diasize_position-resize-button in this-procedure .
     1612       end.
     1613       if v-diasize-wndstore = true
     1614       then do:
     1615         if connected("ub") = true
     1616         then do:
     1617           define variable v-cntxt-db-num        as integer   no-undo .
     1618           define variable v-cntxt-userid        as character no-undo .
     1619           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1620                                             , OUTPUT v-cntxt-userid
     1621                                             ) .
     1622           run gbl/wndsizew.p
     1623             (input  v-cntxt-db-num
     1624             ,input  v-cntxt-userid
     1625             ,input  v-diasize-proc-name
     1626             ,input  'width':u
     1627             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1628             ) .
     1629         end.
     1630       end.
     1631     end.
     1632     assign
     1633       v-diasize-change-size = false
     1634     .
     1635   end procedure.
     1636   procedure diasize_set-width :
     1637     define input  parameter p-new-width  as decimal   no-undo .
     1638     define input  parameter p-move-resize as logical   no-undo .
     1639     do
     1640     on error undo, return error return-value
     1641     :
     1642       run diasize_change-width in this-procedure
     1643         (input  (p-new-width - frame Dialog-Frame :width)
     1644         ,input  p-move-resize
     1645         ) .
     1646     end.
     1647   end procedure.
     1648   procedure diasize_position-resize-button :
     1649     do with frame Dialog-Frame
     1650     :
     1651       hide v-diasize-resize-button .
     1652       assign
     1653         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1654                     - 1
     1655                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1656         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1657                     - 1
     1658                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1659       .
     1660       view v-diasize-resize-button .
     1661     end.
     1662   end procedure.
     1663   on alt-right anywhere
     1664   do:
     1665     run diasize_change-width in this-procedure
     1666       (input 1
     1667       ,input true
     1668       ) .
     1669     return no-apply .
     1670   end.
     1671   on alt-left anywhere
     1672   do:
     1673     run diasize_change-width in this-procedure
     1674       (input -1
     1675       ,input true
     1676       ) .
     1677     return no-apply .
     1678   end.
     1679   on alt-down anywhere
     1680   do:
     1681     run diasize_change-height in this-procedure
     1682       (input 1
     1683       ,input true
     1684       ) .
     1685     return no-apply .
     1686   end.
     1687   on alt-up anywhere
     1688   do:
     1689     run diasize_change-height in this-procedure
     1690       (input -1
     1691       ,input true
     1692       ) .
     1693     return no-apply .
     1694   end.
     1695   on alt-enter of frame Dialog-Frame
     1696   do:
     1697     run diasize_maximize in this-procedure
     1698       (input  ?
     1699       ).
     1700     return no-apply .
     1701   end.
     1702   procedure diasize_end-move :
     1703     do
     1704     on error undo, return error return-value
     1705     :
     1706       define variable v-row-delta as decimal   no-undo .
     1707       define variable v-col-delta as decimal   no-undo .
     1708       define variable v-new-row as decimal   no-undo .
     1709       define variable v-new-col as decimal   no-undo .
     1710       assign
     1711         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1712         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1713       .
     1714       assign
     1715         v-row-delta = v-new-row - frame Dialog-Frame :height
     1716         v-col-delta = v-new-col - frame Dialog-Frame :width
     1717       .
     1718       run diasize_change-height in this-procedure
     1719         (input v-row-delta
     1720         ,input true
     1721         ) .
     1722       run diasize_change-width in this-procedure
     1723         (input v-col-delta
     1724         ,input true
     1725         ) .
     1726     end.
     1727   end procedure.
     1728   procedure diasize_maximize :
     1729     define input  parameter p-action as logical   no-undo .
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733       if p-action = ?
     1734       then do:
     1735         if v-diasize-need-maximize = true
     1736         then do:
     1737           assign
     1738             p-action = true
     1739           .
     1740         end.
     1741         else do:
     1742           assign
     1743             p-action = false
     1744           .
     1745         end.
     1746       end.
     1747       if p-action = true
     1748       then do:
     1749         run diasize_change-height in this-procedure
     1750           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1751               - frame Dialog-Frame :height-chars
     1752           ,input true
     1753           ) .
     1754         run diasize_change-width in this-procedure
     1755           (input session :width-chars
     1756               - frame Dialog-Frame :width-chars
     1757           ,input true
     1758           ) .
     1759         assign
     1760           v-diasize-need-maximize = false
     1761         .
     1762       end.
     1763       else do:
     1764         run diasize_change-width in this-procedure
     1765           (input v-diasize-orig-frame-width
     1766               - frame Dialog-Frame :width-chars
     1767           ,input true
     1768           ) .
     1769         run diasize_change-height in this-procedure
     1770           (input v-diasize-orig-frame-height
     1771               - frame Dialog-Frame :height-chars
     1772           ,input true
     1773           ) .
     1774         assign
     1775           v-diasize-need-maximize = true
     1776         .
     1777       end.
     1778     end.
     1779   end procedure.
     1780   procedure diasize_restore-orig-size :
     1781     do
     1782     on error undo, return error return-value
     1783     :
     1784       assign
     1785         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1786         v-diasize-current-frame-height = frame Dialog-Frame :height
     1787       .
     1788       run diasize_set-height in this-procedure
     1789         (input  v-diasize-orig-frame-height
     1790         ,input  true
     1791         ) .
     1792       run diasize_set-width in this-procedure
     1793         (input  v-diasize-orig-frame-width
     1794         ,input  true
     1795         ) .
     1796     end.
     1797   end procedure.
     1798   procedure diasize_restore-current-size :
     1799     do
     1800     on error undo, return error return-value
     1801     :
     1802       run diasize_set-height in this-procedure
     1803         (input  v-diasize-current-frame-height
     1804         ,input  true
     1805         ) .
     1806       run diasize_set-width in this-procedure
     1807         (input  v-diasize-current-frame-width
     1808         ,input  true
     1809         ) .
     1810     end.
     1811   end procedure.
     1812   procedure diasize_set-browse-handle :
     1813     define input  parameter p-browse-handle as handle   no-undo .
     1814     define buffer buf_temp-browse-handle for temp-browse-handle .
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818       assign
     1819         v-diasize-browse-handle = p-browse-handle
     1820       .
     1821       for each buf_temp-browse-handle
     1822       on error undo, return error return-value
     1823       :
     1824         delete buf_temp-browse-handle .
     1825       end.
     1826     end.
     1827   end procedure.
     1828   procedure diasize_add_browse :
     1829     define input  parameter p-browse-type   as character no-undo .
     1830     define input  parameter p-browse-handle as handle    no-undo .
     1831     define buffer buf_temp-browse-handle for temp-browse-handle .
     1832     do
     1833     on error undo, return error return-value
     1834     :
     1835       assign
     1836         v-diasize-browse-number = v-diasize-browse-number + 1
     1837       .
     1838       create buf_temp-browse-handle .
     1839       assign
     1840         buf_temp-browse-handle.browse-type   = p-browse-type
     1841         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1842         buf_temp-browse-handle.browse-handle = p-browse-handle
     1843       .
     1844     end.
     1845   end procedure.
     1846   procedure diasize_init :
     1847     define variable v-default-value    as logical   no-undo .
     1848     define variable v-restore-saved    as logical   no-undo .
     1849     define variable v-resize-value-str as character no-undo .
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       do with frame Dialog-Frame
     1854       :
     1855         assign
     1856           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1857           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1858           v-diasize-browse-handle     = browse BR-option :handle
     1859         .
     1860         create button v-diasize-resize-button
     1861         assign
     1862           parent        = frame Dialog-Frame :first-child
     1863           label         = "s"
     1864           height-pixels = 16
     1865           width-pixels  = 16
     1866           visible       = true
     1867           sensitive     = true
     1868           movable       = true
     1869           triggers:
     1870             on end-move persistent run diasize_end-move in this-procedure .
     1871           end triggers.
     1872         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1873         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1874         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1875         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1876         assign
     1877           v-diasize-wndmax = false
     1878         .
     1879         if connected("ub") = true
     1880         then do:
     1881           define variable v-cntxt-db-num        as integer   no-undo .
     1882           define variable v-cntxt-userid        as character no-undo .
     1883           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1884                                             , OUTPUT v-cntxt-userid
     1885                                             ) .
     1886           run gbl/wndpar_r.p
     1887             (input  v-cntxt-db-num
     1888             ,input  v-cntxt-userid
     1889             ,input  'wndmax':U
     1890             ,output v-diasize-wndmax
     1891             ,output v-default-value
     1892             ) .
     1893         end.
     1894         assign
     1895           v-diasize-wndstore = false
     1896         .
     1897         if connected("ub") = true
     1898         then do:
     1899           run gbl/wndpar_r.p
     1900             (input  v-cntxt-db-num
     1901             ,input  v-cntxt-userid
     1902             ,input  'wndstore':U
     1903             ,output v-diasize-wndstore
     1904             ,output v-default-value
     1905             ) .
     1906         end.
     1907         assign
     1908           v-diasize-proc-name = entry(1, program-name(2), '.')
     1909         .
     1910         if v-diasize-wndstore = true
     1911         then do:
     1912           assign
     1913             v-restore-saved = false
     1914           .
     1915           if connected("ub") = true
     1916           then do:
     1917             run gbl/wndsizer.p
     1918               (input  v-cntxt-db-num
     1919               ,input  v-cntxt-userid
     1920               ,input  v-diasize-proc-name
     1921               ,input  'height':u
     1922               ,output v-resize-value-str
     1923               ) .
     1924             if v-resize-value-str <> '':U
     1925             then do:
     1926               run diasize_change-height in this-procedure
     1927                 (input  integer(v-resize-value-str)
     1928                 ,input  true
     1929                 ) .
     1930               assign
     1931                 v-restore-saved = true
     1932               .
     1933             end.
     1934           end.
     1935           if connected("ub") = true
     1936           then do:
     1937             run gbl/wndsizer.p
     1938               (input  v-cntxt-db-num
     1939               ,input  v-cntxt-userid
     1940               ,input  v-diasize-proc-name
     1941               ,input  'width':u
     1942               ,output v-resize-value-str
     1943               ) .
     1944             if v-resize-value-str <> '':U
     1945             then do:
     1946               run diasize_change-width in this-procedure
     1947                 (input  integer(v-resize-value-str)
     1948                 ,input  true
     1949                 ) .
     1950               assign
     1951                 v-restore-saved = true
     1952               .
     1953             end.
     1954           end.
     1955           if v-restore-saved <> true
     1956           then do:
     1957             if v-diasize-wndmax = true
     1958             then do:
     1959               run diasize_maximize in this-procedure
     1960                 (input  true
     1961                 ) .
     1962             end.
     1963           end.
     1964         end.
     1965         else do:
     1966           if v-diasize-wndmax = true
     1967           then do:
     1968             run diasize_maximize in this-procedure
     1969               (input  true
     1970               ) .
     1971           end.
     1972         end.
     1973       end.
     1974     end.
     1975   end procedure.
     1976   procedure diasize_need-full-display :
     1977     define output parameter p-need-full-display as logical   no-undo .
     1978     do
     1979     on error undo, return error return-value
     1980     :
     1981       assign
     1982         p-need-full-display = v-diasize-need-full-display
     1983       .
     1984       assign
     1985         v-diasize-need-full-display = false
     1986       .
     1987     end.
     1988   end procedure.
     1989   procedure get-context :
     1990      define output parameter p-db-num as integer          no-undo.
     1991      define output parameter p-user-id as character        no-undo.
     1992      define variable v-login               as character    no-undo.
     1993      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1994      define buffer buf_user-login  for ub.user-login .
     1995      do
     1996      on error undo, return error
     1997      :
     1998            FIND FIRST buf_sys-ctrl no-lock.
     1999            ASSIGN
     2000               v-login = USERID("ub")
     2001               p-db-num = buf_sys-ctrl.db-num
     2002            .
     2003            FIND FIRST buf_user-login
     2004                 WHERE buf_user-login.db-num = p-db-num
     2005                   AND buf_user-login.user-login = v-login
     2006                 no-lock
     2007                 no-error
     2008                 .
     2009            IF AVAILABLE buf_user-login
     2010            THEN DO:
     2011               assign
     2012                  p-user-id = buf_user-login.user-id
     2013               .
     2014            END.
     2015      end.
     2016   end procedure.
     2017       run diasize_init in this-procedure .
     2018   ON "leave" OF tt-hist-nws-option.hist-to-nws-is-on  IN BROWSE br-option
     2019   DO:
     2020      IF tt-hist-nws-option.hist-to-nws-can = NO
     2021      or p-mode = 'ПРОСМОТР':U
     2022      THEN DO:
     2023       BELL.
     2024       assign
     2025       tt-hist-nws-option.hist-to-nws-is-on = (IF tt-hist-nws-option.hist-to-Nws = integer('10':U)
     2026                                               THEN YES
     2027                                               ELSE NO).
     2028       display
     2029       tt-hist-nws-option.hist-to-nws-is-on
     2030       with browse br-option.
     2031     END.
     2032   END.
     2033   ON "leave" OF tt-hist-nws-option.nws-to-hist-is-on  IN BROWSE br-option
     2034   DO:
     2035      IF tt-hist-nws-option.nws-to-hist-can = NO
     2036      or p-mode = 'ПРОСМОТР':U
     2037      THEN DO:
     2038       BELL.
     2039       assign
     2040       tt-hist-nws-option.nws-to-hist-is-on = (IF tt-hist-nws-option.nws-to-hist = integer('10':U)
     2041                                               THEN YES
     2042                                               ELSE NO).
     2043       display
     2044       tt-hist-nws-option.nws-to-hist-is-on
     2045       with browse br-option.
     2046     END.
     2047   END.
     2048   ON "leave" OF tt-hist-nws-option.get-hist-from-nws-is-on  IN BROWSE br-option
     2049   DO:
     2050      IF tt-hist-nws-option.get-hist-from-nws-can = NO
     2051      or p-mode = 'ПРОСМОТР':U
     2052      THEN DO:
     2053       BELL.
     2054       assign
     2055       tt-hist-nws-option.get-hist-from-nws-is-on = (IF tt-hist-nws-option.get-hist-from-nws = integer('10':U)
     2056                                               THEN YES
     2057                                               ELSE NO).
     2058       display
     2059       tt-hist-nws-option.get-hist-from-nws-is-on
     2060       with browse br-option.
     2061     END.
     2062   END.
     2063   MAIN-BLOCK:
     2064   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2065      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2066   IF NOT (p-mode = 'ИЗМЕНЕНИЕ':U
     2067           OR p-mode = 'ПРОСМОТР':U) THEN  DO:
     2068      MESSAGE
     2069      vss-workfile vss-revision vss-description skip
     2070      "Неверное значение параметра p-mode" p-mode
     2071      VIEW-AS ALERT-BOX ERROR.
     2072      UNDO, RETURN ERROR.
     2073   END.
     2074   if g#db-num <> 0
     2075   and p-db-num <> G#db-num
     2076   and p-mode <> 'ПРОСМОТР':U
     2077   then do:
     2078     MESSAGE
     2079     vss-workfile vss-revision vss-description skip
     2080     "Неверное значение параметра p-db-num" p-db-num skip
     2081     "Нельзя работать с настройками записи истории и машрутизации в чужой УБД"
     2082     VIEW-AS ALERT-BOX ERROR.
     2083     UNDO, RETURN ERROR.
     2084   end.
     2085   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2086     DO ON ERROR UNDO, RETURN ERROR
     2087        ON STOP UNDO, RETURN ERROR:
     2088       FIND FIRST locked_hist-nws-option EXCLUSIVE-LOCK WHERE
     2089               locked_hist-nws-option.db-num = p-db-num
     2090           AND locked_hist-nws-option.hn-id = 0 NO-WAIT NO-ERROR .
     2091       IF NOT AVAILABLE LOCKED_hist-nws-option
     2092       AND NOT LOCKED LOCKED_hist-nws-option THEN DO:
     2093           CREATE locked_hist-nws-option.
     2094           ASSIGN
     2095           locked_hist-nws-option.db-num = p-db-num
     2096           locked_hist-nws-option.hn-id = 0
     2097           .
     2098       END.
     2099       ELSE DO:
     2100           FIND FIRST locked_hist-nws-option EXCLUSIVE-LOCK WHERE
     2101                   locked_hist-nws-option.db-num = p-db-num
     2102               AND locked_hist-nws-option.hn-id = 0 NO-ERROR .
     2103       END.
     2104     END.
     2105   END.
     2106   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2107       FIND FIRST locked_hist-nws-option no-LOCK WHERE
     2108               locked_hist-nws-option.db-num = p-db-num
     2109           AND locked_hist-nws-option.hn-id = 0 NO-ERROR.
     2110      IF NOT AVAILABLE locked_hist-nws-option THEN DO:
     2111         CREATE locked_hist-nws-option.
     2112         ASSIGN
     2113         locked_hist-nws-option.db-num = p-db-num
     2114         locked_hist-nws-option.hn-id = 0
     2115         .
     2116      END.
     2117   END.
     2118     RUN fill-table IN THIS-PROCEDURE ( INPUT '':U).
     2119     RUN Myenable IN THIS-PROCEDURE.
     2120     WAIT-FOR GO OF FRAME Dialog-Frame.
     2121   END.
     2122   RUN disable_UI.
     2123   PROCEDURE disable_UI :
     2124     HIDE FRAME Dialog-Frame.
     2125   END PROCEDURE.
     2126   PROCEDURE enable_UI :
     2127     DISPLAY CB-subject-group last-modify
     2128         WITH FRAME Dialog-Frame.
     2129     ENABLE B-exit b-quit CB-subject-group b-copyrdb b-hist B-Help last-modify
     2130            BR-option
     2131         WITH FRAME Dialog-Frame.
     2132     VIEW FRAME Dialog-Frame.
     2133     OPEN QUERY BR-option FOR EACH tt-hist-nws-option WHERE          (v-subject-group = '':U           AND tt-hist-nws-option.table-name = '':U)          OR (tt-hist-nws-option.subject-group = v-subject-group              AND tt-hist-nws-option.table-name > '':U).
     2134   END PROCEDURE.
     2135   PROCEDURE fill-table :
     2136   DEFINE INPUT PARAMETER p-subject-group AS CHARACTER NO-UNDO.
     2137   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2138   DEFINE BUFFER buf_hist-nws-option FOR ub.hist-nws-option.
     2139   run waitfram-show in this-procedure ( "Ждите ... ").
     2140   FOR EACH buf_hist-nws-option NO-LOCK WHERE
     2141          buf_hist-nws-option.db-num = p-db-num
     2142      and buf_hist-nws-option.hn-id > 0
     2143      :
     2144     if buf_hist-nws-option.charkey_one <> '':U
     2145     or buf_hist-nws-option.charkey_two <> '':U
     2146     or buf_hist-nws-option.charkey_three <> '':U
     2147     or buf_hist-nws-option.key#_one <> 0
     2148     or buf_hist-nws-option.key#_two <> 0
     2149     or buf_hist-nws-option.key#_three <> 0
     2150     or buf_hist-nws-option.host-code <> 0
     2151     or buf_hist-nws-option.obj-type <> '':U
     2152     or buf_hist-nws-option.obj-code <> 0 then next.
     2153     CREATE tt-hist-nws-option.
     2154     buffer-copy buf_hist-nws-option to tt-hist-nws-option.
     2155     ASSIGN
     2156     tt-hist-nws-option.hist-to-nws-is-on = (tt-hist-nws-option.hist-to-nws >= 0)
     2157     tt-hist-nws-option.nws-to-hist-is-on = (tt-hist-nws-option.nws-to-hist >= 0)
     2158     tt-hist-nws-option.get-hist-from-nws-is-on = (tt-hist-nws-option.get-hist-from-nws >= 0)
     2159     tt-hist-nws-option.hist-to-nws-can = NOT ((tt-hist-nws-option.hist-to-nws = INTEGER('10':U)) OR
     2160                                               (tt-hist-nws-option.hist-to-nws = INTEGER('-10':U)))
     2161     tt-hist-nws-option.nws-to-hist-can = NOT ((tt-hist-nws-option.nws-to-hist = INTEGER('10':U)) OR
     2162                                               (tt-hist-nws-option.nws-to-hist = INTEGER('-10':U)))
     2163     tt-hist-nws-option.get-hist-from-nws-can = NOT ((tt-hist-nws-option.get-hist-from-nws = INTEGER('10':U)) OR
     2164                                                     (tt-hist-nws-option.get-hist-from-nws = INTEGER('-10':U)))
     2165     .
     2166     IF LOOKUP(buf_hist-nws-option.subject-group, v-groups) = 0  THEN DO:
     2167       ASSIGN
     2168       v-groups = v-groups + chr(44) +
     2169                   buf_hist-nws-option.subject-group
     2170       v-groups = TRIM(v-groups, chr(44))
     2171       .
     2172     END.
     2173   END.
     2174   run waitfram-hide in this-procedure .
     2175   END PROCEDURE.
     2176   PROCEDURE MyEnable :
     2177   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2178   DEFINE VARIABLE glog AS logical NO-UNDO.
     2179   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2180   ASSIGN
     2181   cb-subject-group:LIST-ITEMS IN FRAME Dialog-Frame = '':U + chr(44) + v-groups.
     2182   DO v-ii = 1 TO BROWSE br-option:NUM-COLUMNS:
     2183      v-h = BROWSE br-option:GET-BROWSE-COLUMN(v-ii).
     2184      IF v-h:LABEL = "Пересылка ист.!в другие БД" THEN DO:
     2185          ASSIGN
     2186          v-col[1] = v-h
     2187          .
     2188      END.
     2189      IF v-h:LABEL = "Создание ист.!при приеме!по СПН" THEN DO:
     2190          ASSIGN
     2191          v-col[2] = v-h
     2192          .
     2193      END.
     2194      IF v-h:LABEL = "Прием истории!из другой!УБД" THEN DO:
     2195          ASSIGN
     2196          v-col[3] = v-h
     2197          .
     2198      END.
     2199      IF v-h:LABEL = "Группа данных" THEN DO:
     2200          ASSIGN
     2201          v-col-tbl-name = v-h
     2202          .
     2203      END.
     2204   END.
     2205   DISPLAY
     2206   locked_hist-nws-option.option-descr @ last-modify
     2207   WITH FRAME Dialog-Frame.
     2208   ENABLE
     2209   B-exit
     2210   b-quit
     2211   B-Help
     2212   b-copyrdb WHEN (p-mode = 'ИЗМЕНЕНИЕ':U AND (g#db-num = p-db-num OR g#db-num = 0 ))
     2213   b-hist
     2214   BR-option
     2215   WITH FRAME Dialog-Frame.
     2216   VIEW FRAME Dialog-Frame.
     2217   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2218      HIDE
     2219      b-exit IN FRAME Dialog-Frame.
     2220      ASSIGN
     2221      b-quit:LABEL = "&Выход"
     2222      b-quit:COLUMN = 1
     2223      FRAME Dialog-Frame:TITLE = substitute("&1 &2", FRAME Dialog-Frame:TITLE, p-db-num)
     2224      tt-hist-nws-option.hist-to-nws-is-on:READ-ONLY in browse br-option = YES
     2225      tt-hist-nws-option.nws-to-hist-is-on :READ-ONLY in browse br-option = YES
     2226      tt-hist-nws-option.get-hist-from-nws-is-on:READ-ONLY in browse br-option = YES
     2227      .
     2228   END.
     2229   APPLY "Value-changed" TO cb-subject-group.
     2230   END PROCEDURE.
     2231   PROCEDURE OpenBr :
     2232   IF v-subject-group = '':U THEN DO:
     2233       OPEN QUERY br-option
     2234       FOR EACH tt-hist-nws-option WHERE
     2235               tt-hist-nws-option.db-num = p-db-num
     2236           and tt-hist-nws-option.hn-id > 0
     2237           and tt-hist-nws-option.table-name = '':U.
     2238   END.
     2239   ELSE DO:
     2240       OPEN QUERY br-oprion
     2241       FOR EACH tt-hist-nws-option WHERE
     2242               tt-hist-nws-option.db-num = p-db-num
     2243           and tt-hist-nws-option.hn-id > 0
     2244           and  (tt-hist-nws-option.subject-group = v-subject-group
     2245                    AND tt-hist-nws-option.table-name > '':U).
     2246   END.
     2247   END PROCEDURE.
     2248   PROCEDURE proc-copy-udb :
     2249   DEFINE PARAMETER BUFFER buf_tt-hist-nws-option FOR tt-hist-nws-option.
     2250   DEFINE VARIABLE v-today as date no-undo .
     2251   DEFINE VARIABLE v-time as integer no-undo .
     2252   DEFINE VARIABLE glog as LOGICAL no-undo .
     2253   DEFINE VARIABLE v-attr-value as character no-undo .
     2254   DEFINE BUFFER buf_db FOR ub.db.
     2255   DEFINE BUFFER bufo_tt-hist-nws-option for TT-hist-nws-option.
     2256   IF g#db-num > 0 THEN DO:
     2257     UNDO, RETURN ERROR.
     2258   END.
     2259   MESSAGE
     2260   SUBSTITUTE("Вы действительно хотите скопировать&1" +
     2261              "настройки записи истории и маршрутизации &2 на все УБД?&1" +
     2262              "Измения будут сохранены в момент сохранения изменений для опций БД &3&1" +
     2263              "(Нажатие клавиши ВВОД"
     2264              , chr(10)
     2265              , buf_tt-hist-nws-option.option-descr
     2266              , p-db-num)
     2267   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2268   IF NOT glog THEN DO:
     2269       UNDO, RETURN NO-APPLY.
     2270   END.
     2271   do TRANSACTION
     2272   ON ERROR UNDO, RETURN ERROR:
     2273       FOR EACH buf_db NO-LOCK WHERE
     2274               buf_db.db-num > 0
     2275       ON error undo, return error :
     2276         FIND FIRST bufo_tt-hist-nws-option WHERE
     2277                   bufo_tt-hist-nws-option.db-num = buf_db.db-num
     2278              AND  bufo_tt-hist-nws-option.hn-id = buf_tt-hist-nws-option.hn-id NO-ERROR.
     2279         IF NOT AVAILABLE bufo_tt-hist-nws-option THEN DO:
     2280            CREATE bufo_tt-hist-nws-option.
     2281            BUFFER-COPY buf_tt-hist-nws-option
     2282            except db-num
     2283            TO bufo_tt-hist-nws-option
     2284            assign
     2285            bufo_tt-hist-nws-option.db-num = buf_db.db-num
     2286            .
     2287         END.
     2288         else do:
     2289           BUFFER-COPY buf_tt-hist-nws-option
     2290           except db-num
     2291           TO bufo_tt-hist-nws-option
     2292           .
     2293         end.
     2294       END.
     2295   END.
     2296   run openbr in this-procedure .
     2297   END PROCEDURE.
     2298   PROCEDURE proc-save :
     2299   DEFINE VARIABLE v-today as date no-undo .
     2300   DEFINE VARIABLE v-time as integer no-undo .
     2301   DEFINE BUFFER buf_hist-nws-option FOR ub.hist-nws-option.
     2302   DEFINE BUFFER buf_tt-hist-nws-option FOR tt-hist-nws-option.
     2303   DEFINE BUFFER main_tt-hist-nws-option FOR tt-hist-nws-option.
     2304   DEFINE BUFFER subject_hist-nws-option FOR tt-hist-nws-option.
     2305   DEFINE BUFFER last_hist-nws-option FOR ub.hist-nws-option.
     2306   define buffer main_hist-nws-option for ub.hist-nws-option.
     2307   if g#db-num = p-db-num then do:
     2308     message
     2309     "Сделанные Вами изменения вступят в силу для всех пользователей не позже, чем через полчаса" skip
     2310     "(или сразу же после перезагрузки IBS TH)"
     2311     view-as alert-box .
     2312   end.
     2313   _hist-nws-option:
     2314   FOR EACH buf_tt-hist-nws-option
     2315   ON error UNDO, RETURN ERROR return-value
     2316   ON STOP UNDO, RETURN ERROR return-value :
     2317     if buf_tt-hist-nws-option.hn-id = 0 then next _hist-nws-option.
     2318     FIND FIRST buf_hist-nws-option WHERE
     2319               buf_hist-nws-option.db-num = buf_tt-hist-nws-option.db-num
     2320           and buf_hist-nws-option.hn-id = buf_tt-hist-nws-option.hn-id NO-ERROR.
     2321     IF NOT AVAILABLE buf_hist-nws-option THEN DO:
     2322       next _hist-nws-option.
     2323     END.
     2324     if buf_tt-hist-nws-option.db-num <> p-db-num then do:
     2325       find first main_tt-hist-nws-option where
     2326                 main_tt-hist-nws-option.db-num = buf_tt-hist-nws-option.db-num
     2327            and  main_tt-hist-nws-option.hn-id = 0 no-error.
     2328       if not available main_tt-hist-nws-option then do:
     2329         create main_tt-hist-nws-option.
     2330         assign
     2331         main_tt-hist-nws-option.db-num = buf_tt-hist-nws-option.db-num
     2332         main_tt-hist-nws-option.hn-id  = 0
     2333         .
     2334       end.
     2335       run cur-time in this-procedure(output v-today, output v-time).
     2336       assign
     2337       main_tt-hist-nws-option.option-descr = substitute("&1 &2", string(v-today, "99/99/9999"), string(v-time, "HH:MM:SS")).
     2338     end.
     2339     IF v-subject-group = '':U THEN DO:
     2340       FIND FIRST subject_hist-nws-option WHERE
     2341                 subject_hist-nws-option.db-num = buf_tt-hist-nws-option.db-num
     2342           AND  subject_hist-nws-option.subject-group = buf_tt-hist-nws-option.subject-group
     2343           AND  subject_hist-nws-option.table-name = '':U NO-ERROR.
     2344       IF AVAILABLE subject_hist-nws-option THEN DO:
     2345         assign
     2346         buf_hist-nws-option.hist-to-nws = (IF buf_tt-hist-nws-option.hist-to-nws-can
     2347                                           THEN (IF subject_hist-nws-option.hist-to-nws-is-on
     2348                                                 THEN INTEGER('0':U)
     2349                                                 ELSE INTEGER('-1':U)
     2350                                                 )
     2351                                           ELSE buf_hist-nws-option.hist-to-nws)
     2352         buf_hist-nws-option.nws-to-hist = (IF buf_tt-hist-nws-option.nws-to-hist-can
     2353                                             THEN (IF subject_hist-nws-option.nws-to-hist-is-on
     2354                                                     THEN INTEGER('0':U)
     2355                                                     ELSE INTEGER('-1':U)
     2356                                                     )
     2357                                             ELSE buf_hist-nws-option.nws-to-hist)
     2358         buf_hist-nws-option.get-hist-from-nws = (IF buf_tt-hist-nws-option.get-hist-from-nws-can
     2359                                             THEN (IF subject_hist-nws-option.get-hist-from-nws-is-on
     2360                                                     THEN INTEGER('0':U)
     2361                                                     ELSE INTEGER('-1':U)
     2362                                                     )
     2363                                             ELSE buf_hist-nws-option.get-hist-from-nws)
     2364         .
     2365       END.
     2366     END.
     2367     ELSE DO:
     2368       assign
     2369       buf_hist-nws-option.hist-to-nws = (IF buf_tt-hist-nws-option.hist-to-nws-can
     2370                                           THEN (IF buf_tt-hist-nws-option.hist-to-nws-is-on
     2371                                                 THEN INTEGER('0':U)
     2372                                                 ELSE INTEGER('-1':U)
     2373                                               )
     2374                                           ELSE buf_hist-nws-option.hist-to-nws)
     2375       buf_hist-nws-option.nws-to-hist = (IF buf_tt-hist-nws-option.nws-to-hist-can
     2376                                           THEN (IF buf_tt-hist-nws-option.nws-to-hist-is-on
     2377                                                     THEN INTEGER('0':U)
     2378                                                     ELSE INTEGER('-1':U)
     2379                                                   )
     2380                                           ELSE buf_hist-nws-option.nws-to-hist)
     2381       buf_hist-nws-option.get-hist-from-nws = (IF buf_tt-hist-nws-option.get-hist-from-nws-can
     2382                                           THEN (IF buf_tt-hist-nws-option.get-hist-from-nws-is-on
     2383                                                     THEN INTEGER('0':U)
     2384                                                     ELSE INTEGER('-1':U)
     2385                                                   )
     2386                                           ELSE buf_hist-nws-option.get-hist-from-nws)
     2387       .
     2388     END.
     2389   END.
     2390   run cur-time in this-procedure ( output v-today, output v-time).
     2391   ASSIGN
     2392   locked_hist-nws-option.option-descr = STRING(v-today, "99/99/9999") + chr(32) + STRING(v-time, "HH:MM:SS")
     2393   .
     2394   _main-hist-nws-option:
     2395   FOR EACH main_tt-hist-nws-option
     2396   ON error UNDO, RETURN ERROR return-value
     2397   ON STOP UNDO, RETURN ERROR return-value :
     2398     if main_tt-hist-nws-option.hn-id <> 0
     2399     or main_tt-hist-nws-option.db-num = p-db-num
     2400     then next _main-hist-nws-option.
     2401     FIND FIRST buf_hist-nws-option WHERE
     2402               buf_hist-nws-option.db-num = main_tt-hist-nws-option.db-num
     2403           and buf_hist-nws-option.hn-id = main_tt-hist-nws-option.hn-id NO-ERROR.
     2404     IF NOT AVAILABLE buf_hist-nws-option THEN DO:
     2405       next _main-hist-nws-option.
     2406     END.
     2407     buffer-copy main_tt-hist-nws-option to buf_hist-nws-option.
     2408   end.
     2409   run gbl/clearlib.p .
     2410   END PROCEDURE.
     2411   PROCEDURE Switch-subject :
     2412   IF cb-subject-group = '':U THEN DO:
     2413       ASSIGN
     2414       v-col[1]:VISIBLE = NO
     2415       tt-hist-nws-option.hist-to-nws-is-on:LABEL IN BROWSE br-option = "Пересылка ист.!в другие БД"
     2416       tt-hist-nws-option.hist-to-nws-is-on:width IN BROWSE br-option = 15
     2417       v-col[2]:VISIBLE = NO
     2418       tt-hist-nws-option.nws-to-hist-is-on:LABEL IN BROWSE br-option = "Создание ист.!при приеме!по СПН"
     2419       tt-hist-nws-option.nws-to-hist-is-on:width IN BROWSE br-option = 15
     2420       v-col[3]:VISIBLE = NO
     2421       tt-hist-nws-option.get-hist-from-nws-is-on:LABEL IN BROWSE br-option = "Прием истории!из другой!УБД"
     2422       tt-hist-nws-option.get-hist-from-nws-is-on:width IN BROWSE br-option = 15
     2423       v-col-tbl-name:VISIBLE  = NO
     2424       tt-hist-nws-option.option-descr:LABEL  = "Группа данных"
     2425       .
     2426     END.
     2427     ELSE DO:
     2428        ASSIGN
     2429        v-col[1]:VISIBLE = YES
     2430        tt-hist-nws-option.hist-to-nws-is-on:LABEL IN BROWSE br-option = "Вкл!Выкл"
     2431        tt-hist-nws-option.hist-to-nws-is-on:width IN BROWSE br-option = 4
     2432        v-col[2]:VISIBLE = YES
     2433        tt-hist-nws-option.nws-to-hist-is-on:LABEL IN BROWSE br-option = "Вкл!Выкл"
     2434        tt-hist-nws-option.nws-to-hist-is-on:width IN BROWSE br-option = 4
     2435        v-col[3]:VISIBLE = YES
     2436        tt-hist-nws-option.get-hist-from-nws-is-on:LABEL IN BROWSE br-option = "Вкл!Выкл"
     2437        tt-hist-nws-option.get-hist-from-nws-is-on:width IN BROWSE br-option = 4
     2438        v-col-tbl-name:VISIBLE  = YES
     2439        tt-hist-nws-option.option-descr:label  = "Сущность"
     2440        .
     2441     END.
     2442   END PROCEDURE.
     2443   FUNCTION get-hn-group-label RETURNS CHARACTER
     2444     ( INPUT p-subject-group AS CHARACTER ) :
     2445   RETURN p-subject-group.
     2446   END FUNCTION.
     2447   FUNCTION get-hn-label RETURNS CHARACTER
     2448     ( INPUT p-hn-option AS integer ) :
     2449     RETURN entry (lookup (string(p-hn-option), '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U).
     2450   END FUNCTION.
