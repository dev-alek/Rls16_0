      616   procedure proc-alt-shift-f2:
      617     if not ibs.th.gbl.gbl-var:rcode
      618   then
      619     run gbl\inidebug.p .
      620   end.
      621   procedure proc-alt-shift-f3:
      622     run gbl/prvssinf.p
      623       ( input this-procedure
      624       ) .
      625   end.
      626   define variable v-inform-launched as logical no-undo initial false .
      627   procedure proc-alt-shift-f4:
      628     define variable v-action as character no-undo .
      629     if v-inform-launched = false then do:
      630       assign
      631         v-inform-launched = true
      632       .
      633       run gbl/d-inform.w
      634         (  input self
      635         ,  input this-procedure
      636         , output v-action
      637         ) no-error .
      638       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      639       assign
      640         v-inform-launched = false
      641       .
      642     end.
      643   end.
      644   procedure proc-alt-f1:
      645     run gbl/corrhelp.p
      646       (input this-procedure
      647       ) .
      648   end .
      649   on alt-shift-f2 anywhere do:
      650     run proc-alt-shift-f2.
      651   end.
      652   on alt-shift-f3 anywhere do:
      653     run proc-alt-shift-f3 in this-procedure .
      654   end.
      655   on alt-shift-f4 anywhere do:
      656     run proc-alt-shift-f4 in this-procedure.
      657   end.
      658   on alt-f1 anywhere do:
      659     run proc-alt-f1 in this-procedure .
      660   end.
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662     define variable v-cntxt-db-num        as integer   no-undo .
      663     define variable v-cntxt-userid        as character no-undo .
      664     define variable v-cntxt-level         as character no-undo .
      665     define variable v-cntxt-host-code-obj as integer   no-undo .
      666     define variable v-cntxt-obj-type      as character no-undo .
      667     define variable v-cntxt-obj-code      as integer   no-undo .
      668     define variable v-cntxt-db-num-obj    as integer   no-undo .
      669     define variable v-cntxt-is-admin      as logical   no-undo .
      670   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      672                                                       ,input p-range-type as character
      673                                                       ,input p-code as integer):
      674   define variable v-seq-val as integer no-undo .
      675   define buffer buf_code-range for ub.code-range.
      676   find first buf_code-range no-lock where
      677             buf_code-range.db-num = p-db-num
      678       and  buf_code-range.range-type = p-range-type
      679       and  buf_code-range.stts = 'u'
      680       and buf_code-range.first-code <= p-code
      681       and buf_code-range.last-code >= p-code no-error .
      682   if available buf_code-range then return yes.
      683   CASE p-range-type:
      684     when 'pngb':U then do:
      685       v-seq-val = current-value(s-pngb-code, ub).
      686     end.
      687     when 'fmgb':U then do:
      688       v-seq-val = current-value(s-fmgb-code, ub).
      689     end.
      690   END CASE.
      691   if p-code <= v-seq-val then do:
      692     find first buf_code-range no-lock where
      693               buf_code-range.db-num = p-db-num
      694         and  buf_code-range.range-type = p-range-type
      695         and  buf_code-range.stts = 'a'
      696         and buf_code-range.first-code <= p-code
      697         no-error .
      698    if available buf_code-range then return yes.
      699   end.
      700   find first buf_code-range no-lock where
      701             buf_code-range.db-num = p-db-num
      702       and  buf_code-range.range-type = p-range-type
      703       and  buf_code-range.stts = 'f'
      704       and buf_code-range.first-code <= p-code
      705       and buf_code-range.last-code >= p-code
      706       no-error .
      707   if available buf_code-range then return yes.
      708   return no.
      709   END FUNCTION.
      710   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      711                                                       ,input p-range-type as character
      712                                                       ,input p-code as integer):
      713   define variable v-seq-val as integer no-undo .
      714   define buffer buf_code-range for ub.code-range.
      715   CASE p-range-type:
      716     when 'pngb':U then do:
      717       v-seq-val = current-value(s-pngb-code, ub).
      718     end.
      719     when 'fmgb':U then do:
      720       v-seq-val = current-value(s-fmgb-code, ub).
      721     end.
      722   END CASE.
      723   if p-code <= v-seq-val then do:
      724     find first buf_code-range no-lock where
      725               buf_code-range.db-num = p-db-num
      726         and  buf_code-range.range-type = p-range-type
      727         and buf_code-range.first-code <= p-code
      728         and buf_code-range.last-code >= p-code no-error .
      729     if available buf_code-range then return yes.
      730   end.
      731   return no.
      732   END FUNCTION.
      733   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      734                                                       ,input p-db-num as integer
      735                                                       ,input p-staff-code as integer
      736                                                       ,input p-date as date
      737                                                        ):
      738   define buffer buf_staff for ub.staff.
      739   if p-date = ? then do:
      740     p-date = today .
      741   end.
      742   find first buf_staff no-lock where
      743             buf_staff.role = p-role
      744         and buf_staff.role-level = 'db':U
      745         and buf_staff.db-num = p-db-num
      746         and buf_staff.staff-code = p-staff-code
      747         and buf_staff.date-end >= p-date use-index pi  no-error .
      748   if available buf_staff then do:
      749     return buf_staff.psn-code.
      750   end.
      751   return 0.
      752   end FUNCTION.
      753   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      754                                                             ,input p-db-num as integer
      755                                                             ,input p-date as date
      756                                                                 ):
      757   define buffer buf_staff for ub.staff.
      758   define buffer buf2_staff for ub.staff.
      759   if p-date = ? then do:
      760     p-date = today .
      761   end.
      762   for each  buf_staff no-lock where
      763             buf_staff.role = p-role
      764         and buf_staff.db-num = p-db-num,
      765   first buf2_staff no-lock where
      766         buf2_staff.role = p-role
      767     and buf2_staff.role-level = 'db':U
      768     and buf2_staff.staff-code = buf_staff.staff-code
      769     and buf2_staff.date-start <= p-date
      770     and buf2_staff.date-end >= p-date
      771   by buf_staff.staff-code
      772   by date-start descending:
      773     return buf_staff.staff-code.
      774   end.
      775   end FUNCTION.
      776   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      777                                                  ,input p-db-num as integer
      778                                                  ,input p-psn-code as integer
      779                                                  ,input p-date as date
      780                                                  ,output p-c-password as character
      781                                                        ):
      782   define buffer buf_staff for ub.staff.
      783   if p-date = ? then do:
      784     p-date = today .
      785   end.
      786   find first buf_staff no-lock where
      787             buf_staff.role = p-role
      788         and buf_staff.role-level = 'db':U
      789         and buf_staff.db-num = p-db-num
      790        and buf_staff.date-end >= p-date
      791        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      792   if available buf_staff
      793   then do:
      794     assign
      795     p-c-password = buf_staff.password.
      796     return buf_staff.staff-code.
      797   end.
      798   p-c-password = ''.
      799   return 0.
      800   end FUNCTION.
      801   FUNCTION gbclcode-is-psn-role returns integer (
      802                                                 input p-role as character
      803                                                 ,input p-psn-code as integer
      804                                                 ,input p-date as date
      805                                                     ):
      806   define buffer buf_staff for ub.staff.
      807   if p-date = ? then do:
      808     p-date = today .
      809   end.
      810   for each buf_staff no-lock where
      811             buf_staff.psn-code = p-psn-code
      812        and  buf_staff.role = p-role
      813   by buf_staff.role-level
      814   by buf_staff.date-start
      815        :
      816     if  buf_staff.date-start <= p-date and
      817     buf_staff.date-end >= p-date  then do:
      818       return buf_staff.staff-code.
      819     end.
      820   end.
      821   return 0.
      822   end FUNCTION.
      823   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      824   define variable v-role-name as character no-undo .
      825   assign
      826   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      827   no-error .
      828   return v-role-name.
      829   END.
      830   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   FUNCTION gbclcode-get-position returns character ( input p-role as character
      832                                                     ,input p-role-level as character
      833                                                     ,input p-work-place as character
      834                                                     ,input p-staff-code as integer
      835                                                                ):
      836   define variable v-role-name as character no-undo .
      837   define variable v-role-level as character no-undo .
      838   define variable v-staff-code as integer no-undo .
      839   assign
      840   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      841   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      842   v-staff-code = p-staff-code
      843   no-error .
      844   return substitute("&1, &2, Код &3"
      845                   ,v-role-name
      846                   ,v-role-level
      847                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      848   END.
      849   FUNCTION gbclcode-get-work-place returns character (
      850                                                   input p-role as character
      851                                                  ,input p-role-level as character
      852                                                  ,input p-db-num as integer
      853                                                  ,input p-host-code as integer
      854                                                  ,input p-obj-type as character
      855                                                  ,input p-obj-code as integer
      856                                                  ) :
      857   define variable v-work-place as character no-undo .
      858   define variable v-obj-type as character no-undo .
      859     case p-role-level:
      860       when 'db':U then do:
      861         v-work-place = string(p-db-num, "99999").
      862       end.
      863       when 'firm':U then do:
      864         v-work-place = string(p-host-code, "99999").
      865       end.
      866       when 'object':U then do:
      867         assign
      868         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      869         .
      870       end.
      871     END CASE.
      872     return v-work-place.
      873   END FUNCTION.
      874   FUNCTION gbclcode-get-level-last-code returns integer (
      875                                                           input p-role as character
      876                                                         , input p-role-level as character
      877                                                         , input p-work-place as character
      878                                                         , input p-date-start as date
      879                                                         ):
      880   DEFINE VARIABLE v-today as date no-undo .
      881   define buffer buf_staff for ub.staff.
      882   if p-work-place = chr(63) then return ?.
      883   if p-date-start = ? then do:
      884     v-today = today .
      885   end.
      886   else do:
      887     v-today = p-date-start.
      888   end.
      889   find last buf_staff no-lock where
      890             buf_staff.role = p-role
      891        and  buf_staff.role-level = p-role-level
      892        and  buf_staff.work-place = p-work-place
      893        and  buf_staff.date-start <= v-today + 1
      894        and  buf_staff.date-end >= v-today + 1
      895        use-index pi  no-error .
      896   if available buf_staff
      897   then return buf_staff.staff-code.
      898   return 0.
      899   end FUNCTION.
      900   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   procedure cur-time :
      902      define output parameter p-today as date      no-undo .
      903      define output parameter p-time  as integer   no-undo .
      904     do
      905     on error undo, return error
      906     :
      907       define variable v-date1 as date      no-undo .
      908       define variable v-date2 as date      no-undo .
      909       define variable v-time  as integer   no-undo .
      910       assign
      911         v-date1 = today
      912         v-time  = time
      913         v-date2 = today
      914       .
      915       if v-date1 <> v-date2
      916       then do:
      917         assign
      918           v-date1 = today
      919           v-time  = v-time
      920         .
      921       end.
      922       assign
      923         p-today = v-date1
      924         p-time  = v-time
      925       .
      926     end.
      927   end.
      928   function cur-time-date returns character
      929   :
      930     return string(today, '99/99/9999':U) .
      931   end.
      932   function cur-time-mjd returns decimal
      933   :
      934     define variable v-date as date      no-undo .
      935     define variable v-time as integer   no-undo .
      936     run cur-time in this-procedure
      937       (output v-date
      938       ,output v-time
      939       ) .
      940     return integer(v-date) - 2400002 + (v-time / 86400) .
      941   end.
      942   function cur-time-get-ending-index returns integer
      943   (input p-number as integer
      944   )
      945   :
      946     if p-number < 0
      947     or p-number = ?
      948     then do:
      949       return 1 .
      950     end.
      951     define variable v-rest as integer   no-undo .
      952     assign
      953       p-number = p-number modulo 100
      954     .
      955     if p-number < 20
      956     then do:
      957       assign
      958         v-rest = p-number
      959       .
      960     end.
      961     else do:
      962       assign
      963         v-rest = p-number modulo 10
      964       .
      965     end.
      966     case v-rest :
      967       when 1
      968       then do:
      969         return 2 .
      970       end.
      971       when 2 or
      972       when 3 or
      973       when 4
      974       then do:
      975         return 3 .
      976       end.
      977       otherwise do:
      978         return 1 .
      979       end.
      980     end case .
      981   end.
      982   procedure cur-time-mjd-to-date :
      983      define input  parameter i-mjd-diff as decimal no-undo.
      984      define output parameter o-Date     as date    no-undo.
      985      define output parameter o-Time     as integer no-undo.
      986      define variable v-day-number as integer   no-undo .
      987      if    i-mjd-diff < 0
      988         or i-mjd-diff = ?
      989      then do:
      990         return "?" .
      991      end.
      992      assign
      993         v-day-number = truncate(i-mjd-diff,0).
      994         o-Date = date(v-day-number + 2400002).
      995         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      996     .
      997   end.
      998   function cur-time-mjd-to-string returns character
      999   (input p-mjd-diff as decimal
     1000   )
     1001   :
     1002     define variable v-day-number as integer   no-undo .
     1003     define variable v-seconds    as integer   no-undo .
     1004     define variable v-hour       as integer   no-undo .
     1005     define variable v-min        as integer   no-undo .
     1006     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1007     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1008     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1009     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1010     if p-mjd-diff < 0
     1011     or p-mjd-diff = ?
     1012     then do:
     1013       return "?" .
     1014     end.
     1015     assign
     1016       v-day-number = integer(truncate(p-mjd-diff,0))
     1017       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1018     .
     1019     if v-seconds > 86400
     1020     then do:
     1021       assign
     1022         v-seconds = 86400 - 1
     1023       .
     1024     end.
     1025     if v-seconds < 0
     1026     then do:
     1027       assign
     1028         v-seconds = 0
     1029       .
     1030     end.
     1031     assign
     1032       v-hour = truncate(v-seconds / 3600, 0)
     1033     .
     1034     assign
     1035       v-seconds = v-seconds modulo 3600
     1036     .
     1037     assign
     1038       v-min = truncate(v-seconds / 60, 0)
     1039     .
     1040     assign
     1041       v-seconds = v-seconds modulo 60
     1042     .
     1043     return
     1044         (if v-day-number <> 0
     1045           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1046           else ""
     1047         )
     1048       + (if v-day-number <> 0 or v-hour <> 0
     1049           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1050           else ""
     1051         )
     1052       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1053           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1054           else ""
     1055         )
     1056       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1057       .
     1058   end.
     1059   function cur-time-string returns character
     1060   :
     1061     define variable v-date as date      no-undo .
     1062     define variable v-time as integer   no-undo .
     1063     run cur-time in this-procedure
     1064       (output v-date
     1065       ,output v-time
     1066       ) .
     1067     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1068   end.
     1069   function cur-time-string-sec returns character
     1070   :
     1071     define variable v-date as date      no-undo .
     1072     define variable v-time as integer   no-undo .
     1073     run cur-time in this-procedure
     1074       (output v-date
     1075       ,output v-time
     1076       ) .
     1077     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1078   end.
     1079   function cur-time-custom  returns character
     1080   (input p-prefix as character
     1081   ,input p-date-format as character
     1082   ,input p-delimiter as character
     1083   ,input p-time-format as character
     1084   ,input p-suffix as character
     1085   )
     1086   :
     1087     define variable v-date as date      no-undo .
     1088     define variable v-time as integer   no-undo .
     1089     run cur-time in this-procedure
     1090       (output v-date
     1091       ,output v-time
     1092       ) .
     1093     return
     1094       p-prefix
     1095       + string(v-date, p-date-format)
     1096       + p-delimiter
     1097       + string(v-time, p-time-format)
     1098       + p-suffix
     1099       .
     1100   end.
     1101   function cur-time-print  returns character
     1102   :
     1103     define variable v-date as date      no-undo .
     1104     define variable v-time as integer   no-undo .
     1105     run cur-time in this-procedure
     1106       (output v-date
     1107       ,output v-time
     1108       ) .
     1109     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1110   end.
     1111   function cur-time-datetime returns datetime
     1112   :
     1113     define variable v-char as character no-undo .
     1114     define variable v-datetime as datetime no-undo .
     1115     v-char = cur-time-string().
     1116     v-datetime = datetime(v-char).
     1117     return  v-datetime.
     1118   end.
     1119   function cur-time-string-msec returns character
     1120   :
     1121     define variable v-date as datetime  no-undo .
     1122     v-date = now.
     1123     return string(v-date) .
     1124   end.
     1125   define   shared variable g#auto as logical no-undo.
