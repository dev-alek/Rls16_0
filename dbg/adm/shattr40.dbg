     1237       ASSIGN
     1238     t-obyznumbukv.
     1239   END.
     1240   ON leave OF t-TimeAvail IN FRAME Dialog-Frame
     1241   DO:
     1242      if integer(t-TimeAvail:screen-value in frame Dialog-Frame) > 60 then do:
     1243         message "Время жизни пароля не должно превышать 60 дней"
     1244         view-as alert-box.
     1245         return no-apply .
     1246      end.
     1247       ASSIGN
     1248     t-TimeAvail.
     1249   END.
     1250   ON leave OF t-TimeBlock IN FRAME Dialog-Frame
     1251   DO:
     1252      if integer(t-TimeBlock:screen-value in frame Dialog-Frame) > 120 then do:
     1253         message "Время до блокировки пользователя после окончания действия пароля не должно превышать 120 дней"
     1254         view-as alert-box.
     1255         return no-apply .
     1256      end.
     1257      if integer(t-TimeBlock:screen-value in frame Dialog-Frame) < 30 and integer(t-TimeBlock:screen-value in frame Dialog-Frame) <> 0 then do:
     1258         message "Время до блокировки пользователя после окончания действия пароля должно быть больше 30 дней"
     1259         view-as alert-box.
     1260         return no-apply .
     1261      end.
     1262       ASSIGN
     1263     t-TimeBlock.
     1264   END.
     1265   ON leave OF t-TimeBlockAdm IN FRAME Dialog-Frame
     1266   DO:
     1267      if integer(t-TimeBlockAdm:screen-value in frame Dialog-Frame) > 120 then do:
     1268         message "Время до блокировки пользователя после окончания действия пароля не должно превышать 120 дней"
     1269         view-as alert-box.
     1270         return no-apply .
     1271      end.
     1272      if integer(t-TimeBlockAdm:screen-value in frame Dialog-Frame) < 30 and integer(t-TimeBlockAdm:screen-value in frame Dialog-Frame) <> 0 then do:
     1273         message "Время до блокировки пользователя после окончания действия пароля должно быть больше 30 дней"
     1274         view-as alert-box.
     1275         return no-apply .
     1276      end.
     1277       ASSIGN
     1278     t-TimeBlockAdm.
     1279   END.
     1280   ON leave OF t-TimeAvailAdm IN FRAME Dialog-Frame
     1281   DO:
     1282      if integer(t-TimeAvailAdm:screen-value in frame Dialog-Frame) > 60 then do:
     1283         message "Время жизни пароля не должно превышать 60 дней"
     1284         view-as alert-box.
     1285         return no-apply .
     1286      end.
     1287       ASSIGN
     1288     t-TimeAvailAdm.
     1289   END.
     1290   ON VALUE-CHANGED OF t-obyznumbukvAdm IN FRAME Dialog-Frame
     1291   DO:
     1292       ASSIGN
     1293     t-obyznumbukv.
     1294   END.
     1295   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1296   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1297   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   on help of frame Dialog-Frame
     1299   do:
     1300     run gbl/app_help.p
     1301       (input this-procedure :file-name
     1302       ,input ''
     1303       ,input ?
     1304       ) no-error.
     1305     if error-status :error then do:
     1306       message
     1307         "Ошибка при вызове помощи"
     1308         error-status :get-message(1)
     1309         view-as alert-box .
     1310     end.
     1311   end.
     1312   run minbtn-set in this-procedure .
     1313   on choose of b-help in frame Dialog-Frame
     1314   do:
     1315     apply "help":u to frame Dialog-Frame .
     1316   end.
     1317   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1318   procedure minbtn-set :
     1319       do
     1320           on error undo, return error return-value
     1321           :
     1322           define variable ii              as integer       no-undo .
     1323           define variable fh              as widget-handle no-undo .
     1324           define variable hh              as widget-handle no-undo .
     1325           define variable v-h             as handle        extent 4 no-undo .
     1326           define variable v-name-button   as character     no-undo .
     1327           define variable v-help-old-x    as decimal       no-undo .
     1328           define variable v-help-old-y    as decimal       no-undo .
     1329           define variable v-help-old-size as decimal       no-undo .
     1330           define variable v-frame-width   as decimal       no-undo .
     1331           define variable jj              as integer       no-undo .
     1332           do
     1333               on error undo, return error
     1334               :
     1335               assign
     1336                   v-frame-width = frame Dialog-Frame:width - 0.3
     1337                   fh            = frame Dialog-Frame:first-child
     1338                   hh            = fh:first-child
     1339                   ii            = 1
     1340                   .
     1341               do while valid-handle(hh):
     1342                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1343                   do:
     1344                       case lc(hh:name) :
     1345                           when "b-help" then
     1346                               do:
     1347                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1348                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1349                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1350                                   hh:TOOLTIP = "Помощь" .
     1351                                   v-help-old-x = hh:column .
     1352                                   v-help-old-y = hh:row    .
     1353                                   v-help-old-size = hh:width .
     1354                                   hh:width-chars = 2.5 .
     1355                               end.
     1356                           when "b-print" then
     1357                               do:
     1358                                   hh:load-image("cmp/b-print.bmp":u) .
     1359                                   hh:TOOLTIP = "Печать" .
     1360                                   v-h[ii] = hh:handle .
     1361                                   ii = ii + 1 .
     1362                                   hh:width-chars = 3 .
     1363                               end.
     1364                           when "b-history" or
     1365                           when "b-hist" then
     1366                               do:
     1367                                   hh:load-image("cmp/b-hist.bmp":u) .
     1368                                   hh:TOOLTIP = "История" .
     1369                                   v-h[ii] = hh:handle .
     1370                                   ii = ii + 1 .
     1371                                   hh:width-chars = 3 .
     1372                               end.
     1373                           when "b-sch" then
     1374                               do:
     1375                                   hh:load-image("cmp/b-sch.bmp":u) .
     1376                                   hh:TOOLTIP = "Установка Фильтра" .
     1377                                   v-h[ii] = hh:handle .
     1378                                   ii = ii + 1 .
     1379                                   hh:width-chars = 3 .
     1380                               end.
     1381                           when "b-hist-user" then
     1382                               do:
     1383                                   hh:load-image("cmp/b-hist.bmp":u) .
     1384                                   hh:TOOLTIP = "История пользователя" .
     1385                                   ii = ii + 1 .
     1386                               end.
     1387                       end case.
     1388                   end.
     1389                   hh = hh:next-sibling.
     1390               end.
     1391               b-help:column = v-frame-width - b-help:width-chars.
     1392               jj = 0.
     1393               repeat ii = 4 to 1 by -1 :
     1394                   if valid-handle (v-h[ii] ) then
     1395                   do:
     1396                       jj  = jj + 1 .
     1397                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1398                       v-h[ii]:row    = v-help-old-y .
     1399                   end.
     1400               end.
     1401           end.
     1402       end.
     1403   end procedure.
     1404   MAIN-BLOCK:
     1405   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1406      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1407   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1408     run mainmenu_getcntxt in parparentproc
     1409       (output v-cntxt-db-num
     1410       ,output v-cntxt-userid
     1411       ,output v-cntxt-level
     1412       ,output v-cntxt-host-code-obj
     1413       ,output v-cntxt-obj-type
     1414       ,output v-cntxt-obj-code
     1415       ,output v-cntxt-db-num-obj
     1416       ,output v-cntxt-is-admin
     1417       ) .
     1418   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1419   ON TAB ANYWHERE
     1420   DO:
     1421   define variable ii as integer no-undo .
     1422   define variable fh as widget-handle no-undo .
     1423   define variable hh as widget-handle no-undo .
     1424   define variable v-next-widget-name as character no-undo .
     1425   if v-tab-order <> '' then do:
     1426     if self:type = "TOGGLE-BOX" then
     1427     self:BGCOLOR = ?.
     1428     assign
     1429     ii = lookup(self:name, v-tab-order).
     1430     assign
     1431     ii = ii + 1
     1432     v-next-widget-name = entry(ii, v-tab-order)
     1433     no-error .
     1434     if error-status:error then do:
     1435       assign
     1436       ii = 1
     1437       v-next-widget-name = entry( ii, v-tab-order)
     1438       .
     1439     end.
     1440     assign
     1441     fh = frame Dialog-Frame:first-child
     1442     hh = fh:first-child
     1443     .
     1444     do while valid-handle(hh):
     1445       if hh:name = v-next-widget-name then do:
     1446         if hh:sensitive  = yes
     1447         AND hh:visible = yes then do:
     1448           if hh:type = "TOGGLE-BOX":U then do:
     1449             assign
     1450             hh:BGcolor = 1
     1451             .
     1452           end.
     1453           APPLY "ENTRY" to hh.
     1454           return no-apply.
     1455         end.
     1456         else do:
     1457           APPLY "TAB" to hh.
     1458           return no-apply.
     1459         end.
     1460       end.
     1461       hh = hh:next-sibling.
     1462     end.
     1463   end.
     1464   END.
     1465   ON BACK-TAB ANYWHERE
     1466   DO:
     1467   define variable ii as integer no-undo .
     1468   define variable fh as widget-handle no-undo .
     1469   define variable hh as widget-handle no-undo .
     1470   define variable v-next-widget-name as character no-undo .
     1471   if v-tab-order <> '' then do:
     1472     assign
     1473     ii = lookup(self:name, v-tab-order).
     1474     .
     1475     assign
     1476     ii = (if ii = 1
     1477           then  num-entries(v-tab-order)
     1478           else ii - 1
     1479           )
     1480     v-next-widget-name = entry(ii, v-tab-order)
     1481     .
     1482     assign
     1483     fh = frame Dialog-Frame:first-child
     1484     hh = fh:first-child
     1485     .
     1486     do while valid-handle(hh):
     1487       if hh:name = v-next-widget-name then do:
     1488         if hh:sensitive  = yes
     1489         AND hh:visible = yes then do:
     1490           if hh:type = "TOGGLE-BOX":U then do:
     1491             assign
     1492             hh:BGcolor = 1
     1493             .
     1494           end.
     1495           APPLY "ENTRY" to hh.
     1496           return no-apply.
     1497         end.
     1498         else do:
     1499         APPLY "BACK-TAB" to hh.
     1500         return no-apply.
     1501         end.
     1502       end.
     1503       hh = hh:next-sibling.
     1504     end.
     1505     end.
     1506   END.
     1507   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1508   ON RETURN ANYWHERE
     1509   DO:
     1510   define variable ii as integer no-undo .
     1511   define variable fh as widget-handle no-undo .
     1512   define variable hh as widget-handle no-undo .
     1513   define variable v-next-widget-name as character no-undo .
     1514     if v-tab-order <> '' then do:
     1515       assign
     1516       ii = lookup(self:name, v-tab-order).
     1517       if ii = num-entries(v-tab-order) then do:
     1518           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1519           return no-apply.
     1520       end.
     1521       if self:type <> "BUTTON" and
     1522         self:type <> "EDITOR"  then do:
     1523         run proc-move-forward in this-procedure .
     1524         return no-apply.
     1525       end.
     1526       if self:type = "BUTTON" then do:
     1527         APPLY "CHOOSE" to self.
     1528       end.
     1529       if self:type = "TOGGLE-BOX" then
     1530       self:BGCOLOR = ?.
     1531       assign
     1532       ii = ii + 1
     1533       v-next-widget-name = entry(ii, v-tab-order)
     1534       no-error .
     1535       if error-status:error then do:
     1536         assign
     1537         ii = 1
     1538         v-next-widget-name = entry( ii, v-tab-order)
     1539         .
     1540       end.
     1541       assign
     1542       fh = frame Dialog-Frame:first-child
     1543       hh = fh:first-child
     1544       .
     1545       do while valid-handle(hh):
     1546         if hh:name = v-next-widget-name then do:
     1547           if hh:sensitive  = yes
     1548           AND hh:visible = yes then do:
     1549             if hh:type = "TOGGLE-BOX":U then do:
     1550               assign
     1551               hh:BGcolor = 1
     1552               .
     1553             end.
     1554             APPLY "ENTRY" to hh.
     1555             return no-apply.
     1556           end.
     1557           else do:
     1558             APPLY "TAB" to hh.
     1559             return no-apply.
     1560           end.
     1561         end.
     1562         hh = hh:next-sibling.
     1563       end.
     1564     end.
     1565   END.
     1566   procedure proc-move-forward :
     1567   define variable ii as integer no-undo .
     1568   define variable fh as widget-handle no-undo .
     1569   define variable hh as widget-handle no-undo .
     1570   define variable v-next-widget-name as character no-undo .
     1571   do
     1572   on error undo, return error
     1573   :
     1574     if v-tab-order <> '' then do:
     1575       if self:type = "TOGGLE-BOX" then
     1576       self:BGCOLOR = ?.
     1577       assign
     1578       ii = lookup(self:name, v-tab-order).
     1579       assign
     1580       ii = ii + 1
     1581       v-next-widget-name = entry(ii, v-tab-order)
     1582       no-error .
     1583       if error-status:error then do:
     1584         assign
     1585         ii = 1
     1586         v-next-widget-name = entry( ii, v-tab-order)
     1587         .
     1588       end.
     1589       assign
     1590       fh = frame Dialog-Frame:first-child
     1591       hh = fh:first-child
     1592       .
     1593       do while valid-handle(hh):
     1594         if hh:name = v-next-widget-name then do:
     1595           if hh:sensitive  = yes
     1596           AND hh:visible = yes then do:
     1597             if hh:type = "TOGGLE-BOX":U then do:
     1598               assign
     1599               hh:BGcolor = 1
     1600               .
     1601             end.
     1602             APPLY "ENTRY" to hh.
     1603             return.
     1604           end.
     1605           else do:
     1606             assign
     1607             ii = ii + 1
     1608             v-next-widget-name = entry(ii, v-tab-order)
     1609             no-error .
     1610             if error-status:error then do:
     1611               assign
     1612               ii = 1
     1613               v-next-widget-name = entry( ii, v-tab-order)
     1614               .
     1615             end.
     1616           end.
     1617         end.
     1618         hh = hh:next-sibling.
     1619       end.
     1620     end.
     1621   end.
     1622   end procedure.
     1623     IF p-mode <> 'ПРОСМОТР':U
     1624     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1625         MESSAGE
     1626         vss-workfile vss-revision vss-description skip
     1627         "Неверное значение параметра p-mode" p-mode
     1628         VIEW-AS ALERT-BOX ERROR.
     1629         UNDO, RETURN ERROR.
     1630     END.
     1631     IF p-obj-type <> 'маг':U
     1632     and p-obj-type <> 'орг':U
     1633     and p-obj-type <> '':U
     1634     and p-obj-type <> 'скл':U
     1635     THEN DO:
     1636         MESSAGE
     1637         vss-workfile vss-revision vss-description skip
     1638         "Неверное значение параметра p-obj-type" p-obj-type
     1639         VIEW-AS ALERT-BOX ERROR.
     1640         UNDO, RETURN ERROR.
     1641     END.
     1642     if p-obj-type = 'маг':U then do:
     1643       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1644       IF NOT AVAILABLE X_shop THEN DO:
     1645           MESSAGE
     1646           vss-workfile vss-revision vss-description skip
     1647           "Неверное значение параметра p-obj-code" p-obj-code
     1648           VIEW-AS ALERT-BOX ERROR.
     1649           UNDO, RETURN ERROR.
     1650       END.
     1651   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1653     (input  'маг':U
     1654     ,input  p-obj-code
     1655     ,output v-db-num
     1656     )  .
     1657       IF v-db-num <> v-cntxt-db-num
     1658       AND v-cntxt-db-num <> 0
     1659       and p-mode <> 'ПРОСМОТР':U
     1660       THEN DO:
     1661           MESSAGE
     1662           "Нельзя менять параметры магазина в чужой БД" skip
     1663           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1664           VIEW-AS ALERT-BOX ERROR.
     1665           UNDO, RETURN ERROR.
     1666       END.
     1667     end.
     1668     if p-obj-type = 'скл':U then do:
     1669       FIND FIRST X_store NO-LOCK WHERE X_store.obj-code = p-obj-code NO-ERROR.
     1670       IF NOT AVAILABLE X_store THEN DO:
     1671           MESSAGE
     1672           vss-workfile vss-revision vss-description skip
     1673           "Неверное значение параметра p-obj-code" p-obj-code
     1674           VIEW-AS ALERT-BOX ERROR.
     1675           UNDO, RETURN ERROR.
     1676       END.
     1677   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1679     (input  'скл':U
     1680     ,input  p-obj-code
     1681     ,output v-db-num
     1682     )  .
     1683       IF v-db-num <> v-cntxt-db-num
     1684       AND v-cntxt-db-num <> 0
     1685       and p-mode <> 'ПРОСМОТР':U
     1686       THEN DO:
     1687           MESSAGE
     1688           "Нельзя менять параметры склада в чужой БД" skip
     1689           "склад принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1690           VIEW-AS ALERT-BOX ERROR.
     1691           UNDO, RETURN ERROR.
     1692       END.
     1693     end.
     1694     if p-obj-type = 'орг':U then do:
     1695       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1696       IF NOT AVAILABLE X_sysconf THEN DO:
     1697           MESSAGE
     1698           vss-workfile vss-revision vss-description skip
     1699           "Неверное значение параметра p-obj-code" p-obj-code
     1700           VIEW-AS ALERT-BOX ERROR.
     1701           UNDO, RETURN ERROR.
     1702       END.
     1703       if v-cntxt-db-num <> 0
     1704       and p-mode <> 'ПРОСМОТР':U
     1705       then do:
     1706           MESSAGE
     1707           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1708           VIEW-AS ALERT-BOX ERROR.
     1709           UNDO, RETURN ERROR.
     1710       end.
     1711     end.
     1712     if p-obj-type = '':U then do:
     1713       if v-cntxt-db-num <> 0
     1714       and p-mode <> 'ПРОСМОТР':U
     1715       then do:
     1716           MESSAGE
     1717           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1718           VIEW-AS ALERT-BOX ERROR.
     1719           UNDO, RETURN ERROR.
     1720       end.
     1721     end.
     1722     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1723       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1724                 LOCKED_thbj-attr.obj-type = p-obj-type
     1725           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1726           AND   LOCKED_thbj-attr.upper-prop-code = 'staff':U
     1727           and locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1728        if locked locked_thbj-attr then do:
     1729           message
     1730           vss-workfile vss-revision vss-description skip
     1731            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1732           view-as alert-box error .
     1733           undo, return error.
     1734         end.
     1735     END.
     1736     ELSE DO:
     1737         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1738             LOCKED_thbj-attr.obj-type = p-obj-type
     1739       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1740       AND   LOCKED_thbj-attr.upper-prop-code = 'staff':U
     1741       and   locked_thbj-attr.prop-code = '':U NO-ERROR.
     1742     END.
     1743     if not available locked_thbj-attr then do:
     1744       ASSIGN
     1745       v-to-create  = YES.
     1746       message
     1747       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1748                   chr(10))
     1749       view-as alert-box WARNING.
     1750     end.
     1751     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1752     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1753     RUN Myenable in this-procedure .
     1754     WAIT-FOR GO OF FRAME Dialog-Frame.
     1755   END.
     1756   RUN disable_UI.
     1757   PROCEDURE disable_UI :
     1758     HIDE FRAME Dialog-Frame.
     1759   END PROCEDURE.
     1760   PROCEDURE enable_UI :
     1761     DISPLAY t-noanshftstaff t-obyznumbukv t-obyznumbukvAdm t-minparol
     1762             t-minparolAdm t-TimeAvail t-TimeAvailAdm t-TimeBlock t-TimeBlockAdm
     1763             t-LastPaswd t-LastPaswdAdm
     1764         WITH FRAME Dialog-Frame.
     1765     ENABLE B-exit b-quit B-Help t-noanshftstaff t-obyznumbukv t-obyznumbukvAdm
     1766            t-minparol t-minparolAdm t-TimeAvail t-TimeAvailAdm t-TimeBlock
     1767            t-TimeBlockAdm t-LastPaswd t-LastPaswdAdm
     1768         WITH FRAME Dialog-Frame.
     1769     VIEW FRAME Dialog-Frame.
     1770   END PROCEDURE.
     1771   PROCEDURE fill-widgets :
     1772   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1773   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1774   DEFINE VARIABLE v-dop-time AS CHARACTER NO-UNDO.
     1775   define variable v-param-type as character no-undo .
     1776   define variable v-value-character as character no-undo .
     1777   define variable v-value-date as date no-undo .
     1778   define variable v-value-decimal as decimal no-undo .
     1779   define variable v-value-integer as INTEGER no-undo .
     1780   define variable v-value-logical AS LOGICAL no-undo .
     1781   FOR EACH thbjattr_thbj-attr:
     1782     delete thbjattr_thbj-attr.
     1783   end.
     1784   FOR EACH temp-thbj-attr:
     1785     delete temp-thbj-attr.
     1786   end.
     1787   run adm/shattri.p (
     1788                 input "init":U
     1789               , input p-obj-type
     1790               , input p-obj-code
     1791               , input 'staff':U
     1792               , input "":U
     1793               , output v-value-character
     1794               , output v-value-date
     1795               , output v-value-decimal
     1796               , output v-value-integer
     1797               , output v-value-logical
     1798               , output v-param-type
     1799               , INPUT-OUTPUT TABLE-handle v-tth
     1800               ) no-error .
     1801   if error-status:error
     1802   and not available locked_thbj-attr then do:
     1803     message
     1804     "Не удалось получить начальные значения настроек" skip
     1805     error-status:get-message(1) return-value
     1806     view-as alert-box error .
     1807     undo, return error .
     1808   end.
     1809   FOR EACH thbjattr_thbj-attr:
     1810     ASSIGN
     1811     v-entry = thbjattr_thbj-attr.prop-code.
     1812       IF v-entry = "noanshftstaff" THEN DO:     assign     t-noanshftstaff = thbjattr_thbj-attr.property-value-logical     t-noanshftstaff:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1813       IF v-entry = "obyznumbukv" THEN DO:     assign     t-obyznumbukv = thbjattr_thbj-attr.property-value-logical     t-obyznumbukv:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1814       IF v-entry = "obyznumbukvAdm" THEN DO:     assign     t-obyznumbukvAdm = thbjattr_thbj-attr.property-value-logical     t-obyznumbukvAdm:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1815         IF v-entry = "minparol" THEN DO:     assign     t-minparol = thbjattr_thbj-attr.property-value-integer     t-minparol:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1816       IF v-entry = "minparolAdm" THEN DO:     assign     t-minparolAdm = thbjattr_thbj-attr.property-value-integer     t-minparolAdm:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1817       IF v-entry = "TimeAvail" THEN DO:     assign     t-TimeAvail = thbjattr_thbj-attr.property-value-integer     t-TimeAvail:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1818       IF v-entry = "TimeAvailAdm" THEN DO:     assign     t-TimeAvailAdm = thbjattr_thbj-attr.property-value-integer     t-TimeAvailAdm:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1819       IF v-entry = "TimeBlock" THEN DO:     assign     t-TimeBlock = thbjattr_thbj-attr.property-value-integer     t-TimeBlock:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1820       IF v-entry = "TimeBlockAdm" THEN DO:     assign     t-TimeBlockAdm = thbjattr_thbj-attr.property-value-integer     t-TimeBlockAdm:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1821       IF v-entry = "LastPaswd" THEN DO:     assign     t-LastPaswd = thbjattr_thbj-attr.property-value-integer     t-LastPaswd:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1822       IF v-entry = "LastPaswdAdm" THEN DO:     assign     t-LastPaswdAdm = thbjattr_thbj-attr.property-value-integer     t-LastPaswdAdm:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))     .   END.
     1823     create temp-thbj-attr.
     1824     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1825   END.
     1826   END PROCEDURE.
     1827   PROCEDURE MyEnable :
     1828   ASSIGN
     1829   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1830   .
     1831       IF p-obj-type = '' and p-obj-code = 0 THEN DO:
     1832          define variable VsuperAdm as logical no-undo.
     1833          find first user-account-attr where user-account-attr.user-id    eq g#userid
     1834                                      and user-account-attr.attr-code  eq "superadm"
     1835          no-lock no-error.
     1836          VsuperAdm = available user-account-attr and logical(user-account-attr.attr-value) eq yes no-error.
     1837           display
     1838           t-noanshftstaff t-obyznumbukv t-minparol t-obyznumbukvAdm t-minparolADm t-TimeAvail t-TimeBlock t-LastPaswd t-TimeAvailAdm t-TimeBlockAdm t-LastPaswdAdm
     1839           WITH FRAME Dialog-Frame.
     1840           ENABLE
     1841           B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1842           b-quit
     1843           B-Help
     1844           t-noanshftstaff    WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1845           t-obyznumbukv      WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1846           t-minparol         WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1847           t-TimeAvail        WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1848           t-TimeBlock        WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1849           t-LastPaswd        WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1850           t-obyznumbukvAdm   WHEN p-mode = 'ИЗМЕНЕНИЕ':U and VsuperAdm
     1851           t-minparolAdm      WHEN p-mode = 'ИЗМЕНЕНИЕ':U and VsuperAdm
     1852           t-TimeAvailAdm     WHEN p-mode = 'ИЗМЕНЕНИЕ':U and VsuperAdm
     1853           t-TimeBlockAdm     WHEN p-mode = 'ИЗМЕНЕНИЕ':U and VsuperAdm
     1854           t-LastPaswdAdm     WHEN p-mode = 'ИЗМЕНЕНИЕ':U and VsuperAdm
     1855           WITH FRAME Dialog-Frame.
     1856       END.
     1857       ELSE DO:
     1858           DISPLAY
     1859           t-noanshftstaff
     1860           WITH FRAME Dialog-Frame.
     1861           ENABLE
     1862           B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1863           b-quit
     1864           B-Help
     1865           t-noanshftstaff WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1866           WITH FRAME Dialog-Frame.
     1867       END.
     1868       VIEW FRAME Dialog-Frame.
     1869       IF p-mode = 'ПРОСМОТР':U THEN DO:
     1870         HIDE
     1871         b-exit
     1872         IN FRAME Dialog-Frame.
     1873         ASSIGN
     1874         b-quit:LABEL = "&Выход"
     1875         .
     1876       END.
     1877   END PROCEDURE.
     1878   PROCEDURE proc-save :
     1879   define variable v-value-character as character no-undo .
     1880   define variable v-value-date as date no-undo .
     1881   define variable v-value-decimal as decimal no-undo .
     1882   define variable v-value-integer as INTEGER no-undo .
     1883   define variable v-value-logical AS LOGICAL no-undo .
     1884   define variable v-param-type as character no-undo .
     1885   define variable wh as widget-handle no-undo .
     1886   define variable fh as widget-handle no-undo .
     1887   define variable v-same as logical no-undo .
     1888   DEFINE VARIABLE l-shift-on AS LOGICAL NO-UNDO.
     1889   DEFINE VARIABLE v-t-shft AS integer NO-UNDO.
     1890   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1891   ASSIGN
     1892   FRAME Dialog-Frame
     1893   t-noanshftstaff t-obyznumbukv t-minparol t-LastPaswd t-LastPaswdAdm t-minparolAdm
     1894   t-obyznumbukvAdm t-TimeAvail t-TimeAvailAdm t-TimeBlock t-TimeBlockAdm
     1895   .
     1896   assign
     1897   fh = frame Dialog-Frame:first-child
     1898   wh = fh:first-child
     1899   .
     1900   do while valid-handle(wh):
     1901     if wh:private-data begins "recid=" then do:
     1902       find first thbjattr_thbj-attr where
     1903                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1904       if wh:sensitive
     1905       or wh:name = "zero-cashier"
     1906       then do:
     1907         assign
     1908         buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1909       end.
     1910     end.
     1911     wh = wh:next-sibling.
     1912   end.
     1913   v-same = yes.
     1914   for each thbjattr_thbj-attr,
     1915       first temp-thbj-attr where
     1916             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1917         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1918         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1919         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1920      buffer-compare
     1921      thbjattr_thbj-attr
     1922      to temp-thbj-attr
     1923      save result in v-same.
     1924      if v-same = no then leave.
     1925   end.
     1926   v-same = no.
     1927   IF v-same  and not v-to-create THEN RETURN.
     1928   run adm/shattri.p (
     1929                 input "check":U
     1930                , input p-obj-type
     1931                , input p-obj-code
     1932                , input 'staff':U
     1933                , INPUT '':U
     1934                , output v-value-character
     1935                , output v-value-date
     1936                , output v-value-decimal
     1937                , output v-value-integer
     1938                , output v-value-logical
     1939                , output v-param-type
     1940                , input-output TABLE-handle v-tth
     1941               ) no-error .
     1942   if error-status:error then do:
     1943     message
     1944     "Некорректное значение ПАРАМЕТРОВ" skip
     1945     error-status:get-message(1) skip
     1946     return-value
     1947     view-as alert-box error .
     1948     undo, return error .
     1949   end.
     1950   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1951        input p-obj-type
     1952       ,input p-obj-code
     1953       ,input 'staff':U
     1954       ,input table thbjattr_thbj-attr
     1955   ) NO-ERROR.
     1956   IF ERROR-STATUS:error THEN do:
     1957     MESSAGE ERROR-STATUS:get-message(1) SKIP
     1958     RETURN-VALUE
     1959     VIEW-AS ALERT-BOX.
     1960     UNDO, RETURN ERROR.
     1961   END.
     1962   END PROCEDURE.
