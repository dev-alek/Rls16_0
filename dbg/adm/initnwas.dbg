        1   block-level on error undo, throw.
        2   define input  parameter p-artic     like ub.goods.artic     no-undo.
        3   define input  parameter p-prod-type like ub.goods.prod-type no-undo.
        4   define input  parameter p-prod-code like ub.goods.prod-code no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: initnwas.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: adm/initnwas.p $":U .
       10   define variable vss-description as character no-undo init "Процедура инициализации атрибута insalepr".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   do
       70   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       71   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       72   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       73   :
       74     define variable v-ind as integer   no-undo .
       75     define buffer buf_goods        for ub.goods .
       76     define buffer buf_clients      for ub.clients .
       77     define buffer buf_gds-obj-attr for ub.gds-obj-attr .
       78     define variable v-db-num          as integer   no-undo .
       79     define variable v-object          as character no-undo .
       80     define variable v-gds-name        as character no-undo .
       81     define variable v-artic           as character no-undo .
       82     define variable w-initnwast       as widget-handle no-undo.
       83     define variable v-err-message     as character no-undo .
       84     create widget-pool "wind-info" .
       85     create window w-initnwast assign
       86            title              = "Перенос атрибута Нормы естественной убыли для топлива"
       87            column             = 31.5
       88            row                = 9
       89            height             = 4.0
       90            width              = 50
       91            resize             = false
       92            scroll-bars        = false
       93            status-area        = false
       94            three-d            = true
       95            message-area       = false
       96            sensitive          = true
       97            visible            = true
       98            .
       99     define frame info-init
      100       v-gds-name   label "Наим.товара" format "x(30)" skip
      101       v-artic      label "Артикул"     format "x(30)" skip
      102       v-db-num     label "БД"                         skip
      103       v-object     label "Объект"      format "x(30)" skip
      104       with view-as dialog-box side-labels 1 columns three-d title "Перенос атрибута Нормы естественной убыли для топлива"
      105     .
      106     assign
      107       current-window = w-initnwast
      108     .
      109     view frame info-init .
      110     assign
      111       v-err-message = "":U
      112     .
      113     main_block:
      114     do transaction
      115     on error  undo main_block, retry main_block
      116     on stop   undo main_block, retry main_block
      117     on endkey undo main_block, retry main_block
      118     :
      119       if retry then do:
      120         assign
      121           v-err-message = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      122         .
      123       end.
      124       find first ub.goods
      125            where ub.goods.artic     = p-artic
      126            and   ub.goods.prod-type = p-prod-type
      127            and   ub.goods.prod-code = p-prod-code
      128            exclusive-lock no-error
      129            .
      130            if available ub.goods then do:
      131               do with frame info-init
      132               :
      133                 assign
      134                   v-gds-name  :screen-value = string( ub.goods.gds-name, v-gds-name :format)
      135                   v-artic     :screen-value = string( ub.goods.artic, v-artic  :format)
      136                   v-db-num    :screen-value = string( ?,    v-db-num :format)
      137                   v-object    :screen-value = string( "":U, v-object :format)
      138                 .
      139               end.
      140               for each buf_clients
      141                   where buf_clients.db-num <> ?
      142                   on error undo main_block, retry main_block
      143                    :
      144                     if NOT can-find (first buf_gds-obj-attr
      145                       where buf_gds-obj-attr.obj-type  = buf_clients.obj-type
      146                         and buf_gds-obj-attr.obj-code  = buf_clients.obj-code
      147                         and buf_gds-obj-attr.gds-code  = ub.goods.gds-code
      148                         and buf_gds-obj-attr.attr-code = 'normal-wastage-o':U)
      149                     then do:
      150                       do with frame info-init
      151                       :
      152                         assign
      153                           v-gds-name  :screen-value = string( ub.goods.gds-name,    v-gds-name :format)
      154                           v-artic     :screen-value = string( ub.goods.artic,       v-artic    :format)
      155                           v-db-num    :screen-value = string( buf_clients.db-num,   v-db-num   :format)
      156                           v-object    :screen-value = string( substitute( "&1 &2", buf_clients.obj-type, buf_clients.obj-code), v-object :format)
      157                       .
      158                       end.
      159                       create buf_gds-obj-attr .
      160                       assign
      161                         buf_gds-obj-attr.obj-type   = buf_clients.obj-type
      162                         buf_gds-obj-attr.obj-code   = buf_clients.obj-code
      163                         buf_gds-obj-attr.gds-code   = ub.goods.gds-code
      164                         buf_gds-obj-attr.attr-code  = 'normal-wastage-o':U
      165                         buf_gds-obj-attr.attr-value = string(ub.goods.normal-wastage)
      166                       .
      167                       release buf_gds-obj-attr.
      168                     end.
      169               end.
      170               assign
      171                ub.goods.normal-wastage = 0
      172               .
      173            end.
      174     end.
      175     hide frame info-init .
      176     delete object w-initnwast .
      177     delete widget-pool "wind-info" .
      178     if v-err-message <> "":U then do:
      179       return error v-err-message .
      180     end.
      181     else do:
      182       return .
      183     end.
      184   end.
