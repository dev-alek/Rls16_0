        1   using ibs.th.adm.upd.*.
        2   using ibs.th.gbl.*.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Окно входа в систему".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   define variable v-cConnect          as character no-undo .
      109   define variable v-fltConnect        as character no-undo .
      110   define variable v-user-entered      as logical   no-undo init false .
      111   define variable v-name-for-load-cfg as character no-undo .
      112   define variable v-name-for-init-db  as character no-undo .
      113   define variable v-fname-cfg         as character no-undo .
      114   define variable v-err-code          as integer   no-undo .
      115   define variable v-try-connect       as logical   no-undo init false .
      116   define variable v-is-copy           as logical   no-undo init false .
      117   define variable v-load-cfg          as logical      no-undo.
      118   define variable v-vid-ok            as logical  no-undo .
      119   DEFINE VARIABLE v-updating          as logical   no-undo init false .
      120   define variable v-vid-mes           as character no-undo .
      121   define variable v-vid-param         as longchar no-undo .
      122   define variable v-vid-descr         as character no-undo .
      123   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
      124   DEFINE BUTTON b-OK AUTO-GO  NO-FOCUS
      125        LABEL "&Ввод":L
      126        SIZE 10 BY 1
      127        BGCOLOR 15 .
      128   DEFINE BUTTON b-quit AUTO-END-KEY  NO-FOCUS
      129        LABEL "&Отмена":L
      130        SIZE 10 BY 1.
      131   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
      132        LABEL "Логин"
      133        VIEW-AS FILL-IN
      134        SIZE 20 BY 1 NO-UNDO.
      135   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
      136        LABEL "Пароль"
      137        VIEW-AS FILL-IN
      138        SIZE 20 BY 1 NO-UNDO.
      139   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
      140        LABEL "Пароль"
      141        VIEW-AS FILL-IN
      142        SIZE 20 BY 1 NO-UNDO.
      143   DEFINE IMAGE IMAGE-1
      144        FILENAME "cmp/ith.bmp":U
      145        SIZE 40 BY 8.88.
      146   DEFINE FRAME FRAME-A
      147        b-OK AT ROW 8.04 COL 11.75
      148        name AT ROW 4.96 COL 10 COLON-ALIGNED
      149        password AT ROW 6.17 COL 10 COLON-ALIGNED PASSWORD-FIELD
      150        password_display AT ROW 6.17 COL 10 COLON-ALIGNED  PASSWORD-FIELD
      151        b-quit AT ROW 8.04 COL 21.88
      152        IMAGE-1 AT ROW 1.08 COL 1.13
      153       WITH 1 DOWN NO-BOX OVERLAY
      154            SIDE-LABELS THREE-D
      155            AT COL 1 ROW 1
      156            SIZE 40.13 BY 8.96.
      157   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      158     CREATE WINDOW w-login ASSIGN
      159            HIDDEN             = YES
      160            TITLE              = "Trade House 16.0"
      161            COLUMN             = 27
      162            ROW                = 7.58
      163            HEIGHT             = 9.13
      164            WIDTH              = 40.25
      165            MAX-HEIGHT         = 35.63
      166            MAX-WIDTH          = 160
      167            VIRTUAL-HEIGHT     = 35.63
      168            VIRTUAL-WIDTH      = 160
      169            RESIZE             = no
      170            SCROLL-BARS        = yes
      171            STATUS-AREA        = no
      172            BGCOLOR            = ?
      173            FGCOLOR            = ?
      174            THREE-D            = yes
      175            MESSAGE-AREA       = no
      176            SENSITIVE          = yes.
      177   ELSE w-login = CURRENT-WINDOW.
      178   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      179   THEN w-login:HIDDEN = no.
      180   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      181       IF NOT v-updating THEN DO:
      182           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      183       END.
      184   END.
      185   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      186       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      187              ASSIGN
      188              v-updating = TRUE
      189              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      190              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      191              v-updating = FALSE.
      192              System.Windows.Forms.Clipboard:Clear().
      193              RETURN NO-APPLY.
      194       END.
      195   END.
      196   ON CHOOSE OF b-OK IN FRAME FRAME-A
      197   DO:
      198     if name :screen-value = ""
      199     then do:
      200       message
      201         "Введите имя пользователя"
      202         view-as alert-box information .
      203       apply "entry" to name .
      204       return no-apply .
      205     end.
      206   END.
      207   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      208   on help of frame FRAME-A
      209   do:
      210     run gbl/app_help.p
      211       (input this-procedure :file-name
      212       ,input ''
      213       ,input ?
      214       ) no-error.
      215     if error-status :error then do:
      216       message
      217         "Ошибка при вызове помощи"
      218         error-status :get-message(1)
      219         view-as alert-box .
      220     end.
      221   end.
      222   on "ENTRY" of b-ok do:
      223     if lastkey = keycode ("RETURN") then do:
      224       apply "CHOOSE" to b-ok in frame FRAME-A.
      225     end.
      226   end.
      227   on window-close of w-login do:
      228     apply "end-error" to frame FRAME-A.
      229   end.
      230   ASSIGN
      231     CURRENT-WINDOW             = w-login
      232     SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO)
      233     session:three-d = yes
      234   .
      235   PAUSE 0 BEFORE-HIDE.
      236   if session:date-format <> "dmy":U
      237     or session:numeric-decimal-point <> ".":U
      238     or session:numeric-separator <> ",":U
      239   then do:
      240     message
      241       vss-workfile vss-revision vss-description skip
      242       "Неправильные установки сессии progress!" skip
      243       "Формат даты должен быть - " "'dmy'":U skip
      244       "Десятичный разделитель - " "'.'":U skip
      245       "Разделитель тысяч - " "','":U skip
      246       view-as alert-box error .
      247     quit.
      248   end.
      249   IMAGE-1 :load-image("cmp/ith.bmp") .
      250   enable
      251     name password password_display b-ok b-quit
      252     with frame FRAME-A in window w-login .
      253     password:VISIBLE = FALSE.
      254   assign
      255     session :data-entry-return = yes
      256   .
      257   define variable v-num-entries as integer no-undo.
      258   define variable ind as integer no-undo.
      259   define variable v-param as character no-undo.
      260   define variable v-param-name as character no-undo.
      261   define variable v-param-value as character no-undo.
      262   define variable vAutolog as logical no-undo.
      263   define variable v-preconnection as logical no-undo.
      264   if SESSION:PARAMETER <> "":U
      265     and SESSION:PARAMETER <> ?
      266   then do:
      267     assign
      268       v-num-entries = num-entries( SESSION:PARAMETER, ",":U )
      269     .
      270     do ind = 1 to v-num-entries :
      271       assign
      272         v-param = entry( ind, SESSION:PARAMETER, ",":U )
      273       .
      274       if num-entries( v-param, ":":U ) > 1 then do:
      275         assign
      276           v-param-name  = entry( 1, v-param, ":":U )
      277           v-param-value = substring( v-param, length( v-param-name ) + 2 )
      278         .
      279         case v-param-name :
      280           when "U":U then do:
      281             if vAutolog
      282             then
      283             assign
      284               name = v-param-value
      285             .
      286           end.
      287           when "P":U then do:
      288              if vAutolog
      289              then
      290             assign
      291               password = v-param-value
      292             .
      293           end.
      294           when "M":U then do:
      295           end.
      296           when "A":U then do:
      297              if v-param-value = "admsys"
      298              then
      299              vAutolog = yes.
      300           end.
      301           otherwise do:
      302             message
      303               substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      304               substitute("Параметр игнорируется.") skip
      305               view-as alert-box information .
      306           end.
      307         end case.
      308       end.
      309       else do:
      310         message
      311           substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      312           substitute("Параметр игнорируется.") skip
      313           view-as alert-box information .
      314       end.
      315     end.
      316     if name <> "":U
      317       and password <> "":U
      318     then do:
      319       run utl/chkstrgbl.p.
      320       run adm/autoinit.p ( input name
      321                       ,input password
      322                     ) no-error.
      323       run adm/autoconn.p no-error.
      324       if error-status :error then do:
      325         assign
      326           password = "":U
      327         .
      328       end.
      329       else do:
      330         assign
      331           v-preconnection = TRUE
      332         .
      333       end.
      334       run gbl/dbdiscon.p no-error.
      335     end.
      336   end.
      337   do1:
      338   do
      339   on error  undo, leave
      340   on endkey undo, leave
      341   on stop   undo, leave
      342   :
      343     if lookup( '.', propath) > 0
      344     then do:
      345       define variable v-home-directory as character no-undo .
      346       define variable v-ind as integer   no-undo .
      347       define variable v-num-entries-propath as integer   no-undo .
      348       define variable v-old-propath         as character no-undo .
      349       define variable v-new-propath         as character no-undo .
      350       define variable v-path-item           as character no-undo .
      351       assign
      352         file-info :file-name = '.'
      353         v-home-directory = file-info :full-pathname
      354       .
      355       assign
      356         v-old-propath = propath
      357         v-new-propath = ''
      358       .
      359       assign
      360         v-num-entries-propath = num-entries(v-old-propath)
      361       .
      362       do v-ind = 1 to v-num-entries-propath
      363       :
      364         assign
      365           v-path-item = entry(v-ind, v-old-propath)
      366         .
      367         if v-path-item = '.'
      368         then do:
      369           assign
      370             v-path-item = v-home-directory
      371           .
      372         end.
      373         assign
      374           v-new-propath = v-new-propath
      375                         + (if v-new-propath <> '' then ',' else '')
      376                         + v-path-item
      377         .
      378       end.
      379       assign
      380         propath = v-new-propath
      381       .
      382     end.
      383     if v-preconnection = FALSE then do:
      384        run enable_ui in this-procedure .
      385        WAIT-FOR GO OF frame FRAME-A focus name.
      386        assign
      387          name
      388          password .
      389     end.
      390     if v-preconnection = FALSE
      391     then
      392         run utl/chkstrgbl.p.
      393     v-cConnect = ibs.th.gbl.gbl-inipar:conPar.
      394     if v-cConnect = ?
      395     or trim (v-cConnect) = ""
      396     then do:
      397       v-vid-descr = substitute("Не указаны параметры подключения к БД (&1)", ibs.th.gbl.gbl-inipar:conParKeyName) .
      398       v-vid-param = substitute("Login=&1&2RESULT=&3&2Description=&4", name, chr(4), "101", v-vid-descr ) .
      399       run trg/video-action.p (input 50,
      400                               input v-vid-param,
      401                               output v-vid-ok,
      402                               output v-vid-mes) .
      403       message v-vid-descr view-as alert-box error .
      404       undo do1, leave.
      405     end.
      406     if index(v-cConnect, '&1':u) = 0
      407     then do:
      408       v-vid-descr = substitute("В строке подключения к БД не указан комбинация символов ~&1 (&1)", ibs.th.gbl.gbl-inipar:conParKeyName) .
      409       v-vid-param = substitute("Login=&1&2RESULT=&3&2Description=&4", name, chr(4), "102", v-vid-descr ) .
      410       run trg/video-action.p (input 50,
      411                               input v-vid-param,
      412                               output v-vid-ok,
      413                               output v-vid-mes) .
      414       message v-vid-descr view-as alert-box error .
      415       undo do1, leave.
      416     end.
      417     assign
      418       v-name-for-load-cfg  = "адм" + '2':U
      419       v-load-cfg           = false
      420     .
      421     if name = v-name-for-load-cfg
      422     then do:
      423       assign
      424         name     = "адм"
      425         v-load-cfg = true
      426       .
      427     end.
      428     v-fltConnect = ibs.th.gbl.gbl-inipar:conParFlt.
      429     if trim (v-fltConnect) = "":U
      430       or trim( v-fltConnect ) = trim( v-cConnect )
      431     then do:
      432       assign
      433         v-fltConnect = ?
      434       .
      435     end.
      436     else do:
      437       if index(v-fltConnect, '&1':u) = 0
      438       then do:
      439         v-vid-descr = substitute("В строке подключения к БД параметров не указана комбинация символов ~&1 (&1)", ibs.th.gbl.gbl-inipar:conParFltKeyName) .
      440         message v-vid-descr view-as alert-box error .
      441         undo do1, leave.
      442       end.
      443     end.
      444     assign
      445       v-try-connect = true
      446     .
      447     run gbl/dbconn.p
      448       (input v-cConnect
      449       ,input v-fltConnect
      450       ,input name
      451       ,input password
      452       ,input-output v-user-entered
      453       ) no-error.
      454     if userid('ub':U) = '':U
      455     then do:
      456       def var vtext as char no-undo.
      457       vtext = return-value.
      458       v-vid-param = "Login=" + name + chr(4) + "RESULT=103" + chr(4) + "Description=Ошибка при подключении к базе данных. " + vtext.
      459       run trg/video-action.p (input 50,
      460                               input v-vid-param,
      461                               output v-vid-ok,
      462                               output v-vid-mes) .
      463       message
      464         "Ошибка при подключении к базе данных" skip
      465         vtext skip
      466         view-as alert-box error .
      467       disconnect ub no-error .
      468       quit.
      469     end.
      470     def var v-isUpdShm as logical no-undo.
      471     run adm/upddb.p (input v-cConnect, output v-isUpdShm) no-error.
      472     if error-status:error
      473     then do:
      474       message
      475         "Ошибка при обновлении схемы БД" skip
      476         return-value skip
      477         view-as alert-box error .
      478       disconnect ub no-error .
      479       quit.
      480     end.
      481     if v-isUpdShm
      482     then do:
      483       run gbl/dbconn.p
      484         (input v-cConnect
      485         ,input v-fltConnect
      486         ,input name
      487         ,input password
      488         ,input-output v-user-entered
      489         ) .
      490       if userid('ub':U) = '':U
      491       then do:
      492         v-vid-param = "Login=" + name + chr(4) + "RESULT=103" + chr(4) + "Description=Ошибка при подключении к базе данных. Неизвестный пользователь".
      493         run trg/video-action.p (input 50,
      494                                 input v-vid-param,
      495                                 output v-vid-ok,
      496                                 output v-vid-mes) .
      497         message
      498           "Ошибка при подключении к базе данных" skip
      499           "Неизвестный пользователь" skip
      500           view-as alert-box error .
      501         disconnect ub no-error .
      502         quit.
      503       end.
      504     end.
      505   end.
      506   assign
      507     session :data-entry-return = no
      508   .
      509   RUN disable_UI.
      510   if v-user-entered
      511   then
      512   DO2:
      513   do
      514   :
      515     run adm/unloaddb.w
      516       (input  name
      517       ,input  password
      518       ,output v-is-copy
      519       ) .
      520     def var v-msg as character no-undo.
      521     if v-is-copy = false
      522     then do:
      523       run adm/chk-db.p no-error .
      524       if error-status :error then do:
      525         v-msg = return-value.
      526         v-vid-param = "Login=" + name + chr(4) + "RESULT=104" + chr(4) + "Description=" + error-status :get-message(1) + ";" + v-msg .
      527         run trg/video-action.p (input 50,
      528                               input v-vid-param,
      529                               output v-vid-ok,
      530                               output v-vid-mes) .
      531         message
      532           error-status :get-message(1) skip v-msg skip
      533           return-value skip
      534           view-as alert-box error .
      535       end.
      536       else do:
      537         if v-load-cfg = true then do:
      538           run adm/checkcnf.p
      539             ( input "cfg-load":U
      540             ) no-error .
      541           if error-status :error
      542             and error-status :get-message(1) <> ""
      543           then do:
      544             message
      545               vss-workfile vss-revision vss-description skip
      546               error-status :get-message(1) skip
      547               return-value skip
      548               view-as alert-box error .
      549           end.
      550         end.
      551         else do:
      552           run adm/chkdbkey.p no-error .
      553           if error-status :error then do:
      554             v-vid-param = "Login=" + name + chr(4) + "RESULT=105" + chr(4) + "Description=Ошибка проверки кодировки ключей БД" .
      555             run trg/video-action.p (input 50,
      556                                   input v-vid-param,
      557                                   output v-vid-ok,
      558                                   output v-vid-mes) .
      559             if error-status :get-message(1) <> "" then do:
      560                 message
      561                   vss-workfile vss-revision vss-description skip
      562                   error-status :get-message(1) skip
      563                   return-value skip
      564                   view-as alert-box error .
      565             end.
      566           end.
      567           else do:
      568             run adm/checkcnf.p
      569               ( input "cfg-check":U
      570               ) no-error .
      571             if error-status :error then do:
      572               v-vid-param = "Login=" + name + chr(4) + "RESULT=106" + chr(4) + "Description=Ошибка проверки параметров" .
      573               run trg/video-action.p (input 50,
      574                                       input v-vid-param,
      575                                       output v-vid-ok,
      576                                       output v-vid-mes) .
      577               if error-status :get-message(1) <> "" then do:
      578                 message
      579                   vss-workfile vss-revision vss-description skip
      580                   error-status :get-message(1) skip
      581                   return-value skip
      582                   view-as alert-box error .
      583               end.
      584             end.
      585             else do:
      586               run gbl/sys-main.p
      587                 (input name
      588                 ,input password
      589                 ) no-error .
      590               if error-status :error then do:
      591                 v-vid-param = "Login=" + name + chr(4) + "RESULT=107" + chr(4) + "Description=" + error-status :get-message(1) .
      592                 run trg/video-action.p (input 50,
      593                                       input v-vid-param,
      594                                       output v-vid-ok,
      595                                       output v-vid-mes) .
      596                 message
      597                   vss-workfile vss-revision vss-description skip
      598                   error-status :get-message(1) skip
      599                   return-value skip
      600                   view-as alert-box error .
      601                 LEAVE DO2.
      602               end.
      603             end.
      604           end.
      605         end.
      606       end.
      607     end.
      608   end.
      609   else do:
      610     if v-try-connect = true
      611     then do:
      612        if error-status :error then do:
      613           v-vid-param = "Login=" + name + chr(4) + "RESULT=108" + chr(4) + "Description=Ошибка при подключении к БД. " + error-status :get-message(1) .
      614           run trg/video-action.p (input 50,
      615                               input v-vid-param,
      616                               output v-vid-ok,
      617                               output v-vid-mes) .
      618           message
      619              "Ошибка при подключении к БД" skip
      620              error-status :get-message(1) skip
      621              return-value skip
      622              view-as alert-box error .
      623           disconnect ub no-error .
      624           quit.
      625        end.
      626        ELSE DO:
      627           v-vid-param = "Login=" + name + chr(4) + "RESULT=109" + chr(4) + "Description=Ошибка при подключении к БД. " + error-status :get-message(1) .
      628           run trg/video-action.p (input 50,
      629                               input v-vid-param,
      630                               output v-vid-ok,
      631                               output v-vid-mes) .
      632           message
      633              "Ошибка при подключении к базе данных" skip
      634              "Обратитесь к администратору" skip
      635              "Строка подключения к БД:" skip
      636              v-cConnect skip
      637              view-as alert-box error .
      638        end.
      639     end.
      640   end.
      641   disconnect ub no-error .
      642   quit.
      643   PROCEDURE ARM-users :
      644   END PROCEDURE.
      645   PROCEDURE disable_UI :
      646     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      647     THEN DELETE WIDGET w-login.
      648     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      649   END PROCEDURE.
      650   PROCEDURE enable_UI :
      651     ENABLE b-OK IMAGE-1 name password_display b-quit
      652         WITH FRAME FRAME-A IN WINDOW w-login.
      653     VIEW w-login.
      654   END PROCEDURE.
