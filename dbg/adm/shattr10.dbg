      495       (input  p-obj-type
      496       ,input  p-obj-code
      497       ,input  p-upper-param-code
      498       ,input  p-mode
      499       ,input-output table-handle p-tth
      500       ,output p-all-found
      501       ) no-error .
      502     if error-status :error
      503     then do:
      504       delete object p-tth.
      505       undo, return error return-value .
      506     end.
      507     delete object p-tth.
      508   end.
      509   end procedure.
