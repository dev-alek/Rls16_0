      620   procedure proc-alt-shift-f2:
      621     if not ibs.th.gbl.gbl-var:rcode
      622   then
      623     run gbl\inidebug.p .
      624   end.
      625   procedure proc-alt-shift-f3:
      626     run gbl/prvssinf.p
      627       ( input this-procedure
      628       ) .
      629   end.
      630   define variable v-inform-launched as logical no-undo initial false .
      631   procedure proc-alt-shift-f4:
      632     define variable v-action as character no-undo .
      633     if v-inform-launched = false then do:
      634       assign
      635         v-inform-launched = true
      636       .
      637       run gbl/d-inform.w
      638         (  input self
      639         ,  input this-procedure
      640         , output v-action
      641         ) no-error .
      642       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      643       assign
      644         v-inform-launched = false
      645       .
      646     end.
      647   end.
      648   procedure proc-alt-f1:
      649     run gbl/corrhelp.p
      650       (input this-procedure
      651       ) .
      652   end .
      653   on alt-shift-f2 anywhere do:
      654     run proc-alt-shift-f2.
      655   end.
      656   on alt-shift-f3 anywhere do:
      657     run proc-alt-shift-f3 in this-procedure .
      658   end.
      659   on alt-shift-f4 anywhere do:
      660     run proc-alt-shift-f4 in this-procedure.
      661   end.
      662   on alt-f1 anywhere do:
      663     run proc-alt-f1 in this-procedure .
      664   end.
      665   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666     define variable v-cntxt-db-num        as integer   no-undo .
      667     define variable v-cntxt-userid        as character no-undo .
      668     define variable v-cntxt-level         as character no-undo .
      669     define variable v-cntxt-host-code-obj as integer   no-undo .
      670     define variable v-cntxt-obj-type      as character no-undo .
      671     define variable v-cntxt-obj-code      as integer   no-undo .
      672     define variable v-cntxt-db-num-obj    as integer   no-undo .
      673     define variable v-cntxt-is-admin      as logical   no-undo .
      674   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      675   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      676   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      677   DEFINE VARIABLE v-host-code LIKE ub.sysconf.host-code NO-UNDO.
      678   DEFINE VARIABLE v-r-b-code LIKE ub.currency.curr-code NO-UNDO.
      679   DEFINE BUFFER buf_currency FOR ub.currency.
      680   DEFINE BUFFER buf_cash-pay-bnal FOR ub.cash-pay.
      681   DEFINE BUFFER buf_cash-pay-nopay FOR ub.cash-pay.
      682   DEFINE BUFFER buf_cash-pay-vip FOR ub.cash-pay.
      683   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      684   define variable v-tth as handle no-undo .
      685   assign
      686   v-tth = buffer thbjattr_thbj-attr:table-handle .
      687   DEFINE BUTTON B-add  NO-FOCUS
      688        LABEL "&Добавить"
      689        SIZE 10 BY 1.
      690   DEFINE BUTTON B-del
      691        LABEL "&Удалить"
      692        SIZE 10 BY 1.
      693   DEFINE BUTTON B-exit AUTO-GO
      694        LABEL "&Ввод"
      695        SIZE 10 BY 1
      696        BGCOLOR 8 .
      697   DEFINE BUTTON B-Help
      698        LABEL "Помо&щь"
      699        SIZE 10 BY 1
      700        BGCOLOR 8 .
      701   DEFINE BUTTON b-mag-bnal
      702        IMAGE-UP FILE "btn-down-arrow":U
      703        IMAGE-DOWN FILE "btn-down-arrow":U
      704        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      705        LABEL "":L
      706        SIZE 3 BY 1
      707        BGCOLOR 8 FGCOLOR 0 .
      708   DEFINE BUTTON b-mag-VIP
      709        IMAGE-UP FILE "btn-down-arrow":U
      710        IMAGE-DOWN FILE "btn-down-arrow":U
      711        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      712        LABEL "":L
      713        SIZE 3 BY 1
      714        BGCOLOR 8 FGCOLOR 0 .
      715   DEFINE BUTTON b-magnopay
      716        IMAGE-UP FILE "btn-down-arrow":U
      717        IMAGE-DOWN FILE "btn-down-arrow":U
      718        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      719        LABEL "":L
      720        SIZE 3 BY 1
      721        BGCOLOR 8 FGCOLOR 0 .
      722   DEFINE BUTTON b-quit AUTO-END-KEY
      723        LABEL "&Отмена"
      724        SIZE 10 BY 1
      725        BGCOLOR 8 .
      726   DEFINE VARIABLE f-mag-bnal AS INTEGER FORMAT ">>>9":U INITIAL 0
      727        LABEL "Тип касс. платежа для безналичной оплаты НА КАССЕ"
      728         VIEW-AS TEXT
      729        SIZE 7 BY .67 NO-UNDO.
      730   DEFINE VARIABLE f-mag-VIP AS INTEGER FORMAT ">>>9":U INITIAL 0
      731        LABEL "Тип касс. платежа для чеков VIP и представит. расходов"
      732         VIEW-AS TEXT
      733        SIZE 7 BY .67 NO-UNDO.
      734   DEFINE VARIABLE f-magnopay AS INTEGER FORMAT ">>>9":U INITIAL 0
      735        LABEL "Тип касс. платежа для НЕОПЛАЧЕННОГО  НА КАССЕ"
      736         VIEW-AS TEXT
      737        SIZE 7 BY .67 NO-UNDO.
      738   DEFINE VARIABLE for-cash-pay-mag-bnal AS CHARACTER FORMAT "X(256)":U
      739         VIEW-AS TEXT
      740        SIZE 20.5 BY .67
      741        FGCOLOR 4  NO-UNDO.
      742   DEFINE VARIABLE for-cash-pay-mag-VIP AS CHARACTER FORMAT "X(256)":U
      743         VIEW-AS TEXT
      744        SIZE 20.5 BY .67
      745        FGCOLOR 4  NO-UNDO.
      746   DEFINE VARIABLE for-cash-pay-magnopay AS CHARACTER FORMAT "X(256)":U
      747         VIEW-AS TEXT
      748        SIZE 20.5 BY .67
      749        FGCOLOR 4  NO-UNDO.
      750   DEFINE QUERY BR-cancell FOR
      751         tt-cancell SCROLLING.
      752   DEFINE BROWSE BR-cancell
      753     QUERY BR-cancell NO-LOCK DISPLAY
      754         tt-cancell.grp-code COLUMN-LABEL "Код списания!возврата!на кассе" FORMAT ">>>>9":U
      755         tt-cancell.grp-name COLUMN-LABEL "Описание" FORMAT "X(30)":U
      756         tt-cancell.return-write-off COLUMN-LABEL "Возврат!Списание" FORMAT "Возврат/Списание"
      757         tt-cancell.object_-name COLUMN-LABEL "Действует на" FORMAT "X(10)"
      758               WIDTH 61.75
      759       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25
      760            TITLE "Коды списания и возврата" ROW-HEIGHT-CHARS .58 EXPANDABLE.
      761   DEFINE FRAME Dialog-Frame
      762        B-add AT ROW 6 COL 1
      763        B-exit AT ROW 1 COL 1
      764        b-quit AT ROW 1 COL 11
      765        B-Help AT ROW 1 COL 54.88
      766        b-mag-bnal AT ROW 3 COL 66
      767        b-magnopay AT ROW 4 COL 66
      768        b-mag-VIP AT ROW 5 COL 66
      769        B-del AT ROW 6 COL 11
      770        BR-cancell AT ROW 7 COL 1
      771        f-mag-bnal AT ROW 3.17 COL 55 COLON-ALIGNED
      772        for-cash-pay-mag-bnal AT ROW 3.17 COL 67 COLON-ALIGNED NO-LABEL
      773        f-magnopay AT ROW 4.17 COL 55 COLON-ALIGNED
      774        for-cash-pay-magnopay AT ROW 4.17 COL 67 COLON-ALIGNED NO-LABEL
      775        f-mag-VIP AT ROW 5.17 COL 55 COLON-ALIGNED
      776        for-cash-pay-mag-VIP AT ROW 5.17 COL 67 COLON-ALIGNED NO-LABEL
      777        SPACE(9.74) SKIP(10.48)
      778       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      779            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      780            TITLE "Параметры POS MAGIA-XML"
      781            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      782   ASSIGN
      783          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      784          FRAME Dialog-Frame:HIDDEN           = TRUE.
      785   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      786   DO:
      787     APPLY "END-ERROR":U TO SELF.
      788   END.
      789   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      790   DO:
      791     DEFINE VARIABLE v-code AS integer NO-UNDO.
      792     define variable v-name as character no-undo.
      793     define variable v-return-write-off as logical no-undo.
      794     define variable v-object as character no-undo.
      795     DEFINE VARIABLE v-log AS logical NO-UNDO.
      796     DEFINE variable v-rid AS RECID NO-UNDO.
      797     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      798     DEFINE BUFFER buf_tt-cancell FOR tt-cancell.
      799   run adm/wromagia.w (output v-code
      800               ,output v-name
      801               ,output v-return-write-off
      802               ,output v-object
      803               ,output v-log) no-error .
      804   if error-status:error
      805   or not v-log then return no-apply.
      806   FIND FIRST buf_tt-cancell NO-LOCK WHERE
      807             buf_tt-cancell.grp-code = v-code NO-ERROR.
      808   IF AVAILABLE buf_tt-cancell THEN DO:
      809        MESSAGE
      810           "Вы уже задали соответствие для кода возврата/списания" v-code
      811           VIEW-AS ALERT-BOX.
      812           RETURN NO-APPLY.
      813   END.
      814   CREATE tt-cancell.
      815   ASSIGN
      816   tt-cancell.grp-code = v-code
      817   tt-cancell.grp-name = v-name
      818   tt-cancell.return-write-off = v-return-write-off
      819   tt-cancell.object_ = v-object
      820   tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ").
      821   v-rid = RECID(tt-cancell)
      822   .
      823   OPEN QUERY BR-cancell FOR EACH tt-cancell NO-LOCK INDEXED-REPOSITION.
      824   REPOSITION br-cancell TO RECID v-rid.
      825   END.
      826   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      827   DO:
      828     IF NOT AVAILABLE tt-cancell THEN RETURN NO-APPLY.
      829     DELETE tt-cancell.
      830     OPEN QUERY BR-cancell FOR EACH tt-cancell NO-LOCK INDEXED-REPOSITION.
      831     REPOSITION br-cancell TO ROW 1.
      832   END.
      833   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      834   DO:
      835     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      836     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      837   END.
      838   ON CHOOSE OF b-mag-bnal IN FRAME Dialog-Frame
      839   DO:
      840       define variable v-rid-list as character no-undo.
      841       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      842       run ref/cashpays.w (
      843                      input parparentproc
      844                     ,input "b-sel"
      845                     ,input 'все':U
      846                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      847                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      848                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      849                     ,output v-rid-list ).
      850       if v-rid-list <> "":U then do:
      851         FIND FIRST buf_cash-pay WHERE
      852                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      853         IF buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      854             MESSAGE
      855             substitute("Нужно выбрать тип кассового платежа с валютой &1 - валюта продажи на фирме &2", buf_currency.curr-code, v-host-code)
      856             VIEW-AS ALERT-BOX ERROR.
      857             RETURN NO-APPLY.
      858         END.
      859         DISPLAY
      860         buf_cash-pay.cdpay-code @ f-mag-bnal
      861         buf_cash-pay.obj-name @ for-cash-pay-mag-bnal
      862         with frame Dialog-Frame .
      863       end.
      864   END.
      865   ON CHOOSE OF b-mag-VIP IN FRAME Dialog-Frame
      866   DO:
      867       define variable v-rid-list as character no-undo.
      868       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      869       run ref/cashpays.w (
      870                      input parparentproc
      871                     ,input "b-sel"
      872                     ,input 'все':U
      873                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      874                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      875                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      876                     ,output v-rid-list ).
      877       if v-rid-list <> "":U then do:
      878         FIND FIRST buf_cash-pay WHERE
      879                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      880         IF buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      881             MESSAGE
      882             substitute("Нужно выбрать тип кассового платежа с валютой &1 - валюта продажи на фирме &2", buf_currency.curr-code, v-host-code)
      883             VIEW-AS ALERT-BOX ERROR.
      884             RETURN NO-APPLY.
      885         END.
      886         DISPLAY
      887         buf_cash-pay.cdpay-code @ f-mag-vip
      888         buf_cash-pay.obj-name @ for-cash-pay-mag-vip
      889         with frame Dialog-Frame .
      890       end.
      891   END.
      892   ON CHOOSE OF b-magnopay IN FRAME Dialog-Frame
      893   DO:
      894       define variable v-rid-list as character no-undo.
      895       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      896       run ref/cashpays.w (
      897                      input parparentproc
      898                     ,input "b-sel"
      899                     ,input 'все':U
      900                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      901                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      902                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      903                     ,output v-rid-list ).
      904       if v-rid-list <> "":U then do:
      905         FIND FIRST buf_cash-pay WHERE
      906                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      907         IF buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      908             MESSAGE
      909             substitute("Нужно выбрать тип кассового платежа с валютой &1 - валюта продажи на фирме &2", buf_currency.curr-code, v-host-code)
      910             VIEW-AS ALERT-BOX ERROR.
      911             RETURN NO-APPLY.
      912         END.
      913         DISPLAY
      914         buf_cash-pay.cdpay-code @ f-magnopay
      915         buf_cash-pay.obj-name @ for-cash-pay-magnopay
      916         with frame Dialog-Frame .
      917       end.
      918   END.
      919   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      920   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      921   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      922   on help of frame Dialog-Frame
      923   do:
      924     run gbl/app_help.p
      925       (input this-procedure :file-name
      926       ,input ''
      927       ,input ?
      928       ) no-error.
      929     if error-status :error then do:
      930       message
      931         "Ошибка при вызове помощи"
      932         error-status :get-message(1)
      933         view-as alert-box .
      934     end.
      935   end.
      936   run minbtn-set in this-procedure .
      937   on choose of b-help in frame Dialog-Frame
      938   do:
      939     apply "help":u to frame Dialog-Frame .
      940   end.
      941   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   procedure minbtn-set :
      943       do
      944           on error undo, return error return-value
      945           :
      946           define variable ii              as integer       no-undo .
      947           define variable fh              as widget-handle no-undo .
      948           define variable hh              as widget-handle no-undo .
      949           define variable v-h             as handle        extent 4 no-undo .
      950           define variable v-name-button   as character     no-undo .
      951           define variable v-help-old-x    as decimal       no-undo .
      952           define variable v-help-old-y    as decimal       no-undo .
      953           define variable v-help-old-size as decimal       no-undo .
      954           define variable v-frame-width   as decimal       no-undo .
      955           define variable jj              as integer       no-undo .
      956           do
      957               on error undo, return error
      958               :
      959               assign
      960                   v-frame-width = frame Dialog-Frame:width - 0.3
      961                   fh            = frame Dialog-Frame:first-child
      962                   hh            = fh:first-child
      963                   ii            = 1
      964                   .
      965               do while valid-handle(hh):
      966                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      967                   do:
      968                       case lc(hh:name) :
      969                           when "b-help" then
      970                               do:
      971                                   hh:load-image-up("cmp/b-help.bmp":u) .
      972                                   hh:load-image-down("cmp/b-help.bmp":u) .
      973                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      974                                   hh:TOOLTIP = "Помощь" .
      975                                   v-help-old-x = hh:column .
      976                                   v-help-old-y = hh:row    .
      977                                   v-help-old-size = hh:width .
      978                                   hh:width-chars = 2.5 .
      979                               end.
      980                           when "b-print" then
      981                               do:
      982                                   hh:load-image("cmp/b-print.bmp":u) .
      983                                   hh:TOOLTIP = "Печать" .
      984                                   v-h[ii] = hh:handle .
      985                                   ii = ii + 1 .
      986                                   hh:width-chars = 3 .
      987                               end.
      988                           when "b-history" or
      989                           when "b-hist" then
      990                               do:
      991                                   hh:load-image("cmp/b-hist.bmp":u) .
      992                                   hh:TOOLTIP = "История" .
      993                                   v-h[ii] = hh:handle .
      994                                   ii = ii + 1 .
      995                                   hh:width-chars = 3 .
      996                               end.
      997                           when "b-sch" then
      998                               do:
      999                                   hh:load-image("cmp/b-sch.bmp":u) .
     1000                                   hh:TOOLTIP = "Установка Фильтра" .
     1001                                   v-h[ii] = hh:handle .
     1002                                   ii = ii + 1 .
     1003                                   hh:width-chars = 3 .
     1004                               end.
     1005                           when "b-hist-user" then
     1006                               do:
     1007                                   hh:load-image("cmp/b-hist.bmp":u) .
     1008                                   hh:TOOLTIP = "История пользователя" .
     1009                                   ii = ii + 1 .
     1010                               end.
     1011                       end case.
     1012                   end.
     1013                   hh = hh:next-sibling.
     1014               end.
     1015               b-help:column = v-frame-width - b-help:width-chars.
     1016               jj = 0.
     1017               repeat ii = 4 to 1 by -1 :
     1018                   if valid-handle (v-h[ii] ) then
     1019                   do:
     1020                       jj  = jj + 1 .
     1021                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1022                       v-h[ii]:row    = v-help-old-y .
     1023                   end.
     1024               end.
     1025           end.
     1026       end.
     1027   end procedure.
     1028   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1029   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1030   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1031   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1032   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1033   define variable v-diasize-current-frame-height as decimal   no-undo .
     1034   define variable v-diasize-change-size          as logical   no-undo .
     1035   define variable v-diasize-resize-button        as handle    no-undo .
     1036   define variable v-diasize-wndmax               as logical   no-undo .
     1037   define variable v-diasize-wndstore             as logical   no-undo .
     1038   define variable v-diasize-proc-name            as character no-undo .
     1039   define variable v-diasize-browse-handle        as handle    no-undo .
     1040   define variable v-diasize-browse-number        as integer   no-undo .
     1041   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1042   define temp-table temp-diasize-handle no-undo
     1043     field handle-value  as handle
     1044     field save-position as decimal
     1045     index xpk is primary unique handle-value
     1046     .
     1047   define temp-table temp-browse-handle no-undo
     1048     field browse-type   as character
     1049     field browse-number as integer
     1050     field browse-handle as handle
     1051     field original-size as decimal
     1052     index xpk is primary unique browse-type browse-number
     1053     index xie browse-type browse-handle
     1054   .
     1055   procedure diasize_change-height :
     1056     define input  parameter p-change-value  as decimal   no-undo .
     1057     define input  parameter p-move-resize   as logical   no-undo .
     1058     define variable v-field-group-handle    as handle    no-undo .
     1059     define variable v-object-handle         as handle    no-undo .
     1060     define variable v-frame-height          as decimal   no-undo .
     1061     define variable v-frame-virtual-height  as decimal   no-undo .
     1062     define variable v-browse-height         as decimal   no-undo .
     1063     define variable v-window-height         as decimal   no-undo .
     1064     define variable v-window-virtual-height as decimal   no-undo .
     1065     define variable v-change-sign           as integer   no-undo .
     1066     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1067     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1068     if p-change-value > 0
     1069     then do:
     1070       if frame Dialog-Frame :height + p-change-value
     1071           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1072       then do:
     1073         assign
     1074           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1075                           - (frame Dialog-Frame :height-chars)
     1076         .
     1077         if p-change-value <= 0
     1078         then do:
     1079           run diasize_position-resize-button in this-procedure .
     1080           return .
     1081         end.
     1082       end.
     1083     end.
     1084     if p-change-value < 0
     1085     then do:
     1086       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1087       then do:
     1088         assign
     1089           p-change-value = v-diasize-orig-frame-height
     1090                          - (frame Dialog-Frame :height-chars)
     1091         .
     1092         if p-change-value >= 0
     1093         then do:
     1094           run diasize_position-resize-button in this-procedure .
     1095           return .
     1096         end.
     1097       end.
     1098     end.
     1099     if p-change-value >= 0
     1100     then do:
     1101       assign
     1102         v-change-sign = 1
     1103       .
     1104     end.
     1105     else do:
     1106       assign
     1107         v-change-sign = -1
     1108       .
     1109     end.
     1110     assign
     1111       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1112     .
     1113     if p-change-value = 0
     1114     then do:
     1115       run diasize_position-resize-button in this-procedure .
     1116       return .
     1117     end.
     1118     move_block:
     1119     do
     1120     on error undo move_block, retry move_block
     1121     :
     1122       if retry
     1123       then do:
     1124         do
     1125         on error undo move_block, leave move_block
     1126         :
     1127           if p-change-value > 0
     1128           then do:
     1129             for each buf_temp-diasize-handle
     1130             on error undo, next
     1131             :
     1132               assign
     1133                 v-object-handle = buf_temp-diasize-handle.handle-value
     1134               .
     1135               if v-object-handle <> v-diasize-resize-button
     1136               then do:
     1137                 assign
     1138                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1139                 .
     1140               end.
     1141             end.
     1142             assign
     1143               v-diasize-browse-handle :height = v-browse-height
     1144             .
     1145             for each buf_temp-browse-handle
     1146               where buf_temp-browse-handle.browse-type = 'height':u
     1147             on error undo, next
     1148             :
     1149               assign
     1150                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1151               .
     1152             end.
     1153             assign
     1154               frame Dialog-Frame :height = v-frame-height
     1155             .
     1156             if frame Dialog-Frame :scrollable = true
     1157             then do:
     1158               assign
     1159                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1160               .
     1161             end.
     1162             run diasize_position-resize-button in this-procedure .
     1163           end.
     1164           else do:
     1165             if frame Dialog-Frame :scrollable = true
     1166             then do:
     1167               assign
     1168                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1169               .
     1170             end.
     1171             assign
     1172               frame Dialog-Frame :height = v-frame-height
     1173             .
     1174             assign
     1175               v-diasize-browse-handle :height = v-browse-height
     1176             .
     1177             for each buf_temp-browse-handle
     1178               where buf_temp-browse-handle.browse-type = 'height':u
     1179             on error undo, next
     1180             :
     1181               assign
     1182                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1183               .
     1184             end.
     1185             for each buf_temp-diasize-handle
     1186             on error undo, next
     1187             :
     1188               assign
     1189                 v-object-handle = buf_temp-diasize-handle.handle-value
     1190               .
     1191               if v-object-handle <> v-diasize-resize-button
     1192               then do:
     1193                 assign
     1194                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1195                 .
     1196               end.
     1197             end.
     1198             run diasize_position-resize-button in this-procedure .
     1199           end.
     1200           assign
     1201             v-diasize-change-size = false
     1202           .
     1203           leave move_block .
     1204         end.
     1205       end.
     1206       assign
     1207         v-diasize-need-full-display = true
     1208       .
     1209       if v-diasize-change-size = false
     1210       then do:
     1211         assign
     1212           v-diasize-change-size = true
     1213         .
     1214       end.
     1215       else do:
     1216         return .
     1217       end.
     1218       assign
     1219         v-frame-height = frame Dialog-Frame :height
     1220         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1221         v-browse-height = v-diasize-browse-handle :height
     1222       .
     1223       for each buf_temp-browse-handle
     1224         where buf_temp-browse-handle.browse-type = 'height':u
     1225       :
     1226         assign
     1227           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1228         .
     1229       end.
     1230       for each buf_temp-diasize-handle
     1231       :
     1232         delete buf_temp-diasize-handle .
     1233       end.
     1234       assign
     1235         v-field-group-handle = frame Dialog-Frame :first-child
     1236       .
     1237       do while valid-handle(v-field-group-handle)
     1238       :
     1239         assign
     1240           v-object-handle = v-field-group-handle :first-child
     1241         .
     1242         do while valid-handle(v-object-handle)
     1243         :
     1244           if  v-object-handle <> v-diasize-browse-handle :handle
     1245           and can-query(v-object-handle, "row")
     1246           and can-query(v-object-handle, "height")
     1247           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1248           then do:
     1249             find first buf_temp-browse-handle
     1250               where buf_temp-browse-handle.browse-type   = 'height':u
     1251                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1252               no-error .
     1253             if available buf_temp-browse-handle
     1254             then do:
     1255             end.
     1256             else do:
     1257               create buf_temp-diasize-handle .
     1258               assign
     1259                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1260                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1261               .
     1262             end.
     1263           end.
     1264           assign
     1265             v-object-handle = v-object-handle :next-sibling
     1266           .
     1267         end.
     1268         assign
     1269           v-field-group-handle = v-field-group-handle :next-sibling
     1270         .
     1271       end.
     1272       do with frame Dialog-Frame
     1273       :
     1274         hide v-diasize-resize-button .
     1275         assign
     1276           v-diasize-resize-button :row    = 1
     1277           v-diasize-resize-button :column = 1
     1278         .
     1279       end.
     1280       if p-change-value > 0
     1281       then do:
     1282         if frame Dialog-Frame :scrollable = true
     1283         then do:
     1284           assign
     1285             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1286             no-error .
     1287           if error-status :error
     1288           or error-status :get-message(1) <> ""
     1289           then do:
     1290             undo move_block, retry move_block .
     1291           end.
     1292         end.
     1293         assign
     1294           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1295           no-error .
     1296         if error-status :error
     1297         or error-status :get-message(1) <> ""
     1298         then do:
     1299           undo move_block, retry move_block .
     1300         end.
     1301         assign
     1302           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1303           no-error .
     1304         if error-status :error
     1305         or error-status :get-message(1) <> ""
     1306         then do:
     1307           undo move_block, retry move_block .
     1308         end.
     1309         for each buf_temp-browse-handle
     1310           where buf_temp-browse-handle.browse-type = 'height':u
     1311         on error undo move_block, retry move_block
     1312         :
     1313           assign
     1314             buf_temp-browse-handle.browse-handle :height
     1315               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1316             no-error .
     1317           if error-status :error
     1318           or error-status :get-message(1) <> ""
     1319           then do:
     1320             undo move_block, retry move_block .
     1321           end.
     1322         end.
     1323         for each buf_temp-diasize-handle
     1324         on error undo move_block, retry move_block
     1325         :
     1326           assign
     1327             v-object-handle = buf_temp-diasize-handle.handle-value
     1328           .
     1329           if v-object-handle <> v-diasize-resize-button
     1330           then do:
     1331             assign
     1332               v-object-handle :row = v-object-handle :row + p-change-value
     1333               no-error .
     1334             if error-status :error
     1335             or error-status :get-message(1) <> ""
     1336             then do:
     1337               undo move_block, retry move_block .
     1338             end.
     1339           end.
     1340         end.
     1341       end.
     1342       else do:
     1343         for each buf_temp-diasize-handle
     1344         on error undo move_block, retry move_block
     1345         :
     1346           assign
     1347             v-object-handle = buf_temp-diasize-handle.handle-value
     1348           .
     1349           if v-object-handle <> v-diasize-resize-button
     1350           then do:
     1351             assign
     1352               v-object-handle :row = v-object-handle :row + p-change-value
     1353               no-error .
     1354             if error-status :error
     1355             or error-status :get-message(1) <> ""
     1356             then do:
     1357               undo move_block, retry move_block .
     1358             end.
     1359           end.
     1360         end.
     1361         assign
     1362           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1363           no-error .
     1364         if error-status :error
     1365         or error-status :get-message(1) <> ""
     1366         then do:
     1367           undo move_block, retry move_block .
     1368         end.
     1369         for each buf_temp-browse-handle
     1370           where buf_temp-browse-handle.browse-type = 'height':u
     1371         on error undo move_block, retry move_block
     1372         :
     1373           assign
     1374             buf_temp-browse-handle.browse-handle :height
     1375               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1376             no-error .
     1377           if error-status :error
     1378           or error-status :get-message(1) <> ""
     1379           then do:
     1380             undo move_block, retry move_block .
     1381           end.
     1382         end.
     1383         assign
     1384           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1385           no-error .
     1386         if error-status :error
     1387         or error-status :get-message(1) <> ""
     1388         then do:
     1389           undo move_block, retry move_block .
     1390         end.
     1391         if frame Dialog-Frame :scrollable = true
     1392         then do:
     1393           assign
     1394             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1395             no-error .
     1396           if error-status :error
     1397           or error-status :get-message(1) <> ""
     1398           then do:
     1399             undo move_block, retry move_block .
     1400           end.
     1401         end.
     1402       end.
     1403       if p-move-resize = true
     1404       then do:
     1405         run diasize_position-resize-button in this-procedure .
     1406       end.
     1407       if v-diasize-wndstore = true
     1408       then do:
     1409         if connected("ub") = true
     1410         then do:
     1411           define variable v-cntxt-db-num        as integer   no-undo .
     1412           define variable v-cntxt-userid        as character no-undo .
     1413           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1414                                             , OUTPUT v-cntxt-userid
     1415                                             ) .
     1416           run gbl/wndsizew.p
     1417             (input  v-cntxt-db-num
     1418             ,input  v-cntxt-userid
     1419             ,input  v-diasize-proc-name
     1420             ,input  'height':u
     1421             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1422             ) .
     1423         end.
     1424       end.
     1425     end.
     1426     assign
     1427       v-diasize-change-size = false
     1428     .
     1429   end procedure.
     1430   procedure diasize_set-height :
     1431     define input  parameter p-new-height  as decimal   no-undo .
     1432     define input  parameter p-move-resize as logical   no-undo .
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436       run diasize_change-height in this-procedure
     1437         (input  (p-new-height - frame Dialog-Frame :height)
     1438         ,input  p-move-resize
     1439         ) .
     1440     end.
     1441   end procedure.
     1442   procedure diasize_change-width :
     1443     define input  parameter p-change-value as decimal   no-undo .
     1444     define input  parameter p-move-resize  as logical   no-undo .
     1445     define variable v-field-group-handle   as handle    no-undo .
     1446     define variable v-object-handle        as handle    no-undo .
     1447     define variable v-frame-width          as decimal   no-undo .
     1448     define variable v-frame-virtual-width  as decimal   no-undo .
     1449     define variable v-browse-width         as decimal   no-undo .
     1450     define variable v-window-width         as decimal   no-undo .
     1451     define variable v-window-virtual-width as decimal   no-undo .
     1452     define variable v-change-sign          as integer   no-undo .
     1453     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1454     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1455     if p-change-value > 0
     1456     then do:
     1457       if frame Dialog-Frame :width + p-change-value >
     1458           session :width-chars
     1459       then do:
     1460         assign
     1461           p-change-value = session :width-chars - frame Dialog-Frame :width
     1462         .
     1463         if p-change-value <= 0
     1464         then do:
     1465           run diasize_position-resize-button in this-procedure .
     1466           return .
     1467         end.
     1468       end.
     1469     end.
     1470     if p-change-value < 0
     1471     then do:
     1472       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1473       then do:
     1474         assign
     1475           p-change-value = v-diasize-orig-frame-width
     1476                          - frame Dialog-Frame :width
     1477         .
     1478         if p-change-value >= 0
     1479         then do:
     1480           run diasize_position-resize-button in this-procedure .
     1481           return .
     1482         end.
     1483       end.
     1484     end.
     1485     if p-change-value >= 0
     1486     then do:
     1487       assign
     1488         v-change-sign = 1
     1489       .
     1490     end.
     1491     else do:
     1492       assign
     1493         v-change-sign = -1
     1494       .
     1495     end.
     1496     assign
     1497       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1498     .
     1499     if p-change-value = 0
     1500     then do:
     1501       run diasize_position-resize-button in this-procedure .
     1502       return .
     1503     end.
     1504     move_block:
     1505     do
     1506     on error undo move_block, leave move_block
     1507     :
     1508       if retry
     1509       then do:
     1510         do
     1511         on error undo move_block, leave move_block
     1512         :
     1513           if p-change-value > 0
     1514           then do:
     1515             for each buf_temp-diasize-handle
     1516             on error undo, next
     1517             :
     1518               assign
     1519                 v-object-handle = buf_temp-diasize-handle.handle-value
     1520               .
     1521               if v-object-handle <> v-diasize-resize-button
     1522               then do:
     1523                 assign
     1524                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1525                 .
     1526               end.
     1527             end.
     1528             assign
     1529               v-diasize-browse-handle :width = v-browse-width
     1530             .
     1531             for each buf_temp-browse-handle
     1532               where buf_temp-browse-handle.browse-type = 'width':u
     1533             on error undo, next
     1534             :
     1535               assign
     1536                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1537               .
     1538             end.
     1539             assign
     1540               frame Dialog-Frame :width = v-frame-width
     1541             .
     1542             if frame Dialog-Frame :scrollable = true
     1543             then do:
     1544               assign
     1545                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1546               .
     1547             end.
     1548             run diasize_position-resize-button in this-procedure .
     1549           end.
     1550           else do:
     1551             if frame Dialog-Frame :scrollable = true
     1552             then do:
     1553               assign
     1554                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1555               .
     1556             end.
     1557             assign
     1558               frame Dialog-Frame :width = v-frame-width
     1559             .
     1560             for each buf_temp-browse-handle
     1561               where buf_temp-browse-handle.browse-type = 'width':u
     1562             on error undo, next
     1563             :
     1564               assign
     1565                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1566               .
     1567             end.
     1568             assign
     1569               v-diasize-browse-handle :width = v-browse-width
     1570             .
     1571             for each buf_temp-diasize-handle
     1572             on error undo, next
     1573             :
     1574               assign
     1575                 v-object-handle = buf_temp-diasize-handle.handle-value
     1576               .
     1577               if v-object-handle <> v-diasize-resize-button
     1578               then do:
     1579                 assign
     1580                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1581                 .
     1582               end.
     1583             end.
     1584             run diasize_position-resize-button in this-procedure .
     1585           end.
     1586           assign
     1587             v-diasize-change-size = false
     1588           .
     1589           leave move_block .
     1590         end.
     1591       end.
     1592       assign
     1593         v-diasize-need-full-display = true
     1594       .
     1595       if v-diasize-change-size = false
     1596       then do:
     1597         assign
     1598           v-diasize-change-size = true
     1599         .
     1600       end.
     1601       else do:
     1602         return .
     1603       end.
     1604       assign
     1605         v-frame-width = frame Dialog-Frame :width
     1606         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1607         v-browse-width = v-diasize-browse-handle :width
     1608       .
     1609       for each buf_temp-browse-handle
     1610         where buf_temp-browse-handle.browse-type = 'width':u
     1611       :
     1612         assign
     1613           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1614         .
     1615       end.
     1616       for each buf_temp-diasize-handle
     1617       :
     1618         delete buf_temp-diasize-handle .
     1619       end.
     1620       assign
     1621         v-field-group-handle = frame Dialog-Frame :first-child
     1622       .
     1623       do while valid-handle(v-field-group-handle)
     1624       :
     1625         assign
     1626           v-object-handle = v-field-group-handle :first-child
     1627         .
     1628         do while valid-handle(v-object-handle)
     1629         :
     1630           if  v-object-handle <> v-diasize-browse-handle :handle
     1631           and v-object-handle <> v-diasize-resize-button
     1632           and can-query(v-object-handle, "row")
     1633           and can-query(v-object-handle, "height")
     1634           and ( v-object-handle :col + v-object-handle :width
     1635                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1636               )
     1637           then do:
     1638             find first buf_temp-browse-handle
     1639               where buf_temp-browse-handle.browse-type   = 'width':u
     1640                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1641               no-error .
     1642             if available buf_temp-browse-handle
     1643             then do:
     1644             end.
     1645             else do:
     1646               create buf_temp-diasize-handle .
     1647               assign
     1648                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1649                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1650               .
     1651             end.
     1652           end.
     1653           assign
     1654             v-object-handle = v-object-handle :next-sibling
     1655           .
     1656         end.
     1657         assign
     1658           v-field-group-handle = v-field-group-handle :next-sibling
     1659         .
     1660       end.
     1661       do with frame Dialog-Frame
     1662       :
     1663         hide v-diasize-resize-button .
     1664         v-diasize-resize-button :row = 1.
     1665         v-diasize-resize-button :column = 1.
     1666       end.
     1667       if p-change-value > 0
     1668       then do:
     1669         if frame Dialog-Frame :scrollable = true
     1670         then do:
     1671           assign
     1672             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1673             no-error .
     1674           if error-status :error
     1675           or error-status :get-message(1) <> ""
     1676           then do:
     1677             undo move_block, retry move_block.
     1678           end.
     1679         end.
     1680         assign
     1681           frame Dialog-Frame :width = v-frame-width + p-change-value
     1682           no-error .
     1683         if error-status :error
     1684         or error-status :get-message(1) <> ""
     1685         then do:
     1686           undo move_block, retry move_block.
     1687         end.
     1688         assign
     1689           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1690         no-error .
     1691         if error-status :error
     1692         or error-status :get-message(1) <> ""
     1693         then do:
     1694           undo move_block, retry move_block.
     1695         end.
     1696         for each buf_temp-browse-handle
     1697           where buf_temp-browse-handle.browse-type = 'width':u
     1698         on error undo move_block, retry move_block
     1699         :
     1700           assign
     1701             buf_temp-browse-handle.browse-handle :width
     1702               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1703             no-error .
     1704           if error-status :error
     1705           or error-status :get-message(1) <> ""
     1706           then do:
     1707             undo move_block, retry move_block .
     1708           end.
     1709         end.
     1710         for each buf_temp-diasize-handle
     1711         on error undo move_block, retry move_block
     1712         :
     1713           assign
     1714             v-object-handle = buf_temp-diasize-handle.handle-value
     1715           .
     1716           if v-object-handle <> v-diasize-resize-button
     1717           then do:
     1718             assign
     1719               v-object-handle :col = v-object-handle :col + p-change-value
     1720               no-error .
     1721             if error-status :error
     1722             or error-status :get-message(1) <> ""
     1723             then do:
     1724               undo move_block, retry move_block .
     1725             end.
     1726           end.
     1727         end.
     1728       end.
     1729       else do:
     1730         for each buf_temp-diasize-handle
     1731         on error undo move_block, retry move_block
     1732         :
     1733           assign
     1734             v-object-handle = buf_temp-diasize-handle.handle-value
     1735           .
     1736           if v-object-handle <> v-diasize-resize-button
     1737           then do:
     1738             assign
     1739               v-object-handle :col = v-object-handle :col + p-change-value
     1740               no-error .
     1741             if error-status :error
     1742             or error-status :get-message(1) <> ""
     1743             then do:
     1744               undo move_block, retry move_block .
     1745             end.
     1746           end.
     1747         end.
     1748         for each buf_temp-browse-handle
     1749           where buf_temp-browse-handle.browse-type = 'width':u
     1750         on error undo move_block, retry move_block
     1751         :
     1752           assign
     1753             buf_temp-browse-handle.browse-handle :width
     1754               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1755             no-error .
     1756           if error-status :error
     1757           or error-status :get-message(1) <> ""
     1758           then do:
     1759             undo move_block, retry move_block .
     1760           end.
     1761         end.
     1762         assign
     1763           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1764           no-error .
     1765         if error-status :error
     1766         or error-status :get-message(1) <> ""
     1767         then do:
     1768           undo move_block, retry move_block.
     1769         end.
     1770         assign
     1771           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1772         no-error .
     1773         if error-status :error
     1774         or error-status :get-message(1) <> ""
     1775         then do:
     1776           undo move_block, retry move_block.
     1777         end.
     1778         if frame Dialog-Frame :scrollable = true
     1779         then do:
     1780           assign
     1781             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1782           no-error .
     1783           if error-status :error
     1784           or error-status :get-message(1) <> ""
     1785           then do:
     1786             undo move_block, retry move_block.
     1787           end.
     1788         end.
     1789       end.
     1790       if p-move-resize
     1791       then do:
     1792         run diasize_position-resize-button in this-procedure .
     1793       end.
     1794       if v-diasize-wndstore = true
     1795       then do:
     1796         if connected("ub") = true
     1797         then do:
     1798           define variable v-cntxt-db-num        as integer   no-undo .
     1799           define variable v-cntxt-userid        as character no-undo .
     1800           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1801                                             , OUTPUT v-cntxt-userid
     1802                                             ) .
     1803           run gbl/wndsizew.p
     1804             (input  v-cntxt-db-num
     1805             ,input  v-cntxt-userid
     1806             ,input  v-diasize-proc-name
     1807             ,input  'width':u
     1808             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1809             ) .
     1810         end.
     1811       end.
     1812     end.
     1813     assign
     1814       v-diasize-change-size = false
     1815     .
     1816   end procedure.
     1817   procedure diasize_set-width :
     1818     define input  parameter p-new-width  as decimal   no-undo .
     1819     define input  parameter p-move-resize as logical   no-undo .
     1820     do
     1821     on error undo, return error return-value
     1822     :
     1823       run diasize_change-width in this-procedure
     1824         (input  (p-new-width - frame Dialog-Frame :width)
     1825         ,input  p-move-resize
     1826         ) .
     1827     end.
     1828   end procedure.
     1829   procedure diasize_position-resize-button :
     1830     do with frame Dialog-Frame
     1831     :
     1832       hide v-diasize-resize-button .
     1833       assign
     1834         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1835                     - 1
     1836                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1837         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1838                     - 1
     1839                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1840       .
     1841       view v-diasize-resize-button .
     1842     end.
     1843   end procedure.
     1844   on alt-right anywhere
     1845   do:
     1846     run diasize_change-width in this-procedure
     1847       (input 1
     1848       ,input true
     1849       ) .
     1850     return no-apply .
     1851   end.
     1852   on alt-left anywhere
     1853   do:
     1854     run diasize_change-width in this-procedure
     1855       (input -1
     1856       ,input true
     1857       ) .
     1858     return no-apply .
     1859   end.
     1860   on alt-down anywhere
     1861   do:
     1862     run diasize_change-height in this-procedure
     1863       (input 1
     1864       ,input true
     1865       ) .
     1866     return no-apply .
     1867   end.
     1868   on alt-up anywhere
     1869   do:
     1870     run diasize_change-height in this-procedure
     1871       (input -1
     1872       ,input true
     1873       ) .
     1874     return no-apply .
     1875   end.
     1876   on alt-enter of frame Dialog-Frame
     1877   do:
     1878     run diasize_maximize in this-procedure
     1879       (input  ?
     1880       ).
     1881     return no-apply .
     1882   end.
     1883   procedure diasize_end-move :
     1884     do
     1885     on error undo, return error return-value
     1886     :
     1887       define variable v-row-delta as decimal   no-undo .
     1888       define variable v-col-delta as decimal   no-undo .
     1889       define variable v-new-row as decimal   no-undo .
     1890       define variable v-new-col as decimal   no-undo .
     1891       assign
     1892         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1893         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1894       .
     1895       assign
     1896         v-row-delta = v-new-row - frame Dialog-Frame :height
     1897         v-col-delta = v-new-col - frame Dialog-Frame :width
     1898       .
     1899       run diasize_change-height in this-procedure
     1900         (input v-row-delta
     1901         ,input true
     1902         ) .
     1903       run diasize_change-width in this-procedure
     1904         (input v-col-delta
     1905         ,input true
     1906         ) .
     1907     end.
     1908   end procedure.
     1909   procedure diasize_maximize :
     1910     define input  parameter p-action as logical   no-undo .
     1911     do
     1912     on error undo, return error return-value
     1913     :
     1914       if p-action = ?
     1915       then do:
     1916         if v-diasize-need-maximize = true
     1917         then do:
     1918           assign
     1919             p-action = true
     1920           .
     1921         end.
     1922         else do:
     1923           assign
     1924             p-action = false
     1925           .
     1926         end.
     1927       end.
     1928       if p-action = true
     1929       then do:
     1930         run diasize_change-height in this-procedure
     1931           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1932               - frame Dialog-Frame :height-chars
     1933           ,input true
     1934           ) .
     1935         run diasize_change-width in this-procedure
     1936           (input session :width-chars
     1937               - frame Dialog-Frame :width-chars
     1938           ,input true
     1939           ) .
     1940         assign
     1941           v-diasize-need-maximize = false
     1942         .
     1943       end.
     1944       else do:
     1945         run diasize_change-width in this-procedure
     1946           (input v-diasize-orig-frame-width
     1947               - frame Dialog-Frame :width-chars
     1948           ,input true
     1949           ) .
     1950         run diasize_change-height in this-procedure
     1951           (input v-diasize-orig-frame-height
     1952               - frame Dialog-Frame :height-chars
     1953           ,input true
     1954           ) .
     1955         assign
     1956           v-diasize-need-maximize = true
     1957         .
     1958       end.
     1959     end.
     1960   end procedure.
     1961   procedure diasize_restore-orig-size :
     1962     do
     1963     on error undo, return error return-value
     1964     :
     1965       assign
     1966         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1967         v-diasize-current-frame-height = frame Dialog-Frame :height
     1968       .
     1969       run diasize_set-height in this-procedure
     1970         (input  v-diasize-orig-frame-height
     1971         ,input  true
     1972         ) .
     1973       run diasize_set-width in this-procedure
     1974         (input  v-diasize-orig-frame-width
     1975         ,input  true
     1976         ) .
     1977     end.
     1978   end procedure.
     1979   procedure diasize_restore-current-size :
     1980     do
     1981     on error undo, return error return-value
     1982     :
     1983       run diasize_set-height in this-procedure
     1984         (input  v-diasize-current-frame-height
     1985         ,input  true
     1986         ) .
     1987       run diasize_set-width in this-procedure
     1988         (input  v-diasize-current-frame-width
     1989         ,input  true
     1990         ) .
     1991     end.
     1992   end procedure.
     1993   procedure diasize_set-browse-handle :
     1994     define input  parameter p-browse-handle as handle   no-undo .
     1995     define buffer buf_temp-browse-handle for temp-browse-handle .
     1996     do
     1997     on error undo, return error return-value
     1998     :
     1999       assign
     2000         v-diasize-browse-handle = p-browse-handle
     2001       .
     2002       for each buf_temp-browse-handle
     2003       on error undo, return error return-value
     2004       :
     2005         delete buf_temp-browse-handle .
     2006       end.
     2007     end.
     2008   end procedure.
     2009   procedure diasize_add_browse :
     2010     define input  parameter p-browse-type   as character no-undo .
     2011     define input  parameter p-browse-handle as handle    no-undo .
     2012     define buffer buf_temp-browse-handle for temp-browse-handle .
     2013     do
     2014     on error undo, return error return-value
     2015     :
     2016       assign
     2017         v-diasize-browse-number = v-diasize-browse-number + 1
     2018       .
     2019       create buf_temp-browse-handle .
     2020       assign
     2021         buf_temp-browse-handle.browse-type   = p-browse-type
     2022         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2023         buf_temp-browse-handle.browse-handle = p-browse-handle
     2024       .
     2025     end.
     2026   end procedure.
     2027   procedure diasize_init :
     2028     define variable v-default-value    as logical   no-undo .
     2029     define variable v-restore-saved    as logical   no-undo .
     2030     define variable v-resize-value-str as character no-undo .
     2031     do
     2032     on error undo, return error return-value
     2033     :
     2034       do with frame Dialog-Frame
     2035       :
     2036         assign
     2037           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2038           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2039           v-diasize-browse-handle     = browse BR-cancell :handle
     2040         .
     2041         create button v-diasize-resize-button
     2042         assign
     2043           parent        = frame Dialog-Frame :first-child
     2044           label         = "s"
     2045           height-pixels = 16
     2046           width-pixels  = 16
     2047           visible       = true
     2048           sensitive     = true
     2049           movable       = true
     2050           triggers:
     2051             on end-move persistent run diasize_end-move in this-procedure .
     2052           end triggers.
     2053         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2054         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2055         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2056         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2057         assign
     2058           v-diasize-wndmax = false
     2059         .
     2060         if connected("ub") = true
     2061         then do:
     2062           define variable v-cntxt-db-num        as integer   no-undo .
     2063           define variable v-cntxt-userid        as character no-undo .
     2064           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2065                                             , OUTPUT v-cntxt-userid
     2066                                             ) .
     2067           run gbl/wndpar_r.p
     2068             (input  v-cntxt-db-num
     2069             ,input  v-cntxt-userid
     2070             ,input  'wndmax':U
     2071             ,output v-diasize-wndmax
     2072             ,output v-default-value
     2073             ) .
     2074         end.
     2075         assign
     2076           v-diasize-wndstore = false
     2077         .
     2078         if connected("ub") = true
     2079         then do:
     2080           run gbl/wndpar_r.p
     2081             (input  v-cntxt-db-num
     2082             ,input  v-cntxt-userid
     2083             ,input  'wndstore':U
     2084             ,output v-diasize-wndstore
     2085             ,output v-default-value
     2086             ) .
     2087         end.
     2088         assign
     2089           v-diasize-proc-name = entry(1, program-name(2), '.')
     2090         .
     2091         if v-diasize-wndstore = true
     2092         then do:
     2093           assign
     2094             v-restore-saved = false
     2095           .
     2096           if connected("ub") = true
     2097           then do:
     2098             run gbl/wndsizer.p
     2099               (input  v-cntxt-db-num
     2100               ,input  v-cntxt-userid
     2101               ,input  v-diasize-proc-name
     2102               ,input  'height':u
     2103               ,output v-resize-value-str
     2104               ) .
     2105             if v-resize-value-str <> '':U
     2106             then do:
     2107               run diasize_change-height in this-procedure
     2108                 (input  integer(v-resize-value-str)
     2109                 ,input  true
     2110                 ) .
     2111               assign
     2112                 v-restore-saved = true
     2113               .
     2114             end.
     2115           end.
     2116           if connected("ub") = true
     2117           then do:
     2118             run gbl/wndsizer.p
     2119               (input  v-cntxt-db-num
     2120               ,input  v-cntxt-userid
     2121               ,input  v-diasize-proc-name
     2122               ,input  'width':u
     2123               ,output v-resize-value-str
     2124               ) .
     2125             if v-resize-value-str <> '':U
     2126             then do:
     2127               run diasize_change-width in this-procedure
     2128                 (input  integer(v-resize-value-str)
     2129                 ,input  true
     2130                 ) .
     2131               assign
     2132                 v-restore-saved = true
     2133               .
     2134             end.
     2135           end.
     2136           if v-restore-saved <> true
     2137           then do:
     2138             if v-diasize-wndmax = true
     2139             then do:
     2140               run diasize_maximize in this-procedure
     2141                 (input  true
     2142                 ) .
     2143             end.
     2144           end.
     2145         end.
     2146         else do:
     2147           if v-diasize-wndmax = true
     2148           then do:
     2149             run diasize_maximize in this-procedure
     2150               (input  true
     2151               ) .
     2152           end.
     2153         end.
     2154       end.
     2155     end.
     2156   end procedure.
     2157   procedure diasize_need-full-display :
     2158     define output parameter p-need-full-display as logical   no-undo .
     2159     do
     2160     on error undo, return error return-value
     2161     :
     2162       assign
     2163         p-need-full-display = v-diasize-need-full-display
     2164       .
     2165       assign
     2166         v-diasize-need-full-display = false
     2167       .
     2168     end.
     2169   end procedure.
     2170   procedure get-context :
     2171      define output parameter p-db-num as integer          no-undo.
     2172      define output parameter p-user-id as character        no-undo.
     2173      define variable v-login               as character    no-undo.
     2174      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2175      define buffer buf_user-login  for ub.user-login .
     2176      do
     2177      on error undo, return error
     2178      :
     2179            FIND FIRST buf_sys-ctrl no-lock.
     2180            ASSIGN
     2181               v-login = USERID("ub")
     2182               p-db-num = buf_sys-ctrl.db-num
     2183            .
     2184            FIND FIRST buf_user-login
     2185                 WHERE buf_user-login.db-num = p-db-num
     2186                   AND buf_user-login.user-login = v-login
     2187                 no-lock
     2188                 no-error
     2189                 .
     2190            IF AVAILABLE buf_user-login
     2191            THEN DO:
     2192               assign
     2193                  p-user-id = buf_user-login.user-id
     2194               .
     2195            END.
     2196      end.
     2197   end procedure.
     2198       run diasize_init in this-procedure .
     2199   MAIN-BLOCK:
     2200   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2201      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2202   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2203     run mainmenu_getcntxt in parparentproc
     2204       (output v-cntxt-db-num
     2205       ,output v-cntxt-userid
     2206       ,output v-cntxt-level
