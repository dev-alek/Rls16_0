     2208       ,output v-cntxt-obj-type
     2209       ,output v-cntxt-obj-code
     2210       ,output v-cntxt-db-num-obj
     2211       ,output v-cntxt-is-admin
     2212       ) .
     2213   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2214   ON TAB ANYWHERE
     2215   DO:
     2216   define variable ii as integer no-undo .
     2217   define variable fh as widget-handle no-undo .
     2218   define variable hh as widget-handle no-undo .
     2219   define variable v-next-widget-name as character no-undo .
     2220   if v-tab-order <> '' then do:
     2221     if self:type = "TOGGLE-BOX" then
     2222     self:BGCOLOR = ?.
     2223     assign
     2224     ii = lookup(self:name, v-tab-order).
     2225     assign
     2226     ii = ii + 1
     2227     v-next-widget-name = entry(ii, v-tab-order)
     2228     no-error .
     2229     if error-status:error then do:
     2230       assign
     2231       ii = 1
     2232       v-next-widget-name = entry( ii, v-tab-order)
     2233       .
     2234     end.
     2235     assign
     2236     fh = frame Dialog-Frame:first-child
     2237     hh = fh:first-child
     2238     .
     2239     do while valid-handle(hh):
     2240       if hh:name = v-next-widget-name then do:
     2241         if hh:sensitive  = yes
     2242         AND hh:visible = yes then do:
     2243           if hh:type = "TOGGLE-BOX":U then do:
     2244             assign
     2245             hh:BGcolor = 1
     2246             .
     2247           end.
     2248           APPLY "ENTRY" to hh.
     2249           return no-apply.
     2250         end.
     2251         else do:
     2252           APPLY "TAB" to hh.
     2253           return no-apply.
     2254         end.
     2255       end.
     2256       hh = hh:next-sibling.
     2257     end.
     2258   end.
     2259   END.
     2260   ON BACK-TAB ANYWHERE
     2261   DO:
     2262   define variable ii as integer no-undo .
     2263   define variable fh as widget-handle no-undo .
     2264   define variable hh as widget-handle no-undo .
     2265   define variable v-next-widget-name as character no-undo .
     2266   if v-tab-order <> '' then do:
     2267     assign
     2268     ii = lookup(self:name, v-tab-order).
     2269     .
     2270     assign
     2271     ii = (if ii = 1
     2272           then  num-entries(v-tab-order)
     2273           else ii - 1
     2274           )
     2275     v-next-widget-name = entry(ii, v-tab-order)
     2276     .
     2277     assign
     2278     fh = frame Dialog-Frame:first-child
     2279     hh = fh:first-child
     2280     .
     2281     do while valid-handle(hh):
     2282       if hh:name = v-next-widget-name then do:
     2283         if hh:sensitive  = yes
     2284         AND hh:visible = yes then do:
     2285           if hh:type = "TOGGLE-BOX":U then do:
     2286             assign
     2287             hh:BGcolor = 1
     2288             .
     2289           end.
     2290           APPLY "ENTRY" to hh.
     2291           return no-apply.
     2292         end.
     2293         else do:
     2294         APPLY "BACK-TAB" to hh.
     2295         return no-apply.
     2296         end.
     2297       end.
     2298       hh = hh:next-sibling.
     2299     end.
     2300     end.
     2301   END.
     2302   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2303   ON RETURN ANYWHERE
     2304   DO:
     2305   define variable ii as integer no-undo .
     2306   define variable fh as widget-handle no-undo .
     2307   define variable hh as widget-handle no-undo .
     2308   define variable v-next-widget-name as character no-undo .
     2309     if v-tab-order <> '' then do:
     2310       assign
     2311       ii = lookup(self:name, v-tab-order).
     2312       if ii = num-entries(v-tab-order) then do:
     2313           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2314           return no-apply.
     2315       end.
     2316       if self:type <> "BUTTON" and
     2317         self:type <> "EDITOR"  then do:
     2318         run proc-move-forward in this-procedure .
     2319         return no-apply.
     2320       end.
     2321       if self:type = "BUTTON" then do:
     2322         APPLY "CHOOSE" to self.
     2323       end.
     2324       if self:type = "TOGGLE-BOX" then
     2325       self:BGCOLOR = ?.
     2326       assign
     2327       ii = ii + 1
     2328       v-next-widget-name = entry(ii, v-tab-order)
     2329       no-error .
     2330       if error-status:error then do:
     2331         assign
     2332         ii = 1
     2333         v-next-widget-name = entry( ii, v-tab-order)
     2334         .
     2335       end.
     2336       assign
     2337       fh = frame Dialog-Frame:first-child
     2338       hh = fh:first-child
     2339       .
     2340       do while valid-handle(hh):
     2341         if hh:name = v-next-widget-name then do:
     2342           if hh:sensitive  = yes
     2343           AND hh:visible = yes then do:
     2344             if hh:type = "TOGGLE-BOX":U then do:
     2345               assign
     2346               hh:BGcolor = 1
     2347               .
     2348             end.
     2349             APPLY "ENTRY" to hh.
     2350             return no-apply.
     2351           end.
     2352           else do:
     2353             APPLY "TAB" to hh.
     2354             return no-apply.
     2355           end.
     2356         end.
     2357         hh = hh:next-sibling.
     2358       end.
     2359     end.
     2360   END.
     2361   procedure proc-move-forward :
     2362   define variable ii as integer no-undo .
     2363   define variable fh as widget-handle no-undo .
     2364   define variable hh as widget-handle no-undo .
     2365   define variable v-next-widget-name as character no-undo .
     2366   do
     2367   on error undo, return error
     2368   :
     2369     if v-tab-order <> '' then do:
     2370       if self:type = "TOGGLE-BOX" then
     2371       self:BGCOLOR = ?.
     2372       assign
     2373       ii = lookup(self:name, v-tab-order).
     2374       assign
     2375       ii = ii + 1
     2376       v-next-widget-name = entry(ii, v-tab-order)
     2377       no-error .
     2378       if error-status:error then do:
     2379         assign
     2380         ii = 1
     2381         v-next-widget-name = entry( ii, v-tab-order)
     2382         .
     2383       end.
     2384       assign
     2385       fh = frame Dialog-Frame:first-child
     2386       hh = fh:first-child
     2387       .
     2388       do while valid-handle(hh):
     2389         if hh:name = v-next-widget-name then do:
     2390           if hh:sensitive  = yes
     2391           AND hh:visible = yes then do:
     2392             if hh:type = "TOGGLE-BOX":U then do:
     2393               assign
     2394               hh:BGcolor = 1
     2395               .
     2396             end.
     2397             APPLY "ENTRY" to hh.
     2398             return.
     2399           end.
     2400           else do:
     2401             assign
     2402             ii = ii + 1
     2403             v-next-widget-name = entry(ii, v-tab-order)
     2404             no-error .
     2405             if error-status:error then do:
     2406               assign
     2407               ii = 1
     2408               v-next-widget-name = entry( ii, v-tab-order)
     2409               .
     2410             end.
     2411           end.
     2412         end.
     2413         hh = hh:next-sibling.
     2414       end.
     2415     end.
     2416   end.
     2417   end procedure.
     2418     IF p-mode <> 'ПРОСМОТР':U
     2419     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2420         MESSAGE
     2421         vss-workfile vss-revision vss-description skip
     2422         "Неверное значение параметра p-mode" p-mode
     2423         VIEW-AS ALERT-BOX ERROR.
     2424         UNDO, RETURN ERROR.
     2425     END.
     2426     IF p-obj-type <> 'маг':U
     2427     and p-obj-type <> 'орг':U
     2428     and p-obj-type <> '':U
     2429     THEN DO:
     2430         MESSAGE
     2431         vss-workfile vss-revision vss-description skip
     2432         "Неверное значение параметра p-obj-type" p-obj-type
     2433         VIEW-AS ALERT-BOX ERROR.
     2434         UNDO, RETURN ERROR.
     2435     END.
     2436     if p-obj-type = 'маг':U then do:
     2437       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2438       IF NOT AVAILABLE X_shop THEN DO:
     2439           MESSAGE
     2440           vss-workfile vss-revision vss-description skip
     2441           "Неверное значение параметра p-obj-code" p-obj-code
     2442           VIEW-AS ALERT-BOX ERROR.
     2443           UNDO, RETURN ERROR.
     2444       END.
     2445   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2447     (input  'маг':U
     2448     ,input  p-obj-code
     2449     ,output v-db-num
     2450     )  .
     2451       IF v-db-num <> v-cntxt-db-num
     2452       AND v-cntxt-db-num <> 0
     2453       and p-mode <> 'ПРОСМОТР':U
     2454       THEN DO:
     2455           MESSAGE
     2456           "Нельзя менять параметры магазина в чужой БД" skip
     2457           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2458           VIEW-AS ALERT-BOX ERROR.
     2459           UNDO, RETURN ERROR.
     2460       END.
     2461   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2463     (input  p-obj-type
     2464     ,input  p-obj-code
     2465     ,output v-host-code
     2466     )  .
     2467     end.
     2468     if p-obj-type = 'орг':U then do:
     2469       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2470       IF NOT AVAILABLE X_sysconf THEN DO:
     2471           MESSAGE
     2472           vss-workfile vss-revision vss-description skip
     2473           "Неверное значение параметра p-obj-code" p-obj-code
     2474           VIEW-AS ALERT-BOX ERROR.
     2475           UNDO, RETURN ERROR.
     2476       END.
     2477       if v-cntxt-db-num <> 0
     2478       and p-mode <> 'ПРОСМОТР':U
     2479       then do:
     2480           MESSAGE
     2481           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2482           VIEW-AS ALERT-BOX ERROR.
     2483           UNDO, RETURN ERROR.
     2484       end.
     2485       v-host-code = p-obj-code.
     2486     end.
     2487     if p-obj-type = '':U then do:
     2488       if v-cntxt-db-num <> 0
     2489       and p-mode <> 'ПРОСМОТР':U
     2490       then do:
     2491           MESSAGE
     2492           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2493           VIEW-AS ALERT-BOX ERROR.
     2494           UNDO, RETURN ERROR.
     2495       end.
     2496     end.
     2497     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2498       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2499                 LOCKED_thbj-attr.obj-type = p-obj-type
     2500           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2501           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-magia-xml':U
     2502           AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2503        if locked locked_thbj-attr then do:
     2504           message
     2505           vss-workfile vss-revision vss-description skip
     2506            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2507           view-as alert-box error .
     2508           undo, return error.
     2509         end.
     2510     END.
     2511     ELSE DO:
     2512         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2513             LOCKED_thbj-attr.obj-type = p-obj-type
     2514       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2515       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-magia-xml':U
     2516       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2517     END.
     2518     if not available locked_thbj-attr then do:
     2519       ASSIGN
     2520       v-to-create  = YES.
     2521       message
     2522       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2523                   chr(10))
     2524       view-as alert-box WARNING.
     2525     end.
     2526   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2528     (input  v-host-code
     2529     ,output v-r-b-code
     2530     )  .
     2531     FIND FIRST buf_currency NO-LOCK WHERE
     2532               buf_currency.curr-code = v-r-b-code .
     2533     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2534     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2535     RUN Myenable.
     2536     WAIT-FOR GO OF FRAME Dialog-Frame.
     2537   END.
     2538   RUN disable_UI.
     2539   PROCEDURE disable_UI :
     2540     HIDE FRAME Dialog-Frame.
     2541   END PROCEDURE.
     2542   PROCEDURE enable_UI :
     2543     DISPLAY f-mag-bnal for-cash-pay-mag-bnal f-magnopay for-cash-pay-magnopay
     2544             f-mag-VIP for-cash-pay-mag-VIP
     2545         WITH FRAME Dialog-Frame.
     2546     ENABLE B-exit b-quit B-Help b-mag-bnal b-magnopay b-mag-VIP BR-cancell
     2547            f-mag-bnal for-cash-pay-mag-bnal f-magnopay for-cash-pay-magnopay
     2548            f-mag-VIP for-cash-pay-mag-VIP
     2549         WITH FRAME Dialog-Frame.
     2550     VIEW FRAME Dialog-Frame.
     2551   END PROCEDURE.
     2552   PROCEDURE fill-widgets :
     2553   define variable v-value-character as character no-undo .
     2554   define variable v-value-date as date no-undo .
     2555   define variable v-value-decimal as decimal no-undo .
     2556   define variable v-value-integer as INTEGER no-undo .
     2557   define variable v-value-logical AS LOGICAL no-undo .
     2558   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2559   define variable v-param-type as character no-undo .
     2560   define variable v-param-value as character no-undo .
     2561   define variable ret-item as character no-undo .
     2562   define variable wro-item as character no-undo .
     2563   define variable ret-chk as character no-undo .
     2564   define variable wro-chk as character no-undo .
     2565   define variable ret-ord as character no-undo .
     2566   define variable wro-ord as character no-undo .
     2567   define variable ii as integer no-undo .
     2568   FOR EACH thbjattr_thbj-attr:
     2569     delete thbjattr_thbj-attr.
     2570   end.
     2571   FOR EACH temp-thbj-attr:
     2572     delete temp-thbj-attr.
     2573   end.
     2574   run adm/shattri.p (
     2575                 input "init":U
     2576               , input p-obj-type
     2577               , input p-obj-code
     2578               , input 'cd-type-magia-xml':U
     2579               , input "":U
     2580               , output v-value-character
     2581               , output v-value-date
     2582               , output v-value-decimal
     2583               , output v-value-integer
     2584               , output v-value-logical
     2585               , output v-param-type
     2586               , INPUT-OUTPUT TABLE-handle v-tth
     2587               ) no-error .
     2588   if error-status:error
     2589   and not available locked_thbj-attr then do:
     2590     message
     2591     "Не удалось получить начальные значения настроек" skip
     2592     error-status:get-message(1) return-value
     2593     view-as alert-box error .
     2594     undo, return error .
     2595   end.
     2596   FOR EACH thbjattr_thbj-attr:
     2597     ASSIGN
     2598     v-entry = thbjattr_thbj-attr.prop-code.
     2599     IF v-entry = 'mag-bnal':U THEN DO:
     2600       ASSIGN
     2601       f-mag-bnal = thbjattr_thbj-attr.property-value-INTEGER
     2602       f-mag-bnal:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2603       .
     2604     END.
     2605     IF v-entry = 'magnopay':U THEN DO:
     2606       ASSIGN
     2607       f-magnopay = thbjattr_thbj-attr.property-value-INTEGER
     2608       f-magnopay:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2609       .
     2610     END.
     2611     IF v-entry = 'mag-vip':U THEN DO:
     2612       ASSIGN
     2613       f-mag-vip = thbjattr_thbj-attr.property-value-INTEGER
     2614       f-mag-vip:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2615       .
     2616     END.
     2617     IF v-entry = 'ret-item':U THEN DO:
     2618       ASSIGN
     2619       ret-item = thbjattr_thbj-attr.property-value-character
     2620       .
     2621     END.
     2622     IF v-entry = 'wro-item':U THEN DO:
     2623       ASSIGN
     2624       wro-item = thbjattr_thbj-attr.property-value-character.
     2625     END.
     2626     IF v-entry = 'ret-chk':U THEN DO:
     2627       ASSIGN
     2628       ret-chk = thbjattr_thbj-attr.property-value-character.
     2629     END.
     2630     IF v-entry = 'wro-chk':U THEN DO:
     2631       ASSIGN
     2632       wro-chk = thbjattr_thbj-attr.property-value-character.
     2633     END.
     2634     IF v-entry = 'ret-ord':U THEN DO:
     2635       ASSIGN
     2636       ret-ord = thbjattr_thbj-attr.property-value-character.
     2637     END.
     2638     IF v-entry = 'wro-ord':U THEN DO:
     2639       ASSIGN
     2640       wro-ord = thbjattr_thbj-attr.property-value-character.
     2641     END.
     2642     create temp-thbj-attr.
     2643     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2644   END.
     2645   for each tt-cancell:
     2646     delete tt-cancell.
     2647   end.
     2648   DO ii = 1 TO NUM-ENTRIES (ret-item, ';':U):
     2649     CREATE tt-cancell.
     2650     ASSIGN
     2651     tt-cancell.grp-code = integer(ENTRY(1, ENTRY(ii, ret-item, ';':U)))
     2652     tt-cancell.grp-name = ENTRY(2, ENTRY(ii, ret-item, ';':U))
     2653     tt-cancell.return-write-off = yes
     2654     tt-cancell.object_ = 'chk-gds':U
     2655     tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ")
     2656     .
     2657     release tt-cancell.
     2658   END.
     2659   DO ii = 1 TO NUM-ENTRIES( wro-item, ';':U):
     2660     CREATE tt-cancell.
     2661     ASSIGN
     2662     tt-cancell.grp-code = integer(ENTRY(1, ENTRY(ii, wro-item, ';':U)))
     2663     tt-cancell.grp-name = ENTRY(2, ENTRY(ii, wro-item, ';':U))
     2664     tt-cancell.return-write-off = NO
     2665     tt-cancell.object_ = 'chk-gds':U
     2666     tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ")
     2667     .
     2668     release tt-cancell.
     2669   END.
     2670   DO ii = 1 TO NUM-ENTRIES( ret-chk, ';':U):
     2671     CREATE tt-cancell.
     2672     ASSIGN
     2673     tt-cancell.grp-code = integer(ENTRY(1, ENTRY(ii, ret-chk, ';':U)))
     2674     tt-cancell.grp-name = ENTRY(2, ENTRY(ii, ret-chk, ';':U))
     2675     tt-cancell.return-write-off = yes
     2676     tt-cancell.object_ = 'chk-doc':U
     2677     tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ")
     2678     .
     2679     release tt-cancell.
     2680   END.
     2681   DO ii = 1 TO NUM-ENTRIES( wro-chk, ';':U):
     2682     CREATE tt-cancell.
     2683     ASSIGN
     2684     tt-cancell.grp-code = integer(ENTRY(1, ENTRY(ii, wro-chk, ';':U)))
     2685     tt-cancell.grp-name = ENTRY(2, ENTRY(ii, wro-chk, ';':U))
     2686     tt-cancell.return-write-off = NO
     2687     tt-cancell.object_ = 'chk-doc':U
     2688     tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ")
     2689     .
     2690     release tt-cancell.
     2691   END.
     2692   DO ii = 1 TO NUM-ENTRIES( ret-ord, ';':U):
     2693     CREATE tt-cancell.
     2694     ASSIGN
     2695     tt-cancell.grp-code = integer(ENTRY(1, ENTRY(ii, ret-ord, ';':U)))
     2696     tt-cancell.grp-name = ENTRY(2, ENTRY(ii, ret-ord, ';':U))
     2697     tt-cancell.return-write-off = yes
     2698     tt-cancell.object_ = 'ord-doc':U
     2699     tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ")
     2700     .
     2701     release tt-cancell.
     2702   END.
     2703   DO ii = 1 TO NUM-ENTRIES( wro-ord, ';':U):
     2704     CREATE tt-cancell.
     2705     ASSIGN
     2706     tt-cancell.grp-code = integer(ENTRY(1, ENTRY(ii, wro-ord, ';':U)))
     2707     tt-cancell.grp-name = ENTRY(2, ENTRY(ii, wro-ord, ';':U))
     2708     tt-cancell.return-write-off = NO
     2709     tt-cancell.object_ = 'ord-doc':U
     2710     tt-cancell.object_-name = entry(lookup(tt-cancell.object_,  ('chk-gds':U + chr(44) + 'chk-doc':U + chr(44) + 'ord-doc':U)),                      "Блюдо/товар,Чек,Заказ")
     2711     .
     2712     release tt-cancell.
     2713   END.
     2714   END PROCEDURE.
     2715   PROCEDURE MyEnable :
     2716   ASSIGN
     2717   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2718   v-tab-order = "b-mag-bnal,b-magnopay,b-mag-vip,b-add,b-del".
     2719   FIND FIRST buf_cash-pay-bnal WHERE
     2720           buf_cash-pay-bnal.cdpay-code = f-mag-bnal
     2721       AND buf_cash-pay-bnal.curr = v-r-b-code NO-ERROR.
     2722   FIND FIRST buf_cash-pay-nopay WHERE
     2723           buf_cash-pay-nopay.cdpay-code = f-magnopay
     2724       AND buf_cash-pay-nopay.curr = v-r-b-code NO-ERROR.
     2725   FIND FIRST buf_cash-pay-vip WHERE
     2726           buf_cash-pay-vip.cdpay-code = f-mag-vip
     2727       AND buf_cash-pay-vip.curr = v-r-b-code NO-ERROR.
     2728   DISPLAY
     2729   f-mag-bnal
     2730   f-magnopay
     2731   f-mag-vip
     2732   (IF AVAILABLE buf_cash-pay-bnal THEN buf_cash-pay-bnal.obj-name ELSE ?) @ for-cash-pay-mag-bnal
     2733   (IF AVAILABLE buf_cash-pay-nopay THEN buf_cash-pay-nopay.obj-name ELSE ?) @ for-cash-pay-magnopay
     2734   (IF AVAILABLE buf_cash-pay-vip THEN buf_cash-pay-vip.obj-name ELSE ?) @ for-cash-pay-mag-vip
     2735   WITH FRAME Dialog-Frame.
     2736   ENABLE
     2737   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2738   b-quit
     2739   B-Help
     2740   b-mag-bnal WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2741   b-magnopay WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2742   b-mag-vip WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2743   b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     2744   b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     2745   br-cancell
     2746   WITH FRAME Dialog-Frame.
     2747   VIEW FRAME Dialog-Frame.
     2748   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2749       HIDE
     2750       b-exit
     2751       IN FRAME Dialog-Frame.
     2752       ASSIGN
     2753       b-quit:LABEL = "&Выход"
     2754       .
     2755   END.
     2756   OPEN QUERY BR-cancell FOR EACH tt-cancell NO-LOCK INDEXED-REPOSITION.
     2757   END PROCEDURE.
     2758   PROCEDURE proc-save :
     2759   define variable v-value-character as character no-undo .
     2760   define variable v-value-date as date no-undo .
     2761   define variable v-value-decimal as decimal no-undo .
     2762   define variable v-value-integer as INTEGER no-undo .
     2763   define variable v-value-logical AS LOGICAL no-undo .
     2764   define variable v-param-type as character no-undo .
     2765   define variable wh as widget-handle no-undo .
     2766   define variable fh as widget-handle no-undo .
     2767   define variable v-same as logical no-undo .
     2768   define variable ret-item as character no-undo .
     2769   define variable wro-item as character no-undo .
     2770   define variable ret-chk as character no-undo .
     2771   define variable wro-chk as character no-undo .
     2772   define variable ret-ord as character no-undo .
     2773   define variable wro-ord as character no-undo .
     2774   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2775   ASSIGN
     2776   FRAME Dialog-Frame
     2777   f-mag-bnal
     2778   f-magnopay
     2779   f-mag-vip
     2780   .
     2781   for each tt-cancell:
     2782     if tt-cancell.return-write-off = yes
     2783     and tt-cancell.object_ = 'chk-gds':U then
     2784     assign
     2785     ret-item = ret-item + (if ret-item = '':u then '':U else ';':U) +
     2786               string(tt-cancell.grp-code) + chr(44) +
     2787               string(tt-cancell.grp-name)
     2788     .
     2789     if tt-cancell.return-write-off = no
     2790     and tt-cancell.object_ = 'chk-gds':U then
     2791     assign
     2792     wro-item = wro-item + (if wro-item = '':u then '':U else ';':U) +
     2793               string(tt-cancell.grp-code) +  chr(44) +
     2794               string(tt-cancell.grp-name)
     2795     .
     2796     if tt-cancell.return-write-off = yes
     2797     and tt-cancell.object_ = 'chk-doc':U then
     2798     assign
     2799     ret-chk = ret-chk + (if ret-chk = '':u then '':U else ';':U) +
     2800               string(tt-cancell.grp-code) +  chr(44) +
     2801               string(tt-cancell.grp-name)
     2802     .
     2803     if tt-cancell.return-write-off = no
     2804     and tt-cancell.object_ = 'chk-doc':U then
     2805     assign
     2806     wro-chk = wro-chk + (if wro-chk = '':u then '':U else ';':U) +
     2807               string(tt-cancell.grp-code) + chr(44) +
     2808               string(tt-cancell.grp-name)
     2809     .
     2810     if tt-cancell.return-write-off = yes
     2811     and tt-cancell.object_ = 'ord-doc':U then
     2812     assign
     2813     ret-ord = ret-ord + (if ret-ord = '':u then '':U else ';':U) +
     2814               string(tt-cancell.grp-code) + chr(44) +
     2815               string(tt-cancell.grp-name)
     2816     .
     2817     if tt-cancell.return-write-off = no
     2818     and tt-cancell.object_ = 'ord-doc':U then
     2819     assign
     2820     wro-ord = wro-ord + (if wro-ord = '':u then '':U else ';':U) +
     2821               string(tt-cancell.grp-code) + chr(44) +
     2822               string(tt-cancell.grp-name)
     2823     .
     2824   end.
     2825   assign
     2826   fh = frame Dialog-Frame:first-child
     2827   wh = fh:first-child
     2828   .
     2829   do while valid-handle(wh):
     2830     if wh:private-data begins "recid=" then do:
     2831       find first thbjattr_thbj-attr where
     2832                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2833       assign
     2834       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2835     end.
     2836     wh = wh:next-sibling.
     2837   end.
     2838   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ret-item':U.
     2839   assign
     2840   thbjattr_thbj-attr.property-value-character = ret-item.
     2841   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'wro-item':U.
     2842   assign
     2843   thbjattr_thbj-attr.property-value-character = wro-item.
     2844   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ret-chk':U.
     2845   assign
     2846   thbjattr_thbj-attr.property-value-character = ret-chk.
     2847   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'wro-chk':U.
     2848   assign
     2849   thbjattr_thbj-attr.property-value-character = wro-chk.
     2850   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ret-ord':U.
     2851   assign
     2852   thbjattr_thbj-attr.property-value-character = ret-ord.
     2853   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'wro-ord':U.
     2854   assign
     2855   thbjattr_thbj-attr.property-value-character = wro-ord.
     2856   v-same = yes.
     2857   for each thbjattr_thbj-attr,
     2858       first temp-thbj-attr where
     2859             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2860         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2861         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2862         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2863      buffer-compare
     2864      thbjattr_thbj-attr
     2865      to temp-thbj-attr
     2866      save result in v-same.
     2867      if not v-same then leave.
     2868   end.
     2869   v-same = no.
     2870   IF v-same  and not v-to-create THEN RETURN.
     2871   run adm/shattri.p (
     2872                 input "check":U
     2873               , input p-obj-type
     2874               , input p-obj-code
     2875               , input 'cd-type-magia-xml':U
     2876               , INPUT '':U
     2877                , output v-value-character
     2878                , output v-value-date
     2879                , output v-value-decimal
     2880                , output v-value-integer
     2881                , output v-value-logical
     2882                , output v-param-type
     2883                , input-output table-handle v-tth
     2884                ) no-error .
     2885   if error-status:error then do:
     2886     message
     2887     "Некорректное значение ПАРАМЕТРОВ" skip
     2888     error-status:get-message(1) skip
     2889     return-value
     2890     view-as alert-box error .
     2891     undo, return error .
     2892   end.
     2893   do TRANSACTION
     2894   on error undo, return error return-value
     2895   :
     2896     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2897          input p-obj-type
     2898         ,input p-obj-code
     2899         ,input 'cd-type-magia-xml':U
     2900         ,INPUT table thbjattr_thbj-attr
     2901     ) NO-ERROR.
     2902     IF ERROR-STATUS:error THEN do:
     2903       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2904       RETURN-VALUE
     2905       VIEW-AS ALERT-BOX.
     2906       UNDO, RETURN ERROR.
     2907     END.
     2908   end.
     2909   END PROCEDURE.
