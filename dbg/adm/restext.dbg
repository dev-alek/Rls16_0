        1   block-level on error undo, throw.
        2   define input parameter p-log-handle as handle           no-undo.
        3   define input parameter p-db-num     as integer          no-undo.
        4   define input parameter p-unload-history as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 1351a33238ea, 1271, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        7   define variable vss-date        as character no-undo init "$Date: Wed Mar 21 09:55:56 2018 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: restext.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: adm/restext.p $":U .
       10   define variable vss-description as character no-undo init "Выгрузка внешних подсистем для rest-rdb.".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure esallatr-name :
       71   do
       72     on error undo, return error
       73     :
       74     define input  parameter p-code           as character no-undo .
       75     define output parameter p-type           as character no-undo .
       76     define output parameter p-format         as character no-undo .
       77     define output parameter p-label          as character no-undo .
       78     define output parameter p-user-can-edit  as logical   no-undo .
       79     define output parameter p-output-display as logical   no-undo .
       80     define output parameter p-other          as character no-undo .
       81       case p-code :
       82               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       83               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       84         otherwise do:
       85           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
       86         end.
       87       end.
       88     end.
       89   end procedure.
       90   procedure esallatr-value :
       91   do
       92     on error undo, return error
       93     :
       94     define input  parameter p-table-name as character no-undo .
       95     define input  parameter p-key1     as int64 no-undo .
       96     define input  parameter p-key2     as int64 no-undo .
       97     define input  parameter p-key3     as character no-undo .
       98     define input  parameter p-key4     as character no-undo .
       99     define input  parameter p-key5     as int64 no-undo .
      100     define input  parameter p-key6     as int64 no-undo .
      101     define input  parameter p-key7     as character no-undo .
      102     define input  parameter p-key8     as character no-undo .
      103     define input  parameter p-code     as character no-undo .
      104     define output parameter p-value    as character no-undo .
      105     define output parameter p-type     as character no-undo .
      106     define buffer buf_esys-all-attr for ub.esys-all-attr.
      107     define variable v-format         as character no-undo .
      108     define variable v-label          as character no-undo .
      109     define variable v-user-can-edit  as logical   no-undo .
      110     define variable v-output-display as logical   no-undo .
      111     define variable v-other          as character no-undo .
      112       run esallatr-name in this-procedure
      113         (input  p-code
      114         ,output p-type
      115         ,output v-format
      116         ,output v-label
      117         ,output v-user-can-edit
      118         ,output v-output-display
      119         ,output v-other
      120         ) no-error .
      121       if error-status :error then do:
      122         undo, return error return-value .
      123       end.
      124       Find first  buf_esys-all-attr no-lock where
      125                   buf_esys-all-attr.attr-code = p-code
      126              and  buf_esys-all-attr.table-name  = p-table-name
      127              and  buf_esys-all-attr.key1  = p-key1
      128              and  buf_esys-all-attr.key2  = p-key2
      129              and  buf_esys-all-attr.key3  = p-key3
      130              and  buf_esys-all-attr.key4  = p-key4
      131              and  buf_esys-all-attr.key5  = p-key5
      132              and  buf_esys-all-attr.key6  = p-key6
      133              and  buf_esys-all-attr.key7  = p-key7
      134              and  buf_esys-all-attr.key8  = p-key8  no-error .
      135      if avail buf_esys-all-attr then do:
      136       assign
      137       p-value = buf_esys-all-attr.attr-value.
      138      end.
      139      else do:
      140       assign
      141       p-value = if p-type = 'L':U then "no":U else "".
      142      end.
      143   end.
      144   end procedure.
      145   define variable v-restext-count-str     as character    no-undo.
      146   define variable v-counter       as integer      no-undo.
      147   define variable v-table-name    as character    no-undo.
      148   define buffer buf_ext-system                for ub.ext-system.
      149   define buffer buf_c-ext-system              for ub.c-ext-system.
      150   define buffer buf_ext-system-attr           for ub.ext-system-attr.
      151   disable triggers for load of dst.ext-system.
      152   disable triggers for load of dst.c-ext-system.
      153   disable triggers for load of dst.ext-system-attr.
      154   disable triggers for load of dst.esys-datatype-exp.
      155   disable triggers for load of dst.c-esys-datatype-exp.
      156   disable triggers for load of dst.esys-datatype-imp.
      157   disable triggers for load of dst.c-esys-datatype-imp.
      158   disable triggers for load of dst.esys-pck-sent.
      159   disable triggers for load of dst.esys-pck-rcvd.
      160   disable triggers for load of dst.esys-pck-keys.
      161   disable triggers for load of dst.esys-route.
      162   disable triggers for load of dst.esys-route-dump.
      163   disable triggers for load of dst.esys-all-attr.
      164   do
      165   for buf_ext-system
      166     , buf_c-ext-system
      167     , buf_ext-system-attr
      168   on error undo, return error
      169   :
      170       assign
      171           v-counter       = 0
      172           v-table-name    = "ext-system":U
      173       .
      174       for each buf_ext-system no-lock
      175          where buf_ext-system.esys-db-num-imp = p-db-num
      176          or buf_ext-system.esys-db-num-exp = p-db-num
      177          or buf_ext-system.esys-type > integer('0':U)
      178       on error undo, return error
      179       :
      180           assign
      181               v-counter = v-counter + 1
      182               v-restext-count-str = substitute( "Обработано внешних систем: &1", v-counter )
      183           .
      184           run display-with-frame in p-log-handle (
      185                 input v-restext-count-str
      186               , input v-table-name
      187               , input v-counter
      188           ).
      189           create dst.ext-system.
      190           buffer-copy buf_ext-system to dst.ext-system.
      191         for each buf_ext-system-attr no-lock where
      192                 buf_ext-system-attr.esys-id = buf_ext-system.esys-id
      193             and buf_ext-system-attr.db-num = buf_ext-system.db-num
      194         on error undo, return error
      195         :
      196           create dst.ext-system-attr.
      197           buffer-copy buf_ext-system-attr to dst.ext-system-attr.
      198         end.
      199         if buf_ext-system.esys-db-num-exp = p-db-num then do:
      200           run restext-esys-datatype-exp in this-procedure (
      201                 input buf_ext-system.esys-id
      202               , input buf_ext-system.db-num
      203           ).
      204         end.
      205         if buf_ext-system.esys-db-num-imp = p-db-num then do:
      206           run restext-esys-datatype-imp in this-procedure (
      207                 input buf_ext-system.esys-id
      208               , input buf_ext-system.db-num
      209           ).
      210         end.
      211         if (buf_ext-system.esys-db-num-exp = p-db-num
      212         or buf_ext-system.esys-db-num-imp = p-db-num)
      213         and not buf_ext-system.delivery-method = 11 then do:
      214           run restext-esys-pck in this-procedure (
      215                 input buf_ext-system.esys-id
      216               , input buf_ext-system.db-num
      217           ).
      218         end.
      219       if p-unload-history then do:
      220         assign
      221             v-counter       = 0
      222             v-table-name    = "c-ext-system":U
      223         .
      224         for each buf_c-ext-system no-lock
      225             where buf_c-ext-system.esys-id = buf_ext-system.esys-id
      226             and buf_c-ext-system.db-num = buf_ext-system.db-num
      227         on error undo, return error
      228         :
      229             assign
      230                 v-counter = v-counter + 1
      231             .
      232             run display-with-frame in p-log-handle (
      233                   input substitute( "Обработано удалённых внешних систем: &1", v-counter )
      234                 , input v-table-name
      235                 , input v-counter
      236             ).
      237             create dst.c-ext-system.
      238             buffer-copy buf_c-ext-system to dst.c-ext-system.
      239               if buf_ext-system.esys-db-num-exp = p-db-num then do:
      240             run restext-esys-datatype-exp in this-procedure (
      241                   input buf_c-ext-system.esys-id
      242                 , input buf_c-ext-system.db-num
      243             ).
      244               end.
      245               if buf_ext-system.esys-db-num-imp = p-db-num then do:
      246             run restext-esys-datatype-imp in this-procedure (
      247                   input buf_c-ext-system.esys-id
      248                 , input buf_c-ext-system.db-num
      249             ).
      250               end.
      251         end.
      252       end.
      253     end.
      254   end.
      255   procedure restext-esys-datatype-exp :
      256   define input parameter p-esys-id    as integer          no-undo.
      257   define input parameter p-db-num     as integer          no-undo.
      258       define variable v-counter    as integer      no-undo.
      259       define buffer buf_esys-datatype-exp     for ub.esys-datatype-exp.
      260       define buffer buf_c-esys-datatype-exp   for ub.c-esys-datatype-exp.
      261   do
      262   for buf_esys-datatype-exp
      263     , buf_c-esys-datatype-exp
      264   on error undo, return error
      265   :
      266       assign
      267           v-counter = 0
      268       .
      269       for each buf_esys-datatype-exp no-lock
      270          where buf_esys-datatype-exp.esys-id  = p-esys-id
      271            and buf_esys-datatype-exp.db-num   = p-db-num
      272       on error undo, return error
      273       :
      274           assign
      275               v-counter = v-counter + 1
      276           .
      277           run display-with-frame in p-log-handle (
      278                 input v-restext-count-str
      279               , input "esys-datatype-exp":U
      280               , input v-counter
      281           ).
      282           create dst.esys-datatype-exp.
      283           buffer-copy buf_esys-datatype-exp to dst.esys-datatype-exp.
      284       end.
      285       if p-unload-history then do:
      286         for each buf_c-esys-datatype-exp no-lock
      287           where buf_c-esys-datatype-exp.esys-id  = p-esys-id
      288             and buf_c-esys-datatype-exp.db-num   = p-db-num
      289         on error undo, return error
      290         :
      291             assign
      292                 v-counter = v-counter + 1
      293             .
      294             run display-with-frame in p-log-handle (
      295                   input v-restext-count-str
      296                 , input "c-esys-datatype-exp":U
      297                 , input v-counter
      298             ).
      299             create dst.c-esys-datatype-exp.
      300             buffer-copy buf_c-esys-datatype-exp to dst.c-esys-datatype-exp.
      301         end.
      302       end.
      303   end.
      304   end procedure.
      305   procedure restext-esys-datatype-imp :
      306   define input parameter p-esys-id    as integer          no-undo.
      307   define input parameter p-db-num     as integer          no-undo.
      308       define variable v-counter    as integer      no-undo.
      309       define buffer buf_esys-datatype-imp     for ub.esys-datatype-imp.
      310       define buffer buf_c-esys-datatype-imp   for ub.c-esys-datatype-imp.
      311   do
      312   for buf_esys-datatype-imp
      313     , buf_c-esys-datatype-imp
      314   on error undo, return error
      315   :
      316       assign
      317           v-counter       = 0
      318       .
      319       for each buf_esys-datatype-imp no-lock
      320          where buf_esys-datatype-imp.esys-id  = p-esys-id
      321            and buf_esys-datatype-imp.db-num   = p-db-num
      322       on error undo, return error
      323       :
      324           assign
      325               v-counter = v-counter + 1
      326           .
      327           run display-with-frame in p-log-handle (
      328                 input v-restext-count-str
      329               , input "esys-datatype-imp":U
      330               , input v-counter
      331           ).
      332           create dst.esys-datatype-imp.
      333           buffer-copy buf_esys-datatype-imp to dst.esys-datatype-imp.
      334       end.
      335       if p-unload-history then do:
      336         for each buf_c-esys-datatype-imp no-lock
      337           where buf_c-esys-datatype-imp.esys-id  = p-esys-id
      338             and buf_c-esys-datatype-imp.db-num   = p-db-num
      339         on error undo, return error
      340         :
      341             assign
      342                 v-counter = v-counter + 1
      343             .
      344             run display-with-frame in p-log-handle (
      345                   input v-restext-count-str
      346                 , input "c-esys-datatype-imp":U
      347                 , input v-counter
      348             ).
      349             create dst.c-esys-datatype-imp.
      350             buffer-copy buf_c-esys-datatype-imp to dst.c-esys-datatype-imp.
      351         end.
      352      end.
      353   end.
      354   end procedure.
      355   procedure restext-esys-pck :
      356   define input parameter p-esys-id as integer no-undo .
      357   define input parameter p-db-num as integer no-undo .
      358   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
      359   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
      360   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
      361   define buffer buf_esys-route for ub.esys-route.
      362   define buffer buf_esys-route-dump for ub.esys-route-dump.
      363   define buffer buf_esys-all-attr for ub.esys-all-attr.
      364   define buffer buf2_esys-route for ub.esys-route.
      365   do
      366   for buf_esys-pck-sent
      367     , buf_esys-pck-rcvd
      368     , buf_esys-pck-keys
      369   on error undo, return error
      370   :
      371     assign
      372         v-counter       = 0
      373     .
      374     for each buf_esys-pck-sent no-lock
      375         where buf_esys-pck-sent.esys-id  = p-esys-id
      376           and buf_esys-pck-sent.db-num   = p-db-num
      377     on error undo, return error
      378     :
      379         create dst.esys-pck-sent.
      380         buffer-copy buf_esys-pck-sent to
      381         dst.esys-pck-sent.
      382         assign
      383             v-counter = v-counter + 1
      384         .
      385        find first buf_esys-all-attr no-lock where
      386                 buf_esys-all-attr.attr-code = 'custom-pack-name':U
      387             and buf_esys-all-attr.table-name = 'esys-pck-sent':U
      388             and  buf_esys-all-attr.key1 = buf_esys-pck-sent.esps-pack-num
      389             and  buf_esys-all-attr.key2 = buf_esys-pck-sent.esys-id
      390             and  buf_esys-all-attr.key5 = buf_esys-pck-sent.db-num no-error.
      391         if available buf_esys-all-attr then do:
      392           create dst.esys-all-attr.
      393           buffer-copy buf_esys-all-attr to
      394           dst.esys-all-attr.
      395         end.
      396         run display-with-frame in p-log-handle (
      397               input v-restext-count-str
      398             , input "esys-pck-sent":U
      399             , input v-counter
      400         ).
      401     end.
      402     for each buf_esys-pck-rcvd no-lock
      403         where buf_esys-pck-rcvd.esys-id  = p-esys-id
      404           and buf_esys-pck-rcvd.db-num   = p-db-num
      405     on error undo, return error
      406     :
      407         create dst.esys-pck-rcvd.
      408         buffer-copy buf_esys-pck-rcvd to
      409         dst.esys-pck-rcvd.
      410         assign
      411             v-counter = v-counter + 1
      412         .
      413         run display-with-frame in p-log-handle (
      414               input v-restext-count-str
      415             , input "esys-pck-rcvd":U
      416             , input v-counter
      417         ).
      418     end.
      419     for each buf_esys-route no-lock
      420         where buf_esys-route.esys-id  = p-esys-id
      421           and buf_esys-route.db-num   = p-db-num
      422     on error undo, return error
      423     :
      424         if buf_esys-route.esr-last-pack = -1 then do:
      425           find first buf2_esys-route no-lock where
      426                     buf2_esys-route.esys-id = buf_esys-route.esys-id
      427                and buf2_esys-route.db-num = buf_esys-route.db-num
      428                and buf2_esys-route.esr-tbl-ord = buf_esys-route.esr-tbl-ord
      429                and buf2_esys-route.esr-cr-db-num = buf_esys-route.esr-cr-db-num
      430                and buf2_esys-route.esr-last-pack > 0
      431                no-error.
      432           if available buf2_esys-route then next.
      433         end.
      434         for each buf_esys-route-dump no-lock
      435             where buf_esys-route-dump.esrd-dump-ord  = buf_esys-route.esr-dump-ord
      436               and buf_esys-route-dump.esrd-rec-ord > -29999999
      437               and buf_esys-route-dump.esrd-cr-db-num = buf_esys-route.esr-cr-db-num
      438         on error undo, return error
      439         :
      440           create dst.esys-route-dump.
      441           buffer-copy buf_esys-route-dump to
      442           dst.esys-route-dump.
      443           assign
      444               v-counter = v-counter + 1
      445           .
      446         end.
      447         find first buf_esys-all-attr no-lock where
      448                 buf_esys-all-attr.attr-code = 'route-custom-pack-name':U
      449             and buf_esys-all-attr.table-name = 'esys-route':U
      450             and  buf_esys-all-attr.key1 = buf_esys-route.esr-dump-ord
      451             and  buf_esys-all-attr.key2 = buf_esys-route.esys-id
      452             and  buf_esys-all-attr.key5 = buf_esys-route.db-num no-error.
      453         if available buf_esys-all-attr then do:
      454           create dst.esys-all-attr.
      455           buffer-copy buf_esys-all-attr to
      456           dst.esys-all-attr.
      457         end.
      458         create dst.esys-route.
      459         buffer-copy buf_esys-route to
      460         dst.esys-route.
      461         assign
      462             v-counter = v-counter + 1
      463         .
      464         run display-with-frame in p-log-handle (
      465               input v-restext-count-str
      466             , input "esys-route":U
      467             , input v-counter
      468         ).
      469     end.
      470   end.
      471   end procedure.
