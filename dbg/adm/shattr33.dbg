      616   procedure proc-alt-shift-f2:
      617     if not ibs.th.gbl.gbl-var:rcode
      618   then
      619     run gbl\inidebug.p .
      620   end.
      621   procedure proc-alt-shift-f3:
      622     run gbl/prvssinf.p
      623       ( input this-procedure
      624       ) .
      625   end.
      626   define variable v-inform-launched as logical no-undo initial false .
      627   procedure proc-alt-shift-f4:
      628     define variable v-action as character no-undo .
      629     if v-inform-launched = false then do:
      630       assign
      631         v-inform-launched = true
      632       .
      633       run gbl/d-inform.w
      634         (  input self
      635         ,  input this-procedure
      636         , output v-action
      637         ) no-error .
      638       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      639       assign
      640         v-inform-launched = false
      641       .
      642     end.
      643   end.
      644   procedure proc-alt-f1:
      645     run gbl/corrhelp.p
      646       (input this-procedure
      647       ) .
      648   end .
      649   on alt-shift-f2 anywhere do:
      650     run proc-alt-shift-f2.
      651   end.
      652   on alt-shift-f3 anywhere do:
      653     run proc-alt-shift-f3 in this-procedure .
      654   end.
      655   on alt-shift-f4 anywhere do:
      656     run proc-alt-shift-f4 in this-procedure.
      657   end.
      658   on alt-f1 anywhere do:
      659     run proc-alt-f1 in this-procedure .
      660   end.
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662     define variable v-cntxt-db-num        as integer   no-undo .
      663     define variable v-cntxt-userid        as character no-undo .
      664     define variable v-cntxt-level         as character no-undo .
      665     define variable v-cntxt-host-code-obj as integer   no-undo .
      666     define variable v-cntxt-obj-type      as character no-undo .
      667     define variable v-cntxt-obj-code      as integer   no-undo .
      668     define variable v-cntxt-db-num-obj    as integer   no-undo .
      669     define variable v-cntxt-is-admin      as logical   no-undo .
      670   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      671   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      672   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      673   define buffer buf_wth-place   for ub.wth-place.
      674   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      675   define variable v-tth as handle no-undo .
      676   assign
      677   v-tth = buffer thbjattr_thbj-attr:table-handle .
      678   DEFINE BUTTON B-exit AUTO-GO
      679        LABEL "&Ввод"
      680        SIZE 10 BY 1
      681        BGCOLOR 8 .
      682   DEFINE BUTTON B-Help
      683        LABEL "Помо&щь"
      684        SIZE 3 BY 1
      685        BGCOLOR 8 .
      686   DEFINE BUTTON b-quit AUTO-END-KEY
      687        LABEL "&Отмена"
      688        SIZE 10 BY 1
      689        BGCOLOR 8 .
      690   DEFINE VARIABLE t-clsfact AS LOGICAL INITIAL no
      691        LABEL "Закрывать документы при формировании по чекам МЦ"
      692        VIEW-AS TOGGLE-BOX
      693        SIZE 55.5 BY 1 NO-UNDO.
      694   DEFINE VARIABLE t-prsdoc AS LOGICAL INITIAL no
      695        LABEL "Проверка на наличие физ. лиц в документах МЦ"
      696        VIEW-AS TOGGLE-BOX
      697        SIZE 50.5 BY .83 NO-UNDO.
      698   DEFINE FRAME Dialog-Frame
      699        B-exit AT ROW 1 COL 1
      700        b-quit AT ROW 1 COL 11
      701        B-Help AT ROW 1 COL 95
      702        t-clsfact AT ROW 2.77 COL 2.5
      703        t-prsdoc AT ROW 4 COL 2.5 WIDGET-ID 8
      704        SPACE(46.24) SKIP(0.70)
      705       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      706            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      707            TITLE "Настройки МЦ"
      708            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      709   ASSIGN
      710          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      711          FRAME Dialog-Frame:HIDDEN           = TRUE.
      712   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      713   DO:
      714     APPLY "END-ERROR":U TO SELF.
      715   END.
      716   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      717   DO:
      718     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      719     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      720   END.
      721   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      722   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      723   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   on help of frame Dialog-Frame
      725   do:
      726     run gbl/app_help.p
      727       (input this-procedure :file-name
      728       ,input ''
      729       ,input ?
      730       ) no-error.
      731     if error-status :error then do:
      732       message
      733         "Ошибка при вызове помощи"
      734         error-status :get-message(1)
      735         view-as alert-box .
      736     end.
      737   end.
      738   run minbtn-set in this-procedure .
      739   on choose of b-help in frame Dialog-Frame
      740   do:
      741     apply "help":u to frame Dialog-Frame .
      742   end.
      743   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   procedure minbtn-set :
      745       do
      746           on error undo, return error return-value
      747           :
      748           define variable ii              as integer       no-undo .
      749           define variable fh              as widget-handle no-undo .
      750           define variable hh              as widget-handle no-undo .
      751           define variable v-h             as handle        extent 4 no-undo .
      752           define variable v-name-button   as character     no-undo .
      753           define variable v-help-old-x    as decimal       no-undo .
      754           define variable v-help-old-y    as decimal       no-undo .
      755           define variable v-help-old-size as decimal       no-undo .
      756           define variable v-frame-width   as decimal       no-undo .
      757           define variable jj              as integer       no-undo .
      758           do
      759               on error undo, return error
      760               :
      761               assign
      762                   v-frame-width = frame Dialog-Frame:width - 0.3
      763                   fh            = frame Dialog-Frame:first-child
      764                   hh            = fh:first-child
      765                   ii            = 1
      766                   .
      767               do while valid-handle(hh):
      768                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      769                   do:
      770                       case lc(hh:name) :
      771                           when "b-help" then
      772                               do:
      773                                   hh:load-image-up("cmp/b-help.bmp":u) .
      774                                   hh:load-image-down("cmp/b-help.bmp":u) .
      775                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      776                                   hh:TOOLTIP = "Помощь" .
      777                                   v-help-old-x = hh:column .
      778                                   v-help-old-y = hh:row    .
      779                                   v-help-old-size = hh:width .
      780                                   hh:width-chars = 2.5 .
      781                               end.
      782                           when "b-print" then
      783                               do:
      784                                   hh:load-image("cmp/b-print.bmp":u) .
      785                                   hh:TOOLTIP = "Печать" .
      786                                   v-h[ii] = hh:handle .
      787                                   ii = ii + 1 .
      788                                   hh:width-chars = 3 .
      789                               end.
      790                           when "b-history" or
      791                           when "b-hist" then
      792                               do:
      793                                   hh:load-image("cmp/b-hist.bmp":u) .
      794                                   hh:TOOLTIP = "История" .
      795                                   v-h[ii] = hh:handle .
      796                                   ii = ii + 1 .
      797                                   hh:width-chars = 3 .
      798                               end.
      799                           when "b-sch" then
      800                               do:
      801                                   hh:load-image("cmp/b-sch.bmp":u) .
      802                                   hh:TOOLTIP = "Установка Фильтра" .
      803                                   v-h[ii] = hh:handle .
      804                                   ii = ii + 1 .
      805                                   hh:width-chars = 3 .
      806                               end.
      807                           when "b-hist-user" then
      808                               do:
      809                                   hh:load-image("cmp/b-hist.bmp":u) .
      810                                   hh:TOOLTIP = "История пользователя" .
      811                                   ii = ii + 1 .
      812                               end.
      813                       end case.
      814                   end.
      815                   hh = hh:next-sibling.
      816               end.
      817               b-help:column = v-frame-width - b-help:width-chars.
      818               jj = 0.
      819               repeat ii = 4 to 1 by -1 :
      820                   if valid-handle (v-h[ii] ) then
      821                   do:
      822                       jj  = jj + 1 .
      823                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      824                       v-h[ii]:row    = v-help-old-y .
      825                   end.
      826               end.
      827           end.
      828       end.
      829   end procedure.
      830   MAIN-BLOCK:
      831   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      832      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      833   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834     run mainmenu_getcntxt in parparentproc
      835       (output v-cntxt-db-num
      836       ,output v-cntxt-userid
      837       ,output v-cntxt-level
      838       ,output v-cntxt-host-code-obj
      839       ,output v-cntxt-obj-type
      840       ,output v-cntxt-obj-code
      841       ,output v-cntxt-db-num-obj
      842       ,output v-cntxt-is-admin
      843       ) .
      844   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   ON TAB ANYWHERE
      846   DO:
      847   define variable ii as integer no-undo .
      848   define variable fh as widget-handle no-undo .
      849   define variable hh as widget-handle no-undo .
      850   define variable v-next-widget-name as character no-undo .
      851   if v-tab-order <> '' then do:
      852     if self:type = "TOGGLE-BOX" then
      853     self:BGCOLOR = ?.
      854     assign
      855     ii = lookup(self:name, v-tab-order).
      856     assign
      857     ii = ii + 1
      858     v-next-widget-name = entry(ii, v-tab-order)
      859     no-error .
      860     if error-status:error then do:
      861       assign
      862       ii = 1
      863       v-next-widget-name = entry( ii, v-tab-order)
      864       .
      865     end.
      866     assign
      867     fh = frame Dialog-Frame:first-child
      868     hh = fh:first-child
      869     .
      870     do while valid-handle(hh):
      871       if hh:name = v-next-widget-name then do:
      872         if hh:sensitive  = yes
      873         AND hh:visible = yes then do:
      874           if hh:type = "TOGGLE-BOX":U then do:
      875             assign
      876             hh:BGcolor = 1
      877             .
      878           end.
      879           APPLY "ENTRY" to hh.
      880           return no-apply.
      881         end.
      882         else do:
      883           APPLY "TAB" to hh.
      884           return no-apply.
      885         end.
      886       end.
      887       hh = hh:next-sibling.
      888     end.
      889   end.
      890   END.
      891   ON BACK-TAB ANYWHERE
      892   DO:
      893   define variable ii as integer no-undo .
      894   define variable fh as widget-handle no-undo .
      895   define variable hh as widget-handle no-undo .
      896   define variable v-next-widget-name as character no-undo .
      897   if v-tab-order <> '' then do:
      898     assign
      899     ii = lookup(self:name, v-tab-order).
      900     .
      901     assign
      902     ii = (if ii = 1
      903           then  num-entries(v-tab-order)
      904           else ii - 1
      905           )
      906     v-next-widget-name = entry(ii, v-tab-order)
      907     .
      908     assign
      909     fh = frame Dialog-Frame:first-child
      910     hh = fh:first-child
      911     .
      912     do while valid-handle(hh):
      913       if hh:name = v-next-widget-name then do:
      914         if hh:sensitive  = yes
      915         AND hh:visible = yes then do:
      916           if hh:type = "TOGGLE-BOX":U then do:
      917             assign
      918             hh:BGcolor = 1
      919             .
      920           end.
      921           APPLY "ENTRY" to hh.
      922           return no-apply.
      923         end.
      924         else do:
      925         APPLY "BACK-TAB" to hh.
      926         return no-apply.
      927         end.
      928       end.
      929       hh = hh:next-sibling.
      930     end.
      931     end.
      932   END.
      933   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   ON RETURN ANYWHERE
      935   DO:
      936   define variable ii as integer no-undo .
      937   define variable fh as widget-handle no-undo .
      938   define variable hh as widget-handle no-undo .
      939   define variable v-next-widget-name as character no-undo .
      940     if v-tab-order <> '' then do:
      941       assign
      942       ii = lookup(self:name, v-tab-order).
      943       if ii = num-entries(v-tab-order) then do:
      944           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      945           return no-apply.
      946       end.
      947       if self:type <> "BUTTON" and
      948         self:type <> "EDITOR"  then do:
      949         run proc-move-forward in this-procedure .
      950         return no-apply.
      951       end.
      952       if self:type = "BUTTON" then do:
      953         APPLY "CHOOSE" to self.
      954       end.
      955       if self:type = "TOGGLE-BOX" then
      956       self:BGCOLOR = ?.
      957       assign
      958       ii = ii + 1
      959       v-next-widget-name = entry(ii, v-tab-order)
      960       no-error .
      961       if error-status:error then do:
      962         assign
      963         ii = 1
      964         v-next-widget-name = entry( ii, v-tab-order)
      965         .
      966       end.
      967       assign
      968       fh = frame Dialog-Frame:first-child
      969       hh = fh:first-child
      970       .
      971       do while valid-handle(hh):
      972         if hh:name = v-next-widget-name then do:
      973           if hh:sensitive  = yes
      974           AND hh:visible = yes then do:
      975             if hh:type = "TOGGLE-BOX":U then do:
      976               assign
      977               hh:BGcolor = 1
      978               .
      979             end.
      980             APPLY "ENTRY" to hh.
      981             return no-apply.
      982           end.
      983           else do:
      984             APPLY "TAB" to hh.
      985             return no-apply.
      986           end.
      987         end.
      988         hh = hh:next-sibling.
      989       end.
      990     end.
      991   END.
      992   procedure proc-move-forward :
      993   define variable ii as integer no-undo .
      994   define variable fh as widget-handle no-undo .
      995   define variable hh as widget-handle no-undo .
      996   define variable v-next-widget-name as character no-undo .
      997   do
      998   on error undo, return error
      999   :
     1000     if v-tab-order <> '' then do:
     1001       if self:type = "TOGGLE-BOX" then
     1002       self:BGCOLOR = ?.
     1003       assign
     1004       ii = lookup(self:name, v-tab-order).
     1005       assign
     1006       ii = ii + 1
     1007       v-next-widget-name = entry(ii, v-tab-order)
     1008       no-error .
     1009       if error-status:error then do:
     1010         assign
     1011         ii = 1
     1012         v-next-widget-name = entry( ii, v-tab-order)
     1013         .
     1014       end.
     1015       assign
     1016       fh = frame Dialog-Frame:first-child
     1017       hh = fh:first-child
     1018       .
     1019       do while valid-handle(hh):
     1020         if hh:name = v-next-widget-name then do:
     1021           if hh:sensitive  = yes
     1022           AND hh:visible = yes then do:
     1023             if hh:type = "TOGGLE-BOX":U then do:
     1024               assign
     1025               hh:BGcolor = 1
     1026               .
     1027             end.
     1028             APPLY "ENTRY" to hh.
     1029             return.
     1030           end.
     1031           else do:
     1032             assign
     1033             ii = ii + 1
     1034             v-next-widget-name = entry(ii, v-tab-order)
     1035             no-error .
     1036             if error-status:error then do:
     1037               assign
     1038               ii = 1
     1039               v-next-widget-name = entry( ii, v-tab-order)
     1040               .
     1041             end.
     1042           end.
     1043         end.
     1044         hh = hh:next-sibling.
     1045       end.
     1046     end.
     1047   end.
     1048   end procedure.
     1049     IF p-mode <> 'ПРОСМОТР':U
     1050     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1051         MESSAGE
     1052         vss-workfile vss-revision vss-description skip
     1053         "Неверное значение параметра p-mode" p-mode
     1054         VIEW-AS ALERT-BOX ERROR.
     1055         UNDO, RETURN ERROR.
     1056     END.
     1057     IF  p-obj-type <> '':U
     1058     THEN DO:
     1059         MESSAGE
     1060         vss-workfile vss-revision vss-description skip
     1061         "Неверное значение параметра p-obj-type" p-obj-type
     1062         VIEW-AS ALERT-BOX ERROR.
     1063         UNDO, RETURN ERROR.
     1064     END.
     1065     if p-obj-type = '':U then do:
     1066       if v-cntxt-db-num <> 0
     1067       and p-mode <> 'ПРОСМОТР':U
     1068       then do:
     1069           MESSAGE
     1070           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1071           VIEW-AS ALERT-BOX ERROR.
     1072           UNDO, RETURN ERROR.
     1073       end.
     1074     end.
     1075     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1076       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1077                 LOCKED_thbj-attr.obj-type = p-obj-type
     1078           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1079           AND   LOCKED_thbj-attr.upper-prop-code = 'wthdoc':U
     1080           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1081        if locked locked_thbj-attr then do:
     1082           message
     1083           vss-workfile vss-revision vss-description skip
     1084            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1085           view-as alert-box error .
     1086           undo, return error.
     1087         end.
     1088     END.
     1089     ELSE DO:
     1090         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1091             LOCKED_thbj-attr.obj-type = p-obj-type
     1092       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1093       AND   LOCKED_thbj-attr.upper-prop-code = 'wthdoc':U
     1094       and   locked_thbj-attr.prop-code = '':U
     1095       NO-ERROR.
     1096     END.
     1097     if not available locked_thbj-attr then do:
     1098       ASSIGN
     1099       v-to-create  = YES.
     1100       message
     1101       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1102                   chr(10))
     1103       view-as alert-box WARNING.
     1104     end.
     1105     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1106     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1107     RUN Myenable.
     1108     WAIT-FOR GO OF FRAME Dialog-Frame.
     1109   END.
     1110   RUN disable_UI.
     1111   PROCEDURE disable_UI :
     1112     HIDE FRAME Dialog-Frame.
     1113   END PROCEDURE.
     1114   PROCEDURE enable_UI :
     1115     DISPLAY t-clsfact t-prsdoc
     1116         WITH FRAME Dialog-Frame.
     1117     ENABLE B-exit b-quit B-Help t-clsfact t-prsdoc
     1118         WITH FRAME Dialog-Frame.
     1119     VIEW FRAME Dialog-Frame.
     1120   END PROCEDURE.
     1121   PROCEDURE fill-widgets :
     1122   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1123   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1124   define variable v-param-type as character no-undo .
     1125   define variable v-param-value as character no-undo .
     1126   define variable v-value-character as character no-undo .
     1127   define variable v-value-date as date no-undo .
     1128   define variable v-value-decimal as decimal no-undo .
     1129   define variable v-value-integer as INTEGER no-undo .
     1130   define variable v-value-logical AS LOGICAL no-undo .
     1131   FOR EACH thbjattr_thbj-attr:
     1132     delete thbjattr_thbj-attr.
     1133   end.
     1134   FOR EACH temp-thbj-attr:
     1135     delete temp-thbj-attr.
     1136   end.
     1137   run adm/shattri.p (
     1138                 input "init":U
     1139               , input p-obj-type
     1140               , input p-obj-code
     1141               , input 'wthdoc':U
     1142               , input "":U
     1143               , output v-value-character
     1144               , output v-value-date
     1145               , output v-value-decimal
     1146               , output v-value-integer
     1147               , output v-value-logical
     1148               , output v-param-type
     1149               , INPUT-OUTPUT TABLE-handle v-tth
     1150               ) no-error .
     1151   if error-status:error
     1152   and not available locked_thbj-attr then do:
     1153     message
     1154     "Не удалось получить начальные значения настроек" skip
     1155     error-status:get-message(1) return-value
     1156     view-as alert-box error .
     1157     undo, return error .
     1158   end.
     1159   FOR EACH thbjattr_thbj-attr:
     1160     ASSIGN
     1161     v-entry = thbjattr_thbj-attr.prop-code.
     1162     IF v-entry = 'prsdoc':U THEN DO:
     1163       ASSIGN
     1164       t-prsdoc = thbjattr_thbj-attr.property-value-logical
     1165       t-prsdoc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1166       .
     1167     END.
     1168     IF v-entry = 'clsfact':U THEN DO:
     1169       ASSIGN
     1170       t-clsfact  = thbjattr_thbj-attr.property-value-logical
     1171       t-clsfact:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1172       .
     1173     END.
     1174     create temp-thbj-attr.
     1175     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1176   END.
     1177   END PROCEDURE.
     1178   PROCEDURE MyEnable :
     1179   ASSIGN
     1180   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1181   v-tab-order = "f-stfactpref,f-numsfact,t-clsfact,f-inwpcode".
     1182   DISPLAY
     1183   t-clsfact
     1184   t-prsdoc
     1185   WITH FRAME Dialog-Frame.
     1186   ENABLE
     1187   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1188   b-quit
     1189   B-Help
     1190   t-prsdoc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1191   t-clsfact WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1192   WITH FRAME Dialog-Frame.
     1193   VIEW FRAME Dialog-Frame.
     1194   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1195       HIDE
     1196       b-exit
     1197       IN FRAME Dialog-Frame.
     1198       ASSIGN
     1199       b-quit:LABEL = "&Выход"
     1200       .
     1201   END.
     1202   END PROCEDURE.
     1203   PROCEDURE proc-save :
     1204   define variable v-value-character as character no-undo .
     1205   define variable v-value-date as date no-undo .
     1206   define variable v-value-decimal as decimal no-undo .
     1207   define variable v-value-integer as INTEGER no-undo .
     1208   define variable v-value-logical AS LOGICAL no-undo .
     1209   define variable v-param-type as character no-undo .
     1210   define variable wh as widget-handle no-undo .
     1211   define variable fh as widget-handle no-undo .
     1212   define variable v-same as logical no-undo .
     1213   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1214   ASSIGN
     1215   FRAME Dialog-Frame
     1216   t-clsfact
     1217   t-prsdoc
     1218   .
     1219   assign
     1220   fh = frame Dialog-Frame:first-child
     1221   wh = fh:first-child
     1222   .
     1223   do while valid-handle(wh):
     1224     if wh:private-data begins "recid=" then do:
     1225       find first thbjattr_thbj-attr where
     1226                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1227       assign
     1228       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1229     end.
     1230     wh = wh:next-sibling.
     1231   end.
     1232   v-same = yes.
     1233   for each thbjattr_thbj-attr,
     1234       first temp-thbj-attr where
     1235             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1236         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1237         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1238         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1239      buffer-compare
     1240      thbjattr_thbj-attr
     1241      to temp-thbj-attr
     1242      save result in v-same.
     1243      if v-same = no then leave.
     1244   end.
     1245   v-same = no.
     1246   IF v-same  and not v-to-create THEN RETURN.
     1247   run adm/shattri.p (
     1248                  input "check":U
     1249                , input p-obj-type
     1250                , input p-obj-code
     1251                , input 'wthdoc':U
     1252                , input '':U
     1253                , output v-value-character
     1254                , output v-value-date
     1255                , output v-value-decimal
     1256                , output v-value-integer
     1257                , output v-value-logical
     1258                , output v-param-type
     1259                , input-output TABLE-handle v-tth
     1260               ) no-error .
     1261   if error-status:error then do:
     1262     message
     1263     "Некорректное значение ПАРАМЕТРОВ" skip
     1264     error-status:get-message(1) skip
     1265     return-value
     1266     view-as alert-box error .
     1267     undo, return error .
     1268   end.
     1269   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1270        input p-obj-type
     1271       ,input p-obj-code
     1272       ,input 'wthdoc':U
     1273       ,input table thbjattr_thbj-attr
     1274   ) NO-ERROR.
     1275   IF ERROR-STATUS:error THEN do:
     1276     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1277     RETURN-VALUE
     1278     VIEW-AS ALERT-BOX.
     1279     UNDO, RETURN ERROR.
     1280   END.
     1281   END PROCEDURE.
