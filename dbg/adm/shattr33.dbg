      329   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      330   procedure thbjattr_code :
      331      define input  parameter p-upper-code     as character no-undo .
      332      define input  parameter p-code           as character no-undo .
      333      define output parameter p-label          as character no-undo .
      334      define output parameter p-user-can-edit  as logical   no-undo .
      335      define output parameter p-output-display as logical   no-undo .
      336      define output parameter p-other          as character no-undo .
      337      define output parameter p-prop-list      as character no-undo .
      338      define output parameter p-prop-type-list as character no-undo .
      339      define output parameter p-prop-label-list as character no-undo .
      340      define output parameter p-global          as logical no-undo .
      341      define output parameter p-host           as logical no-undo .
      342      define output parameter p-shop           as logical no-undo .
      343      define output parameter p-store          as logical no-undo .
      344      define output parameter p-db             as logical no-undo .
