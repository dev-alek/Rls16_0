      401   define variable par-type     as character no-undo .
      402   define variable v-is-hold    as logical   no-undo .
      403   define variable v-is-fin     as logical   no-undo .
      404   define variable v-is-credit  as logical no-undo .
      405   define variable vartpsi      as character no-undo .
      406   define variable vartpsi-type as character no-undo .
      407   define variable vardeleted   as logical   no-undo.
      408   define variable glog         as logical no-undo .
      409   define buffer buf_sysconf for ub.sysconf.
      410   define buffer buf_clients for ub.clients.
      411   define buffer buf_pay-type for ub.pay-type .
      412   define buffer buf_cash-pay for ub.cash-pay.
      413   define buffer buf_currency for ub.currency.
      414   define buffer posr_sysconf for ub.sysconf.
      415   define buffer main_sysconf for ub.sysconf.
      416   define buffer main_clients for ub.clients.
      417   define buffer main_firm  for ub.firm.
      418   if p-mode <> 'ДОБАВЛЕНИЕ':U
      419   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      420     message
      421     vss-workfile vss-revision vss-description skip
      422     "Неверный параметр p-mode" p-mode
      423     view-as alert-box error .
      424     return error '':u.
      425   end.
      426   if p-mode = 'ИЗМЕНЕНИЕ':U
      427   and p-is-deploy = yes then do:
      428     message
      429     vss-workfile vss-revision vss-description skip
      430     "Неверный параметр p-is-deploy" p-is-deploy
      431     view-as alert-box error .
      432     return error '':u.
      433   end.
      434   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      436     (output v-db-num
      437     )  .
      438   if v-db-num <> 0
      439   then do:
      440     run err-mess in this-procedure ( input substitute("Нельзя изменять запись СВОЕЙ ФИРМЫ в УБД: Номер текущей БД &1", v-db-num ) ).
      441     undo, return error "":U.
      442   end.
      443   if not can-find (ub.currency where
      444                   ub.currency.curr-code = p-base-code no-lock) then do:
      445     run err-mess in this-procedure ( input substitute("Не найдена базовая валюта: код валюты &1", p-base-code ) ).
      446     undo, return error "base-code":U.
      447   end.
      448   if p-obj-name = "":U then do:
      449     run err-mess in this-procedure ( input "Имя СВОЕЙ ФИРМЫ НЕ МОЖЕТ БЫТЬ ПУСТЫМ" ).
      450     undo, return error "obj-name":U.
      451   end.
      452   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      453     if can-find (ub.sysconf where
      454                 ub.sysconf.host = p-host-code no-lock) then do:
      455       run err-mess in this-procedure ( input substitute("Уже есть СВОЯ ФИРМА с кодом &1", p-host-code) ).
      456       undo, return error "host-code":U.
      457     end.
      458     if not p-is-deploy
      459     and
      460     can-find (first ub.clients no-lock where
      461                     ub.clients.obj-code = p-host-code
      462                 and ub.clients.obj-type = 'орг':U) then do:
      463       run err-mess in this-procedure ( input substitute("Уже есть КОНТРАГЕНТ-организация с кодом &1", p-host-code) ).
      464       undo, return error "host-code":U.
      465     end.
      466   end.
      467   else do:
      468     if not can-find (ub.clients where
      469                     ub.clients.obj-code = p-host-code
      470                 and ub.clients.obj-type = 'орг':U no-lock)
      471     or
      472     p-host-code = 0 then do:
      473       if p-host-code = 0 then do:
      474         run err-mess in this-procedure ( input "Код СВОЕЙ ФИРМЫ не может быть равен 0" ).
      475       end.
      476       else do:
      477         run err-mess in this-procedure ( input substitute("Не найден КОНТРАГЕНТ для СВОЕЙ ФИРМЫ с кодом &1", p-host-code) ).
      478       end.
      479       undo, return error "host-code":U.
      480     end.
      481     if not can-find (ub.firm where
      482                     ub.firm.firm-code = p-host-code no-lock) then do:
      483       run err-mess in this-procedure ( input substitute("Не найдена ФИРМА для СВОЕЙ ФИРМЫ с кодом &1", p-host-code) ).
      484       undo, return error "host-code":U.
      485     end.
      486   end.
      487   if not p-is-deploy then do:
      488     if p-credit-pay <> 0 then do:
      489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      490     (input  'iscredit'
      491     ,input  0
      492     ,input  ''
      493     ,input  0
      494     ,input  ''
      495     ,input  ''
      496     ,input  ''
      497     ,input  no
      498     ,output conf-par
      499     ,output par-type
      500     ) no-error .
      501       if not error-status:error then
      502       assign
      503       v-is-credit = (conf-par = "yes")
      504       .
      505       if v-is-credit then do:
      506       find first buf_cash-pay no-lock where
      507                 buf_cash-pay.cdpay-code = p-credit-pay no-error.
      508       if not available buf_cash-pay then do:
      509         run err-mess in this-procedure  ( input substitute("Не определен тип платежа в кредит на кассе - код &1", p-credit-pay ) ).
      510         undo, return error "credit-pay":U.
      511       end.
      512       if buf_cash-pay.is-credit = no then do:
      513         run err-mess in this-procedure ( input substitute("Тип платежа в кредит на кассе - код &1 НЕ задан как платеж <В кредит>", p-credit-pay ) ).
      514         undo, return error "credit-pay":U.
      515       end.
      516       if not can-find (ub.pay-type where
      517                       ub.pay-type.obj-code = p-ret-credit-pay no-lock) then do:
      518         run err-mess in this-procedure ( input substitute("Не найден тип оплаты долгов кредита с кодом &1", p-ret-credit-pay ) ).
      519         undo, return error "ret-credit-pay":U.
      520       end.
      521     end.
      522     end.
      523   end.
      524   if not can-find (ub.clients where
      525                   ub.clients.obj-code = p-sale-code
      526               and ub.clients.obj-type = p-sale-type no-lock) then do:
      527     run err-mess in this-procedure ( input substitute("Не найден контрагент РЕАЛИЗАЦИЯ: тип &1 код&2", p-sale-type, p-sale-code) ).
      528     undo, return error "sale-code":U.
      529   end.
      530   if p-sale-type <> 'орг':U then do:
      531     run err-mess in this-procedure ( input substitute("Неверный тип контрагента РЕАЛИЗАЦИЯ: тип &1 код&2", p-sale-type, p-sale-code) ).
      532     undo, return error "sale-type":U.
      533   end.
      534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      535     (input  'holding'
      536     ,input  0
      537     ,input  ''
      538     ,input  0
      539     ,input  ''
      540     ,input  ''
      541     ,input  ''
      542     ,input  no
      543     ,output conf-par
      544     ,output par-type
      545     ) no-error .
      546   if not error-status:error then
      547   assign
      548   v-is-hold = (conf-par = "yes")
      549   .
      550   if v-is-hold and p-mode = 'ИЗМЕНЕНИЕ':U then do:
      551     run check-main-obj in this-procedure no-error .
      552     if error-status:error then do:
      553       undo, return error return-value.
      554     end.
      555   end.
      556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      557     (input  'is-fin'
      558     ,input  0
      559     ,input  ''
      560     ,input  0
      561     ,input  ''
      562     ,input  ''
      563     ,input  ''
      564     ,input  no
      565     ,output conf-par
      566     ,output par-type
      567     ) no-error .
      568   assign
      569   v-is-fin = (conf-par = "yes")
      570   .
      571   if p-avrg-price = yes then do:
      572     find first posr_sysconf no-lock where
      573               posr_sysconf.avrg-price = yes
      574            and (p-mode = 'ДОБАВЛЕНИЕ':U
      575             or posr_sysconf.host-code <> p-host-code) no-error .
      576     if available posr_sysconf then do:
      577        if p-silent then do:
      578           run err-mess in this-procedure  ( input substitute("ПОСРЕДНИКОМ ДЛЯ ОТЧЕТОВ уже является другая фирма &1", posr_sysconf.host-code ) ).
      579           undo, return error "":U.
      580        end.
      581        else do:
      582          message
      583          substitute("ПОСРЕДНИКОМ ДЛЯ ОТЧЕТОВ УЖЕ является другая фирма &1&2" +
      584                     "Вы уверены, что хотите сделать ПОСРЕДНИКОМ ДЛЯ ОТЧЕТОВ данную фирму &3?"
      585                     , posr_sysconf.host-code
      586                     , chr(10)
      587                     , p-host-code
      588                     )
      589          view-as alert-box question update glog.
      590          if not glog then do:
      591             undo, return error 'avrg-price'.
      592          end.
      593          else do:
      594            find current posr_sysconf exclusive-lock.
      595          end.
      596        end.
      597     end.
      598   end.
      599   _main:
      600   do for
      601   main_sysconf,
      602   main_clients,
      603   main_firm
      604   on error undo, return error return-value
      605   on stop undo, return error return-value
      606   :
      607     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      608       run gbl/conf-rd.p ( input "host-num"
      609                          ,input ""
      610                          ,input ""
      611                          ,input 0
      612                          ,input ""
      613                          ,input ""
      614                          ,input ""
      615                          ,input yes
      616                          ,output conf-par
      617                          ,output par-type) no-error.
      618       if error-status:error then undo, return error.
      619       if par-type <> "i" then do:
      620         run err-mess in this-procedure ( input substitute("Неправильный тип параметра host-num &1 (должно быть integer)", par-type)).
      621         undo, return error "":U.
      622       end.
      623       if integer (conf-par) <> 0 then do:
      624         for each buf_sysconf no-lock:
      625           accumulate buf_sysconf.host-code (count).
      626         end.
      627         if (accum count buf_sysconf.host-code) >= integer (conf-par) then do:
      628           run err-mess in this-procedure ( input substitute("Создание новой фирмы запрещено. Превышено допустимое число фирм", conf-par)).
      629           undo, return error "":U.
      630         end.
      631       end.
      632       if p-is-deploy then do:
      633         FIND FIRST main_clients where
      634                   main_clients.obj-type = 'орг':U
      635               AND main_clients.obj-code = p-host-code No-ERROR.
      636         if not available main_clients then do:
      637           create main_clients.
      638         end.
      639         find first main_firm where
      640                   main_firm.firm-code = p-host-code no-error .
      641         if not available main_firm then do:
      642           run err-mess in this-procedure ( input substitute("Не найдена запись ФИРМА для записи СВОЯ ФИРМА с кодом &1", p-host-code)).
      643           undo, return error "":U.
      644         end.
      645       end.
      646       create main_sysconf.
      647       if not p-is-deploy then do:
      648         create main_clients.
      649         create main_firm.
      650       end.
      651       assign
      652       main_sysconf.firm-db-num = 0
      653       main_sysconf.ord-prt = yes
      654       main_sysconf.host-code = p-host-code
      655       main_sysconf.base-code = p-base-code
      656       p-rec = recid(main_sysconf)
      657       .
      658       assign
      659         main_clients.obj-code = p-host-code
      660         main_clients.obj-type = 'орг':U
      661         main_clients.obj-name = p-obj-name
      662         main_clients.stts     = 0
      663         main_clients.db-num   = ?
      664         main_clients.grp-code = p-grp-code
      665         main_firm.firm-code   = p-host-code
      666       .
      667     end.
      668     else do:
      669       find first main_sysconf where
      670                  recid(main_sysconf) = p-rec no-error .
      671       if not available main_sysconf then do:
      672         run err-mess in this-procedure ( input substitute("Не найдена запись СВОЯ ФИРМА - p-rec &1", p-rec)).
      673         undo, return error "":U.
      674       end.
      675       FIND FIRST main_clients where
      676                 main_clients.obj-type = 'орг':U
      677             AND main_clients.obj-code = p-host-code No-ERROR.
      678       if not available main_clients then do:
      679         run err-mess in this-procedure ( input substitute("Не найдена запись КЛИЕНТ для записи СВОЯ ФИРМА с кодом &1", p-host-code)).
      680         undo, return error "":U.
      681       end.
      682       find first main_firm where
      683                 main_firm.firm-code = p-host-code no-error .
      684       if not available main_firm then do:
      685         run err-mess in this-procedure ( input substitute("Не найдена запись ФИРМА для записи СВОЯ ФИРМА с кодом &1", p-host-code)).
      686         undo, return error '':u.
      687       end.
      688       if main_sysconf.host-code <> p-host-code
      689       or main_sysconf.base-code <> p-base-code
      690       then do:
      691         run err-mess in this-procedure ( input substitute("Для уже имеющейся СВОЕЙ ФИРМЫ &1 нельзя изменить код и валюту", p-host-code)).
      692         undo, return error '':u.
      693       end.
      694     end.
      695     if available posr_sysconf
      696     and p-avrg-price then do:
      697       posr_sysconf.avrg-price = no.
      698     end.
      699     assign
      700     main_clients.obj-name         =  p-obj-name
      701     main_sysconf.artic-disable    =  p-artic-disable
      702     main_sysconf.avrg-price       =  p-avrg-price
      703     main_sysconf.gen-s-f-office   =  p-gen-s-f-office
      704     main_sysconf.base-code        =  p-base-code
      705     main_sysconf.branch           =  p-branch
      706     main_sysconf.cash-pay         =  p-cash-pay
      707     main_sysconf.cashier          =  p-cashier
      708     main_sysconf.cons-vat-pc      =  p-cons-vat-pc
      709     main_sysconf.credit-pay       =  p-credit-pay
      710     main_sysconf.head-position    =  p-head-position
      711     main_sysconf.KOPF             =  p-KOPF
      712     main_sysconf.negative-rest    =  p-negative-rest
      713     main_sysconf.osn-base         =  p-osn-base
      714     main_sysconf.property         =  p-property
      715     main_sysconf.purch-code       =  p-purch-code
      716     main_sysconf.ret-credit-pay   =  p-ret-credit-pay
      717     main_sysconf.sale-type        =  p-sale-type
      718     main_sysconf.sale-code        =  p-sale-code
      719     main_sysconf.snr-accnt        =  p-snr-accnt
      720     main_sysconf.SOEI             =  p-SOEI
      721     main_sysconf.transport-cli-type =  p-transport-cli-type
      722     main_sysconf.transport-cli-code =  p-transport-cli-code
      723     main_sysconf.transport-host   =  p-transport-host
      724     main_sysconf.transport-contract =  p-transport-contract
      725     main_sysconf.transport-uslov  =  p-transport-uslov
      726     main_sysconf.transport-value  =  p-transport-value
      727     main_firm.main-obj-type       =  p-main-obj-type
      728     main_firm.main-obj-code       =  p-main-obj-code
      729     p-rec = recid(main_sysconf)
      730     .
      731     release main_sysconf no-error.
      732     if error-status:error then do:
      733        run err-mess in this-procedure ( input substitute("Ошибка при сохранении записи СВОЯ ФИРМА &1: &2", p-host-code, ERROR-STATUS:GET-message(1))).
      734       undo, return error "":U.
      735     end.
      736     release main_clients no-error.
      737     if error-status:error then do:
      738       run err-mess in this-procedure ( input substitute("Ошибка при сохранении записи КЛИЕНТ для СВОЕЙ ФИРМЫ &1: &2", p-host-code, ERROR-STATUS:GET-message(1))).
      739       undo, return error "":U.
      740     end.
      741     release main_firm no-error.
      742     if error-status:error then do:
      743         run err-mess in this-procedure ( input substitute("Ошибка при сохранении записи ФИРМА для СВОЕЙ ФИРМЫ &1: &2", p-host-code, ERROR-STATUS:GET-message(1))).
      744         undo, return error "":U.
      745       end.
      746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      747     (input  'tpsi'
      748     ,input  0
      749     ,input  ''
      750     ,input  0
      751     ,input  ''
      752     ,input  ''
      753     ,input  ''
      754     ,input  no
      755     ,output vartpsi
      756     ,output vartpsi-type
      757     ) no-error .
      758       if ( not error-status :error ) and
      759         vartpsi = "yes"             and
      760         p-als-gds = yes             then do:
      761         run clntattr-write in this-procedure (
      762                                               input 'орг':U
      763                                               ,input p-host-code
      764                                               ,input 'als-gds':U
      765                                               ,input "yes":u).
      766     end.
      767     else do:
      768       run clntattr-delete in this-procedure (
      769                                             input  'орг':U
      770                                             ,input  p-host-code
      771                                             ,input  'als-gds':U
      772                                             ,output vardeleted
      773        ).
      774     end.
      775     if p-egrip-date = ?
      776     then do:
      777       run clntattr-delete in this-procedure (
      778                                               input  'орг':U
      779                                               ,input  p-host-code
      780                                               ,input  'egrip-date':U
      781                                               ,output vardeleted
      782        ).
      783     end.
      784     else do:
      785       run clntattr-write in this-procedure (
      786                                             input 'орг':U
      787                                             ,input p-host-code
      788                                             ,input 'egrip-date':U
      789                                             ,input string( p-egrip-date ) ).
      790     end.
      791     if p-egrip-num = "":U
      792     or p-egrip-num = ?
      793     then do:
      794       run clntattr-delete in this-procedure (
      795                                               input  'орг':U
      796                                               ,input  p-host-code
      797                                               ,input  'egrip-num':U
      798                                               ,output vardeleted
      799        ).
      800     end.
      801     else do:
      802       run clntattr-write in this-procedure (
      803                                               input 'орг':U
      804                                               ,input p-host-code
      805                                               ,input 'egrip-num':U
      806                                               ,input p-egrip-num ).
      807     end.
      808     find first main_sysconf where
      809               recid(main_sysconf) = p-rec .
      810   end.
      811   PROCEDURE check-main-obj :
      812   define buffer buf_shop  for ub.shop.
      813   define buffer buf_store for ub.store.
      814   if p-main-obj-code = 0
      815   and p-main-obj-type = "":U then return.
      816   find first buf_clients no-lock where
      817              buf_clients.obj-type = p-main-obj-type
      818          and buf_clients.obj-code = p-main-obj-code no-error .
      819   if not available buf_clients then do:
      820     run err-mess in this-procedure ( input substitute("Не найден контрагент ГЛАВНЫЙ ОБЪЕКТ ФИРМЫ для межфирменного перемещения: тип &1 код&2", p-main-obj-type, p-main-obj-code) ).
      821     undo, return error "main-obj-code":U.
      822   end.
      823   if buf_clients.obj-type <> 'маг':U
      824   AND buf_clients.obj-type <> 'скл':U then do:
      825     run err-mess in this-procedure ( input substitute("ГЛАВНЫЙ ОБЪЕКТ ФИРМЫ для межфирменного перемещения: тип &1 код &2, а может быть только типа &3 или &4", p-main-obj-type, p-main-obj-code, 'маг':U, 'скл':U) ).
      826     undo, return error "main-obj-type":U.
      827   end.
      828   if p-main-obj-type = 'маг':U then do:
      829     find first buf_shop where
      830               buf_shop.obj-code = p-main-obj-code no-lock.
      831     if buf_shop.host-code <> p-host-code then do:
      832       run err-mess in this-procedure ( input substitute("Магазин &1, выбранный как ГЛАВНЫЙ ОБЪЕКТ межфирменного перемещения, не принадлежит фирме &2", p-main-obj-code, p-host-code ) ).
      833       return error.
      834     end.
      835   end.
      836   if buf_clients.obj-type = 'скл':U then do:
      837     find first buf_store where
      838               buf_store.obj-code = p-main-obj-code no-lock.
      839     if buf_store.host-code <> p-host-code then do:
      840       run err-mess in this-procedure ( input substitute("Склад &1, выбранный как ГЛАВНЫЙ ОБЪЕКТ межфирменного перемещения, не принадлежит фирме &2", p-main-obj-code, p-host-code ) ).
      841       return error "main-obj-code":U.
      842     end.
      843   end.
      844   END PROCEDURE.
      845   PROCEDURE err-mess:
      846     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      847     message
      848     p-mess
      849     view-as alert-box error .
      850   END PROCEDURE.
