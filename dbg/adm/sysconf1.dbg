       67   define new global shared variable g#vssrevis-logger as handle    no-undo .
       68   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       69   define variable v-vssrevis-logger                   as handle    no-undo .
       70   procedure vss-logevent :
       71     define input  parameter p-extra-paramters as character no-undo .
       72     define variable v-vssrevis-parameters as character no-undo .
       73     do
       74     on error undo, return error return-value
       75     :
       76       if  valid-handle(v-vssrevis-logger)
       77       and v-vssrevis-logger :get-signature("logevent") <> ""
       78       then do:
       79         run vss-get-parameters in this-procedure
       80           (output v-vssrevis-parameters
       81           ).
       82         run logevent in v-vssrevis-logger
       83           (input vss-workfile
       84           ,input vss-revision
       85           ,input v-vssrevis-parameters
       86           ,input p-extra-paramters
       87           ).
       88       end.
       89     end.
       90   end procedure.
       91   assign
       92     v-vssrevis-logger = g#vssrevis-logger
       93   .
       94   if  valid-handle(v-vssrevis-logger)
       95   and v-vssrevis-logger :get-signature("logevent") <> ""
       96   then do:
       97     assign
       98       v-vssrevis-logevent = true
       99     .
      100     run vss-logevent in this-procedure (input vss-description) .
