      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable v-ref-list    as character                     no-undo.
      128   define temp-table tt-goods no-undo like ub.gds-grp.
      129   define buffer buf_tt-goods for tt-goods .
      130   DEFINE BUTTON b-add
      131        LABEL "Добавить"
      132        SIZE 10 BY 1.
      133   DEFINE BUTTON b-del
      134        LABEL "Удалить"
      135        SIZE 10 BY 1.
      136   DEFINE BUTTON b-exit AUTO-GO
      137        LABEL "&Ввод"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON b-help
      141        LABEL "Помо&щь"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON b-quit AUTO-GO
      145        LABEL "&Отмена"
      146        SIZE 10 BY 1.
      147   DEFINE QUERY BROWSE-2 FOR
      148         buf_tt-goods SCROLLING.
      149   DEFINE BROWSE BROWSE-2
      150     QUERY BROWSE-2 DISPLAY
      151         buf_tt-goods.node-name
      152       WITH NO-ROW-MARKERS SEPARATORS SIZE 64 BY 19.76 ROW-HEIGHT-CHARS .75 FIT-LAST-COLUMN.
      153   DEFINE FRAME Dialog-Frame
      154        b-exit AT ROW 1 COL 1
      155        b-quit AT ROW 1 COL 11 WIDGET-ID 6
      156        b-add AT ROW 1 COL 21 WIDGET-ID 2
      157        b-del AT ROW 1 COL 31 WIDGET-ID 4
      158        b-help AT ROW 1 COL 55
      159        BROWSE-2 AT ROW 2.24 COL 1 WIDGET-ID 200
      160        SPACE(0.13) SKIP(0.99)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "<insert dialog title>"
      164            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      173   DO:
      174      run ref/gds-grp.w ( INPUT parparentproc
      175                        , INPUT "b-sel,b-mark"
      176                        , INPUT v-cntxt-obj-type
      177                        , INPUT v-cntxt-obj-code
      178                        , INPUT-OUTPUT v-ref-list).
      179      if v-ref-list <> "" then do:
      180         RUN create-actn-gds IN THIS-PROCEDURE ( INPUT v-ref-list ) no-error.
      181         if error-status:error then do:
      182            message
      183               vss-workfile vss-revision vss-description skip
      184               "Ошибка при вызове процедуры создания товара" skip
      185               error-status :get-message(1) skip
      186               return-value skip
      187               view-as alert-box error .
      188            return no-apply.
      189         end.
      190         OPEN QUERY BROWSE-2 FOR EACH buf_tt-goods.
      191      end.
      192   END.
      193   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      194   DO:
      195     IF AVAILABLE buf_tt-goods THEN DO:
      196        delete buf_tt-goods.
      197     END.
      198     OPEN QUERY BROWSE-2 FOR EACH buf_tt-goods.
      199   END.
      200   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      201   DO:
      202     for each tt-goods
      203         :
      204         assign
      205            p-gds-list = IF p-gds-list = "":U THEN STRING(tt-goods.node-code)
      206                                              ELSE p-gds-list + chr(4) + STRING(tt-goods.node-code)
      207         .
      208     end.
      209     ASSIGN
      210         p-ok = TRUE
      211     .
      212   END.
      213   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      214   OR HELP OF FRAME Dialog-Frame
      215   DO:
      216     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\adm\actngrpg.w" VIEW-AS ALERT-BOX INFORMATION.
      217   END.
      218   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      219   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      220   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   on help of frame Dialog-Frame
      222   do:
      223     run gbl/app_help.p
      224       (input this-procedure :file-name
      225       ,input ''
      226       ,input ?
      227       ) no-error.
      228     if error-status :error then do:
      229       message
      230         "Ошибка при вызове помощи"
      231         error-status :get-message(1)
      232         view-as alert-box .
      233     end.
      234   end.
      235   run minbtn-set in this-procedure .
      236   on choose of b-help in frame Dialog-Frame
      237   do:
      238     apply "help":u to frame Dialog-Frame .
      239   end.
      240   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   procedure minbtn-set :
      242       do
      243           on error undo, return error return-value
      244           :
      245           define variable ii              as integer       no-undo .
      246           define variable fh              as widget-handle no-undo .
      247           define variable hh              as widget-handle no-undo .
      248           define variable v-h             as handle        extent 4 no-undo .
      249           define variable v-name-button   as character     no-undo .
      250           define variable v-help-old-x    as decimal       no-undo .
      251           define variable v-help-old-y    as decimal       no-undo .
      252           define variable v-help-old-size as decimal       no-undo .
      253           define variable v-frame-width   as decimal       no-undo .
      254           define variable jj              as integer       no-undo .
      255           do
      256               on error undo, return error
      257               :
      258               assign
      259                   v-frame-width = frame Dialog-Frame:width - 0.3
      260                   fh            = frame Dialog-Frame:first-child
      261                   hh            = fh:first-child
      262                   ii            = 1
      263                   .
      264               do while valid-handle(hh):
      265                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      266                   do:
      267                       case lc(hh:name) :
      268                           when "b-help" then
      269                               do:
      270                                   hh:load-image-up("cmp/b-help.bmp":u) .
      271                                   hh:load-image-down("cmp/b-help.bmp":u) .
      272                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      273                                   hh:TOOLTIP = "Помощь" .
      274                                   v-help-old-x = hh:column .
      275                                   v-help-old-y = hh:row    .
      276                                   v-help-old-size = hh:width .
      277                                   hh:width-chars = 2.5 .
      278                               end.
      279                           when "b-print" then
      280                               do:
      281                                   hh:load-image("cmp/b-print.bmp":u) .
      282                                   hh:TOOLTIP = "Печать" .
      283                                   v-h[ii] = hh:handle .
      284                                   ii = ii + 1 .
      285                                   hh:width-chars = 3 .
      286                               end.
      287                           when "b-history" or
      288                           when "b-hist" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История" .
      292                                   v-h[ii] = hh:handle .
      293                                   ii = ii + 1 .
      294                                   hh:width-chars = 3 .
      295                               end.
      296                           when "b-sch" then
      297                               do:
      298                                   hh:load-image("cmp/b-sch.bmp":u) .
      299                                   hh:TOOLTIP = "Установка Фильтра" .
      300                                   v-h[ii] = hh:handle .
      301                                   ii = ii + 1 .
      302                                   hh:width-chars = 3 .
      303                               end.
      304                           when "b-hist-user" then
      305                               do:
      306                                   hh:load-image("cmp/b-hist.bmp":u) .
      307                                   hh:TOOLTIP = "История пользователя" .
      308                                   ii = ii + 1 .
      309                               end.
      310                       end case.
      311                   end.
      312                   hh = hh:next-sibling.
      313               end.
      314               b-help:column = v-frame-width - b-help:width-chars.
      315               jj = 0.
      316               repeat ii = 4 to 1 by -1 :
      317                   if valid-handle (v-h[ii] ) then
      318                   do:
      319                       jj  = jj + 1 .
      320                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      321                       v-h[ii]:row    = v-help-old-y .
      322                   end.
      323               end.
      324           end.
      325       end.
      326   end procedure.
      327   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      328   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      329   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      330   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      331   define variable v-diasize-current-frame-width  as decimal   no-undo .
      332   define variable v-diasize-current-frame-height as decimal   no-undo .
      333   define variable v-diasize-change-size          as logical   no-undo .
      334   define variable v-diasize-resize-button        as handle    no-undo .
      335   define variable v-diasize-wndmax               as logical   no-undo .
      336   define variable v-diasize-wndstore             as logical   no-undo .
      337   define variable v-diasize-proc-name            as character no-undo .
      338   define variable v-diasize-browse-handle        as handle    no-undo .
      339   define variable v-diasize-browse-number        as integer   no-undo .
      340   define variable v-diasize-need-full-display    as logical   no-undo init false .
      341   define temp-table temp-diasize-handle no-undo
      342     field handle-value  as handle
      343     field save-position as decimal
      344     index xpk is primary unique handle-value
      345     .
      346   define temp-table temp-browse-handle no-undo
      347     field browse-type   as character
      348     field browse-number as integer
      349     field browse-handle as handle
      350     field original-size as decimal
      351     index xpk is primary unique browse-type browse-number
      352     index xie browse-type browse-handle
      353   .
      354   procedure diasize_change-height :
      355     define input  parameter p-change-value  as decimal   no-undo .
      356     define input  parameter p-move-resize   as logical   no-undo .
      357     define variable v-field-group-handle    as handle    no-undo .
      358     define variable v-object-handle         as handle    no-undo .
      359     define variable v-frame-height          as decimal   no-undo .
      360     define variable v-frame-virtual-height  as decimal   no-undo .
      361     define variable v-browse-height         as decimal   no-undo .
      362     define variable v-window-height         as decimal   no-undo .
      363     define variable v-window-virtual-height as decimal   no-undo .
      364     define variable v-change-sign           as integer   no-undo .
      365     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      366     define buffer buf_temp-browse-handle  for temp-browse-handle .
      367     if p-change-value > 0
      368     then do:
      369       if frame Dialog-Frame :height + p-change-value
      370           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      371       then do:
      372         assign
      373           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      374                           - (frame Dialog-Frame :height-chars)
      375         .
      376         if p-change-value <= 0
      377         then do:
      378           run diasize_position-resize-button in this-procedure .
      379           return .
      380         end.
      381       end.
      382     end.
      383     if p-change-value < 0
      384     then do:
      385       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      386       then do:
      387         assign
      388           p-change-value = v-diasize-orig-frame-height
      389                          - (frame Dialog-Frame :height-chars)
      390         .
      391         if p-change-value >= 0
      392         then do:
      393           run diasize_position-resize-button in this-procedure .
      394           return .
      395         end.
      396       end.
      397     end.
      398     if p-change-value >= 0
      399     then do:
      400       assign
      401         v-change-sign = 1
      402       .
      403     end.
      404     else do:
      405       assign
      406         v-change-sign = -1
      407       .
      408     end.
      409     assign
      410       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      411     .
      412     if p-change-value = 0
      413     then do:
      414       run diasize_position-resize-button in this-procedure .
      415       return .
      416     end.
      417     move_block:
      418     do
      419     on error undo move_block, retry move_block
      420     :
      421       if retry
      422       then do:
      423         do
      424         on error undo move_block, leave move_block
      425         :
      426           if p-change-value > 0
      427           then do:
      428             for each buf_temp-diasize-handle
      429             on error undo, next
      430             :
      431               assign
      432                 v-object-handle = buf_temp-diasize-handle.handle-value
      433               .
      434               if v-object-handle <> v-diasize-resize-button
      435               then do:
      436                 assign
      437                   v-object-handle :row = buf_temp-diasize-handle.save-position
      438                 .
      439               end.
      440             end.
      441             assign
      442               v-diasize-browse-handle :height = v-browse-height
      443             .
      444             for each buf_temp-browse-handle
      445               where buf_temp-browse-handle.browse-type = 'height':u
      446             on error undo, next
      447             :
      448               assign
      449                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      450               .
      451             end.
      452             assign
      453               frame Dialog-Frame :height = v-frame-height
      454             .
      455             if frame Dialog-Frame :scrollable = true
      456             then do:
      457               assign
      458                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      459               .
      460             end.
      461             run diasize_position-resize-button in this-procedure .
      462           end.
      463           else do:
      464             if frame Dialog-Frame :scrollable = true
      465             then do:
      466               assign
      467                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      468               .
      469             end.
      470             assign
      471               frame Dialog-Frame :height = v-frame-height
      472             .
      473             assign
      474               v-diasize-browse-handle :height = v-browse-height
      475             .
      476             for each buf_temp-browse-handle
      477               where buf_temp-browse-handle.browse-type = 'height':u
      478             on error undo, next
      479             :
      480               assign
      481                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      482               .
      483             end.
      484             for each buf_temp-diasize-handle
      485             on error undo, next
      486             :
      487               assign
      488                 v-object-handle = buf_temp-diasize-handle.handle-value
      489               .
      490               if v-object-handle <> v-diasize-resize-button
      491               then do:
      492                 assign
      493                   v-object-handle :row = buf_temp-diasize-handle.save-position
      494                 .
      495               end.
      496             end.
      497             run diasize_position-resize-button in this-procedure .
      498           end.
      499           assign
      500             v-diasize-change-size = false
      501           .
      502           leave move_block .
      503         end.
      504       end.
      505       assign
      506         v-diasize-need-full-display = true
      507       .
      508       if v-diasize-change-size = false
      509       then do:
      510         assign
      511           v-diasize-change-size = true
      512         .
      513       end.
      514       else do:
      515         return .
      516       end.
      517       assign
      518         v-frame-height = frame Dialog-Frame :height
      519         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      520         v-browse-height = v-diasize-browse-handle :height
      521       .
      522       for each buf_temp-browse-handle
      523         where buf_temp-browse-handle.browse-type = 'height':u
      524       :
      525         assign
      526           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      527         .
      528       end.
      529       for each buf_temp-diasize-handle
      530       :
      531         delete buf_temp-diasize-handle .
      532       end.
      533       assign
      534         v-field-group-handle = frame Dialog-Frame :first-child
      535       .
      536       do while valid-handle(v-field-group-handle)
      537       :
      538         assign
      539           v-object-handle = v-field-group-handle :first-child
      540         .
      541         do while valid-handle(v-object-handle)
      542         :
      543           if  v-object-handle <> v-diasize-browse-handle :handle
      544           and can-query(v-object-handle, "row")
      545           and can-query(v-object-handle, "height")
      546           and ( v-object-handle :row > v-diasize-browse-handle :row )
      547           then do:
      548             find first buf_temp-browse-handle
      549               where buf_temp-browse-handle.browse-type   = 'height':u
      550                 and buf_temp-browse-handle.browse-handle = v-object-handle
      551               no-error .
      552             if available buf_temp-browse-handle
      553             then do:
      554             end.
      555             else do:
      556               create buf_temp-diasize-handle .
      557               assign
      558                 buf_temp-diasize-handle.handle-value  = v-object-handle
      559                 buf_temp-diasize-handle.save-position = v-object-handle :row
      560               .
      561             end.
      562           end.
      563           assign
      564             v-object-handle = v-object-handle :next-sibling
      565           .
      566         end.
      567         assign
      568           v-field-group-handle = v-field-group-handle :next-sibling
      569         .
      570       end.
      571       do with frame Dialog-Frame
      572       :
      573         hide v-diasize-resize-button .
      574         assign
      575           v-diasize-resize-button :row    = 1
      576           v-diasize-resize-button :column = 1
      577         .
      578       end.
      579       if p-change-value > 0
      580       then do:
      581         if frame Dialog-Frame :scrollable = true
      582         then do:
      583           assign
      584             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      585             no-error .
      586           if error-status :error
      587           or error-status :get-message(1) <> ""
      588           then do:
      589             undo move_block, retry move_block .
      590           end.
      591         end.
      592         assign
      593           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      594           no-error .
      595         if error-status :error
      596         or error-status :get-message(1) <> ""
      597         then do:
      598           undo move_block, retry move_block .
      599         end.
      600         assign
      601           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      602           no-error .
      603         if error-status :error
      604         or error-status :get-message(1) <> ""
      605         then do:
      606           undo move_block, retry move_block .
      607         end.
      608         for each buf_temp-browse-handle
      609           where buf_temp-browse-handle.browse-type = 'height':u
      610         on error undo move_block, retry move_block
      611         :
      612           assign
      613             buf_temp-browse-handle.browse-handle :height
      614               = buf_temp-browse-handle.browse-handle :height + p-change-value
      615             no-error .
      616           if error-status :error
      617           or error-status :get-message(1) <> ""
      618           then do:
      619             undo move_block, retry move_block .
      620           end.
      621         end.
      622         for each buf_temp-diasize-handle
      623         on error undo move_block, retry move_block
      624         :
      625           assign
      626             v-object-handle = buf_temp-diasize-handle.handle-value
      627           .
      628           if v-object-handle <> v-diasize-resize-button
      629           then do:
      630             assign
      631               v-object-handle :row = v-object-handle :row + p-change-value
      632               no-error .
      633             if error-status :error
      634             or error-status :get-message(1) <> ""
      635             then do:
      636               undo move_block, retry move_block .
      637             end.
      638           end.
      639         end.
      640       end.
      641       else do:
      642         for each buf_temp-diasize-handle
      643         on error undo move_block, retry move_block
      644         :
      645           assign
      646             v-object-handle = buf_temp-diasize-handle.handle-value
      647           .
      648           if v-object-handle <> v-diasize-resize-button
      649           then do:
      650             assign
      651               v-object-handle :row = v-object-handle :row + p-change-value
      652               no-error .
      653             if error-status :error
      654             or error-status :get-message(1) <> ""
      655             then do:
      656               undo move_block, retry move_block .
      657             end.
      658           end.
      659         end.
      660         assign
      661           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      662           no-error .
      663         if error-status :error
      664         or error-status :get-message(1) <> ""
      665         then do:
      666           undo move_block, retry move_block .
      667         end.
      668         for each buf_temp-browse-handle
      669           where buf_temp-browse-handle.browse-type = 'height':u
      670         on error undo move_block, retry move_block
      671         :
      672           assign
      673             buf_temp-browse-handle.browse-handle :height
      674               = buf_temp-browse-handle.browse-handle :height + p-change-value
      675             no-error .
      676           if error-status :error
      677           or error-status :get-message(1) <> ""
      678           then do:
      679             undo move_block, retry move_block .
      680           end.
      681         end.
      682         assign
      683           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      684           no-error .
      685         if error-status :error
      686         or error-status :get-message(1) <> ""
      687         then do:
      688           undo move_block, retry move_block .
      689         end.
      690         if frame Dialog-Frame :scrollable = true
      691         then do:
      692           assign
      693             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      694             no-error .
      695           if error-status :error
      696           or error-status :get-message(1) <> ""
      697           then do:
      698             undo move_block, retry move_block .
      699           end.
      700         end.
      701       end.
      702       if p-move-resize = true
      703       then do:
      704         run diasize_position-resize-button in this-procedure .
      705       end.
      706       if v-diasize-wndstore = true
      707       then do:
      708         if connected("ub") = true
      709         then do:
      710           define variable v-cntxt-db-num        as integer   no-undo .
      711           define variable v-cntxt-userid        as character no-undo .
      712           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      713                                             , OUTPUT v-cntxt-userid
      714                                             ) .
      715           run gbl/wndsizew.p
      716             (input  v-cntxt-db-num
      717             ,input  v-cntxt-userid
      718             ,input  v-diasize-proc-name
      719             ,input  'height':u
      720             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      721             ) .
      722         end.
      723       end.
      724     end.
      725     assign
      726       v-diasize-change-size = false
      727     .
      728   end procedure.
      729   procedure diasize_set-height :
      730     define input  parameter p-new-height  as decimal   no-undo .
      731     define input  parameter p-move-resize as logical   no-undo .
      732     do
      733     on error undo, return error return-value
      734     :
      735       run diasize_change-height in this-procedure
      736         (input  (p-new-height - frame Dialog-Frame :height)
      737         ,input  p-move-resize
      738         ) .
      739     end.
      740   end procedure.
      741   procedure diasize_change-width :
      742     define input  parameter p-change-value as decimal   no-undo .
      743     define input  parameter p-move-resize  as logical   no-undo .
      744     define variable v-field-group-handle   as handle    no-undo .
      745     define variable v-object-handle        as handle    no-undo .
      746     define variable v-frame-width          as decimal   no-undo .
      747     define variable v-frame-virtual-width  as decimal   no-undo .
      748     define variable v-browse-width         as decimal   no-undo .
      749     define variable v-window-width         as decimal   no-undo .
      750     define variable v-window-virtual-width as decimal   no-undo .
      751     define variable v-change-sign          as integer   no-undo .
      752     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      753     define buffer buf_temp-browse-handle  for temp-browse-handle .
      754     if p-change-value > 0
      755     then do:
      756       if frame Dialog-Frame :width + p-change-value >
      757           session :width-chars
      758       then do:
      759         assign
      760           p-change-value = session :width-chars - frame Dialog-Frame :width
      761         .
      762         if p-change-value <= 0
      763         then do:
      764           run diasize_position-resize-button in this-procedure .
      765           return .
      766         end.
      767       end.
      768     end.
      769     if p-change-value < 0
      770     then do:
      771       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      772       then do:
      773         assign
      774           p-change-value = v-diasize-orig-frame-width
      775                          - frame Dialog-Frame :width
      776         .
      777         if p-change-value >= 0
      778         then do:
      779           run diasize_position-resize-button in this-procedure .
      780           return .
      781         end.
      782       end.
      783     end.
      784     if p-change-value >= 0
      785     then do:
      786       assign
      787         v-change-sign = 1
      788       .
      789     end.
      790     else do:
      791       assign
      792         v-change-sign = -1
      793       .
      794     end.
      795     assign
      796       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      797     .
      798     if p-change-value = 0
      799     then do:
      800       run diasize_position-resize-button in this-procedure .
      801       return .
      802     end.
      803     move_block:
      804     do
      805     on error undo move_block, leave move_block
      806     :
      807       if retry
      808       then do:
      809         do
      810         on error undo move_block, leave move_block
      811         :
      812           if p-change-value > 0
      813           then do:
      814             for each buf_temp-diasize-handle
      815             on error undo, next
      816             :
      817               assign
      818                 v-object-handle = buf_temp-diasize-handle.handle-value
      819               .
      820               if v-object-handle <> v-diasize-resize-button
      821               then do:
      822                 assign
      823                   v-object-handle :col = buf_temp-diasize-handle.save-position
      824                 .
      825               end.
      826             end.
      827             assign
      828               v-diasize-browse-handle :width = v-browse-width
      829             .
      830             for each buf_temp-browse-handle
      831               where buf_temp-browse-handle.browse-type = 'width':u
      832             on error undo, next
      833             :
      834               assign
      835                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      836               .
      837             end.
      838             assign
      839               frame Dialog-Frame :width = v-frame-width
      840             .
      841             if frame Dialog-Frame :scrollable = true
      842             then do:
      843               assign
      844                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      845               .
      846             end.
      847             run diasize_position-resize-button in this-procedure .
      848           end.
      849           else do:
      850             if frame Dialog-Frame :scrollable = true
      851             then do:
      852               assign
      853                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      854               .
      855             end.
      856             assign
      857               frame Dialog-Frame :width = v-frame-width
      858             .
      859             for each buf_temp-browse-handle
      860               where buf_temp-browse-handle.browse-type = 'width':u
      861             on error undo, next
      862             :
      863               assign
      864                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      865               .
      866             end.
      867             assign
      868               v-diasize-browse-handle :width = v-browse-width
      869             .
      870             for each buf_temp-diasize-handle
      871             on error undo, next
      872             :
      873               assign
      874                 v-object-handle = buf_temp-diasize-handle.handle-value
      875               .
      876               if v-object-handle <> v-diasize-resize-button
      877               then do:
      878                 assign
      879                   v-object-handle :col = buf_temp-diasize-handle.save-position
      880                 .
      881               end.
      882             end.
      883             run diasize_position-resize-button in this-procedure .
      884           end.
      885           assign
      886             v-diasize-change-size = false
      887           .
      888           leave move_block .
      889         end.
      890       end.
      891       assign
      892         v-diasize-need-full-display = true
      893       .
      894       if v-diasize-change-size = false
      895       then do:
      896         assign
      897           v-diasize-change-size = true
      898         .
      899       end.
      900       else do:
      901         return .
      902       end.
      903       assign
      904         v-frame-width = frame Dialog-Frame :width
      905         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      906         v-browse-width = v-diasize-browse-handle :width
      907       .
      908       for each buf_temp-browse-handle
      909         where buf_temp-browse-handle.browse-type = 'width':u
      910       :
      911         assign
      912           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      913         .
      914       end.
      915       for each buf_temp-diasize-handle
      916       :
      917         delete buf_temp-diasize-handle .
      918       end.
      919       assign
      920         v-field-group-handle = frame Dialog-Frame :first-child
      921       .
      922       do while valid-handle(v-field-group-handle)
      923       :
      924         assign
      925           v-object-handle = v-field-group-handle :first-child
      926         .
      927         do while valid-handle(v-object-handle)
      928         :
      929           if  v-object-handle <> v-diasize-browse-handle :handle
      930           and v-object-handle <> v-diasize-resize-button
      931           and can-query(v-object-handle, "row")
      932           and can-query(v-object-handle, "height")
      933           and ( v-object-handle :col + v-object-handle :width
      934                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      935               )
      936           then do:
      937             find first buf_temp-browse-handle
      938               where buf_temp-browse-handle.browse-type   = 'width':u
      939                 and buf_temp-browse-handle.browse-handle = v-object-handle
      940               no-error .
      941             if available buf_temp-browse-handle
      942             then do:
      943             end.
      944             else do:
      945               create buf_temp-diasize-handle .
      946               assign
      947                 buf_temp-diasize-handle.handle-value  = v-object-handle
      948                 buf_temp-diasize-handle.save-position = v-object-handle :col
      949               .
      950             end.
      951           end.
      952           assign
      953             v-object-handle = v-object-handle :next-sibling
      954           .
      955         end.
      956         assign
      957           v-field-group-handle = v-field-group-handle :next-sibling
      958         .
      959       end.
      960       do with frame Dialog-Frame
      961       :
      962         hide v-diasize-resize-button .
      963         v-diasize-resize-button :row = 1.
      964         v-diasize-resize-button :column = 1.
      965       end.
      966       if p-change-value > 0
      967       then do:
      968         if frame Dialog-Frame :scrollable = true
      969         then do:
      970           assign
      971             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      972             no-error .
      973           if error-status :error
      974           or error-status :get-message(1) <> ""
      975           then do:
      976             undo move_block, retry move_block.
      977           end.
      978         end.
      979         assign
      980           frame Dialog-Frame :width = v-frame-width + p-change-value
      981           no-error .
      982         if error-status :error
      983         or error-status :get-message(1) <> ""
      984         then do:
      985           undo move_block, retry move_block.
      986         end.
      987         assign
      988           v-diasize-browse-handle :width = v-browse-width + p-change-value
      989         no-error .
      990         if error-status :error
      991         or error-status :get-message(1) <> ""
      992         then do:
      993           undo move_block, retry move_block.
      994         end.
      995         for each buf_temp-browse-handle
      996           where buf_temp-browse-handle.browse-type = 'width':u
      997         on error undo move_block, retry move_block
      998         :
      999           assign
     1000             buf_temp-browse-handle.browse-handle :width
     1001               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1002             no-error .
     1003           if error-status :error
     1004           or error-status :get-message(1) <> ""
     1005           then do:
     1006             undo move_block, retry move_block .
     1007           end.
     1008         end.
     1009         for each buf_temp-diasize-handle
     1010         on error undo move_block, retry move_block
     1011         :
     1012           assign
     1013             v-object-handle = buf_temp-diasize-handle.handle-value
     1014           .
     1015           if v-object-handle <> v-diasize-resize-button
     1016           then do:
     1017             assign
     1018               v-object-handle :col = v-object-handle :col + p-change-value
     1019               no-error .
     1020             if error-status :error
     1021             or error-status :get-message(1) <> ""
     1022             then do:
     1023               undo move_block, retry move_block .
     1024             end.
     1025           end.
     1026         end.
     1027       end.
     1028       else do:
     1029         for each buf_temp-diasize-handle
     1030         on error undo move_block, retry move_block
     1031         :
     1032           assign
     1033             v-object-handle = buf_temp-diasize-handle.handle-value
     1034           .
     1035           if v-object-handle <> v-diasize-resize-button
     1036           then do:
     1037             assign
     1038               v-object-handle :col = v-object-handle :col + p-change-value
     1039               no-error .
     1040             if error-status :error
     1041             or error-status :get-message(1) <> ""
     1042             then do:
     1043               undo move_block, retry move_block .
     1044             end.
     1045           end.
     1046         end.
     1047         for each buf_temp-browse-handle
     1048           where buf_temp-browse-handle.browse-type = 'width':u
     1049         on error undo move_block, retry move_block
     1050         :
     1051           assign
     1052             buf_temp-browse-handle.browse-handle :width
     1053               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1054             no-error .
     1055           if error-status :error
     1056           or error-status :get-message(1) <> ""
     1057           then do:
     1058             undo move_block, retry move_block .
     1059           end.
     1060         end.
     1061         assign
     1062           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1063           no-error .
     1064         if error-status :error
     1065         or error-status :get-message(1) <> ""
     1066         then do:
     1067           undo move_block, retry move_block.
     1068         end.
     1069         assign
     1070           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1071         no-error .
     1072         if error-status :error
     1073         or error-status :get-message(1) <> ""
     1074         then do:
     1075           undo move_block, retry move_block.
     1076         end.
     1077         if frame Dialog-Frame :scrollable = true
     1078         then do:
     1079           assign
     1080             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1081           no-error .
     1082           if error-status :error
     1083           or error-status :get-message(1) <> ""
     1084           then do:
     1085             undo move_block, retry move_block.
     1086           end.
     1087         end.
     1088       end.
     1089       if p-move-resize
     1090       then do:
     1091         run diasize_position-resize-button in this-procedure .
     1092       end.
     1093       if v-diasize-wndstore = true
     1094       then do:
     1095         if connected("ub") = true
     1096         then do:
     1097           define variable v-cntxt-db-num        as integer   no-undo .
     1098           define variable v-cntxt-userid        as character no-undo .
     1099           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1100                                             , OUTPUT v-cntxt-userid
     1101                                             ) .
     1102           run gbl/wndsizew.p
     1103             (input  v-cntxt-db-num
     1104             ,input  v-cntxt-userid
     1105             ,input  v-diasize-proc-name
     1106             ,input  'width':u
     1107             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1108             ) .
     1109         end.
     1110       end.
     1111     end.
     1112     assign
     1113       v-diasize-change-size = false
     1114     .
     1115   end procedure.
     1116   procedure diasize_set-width :
     1117     define input  parameter p-new-width  as decimal   no-undo .
     1118     define input  parameter p-move-resize as logical   no-undo .
     1119     do
     1120     on error undo, return error return-value
     1121     :
     1122       run diasize_change-width in this-procedure
     1123         (input  (p-new-width - frame Dialog-Frame :width)
     1124         ,input  p-move-resize
     1125         ) .
     1126     end.
     1127   end procedure.
     1128   procedure diasize_position-resize-button :
     1129     do with frame Dialog-Frame
     1130     :
     1131       hide v-diasize-resize-button .
     1132       assign
     1133         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1134                     - 1
     1135                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1136         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1137                     - 1
     1138                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1139       .
     1140       view v-diasize-resize-button .
     1141     end.
     1142   end procedure.
     1143   on alt-right anywhere
     1144   do:
     1145     run diasize_change-width in this-procedure
     1146       (input 1
     1147       ,input true
     1148       ) .
     1149     return no-apply .
     1150   end.
     1151   on alt-left anywhere
     1152   do:
     1153     run diasize_change-width in this-procedure
     1154       (input -1
     1155       ,input true
     1156       ) .
     1157     return no-apply .
     1158   end.
     1159   on alt-down anywhere
     1160   do:
     1161     run diasize_change-height in this-procedure
     1162       (input 1
     1163       ,input true
     1164       ) .
     1165     return no-apply .
     1166   end.
     1167   on alt-up anywhere
     1168   do:
     1169     run diasize_change-height in this-procedure
     1170       (input -1
     1171       ,input true
     1172       ) .
     1173     return no-apply .
     1174   end.
     1175   on alt-enter of frame Dialog-Frame
     1176   do:
     1177     run diasize_maximize in this-procedure
     1178       (input  ?
     1179       ).
     1180     return no-apply .
     1181   end.
     1182   procedure diasize_end-move :
     1183     do
     1184     on error undo, return error return-value
     1185     :
     1186       define variable v-row-delta as decimal   no-undo .
     1187       define variable v-col-delta as decimal   no-undo .
     1188       define variable v-new-row as decimal   no-undo .
     1189       define variable v-new-col as decimal   no-undo .
     1190       assign
     1191         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1192         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1193       .
     1194       assign
     1195         v-row-delta = v-new-row - frame Dialog-Frame :height
     1196         v-col-delta = v-new-col - frame Dialog-Frame :width
     1197       .
     1198       run diasize_change-height in this-procedure
     1199         (input v-row-delta
     1200         ,input true
     1201         ) .
     1202       run diasize_change-width in this-procedure
     1203         (input v-col-delta
     1204         ,input true
     1205         ) .
     1206     end.
     1207   end procedure.
     1208   procedure diasize_maximize :
     1209     define input  parameter p-action as logical   no-undo .
     1210     do
     1211     on error undo, return error return-value
     1212     :
     1213       if p-action = ?
     1214       then do:
     1215         if v-diasize-need-maximize = true
     1216         then do:
     1217           assign
     1218             p-action = true
     1219           .
     1220         end.
     1221         else do:
     1222           assign
     1223             p-action = false
     1224           .
     1225         end.
     1226       end.
     1227       if p-action = true
     1228       then do:
     1229         run diasize_change-height in this-procedure
     1230           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1231               - frame Dialog-Frame :height-chars
     1232           ,input true
     1233           ) .
     1234         run diasize_change-width in this-procedure
     1235           (input session :width-chars
     1236               - frame Dialog-Frame :width-chars
     1237           ,input true
     1238           ) .
     1239         assign
     1240           v-diasize-need-maximize = false
     1241         .
     1242       end.
     1243       else do:
     1244         run diasize_change-width in this-procedure
     1245           (input v-diasize-orig-frame-width
     1246               - frame Dialog-Frame :width-chars
     1247           ,input true
     1248           ) .
     1249         run diasize_change-height in this-procedure
     1250           (input v-diasize-orig-frame-height
     1251               - frame Dialog-Frame :height-chars
     1252           ,input true
     1253           ) .
     1254         assign
     1255           v-diasize-need-maximize = true
     1256         .
     1257       end.
     1258     end.
     1259   end procedure.
     1260   procedure diasize_restore-orig-size :
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       assign
     1265         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1266         v-diasize-current-frame-height = frame Dialog-Frame :height
     1267       .
     1268       run diasize_set-height in this-procedure
     1269         (input  v-diasize-orig-frame-height
     1270         ,input  true
     1271         ) .
     1272       run diasize_set-width in this-procedure
     1273         (input  v-diasize-orig-frame-width
     1274         ,input  true
     1275         ) .
     1276     end.
     1277   end procedure.
     1278   procedure diasize_restore-current-size :
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       run diasize_set-height in this-procedure
     1283         (input  v-diasize-current-frame-height
     1284         ,input  true
     1285         ) .
     1286       run diasize_set-width in this-procedure
     1287         (input  v-diasize-current-frame-width
     1288         ,input  true
     1289         ) .
     1290     end.
     1291   end procedure.
     1292   procedure diasize_set-browse-handle :
     1293     define input  parameter p-browse-handle as handle   no-undo .
     1294     define buffer buf_temp-browse-handle for temp-browse-handle .
     1295     do
     1296     on error undo, return error return-value
     1297     :
     1298       assign
     1299         v-diasize-browse-handle = p-browse-handle
     1300       .
     1301       for each buf_temp-browse-handle
     1302       on error undo, return error return-value
     1303       :
     1304         delete buf_temp-browse-handle .
     1305       end.
     1306     end.
     1307   end procedure.
     1308   procedure diasize_add_browse :
     1309     define input  parameter p-browse-type   as character no-undo .
     1310     define input  parameter p-browse-handle as handle    no-undo .
     1311     define buffer buf_temp-browse-handle for temp-browse-handle .
     1312     do
     1313     on error undo, return error return-value
     1314     :
     1315       assign
     1316         v-diasize-browse-number = v-diasize-browse-number + 1
     1317       .
     1318       create buf_temp-browse-handle .
     1319       assign
     1320         buf_temp-browse-handle.browse-type   = p-browse-type
     1321         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1322         buf_temp-browse-handle.browse-handle = p-browse-handle
     1323       .
     1324     end.
     1325   end procedure.
     1326   procedure diasize_init :
     1327     define variable v-default-value    as logical   no-undo .
     1328     define variable v-restore-saved    as logical   no-undo .
     1329     define variable v-resize-value-str as character no-undo .
     1330     do
     1331     on error undo, return error return-value
     1332     :
     1333       do with frame Dialog-Frame
     1334       :
     1335         assign
     1336           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1337           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1338           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1339         .
     1340         create button v-diasize-resize-button
     1341         assign
     1342           parent        = frame Dialog-Frame :first-child
     1343           label         = "s"
     1344           height-pixels = 16
     1345           width-pixels  = 16
     1346           visible       = true
     1347           sensitive     = true
     1348           movable       = true
     1349           triggers:
     1350             on end-move persistent run diasize_end-move in this-procedure .
     1351           end triggers.
     1352         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1353         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1354         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1355         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1356         assign
     1357           v-diasize-wndmax = false
     1358         .
     1359         if connected("ub") = true
     1360         then do:
     1361           define variable v-cntxt-db-num        as integer   no-undo .
     1362           define variable v-cntxt-userid        as character no-undo .
     1363           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1364                                             , OUTPUT v-cntxt-userid
     1365                                             ) .
     1366           run gbl/wndpar_r.p
     1367             (input  v-cntxt-db-num
     1368             ,input  v-cntxt-userid
     1369             ,input  'wndmax':U
     1370             ,output v-diasize-wndmax
     1371             ,output v-default-value
     1372             ) .
     1373         end.
     1374         assign
     1375           v-diasize-wndstore = false
     1376         .
     1377         if connected("ub") = true
     1378         then do:
     1379           run gbl/wndpar_r.p
     1380             (input  v-cntxt-db-num
     1381             ,input  v-cntxt-userid
     1382             ,input  'wndstore':U
     1383             ,output v-diasize-wndstore
     1384             ,output v-default-value
     1385             ) .
     1386         end.
     1387         assign
     1388           v-diasize-proc-name = entry(1, program-name(2), '.')
     1389         .
     1390         if v-diasize-wndstore = true
     1391         then do:
     1392           assign
     1393             v-restore-saved = false
     1394           .
     1395           if connected("ub") = true
     1396           then do:
     1397             run gbl/wndsizer.p
     1398               (input  v-cntxt-db-num
     1399               ,input  v-cntxt-userid
     1400               ,input  v-diasize-proc-name
     1401               ,input  'height':u
     1402               ,output v-resize-value-str
     1403               ) .
     1404             if v-resize-value-str <> '':U
     1405             then do:
     1406               run diasize_change-height in this-procedure
     1407                 (input  integer(v-resize-value-str)
     1408                 ,input  true
     1409                 ) .
     1410               assign
     1411                 v-restore-saved = true
     1412               .
     1413             end.
     1414           end.
     1415           if connected("ub") = true
     1416           then do:
     1417             run gbl/wndsizer.p
     1418               (input  v-cntxt-db-num
     1419               ,input  v-cntxt-userid
     1420               ,input  v-diasize-proc-name
     1421               ,input  'width':u
     1422               ,output v-resize-value-str
     1423               ) .
     1424             if v-resize-value-str <> '':U
     1425             then do:
     1426               run diasize_change-width in this-procedure
     1427                 (input  integer(v-resize-value-str)
     1428                 ,input  true
     1429                 ) .
     1430               assign
     1431                 v-restore-saved = true
     1432               .
     1433             end.
     1434           end.
     1435           if v-restore-saved <> true
     1436           then do:
     1437             if v-diasize-wndmax = true
     1438             then do:
     1439               run diasize_maximize in this-procedure
     1440                 (input  true
     1441                 ) .
     1442             end.
     1443           end.
     1444         end.
     1445         else do:
     1446           if v-diasize-wndmax = true
     1447           then do:
     1448             run diasize_maximize in this-procedure
     1449               (input  true
     1450               ) .
     1451           end.
     1452         end.
     1453       end.
     1454     end.
     1455   end procedure.
     1456   procedure diasize_need-full-display :
     1457     define output parameter p-need-full-display as logical   no-undo .
     1458     do
     1459     on error undo, return error return-value
     1460     :
     1461       assign
     1462         p-need-full-display = v-diasize-need-full-display
     1463       .
     1464       assign
     1465         v-diasize-need-full-display = false
     1466       .
     1467     end.
     1468   end procedure.
     1469   procedure get-context :
     1470      define output parameter p-db-num as integer          no-undo.
     1471      define output parameter p-user-id as character        no-undo.
     1472      define variable v-login               as character    no-undo.
     1473      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1474      define buffer buf_user-login  for ub.user-login .
     1475      do
     1476      on error undo, return error
     1477      :
     1478            FIND FIRST buf_sys-ctrl no-lock.
     1479            ASSIGN
     1480               v-login = USERID("ub")
     1481               p-db-num = buf_sys-ctrl.db-num
     1482            .
     1483            FIND FIRST buf_user-login
     1484                 WHERE buf_user-login.db-num = p-db-num
     1485                   AND buf_user-login.user-login = v-login
     1486                 no-lock
     1487                 no-error
     1488                 .
     1489            IF AVAILABLE buf_user-login
     1490            THEN DO:
     1491               assign
     1492                  p-user-id = buf_user-login.user-id
     1493               .
     1494            END.
     1495      end.
     1496   end procedure.
     1497       run diasize_init in this-procedure .
     1498   MAIN-BLOCK:
     1499   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1500      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1501   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502     run mainmenu_getcntxt in parparentproc
     1503       (output v-cntxt-db-num
     1504       ,output v-cntxt-userid
     1505       ,output v-cntxt-level
     1506       ,output v-cntxt-host-code-obj
     1507       ,output v-cntxt-obj-type
     1508       ,output v-cntxt-obj-code
     1509       ,output v-cntxt-db-num-obj
     1510       ,output v-cntxt-is-admin
     1511       ) .
     1512     run fill-tt-goods in this-procedure.
     1513     RUN enable_UI.
     1514     WAIT-FOR GO OF FRAME Dialog-Frame.
     1515   END.
     1516   RUN disable_UI.
     1517   PROCEDURE create-actn-gds :
     1518   define input parameter p-ref-list as character        no-undo.
     1519   define variable v-count as integer no-undo .
     1520   define buffer buf_gds-grp                 for ub.gds-grp .
     1521   define buffer bf_tt-goods                 for tt-goods .
     1522   define buffer buf_action-role-item-gds-grp    for ub.action-role-item-gds-grp .
     1523   do
     1524   on error undo, return error
     1525   :
     1526      _add-goods:
     1527      DO v-count = 1 TO NUM-ENTRIES(p-ref-list)
     1528      on error undo, next
     1529      :
     1530         find first buf_gds-grp
     1531              where recid( buf_gds-grp ) = INTEGER(ENTRY(v-count, p-ref-list))
     1532              NO-LOCK
     1533              no-error
     1534              .
     1535         IF NOT AVAILABLE buf_gds-grp
     1536         THEN NEXT _add-goods.
     1537         find first bf_tt-goods
     1538              where bf_tt-goods.node-code = buf_gds-grp.node-code
     1539              no-lock
     1540              no-error
     1541              .
     1542         IF NOT AVAILABLE bf_tt-goods THEN DO:
     1543            create bf_tt-goods.
     1544            buffer-copy buf_gds-grp to bf_tt-goods .
     1545         END.
     1546      end.
     1547   end.
     1548   END PROCEDURE.
     1549   PROCEDURE delete-actn-gds :
     1550   define input parameter p-gds-code as integer        no-undo.
     1551   define buffer buf_action-role-item-gds    for ub.action-role-item-gds .
     1552   do
     1553   on error undo, return error
     1554   :
     1555   end.
     1556   END PROCEDURE.
     1557   PROCEDURE disable_UI :
     1558     HIDE FRAME Dialog-Frame.
     1559   END PROCEDURE.
     1560   PROCEDURE enable_UI :
     1561     ENABLE b-exit b-quit b-add b-del b-help BROWSE-2
     1562         WITH FRAME Dialog-Frame.
     1563     VIEW FRAME Dialog-Frame.
     1564     OPEN QUERY BROWSE-2 FOR EACH buf_tt-goods.
     1565   END PROCEDURE.
     1566   PROCEDURE fill-tt-goods :
     1567   define buffer buf_gds-grp                   for ub.gds-grp .
     1568   define buffer buf_action-role-item-gds-grp    for ub.action-role-item-gds-grp .
     1569   define variable v-count    as integer      no-undo.
     1570   do
     1571   on error undo, return error
     1572   :
     1573      IF p-gds-list = "":U
     1574      THEN DO:
     1575         FOR EACH  buf_action-role-item-gds-grp
     1576             where buf_action-role-item-gds-grp.db-num           = v-cntxt-db-num
     1577               AND buf_action-role-item-gds-grp.action-head-code = p-head-code
     1578               AND buf_action-role-item-gds-grp.action-role-code = p-role-code
     1579               AND buf_action-role-item-gds-grp.action-item-code = p-item-code
     1580          no-lock
     1581          :
     1582            FIND first buf_gds-grp
     1583               where buf_gds-grp.node-code = buf_action-role-item-gds-grp.gds-grp-code
     1584               no-lock
     1585               no-error
     1586               .
     1587            create tt-goods.
     1588            buffer-copy buf_gds-grp to tt-goods .
     1589         END.
     1590      END.
     1591      ELSE DO:
     1592         DO v-count = 1 TO NUM-ENTRIES(p-Gds-List, chr(4))
     1593         on error undo, next
     1594         :
     1595            FIND first buf_gds-grp
     1596                 where buf_gds-grp.node-code = INTEGER(ENTRY(v-count, p-Gds-List, chr(4)))
     1597                 no-lock
     1598                 no-error
     1599                .
     1600            IF AVAILABLE buf_gds-grp THEN DO:
     1601               create tt-goods.
     1602               buffer-copy buf_gds-grp to tt-goods .
     1603            END.
     1604         END.
     1605      END.
     1606   end.
     1607   END PROCEDURE.
