        1   block-level on error undo, throw.
        2   using ibs.th.adm.upd.*.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define input parameter p-connpar as character no-undo.
        8   define output parameter p-isUpdShm as logical init false no-undo.
        9   define variable updschmObj as class updschm no-undo.
       10   define variable str as character no-undo.
       11   define stream slogwrite.
       12   output stream slogwrite to "update.log".
       13   subscribe "WriteLogAsunc" anywhere.
       14   subscribe "PutStatAsunc" anywhere run-procedure "WriteLogAsunc".
       15   updschmObj = new updschm (input p-connpar,"",this-procedure).
       16   if updschmObj:IsErr
       17   then do:
       18     str = updschmObj:Msg.
       19     delete object updschmObj no-error.
       20     return error str.
       21   end.
       22   if updschmObj:isNeedUpd
       23   then do:
       24     updschmObj:upddbshm().
       25     if updschmObj:IsErr
       26     then do:
       27       str = updschmObj:Msg.
       28       delete object updschmObj no-error.
       29       return error str.
       30     end.
       31   end.
       32   p-isUpdShm = updschmObj:isUpdShm.
       33   delete object updschmObj.
       34   unsubscribe "WriteLogAsunc".
       35   unsubscribe "PutStatAsunc".
       36   output stream slogwrite close.
       37   procedure WriteLogAsunc:
       38      define input  parameter itext as character no-undo.
       39      define input  parameter iMes  as logical   no-undo.
       40      put stream slogwrite unformatted itext skip.
       41   end.
