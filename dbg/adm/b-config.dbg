     1927     end.
     1928   end procedure.
     1929   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1930   on INS of frame fr-config anywhere do:
     1931     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame fr-config. END.
