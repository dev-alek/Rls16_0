     4407   FUNCTION attach-ext RETURNS CHARACTER
     4408     () :
     4409     define variable ret-value as character initial "":U no-undo .
     4410     if cnf-struct.attach-type <> 'Нет':U then do:
     4411       assign
     4412         ret-value = substr (cnf-struct.attach-type, 1, 3) + " "
     4413       .
     4414       case cnf-struct.attach-type:
     4415         when 'Фирма':U
     4416         or when 'Объект':U
     4417         then do:
     4418           if cnf.host-code <> 0 then do:
     4419             assign
     4420               ret-value = ret-value + 'Фирма':U + " " + string(cnf.host-code)
     4421             .
     4422           end.
     4423           if cnf.obj-code  <> 0 then do:
     4424             assign
     4425               ret-value = ret-value + ", " + cnf.obj-type + " " + string(cnf.obj-code)
     4426             .
     4427           end.
     4428         end.
     4429       end case.
     4430     end.
     4431     return ret-value.
     4432   END FUNCTION.
     4433   FUNCTION attach-short RETURNS CHARACTER
     4434     ():
     4435     define variable ret-value as character initial "":U no-undo .
     4436     if cnf.host-code <> 0 then do:
     4437       if cnf.obj-code =  0 then do:
     4438         assign
     4439           ret-value = substr('Фирма':U, 1, 1)
     4440         .
     4441       end.
     4442       else do:
     4443         assign
     4444           ret-value = substr('Объект':U, 1, 1)
     4445         .
     4446       end.
     4447     end.
     4448     return ret-value.
     4449   END FUNCTION.
     4450   FUNCTION can-process RETURNS LOGICAL
     4451     ( input mes as character, input param-type as character):
     4452     if not available cnf then do:
     4453       message
     4454         substitute("Не выбран параметр!") skip
     4455         view-as alert-box error .
     4456       return false.
     4457     end.
     4458     if not available cnf-struct then do:
     4459       message
     4460         substitute("Нет описания параметра!") skip
     4461         view-as alert-box error .
     4462       return false.
     4463     end.
     4464       if lookup (cnf.conf-type, param-type) > 0 then do:
     4465         message
     4466           substitute( "&1", mes ) skip
     4467           view-as alert-box error .
     4468         return false.
     4469       end.
     4470     return true.
     4471   END FUNCTION.
