     1716     .
     1717   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1718   DEF VAR cur-clmn-numbr-config as INT EXTENT 15 no-undo.
     1719   DEF VAR varmvibr-config       as INT no-undo.
     1720   DEF VAR varmvjbr-config       as INT no-undo.
     1721   DEF VAR varmvkbr-config       as INT no-undo.
     1722   DEF VAR varmvlbr-config       as INT no-undo.
     1723   DEF VAR move-elementbr-config as INT no-undo.
     1724   def var jjbr-config           as int no-undo.
     1725   do varmvibr-config = 1 to EXTENT(cur-clmn-numbr-config):
     1726     ASSIGN cur-clmn-numbr-config[varmvibr-config] = varmvibr-config.
     1727   END.
     1728   RUN start-mv-clmnbr-config.
     1729   PROCEDURE start-mv-clmnbr-config:
     1730   def var old-session as logical no-undo.
     1731      old-session = SESSION:IMMEDIATE-DISPLAY.
     1732      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1733      SESSION:IMMEDIATE-DISPLAY = old-session.
     1734   END.
     1735   ON ctrl-cursor-right OF BROWSE br-config do:
     1736     RUN re-move-clmnbr-config ( 8, 15).
     1737   END.
     1738   ON ctrl-cursor-left OF BROWSE br-config do:
     1739     RUN re-move-clmnbr-config (15, 8).
     1740   END.
     1741   PROCEDURE re-move-clmnbr-config:
     1742     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1743     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1744     DO varmvibr-config = 1 TO EXTENT(cur-clmn-numbr-config):
     1745       if cur-clmn-numbr-config[varmvibr-config] = source-column THEN cur-clmn-numbr-config[varmvibr-config] = -1.
     1746     END.
     1747     if br-config:MOVE-COLUMN(source-column, target-column) IN FRAME fr-config then.
     1748     if source-column > target-column THEN
     1749     DO varmvjbr-config = source-column - 1 to target-column BY -1:
     1750       DO varmvibr-config = 1 TO EXTENT(cur-clmn-numbr-config):
     1751           if cur-clmn-numbr-config[varmvibr-config] = varmvjbr-config THEN DO:
     1752             cur-clmn-numbr-config[varmvibr-config] = cur-clmn-numbr-config[varmvibr-config] + 1.
     1753           END.
     1754       END.
     1755     END.
     1756     ELSE
     1757     DO varmvjbr-config = source-column + 1 to target-column:
     1758       DO varmvibr-config = 1 TO EXTENT(cur-clmn-numbr-config):
     1759         if cur-clmn-numbr-config[varmvibr-config] = varmvjbr-config THEN DO:
     1760           cur-clmn-numbr-config[varmvibr-config] = cur-clmn-numbr-config[varmvibr-config] - 1.
     1761         END.
     1762       END.
     1763     END.
     1764     DO varmvibr-config = 1 TO EXTENT(cur-clmn-numbr-config):
     1765       if cur-clmn-numbr-config[varmvibr-config] = -1 THEN cur-clmn-numbr-config[varmvibr-config] = target-column.
     1766     END.
     1767   END PROCEDURE.
     1768   PROCEDURE ch-clmnbr-config:
     1769     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1770     if cur-clmn-loc <= 8 then do:
     1771       return .
     1772     end.
     1773     DO varmvibr-config = 1 TO EXTENT(cur-clmn-numbr-config):
     1774       if cur-clmn-numbr-config[varmvibr-config] = cur-clmn-loc THEN move-elementbr-config = varmvibr-config.
     1775     END.
     1776     RUN re-move-clmnbr-config (cur-clmn-loc, 8).
     1777   END PROCEDURE.
     1778   PROCEDURE mv-brw-defaultbr-config:
     1779   def var old-session as logical no-undo.
     1780     old-session = SESSION:IMMEDIATE-DISPLAY.
     1781     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1782     do varmvlbr-config = 8 to EXTENT(cur-clmn-numbr-config):
     1783       RUN re-move-clmnbr-config (cur-clmn-numbr-config[varmvlbr-config], varmvlbr-config).
     1784     END.
     1785     RUN start-mv-clmnbr-config.
     1786     SESSION:IMMEDIATE-DISPLAY = old-session.
     1787   END PROCEDURE.
     1788   .
     1789   def var sort-labelbr-config   as character no-undo .
     1790   def var sort-clmnbr-config    as handle    no-undo .
     1791   def var cur-clmnbr-config     as handle    no-undo .
     1792   def var cur-clmn-locbr-config as integer   no-undo .
     1793   def var re-querybr-config     as logical   initial no no-undo .
     1794   on start-search, ctrl-o of br-config in frame fr-config do:
     1795      run sort-brbr-config
     1796        (input (if available cnf
     1797                then recid(cnf)
     1798                else ?
     1799               )
     1800        ).
     1801   end.
     1802   PROCEDURE sort-brbr-config :
     1803     define input parameter p-recid as recid no-undo .
     1804     if re-querybr-config = no then do:
     1805       assign
     1806          cur-clmnbr-config = br-config:current-column in frame fr-config
     1807       .
     1808       if sort-clmnbr-config <> ? then sort-clmnbr-config:column-fgcolor = 0.
     1809       if cur-clmnbr-config = sort-clmnbr-config then do:
     1810         assign
     1811            sort-labelbr-config = ""
     1812            sort-clmnbr-config = ?
     1813         .
     1814        end.
     1815        else do:
     1816          assign
     1817            sort-labelbr-config = cur-clmnbr-config:label
     1818            sort-clmnbr-config  = cur-clmnbr-config
     1819            sort-clmnbr-config:column-fgcolor = 4
     1820          .
     1821        end.
     1822      end.
     1823     assign
     1824       cur-clmn-locbr-config = 1
     1825     .
     1826     def var column-handle as handle no-undo .
     1827     column-handle = br-config:first-column.
     1828     do while valid-handle(column-handle) :
     1829       if column-handle = cur-clmnbr-config then do:
     1830         leave .
     1831       end.
     1832       column-handle = column-handle:NEXT-COLUMN.
     1833       assign
     1834         cur-clmn-locbr-config = cur-clmn-locbr-config + 1
     1835       .
     1836     end.
     1837     case sort-labelbr-config:
     1838           when '*'  then DO:    assign       v-sort-column-name = "mark"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1839           when '+'  then DO:    assign       v-sort-column-name = "(if Cnf.NotUsed   THEN '-' ELSE '+')"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1840           when 'И'  then DO:    assign       v-sort-column-name = "(if Cnf.Is-Changed THEN 'X' ELSE ' ')"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1841           when 'Т'  then DO:    assign       v-sort-column-name = "Cnf.Conf-Type"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1842           when 'П'  then DO:    assign       v-sort-column-name = "attach-short()"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1843           when 'БД'  then DO:    assign       v-sort-column-name = "string(Cnf.db-num)"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1844           when 'Код'  then DO:    assign       v-sort-column-name = "Cnf.Param-Code"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1845           when 'Название'  then DO:    assign       v-sort-column-name = "Cnf.Param-Name"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1846           when 'Значение'  then DO:    assign       v-sort-column-name = "substring(Cnf.Param-Value,1,180)"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1847           when 'Привязка'  then DO:    assign       v-sort-column-name = "attach-ext()"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1848           when 'Примечание'  then DO:    assign       v-sort-column-name = "substring(Cnf.Param-PS,1,180)"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1849           when 'Возможные значения'  then DO:    assign       v-sort-column-name = "substring(cnf-struct.list-value,1,180)"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1850           when 'Значение по умолчанию'  then DO:    assign       v-sort-column-name = "cnf-struct.default-value"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1851           when ' Ош. '  then DO:    assign       v-sort-column-name = "String(Cnf.ErrorExist)"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1852           when ' Тип   параметра '  then DO:    assign       v-sort-column-name = "cnf-struct.data-type"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1853           when 'Действует с'  then DO:    assign       v-sort-column-name = "(if cnf.beg-date <> 01/01/1900 then string(cnf.beg-date,'99/99/9999') else 'неограничено' )"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1854           when 'Действует по'  then DO:    assign       v-sort-column-name = "(if cnf.end-date <> 01/01/9999 then string(cnf.end-date,'99/99/9999') else 'неограничено.' )"     .     run reopen-query in this-procedure ( input true, input false, input '':U ).   . END.
     1855       otherwise do:
     1856         assign
     1857           v-sort-column-name = ""
     1858         .
     1859         run reopen-query in this-procedure ( input true, input false, input '':U ).
     1860           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-config') then do:
     1861             run mv-brw-defaultbr-config.
     1862           end.
     1863         if sort-labelbr-config <> "" then do:
     1864           assign
     1865             cur-clmnbr-config:column-fgcolor = 0
     1866           .
     1867         end.
     1868         assign
     1869           cur-clmn-locbr-config = ?
     1870         .
     1871       end.
     1872     end case.
     1873       if cur-clmn-locbr-config <> ? then do:
     1874         if can-do( this-procedure:internal-entries, 'ch-clmnbr-config') then do:
     1875           run ch-clmnbr-config in this-procedure (cur-clmn-locbr-config).
     1876         end.
     1877       end.
     1878     if p-recid <> ? then do:
     1879       reposition br-config to recid p-recid no-error.
     1880       apply "value-changed" to br-config in frame fr-config.
     1881     end.
     1882     apply "entry" to br-config in frame fr-config.
     1883   END PROCEDURE.
     1884   procedure re-open-query-srt-clmnbr-config:
     1885   if cur-clmnbr-config = ? then do:
     1886      run reopen-query in this-procedure ( input true, input false, input '':U ).
     1887   end.
     1888   else do:
     1889      assign re-querybr-config = yes.
     1890      run sort-brbr-config
     1891        (input (if available cnf
     1892                then recid(cnf)
     1893                else ?
     1894               )
     1895        ).
     1896      assign re-querybr-config = no.
     1897   end.
     1898   end.
     1899   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1900   do:
     1901     br-config :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1902   end.
     1903   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1904   on f5 of frame fr-config anywhere
     1905   do:
     1906     v-cnf-rec = recid(cnf).                   run reopen-query in this-procedure ( input yes, input no, input '':U). reposition br-config to recid v-cnf-rec no-error.                   v-cnf-rec = ?.                   apply 'value-changed' TO br-config.
     1907       apply "VALUE-CHANGED" to br-config.
     1908   end.
     1909   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1910   procedure set-filter-name :
