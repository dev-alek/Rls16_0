     1682   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME fr-config:PARENT eq ?
     1683   THEN FRAME fr-config:PARENT = ACTIVE-WINDOW.
     1684   run adm/cnf-str.p persistent set cnf-hdl no-error.
     1685   if not valid-handle (cnf-hdl)  then do:
     1686      message
     1687        vss-workfile vss-revision vss-description skip
     1688        "Ошибка при попытке инициализировать работу со схемой конфигурации cnf-str.p" skip
