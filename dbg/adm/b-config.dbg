        1   define input parameter parparentproc as widget-handle no-undo .
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U.
        4   def var vss-date        as character no-undo init "$Date$":U.
        5   def var vss-workfile    as character no-undo init "$Workfile$":U.
        6   def var vss-archive     as character no-undo init "$Archive$":U.
        7   def var vss-description as character no-undo init "Настройки и конфигурация системы".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define variable v-waitfram-action01         as character   no-undo .
      113   define variable v-waitfram-action02         as character   no-undo .
      114   define variable v-waitfram-action03         as character   no-undo .
      115   define variable mWaitFramTextBeg            as character   no-undo.
      116   define variable mWaitFramTextEnd            as character   no-undo.
      117   define variable mWaitFramView               as logical     no-undo.
      118   define variable mWaitProcEvent              as logical     no-undo init yes.
      119   define variable mWaitFramInterval           as integer     no-undo init 1 .
      120   define variable mWaitFramStop               as logical     no-undo.
      121   define variable mWaitFramStopUser           as logical     no-undo.
      122   define variable mWaitFramStopTimeOut        as logical     no-undo.
      123   define variable mWaitFramStartProc          as datetime-tz no-undo.
      124   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      125   define button B-WaitFramStop auto-end-key
      126        label "Стоп"
      127        size 10 by 1 tooltip "Остоновить процесс".
      128   define button B-viewProcInfo
      129        label "Информация"
      130        size 15 by 1 tooltip "Информация о процесс".
      131   define frame waitfram
      132     v-waitfram-action01 format "x(72)" no-label skip
      133     v-waitfram-action02 format "x(72)" no-label skip
      134     v-waitfram-action03 format "x(72)" no-label skip
      135     B-viewProcInfo
      136     B-WaitFramStop at row 4 col 30
      137     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      138     .
      139   define new global shared variable mBatchMode as logical no-undo init ?.
      140   define variable mFramBachModHandle as handle no-undo.
      141   mFramBachModHandle = frame waitfram:handle.
      142   define variable mFameOldVis as logical no-undo.
      143   define variable mVisCUrentVin as logical no-undo.
      144   if session:batch-mode
      145   then
      146      mBatchMode = yes.
      147   if mBatchMode = ? then do:
      148     mVisCUrentVin = current-window:visible.
      149     mFameOldVis = mFramBachModHandle:visible.
      150     mFramBachModHandle:visible  = yes.
      151     mBatchMode = mFramBachModHandle:visible ne yes.
      152     mFramBachModHandle:visible = mFameOldVis.
      153     current-window:visible = mVisCUrentVin.
      154   end.
      155    if  log-manager:logfile-name ne ?
      156     then DO:
      157         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      158         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      159         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      160     end.
      161   on choose of B-WaitFramStop in frame waitfram
      162   do:
      163     mWaitFramStop = yes.
      164     mWaitFramStopUser = yes.
      165   end.
      166   function waitfram-check-timeout returns logical():
      167      define variable vtime as int64 no-undo.
      168      if mWaitFramStopTimeOut
      169      then
      170         return yes.
      171      vtime = ( now - mWaitFramStartProc ) / 1000 .
      172      if     mWaitFramTimeOut ne ?
      173         and mWaitFramTimeOut ne 0
      174         and mWaitFramTimeOut lt vtime
      175      then do:
      176         mWaitFramStopTimeOut = yes.
      177      end.
      178      return mWaitFramStopTimeOut.
      179   end.
      180   procedure waitfram-hide :
      181     if not session:batch-mode
      182     then do
      183     on error undo, return error return-value
      184     :
      185       pause 0 before-hide .
      186       if not mBatchMode then
      187         hide frame waitfram .
      188     if     not mWaitFramView
      189        and mWaitProcEvent
      190     then
      191       process events .
      192     end.
      193   end procedure.
      194   procedure waitfram-show :
      195     define input  parameter p-message as character no-undo .
      196     define variable v-left-margin as integer   no-undo .
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       if length(p-message) <= 70 then do:
      202         assign
      203           v-left-margin = integer((70 - length(p-message)) / 2)
      204         .
      205         assign
      206           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      207         .
      208         assign
      209           v-waitfram-action01 = " "
      210           v-waitfram-action02 = " "
      211                                    + fill(" ", v-left-margin)
      212                                    + p-message
      213           v-waitfram-action03 = " "
      214         .
      215       end.
      216       else do:
      217         define variable vRindex1 as integer no-undo.
      218         define variable vRindex2 as integer no-undo.
      219         vRindex1 = r-index(p-message," ",70).
      220         if vRindex1 = 0
      221         then
      222            vRindex1 = 70.
      223         if length(p-message)  <= vRindex1 + 70 then do:
      224           assign
      225             v-waitfram-action01 = " "
      226             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      227             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      228           .
      229         end.
      230         else do:
      231           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      232           if vRindex2 <= vRindex1
      233           then
      234              vRindex2 = vRindex1 + 70.
      235           assign
      236             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      237             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      238             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      239           .
      240         end.
      241       end.
      242       B-viewProcInfo:visible   in frame waitfram = no.
      243       B-viewProcInfo:sensitive in frame waitfram = no.
      244       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      245       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      246       if  (   mWaitFramView
      247          or  mWaitProcEvent)
      248          and not mBatchMode
      249       then
      250          display
      251             v-waitfram-action01 skip
      252             v-waitfram-action02 skip
      253             v-waitfram-action03 skip
      254          with frame waitfram .
      255       if     mWaitFramView
      256          then do:
      257             if     mWaitFramInterval ne ?
      258                and not mBatchMode
      259             then
      260                wait-for go of frame waitfram pause mWaitFramInterval.
      261          end.
      262          else
      263             if     mWaitProcEvent
      264                and not mBatchMode
      265             then
      266                process events .
      267     end.
      268   end procedure.
      269      procedure waitfram-show-this:
      270         define input  parameter iInterval as int64 no-undo.
      271         define variable vtime as int64 no-undo.
      272         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      273         mWaitFramInterval = iInterval.
      274         run waitfram-show (substitute("&1&2 &3&4" ,
      275                                       mWaitFramTextBeg ,
      276                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      277                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      278                                       mWaitFramTextEnd
      279                                      )
      280                           ).
      281      end.
      282      procedure WaitFramRunPause:
      283         define input  parameter iInterval as dec no-undo.
      284         define variable vStart  as datetime-tz no-undo.
      285         define variable vend    as datetime-tz no-undo.
      286         define variable vint as int64 no-undo.
      287         define variable vOk as logical no-undo.
      288         vStart = now.
      289         vend   = vStart.
      290         publish "WaitFramPause" (iInterval,output vOk).
      291         vend   =  now.
      292         vint = vend - vStart.
      293         vint = iInterval - vint / 1000.
      294         if     not mWaitFramStop
      295            and (   vint > 0
      296                 or (    not vOk
      297                     and iInterval eq ?
      298                     )
      299                 )
      300         then
      301            run waitfram-show-this (iInterval).
      302         vend   =  now.
      303         vint = vend - vStart.
      304         vint = iInterval - vint / 1000.
      305         if     not mWaitFramStop
      306            and vint > 0
      307         then do:
      308            run gbl/pause.p (vint * 1000).
      309         end.
      310         if iInterval ne ?
      311         then
      312            publish "WaitFramStop".
      313         waitfram-check-timeout().
      314      end.
      315      procedure WaitFramWaitFor:
      316         define input  parameter iInterval as dec no-undo.
      317         assign
      318            mWaitFramStartProc   = now
      319            mWaitFramStopUser    = no
      320            mWaitFramStopTimeOut = no
      321         .
      322         block-wait:
      323         do while not mWaitFramStop:
      324            run WaitFramRunPause (iInterval).
      325            if  waitfram-check-timeout()
      326            then do:
      327               leave block-wait.
      328            end.
      329         end.
      330         run waitfram-hide.
      331      end.
      332   procedure waitfram-join :
      333     define input  parameter p-line-1  as character no-undo .
      334     define input  parameter p-line-2  as character no-undo .
      335     define input  parameter p-line-3  as character no-undo .
      336     define output parameter p-message as character no-undo .
      337     do
      338     on error undo, return error return-value
      339     :
      340       assign
      341         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      342                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      343                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      344       .
      345     end.
      346   end procedure.
      347   function waitfram-join-function returns character
      348     (input p-line-1 as character
      349     ,input p-line-2 as character
      350     ,input p-line-3 as character
      351     ).
      352     define variable v-message as character no-undo .
      353     run waitfram-join in this-procedure
      354       (input  p-line-1
      355       ,input  p-line-2
      356       ,input  p-line-3
      357       ,output v-message
      358       ) .
      359     return v-message .
      360   end function .
      361   define new shared temp-table cnf no-undo
      362       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
      363       field db-key        as character   format "x(12)"       column-label "Ключ БД"
      364       field param-PS      as character   format "x(40)"       column-label "PS"
      365       field param-name    as character   format "x(30)"       column-label "Название"
      366       field is-changed    as logical initial false            column-label "Изменен"
      367       field NotUsed       as logical initial False            column-label "Выключен"
      368       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
      369       index pi
      370         is unique
      371         param-code
      372         host-code
      373         obj-type
      374         obj-code
      375         beg-date
      376         end-date
      377         db-num
      378       index db-num
      379         db-num
      380       index db-key
      381         db-key
      382       index par-name
      383         is word-index
      384         param-name
      385       index par-value
      386         is word-index
      387         param-value
      388    .
      389   def new shared temp-table log-table no-undo
      390       field stroka       as character format "x(256)".
      391   def new shared variable err-level as integer no-undo.
      392   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   define new shared temp-table cnf-struct no-undo
      394     field param-code    as character
      395     field param-type    as character
      396     field data-type     as character
      397     field param-name    as character
      398     field attach-type   as character
      399     field list-value    as character
      400     field default-value as character
      401     field PS            as character
      402     field param-group   as character
      403     field user-resp     as character
      404     index by-code is unique param-code
      405   .
      406   define temp-table t_cnf-struct no-undo like cnf-struct .
      407   define stream TxtStream.
      408   define stream temp-stream .
      409   function coding-user-resp returns character
      410     ( input p-param-code as character
      411      ,input p-user-resp  as character
      412     )
      413   :
      414     return encode( p-param-code + p-user-resp ) .
      415   end function.
      416   function decoding-user-resp returns character
      417     ( input p-param-code as character
      418      ,input p-code-usr   as character
      419     )
      420   :
      421     define variable v-ind         as integer   no-undo .
      422     define variable v-user-list   as character no-undo .
      423     define variable v-num-entries as integer   no-undo .
      424     define variable v-user-resp   as character no-undo .
      425     assign
      426       v-user-list   = "Бахтадзе,Булгаков,Белоусов,Гюнтнер,Исаков,Перваков,Суслов,Уханов,Чернова,Кочетков,Степанов,Хныкин,Гридчина,Шальнев,Сливенко,Харитонов,Кирюхин,Морозов"
      427       v-num-entries = num-entries( v-user-list )
      428       v-user-resp   = "":U
      429     .
      430     block_do:
      431     do v-ind = 1 to v-num-entries :
      432       if encode( p-param-code + entry( v-ind, v-user-list ) ) = p-code-usr then do:
      433         assign
      434           v-user-resp = entry( v-ind, v-user-list )
      435         .
      436         leave block_do.
      437       end.
      438     end.
      439     if v-user-resp = "":U then do:
      440       message
      441         vss-include-info1 skip
      442         substitute( "Невозможно распознать ответственного за параметр <&1>!",  p-param-code) skip
      443         substitute( "Возможно его нет в списке." ) skip
      444         view-as alert-box error
      445       .
      446       return "unknown":U.
      447     end.
      448     else do:
      449       return v-user-resp .
      450     end.
      451   end function.
      452   function sum-enc returns character (str as character, num-rev as integer).
      453      define variable rev_incl_s as character init "" no-undo .
      454      define variable rev_incl_i as integer no-undo .
      455      define variable rev_incl_l as integer no-undo .
      456      rev_incl_l = length(str).
      457      do rev_incl_i = 1 to rev_incl_l:
      458         if rev_incl_i <= num-rev
      459           or rev_incl_l - rev_incl_i < num-rev
      460         then do:
      461           assign
      462             rev_incl_s = rev_incl_s + substr(str, rev_incl_l - rev_incl_i + 1, 1)
      463           .
      464         end.
      465         else do:
      466           assign
      467             rev_incl_s = rev_incl_s + substr(str, rev_incl_i, 1)
      468           .
      469         end.
      470      end.
      471      return rev_incl_s.
      472   end.
      473   procedure check-cfg :
      474     define input-output parameter p-param-code    as character no-undo .
      475     define input-output parameter p-param-type    as character no-undo .
      476     define input-output parameter p-data-type     as character no-undo .
      477     define input-output parameter p-param-name    as character no-undo .
      478     define input-output parameter p-attach-type   as character no-undo .
      479     define input-output parameter p-list-value    as character no-undo .
      480     define input-output parameter p-default-value as character no-undo .
      481     define input-output parameter p-param-PS      as character no-undo .
      482     define input-output parameter p-param-group   as character no-undo .
      483     define input-output parameter p-user-resp     as character no-undo .
      484     do
      485     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      486     on stop   undo, return error substitute( "&1. stop", vss-include-info1 )
      487     on endkey undo, return error substitute( "&1. endkey", vss-include-info1 )
      488     :
      489       define variable v-ind as character no-undo .
      490       assign
      491         p-param-code    = trim( p-param-code )
      492         p-param-type    = trim( p-param-type )
      493         p-data-type     = trim( p-data-type )
      494         p-param-name    = trim( p-param-name )
      495         p-attach-type   = trim( p-attach-type )
      496         p-list-value    = trim( p-list-value )
      497         p-default-value = trim( p-default-value )
      498         p-param-PS      = trim( p-param-PS )
      499         p-param-group   = trim( p-param-group )
      500         p-user-resp     = trim( p-user-resp )
      501       .
      502       if p-param-code = "":U then do:
      503         undo, return error substitute( "&1. Не задана метка параметра", vss-include-info1 ).
      504       end.
      505       if length( p-param-code ) > 8 then do:
      506         undo, return error substitute( "&1. Длина метки параметра не может превышать 8 символов (&2)", vss-include-info1, p-param-code ).
      507       end.
      508       if lookup( p-param-type, ',о,к,п':U ) = 0 then do:
      509         undo, return error substitute( '&1. Значение типа настройки "&2" не допустимо (&3)', vss-include-info1, p-param-type, p-param-code ).
      510       end.
      511       if lookup( p-param-type, 'к,п':U ) <> 0
      512         and lookup( p-attach-type, 'Нет':U ) = 0
      513       then do:
      514         undo, return error substitute( '&1. Для параметров с типом "&2" допустимы только привязки "&3" (&4)', vss-include-info1, 'к,п':U, 'Нет':U, p-param-code ).
      515       end.
      516       if p-param-name = "":U then do:
      517         undo, return error substitute( "&1. Не задано название параметра &2", vss-include-info1, p-param-code  ).
      518       end.
      519       if lookup( entry( 1, p-data-type ), "logical,integer,decimal,date,character":U ) = 0
      520         or num-entries( p-data-type ) > 2
      521         or ( num-entries( p-data-type ) = 2
      522              and entry( 2, p-data-type ) <> "list":U
      523            )
      524       then do:
      525         undo, return error substitute( "&1. Значение типа параметра &2 не допустимо (&3)", vss-include-info1, p-data-type, p-param-code ).
      526       end.
      527       if lookup( p-attach-type, 'Нет,Фирма,Объект':U ) = 0
      528       then do:
      529         undo, return error substitute( '&1. Значение привязки "&2" не допустимо (&3)', vss-include-info1, p-attach-type, p-param-code ).
      530       end.
      531     end.
      532     return.
      533   end procedure.
      534   procedure fill-cnf-struct :
      535     define input parameter p-file-name as character no-undo .
      536     do
      537     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      538     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      539     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      540     :
      541       define variable v-file-name as character no-undo .
      542       define variable v-counter as integer   no-undo .
      543       define variable v-temp-fname       as character           no-undo.
      544       define variable v-last-key         as integer             no-undo .
      545       define variable v-new-line         as integer             no-undo .
      546       define variable v-read-chksum      as logical             no-undo .
      547       define variable v-md5-signature-av as character           no-undo .
      548       define variable v-md5-signature    as character           no-undo .
      549       define frame inf-cfg
      550         v-counter label "Просмотрено"
      551         with view-as dialog-box side-labels 1 columns three-d title ""
      552       .
      553       assign
      554         v-file-name = search( p-file-name )
      555       .
      556       if v-file-name = ""
      557         or v-file-name = ?
      558       then do:
      559         return error substitute( "&1. Не задан файл схемы конфигурации!", vss-include-info1 ).
      560       end.
      561       assign
      562         v-last-key         = 0
      563         v-read-chksum      = false
      564         v-md5-signature-av = "":U
      565         file-info:file-name = ".":U
      566         v-temp-fname = substitute( "&1\&2-&3-&4.tmp", file-info:full-pathname, time, etime, random( 1111111 , 9999999 ) )
      567       .
      568       input stream TxtStream from value( v-file-name ).
      569       output stream temp-stream to value(v-temp-fname) .
      570       block_read:
      571       repeat while v-last-key <> -2
      572       on error undo, return error
      573       :
      574         readkey stream TxtStream pause 0.
      575         assign
      576           v-last-key = lastkey
      577         .
      578         if chr( v-last-key ) = chr(1) then do:
      579           assign
      580             v-read-chksum = true
      581           .
      582         end.
      583         else do:
      584           if v-read-chksum = true then do:
      585             if v-last-key = 13 then do:
      586               leave block_read.
      587             end.
      588             else do:
      589               assign
      590                 v-md5-signature-av = v-md5-signature-av + chr( v-last-key )
      591               .
      592             end.
      593           end.
      594           else do:
      595             if v-last-key = 13 then do:
      596               put stream temp-stream skip(v-new-line).
      597               assign
      598                 v-new-line = 1
      599               .
      600             end.
      601             else do:
      602               put stream temp-stream unformatted chr( v-last-key ).
      603               assign
      604                 v-new-line = 0
      605               .
      606             end.
      607           end.
      608         end.
      609       end.
      610       output stream temp-stream close.
      611       input stream TxtStream close.
      612       run gbl/md5.p
      613         ( input  search( v-temp-fname )
      614          ,output v-md5-signature
      615         ) no-error.
      616       if error-status :error then do:
      617         return error substitute("Ошибка при подсчете контрольной суммы текстового файла схемы &1", v-file-name ) .
      618       end.
      619       os-delete value( v-temp-fname ).
      620       assign
      621         v-md5-signature = sum-enc( v-md5-signature, 8 )
      622       .
      623       if v-md5-signature-av <> v-md5-signature then do:
      624         return error substitute( "Некорректная контрольная сумма текстового файла схемы &1", v-file-name ) .
      625       end.
      626       input stream TxtStream from value( v-file-name ).
      627       assign
      628         v-counter = 0
      629       .
      630       assign
      631         frame inf-cfg:title = "Чтение параметров конфигурации"
      632       .
      633       view frame inf-cfg.
      634       for each t_cnf-struct:
      635         delete t_cnf-struct.
      636       end.
      637       create t_cnf-struct no-error.
      638       read-cycle:
      639       repeat transaction
      640       on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      641       :
      642         assign
      643           v-counter = v-counter + 1
      644         .
      645         if ( v-counter modulo 10 ) = 0 then do:
      646           display
      647             v-counter
      648             with frame inf-cfg.
      649         end.
      650         import stream TxtStream delimiter '`':U t_cnf-struct.param-code t_cnf-struct.param-type t_cnf-struct.data-type t_cnf-struct.param-name t_cnf-struct.attach-type t_cnf-struct.list-value t_cnf-struct.default-value t_cnf-struct.PS t_cnf-struct.param-group t_cnf-struct.user-resp no-error.
      651         if error-status:error then do:
      652           return error substitute( "&1. Ошибка при чтении текстового файла схемы! Cтрока &1. (&2)", vss-include-info1, v-counter, error-status :get-message ( error-status :num-messages ) ).
      653         end.
      654         else do:
      655           if not ( t_cnf-struct.param-code begins chr(1) ) then do:
      656             assign
      657               t_cnf-struct.user-resp = decoding-user-resp( t_cnf-struct.param-code, t_cnf-struct.user-resp )
      658             .
      659             if t_cnf-struct.user-resp = "unknown":U then do:
      660               return error substitute( "&1. Ошибка параметра! Cтрока &2.", vss-include-info1, v-counter ).
      661             end.
      662             run check-cfg in this-procedure
      663               ( input-output t_cnf-struct.param-code
      664               ,input-output t_cnf-struct.param-type
      665               ,input-output t_cnf-struct.data-type
      666               ,input-output t_cnf-struct.param-name
      667               ,input-output t_cnf-struct.attach-type
      668               ,input-output t_cnf-struct.list-value
      669               ,input-output t_cnf-struct.default-value
      670               ,input-output t_cnf-struct.PS
      671               ,input-output t_cnf-struct.param-group
      672               ,input-output t_cnf-struct.user-resp
      673               ) no-error .
      674             if error-status :error then do:
      675               return error substitute( "&1. Ошибка параметра! Cтрока &2. &3 (&4)", vss-include-info1, v-counter, return-value, error-status :get-message ( error-status :num-messages ) ).
      676             end.
      677             else do:
      678               find first cnf-struct
      679                 where cnf-struct.param-code = t_cnf-struct.param-code
      680                 no-error
      681               .
      682               if not available cnf-struct then do:
      683                 create cnf-struct .
      684               end.
      685               buffer-copy t_cnf-struct to cnf-struct .
      686             end.
      687           end.
      688         end.
      689       end.
      690       delete t_cnf-struct no-error.
      691       hide frame inf-cfg.
      692       input stream TxtStream close.
      693     end.
      694     return.
      695   end procedure.
      696   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   define variable c-point  as character no-undo .
      698   define variable tbl      as character no-undo .
      699   define variable join-tbl as character no-undo .
      700   define variable fld      as character no-undo .
      701   define variable lab      as character no-undo .
      702   define variable spr      as character no-undo .
      703   define variable dim      as character no-undo .
      704   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      705   procedure fltfield-clear :
      706     define output parameter loc-fld as character no-undo.
      707     define output parameter loc-lab as character no-undo .
      708     define output parameter loc-spr as character no-undo .
      709     define output parameter loc-dim as character no-undo .
      710     assign
      711       loc-fld = ""
      712       loc-lab = ""
      713       loc-spr = ""
      714       loc-dim = "0"
      715     .
      716   end procedure .
      717   procedure fltfield-add :
      718     define input        parameter par-fld as character no-undo.
      719     define input        parameter par-lab as character no-undo .
      720     define input        parameter par-spr as character no-undo .
      721     define input-output parameter loc-fld as character no-undo.
      722     define input-output parameter loc-lab as character no-undo .
      723     define input-output parameter loc-spr as character no-undo .
      724     define input-output parameter loc-dim as character no-undo .
      725     do
      726     on error undo, return error
      727     :
      728       assign
      729       loc-fld = if loc-dim = '0'
      730                 then par-fld
      731                 else (loc-fld + chr(44) + par-fld)
      732       loc-lab = if loc-dim = '0'
      733                 then par-lab
      734                 else (loc-lab + chr(44) + par-lab)
      735       loc-spr = if loc-dim = '0'
      736                 then par-spr
      737                 else (loc-spr + chr(44) + par-spr)
      738       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      739                 string(integer(if num-entries(loc-dim) > 1
      740                               then entry(2, loc-dim)
      741                               else entry(1, loc-dim)
      742                               ) + 1)
      743       no-error
      744       .
      745     end.
      746   end procedure.
      747   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      749   procedure fltopend_fltopend :
      750   define input parameter p-parent-handle as handle no-undo .
      751   define input parameter p-qh as handle no-undo .
      752   define input parameter p-flt-open-open-query  as character no-undo .
      753   define input parameter p-where-cond as character no-undo .
      754   define input parameter p-use-indFIRST-query-tail as character no-undo .
      755   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      756   define input parameter p-indexed-reposition as character no-undo .
      757     do
      758     on error undo, return error
      759     :
      760   define variable v-prepare-string as character no-undo .
      761   define variable glog as logical no-undo .
      762   assign
      763   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      764                      p-where-cond + chr(32)  +
      765                      p-use-indFIRST-query-tail + chr(32) +
      766                      p-use-ind-sort-clmn-by + chr(32) +
      767                      p-indexed-reposition
      768   .
      769   assign
      770   glog = p-qh:query-prepare(v-prepare-string) no-error .
      771   if not glog
      772   or error-status:error then do:
      773     message error-status:get-message(1) view-as alert-box .
      774     undo, return error .
      775   end.
      776   assign
      777   glog = p-qh:query-open no-error .
      778   if not glog
      779   or error-status:error then do:
      780     message error-status:get-message(1) view-as alert-box .
      781     undo, return error .
      782   end.
      783     end.
      784   end procedure.
      785   procedure fltopend_fltfindd :
      786   define input parameter p-parent-handle as handle no-undo .
      787   define input parameter p-qh as handle no-undo .
      788   define input parameter p-rowid as rowid no-undo .
      789   define input parameter p-next as logical no-undo .
      790   define input parameter p-lock as integer no-undo .
      791   define input parameter p-bh as handle no-undo .
      792   define input parameter p-where-cond as character no-undo .
      793   define input parameter p-use-index-phrase as character no-undo .
      794   define variable glog as logical no-undo .
      795   define variable v-qh as handle no-undo .
      796   define variable v-bh as handle no-undo .
      797   define variable v-recid as recid no-undo .
      798   define variable v-prepare-string as character no-undo .
      799   do
      800   on error undo, return error
      801   on stop undo, return error
      802   :
      803     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      804     create buffer v-bh for table p-bh buffer-name p-bh:name.
      805     create query v-qh.
      806     v-qh:set-buffers(v-bh).
      807     v-prepare-string = substitute("for each &1 &2 &3"
      808                                     ,v-bh:name
      809                                     ,p-where-cond
      810                                     ,p-use-index-phrase).
      811     glog = v-qh:query-prepare(v-prepare-string) no-error.
      812     if not glog then do:
      813       delete object v-qh.
      814       delete object v-bh.
      815       undo, return error .
      816     end.
      817     glog = v-qh:query-open no-error .
      818     if not glog then do:
      819       delete object v-qh.
      820       delete object v-bh.
      821       undo, return error .
      822     end.
      823     if p-next then do:
      824       v-qh:reposition-to-rowid(p-rowid) no-error .
      825       glog = v-qh:get-next( p-lock) no-error .
      826       glog = v-qh:get-next( p-lock) no-error .
      827       if not glog or v-qh:query-off-end = yes then do:
      828         glog = v-qh:get-first( p-lock) no-error .
      829       end.
      830     end.
      831     else do:
      832       glog = v-qh:get-first( p-lock) no-error .
      833     end.
      834     v-recid = v-bh:recid no-error .
      835     delete object v-qh.
      836     delete object v-bh.
      837     return string(v-recid) .
      838   end.
      839   end procedure.
      840   procedure fltopend_fltfindq :
      841   define input parameter p-parent-handle as handle no-undo .
      842   define input parameter p-qh as handle no-undo .
      843   define input parameter p-next as logical no-undo .
      844   define input parameter p-lock as integer no-undo .
      845   define input parameter p-flt-open-open-query  as character no-undo .
      846   define input parameter p-where-cond as character no-undo .
      847   define input parameter p-use-indFIRST-query-tail as character no-undo .
      848   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      849   define input parameter p-indexed-reposition as character no-undo .
      850   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      851   define variable glog as logical no-undo .
      852   define variable v-qh as handle no-undo .
      853   define variable v-bh as handle no-undo extent 18.
      854   define variable v-rowid as rowid no-undo extent 18.
      855   define variable v-ii as integer no-undo .
      856   define variable v-prepare-string as character no-undo .
      857   do
      858   on error undo, return error
      859   on stop undo, return error
      860   :
      861     create query v-qh.
      862     do v-ii = 1 to p-qh:num-buffers:
      863       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      864       assign
      865       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      866       no-error.
      867       v-qh:add-buffer(v-bh[v-ii]).
      868     end.
      869     assign
      870     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      871                       p-where-cond + chr(32)  +
      872                       p-use-indFIRST-query-tail + chr(32) +
      873                       p-use-ind-sort-clmn-by + chr(32) +
      874                       p-indexed-reposition
      875     .
      876     glog = v-qh:query-prepare( v-prepare-string) no-error .
      877     if not glog then do:
      878       delete object v-qh.
      879       do v-ii = 1 to p-qh:num-buffers:
      880         delete object v-bh[v-ii].
      881       end.
      882       undo, return error .
      883     end.
      884     glog = v-qh:query-open no-error .
      885     if not glog then do:
      886       delete object v-qh.
      887       do v-ii = 1 to p-qh:num-buffers:
      888         delete object v-bh[v-ii].
      889       end.
      890       undo, return error .
      891     end.
      892     if p-next then do:
      893       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      894       glog = v-qh:get-next( p-lock) no-error .
      895       glog = v-qh:get-next( p-lock) no-error .
      896       if not glog or v-qh:query-off-end = yes then do:
      897         glog = v-qh:get-first( p-lock) no-error .
      898       end.
      899     end.
      900     else do:
      901       glog = v-qh:get-first( p-lock) no-error .
      902     end.
      903     do v-ii = 1 to p-qh:num-buffers:
      904       assign
      905       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      906       no-error.
      907     end.
      908     delete object v-qh.
      909     do v-ii = 1 to p-qh:num-buffers:
      910       delete object v-bh[v-ii].
      911     end.
      912   end.
      913   end procedure.
      914     define buffer buf-curr_db for ub.db.
      915   define variable mark             as character   no-undo .
      916   define variable mark-list        as character   no-undo .
      917   define variable Cnf-hdl          as handle      no-undo .
      918   define variable db-hdl           as handle      no-undo .
      919   define variable CurCnf-hdl       as handle      no-undo .
      920   define variable fname            as character   no-undo .
      921   define variable v-cnf-rec          as recid no-undo.
      922   define variable v-title0           as character no-undo init "Настройки и конфигурация системы" .
      923   define variable v-sort-column-name as character no-undo .
      924   define variable v-filter-pointr    as character no-undo init "Настройки и конфигурация системы" .
      925   define variable v-filter-point0    as character no-undo init "b-config" .
      926   define variable v-filter-point     as character no-undo .
      927   define temp-table tt_cnf no-undo like cnf .
      928   FUNCTION attach-ext RETURNS CHARACTER
      929     ()  FORWARD.
      930   FUNCTION attach-short RETURNS CHARACTER
      931     () FORWARD.
      932   FUNCTION can-process RETURNS LOGICAL
      933     ( input mes as character, input param-type as character) FORWARD.
      934   DEFINE BUTTON b-chg
      935        LABEL "&Изменить":L
      936        SIZE 10 BY 1 TOOLTIP "Изменить значение и/или привязку параметра".
      937   DEFINE BUTTON b-exit AUTO-GO
      938        LABEL "&Выход":L
      939        SIZE 10 BY 1 TOOLTIP "Сохранить изменения и выйти из режима".
      940   DEFINE BUTTON b-Exp
      941        LABEL "&Экспорт":L
      942        SIZE 10 BY 1 TOOLTIP "Вывести в файл набор парметров".
      943   DEFINE BUTTON b-help
      944        LABEL "Помо&щь":L
      945        SIZE 3 BY 1.
      946   DEFINE BUTTON b-hist
      947        LABEL "Ис&тория":L
      948        SIZE 3 BY 1.
      949   DEFINE BUTTON b-Imp
      950        LABEL "И&мпорт":L
      951        SIZE 10 BY 1 TOOLTIP "Считать из файла набор параметров".
      952   DEFINE BUTTON b-lkp
      953        LABEL "&Просмотр":L
      954        SIZE 10 BY 1 TOOLTIP "Просмотр параметра".
      955   DEFINE BUTTON b-Log
      956        LABEL "&Протокол":L
      957        SIZE 10 BY 1 TOOLTIP "Посмотреть протокол работы".
      958   DEFINE BUTTON b-mark
      959        LABEL "&*":L
      960        SIZE 3 BY 1 TOOLTIP "Поставить/снять отметку записи".
      961   DEFINE BUTTON b-save
      962        LABEL "&Сохранить":L
      963        SIZE 10 BY 1 TOOLTIP "Сохранить сделанные изменения".
      964   DEFINE BUTTON b-sch
      965        LABEL "&Фильтр"
      966        SIZE 3 BY 1.
      967   DEFINE BUTTON b-Tgle
      968        LABEL "В&кл/выкл":L
      969        SIZE 10 BY 1 TOOLTIP "Поставить/снять отметку работы с параметром".
      970   DEFINE VARIABLE f-db-num AS INTEGER FORMAT ">>>>9" INITIAL ?
      971        VIEW-AS FILL-IN
      972        SIZE 6 BY .83 NO-UNDO.
      973   DEFINE VARIABLE f-param-name AS CHARACTER FORMAT "X(85)"
      974        LABEL "Параметр"
      975         VIEW-AS TEXT
      976        SIZE 86 BY .67 NO-UNDO.
      977   DEFINE VARIABLE sch-param AS CHARACTER FORMAT "X(80)":U
      978        VIEW-AS FILL-IN
      979        SIZE 46.5 BY .83 NO-UNDO.
      980   DEFINE VARIABLE r-cnf-db AS CHARACTER INITIAL "all"
      981        VIEW-AS RADIO-SET HORIZONTAL
      982        RADIO-BUTTONS
      983             "Все", "all",
      984   "Текущая", "curr-db",
      985   "Выбранная", "sel-db"
      986        SIZE 31 BY .83 NO-UNDO.
      987   DEFINE VARIABLE r-cnf-encoded AS CHARACTER INITIAL "all"
      988        VIEW-AS RADIO-SET HORIZONTAL
      989        RADIO-BUTTONS
      990             "Все", "all",
      991   "Выборочно", "sel-type"
      992        SIZE 20 BY .83 NO-UNDO.
      993   DEFINE VARIABLE r-find-in-br AS CHARACTER
      994        VIEW-AS RADIO-SET HORIZONTAL
      995        RADIO-BUTTONS
      996             "По коду", "param-code",
      997   "По названию", "param-name",
      998   "По значению", "param-value"
      999        SIZE 42 BY .83 NO-UNDO.
     1000   DEFINE VARIABLE r-show-cnf AS CHARACTER INITIAL "used"
     1001        VIEW-AS RADIO-SET HORIZONTAL
     1002        RADIO-BUTTONS
     1003             "Все", "all",
     1004   "Включенные", "used",
     1005   "Выключенные", "notused",
     1006   "Только с ошибками", "onlyerror"
     1007        SIZE 57 BY .83 NO-UNDO.
     1008   DEFINE VARIABLE t-cnf-type-k AS LOGICAL INITIAL no
     1009        LABEL "К"
     1010        VIEW-AS TOGGLE-BOX
     1011        SIZE 4 BY .83 NO-UNDO.
     1012   DEFINE VARIABLE t-cnf-type-notenc AS LOGICAL INITIAL no
     1013        LABEL "Без кодировки"
     1014        VIEW-AS TOGGLE-BOX
     1015        SIZE 16 BY .83 NO-UNDO.
     1016   DEFINE VARIABLE t-cnf-type-o AS LOGICAL INITIAL no
     1017        LABEL "О"
     1018        VIEW-AS TOGGLE-BOX
     1019        SIZE 4 BY .83 NO-UNDO.
     1020   DEFINE VARIABLE t-cnf-type-s AS LOGICAL INITIAL no
     1021        LABEL "П"
     1022        VIEW-AS TOGGLE-BOX
     1023        SIZE 4 BY .83 NO-UNDO.
     1024   DEFINE QUERY br-config FOR Cnf, cnf-struct SCROLLING.
     1025   DEFINE BROWSE br-config
     1026     QUERY br-config DISPLAY
     1027         mark  COLUMN-LABEL '*'  FORMAT "X(1)"
     1028         (if Cnf.NotUsed   THEN '-' ELSE '+')  COLUMN-LABEL '+'  FORMAT "X(1)"
     1029         (if Cnf.Is-Changed THEN 'X' ELSE ' ')  COLUMN-LABEL 'И'  FORMAT "X(1)"
     1030         Cnf.Conf-Type  COLUMN-LABEL 'Т'  FORMAT "X(1)"
     1031         attach-short()  COLUMN-LABEL 'П'  FORMAT "X(1)"
     1032         string(Cnf.db-num)  COLUMN-LABEL 'БД'
     1033         Cnf.Param-Code  COLUMN-LABEL 'Код'
     1034         Cnf.Param-Name  COLUMN-LABEL 'Название'  format "x(256)"
     1035         Cnf.Param-Value  COLUMN-LABEL 'Значение'
     1036         attach-ext() COLUMN-LABEL 'Привязка' FORMAT "X(25)"
     1037         Cnf.Param-PS COLUMN-LABEL 'Примечание'
     1038         cnf-struct.list-value COLUMN-LABEL 'Возможные значения' FORMAT "X(18)"
     1039         cnf-struct.default-value COLUMN-LABEL 'Значение по умолчанию' FORMAT "X(15)"
     1040         String(Cnf.ErrorExist) COLUMN-LABEL ' Ош. '
     1041         cnf-struct.data-type COLUMN-LABEL ' Тип   параметра ' FORMAT "X(17)"
     1042         (if cnf.beg-date <> 01/01/1900 then string(cnf.beg-date,'99/99/9999') else 'неограничено' ) COLUMN-LABEL 'Действует с' FORMAT "X(12)"
     1043         (if cnf.end-date <> 01/01/9999 then string(cnf.end-date,'99/99/9999') else 'неограничено.' ) COLUMN-LABEL 'Действует по' FORMAT "X(12)"
     1044       WITH SEPARATORS SIZE 97 BY 15.75 ROW-HEIGHT-CHARS .63.
     1045   DEFINE FRAME fr-config
     1046        b-exit AT ROW 1 COL 2 WIDGET-ID 4
     1047        b-mark AT ROW 1 COL 12 WIDGET-ID 18
     1048        b-save AT ROW 1 COL 15 WIDGET-ID 20
     1049        b-lkp AT ROW 1 COL 25 WIDGET-ID 14
     1050        b-chg AT ROW 1 COL 35 WIDGET-ID 2
     1051        b-Tgle AT ROW 1 COL 45 WIDGET-ID 22
     1052        b-Exp AT ROW 1 COL 55 WIDGET-ID 6
     1053        b-Imp AT ROW 1 COL 65 WIDGET-ID 12
     1054        b-Log AT ROW 1 COL 75 WIDGET-ID 16
     1055        b-sch AT ROW 1 COL 90 WIDGET-ID 40
     1056        b-hist AT ROW 1 COL 93 WIDGET-ID 10
     1057        b-help AT ROW 1 COL 96 WIDGET-ID 8
     1058        r-show-cnf AT ROW 2.5 COL 14.5 NO-LABEL WIDGET-ID 34
     1059        r-cnf-encoded AT ROW 3.5 COL 14.5 NO-LABEL WIDGET-ID 50
     1060        t-cnf-type-k AT ROW 3.5 COL 46 WIDGET-ID 56
     1061        t-cnf-type-s AT ROW 3.5 COL 51 WIDGET-ID 58
     1062        t-cnf-type-o AT ROW 3.5 COL 56 WIDGET-ID 60
     1063        t-cnf-type-notenc AT ROW 3.5 COL 61 WIDGET-ID 62
     1064        r-cnf-db AT ROW 4.5 COL 14.5 NO-LABEL WIDGET-ID 42
     1065        f-db-num AT ROW 4.5 COL 44 COLON-ALIGNED NO-LABEL WIDGET-ID 66
     1066        r-find-in-br AT ROW 5.75 COL 10.5 NO-LABEL WIDGET-ID 70
     1067        sch-param AT ROW 5.75 COL 50.5 COLON-ALIGNED NO-LABEL WIDGET-ID 30
     1068        br-config AT ROW 6.75 COL 2 WIDGET-ID 200
     1069        f-param-name AT ROW 22.75 COL 2 WIDGET-ID 32
     1070        "Параметры:" VIEW-AS TEXT
     1071             SIZE 12 BY .83 AT ROW 2.5 COL 2 WIDGET-ID 46
     1072        "Поиск:" VIEW-AS TEXT
     1073             SIZE 7 BY .83 AT ROW 5.75 COL 2 WIDGET-ID 68
     1074        "Кодировка:" VIEW-AS TEXT
     1075             SIZE 12 BY .83 AT ROW 3.5 COL 2 WIDGET-ID 64
     1076        "БД:" VIEW-AS TEXT
     1077             SIZE 5 BY .83 AT ROW 4.5 COL 9 WIDGET-ID 48
     1078        SPACE(85.87) SKIP(18.29)
     1079       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1080            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1081            TITLE "" WIDGET-ID 100.
     1082   ASSIGN
     1083          FRAME fr-config:SCROLLABLE       = FALSE.
     1084   ASSIGN
     1085          f-db-num:HIDDEN IN FRAME fr-config           = TRUE.
     1086   ASSIGN
     1087          f-param-name:READ-ONLY IN FRAME fr-config        = TRUE.
     1088   ASSIGN
     1089          t-cnf-type-k:HIDDEN IN FRAME fr-config           = TRUE.
     1090   ASSIGN
     1091          t-cnf-type-notenc:HIDDEN IN FRAME fr-config           = TRUE.
     1092   ASSIGN
     1093          t-cnf-type-o:HIDDEN IN FRAME fr-config           = TRUE.
     1094   ASSIGN
     1095          t-cnf-type-s:HIDDEN IN FRAME fr-config           = TRUE.
     1096   ON WINDOW-CLOSE OF FRAME fr-config
     1097   DO:
     1098     APPLY "END-ERROR":U TO SELF.
     1099   END.
     1100   ON CHOOSE OF b-chg IN FRAME fr-config
     1101   DO:
     1102     if not can-process("Параметр закодирован. Изменение не допускается", 'к,п':U) then do:
     1103       return no-apply.
     1104     end.
     1105     run chg-param in this-procedure
     1106       ( input recid( cnf )
     1107       , input false
     1108       ) .
     1109     apply "entry" to browse br-config.
     1110   END.
     1111   ON CHOOSE OF b-exit IN FRAME fr-config
     1112   DO:
     1113     define buffer buf-chg_cnf for cnf .
     1114       find first buf-chg_cnf
     1115         where buf-chg_cnf.is-changed = true
     1116         no-error .
     1117       if available buf-chg_cnf then do:
     1118         message
     1119           "Завершение работы с конфигурацией."
     1120           "Сохранить сделанные изменения?"
     1121           view-as alert-box question buttons yes-no-cancel update go-ahead as logical.
     1122         if go-ahead = true then do:
     1123           run waitfram-show in this-procedure ("Сохранение набора параметров").
     1124           run save-cfg in db-hdl
     1125             ( input no
     1126             ) no-error.
     1127           if error-status :error
     1128             or return-value <> ""
     1129           then do:
     1130               message
     1131                 "Попытка сохранить изменения не удалась!" skip
     1132                 error-status :get-message(1) skip
     1133                 return-value skip
     1134                 "Выйти без сохранения?" skip
     1135                 view-as alert-box buttons yes-no update go-out as logical.
     1136               if go-out = false then do:
     1137                 run waitfram-hide in this-procedure .
     1138                 return no-apply.
     1139               end.
     1140           end.
     1141           run waitfram-hide in this-procedure .
     1142         end.
     1143       end.
     1144   END.
     1145   ON CHOOSE OF b-Exp IN FRAME fr-config
     1146   DO:
     1147     define variable v-err-code     as character no-undo .
     1148     define variable v-qnty-exp-cnf as integer   no-undo .
     1149     define buffer buf_cnf for cnf .
     1150     run export-cnf in CurCnf-hdl
     1151       ( input this-procedure :handle
     1152       , input (false )
     1153       , input (if available cnf then recid( cnf ) else ? )
     1154       , input mark-list
     1155       , output v-qnty-exp-cnf
     1156       ) no-error .
     1157     if error-status :error then do:
     1158       message
     1159         vss-workfile vss-revision vss-description skip
     1160         substitute("Произошли ошибки при экспорте параметров!") skip
     1161         error-status :get-message(1) skip
     1162         return-value skip
     1163         view-as alert-box error .
     1164     end.
     1165     else do:
     1166       if v-qnty-exp-cnf <> ? then do:
     1167         message
     1168           "Экспорт параметров завершен!" skip
     1169           substitute( "Выгружено &1 параметров", v-qnty-exp-cnf ) skip
     1170           view-as alert-box information.
     1171       end.
     1172     end.
     1173     apply "entry" to browse br-config.
     1174   END.
     1175   ON CHOOSE OF b-hist IN FRAME fr-config
     1176   DO:
     1177      run adm/cfg-hist.w
     1178       ( input parparentproc
     1179        ,buffer cnf
     1180       )
     1181     .
     1182     apply "entry" to browse br-config.
     1183   END.
     1184   ON CHOOSE OF b-Imp IN FRAME fr-config
     1185   DO:
     1186     define variable clearcnf   as logical   no-undo.
     1187     define variable uselast    as logical   no-undo.
     1188     define variable v-err-code as character no-undo .
     1189     define variable v-db-load  as character no-undo .
     1190     assign
     1191       fname = "config.cfg"
     1192     .
     1193     run adm/impi.w
     1194       ( input-output fname
     1195       , output clearcnf
     1196       , output uselast
     1197       ) no-error.
     1198     if error-status:error then do:
     1199       message
     1200         vss-workfile vss-revision vss-description skip
     1201         "Ошибка при запуске процедуры impi.w" skip
     1202         error-status :get-message(1) skip
     1203         return-value skip
     1204         view-as alert-box error .
     1205       return no-apply.
     1206     end.
     1207     if fname = "":U then do:
     1208       apply "entry" to browse br-config.
     1209       return no-apply.
     1210     end.
     1211     run waitfram-show in this-procedure ("Импорт конфигурации").
     1212     assign
     1213       v-db-load = "":U
     1214     .
     1215       if buf-curr_db.db-num > 0 then do:
     1216         assign
     1217           v-db-load = string( buf-curr_db.db-num )
     1218         .
     1219       end.
     1220     run toggle-mes in cnf-hdl
     1221       ( input false
     1222       ).
     1223     run import in CurCnf-hdl
     1224     ( input fname
     1225     , input clearcnf
     1226     , input uselast
     1227     , input false
     1228     , input v-db-load
     1229     ).
     1230     run toggle-mes in cnf-hdl
     1231       ( input true
     1232       ).
     1233     assign
     1234       v-err-code = return-value
     1235     .
     1236     run chk-unref in curcnf-hdl
     1237       ( input ?
     1238       , input ?
     1239       , input ?
     1240       , input false
     1241       ) no-error.
     1242     if error-status :error then do:
     1243       message
     1244         vss-workfile vss-revision vss-description skip
     1245         substitute("Ошибка при создании недостающих параметров") skip
     1246         error-status :get-message(1) skip
     1247         return-value skip
     1248         view-as alert-box error .
     1249       run waitfram-hide in this-procedure .
     1250       return no-apply.
     1251     end.
     1252     run waitfram-hide in this-procedure .
     1253     if available cnf then do:
     1254       assign
     1255         v-cnf-rec = recid( cnf )
     1256       .
     1257     end.
     1258     run reopen-query in this-procedure
     1259       ( input true
     1260       , input false
     1261       , input '':U
     1262       ) .
     1263     reposition br-config to recid v-cnf-rec no-error .
     1264     assign
     1265       v-cnf-rec = ?
     1266     .
     1267     if v-err-code = "":U then do:
     1268       message
     1269         "Импорт параметров завершен"
     1270         view-as alert-box information.
     1271     end.
     1272     else do:
     1273       message
     1274         "Параметры не загружены!!!" skip
     1275         "Произошли ошибки при импорте параметров!" skip
     1276         'Просмотреть ошибки можно по кнопке "протокол"'
     1277         view-as alert-box error .
     1278     end.
     1279     apply "entry" to browse br-config.
     1280   END.
     1281   ON CHOOSE OF b-lkp IN FRAME fr-config
     1282   DO:
     1283     define variable rid as integer no-undo.
     1284     rid = recid (cnf).
     1285       run adm/cnfi.w (parparentproc, curcnf-hdl, db-hdl, cnf-hdl, "lkp":U, input-output rid).
     1286     apply "entry" to browse br-config.
     1287   END.
     1288   ON CHOOSE OF b-Log IN FRAME fr-config
     1289   DO:
     1290     run adm/show-log.w .
     1291     apply "entry" to browse br-config.
     1292   END.
     1293   ON CHOOSE OF b-mark IN FRAME fr-config
     1294   DO:
     1295     define variable v-log as logical no-undo .
     1296     if not available Cnf then do:
     1297       message "Неправильный выбор строки.".
     1298       return no-apply.
     1299     end.
     1300   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1301   define variable v-str-recid7 as character no-undo .
     1302   define variable v-num-entry7 as integer   no-undo .
     1303   assign
     1304     v-str-recid7 = trim( string( recid( cnf ) , "->>>>>>>>>>>9":U ) )
     1305     v-num-entry7 = lookup( v-str-recid7 , mark-list )
     1306   .
     1307   if v-num-entry7 > 0 then do:
     1308     assign
     1309       entry( v-num-entry7, mark-list ) = "":U
     1310       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1311     .
     1312   end.
     1313   else do:
     1314     assign
     1315       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid7
     1316     .
     1317   end.
     1318     assign
     1319       v-log = br-config:refresh() in frame fr-config
     1320       v-log = br-config:select-next-row () in frame fr-config
     1321     .
     1322   END.
     1323   ON CHOOSE OF b-save IN FRAME fr-config
     1324   DO:
     1325       run waitfram-show in this-procedure ("Сохранение набора параметров").
     1326       run save-cfg in db-hdl
     1327         ( input no
     1328         ) no-error .
     1329       if error-status :error
     1330         or return-value <> ""
     1331       then do:
     1332         message
     1333           substitute( "Попытка сохранить изменения не удалась." ) skip
     1334           error-status :get-message(1) skip
     1335           return-value skip
     1336           view-as alert-box error .
     1337       end.
     1338       else do:
     1339         for each cnf
     1340           where cnf.is-changed
     1341         :
     1342           assign
     1343             cnf.is-changed = false
     1344           .
     1345         end.
     1346         run reopen-query in this-procedure
     1347           ( input true
     1348           , input false
     1349           , input '':U
     1350           ) .
     1351       end.
     1352       run waitfram-hide in this-procedure .
     1353       apply "entry" to browse br-config.
     1354   END.
     1355   ON CHOOSE OF b-sch IN FRAME fr-config
     1356   DO:
     1357     run proc-b-sch in this-procedure no-error.
     1358     apply "entry" to browse br-config.
     1359   END.
     1360   ON CHOOSE OF b-Tgle IN FRAME fr-config
     1361   DO:
     1362     if not can-process("Параметр кодированный. Включение/отключение не допускается", 'к,п':U )
     1363       or ( cnf.NotUsed = false
     1364            and not can-process("Параметр обязательный. Отключение не допускается", 'о':U )
     1365          )
     1366     then do:
     1367       return no-apply.
     1368     end.
     1369     run chg-param in this-procedure
     1370       ( input recid( cnf )
     1371       , input true
     1372       ) .
     1373     apply "entry" to browse br-config.
     1374   END.
     1375   ON ANY-PRINTABLE OF br-config IN FRAME fr-config
     1376   DO:
     1377     assign
     1378       sch-param:screen-value = sch-param:screen-value + last-event:label
     1379     .
     1380     apply "entry" to sch-param in frame fr-config.
     1381     apply "end" to sch-param in frame fr-config.
     1382   END.
     1383   ON MOUSE-SELECT-DBLCLICK OF br-config IN FRAME fr-config
     1384   OR RETURN OF br-config IN FRAME fr-config
     1385   DO:
     1386     apply "choose" to b-chg in frame fr-config.
     1387   END.
     1388   ON ROW-DISPLAY OF br-config IN FRAME fr-config
     1389   DO:
     1390     if lookup( string( recid( cnf ) ), mark-list ) > 0 then do:
     1391       assign
     1392         mark = "*":U
     1393       .
     1394     end.
     1395     else do:
     1396       assign
     1397         mark = "":U
     1398       .
     1399     end.
     1400     case cnf.ErrorExist:
     1401       when 0 then do:
     1402          Cnf.Param-Code:fgcolor in browse br-config = 0 .
     1403       end.
     1404       when 1 then do:
     1405          Cnf.Param-Code:fgcolor in browse br-config = 9 .
     1406       end.
     1407       when 2 then do:
     1408          Cnf.Param-Code:fgcolor in browse br-config = 12 .
     1409       end.
     1410     end case.
     1411   END.
     1412   ON VALUE-CHANGED OF br-config IN FRAME fr-config
     1413   DO:
     1414     if available cnf then do:
     1415       assign
     1416         f-param-name :screen-value = cnf.param-name
     1417       .
     1418     end.
     1419     else do:
     1420       assign
     1421         f-param-name :screen-value = "":U
     1422       .
     1423     end.
     1424   END.
     1425   ON RETURN OF f-db-num IN FRAME fr-config
     1426   DO:
     1427     assign
     1428       f-db-num
     1429     .
     1430     if available cnf then do:
     1431       assign
     1432         v-cnf-rec = recid( cnf )
     1433       .
     1434     end.
     1435     run reopen-query in this-procedure
     1436       ( input true
     1437       , input false
     1438       , input '':U
     1439       ) .
     1440     reposition br-config to recid v-cnf-rec no-error .
     1441     assign
     1442       v-cnf-rec = ?
     1443     .
     1444   END.
     1445   ON VALUE-CHANGED OF r-cnf-db IN FRAME fr-config
     1446   DO:
     1447     assign
     1448       r-cnf-db
     1449     .
     1450     disable
     1451       f-db-num
     1452       with frame fr-config
     1453     .
     1454     hide
     1455       f-db-num
     1456       in frame fr-config
     1457     .
     1458     case r-cnf-db :
     1459         when "curr-db":U then do:
     1460           if available buf-curr_db then do:
     1461             assign
     1462               f-db-num = buf-curr_db.db-num
     1463             .
     1464             display
     1465               f-db-num
     1466               with frame fr-config
     1467             .
     1468           end.
     1469         end.
     1470       when "sel-db":U then do:
     1471         enable
     1472           f-db-num
     1473           with frame fr-config
     1474         .
     1475         apply "entry" to f-db-num in frame fr-config.
     1476       end.
     1477     end case.
     1478     if lookup( r-cnf-db, "all,curr-db":U ) > 0 then do:
     1479       if available cnf then do:
     1480         assign
     1481           v-cnf-rec = recid( cnf )
     1482         .
     1483       end.
     1484       run reopen-query in this-procedure
     1485         ( input true
     1486         , input false
     1487         , input '':U
     1488         ) .
     1489       reposition br-config to recid v-cnf-rec no-error .
     1490       assign
     1491         v-cnf-rec = ?
     1492       .
     1493     end.
     1494   END.
     1495   ON VALUE-CHANGED OF r-cnf-encoded IN FRAME fr-config
     1496   DO:
     1497     assign
     1498       r-cnf-encoded
     1499     .
     1500     if r-cnf-encoded = "all":U then do:
     1501       hide
     1502         t-cnf-type-k
     1503         t-cnf-type-s
     1504         t-cnf-type-o
     1505         t-cnf-type-notenc
     1506         in frame fr-config
     1507       .
     1508     end.
     1509     else do:
     1510       enable
     1511         t-cnf-type-k
     1512         t-cnf-type-s
     1513         t-cnf-type-o
     1514         t-cnf-type-notenc
     1515         with frame fr-config
     1516       .
     1517     end.
     1518     if available cnf then do:
     1519       assign
     1520         v-cnf-rec = recid( cnf )
     1521       .
     1522     end.
     1523     run reopen-query in this-procedure
     1524       ( input true
     1525       , input false
     1526       , input '':U
     1527       ) .
     1528     reposition br-config to recid v-cnf-rec no-error .
     1529     assign
     1530       v-cnf-rec = ?
     1531     .
     1532   END.
     1533   ON VALUE-CHANGED OF r-find-in-br IN FRAME fr-config
     1534   DO:
     1535     assign
     1536       r-find-in-br
     1537     .
     1538     case r-find-in-br :
     1539       when "param-code":U then do:
     1540         assign
     1541           sch-param :format       = "X(12)"
     1542           sch-param :width-chars = 13.0
     1543         .
     1544       end.
     1545       when "param-name":U
     1546         or when "param-vale":U
     1547       then do:
     1548         assign
     1549           sch-param :format       = "X(80)"
     1550           sch-param :width-chars = 46.5
     1551         .
     1552       end.
     1553     end case.
     1554     assign
     1555       sch-param:screen-value = "":U
     1556     .
     1557   END.
     1558   ON VALUE-CHANGED OF r-show-cnf IN FRAME fr-config
     1559   DO:
     1560     assign
     1561       r-show-cnf
     1562     .
     1563     if available cnf then do:
     1564       assign
     1565         v-cnf-rec = recid( cnf )
     1566       .
     1567     end.
     1568     run reopen-query in this-procedure
     1569       ( input true
     1570       , input false
     1571       , input '':U
     1572       ) .
     1573     reposition br-config to recid v-cnf-rec no-error .
     1574     assign
     1575       v-cnf-rec = ?
     1576     .
     1577   END.
