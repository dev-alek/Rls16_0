     1964   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1965   procedure minbtn-set :
     1966       do
     1967           on error undo, return error return-value
     1968           :
     1969           define variable ii              as integer       no-undo .
     1970           define variable fh              as widget-handle no-undo .
     1971           define variable hh              as widget-handle no-undo .
     1972           define variable v-h             as handle        extent 4 no-undo .
     1973           define variable v-name-button   as character     no-undo .
     1974           define variable v-help-old-x    as decimal       no-undo .
     1975           define variable v-help-old-y    as decimal       no-undo .
     1976           define variable v-help-old-size as decimal       no-undo .
     1977           define variable v-frame-width   as decimal       no-undo .
     1978           define variable jj              as integer       no-undo .
     1979           do
     1980               on error undo, return error
     1981               :
     1982               assign
     1983                   v-frame-width = frame fr-config:width - 0.3
     1984                   fh            = frame fr-config:first-child
     1985                   hh            = fh:first-child
     1986                   ii            = 1
     1987                   .
     1988               do while valid-handle(hh):
     1989                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1990                   do:
     1991                       case lc(hh:name) :
     1992                           when "b-help" then
     1993                               do:
     1994                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1995                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1996                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1997                                   hh:TOOLTIP = "Помощь" .
     1998                                   v-help-old-x = hh:column .
     1999                                   v-help-old-y = hh:row    .
     2000                                   v-help-old-size = hh:width .
     2001                                   hh:width-chars = 2.5 .
     2002                               end.
     2003                           when "b-print" then
     2004                               do:
     2005                                   hh:load-image("cmp/b-print.bmp":u) .
     2006                                   hh:TOOLTIP = "Печать" .
     2007                                   v-h[ii] = hh:handle .
     2008                                   ii = ii + 1 .
     2009                                   hh:width-chars = 3 .
     2010                               end.
     2011                           when "b-history" or
     2012                           when "b-hist" then
     2013                               do:
     2014                                   hh:load-image("cmp/b-hist.bmp":u) .
     2015                                   hh:TOOLTIP = "История" .
     2016                                   v-h[ii] = hh:handle .
     2017                                   ii = ii + 1 .
     2018                                   hh:width-chars = 3 .
     2019                               end.
     2020                           when "b-sch" then
     2021                               do:
     2022                                   hh:load-image("cmp/b-sch.bmp":u) .
     2023                                   hh:TOOLTIP = "Установка Фильтра" .
     2024                                   v-h[ii] = hh:handle .
     2025                                   ii = ii + 1 .
     2026                                   hh:width-chars = 3 .
     2027                               end.
     2028                           when "b-hist-user" then
     2029                               do:
     2030                                   hh:load-image("cmp/b-hist.bmp":u) .
     2031                                   hh:TOOLTIP = "История пользователя" .
     2032                                   ii = ii + 1 .
     2033                               end.
     2034                       end case.
     2035                   end.
     2036                   hh = hh:next-sibling.
     2037               end.
     2038               b-help:column = v-frame-width - b-help:width-chars.
     2039               jj = 0.
     2040               repeat ii = 4 to 1 by -1 :
     2041                   if valid-handle (v-h[ii] ) then
     2042                   do:
     2043                       jj  = jj + 1 .
     2044                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2045                       v-h[ii]:row    = v-help-old-y .
     2046                   end.
     2047               end.
     2048           end.
     2049       end.
     2050   end procedure.
     2051   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2052   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2053   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2054   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2055   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2056   define variable v-diasize-current-frame-height as decimal   no-undo .
     2057   define variable v-diasize-change-size          as logical   no-undo .
     2058   define variable v-diasize-resize-button        as handle    no-undo .
     2059   define variable v-diasize-wndmax               as logical   no-undo .
     2060   define variable v-diasize-wndstore             as logical   no-undo .
     2061   define variable v-diasize-proc-name            as character no-undo .
     2062   define variable v-diasize-browse-handle        as handle    no-undo .
     2063   define variable v-diasize-browse-number        as integer   no-undo .
     2064   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2065   define temp-table temp-diasize-handle no-undo
     2066     field handle-value  as handle
     2067     field save-position as decimal
     2068     index xpk is primary unique handle-value
     2069     .
     2070   define temp-table temp-browse-handle no-undo
     2071     field browse-type   as character
     2072     field browse-number as integer
     2073     field browse-handle as handle
     2074     field original-size as decimal
     2075     index xpk is primary unique browse-type browse-number
     2076     index xie browse-type browse-handle
     2077   .
     2078   procedure diasize_change-height :
     2079     define input  parameter p-change-value  as decimal   no-undo .
     2080     define input  parameter p-move-resize   as logical   no-undo .
     2081     define variable v-field-group-handle    as handle    no-undo .
     2082     define variable v-object-handle         as handle    no-undo .
     2083     define variable v-frame-height          as decimal   no-undo .
     2084     define variable v-frame-virtual-height  as decimal   no-undo .
     2085     define variable v-browse-height         as decimal   no-undo .
     2086     define variable v-window-height         as decimal   no-undo .
     2087     define variable v-window-virtual-height as decimal   no-undo .
     2088     define variable v-change-sign           as integer   no-undo .
     2089     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2090     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2091     if p-change-value > 0
     2092     then do:
     2093       if frame fr-config :height + p-change-value
     2094           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2095       then do:
     2096         assign
     2097           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2098                           - (frame fr-config :height-chars)
     2099         .
     2100         if p-change-value <= 0
     2101         then do:
     2102           run diasize_position-resize-button in this-procedure .
     2103           return .
     2104         end.
     2105       end.
     2106     end.
     2107     if p-change-value < 0
     2108     then do:
     2109       if frame fr-config :height + p-change-value < v-diasize-orig-frame-height
     2110       then do:
     2111         assign
     2112           p-change-value = v-diasize-orig-frame-height
     2113                          - (frame fr-config :height-chars)
     2114         .
     2115         if p-change-value >= 0
     2116         then do:
     2117           run diasize_position-resize-button in this-procedure .
     2118           return .
     2119         end.
     2120       end.
     2121     end.
     2122     if p-change-value >= 0
     2123     then do:
     2124       assign
     2125         v-change-sign = 1
     2126       .
     2127     end.
     2128     else do:
     2129       assign
     2130         v-change-sign = -1
     2131       .
     2132     end.
     2133     assign
     2134       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2135     .
     2136     if p-change-value = 0
     2137     then do:
     2138       run diasize_position-resize-button in this-procedure .
     2139       return .
     2140     end.
     2141     move_block:
     2142     do
     2143     on error undo move_block, retry move_block
     2144     :
     2145       if retry
     2146       then do:
     2147         do
     2148         on error undo move_block, leave move_block
     2149         :
     2150           if p-change-value > 0
     2151           then do:
     2152             for each buf_temp-diasize-handle
     2153             on error undo, next
     2154             :
     2155               assign
     2156                 v-object-handle = buf_temp-diasize-handle.handle-value
     2157               .
     2158               if v-object-handle <> v-diasize-resize-button
     2159               then do:
     2160                 assign
     2161                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2162                 .
     2163               end.
     2164             end.
     2165             assign
     2166               v-diasize-browse-handle :height = v-browse-height
     2167             .
     2168             for each buf_temp-browse-handle
     2169               where buf_temp-browse-handle.browse-type = 'height':u
     2170             on error undo, next
     2171             :
     2172               assign
     2173                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2174               .
     2175             end.
     2176             assign
     2177               frame fr-config :height = v-frame-height
     2178             .
     2179             if frame fr-config :scrollable = true
     2180             then do:
     2181               assign
     2182                 frame fr-config :virtual-height = v-frame-virtual-height
     2183               .
     2184             end.
     2185             run diasize_position-resize-button in this-procedure .
     2186           end.
     2187           else do:
     2188             if frame fr-config :scrollable = true
     2189             then do:
     2190               assign
     2191                 frame fr-config :virtual-height = v-frame-virtual-height
     2192               .
     2193             end.
     2194             assign
     2195               frame fr-config :height = v-frame-height
     2196             .
     2197             assign
     2198               v-diasize-browse-handle :height = v-browse-height
     2199             .
     2200             for each buf_temp-browse-handle
     2201               where buf_temp-browse-handle.browse-type = 'height':u
     2202             on error undo, next
     2203             :
     2204               assign
     2205                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2206               .
     2207             end.
     2208             for each buf_temp-diasize-handle
     2209             on error undo, next
     2210             :
     2211               assign
     2212                 v-object-handle = buf_temp-diasize-handle.handle-value
     2213               .
     2214               if v-object-handle <> v-diasize-resize-button
     2215               then do:
     2216                 assign
     2217                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2218                 .
     2219               end.
     2220             end.
     2221             run diasize_position-resize-button in this-procedure .
     2222           end.
     2223           assign
     2224             v-diasize-change-size = false
     2225           .
     2226           leave move_block .
     2227         end.
     2228       end.
     2229       assign
     2230         v-diasize-need-full-display = true
     2231       .
     2232       if v-diasize-change-size = false
     2233       then do:
     2234         assign
     2235           v-diasize-change-size = true
     2236         .
     2237       end.
     2238       else do:
     2239         return .
     2240       end.
     2241       assign
     2242         v-frame-height = frame fr-config :height
     2243         v-frame-virtual-height = frame fr-config :virtual-height
     2244         v-browse-height = v-diasize-browse-handle :height
     2245       .
     2246       for each buf_temp-browse-handle
     2247         where buf_temp-browse-handle.browse-type = 'height':u
     2248       :
     2249         assign
     2250           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2251         .
     2252       end.
     2253       for each buf_temp-diasize-handle
     2254       :
     2255         delete buf_temp-diasize-handle .
     2256       end.
     2257       assign
     2258         v-field-group-handle = frame fr-config :first-child
     2259       .
     2260       do while valid-handle(v-field-group-handle)
     2261       :
     2262         assign
     2263           v-object-handle = v-field-group-handle :first-child
     2264         .
     2265         do while valid-handle(v-object-handle)
     2266         :
     2267           if  v-object-handle <> v-diasize-browse-handle :handle
     2268           and can-query(v-object-handle, "row")
     2269           and can-query(v-object-handle, "height")
     2270           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2271           then do:
     2272             find first buf_temp-browse-handle
     2273               where buf_temp-browse-handle.browse-type   = 'height':u
     2274                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2275               no-error .
     2276             if available buf_temp-browse-handle
     2277             then do:
     2278             end.
     2279             else do:
     2280               create buf_temp-diasize-handle .
     2281               assign
     2282                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2283                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2284               .
     2285             end.
     2286           end.
     2287           assign
     2288             v-object-handle = v-object-handle :next-sibling
     2289           .
     2290         end.
     2291         assign
     2292           v-field-group-handle = v-field-group-handle :next-sibling
     2293         .
     2294       end.
     2295       do with frame fr-config
     2296       :
     2297         hide v-diasize-resize-button .
     2298         assign
     2299           v-diasize-resize-button :row    = 1
     2300           v-diasize-resize-button :column = 1
     2301         .
     2302       end.
     2303       if p-change-value > 0
     2304       then do:
     2305         if frame fr-config :scrollable = true
     2306         then do:
     2307           assign
     2308             frame fr-config :virtual-height = frame fr-config :virtual-height + p-change-value
     2309             no-error .
     2310           if error-status :error
     2311           or error-status :get-message(1) <> ""
     2312           then do:
     2313             undo move_block, retry move_block .
     2314           end.
     2315         end.
     2316         assign
     2317           frame fr-config :height = frame fr-config :height + p-change-value
     2318           no-error .
     2319         if error-status :error
     2320         or error-status :get-message(1) <> ""
     2321         then do:
     2322           undo move_block, retry move_block .
     2323         end.
     2324         assign
     2325           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2326           no-error .
     2327         if error-status :error
     2328         or error-status :get-message(1) <> ""
     2329         then do:
     2330           undo move_block, retry move_block .
     2331         end.
     2332         for each buf_temp-browse-handle
     2333           where buf_temp-browse-handle.browse-type = 'height':u
     2334         on error undo move_block, retry move_block
     2335         :
     2336           assign
     2337             buf_temp-browse-handle.browse-handle :height
     2338               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2339             no-error .
     2340           if error-status :error
     2341           or error-status :get-message(1) <> ""
     2342           then do:
     2343             undo move_block, retry move_block .
     2344           end.
     2345         end.
     2346         for each buf_temp-diasize-handle
     2347         on error undo move_block, retry move_block
     2348         :
     2349           assign
     2350             v-object-handle = buf_temp-diasize-handle.handle-value
     2351           .
     2352           if v-object-handle <> v-diasize-resize-button
     2353           then do:
     2354             assign
     2355               v-object-handle :row = v-object-handle :row + p-change-value
     2356               no-error .
     2357             if error-status :error
     2358             or error-status :get-message(1) <> ""
     2359             then do:
     2360               undo move_block, retry move_block .
     2361             end.
     2362           end.
     2363         end.
     2364       end.
     2365       else do:
     2366         for each buf_temp-diasize-handle
     2367         on error undo move_block, retry move_block
     2368         :
     2369           assign
     2370             v-object-handle = buf_temp-diasize-handle.handle-value
     2371           .
     2372           if v-object-handle <> v-diasize-resize-button
     2373           then do:
     2374             assign
     2375               v-object-handle :row = v-object-handle :row + p-change-value
     2376               no-error .
     2377             if error-status :error
     2378             or error-status :get-message(1) <> ""
     2379             then do:
     2380               undo move_block, retry move_block .
     2381             end.
     2382           end.
     2383         end.
     2384         assign
     2385           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2386           no-error .
     2387         if error-status :error
     2388         or error-status :get-message(1) <> ""
     2389         then do:
     2390           undo move_block, retry move_block .
     2391         end.
     2392         for each buf_temp-browse-handle
     2393           where buf_temp-browse-handle.browse-type = 'height':u
     2394         on error undo move_block, retry move_block
     2395         :
     2396           assign
     2397             buf_temp-browse-handle.browse-handle :height
     2398               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2399             no-error .
     2400           if error-status :error
     2401           or error-status :get-message(1) <> ""
     2402           then do:
     2403             undo move_block, retry move_block .
     2404           end.
     2405         end.
     2406         assign
     2407           frame fr-config :height = frame fr-config :height + p-change-value
     2408           no-error .
     2409         if error-status :error
     2410         or error-status :get-message(1) <> ""
     2411         then do:
     2412           undo move_block, retry move_block .
     2413         end.
     2414         if frame fr-config :scrollable = true
     2415         then do:
     2416           assign
     2417             frame fr-config :virtual-height = frame fr-config :virtual-height + p-change-value
     2418             no-error .
     2419           if error-status :error
     2420           or error-status :get-message(1) <> ""
     2421           then do:
     2422             undo move_block, retry move_block .
     2423           end.
     2424         end.
     2425       end.
     2426       if p-move-resize = true
     2427       then do:
     2428         run diasize_position-resize-button in this-procedure .
     2429       end.
     2430       if v-diasize-wndstore = true
     2431       then do:
     2432         if connected("ub") = true
     2433         then do:
     2434           define variable v-cntxt-db-num        as integer   no-undo .
     2435           define variable v-cntxt-userid        as character no-undo .
     2436           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2437                                             , OUTPUT v-cntxt-userid
     2438                                             ) .
     2439           run gbl/wndsizew.p
     2440             (input  v-cntxt-db-num
     2441             ,input  v-cntxt-userid
     2442             ,input  v-diasize-proc-name
     2443             ,input  'height':u
     2444             ,input  string(frame fr-config :height - v-diasize-orig-frame-height)
     2445             ) .
     2446         end.
     2447       end.
     2448     end.
     2449     assign
     2450       v-diasize-change-size = false
     2451     .
     2452   end procedure.
     2453   procedure diasize_set-height :
     2454     define input  parameter p-new-height  as decimal   no-undo .
     2455     define input  parameter p-move-resize as logical   no-undo .
     2456     do
     2457     on error undo, return error return-value
     2458     :
     2459       run diasize_change-height in this-procedure
     2460         (input  (p-new-height - frame fr-config :height)
     2461         ,input  p-move-resize
     2462         ) .
     2463     end.
     2464   end procedure.
     2465   procedure diasize_change-width :
     2466     define input  parameter p-change-value as decimal   no-undo .
     2467     define input  parameter p-move-resize  as logical   no-undo .
     2468     define variable v-field-group-handle   as handle    no-undo .
     2469     define variable v-object-handle        as handle    no-undo .
     2470     define variable v-frame-width          as decimal   no-undo .
     2471     define variable v-frame-virtual-width  as decimal   no-undo .
     2472     define variable v-browse-width         as decimal   no-undo .
     2473     define variable v-window-width         as decimal   no-undo .
     2474     define variable v-window-virtual-width as decimal   no-undo .
     2475     define variable v-change-sign          as integer   no-undo .
     2476     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2477     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2478     if p-change-value > 0
     2479     then do:
     2480       if frame fr-config :width + p-change-value >
     2481           session :width-chars
     2482       then do:
     2483         assign
     2484           p-change-value = session :width-chars - frame fr-config :width
     2485         .
     2486         if p-change-value <= 0
     2487         then do:
     2488           run diasize_position-resize-button in this-procedure .
     2489           return .
     2490         end.
     2491       end.
     2492     end.
     2493     if p-change-value < 0
     2494     then do:
     2495       if frame fr-config :width + p-change-value < v-diasize-orig-frame-width
     2496       then do:
     2497         assign
     2498           p-change-value = v-diasize-orig-frame-width
     2499                          - frame fr-config :width
     2500         .
     2501         if p-change-value >= 0
     2502         then do:
     2503           run diasize_position-resize-button in this-procedure .
     2504           return .
     2505         end.
     2506       end.
     2507     end.
     2508     if p-change-value >= 0
     2509     then do:
     2510       assign
     2511         v-change-sign = 1
     2512       .
     2513     end.
     2514     else do:
     2515       assign
     2516         v-change-sign = -1
     2517       .
     2518     end.
     2519     assign
     2520       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2521     .
     2522     if p-change-value = 0
     2523     then do:
     2524       run diasize_position-resize-button in this-procedure .
     2525       return .
     2526     end.
     2527     move_block:
     2528     do
     2529     on error undo move_block, leave move_block
     2530     :
     2531       if retry
     2532       then do:
     2533         do
     2534         on error undo move_block, leave move_block
     2535         :
     2536           if p-change-value > 0
     2537           then do:
     2538             for each buf_temp-diasize-handle
     2539             on error undo, next
     2540             :
     2541               assign
     2542                 v-object-handle = buf_temp-diasize-handle.handle-value
     2543               .
     2544               if v-object-handle <> v-diasize-resize-button
     2545               then do:
     2546                 assign
     2547                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2548                 .
     2549               end.
     2550             end.
     2551             assign
     2552               v-diasize-browse-handle :width = v-browse-width
     2553             .
     2554             for each buf_temp-browse-handle
     2555               where buf_temp-browse-handle.browse-type = 'width':u
     2556             on error undo, next
     2557             :
     2558               assign
     2559                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2560               .
     2561             end.
     2562             assign
     2563               frame fr-config :width = v-frame-width
     2564             .
     2565             if frame fr-config :scrollable = true
     2566             then do:
     2567               assign
     2568                 frame fr-config :virtual-width = v-frame-virtual-width
     2569               .
     2570             end.
     2571             run diasize_position-resize-button in this-procedure .
     2572           end.
     2573           else do:
     2574             if frame fr-config :scrollable = true
     2575             then do:
     2576               assign
     2577                 frame fr-config :virtual-width = v-frame-virtual-width
     2578               .
     2579             end.
     2580             assign
     2581               frame fr-config :width = v-frame-width
     2582             .
     2583             for each buf_temp-browse-handle
     2584               where buf_temp-browse-handle.browse-type = 'width':u
     2585             on error undo, next
     2586             :
     2587               assign
     2588                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2589               .
     2590             end.
     2591             assign
     2592               v-diasize-browse-handle :width = v-browse-width
     2593             .
     2594             for each buf_temp-diasize-handle
     2595             on error undo, next
     2596             :
     2597               assign
     2598                 v-object-handle = buf_temp-diasize-handle.handle-value
     2599               .
     2600               if v-object-handle <> v-diasize-resize-button
     2601               then do:
     2602                 assign
     2603                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2604                 .
     2605               end.
     2606             end.
     2607             run diasize_position-resize-button in this-procedure .
     2608           end.
     2609           assign
     2610             v-diasize-change-size = false
     2611           .
     2612           leave move_block .
     2613         end.
     2614       end.
     2615       assign
     2616         v-diasize-need-full-display = true
     2617       .
     2618       if v-diasize-change-size = false
     2619       then do:
     2620         assign
     2621           v-diasize-change-size = true
     2622         .
     2623       end.
     2624       else do:
     2625         return .
     2626       end.
     2627       assign
     2628         v-frame-width = frame fr-config :width
     2629         v-frame-virtual-width = frame fr-config :virtual-width
     2630         v-browse-width = v-diasize-browse-handle :width
     2631       .
     2632       for each buf_temp-browse-handle
     2633         where buf_temp-browse-handle.browse-type = 'width':u
     2634       :
     2635         assign
     2636           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2637         .
     2638       end.
     2639       for each buf_temp-diasize-handle
     2640       :
     2641         delete buf_temp-diasize-handle .
     2642       end.
     2643       assign
     2644         v-field-group-handle = frame fr-config :first-child
     2645       .
     2646       do while valid-handle(v-field-group-handle)
     2647       :
     2648         assign
     2649           v-object-handle = v-field-group-handle :first-child
     2650         .
     2651         do while valid-handle(v-object-handle)
     2652         :
     2653           if  v-object-handle <> v-diasize-browse-handle :handle
     2654           and v-object-handle <> v-diasize-resize-button
     2655           and can-query(v-object-handle, "row")
     2656           and can-query(v-object-handle, "height")
     2657           and ( v-object-handle :col + v-object-handle :width
     2658                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2659               )
     2660           then do:
     2661             find first buf_temp-browse-handle
     2662               where buf_temp-browse-handle.browse-type   = 'width':u
     2663                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2664               no-error .
     2665             if available buf_temp-browse-handle
     2666             then do:
     2667             end.
     2668             else do:
     2669               create buf_temp-diasize-handle .
     2670               assign
     2671                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2672                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2673               .
     2674             end.
     2675           end.
     2676           assign
     2677             v-object-handle = v-object-handle :next-sibling
     2678           .
     2679         end.
     2680         assign
     2681           v-field-group-handle = v-field-group-handle :next-sibling
     2682         .
     2683       end.
     2684       do with frame fr-config
     2685       :
     2686         hide v-diasize-resize-button .
     2687         v-diasize-resize-button :row = 1.
     2688         v-diasize-resize-button :column = 1.
     2689       end.
     2690       if p-change-value > 0
     2691       then do:
     2692         if frame fr-config :scrollable = true
     2693         then do:
     2694           assign
     2695             frame fr-config :virtual-width = frame fr-config :virtual-width + p-change-value
     2696             no-error .
     2697           if error-status :error
     2698           or error-status :get-message(1) <> ""
     2699           then do:
     2700             undo move_block, retry move_block.
     2701           end.
     2702         end.
     2703         assign
     2704           frame fr-config :width = v-frame-width + p-change-value
     2705           no-error .
     2706         if error-status :error
     2707         or error-status :get-message(1) <> ""
     2708         then do:
     2709           undo move_block, retry move_block.
     2710         end.
     2711         assign
     2712           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2713         no-error .
     2714         if error-status :error
     2715         or error-status :get-message(1) <> ""
     2716         then do:
     2717           undo move_block, retry move_block.
     2718         end.
     2719         for each buf_temp-browse-handle
     2720           where buf_temp-browse-handle.browse-type = 'width':u
     2721         on error undo move_block, retry move_block
     2722         :
     2723           assign
     2724             buf_temp-browse-handle.browse-handle :width
     2725               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2726             no-error .
     2727           if error-status :error
     2728           or error-status :get-message(1) <> ""
     2729           then do:
     2730             undo move_block, retry move_block .
     2731           end.
     2732         end.
     2733         for each buf_temp-diasize-handle
     2734         on error undo move_block, retry move_block
     2735         :
     2736           assign
     2737             v-object-handle = buf_temp-diasize-handle.handle-value
     2738           .
     2739           if v-object-handle <> v-diasize-resize-button
     2740           then do:
     2741             assign
     2742               v-object-handle :col = v-object-handle :col + p-change-value
     2743               no-error .
     2744             if error-status :error
     2745             or error-status :get-message(1) <> ""
     2746             then do:
     2747               undo move_block, retry move_block .
     2748             end.
     2749           end.
     2750         end.
     2751       end.
     2752       else do:
     2753         for each buf_temp-diasize-handle
     2754         on error undo move_block, retry move_block
     2755         :
     2756           assign
     2757             v-object-handle = buf_temp-diasize-handle.handle-value
     2758           .
     2759           if v-object-handle <> v-diasize-resize-button
     2760           then do:
     2761             assign
     2762               v-object-handle :col = v-object-handle :col + p-change-value
     2763               no-error .
     2764             if error-status :error
     2765             or error-status :get-message(1) <> ""
     2766             then do:
     2767               undo move_block, retry move_block .
     2768             end.
     2769           end.
     2770         end.
     2771         for each buf_temp-browse-handle
     2772           where buf_temp-browse-handle.browse-type = 'width':u
     2773         on error undo move_block, retry move_block
     2774         :
     2775           assign
     2776             buf_temp-browse-handle.browse-handle :width
     2777               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2778             no-error .
     2779           if error-status :error
     2780           or error-status :get-message(1) <> ""
     2781           then do:
     2782             undo move_block, retry move_block .
     2783           end.
     2784         end.
     2785         assign
     2786           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2787           no-error .
     2788         if error-status :error
     2789         or error-status :get-message(1) <> ""
     2790         then do:
     2791           undo move_block, retry move_block.
     2792         end.
     2793         assign
     2794           frame fr-config :width = frame fr-config :width + p-change-value
     2795         no-error .
     2796         if error-status :error
     2797         or error-status :get-message(1) <> ""
     2798         then do:
     2799           undo move_block, retry move_block.
     2800         end.
     2801         if frame fr-config :scrollable = true
     2802         then do:
     2803           assign
     2804             frame fr-config :virtual-width = frame fr-config :virtual-width + p-change-value
     2805           no-error .
     2806           if error-status :error
     2807           or error-status :get-message(1) <> ""
     2808           then do:
     2809             undo move_block, retry move_block.
     2810           end.
     2811         end.
     2812       end.
     2813       if p-move-resize
     2814       then do:
     2815         run diasize_position-resize-button in this-procedure .
     2816       end.
     2817       if v-diasize-wndstore = true
     2818       then do:
     2819         if connected("ub") = true
     2820         then do:
     2821           define variable v-cntxt-db-num        as integer   no-undo .
     2822           define variable v-cntxt-userid        as character no-undo .
     2823           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2824                                             , OUTPUT v-cntxt-userid
     2825                                             ) .
     2826           run gbl/wndsizew.p
     2827             (input  v-cntxt-db-num
     2828             ,input  v-cntxt-userid
     2829             ,input  v-diasize-proc-name
     2830             ,input  'width':u
     2831             ,input  string(frame fr-config :width - v-diasize-orig-frame-width)
     2832             ) .
     2833         end.
     2834       end.
     2835     end.
     2836     assign
     2837       v-diasize-change-size = false
     2838     .
     2839   end procedure.
     2840   procedure diasize_set-width :
     2841     define input  parameter p-new-width  as decimal   no-undo .
     2842     define input  parameter p-move-resize as logical   no-undo .
     2843     do
     2844     on error undo, return error return-value
     2845     :
     2846       run diasize_change-width in this-procedure
     2847         (input  (p-new-width - frame fr-config :width)
     2848         ,input  p-move-resize
     2849         ) .
     2850     end.
     2851   end procedure.
     2852   procedure diasize_position-resize-button :
     2853     do with frame fr-config
     2854     :
     2855       hide v-diasize-resize-button .
     2856       assign
     2857         v-diasize-resize-button :row = frame fr-config :height - v-diasize-resize-button :height
     2858                     - 1
     2859                     - (frame fr-config :border-bottom-pixels / session :pixels-per-row)
     2860         v-diasize-resize-button :col = frame fr-config :width - v-diasize-resize-button :width
     2861                     - 1
     2862                     - (frame fr-config :border-right-pixels / session :pixels-per-column)
     2863       .
     2864       view v-diasize-resize-button .
     2865     end.
     2866   end procedure.
     2867   on alt-right anywhere
     2868   do:
     2869     run diasize_change-width in this-procedure
     2870       (input 1
     2871       ,input true
     2872       ) .
     2873     return no-apply .
     2874   end.
     2875   on alt-left anywhere
     2876   do:
     2877     run diasize_change-width in this-procedure
     2878       (input -1
     2879       ,input true
     2880       ) .
     2881     return no-apply .
     2882   end.
     2883   on alt-down anywhere
     2884   do:
     2885     run diasize_change-height in this-procedure
     2886       (input 1
     2887       ,input true
     2888       ) .
     2889     return no-apply .
     2890   end.
     2891   on alt-up anywhere
     2892   do:
     2893     run diasize_change-height in this-procedure
     2894       (input -1
     2895       ,input true
     2896       ) .
     2897     return no-apply .
     2898   end.
     2899   on alt-enter of frame fr-config
     2900   do:
     2901     run diasize_maximize in this-procedure
     2902       (input  ?
     2903       ).
     2904     return no-apply .
     2905   end.
     2906   procedure diasize_end-move :
     2907     do
     2908     on error undo, return error return-value
     2909     :
     2910       define variable v-row-delta as decimal   no-undo .
     2911       define variable v-col-delta as decimal   no-undo .
     2912       define variable v-new-row as decimal   no-undo .
     2913       define variable v-new-col as decimal   no-undo .
     2914       assign
     2915         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2916         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2917       .
     2918       assign
     2919         v-row-delta = v-new-row - frame fr-config :height
     2920         v-col-delta = v-new-col - frame fr-config :width
     2921       .
     2922       run diasize_change-height in this-procedure
     2923         (input v-row-delta
     2924         ,input true
     2925         ) .
     2926       run diasize_change-width in this-procedure
     2927         (input v-col-delta
     2928         ,input true
     2929         ) .
     2930     end.
     2931   end procedure.
     2932   procedure diasize_maximize :
     2933     define input  parameter p-action as logical   no-undo .
     2934     do
     2935     on error undo, return error return-value
     2936     :
     2937       if p-action = ?
     2938       then do:
     2939         if v-diasize-need-maximize = true
     2940         then do:
     2941           assign
     2942             p-action = true
     2943           .
     2944         end.
     2945         else do:
     2946           assign
     2947             p-action = false
     2948           .
     2949         end.
     2950       end.
     2951       if p-action = true
     2952       then do:
     2953         run diasize_change-height in this-procedure
     2954           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2955               - frame fr-config :height-chars
     2956           ,input true
     2957           ) .
     2958         run diasize_change-width in this-procedure
     2959           (input session :width-chars
     2960               - frame fr-config :width-chars
     2961           ,input true
     2962           ) .
     2963         assign
     2964           v-diasize-need-maximize = false
     2965         .
     2966       end.
     2967       else do:
     2968         run diasize_change-width in this-procedure
     2969           (input v-diasize-orig-frame-width
     2970               - frame fr-config :width-chars
     2971           ,input true
     2972           ) .
     2973         run diasize_change-height in this-procedure
     2974           (input v-diasize-orig-frame-height
     2975               - frame fr-config :height-chars
     2976           ,input true
     2977           ) .
     2978         assign
     2979           v-diasize-need-maximize = true
     2980         .
     2981       end.
     2982     end.
     2983   end procedure.
     2984   procedure diasize_restore-orig-size :
     2985     do
     2986     on error undo, return error return-value
     2987     :
     2988       assign
     2989         v-diasize-current-frame-width  = frame fr-config :width
     2990         v-diasize-current-frame-height = frame fr-config :height
     2991       .
     2992       run diasize_set-height in this-procedure
     2993         (input  v-diasize-orig-frame-height
     2994         ,input  true
     2995         ) .
     2996       run diasize_set-width in this-procedure
     2997         (input  v-diasize-orig-frame-width
     2998         ,input  true
     2999         ) .
     3000     end.
     3001   end procedure.
     3002   procedure diasize_restore-current-size :
     3003     do
     3004     on error undo, return error return-value
     3005     :
     3006       run diasize_set-height in this-procedure
     3007         (input  v-diasize-current-frame-height
     3008         ,input  true
     3009         ) .
     3010       run diasize_set-width in this-procedure
     3011         (input  v-diasize-current-frame-width
     3012         ,input  true
     3013         ) .
     3014     end.
     3015   end procedure.
     3016   procedure diasize_set-browse-handle :
     3017     define input  parameter p-browse-handle as handle   no-undo .
     3018     define buffer buf_temp-browse-handle for temp-browse-handle .
     3019     do
     3020     on error undo, return error return-value
     3021     :
     3022       assign
     3023         v-diasize-browse-handle = p-browse-handle
     3024       .
     3025       for each buf_temp-browse-handle
     3026       on error undo, return error return-value
     3027       :
     3028         delete buf_temp-browse-handle .
     3029       end.
     3030     end.
     3031   end procedure.
     3032   procedure diasize_add_browse :
     3033     define input  parameter p-browse-type   as character no-undo .
     3034     define input  parameter p-browse-handle as handle    no-undo .
     3035     define buffer buf_temp-browse-handle for temp-browse-handle .
     3036     do
     3037     on error undo, return error return-value
     3038     :
     3039       assign
     3040         v-diasize-browse-number = v-diasize-browse-number + 1
     3041       .
     3042       create buf_temp-browse-handle .
     3043       assign
     3044         buf_temp-browse-handle.browse-type   = p-browse-type
     3045         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3046         buf_temp-browse-handle.browse-handle = p-browse-handle
     3047       .
     3048     end.
     3049   end procedure.
     3050   procedure diasize_init :
     3051     define variable v-default-value    as logical   no-undo .
     3052     define variable v-restore-saved    as logical   no-undo .
     3053     define variable v-resize-value-str as character no-undo .
     3054     do
     3055     on error undo, return error return-value
     3056     :
     3057       do with frame fr-config
     3058       :
     3059         assign
     3060           v-diasize-orig-frame-height = frame fr-config :height
     3061           v-diasize-orig-frame-width  = frame fr-config :width
     3062           v-diasize-browse-handle     = browse br-config :handle
     3063         .
     3064         create button v-diasize-resize-button
     3065         assign
     3066           parent        = frame fr-config :first-child
     3067           label         = "s"
     3068           height-pixels = 16
     3069           width-pixels  = 16
     3070           visible       = true
     3071           sensitive     = true
     3072           movable       = true
     3073           triggers:
     3074             on end-move persistent run diasize_end-move in this-procedure .
     3075           end triggers.
     3076         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3077         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3078         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3079         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3080         assign
     3081           v-diasize-wndmax = false
     3082         .
     3083         if connected("ub") = true
     3084         then do:
     3085           define variable v-cntxt-db-num        as integer   no-undo .
     3086           define variable v-cntxt-userid        as character no-undo .
     3087           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3088                                             , OUTPUT v-cntxt-userid
     3089                                             ) .
     3090           run gbl/wndpar_r.p
     3091             (input  v-cntxt-db-num
     3092             ,input  v-cntxt-userid
     3093             ,input  'wndmax':U
     3094             ,output v-diasize-wndmax
     3095             ,output v-default-value
     3096             ) .
     3097         end.
     3098         assign
     3099           v-diasize-wndstore = false
     3100         .
     3101         if connected("ub") = true
     3102         then do:
     3103           run gbl/wndpar_r.p
     3104             (input  v-cntxt-db-num
     3105             ,input  v-cntxt-userid
     3106             ,input  'wndstore':U
     3107             ,output v-diasize-wndstore
     3108             ,output v-default-value
     3109             ) .
     3110         end.
     3111         assign
     3112           v-diasize-proc-name = entry(1, program-name(2), '.')
     3113         .
     3114         if v-diasize-wndstore = true
     3115         then do:
     3116           assign
     3117             v-restore-saved = false
     3118           .
     3119           if connected("ub") = true
     3120           then do:
     3121             run gbl/wndsizer.p
     3122               (input  v-cntxt-db-num
     3123               ,input  v-cntxt-userid
     3124               ,input  v-diasize-proc-name
     3125               ,input  'height':u
     3126               ,output v-resize-value-str
     3127               ) .
     3128             if v-resize-value-str <> '':U
     3129             then do:
     3130               run diasize_change-height in this-procedure
     3131                 (input  integer(v-resize-value-str)
     3132                 ,input  true
     3133                 ) .
     3134               assign
     3135                 v-restore-saved = true
     3136               .
     3137             end.
     3138           end.
     3139           if connected("ub") = true
     3140           then do:
     3141             run gbl/wndsizer.p
     3142               (input  v-cntxt-db-num
     3143               ,input  v-cntxt-userid
     3144               ,input  v-diasize-proc-name
     3145               ,input  'width':u
     3146               ,output v-resize-value-str
     3147               ) .
     3148             if v-resize-value-str <> '':U
     3149             then do:
     3150               run diasize_change-width in this-procedure
     3151                 (input  integer(v-resize-value-str)
     3152                 ,input  true
     3153                 ) .
     3154               assign
     3155                 v-restore-saved = true
     3156               .
     3157             end.
     3158           end.
     3159           if v-restore-saved <> true
     3160           then do:
     3161             if v-diasize-wndmax = true
     3162             then do:
     3163               run diasize_maximize in this-procedure
     3164                 (input  true
     3165                 ) .
     3166             end.
     3167           end.
     3168         end.
     3169         else do:
     3170           if v-diasize-wndmax = true
     3171           then do:
     3172             run diasize_maximize in this-procedure
     3173               (input  true
     3174               ) .
     3175           end.
     3176         end.
     3177       end.
     3178     end.
     3179   end procedure.
     3180   procedure diasize_need-full-display :
     3181     define output parameter p-need-full-display as logical   no-undo .
     3182     do
     3183     on error undo, return error return-value
     3184     :
     3185       assign
     3186         p-need-full-display = v-diasize-need-full-display
     3187       .
     3188       assign
     3189         v-diasize-need-full-display = false
     3190       .
     3191     end.
     3192   end procedure.
     3193   procedure get-context :
     3194      define output parameter p-db-num as integer          no-undo.
     3195      define output parameter p-user-id as character        no-undo.
     3196      define variable v-login               as character    no-undo.
     3197      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3198      define buffer buf_user-login  for ub.user-login .
     3199      do
     3200      on error undo, return error
     3201      :
     3202            FIND FIRST buf_sys-ctrl no-lock.
     3203            ASSIGN
     3204               v-login = USERID("ub")
     3205               p-db-num = buf_sys-ctrl.db-num
     3206            .
     3207            FIND FIRST buf_user-login
     3208                 WHERE buf_user-login.db-num = p-db-num
     3209                   AND buf_user-login.user-login = v-login
     3210                 no-lock
     3211                 no-error
     3212                 .
     3213            IF AVAILABLE buf_user-login
     3214            THEN DO:
     3215               assign
     3216                  p-user-id = buf_user-login.user-id
     3217               .
     3218            END.
     3219      end.
     3220   end procedure.
     3221       run diasize_init in this-procedure .
     3222   MAIN-BLOCK:
     3223   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3224      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3225     define variable par-type as character         no-undo .
     3226     define variable ErrExist as integer initial 0 no-undo.
     3227     define variable v-log    as logical           no-undo .
     3228       define buffer buf_sys-ctrl for ub.sys-ctrl .
     3229     run waitfram-show in this-procedure ("Чтение схемы конфигурации").
     3230     run init in cnf-hdl
     3231       ( input ""
     3232       , input no
     3233       , input no
     3234       ) no-error.
     3235     if error-status:error then do:
     3236       message
     3237         vss-workfile vss-revision vss-description skip
     3238         substitute( "Ошибка при старте init in cnf-hdl" ) skip
     3239         return-value skip
     3240         error-status :get-message ( error-status :num-messages )
     3241         view-as alert-box error
     3242       .
     3243       run waitfram-hide in this-procedure .
     3244       return error.
     3245     end.
     3246     if return-value <> "" then do:
     3247       assign
     3248         ErrExist = max(integer (return-value), ErrExist)
     3249       .
     3250     end.
     3251       run init in db-hdl
     3252         ( input cnf-hdl
     3253         ) no-error.
     3254       if error-status:error then do:
     3255         message
     3256           vss-workfile vss-revision vss-description skip
     3257           substitute( "Ошибка при старте init in db-hdl" ) skip
     3258           return-value skip
     3259           error-status :get-message ( error-status :num-messages )
     3260           view-as alert-box error
     3261         .
     3262         run waitfram-hide in this-procedure .
     3263         return error.
     3264       end.
     3265       if return-value <> "" then do:
     3266         assign
     3267           ErrExist = max(integer (return-value), ErrExist)
     3268         .
     3269       end.
     3270     run init in CurCnf-hdl
     3271       ( input cnf-hdl
     3272       , input db-hdl
     3273       ) no-error.
     3274     if error-status:error then do:
     3275       message
     3276         vss-workfile vss-revision vss-description skip
     3277         substitute( "Ошибка при старте init in CurCnf-hdl" ) skip
     3278         return-value skip
     3279         error-status :get-message ( error-status :num-messages )
     3280         view-as alert-box error
     3281       .
     3282       run waitfram-hide in this-procedure .
     3283       return error.
     3284     end.
     3285     if return-value <> "" then do:
     3286       assign
     3287         ErrExist = max(integer (return-value), ErrExist)
     3288       .
     3289     end.
     3290     run fill-cnf-struct in this-procedure
     3291       ( input "cmp/mold_db.sch"
     3292       ) no-error.
     3293     if error-status:error then do:
     3294       message
     3295         vss-workfile vss-revision vss-description skip
     3296         substitute( "Ошибка при старте fill-cnf-struct" ) skip
     3297         return-value skip
     3298         error-status :get-message ( error-status :num-messages )
     3299         view-as alert-box error
     3300       .
     3301       run waitfram-hide in this-procedure .
     3302       return error.
     3303     end.
     3304     if return-value <> "" then do:
     3305       assign
     3306         ErrExist = max(integer (return-value), ErrExist)
     3307       .
     3308     end.
     3309     find first buf_sys-ctrl no-lock .
     3310     find first buf-curr_db no-lock
     3311       where buf-curr_db.db-num = buf_sys-ctrl.db-num
     3312       no-error.
     3313     if not available buf-curr_db then do:
     3314       message
     3315         "Ошибка при чтении списка баз данных" skip
     3316         view-as alert-box error .
     3317       undo, return error .
     3318     end.
     3319     assign
     3320       v-title0 = substitute( "&1 (Текущая БД &2, ключ &3)", v-title0, buf-curr_db.db-num, buf-curr_db.db-key )
     3321     .
     3322     run LoadDB in db-hdl
     3323       no-error.
     3324     if error-status :error then do:
     3325       message
     3326         vss-workfile vss-revision vss-description skip
     3327         substitute("Ошибка при чтении параметров из БД") skip
     3328         error-status :get-message(1) skip
     3329         return-value skip
     3330         view-as alert-box error .
     3331       run waitfram-hide in this-procedure .
     3332       return error.
     3333     end.
     3334     if return-value <> "" then do:
     3335       assign
     3336         ErrExist = max(integer (return-value), ErrExist)
     3337       .
     3338     end.
     3339     run chk-unref in curcnf-hdl
     3340       ( input ?
     3341       , input ?
     3342       , input ?
     3343       , input false
     3344       ) no-error.
     3345     if error-status :error then do:
     3346       message
     3347         vss-workfile vss-revision vss-description skip
     3348         substitute("Ошибка при создании недостающих параметров") skip
     3349         error-status :get-message(1) skip
     3350         return-value skip
     3351         view-as alert-box error .
     3352       run waitfram-hide in this-procedure .
     3353       return error.
     3354     end.
     3355     run waitfram-hide in this-procedure .
     3356     if ErrExist > 0 then do:
     3357       message
     3358         substitute("При загрузке параметров были ошибки.") skip
     3359         substitute("Проверьте протокол работы.") skip
     3360         view-as alert-box error .
     3361     end.
     3362     run enable_UI in this-procedure .
     3363     apply "value-changed":u to r-find-in-br in frame fr-config .
     3364     run reopen-query in this-procedure
     3365       ( input true
     3366       , input false
     3367       , input '':U
     3368       ) .
     3369     assign
     3370       Cnf.Param-Name:resizable in browse br-config = true
     3371       Cnf.Param-Name:width in browse br-config = 30
     3372       Cnf.Param-Value:resizable in browse br-config  = true
     3373       Cnf.Param-Value:width in browse br-config = 30
     3374     .
     3375     run toggle-mes in cnf-hdl
     3376       ( input true
     3377       ).
     3378       assign
     3379         b-save:sensitive in frame fr-config = true
     3380       .
     3381     wait-for go of frame fr-config.
     3382   end.
     3383   run disable_UI in this-procedure .
     3384   run kill in cnf-hdl.
     3385   run kill in curcnf-hdl.
     3386     run kill in db-hdl.
     3387   for each cnf
     3388   :
     3389     delete cnf .
     3390   end.
     3391   for each cnf-struct
     3392   :
     3393     delete cnf-struct .
     3394   end.
     3395   PROCEDURE chg-param :
     3396     define input parameter p-rid         as integer   no-undo .
     3397     define input parameter p-turn-on-off as logical   no-undo .
     3398     chg-block:
     3399     do transaction
     3400     on error  undo chg-block, return error substitute( "&1 (chg-param). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3401     on stop   undo chg-block, return error substitute( "&1 (chg-param). stop", vss-workfile )
     3402     on endkey undo chg-block, return error substitute( "&1 (chg-param). endkey", vss-workfile )
     3403     :
     3404       define buffer buf_cnf      for cnf .
     3405       define buffer buf-chg_cnf  for cnf .
     3406       define buffer buf-all_cnf  for cnf .
     3407       define buffer buf-next_cnf for cnf .
     3408       define variable v-log           as logical   no-undo .
     3409       define variable v-chg-db-num    as logical   no-undo .
     3410       define variable v-chg-key       as logical   no-undo .
     3411       define variable v-old-db-num    as integer   no-undo .
     3412       define variable v-old-db-key    as character no-undo .
     3413       find first buf_cnf
     3414         where recid( buf_cnf ) = p-rid
     3415         no-error .
     3416       if not available buf_cnf then do:
     3417         return .
     3418       end.
     3419       if p-turn-on-off = true
     3420         and buf_cnf.NotUsed = false
     3421       then do:
     3422         assign
     3423           buf_cnf.NotUsed = true
     3424         .
     3425       end.
     3426       else do:
     3427         if buf_cnf.db-num = ? then do:
     3428           create buf-chg_cnf .
     3429           buffer-copy buf_cnf to buf-chg_cnf .
     3430           assign
     3431             p-rid = recid( buf-chg_cnf )
     3432           .
     3433         end.
     3434         else do:
     3435           find first buf-chg_cnf
     3436             where recid( buf-chg_cnf ) = p-rid
     3437             .
     3438         end.
     3439         for each tt_cnf
     3440         :
     3441           delete tt_cnf .
     3442         end.
     3443         create tt_cnf .
     3444         buffer-copy buf-chg_cnf to tt_cnf .
     3445         assign
     3446           v-old-db-num = buf-chg_cnf.db-num
     3447           v-old-db-key = buf-chg_cnf.db-key
     3448         .
     3449           run adm/cnfi.w (parparentproc, curcnf-hdl, db-hdl, cnf-hdl, "edit":U, input-output p-rid).
     3450         buffer-compare tt_cnf except is-changed to buf-chg_cnf save result in v-log .
     3451         if tt_cnf.host-code = 0
     3452           and tt_cnf.obj-type = "":U
     3453           and tt_cnf.obj-code = 0
     3454           and tt_cnf.beg-date = 01/01/1900
     3455           and tt_cnf.end-date = 01/01/9999
     3456           and ( tt_cnf.host-code <> buf-chg_cnf.host-code
     3457                 or tt_cnf.obj-type <> buf-chg_cnf.obj-type
     3458                 or tt_cnf.obj-code <> buf-chg_cnf.obj-code
     3459                 or tt_cnf.beg-date <> buf-chg_cnf.beg-date
     3460                 or tt_cnf.end-date <> buf-chg_cnf.end-date
     3461                 or tt_cnf.db-num   <> buf-chg_cnf.db-num
     3462               )
     3463         then do:
     3464           create buf_cnf .
     3465           buffer-copy tt_cnf to buf_cnf .
     3466         end.
     3467         for each tt_cnf
     3468         :
     3469           delete tt_cnf .
     3470         end.
     3471         if p-rid = ?
     3472           or ( p-rid <> ?
     3473                and p-rid > 0
     3474                and v-log = true
     3475              )
     3476         then do:
     3477           undo chg-block, return .
     3478         end.
     3479         if p-rid = -1
     3480           and available buf-chg_cnf
     3481         then do:
     3482           delete buf-chg_cnf.
     3483         end.
     3484         if available buf-chg_cnf then do:
     3485           run chk-param in curcnf-hdl
     3486             ( buffer buf-chg_cnf
     3487             ).
     3488           assign
     3489             buf-chg_cnf.errorexist = 0
     3490             buf-chg_cnf.is-changed = true
     3491           .
     3492         end.
     3493       end.
     3494     end.
     3495     if available buf-chg_cnf then do:
     3496       assign
     3497         v-cnf-rec = recid( buf-chg_cnf )
     3498       .
     3499     end.
     3500     run reopen-query in this-procedure
     3501       ( input true
     3502       , input false
     3503       , input '':U
     3504       ) .
     3505     reposition br-config to recid v-cnf-rec no-error .
     3506     assign
     3507       v-cnf-rec = ?
     3508     .
     3509     return.
     3510   END PROCEDURE.
     3511   PROCEDURE chk-param :
     3512     define parameter buffer b-cnf for cnf.
     3513   END PROCEDURE.
     3514   PROCEDURE disable_UI :
     3515     HIDE FRAME fr-config.
     3516   END PROCEDURE.
     3517   PROCEDURE enable_UI :
     3518     DISPLAY r-show-cnf r-cnf-encoded r-cnf-db r-find-in-br sch-param f-param-name
     3519         WITH FRAME fr-config.
     3520     ENABLE b-exit b-mark b-lkp b-chg b-Tgle b-Exp b-Imp b-Log b-sch b-hist b-help
     3521            r-show-cnf r-cnf-encoded r-cnf-db r-find-in-br sch-param br-config
     3522            f-param-name
     3523         WITH FRAME fr-config.
     3524   END PROCEDURE.
     3525   PROCEDURE find-param :
     3526     define input  parameter p-find-next as logical   no-undo .
     3527     define input  parameter p-sch-type  as character no-undo .
     3528     define input  parameter p-sch-code  as character no-undo .
     3529     define variable v-add-where as character no-undo .
     3530     assign
     3531       p-sch-code = replace( p-sch-code, chr(39), chr(39) + chr(39) )
     3532     .
     3533     case p-sch-type :
     3534       when "param-code":U then do:
     3535         assign
     3536           v-add-where = substitute("and cnf.param-code begins &1&2&1", chr(34), p-sch-code)
     3537         .
     3538       end.
     3539       when "param-name":U then do:
     3540         assign
     3541           v-add-where = substitute("and cnf.param-name contains &1&2&1", chr(34), p-sch-code)
     3542         .
     3543       end.
     3544       when "param-vale":U then do:
     3545         assign
     3546           v-add-where = substitute("and cnf.param-name contains &1&2&1", chr(34), p-sch-code)
     3547         .
     3548       end.
     3549     end case.
     3550     run reopen-query in this-procedure
     3551       ( input false
     3552       , input p-find-next
     3553       , input v-add-where
     3554       ) .
     3555     apply "entry":u to sch-param in frame fr-config .
     3556   END PROCEDURE.
     3557   PROCEDURE proc-b-sch :
     3558   assign
     3559     tbl = substitute( "temp-handle#cnf#&1", buffer cnf:handle ) + chr(44) + substitute( "temp-handle#cnf-struct#&1", buffer cnf-struct:handle )
     3560     join-tbl = 'cnf,cnf-struct':U
     3561     fld = ""
     3562     lab = ""
     3563     spr = ""
     3564     dim = '0'
     3565     .
     3566   run fltfield-add in this-procedure('NotUsed'    , '', ''    , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3567   run fltfield-add in this-procedure('Is-Changed' , '', ''    , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3568   run fltfield-add in this-procedure('param-code' , '', ''    , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3569   run fltfield-add in this-procedure('param-name' , '', ''    , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3570   run fltfield-add in this-procedure('db-num'     , '', 'db'  , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3571   run fltfield-add in this-procedure('host-code'  , '', 'cli' , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3572   run fltfield-add in this-procedure ('obj-type*obj-code', 'Объект', 'cli',
     3573                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3574   run fltfield-add in this-procedure('beg-date'   , '', 'date', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3575   run fltfield-add in this-procedure('end-date'   , '', 'date', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3576   run fltfield-add in this-procedure('param-value', '', ''    , input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3577   assign
     3578     dim = dim + chr(44)
     3579   .
     3580   run fltfield-add in this-procedure('list-value', 'Возможные значения', '',
     3581                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3582   run fltfield-add in this-procedure('default-value', 'Значение по умолчанию', '',
     3583                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3584   Filter-Block:
     3585   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3586       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3587       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3588     run gbl/filter.w ( INPUT parparentproc, INPUT v-filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3589     run reopen-query in this-procedure
     3590       ( input true
     3591       , input false
     3592       , input '':U
     3593       ) .
     3594   END.
     3595   END PROCEDURE.
     3596   PROCEDURE reopen-query :
     3597     define input  parameter p-open-query     as logical   no-undo .
     3598     define input  parameter p-find-next      as logical   no-undo .
     3599     define input  parameter p-find-condition as character no-undo .
     3600     define variable l-query-was-opened   as logical   no-undo .
     3601     define variable v-sort-column-phrase as character no-undo .
     3602     run waitfram-show in this-procedure ( input "Ждите...").
     3603     case v-sort-column-name :
     3604       when "" then do:
     3605         assign
     3606           v-sort-column-phrase = "":U
     3607         .
     3608       end.
     3609       otherwise do:
     3610         assign
     3611           v-sort-column-phrase = substitute( "by &1", v-sort-column-name )
     3612         .
     3613       end.
     3614     end case.
     3615     assign
     3616       v-filter-point = v-filter-point0 + chr(4) + v-filter-pointr
     3617       frame fr-config:title = substitute( "&1", v-title0 )
     3618     .
     3619     case r-show-cnf :
     3620       when "all":U then do:
     3621   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3622   define variable  l-disable-where-19  as logical   no-undo .
     3623   define variable  l-filter-open-19    as logical   .
     3624   define variable  flt-rec-19       as recid     no-undo .
     3625   define variable  filter-name-19      as character no-undo .
     3626   define variable  where-phrase-19     as character no-undo .
     3627   define variable  sort-phrase-19      as character no-undo .
     3628   define variable  where-phrase-rus-19 as character no-undo .
     3629   define variable  sort-phrase-rus-19  as character no-undo .
     3630     run waitfram-show in this-procedure
     3631       (input "ЖДИТЕ ..."
     3632       ).
     3633   run gbl/flt-get.p
     3634     (input v-filter-point
     3635     ,output flt-rec-19
     3636     ,output filter-name-19
     3637     ,output where-phrase-19
     3638     ,output sort-phrase-19
     3639     ,output where-phrase-rus-19
     3640     ,output sort-phrase-rus-19
     3641     ).
     3642   if p-open-query then do:
     3643       run set-filter-name in this-procedure
     3644         (INPUT filter-name-19
     3645         ) no-error .
     3646     assign
     3647       l-filter-open-19 = false
     3648     .
     3649     if flt-rec-19 <> ?
     3650       or v-sort-column-phrase > ""
     3651     then do:
     3652       define variable  parameter-2-19 as character no-undo .
     3653       define variable  parameter-3-19 as character no-undo .
     3654       define variable  parameter-4-19 as character no-undo .
     3655       define variable  parameter-5-19 as character no-undo .
     3656       define variable  parameter-6-19 as character no-undo .
     3657       define variable  parameter-7-19 as character no-undo .
     3658         assign
     3659         parameter-3-19 =
     3660                                 "FOR EACH cnf"
     3661         parameter-4-19 =
     3662           (
     3663             if ("                            ( r-cnf-encoded = 'all':U                              or ( t-cnf-type-k = true      and cnf.conf-type = 'к':U )                              or ( t-cnf-type-s = true      and cnf.conf-type = 'п':U )                              or ( t-cnf-type-o = true      and cnf.conf-type = 'о':U )                              or ( t-cnf-type-notenc = true and cnf.conf-type = '':U       )                            )                            and
     3664                              ( r-cnf-db = 'all':U                              or ( r-cnf-db <> 'all':U and cnf.db-num = f-db-num )                            )                           " + " " + where-phrase-19) <> ""
     3665             then substitute( '( &2                                               or ( &3 and cnf.conf-type = &1к&1 )                                               or ( &4 and cnf.conf-type = &1п&1 )                                               or ( &5 and cnf.conf-type = &1о&1 )                                               or ( &6 and cnf.conf-type = &1&1   )                                             )                                         and                                          (  &1&7&1                                            or ( not &7 and cnf.db-num = &1&8&1 )                                          )'                                         ,chr(34)                                         ,r-cnf-encoded = 'all':U                                         ,t-cnf-type-k = true                                         ,t-cnf-type-s = true                                         ,t-cnf-type-o = true                                         ,t-cnf-type-notenc = true                                         ,r-cnf-db ='all':U                                         ,f-db-num                                      )                            + " " + where-phrase-19
     3666             else "true"
     3667           )
     3668         parameter-5-19 = (" " + "" + " " + substitute(', first cnf-struct no-lock where cnf-struct.param-code = cnf.param-code' ))
     3669         parameter-6-19 = if sort-phrase-19 = ''
     3670                              then
     3671           (
     3672           " " + " " +
     3673             " " + v-sort-column-phrase +
     3674           " " + " "
     3675           )
     3676                              else
     3677           (
     3678           " " + " " +
     3679             " " + v-sort-column-phrase +
     3680           " " + sort-phrase-19
     3681           )
     3682         parameter-7-19 =
     3683           " indexed-reposition  "
     3684       .
     3685       do
     3686       on stop undo, leave
     3687       on error undo, leave
     3688       :
     3689         assign
     3690           l-disable-where-19 =
     3691             ("                            ( r-cnf-encoded = 'all':U                              or ( t-cnf-type-k = true      and cnf.conf-type = 'к':U )                              or ( t-cnf-type-s = true      and cnf.conf-type = 'п':U )                              or ( t-cnf-type-o = true      and cnf.conf-type = 'о':U )                              or ( t-cnf-type-notenc = true and cnf.conf-type = '':U       )                            )                            and
     3692                              ( r-cnf-db = 'all':U                              or ( r-cnf-db <> 'all':U and cnf.db-num = f-db-num )                            )                           " + " " + where-phrase-19 = "")
     3693         .
     3694         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3695                             ,input query br-config :handle
     3696                             ,input parameter-3-19
     3697                             ,input parameter-4-19
     3698                             ,input parameter-5-19
     3699                             ,input parameter-6-19
     3700                             ,input parameter-7-19
     3701                             )
     3702         .
     3703         assign
     3704           l-filter-open-19 = true
     3705         .
     3706       end.
     3707       if l-filter-open-19 = false then do:
     3708         message
     3709           "Ошибка при фильтрации / сортировке" skip
     3710           "Будут показаны записи без учета фильтра" skip
     3711           view-as alert-box .
     3712       end.
     3713       else do:
     3714           assign
     3715             l-query-was-opened = true
     3716           .
     3717       end.
     3718     end.
