      366   procedure thbjattr_code_reg :
      367   define input  parameter p-upper-code     as character no-undo .
      368   define input  parameter p-code           as character no-undo .
      369   define output parameter p-label          as character no-undo .
      370   define output parameter p-user-can-edit  as logical   no-undo .
      371   define output parameter p-output-display as logical   no-undo .
      372   define output parameter p-other          as character no-undo .
      373   define output parameter p-prop-list      as character no-undo .
      374   define output parameter p-prop-type-list as character no-undo .
      375   define output parameter p-prop-label-list as character no-undo .
      376   define output parameter p-global          as logical no-undo .
      377   define output parameter p-host           as logical no-undo .
      378   define output parameter p-shop           as logical no-undo .
      379   define output parameter p-store          as logical no-undo .
      380   define output parameter p-db             as logical no-undo .
      381   define output parameter p-region         as logical no-undo .
      382   do
      383   on error undo, return error return-value
      384   :
      385       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      386       (input  p-upper-code
      387       ,input  p-code
      388       ,output p-label
      389       ,output p-user-can-edit
      390       ,output p-output-display
      391       ,output p-other
      392       ,output p-prop-list
      393       ,output p-prop-type-list
      394       ,output p-prop-label-list
      395       ,output p-global
      396       ,output p-host
      397       ,output p-shop
      398       ,output p-store
      399       ,output p-db
      400       ,output p-region
      401       ) no-error .
      402     if error-status :error
      403     then do:
      404       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      405     end.
      406   end.
      407   end procedure.
