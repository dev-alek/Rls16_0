      618   procedure proc-alt-shift-f2:
      619     if not ibs.th.gbl.gbl-var:rcode
      620   then
      621     run gbl\inidebug.p .
      622   end.
      623   procedure proc-alt-shift-f3:
      624     run gbl/prvssinf.p
      625       ( input this-procedure
      626       ) .
      627   end.
      628   define variable v-inform-launched as logical no-undo initial false .
      629   procedure proc-alt-shift-f4:
      630     define variable v-action as character no-undo .
      631     if v-inform-launched = false then do:
      632       assign
      633         v-inform-launched = true
      634       .
      635       run gbl/d-inform.w
      636         (  input self
      637         ,  input this-procedure
      638         , output v-action
      639         ) no-error .
      640       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      641       assign
      642         v-inform-launched = false
      643       .
      644     end.
      645   end.
      646   procedure proc-alt-f1:
      647     run gbl/corrhelp.p
      648       (input this-procedure
      649       ) .
      650   end .
      651   on alt-shift-f2 anywhere do:
      652     run proc-alt-shift-f2.
      653   end.
      654   on alt-shift-f3 anywhere do:
      655     run proc-alt-shift-f3 in this-procedure .
      656   end.
      657   on alt-shift-f4 anywhere do:
      658     run proc-alt-shift-f4 in this-procedure.
      659   end.
      660   on alt-f1 anywhere do:
      661     run proc-alt-f1 in this-procedure .
      662   end.
      663   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664     define variable v-cntxt-db-num        as integer   no-undo .
      665     define variable v-cntxt-userid        as character no-undo .
      666     define variable v-cntxt-level         as character no-undo .
      667     define variable v-cntxt-host-code-obj as integer   no-undo .
      668     define variable v-cntxt-obj-type      as character no-undo .
      669     define variable v-cntxt-obj-code      as integer   no-undo .
      670     define variable v-cntxt-db-num-obj    as integer   no-undo .
      671     define variable v-cntxt-is-admin      as logical   no-undo .
      672   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      673   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      674   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      675   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      676   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
      677   DEFINE VARIABLE v-r-b-code LIKE ub.currency.curr-code NO-UNDO.
      678   DEFINE BUFFER buf_currency FOR ub.currency.
      679   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      680   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      681   define variable v-tth as handle no-undo .
      682   assign
      683   v-tth = buffer thbjattr_thbj-attr:table-handle .
      684   DEFINE BUTTON B-add  NO-FOCUS
      685        LABEL "&Добавить"
      686        SIZE 10 BY 1.
      687   DEFINE BUTTON b-cash-pay
      688        IMAGE-UP FILE "btn-down-arrow":U
      689        IMAGE-DOWN FILE "btn-down-arrow":U
      690        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      691        LABEL "":L
      692        SIZE 3 BY 1
      693        BGCOLOR 8 FGCOLOR 0 .
      694   DEFINE BUTTON b-curr
      695        IMAGE-UP FILE "btn-down-arrow":U
      696        IMAGE-DOWN FILE "btn-down-arrow":U
      697        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      698        LABEL "":L
      699        SIZE 3 BY 1
      700        BGCOLOR 8 FGCOLOR 0 .
      701   DEFINE BUTTON b-curr-base
      702        IMAGE-UP FILE "btn-down-arrow":U
      703        IMAGE-DOWN FILE "btn-down-arrow":U
      704        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      705        LABEL "":L
      706        SIZE 3 BY 1
      707        BGCOLOR 8 FGCOLOR 0 .
      708   DEFINE BUTTON B-del
      709        LABEL "&Удалить"
      710        SIZE 10 BY 1.
      711   DEFINE BUTTON B-exit AUTO-GO
      712        LABEL "&Ввод"
      713        SIZE 10 BY 1
      714        BGCOLOR 8 .
      715   DEFINE BUTTON B-Help
      716        LABEL "Помо&щь"
      717        SIZE 3 BY 1
      718        BGCOLOR 8 .
      719   DEFINE BUTTON b-quit AUTO-END-KEY
      720        LABEL "&Отмена"
      721        SIZE 10 BY 1
      722        BGCOLOR 8 .
      723   DEFINE VARIABLE f-ipcsbasc AS INTEGER FORMAT ">>9":U INITIAL 0
      724        LABEL "Код валюты, соответствующий баз. вал. КАССЫ"
      725        VIEW-AS FILL-IN
      726        SIZE 7 BY 1 NO-UNDO.
      727   DEFINE VARIABLE f-ipcsdobc AS INTEGER FORMAT ">>9":U INITIAL 0
      728        LABEL "Код дополнительной валюты для прейскурантов на кассе"
      729        VIEW-AS FILL-IN
      730        SIZE 7 BY 1 NO-UNDO.
      731   DEFINE VARIABLE f-ipcspayn AS INTEGER FORMAT ">>>9":U INITIAL 0
      732        LABEL "с кодом валюты равным коду баз. валюты НА КАССЕ"
      733         VIEW-AS TEXT
      734        SIZE 7 BY .67 NO-UNDO.
      735   DEFINE VARIABLE for-cash-pay-name AS CHARACTER FORMAT "X(256)":U
      736         VIEW-AS TEXT
      737        SIZE 20.5 BY .67
      738        FGCOLOR 4  NO-UNDO.
      739   DEFINE VARIABLE for-curr-name AS CHARACTER FORMAT "X(256)":U
      740         VIEW-AS TEXT
      741        SIZE 13 BY .67
      742        FGCOLOR 4  NO-UNDO.
      743   DEFINE VARIABLE for-curr-name-base AS CHARACTER FORMAT "X(256)":U
      744         VIEW-AS TEXT
      745        SIZE 6.8 BY .67
      746        FGCOLOR 4  NO-UNDO.
      747   DEFINE VARIABLE l-ipcpgpfx AS CHARACTER FORMAT "X(256)":U INITIAL "Префикс штучного бар-кода для весов:"
      748         VIEW-AS TEXT
      749        SIZE 35 BY .67 NO-UNDO.
      750   DEFINE VARIABLE l-ipcscpfx AS CHARACTER FORMAT "X(256)":U INITIAL "Префикс весового бар-кода:"
      751         VIEW-AS TEXT
      752        SIZE 26 BY .67 NO-UNDO.
      753   DEFINE VARIABLE l-ipcspayn AS CHARACTER FORMAT "X(256)":U INITIAL "Тип кассового платежа, соответствующий оплате <НАЛИЧНЫЕ> НА КАССЕ"
      754         VIEW-AS TEXT
      755        SIZE 65 BY .67 NO-UNDO.
      756   DEFINE VARIABLE RS-ipcpgpfx AS INTEGER
      757        VIEW-AS RADIO-SET HORIZONTAL
      758        RADIO-BUTTONS
      759             "24", 24,
      760   "28", 28
      761        SIZE 15 BY 1 NO-UNDO.
      762   DEFINE VARIABLE RS-ipcscpfx AS INTEGER
      763        VIEW-AS RADIO-SET HORIZONTAL
      764        RADIO-BUTTONS
      765             "21", 21,
      766   "23", 23,
      767   "25", 25
      768        SIZE 20.5 BY 1 NO-UNDO.
      769   DEFINE QUERY BR-cash-pay FOR
      770         tt-cash-pay-ipcs SCROLLING.
      771   DEFINE BROWSE BR-cash-pay
      772     QUERY BR-cash-pay NO-LOCK DISPLAY
      773         ipcs-pay-code COLUMN-LABEL "Код оплаты!по карте!на кассе" FORMAT ">>>>9":U
      774         tt-cash-pay-ipcs.cdpay-code COLUMN-LABEL "Тип кассового!платежа (в BO)" FORMAT ">>>9":U
      775         tt-cash-pay-ipcs.curr-code COLUMN-LABEL "Код!валюты" FORMAT ">>9":U
      776         tt-cash-pay-ipcs.obj-name COLUMN-LABEL "Название типа кассового платежа" FORMAT "X(40)":U
      777               WIDTH 56.8
      778       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.27
      779            TITLE "Соответствие кодов оплат по платежным картам  на кассе типам кассовых платежей" FIT-LAST-COLUMN.
      780   DEFINE FRAME Dialog-Frame
      781        B-add AT ROW 10.27 COL 1
      782        B-exit AT ROW 1 COL 1
      783        b-quit AT ROW 1 COL 11
      784        B-Help AT ROW 1 COL 95
      785        f-ipcsbasc AT ROW 2.5 COL 65 COLON-ALIGNED
      786        b-curr-base AT ROW 2.5 COL 75
      787        b-cash-pay AT ROW 4.77 COL 70.5
      788        f-ipcsdobc AT ROW 6.5 COL 61 COLON-ALIGNED
      789        b-curr AT ROW 6.5 COL 71
      790        RS-ipcscpfx AT ROW 9 COL 28 NO-LABEL
      791        RS-ipcpgpfx AT ROW 9 COL 84 NO-LABEL WIDGET-ID 2
      792        B-del AT ROW 10.27 COL 11
      793        BR-cash-pay AT ROW 11.27 COL 1
      794        for-curr-name-base AT ROW 2.77 COL 77 COLON-ALIGNED NO-LABEL
      795        l-ipcspayn AT ROW 4 COL 2 NO-LABEL
      796        f-ipcspayn AT ROW 4.93 COL 61 COLON-ALIGNED
      797        for-cash-pay-name AT ROW 4.93 COL 73.5 COLON-ALIGNED NO-LABEL
      798        for-curr-name AT ROW 6.77 COL 74 COLON-ALIGNED NO-LABEL
      799        l-ipcscpfx AT ROW 9.27 COL 1 NO-LABEL
      800        l-ipcpgpfx AT ROW 9.27 COL 48 NO-LABEL WIDGET-ID 6
      801        "(если не используется - введите ?)" VIEW-AS TEXT
      802             SIZE 52 BY .77 AT ROW 7.5 COL 9.5
      803             FGCOLOR 4
      804        SPACE(37.74) SKIP(11.05)
      805       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      806            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      807            TITLE "Параметры POS IPC-servis+"
      808            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      809   ASSIGN
      810          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      811          FRAME Dialog-Frame:HIDDEN           = TRUE.
      812   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      813   DO:
      814     APPLY "END-ERROR":U TO SELF.
      815   END.
      816   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      817   DO:
      818     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      819     DEFINE VARIABLE v-log AS logical NO-UNDO.
      820     DEFINE variable v-rid AS RECID NO-UNDO.
      821     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      822     DEFINE BUFFER buf_tt-cash-pay-ipcs FOR tt-cash-pay-ipcs.
      823     DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      824       run gbl/d-prompt.w (
      825         'title=':u + "Добавить код оплаты по платежной карте НА КАССЕ" + '\':u
      826       + 'format=' + ">>>>9" + '\':u
      827       + 'type=' + 'I':U + '\':u
      828       + 'fillin_row=2\':u
      829       + 'fillin_col=4\':u
      830       + 'fillin_width=7\':u
      831       + 'fillin_height=1\':u
      832       + 'max-chars=5\':u
      833       + 'readonly=no\':u
      834       , input-output v-value
      835       ).
      836       if return-value = 'false':u then return NO-apply.
      837   FIND FIRST buf_tt-cash-pay-ipcs NO-LOCK WHERE
      838             buf_tt-cash-pay-ipcs.ipcs-pay-code = INTEGER(v-value) NO-ERROR.
      839   IF AVAILABLE buf_tt-cash-pay-ipcs THEN DO:
      840        MESSAGE
      841           "Вы уже задали соответствие для код оплаты" v-value
      842           VIEW-AS ALERT-BOX.
      843           RETURN NO-APPLY.
      844   END.
      845   run ref/cashpays.w (
      846                  input parparentproc
      847                 ,input  "b-sel":U
      848                 ,input 'все':U
      849                 ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      850                 ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      851                 ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      852                 ,OUTPUT v-rid-list) NO-ERROR.
      853   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
      854   FIND FIRST buf_cash-pay NO-LOCK WHERE
      855           RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
      856   IF NOT AVAILABLE buf_cash-pay  THEN RETURN NO-APPLY.
      857   CREATE tt-cash-pay-ipcs.
      858   BUFFER-COPY buf_cash-pay
      859      TO tt-cash-pay-ipcs
      860      ASSIGN
      861      tt-cash-pay-ipcs.ipcs-pay-code = integer(v-value)
      862      v-rid = RECID(tt-cash-pay-ipcs)
      863      .
      864      RUN openbr IN THIS-PROCEDURE.
      865      REPOSITION br-cash-pay TO RECID v-rid.
      866   END.
      867   ON CHOOSE OF b-cash-pay IN FRAME Dialog-Frame
      868   DO:
      869       define variable v-rid-list as character no-undo.
      870       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      871       run ref/cashpays.w (
      872                      input parparentproc
      873                     ,input "b-sel"
      874                     ,input 'все':U
      875                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      876                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      877                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      878                     ,output v-rid-list ).
      879       if v-rid-list <> "":U then do:
      880         FIND FIRST buf_cash-pay WHERE
      881                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      882         IF buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      883             MESSAGE
      884             substitute("Нужно выбрать тип кассового платежа с валютой &1 - валюта продажи на фирме &2", buf_currency.curr-code, v-host-code)
      885             VIEW-AS ALERT-BOX ERROR.
      886             RETURN NO-APPLY.
      887         END.
      888         DISPLAY
      889         buf_cash-pay.cdpay-code @ f-ipcspayn
      890         buf_cash-pay.obj-name @ for-cash-pay-name
      891         with frame Dialog-Frame .
      892       end.
      893   END.
      894   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
      895   DO:
      896       define variable rr as recid no-undo.
      897       DEFINE BUFFER buf_currency FOR ub.currency.
      898       rr = ? .
      899       run ref/currency.w (input parparentproc, "b-sel", input-output rr ).
      900       if rr <> ? then do:
      901         FIND FIRST buf_currency WHERE
      902                   recid( buf_currency ) = rr NO-LOCK .
      903         DISPLAY
      904         buf_currency.curr-code @ f-ipcsdobc
      905         buf_currency.curr-abbr @ for-curr-name
      906         with frame Dialog-Frame .
      907       end.
      908   END.
      909   ON CHOOSE OF b-curr-base IN FRAME Dialog-Frame
      910   DO:
      911       define variable rr as recid no-undo.
      912       DEFINE BUFFER buf_currency FOR ub.currency.
      913       rr = ? .
      914       run ref/currency.w (input parparentproc, "b-sel", input-output rr ).
      915       if rr <> ? then do:
      916         FIND FIRST buf_currency WHERE
      917                   recid( buf_currency ) = rr NO-LOCK .
      918         DISPLAY
      919         buf_currency.curr-code @ f-ipcsbasc
      920         buf_currency.curr-abbr @ for-curr-name-base
      921         with frame Dialog-Frame .
      922       end.
      923   END.
      924   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      925   DO:
      926     IF NOT AVAILABLE tt-cash-pay-ipcs THEN RETURN NO-APPLY.
      927     DELETE tt-cash-pay-ipcs.
      928     RUN openbr IN THIS-PROCEDURE.
      929     REPOSITION br-cash-pay TO ROW 1.
      930   END.
      931   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      932   DO:
      933     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      934     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      935   END.
      936   ON LEAVE OF f-ipcsdobc IN FRAME Dialog-Frame
      937   DO:
      938       DEFINE BUFFER buf_currency FOR ub.currency.
      939       FIND FIRST buf_currency NO-LOCK WHERE
      940               buf_currency.curr-code = INPUT FRAME Dialog-Frame f-ipcsdobc NO-ERROR.
      941     IF AVAIL buf_currency THEN DO:
      942       DISPLAY
      943       buf_currency.curr-abbr @ for-curr-name
      944       WITH FRAME Dialog-Frame.
      945     END.
      946     ELSE DO:
      947       IF INPUT FRAME Dialog-Frame f-ipcsdobc = ? THEN DO:
      948       DISPLAY
      949       "Не задан" @ for-curr-name
      950       WITH FRAME Dialog-Frame.
      951       END.
      952       ELSE RETURN NO-APPLY.
      953     END.
      954   END.
      955   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      956   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      957   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   on help of frame Dialog-Frame
      959   do:
      960     run gbl/app_help.p
      961       (input this-procedure :file-name
      962       ,input ''
      963       ,input ?
      964       ) no-error.
      965     if error-status :error then do:
      966       message
      967         "Ошибка при вызове помощи"
      968         error-status :get-message(1)
      969         view-as alert-box .
      970     end.
      971   end.
      972   run minbtn-set in this-procedure .
      973   on choose of b-help in frame Dialog-Frame
      974   do:
      975     apply "help":u to frame Dialog-Frame .
      976   end.
      977   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   procedure minbtn-set :
      979       do
      980           on error undo, return error return-value
      981           :
      982           define variable ii              as integer       no-undo .
      983           define variable fh              as widget-handle no-undo .
      984           define variable hh              as widget-handle no-undo .
      985           define variable v-h             as handle        extent 4 no-undo .
      986           define variable v-name-button   as character     no-undo .
      987           define variable v-help-old-x    as decimal       no-undo .
      988           define variable v-help-old-y    as decimal       no-undo .
      989           define variable v-help-old-size as decimal       no-undo .
      990           define variable v-frame-width   as decimal       no-undo .
      991           define variable jj              as integer       no-undo .
      992           do
      993               on error undo, return error
      994               :
      995               assign
      996                   v-frame-width = frame Dialog-Frame:width - 0.3
      997                   fh            = frame Dialog-Frame:first-child
      998                   hh            = fh:first-child
      999                   ii            = 1
     1000                   .
     1001               do while valid-handle(hh):
     1002                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1003                   do:
     1004                       case lc(hh:name) :
     1005                           when "b-help" then
     1006                               do:
     1007                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1008                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1009                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1010                                   hh:TOOLTIP = "Помощь" .
     1011                                   v-help-old-x = hh:column .
     1012                                   v-help-old-y = hh:row    .
     1013                                   v-help-old-size = hh:width .
     1014                                   hh:width-chars = 2.5 .
     1015                               end.
     1016                           when "b-print" then
     1017                               do:
     1018                                   hh:load-image("cmp/b-print.bmp":u) .
     1019                                   hh:TOOLTIP = "Печать" .
     1020                                   v-h[ii] = hh:handle .
     1021                                   ii = ii + 1 .
     1022                                   hh:width-chars = 3 .
     1023                               end.
     1024                           when "b-history" or
     1025                           when "b-hist" then
     1026                               do:
     1027                                   hh:load-image("cmp/b-hist.bmp":u) .
     1028                                   hh:TOOLTIP = "История" .
     1029                                   v-h[ii] = hh:handle .
     1030                                   ii = ii + 1 .
     1031                                   hh:width-chars = 3 .
     1032                               end.
     1033                           when "b-sch" then
     1034                               do:
     1035                                   hh:load-image("cmp/b-sch.bmp":u) .
     1036                                   hh:TOOLTIP = "Установка Фильтра" .
     1037                                   v-h[ii] = hh:handle .
     1038                                   ii = ii + 1 .
     1039                                   hh:width-chars = 3 .
     1040                               end.
     1041                           when "b-hist-user" then
     1042                               do:
     1043                                   hh:load-image("cmp/b-hist.bmp":u) .
     1044                                   hh:TOOLTIP = "История пользователя" .
     1045                                   ii = ii + 1 .
     1046                               end.
     1047                       end case.
     1048                   end.
     1049                   hh = hh:next-sibling.
     1050               end.
     1051               b-help:column = v-frame-width - b-help:width-chars.
     1052               jj = 0.
     1053               repeat ii = 4 to 1 by -1 :
     1054                   if valid-handle (v-h[ii] ) then
     1055                   do:
     1056                       jj  = jj + 1 .
     1057                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1058                       v-h[ii]:row    = v-help-old-y .
     1059                   end.
     1060               end.
     1061           end.
     1062       end.
     1063   end procedure.
     1064   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1065   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1066   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1067   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1068   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1069   define variable v-diasize-current-frame-height as decimal   no-undo .
     1070   define variable v-diasize-change-size          as logical   no-undo .
     1071   define variable v-diasize-resize-button        as handle    no-undo .
     1072   define variable v-diasize-wndmax               as logical   no-undo .
     1073   define variable v-diasize-wndstore             as logical   no-undo .
     1074   define variable v-diasize-proc-name            as character no-undo .
     1075   define variable v-diasize-browse-handle        as handle    no-undo .
     1076   define variable v-diasize-browse-number        as integer   no-undo .
     1077   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1078   define temp-table temp-diasize-handle no-undo
     1079     field handle-value  as handle
     1080     field save-position as decimal
     1081     index xpk is primary unique handle-value
     1082     .
     1083   define temp-table temp-browse-handle no-undo
     1084     field browse-type   as character
     1085     field browse-number as integer
     1086     field browse-handle as handle
     1087     field original-size as decimal
     1088     index xpk is primary unique browse-type browse-number
     1089     index xie browse-type browse-handle
     1090   .
     1091   procedure diasize_change-height :
     1092     define input  parameter p-change-value  as decimal   no-undo .
     1093     define input  parameter p-move-resize   as logical   no-undo .
     1094     define variable v-field-group-handle    as handle    no-undo .
     1095     define variable v-object-handle         as handle    no-undo .
     1096     define variable v-frame-height          as decimal   no-undo .
     1097     define variable v-frame-virtual-height  as decimal   no-undo .
     1098     define variable v-browse-height         as decimal   no-undo .
     1099     define variable v-window-height         as decimal   no-undo .
     1100     define variable v-window-virtual-height as decimal   no-undo .
     1101     define variable v-change-sign           as integer   no-undo .
     1102     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1103     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1104     if p-change-value > 0
     1105     then do:
     1106       if frame Dialog-Frame :height + p-change-value
     1107           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1108       then do:
     1109         assign
     1110           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1111                           - (frame Dialog-Frame :height-chars)
     1112         .
     1113         if p-change-value <= 0
     1114         then do:
     1115           run diasize_position-resize-button in this-procedure .
     1116           return .
     1117         end.
     1118       end.
     1119     end.
     1120     if p-change-value < 0
     1121     then do:
     1122       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1123       then do:
     1124         assign
     1125           p-change-value = v-diasize-orig-frame-height
     1126                          - (frame Dialog-Frame :height-chars)
     1127         .
     1128         if p-change-value >= 0
     1129         then do:
     1130           run diasize_position-resize-button in this-procedure .
     1131           return .
     1132         end.
     1133       end.
     1134     end.
     1135     if p-change-value >= 0
     1136     then do:
     1137       assign
     1138         v-change-sign = 1
     1139       .
     1140     end.
     1141     else do:
     1142       assign
     1143         v-change-sign = -1
     1144       .
     1145     end.
     1146     assign
     1147       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1148     .
     1149     if p-change-value = 0
     1150     then do:
     1151       run diasize_position-resize-button in this-procedure .
     1152       return .
     1153     end.
     1154     move_block:
     1155     do
     1156     on error undo move_block, retry move_block
     1157     :
     1158       if retry
     1159       then do:
     1160         do
     1161         on error undo move_block, leave move_block
     1162         :
     1163           if p-change-value > 0
     1164           then do:
     1165             for each buf_temp-diasize-handle
     1166             on error undo, next
     1167             :
     1168               assign
     1169                 v-object-handle = buf_temp-diasize-handle.handle-value
     1170               .
     1171               if v-object-handle <> v-diasize-resize-button
     1172               then do:
     1173                 assign
     1174                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1175                 .
     1176               end.
     1177             end.
     1178             assign
     1179               v-diasize-browse-handle :height = v-browse-height
     1180             .
     1181             for each buf_temp-browse-handle
     1182               where buf_temp-browse-handle.browse-type = 'height':u
     1183             on error undo, next
     1184             :
     1185               assign
     1186                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1187               .
     1188             end.
     1189             assign
     1190               frame Dialog-Frame :height = v-frame-height
     1191             .
     1192             if frame Dialog-Frame :scrollable = true
     1193             then do:
     1194               assign
     1195                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1196               .
     1197             end.
     1198             run diasize_position-resize-button in this-procedure .
     1199           end.
     1200           else do:
     1201             if frame Dialog-Frame :scrollable = true
     1202             then do:
     1203               assign
     1204                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1205               .
     1206             end.
     1207             assign
     1208               frame Dialog-Frame :height = v-frame-height
     1209             .
     1210             assign
     1211               v-diasize-browse-handle :height = v-browse-height
     1212             .
     1213             for each buf_temp-browse-handle
     1214               where buf_temp-browse-handle.browse-type = 'height':u
     1215             on error undo, next
     1216             :
     1217               assign
     1218                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1219               .
     1220             end.
     1221             for each buf_temp-diasize-handle
     1222             on error undo, next
     1223             :
     1224               assign
     1225                 v-object-handle = buf_temp-diasize-handle.handle-value
     1226               .
     1227               if v-object-handle <> v-diasize-resize-button
     1228               then do:
     1229                 assign
     1230                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1231                 .
     1232               end.
     1233             end.
     1234             run diasize_position-resize-button in this-procedure .
     1235           end.
     1236           assign
     1237             v-diasize-change-size = false
     1238           .
     1239           leave move_block .
     1240         end.
     1241       end.
     1242       assign
     1243         v-diasize-need-full-display = true
     1244       .
     1245       if v-diasize-change-size = false
     1246       then do:
     1247         assign
     1248           v-diasize-change-size = true
     1249         .
     1250       end.
     1251       else do:
     1252         return .
     1253       end.
     1254       assign
     1255         v-frame-height = frame Dialog-Frame :height
     1256         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1257         v-browse-height = v-diasize-browse-handle :height
     1258       .
     1259       for each buf_temp-browse-handle
     1260         where buf_temp-browse-handle.browse-type = 'height':u
     1261       :
     1262         assign
     1263           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1264         .
     1265       end.
     1266       for each buf_temp-diasize-handle
     1267       :
     1268         delete buf_temp-diasize-handle .
     1269       end.
     1270       assign
     1271         v-field-group-handle = frame Dialog-Frame :first-child
     1272       .
     1273       do while valid-handle(v-field-group-handle)
     1274       :
     1275         assign
     1276           v-object-handle = v-field-group-handle :first-child
     1277         .
     1278         do while valid-handle(v-object-handle)
     1279         :
     1280           if  v-object-handle <> v-diasize-browse-handle :handle
     1281           and can-query(v-object-handle, "row")
     1282           and can-query(v-object-handle, "height")
     1283           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1284           then do:
     1285             find first buf_temp-browse-handle
     1286               where buf_temp-browse-handle.browse-type   = 'height':u
     1287                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1288               no-error .
     1289             if available buf_temp-browse-handle
     1290             then do:
     1291             end.
     1292             else do:
     1293               create buf_temp-diasize-handle .
     1294               assign
     1295                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1296                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1297               .
     1298             end.
     1299           end.
     1300           assign
     1301             v-object-handle = v-object-handle :next-sibling
     1302           .
     1303         end.
     1304         assign
     1305           v-field-group-handle = v-field-group-handle :next-sibling
     1306         .
     1307       end.
     1308       do with frame Dialog-Frame
     1309       :
     1310         hide v-diasize-resize-button .
     1311         assign
     1312           v-diasize-resize-button :row    = 1
     1313           v-diasize-resize-button :column = 1
     1314         .
     1315       end.
     1316       if p-change-value > 0
     1317       then do:
     1318         if frame Dialog-Frame :scrollable = true
     1319         then do:
     1320           assign
     1321             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1322             no-error .
     1323           if error-status :error
     1324           or error-status :get-message(1) <> ""
     1325           then do:
     1326             undo move_block, retry move_block .
     1327           end.
     1328         end.
     1329         assign
     1330           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1331           no-error .
     1332         if error-status :error
     1333         or error-status :get-message(1) <> ""
     1334         then do:
     1335           undo move_block, retry move_block .
     1336         end.
     1337         assign
     1338           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1339           no-error .
     1340         if error-status :error
     1341         or error-status :get-message(1) <> ""
     1342         then do:
     1343           undo move_block, retry move_block .
     1344         end.
     1345         for each buf_temp-browse-handle
     1346           where buf_temp-browse-handle.browse-type = 'height':u
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             buf_temp-browse-handle.browse-handle :height
     1351               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1352             no-error .
     1353           if error-status :error
     1354           or error-status :get-message(1) <> ""
     1355           then do:
     1356             undo move_block, retry move_block .
     1357           end.
     1358         end.
     1359         for each buf_temp-diasize-handle
     1360         on error undo move_block, retry move_block
     1361         :
     1362           assign
     1363             v-object-handle = buf_temp-diasize-handle.handle-value
     1364           .
     1365           if v-object-handle <> v-diasize-resize-button
     1366           then do:
     1367             assign
     1368               v-object-handle :row = v-object-handle :row + p-change-value
     1369               no-error .
     1370             if error-status :error
     1371             or error-status :get-message(1) <> ""
     1372             then do:
     1373               undo move_block, retry move_block .
     1374             end.
     1375           end.
     1376         end.
     1377       end.
     1378       else do:
     1379         for each buf_temp-diasize-handle
     1380         on error undo move_block, retry move_block
     1381         :
     1382           assign
     1383             v-object-handle = buf_temp-diasize-handle.handle-value
     1384           .
     1385           if v-object-handle <> v-diasize-resize-button
     1386           then do:
     1387             assign
     1388               v-object-handle :row = v-object-handle :row + p-change-value
     1389               no-error .
     1390             if error-status :error
     1391             or error-status :get-message(1) <> ""
     1392             then do:
     1393               undo move_block, retry move_block .
     1394             end.
     1395           end.
     1396         end.
     1397         assign
     1398           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1399           no-error .
     1400         if error-status :error
     1401         or error-status :get-message(1) <> ""
     1402         then do:
     1403           undo move_block, retry move_block .
     1404         end.
     1405         for each buf_temp-browse-handle
     1406           where buf_temp-browse-handle.browse-type = 'height':u
     1407         on error undo move_block, retry move_block
     1408         :
     1409           assign
     1410             buf_temp-browse-handle.browse-handle :height
     1411               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1412             no-error .
     1413           if error-status :error
     1414           or error-status :get-message(1) <> ""
     1415           then do:
     1416             undo move_block, retry move_block .
     1417           end.
     1418         end.
     1419         assign
     1420           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1421           no-error .
     1422         if error-status :error
     1423         or error-status :get-message(1) <> ""
     1424         then do:
     1425           undo move_block, retry move_block .
     1426         end.
     1427         if frame Dialog-Frame :scrollable = true
     1428         then do:
     1429           assign
     1430             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1431             no-error .
     1432           if error-status :error
     1433           or error-status :get-message(1) <> ""
     1434           then do:
     1435             undo move_block, retry move_block .
     1436           end.
     1437         end.
     1438       end.
     1439       if p-move-resize = true
     1440       then do:
     1441         run diasize_position-resize-button in this-procedure .
     1442       end.
     1443       if v-diasize-wndstore = true
     1444       then do:
     1445         if connected("ub") = true
     1446         then do:
     1447           define variable v-cntxt-db-num        as integer   no-undo .
     1448           define variable v-cntxt-userid        as character no-undo .
     1449           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1450                                             , OUTPUT v-cntxt-userid
     1451                                             ) .
     1452           run gbl/wndsizew.p
     1453             (input  v-cntxt-db-num
     1454             ,input  v-cntxt-userid
     1455             ,input  v-diasize-proc-name
     1456             ,input  'height':u
     1457             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1458             ) .
     1459         end.
     1460       end.
     1461     end.
     1462     assign
     1463       v-diasize-change-size = false
     1464     .
     1465   end procedure.
     1466   procedure diasize_set-height :
     1467     define input  parameter p-new-height  as decimal   no-undo .
     1468     define input  parameter p-move-resize as logical   no-undo .
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472       run diasize_change-height in this-procedure
     1473         (input  (p-new-height - frame Dialog-Frame :height)
     1474         ,input  p-move-resize
     1475         ) .
     1476     end.
     1477   end procedure.
     1478   procedure diasize_change-width :
     1479     define input  parameter p-change-value as decimal   no-undo .
     1480     define input  parameter p-move-resize  as logical   no-undo .
     1481     define variable v-field-group-handle   as handle    no-undo .
     1482     define variable v-object-handle        as handle    no-undo .
     1483     define variable v-frame-width          as decimal   no-undo .
     1484     define variable v-frame-virtual-width  as decimal   no-undo .
     1485     define variable v-browse-width         as decimal   no-undo .
     1486     define variable v-window-width         as decimal   no-undo .
     1487     define variable v-window-virtual-width as decimal   no-undo .
     1488     define variable v-change-sign          as integer   no-undo .
     1489     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1490     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1491     if p-change-value > 0
     1492     then do:
     1493       if frame Dialog-Frame :width + p-change-value >
     1494           session :width-chars
     1495       then do:
     1496         assign
     1497           p-change-value = session :width-chars - frame Dialog-Frame :width
     1498         .
     1499         if p-change-value <= 0
     1500         then do:
     1501           run diasize_position-resize-button in this-procedure .
     1502           return .
     1503         end.
     1504       end.
     1505     end.
     1506     if p-change-value < 0
     1507     then do:
     1508       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1509       then do:
     1510         assign
     1511           p-change-value = v-diasize-orig-frame-width
     1512                          - frame Dialog-Frame :width
     1513         .
     1514         if p-change-value >= 0
     1515         then do:
     1516           run diasize_position-resize-button in this-procedure .
     1517           return .
     1518         end.
     1519       end.
     1520     end.
     1521     if p-change-value >= 0
     1522     then do:
     1523       assign
     1524         v-change-sign = 1
     1525       .
     1526     end.
     1527     else do:
     1528       assign
     1529         v-change-sign = -1
     1530       .
     1531     end.
     1532     assign
     1533       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1534     .
     1535     if p-change-value = 0
     1536     then do:
     1537       run diasize_position-resize-button in this-procedure .
     1538       return .
     1539     end.
     1540     move_block:
     1541     do
     1542     on error undo move_block, leave move_block
     1543     :
     1544       if retry
     1545       then do:
     1546         do
     1547         on error undo move_block, leave move_block
     1548         :
     1549           if p-change-value > 0
     1550           then do:
     1551             for each buf_temp-diasize-handle
     1552             on error undo, next
     1553             :
     1554               assign
     1555                 v-object-handle = buf_temp-diasize-handle.handle-value
     1556               .
     1557               if v-object-handle <> v-diasize-resize-button
     1558               then do:
     1559                 assign
     1560                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1561                 .
     1562               end.
     1563             end.
     1564             assign
     1565               v-diasize-browse-handle :width = v-browse-width
     1566             .
     1567             for each buf_temp-browse-handle
     1568               where buf_temp-browse-handle.browse-type = 'width':u
     1569             on error undo, next
     1570             :
     1571               assign
     1572                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1573               .
     1574             end.
     1575             assign
     1576               frame Dialog-Frame :width = v-frame-width
     1577             .
     1578             if frame Dialog-Frame :scrollable = true
     1579             then do:
     1580               assign
     1581                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1582               .
     1583             end.
     1584             run diasize_position-resize-button in this-procedure .
     1585           end.
     1586           else do:
     1587             if frame Dialog-Frame :scrollable = true
     1588             then do:
     1589               assign
     1590                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1591               .
     1592             end.
     1593             assign
     1594               frame Dialog-Frame :width = v-frame-width
     1595             .
     1596             for each buf_temp-browse-handle
     1597               where buf_temp-browse-handle.browse-type = 'width':u
     1598             on error undo, next
     1599             :
     1600               assign
     1601                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1602               .
     1603             end.
     1604             assign
     1605               v-diasize-browse-handle :width = v-browse-width
     1606             .
     1607             for each buf_temp-diasize-handle
     1608             on error undo, next
     1609             :
     1610               assign
     1611                 v-object-handle = buf_temp-diasize-handle.handle-value
     1612               .
     1613               if v-object-handle <> v-diasize-resize-button
     1614               then do:
     1615                 assign
     1616                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1617                 .
     1618               end.
     1619             end.
     1620             run diasize_position-resize-button in this-procedure .
     1621           end.
     1622           assign
     1623             v-diasize-change-size = false
     1624           .
     1625           leave move_block .
     1626         end.
     1627       end.
     1628       assign
     1629         v-diasize-need-full-display = true
     1630       .
     1631       if v-diasize-change-size = false
     1632       then do:
     1633         assign
     1634           v-diasize-change-size = true
     1635         .
     1636       end.
     1637       else do:
     1638         return .
     1639       end.
     1640       assign
     1641         v-frame-width = frame Dialog-Frame :width
     1642         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1643         v-browse-width = v-diasize-browse-handle :width
     1644       .
     1645       for each buf_temp-browse-handle
     1646         where buf_temp-browse-handle.browse-type = 'width':u
     1647       :
     1648         assign
     1649           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1650         .
     1651       end.
     1652       for each buf_temp-diasize-handle
     1653       :
     1654         delete buf_temp-diasize-handle .
     1655       end.
     1656       assign
     1657         v-field-group-handle = frame Dialog-Frame :first-child
     1658       .
     1659       do while valid-handle(v-field-group-handle)
     1660       :
     1661         assign
     1662           v-object-handle = v-field-group-handle :first-child
     1663         .
     1664         do while valid-handle(v-object-handle)
     1665         :
     1666           if  v-object-handle <> v-diasize-browse-handle :handle
     1667           and v-object-handle <> v-diasize-resize-button
     1668           and can-query(v-object-handle, "row")
     1669           and can-query(v-object-handle, "height")
     1670           and ( v-object-handle :col + v-object-handle :width
     1671                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1672               )
     1673           then do:
     1674             find first buf_temp-browse-handle
     1675               where buf_temp-browse-handle.browse-type   = 'width':u
     1676                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1677               no-error .
     1678             if available buf_temp-browse-handle
     1679             then do:
     1680             end.
     1681             else do:
     1682               create buf_temp-diasize-handle .
     1683               assign
     1684                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1685                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1686               .
     1687             end.
     1688           end.
     1689           assign
     1690             v-object-handle = v-object-handle :next-sibling
     1691           .
     1692         end.
     1693         assign
     1694           v-field-group-handle = v-field-group-handle :next-sibling
     1695         .
     1696       end.
     1697       do with frame Dialog-Frame
     1698       :
     1699         hide v-diasize-resize-button .
     1700         v-diasize-resize-button :row = 1.
     1701         v-diasize-resize-button :column = 1.
     1702       end.
     1703       if p-change-value > 0
     1704       then do:
     1705         if frame Dialog-Frame :scrollable = true
     1706         then do:
     1707           assign
     1708             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1709             no-error .
     1710           if error-status :error
     1711           or error-status :get-message(1) <> ""
     1712           then do:
     1713             undo move_block, retry move_block.
     1714           end.
     1715         end.
     1716         assign
     1717           frame Dialog-Frame :width = v-frame-width + p-change-value
     1718           no-error .
     1719         if error-status :error
     1720         or error-status :get-message(1) <> ""
     1721         then do:
     1722           undo move_block, retry move_block.
     1723         end.
     1724         assign
     1725           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1726         no-error .
     1727         if error-status :error
     1728         or error-status :get-message(1) <> ""
     1729         then do:
     1730           undo move_block, retry move_block.
     1731         end.
     1732         for each buf_temp-browse-handle
     1733           where buf_temp-browse-handle.browse-type = 'width':u
     1734         on error undo move_block, retry move_block
     1735         :
     1736           assign
     1737             buf_temp-browse-handle.browse-handle :width
     1738               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1739             no-error .
     1740           if error-status :error
     1741           or error-status :get-message(1) <> ""
     1742           then do:
     1743             undo move_block, retry move_block .
     1744           end.
     1745         end.
     1746         for each buf_temp-diasize-handle
     1747         on error undo move_block, retry move_block
     1748         :
     1749           assign
     1750             v-object-handle = buf_temp-diasize-handle.handle-value
     1751           .
     1752           if v-object-handle <> v-diasize-resize-button
     1753           then do:
     1754             assign
     1755               v-object-handle :col = v-object-handle :col + p-change-value
     1756               no-error .
     1757             if error-status :error
     1758             or error-status :get-message(1) <> ""
     1759             then do:
     1760               undo move_block, retry move_block .
     1761             end.
     1762           end.
     1763         end.
     1764       end.
     1765       else do:
     1766         for each buf_temp-diasize-handle
     1767         on error undo move_block, retry move_block
     1768         :
     1769           assign
     1770             v-object-handle = buf_temp-diasize-handle.handle-value
     1771           .
     1772           if v-object-handle <> v-diasize-resize-button
     1773           then do:
     1774             assign
     1775               v-object-handle :col = v-object-handle :col + p-change-value
     1776               no-error .
     1777             if error-status :error
     1778             or error-status :get-message(1) <> ""
     1779             then do:
     1780               undo move_block, retry move_block .
     1781             end.
     1782           end.
     1783         end.
     1784         for each buf_temp-browse-handle
     1785           where buf_temp-browse-handle.browse-type = 'width':u
     1786         on error undo move_block, retry move_block
     1787         :
     1788           assign
     1789             buf_temp-browse-handle.browse-handle :width
     1790               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1791             no-error .
     1792           if error-status :error
     1793           or error-status :get-message(1) <> ""
     1794           then do:
     1795             undo move_block, retry move_block .
     1796           end.
     1797         end.
     1798         assign
     1799           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1800           no-error .
     1801         if error-status :error
     1802         or error-status :get-message(1) <> ""
     1803         then do:
     1804           undo move_block, retry move_block.
     1805         end.
     1806         assign
     1807           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1808         no-error .
     1809         if error-status :error
     1810         or error-status :get-message(1) <> ""
     1811         then do:
     1812           undo move_block, retry move_block.
     1813         end.
     1814         if frame Dialog-Frame :scrollable = true
     1815         then do:
     1816           assign
     1817             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1818           no-error .
     1819           if error-status :error
     1820           or error-status :get-message(1) <> ""
     1821           then do:
     1822             undo move_block, retry move_block.
     1823           end.
     1824         end.
     1825       end.
     1826       if p-move-resize
     1827       then do:
     1828         run diasize_position-resize-button in this-procedure .
     1829       end.
     1830       if v-diasize-wndstore = true
     1831       then do:
     1832         if connected("ub") = true
     1833         then do:
     1834           define variable v-cntxt-db-num        as integer   no-undo .
     1835           define variable v-cntxt-userid        as character no-undo .
     1836           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1837                                             , OUTPUT v-cntxt-userid
     1838                                             ) .
     1839           run gbl/wndsizew.p
     1840             (input  v-cntxt-db-num
     1841             ,input  v-cntxt-userid
     1842             ,input  v-diasize-proc-name
     1843             ,input  'width':u
     1844             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1845             ) .
     1846         end.
     1847       end.
     1848     end.
     1849     assign
     1850       v-diasize-change-size = false
     1851     .
     1852   end procedure.
     1853   procedure diasize_set-width :
     1854     define input  parameter p-new-width  as decimal   no-undo .
     1855     define input  parameter p-move-resize as logical   no-undo .
     1856     do
     1857     on error undo, return error return-value
     1858     :
     1859       run diasize_change-width in this-procedure
     1860         (input  (p-new-width - frame Dialog-Frame :width)
     1861         ,input  p-move-resize
     1862         ) .
     1863     end.
     1864   end procedure.
     1865   procedure diasize_position-resize-button :
     1866     do with frame Dialog-Frame
     1867     :
     1868       hide v-diasize-resize-button .
     1869       assign
     1870         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1871                     - 1
     1872                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1873         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1874                     - 1
     1875                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1876       .
     1877       view v-diasize-resize-button .
     1878     end.
     1879   end procedure.
     1880   on alt-right anywhere
     1881   do:
     1882     run diasize_change-width in this-procedure
     1883       (input 1
     1884       ,input true
     1885       ) .
     1886     return no-apply .
     1887   end.
     1888   on alt-left anywhere
     1889   do:
     1890     run diasize_change-width in this-procedure
     1891       (input -1
     1892       ,input true
     1893       ) .
     1894     return no-apply .
     1895   end.
     1896   on alt-down anywhere
     1897   do:
     1898     run diasize_change-height in this-procedure
     1899       (input 1
     1900       ,input true
     1901       ) .
     1902     return no-apply .
     1903   end.
     1904   on alt-up anywhere
     1905   do:
     1906     run diasize_change-height in this-procedure
     1907       (input -1
     1908       ,input true
     1909       ) .
     1910     return no-apply .
     1911   end.
     1912   on alt-enter of frame Dialog-Frame
     1913   do:
     1914     run diasize_maximize in this-procedure
     1915       (input  ?
     1916       ).
     1917     return no-apply .
     1918   end.
     1919   procedure diasize_end-move :
     1920     do
     1921     on error undo, return error return-value
     1922     :
     1923       define variable v-row-delta as decimal   no-undo .
     1924       define variable v-col-delta as decimal   no-undo .
     1925       define variable v-new-row as decimal   no-undo .
     1926       define variable v-new-col as decimal   no-undo .
     1927       assign
     1928         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1929         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1930       .
     1931       assign
     1932         v-row-delta = v-new-row - frame Dialog-Frame :height
     1933         v-col-delta = v-new-col - frame Dialog-Frame :width
     1934       .
     1935       run diasize_change-height in this-procedure
     1936         (input v-row-delta
     1937         ,input true
     1938         ) .
     1939       run diasize_change-width in this-procedure
     1940         (input v-col-delta
     1941         ,input true
     1942         ) .
     1943     end.
     1944   end procedure.
     1945   procedure diasize_maximize :
     1946     define input  parameter p-action as logical   no-undo .
     1947     do
     1948     on error undo, return error return-value
     1949     :
     1950       if p-action = ?
     1951       then do:
     1952         if v-diasize-need-maximize = true
     1953         then do:
     1954           assign
     1955             p-action = true
     1956           .
     1957         end.
     1958         else do:
     1959           assign
     1960             p-action = false
     1961           .
     1962         end.
     1963       end.
     1964       if p-action = true
     1965       then do:
     1966         run diasize_change-height in this-procedure
     1967           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1968               - frame Dialog-Frame :height-chars
     1969           ,input true
     1970           ) .
     1971         run diasize_change-width in this-procedure
     1972           (input session :width-chars
     1973               - frame Dialog-Frame :width-chars
     1974           ,input true
     1975           ) .
     1976         assign
     1977           v-diasize-need-maximize = false
     1978         .
     1979       end.
     1980       else do:
     1981         run diasize_change-width in this-procedure
     1982           (input v-diasize-orig-frame-width
     1983               - frame Dialog-Frame :width-chars
     1984           ,input true
     1985           ) .
     1986         run diasize_change-height in this-procedure
     1987           (input v-diasize-orig-frame-height
     1988               - frame Dialog-Frame :height-chars
     1989           ,input true
     1990           ) .
     1991         assign
     1992           v-diasize-need-maximize = true
     1993         .
     1994       end.
     1995     end.
     1996   end procedure.
     1997   procedure diasize_restore-orig-size :
     1998     do
     1999     on error undo, return error return-value
     2000     :
     2001       assign
     2002         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2003         v-diasize-current-frame-height = frame Dialog-Frame :height
     2004       .
     2005       run diasize_set-height in this-procedure
     2006         (input  v-diasize-orig-frame-height
     2007         ,input  true
     2008         ) .
     2009       run diasize_set-width in this-procedure
     2010         (input  v-diasize-orig-frame-width
     2011         ,input  true
     2012         ) .
     2013     end.
     2014   end procedure.
     2015   procedure diasize_restore-current-size :
     2016     do
     2017     on error undo, return error return-value
     2018     :
     2019       run diasize_set-height in this-procedure
     2020         (input  v-diasize-current-frame-height
     2021         ,input  true
     2022         ) .
     2023       run diasize_set-width in this-procedure
     2024         (input  v-diasize-current-frame-width
     2025         ,input  true
     2026         ) .
     2027     end.
     2028   end procedure.
     2029   procedure diasize_set-browse-handle :
     2030     define input  parameter p-browse-handle as handle   no-undo .
     2031     define buffer buf_temp-browse-handle for temp-browse-handle .
     2032     do
     2033     on error undo, return error return-value
     2034     :
     2035       assign
     2036         v-diasize-browse-handle = p-browse-handle
     2037       .
     2038       for each buf_temp-browse-handle
     2039       on error undo, return error return-value
     2040       :
     2041         delete buf_temp-browse-handle .
     2042       end.
     2043     end.
     2044   end procedure.
     2045   procedure diasize_add_browse :
     2046     define input  parameter p-browse-type   as character no-undo .
     2047     define input  parameter p-browse-handle as handle    no-undo .
     2048     define buffer buf_temp-browse-handle for temp-browse-handle .
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       assign
     2053         v-diasize-browse-number = v-diasize-browse-number + 1
     2054       .
     2055       create buf_temp-browse-handle .
     2056       assign
     2057         buf_temp-browse-handle.browse-type   = p-browse-type
     2058         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2059         buf_temp-browse-handle.browse-handle = p-browse-handle
     2060       .
     2061     end.
     2062   end procedure.
     2063   procedure diasize_init :
     2064     define variable v-default-value    as logical   no-undo .
     2065     define variable v-restore-saved    as logical   no-undo .
     2066     define variable v-resize-value-str as character no-undo .
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       do with frame Dialog-Frame
     2071       :
     2072         assign
     2073           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2074           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2075           v-diasize-browse-handle     = browse BR-cash-pay :handle
     2076         .
     2077         create button v-diasize-resize-button
     2078         assign
     2079           parent        = frame Dialog-Frame :first-child
     2080           label         = "s"
     2081           height-pixels = 16
     2082           width-pixels  = 16
     2083           visible       = true
     2084           sensitive     = true
     2085           movable       = true
     2086           triggers:
     2087             on end-move persistent run diasize_end-move in this-procedure .
     2088           end triggers.
     2089         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2090         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2091         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2092         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2093         assign
     2094           v-diasize-wndmax = false
     2095         .
     2096         if connected("ub") = true
     2097         then do:
     2098           define variable v-cntxt-db-num        as integer   no-undo .
     2099           define variable v-cntxt-userid        as character no-undo .
     2100           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2101                                             , OUTPUT v-cntxt-userid
     2102                                             ) .
     2103           run gbl/wndpar_r.p
     2104             (input  v-cntxt-db-num
     2105             ,input  v-cntxt-userid
     2106             ,input  'wndmax':U
     2107             ,output v-diasize-wndmax
     2108             ,output v-default-value
     2109             ) .
     2110         end.
     2111         assign
     2112           v-diasize-wndstore = false
     2113         .
     2114         if connected("ub") = true
     2115         then do:
     2116           run gbl/wndpar_r.p
     2117             (input  v-cntxt-db-num
     2118             ,input  v-cntxt-userid
     2119             ,input  'wndstore':U
     2120             ,output v-diasize-wndstore
     2121             ,output v-default-value
     2122             ) .
     2123         end.
     2124         assign
     2125           v-diasize-proc-name = entry(1, program-name(2), '.')
     2126         .
     2127         if v-diasize-wndstore = true
     2128         then do:
     2129           assign
     2130             v-restore-saved = false
     2131           .
     2132           if connected("ub") = true
     2133           then do:
     2134             run gbl/wndsizer.p
     2135               (input  v-cntxt-db-num
     2136               ,input  v-cntxt-userid
     2137               ,input  v-diasize-proc-name
     2138               ,input  'height':u
     2139               ,output v-resize-value-str
     2140               ) .
     2141             if v-resize-value-str <> '':U
     2142             then do:
     2143               run diasize_change-height in this-procedure
     2144                 (input  integer(v-resize-value-str)
     2145                 ,input  true
     2146                 ) .
     2147               assign
     2148                 v-restore-saved = true
     2149               .
     2150             end.
     2151           end.
     2152           if connected("ub") = true
     2153           then do:
     2154             run gbl/wndsizer.p
     2155               (input  v-cntxt-db-num
     2156               ,input  v-cntxt-userid
     2157               ,input  v-diasize-proc-name
     2158               ,input  'width':u
     2159               ,output v-resize-value-str
     2160               ) .
     2161             if v-resize-value-str <> '':U
     2162             then do:
     2163               run diasize_change-width in this-procedure
     2164                 (input  integer(v-resize-value-str)
     2165                 ,input  true
     2166                 ) .
     2167               assign
     2168                 v-restore-saved = true
     2169               .
     2170             end.
     2171           end.
     2172           if v-restore-saved <> true
     2173           then do:
     2174             if v-diasize-wndmax = true
     2175             then do:
     2176               run diasize_maximize in this-procedure
     2177                 (input  true
     2178                 ) .
     2179             end.
     2180           end.
     2181         end.
     2182         else do:
     2183           if v-diasize-wndmax = true
     2184           then do:
     2185             run diasize_maximize in this-procedure
     2186               (input  true
     2187               ) .
     2188           end.
     2189         end.
     2190       end.
     2191     end.
     2192   end procedure.
     2193   procedure diasize_need-full-display :
     2194     define output parameter p-need-full-display as logical   no-undo .
     2195     do
     2196     on error undo, return error return-value
     2197     :
     2198       assign
     2199         p-need-full-display = v-diasize-need-full-display
     2200       .
     2201       assign
     2202         v-diasize-need-full-display = false
     2203       .
     2204     end.
     2205   end procedure.
     2206   procedure get-context :
     2207      define output parameter p-db-num as integer          no-undo.
     2208      define output parameter p-user-id as character        no-undo.
     2209      define variable v-login               as character    no-undo.
     2210      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2211      define buffer buf_user-login  for ub.user-login .
     2212      do
     2213      on error undo, return error
     2214      :
     2215            FIND FIRST buf_sys-ctrl no-lock.
     2216            ASSIGN
     2217               v-login = USERID("ub")
     2218               p-db-num = buf_sys-ctrl.db-num
     2219            .
     2220            FIND FIRST buf_user-login
     2221                 WHERE buf_user-login.db-num = p-db-num
     2222                   AND buf_user-login.user-login = v-login
     2223                 no-lock
     2224                 no-error
     2225                 .
     2226            IF AVAILABLE buf_user-login
     2227            THEN DO:
     2228               assign
     2229                  p-user-id = buf_user-login.user-id
     2230               .
     2231            END.
     2232      end.
     2233   end procedure.
     2234       run diasize_init in this-procedure .
     2235   MAIN-BLOCK:
     2236   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2237      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2238   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239     run mainmenu_getcntxt in parparentproc
     2240       (output v-cntxt-db-num
     2241       ,output v-cntxt-userid
     2242       ,output v-cntxt-level
     2243       ,output v-cntxt-host-code-obj
     2244       ,output v-cntxt-obj-type
     2245       ,output v-cntxt-obj-code
     2246       ,output v-cntxt-db-num-obj
     2247       ,output v-cntxt-is-admin
     2248       ) .
     2249   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2250   ON TAB ANYWHERE
     2251   DO:
     2252   define variable ii as integer no-undo .
     2253   define variable fh as widget-handle no-undo .
     2254   define variable hh as widget-handle no-undo .
     2255   define variable v-next-widget-name as character no-undo .
     2256   if v-tab-order <> '' then do:
     2257     if self:type = "TOGGLE-BOX" then
     2258     self:BGCOLOR = ?.
     2259     assign
     2260     ii = lookup(self:name, v-tab-order).
     2261     assign
     2262     ii = ii + 1
     2263     v-next-widget-name = entry(ii, v-tab-order)
     2264     no-error .
     2265     if error-status:error then do:
     2266       assign
     2267       ii = 1
     2268       v-next-widget-name = entry( ii, v-tab-order)
     2269       .
     2270     end.
     2271     assign
     2272     fh = frame Dialog-Frame:first-child
     2273     hh = fh:first-child
     2274     .
     2275     do while valid-handle(hh):
     2276       if hh:name = v-next-widget-name then do:
     2277         if hh:sensitive  = yes
     2278         AND hh:visible = yes then do:
     2279           if hh:type = "TOGGLE-BOX":U then do:
     2280             assign
     2281             hh:BGcolor = 1
     2282             .
     2283           end.
     2284           APPLY "ENTRY" to hh.
     2285           return no-apply.
     2286         end.
     2287         else do:
     2288           APPLY "TAB" to hh.
     2289           return no-apply.
     2290         end.
     2291       end.
     2292       hh = hh:next-sibling.
     2293     end.
     2294   end.
     2295   END.
     2296   ON BACK-TAB ANYWHERE
     2297   DO:
     2298   define variable ii as integer no-undo .
     2299   define variable fh as widget-handle no-undo .
     2300   define variable hh as widget-handle no-undo .
     2301   define variable v-next-widget-name as character no-undo .
     2302   if v-tab-order <> '' then do:
     2303     assign
     2304     ii = lookup(self:name, v-tab-order).
     2305     .
     2306     assign
     2307     ii = (if ii = 1
     2308           then  num-entries(v-tab-order)
     2309           else ii - 1
     2310           )
     2311     v-next-widget-name = entry(ii, v-tab-order)
     2312     .
     2313     assign
     2314     fh = frame Dialog-Frame:first-child
     2315     hh = fh:first-child
     2316     .
     2317     do while valid-handle(hh):
     2318       if hh:name = v-next-widget-name then do:
     2319         if hh:sensitive  = yes
     2320         AND hh:visible = yes then do:
     2321           if hh:type = "TOGGLE-BOX":U then do:
     2322             assign
     2323             hh:BGcolor = 1
     2324             .
     2325           end.
     2326           APPLY "ENTRY" to hh.
     2327           return no-apply.
     2328         end.
     2329         else do:
     2330         APPLY "BACK-TAB" to hh.
     2331         return no-apply.
     2332         end.
     2333       end.
     2334       hh = hh:next-sibling.
     2335     end.
     2336     end.
     2337   END.
     2338   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2339   ON RETURN ANYWHERE
     2340   DO:
     2341   define variable ii as integer no-undo .
     2342   define variable fh as widget-handle no-undo .
     2343   define variable hh as widget-handle no-undo .
     2344   define variable v-next-widget-name as character no-undo .
     2345     if v-tab-order <> '' then do:
     2346       assign
     2347       ii = lookup(self:name, v-tab-order).
     2348       if ii = num-entries(v-tab-order) then do:
     2349           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2350           return no-apply.
     2351       end.
     2352       if self:type <> "BUTTON" and
     2353         self:type <> "EDITOR"  then do:
     2354         run proc-move-forward in this-procedure .
     2355         return no-apply.
     2356       end.
     2357       if self:type = "BUTTON" then do:
     2358         APPLY "CHOOSE" to self.
     2359       end.
     2360       if self:type = "TOGGLE-BOX" then
     2361       self:BGCOLOR = ?.
     2362       assign
     2363       ii = ii + 1
     2364       v-next-widget-name = entry(ii, v-tab-order)
     2365       no-error .
     2366       if error-status:error then do:
     2367         assign
     2368         ii = 1
     2369         v-next-widget-name = entry( ii, v-tab-order)
     2370         .
     2371       end.
     2372       assign
     2373       fh = frame Dialog-Frame:first-child
     2374       hh = fh:first-child
     2375       .
     2376       do while valid-handle(hh):
     2377         if hh:name = v-next-widget-name then do:
     2378           if hh:sensitive  = yes
     2379           AND hh:visible = yes then do:
     2380             if hh:type = "TOGGLE-BOX":U then do:
     2381               assign
     2382               hh:BGcolor = 1
     2383               .
     2384             end.
     2385             APPLY "ENTRY" to hh.
     2386             return no-apply.
     2387           end.
     2388           else do:
     2389             APPLY "TAB" to hh.
     2390             return no-apply.
     2391           end.
     2392         end.
     2393         hh = hh:next-sibling.
     2394       end.
     2395     end.
     2396   END.
     2397   procedure proc-move-forward :
     2398   define variable ii as integer no-undo .
     2399   define variable fh as widget-handle no-undo .
     2400   define variable hh as widget-handle no-undo .
     2401   define variable v-next-widget-name as character no-undo .
     2402   do
     2403   on error undo, return error
     2404   :
     2405     if v-tab-order <> '' then do:
     2406       if self:type = "TOGGLE-BOX" then
     2407       self:BGCOLOR = ?.
     2408       assign
     2409       ii = lookup(self:name, v-tab-order).
     2410       assign
     2411       ii = ii + 1
     2412       v-next-widget-name = entry(ii, v-tab-order)
     2413       no-error .
     2414       if error-status:error then do:
     2415         assign
     2416         ii = 1
     2417         v-next-widget-name = entry( ii, v-tab-order)
     2418         .
     2419       end.
     2420       assign
     2421       fh = frame Dialog-Frame:first-child
     2422       hh = fh:first-child
     2423       .
     2424       do while valid-handle(hh):
     2425         if hh:name = v-next-widget-name then do:
     2426           if hh:sensitive  = yes
     2427           AND hh:visible = yes then do:
     2428             if hh:type = "TOGGLE-BOX":U then do:
     2429               assign
     2430               hh:BGcolor = 1
     2431               .
     2432             end.
     2433             APPLY "ENTRY" to hh.
     2434             return.
     2435           end.
     2436           else do:
     2437             assign
     2438             ii = ii + 1
     2439             v-next-widget-name = entry(ii, v-tab-order)
     2440             no-error .
     2441             if error-status:error then do:
     2442               assign
     2443               ii = 1
     2444               v-next-widget-name = entry( ii, v-tab-order)
     2445               .
     2446             end.
     2447           end.
     2448         end.
     2449         hh = hh:next-sibling.
     2450       end.
     2451     end.
     2452   end.
     2453   end procedure.
     2454     IF p-mode <> 'ПРОСМОТР':U
     2455     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2456         MESSAGE
     2457         vss-workfile vss-revision vss-description skip
     2458         "Неверное значение параметра p-mode" p-mode
     2459         VIEW-AS ALERT-BOX ERROR.
     2460         UNDO, RETURN ERROR.
     2461     END.
     2462     IF p-obj-type <> 'маг':U
     2463     and p-obj-type <> 'орг':U
     2464     and p-obj-type <> '':U
     2465     THEN DO:
     2466         MESSAGE
     2467         vss-workfile vss-revision vss-description skip
     2468         "Неверное значение параметра p-obj-type" p-obj-type
     2469         VIEW-AS ALERT-BOX ERROR.
     2470         UNDO, RETURN ERROR.
     2471     END.
     2472     if p-obj-type = 'маг':U then do:
     2473       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2474       IF NOT AVAILABLE X_shop THEN DO:
     2475           MESSAGE
     2476           vss-workfile vss-revision vss-description skip
     2477           "Неверное значение параметра p-obj-code" p-obj-code
     2478           VIEW-AS ALERT-BOX ERROR.
     2479           UNDO, RETURN ERROR.
     2480       END.
     2481   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2483     (input  'маг':U
     2484     ,input  p-obj-code
     2485     ,output v-db-num
     2486     )  .
     2487       IF v-db-num <> v-cntxt-db-num
     2488       AND v-cntxt-db-num <> 0
     2489       and p-mode <> 'ПРОСМОТР':U
     2490       THEN DO:
     2491           MESSAGE
     2492           "Нельзя менять параметры магазина в чужой БД" skip
     2493           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2494           VIEW-AS ALERT-BOX ERROR.
     2495           UNDO, RETURN ERROR.
     2496       END.
     2497   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2499     (input  p-obj-type
     2500     ,input  p-obj-code
     2501     ,output v-host-code
     2502     )  .
     2503     end.
     2504     if p-obj-type = 'орг':U then do:
     2505       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2506       IF NOT AVAILABLE X_sysconf THEN DO:
     2507           MESSAGE
     2508           vss-workfile vss-revision vss-description skip
     2509           "Неверное значение параметра p-obj-code" p-obj-code
     2510           VIEW-AS ALERT-BOX ERROR.
     2511           UNDO, RETURN ERROR.
     2512       END.
     2513       if v-cntxt-db-num <> 0
     2514       and p-mode <> 'ПРОСМОТР':U
     2515       then do:
     2516           MESSAGE
     2517           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2518           VIEW-AS ALERT-BOX ERROR.
     2519           UNDO, RETURN ERROR.
     2520       end.
     2521       v-host-code = p-obj-code.
     2522     end.
     2523     if p-obj-type = '':U then do:
     2524       if v-cntxt-db-num <> 0
     2525       and p-mode <> 'ПРОСМОТР':U
     2526       then do:
     2527           MESSAGE
     2528           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2529           VIEW-AS ALERT-BOX ERROR.
     2530           UNDO, RETURN ERROR.
     2531       end.
     2532     end.
     2533     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2534       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2535                 LOCKED_thbj-attr.obj-type = p-obj-type
     2536           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2537           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-ipc-servispl':U
     2538           AND   locked_thbj-attr.prop-code = '':U
     2539           NO-WAIT NO-ERROR.
     2540        if locked locked_thbj-attr then do:
     2541           message
     2542           vss-workfile vss-revision vss-description skip
     2543            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2544           view-as alert-box error .
     2545           undo, return error.
     2546         end.
     2547     END.
     2548     ELSE DO:
     2549         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2550             LOCKED_thbj-attr.obj-type = p-obj-type
     2551       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2552       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-ipc-servispl':U
     2553       AND   locked_thbj-attr.prop-code = '':U
     2554       NO-ERROR.
     2555     END.
     2556     if not available locked_thbj-attr then do:
     2557       ASSIGN
     2558       v-to-create  = YES.
     2559       message
     2560       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2561                   chr(10))
     2562       view-as alert-box WARNING.
     2563     end.
     2564   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2565   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2566     (input  v-host-code
     2567     ,output v-r-b-code
     2568     )  .
     2569   FIND FIRST buf_currency NO-LOCK WHERE
     2570           buf_currency.curr-code = v-r-b-code .
     2571     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2572     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2573     RUN Myenable.
     2574     WAIT-FOR GO OF FRAME Dialog-Frame.
     2575   END.
     2576   RUN disable_UI.
     2577   PROCEDURE disable_UI :
     2578     HIDE FRAME Dialog-Frame.
     2579   END PROCEDURE.
     2580   PROCEDURE enable_UI :
     2581     DISPLAY f-ipcsbasc f-ipcsdobc RS-ipcscpfx RS-ipcpgpfx for-curr-name-base
     2582             l-ipcspayn f-ipcspayn for-cash-pay-name for-curr-name l-ipcscpfx
     2583             l-ipcpgpfx
     2584         WITH FRAME Dialog-Frame.
     2585     ENABLE B-exit b-quit B-Help f-ipcsbasc b-curr-base b-cash-pay f-ipcsdobc
     2586            b-curr RS-ipcscpfx RS-ipcpgpfx BR-cash-pay for-curr-name-base
     2587            l-ipcspayn f-ipcspayn for-cash-pay-name for-curr-name l-ipcscpfx
     2588            l-ipcpgpfx
     2589         WITH FRAME Dialog-Frame.
     2590     VIEW FRAME Dialog-Frame.
     2591   END PROCEDURE.
     2592   PROCEDURE fill-widgets :
     2593   define variable v-value-character as character no-undo .
     2594   define variable v-value-date as date no-undo .
     2595   define variable v-value-decimal as decimal no-undo .
     2596   define variable v-value-integer as INTEGER no-undo .
     2597   define variable v-value-logical AS LOGICAL no-undo .
     2598   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2599   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2600   DEFINE VARIABLE v-ipcsccrd AS CHARACTER NO-UNDO.
     2601   DEFINE VARIABLE v-ipcstcrd AS CHARACTER NO-UNDO.
     2602   DEFINE VARIABLE v-ipcscurc AS CHARACTER NO-UNDO.
     2603   DEFINE VARIABLE v-ipcs-pay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2604   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2605   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     2606   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2607   define variable v-param-type as character no-undo .
     2608   define variable v-param-value as character no-undo .
     2609   FOR EACH thbjattr_thbj-attr:
     2610     delete thbjattr_thbj-attr.
     2611   end.
     2612   FOR EACH temp-thbj-attr:
     2613     delete temp-thbj-attr.
     2614   end.
     2615   run adm/shattri.p (
     2616                 input "init":U
     2617               , input p-obj-type
     2618               , input p-obj-code
     2619               , input 'cd-type-ipc-servispl':U
     2620               , input "":U
     2621               , output v-value-character
     2622               , output v-value-date
     2623               , output v-value-decimal
     2624               , output v-value-integer
     2625               , output v-value-logical
     2626               , output v-param-type
     2627               , INPUT-OUTPUT TABLE-handle v-tth
     2628               ) no-error .
     2629   if error-status:error
     2630   and not available locked_thbj-attr then do:
     2631     message
     2632     "Не удалось получить начальные значения настроек" skip
     2633     error-status:get-message(1) return-value
     2634     view-as alert-box error .
     2635     undo, return error .
     2636   end.
     2637   FOR EACH thbjattr_thbj-attr:
     2638     ASSIGN
     2639     v-entry = thbjattr_thbj-attr.prop-code.
     2640     IF v-entry = 'ipcsbasc':U THEN DO:
     2641       ASSIGN
     2642       f-ipcsbasc = thbjattr_thbj-attr.property-value-INTEGER
     2643       f-ipcsbasc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2644       .
     2645     END.
     2646     IF v-entry = 'ipcspayn':U THEN DO:
     2647       ASSIGN
     2648       f-ipcspayn = thbjattr_thbj-attr.property-value-INTEGER
     2649       f-ipcspayn:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2650       .
     2651     END.
     2652     IF v-entry = 'ipcsdobc':U THEN DO:
     2653       ASSIGN
     2654       f-ipcsdobc = IF thbjattr_thbj-attr.property-value-character = ""
     2655                    THEN ?
     2656                    ELSE integer(entry(1, thbjattr_thbj-attr.property-value-character, ";"))
     2657       .
     2658     END.
     2659     IF v-entry = 'ipcscpfx':U THEN DO:
     2660       ASSIGN
     2661       RS-ipcscpfx = thbjattr_thbj-attr.property-value-INTEGER
     2662       rs-ipcscpfx:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2663       .
     2664     END.
     2665     IF v-entry = 'ipcpgpfx':U THEN DO:
     2666       ASSIGN
     2667       RS-ipcpgpfx = thbjattr_thbj-attr.property-value-INTEGER
     2668       rs-ipcpgpfx:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2669       .
     2670     END.
     2671     IF v-entry = 'ipcsccrd':U THEN DO:
     2672       ASSIGN
     2673       v-ipcsccrd = thbjattr_thbj-attr.property-value-character.
     2674     END.
     2675     IF v-entry = 'ipcstcrd':U THEN DO:
     2676       ASSIGN
     2677       v-ipcstcrd = thbjattr_thbj-attr.property-value-character.
     2678     END.
     2679     IF v-entry = 'ipcscurc':U THEN DO:
     2680       ASSIGN
     2681       v-ipcscurc = thbjattr_thbj-attr.property-value-character.
     2682     END.
     2683     create temp-thbj-attr.
     2684     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2685   END.
     2686   _ii:
     2687   DO ii = 1 TO NUM-ENTRIES(v-ipcsccrd):
     2688      ASSIGN
     2689      v-ipcs-pay-code = INTEGER (ENTRY(ii, v-ipcsccrd))
     2690      v-cdpay-code = INTEGER (ENTRY(ii, v-ipcstcrd))
     2691      v-curr-code = INTEGER (ENTRY(ii, v-ipcscurc))
     2692      .
     2693      FIND FIRST buf_cash-pay NO-LOCK WHERE
     2694                   buf_cash-pay.cdpay-code = v-cdpay-code
     2695           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     2696      IF NOT AVAILABLE buf_cash-pay THEN NEXT _ii.
     2697       CREATE tt-cash-pay-ipcs.
     2698       BUFFER-COPY buf_cash-pay TO tt-cash-pay-ipcs
     2699       ASSIGN
     2700       tt-cash-pay-ipcs.ipcs-pay-code = v-ipcs-pay-code
     2701       .
     2702   END.
     2703   END PROCEDURE.
     2704   PROCEDURE MyEnable :
     2705   DEFINE BUFFER buf_currency FOR ub.currency.
     2706   DEFINE BUFFER buf_currency-base FOR ub.currency.
     2707   FIND FIRST buf_currency NO-LOCK WHERE
     2708             buf_currency.curr-code = f-ipcsdobc NO-ERROR.
     2709   IF AVAILABLE buf_currency THEN DO:
     2710       ASSIGN
     2711       for-curr-name = buf_currency.curr-abbr.
     2712   END.
     2713   ELSE DO:
     2714       ASSIGN
     2715       for-curr-name = ?.
     2716   END.
     2717   FIND FIRST buf_currency-base NO-LOCK WHERE
     2718             buf_currency-base.curr-code = f-ipcsbasc NO-ERROR.
     2719   IF AVAILABLE buf_currency-base THEN DO:
     2720       ASSIGN
     2721       for-curr-name-base = buf_currency-base.curr-abbr.
     2722   END.
     2723   ELSE DO:
     2724       ASSIGN
     2725       for-curr-name-base = ?.
     2726   END.
     2727   FIND FIRST buf_cash-pay NO-LOCK WHERE
     2728             buf_cash-pay.cdpay-code = f-ipcspayn
     2729         AND buf_cash-pay.curr-code = f-ipcsdobc NO-ERROR.
     2730   IF AVAILABLE buf_cash-pay THEN DO:
     2731       ASSIGN
     2732       for-cash-pay-name = buf_cash-pay.obj-name.
     2733   END.
     2734   ELSE DO:
     2735       ASSIGN
     2736       for-cash-pay-name = ?.
     2737   END.
     2738   ASSIGN
     2739   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2740   v-tab-order = "f-ipcsbasc,b-cash-pay,f-ipcsdobc,b-curr,RS-ipcscpfx,RS-ipcpgpfx,b-add,b-del".
     2741   DISPLAY
     2742   f-ipcsbasc
     2743   f-ipcspayn
     2744   f-ipcsdobc
     2745   RS-ipcscpfx
     2746   l-ipcscpfx
     2747   RS-ipcpgpfx
     2748   l-ipcpgpfx
     2749   for-curr-name
     2750   for-cash-pay-name
     2751   WITH FRAME Dialog-Frame.
     2752   ENABLE
     2753   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2754   b-quit
     2755   B-Help
     2756   b-curr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2757   b-cash-pay WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2758   f-ipcsbasc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2759   f-ipcsdobc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2760   RS-ipcscpfx WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2761   RS-ipcpgpfx WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2762   b-add   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2763   b-del   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2764   WITH FRAME Dialog-Frame.
     2765   OPEN QUERY BR-cash-pay FOR EACH tt-cash-pay-ipcs NO-LOCK INDEXED-REPOSITION.
     2766   VIEW FRAME Dialog-Frame.
     2767   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2768       HIDE
     2769       b-exit
     2770       IN FRAME Dialog-Frame.
     2771       ASSIGN
     2772       b-quit:LABEL = "&Выход"
     2773       .
     2774   END.
     2775   END PROCEDURE.
     2776   PROCEDURE OpenBr :
     2777   OPEN QUERY br-cash-pay FOR EACH tt-cash-pay-ipcs SHARE-LOCK.
     2778   END PROCEDURE.
     2779   PROCEDURE proc-save :
     2780   define variable v-value-character as character no-undo .
     2781   define variable v-value-date as date no-undo .
     2782   define variable v-value-decimal as decimal no-undo .
     2783   define variable v-value-integer as INTEGER no-undo .
     2784   define variable v-value-logical AS LOGICAL no-undo .
     2785   define variable v-param-type as character no-undo .
     2786   define variable wh as widget-handle no-undo .
     2787   define variable fh as widget-handle no-undo .
     2788   define variable v-same as logical no-undo .
     2789   DEFINE VARIABLE v-ipcsccrd AS CHARACTER NO-UNDO.
     2790   DEFINE VARIABLE v-ipcsbcrd AS CHARACTER NO-UNDO.
     2791   DEFINE VARIABLE v-ipcscurc AS CHARACTER NO-UNDO.
     2792   define variable v-shop-list as character no-undo .
     2793   DEFINE BUFFER buf_tt-cash-pay-ipcs FOR tt-cash-pay-ipcs.
     2794   define buffer buf_shop for ub.shop.
     2795   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2796   ASSIGN
     2797   FRAME Dialog-Frame
     2798   f-ipcsbasc
     2799   f-ipcspayn
     2800   f-ipcsdobc
     2801   RS-ipcscpfx
     2802   RS-ipcpgpfx
     2803   .
     2804   FOR EACH tt-cash-pay-ipcs BY tt-cash-pay-ipcs.ipcs-pay-code:
     2805     ASSIGN
     2806     v-ipcsccrd = v-ipcsccrd + (IF v-ipcsccrd = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-ipcs.ipcs-pay-code)
     2807     v-ipcsbcrd = v-ipcsbcrd + (IF v-ipcsbcrd = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-ipcs.cdpay-code)
     2808     v-ipcscurc = v-ipcscurc + (IF v-ipcscurc = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-ipcs.curr-code)
     2809     .
     2810   END.
     2811   if p-obj-type = 'орг':U THEN DO:
     2812     for each buf_shop no-lock where
     2813             buf_shop.host-code  = P-OBJ-CODE:
     2814       ASSIGN
     2815       v-shop-list = v-shop-list + (if v-shop-list = "":U then "":U else chr(44)) + string(buf_shop.obj-code).
     2816     END.
     2817   END.
     2818   assign
     2819   fh = frame Dialog-Frame:first-child
     2820   wh = fh:first-child
     2821   .
     2822   do while valid-handle(wh):
     2823     if wh:private-data begins "recid=" then do:
     2824       find first thbjattr_thbj-attr where
     2825                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2826       assign
     2827       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2828     end.
     2829     wh = wh:next-sibling.
     2830   end.
     2831   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ipcsdobc':U.
     2832   assign
     2833   thbjattr_thbj-attr.property-value-character = (if f-ipcsdobc = ?
     2834                                                   then ";":U
     2835                                                   else (trim(STRING(f-ipcsdobc)) + ";":U + (if p-obj-type = 'орг':U
     2836                                                                                             then v-shop-list
     2837                                                                                             else string(p-obj-code)
     2838                                                                                             )
     2839                                                         )
     2840                                                   )
     2841   .
     2842   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ipcsccrd':U.
     2843   assign
     2844   thbjattr_thbj-attr.property-value-character = v-ipcsccrd.
     2845   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ipcstcrd':U.
     2846   assign
     2847   thbjattr_thbj-attr.property-value-character = v-ipcsbcrd.
     2848   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'ipcscurc':U .
     2849   assign
     2850   thbjattr_thbj-attr.property-value-character = v-ipcscurc.
     2851   v-same = yes.
     2852   for each thbjattr_thbj-attr,
     2853       first temp-thbj-attr where
     2854             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2855         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2856         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2857         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2858      buffer-compare
     2859      thbjattr_thbj-attr
     2860      to temp-thbj-attr
     2861      save result in v-same.
     2862      if not v-same then leave.
     2863   end.
     2864   v-same = no.
     2865   IF v-same  and not v-to-create THEN RETURN.
     2866   run adm/shattri.p (
     2867                 input "check":U
     2868               , input p-obj-type
     2869               , input p-obj-code
     2870               , input 'cd-type-ipc-servispl':U
     2871               , INPUT '':U
     2872                , output v-value-character
     2873                , output v-value-date
     2874                , output v-value-decimal
     2875                , output v-value-integer
     2876                , output v-value-logical
     2877                , output v-param-type
     2878                , input-output TABLE-handle v-tth
     2879                ) no-error .
     2880   if error-status:error then do:
     2881     message
     2882     "Некорректное значение ПАРАМЕТРОВ" skip
     2883     error-status:get-message(1) skip
     2884     return-value
     2885     view-as alert-box error .
     2886     undo, return error .
     2887   end.
     2888   do TRANSACTION
     2889   on error undo, return error return-value
     2890   :
     2891     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2892          input p-obj-type
     2893         ,input p-obj-code
     2894         ,input 'cd-type-ipc-servispl':U
     2895         ,INPUT table thbjattr_thbj-attr
     2896     ) NO-ERROR.
     2897     IF ERROR-STATUS:error THEN do:
     2898       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2899       RETURN-VALUE
     2900       VIEW-AS ALERT-BOX.
     2901       UNDO, RETURN ERROR.
     2902     END.
     2903   end.
     2904   END PROCEDURE.
