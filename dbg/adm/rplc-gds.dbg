      148   .
      149   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   procedure cur-time :
      151      define output parameter p-today as date      no-undo .
      152      define output parameter p-time  as integer   no-undo .
      153     do
      154     on error undo, return error
      155     :
      156       define variable v-date1 as date      no-undo .
      157       define variable v-date2 as date      no-undo .
      158       define variable v-time  as integer   no-undo .
      159       assign
      160         v-date1 = today
      161         v-time  = time
      162         v-date2 = today
      163       .
      164       if v-date1 <> v-date2
      165       then do:
      166         assign
      167           v-date1 = today
      168           v-time  = v-time
      169         .
      170       end.
      171       assign
      172         p-today = v-date1
      173         p-time  = v-time
      174       .
      175     end.
      176   end.
      177   function cur-time-date returns character
      178   :
      179     return string(today, '99/99/9999':U) .
      180   end.
      181   function cur-time-mjd returns decimal
      182   :
      183     define variable v-date as date      no-undo .
      184     define variable v-time as integer   no-undo .
      185     run cur-time in this-procedure
      186       (output v-date
      187       ,output v-time
      188       ) .
      189     return integer(v-date) - 2400002 + (v-time / 86400) .
      190   end.
      191   function cur-time-get-ending-index returns integer
      192   (input p-number as integer
      193   )
      194   :
      195     if p-number < 0
      196     or p-number = ?
      197     then do:
      198       return 1 .
      199     end.
      200     define variable v-rest as integer   no-undo .
      201     assign
      202       p-number = p-number modulo 100
      203     .
      204     if p-number < 20
      205     then do:
      206       assign
      207         v-rest = p-number
      208       .
      209     end.
      210     else do:
      211       assign
      212         v-rest = p-number modulo 10
      213       .
      214     end.
      215     case v-rest :
      216       when 1
      217       then do:
      218         return 2 .
      219       end.
      220       when 2 or
      221       when 3 or
      222       when 4
      223       then do:
      224         return 3 .
      225       end.
      226       otherwise do:
      227         return 1 .
      228       end.
      229     end case .
      230   end.
      231   procedure cur-time-mjd-to-date :
      232      define input  parameter i-mjd-diff as decimal no-undo.
      233      define output parameter o-Date     as date    no-undo.
      234      define output parameter o-Time     as integer no-undo.
      235      define variable v-day-number as integer   no-undo .
      236      if    i-mjd-diff < 0
      237         or i-mjd-diff = ?
      238      then do:
      239         return "?" .
      240      end.
      241      assign
      242         v-day-number = truncate(i-mjd-diff,0).
      243         o-Date = date(v-day-number + 2400002).
      244         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      245     .
      246   end.
      247   function cur-time-mjd-to-string returns character
      248   (input p-mjd-diff as decimal
      249   )
      250   :
      251     define variable v-day-number as integer   no-undo .
      252     define variable v-seconds    as integer   no-undo .
      253     define variable v-hour       as integer   no-undo .
      254     define variable v-min        as integer   no-undo .
      255     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      256     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      257     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      258     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      259     if p-mjd-diff < 0
      260     or p-mjd-diff = ?
      261     then do:
      262       return "?" .
      263     end.
      264     assign
      265       v-day-number = integer(truncate(p-mjd-diff,0))
      266       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      267     .
      268     if v-seconds > 86400
      269     then do:
      270       assign
      271         v-seconds = 86400 - 1
      272       .
      273     end.
      274     if v-seconds < 0
      275     then do:
      276       assign
      277         v-seconds = 0
      278       .
      279     end.
      280     assign
      281       v-hour = truncate(v-seconds / 3600, 0)
      282     .
      283     assign
      284       v-seconds = v-seconds modulo 3600
      285     .
      286     assign
      287       v-min = truncate(v-seconds / 60, 0)
      288     .
      289     assign
      290       v-seconds = v-seconds modulo 60
      291     .
      292     return
      293         (if v-day-number <> 0
      294           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      295           else ""
      296         )
      297       + (if v-day-number <> 0 or v-hour <> 0
      298           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      299           else ""
      300         )
      301       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      302           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      303           else ""
      304         )
      305       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      306       .
      307   end.
      308   function cur-time-string returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      317   end.
      318   function cur-time-string-sec returns character
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      327   end.
      328   function cur-time-custom  returns character
      329   (input p-prefix as character
      330   ,input p-date-format as character
      331   ,input p-delimiter as character
      332   ,input p-time-format as character
      333   ,input p-suffix as character
      334   )
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return
      343       p-prefix
      344       + string(v-date, p-date-format)
      345       + p-delimiter
      346       + string(v-time, p-time-format)
      347       + p-suffix
      348       .
      349   end.
      350   function cur-time-print  returns character
      351   :
      352     define variable v-date as date      no-undo .
      353     define variable v-time as integer   no-undo .
      354     run cur-time in this-procedure
      355       (output v-date
      356       ,output v-time
      357       ) .
      358     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      359   end.
      360   function cur-time-datetime returns datetime
      361   :
      362     define variable v-char as character no-undo .
      363     define variable v-datetime as datetime no-undo .
      364     v-char = cur-time-string().
      365     v-datetime = datetime(v-char).
      366     return  v-datetime.
      367   end.
      368   function cur-time-string-msec returns character
      369   :
      370     define variable v-date as datetime  no-undo .
      371     v-date = now.
      372     return string(v-date) .
      373   end.
      374   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define variable v-waitfram-action01         as character   no-undo .
      376   define variable v-waitfram-action02         as character   no-undo .
      377   define variable v-waitfram-action03         as character   no-undo .
      378   define variable mWaitFramTextBeg            as character   no-undo.
      379   define variable mWaitFramTextEnd            as character   no-undo.
      380   define variable mWaitFramView               as logical     no-undo.
      381   define variable mWaitProcEvent              as logical     no-undo init yes.
      382   define variable mWaitFramInterval           as integer     no-undo init 1 .
      383   define variable mWaitFramStop               as logical     no-undo.
      384   define variable mWaitFramStopUser           as logical     no-undo.
      385   define variable mWaitFramStopTimeOut        as logical     no-undo.
      386   define variable mWaitFramStartProc          as datetime-tz no-undo.
      387   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      388   define button B-WaitFramStop auto-end-key
      389        label "Стоп"
      390        size 10 by 1 tooltip "Остоновить процесс".
      391   define button B-viewProcInfo
      392        label "Информация"
      393        size 15 by 1 tooltip "Информация о процесс".
      394   define frame waitfram
      395     v-waitfram-action01 format "x(72)" no-label skip
      396     v-waitfram-action02 format "x(72)" no-label skip
      397     v-waitfram-action03 format "x(72)" no-label skip
      398     B-viewProcInfo
      399     B-WaitFramStop at row 4 col 30
      400     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      401     .
      402   define new global shared variable mBatchMode as logical no-undo init ?.
      403   define variable mFramBachModHandle as handle no-undo.
      404   mFramBachModHandle = frame waitfram:handle.
      405   define variable mFameOldVis as logical no-undo.
      406   define variable mVisCUrentVin as logical no-undo.
      407   if session:batch-mode
      408   then
      409      mBatchMode = yes.
      410   if mBatchMode = ? then do:
      411     mVisCUrentVin = current-window:visible.
      412     mFameOldVis = mFramBachModHandle:visible.
      413     mFramBachModHandle:visible  = yes.
      414     mBatchMode = mFramBachModHandle:visible ne yes.
      415     mFramBachModHandle:visible = mFameOldVis.
      416     current-window:visible = mVisCUrentVin.
      417   end.
      418    if  log-manager:logfile-name ne ?
      419     then DO:
      420         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      421         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      422         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      423     end.
      424   on choose of B-WaitFramStop in frame waitfram
      425   do:
      426     mWaitFramStop = yes.
      427     mWaitFramStopUser = yes.
      428   end.
      429   function waitfram-check-timeout returns logical():
      430      define variable vtime as int64 no-undo.
      431      if mWaitFramStopTimeOut
      432      then
      433         return yes.
      434      vtime = ( now - mWaitFramStartProc ) / 1000 .
      435      if     mWaitFramTimeOut ne ?
      436         and mWaitFramTimeOut ne 0
      437         and mWaitFramTimeOut lt vtime
      438      then do:
      439         mWaitFramStopTimeOut = yes.
      440      end.
      441      return mWaitFramStopTimeOut.
      442   end.
      443   procedure waitfram-hide :
      444     if not session:batch-mode
      445     then do
      446     on error undo, return error return-value
      447     :
      448       pause 0 before-hide .
      449       if not mBatchMode then
      450         hide frame waitfram .
      451     if     not mWaitFramView
      452        and mWaitProcEvent
      453     then
      454       process events .
      455     end.
      456   end procedure.
      457   procedure waitfram-show :
      458     define input  parameter p-message as character no-undo .
      459     define variable v-left-margin as integer   no-undo .
      460     if not session:batch-mode
      461     then do
      462     on error undo, return error return-value
      463     :
      464       if length(p-message) <= 70 then do:
      465         assign
      466           v-left-margin = integer((70 - length(p-message)) / 2)
      467         .
      468         assign
      469           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      470         .
      471         assign
      472           v-waitfram-action01 = " "
      473           v-waitfram-action02 = " "
      474                                    + fill(" ", v-left-margin)
      475                                    + p-message
      476           v-waitfram-action03 = " "
      477         .
      478       end.
      479       else do:
      480         define variable vRindex1 as integer no-undo.
      481         define variable vRindex2 as integer no-undo.
      482         vRindex1 = r-index(p-message," ",70).
      483         if vRindex1 = 0
      484         then
      485            vRindex1 = 70.
      486         if length(p-message)  <= vRindex1 + 70 then do:
      487           assign
      488             v-waitfram-action01 = " "
      489             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      490             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      491           .
      492         end.
      493         else do:
      494           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      495           if vRindex2 <= vRindex1
      496           then
      497              vRindex2 = vRindex1 + 70.
      498           assign
      499             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      500             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      501             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      502           .
      503         end.
      504       end.
      505       B-viewProcInfo:visible   in frame waitfram = no.
      506       B-viewProcInfo:sensitive in frame waitfram = no.
      507       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      508       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      509       if  (   mWaitFramView
      510          or  mWaitProcEvent)
      511          and not mBatchMode
      512       then
      513          display
      514             v-waitfram-action01 skip
      515             v-waitfram-action02 skip
      516             v-waitfram-action03 skip
      517          with frame waitfram .
      518       if     mWaitFramView
      519          then do:
      520             if     mWaitFramInterval ne ?
      521                and not mBatchMode
      522             then
      523                wait-for go of frame waitfram pause mWaitFramInterval.
      524          end.
      525          else
      526             if     mWaitProcEvent
      527                and not mBatchMode
      528             then
      529                process events .
      530     end.
      531   end procedure.
      532      procedure waitfram-show-this:
      533         define input  parameter iInterval as int64 no-undo.
      534         define variable vtime as int64 no-undo.
      535         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      536         mWaitFramInterval = iInterval.
      537         run waitfram-show (substitute("&1&2 &3&4" ,
      538                                       mWaitFramTextBeg ,
      539                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      540                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      541                                       mWaitFramTextEnd
      542                                      )
      543                           ).
      544      end.
      545      procedure WaitFramRunPause:
      546         define input  parameter iInterval as dec no-undo.
      547         define variable vStart  as datetime-tz no-undo.
      548         define variable vend    as datetime-tz no-undo.
      549         define variable vint as int64 no-undo.
      550         define variable vOk as logical no-undo.
      551         vStart = now.
      552         vend   = vStart.
      553         publish "WaitFramPause" (iInterval,output vOk).
      554         vend   =  now.
      555         vint = vend - vStart.
      556         vint = iInterval - vint / 1000.
      557         if     not mWaitFramStop
      558            and (   vint > 0
      559                 or (    not vOk
      560                     and iInterval eq ?
      561                     )
      562                 )
      563         then
      564            run waitfram-show-this (iInterval).
      565         vend   =  now.
      566         vint = vend - vStart.
      567         vint = iInterval - vint / 1000.
      568         if     not mWaitFramStop
      569            and vint > 0
      570         then do:
      571            run gbl/pause.p (vint * 1000).
      572         end.
      573         if iInterval ne ?
      574         then
      575            publish "WaitFramStop".
      576         waitfram-check-timeout().
      577      end.
      578      procedure WaitFramWaitFor:
      579         define input  parameter iInterval as dec no-undo.
      580         assign
      581            mWaitFramStartProc   = now
      582            mWaitFramStopUser    = no
      583            mWaitFramStopTimeOut = no
      584         .
      585         block-wait:
      586         do while not mWaitFramStop:
      587            run WaitFramRunPause (iInterval).
      588            if  waitfram-check-timeout()
      589            then do:
      590               leave block-wait.
      591            end.
      592         end.
      593         run waitfram-hide.
      594      end.
      595   procedure waitfram-join :
      596     define input  parameter p-line-1  as character no-undo .
      597     define input  parameter p-line-2  as character no-undo .
      598     define input  parameter p-line-3  as character no-undo .
      599     define output parameter p-message as character no-undo .
      600     do
      601     on error undo, return error return-value
      602     :
      603       assign
      604         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      605                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      606                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      607       .
      608     end.
      609   end procedure.
      610   function waitfram-join-function returns character
      611     (input p-line-1 as character
      612     ,input p-line-2 as character
      613     ,input p-line-3 as character
      614     ).
      615     define variable v-message as character no-undo .
      616     run waitfram-join in this-procedure
      617       (input  p-line-1
      618       ,input  p-line-2
      619       ,input  p-line-3
      620       ,output v-message
      621       ) .
      622     return v-message .
      623   end function .
      624   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     define variable v-cntxt-db-num        as integer   no-undo .
      626     define variable v-cntxt-userid        as character no-undo .
      627     define variable v-cntxt-level         as character no-undo .
      628     define variable v-cntxt-host-code-obj as integer   no-undo .
      629     define variable v-cntxt-obj-type      as character no-undo .
      630     define variable v-cntxt-obj-code      as integer   no-undo .
      631     define variable v-cntxt-db-num-obj    as integer   no-undo .
      632     define variable v-cntxt-is-admin      as logical   no-undo .
      633   define stream sout .
      634   DEFINE BUTTON b-help
      635        LABEL "Помо&щь"
      636        SIZE 10 BY 1.
      637   DEFINE BUTTON B-lst
      638        LABEL "Список"
      639        SIZE 10 BY 1.
      640   DEFINE BUTTON b-quit AUTO-END-KEY
      641        LABEL "&Выход "
      642        SIZE 10 BY 1.
      643   DEFINE BUTTON b-start
      644        LABEL "&Старт"
      645        SIZE 10 BY 1.
      646   DEFINE VARIABLE from-str AS CHARACTER FORMAT "X(256)":U
      647        LABEL "&Искомая строка"
      648        VIEW-AS FILL-IN
      649        SIZE 30.5 BY 1 NO-UNDO.
      650   DEFINE VARIABLE to-str AS CHARACTER FORMAT "X(256)":U
      651        LABEL "&Заменить на"
      652        VIEW-AS FILL-IN
      653        SIZE 30.5 BY 1 NO-UNDO.
      654   DEFINE RECTANGLE RECT-1
      655        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      656        SIZE 25.88 BY 5.5.
      657   DEFINE VARIABLE T-chk-name AS LOGICAL INITIAL no
      658        LABEL "Чек"
      659        VIEW-AS TOGGLE-BOX
      660        SIZE 22.5 BY 1
      661        FGCOLOR 4  NO-UNDO.
      662   DEFINE VARIABLE T-engl-name AS LOGICAL INITIAL no
      663        LABEL "Англ. название"
      664        VIEW-AS TOGGLE-BOX
      665        SIZE 22.5 BY 1
      666        FGCOLOR 4  NO-UNDO.
      667   DEFINE VARIABLE T-instring AS LOGICAL INITIAL no
      668        LABEL "В середине слова"
      669        VIEW-AS TOGGLE-BOX
      670        SIZE 29 BY 1 NO-UNDO.
      671   DEFINE VARIABLE T-label-name AS LOGICAL INITIAL no
      672        LABEL "Этикетка"
      673        VIEW-AS TOGGLE-BOX
      674        SIZE 22.5 BY 1
      675        FGCOLOR 4  NO-UNDO.
      676   DEFINE VARIABLE T-lst AS LOGICAL INITIAL no
      677        LABEL "По списку"
      678        VIEW-AS TOGGLE-BOX
      679        SIZE 13.63 BY 1 NO-UNDO.
      680   DEFINE VARIABLE T-name AS LOGICAL INITIAL no
      681        LABEL "Название"
      682        VIEW-AS TOGGLE-BOX
      683        SIZE 22.5 BY 1
      684        FGCOLOR 4  NO-UNDO.
      685   DEFINE FRAME DIALOG-1
      686        b-quit AT ROW 1 COL 1
      687        B-lst AT ROW 1 COL 11
      688        b-start AT ROW 1 COL 21
      689        b-help AT ROW 1 COL 31
      690        T-lst AT ROW 2.79 COL 23.5
      691        T-name AT ROW 3.5 COL 58.5
      692        from-str AT ROW 4.08 COL 21.5 COLON-ALIGNED
      693        T-engl-name AT ROW 4.5 COL 58.5
      694        to-str AT ROW 5.5 COL 21.5 COLON-ALIGNED
      695        T-label-name AT ROW 5.5 COL 58.5
      696        T-chk-name AT ROW 6.5 COL 58.5
      697        T-instring AT ROW 6.75 COL 23.5
      698        "Поля для поиска и замены" VIEW-AS TEXT
      699             SIZE 24 BY .67 AT ROW 2.75 COL 58
      700             BGCOLOR 3 FGCOLOR 15
      701        RECT-1 AT ROW 2.5 COL 57
      702        SPACE(4.99) SKIP(0.32)
      703       WITH VIEW-AS DIALOG-BOX
      704            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      705            TITLE "Контекстная замена в полях названий товаров".
      706   ASSIGN
      707          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      708   ASSIGN
      709          B-lst:HIDDEN IN FRAME DIALOG-1           = TRUE.
      710   ON CHOOSE OF B-lst IN FRAME DIALOG-1
      711   DO:
      712         run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code).
      713   END.
      714   ON CHOOSE OF b-start IN FRAME DIALOG-1
      715   DO:
      716     define variable v-matches-string as character no-undo .
      717     define variable v-ind            as integer   no-undo .
      718     define variable v-change-ind     as integer   no-undo .
      719     define variable v-replace-string as logical   no-undo .
      720     define buffer buf_goods for ub.goods.
      721     find ub.db where ub.db.db-num = v-cntxt-db-num no-lock.
      722     if not ub.db.add-goods
      723     then do:
      724       message
      725         "Изменение и добавление товаров в данной БД запрещено !"
      726         view-as alert-box error .
      727       return no-apply.
      728     end.
      729     assign
      730       from-str
      731       to-str
      732       t-instring
      733       t-name
      734       t-engl-name
      735       t-label-name
      736       t-chk-name
      737     .
      738     if from-str = ""
      739     then do:
      740       message
      741         "Искомая строка не задана." skip
      742         view-as alert-box error .
      743       apply 'entry':u to from-str .
      744       return no-apply.
      745     end.
      746     if length(from-str) = 1
      747     then do:
      748       message
      749         "Замена одной буквы недопустима." skip
      750         "Это приведёт к изменению названий всех товаров!"
      751         view-as alert-box error .
      752       apply 'entry':u to from-str .
      753       return no-apply.
      754     end.
      755     if  t-name       = false
      756     and t-engl-name  = false
      757     and t-label-name = false
      758     and t-chk-name   = false
      759     then do:
      760       message
      761         "Необходимо выбрать" skip
      762         "Поля для поля для поиска и замены" skip
      763         view-as alert-box error .
      764       return no-apply.
      765     end.
      766     if t-lst
      767     then do:
      768       for each gds-list No-lock
      769       :
      770         find first buf_goods
      771           where buf_goods.artic     = gds-list.artic
      772             and buf_goods.prod-type = gds-list.prod-type
      773             and buf_goods.prod-code = gds-list.prod-code
      774           .
      775         if t-instring
      776         then do:
      777           assign
      778             v-matches-string = "*" + from-str + "*"
      779           .
      780         end.
      781         else do:
      782           assign
      783             v-matches-string = from-str + "*"
      784           .
      785         end.
      786         assign
      787           v-replace-string = false
      788         .
      789         if  t-name
      790         and buf_goods.gds-name matches v-matches-string
      791         then do:
      792           define variable v-new-gds-name as character no-undo .
      793           assign
      794             v-new-gds-name = replace(buf_goods.gds-name, from-str, to-str)
      795           .
      796           output stream sout to value('rplc-gds.txt') append .
      797           put stream sout unformatted
      798             cur-time-string-sec()
      799             " gds-code " buf_goods.gds-code
      800             " artic " buf_goods.artic
      801             " prod-type " buf_goods.prod-type
      802             " prod-code " buf_goods.prod-code
      803             " old-gds-name " buf_goods.gds-name
      804             " new-gds-name " v-new-gds-name
      805             chr(10)
      806             .
      807           output stream sout close .
      808           assign
      809             v-replace-string  = true
      810             buf_goods.gds-name    = v-new-gds-name
      811             gds-list.gds-name = v-new-gds-name
      812           .
      813         end.
      814         if  t-engl-name
      815         and buf_goods.engl-name matches v-matches-string
      816         then do:
      817           define variable v-new-engl-name as character no-undo .
      818           assign
      819             v-new-engl-name = replace(buf_goods.engl-name, from-str, to-str)
      820           .
      821           output stream sout to value('rplc-gds.txt') append .
      822           put stream sout unformatted
      823             cur-time-string-sec()
      824             " gds-code " buf_goods.gds-code
      825             " artic " buf_goods.artic
      826             " prod-type " buf_goods.prod-type
      827             " prod-code " buf_goods.prod-code
      828             " old-engl-name " buf_goods.engl-name
      829             " new-engl-name " v-new-engl-name
      830             chr(10)
      831             .
      832           output stream sout close .
      833           assign
      834             v-replace-string = true
      835             buf_goods.engl-name  = v-new-engl-name
      836             gds-list.engl-name = v-new-gds-name
      837           .
      838         end.
      839         if  t-label-name
      840         and buf_goods.label-name matches v-matches-string
      841         then do:
      842           define variable v-new-label-name as character no-undo .
      843           assign
      844             v-new-label-name = replace(buf_goods.label-name, from-str, to-str)
      845           .
      846           output stream sout to value('rplc-gds.txt') append .
      847           put stream sout unformatted
      848             cur-time-string-sec()
      849             " gds-code " buf_goods.gds-code
      850             " artic " buf_goods.artic
      851             " prod-type " buf_goods.prod-type
      852             " prod-code " buf_goods.prod-code
      853             " old-label-name " buf_goods.label-name
      854             " new-label-name " v-new-label-name
      855             chr(10)
      856             .
      857           output stream sout close .
      858           assign
      859             v-replace-string    = true
      860             buf_goods.label-name    = v-new-label-name
      861             gds-list.label-name = v-new-gds-name
      862           .
      863         end.
      864         if  t-chk-name
      865         and buf_goods.chk-name matches v-matches-string
      866         then do:
      867           define variable v-new-chk-name as character no-undo .
      868           assign
      869             v-new-chk-name = replace(buf_goods.chk-name, from-str, to-str)
      870           .
      871           output stream sout to value('rplc-gds.txt') append .
      872           put stream sout unformatted
      873             cur-time-string-sec()
      874             " gds-code " buf_goods.gds-code
      875             " artic " buf_goods.artic
      876             " prod-type " buf_goods.prod-type
      877             " prod-code " buf_goods.prod-code
      878             " old-chk-name " buf_goods.chk-name
      879             " new-chk-name " v-new-chk-name
      880             chr(10)
      881             .
      882           output stream sout close .
      883           assign
      884             v-replace-string  = true
      885             buf_goods.chk-name    = v-new-chk-name
      886             gds-list.chk-name = v-new-gds-name
      887           .
      888         end.
      889         if v-replace-string = true
      890         then do:
      891           assign
      892             v-change-ind = v-change-ind + 1
      893           .
      894         end.
      895         assign
      896           v-ind = v-ind + 1
      897         .
      898         if v-ind modulo 10 = 0
      899         then do:
      900           run waitfram-show in this-procedure
      901             (input substitute("Обработано &1. Произведено замен &2"
      902                             ,v-ind
      903                             ,v-change-ind
      904                             )
      905             ).
      906         end.
      907       end.
      908     end.
      909     else do:
      910       for each buf_goods
      911       :
      912         if t-instring
      913         then do:
      914           assign
      915             v-matches-string = "*" + from-str + "*"
      916           .
      917         end.
      918         else do:
      919           assign
      920             v-matches-string = from-str + "*"
      921           .
      922         end.
      923         assign
      924           v-replace-string = false
      925         .
      926         if  t-name
      927         and buf_goods.gds-name matches v-matches-string
      928         then do:
      929           assign
      930             v-new-gds-name = replace(buf_goods.gds-name, from-str, to-str)
      931           .
      932           output stream sout to value('rplc-gds.txt') append .
      933           put stream sout unformatted
      934             cur-time-string-sec()
      935             " gds-code " buf_goods.gds-code
      936             " artic " buf_goods.artic
      937             " prod-type " buf_goods.prod-type
      938             " prod-code " buf_goods.prod-code
      939             " old-gds-name " buf_goods.gds-name
      940             " new-gds-name " v-new-gds-name
      941             chr(10)
      942             .
      943           output stream sout close .
      944           assign
      945             v-replace-string = true
      946             buf_goods.gds-name   = v-new-gds-name
      947           .
      948         end.
      949         if  t-engl-name
      950         and buf_goods.engl-name matches v-matches-string
      951         then do:
      952           assign
      953             v-new-engl-name = replace(buf_goods.engl-name, from-str, to-str)
      954           .
      955           output stream sout to value('rplc-gds.txt') append .
      956           put stream sout unformatted
      957             cur-time-string-sec()
      958             " gds-code " buf_goods.gds-code
      959             " artic " buf_goods.artic
      960             " prod-type " buf_goods.prod-type
      961             " prod-code " buf_goods.prod-code
      962             " old-engl-name " buf_goods.engl-name
      963             " new-engl-name " v-new-engl-name
      964             chr(10)
      965             .
      966           output stream sout close .
      967           assign
      968             v-replace-string = true
      969             buf_goods.engl-name  = v-new-engl-name
      970           .
      971         end.
      972         if  t-label-name
      973         and buf_goods.label-name matches v-matches-string
      974         then do:
      975           assign
      976             v-new-label-name = replace(buf_goods.label-name, from-str, to-str)
      977           .
      978           output stream sout to value('rplc-gds.txt') append .
      979           put stream sout unformatted
      980             cur-time-string-sec()
      981             " gds-code " buf_goods.gds-code
      982             " artic " buf_goods.artic
      983             " prod-type " buf_goods.prod-type
      984             " prod-code " buf_goods.prod-code
      985             " old-label-name " buf_goods.label-name
      986             " new-label-name " v-new-label-name
      987             chr(10)
      988             .
      989           output stream sout close .
      990           assign
      991             v-replace-string = true
      992             buf_goods.label-name = v-new-label-name
      993           .
      994         end.
      995         if  t-chk-name
      996         and buf_goods.chk-name matches v-matches-string
      997         then do:
      998           assign
      999             v-new-chk-name = replace(buf_goods.chk-name, from-str, to-str)
     1000           .
     1001           output stream sout to value('rplc-gds.txt') append .
     1002           put stream sout unformatted
     1003             cur-time-string-sec()
     1004             " gds-code " buf_goods.gds-code
     1005             " artic " buf_goods.artic
     1006             " prod-type " buf_goods.prod-type
     1007             " prod-code " buf_goods.prod-code
     1008             " old-chk-name " buf_goods.chk-name
     1009             " new-chk-name " v-new-chk-name
     1010             chr(10)
     1011             .
     1012           output stream sout close .
     1013           assign
     1014             v-replace-string = true
     1015             buf_goods.chk-name   = v-new-chk-name
     1016           .
     1017         end.
     1018         if v-replace-string = true
     1019         then do:
     1020           assign
     1021             v-change-ind = v-change-ind + 1
     1022           .
     1023         end.
     1024         assign
     1025           v-ind = v-ind + 1
     1026         .
     1027         if v-ind modulo 10 = 0
     1028         then do:
     1029           run waitfram-show in this-procedure
     1030             (input substitute("Обработано &1. Произведено замен &2"
     1031                             ,v-ind
     1032                             ,v-change-ind
     1033                             )
     1034             ).
     1035         end.
     1036       end.
     1037     end.
     1038     run waitfram-hide in this-procedure .
     1039     message
     1040       "Контекстная замена закончена" skip
     1041       "Обработано товаров" v-ind skip
     1042       "Товаров с изменёнными названиями" v-change-ind skip
     1043       "Подробная информация о произведённых заменах в файле" "rplc-gds.txt" skip
     1044       view-as alert-box information .
     1045   END.
     1046   ON VALUE-CHANGED OF T-lst IN FRAME DIALOG-1
     1047   DO:
     1048       assign T-lst.
     1049       IF T-lst then do:
     1050           ENABLE B-lst with frame DIALOG-1.
     1051           DISPLAY B-lst with frame DIALOG-1.
     1052       end.
     1053       else do:
     1054           HIDE B-lst in frame DIALOG-1.
     1055       end.
     1056   END.
     1057   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
     1058   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
     1059   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   on help of frame DIALOG-1
     1061   do:
     1062     run gbl/app_help.p
     1063       (input this-procedure :file-name
     1064       ,input ''
     1065       ,input ?
     1066       ) no-error.
     1067     if error-status :error then do:
     1068       message
     1069         "Ошибка при вызове помощи"
     1070         error-status :get-message(1)
     1071         view-as alert-box .
     1072     end.
     1073   end.
     1074   run minbtn-set in this-procedure .
     1075   on choose of b-help in frame DIALOG-1
     1076   do:
     1077     apply "help":u to frame DIALOG-1 .
     1078   end.
     1079   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   procedure minbtn-set :
     1081       do
     1082           on error undo, return error return-value
     1083           :
     1084           define variable ii              as integer       no-undo .
     1085           define variable fh              as widget-handle no-undo .
     1086           define variable hh              as widget-handle no-undo .
     1087           define variable v-h             as handle        extent 4 no-undo .
     1088           define variable v-name-button   as character     no-undo .
     1089           define variable v-help-old-x    as decimal       no-undo .
     1090           define variable v-help-old-y    as decimal       no-undo .
     1091           define variable v-help-old-size as decimal       no-undo .
     1092           define variable v-frame-width   as decimal       no-undo .
     1093           define variable jj              as integer       no-undo .
     1094           do
     1095               on error undo, return error
     1096               :
     1097               assign
     1098                   v-frame-width = frame DIALOG-1:width - 0.3
     1099                   fh            = frame DIALOG-1:first-child
     1100                   hh            = fh:first-child
     1101                   ii            = 1
     1102                   .
     1103               do while valid-handle(hh):
     1104                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1105                   do:
     1106                       case lc(hh:name) :
     1107                           when "b-help" then
     1108                               do:
     1109                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1110                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1111                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1112                                   hh:TOOLTIP = "Помощь" .
     1113                                   v-help-old-x = hh:column .
     1114                                   v-help-old-y = hh:row    .
     1115                                   v-help-old-size = hh:width .
     1116                                   hh:width-chars = 2.5 .
     1117                               end.
     1118                           when "b-print" then
     1119                               do:
     1120                                   hh:load-image("cmp/b-print.bmp":u) .
     1121                                   hh:TOOLTIP = "Печать" .
     1122                                   v-h[ii] = hh:handle .
     1123                                   ii = ii + 1 .
     1124                                   hh:width-chars = 3 .
     1125                               end.
     1126                           when "b-history" or
     1127                           when "b-hist" then
     1128                               do:
     1129                                   hh:load-image("cmp/b-hist.bmp":u) .
     1130                                   hh:TOOLTIP = "История" .
     1131                                   v-h[ii] = hh:handle .
     1132                                   ii = ii + 1 .
     1133                                   hh:width-chars = 3 .
     1134                               end.
     1135                           when "b-sch" then
     1136                               do:
     1137                                   hh:load-image("cmp/b-sch.bmp":u) .
     1138                                   hh:TOOLTIP = "Установка Фильтра" .
     1139                                   v-h[ii] = hh:handle .
     1140                                   ii = ii + 1 .
     1141                                   hh:width-chars = 3 .
     1142                               end.
     1143                           when "b-hist-user" then
     1144                               do:
     1145                                   hh:load-image("cmp/b-hist.bmp":u) .
     1146                                   hh:TOOLTIP = "История пользователя" .
     1147                                   ii = ii + 1 .
     1148                               end.
     1149                       end case.
     1150                   end.
     1151                   hh = hh:next-sibling.
     1152               end.
     1153               b-help:column = v-frame-width - b-help:width-chars.
     1154               jj = 0.
     1155               repeat ii = 4 to 1 by -1 :
     1156                   if valid-handle (v-h[ii] ) then
     1157                   do:
     1158                       jj  = jj + 1 .
     1159                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1160                       v-h[ii]:row    = v-help-old-y .
     1161                   end.
     1162               end.
     1163           end.
     1164       end.
     1165   end procedure.
     1166   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1167   MAIN-BLOCK:
     1168   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1169      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1170   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1171     run mainmenu_getcntxt in parparentproc
     1172       (output v-cntxt-db-num
     1173       ,output v-cntxt-userid
     1174       ,output v-cntxt-level
     1175       ,output v-cntxt-host-code-obj
     1176       ,output v-cntxt-obj-type
     1177       ,output v-cntxt-obj-code
     1178       ,output v-cntxt-db-num-obj
     1179       ,output v-cntxt-is-admin
     1180       ) .
     1181     RUN enable_UI.
     1182     WAIT-FOR GO OF FRAME DIALOG-1.
     1183   END.
     1184   RUN disable_UI.
     1185   PROCEDURE disable_UI :
     1186     HIDE FRAME DIALOG-1.
     1187   END PROCEDURE.
     1188   PROCEDURE enable_UI :
     1189     DISPLAY T-lst T-name from-str T-engl-name to-str T-label-name T-chk-name
     1190             T-instring
     1191         WITH FRAME DIALOG-1.
     1192     ENABLE b-quit b-start b-help RECT-1 T-lst T-name from-str T-engl-name to-str
     1193            T-label-name T-chk-name T-instring
     1194         WITH FRAME DIALOG-1.
     1195   END PROCEDURE.
