      123     index code is         unique gds-code
      124     index oi order-num
      125     index isel to-sel
      126     .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define  new shared  temp-table gds-list-hist no-undo
      129   field list-table as character
      130   field id as integer
      131   field line as integer
      132   field hist-mode as character
      133   field des as character
      134   field num-recs as integer
      135   field option_ as character
      136   field item_ as character
      137   field status_ as character
      138   field num-add as integer
      139   field num-ignored as integer
      140   field done as logical
      141   field err_ as logical
      142   field err-mes as character
