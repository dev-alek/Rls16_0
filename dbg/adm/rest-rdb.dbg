     1337           glog7 = buf_h7:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1338                                   , v-table-name7
     1339                                   , v-field-name7
     1340                                   , buf_code-range.first-code
     1341                                   , buf_code-range.last-code)
     1342                                   ) no-error .
     1343           if buf_h7:available then do:
     1344             assign
     1345             v-avail7 = v-avail7 + 1
     1346             .
     1347             if v-avail7 = 1 then do:
     1348               v-code-mess7 = string(buf_h7:buffer-field(v-field-name7):buffer-value)
     1349               .
     1350             end.
     1351           end.
