     8784       p-type-unload = entry(1, p-type-unload, chr(4)) .
     8785     end.
     8786     if transaction = true
     8787     then do:
     8788       message
     8789         vss-workfile vss-revision vss-description skip
     8790         "Активна транзакция" skip
     8791         "Выгрузка невозможна" skip
     8792         view-as alert-box error .
     8793       undo, return error "Активна транзакция" .
     8794     end.
     8795     if p-type-unload <> 'unload-copy':U
