     1321                   and buf_code-range.db-num = p-db-num
     1322                   and buf_code-range.stts = "f":U
     1323                 ) or
     1324                 ( buf_code-range.range-type = p-curr-type-cdrg
     1325                   and buf_code-range.db-num = p-db-num
     1326                   and buf_code-range.stts = "u":U
     1327                 )
     1328       on error undo, return error
     1329       :
     1330         v-avail7 = 0.
