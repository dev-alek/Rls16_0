     5310   ,susp-chk~
     5311   ':U .
     5312   define variable oth-list1 as character no-undo .
     5313   define variable oth-list2 as character no-undo .
     5314   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5315   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5316   define temp-table hst-bush no-undo
     5317   field table-name as character
     5318   field bush-head as character
     5319   field where-phrase as character
     5320   field if-phrase as character
     5321   field is-main as logical
     5322   field joined-buffers as character
     5323   index pi is unique primary
     5324   table-name
     5325   bush-head
     5326   index imain is-main
     5327   .
     5328   define temp-table hst-bind no-undo
     5329   field src-table-name as character
     5330   field rec-table-name as character
     5331   field where-phrase as character
     5332   field if-phrase as character
     5333   index pi is unique primary
     5334   src-table-name
     5335   rec-table-name
     5336   .
     5337   define variable hst-bush_bush-head as character no-undo extent 15 init
     5338   [
     5339       'c-gds-hist':U
     5340     , 'c-cli-hist':U
     5341     , 'c-dc-hist':U
     5342     , 'c-tax-hist':U
     5343     , 'c-gds-grp-hist':U
     5344     , 'c-wth-hist':U
     5345     , 'c-fbr-gds-grp-hist':U
     5346     , 'c-plc-hist':U
     5347     , 'c-pmp-hist':U
     5348     , 'c-nzl-hist':U
     5349     , 'c-sht-hist':U
     5350     , 'c-recipe-hist':U
     5351     , 'c-usr-hist':U
     5352     , 'c-table-bind':U
     5353   ]
     5354    .
     5355   define variable hst-psevdo-bush_bush-head as character no-undo extent 15 init
     5356   [
     5357     'c-auto-tank':U
     5358   ,'c-cash-desk':U
     5359   ,'c-cash-pay':U
     5360   ,'c-dis-card-type':U
     5361   ,'c-fbr-prn':U
     5362   ,'c-prop-head':U
     5363   ,'c-ruledict':U
     5364   ,'c-scales':U
     5365   ,'c-sert':U
     5366    ]
     5367    .
     5368   define variable hst-bush_bush-contain as character no-undo .
     5369   define variable hst-bush_bush-main as character no-undo .
     5370   define variable hst-bush_bush-join as character no-undo .
     5371   if p-unload-history then do:
     5372   create hst-bush.
     5373   assign
     5374   hst-bush.bush-head    = 'c-gds-hist':U
     5375   hst-bush.table-name =  'c-goods':U
     5376   hst-bush.is-main    = yes
     5377   hst-bush.where-phrase    = " true ~
     5378   , first ub.c-gds-hist no-lock where ub.c-gds-hist.gds-code = ub.c-goods.gds-code ~
     5379   and ub.c-gds-hist.corr-user-db-num = ub.c-goods.corr-user-db-num ~
     5380   and ub.c-gds-hist.chip-num = ub.c-goods.chip-num ~
     5381   ".
     5382   create hst-bush.
     5383   assign
     5384   hst-bush.bush-head    = 'c-gds-hist':U
     5385   hst-bush.table-name = 'c-gds-obj-attr':U
     5386   hst-bush.is-main    =  yes
     5387   hst-bush.where-phrase = " true ~
     5388   , first ub.c-gds-hist  no-lock where ub.c-gds-hist.gds-code = ub.c-gds-obj-attr.gds-code ~
     5389   and ub.c-gds-hist.corr-user-db-num = ub.c-gds-obj-attr.corr-user-db-num ~
     5390   and ub.c-gds-hist.chip-num = ub.c-gds-obj-attr.chip-num ~
     5391   ".
     5392   create hst-bush.
     5393   assign
