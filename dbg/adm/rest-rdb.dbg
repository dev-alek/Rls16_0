      517           end.
      518         end.
      519         if v-avail1 = 0
      520           and buf_code-range.stts = "u":U
      521         then do:
      522           find first buf-c_code-range exclusive-lock
      523             where rowid( buf-c_code-range ) = rowid( buf_code-range )
