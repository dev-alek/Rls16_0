     8829     on error  undo, return error substitute( "&1 (disable-load-triggers-dst). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     8830     on stop   undo, return error substitute( "&1 (disable-load-triggers-dst). stop", vss-workfile )
     8831     on endkey undo, return error substitute( "&1 (disable-load-triggers-dst). endkey", vss-workfile )
     8832     :
     8833       create buffer bh for table substitute( "dst.&1", dst._file._file-name ) .
     8834       bh:disable-load-triggers(true) .
     8835       delete object bh .
     8836     end.
     8837     if p-type-unload = 'unload-copy':U then do:
