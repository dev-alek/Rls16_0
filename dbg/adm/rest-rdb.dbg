     1155         q_h6:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
     1156                           ,v-table-name6
     1157                           ,v-field-name6
     1158                           ,p-first-code
     1159                           ,p-last-code)
     1160                           ).
     1161         q_h6:QUERY-OPEN.
     1162         REPEAT while  q_h6:get-next().
     1163           assign
     1164             v-code_6 = buf_h6:buffer-field(v-field-name6):buffer-value
     1165           .
     1166           leave .
     1167         END.
     1168         q_h6:QUERY-CLOSE().
     1169         delete object q_h6.
     1170         delete object buf_h6.
     1171         v-b-code = max(v-code_6, v-b-code).
     1172       end.
     1173     end.
     1174     when "f-u":U then do:
     1175       for each buf_code-range share-lock
     1176           where ( buf_code-range.range-type = p-curr-type-cdrg
     1177                   and buf_code-range.db-num = p-db-num
     1178                   and buf_code-range.stts = "f":U
     1179                 ) or
     1180                 ( buf_code-range.range-type = p-curr-type-cdrg
     1181                   and buf_code-range.db-num = p-db-num
     1182                   and buf_code-range.stts = "u":U
     1183                 )
     1184       on error undo, return error
     1185       :
     1186         v-avail6 = 0.
     1187         do v-ii6 = 1 to num-entries('dst.dis-rule,dst.dis-time-rule'):
     1188           assign
     1189           v-table-name6 = entry(v-ii6, 'dst.dis-rule,dst.dis-time-rule')
     1190           v-field-name6 = entry(v-ii6, 'rule-num,time-rule-num')
     1191           .
     1192           create buffer buf_h6 for table v-table-name6.
     1193           glog6 = buf_h6:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1194                                   , v-table-name6
     1195                                   , v-field-name6
     1196                                   , buf_code-range.first-code
     1197                                   , buf_code-range.last-code)
     1198                                   ) no-error .
     1199           if buf_h6:available then do:
     1200             assign
     1201             v-avail6 = v-avail6 + 1
     1202             .
     1203             if v-avail6 = 1 then do:
     1204               v-code-mess6 = string(buf_h6:buffer-field(v-field-name6):buffer-value)
     1205               .
     1206             end.
     1207           end.
     1208           delete object buf_h6.
     1209        end.
     1210        if v-avail6 > 0
     1211           and buf_code-range.stts = "f":U
     1212         then do:
     1213           assign
     1214             buf_code-range.stts = "u":U
     1215             v-b-code            = v-b-code + 1
     1216             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1217                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1218                                               , chr(10)
     1219                                               , buf_code-range.first-code
     1220                                               , buf_code-range.last-code
     1221                                               , v-code-mess6
     1222                                             )
     1223           .
