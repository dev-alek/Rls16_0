     7115   table-host-obj-where = fill(chr(4), num-entries(table-host-obj) - 1 )
     7116   table-host-obj-if-cond = fill(chr(4), num-entries(table-host-obj) - 1)
     7117   .
     7118   assign
     7119   table-Xobj        = '':U
     7120   table-Xobj-fields = '':U
     7121   table-Xobj-where  = fill( chr(4), num-entries( table-Xobj ) - 1 )
     7122   table-Xobj-if-cond  = fill( chr(4), num-entries( table-Xobj ) - 1 )
     7123   .
     7124   assign
     7125   table-firm-db = '~
     7126   arh-fin-doc-an~
     7127   ,arh-fin-doc-an-nal~
     7128   ,arh-fin-doc-c-schet-tax-nal~
     7129   ,arh-fin-doc-contr-schet~
     7130   ,arh-fin-doc-contr-schet-nal~
     7131   ,arh-fin-doc-contr-schet-tax~
     7132   ,arh-fin-doc-schet~
     7133   ,arh-fin-doc-schet-nal~
     7134   ,arh-fin-doc-schet-tax~
     7135   ,arh-fin-doc-schet-tax-nal~
     7136   ,arh-fin-ob-contr~
     7137   ,c-contract~
     7138   ,c-contract-specif~
     7139   ,factur-connect~
     7140   ,factur-connect-line~
     7141   ,c-fin-bank~
     7142   ,fin-code-an-uchet~
     7143   ,fin-code-cel-nazn~
     7144   ,fin-code-cor-acc~
     7145   ,fin-connect~
     7146   ,fin-doc~
     7147   ,c-fin-doc~
     7148   ,fin-doc-attr~
     7149   ,c-fin-doc-attr~
     7150   ,fin-doc-tax~
     7151   ,c-fin-doc-tax~
     7152   ,c-fin-schet~
     7153   ,fin-statement~
     7154   ,c-fin-statement~
     7155   ,fin-statement-attr~
     7156   ,c-fin-statement-attr~
     7157   ,fin-statement-line~
     7158   ,c-fin-statement-line~
     7159   ,schet-fact-doc~
     7160   ,c-schet-fact-doc~
     7161   ,schet-fact-line~
     7162   ,c-schet-fact-line~
     7163   ':U
     7164   table-firm-db-where = fill(chr(4), num-entries(table-firm-db) - 1)
     7165   table-firm-db-if-cond = fill(chr(4), num-entries(table-firm-db) - 1)
     7166   table-firm-db-no = "~
     7167   fin-doc~
     7168   ,c-fin-doc~
     7169   ,fin-doc-attr~
     7170   ,c-fin-doc-attr~
     7171   ,fin-doc-tax~
     7172   ,c-fin-doc-tax~
     7173   ,fin-statement~
     7174   ,c-fin-statement~
     7175   ,fin-statement-attr~
     7176   ,c-fin-statement-attr~
     7177   ,fin-statement-line~
     7178   ,c-fin-statement-line~
     7179   ":U
     7180   .
     7181   assign
     7182   table-db       = '
     7183   action-post~
     7184   ,action-post-host~
     7185   ,action-post-menu-group~
     7186   ,action-post-obj~
     7187   ,action-post-role~
     7188   ,action-post-user-login~
     7189   ,action-role~
     7190   ,action-role-item~
     7191   ,action-role-item-gds~
     7192   ,action-role-item-gds-grp~
     7193   ,cash-desk~
     7194   ,c-cash-desk~
     7195   ,cash-desk-attr~
     7196   ,c-cash-desk-attr~
     7197   ,cd-event-log~
     7198   ,cd-event-log-attr~
     7199   ,config~
     7200   ,fbr-prn~
     7201   ,c-fbr-prn~
     7202   ,fbr-prn-gds~
     7203   ,c-fbr-prn-gds~
     7204   ,fbr-prn-grp~
     7205   ,c-fbr-prn-grp~
     7206   ,menu-user~
     7207   ,scales~
     7208   ,c-scales~
     7209   ,scales-attr~
     7210   ,c-scales-attr~
     7211   ,scales-grp~
     7212   ,c-scales-grp~
     7213   ,staff~
     7214   ,c-staff~
     7215   ,user-context-history~
     7216   ,user-host~
     7217   ,user-login~
     7218   ,user-login-action-item~
     7219   ,user-login-action-role~
     7220   ,user-login-attr~
     7221   ,user-menu-group~
     7222   ,user-obj~
     7223   ':U
     7224   table-db-where = fill(chr(4), num-entries(table-db) - 1)
     7225   table-db-if-cond = fill(chr(4), num-entries(table-db) - 1)
     7226   .
     7227   assign table-erprn    = '
     7228   goods~
     7229   ,goods-attr~
     7230   ,gds-host-attr~
     7231   ,gds-obj-prop~
     7232   ,recipe~
     7233   ,recipe-gds~
     7234   ,dis-gds-rule~
     7235   ,c-dis-gds-rule~
     7236   ,gds-obj~
     7237   ,gds-obj-attr~
     7238   ,c-gds-obj-attr~
     7239   ,c-gds-obj-ref~
     7240   ,code-range~
     7241   ,contract~
     7242   ,contract-line~
     7243   ,contract-specif~
     7244   ':U.
     7245   procedure prepare-tables :
     7246   define input parameter p-table-list as character no-undo .
     7247   define input parameter p-where-list as character no-undo .
     7248   define input parameter p-if-cond as character no-undo .
     7249   define input parameter p-obj-fields as character no-undo .
     7250   define input parameter p-dump-point as character no-undo .
     7251   define input parameter p-unload-history as logical no-undo .
     7252   define variable v-ii    as integer no-undo .
     7253   define variable v-count as integer   no-undo .
     7254   define buffer buf_rrdb-option for rrdb-option.
     7255   define buffer buf_hst-bush for hst-bush.
     7256   do
     7257   on error undo, return error
     7258   :
     7259     assign
     7260       v-count = num-entries(p-table-list)
     7261     .
     7262     if v-count <> num-entries(p-where-list, chr(4)) then do:
     7263       message
     7264         vss-workfile vss-revision vss-description skip
     7265         substitute("Список таблиц (первая таблица списка &1) не соответствует списку условий (where-list)", entry(1, p-table-list) ) skip
     7266         view-as alert-box error .
     7267       return error.
     7268     end.
     7269     if v-count <> num-entries(p-if-cond, chr(4)) then do:
     7270       message
     7271         vss-workfile vss-revision vss-description skip
     7272         substitute("Список таблиц (первая таблица списка &1) не соответствует списку условий (if-cond)", entry(1, p-table-list) ) skip
     7273         view-as alert-box error .
     7274       return error.
     7275     end.
     7276     if v-count <> num-entries(p-obj-fields, chr(4))
     7277       and trim(p-obj-fields) <> '':U
     7278     then do:
     7279       message
     7280         vss-workfile vss-revision vss-description skip
     7281         substitute("Список таблиц (первая таблица списка &1) не соответствует списку условий (obj-fields)", entry(1, p-table-list) ) skip
     7282         view-as alert-box error .
     7283       return error.
     7284     end.
     7285     _v-ii:
     7286     do v-ii = 1 to v-count
     7287     :
     7288       if p-unload-history = no
     7289       and entry(v-ii, p-table-list) begins "c-" then next _v-ii.
     7290       if mode-erprn and  lookup(entry(v-ii, p-table-list),table-erprn) > 0 then next _v-ii.
     7291       create buf_rrdb-option.
     7292       assign
     7293       buf_rrdb-option.first-table-name = entry(v-ii, p-table-list)
     7294       buf_rrdb-option.where-phrase     = entry(v-ii, p-where-list, chr(4))
     7295       buf_rrdb-option.if-phrase        = entry(v-ii, p-if-cond,  chr(4))
     7296       buf_rrdb-option.obj-fields       = (if trim(p-obj-fields) = '':U
     7297                                           then '':U
     7298                                           else entry(v-ii, p-obj-fields, chr(4))
     7299                                           )
     7300       buf_rrdb-option.dump-point       = p-dump-point
     7301       buf_rrdb-option.subject-group    = '':U
     7302       buf_rrdb-option.id = rest-rdb_id + 1
     7303       rest-rdb_id = rest-rdb_id + 1
     7304       .
     7305       CASE p-dump-point:
     7306         when "obj" then do:
     7307           if buf_rrdb-option.where-phrase = '':U
     7308           then do:
     7309             buf_rrdb-option.where-phrase =  substitute(' (&1.obj-type = "&&1" and &1.obj-code = &&2) '
     7310                                                         ,buf_rrdb-option.first-table-name
     7311                                                        )
     7312             .
     7313           end.
     7314           else do:
     7315             buf_rrdb-option.where-phrase =  substitute('(&1) and (&2.obj-type = "&&1" and &2.obj-code = &&2 ) '
     7316                                                       ,buf_rrdb-option.where-phrase
     7317                                                       ,buf_rrdb-option.first-table-name
     7318                                                        )
     7319             .
     7320           end.
     7321         end.
     7322         when "host-obj" then do:
     7323           if buf_rrdb-option.where-phrase = '':U
     7324           then do:
     7325             buf_rrdb-option.where-phrase =  substitute(' (&1.host-code = &&3 and &1.obj-type = "&&1" and &1.obj-code = &&2) '
     7326                                                         ,buf_rrdb-option.first-table-name
     7327                                                        )
     7328             .
     7329           end.
     7330           else do:
     7331             buf_rrdb-option.where-phrase =  substitute('(&1) and (&2.host-code = &&3 and &2.obj-type = "&&1" and &2.obj-code = &&2 ) '
     7332                                                       ,buf_rrdb-option.where-phrase
     7333                                                       ,buf_rrdb-option.first-table-name
     7334                                                        )
     7335             .
     7336           end.
     7337         end.
     7338         when "db" then do:
     7339           if buf_rrdb-option.where-phrase = '':U
     7340           then do:
     7341             buf_rrdb-option.where-phrase =  substitute(" (&1.db-num = &2) "
     7342                                                         ,buf_rrdb-option.first-table-name
     7343                                                         ,p-db-num
     7344                                                        )
     7345             .
     7346           end.
     7347           else do:
     7348             buf_rrdb-option.where-phrase =  substitute("(&1) and (&2.db-num = &3) "
     7349                                                       ,buf_rrdb-option.where-phrase
     7350                                                       ,buf_rrdb-option.first-table-name
     7351                                                       ,p-db-num
     7352                                                        )
     7353             .
     7354           end.
     7355         end.
     7356         when "firm-db" then do:
     7357           if buf_rrdb-option.where-phrase = '':U
     7358           then do:
     7359             buf_rrdb-option.where-phrase =  substitute(" (&1.host-code = &&1) "
     7360                                                         ,buf_rrdb-option.first-table-name
     7361                                                        )
     7362             .
     7363           end.
     7364           else do:
     7365             buf_rrdb-option.where-phrase =  substitute("(&1) and (&2.host-code = &&1) "
     7366                                                       ,buf_rrdb-option.where-phrase
     7367                                                       ,buf_rrdb-option.first-table-name
     7368                                                        )
     7369             .
     7370           end.
     7371         end.
     7372         when "Xobj" then do:
     7373           if buf_rrdb-option.where-phrase = '':U
     7374           then do:
     7375             buf_rrdb-option.where-phrase =  substitute(' (&1.&2 = "&&1" and &1.&3 = &&2) '
     7376                                                         ,buf_rrdb-option.first-table-name
     7377                                                         , entry(1, buf_rrdb-option.obj-fields, chr(32))
     7378                                                         , entry(2, buf_rrdb-option.obj-fields, chr(32))
     7379                                                        )
     7380             .
     7381           end.
     7382           else do:
     7383             buf_rrdb-option.where-phrase =  substitute(' (&1) and (&2.&3 = "&&1" and &2.&4 = &&2) '
     7384                                                         ,buf_rrdb-option.where-phrase
     7385                                                         ,buf_rrdb-option.first-table-name
     7386                                                         ,entry(1, buf_rrdb-option.obj-fields, chr(32))
     7387                                                         ,entry(2, buf_rrdb-option.obj-fields, chr(32))
     7388                                                        )
     7389             .
     7390           end.
     7391         end.
     7392       END CASE.
     7393       if buf_rrdb-option.first-table-name begins "c-":U
     7394       or lookup(buf_rrdb-option.first-table-name, 'tax-rate-gds':U + chr(44) +
     7395                                                   'tax-rate-value':U + chr(44) +
     7396                                                   'auto-tank-meas':U) > 0
     7397       then do:
     7398         find first buf_hst-bush where
     7399                   buf_hst-bush.table-name = buf_rrdb-option.first-table-name
     7400               and buf_hst-bush.is-main = yes            no-error .
     7401         if available buf_hst-bush then do:
     7402           if buf_rrdb-option.first-table-name <> buf_hst-bush.bush-head then do:
     7403             assign
     7404             buf_rrdb-option.second-table-name = buf_hst-bush.bush-head
     7405             .
     7406             if buf_hst-bush.joined-buffers <> '':U then do:
     7407               if num-entries(buf_hst-bush.joined-buffers) >= 1 then do:
     7408                   assign
     7409                   buf_rrdb-option.third-table-name = entry(1, buf_hst-bush.joined-buffers)
     7410                   .
     7411               end.
     7412               if num-entries(buf_hst-bush.joined-buffers) >= 2 then do:
     7413                   assign
     7414                   buf_rrdb-option.fourth-table-name = entry(2, buf_hst-bush.joined-buffers)
     7415                   .
     7416               end.
     7417               if num-entries(buf_hst-bush.joined-buffers) >= 3 then do:
     7418                   assign
     7419                   buf_rrdb-option.fifth-table-name = entry(3, buf_hst-bush.joined-buffers)
     7420                   .
     7421               end.
     7422               if num-entries(buf_hst-bush.joined-buffers) >= 4 then do:
     7423                   assign
     7424                   buf_rrdb-option.sixth-table-name = entry(4, buf_hst-bush.joined-buffers)
     7425                   .
     7426               end.
     7427             end.
     7428           end.
     7429           assign
     7430           buf_rrdb-option.where-phrase = substitute("&1 &2"
     7431                                                     ,(if buf_rrdb-option.where-phrase <> '':U
     7432                                                      then substitute("(&1) and "
     7433                                                                      ,buf_rrdb-option.where-phrase )
     7434                                                      else '':U)
     7435                                                     ,buf_hst-bush.where-phrase)
     7436           .
     7437         end.
     7438       end.
     7439     end.
     7440   end.
     7441   end procedure.
     7442   procedure prepare-dc :
     7443   define input parameter p-db-num as integer no-undo .
     7444   define input parameter p-unload-history as logical no-undo .
     7445   define buffer buf_prop-head for ub.prop-head.
     7446   define buffer buf_prop-ref for ub.prop-ref.
     7447   define buffer buf_dis-card-type for ub.dis-card-type.
     7448   define buffer buf0_hist-nws-option for ub.hist-nws-option.
     7449   define buffer buf_rrdb-option for rrdb-option.
     7450   define buffer buf_dis-obj for ub.dis-obj.
     7451   define buffer buf_dis-host for ub.dis-host.
     7452   define buffer buf_clients for ub.clients.
     7453   do
     7454   on error undo, return error
     7455   :
     7456     for each buf_Dis-card-type no-lock:
     7457       if buf_dis-card-type.host-code > 0
     7458       or buf_dis-card-type.obj-code > 0 then next.
     7459       create buf_rrdb-option.
     7460       assign
     7461       buf_rrdb-option.first-table-name = 'dis-card':U
     7462       buf_rrdb-option.second-table-name = ''
     7463       buf_rrdb-option.where-phrase = substitute(' ub.dis-card.emitent-host-code = &1 and ub.dis-card.type = "&2" '
     7464                                             , buf_dis-card-type.emitent-host-code
     7465                                             , buf_dis-card-type.type)
     7466       buf_rrdb-option.if-phrase = ''
     7467       buf_rrdb-option.dump-point = "ref"
     7468       buf_rrdb-option.subject-group = "dc"
     7469       buf_rrdb-option.id = rest-rdb_id + 1
     7470       buf_rrdb-option.des = substitute("dis-card: type = &1", buf_dis-card-type.type)
     7471       rest-rdb_id = rest-rdb_id + 1
     7472       .
     7473       create buf_rrdb-option.
     7474       assign
     7475       buf_rrdb-option.first-table-name = 'dis-card':U
     7476       buf_rrdb-option.first-table-export = no
     7477       buf_rrdb-option.second-table-name = 'dis-card-long':U
     7478       buf_rrdb-option.where-phrase = substitute(' ub.dis-card.emitent-host-code = &1 and ub.dis-card.type = "&2", ' +
     7479                                             'each ub.dis-card-long no-lock where ub.dis-card-long.d-card = ub.dis-card.d-card '
     7480                                             , buf_dis-card-type.emitent-host-code
     7481                                             , buf_dis-card-type.type)
     7482       buf_rrdb-option.if-phrase = ''
     7483       buf_rrdb-option.dump-point = "ref"
     7484       buf_rrdb-option.subject-group = "dc"
     7485       buf_rrdb-option.id = rest-rdb_id + 1
     7486       buf_rrdb-option.des = substitute("dis-card-long: type = &1", buf_dis-card-type.type)
     7487       rest-rdb_id = rest-rdb_id + 1
     7488       .
     7489       create buf_rrdb-option.
     7490       assign
     7491       buf_rrdb-option.first-table-name = 'dis-card':U
     7492       buf_rrdb-option.first-table-export = no
     7493       buf_rrdb-option.second-table-name = 'dis-card-property':U
     7494       buf_rrdb-option.where-phrase = substitute('ub.dis-card.emitent-host-code = &1 and ub.dis-card.type = "&2", ' +
     7495                                             'each ub.dis-card-property no-lock where ub.dis-card-property.d-card = ub.dis-card.d-card and ' +
     7496                                             'ub.dis-card-property.obj-type = "&3"'
     7497                                             , buf_dis-card-type.emitent-host-code
     7498                                             , buf_dis-card-type.type
     7499                                             , '':U
     7500                                             )
     7501       buf_rrdb-option.if-phrase = ''
     7502       buf_rrdb-option.dump-point = "ref"
     7503       buf_rrdb-option.subject-group = "dc"
     7504       buf_rrdb-option.id = rest-rdb_id + 1
     7505       buf_rrdb-option.des = substitute("dis-card-property: type = &1", buf_dis-card-type.type)
     7506       rest-rdb_id = rest-rdb_id + 1
     7507       .
     7508       create buf_rrdb-option.
     7509       assign
     7510       buf_rrdb-option.first-table-name = 'dis-card':U
     7511       buf_rrdb-option.first-table-export = no
     7512       buf_rrdb-option.second-table-name = 'dis-dc-rule':U
     7513       buf_rrdb-option.where-phrase = substitute('ub.dis-card.emitent-host-code = &1 and ub.dis-card.type = "&2", '  +
     7514                                             'each ub.dis-dc-rule no-lock where ub.dis-dc-rule.d-card = ub.dis-card.d-card and ' +
     7515                                             'ub.dis-dc-rule.obj-type = "&3"'
     7516                                             , buf_dis-card-type.emitent-host-code
     7517                                             , buf_dis-card-type.type
     7518                                             , '':U)
     7519       buf_rrdb-option.if-phrase = ''
     7520       buf_rrdb-option.dump-point = "ref"
     7521       buf_rrdb-option.subject-group = "dc"
     7522       buf_rrdb-option.id = rest-rdb_id + 1
     7523       buf_rrdb-option.des = substitute("dis-dc-rule: type = &1", buf_dis-card-type.type)
     7524       rest-rdb_id = rest-rdb_id + 1
     7525       .
     7526       for each buf_prop-head where
     7527               buf_prop-head.general contains 'dis-card-type':U:
     7528         if buf_prop-head.storage-place-host = 'dis-host':U
     7529         then do:
     7530           find first buf0_hist-nws-option where
     7531                     buf0_hist-nws-option.table-name = 'dis-host':U
     7532                 and buf0_hist-nws-option.db-num = 0
     7533                 and buf0_hist-nws-option.host-code = buf_dis-card-type.emitent-host-code
     7534                 and buf0_hist-nws-option.charkey_one = buf_Dis-card-type.type
     7535                 and buf0_hist-nws-option.charkey_two = '':U
     7536                 and buf0_hist-nws-option.charkey_three = '':U
     7537                 and buf0_hist-nws-option.key#_one = buf_prop-head.dtm-code
     7538                 and buf0_hist-nws-option.key#_two = 0
     7539                 and buf0_hist-nws-option.key#_three = 0
     7540                 and buf0_hist-nws-option.obj-type = ''
     7541                 and buf0_hist-nws-option.obj-code = 0
     7542                 no-error .
     7543         if NOT available buf0_hist-nws-option
     7544         or (available buf0_hist-nws-option
     7545             and
     7546                  (buf0_hist-nws-option.smart-nws = integer('-1':U)
     7547                   or buf0_hist-nws-option.smart-nws = integer('-10':U))
     7548             )
     7549         then do:
     7550           for each buf_prop-ref no-lock where
     7551                   buf_prop-ref.dtm-code = buf_prop-head.dtm-code:
     7552             create buf_rrdb-option.
     7553             assign
     7554             buf_rrdb-option.first-table-name = 'dis-card':U
     7555             buf_rrdb-option.first-table-export = no
     7556             buf_rrdb-option.second-table-name = 'dis-host':U
     7557             buf_rrdb-option.where-phrase = substitute('ub.dis-card.emitent-host-code = &1 and ub.dis-card.type = "&2", '  +
     7558                                                 'each ub.dis-host no-lock where ub.dis-host.d-card = ub.dis-card.d-card and ' +
     7559                                                 'ub.dis-host.dt-code = &3'
     7560                                                   , buf_dis-card-type.emitent-host-code
     7561                                                   , buf_dis-card-type.type
     7562                                                   , buf_prop-ref.dt-code
     7563                                                   )
     7564             buf_rrdb-option.if-phrase = ''
     7565             buf_rrdb-option.dump-point = "ref"
     7566             buf_rrdb-option.subject-group = "dc"
     7567             buf_rrdb-option.id = rest-rdb_id + 1
     7568             buf_rrdb-option.des = substitute("dis-host: type = &1 dtm-code = &2 dt-code = &3"
     7569                                             , buf_dis-card-type.type
     7570                                             ,buf_prop-head.dtm-code
