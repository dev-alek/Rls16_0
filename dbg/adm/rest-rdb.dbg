     1145   case p-action :
     1146     when "get-m-code":U then do:
     1147       do v-ii6 = 1 to num-entries('dst.dis-rule,dst.dis-time-rule'):
     1148         assign
     1149         v-table-name6 = entry(v-ii6, 'dst.dis-rule,dst.dis-time-rule')
     1150         v-field-name6 = entry(v-ii6, 'rule-num,time-rule-num')
     1151         .
