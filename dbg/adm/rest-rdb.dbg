    12770         for each ub.c-gds-dtl no-lock
    12771             where ub.c-gds-dtl.doc-code = ub.c-trn-doc.doc-code
    12772         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12773         :
    12774           create dst.c-gds-dtl.
    12775           buffer-copy  ub.c-gds-dtl to dst.c-gds-dtl.
    12776         end.
    12777         for each ub.c-parts no-lock
    12778           where ub.c-parts.out-code = ub.c-trn-doc.doc-code
    12779         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12780         :
    12781           run process-c-parts in this-procedure .
    12782         end.
    12783         for each ub.c-parts-root no-lock
