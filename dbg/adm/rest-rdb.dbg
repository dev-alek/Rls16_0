    12737           end.
    12738         end.
    12739       end.
    12740     end.
    12741     return.
    12742   end procedure.
    12743   procedure rest-c-trn-doc :
    12744     define input parameter p-trn_obj-type as character no-undo .
    12745     define input parameter p-trn_obj-code as integer   no-undo .
    12746     do
    12747     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12748     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12749     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12750     :
    12751       assign ind1 = 0
    12752              fl   = "c-trn-doc is-del".
    12753       for each ub.c-trn-doc no-lock
    12754           where ub.c-trn-doc.obj-type = p-trn_obj-type
    12755             and ub.c-trn-doc.obj-code = p-trn_obj-code
    12756             and ub.c-trn-doc.is-del   = true
    12757       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12758       :
    12759         assign  ind1 = ind1 + 1.
    12760         display ind1 count-str fl with frame ddd view-as dialog-box.
    12761         create dst.c-trn-doc.
    12762         buffer-copy ub.c-trn-doc to dst.c-trn-doc.
    12763         for each ub.c-doc-line no-lock
    12764             where ub.c-doc-line.doc-code = ub.c-trn-doc.doc-code
    12765         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12766         :
