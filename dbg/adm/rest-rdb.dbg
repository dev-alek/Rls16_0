     2576   procedure gds-o-normal-wastage-value :
     2577     define input-output parameter objNormWast as class ibs.th.ref.normwastsub no-undo.
     2578   do
     2579   on error undo, return error
     2580   :
     2581           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-o-normal-wastage-value in g#attr-lib
     2582         (input-output objNormWast
     2583         ) no-error .
     2584       if error-status :error
     2585       then do:
     2586         undo, return error return-value .
     2587       end.
     2588     end.
     2589   end.
     2590   procedure gdsoattr-copy :
     2591     define input  parameter p-code as character no-undo .
     2592     define output parameter p-copy as logical   no-undo .
     2593     do
     2594     on error undo, return error
     2595     :
     2596           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-copy in g#attr-lib
     2597         (input  p-code
     2598         ,output p-copy
     2599         ) no-error .
     2600       if error-status :error
     2601       then do:
     2602         undo, return error return-value .
     2603       end.
     2604     end.
     2605   end.
     2606   procedure gds-attr_check-code-dt-seasons :
     2607     define input  parameter p-code     like ub.goods.gds-code   no-undo .
     2608     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     2609     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
     2610     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
     2611     define output parameter p-dt-code  as   integer             no-undo .
     2612     do
     2613     on error undo, return error
     2614     :
     2615           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
     2616         (input p-code
     2617         ,input p-obj-type
     2618         ,input p-obj-code
     2619         ,output p-gds-code
     2620         ,output p-dt-code
     2621         ) no-error .
     2622       if error-status :error
     2623       then do:
     2624         undo, return error return-value .
     2625       end.
     2626     end.
     2627   end.
     2628   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2629   procedure gen-b-code :
     2630     define input  parameter type-code like ub.code-range.range-type no-undo .
     2631     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     2632     do
     2633     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2634     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     2635     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     2636     :
     2637       define buffer buf_thbj-attr     for ub.thbj-attr .
     2638       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     2639       define buffer buf_code-range for ub.code-range .
     2640       define variable l-code         as   integer              no-undo .
     2641       define variable v-db-num       like ub.db.db-num         no-undo .
     2642       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2643       if type-code = 'sslc':U
     2644       or type-code = 'ssgb':U
     2645       then do:
     2646         message
     2647           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     2648           "Обратитесь к администратору системы."
     2649           view-as alert-box error .
     2650         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     2651       end.
     2652       run trg/getpcode.p ( input  type-code
     2653                      ,output cfg-param-code
     2654                     ).
     2655       run get-next-seq( input  type-code,
     2656                         output l-code
     2657                       ).
     2658       find first buf_sys-ctrl no-lock.
     2659       if type-code = 'sclc':U
     2660       or type-code = 'pglc':U
     2661       then do:
     2662         assign
     2663           v-db-num = 0
     2664         .
     2665       end.
     2666       else do:
     2667         assign
     2668           v-db-num = buf_sys-ctrl.db-num
     2669         .
     2670       end.
     2671       find first buf_code-range no-lock
     2672         where buf_code-range.db-num     = v-db-num
     2673           and buf_code-range.range-type = type-code
     2674           and buf_code-range.stts       = "a"
     2675         use-index stts
     2676         no-error .
     2677       if available buf_code-range
     2678          and l-code <= buf_code-range.last-code
     2679          and l-code >= buf_code-range.first-code then do:
     2680         assign
     2681           p-b-code = l-code
     2682         .
     2683       end.
     2684       else do:
     2685         if available buf_code-range
     2686            and l-code < buf_code-range.last-code then do:
     2687           message
     2688             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     2689             "Обратитесь к администратору системы."
     2690             view-as alert-box error .
     2691           undo, return error "sequence":U .
     2692         end.
     2693         do transaction
     2694         on error undo, return error
     2695         :
     2696           find first buf_thbj-attr exclusive-lock
     2697             where buf_thbj-attr.upper-prop-code = 'code-range':U
     2698               and buf_thbj-attr.prop-code = cfg-param-code
     2699               and buf_thbj-attr.obj-type   = 'БД':U
     2700               and buf_thbj-attr.obj-code   = v-db-num
     2701             no-error .
     2702           if not available buf_thbj-attr then do:
     2703             find first buf_thbj-attr exclusive-lock
     2704               where buf_thbj-attr.upper-prop-code = 'code-range':U
     2705                 and buf_thbj-attr.prop-code = cfg-param-code
     2706                 and buf_thbj-attr.obj-type   = ''
     2707                 and buf_thbj-attr.obj-code   = 0
     2708               no-error .
     2709             if not available buf_thbj-attr then do:
     2710               if not locked buf_thbj-attr then do:
     2711                 message
     2712                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     2713                   "Обратитесь к администратору системы."
     2714                   view-as alert-box error .
     2715               end.
     2716               undo, return error "config":U .
     2717             end.
     2718           end.
     2719           run get-next-seq( input type-code,
     2720                             output l-code
     2721                           ).
     2722           find first buf_code-range
     2723             where buf_code-range.db-num     = v-db-num
     2724               and buf_code-range.range-type = type-code
     2725               and buf_code-range.stts       = "a"
     2726             use-index stts
     2727             no-error .
     2728           if available buf_code-range
     2729           and l-code <= buf_code-range.last-code
     2730           and l-code >= buf_code-range.first-code
     2731           then do:
     2732             assign
     2733               p-b-code = l-code
     2734             .
     2735           end.
     2736           else do:
     2737             if available buf_code-range then do:
     2738               assign
     2739                 buf_code-range.stts = "u"
     2740               .
     2741             end.
     2742             find first buf_code-range
     2743               where buf_code-range.db-num     = v-db-num
     2744                 and buf_code-range.range-type = type-code
     2745                 and buf_code-range.stts       = "f"
     2746               use-index stts
     2747               no-error .
     2748             if not available buf_code-range then do:
     2749               message
     2750                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     2751                 "Обратитесь к администратору системы"
     2752                 view-as alert-box error .
     2753               undo, return error "code-range":U .
     2754             end.
     2755             assign
     2756               buf_code-range.stts           = "a"
     2757             .
     2758             if buf_code-range.first-code = 1 then do:
     2759               run set-seq-cr( input type-code,
     2760                               input buf_code-range.first-code
     2761                             ).
     2762               assign
     2763                 p-b-code = 1
     2764               .
     2765             end.
     2766             else do:
     2767               run set-seq-cr( input type-code,
     2768                               input ( buf_code-range.first-code - 1 )
     2769                             ).
     2770               run get-next-seq( input type-code,
     2771                                 output p-b-code
     2772                               ).
     2773             end.
     2774           end.
     2775         end.
     2776       end.
     2777     end.
     2778   end procedure.
     2779   procedure get-next-seq :
     2780     define input  parameter type-code like ub.code-range.range-type no-undo .
     2781     define output parameter next-seq  as   integer                  no-undo .
     2782     do
     2783     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2784     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     2785     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     2786     :
     2787       case type-code:
     2788         when 'bcgb':U then do:
     2789           assign
     2790             next-seq = next-value(s-bcgb-code, ub)
     2791           .
     2792         end.
     2793         when 'scgb':U then do:
     2794           assign
     2795             next-seq = next-value(s-scgb-code, ub)
     2796           .
     2797         end.
     2798         when 'sclc':U then do:
     2799           assign
     2800             next-seq = next-value(s-sclc-code, ub)
     2801           .
     2802         end.
     2803         when 'pglc':U then do:
     2804           assign
     2805             next-seq = next-value(s-pglc-code, ub)
     2806           .
     2807         end.
     2808         when 'dcgb':U then do:
     2809           assign
     2810             next-seq = next-value(s-dcgb-code, ub)
     2811           .
     2812         end.
     2813         when 'ctgb':U then do:
     2814           assign
     2815             next-seq = next-value(s-ctgb-code, ub)
     2816           .
     2817         end.
     2818         when 'drgb':U then do:
     2819           assign
     2820             next-seq = next-value(s-drgb-code, ub)
     2821           .
     2822         end.
     2823         when 'fmgb':U then do:
     2824           assign
     2825             next-seq = next-value(s-fmgb-code, ub)
     2826           .
     2827         end.
     2828         when 'pngb':U then do:
     2829           assign
     2830             next-seq = next-value(s-pngb-code, ub)
     2831           .
     2832         end.
     2833         when 'cagb':U then do:
     2834           assign
     2835             next-seq = next-value(s-cagb-code, ub)
     2836           .
     2837         end.
     2838         when 'fdgb':U then do:
     2839           assign
     2840             next-seq = next-value(s-fin-doc, ub)
     2841           .
     2842         end.
     2843       end case.
     2844     end.
     2845   end procedure.
     2846   procedure set-seq-cr :
     2847     define input parameter type-code like ub.code-range.range-type no-undo .
     2848     define input parameter set-val   like ub.code-range.first-code no-undo .
     2849     do
     2850     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2851     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     2852     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     2853     :
     2854       case type-code:
     2855         when 'bcgb':U then do:
     2856           assign
     2857             current-value(s-bcgb-code, ub) = set-val
     2858           .
     2859         end.
     2860         when 'scgb':U then do:
     2861           assign
     2862             current-value(s-scgb-code, ub) = set-val
     2863           .
     2864         end.
     2865         when 'sclc':U then do:
     2866           assign
     2867             current-value(s-sclc-code, ub) = set-val
     2868           .
     2869         end.
     2870         when 'pglc':U then do:
     2871           assign
     2872             current-value(s-pglc-code, ub) = set-val
     2873           .
     2874         end.
     2875         when 'dcgb':U then do:
     2876           assign
     2877             current-value(s-dcgb-code, ub) = set-val
     2878           .
     2879         end.
     2880         when 'ctgb':U then do:
     2881           assign
     2882             current-value(s-ctgb-code, ub) = set-val
     2883           .
     2884         end.
     2885         when 'drgb':U then do:
     2886           assign
     2887             current-value(s-drgb-code, ub) = set-val
     2888           .
     2889         end.
     2890         when 'fmgb':U then do:
     2891           assign
     2892             current-value(s-fmgb-code, ub) = set-val
     2893           .
     2894         end.
     2895         when 'pngb':U then do:
     2896           assign
     2897             current-value(s-pngb-code, ub) = set-val
     2898           .
     2899         end.
     2900         when 'cagb':U then do:
     2901           assign
     2902             current-value(s-cagb-code, ub) = set-val
     2903           .
     2904         end.
     2905         when 'fdgb':U then do:
     2906           assign
     2907             current-value(s-fin-doc, ub) = set-val
     2908           .
     2909         end.
     2910       end case.
     2911     end.
     2912   end procedure.
     2913   procedure new-bcod-gen-code-range :
     2914     do
     2915     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2916     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2917     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2918     :
     2919       define input parameter p-db-num  like ub.db.db-num             no-undo .
     2920       define input parameter type-code like ub.code-range.range-type no-undo .
     2921       define buffer buf_code-range      for ub.code-range .
     2922       define buffer last_code-range     for ub.code-range .
     2923       define buffer last-1_code-range   for ub.code-range .
     2924       define buffer last-2_code-range   for ub.code-range .
     2925       define buffer last-3_code-range   for ub.code-range .
     2926       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     2927       define variable conf-par       as character no-undo .
     2928       define variable par-type       as character no-undo .
     2929       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2930       define variable v-cre-cdrg as logical   no-undo .
     2931       define variable v-cre-str  as character no-undo .
     2932       define variable v-cr1      as integer no-undo .
     2933       define variable v-cr2      as integer no-undo .
     2934       define variable v-cr3      as integer no-undo .
     2935       define variable v-cmax     as integer no-undo .
     2936       find first buf_sys-ctrl no-lock .
     2937       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     2938         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     2939                                       ,vss-workfile
     2940                                       ,vss-revision
     2941                                       ,vss-description
     2942                                       ,chr(10)
     2943                                       , p-db-num
     2944                                      ).
     2945       end.
     2946       run trg/getpcode.p ( input  type-code
     2947                      ,output cfg-param-code
     2948                     ).
     2949       for each buf_code-range
     2950         where buf_code-range.db-num     = -1
     2951           and buf_code-range.range-type = type-code
     2952           and buf_code-range.stts       = "f"
     2953       by buf_code-range.first-code
     2954       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2955       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2956       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2957       :
     2958         assign
     2959           buf_code-range.db-num = p-db-num
     2960         .
     2961         return .
     2962       end.
     2963       assign
     2964         v-cre-cdrg = TRUE
     2965       .
     2966       case type-code:
     2967         when 'sclc':U
     2968         or when 'scgb':U
     2969         or when 'pglc':U
     2970         then do:
     2971           find last last-1_code-range no-lock
     2972             where last-1_code-range.range-type = 'sclc':U
     2973             no-error .
     2974           if available last-1_code-range then do:
     2975             v-cr1 = last-1_code-range.last-code.
     2976           end.
     2977           find last last-2_code-range no-lock
     2978             where last-2_code-range.range-type = 'scgb':U
     2979             no-error .
     2980           if available last-2_code-range then do:
     2981             v-cr2 = last-2_code-range.last-code.
     2982             end.
     2983           find last last-3_code-range no-lock
     2984             where last-3_code-range.range-type = 'pglc':U
     2985             no-error .
     2986           if available last-3_code-range then do:
     2987             v-cr3 = last-3_code-range.last-code.
     2988           end.
     2989           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2990           .
     2991           if v-cmax = v-cr1  then do:
     2992               find last last_code-range no-lock
     2993                 where recid( last_code-range ) = recid( last-1_code-range )
     2994                 .
     2995             end.
     2996           if v-cmax = v-cr2  then do:
     2997               find last last_code-range no-lock
     2998                 where recid( last_code-range ) = recid( last-2_code-range )
     2999                 .
     3000             end.
     3001           if v-cmax = v-cr3  then do:
     3002             find last last_code-range no-lock
     3003               where recid( last_code-range ) = recid( last-3_code-range )
     3004               .
     3005           end.
     3006           if last_code-range.last-code + 1 > 99999 then do:
     3007             assign
     3008               v-cre-cdrg = FALSE
     3009             .
     3010           end.
     3011         end.
     3012         when 'bcgb':U
     3013         or when 'sslc':U
     3014         or when 'ssgb':U
     3015         then do:
     3016           find last last-1_code-range no-lock
     3017             where last-1_code-range.range-type = 'sslc':U
     3018             no-error .
     3019           if available last-1_code-range then do:
     3020             v-cr1 = last-1_code-range.last-code.
     3021           end.
     3022           find last last-2_code-range no-lock
     3023             where last-2_code-range.range-type = 'bcgb':U
     3024             no-error .
     3025           if available last-2_code-range then do:
     3026             v-cr2 = last-2_code-range.last-code.
     3027             end.
     3028           find last last-3_code-range no-lock
     3029             where last-3_code-range.range-type = 'ssgb':U
     3030             no-error .
     3031           if available last-3_code-range then do:
     3032             v-cr3 = last-3_code-range.last-code.
     3033           end.
     3034           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     3035           .
     3036           if v-cmax = v-cr1  then do:
     3037               find last last_code-range no-lock
     3038                 where recid( last_code-range ) = recid( last-1_code-range )
     3039                 .
     3040             end.
     3041           if v-cmax = v-cr2  then do:
     3042               find last last_code-range no-lock
     3043                 where recid( last_code-range ) = recid( last-2_code-range )
     3044                 .
     3045             end.
     3046           if v-cmax = v-cr3  then do:
     3047             find last last_code-range no-lock
     3048               where recid( last_code-range ) = recid( last-3_code-range )
     3049               .
     3050           end.
     3051         end.
     3052         otherwise do:
     3053           find last last_code-range no-lock
     3054             where last_code-range.range-type = type-code
     3055             no-error .
     3056         end.
     3057       end case.
     3058       if not available last_code-range then do:
     3059         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     3060                                       ,vss-workfile
     3061                                       ,vss-revision
     3062                                       ,vss-description
     3063                                       , chr(10)
     3064                                       , type-code
     3065                                      ) .
     3066       end.
     3067       define variable v-mes10 as character no-undo .
     3068       define variable v-param-type10 as character no-undo .
     3069       define variable v-value-character10 as INTEGER no-undo .
     3070       define variable v-value-date10 as date no-undo .
     3071       define variable v-value-decimal10 as decimal no-undo .
     3072       define variable v-value-integer10 AS integer no-undo .
     3073       define variable v-value-logical10 AS LOGICAL no-undo .
     3074       define variable v-tth10 as handle no-undo .
     3075       run adm/shattri.p (
     3076           input "get":U
     3077           ,input  'БД':U
     3078           ,input  p-db-num
     3079           ,input  'code-range':U
     3080           ,input  cfg-param-code
     3081           ,output v-value-character10
     3082           ,output v-value-date10
     3083           ,output v-value-decimal10
     3084           ,output v-value-integer10
     3085           ,output v-value-logical10
     3086           ,output v-param-type10
     3087           ,INPUT-OUTPUT table-handle v-tth10
     3088           ) no-error .
     3089       if error-status :error then do:
     3090         delete object v-tth10.
     3091         v-mes10 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     3092                            , error-status:get-message(1)
     3093                            , chr(10)
     3094                            , return-value ).
     3095         undo, return error v-mes10.
     3096       end.
     3097       delete object v-tth10.
     3098       if v-cre-cdrg = TRUE then do:
     3099         create buf_code-range .
     3100         assign
     3101           buf_code-range.db-num     = p-db-num
     3102           buf_code-range.range-type = type-code
     3103           buf_code-range.stts       = "f"
     3104           buf_code-range.first-code = last_code-range.last-code + 1
     3105           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer10)
     3106           v-cre-str = "Свободный диапазон успешно создан"
     3107         .
     3108       end.
     3109       else do:
     3110         assign
     3111           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     3112                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     3113         .
     3114       end.
     3115     end.
     3116     return v-cre-str .
     3117   end procedure.
     3118   procedure gen-new-code-range-if-neces :
     3119     define input parameter v-db-num           like ub.db.db-num             no-undo .
     3120     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     3121     define input parameter v-cur-code         as   integer                  no-undo .
     3122     define input parameter v-g#news           as   logical                  no-undo .
     3123     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     3124     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     3125     do
     3126     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3127     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     3128     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     3129     :
     3130       define variable l-code-range-exist as logical   no-undo init false .
     3131       define variable v-db-for-send      as character no-undo .
     3132       define buffer buf_code-range  for ub.code-range .
     3133       define buffer buf1_code-range for ub.code-range .
     3134       define buffer buf_db          for ub.db .
     3135       find first buf_code-range
     3136         where buf_code-range.range-type = v-range-type
     3137           and buf_code-range.last-code >= v-cur-code
     3138         use-index last-codei
     3139         no-error .
     3140       if
     3141       (
     3142          available buf_code-range
     3143          and
     3144         (buf_code-range.db-num = v-db-num
     3145           and
     3146         buf_code-range.first-code <= v-cur-code
     3147         )
     3148       or
     3149         (
     3150           v-range-type = 'drgb':U
     3151           AND
     3152           v-cur-code = 0
     3153         )
     3154      )
     3155      then do:
     3156         assign
     3157           l-code-range-exist = true
     3158         .
     3159         if v-g#news
     3160         and buf_code-range.stts = "f" then do:
     3161           assign
     3162             buf_code-range.stts = "u"
     3163           .
     3164         end.
     3165       end.
     3166       if not l-code-range-exist
     3167          and v-g#news-source-db <> 0
     3168       then do:
     3169         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     3170                                       ,vss-workfile
     3171                                       ,vss-revision
     3172                                       ,vss-description
     3173                                       ,chr(10)
     3174                                       ,v-db-num
     3175                                       ,v-range-type
     3176                                       ,v-cur-code
     3177                                      ).
     3178       end.
     3179       if (not l-code-range-exist
     3180           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     3181          )
     3182       and ( not can-find (first buf1_code-range no-lock
     3183                           where buf1_code-range.db-num = v-db-num
     3184                             and buf1_code-range.range-type = v-range-type
     3185                             and buf1_code-range.stts = "f"
     3186                          )
     3187           )
     3188       then do:
     3189         if v-g#db-num = 0 then do:
     3190           run new-bcod-gen-code-range in this-procedure
     3191             (input v-db-num,
     3192              input v-range-type
     3193             ) no-error .
     3194           if error-status :error then do:
     3195             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     3196                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     3197                                           ,v-db-num
     3198                                           ,v-range-type
     3199                                           ,v-cur-code
     3200                                           ,chr(10)
     3201                                           ,error-status:get-message(1)
     3202                                           ,return-value
     3203                                          ).
     3204           end.
     3205         end.
     3206         else do:
     3207           if v-range-type = 'sclc':U
     3208           or v-range-type = 'pglc':U
     3209           then do:
     3210             assign
     3211               v-db-for-send = "":U
     3212             .
     3213             if v-g#db-num = 0 then do:
     3214               for each buf_db no-lock
     3215                 where buf_db.db-num > 0
     3216                   and buf_db.db-num <> v-g#news-source-db
     3217               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3218               :
     3219                 assign
     3220                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     3221                 .
     3222               end.
     3223               assign
     3224                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     3225               .
     3226             end.
     3227             else do:
     3228               if not v-g#news then do:
     3229                 assign
     3230                   v-db-for-send = "0":U
     3231                 .
     3232               end.
     3233             end.
     3234             run nws/cr-route.p ( input 'send-cmd':U
     3235                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     3236                                  "code-range":U + chr(1) +
     3237                                  (if v-range-type = 'sclc':U
     3238                                   then string( current-value(s-sclc-code, ub))
     3239                                   else string( current-value(s-pglc-code, ub))
     3240                                   ) + chr(1) +
     3241                                   v-range-type)
     3242                           ,input ?
     3243                           ,input v-db-for-send
     3244                           ) no-error .
     3245             if error-status :error then do:
     3246               undo, return error return-value.
     3247             end.
     3248           end.
     3249         end.
     3250       end.
     3251     end.
     3252   end procedure.
     3253   procedure cre-loc-sc-code-range :
     3254     define input parameter v-cur-code as integer no-undo .
     3255   define input parameter p-cdrg-type as character no-undo .
     3256     do
     3257     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3258     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     3259     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     3260     :
     3261       define buffer buf_code-range for ub.code-range .
     3262       find first buf_code-range
     3263            where buf_code-range.range-type = p-cdrg-type
     3264              and buf_code-range.first-code >= v-cur-code
     3265            no-error .
     3266       if not available buf_code-range then do:
     3267         run new-bcod-gen-code-range in this-procedure
     3268           ( input 0,
     3269             input p-cdrg-type
     3270           ) no-error .
     3271         if error-status :error then do:
     3272           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     3273                                          + "Код &2&1&3 &4"
     3274                                         , chr(10)
     3275                                         , v-cur-code
     3276                                         , error-status:get-message(1)
     3277                                         , return-value
     3278                                        ) .
     3279         end.
     3280       end.
     3281     end.
     3282   end procedure.
     3283   procedure mark-used-if-need :
     3284   define input parameter p-cur-code as integer no-undo .
     3285   define input parameter p-range-type like ub.code-range.range-type no-undo .
     3286   define input parameter p-db-num like ub.code-range.db-num no-undo .
     3287     do
     3288     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3289     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     3290     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     3291     :
     3292       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     3293       define buffer buf_code-range for ub.code-range .
     3294       assign
     3295       v-db-num = if p-range-type = 'sclc':U
     3296                  then 0
     3297                  else p-db-num
     3298       .
     3299   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3300   define buffer locK-batchprocess11 for ub.batchprocess.
     3301   run gbl/lock-prc.p
     3302       (input 'lscc':U
     3303       ,input 0
     3304       ,input 0
     3305       ,input 0
     3306       ,input ""
     3307       ,input ""
     3308       ,input ""
     3309       ,input (
     3310               ",,,Вкл/выкл лок. вес. кодов"
     3311              )
     3312       ,input true
     3313       ,buffer lock-batchprocess11
     3314       ) no-error .
     3315     if error-status :error then do:
     3316       message
     3317         vss-workfile vss-revision vss-description skip
     3318         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     3319         view-as alert-box error .
     3320       undo, return error .
     3321     end.
     3322       find first buf_code-range
     3323            where buf_code-range.range-type = p-range-type
     3324              and buf_code-range.first-code >= p-cur-code
     3325              and buf_code-range.last-code <= p-cur-code
     3326              and buf_code-range.db-num = v-db-num
     3327            no-error .
     3328       if not available buf_code-range then do:
     3329         message
     3330           vss-workfile vss-revision vss-description skip
     3331           "Ошибка при создании поиске диапазона" skip
     3332           "База данных" p-db-num skip
     3333           "Код" p-cur-code skip
     3334           "Тип" p-range-type
     3335           error-status :get-message(1) skip
     3336           return-value skip
     3337           view-as alert-box error .
     3338         undo, return error .
     3339       end.
     3340       if buf_code-range.stts = "f":U then do:
     3341         assign
     3342         buf_code-range.stts = "u":U
     3343         .
     3344       end.
     3345     end.
     3346   end procedure.
     3347   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3348   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
