     9989            dst.user-login.status_ = dst.user-account.status_.
     9990      end.
     9991      if dst.user-login.status_ = 0
     9992      then do:
     9993         find first dst._user
     9994              where dst._user._userid    = dst.user-login.user-login
     9995              no-error
     9996              .
     9997         if not available dst._user then do:
     9998            create dst._user .
     9999            assign
    10000               dst._user._userid    = dst.user-login.user-login
    10001               dst._user._password  = dst.user-login.user-password-encoded
    10002            .
    10003         end.
    10004         ELSE DO:
    10005            BUFFER-COPY dst._User EXCEPT dst._User._Password dst._User._TenantId TO tempUser ASSIGN tempUser._Password = dst.user-login.user-password-encoded
    10006            .
    10007            DELETE dst._User.
    10008            CREATE dst._User.
    10009            BUFFER-COPY tempUser EXCEPT tempUser._TenantId TO _User.
    10010         END.
    10011         assign
    10012           dst._user._user-name = substitute('&1 &2 &3'
    10013                                           ,dst.user-account.last-name
    10014                                           ,dst.user-account.first-name
    10015                                           ,dst.user-account.second-name
    10016                                           )
    10017         .
    10018         release _user.
    10019       end.
    10020           end.
    10021       end.
