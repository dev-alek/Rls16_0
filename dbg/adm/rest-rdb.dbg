      508           end.
      509           else do:
      510             output stream getmc-stream to "getmc.log" append.
      511             put stream getmc-stream unformatted
      512               string( today, "99/99/9999" ) space(1)
      513               string( time, "HH:MM:SS" ) space(1)
      514               v-msg skip
      515             .
