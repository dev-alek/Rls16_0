     1272           end.
     1273         end.
     1274       end.
     1275     end.
     1276   end case.
     1277         end.
     1278         when 'bcgb':U then do:
     1279   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
