     1375             put stream getmc-stream unformatted
     1376               string( today, "99/99/9999" ) space(1)
     1377               string( time, "HH:MM:SS" ) space(1)
     1378               v-msg skip
     1379             .
     1380             output stream getmc-stream close.
     1381           end.
     1382         end.
     1383         if v-avail7 = 0
     1384           and buf_code-range.stts = "u":U
     1385         then do:
     1386           find first buf-c_code-range exclusive-lock
     1387             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1388           .
     1389           assign
     1390             buf-c_code-range.stts = "c":U
     1391           .
     1392           release buf-c_code-range .
     1393           assign
     1394             buf_code-range.stts = "f":U
     1395             v-b-code            = v-b-code + 1
     1396             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1397                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1398                                               , chr(10)
     1399                                               , buf_code-range.first-code
     1400                                               , buf_code-range.last-code
     1401                                             )
     1402           .
     1403           if p-view-mess = true then do:
     1404             message
     1405               v-msg
     1406               view-as alert-box information.
     1407           end.
     1408           else do:
     1409             output stream getmc-stream to "getmc.log" append.
     1410             put stream getmc-stream unformatted
     1411               string( today, "99/99/9999" ) space(1)
     1412               string( time, "HH:MM:SS" ) space(1)
     1413               v-msg skip
     1414             .
     1415             output stream getmc-stream close.
     1416           end.
     1417         end.
     1418       end.
     1419     end.
     1420   end case.
     1421         end.
     1422         when 'scgb':U
     1423         or when 'sclc':U
     1424         then do:
     1425           case p-action :
     1426             when "get-m-code":U then do:
     1427               assign
     1428                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1429               .
     1430             end.
     1431             when "f-u":U then do:
     1432               assign
     1433                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1434               .
     1435               run mark-all-used-as-free in this-procedure (
     1436                                          input  p-db-num
     1437                                         ,input  p-curr-type-cdrg
     1438                                         ,output str-u-f
     1439                                         ,output str-u-f-rng
     1440                                       ).
     1441             end.
     1442           end case.
     1443           view frame get-max-code-inf.
     1444           assign
     1445             rec-cnt = 0
     1446           .
     1447           display
     1448             rec-cnt
     1449             with frame get-max-code-inf
     1450           .
     1451           for each buf_units no-lock
     1452               where lookup('вес':U, buf_units.type) > 0
     1453           on error undo, return error
     1454           :
     1455             for each buf_goods no-lock
     1456               where buf_goods.unit-base = buf_units.unit-name
     1457             on error undo, return error
     1458             :
     1459               assign
     1460                 rec-cnt = rec-cnt + 1
     1461               .
     1462               if ( rec-cnt modulo 10 ) = 0 then do:
     1463                 display
     1464                   rec-cnt
     1465                   with frame get-max-code-inf
     1466                 .
     1467               end.
     1468               run mc_gdsbcode in this-procedure (
     1469                                input  buf_goods.gds-code
     1470                               ,input  ?
     1471                               ,output v-main-bcode
     1472                             ) no-error .
     1473               if error-status :error then do:
     1474                 message
     1475                   vss-workfile vss-revision vss-description skip
     1476                   "Ошибка при поиске корневого бар-кода" skip
     1477                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     1478                   error-status :get-message(1) skip
     1479                   return-value skip
     1480                   view-as alert-box error .
     1481                 undo, return error .
     1482               end.
     1483               for each buf_prod-bc no-lock
     1484                   where buf_prod-bc.b-code = v-main-bcode
     1485               on error undo, return error
     1486               :
     1487                 if p-curr-type-cdrg = 'sclc':U
     1488                   and buf_prod-bc.bc-on = FALSE
     1489                 then do:
     1490                   next.
     1491                 end.
     1492                 run mc_prodbcat in this-procedure (
     1493                                  buffer buf_prod-bc
     1494                                 ,input  'global=request':u
     1495                                 ,output l-prod-bc-global
     1496                               ) no-error .
     1497                 if error-status :error then do:
     1498                   message
     1499                     vss-workfile vss-revision vss-description skip
     1500                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1501                     "Основной бар-код" buf_prod-bc.b-code skip
     1502                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1503                     "Действие global=request" skip
     1504                     error-status :get-message(1) skip
     1505                     return-value skip
     1506                     view-as alert-box error .
     1507                   undo, return error .
     1508                 end.
     1509                 run mc_prodbcat in this-procedure (
     1510                                  buffer buf_prod-bc
     1511                                 ,input  'weight=request':u
     1512                                 ,output l-prod-bc-weight
     1513                               ) no-error .
     1514                 if error-status :error then do:
     1515                   message
     1516                     vss-workfile vss-revision vss-description skip
     1517                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1518                     "Основной бар-код" buf_prod-bc.b-code skip
     1519                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1520                     "Действие weight=request" skip
     1521                     error-status :get-message(1) skip
     1522                     return-value skip
     1523                     view-as alert-box error .
     1524                   undo, return error .
     1525                 end.
     1526                 if l-prod-bc-weight
     1527                   and ( ( l-prod-bc-global
     1528                           and p-curr-type-cdrg = 'scgb':U
     1529                         )
     1530                         or
     1531                         ( not l-prod-bc-global
     1532                           and p-curr-type-cdrg = 'sclc':U
     1533                         )
     1534                       )
     1535                 then do:
     1536                   case p-action :
     1537                     when "get-m-code":U then do:
     1538                       if integer( buf_prod-bc.b-str ) >= p-first-code
     1539                         and integer( buf_prod-bc.b-str ) <= p-last-code
     1540                         and integer( buf_prod-bc.b-str ) > v-b-code
     1541                       then do:
     1542                         assign
     1543                           v-b-code = integer( buf_prod-bc.b-str )
     1544                         .
     1545                       end.
     1546                     end.
     1547                     when "f-u":U then do:
     1548                       for each buf_code-range
     1549                         where buf_code-range.db-num     = p-db-num
     1550                           and buf_code-range.range-type = p-curr-type-cdrg
     1551                           and buf_code-range.stts       = "f":U
     1552                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1553                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1554                       on error undo, return error
     1555                       :
     1556                         assign
     1557                           buf_code-range.stts = "u":U
     1558                         .
     1559                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1560                           assign
     1561                             str-u-f-rng = diff-list( str-u-f-rng
     1562                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1563                                                     ,",":U
     1564                                                     )
     1565                           .
     1566                         end.
     1567                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1568                           assign
     1569                             v-b-code = v-b-code + 1
     1570                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1571                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1572                                                     , chr(10)
     1573                                                     , buf_code-range.first-code
     1574                                                     , buf_code-range.last-code
     1575                                                     , buf_prod-bc.b-str
     1576                                                   )
     1577                             v-ret-msg = v-ret-msg + v-msg
     1578                           .
     1579                           if p-view-mess = true then do:
     1580                             message
     1581                               v-msg
     1582                               view-as alert-box information.
     1583                           end.
     1584                         end.
     1585                       end.
     1586                     end.
     1587                   end case.
     1588                 end.
     1589               end.
     1590             end.
     1591           end.
     1592           if p-action = "f-u":U then do:
     1593             do ind = 1 to num-entries( str-u-f-rng ):
     1594               assign
     1595                 v-b-code  = v-b-code + 1
     1596                 v-msg     = substitute( "Диапазон кодов &2&1"
     1597                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1598                                         , chr(10)
     1599                                         , entry( ind, str-u-f-rng )
     1600                                       )
     1601                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1602               .
     1603               if p-view-mess = true then do:
     1604                 message
     1605                   v-msg
     1606                   view-as alert-box information.
     1607               end.
     1608             end.
     1609           end.
     1610           hide frame get-max-code-inf no-pause .
     1611         end.
     1612         when 'pglc':U
     1613         then do:
     1614           case p-action :
     1615             when "get-m-code":U then do:
     1616               assign
     1617                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1618               .
     1619             end.
     1620             when "f-u":U then do:
     1621               assign
     1622                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1623               .
     1624               run mark-all-used-as-free in this-procedure (
     1625                                          input  p-db-num
     1626                                         ,input  p-curr-type-cdrg
     1627                                         ,output str-u-f
     1628                                         ,output str-u-f-rng
     1629                                       ).
     1630             end.
     1631           end case.
     1632           view frame get-max-code-inf.
     1633           assign
     1634             rec-cnt = 0
     1635           .
     1636           display
     1637             rec-cnt
     1638             with frame get-max-code-inf
     1639           .
     1640           for each buf_prod-bc no-lock where
     1641                   buf_prod-bc.b-str >= "00100"
     1642               and buf_prod-bc.b-str <= "99999"
     1643               and buf_prod-bc.bc-on-type = 'pglc':U
     1644               and length(buf_prod-bc.b-str) = 5
     1645           on error undo, return error
     1646           :
     1647               assign
     1648                 rec-cnt = rec-cnt + 1
     1649               .
     1650               if ( rec-cnt modulo 10 ) = 0 then do:
     1651                 display
     1652                   rec-cnt
     1653                   with frame get-max-code-inf
     1654                 .
     1655               end.
     1656               if p-curr-type-cdrg = 'pglc':U
     1657                 and buf_prod-bc.bc-on = FALSE
     1658               then do:
     1659                 next.
     1660               end.
     1661               run mc_prodbcat in this-procedure (
     1662                                 buffer buf_prod-bc
     1663                               ,input  'pgweight=request':u
     1664                               ,output l-prod-bc-pgweight
     1665                             ) no-error .
     1666               if error-status :error then do:
     1667                 message
     1668                   vss-workfile vss-revision vss-description skip
     1669                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1670                   "Основной бар-код" buf_prod-bc.b-code skip
     1671                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     1672                   "Действие weight=request" skip
     1673                   error-status :get-message(1) skip
     1674                   return-value skip
     1675                   view-as alert-box error .
     1676                 undo, return error .
     1677               end.
     1678               if l-prod-bc-pgweight
     1679               and p-curr-type-cdrg = 'pglc':U
     1680               then do:
     1681                 case p-action :
     1682                   when "get-m-code":U then do:
     1683                     if integer( buf_prod-bc.b-str ) >= p-first-code
     1684                       and integer( buf_prod-bc.b-str ) <= p-last-code
     1685                       and integer( buf_prod-bc.b-str ) > v-b-code
     1686                     then do:
     1687                       assign
     1688                         v-b-code = integer( buf_prod-bc.b-str )
     1689                       .
     1690                     end.
     1691                   end.
     1692                   when "f-u":U then do:
     1693                     for each buf_code-range
     1694                       where buf_code-range.db-num     = p-db-num
     1695                         and buf_code-range.range-type = p-curr-type-cdrg
     1696                         and buf_code-range.stts       = "f":U
     1697                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1698                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1699                     on error undo, return error
     1700                     :
     1701                     assign
     1702                     buf_code-range.stts = "u":U
     1703                       .
     1704                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1705                         assign
     1706                           str-u-f-rng = diff-list( str-u-f-rng
     1707                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1708                                                   ,",":U
     1709                                                   )
     1710                         .
     1711                     end.
     1712                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1713                         assign
     1714                           v-b-code = v-b-code + 1
     1715                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1716                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1717                                                   , chr(10)
     1718                                                   , buf_code-range.first-code
     1719                                                   , buf_code-range.last-code
     1720                                                   , buf_prod-bc.b-str
     1721                                                 )
     1722                           v-ret-msg = v-ret-msg + v-msg
     1723                         .
     1724                       if p-view-mess = true then do:
     1725                         message
     1726                           v-msg
     1727                           view-as alert-box information.
     1728                       end.
     1729                     end.
     1730                   end.
     1731                 end.
     1732               end case.
     1733             end.
     1734           end.
     1735           if p-action = "f-u":U then do:
     1736             do ind = 1 to num-entries( str-u-f-rng ):
     1737               assign
     1738                 v-b-code = v-b-code + 1
     1739                 v-msg     = substitute( "Диапазон кодов &2&1"
     1740                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1741                                         , chr(10)
     1742                                         , entry( ind, str-u-f-rng )
     1743                                       )
     1744                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1745               .
     1746               if p-view-mess = true then do:
     1747                 message
     1748                   v-msg
     1749                   view-as alert-box information.
     1750               end.
     1751             end.
     1752           end.
     1753           hide frame get-max-code-inf no-pause .
     1754         end.
     1755         otherwise do:
     1756           message
     1757             vss-workfile vss-revision vss-description skip
     1758             "get-max-code" skip
     1759             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     1760             view-as alert-box error.
     1761           return error.
     1762         end.
     1763       end case.
     1764     end.
     1765     return v-ret-msg.
     1766   end procedure.
     1767   procedure mark-all-used-as-free :
     1768     define input  parameter p-db-num         like dst.db.db-num             no-undo .
     1769     define input  parameter p-curr-type-cdrg like dst.code-range.range-type no-undo .
     1770     define output parameter p-str-u-f        as   character                 no-undo .
     1771     define output parameter p-str-u-f-rng    as   character                 no-undo .
     1772     do
     1773     on error undo, return error
     1774     :
     1775       define buffer buf_code-range   for dst.code-range.
     1776       define buffer buf-c_code-range for dst.code-range .
     1777       assign
     1778         p-str-u-f     = "":U
     1779         p-str-u-f-rng = "":U
     1780       .
     1781       for each buf_code-range share-lock
     1782           where buf_code-range.db-num     = p-db-num
     1783             and buf_code-range.range-type = p-curr-type-cdrg
     1784             and buf_code-range.stts       = "u":U
     1785       on error undo, return error
     1786       :
     1787         find first buf-c_code-range exclusive-lock
     1788           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1789         .
     1790         assign
     1791           buf-c_code-range.stts = "c":U
     1792         .
     1793         release buf-c_code-range .
     1794         assign
     1795           buf_code-range.stts = "f":U
     1796           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     1797           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1798         .
     1799       end.
     1800       assign
     1801         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     1802         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     1803       .
     1804     end.
     1805   end procedure.
     1806   procedure mc_prodbcat :
     1807     do
     1808     on error undo, return error
     1809     :
     1810       define parameter buffer buf_prod-bc  for dst.prod-bc .
     1811       define input  parameter p-action           as character no-undo .
     1812       define output parameter p-return-attribute as logical no-undo .
     1813       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     1814       define buffer buf_bar-code   for dst.bar-code   .
     1815       define buffer buf_units      for dst.units      .
     1816       define buffer buf_code-range for dst.code-range .
     1817       define variable p-code-int as integer no-undo .
     1818       define variable v-cdrg-type as character no-undo .
     1819       if not available buf_prod-bc then do:
     1820         message
     1821           vss-workfile vss-revision vss-description skip
     1822           "Ошибка задания входных параметров" skip
     1823           "Не задан дополнительный бар-код" skip
     1824           view-as alert-box error .
     1825         undo, return error .
     1826       end.
     1827       find first buf_bar-code no-lock
     1828         where buf_bar-code.b-code = buf_prod-bc.b-code
     1829         no-error .
     1830       if not available buf_bar-code then do:
     1831         message
     1832           vss-workfile vss-revision vss-description skip
     1833           "Неправильная ссылка на основной бар-код" skip
     1834           "Основной бар-код" buf_prod-bc.b-code skip
     1835           "Дополнительный бар-код" buf_prod-bc.b-str skip
     1836           view-as alert-box error .
     1837         undo, return error .
     1838       end.
     1839       find first buf_units no-lock
     1840         where buf_units.unit-name = buf_bar-code.unit-cli
     1841         no-error .
     1842       if not available buf_units then do:
     1843         message
     1844           vss-workfile vss-revision vss-description skip
     1845           "Не найдена единица измерения основного бар-кода" skip
     1846           "Основной бар-код" buf_bar-code.b-code skip
     1847           "Единица измерения" buf_bar-code.unit-cli skip
     1848           view-as alert-box error .
     1849         undo, return error .
     1850       end.
     1851       def var ind                    as integer   no-undo .
     1852       def var v-num-entries-p-action as integer   no-undo .
     1853       def var v-action               as character no-undo .
     1854       assign
     1855         v-num-entries-p-action = num-entries(p-action)
     1856       .
     1857       assign
     1858         p-return-attribute = true
     1859       .
     1860       _ind:
     1861       do ind = 1 to v-num-entries-p-action
     1862       :
     1863        if ind > 1 and p-return-attribute = false then return.
     1864         assign
     1865           v-action = entry(ind, p-action)
     1866         .
     1867         case v-action :
     1868           when "global=request":u
     1869           then do:
     1870             if not (buf_prod-bc.bc-on-type = ''
     1871             or buf_prod-bc.bc-on-type = 'scgb':U
     1872             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     1873               assign
     1874                 p-return-attribute = false
     1875               .
     1876             end.
     1877           end.
     1878           when "weight=request":u
     1879           then do:
     1880             if not (buf_prod-bc.bc-on-type = 'sclc':U
     1881             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     1882               assign
     1883                 p-return-attribute = false.
     1884             end.
     1885           end.
     1886           when "pgweight=request":u
     1887           then do:
     1888             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     1889               assign
     1890                 p-return-attribute = false.
     1891             end.
     1892           end.
     1893           when "petrolium=request":u
     1894           then do:
     1895             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     1896               assign
     1897                 p-return-attribute = false.
     1898             end.
     1899           end.
     1900           when "scaleable=request":u
     1901           then do:
     1902             if not (buf_prod-bc.bc-on-type = 'sslc':U
     1903             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     1904               assign
     1905                 p-return-attribute = false.
     1906             end.
     1907           end.
     1908           otherwise do:
     1909             message
     1910               vss-workfile vss-revision vss-description skip
     1911               "Неизвестное значение параметра v-action " skip
     1912               "v-action" v-action skip
     1913               "p-action" p-action skip
     1914               view-as alert-box error .
     1915             undo, return error .
     1916           end.
     1917         end case.
     1918       end.
     1919     end.
     1920   end procedure.
     1921   procedure mc_gdsbcode :
     1922     define input  parameter p-gds-code  like dst.bar-code.gds-code  no-undo .
     1923     define input  parameter p-node-code like dst.bar-code.node-code no-undo .
     1924     define output parameter p-b-code    like dst.bar-code.b-code    no-undo .
     1925     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     1926     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     1927     define buffer buf_bar-code for dst.bar-code .
     1928     def var v-unit-base like dst.goods.unit-base no-undo .
     1929     do
     1930     on error undo, return error
     1931     :
     1932       if p-node-code = ? then do:
     1933         run mc_gdsrootnode in this-procedure (
     1934            input  p-gds-code
     1935           ,output p-node-code
     1936           ) no-error .
     1937         if error-status :error then do:
     1938           message
     1939             vss-workfile vss-revision vss-description skip
     1940             "Ошибка при определении корневого признака товара" skip
     1941             "Код товара" p-gds-code skip
     1942             error-status :get-message(1) skip
     1943             return-value skip
     1944             view-as alert-box error .
     1945           undo, return error .
     1946         end.
     1947       end.
     1948       run mc_unitbase in this-procedure (
     1949          input  p-gds-code
     1950         ,output v-unit-base
     1951         ) no-error .
     1952       if error-status :error then do:
     1953         message
     1954           vss-workfile vss-revision vss-description skip
     1955           "Ошибка определения базовой единицы измерения товара" skip
     1956           "Код товара" p-gds-code skip
     1957           view-as alert-box error .
     1958         undo, return error .
     1959       end.
     1960       find first buf_bar-code no-lock
     1961         where buf_bar-code.gds-code  = p-gds-code
     1962           and buf_bar-code.node-code = p-node-code
     1963           and buf_bar-code.part-code = ""
     1964           and buf_bar-code.in-code   = ""
     1965           and buf_bar-code.unit-cli  = v-unit-base
     1966         no-error .
     1967       if not available buf_bar-code then do:
     1968         undo, return error vss-proc-revision + ":" + chr(10)
     1969           + "Не найден первичный бар-кода признака " + chr(10)
     1970           + "Код товара " + string(p-gds-code) + chr(10)
     1971           + "Код признака " + string(p-node-code) + chr(10)
     1972           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     1973           .
     1974       end.
     1975       assign
     1976         p-b-code = buf_bar-code.b-code
     1977       .
     1978     end.
     1979   end procedure.
     1980   procedure mc_gdsrootnode :
     1981     define input  parameter p-gds-code  like dst.goods.gds-code no-undo .
     1982     define output parameter p-root-node like dst.goods.prt-root no-undo .
     1983     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     1984     define buffer buf_goods   for dst.goods .
     1985     do
     1986     on error undo, return error
     1987     :
     1988       find first buf_goods no-lock
     1989         where buf_goods.gds-code  = p-gds-code
     1990         no-error .
     1991       if not available buf_goods then do:
     1992         message
     1993           vss-workfile vss-revision vss-description skip
     1994           "Не найден товар" skip
     1995           "Код товара" p-gds-code skip
     1996           view-as alert-box error .
     1997         undo, return error .
     1998       end.
     1999       run mc_prt-root-to-node-code in this-procedure (
     2000          input  buf_goods.prt-root
     2001         ,output p-root-node
     2002         ) no-error .
     2003       if error-status :error then do:
     2004         message
     2005           vss-workfile vss-revision vss-description skip
     2006           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2007           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2008           "Указатель на корень шкалы" buf_goods.prt-root skip
     2009           error-status :get-message(1) skip
     2010           return-value skip
     2011           view-as alert-box error .
     2012         undo, return error .
     2013       end.
     2014     end.
     2015   end procedure.
     2016   procedure mc_prt-root-to-node-code :
     2017     define input  parameter p-prt-root  like dst.goods.prt-root no-undo .
     2018     define output parameter p-root-node like dst.goods.prt-root no-undo .
     2019     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2020     define buffer buf_gds-prt for dst.gds-prt .
     2021     do
     2022     on error undo, return error
     2023     :
     2024       find buf_gds-prt no-lock
     2025         where buf_gds-prt.upper-code = p-prt-root
     2026         no-error .
     2027       if not available buf_gds-prt then do:
     2028         message
     2029           vss-workfile vss-revision vss-description skip
     2030           "Не найден корень шкалы" skip
     2031           "Указатель на корень шкалы" p-prt-root skip
     2032           view-as alert-box error .
     2033         undo, return error .
     2034       end.
     2035       assign
     2036         p-root-node = buf_gds-prt.node-code
     2037       .
     2038     end.
     2039   end procedure.
     2040   procedure mc_unitbase :
     2041     define input  parameter p-gds-code  like dst.goods.gds-code  no-undo .
     2042     define output parameter p-unit-base like dst.goods.unit-base no-undo .
     2043     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2044     define buffer buf_goods for dst.goods .
     2045     do
     2046     on error undo, return error
     2047     :
     2048       find first buf_goods no-lock
     2049         where buf_goods.gds-code = p-gds-code
     2050         no-error .
     2051       if not available buf_goods then do:
     2052         message
     2053           vss-workfile vss-revision vss-description skip
     2054           "Не найден товар" skip
     2055           "Код товара" p-gds-code skip
     2056           view-as alert-box error .
     2057         undo, return error .
     2058       end.
     2059       assign
     2060         p-unit-base = buf_goods.unit-base
     2061       .
     2062     end.
     2063   end procedure.
     2064   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2065   procedure cur-time :
     2066      define output parameter p-today as date      no-undo .
     2067      define output parameter p-time  as integer   no-undo .
     2068     do
     2069     on error undo, return error
     2070     :
     2071       define variable v-date1 as date      no-undo .
     2072       define variable v-date2 as date      no-undo .
     2073       define variable v-time  as integer   no-undo .
     2074       assign
     2075         v-date1 = today
     2076         v-time  = time
     2077         v-date2 = today
     2078       .
     2079       if v-date1 <> v-date2
     2080       then do:
     2081         assign
     2082           v-date1 = today
     2083           v-time  = v-time
     2084         .
     2085       end.
     2086       assign
     2087         p-today = v-date1
     2088         p-time  = v-time
     2089       .
     2090     end.
     2091   end.
     2092   function cur-time-date returns character
     2093   :
     2094     return string(today, '99/99/9999':U) .
     2095   end.
     2096   function cur-time-mjd returns decimal
     2097   :
     2098     define variable v-date as date      no-undo .
     2099     define variable v-time as integer   no-undo .
     2100     run cur-time in this-procedure
     2101       (output v-date
     2102       ,output v-time
     2103       ) .
     2104     return integer(v-date) - 2400002 + (v-time / 86400) .
     2105   end.
     2106   function cur-time-get-ending-index returns integer
     2107   (input p-number as integer
     2108   )
     2109   :
     2110     if p-number < 0
     2111     or p-number = ?
     2112     then do:
     2113       return 1 .
     2114     end.
     2115     define variable v-rest as integer   no-undo .
     2116     assign
     2117       p-number = p-number modulo 100
     2118     .
     2119     if p-number < 20
     2120     then do:
     2121       assign
     2122         v-rest = p-number
     2123       .
     2124     end.
     2125     else do:
     2126       assign
     2127         v-rest = p-number modulo 10
     2128       .
     2129     end.
     2130     case v-rest :
     2131       when 1
     2132       then do:
     2133         return 2 .
     2134       end.
     2135       when 2 or
     2136       when 3 or
     2137       when 4
     2138       then do:
     2139         return 3 .
     2140       end.
     2141       otherwise do:
     2142         return 1 .
     2143       end.
     2144     end case .
     2145   end.
     2146   procedure cur-time-mjd-to-date :
     2147      define input  parameter i-mjd-diff as decimal no-undo.
     2148      define output parameter o-Date     as date    no-undo.
     2149      define output parameter o-Time     as integer no-undo.
     2150      define variable v-day-number as integer   no-undo .
     2151      if    i-mjd-diff < 0
     2152         or i-mjd-diff = ?
     2153      then do:
     2154         return "?" .
     2155      end.
     2156      assign
     2157         v-day-number = truncate(i-mjd-diff,0).
     2158         o-Date = date(v-day-number + 2400002).
     2159         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2160     .
     2161   end.
     2162   function cur-time-mjd-to-string returns character
     2163   (input p-mjd-diff as decimal
     2164   )
     2165   :
     2166     define variable v-day-number as integer   no-undo .
     2167     define variable v-seconds    as integer   no-undo .
     2168     define variable v-hour       as integer   no-undo .
     2169     define variable v-min        as integer   no-undo .
     2170     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2171     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2172     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2173     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2174     if p-mjd-diff < 0
     2175     or p-mjd-diff = ?
     2176     then do:
     2177       return "?" .
     2178     end.
     2179     assign
     2180       v-day-number = integer(truncate(p-mjd-diff,0))
     2181       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2182     .
     2183     if v-seconds > 86400
     2184     then do:
     2185       assign
     2186         v-seconds = 86400 - 1
     2187       .
     2188     end.
     2189     if v-seconds < 0
     2190     then do:
     2191       assign
     2192         v-seconds = 0
     2193       .
     2194     end.
     2195     assign
     2196       v-hour = truncate(v-seconds / 3600, 0)
     2197     .
     2198     assign
     2199       v-seconds = v-seconds modulo 3600
     2200     .
     2201     assign
     2202       v-min = truncate(v-seconds / 60, 0)
     2203     .
     2204     assign
     2205       v-seconds = v-seconds modulo 60
     2206     .
     2207     return
     2208         (if v-day-number <> 0
     2209           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2210           else ""
     2211         )
     2212       + (if v-day-number <> 0 or v-hour <> 0
     2213           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2214           else ""
     2215         )
     2216       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2217           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2218           else ""
     2219         )
     2220       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2221       .
     2222   end.
     2223   function cur-time-string returns character
     2224   :
     2225     define variable v-date as date      no-undo .
     2226     define variable v-time as integer   no-undo .
     2227     run cur-time in this-procedure
     2228       (output v-date
     2229       ,output v-time
     2230       ) .
     2231     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2232   end.
     2233   function cur-time-string-sec returns character
     2234   :
     2235     define variable v-date as date      no-undo .
     2236     define variable v-time as integer   no-undo .
     2237     run cur-time in this-procedure
     2238       (output v-date
     2239       ,output v-time
     2240       ) .
     2241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2242   end.
     2243   function cur-time-custom  returns character
     2244   (input p-prefix as character
     2245   ,input p-date-format as character
     2246   ,input p-delimiter as character
     2247   ,input p-time-format as character
     2248   ,input p-suffix as character
     2249   )
     2250   :
     2251     define variable v-date as date      no-undo .
     2252     define variable v-time as integer   no-undo .
     2253     run cur-time in this-procedure
     2254       (output v-date
     2255       ,output v-time
     2256       ) .
     2257     return
     2258       p-prefix
     2259       + string(v-date, p-date-format)
     2260       + p-delimiter
     2261       + string(v-time, p-time-format)
     2262       + p-suffix
     2263       .
     2264   end.
     2265   function cur-time-print  returns character
     2266   :
     2267     define variable v-date as date      no-undo .
     2268     define variable v-time as integer   no-undo .
     2269     run cur-time in this-procedure
     2270       (output v-date
     2271       ,output v-time
     2272       ) .
     2273     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2274   end.
     2275   function cur-time-datetime returns datetime
     2276   :
     2277     define variable v-char as character no-undo .
     2278     define variable v-datetime as datetime no-undo .
     2279     v-char = cur-time-string().
     2280     v-datetime = datetime(v-char).
     2281     return  v-datetime.
     2282   end.
     2283   function cur-time-string-msec returns character
     2284   :
     2285     define variable v-date as datetime  no-undo .
     2286     v-date = now.
     2287     return string(v-date) .
     2288   end.
