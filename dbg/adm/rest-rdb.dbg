        1   block-level on error undo, throw.
        2   define input parameter p-db-num      like ub.db.db-num     no-undo .
        3   define input parameter p-db-key      like ub.db.db-key     no-undo .
        4   define input parameter p-db-key-enc  like ub.db.db-key-enc no-undo .
        5   define input parameter p-type-unload as   character        no-undo .
        6   define input parameter p-unload-history as logical         no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision: f29df1d5f130, 3104, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: DRuban $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Вт авг 09 09:15:01 2022 +0300 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: rest-rdb.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: adm/rest-rdb.p $":U .
       12   define variable vss-description as character no-undo initial "Добавление и восстановление УБД".
       13   define variable mode-erprn as logical no-undo.
       14   define new global shared variable g#language as character no-undo .
       15   if g#language <> '' and g#language <> 'rus':U then do:
       16     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       17   end.
       18   define new global shared variable g#library  as handle no-undo .
       19   define new global shared variable g#library2 as handle no-undo .
       20   function diff-list returns character (
       21     input parfirst-list  as character,
       22     input parsecond-list as character,
       23     input pardelim       as character).
       24     if pardelim = ""
       25     or pardelim = ?
       26     then do:
       27       assign
       28         pardelim = ","
       29       .
       30     end.
       31     def var ind as integer no-undo .
       32     def var v-elem as character no-undo .
       33     def var v-result-list as character no-undo init "".
       34     def var v-num-parfirst-list as integer no-undo .
       35     assign
       36       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       37     .
       38     do ind = 1 to v-num-parfirst-list
       39     :
       40       assign
       41         v-elem = entry(ind, parfirst-list, pardelim)
       42       .
       43       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
       44         assign
       45           v-result-list = v-result-list
       46                         + (if v-result-list > "" then pardelim else "")
       47                         + v-elem
       48         .
       49       end.
       50     end.
       51     return v-result-list .
       52   end function.
       53   function add-list returns character (
       54    input parfirst-list  as character,
       55    input parsecond-list as character,
       56    input pardelim       as character).
       57     if pardelim = ""
       58     or pardelim = ?
       59     then do:
       60       assign
       61         pardelim = ","
       62       .
       63     end.
       64     def var ind as integer no-undo .
       65     def var v-elem as character no-undo .
       66     def var v-result-list as character no-undo init "".
       67     def var v-num-parfirst-list as integer no-undo .
       68     assign
       69       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       70     .
       71     do ind = 1 to v-num-parfirst-list
       72     :
       73       assign
       74         v-elem = entry(ind, parfirst-list, pardelim)
       75       .
       76       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
       77         assign
       78           v-result-list = v-result-list
       79                         + (if v-result-list > "" then pardelim else "")
       80                         + v-elem
       81         .
       82       end.
       83     end.
       84     def var v-num-parsecond-list as integer no-undo .
       85     assign
       86       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
       87     .
       88     do ind = 1 to v-num-parsecond-list
       89     :
       90       assign
       91         v-elem = entry(ind, parsecond-list, pardelim)
       92       .
       93       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
       94         assign
       95           v-result-list = v-result-list
       96                         + (if v-result-list > "" then pardelim else "")
       97                         + v-elem
       98         .
       99       end.
      100     end.
      101     return v-result-list .
      102   end function.
      103   function cross-list returns character (
      104    input parfirst-list  as character,
      105    input parsecond-list as character,
      106    input pardelim       as character).
      107     if pardelim = ""
      108     or pardelim = ?
      109     then do:
      110       assign
      111         pardelim = ","
      112       .
      113     end.
      114     def var ind as integer no-undo .
      115     def var v-elem as character no-undo .
      116     def var v-result-list as character no-undo init "".
      117     def var v-num-parfirst-list as integer no-undo .
      118     assign
      119       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      120     .
      121     do ind = 1 to v-num-parfirst-list
      122     :
      123       assign
      124         v-elem = entry(ind, parfirst-list, pardelim)
      125       .
      126       if lookup(v-elem, v-result-list, pardelim) = 0
      127       and lookup(v-elem, parsecond-list, pardelim) > 0
      128       then do:
      129         assign
      130           v-result-list = v-result-list
      131                         + (if v-result-list > "" then pardelim else "")
      132                         + v-elem
      133         .
      134       end.
      135     end.
      136     return v-result-list .
      137   end function.
      138   function radio-label returns character (
      139    input par-rs-value  as character,
      140    input par-rs-radio-buttons as character)
      141    .
      142    DEFINE variable v-result-label as character no-undo.
      143    assign
      144    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      145                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      146                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      147                             ), par-rs-radio-buttons
      148                           )
      149    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      150    .
      151   return v-result-label.
      152   end function.
      153   function m-radio-label returns character (
      154    input par-rs-value  as character,
      155    input par-rs-radio-buttons as character,
      156    input par-delim as character
      157    )
      158    .
      159    DEFINE variable v-result-label as character no-undo.
      160    assign
      161    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      162                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      163                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      164                             ), par-rs-radio-buttons, par-delim
      165                           )
      166    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      167    .
      168   return v-result-label.
      169   end function.
      170   FUNCTION mixlist returns character
      171   (
      172    input parfirst-list  as character
      173    ,input parsecond-list as character
      174    ,input pardelim       as character
      175    ,input pardelim-result as character ) :
      176     if pardelim = ""
      177     or pardelim = ?
      178     then do:
      179       assign
      180         pardelim = ","
      181       .
      182     end.
      183     def var ind as integer no-undo .
      184     def var v-elem1 as character no-undo .
      185     def var v-elem2 as character no-undo .
      186     def var v-result-list as character no-undo init "".
      187     do ind = 1 to num-entries(parfirst-list, pardelim)
      188     :
      189       assign
      190         v-elem1 = entry(ind, parfirst-list, pardelim)
      191         v-elem2 = entry(ind, parsecond-list, pardelim)
      192       .
      193         assign
      194           v-result-list = v-result-list
      195                         + (if v-result-list > "" then pardelim-result else "")
      196                         + v-elem1 + pardelim-result + v-elem2
      197         .
      198     end.
      199     return v-result-list .
      200   END FUNCTION.
      201   define stream getmc-stream .
      202   procedure get-max-code :
      203     define input  parameter p-action         as   character                 no-undo .
      204     define input  parameter p-db-num         like dst.db.db-num             no-undo .
      205     define input  parameter p-curr-type-cdrg like dst.code-range.range-type no-undo .
      206     define input  parameter p-first-code     like dst.code-range.first-code no-undo .
      207     define input  parameter p-last-code      like dst.code-range.last-code  no-undo .
      208     define input  parameter p-view-mess      as   logical                   no-undo .
      209     define output parameter v-b-code         as   integer                   no-undo .
      210     do
      211     on error undo, return error return-value
      212     :
      213       define variable v-main-bcode     like dst.bar-code.b-code no-undo .
      214       define variable l-prod-bc-global as   logical             no-undo .
      215       define variable l-prod-bc-weight as   logical             no-undo .
      216       define variable l-prod-bc-pgweight as   logical             no-undo .
      217       define variable rec-cnt          as   integer             no-undo .
      218       define variable str-u-f          as   character           no-undo .
      219       define variable str-u-f-rng      as   character           no-undo .
      220       define variable ind              as   integer             no-undo .
      221       define variable v-msg              as   character           no-undo initial "":U.
      222       define variable v-ret-msg          as   character           no-undo initial "":U.
      223       define frame get-max-code-inf
      224         rec-cnt label "Просмотрено"
      225         with view-as dialog-box side-labels row 11 centered
      226         title "..........................................." three-d
      227       .
      228       define buffer buf_code-range   for dst.code-range .
      229       define buffer buf-c_code-range for dst.code-range .
      230       define buffer buf_bar-code     for dst.bar-code .
      231       define buffer buf_place        for dst.place .
      232       define buffer buf_goods        for dst.goods .
      233       define buffer buf_units        for dst.units .
      234       define buffer buf_prod-bc      for dst.prod-bc .
      235       define buffer buf_dis-card     for dst.dis-card .
      236       define buffer buf_dis-rule     for dst.dis-rule .
      237       define buffer buf_dis-time-rule     for dst.dis-time-rule .
      238       define buffer buf_firm         for dst.firm .
      239       define buffer buf_person       for dst.person .
      240       define buffer buf_contract     for dst.contract .
      241       if p-curr-type-cdrg = 'sslc':U
      242       or p-curr-type-cdrg = 'ssgb':U
      243       then do:
      244         assign
      245           v-b-code = ?
      246         .
      247         return.
      248       end.
      249       if p-curr-type-cdrg = 'sclc':U
      250       or p-curr-type-cdrg = 'pglc':U
      251         or p-curr-type-cdrg = 'sslc':U
      252       then do:
      253         assign
      254           p-db-num = 0
      255         .
      256       end.
      257       case p-action :
      258         when "get-m-code":U then do:
      259           assign
      260             v-b-code = p-first-code
      261           .
      262         end.
      263         when "f-u":U then do:
      264           assign
      265             v-b-code = 0
      266           .
      267         end.
      268       end case.
      269       case p-curr-type-cdrg :
      270         when 'dcgb':U then do:
      271   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      272   define variable v-ii0 as integer   no-undo .
      273   define variable v-table-name0 as character no-undo .
      274   define variable v-field-name0 as character no-undo .
      275   define variable buf_h0 as handle no-undo .
      276   define variable q_h0 as handle no-undo .
      277   define variable v-avail0 as integer   no-undo .
      278   define variable v-code-mess0 as character no-undo .
      279   define variable glog0 as logical   no-undo .
      280   define variable v-code_0 as integer   no-undo .
      281   case p-action :
      282     when "get-m-code":U then do:
      283       do v-ii0 = 1 to num-entries('dst.dis-card'):
      284         assign
      285         v-table-name0 = entry(v-ii0, 'dst.dis-card')
      286         v-field-name0 = entry(v-ii0, 'card-num')
      287         .
      288         create buffer buf_h0 for table v-table-name0.
      289         create query q_h0.
      290         q_h0:SET-BUFFERS(buf_h0).
      291         q_h0:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      292                           ,v-table-name0
      293                           ,v-field-name0
      294                           ,p-first-code
      295                           ,p-last-code)
      296                           ).
      297         q_h0:QUERY-OPEN.
      298         REPEAT while  q_h0:get-next().
      299           assign
      300             v-code_0 = buf_h0:buffer-field(v-field-name0):buffer-value
      301           .
      302           leave .
      303         END.
      304         q_h0:QUERY-CLOSE().
      305         delete object q_h0.
      306         delete object buf_h0.
      307         v-b-code = max(v-code_0, v-b-code).
      308       end.
      309     end.
      310     when "f-u":U then do:
      311       for each buf_code-range share-lock
      312           where ( buf_code-range.range-type = p-curr-type-cdrg
      313                   and buf_code-range.db-num = p-db-num
      314                   and buf_code-range.stts = "f":U
      315                 ) or
      316                 ( buf_code-range.range-type = p-curr-type-cdrg
      317                   and buf_code-range.db-num = p-db-num
      318                   and buf_code-range.stts = "u":U
      319                 )
      320       on error undo, return error
      321       :
      322         v-avail0 = 0.
      323         do v-ii0 = 1 to num-entries('dst.dis-card'):
      324           assign
      325           v-table-name0 = entry(v-ii0, 'dst.dis-card')
      326           v-field-name0 = entry(v-ii0, 'card-num')
      327           .
      328           create buffer buf_h0 for table v-table-name0.
      329           glog0 = buf_h0:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      330                                   , v-table-name0
      331                                   , v-field-name0
      332                                   , buf_code-range.first-code
      333                                   , buf_code-range.last-code)
      334                                   ) no-error .
      335           if buf_h0:available then do:
      336             assign
      337             v-avail0 = v-avail0 + 1
      338             .
      339             if v-avail0 = 1 then do:
      340               v-code-mess0 = string(buf_h0:buffer-field(v-field-name0):buffer-value)
      341               .
      342             end.
      343           end.
      344           delete object buf_h0.
      345        end.
      346        if v-avail0 > 0
      347           and buf_code-range.stts = "f":U
      348         then do:
      349           assign
      350             buf_code-range.stts = "u":U
      351             v-b-code            = v-b-code + 1
      352             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      353                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      354                                               , chr(10)
      355                                               , buf_code-range.first-code
      356                                               , buf_code-range.last-code
      357                                               , v-code-mess0
      358                                             )
      359           .
      360           if p-view-mess = true then do:
      361             message
      362               v-msg
      363               view-as alert-box information.
      364           end.
      365           else do:
      366             output stream getmc-stream to "getmc.log" append.
      367             put stream getmc-stream unformatted
      368               string( today, "99/99/9999" ) space(1)
      369               string( time, "HH:MM:SS" ) space(1)
      370               v-msg skip
      371             .
      372             output stream getmc-stream close.
      373           end.
      374         end.
      375         if v-avail0 = 0
      376           and buf_code-range.stts = "u":U
      377         then do:
      378           find first buf-c_code-range exclusive-lock
      379             where rowid( buf-c_code-range ) = rowid( buf_code-range )
      380           .
      381           assign
      382             buf-c_code-range.stts = "c":U
      383           .
      384           release buf-c_code-range .
      385           assign
      386             buf_code-range.stts = "f":U
      387             v-b-code            = v-b-code + 1
      388             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      389                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
      390                                               , chr(10)
      391                                               , buf_code-range.first-code
      392                                               , buf_code-range.last-code
      393                                             )
      394           .
      395           if p-view-mess = true then do:
      396             message
      397               v-msg
      398               view-as alert-box information.
      399           end.
      400           else do:
      401             output stream getmc-stream to "getmc.log" append.
      402             put stream getmc-stream unformatted
      403               string( today, "99/99/9999" ) space(1)
      404               string( time, "HH:MM:SS" ) space(1)
      405               v-msg skip
      406             .
      407             output stream getmc-stream close.
      408           end.
      409         end.
      410       end.
      411     end.
      412   end case.
      413         end.
      414         when 'ctgb':U then do:
      415   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   define variable v-ii1 as integer   no-undo .
      417   define variable v-table-name1 as character no-undo .
      418   define variable v-field-name1 as character no-undo .
      419   define variable buf_h1 as handle no-undo .
      420   define variable q_h1 as handle no-undo .
