     8815       assign
     8816         count-str :screen-value   = string( count-str, count-str :format)
     8817         fl :screen-value          = string( fl, fl :format)
     8818         ind1 :screen-value        = string( ind1, ind1 :format)
     8819       .
     8820     end.
