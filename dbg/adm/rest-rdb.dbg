      471           .
      472           create buffer buf_h1 for table v-table-name1.
      473           glog1 = buf_h1:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      474                                   , v-table-name1
      475                                   , v-field-name1
      476                                   , buf_code-range.first-code
      477                                   , buf_code-range.last-code)
      478                                   ) no-error .
      479           if buf_h1:available then do:
      480             assign
      481             v-avail1 = v-avail1 + 1
      482             .
      483             if v-avail1 = 1 then do:
      484               v-code-mess1 = string(buf_h1:buffer-field(v-field-name1):buffer-value)
      485               .
      486             end.
      487           end.
      488           delete object buf_h1.
      489        end.
      490        if v-avail1 > 0
      491           and buf_code-range.stts = "f":U
      492         then do:
      493           assign
      494             buf_code-range.stts = "u":U
      495             v-b-code            = v-b-code + 1
      496             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      497                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      498                                               , chr(10)
      499                                               , buf_code-range.first-code
      500                                               , buf_code-range.last-code
      501                                               , v-code-mess1
      502                                             )
      503           .
      504           if p-view-mess = true then do:
