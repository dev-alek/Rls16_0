    12978   procedure rest-c-inkas :
    12979     define input parameter p-inkas_obj-type as character no-undo .
    12980     define input parameter p-inkas_obj-code as integer   no-undo .
    12981     do
    12982     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12983     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12984     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12985     :
    12986       assign ind1 = 0
    12987              fl   = "c-inkas".
    12988       for each ub.c-inkas no-lock
    12989           where ub.c-inkas.obj-type = p-inkas_obj-type
    12990             and ub.c-inkas.obj-code = p-inkas_obj-code
    12991             and ub.c-inkas.is-del = yes
    12992       break
    12993       by
    12994       ub.c-inkas.inkas-code
    12995       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12996       :
    12997         assign  ind1 = ind1 + 1.
    12998         display ind1 count-str fl with frame ddd view-as dialog-box.
    12999         create dst.c-inkas.
    13000         buffer-copy ub.c-inkas to dst.c-inkas.
    13001         if first-of(ub.c-inkas.inkas-code) then do:
    13002           for each ub.c-inkas-pay no-lock
    13003               where ub.c-inkas-pay.inkas-code = ub.c-inkas.inkas-code
    13004           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13005           :
    13006             create dst.c-inkas-pay.
    13007             buffer-copy ub.c-inkas-pay to dst.c-inkas-pay.
    13008           end.
    13009           for each ub.c-inkas-pay-desk no-lock
    13010               where ub.c-inkas-pay-desk.inkas-code = ub.c-inkas.inkas-code
    13011           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13012           :
    13013             create dst.c-inkas-pay-desk.
    13014             buffer-copy ub.c-inkas-pay-desk to dst.c-inkas-pay-desk.
    13015           end.
    13016           for each ub.c-inkas-pay-wth no-lock
    13017               where ub.c-inkas-pay-wth.inkas-code = ub.c-inkas.inkas-code
    13018           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13019           :
    13020             create dst.c-inkas-pay-wth.
    13021             buffer-copy ub.c-inkas-pay-wth to dst.c-inkas-pay-wth.
    13022           end.
    13023           for each ub.c-sale-doc no-lock
    13024               where ub.c-sale-doc.inkas-code = ub.c-inkas.inkas-code
    13025           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13026           :
    13027             create dst.c-sale-doc.
