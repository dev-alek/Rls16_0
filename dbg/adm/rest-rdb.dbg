     1299         q_h7:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
     1300                           ,v-table-name7
     1301                           ,v-field-name7
     1302                           ,p-first-code
     1303                           ,p-last-code)
     1304                           ).
     1305         q_h7:QUERY-OPEN.
