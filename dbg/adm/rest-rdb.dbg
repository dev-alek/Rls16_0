    12638               where ub.edi-status.tbl-name = 'doc-line':U
    12639               and  ub.edi-status.doc-code begins (ub.trn-doc.doc-code + chr(4))
    12640           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12641           :
