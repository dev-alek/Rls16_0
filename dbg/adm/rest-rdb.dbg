     4053   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4054   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4055   procedure progs-name :
     4056     define input  parameter p-action-code         as character no-undo .
     4057     define output parameter p-main-prog-name      as character no-undo .
     4058     define output parameter p-list-db-proc-name   as character no-undo .
     4059     define output parameter p-commit-proc-name    as character no-undo .
     4060     define output parameter p-execution-proc-name as character no-undo .
     4061     define output parameter p-recover-proc-name   as character no-undo .
     4062     define output parameter p-after-proc-name     as character no-undo .
     4063     do
     4064     on error undo, return error
     4065     :
     4066       case p-action-code :
     4067               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
     4068               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
     4069               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
     4070               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
     4071               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
     4072               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
     4073               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
     4074               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
     4075               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
     4076               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
     4077               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
     4078               otherwise do:
     4079           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info16, p-action-code ).
     4080         end.
     4081       end case.
     4082     end.
     4083     return.
     4084   end procedure.
     4085   procedure progs-title :
     4086     define input  parameter p-action-code         as character no-undo .
     4087     define output parameter p-action-title      as character no-undo .
     4088     do
     4089     on error undo, return error
     4090     :
     4091       case p-action-code :
     4092               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     4093               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     4094               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     4095               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     4096               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     4097               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     4098               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     4099               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     4100               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     4101               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     4102               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     4103               otherwise do:
     4104           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info16, p-action-code ).
     4105         end.
     4106       end case.
     4107     end.
     4108     return.
     4109   end procedure.
     4110   FUNCTION progs-title-function returns character(
     4111      input  p-action-code         as character):
     4112   define variable p-action-title      as character no-undo .
     4113     do
     4114     on error undo, return error
     4115     :
     4116       case p-action-code :
     4117               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     4118               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     4119               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     4120               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     4121               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     4122               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     4123               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     4124               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     4125               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     4126               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     4127               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     4128               otherwise do:
     4129           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info16, p-action-code ).
     4130         end.
     4131       end case.
     4132     end.
     4133     return p-action-title.
     4134   end FUNCTION.
     4135   procedure get-row-keyr-string :
     4136    define input  parameter p-key-rec  as character no-undo.
     4137    define output parameter p-tbl-title as character no-undo.
     4138    define output parameter p-rec-string  as character no-undo.
     4139     do
     4140     on error undo, return error
     4141     :
     4142       define variable v-full-tbl-name as character no-undo .
     4143       define variable bh_tbl-name     as handle    no-undo .
     4144       define variable fh              as handle    no-undo .
     4145       define variable v-ok            as logical   no-undo .
     4146       define variable v-field-num     as integer   no-undo .
     4147       define variable v-count-fld     as integer   no-undo .
     4148       define variable v-tbl-name as character no-undo.
     4149       if p-key-rec = ?
     4150         or p-key-rec = "":U
     4151       then do:
     4152         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     4153       end.
     4154       assign
     4155         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     4156         v-full-tbl-name = "ub.":U + v-tbl-name
     4157         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     4158         p-rec-string         = "":U
     4159         v-count-fld     = 0
     4160       .
     4161       find ub._file
     4162         where ub._file._file-name = v-tbl-name
     4163         no-error.
     4164       if not available ub._file then do:
     4165         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info16, v-tbl-name ).
     4166       end.
     4167       assign
     4168       p-tbl-title = ub._file._file-label
     4169       .
     4170       find ub._index
     4171         where recid( ub._index  ) = ub._file._prime-index
     4172         no-error.
     4173       if not available ub._index
     4174         or LC( ub._index._index-name ) = "default":U
     4175       then do:
     4176         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     4177       end.
     4178       block_where :
     4179       for each ub._index-field of ub._index  ,
     4180           each ub._field of _index-field
     4181           break by _index-seq
     4182       on error undo, return error
     4183       :
     4184         assign
     4185           v-count-fld = v-count-fld + 1
     4186         .
     4187         if v-count-fld > v-field-num then do:
     4188           leave block_where.
     4189         end.
     4190         if p-rec-string = "":U then do:
     4191           assign
     4192             p-rec-string = "":U
     4193           .
     4194         end.
     4195         else do:
     4196           assign
     4197             p-rec-string = p-rec-string + chr(32) + chr(44)
     4198           .
     4199         end.
     4200         assign
     4201           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     4202         .
     4203       end.
     4204       if v-count-fld <> v-field-num then do:
     4205         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info16, v-tbl-name ).
     4206       end.
     4207     end.
     4208     return.
     4209   end procedure.
     4210   FUNCTION uniq-key-rec-string-f returns character(
     4211      input  p-uniq-key-rec         as character):
     4212   define variable v-tbl-title as character no-undo .
     4213   define variable v-rec-string as character no-undo .
     4214     do
     4215     on error undo, return error
     4216     :
     4217       run get-row-keyr-string in this-procedure (
     4218                                                 input p-uniq-key-rec
     4219                                                 ,output v-tbl-title
     4220                                                 ,output v-rec-string).
     4221       assign
     4222       v-rec-string = (if v-tbl-title <> ? and
     4223                       v-tbl-title <> "":U
     4224                       then (v-tbl-title + ":")
     4225                      else "":U) + chr(32) + v-rec-string
     4226       .
     4227     end.
     4228     return v-rec-string.
     4229   end FUNCTION.
     4230   procedure create_db-rec_route :
     4231     define input parameter p1-uniq-key-rec as character no-undo .
     4232     define input parameter p1-action       as character no-undo .
     4233     define input parameter p1-operation    as character no-undo .
     4234     define input parameter p1-send-db-list as character no-undo .
     4235     define input parameter p1-db-init      as integer   no-undo .
     4236     define input parameter p1-parameters   as character no-undo .
     4237     define input parameter p1-answer-code  as integer   no-undo .
     4238     define input parameter p1-answer-msg   as character no-undo .
     4239     do
     4240     on error undo, return error
     4241     :
     4242       define variable v-command     as character no-undo .
     4243       define variable v-ind         as integer   no-undo .
     4244       define variable v-num-entries as integer   no-undo .
     4245       define variable v-curr-db     as integer   no-undo .
     4246       define variable v-db-for-send as character no-undo .
     4247       define variable v-db-num      as integer   no-undo .
     4248       define variable v-db-num-char as character no-undo .
     4249       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4250       find first buf_sys-ctrl no-lock .
     4251       assign
     4252         v-curr-db     = buf_sys-ctrl.db-num
     4253         v-db-for-send = "":U
     4254       .
     4255       if v-curr-db = 0 then do:
     4256         if p1-answer-code >= 0 then do:
     4257           if v-curr-db <> p1-db-init then do:
     4258             assign
     4259               v-db-for-send = string( p1-db-init )
     4260             .
     4261           end.
     4262         end.
     4263         else do:
     4264           assign
     4265             v-num-entries = num-entries( p1-send-db-list, chr(44) )
     4266           .
     4267           do v-ind = 1 to v-num-entries:
     4268             assign
     4269               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
     4270               v-db-num      = integer( v-db-num-char )
     4271             .
     4272             if v-db-num <> v-curr-db
     4273               and v-db-num <> p1-db-init
     4274             then do:
     4275               if v-db-for-send = "":U then do:
     4276                 assign
     4277                   v-db-for-send = v-db-num-char
     4278                 .
     4279               end.
     4280               else do:
     4281                 assign
     4282                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     4283                 .
     4284               end.
     4285             end.
     4286           end.
     4287         end.
     4288       end.
     4289       else do:
     4290         assign
     4291           v-db-for-send = "0":U
     4292         .
     4293       end.
     4294       if v-db-for-send <> "":U then do:
     4295         assign
     4296           v-command = "command":U + chr(1)
     4297                       + "two-commit":U + chr(1)
     4298                       + p1-action + chr(1)
     4299                       + p1-operation + chr(1)
     4300                       + p1-uniq-key-rec + chr(1)
     4301                       + string( p1-db-init ) + chr(1)
     4302                       + p1-parameters + chr(1)
     4303                       + string( p1-answer-code ) + chr(1)
     4304                       + p1-answer-msg
     4305         .
     4306         run nws/cr-route.p ( input 'send-cmd':U
     4307                       ,input v-command
     4308                       ,input ?
     4309                       ,input v-db-for-send
     4310                       ) no-error .
     4311         if error-status :error then do:
     4312           return error return-value.
     4313         end.
     4314       end.
     4315     end.
     4316     return.
     4317   end procedure.
     4318   procedure create_msg_route :
     4319     define input parameter p2-send-db-list as character no-undo .
     4320     define input parameter p2-msg          as character no-undo .
     4321     do
     4322     on error undo, return error
     4323     :
     4324       define variable v-msg-command as character no-undo .
     4325       define variable v-ind         as integer   no-undo .
     4326       define variable v-num-entries as integer   no-undo .
     4327       define variable v-curr-db     as integer   no-undo .
     4328       define variable v-db-for-send as character no-undo .
     4329       define variable v-db-num      as integer   no-undo .
     4330       define variable v-db-num-char as character no-undo .
     4331       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4332       find first buf_sys-ctrl no-lock .
     4333       assign
     4334         v-curr-db     = buf_sys-ctrl.db-num
     4335         v-db-for-send = "":U
     4336       .
     4337       if v-curr-db = 0 then do:
     4338         assign
     4339           v-num-entries = num-entries( p2-send-db-list, chr(44) )
     4340         .
     4341         do v-ind = 1 to v-num-entries:
     4342           assign
     4343             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
     4344             v-db-num      = integer( v-db-num-char )
     4345           .
     4346           if v-db-num <> v-curr-db then do:
     4347             if v-db-for-send = "":U then do:
     4348               assign
     4349                 v-db-for-send = v-db-num-char
     4350               .
     4351             end.
     4352             else do:
     4353               assign
     4354                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     4355               .
     4356             end.
     4357           end.
     4358         end.
     4359       end.
     4360       else do:
     4361         assign
     4362           v-db-for-send = "0":U
     4363         .
     4364       end.
     4365       if v-db-for-send <> "":U then do:
     4366         assign
     4367           v-msg-command = "command":U + chr(1)
     4368                           + "message-to-log":U + chr(1)
     4369                           + p2-msg
     4370         .
     4371         run nws/cr-route.p ( input 'send-cmd':U
     4372                       ,input v-msg-command
     4373                       ,input ?
     4374                       ,input v-db-for-send
     4375                       ) no-error .
     4376         if error-status :error then do:
     4377           return error substitute( "&1&2&3"
     4378                                     , return-value
     4379                                     , chr(10)
     4380                                     , error-status :get-message(1)
     4381                                   ).
     4382         end.
     4383       end.
     4384     end.
     4385     return.
     4386   end procedure.
     4387   function get-send-db-list returns character
     4388     ( input p-curr-db     as integer
     4389      ,input p-all-db-list as character
     4390     )
     4391   :
     4392     define variable v-send-db-list as character no-undo .
     4393     if p-curr-db = 0 then do:
     4394       assign
     4395         v-send-db-list = p-all-db-list
     4396       .
     4397     end.
     4398     else do:
     4399       assign
     4400         v-send-db-list = string(p-curr-db)
     4401       .
     4402     end.
     4403     return v-send-db-list .
     4404   end function .
     4405   define temp-table temp_db-rec-attr no-undo like ub.db-rec-attr
     4406     field db-list as character
     4407   .
     4408   procedure fill-two-commit-command :
     4409     do
     4410     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4411     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4412     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4413     :
     4414       define variable v-main-prog-name      as character no-undo .
     4415       define variable v-list-db-proc-name   as character no-undo .
     4416       define variable v-commit-proc-name    as character no-undo .
     4417       define variable v-execution-proc-name as character no-undo .
     4418       define variable v-recover-proc-name   as character no-undo .
     4419       define variable v-after-proc-name     as character no-undo .
     4420       define buffer buf_db-rec-attr for ub.db-rec-attr .
     4421       for each buf_db-rec-attr exclusive-lock
     4422         break by buf_db-rec-attr.db-num
     4423       on error undo, return error return-value
     4424       :
     4425         find first temp_db-rec-attr
     4426           where temp_db-rec-attr.uniq-key-rec = buf_db-rec-attr.uniq-key-rec
     4427             and temp_db-rec-attr.attr-code    = buf_db-rec-attr.attr-code
     4428           no-error.
     4429         if not available temp_db-rec-attr then do:
     4430           create temp_db-rec-attr.
     4431           buffer-copy buf_db-rec-attr to temp_db-rec-attr
     4432             assign
     4433               temp_db-rec-attr.db-list = string( buf_db-rec-attr.db-num )
     4434           .
     4435           run progs-name in this-procedure
     4436             ( input buf_db-rec-attr.attr-code
     4437              ,output v-main-prog-name
     4438              ,output v-list-db-proc-name
     4439              ,output v-commit-proc-name
     4440              ,output v-execution-proc-name
     4441              ,output v-recover-proc-name
     4442              ,output v-after-proc-name
     4443             ) no-error .
     4444           if error-status :error then do:
     4445             return error substitute( "&1. Ошибка при определении имен процедур. &2", vss-workfile, return-value ).
     4446           end.
     4447           run value( v-list-db-proc-name )
     4448             ( input buf_db-rec-attr.attr-code
     4449              ,input buf_db-rec-attr.uniq-key-rec
     4450              ,output temp_db-rec-attr.db-list
     4451             ) no-error .
     4452           if error-status :error then do:
     4453             return error substitute( "&1. Ошибка при определении списка БД. &2", vss-workfile, return-value ).
     4454           end.
     4455         end.
     4456         if temp_db-rec-attr.db-num <> 0 then do:
     4457           if buf_db-rec-attr.db-num = 0 then do:
     4458             assign
     4459               temp_db-rec-attr.db-num = buf_db-rec-attr.db-num
     4460             .
     4461           end.
     4462           else do:
     4463             assign
     4464               temp_db-rec-attr.db-num = ?
     4465             .
     4466           end.
     4467         end.
     4468       end.
     4469       return.
     4470     end.
     4471   end procedure.
