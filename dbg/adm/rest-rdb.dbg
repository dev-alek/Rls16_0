      456           where ( buf_code-range.range-type = p-curr-type-cdrg
      457                   and buf_code-range.db-num = p-db-num
      458                   and buf_code-range.stts = "f":U
      459                 ) or
      460                 ( buf_code-range.range-type = p-curr-type-cdrg
