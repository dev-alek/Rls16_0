    13266   procedure rest-wth-doc-full :
    13267     do
    13268     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13269     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    13270     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    13271     :
    13272         assign ind1 = 0
    13273                fl   = "wth-doc".
    13274       for each ub.wth-doc no-lock
    13275       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13276       :
    13277         if can-find(first ub.wth-parts where ub.wth-parts.out-code = ub.wth-doc.doc-code) or
    13278         can-find(first ub.clients where ub.clients.db-num = p-db-num
    13279                                     and ub.clients.obj-type = ub.wth-doc.obj-type
    13280                                     and ub.clients.obj-code = ub.wth-doc.obj-code
    13281                  )
    13282         then do:
    13283           assign  ind1 = ind1 + 1.
    13284           display ind1 count-str fl with frame ddd view-as dialog-box.
    13285           create dst.wth-doc.
    13286           buffer-copy  ub.wth-doc to dst.wth-doc.
    13287           for each ub.wth-line no-lock
    13288               where ub.wth-line.doc-code = ub.wth-doc.doc-code
    13289           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13290           :
    13291             create dst.wth-line.
    13292             buffer-copy ub.wth-line to dst.wth-line.
    13293           end.
    13294           for each ub.wth-dtl no-lock
    13295               where ub.wth-dtl.doc-code = ub.wth-doc.doc-code
    13296           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13297           :
    13298             create dst.wth-dtl.
    13299             buffer-copy  ub.wth-dtl to dst.wth-dtl.
    13300           end.
    13301           for each ub.wth-doc-attr no-lock
    13302               where ub.wth-doc-attr.doc-code = ub.wth-doc.doc-code
    13303           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13304           :
    13305             create dst.wth-doc-attr.
    13306             buffer-copy  ub.wth-doc-attr to dst.wth-doc-attr.
    13307           end.
    13308           if ub.wth-doc.auto-fill = yes then do:
    13309             if p-unload-history then do:
    13310               for each ub.c-chk-doc no-lock
    13311                   where ub.c-chk-doc.out-code = ub.wth-doc.doc-code
    13312               on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13313               :
    13314                 create dst.c-chk-doc.
    13315                 buffer-copy  ub.c-chk-doc to dst.c-chk-doc.
    13316               end.
    13317               for each ub.c-chk-pay no-lock
    13318                   where ub.c-chk-pay.out-code = ub.wth-doc.doc-code
    13319               on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13320               :
    13321                 create dst.c-chk-pay.
    13322                 buffer-copy  ub.c-chk-pay to dst.c-chk-pay.
    13323               end.
    13324             end.
    13325           end.
    13326         end.
    13327       end.
    13328     end.
    13329   end.
    13330   procedure rest-c-wth-doc-full :
    13331     do
    13332     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13333     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    13334     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    13335     :
    13336         assign ind1 = 0
    13337                fl   = "c-wth-doc".
    13338       for each ub.c-wth-doc no-lock  where
    13339          ub.c-wth-doc.is-del = yes
    13340       break by
    13341       ub.c-wth-doc.doc-code
    13342       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13343       :
    13344         if first-of(ub.c-wth-doc.doc-code) then do:
    13345           if can-find(first ub.c-wth-parts where ub.c-wth-parts.out-code = ub.c-wth-doc.doc-code) or
    13346           can-find(first ub.clients where ub.clients.db-num = p-db-num
    13347                                       and ub.clients.obj-type = ub.c-wth-doc.obj-type
    13348                                       and ub.clients.obj-code = ub.c-wth-doc.obj-code
    13349                   )
    13350           then do:
    13351             assign  ind1 = ind1 + 1.
    13352             display ind1 count-str fl with frame ddd view-as dialog-box.
    13353             create dst.c-wth-doc.
    13354             buffer-copy  ub.c-wth-doc to dst.c-wth-doc.
    13355             for each ub.c-wth-line no-lock
    13356                 where ub.c-wth-line.doc-code = ub.c-wth-doc.doc-code
    13357             on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13358             :
    13359               create dst.c-wth-line.
    13360               buffer-copy ub.c-wth-line to dst.c-wth-line.
    13361             end.
    13362             for each ub.c-wth-dtl no-lock
    13363                 where ub.c-wth-dtl.doc-code = ub.c-wth-doc.doc-code
    13364             on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13365             :
    13366               create dst.c-wth-dtl.
    13367               buffer-copy  ub.c-wth-dtl to dst.c-wth-dtl.
    13368             end.
    13369           end.
    13370         end.
    13371       end.
    13372     end.
    13373   end.
    13374   procedure rest-arh-wth-tot :
