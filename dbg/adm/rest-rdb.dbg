    14268   procedure rest-promo-action private :
    14269      do
    14270         on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14271         on stop   undo, return error substitute( "&1. stop", vss-workfile )
    14272         on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    14273         :
    14274         for each dst.PromoAction:
    14275            delete dst.PromoAction .
    14276         end.
    14277         for each dst.PromoAttr:
    14278            delete dst.PromoAttr .
    14279         end.
    14280         for each dst.promo-schedule:
    14281            delete dst.promo-schedule .
    14282         end.
    14283         for each dst.promo-schedule-week:
    14284            delete dst.promo-schedule-week .
    14285         end.
    14286         for each dst.PromoCriterion:
    14287            delete dst.PromoCriterion .
    14288         end.
    14289         for each dst.PromoGift:
    14290            delete dst.PromoGift .
    14291         end.
    14292         for each dst.PromoGoods:
    14293            delete dst.PromoGoods .
    14294         end.
    14295         for each dst.PromoObject:
    14296            delete dst.PromoObject .
    14297         end.
    14298         for each ub.PromoAction no-lock
    14299            where ub.PromoAction.end-date < today and ub.PromoAction.Status_ <> 2
    14300            on error  undo, return error substitute( "&1 (PromoAction). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14301            on stop   undo, return error substitute( "&1 (PromoAction). stop", vss-workfile )
    14302            on endkey undo, return error substitute( "&1 (PromoAction). endkey", vss-workfile )
    14303            :
    14304            create dst.PromoAction.
    14305            buffer-copy ub.PromoAction to dst.PromoAction .
    14306            for each ub.PromoAttr no-lock
    14307               where ub.PromoAttr.tablename = "PromoAction" and
    14308               ub.PromoAttr.attr-code = "promo-message" and
    14309               ub.PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
    14310               ub.PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3)))
    14311               on error  undo, return error substitute( "&1 (PromoAttr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14312               on stop   undo, return error substitute( "&1 (PromoAttr). stop", vss-workfile )
    14313               on endkey undo, return error substitute( "&1 (PromoAttr). endkey", vss-workfile )
    14314               :
    14315               create dst.PromoAttr.
    14316               buffer-copy ub.PromoAttr to dst.PromoAttr .
    14317            end.
    14318            for each ub.promo-schedule no-lock
    14319               where ub.promo-schedule.db-num = ub.PromoAction.db-num and
    14320               ub.promo-schedule.id = ub.PromoAction.promosched-id
    14321               on error  undo, return error substitute( "&1 (promo-schedule). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14322               on stop   undo, return error substitute( "&1 (promo-schedule). stop", vss-workfile )
    14323               on endkey undo, return error substitute( "&1 (promo-schedule). endkey", vss-workfile )
    14324               :
    14325               create dst.promo-schedule.
    14326               buffer-copy ub.promo-schedule to dst.promo-schedule .
    14327            end.
    14328            for each ub.promo-schedule-week no-lock
    14329               where ub.promo-schedule-week.db-num = ub.PromoAction.db-num and
    14330               ub.promo-schedule-week.promosched-id = ub.PromoAction.promosched-id
    14331               on error  undo, return error substitute( "&1 (promo-schedule-week). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14332               on stop   undo, return error substitute( "&1 (promo-schedule-week). stop", vss-workfile )
    14333               on endkey undo, return error substitute( "&1 (promo-schedule-week). endkey", vss-workfile )
    14334               :
    14335               create dst.promo-schedule-week.
    14336               buffer-copy ub.promo-schedule-week to dst.promo-schedule-week .
    14337            end.
    14338            for each ub.PromoCriterion no-lock
    14339               where ub.PromoCriterion.db-num = ub.PromoAction.db-num and
    14340               ub.PromoCriterion.idAction = ub.PromoAction.id
    14341               on error  undo, return error substitute( "&1 (PromoCriterion). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14342               on stop   undo, return error substitute( "&1 (PromoCriterion). stop", vss-workfile )
    14343               on endkey undo, return error substitute( "&1 (PromoCriterion). endkey", vss-workfile )
    14344               :
    14345               create dst.PromoCriterion.
    14346               buffer-copy ub.PromoCriterion to dst.PromoCriterion .
    14347            end.
    14348            for each ub.PromoGift no-lock
    14349               where ub.PromoGift.db-num = ub.PromoAction.db-num and
    14350               ub.PromoGift.idaction = ub.PromoAction.id
    14351               on error  undo, return error substitute( "&1 (PromoGift). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14352               on stop   undo, return error substitute( "&1 (PromoGift). stop", vss-workfile )
    14353               on endkey undo, return error substitute( "&1 (PromoGift). endkey", vss-workfile )
    14354               :
    14355               create dst.PromoGift.
    14356               buffer-copy ub.PromoGift to dst.PromoGift .
    14357            end.
    14358            for each ub.PromoGoods no-lock
    14359               where ub.PromoGoods.db-num = ub.PromoAction.db-num and
    14360               ub.PromoGoods.idAction = ub.PromoAction.id
    14361               on error  undo, return error substitute( "&1 (PromoGoods). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14362               on stop   undo, return error substitute( "&1 (PromoGoods). stop", vss-workfile )
    14363               on endkey undo, return error substitute( "&1 (PromoGoods). endkey", vss-workfile )
    14364               :
    14365               create dst.PromoGoods.
    14366               buffer-copy ub.PromoGoods to dst.PromoGoods .
    14367            end.
    14368            for each ub.PromoObject no-lock
    14369               where ub.PromoObject.db-num = ub.PromoAction.db-num and
    14370               ub.PromoObject.idAction = ub.PromoAction.id
    14371               on error  undo, return error substitute( "&1 (PromoObject). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14372               on stop   undo, return error substitute( "&1 (PromoObject). stop", vss-workfile )
    14373               on endkey undo, return error substitute( "&1 (PromoObject). endkey", vss-workfile )
    14374               :
    14375               create dst.PromoObject.
    14376               buffer-copy ub.PromoObject to dst.PromoObject .
    14377            end.
    14378         end.
    14379      end.
    14380   end procedure.
