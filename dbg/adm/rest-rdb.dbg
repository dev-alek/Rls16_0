     8737   function get-hist-nws-option returns logical (  input p-db-num as integer
     8738                                                  ,input p-tbl-name as character ):
     8739   define buffer buf_hist-nws-option for ub.hist-nws-option.
     8740   define buffer buf0_hist-nws-option for ub.hist-nws-option.
     8741   find first buf_hist-nws-option no-lock where
     8742             buf_hist-nws-option.table-name = p-tbl-name
     8743         and buf_Hist-nws-option.db-num = p-db-num
     8744         and buf_Hist-nws-option.host-code = 0
     8745         and buf_Hist-nws-option.obj-type = '':U
     8746         and buf_Hist-nws-option.obj-code = 0
     8747         and buf_Hist-nws-option.charkey_one = '':U
     8748         and buf_Hist-nws-option.charkey_two = '':U
     8749         and buf_Hist-nws-option.charkey_three = '':U
     8750         and buf_Hist-nws-option.key#_one = 0
     8751         and buf_Hist-nws-option.key#_two = 0
     8752         and buf_Hist-nws-option.key#_three = 0  no-error .
     8753   find first buf0_hist-nws-option no-lock where
     8754             buf0_hist-nws-option.table-name = p-tbl-name
     8755         and buf0_Hist-nws-option.db-num = 0
     8756         and buf0_Hist-nws-option.host-code = 0
     8757         and buf0_Hist-nws-option.obj-type = '':U
     8758         and buf0_Hist-nws-option.obj-code = 0
     8759         and buf0_Hist-nws-option.charkey_one = '':U
     8760         and buf0_Hist-nws-option.charkey_two = '':U
     8761         and buf0_Hist-nws-option.charkey_three = '':U
     8762         and buf0_Hist-nws-option.key#_one = 0
     8763         and buf0_Hist-nws-option.key#_two = 0
     8764         and buf0_Hist-nws-option.key#_three = 0  no-error .
     8765   if
     8766   (not available buf_hist-nws-option
     8767   or buf_hist-nws-option.get-hist-from-nws >= 0 )
     8768   and
     8769   (not available buf0_hist-nws-option
     8770   or buf0_hist-nws-option.hist-to-nws >= 0 )
     8771   then do:
     8772     return yes.
     8773   end.
     8774   return no.
     8775   end function.
     8776   do
     8777   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
