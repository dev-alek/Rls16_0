    12850   procedure rest-inkas :
    12851     define input parameter p-inkas_obj-type as character no-undo .
    12852     define input parameter p-inkas_obj-code as integer   no-undo .
    12853     do
    12854     on error  undo, return error substitute( "&1 (rest-inkas). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    12855     on stop   undo, return error substitute( "&1 (rest-inkas). stop", vss-workfile )
    12856     on endkey undo, return error substitute( "&1 (rest-inkas). endkey", vss-workfile )
    12857     :
    12858       assign ind1 = 0
    12859              fl   = "inkas".
    12860       for each ub.inkas no-lock
    12861           where ub.inkas.obj-type = p-inkas_obj-type
    12862             and ub.inkas.obj-code = p-inkas_obj-code
    12863       on error  undo, return error substitute( "&1 (rest-inkas/inkas). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    12864       on stop   undo, return error substitute( "&1 (rest-inkas/inkas). stop", vss-workfile )
    12865       on endkey undo, return error substitute( "&1 (rest-inkas/inkas). endkey", vss-workfile )
    12866       :
    12867         assign  ind1 = ind1 + 1.
    12868         display ind1 count-str fl with frame ddd view-as dialog-box.
    12869         create dst.inkas.
    12870         buffer-copy  ub.inkas to dst.inkas.
    12871         for each ub.inkas-pay no-lock
    12872             where ub.inkas-pay.inkas-code = ub.inkas.inkas-code
    12873         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12874         :
    12875           create dst.inkas-pay.
    12876           buffer-copy  ub.inkas-pay to dst.inkas-pay.
    12877         end.
    12878         for each ub.inkas-pay-desk no-lock
    12879             where ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code
    12880         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12881         :
    12882           create dst.inkas-pay-desk.
    12883           buffer-copy  ub.inkas-pay-desk to dst.inkas-pay-desk.
    12884         end.
    12885         for each ub.inkas-pay-wth no-lock
    12886             where ub.inkas-pay-wth.inkas-code = ub.inkas.inkas-code
    12887         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12888         :
    12889           create dst.inkas-pay-wth.
    12890           buffer-copy  ub.inkas-pay-wth to dst.inkas-pay-wth.
    12891         end.
    12892         for each ub.sale-doc no-lock
    12893             where ub.sale-doc.inkas-code = ub.inkas.inkas-code
    12894         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12895         :
    12896           create dst.sale-doc.
    12897           buffer-copy  ub.sale-doc to dst.sale-doc.
    12898         end.
    12899         if p-unload-history then do:
    12900           for each ub.c-sale-doc no-lock
    12901               where ub.c-sale-doc.inkas-code = ub.inkas.inkas-code
    12902           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12903           :
    12904             create dst.c-sale-doc.
    12905             buffer-copy  ub.c-sale-doc to dst.c-sale-doc.
    12906           end.
    12907           for each ub.c-inkas no-lock
    12908               where ub.c-inkas.inkas-code = ub.inkas.inkas-code
    12909           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12910           :
    12911             if ub.c-inkas.is-del = yes then do:
    12912               return error substitute( "К существующей продаже &1 есть история его удаления", ub.c-inkas.inkas-code ) .
    12913             end.
    12914             create dst.c-inkas.
    12915             buffer-copy ub.c-inkas to dst.c-inkas.
    12916           end.
    12917           for each ub.c-inkas-pay no-lock
    12918               where ub.c-inkas-pay.inkas-code = ub.inkas.inkas-code
    12919           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12920           :
    12921             create dst.c-inkas-pay.
    12922             buffer-copy ub.c-inkas-pay to dst.c-inkas-pay.
    12923           end.
    12924           for each ub.c-inkas-pay-desk no-lock
    12925               where ub.c-inkas-pay-desk.inkas-code = ub.inkas.inkas-code
    12926           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12927           :
    12928             create dst.c-inkas-pay-desk.
    12929             buffer-copy  ub.c-inkas-pay-desk to dst.c-inkas-pay-desk.
    12930           end.
    12931           for each ub.c-inkas-pay-wth no-lock
    12932               where ub.c-inkas-pay-wth.inkas-code = ub.inkas.inkas-code
    12933           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12934           :
    12935             create dst.c-inkas-pay-wth.
    12936             buffer-copy  ub.c-inkas-pay-wth to dst.c-inkas-pay-wth.
    12937           end.
    12938           for each ub.c-chk-doc no-lock
    12939               where ub.c-chk-doc.out-code = ub.inkas.inkas-code
    12940           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
