    14009   procedure rest-assort-matrix :
    14010   define input  parameter p-obj-type as character no-undo .
    14011   define input  parameter p-obj-code as integer   no-undo .
    14012     do
    14013     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14014     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    14015     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    14016     :
    14017     disable triggers for load of ub.assortment-matrix.
    14018     disable triggers for load of ub.assortment-matrix-attr.
    14019     disable triggers for load of ub.assortment-matrix-goods.
    14020     disable triggers for dump of ub.assortment-matrix.
    14021     disable triggers for dump of ub.assortment-matrix-attr.
    14022     disable triggers for dump of ub.assortment-matrix-goods.
    14023     disable triggers for load of dst.assortment-matrix.
    14024     disable triggers for load of dst.assortment-matrix-attr.
    14025     disable triggers for load of dst.assortment-matrix-goods.
    14026     disable triggers for dump of dst.assortment-matrix.
    14027     disable triggers for dump of dst.assortment-matrix-attr.
    14028     disable triggers for dump of dst.assortment-matrix-goods.
    14029     for each ub.assortment-matrix no-lock where
    14030              ub.assortment-matrix.obj-type = p-obj-type and
    14031              ub.assortment-matrix.obj-code = p-obj-code
    14032              on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14033              :
    14034             create dst.assortment-matrix .
    14035             buffer-copy ub.assortment-matrix to dst.assortment-matrix.
    14036             for each ub.assortment-matrix-goods no-lock where
    14037                     ub.assortment-matrix-goods.asmt-id = ub.assortment-matrix.asmt-id  and
    14038                     ub.assortment-matrix-goods.db-num  = ub.assortment-matrix.db-num
    14039                     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14040                     :
    14041                     create dst.assortment-matrix-goods .
    14042                     buffer-copy ub.assortment-matrix-goods to dst.assortment-matrix-goods .
    14043             end.
    14044             for each ub.assortment-matrix-attr no-lock where
    14045                     ub.assortment-matrix-attr.asmt-id = ub.assortment-matrix.asmt-id  and
    14046                     ub.assortment-matrix-attr.db-num  = ub.assortment-matrix.db-num
    14047                     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14048                     :
    14049                     create dst.assortment-matrix-attr .
    14050                     buffer-copy ub.assortment-matrix-attr to dst.assortment-matrix-attr .
    14051             end.
    14052     end.
    14053   end.
    14054   end procedure.
    14055   procedure rest-season :
    14056   define input  parameter p-obj-type as character no-undo .
    14057   define input  parameter p-obj-code as integer   no-undo .
    14058     do
    14059     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14060     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    14061     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    14062     :
    14063     disable triggers for load of ub.season.
    14064     disable triggers for load of ub.season-attr.
    14065     disable triggers for load of ub.gds-season.
    14066     disable triggers for load of ub.gds-season-attr.
    14067     disable triggers for dump of ub.season.
    14068     disable triggers for dump of ub.season-attr.
    14069     disable triggers for dump of ub.gds-season.
    14070     disable triggers for dump of ub.gds-season-attr.
    14071     disable triggers for load of dst.season.
    14072     disable triggers for load of dst.season-attr.
    14073     disable triggers for load of dst.gds-season.
    14074     disable triggers for load of dst.gds-season-attr.
    14075     disable triggers for dump of dst.season.
    14076     disable triggers for dump of dst.season-attr.
    14077     disable triggers for dump of dst.gds-season.
    14078     disable triggers for dump of dst.gds-season-attr.
    14079     for each ub.season no-lock:
    14080       find first ub.season-attr no-lock where ub.season-attr.sea-code =  ub.season.sea-code
    14081         and ub.season-attr.db-num = ub.season.db-num
    14082         and ub.season-attr.attr-code = 'sea-obj':U no-error.
    14083       if (available ub.season-attr
    14084           and ub.season-attr.attr-value = p-obj-type + string (p-obj-code))
    14085           or (not available ub.season-attr and p-obj-code = ?)
    14086       then do:
    14087         for each ub.season-attr no-lock where ub.season-attr.sea-code = ub.season.sea-code
    14088           and ub.season-attr.db-num = ub.season.db-num:
    14089           create dst.season-attr .
    14090           buffer-copy ub.season-attr to dst.season-attr .
    14091         end.
    14092         for each ub.gds-season no-lock where ub.gds-season.sea-code = ub.season.sea-code
    14093           and ub.gds-season.db-num = ub.season.db-num:
    14094           create dst.gds-season .
    14095           buffer-copy ub.gds-season to dst.gds-season .
    14096         end.
    14097         for each ub.gds-season-attr no-lock where ub.gds-season-attr.sea-code = ub.season.sea-code
    14098             and ub.gds-season-attr.db-num = ub.season.db-num:
    14099           create dst.gds-season-attr .
    14100           buffer-copy ub.gds-season-attr to dst.gds-season-attr .
    14101         end.
    14102         create dst.season.
    14103         buffer-copy ub.season to dst.season.
    14104       end.
    14105     end.
    14106   end.
    14107   end procedure.
    14108   procedure rest-fin-ob :
    14109   define input  parameter p-obj-type as character no-undo .
    14110   define input  parameter p-obj-code as integer   no-undo .
    14111     do
    14112     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14113     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    14114     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    14115     :
    14116     for each ub.fin-ob no-lock where
    14117              ub.fin-ob.obj-type = p-obj-type and
    14118              ub.fin-ob.obj-code = p-obj-code and
    14119              ub.fin-ob.doc-type = 'при':U  and
    14120              ub.fin-ob.status_  = 'факт':U
    14121             on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14122             :
    14123             for each ub.fin-ob-tax no-lock where
    14124                      ub.fin-ob-tax.host-code = ub.fin-ob.host-code and
    14125                      ub.fin-ob-tax.doc-code = ub.fin-ob.doc-code
    14126                      on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14127                      :
    14128                       create dst.fin-ob-tax.
