    14130             end.
    14131             for each ub.fin-ob-attr no-lock where
    14132                      ub.fin-ob-attr.host-code = ub.fin-ob.host-code and
    14133                      ub.fin-ob-attr.doc-code  = ub.fin-ob.doc-code
    14134                      on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14135                      :
    14136                       create dst.fin-ob-attr.
    14137                       buffer-copy ub.fin-ob-attr to dst.fin-ob-attr.
    14138             end.
    14139             for each ub.fin-ob-trn no-lock where
    14140                      ub.fin-ob-trn.host-code = ub.fin-ob.host-code and
    14141                      ub.fin-ob-trn.doc-code  = ub.fin-ob.doc-code
    14142                      on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14143                      :
    14144                       create dst.fin-ob-trn.
    14145                       buffer-copy ub.fin-ob-trn to dst.fin-ob-trn.
    14146             end.
    14147             for each ub.fin-gds-part no-lock where
    14148                      ub.fin-gds-part.host-code = ub.fin-ob.host-code and
    14149                      ub.fin-gds-part.fin-ob-code  = ub.fin-ob.doc-code
    14150                      on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14151                      :
    14152                       create dst.fin-gds-part.
    14153                       buffer-copy ub.fin-gds-part to dst.fin-gds-part.
    14154             end.
    14155           create dst.fin-ob.
    14156           buffer-copy ub.fin-ob to dst.fin-ob.
    14157     end.
    14158     end.
    14159   end procedure.
