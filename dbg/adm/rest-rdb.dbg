    13418   procedure rest-price-doc :
    13419     define input parameter p-price-doc_obj-type as character no-undo .
    13420     define input parameter p-price-doc_obj-code as integer   no-undo .
    13421     do
    13422     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13423     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    13424     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    13425     :
    13426       assign
    13427         ind1 = 0
    13428         fl   = 'price-doc':U
    13429       .
    13430       for each ub.price-doc no-lock
    13431         where ub.price-doc.obj-type = p-price-doc_obj-type
    13432           and ub.price-doc.obj-code = p-price-doc_obj-code
    13433       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13434       :
    13435         find first ub.batchprocess no-lock
    13436           where ub.batchprocess.bp_type     = 'prc':U
    13437             and ub.batchprocess.bp_status   = 'N':U
    13438             and ub.batchprocess.charkey_one = ub.price-doc.doc-num
    13439           no-error .
    13440         if available ub.batchprocess
    13441         then do:
    13442           create dst.batchprocess .
    13443           buffer-copy ub.batchprocess to dst.batchprocess .
    13444         end.
    13445         if ub.db.unload-arch = true
    13446         then do:
    13447           find first ub.batchprocess no-lock
    13448             where ub.batchprocess.bp_type     = 'arh':U
    13449               and ub.batchprocess.bp_status   = 'N':U
    13450               and ub.batchprocess.charkey_one = ub.price-doc.doc-num
    13451             no-error .
    13452           if available ub.batchprocess
    13453           then do:
    13454             create dst.batchprocess .
    13455             buffer-copy ub.batchprocess to dst.batchprocess .
    13456           end.
    13457           find first ub.batchprocess no-lock
    13458             where ub.BatchProcess.bp_type     = 'ahsp':U
    13459               and ub.BatchProcess.bp_status   = 'N':U
    13460               and ub.batchprocess.charkey_one = ub.price-doc.doc-num
    13461             no-error .
    13462           if available ub.batchprocess
    13463           then do:
    13464             create dst.batchprocess .
    13465             buffer-copy ub.batchprocess to dst.batchprocess .
    13466           end.
    13467         end.
    13468         if ub.db.unload-aht = true
    13469         then do:
    13470           find first ub.batchprocess no-lock
    13471             where ub.batchprocess.bp_type     = 'aht':U
    13472               and ub.batchprocess.bp_status   = 'N':U
    13473               and ub.batchprocess.charkey_one = ub.price-doc.doc-num
    13474             no-error .
    13475           if available ub.batchprocess
    13476           then do:
    13477             create dst.batchprocess .
    13478             buffer-copy ub.batchprocess to dst.batchprocess .
    13479           end.
    13480         end.
    13481         assign  ind1 = ind1 + 1.
    13482         display ind1 count-str fl with frame ddd view-as dialog-box.
    13483         for each ub.price-list no-lock
    13484           where ub.price-list.doc-num = ub.price-doc.doc-num
    13485         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13486         :
    13487           create dst.price-list.
    13488           buffer-copy ub.price-list to dst.price-list.
    13489         end.
    13490         for each ub.price-list-attr no-lock
    13491           where ub.price-list-attr.doc-num = ub.price-doc.doc-num
    13492         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13493         :
    13494           create dst.price-list-attr.
    13495           buffer-copy ub.price-list-attr to dst.price-list-attr.
    13496         end.
    13497         for each ub.parts no-lock
    13498           where ub.parts.out-code = ub.price-doc.doc-num
    13499         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13500         :
    13501           run process-parts in this-procedure .
    13502         end.
    13503         create dst.price-doc.
    13504         buffer-copy  ub.price-doc to dst.price-doc.
    13505       end.
    13506     end.
    13507     return.
    13508   end procedure.
    13509   procedure rest-chk :
    13510     define input parameter p-chk_obj-type as character no-undo .
    13511     define input parameter p-chk_obj-code as integer   no-undo .
    13512     define buffer buf_cash-desk for ub.caSH-DESK.
    13513     define variable V-IS-magia as logical no-undo .
    13514     do
    13515     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13516     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    13517     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    13518     :
    13519       assign ind1 = 0
    13520              fl   = "chk-doc".
    13521       find first buf_cash-desk no-lock where
    13522                 buf_cash-desk.obj-code = p-chk_obj-code
    13523             AND buf_cash-desk.db-num = p-db-num
    13524             AND buf_cash-desk.pos-type = 'MAGIA-XML':U no-error .
    13525       if available buf_cash-desk then do:
    13526         assign
    13527         v-is-magia = yes
    13528         .
    13529       end.
    13530       for each ub.chk-doc no-lock
    13531           where ub.chk-doc.obj-type = p-chk_obj-type
    13532             and ub.chk-doc.obj-code = p-chk_obj-code
    13533           use-index chk-out
    13534       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13535       :
    13536         assign  ind1 = ind1 + 1.
    13537         display ind1 count-str fl with frame ddd view-as dialog-box.
    13538         if v-is-magia then do:
    13539           find first temp-cash-desk where
    13540                   temp-cash-desk.cash-num = ub.chk-doc.pay-desk no-error.
    13541           if not available temp-cash-desk then do:
    13542             create temp-cash-desk.
    13543             assign
    13544             temp-cash-desk.cash-num = ub.chk-doc.pay-desk
    13545             temp-cash-desk.last-date = ub.chk-doc.chk-date
    13546             temp-cash-desk.last-time = ub.chk-doc.chk-time
    13547             .
    13548           end.
    13549           else do:
    13550             assign
    13551             temp-cash-desk.last-time     = if temp-cash-desk.last-date < ub.chk-doc.chk-date
    13552                                             or (temp-cash-desk.last-date = ub.chk-doc.chk-date
    13553                                                 and
    13554                                                 temp-cash-desk.last-time < ub.chk-doc.chk-time)
    13555                                             then ub.chk-doc.chk-time
    13556                                             else temp-cash-desk.last-time
    13557             temp-cash-desk.last-date     = (if temp-cash-desk.last-date < ub.chk-doc.chk-date
    13558                                             then ub.chk-doc.chk-date
    13559                                             else temp-cash-desk.last-date)
    13560             .
    13561           end.
    13562         end.
    13563         for each ub.marking-chk no-lock
    13564             where ub.marking-chk.doc-code = ub.chk-doc.doc-code
    13565         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13566         :
    13567           create dst.marking-chk.
    13568           buffer-copy  ub.marking-chk to dst.marking-chk.
    13569         end.
    13570         for each ub.chk-gds no-lock
    13571             where ub.chk-gds.doc-code = ub.chk-doc.doc-code
    13572         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13573         :
    13574           create dst.chk-gds.
    13575           buffer-copy  ub.chk-gds to dst.chk-gds.
    13576         end.
    13577         for each ub.chk-pay no-lock
    13578             where ub.chk-pay.doc-code = ub.chk-doc.doc-code
    13579         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13580         :
    13581           create dst.chk-pay.
    13582           buffer-copy  ub.chk-pay to dst.chk-pay.
    13583         end.
    13584         for each ub.chk-discnt no-lock
    13585             where ub.chk-discnt.doc-code = ub.chk-doc.doc-code
    13586         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13587         :
    13588           create dst.chk-discnt.
    13589           buffer-copy  ub.chk-discnt to dst.chk-discnt.
    13590         end.
    13591         for each ub.chk-doc-attr no-lock
    13592             where ub.chk-doc-attr.doc-code = ub.chk-doc.doc-code
    13593         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13594         :
    13595           create dst.chk-doc-attr.
    13596           buffer-copy  ub.chk-doc-attr to dst.chk-doc-attr.
    13597         end.
    13598         create dst.chk-doc.
    13599         buffer-copy  ub.chk-doc to dst.chk-doc.
    13600       end.
    13601       if v-is-magia then do:
    13602         for each temp-cash-desk:
    13603           find first buf_cash-desk no-lock where
    13604                    buf_cash-desk.db-num = p-db-num
    13605                AND buf_cash-desk.obj-code = p-chk_obj-code
    13606                AND buf_cash-desk.pos-type = 'MAGIA-XML':U
    13607                AND buf_cash-desk.cash-num = temp-cash-desk.cash-num no-error .
    13608           if available buf_cash-desk then
    13609           run cd-attr-write in this-procedure (
    13610                                                   input p-db-num
    13611                                                 ,input p-chk_obj-code
    13612                                                 ,input 'MAGIA-XML':U
    13613                                                 ,input temp-cash-desk.cash-num
    13614                                                 ,input 'MAGIA-XML_operative':U
    13615                                                 ,input 'last-check-date-time':U
    13616                                                 ,input (cd-attr-CD-DatetoString (temp-cash-desk.last-date) + chr(32)  +  string(temp-cash-desk.last-time, "HH:MM:SS":U)
    13617                                                       )
    13618                                                 ,input ?
    13619                                                 ,input 0.0
    13620                                                 ,input 0
    13621                                                 ,input no
    13622                                                 ) no-error.
    13623         end.
    13624       end.
    13625       if p-unload-history then do:
    13626         assign ind1 = 0
    13627               fl   = "c-chk-doc".
    13628         for each ub.c-chk-doc no-lock
    13629             where ub.c-chk-doc.obj-type = p-chk_obj-type
    13630               and ub.c-chk-doc.obj-code = p-chk_obj-code
    13631               and ub.c-chk-doc.is-del = yes
    13632             use-index idel
    13633         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13634         :
    13635           if ub.c-chk-doc.out-code <> ? then next.
    13636           assign  ind1 = ind1 + 1.
    13637           display ind1 count-str fl with frame ddd view-as dialog-box.
    13638           for each ub.c-chk-gds no-lock
    13639               where ub.c-chk-gds.doc-code = ub.c-chk-doc.doc-code
    13640                 and ub.c-chk-gds.chip-num = ub.c-chk-doc.chip-num
    13641           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13642           :
    13643             if ub.c-chk-gds.out-code <> ? then next.
    13644             create dst.c-chk-gds.
    13645             buffer-copy  ub.c-chk-gds to dst.c-chk-gds.
    13646           end.
    13647           for each ub.c-chk-pay no-lock
    13648               where ub.c-chk-pay.doc-code = ub.c-chk-doc.doc-code
    13649                 and ub.c-chk-pay.chip-num = ub.c-chk-doc.chip-num
    13650           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13651           :
    13652             if ub.c-chk-pay.out-code <> ? then next.
    13653             create dst.c-chk-pay.
    13654             buffer-copy  ub.c-chk-pay to dst.c-chk-pay.
    13655           end.
    13656           for each ub.c-chk-discnt no-lock
    13657               where ub.c-chk-discnt.doc-code = ub.c-chk-doc.doc-code
    13658                 and ub.c-chk-discnt.chip-num = ub.c-chk-doc.chip-num
    13659           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13660           :
    13661             if ub.c-chk-discnt.out-code <> ? then next.
    13662             create dst.c-chk-discnt.
    13663             buffer-copy  ub.c-chk-discnt to dst.c-chk-discnt.
    13664           end.
    13665           for each ub.c-chk-doc-attr no-lock
    13666               where ub.c-chk-doc-attr.doc-code = ub.c-chk-doc.doc-code
    13667                 and ub.c-chk-doc-attr.chip-num = ub.c-chk-doc.chip-num
    13668           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13669           :
    13670             if ub.c-chk-doc-attr.out-code <> ? then next.
    13671             create dst.c-chk-doc-attr.
    13672             buffer-copy  ub.c-chk-doc-attr to dst.c-chk-doc-attr.
    13673           end.
    13674           create dst.c-chk-doc.
    13675           buffer-copy  ub.c-chk-doc to dst.c-chk-doc.
    13676         end.
    13677       end.
    13678     end.
    13679     return.
    13680   end procedure.
    13681   procedure rest-tcc :
    13682     define input  parameter p-db-num      as integer   no-undo .
    13683     define input  parameter p-type-unload as character no-undo .
    13684     do
    13685     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13686     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    13687     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    13688     :
    13689       define buffer buf-ub_db-rec-attr  for ub.db-rec-attr .
    13690       define buffer buf-dst_db-rec-attr for dst.db-rec-attr .
    13691       define buffer buf-src_db-rec-attr for src.db-rec-attr .
    13692       define buffer buf_route       for dst.route .
    13693       define variable v-today       as date      no-undo.
    13694       define variable v-time        as integer   no-undo.
    13695       define variable v-command      as character no-undo .
    13696       define variable v-answer-code  as integer   no-undo .
    13697       define variable v-answer-msg   as character no-undo .
    13698       run fill-two-commit-command in this-procedure.
    13699       find first temp_db-rec-attr
    13700         where temp_db-rec-attr.db-num = ?
    13701         no-error .
    13702       if available temp_db-rec-attr then do:
    13703         return error substitute( "Нельзя выгрузить БД!&1Есть незавершенные распределенные команды при которых выгрузка недопустима!", chr(10) ).
    13704       end.
    13705       run cur-time in this-procedure
    13706         ( output v-today
    13707          ,output v-time
    13708         ).
    13709       run adm\comcom.p (p-db-num).
    13710       for each temp_db-rec-attr
    13711       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13712       :
    13713         if lookup( string( p-db-num ), temp_db-rec-attr.db-list, ",":U ) > 0 then do:
    13714           if temp_db-rec-attr.attr-type = "execution":U
    13715             or temp_db-rec-attr.attr-type = "recover":U
    13716           then do:
    13717             assign
    13718               v-answer-code = 0
    13719               v-answer-msg  = ""
    13720             .
    13721           end.
    13722           else do:
    13723             assign
    13724               v-answer-code = 1
    13725               v-answer-msg  = substitute( "Из-за выгрузки УБД &1 нельзя провести проверку.", p-db-num )
    13726             .
    13727             create buf-dst_db-rec-attr.
    13728             buffer-copy temp_db-rec-attr to buf-dst_db-rec-attr
    13729               assign
    13730                 buf-dst_db-rec-attr.db-num             = p-db-num
    13731                 buf-dst_db-rec-attr.attr-value-logical = yes
    13732             .
    13733           end.
    13734           find first buf-ub_db-rec-attr no-lock
    13735             where buf-ub_db-rec-attr.db-num       = p-db-num
    13736               and buf-ub_db-rec-attr.uniq-key-rec = temp_db-rec-attr.uniq-key-rec
    13737               and buf-ub_db-rec-attr.attr-code    = temp_db-rec-attr.attr-code
    13738             no-error .
    13739           if not available buf-ub_db-rec-attr then do:
    13740             create buf-ub_db-rec-attr.
    13741             buffer-copy temp_db-rec-attr to buf-ub_db-rec-attr
    13742               assign
    13743                 buf-ub_db-rec-attr.db-num             = p-db-num
    13744                 buf-ub_db-rec-attr.attr-value-logical = yes
    13745             .
    13746             if p-type-unload = 'unload-copy':U then do:
    13747               create buf-src_db-rec-attr.
    13748               buffer-copy temp_db-rec-attr to buf-src_db-rec-attr
    13749                 assign
    13750                   buf-src_db-rec-attr.db-num             = p-db-num
    13751                   buf-src_db-rec-attr.attr-value-logical = yes
    13752               .
    13753             end.
    13754           end.
    13755         end.
    13756       end.
    13757     end.
    13758   end procedure.
    13759   procedure display-with-frame :
    13760     define input parameter p-count-str      as character        no-undo.
    13761     define input parameter p-table-name     as character        no-undo.
    13762     define input parameter p-index          as integer          no-undo.
    13763     do
    13764     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13765     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    13766     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    13767     :
    13768         display
    13769             p-count-str     @ count-str
    13770             p-table-name    @ fl
    13771             p-index         @ ind1
    13772         with frame ddd
    13773         view-as dialog-box.
    13774     end.
    13775   end procedure.
