    11697             .
    11698           end.
    11699           if lookup(buf_rrdb-option.first-table-name, table-firm-db-no) > 0 then next.
    11700           output stream slog to rest-rdb.txt append .
    11701           export stream slog "table-firm-db-move" v-subject cur-time-string() .
    11702           output stream slog close .
    11703           if buf_rrdb-option.first-table-name begins 'c-':U then do:
    11704             assign
    11705             v-hn = yes
    11706             v-hn = get-hist-nws-option( input p-db-num
    11707                                         ,input buf_rrdb-option.first-table-name)
    11708             no-error .
    11709           end.
    11710           else do:
    11711             v-hn = yes.
    11712           end.
    11713           if not v-hn then do:
    11714             output stream slog to rest-rdb.txt append .
    11715             export stream slog "!!!SKIPPING other db  history records!!!!!" .
    11716             output stream slog close .
    11717           end.
    11718           run adm/cred-tbl.p (
    11719                               input this-procedure:handle
    11720                             ,input p-db-num
    11721                             ,input '':U
    11722                             ,input 0
    11723                             ,input ub.sysconf.host-code
    11724                             ,input count-str
    11725                             ,input (buf_rrdb-option.first-table-name + "," +                          buf_rrdb-option.second-table-name + "," +                          buf_rrdb-option.third-table-name + "," +                          buf_rrdb-option.fourth-table-name + "," +                          buf_rrdb-option.fifth-table-name + "," +                          buf_rrdb-option.sixth-table-name)
    11726                             ,input (string(buf_rrdb-option.first-table-export) + "," +                          string(buf_rrdb-option.second-table-export) + "," +                          string(buf_rrdb-option.third-table-export) + "," +                          string(buf_rrdb-option.fourth-table-export) + "," +                          string(buf_rrdb-option.fifth-table-export) + "," +                          string(buf_rrdb-option.sixth-table-export))
    11727                             ,input buf_rrdb-option.where-phrase
    11728                             ,input buf_rrdb-option.if-phrase
    11729                             ,input buf_rrdb-option.if-buffer-num
    11730                             ,input "firm-db"
    11731                             ,input v-hn
    11732                             ,input yes
    11733                             ) .
    11734           output stream slog to rest-rdb.txt append .
    11735           export stream slog "OK firm-db" v-subject cur-time-string() .
    11736           output stream slog close .
    11737         end.
    11738         assign
    11739         v-proceeded-host = v-proceeded-host + chr(4) + string(ub.sysconf.host-code)
    11740         .
    11741       end.
    11742       run rest-mpl in this-procedure .
    11743       hide frame ddd no-pause.
    11744       output stream slog to rest-rdb.txt append .
    11745       export stream slog "rest-sequence" cur-time-string() .
    11746       output stream slog close .
    11747       create alias restseq    for database value( ldbname( "dst":U ) ) .
    11748       create alias restseqflt for database value( ldbname( "dst":U ) ) .
    11749       run adm/restseq.p
    11750         ( input "rest-no-msg"
    11751          ,input "":U
    11752          ,input yes
    11753         ) no-error .
    11754       if error-status :error then do:
    11755         delete alias restseqflt.
    11756         delete alias restseq.
    11757         return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
    11758       end.
    11759       delete alias restseqflt.
    11760       delete alias restseq.
    11761       output stream slog to rest-rdb.txt append .
    11762       export stream slog "stop-rest-success" cur-time-string() .
    11763       output stream slog close .
    11764       output stream slog to rest-rdb.txt append .
    11765       export stream slog "two-commit-command" cur-time-string() .
    11766       output stream slog close .
    11767       run rest-tcc in this-procedure
    11768         ( input p-db-num
    11769          ,input p-type-unload
    11770         ) no-error .
    11771       if error-status :error then do:
    11772         message
    11773           vss-workfile vss-revision vss-description skip
    11774           "Ошибка при обработке команд two-commit" skip
    11775           error-status :get-message(1) skip
    11776           return-value skip
    11777           view-as alert-box error .
    11778         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
    11779       end.
    11780       output stream slog to rest-rdb.txt append .
    11781       export stream slog "stop-two-commit-command" cur-time-string() .
    11782       output stream slog close .
    11783       output stream slog to rest-rdb.txt append .
    11784       export stream slog "check-clients" cur-time-string() .
    11785       output stream slog close .
    11786       assign
    11787         ind1 = 0
    11788         fl = "":U
    11789         count-str = "Проверка привязки объектов"
    11790       .
    11791       for each ub.clients share-lock
    11792         where ub.clients.db-num = p-db-num
    11793       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    11794       :
    11795         assign
    11796           ind1 = ind1 + 1
    11797         .
    11798         do with frame inf
    11799         :
    11800           assign
    11801             count-str :screen-value   = string( count-str, count-str :format)
    11802             fl :screen-value          = string( fl, fl :format)
    11803             ind1 :screen-value        = string( ind1, ind1 :format)
    11804           .
    11805         end.
    11806         find first src.clients share-lock
    11807           where src.clients.obj-type = ub.clients.obj-type
    11808             and src.clients.obj-code = ub.clients.obj-code
    11809           no-error .
    11810         if not available src.clients
    11811           or ub.clients.db-num <> src.clients.db-num
    11812         then do:
    11813           return error substitute( "&1. Клиенты привязаны к разным БД. Возможно была запущена утилита переноса объекта.", vss-workfile, ub.clients.obj-type, ub.clients.obj-code ).
    11814         end.
    11815       end.
    11816       output stream slog to rest-rdb.txt append .
    11817       export stream slog "stop-check-clients" cur-time-string() .
    11818       output stream slog close .
    11819       assign
    11820         v-lock = true
    11821       .
    11822   define variable vss-include-info26 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
    11823   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
    11824     ( input  'unlock'
    11825     , input  p-db-num
    11826     , input  0
    11827     , input  ''
    11828     , output v-msg
    11829     , output v-lock
    11830     , output v-ok
    11831     ) no-error .
    11832       if error-status :error
    11833         or v-lock = true
    11834         or v-ok   = false
    11835       then do:
    11836         message
    11837           vss-workfile vss-revision vss-description skip
    11838           substitute( "&1", v-msg ) skip
    11839           return-value skip
    11840           error-status :get-message ( error-status :num-messages )
    11841           view-as alert-box error
    11842         .
    11843         return.
    11844       end.
    11845       output stream slog to rest-rdb.txt append .
    11846       export stream slog "start gds-mercury " cur-time-string() .
    11847       output stream slog close .
    11848       for each src.gds-mercury no-lock:
    11849         for each src.gds-mercury-attr no-lock where src.gds-mercury-attr.ID =  src.gds-mercury.ID
    11850           and src.gds-mercury-attr.db-num = src.gds-mercury.db-num:
    11851           create dst.gds-mercury-attr .
    11852           buffer-copy src.gds-mercury-attr to dst.gds-mercury-attr .
    11853         end.
    11854         create dst.gds-mercury.
    11855         buffer-copy src.gds-mercury to dst.gds-mercury.
    11856       end.
    11857       output stream slog to rest-rdb.txt append .
    11858       export stream slog "start vsd " cur-time-string() .
    11859       output stream slog close .
    11860       for each src.vsd where src.vsd.db-num = p-db-num no-lock:
    11861         for each src.vsd-attr no-lock where src.vsd-attr.ID =  src.vsd.ID
    11862           and src.vsd-attr.db-num = src.vsd.db-num:
    11863           create dst.vsd-attr .
    11864           buffer-copy src.vsd-attr to dst.vsd-attr .
    11865         end.
    11866         create dst.vsd.
    11867         buffer-copy src.vsd to dst.vsd.
    11868       end.
    11869       do transaction
    11870       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    11871       on stop   undo, return error substitute( "&1. stop", vss-workfile )
    11872       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    11873       :
    11874         disable triggers for load of ub.db.
    11875         find ub.db exclusive-lock
    11876           where ub.db.db-num = p-db-num
    11877         .
    11878         find dst.db exclusive-lock
    11879           where dst.db.db-num = p-db-num
    11880         .
    11881         assign
    11882           ub.db.db-key       = p-db-key
    11883           ub.db.db-key-enc   = p-db-key-enc
    11884           ub.db.stts         = 0
    11885           dst.db.db-key      = p-db-key
    11886           dst.db.db-key-enc  = p-db-key-enc
    11887           dst.db.stts        = 0
    11888         .
    11889         if p-type-unload = 'unload-copy':U then do:
    11890           find src.db exclusive-lock
    11891             where src.db.db-num = p-db-num
    11892           .
    11893           assign
    11894             src.db.db-key      = p-db-key
    11895             src.db.db-key-enc  = p-db-key-enc
    11896             src.db.stts        = 0
    11897           .
    11898         end.
    11899         run cur-time in this-procedure
    11900           ( output v-today
    11901            ,output v-time
    11902           ).
    11903         assign
    11904           v-command = "command":U + chr(1)
    11905                       + "get-inf-dbs":U
    11906         .
    11907   def var vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11908   define buffer buf27_db    for dst.db .
    11909   define buffer buf27_route for dst.route .
    11910   define variable v-msg#27    as character no-undo .
    11911   define variable v-lock#27   as logical   no-undo .
    11912   define variable v-ok#27     as logical   no-undo .
    11913   find first buf27_db no-lock
    11914     where buf27_db.db-num = 0
    11915     no-error
    11916   .
    11917   if not available buf27_db then do:
    11918     message
    11919       vss-include-info27 skip
    11920       vss-workfile vss-revision vss-description skip
    11921       substitute( "Попытка создать маршрутизацию на несуществующую БД &1", 0 ) skip
    11922       return-value skip
    11923       error-status :get-message ( error-status :num-messages )
    11924       view-as alert-box error
    11925     .
    11926   end.
    11927   if "dst":U <> "ub":U
    11928      or ( trim( buf27_db.db-key ) <> "":U
    11929           and buf27_db.db-key <> ?
    11930         )
    11931   then do:
    11932       disable triggers for load of dst.route .
    11933     create buf27_route .
    11934     assign
    11935       buf27_route.last-pack    = -1
    11936       buf27_route.name-rec     = v-command
    11937       buf27_route.db-num       = 0
    11938       buf27_route.uniq-key-rec = '':U
    11939       buf27_route.num-dump     = 0
    11940       buf27_route.tbl-ord      = dynamic-next-value( "s-news-ord":U, "dst":U )
    11941       .
    11942       assign
    11943         buf27_route.dump-ord = dynamic-next-value( "s-news-dord":U, "dst":U )
    11944       .
    11945       assign
    11946         buf27_route.CreDate      = v-today
    11947       .
    11948       assign
    11949         buf27_route.CreTimeInt   = v-time
    11950         buf27_route.CreTime      = string(v-time,"HH:MM:SS":U)
    11951       .
    11952       assign
    11953         buf27_route.CreUserName  = 'rest-rdb':U
    11954       .
    11955   end.
    11956   else do:
    11957   define variable vss-include-info28 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
    11958   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
    11959     ( input  'check'
    11960     , input  0
    11961     , input  0
    11962     , input  ''
    11963     , output v-msg#27
    11964     , output v-lock#27
    11965     , output v-ok#27
    11966     ) no-error .
    11967     if error-status :error
    11968       or v-lock#27 = true
    11969       or v-ok#27   = false
    11970     then do:
    11971       return error substitute( "&1. Маршрутизация записи &2.&3Ключ записи: &4&3&3"
    11972                                ,vss-include-info27
    11973                                ,v-command
    11974                                ,chr(10)
    11975                                ,'':U
    11976                              )
    11977                   + substitute( "&1&2&2&3&2&2&4"
    11978                                 ,v-msg#27
    11979                                 ,chr(10)
    11980                                 ,return-value
    11981                                 ,error-status :get-message( error-status :num-messages )
    11982                               ) .
    11983     end.
    11984   end.
    11985       end.
    11986     end.
    11987     if not can-find(first dst.db-attr where dst.db-attr.db-num = p-db-num and dst.db-attr.attr-code = 'ver-met':U) then
    11988     do:
    11989       for first dst.db-attr exclusive-lock where
    11990                 dst.db-attr.db-num = 0
    11991             and dst.db-attr.attr-code = 'ver-met':U
    11992       :
    11993         dst.db-attr.db-num = p-db-num.
    11994       end.
    11995     end.
    11996     disconnect dst.
    11997     if not v-multi
    11998     then
    11999     message
    12000       "Перекачка успешно завершена."
    12001       view-as alert-box information .
    12002     return.
    12003   end.
    12004   procedure cre-activ-code-range :
    12005     define input parameter p-db-num     like dst.code-range.db-num     no-undo.
    12006     define input parameter p-range-type like dst.code-range.range-type no-undo.
    12007     do
    12008     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12009     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12010     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12011     :
    12012       define variable v-b-code as integer   no-undo .
    12013       define variable crg-cre  as logical   no-undo .
    12014       if p-range-type = 'sclc':U
    12015         or p-range-type = 'sslc':U
    12016         or p-range-type = 'pglc':U
    12017       then do:
    12018         assign
    12019           p-db-num = 0
    12020         .
    12021       end.
    12022       if not can-find( first dst.code-range
    12023                        where dst.code-range.db-num     = p-db-num
    12024                          and dst.code-range.range-type = p-range-type
    12025                        no-lock
    12026                      )
    12027       then do:
    12028         if p-range-type = 'scgb':U
    12029           or p-range-type = 'dcgb':U
    12030           or p-range-type = 'sslc':U
    12031           or p-range-type = 'ssgb':U
    12032           or p-range-type = 'pglc':U
    12033           or p-range-type = 'cagb':U
    12034           or p-range-type = 'fdgb':U
    12035         then do:
    12036           return.
    12037         end.
    12038         else do:
    12039           return error "Нет ни одного диапазона с типом" + chr(32) + p-range-type.
    12040         end.
    12041       end.
    12042       find first dst.code-range
    12043         where dst.code-range.db-num     = p-db-num
    12044           and dst.code-range.range-type = p-range-type
    12045           and dst.code-range.stts       = "a":U
    12046         no-error .
    12047       if available dst.code-range then do:
    12048         assign
    12049           dst.code-range.stts = "u":U
    12050         .
    12051       end.
    12052       run get-max-code in this-procedure
    12053         ( input "f-u":U
    12054           ,input p-db-num
    12055           ,input p-range-type
    12056           ,input ?
    12057           ,input ?
    12058           ,input FALSE
    12059           ,output v-b-code
    12060         ).
    12061       if not can-find(first dst.code-range no-lock
    12062         where dst.code-range.db-num     = p-db-num
    12063           and dst.code-range.range-type = p-range-type
    12064           and dst.code-range.stts       = "a":U)
    12065         then do:
    12066         assign
    12067           crg-cre = FALSE
    12068         .
    12069         for each dst.code-range
    12070           where dst.code-range.db-num     = p-db-num
    12071             and dst.code-range.range-type = p-range-type
    12072             and dst.code-range.stts       = "u":U
    12073         by dst.code-range.first-code descending
    12074         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12075         :
    12076           assign
    12077             dst.code-range.stts = "a":U
    12078             crg-cre             = TRUE
    12079           .
    12080           leave .
    12081         end.
    12082         if not crg-cre then do:
    12083           for each dst.code-range
    12084             where dst.code-range.db-num     = p-db-num
    12085               and dst.code-range.range-type = p-range-type
    12086               and dst.code-range.stts       = "f":U
    12087           by dst.code-range.first-code
    12088           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12089           :
    12090             assign
    12091               dst.code-range.stts = "a":U
    12092             .
    12093             leave .
    12094           end.
    12095         end.
    12096       end.
    12097     end.
    12098   end procedure.
    12099   procedure create-date-on-object :
    12100     do
    12101     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12102     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12103     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12104     :
    12105       define input parameter p-obj-type   as character    no-undo.
    12106       define input parameter p-obj-code   as integer      no-undo.
    12107       define variable v-last-date   as date         no-undo.
    12108       define variable v-today       as date      no-undo.
    12109       define variable v-time        as integer   no-undo.
    12110       define buffer buf_obj-date      for dst.obj-date.
    12111       define buffer buf_trn-doc       for ub.trn-doc.
    12112       define buffer buf_price-doc     for ub.price-doc.
    12113       run cur-time in this-procedure ( output v-today
    12114                                      , output v-time
    12115                                      ).
    12116       find last buf_trn-doc no-lock
    12117           where buf_trn-doc.obj-type = p-obj-type
    12118             and buf_trn-doc.obj-code = p-obj-code
    12119             and buf_trn-doc.status_  = 'факт':U
    12120       use-index fact-order
    12121       no-error.
    12122       find last buf_price-doc
    12123           where buf_price-doc.obj-type = p-obj-type
    12124             and buf_price-doc.obj-code = p-obj-code
    12125             and buf_price-doc.status_  = 'акт':U
    12126       use-index fact-order
    12127       no-error.
    12128       if not available buf_trn-doc
    12129       and not available buf_price-doc
    12130       then do:
    12131           assign
    12132               v-last-date = v-today
    12133           .
    12134       end.
    12135       else do:
    12136         if not available buf_price-doc then do:
    12137           assign
    12138             v-last-date = buf_trn-doc.fact-date
    12139           .
    12140         end.
    12141         else do:
    12142           if not available buf_trn-doc then do:
    12143             assign
    12144               v-last-date = buf_price-doc.fact-date
    12145             .
    12146           end.
    12147           else do:
    12148             assign
    12149               v-last-date = ( if buf_trn-doc.fact-date > buf_price-doc.fact-date
    12150                               then buf_trn-doc.fact-date
    12151                               else buf_price-doc.fact-date
    12152                             )
    12153             .
    12154           end.
    12155         end.
    12156       end.
    12157       create buf_obj-date .
    12158       assign
    12159           buf_obj-date.obj-type  = p-obj-type
    12160           buf_obj-date.obj-code  = p-obj-code
    12161           buf_obj-date.sys-date  = v-last-date
    12162           buf_obj-date.status_   = 'новый':U
    12163           buf_obj-date.open-id   = "rest-rdb":U
    12164           buf_obj-date.open-date = v-today
    12165           buf_obj-date.open-time = v-time
    12166       .
    12167   end.
    12168   end procedure.
    12169   procedure process-parts :
    12170      define buffer marking-lines for ub.marking-lines.
    12171      define buffer buf_marking-lines for dst.marking-lines.
    12172     do
    12173     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12174     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12175     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12176     :
    12177       create dst.parts .
    12178       buffer-copy ub.parts to dst.parts .
    12179       define variable v-parts-gds-code as integer   no-undo .
    12180   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
    12181     (input  recid(ub.parts)
    12182     ,output v-parts-gds-code
    12183     ) no-error .
    12184       if error-status :error
    12185       then do:
    12186         message
    12187           vss-workfile vss-revision vss-description skip
    12188           "Ошибка при поиске товара для партии" skip
    12189           error-status :get-message(1) skip
    12190           return-value skip
    12191           view-as alert-box error .
    12192         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
    12193       end.
    12194       for each marking-lines where marking-lines.gds-code   = v-parts-gds-code
    12195                                and marking-lines.obj-type   = ub.parts.obj-type
    12196                                and marking-lines.obj-code   = ub.parts.obj-code
    12197                                and marking-lines.in-code    = ub.parts.in-code
    12198                                and marking-lines.out-code   = ub.parts.out-code
    12199                                and marking-lines.part-code  = ub.parts.part-code
    12200       no-lock
    12201       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ):
    12202          create buf_marking-lines.
    12203          buffer-copy  marking-lines to buf_marking-lines.
    12204          run rest-Onemark(buf_marking-lines.mark).
    12205       end.
    12206       find first ub.parts-supp no-lock
    12207         where ub.parts-supp.in-code   = ub.parts.in-code
    12208           and ub.parts-supp.artic     = ub.parts.artic
    12209           and ub.parts-supp.prod-type = ub.parts.prod-type
    12210           and ub.parts-supp.prod-code = ub.parts.prod-code
    12211           and ub.parts-supp.part-code = ub.parts.part-code
    12212         no-error .
    12213       if available ub.parts-supp
    12214       then do:
    12215         if not can-find (first dst.parts-supp no-lock
    12216           where dst.parts-supp.in-code   = ub.parts.in-code
    12217             and dst.parts-supp.artic     = ub.parts.artic
    12218             and dst.parts-supp.prod-type = ub.parts.prod-type
    12219             and dst.parts-supp.prod-code = ub.parts.prod-code
    12220             and dst.parts-supp.part-code = ub.parts.part-code)
    12221         then do:
    12222           create dst.parts-supp .
    12223           buffer-copy ub.parts-supp to dst.parts-supp .
    12224         end.
    12225       end.
    12226       if not can-find (first dst.parts-attr no-lock
    12227         where dst.parts-attr.in-code   = ub.parts.in-code
    12228           and dst.parts-attr.gds-code  = v-parts-gds-code
    12229           and dst.parts-attr.part-code = ub.parts.part-code)
    12230       then do:
    12231         find first ub.parts-attr no-lock
    12232           where ub.parts-attr.in-code   = ub.parts.in-code
    12233             and ub.parts-attr.gds-code  = v-parts-gds-code
    12234             and ub.parts-attr.part-code = ub.parts.part-code
    12235           no-error .
    12236         if available ub.parts-attr
    12237         then do:
    12238           create dst.parts-attr .
    12239           buffer-copy ub.parts-attr to dst.parts-attr .
    12240         end.
    12241       end.
    12242       for each ub.parts-add no-lock
    12243         where  ub.parts-add.in-code   = ub.parts.in-code
    12244           and  ub.parts-add.gds-code  = v-parts-gds-code
    12245           and  ub.parts-add.part-code = ub.parts.part-code :
    12246         if not can-find (first dst.parts-add no-lock
    12247         where  dst.parts-add.in-code   = ub.parts.in-code
    12248           and  dst.parts-add.gds-code  = v-parts-gds-code
    12249           and  dst.parts-add.part-code = ub.parts.part-code
    12250           and  dst.parts-add.add-doc-code  = ub.parts-add.add-doc-code
    12251           and  dst.parts-add.add-gds-code  = ub.parts-add.add-gds-code
    12252           and  dst.parts-add.cli-type      = ub.parts-add.cli-type
    12253           and  dst.parts-add.cli-code      = ub.parts-add.cli-code
    12254           and  dst.parts-add.host-code     = ub.parts-add.host-code
    12255           and  dst.parts-add.contract-code = ub.parts-add.contract-code)
    12256           then do:
    12257             create dst.parts-add .
    12258             buffer-copy ub.parts-add to dst.parts-add .
    12259           end.
    12260       end.
    12261     end.
    12262   end procedure.
    12263   procedure process-c-parts :
    12264     do
    12265     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12266     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12267     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12268     :
    12269       create dst.c-parts .
    12270       buffer-copy ub.c-parts to dst.c-parts .
    12271       define variable v-parts-gds-code as integer   no-undo .
    12272   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
    12274     (input  ub.c-parts.artic
    12275     ,input  ub.c-parts.prod-type
    12276     ,input  ub.c-parts.prod-code
    12277     ,output v-parts-gds-code
    12278     ) no-error .
    12279       if error-status :error
    12280       then do:
    12281         message
    12282           vss-workfile vss-revision vss-description skip
    12283           "Ошибка при поиске кода товара по артикулу для таблицы c-parts" skip
    12284           "Указатель на запись c-parts" recid(ub.c-parts) skip
    12285           "Артикул" ub.c-parts.artic ub.c-parts.prod-type ub.c-parts.prod-code skip
    12286           error-status :get-message(1) skip
    12287           return-value skip
    12288           view-as alert-box error .
    12289         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
    12290       end.
    12291       if not can-find (first dst.c-parts-attr no-lock
    12292         where dst.c-parts-attr.in-code   = ub.c-parts.in-code
    12293           and dst.c-parts-attr.gds-code  = v-parts-gds-code
    12294           and dst.c-parts-attr.part-code = ub.c-parts.part-code)
    12295       then do:
    12296         find first ub.c-parts-attr no-lock
    12297           where ub.c-parts-attr.in-code   = ub.c-parts.in-code
    12298             and ub.c-parts-attr.gds-code  = v-parts-gds-code
    12299             and ub.c-parts-attr.part-code = ub.c-parts.part-code
    12300           no-error .
    12301         if available ub.c-parts-attr
    12302         then do:
    12303           create dst.c-parts-attr .
    12304           buffer-copy ub.c-parts-attr to dst.c-parts-attr .
    12305         end.
    12306       end.
    12307     end.
    12308   end procedure.
    12309   procedure rest-OneMark :
    12310      define input parameter p-mark as character no-undo .
    12311      define buffer marking          for  ub.marking.
    12312      define buffer buf_marking      for dst.marking.
    12313      define buffer marking-attr     for  ub.marking-attr.
    12314      define buffer buf_marking-attr for dst.marking-attr.
    12315      find first buf_marking where buf_marking.mark eq p-mark
    12316      no-lock no-error.
    12317      if not available buf_marking
    12318      then do:
    12319         find first marking where marking.mark eq p-mark
    12320         no-lock no-error.
    12321         if available  marking
    12322         then do on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ):
    12323            create buf_marking.
    12324            buffer-copy marking to buf_marking.
    12325            if     buf_marking.obj-type eq 'маг':U
    12326               and buf_marking.sts eq objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
    12327            then do:
    12328               find dst.shop where dst.shop.obj-code = buf_marking.obj-code no-lock.
    12329               if not available ub.shop
    12330               then
    12331                  buf_marking.sts eq objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB.
    12332            end.
    12333            for each marking-attr where marking-attr.mark eq buf_marking.mark
    12334            no-lock
    12335            on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ):
    12336               create buf_marking-attr.
    12337               buffer-copy marking-attr to buf_marking-attr.
    12338            end.
    12339         end.
    12340      end.
    12341   end.
    12342   procedure rest-Utd :
    12343      define input parameter p-obj-type as character no-undo .
    12344      define input parameter p-obj-code as integer   no-undo .
    12345      define buffer utd                         for ub.utd.
    12346      define buffer but_utd                     for dst.utd.
    12347      define buffer utd-attr                    for ub.utd-attr.
    12348      define buffer but_utd-attr                for dst.utd-attr.
    12349      define buffer Utd-err                     for ub.Utd-err.
    12350      define buffer but_Utd-err                 for dst.Utd-err.
    12351      define buffer Utd-lines                   for ub.Utd-lines.
    12352      define buffer but_Utd-lines               for dst.Utd-lines.
    12353      define buffer Utd-marking-lines           for ub.Utd-marking-lines.
    12354      define buffer but_Utd-marking-lines       for dst.Utd-marking-lines.
    12355      define buffer Utd-err-attr                for ub.Utd-err-attr.
    12356      define buffer but_Utd-err-attr            for dst.Utd-err-attr.
    12357      define buffer Utd-lines-attr              for ub.Utd-lines-attr.
    12358      define buffer but_Utd-lines-attr          for dst.Utd-lines-attr.
    12359      define buffer Utd-marking-lines-attr      for ub.Utd-marking-lines-attr.
    12360      define buffer but_Utd-marking-lines-attr  for dst.Utd-marking-lines-attr.
    12361      do
    12362      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12363      on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12364      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12365      :
    12366         assign
    12367            ind1 = 0
    12368            fl   = 'trn-doc':U
    12369         .
    12370         if transaction = true
    12371         then do:
    12372            message
    12373               vss-workfile vss-revision vss-description skip
    12374               "При выгрузке УПД активна транзакция" skip
    12375               "Выгрузка невозможна" skip
    12376            view-as alert-box error .
    12377            undo, return error "При выгрузке документов активна транзакция" .
    12378         end.
    12379         for each utd no-lock
    12380            where Utd.obj-type = p-obj-type
    12381              and UTD.obj-code = p-obj-code
    12382         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12383         :
    12384            create but_utd.
    12385            buffer-copy utd to but_utd.
    12386            assign  ind1 = ind1 + 1.
    12387            display ind1 count-str fl with frame ddd view-as dialog-box.
    12388            for each utd-attr where  Utd-attr.db-num eq   Utd.db-num
    12389                                    and  Utd-attr.doc-id eq   Utd.doc-id
    12390            no-lock:
    12391               create but_Utd-attr.
    12392               buffer-copy Utd-attr to but_Utd-attr.
    12393            end.
    12394            for each utd-err where  Utd-err.db-num eq   Utd.db-num
    12395                               and  Utd-err.doc-id eq   Utd.doc-id
    12396            no-lock:
    12397               create but_Utd-err.
    12398               buffer-copy Utd-err to but_Utd-err.
    12399            end.
    12400            for each  Utd-lines where  Utd-lines.db-num eq   Utd.db-num
    12401                                  and  Utd-lines.doc-id eq   Utd.doc-id
    12402            no-lock:
    12403               create but_Utd-lines.
    12404               buffer-copy Utd-lines to but_Utd-lines.
    12405            end.
    12406            for each  Utd-marking-lines where  Utd-marking-lines.db-num eq   Utd.db-num
    12407                                          and  Utd-marking-lines.doc-id eq   Utd.doc-id
    12408            no-lock:
    12409               create but_Utd-marking-lines.
    12410               buffer-copy Utd-marking-lines to but_Utd-marking-lines.
    12411               run rest-OneMark(but_Utd-marking-lines.mark).
    12412            end.
    12413            for each utd-err-attr where  Utd-err-attr.db-num eq   Utd.db-num
    12414                                    and  Utd-err-attr.doc-id eq   Utd.doc-id
    12415            no-lock:
    12416               create but_Utd-err-attr.
    12417               buffer-copy Utd-err-attr to but_Utd-err-attr.
    12418            end.
    12419            for each  Utd-lines-attr where  Utd-lines-attr.db-num eq   Utd.db-num
    12420                                       and  Utd-lines-attr.doc-id eq   Utd.doc-id
    12421            no-lock:
    12422               create but_Utd-lines-attr.
    12423               buffer-copy Utd-lines-attr to but_Utd-lines-attr.
    12424            end.
    12425            for each  Utd-marking-lines-attr where  Utd-marking-lines-attr.db-num eq   Utd.db-num
    12426                                               and  Utd-marking-lines-attr.doc-id eq   Utd.doc-id
    12427            no-lock:
    12428               create but_Utd-marking-lines-attr.
    12429               buffer-copy Utd-marking-lines-attr to but_Utd-marking-lines-attr.
    12430            end.
    12431         end.
    12432      end.
    12433   end.
    12434   procedure rest-trn-doc :
    12435     define input parameter p-trn_obj-type as character no-undo .
    12436     define input parameter p-trn_obj-code as integer   no-undo .
    12437     do
    12438     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12439     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    12440     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    12441     :
    12442       assign
    12443         ind1 = 0
    12444       .
    12445       assign
    12446         fl   = 'trn-doc':U
    12447       .
    12448       if transaction = true
    12449       then do:
    12450         message
    12451           vss-workfile vss-revision vss-description skip
    12452           "При выгрузке документов активна транзакция" skip
    12453           "Выгрузка невозможна" skip
    12454           view-as alert-box error .
    12455         undo, return error "При выгрузке документов активна транзакция" .
    12456       end.
    12457       for each ub.trn-doc no-lock
    12458         where ub.trn-doc.obj-type = p-trn_obj-type
    12459           and ub.trn-doc.obj-code = p-trn_obj-code
    12460       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12461       :
    12462         if ( ub.trn-doc.status_ = 'накл':U
    12463              and ub.trn-doc.flag_ = false
    12464            )
    12465            or ( ub.trn-doc.status_ = 'запрос':U
    12466                 and ub.trn-doc.flag_ = false
    12467               )
    12468         then do:
    12469           next.
    12470         end.
    12471         assign  ind1 = ind1 + 1.
    12472         display ind1 count-str fl with frame ddd view-as dialog-box.
    12473         create dst.trn-doc.
    12474         buffer-copy  ub.trn-doc to dst.trn-doc.
    12475         find first ub.batchprocess no-lock
    12476           where ub.batchprocess.bp_type     = 'trnhd':U
    12477             and ub.batchprocess.bp_status   = 'N':U
    12478             and ub.batchprocess.charkey_one = ub.trn-doc.doc-code
    12479           no-error .
    12480         if available ub.batchprocess
    12481         then do:
    12482           create dst.batchprocess .
    12483           buffer-copy ub.batchprocess to dst.batchprocess .
    12484         end.
    12485         if ub.db.unload-arch = true
    12486         then do:
    12487           find first ub.batchprocess no-lock
    12488             where ub.batchprocess.bp_type     = 'arh':U
    12489               and ub.batchprocess.bp_status   = 'N':U
    12490               and ub.batchprocess.charkey_one = ub.trn-doc.doc-code
    12491             no-error .
    12492           if available ub.batchprocess
    12493           then do:
    12494             create dst.batchprocess .
    12495             buffer-copy ub.batchprocess to dst.batchprocess .
    12496           end.
    12497           find first ub.batchprocess no-lock
    12498             where ub.batchprocess.bp_type     = 'ahsp':U
    12499               and ub.batchprocess.bp_status   = 'N':U
    12500               and ub.batchprocess.charkey_one = ub.trn-doc.doc-code
    12501             no-error .
    12502           if available ub.batchprocess
    12503           then do:
    12504             create dst.batchprocess .
    12505             buffer-copy ub.batchprocess to dst.batchprocess .
    12506           end.
    12507         end.
    12508         if ub.db.unload-aht = true
    12509         then do:
    12510           find first ub.batchprocess no-lock
    12511             where ub.batchprocess.bp_type     = 'aht':U
    12512               and ub.batchprocess.bp_status   = 'N':U
    12513               and ub.batchprocess.charkey_one = ub.trn-doc.doc-code
    12514             no-error .
    12515           if available ub.batchprocess
    12516           then do:
    12517             create dst.batchprocess .
    12518             buffer-copy ub.batchprocess to dst.batchprocess .
    12519           end.
    12520         end.
    12521         for each ub.doc-line no-lock
    12522             where ub.doc-line.doc-code = ub.trn-doc.doc-code
    12523         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12524         :
    12525           create dst.doc-line.
    12526           buffer-copy ub.doc-line to dst.doc-line.
    12527         end.
    12528         for each ub.gds-dtl no-lock
    12529             where ub.gds-dtl.doc-code = ub.trn-doc.doc-code
    12530         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12531         :
    12532           create dst.gds-dtl.
    12533           buffer-copy  ub.gds-dtl to dst.gds-dtl.
    12534         end.
    12535         for each ub.parts no-lock
    12536           where ub.parts.out-code = ub.trn-doc.doc-code
    12537         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12538         :
    12539           run process-parts in this-procedure no-error.
    12540           if error-status :error then do:
    12541             undo, return error substitute( 'rest-rdb.p: &1 &2' , return-value , error-status :get-message(1) ).
    12542           end.
    12543         end.
    12544         for each ub.parts-root no-lock
    12545           where ub.parts-root.doc-code = ub.trn-doc.doc-code
    12546         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12547         :
    12548           create dst.parts-root.
    12549           buffer-copy ub.parts-root to dst.parts-root.
    12550         end.
    12551         for each ub.inv-doc no-lock
    12552             where ub.inv-doc.doc-code = ub.trn-doc.doc-code
    12553         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12554         :
    12555           create dst.inv-doc.
    12556           buffer-copy ub.inv-doc to dst.inv-doc.
    12557         end.
    12558         for each ub.trn-doc-sum no-lock
    12559             where ub.trn-doc-sum.doc-code = ub.trn-doc.doc-code
    12560         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12561         :
    12562           create dst.trn-doc-sum.
    12563           buffer-copy ub.trn-doc-sum to dst.trn-doc-sum.
    12564         end.
    12565         for each ub.inv-line no-lock
    12566             where ub.inv-line.doc-code = ub.trn-doc.doc-code
    12567         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12568         :
    12569           create dst.inv-line.
    12570           buffer-copy ub.inv-line to dst.inv-line.
    12571         end.
    12572         for each ub.doc-line-sum no-lock
    12573             where ub.doc-line-sum.doc-code = ub.trn-doc.doc-code
    12574         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12575         :
    12576           create dst.doc-line-sum.
    12577           buffer-copy ub.doc-line-sum to dst.doc-line-sum.
    12578         end.
    12579         for each ub.doc-prts no-lock
    12580             where ub.doc-prts.out-code = ub.trn-doc.doc-code
    12581         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12582         :
    12583           create dst.doc-prts.
    12584           buffer-copy ub.doc-prts to dst.doc-prts.
    12585         end.
    12586         for each ub.doc-pl no-lock
    12587             where ub.doc-pl.out-code = ub.trn-doc.doc-code
