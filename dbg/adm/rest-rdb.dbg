     1353        end.
     1354        if v-avail7 > 0
     1355           and buf_code-range.stts = "f":U
     1356         then do:
     1357           assign
     1358             buf_code-range.stts = "u":U
     1359             v-b-code            = v-b-code + 1
     1360             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1361                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1362                                               , chr(10)
     1363                                               , buf_code-range.first-code
     1364                                               , buf_code-range.last-code
     1365                                               , v-code-mess7
     1366                                             )
     1367           .
     1368           if p-view-mess = true then do:
