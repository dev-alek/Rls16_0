      654   define new global shared variable g#library  as handle no-undo .
      655   define new global shared variable g#library2 as handle no-undo .
      656   define   shared variable g#auto as logical no-undo.
      657   define   shared variable g#news as logical no-undo.
      658   define   shared variable g#oxml as logical no-undo.
      659   define   shared variable g#esys as logical no-undo.
      660   define   shared variable g#news-source-db as integer no-undo.
      661   define   shared variable g#esys-source-esys as integer no-undo.
      662   define   shared variable g#db-num as integer   no-undo .
      663   define   shared variable g#userid as character no-undo .
      664   define   shared variable g#passwd as character no-undo .
      665   do
      666   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      667   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      668   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      669   :
      670     define variable v-is-petrol  as logical    no-undo.
      671     define variable v-is-pieces  as logical    no-undo.
      672     define variable v-value      as character  no-undo.
      673     define variable v-type       as character  no-undo.
      674     define buffer buf_goods   for ub.goods .
      675     do transaction
      676     on error  undo, return error substitute( "&1 (sys-key). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      677     on stop   undo, return error substitute( "&1 (sys-key). stop", vss-workfile )
      678     on endkey undo, return error substitute( "&1 (sys-key). endkey", vss-workfile )
      679     :
      680     if ( g#db-num = 0 ) then do:
      681       for each buf_goods
      682          where buf_goods.normal-wastage <> 0
      683          no-lock :
      684   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      685     (
      686        input buf_goods.artic
      687     ,  input buf_goods.prod-type
      688     ,  input buf_goods.prod-code
      689     , output v-is-petrol
      690     , output v-is-pieces
      691     ) .
      692           if  v-is-petrol = yes
      693           and v-is-pieces = no
      694           then do :
      695             run gds-attr-value in this-procedure (
      696                                              input buf_goods.gds-code
      697                                             ,input 'ptrl-as-good':U
      698                                             ,output v-value
      699                                             ,output v-type) no-error.
      700             if NOT logical(v-value) then do:
      701               if p-read-only = false then do:
      702                 run adm/initnwas.p
      703                     ( input buf_goods.artic ,
      704                       input buf_goods.prod-type ,
      705                       input buf_goods.prod-code
      706                     ) no-error .
      707                 if error-status :error then do:
      708                   return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ).
      709                 end.
      710               end.
      711               else do:
      712                 return error substitute("До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!") .
      713               end.
      714             end.
      715           end.
      716       end.
      717     end.
      718     disable triggers for load of ub.goods-attr.
      719     define buffer bf_goods-attr-1 for ub.goods-attr.
      720     define buffer bf_goods-attr-2 for ub.goods-attr.
      721     for each bf_goods-attr-1 exclusive-lock
      722       where bf_goods-attr-1.attr-code = 'is-oss-payment':
      723       find first bf_goods-attr-2 exclusive-lock
      724         where bf_goods-attr-2.gds-code = bf_goods-attr-1.gds-code
      725         and bf_goods-attr-2.attr-code = 'office-type':U
      726         no-error.
      727       if not available bf_goods-attr-2 then
      728         create bf_goods-attr-2.
      729       assign
      730         bf_goods-attr-2.gds-code = bf_goods-attr-1.gds-code
      731         bf_goods-attr-2.whole-send-news = bf_goods-attr-1.whole-send-news
      732         bf_goods-attr-2.attr-code = 'office-type':U
      733         bf_goods-attr-2.attr-value = 'oss-pay':U
      734       .
      735       release bf_goods-attr-2.
      736       delete bf_goods-attr-1.
      737     end.
      738   end.
      739   end.
