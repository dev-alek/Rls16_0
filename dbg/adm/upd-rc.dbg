      908     on error undo, return error
      909     :
      910        p-esys = g#esys.
      911     end.
      912   end procedure.
      913   define variable parparentproc as handle no-undo.
      914   parparentproc = this-procedure.
      915   run gbl/vertag.p (
      916         output v-version
      917       , output v-locale
      918       , output v-SVNRev
      919       , output v-compilerVersion
      920       , output v-compile-date
      921       , output v-time
      922       , output v-comment
      923       , output v-file-date
      924       , output v-file-time
      925       , output v-releace
      926       , output v-patch
      927       , output v-branch
      928   ) .
      929   if v-compile-date = ? then v-compile-date = 01/01/1970.
      930   define variable mRunFile as character no-undo.
      931   CheckUpd = new ibs.th.adm.upd.CheckUpd ().
      932   CheckUpd:workStop ().
      933   run waitfram-show in this-procedure ( input "Идет обновление программ ТН. Ждите..." ).
      934   put stream mProt unformatted "Каталог обновлений: " p0-source-dir skip.
      935   assign
      936     p0-pathrc = search( "adm/upd-rc.r":U )
      937   .
      938   if p0-pathrc = ? then do:
      939     assign
      940       p0-pathrc = search( "adm/upd-rc.p":U )
      941     .
      942     if p0-pathrc = ? then do:
      943       put stream mProt unformatted "Не найден путь на программы ТН" skip.
      944       return error "Не найден путь на программы ТН".
      945     end.
      946   end.
      947   put stream mProt unformatted "Путь к программам: " p0-pathrc skip.
      948   assign
      949     v-arc = search( "exe/7za.exe":U )
      950   .
      951   if v-arc = ? then do:
      952   assign
      953     v-arc = search( "exe/7z.exe":U )
      954   .
      955   end.
      956   if v-arc = ? then do:
      957     put stream mProt unformatted "Не найдена программа 7z.exe" skip.
      958     return error "Не найдена программа 7z.exe, раскрыть обновления невозможно" .
      959   end.
      960   put stream mProt unformatted "Архиватор: " v-arc skip.
      961   assign
      962     v-pathrc = substring(p0-pathrc, 1, r-index(p0-pathrc, "\") - 1 )
      963     v-pathrc = substring(v-pathrc, 1, r-index(v-pathrc, "\") - 1 )
      964     p0-pathrc = substring(v-pathrc, 1, r-index(v-pathrc, "\") - 1 )
      965     mFileLog  = substitute(
      966                   "&1update&2&3&4_th.log",
      967                   ibs.th.gbl.gbl-inipar:logDir,
      968                   year(today),
      969                   string(month(today),"99"),
      970                   string(day(today),"99"))
      971     add-log-file-name = mFileLog
      972   .
      973   put stream mProt unformatted "путь к rc: " v-pathrc skip.
      974   put stream mProt unformatted "v-pathrc: " v-pathrc skip.
      975   put stream mProt unformatted "p0-pathrc: " p0-pathrc skip.
      976   put stream mProt unformatted "mFileLog: " mFileLog skip.
      977   input stream flstream from os-dir ( p0-source-dir ) .
      978   put stream mProt unformatted " " skip.
      979   put stream mProt unformatted "обработка файлов из " p0-source-dir " " skip.
      980   repeat
      981   on error undo, return error
      982   :
      983     import stream flstream v-filename v-fullfilename v-filetype.
      984     if v-filetype begins "f" and num-entries( v-filename, "." ) > 1
      985       and ( ( v-filename begins "rc_20")
      986             or ( v-filename begins "update_")
      987           )
      988     then do:
      989       assign
      990         file-info:file-name = v-fullfilename
      991         v-txt = substring (v-filename,  index(v-filename, "_") + 1, 8)
      992         v-type = substring (v-filename,  index(v-filename, "_") + 10, 2)
      993         v-rc-filename       = p0-pathrc + "\" + v-filename
      994       .
      995       put stream mProt unformatted "найден файл: " v-filename skip.
      996       put stream mProt unformatted "копирование " v-fullfilename " " v-rc-filename skip.
      997       os-command silent
      998         value( "copy" )
      999         value( v-fullfilename )
     1000         value( v-rc-filename )
     1001       .
     1002       if os-error <> 0 or search(v-rc-filename) = ? then do:
     1003         put stream mProt unformatted "Невозможно скопировать файл: " v-fullfilename "в каталог" p0-pathrc skip.
     1004         return error substitute("Невозможно скопировать файл &1 в каталог &2", v-fullfilename, p0-pathrc) .
     1005       end.
     1006       put stream mProt unformatted "Скопирован: " v-filename " в " v-rc-filename skip.
     1007       v-date = date( integer(substring(v-txt,5,2)), integer(substring(v-txt,7,2)), integer(substring(v-filename, index(v-filename, "_") + 1, 4)) ) no-error.
     1008       if error-status:error or v-date < 01/01/2000 then
     1009       do:
     1010          run write-to-log (substitute(
     1011              "&1Имя файла &2 не соответствует шаблону update_20YYMMDD. Обновление не установлено.",
     1012              substitute("БД&1 ", g#db-num),
     1013              v-filename
     1014          )).
     1015          put stream mProt unformatted "Имя файла не соответствует шаблону update_20YYMMDD" v-filename skip.
     1016       end.
     1017       else
     1018       do:
     1019          find first upgfile-tbl no-lock
     1020             where upgfile-tbl.dateupg = v-date
     1021             no-error.
     1022          if not available upgfile-tbl then do:
     1023             create upgfile-tbl.
     1024             assign
     1025               upgfile-tbl.dateupg         = v-date
     1026               upgfile-tbl.nameupgfile     = v-filename
     1027               upgfile-tbl.fullnameupgfile = v-rc-filename
     1028               upgfile-tbl.type            = v-type
     1029             .
     1030             put stream mProt unformatted "Добавлен в таблицу обновлений: " v-filename " дата: " v-date skip.
     1031          end.
     1032       end.
     1033       os-delete value ( v-fullfilename ) recursive.
     1034       put stream mProt unformatted "Удален  файл: " v-fullfilename skip.
     1035     end.
     1036     if v-filetype begins "f" and num-entries( v-filename, "." ) > 1
     1037     and ( v-filename begins "UFO-")
     1038     then do:
     1039         put stream mProt unformatted "Найден UFO файл: " v-filename skip.
     1040         os-command silent
     1041           value( "copy" )
     1042           value( v-fullfilename )
     1043           value( p0-pathrc )
     1044         .
     1045         if os-error <> 0  or search(p0-pathrc + "/" + v-filename) = ? then do:
     1046           put stream mProt unformatted "Невозможно скопировать: " v-fullfilename " в каталог" p0-pathrc  skip.
     1047           return error substitute("Невозможно скопировать файл &1 в каталог &2", v-fullfilename, p0-pathrc) .
     1048         end.
     1049         put stream mProt unformatted "Скопирован UFO: " v-filename skip.
     1050         if search (p0-pathrc + "/" + v-filename) = ?
     1051         then
     1052         v-copy-err = true .
     1053         assign
     1054           file-info:file-name = p0-pathrc + "\ufo_update"
     1055         .
     1056         if file-info:file-type = ? then do:
     1057             os-create-dir value( p0-pathrc  + "\ufo_update" ).
     1058             if os-error <> 0 then do:
     1059                 put stream mProt unformatted "Невозможно создать папку: " p0-pathrc + "\ufo_update" skip.
     1060                 return error string ( "Невозможно создать папку " + p0-pathrc  + "\ufo_update" ).
     1061             end.
     1062             put stream mProt unformatted "Создана папка: " p0-pathrc + "\ufo_update" skip.
     1063         end.
     1064         else do :
     1065             assign
     1066               file-info:file-name = p0-pathrc + "\ufo_update-old"
     1067             .
     1068             if file-info:file-type <> ? then do:
     1069                 os-delete value ( p0-pathrc + "\ufo_update-old" ) recursive.
     1070                 if os-error <> 0 then do:
     1071                     os-rename  value ( p0-pathrc + "\ufo_update-old" ) value ( p0-pathrc + "\ufo_update-old1" ).
     1072                     if os-error <> 0 then do:
     1073                         put stream mProt unformatted "Невозможно удалить папку " skip.
     1074                         return error string ( "Невозможно удалить папку " + p0-pathrc + "\ufo_update-old, удалите ее сами" ).
     1075                     end.
     1076                 end.
     1077             end.
     1078             os-rename  value ( p0-pathrc + "\ufo_update" ) value ( p0-pathrc + "\ufo_update-old" ).
     1079             if os-error <> 0 then do:
     1080                 put stream mProt unformatted "Невозможно переименовать папку "  p0-pathrc skip.
     1081                 return error string(( "Невозможно переименовать папку " + p0-pathrc + "\ufo_update для сохранности" )).
     1082             end.
     1083             put stream mProt unformatted "Папка переименована: " p0-pathrc + "\ufo_update -> " p0-pathrc + "\ufo_update-old" skip.
     1084             put stream mProt unformatted "создаем rc папку " p0-pathrc  "\ufo_update" skip.
     1085             os-create-dir value( p0-pathrc  + "\ufo_update" ).
     1086             if os-error <> 0 then do:
     1087                 os-rename  value ( p0-pathrc  + "\ufo_update-old") value ( p0-pathrc  + "\ufo_update" ).
     1088                 put stream mProt unformatted "Невозможно создать папку " p0-pathrc  "\ufo_update" skip.
     1089                 return error string ( "Невозможно создать папку " + p0-pathrc  + "\ufo_update" ).
     1090             end.
     1091             put stream mProt unformatted "Создана новая папка: " p0-pathrc + "\ufo_update" skip.
     1092         end.
     1093         if not v-copy-err
     1094         then do :
     1095           v-txt = p0-pathrc + "\rc\exe\7z.exe" + " x -y -o" + p0-pathrc + "\ufo_update " +  p0-pathrc + "/" + v-filename.
     1096         end.
     1097         else do :
     1098           FILE-INFO:FILE-NAME = ".".
     1099           v-txt = v-pathrc + "\exe\7z.exe" + " x -y -o" + p0-pathrc + "\ufo_update " +  FILE-INFO:FULL-PATHNAME + "/" + v-filename.
     1100         end.
     1101         put stream mProt unformatted "разархивирование UFO: " v-txt skip.
     1102         os-command silent value ( v-txt ) .
     1103         v-pathrc = search( p0-source-dir + "/" + v-filename ).
     1104         os-delete value ( v-pathrc ) recursive.
     1105         put stream mProt unformatted "Удален UFO файл: " v-pathrc skip.
     1106     end.
     1107   end.
     1108   input stream flstream close.
     1109   put stream mProt unformatted "обраб. файлы из " p0-source-dir skip.
     1110   put stream mProt unformatted " " skip.
     1111   UPDATE_CYCLE:
     1112   for each upgfile-tbl no-lock
     1113   on error undo, return error return-value
     1114   :
     1115       put stream mProt unformatted "начало процесса обновления: " UpgFile-tbl.NameUpgFile " " skip.
     1116       run write-to-log (substitute("&1начало процесса обновления &2", substitute("БД&1 ", g#db-num), UpgFile-tbl.NameUpgFile)).
     1117       mIsError = upgfile-tbl.dateupg <= v-compile-date.
     1118       run write-to-log (substitute(
     1119                           "&1Сравнение даты обновления – &2",
     1120                           substitute("БД&1 ", g#db-num),
     1121                           if mIsError
     1122                             then "ошибка, дата обновления равна или меньше текущей версии r-кодов"
     1123                             else "успешно")
     1124                         ).
     1125       if mIsError then
     1126       do:
     1127         put stream mProt unformatted "Пропуск дата <= текущей: " UpgFile-tbl.NameUpgFile skip.
     1128         delete upgfile-tbl.
     1129         next UPDATE_CYCLE.
     1130       end.
     1131       mRunFile = SearchFile ("!beforeTH.bat").
     1132       if SearchFile (mRunFile) <> ?
     1133         then os-delete value ( mRunFile ).
     1134       mRunFile = SearchFile ("!upd-rc-before.bat").
     1135       if SearchFile (mRunFile) <> ?
     1136         then os-delete value ( mRunFile ).
     1137       mRunFile = SearchFile ("!upd-rc-after.bat").
     1138       if SearchFile (mRunFile) <> ?
     1139         then os-delete value ( mRunFile ).
     1140       v-txt = substitute('&1\exe\7z.exe x -y -o&1 &2 *.bat'
     1141                         , v-PathRC
     1142                         , UpgFile-tbl.FullNameUpgFile
     1143                         ) .
     1144       put stream mProt unformatted "распаковка BAT: " v-txt skip.
     1145       os-command silent value ( v-txt ) .
     1146       mIsError = os-error <> 0
     1147                or SearchFile ("!beforeTH.bat") = ?
     1148                or SearchFile ("!upd-rc-before.bat") = ?
     1149                or SearchFile ("!upd-rc-after.bat") = ?.
     1150       run write-to-log (substitute(
     1151                           "&1Копирование bat-файлов – &2",
     1152                           substitute("БД&1 ", g#db-num),
     1153                           if mIsError
     1154                             then "ошибка"
     1155                             else "успешно")
     1156                         ).
     1157       if mIsError then do:
     1158         put stream mProt unformatted "ошибка распаковки BAT " skip.
     1159         next UPDATE_CYCLE.
     1160       end.
     1161       put stream mProt unformatted "BAT файлы распакованы " skip.
     1162       mRunFile = SearchFile ("!beforeTH.bat").
     1163       if mRunFile ne ?
     1164       then do:
     1165          put stream mProt unformatted "Запуск !beforeTH.bat" skip.
     1166          run waitfram-show in this-procedure ("Выполнение " + mRunFile ).
     1167          os-command value (substitute ("&2 &1 exit" ,chr(38), mRunFile)).
     1168          mIsError = os-error <> 0 .
     1169          os-delete value ( mRunFile ).
     1170          run write-to-log (substitute(
     1171                              "&1Запуск !beforeTH.bat – &2",
     1172                              substitute("БД&1 ", g#db-num),
     1173                              if mIsError
     1174                                then "ошибка"
     1175                                else "успешно")
     1176                            ).
     1177          put stream mProt unformatted "Результат !beforeTH.bat: " (if mIsError then "ошибка" else "успешно") skip.
     1178          if mIsError then next UPDATE_CYCLE.
     1179       end.
     1180       run upload1C in this-procedure.
     1181           run nws/nws-init.p no-error.
     1182       mRunFile = SearchFile ("!upd-rc-before.bat").
     1183       if mRunFile ne ?
     1184       then do:
     1185          put stream mProt unformatted "Выполнение !upd-rc-before.bat" skip.
     1186          run waitfram-show in this-procedure ("Выполнение " + mRunFile ).
     1187          os-command value (substitute ("&2 &1 exit" ,chr(38), mRunFile)).
     1188          mIsError = os-error <> 0.
     1189          os-delete value ( mRunFile ).
     1190          run write-to-log (substitute(
     1191                              "&1Запуск !upd-rc-before.bat – &2",
     1192                              substitute("БД&1 ", g#db-num),
     1193                              if mIsError
     1194                                then "ошибка"
     1195                                else "успешно")
     1196                            ).
     1197          put stream mProt unformatted "Результат !upd-rc-before.bat: " (if mIsError then "ошибка" else "успешно") skip.
     1198          if mIsError then next UPDATE_CYCLE.
     1199       end.
     1200       if v-filename begins "rc_20" then do:
     1201         assign
     1202           file-info:file-name = v-pathrc + "-old"
     1203         .
     1204         if file-info:file-type <> ? then do:
     1205             os-delete value ( v-pathrc + "-old" ) recursive.
     1206             if os-error <> 0 then do:
     1207                 os-rename  value ( v-pathrc + "-old" ) value ( v-pathrc + "-old1" ).
     1208                 if os-error <> 0 then do:
     1209                     put stream mProt unformatted "ошибка удаления папки rc-old" skip.
     1210                     return error string ( "Невозможно удалить папку " + v-pathrc + "-old, удалите ее сами" ).
     1211                 end.
     1212             end.
     1213         end.
     1214         os-rename  value ( v-pathrc ) value ( v-pathrc + "-old" ).
     1215         if os-error <> 0 then do:
     1216             put stream mProt unformatted "ошибка переименования rc" skip.
     1217             return error string(( "Невозможно переименовать папку " + v-pathrc + " для сохранности" )).
     1218         end.
     1219         put stream mProt unformatted "Папка переименована: " v-pathrc " -> " v-pathrc + "-old" skip.
     1220         os-create-dir value( v-pathrc ).
     1221         if os-error <> 0 then do:
     1222             os-rename  value ( v-pathrc  + "-old") value ( v-pathrc ).
     1223             put stream mProt unformatted "ошибка создания папки rc" skip.
     1224             return error string ( "Невозможно создать папку " + v-pathrc ).
     1225         end.
     1226         put stream mProt unformatted "Создана папка: " v-pathrc skip.
     1227         v-txt = "".
     1228         v-txt =  v-PathRC + "-old\exe\7z.exe" + " x -y -o" + v-PathRC + " " +  UpgFile-tbl.FullNameUpgFile.
     1229         put stream mProt unformatted "Команда распаковки RC: " v-txt skip.
     1230         os-command silent value ( v-txt ) .
     1231         put stream mProt unformatted "Распаковка RC выполнена, код ошибки: " STRING(os-error) skip.
     1232       end.
     1233       v-delfile = search( "!delfile.bat" ).
     1234       if v-delfile <> ? then do:
     1235           put stream mProt unformatted "Найден !delfile.bat, выполнение удаления" skip.
     1236           input from value ( v-delfile ) .
     1237           repeat :
     1238              import unformatted v-txt.
     1239              if trim (v-txt) = "" then next.
     1240              v-txt = trim(substring ( v-txt, r-index(v-txt, " ") )).
     1241              if trim (v-txt) = "" then next.
     1242              v-txt = search( v-txt ).
     1243              put stream mProt unformatted "Удаление файла: " v-txt skip.
     1244              os-delete value ( v-txt ) recursive.
     1245           end.
     1246           input close.
     1247       end.
     1248       os-delete value ( v-delfile ) recursive.
     1249       put stream mProt unformatted "Удален !delfile.bat" skip.
     1250   end.
     1251   put stream mProt unformatted "запуск code-updck.p " skip.
     1252   run waitfram-show in this-procedure ("Выполнение xml-файлов обновления" ).
     1253   run gbl/code-updck.p(input  this-procedure)  no-error .
     1254   if error-status:error then
     1255   do:
     1256      put stream mProt unformatted "ошибка запуска code-updck.p: " return-value skip.
     1257      run write-to-log (substitute(
     1258                          "&1&2",
     1259                          substitute("БД&1 ", g#db-num),
     1260                          return-value)
     1261                        ).
     1262   end.
     1263   else do:
     1264      put stream mProt unformatted "code-updck.p выполнен " skip.
     1265   end.
     1266   def var v-file-name as character no-undo.
     1267   def var v-msg       as character no-undo.
     1268   mRunFile = SearchFile ("!upd-rc-after.bat").
     1269   if mRunFile ne ?
     1270   then do:
     1271      put stream mProt unformatted "Выполнение !upd-rc-after.bat" skip.
     1272      run waitfram-show in this-procedure ("Выполнение " + mRunFile ).
     1273      os-command value (substitute ("&2 &1 exit" ,chr(38), mRunFile)).
     1274      mIsError = os-error <> 0.
     1275      os-delete value ( mRunFile ).
     1276      run write-to-log (substitute(
     1277                          "&1Запуск !upd-rc-after.bat – &2",
     1278                          substitute("БД&1 ", g#db-num),
     1279                          if mIsError
     1280                            then "ошибка"
     1281                            else "успешно")
     1282                        ).
     1283      put stream mProt unformatted "Результат !upd-rc-after.bat: " (if mIsError then "ошибка" else "успешно") skip.
     1284   end.
     1285   assign
     1286     mDirLog = substring(p0-source-dir, r-index(p0-source-dir, "\") + 1).
     1287     mDirLog = substitute("&1-&2",entry(2,mDirLog,"-"),entry(1,mDirLog,"-")).
     1288     mDirLog = substring(p0-source-dir, 1, r-index(p0-source-dir, "\")) + mDirLog
     1289   .
     1290   os-command silent
     1291     value( "copy" )
     1292     value( mFileLog )
     1293     value( mDirLog + substring(mFileLog, r-index(mFileLog, "\")) )
     1294   .
     1295   add-log-file-name = ?.
     1296   CheckUpd:workStart ().
     1297   for each upgfile-tbl :
     1298       delete upgfile-tbl.
     1299   end.
     1300   put stream mProt unformatted (if can-find(first upgfile-tbl) then
     1301            "Установлены обновления Тrade Нouse. Для их применения необходимо закрыть все программы TH и запустить их снова."
     1302          else "Новых обновлений нет.") skip.
     1303   run waitfram-hide in this-procedure .
     1304   return if can-find(first upgfile-tbl) then
     1305            "Установлены обновления Тrade Нouse. Для их применения необходимо закрыть все программы TH и запустить их снова."
     1306          else "Новых обновлений нет.".
     1307   procedure upload1C:
     1308       oldg#news = g#news .
     1309       oldg#esys = g#esys .
     1310      g#news = false .
     1311      g#esys = true .
     1312      run bge/oxml-ini.p no-error.
     1313      run write-to-log (substitute(
     1314                           "&1инициализация переменных для системы OpenXML - &2",
     1315                           substitute("БД&1 ", g#db-num),
     1316                           if error-status:error
     1317                             then substitute("ошибка&1&2&3&4",
     1318                                             if return-value <> "" then chr(10) else "",
     1319                                             return-value,
     1320                                             if error-status :get-message( error-status :num-messages ) <> "" then chr(10) else "",
     1321                                             error-status :get-message( error-status :num-messages ))
     1322                             else "успешно")
     1323                       ).
     1324      define variable m-db-num as int no-undo.
     1325      define variable m-extsys as character no-undo.
     1326      find first sys-ctrl no-error.
     1327      m-db-num = sys-ctrl.db-num.
     1328      run bge/oxmlinx.p (
     1329             input parparentproc
     1330           , input this-procedure
     1331           , input this-procedure
     1332           , input substitute("&1,&2,&3,&4"
     1333                             , "take+analys"
     1334                             , m-db-num
     1335                             , m-extsys
     1336                             , 0)
     1337       ) no-error.
     1338       run write-to-log (substitute(
     1339                           "&1загрузка OpenXML – &2",
     1340                           substitute("БД&1 ", g#db-num),
     1341                           if error-status :error
     1342                             then substitute("ошибка&1&2&3&4",
     1343                                             if return-value <> "" then chr(10) else "",
     1344                                             return-value,
     1345                                             if error-status :get-message( error-status :num-messages ) <> "" then chr(10) else "",
     1346                                             error-status :get-message( error-status :num-messages ))
     1347                             else "успешно")
     1348                         ).
     1349       define variable m-err-code as character no-undo.
     1350       define variable m-message as character no-undo.
     1351       run bge/cnewxpck.p (
     1352                         input  m-extsys
     1353                       , output m-err-code
     1354       ) no-error .
     1355       run write-to-log (substitute(
     1356                           "&1подготовка новых пакетов – &2",
     1357                           substitute("БД&1 ", g#db-num),
     1358                           if error-status :error
     1359                             then substitute("ошибка&1&2&3&4",
     1360                                             if return-value <> "" then chr(10) else "",
     1361                                             return-value,
     1362                                             if error-status :get-message( error-status :num-messages ) <> "" then chr(10) else "",
     1363                                             error-status :get-message( error-status :num-messages ))
     1364                             else substitute("успешно&1&2",
     1365                                             if return-value <> "" then chr(10) else "",
     1366                                             return-value))
     1367                         ).
     1368       run bge/oxmloutx.p (
     1369               input parparentproc
     1370             , input this-procedure
     1371             , input this-procedure
     1372             , input substitute("all,&1", m-db-num )
     1373         ) no-error.
     1374       run write-to-log (substitute(
     1375                           "&1выгрузка OpenXML – &2",
     1376                           substitute("БД&1 ", g#db-num),
     1377                           if error-status :error
     1378                             then substitute("ошибка&1&2&3&4",
     1379                                             if return-value <> "" then chr(10) else "",
     1380                                             return-value,
     1381                                             if error-status :get-message( error-status :num-messages ) <> "" then chr(10) else "",
     1382                                             error-status :get-message( error-status :num-messages ))
     1383                             else "успешно")
     1384                         ).
     1385      g#news = oldg#news.
     1386      g#esys = oldg#esys.
     1387   end procedure.
     1388   FINALLY:
     1389           OUTPUT CLOSE.
     1390       END.
