        1   block-level on error undo, throw.
        2   define stream mProt.
        3   output stream mProt to "upd-rc.txt" convert target "ibm866".
        4   define input parameter p0-source-dir as character no-undo .
        5   define variable vss-revision    as character no-undo init "$revision: 9 $":u .
        6   define variable vss-author      as character no-undo init "$author: rumyantsev $":u .
        7   define variable vss-date        as character no-undo init "$date: 23.03.07 13:37 $":u .
        8   define variable vss-workfile    as character no-undo init "$workfile: upd-rc.p $":u .
        9   define variable vss-archive     as character no-undo init "$archive: /ver14_0/adm/upd-rc.p $":u .
       10   define variable vss-description as character no-undo init "Обновление r-кодов, обновления должны лежать передаваемом в каталоге".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   define variable v-waitfram-action01         as character   no-undo .
       67   define variable v-waitfram-action02         as character   no-undo .
       68   define variable v-waitfram-action03         as character   no-undo .
       69   define variable mWaitFramTextBeg            as character   no-undo.
       70   define variable mWaitFramTextEnd            as character   no-undo.
       71   define variable mWaitFramView               as logical     no-undo.
       72   define variable mWaitProcEvent              as logical     no-undo init yes.
       73   define variable mWaitFramInterval           as integer     no-undo init 1 .
       74   define variable mWaitFramStop               as logical     no-undo.
       75   define variable mWaitFramStopUser           as logical     no-undo.
       76   define variable mWaitFramStopTimeOut        as logical     no-undo.
       77   define variable mWaitFramStartProc          as datetime-tz no-undo.
       78   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       79   define button B-WaitFramStop auto-end-key
       80        label "Стоп"
       81        size 10 by 1 tooltip "Остоновить процесс".
       82   define button B-viewProcInfo
       83        label "Информация"
       84        size 15 by 1 tooltip "Информация о процесс".
       85   define frame waitfram
       86     v-waitfram-action01 format "x(72)" no-label skip
       87     v-waitfram-action02 format "x(72)" no-label skip
       88     v-waitfram-action03 format "x(72)" no-label skip
       89     B-viewProcInfo
       90     B-WaitFramStop at row 4 col 30
       91     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       92     .
       93   define new global shared variable mBatchMode as logical no-undo init ?.
       94   define variable mFramBachModHandle as handle no-undo.
       95   mFramBachModHandle = frame waitfram:handle.
       96   define variable mFameOldVis as logical no-undo.
       97   define variable mVisCUrentVin as logical no-undo.
       98   if session:batch-mode
       99   then
      100      mBatchMode = yes.
      101   if mBatchMode = ? then do:
      102     mVisCUrentVin = current-window:visible.
      103     mFameOldVis = mFramBachModHandle:visible.
      104     mFramBachModHandle:visible  = yes.
      105     mBatchMode = mFramBachModHandle:visible ne yes.
      106     mFramBachModHandle:visible = mFameOldVis.
      107     current-window:visible = mVisCUrentVin.
      108   end.
      109    if  log-manager:logfile-name ne ?
      110     then DO:
      111         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      112         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      113         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      114     end.
      115   on choose of B-WaitFramStop in frame waitfram
      116   do:
      117     mWaitFramStop = yes.
      118     mWaitFramStopUser = yes.
      119   end.
      120   function waitfram-check-timeout returns logical():
      121      define variable vtime as int64 no-undo.
      122      if mWaitFramStopTimeOut
      123      then
      124         return yes.
      125      vtime = ( now - mWaitFramStartProc ) / 1000 .
      126      if     mWaitFramTimeOut ne ?
      127         and mWaitFramTimeOut ne 0
      128         and mWaitFramTimeOut lt vtime
      129      then do:
      130         mWaitFramStopTimeOut = yes.
      131      end.
      132      return mWaitFramStopTimeOut.
      133   end.
      134   procedure waitfram-hide :
      135     if not session:batch-mode
      136     then do
      137     on error undo, return error return-value
      138     :
      139       pause 0 before-hide .
      140       if not mBatchMode then
      141         hide frame waitfram .
      142     if     not mWaitFramView
      143        and mWaitProcEvent
      144     then
      145       process events .
      146     end.
      147   end procedure.
      148   procedure waitfram-show :
      149     define input  parameter p-message as character no-undo .
      150     define variable v-left-margin as integer   no-undo .
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       if length(p-message) <= 70 then do:
      156         assign
      157           v-left-margin = integer((70 - length(p-message)) / 2)
      158         .
      159         assign
      160           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      161         .
      162         assign
      163           v-waitfram-action01 = " "
      164           v-waitfram-action02 = " "
      165                                    + fill(" ", v-left-margin)
      166                                    + p-message
      167           v-waitfram-action03 = " "
      168         .
      169       end.
      170       else do:
      171         define variable vRindex1 as integer no-undo.
      172         define variable vRindex2 as integer no-undo.
      173         vRindex1 = r-index(p-message," ",70).
      174         if vRindex1 = 0
      175         then
      176            vRindex1 = 70.
      177         if length(p-message)  <= vRindex1 + 70 then do:
      178           assign
      179             v-waitfram-action01 = " "
      180             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      181             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      182           .
      183         end.
      184         else do:
      185           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      186           if vRindex2 <= vRindex1
      187           then
      188              vRindex2 = vRindex1 + 70.
      189           assign
      190             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      191             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      192             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      193           .
      194         end.
      195       end.
      196       B-viewProcInfo:visible   in frame waitfram = no.
      197       B-viewProcInfo:sensitive in frame waitfram = no.
      198       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       if  (   mWaitFramView
      201          or  mWaitProcEvent)
      202          and not mBatchMode
      203       then
      204          display
      205             v-waitfram-action01 skip
      206             v-waitfram-action02 skip
      207             v-waitfram-action03 skip
      208          with frame waitfram .
      209       if     mWaitFramView
      210          then do:
      211             if     mWaitFramInterval ne ?
      212                and not mBatchMode
      213             then
      214                wait-for go of frame waitfram pause mWaitFramInterval.
      215          end.
      216          else
      217             if     mWaitProcEvent
      218                and not mBatchMode
      219             then
      220                process events .
      221     end.
      222   end procedure.
      223      procedure waitfram-show-this:
      224         define input  parameter iInterval as int64 no-undo.
      225         define variable vtime as int64 no-undo.
      226         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      227         mWaitFramInterval = iInterval.
      228         run waitfram-show (substitute("&1&2 &3&4" ,
      229                                       mWaitFramTextBeg ,
      230                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      231                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      232                                       mWaitFramTextEnd
      233                                      )
      234                           ).
      235      end.
      236      procedure WaitFramRunPause:
      237         define input  parameter iInterval as dec no-undo.
      238         define variable vStart  as datetime-tz no-undo.
      239         define variable vend    as datetime-tz no-undo.
      240         define variable vint as int64 no-undo.
      241         define variable vOk as logical no-undo.
      242         vStart = now.
      243         vend   = vStart.
      244         publish "WaitFramPause" (iInterval,output vOk).
      245         vend   =  now.
      246         vint = vend - vStart.
      247         vint = iInterval - vint / 1000.
      248         if     not mWaitFramStop
      249            and (   vint > 0
      250                 or (    not vOk
      251                     and iInterval eq ?
      252                     )
      253                 )
      254         then
      255            run waitfram-show-this (iInterval).
      256         vend   =  now.
      257         vint = vend - vStart.
      258         vint = iInterval - vint / 1000.
      259         if     not mWaitFramStop
      260            and vint > 0
      261         then do:
      262            run gbl/pause.p (vint * 1000).
      263         end.
      264         if iInterval ne ?
      265         then
      266            publish "WaitFramStop".
      267         waitfram-check-timeout().
      268      end.
      269      procedure WaitFramWaitFor:
      270         define input  parameter iInterval as dec no-undo.
      271         assign
      272            mWaitFramStartProc   = now
      273            mWaitFramStopUser    = no
      274            mWaitFramStopTimeOut = no
      275         .
      276         block-wait:
      277         do while not mWaitFramStop:
      278            run WaitFramRunPause (iInterval).
      279            if  waitfram-check-timeout()
      280            then do:
      281               leave block-wait.
      282            end.
      283         end.
      284         run waitfram-hide.
      285      end.
      286   procedure waitfram-join :
      287     define input  parameter p-line-1  as character no-undo .
      288     define input  parameter p-line-2  as character no-undo .
      289     define input  parameter p-line-3  as character no-undo .
      290     define output parameter p-message as character no-undo .
      291     do
      292     on error undo, return error return-value
      293     :
      294       assign
      295         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      298       .
      299     end.
      300   end procedure.
      301   function waitfram-join-function returns character
      302     (input p-line-1 as character
      303     ,input p-line-2 as character
      304     ,input p-line-3 as character
      305     ).
      306     define variable v-message as character no-undo .
      307     run waitfram-join in this-procedure
      308       (input  p-line-1
      309       ,input  p-line-2
      310       ,input  p-line-3
      311       ,output v-message
      312       ) .
      313     return v-message .
      314   end function .
      315   function objExists return character
      316   (input  ifolder as character,
      317    input  iType   as character  ):
      318       define variable vFileType as character no-undo init "D,F".
      319       define variable vi        as integer no-undo.
      320       define variable vtype as character no-undo.
      321       if iType ne ?
      322       then
      323          vFileType = iType.
      324       do vi = 1 to num-entries(vFileType):
      325          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      326          vtype = file-information:file-type.
      327          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      328             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      329             index(vtype , entry(vi,vFileType )) > 0
      330          then return file-information:full-pathname .
      331          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      332          vtype = file-information:file-type.
      333          if file-information:file-name <> "" and
      334             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      335             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      336             index( vtype, entry(vi,vFileType )) > 0
      337          then return file-information:full-pathname .
      338       end.
      339       return ? .
      340   end.
      341   function SearchFile return character
      342   (input  ifile as character):
      343      return objExists(ifile,?).
      344   end.
      345   function SearchPFile return character
      346   (input inFile as char):
      347        define variable oFile       as character no-undo.
      348        define variable vFileSearch as character no-undo.
      349        define variable vNumEntry   as integer no-undo.
      350        if inFile = "" then return ?.
      351        vNumEntry = num-entries(inFile,".").
      352        vFileSearch = inFile.
      353        if    vNumEntry > 0
      354           and (   entry(vNumEntry,inFile,".") eq "p"
      355                or entry(vNumEntry,inFile,".") eq "w")
      356        then do:
      357           entry(vNumEntry,vFileSearch, ".") = "r".
      358           oFile = search(vFileSearch ).
      359           if oFile eq ?
      360           then
      361              oFile = search(inFile).
      362        end.
      363        else
      364           oFile = search(vFileSearch).
      365        return oFile.
      366     end.
      367   define new global shared variable g#language as character no-undo .
      368   if g#language <> '' and g#language <> 'rus':U then do:
      369     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      370   end.
      371   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   define  shared variable g#auto-pid           as integer   no-undo .
      373   define  shared variable conn-par             as character no-undo .
      374   define  shared variable g#auto-user-id       as character no-undo .
      375   define  shared variable g#auto-user-login    as character no-undo .
      376   define  shared variable g#auto-user-password as character no-undo .
      377   define  shared variable v-socket             as logical   no-undo .
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   define  shared variable auto-window-h     as handle    no-undo .
      380   define  shared variable auto-log-msg-h    as handle    no-undo .
      381   define  shared variable hand-log-msg-h    as handle    no-undo .
      382   define  shared variable log-file-name     as character no-undo initial ? .
      383   define  shared variable add-log-file-name as character no-undo initial ? .
      384   define  shared variable writelogvalue     as character no-undo initial ? .
      385   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   procedure cur-time :
      387      define output parameter p-today as date      no-undo .
      388      define output parameter p-time  as integer   no-undo .
      389     do
      390     on error undo, return error
      391     :
      392       define variable v-date1 as date      no-undo .
      393       define variable v-date2 as date      no-undo .
      394       define variable v-time  as integer   no-undo .
      395       assign
      396         v-date1 = today
      397         v-time  = time
      398         v-date2 = today
      399       .
      400       if v-date1 <> v-date2
      401       then do:
      402         assign
      403           v-date1 = today
      404           v-time  = v-time
      405         .
      406       end.
      407       assign
      408         p-today = v-date1
      409         p-time  = v-time
      410       .
      411     end.
      412   end.
      413   function cur-time-date returns character
      414   :
      415     return string(today, '99/99/9999':U) .
      416   end.
      417   function cur-time-mjd returns decimal
      418   :
      419     define variable v-date as date      no-undo .
      420     define variable v-time as integer   no-undo .
      421     run cur-time in this-procedure
      422       (output v-date
      423       ,output v-time
      424       ) .
      425     return integer(v-date) - 2400002 + (v-time / 86400) .
      426   end.
      427   function cur-time-get-ending-index returns integer
      428   (input p-number as integer
      429   )
      430   :
      431     if p-number < 0
      432     or p-number = ?
      433     then do:
      434       return 1 .
      435     end.
      436     define variable v-rest as integer   no-undo .
      437     assign
      438       p-number = p-number modulo 100
      439     .
      440     if p-number < 20
      441     then do:
      442       assign
      443         v-rest = p-number
      444       .
      445     end.
      446     else do:
      447       assign
      448         v-rest = p-number modulo 10
      449       .
      450     end.
      451     case v-rest :
      452       when 1
      453       then do:
      454         return 2 .
      455       end.
      456       when 2 or
      457       when 3 or
      458       when 4
      459       then do:
      460         return 3 .
      461       end.
      462       otherwise do:
      463         return 1 .
      464       end.
      465     end case .
      466   end.
      467   procedure cur-time-mjd-to-date :
      468      define input  parameter i-mjd-diff as decimal no-undo.
      469      define output parameter o-Date     as date    no-undo.
      470      define output parameter o-Time     as integer no-undo.
      471      define variable v-day-number as integer   no-undo .
      472      if    i-mjd-diff < 0
      473         or i-mjd-diff = ?
      474      then do:
      475         return "?" .
      476      end.
      477      assign
      478         v-day-number = truncate(i-mjd-diff,0).
      479         o-Date = date(v-day-number + 2400002).
      480         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482   end.
      483   function cur-time-mjd-to-string returns character
      484   (input p-mjd-diff as decimal
      485   )
      486   :
      487     define variable v-day-number as integer   no-undo .
      488     define variable v-seconds    as integer   no-undo .
      489     define variable v-hour       as integer   no-undo .
      490     define variable v-min        as integer   no-undo .
      491     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      492     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      493     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      494     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      495     if p-mjd-diff < 0
      496     or p-mjd-diff = ?
      497     then do:
      498       return "?" .
      499     end.
      500     assign
      501       v-day-number = integer(truncate(p-mjd-diff,0))
      502       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      503     .
      504     if v-seconds > 86400
      505     then do:
      506       assign
      507         v-seconds = 86400 - 1
      508       .
      509     end.
      510     if v-seconds < 0
      511     then do:
      512       assign
      513         v-seconds = 0
      514       .
      515     end.
      516     assign
      517       v-hour = truncate(v-seconds / 3600, 0)
      518     .
      519     assign
      520       v-seconds = v-seconds modulo 3600
      521     .
      522     assign
      523       v-min = truncate(v-seconds / 60, 0)
      524     .
      525     assign
      526       v-seconds = v-seconds modulo 60
      527     .
      528     return
      529         (if v-day-number <> 0
      530           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      531           else ""
      532         )
      533       + (if v-day-number <> 0 or v-hour <> 0
      534           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      535           else ""
      536         )
      537       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      538           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      539           else ""
      540         )
      541       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      542       .
      543   end.
      544   function cur-time-string returns character
      545   :
      546     define variable v-date as date      no-undo .
      547     define variable v-time as integer   no-undo .
      548     run cur-time in this-procedure
      549       (output v-date
      550       ,output v-time
      551       ) .
      552     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      553   end.
      554   function cur-time-string-sec returns character
      555   :
      556     define variable v-date as date      no-undo .
      557     define variable v-time as integer   no-undo .
      558     run cur-time in this-procedure
      559       (output v-date
      560       ,output v-time
      561       ) .
      562     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      563   end.
      564   function cur-time-custom  returns character
      565   (input p-prefix as character
      566   ,input p-date-format as character
      567   ,input p-delimiter as character
      568   ,input p-time-format as character
      569   ,input p-suffix as character
      570   )
      571   :
      572     define variable v-date as date      no-undo .
      573     define variable v-time as integer   no-undo .
      574     run cur-time in this-procedure
      575       (output v-date
      576       ,output v-time
      577       ) .
      578     return
      579       p-prefix
      580       + string(v-date, p-date-format)
      581       + p-delimiter
      582       + string(v-time, p-time-format)
      583       + p-suffix
      584       .
      585   end.
      586   function cur-time-print  returns character
      587   :
      588     define variable v-date as date      no-undo .
      589     define variable v-time as integer   no-undo .
      590     run cur-time in this-procedure
      591       (output v-date
      592       ,output v-time
      593       ) .
      594     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      595   end.
      596   function cur-time-datetime returns datetime
      597   :
      598     define variable v-char as character no-undo .
      599     define variable v-datetime as datetime no-undo .
      600     v-char = cur-time-string().
      601     v-datetime = datetime(v-char).
      602     return  v-datetime.
      603   end.
      604   function cur-time-string-msec returns character
      605   :
      606     define variable v-date as datetime  no-undo .
      607     v-date = now.
      608     return string(v-date) .
      609   end.
      610   define stream LogStream .
      611   define variable mNoTime as logical no-undo.
      612   procedure write-to-log-notime :
      613     define input param i-str as character no-undo .
      614     mNoTime = yes.
      615     run write-to-log (i-str).
      616     mNoTime = no.
      617   end.
      618   procedure write-to-log :
      619     define input param p-str as character no-undo .
      620     do
      621     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      622     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      623     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      624     :
      625       define variable log-res        as logical   no-undo .
      626       define variable v-jj           as integer   no-undo .
      627       if    mNoTime
      628          or writelogvalue eq "AsyncProc"
      629       then
      630          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      631       else
      632          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      633       if auto-log-msg-h <> ? then do:
      634         log-res = auto-log-msg-h:move-to-eof( ) .
      635         log-res = auto-log-msg-h:insert-string( p-str ).
      636       end.
      637       if hand-log-msg-h <> ? then do:
      638         log-res = hand-log-msg-h:move-to-eof( ) .
      639         log-res = hand-log-msg-h:insert-string( p-str ).
      640       end.
      641       assign
      642         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      643         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      644         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      645       .
      646       if add-log-file-name <> ? then do:
      647         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      648           run gbl/fileapnd.p
      649             ( input entry(v-jj, add-log-file-name, chr(1) )
      650             ,input p-str
      651             ,input 20
      652             ) no-error .
      653           if error-status:error then do:
      654             return error return-value .
      655           end.
      656         end.
      657       end.
      658       if writelogvalue eq "AsyncProc"
      659       then do:
      660          p-str = trim(p-str, (chr(13) + chr(10)) )
      661       .
      662          Publish "WriteLogAsunc" (p-str,yes).
      663       end.
      664       else if writelogvalue <> "yes" then do:
      665         run gbl/fileapnd.p
      666           ( input log-file-name
      667           ,input p-str
      668           ,input 20
      669           ) no-error .
      670         if error-status:error then do:
      671           return error return-value .
      672         end.
      673       end.
      674     end.
      675   end procedure.
      676   procedure write-to-screen :
      677     define input param p-str as character no-undo .
      678     do
      679     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      680     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      681     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      682     :
      683       define variable log-res as logical no-undo.
      684       assign
      685         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      686       .
      687       if auto-log-msg-h <> ?
      688       then do:
      689         log-res = auto-log-msg-h:move-to-eof( ) .
      690         log-res = auto-log-msg-h:insert-string( p-str ).
      691       end.
      692       if hand-log-msg-h <> ?
      693       then do:
      694         log-res = hand-log-msg-h:move-to-eof( ) .
      695         log-res = hand-log-msg-h:insert-string( p-str ).
      696       end.
      697     end.
      698   end procedure.
      699   procedure send-msg-to-email :
      700     define input  parameter p-subject      as character no-undo .
      701     define input  parameter p-text-err     as character no-undo .
      702     define input  parameter p-attach-files as character no-undo .
      703     do
      704     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      705     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      706     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      707     :
      708       define variable v-tth             as handle    no-undo .
      709       define variable v-value-character as character no-undo .
      710       define variable v-value-date      as date      no-undo .
      711       define variable v-value-decimal   as decimal   no-undo .
      712       define variable v-value-integer   as integer   no-undo .
      713       define variable v-value-logical   as logical   no-undo .
      714       define variable v-param-type      as character no-undo .
      715       define variable v-email       as character no-undo .
      716       define variable v-tmp-str     as character no-undo .
      717       define variable v-tmp1-str    as character no-undo .
      718       define variable v-ind         as integer   no-undo .
      719       define variable v-num-entries as integer   no-undo .
      720       delete object v-tth no-error.
      721       run adm/shattri.p
      722         ( input "get":U
      723          ,input  "":U
      724          ,input  0
      725          ,input  'auto-task':U
      726          ,input  'send-msg-to-email':U
      727          ,output v-value-character
      728          ,output v-value-date
      729          ,output v-value-decimal
      730          ,output v-value-integer
      731          ,output v-value-logical
      732          ,output v-param-type
      733          ,input-output table-handle v-tth
      734         ) no-error .
      735       if not error-status :error  then do:
      736         assign
      737           v-tmp-str = v-value-character
      738         .
      739       end.
      740       delete object v-tth no-error.
      741       assign
      742         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      743         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      744         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      745         v-num-entries = num-entries( v-tmp-str, chr(44) )
      746         v-email       = "":U
      747       .
      748       do v-ind = 1 to v-num-entries
      749       :
      750         assign
      751           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      752         .
      753         if trim( v-tmp1-str ) <> "":U then do:
      754           if v-email = "":U then do:
      755             assign
      756               v-email = v-tmp1-str
      757             .
      758           end.
      759           else do:
      760             assign
      761               v-email = v-email + chr(44) + v-tmp1-str
      762             .
      763           end.
      764         end.
      765       end.
      766       if v-email <> "":U then do:
      767         run gbl/sendmail.p
      768           ( input v-email
      769           , input p-subject
      770           , input p-text-err
      771           , input p-attach-files
      772           ) no-error .
      773         if error-status :error
      774           or return-value <> "":U
      775         then do:
      776           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      777         end.
      778       end.
      779     end.
      780   end procedure.
      781   define variable CheckUpd      as class ibs.th.adm.upd.CheckUpd no-undo.
      782   procedure write-log:
      783      define input  parameter iTabPosition as integer   no-undo.
      784      define input parameter i-message    as character no-undo.
      785      run write-to-log in this-procedure( i-message).
      786   end.
      787   procedure write-log-and-file:
      788      define input parameter iTabPosition  as integer   no-undo.
      789      define input parameter iFile         as character no-undo.
      790      define input parameter ilog-level    as integer   no-undo.
      791      define input parameter i-message     as character no-undo.
      792      run write-to-log in this-procedure( i-message).
      793   end.
      794   procedure writelog :
      795      define input parameter p-file-name AS CHAR     NO-UNDO.
      796      define input parameter p-log-level AS INTEGER  NO-UNDO.
      797      define input parameter p-log-string  AS CHAR     NO-UNDO.
      798      run write-to-log in this-procedure( p-log-string).
      799   end procedure.
      800   define variable p0-pathrc as character no-undo .
      801   define variable v-pathrc         as character no-undo .
      802   define variable v-filename         as character no-undo .
      803   define variable v-fullfilename     as character no-undo .
      804   define variable v-rc-filename     as character no-undo .
      805   define variable v-filetype         as character no-undo .
      806   define variable v-copy-err         as logical no-undo .
      807   define variable v-delfile as char no-undo.
      808   define variable v-date   as date no-undo .
      809   define variable v-type   as character no-undo .
      810   define variable v-txt   as char no-undo .
      811   define variable v-arc   as char no-undo .
      812   define variable oldg#news as logical no-undo .
      813   define variable oldg#esys as logical no-undo .
      814   define stream flstream.
      815   define temp-table upgfile-tbl no-undo
      816     field nameupgfile  as char
      817     field fullnameupgfile  as char
      818     field dateupg as date
      819     field type as character
      820     index dupg is unique primary dateupg
      821   .
      822   define variable v-version           as character no-undo .
      823   define variable v-locale            as character no-undo .
      824   define variable v-SVNRev            as integer   no-undo .
      825   define variable v-compilerVersion   as character no-undo .
      826   define variable v-compile-date      as date      no-undo .
      827   define variable v-time              as integer   no-undo .
      828   define variable v-comment           as character no-undo .
      829   define variable v-file-date         as date      no-undo .
      830   define variable v-file-time         as integer   no-undo .
      831   define variable v-releace           as integer   no-undo.
      832   define variable v-patch             as integer   no-undo.
      833   define variable v-branch            as integer   no-undo.
      834   define variable mFileLog            as character no-undo.
      835   define variable mDirLog             as character no-undo.
      836   define variable mIsError            as logical   no-undo.
      837   define variable v-program-tag     as character no-undo .
      838   define new shared variable oxml-exch-dir as character no-undo .
      839   define new shared variable oxml-heap-dir as character no-undo .
      840   define new global shared variable g#library  as handle no-undo .
      841   define new global shared variable g#library2 as handle no-undo .
      842   define   shared variable g#auto as logical no-undo.
      843   define   shared variable g#news as logical no-undo.
      844   define   shared variable g#oxml as logical no-undo.
      845   define   shared variable g#esys as logical no-undo.
      846   define   shared variable g#news-source-db as integer no-undo.
      847   define   shared variable g#esys-source-esys as integer no-undo.
      848   define   shared variable g#db-num as integer   no-undo .
      849   define   shared variable g#userid as character no-undo .
      850   define   shared variable g#passwd as character no-undo .
      851   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   PROCEDURE get-db-num :
      853     define output parameter p-db-num as integer no-undo .
      854     do
      855     on error undo, return error return-value
      856     :
      857         run gbl/getdbnum.p (output p-db-num).
      858     end.
      859   END PROCEDURE.
      860   define variable v-cntxa-report-num as integer no-undo .
