      873         .
      874       end.
      875     end.
      876   END PROCEDURE.
      877   PROCEDURE get-userid :
      878   do
      879   on error undo, return error
      880   :
      881   define output parameter p-userid  as character    no-undo.
      882       assign
      883           p-userid = g#userid
      884       .
      885   end.
      886   END PROCEDURE.
      887   PROCEDURE get-version-num :
      888   define output parameter p-curr-version as character no-undo .
