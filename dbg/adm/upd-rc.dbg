      896   END PROCEDURE.
      897   procedure get-news :
      898   define output parameter p-news as logical no-undo .
      899     do
      900     on error undo, return error
      901     :
      902        p-news = g#news.
      903     end.
      904   end procedure.
      905   procedure get-esys :
      906   define output parameter p-esys as logical no-undo .
