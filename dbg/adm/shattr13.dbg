     1484   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1485   define new shared temp-table gds-list no-undo like ub.goods
     1486     field qnty   as decimal
     1487     field to-del as logical
     1488     field order-num as integer
     1489     field to-sel as logical
     1490     field promo-code as character
     1491     field ActionId  as int64
     1492     field db-num as integer
     1493     index art  is primary unique artic prod-type prod-code
     1494     index code is         unique gds-code
     1495     index oi order-num
     1496     index isel to-sel
     1497     .
     1498   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   define  new shared  temp-table gds-list-hist no-undo
     1500   field list-table as character
     1501   field id as integer
     1502   field line as integer
     1503   field hist-mode as character
     1504   field des as character
     1505   field num-recs as integer
     1506   field option_ as character
     1507   field item_ as character
     1508   field status_ as character
     1509   field num-add as integer
     1510   field num-ignored as integer
     1511   field done as logical
     1512   field err_ as logical
     1513   field err-mes as character
     1514   index pi is primary
     1515   id
     1516   line
     1517   index isdone
     1518   done
     1519   .
     1520   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
     1521   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
     1522   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
     1523   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
     1524   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
     1525   DEFINE VARIABLE specgrp-option AS INTEGER NO-UNDO.
     1526   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1527   define variable v-tth as handle no-undo .
     1528   assign
     1529   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1530   DEFINE MENU MENU-B-add-2
     1531          MENU-ITEM m_50           LABEL "Услуги"
     1532          MENU-ITEM m_24           LABEL "Перечисление в систему лояльности".
     1533   DEFINE BUTTON B-add  NO-FOCUS
     1534        LABEL "&Добавить"
     1535        SIZE 10 BY 1.
     1536   DEFINE BUTTON B-add-2  NO-FOCUS
     1537        LABEL "&Добавить"
     1538        SIZE 10 BY 1.
     1539   DEFINE BUTTON b-curr
     1540        IMAGE-UP FILE "btn-down-arrow":U
     1541        IMAGE-DOWN FILE "btn-down-arrow":U
     1542        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1543        LABEL "":L
     1544        SIZE 3 BY 1
     1545        BGCOLOR 8 FGCOLOR 0 .
     1546   DEFINE BUTTON B-del
     1547        LABEL "&Удалить"
     1548        SIZE 10 BY 1.
     1549   DEFINE BUTTON B-del-2
     1550        LABEL "&Удалить"
     1551        SIZE 10 BY 1.
     1552   DEFINE BUTTON B-exit AUTO-GO
     1553        LABEL "&Ввод"
     1554        SIZE 10 BY 1
     1555        BGCOLOR 8 .
     1556   DEFINE BUTTON B-Help
     1557        LABEL "Помо&щь"
     1558        SIZE 10 BY 1
     1559        BGCOLOR 8 .
     1560   DEFINE BUTTON b-quit AUTO-END-KEY
     1561        LABEL "&Отмена"
     1562        SIZE 10 BY 1
     1563        BGCOLOR 8 .
     1564   DEFINE VARIABLE f-ibm-ccm AS INTEGER FORMAT ">>9":U INITIAL 0
     1565        LABEL "Код платежа при оплате НАЛИЧНЫМИ CCM"
     1566        VIEW-AS FILL-IN
     1567        SIZE 7 BY 1 NO-UNDO.
     1568   DEFINE VARIABLE f-ibmnalc AS INTEGER FORMAT ">>9":U INITIAL 0
     1569        LABEL "Код валюты по умолчанию при оплате НАЛИЧНЫМИ (код платежа = 1)"
     1570        VIEW-AS FILL-IN
     1571        SIZE 7 BY 1 NO-UNDO.
     1572   DEFINE VARIABLE f-ibmrubc AS INTEGER FORMAT ">>9":U INITIAL 0
     1573        LABEL "Код национальной валюты (abbr_rub_allshift) НА КАССЕ"
     1574        VIEW-AS FILL-IN
     1575        SIZE 7 BY 1 NO-UNDO.
     1576   DEFINE VARIABLE for-curr-name AS CHARACTER FORMAT "X(256)":U
     1577         VIEW-AS TEXT
     1578        SIZE 6.8 BY .67
     1579        FGCOLOR 4  NO-UNDO.
     1580   DEFINE VARIABLE l-cd-vat AS CHARACTER FORMAT "X(256)":U INITIAL "Выделение ставок НДС в чеке:"
     1581         VIEW-AS TEXT
     1582        SIZE 29 BY .67 NO-UNDO.
     1583   DEFINE VARIABLE RS-cd-vat AS INTEGER
     1584        VIEW-AS RADIO-SET HORIZONTAL
     1585        RADIO-BUTTONS
     1586             "Не выделять", 0,
     1587   "Выделять", 1
     1588        SIZE 32 BY 1 NO-UNDO.
     1589   DEFINE VARIABLE t-ibmgroup AS LOGICAL INITIAL no
     1590        LABEL "прием чеков с продажами по группам"
     1591        VIEW-AS TOGGLE-BOX
     1592        SIZE 38.6 BY 1 NO-UNDO.
     1593   DEFINE VARIABLE T-multicurr AS LOGICAL INITIAL no
     1594        LABEL "Многовалютные НАЛИЧНЫЕ"
     1595        VIEW-AS TOGGLE-BOX
     1596        SIZE 24.6 BY 1 NO-UNDO.
     1597   DEFINE QUERY BR-specgrp FOR
     1598         tt-sum-grp SCROLLING.
     1599   DEFINE QUERY BR-tax-rate-code FOR
     1600         tt-tax-rate-code SCROLLING.
     1601   DEFINE BROWSE BR-specgrp
     1602     QUERY BR-specgrp NO-LOCK DISPLAY
     1603         tt-sum-grp.grp-code COLUMN-LABEL "Код группы" FORMAT "99":U
     1604         tt-sum-grp.grp-name COLUMN-LABEL "Описание" FORMAT "X(40)":U
     1605         code-2 COLUMN-LABEL "Код товара" FORMAT "999999999":U
     1606       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.6 BY 6
     1607            TITLE "Спецгруппы в справочнике суммовых групп" FIT-LAST-COLUMN.
     1608   DEFINE BROWSE BR-tax-rate-code
     1609     QUERY BR-tax-rate-code NO-LOCK DISPLAY
     1610         tt-tax-rate-code.rate-code COLUMN-LABEL "Код!ставки" FORMAT ">>9":U
     1611         bo-tax-code COLUMN-LABEL "Код налога" FORMAT ">9":U WIDTH 16.8
     1612         tt-tax-rate-code.rate-name COLUMN-LABEL "Название ставки" FORMAT "X(40)":U
     1613         tt-tax-rate-code.tax-code COLUMN-LABEL "Катег.налога!на кассе" FORMAT "9":U
     1614               WIDTH 13.5
     1615     ENABLE
     1616         tt-tax-rate-code.tax-code
     1617       WITH NO-ROW-MARKERS SEPARATORS SIZE 80.6 BY 7.29
     1618            TITLE "Соответствие ставок НДС категориям налога на кассе (кроме POS c ОС LINUX)" FIT-LAST-COLUMN.
     1619   DEFINE FRAME Dialog-Frame
     1620        B-add-2 AT ROW 15 COL 51
     1621        B-exit AT ROW 1 COL 1
     1622        b-quit AT ROW 1 COL 11
     1623        B-add AT ROW 6.52 COL 1
     1624        B-Help AT ROW 1 COL 55
     1625        f-ibmrubc AT ROW 2.29 COL 67.6 COLON-ALIGNED
     1626        f-ibmnalc AT ROW 3.52 COL 72.6 COLON-ALIGNED
     1627        b-curr AT ROW 3.52 COL 77.6
     1628        f-ibm-ccm AT ROW 4.52 COL 67.6 COLON-ALIGNED
     1629        RS-cd-vat AT ROW 5.52 COL 34.6 NO-LABEL
     1630        T-multicurr AT ROW 5.52 COL 69.6 WIDGET-ID 2
     1631        B-del AT ROW 6.52 COL 11
     1632        BR-tax-rate-code AT ROW 7.52 COL 1
     1633        t-ibmgroup AT ROW 14.81 COL 1
     1634        B-del-2 AT ROW 15 COL 61
     1635        BR-specgrp AT ROW 16 COL 1
     1636        for-curr-name AT ROW 3.67 COL 79.6 COLON-ALIGNED NO-LABEL
     1637        l-cd-vat AT ROW 5.76 COL 3.6 NO-LABEL
     1638        SPACE(66.69) SKIP(15.73)
     1639       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1640            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1641            TITLE "Параметры POS IBM-XML"
     1642            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1643   ASSIGN
     1644          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1645          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1646   ASSIGN
     1647          B-add-2:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add-2:HANDLE.
     1648   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1649   DO:
     1650     APPLY "END-ERROR":U TO SELF.
     1651   END.
     1652   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1653   DO:
     1654     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     1655     DEFINE VARIABLE v-log AS logical NO-UNDO.
     1656     DEFINE VARIABLE v-tax-rid AS RECID NO-UNDO.
     1657     DEFINE VARIABLE v-tax-rate-rid AS RECID NO-UNDO.
     1658     DEFINE BUFFER buf_tax FOR ub.tax.
     1659     DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
     1660     FIND FIRST buf_tax NO-LOCK WHERE
     1661               buf_tax.tax-code = INTEGER('1':U).
     1662     run ref/tax-tree.w (
     1663         input parparentproc
     1664         ,INPUT "b-seltax-rate"
     1665         ,INPUT "ALL-TAX-RATES"
     1666         ,INPUT 0
     1667         ,INPUT p-obj-type
     1668         ,INPUT p-obj-code
     1669         ,INPUT RECID(buf_tax)
     1670         ,INPUT-OUTPUT v-tax-rate-rid
     1671         ) NO-ERROR.
     1672   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1673   IF v-tax-rate-rid <> ? THEN DO:
     1674       FIND FIRST buf_tax-rate NO-LOCK WHERE
     1675             recid(buf_tax-rate) = v-tax-rate-rid.
     1676      FIND FIRST tt-tax-rate-code NO-LOCK WHERE
     1677                 tt-tax-rate-code.rate-code = buf_tax-rate.rate-code NO-ERROR.
     1678       IF AVAILABLE tt-tax-rate-code THEN DO:
     1679           MESSAGE
     1680           "Вы уже выбрали ставку налога с кодом ставки" tt-tax-rate-code.rate-code
     1681           VIEW-AS ALERT-BOX.
     1682           RETURN NO-APPLY.
     1683      END.
     1684      IF buf_tax-rate.STATUS_ = 'удал':U  THEN DO:
     1685           MESSAGE
     1686           "Нельзя выбрать ставку налога в статусе УДАЛЕН"
     1687           VIEW-AS ALERT-BOX.
     1688           RETURN NO-APPLY.
     1689      END.
     1690      CREATE tt-tax-rate-code.
     1691      BUFFER-COPY buf_tax-rate
     1692      except tax-code
     1693      TO tt-tax-rate-code
     1694      ASSIGN
     1695      tt-tax-rate-code.bo-tax-code = buf_tax-rate.tax-code
     1696      tt-tax-rate-code.tax-code = 0
     1697      v-tax-rate-rid = RECID(tt-tax-rate-code)
     1698      .
     1699      run openbr IN THIS-PROCEDURE.
     1700      REPOSITION br-tax-rate-code TO RECID v-tax-rate-rid.
     1701   END.
     1702   END.
     1703   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
     1704   DO:
     1705     IF specgrp-option = 0 THEN DO:
     1706       run gbl/pop-up.p ( INPUT self:handle, INPUT no) NO-ERROR.
     1707     END.
     1708     IF specgrp-option = 0  THEN RETURN NO-APPLY.
     1709     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1710     IF ERROR-STATUS:ERROR THEN do:
     1711         specgrp-option = 0.
     1712          RETURN NO-APPLY.
     1713     END.
     1714   END.
     1715   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
     1716   DO:
     1717       define variable rr as recid no-undo.
     1718       DEFINE BUFFER buf_currency FOR ub.currency.
     1719       rr = ? .
     1720       run ref/currency.w (
     1721                        input parparentproc
     1722                      , input "b-sel"
     1723                      , input-output rr ).
     1724       if rr <> ? then do:
     1725         FIND FIRST buf_currency WHERE
     1726                   recid( buf_currency ) = rr NO-LOCK .
     1727         DISPLAY
     1728         buf_currency.curr-code @ f-ibmnalc
     1729         buf_currency.curr-abbr @ for-curr-name
     1730         with frame Dialog-Frame .
     1731       end.
     1732   END.
     1733   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1734   DO:
     1735     IF NOT AVAILABLE tt-tax-rate-code THEN RETURN NO-APPLY.
     1736     DELETE tt-tax-rate-code.
     1737     run openbr IN THIS-PROCEDURE.
     1738     REPOSITION br-tax-rate-code TO ROW 1.
     1739   END.
     1740   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
     1741   DO:
     1742     IF NOT AVAILABLE tt-sum-grp THEN RETURN NO-APPLY.
     1743     DELETE tt-sum-grp.
     1744     OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     1745     REPOSITION br-specgrp TO ROW 1.
     1746   END.
     1747   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1748   DO:
     1749     run proc-save IN THIS-PROCEDURE NO-ERROR.
     1750     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1751   END.
     1752   ON LEAVE OF f-ibmnalc IN FRAME Dialog-Frame
     1753   DO:
     1754       DEFINE BUFFER buf_currency FOR ub.currency.
     1755       FIND FIRST buf_currency NO-LOCK WHERE
     1756               buf_currency.curr-code = INPUT FRAME Dialog-Frame f-ibmnalc NO-ERROR.
     1757     IF AVAIL buf_currency THEN DO:
     1758       DISPLAY
     1759       buf_currency.curr-abbr @ for-curr-name
     1760       WITH FRAME Dialog-Frame.
     1761     END.
     1762   END.
     1763   ON CHOOSE OF MENU-ITEM m_24
     1764   DO:
     1765     ASSIGN
     1766     specgrp-option = 24.
     1767     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1768     IF ERROR-STATUS:ERROR THEN DO:
     1769         specgrp-option = 0.
     1770         RETURN NO-APPLY.
     1771     END.
     1772   END.
     1773   ON CHOOSE OF MENU-ITEM m_50
     1774   DO:
     1775     ASSIGN
     1776     specgrp-option = 50.
     1777     RUN proc-b-add-2 IN THIS-PROCEDURE ( INPUT specgrp-option) NO-ERROR.
     1778     IF ERROR-STATUS:ERROR THEN DO:
     1779         specgrp-option = 0.
     1780         RETURN NO-APPLY.
     1781     END.
     1782   END.
     1783   ON VALUE-CHANGED OF RS-cd-vat IN FRAME Dialog-Frame
     1784   DO:
     1785     ASSIGN
     1786     rs-cd-vat.
     1787     CASE rs-cd-vat:
     1788         WHEN 0 THEN DO:
     1789           for each tt-tax-rate-code:
     1790             delete tt-tax-rate-code.
     1791           end.
     1792           ASSIGN
     1793           tt-tax-rate-code.tax-code:read-only IN browse br-tax-rate-code  = yes .
     1794           DISABLE
     1795           b-add
     1796           b-del WITH FRAME Dialog-Frame.
     1797         END.
     1798         WHEN 1 THEN DO:
     1799             IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1800                 ASSIGN
     1801                 tt-tax-rate-code.tax-code:read-only IN browse br-tax-rate-code  = no .
     1802                 ENABLE
     1803                 b-add
     1804                 b-del WITH FRAME Dialog-Frame.
     1805           END.
     1806       END.
     1807     END CASE.
     1808     run openbr in this-procedure .
     1809   END.
     1810   ON VALUE-CHANGED OF t-ibmgroup IN FRAME Dialog-Frame
     1811   DO:
     1812    ASSIGN
     1813    t-ibmgroup.
     1814     CASE t-ibmgroup:
     1815       WHEN YES  THEN DO:
     1816         if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1817            ENABLE
     1818            b-add-2
     1819            b-del-2
     1820            WITH FRAME Dialog-Frame.
     1821         end.
     1822       END.
     1823       WHEN NO THEN DO:
     1824         FOR EACH tt-sum-grp:
     1825             DELETE tt-sum-grp.
     1826         END.
     1827         DISABLE
     1828         b-add-2
     1829         b-del-2
     1830         WITH FRAME Dialog-Frame.
     1831         OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     1832       END.
     1833     END CASE.
     1834   END.
     1835   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1836   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1837   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1838   on help of frame Dialog-Frame
     1839   do:
     1840     run gbl/app_help.p
     1841       (input this-procedure :file-name
     1842       ,input ''
     1843       ,input ?
     1844       ) no-error.
     1845     if error-status :error then do:
     1846       message
     1847         "Ошибка при вызове помощи"
     1848         error-status :get-message(1)
     1849         view-as alert-box .
     1850     end.
     1851   end.
     1852   run minbtn-set in this-procedure .
     1853   on choose of b-help in frame Dialog-Frame
     1854   do:
     1855     apply "help":u to frame Dialog-Frame .
     1856   end.
     1857   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1858   procedure minbtn-set :
     1859       do
     1860           on error undo, return error return-value
     1861           :
     1862           define variable ii              as integer       no-undo .
     1863           define variable fh              as widget-handle no-undo .
     1864           define variable hh              as widget-handle no-undo .
     1865           define variable v-h             as handle        extent 4 no-undo .
     1866           define variable v-name-button   as character     no-undo .
     1867           define variable v-help-old-x    as decimal       no-undo .
     1868           define variable v-help-old-y    as decimal       no-undo .
     1869           define variable v-help-old-size as decimal       no-undo .
     1870           define variable v-frame-width   as decimal       no-undo .
     1871           define variable jj              as integer       no-undo .
     1872           do
     1873               on error undo, return error
     1874               :
     1875               assign
     1876                   v-frame-width = frame Dialog-Frame:width - 0.3
     1877                   fh            = frame Dialog-Frame:first-child
     1878                   hh            = fh:first-child
     1879                   ii            = 1
     1880                   .
     1881               do while valid-handle(hh):
     1882                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1883                   do:
     1884                       case lc(hh:name) :
     1885                           when "b-help" then
     1886                               do:
     1887                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1888                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1889                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1890                                   hh:TOOLTIP = "Помощь" .
     1891                                   v-help-old-x = hh:column .
     1892                                   v-help-old-y = hh:row    .
     1893                                   v-help-old-size = hh:width .
     1894                                   hh:width-chars = 2.5 .
     1895                               end.
     1896                           when "b-print" then
     1897                               do:
     1898                                   hh:load-image("cmp/b-print.bmp":u) .
     1899                                   hh:TOOLTIP = "Печать" .
     1900                                   v-h[ii] = hh:handle .
     1901                                   ii = ii + 1 .
     1902                                   hh:width-chars = 3 .
     1903                               end.
     1904                           when "b-history" or
     1905                           when "b-hist" then
     1906                               do:
     1907                                   hh:load-image("cmp/b-hist.bmp":u) .
     1908                                   hh:TOOLTIP = "История" .
     1909                                   v-h[ii] = hh:handle .
     1910                                   ii = ii + 1 .
     1911                                   hh:width-chars = 3 .
     1912                               end.
     1913                           when "b-sch" then
     1914                               do:
     1915                                   hh:load-image("cmp/b-sch.bmp":u) .
     1916                                   hh:TOOLTIP = "Установка Фильтра" .
     1917                                   v-h[ii] = hh:handle .
     1918                                   ii = ii + 1 .
     1919                                   hh:width-chars = 3 .
     1920                               end.
     1921                           when "b-hist-user" then
     1922                               do:
     1923                                   hh:load-image("cmp/b-hist.bmp":u) .
     1924                                   hh:TOOLTIP = "История пользователя" .
     1925                                   ii = ii + 1 .
     1926                               end.
     1927                       end case.
     1928                   end.
     1929                   hh = hh:next-sibling.
     1930               end.
     1931               b-help:column = v-frame-width - b-help:width-chars.
     1932               jj = 0.
     1933               repeat ii = 4 to 1 by -1 :
     1934                   if valid-handle (v-h[ii] ) then
     1935                   do:
     1936                       jj  = jj + 1 .
     1937                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1938                       v-h[ii]:row    = v-help-old-y .
     1939                   end.
     1940               end.
     1941           end.
     1942       end.
     1943   end procedure.
     1944   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1945   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1946   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1947   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1948   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1949   define variable v-diasize-current-frame-height as decimal   no-undo .
     1950   define variable v-diasize-change-size          as logical   no-undo .
     1951   define variable v-diasize-resize-button        as handle    no-undo .
     1952   define variable v-diasize-wndmax               as logical   no-undo .
     1953   define variable v-diasize-wndstore             as logical   no-undo .
     1954   define variable v-diasize-proc-name            as character no-undo .
     1955   define variable v-diasize-browse-handle        as handle    no-undo .
     1956   define variable v-diasize-browse-number        as integer   no-undo .
     1957   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1958   define temp-table temp-diasize-handle no-undo
     1959     field handle-value  as handle
     1960     field save-position as decimal
     1961     index xpk is primary unique handle-value
     1962     .
     1963   define temp-table temp-browse-handle no-undo
     1964     field browse-type   as character
     1965     field browse-number as integer
     1966     field browse-handle as handle
     1967     field original-size as decimal
     1968     index xpk is primary unique browse-type browse-number
     1969     index xie browse-type browse-handle
     1970   .
     1971   procedure diasize_change-height :
     1972     define input  parameter p-change-value  as decimal   no-undo .
     1973     define input  parameter p-move-resize   as logical   no-undo .
     1974     define variable v-field-group-handle    as handle    no-undo .
     1975     define variable v-object-handle         as handle    no-undo .
     1976     define variable v-frame-height          as decimal   no-undo .
     1977     define variable v-frame-virtual-height  as decimal   no-undo .
     1978     define variable v-browse-height         as decimal   no-undo .
     1979     define variable v-window-height         as decimal   no-undo .
     1980     define variable v-window-virtual-height as decimal   no-undo .
     1981     define variable v-change-sign           as integer   no-undo .
     1982     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1983     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1984     if p-change-value > 0
     1985     then do:
     1986       if frame Dialog-Frame :height + p-change-value
     1987           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1988       then do:
     1989         assign
     1990           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1991                           - (frame Dialog-Frame :height-chars)
     1992         .
     1993         if p-change-value <= 0
     1994         then do:
     1995           run diasize_position-resize-button in this-procedure .
     1996           return .
     1997         end.
     1998       end.
     1999     end.
     2000     if p-change-value < 0
     2001     then do:
     2002       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2003       then do:
     2004         assign
     2005           p-change-value = v-diasize-orig-frame-height
     2006                          - (frame Dialog-Frame :height-chars)
     2007         .
     2008         if p-change-value >= 0
     2009         then do:
     2010           run diasize_position-resize-button in this-procedure .
     2011           return .
     2012         end.
     2013       end.
     2014     end.
     2015     if p-change-value >= 0
     2016     then do:
     2017       assign
     2018         v-change-sign = 1
     2019       .
     2020     end.
     2021     else do:
     2022       assign
     2023         v-change-sign = -1
     2024       .
     2025     end.
     2026     assign
     2027       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2028     .
     2029     if p-change-value = 0
     2030     then do:
     2031       run diasize_position-resize-button in this-procedure .
     2032       return .
     2033     end.
     2034     move_block:
     2035     do
     2036     on error undo move_block, retry move_block
     2037     :
     2038       if retry
     2039       then do:
     2040         do
     2041         on error undo move_block, leave move_block
     2042         :
     2043           if p-change-value > 0
     2044           then do:
     2045             for each buf_temp-diasize-handle
     2046             on error undo, next
     2047             :
     2048               assign
     2049                 v-object-handle = buf_temp-diasize-handle.handle-value
     2050               .
     2051               if v-object-handle <> v-diasize-resize-button
     2052               then do:
     2053                 assign
     2054                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2055                 .
     2056               end.
     2057             end.
     2058             assign
     2059               v-diasize-browse-handle :height = v-browse-height
     2060             .
     2061             for each buf_temp-browse-handle
     2062               where buf_temp-browse-handle.browse-type = 'height':u
     2063             on error undo, next
     2064             :
     2065               assign
     2066                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2067               .
     2068             end.
     2069             assign
     2070               frame Dialog-Frame :height = v-frame-height
     2071             .
     2072             if frame Dialog-Frame :scrollable = true
     2073             then do:
     2074               assign
     2075                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2076               .
     2077             end.
     2078             run diasize_position-resize-button in this-procedure .
     2079           end.
     2080           else do:
     2081             if frame Dialog-Frame :scrollable = true
     2082             then do:
     2083               assign
     2084                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2085               .
     2086             end.
     2087             assign
     2088               frame Dialog-Frame :height = v-frame-height
     2089             .
     2090             assign
     2091               v-diasize-browse-handle :height = v-browse-height
     2092             .
     2093             for each buf_temp-browse-handle
     2094               where buf_temp-browse-handle.browse-type = 'height':u
     2095             on error undo, next
     2096             :
     2097               assign
     2098                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2099               .
     2100             end.
     2101             for each buf_temp-diasize-handle
     2102             on error undo, next
     2103             :
     2104               assign
     2105                 v-object-handle = buf_temp-diasize-handle.handle-value
     2106               .
     2107               if v-object-handle <> v-diasize-resize-button
     2108               then do:
     2109                 assign
     2110                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2111                 .
     2112               end.
     2113             end.
     2114             run diasize_position-resize-button in this-procedure .
     2115           end.
     2116           assign
     2117             v-diasize-change-size = false
     2118           .
     2119           leave move_block .
     2120         end.
     2121       end.
     2122       assign
     2123         v-diasize-need-full-display = true
     2124       .
     2125       if v-diasize-change-size = false
     2126       then do:
     2127         assign
     2128           v-diasize-change-size = true
     2129         .
     2130       end.
     2131       else do:
     2132         return .
     2133       end.
     2134       assign
     2135         v-frame-height = frame Dialog-Frame :height
     2136         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2137         v-browse-height = v-diasize-browse-handle :height
     2138       .
     2139       for each buf_temp-browse-handle
     2140         where buf_temp-browse-handle.browse-type = 'height':u
     2141       :
     2142         assign
     2143           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2144         .
     2145       end.
     2146       for each buf_temp-diasize-handle
     2147       :
     2148         delete buf_temp-diasize-handle .
     2149       end.
     2150       assign
     2151         v-field-group-handle = frame Dialog-Frame :first-child
     2152       .
     2153       do while valid-handle(v-field-group-handle)
     2154       :
     2155         assign
     2156           v-object-handle = v-field-group-handle :first-child
     2157         .
     2158         do while valid-handle(v-object-handle)
     2159         :
     2160           if  v-object-handle <> v-diasize-browse-handle :handle
     2161           and can-query(v-object-handle, "row")
     2162           and can-query(v-object-handle, "height")
     2163           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2164           then do:
     2165             find first buf_temp-browse-handle
     2166               where buf_temp-browse-handle.browse-type   = 'height':u
     2167                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2168               no-error .
     2169             if available buf_temp-browse-handle
     2170             then do:
     2171             end.
     2172             else do:
     2173               create buf_temp-diasize-handle .
     2174               assign
     2175                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2176                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2177               .
     2178             end.
     2179           end.
     2180           assign
     2181             v-object-handle = v-object-handle :next-sibling
     2182           .
     2183         end.
     2184         assign
     2185           v-field-group-handle = v-field-group-handle :next-sibling
     2186         .
     2187       end.
     2188       do with frame Dialog-Frame
     2189       :
     2190         hide v-diasize-resize-button .
     2191         assign
     2192           v-diasize-resize-button :row    = 1
     2193           v-diasize-resize-button :column = 1
     2194         .
     2195       end.
     2196       if p-change-value > 0
     2197       then do:
     2198         if frame Dialog-Frame :scrollable = true
     2199         then do:
     2200           assign
     2201             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2202             no-error .
     2203           if error-status :error
     2204           or error-status :get-message(1) <> ""
     2205           then do:
     2206             undo move_block, retry move_block .
     2207           end.
     2208         end.
     2209         assign
     2210           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2211           no-error .
     2212         if error-status :error
     2213         or error-status :get-message(1) <> ""
     2214         then do:
     2215           undo move_block, retry move_block .
     2216         end.
     2217         assign
     2218           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2219           no-error .
     2220         if error-status :error
     2221         or error-status :get-message(1) <> ""
     2222         then do:
     2223           undo move_block, retry move_block .
     2224         end.
     2225         for each buf_temp-browse-handle
     2226           where buf_temp-browse-handle.browse-type = 'height':u
     2227         on error undo move_block, retry move_block
     2228         :
     2229           assign
     2230             buf_temp-browse-handle.browse-handle :height
     2231               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2232             no-error .
     2233           if error-status :error
     2234           or error-status :get-message(1) <> ""
     2235           then do:
     2236             undo move_block, retry move_block .
     2237           end.
     2238         end.
     2239         for each buf_temp-diasize-handle
     2240         on error undo move_block, retry move_block
     2241         :
     2242           assign
     2243             v-object-handle = buf_temp-diasize-handle.handle-value
     2244           .
     2245           if v-object-handle <> v-diasize-resize-button
     2246           then do:
     2247             assign
     2248               v-object-handle :row = v-object-handle :row + p-change-value
     2249               no-error .
     2250             if error-status :error
     2251             or error-status :get-message(1) <> ""
     2252             then do:
     2253               undo move_block, retry move_block .
     2254             end.
     2255           end.
     2256         end.
     2257       end.
     2258       else do:
     2259         for each buf_temp-diasize-handle
     2260         on error undo move_block, retry move_block
     2261         :
     2262           assign
     2263             v-object-handle = buf_temp-diasize-handle.handle-value
     2264           .
     2265           if v-object-handle <> v-diasize-resize-button
     2266           then do:
     2267             assign
     2268               v-object-handle :row = v-object-handle :row + p-change-value
     2269               no-error .
     2270             if error-status :error
     2271             or error-status :get-message(1) <> ""
     2272             then do:
     2273               undo move_block, retry move_block .
     2274             end.
     2275           end.
     2276         end.
     2277         assign
     2278           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2279           no-error .
     2280         if error-status :error
     2281         or error-status :get-message(1) <> ""
     2282         then do:
     2283           undo move_block, retry move_block .
     2284         end.
     2285         for each buf_temp-browse-handle
     2286           where buf_temp-browse-handle.browse-type = 'height':u
     2287         on error undo move_block, retry move_block
     2288         :
     2289           assign
     2290             buf_temp-browse-handle.browse-handle :height
     2291               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2292             no-error .
     2293           if error-status :error
     2294           or error-status :get-message(1) <> ""
     2295           then do:
     2296             undo move_block, retry move_block .
     2297           end.
     2298         end.
     2299         assign
     2300           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2301           no-error .
     2302         if error-status :error
     2303         or error-status :get-message(1) <> ""
     2304         then do:
     2305           undo move_block, retry move_block .
     2306         end.
     2307         if frame Dialog-Frame :scrollable = true
     2308         then do:
     2309           assign
     2310             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2311             no-error .
     2312           if error-status :error
     2313           or error-status :get-message(1) <> ""
     2314           then do:
     2315             undo move_block, retry move_block .
     2316           end.
     2317         end.
     2318       end.
     2319       if p-move-resize = true
     2320       then do:
     2321         run diasize_position-resize-button in this-procedure .
     2322       end.
     2323       if v-diasize-wndstore = true
     2324       then do:
     2325         if connected("ub") = true
     2326         then do:
     2327           define variable v-cntxt-db-num        as integer   no-undo .
     2328           define variable v-cntxt-userid        as character no-undo .
     2329           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2330                                             , OUTPUT v-cntxt-userid
     2331                                             ) .
     2332           run gbl/wndsizew.p
     2333             (input  v-cntxt-db-num
     2334             ,input  v-cntxt-userid
     2335             ,input  v-diasize-proc-name
     2336             ,input  'height':u
     2337             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2338             ) .
     2339         end.
     2340       end.
     2341     end.
     2342     assign
     2343       v-diasize-change-size = false
     2344     .
     2345   end procedure.
     2346   procedure diasize_set-height :
     2347     define input  parameter p-new-height  as decimal   no-undo .
     2348     define input  parameter p-move-resize as logical   no-undo .
     2349     do
     2350     on error undo, return error return-value
     2351     :
     2352       run diasize_change-height in this-procedure
     2353         (input  (p-new-height - frame Dialog-Frame :height)
     2354         ,input  p-move-resize
     2355         ) .
     2356     end.
     2357   end procedure.
     2358   procedure diasize_change-width :
     2359     define input  parameter p-change-value as decimal   no-undo .
     2360     define input  parameter p-move-resize  as logical   no-undo .
     2361     define variable v-field-group-handle   as handle    no-undo .
     2362     define variable v-object-handle        as handle    no-undo .
     2363     define variable v-frame-width          as decimal   no-undo .
     2364     define variable v-frame-virtual-width  as decimal   no-undo .
     2365     define variable v-browse-width         as decimal   no-undo .
     2366     define variable v-window-width         as decimal   no-undo .
     2367     define variable v-window-virtual-width as decimal   no-undo .
     2368     define variable v-change-sign          as integer   no-undo .
     2369     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2370     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2371     if p-change-value > 0
     2372     then do:
     2373       if frame Dialog-Frame :width + p-change-value >
     2374           session :width-chars
     2375       then do:
     2376         assign
     2377           p-change-value = session :width-chars - frame Dialog-Frame :width
     2378         .
     2379         if p-change-value <= 0
     2380         then do:
     2381           run diasize_position-resize-button in this-procedure .
     2382           return .
     2383         end.
     2384       end.
     2385     end.
     2386     if p-change-value < 0
     2387     then do:
     2388       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2389       then do:
     2390         assign
     2391           p-change-value = v-diasize-orig-frame-width
     2392                          - frame Dialog-Frame :width
     2393         .
     2394         if p-change-value >= 0
     2395         then do:
     2396           run diasize_position-resize-button in this-procedure .
     2397           return .
     2398         end.
     2399       end.
     2400     end.
     2401     if p-change-value >= 0
     2402     then do:
     2403       assign
     2404         v-change-sign = 1
     2405       .
     2406     end.
     2407     else do:
     2408       assign
     2409         v-change-sign = -1
     2410       .
     2411     end.
     2412     assign
     2413       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2414     .
     2415     if p-change-value = 0
     2416     then do:
     2417       run diasize_position-resize-button in this-procedure .
     2418       return .
     2419     end.
     2420     move_block:
     2421     do
     2422     on error undo move_block, leave move_block
     2423     :
     2424       if retry
     2425       then do:
     2426         do
     2427         on error undo move_block, leave move_block
     2428         :
     2429           if p-change-value > 0
     2430           then do:
     2431             for each buf_temp-diasize-handle
     2432             on error undo, next
     2433             :
     2434               assign
     2435                 v-object-handle = buf_temp-diasize-handle.handle-value
     2436               .
     2437               if v-object-handle <> v-diasize-resize-button
     2438               then do:
     2439                 assign
     2440                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2441                 .
     2442               end.
     2443             end.
     2444             assign
     2445               v-diasize-browse-handle :width = v-browse-width
     2446             .
     2447             for each buf_temp-browse-handle
     2448               where buf_temp-browse-handle.browse-type = 'width':u
     2449             on error undo, next
     2450             :
     2451               assign
     2452                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2453               .
     2454             end.
     2455             assign
     2456               frame Dialog-Frame :width = v-frame-width
     2457             .
     2458             if frame Dialog-Frame :scrollable = true
     2459             then do:
     2460               assign
     2461                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2462               .
     2463             end.
     2464             run diasize_position-resize-button in this-procedure .
     2465           end.
     2466           else do:
     2467             if frame Dialog-Frame :scrollable = true
     2468             then do:
     2469               assign
     2470                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2471               .
     2472             end.
     2473             assign
     2474               frame Dialog-Frame :width = v-frame-width
     2475             .
     2476             for each buf_temp-browse-handle
     2477               where buf_temp-browse-handle.browse-type = 'width':u
     2478             on error undo, next
     2479             :
     2480               assign
     2481                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2482               .
     2483             end.
     2484             assign
     2485               v-diasize-browse-handle :width = v-browse-width
     2486             .
     2487             for each buf_temp-diasize-handle
     2488             on error undo, next
     2489             :
     2490               assign
     2491                 v-object-handle = buf_temp-diasize-handle.handle-value
     2492               .
     2493               if v-object-handle <> v-diasize-resize-button
     2494               then do:
     2495                 assign
     2496                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2497                 .
     2498               end.
     2499             end.
     2500             run diasize_position-resize-button in this-procedure .
     2501           end.
     2502           assign
     2503             v-diasize-change-size = false
     2504           .
     2505           leave move_block .
     2506         end.
     2507       end.
     2508       assign
     2509         v-diasize-need-full-display = true
     2510       .
     2511       if v-diasize-change-size = false
     2512       then do:
     2513         assign
     2514           v-diasize-change-size = true
     2515         .
     2516       end.
     2517       else do:
     2518         return .
     2519       end.
     2520       assign
     2521         v-frame-width = frame Dialog-Frame :width
     2522         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2523         v-browse-width = v-diasize-browse-handle :width
     2524       .
     2525       for each buf_temp-browse-handle
     2526         where buf_temp-browse-handle.browse-type = 'width':u
     2527       :
     2528         assign
     2529           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2530         .
     2531       end.
     2532       for each buf_temp-diasize-handle
     2533       :
     2534         delete buf_temp-diasize-handle .
     2535       end.
     2536       assign
     2537         v-field-group-handle = frame Dialog-Frame :first-child
     2538       .
     2539       do while valid-handle(v-field-group-handle)
     2540       :
     2541         assign
     2542           v-object-handle = v-field-group-handle :first-child
     2543         .
     2544         do while valid-handle(v-object-handle)
     2545         :
     2546           if  v-object-handle <> v-diasize-browse-handle :handle
     2547           and v-object-handle <> v-diasize-resize-button
     2548           and can-query(v-object-handle, "row")
     2549           and can-query(v-object-handle, "height")
     2550           and ( v-object-handle :col + v-object-handle :width
     2551                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2552               )
     2553           then do:
     2554             find first buf_temp-browse-handle
     2555               where buf_temp-browse-handle.browse-type   = 'width':u
     2556                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2557               no-error .
     2558             if available buf_temp-browse-handle
     2559             then do:
     2560             end.
     2561             else do:
     2562               create buf_temp-diasize-handle .
     2563               assign
     2564                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2565                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2566               .
     2567             end.
     2568           end.
     2569           assign
     2570             v-object-handle = v-object-handle :next-sibling
     2571           .
     2572         end.
     2573         assign
     2574           v-field-group-handle = v-field-group-handle :next-sibling
     2575         .
     2576       end.
     2577       do with frame Dialog-Frame
     2578       :
     2579         hide v-diasize-resize-button .
     2580         v-diasize-resize-button :row = 1.
     2581         v-diasize-resize-button :column = 1.
     2582       end.
     2583       if p-change-value > 0
     2584       then do:
     2585         if frame Dialog-Frame :scrollable = true
     2586         then do:
     2587           assign
     2588             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2589             no-error .
     2590           if error-status :error
     2591           or error-status :get-message(1) <> ""
     2592           then do:
     2593             undo move_block, retry move_block.
     2594           end.
     2595         end.
     2596         assign
     2597           frame Dialog-Frame :width = v-frame-width + p-change-value
     2598           no-error .
     2599         if error-status :error
     2600         or error-status :get-message(1) <> ""
     2601         then do:
     2602           undo move_block, retry move_block.
     2603         end.
     2604         assign
     2605           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2606         no-error .
     2607         if error-status :error
     2608         or error-status :get-message(1) <> ""
     2609         then do:
     2610           undo move_block, retry move_block.
     2611         end.
     2612         for each buf_temp-browse-handle
     2613           where buf_temp-browse-handle.browse-type = 'width':u
     2614         on error undo move_block, retry move_block
     2615         :
     2616           assign
     2617             buf_temp-browse-handle.browse-handle :width
     2618               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2619             no-error .
     2620           if error-status :error
     2621           or error-status :get-message(1) <> ""
     2622           then do:
     2623             undo move_block, retry move_block .
     2624           end.
     2625         end.
     2626         for each buf_temp-diasize-handle
     2627         on error undo move_block, retry move_block
     2628         :
     2629           assign
     2630             v-object-handle = buf_temp-diasize-handle.handle-value
     2631           .
     2632           if v-object-handle <> v-diasize-resize-button
     2633           then do:
     2634             assign
     2635               v-object-handle :col = v-object-handle :col + p-change-value
     2636               no-error .
     2637             if error-status :error
     2638             or error-status :get-message(1) <> ""
     2639             then do:
     2640               undo move_block, retry move_block .
     2641             end.
     2642           end.
     2643         end.
     2644       end.
     2645       else do:
     2646         for each buf_temp-diasize-handle
     2647         on error undo move_block, retry move_block
     2648         :
     2649           assign
     2650             v-object-handle = buf_temp-diasize-handle.handle-value
     2651           .
     2652           if v-object-handle <> v-diasize-resize-button
     2653           then do:
     2654             assign
     2655               v-object-handle :col = v-object-handle :col + p-change-value
     2656               no-error .
     2657             if error-status :error
     2658             or error-status :get-message(1) <> ""
     2659             then do:
     2660               undo move_block, retry move_block .
     2661             end.
     2662           end.
     2663         end.
     2664         for each buf_temp-browse-handle
     2665           where buf_temp-browse-handle.browse-type = 'width':u
     2666         on error undo move_block, retry move_block
     2667         :
     2668           assign
     2669             buf_temp-browse-handle.browse-handle :width
     2670               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2671             no-error .
     2672           if error-status :error
     2673           or error-status :get-message(1) <> ""
     2674           then do:
     2675             undo move_block, retry move_block .
     2676           end.
     2677         end.
     2678         assign
     2679           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2680           no-error .
     2681         if error-status :error
     2682         or error-status :get-message(1) <> ""
     2683         then do:
     2684           undo move_block, retry move_block.
     2685         end.
     2686         assign
     2687           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2688         no-error .
     2689         if error-status :error
     2690         or error-status :get-message(1) <> ""
     2691         then do:
     2692           undo move_block, retry move_block.
     2693         end.
     2694         if frame Dialog-Frame :scrollable = true
     2695         then do:
     2696           assign
     2697             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2698           no-error .
     2699           if error-status :error
     2700           or error-status :get-message(1) <> ""
     2701           then do:
     2702             undo move_block, retry move_block.
     2703           end.
     2704         end.
     2705       end.
     2706       if p-move-resize
     2707       then do:
     2708         run diasize_position-resize-button in this-procedure .
     2709       end.
     2710       if v-diasize-wndstore = true
     2711       then do:
     2712         if connected("ub") = true
     2713         then do:
     2714           define variable v-cntxt-db-num        as integer   no-undo .
     2715           define variable v-cntxt-userid        as character no-undo .
     2716           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2717                                             , OUTPUT v-cntxt-userid
     2718                                             ) .
     2719           run gbl/wndsizew.p
     2720             (input  v-cntxt-db-num
     2721             ,input  v-cntxt-userid
     2722             ,input  v-diasize-proc-name
     2723             ,input  'width':u
     2724             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2725             ) .
     2726         end.
     2727       end.
     2728     end.
     2729     assign
     2730       v-diasize-change-size = false
     2731     .
     2732   end procedure.
     2733   procedure diasize_set-width :
     2734     define input  parameter p-new-width  as decimal   no-undo .
     2735     define input  parameter p-move-resize as logical   no-undo .
     2736     do
     2737     on error undo, return error return-value
     2738     :
     2739       run diasize_change-width in this-procedure
     2740         (input  (p-new-width - frame Dialog-Frame :width)
     2741         ,input  p-move-resize
     2742         ) .
     2743     end.
     2744   end procedure.
     2745   procedure diasize_position-resize-button :
     2746     do with frame Dialog-Frame
     2747     :
     2748       hide v-diasize-resize-button .
     2749       assign
     2750         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2751                     - 1
     2752                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2753         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2754                     - 1
     2755                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2756       .
     2757       view v-diasize-resize-button .
     2758     end.
     2759   end procedure.
     2760   on alt-right anywhere
     2761   do:
     2762     run diasize_change-width in this-procedure
     2763       (input 1
     2764       ,input true
     2765       ) .
     2766     return no-apply .
     2767   end.
     2768   on alt-left anywhere
     2769   do:
     2770     run diasize_change-width in this-procedure
     2771       (input -1
     2772       ,input true
     2773       ) .
     2774     return no-apply .
     2775   end.
     2776   on alt-down anywhere
     2777   do:
     2778     run diasize_change-height in this-procedure
     2779       (input 1
     2780       ,input true
     2781       ) .
     2782     return no-apply .
     2783   end.
     2784   on alt-up anywhere
     2785   do:
     2786     run diasize_change-height in this-procedure
     2787       (input -1
     2788       ,input true
     2789       ) .
     2790     return no-apply .
     2791   end.
     2792   on alt-enter of frame Dialog-Frame
     2793   do:
     2794     run diasize_maximize in this-procedure
     2795       (input  ?
     2796       ).
     2797     return no-apply .
     2798   end.
     2799   procedure diasize_end-move :
     2800     do
     2801     on error undo, return error return-value
     2802     :
     2803       define variable v-row-delta as decimal   no-undo .
     2804       define variable v-col-delta as decimal   no-undo .
     2805       define variable v-new-row as decimal   no-undo .
     2806       define variable v-new-col as decimal   no-undo .
     2807       assign
     2808         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2809         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2810       .
     2811       assign
     2812         v-row-delta = v-new-row - frame Dialog-Frame :height
     2813         v-col-delta = v-new-col - frame Dialog-Frame :width
     2814       .
     2815       run diasize_change-height in this-procedure
     2816         (input v-row-delta
     2817         ,input true
     2818         ) .
     2819       run diasize_change-width in this-procedure
     2820         (input v-col-delta
     2821         ,input true
     2822         ) .
     2823     end.
     2824   end procedure.
     2825   procedure diasize_maximize :
     2826     define input  parameter p-action as logical   no-undo .
     2827     do
     2828     on error undo, return error return-value
     2829     :
     2830       if p-action = ?
     2831       then do:
     2832         if v-diasize-need-maximize = true
     2833         then do:
     2834           assign
     2835             p-action = true
     2836           .
     2837         end.
     2838         else do:
     2839           assign
     2840             p-action = false
     2841           .
     2842         end.
     2843       end.
     2844       if p-action = true
     2845       then do:
     2846         run diasize_change-height in this-procedure
     2847           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2848               - frame Dialog-Frame :height-chars
     2849           ,input true
     2850           ) .
     2851         run diasize_change-width in this-procedure
     2852           (input session :width-chars
     2853               - frame Dialog-Frame :width-chars
     2854           ,input true
     2855           ) .
     2856         assign
     2857           v-diasize-need-maximize = false
     2858         .
     2859       end.
     2860       else do:
     2861         run diasize_change-width in this-procedure
     2862           (input v-diasize-orig-frame-width
     2863               - frame Dialog-Frame :width-chars
     2864           ,input true
     2865           ) .
     2866         run diasize_change-height in this-procedure
     2867           (input v-diasize-orig-frame-height
     2868               - frame Dialog-Frame :height-chars
     2869           ,input true
     2870           ) .
     2871         assign
     2872           v-diasize-need-maximize = true
     2873         .
     2874       end.
     2875     end.
     2876   end procedure.
     2877   procedure diasize_restore-orig-size :
     2878     do
     2879     on error undo, return error return-value
     2880     :
     2881       assign
     2882         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2883         v-diasize-current-frame-height = frame Dialog-Frame :height
     2884       .
     2885       run diasize_set-height in this-procedure
     2886         (input  v-diasize-orig-frame-height
     2887         ,input  true
     2888         ) .
     2889       run diasize_set-width in this-procedure
     2890         (input  v-diasize-orig-frame-width
     2891         ,input  true
     2892         ) .
     2893     end.
     2894   end procedure.
     2895   procedure diasize_restore-current-size :
     2896     do
     2897     on error undo, return error return-value
     2898     :
     2899       run diasize_set-height in this-procedure
     2900         (input  v-diasize-current-frame-height
     2901         ,input  true
     2902         ) .
     2903       run diasize_set-width in this-procedure
     2904         (input  v-diasize-current-frame-width
     2905         ,input  true
     2906         ) .
     2907     end.
     2908   end procedure.
     2909   procedure diasize_set-browse-handle :
     2910     define input  parameter p-browse-handle as handle   no-undo .
     2911     define buffer buf_temp-browse-handle for temp-browse-handle .
     2912     do
     2913     on error undo, return error return-value
     2914     :
     2915       assign
     2916         v-diasize-browse-handle = p-browse-handle
     2917       .
     2918       for each buf_temp-browse-handle
     2919       on error undo, return error return-value
     2920       :
     2921         delete buf_temp-browse-handle .
     2922       end.
     2923     end.
     2924   end procedure.
     2925   procedure diasize_add_browse :
     2926     define input  parameter p-browse-type   as character no-undo .
     2927     define input  parameter p-browse-handle as handle    no-undo .
     2928     define buffer buf_temp-browse-handle for temp-browse-handle .
     2929     do
     2930     on error undo, return error return-value
     2931     :
     2932       assign
     2933         v-diasize-browse-number = v-diasize-browse-number + 1
     2934       .
     2935       create buf_temp-browse-handle .
     2936       assign
     2937         buf_temp-browse-handle.browse-type   = p-browse-type
     2938         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2939         buf_temp-browse-handle.browse-handle = p-browse-handle
     2940       .
     2941     end.
     2942   end procedure.
     2943   procedure diasize_init :
     2944     define variable v-default-value    as logical   no-undo .
     2945     define variable v-restore-saved    as logical   no-undo .
     2946     define variable v-resize-value-str as character no-undo .
     2947     do
     2948     on error undo, return error return-value
     2949     :
     2950       do with frame Dialog-Frame
     2951       :
     2952         assign
     2953           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2954           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2955           v-diasize-browse-handle     = browse BR-specgrp :handle
     2956         .
     2957         create button v-diasize-resize-button
     2958         assign
     2959           parent        = frame Dialog-Frame :first-child
     2960           label         = "s"
     2961           height-pixels = 16
     2962           width-pixels  = 16
     2963           visible       = true
     2964           sensitive     = true
     2965           movable       = true
     2966           triggers:
     2967             on end-move persistent run diasize_end-move in this-procedure .
     2968           end triggers.
     2969         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2970         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2971         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2972         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2973         assign
     2974           v-diasize-wndmax = false
     2975         .
     2976         if connected("ub") = true
     2977         then do:
     2978           define variable v-cntxt-db-num        as integer   no-undo .
     2979           define variable v-cntxt-userid        as character no-undo .
     2980           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2981                                             , OUTPUT v-cntxt-userid
     2982                                             ) .
     2983           run gbl/wndpar_r.p
     2984             (input  v-cntxt-db-num
     2985             ,input  v-cntxt-userid
     2986             ,input  'wndmax':U
     2987             ,output v-diasize-wndmax
     2988             ,output v-default-value
     2989             ) .
     2990         end.
     2991         assign
     2992           v-diasize-wndstore = false
     2993         .
     2994         if connected("ub") = true
     2995         then do:
     2996           run gbl/wndpar_r.p
     2997             (input  v-cntxt-db-num
     2998             ,input  v-cntxt-userid
     2999             ,input  'wndstore':U
     3000             ,output v-diasize-wndstore
     3001             ,output v-default-value
     3002             ) .
     3003         end.
     3004         assign
     3005           v-diasize-proc-name = entry(1, program-name(2), '.')
     3006         .
     3007         if v-diasize-wndstore = true
     3008         then do:
     3009           assign
     3010             v-restore-saved = false
     3011           .
     3012           if connected("ub") = true
     3013           then do:
     3014             run gbl/wndsizer.p
     3015               (input  v-cntxt-db-num
     3016               ,input  v-cntxt-userid
     3017               ,input  v-diasize-proc-name
     3018               ,input  'height':u
     3019               ,output v-resize-value-str
     3020               ) .
     3021             if v-resize-value-str <> '':U
     3022             then do:
     3023               run diasize_change-height in this-procedure
     3024                 (input  integer(v-resize-value-str)
     3025                 ,input  true
     3026                 ) .
     3027               assign
     3028                 v-restore-saved = true
     3029               .
     3030             end.
     3031           end.
     3032           if connected("ub") = true
     3033           then do:
     3034             run gbl/wndsizer.p
     3035               (input  v-cntxt-db-num
     3036               ,input  v-cntxt-userid
     3037               ,input  v-diasize-proc-name
     3038               ,input  'width':u
     3039               ,output v-resize-value-str
     3040               ) .
     3041             if v-resize-value-str <> '':U
     3042             then do:
     3043               run diasize_change-width in this-procedure
     3044                 (input  integer(v-resize-value-str)
     3045                 ,input  true
     3046                 ) .
     3047               assign
     3048                 v-restore-saved = true
     3049               .
     3050             end.
     3051           end.
     3052           if v-restore-saved <> true
     3053           then do:
     3054             if v-diasize-wndmax = true
     3055             then do:
     3056               run diasize_maximize in this-procedure
     3057                 (input  true
     3058                 ) .
     3059             end.
     3060           end.
     3061         end.
     3062         else do:
     3063           if v-diasize-wndmax = true
     3064           then do:
     3065             run diasize_maximize in this-procedure
     3066               (input  true
     3067               ) .
     3068           end.
     3069         end.
     3070       end.
     3071     end.
     3072   end procedure.
     3073   procedure diasize_need-full-display :
     3074     define output parameter p-need-full-display as logical   no-undo .
     3075     do
     3076     on error undo, return error return-value
     3077     :
     3078       assign
     3079         p-need-full-display = v-diasize-need-full-display
     3080       .
     3081       assign
     3082         v-diasize-need-full-display = false
     3083       .
     3084     end.
     3085   end procedure.
     3086   procedure get-context :
     3087      define output parameter p-db-num as integer          no-undo.
     3088      define output parameter p-user-id as character        no-undo.
     3089      define variable v-login               as character    no-undo.
     3090      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3091      define buffer buf_user-login  for ub.user-login .
     3092      do
     3093      on error undo, return error
     3094      :
     3095            FIND FIRST buf_sys-ctrl no-lock.
     3096            ASSIGN
     3097               v-login = USERID("ub")
     3098               p-db-num = buf_sys-ctrl.db-num
     3099            .
     3100            FIND FIRST buf_user-login
     3101                 WHERE buf_user-login.db-num = p-db-num
     3102                   AND buf_user-login.user-login = v-login
     3103                 no-lock
     3104                 no-error
     3105                 .
     3106            IF AVAILABLE buf_user-login
     3107            THEN DO:
     3108               assign
     3109                  p-user-id = buf_user-login.user-id
     3110               .
     3111            END.
     3112      end.
     3113   end procedure.
     3114       run diasize_init in this-procedure .
     3115   MAIN-BLOCK:
     3116   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3117      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3118   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3119     run mainmenu_getcntxt in parparentproc
     3120       (output v-cntxt-db-num
     3121       ,output v-cntxt-userid
     3122       ,output v-cntxt-level
     3123       ,output v-cntxt-host-code-obj
     3124       ,output v-cntxt-obj-type
     3125       ,output v-cntxt-obj-code
     3126       ,output v-cntxt-db-num-obj
     3127       ,output v-cntxt-is-admin
     3128       ) .
     3129   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3130   ON TAB ANYWHERE
     3131   DO:
     3132   define variable ii as integer no-undo .
     3133   define variable fh as widget-handle no-undo .
     3134   define variable hh as widget-handle no-undo .
     3135   define variable v-next-widget-name as character no-undo .
     3136   if v-tab-order <> '' then do:
     3137     if self:type = "TOGGLE-BOX" then
     3138     self:BGCOLOR = ?.
     3139     assign
     3140     ii = lookup(self:name, v-tab-order).
     3141     assign
     3142     ii = ii + 1
     3143     v-next-widget-name = entry(ii, v-tab-order)
     3144     no-error .
     3145     if error-status:error then do:
     3146       assign
     3147       ii = 1
     3148       v-next-widget-name = entry( ii, v-tab-order)
     3149       .
     3150     end.
     3151     assign
     3152     fh = frame Dialog-Frame:first-child
     3153     hh = fh:first-child
     3154     .
     3155     do while valid-handle(hh):
     3156       if hh:name = v-next-widget-name then do:
     3157         if hh:sensitive  = yes
     3158         AND hh:visible = yes then do:
     3159           if hh:type = "TOGGLE-BOX":U then do:
     3160             assign
     3161             hh:BGcolor = 1
     3162             .
     3163           end.
     3164           APPLY "ENTRY" to hh.
     3165           return no-apply.
     3166         end.
     3167         else do:
     3168           APPLY "TAB" to hh.
     3169           return no-apply.
     3170         end.
     3171       end.
     3172       hh = hh:next-sibling.
     3173     end.
     3174   end.
     3175   END.
     3176   ON BACK-TAB ANYWHERE
     3177   DO:
     3178   define variable ii as integer no-undo .
     3179   define variable fh as widget-handle no-undo .
     3180   define variable hh as widget-handle no-undo .
     3181   define variable v-next-widget-name as character no-undo .
     3182   if v-tab-order <> '' then do:
     3183     assign
     3184     ii = lookup(self:name, v-tab-order).
     3185     .
     3186     assign
     3187     ii = (if ii = 1
     3188           then  num-entries(v-tab-order)
     3189           else ii - 1
     3190           )
     3191     v-next-widget-name = entry(ii, v-tab-order)
     3192     .
     3193     assign
     3194     fh = frame Dialog-Frame:first-child
     3195     hh = fh:first-child
     3196     .
     3197     do while valid-handle(hh):
     3198       if hh:name = v-next-widget-name then do:
     3199         if hh:sensitive  = yes
     3200         AND hh:visible = yes then do:
     3201           if hh:type = "TOGGLE-BOX":U then do:
     3202             assign
     3203             hh:BGcolor = 1
     3204             .
     3205           end.
     3206           APPLY "ENTRY" to hh.
     3207           return no-apply.
     3208         end.
     3209         else do:
     3210         APPLY "BACK-TAB" to hh.
     3211         return no-apply.
     3212         end.
     3213       end.
     3214       hh = hh:next-sibling.
     3215     end.
     3216     end.
     3217   END.
     3218   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3219   ON RETURN ANYWHERE
     3220   DO:
     3221   define variable ii as integer no-undo .
     3222   define variable fh as widget-handle no-undo .
     3223   define variable hh as widget-handle no-undo .
     3224   define variable v-next-widget-name as character no-undo .
     3225     if v-tab-order <> '' then do:
     3226       assign
     3227       ii = lookup(self:name, v-tab-order).
     3228       if ii = num-entries(v-tab-order) then do:
     3229           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3230           return no-apply.
     3231       end.
     3232       if self:type <> "BUTTON" and
     3233         self:type <> "EDITOR"  then do:
     3234         run proc-move-forward in this-procedure .
     3235         return no-apply.
     3236       end.
     3237       if self:type = "BUTTON" then do:
     3238         APPLY "CHOOSE" to self.
     3239       end.
     3240       if self:type = "TOGGLE-BOX" then
     3241       self:BGCOLOR = ?.
     3242       assign
     3243       ii = ii + 1
     3244       v-next-widget-name = entry(ii, v-tab-order)
     3245       no-error .
     3246       if error-status:error then do:
     3247         assign
     3248         ii = 1
     3249         v-next-widget-name = entry( ii, v-tab-order)
     3250         .
     3251       end.
     3252       assign
     3253       fh = frame Dialog-Frame:first-child
     3254       hh = fh:first-child
     3255       .
     3256       do while valid-handle(hh):
     3257         if hh:name = v-next-widget-name then do:
     3258           if hh:sensitive  = yes
     3259           AND hh:visible = yes then do:
     3260             if hh:type = "TOGGLE-BOX":U then do:
     3261               assign
     3262               hh:BGcolor = 1
     3263               .
     3264             end.
     3265             APPLY "ENTRY" to hh.
     3266             return no-apply.
     3267           end.
     3268           else do:
     3269             APPLY "TAB" to hh.
     3270             return no-apply.
     3271           end.
     3272         end.
     3273         hh = hh:next-sibling.
     3274       end.
     3275     end.
     3276   END.
     3277   procedure proc-move-forward :
     3278   define variable ii as integer no-undo .
     3279   define variable fh as widget-handle no-undo .
     3280   define variable hh as widget-handle no-undo .
     3281   define variable v-next-widget-name as character no-undo .
     3282   do
     3283   on error undo, return error
     3284   :
     3285     if v-tab-order <> '' then do:
     3286       if self:type = "TOGGLE-BOX" then
     3287       self:BGCOLOR = ?.
     3288       assign
     3289       ii = lookup(self:name, v-tab-order).
     3290       assign
     3291       ii = ii + 1
     3292       v-next-widget-name = entry(ii, v-tab-order)
     3293       no-error .
     3294       if error-status:error then do:
     3295         assign
     3296         ii = 1
     3297         v-next-widget-name = entry( ii, v-tab-order)
     3298         .
     3299       end.
     3300       assign
     3301       fh = frame Dialog-Frame:first-child
     3302       hh = fh:first-child
     3303       .
     3304       do while valid-handle(hh):
     3305         if hh:name = v-next-widget-name then do:
     3306           if hh:sensitive  = yes
     3307           AND hh:visible = yes then do:
     3308             if hh:type = "TOGGLE-BOX":U then do:
     3309               assign
     3310               hh:BGcolor = 1
     3311               .
     3312             end.
     3313             APPLY "ENTRY" to hh.
     3314             return.
     3315           end.
     3316           else do:
     3317             assign
     3318             ii = ii + 1
     3319             v-next-widget-name = entry(ii, v-tab-order)
     3320             no-error .
     3321             if error-status:error then do:
     3322               assign
     3323               ii = 1
     3324               v-next-widget-name = entry( ii, v-tab-order)
     3325               .
     3326             end.
     3327           end.
     3328         end.
     3329         hh = hh:next-sibling.
     3330       end.
     3331     end.
     3332   end.
     3333   end procedure.
     3334     IF p-mode <> 'ПРОСМОТР':U
     3335     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3336         MESSAGE
     3337         vss-workfile vss-revision vss-description skip
     3338         "Неверное значение параметра p-mode" p-mode
     3339         VIEW-AS ALERT-BOX ERROR.
     3340         UNDO, RETURN ERROR.
     3341     END.
     3342     IF p-obj-type <> 'маг':U
     3343     and p-obj-type <> 'орг':U
     3344     and p-obj-type <> '':U
     3345     THEN DO:
     3346         MESSAGE
     3347         vss-workfile vss-revision vss-description skip
     3348         "Неверное значение параметра p-obj-type" p-obj-type
     3349         VIEW-AS ALERT-BOX ERROR.
     3350         UNDO, RETURN ERROR.
     3351     END.
     3352     if p-obj-type = 'маг':U then do:
     3353       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     3354       IF NOT AVAILABLE X_shop THEN DO:
     3355           MESSAGE
     3356           vss-workfile vss-revision vss-description skip
     3357           "Неверное значение параметра p-obj-code" p-obj-code
     3358           VIEW-AS ALERT-BOX ERROR.
     3359           UNDO, RETURN ERROR.
     3360       END.
     3361   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3363     (input  'маг':U
     3364     ,input  p-obj-code
     3365     ,output v-db-num
     3366     )  .
     3367       IF v-db-num <> v-cntxt-db-num
     3368       AND v-cntxt-db-num <> 0
     3369       and p-mode <> 'ПРОСМОТР':U
     3370       THEN DO:
     3371           MESSAGE
     3372           "Нельзя менять параметры магазина в чужой БД" skip
     3373           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3374           VIEW-AS ALERT-BOX ERROR.
     3375           UNDO, RETURN ERROR.
     3376       END.
     3377   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3379     (input  p-obj-type
     3380     ,input  p-obj-code
     3381     ,output v-host-code
     3382     )  .
     3383     end.
     3384     if p-obj-type = 'орг':U then do:
     3385       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     3386       IF NOT AVAILABLE X_sysconf THEN DO:
     3387           MESSAGE
     3388           vss-workfile vss-revision vss-description skip
     3389           "Неверное значение параметра p-obj-code" p-obj-code
     3390           VIEW-AS ALERT-BOX ERROR.
     3391           UNDO, RETURN ERROR.
     3392       END.
     3393       if v-cntxt-db-num <> 0
     3394       and p-mode <> 'ПРОСМОТР':U
     3395       then do:
     3396           MESSAGE
     3397           "Нельзя менять параметры ФИРМЫ в УБД" skip
     3398           VIEW-AS ALERT-BOX ERROR.
     3399           UNDO, RETURN ERROR.
     3400       end.
     3401       v-host-code = p-obj-code.
     3402     end.
     3403     if p-obj-type = '':U then do:
     3404       if v-cntxt-db-num <> 0
     3405       and p-mode <> 'ПРОСМОТР':U
     3406       then do:
     3407           MESSAGE
     3408           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3409           VIEW-AS ALERT-BOX ERROR.
     3410           UNDO, RETURN ERROR.
     3411       end.
     3412     end.
     3413     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3414       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3415                 LOCKED_thbj-attr.obj-type = p-obj-type
     3416           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3417           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-IBM-XML':U
     3418           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     3419        if locked locked_thbj-attr then do:
     3420           message
     3421           vss-workfile vss-revision vss-description skip
     3422            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3423           view-as alert-box error .
     3424           undo, return error.
     3425         end.
     3426     END.
     3427     ELSE DO:
     3428         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3429             LOCKED_thbj-attr.obj-type = p-obj-type
     3430       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3431       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-IBM-XML':U
     3432       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     3433     END.
     3434     if not available locked_thbj-attr then do:
     3435       ASSIGN
     3436       v-to-create  = YES.
     3437       message
     3438       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3439                   chr(10))
     3440       view-as alert-box WARNING.
     3441     end.
     3442     run FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3443     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3444     run Myenable in this-procedure .
     3445     WAIT-FOR GO OF FRAME Dialog-Frame.
     3446   END.
     3447   run disable_UI in this-procedure .
     3448   PROCEDURE disable_UI :
     3449     HIDE FRAME Dialog-Frame.
     3450   END PROCEDURE.
     3451   PROCEDURE enable_UI :
     3452     DISPLAY f-ibmrubc f-ibmnalc f-ibm-ccm RS-cd-vat T-multicurr t-ibmgroup
     3453             for-curr-name l-cd-vat
     3454         WITH FRAME Dialog-Frame.
     3455     ENABLE B-exit b-quit B-Help f-ibmrubc f-ibmnalc b-curr f-ibm-ccm RS-cd-vat
     3456            T-multicurr BR-tax-rate-code t-ibmgroup BR-specgrp for-curr-name
     3457            l-cd-vat
     3458         WITH FRAME Dialog-Frame.
     3459     VIEW FRAME Dialog-Frame.
     3460   END PROCEDURE.
     3461   PROCEDURE fill-widgets :
     3462   define variable v-value-character as character no-undo .
     3463   define variable v-value-date as date no-undo .
     3464   define variable v-value-decimal as decimal no-undo .
     3465   define variable v-value-integer as INTEGER no-undo .
     3466   define variable v-value-logical AS LOGICAL no-undo .
     3467   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3468   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3469   DEFINE VARIABLE v-rate-code LIKE ub.tax-rate.rate-code NO-UNDO.
     3470   DEFINE VARIABLE v-cdtaxlst AS CHARACTER NO-UNDO.
     3471   DEFINE VARIABLE v-specgrp AS CHARACTER NO-UNDO.
     3472   define variable v-param-type as character no-undo .
     3473   define variable v-param-value as character no-undo .
     3474   define variable v-grp-code as integer no-undo .
     3475   define variable v-gtype as integer no-undo .
     3476   DEFINE BUFFER buf_tax-rate FOR ub.tax-rate.
     3477   DEFINE BUFFER buf_goods FOR ub.goods.
     3478   DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3479   FOR EACH thbjattr_thbj-attr:
     3480     delete thbjattr_thbj-attr.
     3481   end.
     3482   FOR EACH temp-thbj-attr:
     3483     delete temp-thbj-attr.
     3484   end.
     3485   run adm/shattri.p (
     3486                 input "init":U
     3487               , input p-obj-type
     3488               , input p-obj-code
     3489               , input 'cd-type-IBM-XML':U
     3490               , input "":U
     3491               , output v-value-character
     3492               , output v-value-date
     3493               , output v-value-decimal
     3494               , output v-value-integer
     3495               , output v-value-logical
     3496               , output v-param-type
     3497               , INPUT-OUTPUT table-handle v-tth
     3498               ) no-error .
     3499   if error-status:error
     3500   and not available locked_thbj-attr then do:
     3501     message
     3502     "Не удалось получить начальные значения настроек" skip
     3503     error-status:get-message(1) return-value
     3504     view-as alert-box error .
     3505     undo, return error .
     3506   end.
     3507   FOR EACH thbjattr_thbj-attr:
     3508     ASSIGN
     3509     v-entry = thbjattr_thbj-attr.prop-code.
     3510     IF v-entry = 'ibmrubc':U THEN DO:
     3511       ASSIGN
     3512       f-ibmrubc = thbjattr_thbj-attr.property-value-integer
     3513       f-ibmrubc:private-data in frame Dialog-Frame  = "recid=" + string(recid(thbjattr_thbj-attr))
     3514       .
     3515     END.
     3516     IF v-entry = 'ibmnalc':U THEN DO:
     3517       ASSIGN
     3518       f-ibmnalc = thbjattr_thbj-attr.property-value-integer
     3519       f-ibmnalc:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3520       .
     3521     END.
     3522     IF v-entry = 'ibm-ccm':U THEN DO:
     3523       ASSIGN
     3524       f-ibm-ccm = thbjattr_thbj-attr.property-value-integer
     3525       f-ibm-ccm:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3526       .
     3527     END.
     3528     IF v-entry = 'ibmgroup':U THEN DO:
     3529       ASSIGN
     3530       t-ibmgroup = thbjattr_thbj-attr.property-value-logical
     3531       t-ibmgroup:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3532       .
     3533     END.
     3534     IF v-entry = 'cd-vat':U THEN DO:
     3535       ASSIGN
     3536       RS-cd-vat = thbjattr_thbj-attr.property-value-integer
     3537       rs-cd-vat:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3538       .
     3539     END.
     3540     IF v-entry = 'cdtaxlst':U THEN DO:
     3541       ASSIGN
     3542       v-cdtaxlst = thbjattr_thbj-attr.property-value-character
     3543       .
     3544     END.
     3545     IF v-entry = 'specgrp':U THEN DO:
     3546       ASSIGN
     3547       v-specgrp = thbjattr_thbj-attr.property-value-character.
     3548     END.
     3549     IF v-entry = 'multicurr':U THEN DO:
     3550       ASSIGN
     3551       t-multicurr = thbjattr_thbj-attr.property-value-logical
     3552       t-multicurr:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     3553       .
     3554     END.
     3555     create temp-thbj-attr.
     3556     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3557   END.
     3558   if v-cdtaxlst <> "":U then do:
     3559     _ii:
     3560     DO ii = 1 TO NUM-ENTRIES(v-cdtaxlst, ";"):
     3561       ASSIGN
     3562       v-rate-code = INTEGER (ENTRY(1, ENTRY(ii, v-cdtaxlst, ";":U), "-":U))
     3563       .
     3564       FIND FIRST buf_tax-rate NO-LOCK WHERE
     3565                     buf_tax-rate.rate-code = v-rate-code NO-ERROR.
     3566       IF NOT AVAILABLE buf_tax-rate THEN NEXT _ii.
     3567         CREATE tt-tax-rate-code.
     3568         BUFFER-COPY buf_tax-rate TO tt-tax-rate-code
     3569         ASSIGN
     3570         tt-tax-rate-code.tax-code = integer(ENTRY(2, ENTRY(ii, v-cdtaxlst, ";":U), "-":U))
     3571         .
     3572     END.
     3573   end.
     3574   if v-specgrp <> "":U then do:
     3575     _ii:
     3576     DO ii = 1 TO NUM-ENTRIES(v-specgrp, ";"):
     3577       ASSIGN
     3578       v-grp-code = INTEGER (ENTRY(1, ENTRY(ii, v-specgrp, ";":U), "-":U))
     3579       .
     3580       if num-entries(ENTRY(ii, v-specgrp, ";":U), "-":U) > 2 then do:
     3581         assign
     3582         v-gtype = INTEGER (ENTRY(3, ENTRY(ii, v-specgrp, ";":U), "-":U)) no-error .
     3583       end.
     3584       FIND FIRST buf_tt-sum-grp NO-LOCK WHERE
     3585                     buf_tt-sum-grp.grp-code = v-grp-code NO-ERROR.
     3586       IF AVAILABLE buf_tt-sum-grp THEN NEXT _ii.
     3587       FIND FIRST buf_goods NO-LOCK WHERE
     3588                   buf_goods.gds-code = integer(ENTRY(2, ENTRY(ii, v-specgrp, ";":U), "-":U)) NO-ERROR.
     3589         CREATE buf_tt-sum-grp.
     3590         ASSIGN
     3591         buf_tt-sum-grp.grp-code = integer(ENTRY(1, ENTRY(ii, v-specgrp, ";":U), "-":U))
     3592         buf_tt-sum-grp.code-2 = (IF AVAILABLE buf_goods
     3593                                  THEN buf_goods.gds-code
     3594                                  ELSE integer(ENTRY(2, ENTRY(ii, v-specgrp, ";":U), "-":U)))
     3595         buf_tt-sum-grp.grp-name = (IF AVAILABLE buf_goods
     3596                                  THEN buf_goods.gds-name
     3597                                  ELSE "!!!Ошибка не такого товара")
     3598         buf_tt-sum-grp.gtype    = v-gtype
     3599         .
     3600     END.
     3601   end.
     3602   END PROCEDURE.
     3603   PROCEDURE MyEnable :
     3604   DEFINE BUFFER buf_currency FOR ub.currency.
     3605   FIND FIRST buf_currency NO-LOCK WHERE
     3606             buf_currency.curr-code = f-ibmnalc NO-ERROR.
     3607   IF AVAILABLE buf_currency THEN DO:
     3608       ASSIGN
     3609       for-curr-name = buf_currency.curr-abbr.
     3610   END.
     3611   ASSIGN
     3612   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     3613   v-tab-order = "f-ibmrubc,f-ibmnalc,f-ibm-ccm,b-curr,RS-cd-vat,t-multicurr,b-add,b-del,br-tax-rate-code," +
     3614                 "t-ibmgroup,b-add-2,b-del-2,br-specgrp".
     3615   assign
     3616   f-ibmrubc :label = "Код национальной валюты (РУБ) НА КАССЕ"
     3617   b-add-2:MENU-MOUSE = 1
     3618   .
     3619   if p-obj-code = 0 and p-obj-type = "" then  t-ibmgroup = no.
     3620   DISPLAY
     3621   f-ibmrubc
     3622   f-ibmnalc
     3623   f-ibm-ccm
     3624   for-curr-name
     3625   RS-cd-vat
     3626   l-cd-vat
     3627   t-ibmgroup
     3628   t-multicurr
     3629   WITH FRAME Dialog-Frame.
     3630   ENABLE
     3631   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3632   b-quit
     3633   B-Help
     3634   br-tax-rate-code
     3635   br-specgrp
     3636   b-curr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3637   f-ibmrubc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3638   f-ibmnalc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3639   f-ibm-ccm WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3640   t-ibmgroup WHEN p-mode = 'ИЗМЕНЕНИЕ':U and p-obj-code <> 0
     3641   t-multicurr when p-mode = 'ИЗМЕНЕНИЕ':U
     3642   rs-cd-vat WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3643   b-add   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND rs-cd-vat = 1
     3644   b-del   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND rs-cd-vat = 1
     3645   b-add-2   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-ibmgroup
     3646   b-del-2   WHEN p-mode = 'ИЗМЕНЕНИЕ':U AND t-ibmgroup
     3647   WITH FRAME Dialog-Frame.
     3648   VIEW FRAME Dialog-Frame.
     3649   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3650       HIDE
     3651       b-exit
     3652       IN FRAME Dialog-Frame.
     3653       ASSIGN
     3654       b-quit:LABEL = "&Выход"
     3655       tt-tax-rate-code.tax-code:read-only  in browse br-tax-rate-code = yes
     3656       .
     3657   END.
     3658   APPLY "value-changed" TO rs-cd-vat.
     3659   APPLY "value-changed" TO t-ibmgroup.
     3660   OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     3661   END PROCEDURE.
     3662   PROCEDURE OpenBr :
     3663   OPEN QUERY br-tax-rate-code FOR EACH tt-tax-rate-code SHARE-LOCK.
     3664   END PROCEDURE.
     3665   PROCEDURE proc-b-add-2 :
     3666   DEFINE INPUT PARAMETER p-gtype AS INTEGER NO-UNDO.
     3667   DEFINE VARIABLE v-value-int AS integer NO-UNDO.
     3668   DEFINE VARIABLE v-sum-grp-rid AS recid NO-UNDO.
     3669   DEFINE VARIABLE ref-list AS character NO-UNDO.
     3670   define buffer buf_gds-list for gds-list.
     3671     define variable v-host-code as integer no-undo .
     3672     define buffer buf_macro-list-hist for macro-list-hist.
     3673     DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3674     DEFINE BUFFER buf_goods FOR ub.goods.
     3675     DEFINE BUFFER buf_sum-grp FOR ub.sum-grp.
     3676     run ref/sum-grps.w (
     3677                    input parparentproc
     3678                  , INPUT "b-sel"
     3679                  , input-output ref-list).
     3680     if ref-list = "":U then do:
     3681       UNDO, RETURN ERROR.
     3682     END.
     3683       find first buf_sum-grp no-lock where
     3684                 recid(buf_sum-grp) = integer(entry(1, ref-list)) no-error .
     3685       if not avail buf_sum-grp then return error.
     3686       assign
     3687       v-value-int = buf_sum-grp.grp-code
     3688       .
     3689     FIND FIRST buf_tt-sum-grp WHERE
     3690               buf_tt-sum-grp.grp-code = v-value-int NO-ERROR.
     3691     IF AVAILABLE buf_tt-sum-grp THEN DO:
     3692         MESSAGE
     3693         "Уже определена запись с таким кодом"
     3694         VIEW-AS ALERT-BOX ERROR.
     3695         UNDO, RETURN error.
     3696     END.
     3697     for each buf_macro-list-hist:
     3698       delete buf_macro-list-hist.
     3699     end.
     3700     for each gds-list-hist:
     3701       delete gds-list-hist.
     3702     end.
     3703     create buf_macro-list-hist.
     3704     assign
     3705     buf_macro-list-hist.list-table = '':U
     3706     buf_macro-list-hist.id         = 1
     3707     buf_macro-list-hist.line       = 0
     3708     buf_macro-list-hist.hist-mode  = '+'
     3709     buf_macro-list-hist.status_    = 'все':U
     3710     .
     3711     CASE p-gtype:
     3712         WHEN 50 THEN DO:
     3713             ASSIGN
     3714             buf_macro-list-hist.des        = "ВСЕ услуги-платежи в адрес ОСС"
     3715             buf_macro-list-hist.item_      = 'office-type':U
     3716             buf_macro-list-hist.option_    = "goods-attr"
     3717             .
     3718         END.
     3719         WHEN 24 THEN DO:
     3720             ASSIGN
     3721             buf_macro-list-hist.des        = "ВСЕ услуги-перечисления в системы лояльности"
     3722             buf_macro-list-hist.item_      = 'is-loyalty-payment':U  + chr(3) + string(yes)
     3723             buf_macro-list-hist.option_    = "goods-attr-val"
     3724             .
     3725       END.
     3726     END CASE.
     3727     release buf_macro-list-hist.
     3728   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3729   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3730     (input  p-obj-type
     3731     ,input  p-obj-code
     3732     ,output v-host-code
     3733     ) no-error .
     3734     for each gds-list:
     3735       delete gds-list.
     3736     end.
     3737     run str/gdsqlist.w (
     3738                      input parparentproc
     3739                     ,input this-procedure:handle
     3740                     ,input v-host-code
     3741                     ,input p-obj-type
     3742                     ,input p-obj-code
     3743                     ,input "b-sel"
     3744                     ,input "ВСЕ услуги-платежи в адрес ОСС"
     3745                     ,input yes
     3746                     ).
     3747     find first gds-list where
     3748              gds-list.to-sel = yes no-error.
     3749     if not available gds-list then return error.
     3750     FIND FIRST buf_goods NO-LOCK WHERE
     3751               buf_goods.gds-code = gds-list.gds-code NO-ERROR.
     3752     IF NOT AVAILABLE buf_goods THEN RETURN error.
     3753     for each buf_gds-list where buf_gds-list.to-sel = yes:
     3754       buf_gds-list.to-sel = no.
     3755     end.
     3756     if buf_goods.gds-type <> 'у':U then do:
     3757       message
     3758       "Со спецгруппой можно связать только УСЛУГУ!"
     3759       view-as alert-box error.
     3760       undo, return error.
     3761     end.
     3762     if buf_goods.unit-base <> "руб" then do:
     3763       message
     3764       substitute("Со спецгруппой можно связать только УСЛУГУ,&1" +
     3765                  "у которой единица измерения равна единице измерения НАЦИОНАЛЬНОЙ ВАЛЮТЫ (&2)"
     3766                  , chr(10)
     3767                  , "руб")
     3768       view-as alert-box error.
     3769       undo, return error.
     3770     end.
     3771     CREATE buf_tt-sum-grp.
     3772     ASSIGN
     3773     buf_tt-sum-grp.grp-code = v-value-int
     3774     buf_tt-sum-grp.grp-name = gds-list.gds-name
     3775     buf_tt-sum-grp.code-2   = gds-list.gds-code
     3776     buf_tt-sum-grp.gtype    = p-gtype
     3777     v-sum-grp-rid = RECID(buf_tt-sum-grp)
     3778     .
     3779     for each gds-list:
     3780       delete gds-list.
     3781     end.
     3782     OPEN QUERY BR-specgrp FOR EACH tt-sum-grp NO-LOCK INDEXED-REPOSITION.
     3783     REPOSITION br-specgrp TO RECID v-sum-grp-rid.
     3784   END PROCEDURE.
     3785   PROCEDURE proc-save :
     3786   define variable v-value-character as character no-undo .
     3787   define variable v-value-date as date no-undo .
     3788   define variable v-value-decimal as decimal no-undo .
     3789   define variable v-value-integer as INTEGER no-undo .
     3790   define variable v-value-logical AS LOGICAL no-undo .
     3791   define variable v-cdtaxlst as character no-undo .
     3792   define variable v-specgrp as character no-undo .
     3793   define variable ii as integer no-undo .
     3794   define variable v-param-type as character no-undo .
     3795   define variable wh as widget-handle no-undo .
     3796   define variable fh as widget-handle no-undo .
     3797   define variable v-same as logical no-undo .
     3798   DEFINE BUFFER buf_tt-tax-rate-code FOR tt-tax-rate-code.
     3799   DEFINE BUFFER buf_tt-sum-grp FOR tt-sum-grp.
     3800   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3801   FIND FIRST buf_tt-tax-rate-code NO-LOCK WHERE
     3802             buf_tt-tax-rate-code.tax-code = 0 NO-ERROR.
     3803   IF AVAILABLE buf_tt-tax-rate-code THEN DO:
     3804       MESSAGE
     3805       "Вы не ввели категорию налога НА КАССЕ для ставки с кодом " buf_tt-tax-rate-code.rate-code
     3806       VIEW-AS ALERT-BOX ERROR.
     3807       RETURN ERROR.
     3808   END.
     3809   ASSIGN
     3810   FRAME Dialog-Frame
     3811   f-ibmrubc
     3812   f-ibmnalc
     3813   f-ibm-ccm
     3814   t-ibmgroup
     3815   t-multicurr
     3816   RS-cd-vat.
     3817   if rs-cd-vat = 1 then do:
     3818     FOR EACH tt-tax-rate-code BY tt-tax-rate-code.rate-code:
     3819       ASSIGN
     3820       ii = ii + 1
     3821       v-cdtaxlst = v-cdtaxlst + (if ii = 1 then "":U else ";":U) +
     3822                     STRING(tt-tax-rate-code.rate-code) + "-":U + STRING(tt-tax-rate-code.tax-code)
     3823       .
     3824     END.
     3825   end.
     3826   if t-ibmgroup then do:
     3827     ii = 0.
     3828     FOR EACH buf_tt-sum-grp BY buf_tt-sum-grp.grp-code:
     3829       ASSIGN
     3830       ii = ii + 1
     3831       v-specgrp = v-specgrp + (if ii = 1 then "":U else ";":U)  +
     3832                     STRING(buf_tt-sum-grp.grp-code) + "-":U + STRING(buf_tt-sum-grp.code-2) +
     3833                      '-' + STRING(buf_tt-sum-grp.gtype)
     3834       .
     3835     END.
     3836   end.
     3837   assign
     3838   fh = frame Dialog-Frame:first-child
     3839   wh = fh:first-child
     3840   .
     3841   do while valid-handle(wh):
     3842     if wh:private-data begins "recid=" then do:
     3843       find first thbjattr_thbj-attr where
     3844                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     3845       assign
     3846       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3847     end.
     3848     wh = wh:next-sibling.
     3849   end.
     3850   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cdtaxlst':U.
     3851   assign
     3852   thbjattr_thbj-attr.property-value-character = v-cdtaxlst
     3853   .
     3854   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'specgrp':U.
     3855   assign
     3856   thbjattr_thbj-attr.property-value-character = v-specgrp
     3857   .
     3858   v-same = yes.
     3859   for each thbjattr_thbj-attr,
     3860       first temp-thbj-attr where
     3861             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3862         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3863         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3864         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3865      buffer-compare
     3866      thbjattr_thbj-attr
     3867      to temp-thbj-attr
     3868      save result in v-same.
     3869      if not v-same then leave.
     3870   end.
     3871   v-same = no.
     3872   IF v-same  and not v-to-create THEN RETURN.
     3873   run adm/shattri.p (
     3874                 input "check":U
     3875               , input p-obj-type
     3876               , input p-obj-code
     3877               , input 'cd-type-IBM-XML':U
     3878               , INPUT '':U
     3879                , output v-value-character
     3880                , output v-value-date
     3881                , output v-value-decimal
     3882                , output v-value-integer
     3883                , output v-value-logical
     3884                , output v-param-type
     3885                , input-output table-handle v-tth
     3886                ) no-error .
     3887   if error-status:error then do:
     3888     message
     3889     "Некорректное значение ПАРАМЕТРОВ" skip
     3890     error-status:get-message(1) skip
     3891     return-value
     3892     view-as alert-box error .
     3893     undo, return error .
     3894   end.
     3895   do TRANSACTION
     3896   on error undo, return error return-value
     3897   :
     3898     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3899          input p-obj-type
     3900         ,input p-obj-code
     3901         ,input 'cd-type-IBM-XML':U
     3902         ,INPUT table thbjattr_thbj-attr
     3903     ) NO-ERROR.
     3904     IF ERROR-STATUS:error THEN do:
     3905       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3906       RETURN-VALUE
     3907       VIEW-AS ALERT-BOX.
     3908       UNDO, RETURN ERROR.
     3909     END.
     3910   end.
     3911   END PROCEDURE.
