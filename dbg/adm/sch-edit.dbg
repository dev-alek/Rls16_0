        1   DEFINE TEMP-TABLE tt_schedule NO-UNDO LIKE ub.schedule.
        2   define input        parameter parparentproc as widget-handle no-undo .
        3   define input        parameter p-action     as   character              no-undo .
        4   define input        parameter p-cre-db-num like ub.schedule.cre-db-num no-undo .
        5   define input        parameter p-task-type  like ub.schedule.task-type  no-undo .
        6   define input-output parameter p-recid      as   recid                  no-undo .
        7   define output       parameter p-modify     as   logical                no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Редактирование строки рассписания".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   PROCEDURE LastDate:
      120       def input parameter in-date as date no-undo.
      121       def output parameter LastDate as date no-undo.
      122       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      123   END PROCEDURE.
      124   define temp-table curr-task no-undo
      125     field db-num      as character column-label "БД" format "X(5)"
      126     field db-num-char as character column-label "БД" format "X(5)"
      127     field task-num    as integer   column-label "N задачи" format ">>>>>>>9"
      128     field task-type   as character
      129     field cre-db-num    as integer
      130     field task-date   as date      column-label "Дата"  format "99.99.9999"
      131     field task-time   as integer   column-label "Время"
      132     field task-free-id  as character column-label "ID произвольного задания"
      133     index pi is unique primary
      134       task-type
      135       db-num
      136       task-num
      137     index pii
      138       task-type
      139       db-num
      140       task-date
      141       task-time
      142   .
      143   define temp-table tt-weekday no-undo
      144     field weekday as integer
      145     index pi is unique primary
      146       weekday ascending
      147   .
      148   define temp-table tt-hour no-undo
      149     field hour as integer
      150     index pi is unique primary
      151       hour ascending
      152   .
      153   define temp-table tt-minute no-undo
      154     field minute as integer
      155     index pi is unique primary
      156       minute ascending
      157   .
      158   define temp-table tt-db no-undo
      159     field db-num as integer
      160     index pi is unique primary
      161       db-num ascending
      162   .
      163   procedure trans-task :
      164     define input parameter p-task-type as character no-undo .
      165     do
      166     on error undo, return error
      167     :
      168       define variable v-curr-weekday  as integer   no-undo .
      169       define variable v-today         as date      no-undo .
      170       define variable v-curr-time     as integer   no-undo .
      171       define variable v-curr-time-str as character no-undo .
      172       define variable v-curr-hour     as integer   no-undo .
      173       define variable v-curr-minute   as integer   no-undo .
      174       define variable v-curr-sec      as integer   no-undo .
      175       define variable v-task-date     as date      no-undo .
      176       define variable v-task-time     as integer   no-undo .
      177       define variable v-last-date     as date      no-undo .
      178       define variable v-num-entries   as integer   no-undo .
      179       define variable v-ind           as integer   no-undo .
      180       define variable v-set-task      as logical   no-undo .
      181       define variable v-task-time-h   as integer   no-undo .
      182       define variable v-first-hour    as integer   no-undo .
      183       define variable v-task-time-m   as integer   no-undo .
      184       define variable v-first-minute  as integer   no-undo .
      185       define variable v-create-task   as logical   no-undo .
      186       define buffer buf_schedule for ub.schedule .
      187       define buffer buf_db       for ub.db .
      188       define buffer buf_sys-ctrl for ub.sys-ctrl .
      189       find first buf_sys-ctrl no-lock .
      190       block_sch:
      191       for each buf_schedule no-lock
      192         where buf_schedule.cre-db-num = buf_sys-ctrl.db-num
      193           and buf_schedule.task-type  = p-task-type
      194           and buf_schedule.active     = TRUE
      195       on error undo, return error
      196       :
      197         assign
      198           v-today         = today
      199           v-curr-time     = time
      200           v-curr-time-str = string( time, "HH:MM:SS":U )
      201           v-curr-hour     = integer( entry( 1, v-curr-time-str, ":":U ) )
      202           v-curr-minute   = integer( entry( 2, v-curr-time-str, ":":U ) )
      203           v-curr-sec      = integer( entry( 3, v-curr-time-str, ":":U ) )
      204           v-task-date     = v-today
      205           v-task-time     = v-curr-time
      206         .
      207         if trim( buf_schedule.task-weekday ) <> "*":U then do:
      208           for each tt-weekday
      209           on error undo, return error return-value
      210           :
      211             delete tt-weekday.
      212           end.
      213           run gbl/prcs-lst.p
      214             ( input  buf_schedule.task-weekday
      215              ,input  1
      216              ,input  7
      217              ,input  false
      218              ,input (buffer tt-weekday:handle)
      219              ,input "weekday":U
      220             ) no-error .
      221           find first tt-weekday no-lock
      222             where tt-weekday.weekday >= weekday( v-task-date ) - 1
      223             no-error .
      224           if available tt-weekday then do:
      225             assign
      226               v-task-date = v-task-date + tt-weekday.weekday - weekday( v-task-date ) + 1
      227             .
      228           end.
      229           else do:
      230             for first tt-weekday no-lock
      231               by tt-weekday.weekday
      232             on error undo, return error return-value
      233             :
      234               assign
      235                 v-task-date = v-task-date + 7 + tt-weekday.weekday - weekday( v-task-date + 7 ) + 1
      236               .
      237             end.
      238           end.
      239           if v-task-date < v-today then do:
      240             next block_sch.
      241           end.
      242         end.
      243         else do:
      244           if trim( buf_schedule.task-year ) <> "*":U then do:
      245             assign
      246               v-task-date = date( month( v-task-date )
      247                                   ,day( v-task-date )
      248                                   ,integer( buf_schedule.task-year )
      249                                 )
      250             .
      251             if v-task-date < v-today then do:
      252               next block_sch.
      253             end.
      254           end.
      255           if trim( buf_schedule.task-month ) <> "*":U then do:
      256             assign
      257               v-task-date = date( integer( buf_schedule.task-month )
      258                                   ,day( v-task-date )
      259                                   ,year( v-task-date )
      260                                 )
      261             .
      262             if v-task-date < v-today then do:
      263               run next-task-year ( input recid( buf_schedule )
      264                                   ,input-output v-task-date
      265                                 ) no-error.
      266               if error-status :error then do:
      267                 next block_sch.
      268               end.
      269             end.
      270           end.
      271           if trim( buf_schedule.task-day ) <> "*":U then do:
      272             run lastdate in this-procedure
      273               (input  v-task-date
      274               ,output v-last-date
      275               ) no-error .
      276             if error-status :error then do:
      277               next block_sch.
      278             end.
      279             if integer( buf_schedule.task-day ) > day( v-last-date ) then do:
      280               next block_sch.
      281             end.
      282             assign
      283               v-task-date = date( month( v-task-date )
      284                                  ,integer( buf_schedule.task-day )
      285                                  ,year( v-task-date )
      286                                 )
      287             .
      288             if v-task-date < v-today then do:
      289               run next-task-month in this-procedure
      290                 ( input recid( buf_schedule )
      291                  ,input-output v-task-date
      292                 ) no-error.
      293               if error-status :error then do:
      294                 next block_sch.
      295               end.
      296             end.
      297           end.
      298         end.
      299         if trim( buf_schedule.task-hour ) <> "*":U then do:
      300           for each tt-hour
      301           on error undo, return error return-value
      302           :
      303             delete tt-hour.
      304           end.
      305           run gbl/prcs-lst.p
      306             ( input  buf_schedule.task-hour
      307              ,input  0
      308              ,input  24
      309              ,input  false
      310              ,input (buffer tt-hour:handle)
      311              ,input "hour":U
      312             ) no-error .
      313           for first tt-hour no-lock
      314             by tt-hour.hour
      315           on error undo, return error return-value
      316           :
      317             assign
      318               v-first-hour = tt-hour.hour
      319             .
      320           end.
      321           if v-task-date > v-today then do:
      322             assign
      323               v-task-time = v-task-time + ( v-first-hour - v-curr-hour ) * 3600
      324             .
      325           end.
      326           else do:
      327             if v-task-date = v-today then do:
      328               assign
      329                 v-task-time-h = v-task-time
      330                 v-set-task    = false
      331               .
      332               block_hour:
      333               for each tt-hour no-lock
      334                 by tt-hour.hour
      335               on error undo, return error return-value
      336               :
      337                 assign
      338                   v-task-time-h = v-task-time + ( tt-hour.hour - v-curr-hour ) * 3600
      339                 .
      340                 if v-task-time-h >= v-curr-time then do:
      341                   assign
      342                     v-task-time = v-task-time-h
      343                     v-set-task  = true
      344                   .
      345                   leave block_hour.
      346                 end.
      347               end.
      348               if v-task-time < v-curr-time
      349                 or v-set-task = false
      350               then do:
      351                 assign
      352                   v-task-time = v-task-time + ( v-first-hour - v-curr-hour ) * 3600
      353                 .
      354                 run next-task-day ( input recid( buf_schedule )
      355                                    ,input-output v-task-date
      356                                   ) no-error.
      357                 if error-status :error then do:
      358                   next block_sch.
      359                 end.
      360               end.
      361             end.
      362           end.
      363         end.
      364         else do:
      365           if v-task-date > v-today then do:
      366             assign
      367               v-task-time = v-task-time + ( 0 - v-curr-hour ) * 3600
      368             .
      369           end.
      370         end.
      371         if trim( buf_schedule.task-minute ) <> "*":U then do:
      372           for each tt-minute
      373           on error undo, return error return-value
      374           :
      375             delete tt-minute.
      376           end.
      377           run gbl/prcs-lst.p
      378             ( input buf_schedule.task-minute
      379              ,input 0
      380              ,input 60
      381              ,input false
      382              ,input (buffer tt-minute:handle)
      383              ,input "minute":U
      384             ) no-error .
      385           for first tt-minute no-lock
      386             by tt-minute.minute
      387           on error undo, return error return-value
      388           :
      389             assign
      390               v-first-minute = tt-minute.minute
      391             .
      392           end.
      393           if v-task-date > v-today then do:
      394             assign
      395               v-task-time = v-task-time + ( v-first-minute - v-curr-minute ) * 60
      396             .
      397           end.
      398           else do:
      399             if v-task-date = v-today then do:
      400               assign
      401                 v-task-time-m = v-task-time
      402                 v-set-task    = false
      403               .
      404               block_minute:
      405               for each tt-minute no-lock
      406                 by tt-minute.minute
      407               on error undo, return error return-value
      408               :
      409                 assign
      410                   v-task-time-m = v-task-time + ( tt-minute.minute - v-curr-minute ) * 60
      411                 .
      412                 if v-task-time-m >= v-curr-time then do:
      413                   assign
      414                     v-task-time = v-task-time-m
      415                     v-set-task  = true
      416                   .
      417                   leave block_minute.
      418                 end.
      419               end.
      420               if v-task-time < v-curr-time
      421                 or v-set-task = false
      422               then do:
      423                 assign
      424                   v-task-time = v-task-time + ( v-first-minute - v-curr-minute ) * 60
      425                 .
      426                 run next-task-hour ( input recid( buf_schedule )
      427                                     ,input-output v-task-date
      428                                     ,input-output v-task-time
      429                                   ) no-error.
      430                 if error-status :error then do:
      431                   next block_sch.
      432                 end.
      433               end.
      434             end.
      435           end.
      436         end.
      437         else do:
      438           assign
      439             v-task-time-h = integer( entry( 1, string( v-task-time, "HH:MM:SS":U ), ":":U ) )
      440           .
      441           if v-task-date > v-today
      442             or ( v-task-date = v-today
      443                  and v-task-time-h > v-curr-hour
      444                )
      445           then do:
      446             assign
      447               v-task-time = v-task-time + ( 0 - v-curr-minute ) * 60
      448             .
      449           end.
      450         end.
      451         if trim( buf_schedule.task-second ) <> "*":U then do:
      452           assign
      453             v-task-time = v-task-time - v-curr-sec + integer( buf_schedule.task-second )
      454           .
      455           if v-task-date = v-today
      456             and v-task-time + 10 <= v-curr-time
      457           then do:
      458             run next-task-minute ( input recid( buf_schedule )
      459                                   ,input-output v-task-date
      460                                   ,input-output v-task-time
      461                                  ) no-error.
      462             if error-status :error then do:
      463               next block_sch.
      464             end.
      465           end.
      466         end.
      467         if v-task-date = v-today
      468           and v-task-time <= v-curr-time
      469         then do:
      470           run next-task-minute ( input recid( buf_schedule )
      471                                 ,input-output v-task-date
      472                                 ,input-output v-task-time
      473                                 ) no-error.
      474           if error-status :error then do:
      475             next block_sch.
      476           end.
      477         end.
      478         if buf_schedule.db-num-char <> "*":U then do:
      479           for each tt-db
      480           on error undo, return error return-value
      481           :
      482             delete tt-db.
      483           end.
      484           run gbl/prcs-lst.p
      485             ( input buf_schedule.db-num-char
      486             ,input 0
      487             ,input 99999
      488             ,input false
      489             ,input (buffer tt-db:handle)
      490             ,input "db-num":U
      491             ) no-error .
      492         end.
      493         for each buf_db no-lock
      494         on error undo, return error return-value
      495         :
      496           assign
      497             v-create-task = true
      498           .
      499           if buf_schedule.db-num-char <> "*":U then do:
      500             find first tt-db no-lock
      501               where tt-db.db-num = buf_db.db-num
      502               no-error .
      503             if not available tt-db then do:
      504               assign
      505                 v-create-task = false
      506               .
      507             end.
      508           end.
      509           if v-create-task = true then do:
      510             create curr-task .
      511             assign
      512               curr-task.db-num      = string( buf_db.db-num )
      513               curr-task.db-num-char = buf_schedule.db-num-char
      514               curr-task.task-num    = buf_schedule.task-num
      515               curr-task.task-type   = buf_schedule.task-type
      516               curr-task.cre-db-num    = buf_schedule.cre-db-num
      517               curr-task.task-date   = v-task-date
      518               curr-task.task-time   = v-task-time
      519             .
      520           end.
      521         end.
      522       end.
      523       for each tt-weekday
      524       on error undo, return error return-value
      525       :
      526         delete tt-weekday.
      527       end.
      528       for each tt-hour
      529       on error undo, return error return-value
      530       :
      531         delete tt-hour.
      532       end.
      533       for each tt-minute
      534       on error undo, return error return-value
      535       :
      536         delete tt-minute.
      537       end.
      538       for each tt-db
      539       on error undo, return error return-value
      540       :
      541         delete tt-db.
      542       end.
      543     end.
      544   end procedure.
      545   procedure next-task-year :
      546     define input        parameter p-recid-sch as recid no-undo .
      547     define input-output parameter p-task-date as date no-undo.
      548     do
      549     on error undo, return error
      550     :
      551       define buffer buf_schedule for ub.schedule .
      552       find first buf_schedule no-lock
      553         where recid( buf_schedule ) = p-recid-sch
      554       .
      555       if trim( buf_schedule.task-year ) <> "*":U then do:
      556         assign
      557           p-task-date = ?
      558         .
      559         return error.
      560       end.
      561       else do:
      562         if month( p-task-date ) = 2
      563           and day( p-task-date ) = 29
      564         then do:
      565           if trim( buf_schedule.task-day ) <> "*":U then do:
      566             assign
      567               p-task-date = date( month( p-task-date )
      568                                   ,day( p-task-date )
      569                                   ,year( p-task-date ) + 4
      570                                 )
      571             .
      572           end.
      573           else do:
      574             assign
      575               p-task-date = date( month( p-task-date )
      576                                   ,28
      577                                   ,year( p-task-date ) + 1
      578                                 )
      579             .
      580           end.
      581         end.
      582         else do:
      583           assign
      584             p-task-date = date( month( p-task-date )
      585                                 ,day( p-task-date )
      586                                 ,year( p-task-date ) + 1
      587                               )
      588           .
      589         end.
      590       end.
      591     end.
      592   end procedure.
      593   procedure next-task-month :
      594     define input        parameter p-recid-sch as recid no-undo .
      595     define input-output parameter p-task-date as date no-undo.
      596     do
      597     on error undo, return error
      598     :
      599       define variable v-date      as date no-undo .
      600       define variable v-last-date as date no-undo .
      601       define buffer buf_schedule for ub.schedule .
      602       find first buf_schedule no-lock
      603         where recid( buf_schedule ) = p-recid-sch
      604       .
      605       if trim( buf_schedule.task-month ) <> "*":U then do:
      606         run next-task-year ( input p-recid-sch
      607                             ,input-output p-task-date
      608                            ) no-error.
      609         if error-status :error then do:
      610           assign
      611             p-task-date = ?
      612           .
      613           return error.
      614         end.
      615       end.
      616       else do:
      617         if month( p-task-date ) = 12 then do:
      618           assign
      619             p-task-date = date( 1
      620                                ,day( p-task-date )
      621                                ,year( p-task-date )
      622                                )
      623           .
      624           run next-task-year ( input p-recid-sch
      625                               ,input-output p-task-date
      626                             ) no-error.
      627           if error-status :error then do:
      628             assign
      629               p-task-date = ?
      630             .
      631             return error.
      632           end.
      633         end.
      634         else do:
      635           assign
      636             v-date = date( month( p-task-date ) + 1
      637                           ,1
      638                           ,year( p-task-date )
      639                          )
      640           .
      641           run lastdate in this-procedure
      642             ( input  v-date
      643              ,output v-last-date
      644             ) no-error .
      645           if error-status :error then do:
      646             assign
      647               p-task-date = ?
      648             .
      649             return error.
      650           end.
      651           if day( p-task-date ) > day( v-last-date ) then do:
      652             if trim( buf_schedule.task-day ) <> "*":U then do:
      653               do while true :
      654                 assign
      655                   v-date = date( month( v-date ) + 1
      656                                 ,1
      657                                 ,year( v-date )
      658                               )
      659                 .
      660                 run lastdate in this-procedure
      661                   ( input  v-date
      662                    ,output v-date
      663                   ) no-error .
      664                 if error-status :error then do:
      665                   assign
      666                     p-task-date = ?
      667                   .
      668                   return error.
      669                 end.
      670                 if day( p-task-date ) = day( v-date ) then do:
      671                   assign
      672                     p-task-date = v-date
      673                   .
      674                   leave.
      675                 end.
      676               end.
      677             end.
      678             else do:
      679               assign
      680                 p-task-date = v-last-date
      681               .
      682             end.
      683           end.
      684           else do:
      685             assign
      686               p-task-date = date( month( p-task-date ) + 1
      687                                  ,day( p-task-date )
      688                                  ,year( p-task-date )
      689                                 )
      690             .
      691           end.
      692         end.
      693       end.
      694     end.
      695   end procedure.
      696   procedure next-task-day :
      697     define input        parameter p-recid-sch as recid no-undo .
      698     define input-output parameter p-task-date as date no-undo.
      699     do
      700     on error undo, return error
      701     :
      702       define buffer buf_schedule for ub.schedule .
      703       find first buf_schedule no-lock
      704         where recid( buf_schedule ) = p-recid-sch
      705       .
      706       if trim( buf_schedule.task-weekday ) <> "*":U then do:
      707         find first tt-weekday no-lock
      708           where tt-weekday.weekday > weekday( p-task-date ) - 1
      709           no-error .
      710         if available tt-weekday then do:
      711           assign
      712             p-task-date = p-task-date + tt-weekday.weekday - weekday( p-task-date ) + 1
      713           .
      714         end.
      715         else do:
      716           for first tt-weekday no-lock
      717             by tt-weekday.weekday
      718           on error undo, return error return-value
      719           :
      720             assign
      721               p-task-date = p-task-date + 7 + tt-weekday.weekday - weekday( p-task-date + 7 ) + 1
      722             .
      723           end.
      724         end.
      725       end.
      726       else do:
      727         if trim( buf_schedule.task-day ) <> "*":U then do:
      728           run next-task-month ( input p-recid-sch
      729                               ,input-output p-task-date
      730                               ) no-error.
      731           if error-status :error then do:
      732             assign
      733               p-task-date = ?
      734             .
      735             return error.
      736           end.
      737         end.
      738         else do:
      739           if month( p-task-date ) <> month( p-task-date + 1 ) then do:
      740             assign
      741               p-task-date = date( month( p-task-date )
      742                                   ,1
      743                                   ,year( p-task-date )
      744                                 )
      745             .
      746             run next-task-month ( input p-recid-sch
      747                                 ,input-output p-task-date
      748                                 ) no-error.
      749             if error-status :error then do:
      750               assign
      751                 p-task-date = ?
      752               .
      753               return error.
      754             end.
      755           end.
      756           else do:
      757             assign
      758               p-task-date = p-task-date + 1
      759             .
      760           end.
      761         end.
      762       end.
      763     end.
      764   end procedure.
      765   procedure next-task-hour :
      766     define input        parameter p-recid-sch as recid   no-undo .
      767     define input-output parameter p-task-date as date    no-undo.
      768     define input-output parameter p-task-time as integer no-undo.
      769     do
      770     on error undo, return error
      771     :
      772       define buffer buf_schedule for ub.schedule .
      773       define variable v-task-hour as integer   no-undo .
      774       find first buf_schedule no-lock
      775         where recid( buf_schedule ) = p-recid-sch
      776       .
      777       if trim( buf_schedule.task-hour ) <> "*":U then do:
      778         assign
      779           v-task-hour = integer( entry( 1, string( p-task-time, "HH:MM:SS":U ), ":":U ) )
      780         .
      781         find first tt-hour no-lock
      782           where tt-hour.hour > v-task-hour
      783           no-error .
      784         if available tt-hour then do:
      785           assign
      786             p-task-time = p-task-time + ( tt-hour.hour - v-task-hour ) * 3600
      787           .
      788         end.
      789         else do:
      790           for first tt-hour no-lock
      791             by tt-hour.hour
      792           on error undo, return error return-value
      793           :
      794             assign
      795               p-task-time = p-task-time + ( tt-hour.hour - v-task-hour ) * 3600
      796             .
      797           end.
      798           run next-task-day ( input p-recid-sch
      799                             ,input-output p-task-date
      800                             ) no-error.
      801           if error-status :error then do:
      802             assign
      803               p-task-date = ?
      804               p-task-time = ?
      805             .
      806             return error.
      807           end.
      808         end.
      809       end.
      810       else do:
      811         if p-task-time + 3600 >= 86400 then do:
      812           run next-task-day ( input p-recid-sch
      813                              ,input-output p-task-date
      814                             ) no-error.
      815           if error-status :error then do:
      816             assign
      817               p-task-date = ?
      818               p-task-time = ?
      819             .
      820             return error.
      821           end.
      822           assign
      823             p-task-time = p-task-time + 3600 - 86400
      824           .
      825         end.
      826         else do:
      827           assign
      828             p-task-time = p-task-time + 3600
      829           .
      830         end.
      831       end.
      832     end.
      833   end procedure.
      834   procedure next-task-minute :
      835     define input        parameter p-recid-sch as recid   no-undo .
      836     define input-output parameter p-task-date as date    no-undo.
      837     define input-output parameter p-task-time as integer no-undo.
      838     do
      839     on error undo, return error
      840     :
      841       define buffer buf_schedule for ub.schedule .
      842       define variable v-task-minute as integer   no-undo .
      843       find first buf_schedule no-lock
      844         where recid( buf_schedule ) = p-recid-sch
      845       .
      846       if trim( buf_schedule.task-minute ) <> "*":U then do:
      847         assign
      848           v-task-minute = integer( entry( 2, string( p-task-time, "HH:MM:SS":U ), ":":U ) )
      849         .
      850         find first tt-minute no-lock
      851           where tt-minute.minute > v-task-minute
      852           no-error .
      853         if available tt-minute then do:
      854           assign
      855             p-task-time = p-task-time + ( tt-minute.minute - v-task-minute ) * 60
      856           .
      857         end.
      858         else do:
      859           for first tt-minute no-lock
      860             by tt-minute.minute
      861           on error undo, return error return-value
      862           :
      863             assign
      864               p-task-time = p-task-time + ( tt-minute.minute - v-task-minute ) * 60
      865             .
      866           end.
      867           run next-task-hour ( input p-recid-sch
      868                               ,input-output p-task-date
      869                               ,input-output p-task-time
      870                             ) no-error.
      871           if error-status :error then do:
      872             assign
      873               p-task-date = ?
      874               p-task-time = ?
      875             .
      876             return error.
      877           end.
      878         end.
      879       end.
      880       else do:
      881         if truncate( p-task-time / 3600, 0 ) <> truncate( ( p-task-time + 60 ) / 3600, 0 ) then do:
      882           run next-task-hour ( input p-recid-sch
      883                               ,input-output p-task-date
      884                               ,input-output p-task-time
      885                             ) no-error.
      886           if error-status :error then do:
      887             assign
      888               p-task-date = ?
      889               p-task-time = ?
      890             .
      891             return error.
      892           end.
      893           assign
      894             p-task-time = p-task-time + 60 - 3600
      895           .
      896         end.
      897         else do:
      898           assign
      899             p-task-time = p-task-time + 60
      900           .
      901         end.
      902       end.
      903     end.
      904   end procedure.
      905   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   procedure cur-time :
      907      define output parameter p-today as date      no-undo .
      908      define output parameter p-time  as integer   no-undo .
      909     do
      910     on error undo, return error
      911     :
      912       define variable v-date1 as date      no-undo .
      913       define variable v-date2 as date      no-undo .
      914       define variable v-time  as integer   no-undo .
      915       assign
      916         v-date1 = today
      917         v-time  = time
      918         v-date2 = today
      919       .
      920       if v-date1 <> v-date2
      921       then do:
      922         assign
      923           v-date1 = today
      924           v-time  = v-time
      925         .
      926       end.
      927       assign
      928         p-today = v-date1
      929         p-time  = v-time
      930       .
      931     end.
      932   end.
      933   function cur-time-date returns character
      934   :
      935     return string(today, '99/99/9999':U) .
      936   end.
      937   function cur-time-mjd returns decimal
      938   :
      939     define variable v-date as date      no-undo .
      940     define variable v-time as integer   no-undo .
      941     run cur-time in this-procedure
      942       (output v-date
      943       ,output v-time
      944       ) .
      945     return integer(v-date) - 2400002 + (v-time / 86400) .
      946   end.
      947   function cur-time-get-ending-index returns integer
      948   (input p-number as integer
      949   )
      950   :
      951     if p-number < 0
      952     or p-number = ?
      953     then do:
      954       return 1 .
      955     end.
      956     define variable v-rest as integer   no-undo .
      957     assign
      958       p-number = p-number modulo 100
      959     .
      960     if p-number < 20
      961     then do:
      962       assign
      963         v-rest = p-number
      964       .
      965     end.
      966     else do:
      967       assign
      968         v-rest = p-number modulo 10
      969       .
      970     end.
      971     case v-rest :
      972       when 1
      973       then do:
      974         return 2 .
      975       end.
      976       when 2 or
      977       when 3 or
      978       when 4
      979       then do:
      980         return 3 .
      981       end.
      982       otherwise do:
      983         return 1 .
      984       end.
      985     end case .
      986   end.
      987   procedure cur-time-mjd-to-date :
      988      define input  parameter i-mjd-diff as decimal no-undo.
      989      define output parameter o-Date     as date    no-undo.
      990      define output parameter o-Time     as integer no-undo.
      991      define variable v-day-number as integer   no-undo .
      992      if    i-mjd-diff < 0
      993         or i-mjd-diff = ?
      994      then do:
      995         return "?" .
      996      end.
      997      assign
      998         v-day-number = truncate(i-mjd-diff,0).
      999         o-Date = date(v-day-number + 2400002).
     1000         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1001     .
     1002   end.
     1003   function cur-time-mjd-to-string returns character
     1004   (input p-mjd-diff as decimal
     1005   )
     1006   :
     1007     define variable v-day-number as integer   no-undo .
     1008     define variable v-seconds    as integer   no-undo .
     1009     define variable v-hour       as integer   no-undo .
     1010     define variable v-min        as integer   no-undo .
     1011     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1012     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1013     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1014     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1015     if p-mjd-diff < 0
     1016     or p-mjd-diff = ?
     1017     then do:
     1018       return "?" .
     1019     end.
     1020     assign
     1021       v-day-number = integer(truncate(p-mjd-diff,0))
     1022       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1023     .
     1024     if v-seconds > 86400
     1025     then do:
     1026       assign
     1027         v-seconds = 86400 - 1
     1028       .
     1029     end.
     1030     if v-seconds < 0
     1031     then do:
     1032       assign
     1033         v-seconds = 0
     1034       .
     1035     end.
     1036     assign
     1037       v-hour = truncate(v-seconds / 3600, 0)
     1038     .
     1039     assign
     1040       v-seconds = v-seconds modulo 3600
     1041     .
     1042     assign
     1043       v-min = truncate(v-seconds / 60, 0)
     1044     .
     1045     assign
     1046       v-seconds = v-seconds modulo 60
     1047     .
     1048     return
     1049         (if v-day-number <> 0
     1050           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1051           else ""
     1052         )
     1053       + (if v-day-number <> 0 or v-hour <> 0
     1054           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1055           else ""
     1056         )
     1057       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1058           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1059           else ""
     1060         )
     1061       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1062       .
     1063   end.
     1064   function cur-time-string returns character
     1065   :
     1066     define variable v-date as date      no-undo .
     1067     define variable v-time as integer   no-undo .
     1068     run cur-time in this-procedure
     1069       (output v-date
     1070       ,output v-time
     1071       ) .
     1072     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1073   end.
     1074   function cur-time-string-sec returns character
     1075   :
     1076     define variable v-date as date      no-undo .
     1077     define variable v-time as integer   no-undo .
     1078     run cur-time in this-procedure
     1079       (output v-date
     1080       ,output v-time
     1081       ) .
     1082     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1083   end.
     1084   function cur-time-custom  returns character
     1085   (input p-prefix as character
     1086   ,input p-date-format as character
     1087   ,input p-delimiter as character
     1088   ,input p-time-format as character
     1089   ,input p-suffix as character
     1090   )
     1091   :
     1092     define variable v-date as date      no-undo .
     1093     define variable v-time as integer   no-undo .
     1094     run cur-time in this-procedure
     1095       (output v-date
     1096       ,output v-time
     1097       ) .
     1098     return
     1099       p-prefix
     1100       + string(v-date, p-date-format)
     1101       + p-delimiter
     1102       + string(v-time, p-time-format)
     1103       + p-suffix
     1104       .
     1105   end.
     1106   function cur-time-print  returns character
     1107   :
     1108     define variable v-date as date      no-undo .
     1109     define variable v-time as integer   no-undo .
     1110     run cur-time in this-procedure
     1111       (output v-date
     1112       ,output v-time
     1113       ) .
     1114     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1115   end.
     1116   function cur-time-datetime returns datetime
     1117   :
     1118     define variable v-char as character no-undo .
     1119     define variable v-datetime as datetime no-undo .
     1120     v-char = cur-time-string().
     1121     v-datetime = datetime(v-char).
     1122     return  v-datetime.
     1123   end.
     1124   function cur-time-string-msec returns character
     1125   :
     1126     define variable v-date as datetime  no-undo .
     1127     v-date = now.
     1128     return string(v-date) .
     1129   end.
     1130   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   define temp-table temp-schedule-free no-undo
     1132   field free-id as character
     1133   field free-task-name as character
     1134   field proc-run-name as character
     1135   field proc-param-edit-name as character
     1136   field conf-param as character
     1137   field is-gbd as logical
     1138   field is-ubd as logical
     1139   field enable-concurrent-0 as logical
     1140   field enable-concurrent-db as logical
     1141   field other-info as character
     1142   field enc-key as character
     1143   field is-rum as logical
     1144   index pi is unique primary
     1145   free-id.
     1146   procedure schedule-attr-name :
     1147   do
     1148     on error undo, return error
     1149     :
     1150     define input  parameter p-code           as character no-undo .
     1151     define output parameter p-type           as character no-undo .
     1152     define output parameter p-format         as character no-undo .
     1153     define output parameter p-label          as character no-undo .
     1154     define output parameter p-user-can-edit  as logical   no-undo .
     1155     define output parameter p-output-display as logical   no-undo .
     1156     define output parameter p-other          as character no-undo .
     1157       if index(p-code, chr(4)) > 0 then do:
     1158         p-code = entry(1, p-code, chr(4)).
     1159       end.
     1160       case p-code :
     1161               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1162               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1163               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1164               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1165               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1166               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1167               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1168               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1169               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     1170         otherwise do:
     1171           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
     1172         end.
     1173       end.
     1174     end.
     1175   end procedure.
     1176   procedure schedule-attr-tooltip :
     1177   do
     1178     on error undo, return error
     1179     :
     1180       define input  parameter p-code    as character no-undo .
     1181       define output parameter p-tooltip as character no-undo .
     1182       define output parameter p-label   as character no-undo .
     1183       if index(p-code, chr(4)) > 0 then do:
     1184         p-code = entry(1, p-code, chr(4)).
     1185       end.
     1186       case p-code :
     1187               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1188               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1189               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1190               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1191               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1192               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1193               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1194               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     1195               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
     1196         otherwise do:
     1197               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
     1198         end.
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure schedule-attr-value :
     1203   do
     1204   on error undo, return error return-value
     1205   :
     1206   define input parameter  p-cre-db-num as integer    no-undo.
     1207   define input parameter  p-task-type  as character  no-undo.
     1208   define input parameter  p-task-num   as integer    no-undo.
     1209   define input parameter  p-code       as character  no-undo.
     1210   define output parameter p-value      as character  no-undo.
     1211   define output parameter p-type       as character  no-undo.
     1212       define variable v-format         as character no-undo .
     1213       define variable v-label          as character no-undo .
     1214       define variable v-user-can-edit  as logical   no-undo .
     1215       define variable v-output-display as logical   no-undo .
     1216       define variable v-other          as character no-undo .
     1217       define buffer buf_schedule-attr for ub.schedule-attr.
     1218       run schedule-attr-name in this-procedure (
     1219             input  p-code
     1220           , output p-type
     1221           , output v-format
     1222           , output v-label
     1223           , output v-user-can-edit
     1224           , output v-output-display
     1225           , output v-other
     1226       ) no-error .
     1227       if error-status :error
     1228       then do:
     1229           undo, return error return-value .
     1230       end.
     1231       if p-code begins ('schd-free-id':U + chr(4))
     1232       and entry(2, p-code, chr(4)) = '':U then do:
     1233         find first buf_schedule-attr no-lock
     1234             where buf_schedule-attr.cre-db-num = p-cre-db-num
     1235               and buf_schedule-attr.task-type  = p-task-type
     1236               and buf_schedule-attr.task-num   = p-task-num
     1237               and buf_schedule-attr.attr-code  begins p-code
     1238         no-error .
     1239       end.
     1240       else do:
     1241         find first buf_schedule-attr no-lock
     1242             where buf_schedule-attr.cre-db-num = p-cre-db-num
     1243               and buf_schedule-attr.task-type  = p-task-type
     1244               and buf_schedule-attr.task-num   = p-task-num
     1245               and buf_schedule-attr.attr-code  = p-code
     1246         no-error .
     1247       end.
     1248       if available buf_schedule-attr
     1249       then do:
     1250           assign
     1251               p-value = buf_schedule-attr.attr-value
     1252           .
     1253       end.
     1254       else do:
     1255         if p-code begins ('schd-free-id':U + chr(4) ) then do:
     1256            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
     1257         end.
     1258         else do:
     1259           assign
     1260               p-value = if p-type = 'L':U then "no":U else ""
     1261           .
     1262         end.
     1263       end.
     1264   end.
     1265   end procedure.
     1266   procedure schedule-attr-write :
     1267   do
     1268   on error undo, return error
     1269   :
     1270   define input parameter p-cre-db-num  as integer   no-undo.
     1271   define input parameter p-task-type   as character no-undo.
     1272   define input parameter p-task-num    as integer   no-undo.
     1273   define input parameter p-code        as character no-undo.
     1274   define input parameter p-value       as character no-undo.
     1275       define variable v-type              as character                no-undo.
     1276       define variable v-format            as character                no-undo.
     1277       define variable v-label             as character                no-undo.
     1278       define variable v-user-can-edit     as logical                  no-undo.
     1279       define variable v-output-display    as logical                  no-undo.
     1280       define variable v-other             as character                no-undo.
     1281       define buffer buf_schedule-attr for ub.schedule-attr .
     1282       run schedule-attr-name in this-procedure (
     1283             input  p-code
     1284           , output v-type
     1285           , output v-format
     1286           , output v-label
     1287           , output v-user-can-edit
     1288           , output v-output-display
     1289           , output v-other
     1290       ) no-error.
     1291       if error-status :error
     1292       then do:
     1293           undo, return error return-value.
     1294       end.
     1295       find first buf_schedule-attr exclusive-lock
     1296            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1297              and buf_schedule-attr.task-type  = p-task-type
     1298              and buf_schedule-attr.task-num   = p-task-num
     1299              and buf_schedule-attr.attr-code  = p-code
     1300       no-error.
     1301       if not available buf_schedule-attr
     1302       then do:
     1303           create buf_schedule-attr.
     1304           assign
     1305             buf_schedule-attr.cre-db-num = p-cre-db-num
     1306             buf_schedule-attr.task-type  = p-task-type
     1307             buf_schedule-attr.task-num   = p-task-num
     1308             buf_schedule-attr.attr-code  = p-code
     1309             buf_schedule-attr.attr-value = p-value
     1310           .
     1311       end.
     1312       else do:
     1313           assign
     1314               buf_schedule-attr.attr-value = p-value
     1315           .
     1316       end.
     1317   end.
     1318   end procedure.
     1319   procedure schedule-attr-delete :
     1320   do
     1321   on error undo, return error
     1322   :
     1323   define input  parameter p-cre-db-num  as integer   no-undo.
     1324   define input  parameter p-task-type   as character no-undo.
     1325   define input  parameter p-task-num    as integer   no-undo.
     1326   define input  parameter p-code        as character no-undo.
     1327   define output parameter p-deleted     as logical   no-undo.
     1328       define buffer buf_schedule-attr for ub.schedule-attr .
     1329       define variable v-type              as character                no-undo.
     1330       define variable v-format            as character                no-undo.
     1331       define variable v-label             as character                no-undo.
     1332       define variable v-user-can-edit     as logical                  no-undo.
     1333       define variable v-output-display    as logical                  no-undo.
     1334       define variable v-other             as character                no-undo.
     1335       run schedule-attr-name in this-procedure (
     1336             input p-code
     1337           , output v-type
     1338           , output v-format
     1339           , output v-label
     1340           , output v-user-can-edit
     1341           , output v-output-display
     1342           , output v-other
     1343       ) no-error .
     1344       if error-status :error
     1345       then do:
     1346           undo, return error return-value .
     1347       end.
     1348       find first buf_schedule-attr exclusive-lock
     1349            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1350              and buf_schedule-attr.task-type  = p-task-type
     1351              and buf_schedule-attr.task-num   = p-task-num
     1352              and buf_schedule-attr.attr-code  = p-code
     1353       no-error.
     1354       if not available buf_schedule-attr
     1355       then do:
     1356           assign
     1357               p-deleted = no
     1358           .
     1359       end.
     1360       else do:
     1361           delete buf_schedule-attr.
     1362           assign
     1363               p-deleted = yes
     1364           .
     1365       end.
     1366   end.
     1367   end procedure.
     1368   procedure schedule-attr-news :
     1369   do
     1370   on error undo, return error
     1371   :
     1372       define input  parameter p-code           as character no-undo .
     1373       define output parameter p-news           as logical   no-undo .
     1374       if index(p-code, chr(4)) > 0 then do:
     1375         p-code = entry(1, p-code, chr(4)).
     1376       end.
     1377       case p-code :
     1378               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
     1379               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
     1380               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
     1381               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
     1382               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
     1383               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
     1384               when 'schedule-filter':U then do:     assign     p-news = false.   end.
     1385               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
     1386               when 'schd-free-id':U then do:     assign     p-news = false.   end.
     1387         otherwise do:
     1388           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
     1389         end.
     1390       end.
     1391   end.
     1392   end procedure.
     1393   procedure schedule-attr-extract-logical :
     1394   do
     1395   on error undo, return error
     1396   :
     1397   define input  parameter p-parameter-number   as integer      no-undo.
     1398   define input  parameter p-parameter-list     as character    no-undo.
     1399   define output parameter p-parameter-value   as logical      no-undo.
     1400       if num-entries( p-parameter-list ) > p-parameter-number - 1
     1401       then do:
     1402           assign
     1403               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1404           .
     1405       end.
     1406       else do:
     1407           assign
     1408               p-parameter-value   = no
     1409           .
     1410       end.
     1411   end.
     1412   end procedure.
     1413   procedure schedule-attr-get-free-id :
     1414   do
     1415   on error undo, return error return-value
     1416   :
     1417     define input  parameter p-cre-db-num  as integer   no-undo.
     1418     define input  parameter p-task-type   as character no-undo.
     1419     define input  parameter p-task-num    as integer   no-undo.
     1420     define output parameter p-free-id     as character no-undo.
     1421     define buffer buf_schedule-attr for ub.schedule-attr.
     1422     find first buf_schedule-attr no-lock
     1423         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1424           and buf_schedule-attr.task-type  = p-task-type
     1425           and buf_schedule-attr.task-num   = p-task-num
     1426           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1427     no-error .
     1428     if available buf_schedule-attr then
     1429     assign
     1430     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1431     no-error
     1432     .
     1433   end.
     1434   end procedure.
     1435   procedure schedule-attr-get-free-props :
     1436     define input parameter p-free-id as character no-undo .
     1437     define output parameter p-value as character no-undo .
     1438     define buffer buf_temp-schedule-free for temp-schedule-free.
     1439     do
     1440     on error undo, return error return-value
     1441     :
     1442       find first buf_temp-schedule-free no-lock no-error .
     1443       if not available buf_temp-schedule-free then do:
     1444         run schedule-attr-fill-free-props in this-procedure .
     1445       end.
     1446       find first buf_temp-schedule-free where
     1447               buf_temp-schedule-free.free-id = p-free-id no-error.
     1448       if available buf_temp-schedule-free then do:
     1449         assign
     1450         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     1451                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     1452                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     1453                   buf_temp-schedule-free.conf-param           + chr(4) +
     1454                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     1455                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     1456                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     1457                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     1458                   buf_temp-schedule-free.other-info
     1459         .
     1460       end.
     1461       else do:
     1462        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     1463                              "id произвольной задачи - &5"
     1464                              ,vss-workfile
     1465                              ,vss-revision
     1466                              ,vss-description
     1467                              ,chr(10)
     1468                              ,p-free-id).
     1469       end.
     1470     end.
     1471   end procedure.
     1472   procedure schedule-attr-is-rum-free-id :
     1473   define input parameter p-free-id as character no-undo .
     1474   define output parameter p-is-rum as logical no-undo .
     1475   define buffer buf_temp-schedule-free for temp-schedule-free.
     1476   do
     1477   on error undo, return error
     1478   :
     1479       find first buf_temp-schedule-free no-lock no-error .
     1480       if not available buf_temp-schedule-free then do:
     1481         run schedule-attr-fill-free-props in this-procedure .
     1482       end.
     1483       find first buf_temp-schedule-free where
     1484               buf_temp-schedule-free.free-id = p-free-id no-error.
     1485       if available buf_temp-schedule-free
     1486       and buf_temp-schedule-free.is-rum
     1487       then do:
     1488         p-is-rum = yes.
     1489       end.
     1490   end.
     1491   end procedure.
     1492   procedure schedule-attr-fill-free-props :
     1493   define variable v-path                    as character                no-undo .
     1494   DEFINE VARIABLE v-full-path               as character                no-undo .
     1495   DEFINE VARIABLE v-file-name               as character                no-undo .
     1496   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1497   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1498   define buffer buf_temp-schedule-free for temp-schedule-free.
     1499   define variable v-answer as logical no-undo .
     1500     do
     1501     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1502                                           ,vss-workfile
     1503                                           ,vss-revision
     1504                                           ,vss-description
     1505                                           ,chr(10)
     1506                                           ,error-status:get-message(1) )
     1507     :
     1508       run gbl/filename.p (
     1509                       input 'cmp/shd-free.d'
     1510                     ,output v-full-path
     1511                     ,output v-path
     1512                     ,output v-file-name
     1513                     ,output v-file-name-no-ext
     1514                     ,output v-file-name-ext
     1515                     ) .
     1516       input from value(v-full-path).
     1517       repeat :
     1518         create buf_temp-schedule-free.
     1519         import buf_temp-schedule-free.
     1520       END.
     1521       input close.
     1522       _ff:
     1523       for each buf_temp-schedule-free :
     1524         if buf_temp-schedule-free.free-id = '':U then do:
     1525            delete buf_temp-schedule-free.
     1526            next _ff.
     1527          end.
     1528          run schedule-attr-check-enc in this-procedure (
     1529                                                       input  buf_temp-schedule-free.free-id
     1530                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1531                                                               buf_temp-schedule-free.proc-param-edit-name +
     1532                                                               buf_temp-schedule-free.conf-param +
     1533                                                               string(buf_temp-schedule-free.is-gbd) +
     1534                                                               string(buf_temp-schedule-free.is-ubd) +
     1535                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1536                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1537                                                               string(buf_temp-schedule-free.other-info)
     1538                                                               )
     1539                                                       ,input  buf_temp-schedule-free.enc-key
     1540                                                       ,output v-answer    ) no-error .
     1541          if error-status:error
     1542          or not v-answer then delete buf_temp-schedule-free.
     1543        end.
     1544     end.
     1545   end procedure.
     1546   Function schedule-attr-reverse returns character (str as character).
     1547      define variable rev_incl_s as character init "" no-undo .
     1548      define variable rev_incl_i as integer no-undo .
     1549      define variable rev_incl_l as integer no-undo .
     1550      rev_incl_l = length(str).
     1551      do rev_incl_i = 1 to rev_incl_l:
     1552         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1553      end.
     1554      return rev_incl_s.
     1555   end.
     1556   procedure schedule-attr-check-enc.
     1557     define input  parameter p-free-id   as character no-undo .
     1558     define input  parameter p-value     as character no-undo .
     1559     define input  parameter p-enc-value as character no-undo .
     1560     define output parameter p-answer    as logical   no-undo .
     1561     define variable tmp         as character no-undo .
     1562     define variable v-enc-value as character no-undo .
     1563     assign
     1564     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1565     .
     1566     run schedule-attr-pswd-enc in this-procedure
     1567       ( input tmp
     1568        ,output v-enc-value
     1569       ) no-error .
     1570     if error-status:error then do:
     1571       message
     1572         vss-workfile vss-revision vss-description skip
     1573         "Ошибка при вызове процедуры pswd-enc" skip
     1574         return-value skip
     1575         error-status :get-message(1) skip
     1576         view-as alert-box error .
     1577       undo, return error .
     1578     end.
     1579     if v-enc-value = p-enc-value then do:
     1580       assign
     1581         p-answer = true
     1582       .
     1583     end.
     1584     else do:
     1585       assign
     1586         p-answer = false
     1587       .
     1588     end.
     1589   end.
     1590   procedure schedule-attr-conf-enc.
     1591     define input  parameter p-free-id   as character no-undo .
     1592     define input  parameter p-value     as character no-undo .
     1593     define output parameter p-enc-value as character no-undo .
     1594     define variable tmp         as character no-undo .
     1595     assign
     1596       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1597     .
     1598     run schedule-attr-pswd-enc in this-procedure
     1599       ( input tmp
     1600        ,output p-enc-value
     1601       ) no-error .
     1602     if error-status:error then do:
     1603       message
     1604         vss-workfile vss-revision vss-description skip
     1605         "Ошибка при вызове процедуры pswd-enc" skip
     1606         return-value skip
     1607         error-status :get-message(1) skip
     1608         view-as alert-box error .
     1609       undo, return error .
     1610     end.
     1611   end procedure.
     1612   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1613   procedure schedule-attr-pswd-enc :
     1614     define input parameter  pswd     as character no-undo .
     1615     define output parameter enc-pswd as character no-undo .
     1616     do
     1617     on error undo, return error return-value
     1618     :
     1619       assign
     1620         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1621       .
     1622     end.
     1623   end procedure.
     1624   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625     define variable v-cntxt-db-num        as integer   no-undo .
     1626     define variable v-cntxt-userid        as character no-undo .
     1627     define variable v-cntxt-level         as character no-undo .
     1628     define variable v-cntxt-host-code-obj as integer   no-undo .
     1629     define variable v-cntxt-obj-type      as character no-undo .
     1630     define variable v-cntxt-obj-code      as integer   no-undo .
     1631     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1632     define variable v-cntxt-is-admin      as logical   no-undo .
     1633   define buffer buf_schedule     for ub.schedule .
     1634   define buffer buf-src_schedule for ub.schedule .
     1635   define buffer buf_sys-ctrl     for ub.sys-ctrl.
     1636   define variable v-free-id         as character no-undo .
     1637   define variable v-cancel          as logical   no-undo .
     1638   define variable v-params          as character no-undo .
     1639   DEFINE VARIABLE v-enable-db-num   as logical   no-undo.
     1640   define variable v-free-task-name  as character no-undo .
     1641   define variable is-ubd            as logical   no-undo init yes.
     1642   define variable is-gbd            as logical   no-undo init yes.
     1643   define variable v-free-attr-value as character no-undo .
     1644   define temp-table tt-val no-undo
     1645     field t-val as integer
     1646     index pi as unique primary t-val
     1647     .
     1648   DEFINE BUTTON b-exit AUTO-GO DEFAULT
     1649        LABEL "&Ввод"
     1650        SIZE 10 BY 1
     1651        BGCOLOR 8 .
     1652   DEFINE BUTTON b-help DEFAULT
     1653        LABEL "Помо&щь"
     1654        SIZE 10 BY 1
     1655        BGCOLOR 8 .
     1656   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1657        LABEL "&Отмена"
     1658        SIZE 10 BY 1
     1659        BGCOLOR 8 .
     1660   DEFINE QUERY sch-frame FOR
     1661         tt_schedule SCROLLING.
     1662   DEFINE FRAME sch-frame
     1663        b-exit AT ROW 1 COL 1
     1664        b-quit AT ROW 1 COL 11
     1665        b-help AT ROW 1 COL 24
     1666        tt_schedule.active AT ROW 2.25 COL 15.5
     1667             VIEW-AS TOGGLE-BOX
     1668             SIZE 8.75 BY 1
     1669        tt_schedule.db-num-char AT ROW 3.5 COL 13 COLON-ALIGNED FORMAT "X(256)"
     1670             VIEW-AS FILL-IN
     1671             SIZE 60 BY 1
     1672        tt_schedule.task-year AT ROW 5.25 COL 13 COLON-ALIGNED
     1673             VIEW-AS FILL-IN
     1674             SIZE 5 BY 1
     1675        tt_schedule.task-month AT ROW 5.25 COL 27 COLON-ALIGNED
     1676             VIEW-AS FILL-IN
     1677             SIZE 3 BY 1
     1678        tt_schedule.task-day AT ROW 5.25 COL 38.5 COLON-ALIGNED
     1679             LABEL "Число"
     1680             VIEW-AS FILL-IN
     1681             SIZE 3 BY 1
     1682        tt_schedule.task-weekday AT ROW 6.5 COL 13 COLON-ALIGNED HELP
     1683             ""
     1684             LABEL "Дни недели" FORMAT "X(13)"
     1685             VIEW-AS FILL-IN
     1686             SIZE 14 BY 1
     1687        tt_schedule.task-hour AT ROW 8 COL 13 COLON-ALIGNED
     1688             LABEL "Часы" FORMAT "X(75)"
     1689             VIEW-AS FILL-IN
     1690             SIZE 60 BY 1
     1691        tt_schedule.task-minute AT ROW 9.25 COL 13 COLON-ALIGNED
     1692             LABEL "Минуты" FORMAT "X(183)"
     1693             VIEW-AS FILL-IN
     1694             SIZE 60 BY 1
     1695        SPACE(0.87) SKIP(0.45)
     1696       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1697            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1698            TITLE "Строка расписания"
     1699            CANCEL-BUTTON b-quit.
     1700   ASSIGN
     1701          FRAME sch-frame:SCROLLABLE       = FALSE
     1702          FRAME sch-frame:HIDDEN           = TRUE.
     1703   ON WINDOW-CLOSE OF FRAME sch-frame
     1704   DO:
     1705     APPLY "END-ERROR":U TO SELF.
     1706   END.
     1707   ON RETURN OF tt_schedule.active IN FRAME sch-frame
     1708   DO:
     1709     apply "entry" to tt_schedule.task-year in frame sch-frame.
     1710     return no-apply.
     1711   END.
     1712   ON CHOOSE OF b-exit IN FRAME sch-frame
     1713   DO:
     1714     assign
     1715       tt_schedule.db-num-char
     1716       tt_schedule.active
     1717       tt_schedule.task-year
     1718       tt_schedule.task-month
     1719       tt_schedule.task-day
     1720       tt_schedule.task-weekday
     1721       tt_schedule.task-hour
     1722       tt_schedule.task-minute
     1723     .
     1724     run proc-save in this-procedure
     1725       no-error.
     1726     if error-status:error then do:
     1727       return no-apply.
     1728     end.
     1729   END.
     1730   ON LEAVE OF tt_schedule.db-num-char IN FRAME sch-frame
     1731   DO:
     1732     if tt_schedule.db-num-char:screen-value = "?":U then assign tt_schedule.db-num-char:screen-value = "*":U .
     1733   END.
     1734   ON RETURN OF tt_schedule.db-num-char IN FRAME sch-frame
     1735   DO:
     1736     apply "entry" to tt_schedule.active in frame sch-frame.
     1737     return no-apply.
     1738   END.
     1739   ON LEAVE OF tt_schedule.task-day IN FRAME sch-frame
     1740   DO:
     1741     if tt_schedule.task-day:screen-value = "?":U then assign tt_schedule.task-day:screen-value = "*":U .
     1742   END.
     1743   ON RETURN OF tt_schedule.task-day IN FRAME sch-frame
     1744   DO:
     1745     apply "entry" to tt_schedule.task-weekday in frame sch-frame.
     1746     return no-apply.
     1747   END.
     1748   ON LEAVE OF tt_schedule.task-hour IN FRAME sch-frame
     1749   DO:
     1750     if tt_schedule.task-hour:screen-value = "?":U then assign tt_schedule.task-hour:screen-value = "*":U .
     1751   END.
     1752   ON RETURN OF tt_schedule.task-hour IN FRAME sch-frame
     1753   DO:
     1754     apply "entry" to tt_schedule.task-minute in frame sch-frame.
     1755     return no-apply.
     1756   END.
     1757   ON LEAVE OF tt_schedule.task-minute IN FRAME sch-frame
     1758   DO:
     1759     if tt_schedule.task-minute:screen-value = "?":U then assign tt_schedule.task-minute:screen-value = "*":U .
     1760   END.
     1761   ON RETURN OF tt_schedule.task-minute IN FRAME sch-frame
     1762   DO:
     1763     apply "choose" to b-exit in frame sch-frame.
     1764     return no-apply.
     1765   END.
     1766   ON LEAVE OF tt_schedule.task-month IN FRAME sch-frame
     1767   DO:
     1768     if tt_schedule.task-month:screen-value = "?":U then assign tt_schedule.task-month:screen-value = "*":U .
     1769   END.
     1770   ON RETURN OF tt_schedule.task-month IN FRAME sch-frame
     1771   DO:
     1772     apply "entry" to tt_schedule.task-day in frame sch-frame.
     1773     return no-apply.
     1774   END.
     1775   ON LEAVE OF tt_schedule.task-weekday IN FRAME sch-frame
     1776   DO:
     1777     if tt_schedule.task-weekday:screen-value = "?":U then assign tt_schedule.task-weekday:screen-value = "*":U .
     1778   END.
     1779   ON RETURN OF tt_schedule.task-weekday IN FRAME sch-frame
     1780   DO:
     1781     apply "entry" to tt_schedule.task-hour in frame sch-frame.
     1782     return no-apply.
     1783   END.
     1784   ON LEAVE OF tt_schedule.task-year IN FRAME sch-frame
     1785   DO:
     1786     if tt_schedule.task-year:screen-value = "?":U then assign tt_schedule.task-year:screen-value = "*":U .
     1787   END.
     1788   ON RETURN OF tt_schedule.task-year IN FRAME sch-frame
     1789   DO:
     1790     apply "entry" to tt_schedule.task-month in frame sch-frame.
     1791     return no-apply.
     1792   END.
     1793   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1794   on help of frame sch-frame
     1795   do:
     1796     run gbl/app_help.p
     1797       (input this-procedure :file-name
     1798       ,input ''
     1799       ,input ?
     1800       ) no-error.
     1801     if error-status :error then do:
     1802       message
     1803         "Ошибка при вызове помощи"
     1804         error-status :get-message(1)
     1805         view-as alert-box .
     1806     end.
     1807   end.
     1808   run minbtn-set in this-procedure .
     1809   on choose of b-help in frame sch-frame
     1810   do:
     1811     apply "help":u to frame sch-frame .
     1812   end.
     1813   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1814   procedure minbtn-set :
     1815       do
     1816           on error undo, return error return-value
     1817           :
     1818           define variable ii              as integer       no-undo .
     1819           define variable fh              as widget-handle no-undo .
     1820           define variable hh              as widget-handle no-undo .
     1821           define variable v-h             as handle        extent 4 no-undo .
     1822           define variable v-name-button   as character     no-undo .
     1823           define variable v-help-old-x    as decimal       no-undo .
     1824           define variable v-help-old-y    as decimal       no-undo .
     1825           define variable v-help-old-size as decimal       no-undo .
     1826           define variable v-frame-width   as decimal       no-undo .
     1827           define variable jj              as integer       no-undo .
     1828           do
     1829               on error undo, return error
     1830               :
     1831               assign
     1832                   v-frame-width = frame sch-frame:width - 0.3
     1833                   fh            = frame sch-frame:first-child
     1834                   hh            = fh:first-child
     1835                   ii            = 1
     1836                   .
     1837               do while valid-handle(hh):
     1838                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1839                   do:
     1840                       case lc(hh:name) :
     1841                           when "b-help" then
     1842                               do:
     1843                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1844                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1845                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1846                                   hh:TOOLTIP = "Помощь" .
     1847                                   v-help-old-x = hh:column .
     1848                                   v-help-old-y = hh:row    .
     1849                                   v-help-old-size = hh:width .
     1850                                   hh:width-chars = 2.5 .
     1851                               end.
     1852                           when "b-print" then
     1853                               do:
     1854                                   hh:load-image("cmp/b-print.bmp":u) .
     1855                                   hh:TOOLTIP = "Печать" .
     1856                                   v-h[ii] = hh:handle .
     1857                                   ii = ii + 1 .
     1858                                   hh:width-chars = 3 .
     1859                               end.
     1860                           when "b-history" or
     1861                           when "b-hist" then
     1862                               do:
     1863                                   hh:load-image("cmp/b-hist.bmp":u) .
     1864                                   hh:TOOLTIP = "История" .
     1865                                   v-h[ii] = hh:handle .
     1866                                   ii = ii + 1 .
     1867                                   hh:width-chars = 3 .
     1868                               end.
     1869                           when "b-sch" then
     1870                               do:
     1871                                   hh:load-image("cmp/b-sch.bmp":u) .
     1872                                   hh:TOOLTIP = "Установка Фильтра" .
     1873                                   v-h[ii] = hh:handle .
     1874                                   ii = ii + 1 .
     1875                                   hh:width-chars = 3 .
     1876                               end.
     1877                           when "b-hist-user" then
     1878                               do:
     1879                                   hh:load-image("cmp/b-hist.bmp":u) .
     1880                                   hh:TOOLTIP = "История пользователя" .
     1881                                   ii = ii + 1 .
     1882                               end.
     1883                       end case.
     1884                   end.
     1885                   hh = hh:next-sibling.
     1886               end.
     1887               b-help:column = v-frame-width - b-help:width-chars.
     1888               jj = 0.
     1889               repeat ii = 4 to 1 by -1 :
     1890                   if valid-handle (v-h[ii] ) then
     1891                   do:
     1892                       jj  = jj + 1 .
     1893                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1894                       v-h[ii]:row    = v-help-old-y .
     1895                   end.
     1896               end.
     1897           end.
     1898       end.
     1899   end procedure.
     1900   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME sch-frame:PARENT eq ?
     1901   THEN FRAME sch-frame:PARENT = ACTIVE-WINDOW.
     1902   MAIN-BLOCK:
     1903   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1904      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1905     define variable v-task-num like ub.schedule.task-num no-undo .
     1906   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1907     run mainmenu_getcntxt in parparentproc
     1908       (output v-cntxt-db-num
     1909       ,output v-cntxt-userid
     1910       ,output v-cntxt-level
     1911       ,output v-cntxt-host-code-obj
     1912       ,output v-cntxt-obj-type
     1913       ,output v-cntxt-obj-code
     1914       ,output v-cntxt-db-num-obj
     1915       ,output v-cntxt-is-admin
     1916       ) .
     1917     assign
     1918       v-task-num = 0
     1919       v-free-id  = "":U
     1920     .
     1921     case p-action :
     1922       when 'ИЗМЕНЕНИЕ':U then do:
     1923         find first buf_schedule exclusive-lock
     1924           where recid( buf_schedule ) = p-recid
     1925           no-error
     1926         .
     1927         if not available buf_schedule then do:
     1928           message vss-workfile vss-revision vss-description skip
     1929             "Не найдена строка расписания для редактирования!"
     1930             view-as alert-box error.
     1931           return error .
     1932         end.
     1933         else do:
     1934           assign
     1935             v-task-num = buf_schedule.task-num
     1936           .
     1937         end.
     1938       end.
     1939       when 'КОПИРОВАНИЕ':U then do:
     1940         find first buf-src_schedule exclusive-lock
     1941           where recid( buf-src_schedule ) = p-recid
     1942           no-error
     1943         .
     1944         if not available buf-src_schedule then do:
     1945           message vss-workfile vss-revision vss-description skip
     1946             "Не найдена строка расписания для копирования!"
     1947             view-as alert-box error.
     1948           return error .
     1949         end.
     1950         else do:
     1951           assign
     1952             v-task-num = buf-src_schedule.task-num
     1953           .
     1954         end.
     1955       end.
     1956     end case.
     1957     if ( not available buf_schedule
     1958          and p-action = 'ИЗМЕНЕНИЕ':U
     1959        )
     1960        or ( not available buf-src_schedule
     1961             and p-action = 'КОПИРОВАНИЕ':U
     1962           )
     1963     then do:
     1964     end.
     1965     if p-task-type = 'autofree':U then do:
     1966       if p-action = 'КОПИРОВАНИЕ':U then do:
     1967         run schedule-attr-get-free-id  in this-procedure
     1968           ( input p-cre-db-num
     1969            ,input p-task-type
     1970            ,input v-task-num
     1971            ,output v-free-id
     1972           ) no-error .
     1973         if error-status:error then do:
     1974           undo, return error substitute( "&1. Невозможно получить название  произвольного задания по строке расписания &3&2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ) .
     1975         end.
     1976       end.
     1977       if v-free-id = "":U then do:
     1978         run adm/freeshdp.w
     1979           ( input parparentproc
     1980           ,input 0
     1981           ,input '':U
     1982           ,input 0
     1983           ,input p-action
     1984           ,input p-cre-db-num
     1985           ,input p-task-type
     1986           ,input v-task-num
     1987           ,input '':U
     1988           ,input-output v-free-id
     1989           ,output v-cancel
     1990           ,output v-params
     1991         ) no-error.
     1992         if error-status :error then do:
     1993           undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ) .
     1994         end.
     1995         if v-free-id = '':U
     1996           or ( v-cancel
     1997               and p-action <> 'ИЗМЕНЕНИЕ':U
     1998             )
     1999         then do:
     2000           undo, return error return-value .
     2001         end.
     2002       end.
     2003     end.
     2004     run fill-temp-table in this-procedure no-error.
     2005     if error-status:error then do:
     2006       message
     2007       substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2008       view-as alert-box .
     2009       undo, return error.
     2010     end.
     2011     assign
     2012       p-modify = false
     2013     .
     2014     frame sch-frame:title = substitute( "Строка расписания для БД &1", p-cre-db-num ).
     2015     RUN Myenable.
     2016     WAIT-FOR GO OF FRAME sch-frame.
     2017   END.
     2018   RUN disable_UI.
     2019   delete tt_schedule .
     2020   PROCEDURE disable_UI :
     2021     HIDE FRAME sch-frame.
     2022   END PROCEDURE.
     2023   PROCEDURE enable_UI :
     2024     OPEN QUERY sch-frame FOR EACH tt_schedule SHARE-LOCK.
     2025     GET FIRST sch-frame.
     2026     IF AVAILABLE tt_schedule THEN
     2027       DISPLAY tt_schedule.active tt_schedule.db-num-char tt_schedule.task-year
     2028             tt_schedule.task-month tt_schedule.task-day tt_schedule.task-weekday
     2029             tt_schedule.task-hour tt_schedule.task-minute
     2030         WITH FRAME sch-frame.
     2031     ENABLE b-exit b-quit b-help tt_schedule.active tt_schedule.db-num-char
     2032            tt_schedule.task-year tt_schedule.task-month tt_schedule.task-day
     2033            tt_schedule.task-weekday tt_schedule.task-hour tt_schedule.task-minute
     2034         WITH FRAME sch-frame.
     2035     VIEW FRAME sch-frame.
     2036   END PROCEDURE.
     2037   PROCEDURE fill-temp-table :
     2038     do
     2039     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2040     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2041     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2042     :
     2043       define variable v-db-num-char like ub.schedule.db-num-char no-undo.
     2044       define variable v-value       as   character               no-undo .
     2045       define buffer buf_temp-schedule-free for temp-schedule-free.
     2046       find first buf_sys-ctrl no-lock.
     2047       create tt_schedule .
     2048       if available buf_schedule then do:
     2049         buffer-copy buf_schedule to tt_schedule .
     2050       end.
     2051       else do:
     2052         if available buf-src_schedule then do:
     2053           buffer-copy buf-src_schedule to tt_schedule .
     2054         end.
     2055         else do:
     2056           assign
     2057             tt_schedule.task-type   = p-task-type
     2058             tt_schedule.db-num-char = "*":U
     2059             tt_schedule.activ       = false
     2060           .
     2061         end.
     2062       end.
     2063       assign
     2064         tt_schedule.task-second = "00"
     2065       .
     2066       case p-task-type:
     2067         when  'autosale':U
     2068         or when 'autogcd':U
     2069         or when 'autooxml':U
     2070         or when 'autosuz':U
     2071         or when 'is_PM':U
     2072         then do:
     2073           assign
     2074             v-db-num-char = string (p-cre-db-num)
     2075             is-gbd = no
     2076             v-enable-db-num = no
     2077           .
     2078         end.
     2079         when 'autofree':U then do:
     2080           run schedule-attr-get-free-props in this-procedure (input v-free-id, output v-free-attr-value).
     2081           if v-free-attr-value <> '':u then do:
     2082             assign
     2083             is-gbd = (entry(buffer buf_temp-schedule-free:buffer-field("is-gbd"):position - 2, v-free-attr-value, chr(4) ) = "yes")
     2084             is-ubd = (entry(buffer buf_temp-schedule-free:buffer-field("is-ubd"):position - 2, v-free-attr-value, chr(4) ) = "yes")
     2085             v-free-task-name = entry(buffer buf_temp-schedule-free:buffer-field("free-task-name"):position - 2, v-free-attr-value, chr(4) )
     2086             v-enable-db-num = no
     2087             .
     2088             if (is-ubd = yes
     2089             and p-cre-db-num > 0)
     2090             or (is-gbd = yes
     2091             and p-cre-db-num = 0)
     2092             then do:
     2093               assign
     2094               v-db-num-char = string (p-cre-db-num)
     2095               .
     2096             end.
     2097             else do:
     2098               undo, return error substitute("Задание &1 невыполнимо в БД &2", v-free-task-name, p-cre-db-num).
     2099             end.
     2100           end.
     2101           else do:
     2102             undo, return error return-value .
     2103           end.
     2104           if p-action = 'ИЗМЕНЕНИЕ':U then do:
     2105             assign
     2106               v-enable-db-num = no
     2107             .
     2108           end.
     2109         end.
     2110         otherwise do:
     2111           assign
     2112             v-db-num-char = "*":u
     2113             v-enable-db-num = yes
     2114           .
     2115           case p-task-type:
     2116             when 'autonws':U
     2117             then do:
     2118             end.
     2119             when 'mercury':U
     2120             then do:
     2121             end.
     2122             when 'hddtest':U
     2123             then do:
     2124             end.
     2125             when 'is_motp':U
     2126             then do:
     2127             end.
     2128             when 'is_diadoc':U
     2129             then do:
     2130             end.
     2131             otherwise do:
     2132               if p-action = 'ИЗМЕНЕНИЕ':U
     2133                 or p-action = 'КОПИРОВАНИЕ':U
     2134               then do:
     2135                 assign
     2136                   v-enable-db-num = yes
     2137                 .
     2138               end.
     2139             end.
     2140           end case.
     2141         end.
     2142       end case.
     2143       if p-action = 'ДОБАВЛЕНИЕ':U then do:
     2144         assign
     2145           tt_schedule.db-num-char = v-db-num-char.
     2146         .
     2147       end.
     2148     end.
     2149   END PROCEDURE.
     2150   PROCEDURE MyENable :
     2151   IF AVAILABLE tt_schedule THEN
     2152   DISPLAY
     2153   tt_schedule.db-num-char
     2154   tt_schedule.active
     2155   tt_schedule.task-year
     2156   tt_schedule.task-hour
     2157   tt_schedule.task-month
     2158   tt_schedule.task-minute
     2159   tt_schedule.task-day
     2160   tt_schedule.task-weekday
     2161   WITH FRAME sch-frame.
     2162   ENABLE
     2163   b-exit
     2164   b-quit
     2165   b-help
     2166   tt_schedule.db-num-char WHEN v-enable-db-num
     2167   tt_schedule.active
     2168   tt_schedule.task-year
     2169   tt_schedule.task-hour
     2170   tt_schedule.task-month
     2171   tt_schedule.task-minute
     2172   tt_schedule.task-day
     2173   tt_schedule.task-weekday
     2174   WITH FRAME sch-frame.
     2175   if p-task-type = 'autofree':U then do:
     2176     assign
     2177     frame sch-frame:title = v-free-task-name.
     2178   end.
     2179   VIEW FRAME sch-frame.
     2180   END PROCEDURE.
     2181   PROCEDURE proc-save :
     2182   do
     2183   on error undo, return error return-value
     2184   :
     2185     define buffer buf-chk_db            for ub.db .
     2186     define buffer buf-src_schedule-attr for ub.schedule-attr .
     2187     define buffer buf_schedule-attr     for ub.schedule-attr .
     2188     define variable v-tmp-int as integer   no-undo .
     2189     define variable v-today   as date      no-undo .
     2190     define variable v-time    as integer   no-undo .
     2191     define variable v-equal   as logical   no-undo .
     2192     define variable v-hour-str    as character no-undo .
     2193     define variable v-num-entries as integer   no-undo .
     2194     define variable v-ind         as integer   no-undo .
     2195     define variable v-hour-int    as integer   no-undo .
     2196     define variable v-hour-beg    as integer   no-undo .
     2197     define variable v-hour-end    as integer   no-undo .
     2198     define variable v-shift-num as integer no-undo .
     2199     define variable v-shift-date as date no-undo .
     2200     define buffer buf_shift-obj for ub.shift-obj .
     2201     run cur-time ( output v-today
     2202                 ,output v-time
     2203               ).
     2204     assign
     2205       tt_schedule.db-num-char  = trim( tt_schedule.db-num-char )
     2206       tt_schedule.task-year    = trim( tt_schedule.task-year )
     2207       tt_schedule.task-month   = trim( tt_schedule.task-month )
     2208       tt_schedule.task-day     = trim( tt_schedule.task-day )
     2209       tt_schedule.task-weekday = trim( tt_schedule.task-weekday )
     2210       tt_schedule.task-hour    = trim( tt_schedule.task-hour )
     2211       tt_schedule.task-minute  = trim( tt_schedule.task-minute )
     2212     .
     2213     if tt_schedule.db-num-char <> "*":U then do:
     2214       for each tt-val
     2215       on error undo, return error return-value
     2216       :
     2217         delete tt-val.
     2218       end.
     2219       run gbl/prcs-lst.p
     2220         ( input tt_schedule.db-num-char
     2221          ,input 0
     2222          ,input 99999
     2223          ,input true
     2224          ,input (buffer tt-val:handle)
     2225          ,input "t-val":U
     2226         ) no-error .
     2227       if error-status :error then do:
     2228         message
     2229           vss-workfile vss-revision vss-description skip
     2230           'Номер БД может быть только числовым или "*"!'
     2231           error-status :get-message(1) skip
     2232           return-value skip
     2233           view-as alert-box error .
     2234         apply "entry" to tt_schedule.db-num-char in frame sch-frame.
     2235         undo, return error .
     2236       end.
     2237       for each tt-val no-lock
     2238       on error undo, return error return-value
     2239       :
     2240         find first buf-chk_db no-lock
     2241           where buf-chk_db.db-num = tt-val.t-val
     2242           no-error
     2243         .
     2244         if not available buf-chk_db then do:
     2245           message vss-workfile vss-revision vss-description skip
     2246             "Нет БД с номером" tt-val.t-val
     2247             view-as alert-box error.
     2248           apply "entry" to tt_schedule.db-num-char in frame sch-frame.
     2249           undo, return error .
     2250         end.
     2251         if p-task-type = 'autofree':U
     2252         and buf-chk_db.db-num <> 0
     2253         and is-ubd = no
     2254         then do:
     2255           message
     2256           substitute("Для произвольного задания &1 можно задать расписание ТОЛЬКО для ГБД", v-free-task-name)
     2257           view-as alert-box error .
     2258           undo, return error.
     2259         end.
     2260         if p-task-type = 'autogcd':U then do:
     2261           if buf-chk_db.db-num <> buf_sys-ctrl.db-num then do:
     2262             message
     2263             "Для автоматического приема информации с касс можно задать расписание ТОЛЬКО для текущей БД"
     2264             view-as alert-box error .
     2265             undo, return error.
     2266           end.
     2267         end.
     2268         if p-task-type = 'autosale':U then do:
     2269         find first buf_sys-ctrl no-lock.
     2270         if buf-chk_db.db-num <> buf_sys-ctrl.db-num then do:
     2271             message
     2272             "Для автоматической обработки документов продаж можно задать расписание ТОЛЬКО для текущей БД"
     2273             view-as alert-box error .
     2274             undo, return error.
     2275           end.
     2276         end.
     2277         if p-task-type = 'autocbnk':U then do:
     2278         find first buf_sys-ctrl no-lock.
     2279         if buf-chk_db.db-num <> 0 then do:
     2280             message
     2281             "Для автоматической обработки документов продаж можно задать расписание ТОЛЬКО для ГБД"
     2282             view-as alert-box error .
     2283             undo, return error.
     2284           end.
     2285         end.
     2286       end.
     2287       if p-task-type = 'autooxml':U then do:
     2288         if buf-chk_db.db-num <> buf_sys-ctrl.db-num then do:
     2289           message
     2290           "Для работы системы OpenXML можно задать расписание ТОЛЬКО для текущей БД"
     2291           view-as alert-box error .
     2292           undo, return error.
     2293         end.
     2294       end.
     2295     end.
     2296     else do:
     2297       if p-task-type = 'autogcd':U
     2298       or p-task-type = 'autosale':U
     2299       or p-task-type = 'autooxml':U
     2300       then do:
     2301         message
     2302         "Для данного типа задач можно задать расписание только по текущей БД!"
     2303         view-as alert-box error .
     2304         undo, return error.
     2305       end.
     2306     end.
     2307     if tt_schedule.task-weekday <> "*":U then do:
     2308       for each tt-val
     2309       on error undo, return error return-value
     2310       :
     2311         delete tt-val.
     2312       end.
     2313       run gbl/prcs-lst.p
     2314         ( input tt_schedule.task-weekday
     2315          ,input 1
     2316          ,input 7
     2317          ,input true
     2318          ,input (buffer tt-val:handle)
     2319          ,input "t-val":U
     2320         ) no-error .
     2321       if error-status :error then do:
     2322         message
     2323           vss-workfile vss-revision vss-description skip
     2324           'Дни недели могут иметь только числовое значение в интервале от 1 до 7 или "*"!' skip
     2325           error-status :get-message(1) skip
     2326           return-value skip
     2327           view-as alert-box error .
     2328         apply "entry" to tt_schedule.task-weekday in frame sch-frame.
     2329         undo, return error .
     2330       end.
     2331     end.
     2332     if tt_schedule.task-weekday <> "*":U
     2333       and ( tt_schedule.task-year <> "*":U
     2334            or tt_schedule.task-month <> "*":U
     2335            or tt_schedule.task-day <> "*":U
     2336           )
     2337     then do:
     2338       message vss-workfile vss-revision vss-description skip
     2339         'Заданы дни недели, поэтому поля "год", "месяц" и "число" должны иметь значение "*"'
     2340         view-as alert-box error.
     2341       apply "entry" to tt_schedule.task-year in frame sch-frame.
     2342       undo, return error .
     2343     end.
     2344     if tt_schedule.task-year <> "*":U then do:
     2345       assign
     2346         v-tmp-int = integer( tt_schedule.task-year )
     2347         no-error
     2348       .
     2349       if error-status :error then do:
     2350         message vss-workfile vss-revision vss-description skip
     2351           'Год может быть только числовым или "*"!'
     2352           view-as alert-box error.
     2353         apply "entry" to tt_schedule.task-year in frame sch-frame.
     2354         undo, return error .
     2355       end.
     2356       if year( v-today ) > integer( tt_schedule.task-year ) then do:
     2357         message vss-workfile vss-revision vss-description skip
     2358           "Год не может быть меньше текущего!"
     2359           view-as alert-box error.
     2360         apply "entry" to tt_schedule.task-year in frame sch-frame.
     2361         undo, return error .
     2362       end.
     2363     end.
     2364     if tt_schedule.task-month <> "*":U then do:
     2365       assign
     2366         v-tmp-int = integer( tt_schedule.task-month )
     2367         no-error
     2368       .
     2369       if error-status :error then do:
     2370         message vss-workfile vss-revision vss-description skip
     2371           'Месяц может быть только числовым или "*"!'
     2372           view-as alert-box error.
     2373         apply "entry" to tt_schedule.task-month in frame sch-frame.
     2374         undo, return error .
     2375       end.
     2376       if integer( tt_schedule.task-month ) > 12
     2377         or integer( tt_schedule.task-month ) < 1
     2378       then do:
     2379         message vss-workfile vss-revision vss-description skip
     2380           "Месяц может быть только в интервале от 1 до 12 !"
     2381           view-as alert-box error.
     2382         apply "entry" to tt_schedule.task-month in frame sch-frame.
     2383         undo, return error .
     2384       end.
     2385     end.
     2386     if tt_schedule.task-day <> "*":U then do:
     2387       assign
     2388         v-tmp-int = integer( tt_schedule.task-day )
     2389         no-error
     2390       .
     2391       if error-status :error then do:
     2392         message vss-workfile vss-revision vss-description skip
     2393           'День месяца может быть только числовым или "*"!'
     2394           view-as alert-box error.
     2395         apply "entry" to tt_schedule.task-day in frame sch-frame.
     2396         undo, return error .
     2397       end.
     2398       if integer( tt_schedule.task-day ) > 31
     2399         or integer( tt_schedule.task-day ) < 1
     2400       then do:
     2401         message vss-workfile vss-revision vss-description skip
     2402           "День месяца может быть только в интервале от 1 до 31 !"
     2403           view-as alert-box error.
     2404         apply "entry" to tt_schedule.task-day in frame sch-frame.
     2405         undo, return error .
     2406       end.
     2407     end.
     2408     if tt_schedule.task-hour <> "*":U then do:
     2409       for each tt-val
     2410       on error undo, return error return-value
     2411       :
     2412         delete tt-val.
     2413       end.
     2414       run gbl/prcs-lst.p
     2415         ( input tt_schedule.task-hour
     2416          ,input 0
     2417          ,input 24
     2418          ,input true
     2419          ,input (buffer tt-val:handle)
     2420          ,input "t-val":U
     2421         ) no-error .
     2422       if error-status :error then do:
     2423         message
     2424           vss-workfile vss-revision vss-description skip
     2425           'Часы могут иметь только числовое значение в интервале от 0 до 24 или "*"!' skip
     2426           error-status :get-message(1) skip
     2427           return-value skip
     2428           view-as alert-box error .
     2429         apply "entry" to tt_schedule.task-hour in frame sch-frame.
     2430         undo, return error .
     2431       end.
     2432     end.
     2433     if tt_schedule.task-minute <> "*":U then do:
     2434       for each tt-val
     2435       on error undo, return error return-value
     2436       :
     2437         delete tt-val.
     2438       end.
     2439       run gbl/prcs-lst.p
     2440         ( input tt_schedule.task-minute
     2441          ,input 0
     2442          ,input 60
     2443          ,input true
     2444          ,input (buffer tt-val:handle)
     2445          ,input "t-val":U
     2446         ) no-error .
     2447       if error-status :error then do:
     2448         message
     2449           vss-workfile vss-revision vss-description skip
     2450           'Минуты могут иметь только числовое значение в интервале от 0 до 60 или "*"!' skip
     2451           error-status :get-message(1) skip
     2452           return-value skip
     2453           view-as alert-box error .
     2454         apply "entry" to tt_schedule.task-minute in frame sch-frame.
     2455         undo, return error .
     2456       end.
     2457     end.
     2458     if not available buf_schedule then do:
     2459       create buf_schedule.
     2460       assign
     2461         buf_schedule.cre-db-num = p-cre-db-num
     2462         buf_schedule.task-type  = p-task-type
     2463         buf_schedule.task-num   = next-value( s-task-num, ub )
     2464       .
     2465     end.
     2466     buffer-compare tt_schedule TO buf_schedule save result in v-equal no-error.
     2467     if not v-equal then do:
     2468       buffer-copy tt_schedule except cre-db-num task-type task-num TO buf_schedule.
     2469       assign
     2470         p-modify = true
     2471       .
     2472     end.
     2473     if p-action = 'КОПИРОВАНИЕ':U then do:
     2474       for each buf-src_schedule-attr no-lock
     2475         where buf-src_schedule-attr.cre-db-num  = buf-src_schedule.cre-db-num
     2476           and buf-src_schedule-attr.task-type   = buf-src_schedule.task-type
     2477           and buf-src_schedule-attr.task-num    = buf-src_schedule.task-num
     2478       on error undo, return error
     2479       :
     2480         find first buf_schedule-attr exclusive-lock
     2481           where buf_schedule-attr.cre-db-num = buf_schedule.cre-db-num
     2482             and buf_schedule-attr.task-type  = buf_schedule.task-type
     2483             and buf_schedule-attr.task-num   = buf_schedule.task-num
     2484             and buf_schedule-attr.attr-code  = buf-src_schedule-attr.attr-code
     2485           no-error .
     2486         if not available buf_schedule-attr then do:
     2487           create buf_schedule-attr .
     2488         end.
     2489         buffer-copy buf-src_schedule-attr to buf_schedule-attr
     2490           assign
     2491             buf_schedule-attr.cre-db-num = buf_schedule.cre-db-num
     2492             buf_schedule-attr.task-type  = buf_schedule.task-type
     2493             buf_schedule-attr.task-num   = buf_schedule.task-num
     2494           .
     2495       end.
     2496     end.
     2497     if p-task-type = 'autofree':U then do:
     2498       run schedule-attr-write in this-procedure
     2499         ( input buf_schedule.cre-db-num
     2500          ,input p-task-type
     2501          ,input buf_schedule.task-num
     2502          ,input ('schd-free-id':U + chr(4) + v-free-id)
     2503          ,input v-free-attr-value
     2504         ).
     2505     end.
     2506     assign
     2507       p-recid = recid( buf_schedule )
     2508     .
     2509     for each tt-val
     2510     on error undo, return error return-value
     2511     :
     2512       delete tt-val.
     2513     end.
     2514     v-shift-num = 0 .
     2515     v-shift-date = ? .
     2516     for first buf_shift-obj
     2517         where buf_shift-obj.obj-type = v-cntxt-obj-type
     2518           and buf_shift-obj.obj-code = v-cntxt-obj-code
     2519           and buf_shift-obj.status_ = 'тек':U
     2520         use-index stts :
     2521       assign
     2522         v-shift-date = buf_shift-obj.shift-date
     2523         v-shift-num  = buf_shift-obj.shift-num
     2524       .
     2525     end.
     2526     if v-shift-date = ? then v-shift-date = today .
     2527     run trg/userlog.p (
     2528             input 'schedule'
     2529           , input ("Изменение расписания автозаданий на объекте " +
     2530                   v-cntxt-obj-type + string(v-cntxt-obj-code) + ";" +
     2531                   buf_schedule.task-type + ";" +
     2532                   (if buf_schedule.task-type = 'autofree':U then v-free-id else "0") + ";" +
     2533                     string(buf_schedule.task-num) + "|" +
     2534                     (if buf_schedule.active then "1" else "0") + "|" +
     2535                     buf_schedule.task-year + "|" +
     2536                     buf_schedule.task-month + "|" +
     2537                     buf_schedule.task-day + "|" +
     2538                     buf_schedule.task-weekday + "|" +
     2539                     buf_schedule.task-hour + "|" +
     2540                     buf_schedule.task-minute +
     2541                   chr(3) +
     2542                   v-cntxt-obj-type + chr(6) +
     2543                   string(v-cntxt-obj-code) + chr(6) +
     2544                   string(v-shift-date) + chr(6) +
     2545                   string(v-shift-num) + chr(6) +
     2546                   buf_schedule.task-type + chr(6) +
     2547                   (if buf_schedule.task-type = 'autofree':U then v-free-id else "0") + chr(6) +
     2548                   string(buf_schedule.task-num) + chr(6) +
     2549                   (if buf_schedule.active then "1" else "0") + chr(6) +
     2550                   buf_schedule.task-year + chr(6) +
     2551                   buf_schedule.task-month + chr(6) +
     2552                   buf_schedule.task-day + chr(6) +
     2553                   buf_schedule.task-weekday + chr(6) +
     2554                   buf_schedule.task-hour + chr(6) +
     2555                   buf_schedule.task-minute + chr(6) +
     2556                   "chg" + chr(6) +
     2557                   buf_schedule.db-num-char )
     2558           , input ?
     2559           , input ?
     2560           , input ""
     2561           ) no-error.
     2562     if error-status :error
     2563     then do:
     2564         message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     2565     end.
     2566   end.
     2567   END PROCEDURE.
