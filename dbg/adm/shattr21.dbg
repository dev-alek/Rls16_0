      965        t-unq-artc AT ROW 8.04 COL 2 WIDGET-ID 118
      966        t-is-scgb AT ROW 9.25 COL 2 WIDGET-ID 120
      967        f-shema-foto AT ROW 10.5 COL 27.13 COLON-ALIGNED WIDGET-ID 122
      968        f-dfltggrp AT ROW 12.75 COL 22.25 COLON-ALIGNED WIDGET-ID 22
      969        B-dfltggrp AT ROW 12.75 COL 33.5 WIDGET-ID 24
      970        f-grp-name AT ROW 12.75 COL 35.25 COLON-ALIGNED NO-LABEL WIDGET-ID 68
      971        rs-gdsoattr AT ROW 15.54 COL 2 NO-LABEL WIDGET-ID 28
      972        rs-gdshattr AT ROW 15.54 COL 34 NO-LABEL WIDGET-ID 34
      973        rs-fgdsobj AT ROW 15.54 COL 66 NO-LABEL WIDGET-ID 40
      974        rs-s-coeff AT ROW 19.79 COL 2 NO-LABEL WIDGET-ID 46
      975        rs-gds-prop AT ROW 19.79 COL 34 NO-LABEL WIDGET-ID 52
      976        rs-gds-attr AT ROW 19.79 COL 66 NO-LABEL WIDGET-ID 58
      977        rs-add-prop AT ROW 24.29 COL 2 NO-LABEL WIDGET-ID 106
      978        FILL-IN-3 AT ROW 14.04 COL 2 NO-LABEL WIDGET-ID 70
      979        l-gds-obj-attr AT ROW 14.79 COL 2.5 NO-LABEL WIDGET-ID 94
      980        l-gds-host-attr AT ROW 14.79 COL 35 NO-LABEL WIDGET-ID 96
      981        l-fbr-gds-obj AT ROW 14.79 COL 67 NO-LABEL WIDGET-ID 98
      982        l-s-coeff AT ROW 19.04 COL 2 NO-LABEL WIDGET-ID 100
      983        l-gds-prop AT ROW 19.04 COL 35 NO-LABEL WIDGET-ID 102
      984        l-goods-attr AT ROW 19.04 COL 67 NO-LABEL WIDGET-ID 104
      985        l-add-prop AT ROW 23.5 COL 2 NO-LABEL WIDGET-ID 112
      986        RECT-1 AT ROW 12.25 COL 1.5 WIDGET-ID 64
      987        SPACE(0.24) SKIP(0.70)
      988       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      989            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      990            TITLE "Набор опций работы со справочниками товаров"
      991            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      992   ASSIGN
      993          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      994          FRAME Dialog-Frame:HIDDEN           = TRUE.
      995   ASSIGN
      996          f-dfltggrp:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      997   ASSIGN
      998          f-grp-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      999   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1000   DO:
     1001     APPLY "END-ERROR":U TO SELF.
     1002   END.
     1003   ON CHOOSE OF B-dfltggrp IN FRAME Dialog-Frame
     1004   DO:
     1005   DEFINE VARIABLE v-grp AS INTEGER NO-UNDO.
     1006   define variable v-rid-list as character no-undo .
     1007   define variable glog as logical no-undo .
     1008   define buffer buf_gds-grp for ub.gds-grp.
     1009   IF f-dfltggrp <> -1  THEN DO:
     1010     v-grp = f-dfltggrp.
     1011   END.
     1012   find first buf_gds-grp no-lock where
     1013            buf_gds-grp.node-code = v-grp no-error.
     1014   if available buf_gds-grp then do:
     1015     v-rid-list = string(recid(buf_gds-grp)).
     1016   end.
     1017       run ref/gds-grp.w (
     1018                     input parparentproc
     1019                   , input ('терм':U + ',b-sel')
     1020                   , input p-obj-type
     1021                   , input p-obj-code
     1022                   , input-output v-rid-list) NO-ERROR.
     1023   IF NOT ERROR-STATUS:ERROR
     1024   and v-rid-list <> '':U
     1025   THEN DO:
     1026     find first buf_gds-grp no-lock where
     1027               recid(buf_gds-grp) = integer(v-rid-list) no-error.
     1028     if available buf_gds-grp then do:
     1029       f-dfltggrp = buf_gds-grp.node-code.
     1030     end.
     1031     RUN set-full-grp-name IN THIS-PROCEDURE ( INPUT f-dfltggrp) .
     1032   END.
     1033   if error-status:error
     1034   or v-rid-list = '':U then do:
     1035     message
     1036     "Хотите УБРАТЬ ЗАДАНИЕ ГРУППЫ ПО УМОЛЧАНИЮ?"
     1037     view-as alert-box question buttons yes-no update glog.
     1038     if glog then do:
     1039       f-dfltggrp = -1.
     1040       RUN set-full-grp-name IN THIS-PROCEDURE ( INPUT f-dfltggrp) .
     1041     end.
     1042   end.
     1043   END.
     1044   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1045   DO:
     1046     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1047     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1048   END.
     1049   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1050   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1051   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1052   on help of frame Dialog-Frame
     1053   do:
     1054     run gbl/app_help.p
     1055       (input this-procedure :file-name
     1056       ,input ''
     1057       ,input ?
     1058       ) no-error.
     1059     if error-status :error then do:
     1060       message
     1061         "Ошибка при вызове помощи"
     1062         error-status :get-message(1)
     1063         view-as alert-box .
     1064     end.
     1065   end.
     1066   run minbtn-set in this-procedure .
     1067   on choose of b-help in frame Dialog-Frame
     1068   do:
     1069     apply "help":u to frame Dialog-Frame .
     1070   end.
     1071   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1072   procedure minbtn-set :
     1073       do
     1074           on error undo, return error return-value
     1075           :
     1076           define variable ii              as integer       no-undo .
     1077           define variable fh              as widget-handle no-undo .
     1078           define variable hh              as widget-handle no-undo .
     1079           define variable v-h             as handle        extent 4 no-undo .
     1080           define variable v-name-button   as character     no-undo .
     1081           define variable v-help-old-x    as decimal       no-undo .
     1082           define variable v-help-old-y    as decimal       no-undo .
     1083           define variable v-help-old-size as decimal       no-undo .
     1084           define variable v-frame-width   as decimal       no-undo .
     1085           define variable jj              as integer       no-undo .
     1086           do
     1087               on error undo, return error
     1088               :
     1089               assign
     1090                   v-frame-width = frame Dialog-Frame:width - 0.3
     1091                   fh            = frame Dialog-Frame:first-child
     1092                   hh            = fh:first-child
     1093                   ii            = 1
     1094                   .
     1095               do while valid-handle(hh):
     1096                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1097                   do:
     1098                       case lc(hh:name) :
     1099                           when "b-help" then
     1100                               do:
     1101                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1102                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1103                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1104                                   hh:TOOLTIP = "Помощь" .
     1105                                   v-help-old-x = hh:column .
     1106                                   v-help-old-y = hh:row    .
     1107                                   v-help-old-size = hh:width .
     1108                                   hh:width-chars = 2.5 .
     1109                               end.
     1110                           when "b-print" then
     1111                               do:
     1112                                   hh:load-image("cmp/b-print.bmp":u) .
     1113                                   hh:TOOLTIP = "Печать" .
     1114                                   v-h[ii] = hh:handle .
     1115                                   ii = ii + 1 .
     1116                                   hh:width-chars = 3 .
     1117                               end.
     1118                           when "b-history" or
     1119                           when "b-hist" then
     1120                               do:
     1121                                   hh:load-image("cmp/b-hist.bmp":u) .
     1122                                   hh:TOOLTIP = "История" .
     1123                                   v-h[ii] = hh:handle .
     1124                                   ii = ii + 1 .
     1125                                   hh:width-chars = 3 .
     1126                               end.
     1127                           when "b-sch" then
     1128                               do:
     1129                                   hh:load-image("cmp/b-sch.bmp":u) .
     1130                                   hh:TOOLTIP = "Установка Фильтра" .
     1131                                   v-h[ii] = hh:handle .
     1132                                   ii = ii + 1 .
     1133                                   hh:width-chars = 3 .
     1134                               end.
     1135                           when "b-hist-user" then
     1136                               do:
     1137                                   hh:load-image("cmp/b-hist.bmp":u) .
     1138                                   hh:TOOLTIP = "История пользователя" .
     1139                                   ii = ii + 1 .
     1140                               end.
     1141                       end case.
     1142                   end.
     1143                   hh = hh:next-sibling.
     1144               end.
     1145               b-help:column = v-frame-width - b-help:width-chars.
     1146               jj = 0.
     1147               repeat ii = 4 to 1 by -1 :
     1148                   if valid-handle (v-h[ii] ) then
     1149                   do:
     1150                       jj  = jj + 1 .
     1151                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1152                       v-h[ii]:row    = v-help-old-y .
     1153                   end.
     1154               end.
     1155           end.
     1156       end.
     1157   end procedure.
     1158   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1159   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1160   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1161   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1162   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1163   define variable v-diasize-current-frame-height as decimal   no-undo .
     1164   define variable v-diasize-change-size          as logical   no-undo .
     1165   define variable v-diasize-resize-button        as handle    no-undo .
     1166   define variable v-diasize-wndmax               as logical   no-undo .
     1167   define variable v-diasize-wndstore             as logical   no-undo .
     1168   define variable v-diasize-proc-name            as character no-undo .
     1169   define variable v-diasize-browse-handle        as handle    no-undo .
     1170   define variable v-diasize-browse-number        as integer   no-undo .
     1171   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1172   define temp-table temp-diasize-handle no-undo
     1173     field handle-value  as handle
     1174     field save-position as decimal
     1175     index xpk is primary unique handle-value
     1176     .
     1177   define temp-table temp-browse-handle no-undo
     1178     field browse-type   as character
     1179     field browse-number as integer
     1180     field browse-handle as handle
     1181     field original-size as decimal
     1182     index xpk is primary unique browse-type browse-number
     1183     index xie browse-type browse-handle
     1184   .
     1185   procedure diasize_change-height :
     1186     define input  parameter p-change-value  as decimal   no-undo .
     1187     define input  parameter p-move-resize   as logical   no-undo .
     1188     define variable v-field-group-handle    as handle    no-undo .
     1189     define variable v-object-handle         as handle    no-undo .
     1190     define variable v-frame-height          as decimal   no-undo .
     1191     define variable v-frame-virtual-height  as decimal   no-undo .
     1192     define variable v-browse-height         as decimal   no-undo .
     1193     define variable v-window-height         as decimal   no-undo .
     1194     define variable v-window-virtual-height as decimal   no-undo .
     1195     define variable v-change-sign           as integer   no-undo .
     1196     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1197     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1198     if p-change-value > 0
     1199     then do:
     1200       if frame Dialog-Frame :height + p-change-value
     1201           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1202       then do:
     1203         assign
     1204           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1205                           - (frame Dialog-Frame :height-chars)
     1206         .
     1207         if p-change-value <= 0
     1208         then do:
     1209           run diasize_position-resize-button in this-procedure .
     1210           return .
     1211         end.
     1212       end.
     1213     end.
     1214     if p-change-value < 0
     1215     then do:
     1216       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1217       then do:
     1218         assign
     1219           p-change-value = v-diasize-orig-frame-height
     1220                          - (frame Dialog-Frame :height-chars)
     1221         .
     1222         if p-change-value >= 0
     1223         then do:
     1224           run diasize_position-resize-button in this-procedure .
     1225           return .
     1226         end.
     1227       end.
     1228     end.
     1229     if p-change-value >= 0
     1230     then do:
     1231       assign
     1232         v-change-sign = 1
     1233       .
     1234     end.
     1235     else do:
     1236       assign
     1237         v-change-sign = -1
     1238       .
     1239     end.
     1240     assign
     1241       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1242     .
     1243     if p-change-value = 0
     1244     then do:
     1245       run diasize_position-resize-button in this-procedure .
     1246       return .
     1247     end.
     1248     move_block:
     1249     do
     1250     on error undo move_block, retry move_block
     1251     :
     1252       if retry
     1253       then do:
     1254         do
     1255         on error undo move_block, leave move_block
     1256         :
     1257           if p-change-value > 0
     1258           then do:
     1259             for each buf_temp-diasize-handle
     1260             on error undo, next
     1261             :
     1262               assign
     1263                 v-object-handle = buf_temp-diasize-handle.handle-value
     1264               .
     1265               if v-object-handle <> v-diasize-resize-button
     1266               then do:
     1267                 assign
     1268                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1269                 .
     1270               end.
     1271             end.
     1272             assign
     1273               v-diasize-browse-handle :height = v-browse-height
     1274             .
     1275             for each buf_temp-browse-handle
     1276               where buf_temp-browse-handle.browse-type = 'height':u
     1277             on error undo, next
     1278             :
     1279               assign
     1280                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1281               .
     1282             end.
     1283             assign
     1284               frame Dialog-Frame :height = v-frame-height
     1285             .
     1286             if frame Dialog-Frame :scrollable = true
     1287             then do:
     1288               assign
     1289                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1290               .
     1291             end.
     1292             run diasize_position-resize-button in this-procedure .
     1293           end.
     1294           else do:
     1295             if frame Dialog-Frame :scrollable = true
     1296             then do:
     1297               assign
     1298                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1299               .
     1300             end.
     1301             assign
     1302               frame Dialog-Frame :height = v-frame-height
     1303             .
     1304             assign
     1305               v-diasize-browse-handle :height = v-browse-height
     1306             .
     1307             for each buf_temp-browse-handle
     1308               where buf_temp-browse-handle.browse-type = 'height':u
     1309             on error undo, next
     1310             :
     1311               assign
     1312                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1313               .
     1314             end.
     1315             for each buf_temp-diasize-handle
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 v-object-handle = buf_temp-diasize-handle.handle-value
     1320               .
     1321               if v-object-handle <> v-diasize-resize-button
     1322               then do:
     1323                 assign
     1324                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1325                 .
     1326               end.
     1327             end.
     1328             run diasize_position-resize-button in this-procedure .
     1329           end.
     1330           assign
     1331             v-diasize-change-size = false
     1332           .
     1333           leave move_block .
     1334         end.
     1335       end.
     1336       assign
     1337         v-diasize-need-full-display = true
     1338       .
     1339       if v-diasize-change-size = false
     1340       then do:
     1341         assign
     1342           v-diasize-change-size = true
     1343         .
     1344       end.
     1345       else do:
     1346         return .
     1347       end.
     1348       assign
     1349         v-frame-height = frame Dialog-Frame :height
     1350         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1351         v-browse-height = v-diasize-browse-handle :height
     1352       .
     1353       for each buf_temp-browse-handle
     1354         where buf_temp-browse-handle.browse-type = 'height':u
     1355       :
     1356         assign
     1357           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1358         .
     1359       end.
     1360       for each buf_temp-diasize-handle
     1361       :
     1362         delete buf_temp-diasize-handle .
     1363       end.
     1364       assign
     1365         v-field-group-handle = frame Dialog-Frame :first-child
     1366       .
     1367       do while valid-handle(v-field-group-handle)
     1368       :
     1369         assign
     1370           v-object-handle = v-field-group-handle :first-child
     1371         .
     1372         do while valid-handle(v-object-handle)
     1373         :
     1374           if  v-object-handle <> v-diasize-browse-handle :handle
     1375           and can-query(v-object-handle, "row")
     1376           and can-query(v-object-handle, "height")
     1377           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1378           then do:
     1379             find first buf_temp-browse-handle
     1380               where buf_temp-browse-handle.browse-type   = 'height':u
     1381                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1382               no-error .
     1383             if available buf_temp-browse-handle
     1384             then do:
     1385             end.
     1386             else do:
     1387               create buf_temp-diasize-handle .
     1388               assign
     1389                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1390                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1391               .
     1392             end.
     1393           end.
     1394           assign
     1395             v-object-handle = v-object-handle :next-sibling
     1396           .
     1397         end.
     1398         assign
     1399           v-field-group-handle = v-field-group-handle :next-sibling
     1400         .
     1401       end.
     1402       do with frame Dialog-Frame
     1403       :
     1404         hide v-diasize-resize-button .
     1405         assign
     1406           v-diasize-resize-button :row    = 1
     1407           v-diasize-resize-button :column = 1
     1408         .
     1409       end.
     1410       if p-change-value > 0
     1411       then do:
     1412         if frame Dialog-Frame :scrollable = true
     1413         then do:
     1414           assign
     1415             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1416             no-error .
     1417           if error-status :error
     1418           or error-status :get-message(1) <> ""
     1419           then do:
     1420             undo move_block, retry move_block .
     1421           end.
     1422         end.
     1423         assign
     1424           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1425           no-error .
     1426         if error-status :error
     1427         or error-status :get-message(1) <> ""
     1428         then do:
     1429           undo move_block, retry move_block .
     1430         end.
     1431         assign
     1432           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1433           no-error .
     1434         if error-status :error
     1435         or error-status :get-message(1) <> ""
     1436         then do:
     1437           undo move_block, retry move_block .
     1438         end.
     1439         for each buf_temp-browse-handle
     1440           where buf_temp-browse-handle.browse-type = 'height':u
     1441         on error undo move_block, retry move_block
     1442         :
     1443           assign
     1444             buf_temp-browse-handle.browse-handle :height
     1445               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1446             no-error .
     1447           if error-status :error
     1448           or error-status :get-message(1) <> ""
     1449           then do:
     1450             undo move_block, retry move_block .
     1451           end.
     1452         end.
     1453         for each buf_temp-diasize-handle
     1454         on error undo move_block, retry move_block
     1455         :
     1456           assign
     1457             v-object-handle = buf_temp-diasize-handle.handle-value
     1458           .
     1459           if v-object-handle <> v-diasize-resize-button
     1460           then do:
     1461             assign
     1462               v-object-handle :row = v-object-handle :row + p-change-value
     1463               no-error .
     1464             if error-status :error
     1465             or error-status :get-message(1) <> ""
     1466             then do:
     1467               undo move_block, retry move_block .
     1468             end.
     1469           end.
     1470         end.
     1471       end.
     1472       else do:
     1473         for each buf_temp-diasize-handle
     1474         on error undo move_block, retry move_block
     1475         :
     1476           assign
     1477             v-object-handle = buf_temp-diasize-handle.handle-value
     1478           .
     1479           if v-object-handle <> v-diasize-resize-button
     1480           then do:
     1481             assign
     1482               v-object-handle :row = v-object-handle :row + p-change-value
     1483               no-error .
     1484             if error-status :error
     1485             or error-status :get-message(1) <> ""
     1486             then do:
     1487               undo move_block, retry move_block .
     1488             end.
     1489           end.
     1490         end.
     1491         assign
     1492           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1493           no-error .
     1494         if error-status :error
     1495         or error-status :get-message(1) <> ""
     1496         then do:
     1497           undo move_block, retry move_block .
     1498         end.
     1499         for each buf_temp-browse-handle
     1500           where buf_temp-browse-handle.browse-type = 'height':u
     1501         on error undo move_block, retry move_block
     1502         :
     1503           assign
     1504             buf_temp-browse-handle.browse-handle :height
     1505               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1506             no-error .
     1507           if error-status :error
     1508           or error-status :get-message(1) <> ""
     1509           then do:
     1510             undo move_block, retry move_block .
     1511           end.
     1512         end.
     1513         assign
     1514           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1515           no-error .
     1516         if error-status :error
     1517         or error-status :get-message(1) <> ""
     1518         then do:
     1519           undo move_block, retry move_block .
     1520         end.
     1521         if frame Dialog-Frame :scrollable = true
     1522         then do:
     1523           assign
     1524             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1525             no-error .
     1526           if error-status :error
     1527           or error-status :get-message(1) <> ""
     1528           then do:
     1529             undo move_block, retry move_block .
     1530           end.
     1531         end.
     1532       end.
     1533       if p-move-resize = true
     1534       then do:
     1535         run diasize_position-resize-button in this-procedure .
     1536       end.
     1537       if v-diasize-wndstore = true
     1538       then do:
     1539         if connected("ub") = true
     1540         then do:
     1541           define variable v-cntxt-db-num        as integer   no-undo .
     1542           define variable v-cntxt-userid        as character no-undo .
     1543           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1544                                             , OUTPUT v-cntxt-userid
     1545                                             ) .
     1546           run gbl/wndsizew.p
     1547             (input  v-cntxt-db-num
     1548             ,input  v-cntxt-userid
     1549             ,input  v-diasize-proc-name
     1550             ,input  'height':u
     1551             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1552             ) .
     1553         end.
     1554       end.
     1555     end.
     1556     assign
     1557       v-diasize-change-size = false
     1558     .
     1559   end procedure.
     1560   procedure diasize_set-height :
     1561     define input  parameter p-new-height  as decimal   no-undo .
     1562     define input  parameter p-move-resize as logical   no-undo .
     1563     do
     1564     on error undo, return error return-value
     1565     :
     1566       run diasize_change-height in this-procedure
     1567         (input  (p-new-height - frame Dialog-Frame :height)
     1568         ,input  p-move-resize
     1569         ) .
     1570     end.
     1571   end procedure.
     1572   procedure diasize_change-width :
     1573     define input  parameter p-change-value as decimal   no-undo .
     1574     define input  parameter p-move-resize  as logical   no-undo .
     1575     define variable v-field-group-handle   as handle    no-undo .
     1576     define variable v-object-handle        as handle    no-undo .
     1577     define variable v-frame-width          as decimal   no-undo .
     1578     define variable v-frame-virtual-width  as decimal   no-undo .
     1579     define variable v-browse-width         as decimal   no-undo .
     1580     define variable v-window-width         as decimal   no-undo .
     1581     define variable v-window-virtual-width as decimal   no-undo .
     1582     define variable v-change-sign          as integer   no-undo .
     1583     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1584     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1585     if p-change-value > 0
     1586     then do:
     1587       if frame Dialog-Frame :width + p-change-value >
     1588           session :width-chars
     1589       then do:
     1590         assign
     1591           p-change-value = session :width-chars - frame Dialog-Frame :width
     1592         .
     1593         if p-change-value <= 0
     1594         then do:
     1595           run diasize_position-resize-button in this-procedure .
     1596           return .
     1597         end.
     1598       end.
     1599     end.
     1600     if p-change-value < 0
     1601     then do:
     1602       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1603       then do:
     1604         assign
     1605           p-change-value = v-diasize-orig-frame-width
     1606                          - frame Dialog-Frame :width
     1607         .
     1608         if p-change-value >= 0
     1609         then do:
     1610           run diasize_position-resize-button in this-procedure .
     1611           return .
     1612         end.
     1613       end.
     1614     end.
     1615     if p-change-value >= 0
     1616     then do:
     1617       assign
     1618         v-change-sign = 1
     1619       .
     1620     end.
     1621     else do:
     1622       assign
     1623         v-change-sign = -1
     1624       .
     1625     end.
     1626     assign
     1627       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1628     .
     1629     if p-change-value = 0
     1630     then do:
     1631       run diasize_position-resize-button in this-procedure .
     1632       return .
     1633     end.
     1634     move_block:
     1635     do
     1636     on error undo move_block, leave move_block
     1637     :
     1638       if retry
     1639       then do:
     1640         do
     1641         on error undo move_block, leave move_block
     1642         :
     1643           if p-change-value > 0
     1644           then do:
     1645             for each buf_temp-diasize-handle
     1646             on error undo, next
     1647             :
     1648               assign
     1649                 v-object-handle = buf_temp-diasize-handle.handle-value
     1650               .
     1651               if v-object-handle <> v-diasize-resize-button
     1652               then do:
     1653                 assign
     1654                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1655                 .
     1656               end.
     1657             end.
     1658             assign
     1659               v-diasize-browse-handle :width = v-browse-width
     1660             .
     1661             for each buf_temp-browse-handle
     1662               where buf_temp-browse-handle.browse-type = 'width':u
     1663             on error undo, next
     1664             :
     1665               assign
     1666                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1667               .
     1668             end.
     1669             assign
     1670               frame Dialog-Frame :width = v-frame-width
     1671             .
     1672             if frame Dialog-Frame :scrollable = true
     1673             then do:
     1674               assign
     1675                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1676               .
     1677             end.
     1678             run diasize_position-resize-button in this-procedure .
     1679           end.
     1680           else do:
     1681             if frame Dialog-Frame :scrollable = true
     1682             then do:
     1683               assign
     1684                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1685               .
     1686             end.
     1687             assign
     1688               frame Dialog-Frame :width = v-frame-width
     1689             .
     1690             for each buf_temp-browse-handle
     1691               where buf_temp-browse-handle.browse-type = 'width':u
     1692             on error undo, next
     1693             :
     1694               assign
     1695                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1696               .
     1697             end.
     1698             assign
     1699               v-diasize-browse-handle :width = v-browse-width
     1700             .
     1701             for each buf_temp-diasize-handle
     1702             on error undo, next
     1703             :
     1704               assign
     1705                 v-object-handle = buf_temp-diasize-handle.handle-value
     1706               .
     1707               if v-object-handle <> v-diasize-resize-button
     1708               then do:
     1709                 assign
     1710                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1711                 .
     1712               end.
     1713             end.
     1714             run diasize_position-resize-button in this-procedure .
     1715           end.
     1716           assign
     1717             v-diasize-change-size = false
     1718           .
     1719           leave move_block .
     1720         end.
     1721       end.
     1722       assign
     1723         v-diasize-need-full-display = true
     1724       .
     1725       if v-diasize-change-size = false
     1726       then do:
     1727         assign
     1728           v-diasize-change-size = true
     1729         .
     1730       end.
     1731       else do:
     1732         return .
     1733       end.
     1734       assign
     1735         v-frame-width = frame Dialog-Frame :width
     1736         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1737         v-browse-width = v-diasize-browse-handle :width
     1738       .
     1739       for each buf_temp-browse-handle
     1740         where buf_temp-browse-handle.browse-type = 'width':u
     1741       :
     1742         assign
     1743           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1744         .
     1745       end.
     1746       for each buf_temp-diasize-handle
     1747       :
     1748         delete buf_temp-diasize-handle .
     1749       end.
     1750       assign
     1751         v-field-group-handle = frame Dialog-Frame :first-child
     1752       .
     1753       do while valid-handle(v-field-group-handle)
     1754       :
     1755         assign
     1756           v-object-handle = v-field-group-handle :first-child
     1757         .
     1758         do while valid-handle(v-object-handle)
     1759         :
     1760           if  v-object-handle <> v-diasize-browse-handle :handle
     1761           and v-object-handle <> v-diasize-resize-button
     1762           and can-query(v-object-handle, "row")
     1763           and can-query(v-object-handle, "height")
     1764           and ( v-object-handle :col + v-object-handle :width
     1765                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1766               )
     1767           then do:
     1768             find first buf_temp-browse-handle
     1769               where buf_temp-browse-handle.browse-type   = 'width':u
     1770                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1771               no-error .
     1772             if available buf_temp-browse-handle
     1773             then do:
     1774             end.
     1775             else do:
     1776               create buf_temp-diasize-handle .
     1777               assign
     1778                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1779                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1780               .
     1781             end.
     1782           end.
     1783           assign
     1784             v-object-handle = v-object-handle :next-sibling
     1785           .
     1786         end.
     1787         assign
     1788           v-field-group-handle = v-field-group-handle :next-sibling
     1789         .
     1790       end.
     1791       do with frame Dialog-Frame
     1792       :
     1793         hide v-diasize-resize-button .
     1794         v-diasize-resize-button :row = 1.
     1795         v-diasize-resize-button :column = 1.
     1796       end.
     1797       if p-change-value > 0
     1798       then do:
     1799         if frame Dialog-Frame :scrollable = true
     1800         then do:
     1801           assign
     1802             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1803             no-error .
     1804           if error-status :error
     1805           or error-status :get-message(1) <> ""
     1806           then do:
     1807             undo move_block, retry move_block.
     1808           end.
     1809         end.
     1810         assign
     1811           frame Dialog-Frame :width = v-frame-width + p-change-value
     1812           no-error .
     1813         if error-status :error
     1814         or error-status :get-message(1) <> ""
     1815         then do:
     1816           undo move_block, retry move_block.
     1817         end.
     1818         assign
     1819           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1820         no-error .
     1821         if error-status :error
     1822         or error-status :get-message(1) <> ""
     1823         then do:
     1824           undo move_block, retry move_block.
     1825         end.
     1826         for each buf_temp-browse-handle
     1827           where buf_temp-browse-handle.browse-type = 'width':u
     1828         on error undo move_block, retry move_block
     1829         :
     1830           assign
     1831             buf_temp-browse-handle.browse-handle :width
     1832               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1833             no-error .
     1834           if error-status :error
     1835           or error-status :get-message(1) <> ""
     1836           then do:
     1837             undo move_block, retry move_block .
     1838           end.
     1839         end.
     1840         for each buf_temp-diasize-handle
     1841         on error undo move_block, retry move_block
     1842         :
     1843           assign
     1844             v-object-handle = buf_temp-diasize-handle.handle-value
     1845           .
     1846           if v-object-handle <> v-diasize-resize-button
     1847           then do:
     1848             assign
     1849               v-object-handle :col = v-object-handle :col + p-change-value
     1850               no-error .
     1851             if error-status :error
     1852             or error-status :get-message(1) <> ""
     1853             then do:
     1854               undo move_block, retry move_block .
     1855             end.
     1856           end.
     1857         end.
     1858       end.
     1859       else do:
     1860         for each buf_temp-diasize-handle
     1861         on error undo move_block, retry move_block
     1862         :
     1863           assign
     1864             v-object-handle = buf_temp-diasize-handle.handle-value
     1865           .
     1866           if v-object-handle <> v-diasize-resize-button
     1867           then do:
     1868             assign
     1869               v-object-handle :col = v-object-handle :col + p-change-value
     1870               no-error .
     1871             if error-status :error
     1872             or error-status :get-message(1) <> ""
     1873             then do:
     1874               undo move_block, retry move_block .
     1875             end.
     1876           end.
     1877         end.
     1878         for each buf_temp-browse-handle
     1879           where buf_temp-browse-handle.browse-type = 'width':u
     1880         on error undo move_block, retry move_block
     1881         :
     1882           assign
     1883             buf_temp-browse-handle.browse-handle :width
     1884               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1885             no-error .
     1886           if error-status :error
     1887           or error-status :get-message(1) <> ""
     1888           then do:
     1889             undo move_block, retry move_block .
     1890           end.
     1891         end.
     1892         assign
     1893           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1894           no-error .
     1895         if error-status :error
     1896         or error-status :get-message(1) <> ""
     1897         then do:
     1898           undo move_block, retry move_block.
     1899         end.
     1900         assign
     1901           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1902         no-error .
     1903         if error-status :error
     1904         or error-status :get-message(1) <> ""
     1905         then do:
     1906           undo move_block, retry move_block.
     1907         end.
     1908         if frame Dialog-Frame :scrollable = true
     1909         then do:
     1910           assign
     1911             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1912           no-error .
     1913           if error-status :error
     1914           or error-status :get-message(1) <> ""
     1915           then do:
     1916             undo move_block, retry move_block.
     1917           end.
     1918         end.
     1919       end.
     1920       if p-move-resize
     1921       then do:
     1922         run diasize_position-resize-button in this-procedure .
     1923       end.
     1924       if v-diasize-wndstore = true
     1925       then do:
     1926         if connected("ub") = true
     1927         then do:
     1928           define variable v-cntxt-db-num        as integer   no-undo .
     1929           define variable v-cntxt-userid        as character no-undo .
     1930           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1931                                             , OUTPUT v-cntxt-userid
     1932                                             ) .
     1933           run gbl/wndsizew.p
     1934             (input  v-cntxt-db-num
     1935             ,input  v-cntxt-userid
     1936             ,input  v-diasize-proc-name
     1937             ,input  'width':u
     1938             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1939             ) .
     1940         end.
     1941       end.
     1942     end.
     1943     assign
     1944       v-diasize-change-size = false
     1945     .
     1946   end procedure.
     1947   procedure diasize_set-width :
     1948     define input  parameter p-new-width  as decimal   no-undo .
     1949     define input  parameter p-move-resize as logical   no-undo .
     1950     do
     1951     on error undo, return error return-value
     1952     :
     1953       run diasize_change-width in this-procedure
     1954         (input  (p-new-width - frame Dialog-Frame :width)
     1955         ,input  p-move-resize
     1956         ) .
     1957     end.
     1958   end procedure.
     1959   procedure diasize_position-resize-button :
     1960     do with frame Dialog-Frame
     1961     :
     1962       hide v-diasize-resize-button .
     1963       assign
     1964         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1965                     - 1
     1966                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1967         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1968                     - 1
     1969                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1970       .
     1971       view v-diasize-resize-button .
     1972     end.
     1973   end procedure.
     1974   on alt-right anywhere
     1975   do:
     1976     run diasize_change-width in this-procedure
     1977       (input 1
     1978       ,input true
     1979       ) .
     1980     return no-apply .
     1981   end.
     1982   on alt-left anywhere
     1983   do:
     1984     run diasize_change-width in this-procedure
     1985       (input -1
     1986       ,input true
     1987       ) .
     1988     return no-apply .
     1989   end.
     1990   on alt-down anywhere
     1991   do:
     1992     run diasize_change-height in this-procedure
     1993       (input 1
     1994       ,input true
     1995       ) .
     1996     return no-apply .
     1997   end.
     1998   on alt-up anywhere
     1999   do:
     2000     run diasize_change-height in this-procedure
     2001       (input -1
     2002       ,input true
     2003       ) .
     2004     return no-apply .
     2005   end.
     2006   on alt-enter of frame Dialog-Frame
     2007   do:
     2008     run diasize_maximize in this-procedure
     2009       (input  ?
     2010       ).
     2011     return no-apply .
     2012   end.
     2013   procedure diasize_end-move :
     2014     do
     2015     on error undo, return error return-value
     2016     :
     2017       define variable v-row-delta as decimal   no-undo .
     2018       define variable v-col-delta as decimal   no-undo .
     2019       define variable v-new-row as decimal   no-undo .
     2020       define variable v-new-col as decimal   no-undo .
     2021       assign
     2022         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2023         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2024       .
     2025       assign
     2026         v-row-delta = v-new-row - frame Dialog-Frame :height
     2027         v-col-delta = v-new-col - frame Dialog-Frame :width
     2028       .
     2029       run diasize_change-height in this-procedure
     2030         (input v-row-delta
     2031         ,input true
     2032         ) .
     2033       run diasize_change-width in this-procedure
     2034         (input v-col-delta
     2035         ,input true
     2036         ) .
     2037     end.
     2038   end procedure.
     2039   procedure diasize_maximize :
     2040     define input  parameter p-action as logical   no-undo .
     2041     do
     2042     on error undo, return error return-value
     2043     :
     2044       if p-action = ?
     2045       then do:
     2046         if v-diasize-need-maximize = true
     2047         then do:
     2048           assign
     2049             p-action = true
     2050           .
     2051         end.
     2052         else do:
     2053           assign
     2054             p-action = false
     2055           .
     2056         end.
     2057       end.
     2058       if p-action = true
     2059       then do:
     2060         run diasize_change-height in this-procedure
     2061           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2062               - frame Dialog-Frame :height-chars
     2063           ,input true
     2064           ) .
     2065         run diasize_change-width in this-procedure
     2066           (input session :width-chars
     2067               - frame Dialog-Frame :width-chars
     2068           ,input true
     2069           ) .
     2070         assign
     2071           v-diasize-need-maximize = false
     2072         .
     2073       end.
     2074       else do:
     2075         run diasize_change-width in this-procedure
     2076           (input v-diasize-orig-frame-width
     2077               - frame Dialog-Frame :width-chars
     2078           ,input true
     2079           ) .
     2080         run diasize_change-height in this-procedure
     2081           (input v-diasize-orig-frame-height
     2082               - frame Dialog-Frame :height-chars
     2083           ,input true
     2084           ) .
     2085         assign
     2086           v-diasize-need-maximize = true
     2087         .
     2088       end.
     2089     end.
     2090   end procedure.
     2091   procedure diasize_restore-orig-size :
     2092     do
     2093     on error undo, return error return-value
     2094     :
     2095       assign
     2096         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2097         v-diasize-current-frame-height = frame Dialog-Frame :height
     2098       .
     2099       run diasize_set-height in this-procedure
     2100         (input  v-diasize-orig-frame-height
     2101         ,input  true
     2102         ) .
     2103       run diasize_set-width in this-procedure
     2104         (input  v-diasize-orig-frame-width
     2105         ,input  true
     2106         ) .
     2107     end.
     2108   end procedure.
     2109   procedure diasize_restore-current-size :
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       run diasize_set-height in this-procedure
     2114         (input  v-diasize-current-frame-height
     2115         ,input  true
     2116         ) .
     2117       run diasize_set-width in this-procedure
     2118         (input  v-diasize-current-frame-width
     2119         ,input  true
     2120         ) .
     2121     end.
     2122   end procedure.
     2123   procedure diasize_set-browse-handle :
     2124     define input  parameter p-browse-handle as handle   no-undo .
     2125     define buffer buf_temp-browse-handle for temp-browse-handle .
     2126     do
     2127     on error undo, return error return-value
     2128     :
     2129       assign
     2130         v-diasize-browse-handle = p-browse-handle
     2131       .
     2132       for each buf_temp-browse-handle
     2133       on error undo, return error return-value
     2134       :
     2135         delete buf_temp-browse-handle .
     2136       end.
     2137     end.
     2138   end procedure.
     2139   procedure diasize_add_browse :
     2140     define input  parameter p-browse-type   as character no-undo .
     2141     define input  parameter p-browse-handle as handle    no-undo .
     2142     define buffer buf_temp-browse-handle for temp-browse-handle .
     2143     do
     2144     on error undo, return error return-value
     2145     :
     2146       assign
     2147         v-diasize-browse-number = v-diasize-browse-number + 1
     2148       .
     2149       create buf_temp-browse-handle .
     2150       assign
     2151         buf_temp-browse-handle.browse-type   = p-browse-type
     2152         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2153         buf_temp-browse-handle.browse-handle = p-browse-handle
     2154       .
     2155     end.
     2156   end procedure.
     2157   procedure diasize_init :
     2158     define variable v-default-value    as logical   no-undo .
     2159     define variable v-restore-saved    as logical   no-undo .
     2160     define variable v-resize-value-str as character no-undo .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       do with frame Dialog-Frame
     2165       :
     2166         assign
     2167           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2168           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2169           v-diasize-browse-handle     = browse BR-gdsscrvw :handle
     2170         .
     2171         create button v-diasize-resize-button
     2172         assign
     2173           parent        = frame Dialog-Frame :first-child
     2174           label         = "s"
     2175           height-pixels = 16
     2176           width-pixels  = 16
     2177           visible       = true
     2178           sensitive     = true
     2179           movable       = true
     2180           triggers:
     2181             on end-move persistent run diasize_end-move in this-procedure .
     2182           end triggers.
     2183         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2184         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2185         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2186         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2187         assign
     2188           v-diasize-wndmax = false
     2189         .
     2190         if connected("ub") = true
     2191         then do:
     2192           define variable v-cntxt-db-num        as integer   no-undo .
     2193           define variable v-cntxt-userid        as character no-undo .
     2194           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2195                                             , OUTPUT v-cntxt-userid
     2196                                             ) .
     2197           run gbl/wndpar_r.p
     2198             (input  v-cntxt-db-num
     2199             ,input  v-cntxt-userid
     2200             ,input  'wndmax':U
     2201             ,output v-diasize-wndmax
     2202             ,output v-default-value
     2203             ) .
     2204         end.
     2205         assign
     2206           v-diasize-wndstore = false
     2207         .
     2208         if connected("ub") = true
     2209         then do:
     2210           run gbl/wndpar_r.p
     2211             (input  v-cntxt-db-num
     2212             ,input  v-cntxt-userid
     2213             ,input  'wndstore':U
     2214             ,output v-diasize-wndstore
     2215             ,output v-default-value
     2216             ) .
     2217         end.
     2218         assign
     2219           v-diasize-proc-name = entry(1, program-name(2), '.')
     2220         .
     2221         if v-diasize-wndstore = true
     2222         then do:
     2223           assign
     2224             v-restore-saved = false
     2225           .
     2226           if connected("ub") = true
     2227           then do:
     2228             run gbl/wndsizer.p
     2229               (input  v-cntxt-db-num
     2230               ,input  v-cntxt-userid
     2231               ,input  v-diasize-proc-name
     2232               ,input  'height':u
     2233               ,output v-resize-value-str
     2234               ) .
     2235             if v-resize-value-str <> '':U
     2236             then do:
     2237               run diasize_change-height in this-procedure
     2238                 (input  integer(v-resize-value-str)
     2239                 ,input  true
     2240                 ) .
     2241               assign
     2242                 v-restore-saved = true
     2243               .
     2244             end.
     2245           end.
     2246           if connected("ub") = true
     2247           then do:
     2248             run gbl/wndsizer.p
     2249               (input  v-cntxt-db-num
     2250               ,input  v-cntxt-userid
     2251               ,input  v-diasize-proc-name
     2252               ,input  'width':u
     2253               ,output v-resize-value-str
     2254               ) .
     2255             if v-resize-value-str <> '':U
     2256             then do:
     2257               run diasize_change-width in this-procedure
     2258                 (input  integer(v-resize-value-str)
     2259                 ,input  true
     2260                 ) .
     2261               assign
     2262                 v-restore-saved = true
     2263               .
     2264             end.
     2265           end.
     2266           if v-restore-saved <> true
     2267           then do:
     2268             if v-diasize-wndmax = true
     2269             then do:
     2270               run diasize_maximize in this-procedure
     2271                 (input  true
     2272                 ) .
     2273             end.
     2274           end.
     2275         end.
     2276         else do:
     2277           if v-diasize-wndmax = true
     2278           then do:
     2279             run diasize_maximize in this-procedure
     2280               (input  true
     2281               ) .
     2282           end.
     2283         end.
     2284       end.
     2285     end.
     2286   end procedure.
     2287   procedure diasize_need-full-display :
     2288     define output parameter p-need-full-display as logical   no-undo .
     2289     do
     2290     on error undo, return error return-value
     2291     :
     2292       assign
     2293         p-need-full-display = v-diasize-need-full-display
     2294       .
     2295       assign
     2296         v-diasize-need-full-display = false
     2297       .
     2298     end.
     2299   end procedure.
     2300   procedure get-context :
     2301      define output parameter p-db-num as integer          no-undo.
     2302      define output parameter p-user-id as character        no-undo.
     2303      define variable v-login               as character    no-undo.
     2304      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2305      define buffer buf_user-login  for ub.user-login .
     2306      do
     2307      on error undo, return error
     2308      :
     2309            FIND FIRST buf_sys-ctrl no-lock.
     2310            ASSIGN
     2311               v-login = USERID("ub")
     2312               p-db-num = buf_sys-ctrl.db-num
     2313            .
     2314            FIND FIRST buf_user-login
     2315                 WHERE buf_user-login.db-num = p-db-num
     2316                   AND buf_user-login.user-login = v-login
     2317                 no-lock
     2318                 no-error
     2319                 .
     2320            IF AVAILABLE buf_user-login
     2321            THEN DO:
     2322               assign
     2323                  p-user-id = buf_user-login.user-id
     2324               .
     2325            END.
     2326      end.
     2327   end procedure.
     2328       run diasize_init in this-procedure .
     2329   ON value-changed OF temp-gdsscrvw.is-on IN BROWSE br-gdsscrvw DO:
     2330   DEFINE BUFFER buf_temp-gdsscrvw FOR temp-gdsscrvw.
     2331   if not avail temp-gdsscrvw then return no-apply.
     2332   FIND FIRST buf_temp-gdsscrvw WHERE RECID(buf_temp-gdsscrvw) = RECID(temp-gdsscrvw).
     2333   ASSIGN
     2334   buf_temp-gdsscrvw.is-on = LOGICAL(temp-gdsscrvw.is-on:SCREEN-VALUE IN BROWSE br-gdsscrvw).
     2335   end.
     2336   MAIN-BLOCK:
     2337   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2338      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2339   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2340     run mainmenu_getcntxt in parparentproc
     2341       (output v-cntxt-db-num
     2342       ,output v-cntxt-userid
     2343       ,output v-cntxt-level
     2344       ,output v-cntxt-host-code-obj
     2345       ,output v-cntxt-obj-type
     2346       ,output v-cntxt-obj-code
     2347       ,output v-cntxt-db-num-obj
     2348       ,output v-cntxt-is-admin
     2349       ) .
     2350   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2351   ON TAB ANYWHERE
     2352   DO:
     2353   define variable ii as integer no-undo .
     2354   define variable fh as widget-handle no-undo .
     2355   define variable hh as widget-handle no-undo .
     2356   define variable v-next-widget-name as character no-undo .
     2357   if v-tab-order <> '' then do:
     2358     if self:type = "TOGGLE-BOX" then
     2359     self:BGCOLOR = ?.
     2360     assign
     2361     ii = lookup(self:name, v-tab-order).
     2362     assign
     2363     ii = ii + 1
     2364     v-next-widget-name = entry(ii, v-tab-order)
     2365     no-error .
     2366     if error-status:error then do:
     2367       assign
     2368       ii = 1
     2369       v-next-widget-name = entry( ii, v-tab-order)
     2370       .
     2371     end.
     2372     assign
     2373     fh = frame Dialog-Frame:first-child
     2374     hh = fh:first-child
     2375     .
     2376     do while valid-handle(hh):
     2377       if hh:name = v-next-widget-name then do:
     2378         if hh:sensitive  = yes
     2379         AND hh:visible = yes then do:
     2380           if hh:type = "TOGGLE-BOX":U then do:
     2381             assign
     2382             hh:BGcolor = 1
     2383             .
     2384           end.
     2385           APPLY "ENTRY" to hh.
     2386           return no-apply.
     2387         end.
     2388         else do:
     2389           APPLY "TAB" to hh.
     2390           return no-apply.
     2391         end.
     2392       end.
     2393       hh = hh:next-sibling.
     2394     end.
     2395   end.
     2396   END.
     2397   ON BACK-TAB ANYWHERE
     2398   DO:
     2399   define variable ii as integer no-undo .
     2400   define variable fh as widget-handle no-undo .
     2401   define variable hh as widget-handle no-undo .
     2402   define variable v-next-widget-name as character no-undo .
     2403   if v-tab-order <> '' then do:
     2404     assign
     2405     ii = lookup(self:name, v-tab-order).
     2406     .
     2407     assign
     2408     ii = (if ii = 1
     2409           then  num-entries(v-tab-order)
     2410           else ii - 1
     2411           )
     2412     v-next-widget-name = entry(ii, v-tab-order)
     2413     .
     2414     assign
     2415     fh = frame Dialog-Frame:first-child
     2416     hh = fh:first-child
     2417     .
     2418     do while valid-handle(hh):
     2419       if hh:name = v-next-widget-name then do:
     2420         if hh:sensitive  = yes
     2421         AND hh:visible = yes then do:
     2422           if hh:type = "TOGGLE-BOX":U then do:
     2423             assign
     2424             hh:BGcolor = 1
     2425             .
     2426           end.
     2427           APPLY "ENTRY" to hh.
     2428           return no-apply.
     2429         end.
     2430         else do:
     2431         APPLY "BACK-TAB" to hh.
     2432         return no-apply.
     2433         end.
     2434       end.
     2435       hh = hh:next-sibling.
     2436     end.
     2437     end.
     2438   END.
     2439   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2440   ON RETURN ANYWHERE
     2441   DO:
     2442   define variable ii as integer no-undo .
     2443   define variable fh as widget-handle no-undo .
     2444   define variable hh as widget-handle no-undo .
     2445   define variable v-next-widget-name as character no-undo .
     2446     if v-tab-order <> '' then do:
     2447       assign
     2448       ii = lookup(self:name, v-tab-order).
     2449       if ii = num-entries(v-tab-order) then do:
     2450           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2451           return no-apply.
     2452       end.
     2453       if self:type <> "BUTTON" and
     2454         self:type <> "EDITOR"  then do:
     2455         run proc-move-forward in this-procedure .
     2456         return no-apply.
     2457       end.
     2458       if self:type = "BUTTON" then do:
     2459         APPLY "CHOOSE" to self.
     2460       end.
     2461       if self:type = "TOGGLE-BOX" then
     2462       self:BGCOLOR = ?.
     2463       assign
     2464       ii = ii + 1
     2465       v-next-widget-name = entry(ii, v-tab-order)
     2466       no-error .
     2467       if error-status:error then do:
     2468         assign
     2469         ii = 1
     2470         v-next-widget-name = entry( ii, v-tab-order)
     2471         .
     2472       end.
     2473       assign
     2474       fh = frame Dialog-Frame:first-child
     2475       hh = fh:first-child
     2476       .
     2477       do while valid-handle(hh):
     2478         if hh:name = v-next-widget-name then do:
     2479           if hh:sensitive  = yes
     2480           AND hh:visible = yes then do:
     2481             if hh:type = "TOGGLE-BOX":U then do:
     2482               assign
     2483               hh:BGcolor = 1
     2484               .
     2485             end.
     2486             APPLY "ENTRY" to hh.
     2487             return no-apply.
     2488           end.
     2489           else do:
     2490             APPLY "TAB" to hh.
     2491             return no-apply.
     2492           end.
     2493         end.
     2494         hh = hh:next-sibling.
     2495       end.
     2496     end.
     2497   END.
     2498   procedure proc-move-forward :
     2499   define variable ii as integer no-undo .
     2500   define variable fh as widget-handle no-undo .
     2501   define variable hh as widget-handle no-undo .
     2502   define variable v-next-widget-name as character no-undo .
     2503   do
     2504   on error undo, return error
     2505   :
     2506     if v-tab-order <> '' then do:
     2507       if self:type = "TOGGLE-BOX" then
     2508       self:BGCOLOR = ?.
     2509       assign
     2510       ii = lookup(self:name, v-tab-order).
     2511       assign
     2512       ii = ii + 1
     2513       v-next-widget-name = entry(ii, v-tab-order)
     2514       no-error .
     2515       if error-status:error then do:
     2516         assign
     2517         ii = 1
     2518         v-next-widget-name = entry( ii, v-tab-order)
     2519         .
     2520       end.
     2521       assign
     2522       fh = frame Dialog-Frame:first-child
     2523       hh = fh:first-child
     2524       .
     2525       do while valid-handle(hh):
     2526         if hh:name = v-next-widget-name then do:
     2527           if hh:sensitive  = yes
     2528           AND hh:visible = yes then do:
     2529             if hh:type = "TOGGLE-BOX":U then do:
     2530               assign
     2531               hh:BGcolor = 1
     2532               .
     2533             end.
     2534             APPLY "ENTRY" to hh.
     2535             return.
     2536           end.
     2537           else do:
     2538             assign
     2539             ii = ii + 1
     2540             v-next-widget-name = entry(ii, v-tab-order)
     2541             no-error .
     2542             if error-status:error then do:
     2543               assign
     2544               ii = 1
     2545               v-next-widget-name = entry( ii, v-tab-order)
     2546               .
     2547             end.
     2548           end.
     2549         end.
     2550         hh = hh:next-sibling.
     2551       end.
     2552     end.
     2553   end.
     2554   end procedure.
     2555     IF p-mode <> 'ПРОСМОТР':U
     2556     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2557         MESSAGE
     2558         vss-workfile vss-revision vss-description skip
     2559         "Неверное значение параметра p-mode" p-mode
     2560         VIEW-AS ALERT-BOX ERROR.
     2561         UNDO, RETURN ERROR.
     2562     END.
     2563     IF  p-obj-type <> '':U
     2564     THEN DO:
     2565         MESSAGE
     2566         vss-workfile vss-revision vss-description skip
     2567         "Неверное значение параметра p-obj-type" p-obj-type
     2568         VIEW-AS ALERT-BOX ERROR.
     2569         UNDO, RETURN ERROR.
     2570     END.
     2571     if p-obj-type = '':U then do:
     2572       if v-cntxt-db-num <> 0
     2573       and p-mode <> 'ПРОСМОТР':U
     2574       then do:
     2575           MESSAGE
     2576           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2577           VIEW-AS ALERT-BOX ERROR.
     2578           UNDO, RETURN ERROR.
     2579       end.
     2580     end.
     2581     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2582       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2583                 LOCKED_thbj-attr.obj-type = p-obj-type
     2584           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2585           AND   LOCKED_thbj-attr.upper-prop-code = 'gds-ref':U
     2586           AND LOCKED_thbj-attr.prop-code = "":U
     2587           NO-WAIT NO-ERROR.
     2588        if locked locked_thbj-attr then do:
     2589           message
     2590           vss-workfile vss-revision vss-description skip
     2591            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2592           view-as alert-box error .
     2593           undo, return error.
     2594         end.
     2595     END.
     2596     ELSE DO:
     2597         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2598             LOCKED_thbj-attr.obj-type = p-obj-type
     2599       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2600       AND   LOCKED_thbj-attr.upper-prop-code = 'gds-ref':U
     2601       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     2602     END.
     2603     if not available locked_thbj-attr then do:
     2604       ASSIGN
     2605       v-to-create  = YES.
     2606       message
     2607       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2608                   chr(10))
     2609       view-as alert-box WARNING.
     2610     end.
     2611     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2612     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2613     RUN Myenable in this-procedure .
     2614     WAIT-FOR GO OF FRAME Dialog-Frame.
     2615   END.
     2616   RUN disable_UI.
     2617   PROCEDURE disable_UI :
     2618     HIDE FRAME Dialog-Frame.
     2619   END PROCEDURE.
     2620   PROCEDURE enable_UI :
     2621     DISPLAY t-dif-nam1 t-dif-nam2 t-dpl-off t-dif-pdbc t-pbc-veto t-tnvedimp
     2622             t-unq-artc t-is-scgb f-shema-foto f-dfltggrp f-grp-name rs-gdsoattr
     2623             rs-gdshattr rs-fgdsobj rs-s-coeff rs-gds-prop rs-gds-attr rs-add-prop
     2624             FILL-IN-3 l-gds-obj-attr l-gds-host-attr l-fbr-gds-obj l-s-coeff
     2625             l-gds-prop l-goods-attr l-add-prop
     2626         WITH FRAME Dialog-Frame.
     2627     ENABLE B-exit b-quit B-Help RECT-1 t-dif-nam1 BR-gdsscrvw t-dif-nam2
     2628            t-dpl-off t-dif-pdbc t-pbc-veto t-tnvedimp t-unq-artc t-is-scgb
     2629            f-shema-foto B-dfltggrp rs-gdsoattr rs-gdshattr rs-fgdsobj rs-s-coeff
     2630            rs-gds-prop rs-gds-attr rs-add-prop l-gds-obj-attr l-gds-host-attr
     2631            l-fbr-gds-obj l-s-coeff l-gds-prop l-goods-attr l-add-prop
     2632         WITH FRAME Dialog-Frame.
     2633     VIEW FRAME Dialog-Frame.
     2634     OPEN QUERY br-gdsscrvw FOR EACH temp-gdsscrvw.
     2635   END PROCEDURE.
     2636   PROCEDURE fill-widgets :
     2637   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2638   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2639   define variable v-param-type as character no-undo .
     2640   define variable v-value-character as character no-undo .
     2641   define variable v-value-date as date no-undo .
     2642   define variable v-value-decimal as decimal no-undo .
     2643   define variable v-value-integer as INTEGER no-undo .
     2644   define variable v-value-logical AS LOGICAL no-undo .
     2645   DEFINE VARIABLE v-gds-copy-list AS CHARACTER NO-UNDO.
     2646   DEFINE VARIABLE v-gdsreffi-list AS CHARACTER NO-UNDO.
     2647   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2648   FOR EACH thbjattr_thbj-attr:
     2649     delete thbjattr_thbj-attr.
     2650   end.
     2651   FOR EACH temp-thbj-attr:
     2652     delete temp-thbj-attr.
     2653   end.
     2654   run adm/shattri.p (
     2655                 input "init":U
     2656               , input p-obj-type
     2657               , input p-obj-code
     2658               , input 'gds-ref':U
     2659               , input "":U
     2660               , output v-value-character
     2661               , output v-value-date
     2662               , output v-value-decimal
     2663               , output v-value-integer
     2664               , output v-value-logical
     2665               , output v-param-type
     2666               , INPUT-OUTPUT table-handle v-tth
     2667               ) no-error .
     2668   if error-status:error
     2669   and not available locked_thbj-attr then do:
     2670     message
     2671     "Не удалось получить начальные значения настроек" skip
     2672     error-status:get-message(1) return-value
     2673     view-as alert-box error .
     2674     undo, return error .
     2675   end.
     2676   FOR EACH thbjattr_thbj-attr:
     2677     ASSIGN
     2678     v-entry = thbjattr_thbj-attr.prop-code.
     2679     IF v-entry = 'dif-nam1':U THEN DO:
     2680       ASSIGN
     2681       t-dif-nam1 = thbjattr_thbj-attr.property-value-logical
     2682       t-dif-nam1:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2683       .
     2684     END.
     2685     IF v-entry = 'dif-nam2':U THEN DO:
     2686       ASSIGN
     2687       t-dif-nam2 = thbjattr_thbj-attr.property-value-logical
     2688       t-dif-nam2:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2689       .
     2690     END.
     2691     IF v-entry = 'dpl-off':U THEN DO:
     2692       ASSIGN
     2693       t-dpl-off = thbjattr_thbj-attr.property-value-logical
     2694       t-dpl-off:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2695       .
     2696     END.
     2697     IF v-entry = 'dif-pdbc':U THEN DO:
     2698       ASSIGN
     2699       t-dif-pdbc = thbjattr_thbj-attr.property-value-logical
     2700       t-dif-pdbc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2701       .
     2702     END.
     2703     IF v-entry = 'pbc-veto':U THEN DO:
     2704       ASSIGN
     2705       t-pbc-veto = thbjattr_thbj-attr.property-value-logical
     2706       t-pbc-veto:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2707       .
     2708     END.
     2709     IF v-entry = 'tnvedimp':U THEN DO:
     2710       ASSIGN
     2711       t-tnvedimp = thbjattr_thbj-attr.property-value-logical
     2712       t-tnvedimp:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2713       .
     2714     END.
     2715     IF v-entry = 'shema-foto':U THEN DO:
     2716       ASSIGN
     2717       f-shema-foto = thbjattr_thbj-attr.property-value-integer
     2718       f-shema-foto:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     2719       .
     2720     end.
     2721     IF v-entry = 'unq-artc':U THEN DO:
     2722       ASSIGN
     2723       t-unq-artc = thbjattr_thbj-attr.property-value-logical
     2724       t-unq-artc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2725       .
     2726     END.
     2727     IF v-entry = 'is-scgb':U THEN DO:
     2728       ASSIGN
     2729       t-is-scgb = thbjattr_thbj-attr.property-value-logical
     2730       t-is-scgb:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2731       .
     2732     END.
     2733     IF v-entry = 'dfltggrp':U THEN DO:
     2734       ASSIGN
     2735       f-dfltggrp = thbjattr_thbj-attr.property-value-integer
     2736       f-dfltggrp:private-data = "recid=" + string(recid(thbjattr_thbj-attr))
     2737       .
     2738       RUN set-full-grp-name IN THIS-PROCEDURE ( INPUT f-dfltggrp) .
     2739     END.
     2740     IF v-entry = 'gds-copy':U THEN DO:
     2741       ASSIGN
     2742       v-gds-copy-list = thbjattr_thbj-attr.property-value-character
     2743       .
     2744       DO v-ii = 1 TO NUM-ENTRIES( v-gds-copy-list):
     2745         CASE v-ii:
     2746             WHEN 1 THEN DO:
     2747                rs-gdsoattr = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2748             END.
     2749             WHEN 2 THEN DO:
     2750                rs-gdshattr = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2751             END.
     2752             WHEN 3 THEN DO:
     2753                rs-fgdsobj = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2754             END.
     2755             WHEN 4 THEN DO:
     2756                rs-s-coeff = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2757             END.
     2758             WHEN 5 THEN DO:
     2759                rs-gds-prop = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2760             END.
     2761             WHEN 6 THEN DO:
     2762                rs-gds-attr = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2763             END.
     2764             WHEN 7 THEN DO:
     2765                rs-add-prop = INTEGER(ENTRY(v-ii, v-gds-copy-list)) NO-ERROR.
     2766             END.
     2767         END CASE.
     2768       END.
     2769     END.
     2770     IF v-entry = 'gdsscrvw':U THEN DO:
     2771       ASSIGN
     2772       v-gdsscrvw = thbjattr_thbj-attr.property-value-character
     2773       .
     2774     END.
     2775     create temp-thbj-attr.
     2776     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2777   END.
     2778   END PROCEDURE.
     2779   PROCEDURE MyEnable :
     2780   DEFINE BUFFER buf_custom-labels FOR ub.custom-labels.
     2781   DEFINE BUFFER buf_temp-gdsscrvw FOR temp-gdsscrvw.
     2782   FOR EACH buf_custom-labels NO-LOCK WHERE
     2783           buf_custom-labels.CALL-TYPE = "add-fields"
     2784       AND buf_custom-labels.CALL-point = "gdsscrvw":
     2785     CREATE buf_temp-gdsscrvw.
     2786     ASSIGN
     2787     buf_temp-gdsscrvw.tbl-name = buf_custom-labels.tbl-name
     2788     buf_temp-gdsscrvw.fld-name = buf_custom-labels.fld-name
     2789     buf_temp-gdsscrvw.custom-label = buf_custom-labels.custom-label
     2790     buf_temp-gdsscrvw.is-on = LOOKUP(substitute("&1.&2"
     2791                                                 , buf_custom-labels.tbl-name
     2792                                                 , buf_custom-labels.fld-name
     2793                                                 )
     2794                                       , v-gdsscrvw) > 0
     2795     .
     2796   END.
     2797   ASSIGN
     2798   rs-gdsoattr:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2799   "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2800   "По текущему объекту" + chr(44) + STRING(1) + chr(44) +
     2801   "Объекта той же фирмы в тек. БД" + chr(44) + STRING(2) + chr(44) +
     2802   "Все объекты тек. БД" + chr(44) + STRING(3)
     2803   rs-gdshattr:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2804      "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2805       "По текущей фирме" + chr(44) + STRING(1) + chr(44) +
     2806       "Все фирмы" + chr(44) + STRING(2)
     2807   rs-fgdsobj:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2808       "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2809       "По текущему объекту" + chr(44) + STRING(1) + chr(44) +
     2810       "Объекта той же фирмы в тек. БД" + chr(44) + STRING(2) + chr(44) +
     2811       "Все объекты тек. БД" + chr(44) + STRING(3)
     2812   rs-s-coeff:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2813           "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2814           "По текущему объекту и глобальные" + chr(44) + STRING(1) + chr(44) +
     2815           "Объекта той же фирмы в тек. БД и глобальные" + chr(44) + STRING(2) + chr(44) +
     2816           "Все объекты тек. БД и глобальные" + chr(44) + STRING(3)
     2817   rs-gds-prop:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2818           "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2819           "По текущему объекту" + chr(44) + STRING(1) + chr(44) +
     2820           "Объекта той же фирмы в тек. БД" + chr(44) + STRING(2) + chr(44) +
     2821           "Все объекты тек. БД" + chr(44) + STRING(3)
     2822   rs-gds-attr:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2823               "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2824                "Копировать" + chr(44) + STRING(1)
     2825   rs-add-prop:RADIO-BUTTONS IN FRAME Dialog-Frame =
     2826                   "Не копировать" + chr(44) + STRING(0) + chr(44) +
     2827                    "Копировать" + chr(44) + STRING(1)
     2828   .
     2829   if p-obj-type = 'маг':U
     2830   or p-obj-type = 'скл':U then do:
     2831     ASSIGN
     2832     FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     2833                                            ,FRAME Dialog-Frame:TITLE
     2834                                            ,p-obj-type
     2835                                            ,p-obj-code)
     2836     .
     2837   end.
     2838   v-tab-order = "t-dif-nam1,t-dif-nam2,t-dif-pdbc,t-pbc-veto,t-tnvedimp,shema-foto,t-unq-artc,t-is-scgb" +
     2839                 "b-dfltggrp,rs-gdsoattr,rs-gdshattr,rs-fgdsobj,rs-s-coeff,rs-gds-prop,rs-gds-attr,rs-add-prop,br-gdsscrvw".
     2840   ASSIGN
     2841   temp-gdsscrvw.is-on:read-only IN BROWSE br-gdsscrvw = (p-mode = 'ПРОСМОТР':U).
     2842   DISPLAY
     2843   l-add-prop
     2844   l-fbr-gds-obj
     2845   l-gds-host-attr
     2846   l-gds-obj-attr
     2847   l-gds-prop
     2848   l-goods-attr
     2849   l-s-coeff
     2850   t-dif-nam1
     2851   t-dif-nam2
     2852   t-dpl-off
     2853   t-dif-pdbc
     2854   t-pbc-veto
     2855   t-tnvedimp
     2856   f-shema-foto
     2857   t-unq-artc
     2858   t-is-scgb
     2859   rs-add-prop
     2860   rs-fgdsobj
     2861   rs-s-coeff
     2862   rs-gds-attr
     2863   rs-gdshattr
     2864   rs-gdsoattr
     2865   rs-gds-prop
     2866   fill-in-3
     2867   rect-1
     2868   br-gdsscrvw
     2869   WITH FRAME Dialog-Frame.
     2870   ENABLE
     2871   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2872   b-quit
     2873   B-Help
     2874   t-dif-nam1 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2875   t-dif-nam2 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2876   t-dpl-off WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2877   t-dif-pdbc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2878   t-pbc-veto WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2879   t-tnvedimp WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2880   f-shema-foto WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2881   t-unq-artc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2882   t-is-scgb  WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2883   b-dfltggrp WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2884   rs-add-prop  WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2885   rs-fgdsobj WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2886   rs-s-coeff WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2887   rs-gds-attr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2888   rs-gdshattr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2889   rs-gdsoattr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2890   rs-gds-prop WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2891   br-gdsscrvw
     2892   WITH FRAME Dialog-Frame.
     2893   VIEW FRAME Dialog-Frame.
     2894   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2895       HIDE
     2896       b-exit
     2897       IN FRAME Dialog-Frame.
     2898       ASSIGN
     2899       b-quit:LABEL = "&Выход"
     2900       b-quit:column = 1
     2901       .
     2902   END.
     2903   OPEN QUERY br-gdsscrvw FOR EACH temp-gdsscrvw.
     2904   END PROCEDURE.
     2905   PROCEDURE proc-save :
     2906   define variable v-value-character as character no-undo .
     2907   define variable v-value-date as date no-undo .
     2908   define variable v-value-decimal as decimal no-undo .
     2909   define variable v-value-integer as INTEGER no-undo .
     2910   define variable v-value-logical AS LOGICAL no-undo .
     2911   define variable v-param-type as character no-undo .
     2912   define variable v-gds-copy-list as character no-undo .
     2913   define variable v-gdsreffi as character no-undo .
     2914   define variable wh as widget-handle no-undo .
     2915   define variable fh as widget-handle no-undo .
     2916   define variable v-same as logical no-undo .
     2917   DEFINE BUFFER buf_temp-gdsscrvw FOR temp-gdsscrvw.
     2918   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2919   v-gdsscrvw = "".
     2920   FOR EACH buf_temp-gdsscrvw:
     2921      IF buf_temp-gdsscrvw.is-on THEN DO:
     2922         ASSIGN
     2923         v-gdsscrvw =  substitute("&1,&2.&3"
     2924                                 ,v-gdsscrvw
     2925                                 , buf_temp-gdsscrvw.tbl-name
     2926                                 , buf_temp-gdsscrvw.fld-name).
     2927      END.
     2928   END.
     2929   ASSIGN
     2930   v-gdsscrvw = TRIM(v-gdsscrvw, chr(44)).
     2931   ASSIGN
     2932   FRAME Dialog-Frame
     2933   t-dif-nam1
     2934   t-dif-nam2
     2935   t-dpl-off
     2936   t-dif-pdbc
     2937   t-pbc-veto
     2938   t-tnvedimp
     2939   f-shema-foto
     2940   t-unq-artc
     2941   t-is-scgb
     2942   f-dfltggrp
     2943   rs-gdsoattr
     2944   rs-gdshattr
     2945   rs-fgdsobj
     2946   rs-s-coeff
     2947   rs-gds-prop
     2948   rs-gds-attr
     2949   rs-add-prop
     2950   .
     2951    ASSIGN
     2952   v-gds-copy-list = SUBSTITUTE("&2&1&3&1&4&1&5&1&6&1&7&1&8"
     2953                             ,chr(44)
     2954                             ,rs-gdsoattr
     2955                             ,rs-gdshattr
     2956                             ,rs-fgdsobj
     2957                             ,rs-s-coeff
     2958                             ,rs-gds-prop
     2959                             ,rs-gds-attr
     2960                             ,rs-add-prop).
     2961   assign
     2962   fh = frame Dialog-Frame:first-child
     2963   wh = fh:first-child
     2964   .
     2965   do while valid-handle(wh):
     2966     if wh:private-data begins "recid=" then do:
     2967       find first thbjattr_thbj-attr where
     2968                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2969       assign
     2970       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2971     end.
     2972     wh = wh:next-sibling.
     2973   end.
     2974   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'gds-copy':U.
     2975   assign
     2976   thbjattr_thbj-attr.property-value-character = v-gds-copy-list
     2977   .
     2978   release thbjattr_thbj-attr.
     2979   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'gdsscrvw':U.
     2980   assign
     2981   thbjattr_thbj-attr.property-value-character = v-gdsscrvw
     2982   .
     2983   release thbjattr_thbj-attr.
     2984   v-same = yes.
     2985   for each thbjattr_thbj-attr,
     2986       first temp-thbj-attr where
     2987             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2988         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2989         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2990         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2991      buffer-compare
     2992      thbjattr_thbj-attr
     2993      to temp-thbj-attr
     2994      save result in v-same.
     2995      if not v-same then leave.
     2996   end.
     2997   v-same = no.
     2998   IF v-same  and not v-to-create THEN RETURN.
     2999   run adm/shattri.p (
     3000                 input "check":U
     3001               , input p-obj-type
     3002               , input p-obj-code
     3003               , input 'gds-ref':U
     3004               , INPUT '':U
     3005                , output v-value-character
     3006                , output v-value-date
     3007                , output v-value-decimal
     3008                , output v-value-integer
     3009                , output v-value-logical
     3010                , output v-param-type
     3011                , input-output table-handle v-tth
     3012                ) no-error .
     3013   if error-status:error then do:
     3014     message
     3015     "Некорректное значение ПАРАМЕТРОВ" skip
     3016     error-status:get-message(1) skip
     3017     return-value
     3018     view-as alert-box error .
     3019     undo, return error .
     3020   end.
     3021   do TRANSACTION
     3022   on error undo, return error return-value
     3023   :
     3024     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3025          input p-obj-type
     3026         ,input p-obj-code
     3027         ,input 'gds-ref':U
     3028         ,INPUT table thbjattr_thbj-attr
     3029     ) NO-ERROR.
     3030     IF ERROR-STATUS:error THEN do:
     3031       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3032       RETURN-VALUE
     3033       VIEW-AS ALERT-BOX.
     3034       UNDO, RETURN ERROR.
     3035     END.
     3036   end.
     3037   END PROCEDURE.
     3038   PROCEDURE set-full-grp-name :
     3039   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     3040   DEFINE BUFFER buf_gds-grp FOR ub.gds-grp.
     3041   if p-node-code <> -1 then do:
     3042     find first buf_gds-grp no-lock where
     3043               buf_gds-grp.node-code = p-node-code no-error.
     3044     if not available buf_gds-grp then do:
     3045       assign
     3046       f-grp-name = '!!!!НЕВЕРНЫЙ КОД ГРУППЫ':U
     3047       .
     3048     END.
     3049    else do:
     3050      run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output f-grp-name) no-error.
     3051      if error-status:error then do:
     3052       assign
     3053       f-grp-name = '!!!!НЕ УДАЛОСЬ НАЙТИ ПОЛНОЕ ИМЯ ГРУППЫ':U
     3054       .
     3055      end.
     3056    end.
     3057   end.
     3058   else do:
     3059     ASSIGN
     3060     f-grp-name = '':U
     3061     .
     3062   end.
     3063   DISPLAY
     3064   f-grp-name
     3065   f-dfltggrp
     3066   WITH FRAME Dialog-Frame.
     3067   END PROCEDURE.
