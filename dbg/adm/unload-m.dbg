      556           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      557         (input  p-db-num
      558         ,input  p-code
      559         ,output p-exist
      560         ) no-error .
      561       if error-status :error
      562       then do:
      563         undo, return error return-value .
      564       end.
      565     end.
      566   end procedure.
      567   procedure db-attr-delete :
      568     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      569     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
      570     define output parameter p-deleted  as logical no-undo.
      571     do
      572     on error undo, return error
      573     :
      574           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      575         (input  p-db-num
      576         ,input  p-code
      577         ,output p-deleted
      578         ) no-error .
      579       if error-status :error
      580       then do:
      581         undo, return error return-value .
      582       end.
      583     end.
      584   end procedure.
      585   procedure db-attr-news :
      586     define input  parameter p-code           as character no-undo .
      587     define output parameter p-news           as logical   no-undo .
      588     do
      589     on error undo, return error
      590     :
      591           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-news in g#attr-lib
      592         (input  p-code
      593         ,output p-news
      594         ) no-error .
      595       if error-status :error
      596       then do:
      597         undo, return error return-value .
      598       end.
      599     end.
      600   end procedure.
      601   procedure db-attr-manual-edit :
      602     define input  parameter p-code           as character no-undo .
      603     define output parameter p-section-num    as integer no-undo .
      604     do
      605     on error undo, return error
      606     :
      607           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      608         (input  p-code
      609         ,output p-section-num
      610         ) no-error .
      611       if error-status :error
      612       then do:
      613         undo, return error return-value .
      614       end.
      615     end.
      616   end procedure.
      617   procedure db-attr-batch-edit :
      618     define input  parameter p-code           as character no-undo .
      619     define output parameter p-section-num    as integer no-undo .
      620     do
      621     on error undo, return error
      622     :
      623           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      624         (input  p-code
      625         ,output p-section-num
      626         ) no-error .
      627       if error-status :error
      628       then do:
      629         undo, return error return-value .
      630       end.
      631     end.
      632   end procedure.
      633   do
      634   on error  undo, return error
      635   on stop   undo, return error
      636   on endkey undo, return error
      637   :
      638     define buffer buf-new_db for ub.db .
      639     define temp-table t_db no-undo like ub.db .
      640     define variable v-db-num      like ub.db.db-num     no-undo .
      641     define variable v-db-key      like ub.db.db-key     no-undo .
      642     define variable v-db-key-enc  like ub.db.db-key-enc no-undo .
      643     define variable v-answer      as   logical          no-undo .
      644     define variable v-type-unload as   character        no-undo .
      645     define variable v-recid       as   recid            no-undo .
      646     define variable v-err         as   character        no-undo .
      647     define variable v-unload-history as logical no-undo .
      648     run adm/unloaddc.p no-error .
      649     if error-status :error then do:
      650       message
      651         vss-workfile vss-revision vss-description skip
      652         substitute( "Не удалось отключить БД" ) skip
      653         return-value skip
      654         error-status :get-message ( error-status :num-messages )
      655         view-as alert-box error
      656       .
      657       return error .
      658     end.
      659     find first buf-new_db share-lock
      660       where buf-new_db.db-num = p-db-num
      661     .
      662     run adm/lock-db.p
      663       ( input p-db-num
      664        ,input "unload_db":U
      665        ,buffer buf-new_db
      666       ) no-error.
      667     if error-status :error then do:
      668       message
      669         vss-workfile vss-revision vss-description skip
      670         substitute( "Ошибка при блокировке БД" ) skip
      671         return-value skip
      672         error-status :get-message ( error-status :num-messages )
      673         view-as alert-box error
      674       .
      675       return error .
      676     end.
      677     assign
      678       v-db-num     = buf-new_db.db-num
      679       v-db-key     = "":U
      680       v-db-key-enc = "":U
      681       v-recid      = recid( buf-new_db )
      682     .
      683     buffer-copy buf-new_db to t_db .
      684     do transaction
      685     on error  undo, return error
      686     on stop   undo, return error
      687     on endkey undo, return error
      688     :
      689       run adm/dbi.w
      690         ( input "unld"
      691          ,input-output v-recid
      692          ,output v-unload-history
      693         ).
      694       if v-recid = ? then do:
      695         buffer-copy t_db to buf-new_db .
      696         return error.
      697       end.
      698       find first buf-new_db
      699         where buf-new_db.db-num = p-db-num
      700       .
      701       assign
      702         v-db-key     = buf-new_db.db-key
      703         v-db-key-enc = buf-new_db.db-key-enc
      704       .
      705       run db-attr-write ( input p-db-num
      706                          ,input 'last-unload-db-key':U
      707                          ,input v-db-key
      708                         ) no-error.
      709       run nws/nws-stop.p
      710         ( input  "stop":U
      711          ,input  v-db-num
      712          ,output v-answer
      713         ) no-error .
      714       if error-status :error
      715         or v-answer = false
      716       then do:
      717         buffer-copy t_db to buf-new_db .
      718         run del-db-key ( input v-db-key ).
      719         message
      720           vss-workfile vss-revision vss-description skip
      721           substitute( "Не удалось заблокировать СПН для БД &1", v-db-num ) skip
      722           return-value skip
      723           error-status :get-message ( error-status :num-messages )
      724           view-as alert-box error
      725         .
      726         return error.
      727       end.
      728     end.
      729     run adm/add-db.w ( input  v-db-num
      730                  ,output v-type-unload
      731                 ) no-error.
      732     if error-status:error
      733       or v-type-unload = ?
      734     then do:
      735       do transaction
      736       on error undo, return error
      737       :
      738         buffer-copy t_db to buf-new_db .
      739         run del-db-key ( input v-db-key ).
      740       end.
      741       message
      742         vss-workfile vss-revision vss-description skip
      743         substitute( "УБД &1 не создана", v-db-num ) skip
      744         return-value skip
      745         error-status :get-message ( error-status :num-messages )
      746         view-as alert-box error
      747       .
      748       run adm/unloaddc.p no-error .
      749       if error-status :error then do:
      750         message
      751           vss-workfile vss-revision vss-description skip
      752           substitute( "Не удалось отключить БД" ) skip
      753           return-value skip
      754           error-status :get-message ( error-status :num-messages )
      755           view-as alert-box error
      756         .
      757       end.
      758       return error.
      759     end.
      760     run adm/rest-rdb.p
      761       ( input v-db-num
      762        ,input v-db-key
      763        ,input v-db-key-enc
      764        ,input v-type-unload
      765        ,input v-unload-history
      766       ) no-error .
      767     if error-status :error
      768       or return-value = "not-create":U
      769     then do:
      770       assign
      771         v-err = error-status :get-message( error-status :num-messages ) + chr(10) + return-value
      772       .
      773       do transaction
      774       on error undo, return error
      775       :
      776         run adm/lock-db.p
      777           ( input p-db-num
      778           ,input "unload_db":U
      779           ,buffer buf-new_db
      780           ) no-error.
      781         if error-status :error then do:
      782           message
      783             vss-workfile vss-revision vss-description skip
      784             substitute( "Ошибка при разблокировке БД" ) skip
      785             return-value skip
      786             error-status :get-message ( error-status :num-messages )
      787             view-as alert-box error
      788           .
      789           return error .
      790         end.
      791         if return-value = "not-create":U then do:
      792           message
      793             "Отказ от выгрузки УБД" skip
      794             "База данных" v-db-num skip
      795             view-as alert-box information
      796           .
      797         end.
      798         else do:
      799           message
      800             vss-workfile vss-revision vss-description skip
      801             "Ошибка при выгрузке таблиц БД" skip
      802             "База данных" v-db-num skip
      803             v-err skip
      804             view-as alert-box error
      805           .
      806         end.
      807       end.
      808       run adm/unloaddc.p no-error .
      809       if error-status :error then do:
      810         message
      811           vss-workfile vss-revision vss-description skip
      812           substitute( "Не удалось отключить БД" ) skip
      813           return-value skip
      814           error-status :get-message ( error-status :num-messages )
      815           view-as alert-box error
      816         .
      817       end.
      818       return error.
      819     end.
      820     run adm/unloaddc.p no-error .
      821     if error-status :error then do:
      822       message
      823         vss-workfile vss-revision vss-description skip
      824         substitute( "Не удалось отключить БД" ) skip
      825         return-value skip
      826         error-status :get-message ( error-status :num-messages )
      827         view-as alert-box error
      828       .
      829       return error .
      830     end.
      831     find first buf-new_db
      832       where buf-new_db.db-num = p-db-num
      833     .
      834     if v-db-key <> "":U
      835       and buf-new_db.db-key = v-db-key
      836     then do:
      837       run str/callnews.p ( input 'db':U
      838                      ,input (buffer buf-new_db:handle )
      839                     ) no-error .
      840       if error-status :error then do:
      841         message
      842           vss-workfile vss-revision vss-description skip
      843           "Ошибка при отправке новостей о выгруженной БД" skip
      844           "База данных" v-db-num skip
      845           error-status :get-message(1) skip
      846           return-value skip
      847           view-as alert-box error
      848         .
      849         return error.
      850       end.
      851     end.
      852   end.
