      493       (input  p-obj-type
      494       ,input  p-obj-code
      495       ,input  p-upper-param-code
      496       ,input  p-mode
      497       ,input-output table-handle p-tth
      498       ,output p-all-found
      499       ) no-error .
      500     if error-status :error
      501     then do:
      502       delete object p-tth.
      503       undo, return error return-value .
      504     end.
      505     delete object p-tth.
      506   end.
      507   end procedure.
