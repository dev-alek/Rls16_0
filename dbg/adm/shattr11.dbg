      618   procedure proc-alt-shift-f2:
      619     if not ibs.th.gbl.gbl-var:rcode
      620   then
      621     run gbl\inidebug.p .
      622   end.
      623   procedure proc-alt-shift-f3:
      624     run gbl/prvssinf.p
      625       ( input this-procedure
      626       ) .
      627   end.
      628   define variable v-inform-launched as logical no-undo initial false .
      629   procedure proc-alt-shift-f4:
      630     define variable v-action as character no-undo .
      631     if v-inform-launched = false then do:
      632       assign
      633         v-inform-launched = true
      634       .
      635       run gbl/d-inform.w
      636         (  input self
      637         ,  input this-procedure
      638         , output v-action
      639         ) no-error .
      640       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      641       assign
      642         v-inform-launched = false
      643       .
      644     end.
      645   end.
      646   procedure proc-alt-f1:
      647     run gbl/corrhelp.p
      648       (input this-procedure
      649       ) .
      650   end .
      651   on alt-shift-f2 anywhere do:
      652     run proc-alt-shift-f2.
      653   end.
      654   on alt-shift-f3 anywhere do:
      655     run proc-alt-shift-f3 in this-procedure .
      656   end.
      657   on alt-shift-f4 anywhere do:
      658     run proc-alt-shift-f4 in this-procedure.
      659   end.
      660   on alt-f1 anywhere do:
      661     run proc-alt-f1 in this-procedure .
      662   end.
      663   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664     define variable v-cntxt-db-num        as integer   no-undo .
      665     define variable v-cntxt-userid        as character no-undo .
      666     define variable v-cntxt-level         as character no-undo .
      667     define variable v-cntxt-host-code-obj as integer   no-undo .
      668     define variable v-cntxt-obj-type      as character no-undo .
      669     define variable v-cntxt-obj-code      as integer   no-undo .
      670     define variable v-cntxt-db-num-obj    as integer   no-undo .
      671     define variable v-cntxt-is-admin      as logical   no-undo .
      672   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      673   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      674   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      675   DEFINE VARIABLE v-host-code LIKE ub.shop.host-code NO-UNDO.
      676   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
      677   DEFINE VARIABLE v-r-b-code LIKE ub.currency.curr-code NO-UNDO.
      678   DEFINE BUFFER buf_currency FOR ub.currency.
      679   DEFINE BUFFER buf_cash-pay-nal FOR ub.cash-pay.
      680   DEFINE BUFFER buf_cash-pay-ntnl FOR ub.cash-pay.
      681   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      682   define variable v-tth as handle no-undo .
      683   assign
      684   v-tth = buffer thbjattr_thbj-attr:table-handle .
      685   DEFINE BUTTON B-add  NO-FOCUS
      686        LABEL "&Добавить"
      687        SIZE 10 BY 1.
      688   DEFINE BUTTON b-cash-pay-nal
      689        IMAGE-UP FILE "btn-down-arrow":U
      690        IMAGE-DOWN FILE "btn-down-arrow":U
      691        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      692        LABEL "":L
      693        SIZE 3 BY 1
      694        BGCOLOR 8 FGCOLOR 0 .
      695   DEFINE BUTTON b-cash-pay-ntnl
      696        IMAGE-UP FILE "btn-down-arrow":U
      697        IMAGE-DOWN FILE "btn-down-arrow":U
      698        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      699        LABEL "":L
      700        SIZE 3 BY 1
      701        BGCOLOR 8 FGCOLOR 0 .
      702   DEFINE BUTTON b-curr
      703        IMAGE-UP FILE "btn-down-arrow":U
      704        IMAGE-DOWN FILE "btn-down-arrow":U
      705        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      706        LABEL "":L
      707        SIZE 3 BY 1
      708        BGCOLOR 8 FGCOLOR 0 .
      709   DEFINE BUTTON B-del
      710        LABEL "&Удалить"
      711        SIZE 10 BY 1.
      712   DEFINE BUTTON B-exit AUTO-GO
      713        LABEL "&Ввод"
      714        SIZE 10 BY 1
      715        BGCOLOR 8 .
      716   DEFINE BUTTON B-Help
      717        LABEL "Помо&щь"
      718        SIZE 10 BY 1
      719        BGCOLOR 8 .
      720   DEFINE BUTTON b-quit AUTO-END-KEY
      721        LABEL "&Отмена"
      722        SIZE 10 BY 1
      723        BGCOLOR 8 .
      724   DEFINE VARIABLE f-ipcsbasc AS INTEGER FORMAT ">>9":U INITIAL 0
      725        LABEL "Код валюты, соответствующий баз. вал. КАССЫ"
      726        VIEW-AS FILL-IN
      727        SIZE 7 BY 1 NO-UNDO.
      728   DEFINE VARIABLE f-omrbase AS INTEGER FORMAT ">>9":U INITIAL 0
      729        VIEW-AS FILL-IN
      730        SIZE 7 BY 1 NO-UNDO.
      731   DEFINE VARIABLE f-omrnal AS INTEGER FORMAT ">>>9":U INITIAL 0
      732        LABEL "с кодом валюты равным коду баз. валюты НА КАССЕ"
      733         VIEW-AS TEXT
      734        SIZE 7 BY .67 NO-UNDO.
      735   DEFINE VARIABLE f-omrntnl AS INTEGER FORMAT ">>>9":U INITIAL 0
      736        LABEL "с кодом валюты равным коду баз. валюты НА КАССЕ"
      737         VIEW-AS TEXT
      738        SIZE 7 BY .67 NO-UNDO.
      739   DEFINE VARIABLE for-cash-pay-nal AS CHARACTER FORMAT "X(256)":U
      740         VIEW-AS TEXT
      741        SIZE 20.5 BY .67
      742        FGCOLOR 4  NO-UNDO.
      743   DEFINE VARIABLE for-cash-pay-ntnl AS CHARACTER FORMAT "X(256)":U
      744         VIEW-AS TEXT
      745        SIZE 20.5 BY .67
      746        FGCOLOR 4  NO-UNDO.
      747   DEFINE VARIABLE for-curr-name AS CHARACTER FORMAT "X(256)":U
      748         VIEW-AS TEXT
      749        SIZE 6.75 BY .67
      750        FGCOLOR 4  NO-UNDO.
      751   DEFINE VARIABLE l-omrnal AS CHARACTER FORMAT "X(256)":U INITIAL "Тип кассового платежа, соответствующий оплате <НАЛИЧНЫЕ> НА КАССЕ"
      752         VIEW-AS TEXT
      753        SIZE 65 BY .67 NO-UNDO.
      754   DEFINE VARIABLE l-omrntnl AS CHARACTER FORMAT "X(256)":U INITIAL "Тип кассового платежа, соответствующий оплате БЕЗНАЛИЧНЫЕ НА КАССЕ"
      755         VIEW-AS TEXT
      756        SIZE 67 BY .67 NO-UNDO.
      757   DEFINE QUERY BR-cash-pay FOR
      758         tt-cash-pay-omr SCROLLING.
      759   DEFINE BROWSE BR-cash-pay
      760     QUERY BR-cash-pay NO-LOCK DISPLAY
      761         omr-pay-code COLUMN-LABEL "Код оплаты!на кассе" FORMAT ">>>>9":U
      762         tt-cash-pay-omr.cdpay-code COLUMN-LABEL "Тип кассового!платежа (в BO)" FORMAT ">>>9":U
      763         tt-cash-pay-omr.curr-code COLUMN-LABEL "Код!валюты" FORMAT ">>9":U
      764         tt-cash-pay-omr.obj-name COLUMN-LABEL "Название типа кассового платежа" FORMAT "X(40)":U
      765               WIDTH 56.75
      766       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25
      767            TITLE "Соответствие кодов оплат НА КАССЕ типам кассовых платежей в BO" EXPANDABLE.
      768   DEFINE FRAME Dialog-Frame
      769        B-add AT ROW 9.75 COL 1
      770        B-exit AT ROW 1 COL 1
      771        b-quit AT ROW 1 COL 11
      772        B-Help AT ROW 1 COL 54.88
      773        f-omrbase AT ROW 2.5 COL 65 COLON-ALIGNED NO-LABEL
      774        f-ipcsbasc AT ROW 2.5 COL 65 COLON-ALIGNED
      775        b-curr AT ROW 2.5 COL 75
      776        b-cash-pay-nal AT ROW 4.75 COL 70.5
      777        b-cash-pay-ntnl AT ROW 6.75 COL 70.5
      778        B-del AT ROW 9.75 COL 11
      779        BR-cash-pay AT ROW 11.25 COL 1
      780        for-curr-name AT ROW 2.75 COL 76.5 COLON-ALIGNED NO-LABEL
      781        l-omrnal AT ROW 4 COL 2 NO-LABEL
      782        f-omrnal AT ROW 4.92 COL 61 COLON-ALIGNED
      783        for-cash-pay-nal AT ROW 4.92 COL 73.5 COLON-ALIGNED NO-LABEL
      784        l-omrntnl AT ROW 6 COL 2 NO-LABEL
      785        f-omrntnl AT ROW 6.92 COL 61 COLON-ALIGNED
      786        for-cash-pay-ntnl AT ROW 7 COL 73.5 COLON-ALIGNED NO-LABEL
      787        SPACE(3.24) SKIP(11.65)
      788       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      789            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      790            TITLE "Параметры POS OMRON"
      791            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      792   ASSIGN
      793          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      794          FRAME Dialog-Frame:HIDDEN           = TRUE.
      795   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      796   DO:
      797     APPLY "END-ERROR":U TO SELF.
      798   END.
      799   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      800   DO:
      801     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      802     DEFINE VARIABLE v-log AS logical NO-UNDO.
      803     DEFINE variable v-rid AS RECID NO-UNDO.
      804     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      805     DEFINE BUFFER buf_tt-cash-pay-omr FOR tt-cash-pay-omr.
      806     DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      807     define variable ii as integer no-undo .
      808     define variable ii-max as integer no-undo .
      809     find last buf_tt-cash-pay-omr use-index pi no-error .
      810     if available buf_tt-cash-pay-omr then do:
      811       assign
      812       ii-max = buf_tt-cash-pay-omr.omr-pay-code
      813       .
      814     end.
      815     do ii = 1 to MAX(ii-max, 12):
      816       find first buf_tt-cash-pay-omr where
      817                 buf_tt-cash-pay-omr.omr-pay-code = ii no-error.
      818       if not available buf_tt-cash-pay-omr then leave.
      819     end.
      820     if available buf_tt-cash-pay-omr then do:
      821       message
      822       "Все соответствия уже заданы"
      823       view-as alert-box error .
      824       return no-apply.
      825     end.
      826      run ref/cashpays.w (
      827                  input parparentproc
      828                 ,input  "b-sel":U
      829                 ,input 'все':U
      830                 ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      831                 ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      832                 ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      833                 ,OUTPUT v-rid-list) NO-ERROR.
      834   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
      835   FIND FIRST buf_cash-pay NO-LOCK WHERE
      836           RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
      837   IF NOT AVAILABLE buf_cash-pay  THEN RETURN NO-APPLY.
      838   CREATE tt-cash-pay-omr.
      839   BUFFER-COPY buf_cash-pay
      840      TO tt-cash-pay-omr
      841      ASSIGN
      842      tt-cash-pay-omr.omr-pay-code = ii
      843      v-rid = RECID(tt-cash-pay-omr)
      844      .
      845      RUN openbr IN THIS-PROCEDURE.
      846      REPOSITION br-cash-pay TO RECID v-rid.
      847   END.
      848   ON CHOOSE OF b-cash-pay-nal IN FRAME Dialog-Frame
      849   DO:
      850       define variable v-rid-list as character no-undo.
      851       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      852       run ref/cashpays.w ( input parparentproc
      853                     ,input "b-sel"
      854                     ,input 'все':U
      855                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      856                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      857                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      858                     ,output v-rid-list ).
      859       if v-rid-list <> "":U then do:
      860         FIND FIRST buf_cash-pay WHERE
      861                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      862         IF buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      863             MESSAGE
      864             substitute("Нужно выбрать тип кассового платежа с валютой &1 - валюта продажи на фирме &2", buf_currency.curr-code, v-host-code)
      865             VIEW-AS ALERT-BOX ERROR.
      866             RETURN NO-APPLY.
      867         END.
      868         DISPLAY
      869         buf_cash-pay.cdpay-code @ f-omrnal
      870         buf_cash-pay.obj-name @ for-cash-pay-nal
      871         with frame Dialog-Frame .
      872       end.
      873   END.
      874   ON CHOOSE OF b-cash-pay-ntnl IN FRAME Dialog-Frame
      875   DO:
      876       define variable v-rid-list as character no-undo.
      877       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      878       run ref/cashpays.w (
      879                      input parparentproc
      880                     ,input "b-sel"
      881                     ,input 'все':U
      882                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
      883                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
      884                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
      885                     ,output v-rid-list ).
      886       if v-rid-list <> "":U then do:
      887         FIND FIRST buf_cash-pay WHERE
      888                   recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
      889         IF buf_cash-pay.curr-code <> v-r-b-code THEN DO:
      890             MESSAGE
      891             substitute("Нужно выбрать тип кассового платежа с валютой &1 - валюта продажи на фирме &2", buf_currency.curr-code, v-host-code)
      892             VIEW-AS ALERT-BOX ERROR.
      893             RETURN NO-APPLY.
      894         END.
      895         DISPLAY
      896         buf_cash-pay.cdpay-code @ f-omrntnl
      897         buf_cash-pay.obj-name @ for-cash-pay-ntnl
      898         with frame Dialog-Frame .
      899       end.
      900   END.
      901   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
      902   DO:
      903       define variable rr as recid no-undo.
      904       DEFINE BUFFER buf_currency FOR ub.currency.
      905       rr = ? .
      906       run ref/currency.w (input parparentproc, "b-sel", input-output rr ).
      907       if rr <> ? then do:
      908         FIND FIRST buf_currency WHERE
      909                   recid( buf_currency ) = rr NO-LOCK .
      910         DISPLAY
      911         buf_currency.curr-code @ f-omrbase
      912         buf_currency.curr-abbr @ for-curr-name
      913         with frame Dialog-Frame .
      914       end.
      915   END.
      916   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      917   DO:
      918     IF NOT AVAILABLE tt-cash-pay-omr THEN RETURN NO-APPLY.
      919     DELETE tt-cash-pay-omr.
      920     RUN openbr IN THIS-PROCEDURE.
      921     REPOSITION br-cash-pay TO ROW 1.
      922   END.
      923   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      924   DO:
      925     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      926     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      927   END.
      928   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      929   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      930   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   on help of frame Dialog-Frame
      932   do:
      933     run gbl/app_help.p
      934       (input this-procedure :file-name
      935       ,input ''
      936       ,input ?
      937       ) no-error.
      938     if error-status :error then do:
      939       message
      940         "Ошибка при вызове помощи"
      941         error-status :get-message(1)
      942         view-as alert-box .
      943     end.
      944   end.
      945   run minbtn-set in this-procedure .
      946   on choose of b-help in frame Dialog-Frame
      947   do:
      948     apply "help":u to frame Dialog-Frame .
      949   end.
      950   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   procedure minbtn-set :
      952       do
      953           on error undo, return error return-value
      954           :
      955           define variable ii              as integer       no-undo .
      956           define variable fh              as widget-handle no-undo .
      957           define variable hh              as widget-handle no-undo .
      958           define variable v-h             as handle        extent 4 no-undo .
      959           define variable v-name-button   as character     no-undo .
      960           define variable v-help-old-x    as decimal       no-undo .
      961           define variable v-help-old-y    as decimal       no-undo .
      962           define variable v-help-old-size as decimal       no-undo .
      963           define variable v-frame-width   as decimal       no-undo .
      964           define variable jj              as integer       no-undo .
      965           do
      966               on error undo, return error
      967               :
      968               assign
      969                   v-frame-width = frame Dialog-Frame:width - 0.3
      970                   fh            = frame Dialog-Frame:first-child
      971                   hh            = fh:first-child
      972                   ii            = 1
      973                   .
      974               do while valid-handle(hh):
      975                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      976                   do:
      977                       case lc(hh:name) :
      978                           when "b-help" then
      979                               do:
      980                                   hh:load-image-up("cmp/b-help.bmp":u) .
      981                                   hh:load-image-down("cmp/b-help.bmp":u) .
      982                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      983                                   hh:TOOLTIP = "Помощь" .
      984                                   v-help-old-x = hh:column .
      985                                   v-help-old-y = hh:row    .
      986                                   v-help-old-size = hh:width .
      987                                   hh:width-chars = 2.5 .
      988                               end.
      989                           when "b-print" then
      990                               do:
      991                                   hh:load-image("cmp/b-print.bmp":u) .
      992                                   hh:TOOLTIP = "Печать" .
      993                                   v-h[ii] = hh:handle .
      994                                   ii = ii + 1 .
      995                                   hh:width-chars = 3 .
      996                               end.
      997                           when "b-history" or
      998                           when "b-hist" then
      999                               do:
     1000                                   hh:load-image("cmp/b-hist.bmp":u) .
     1001                                   hh:TOOLTIP = "История" .
     1002                                   v-h[ii] = hh:handle .
     1003                                   ii = ii + 1 .
     1004                                   hh:width-chars = 3 .
     1005                               end.
     1006                           when "b-sch" then
     1007                               do:
     1008                                   hh:load-image("cmp/b-sch.bmp":u) .
     1009                                   hh:TOOLTIP = "Установка Фильтра" .
     1010                                   v-h[ii] = hh:handle .
     1011                                   ii = ii + 1 .
     1012                                   hh:width-chars = 3 .
     1013                               end.
     1014                           when "b-hist-user" then
     1015                               do:
     1016                                   hh:load-image("cmp/b-hist.bmp":u) .
     1017                                   hh:TOOLTIP = "История пользователя" .
     1018                                   ii = ii + 1 .
     1019                               end.
     1020                       end case.
     1021                   end.
     1022                   hh = hh:next-sibling.
     1023               end.
     1024               b-help:column = v-frame-width - b-help:width-chars.
     1025               jj = 0.
     1026               repeat ii = 4 to 1 by -1 :
     1027                   if valid-handle (v-h[ii] ) then
     1028                   do:
     1029                       jj  = jj + 1 .
     1030                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1031                       v-h[ii]:row    = v-help-old-y .
     1032                   end.
     1033               end.
     1034           end.
     1035       end.
     1036   end procedure.
     1037   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1038   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1039   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1040   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1041   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1042   define variable v-diasize-current-frame-height as decimal   no-undo .
     1043   define variable v-diasize-change-size          as logical   no-undo .
     1044   define variable v-diasize-resize-button        as handle    no-undo .
     1045   define variable v-diasize-wndmax               as logical   no-undo .
     1046   define variable v-diasize-wndstore             as logical   no-undo .
     1047   define variable v-diasize-proc-name            as character no-undo .
     1048   define variable v-diasize-browse-handle        as handle    no-undo .
     1049   define variable v-diasize-browse-number        as integer   no-undo .
     1050   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1051   define temp-table temp-diasize-handle no-undo
     1052     field handle-value  as handle
     1053     field save-position as decimal
     1054     index xpk is primary unique handle-value
     1055     .
     1056   define temp-table temp-browse-handle no-undo
     1057     field browse-type   as character
     1058     field browse-number as integer
     1059     field browse-handle as handle
     1060     field original-size as decimal
     1061     index xpk is primary unique browse-type browse-number
     1062     index xie browse-type browse-handle
     1063   .
     1064   procedure diasize_change-height :
     1065     define input  parameter p-change-value  as decimal   no-undo .
     1066     define input  parameter p-move-resize   as logical   no-undo .
     1067     define variable v-field-group-handle    as handle    no-undo .
     1068     define variable v-object-handle         as handle    no-undo .
     1069     define variable v-frame-height          as decimal   no-undo .
     1070     define variable v-frame-virtual-height  as decimal   no-undo .
     1071     define variable v-browse-height         as decimal   no-undo .
     1072     define variable v-window-height         as decimal   no-undo .
     1073     define variable v-window-virtual-height as decimal   no-undo .
     1074     define variable v-change-sign           as integer   no-undo .
     1075     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1076     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1077     if p-change-value > 0
     1078     then do:
     1079       if frame Dialog-Frame :height + p-change-value
     1080           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1081       then do:
     1082         assign
     1083           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1084                           - (frame Dialog-Frame :height-chars)
     1085         .
     1086         if p-change-value <= 0
     1087         then do:
     1088           run diasize_position-resize-button in this-procedure .
     1089           return .
     1090         end.
     1091       end.
     1092     end.
     1093     if p-change-value < 0
     1094     then do:
     1095       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1096       then do:
     1097         assign
     1098           p-change-value = v-diasize-orig-frame-height
     1099                          - (frame Dialog-Frame :height-chars)
     1100         .
     1101         if p-change-value >= 0
     1102         then do:
     1103           run diasize_position-resize-button in this-procedure .
     1104           return .
     1105         end.
     1106       end.
     1107     end.
     1108     if p-change-value >= 0
     1109     then do:
     1110       assign
     1111         v-change-sign = 1
     1112       .
     1113     end.
     1114     else do:
     1115       assign
     1116         v-change-sign = -1
     1117       .
     1118     end.
     1119     assign
     1120       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1121     .
     1122     if p-change-value = 0
     1123     then do:
     1124       run diasize_position-resize-button in this-procedure .
     1125       return .
     1126     end.
     1127     move_block:
     1128     do
     1129     on error undo move_block, retry move_block
     1130     :
     1131       if retry
     1132       then do:
     1133         do
     1134         on error undo move_block, leave move_block
     1135         :
     1136           if p-change-value > 0
     1137           then do:
     1138             for each buf_temp-diasize-handle
     1139             on error undo, next
     1140             :
     1141               assign
     1142                 v-object-handle = buf_temp-diasize-handle.handle-value
     1143               .
     1144               if v-object-handle <> v-diasize-resize-button
     1145               then do:
     1146                 assign
     1147                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1148                 .
     1149               end.
     1150             end.
     1151             assign
     1152               v-diasize-browse-handle :height = v-browse-height
     1153             .
     1154             for each buf_temp-browse-handle
     1155               where buf_temp-browse-handle.browse-type = 'height':u
     1156             on error undo, next
     1157             :
     1158               assign
     1159                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1160               .
     1161             end.
     1162             assign
     1163               frame Dialog-Frame :height = v-frame-height
     1164             .
     1165             if frame Dialog-Frame :scrollable = true
     1166             then do:
     1167               assign
     1168                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1169               .
     1170             end.
     1171             run diasize_position-resize-button in this-procedure .
     1172           end.
     1173           else do:
     1174             if frame Dialog-Frame :scrollable = true
     1175             then do:
     1176               assign
     1177                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1178               .
     1179             end.
     1180             assign
     1181               frame Dialog-Frame :height = v-frame-height
     1182             .
     1183             assign
     1184               v-diasize-browse-handle :height = v-browse-height
     1185             .
     1186             for each buf_temp-browse-handle
     1187               where buf_temp-browse-handle.browse-type = 'height':u
     1188             on error undo, next
     1189             :
     1190               assign
     1191                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1192               .
     1193             end.
     1194             for each buf_temp-diasize-handle
     1195             on error undo, next
     1196             :
     1197               assign
     1198                 v-object-handle = buf_temp-diasize-handle.handle-value
     1199               .
     1200               if v-object-handle <> v-diasize-resize-button
     1201               then do:
     1202                 assign
     1203                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1204                 .
     1205               end.
     1206             end.
     1207             run diasize_position-resize-button in this-procedure .
     1208           end.
     1209           assign
     1210             v-diasize-change-size = false
     1211           .
     1212           leave move_block .
     1213         end.
     1214       end.
     1215       assign
     1216         v-diasize-need-full-display = true
     1217       .
     1218       if v-diasize-change-size = false
     1219       then do:
     1220         assign
     1221           v-diasize-change-size = true
     1222         .
     1223       end.
     1224       else do:
     1225         return .
     1226       end.
     1227       assign
     1228         v-frame-height = frame Dialog-Frame :height
     1229         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1230         v-browse-height = v-diasize-browse-handle :height
     1231       .
     1232       for each buf_temp-browse-handle
     1233         where buf_temp-browse-handle.browse-type = 'height':u
     1234       :
     1235         assign
     1236           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1237         .
     1238       end.
     1239       for each buf_temp-diasize-handle
     1240       :
     1241         delete buf_temp-diasize-handle .
     1242       end.
     1243       assign
     1244         v-field-group-handle = frame Dialog-Frame :first-child
     1245       .
     1246       do while valid-handle(v-field-group-handle)
     1247       :
     1248         assign
     1249           v-object-handle = v-field-group-handle :first-child
     1250         .
     1251         do while valid-handle(v-object-handle)
     1252         :
     1253           if  v-object-handle <> v-diasize-browse-handle :handle
     1254           and can-query(v-object-handle, "row")
     1255           and can-query(v-object-handle, "height")
     1256           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1257           then do:
     1258             find first buf_temp-browse-handle
     1259               where buf_temp-browse-handle.browse-type   = 'height':u
     1260                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1261               no-error .
     1262             if available buf_temp-browse-handle
     1263             then do:
     1264             end.
     1265             else do:
     1266               create buf_temp-diasize-handle .
     1267               assign
     1268                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1269                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1270               .
     1271             end.
     1272           end.
     1273           assign
     1274             v-object-handle = v-object-handle :next-sibling
     1275           .
     1276         end.
     1277         assign
     1278           v-field-group-handle = v-field-group-handle :next-sibling
     1279         .
     1280       end.
     1281       do with frame Dialog-Frame
     1282       :
     1283         hide v-diasize-resize-button .
     1284         assign
     1285           v-diasize-resize-button :row    = 1
     1286           v-diasize-resize-button :column = 1
     1287         .
     1288       end.
     1289       if p-change-value > 0
     1290       then do:
     1291         if frame Dialog-Frame :scrollable = true
     1292         then do:
     1293           assign
     1294             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1295             no-error .
     1296           if error-status :error
     1297           or error-status :get-message(1) <> ""
     1298           then do:
     1299             undo move_block, retry move_block .
     1300           end.
     1301         end.
     1302         assign
     1303           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1304           no-error .
     1305         if error-status :error
     1306         or error-status :get-message(1) <> ""
     1307         then do:
     1308           undo move_block, retry move_block .
     1309         end.
     1310         assign
     1311           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1312           no-error .
     1313         if error-status :error
     1314         or error-status :get-message(1) <> ""
     1315         then do:
     1316           undo move_block, retry move_block .
     1317         end.
     1318         for each buf_temp-browse-handle
     1319           where buf_temp-browse-handle.browse-type = 'height':u
     1320         on error undo move_block, retry move_block
     1321         :
     1322           assign
     1323             buf_temp-browse-handle.browse-handle :height
     1324               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1325             no-error .
     1326           if error-status :error
     1327           or error-status :get-message(1) <> ""
     1328           then do:
     1329             undo move_block, retry move_block .
     1330           end.
     1331         end.
     1332         for each buf_temp-diasize-handle
     1333         on error undo move_block, retry move_block
     1334         :
     1335           assign
     1336             v-object-handle = buf_temp-diasize-handle.handle-value
     1337           .
     1338           if v-object-handle <> v-diasize-resize-button
     1339           then do:
     1340             assign
     1341               v-object-handle :row = v-object-handle :row + p-change-value
     1342               no-error .
     1343             if error-status :error
     1344             or error-status :get-message(1) <> ""
     1345             then do:
     1346               undo move_block, retry move_block .
     1347             end.
     1348           end.
     1349         end.
     1350       end.
     1351       else do:
     1352         for each buf_temp-diasize-handle
     1353         on error undo move_block, retry move_block
     1354         :
     1355           assign
     1356             v-object-handle = buf_temp-diasize-handle.handle-value
     1357           .
     1358           if v-object-handle <> v-diasize-resize-button
     1359           then do:
     1360             assign
     1361               v-object-handle :row = v-object-handle :row + p-change-value
     1362               no-error .
     1363             if error-status :error
     1364             or error-status :get-message(1) <> ""
     1365             then do:
     1366               undo move_block, retry move_block .
     1367             end.
     1368           end.
     1369         end.
     1370         assign
     1371           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1372           no-error .
     1373         if error-status :error
     1374         or error-status :get-message(1) <> ""
     1375         then do:
     1376           undo move_block, retry move_block .
     1377         end.
     1378         for each buf_temp-browse-handle
     1379           where buf_temp-browse-handle.browse-type = 'height':u
     1380         on error undo move_block, retry move_block
     1381         :
     1382           assign
     1383             buf_temp-browse-handle.browse-handle :height
     1384               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1385             no-error .
     1386           if error-status :error
     1387           or error-status :get-message(1) <> ""
     1388           then do:
     1389             undo move_block, retry move_block .
     1390           end.
     1391         end.
     1392         assign
     1393           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1394           no-error .
     1395         if error-status :error
     1396         or error-status :get-message(1) <> ""
     1397         then do:
     1398           undo move_block, retry move_block .
     1399         end.
     1400         if frame Dialog-Frame :scrollable = true
     1401         then do:
     1402           assign
     1403             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1404             no-error .
     1405           if error-status :error
     1406           or error-status :get-message(1) <> ""
     1407           then do:
     1408             undo move_block, retry move_block .
     1409           end.
     1410         end.
     1411       end.
     1412       if p-move-resize = true
     1413       then do:
     1414         run diasize_position-resize-button in this-procedure .
     1415       end.
     1416       if v-diasize-wndstore = true
     1417       then do:
     1418         if connected("ub") = true
     1419         then do:
     1420           define variable v-cntxt-db-num        as integer   no-undo .
     1421           define variable v-cntxt-userid        as character no-undo .
     1422           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1423                                             , OUTPUT v-cntxt-userid
     1424                                             ) .
     1425           run gbl/wndsizew.p
     1426             (input  v-cntxt-db-num
     1427             ,input  v-cntxt-userid
     1428             ,input  v-diasize-proc-name
     1429             ,input  'height':u
     1430             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1431             ) .
     1432         end.
     1433       end.
     1434     end.
     1435     assign
     1436       v-diasize-change-size = false
     1437     .
     1438   end procedure.
     1439   procedure diasize_set-height :
     1440     define input  parameter p-new-height  as decimal   no-undo .
     1441     define input  parameter p-move-resize as logical   no-undo .
     1442     do
     1443     on error undo, return error return-value
     1444     :
     1445       run diasize_change-height in this-procedure
     1446         (input  (p-new-height - frame Dialog-Frame :height)
     1447         ,input  p-move-resize
     1448         ) .
     1449     end.
     1450   end procedure.
     1451   procedure diasize_change-width :
     1452     define input  parameter p-change-value as decimal   no-undo .
     1453     define input  parameter p-move-resize  as logical   no-undo .
     1454     define variable v-field-group-handle   as handle    no-undo .
     1455     define variable v-object-handle        as handle    no-undo .
     1456     define variable v-frame-width          as decimal   no-undo .
     1457     define variable v-frame-virtual-width  as decimal   no-undo .
     1458     define variable v-browse-width         as decimal   no-undo .
     1459     define variable v-window-width         as decimal   no-undo .
     1460     define variable v-window-virtual-width as decimal   no-undo .
     1461     define variable v-change-sign          as integer   no-undo .
     1462     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1463     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1464     if p-change-value > 0
     1465     then do:
     1466       if frame Dialog-Frame :width + p-change-value >
     1467           session :width-chars
     1468       then do:
     1469         assign
     1470           p-change-value = session :width-chars - frame Dialog-Frame :width
     1471         .
     1472         if p-change-value <= 0
     1473         then do:
     1474           run diasize_position-resize-button in this-procedure .
     1475           return .
     1476         end.
     1477       end.
     1478     end.
     1479     if p-change-value < 0
     1480     then do:
     1481       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1482       then do:
     1483         assign
     1484           p-change-value = v-diasize-orig-frame-width
     1485                          - frame Dialog-Frame :width
     1486         .
     1487         if p-change-value >= 0
     1488         then do:
     1489           run diasize_position-resize-button in this-procedure .
     1490           return .
     1491         end.
     1492       end.
     1493     end.
     1494     if p-change-value >= 0
     1495     then do:
     1496       assign
     1497         v-change-sign = 1
     1498       .
     1499     end.
     1500     else do:
     1501       assign
     1502         v-change-sign = -1
     1503       .
     1504     end.
     1505     assign
     1506       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1507     .
     1508     if p-change-value = 0
     1509     then do:
     1510       run diasize_position-resize-button in this-procedure .
     1511       return .
     1512     end.
     1513     move_block:
     1514     do
     1515     on error undo move_block, leave move_block
     1516     :
     1517       if retry
     1518       then do:
     1519         do
     1520         on error undo move_block, leave move_block
     1521         :
     1522           if p-change-value > 0
     1523           then do:
     1524             for each buf_temp-diasize-handle
     1525             on error undo, next
     1526             :
     1527               assign
     1528                 v-object-handle = buf_temp-diasize-handle.handle-value
     1529               .
     1530               if v-object-handle <> v-diasize-resize-button
     1531               then do:
     1532                 assign
     1533                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1534                 .
     1535               end.
     1536             end.
     1537             assign
     1538               v-diasize-browse-handle :width = v-browse-width
     1539             .
     1540             for each buf_temp-browse-handle
     1541               where buf_temp-browse-handle.browse-type = 'width':u
     1542             on error undo, next
     1543             :
     1544               assign
     1545                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1546               .
     1547             end.
     1548             assign
     1549               frame Dialog-Frame :width = v-frame-width
     1550             .
     1551             if frame Dialog-Frame :scrollable = true
     1552             then do:
     1553               assign
     1554                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1555               .
     1556             end.
     1557             run diasize_position-resize-button in this-procedure .
     1558           end.
     1559           else do:
     1560             if frame Dialog-Frame :scrollable = true
     1561             then do:
     1562               assign
     1563                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1564               .
     1565             end.
     1566             assign
     1567               frame Dialog-Frame :width = v-frame-width
     1568             .
     1569             for each buf_temp-browse-handle
     1570               where buf_temp-browse-handle.browse-type = 'width':u
     1571             on error undo, next
     1572             :
     1573               assign
     1574                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1575               .
     1576             end.
     1577             assign
     1578               v-diasize-browse-handle :width = v-browse-width
     1579             .
     1580             for each buf_temp-diasize-handle
     1581             on error undo, next
     1582             :
     1583               assign
     1584                 v-object-handle = buf_temp-diasize-handle.handle-value
     1585               .
     1586               if v-object-handle <> v-diasize-resize-button
     1587               then do:
     1588                 assign
     1589                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1590                 .
     1591               end.
     1592             end.
     1593             run diasize_position-resize-button in this-procedure .
     1594           end.
     1595           assign
     1596             v-diasize-change-size = false
     1597           .
     1598           leave move_block .
     1599         end.
     1600       end.
     1601       assign
     1602         v-diasize-need-full-display = true
     1603       .
     1604       if v-diasize-change-size = false
     1605       then do:
     1606         assign
     1607           v-diasize-change-size = true
     1608         .
     1609       end.
     1610       else do:
     1611         return .
     1612       end.
     1613       assign
     1614         v-frame-width = frame Dialog-Frame :width
     1615         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1616         v-browse-width = v-diasize-browse-handle :width
     1617       .
     1618       for each buf_temp-browse-handle
     1619         where buf_temp-browse-handle.browse-type = 'width':u
     1620       :
     1621         assign
     1622           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1623         .
     1624       end.
     1625       for each buf_temp-diasize-handle
     1626       :
     1627         delete buf_temp-diasize-handle .
     1628       end.
     1629       assign
     1630         v-field-group-handle = frame Dialog-Frame :first-child
     1631       .
     1632       do while valid-handle(v-field-group-handle)
     1633       :
     1634         assign
     1635           v-object-handle = v-field-group-handle :first-child
     1636         .
     1637         do while valid-handle(v-object-handle)
     1638         :
     1639           if  v-object-handle <> v-diasize-browse-handle :handle
     1640           and v-object-handle <> v-diasize-resize-button
     1641           and can-query(v-object-handle, "row")
     1642           and can-query(v-object-handle, "height")
     1643           and ( v-object-handle :col + v-object-handle :width
     1644                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1645               )
     1646           then do:
     1647             find first buf_temp-browse-handle
     1648               where buf_temp-browse-handle.browse-type   = 'width':u
     1649                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1650               no-error .
     1651             if available buf_temp-browse-handle
     1652             then do:
     1653             end.
     1654             else do:
     1655               create buf_temp-diasize-handle .
     1656               assign
     1657                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1658                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1659               .
     1660             end.
     1661           end.
     1662           assign
     1663             v-object-handle = v-object-handle :next-sibling
     1664           .
     1665         end.
     1666         assign
     1667           v-field-group-handle = v-field-group-handle :next-sibling
     1668         .
     1669       end.
     1670       do with frame Dialog-Frame
     1671       :
     1672         hide v-diasize-resize-button .
     1673         v-diasize-resize-button :row = 1.
     1674         v-diasize-resize-button :column = 1.
     1675       end.
     1676       if p-change-value > 0
     1677       then do:
     1678         if frame Dialog-Frame :scrollable = true
     1679         then do:
     1680           assign
     1681             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1682             no-error .
     1683           if error-status :error
     1684           or error-status :get-message(1) <> ""
     1685           then do:
     1686             undo move_block, retry move_block.
     1687           end.
     1688         end.
     1689         assign
     1690           frame Dialog-Frame :width = v-frame-width + p-change-value
     1691           no-error .
     1692         if error-status :error
     1693         or error-status :get-message(1) <> ""
     1694         then do:
     1695           undo move_block, retry move_block.
     1696         end.
     1697         assign
     1698           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1699         no-error .
     1700         if error-status :error
     1701         or error-status :get-message(1) <> ""
     1702         then do:
     1703           undo move_block, retry move_block.
     1704         end.
     1705         for each buf_temp-browse-handle
     1706           where buf_temp-browse-handle.browse-type = 'width':u
     1707         on error undo move_block, retry move_block
     1708         :
     1709           assign
     1710             buf_temp-browse-handle.browse-handle :width
     1711               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1712             no-error .
     1713           if error-status :error
     1714           or error-status :get-message(1) <> ""
     1715           then do:
     1716             undo move_block, retry move_block .
     1717           end.
     1718         end.
     1719         for each buf_temp-diasize-handle
     1720         on error undo move_block, retry move_block
     1721         :
     1722           assign
     1723             v-object-handle = buf_temp-diasize-handle.handle-value
     1724           .
     1725           if v-object-handle <> v-diasize-resize-button
     1726           then do:
     1727             assign
     1728               v-object-handle :col = v-object-handle :col + p-change-value
     1729               no-error .
     1730             if error-status :error
     1731             or error-status :get-message(1) <> ""
     1732             then do:
     1733               undo move_block, retry move_block .
     1734             end.
     1735           end.
     1736         end.
     1737       end.
     1738       else do:
     1739         for each buf_temp-diasize-handle
     1740         on error undo move_block, retry move_block
     1741         :
     1742           assign
     1743             v-object-handle = buf_temp-diasize-handle.handle-value
     1744           .
     1745           if v-object-handle <> v-diasize-resize-button
     1746           then do:
     1747             assign
     1748               v-object-handle :col = v-object-handle :col + p-change-value
     1749               no-error .
     1750             if error-status :error
     1751             or error-status :get-message(1) <> ""
     1752             then do:
     1753               undo move_block, retry move_block .
     1754             end.
     1755           end.
     1756         end.
     1757         for each buf_temp-browse-handle
     1758           where buf_temp-browse-handle.browse-type = 'width':u
     1759         on error undo move_block, retry move_block
     1760         :
     1761           assign
     1762             buf_temp-browse-handle.browse-handle :width
     1763               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1764             no-error .
     1765           if error-status :error
     1766           or error-status :get-message(1) <> ""
     1767           then do:
     1768             undo move_block, retry move_block .
     1769           end.
     1770         end.
     1771         assign
     1772           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1773           no-error .
     1774         if error-status :error
     1775         or error-status :get-message(1) <> ""
     1776         then do:
     1777           undo move_block, retry move_block.
     1778         end.
     1779         assign
     1780           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1781         no-error .
     1782         if error-status :error
     1783         or error-status :get-message(1) <> ""
     1784         then do:
     1785           undo move_block, retry move_block.
     1786         end.
     1787         if frame Dialog-Frame :scrollable = true
     1788         then do:
     1789           assign
     1790             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1791           no-error .
     1792           if error-status :error
     1793           or error-status :get-message(1) <> ""
     1794           then do:
     1795             undo move_block, retry move_block.
     1796           end.
     1797         end.
     1798       end.
     1799       if p-move-resize
     1800       then do:
     1801         run diasize_position-resize-button in this-procedure .
     1802       end.
     1803       if v-diasize-wndstore = true
     1804       then do:
     1805         if connected("ub") = true
     1806         then do:
     1807           define variable v-cntxt-db-num        as integer   no-undo .
     1808           define variable v-cntxt-userid        as character no-undo .
     1809           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1810                                             , OUTPUT v-cntxt-userid
     1811                                             ) .
     1812           run gbl/wndsizew.p
     1813             (input  v-cntxt-db-num
     1814             ,input  v-cntxt-userid
     1815             ,input  v-diasize-proc-name
     1816             ,input  'width':u
     1817             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1818             ) .
     1819         end.
     1820       end.
     1821     end.
     1822     assign
     1823       v-diasize-change-size = false
     1824     .
     1825   end procedure.
     1826   procedure diasize_set-width :
     1827     define input  parameter p-new-width  as decimal   no-undo .
     1828     define input  parameter p-move-resize as logical   no-undo .
     1829     do
     1830     on error undo, return error return-value
     1831     :
     1832       run diasize_change-width in this-procedure
     1833         (input  (p-new-width - frame Dialog-Frame :width)
     1834         ,input  p-move-resize
     1835         ) .
     1836     end.
     1837   end procedure.
     1838   procedure diasize_position-resize-button :
     1839     do with frame Dialog-Frame
     1840     :
     1841       hide v-diasize-resize-button .
     1842       assign
     1843         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1844                     - 1
     1845                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1846         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1847                     - 1
     1848                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1849       .
     1850       view v-diasize-resize-button .
     1851     end.
     1852   end procedure.
     1853   on alt-right anywhere
     1854   do:
     1855     run diasize_change-width in this-procedure
     1856       (input 1
     1857       ,input true
     1858       ) .
     1859     return no-apply .
     1860   end.
     1861   on alt-left anywhere
     1862   do:
     1863     run diasize_change-width in this-procedure
     1864       (input -1
     1865       ,input true
     1866       ) .
     1867     return no-apply .
     1868   end.
     1869   on alt-down anywhere
     1870   do:
     1871     run diasize_change-height in this-procedure
     1872       (input 1
     1873       ,input true
     1874       ) .
     1875     return no-apply .
     1876   end.
     1877   on alt-up anywhere
     1878   do:
     1879     run diasize_change-height in this-procedure
     1880       (input -1
     1881       ,input true
     1882       ) .
     1883     return no-apply .
     1884   end.
     1885   on alt-enter of frame Dialog-Frame
     1886   do:
     1887     run diasize_maximize in this-procedure
     1888       (input  ?
     1889       ).
     1890     return no-apply .
     1891   end.
     1892   procedure diasize_end-move :
     1893     do
     1894     on error undo, return error return-value
     1895     :
     1896       define variable v-row-delta as decimal   no-undo .
     1897       define variable v-col-delta as decimal   no-undo .
     1898       define variable v-new-row as decimal   no-undo .
     1899       define variable v-new-col as decimal   no-undo .
     1900       assign
     1901         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1902         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1903       .
     1904       assign
     1905         v-row-delta = v-new-row - frame Dialog-Frame :height
     1906         v-col-delta = v-new-col - frame Dialog-Frame :width
     1907       .
     1908       run diasize_change-height in this-procedure
     1909         (input v-row-delta
     1910         ,input true
     1911         ) .
     1912       run diasize_change-width in this-procedure
     1913         (input v-col-delta
     1914         ,input true
     1915         ) .
     1916     end.
     1917   end procedure.
     1918   procedure diasize_maximize :
     1919     define input  parameter p-action as logical   no-undo .
     1920     do
     1921     on error undo, return error return-value
     1922     :
     1923       if p-action = ?
     1924       then do:
     1925         if v-diasize-need-maximize = true
     1926         then do:
     1927           assign
     1928             p-action = true
     1929           .
     1930         end.
     1931         else do:
     1932           assign
     1933             p-action = false
     1934           .
     1935         end.
     1936       end.
     1937       if p-action = true
     1938       then do:
     1939         run diasize_change-height in this-procedure
     1940           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1941               - frame Dialog-Frame :height-chars
     1942           ,input true
     1943           ) .
     1944         run diasize_change-width in this-procedure
     1945           (input session :width-chars
     1946               - frame Dialog-Frame :width-chars
     1947           ,input true
     1948           ) .
     1949         assign
     1950           v-diasize-need-maximize = false
     1951         .
     1952       end.
     1953       else do:
     1954         run diasize_change-width in this-procedure
     1955           (input v-diasize-orig-frame-width
     1956               - frame Dialog-Frame :width-chars
     1957           ,input true
     1958           ) .
     1959         run diasize_change-height in this-procedure
     1960           (input v-diasize-orig-frame-height
     1961               - frame Dialog-Frame :height-chars
     1962           ,input true
     1963           ) .
     1964         assign
     1965           v-diasize-need-maximize = true
     1966         .
     1967       end.
     1968     end.
     1969   end procedure.
     1970   procedure diasize_restore-orig-size :
     1971     do
     1972     on error undo, return error return-value
     1973     :
     1974       assign
     1975         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1976         v-diasize-current-frame-height = frame Dialog-Frame :height
     1977       .
     1978       run diasize_set-height in this-procedure
     1979         (input  v-diasize-orig-frame-height
     1980         ,input  true
     1981         ) .
     1982       run diasize_set-width in this-procedure
     1983         (input  v-diasize-orig-frame-width
     1984         ,input  true
     1985         ) .
     1986     end.
     1987   end procedure.
     1988   procedure diasize_restore-current-size :
     1989     do
     1990     on error undo, return error return-value
     1991     :
     1992       run diasize_set-height in this-procedure
     1993         (input  v-diasize-current-frame-height
     1994         ,input  true
     1995         ) .
     1996       run diasize_set-width in this-procedure
     1997         (input  v-diasize-current-frame-width
     1998         ,input  true
     1999         ) .
     2000     end.
     2001   end procedure.
     2002   procedure diasize_set-browse-handle :
     2003     define input  parameter p-browse-handle as handle   no-undo .
     2004     define buffer buf_temp-browse-handle for temp-browse-handle .
     2005     do
     2006     on error undo, return error return-value
     2007     :
     2008       assign
     2009         v-diasize-browse-handle = p-browse-handle
     2010       .
     2011       for each buf_temp-browse-handle
     2012       on error undo, return error return-value
     2013       :
     2014         delete buf_temp-browse-handle .
     2015       end.
     2016     end.
     2017   end procedure.
     2018   procedure diasize_add_browse :
     2019     define input  parameter p-browse-type   as character no-undo .
     2020     define input  parameter p-browse-handle as handle    no-undo .
     2021     define buffer buf_temp-browse-handle for temp-browse-handle .
     2022     do
     2023     on error undo, return error return-value
     2024     :
     2025       assign
     2026         v-diasize-browse-number = v-diasize-browse-number + 1
     2027       .
     2028       create buf_temp-browse-handle .
     2029       assign
     2030         buf_temp-browse-handle.browse-type   = p-browse-type
     2031         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2032         buf_temp-browse-handle.browse-handle = p-browse-handle
     2033       .
     2034     end.
     2035   end procedure.
     2036   procedure diasize_init :
     2037     define variable v-default-value    as logical   no-undo .
     2038     define variable v-restore-saved    as logical   no-undo .
     2039     define variable v-resize-value-str as character no-undo .
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       do with frame Dialog-Frame
     2044       :
     2045         assign
     2046           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2047           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2048           v-diasize-browse-handle     = browse BR-cash-pay :handle
     2049         .
     2050         create button v-diasize-resize-button
     2051         assign
     2052           parent        = frame Dialog-Frame :first-child
     2053           label         = "s"
     2054           height-pixels = 16
     2055           width-pixels  = 16
     2056           visible       = true
     2057           sensitive     = true
     2058           movable       = true
     2059           triggers:
     2060             on end-move persistent run diasize_end-move in this-procedure .
     2061           end triggers.
     2062         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2063         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2064         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2065         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2066         assign
     2067           v-diasize-wndmax = false
     2068         .
     2069         if connected("ub") = true
     2070         then do:
     2071           define variable v-cntxt-db-num        as integer   no-undo .
     2072           define variable v-cntxt-userid        as character no-undo .
     2073           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2074                                             , OUTPUT v-cntxt-userid
     2075                                             ) .
     2076           run gbl/wndpar_r.p
     2077             (input  v-cntxt-db-num
     2078             ,input  v-cntxt-userid
     2079             ,input  'wndmax':U
     2080             ,output v-diasize-wndmax
     2081             ,output v-default-value
     2082             ) .
     2083         end.
     2084         assign
     2085           v-diasize-wndstore = false
     2086         .
     2087         if connected("ub") = true
     2088         then do:
     2089           run gbl/wndpar_r.p
     2090             (input  v-cntxt-db-num
     2091             ,input  v-cntxt-userid
     2092             ,input  'wndstore':U
     2093             ,output v-diasize-wndstore
     2094             ,output v-default-value
     2095             ) .
     2096         end.
     2097         assign
     2098           v-diasize-proc-name = entry(1, program-name(2), '.')
     2099         .
     2100         if v-diasize-wndstore = true
     2101         then do:
     2102           assign
     2103             v-restore-saved = false
     2104           .
     2105           if connected("ub") = true
     2106           then do:
     2107             run gbl/wndsizer.p
     2108               (input  v-cntxt-db-num
     2109               ,input  v-cntxt-userid
     2110               ,input  v-diasize-proc-name
     2111               ,input  'height':u
     2112               ,output v-resize-value-str
     2113               ) .
     2114             if v-resize-value-str <> '':U
     2115             then do:
     2116               run diasize_change-height in this-procedure
     2117                 (input  integer(v-resize-value-str)
     2118                 ,input  true
     2119                 ) .
     2120               assign
     2121                 v-restore-saved = true
     2122               .
     2123             end.
     2124           end.
     2125           if connected("ub") = true
     2126           then do:
     2127             run gbl/wndsizer.p
     2128               (input  v-cntxt-db-num
     2129               ,input  v-cntxt-userid
     2130               ,input  v-diasize-proc-name
     2131               ,input  'width':u
     2132               ,output v-resize-value-str
     2133               ) .
     2134             if v-resize-value-str <> '':U
     2135             then do:
     2136               run diasize_change-width in this-procedure
     2137                 (input  integer(v-resize-value-str)
     2138                 ,input  true
     2139                 ) .
     2140               assign
     2141                 v-restore-saved = true
     2142               .
     2143             end.
     2144           end.
     2145           if v-restore-saved <> true
     2146           then do:
     2147             if v-diasize-wndmax = true
     2148             then do:
     2149               run diasize_maximize in this-procedure
     2150                 (input  true
     2151                 ) .
     2152             end.
     2153           end.
     2154         end.
     2155         else do:
     2156           if v-diasize-wndmax = true
     2157           then do:
     2158             run diasize_maximize in this-procedure
     2159               (input  true
     2160               ) .
     2161           end.
     2162         end.
     2163       end.
     2164     end.
     2165   end procedure.
     2166   procedure diasize_need-full-display :
     2167     define output parameter p-need-full-display as logical   no-undo .
     2168     do
     2169     on error undo, return error return-value
     2170     :
     2171       assign
     2172         p-need-full-display = v-diasize-need-full-display
     2173       .
     2174       assign
     2175         v-diasize-need-full-display = false
     2176       .
     2177     end.
     2178   end procedure.
     2179   procedure get-context :
     2180      define output parameter p-db-num as integer          no-undo.
     2181      define output parameter p-user-id as character        no-undo.
     2182      define variable v-login               as character    no-undo.
     2183      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2184      define buffer buf_user-login  for ub.user-login .
     2185      do
     2186      on error undo, return error
     2187      :
     2188            FIND FIRST buf_sys-ctrl no-lock.
     2189            ASSIGN
     2190               v-login = USERID("ub")
     2191               p-db-num = buf_sys-ctrl.db-num
     2192            .
     2193            FIND FIRST buf_user-login
     2194                 WHERE buf_user-login.db-num = p-db-num
     2195                   AND buf_user-login.user-login = v-login
     2196                 no-lock
     2197                 no-error
     2198                 .
     2199            IF AVAILABLE buf_user-login
     2200            THEN DO:
     2201               assign
     2202                  p-user-id = buf_user-login.user-id
     2203               .
     2204            END.
     2205      end.
     2206   end procedure.
     2207       run diasize_init in this-procedure .
     2208   MAIN-BLOCK:
     2209   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2210      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2211   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2212     run mainmenu_getcntxt in parparentproc
     2213       (output v-cntxt-db-num
     2214       ,output v-cntxt-userid
     2215       ,output v-cntxt-level
     2216       ,output v-cntxt-host-code-obj
     2217       ,output v-cntxt-obj-type
     2218       ,output v-cntxt-obj-code
     2219       ,output v-cntxt-db-num-obj
     2220       ,output v-cntxt-is-admin
     2221       ) .
     2222   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2223   ON TAB ANYWHERE
     2224   DO:
     2225   define variable ii as integer no-undo .
     2226   define variable fh as widget-handle no-undo .
     2227   define variable hh as widget-handle no-undo .
     2228   define variable v-next-widget-name as character no-undo .
     2229   if v-tab-order <> '' then do:
     2230     if self:type = "TOGGLE-BOX" then
     2231     self:BGCOLOR = ?.
     2232     assign
     2233     ii = lookup(self:name, v-tab-order).
     2234     assign
     2235     ii = ii + 1
     2236     v-next-widget-name = entry(ii, v-tab-order)
     2237     no-error .
     2238     if error-status:error then do:
     2239       assign
     2240       ii = 1
     2241       v-next-widget-name = entry( ii, v-tab-order)
     2242       .
     2243     end.
     2244     assign
     2245     fh = frame Dialog-Frame:first-child
     2246     hh = fh:first-child
     2247     .
     2248     do while valid-handle(hh):
     2249       if hh:name = v-next-widget-name then do:
     2250         if hh:sensitive  = yes
     2251         AND hh:visible = yes then do:
     2252           if hh:type = "TOGGLE-BOX":U then do:
     2253             assign
     2254             hh:BGcolor = 1
     2255             .
     2256           end.
     2257           APPLY "ENTRY" to hh.
     2258           return no-apply.
     2259         end.
     2260         else do:
     2261           APPLY "TAB" to hh.
     2262           return no-apply.
     2263         end.
     2264       end.
     2265       hh = hh:next-sibling.
     2266     end.
     2267   end.
     2268   END.
     2269   ON BACK-TAB ANYWHERE
     2270   DO:
     2271   define variable ii as integer no-undo .
     2272   define variable fh as widget-handle no-undo .
     2273   define variable hh as widget-handle no-undo .
     2274   define variable v-next-widget-name as character no-undo .
     2275   if v-tab-order <> '' then do:
     2276     assign
     2277     ii = lookup(self:name, v-tab-order).
     2278     .
     2279     assign
     2280     ii = (if ii = 1
     2281           then  num-entries(v-tab-order)
     2282           else ii - 1
     2283           )
     2284     v-next-widget-name = entry(ii, v-tab-order)
     2285     .
     2286     assign
     2287     fh = frame Dialog-Frame:first-child
     2288     hh = fh:first-child
     2289     .
     2290     do while valid-handle(hh):
     2291       if hh:name = v-next-widget-name then do:
     2292         if hh:sensitive  = yes
     2293         AND hh:visible = yes then do:
     2294           if hh:type = "TOGGLE-BOX":U then do:
     2295             assign
     2296             hh:BGcolor = 1
     2297             .
     2298           end.
     2299           APPLY "ENTRY" to hh.
     2300           return no-apply.
     2301         end.
     2302         else do:
     2303         APPLY "BACK-TAB" to hh.
     2304         return no-apply.
     2305         end.
     2306       end.
     2307       hh = hh:next-sibling.
     2308     end.
     2309     end.
     2310   END.
     2311   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2312   ON RETURN ANYWHERE
     2313   DO:
     2314   define variable ii as integer no-undo .
     2315   define variable fh as widget-handle no-undo .
     2316   define variable hh as widget-handle no-undo .
     2317   define variable v-next-widget-name as character no-undo .
     2318     if v-tab-order <> '' then do:
     2319       assign
     2320       ii = lookup(self:name, v-tab-order).
     2321       if ii = num-entries(v-tab-order) then do:
     2322           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2323           return no-apply.
     2324       end.
     2325       if self:type <> "BUTTON" and
     2326         self:type <> "EDITOR"  then do:
     2327         run proc-move-forward in this-procedure .
     2328         return no-apply.
     2329       end.
     2330       if self:type = "BUTTON" then do:
     2331         APPLY "CHOOSE" to self.
     2332       end.
     2333       if self:type = "TOGGLE-BOX" then
     2334       self:BGCOLOR = ?.
     2335       assign
     2336       ii = ii + 1
     2337       v-next-widget-name = entry(ii, v-tab-order)
     2338       no-error .
     2339       if error-status:error then do:
     2340         assign
     2341         ii = 1
     2342         v-next-widget-name = entry( ii, v-tab-order)
     2343         .
     2344       end.
     2345       assign
     2346       fh = frame Dialog-Frame:first-child
     2347       hh = fh:first-child
     2348       .
     2349       do while valid-handle(hh):
     2350         if hh:name = v-next-widget-name then do:
     2351           if hh:sensitive  = yes
     2352           AND hh:visible = yes then do:
     2353             if hh:type = "TOGGLE-BOX":U then do:
     2354               assign
     2355               hh:BGcolor = 1
     2356               .
     2357             end.
     2358             APPLY "ENTRY" to hh.
     2359             return no-apply.
     2360           end.
     2361           else do:
     2362             APPLY "TAB" to hh.
     2363             return no-apply.
     2364           end.
     2365         end.
     2366         hh = hh:next-sibling.
     2367       end.
     2368     end.
     2369   END.
     2370   procedure proc-move-forward :
     2371   define variable ii as integer no-undo .
     2372   define variable fh as widget-handle no-undo .
     2373   define variable hh as widget-handle no-undo .
     2374   define variable v-next-widget-name as character no-undo .
     2375   do
     2376   on error undo, return error
     2377   :
     2378     if v-tab-order <> '' then do:
     2379       if self:type = "TOGGLE-BOX" then
     2380       self:BGCOLOR = ?.
     2381       assign
     2382       ii = lookup(self:name, v-tab-order).
     2383       assign
     2384       ii = ii + 1
     2385       v-next-widget-name = entry(ii, v-tab-order)
     2386       no-error .
     2387       if error-status:error then do:
     2388         assign
     2389         ii = 1
     2390         v-next-widget-name = entry( ii, v-tab-order)
     2391         .
     2392       end.
     2393       assign
     2394       fh = frame Dialog-Frame:first-child
     2395       hh = fh:first-child
     2396       .
     2397       do while valid-handle(hh):
     2398         if hh:name = v-next-widget-name then do:
     2399           if hh:sensitive  = yes
     2400           AND hh:visible = yes then do:
     2401             if hh:type = "TOGGLE-BOX":U then do:
     2402               assign
     2403               hh:BGcolor = 1
     2404               .
     2405             end.
     2406             APPLY "ENTRY" to hh.
     2407             return.
     2408           end.
     2409           else do:
     2410             assign
     2411             ii = ii + 1
     2412             v-next-widget-name = entry(ii, v-tab-order)
     2413             no-error .
     2414             if error-status:error then do:
     2415               assign
     2416               ii = 1
     2417               v-next-widget-name = entry( ii, v-tab-order)
     2418               .
     2419             end.
     2420           end.
     2421         end.
     2422         hh = hh:next-sibling.
     2423       end.
     2424     end.
     2425   end.
     2426   end procedure.
     2427     IF p-mode <> 'ПРОСМОТР':U
     2428     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2429         MESSAGE
     2430         vss-workfile vss-revision vss-description skip
     2431         "Неверное значение параметра p-mode" p-mode
     2432         VIEW-AS ALERT-BOX ERROR.
     2433         UNDO, RETURN ERROR.
     2434     END.
     2435     IF p-obj-type <> 'маг':U
     2436     and p-obj-type <> 'орг':U
     2437     and p-obj-type <> '':U
     2438     THEN DO:
     2439         MESSAGE
     2440         vss-workfile vss-revision vss-description skip
     2441         "Неверное значение параметра p-obj-type" p-obj-type
     2442         VIEW-AS ALERT-BOX ERROR.
     2443         UNDO, RETURN ERROR.
     2444     END.
     2445     if p-obj-type = 'маг':U then do:
     2446       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2447       IF NOT AVAILABLE X_shop THEN DO:
     2448           MESSAGE
     2449           vss-workfile vss-revision vss-description skip
     2450           "Неверное значение параметра p-obj-code" p-obj-code
     2451           VIEW-AS ALERT-BOX ERROR.
     2452           UNDO, RETURN ERROR.
     2453       END.
     2454   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2456     (input  'маг':U
     2457     ,input  p-obj-code
     2458     ,output v-db-num
     2459     )  .
     2460       IF v-db-num <> v-cntxt-db-num
     2461       AND v-cntxt-db-num <> 0
     2462       and p-mode <> 'ПРОСМОТР':U
     2463       THEN DO:
     2464           MESSAGE
     2465           "Нельзя менять параметры магазина в чужой БД" skip
     2466           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2467           VIEW-AS ALERT-BOX ERROR.
     2468           UNDO, RETURN ERROR.
     2469       END.
     2470   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2472     (input  p-obj-type
     2473     ,input  p-obj-code
     2474     ,output v-host-code
     2475     )  .
     2476     end.
     2477     if p-obj-type = 'орг':U then do:
     2478       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2479       IF NOT AVAILABLE X_sysconf THEN DO:
     2480           MESSAGE
     2481           vss-workfile vss-revision vss-description skip
     2482           "Неверное значение параметра p-obj-code" p-obj-code
     2483           VIEW-AS ALERT-BOX ERROR.
     2484           UNDO, RETURN ERROR.
     2485       END.
     2486       if v-cntxt-db-num <> 0
     2487       and p-mode <> 'ПРОСМОТР':U
     2488       then do:
     2489           MESSAGE
     2490           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2491           VIEW-AS ALERT-BOX ERROR.
     2492           UNDO, RETURN ERROR.
     2493       end.
     2494       v-host-code = p-obj-code.
     2495     end.
     2496     if p-obj-type = '':U then do:
     2497       if v-cntxt-db-num <> 0
     2498       and p-mode <> 'ПРОСМОТР':U
     2499       then do:
     2500           MESSAGE
     2501           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2502           VIEW-AS ALERT-BOX ERROR.
     2503           UNDO, RETURN ERROR.
     2504       end.
     2505     end.
     2506     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2507       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2508                 LOCKED_thbj-attr.obj-type = p-obj-type
     2509           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2510           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-omron':U
     2511           AND   locked_thbj-attr.prop-code = '':U  NO-WAIT NO-ERROR.
     2512        if locked locked_thbj-attr then do:
     2513           message
     2514           vss-workfile vss-revision vss-description skip
     2515            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2516           view-as alert-box error .
     2517           undo, return error.
     2518         end.
     2519     END.
     2520     ELSE DO:
     2521         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2522             LOCKED_thbj-attr.obj-type = p-obj-type
     2523       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2524       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-omron':U
     2525       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2526     END.
     2527     if not available locked_thbj-attr then do:
     2528       ASSIGN
     2529       v-to-create  = YES.
     2530       message
     2531       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2532                   chr(10))
     2533       view-as alert-box WARNING.
     2534     end.
     2535   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2537     (input  v-host-code
     2538     ,output v-r-b-code
     2539     )  .
     2540   FIND FIRST buf_currency NO-LOCK WHERE
     2541           buf_currency.curr-code = v-r-b-code .
     2542     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2543     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2544     RUN Myenable.
     2545     WAIT-FOR GO OF FRAME Dialog-Frame.
     2546   END.
     2547   RUN disable_UI.
     2548   PROCEDURE disable_UI :
     2549     HIDE FRAME Dialog-Frame.
     2550   END PROCEDURE.
     2551   PROCEDURE enable_UI :
     2552     DISPLAY f-omrbase f-ipcsbasc for-curr-name l-omrnal f-omrnal for-cash-pay-nal
     2553             l-omrntnl f-omrntnl for-cash-pay-ntnl
     2554         WITH FRAME Dialog-Frame.
     2555     ENABLE B-exit b-quit B-Help f-omrbase f-ipcsbasc b-curr b-cash-pay-nal
     2556            b-cash-pay-ntnl BR-cash-pay for-curr-name l-omrnal f-omrnal
     2557            for-cash-pay-nal l-omrntnl f-omrntnl for-cash-pay-ntnl
     2558         WITH FRAME Dialog-Frame.
     2559     VIEW FRAME Dialog-Frame.
     2560   END PROCEDURE.
     2561   PROCEDURE fill-widgets :
     2562   define variable v-value-character as character no-undo .
     2563   define variable v-value-date as date no-undo .
     2564   define variable v-value-decimal as decimal no-undo .
     2565   define variable v-value-integer as INTEGER no-undo .
     2566   define variable v-value-logical AS LOGICAL no-undo .
     2567   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2568   DEFINE VARIABLE v-omrcurl AS CHARACTER NO-UNDO.
     2569   DEFINE VARIABLE v-omrpayl AS CHARACTER NO-UNDO.
     2570   DEFINE VARIABLE v-omron-pay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2571   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2572   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     2573   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2574   define variable v-param-type as character no-undo .
     2575   define variable v-param-value as character no-undo .
     2576   define variable ii as integer no-undo .
     2577   FOR EACH thbjattr_thbj-attr:
     2578     delete thbjattr_thbj-attr.
     2579   end.
     2580   FOR EACH temp-thbj-attr:
     2581     delete temp-thbj-attr.
     2582   end.
     2583   run adm/shattri.p (
     2584                 input "init":U
     2585               , input p-obj-type
     2586               , input p-obj-code
     2587               , input 'cd-type-omron':U
     2588               , input "":U
     2589               , output v-value-character
     2590               , output v-value-date
     2591               , output v-value-decimal
     2592               , output v-value-integer
     2593               , output v-value-logical
     2594               , output v-param-type
     2595               , INPUT-OUTPUT TABLE-handle v-tth
     2596               ) no-error .
     2597   if error-status:error
     2598   and not available locked_thbj-attr then do:
     2599     message
     2600     "Не удалось получить начальные значения настроек" skip
     2601     error-status:get-message(1) return-value
     2602     view-as alert-box error .
     2603     undo, return error .
     2604   end.
     2605   FOR EACH thbjattr_thbj-attr:
     2606     ASSIGN
     2607     v-entry = thbjattr_thbj-attr.prop-code.
     2608     IF v-entry = 'omrbase':U THEN DO:
     2609       ASSIGN
     2610       f-omrbase = thbjattr_thbj-attr.property-value-integer
     2611       f-omrbase:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2612       .
     2613     END.
     2614     IF v-entry = 'omrnal':U THEN DO:
     2615       ASSIGN
     2616       f-omrnal = thbjattr_thbj-attr.property-value-integer
     2617       f-omrnal:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2618       .
     2619     END.
     2620     IF v-entry = 'omrntnl':U THEN DO:
     2621       ASSIGN
     2622       f-omrntnl = thbjattr_thbj-attr.property-value-integer
     2623       f-omrntnl:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     2624       .
     2625     END.
     2626     IF v-entry = 'omrcurl':U THEN DO:
     2627       ASSIGN
     2628       v-omrcurl = thbjattr_thbj-attr.property-value-character.
     2629     END.
     2630     IF v-entry = 'omrpayl':U THEN DO:
     2631       ASSIGN
     2632       v-omrpayl = thbjattr_thbj-attr.property-value-character.
     2633     END.
     2634     create temp-thbj-attr.
     2635     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2636   END.
     2637   IF v-omrcurl <> "":U  THEN DO:
     2638   _ii:
     2639   DO ii = 1 TO MIN(NUM-ENTRIES(v-omrcurl), NUM-ENTRIES(v-omrpayl)) :
     2640      ASSIGN
     2641      v-omron-pay-code = ii
     2642      v-cdpay-code = INTEGER (ENTRY(ii, v-omrpayl))
     2643      v-curr-code = INTEGER (ENTRY(ii, v-omrcurl))
     2644      .
     2645      FIND FIRST buf_cash-pay NO-LOCK WHERE
     2646                   buf_cash-pay.cdpay-code = v-cdpay-code
     2647           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     2648      IF NOT AVAILABLE buf_cash-pay THEN NEXT _ii.
     2649       CREATE tt-cash-pay-omr.
     2650       BUFFER-COPY buf_cash-pay TO tt-cash-pay-omr
     2651       ASSIGN
     2652       tt-cash-pay-omr.omr-pay-code = ii
     2653       .
     2654   END.
     2655   END.
     2656   END PROCEDURE.
     2657   PROCEDURE MyEnable :
     2658   DEFINE BUFFER buf_currency FOR ub.currency.
     2659   FIND FIRST buf_currency NO-LOCK WHERE
     2660             buf_currency.curr-code = f-omrbase NO-ERROR.
     2661   IF AVAILABLE buf_currency THEN DO:
     2662       ASSIGN
     2663       for-curr-name = buf_currency.curr-abbr.
     2664   END.
     2665   ELSE DO:
     2666       ASSIGN
     2667       for-curr-name = ?.
     2668   END.
     2669   FIND FIRST buf_cash-pay-nal NO-LOCK WHERE
     2670             buf_cash-pay-nal.cdpay-code = f-omrnal
     2671         AND buf_cash-pay-nal.curr-code = f-omrbase NO-ERROR.
     2672   IF AVAILABLE buf_cash-pay-nal THEN DO:
     2673       ASSIGN
     2674       for-cash-pay-nal = buf_cash-pay-nal.obj-name.
     2675   END.
     2676   ELSE DO:
     2677       ASSIGN
     2678       for-cash-pay-nal = ?.
     2679   END.
     2680   FIND FIRST buf_cash-pay-ntnl NO-LOCK WHERE
     2681             buf_cash-pay-ntnl.cdpay-code = f-omrntnl
     2682         AND buf_cash-pay-ntnl.curr-code = f-omrbase NO-ERROR.
     2683   IF AVAILABLE buf_cash-pay-ntnl THEN DO:
     2684       ASSIGN
     2685       for-cash-pay-ntnl = buf_cash-pay-ntnl.obj-name.
     2686   END.
     2687   ELSE DO:
     2688       ASSIGN
     2689       for-cash-pay-ntnl = ?.
     2690   END.
     2691   ASSIGN
     2692   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2693   v-tab-order = "f-omrbase,b-curr,b-cash-pay-nal,b-cash-pay-ntnl,b-add,b-del".
     2694   DISPLAY
     2695   f-omrbase
     2696   f-omrnal
     2697   f-omrntnl
     2698   l-omrnal
     2699   l-omrntnl
     2700   for-curr-name
     2701   for-cash-pay-nal
     2702   for-cash-pay-ntnl
     2703   WITH FRAME Dialog-Frame.
     2704   ENABLE
     2705   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2706   b-quit
     2707   B-Help
     2708   br-cash-pay
     2709   b-cash-pay-nal WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2710   b-cash-pay-ntnl WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2711   f-omrbase WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2712   b-add   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2713   b-del   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2714   WITH FRAME Dialog-Frame.
     2715   VIEW FRAME Dialog-Frame.
     2716   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2717       HIDE
     2718       b-exit
     2719       IN FRAME Dialog-Frame.
     2720       ASSIGN
     2721       b-quit:LABEL = "&Выход"
     2722       .
     2723   END.
     2724   RUN openbr IN THIS-PROCEDURE.
     2725   END PROCEDURE.
     2726   PROCEDURE OpenBr :
     2727   OPEN QUERY br-cash-pay FOR EACH tt-cash-pay-omr SHARE-LOCK.
     2728   END PROCEDURE.
     2729   PROCEDURE proc-save :
     2730   DEFINE VARIABLE v-omrcurl AS CHARACTER NO-UNDO.
     2731   DEFINE VARIABLE v-omrpayl AS CHARACTER NO-UNDO.
     2732   define variable v-value-character as character no-undo .
     2733   define variable v-value-date as date no-undo .
     2734   define variable v-value-decimal as decimal no-undo .
     2735   define variable v-value-integer as INTEGER no-undo .
     2736   define variable v-value-logical AS LOGICAL no-undo .
     2737   define variable v-param-type as character no-undo .
     2738   define variable wh as widget-handle no-undo .
     2739   define variable fh as widget-handle no-undo .
     2740   define variable v-same as logical no-undo .
     2741   DEFINE BUFFER buf_tt-cash-pay-omr FOR tt-cash-pay-omr.
     2742   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     2743   ASSIGN
     2744   FRAME Dialog-Frame
     2745   f-omrbase
     2746   f-omrnal
     2747   f-omrntnl
     2748   .
     2749   FOR EACH tt-cash-pay-omr BY tt-cash-pay-omr.omr-pay-code:
     2750     ASSIGN
     2751     v-omrcurl = v-omrcurl + (IF v-omrcurl = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-omr.omr-pay-code)
     2752     v-omrpayl = v-omrpayl + (IF v-omrpayl = "":U THEN "":U ELSE chr(44)) + STRING(tt-cash-pay-omr.cdpay-code)
     2753     .
     2754   END.
     2755   assign
     2756   fh = frame Dialog-Frame:first-child
     2757   wh = fh:first-child
     2758   .
     2759   do while valid-handle(wh):
     2760     if wh:private-data begins "recid=" then do:
     2761       find first thbjattr_thbj-attr where
     2762                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     2763       assign
     2764       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2765     end.
     2766     wh = wh:next-sibling.
     2767   end.
     2768   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'omrcurl':U.
     2769   assign
     2770   thbjattr_thbj-attr.property-value-character = v-omrcurl.
     2771   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'omrpayl':U.
     2772   assign
     2773   thbjattr_thbj-attr.property-value-character = v-omrpayl.
     2774   v-same = yes.
     2775   for each thbjattr_thbj-attr,
     2776       first temp-thbj-attr where
     2777             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     2778         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     2779         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     2780         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     2781      buffer-compare
     2782      thbjattr_thbj-attr
     2783      to temp-thbj-attr
     2784      save result in v-same.
     2785      if not v-same then leave.
     2786   end.
     2787   v-same = no.
     2788   IF v-same  and not v-to-create THEN RETURN.
     2789   run adm/shattri.p (
     2790                 input "check":U
     2791               , input p-obj-type
     2792               , input p-obj-code
     2793               , input 'cd-type-omron':U
     2794               , INPUT '':U
     2795                , output v-value-character
     2796                , output v-value-date
     2797                , output v-value-decimal
     2798                , output v-value-integer
     2799                , output v-value-logical
     2800                , output v-param-type
     2801                , input-output TABLE-handle v-tth
     2802                ) no-error .
     2803   if error-status:error then do:
     2804     message
     2805     "Некорректное значение ПАРАМЕТРОВ" skip
     2806     error-status:get-message(1) skip
     2807     return-value
     2808     view-as alert-box error .
     2809     undo, return error .
     2810   end.
     2811   do TRANSACTION
     2812   on error undo, return error return-value
     2813   :
     2814     RUN thbjattr_set-section IN THIS-PROCEDURE (
     2815          input p-obj-type
     2816         ,input p-obj-code
     2817         ,input 'cd-type-omron':U
     2818         ,INPUT table thbjattr_thbj-attr
     2819     ) NO-ERROR.
     2820     IF ERROR-STATUS:error THEN do:
     2821       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2822       RETURN-VALUE
     2823       VIEW-AS ALERT-BOX.
     2824       UNDO, RETURN ERROR.
     2825     END.
     2826   end.
     2827   END PROCEDURE.
