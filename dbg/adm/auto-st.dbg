        1   CREATE WIDGET-POOL.
        2   define input  parameter p-db-info            as character no-undo .
        3   define input  parameter p-hidden-mode        as logical   no-undo .
        4   define input  parameter p-no-message         as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Запуск авто сессий и отслеживание их работы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   FUNCTION mark-string RETURNS CHARACTER
      116     ( input p-recid as recid, input mark-list as character  ) :
      117     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      118   END FUNCTION.
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define  shared variable g#auto-pid           as integer   no-undo .
      121   define  shared variable conn-par             as character no-undo .
      122   define  shared variable g#auto-user-id       as character no-undo .
      123   define  shared variable g#auto-user-login    as character no-undo .
      124   define  shared variable g#auto-user-password as character no-undo .
      125   define  shared variable v-socket             as logical   no-undo .
      126   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define  shared variable auto-window-h     as handle    no-undo .
      128   define  shared variable auto-log-msg-h    as handle    no-undo .
      129   define  shared variable hand-log-msg-h    as handle    no-undo .
      130   define  shared variable log-file-name     as character no-undo initial ? .
      131   define  shared variable add-log-file-name as character no-undo initial ? .
      132   define  shared variable writelogvalue     as character no-undo initial ? .
      133   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define stream LogStream .
      359   define variable mNoTime as logical no-undo.
      360   procedure write-to-log-notime :
      361     define input param i-str as character no-undo .
      362     mNoTime = yes.
      363     run write-to-log (i-str).
      364     mNoTime = no.
      365   end.
      366   procedure write-to-log :
      367     define input param p-str as character no-undo .
      368     do
      369     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      370     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      371     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      372     :
      373       define variable log-res        as logical   no-undo .
      374       define variable v-jj           as integer   no-undo .
      375       if    mNoTime
      376          or writelogvalue eq "AsyncProc"
      377       then
      378          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      379       else
      380          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      381       if auto-log-msg-h <> ? then do:
      382         log-res = auto-log-msg-h:move-to-eof( ) .
      383         log-res = auto-log-msg-h:insert-string( p-str ).
      384       end.
      385       if hand-log-msg-h <> ? then do:
      386         log-res = hand-log-msg-h:move-to-eof( ) .
      387         log-res = hand-log-msg-h:insert-string( p-str ).
      388       end.
      389       assign
      390         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      391         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      392         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      393       .
      394       if add-log-file-name <> ? then do:
      395         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      396           run gbl/fileapnd.p
      397             ( input entry(v-jj, add-log-file-name, chr(1) )
      398             ,input p-str
      399             ,input 20
      400             ) no-error .
      401           if error-status:error then do:
      402             return error return-value .
      403           end.
      404         end.
      405       end.
      406       if writelogvalue eq "AsyncProc"
      407       then do:
      408          p-str = trim(p-str, (chr(13) + chr(10)) )
      409       .
      410          Publish "WriteLogAsunc" (p-str,yes).
      411       end.
      412       else if writelogvalue <> "yes" then do:
      413         run gbl/fileapnd.p
      414           ( input log-file-name
      415           ,input p-str
      416           ,input 20
      417           ) no-error .
      418         if error-status:error then do:
      419           return error return-value .
      420         end.
      421       end.
      422     end.
      423   end procedure.
      424   procedure write-to-screen :
      425     define input param p-str as character no-undo .
      426     do
      427     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      428     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      429     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      430     :
      431       define variable log-res as logical no-undo.
      432       assign
      433         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      434       .
      435       if auto-log-msg-h <> ?
      436       then do:
      437         log-res = auto-log-msg-h:move-to-eof( ) .
      438         log-res = auto-log-msg-h:insert-string( p-str ).
      439       end.
      440       if hand-log-msg-h <> ?
      441       then do:
      442         log-res = hand-log-msg-h:move-to-eof( ) .
      443         log-res = hand-log-msg-h:insert-string( p-str ).
      444       end.
      445     end.
      446   end procedure.
      447   procedure send-msg-to-email :
      448     define input  parameter p-subject      as character no-undo .
      449     define input  parameter p-text-err     as character no-undo .
      450     define input  parameter p-attach-files as character no-undo .
      451     do
      452     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      453     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      455     :
      456       define variable v-tth             as handle    no-undo .
      457       define variable v-value-character as character no-undo .
      458       define variable v-value-date      as date      no-undo .
      459       define variable v-value-decimal   as decimal   no-undo .
      460       define variable v-value-integer   as integer   no-undo .
      461       define variable v-value-logical   as logical   no-undo .
      462       define variable v-param-type      as character no-undo .
      463       define variable v-email       as character no-undo .
      464       define variable v-tmp-str     as character no-undo .
      465       define variable v-tmp1-str    as character no-undo .
      466       define variable v-ind         as integer   no-undo .
      467       define variable v-num-entries as integer   no-undo .
      468       delete object v-tth no-error.
      469       run adm/shattri.p
      470         ( input "get":U
      471          ,input  "":U
      472          ,input  0
      473          ,input  'auto-task':U
      474          ,input  'send-msg-to-email':U
      475          ,output v-value-character
      476          ,output v-value-date
      477          ,output v-value-decimal
      478          ,output v-value-integer
      479          ,output v-value-logical
      480          ,output v-param-type
      481          ,input-output table-handle v-tth
      482         ) no-error .
      483       if not error-status :error  then do:
      484         assign
      485           v-tmp-str = v-value-character
      486         .
      487       end.
      488       delete object v-tth no-error.
      489       assign
      490         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      491         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      492         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      493         v-num-entries = num-entries( v-tmp-str, chr(44) )
      494         v-email       = "":U
      495       .
      496       do v-ind = 1 to v-num-entries
      497       :
      498         assign
      499           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      500         .
      501         if trim( v-tmp1-str ) <> "":U then do:
      502           if v-email = "":U then do:
      503             assign
      504               v-email = v-tmp1-str
      505             .
      506           end.
      507           else do:
      508             assign
      509               v-email = v-email + chr(44) + v-tmp1-str
      510             .
      511           end.
      512         end.
      513       end.
      514       if v-email <> "":U then do:
      515         run gbl/sendmail.p
      516           ( input v-email
      517           , input p-subject
      518           , input p-text-err
      519           , input p-attach-files
      520           ) no-error .
      521         if error-status :error
      522           or return-value <> "":U
      523         then do:
      524           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      525         end.
      526       end.
      527     end.
      528   end procedure.
      529   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
