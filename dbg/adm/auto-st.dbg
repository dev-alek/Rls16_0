      832       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
      833     .
      834   end.
      835       loc#log = br-auto-sessions:refresh() .
      836       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      837           loc#log = br-auto-sessions:select-next-row ().
      838           apply "VALUE-CHANGED" to br-auto-sessions in frame f-auto-start.
      839       end.
      840       if num-entries( v-rid-list ) = 0 then do:
      841         hide mark-num in frame f-auto-start.
      842       end.
      843       else do:
      844         display
      845           num-entries( v-rid-list ) @ mark-num
      846           with frame f-auto-start.
      847       end.
      848     end.
      849     apply "entry" to br-auto-sessions in frame f-auto-start.
      850   END.
      851   ON CHOOSE OF b-start IN FRAME f-auto-start
      852   DO:
      853     define variable v-recid as recid no-undo initial ? .
      854     if trim( v-rid-list ) = "":U
      855       and available X_auto-session
      856       and X_auto-session.session-pid = 0
      857     then do:
      858       assign
      859         v-rid-list = string( recid ( X_auto-session ) )
      860       .
      861     end.
      862     if available X_auto-session then do:
      863       assign
      864         v-recid = recid( X_auto-session )
      865       .
      866     end.
      867     run start-sessions in this-procedure
