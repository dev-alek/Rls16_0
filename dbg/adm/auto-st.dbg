      950       message "Запуск в режиме ~"Сессия видна~" не допустим с параметром -b" skip
      951               "в настройках ini-файла в параметра DopParamSession секции [THAutoSessions]."
      952               view-as alert-box.
      953       return no-apply.
      954     end.
      955     assign
      956       v-start-mode = "":U
      957     .
      958     apply "choose" to b-start in frame f-auto-start.
      959   END.
      960   ASSIGN CURRENT-WINDOW                = auto-st
      961         THIS-PROCEDURE:CURRENT-WINDOW = auto-st.
      962   on close of this-procedure
      963   do:
      964     apply "choose" to b-exit in frame f-auto-start.
      965     return no-apply.
      966   end.
      967   PAUSE 0 BEFORE-HIDE.
      968   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   on help of frame f-auto-start
      970   do:
      971     run gbl/app_help.p
      972       (input this-procedure :file-name
      973       ,input ''
      974       ,input ?
      975       ) no-error.
      976     if error-status :error then do:
      977       message
      978         "Ошибка при вызове помощи"
      979         error-status :get-message(1)
      980         view-as alert-box .
      981     end.
      982   end.
      983   run minbtn-set in this-procedure .
      984   on choose of b-help in frame f-auto-start
      985   do:
      986     apply "help":u to frame f-auto-start .
      987   end.
      988   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   procedure minbtn-set :
      990       do
      991           on error undo, return error return-value
      992           :
      993           define variable ii              as integer       no-undo .
      994           define variable fh              as widget-handle no-undo .
      995           define variable hh              as widget-handle no-undo .
      996           define variable v-h             as handle        extent 4 no-undo .
      997           define variable v-name-button   as character     no-undo .
      998           define variable v-help-old-x    as decimal       no-undo .
      999           define variable v-help-old-y    as decimal       no-undo .
     1000           define variable v-help-old-size as decimal       no-undo .
     1001           define variable v-frame-width   as decimal       no-undo .
     1002           define variable jj              as integer       no-undo .
     1003           do
     1004               on error undo, return error
     1005               :
     1006               assign
     1007                   v-frame-width = frame f-auto-start:width - 0.3
     1008                   fh            = frame f-auto-start:first-child
     1009                   hh            = fh:first-child
     1010                   ii            = 1
     1011                   .
     1012               do while valid-handle(hh):
     1013                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1014                   do:
     1015                       case lc(hh:name) :
     1016                           when "b-help" then
     1017                               do:
     1018                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1019                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1020                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1021                                   hh:TOOLTIP = "Помощь" .
     1022                                   v-help-old-x = hh:column .
     1023                                   v-help-old-y = hh:row    .
     1024                                   v-help-old-size = hh:width .
     1025                                   hh:width-chars = 2.5 .
     1026                               end.
     1027                           when "b-print" then
     1028                               do:
     1029                                   hh:load-image("cmp/b-print.bmp":u) .
     1030                                   hh:TOOLTIP = "Печать" .
     1031                                   v-h[ii] = hh:handle .
     1032                                   ii = ii + 1 .
     1033                                   hh:width-chars = 3 .
     1034                               end.
     1035                           when "b-history" or
     1036                           when "b-hist" then
     1037                               do:
     1038                                   hh:load-image("cmp/b-hist.bmp":u) .
     1039                                   hh:TOOLTIP = "История" .
     1040                                   v-h[ii] = hh:handle .
     1041                                   ii = ii + 1 .
     1042                                   hh:width-chars = 3 .
     1043                               end.
     1044                           when "b-sch" then
     1045                               do:
     1046                                   hh:load-image("cmp/b-sch.bmp":u) .
     1047                                   hh:TOOLTIP = "Установка Фильтра" .
     1048                                   v-h[ii] = hh:handle .
     1049                                   ii = ii + 1 .
     1050                                   hh:width-chars = 3 .
     1051                               end.
     1052                           when "b-hist-user" then
     1053                               do:
     1054                                   hh:load-image("cmp/b-hist.bmp":u) .
     1055                                   hh:TOOLTIP = "История пользователя" .
     1056                                   ii = ii + 1 .
     1057                               end.
     1058                       end case.
     1059                   end.
     1060                   hh = hh:next-sibling.
     1061               end.
     1062               b-help:column = v-frame-width - b-help:width-chars.
     1063               jj = 0.
     1064               repeat ii = 4 to 1 by -1 :
     1065                   if valid-handle (v-h[ii] ) then
     1066                   do:
     1067                       jj  = jj + 1 .
     1068                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1069                       v-h[ii]:row    = v-help-old-y .
     1070                   end.
     1071               end.
     1072           end.
     1073       end.
     1074   end procedure.
     1075   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   on INS of frame f-auto-start anywhere do:
     1077     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame f-auto-start. END.
     1078     return no-apply.
     1079   end.
     1080   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   on F2 of frame f-auto-start anywhere do:
     1082     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame f-auto-start. END.
     1083     return no-apply.
     1084   end.
     1085   MAIN-BLOCK:
     1086   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1087      ON END-KEY UNDO MAIN-BLOCK, retry MAIN-BLOCK
     1088      ON STOP    UNDO MAIN-BLOCK, retry MAIN-BLOCK:
     1089     define variable v-start-time      as int64     no-undo .
     1090     define variable v-read-ini        as character no-undo .
     1091     define variable v-num-sessions    as integer   no-undo .
     1092     define variable v-ind             as integer   no-undo .
     1093     define variable v-start-proc      as character no-undo .
     1094     define variable v-add-mode        as character no-undo .
     1095     define variable v-num-entries     as integer   no-undo .
     1096     define variable v-ind1            as integer   no-undo .
     1097     define variable v-curr-mode       as character no-undo .
     1098     define variable v-curr-mode-name  as character no-undo .
     1099     define variable v-new-add-mode    as character no-undo .
     1100     define variable v-new-hidden-mode as logical   no-undo .
     1101     define variable v-msg                as character no-undo .
     1102     assign
     1103       auto-st:title = substitute( "PID: &1. &2 для &3", g#auto-pid, auto-st:title, p-db-info )
     1104       file-info:file-name = ".":U
     1105       v-work-dir = file-info:full-pathname
     1106       log-file-name = v-work-dir + chr(92) + "auto-st.log":U
     1107     .
     1108     run write-to-log in this-procedure
     1109       ( substitute( "Запуск диспетчера автопроцессов." )
     1110       ) .
     1111     assign
     1112       v-task-name = substitute( "OEApp TH 16_0 AutoTaskМanager &1", p-db-info )
     1113     .
     1114     if IsAppAlreadyRunning(true, v-task-name ) then do:
     1115       assign
     1116         v-msg = substitute("Диспетчер задач для &1 уже запущен!", p-db-info )
     1117       .
     1118       if p-no-message = false then do:
     1119         message
     1120           v-msg
     1121           view-as alert-box information .
     1122       end.
     1123       else do:
     1124         run write-to-log in this-procedure
     1125           ( input v-msg
     1126           ) .
     1127       end.
     1128       return .
     1129     end.
     1130     run gbl/getexini.p
     1131       ( output v-exefile
     1132        ,output v-inifile
     1133       ) no-error .
     1134     if error-status :error then do:
     1135       assign
     1136         v-msg = substitute( "&1. Ошибка при определении имени выполняемого файла и *.ini файла &2&3&2&4"
     1137                             , vss-workfile
     1138                             , chr(10)
     1139                             , error-status :get-message(1)
     1140                             , return-value
     1141                           ) .
     1142       if p-no-message = false then do:
     1143         message
     1144           v-msg
     1145           view-as alert-box error .
     1146       end.
     1147       else do:
     1148         run write-to-log in this-procedure
     1149           ( input v-msg
     1150           ) .
     1151       end.
     1152       undo, return error .
     1153     end.
     1154     assign
     1155       b-start:menu-mouse in frame f-auto-start = 1
     1156     .
     1157     run init-session in this-procedure .
     1158     get-key-value
     1159       section "THAutoSessions"
     1160       key "NumAutoSessions"
     1161       value v-read-ini
     1162     .
     1163     assign
     1164       v-num-sessions = integer( v-read-ini ) no-error
     1165     .
     1166     if v-num-sessions = ?
     1167       or error-status :error
     1168     then do:
     1169       assign
     1170         v-msg = substitute( "Не задано или задано неверно кол-во обрабатываемых автосессий.&1"
     1171                            + "(секция THSessions ключ NumSession в .ini файле).&1"
     1172                            + "NumSession в ini: &2&1"
     1173                            , v-read-ini
     1174                           ) .
     1175       if p-no-message = false then do:
     1176         message
     1177           v-msg
     1178           view-as alert-box information .
     1179       end.
     1180       else do:
     1181         run write-to-log in this-procedure
     1182           ( input v-msg
     1183           ) .
     1184       end.
     1185     end.
     1186     else do:
     1187       do v-ind = 1 to v-num-sessions
     1188       :
     1189         v-msg = "".
     1190         get-key-value
     1191           section "THAutoSessions"
     1192           key substitute( "AutoSession&1", v-ind )
     1193           value v-read-ini
     1194         .
     1195         if v-read-ini <> ?
     1196           and v-read-ini <> "":U
     1197         then do:
     1198           assign
     1199             v-read-ini   = caps( v-read-ini )
     1200             v-add-mode   = "":U
     1201           .
     1202           if num-entries( v-read-ini, "+":U ) > 1 then do:
     1203             assign
     1204               v-num-entries  = num-entries( v-read-ini, "+":U )
     1205               v-new-add-mode = "":U
     1206             .
     1207             do v-ind1 = 1 to v-num-entries
     1208             :
     1209               assign
     1210                 v-curr-mode      = entry( v-ind1, v-read-ini, "+":U )
     1211                 v-curr-mode-name = entry( 1, v-curr-mode, ":":U )
     1212               .
     1213               if trim( v-curr-mode-name ) <> "":U then do:
     1214                 case v-curr-mode-name :
     1215                   when "SN" then do:
     1216                     assign
     1217                       v-start-proc = lc( entry( 2, v-curr-mode, ":":U ) )
     1218                     .
     1219                   end.
     1220                   when "H":U
     1221                   or when "R":U
     1222                   or when "DB":U
     1223                   or when "ExtSys":U
     1224                   or when "Sock":U
     1225                   or when "ProcName":U
     1226                   then do:
     1227                     assign
     1228                       v-new-add-mode = v-new-add-mode + "+":U + v-curr-mode
     1229                     .
     1230                   end.
     1231                   otherwise do:
     1232                     run write-to-log ( substitute( "&1. Неизвестный ключ (&2) запуска автопроцесса (&3)! Ключ игнорируется", vss-workfile, v-curr-mode, v-start-proc ) ).
     1233                   end.
     1234                 end case.
     1235               end.
     1236             end.
     1237             assign
     1238               v-add-mode = left-trim( v-new-add-mode, "+":U )
     1239             .
     1240           end.
     1241           if index(vDopParamSession,"-b") <> 0 and
     1242              lookup( "H":U, v-add-mode, "+":U ) = 0 then
     1243           do:
     1244             v-msg = "Автопроцесс с ключом -b в параметре DopParamSession может быть запущен только в скрытом режиме".
     1245             if p-no-message = false then do:
     1246               message
     1247                 v-msg
     1248                 view-as alert-box error .
     1249             end.
     1250             else do:
     1251               run write-to-log in this-procedure
     1252                 ( input v-msg
     1253                 ) .
     1254             end.
     1255             next.
     1256           end.
     1257           find first X_auto-session
     1258             where X_auto-session.session-type = v-start-proc
     1259               and X_auto-session.session-pid  = 0
     1260             no-error .
     1261           if available X_auto-session then do:
     1262             assign
     1263               v-rid-list = string( recid( X_auto-session ) )
     1264             .
     1265             run start-sessions in this-procedure
     1266               ( input v-add-mode
     1267               ) no-error .
     1268             if error-status :error then do:
     1269               assign
     1270                 v-msg = substitute( "&1. Ошибка при запуске автопроцесса с типом '&2' &3&4&3&5"
     1271                                     , vss-workfile
     1272                                     , v-start-proc
     1273                                     , chr(10)
     1274                                     , error-status :get-message(1)
     1275                                     , return-value
     1276                                   ) .
     1277               if p-no-message = false then do:
     1278                 message
     1279                   v-msg
     1280                   view-as alert-box error .
     1281               end.
     1282               else do:
     1283                 run write-to-log in this-procedure
     1284                   ( input v-msg
     1285                   ) .
     1286               end.
     1287             end.
     1288           end.
     1289           else do:
     1290             assign
     1291               v-msg = substitute( "&1. Отсутствует автопроцесс с типом '&2'"
     1292                                   , vss-workfile
     1293                                   , v-start-proc
     1294                                 ) .
     1295             if p-no-message = false then do:
     1296               message
     1297                 v-msg
     1298                 view-as alert-box error .
     1299             end.
     1300             else do:
     1301               run write-to-log in this-procedure
     1302                 ( input v-msg
     1303                 ) .
     1304             end.
     1305           end.
     1306         end.
     1307       end.
     1308     end.
     1309     if p-hidden-mode = false then do:
     1310       run myenable in this-procedure .
     1311     end.
     1312     main-cycl:
     1313     do while not log-exit
     1314     on error  undo, leave main-cycl
     1315     on stop   undo, next
     1316     on endkey undo, next
     1317     :
     1318       if p-hidden-mode = false then do:
     1319         run my_refresh in this-procedure
     1320           ( input (if available X_auto-session then recid( X_auto-session ) else ? )
     1321           ).
     1322       end.
     1323       assign
     1324         v-start-time = etime
     1325       .
     1326       do while not log-exit:
     1327         if p-hidden-mode = false then do:
     1328           wait-for
     1329             go of frame f-auto-start
     1330             or close of this-procedure
     1331             or choose of b-start in frame f-auto-start
     1332             or choose of b-help in frame f-auto-start
     1333             focus frame f-auto-start
     1334             pause 1
     1335           .
     1336         end.
     1337         else do:
     1338           wait-for
     1339             go of frame f-auto-start
     1340             or close of this-procedure
     1341             pause 1
     1342             .
     1343         end.
     1344         assign
     1345           file-info:file-name = ATH-var-name( g#auto-pid )
     1346           v-varfile           = file-info:full-pathname
     1347         .
     1348         if v-varfile <> ? then do:
     1349           assign
     1350             v-varstr = "":U
     1351           .
     1352           input stream VarStream from value( v-varfile ) .
     1353           block_read-var:
     1354           repeat :
     1355             import stream VarStream unformatted v-varstr no-error .
     1356             leave block_read-var .
     1357           end.
     1358           input stream VarStream close.
     1359           if lookup( "H":U, v-varstr, "+":U ) = 0 then do:
     1360             assign
     1361               v-new-hidden-mode = false
     1362             .
     1363           end.
     1364           else do:
     1365             assign
     1366               v-new-hidden-mode = true
     1367             .
     1368           end.
     1369           os-delete value( v-varfile ) .
     1370           if v-new-hidden-mode <> p-hidden-mode then do:
     1371             assign
     1372               p-hidden-mode = v-new-hidden-mode
     1373             .
     1374             run write-to-log ( substitute( "Смена статуса 'видимости' сессии. Теперь сессия &1видна.", (if p-hidden-mode = true then "не":U else "") ) ).
     1375           end.
     1376         end.
     1377         if p-hidden-mode = false
     1378           and frame f-auto-start:visible = false
     1379         then do:
     1380           run myenable in this-procedure .
     1381         end.
     1382         if p-hidden-mode = true
     1383           and frame f-auto-start:visible = true
     1384         then do:
     1385           run myhide in this-procedure .
     1386         end.
     1387         if etime - v-start-time > 60000
     1388         then do:
     1389           leave .
     1390         end.
     1391       end.
     1392       run restart-sessions in this-procedure .
     1393     end.
     1394     for each tt_auto-session
     1395     :
     1396       delete tt_auto-session .
     1397     end.
     1398     RUN disable_UI in this-procedure .
     1399     run LetAnotherInstanceRun( v-task-name ) .
     1400     run write-to-log in this-procedure
     1401       ( substitute( "Завершение работы диспетчера автопроцессов." )
     1402       ) .
     1403   END.
     1404   PROCEDURE disable_UI :
     1405     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(auto-st)
     1406     THEN DELETE WIDGET auto-st.
     1407     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1408   END PROCEDURE.
     1409   PROCEDURE enable_UI :
     1410     DISPLAY mark-num
     1411         WITH FRAME f-auto-start IN WINDOW auto-st.
     1412     ENABLE b-exit b-mark b-start b-stop b-view-hide b-help br-auto-sessions
     1413            mark-num
     1414         WITH FRAME f-auto-start IN WINDOW auto-st.
     1415     OPEN QUERY br-auto-sessions FOR EACH X_auto-session .
     1416     VIEW auto-st.
     1417   END PROCEDURE.
     1418   PROCEDURE init-session :
     1419   create X_auto-session .
     1420     assign
     1421       X_auto-session.session-type = 'autonws':U
     1422       X_auto-session.session-name = "Новости"
     1423       X_auto-session.proc-name    = "adm/l-i-nws.w":U
     1424     .
     1425     create X_auto-session .
     1426     assign
     1427       X_auto-session.session-type = 'autoarh':U
     1428       X_auto-session.session-name = "Архивы"
     1429       X_auto-session.proc-name    = "adm/l-i-arc.w":U
     1430     .
     1431     create X_auto-session .
     1432     assign
     1433       X_auto-session.session-type = 'autoexp':U
     1434       X_auto-session.session-name = "Экспорт"
     1435       X_auto-session.proc-name    = "adm/l-i-exp.w":U
     1436     .
     1437     create X_auto-session .
     1438     assign
     1439       X_auto-session.session-type = 'autooxml':U
     1440       X_auto-session.session-name = "OpenXML"
     1441       X_auto-session.proc-name    = "adm/l-i-oxml.w":U
     1442     .
     1443     create X_auto-session .
     1444     assign
     1445       X_auto-session.session-type = 'autogcd':U
     1446       X_auto-session.session-name = "Прием инф. с касс"
     1447       X_auto-session.proc-name    = "adm/l-igetcd.w":U
     1448     .
     1449     create X_auto-session .
     1450     assign
     1451       X_auto-session.session-type = 'autosale':U
     1452       X_auto-session.session-name = "Обработка продаж"
     1453       X_auto-session.proc-name    = "adm/l-iasale.w":U
     1454     .
     1455     create X_auto-session .
     1456     assign
     1457       X_auto-session.session-type = 'autosuz':U
     1458       X_auto-session.session-name = "Отчеты"
     1459       X_auto-session.proc-name    = "adm/l-i-suz.w":U
     1460     .
     1461     create X_auto-session .
     1462     assign
     1463       X_auto-session.session-type = 'autocbnk':U
     1464       X_auto-session.session-name = "Эксп/имп в КЛИЕНТ-БАНК"
     1465       X_auto-session.proc-name    = "adm/l-iacbnk.w":U
     1466     .
     1467     create X_auto-session .
     1468     assign
     1469       X_auto-session.session-type = 'autofree':U
     1470       X_auto-session.session-name = "Произвольные задания"
     1471       X_auto-session.proc-name    = "adm/l-i-free.w":U
     1472     .
     1473     create X_auto-session .
     1474     assign
     1475       X_auto-session.session-type = 'sktsrv':U
     1476       X_auto-session.session-name = "Сокет Сервер"
     1477       X_auto-session.proc-name    = "adm/l-i-skt.w":U
     1478     .
     1479     create X_auto-session .
     1480     assign
     1481       X_auto-session.session-type = 'mercury':U
     1482       X_auto-session.session-name = "Меркурий"
     1483       X_auto-session.proc-name    = "adm/l-i-merc.w":U
     1484     .
     1485     create X_auto-session .
     1486     assign
     1487       X_auto-session.session-type = 'is_motp':U
     1488       X_auto-session.session-name = "ИС МОТП"
     1489       X_auto-session.proc-name    = "adm/l-i-motp.w":U
     1490     .
     1491     create X_auto-session .
     1492     assign
     1493       X_auto-session.session-type = 'is_diadoc':U
     1494       X_auto-session.session-name = "ИС Diadoc"
     1495       X_auto-session.proc-name    = "adm/l-i-diadoc.w":U
     1496     .
     1497     create X_auto-session .
     1498     assign
     1499       X_auto-session.session-type = 'hddtest':U
     1500       X_auto-session.session-name = "Мониторинг HDD"
     1501       X_auto-session.proc-name    = "adm/l-i-hddtest.w":U
     1502     .
     1503     create X_auto-session .
     1504     assign
     1505       X_auto-session.session-type = 'is_PM':U
     1506       X_auto-session.session-name = "Выгрузка в ИС Президентский Мониторинг"
     1507       X_auto-session.proc-name    = "adm/l-i-is_PM.w":U
     1508     .
     1509   END PROCEDURE.
     1510   PROCEDURE myenable :
     1511     assign
     1512       auto-st:HIDDEN = false
     1513     .
     1514     run enable_UI .
     1515   END PROCEDURE.
     1516   PROCEDURE myhide :
     1517     disable all with frame f-auto-start .
     1518     hide all no-pause in window auto-st .
     1519     assign
     1520       auto-st:HIDDEN = true
     1521     .
     1522   END PROCEDURE.
     1523   PROCEDURE my_refresh :
     1524   define input  parameter p-recid as recid     no-undo .
     1525     define variable v-ok as logical   no-undo .
     1526     assign
     1527       v-ok = browse br-auto-sessions :set-repositioned-row( browse br-auto-sessions :focused-row, 'CONDITIONAL':U)
     1528     .
     1529     OPEN QUERY br-auto-sessions FOR EACH X_auto-session .
     1530     reposition br-auto-sessions to recid p-recid no-error.
     1531     if num-entries( v-rid-list ) = 0 then do:
     1532       hide mark-num in frame f-auto-start.
     1533     end.
     1534     else do:
     1535       display
     1536         num-entries( v-rid-list ) @ mark-num
     1537         with frame f-auto-start.
     1538     end.
     1539   END PROCEDURE.
     1540   PROCEDURE restart-sessions :
     1541   define buffer buf_auto-session for tt_auto-session .
     1542     define buffer et_auto-session  for tt_auto-session .
     1543     define buffer new_auto-session for tt_auto-session .
     1544     define variable v-restart   as logical   no-undo .
     1545     define variable v-pid       as integer   no-undo .
     1546     define variable v-mode      as character no-undo .
     1547     define variable v-proc-name as character no-undo .
     1548     define variable v-sess-name as character no-undo .
     1549     for each buf_auto-session
     1550       where buf_auto-session.session-pid > 0
     1551     on error undo, next
     1552     :
     1553       assign
     1554         v-proc-name = buf_auto-session.proc-name
     1555         v-mode      = buf_auto-session.add-mode
     1556         v-sess-name = buf_auto-session.session-name
     1557         v-restart   = false
     1558         file-info:file-name = substitute( "./ATH&1.pid", buf_auto-session.session-pid )
     1559       .
     1560       if file-info:full-pathname <> ?
     1561         and ( ( file-info:file-create-date = today
     1562                 and file-info:file-create-time < time + 60
     1563               )
     1564               or file-info:file-create-date < today
     1565             )
     1566       then do:
     1567         os-delete value( file-info:full-pathname ) .
     1568         assign
     1569           v-restart = true
     1570         .
     1571       end.
     1572       else do:
     1573         if IsProcessRunning( buf_auto-session.session-pid ) <> -1 then do:
     1574           if lookup( "H":U, v-mode, "+":U ) > 0
     1575             or lookup( "R":U, v-mode, "+":U ) > 0
     1576           then do:
     1577             assign
     1578               v-restart = true
     1579             .
     1580           end.
     1581           else do:
     1582             run write-to-log in this-procedure
     1583               ( substitute( "Сессия '&1' (PID &2) завершила работу.", buf_auto-session.session-name, buf_auto-session.session-pid )
     1584               ) .
     1585             os-delete value( ATH-var-name( buf_auto-session.session-pid ) ) no-error .
     1586             delete buf_auto-session .
     1587           end.
     1588         end.
     1589       end.
     1590       if v-restart = true then do:
     1591         run gbl/termprc.p
     1592           ( input buf_auto-session.session-pid
     1593           ) .
     1594         run write-to-log in this-procedure
     1595           ( substitute( "Остановка сессии '&1' (PID &2) для перезапуска. ", buf_auto-session.session-name, buf_auto-session.session-pid )
     1596           ) .
     1597         os-delete value( ATH-var-name( buf_auto-session.session-pid ) ) no-error .
     1598         delete buf_auto-session .
     1599         run run-session in this-procedure
     1600           ( input  v-sess-name
     1601           , input  v-proc-name
     1602           , input  v-mode
     1603           , output v-pid
     1604           ) no-error .
     1605         if error-status :error
     1606           or v-pid = 0
     1607         then do:
     1608           message
     1609             vss-workfile vss-revision vss-description skip
     1610             "Ошибка при запуске сессии." skip
     1611             error-status :get-message(1) skip
     1612             return-value skip
     1613             view-as alert-box error .
     1614           next .
     1615         end.
     1616         find first et_auto-session
     1617           where et_auto-session.proc-name   = v-proc-name
     1618             and et_auto-session.session-pid = 0
     1619           no-error .
     1620         if available et_auto-session then do:
     1621           create new_auto-session .
     1622           buffer-copy et_auto-session to new_auto-session
     1623             assign
     1624               new_auto-session.session-pid = v-pid
     1625               new_auto-session.add-mode    = v-mode
     1626           .
     1627         end.
     1628       end.
     1629     end.
     1630   END PROCEDURE.
     1631   PROCEDURE run-session :
     1632   define input  parameter p-sess-name as character no-undo .
     1633     define input  parameter p-proc-name as character no-undo .
     1634     define input  parameter p-mode      as character no-undo .
     1635     define output parameter p-pid       as integer   no-undo .
     1636     do
     1637     on error undo, return error return-value
     1638     :
     1639       define variable vDopParamSessionRandom     as int no-undo .
     1640       define variable vDopParam                  as character no-undo .
     1641       if vDopParamSession eq ?
     1642       then
     1643          vDopParam = "".
     1644       else do:
     1645          vDopParamSessionRandom = random(1,9999999).
     1646          vDopParam = substitute (vDopParamSession,vDopParamSessionRandom).
     1647       end.
     1648       define variable v-command-line     as character no-undo .
     1649       define variable v-command-line-log as character no-undo .
     1650       assign
     1651         v-command-line = substitute( '&1 -ininame &2 -basekey "INI" -p &3 -param "U:&4,P:&5,M:&6" &7'
     1652                                      , v-exefile
     1653                                      , v-inifile
     1654                                      , p-proc-name
     1655                                      , g#auto-user-login
     1656                                      , g#auto-user-password
     1657                                      , replace( p-mode, ",":U, chr(4) )
     1658                                      , vDopParam
     1659                                    )
     1660         v-command-line-log = substitute( '&1 -ininame &2 -basekey "INI" -p &3 -param "U:&4,P:&5,M:&6" &7'
     1661                                      , v-exefile
     1662                                      , v-inifile
     1663                                      , p-proc-name
     1664                                      , g#auto-user-login
     1665                                      , "***"
     1666                                      , replace( p-mode, ",":U, chr(4) )
     1667                                      , vDopParam
     1668                                    )
     1669       .
     1670       run gbl/run-gpid.p
     1671         ( input v-command-line
     1672          ,input v-work-dir
     1673          ,output p-pid
     1674         ) no-error .
     1675       if error-status :error then do:
     1676         return error substitute( "&1&2&3&2Параметры запуска сессии: &4", error-status :get-message(1), chr(10), return-value, v-command-line-log ) .
     1677       end.
     1678       run write-to-log in this-procedure
     1679         ( substitute( "Запуск сессии '&1' (PID &2). Cтрока запуска: &3", p-sess-name, p-pid, v-command-line-log )
     1680         ) .
     1681    end.
     1682   END PROCEDURE.
     1683   PROCEDURE start-sessions :
     1684   define input  parameter p-mode as character no-undo .
     1685     define buffer new_auto-session for tt_auto-session .
     1686     define buffer buf_auto-session for tt_auto-session .
     1687     define variable v-ok           as logical   no-undo .
     1688     define variable v-pid          as integer   no-undo .
     1689     define variable v-ind          as integer   no-undo .
     1690     define variable v-num-entries  as integer   no-undo .
     1691     define variable v-recid        as recid     no-undo .
     1692     define variable v-rid-list-new as character no-undo .
     1693     assign
     1694       v-rid-list-new = v-rid-list
     1695       v-rid-list     = "":U
     1696       v-num-entries  = num-entries( v-rid-list-new )
     1697     .
     1698     block_cycl:
     1699     do v-ind = 1 to v-num-entries
     1700     on error undo, next block_cycl
     1701     :
     1702       assign
     1703         v-ok    = false
     1704         v-recid = integer( entry( v-ind, v-rid-list-new ) )
     1705       .
     1706       find first buf_auto-session
     1707         where recid( buf_auto-session ) = v-recid
     1708         no-error
     1709       .
     1710       if available buf_auto-session then do:
     1711         if buf_auto-session.session-pid = 0 then do:
     1712           run run-session in this-procedure
     1713             ( input buf_auto-session.session-name
     1714             , input buf_auto-session.proc-name
     1715             , input p-mode
     1716             , output v-pid
     1717             ) no-error .
     1718           if error-status :error
     1719             or v-pid = 0
     1720           then do:
     1721             message
     1722               vss-workfile vss-revision vss-description skip
     1723               "Ошибка при запуске сессии." skip
     1724               error-status :get-message(1) skip
     1725               return-value skip
     1726               view-as alert-box error .
     1727             next block_cycl .
     1728           end.
     1729           create new_auto-session .
     1730           buffer-copy buf_auto-session to new_auto-session
     1731             assign
     1732               new_auto-session.session-pid = v-pid
     1733               new_auto-session.add-mode    = p-mode
     1734           .
     1735           assign
     1736             v-ok = true
     1737           .
     1738         end.
     1739         if v-ok <> true then do:
     1740           assign
     1741             v-rid-list = (if v-rid-list = "":U then "":U else chr(44)) + string( v-recid )
     1742           .
     1743         end.
     1744       end.
     1745     end.
     1746   END PROCEDURE.
     1747   PROCEDURE stop-sessions :
     1748   define buffer new_auto-session for tt_auto-session .
     1749     define buffer buf_auto-session for tt_auto-session .
     1750     define variable v-ok           as logical   no-undo .
     1751     define variable v-pid          as integer   no-undo .
     1752     define variable v-ind          as integer   no-undo .
     1753     define variable v-num-entries  as integer   no-undo .
     1754     define variable v-recid        as recid     no-undo .
     1755     define variable v-rid-list-new as character no-undo .
     1756     assign
     1757       v-rid-list-new = v-rid-list
     1758       v-rid-list     = "":U
     1759       v-num-entries  = num-entries( v-rid-list-new )
     1760     .
     1761     block_cycl:
     1762     do v-ind = 1 to v-num-entries
     1763     on error undo, next block_cycl
     1764     :
     1765       assign
     1766         v-ok    = false
     1767         v-recid = integer( entry( v-ind, v-rid-list-new ) )
     1768       .
     1769       find first buf_auto-session
     1770         where recid( buf_auto-session ) = v-recid
     1771         no-error
     1772       .
     1773       if available buf_auto-session then do:
     1774         if buf_auto-session.session-pid > 0 then do:
     1775           run gbl/termprc.p
     1776             ( input buf_auto-session.session-pid
     1777             ) no-error .
     1778           if error-status :error then do:
     1779             message
     1780               vss-workfile vss-revision vss-description skip
     1781               substitute( "Ошибка при остановке сессии : &1", buf_auto-session.session-pid ) skip
     1782               error-status :get-message(1) skip
     1783               return-value skip
     1784               view-as alert-box error .
     1785             next block_cycl .
     1786           end.
     1787           run write-to-log in this-procedure
     1788             ( substitute( "Остановка сессии '&1' (PID &2) пользователем. ", buf_auto-session.session-name, buf_auto-session.session-pid )
     1789             ) .
     1790           os-delete value( ATH-var-name( buf_auto-session.session-pid ) ) no-error .
     1791           delete buf_auto-session .
     1792           assign
     1793             v-ok = true
     1794           .
     1795         end.
     1796         if v-ok <> true then do:
     1797           assign
     1798             v-rid-list = (if v-rid-list = "":U then "":U else chr(44)) + string( v-recid )
     1799           .
     1800         end.
     1801       end.
     1802     end.
     1803   END PROCEDURE.
     1804   PROCEDURE view-hide-sessions :
     1805     do
     1806     on error undo, return error return-value
     1807     :
     1808       define buffer buf_auto-session for tt_auto-session .
     1809       define variable v-ok           as logical   no-undo .
     1810       define variable v-ind          as integer   no-undo .
     1811       define variable v-num-entries  as integer   no-undo .
     1812       define variable v-recid        as recid     no-undo .
     1813       define variable v-rid-list-new as character no-undo .
     1814       define variable v-ind1         as integer   no-undo .
     1815       define variable v-num-entries1 as integer   no-undo .
     1816       define variable v-add-mode     as character no-undo .
     1817       define variable v-new-add-mode as character no-undo .
     1818       assign
     1819         v-rid-list-new = v-rid-list
     1820         v-rid-list     = "":U
     1821         v-num-entries  = num-entries( v-rid-list-new )
     1822       .
     1823       block_cycl:
     1824       do v-ind = 1 to v-num-entries
     1825       on error undo, next block_cycl
     1826       :
     1827         assign
     1828           v-ok    = false
     1829           v-recid = integer( entry( v-ind, v-rid-list-new ) )
     1830         .
     1831         find first buf_auto-session
     1832           where recid( buf_auto-session ) = v-recid
     1833           no-error
     1834         .
     1835         if available buf_auto-session then do:
     1836           if buf_auto-session.session-pid > 0 then do:
     1837             if lookup( "H":U, buf_auto-session.add-mode, "+":U ) = 0 then do:
     1838               assign
     1839                 buf_auto-session.add-mode = buf_auto-session.add-mode + "+H":U
     1840               .
     1841             end.
     1842             else do:
     1843               assign
     1844                 v-num-entries1 = num-entries( buf_auto-session.add-mode, "+":U )
     1845                 v-new-add-mode = "":U
     1846               .
     1847               do v-ind1 = 1 to v-num-entries1
     1848               on error undo, next block_cycl
     1849               :
     1850                 assign
     1851                   v-add-mode = entry( v-ind1, buf_auto-session.add-mode, "+":U )
     1852                 .
     1853                 if v-add-mode <> "H":U then do:
     1854                   assign
     1855                     v-new-add-mode = v-new-add-mode + "+":U + v-add-mode
     1856                   .
     1857                 end.
     1858               end.
     1859               assign
     1860                 buf_auto-session.add-mode = left-trim( v-new-add-mode, "+":U )
     1861               .
     1862             end.
     1863             output stream VarStream to value( ATH-var-name( buf_auto-session.session-pid ) ) .
     1864             put stream VarStream unformatted buf_auto-session.add-mode skip.
     1865             output stream VarStream close.
     1866             assign
     1867               v-ok = true
     1868             .
     1869             run write-to-log in this-procedure
     1870               ( substitute( "Сессия '&1' (PID &2) переведена в &3видимый режим ."
     1871                             ,buf_auto-session.session-name
     1872                             ,buf_auto-session.session-pid
     1873                             ,( if lookup( "H":U, buf_auto-session.add-mode, "+":U ) = 0 then "" else "не" )
     1874                           )
     1875               ) .
     1876             pause 2 no-message .
     1877             assign
     1878               file-info:file-name = ATH-var-name( buf_auto-session.session-pid )
     1879             .
     1880             if file-info:full-pathname <> ? then do:
     1881               message
     1882                 substitute("Режим будет изменен как только сессия освободится.") skip
     1883                 view-as alert-box information .
     1884             end.
     1885           end.
     1886           if v-ok <> true then do:
     1887             assign
     1888               v-rid-list = (if v-rid-list = "":U then "":U else chr(44)) + string( v-recid )
     1889             .
     1890           end.
     1891         end.
     1892       end.
     1893    end.
     1894   END PROCEDURE.
     1895   FUNCTION ATH-var-name RETURNS CHARACTER
     1896     ( INPUT p-pid AS INTEGER ) :
     1897     RETURN substitute( "./ATH&1.var", p-pid ).
     1898   END FUNCTION.
