      912       assign
      913         v-recid = recid( X_auto-session )
      914       .
      915     end.
      916     if trim( v-rid-list ) = "":U
      917       and available X_auto-session
      918       and X_auto-session.session-pid > 0
      919     then do:
      920       assign
      921         v-rid-list = string( recid ( X_auto-session ) )
      922       .
      923     end.
      924     run view-hide-sessions in this-procedure
      925       no-error .
      926     if error-status :error then do:
