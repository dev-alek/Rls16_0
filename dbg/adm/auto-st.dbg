      885     if trim( v-rid-list ) = "":U
      886       and available X_auto-session
      887       and X_auto-session.session-pid > 0
      888     then do:
      889       assign
      890         v-rid-list = string( recid ( X_auto-session ) )
      891       .
      892     end.
      893     run stop-sessions in this-procedure
      894       no-error .
      895     if error-status :error then do:
      896       message
      897         vss-workfile vss-revision vss-description skip
      898         substitute("Ошибка при остановке сессий.") skip
      899         error-status :get-message(1) skip
      900         return-value skip
      901         view-as alert-box error .
      902     end.
      903     run my_refresh in this-procedure
      904       ( input ?
      905       ).
      906     apply "entry" to br-auto-sessions.
      907   END.
      908   ON CHOOSE OF b-view-hide IN FRAME f-auto-start
