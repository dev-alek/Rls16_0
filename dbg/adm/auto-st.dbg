      553   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   function IsProcessRunning return integer
      555     (PID AS INTEGER) :
      556     DEFINE VARIABLE IsRunning   AS LOGICAL NO-UNDO INITIAL NO.
      557     DEFINE VARIABLE hProcess    AS INTEGER NO-UNDO.
      558     DEFINE VARIABLE ExitCode    AS INTEGER NO-UNDO.
      559     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
      560     define variable rv          as integer no-undo .
      561     RUN OpenProcess in hpapi
      562                     ( 1024,
      563                       0,
      564                       PID,
      565                       OUTPUT hProcess).
      566     IF hProcess NE 0 THEN DO:
      567        RUN GetExitcodeProcess in hpapi
      568                     ( hProcess,
      569                       OUTPUT ExitCode,
      570                       OUTPUT ReturnValue).
      571        rv = (if (ExitCode=259) AND (ReturnValue NE 0)
      572             then  - 1
      573             else ReturnValue).
      574        RUN CloseHandle in hpapi (hProcess, OUTPUT ReturnValue).
      575     END.
      576     RETURN rv.
      577   end.
      578   define variable vss-include-info7 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      579   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   define variable hAppRunningMutex as integer no-undo initial 0 .
      581   FUNCTION ValidateProductSuite RETURN LOGICAL (SuitName AS CHARACTER):
      582      DEFINE VARIABLE key-hdl        AS INTEGER NO-UNDO.
      583      DEFINE VARIABLE lpBuffer       AS MEMPTR  NO-UNDO.
      584      DEFINE VARIABLE lth            AS INTEGER NO-UNDO.
      585      DEFINE VARIABLE datatype       AS INTEGER NO-UNDO.
      586      DEFINE VARIABLE ReturnValue    AS INTEGER NO-UNDO.
      587      DEFINE VARIABLE retval         AS LOGICAL NO-UNDO INITIAL FALSE.
      588      RUN RegOpenKeyA IN hpApi
      589                     ( -2147483646,
      590                       "System\CurrentControlSet\Control\ProductOptions",
      591                       OUTPUT key-hdl,
      592                       OUTPUT ReturnValue).
      593      IF ReturnValue NE 0 THEN
      594         RETURN FALSE.
      595      ASSIGN lth                = 260 + 1
      596             SET-SIZE(lpBuffer) = lth.
      597      RUN RegQueryValueExA IN hpApi
      598                          ( key-hdl,
      599                            "ProductSuite",
      600                            0,
      601                            OUTPUT datatype,
      602                            GET-POINTER-VALUE(lpBuffer),
      603                            INPUT-OUTPUT lth,
      604                            OUTPUT ReturnValue).
      605      IF ReturnValue = 0 THEN
      606          retval =  (GET-STRING(lpBuffer,1)=SuitName).
      607      SET-SIZE(lpBuffer)=0.
      608      IF key-hdl NE 0 THEN
      609         RUN RegCloseKey IN hpApi (key-hdl,OUTPUT ReturnValue).
      610      RETURN retval.
      611   END FUNCTION.
      612   FUNCTION IsAppAlreadyRunning RETURN LOGICAL
      613      (p-OnePerSystem AS LOGICAL, p-AppName AS CHARACTER):
      614     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
      615     DEFINE VARIABLE MutexName   AS CHARACTER    NO-UNDO.
      616     MutexName = ''.
      617     IF p-OnePerSystem AND ValidateProductSuite("Terminal Server") THEN
      618        MutexName = MutexName + "Global\".
      619     MutexName = MutexName + p-AppName + ' is running'.
      620     RUN CreateMutexA IN hpApi(0,0,MutexName, OUTPUT hAppRunningMutex).
      621     IF hAppRunningMutex NE 0 THEN DO:
      622        RUN WaitForSingleObject IN hpApi (hAppRunningMutex,100, OUTPUT ReturnValue).
      623        IF NOT (ReturnValue=128 OR
      624                ReturnValue=0) THEN DO:
      625           RUN CloseHandle IN hpApi(hAppRunningMutex, OUTPUT ReturnValue).
      626           hAppRunningMutex = 0.
      627        END.
      628     END.
      629     RETURN (hAppRunningMutex = 0).
      630   END.
      631   PROCEDURE LetAnotherInstanceRun :
      632     DEFINE INPUT PARAMETER p-AppName AS CHARACTER NO-UNDO.
      633     DEFINE  VARIABLE ReturnValue AS INTEGER NO-UNDO.
      634     IF hAppRunningMutex NE 0 THEN DO:
      635           RUN CloseHandle IN hpApi(hAppRunningMutex, OUTPUT ReturnValue).
      636           hAppRunningMutex = 0.
      637     END.
      638   END PROCEDURE.
      639   define temp-table tt_auto-session no-undo
      640     field session-pid  as integer   initial 0
      641     field session-type as character
      642     field session-name as character
      643     field proc-name    as character
      644     field add-mode     as character
      645     index pi is unique primary session-pid session-type
      646     index i_proc proc-name
      647     index i_type session-type
      648     .
      649   define buffer X_auto-session for tt_auto-session .
      650   define variable v-rid-list as character no-undo .
      651   define variable v-start-mode as character no-undo .
      652   define variable v-exefile  as character no-undo .
      653   define variable v-inifile  as character no-undo .
      654   define variable v-work-dir as character no-undo .
      655   define variable log-exit as logical   no-undo .
      656   define stream VarStream .
      657   define variable v-varstr   as character no-undo .
      658   define variable v-varfile  as character no-undo .
      659   define variable v-task-name as character no-undo .
      660   define variable vDopParamSession as character no-undo .
      661   get-key-value section "THAutoSessions"
      662                   key "DopParamSession"
      663                 value vDopParamSession.
      664   if vDopParamSession = ? then
      665     vDopParamSession = "".
      666   FUNCTION ATH-var-name RETURNS CHARACTER
      667     ( INPUT p-pid AS INTEGER )  FORWARD.
      668   DEFINE VAR auto-st AS WIDGET-HANDLE NO-UNDO.
      669   DEFINE MENU POPUP-MENU-b-start
      670          MENU-ITEM m_b-start-view LABEL "Сессия видна"
      671          MENU-ITEM m_b-start-hidden LABEL "Сессия не видна".
      672   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      673        LABEL "Вы&ход "
      674        SIZE 10 BY 1 TOOLTIP "Выход из автоматической системы"
      675        BGCOLOR 8 .
      676   DEFINE BUTTON b-help
      677        LABEL "Помо&щь"
      678        SIZE 3 BY 1
      679        BGCOLOR 8 .
      680   DEFINE BUTTON b-mark
      681        LABEL "&*"
      682        SIZE 3 BY 1.
      683   DEFINE BUTTON b-start
      684        LABEL "&Выполнить"
      685        SIZE 10 BY 1.
      686   DEFINE BUTTON b-stop
      687        LABEL "&Останов"
      688        SIZE 10 BY 1.
      689   DEFINE BUTTON b-view-hide
      690        LABEL "По&казать/Скрыть"
      691        SIZE 16 BY 1.
      692   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      693         VIEW-AS TEXT
      694        SIZE 10.5 BY .67
      695        FGCOLOR 7  NO-UNDO.
      696   DEFINE QUERY br-auto-sessions FOR
      697         X_auto-session SCROLLING.
      698   DEFINE BROWSE br-auto-sessions
      699     QUERY br-auto-sessions DISPLAY
      700         mark-string( input recid(X_auto-session), input v-rid-list) column-label "*" format "X(1)":U
      701   X_auto-session.session-pid  column-label "PID"                    format ">>>>>>>>>9":U
      702   X_auto-session.session-name column-label "Название задания"       format "X(40)":U
      703   X_auto-session.add-mode     column-label "Доп. установки"         format "X(50)":U width-chars 14
      704   X_auto-session.session-type column-label "Тип"                    format "X(10)":U
      705   X_auto-session.proc-name    column-label "Запускающая процедура"  format "X(20)":U
      706       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.75.
      707   DEFINE FRAME f-auto-start
      708        b-exit AT ROW 1 COL 2.5
      709        b-mark AT ROW 1 COL 17 WIDGET-ID 4
      710        b-start AT ROW 1 COL 20 WIDGET-ID 6
      711        b-stop AT ROW 1 COL 30 WIDGET-ID 10
      712        b-view-hide AT ROW 1 COL 40 WIDGET-ID 12
      713        B-Help AT ROW 1 COL 95 WIDGET-ID 2
      714        br-auto-sessions AT ROW 2.75 COL 2.5 WIDGET-ID 100
      715        mark-num AT ROW 2 COL 2 NO-LABEL WIDGET-ID 8
      716       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      717            SIDE-LABELS NO-UNDERLINE THREE-D
      718            AT COL 1 ROW 1
      719            SIZE 99.38 BY 22.54.
      720   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      721     CREATE WINDOW auto-st ASSIGN
      722            HIDDEN             = YES
      723            TITLE              = "Запуск автопроцессов и поддержание их работы"
      724            HEIGHT             = 22.88
      725            WIDTH              = 99.25
      726            MAX-HEIGHT         = 41.58
      727            MAX-WIDTH          = 160
      728            VIRTUAL-HEIGHT     = 41.58
      729            VIRTUAL-WIDTH      = 160
      730            RESIZE             = no
      731            SCROLL-BARS        = no
      732            STATUS-AREA        = no
      733            BGCOLOR            = ?
      734            FGCOLOR            = ?
      735            KEEP-FRAME-Z-ORDER = yes
      736            THREE-D            = yes
      737            MESSAGE-AREA       = no
      738            SENSITIVE          = yes.
      739   ELSE auto-st = CURRENT-WINDOW.
      740   ASSIGN
      741          b-start:POPUP-MENU IN FRAME f-auto-start       = MENU POPUP-MENU-b-start:HANDLE.
      742   ASSIGN
      743          br-auto-sessions:ALLOW-COLUMN-SEARCHING IN FRAME f-auto-start = TRUE
      744          br-auto-sessions:COLUMN-RESIZABLE IN FRAME f-auto-start       = TRUE
      745          br-auto-sessions:COLUMN-MOVABLE IN FRAME f-auto-start         = TRUE.
      746   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(auto-st)
      747   THEN auto-st:HIDDEN = yes.
      748   ON END-ERROR OF auto-st
      749   OR ENDKEY OF auto-st ANYWHERE DO:
      750     RETURN NO-APPLY.
      751   END.
      752   ON WINDOW-CLOSE OF auto-st
      753   DO:
      754     RETURN NO-APPLY.
      755   END.
      756   ON CHOOSE OF b-exit IN FRAME f-auto-start
      757   DO:
      758     define variable v-answer as logical   no-undo .
      759     run gbl/q-wait.w
      760       ( input substitute( "Вы хотите завершить работу авторежима?" )
      761        ,input false
      762        ,input 20
      763        ,output v-answer
      764       ) no-error .
      765     if error-status :error
      766       or v-answer = true
      767     then do:
      768       if error-status :error then do:
      769       end.
      770       for each tt_auto-session
      771       :
      772         if lookup( "H":U, tt_auto-session.add-mode, "+":U ) > 0 then do:
      773   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   define variable v-str-recid10 as character no-undo .
      775   define variable v-num-entry10 as integer   no-undo .
      776   assign
      777     v-str-recid10 = trim( string( recid( tt_auto-session ) , "->>>>>>>>>>>9":U ) )
      778     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
      779   .
      780   if v-num-entry10 > 0 then do:
      781     assign
      782       entry( v-num-entry10, v-rid-list ) = "":U
      783       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      784     .
      785   end.
      786   else do:
      787     assign
      788       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
      789     .
      790   end.
      791         end.
      792       end.
      793       run stop-sessions in this-procedure
      794         no-error .
      795       if error-status :error then do:
      796         message
      797           vss-workfile vss-revision vss-description skip
      798           substitute("Ошибка при остановке сессий.") skip
      799           error-status :get-message(1) skip
      800           return-value skip
      801           view-as alert-box error .
      802         undo, return no-apply .
      803       end.
      804       for each tt_auto-session
      805       :
      806         delete tt_auto-session .
      807       end.
      808       assign
      809         log-exit = yes
      810       .
      811     end.
      812   END.
      813   ON CHOOSE OF b-mark IN FRAME f-auto-start
      814   DO:
      815     define variable loc#log as logical no-undo .
      816     if available X_auto-session then do:
      817   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      818   define variable v-str-recid12 as character no-undo .
      819   define variable v-num-entry12 as integer   no-undo .
      820   assign
      821     v-str-recid12 = trim( string( recid( X_auto-session ) , "->>>>>>>>>>>9":U ) )
      822     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
      823   .
      824   if v-num-entry12 > 0 then do:
      825     assign
      826       entry( v-num-entry12, v-rid-list ) = "":U
      827       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      828     .
