      934     run my_refresh in this-procedure
      935       ( input v-recid
      936       ).
      937     apply "entry" to br-auto-sessions.
      938   END.
      939   ON CHOOSE OF MENU-ITEM m_b-start-hidden
      940   DO:
      941     assign
      942       v-start-mode = "H":U
      943     .
      944     apply "choose" to b-start in frame f-auto-start.
      945   END.
      946   ON CHOOSE OF MENU-ITEM m_b-start-view
      947   DO:
