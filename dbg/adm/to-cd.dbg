        1   DEFINE INPUT PARAMETER   ref-mode   as   char  no-undo.
        2   DEFINE INPUT PARAMETER hostcode like ub.shop.host-code no-undo.
        3   DEFINE INPUT PARAMETER objtype like ub.clients.obj-type no-undo.
        4   DEFINE INPUT PARAMETER objcode like ub.shop.obj-code no-undo.
        5   define input parameter p-frame-title as character no-undo .
        6   DEFINE INPUT-OUTPUT PARAMETER all-prt like ub.shop.all-prt no-undo.
        7   DEFINE INPUT-OUTPUT PARAMETER cd-bc-alt like ub.shop.cd-bc-alt no-undo.
        8   DEFINE INPUT-OUTPUT PARAMETER cd-bc-base like ub.shop.cd-bc-base no-undo.
        9   DEFINE INPUT-OUTPUT PARAMETER cd-loc-alt like ub.shop.cd-loc-alt no-undo.
       10   DEFINE INPUT-OUTPUT PARAMETER cd-loc-base like ub.shop.cd-loc-base no-undo.
       11   DEFINE INPUT-OUTPUT PARAMETER cd-parts-all like ub.shop.cd-parts-all no-undo.
       12   DEFINE INPUT-OUTPUT PARAMETER cd-parts-not-blank like ub.shop.cd-parts-not-blank no-undo.
       13   DEFINE INPUT-OUTPUT PARAMETER cd-parts-ser like ub.shop.cd-parts-ser no-undo.
       14   DEFINE INPUT-OUTPUT PARAMETER cd-pb-alt like ub.shop.cd-pb-alt no-undo.
       15   DEFINE INPUT-OUTPUT PARAMETER cd-pb-base like ub.shop.cd-pb-base no-undo.
       16   DEFINE INPUT-OUTPUT PARAMETER cd-sc-base like ub.shop.cd-sc-base no-undo.
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   procedure proc-alt-shift-f2:
       93     if not ibs.th.gbl.gbl-var:rcode
       94   then
       95     run gbl\inidebug.p .
       96   end.
       97   procedure proc-alt-shift-f3:
       98     run gbl/prvssinf.p
       99       ( input this-procedure
      100       ) .
      101   end.
      102   define variable v-inform-launched as logical no-undo initial false .
      103   procedure proc-alt-shift-f4:
      104     define variable v-action as character no-undo .
      105     if v-inform-launched = false then do:
      106       assign
      107         v-inform-launched = true
      108       .
      109       run gbl/d-inform.w
      110         (  input self
      111         ,  input this-procedure
      112         , output v-action
      113         ) no-error .
      114       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      115       assign
      116         v-inform-launched = false
      117       .
      118     end.
      119   end.
      120   procedure proc-alt-f1:
      121     run gbl/corrhelp.p
      122       (input this-procedure
      123       ) .
      124   end .
      125   on alt-shift-f2 anywhere do:
      126     run proc-alt-shift-f2.
      127   end.
      128   on alt-shift-f3 anywhere do:
      129     run proc-alt-shift-f3 in this-procedure .
      130   end.
      131   on alt-shift-f4 anywhere do:
      132     run proc-alt-shift-f4 in this-procedure.
      133   end.
      134   on alt-f1 anywhere do:
      135     run proc-alt-f1 in this-procedure .
      136   end.
      137   DEFINE BUTTON B-default
      138        LABEL "По &умолчанию"
      139        SIZE 16 BY 1.
      140   DEFINE BUTTON B-exit AUTO-GO
      141        LABEL "Ввод"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON B-help
      145        LABEL "Помо&щь"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON B-quit AUTO-END-KEY
      149        LABEL "&Отмена"
      150        SIZE 10 BY 1
      151        BGCOLOR 8 .
      152   DEFINE RECTANGLE RECT-bc
      153        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      154        SIZE 31.38 BY 6.29.
      155   DEFINE RECTANGLE RECT-part
      156        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      157        SIZE 31.38 BY 6.29.
      158   DEFINE RECTANGLE RECT-pb
      159        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      160        SIZE 31.38 BY 6.29.
      161   DEFINE VARIABLE T-all-prt AS LOGICAL INITIAL no
      162        LABEL "Отсылать все коды признаков"
      163        VIEW-AS TOGGLE-BOX
      164        SIZE 30.13 BY .79 NO-UNDO.
      165   DEFINE VARIABLE T-bc-alt AS LOGICAL INITIAL no
      166        LABEL "неосновые бар-коды (EAN)"
      167        VIEW-AS TOGGLE-BOX
      168        SIZE 28.88 BY .79 NO-UNDO.
      169   DEFINE VARIABLE T-bc-base AS LOGICAL INITIAL no
      170        LABEL "основные бар-коды (EAN)"
      171        VIEW-AS TOGGLE-BOX
      172        SIZE 28.88 BY .79 NO-UNDO.
      173   DEFINE VARIABLE T-loc-alt AS LOGICAL INITIAL no
      174        LABEL "неосновные коды"
      175        VIEW-AS TOGGLE-BOX
      176        SIZE 28.88 BY .79 NO-UNDO.
      177   DEFINE VARIABLE T-loc-base AS LOGICAL INITIAL no
      178        LABEL "основные коды"
      179        VIEW-AS TOGGLE-BOX
      180        SIZE 28.88 BY .79 NO-UNDO.
      181   DEFINE VARIABLE T-parts-all AS LOGICAL INITIAL no
      182        LABEL "на весь товар"
      183        VIEW-AS TOGGLE-BOX
      184        SIZE 20.38 BY .79 NO-UNDO.
      185   DEFINE VARIABLE T-parts-not-blank AS LOGICAL INITIAL no
      186        LABEL "на товар с непуст. N партий"
      187        VIEW-AS TOGGLE-BOX
      188        SIZE 29.63 BY .79 NO-UNDO.
      189   DEFINE VARIABLE T-parts-ser AS LOGICAL INITIAL no
      190        LABEL "на серийный товар"
      191        VIEW-AS TOGGLE-BOX
      192        SIZE 21.13 BY .79 NO-UNDO.
      193   DEFINE VARIABLE T-pb-alt AS LOGICAL INITIAL no
      194        LABEL "неосновн. ед.изм"
      195        VIEW-AS TOGGLE-BOX
      196        SIZE 21.88 BY .79 NO-UNDO.
      197   DEFINE VARIABLE T-pb-base AS LOGICAL INITIAL no
      198        LABEL "основн. ед.изм"
      199        VIEW-AS TOGGLE-BOX
      200        SIZE 22 BY .79 NO-UNDO.
      201   DEFINE VARIABLE T-sc-base AS LOGICAL INITIAL no
      202        LABEL "весовые и топливные"
      203        VIEW-AS TOGGLE-BOX
      204        SIZE 22.25 BY .79 NO-UNDO.
      205   DEFINE FRAME Dialog-Frame
      206        B-exit AT ROW 1.29 COL 1.63
      207        B-quit AT ROW 1.29 COL 11.63
      208        B-default AT ROW 1.29 COL 21.63
      209        B-help AT ROW 1.29 COL 49.75
      210        T-loc-base AT ROW 4.29 COL 2.5
      211        T-pb-base AT ROW 4.33 COL 34.5
      212        T-loc-alt AT ROW 5.42 COL 2.5
      213        T-pb-alt AT ROW 5.46 COL 34.5
      214        T-bc-base AT ROW 6.54 COL 2.5
      215        T-sc-base AT ROW 6.58 COL 34.5
      216        T-bc-alt AT ROW 7.79 COL 2.5
      217        T-all-prt AT ROW 9.63 COL 2.25
      218        T-parts-ser AT ROW 11.08 COL 35
      219        T-parts-not-blank AT ROW 12.21 COL 35
      220        T-parts-all AT ROW 13.33 COL 35
      221        RECT-bc AT ROW 2.75 COL 1.75
      222        RECT-pb AT ROW 2.79 COL 33.75
      223        "Отсылать собственные коды:" VIEW-AS TEXT
      224             SIZE 26.5 BY .71 AT ROW 3.13 COL 2.38
      225        "Отсылать ДОП.БК:" VIEW-AS TEXT
      226             SIZE 22.13 BY .71 AT ROW 3.17 COL 34.25
      227        RECT-part AT ROW 9.33 COL 33.75
      228        "Отсылать коды партий:" VIEW-AS TEXT
      229             SIZE 20.88 BY .71 AT ROW 9.92 COL 35.5
      230        SPACE(9.49) SKIP(5.36)
      231       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      232            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      233            TITLE "Настройка параметров отсылки товаров на кассу"
      234            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      235   ASSIGN
      236          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      237          FRAME Dialog-Frame:HIDDEN           = TRUE.
      238   ASSIGN
      239          B-default:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      240   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      241   DO:
      242     APPLY "END-ERROR":U TO SELF.
      243   END.
      244   ON CHOOSE OF B-default IN FRAME Dialog-Frame
      245   DO:
      246     FIND FIRST ub.sysconf NO-LOCK WHERE ub.sysconf.host-code = hostcode NO-ERROR.
      247     IF NOT AVAIL ub.sysconf then return no-apply.
      248      assign
      249      T-all-prt = ub.sysconf.all-prt
      250      T-bc-alt = ub.sysconf.cd-bc-alt
      251      T-bc-base = ub.sysconf.cd-bc-base
      252      T-loc-alt = ub.sysconf.cd-loc-alt
      253      T-loc-base = ub.sysconf.cd-loc-base
      254      T-parts-all = ub.sysconf.cd-parts-all
      255      T-parts-not-blank = ub.sysconf.cd-parts-not-blank
      256      T-parts-ser = ub.sysconf.cd-parts-ser
      257      T-pb-alt = ub.sysconf.cd-pb-alt
      258      T-pb-base = ub.sysconf.cd-pb-base
      259      T-sc-base = ub.sysconf.cd-sc-base.
      260      DISPLAY
      261      T-all-prt
      262      T-bc-alt T-bc-base T-loc-alt T-loc-base
      263      T-parts-all T-parts-not-blank T-parts-ser
      264      T-pb-alt T-pb-base T-sc-base
      265      WITH FRAME Dialog-Frame.
      266   END.
      267   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      268   DO:
      269     assign
      270     T-all-prt
      271     T-bc-alt T-bc-base T-loc-alt T-loc-base
      272     T-parts-all T-parts-not-blank T-parts-ser
      273     T-pb-alt T-pb-base T-sc-base.
      274     assign
      275     all-prt = T-all-prt
      276     cd-bc-alt = T-bc-alt
      277     cd-bc-base = T-bc-base
      278     cd-loc-alt = T-loc-alt
      279     cd-loc-base = T-loc-base
      280     cd-parts-all = T-parts-all
      281     cd-parts-not-blank = T-parts-not-blank
      282     cd-parts-ser = T-parts-ser
      283     cd-pb-alt = T-pb-alt
      284     cd-pb-base = T-pb-base
      285     cd-sc-base = T-sc-base .
      286   END.
      287   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      288   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      289   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      290   on help of frame Dialog-Frame
      291   do:
      292     run gbl/app_help.p
      293       (input this-procedure :file-name
      294       ,input ''
      295       ,input ?
      296       ) no-error.
      297     if error-status :error then do:
      298       message
      299         "Ошибка при вызове помощи"
      300         error-status :get-message(1)
      301         view-as alert-box .
      302     end.
      303   end.
      304   run minbtn-set in this-procedure .
      305   on choose of b-help in frame Dialog-Frame
      306   do:
      307     apply "help":u to frame Dialog-Frame .
      308   end.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   procedure minbtn-set :
      311       do
      312           on error undo, return error return-value
      313           :
      314           define variable ii              as integer       no-undo .
      315           define variable fh              as widget-handle no-undo .
      316           define variable hh              as widget-handle no-undo .
      317           define variable v-h             as handle        extent 4 no-undo .
      318           define variable v-name-button   as character     no-undo .
      319           define variable v-help-old-x    as decimal       no-undo .
      320           define variable v-help-old-y    as decimal       no-undo .
      321           define variable v-help-old-size as decimal       no-undo .
      322           define variable v-frame-width   as decimal       no-undo .
      323           define variable jj              as integer       no-undo .
      324           do
      325               on error undo, return error
      326               :
      327               assign
      328                   v-frame-width = frame Dialog-Frame:width - 0.3
      329                   fh            = frame Dialog-Frame:first-child
      330                   hh            = fh:first-child
      331                   ii            = 1
      332                   .
      333               do while valid-handle(hh):
      334                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      335                   do:
      336                       case lc(hh:name) :
      337                           when "b-help" then
      338                               do:
      339                                   hh:load-image-up("cmp/b-help.bmp":u) .
      340                                   hh:load-image-down("cmp/b-help.bmp":u) .
      341                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      342                                   hh:TOOLTIP = "Помощь" .
      343                                   v-help-old-x = hh:column .
      344                                   v-help-old-y = hh:row    .
      345                                   v-help-old-size = hh:width .
      346                                   hh:width-chars = 2.5 .
      347                               end.
      348                           when "b-print" then
      349                               do:
      350                                   hh:load-image("cmp/b-print.bmp":u) .
      351                                   hh:TOOLTIP = "Печать" .
      352                                   v-h[ii] = hh:handle .
      353                                   ii = ii + 1 .
      354                                   hh:width-chars = 3 .
      355                               end.
      356                           when "b-history" or
      357                           when "b-hist" then
      358                               do:
      359                                   hh:load-image("cmp/b-hist.bmp":u) .
      360                                   hh:TOOLTIP = "История" .
      361                                   v-h[ii] = hh:handle .
      362                                   ii = ii + 1 .
      363                                   hh:width-chars = 3 .
      364                               end.
      365                           when "b-sch" then
      366                               do:
      367                                   hh:load-image("cmp/b-sch.bmp":u) .
      368                                   hh:TOOLTIP = "Установка Фильтра" .
      369                                   v-h[ii] = hh:handle .
      370                                   ii = ii + 1 .
      371                                   hh:width-chars = 3 .
      372                               end.
      373                           when "b-hist-user" then
      374                               do:
      375                                   hh:load-image("cmp/b-hist.bmp":u) .
      376                                   hh:TOOLTIP = "История пользователя" .
      377                                   ii = ii + 1 .
      378                               end.
      379                       end case.
      380                   end.
      381                   hh = hh:next-sibling.
      382               end.
      383               b-help:column = v-frame-width - b-help:width-chars.
      384               jj = 0.
      385               repeat ii = 4 to 1 by -1 :
      386                   if valid-handle (v-h[ii] ) then
      387                   do:
      388                       jj  = jj + 1 .
      389                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      390                       v-h[ii]:row    = v-help-old-y .
      391                   end.
      392               end.
      393           end.
      394       end.
      395   end procedure.
      396   MAIN-BLOCK:
      397   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      398      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      399      assign
      400      T-all-prt = all-prt
      401      T-bc-alt = cd-bc-alt
      402      T-bc-base = cd-bc-base
      403      T-loc-alt = cd-loc-alt
      404      T-loc-base = cd-loc-base
      405      T-parts-all = cd-parts-all
      406      T-parts-not-blank = cd-parts-not-blank
      407      T-parts-ser = cd-parts-ser
      408      T-pb-alt = cd-pb-alt
      409      T-pb-base = cd-pb-base
      410      T-sc-base = cd-sc-base.
      411     RUN enable_UI.
      412     assign
      413     FRAME Dialog-Frame:title = p-frame-title.
      414     IF ref-mode = 'ПРОСМОТР':U then do:
      415       b-quit:label = "&Выход ".
      416       DISPLAY b-exit with FRAME Dialog-Frame.
      417       DISABLE
      418       B-default B-exit
      419       T-all-prt
      420       T-bc-alt T-bc-base T-loc-alt T-loc-base
      421       T-parts-all T-parts-not-blank T-parts-ser
      422       T-pb-alt T-pb-base T-sc-base
      423       WITH FRAME Dialog-Frame.
      424     end.
      425     if objcode = 0 then do:
      426         DISABLE
      427         B-default
      428         WITH FRAME Dialog-Frame.
      429         HIDE
      430         B-default
      431         IN FRAME Dialog-Frame.
      432     end.
      433     WAIT-FOR GO OF FRAME Dialog-Frame.
      434   END.
      435   RUN disable_UI.
      436   PROCEDURE disable_UI :
      437     HIDE FRAME Dialog-Frame.
      438   END PROCEDURE.
      439   PROCEDURE enable_UI :
      440     DISPLAY T-loc-base T-pb-base T-loc-alt T-pb-alt T-bc-base T-sc-base T-bc-alt
      441             T-all-prt T-parts-ser T-parts-not-blank T-parts-all
      442         WITH FRAME Dialog-Frame.
      443     ENABLE RECT-bc RECT-pb RECT-part B-exit B-quit B-default B-help T-loc-base
      444            T-pb-base T-loc-alt T-pb-alt T-bc-base T-sc-base T-bc-alt T-all-prt
      445            T-parts-ser T-parts-not-blank T-parts-all
      446         WITH FRAME Dialog-Frame.
      447     VIEW FRAME Dialog-Frame.
      448   END PROCEDURE.
