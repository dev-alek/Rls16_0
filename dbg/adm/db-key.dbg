        1   define input parameter p-ParentProc as handle no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "Справочник использованых ключей баз данных" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define   shared variable g#auto as logical no-undo.
      114   define   shared variable g#news as logical no-undo.
      115   define   shared variable g#oxml as logical no-undo.
      116   define   shared variable g#esys as logical no-undo.
      117   define   shared variable g#news-source-db as integer no-undo.
      118   define   shared variable g#esys-source-esys as integer no-undo.
      119   define   shared variable g#db-num as integer   no-undo .
      120   define   shared variable g#userid as character no-undo .
      121   define   shared variable g#passwd as character no-undo .
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   Function reverse returns character (str as character).
      124      define variable rev_incl_s as character init "" no-undo .
      125      define variable rev_incl_i as integer no-undo .
      126      define variable rev_incl_l as integer no-undo .
      127      rev_incl_l = length(str).
      128      do rev_incl_i = 1 to rev_incl_l:
      129         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      130      end.
      131      return rev_incl_s.
      132   end.
      133   procedure check-enc.
      134     define input  parameter p-db-num    as integer   no-undo .
      135     define input  parameter p-db-key    as character no-undo .
      136     define input  parameter p-code      as character no-undo .
      137     define input  parameter p-value     as character no-undo .
      138     define input  parameter p-beg-date  as date      no-undo .
      139     define input  parameter p-end-date  as date      no-undo .
      140     define input  parameter p-enc-value as character no-undo .
      141     define output parameter p-answer    as logical   no-undo .
      142     define variable tmp         as character no-undo .
      143     define variable v-enc-value as character no-undo .
      144     if p-db-num <> 0
      145       and p-db-key = "":U
      146     then do:
      147       assign
      148         p-answer = true
      149       .
      150       return.
      151     end.
      152     if p-db-key = "unload-db":U then do:
      153       assign
      154         p-answer = true
      155       .
      156       return.
      157     end.
      158     if p-code = ""  then do:
      159       assign
      160         tmp = string( p-db-num ) + reverse (p-db-key).
      161       .
      162     end.
      163     else do:
      164       assign
      165         tmp = string( p-db-num )
      166               + trim( p-db-key )
      167               + reverse( trim( p-code ) )
      168               + reverse( trim( p-value ) )
      169               + reverse( string( p-beg-date, "99.99.9999" ) )
      170               + reverse( string( p-end-date, "99.99.9999" ) )
      171       .
      172     end.
      173     run pswd-enc in this-procedure
      174       ( input tmp
      175        ,output v-enc-value
      176       ) no-error .
      177     if error-status:error then do:
      178       message
      179         vss-workfile vss-revision vss-description skip
      180         "Ошибка при вызове процедуры pswd-enc" skip
      181         return-value skip
      182         error-status :get-message(1) skip
      183         view-as alert-box error .
      184       undo, return error .
      185     end.
      186     if v-enc-value = p-enc-value then do:
      187       assign
      188         p-answer = true
      189       .
      190     end.
      191     else do:
      192       assign
      193         p-answer = false
      194       .
      195     end.
      196   end.
      197   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   procedure pswd-enc :
      199     define input parameter  pswd     as character no-undo .
      200     define output parameter enc-pswd as character no-undo .
      201     do
      202     on error undo, return error return-value
      203     :
      204       assign
      205         enc-pswd = encode(pswd + string(index(pswd, "k")))
      206       .
      207     end.
      208   end procedure.
      209   function diff-list returns character (
      210     input parfirst-list  as character,
      211     input parsecond-list as character,
      212     input pardelim       as character).
      213     if pardelim = ""
      214     or pardelim = ?
      215     then do:
      216       assign
      217         pardelim = ","
      218       .
      219     end.
      220     def var ind as integer no-undo .
      221     def var v-elem as character no-undo .
      222     def var v-result-list as character no-undo init "".
      223     def var v-num-parfirst-list as integer no-undo .
      224     assign
      225       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      226     .
      227     do ind = 1 to v-num-parfirst-list
      228     :
      229       assign
      230         v-elem = entry(ind, parfirst-list, pardelim)
      231       .
      232       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      233         assign
      234           v-result-list = v-result-list
      235                         + (if v-result-list > "" then pardelim else "")
      236                         + v-elem
      237         .
      238       end.
      239     end.
      240     return v-result-list .
      241   end function.
      242   function add-list returns character (
      243    input parfirst-list  as character,
      244    input parsecond-list as character,
      245    input pardelim       as character).
      246     if pardelim = ""
      247     or pardelim = ?
      248     then do:
      249       assign
      250         pardelim = ","
      251       .
      252     end.
      253     def var ind as integer no-undo .
      254     def var v-elem as character no-undo .
      255     def var v-result-list as character no-undo init "".
      256     def var v-num-parfirst-list as integer no-undo .
      257     assign
      258       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      259     .
      260     do ind = 1 to v-num-parfirst-list
      261     :
      262       assign
      263         v-elem = entry(ind, parfirst-list, pardelim)
      264       .
      265       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      266         assign
      267           v-result-list = v-result-list
      268                         + (if v-result-list > "" then pardelim else "")
      269                         + v-elem
      270         .
      271       end.
      272     end.
      273     def var v-num-parsecond-list as integer no-undo .
      274     assign
      275       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      276     .
      277     do ind = 1 to v-num-parsecond-list
      278     :
      279       assign
      280         v-elem = entry(ind, parsecond-list, pardelim)
      281       .
      282       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      283         assign
      284           v-result-list = v-result-list
      285                         + (if v-result-list > "" then pardelim else "")
      286                         + v-elem
      287         .
      288       end.
      289     end.
      290     return v-result-list .
      291   end function.
      292   function cross-list returns character (
      293    input parfirst-list  as character,
      294    input parsecond-list as character,
      295    input pardelim       as character).
      296     if pardelim = ""
      297     or pardelim = ?
      298     then do:
      299       assign
      300         pardelim = ","
      301       .
      302     end.
      303     def var ind as integer no-undo .
      304     def var v-elem as character no-undo .
      305     def var v-result-list as character no-undo init "".
      306     def var v-num-parfirst-list as integer no-undo .
      307     assign
      308       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      309     .
      310     do ind = 1 to v-num-parfirst-list
      311     :
      312       assign
      313         v-elem = entry(ind, parfirst-list, pardelim)
      314       .
      315       if lookup(v-elem, v-result-list, pardelim) = 0
      316       and lookup(v-elem, parsecond-list, pardelim) > 0
      317       then do:
      318         assign
      319           v-result-list = v-result-list
      320                         + (if v-result-list > "" then pardelim else "")
      321                         + v-elem
      322         .
      323       end.
      324     end.
      325     return v-result-list .
      326   end function.
      327   function radio-label returns character (
      328    input par-rs-value  as character,
      329    input par-rs-radio-buttons as character)
      330    .
      331    DEFINE variable v-result-label as character no-undo.
      332    assign
      333    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      334                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      335                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      336                             ), par-rs-radio-buttons
      337                           )
      338    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      339    .
      340   return v-result-label.
      341   end function.
      342   function m-radio-label returns character (
      343    input par-rs-value  as character,
      344    input par-rs-radio-buttons as character,
      345    input par-delim as character
      346    )
      347    .
      348    DEFINE variable v-result-label as character no-undo.
      349    assign
      350    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      351                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      352                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      353                             ), par-rs-radio-buttons, par-delim
      354                           )
      355    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      356    .
      357   return v-result-label.
      358   end function.
      359   FUNCTION mixlist returns character
      360   (
      361    input parfirst-list  as character
      362    ,input parsecond-list as character
      363    ,input pardelim       as character
      364    ,input pardelim-result as character ) :
      365     if pardelim = ""
      366     or pardelim = ?
      367     then do:
      368       assign
      369         pardelim = ","
      370       .
      371     end.
      372     def var ind as integer no-undo .
      373     def var v-elem1 as character no-undo .
      374     def var v-elem2 as character no-undo .
      375     def var v-result-list as character no-undo init "".
      376     do ind = 1 to num-entries(parfirst-list, pardelim)
      377     :
      378       assign
      379         v-elem1 = entry(ind, parfirst-list, pardelim)
      380         v-elem2 = entry(ind, parsecond-list, pardelim)
      381       .
      382         assign
      383           v-result-list = v-result-list
      384                         + (if v-result-list > "" then pardelim-result else "")
      385                         + v-elem1 + pardelim-result + v-elem2
      386         .
      387     end.
      388     return v-result-list .
      389   END FUNCTION.
      390   procedure save-db-key :
      391     define input parameter p-db-key like ub.db.db-key no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       define buffer buf_rep for ub.rep .
      396       find buf_rep
      397         where buf_rep.rep-num = 1996011200
      398         no-error
      399       .
      400       if not available buf_rep then do:
      401         create buf_rep.
      402         assign
      403           buf_rep.rep-num = 1996011200
      404         .
      405       end.
      406       if lookup( p-db-key, buf_rep.name1 ) = 0 then do:
      407         assign
      408           buf_rep.name1 = buf_rep.name1 + ",":U + p-db-key
      409         .
      410       end.
      411     end.
      412   end procedure.
      413   procedure del-db-key :
      414     define input parameter p-db-key like ub.db.db-key no-undo .
      415     do
      416     on error undo, return error
      417     :
      418       define buffer buf_rep for ub.rep .
      419       define buffer buf_db  for ub.db .
      420       find first buf_db
      421         where buf_db.db-key = p-db-key
      422         no-error
      423       .
      424       if not available buf_db then do:
      425         find first buf_rep
      426           where buf_rep.rep-num = 1996011200
      427           no-error
      428         .
      429         if available buf_rep
      430           and lookup( p-db-key, buf_rep.name1 ) <> 0
      431         then do:
      432           assign
      433             buf_rep.name1 = diff-list( buf_rep.name1, p-db-key, ",":U )
      434           .
      435         end.
      436       end.
      437     end.
      438   end procedure.
      439   procedure chk-db-key :
      440     define input  parameter p-db-num     like ub.db.db-num     no-undo.
      441     define input  parameter p-db-key     like ub.db.db-key     no-undo.
      442     define input  parameter p-db-key-enc like ub.db.db-key-enc no-undo.
      443     define output parameter p-result     as   integer          no-undo .
      444     do
      445     on error undo, return error
      446     :
      447       define buffer buf_rep for ub.rep .
      448       define buffer buf_db  for ub.db .
      449       define variable v-ok as logical no-undo .
      450       if p-db-key = ?
      451         or p-db-key = ""
      452       then do:
      453         assign
      454           p-result = 1
      455         .
      456         return string("Не задано значение ключа БД.").
      457       end.
      458       if p-db-key-enc = ?
      459         or p-db-key-enc = ""
      460       then do:
      461         assign
      462           p-result = 2
      463         .
      464         return string("Не задано кодированное значение ключа БД.").
      465       end.
      466       find buf_rep
      467         where buf_rep.rep-num = 1996011200
      468         no-error
      469       .
      470       if not available buf_rep then do:
      471         create buf_rep.
      472         assign
      473           buf_rep.rep-num = 1996011200
      474         .
      475       end.
      476       for each buf_db no-lock
      477       on error undo, return error
      478       :
      479         if lookup( buf_db.db-key, buf_rep.name1 ) = 0 then do:
      480           assign
      481             buf_rep.name1 = buf_rep.name1 + ",":U + buf_db.db-key
      482           .
      483         end.
      484       end.
      485       assign
      486         p-result = 0
      487       .
      488       if lookup( p-db-key, buf_rep.name1 ) <> 0 then do:
      489         assign
      490           p-result = 1
      491         .
      492         return string("Данное значение ключа БД уже существует.").
      493       end.
      494       run check-enc in this-procedure
      495         ( input p-db-num
      496          ,input p-db-key
      497          ,input ""
      498          ,input ""
      499          ,input ?
      500          ,input ?
      501          ,input p-db-key-enc
      502          ,output v-ok
      503         ) no-error.
      504       if error-status:error then do:
      505         assign
      506           p-result = 1
      507         .
      508         return substitute( "Ошибка при проверке правильности кодирования. &1", error-status:get-message (1) ) .
      509       end.
      510       if v-ok <> true then do:
      511         assign
      512           p-result = 2
      513         .
      514         return string("Неверное кодированное значение ключа БД.").
      515       end.
      516     end.
      517   end procedure.
      518   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      520   define  shared variable RepPathName        as character no-undo .
      521   define  shared variable PrintRubl          as logical   no-undo .
      522   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   define  stream PrnLibStream.
      524   procedure prn-lib-prn-file :
      525     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      526     define input parameter p-DIsabledoptions as integer no-undo .
      527     define variable v-report-name as character no-undo .
      528     define variable v-user-action as character no-undo .
      529     define variable v-printed     as logical   no-undo .
      530     define variable v-exist       as logical   no-undo .
      531     do
      532       on error undo, return error
      533       :
      534       run prn-lib-get-report-name  in this-procedure (
      535         input parParentProc
      536         ,output v-report-name
      537         ).
      538   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      539   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      540     (input  v-report-name
      541     ,input  2
      542     ,output v-exist
      543     )  .
      544       if NOT v-exist then
      545       DO:
      546         Message
      547           "Нет заданий на печать ! "
      548           view-as alert-box .
      549         Return  .
      550       End.
      551       run gbl/prnfilen.w
      552         (input  ""
      553         ,input  p-DisabledOptions
      554         ,input  string(v-report-name )
      555         ,input  7
      556         ,output v-user-action
      557         ,output v-printed
      558         ) .
      559       if v-printed then
      560       do:
      561         return "YES" .
      562       end.
      563       else
      564       do:
      565         return "NO" .
      566       end.
      567     end.
      568   end procedure.
      569   procedure prn-lib-open-stream :
      570     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      571     define input parameter p-page-size    as integer no-undo .
      572     define input parameter p-is-stream    as logical no-undo .
      573     define input parameter p-append       as logical no-undo .
      574     define variable v-report-name as character no-undo .
      575     do
      576       on error undo, return error
      577       :
      578       run prn-lib-get-report-name  in this-procedure (
      579         input parParentProc
      580         ,output v-report-name
      581         ).
      582       if p-is-stream then
      583       do:
      584         if p-append then
      585         do:
      586           output stream PrnLibStream to value( v-report-name )
      587             page-size value(p-page-size) append .
      588         end.
      589         if not p-append then
      590         do:
      591           output stream PrnLibStream to value( v-report-name )
      592             page-size value(p-page-size) .
      593         end.
      594       end.
      595       if not p-is-stream then
      596       do:
      597         if p-append then
      598         do:
      599           output to value( v-report-name )
      600             page-size value(p-page-size) append .
      601         end.
      602         if not p-append then
      603         do:
      604           output to value( v-report-name )
      605             page-size value(p-page-size) .
      606         end.
      607       end.
      608     end.
      609   end procedure.
      610   procedure prn-lib-open-exp :
      611     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      612     define input parameter p-is-stream    as logical no-undo .
      613     define input parameter p-is-append    as logical no-undo .
      614     define output parameter p-ReportFileName as char init "report" no-undo.
      615     define output parameter p-process as logical no-undo .
      616     define variable glog as logical no-undo .
      617     do
      618       on error undo, return error
      619       :
      620       SYSTEM-DIALOG GET-FILE p-ReportFileName
      621         TITLE      "Укажите путь"
      622         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      623         ASK-OVERWRITE
      624         CREATE-TEST-FILE
      625         SAVE-AS
      626         USE-FILENAME
      627         DEFAULT-EXTENSION "txt"
      628         UPDATE glog
      629         .
      630       if not glog then  return.
      631       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      632       if p-is-stream then
      633       do:
      634         if p-is-append then
      635         do:
      636           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      637         end.
      638         else
      639         do:
      640           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      641         end.
      642       end.
      643       else
      644       do:
      645         if p-is-append then
      646         do:
      647           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      648         end.
      649         else
      650         do:
      651           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      652         end.
      653       end.
      654       p-process = yes.
      655     end.
      656   end procedure.
      657   procedure prn-lib-get-report-name :
      658     define input parameter parParentProc  as widget-handle no-undo.
      659     define output parameter p-report-name as character no-undo .
      660     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      661   end procedure.
      662   procedure prn-lib-reportviewer-report-name :
      663     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      664     define input parameter p-report-name-html as character no-undo .
      665     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      666   end procedure.
      667   procedure prn-lib-reportviewer :
      668     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      669     define input parameter p-report-name-html as character no-undo .
      670     define input parameter p-param        as character no-undo .
      671     define variable v-excel           as character no-undo init 'TRUE' .
      672     define variable v-value-character as character no-undo .
      673     define variable v-value-integer   as character no-undo .
      674     define variable v-value-date      as date      no-undo .
      675     define variable v-value-decimal   as decimal   no-undo .
      676     define variable rep-excel         as logical   no-undo .
      677     define variable excel-string      as character no-undo .
      678     define variable v-param-type      as character no-undo .
      679     define variable v-tth             as handle    no-undo .
      680     run adm/shattri.p (
      681       input "get":U
      682       ,input  ""
      683       ,input  0
      684       ,input  'report-glob':U
      685       ,input  'rep-excel':U
      686       ,output v-value-character
      687       ,output v-value-date
      688       ,output v-value-decimal
      689       ,output v-value-integer
      690       ,output rep-excel
      691       ,output v-param-type
      692       ,INPUT-OUTPUT table-handle v-tth
      693       )  .
      694     if rep-excel then v-excel = "TRUE" .
      695     else v-excel = "FALSE" .
      696     if p-param eq ""
      697     then
      698        p-param = "EXCEL:" + v-excel.
      699     else
      700        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      701     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      702   end procedure.
      703   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   procedure cur-time :
      705      define output parameter p-today as date      no-undo .
      706      define output parameter p-time  as integer   no-undo .
      707     do
      708     on error undo, return error
      709     :
      710       define variable v-date1 as date      no-undo .
      711       define variable v-date2 as date      no-undo .
      712       define variable v-time  as integer   no-undo .
      713       assign
      714         v-date1 = today
      715         v-time  = time
      716         v-date2 = today
      717       .
      718       if v-date1 <> v-date2
      719       then do:
      720         assign
      721           v-date1 = today
      722           v-time  = v-time
      723         .
      724       end.
      725       assign
      726         p-today = v-date1
      727         p-time  = v-time
      728       .
      729     end.
      730   end.
      731   function cur-time-date returns character
      732   :
      733     return string(today, '99/99/9999':U) .
      734   end.
      735   function cur-time-mjd returns decimal
      736   :
      737     define variable v-date as date      no-undo .
      738     define variable v-time as integer   no-undo .
      739     run cur-time in this-procedure
      740       (output v-date
      741       ,output v-time
      742       ) .
      743     return integer(v-date) - 2400002 + (v-time / 86400) .
      744   end.
      745   function cur-time-get-ending-index returns integer
      746   (input p-number as integer
      747   )
      748   :
      749     if p-number < 0
      750     or p-number = ?
      751     then do:
      752       return 1 .
      753     end.
      754     define variable v-rest as integer   no-undo .
      755     assign
      756       p-number = p-number modulo 100
      757     .
      758     if p-number < 20
      759     then do:
      760       assign
      761         v-rest = p-number
      762       .
      763     end.
      764     else do:
      765       assign
      766         v-rest = p-number modulo 10
      767       .
      768     end.
      769     case v-rest :
      770       when 1
      771       then do:
      772         return 2 .
      773       end.
      774       when 2 or
      775       when 3 or
      776       when 4
      777       then do:
      778         return 3 .
      779       end.
      780       otherwise do:
      781         return 1 .
      782       end.
      783     end case .
      784   end.
      785   procedure cur-time-mjd-to-date :
      786      define input  parameter i-mjd-diff as decimal no-undo.
      787      define output parameter o-Date     as date    no-undo.
      788      define output parameter o-Time     as integer no-undo.
      789      define variable v-day-number as integer   no-undo .
      790      if    i-mjd-diff < 0
      791         or i-mjd-diff = ?
      792      then do:
      793         return "?" .
      794      end.
      795      assign
      796         v-day-number = truncate(i-mjd-diff,0).
      797         o-Date = date(v-day-number + 2400002).
      798         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      799     .
      800   end.
      801   function cur-time-mjd-to-string returns character
      802   (input p-mjd-diff as decimal
      803   )
      804   :
      805     define variable v-day-number as integer   no-undo .
      806     define variable v-seconds    as integer   no-undo .
      807     define variable v-hour       as integer   no-undo .
      808     define variable v-min        as integer   no-undo .
      809     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      810     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      811     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      812     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      813     if p-mjd-diff < 0
      814     or p-mjd-diff = ?
      815     then do:
      816       return "?" .
      817     end.
      818     assign
      819       v-day-number = integer(truncate(p-mjd-diff,0))
      820       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      821     .
      822     if v-seconds > 86400
      823     then do:
      824       assign
      825         v-seconds = 86400 - 1
      826       .
      827     end.
      828     if v-seconds < 0
      829     then do:
      830       assign
      831         v-seconds = 0
      832       .
      833     end.
      834     assign
      835       v-hour = truncate(v-seconds / 3600, 0)
      836     .
      837     assign
      838       v-seconds = v-seconds modulo 3600
      839     .
      840     assign
      841       v-min = truncate(v-seconds / 60, 0)
      842     .
      843     assign
      844       v-seconds = v-seconds modulo 60
      845     .
      846     return
      847         (if v-day-number <> 0
      848           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      849           else ""
      850         )
      851       + (if v-day-number <> 0 or v-hour <> 0
      852           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      853           else ""
      854         )
      855       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      856           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      857           else ""
      858         )
      859       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      860       .
      861   end.
      862   function cur-time-string returns character
      863   :
      864     define variable v-date as date      no-undo .
      865     define variable v-time as integer   no-undo .
      866     run cur-time in this-procedure
      867       (output v-date
      868       ,output v-time
      869       ) .
      870     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      871   end.
      872   function cur-time-string-sec returns character
      873   :
      874     define variable v-date as date      no-undo .
      875     define variable v-time as integer   no-undo .
      876     run cur-time in this-procedure
      877       (output v-date
      878       ,output v-time
      879       ) .
      880     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      881   end.
      882   function cur-time-custom  returns character
      883   (input p-prefix as character
      884   ,input p-date-format as character
      885   ,input p-delimiter as character
      886   ,input p-time-format as character
      887   ,input p-suffix as character
      888   )
      889   :
      890     define variable v-date as date      no-undo .
      891     define variable v-time as integer   no-undo .
      892     run cur-time in this-procedure
      893       (output v-date
      894       ,output v-time
      895       ) .
      896     return
      897       p-prefix
      898       + string(v-date, p-date-format)
      899       + p-delimiter
      900       + string(v-time, p-time-format)
      901       + p-suffix
      902       .
      903   end.
      904   function cur-time-print  returns character
      905   :
      906     define variable v-date as date      no-undo .
      907     define variable v-time as integer   no-undo .
      908     run cur-time in this-procedure
      909       (output v-date
      910       ,output v-time
      911       ) .
      912     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      913   end.
      914   function cur-time-datetime returns datetime
      915   :
      916     define variable v-char as character no-undo .
      917     define variable v-datetime as datetime no-undo .
      918     v-char = cur-time-string().
      919     v-datetime = datetime(v-char).
      920     return  v-datetime.
      921   end.
      922   function cur-time-string-msec returns character
      923   :
      924     define variable v-date as datetime  no-undo .
      925     v-date = now.
      926     return string(v-date) .
      927   end.
      928   define variable log-res       as logical   no-undo .
      929   define variable v-rowid       as rowid     no-undo .
      930   define variable v-type-unload as character no-undo .
      931   define temp-table tt_key no-undo
      932     field num-pp as integer
      933     field db-key as character
      934     index pi as unique primary num-pp
      935     index pii as unique db-key
      936   .
      937   DEFINE BUTTON b-exp DEFAULT
      938        LABEL "&Экспорт":L
      939        SIZE 10 BY 1.
      940   DEFINE BUTTON b-help DEFAULT
      941        LABEL "Помо&щь":L
      942        SIZE 10 BY 1.
      943   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      944        LABEL "&Выход ":L
      945        SIZE 10 BY 1.
      946   DEFINE QUERY br-curr-db FOR
      947         ub.db SCROLLING.
      948   DEFINE QUERY br-last-key FOR
      949         tt_key SCROLLING.
      950   DEFINE BROWSE br-curr-db
      951     QUERY br-curr-db NO-LOCK DISPLAY
      952         ub.db.db-num FORMAT ">>>>9":U
      953         ub.db.db-key COLUMN-LABEL "Ключ БД" FORMAT "X(12)":U WIDTH 11.75
      954         ub.db.db-name COLUMN-LABEL "Название БД" FORMAT "X(40)":U
      955       WITH NO-ROW-MARKERS SEPARATORS SIZE 57.5 BY 18.
      956   DEFINE BROWSE br-last-key
      957     QUERY br-last-key DISPLAY
      958         tt_key.db-key FORMAT "X(12)"
      959       WITH NO-ROW-MARKERS SEPARATORS SIZE 14.75 BY 18 ROW-HEIGHT-CHARS .67.
      960   DEFINE FRAME d-db
      961        b-quit AT ROW 1.21 COL 2
      962        b-exp AT ROW 1.21 COL 12
      963        b-help AT ROW 1.21 COL 65
      964        br-curr-db AT ROW 4 COL 2
      965        br-last-key AT ROW 4 COL 61
      966        "Использованые" VIEW-AS TEXT
      967             SIZE 13.5 BY .75 AT ROW 2.5 COL 61
      968        "ключи БД" VIEW-AS TEXT
      969             SIZE 9 BY .67 AT ROW 3.25 COL 64
      970        "Текущие ключи БД" VIEW-AS TEXT
      971             SIZE 18.5 BY .67 AT ROW 2.75 COL 17
      972        SPACE(41.24) SKIP(18.99)
      973       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      974            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      975            TITLE "Ключи БД":L.
      976   ASSIGN
      977          FRAME d-db:SCROLLABLE       = FALSE.
      978   ON CHOOSE OF b-exp IN FRAME d-db
      979   DO:
      980     define variable v-single-line as character no-undo .
      981     define variable sym1 as character init ":" no-undo .
      982     define variable sym2 as character init ":" no-undo .
      983     define variable sym3 as character init ":" no-undo .
      984     define variable sym4 as character init ":" no-undo .
      985     define buffer buf-prn_db for ub.db .
      986     define frame f-db-key
      987         sym1 column-label ":" format "X(1)"
      988         buf-prn_db.db-num COLUMN-LABEL "БД" format ">>>9"
      989         sym2 column-label ":" format "X(1)"
      990         buf-prn_db.db-key COLUMN-LABEL "Ключ БД" format "X(12)"
      991         sym3 column-label ":" format "X(1)"
      992         buf-prn_db.db-name COLUMN-LABEL "Наименование БД" format "X(112)"
      993         sym4 column-label ":" format "X(1)" space(0)
      994       header
      995         substitute( "Текущие значения ключей БД (&1)", cur-time-print() ) format "X(62)"
      996         substitute( "Страница &1", PAGE-NUMBER( PrnLibStream ) ) at 110 format "X(13)" SKIP
      997         v-single-line format "X(136)" at 1
      998       with width 235 down stream-io.
      999     define frame f-old-db-key
     1000         sym1 column-label ":" format "X(1)"
     1001         tt_key.num-pp COLUMN-LABEL "N п/п" format ">>>,>>>,>>9"
     1002         sym2 column-label ":" format "X(1)"
     1003         tt_key.db-key COLUMN-LABEL "Ключ БД" format "X(12)"
     1004         sym3 column-label ":" format "X(1)" space(0)
     1005       header
     1006         "Использованные ключи БД" SKIP
     1007         cur-time-print() format "X(40)" SKIP
     1008         substitute( "Страница &1", PAGE-NUMBER( PrnLibStream ) ) format "X(13)" SKIP
     1009         v-single-line format "X(30)" at 1
     1010       with width 235 down stream-io.
     1011     run prn-lib-open-stream  in this-procedure
     1012       ( input p-ParentProc
     1013        ,input 62
     1014        ,input yes
     1015        ,input no
     1016       ).
     1017     form with frame f-db-key .
     1018     assign
     1019       v-single-line = fill("-", 136)
     1020     .
     1021     form header
     1022         v-single-line format "x(136)" at 1 skip
     1023         "Продолжение - на следующей странице" at 30 skip
     1024         with frame bottomframe width 160 page-bottom no-labels no-box .
     1025     view stream PrnLibStream frame bottomframe .
     1026     run fill-tt_key in this-procedure.
     1027     for each buf-prn_db no-lock
     1028     on error undo, return no-apply
     1029     :
     1030       display stream PrnLibStream
     1031         sym1
     1032         buf-prn_db.db-num
     1033         sym2
     1034         buf-prn_db.db-key
     1035         sym3
     1036         buf-prn_db.db-name
     1037         sym4
     1038       with frame f-db-key .
     1039       down stream PrnLibStream 1 with frame f-db-key .
     1040     end.
     1041     put stream PrnLibStream
     1042       v-single-line format "x(136)" skip(2)
     1043     .
     1044     form with frame f-old-db-key .
     1045     assign
     1046       v-single-line = fill("-", 30)
     1047     .
     1048     for each tt_key
     1049     on error undo, return no-apply
     1050     :
     1051       display stream PrnLibStream
     1052         sym1
     1053         tt_key.num-pp
     1054         sym2
     1055         tt_key.db-key
     1056         sym3
     1057       with frame f-old-db-key .
     1058       down stream PrnLibStream 1 with frame f-old-db-key .
     1059     end.
     1060     hide stream PrnLibStream frame BottomFrame .
     1061     put stream PrnLibStream
     1062       v-single-line format "x(30)" skip
     1063     .
     1064     output stream PrnLibStream close.
     1065     run prn-lib-prn-file in this-procedure
     1066       ( input p-ParentProc
     1067        ,input 0
     1068       ).
     1069   END.
     1070   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-db:PARENT eq ?
     1071   THEN FRAME d-db:PARENT = ACTIVE-WINDOW.
     1072   ON WINDOW-CLOSE OF FRAME d-db APPLY "END-ERROR":U TO SELF.
     1073   MAIN-BLOCK:
     1074   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1075      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1076      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1077   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   on help of frame d-db
     1079   do:
     1080     run gbl/app_help.p
     1081       (input this-procedure :file-name
     1082       ,input ''
     1083       ,input ?
     1084       ) no-error.
     1085     if error-status :error then do:
     1086       message
     1087         "Ошибка при вызове помощи"
     1088         error-status :get-message(1)
     1089         view-as alert-box .
     1090     end.
     1091   end.
     1092   run minbtn-set in this-procedure .
     1093   on choose of b-help in frame d-db
     1094   do:
     1095     apply "help":u to frame d-db .
     1096   end.
     1097   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   procedure minbtn-set :
     1099       do
     1100           on error undo, return error return-value
     1101           :
     1102           define variable ii              as integer       no-undo .
     1103           define variable fh              as widget-handle no-undo .
     1104           define variable hh              as widget-handle no-undo .
     1105           define variable v-h             as handle        extent 4 no-undo .
     1106           define variable v-name-button   as character     no-undo .
     1107           define variable v-help-old-x    as decimal       no-undo .
     1108           define variable v-help-old-y    as decimal       no-undo .
     1109           define variable v-help-old-size as decimal       no-undo .
     1110           define variable v-frame-width   as decimal       no-undo .
     1111           define variable jj              as integer       no-undo .
     1112           do
     1113               on error undo, return error
     1114               :
     1115               assign
     1116                   v-frame-width = frame d-db:width - 0.3
     1117                   fh            = frame d-db:first-child
     1118                   hh            = fh:first-child
     1119                   ii            = 1
     1120                   .
     1121               do while valid-handle(hh):
     1122                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1123                   do:
     1124                       case lc(hh:name) :
     1125                           when "b-help" then
     1126                               do:
     1127                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1128                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1129                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1130                                   hh:TOOLTIP = "Помощь" .
     1131                                   v-help-old-x = hh:column .
     1132                                   v-help-old-y = hh:row    .
     1133                                   v-help-old-size = hh:width .
     1134                                   hh:width-chars = 2.5 .
     1135                               end.
     1136                           when "b-print" then
     1137                               do:
     1138                                   hh:load-image("cmp/b-print.bmp":u) .
     1139                                   hh:TOOLTIP = "Печать" .
     1140                                   v-h[ii] = hh:handle .
     1141                                   ii = ii + 1 .
     1142                                   hh:width-chars = 3 .
     1143                               end.
     1144                           when "b-history" or
     1145                           when "b-hist" then
     1146                               do:
     1147                                   hh:load-image("cmp/b-hist.bmp":u) .
     1148                                   hh:TOOLTIP = "История" .
     1149                                   v-h[ii] = hh:handle .
     1150                                   ii = ii + 1 .
     1151                                   hh:width-chars = 3 .
     1152                               end.
     1153                           when "b-sch" then
     1154                               do:
     1155                                   hh:load-image("cmp/b-sch.bmp":u) .
     1156                                   hh:TOOLTIP = "Установка Фильтра" .
     1157                                   v-h[ii] = hh:handle .
     1158                                   ii = ii + 1 .
     1159                                   hh:width-chars = 3 .
     1160                               end.
     1161                           when "b-hist-user" then
     1162                               do:
     1163                                   hh:load-image("cmp/b-hist.bmp":u) .
     1164                                   hh:TOOLTIP = "История пользователя" .
     1165                                   ii = ii + 1 .
     1166                               end.
     1167                       end case.
     1168                   end.
     1169                   hh = hh:next-sibling.
     1170               end.
     1171               b-help:column = v-frame-width - b-help:width-chars.
     1172               jj = 0.
     1173               repeat ii = 4 to 1 by -1 :
     1174                   if valid-handle (v-h[ii] ) then
     1175                   do:
     1176                       jj  = jj + 1 .
     1177                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1178                       v-h[ii]:row    = v-help-old-y .
     1179                   end.
     1180               end.
     1181           end.
     1182       end.
     1183   end procedure.
     1184   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1185   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1186   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1187   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1188   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1189   define variable v-diasize-current-frame-height as decimal   no-undo .
     1190   define variable v-diasize-change-size          as logical   no-undo .
     1191   define variable v-diasize-resize-button        as handle    no-undo .
     1192   define variable v-diasize-wndmax               as logical   no-undo .
     1193   define variable v-diasize-wndstore             as logical   no-undo .
     1194   define variable v-diasize-proc-name            as character no-undo .
     1195   define variable v-diasize-browse-handle        as handle    no-undo .
     1196   define variable v-diasize-browse-number        as integer   no-undo .
     1197   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1198   define temp-table temp-diasize-handle no-undo
     1199     field handle-value  as handle
     1200     field save-position as decimal
     1201     index xpk is primary unique handle-value
     1202     .
     1203   define temp-table temp-browse-handle no-undo
     1204     field browse-type   as character
     1205     field browse-number as integer
     1206     field browse-handle as handle
     1207     field original-size as decimal
     1208     index xpk is primary unique browse-type browse-number
     1209     index xie browse-type browse-handle
     1210   .
     1211   procedure diasize_change-height :
     1212     define input  parameter p-change-value  as decimal   no-undo .
     1213     define input  parameter p-move-resize   as logical   no-undo .
     1214     define variable v-field-group-handle    as handle    no-undo .
     1215     define variable v-object-handle         as handle    no-undo .
     1216     define variable v-frame-height          as decimal   no-undo .
     1217     define variable v-frame-virtual-height  as decimal   no-undo .
     1218     define variable v-browse-height         as decimal   no-undo .
     1219     define variable v-window-height         as decimal   no-undo .
     1220     define variable v-window-virtual-height as decimal   no-undo .
     1221     define variable v-change-sign           as integer   no-undo .
     1222     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1223     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1224     if p-change-value > 0
     1225     then do:
     1226       if frame d-db :height + p-change-value
     1227           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1228       then do:
     1229         assign
     1230           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1231                           - (frame d-db :height-chars)
     1232         .
     1233         if p-change-value <= 0
     1234         then do:
     1235           run diasize_position-resize-button in this-procedure .
     1236           return .
     1237         end.
     1238       end.
     1239     end.
     1240     if p-change-value < 0
     1241     then do:
     1242       if frame d-db :height + p-change-value < v-diasize-orig-frame-height
     1243       then do:
     1244         assign
     1245           p-change-value = v-diasize-orig-frame-height
     1246                          - (frame d-db :height-chars)
     1247         .
     1248         if p-change-value >= 0
     1249         then do:
     1250           run diasize_position-resize-button in this-procedure .
     1251           return .
     1252         end.
     1253       end.
     1254     end.
     1255     if p-change-value >= 0
     1256     then do:
     1257       assign
     1258         v-change-sign = 1
     1259       .
     1260     end.
     1261     else do:
     1262       assign
     1263         v-change-sign = -1
     1264       .
     1265     end.
     1266     assign
     1267       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1268     .
     1269     if p-change-value = 0
     1270     then do:
     1271       run diasize_position-resize-button in this-procedure .
     1272       return .
     1273     end.
     1274     move_block:
     1275     do
     1276     on error undo move_block, retry move_block
     1277     :
     1278       if retry
     1279       then do:
     1280         do
     1281         on error undo move_block, leave move_block
     1282         :
     1283           if p-change-value > 0
     1284           then do:
     1285             for each buf_temp-diasize-handle
     1286             on error undo, next
     1287             :
     1288               assign
     1289                 v-object-handle = buf_temp-diasize-handle.handle-value
     1290               .
     1291               if v-object-handle <> v-diasize-resize-button
     1292               then do:
     1293                 assign
     1294                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1295                 .
     1296               end.
     1297             end.
     1298             assign
     1299               v-diasize-browse-handle :height = v-browse-height
     1300             .
     1301             for each buf_temp-browse-handle
     1302               where buf_temp-browse-handle.browse-type = 'height':u
     1303             on error undo, next
     1304             :
     1305               assign
     1306                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1307               .
     1308             end.
     1309             assign
     1310               frame d-db :height = v-frame-height
     1311             .
     1312             if frame d-db :scrollable = true
     1313             then do:
     1314               assign
     1315                 frame d-db :virtual-height = v-frame-virtual-height
     1316               .
     1317             end.
     1318             run diasize_position-resize-button in this-procedure .
     1319           end.
     1320           else do:
     1321             if frame d-db :scrollable = true
     1322             then do:
     1323               assign
     1324                 frame d-db :virtual-height = v-frame-virtual-height
     1325               .
     1326             end.
     1327             assign
     1328               frame d-db :height = v-frame-height
     1329             .
     1330             assign
     1331               v-diasize-browse-handle :height = v-browse-height
     1332             .
     1333             for each buf_temp-browse-handle
     1334               where buf_temp-browse-handle.browse-type = 'height':u
     1335             on error undo, next
     1336             :
     1337               assign
     1338                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1339               .
     1340             end.
     1341             for each buf_temp-diasize-handle
     1342             on error undo, next
     1343             :
     1344               assign
     1345                 v-object-handle = buf_temp-diasize-handle.handle-value
     1346               .
     1347               if v-object-handle <> v-diasize-resize-button
     1348               then do:
     1349                 assign
     1350                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1351                 .
     1352               end.
     1353             end.
     1354             run diasize_position-resize-button in this-procedure .
     1355           end.
     1356           assign
     1357             v-diasize-change-size = false
     1358           .
     1359           leave move_block .
     1360         end.
     1361       end.
     1362       assign
     1363         v-diasize-need-full-display = true
     1364       .
     1365       if v-diasize-change-size = false
     1366       then do:
     1367         assign
     1368           v-diasize-change-size = true
     1369         .
     1370       end.
     1371       else do:
     1372         return .
     1373       end.
     1374       assign
     1375         v-frame-height = frame d-db :height
     1376         v-frame-virtual-height = frame d-db :virtual-height
     1377         v-browse-height = v-diasize-browse-handle :height
     1378       .
     1379       for each buf_temp-browse-handle
     1380         where buf_temp-browse-handle.browse-type = 'height':u
     1381       :
     1382         assign
     1383           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1384         .
     1385       end.
     1386       for each buf_temp-diasize-handle
     1387       :
     1388         delete buf_temp-diasize-handle .
     1389       end.
     1390       assign
     1391         v-field-group-handle = frame d-db :first-child
     1392       .
     1393       do while valid-handle(v-field-group-handle)
     1394       :
     1395         assign
     1396           v-object-handle = v-field-group-handle :first-child
     1397         .
     1398         do while valid-handle(v-object-handle)
     1399         :
     1400           if  v-object-handle <> v-diasize-browse-handle :handle
     1401           and can-query(v-object-handle, "row")
     1402           and can-query(v-object-handle, "height")
     1403           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1404           then do:
     1405             find first buf_temp-browse-handle
     1406               where buf_temp-browse-handle.browse-type   = 'height':u
     1407                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1408               no-error .
     1409             if available buf_temp-browse-handle
     1410             then do:
     1411             end.
     1412             else do:
     1413               create buf_temp-diasize-handle .
     1414               assign
     1415                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1416                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1417               .
     1418             end.
     1419           end.
     1420           assign
     1421             v-object-handle = v-object-handle :next-sibling
     1422           .
     1423         end.
     1424         assign
     1425           v-field-group-handle = v-field-group-handle :next-sibling
     1426         .
     1427       end.
     1428       do with frame d-db
     1429       :
     1430         hide v-diasize-resize-button .
     1431         assign
     1432           v-diasize-resize-button :row    = 1
     1433           v-diasize-resize-button :column = 1
     1434         .
     1435       end.
     1436       if p-change-value > 0
     1437       then do:
     1438         if frame d-db :scrollable = true
     1439         then do:
     1440           assign
     1441             frame d-db :virtual-height = frame d-db :virtual-height + p-change-value
     1442             no-error .
     1443           if error-status :error
     1444           or error-status :get-message(1) <> ""
     1445           then do:
     1446             undo move_block, retry move_block .
     1447           end.
     1448         end.
     1449         assign
     1450           frame d-db :height = frame d-db :height + p-change-value
     1451           no-error .
     1452         if error-status :error
     1453         or error-status :get-message(1) <> ""
     1454         then do:
     1455           undo move_block, retry move_block .
     1456         end.
     1457         assign
     1458           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1459           no-error .
     1460         if error-status :error
     1461         or error-status :get-message(1) <> ""
     1462         then do:
     1463           undo move_block, retry move_block .
     1464         end.
     1465         for each buf_temp-browse-handle
     1466           where buf_temp-browse-handle.browse-type = 'height':u
     1467         on error undo move_block, retry move_block
     1468         :
     1469           assign
     1470             buf_temp-browse-handle.browse-handle :height
     1471               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1472             no-error .
     1473           if error-status :error
     1474           or error-status :get-message(1) <> ""
     1475           then do:
     1476             undo move_block, retry move_block .
     1477           end.
     1478         end.
     1479         for each buf_temp-diasize-handle
     1480         on error undo move_block, retry move_block
     1481         :
     1482           assign
     1483             v-object-handle = buf_temp-diasize-handle.handle-value
     1484           .
     1485           if v-object-handle <> v-diasize-resize-button
     1486           then do:
     1487             assign
     1488               v-object-handle :row = v-object-handle :row + p-change-value
     1489               no-error .
     1490             if error-status :error
     1491             or error-status :get-message(1) <> ""
     1492             then do:
     1493               undo move_block, retry move_block .
     1494             end.
     1495           end.
     1496         end.
     1497       end.
     1498       else do:
     1499         for each buf_temp-diasize-handle
     1500         on error undo move_block, retry move_block
     1501         :
     1502           assign
     1503             v-object-handle = buf_temp-diasize-handle.handle-value
     1504           .
     1505           if v-object-handle <> v-diasize-resize-button
     1506           then do:
     1507             assign
     1508               v-object-handle :row = v-object-handle :row + p-change-value
     1509               no-error .
     1510             if error-status :error
     1511             or error-status :get-message(1) <> ""
     1512             then do:
     1513               undo move_block, retry move_block .
     1514             end.
     1515           end.
     1516         end.
     1517         assign
     1518           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1519           no-error .
     1520         if error-status :error
     1521         or error-status :get-message(1) <> ""
     1522         then do:
     1523           undo move_block, retry move_block .
     1524         end.
     1525         for each buf_temp-browse-handle
     1526           where buf_temp-browse-handle.browse-type = 'height':u
     1527         on error undo move_block, retry move_block
     1528         :
     1529           assign
     1530             buf_temp-browse-handle.browse-handle :height
     1531               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1532             no-error .
     1533           if error-status :error
     1534           or error-status :get-message(1) <> ""
     1535           then do:
     1536             undo move_block, retry move_block .
     1537           end.
     1538         end.
     1539         assign
     1540           frame d-db :height = frame d-db :height + p-change-value
     1541           no-error .
     1542         if error-status :error
     1543         or error-status :get-message(1) <> ""
     1544         then do:
     1545           undo move_block, retry move_block .
     1546         end.
     1547         if frame d-db :scrollable = true
     1548         then do:
     1549           assign
     1550             frame d-db :virtual-height = frame d-db :virtual-height + p-change-value
     1551             no-error .
     1552           if error-status :error
     1553           or error-status :get-message(1) <> ""
     1554           then do:
     1555             undo move_block, retry move_block .
     1556           end.
     1557         end.
     1558       end.
     1559       if p-move-resize = true
     1560       then do:
     1561         run diasize_position-resize-button in this-procedure .
     1562       end.
     1563       if v-diasize-wndstore = true
     1564       then do:
     1565         if connected("ub") = true
     1566         then do:
     1567           define variable v-cntxt-db-num        as integer   no-undo .
     1568           define variable v-cntxt-userid        as character no-undo .
     1569           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1570                                             , OUTPUT v-cntxt-userid
     1571                                             ) .
     1572           run gbl/wndsizew.p
     1573             (input  v-cntxt-db-num
     1574             ,input  v-cntxt-userid
     1575             ,input  v-diasize-proc-name
     1576             ,input  'height':u
     1577             ,input  string(frame d-db :height - v-diasize-orig-frame-height)
     1578             ) .
     1579         end.
     1580       end.
     1581     end.
     1582     assign
     1583       v-diasize-change-size = false
     1584     .
     1585   end procedure.
     1586   procedure diasize_set-height :
     1587     define input  parameter p-new-height  as decimal   no-undo .
     1588     define input  parameter p-move-resize as logical   no-undo .
     1589     do
     1590     on error undo, return error return-value
     1591     :
     1592       run diasize_change-height in this-procedure
     1593         (input  (p-new-height - frame d-db :height)
     1594         ,input  p-move-resize
     1595         ) .
     1596     end.
     1597   end procedure.
     1598   procedure diasize_change-width :
     1599     define input  parameter p-change-value as decimal   no-undo .
     1600     define input  parameter p-move-resize  as logical   no-undo .
     1601     define variable v-field-group-handle   as handle    no-undo .
     1602     define variable v-object-handle        as handle    no-undo .
     1603     define variable v-frame-width          as decimal   no-undo .
     1604     define variable v-frame-virtual-width  as decimal   no-undo .
     1605     define variable v-browse-width         as decimal   no-undo .
     1606     define variable v-window-width         as decimal   no-undo .
     1607     define variable v-window-virtual-width as decimal   no-undo .
     1608     define variable v-change-sign          as integer   no-undo .
     1609     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1610     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1611     if p-change-value > 0
     1612     then do:
     1613       if frame d-db :width + p-change-value >
     1614           session :width-chars
     1615       then do:
     1616         assign
     1617           p-change-value = session :width-chars - frame d-db :width
     1618         .
     1619         if p-change-value <= 0
     1620         then do:
     1621           run diasize_position-resize-button in this-procedure .
     1622           return .
     1623         end.
     1624       end.
     1625     end.
     1626     if p-change-value < 0
     1627     then do:
     1628       if frame d-db :width + p-change-value < v-diasize-orig-frame-width
     1629       then do:
     1630         assign
     1631           p-change-value = v-diasize-orig-frame-width
     1632                          - frame d-db :width
     1633         .
     1634         if p-change-value >= 0
     1635         then do:
     1636           run diasize_position-resize-button in this-procedure .
     1637           return .
     1638         end.
     1639       end.
     1640     end.
     1641     if p-change-value >= 0
     1642     then do:
     1643       assign
     1644         v-change-sign = 1
     1645       .
     1646     end.
     1647     else do:
     1648       assign
     1649         v-change-sign = -1
     1650       .
     1651     end.
     1652     assign
     1653       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1654     .
     1655     if p-change-value = 0
     1656     then do:
     1657       run diasize_position-resize-button in this-procedure .
     1658       return .
     1659     end.
     1660     move_block:
     1661     do
     1662     on error undo move_block, leave move_block
     1663     :
     1664       if retry
     1665       then do:
     1666         do
     1667         on error undo move_block, leave move_block
     1668         :
     1669           if p-change-value > 0
     1670           then do:
     1671             for each buf_temp-diasize-handle
     1672             on error undo, next
     1673             :
     1674               assign
     1675                 v-object-handle = buf_temp-diasize-handle.handle-value
     1676               .
     1677               if v-object-handle <> v-diasize-resize-button
     1678               then do:
     1679                 assign
     1680                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1681                 .
     1682               end.
     1683             end.
     1684             assign
     1685               v-diasize-browse-handle :width = v-browse-width
     1686             .
     1687             for each buf_temp-browse-handle
     1688               where buf_temp-browse-handle.browse-type = 'width':u
     1689             on error undo, next
     1690             :
     1691               assign
     1692                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1693               .
     1694             end.
     1695             assign
     1696               frame d-db :width = v-frame-width
     1697             .
     1698             if frame d-db :scrollable = true
     1699             then do:
     1700               assign
     1701                 frame d-db :virtual-width = v-frame-virtual-width
     1702               .
     1703             end.
     1704             run diasize_position-resize-button in this-procedure .
     1705           end.
     1706           else do:
     1707             if frame d-db :scrollable = true
     1708             then do:
     1709               assign
     1710                 frame d-db :virtual-width = v-frame-virtual-width
     1711               .
     1712             end.
     1713             assign
     1714               frame d-db :width = v-frame-width
     1715             .
     1716             for each buf_temp-browse-handle
     1717               where buf_temp-browse-handle.browse-type = 'width':u
     1718             on error undo, next
     1719             :
     1720               assign
     1721                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1722               .
     1723             end.
     1724             assign
     1725               v-diasize-browse-handle :width = v-browse-width
     1726             .
     1727             for each buf_temp-diasize-handle
     1728             on error undo, next
     1729             :
     1730               assign
     1731                 v-object-handle = buf_temp-diasize-handle.handle-value
     1732               .
     1733               if v-object-handle <> v-diasize-resize-button
     1734               then do:
     1735                 assign
     1736                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1737                 .
     1738               end.
     1739             end.
     1740             run diasize_position-resize-button in this-procedure .
     1741           end.
     1742           assign
     1743             v-diasize-change-size = false
     1744           .
     1745           leave move_block .
     1746         end.
     1747       end.
     1748       assign
     1749         v-diasize-need-full-display = true
     1750       .
     1751       if v-diasize-change-size = false
     1752       then do:
     1753         assign
     1754           v-diasize-change-size = true
     1755         .
     1756       end.
     1757       else do:
     1758         return .
     1759       end.
     1760       assign
     1761         v-frame-width = frame d-db :width
     1762         v-frame-virtual-width = frame d-db :virtual-width
     1763         v-browse-width = v-diasize-browse-handle :width
     1764       .
     1765       for each buf_temp-browse-handle
     1766         where buf_temp-browse-handle.browse-type = 'width':u
     1767       :
     1768         assign
     1769           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1770         .
     1771       end.
     1772       for each buf_temp-diasize-handle
     1773       :
     1774         delete buf_temp-diasize-handle .
     1775       end.
     1776       assign
     1777         v-field-group-handle = frame d-db :first-child
     1778       .
     1779       do while valid-handle(v-field-group-handle)
     1780       :
     1781         assign
     1782           v-object-handle = v-field-group-handle :first-child
     1783         .
     1784         do while valid-handle(v-object-handle)
     1785         :
     1786           if  v-object-handle <> v-diasize-browse-handle :handle
     1787           and v-object-handle <> v-diasize-resize-button
     1788           and can-query(v-object-handle, "row")
     1789           and can-query(v-object-handle, "height")
     1790           and ( v-object-handle :col + v-object-handle :width
     1791                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1792               )
     1793           then do:
     1794             find first buf_temp-browse-handle
     1795               where buf_temp-browse-handle.browse-type   = 'width':u
     1796                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1797               no-error .
     1798             if available buf_temp-browse-handle
     1799             then do:
     1800             end.
     1801             else do:
     1802               create buf_temp-diasize-handle .
     1803               assign
     1804                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1805                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1806               .
     1807             end.
     1808           end.
     1809           assign
     1810             v-object-handle = v-object-handle :next-sibling
     1811           .
     1812         end.
     1813         assign
     1814           v-field-group-handle = v-field-group-handle :next-sibling
     1815         .
     1816       end.
     1817       do with frame d-db
     1818       :
     1819         hide v-diasize-resize-button .
     1820         v-diasize-resize-button :row = 1.
     1821         v-diasize-resize-button :column = 1.
     1822       end.
     1823       if p-change-value > 0
     1824       then do:
     1825         if frame d-db :scrollable = true
     1826         then do:
     1827           assign
     1828             frame d-db :virtual-width = frame d-db :virtual-width + p-change-value
     1829             no-error .
     1830           if error-status :error
     1831           or error-status :get-message(1) <> ""
     1832           then do:
     1833             undo move_block, retry move_block.
     1834           end.
     1835         end.
     1836         assign
     1837           frame d-db :width = v-frame-width + p-change-value
     1838           no-error .
     1839         if error-status :error
     1840         or error-status :get-message(1) <> ""
     1841         then do:
     1842           undo move_block, retry move_block.
     1843         end.
     1844         assign
     1845           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1846         no-error .
     1847         if error-status :error
     1848         or error-status :get-message(1) <> ""
     1849         then do:
     1850           undo move_block, retry move_block.
     1851         end.
     1852         for each buf_temp-browse-handle
     1853           where buf_temp-browse-handle.browse-type = 'width':u
     1854         on error undo move_block, retry move_block
     1855         :
     1856           assign
     1857             buf_temp-browse-handle.browse-handle :width
     1858               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1859             no-error .
     1860           if error-status :error
     1861           or error-status :get-message(1) <> ""
     1862           then do:
     1863             undo move_block, retry move_block .
     1864           end.
     1865         end.
     1866         for each buf_temp-diasize-handle
     1867         on error undo move_block, retry move_block
     1868         :
     1869           assign
     1870             v-object-handle = buf_temp-diasize-handle.handle-value
     1871           .
     1872           if v-object-handle <> v-diasize-resize-button
     1873           then do:
     1874             assign
     1875               v-object-handle :col = v-object-handle :col + p-change-value
     1876               no-error .
     1877             if error-status :error
     1878             or error-status :get-message(1) <> ""
     1879             then do:
     1880               undo move_block, retry move_block .
     1881             end.
     1882           end.
     1883         end.
     1884       end.
     1885       else do:
     1886         for each buf_temp-diasize-handle
     1887         on error undo move_block, retry move_block
     1888         :
     1889           assign
     1890             v-object-handle = buf_temp-diasize-handle.handle-value
     1891           .
     1892           if v-object-handle <> v-diasize-resize-button
     1893           then do:
     1894             assign
     1895               v-object-handle :col = v-object-handle :col + p-change-value
     1896               no-error .
     1897             if error-status :error
     1898             or error-status :get-message(1) <> ""
     1899             then do:
     1900               undo move_block, retry move_block .
     1901             end.
     1902           end.
     1903         end.
     1904         for each buf_temp-browse-handle
     1905           where buf_temp-browse-handle.browse-type = 'width':u
     1906         on error undo move_block, retry move_block
     1907         :
     1908           assign
     1909             buf_temp-browse-handle.browse-handle :width
     1910               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1911             no-error .
     1912           if error-status :error
     1913           or error-status :get-message(1) <> ""
     1914           then do:
     1915             undo move_block, retry move_block .
     1916           end.
     1917         end.
     1918         assign
     1919           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1920           no-error .
     1921         if error-status :error
     1922         or error-status :get-message(1) <> ""
     1923         then do:
     1924           undo move_block, retry move_block.
     1925         end.
     1926         assign
     1927           frame d-db :width = frame d-db :width + p-change-value
     1928         no-error .
     1929         if error-status :error
     1930         or error-status :get-message(1) <> ""
     1931         then do:
     1932           undo move_block, retry move_block.
     1933         end.
     1934         if frame d-db :scrollable = true
     1935         then do:
     1936           assign
     1937             frame d-db :virtual-width = frame d-db :virtual-width + p-change-value
     1938           no-error .
     1939           if error-status :error
     1940           or error-status :get-message(1) <> ""
     1941           then do:
     1942             undo move_block, retry move_block.
     1943           end.
     1944         end.
     1945       end.
     1946       if p-move-resize
     1947       then do:
     1948         run diasize_position-resize-button in this-procedure .
     1949       end.
     1950       if v-diasize-wndstore = true
     1951       then do:
     1952         if connected("ub") = true
     1953         then do:
     1954           define variable v-cntxt-db-num        as integer   no-undo .
     1955           define variable v-cntxt-userid        as character no-undo .
     1956           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1957                                             , OUTPUT v-cntxt-userid
     1958                                             ) .
     1959           run gbl/wndsizew.p
     1960             (input  v-cntxt-db-num
     1961             ,input  v-cntxt-userid
     1962             ,input  v-diasize-proc-name
     1963             ,input  'width':u
     1964             ,input  string(frame d-db :width - v-diasize-orig-frame-width)
     1965             ) .
     1966         end.
     1967       end.
     1968     end.
     1969     assign
     1970       v-diasize-change-size = false
     1971     .
     1972   end procedure.
     1973   procedure diasize_set-width :
     1974     define input  parameter p-new-width  as decimal   no-undo .
     1975     define input  parameter p-move-resize as logical   no-undo .
     1976     do
     1977     on error undo, return error return-value
     1978     :
     1979       run diasize_change-width in this-procedure
     1980         (input  (p-new-width - frame d-db :width)
     1981         ,input  p-move-resize
     1982         ) .
     1983     end.
     1984   end procedure.
     1985   procedure diasize_position-resize-button :
     1986     do with frame d-db
     1987     :
     1988       hide v-diasize-resize-button .
     1989       assign
     1990         v-diasize-resize-button :row = frame d-db :height - v-diasize-resize-button :height
     1991                     - 1
     1992                     - (frame d-db :border-bottom-pixels / session :pixels-per-row)
     1993         v-diasize-resize-button :col = frame d-db :width - v-diasize-resize-button :width
     1994                     - 1
     1995                     - (frame d-db :border-right-pixels / session :pixels-per-column)
     1996       .
     1997       view v-diasize-resize-button .
     1998     end.
     1999   end procedure.
     2000   on alt-right anywhere
     2001   do:
     2002     run diasize_change-width in this-procedure
     2003       (input 1
     2004       ,input true
     2005       ) .
     2006     return no-apply .
     2007   end.
     2008   on alt-left anywhere
     2009   do:
     2010     run diasize_change-width in this-procedure
     2011       (input -1
     2012       ,input true
     2013       ) .
     2014     return no-apply .
     2015   end.
     2016   on alt-down anywhere
     2017   do:
     2018     run diasize_change-height in this-procedure
     2019       (input 1
     2020       ,input true
     2021       ) .
     2022     return no-apply .
     2023   end.
     2024   on alt-up anywhere
     2025   do:
     2026     run diasize_change-height in this-procedure
     2027       (input -1
     2028       ,input true
     2029       ) .
     2030     return no-apply .
     2031   end.
     2032   on alt-enter of frame d-db
     2033   do:
     2034     run diasize_maximize in this-procedure
     2035       (input  ?
     2036       ).
     2037     return no-apply .
     2038   end.
     2039   procedure diasize_end-move :
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       define variable v-row-delta as decimal   no-undo .
     2044       define variable v-col-delta as decimal   no-undo .
     2045       define variable v-new-row as decimal   no-undo .
     2046       define variable v-new-col as decimal   no-undo .
     2047       assign
     2048         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2049         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2050       .
     2051       assign
     2052         v-row-delta = v-new-row - frame d-db :height
     2053         v-col-delta = v-new-col - frame d-db :width
     2054       .
     2055       run diasize_change-height in this-procedure
     2056         (input v-row-delta
     2057         ,input true
     2058         ) .
     2059       run diasize_change-width in this-procedure
     2060         (input v-col-delta
     2061         ,input true
     2062         ) .
     2063     end.
     2064   end procedure.
     2065   procedure diasize_maximize :
     2066     define input  parameter p-action as logical   no-undo .
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       if p-action = ?
     2071       then do:
     2072         if v-diasize-need-maximize = true
     2073         then do:
     2074           assign
     2075             p-action = true
     2076           .
     2077         end.
     2078         else do:
     2079           assign
     2080             p-action = false
     2081           .
     2082         end.
     2083       end.
     2084       if p-action = true
     2085       then do:
     2086         run diasize_change-height in this-procedure
     2087           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2088               - frame d-db :height-chars
     2089           ,input true
     2090           ) .
     2091         run diasize_change-width in this-procedure
     2092           (input session :width-chars
     2093               - frame d-db :width-chars
     2094           ,input true
     2095           ) .
     2096         assign
     2097           v-diasize-need-maximize = false
     2098         .
     2099       end.
     2100       else do:
     2101         run diasize_change-width in this-procedure
     2102           (input v-diasize-orig-frame-width
     2103               - frame d-db :width-chars
     2104           ,input true
     2105           ) .
     2106         run diasize_change-height in this-procedure
     2107           (input v-diasize-orig-frame-height
     2108               - frame d-db :height-chars
     2109           ,input true
     2110           ) .
     2111         assign
     2112           v-diasize-need-maximize = true
     2113         .
     2114       end.
     2115     end.
     2116   end procedure.
     2117   procedure diasize_restore-orig-size :
     2118     do
     2119     on error undo, return error return-value
     2120     :
     2121       assign
     2122         v-diasize-current-frame-width  = frame d-db :width
     2123         v-diasize-current-frame-height = frame d-db :height
     2124       .
     2125       run diasize_set-height in this-procedure
     2126         (input  v-diasize-orig-frame-height
     2127         ,input  true
     2128         ) .
     2129       run diasize_set-width in this-procedure
     2130         (input  v-diasize-orig-frame-width
     2131         ,input  true
     2132         ) .
     2133     end.
     2134   end procedure.
     2135   procedure diasize_restore-current-size :
     2136     do
     2137     on error undo, return error return-value
     2138     :
     2139       run diasize_set-height in this-procedure
     2140         (input  v-diasize-current-frame-height
     2141         ,input  true
     2142         ) .
     2143       run diasize_set-width in this-procedure
     2144         (input  v-diasize-current-frame-width
     2145         ,input  true
     2146         ) .
     2147     end.
     2148   end procedure.
     2149   procedure diasize_set-browse-handle :
     2150     define input  parameter p-browse-handle as handle   no-undo .
     2151     define buffer buf_temp-browse-handle for temp-browse-handle .
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155       assign
     2156         v-diasize-browse-handle = p-browse-handle
     2157       .
     2158       for each buf_temp-browse-handle
     2159       on error undo, return error return-value
     2160       :
     2161         delete buf_temp-browse-handle .
     2162       end.
     2163     end.
     2164   end procedure.
     2165   procedure diasize_add_browse :
     2166     define input  parameter p-browse-type   as character no-undo .
     2167     define input  parameter p-browse-handle as handle    no-undo .
     2168     define buffer buf_temp-browse-handle for temp-browse-handle .
     2169     do
     2170     on error undo, return error return-value
     2171     :
     2172       assign
     2173         v-diasize-browse-number = v-diasize-browse-number + 1
     2174       .
     2175       create buf_temp-browse-handle .
     2176       assign
     2177         buf_temp-browse-handle.browse-type   = p-browse-type
     2178         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2179         buf_temp-browse-handle.browse-handle = p-browse-handle
     2180       .
     2181     end.
     2182   end procedure.
     2183   procedure diasize_init :
     2184     define variable v-default-value    as logical   no-undo .
     2185     define variable v-restore-saved    as logical   no-undo .
     2186     define variable v-resize-value-str as character no-undo .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190       do with frame d-db
     2191       :
     2192         assign
     2193           v-diasize-orig-frame-height = frame d-db :height
     2194           v-diasize-orig-frame-width  = frame d-db :width
     2195           v-diasize-browse-handle     = browse br-curr-db :handle
     2196         .
     2197         create button v-diasize-resize-button
     2198         assign
     2199           parent        = frame d-db :first-child
     2200           label         = "s"
     2201           height-pixels = 16
     2202           width-pixels  = 16
     2203           visible       = true
     2204           sensitive     = true
     2205           movable       = true
     2206           triggers:
     2207             on end-move persistent run diasize_end-move in this-procedure .
     2208           end triggers.
     2209         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2210         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2211         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2212         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2213         assign
     2214           v-diasize-wndmax = false
     2215         .
     2216         if connected("ub") = true
     2217         then do:
     2218           define variable v-cntxt-db-num        as integer   no-undo .
     2219           define variable v-cntxt-userid        as character no-undo .
     2220           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2221                                             , OUTPUT v-cntxt-userid
     2222                                             ) .
     2223           run gbl/wndpar_r.p
     2224             (input  v-cntxt-db-num
     2225             ,input  v-cntxt-userid
     2226             ,input  'wndmax':U
     2227             ,output v-diasize-wndmax
     2228             ,output v-default-value
     2229             ) .
     2230         end.
     2231         assign
     2232           v-diasize-wndstore = false
     2233         .
     2234         if connected("ub") = true
     2235         then do:
     2236           run gbl/wndpar_r.p
     2237             (input  v-cntxt-db-num
     2238             ,input  v-cntxt-userid
     2239             ,input  'wndstore':U
     2240             ,output v-diasize-wndstore
     2241             ,output v-default-value
     2242             ) .
     2243         end.
     2244         assign
     2245           v-diasize-proc-name = entry(1, program-name(2), '.')
     2246         .
     2247         if v-diasize-wndstore = true
     2248         then do:
     2249           assign
     2250             v-restore-saved = false
     2251           .
     2252           if connected("ub") = true
     2253           then do:
     2254             run gbl/wndsizer.p
     2255               (input  v-cntxt-db-num
     2256               ,input  v-cntxt-userid
     2257               ,input  v-diasize-proc-name
     2258               ,input  'height':u
     2259               ,output v-resize-value-str
     2260               ) .
     2261             if v-resize-value-str <> '':U
     2262             then do:
     2263               run diasize_change-height in this-procedure
     2264                 (input  integer(v-resize-value-str)
     2265                 ,input  true
     2266                 ) .
     2267               assign
     2268                 v-restore-saved = true
     2269               .
     2270             end.
     2271           end.
     2272           if connected("ub") = true
     2273           then do:
     2274             run gbl/wndsizer.p
     2275               (input  v-cntxt-db-num
     2276               ,input  v-cntxt-userid
     2277               ,input  v-diasize-proc-name
     2278               ,input  'width':u
     2279               ,output v-resize-value-str
     2280               ) .
     2281             if v-resize-value-str <> '':U
     2282             then do:
     2283               run diasize_change-width in this-procedure
     2284                 (input  integer(v-resize-value-str)
     2285                 ,input  true
     2286                 ) .
     2287               assign
     2288                 v-restore-saved = true
     2289               .
     2290             end.
     2291           end.
     2292           if v-restore-saved <> true
     2293           then do:
     2294             if v-diasize-wndmax = true
     2295             then do:
     2296               run diasize_maximize in this-procedure
     2297                 (input  true
     2298                 ) .
     2299             end.
     2300           end.
     2301         end.
     2302         else do:
     2303           if v-diasize-wndmax = true
     2304           then do:
     2305             run diasize_maximize in this-procedure
     2306               (input  true
     2307               ) .
     2308           end.
     2309         end.
     2310       end.
     2311     end.
     2312   end procedure.
     2313   procedure diasize_need-full-display :
     2314     define output parameter p-need-full-display as logical   no-undo .
     2315     do
     2316     on error undo, return error return-value
     2317     :
     2318       assign
     2319         p-need-full-display = v-diasize-need-full-display
     2320       .
     2321       assign
     2322         v-diasize-need-full-display = false
     2323       .
     2324     end.
     2325   end procedure.
     2326   procedure get-context :
     2327      define output parameter p-db-num as integer          no-undo.
     2328      define output parameter p-user-id as character        no-undo.
     2329      define variable v-login               as character    no-undo.
     2330      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2331      define buffer buf_user-login  for ub.user-login .
     2332      do
     2333      on error undo, return error
     2334      :
     2335            FIND FIRST buf_sys-ctrl no-lock.
     2336            ASSIGN
     2337               v-login = USERID("ub")
     2338               p-db-num = buf_sys-ctrl.db-num
     2339            .
     2340            FIND FIRST buf_user-login
     2341                 WHERE buf_user-login.db-num = p-db-num
     2342                   AND buf_user-login.user-login = v-login
     2343                 no-lock
     2344                 no-error
     2345                 .
     2346            IF AVAILABLE buf_user-login
     2347            THEN DO:
     2348               assign
     2349                  p-user-id = buf_user-login.user-id
     2350               .
     2351            END.
     2352      end.
     2353   end procedure.
     2354       run diasize_init in this-procedure .
     2355     session:data-entry-return = yes .
     2356     run fill-tt_key in this-procedure.
     2357     RUN enable_UI.
     2358     OPEN QUERY br-curr-db FOR EACH ub.db NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-last-key FOR EACH tt_key.
     2359     WAIT-FOR GO OF FRAME d-db.
     2360   END.
     2361   for each tt_key :
     2362     delete tt_key.
     2363   end.
     2364   RUN disable_UI.
     2365   session:data-entry-return = no .
     2366   PROCEDURE disable_UI :
     2367     HIDE FRAME d-db.
     2368   END PROCEDURE.
     2369   PROCEDURE enable_UI :
     2370     ENABLE b-quit b-exp b-help br-curr-db br-last-key
     2371         WITH FRAME d-db.
     2372     OPEN QUERY br-curr-db FOR EACH ub.db NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-last-key FOR EACH tt_key.
     2373   END PROCEDURE.
     2374   PROCEDURE fill-tt_key :
     2375     define buffer buf_rep for ub.rep .
     2376     define variable v-num-entries as integer no-undo .
     2377     define variable v-ind         as integer no-undo .
     2378     for each tt_key
     2379     on error undo, return error
     2380     :
     2381       delete tt_key.
     2382     end.
     2383     find first buf_rep
     2384       where buf_rep.rep-num = 1996011200
     2385       no-error
     2386     .
     2387     if available buf_rep then do:
     2388       assign
     2389         v-num-entries = num-entries( buf_rep.name1 )
     2390       .
     2391       do v-ind = 1 to v-num-entries
     2392       on error undo, return error
     2393       :
     2394         if trim( entry( v-ind, buf_rep.name1 ) ) <> "":U then do:
     2395           create tt_key.
     2396           assign
     2397             tt_key.num-pp = v-ind
     2398             tt_key.db-key = entry( v-ind, buf_rep.name1 )
     2399           .
     2400         end.
     2401       end.
     2402     end.
     2403   END PROCEDURE.
