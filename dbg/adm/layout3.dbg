        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: layout3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: adm/layout3.p $":U .
        9   define variable vss-description as character no-undo init "Удаление раскладки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   FUNCTION get-region RETURNS CHARACTER
       81     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
       82     define variable par-region as character no-undo.
       83     if parhost-code = 0 and
       84          parobj-type = "":U and
       85          parobj-code = 0 then do:
       86          par-region = "Глобально".
       87          return par-region.
       88       end.
       89       if parobj-type = 'орг':U then do:
       90          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
       91          return par-region.
       92       end.
       93       if parobj-type = 'регион':U
       94       then do:
       95          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
       96          return par-region.
       97       end.
       98       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
       99       return par-region.
      100   END FUNCTION.
      101   FUNCTION get-objregion RETURNS CHARACTER
      102     (  input parobj-type as character, input parobj-code as integer ) :
      103     define variable par-region as character no-undo.
      104     if  parobj-type = "":U and
      105         parobj-code = 0
      106     then do:
      107        par-region = "Глобально".
      108     end.
      109     else if parobj-type = 'орг':U
      110     then do:
      111        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      112     end.
      113     else if parobj-type = 'регион':U
      114     then do:
      115        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      116     end.
      117     else
      118        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      119     return par-region.
      120   END FUNCTION.
      121   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure cur-time :
      124      define output parameter p-today as date      no-undo .
      125      define output parameter p-time  as integer   no-undo .
      126     do
      127     on error undo, return error
      128     :
      129       define variable v-date1 as date      no-undo .
      130       define variable v-date2 as date      no-undo .
      131       define variable v-time  as integer   no-undo .
      132       assign
      133         v-date1 = today
      134         v-time  = time
      135         v-date2 = today
      136       .
      137       if v-date1 <> v-date2
      138       then do:
      139         assign
      140           v-date1 = today
      141           v-time  = v-time
      142         .
      143       end.
      144       assign
      145         p-today = v-date1
      146         p-time  = v-time
      147       .
      148     end.
      149   end.
      150   function cur-time-date returns character
      151   :
      152     return string(today, '99/99/9999':U) .
      153   end.
      154   function cur-time-mjd returns decimal
      155   :
      156     define variable v-date as date      no-undo .
      157     define variable v-time as integer   no-undo .
      158     run cur-time in this-procedure
      159       (output v-date
      160       ,output v-time
      161       ) .
      162     return integer(v-date) - 2400002 + (v-time / 86400) .
      163   end.
      164   function cur-time-get-ending-index returns integer
      165   (input p-number as integer
      166   )
      167   :
      168     if p-number < 0
      169     or p-number = ?
      170     then do:
      171       return 1 .
      172     end.
      173     define variable v-rest as integer   no-undo .
      174     assign
      175       p-number = p-number modulo 100
      176     .
      177     if p-number < 20
      178     then do:
      179       assign
      180         v-rest = p-number
      181       .
      182     end.
      183     else do:
      184       assign
      185         v-rest = p-number modulo 10
      186       .
      187     end.
      188     case v-rest :
      189       when 1
      190       then do:
      191         return 2 .
      192       end.
      193       when 2 or
      194       when 3 or
      195       when 4
      196       then do:
      197         return 3 .
      198       end.
      199       otherwise do:
      200         return 1 .
      201       end.
      202     end case .
      203   end.
      204   procedure cur-time-mjd-to-date :
      205      define input  parameter i-mjd-diff as decimal no-undo.
      206      define output parameter o-Date     as date    no-undo.
      207      define output parameter o-Time     as integer no-undo.
      208      define variable v-day-number as integer   no-undo .
      209      if    i-mjd-diff < 0
      210         or i-mjd-diff = ?
      211      then do:
      212         return "?" .
      213      end.
      214      assign
      215         v-day-number = truncate(i-mjd-diff,0).
      216         o-Date = date(v-day-number + 2400002).
      217         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219   end.
      220   function cur-time-mjd-to-string returns character
      221   (input p-mjd-diff as decimal
      222   )
      223   :
      224     define variable v-day-number as integer   no-undo .
      225     define variable v-seconds    as integer   no-undo .
      226     define variable v-hour       as integer   no-undo .
      227     define variable v-min        as integer   no-undo .
      228     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      229     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      230     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      231     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      232     if p-mjd-diff < 0
      233     or p-mjd-diff = ?
      234     then do:
      235       return "?" .
      236     end.
      237     assign
      238       v-day-number = integer(truncate(p-mjd-diff,0))
      239       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241     if v-seconds > 86400
      242     then do:
      243       assign
      244         v-seconds = 86400 - 1
      245       .
      246     end.
      247     if v-seconds < 0
      248     then do:
      249       assign
      250         v-seconds = 0
      251       .
      252     end.
      253     assign
      254       v-hour = truncate(v-seconds / 3600, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 3600
      258     .
      259     assign
      260       v-min = truncate(v-seconds / 60, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 60
      264     .
      265     return
      266         (if v-day-number <> 0
      267           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0
      271           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      272           else ""
      273         )
      274       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      275           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      276           else ""
      277         )
      278       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      279       .
      280   end.
      281   function cur-time-string returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-string-sec returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      300   end.
      301   function cur-time-custom  returns character
      302   (input p-prefix as character
      303   ,input p-date-format as character
      304   ,input p-delimiter as character
      305   ,input p-time-format as character
      306   ,input p-suffix as character
      307   )
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return
      316       p-prefix
      317       + string(v-date, p-date-format)
      318       + p-delimiter
      319       + string(v-time, p-time-format)
      320       + p-suffix
      321       .
      322   end.
      323   function cur-time-print  returns character
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      332   end.
      333   function cur-time-datetime returns datetime
      334   :
      335     define variable v-char as character no-undo .
      336     define variable v-datetime as datetime no-undo .
      337     v-char = cur-time-string().
      338     v-datetime = datetime(v-char).
      339     return  v-datetime.
      340   end.
      341   function cur-time-string-msec returns character
      342   :
      343     define variable v-date as datetime  no-undo .
      344     v-date = now.
      345     return string(v-date) .
      346   end.
      347   procedure layouth_create-layout_h :
      348   define input parameter p-mode as character no-undo .
      349   define input parameter p-layout-id as character no-undo .
      350   define parameter buffer buf_layout for ub.layout.
      351   define output parameter p-chip-num as integer no-undo .
      352   define variable v-chip-num as integer no-undo .
      353   DEFINE VARIABLE v-today as date no-undo .
      354   DEFINE VARIABLE v-time as integer no-undo .
      355   define buffer buf_c-layout for ub.c-layout.
      356   do
      357   on error undo, return error
      358   :
      359     run cur-time in this-procedure ( output v-today, output v-time).
      360     find last buf_c-layout no-lock where
      361               buf_c-layout.layout-id = p-layout-id
      362          and  buf_c-layout.corr-user-db-num = g#db-num
      363          use-index pi no-error.
      364     assign
      365     v-chip-num = (if available buf_c-layout
      366                   then buf_c-layout.chip-num + 1
      367                   else 0).
      368     create buf_c-layout.
      369     if available buf_layout
      370     and p-mode <> 'ДОБАВЛЕНИЕ':U
      371     then do:
      372       buffer-copy buf_layout
      373       to buf_c-layout.
      374     end.
      375     if not available buf_layout then do:
      376       assign
      377       buf_c-layout.layout-id = p-layout-id
      378       .
      379     end.
      380     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      381       assign
      382       buf_c-layout.layout-id = p-layout-id
      383       .
      384     end.
      385     assign
      386     buf_c-layout.subject = 'layout':U
      387     buf_c-layout.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
      388                            then integer('1':U)
      389                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
      390                                  then integer('2':U)
      391                                  else integer('99':U)
      392                                  )
      393                           )
      394     buf_c-layout.chip-num = v-chip-num
      395     buf_c-layout.corr-user-db-num = g#db-num
      396     buf_c-layout.corr-user-name = g#userid
      397     buf_c-layout.corr-date = v-today
      398     buf_c-layout.corr-time = v-time
      399     p-chip-num = v-chip-num
      400     .
      401   end.
      402   end procedure.
      403   procedure layouth_create-layout-elem-rule_h :
      404   define input parameter p-mode as character no-undo .
      405   define input parameter p-layout-id as character no-undo .
      406   define input parameter p-mode-id as character no-undo .
      407   define input parameter p-widget-id as character no-undo .
      408   define parameter buffer buf_layout-elem-rule for ub.layout-elem-rule.
      409   define input parameter p-chip-num as integer no-undo .
      410   DEFINE VARIABLE v-today as date no-undo .
      411   DEFINE VARIABLE v-time as integer no-undo .
      412   define buffer buf_c-layout-elem-rule for ub.c-layout-elem-rule.
      413   do
      414   on error undo, return error
      415   :
      416     run cur-time in this-procedure ( output v-today, output v-time).
      417     create buf_c-layout-elem-rule.
      418     if available buf_layout-elem-rule
      419     and p-mode <> 'ДОБАВЛЕНИЕ':U
      420     then do:
      421       buffer-copy buf_layout-elem-rule
      422       to buf_c-layout-elem-rule.
      423     end.
      424     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      425       assign
      426       buf_c-layout-elem-rule.layout-id = p-layout-id
      427       buf_c-layout-elem-rule.mode-id = p-mode-id
      428       buf_c-layout-elem-rule.widget-id = p-widget-id
      429       .
      430     end.
      431     assign
      432     buf_c-layout-elem-rule.subject = 'layout-elem-rule':U
      433     buf_c-layout-elem-rule.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
      434                            then integer('1':U)
      435                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
      436                                  then integer('2':U)
      437                                  else integer('99':U)
      438                                  )
      439                           )
      440     buf_c-layout-elem-rule.chip-num = p-chip-num
      441     buf_c-layout-elem-rule.corr-user-db-num = g#db-num
      442     buf_c-layout-elem-rule.corr-user-name = g#userid
      443     buf_c-layout-elem-rule.corr-date = v-today
      444     buf_c-layout-elem-rule.corr-time = v-time
      445     .
      446   end.
      447   end procedure.
      448   procedure layouth_create-rule-call-param_h :
      449   define input parameter p-mode as character no-undo .
      450   define input parameter p-call#-id as integer no-undo .
      451   define input parameter p-codex-id as integer no-undo .
      452   define input parameter p-ruleset-id as integer no-undo .
      453   define input parameter p-order-id as integer no-undo .
      454   define input parameter p-param-name as character no-undo .
      455   define input parameter p-index as integer no-undo .
      456   define input parameter p-call-id as character no-undo .
      457   define parameter buffer buf_rule-call-param for ub.rule-call-param.
      458   define input parameter p-chip-num as integer no-undo .
      459   DEFINE VARIABLE v-today as date no-undo .
      460   DEFINE VARIABLE v-time as integer no-undo .
      461   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
      462   do
      463   on error undo, return error
      464   :
      465     run cur-time in this-procedure ( output v-today, output v-time).
      466     create buf_c-rule-call-param.
      467     if available buf_rule-call-param
      468     and p-mode <> 'ДОБАВЛЕНИЕ':U
      469     then do:
      470       buffer-copy buf_rule-call-param
      471       to buf_c-rule-call-param.
      472     end.
      473     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      474       assign
      475       buf_c-rule-call-param.call#_id = p-call#-id
      476       buf_c-rule-call-param.codex_id = p-codex-id
      477       buf_c-rule-call-param.ruleset_id = p-ruleset-id
      478       buf_c-rule-call-param.order_id = p-order-id
      479       buf_c-rule-call-param.param-name = p-param-name
      480       buf_c-rule-call-param.p-index = p-index
      481       buf_c-rule-call-param.call_id = p-call-id
      482       .
      483     end.
      484     assign
      485     buf_c-rule-call-param.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
      486                                     then integer('1':U)
      487                                     else (if p-mode = 'удаление':U
      488                                           then integer('99':U)
      489                                           else integer('2':U)
      490                                           )
      491                                     )
      492     buf_c-rule-call-param.chip-num = p-chip-num
      493     buf_c-rule-call-param.corr-user-db-num = g#db-num
      494     buf_c-rule-call-param.corr-user-name = g#userid
      495     buf_c-rule-call-param.corr-date = v-today
      496     buf_c-rule-call-param.corr-time = v-time
      497     .
      498   end.
      499   end procedure.
      500   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      501   procedure layoutus_is-used :
      502   define input parameter p-layout-type as character no-undo .
      503   define input parameter p-layout-id as character no-undo .
      504   define output parameter p-is-used as logical no-undo .
      505   define output parameter p-mess as character no-undo .
      506   define variable v-upper-prop-code as character no-undo .
      507   define variable v-prop-code as character no-undo .
      508   define buffer buf_thbj-attr for ub.thbj-attr.
      509   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
      510   do
      511   on error undo, return error
      512   :
      513     p-is-used = yes.
      514     case p-layout-type:
      515       when 'th-pos-keyboard':U then do:
      516          assign
      517          v-upper-prop-code = 'ibs-th_devices':U
      518          v-prop-code = 'keyboard-layout-id':U
      519          .
      520       end.
      521       when 'th-pos-screen':U then do:
      522         assign
      523         v-upper-prop-code = 'ibs-th_interface':U
      524         v-prop-code = 'screen-layout-id':U
      525         .
      526       end.
      527     end.
      528     for each buf_thbj-attr no-lock where
      529             buf_thbj-attr.upper-prop-code = v-upper-prop-code
      530         and buf_thbj-attr.prop-code = v-prop-code:
      531       if buf_thbj-attr.property-value-character = p-layout-id then do:
      532         p-mess = substitute("Нельзя удалить раскладку &1 - она используется в параметрах для IBS POS TH &2"
      533                           , p-layout-id
      534                           , get-objregion(  input buf_thbj-attr.obj-type
      535                                            ,input buf_thbj-attr.obj-code)
      536                           ).
      537        return.
      538       end.
      539     end.
      540     case p-layout-type:
      541       when 'th-pos-keyboard':U then do:
      542          assign
      543          v-upper-prop-code = 'IBS-TH_devices':U
      544          v-prop-code = 'keyboard-layout-id':U
      545          .
      546       end.
      547       when 'th-pos-screen':U then do:
      548         assign
      549         v-upper-prop-code = 'IBS-TH_interface':U
      550         v-prop-code = 'screen-layout-id':U
      551         .
      552       end.
      553     end.
      554     for each buf_cash-desk-attr no-lock where
      555             buf_cash-desk-attr.upper-attr-code = v-upper-prop-code
      556         and buf_cash-desk-attr.attr-code = v-prop-code:
      557       if buf_cash-desk-attr.attr-value-character = p-layout-id then do:
      558         p-mess = substitute("Нельзя удалить раскладку &1 - она используется в параметрах для IBS POS TH &2 касса &3"
      559                           , p-layout-id
      560                           , get-objregion(  input 'маг':U
      561                                            ,input buf_cash-desk-attr.obj-code)
      562                           , buf_Cash-desk-attr.cash-num
      563                           ).
      564         return.
      565       end.
      566     end.
      567     p-is-used = no.
      568   end.
      569   end procedure.
      570   define variable v-mess as character no-undo .
      571   define variable v-chip-num as integer no-undo .
      572   define variable v-is-used as logical no-undo .
      573   define buffer buf_layout  for ub.layout.
      574   define buffer buf_layout-elem-rule  for ub.layout-elem-rule.
      575   define buffer buf_rule-call-param for ub.rule-call-param.
      576   define buffer buf_rule-by-call for ub.rule-by-call.
      577   main-block:
      578   do
      579   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      580   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      581   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      582   :
      583     find first buf_layout exclusive-lock where
      584             recid(buf_layout) = p-rec .
      585     if buf_layout.is-default = integer('1':U)
      586     or buf_layout.is-default = integer('-1':U)
      587     then do:
      588       if g#db-num > 0 then do:
      589        v-mess = substitute("Нельзя удалять ШАБЛОН раскладки и ОБЯЗАТЕЛЬНУЮ РАСКЛАДКУ в УБД"
      590                             , buf_layout.layout-id ).
      591         run err-mess in this-procedure ( input-output v-mess) .
      592         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      593       end.
      594     end.
      595     v-is-used = yes.
      596     run  layoutus_is-used in this-procedure (
      597                                               input buf_layout.layout-type
      598                                              ,input buf_layout.layout-id
      599                                              ,output v-is-used
      600                                              ,output v-mess) no-error .
      601     if error-status:error
      602     or v-is-used then do:
      603       run err-mess in this-procedure ( input-output v-mess) .
      604       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      605     end.
      606     run  layouth_create-layout_h  in this-procedure (
      607                                                     input 'удаление':U
      608                                                    ,input buf_layout.layout-id
      609                                                    ,buffer buf_layout
      610                                                    ,output v-chip-num).
      611     for each buf_layout-elem-rule where
      612             buf_layout-elem-rule.layout-id  = buf_layout.layout-id
      613     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      614     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      615     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      616     :
      617       for each buf_rule-call-param where
      618               buf_rule-call-param.call_id  = buf_layout-elem-rule.uniq-key-rec
      619       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      620       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      621       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      622       :
      623         run  layouth_create-rule-call-param_h  in this-procedure (
      624                                                         input 'удаление':U
      625                                                       ,input buf_rule-call-param.call#_id
      626                                                       ,input buf_rule-call-param.codex_id
      627                                                       ,input buf_rule-call-param.ruleset_id
      628                                                       ,input buf_rule-call-param.order_id
      629                                                       ,input buf_rule-call-param.param-name
      630                                                       ,input buf_rule-call-param.p-index
      631                                                       ,input buf_rule-call-param.call_id
      632                                                       ,buffer buf_rule-call-param
      633                                                       ,input v-chip-num).
      634         delete buf_rule-call-param.
      635       end.
      636       for each buf_rule-by-call where
      637               buf_rule-by-call.call_id  = buf_layout-elem-rule.uniq-key-rec
      638       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      639       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      640       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      641       :
      642         delete buf_rule-by-call.
      643       end.
      644       run  layouth_create-layout-elem-rule_h  in this-procedure (
      645                                                       input 'удаление':U
      646                                                     ,input buf_layout-elem-rule.layout-id
      647                                                     ,input buf_layout-elem-rule.mode-id
      648                                                     ,input buf_layout-elem-rule.widget-id
      649                                                     ,buffer buf_layout-elem-rule
      650                                                     ,input v-chip-num).
      651       delete buf_layout-elem-rule.
      652     end.
      653     delete buf_layout no-error.
      654     if error-status:error then do:
      655       v-mess = substitute("Ошибка при удалении: &1&2&3"
      656                            , error-status:get-message(1)
      657                            , chr(10)
      658                            , return-value ).
      659      run err-mess in this-procedure ( input-output v-mess) .
      660      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      661     end.
      662   end.
      663   PROCEDURE err-mess:
      664     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      665     CASE p-silent:
      666       when yes then do:
      667         assign
      668         p-mess = substitute("Раскладка &1: &2"
      669                            , buf_layout.layout-id
      670                            , p-mess)
      671         .
      672       end.
      673       when no then do:
      674         message
      675         p-mess
      676         view-as alert-box error .
      677       end.
      678     end.
      679   END PROCEDURE.
