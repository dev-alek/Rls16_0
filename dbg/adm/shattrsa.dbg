      436   define buffer buf_sel-client for ub.clients.
      437   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      438   define variable v-tth as handle no-undo .
      439   v-tth = buffer temp-thbj-attr:table-handle.
      440   DEFINE BUTTON B-exit AUTO-GO
      441        LABEL "&Ввод"
      442        SIZE 10 BY 1
      443        BGCOLOR 8 .
      444   DEFINE BUTTON b-quit AUTO-END-KEY
      445        LABEL "&Отмена"
      446        SIZE 10 BY 1
      447        BGCOLOR 8 .
      448   DEFINE BUTTON b-sel-cli
      449        IMAGE-UP FILE "btn-down-arrow":U
      450        IMAGE-DOWN FILE "btn-down-arrow":U
      451        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      452        LABEL ""
      453        SIZE 3 BY 1 TOOLTIP "Выбор из списка объектов".
      454   DEFINE VARIABLE fi-cli-adr AS CHARACTER FORMAT "X(256)":U
      455        LABEL "Адрес сервера авторизации"
      456        VIEW-AS FILL-IN
      457        SIZE 37 BY 1 NO-UNDO.
      458   DEFINE VARIABLE fi-cli-text AS CHARACTER FORMAT "X(20)":U
      459        LABEL "Код контрагента РКО обязательного к авторизации"
      460        VIEW-AS FILL-IN
      461        SIZE 12.4 BY 1 NO-UNDO.
      462   DEFINE FRAME Dialog-Frame
      463        B-exit AT ROW 1 COL 1 WIDGET-ID 10
      464        b-quit AT ROW 1 COL 11 WIDGET-ID 12
      465        fi-cli-text AT ROW 2.19 COL 1.6 WIDGET-ID 2
      466        b-sel-cli AT ROW 2.19 COL 63 WIDGET-ID 6
      467        fi-cli-adr AT ROW 3.38 COL 1.6 WIDGET-ID 8
      468        SPACE(0.40) SKIP(0.37)
      469       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      470            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      471            TITLE "Сервер авторизации АСУ" WIDGET-ID 100.
      472   ASSIGN
      473          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      474          FRAME Dialog-Frame:HIDDEN           = TRUE.
      475   ASSIGN
      476          fi-cli-text:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      477   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      478   DO:
      479     APPLY "END-ERROR":U TO SELF.
      480   END.
      481   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      482   DO:
      483   END.
      484   ON CHOOSE OF b-sel-cli IN FRAME Dialog-Frame
      485   DO:
      486       define variable v-cli-type as character no-undo.
      487       define variable v-cli-code as integer no-undo.
      488       run str/clisel.p(parparentproc, input-output v-cli-type, input-output v-cli-code) no-error.
      489       if error-status:error then
      490           return no-apply.
      491       find first buf_sel-client no-lock
      492           where buf_sel-client.obj-type = v-cli-type
      493           and buf_sel-client.obj-code = v-cli-code.
      494       fi-cli-text = subst("&1 &2", v-cli-type, v-cli-code).
      495       display fi-cli-text with frame Dialog-Frame.
      496   END.
      497   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      498   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      499   MAIN-BLOCK:
      500   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      501      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      502     RUN enable_UI.
      503     run my-enable.
      504     run proc-load.
      505     WAIT-FOR GO OF FRAME Dialog-Frame.
      506     run proc-save.
      507   END.
      508   RUN disable_UI.
      509   PROCEDURE disable_UI :
      510     HIDE FRAME Dialog-Frame.
      511   END PROCEDURE.
      512   PROCEDURE enable_UI :
      513     DISPLAY fi-cli-text fi-cli-adr
      514         WITH FRAME Dialog-Frame.
      515     ENABLE B-exit b-quit fi-cli-text
      516         WITH FRAME Dialog-Frame.
      517     VIEW FRAME Dialog-Frame.
      518   END PROCEDURE.
      519   PROCEDURE my-enable :
      520       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      521           enable fi-cli-adr b-sel-cli with frame Dialog-Frame.
      522       end.
      523       else do:
      524           hide B-exit in frame Dialog-Frame.
      525       end.
      526   end procedure.
      527   PROCEDURE proc-load :
      528       define variable v-value-character as character no-undo .
      529       define variable v-value-date as date no-undo .
      530       define variable v-value-decimal as decimal no-undo .
      531       define variable v-value-integer as INTEGER no-undo .
      532       define variable v-value-logical AS LOGICAL no-undo .
      533       define variable v-param-type as character no-undo .
      534       define variable v-param-value as character no-undo .
      535       for each temp-thbj-attr:
      536           delete temp-thbj-attr.
      537       end.
      538       run adm/shattri.p (
      539                     input "init":U
      540                   , input p-obj-type
      541                   , input p-obj-code
      542                   , input 'srv-auth-ASU':U
      543                   , input "":U
      544                   , output v-value-character
      545                   , output v-value-date
      546                   , output v-value-decimal
      547                   , output v-value-integer
      548                   , output v-value-logical
      549                   , output v-param-type
      550                   , INPUT-OUTPUT TABLE-handle v-tth
      551                   ) no-error .
      552       if error-status:error then do:
      553           message "Не удалось прочитать настройки"
      554           view-as alert-box.
      555           undo, return error.
      556       end.
      557       for each temp-thbj-attr:
      558           if temp-thbj-attr.prop-code = 'pko-cli':U then do:
      559               find first buf_sel-client no-lock
      560                   where buf_sel-client.obj-type = entry(1, temp-thbj-attr.property-value-character)
      561                   and buf_sel-client.obj-code = int(entry(2, temp-thbj-attr.property-value-character))
      562                   no-error.
      563               if available buf_sel-client then do:
      564                   fi-cli-text = subst("&1 &2", buf_sel-client.obj-type, buf_sel-client.obj-code).
      565                   display fi-cli-text with frame Dialog-Frame.
      566               end.
      567           end.
      568           if temp-thbj-attr.prop-code = 'srv-auth-adr':U then do:
      569               fi-cli-adr = temp-thbj-attr.property-value-character.
      570               display fi-cli-adr with frame Dialog-Frame.
      571           end.
      572       end.
      573   end procedure.
      574   PROCEDURE proc-save :
      575       assign frame Dialog-Frame
      576           fi-cli-text
      577           fi-cli-adr
      578       .
      579       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'pko-cli':U.
      580       temp-thbj-attr.property-value-character = subst("&1,&2", buf_sel-client.obj-type, buf_sel-client.obj-code).
      581       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'srv-auth-adr':U.
      582       temp-thbj-attr.property-value-character = fi-cli-adr.
      583       do transaction:
      584           RUN thbjattr_set-section IN THIS-PROCEDURE (
      585                input p-obj-type
      586               ,input p-obj-code
      587               ,input 'srv-auth-ASU':U
      588               ,INPUT table temp-thbj-attr
      589           ) NO-ERROR.
      590           if error-status:error then do:
      591               message "Не удалось сохранить настройки"
      592               view-as alert-box.
      593               undo, return error.
      594           end.
      595       end.
      596   end procedure.
