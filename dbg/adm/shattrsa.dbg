      418     define variable v-cntxt-userid        as character no-undo .
      419     define variable v-cntxt-level         as character no-undo .
      420     define variable v-cntxt-host-code-obj as integer   no-undo .
      421     define variable v-cntxt-obj-type      as character no-undo .
      422     define variable v-cntxt-obj-code      as integer   no-undo .
      423     define variable v-cntxt-db-num-obj    as integer   no-undo .
      424     define variable v-cntxt-is-admin      as logical   no-undo .
