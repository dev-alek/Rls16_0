      426     run mainmenu_getcntxt in parparentproc
      427       (output v-cntxt-db-num
      428       ,output v-cntxt-userid
      429       ,output v-cntxt-level
      430       ,output v-cntxt-host-code-obj
      431       ,output v-cntxt-obj-type
      432       ,output v-cntxt-obj-code
      433       ,output v-cntxt-db-num-obj
