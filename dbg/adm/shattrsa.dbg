      371   procedure proc-alt-shift-f2:
      372     if not ibs.th.gbl.gbl-var:rcode
      373   then
      374     run gbl\inidebug.p .
      375   end.
      376   procedure proc-alt-shift-f3:
      377     run gbl/prvssinf.p
      378       ( input this-procedure
      379       ) .
      380   end.
      381   define variable v-inform-launched as logical no-undo initial false .
      382   procedure proc-alt-shift-f4:
      383     define variable v-action as character no-undo .
      384     if v-inform-launched = false then do:
      385       assign
      386         v-inform-launched = true
      387       .
      388       run gbl/d-inform.w
      389         (  input self
      390         ,  input this-procedure
      391         , output v-action
      392         ) no-error .
      393       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      394       assign
      395         v-inform-launched = false
      396       .
      397     end.
      398   end.
      399   procedure proc-alt-f1:
      400     run gbl/corrhelp.p
      401       (input this-procedure
      402       ) .
      403   end .
      404   on alt-shift-f2 anywhere do:
      405     run proc-alt-shift-f2.
      406   end.
      407   on alt-shift-f3 anywhere do:
      408     run proc-alt-shift-f3 in this-procedure .
      409   end.
      410   on alt-shift-f4 anywhere do:
      411     run proc-alt-shift-f4 in this-procedure.
      412   end.
      413   on alt-f1 anywhere do:
      414     run proc-alt-f1 in this-procedure .
      415   end.
      416   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
