      171   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure cur-time :
      173      define output parameter p-today as date      no-undo .
      174      define output parameter p-time  as integer   no-undo .
      175     do
      176     on error undo, return error
      177     :
      178       define variable v-date1 as date      no-undo .
      179       define variable v-date2 as date      no-undo .
      180       define variable v-time  as integer   no-undo .
      181       assign
      182         v-date1 = today
      183         v-time  = time
      184         v-date2 = today
      185       .
      186       if v-date1 <> v-date2
      187       then do:
      188         assign
      189           v-date1 = today
      190           v-time  = v-time
      191         .
      192       end.
      193       assign
      194         p-today = v-date1
      195         p-time  = v-time
      196       .
      197     end.
      198   end.
      199   function cur-time-date returns character
      200   :
      201     return string(today, '99/99/9999':U) .
      202   end.
      203   function cur-time-mjd returns decimal
      204   :
      205     define variable v-date as date      no-undo .
      206     define variable v-time as integer   no-undo .
      207     run cur-time in this-procedure
      208       (output v-date
      209       ,output v-time
      210       ) .
      211     return integer(v-date) - 2400002 + (v-time / 86400) .
      212   end.
      213   function cur-time-get-ending-index returns integer
      214   (input p-number as integer
      215   )
      216   :
      217     if p-number < 0
      218     or p-number = ?
      219     then do:
      220       return 1 .
      221     end.
      222     define variable v-rest as integer   no-undo .
      223     assign
      224       p-number = p-number modulo 100
      225     .
      226     if p-number < 20
      227     then do:
      228       assign
      229         v-rest = p-number
      230       .
      231     end.
      232     else do:
      233       assign
      234         v-rest = p-number modulo 10
      235       .
      236     end.
      237     case v-rest :
      238       when 1
      239       then do:
      240         return 2 .
      241       end.
      242       when 2 or
      243       when 3 or
      244       when 4
      245       then do:
      246         return 3 .
      247       end.
      248       otherwise do:
      249         return 1 .
      250       end.
      251     end case .
      252   end.
      253   procedure cur-time-mjd-to-date :
      254      define input  parameter i-mjd-diff as decimal no-undo.
      255      define output parameter o-Date     as date    no-undo.
      256      define output parameter o-Time     as integer no-undo.
      257      define variable v-day-number as integer   no-undo .
      258      if    i-mjd-diff < 0
      259         or i-mjd-diff = ?
      260      then do:
      261         return "?" .
      262      end.
      263      assign
      264         v-day-number = truncate(i-mjd-diff,0).
      265         o-Date = date(v-day-number + 2400002).
      266         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      267     .
      268   end.
      269   function cur-time-mjd-to-string returns character
      270   (input p-mjd-diff as decimal
      271   )
      272   :
      273     define variable v-day-number as integer   no-undo .
      274     define variable v-seconds    as integer   no-undo .
      275     define variable v-hour       as integer   no-undo .
      276     define variable v-min        as integer   no-undo .
      277     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      278     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      279     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      280     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      281     if p-mjd-diff < 0
      282     or p-mjd-diff = ?
      283     then do:
      284       return "?" .
      285     end.
      286     assign
      287       v-day-number = integer(truncate(p-mjd-diff,0))
      288       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      289     .
      290     if v-seconds > 86400
      291     then do:
      292       assign
      293         v-seconds = 86400 - 1
      294       .
      295     end.
      296     if v-seconds < 0
      297     then do:
      298       assign
      299         v-seconds = 0
      300       .
      301     end.
      302     assign
      303       v-hour = truncate(v-seconds / 3600, 0)
      304     .
      305     assign
      306       v-seconds = v-seconds modulo 3600
      307     .
      308     assign
      309       v-min = truncate(v-seconds / 60, 0)
      310     .
      311     assign
      312       v-seconds = v-seconds modulo 60
      313     .
      314     return
      315         (if v-day-number <> 0
      316           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      317           else ""
      318         )
      319       + (if v-day-number <> 0 or v-hour <> 0
      320           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      321           else ""
      322         )
      323       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      324           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      325           else ""
      326         )
      327       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      328       .
      329   end.
      330   function cur-time-string returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-string-sec returns character
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      349   end.
      350   function cur-time-custom  returns character
      351   (input p-prefix as character
      352   ,input p-date-format as character
      353   ,input p-delimiter as character
      354   ,input p-time-format as character
      355   ,input p-suffix as character
      356   )
      357   :
      358     define variable v-date as date      no-undo .
      359     define variable v-time as integer   no-undo .
      360     run cur-time in this-procedure
      361       (output v-date
      362       ,output v-time
      363       ) .
      364     return
      365       p-prefix
      366       + string(v-date, p-date-format)
      367       + p-delimiter
      368       + string(v-time, p-time-format)
      369       + p-suffix
      370       .
      371   end.
      372   function cur-time-print  returns character
      373   :
      374     define variable v-date as date      no-undo .
      375     define variable v-time as integer   no-undo .
      376     run cur-time in this-procedure
      377       (output v-date
      378       ,output v-time
      379       ) .
      380     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      381   end.
      382   function cur-time-datetime returns datetime
      383   :
      384     define variable v-char as character no-undo .
      385     define variable v-datetime as datetime no-undo .
      386     v-char = cur-time-string().
      387     v-datetime = datetime(v-char).
      388     return  v-datetime.
      389   end.
      390   function cur-time-string-msec returns character
      391   :
      392     define variable v-date as datetime  no-undo .
      393     v-date = now.
      394     return string(v-date) .
      395   end.
      396   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   procedure sys-time_get-sys :
      398     define output parameter p-year         as integer   no-undo .
      399     define output parameter p-month        as integer   no-undo .
      400     define output parameter p-day          as integer   no-undo .
      401     define output parameter p-hour         as integer   no-undo .
      402     define output parameter p-minute       as integer   no-undo .
      403     define output parameter p-second       as integer   no-undo .
      404     define output parameter p-milliseconds as integer   no-undo .
      405     define variable v-system-time-structure as memptr    no-undo.
      406     do
      407     on error undo, return error return-value
      408     :
      409       assign
      410         set-size(v-system-time-structure) = 16
      411       .
      412       run GetSystemTime
      413         (input  get-pointer-value(v-system-time-structure)
      414         ) .
      415       assign
      416         p-year         = get-short(v-system-time-structure,  1)
      417         p-month        = get-short(v-system-time-structure,  3)
      418         p-day          = get-short(v-system-time-structure,  7)
      419         p-hour         = get-short(v-system-time-structure,  9)
      420         p-minute       = get-short(v-system-time-structure, 11)
      421         p-second       = get-short(v-system-time-structure, 13)
      422         p-milliseconds = get-short(v-system-time-structure, 15)
      423       .
      424       assign
      425         set-size(v-system-time-structure) = 0
      426       .
      427     end.
      428   end procedure.
      429   procedure sys-time_get-comp-user-name :
      430     define output parameter p-computer-name as character no-undo .
      431     define output parameter p-user-name     as character no-undo .
      432     define output parameter p-process-pid   as integer   no-undo .
      433     define variable v-return-value  as integer   no-undo .
      434     define variable v-buffer-length as integer   no-undo .
      435     define variable v-buffer-memptr as memptr    no-undo .
      436     do
      437     on error undo, return error return-value
      438     :
      439       assign
      440         v-buffer-length = 1024
      441         set-size(v-buffer-memptr) = v-buffer-length + 4
      442       .
      443       assign
      444         put-long(v-buffer-memptr, 1) = v-buffer-length
      445       .
      446       run GetComputerNameA
      447         (input  get-pointer-value(v-buffer-memptr) + 4
      448         ,input  get-pointer-value(v-buffer-memptr)
      449         ,output v-return-value
      450         ) .
      451       if v-return-value <> 0
      452       then do:
      453         assign
      454           p-computer-name = get-string(v-buffer-memptr, 5)
      455         .
      456       end.
      457       assign
      458         put-long(v-buffer-memptr, 1) = v-buffer-length
      459       .
      460       run GetUserNameA
      461         (input  get-pointer-value(v-buffer-memptr) + 4
      462         ,input  get-pointer-value(v-buffer-memptr)
      463         ,output v-return-value
      464         ) .
      465       if v-return-value <> 0
      466       then do:
      467         assign
      468           p-user-name = get-string(v-buffer-memptr, 5)
      469         .
      470       end.
      471       run GetCurrentProcessId
      472         (output p-process-pid
      473         ) .
      474       assign
      475         set-size(v-buffer-memptr) = 0
      476       .
      477     end.
      478   end procedure.
      479   procedure sys-time_get-http :
      480     define output parameter p-http-time as character no-undo .
      481     define variable v-year         as integer   no-undo .
      482     define variable v-month        as integer   no-undo .
      483     define variable v-day-of-week  as integer   no-undo .
      484     define variable v-day          as integer   no-undo .
      485     define variable v-hour         as integer   no-undo .
      486     define variable v-minute       as integer   no-undo .
      487     define variable v-second       as integer   no-undo .
      488     define variable v-milliseconds as integer   no-undo .
      489     do
      490     on error undo, return error return-value
      491     :
      492       run sys-time_get-sys in this-procedure
      493         (output v-year
      494         ,output v-month
      495         ,output v-day
      496         ,output v-hour
      497         ,output v-minute
      498         ,output v-second
      499         ,output v-milliseconds
      500         ) .
      501       assign
      502         v-day-of-week = weekday(date(v-month, v-day, v-year))
      503         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      504                     + ', ':u
      505                     + string(v-day, '99':u)
      506                     + ' ':u
      507                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      508                     + ' ':u
      509                     + string(v-year, '9999':u)
      510                     + ' ':u
      511                     + string(v-hour, '99':u)
      512                     + ':':u
      513                     + string(v-minute, '99':u)
      514                     + ':':u
      515                     + string(v-second, '99':u)
      516                     + ' ':u
      517                     + 'GMT':u
      518       .
      519     end.
      520   end procedure.
      521   procedure sys-time_set-sys :
      522     define input  parameter p-year         as integer   no-undo .
      523     define input  parameter p-month        as integer   no-undo .
      524     define input  parameter p-day          as integer   no-undo .
      525     define input  parameter p-hour         as integer   no-undo .
      526     define input  parameter p-minute       as integer   no-undo .
      527     define input  parameter p-second       as integer   no-undo .
      528     define input  parameter p-milliseconds as integer   no-undo .
      529     define variable v-system-time-structure as memptr    no-undo.
      530     define variable v-return-value as integer   no-undo .
      531     define variable v-day-of-week  as integer   no-undo .
      532     do
      533     on error undo, return error return-value
      534     :
      535       assign
      536         v-day-of-week = weekday(date(p-month, p-day, p-year))
      537       .
      538       assign
      539         set-size(v-system-time-structure) = 16
      540       .
      541       assign
      542         put-short(v-system-time-structure,  1) = p-year
      543         put-short(v-system-time-structure,  3) = p-month
      544         put-short(v-system-time-structure,  5) = v-day-of-week
      545         put-short(v-system-time-structure,  7) = p-day
      546         put-short(v-system-time-structure,  9) = p-hour
      547         put-short(v-system-time-structure, 11) = p-minute
      548         put-short(v-system-time-structure, 13) = p-second
      549         put-short(v-system-time-structure, 15) = p-milliseconds
      550       .
      551       run SetSystemTime
      552         (input  get-pointer-value(v-system-time-structure)
      553         ,output v-return-value
      554         ) .
      555       assign
      556         set-size(v-system-time-structure) = 0
      557       .
      558       if v-return-value = 0
      559       then do:
      560         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      561       end.
      562     end.
      563   end procedure.
      564   procedure sys-time_sys-to-mjd :
      565     define input  parameter p-year         as integer   no-undo .
      566     define input  parameter p-month        as integer   no-undo .
      567     define input  parameter p-day          as integer   no-undo .
      568     define input  parameter p-hour         as integer   no-undo .
      569     define input  parameter p-minute       as integer   no-undo .
      570     define input  parameter p-second       as integer   no-undo .
      571     define input  parameter p-milliseconds as integer   no-undo .
      572     define output parameter p-mjd          as decimal   no-undo .
      573     define variable v-year-correction as decimal   no-undo .
      574     define variable v-shift-year as decimal   no-undo .
      575     do
      576     on error undo, return error return-value
      577     :
      578       assign
      579         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      580         v-shift-year      = decimal(p-year) + v-year-correction
      581         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      582               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      583               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      584               + decimal(p-day) - 2432076.0
      585               + p-hour / 24.0
      586               + p-minute / 1440.0
      587               + p-second / 86400.0
      588               + p-milliseconds / 86400000.0
      589       .
      590     end.
      591   end procedure.
      592   procedure sys-time_sys-to-loc :
      593     define input  parameter p-sys-year         as integer   no-undo .
      594     define input  parameter p-sys-month        as integer   no-undo .
      595     define input  parameter p-sys-day          as integer   no-undo .
      596     define input  parameter p-sys-hour         as integer   no-undo .
      597     define input  parameter p-sys-minute       as integer   no-undo .
      598     define input  parameter p-sys-second       as integer   no-undo .
      599     define input  parameter p-sys-milliseconds as integer   no-undo .
      600     define output parameter p-loc-year         as integer   no-undo .
      601     define output parameter p-loc-month        as integer   no-undo .
      602     define output parameter p-loc-day          as integer   no-undo .
      603     define output parameter p-loc-hour         as integer   no-undo .
      604     define output parameter p-loc-minute       as integer   no-undo .
      605     define output parameter p-loc-second       as integer   no-undo .
      606     define output parameter p-loc-milliseconds as integer   no-undo .
      607     define variable v-system-time-structure as memptr    no-undo.
      608     define variable v-return-value          as integer   no-undo .
      609     define variable v-sys-day-of-week       as integer   no-undo .
      610     do
      611     on error undo, return error return-value
      612     :
      613       assign
      614         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      615       .
      616       assign
      617         set-size(v-system-time-structure) = 32
      618       .
      619       assign
      620         put-short(v-system-time-structure,  1) = p-sys-year
      621         put-short(v-system-time-structure,  3) = p-sys-month
      622         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      623         put-short(v-system-time-structure,  7) = p-sys-day
      624         put-short(v-system-time-structure,  9) = p-sys-hour
      625         put-short(v-system-time-structure, 11) = p-sys-minute
      626         put-short(v-system-time-structure, 13) = p-sys-second
      627         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      628       .
      629       run SystemTimeToTzSpecificLocalTime
      630         (input  0
      631         ,input  get-pointer-value(v-system-time-structure)
      632         ,input  get-pointer-value(v-system-time-structure) + 16
      633         ,output v-return-value
      634         ) .
      635       assign
      636         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      637         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      638         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      639         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      640         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      641         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      642         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      643       .
      644       assign
      645         set-size(v-system-time-structure) = 0
      646       .
      647       if v-return-value = 0
      648       then do:
      649         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      650       end.
      651     end.
      652   end procedure.
      653   procedure sys-time_mjd-to-sys :
      654     define input  parameter p-mjd          as decimal   no-undo .
      655     define output parameter p-year         as integer   no-undo .
      656     define output parameter p-month        as integer   no-undo .
      657     define output parameter p-day          as integer   no-undo .
      658     define output parameter p-hour         as integer   no-undo .
      659     define output parameter p-minute       as integer   no-undo .
      660     define output parameter p-second       as integer   no-undo .
      661     define output parameter p-milliseconds as integer   no-undo .
      662     define variable v-year-correction as decimal   no-undo .
      663     define variable v-shift-year      as decimal   no-undo .
      664     define variable v-conv-date     as date      no-undo .
      665     define variable v-int-part      as integer   no-undo .
      666     define variable v-fraction-part as decimal   no-undo .
      667     do
      668     on error undo, return error return-value
      669     :
      670       assign
      671         v-int-part      = integer(truncate(p-mjd, 0))
      672         v-fraction-part = p-mjd - v-int-part
      673         v-conv-date     = date(11, 17, 1858) + v-int-part
      674         p-year          = year(v-conv-date)
      675         p-month         = month(v-conv-date)
      676         p-day           = day(v-conv-date)
      677         v-fraction-part = v-fraction-part * 24.0
      678         p-hour          = integer(truncate(v-fraction-part, 0))
      679         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      680         p-minute        = integer(truncate(v-fraction-part, 0))
      681         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      682         p-second        = integer(truncate(v-fraction-part, 0))
      683         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      684         p-milliseconds  = integer(v-fraction-part)
      685       .
      686     end.
      687   end procedure.
      688   procedure sys-time_mjd-to-loc :
      689     define input  parameter p-mjd              as decimal   no-undo .
      690     define output parameter p-loc-year         as integer   no-undo .
      691     define output parameter p-loc-month        as integer   no-undo .
      692     define output parameter p-loc-day          as integer   no-undo .
      693     define output parameter p-loc-hour         as integer   no-undo .
      694     define output parameter p-loc-minute       as integer   no-undo .
      695     define output parameter p-loc-second       as integer   no-undo .
      696     define output parameter p-loc-milliseconds as integer   no-undo .
      697     define variable v-sys-year         as integer   no-undo .
      698     define variable v-sys-month        as integer   no-undo .
      699     define variable v-sys-day          as integer   no-undo .
      700     define variable v-sys-hour         as integer   no-undo .
      701     define variable v-sys-minute       as integer   no-undo .
      702     define variable v-sys-second       as integer   no-undo .
      703     define variable v-sys-milliseconds as integer   no-undo .
      704     do
      705     on error undo, return error return-value
      706     :
      707       run sys-time_mjd-to-sys
      708         (input  p-mjd
      709         ,output v-sys-year
      710         ,output v-sys-month
      711         ,output v-sys-day
      712         ,output v-sys-hour
      713         ,output v-sys-minute
      714         ,output v-sys-second
      715         ,output v-sys-milliseconds
      716         ) .
      717       run sys-time_sys-to-loc
      718         (input  v-sys-year
      719         ,input  v-sys-month
      720         ,input  v-sys-day
      721         ,input  v-sys-hour
      722         ,input  v-sys-minute
      723         ,input  v-sys-second
      724         ,input  v-sys-milliseconds
      725         ,output p-loc-year
      726         ,output p-loc-month
      727         ,output p-loc-day
      728         ,output p-loc-hour
      729         ,output p-loc-minute
      730         ,output p-loc-second
      731         ,output p-loc-milliseconds
      732         ) .
      733     end.
      734   end procedure.
      735   function sys-time_get-mjd-func returns decimal
      736   :
      737     define variable v-year         as integer   no-undo .
      738     define variable v-month        as integer   no-undo .
      739     define variable v-day          as integer   no-undo .
      740     define variable v-hour         as integer   no-undo .
      741     define variable v-minute       as integer   no-undo .
      742     define variable v-second       as integer   no-undo .
      743     define variable v-milliseconds as integer   no-undo .
      744     define variable v-mjd          as decimal   no-undo .
      745     run sys-time_get-sys in this-procedure
      746       (output v-year
      747       ,output v-month
      748       ,output v-day
      749       ,output v-hour
      750       ,output v-minute
      751       ,output v-second
      752       ,output v-milliseconds
      753       ) .
      754     run sys-time_sys-to-mjd in this-procedure
      755       (input  v-year
      756       ,input  v-month
      757       ,input  v-day
      758       ,input  v-hour
      759       ,input  v-minute
      760       ,input  v-second
      761       ,input  v-milliseconds
      762       ,output v-mjd
      763       ) .
      764     return v-mjd .
      765   end function .
      766   function sys-time_get-sys-str-func returns character
      767   :
      768     define variable v-utc-time as character no-undo .
      769     define variable v-year         as integer   no-undo .
      770     define variable v-month        as integer   no-undo .
      771     define variable v-day          as integer   no-undo .
      772     define variable v-hour         as integer   no-undo .
      773     define variable v-minute       as integer   no-undo .
      774     define variable v-second       as integer   no-undo .
      775     define variable v-milliseconds as integer   no-undo .
      776     run sys-time_get-sys in this-procedure
      777       (output v-year
      778       ,output v-month
      779       ,output v-day
      780       ,output v-hour
      781       ,output v-minute
      782       ,output v-second
      783       ,output v-milliseconds
      784       ) .
      785     assign
      786       v-utc-time  = 'UTC ':u
      787                   + string(v-year,         '9999':u)
      788                   + '/':u
      789                   + string(v-month,        '99':u)
      790                   + '/':u
      791                   + string(v-day,          '99':u)
      792                   + ' ':u
      793                   + string(v-hour,         '99':u)
      794                   + ':':u
      795                   + string(v-minute,       '99':u)
      796                   + ':':u
      797                   + string(v-second,       '99':u)
      798                   + ' ':u
      799                   + string(v-milliseconds, '999':u)
      800     .
      801     return v-utc-time.
      802   end function .
      803   function sys-time_mjd-to-loc-str-func returns character
      804     (v-sys-mjd as decimal)
      805   :
      806     define variable v-loc-str          as character no-undo .
      807     define variable v-loc-year         as integer   no-undo .
      808     define variable v-loc-month        as integer   no-undo .
      809     define variable v-loc-day          as integer   no-undo .
      810     define variable v-loc-hour         as integer   no-undo .
      811     define variable v-loc-minute       as integer   no-undo .
      812     define variable v-loc-second       as integer   no-undo .
      813     define variable v-loc-milliseconds as integer   no-undo .
      814     run sys-time_mjd-to-loc in this-procedure
      815       (input  v-sys-mjd
      816       ,output v-loc-year
      817       ,output v-loc-month
      818       ,output v-loc-day
      819       ,output v-loc-hour
      820       ,output v-loc-minute
      821       ,output v-loc-second
      822       ,output v-loc-milliseconds
      823       ) .
      824     assign
      825       v-loc-str = substitute('&1/&2/&3 &4:&5'
      826                             ,string(v-loc-day,    '99':U)
      827                             ,string(v-loc-month,  '99':U)
      828                             ,string(v-loc-year,   '9999':U)
      829                             ,string(v-loc-hour,   '99':U)
      830                             ,string(v-loc-minute, '99':U)
      831                             )
      832     .
      833     return v-loc-str .
      834   end function .
