      872   function get-user-login returns character
      873     ( p-user-id as character ) :
      874     define variable v-user-login as character no-undo .
      875     run procedure-get-user-login in this-procedure (
      876         input p-user-id
      877       , output v-user-login
      878     ) .
      879     return v-user-login .
      880   end function.
      881   procedure procedure-get-user-login :
      882   define input  parameter p-user-id    as character no-undo .
      883   define output parameter p-user-login as character no-undo .
      884       define buffer buf_user-login for ub.user-login .
      885   do
      886   for buf_user-login
      887   on error undo, return error return-value
      888   :
      889       assign
      890           p-user-login = "":U
      891       .
      892       for each buf_user-login no-lock
      893          where buf_user-login.user-id = p-user-id
      894       by buf_user-login.db-num
      895       :
      896           assign
      897               p-user-login = substitute( "&1&2&3"
      898                                   , p-user-login
      899                                   , ( if p-user-login = "":U then "":U else ",":U )
      900                                   , buf_user-login.db-num )
      901           .
      902       end.
      903   end.
      904   end procedure.
      905   function get-work-status returns character
      906     ( p-user-id as character ) :
      907       define variable v-work-status as character no-undo .
      908       run procedure-get-work-status in this-procedure (
      909           input p-user-id
      910         , output v-work-status
      911       ) .
      912       return v-work-status .
      913   end function.
      914   procedure procedure-get-work-status :
      915   define input  parameter p-user-id     as character no-undo .
      916   define output parameter p-work-status as character no-undo .
      917       define buffer buf_user-login for ub.user-login .
      918   do
      919   for buf_user-login
      920   on error undo, return error return-value
      921   :
      922       if p-user-id = v-cntxt-userid
      923       then do:
      924           assign
      925               p-work-status = "*":U
      926           .
      927       end.
      928       else do:
      929           find first buf_user-login exclusive-lock
      930                where buf_user-login.db-num    = v-cntxt-db-num
      931                  and buf_user-login.user-id   = p-user-id
      932           no-error no-wait .
      933           if not available buf_user-login
      934           then do:
      935               if locked buf_user-login
      936               then do:
      937               assign
      938                   p-work-status = "+":U
      939               .
      940               end.
      941               else do:
      942               assign
      943                   p-work-status = "":U
      944               .
      945               end.
      946           end.
      947           else do:
      948               assign
      949                   p-work-status = "":U
      950               .
      951           end.
      952       end.
      953   end.
      954   end procedure.
      955   procedure SetAttrUserId:
      956      define input  parameter iDb-num      as integer   no-undo.
      957      define input  parameter iUserId      as character no-undo.
      958      define input  parameter iAttrCode    as character no-undo.
      959      define input  parameter iAttrValue   as character no-undo.
      960      define buffer user-login-attr  for ub.user-login-attr .
      961      find first user-login-attr where user-login-attr.db-num    eq idb-num
      962                                   and user-login-attr.user-id   eq iuserid
      963                                   and user-login-attr.attr-code eq iAttrCode
      964      exclusive-lock no-error.
      965      if     not available user-login-attr
      966         and iAttrValue ne ?
      967      then do:
      968         create user-login-attr.
      969         assign
      970            user-login-attr.db-num     = idb-num
      971            user-login-attr.user-id    = iuserid
      972            user-login-attr.attr-code  = iAttrCode
      973         .
      974      end.
      975      if iAttrValue eq ?
      976      then do:
      977         if available ub.user-login-attr
      978         then
      979            delete ub.user-login-attr.
      980      end.
      981      else
      982         user-login-attr.attr-value = iAttrValue.
      983   end procedure.
      984   function GetAttrUserId returns character (
      985      input iDb-num      as integer  ,
      986      input iUserId      as character,
      987      input iAttrCode    as character):
      988      define buffer user-login-attr  for ub.user-login-attr .
      989      find first user-login-attr where user-login-attr.db-num    eq idb-num
      990                                   and user-login-attr.user-id   eq iuserid
      991                                   and user-login-attr.attr-code eq iAttrCode
      992      no-lock no-error.
      993      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
      994   end function.
      995   procedure getAccountSetting :
      996      define input  parameter i-user-id  as character no-undo.
      997      define output parameter o-adm-Ubd  as logical no-undo init ?.
      998      define output parameter v-adm-GBD  as logical no-undo.
      999      define output parameter o-superAdm as logical no-undo.
     1000      define input-output parameter table for UserDbAdm .
     1001      define variable v-adm-Ubd-int as integer no-undo.
     1002      define buffer user-login for ub.user-login.
     1003      define buffer db         for ub.db.
     1004      define buffer user-account-attr for ub.user-account-attr.
     1005      find first user-login where user-login.db-num  eq 0
     1006                              and user-login.user-id eq i-user-id
     1007      no-lock no-error.
     1008      if available user-login
     1009      then
     1010         v-adm-gbd = user-login.user-administrator.
     1011      else
     1012         v-adm-gbd = ?.
     1013      for each userDbAdm:
     1014         delete userDbAdm.
     1015      end.
     1016      block-db:
     1017      for each db where db.db-num ne 0 no-lock:
     1018         if G#db-num ne 0
     1019            and G#db-num ne db.db-num
     1020         then
     1021            next block-db.
     1022         create UserDbAdm.
     1023         UserDbAdm.db-num = ub.db.db-num.
     1024         find first user-login where user-login.db-num  eq db.db-num
     1025                                 and user-login.user-id eq i-user-id
     1026         no-lock no-error.
     1027         if not available user-login
     1028         then
     1029            v-adm-Ubd-int = 2.
     1030         else if user-login.status_ eq 1
     1031         then do:
     1032            v-adm-Ubd-int = 2.
     1033             UserDbAdm.db-block = yes.
     1034             UserDbAdm.db-usr   = yes.
     1035         end.
     1036         else if user-login.user-administrator
     1037         then do:
     1038            UserDbAdm.db-adm = yes.
     1039            UserDbAdm.db-usr = yes.
     1040            if v-adm-Ubd-int eq 0
     1041            then
     1042               v-adm-Ubd-int = 1.
     1043            else if v-adm-Ubd-int eq 3
     1044            then do:
     1045               v-adm-Ubd-int = 2.
     1046            end.
     1047         end.
     1048         else do:
     1049            if available ub.user-login
     1050            then
     1051               UserDbAdm.db-usr = yes.
     1052            if v-adm-Ubd-int eq 0
     1053            then
     1054               v-adm-Ubd-int = 3.
     1055            else if v-adm-Ubd-int eq 1
     1056            then do:
     1057               v-adm-Ubd-int = 2.
     1058            end.
     1059         end.
     1060      end.
     1061      if  v-adm-Ubd-int eq 1
     1062      then
     1063         o-adm-Ubd = true.
     1064      else if v-adm-Ubd-int eq 3
     1065      then
     1066         o-adm-Ubd = false.
     1067      find first user-account-attr where user-account-attr.user-id  eq i-user-id
     1068                                     and user-account-attr.attr-code  eq "superADm"
     1069      no-lock no-error.
     1070      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
     1071   end.
     1072   function check_alphanumeric returns character (
     1073   input ipwd as character ,
     1074   input itype as character ):
     1075      define variable vCharEng as character no-undo
     1076      init "abcdefghijklmnopqrstuvwxyz".
     1077      define variable vCharRus as character no-undo
     1078      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
     1079      define variable vi as integer no-undo.
     1080      define variable vdigitFl as logical no-undo.
     1081      define variable vCharEngFl as logical no-undo.
     1082      define variable vCharRusFl as logical no-undo.
     1083      define variable vCharSpeFl as logical no-undo.
     1084      define variable vTextNew as character no-undo.
     1085      define variable vTextOld as character no-undo.
     1086      vTextNew = ipwd.
     1087      vTextOld = vTextNew.
     1088      do vi = 0 to 9:
     1089         vTextNew = replace(vTextNew,string (vi),"").
     1090      end.
     1091      if length(vTextOld) ne length(vTextNew)
     1092      then
     1093         vdigitFL = yes.
     1094      vTextOld = vTextNew.
     1095      do vi = 1 to length(vCharEng):
     1096         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
     1097      end.
     1098      if length(vTextOld) ne length(vTextNew)
     1099      then
     1100         vCharEngFl = yes.
     1101      vTextOld = vTextNew.
     1102      do vi = 1 to length(vCharRus):
     1103         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
     1104      end.
     1105      if length(vTextOld) ne length(vTextNew)
     1106      then
     1107         vCharEngFl = yes.
     1108      if length(vTextNew) > 0
     1109      then
     1110         vCharSpeFl = yes.
     1111      define variable vReturn as character no-undo.
     1112      assign
     1113         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
     1114         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
     1115         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
     1116         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
     1117         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
     1118      .
     1119      vReturn = substring (vReturn,3) no-error.
     1120      return vReturn.
     1121   end.
     1122   procedure SaveLastPWD:
     1123      define input  parameter iDb-num as integer   no-undo.
     1124      define input  parameter iUserId as character no-undo.
     1125      define input  parameter IPWD    as character no-undo.
     1126      define buffer user-login-attr  for ub.user-login-attr .
     1127      find first user-login-attr where user-login-attr.db-num    eq idb-num
     1128                                   and user-login-attr.user-id   eq iuserid
     1129                                   and user-login-attr.attr-code eq "LastPWD"
     1130      exclusive-lock no-error.
     1131      if not available user-login-attr
     1132      then do:
     1133         create user-login-attr.
     1134         assign
     1135            user-login-attr.db-num     = idb-num
     1136            user-login-attr.user-id    = iuserid
     1137            user-login-attr.attr-code  = "LastPWD"
     1138            user-login-attr.attr-value = ipwd
     1139         .
     1140      end.
     1141      else do:
     1142         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
     1143         if num-entries (user-login-attr.attr-value , chr(5)) > 50
     1144         then
     1145            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
     1146      end.
     1147   end procedure.
     1148   function  CheckLastPWD returns character  (
     1149      input  iDb-num    as integer  ,
     1150      input  iUserId    as character,
     1151      input  IPWD       as character,
     1152      input  Iadm       as logical ) :
     1153      define buffer user-login       for ub.user-login .
     1154      define buffer user-login-attr  for ub.user-login-attr .
     1155      define variable vError as character  no-undo.
     1156      define variable v-obyznumbukv as logical no-undo .
     1157      define variable v-minparol as integer no-undo .
     1158      define variable v-tth as handle no-undo .
     1159      define variable VadmSuff as character no-undo.
     1160      define variable v-param-type as character no-undo .
     1161      define variable v-value-character as character no-undo .
     1162      define variable v-value-date as date no-undo .
     1163      define variable v-value-decimal as decimal no-undo .
     1164      define variable v-value-integer as integer no-undo .
     1165      define variable v-value-logical as logical no-undo .
     1166      find first user-login where user-login.db-num    eq idb-num
     1167                              and user-login.user-id   eq iUserId
     1168      no-lock no-error.
     1169      if Iadm
     1170      then
     1171         VadmSuff = 'Adm':U.
     1172      run adm/shattri.p (
     1173           input "get":U
     1174           ,input  '':U
     1175           ,input  0
     1176           ,input  'staff':U
     1177           ,input  'minparol':U + VadmSuff
     1178           ,output v-value-character
     1179           ,output v-value-date
     1180           ,output v-value-decimal
     1181           ,output v-minparol
     1182           ,output v-value-logical
     1183           ,output v-param-type
     1184           ,input-output table-handle v-tth
     1185           )  .
     1186       if v-minparol <> 0  then do:
     1187          if length(ipwd) < v-minparol
     1188           then do:
     1189              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
     1190           end.
     1191       end.
     1192       run adm/shattri.p (
     1193           input "get":U
     1194           ,input  '':U
     1195           ,input  0
     1196           ,input  'staff':U
     1197           ,input  'obyznumbukv':U + VadmSuff
     1198           ,output v-value-character
     1199           ,output v-value-date
     1200           ,output v-value-decimal
     1201           ,output v-value-integer
     1202           ,output v-obyznumbukv
     1203           ,output v-param-type
     1204           ,input-output table-handle v-tth
     1205           )  .
     1206      if v-obyznumbukv = true
     1207      then do:
     1208         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1209         then do:
     1210            vError = vError + (if vError eq "" then "" else ", " )
     1211                   + "В пароле должны содержаться буквы и цифры".
     1212         end.
     1213      end.
     1214      define variable v-encode-value as character no-undo.
     1215      define variable v-Lastpaswd    as integer no-undo.
     1216      run adm/pswd-enc.p
     1217         (input  encode(ipwd)
     1218         ,output v-encode-value
     1219         ).
     1220      v-encode-value = encode(v-encode-value).
     1221      run adm/shattri.p (
     1222           input "get":U
     1223           ,input  '':U
     1224           ,input  0
     1225           ,input  'staff':U
     1226           ,input  'LastPaswd':U + VadmSuff
     1227           ,output v-value-character
     1228           ,output v-value-date
     1229           ,output v-value-decimal
     1230           ,output v-Lastpaswd
     1231           ,output v-value-logical
     1232           ,output v-param-type
     1233           ,input-output table-handle v-tth
     1234           )  .
     1235      if v-Lastpaswd ne 0
     1236      then do:
     1237         define variable vLastPwd as character no-undo.
     1238         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1239         if vLastPwd ne ?
     1240         then do:
     1241            define variable Vi as integer no-undo.
     1242            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1243            if     vi ne 0
     1244               and vi le v-Lastpaswd
     1245            then
     1246               vError = vError + (if vError eq "" then "" else ", " )
     1247                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1248         end.
     1249      end.
     1250      delete object v-tth.
     1251      return vError.
     1252   end function.
     1253   procedure availOneAdm:
     1254      define input-output parameter table for UserDbAdm.
     1255      define output parameter oAdm as logical no-undo.
     1256      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1257      oadm = available UserDbAdm.
     1258   end.
     1259   procedure update-user-login:
     1260      define input  parameter i-db-num     as integer          no-undo.
     1261      define input  parameter i-user-id    as character        no-undo.
     1262      define input  parameter i-user-login as character no-undo.
     1263      define input  parameter i-max-discnt as decimal no-undo.
     1264      define input  parameter i-quest-print as logical no-undo.
     1265      define input  parameter i-encoded-pass as character no-undo.
     1266      define input  parameter i-nextcon as logical no-undo.
     1267      define input  parameter i-user-administrator as logical no-undo.
     1268      define input  parameter i-Manual     as logical no-undo.
     1269      define input  parameter i-adm-gbd as logical no-undo.
     1270      define input  parameter i-adm-ubd as logical no-undo.
     1271      define input-output parameter table for UserDbAdm.
     1272      define buffer buf_user-login        for user-login.
     1273      do
     1274   for buf_user-login
     1275   on error undo, return error
     1276   :
     1277           if     i-Manual
     1278              and G#db-num eq 0
     1279           then do:
     1280              if     i-adm-gbd ne ?
     1281              then do:
     1282                 do transaction
     1283                 on error undo, return error return-value
     1284                 :
     1285                     find first buf_user-login where buf_user-login.db-num             eq 0
     1286                                                 and buf_user-login.user-login         eq i-user-login
     1287                                                 and buf_user-login.status_            eq 0
     1288                                                 and buf_user-login.user-id            ne i-user-id
     1289                     no-lock no-error.
     1290                     if available buf_user-login
     1291                     then
     1292                        undo, return error "Уже есть такой логин в ГБД".
     1293                     find first buf_user-login where buf_user-login.db-num             = 0
     1294                                                 and buf_user-login.user-id            = i-user-id
     1295                     exclusive-lock no-error.
     1296                     if not available buf_user-login
     1297                     then do:
     1298                        create buf_user-login .
     1299                        assign
     1300                            buf_user-login.db-num             = 0
     1301                            buf_user-login.user-id            = i-user-id
     1302                            buf_user-login.status_            = 0
     1303                        .
     1304                     end.
     1305                     assign
     1306                         buf_user-login.user-login         = i-user-login
     1307                         buf_user-login.user-administrator = i-adm-gbd
     1308                         buf_user-login.max-discnt         = i-max-discnt
     1309                         buf_user-login.quest-print        = i-quest-print
     1310                         buf_user-login.user-password-encoded = i-encoded-pass
     1311                     .
     1312                     if i-nextcon ne ?
     1313                     then do:
     1314                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1315                     end.
     1316                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1317                     if error-status:error
     1318                     then
     1319                        return error return-value.
     1320                 end.
     1321              end.
     1322              else do transaction on error undo, return error return-value:
     1323                  find first buf_user-login where buf_user-login.db-num             = 0
     1324                                              and buf_user-login.user-id            = i-user-id
     1325                  exclusive-lock no-error.
     1326                  if available buf_user-login
     1327                  then
     1328                     delete buf_user-login.
     1329              end.
     1330              if     i-adm-ubd ne ?
     1331              then do:
     1332                 do transaction
     1333                 on error undo, return error return-value
     1334                 :
     1335                     define variable vDbError as character no-undo.
     1336                     block-db:
     1337                     for each db where db.db-num ne 0
     1338                     no-lock:
     1339                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1340                                                    and buf_user-login.user-login         eq i-user-login
     1341                                                    and buf_user-login.status_            eq 0
     1342                                                    and buf_user-login.user-id            ne i-user-id
     1343                        no-lock no-error.
     1344                        if available buf_user-login
     1345                        then do:
     1346                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1347                           next block-db.
     1348                        end.
     1349                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1350                                                    and buf_user-login.user-id            = i-user-id
     1351                        exclusive-lock no-error.
     1352                        if not available buf_user-login
     1353                        then do:
     1354                           create buf_user-login .
     1355                           assign
     1356                               buf_user-login.db-num             = db.db-num
     1357                               buf_user-login.user-id            = i-user-id
     1358                               buf_user-login.status_            = 0
     1359                               buf_user-login.user-password-encoded = i-encoded-pass
     1360                           .
     1361                        end.
     1362                        assign
     1363                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1364                            buf_user-login.user-login         = i-user-login
     1365                            buf_user-login.user-administrator = i-adm-ubd
     1366                            buf_user-login.max-discnt         = i-max-discnt
     1367                            buf_user-login.quest-print        = i-quest-print
     1368                        .
     1369                        if i-nextcon ne ?
     1370                        then do:
     1371                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1372                        end.
     1373                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1374                        if error-status:error
     1375                        then
     1376                           return error return-value.
     1377                    end.
     1378                    if vDbError ne ""
     1379                    then
     1380                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1381                 end.
     1382              end.
     1383              else do:
     1384                 do transaction
     1385                 on error undo, return error return-value
     1386                 :
     1387                     block-UserDb:
     1388                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1389                     no-lock:
     1390                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1391                                                    and buf_user-login.user-login         eq i-user-login
     1392                                                    and buf_user-login.status_            eq 0
     1393                                                    and buf_user-login.user-id            ne i-user-id
     1394                        no-lock no-error.
     1395                        if available buf_user-login and UserDbAdm.db-usr
     1396                        then do:
     1397                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1398                           next block-UserDb.
     1399                        end.
     1400                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1401                                                    and buf_user-login.user-id            = i-user-id
     1402                        exclusive-lock no-error.
     1403                        if UserDbAdm.db-usr
     1404                        then do:
     1405                           if not available buf_user-login
     1406                           then do:
     1407                              create buf_user-login .
     1408                              assign
     1409                                  buf_user-login.db-num             = UserDbAdm.db-num
     1410                                  buf_user-login.user-id            = i-user-id
     1411                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1412                                  buf_user-login.user-password-encoded = i-encoded-pass
     1413                              .
     1414                           end.
     1415                           assign
     1416                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1417                               buf_user-login.user-login         = i-user-login
     1418                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1419                               buf_user-login.max-discnt         = i-max-discnt
     1420                               buf_user-login.quest-print        = i-quest-print
     1421                           .
     1422                           if i-nextcon ne ?
     1423                           then do:
     1424                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1425                           end.
     1426                           if UserDbAdm.db-adm
     1427                           then do:
     1428                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1429                              if error-status:error
     1430                              then
     1431                                 undo, return error return-value.
     1432                           end.
     1433                       end.
     1434                       else do:
     1435                          if available buf_user-login
     1436                          then do:
     1437                             define variable vok as logical no-undo.
     1438                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1439                             if not vok
     1440                             then
     1441                                undo, return error return-value.
     1442                          end.
     1443                       end.
     1444                    end.
     1445                     if vDbError ne ""
     1446                     then
     1447                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1448                 end.
     1449              end.
     1450           end.
     1451           else do transaction
     1452           on error undo, return error return-value
     1453           :
     1454              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1455                                          and buf_user-login.user-id            = i-user-id
     1456              exclusive-lock no-error.
     1457              if not available buf_user-login
     1458              then do:
     1459                 create buf_user-login .
     1460                 assign
     1461                    buf_user-login.db-num             = i-db-num
     1462                    buf_user-login.user-id            = i-user-id
     1463                    buf_user-login.status_            = 0
     1464                 .
     1465              end.
     1466              assign
     1467                   buf_user-login.user-login         = i-user-login
     1468                   buf_user-login.user-administrator = i-user-administrator
     1469                   buf_user-login.max-discnt         = i-max-discnt
     1470                   buf_user-login.quest-print        = i-quest-print
     1471                   buf_user-login.user-password-encoded = i-encoded-pass
     1472               .
     1473               if i-user-administrator
     1474               then
     1475                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1476               if i-nextcon ne ?
     1477               then do:
     1478                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1479               end.
     1480           end.
     1481       end.
     1482   end procedure.
     1483   procedure addobj:
     1484      define input  parameter i-db-num as integer no-undo.
     1485      define input  parameter i-user-id as character no-undo.
     1486      define buffer buf_user-obj     for ub.user-obj.
     1487      define buffer buf_clients      for ub.clients.
     1488      if i-db-num <> 0 then do:
     1489          for each buf_clients
     1490              where buf_clients.db-num = i-db-num
     1491              and ( buf_clients.obj-type = 'маг':U
     1492                 or buf_clients.obj-type = 'скл':U
     1493                  )
     1494              no-lock:
     1495             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1496                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1497                                     and buf_user-obj.user-id      = i-user-id
     1498                                     and buf_user-obj.db-num       = i-db-num
     1499                                   no-lock)
     1500                                   then next.
     1501             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1502          end.
     1503       end.
     1504       else do:
     1505          for each buf_clients
     1506              where
     1507                  ( buf_clients.obj-type = 'маг':U
     1508                 or buf_clients.obj-type = 'скл':U
     1509                  )
     1510              no-lock:
     1511             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1512                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1513                                     and buf_user-obj.user-id      = i-user-id
     1514                                     and buf_user-obj.db-num       = i-db-num
     1515                                   no-lock)
     1516                                   then next.
     1517             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1518          end.
     1519       end.
     1520   end.
     1521   procedure enbl-obj :
     1522      define input  parameter i-db-num  as integer   no-undo.
     1523      define input  parameter i-user-id as character no-undo.
     1524      define input  parameter i-type    as character no-undo.
     1525      define input  parameter i-code    as integer   no-undo.
     1526       define variable v-host-code    as integer      no-undo.
     1527       define variable v-host-name    as character    no-undo.
     1528       define variable v-base-code    as integer      no-undo.
     1529       define buffer buf_user-obj      for ub.user-obj.
     1530       define buffer buf_user-host     for ub.user-host.
     1531       define buffer buf_clients       for ub.clients.
     1532   do
     1533   for buf_user-obj
     1534     , buf_user-host
     1535     , buf_clients
     1536   on error undo, return error
     1537   :
     1538       find first buf_user-obj exclusive-lock
     1539            where buf_user-obj.db-num    = i-db-num
     1540              and buf_user-obj.user-id   = i-user-id
     1541              and buf_user-obj.obj-type  = i-type
     1542              and buf_user-obj.obj-code  = i-code
     1543       no-error.
     1544       if not available buf_user-obj
     1545       then do:
     1546           find first buf_clients no-lock
     1547                where buf_clients.obj-type = i-type
     1548                  and buf_clients.obj-code = i-code
     1549           .
     1550   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1551   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1552     (input  i-type
     1553     ,input  i-code
     1554     ,output v-host-code
     1555     ,output v-host-name
     1556     )  .
     1557   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1559     (input  v-host-code
     1560     ,output v-base-code
     1561     )  .
     1562           create buf_user-obj.
     1563           assign
     1564               buf_user-obj.db-num    = i-db-num
     1565               buf_user-obj.user-id   = i-user-id
     1566               buf_user-obj.obj-type  = i-type
     1567               buf_user-obj.obj-code  = i-code
     1568               buf_user-obj.host-code = v-host-code
     1569           .
     1570           find first buf_user-host exclusive-lock
     1571                where buf_user-host.db-num    = i-db-num
     1572                  and buf_user-host.user-id   = i-user-id
     1573                  and buf_user-host.host-code = v-host-code
     1574           no-error.
     1575           if not available buf_user-host
     1576           then do:
     1577               create buf_user-host.
     1578               assign
     1579                   buf_user-host.db-num    = i-db-num
     1580                   buf_user-host.user-id   = i-user-id
     1581                   buf_user-host.host-code = v-host-code
     1582               .
     1583           end.
     1584      end.
     1585   end.
     1586   end procedure.
     1587   procedure can-edit-login :
     1588     define input  parameter p-db-num   as integer   no-undo .
     1589     define output parameter p-can-edit as logical   no-undo .
     1590     define buffer buf_db for ub.db .
     1591     do
     1592     on error undo, return error return-value
     1593     :
     1594       find first buf_db no-lock
     1595            where buf_db.db-num = p-db-num
     1596       no-error.
     1597       if not available buf_db
     1598       then do:
     1599         message
     1600           vss-workfile vss-revision vss-description
     1601           skip "Внутренняя ошибка"
     1602           skip "Неизвестный номер БД" p-db-num
     1603           skip view-as alert-box error .
     1604         undo, return error return-value .
     1605       end.
     1606       assign
     1607         p-can-edit = ( p-db-num = v-cntxt-db-num
     1608                       or
     1609                       buf_db.db-key = '':U
     1610                       or v-cntxt-db-num = 0
     1611                      )
     1612       .
     1613     end.
     1614   end procedure.
     1615   procedure procedure-user-login-change-password :
     1616      define input  parameter p-db-num         as integer          no-undo.
     1617      define input  parameter p-user-id        as character        no-undo.
     1618      define input  parameter iChange          as logical          no-undo.
     1619      define variable v-can-edit         as logical   no-undo .
     1620      define variable v-encoded-pass     as character no-undo .
     1621      define variable v-encoded-pass-old as character no-undo .
     1622      define variable v-nextcon          as logical   no-undo .
     1623      define variable VadmSuff           as character no-undo.
     1624      define variable vChange as logical no-undo.
     1625      define variable v-param-type as character no-undo .
     1626      define variable v-value-character as character no-undo .
     1627      define variable v-value-date as date no-undo .
     1628      define variable v-value-decimal as decimal no-undo .
     1629      define variable v-value-integer as integer no-undo .
     1630      define variable v-value-logical as logical no-undo .
     1631      define variable v-tth           as handle  no-undo .
     1632      define buffer buf_lock_user-login for user-login.
     1633      define buffer buf_init_user-account for user-account.
     1634      do:
     1635         find first buf_lock_user-login no-lock
     1636                 where buf_lock_user-login.db-num  = p-db-num
     1637                   and buf_lock_user-login.user-id = p-user-id
     1638         no-error.
     1639         if not available buf_lock_user-login then do:
     1640            message
     1641               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     1642               view-as alert-box error .
     1643               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     1644         end.
     1645         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     1646         if vChange
     1647         then do trans:
     1648            run can-edit-login in this-procedure
     1649                 (input  p-db-num
     1650                 ,output v-can-edit
     1651                 ) .
     1652               if v-can-edit <> true
     1653               then do:
     1654                 message
     1655                   "Нельзя редактировать логин пользователя для базы" p-db-num skip
     1656                   view-as alert-box error .
     1657                 undo, return error return-value .
     1658               end.
     1659            if get-work-status( p-user-id ) = '+':u
     1660            then do:
     1661               message
     1662                   "Нельзя редактировать пароль работающего пользователя" skip
     1663                  view-as alert-box error .
     1664                    undo, return error "Нельзя редактировать пароль работающего пользователя" .
     1665            end.
     1666         end.
     1667         if     available buf_lock_user-login
     1668            and buf_lock_user-login.user-administrator
     1669         then
     1670            VadmSuff = 'Adm':U.
     1671         define variable v-TimeAvail as integer no-undo.
     1672         define variable v-DateChg   as date    no-undo.
     1673         define variable v-Time      as integer no-undo.
     1674         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     1675         run adm/shattri.p (
     1676              input "get":U
     1677              ,input  '':U
     1678              ,input  0
     1679              ,input  'staff':U
     1680              ,input  'TimeBlock':U + VadmSuff
     1681              ,output v-value-character
     1682              ,output v-value-date
     1683              ,output v-value-decimal
     1684              ,output v-TimeAvail
     1685              ,output v-value-logical
     1686              ,output v-param-type
     1687              ,input-output table-handle v-tth
     1688              )  .
     1689         if     not iChange
     1690            and v-TimeAvail ne 0
     1691            and v-DateChg + v-TimeAvail < today
     1692         then do:
     1693            do trans:
     1694               find current buf_lock_user-login exclusive-lock.
     1695               buf_lock_user-login.status_ = 1.
     1696            end.
     1697            return error "Ваша учетная запись заблокирована." .
     1698         end.
     1699         run adm/shattri.p (
     1700              input "get":U
     1701              ,input  '':U
     1702              ,input  0
     1703              ,input  'staff':U
     1704              ,input  'TimeAvail':U + VadmSuff
     1705              ,output v-value-character
     1706              ,output v-value-date
     1707              ,output v-value-decimal
     1708              ,output v-TimeAvail
     1709              ,output v-value-logical
     1710              ,output v-param-type
     1711              ,input-output table-handle v-tth
     1712              )  .
     1713         delete object v-tth.
     1714         define variable vfl as logical no-undo.
     1715         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     1716         if    vfl eq yes
     1717            or (     v-TimeAvail ne 0
     1718                 and v-DateChg + v-TimeAvail < today)
     1719            or iChange
     1720         then do:
     1721             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     1722             no-lock.
     1723             assign
     1724             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     1725             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     1726             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     1727                v-encoded-pass = v-encoded-pass-old.
     1728                run adm/chg-pswd.w ( input  this-procedure
     1729                                   , input  p-db-num
     1730                                   , input  buf_lock_user-login.user-id
     1731                                   , input  buf_lock_user-login.user-login
     1732                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     1733                                                                   , buf_init_user-account.first-name
     1734                                                                   , buf_init_user-account.second-name
     1735                                          )
     1736                                   , input  iChange
     1737                                   , input  yes
     1738                                   , input  buf_lock_user-login.user-password-encoded
     1739                                   , input  yes
     1740                                   , input  buf_lock_user-login.user-administrator
     1741                                   , output v-encoded-pass
     1742                                   , output v-nextcon
     1743                                   ) no-error .
     1744               if error-status :error
     1745               then do:
     1746                 message
     1747                    vss-workfile vss-revision vss-description skip
     1748                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     1749                    error-status :get-message(1) skip
     1750                    return-value skip
     1751                    view-as alert-box error .
     1752                 undo, return error return-value .
     1753                end.
     1754                if    v-encoded-pass = v-encoded-pass-old
     1755                then do:
     1756                    message
     1757                       vss-workfile vss-revision vss-description skip
     1758                       "Старый пароль и новый равны. Смените пароль.":U skip
     1759                       error-status :get-message(1) skip
     1760                       return-value skip
     1761                       view-as alert-box error .
     1762                end.
     1763                else if v-encoded-pass eq ?
     1764                then do:
     1765                   message  "Отказ от смены пароля. Работа дальше не возможна"
     1766                   view-as alert-box error.
     1767                   return error "Отказ от смены пароля. Работа дальше не возможна".
     1768                end.
     1769             end.
     1770             if v-encoded-pass <> ? then
     1771             do trans:
     1772                find current buf_lock_user-login
     1773                      exclusive-lock
     1774                   .
     1775                assign
     1776                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     1777                .
     1778                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     1779                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     1780                release buf_lock_user-login .
     1781                message
     1782                   "Пароль успешно изменен"
     1783                   view-as alert-box information
     1784                .
     1785             end.
     1786          end.
     1787      end.
     1788   end procedure.
     1789   procedure procedure-user-login-delete :
     1790      define input  parameter i-db-num     as integer          no-undo.
     1791      define input  parameter i-user-id    as character        no-undo.
     1792      define output parameter o-deleted   as logical          no-undo.
     1793      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     1794   end.
     1795   procedure procedure-user-login-delete-question :
     1796   define input  parameter i-db-num     as integer          no-undo.
     1797   define input  parameter i-user-id    as character        no-undo.
     1798   define input  parameter i-question as logical no-undo.
     1799   define output parameter o-deleted   as logical          no-undo.
     1800     define variable v-can-edit as logical   no-undo .
     1801       define buffer buf_user-login         for user-login .
     1802       define buffer buf_user-account       for user-account.
     1803       define buffer buf_init_user-account  for user-account.
     1804   do
     1805   for buf_user-login
     1806     , buf_user-account
     1807   on error undo, return error return-value
     1808   :
     1809       assign
     1810           o-deleted = no
     1811       .
     1812       find first buf_init_user-account no-lock
     1813            where buf_init_user-account.user-id = i-user-id
     1814           .
     1815       if available buf_init_user-account
     1816       then do:
     1817         do transaction
     1818         on error undo, return error return-value
     1819         :
     1820           run can-edit-login in this-procedure (
     1821                 input  i-db-num
     1822               , output v-can-edit
     1823           ).
     1824           if v-can-edit <> true
     1825           then do:
     1826             message
     1827               "Нельзя удалять логин пользователя для базы" i-db-num
     1828             view-as alert-box error .
     1829             undo, return error return-value .
     1830           end.
     1831           find first buf_user-login exclusive-lock
     1832                where buf_user-login.db-num  = i-db-num
     1833                  and buf_user-login.user-id = i-user-id
     1834           no-error no-wait.
     1835           if not available buf_user-login
     1836           then do:
     1837             if locked( buf_user-login )
     1838             then do:
     1839               find first buf_user-login no-lock
     1840                    where buf_user-login.db-num  = i-db-num
     1841                      and buf_user-login.user-id = i-user-id
     1842               .
     1843               message
     1844                 "Удаление логина невозможно" skip
     1845                 "Пользователь в данный момент работает в системе" skip
     1846                 "БД" i-db-num skip
     1847                 "Идентификатор" i-user-id skip
     1848                 "Псевдоним"                    buf_init_user-account.nik skip
     1849                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     1850                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     1851                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     1852                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     1853                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     1854                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     1855                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     1856                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     1857                 view-as alert-box error .
     1858             end.
     1859             else do:
     1860               message
     1861                 "У пользователя нет логина" skip
     1862                 "БД" i-db-num skip
     1863                 "Идентификатор" i-user-id skip
     1864                 "Удаление невозможно" skip
     1865                 view-as alert-box error .
     1866             end.
     1867             undo, return error return-value .
     1868           end.
     1869           if  buf_user-login.user-id = v-cntxt-userid
     1870           and buf_user-login.db-num  = v-cntxt-db-num
     1871           then do:
     1872             message
     1873               "Нельзя удалять текущий логин" skip
     1874               "БД"  buf_user-login.db-num skip
     1875               "Идентификатор" buf_user-login.user-id skip
     1876               view-as alert-box error .
     1877             undo, return error return-value .
     1878           end.
     1879           define variable v-ok as logical   no-undo .
     1880           if not i-question
     1881           then
     1882              v-ok = yes.
     1883           else do:
     1884              find first buf_user-account no-lock
     1885                   where buf_user-account.user-id = buf_user-login.user-id
     1886              .
     1887              message
     1888                "Удаление логина пользователя"
     1889                skip "Идентификатор" buf_user-account.user-id
     1890                skip "Псевдоним"    buf_user-account.nik
     1891                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     1892                skip "Логин для базы данных" buf_user-login.db-num
     1893                skip "Логин" buf_user-login.user-login
     1894                skip (1)
     1895                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     1896                skip (1)
     1897                "Продолжить?"
     1898              view-as alert-box question
     1899              buttons yes-no
     1900              update v-ok .
     1901           end.
     1902           if v-ok = yes
     1903           then do:
     1904               run str/usrlog03.p (
     1905                     input buf_user-login.db-num
     1906                   , input buf_user-login.user-id
     1907               ).
     1908               assign
     1909                   o-deleted = yes
     1910               .
     1911           end.
     1912         end.
     1913       end.
     1914     end.
     1915   end procedure.
     1916      DO
     1917         TRANSACTION
     1918         ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     1919         :
     1920         FIND FIRST lock_user-login
     1921            WHERE lock_user-login.db-num  = v-cntxt-db-num
     1922              AND lock_user-login.user-id = v-cntxt-userid
     1923            EXCLUSIVE-LOCK
     1924            NO-ERROR
     1925            .
     1926         IF NOT AVAILABLE lock_user-login
     1927            THEN
     1928         DO:
     1929            MESSAGE
     1930               vss-workfile vss-revision vss-description SKIP
     1931               "Ошибка задания входных параметров" SKIP
     1932               "Не найден логин пользователя" SKIP
     1933               "БД" v-cntxt-db-num SKIP
     1934               "Идентификатор" v-cntxt-userid SKIP
     1935               VIEW-AS ALERT-BOX ERROR .
     1936            UNDO, RETURN ERROR RETURN-VALUE .
     1937         END.
     1938      END.
     1939      run getAccountSetting (input  v-cntxt-userid,
     1940         output v-adm-Ubd,
     1941         output v-adm-gbd,
     1942         output v-superAdm,
     1943         input-output table-handle v-TabUserAdm).
     1944         run availOneAdm(input-output table-handle v-TabUserAdm, output voneadm).
     1945      run adm/chg-pswd.w ( INPUT  parParentProc
     1946         , INPUT  v-cntxt-db-num
     1947         , INPUT  v-cntxt-userid
     1948         , input  lock_user-login.user-login
     1949         , INPUT  ""
     1950         , INPUT  no
     1951         , input yes
     1952         , INPUT  lock_user-login.user-password-encoded
     1953         , yes
     1954         , v-adm-gbd or v-adm-ubd or voneadm
     1955         , OUTPUT v-password
     1956         , output v-nextcon
     1957         ) NO-ERROR.
     1958      IF ERROR-STATUS:ERROR
     1959         then
     1960      do:
     1961         message
     1962            vss-workfile vss-revision vss-description skip
     1963            "Ошибка при смене пароля. Пароль не сменен" skip
     1964            error-status :get-message(1) skip
     1965            return-value skip
     1966            view-as alert-box error .
     1967         return.
     1968      end.
     1969      IF v-password = ?
     1970         then
     1971      do:
     1972         return.
     1973      end.
     1974      DO
     1975         TRANSACTION
     1976         ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     1977         :
     1978         FIND CURRENT lock_user-login
     1979            EXCLUSIVE-LOCK
     1980            .
     1981         ASSIGN
     1982            lock_user-login.user-password-encoded = v-password
     1983            .
     1984         if no
     1985            then
     1986         do:
     1987            find first user-login-attr where user-login-attr.db-num    = lock_user-login.db-num
     1988               and user-login-attr.user-id   = lock_user-login.user-id
     1989               and user-login-attr.attr-code = "ChangPwdNextConect"
     1990               exclusive-lock no-error.
     1991            if not available user-login-attr
     1992               then
     1993            do:
     1994               create user-login-attr.
     1995               assign
     1996                  user-login-attr.db-num    = lock_user-login.db-num
     1997                  user-login-attr.user-id   = lock_user-login.user-id
     1998                  user-login-attr.attr-code = "ChangPwdNextConect"
     1999                  .
     2000            end.
     2001            user-login-attr.attr-value = string(v-nextcon ).
     2002         end.
     2003         release user-login-attr.
     2004         RELEASE lock_user-login .
     2005      END.
     2006      MESSAGE
     2007         "Пароль успешно изменен"
     2008         view-as alert-box information
     2009         .
     2010   END.
