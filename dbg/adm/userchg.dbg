        1   define input parameter parparentproc    as widget-handle    no-undo .
        2   define input parameter p-user-adm       as logical          no-undo .
        3   define input parameter p-mode           as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Окно редактирования пользователя".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   DEFINE BUTTON b-cancel AUTO-END-KEY
       71        LABEL "&Отмена"
       72        SIZE 10 BY 1
       73        BGCOLOR 8 .
       74   DEFINE BUTTON b-exit AUTO-GO
       75        LABEL "В&ыход"
       76        SIZE 10 BY 1
       77        BGCOLOR 8 .
       78   DEFINE BUTTON b-help
       79        LABEL "Помо&щь"
       80        SIZE 10 BY 1
       81        BGCOLOR 8 .
       82   DEFINE FRAME Dialog-Frame
       83        b-exit AT ROW 1 COL 1
       84        b-cancel AT ROW 1 COL 11
       85        b-help AT ROW 1 COL 89.5
       86        SPACE(0.37) SKIP(21.62)
       87       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       88            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       89            TITLE "<insert dialog title>"
       90            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel WIDGET-ID 100.
       91   ASSIGN
       92          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       93          FRAME Dialog-Frame:HIDDEN           = TRUE.
       94   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       95   DO:
       96     APPLY "END-ERROR":U TO SELF.
       97   END.
       98   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
       99   DO:
      100   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   if lookup(self :type
      102            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      103            ) = 0
      104   then do:
      105     message
      106       "$Workfile$"
      107       "Указанному интерфейсному элементу фокус не может быть передан" skip
      108       "Интерфейсный элемент" self :name  skip
      109       "Тип" self :type  skip
      110       "Процедура" this-procedure :file-name skip
      111       view-as alert-box .
      112   end.
      113   else do:
      114     apply "entry":u to self  .
      115     if focus :handle <> self :handle  then do:
      116       return no-apply .
      117     end.
      118   end.
      119   END.
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   on help of frame Dialog-Frame
      122   do:
      123     run gbl/app_help.p
      124       (input this-procedure :file-name
      125       ,input ''
      126       ,input ?
      127       ) no-error.
      128     if error-status :error then do:
      129       message
      130         "Ошибка при вызове помощи"
      131         error-status :get-message(1)
      132         view-as alert-box .
      133     end.
      134   end.
      135   run minbtn-set in this-procedure .
      136   on choose of b-help in frame Dialog-Frame
      137   do:
      138     apply "help":u to frame Dialog-Frame .
      139   end.
      140   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   procedure minbtn-set :
      142       do
      143           on error undo, return error return-value
      144           :
      145           define variable ii              as integer       no-undo .
      146           define variable fh              as widget-handle no-undo .
      147           define variable hh              as widget-handle no-undo .
      148           define variable v-h             as handle        extent 4 no-undo .
      149           define variable v-name-button   as character     no-undo .
      150           define variable v-help-old-x    as decimal       no-undo .
      151           define variable v-help-old-y    as decimal       no-undo .
      152           define variable v-help-old-size as decimal       no-undo .
      153           define variable v-frame-width   as decimal       no-undo .
      154           define variable jj              as integer       no-undo .
      155           do
      156               on error undo, return error
      157               :
      158               assign
      159                   v-frame-width = frame Dialog-Frame:width - 0.3
      160                   fh            = frame Dialog-Frame:first-child
      161                   hh            = fh:first-child
      162                   ii            = 1
      163                   .
      164               do while valid-handle(hh):
      165                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      166                   do:
      167                       case lc(hh:name) :
      168                           when "b-help" then
      169                               do:
      170                                   hh:load-image-up("cmp/b-help.bmp":u) .
      171                                   hh:load-image-down("cmp/b-help.bmp":u) .
      172                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      173                                   hh:TOOLTIP = "Помощь" .
      174                                   v-help-old-x = hh:column .
      175                                   v-help-old-y = hh:row    .
      176                                   v-help-old-size = hh:width .
      177                                   hh:width-chars = 2.5 .
      178                               end.
      179                           when "b-print" then
      180                               do:
      181                                   hh:load-image("cmp/b-print.bmp":u) .
      182                                   hh:TOOLTIP = "Печать" .
      183                                   v-h[ii] = hh:handle .
      184                                   ii = ii + 1 .
      185                                   hh:width-chars = 3 .
      186                               end.
      187                           when "b-history" or
      188                           when "b-hist" then
      189                               do:
      190                                   hh:load-image("cmp/b-hist.bmp":u) .
      191                                   hh:TOOLTIP = "История" .
      192                                   v-h[ii] = hh:handle .
      193                                   ii = ii + 1 .
      194                                   hh:width-chars = 3 .
      195                               end.
      196                           when "b-sch" then
      197                               do:
      198                                   hh:load-image("cmp/b-sch.bmp":u) .
      199                                   hh:TOOLTIP = "Установка Фильтра" .
      200                                   v-h[ii] = hh:handle .
      201                                   ii = ii + 1 .
      202                                   hh:width-chars = 3 .
      203                               end.
      204                           when "b-hist-user" then
      205                               do:
      206                                   hh:load-image("cmp/b-hist.bmp":u) .
      207                                   hh:TOOLTIP = "История пользователя" .
      208                                   ii = ii + 1 .
      209                               end.
      210                       end case.
      211                   end.
      212                   hh = hh:next-sibling.
      213               end.
      214               b-help:column = v-frame-width - b-help:width-chars.
      215               jj = 0.
      216               repeat ii = 4 to 1 by -1 :
      217                   if valid-handle (v-h[ii] ) then
      218                   do:
      219                       jj  = jj + 1 .
      220                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      221                       v-h[ii]:row    = v-help-old-y .
      222                   end.
      223               end.
      224           end.
      225       end.
      226   end procedure.
      227   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      228   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      229   MAIN-BLOCK:
      230   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      231      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      232       run init-fields this-procedure.
      233       RUN enable_UI.
      234     WAIT-FOR GO OF FRAME Dialog-Frame.
      235   END.
      236   RUN disable_UI.
      237   PROCEDURE disable_UI :
      238     HIDE FRAME Dialog-Frame.
      239   END PROCEDURE.
      240   PROCEDURE enable_UI :
      241     ENABLE b-exit b-cancel b-help
      242         WITH FRAME Dialog-Frame.
      243     VIEW FRAME Dialog-Frame.
      244   END PROCEDURE.
      245   PROCEDURE init-fields :
      246   do
      247   on error undo, return error
      248   :
      249   end.
      250   END PROCEDURE.
