     3190     tbl = 'c-config'
     3191     join-tbl = 'X_c-config'
     3192     fld = ""
     3193     lab = ""
     3194     spr = ""
     3195     dim = '0'
     3196     .
     3197   run fltfield-add in this-procedure('param-code', 'Название параметра', '',
     3198                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3199   run fltfield-add in this-procedure('host-code', 'Фирма', '',
     3200                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3201   run fltfield-add in this-procedure ('obj-type*obj-code', 'Объект', 'cli',
     3202                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3203   run fltfield-add in this-procedure('beg-date', 'Начало действия параметра', '',
     3204                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3205   run fltfield-add in this-procedure('end-date', 'Окончание действия параметра', '',
     3206                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3207   run fltfield-add in this-procedure('corr-user-db-num', 'БД параметра', 'db',
     3208                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3209   run fltfield-add in this-procedure('param-encoded', 'Кодировка', '',
     3210                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3211   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     3212                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3213   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3214                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3215   run fltfield-add in this-procedure('corr-date', 'Дата изменения', '',
     3216                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3217   run fltfield-add in this-procedure('corr-time', 'Время изменения', 'time',
     3218                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3219   run fltfield-add in this-procedure('corr-user-db-num', 'БД Изменения', 'db',
     3220                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3221   Filter-Block:
     3222   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3223       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3224       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3225     run gbl/filter.w ( INPUT parparentproc, INPUT v-filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3226     run my-open-query in this-procedure ( input yes, input no, input '':U).
     3227   END.
     3228   END PROCEDURE.
     3229   FUNCTION get-action RETURNS CHARACTER
     3230       ( p-action as integer ) :
     3231     define variable dops as character no-undo.
     3232       assign
     3233       dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U)
     3234       no-error
     3235     .
     3236     return dops.
     3237   END FUNCTION.
