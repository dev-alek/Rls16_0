        1   DEFINE BUFFER X_c-config FOR c-config.
        2   define  shared temp-table cnf no-undo
        3       field param-code    as character   format "x(8)"        column-label "Код"                               field param-type    as character                        column-label "Тип"                               field param-value   as character   format "x(250)"      column-label "Значение"                          field param-encoded as character                        column-label "Кодированное значение"             field host-code     as integer                          column-label "Фирма"                             field obj-type      as character                        column-label "Тип объекта"                       field obj-code      as integer     format ">>>>>>"      column-label "Код объекта"                       field conf-type     as character                        column-label "Кодировка"                         field beg-date      as date                             column-label "Начало действия параметра"         field end-date      as date                             column-label "Окончание действия параметра"      field db-num        as integer     format ">>>>>"       column-label "БД"                                field stts          as integer                          column-label "Статус"
        4       field db-key        as character   format "x(12)"       column-label "Ключ БД"
        5       field param-PS      as character   format "x(40)"       column-label "PS"
        6       field param-name    as character   format "x(30)"       column-label "Название"
        7       field is-changed    as logical initial false            column-label "Изменен"
        8       field NotUsed       as logical initial False            column-label "Выключен"
        9       field ErrorExist    as integer initial 0  format ">>"   column-label "Уровень ошибки"
       10       index pi
       11         is unique
       12         param-code
       13         host-code
       14         obj-type
       15         obj-code
       16         beg-date
       17         end-date
       18         db-num
       19       index db-num
       20         db-num
       21       index db-key
       22         db-key
       23       index par-name
       24         is word-index
       25         param-name
       26       index par-value
       27         is word-index
       28         param-value
       29    .
       30   def  shared temp-table log-table no-undo
       31       field stroka       as character format "x(256)".
       32   def  shared variable err-level as integer no-undo.
       33   define input parameter parparentproc as widget-handle no-undo .
       34   define parameter buffer buf_cnf      for cnf .
       35   def var vss-revision    as character no-undo init "$Revision$":U .
       36   def var vss-author      as character no-undo init "$Author$":U .
       37   def var vss-date        as character no-undo init "$Date$":U .
       38   def var vss-workfile    as character no-undo init "$Workfile$":U .
       39   def var vss-archive     as character no-undo init "$Archive$":U .
       40   def var vss-description as character no-undo init "Просмотр истории изменения конфигурационных параметров".
       41   procedure vss-get-info :
       42     define output parameter p-vss-revision    like vss-revision    no-undo .
       43     define output parameter p-vss-author      like vss-author      no-undo .
       44     define output parameter p-vss-date        like vss-date        no-undo .
       45     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       46     define output parameter p-vss-archive     like vss-archive     no-undo .
       47     define output parameter p-vss-description like vss-description no-undo .
       48     assign
       49       p-vss-revision    = vss-revision
       50       p-vss-author      = vss-author
       51       p-vss-date        = vss-date
       52       p-vss-workfile    = vss-workfile
       53       p-vss-archive     = vss-archive
       54       p-vss-description = vss-description
       55     .
       56   end procedure.
       57   procedure vss-get-parameters :
       58     define output parameter p-vss-parameters as character no-undo .
       59   end procedure.
       60   define new global shared variable g#vssrevis-logger as handle    no-undo .
       61   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       62   define variable v-vssrevis-logger                   as handle    no-undo .
       63   procedure vss-logevent :
       64     define input  parameter p-extra-paramters as character no-undo .
       65     define variable v-vssrevis-parameters as character no-undo .
       66     do
       67     on error undo, return error return-value
       68     :
       69       if  valid-handle(v-vssrevis-logger)
       70       and v-vssrevis-logger :get-signature("logevent") <> ""
       71       then do:
       72         run vss-get-parameters in this-procedure
       73           (output v-vssrevis-parameters
       74           ).
       75         run logevent in v-vssrevis-logger
       76           (input vss-workfile
       77           ,input vss-revision
       78           ,input v-vssrevis-parameters
       79           ,input p-extra-paramters
       80           ).
       81       end.
       82     end.
       83   end procedure.
       84   assign
       85     v-vssrevis-logger = g#vssrevis-logger
       86   .
       87   if  valid-handle(v-vssrevis-logger)
       88   and v-vssrevis-logger :get-signature("logevent") <> ""
       89   then do:
       90     assign
       91       v-vssrevis-logevent = true
       92     .
       93     run vss-logevent in this-procedure (input vss-description) .
       94   end.
       95   define new global shared variable g#language as character no-undo .
       96   if g#language <> '' and g#language <> 'rus':U then do:
       97     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       98   end.
       99   define new global shared variable g#library  as handle no-undo .
      100   define new global shared variable g#library2 as handle no-undo .
      101   define   shared variable g#auto as logical no-undo.
      102   define   shared variable g#news as logical no-undo.
      103   define   shared variable g#oxml as logical no-undo.
      104   define   shared variable g#esys as logical no-undo.
      105   define   shared variable g#news-source-db as integer no-undo.
      106   define   shared variable g#esys-source-esys as integer no-undo.
      107   define   shared variable g#db-num as integer   no-undo .
      108   define   shared variable g#userid as character no-undo .
      109   define   shared variable g#passwd as character no-undo .
      110   procedure proc-alt-shift-f2:
      111     if not ibs.th.gbl.gbl-var:rcode
      112   then
      113     run gbl\inidebug.p .
      114   end.
      115   procedure proc-alt-shift-f3:
      116     run gbl/prvssinf.p
      117       ( input this-procedure
      118       ) .
      119   end.
      120   define variable v-inform-launched as logical no-undo initial false .
      121   procedure proc-alt-shift-f4:
      122     define variable v-action as character no-undo .
      123     if v-inform-launched = false then do:
      124       assign
      125         v-inform-launched = true
      126       .
      127       run gbl/d-inform.w
      128         (  input self
      129         ,  input this-procedure
      130         , output v-action
      131         ) no-error .
      132       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      133       assign
      134         v-inform-launched = false
      135       .
      136     end.
      137   end.
      138   procedure proc-alt-f1:
      139     run gbl/corrhelp.p
      140       (input this-procedure
      141       ) .
      142   end .
      143   on alt-shift-f2 anywhere do:
      144     run proc-alt-shift-f2.
      145   end.
      146   on alt-shift-f3 anywhere do:
      147     run proc-alt-shift-f3 in this-procedure .
      148   end.
      149   on alt-shift-f4 anywhere do:
      150     run proc-alt-shift-f4 in this-procedure.
      151   end.
      152   on alt-f1 anywhere do:
      153     run proc-alt-f1 in this-procedure .
      154   end.
      155   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   define variable v-waitfram-action01         as character   no-undo .
      157   define variable v-waitfram-action02         as character   no-undo .
      158   define variable v-waitfram-action03         as character   no-undo .
      159   define variable mWaitFramTextBeg            as character   no-undo.
      160   define variable mWaitFramTextEnd            as character   no-undo.
      161   define variable mWaitFramView               as logical     no-undo.
      162   define variable mWaitProcEvent              as logical     no-undo init yes.
      163   define variable mWaitFramInterval           as integer     no-undo init 1 .
      164   define variable mWaitFramStop               as logical     no-undo.
      165   define variable mWaitFramStopUser           as logical     no-undo.
      166   define variable mWaitFramStopTimeOut        as logical     no-undo.
      167   define variable mWaitFramStartProc          as datetime-tz no-undo.
      168   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      169   define button B-WaitFramStop auto-end-key
      170        label "Стоп"
      171        size 10 by 1 tooltip "Остоновить процесс".
      172   define button B-viewProcInfo
      173        label "Информация"
      174        size 15 by 1 tooltip "Информация о процесс".
      175   define frame waitfram
      176     v-waitfram-action01 format "x(72)" no-label skip
      177     v-waitfram-action02 format "x(72)" no-label skip
      178     v-waitfram-action03 format "x(72)" no-label skip
      179     B-viewProcInfo
      180     B-WaitFramStop at row 4 col 30
      181     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      182     .
      183   define new global shared variable mBatchMode as logical no-undo init ?.
      184   define variable mFramBachModHandle as handle no-undo.
      185   mFramBachModHandle = frame waitfram:handle.
      186   define variable mFameOldVis as logical no-undo.
      187   define variable mVisCUrentVin as logical no-undo.
      188   if session:batch-mode
      189   then
      190      mBatchMode = yes.
      191   if mBatchMode = ? then do:
      192     mVisCUrentVin = current-window:visible.
      193     mFameOldVis = mFramBachModHandle:visible.
      194     mFramBachModHandle:visible  = yes.
      195     mBatchMode = mFramBachModHandle:visible ne yes.
      196     mFramBachModHandle:visible = mFameOldVis.
      197     current-window:visible = mVisCUrentVin.
      198   end.
      199    if  log-manager:logfile-name ne ?
      200     then DO:
      201         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      202         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      203         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      204     end.
      205   on choose of B-WaitFramStop in frame waitfram
      206   do:
      207     mWaitFramStop = yes.
      208     mWaitFramStopUser = yes.
      209   end.
      210   function waitfram-check-timeout returns logical():
      211      define variable vtime as int64 no-undo.
      212      if mWaitFramStopTimeOut
      213      then
      214         return yes.
      215      vtime = ( now - mWaitFramStartProc ) / 1000 .
      216      if     mWaitFramTimeOut ne ?
      217         and mWaitFramTimeOut ne 0
      218         and mWaitFramTimeOut lt vtime
      219      then do:
      220         mWaitFramStopTimeOut = yes.
      221      end.
      222      return mWaitFramStopTimeOut.
      223   end.
      224   procedure waitfram-hide :
      225     if not session:batch-mode
      226     then do
      227     on error undo, return error return-value
      228     :
      229       pause 0 before-hide .
      230       if not mBatchMode then
      231         hide frame waitfram .
      232     if     not mWaitFramView
      233        and mWaitProcEvent
      234     then
      235       process events .
      236     end.
      237   end procedure.
      238   procedure waitfram-show :
      239     define input  parameter p-message as character no-undo .
      240     define variable v-left-margin as integer   no-undo .
      241     if not session:batch-mode
      242     then do
      243     on error undo, return error return-value
      244     :
      245       if length(p-message) <= 70 then do:
      246         assign
      247           v-left-margin = integer((70 - length(p-message)) / 2)
      248         .
      249         assign
      250           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      251         .
      252         assign
      253           v-waitfram-action01 = " "
      254           v-waitfram-action02 = " "
      255                                    + fill(" ", v-left-margin)
      256                                    + p-message
      257           v-waitfram-action03 = " "
      258         .
      259       end.
      260       else do:
      261         define variable vRindex1 as integer no-undo.
      262         define variable vRindex2 as integer no-undo.
      263         vRindex1 = r-index(p-message," ",70).
      264         if vRindex1 = 0
      265         then
      266            vRindex1 = 70.
      267         if length(p-message)  <= vRindex1 + 70 then do:
      268           assign
      269             v-waitfram-action01 = " "
      270             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      271             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      272           .
      273         end.
      274         else do:
      275           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      276           if vRindex2 <= vRindex1
      277           then
      278              vRindex2 = vRindex1 + 70.
      279           assign
      280             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      281             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      282             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      283           .
      284         end.
      285       end.
      286       B-viewProcInfo:visible   in frame waitfram = no.
      287       B-viewProcInfo:sensitive in frame waitfram = no.
      288       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      289       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      290       if  (   mWaitFramView
      291          or  mWaitProcEvent)
      292          and not mBatchMode
      293       then
      294          display
      295             v-waitfram-action01 skip
      296             v-waitfram-action02 skip
      297             v-waitfram-action03 skip
      298          with frame waitfram .
      299       if     mWaitFramView
      300          then do:
      301             if     mWaitFramInterval ne ?
      302                and not mBatchMode
      303             then
      304                wait-for go of frame waitfram pause mWaitFramInterval.
      305          end.
      306          else
      307             if     mWaitProcEvent
      308                and not mBatchMode
      309             then
      310                process events .
      311     end.
      312   end procedure.
      313      procedure waitfram-show-this:
      314         define input  parameter iInterval as int64 no-undo.
      315         define variable vtime as int64 no-undo.
      316         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      317         mWaitFramInterval = iInterval.
      318         run waitfram-show (substitute("&1&2 &3&4" ,
      319                                       mWaitFramTextBeg ,
      320                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      321                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      322                                       mWaitFramTextEnd
      323                                      )
      324                           ).
      325      end.
      326      procedure WaitFramRunPause:
      327         define input  parameter iInterval as dec no-undo.
      328         define variable vStart  as datetime-tz no-undo.
      329         define variable vend    as datetime-tz no-undo.
      330         define variable vint as int64 no-undo.
      331         define variable vOk as logical no-undo.
      332         vStart = now.
      333         vend   = vStart.
      334         publish "WaitFramPause" (iInterval,output vOk).
      335         vend   =  now.
      336         vint = vend - vStart.
      337         vint = iInterval - vint / 1000.
      338         if     not mWaitFramStop
      339            and (   vint > 0
      340                 or (    not vOk
      341                     and iInterval eq ?
      342                     )
      343                 )
      344         then
      345            run waitfram-show-this (iInterval).
      346         vend   =  now.
      347         vint = vend - vStart.
      348         vint = iInterval - vint / 1000.
      349         if     not mWaitFramStop
      350            and vint > 0
      351         then do:
      352            run gbl/pause.p (vint * 1000).
      353         end.
      354         if iInterval ne ?
      355         then
      356            publish "WaitFramStop".
      357         waitfram-check-timeout().
      358      end.
      359      procedure WaitFramWaitFor:
      360         define input  parameter iInterval as dec no-undo.
      361         assign
      362            mWaitFramStartProc   = now
      363            mWaitFramStopUser    = no
      364            mWaitFramStopTimeOut = no
      365         .
      366         block-wait:
      367         do while not mWaitFramStop:
      368            run WaitFramRunPause (iInterval).
      369            if  waitfram-check-timeout()
      370            then do:
      371               leave block-wait.
      372            end.
      373         end.
      374         run waitfram-hide.
      375      end.
      376   procedure waitfram-join :
      377     define input  parameter p-line-1  as character no-undo .
      378     define input  parameter p-line-2  as character no-undo .
      379     define input  parameter p-line-3  as character no-undo .
      380     define output parameter p-message as character no-undo .
      381     do
      382     on error undo, return error return-value
      383     :
      384       assign
      385         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      386                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      387                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      388       .
      389     end.
      390   end procedure.
      391   function waitfram-join-function returns character
      392     (input p-line-1 as character
      393     ,input p-line-2 as character
      394     ,input p-line-3 as character
      395     ).
      396     define variable v-message as character no-undo .
      397     run waitfram-join in this-procedure
      398       (input  p-line-1
      399       ,input  p-line-2
      400       ,input  p-line-3
      401       ,output v-message
      402       ) .
      403     return v-message .
      404   end function .
      405   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   function usrfulnf returns character ( input p-user-id as character):
      407   define variable v-user-name as character no-undo .
      408   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      410     (input  p-user-id
      411     ,output v-user-name
      412     ) no-error .
      413   if error-status:error
      414   or v-user-name = ""
      415   then do:
      416     return p-user-id.
      417   end.
      418   else do:
      419     return v-user-name.
      420   end.
      421   end function.
      422   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      423   define   temp-table temp-changes no-undo
      424   field f_name as character
      425   field l_name as character
      426   field v_old as character
      427   field v_new as character
      428   field t_name as character
      429   field num_ as integer
      430   field uniq-key-rec as character
      431   field action as integer
      432   field fNotChange as logical
      433   index pi is unique primary
      434   num_
      435   t_name
      436   f_name
      437   index
      438   Chan
      439   fnotChange
      440   t_name
      441   f_name
      442   index imain uniq-key-rec
      443   .
      444   FUNCTION get-all-fields returns character (p-file-name as character ):
      445   define variable v-dop as character no-undo .
      446     find first _file no-lock where _file._file-name = p-file-name no-error .
      447     if not available _file then return "":U.
      448     for each _field no-lock where
      449              _field._file-recid = recid(_file) :
      450       assign
      451       v-dop = v-dop + _field._field-name + chr(44)
      452       .
      453     end.
      454     return trim(v-dop).
      455   END FUNCTION.
      456   PROCEDURE proc-full-temp-changes :
      457     define input  parameter p-act-create as logical   no-undo .
      458     define input  parameter p-act-delete as logical   no-undo .
      459     define input  parameter p-hst-handle as handle    no-undo .
      460     define input  parameter p-main-table as character no-undo .
      461     define input  parameter p-field-list as character no-undo .
      462     define input  parameter p-label-form as character no-undo .
      463     define variable h-new-buf         as handle    no-undo .
      464     define variable h-main-buf        as handle    no-undo .
      465     define variable h-for-comp        as handle    no-undo .
      466     define variable v-inform          as character no-undo .
      467     define variable v-ind             as integer   no-undo .
      468     define variable v-idx-field-qnty  as integer   no-undo .
      469     define variable v-num-entries     as integer   no-undo .
      470     define variable fh                as handle    no-undo .
      471     define variable fh-main           as handle    no-undo .
      472     define variable fh-old            as handle    no-undo .
      473     define variable fh-new            as handle    no-undo .
      474     define variable v-field-name      as character no-undo .
      475     define variable v-field-lvl       as character no-undo .
      476     define variable v-field-form      as character no-undo .
      477     define variable v-search-exp      as character no-undo .
      478     define variable v-srch-main       as character no-undo .
      479     define variable v-word-link       as character no-undo .
      480     define variable v-av-chip-num     as logical   no-undo .
      481     define variable v-main-pi-fld-lst as character no-undo .
      482     define variable v-main-fld-lst    as character no-undo .
      483     define variable v-delim-list      as character no-undo .
      484     define variable v-label           as character no-undo .
      485     define variable v-old-value       as character no-undo case-sensitive.
      486     define variable v-new-value       as character no-undo case-sensitive.
      487     define variable v-chg-fields as character no-undo.
      488     for each temp-changes:
      489       delete temp-changes.
      490     end.
      491     if not p-hst-handle:available then do:
      492       return .
      493     end.
      494     create buffer h-new-buf  for table p-hst-handle .
      495     create buffer h-main-buf for table p-main-table .
      496     assign
      497       v-inform = h-main-buf:index-information(1)
      498       v-ind    = 2
      499     .
      500     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      501     on error undo, return error
      502     :
      503       assign
      504         v-inform = h-main-buf:index-information( v-ind )
      505         v-ind    = v-ind + 1
      506       .
      507     end.
      508     if v-inform = ?
      509       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      510       or entry( 3, v-inform, ",":U ) <> "1":U
      511     then do:
      512       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      513     end.
      514     assign
      515       v-idx-field-qnty = num-entries( v-inform ) - 4
      516     .
      517     if v-idx-field-qnty < 2 then do:
      518       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      519     end.
      520     assign
      521       v-srch-main   = "where":U
      522       v-word-link   = "":U
      523       v-av-chip-num = false
      524       v-delim-list  = "":U
      525     .
      526     do v-ind = 1 to v-idx-field-qnty by 2
      527     on error undo, return error
      528     :
      529       assign
      530         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      531         fh                = p-hst-handle:buffer-field( v-field-name )
      532         fh-main           = h-main-buf:buffer-field( v-field-name )
      533         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      534         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      535       .
      536       if fh:data-type ="character":U then do:
      537         assign
      538           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      539         .
      540       end.
      541       else do:
      542         assign
      543           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      544         .
      545       end.
      546       if v-delim-list = "":U then do:
      547         assign
      548           v-delim-list = ",":U
      549         .
      550       end.
      551       if v-word-link = "":U then do:
      552         assign
      553           v-word-link = "and":U
      554         .
      555       end.
      556     end.
      557     assign
      558       v-delim-list  = "":U
      559     .
      560     do v-ind = 1 to h-main-buf:num-fields
      561     on error undo, return error
      562     :
      563       assign
      564         fh-main      = h-main-buf:buffer-field( v-ind )
      565         v-field-name = fh-main:name
      566       .
      567         assign
      568           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      569         .
      570         if v-delim-list = "":U then do:
      571           assign
      572             v-delim-list = ",":U
      573           .
      574         end.
      575     end.
      576     assign
      577       v-inform = p-hst-handle:index-information(1)
      578       v-ind    = 2
      579     .
      580     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      581     on error undo, return error
      582     :
      583       assign
      584         v-inform = p-hst-handle:index-information( v-ind )
      585         v-ind    = v-ind + 1
      586       .
      587     end.
      588     if v-inform = ?
      589       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      590       or entry( 3, v-inform, ",":U ) <> "1":U
      591     then do:
      592       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      593     end.
      594     assign
      595       v-idx-field-qnty = num-entries( v-inform ) - 4
      596     .
      597     if v-idx-field-qnty < 2 then do:
      598       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      599     end.
      600     assign
      601       v-search-exp  = "where":U
      602       v-word-link   = "":U
      603       v-av-chip-num = false
      604     .
      605     do v-ind = 1 to v-idx-field-qnty by 2
      606     on error undo, return error
      607     :
      608       assign
      609         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      610         fh           = p-hst-handle:buffer-field( v-field-name )
      611         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      612       .
      613       if v-field-name = "chip-num":U then do:
      614         assign
      615           v-search-exp  = substitute( "&1 >", v-search-exp )
      616           v-av-chip-num = true
      617         .
      618       end.
      619       else do:
      620         assign
      621           v-search-exp = substitute( "&1 =", v-search-exp )
      622         .
      623       end.
      624       if fh:data-type ="character":U then do:
      625         assign
      626           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      627         .
      628       end.
      629       else do:
      630         assign
      631           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      632         .
      633       end.
      634       if v-word-link = "":U then do:
      635         assign
      636           v-word-link = "and":U
      637         .
      638       end.
      639     end.
      640     if v-av-chip-num = false then do:
      641       message
      642         vss-workfile vss-revision vss-description skip
      643         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      644         "Использование данной процедуры невозможно!" skip
      645         view-as alert-box error .
      646       return error .
      647     end.
      648     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      649     if not h-new-buf:available then do:
      650       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      651       if not h-main-buf:available then do:
      652         assign
      653           h-for-comp = ?
      654         .
      655       end.
      656       else do:
      657         assign
      658           h-for-comp = h-main-buf
      659         .
      660       end.
      661     end.
      662     else do:
      663       assign
      664         h-for-comp = h-new-buf
      665       .
      666     end.
      667     assign
      668       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      669     .
      670     do v-ind = 1 to v-num-entries
      671     on error undo, return error return-value
      672     :
      673       assign
      674         v-field-name = entry( v-ind, v-main-fld-lst )
      675         fh-old       = p-hst-handle:buffer-field( v-field-name )
      676         v-old-value  = fh-old:buffer-value()
      677         v-label      = trim( fh-old:label )
      678       .
      679       if ( trim( p-field-list ) <> "":U
      680            and lookup( v-field-name, p-field-list ) > 0
      681          )
      682          or trim( p-field-list ) = "":U
      683       then do:
      684         if h-for-comp <> ? then do:
      685           assign
      686             fh-new      = h-for-comp:buffer-field( v-field-name )
      687             v-new-value = fh-new:buffer-value()
      688           .
      689         end.
      690         else do:
      691           assign
      692             v-new-value = "":U
      693           .
      694         end.
      695           if p-act-create = true then do:
      696             assign
      697               v-old-value = "":U
      698             .
      699           end.
      700           if p-act-delete = true then do:
      701             assign
      702               v-new-value = "":U
      703             .
      704           end.
      705         if v-old-value <> v-new-value
      706         then do:
      707           create temp-changes.
      708           assign
      709             temp-changes.t_name = p-main-table
      710             temp-changes.f_name = v-field-name
      711             temp-changes.l_name = replace( v-label, "&":U, "":U )
      712             temp-changes.v_old  = trim( v-old-value )
      713             temp-changes.v_new  = trim( v-new-value )
      714             temp-changes.num_   = 0
      715             temp-changes.fNotChange = v-old-value eq v-new-value
      716           .
      717         end.
      718       end.
      719     end.
      720     assign
      721       v-num-entries = num-entries( p-label-form, chr(8) )
      722     .
      723     do v-ind = 1 to v-num-entries
      724     on error undo, return error return-value
      725     :
      726       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      727         assign
      728           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      729           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      730           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      731         .
      732         find first temp-changes
      733           where temp-changes.f_name = v-field-name
      734           no-error .
      735         if available temp-changes then do:
      736           if trim( v-field-lvl ) <> "":U then do:
      737             assign
      738               temp-changes.l_name = v-field-lvl
      739             .
      740           end.
      741           if trim( v-field-form ) <> "":U then do:
      742             assign
      743               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      744             .
      745             if h-for-comp <> ? then do:
      746               assign
      747                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      748               .
      749             end.
      750           end.
      751         end.
      752       end.
      753       else do:
      754         message
      755           vss-workfile vss-revision vss-description skip
      756           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      757           substitute( "список для поля '&1': '&2'"
      758                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      759                       ,entry( v-ind, p-label-form, chr(8) )
      760                     ) skip
      761           substitute( "полный список: &2", p-label-form ) skip
      762           view-as alert-box error .
      763       end.
      764     end.
      765     delete object h-new-buf .
      766     delete object h-main-buf .
      767   END PROCEDURE.
      768   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   define variable c-point  as character no-undo .
      770   define variable tbl      as character no-undo .
      771   define variable join-tbl as character no-undo .
      772   define variable fld      as character no-undo .
      773   define variable lab      as character no-undo .
      774   define variable spr      as character no-undo .
      775   define variable dim      as character no-undo .
      776   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777   procedure fltfield-clear :
      778     define output parameter loc-fld as character no-undo.
      779     define output parameter loc-lab as character no-undo .
      780     define output parameter loc-spr as character no-undo .
      781     define output parameter loc-dim as character no-undo .
      782     assign
      783       loc-fld = ""
      784       loc-lab = ""
      785       loc-spr = ""
      786       loc-dim = "0"
      787     .
      788   end procedure .
      789   procedure fltfield-add :
      790     define input        parameter par-fld as character no-undo.
      791     define input        parameter par-lab as character no-undo .
      792     define input        parameter par-spr as character no-undo .
      793     define input-output parameter loc-fld as character no-undo.
      794     define input-output parameter loc-lab as character no-undo .
      795     define input-output parameter loc-spr as character no-undo .
      796     define input-output parameter loc-dim as character no-undo .
      797     do
      798     on error undo, return error
      799     :
      800       assign
      801       loc-fld = if loc-dim = '0'
      802                 then par-fld
      803                 else (loc-fld + chr(44) + par-fld)
      804       loc-lab = if loc-dim = '0'
      805                 then par-lab
      806                 else (loc-lab + chr(44) + par-lab)
      807       loc-spr = if loc-dim = '0'
      808                 then par-spr
      809                 else (loc-spr + chr(44) + par-spr)
      810       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      811                 string(integer(if num-entries(loc-dim) > 1
      812                               then entry(2, loc-dim)
      813                               else entry(1, loc-dim)
      814                               ) + 1)
      815       no-error
      816       .
      817     end.
      818   end procedure.
      819   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      821   procedure fltopend_fltopend :
      822   define input parameter p-parent-handle as handle no-undo .
      823   define input parameter p-qh as handle no-undo .
      824   define input parameter p-flt-open-open-query  as character no-undo .
      825   define input parameter p-where-cond as character no-undo .
      826   define input parameter p-use-indFIRST-query-tail as character no-undo .
      827   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      828   define input parameter p-indexed-reposition as character no-undo .
      829     do
      830     on error undo, return error
      831     :
      832   define variable v-prepare-string as character no-undo .
      833   define variable glog as logical no-undo .
      834   assign
      835   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      836                      p-where-cond + chr(32)  +
      837                      p-use-indFIRST-query-tail + chr(32) +
      838                      p-use-ind-sort-clmn-by + chr(32) +
      839                      p-indexed-reposition
      840   .
      841   assign
      842   glog = p-qh:query-prepare(v-prepare-string) no-error .
      843   if not glog
      844   or error-status:error then do:
      845     message error-status:get-message(1) view-as alert-box .
      846     undo, return error .
      847   end.
      848   assign
      849   glog = p-qh:query-open no-error .
      850   if not glog
      851   or error-status:error then do:
      852     message error-status:get-message(1) view-as alert-box .
      853     undo, return error .
      854   end.
      855     end.
      856   end procedure.
      857   procedure fltopend_fltfindd :
      858   define input parameter p-parent-handle as handle no-undo .
      859   define input parameter p-qh as handle no-undo .
      860   define input parameter p-rowid as rowid no-undo .
      861   define input parameter p-next as logical no-undo .
      862   define input parameter p-lock as integer no-undo .
      863   define input parameter p-bh as handle no-undo .
      864   define input parameter p-where-cond as character no-undo .
      865   define input parameter p-use-index-phrase as character no-undo .
      866   define variable glog as logical no-undo .
      867   define variable v-qh as handle no-undo .
      868   define variable v-bh as handle no-undo .
      869   define variable v-recid as recid no-undo .
      870   define variable v-prepare-string as character no-undo .
      871   do
      872   on error undo, return error
      873   on stop undo, return error
      874   :
      875     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      876     create buffer v-bh for table p-bh buffer-name p-bh:name.
      877     create query v-qh.
      878     v-qh:set-buffers(v-bh).
      879     v-prepare-string = substitute("for each &1 &2 &3"
      880                                     ,v-bh:name
      881                                     ,p-where-cond
      882                                     ,p-use-index-phrase).
      883     glog = v-qh:query-prepare(v-prepare-string) no-error.
      884     if not glog then do:
      885       delete object v-qh.
      886       delete object v-bh.
      887       undo, return error .
      888     end.
      889     glog = v-qh:query-open no-error .
      890     if not glog then do:
      891       delete object v-qh.
      892       delete object v-bh.
      893       undo, return error .
      894     end.
      895     if p-next then do:
      896       v-qh:reposition-to-rowid(p-rowid) no-error .
      897       glog = v-qh:get-next( p-lock) no-error .
      898       glog = v-qh:get-next( p-lock) no-error .
      899       if not glog or v-qh:query-off-end = yes then do:
      900         glog = v-qh:get-first( p-lock) no-error .
      901       end.
      902     end.
      903     else do:
      904       glog = v-qh:get-first( p-lock) no-error .
      905     end.
      906     v-recid = v-bh:recid no-error .
      907     delete object v-qh.
      908     delete object v-bh.
      909     return string(v-recid) .
      910   end.
      911   end procedure.
      912   procedure fltopend_fltfindq :
      913   define input parameter p-parent-handle as handle no-undo .
      914   define input parameter p-qh as handle no-undo .
      915   define input parameter p-next as logical no-undo .
      916   define input parameter p-lock as integer no-undo .
      917   define input parameter p-flt-open-open-query  as character no-undo .
      918   define input parameter p-where-cond as character no-undo .
      919   define input parameter p-use-indFIRST-query-tail as character no-undo .
      920   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      921   define input parameter p-indexed-reposition as character no-undo .
      922   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      923   define variable glog as logical no-undo .
      924   define variable v-qh as handle no-undo .
      925   define variable v-bh as handle no-undo extent 18.
      926   define variable v-rowid as rowid no-undo extent 18.
      927   define variable v-ii as integer no-undo .
      928   define variable v-prepare-string as character no-undo .
      929   do
      930   on error undo, return error
      931   on stop undo, return error
      932   :
      933     create query v-qh.
      934     do v-ii = 1 to p-qh:num-buffers:
      935       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      936       assign
      937       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      938       no-error.
      939       v-qh:add-buffer(v-bh[v-ii]).
      940     end.
      941     assign
      942     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      943                       p-where-cond + chr(32)  +
      944                       p-use-indFIRST-query-tail + chr(32) +
      945                       p-use-ind-sort-clmn-by + chr(32) +
      946                       p-indexed-reposition
      947     .
      948     glog = v-qh:query-prepare( v-prepare-string) no-error .
      949     if not glog then do:
      950       delete object v-qh.
      951       do v-ii = 1 to p-qh:num-buffers:
      952         delete object v-bh[v-ii].
      953       end.
      954       undo, return error .
      955     end.
      956     glog = v-qh:query-open no-error .
      957     if not glog then do:
      958       delete object v-qh.
      959       do v-ii = 1 to p-qh:num-buffers:
      960         delete object v-bh[v-ii].
      961       end.
      962       undo, return error .
      963     end.
      964     if p-next then do:
      965       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      966       glog = v-qh:get-next( p-lock) no-error .
      967       glog = v-qh:get-next( p-lock) no-error .
      968       if not glog or v-qh:query-off-end = yes then do:
      969         glog = v-qh:get-first( p-lock) no-error .
      970       end.
      971     end.
      972     else do:
      973       glog = v-qh:get-first( p-lock) no-error .
      974     end.
      975     do v-ii = 1 to p-qh:num-buffers:
      976       assign
      977       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      978       no-error.
      979     end.
      980     delete object v-qh.
      981     do v-ii = 1 to p-qh:num-buffers:
      982       delete object v-bh[v-ii].
      983     end.
      984   end.
      985   end procedure.
      986   define variable v-hist-rec         as recid no-undo.
      987   define variable v-sort-column-name as character no-undo .
      988   define variable v-filter-pointr as character no-undo init "Просмотр истории изменения конфигурационных параметров" .
      989   define variable v-filter-point0 as character no-undo init "cfg-hist" .
      990   define variable v-filter-point as character no-undo .
      991   FUNCTION get-action RETURNS CHARACTER
      992       ( p-action as integer )  FORWARD.
      993   DEFINE BUTTON b-help
      994        LABEL "Помо&щь"
      995        SIZE 3 BY 1
      996        BGCOLOR 8 .
      997   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      998        LABEL "&Выход"
      999        SIZE 10 BY 1
     1000        BGCOLOR 8 .
     1001   DEFINE BUTTON b-sch
     1002        LABEL "&Фильтр"
     1003        SIZE 3 BY 1.
     1004   DEFINE QUERY br-cfg-hist FOR
     1005   X_c-config.
     1006   DEFINE QUERY BR-changes FOR
     1007         temp-changes SCROLLING.
     1008   DEFINE BROWSE br-cfg-hist
     1009     QUERY br-cfg-hist NO-LOCK DISPLAY
     1010         X_c-config.corr-user-name column-label "Изменил" FORMAT "x(8)":U
     1011         usrfulnf(X_c-config.corr-user-name) column-label "Изменил" FORMAT "x(15)":U
     1012         X_c-config.corr-user-db-num COLUMN-LABEL "БД изм." FORMAT ">>>>9":U
     1013         X_c-config.corr-date FORMAT "99/99/9999":U
     1014         string(X_c-config.corr-time,"HH:MM:SS") COLUMN-LABEL "Время изм." FORMAT "x(8)":U
     1015         get-action(X_c-config.action) COLUMN-LABEL "Действие" FORMAT "x(10)":U
     1016         X_c-config.db-num FORMAT ">>>>9":U
     1017         X_c-config.param-code COLUMN-LABEL "Параметр" FORMAT "X(8)":U
     1018         X_c-config.host-code COLUMN-LABEL "Код фирмы" FORMAT "99999":U
     1019         substitute("&1 &2",X_c-config.obj-type,X_c-config.obj-code) COLUMN-LABEL "Объект" FORMAT "x(9)":U
     1020         (if X_c-config.beg-date = 01/01/1900 then "не ограничен" else string( X_c-config.beg-date, "99/99/9999")) COLUMN-LABEL "Действует с" FORMAT "x(12)":U
     1021         (if X_c-config.end-date = 01/01/9999 then "не ограничен" else string( X_c-config.end-date, "99/99/9999")) COLUMN-LABEL "Действует по" FORMAT "x(12)":U
     1022       WITH SEPARATORS SIZE 97 BY 11 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
     1023   DEFINE BROWSE BR-changes
     1024     QUERY BR-changes DISPLAY
     1025         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1026   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1027   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1028       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 8.25.
     1029   DEFINE FRAME d-cfg-hist
     1030        b-quit AT ROW 1 COL 2
     1031        b-sch AT ROW 1 COL 93 WIDGET-ID 2
     1032        b-help AT ROW 1 COL 96
     1033        br-cfg-hist AT ROW 2.25 COL 2
     1034        BR-changes AT ROW 14.25 COL 2
     1035        SPACE(0.87) SKIP(0.37)
     1036       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1037            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1038            TITLE "История изменения параметров конфигурации"
     1039            CANCEL-BUTTON b-quit.
     1040   ASSIGN
     1041          FRAME d-cfg-hist:SCROLLABLE       = FALSE.
     1042   ASSIGN
     1043          br-cfg-hist:COLUMN-RESIZABLE IN FRAME d-cfg-hist       = TRUE.
     1044   ON WINDOW-CLOSE OF FRAME d-cfg-hist
     1045   DO:
     1046     APPLY "END-ERROR":U TO SELF.
     1047   END.
     1048   ON CHOOSE OF b-quit IN FRAME d-cfg-hist
     1049   DO:
     1050     define variable v-ok as logical   no-undo .
     1051   END.
     1052   ON CHOOSE OF b-sch IN FRAME d-cfg-hist
     1053   DO:
     1054     RUN proc-b-sch IN this-procedure NO-ERROR.
     1055   END.
     1056   ON VALUE-CHANGED OF br-cfg-hist IN FRAME d-cfg-hist
     1057   DO:
     1058     if available X_c-config then do:
     1059       run proc-full-temp-changes in this-procedure
     1060         ( input (X_c-config.action = 1 )
     1061          ,input (X_c-config.action = 99 )
     1062          ,input (buffer X_c-config:handle)
     1063          ,input 'config':U
     1064          ,input "beg-date,conf-type,db-num,end-date,host-code,obj-code,obj-type,param-code,param-encoded,param-type,param-value":U
     1065          ,input "":U
     1066         ) no-error.
     1067     end.
     1068     else do:
     1069       for each temp-changes
     1070       :
     1071         delete temp-changes .
     1072       end.
     1073     end.
     1074     OPEN QUERY BR-changes FOR EACH temp-changes.
     1075   END.
     1076   if VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cfg-hist:PARENT eq ?
     1077   THEN FRAME d-cfg-hist:PARENT = ACTIVE-WINDOW.
     1078   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   on help of frame d-cfg-hist
     1080   do:
     1081     run gbl/app_help.p
     1082       (input this-procedure :file-name
     1083       ,input ''
     1084       ,input ?
     1085       ) no-error.
     1086     if error-status :error then do:
     1087       message
     1088         "Ошибка при вызове помощи"
     1089         error-status :get-message(1)
     1090         view-as alert-box .
     1091     end.
     1092   end.
     1093   run minbtn-set in this-procedure .
     1094   on choose of b-help in frame d-cfg-hist
     1095   do:
     1096     apply "help":u to frame d-cfg-hist .
     1097   end.
     1098   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   procedure minbtn-set :
     1100       do
     1101           on error undo, return error return-value
     1102           :
     1103           define variable ii              as integer       no-undo .
     1104           define variable fh              as widget-handle no-undo .
     1105           define variable hh              as widget-handle no-undo .
     1106           define variable v-h             as handle        extent 4 no-undo .
     1107           define variable v-name-button   as character     no-undo .
     1108           define variable v-help-old-x    as decimal       no-undo .
     1109           define variable v-help-old-y    as decimal       no-undo .
     1110           define variable v-help-old-size as decimal       no-undo .
     1111           define variable v-frame-width   as decimal       no-undo .
     1112           define variable jj              as integer       no-undo .
     1113           do
     1114               on error undo, return error
     1115               :
     1116               assign
     1117                   v-frame-width = frame d-cfg-hist:width - 0.3
     1118                   fh            = frame d-cfg-hist:first-child
     1119                   hh            = fh:first-child
     1120                   ii            = 1
     1121                   .
     1122               do while valid-handle(hh):
     1123                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1124                   do:
     1125                       case lc(hh:name) :
     1126                           when "b-help" then
     1127                               do:
     1128                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1129                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1130                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1131                                   hh:TOOLTIP = "Помощь" .
     1132                                   v-help-old-x = hh:column .
     1133                                   v-help-old-y = hh:row    .
     1134                                   v-help-old-size = hh:width .
     1135                                   hh:width-chars = 2.5 .
     1136                               end.
     1137                           when "b-print" then
     1138                               do:
     1139                                   hh:load-image("cmp/b-print.bmp":u) .
     1140                                   hh:TOOLTIP = "Печать" .
     1141                                   v-h[ii] = hh:handle .
     1142                                   ii = ii + 1 .
     1143                                   hh:width-chars = 3 .
     1144                               end.
     1145                           when "b-history" or
     1146                           when "b-hist" then
     1147                               do:
     1148                                   hh:load-image("cmp/b-hist.bmp":u) .
     1149                                   hh:TOOLTIP = "История" .
     1150                                   v-h[ii] = hh:handle .
     1151                                   ii = ii + 1 .
     1152                                   hh:width-chars = 3 .
     1153                               end.
     1154                           when "b-sch" then
     1155                               do:
     1156                                   hh:load-image("cmp/b-sch.bmp":u) .
     1157                                   hh:TOOLTIP = "Установка Фильтра" .
     1158                                   v-h[ii] = hh:handle .
     1159                                   ii = ii + 1 .
     1160                                   hh:width-chars = 3 .
     1161                               end.
     1162                           when "b-hist-user" then
     1163                               do:
     1164                                   hh:load-image("cmp/b-hist.bmp":u) .
     1165                                   hh:TOOLTIP = "История пользователя" .
     1166                                   ii = ii + 1 .
     1167                               end.
     1168                       end case.
     1169                   end.
     1170                   hh = hh:next-sibling.
     1171               end.
     1172               b-help:column = v-frame-width - b-help:width-chars.
     1173               jj = 0.
     1174               repeat ii = 4 to 1 by -1 :
     1175                   if valid-handle (v-h[ii] ) then
     1176                   do:
     1177                       jj  = jj + 1 .
     1178                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1179                       v-h[ii]:row    = v-help-old-y .
     1180                   end.
     1181               end.
     1182           end.
     1183       end.
     1184   end procedure.
     1185   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1186   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1187   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1188   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1189   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1190   define variable v-diasize-current-frame-height as decimal   no-undo .
     1191   define variable v-diasize-change-size          as logical   no-undo .
     1192   define variable v-diasize-resize-button        as handle    no-undo .
     1193   define variable v-diasize-wndmax               as logical   no-undo .
     1194   define variable v-diasize-wndstore             as logical   no-undo .
     1195   define variable v-diasize-proc-name            as character no-undo .
     1196   define variable v-diasize-browse-handle        as handle    no-undo .
     1197   define variable v-diasize-browse-number        as integer   no-undo .
     1198   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1199   define temp-table temp-diasize-handle no-undo
     1200     field handle-value  as handle
     1201     field save-position as decimal
     1202     index xpk is primary unique handle-value
     1203     .
     1204   define temp-table temp-browse-handle no-undo
     1205     field browse-type   as character
     1206     field browse-number as integer
     1207     field browse-handle as handle
     1208     field original-size as decimal
     1209     index xpk is primary unique browse-type browse-number
     1210     index xie browse-type browse-handle
     1211   .
     1212   procedure diasize_change-height :
     1213     define input  parameter p-change-value  as decimal   no-undo .
     1214     define input  parameter p-move-resize   as logical   no-undo .
     1215     define variable v-field-group-handle    as handle    no-undo .
     1216     define variable v-object-handle         as handle    no-undo .
     1217     define variable v-frame-height          as decimal   no-undo .
     1218     define variable v-frame-virtual-height  as decimal   no-undo .
     1219     define variable v-browse-height         as decimal   no-undo .
     1220     define variable v-window-height         as decimal   no-undo .
     1221     define variable v-window-virtual-height as decimal   no-undo .
     1222     define variable v-change-sign           as integer   no-undo .
     1223     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1224     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1225     if p-change-value > 0
     1226     then do:
     1227       if frame d-cfg-hist :height + p-change-value
     1228           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1229       then do:
     1230         assign
     1231           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1232                           - (frame d-cfg-hist :height-chars)
     1233         .
     1234         if p-change-value <= 0
     1235         then do:
     1236           run diasize_position-resize-button in this-procedure .
     1237           return .
     1238         end.
     1239       end.
     1240     end.
     1241     if p-change-value < 0
     1242     then do:
     1243       if frame d-cfg-hist :height + p-change-value < v-diasize-orig-frame-height
     1244       then do:
     1245         assign
     1246           p-change-value = v-diasize-orig-frame-height
     1247                          - (frame d-cfg-hist :height-chars)
     1248         .
     1249         if p-change-value >= 0
     1250         then do:
     1251           run diasize_position-resize-button in this-procedure .
     1252           return .
     1253         end.
     1254       end.
     1255     end.
     1256     if p-change-value >= 0
     1257     then do:
     1258       assign
     1259         v-change-sign = 1
     1260       .
     1261     end.
     1262     else do:
     1263       assign
     1264         v-change-sign = -1
     1265       .
     1266     end.
     1267     assign
     1268       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1269     .
     1270     if p-change-value = 0
     1271     then do:
     1272       run diasize_position-resize-button in this-procedure .
     1273       return .
     1274     end.
     1275     move_block:
     1276     do
     1277     on error undo move_block, retry move_block
     1278     :
     1279       if retry
     1280       then do:
     1281         do
     1282         on error undo move_block, leave move_block
     1283         :
     1284           if p-change-value > 0
     1285           then do:
     1286             for each buf_temp-diasize-handle
     1287             on error undo, next
     1288             :
     1289               assign
     1290                 v-object-handle = buf_temp-diasize-handle.handle-value
     1291               .
     1292               if v-object-handle <> v-diasize-resize-button
     1293               then do:
     1294                 assign
     1295                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1296                 .
     1297               end.
     1298             end.
     1299             assign
     1300               v-diasize-browse-handle :height = v-browse-height
     1301             .
     1302             for each buf_temp-browse-handle
     1303               where buf_temp-browse-handle.browse-type = 'height':u
     1304             on error undo, next
     1305             :
     1306               assign
     1307                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1308               .
     1309             end.
     1310             assign
     1311               frame d-cfg-hist :height = v-frame-height
     1312             .
     1313             if frame d-cfg-hist :scrollable = true
     1314             then do:
     1315               assign
     1316                 frame d-cfg-hist :virtual-height = v-frame-virtual-height
     1317               .
     1318             end.
     1319             run diasize_position-resize-button in this-procedure .
     1320           end.
     1321           else do:
     1322             if frame d-cfg-hist :scrollable = true
     1323             then do:
     1324               assign
     1325                 frame d-cfg-hist :virtual-height = v-frame-virtual-height
     1326               .
     1327             end.
     1328             assign
     1329               frame d-cfg-hist :height = v-frame-height
     1330             .
     1331             assign
     1332               v-diasize-browse-handle :height = v-browse-height
     1333             .
     1334             for each buf_temp-browse-handle
     1335               where buf_temp-browse-handle.browse-type = 'height':u
     1336             on error undo, next
     1337             :
     1338               assign
     1339                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1340               .
     1341             end.
     1342             for each buf_temp-diasize-handle
     1343             on error undo, next
     1344             :
     1345               assign
     1346                 v-object-handle = buf_temp-diasize-handle.handle-value
     1347               .
     1348               if v-object-handle <> v-diasize-resize-button
     1349               then do:
     1350                 assign
     1351                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1352                 .
     1353               end.
     1354             end.
     1355             run diasize_position-resize-button in this-procedure .
     1356           end.
     1357           assign
     1358             v-diasize-change-size = false
     1359           .
     1360           leave move_block .
     1361         end.
     1362       end.
     1363       assign
     1364         v-diasize-need-full-display = true
     1365       .
     1366       if v-diasize-change-size = false
     1367       then do:
     1368         assign
     1369           v-diasize-change-size = true
     1370         .
     1371       end.
     1372       else do:
     1373         return .
     1374       end.
     1375       assign
     1376         v-frame-height = frame d-cfg-hist :height
     1377         v-frame-virtual-height = frame d-cfg-hist :virtual-height
     1378         v-browse-height = v-diasize-browse-handle :height
     1379       .
     1380       for each buf_temp-browse-handle
     1381         where buf_temp-browse-handle.browse-type = 'height':u
     1382       :
     1383         assign
     1384           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1385         .
     1386       end.
     1387       for each buf_temp-diasize-handle
     1388       :
     1389         delete buf_temp-diasize-handle .
     1390       end.
     1391       assign
     1392         v-field-group-handle = frame d-cfg-hist :first-child
     1393       .
     1394       do while valid-handle(v-field-group-handle)
     1395       :
     1396         assign
     1397           v-object-handle = v-field-group-handle :first-child
     1398         .
     1399         do while valid-handle(v-object-handle)
     1400         :
     1401           if  v-object-handle <> v-diasize-browse-handle :handle
     1402           and can-query(v-object-handle, "row")
     1403           and can-query(v-object-handle, "height")
     1404           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1405           then do:
     1406             find first buf_temp-browse-handle
     1407               where buf_temp-browse-handle.browse-type   = 'height':u
     1408                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1409               no-error .
     1410             if available buf_temp-browse-handle
     1411             then do:
     1412             end.
     1413             else do:
     1414               create buf_temp-diasize-handle .
     1415               assign
     1416                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1417                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1418               .
     1419             end.
     1420           end.
     1421           assign
     1422             v-object-handle = v-object-handle :next-sibling
     1423           .
     1424         end.
     1425         assign
     1426           v-field-group-handle = v-field-group-handle :next-sibling
     1427         .
     1428       end.
     1429       do with frame d-cfg-hist
     1430       :
     1431         hide v-diasize-resize-button .
     1432         assign
     1433           v-diasize-resize-button :row    = 1
     1434           v-diasize-resize-button :column = 1
     1435         .
     1436       end.
     1437       if p-change-value > 0
     1438       then do:
     1439         if frame d-cfg-hist :scrollable = true
     1440         then do:
     1441           assign
     1442             frame d-cfg-hist :virtual-height = frame d-cfg-hist :virtual-height + p-change-value
     1443             no-error .
     1444           if error-status :error
     1445           or error-status :get-message(1) <> ""
     1446           then do:
     1447             undo move_block, retry move_block .
     1448           end.
     1449         end.
     1450         assign
     1451           frame d-cfg-hist :height = frame d-cfg-hist :height + p-change-value
     1452           no-error .
     1453         if error-status :error
     1454         or error-status :get-message(1) <> ""
     1455         then do:
     1456           undo move_block, retry move_block .
     1457         end.
     1458         assign
     1459           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1460           no-error .
     1461         if error-status :error
     1462         or error-status :get-message(1) <> ""
     1463         then do:
     1464           undo move_block, retry move_block .
     1465         end.
     1466         for each buf_temp-browse-handle
     1467           where buf_temp-browse-handle.browse-type = 'height':u
     1468         on error undo move_block, retry move_block
     1469         :
     1470           assign
     1471             buf_temp-browse-handle.browse-handle :height
     1472               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1473             no-error .
     1474           if error-status :error
     1475           or error-status :get-message(1) <> ""
     1476           then do:
     1477             undo move_block, retry move_block .
     1478           end.
     1479         end.
     1480         for each buf_temp-diasize-handle
     1481         on error undo move_block, retry move_block
     1482         :
     1483           assign
     1484             v-object-handle = buf_temp-diasize-handle.handle-value
     1485           .
     1486           if v-object-handle <> v-diasize-resize-button
     1487           then do:
     1488             assign
     1489               v-object-handle :row = v-object-handle :row + p-change-value
     1490               no-error .
     1491             if error-status :error
     1492             or error-status :get-message(1) <> ""
     1493             then do:
     1494               undo move_block, retry move_block .
     1495             end.
     1496           end.
     1497         end.
     1498       end.
     1499       else do:
     1500         for each buf_temp-diasize-handle
     1501         on error undo move_block, retry move_block
     1502         :
     1503           assign
     1504             v-object-handle = buf_temp-diasize-handle.handle-value
     1505           .
     1506           if v-object-handle <> v-diasize-resize-button
     1507           then do:
     1508             assign
     1509               v-object-handle :row = v-object-handle :row + p-change-value
     1510               no-error .
     1511             if error-status :error
     1512             or error-status :get-message(1) <> ""
     1513             then do:
     1514               undo move_block, retry move_block .
     1515             end.
     1516           end.
     1517         end.
     1518         assign
     1519           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1520           no-error .
     1521         if error-status :error
     1522         or error-status :get-message(1) <> ""
     1523         then do:
     1524           undo move_block, retry move_block .
     1525         end.
     1526         for each buf_temp-browse-handle
     1527           where buf_temp-browse-handle.browse-type = 'height':u
     1528         on error undo move_block, retry move_block
     1529         :
     1530           assign
     1531             buf_temp-browse-handle.browse-handle :height
     1532               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1533             no-error .
     1534           if error-status :error
     1535           or error-status :get-message(1) <> ""
     1536           then do:
     1537             undo move_block, retry move_block .
     1538           end.
     1539         end.
     1540         assign
     1541           frame d-cfg-hist :height = frame d-cfg-hist :height + p-change-value
     1542           no-error .
     1543         if error-status :error
     1544         or error-status :get-message(1) <> ""
     1545         then do:
     1546           undo move_block, retry move_block .
     1547         end.
     1548         if frame d-cfg-hist :scrollable = true
     1549         then do:
     1550           assign
     1551             frame d-cfg-hist :virtual-height = frame d-cfg-hist :virtual-height + p-change-value
     1552             no-error .
     1553           if error-status :error
     1554           or error-status :get-message(1) <> ""
     1555           then do:
     1556             undo move_block, retry move_block .
     1557           end.
     1558         end.
     1559       end.
     1560       if p-move-resize = true
     1561       then do:
     1562         run diasize_position-resize-button in this-procedure .
     1563       end.
     1564       if v-diasize-wndstore = true
     1565       then do:
     1566         if connected("ub") = true
     1567         then do:
     1568           define variable v-cntxt-db-num        as integer   no-undo .
     1569           define variable v-cntxt-userid        as character no-undo .
     1570           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1571                                             , OUTPUT v-cntxt-userid
     1572                                             ) .
     1573           run gbl/wndsizew.p
     1574             (input  v-cntxt-db-num
     1575             ,input  v-cntxt-userid
     1576             ,input  v-diasize-proc-name
     1577             ,input  'height':u
     1578             ,input  string(frame d-cfg-hist :height - v-diasize-orig-frame-height)
     1579             ) .
     1580         end.
     1581       end.
     1582     end.
     1583     assign
     1584       v-diasize-change-size = false
     1585     .
     1586   end procedure.
     1587   procedure diasize_set-height :
     1588     define input  parameter p-new-height  as decimal   no-undo .
     1589     define input  parameter p-move-resize as logical   no-undo .
     1590     do
     1591     on error undo, return error return-value
     1592     :
     1593       run diasize_change-height in this-procedure
     1594         (input  (p-new-height - frame d-cfg-hist :height)
     1595         ,input  p-move-resize
     1596         ) .
     1597     end.
     1598   end procedure.
     1599   procedure diasize_change-width :
     1600     define input  parameter p-change-value as decimal   no-undo .
     1601     define input  parameter p-move-resize  as logical   no-undo .
     1602     define variable v-field-group-handle   as handle    no-undo .
     1603     define variable v-object-handle        as handle    no-undo .
     1604     define variable v-frame-width          as decimal   no-undo .
     1605     define variable v-frame-virtual-width  as decimal   no-undo .
     1606     define variable v-browse-width         as decimal   no-undo .
     1607     define variable v-window-width         as decimal   no-undo .
     1608     define variable v-window-virtual-width as decimal   no-undo .
     1609     define variable v-change-sign          as integer   no-undo .
     1610     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1611     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1612     if p-change-value > 0
     1613     then do:
     1614       if frame d-cfg-hist :width + p-change-value >
     1615           session :width-chars
     1616       then do:
     1617         assign
     1618           p-change-value = session :width-chars - frame d-cfg-hist :width
     1619         .
     1620         if p-change-value <= 0
     1621         then do:
     1622           run diasize_position-resize-button in this-procedure .
     1623           return .
     1624         end.
     1625       end.
     1626     end.
     1627     if p-change-value < 0
     1628     then do:
     1629       if frame d-cfg-hist :width + p-change-value < v-diasize-orig-frame-width
     1630       then do:
     1631         assign
     1632           p-change-value = v-diasize-orig-frame-width
     1633                          - frame d-cfg-hist :width
     1634         .
     1635         if p-change-value >= 0
     1636         then do:
     1637           run diasize_position-resize-button in this-procedure .
     1638           return .
     1639         end.
     1640       end.
     1641     end.
     1642     if p-change-value >= 0
     1643     then do:
     1644       assign
     1645         v-change-sign = 1
     1646       .
     1647     end.
     1648     else do:
     1649       assign
     1650         v-change-sign = -1
     1651       .
     1652     end.
     1653     assign
     1654       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1655     .
     1656     if p-change-value = 0
     1657     then do:
     1658       run diasize_position-resize-button in this-procedure .
     1659       return .
     1660     end.
     1661     move_block:
     1662     do
     1663     on error undo move_block, leave move_block
     1664     :
     1665       if retry
     1666       then do:
     1667         do
     1668         on error undo move_block, leave move_block
     1669         :
     1670           if p-change-value > 0
     1671           then do:
     1672             for each buf_temp-diasize-handle
     1673             on error undo, next
     1674             :
     1675               assign
     1676                 v-object-handle = buf_temp-diasize-handle.handle-value
     1677               .
     1678               if v-object-handle <> v-diasize-resize-button
     1679               then do:
     1680                 assign
     1681                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1682                 .
     1683               end.
     1684             end.
     1685             assign
     1686               v-diasize-browse-handle :width = v-browse-width
     1687             .
     1688             for each buf_temp-browse-handle
     1689               where buf_temp-browse-handle.browse-type = 'width':u
     1690             on error undo, next
     1691             :
     1692               assign
     1693                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1694               .
     1695             end.
     1696             assign
     1697               frame d-cfg-hist :width = v-frame-width
     1698             .
     1699             if frame d-cfg-hist :scrollable = true
     1700             then do:
     1701               assign
     1702                 frame d-cfg-hist :virtual-width = v-frame-virtual-width
     1703               .
     1704             end.
     1705             run diasize_position-resize-button in this-procedure .
     1706           end.
     1707           else do:
     1708             if frame d-cfg-hist :scrollable = true
     1709             then do:
     1710               assign
     1711                 frame d-cfg-hist :virtual-width = v-frame-virtual-width
     1712               .
     1713             end.
     1714             assign
     1715               frame d-cfg-hist :width = v-frame-width
     1716             .
     1717             for each buf_temp-browse-handle
     1718               where buf_temp-browse-handle.browse-type = 'width':u
     1719             on error undo, next
     1720             :
     1721               assign
     1722                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1723               .
     1724             end.
     1725             assign
     1726               v-diasize-browse-handle :width = v-browse-width
     1727             .
     1728             for each buf_temp-diasize-handle
     1729             on error undo, next
     1730             :
     1731               assign
     1732                 v-object-handle = buf_temp-diasize-handle.handle-value
     1733               .
     1734               if v-object-handle <> v-diasize-resize-button
     1735               then do:
     1736                 assign
     1737                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1738                 .
     1739               end.
     1740             end.
     1741             run diasize_position-resize-button in this-procedure .
     1742           end.
     1743           assign
     1744             v-diasize-change-size = false
     1745           .
     1746           leave move_block .
     1747         end.
     1748       end.
     1749       assign
     1750         v-diasize-need-full-display = true
     1751       .
     1752       if v-diasize-change-size = false
     1753       then do:
     1754         assign
     1755           v-diasize-change-size = true
     1756         .
     1757       end.
     1758       else do:
     1759         return .
     1760       end.
     1761       assign
     1762         v-frame-width = frame d-cfg-hist :width
     1763         v-frame-virtual-width = frame d-cfg-hist :virtual-width
     1764         v-browse-width = v-diasize-browse-handle :width
     1765       .
     1766       for each buf_temp-browse-handle
     1767         where buf_temp-browse-handle.browse-type = 'width':u
     1768       :
     1769         assign
     1770           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1771         .
     1772       end.
     1773       for each buf_temp-diasize-handle
     1774       :
     1775         delete buf_temp-diasize-handle .
     1776       end.
     1777       assign
     1778         v-field-group-handle = frame d-cfg-hist :first-child
     1779       .
     1780       do while valid-handle(v-field-group-handle)
     1781       :
     1782         assign
     1783           v-object-handle = v-field-group-handle :first-child
     1784         .
     1785         do while valid-handle(v-object-handle)
     1786         :
     1787           if  v-object-handle <> v-diasize-browse-handle :handle
     1788           and v-object-handle <> v-diasize-resize-button
     1789           and can-query(v-object-handle, "row")
     1790           and can-query(v-object-handle, "height")
     1791           and ( v-object-handle :col + v-object-handle :width
     1792                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1793               )
     1794           then do:
     1795             find first buf_temp-browse-handle
     1796               where buf_temp-browse-handle.browse-type   = 'width':u
     1797                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1798               no-error .
     1799             if available buf_temp-browse-handle
     1800             then do:
     1801             end.
     1802             else do:
     1803               create buf_temp-diasize-handle .
     1804               assign
     1805                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1806                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1807               .
     1808             end.
     1809           end.
     1810           assign
     1811             v-object-handle = v-object-handle :next-sibling
     1812           .
     1813         end.
     1814         assign
     1815           v-field-group-handle = v-field-group-handle :next-sibling
     1816         .
     1817       end.
     1818       do with frame d-cfg-hist
     1819       :
     1820         hide v-diasize-resize-button .
     1821         v-diasize-resize-button :row = 1.
     1822         v-diasize-resize-button :column = 1.
     1823       end.
     1824       if p-change-value > 0
     1825       then do:
     1826         if frame d-cfg-hist :scrollable = true
     1827         then do:
     1828           assign
     1829             frame d-cfg-hist :virtual-width = frame d-cfg-hist :virtual-width + p-change-value
     1830             no-error .
     1831           if error-status :error
     1832           or error-status :get-message(1) <> ""
     1833           then do:
     1834             undo move_block, retry move_block.
     1835           end.
     1836         end.
     1837         assign
     1838           frame d-cfg-hist :width = v-frame-width + p-change-value
     1839           no-error .
     1840         if error-status :error
     1841         or error-status :get-message(1) <> ""
     1842         then do:
     1843           undo move_block, retry move_block.
     1844         end.
     1845         assign
     1846           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1847         no-error .
     1848         if error-status :error
     1849         or error-status :get-message(1) <> ""
     1850         then do:
     1851           undo move_block, retry move_block.
     1852         end.
     1853         for each buf_temp-browse-handle
     1854           where buf_temp-browse-handle.browse-type = 'width':u
     1855         on error undo move_block, retry move_block
     1856         :
     1857           assign
     1858             buf_temp-browse-handle.browse-handle :width
     1859               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1860             no-error .
     1861           if error-status :error
     1862           or error-status :get-message(1) <> ""
     1863           then do:
     1864             undo move_block, retry move_block .
     1865           end.
     1866         end.
     1867         for each buf_temp-diasize-handle
     1868         on error undo move_block, retry move_block
     1869         :
     1870           assign
     1871             v-object-handle = buf_temp-diasize-handle.handle-value
     1872           .
     1873           if v-object-handle <> v-diasize-resize-button
     1874           then do:
     1875             assign
     1876               v-object-handle :col = v-object-handle :col + p-change-value
     1877               no-error .
     1878             if error-status :error
     1879             or error-status :get-message(1) <> ""
     1880             then do:
     1881               undo move_block, retry move_block .
     1882             end.
     1883           end.
     1884         end.
     1885       end.
     1886       else do:
     1887         for each buf_temp-diasize-handle
     1888         on error undo move_block, retry move_block
     1889         :
     1890           assign
     1891             v-object-handle = buf_temp-diasize-handle.handle-value
     1892           .
     1893           if v-object-handle <> v-diasize-resize-button
     1894           then do:
     1895             assign
     1896               v-object-handle :col = v-object-handle :col + p-change-value
     1897               no-error .
     1898             if error-status :error
     1899             or error-status :get-message(1) <> ""
     1900             then do:
     1901               undo move_block, retry move_block .
     1902             end.
     1903           end.
     1904         end.
     1905         for each buf_temp-browse-handle
     1906           where buf_temp-browse-handle.browse-type = 'width':u
     1907         on error undo move_block, retry move_block
     1908         :
     1909           assign
     1910             buf_temp-browse-handle.browse-handle :width
     1911               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1912             no-error .
     1913           if error-status :error
     1914           or error-status :get-message(1) <> ""
     1915           then do:
     1916             undo move_block, retry move_block .
     1917           end.
     1918         end.
     1919         assign
     1920           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1921           no-error .
     1922         if error-status :error
     1923         or error-status :get-message(1) <> ""
     1924         then do:
     1925           undo move_block, retry move_block.
     1926         end.
     1927         assign
     1928           frame d-cfg-hist :width = frame d-cfg-hist :width + p-change-value
     1929         no-error .
     1930         if error-status :error
     1931         or error-status :get-message(1) <> ""
     1932         then do:
     1933           undo move_block, retry move_block.
     1934         end.
     1935         if frame d-cfg-hist :scrollable = true
     1936         then do:
     1937           assign
     1938             frame d-cfg-hist :virtual-width = frame d-cfg-hist :virtual-width + p-change-value
     1939           no-error .
     1940           if error-status :error
     1941           or error-status :get-message(1) <> ""
     1942           then do:
     1943             undo move_block, retry move_block.
     1944           end.
     1945         end.
     1946       end.
     1947       if p-move-resize
     1948       then do:
     1949         run diasize_position-resize-button in this-procedure .
     1950       end.
     1951       if v-diasize-wndstore = true
     1952       then do:
     1953         if connected("ub") = true
     1954         then do:
     1955           define variable v-cntxt-db-num        as integer   no-undo .
     1956           define variable v-cntxt-userid        as character no-undo .
     1957           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1958                                             , OUTPUT v-cntxt-userid
     1959                                             ) .
     1960           run gbl/wndsizew.p
     1961             (input  v-cntxt-db-num
     1962             ,input  v-cntxt-userid
     1963             ,input  v-diasize-proc-name
     1964             ,input  'width':u
     1965             ,input  string(frame d-cfg-hist :width - v-diasize-orig-frame-width)
     1966             ) .
     1967         end.
     1968       end.
     1969     end.
     1970     assign
     1971       v-diasize-change-size = false
     1972     .
     1973   end procedure.
     1974   procedure diasize_set-width :
     1975     define input  parameter p-new-width  as decimal   no-undo .
     1976     define input  parameter p-move-resize as logical   no-undo .
     1977     do
     1978     on error undo, return error return-value
     1979     :
     1980       run diasize_change-width in this-procedure
     1981         (input  (p-new-width - frame d-cfg-hist :width)
     1982         ,input  p-move-resize
     1983         ) .
     1984     end.
     1985   end procedure.
     1986   procedure diasize_position-resize-button :
     1987     do with frame d-cfg-hist
     1988     :
     1989       hide v-diasize-resize-button .
     1990       assign
     1991         v-diasize-resize-button :row = frame d-cfg-hist :height - v-diasize-resize-button :height
     1992                     - 1
     1993                     - (frame d-cfg-hist :border-bottom-pixels / session :pixels-per-row)
     1994         v-diasize-resize-button :col = frame d-cfg-hist :width - v-diasize-resize-button :width
     1995                     - 1
     1996                     - (frame d-cfg-hist :border-right-pixels / session :pixels-per-column)
     1997       .
     1998       view v-diasize-resize-button .
     1999     end.
     2000   end procedure.
     2001   on alt-right anywhere
     2002   do:
     2003     run diasize_change-width in this-procedure
     2004       (input 1
     2005       ,input true
     2006       ) .
     2007     return no-apply .
     2008   end.
     2009   on alt-left anywhere
     2010   do:
     2011     run diasize_change-width in this-procedure
     2012       (input -1
     2013       ,input true
     2014       ) .
     2015     return no-apply .
     2016   end.
     2017   on alt-down anywhere
     2018   do:
     2019     run diasize_change-height in this-procedure
     2020       (input 1
     2021       ,input true
     2022       ) .
     2023     return no-apply .
     2024   end.
     2025   on alt-up anywhere
     2026   do:
     2027     run diasize_change-height in this-procedure
     2028       (input -1
     2029       ,input true
     2030       ) .
     2031     return no-apply .
     2032   end.
     2033   on alt-enter of frame d-cfg-hist
     2034   do:
     2035     run diasize_maximize in this-procedure
     2036       (input  ?
     2037       ).
     2038     return no-apply .
     2039   end.
     2040   procedure diasize_end-move :
     2041     do
     2042     on error undo, return error return-value
     2043     :
     2044       define variable v-row-delta as decimal   no-undo .
     2045       define variable v-col-delta as decimal   no-undo .
     2046       define variable v-new-row as decimal   no-undo .
     2047       define variable v-new-col as decimal   no-undo .
     2048       assign
     2049         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2050         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2051       .
     2052       assign
     2053         v-row-delta = v-new-row - frame d-cfg-hist :height
     2054         v-col-delta = v-new-col - frame d-cfg-hist :width
     2055       .
     2056       run diasize_change-height in this-procedure
     2057         (input v-row-delta
     2058         ,input true
     2059         ) .
     2060       run diasize_change-width in this-procedure
     2061         (input v-col-delta
     2062         ,input true
     2063         ) .
     2064     end.
     2065   end procedure.
     2066   procedure diasize_maximize :
     2067     define input  parameter p-action as logical   no-undo .
     2068     do
     2069     on error undo, return error return-value
     2070     :
     2071       if p-action = ?
     2072       then do:
     2073         if v-diasize-need-maximize = true
     2074         then do:
     2075           assign
     2076             p-action = true
     2077           .
     2078         end.
     2079         else do:
     2080           assign
     2081             p-action = false
     2082           .
     2083         end.
     2084       end.
     2085       if p-action = true
     2086       then do:
     2087         run diasize_change-height in this-procedure
     2088           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2089               - frame d-cfg-hist :height-chars
     2090           ,input true
     2091           ) .
     2092         run diasize_change-width in this-procedure
     2093           (input session :width-chars
     2094               - frame d-cfg-hist :width-chars
     2095           ,input true
     2096           ) .
     2097         assign
     2098           v-diasize-need-maximize = false
     2099         .
     2100       end.
     2101       else do:
     2102         run diasize_change-width in this-procedure
     2103           (input v-diasize-orig-frame-width
     2104               - frame d-cfg-hist :width-chars
     2105           ,input true
     2106           ) .
     2107         run diasize_change-height in this-procedure
     2108           (input v-diasize-orig-frame-height
     2109               - frame d-cfg-hist :height-chars
     2110           ,input true
     2111           ) .
     2112         assign
     2113           v-diasize-need-maximize = true
     2114         .
     2115       end.
     2116     end.
     2117   end procedure.
     2118   procedure diasize_restore-orig-size :
     2119     do
     2120     on error undo, return error return-value
     2121     :
     2122       assign
     2123         v-diasize-current-frame-width  = frame d-cfg-hist :width
     2124         v-diasize-current-frame-height = frame d-cfg-hist :height
     2125       .
     2126       run diasize_set-height in this-procedure
     2127         (input  v-diasize-orig-frame-height
     2128         ,input  true
     2129         ) .
     2130       run diasize_set-width in this-procedure
     2131         (input  v-diasize-orig-frame-width
     2132         ,input  true
     2133         ) .
     2134     end.
     2135   end procedure.
     2136   procedure diasize_restore-current-size :
     2137     do
     2138     on error undo, return error return-value
     2139     :
     2140       run diasize_set-height in this-procedure
     2141         (input  v-diasize-current-frame-height
     2142         ,input  true
     2143         ) .
     2144       run diasize_set-width in this-procedure
     2145         (input  v-diasize-current-frame-width
     2146         ,input  true
     2147         ) .
     2148     end.
     2149   end procedure.
     2150   procedure diasize_set-browse-handle :
     2151     define input  parameter p-browse-handle as handle   no-undo .
     2152     define buffer buf_temp-browse-handle for temp-browse-handle .
     2153     do
     2154     on error undo, return error return-value
     2155     :
     2156       assign
     2157         v-diasize-browse-handle = p-browse-handle
     2158       .
     2159       for each buf_temp-browse-handle
     2160       on error undo, return error return-value
     2161       :
     2162         delete buf_temp-browse-handle .
     2163       end.
     2164     end.
     2165   end procedure.
     2166   procedure diasize_add_browse :
     2167     define input  parameter p-browse-type   as character no-undo .
     2168     define input  parameter p-browse-handle as handle    no-undo .
     2169     define buffer buf_temp-browse-handle for temp-browse-handle .
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       assign
     2174         v-diasize-browse-number = v-diasize-browse-number + 1
     2175       .
     2176       create buf_temp-browse-handle .
     2177       assign
     2178         buf_temp-browse-handle.browse-type   = p-browse-type
     2179         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2180         buf_temp-browse-handle.browse-handle = p-browse-handle
     2181       .
     2182     end.
     2183   end procedure.
     2184   procedure diasize_init :
     2185     define variable v-default-value    as logical   no-undo .
     2186     define variable v-restore-saved    as logical   no-undo .
     2187     define variable v-resize-value-str as character no-undo .
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       do with frame d-cfg-hist
     2192       :
     2193         assign
     2194           v-diasize-orig-frame-height = frame d-cfg-hist :height
     2195           v-diasize-orig-frame-width  = frame d-cfg-hist :width
     2196           v-diasize-browse-handle     = browse br-cfg-hist :handle
     2197         .
     2198         create button v-diasize-resize-button
     2199         assign
     2200           parent        = frame d-cfg-hist :first-child
     2201           label         = "s"
     2202           height-pixels = 16
     2203           width-pixels  = 16
     2204           visible       = true
     2205           sensitive     = true
     2206           movable       = true
     2207           triggers:
     2208             on end-move persistent run diasize_end-move in this-procedure .
     2209           end triggers.
     2210         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2211         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2212         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2213         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2214         assign
     2215           v-diasize-wndmax = false
     2216         .
     2217         if connected("ub") = true
     2218         then do:
     2219           define variable v-cntxt-db-num        as integer   no-undo .
     2220           define variable v-cntxt-userid        as character no-undo .
     2221           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2222                                             , OUTPUT v-cntxt-userid
     2223                                             ) .
     2224           run gbl/wndpar_r.p
     2225             (input  v-cntxt-db-num
     2226             ,input  v-cntxt-userid
     2227             ,input  'wndmax':U
     2228             ,output v-diasize-wndmax
     2229             ,output v-default-value
     2230             ) .
     2231         end.
     2232         assign
     2233           v-diasize-wndstore = false
     2234         .
     2235         if connected("ub") = true
     2236         then do:
     2237           run gbl/wndpar_r.p
     2238             (input  v-cntxt-db-num
     2239             ,input  v-cntxt-userid
     2240             ,input  'wndstore':U
     2241             ,output v-diasize-wndstore
     2242             ,output v-default-value
     2243             ) .
     2244         end.
     2245         assign
     2246           v-diasize-proc-name = entry(1, program-name(2), '.')
     2247         .
     2248         if v-diasize-wndstore = true
     2249         then do:
     2250           assign
     2251             v-restore-saved = false
     2252           .
     2253           if connected("ub") = true
     2254           then do:
     2255             run gbl/wndsizer.p
     2256               (input  v-cntxt-db-num
     2257               ,input  v-cntxt-userid
     2258               ,input  v-diasize-proc-name
     2259               ,input  'height':u
     2260               ,output v-resize-value-str
     2261               ) .
     2262             if v-resize-value-str <> '':U
     2263             then do:
     2264               run diasize_change-height in this-procedure
     2265                 (input  integer(v-resize-value-str)
     2266                 ,input  true
     2267                 ) .
     2268               assign
     2269                 v-restore-saved = true
     2270               .
     2271             end.
     2272           end.
     2273           if connected("ub") = true
     2274           then do:
     2275             run gbl/wndsizer.p
     2276               (input  v-cntxt-db-num
     2277               ,input  v-cntxt-userid
     2278               ,input  v-diasize-proc-name
     2279               ,input  'width':u
     2280               ,output v-resize-value-str
     2281               ) .
     2282             if v-resize-value-str <> '':U
     2283             then do:
     2284               run diasize_change-width in this-procedure
     2285                 (input  integer(v-resize-value-str)
     2286                 ,input  true
     2287                 ) .
     2288               assign
     2289                 v-restore-saved = true
     2290               .
     2291             end.
     2292           end.
     2293           if v-restore-saved <> true
     2294           then do:
     2295             if v-diasize-wndmax = true
     2296             then do:
     2297               run diasize_maximize in this-procedure
     2298                 (input  true
     2299                 ) .
     2300             end.
     2301           end.
     2302         end.
     2303         else do:
     2304           if v-diasize-wndmax = true
     2305           then do:
     2306             run diasize_maximize in this-procedure
     2307               (input  true
     2308               ) .
     2309           end.
     2310         end.
     2311       end.
     2312     end.
     2313   end procedure.
     2314   procedure diasize_need-full-display :
     2315     define output parameter p-need-full-display as logical   no-undo .
     2316     do
     2317     on error undo, return error return-value
     2318     :
     2319       assign
     2320         p-need-full-display = v-diasize-need-full-display
     2321       .
     2322       assign
     2323         v-diasize-need-full-display = false
     2324       .
     2325     end.
     2326   end procedure.
     2327   procedure get-context :
     2328      define output parameter p-db-num as integer          no-undo.
     2329      define output parameter p-user-id as character        no-undo.
     2330      define variable v-login               as character    no-undo.
     2331      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2332      define buffer buf_user-login  for ub.user-login .
     2333      do
     2334      on error undo, return error
     2335      :
     2336            FIND FIRST buf_sys-ctrl no-lock.
     2337            ASSIGN
     2338               v-login = USERID("ub")
     2339               p-db-num = buf_sys-ctrl.db-num
     2340            .
     2341            FIND FIRST buf_user-login
     2342                 WHERE buf_user-login.db-num = p-db-num
     2343                   AND buf_user-login.user-login = v-login
     2344                 no-lock
     2345                 no-error
     2346                 .
     2347            IF AVAILABLE buf_user-login
     2348            THEN DO:
     2349               assign
     2350                  p-user-id = buf_user-login.user-id
     2351               .
     2352            END.
     2353      end.
     2354   end procedure.
     2355       run diasize_init in this-procedure .
     2356   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2357   do:
     2358     br-cfg-hist :SET-REPOSITIONED-ROW(8, "CONDITIONAL") .
     2359   end.
     2360   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2361   on f5 of frame d-cfg-hist anywhere
     2362   do:
     2363     run my-open-query in this-procedure ( input yes, input no, input no ) .
     2364       apply "VALUE-CHANGED" to br-cfg-hist.
     2365   end.
     2366   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2367   DEF VAR cur-clmn-numbr-cfg-hist as INT EXTENT 11 no-undo.
     2368   DEF VAR varmvibr-cfg-hist       as INT no-undo.
     2369   DEF VAR varmvjbr-cfg-hist       as INT no-undo.
     2370   DEF VAR varmvkbr-cfg-hist       as INT no-undo.
     2371   DEF VAR varmvlbr-cfg-hist       as INT no-undo.
     2372   DEF VAR move-elementbr-cfg-hist as INT no-undo.
     2373   def var jjbr-cfg-hist           as int no-undo.
     2374   do varmvibr-cfg-hist = 1 to EXTENT(cur-clmn-numbr-cfg-hist):
     2375     ASSIGN cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = varmvibr-cfg-hist.
     2376   END.
     2377   RUN start-mv-clmnbr-cfg-hist.
     2378   PROCEDURE start-mv-clmnbr-cfg-hist:
     2379   def var old-session as logical no-undo.
     2380      old-session = SESSION:IMMEDIATE-DISPLAY.
     2381      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2382      SESSION:IMMEDIATE-DISPLAY = old-session.
     2383   END.
     2384   ON ctrl-cursor-right OF BROWSE br-cfg-hist do:
     2385     RUN re-move-clmnbr-cfg-hist ( 1, 11).
     2386   END.
     2387   ON ctrl-cursor-left OF BROWSE br-cfg-hist do:
     2388     RUN re-move-clmnbr-cfg-hist (11, 1).
     2389   END.
     2390   PROCEDURE re-move-clmnbr-cfg-hist:
     2391     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2392     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2393     DO varmvibr-cfg-hist = 1 TO EXTENT(cur-clmn-numbr-cfg-hist):
     2394       if cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = source-column THEN cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = -1.
     2395     END.
     2396     if br-cfg-hist:MOVE-COLUMN(source-column, target-column) IN FRAME d-cfg-hist then.
     2397     if source-column > target-column THEN
     2398     DO varmvjbr-cfg-hist = source-column - 1 to target-column BY -1:
     2399       DO varmvibr-cfg-hist = 1 TO EXTENT(cur-clmn-numbr-cfg-hist):
     2400           if cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = varmvjbr-cfg-hist THEN DO:
     2401             cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] + 1.
     2402           END.
     2403       END.
     2404     END.
     2405     ELSE
     2406     DO varmvjbr-cfg-hist = source-column + 1 to target-column:
     2407       DO varmvibr-cfg-hist = 1 TO EXTENT(cur-clmn-numbr-cfg-hist):
     2408         if cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = varmvjbr-cfg-hist THEN DO:
     2409           cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] - 1.
     2410         END.
     2411       END.
     2412     END.
     2413     DO varmvibr-cfg-hist = 1 TO EXTENT(cur-clmn-numbr-cfg-hist):
     2414       if cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = -1 THEN cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = target-column.
     2415     END.
     2416   END PROCEDURE.
     2417   PROCEDURE ch-clmnbr-cfg-hist:
     2418     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2419     if cur-clmn-loc <= 1 then do:
     2420       return .
     2421     end.
     2422     DO varmvibr-cfg-hist = 1 TO EXTENT(cur-clmn-numbr-cfg-hist):
     2423       if cur-clmn-numbr-cfg-hist[varmvibr-cfg-hist] = cur-clmn-loc THEN move-elementbr-cfg-hist = varmvibr-cfg-hist.
     2424     END.
     2425     RUN re-move-clmnbr-cfg-hist (cur-clmn-loc, 1).
     2426   END PROCEDURE.
     2427   PROCEDURE mv-brw-defaultbr-cfg-hist:
     2428   def var old-session as logical no-undo.
     2429     old-session = SESSION:IMMEDIATE-DISPLAY.
     2430     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2431     do varmvlbr-cfg-hist = 1 to EXTENT(cur-clmn-numbr-cfg-hist):
     2432       RUN re-move-clmnbr-cfg-hist (cur-clmn-numbr-cfg-hist[varmvlbr-cfg-hist], varmvlbr-cfg-hist).
     2433     END.
     2434     RUN start-mv-clmnbr-cfg-hist.
     2435     SESSION:IMMEDIATE-DISPLAY = old-session.
     2436   END PROCEDURE.
     2437   .
     2438   def var sort-labelbr-cfg-hist   as character no-undo .
     2439   def var sort-clmnbr-cfg-hist    as handle    no-undo .
     2440   def var cur-clmnbr-cfg-hist     as handle    no-undo .
     2441   def var cur-clmn-locbr-cfg-hist as integer   no-undo .
     2442   def var re-querybr-cfg-hist     as logical   initial no no-undo .
     2443   on start-search, ctrl-o of br-cfg-hist in frame d-cfg-hist do:
     2444      run sort-brbr-cfg-hist
     2445        (input (if available X_c-config
     2446                then recid(X_c-config)
     2447                else ?
     2448               )
     2449        ).
     2450   end.
     2451   PROCEDURE sort-brbr-cfg-hist :
     2452     define input parameter p-recid as recid no-undo .
     2453     if re-querybr-cfg-hist = no then do:
     2454       assign
     2455          cur-clmnbr-cfg-hist = br-cfg-hist:current-column in frame d-cfg-hist
     2456       .
     2457       if sort-clmnbr-cfg-hist <> ? then sort-clmnbr-cfg-hist:column-fgcolor = 0.
     2458       if cur-clmnbr-cfg-hist = sort-clmnbr-cfg-hist then do:
     2459         assign
     2460            sort-labelbr-cfg-hist = ""
     2461            sort-clmnbr-cfg-hist = ?
     2462         .
     2463        end.
     2464        else do:
     2465          assign
     2466            sort-labelbr-cfg-hist = cur-clmnbr-cfg-hist:label
     2467            sort-clmnbr-cfg-hist  = cur-clmnbr-cfg-hist
     2468            sort-clmnbr-cfg-hist:column-fgcolor = 4
     2469          .
     2470        end.
     2471      end.
     2472     assign
     2473       cur-clmn-locbr-cfg-hist = 1
     2474     .
     2475     def var column-handle as handle no-undo .
     2476     column-handle = br-cfg-hist:first-column.
     2477     do while valid-handle(column-handle) :
     2478       if column-handle = cur-clmnbr-cfg-hist then do:
     2479         leave .
     2480       end.
     2481       column-handle = column-handle:NEXT-COLUMN.
     2482       assign
     2483         cur-clmn-locbr-cfg-hist = cur-clmn-locbr-cfg-hist + 1
     2484       .
     2485     end.
     2486     case sort-labelbr-cfg-hist:
     2487           when X_c-config.corr-user-db-num:label in browse br-cfg-hist then DO:    assign       v-sort-column-name = "X_c-config.corr-user-db-num"     .     run my-open-query in this-procedure ( input yes, input no, input no ) .   . END.
     2488           when X_c-config.corr-date:label in browse br-cfg-hist then DO:    assign       v-sort-column-name = "X_c-config.corr-date"     .     run my-open-query in this-procedure ( input yes, input no, input no ) .   . END.
     2489           when X_c-config.param-code:label in browse br-cfg-hist then DO:    assign       v-sort-column-name = "X_c-config.param-code"     .     run my-open-query in this-procedure ( input yes, input no, input no ) .   . END.
     2490       otherwise do:
     2491         assign
     2492           v-sort-column-name = ""
     2493         .
     2494         run my-open-query in this-procedure ( input yes, input no, input no ) .
     2495           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cfg-hist') then do:
     2496             run mv-brw-defaultbr-cfg-hist.
     2497           end.
     2498         if sort-labelbr-cfg-hist <> "" then do:
     2499           assign
     2500             cur-clmnbr-cfg-hist:column-fgcolor = 0
     2501           .
     2502         end.
     2503         assign
     2504           cur-clmn-locbr-cfg-hist = ?
     2505         .
     2506       end.
     2507     end case.
     2508       if cur-clmn-locbr-cfg-hist <> ? then do:
     2509         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cfg-hist') then do:
     2510           run ch-clmnbr-cfg-hist in this-procedure (cur-clmn-locbr-cfg-hist).
     2511         end.
     2512       end.
     2513     if p-recid <> ? then do:
     2514       reposition br-cfg-hist to recid p-recid no-error.
     2515       apply "value-changed" to br-cfg-hist in frame d-cfg-hist.
     2516     end.
     2517     apply "entry" to br-cfg-hist in frame d-cfg-hist.
     2518   END PROCEDURE.
     2519   procedure re-open-query-srt-clmnbr-cfg-hist:
     2520   if cur-clmnbr-cfg-hist = ? then do:
     2521      run my-open-query in this-procedure ( input yes, input no, input no ) .
     2522   end.
     2523   else do:
     2524      assign re-querybr-cfg-hist = yes.
     2525      run sort-brbr-cfg-hist
     2526        (input (if available X_c-config
     2527                then recid(X_c-config)
     2528                else ?
     2529               )
     2530        ).
     2531      assign re-querybr-cfg-hist = no.
     2532   end.
     2533   end.
     2534   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2535   procedure set-filter-name :
     2536   define input parameter p-filter-name as character no-undo .
     2537     do with frame d-cfg-hist:
     2538       if p-filter-name > "" then do:
     2539         assign
     2540           frame d-cfg-hist:title
     2541             = frame d-cfg-hist:title + "   ФИЛЬТР: " + p-filter-name.
     2542         .
     2543         assign
     2544           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2545         .
     2546       end.
     2547       else do:
     2548         assign
     2549           b-sch :tooltip = ""
     2550         .
     2551       end.
     2552     end.
     2553   end procedure.
     2554   MAIN-BLOCK:
     2555   DO
     2556   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2557   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2558   :
     2559     RUN enable_UI.
     2560     assign
     2561       temp-changes.l_name:resizable in browse br-changes = true
     2562       temp-changes.v_old:resizable in browse br-changes = true
     2563       temp-changes.v_new:resizable in browse br-changes = true
     2564       temp-changes.l_name:width in browse br-changes = 33
     2565       temp-changes.v_old:width in browse br-changes = 30
     2566       temp-changes.v_new:width in browse br-changes = 30
     2567     .
     2568     run my-open-query in this-procedure ( input yes, input no, input no) .
     2569     wait-for go of frame d-cfg-hist.
     2570   end.
     2571   RUN disable_UI.
     2572   PROCEDURE disable_UI :
     2573     HIDE FRAME d-cfg-hist.
     2574   END PROCEDURE.
     2575   PROCEDURE enable_UI :
     2576     ENABLE b-quit b-sch b-help br-cfg-hist BR-changes
     2577         WITH FRAME d-cfg-hist.
     2578   END PROCEDURE.
     2579   PROCEDURE my-open-query :
     2580     define input  parameter p-open-query     as logical   no-undo .
     2581     define input  parameter p-find-next      as logical   no-undo .
     2582     define input  parameter p-find-condition as character no-undo .
     2583     define variable l-query-was-opened as logical no-undo .
     2584     define variable v-sort-column-phrase as character no-undo .
     2585     if available X_c-config then do:
     2586       assign
     2587         v-hist-rec = recid( X_c-config )
     2588       .
     2589     end.
     2590     run waitfram-show in this-procedure ( input "Ждите...").
     2591     case v-sort-column-name :
     2592       when "" then do:
     2593         assign
     2594           v-sort-column-phrase = "by X_c-config.corr-date by X_c-config.corr-time by X_c-config.corr-user-db-num by X_c-config.chip-num":U
     2595         .
     2596       end.
     2597       otherwise do:
     2598         assign
     2599           v-sort-column-phrase = substitute( "by &1", v-sort-column-name )
     2600         .
     2601       end.
     2602     end case.
     2603     if available buf_cnf then do:
     2604       if buf_cnf.NotUsed = true then do:
     2605         assign
     2606           v-filter-point = v-filter-point0 + "cnf-not-used":U + chr(4) + v-filter-pointr
     2607           frame d-cfg-hist:title = substitute( "История изменения выключенного параметра &1 по БД &2 ", buf_cnf.param-code, buf_cnf.db-num )
     2608         .
     2609   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2610   define variable  l-disable-where-16  as logical   no-undo .
     2611   define variable  l-filter-open-16    as logical   .
     2612   define variable  flt-rec-16       as recid     no-undo .
     2613   define variable  filter-name-16      as character no-undo .
     2614   define variable  where-phrase-16     as character no-undo .
     2615   define variable  sort-phrase-16      as character no-undo .
     2616   define variable  where-phrase-rus-16 as character no-undo .
     2617   define variable  sort-phrase-rus-16  as character no-undo .
     2618     run waitfram-show in this-procedure
     2619       (input "ЖДИТЕ ..."
     2620       ).
     2621   run gbl/flt-get.p
     2622     (input v-filter-point
     2623     ,output flt-rec-16
     2624     ,output filter-name-16
     2625     ,output where-phrase-16
     2626     ,output sort-phrase-16
     2627     ,output where-phrase-rus-16
     2628     ,output sort-phrase-rus-16
     2629     ).
     2630   if p-open-query then do:
     2631       run set-filter-name in this-procedure
     2632         (INPUT filter-name-16
     2633         ) no-error .
     2634     assign
     2635       l-filter-open-16 = false
     2636     .
     2637     if flt-rec-16 <> ?
     2638       or v-sort-column-phrase > ""
     2639     then do:
     2640       define variable  parameter-2-16 as character no-undo .
     2641       define variable  parameter-3-16 as character no-undo .
     2642       define variable  parameter-4-16 as character no-undo .
     2643       define variable  parameter-5-16 as character no-undo .
     2644       define variable  parameter-6-16 as character no-undo .
     2645       define variable  parameter-7-16 as character no-undo .
     2646         assign
     2647         parameter-3-16 =
     2648                                 "FOR EACH X_c-config"
     2649         parameter-4-16 =
     2650           (
     2651             if ("X_c-config.conf-type = buf_cnf.conf-type and X_c-config.param-code = buf_cnf.param-code and X_c-config.db-num = buf_cnf.db-num" + " " + where-phrase-16) <> ""
     2652             then substitute('X_c-config.conf-type = &1&2&1 and X_c-config.param-code = &1&3&1 and X_c-config.db-num = &4'                                       ,chr(34), buf_cnf.conf-type, buf_cnf.param-code, buf_cnf.db-num                                      )                            + " " + where-phrase-16
     2653             else "true"
     2654           )
     2655         parameter-5-16 = (" " + "" + " " + "")
     2656         parameter-6-16 = if sort-phrase-16 = ''
     2657                              then
     2658           (
     2659           " " + " " +
     2660             " " + v-sort-column-phrase +
     2661           " " + " "
     2662           )
     2663                              else
     2664           (
     2665           " " + " " +
     2666             " " + v-sort-column-phrase +
     2667           " " + sort-phrase-16
     2668           )
     2669         parameter-7-16 =
     2670           " indexed-reposition  "
     2671       .
     2672       do
     2673       on stop undo, leave
     2674       on error undo, leave
     2675       :
     2676         assign
     2677           l-disable-where-16 =
     2678             ("X_c-config.conf-type = buf_cnf.conf-type and X_c-config.param-code = buf_cnf.param-code and X_c-config.db-num = buf_cnf.db-num" + " " + where-phrase-16 = "")
     2679         .
     2680         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2681                             ,input query br-cfg-hist :handle
     2682                             ,input parameter-3-16
     2683                             ,input parameter-4-16
     2684                             ,input parameter-5-16
     2685                             ,input parameter-6-16
     2686                             ,input parameter-7-16
     2687                             )
     2688         .
     2689         assign
     2690           l-filter-open-16 = true
     2691         .
     2692       end.
     2693       if l-filter-open-16 = false then do:
     2694         message
     2695           "Ошибка при фильтрации / сортировке" skip
     2696           "Будут показаны записи без учета фильтра" skip
     2697           view-as alert-box .
     2698       end.
     2699       else do:
