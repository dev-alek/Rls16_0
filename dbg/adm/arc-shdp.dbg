        1   define input  parameter p-cre-db-num as integer   no-undo .
        2   define input  parameter p-task-type  as character no-undo .
        3   define input  parameter p-task-num   as integer   no-undo .
        4   define output parameter p-cancel     as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Выбор параметров для авторасчета архивов".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   procedure cur-time :
      118      define output parameter p-today as date      no-undo .
      119      define output parameter p-time  as integer   no-undo .
      120     do
      121     on error undo, return error
      122     :
      123       define variable v-date1 as date      no-undo .
      124       define variable v-date2 as date      no-undo .
      125       define variable v-time  as integer   no-undo .
      126       assign
      127         v-date1 = today
      128         v-time  = time
      129         v-date2 = today
      130       .
      131       if v-date1 <> v-date2
      132       then do:
      133         assign
      134           v-date1 = today
      135           v-time  = v-time
      136         .
      137       end.
      138       assign
      139         p-today = v-date1
      140         p-time  = v-time
      141       .
      142     end.
      143   end.
      144   function cur-time-date returns character
      145   :
      146     return string(today, '99/99/9999':U) .
      147   end.
      148   function cur-time-mjd returns decimal
      149   :
      150     define variable v-date as date      no-undo .
      151     define variable v-time as integer   no-undo .
      152     run cur-time in this-procedure
      153       (output v-date
      154       ,output v-time
      155       ) .
      156     return integer(v-date) - 2400002 + (v-time / 86400) .
      157   end.
      158   function cur-time-get-ending-index returns integer
      159   (input p-number as integer
      160   )
      161   :
      162     if p-number < 0
      163     or p-number = ?
      164     then do:
      165       return 1 .
      166     end.
      167     define variable v-rest as integer   no-undo .
      168     assign
      169       p-number = p-number modulo 100
      170     .
      171     if p-number < 20
      172     then do:
      173       assign
      174         v-rest = p-number
      175       .
      176     end.
      177     else do:
      178       assign
      179         v-rest = p-number modulo 10
      180       .
      181     end.
      182     case v-rest :
      183       when 1
      184       then do:
      185         return 2 .
      186       end.
      187       when 2 or
      188       when 3 or
      189       when 4
      190       then do:
      191         return 3 .
      192       end.
      193       otherwise do:
      194         return 1 .
      195       end.
      196     end case .
      197   end.
      198   procedure cur-time-mjd-to-date :
      199      define input  parameter i-mjd-diff as decimal no-undo.
      200      define output parameter o-Date     as date    no-undo.
      201      define output parameter o-Time     as integer no-undo.
      202      define variable v-day-number as integer   no-undo .
      203      if    i-mjd-diff < 0
      204         or i-mjd-diff = ?
      205      then do:
      206         return "?" .
      207      end.
      208      assign
      209         v-day-number = truncate(i-mjd-diff,0).
      210         o-Date = date(v-day-number + 2400002).
      211         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      212     .
      213   end.
      214   function cur-time-mjd-to-string returns character
      215   (input p-mjd-diff as decimal
      216   )
      217   :
      218     define variable v-day-number as integer   no-undo .
      219     define variable v-seconds    as integer   no-undo .
      220     define variable v-hour       as integer   no-undo .
      221     define variable v-min        as integer   no-undo .
      222     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      223     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      224     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      225     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      226     if p-mjd-diff < 0
      227     or p-mjd-diff = ?
      228     then do:
      229       return "?" .
      230     end.
      231     assign
      232       v-day-number = integer(truncate(p-mjd-diff,0))
      233       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      234     .
      235     if v-seconds > 86400
      236     then do:
      237       assign
      238         v-seconds = 86400 - 1
      239       .
      240     end.
      241     if v-seconds < 0
      242     then do:
      243       assign
      244         v-seconds = 0
      245       .
      246     end.
      247     assign
      248       v-hour = truncate(v-seconds / 3600, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 3600
      252     .
      253     assign
      254       v-min = truncate(v-seconds / 60, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 60
      258     .
      259     return
      260         (if v-day-number <> 0
      261           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      262           else ""
      263         )
      264       + (if v-day-number <> 0 or v-hour <> 0
      265           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      266           else ""
      267         )
      268       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      269           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      270           else ""
      271         )
      272       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      273       .
      274   end.
      275   function cur-time-string returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-string-sec returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      294   end.
      295   function cur-time-custom  returns character
      296   (input p-prefix as character
      297   ,input p-date-format as character
      298   ,input p-delimiter as character
      299   ,input p-time-format as character
      300   ,input p-suffix as character
      301   )
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return
      310       p-prefix
      311       + string(v-date, p-date-format)
      312       + p-delimiter
      313       + string(v-time, p-time-format)
      314       + p-suffix
      315       .
      316   end.
      317   function cur-time-print  returns character
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      326   end.
      327   function cur-time-datetime returns datetime
      328   :
      329     define variable v-char as character no-undo .
      330     define variable v-datetime as datetime no-undo .
      331     v-char = cur-time-string().
      332     v-datetime = datetime(v-char).
      333     return  v-datetime.
      334   end.
      335   function cur-time-string-msec returns character
      336   :
      337     define variable v-date as datetime  no-undo .
      338     v-date = now.
      339     return string(v-date) .
      340   end.
      341   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   define temp-table temp-schedule-free no-undo
      343   field free-id as character
      344   field free-task-name as character
      345   field proc-run-name as character
      346   field proc-param-edit-name as character
      347   field conf-param as character
      348   field is-gbd as logical
      349   field is-ubd as logical
      350   field enable-concurrent-0 as logical
      351   field enable-concurrent-db as logical
      352   field other-info as character
      353   field enc-key as character
      354   field is-rum as logical
      355   index pi is unique primary
      356   free-id.
      357   procedure schedule-attr-name :
      358   do
      359     on error undo, return error
      360     :
      361     define input  parameter p-code           as character no-undo .
      362     define output parameter p-type           as character no-undo .
      363     define output parameter p-format         as character no-undo .
      364     define output parameter p-label          as character no-undo .
      365     define output parameter p-user-can-edit  as logical   no-undo .
      366     define output parameter p-output-display as logical   no-undo .
      367     define output parameter p-other          as character no-undo .
      368       if index(p-code, chr(4)) > 0 then do:
      369         p-code = entry(1, p-code, chr(4)).
      370       end.
      371       case p-code :
      372               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      373               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      374               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      375               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      376               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      377               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      378               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      379               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      380               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      381         otherwise do:
      382           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      383         end.
      384       end.
      385     end.
      386   end procedure.
      387   procedure schedule-attr-tooltip :
      388   do
      389     on error undo, return error
      390     :
      391       define input  parameter p-code    as character no-undo .
      392       define output parameter p-tooltip as character no-undo .
      393       define output parameter p-label   as character no-undo .
      394       if index(p-code, chr(4)) > 0 then do:
      395         p-code = entry(1, p-code, chr(4)).
      396       end.
      397       case p-code :
      398               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      399               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      400               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      401               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      402               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      403               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      404               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      405               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      406               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      407         otherwise do:
      408               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      409         end.
      410       end.
      411     end.
      412   end procedure.
      413   procedure schedule-attr-value :
      414   do
      415   on error undo, return error return-value
      416   :
      417   define input parameter  p-cre-db-num as integer    no-undo.
      418   define input parameter  p-task-type  as character  no-undo.
      419   define input parameter  p-task-num   as integer    no-undo.
      420   define input parameter  p-code       as character  no-undo.
      421   define output parameter p-value      as character  no-undo.
      422   define output parameter p-type       as character  no-undo.
      423       define variable v-format         as character no-undo .
      424       define variable v-label          as character no-undo .
      425       define variable v-user-can-edit  as logical   no-undo .
      426       define variable v-output-display as logical   no-undo .
      427       define variable v-other          as character no-undo .
      428       define buffer buf_schedule-attr for ub.schedule-attr.
      429       run schedule-attr-name in this-procedure (
      430             input  p-code
      431           , output p-type
      432           , output v-format
      433           , output v-label
      434           , output v-user-can-edit
      435           , output v-output-display
      436           , output v-other
      437       ) no-error .
      438       if error-status :error
      439       then do:
      440           undo, return error return-value .
      441       end.
      442       if p-code begins ('schd-free-id':U + chr(4))
      443       and entry(2, p-code, chr(4)) = '':U then do:
      444         find first buf_schedule-attr no-lock
      445             where buf_schedule-attr.cre-db-num = p-cre-db-num
      446               and buf_schedule-attr.task-type  = p-task-type
      447               and buf_schedule-attr.task-num   = p-task-num
      448               and buf_schedule-attr.attr-code  begins p-code
      449         no-error .
      450       end.
      451       else do:
      452         find first buf_schedule-attr no-lock
      453             where buf_schedule-attr.cre-db-num = p-cre-db-num
      454               and buf_schedule-attr.task-type  = p-task-type
      455               and buf_schedule-attr.task-num   = p-task-num
      456               and buf_schedule-attr.attr-code  = p-code
      457         no-error .
      458       end.
      459       if available buf_schedule-attr
      460       then do:
      461           assign
      462               p-value = buf_schedule-attr.attr-value
      463           .
      464       end.
      465       else do:
      466         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      467            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      468         end.
      469         else do:
      470           assign
      471               p-value = if p-type = 'L':U then "no":U else ""
      472           .
      473         end.
      474       end.
      475   end.
      476   end procedure.
      477   procedure schedule-attr-write :
      478   do
      479   on error undo, return error
      480   :
      481   define input parameter p-cre-db-num  as integer   no-undo.
      482   define input parameter p-task-type   as character no-undo.
      483   define input parameter p-task-num    as integer   no-undo.
      484   define input parameter p-code        as character no-undo.
      485   define input parameter p-value       as character no-undo.
      486       define variable v-type              as character                no-undo.
      487       define variable v-format            as character                no-undo.
      488       define variable v-label             as character                no-undo.
      489       define variable v-user-can-edit     as logical                  no-undo.
      490       define variable v-output-display    as logical                  no-undo.
      491       define variable v-other             as character                no-undo.
      492       define buffer buf_schedule-attr for ub.schedule-attr .
      493       run schedule-attr-name in this-procedure (
      494             input  p-code
      495           , output v-type
      496           , output v-format
      497           , output v-label
      498           , output v-user-can-edit
      499           , output v-output-display
      500           , output v-other
      501       ) no-error.
      502       if error-status :error
      503       then do:
      504           undo, return error return-value.
      505       end.
      506       find first buf_schedule-attr exclusive-lock
      507            where buf_schedule-attr.cre-db-num = p-cre-db-num
      508              and buf_schedule-attr.task-type  = p-task-type
      509              and buf_schedule-attr.task-num   = p-task-num
      510              and buf_schedule-attr.attr-code  = p-code
      511       no-error.
      512       if not available buf_schedule-attr
      513       then do:
      514           create buf_schedule-attr.
      515           assign
      516             buf_schedule-attr.cre-db-num = p-cre-db-num
      517             buf_schedule-attr.task-type  = p-task-type
      518             buf_schedule-attr.task-num   = p-task-num
      519             buf_schedule-attr.attr-code  = p-code
      520             buf_schedule-attr.attr-value = p-value
      521           .
      522       end.
      523       else do:
      524           assign
      525               buf_schedule-attr.attr-value = p-value
      526           .
      527       end.
      528   end.
      529   end procedure.
      530   procedure schedule-attr-delete :
      531   do
      532   on error undo, return error
      533   :
      534   define input  parameter p-cre-db-num  as integer   no-undo.
      535   define input  parameter p-task-type   as character no-undo.
      536   define input  parameter p-task-num    as integer   no-undo.
      537   define input  parameter p-code        as character no-undo.
      538   define output parameter p-deleted     as logical   no-undo.
      539       define buffer buf_schedule-attr for ub.schedule-attr .
      540       define variable v-type              as character                no-undo.
      541       define variable v-format            as character                no-undo.
      542       define variable v-label             as character                no-undo.
      543       define variable v-user-can-edit     as logical                  no-undo.
      544       define variable v-output-display    as logical                  no-undo.
      545       define variable v-other             as character                no-undo.
      546       run schedule-attr-name in this-procedure (
      547             input p-code
      548           , output v-type
      549           , output v-format
      550           , output v-label
      551           , output v-user-can-edit
      552           , output v-output-display
      553           , output v-other
      554       ) no-error .
      555       if error-status :error
      556       then do:
      557           undo, return error return-value .
      558       end.
      559       find first buf_schedule-attr exclusive-lock
      560            where buf_schedule-attr.cre-db-num = p-cre-db-num
      561              and buf_schedule-attr.task-type  = p-task-type
      562              and buf_schedule-attr.task-num   = p-task-num
      563              and buf_schedule-attr.attr-code  = p-code
      564       no-error.
      565       if not available buf_schedule-attr
      566       then do:
      567           assign
      568               p-deleted = no
      569           .
      570       end.
      571       else do:
      572           delete buf_schedule-attr.
      573           assign
      574               p-deleted = yes
      575           .
      576       end.
      577   end.
      578   end procedure.
      579   procedure schedule-attr-news :
      580   do
      581   on error undo, return error
      582   :
      583       define input  parameter p-code           as character no-undo .
      584       define output parameter p-news           as logical   no-undo .
      585       if index(p-code, chr(4)) > 0 then do:
      586         p-code = entry(1, p-code, chr(4)).
      587       end.
      588       case p-code :
      589               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      590               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      591               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      592               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      593               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      594               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      595               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      596               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      597               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      598         otherwise do:
      599           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      600         end.
      601       end.
      602   end.
      603   end procedure.
      604   procedure schedule-attr-extract-logical :
      605   do
      606   on error undo, return error
      607   :
      608   define input  parameter p-parameter-number   as integer      no-undo.
      609   define input  parameter p-parameter-list     as character    no-undo.
      610   define output parameter p-parameter-value   as logical      no-undo.
      611       if num-entries( p-parameter-list ) > p-parameter-number - 1
      612       then do:
      613           assign
      614               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      615           .
      616       end.
      617       else do:
      618           assign
      619               p-parameter-value   = no
      620           .
      621       end.
      622   end.
      623   end procedure.
      624   procedure schedule-attr-get-free-id :
      625   do
      626   on error undo, return error return-value
      627   :
      628     define input  parameter p-cre-db-num  as integer   no-undo.
      629     define input  parameter p-task-type   as character no-undo.
      630     define input  parameter p-task-num    as integer   no-undo.
      631     define output parameter p-free-id     as character no-undo.
      632     define buffer buf_schedule-attr for ub.schedule-attr.
      633     find first buf_schedule-attr no-lock
      634         where buf_schedule-attr.cre-db-num = p-cre-db-num
      635           and buf_schedule-attr.task-type  = p-task-type
      636           and buf_schedule-attr.task-num   = p-task-num
      637           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      638     no-error .
      639     if available buf_schedule-attr then
      640     assign
      641     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      642     no-error
      643     .
      644   end.
      645   end procedure.
      646   procedure schedule-attr-get-free-props :
      647     define input parameter p-free-id as character no-undo .
      648     define output parameter p-value as character no-undo .
      649     define buffer buf_temp-schedule-free for temp-schedule-free.
      650     do
      651     on error undo, return error return-value
      652     :
      653       find first buf_temp-schedule-free no-lock no-error .
      654       if not available buf_temp-schedule-free then do:
      655         run schedule-attr-fill-free-props in this-procedure .
      656       end.
      657       find first buf_temp-schedule-free where
      658               buf_temp-schedule-free.free-id = p-free-id no-error.
      659       if available buf_temp-schedule-free then do:
      660         assign
      661         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      662                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      663                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      664                   buf_temp-schedule-free.conf-param           + chr(4) +
      665                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      666                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      667                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      668                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      669                   buf_temp-schedule-free.other-info
      670         .
      671       end.
      672       else do:
      673        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      674                              "id произвольной задачи - &5"
      675                              ,vss-workfile
      676                              ,vss-revision
      677                              ,vss-description
      678                              ,chr(10)
      679                              ,p-free-id).
      680       end.
      681     end.
      682   end procedure.
      683   procedure schedule-attr-is-rum-free-id :
      684   define input parameter p-free-id as character no-undo .
      685   define output parameter p-is-rum as logical no-undo .
      686   define buffer buf_temp-schedule-free for temp-schedule-free.
      687   do
      688   on error undo, return error
      689   :
      690       find first buf_temp-schedule-free no-lock no-error .
      691       if not available buf_temp-schedule-free then do:
      692         run schedule-attr-fill-free-props in this-procedure .
      693       end.
      694       find first buf_temp-schedule-free where
      695               buf_temp-schedule-free.free-id = p-free-id no-error.
      696       if available buf_temp-schedule-free
      697       and buf_temp-schedule-free.is-rum
      698       then do:
      699         p-is-rum = yes.
      700       end.
      701   end.
      702   end procedure.
      703   procedure schedule-attr-fill-free-props :
      704   define variable v-path                    as character                no-undo .
      705   DEFINE VARIABLE v-full-path               as character                no-undo .
      706   DEFINE VARIABLE v-file-name               as character                no-undo .
      707   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      708   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      709   define buffer buf_temp-schedule-free for temp-schedule-free.
      710   define variable v-answer as logical no-undo .
      711     do
      712     on error undo, return error substitute("&1 &2 &3&4&5&4"
      713                                           ,vss-workfile
      714                                           ,vss-revision
      715                                           ,vss-description
      716                                           ,chr(10)
      717                                           ,error-status:get-message(1) )
      718     :
      719       run gbl/filename.p (
      720                       input 'cmp/shd-free.d'
      721                     ,output v-full-path
      722                     ,output v-path
      723                     ,output v-file-name
      724                     ,output v-file-name-no-ext
      725                     ,output v-file-name-ext
      726                     ) .
      727       input from value(v-full-path).
      728       repeat :
      729         create buf_temp-schedule-free.
      730         import buf_temp-schedule-free.
      731       END.
      732       input close.
      733       _ff:
      734       for each buf_temp-schedule-free :
      735         if buf_temp-schedule-free.free-id = '':U then do:
      736            delete buf_temp-schedule-free.
      737            next _ff.
      738          end.
      739          run schedule-attr-check-enc in this-procedure (
      740                                                       input  buf_temp-schedule-free.free-id
      741                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      742                                                               buf_temp-schedule-free.proc-param-edit-name +
      743                                                               buf_temp-schedule-free.conf-param +
      744                                                               string(buf_temp-schedule-free.is-gbd) +
      745                                                               string(buf_temp-schedule-free.is-ubd) +
      746                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      747                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      748                                                               string(buf_temp-schedule-free.other-info)
      749                                                               )
      750                                                       ,input  buf_temp-schedule-free.enc-key
      751                                                       ,output v-answer    ) no-error .
      752          if error-status:error
      753          or not v-answer then delete buf_temp-schedule-free.
      754        end.
      755     end.
      756   end procedure.
      757   Function schedule-attr-reverse returns character (str as character).
      758      define variable rev_incl_s as character init "" no-undo .
      759      define variable rev_incl_i as integer no-undo .
      760      define variable rev_incl_l as integer no-undo .
      761      rev_incl_l = length(str).
      762      do rev_incl_i = 1 to rev_incl_l:
      763         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      764      end.
      765      return rev_incl_s.
      766   end.
      767   procedure schedule-attr-check-enc.
      768     define input  parameter p-free-id   as character no-undo .
      769     define input  parameter p-value     as character no-undo .
      770     define input  parameter p-enc-value as character no-undo .
      771     define output parameter p-answer    as logical   no-undo .
      772     define variable tmp         as character no-undo .
      773     define variable v-enc-value as character no-undo .
      774     assign
      775     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      776     .
      777     run schedule-attr-pswd-enc in this-procedure
      778       ( input tmp
      779        ,output v-enc-value
      780       ) no-error .
      781     if error-status:error then do:
      782       message
      783         vss-workfile vss-revision vss-description skip
      784         "Ошибка при вызове процедуры pswd-enc" skip
      785         return-value skip
      786         error-status :get-message(1) skip
      787         view-as alert-box error .
      788       undo, return error .
      789     end.
      790     if v-enc-value = p-enc-value then do:
      791       assign
      792         p-answer = true
      793       .
      794     end.
      795     else do:
      796       assign
      797         p-answer = false
      798       .
      799     end.
      800   end.
      801   procedure schedule-attr-conf-enc.
      802     define input  parameter p-free-id   as character no-undo .
      803     define input  parameter p-value     as character no-undo .
      804     define output parameter p-enc-value as character no-undo .
      805     define variable tmp         as character no-undo .
      806     assign
      807       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      808     .
      809     run schedule-attr-pswd-enc in this-procedure
      810       ( input tmp
      811        ,output p-enc-value
      812       ) no-error .
      813     if error-status:error then do:
      814       message
      815         vss-workfile vss-revision vss-description skip
      816         "Ошибка при вызове процедуры pswd-enc" skip
      817         return-value skip
      818         error-status :get-message(1) skip
      819         view-as alert-box error .
      820       undo, return error .
      821     end.
      822   end procedure.
      823   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   procedure schedule-attr-pswd-enc :
      825     define input parameter  pswd     as character no-undo .
      826     define output parameter enc-pswd as character no-undo .
      827     do
      828     on error undo, return error return-value
      829     :
      830       assign
      831         enc-pswd = encode(pswd + string(index(pswd, "k")))
      832       .
      833     end.
      834   end procedure.
      835   define variable v-param-type         as character no-undo .
      836   DEFINE BUTTON b-help
      837        LABEL "Помо&щь"
      838        SIZE 10 BY 1.
      839   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      840        LABEL "&Отмена"
      841        SIZE 10 BY 1
      842        BGCOLOR 8 .
      843   DEFINE BUTTON Btn_OK DEFAULT
      844        LABEL "&Ввод"
      845        SIZE 10 BY 1
      846        BGCOLOR 8 .
      847   DEFINE VARIABLE toggle-ahsp AS LOGICAL INITIAL no
      848        LABEL "Складской архив по поставщикам"
      849        VIEW-AS TOGGLE-BOX
      850        SIZE 41.13 BY .83 NO-UNDO.
      851   DEFINE VARIABLE toggle-aht AS LOGICAL INITIAL no
      852        LABEL "Складской архив по типам приобретения"
      853        VIEW-AS TOGGLE-BOX
      854        SIZE 41.13 BY .83 NO-UNDO.
      855   DEFINE VARIABLE toggle-arh AS LOGICAL INITIAL no
      856        LABEL "Складской архив по товару"
      857        VIEW-AS TOGGLE-BOX
      858        SIZE 42.63 BY .83 NO-UNDO.
      859   DEFINE VARIABLE toggle-hold AS LOGICAL INITIAL no
      860        LABEL "Межфирменный архив"
      861        VIEW-AS TOGGLE-BOX
      862        SIZE 40.63 BY .83 NO-UNDO.
      863   DEFINE FRAME Dialog-Frame
      864        Btn_OK AT ROW 1 COL 1
      865        Btn_Cancel AT ROW 1 COL 11
      866        b-help AT ROW 1 COL 21
      867        toggle-arh AT ROW 2.83 COL 5.38
      868        toggle-ahsp AT ROW 4.08 COL 5.38
      869        toggle-aht AT ROW 5.42 COL 5.38
      870        toggle-hold AT ROW 6.67 COL 5.38
      871        SPACE(4.23) SKIP(0.91)
      872       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      873            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      874            TITLE "Параметры авторасчета архивов"
      875            CANCEL-BUTTON Btn_Cancel.
      876   ASSIGN
      877          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      878          FRAME Dialog-Frame:HIDDEN           = TRUE.
      879   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      880   DO:
      881     APPLY "END-ERROR":U TO SELF.
      882   END.
      883   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      884   DO:
      885       assign
      886           p-cancel = yes
      887       .
      888   END.
      889   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      890   DO:
      891     assign
      892       toggle-arh
      893       toggle-ahsp
      894       toggle-aht
      895       toggle-hold
      896     .
      897     if  toggle-arh  = false
      898     and toggle-ahsp = false
      899     and toggle-aht  = false
      900     and toggle-hold = false
      901     then do:
      902       message
      903         "Не выбран ни один тип архивов"
      904         view-as alert-box information .
      905       undo, return no-apply.
      906     end.
      907     run attach-attr-to-schedule-line in this-procedure
      908       (input  toggle-arh
      909       ,input  toggle-ahsp
      910       ,input  toggle-aht
      911       ,input  toggle-hold
      912       ).
      913     apply "go" to frame Dialog-Frame.
      914   END.
      915   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      916   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      917   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   on help of frame Dialog-Frame
      919   do:
      920     run gbl/app_help.p
      921       (input this-procedure :file-name
      922       ,input ''
      923       ,input ?
      924       ) no-error.
      925     if error-status :error then do:
      926       message
      927         "Ошибка при вызове помощи"
      928         error-status :get-message(1)
      929         view-as alert-box .
      930     end.
      931   end.
      932   run minbtn-set in this-procedure .
      933   on choose of b-help in frame Dialog-Frame
      934   do:
      935     apply "help":u to frame Dialog-Frame .
      936   end.
      937   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   procedure minbtn-set :
      939       do
      940           on error undo, return error return-value
      941           :
      942           define variable ii              as integer       no-undo .
      943           define variable fh              as widget-handle no-undo .
      944           define variable hh              as widget-handle no-undo .
      945           define variable v-h             as handle        extent 4 no-undo .
      946           define variable v-name-button   as character     no-undo .
      947           define variable v-help-old-x    as decimal       no-undo .
      948           define variable v-help-old-y    as decimal       no-undo .
      949           define variable v-help-old-size as decimal       no-undo .
      950           define variable v-frame-width   as decimal       no-undo .
      951           define variable jj              as integer       no-undo .
      952           do
      953               on error undo, return error
      954               :
      955               assign
      956                   v-frame-width = frame Dialog-Frame:width - 0.3
      957                   fh            = frame Dialog-Frame:first-child
      958                   hh            = fh:first-child
      959                   ii            = 1
      960                   .
      961               do while valid-handle(hh):
      962                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      963                   do:
      964                       case lc(hh:name) :
      965                           when "b-help" then
      966                               do:
      967                                   hh:load-image-up("cmp/b-help.bmp":u) .
      968                                   hh:load-image-down("cmp/b-help.bmp":u) .
      969                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      970                                   hh:TOOLTIP = "Помощь" .
      971                                   v-help-old-x = hh:column .
      972                                   v-help-old-y = hh:row    .
      973                                   v-help-old-size = hh:width .
      974                                   hh:width-chars = 2.5 .
      975                               end.
      976                           when "b-print" then
      977                               do:
      978                                   hh:load-image("cmp/b-print.bmp":u) .
      979                                   hh:TOOLTIP = "Печать" .
      980                                   v-h[ii] = hh:handle .
      981                                   ii = ii + 1 .
      982                                   hh:width-chars = 3 .
      983                               end.
      984                           when "b-history" or
      985                           when "b-hist" then
      986                               do:
      987                                   hh:load-image("cmp/b-hist.bmp":u) .
      988                                   hh:TOOLTIP = "История" .
      989                                   v-h[ii] = hh:handle .
      990                                   ii = ii + 1 .
      991                                   hh:width-chars = 3 .
      992                               end.
      993                           when "b-sch" then
      994                               do:
      995                                   hh:load-image("cmp/b-sch.bmp":u) .
      996                                   hh:TOOLTIP = "Установка Фильтра" .
      997                                   v-h[ii] = hh:handle .
      998                                   ii = ii + 1 .
      999                                   hh:width-chars = 3 .
     1000                               end.
     1001                           when "b-hist-user" then
     1002                               do:
     1003                                   hh:load-image("cmp/b-hist.bmp":u) .
     1004                                   hh:TOOLTIP = "История пользователя" .
     1005                                   ii = ii + 1 .
     1006                               end.
     1007                       end case.
     1008                   end.
     1009                   hh = hh:next-sibling.
     1010               end.
     1011               b-help:column = v-frame-width - b-help:width-chars.
     1012               jj = 0.
     1013               repeat ii = 4 to 1 by -1 :
     1014                   if valid-handle (v-h[ii] ) then
     1015                   do:
     1016                       jj  = jj + 1 .
     1017                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1018                       v-h[ii]:row    = v-help-old-y .
     1019                   end.
     1020               end.
     1021           end.
     1022       end.
     1023   end procedure.
     1024   MAIN-BLOCK:
     1025   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1026      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1027       assign
     1028           frame Dialog-Frame :title = frame Dialog-Frame :title
     1029                       + ". " + p-task-type + ": Задача номер " + string( p-task-num )
     1030       .
     1031       run init-param-values in this-procedure
     1032         (input  p-cre-db-num
     1033         ,input  p-task-type
     1034         ,input  p-task-num
     1035         ,output toggle-arh
     1036         ,output toggle-ahsp
     1037         ,output toggle-aht
     1038         ,output toggle-hold
     1039         ).
     1040       run enable_UI.
     1041       WAIT-FOR GO OF FRAME Dialog-Frame.
     1042   END.
     1043   RUN disable_UI.
     1044   PROCEDURE attach-attr-to-schedule-line :
     1045     define input parameter p-calc-arh  as logical   no-undo .
     1046     define input parameter p-calc-ahsp as logical   no-undo .
     1047     define input parameter p-calc-aht  as logical   no-undo .
     1048     define input parameter p-calc-hold as logical   no-undo .
     1049     define variable v-attr-value as character no-undo .
     1050     define buffer buf_schedule      for ub.schedule .
     1051     define buffer buf_schedule-attr for ub.schedule-attr .
     1052     do
     1053     on error undo, return error
     1054     :
     1055       find first buf_schedule no-lock
     1056         where buf_schedule.cre-db-num = p-cre-db-num
     1057           and buf_schedule.task-type  = p-task-type
     1058           and buf_schedule.task-num   = p-task-num
     1059         no-error.
     1060       if not available buf_schedule
     1061       and (  p-task-type   <> 'autoarh':U
     1062           or p-task-num    <> -1 )
     1063       then do:
     1064         message
     1065           vss-workfile vss-revision vss-description skip
     1066           "Не найдена строка расписания." skip
     1067           error-status :get-message(1) skip
     1068           return-value skip
     1069           view-as alert-box error .
     1070         undo, return error .
     1071       end.
     1072       assign
     1073         v-attr-value  = ( if p-calc-arh  = yes then "yes" else "no" ) + ","
     1074                       + ( if p-calc-ahsp = yes then "yes" else "no" ) + ","
     1075                       + ( if p-calc-aht  = yes then "yes" else "no" ) + ","
     1076                       + ( if p-calc-hold = yes then "yes" else "no" )
     1077       .
     1078       run schedule-attr-write in this-procedure
     1079         (input p-cre-db-num
     1080         ,input p-task-type
     1081         ,input p-task-num
     1082         ,input 'schedule-param-list':U
     1083         ,input v-attr-value
     1084         ).
     1085   end.
     1086   END PROCEDURE.
     1087   PROCEDURE disable_UI :
     1088     HIDE FRAME Dialog-Frame.
     1089   END PROCEDURE.
     1090   PROCEDURE enable_UI :
     1091     DISPLAY toggle-arh toggle-ahsp toggle-aht toggle-hold
     1092         WITH FRAME Dialog-Frame.
     1093     ENABLE Btn_OK Btn_Cancel b-help toggle-arh toggle-ahsp toggle-aht toggle-hold
     1094         WITH FRAME Dialog-Frame.
     1095     VIEW FRAME Dialog-Frame.
     1096   END PROCEDURE.
     1097   PROCEDURE init-param-values :
     1098     define input  parameter p-cre-db-num as character no-undo .
     1099     define input  parameter p-task-type  as character no-undo .
     1100     define input  parameter p-task-num   as integer   no-undo .
     1101     define output parameter p-calc-arh   as logical   no-undo .
     1102     define output parameter p-calc-ahsp  as logical   no-undo .
     1103     define output parameter p-calc-aht   as logical   no-undo .
     1104     define output parameter p-calc-hold  as logical   no-undo .
     1105     do
     1106     on error undo, return error
     1107     :
     1108       define variable v-counter       as integer       no-undo.
     1109       define variable v-param-list    as character     no-undo.
     1110       run schedule-attr-value in this-procedure
     1111         (input  p-cre-db-num
     1112         ,input  p-task-type
     1113         ,input  p-task-num
     1114         ,input  'schedule-param-list':U
     1115         ,output v-param-list
     1116         ,output v-param-type
     1117         ) .
     1118       if v-param-list = ""
     1119       then do:
     1120         assign
     1121           p-calc-arh  = true
     1122           p-calc-ahsp = true
     1123           p-calc-aht  = true
     1124           p-calc-hold = true
     1125         .
     1126       end.
     1127       else do:
     1128         run schedule-attr-extract-logical in this-procedure
     1129           (input  1
     1130           ,input  v-param-list
     1131           ,output p-calc-arh
     1132         ).
     1133         run schedule-attr-extract-logical in this-procedure
     1134           (input  2
     1135           ,input  v-param-list
     1136           ,output p-calc-ahsp
     1137         ).
     1138         run schedule-attr-extract-logical in this-procedure
     1139           (input  3
     1140           ,input  v-param-list
     1141           ,output p-calc-aht
     1142         ).
     1143         run schedule-attr-extract-logical in this-procedure
     1144           (input  4
     1145           ,input  v-param-list
     1146           ,output p-calc-hold
     1147         ).
     1148       end.
     1149     end.
     1150   END PROCEDURE.
