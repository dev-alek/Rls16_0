        1   block-level on error undo, throw.
        2   define input parameter p-rec-list as longchar no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: dcb9ba8c712c, 1662, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        5   define variable vss-date        as character no-undo init "$Date: Fri Nov 23 14:36:18 2018 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: unload-m2.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: adm/unload-m2.p $":U .
        8   define variable vss-description as character no-undo init "Начальный этап выгрузки УБД".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   Function reverse returns character (str as character).
       70      define variable rev_incl_s as character init "" no-undo .
       71      define variable rev_incl_i as integer no-undo .
       72      define variable rev_incl_l as integer no-undo .
       73      rev_incl_l = length(str).
       74      do rev_incl_i = 1 to rev_incl_l:
       75         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
       76      end.
       77      return rev_incl_s.
       78   end.
       79   procedure check-enc.
       80     define input  parameter p-db-num    as integer   no-undo .
       81     define input  parameter p-db-key    as character no-undo .
       82     define input  parameter p-code      as character no-undo .
       83     define input  parameter p-value     as character no-undo .
       84     define input  parameter p-beg-date  as date      no-undo .
       85     define input  parameter p-end-date  as date      no-undo .
       86     define input  parameter p-enc-value as character no-undo .
       87     define output parameter p-answer    as logical   no-undo .
       88     define variable tmp         as character no-undo .
       89     define variable v-enc-value as character no-undo .
       90     if p-db-num <> 0
       91       and p-db-key = "":U
       92     then do:
       93       assign
       94         p-answer = true
       95       .
       96       return.
       97     end.
       98     if p-db-key = "unload-db":U then do:
       99       assign
      100         p-answer = true
      101       .
      102       return.
      103     end.
      104     if p-code = ""  then do:
      105       assign
      106         tmp = string( p-db-num ) + reverse (p-db-key).
      107       .
      108     end.
      109     else do:
      110       assign
      111         tmp = string( p-db-num )
      112               + trim( p-db-key )
      113               + reverse( trim( p-code ) )
      114               + reverse( trim( p-value ) )
      115               + reverse( string( p-beg-date, "99.99.9999" ) )
      116               + reverse( string( p-end-date, "99.99.9999" ) )
      117       .
      118     end.
      119     run pswd-enc in this-procedure
      120       ( input tmp
      121        ,output v-enc-value
      122       ) no-error .
      123     if error-status:error then do:
      124       message
      125         vss-workfile vss-revision vss-description skip
      126         "Ошибка при вызове процедуры pswd-enc" skip
      127         return-value skip
      128         error-status :get-message(1) skip
      129         view-as alert-box error .
      130       undo, return error .
      131     end.
      132     if v-enc-value = p-enc-value then do:
      133       assign
      134         p-answer = true
      135       .
      136     end.
      137     else do:
      138       assign
      139         p-answer = false
      140       .
      141     end.
      142   end.
      143   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   procedure pswd-enc :
      145     define input parameter  pswd     as character no-undo .
      146     define output parameter enc-pswd as character no-undo .
      147     do
      148     on error undo, return error return-value
      149     :
      150       assign
      151         enc-pswd = encode(pswd + string(index(pswd, "k")))
      152       .
      153     end.
      154   end procedure.
      155   function diff-list returns character (
      156     input parfirst-list  as character,
      157     input parsecond-list as character,
      158     input pardelim       as character).
      159     if pardelim = ""
      160     or pardelim = ?
      161     then do:
      162       assign
      163         pardelim = ","
      164       .
      165     end.
      166     def var ind as integer no-undo .
      167     def var v-elem as character no-undo .
      168     def var v-result-list as character no-undo init "".
      169     def var v-num-parfirst-list as integer no-undo .
      170     assign
      171       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      172     .
      173     do ind = 1 to v-num-parfirst-list
      174     :
      175       assign
      176         v-elem = entry(ind, parfirst-list, pardelim)
      177       .
      178       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      179         assign
      180           v-result-list = v-result-list
      181                         + (if v-result-list > "" then pardelim else "")
      182                         + v-elem
      183         .
      184       end.
      185     end.
      186     return v-result-list .
      187   end function.
      188   function add-list returns character (
      189    input parfirst-list  as character,
      190    input parsecond-list as character,
      191    input pardelim       as character).
      192     if pardelim = ""
      193     or pardelim = ?
      194     then do:
      195       assign
      196         pardelim = ","
      197       .
      198     end.
      199     def var ind as integer no-undo .
      200     def var v-elem as character no-undo .
      201     def var v-result-list as character no-undo init "".
      202     def var v-num-parfirst-list as integer no-undo .
      203     assign
      204       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      205     .
      206     do ind = 1 to v-num-parfirst-list
      207     :
      208       assign
      209         v-elem = entry(ind, parfirst-list, pardelim)
      210       .
      211       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      212         assign
      213           v-result-list = v-result-list
      214                         + (if v-result-list > "" then pardelim else "")
      215                         + v-elem
      216         .
      217       end.
      218     end.
      219     def var v-num-parsecond-list as integer no-undo .
      220     assign
      221       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      222     .
      223     do ind = 1 to v-num-parsecond-list
      224     :
      225       assign
      226         v-elem = entry(ind, parsecond-list, pardelim)
      227       .
      228       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      229         assign
      230           v-result-list = v-result-list
      231                         + (if v-result-list > "" then pardelim else "")
      232                         + v-elem
      233         .
      234       end.
      235     end.
      236     return v-result-list .
      237   end function.
      238   function cross-list returns character (
      239    input parfirst-list  as character,
      240    input parsecond-list as character,
      241    input pardelim       as character).
      242     if pardelim = ""
      243     or pardelim = ?
      244     then do:
      245       assign
      246         pardelim = ","
      247       .
      248     end.
      249     def var ind as integer no-undo .
      250     def var v-elem as character no-undo .
      251     def var v-result-list as character no-undo init "".
      252     def var v-num-parfirst-list as integer no-undo .
      253     assign
      254       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      255     .
      256     do ind = 1 to v-num-parfirst-list
      257     :
      258       assign
      259         v-elem = entry(ind, parfirst-list, pardelim)
      260       .
      261       if lookup(v-elem, v-result-list, pardelim) = 0
      262       and lookup(v-elem, parsecond-list, pardelim) > 0
      263       then do:
      264         assign
      265           v-result-list = v-result-list
      266                         + (if v-result-list > "" then pardelim else "")
      267                         + v-elem
      268         .
      269       end.
      270     end.
      271     return v-result-list .
      272   end function.
      273   function radio-label returns character (
      274    input par-rs-value  as character,
      275    input par-rs-radio-buttons as character)
      276    .
      277    DEFINE variable v-result-label as character no-undo.
      278    assign
      279    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      280                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      281                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      282                             ), par-rs-radio-buttons
      283                           )
      284    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      285    .
      286   return v-result-label.
      287   end function.
      288   function m-radio-label returns character (
      289    input par-rs-value  as character,
      290    input par-rs-radio-buttons as character,
      291    input par-delim as character
      292    )
      293    .
      294    DEFINE variable v-result-label as character no-undo.
      295    assign
      296    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      297                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      298                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      299                             ), par-rs-radio-buttons, par-delim
      300                           )
      301    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      302    .
      303   return v-result-label.
      304   end function.
      305   FUNCTION mixlist returns character
      306   (
      307    input parfirst-list  as character
      308    ,input parsecond-list as character
      309    ,input pardelim       as character
      310    ,input pardelim-result as character ) :
      311     if pardelim = ""
      312     or pardelim = ?
      313     then do:
      314       assign
      315         pardelim = ","
      316       .
      317     end.
      318     def var ind as integer no-undo .
      319     def var v-elem1 as character no-undo .
      320     def var v-elem2 as character no-undo .
      321     def var v-result-list as character no-undo init "".
      322     do ind = 1 to num-entries(parfirst-list, pardelim)
      323     :
      324       assign
      325         v-elem1 = entry(ind, parfirst-list, pardelim)
      326         v-elem2 = entry(ind, parsecond-list, pardelim)
      327       .
      328         assign
      329           v-result-list = v-result-list
      330                         + (if v-result-list > "" then pardelim-result else "")
      331                         + v-elem1 + pardelim-result + v-elem2
      332         .
      333     end.
      334     return v-result-list .
      335   END FUNCTION.
      336   procedure save-db-key :
      337     define input parameter p-db-key like ub.db.db-key no-undo .
      338     do
      339     on error undo, return error
      340     :
      341       define buffer buf_rep for ub.rep .
      342       find buf_rep
      343         where buf_rep.rep-num = 1996011200
      344         no-error
      345       .
      346       if not available buf_rep then do:
      347         create buf_rep.
      348         assign
      349           buf_rep.rep-num = 1996011200
      350         .
      351       end.
      352       if lookup( p-db-key, buf_rep.name1 ) = 0 then do:
      353         assign
      354           buf_rep.name1 = buf_rep.name1 + ",":U + p-db-key
      355         .
      356       end.
      357     end.
      358   end procedure.
      359   procedure del-db-key :
      360     define input parameter p-db-key like ub.db.db-key no-undo .
      361     do
      362     on error undo, return error
      363     :
      364       define buffer buf_rep for ub.rep .
      365       define buffer buf_db  for ub.db .
      366       find first buf_db
      367         where buf_db.db-key = p-db-key
      368         no-error
      369       .
      370       if not available buf_db then do:
      371         find first buf_rep
      372           where buf_rep.rep-num = 1996011200
      373           no-error
      374         .
      375         if available buf_rep
      376           and lookup( p-db-key, buf_rep.name1 ) <> 0
      377         then do:
      378           assign
      379             buf_rep.name1 = diff-list( buf_rep.name1, p-db-key, ",":U )
      380           .
      381         end.
      382       end.
      383     end.
      384   end procedure.
      385   procedure chk-db-key :
      386     define input  parameter p-db-num     like ub.db.db-num     no-undo.
      387     define input  parameter p-db-key     like ub.db.db-key     no-undo.
      388     define input  parameter p-db-key-enc like ub.db.db-key-enc no-undo.
      389     define output parameter p-result     as   integer          no-undo .
      390     do
      391     on error undo, return error
      392     :
      393       define buffer buf_rep for ub.rep .
      394       define buffer buf_db  for ub.db .
      395       define variable v-ok as logical no-undo .
      396       if p-db-key = ?
      397         or p-db-key = ""
      398       then do:
      399         assign
      400           p-result = 1
      401         .
      402         return string("Не задано значение ключа БД.").
      403       end.
      404       if p-db-key-enc = ?
      405         or p-db-key-enc = ""
      406       then do:
      407         assign
      408           p-result = 2
      409         .
      410         return string("Не задано кодированное значение ключа БД.").
      411       end.
      412       find buf_rep
      413         where buf_rep.rep-num = 1996011200
      414         no-error
      415       .
      416       if not available buf_rep then do:
      417         create buf_rep.
      418         assign
      419           buf_rep.rep-num = 1996011200
      420         .
      421       end.
      422       for each buf_db no-lock
      423       on error undo, return error
      424       :
      425         if lookup( buf_db.db-key, buf_rep.name1 ) = 0 then do:
      426           assign
      427             buf_rep.name1 = buf_rep.name1 + ",":U + buf_db.db-key
      428           .
      429         end.
      430       end.
      431       assign
      432         p-result = 0
      433       .
      434       if lookup( p-db-key, buf_rep.name1 ) <> 0 then do:
      435         assign
      436           p-result = 1
      437         .
      438         return string("Данное значение ключа БД уже существует.").
      439       end.
      440       run check-enc in this-procedure
      441         ( input p-db-num
      442          ,input p-db-key
      443          ,input ""
      444          ,input ""
      445          ,input ?
      446          ,input ?
      447          ,input p-db-key-enc
      448          ,output v-ok
      449         ) no-error.
      450       if error-status:error then do:
      451         assign
      452           p-result = 1
      453         .
      454         return substitute( "Ошибка при проверке правильности кодирования. &1", error-status:get-message (1) ) .
      455       end.
      456       if v-ok <> true then do:
      457         assign
      458           p-result = 2
      459         .
      460         return string("Неверное кодированное значение ключа БД.").
      461       end.
      462     end.
      463   end procedure.
      464   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
