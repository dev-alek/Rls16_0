      557         (input  p-db-num
      558         ,input  p-code
      559         ,output p-exist
      560         ) no-error .
      561       if error-status :error
      562       then do:
      563         undo, return error return-value .
      564       end.
      565     end.
      566   end procedure.
      567   procedure db-attr-delete :
      568     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      569     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
      570     define output parameter p-deleted  as logical no-undo.
      571     do
      572     on error undo, return error
      573     :
      574           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      575         (input  p-db-num
      576         ,input  p-code
      577         ,output p-deleted
      578         ) no-error .
      579       if error-status :error
      580       then do:
      581         undo, return error return-value .
      582       end.
      583     end.
      584   end procedure.
      585   procedure db-attr-news :
      586     define input  parameter p-code           as character no-undo .
      587     define output parameter p-news           as logical   no-undo .
      588     do
      589     on error undo, return error
      590     :
      591           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-news in g#attr-lib
      592         (input  p-code
      593         ,output p-news
      594         ) no-error .
      595       if error-status :error
      596       then do:
      597         undo, return error return-value .
      598       end.
      599     end.
      600   end procedure.
      601   procedure db-attr-manual-edit :
      602     define input  parameter p-code           as character no-undo .
      603     define output parameter p-section-num    as integer no-undo .
      604     do
      605     on error undo, return error
      606     :
      607           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      608         (input  p-code
      609         ,output p-section-num
      610         ) no-error .
      611       if error-status :error
      612       then do:
      613         undo, return error return-value .
      614       end.
      615     end.
      616   end procedure.
      617   procedure db-attr-batch-edit :
      618     define input  parameter p-code           as character no-undo .
      619     define output parameter p-section-num    as integer no-undo .
      620     do
      621     on error undo, return error
      622     :
      623           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      624         (input  p-code
      625         ,output p-section-num
      626         ) no-error .
      627       if error-status :error
      628       then do:
      629         undo, return error return-value .
      630       end.
      631     end.
      632   end procedure.
      633   do
      634   on error  undo, return error
      635   on stop   undo, return error
      636   on endkey undo, return error
      637   :
      638     define buffer buf-new_db for ub.db .
      639     define buffer buf_user-login      for ub.user-login .
      640     define buffer buf_sys-ctrl for ub.sys-ctrl .
      641     define temp-table t_db no-undo like ub.db .
      642     define temp-table unld_db no-undo like ub.db
      643       field unload-hist as logical
      644       field dst-path  as character
      645     .
      646     define variable v-db-num      like ub.db.db-num     no-undo .
      647     define variable v-db-key      like ub.db.db-key     no-undo .
      648     define variable v-db-key-enc  like ub.db.db-key-enc no-undo .
      649     define variable v-answer      as   logical          no-undo .
      650     define variable v-type-unload as   character        no-undo .
      651     define variable v-recid       as   recid            no-undo .
      652     define variable v-err         as   character        no-undo .
      653     define variable v-unload-history as logical no-undo .
      654     define variable v-dbs         as   integer          no-undo .
      655     define variable v-list        as   character        no-undo .
      656     define variable v-dst-path    as   character        no-undo .
      657     define variable v-create-adm  as logical      no-undo.
      658     define variable v-log  as logical   no-undo .
      659   do v-dbs = 1 to num-entries (p-rec-list):
      660     v-list = entry(v-dbs, p-rec-list) no-error .
      661     run adm/unloaddc.p no-error .
      662     if error-status :error then do:
      663       message
      664         vss-workfile vss-revision vss-description skip
      665         substitute( "Не удалось отключить БД" ) skip
      666         return-value skip
      667         error-status :get-message ( error-status :num-messages )
      668         view-as alert-box error
      669       .
      670       return error .
      671     end.
      672     find first buf-new_db share-lock
      673       where recid(buf-new_db) = integer(v-list)
      674     .
      675     if buf-new_db.db-num = 0 then next .
      676     run adm/lock-db.p
      677       ( input buf-new_db.db-num
      678        ,input "unload_db":U
      679        ,buffer buf-new_db
      680       ) no-error.
      681     if error-status :error then do:
      682       message
      683         vss-workfile vss-revision vss-description skip
      684         substitute( "Ошибка при блокировке БД" ) skip
      685         return-value skip
      686         error-status :get-message ( error-status :num-messages )
      687         view-as alert-box error
      688       .
      689       return error .
      690     end.
      691     assign
      692       v-db-num     = buf-new_db.db-num
      693       v-db-key     = "":U
      694       v-db-key-enc = "":U
      695       v-recid      = recid( buf-new_db )
      696     .
      697     create t_db .
      698     buffer-copy buf-new_db to t_db .
      699     do transaction
      700     on error  undo, return error
      701     on stop   undo, return error
      702     on endkey undo, return error
      703     :
      704       run adm/dbi-unld.w
      705         ( input "unld"
      706          ,input-output v-recid
      707          ,output v-unload-history
      708          ,output v-dst-path
      709         ).
      710       if v-recid = ? then do:
      711         buffer-copy t_db to buf-new_db .
      712         return error.
      713       end.
      714       find first buf-new_db
      715         where buf-new_db.db-num = v-db-num
      716       .
      717       create unld_db .
      718       buffer-copy buf-new_db to unld_db
      719       assign
      720         unld_db.unload-hist = v-unload-history
      721         unld_db.dst-path = v-dst-path
      722       .
      723       assign
      724         v-db-key     = buf-new_db.db-key
      725         v-db-key-enc = buf-new_db.db-key-enc
      726       .
      727       run db-attr-write ( input buf-new_db.db-num
      728                          ,input 'last-unload-db-key':U
      729                          ,input v-db-key
      730                         ) no-error.
      731       run nws/nws-stop.p
      732         ( input  "stop":U
      733          ,input  v-db-num
      734          ,output v-answer
      735         ) no-error .
      736       if error-status :error
      737         or v-answer = false
      738       then do:
      739         buffer-copy t_db to buf-new_db .
      740         run del-db-key ( input v-db-key ).
      741         message
      742           vss-workfile vss-revision vss-description skip
      743           substitute( "Не удалось заблокировать СПН для БД &1", v-db-num ) skip
      744           return-value skip
      745           error-status :get-message ( error-status :num-messages )
      746           view-as alert-box error
      747         .
      748         return error.
      749       end.
      750     end.
      751   end .
      752   find first buf_sys-ctrl no-lock .
      753   message
      754     "Мультивыгрузка УБД." skip
      755     "Все данные, не пришедшие в ГБД будут потеряны." skip
      756     "Продолжить?" skip
      757     view-as alert-box question buttons yes-no update v-log .
      758   if not v-log then do:
      759     return "not-create":U .
      760   end.
      761   for each unld_db by unld_db.db-num :
      762     find first buf-new_db
      763       where buf-new_db.db-num = unld_db.db-num
      764     .
      765     v-create-adm = false .
      766     FIND FIRST buf_user-login
      767          WHERE buf_user-login.db-num     = unld_db.db-num
      768            AND buf_user-login.user-login = "адм"
      769            and buf_user-login.status_    = 0
      770          no-lock
      771          no-error
      772          .
      773     IF NOT AVAILABLE buf_user-login
      774     THEN DO:
      775        ASSIGN
      776           v-create-adm = TRUE
      777        .
      778     end.
      779     create alias src for database ub no-error.
      780     if error-status :error then do:
      781       message
      782         vss-workfile vss-revision vss-description skip
      783         substitute( "Ошибка при создании вымышленного имени src" ) skip
      784         error-status :get-message ( error-status :num-messages )
      785         view-as alert-box error
      786       .
      787       return error.
      788     end.
      789     connect value(unld_db.dst-path) -ld dst -U sysadm -P sysadm no-error.
      790     if not connected ("dst") then do:
      791       message
      792         vss-workfile vss-revision vss-description skip
      793         substitute( "Не могу соединиться с проинициированой целевой базой!" ) skip
      794         substitute( "БД &1. Целевая база данных &2. Пропускаем...", string(unld_db.db-num) ,unld_db.dst-path ) skip
      795         error-status :get-message ( error-status :num-messages )
      796         view-as alert-box error
      797       .
      798       next.
      799     end.
      800     run adm/init-db.p
      801       ( input unld_db.db-num
      802        ,input "dst":U
      803        ,input buf_sys-ctrl.language
      804        ,input buf_sys-ctrl.r-b
      805        ,input buf_sys-ctrl.sys-key
      806        ,input no
      807        ,input v-create-adm
      808        ,input 0
      809       ) no-error.
      810     if error-status:error then do:
      811       message
      812         vss-workfile vss-revision vss-description skip
      813         substitute( "Ошибка при инициализации целевой УБД &1!", string(unld_db.db-num) ) skip
      814         return-value skip
      815         error-status :get-message ( error-status :num-messages )
      816         view-as alert-box error
      817       .
      818       run adm/unloaddc.p no-error .
      819       if error-status :error then do:
      820         message
      821           vss-workfile vss-revision vss-description skip
      822           substitute( "Не удалось отключить БД" ) skip
      823           return-value skip
      824           error-status :get-message ( error-status :num-messages )
      825           view-as alert-box error
      826         .
      827       end.
      828       next .
      829     end.
      830     run adm/rest-rdb.p
      831       ( input unld_db.db-num
      832        ,input unld_db.db-key
      833        ,input unld_db.db-key-enc
      834        ,input ('unload-online':U + chr(4) + "yes")
      835        ,input unld_db.unload-hist
      836       ) no-error .
      837     if error-status :error
      838       or return-value = "not-create":U
      839     then do:
      840       assign
      841         v-err = error-status :get-message( error-status :num-messages ) + chr(10) + return-value
      842       .
      843       do transaction
      844       on error undo, return error
      845       :
      846         run adm/lock-db.p
      847           ( input unld_db.db-num
      848           ,input "unload_db":U
      849           ,buffer buf-new_db
      850           ) no-error.
      851         if error-status :error then do:
      852           message
      853             vss-workfile vss-revision vss-description skip
      854             substitute( "Ошибка при разблокировке БД &1", string(unld_db.db-num) ) skip
      855             return-value skip
      856             error-status :get-message ( error-status :num-messages )
      857             view-as alert-box error
      858           .
      859           next .
      860         end.
      861         if return-value = "not-create":U then do:
      862           message
      863             "Отказ от выгрузки УБД" skip
      864             "База данных" unld_db.db-num skip
      865             view-as alert-box information
      866           .
      867         end.
      868         else do:
      869           message
      870             vss-workfile vss-revision vss-description skip
      871             "Ошибка при выгрузке таблиц БД" skip
      872             "База данных" unld_db.db-num skip
      873             v-err skip
      874             view-as alert-box error
      875           .
      876         end.
      877       end.
      878       run adm/unloaddc.p no-error .
      879       if error-status :error then do:
      880         message
      881           vss-workfile vss-revision vss-description skip
      882           substitute( "Не удалось отключить БД" ) skip
      883           return-value skip
      884           error-status :get-message ( error-status :num-messages )
      885           view-as alert-box error
      886         .
      887       end.
      888       next.
      889     end.
      890     run adm/unloaddc.p no-error .
      891     if error-status :error then do:
      892       message
      893         vss-workfile vss-revision vss-description skip
      894         substitute( "Не удалось отключить БД" ) skip
      895         return-value skip
      896         error-status :get-message ( error-status :num-messages )
      897         view-as alert-box error
      898       .
      899       next .
      900     end.
      901     find first buf-new_db
      902       where buf-new_db.db-num = unld_db.db-num
      903     .
      904     if unld_db.db-key <> "":U
      905       and buf-new_db.db-key = unld_db.db-key
      906     then do:
      907       run str/callnews.p ( input 'db':U
      908                      ,input (buffer buf-new_db:handle )
      909                     ) no-error .
      910       if error-status :error then do:
      911         message
      912           vss-workfile vss-revision vss-description skip
      913           "Ошибка при отправке новостей о выгруженной БД" skip
      914           "База данных" buf-new_db.db-num skip
      915           error-status :get-message(1) skip
      916           return-value skip
      917           view-as alert-box error
      918         .
      919         next.
      920       end.
      921     end.
      922   end.
      923   message
      924       "Перекачка успешно завершена."
      925       view-as alert-box information .
      926   end.
