      489     field actual-time-int as integer
      490   .
      491   define variable v-preconnection as logical   no-undo .
      492   define variable v-connection    as logical   no-undo .
      493   define variable v-param         as character no-undo .
      494   define variable v-param-name    as character no-undo .
      495   define variable v-param-value   as character no-undo .
      496   define variable ind             as integer   no-undo .
      497   define variable v-num-entries   as integer   no-undo .
      498   define variable v-mode          as character no-undo .
      499   define variable mType           as character no-undo .
      500   define variable mNumSession     as integer   no-undo.
      501   define variable v-updating      as logical   no-undo init false .
      502   DEFINE VAR w-login AS WIDGET-HANDLE NO-UNDO.
      503   DEFINE BUTTON b-OK AUTO-GO DEFAULT
      504        LABEL "&Ввод":L
      505        SIZE 10 BY 1.
      506   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      507        LABEL "&Отмена":L
      508        SIZE 10 BY 1.
      509   DEFINE VARIABLE name AS CHARACTER FORMAT "X(12)":U
      510        LABEL "Логин"
      511        VIEW-AS FILL-IN
      512        SIZE 20 BY 1 NO-UNDO.
      513   DEFINE VARIABLE password AS CHARACTER FORMAT "X(16)":U
      514        LABEL "Пароль"
      515        VIEW-AS FILL-IN
      516        SIZE 20 BY 1 NO-UNDO.
      517   DEFINE VARIABLE password_display AS CHARACTER FORMAT "X(16)":U
      518        LABEL "Пароль"
      519        VIEW-AS FILL-IN
      520        SIZE 20 BY 1 NO-UNDO.
      521   DEFINE IMAGE IMAGE-1
      522        FILENAME "cmp/ith.bmp":U
      523        SIZE 40 BY 8.88.
      524   DEFINE FRAME FRAME-A
      525        name AT ROW 4.96 COL 10 COLON-ALIGNED
      526        password AT ROW 6.17 COL 10 COLON-ALIGNED BLANK
      527        password_display AT ROW 6.17 COL 10 COLON-ALIGNED PASSWORD-FIELD
      528        b-OK AT ROW 8 COL 11.75
      529        b-quit AT ROW 8 COL 21.88
      530        IMAGE-1 AT ROW 1 COL 1
      531       WITH 1 DOWN NO-BOX OVERLAY
      532            SIDE-LABELS THREE-D
      533            AT COL 1 ROW 1
      534            SIZE 40.13 BY 8.96.
      535   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      536     CREATE WINDOW w-login ASSIGN
      537            HIDDEN             = YES
      538            TITLE              = "TH СПН"
      539            COLUMN             = 27
      540            ROW                = 7.58
      541            HEIGHT             = 9.13
      542            WIDTH              = 40.25
      543            MAX-HEIGHT         = 35.63
      544            MAX-WIDTH          = 160
      545            VIRTUAL-HEIGHT     = 35.63
      546            VIRTUAL-WIDTH      = 160
      547            RESIZE             = no
      548            SCROLL-BARS        = yes
      549            STATUS-AREA        = no
      550            BGCOLOR            = ?
      551            FGCOLOR            = ?
      552            THREE-D            = yes
      553            MESSAGE-AREA       = no
      554            SENSITIVE          = yes.
      555   ELSE w-login = CURRENT-WINDOW.
      556   ASSIGN
      557          FRAME FRAME-A:HIDDEN           = TRUE.
      558   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      559   THEN w-login:HIDDEN = yes.
      560   ON VALUE-CHANGED OF password_display IN FRAME FRAME-A DO:
      561       IF NOT v-updating THEN DO:
      562           ASSIGN password:SCREEN-VALUE = password_display:SCREEN-VALUE.
      563       END.
      564   END.
      565   ON ANY-KEY OF password_display IN FRAME FRAME-A DO:
      566       IF LASTKEY = KEY-CODE("CTRL-V") THEN DO:
      567              ASSIGN
      568              v-updating = TRUE
      569              password:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      570              password_display:SCREEN-VALUE = System.Windows.Forms.Clipboard:GetText()
      571              v-updating = FALSE.
      572              System.Windows.Forms.Clipboard:Clear().
      573              RETURN NO-APPLY.
      574       END.
      575   END.
      576   ON CHOOSE OF b-OK IN FRAME FRAME-A
      577   DO:
      578     if name :screen-value = "" then do:
      579       message
      580         "Введите имя пользователя"
      581         view-as alert-box information .
      582       apply "entry" to name .
      583       return no-apply .
      584     end.
      585   END.
      586   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   on help of frame FRAME-A
      588   do:
      589     run gbl/app_help.p
      590       (input this-procedure :file-name
      591       ,input ''
      592       ,input ?
      593       ) no-error.
      594     if error-status :error then do:
      595       message
      596         "Ошибка при вызове помощи"
      597         error-status :get-message(1)
      598         view-as alert-box .
      599     end.
      600   end.
      601   procedure proc-alt-shift-f2:
      602     if not ibs.th.gbl.gbl-var:rcode
      603   then
      604     run gbl\inidebug.p .
      605   end.
      606   procedure proc-alt-shift-f3:
      607     run gbl/prvssinf.p
      608       ( input this-procedure
      609       ) .
      610   end.
      611   define variable v-inform-launched as logical no-undo initial false .
      612   procedure proc-alt-shift-f4:
      613     define variable v-action as character no-undo .
      614     if v-inform-launched = false then do:
      615       assign
      616         v-inform-launched = true
      617       .
      618       run gbl/d-inform.w
      619         (  input self
      620         ,  input this-procedure
      621         , output v-action
      622         ) no-error .
      623       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      624       assign
      625         v-inform-launched = false
      626       .
      627     end.
      628   end.
      629   procedure proc-alt-f1:
      630     run gbl/corrhelp.p
      631       (input this-procedure
      632       ) .
      633   end .
      634   on alt-shift-f2 anywhere do:
      635     run proc-alt-shift-f2.
      636   end.
      637   on alt-shift-f3 anywhere do:
      638     run proc-alt-shift-f3 in this-procedure .
      639   end.
      640   on alt-shift-f4 anywhere do:
      641     run proc-alt-shift-f4 in this-procedure.
      642   end.
      643   on alt-f1 anywhere do:
      644     run proc-alt-f1 in this-procedure .
      645   end.
      646   on "ENTRY" of b-ok do:
      647     if lastkey = keycode ("RETURN") then apply "CHOOSE" to b-ok in frame FRAME-A.
      648   end.
      649   on window-close of w-login do:
      650     apply "end-error" to frame FRAME-A.
      651   end.
      652   ASSIGN CURRENT-WINDOW             = w-login
      653       SESSION:SYSTEM-ALERT-BOXES = (CURRENT-WINDOW:MESSAGE-AREA = NO).
      654       session:three-d = yes.
      655   PAUSE 0 BEFORE-HIDE.
      656   if session:date-format <> "dmy":U
      657     or session:numeric-decimal-point <> ".":U
      658     or session:numeric-separator <> ",":U
      659   then do:
      660     message
      661       vss-workfile vss-revision vss-description skip
      662       "Неправильные установки сессии progress!" skip
      663       "Формат даты должен быть - " "'dmy'":U skip
      664       "Десятичный разделитель - " "'.'":U skip
      665       "Разделитель тысяч - " "','":U skip
      666       view-as alert-box error .
      667     quit.
      668   end.
      669   assign
      670     v-preconnection = FALSE
      671     name            = "":U
      672     password        = "":U
      673   .
      674   if SESSION:PARAMETER <> "":U
      675     and SESSION:PARAMETER <> ?
      676   then do:
      677     assign
      678       v-num-entries = num-entries( SESSION:PARAMETER, ",":U )
      679     .
      680     do ind = 1 to v-num-entries :
      681       assign
      682         v-param = entry( ind, SESSION:PARAMETER, ",":U )
      683       .
      684       if num-entries( v-param, ":":U ) > 1 then do:
      685         assign
      686           v-param-name  = entry( 1, v-param, ":":U )
      687           v-param-value = substring( v-param, length( v-param-name ) + 2 )
      688         .
      689         case v-param-name :
      690           when "U":U then do:
      691             assign
      692               name = v-param-value
      693             .
      694           end.
      695           when "P":U then do:
      696             assign
      697               password = v-param-value
      698             .
      699           end.
      700           when "M":U then do:
      701             assign
      702               v-mode = replace( v-param-value, chr(4), ",":U )
      703             .
      704           end.
      705           when "T":U then do:
      706             assign
      707               mType = replace( v-param-value, "+", ",":U )
      708             .
      709           end.
      710           when "T":U then do:
      711             assign
      712               mNumSession = int( v-param-value)
      713             .
      714           end.
      715           when "A":U then .
      716           otherwise do:
      717             message
      718               substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      719               substitute("Параметр игнорируется.") skip
      720               view-as alert-box information .
      721           end.
      722         end case.
      723       end.
      724       else do:
      725         message
      726           substitute("Неизвестный параметр сессии СПН: &1", v-param) skip
      727           substitute("Параметр игнорируется.") skip
      728           view-as alert-box information .
      729       end.
      730     end.
      731     if name <> "":U
      732       and password <> "":U
      733     then do:
      734       run adm/autoinit.p
      735         ( input name
      736         , input password
      737         ) no-error.
      738       run adm/autoconn.p no-error.
      739       if error-status :error then do:
      740         assign
      741           password = "":U
      742         .
      743       end.
      744       else do:
      745         assign
      746           v-preconnection = TRUE
      747         .
      748       end.
      749       run gbl/dbdiscon.p no-error.
      750     end.
      751   end.
      752   if v-preconnection = FALSE then do:
      753     run enable_UI.
      754   end.
      755   assign
      756     session :data-entry-return = yes
      757   .
      758   run gbl/font-chk.p no-error .
      759   if error-status :error then do:
      760     message
      761       vss-workfile vss-revision vss-description skip
      762       "Неправильные установки системных шрифтов" skip
      763       "Обратитесь к администратору" skip
      764       error-status :get-message(1) skip
      765       return-value skip
      766       view-as alert-box information .
      767   end.
      768   do1:
      769   do
      770   on error  undo, leave
      771   on endkey undo, leave
      772   on stop   undo, leave
      773   :
      774     if v-preconnection = FALSE then do:
      775       WAIT-FOR GO OF frame FRAME-A focus name.
      776     end.
      777     assign
      778       name
      779       password
      780       v-connection = FALSE
      781     .
      782     run adm/autoinit.p
      783       ( input name
      784       , input password
      785       ) no-error.
      786     if error-status :error then do:
      787       message
      788         vss-workfile vss-revision vss-description skip
      789         "Ошибка инициализации переменных для системы автоматического запуска" skip
      790         return-value
      791         view-as alert-box error.
      792       leave do1.
      793     end.
      794     run nws/nws-init.p no-error.
      795     if error-status :error then do:
      796       message
      797         vss-workfile vss-revision vss-description skip
      798         "Ошибка инициализации переменных для системы передачи новостей" skip
      799         return-value
      800         view-as alert-box error.
      801       leave do1.
      802     end.
      803     run adm/autoconn.p no-error.
      804     if error-status:error then do:
      805       message
      806         vss-workfile vss-revision vss-description skip
      807         return-value
      808         view-as alert-box error.
      809       leave do1.
      810     end.
      811     assign
      812       v-connection = TRUE
      813     .
      814     run gbl/dbdiscon.p no-error.
      815   end.
      816   assign
      817     session :data-entry-return = no
      818   .
      819   RUN disable_UI.
      820   if v-connection
      821     and not error-status:error
      822   then do:
      823     run adm/automainasync.w
      824       ( input mType
      825        ,input v-mode
      826        ,input mNumSession
      827       ) no-error.
      828   end.
      829   run gbl/dbdiscon.p no-error.
      830   quit.
      831   PROCEDURE disable_UI :
      832     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-login)
      833     THEN DELETE WIDGET w-login.
      834     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      835   END PROCEDURE.
      836   PROCEDURE enable_UI :
      837     DISPLAY name password password_display
      838         WITH FRAME FRAME-A IN WINDOW w-login.
      839     ENABLE name password password_display b-OK b-quit
      840         WITH FRAME FRAME-A IN WINDOW w-login.
      841     VIEW FRAME FRAME-A IN WINDOW w-login.
      842     VIEW w-login.
      843   END PROCEDURE.
