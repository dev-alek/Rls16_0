     3891   procedure restore-s-drgb-code :
     3892     define input parameter p-curr-db-num as integer no-undo.
     3893     do
     3894     on error undo, return error
     3895     :
     3896       define variable v-dr-code as   int64              no-undo .
     3897           assign
     3898         v-curr-seq-name  = "s-drgb-code"
     3899         v-table-name     = "dis-rule"
     3900         v-seq-field-name = "rule-num"
     3901         v-num-rec        = 0
     3902         v-curr-recid     = 0
     3903         v-new-seq-value  = 0
     3904       .
     3905       do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.
     3906       find restseq.code-range no-lock
     3907         where restseq.code-range.range-type = 'drgb':U
     3908           and restseq.code-range.db-num     = p-curr-db-num
     3909           and restseq.code-range.stts       = "a":U
     3910         no-error
     3911       .
     3912       if available restseq.code-range then do:
     3913         run get-max-code ( input "get-m-code":U
     3914                           ,input restseq.code-range.db-num
     3915                           ,input restseq.code-range.range-type
     3916                           ,input restseq.code-range.first-code
     3917                           ,input restseq.code-range.last-code
     3918                           ,input FALSE
     3919                           ,output v-dr-code
     3920                           ).
     3921         assign
     3922           v-curr-seq-value = v-dr-code
     3923         .
     3924         if dynamic-current-value( v-curr-seq-name, v-ld-db-name ) < v-curr-seq-value    or (v-curr-seq-value <> 0        and dynamic-current-value( v-curr-seq-name, v-ld-db-name ) > v-curr-seq-value        ) then do:   run log-error in this-procedure     (input v-curr-seq-name     ,input v-curr-recid     ,input dynamic-current-value( v-curr-seq-name, v-ld-db-name )     ,input v-curr-seq-value     ).   if v-action = "rest":U then do:     assign       dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = v-curr-seq-value     .   end. end. else do:   if v-curr-seq-value = 0 then do:           find first restseq._sequence no-lock       where restseq._sequence._seq-name = "s-drgb-code" no-error.     if available restseq._sequence then do:       if v-action = "rest":U then do:         assign           dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = restseq._sequence._seq-init         .       end.     end.   end. end.
     3925       end.
     3926       else do:
     3927         find restseq.code-range no-lock
     3928           where restseq.code-range.range-type = 'drgb':U
     3929             and restseq.code-range.db-num     = p-curr-db-num
     3930             and restseq.code-range.stts       = "u":U
     3931           no-error
     3932         .
     3933         if available restseq.code-range then do:
     3934           assign
     3935             v-curr-seq-value = restseq.code-range.last-code
     3936           .
     3937           if dynamic-current-value( v-curr-seq-name, v-ld-db-name ) < v-curr-seq-value    or (v-curr-seq-value <> 0        and dynamic-current-value( v-curr-seq-name, v-ld-db-name ) > v-curr-seq-value        ) then do:   run log-error in this-procedure     (input v-curr-seq-name     ,input v-curr-recid     ,input dynamic-current-value( v-curr-seq-name, v-ld-db-name )     ,input v-curr-seq-value     ).   if v-action = "rest":U then do:     assign       dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = v-curr-seq-value     .   end. end. else do:   if v-curr-seq-value = 0 then do:           find first restseq._sequence no-lock       where restseq._sequence._seq-name = "s-drgb-code" no-error.     if available restseq._sequence then do:       if v-action = "rest":U then do:         assign           dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = restseq._sequence._seq-init         .       end.     end.   end. end.
     3938         end.
     3939       end.
     3940     end.
     3941   end procedure.
