     3417     :
     3418       define variable v-dc-code as   int64              no-undo .
     3419           assign
     3420         v-curr-seq-name  = "s-dcgb-code"
     3421         v-table-name     = "dis-card"
     3422         v-seq-field-name = "card-num"
     3423         v-num-rec        = 0
     3424         v-curr-recid     = 0
     3425         v-new-seq-value  = 0
     3426       .
     3427       do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.
     3428       find restseq.code-range no-lock
     3429         where restseq.code-range.range-type = 'dcgb':U
     3430           and restseq.code-range.db-num     = p-curr-db-num
     3431           and restseq.code-range.stts       = "a":U
     3432         no-error
     3433       .
