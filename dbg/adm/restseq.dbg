     1284   case p-action :
     1285     when "get-m-code":U then do:
     1286       do v-ii7 = 1 to num-entries('restseq.bar-code,restseq.place'):
     1287         assign
     1288         v-table-name7 = entry(v-ii7, 'restseq.bar-code,restseq.place')
     1289         v-field-name7 = entry(v-ii7, 'b-code,pl-code')
     1290         .
