     1313     when "f-u":U then do:
     1314       for each buf_code-range share-lock
     1315           where ( buf_code-range.range-type = p-curr-type-cdrg
     1316                   and buf_code-range.db-num = p-db-num
     1317                   and buf_code-range.stts = "f":U
     1318                 ) or
     1319                 ( buf_code-range.range-type = p-curr-type-cdrg
     1320                   and buf_code-range.db-num = p-db-num
     1321                   and buf_code-range.stts = "u":U
     1322                 )
     1323       on error undo, return error
     1324       :
     1325         v-avail7 = 0.
