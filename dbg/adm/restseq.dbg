     1128         end.
     1129         when 'drgb':U then do:
     1130   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   define variable v-ii6 as integer   no-undo .
     1132   define variable v-table-name6 as character no-undo .
