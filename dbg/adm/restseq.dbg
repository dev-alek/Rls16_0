     1137   define variable v-code-mess6 as character no-undo .
     1138   define variable glog6 as logical   no-undo .
     1139   define variable v-code_6 as integer   no-undo .
     1140   case p-action :
     1141     when "get-m-code":U then do:
     1142       do v-ii6 = 1 to num-entries('restseq.dis-rule,restseq.dis-time-rule'):
     1143         assign
     1144         v-table-name6 = entry(v-ii6, 'restseq.dis-rule,restseq.dis-time-rule')
     1145         v-field-name6 = entry(v-ii6, 'rule-num,time-rule-num')
     1146         .
     1147         create buffer buf_h6 for table v-table-name6.
     1148         create query q_h6.
     1149         q_h6:SET-BUFFERS(buf_h6).
     1150         q_h6:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
     1151                           ,v-table-name6
     1152                           ,v-field-name6
     1153                           ,p-first-code
     1154                           ,p-last-code)
     1155                           ).
     1156         q_h6:QUERY-OPEN.
     1157         REPEAT while  q_h6:get-next().
     1158           assign
     1159             v-code_6 = buf_h6:buffer-field(v-field-name6):buffer-value
     1160           .
     1161           leave .
     1162         END.
     1163         q_h6:QUERY-CLOSE().
     1164         delete object q_h6.
     1165         delete object buf_h6.
     1166         v-b-code = max(v-code_6, v-b-code).
     1167       end.
     1168     end.
     1169     when "f-u":U then do:
     1170       for each buf_code-range share-lock
     1171           where ( buf_code-range.range-type = p-curr-type-cdrg
     1172                   and buf_code-range.db-num = p-db-num
     1173                   and buf_code-range.stts = "f":U
     1174                 ) or
     1175                 ( buf_code-range.range-type = p-curr-type-cdrg
     1176                   and buf_code-range.db-num = p-db-num
     1177                   and buf_code-range.stts = "u":U
     1178                 )
     1179       on error undo, return error
     1180       :
     1181         v-avail6 = 0.
     1182         do v-ii6 = 1 to num-entries('restseq.dis-rule,restseq.dis-time-rule'):
     1183           assign
     1184           v-table-name6 = entry(v-ii6, 'restseq.dis-rule,restseq.dis-time-rule')
     1185           v-field-name6 = entry(v-ii6, 'rule-num,time-rule-num')
     1186           .
     1187           create buffer buf_h6 for table v-table-name6.
     1188           glog6 = buf_h6:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1189                                   , v-table-name6
     1190                                   , v-field-name6
     1191                                   , buf_code-range.first-code
     1192                                   , buf_code-range.last-code)
     1193                                   ) no-error .
     1194           if buf_h6:available then do:
     1195             assign
     1196             v-avail6 = v-avail6 + 1
     1197             .
     1198             if v-avail6 = 1 then do:
     1199               v-code-mess6 = string(buf_h6:buffer-field(v-field-name6):buffer-value)
     1200               .
     1201             end.
     1202           end.
     1203           delete object buf_h6.
     1204        end.
     1205        if v-avail6 > 0
     1206           and buf_code-range.stts = "f":U
     1207         then do:
     1208           assign
     1209             buf_code-range.stts = "u":U
     1210             v-b-code            = v-b-code + 1
     1211             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1212                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1213                                               , chr(10)
     1214                                               , buf_code-range.first-code
     1215                                               , buf_code-range.last-code
     1216                                               , v-code-mess6
     1217                                             )
     1218           .
     1219           if p-view-mess = true then do:
     1220             message
     1221               v-msg
     1222               view-as alert-box information.
     1223           end.
     1224           else do:
     1225             output stream getmc-stream to "getmc.log" append.
     1226             put stream getmc-stream unformatted
     1227               string( today, "99/99/9999" ) space(1)
     1228               string( time, "HH:MM:SS" ) space(1)
     1229               v-msg skip
     1230             .
     1231             output stream getmc-stream close.
     1232           end.
     1233         end.
     1234         if v-avail6 = 0
     1235           and buf_code-range.stts = "u":U
     1236         then do:
     1237           find first buf-c_code-range exclusive-lock
     1238             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1239           .
     1240           assign
     1241             buf-c_code-range.stts = "c":U
