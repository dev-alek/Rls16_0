     1327           assign
     1328           v-table-name7 = entry(v-ii7, 'restseq.bar-code,restseq.place')
     1329           v-field-name7 = entry(v-ii7, 'b-code,pl-code')
     1330           .
     1331           create buffer buf_h7 for table v-table-name7.
     1332           glog7 = buf_h7:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1333                                   , v-table-name7
     1334                                   , v-field-name7
     1335                                   , buf_code-range.first-code
     1336                                   , buf_code-range.last-code)
     1337                                   ) no-error .
     1338           if buf_h7:available then do:
     1339             assign
     1340             v-avail7 = v-avail7 + 1
     1341             .
     1342             if v-avail7 = 1 then do:
     1343               v-code-mess7 = string(buf_h7:buffer-field(v-field-name7):buffer-value)
     1344               .
     1345             end.
     1346           end.
     1347           delete object buf_h7.
     1348        end.
     1349        if v-avail7 > 0
     1350           and buf_code-range.stts = "f":U
     1351         then do:
     1352           assign
     1353             buf_code-range.stts = "u":U
     1354             v-b-code            = v-b-code + 1
     1355             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1356                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1357                                               , chr(10)
     1358                                               , buf_code-range.first-code
     1359                                               , buf_code-range.last-code
     1360                                               , v-code-mess7
     1361                                             )
     1362           .
     1363           if p-view-mess = true then do:
     1364             message
     1365               v-msg
     1366               view-as alert-box information.
     1367           end.
     1368           else do:
     1369             output stream getmc-stream to "getmc.log" append.
     1370             put stream getmc-stream unformatted
     1371               string( today, "99/99/9999" ) space(1)
     1372               string( time, "HH:MM:SS" ) space(1)
     1373               v-msg skip
     1374             .
     1375             output stream getmc-stream close.
     1376           end.
     1377         end.
     1378         if v-avail7 = 0
     1379           and buf_code-range.stts = "u":U
     1380         then do:
     1381           find first buf-c_code-range exclusive-lock
     1382             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1383           .
     1384           assign
     1385             buf-c_code-range.stts = "c":U
     1386           .
     1387           release buf-c_code-range .
     1388           assign
     1389             buf_code-range.stts = "f":U
     1390             v-b-code            = v-b-code + 1
     1391             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1392                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1393                                               , chr(10)
     1394                                               , buf_code-range.first-code
     1395                                               , buf_code-range.last-code
     1396                                             )
     1397           .
     1398           if p-view-mess = true then do:
     1399             message
     1400               v-msg
     1401               view-as alert-box information.
     1402           end.
     1403           else do:
     1404             output stream getmc-stream to "getmc.log" append.
     1405             put stream getmc-stream unformatted
     1406               string( today, "99/99/9999" ) space(1)
     1407               string( time, "HH:MM:SS" ) space(1)
     1408               v-msg skip
     1409             .
     1410             output stream getmc-stream close.
     1411           end.
     1412         end.
     1413       end.
     1414     end.
     1415   end case.
     1416         end.
     1417         when 'scgb':U
     1418         or when 'sclc':U
     1419         then do:
     1420           case p-action :
     1421             when "get-m-code":U then do:
     1422               assign
     1423                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1424               .
     1425             end.
     1426             when "f-u":U then do:
     1427               assign
     1428                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1429               .
     1430               run mark-all-used-as-free in this-procedure (
     1431                                          input  p-db-num
     1432                                         ,input  p-curr-type-cdrg
     1433                                         ,output str-u-f
     1434                                         ,output str-u-f-rng
     1435                                       ).
     1436             end.
     1437           end case.
     1438           view frame get-max-code-inf.
     1439           assign
     1440             rec-cnt = 0
     1441           .
     1442           display
     1443             rec-cnt
     1444             with frame get-max-code-inf
     1445           .
     1446           for each buf_units no-lock
     1447               where lookup('вес':U, buf_units.type) > 0
     1448           on error undo, return error
     1449           :
     1450             for each buf_goods no-lock
     1451               where buf_goods.unit-base = buf_units.unit-name
     1452             on error undo, return error
     1453             :
     1454               assign
     1455                 rec-cnt = rec-cnt + 1
     1456               .
     1457               if ( rec-cnt modulo 10 ) = 0 then do:
     1458                 display
     1459                   rec-cnt
     1460                   with frame get-max-code-inf
     1461                 .
     1462               end.
     1463               run mc_gdsbcode in this-procedure (
     1464                                input  buf_goods.gds-code
     1465                               ,input  ?
     1466                               ,output v-main-bcode
     1467                             ) no-error .
     1468               if error-status :error then do:
     1469                 message
     1470                   vss-workfile vss-revision vss-description skip
     1471                   "Ошибка при поиске корневого бар-кода" skip
     1472                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     1473                   error-status :get-message(1) skip
     1474                   return-value skip
     1475                   view-as alert-box error .
     1476                 undo, return error .
     1477               end.
     1478               for each buf_prod-bc no-lock
     1479                   where buf_prod-bc.b-code = v-main-bcode
     1480               on error undo, return error
     1481               :
     1482                 if p-curr-type-cdrg = 'sclc':U
     1483                   and buf_prod-bc.bc-on = FALSE
     1484                 then do:
     1485                   next.
     1486                 end.
     1487                 run mc_prodbcat in this-procedure (
     1488                                  buffer buf_prod-bc
     1489                                 ,input  'global=request':u
     1490                                 ,output l-prod-bc-global
     1491                               ) no-error .
     1492                 if error-status :error then do:
     1493                   message
     1494                     vss-workfile vss-revision vss-description skip
     1495                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1496                     "Основной бар-код" buf_prod-bc.b-code skip
     1497                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1498                     "Действие global=request" skip
     1499                     error-status :get-message(1) skip
     1500                     return-value skip
     1501                     view-as alert-box error .
     1502                   undo, return error .
     1503                 end.
     1504                 run mc_prodbcat in this-procedure (
     1505                                  buffer buf_prod-bc
     1506                                 ,input  'weight=request':u
     1507                                 ,output l-prod-bc-weight
     1508                               ) no-error .
     1509                 if error-status :error then do:
     1510                   message
     1511                     vss-workfile vss-revision vss-description skip
     1512                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1513                     "Основной бар-код" buf_prod-bc.b-code skip
     1514                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1515                     "Действие weight=request" skip
     1516                     error-status :get-message(1) skip
     1517                     return-value skip
     1518                     view-as alert-box error .
     1519                   undo, return error .
     1520                 end.
     1521                 if l-prod-bc-weight
     1522                   and ( ( l-prod-bc-global
     1523                           and p-curr-type-cdrg = 'scgb':U
     1524                         )
     1525                         or
     1526                         ( not l-prod-bc-global
     1527                           and p-curr-type-cdrg = 'sclc':U
     1528                         )
     1529                       )
     1530                 then do:
     1531                   case p-action :
     1532                     when "get-m-code":U then do:
     1533                       if integer( buf_prod-bc.b-str ) >= p-first-code
     1534                         and integer( buf_prod-bc.b-str ) <= p-last-code
     1535                         and integer( buf_prod-bc.b-str ) > v-b-code
     1536                       then do:
     1537                         assign
     1538                           v-b-code = integer( buf_prod-bc.b-str )
     1539                         .
     1540                       end.
     1541                     end.
     1542                     when "f-u":U then do:
     1543                       for each buf_code-range
     1544                         where buf_code-range.db-num     = p-db-num
     1545                           and buf_code-range.range-type = p-curr-type-cdrg
     1546                           and buf_code-range.stts       = "f":U
     1547                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1548                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1549                       on error undo, return error
     1550                       :
     1551                         assign
     1552                           buf_code-range.stts = "u":U
     1553                         .
     1554                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1555                           assign
     1556                             str-u-f-rng = diff-list( str-u-f-rng
     1557                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1558                                                     ,",":U
     1559                                                     )
     1560                           .
     1561                         end.
     1562                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1563                           assign
     1564                             v-b-code = v-b-code + 1
     1565                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1566                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1567                                                     , chr(10)
     1568                                                     , buf_code-range.first-code
     1569                                                     , buf_code-range.last-code
     1570                                                     , buf_prod-bc.b-str
     1571                                                   )
     1572                             v-ret-msg = v-ret-msg + v-msg
     1573                           .
     1574                           if p-view-mess = true then do:
     1575                             message
     1576                               v-msg
     1577                               view-as alert-box information.
     1578                           end.
     1579                         end.
     1580                       end.
     1581                     end.
     1582                   end case.
     1583                 end.
     1584               end.
     1585             end.
     1586           end.
     1587           if p-action = "f-u":U then do:
     1588             do ind = 1 to num-entries( str-u-f-rng ):
     1589               assign
     1590                 v-b-code  = v-b-code + 1
     1591                 v-msg     = substitute( "Диапазон кодов &2&1"
     1592                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1593                                         , chr(10)
     1594                                         , entry( ind, str-u-f-rng )
     1595                                       )
     1596                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1597               .
     1598               if p-view-mess = true then do:
     1599                 message
     1600                   v-msg
     1601                   view-as alert-box information.
     1602               end.
     1603             end.
     1604           end.
     1605           hide frame get-max-code-inf no-pause .
     1606         end.
     1607         when 'pglc':U
     1608         then do:
     1609           case p-action :
     1610             when "get-m-code":U then do:
     1611               assign
     1612                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1613               .
     1614             end.
     1615             when "f-u":U then do:
     1616               assign
     1617                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1618               .
     1619               run mark-all-used-as-free in this-procedure (
     1620                                          input  p-db-num
     1621                                         ,input  p-curr-type-cdrg
     1622                                         ,output str-u-f
     1623                                         ,output str-u-f-rng
     1624                                       ).
     1625             end.
     1626           end case.
     1627           view frame get-max-code-inf.
     1628           assign
     1629             rec-cnt = 0
     1630           .
     1631           display
     1632             rec-cnt
     1633             with frame get-max-code-inf
     1634           .
     1635           for each buf_prod-bc no-lock where
     1636                   buf_prod-bc.b-str >= "00100"
     1637               and buf_prod-bc.b-str <= "99999"
     1638               and buf_prod-bc.bc-on-type = 'pglc':U
     1639               and length(buf_prod-bc.b-str) = 5
     1640           on error undo, return error
     1641           :
     1642               assign
     1643                 rec-cnt = rec-cnt + 1
     1644               .
     1645               if ( rec-cnt modulo 10 ) = 0 then do:
     1646                 display
     1647                   rec-cnt
     1648                   with frame get-max-code-inf
     1649                 .
     1650               end.
     1651               if p-curr-type-cdrg = 'pglc':U
     1652                 and buf_prod-bc.bc-on = FALSE
     1653               then do:
     1654                 next.
     1655               end.
     1656               run mc_prodbcat in this-procedure (
     1657                                 buffer buf_prod-bc
     1658                               ,input  'pgweight=request':u
     1659                               ,output l-prod-bc-pgweight
     1660                             ) no-error .
     1661               if error-status :error then do:
     1662                 message
     1663                   vss-workfile vss-revision vss-description skip
     1664                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1665                   "Основной бар-код" buf_prod-bc.b-code skip
     1666                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     1667                   "Действие weight=request" skip
     1668                   error-status :get-message(1) skip
     1669                   return-value skip
     1670                   view-as alert-box error .
     1671                 undo, return error .
     1672               end.
     1673               if l-prod-bc-pgweight
     1674               and p-curr-type-cdrg = 'pglc':U
     1675               then do:
     1676                 case p-action :
     1677                   when "get-m-code":U then do:
     1678                     if integer( buf_prod-bc.b-str ) >= p-first-code
     1679                       and integer( buf_prod-bc.b-str ) <= p-last-code
     1680                       and integer( buf_prod-bc.b-str ) > v-b-code
     1681                     then do:
     1682                       assign
     1683                         v-b-code = integer( buf_prod-bc.b-str )
     1684                       .
     1685                     end.
     1686                   end.
     1687                   when "f-u":U then do:
     1688                     for each buf_code-range
     1689                       where buf_code-range.db-num     = p-db-num
     1690                         and buf_code-range.range-type = p-curr-type-cdrg
     1691                         and buf_code-range.stts       = "f":U
     1692                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1693                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1694                     on error undo, return error
     1695                     :
     1696                     assign
     1697                     buf_code-range.stts = "u":U
     1698                       .
     1699                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1700                         assign
     1701                           str-u-f-rng = diff-list( str-u-f-rng
     1702                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1703                                                   ,",":U
     1704                                                   )
     1705                         .
     1706                     end.
     1707                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1708                         assign
     1709                           v-b-code = v-b-code + 1
     1710                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1711                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1712                                                   , chr(10)
     1713                                                   , buf_code-range.first-code
     1714                                                   , buf_code-range.last-code
     1715                                                   , buf_prod-bc.b-str
     1716                                                 )
     1717                           v-ret-msg = v-ret-msg + v-msg
     1718                         .
     1719                       if p-view-mess = true then do:
     1720                         message
     1721                           v-msg
     1722                           view-as alert-box information.
     1723                       end.
     1724                     end.
     1725                   end.
     1726                 end.
     1727               end case.
     1728             end.
     1729           end.
     1730           if p-action = "f-u":U then do:
     1731             do ind = 1 to num-entries( str-u-f-rng ):
     1732               assign
     1733                 v-b-code = v-b-code + 1
     1734                 v-msg     = substitute( "Диапазон кодов &2&1"
     1735                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1736                                         , chr(10)
     1737                                         , entry( ind, str-u-f-rng )
     1738                                       )
     1739                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1740               .
     1741               if p-view-mess = true then do:
     1742                 message
     1743                   v-msg
     1744                   view-as alert-box information.
     1745               end.
     1746             end.
     1747           end.
     1748           hide frame get-max-code-inf no-pause .
     1749         end.
     1750         otherwise do:
     1751           message
     1752             vss-workfile vss-revision vss-description skip
     1753             "get-max-code" skip
     1754             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     1755             view-as alert-box error.
     1756           return error.
     1757         end.
     1758       end case.
     1759     end.
     1760     return v-ret-msg.
     1761   end procedure.
     1762   procedure mark-all-used-as-free :
     1763     define input  parameter p-db-num         like restseq.db.db-num             no-undo .
     1764     define input  parameter p-curr-type-cdrg like restseq.code-range.range-type no-undo .
     1765     define output parameter p-str-u-f        as   character                 no-undo .
     1766     define output parameter p-str-u-f-rng    as   character                 no-undo .
     1767     do
     1768     on error undo, return error
     1769     :
     1770       define buffer buf_code-range   for restseq.code-range.
     1771       define buffer buf-c_code-range for restseq.code-range .
     1772       assign
     1773         p-str-u-f     = "":U
     1774         p-str-u-f-rng = "":U
     1775       .
     1776       for each buf_code-range share-lock
     1777           where buf_code-range.db-num     = p-db-num
     1778             and buf_code-range.range-type = p-curr-type-cdrg
     1779             and buf_code-range.stts       = "u":U
     1780       on error undo, return error
     1781       :
     1782         find first buf-c_code-range exclusive-lock
     1783           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1784         .
     1785         assign
     1786           buf-c_code-range.stts = "c":U
     1787         .
     1788         release buf-c_code-range .
     1789         assign
     1790           buf_code-range.stts = "f":U
     1791           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     1792           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1793         .
     1794       end.
     1795       assign
     1796         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     1797         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     1798       .
     1799     end.
     1800   end procedure.
     1801   procedure mc_prodbcat :
     1802     do
     1803     on error undo, return error
     1804     :
     1805       define parameter buffer buf_prod-bc  for restseq.prod-bc .
     1806       define input  parameter p-action           as character no-undo .
     1807       define output parameter p-return-attribute as logical no-undo .
     1808       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     1809       define buffer buf_bar-code   for restseq.bar-code   .
     1810       define buffer buf_units      for restseq.units      .
     1811       define buffer buf_code-range for restseq.code-range .
     1812       define variable p-code-int as integer no-undo .
     1813       define variable v-cdrg-type as character no-undo .
     1814       if not available buf_prod-bc then do:
     1815         message
     1816           vss-workfile vss-revision vss-description skip
     1817           "Ошибка задания входных параметров" skip
     1818           "Не задан дополнительный бар-код" skip
     1819           view-as alert-box error .
     1820         undo, return error .
     1821       end.
     1822       find first buf_bar-code no-lock
     1823         where buf_bar-code.b-code = buf_prod-bc.b-code
     1824         no-error .
     1825       if not available buf_bar-code then do:
     1826         message
     1827           vss-workfile vss-revision vss-description skip
     1828           "Неправильная ссылка на основной бар-код" skip
     1829           "Основной бар-код" buf_prod-bc.b-code skip
     1830           "Дополнительный бар-код" buf_prod-bc.b-str skip
     1831           view-as alert-box error .
     1832         undo, return error .
     1833       end.
     1834       find first buf_units no-lock
     1835         where buf_units.unit-name = buf_bar-code.unit-cli
     1836         no-error .
     1837       if not available buf_units then do:
     1838         message
     1839           vss-workfile vss-revision vss-description skip
     1840           "Не найдена единица измерения основного бар-кода" skip
     1841           "Основной бар-код" buf_bar-code.b-code skip
     1842           "Единица измерения" buf_bar-code.unit-cli skip
     1843           view-as alert-box error .
     1844         undo, return error .
     1845       end.
     1846       def var ind                    as integer   no-undo .
     1847       def var v-num-entries-p-action as integer   no-undo .
     1848       def var v-action               as character no-undo .
     1849       assign
     1850         v-num-entries-p-action = num-entries(p-action)
     1851       .
     1852       assign
     1853         p-return-attribute = true
     1854       .
     1855       _ind:
     1856       do ind = 1 to v-num-entries-p-action
     1857       :
     1858        if ind > 1 and p-return-attribute = false then return.
     1859         assign
     1860           v-action = entry(ind, p-action)
     1861         .
     1862         case v-action :
     1863           when "global=request":u
     1864           then do:
     1865             if not (buf_prod-bc.bc-on-type = ''
     1866             or buf_prod-bc.bc-on-type = 'scgb':U
     1867             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     1868               assign
     1869                 p-return-attribute = false
     1870               .
     1871             end.
     1872           end.
     1873           when "weight=request":u
     1874           then do:
     1875             if not (buf_prod-bc.bc-on-type = 'sclc':U
     1876             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     1877               assign
     1878                 p-return-attribute = false.
     1879             end.
     1880           end.
     1881           when "pgweight=request":u
     1882           then do:
     1883             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     1884               assign
     1885                 p-return-attribute = false.
     1886             end.
     1887           end.
     1888           when "petrolium=request":u
     1889           then do:
     1890             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     1891               assign
     1892                 p-return-attribute = false.
     1893             end.
     1894           end.
     1895           when "scaleable=request":u
     1896           then do:
     1897             if not (buf_prod-bc.bc-on-type = 'sslc':U
     1898             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     1899               assign
     1900                 p-return-attribute = false.
     1901             end.
     1902           end.
     1903           otherwise do:
     1904             message
     1905               vss-workfile vss-revision vss-description skip
     1906               "Неизвестное значение параметра v-action " skip
     1907               "v-action" v-action skip
     1908               "p-action" p-action skip
     1909               view-as alert-box error .
     1910             undo, return error .
     1911           end.
     1912         end case.
     1913       end.
     1914     end.
     1915   end procedure.
     1916   procedure mc_gdsbcode :
     1917     define input  parameter p-gds-code  like restseq.bar-code.gds-code  no-undo .
     1918     define input  parameter p-node-code like restseq.bar-code.node-code no-undo .
     1919     define output parameter p-b-code    like restseq.bar-code.b-code    no-undo .
     1920     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     1921     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     1922     define buffer buf_bar-code for restseq.bar-code .
     1923     def var v-unit-base like restseq.goods.unit-base no-undo .
     1924     do
     1925     on error undo, return error
     1926     :
     1927       if p-node-code = ? then do:
     1928         run mc_gdsrootnode in this-procedure (
     1929            input  p-gds-code
     1930           ,output p-node-code
     1931           ) no-error .
     1932         if error-status :error then do:
     1933           message
     1934             vss-workfile vss-revision vss-description skip
     1935             "Ошибка при определении корневого признака товара" skip
     1936             "Код товара" p-gds-code skip
     1937             error-status :get-message(1) skip
     1938             return-value skip
     1939             view-as alert-box error .
     1940           undo, return error .
     1941         end.
     1942       end.
     1943       run mc_unitbase in this-procedure (
     1944          input  p-gds-code
     1945         ,output v-unit-base
     1946         ) no-error .
     1947       if error-status :error then do:
     1948         message
     1949           vss-workfile vss-revision vss-description skip
     1950           "Ошибка определения базовой единицы измерения товара" skip
     1951           "Код товара" p-gds-code skip
     1952           view-as alert-box error .
     1953         undo, return error .
     1954       end.
     1955       find first buf_bar-code no-lock
     1956         where buf_bar-code.gds-code  = p-gds-code
     1957           and buf_bar-code.node-code = p-node-code
     1958           and buf_bar-code.part-code = ""
     1959           and buf_bar-code.in-code   = ""
     1960           and buf_bar-code.unit-cli  = v-unit-base
     1961         no-error .
     1962       if not available buf_bar-code then do:
     1963         undo, return error vss-proc-revision + ":" + chr(10)
     1964           + "Не найден первичный бар-кода признака " + chr(10)
     1965           + "Код товара " + string(p-gds-code) + chr(10)
     1966           + "Код признака " + string(p-node-code) + chr(10)
     1967           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     1968           .
     1969       end.
     1970       assign
     1971         p-b-code = buf_bar-code.b-code
     1972       .
     1973     end.
     1974   end procedure.
     1975   procedure mc_gdsrootnode :
     1976     define input  parameter p-gds-code  like restseq.goods.gds-code no-undo .
     1977     define output parameter p-root-node like restseq.goods.prt-root no-undo .
     1978     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     1979     define buffer buf_goods   for restseq.goods .
     1980     do
     1981     on error undo, return error
     1982     :
     1983       find first buf_goods no-lock
     1984         where buf_goods.gds-code  = p-gds-code
     1985         no-error .
     1986       if not available buf_goods then do:
     1987         message
     1988           vss-workfile vss-revision vss-description skip
     1989           "Не найден товар" skip
     1990           "Код товара" p-gds-code skip
     1991           view-as alert-box error .
     1992         undo, return error .
     1993       end.
     1994       run mc_prt-root-to-node-code in this-procedure (
     1995          input  buf_goods.prt-root
     1996         ,output p-root-node
     1997         ) no-error .
     1998       if error-status :error then do:
     1999         message
     2000           vss-workfile vss-revision vss-description skip
     2001           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2002           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2003           "Указатель на корень шкалы" buf_goods.prt-root skip
     2004           error-status :get-message(1) skip
     2005           return-value skip
     2006           view-as alert-box error .
     2007         undo, return error .
     2008       end.
     2009     end.
     2010   end procedure.
     2011   procedure mc_prt-root-to-node-code :
     2012     define input  parameter p-prt-root  like restseq.goods.prt-root no-undo .
     2013     define output parameter p-root-node like restseq.goods.prt-root no-undo .
     2014     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2015     define buffer buf_gds-prt for restseq.gds-prt .
     2016     do
     2017     on error undo, return error
     2018     :
     2019       find buf_gds-prt no-lock
     2020         where buf_gds-prt.upper-code = p-prt-root
     2021         no-error .
     2022       if not available buf_gds-prt then do:
     2023         message
     2024           vss-workfile vss-revision vss-description skip
     2025           "Не найден корень шкалы" skip
     2026           "Указатель на корень шкалы" p-prt-root skip
     2027           view-as alert-box error .
     2028         undo, return error .
     2029       end.
     2030       assign
     2031         p-root-node = buf_gds-prt.node-code
     2032       .
     2033     end.
     2034   end procedure.
     2035   procedure mc_unitbase :
     2036     define input  parameter p-gds-code  like restseq.goods.gds-code  no-undo .
     2037     define output parameter p-unit-base like restseq.goods.unit-base no-undo .
     2038     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2039     define buffer buf_goods for restseq.goods .
     2040     do
     2041     on error undo, return error
     2042     :
     2043       find first buf_goods no-lock
     2044         where buf_goods.gds-code = p-gds-code
     2045         no-error .
     2046       if not available buf_goods then do:
     2047         message
     2048           vss-workfile vss-revision vss-description skip
     2049           "Не найден товар" skip
     2050           "Код товара" p-gds-code skip
     2051           view-as alert-box error .
     2052         undo, return error .
     2053       end.
     2054       assign
     2055         p-unit-base = buf_goods.unit-base
     2056       .
     2057     end.
     2058   end procedure.
     2059   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2060   procedure doc-code:
     2061   define input  parameter parmode          as   character           no-undo.
     2062   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2063   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2064   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2065   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2066   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2067   define variable vardb-remote     as   logical             no-undo.
     2068   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2069   define variable v-delimiter as character no-undo .
     2070   do
     2071   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2072   :
     2073   find first buf_sys-ctrl no-lock .
     2074   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2075     CASE parmode:
     2076       when "main":u then do:
     2077         if vardb-remote then do:
     2078           assign
     2079             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2080         end.
     2081         else do:
     2082           assign
     2083             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2084         end.
     2085       end.
     2086       when "trio" then do:
     2087         assign
     2088           pardoc-code = replace (parroot-doc-code, "=", "*").
     2089       end.
     2090       otherwise do:
     2091         assign
     2092         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2093         no-error
     2094         .
     2095         if error-status:error  then do:
     2096           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2097                                         ,chr(10)
     2098                                         ,parmode
     2099                                         ).
     2100         end.
     2101         if num-entries(parmode) = 1
     2102         and parmode <> "chip":U
     2103         and parmode <> "chip_s":U
     2104         then do:
     2105           assign
     2106           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2107         end.
     2108         else if (lookup("chip":U, parmode) > 0
     2109                  or
     2110                  lookup("chip_s":U, parmode) > 0) then do:
     2111           assign
     2112             vartemp-doc-code = parroot-doc-code.
     2113           do while true:
     2114             if index (vartemp-doc-code , ".") = 0 then
     2115               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2116             else
     2117               vartemp-doc-code  =
     2118               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2119               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2120               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2121             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2122           end.
     2123           assign
     2124             pardoc-code = vartemp-doc-code.
     2125         end.
     2126       end.
     2127     end CASE.
     2128     if pardoc-code = '':U
     2129     or (parroot-doc-code <> '':U
     2130     and pardoc-code = parroot-doc-code) then do:
     2131       undo, return error substitute("Ошибка при генерации номера документа&1"
     2132                                     ,chr(10)).
     2133     end.
     2134   end.
     2135   end. // procedure/method
     2136   function get-doc-code-int64 returns int64
     2137     ( input p-doc-code as character ) :
     2138     define variable v-ind              as integer   no-undo .
     2139     define variable v-num-entries      as integer   no-undo .
     2140     define variable v-doc-code-int64   as int64     no-undo .
     2141     define variable v-canonic-doc-code as character no-undo .
     2142     assign
     2143       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2144       v-canonic-doc-code = p-doc-code
     2145     .
     2146     do v-ind = 1 to v-num-entries
     2147     :
     2148       assign
     2149         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2150       .
     2151     end.
     2152     assign
     2153       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2154     .
     2155     return v-doc-code-int64 .
     2156   end. // function/method
     2157   define variable conf-par as character no-undo.
     2158   define variable par-type as character no-undo.
     2159   define variable mode-erprn as logical no-undo.
     2160   define new global shared variable g#library  as handle no-undo .
     2161   define new global shared variable g#library2 as handle no-undo .
     2162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2163     (input  'is-erpRN'
     2164     ,input  0
     2165     ,input  ''
     2166     ,input  0
     2167     ,input  ''
     2168     ,input  ''
     2169     ,input  ''
     2170     ,input  NO
     2171     ,output conf-par
     2172     ,output par-type
     2173     ) no-error .
     2174   IF not error-status:error and conf-par = "yes":U then mode-erprn = yes.
     2175                                                    else mode-erprn = no.
     2176   define stream LogStream .
     2177   define variable v-ld-db-name      as character no-undo .
     2178   define variable v-seq-val         as int64     no-undo .
     2179   define variable v-seq-name        as character no-undo .
     2180   define variable v-proc-name       as character no-undo .
     2181   define variable v-total-cnt       as integer   no-undo .
     2182   define variable v-total-run       as integer   no-undo .
     2183   define variable v-total-err       as integer   no-undo .
     2184   define variable v-curr-db-num     as integer no-undo.
     2185   define variable v-curr-seq-name   as character no-undo .
     2186   define variable v-curr-seq-value  as int64     no-undo .
     2187   define variable v-curr-recid      as recid     no-undo .
     2188   define variable v-new-seq-value   as int64     no-undo .
     2189   define variable v-table-name      as character no-undo .
     2190   define variable v-seq-field-name  as character no-undo .
     2191   define variable v-num-rec         as integer   no-undo .
     2192   define variable v-msg             as character no-undo .
     2193   define variable v-show-msg        as logical   no-undo .
     2194   define variable v-action          as character no-undo .
     2195   define frame seq-info
     2196     v-curr-seq-name  format "x(25)" label "Счетчик" skip
     2197     v-table-name     format "x(20)" label "Таблица" skip
     2198     v-seq-field-name format "x(20)" label "Поле"    skip
     2199     v-num-rec        label "Количество" skip
     2200     with view-as dialog-box side-labels 1 columns three-d
     2201     title "Проверка, восстановление счетчиков" .
     2202   function get-chk-doc-doc-code-int64 returns int64
     2203     ( input p-db-num as integer, input p-doc-code as character ) :
     2204     define variable v-doc-code-int64 as int64   no-undo .
     2205     case num-entries(p-doc-code, "/") :
     2206       when 2 then do:
     2207         if p-db-num = 0 then return 0.
     2208         assign
     2209           v-doc-code-int64 = int64(entry(2, p-doc-code, "/"))
     2210           no-error
     2211         .
     2212       end.
     2213       when 1 then do:
     2214         if p-db-num <> 0 then return 0.
     2215         assign
     2216           v-doc-code-int64 = int64(p-doc-code) no-error
     2217         .
     2218       end.
     2219       otherwise do:
     2220         assign
     2221         v-doc-code-int64 = 0.
     2222       end.
     2223     end case.
     2224     return v-doc-code-int64 .
     2225   end.
     2226   function get-firm-firm-code-int64 returns int64
     2227     ( input p-curr-value      as int64,
     2228       input p-db-num        as integer) :
     2229     define variable v-firm-code-db as int64   no-undo .
     2230       v-firm-code-db = p-curr-value + p-db-num *  exp( 10, 7 ) .
     2231       return v-firm-code-db.
     2232   end.
     2233   function get-person-psn-code-int64 returns int64
     2234     ( input p-curr-value as int64,
     2235       input p-db-num        as integer ) :
     2236     define variable v-psn-code-db as int64   no-undo .
     2237       assign v-psn-code-db = p-curr-value + p-db-num *  exp( 10, 7 ).
     2238          return v-psn-code-db.
     2239   end.
     2240   function get-layout-id-int64 returns int64
     2241     ( input p-db-num as integer, input p-layout-id as character ) :
     2242     define variable v-layout-id-int64 as int64   no-undo .
     2243     case num-entries(p-layout-id, "-") :
     2244       when 2 then do:
     2245         if p-db-num = 0 then return 0.
     2246         assign
     2247           v-layout-id-int64 = int64(entry(2, p-layout-id, "-"))
     2248           no-error
     2249         .
     2250       end.
     2251       when 1 then do:
     2252         if p-db-num <> 0 then return 0.
     2253         assign
     2254           v-layout-id-int64 = int64(p-layout-id) no-error
     2255         .
     2256       end.
     2257       otherwise do:
     2258         assign
     2259         v-layout-id-int64 = 0.
     2260       end.
     2261     end case.
     2262     return v-layout-id-int64 .
     2263   end.
     2264   procedure factord-to-fact-num :
     2265     define input  parameter p-fact-order as decimal no-undo .
     2266     define output parameter p-fact-num   as int64 no-undo .
     2267     define variable v-fact-order-trunc as decimal no-undo .
     2268     define variable v-fact-num-dec as decimal no-undo .
     2269     do
     2270     on error undo, return error substitute( "&1 (factord-to-fact-num). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2271     :
     2272       if p-fact-order = ?
     2273       or p-fact-order = 0
     2274       then do:
     2275         assign
     2276         p-fact-num = 0.
     2277         return.
     2278       end.
     2279       assign
     2280        v-fact-order-trunc = truncate(p-fact-order, 2)
     2281       .
     2282       assign
     2283         v-fact-num-dec = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2284         p-fact-num = int64(v-fact-num-dec)
     2285       .
     2286     end.
     2287   end procedure.
     2288   procedure clear-log-file :
     2289     do
     2290     on error undo, return error substitute( "&1 (clear-log-file). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2291     :
     2292       output stream LogStream to "rest-seq.log" .
     2293       output stream LogStream close .
     2294     end.
     2295   end procedure.
     2296   procedure log-error :
     2297     define input parameter p-err-seq-name   as character no-undo .
     2298     define input parameter p-err-recid      as recid     no-undo .
     2299     define input parameter p-err-curr-value as int64     no-undo .
     2300     define input parameter p-err-new-value  as int64     no-undo .
     2301     assign
     2302       v-total-err = v-total-err + 1
     2303     .
     2304     do
     2305     on error undo, return error substitute( "&1 (log-error). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2306     :
     2307       output stream LogStream to "rest-seq.log" append .
     2308       put stream LogStream unformatted
     2309         string(today, "99/99/9999") space
     2310         string(time, "HH:MM") space
     2311         p-action space
     2312         p-err-seq-name space
     2313         "recid:" space p-err-recid  space
     2314         "curr:" space p-err-curr-value space
     2315         "new:" space p-err-new-value
     2316         skip
     2317         .
     2318       output stream LogStream close .
     2319     end.
     2320   end procedure.
     2321   procedure check-seq-list :
     2322     do
     2323     on error  undo, return error substitute( "&1 (check-seq-list). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2324     on stop   undo, return error substitute( "&1 (check-seq-list). stop", vss-workfile )
     2325     on endkey undo, return error substitute( "&1 (check-seq-list). endkey", vss-workfile )
     2326     :
     2327       define variable v-ret-msg         as character no-undo .
     2328       define variable v-all-proc-list   as character no-undo .
     2329       define variable v-ind             as integer   no-undo .
     2330       define variable v-num-entries     as integer   no-undo .
     2331       define variable v-proc-name       as character no-undo .
     2332       define variable v-check-seq-name  as character no-undo .
     2333       define variable v-list-excessive  as character no-undo .
     2334       define variable v-list-necessary  as character no-undo .
     2335       define variable v-list-all-av-seq as character no-undo .
     2336       assign
     2337         v-all-proc-list   = this-procedure :internal-entries
     2338         v-ret-msg         = "":U
     2339         v-list-excessive  = "":U
     2340         v-list-necessary  = "":U
     2341         v-num-entries     = num-entries( v-all-proc-list )
     2342       .
     2343       do v-ind = 1 to v-num-entries
     2344       on error undo, return error substitute( "&1 (check-seq-list do v-ind = 1). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2345       :
     2346         assign
     2347           v-proc-name = entry( v-ind, v-all-proc-list )
     2348         .
     2349         if v-proc-name begins "restore-":U then do:
     2350           assign
     2351             v-check-seq-name  = trim( replace( v-proc-name, "restore-":U, "":U ) )
     2352             v-list-all-av-seq = v-list-all-av-seq + (if v-list-all-av-seq = "":U then "":U else ",":U) + v-check-seq-name
     2353           .
     2354           find first restseq._sequence no-lock
     2355             where restseq._sequence._seq-name = v-check-seq-name
     2356             no-error.
     2357           if not available restseq._sequence
     2358             or lookup( restseq._sequence._seq-name, "next-report,s-datatype,s-petrol-code,s-sgr,s-inv,s-reserv1,s-reserv2,s-doc,s-doc-type,s-file-num,s-line-num,s-tax-rate,synch-cli-grp,synch-gds-grp,s-v-doc,s-ext-classif,s-fbr-grp,s-user-history,s-tog,s-op-hist,s-jwlr-grp,s-jewelry,s-h-route,s-h-route-dump,s-h-route-dump,synch-an-grp":U, ",":U ) > 0
     2359           then do:
     2360             assign
     2361               v-list-excessive = v-list-excessive + chr(10) + v-check-seq-name
     2362             .
     2363           end.
     2364         end.
     2365       end.
     2366       for each restseq._sequence no-lock
     2367       on error undo, return error substitute( "&1 (check-seq-list for each restseq._sequence). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2368       :
     2369         if lookup( restseq._sequence._seq-name, v-list-all-av-seq, ",":U ) = 0
     2370           and lookup( restseq._sequence._seq-name, "next-report,s-datatype,s-petrol-code,s-sgr,s-inv,s-reserv1,s-reserv2,s-doc,s-doc-type,s-file-num,s-line-num,s-tax-rate,synch-cli-grp,synch-gds-grp,s-v-doc,s-ext-classif,s-fbr-grp,s-user-history,s-tog,s-op-hist,s-jwlr-grp,s-jewelry,s-h-route,s-h-route-dump,s-h-route-dump,synch-an-grp":U, ",":U ) = 0
     2371         then do:
     2372           assign
     2373             v-list-necessary = v-list-necessary + chr(10) + restseq._sequence._seq-name
     2374           .
     2375         end.
     2376       end.
     2377       if v-list-excessive <> "":U then do:
     2378         assign
     2379           v-ret-msg = v-ret-msg + substitute( "&1Лишние процедуры по обработке sequence: &2", chr(10), v-list-excessive ) + chr(10)
     2380         .
     2381       end.
     2382       if v-list-necessary <> "":U then do:
     2383         assign
     2384           v-ret-msg = v-ret-msg + substitute( "&1Отсутствуют процедуры по обработке sequence: &2", chr(10), v-list-necessary ) + chr(10)
     2385         .
     2386       end.
     2387       if v-ret-msg <> "":U then do:
     2388         return error v-ret-msg .
     2389       end.
     2390       else do:
     2391         return .
     2392       end.
     2393     end.
     2394   end procedure.
     2395   do
     2396   on error undo, return error substitute( "&1 (main). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2397   :
     2398     if lookup(p-action, "check,rest,check-no-msg,rest-no-msg" ) = 0 then do:
     2399       message
     2400         vss-workfile vss-revision vss-description skip
     2401         "Ошибка задания входных параметров" skip
     2402         "Запрошено неизвестное действие" skip
     2403         "p-action" p-action skip
     2404         view-as alert-box error .
     2405       undo, return error .
     2406     end.
     2407     assign
     2408       v-show-msg = true
     2409     .
     2410     if lookup(p-action, "check-no-msg,rest-no-msg":U ) > 0 then do:
     2411       assign
     2412         v-show-msg = false
     2413       .
     2414     end.
     2415     assign
     2416       v-action = "check":U
     2417     .
     2418     if lookup(p-action, "rest,rest-no-msg":U ) > 0 then do:
     2419       assign
     2420         v-action = "rest":U
     2421       .
     2422     end.
     2423     assign
     2424       v-ld-db-name = ldbname( "restseq":U )
     2425     .
     2426     run clear-log-file in this-procedure .
     2427     assign
     2428       v-total-cnt = 0
     2429       v-total-err = 0
     2430       v-total-run = 0
     2431     .
     2432     run check-seq-list in this-procedure
     2433       no-error .
     2434     if error-status :error then do:
     2435       message
     2436         vss-workfile vss-revision vss-description skip
     2437         "Ошибка при проверке корректности процедуры восстановления" skip
     2438         error-status :get-message(1) skip
     2439         return-value skip
     2440         view-as alert-box error .
     2441       output stream LogStream to "rest-seq.log" append .
     2442       put stream LogStream unformatted
     2443         string(today, "99/99/9999") space string(time, "HH:MM") space
     2444         return-value
     2445         skip
     2446         .
     2447       output stream LogStream close .
     2448       if p-first-err = true then do:
     2449         return error .
     2450       end.
     2451     end.
     2452     find first restseq.sys-ctrl no-lock
     2453       no-error .
     2454     if available restseq.sys-ctrl then do:
     2455       assign
     2456         v-curr-db-num = restseq.sys-ctrl.db-num
     2457       .
     2458     end.
     2459     if v-curr-db-num = ? then do:
     2460       undo, return error "(rest-seq.p) Не удалось определить номер текущей БД" .
     2461     end.
     2462     view frame seq-info .
     2463     for each restseq._sequence no-lock
     2464     on error undo, return error substitute( "&1 (for each restseq._sequence). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2465     :
     2466       assign
     2467         v-seq-name  = restseq._sequence._seq-name
     2468         v-proc-name = "restore-":U + v-seq-name
     2469       .
     2470       if lookup( v-seq-name, "next-report,s-datatype,s-petrol-code,s-sgr,s-inv,s-reserv1,s-reserv2,s-doc,s-doc-type,s-file-num,s-line-num,s-tax-rate,synch-cli-grp,synch-gds-grp,s-v-doc,s-ext-classif,s-fbr-grp,s-user-history,s-tog,s-op-hist,s-jwlr-grp,s-jewelry,s-h-route,s-h-route-dump,s-h-route-dump,synch-an-grp":U ) > 0 then do:
     2471         next.
     2472       end.
     2473       if ( p-seq-list <> "":U
     2474            and lookup( v-seq-name, p-seq-list ) > 0
     2475          )
     2476          or p-seq-list = "":U
     2477       then do:
     2478         assign
     2479           v-total-cnt      = v-total-cnt + 1
     2480           v-seq-val        = dynamic-current-value( v-seq-name, v-ld-db-name )
     2481           v-curr-seq-value = v-seq-val
     2482         .
     2483         if restseq._sequence._seq-max <> ? then do:
     2484           if v-seq-val > restseq._sequence._seq-max then do:
     2485             assign
     2486               v-curr-seq-value = restseq._sequence._seq-max
     2487             .
     2488           end.
     2489         end.
     2490         else do:
     2491           if v-seq-val > 9223372036854775807 then do:
     2492             assign
     2493               v-curr-seq-value = 9223372036854775807
     2494             .
     2495           end.
     2496         end.
     2497         if restseq._sequence._seq-min <> ?
     2498           and v-seq-val < restseq._sequence._seq-min
     2499         then do:
     2500           assign
     2501             v-curr-seq-value = restseq._sequence._seq-min
     2502           .
     2503         end.
     2504         if v-curr-seq-value <> v-seq-val then do:
     2505           run log-error in this-procedure ~
     2506             (input v-seq-name
     2507             ,input ?
     2508             ,input v-seq-val
     2509             ,input v-curr-seq-value
     2510             ).
     2511           if v-action = "rest":U then do:
     2512             assign
     2513               dynamic-current-value( v-seq-name, v-ld-db-name ) = v-curr-seq-value
     2514             .
     2515           end.
     2516           else do:
     2517             next .
     2518           end.
     2519         end.
     2520         if lookup( v-proc-name, this-procedure :internal-entries ) > 0 then do:
     2521           assign
     2522             v-total-run = v-total-run + 1
     2523           .
     2524           run value( v-proc-name ) in this-procedure
     2525             ( input v-curr-db-num
     2526             ) no-error .
     2527           if error-status :error then do:
     2528             assign
     2529               v-msg = substitute( "Ошибка при восстановлении счетчика &1&2&3&2&4", v-seq-name, chr(10), error-status :get-message(1), return-value)
     2530             .
     2531             output stream LogStream to "rest-seq.log" append .
     2532             put stream LogStream unformatted
     2533               string(today, "99/99/9999") space string(time, "HH:MM") space
     2534               v-msg
     2535               skip
     2536               .
     2537             output stream LogStream close .
     2538             if v-show-msg = true then do:
     2539               message
     2540                 v-msg
     2541                 view-as alert-box error .
     2542             end.
     2543             if p-first-err = true then do:
     2544               return error v-msg.
     2545             end.
     2546           end.
     2547         end.
     2548       end.
     2549     end.
     2550     hide frame seq-info .
     2551     case v-action :
     2552       when "rest":U then do:
     2553         if v-total-err <> 0 then do:
     2554           assign
     2555             v-msg = substitute( "Восстановление счетчиков закончено.&1"
     2556                                 + "Просмотрено счетчиков &2.&1"
     2557                                 + "Проверено счетчиков   &3.&1"
     2558                                 + "Исправлено счетчиков  &4.&1"
     2559                                 + "Список исправленных счетчиков приведен в файле &5.&1"
     2560                                 , chr(10)
     2561                                 , v-total-cnt
     2562                                 , v-total-run
     2563                                 , v-total-err
     2564                                 , "rest-seq.log":U
     2565                               )
     2566           .
     2567         end.
     2568         else do:
     2569           assign
     2570             v-msg = substitute( "Восстановление счетчиков закончено.&1"
     2571                                 + "Просмотрено счетчиков &2.&1"
     2572                                 + "Проверено счетчиков   &3.&1"
     2573                                 + "Все счетчики содержали правильную информацию."
     2574                                 , chr(10)
     2575                                 , v-total-cnt
     2576                                 , v-total-run
     2577                               )
     2578           .
     2579         end.
     2580       end.
     2581       when "check":U then do:
     2582         if v-total-err <> 0 then do:
     2583           assign
     2584             v-msg = substitute( "Проверка счетчиков закончена.&1"
     2585                                 + "Просмотрено счетчиков &2.&1"
     2586                                 + "Проверено счетчиков   &3.&1"
     2587                                 + "Обнаружено ошибок     &4.&1"
     2588                                 + "Список ошибок приведен в файле &5.&1"
     2589                                 , chr(10)
     2590                                 , v-total-cnt
     2591                                 , v-total-run
     2592                                 , v-total-err
     2593                                 , "rest-seq.log":U
     2594                               )
     2595           .
     2596         end.
     2597         else do:
     2598           assign
     2599             v-msg = substitute( "Проверка счетчиков закончена.&1"
     2600                                 + "Просмотрено счетчиков &2.&1"
     2601                                 + "Проверено счетчиков   &3.&1"
     2602                                 + "Ошибок не обнаружено."
     2603                                 , chr(10)
     2604                                 , v-total-cnt
     2605                                 , v-total-run
     2606                               )
     2607           .
     2608         end.
     2609       end.
     2610     end case.
     2611     output stream LogStream to "rest-seq.log" append .
     2612     put stream LogStream unformatted
     2613       string(today, "99/99/9999") space string(time, "HH:MM") space
     2614       v-msg skip
     2615       .
     2616     output stream LogStream close .
     2617     if v-show-msg = true then do:
     2618       message
     2619         v-msg
     2620         view-as alert-box information .
     2621     end.
     2622     return v-msg .
     2623   end.
     2624   procedure restore-s-trn-fact :
     2625     define input parameter p-curr-db-num as integer no-undo.
     2626     do
     2627     on error undo, return error substitute( "&1 (restore-s-trn-fact). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2628     :
     2629       assign   v-curr-seq-value = 0 .
     2630                   assign   v-curr-seq-name  = "s-trn-fact"   v-table-name     = "price-doc"   v-seq-field-name = "fact-num"   v-num-rec        = 0   v-curr-recid     = 0   v-new-seq-value  = 0 . do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end. for each restseq.price-doc no-lock  on error undo, return error substitute( "&1 (validate-sequence price-doc). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ):      assign     v-num-rec = v-num-rec + 1   .   if v-num-rec mod 10 = 0 then do:     do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.   end.   assign v-new-seq-value = restseq.price-doc.fact-num .   if v-curr-seq-value < v-new-seq-value then do:     assign       v-curr-seq-value = v-new-seq-value       v-curr-recid     = recid(restseq.price-doc)     .   end. end.
     2631                   assign   v-curr-seq-name  = "s-trn-fact"   v-table-name     = "trn-doc"   v-seq-field-name = "fact-num"   v-num-rec        = 0   v-curr-recid     = 0   v-new-seq-value  = 0 . do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end. for each restseq.trn-doc no-lock  on error undo, return error substitute( "&1 (validate-sequence trn-doc). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ):      assign     v-num-rec = v-num-rec + 1   .   if v-num-rec mod 10 = 0 then do:     do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.   end.   assign v-new-seq-value = restseq.trn-doc.fact-num .   if v-curr-seq-value < v-new-seq-value then do:     assign       v-curr-seq-value = v-new-seq-value       v-curr-recid     = recid(restseq.trn-doc)     .   end. end.
     2632                   assign   v-curr-seq-name  = "s-trn-fact"   v-table-name     = "c-price-doc"   v-seq-field-name = "fact-num"   v-num-rec        = 0   v-curr-recid     = 0   v-new-seq-value  = 0 . do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end. for each restseq.c-price-doc no-lock  on error undo, return error substitute( "&1 (validate-sequence c-price-doc). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ):      assign     v-num-rec = v-num-rec + 1   .   if v-num-rec mod 10 = 0 then do:     do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.   end.   assign v-new-seq-value = restseq.c-price-doc.fact-num .   if v-curr-seq-value < v-new-seq-value then do:     assign       v-curr-seq-value = v-new-seq-value       v-curr-recid     = recid(restseq.c-price-doc)     .   end. end.
     2633                   assign   v-curr-seq-name  = "s-trn-fact"   v-table-name     = "c-trn-doc"   v-seq-field-name = "fact-num"   v-num-rec        = 0   v-curr-recid     = 0   v-new-seq-value  = 0 . do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end. for each restseq.c-trn-doc no-lock  on error undo, return error substitute( "&1 (validate-sequence c-trn-doc). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ):      assign     v-num-rec = v-num-rec + 1   .   if v-num-rec mod 10 = 0 then do:     do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.   end.   assign v-new-seq-value = restseq.c-trn-doc.fact-num .   if v-curr-seq-value < v-new-seq-value then do:     assign       v-curr-seq-value = v-new-seq-value       v-curr-recid     = recid(restseq.c-trn-doc)     .   end. end.
     2634       if dynamic-current-value( v-curr-seq-name, v-ld-db-name ) < v-curr-seq-value    or (v-curr-seq-value <> 0        and dynamic-current-value( v-curr-seq-name, v-ld-db-name ) > v-curr-seq-value        ) then do:   run log-error in this-procedure     (input v-curr-seq-name     ,input v-curr-recid     ,input dynamic-current-value( v-curr-seq-name, v-ld-db-name )     ,input v-curr-seq-value     ).   if v-action = "rest":U then do:     assign       dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = v-curr-seq-value     .   end. end. else do:   if v-curr-seq-value = 0 then do:           find first restseq._sequence no-lock       where restseq._sequence._seq-name = "s-trn-fact" no-error.     if available restseq._sequence then do:       if v-action = "rest":U then do:         assign           dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = restseq._sequence._seq-init         .       end.     end.   end. end.
     2635     end.
     2636   end procedure.
