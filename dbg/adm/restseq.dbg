     4169   procedure restore-s-cagb-code :
     4170     define input parameter p-curr-db-num as integer no-undo.
     4171     do
     4172     on error undo, return error
     4173     :
     4174       define variable v-ca-code as   int64              no-undo .
     4175           assign
     4176         v-curr-seq-name  = "s-cagb-code"
     4177         v-table-name     = "rule-by-call"
     4178         v-seq-field-name = "call#_id"
     4179         v-num-rec        = 0
     4180         v-curr-recid     = 0
     4181         v-new-seq-value  = 0
     4182       .
     4183       do with frame seq-info   on error undo, return error substitute( "&1 (show-action). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )   :     assign       v-curr-seq-name :screen-value  = string( v-curr-seq-name, v-curr-seq-name :format)       v-table-name :screen-value     = string( v-table-name, v-table-name :format)       v-seq-field-name :screen-value = string( v-seq-field-name, v-seq-field-name :format)       v-num-rec :screen-value        = string( v-num-rec, v-num-rec :format)     .   end.
     4184       find restseq.code-range no-lock
     4185         where restseq.code-range.range-type = 'cagb':U
     4186           and restseq.code-range.db-num     = p-curr-db-num
     4187           and restseq.code-range.stts       = "a":U
     4188         no-error
     4189       .
     4190       if available restseq.code-range then do:
     4191         run get-max-code ( input "get-m-code":U
     4192                           ,input restseq.code-range.db-num
     4193                           ,input restseq.code-range.range-type
     4194                           ,input restseq.code-range.first-code
     4195                           ,input restseq.code-range.last-code
     4196                           ,input FALSE
     4197                           ,output v-ca-code
     4198                           ).
     4199         assign
     4200           v-curr-seq-value = v-ca-code
     4201         .
     4202         if dynamic-current-value( v-curr-seq-name, v-ld-db-name ) < v-curr-seq-value    or (v-curr-seq-value <> 0        and dynamic-current-value( v-curr-seq-name, v-ld-db-name ) > v-curr-seq-value        ) then do:   run log-error in this-procedure     (input v-curr-seq-name     ,input v-curr-recid     ,input dynamic-current-value( v-curr-seq-name, v-ld-db-name )     ,input v-curr-seq-value     ).   if v-action = "rest":U then do:     assign       dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = v-curr-seq-value     .   end. end. else do:   if v-curr-seq-value = 0 then do:           find first restseq._sequence no-lock       where restseq._sequence._seq-name = "s-cagb-code" no-error.     if available restseq._sequence then do:       if v-action = "rest":U then do:         assign           dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = restseq._sequence._seq-init         .       end.     end.   end. end.
     4203       end.
     4204       else do:
     4205         find restseq.code-range no-lock
     4206           where restseq.code-range.range-type = 'cagb':U
     4207             and restseq.code-range.db-num     = p-curr-db-num
     4208             and restseq.code-range.stts       = "u":U
     4209           no-error
     4210         .
     4211         if available restseq.code-range then do:
     4212           assign
     4213             v-curr-seq-value = restseq.code-range.last-code
     4214           .
     4215           if dynamic-current-value( v-curr-seq-name, v-ld-db-name ) < v-curr-seq-value    or (v-curr-seq-value <> 0        and dynamic-current-value( v-curr-seq-name, v-ld-db-name ) > v-curr-seq-value        ) then do:   run log-error in this-procedure     (input v-curr-seq-name     ,input v-curr-recid     ,input dynamic-current-value( v-curr-seq-name, v-ld-db-name )     ,input v-curr-seq-value     ).   if v-action = "rest":U then do:     assign       dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = v-curr-seq-value     .   end. end. else do:   if v-curr-seq-value = 0 then do:           find first restseq._sequence no-lock       where restseq._sequence._seq-name = "s-cagb-code" no-error.     if available restseq._sequence then do:       if v-action = "rest":U then do:         assign           dynamic-current-value( v-curr-seq-name, v-ld-db-name ) = restseq._sequence._seq-init         .       end.     end.   end. end.
     4216         end.
     4217       end.
     4218     end.
     4219   end procedure.
