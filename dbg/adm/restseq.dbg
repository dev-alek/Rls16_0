     1262               string( today, "99/99/9999" ) space(1)
     1263               string( time, "HH:MM:SS" ) space(1)
     1264               v-msg skip
     1265             .
     1266             output stream getmc-stream close.
     1267           end.
     1268         end.
     1269       end.
     1270     end.
     1271   end case.
     1272         end.
     1273         when 'bcgb':U then do:
     1274   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
