     1094             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1095           .
     1096           assign
     1097             buf-c_code-range.stts = "c":U
     1098           .
     1099           release buf-c_code-range .
     1100           assign
     1101             buf_code-range.stts = "f":U
     1102             v-b-code            = v-b-code + 1
     1103             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1104                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1105                                               , chr(10)
     1106                                               , buf_code-range.first-code
     1107                                               , buf_code-range.last-code
     1108                                             )
     1109           .
     1110           if p-view-mess = true then do:
     1111             message
     1112               v-msg
     1113               view-as alert-box information.
     1114           end.
     1115           else do:
     1116             output stream getmc-stream to "getmc.log" append.
     1117             put stream getmc-stream unformatted
     1118               string( today, "99/99/9999" ) space(1)
     1119               string( time, "HH:MM:SS" ) space(1)
     1120               v-msg skip
     1121             .
     1122             output stream getmc-stream close.
     1123           end.
     1124         end.
     1125       end.
     1126     end.
