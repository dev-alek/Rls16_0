        1   block-level on error undo, throw.
        2   define input parameter p-action    as character no-undo.
        3   define input parameter p-seq-list  as character no-undo .
        4   define input parameter p-first-err as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Процедура проверки, восстановления Sequences".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   function diff-list returns character (
       16     input parfirst-list  as character,
       17     input parsecond-list as character,
       18     input pardelim       as character).
       19     if pardelim = ""
       20     or pardelim = ?
       21     then do:
       22       assign
       23         pardelim = ","
       24       .
       25     end.
       26     def var ind as integer no-undo .
       27     def var v-elem as character no-undo .
       28     def var v-result-list as character no-undo init "".
       29     def var v-num-parfirst-list as integer no-undo .
       30     assign
       31       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       32     .
       33     do ind = 1 to v-num-parfirst-list
       34     :
       35       assign
       36         v-elem = entry(ind, parfirst-list, pardelim)
       37       .
       38       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
       39         assign
       40           v-result-list = v-result-list
       41                         + (if v-result-list > "" then pardelim else "")
       42                         + v-elem
       43         .
       44       end.
       45     end.
       46     return v-result-list .
       47   end function.
       48   function add-list returns character (
       49    input parfirst-list  as character,
       50    input parsecond-list as character,
       51    input pardelim       as character).
       52     if pardelim = ""
       53     or pardelim = ?
       54     then do:
       55       assign
       56         pardelim = ","
       57       .
       58     end.
       59     def var ind as integer no-undo .
       60     def var v-elem as character no-undo .
       61     def var v-result-list as character no-undo init "".
       62     def var v-num-parfirst-list as integer no-undo .
       63     assign
       64       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       65     .
       66     do ind = 1 to v-num-parfirst-list
       67     :
       68       assign
       69         v-elem = entry(ind, parfirst-list, pardelim)
       70       .
       71       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
       72         assign
       73           v-result-list = v-result-list
       74                         + (if v-result-list > "" then pardelim else "")
       75                         + v-elem
       76         .
       77       end.
       78     end.
       79     def var v-num-parsecond-list as integer no-undo .
       80     assign
       81       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
       82     .
       83     do ind = 1 to v-num-parsecond-list
       84     :
       85       assign
       86         v-elem = entry(ind, parsecond-list, pardelim)
       87       .
       88       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
       89         assign
       90           v-result-list = v-result-list
       91                         + (if v-result-list > "" then pardelim else "")
       92                         + v-elem
       93         .
       94       end.
       95     end.
       96     return v-result-list .
       97   end function.
       98   function cross-list returns character (
       99    input parfirst-list  as character,
      100    input parsecond-list as character,
      101    input pardelim       as character).
      102     if pardelim = ""
      103     or pardelim = ?
      104     then do:
      105       assign
      106         pardelim = ","
      107       .
      108     end.
      109     def var ind as integer no-undo .
      110     def var v-elem as character no-undo .
      111     def var v-result-list as character no-undo init "".
      112     def var v-num-parfirst-list as integer no-undo .
      113     assign
      114       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      115     .
      116     do ind = 1 to v-num-parfirst-list
      117     :
      118       assign
      119         v-elem = entry(ind, parfirst-list, pardelim)
      120       .
      121       if lookup(v-elem, v-result-list, pardelim) = 0
      122       and lookup(v-elem, parsecond-list, pardelim) > 0
      123       then do:
      124         assign
      125           v-result-list = v-result-list
      126                         + (if v-result-list > "" then pardelim else "")
      127                         + v-elem
      128         .
      129       end.
      130     end.
      131     return v-result-list .
      132   end function.
      133   function radio-label returns character (
      134    input par-rs-value  as character,
      135    input par-rs-radio-buttons as character)
      136    .
      137    DEFINE variable v-result-label as character no-undo.
      138    assign
      139    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      140                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      141                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      142                             ), par-rs-radio-buttons
      143                           )
      144    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      145    .
      146   return v-result-label.
      147   end function.
      148   function m-radio-label returns character (
      149    input par-rs-value  as character,
      150    input par-rs-radio-buttons as character,
      151    input par-delim as character
      152    )
      153    .
      154    DEFINE variable v-result-label as character no-undo.
      155    assign
      156    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      157                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      158                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      159                             ), par-rs-radio-buttons, par-delim
      160                           )
      161    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      162    .
      163   return v-result-label.
      164   end function.
      165   FUNCTION mixlist returns character
      166   (
      167    input parfirst-list  as character
      168    ,input parsecond-list as character
      169    ,input pardelim       as character
      170    ,input pardelim-result as character ) :
      171     if pardelim = ""
      172     or pardelim = ?
      173     then do:
      174       assign
      175         pardelim = ","
      176       .
      177     end.
      178     def var ind as integer no-undo .
      179     def var v-elem1 as character no-undo .
      180     def var v-elem2 as character no-undo .
      181     def var v-result-list as character no-undo init "".
      182     do ind = 1 to num-entries(parfirst-list, pardelim)
      183     :
      184       assign
      185         v-elem1 = entry(ind, parfirst-list, pardelim)
      186         v-elem2 = entry(ind, parsecond-list, pardelim)
      187       .
      188         assign
      189           v-result-list = v-result-list
      190                         + (if v-result-list > "" then pardelim-result else "")
      191                         + v-elem1 + pardelim-result + v-elem2
      192         .
      193     end.
      194     return v-result-list .
      195   END FUNCTION.
      196   define stream getmc-stream .
      197   procedure get-max-code :
      198     define input  parameter p-action         as   character                 no-undo .
      199     define input  parameter p-db-num         like restseq.db.db-num             no-undo .
      200     define input  parameter p-curr-type-cdrg like restseq.code-range.range-type no-undo .
      201     define input  parameter p-first-code     like restseq.code-range.first-code no-undo .
      202     define input  parameter p-last-code      like restseq.code-range.last-code  no-undo .
      203     define input  parameter p-view-mess      as   logical                   no-undo .
      204     define output parameter v-b-code         as   integer                   no-undo .
      205     do
      206     on error undo, return error return-value
      207     :
      208       define variable v-main-bcode     like restseq.bar-code.b-code no-undo .
      209       define variable l-prod-bc-global as   logical             no-undo .
      210       define variable l-prod-bc-weight as   logical             no-undo .
      211       define variable l-prod-bc-pgweight as   logical             no-undo .
      212       define variable rec-cnt          as   integer             no-undo .
      213       define variable str-u-f          as   character           no-undo .
      214       define variable str-u-f-rng      as   character           no-undo .
      215       define variable ind              as   integer             no-undo .
      216       define variable v-msg              as   character           no-undo initial "":U.
      217       define variable v-ret-msg          as   character           no-undo initial "":U.
      218       define frame get-max-code-inf
      219         rec-cnt label "Просмотрено"
      220         with view-as dialog-box side-labels row 11 centered
      221         title "..........................................." three-d
      222       .
      223       define buffer buf_code-range   for restseq.code-range .
      224       define buffer buf-c_code-range for restseq.code-range .
      225       define buffer buf_bar-code     for restseq.bar-code .
      226       define buffer buf_place        for restseq.place .
      227       define buffer buf_goods        for restseq.goods .
      228       define buffer buf_units        for restseq.units .
      229       define buffer buf_prod-bc      for restseq.prod-bc .
      230       define buffer buf_dis-card     for restseq.dis-card .
      231       define buffer buf_dis-rule     for restseq.dis-rule .
      232       define buffer buf_dis-time-rule     for restseq.dis-time-rule .
      233       define buffer buf_firm         for restseq.firm .
      234       define buffer buf_person       for restseq.person .
      235       define buffer buf_contract     for restseq.contract .
      236       if p-curr-type-cdrg = 'sslc':U
      237       or p-curr-type-cdrg = 'ssgb':U
      238       then do:
      239         assign
      240           v-b-code = ?
      241         .
      242         return.
      243       end.
      244       if p-curr-type-cdrg = 'sclc':U
      245       or p-curr-type-cdrg = 'pglc':U
      246         or p-curr-type-cdrg = 'sslc':U
      247       then do:
      248         assign
      249           p-db-num = 0
      250         .
      251       end.
      252       case p-action :
      253         when "get-m-code":U then do:
      254           assign
      255             v-b-code = p-first-code
      256           .
      257         end.
      258         when "f-u":U then do:
      259           assign
      260             v-b-code = 0
      261           .
      262         end.
      263       end case.
      264       case p-curr-type-cdrg :
      265         when 'dcgb':U then do:
      266   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      267   define variable v-ii0 as integer   no-undo .
      268   define variable v-table-name0 as character no-undo .
      269   define variable v-field-name0 as character no-undo .
      270   define variable buf_h0 as handle no-undo .
      271   define variable q_h0 as handle no-undo .
      272   define variable v-avail0 as integer   no-undo .
      273   define variable v-code-mess0 as character no-undo .
      274   define variable glog0 as logical   no-undo .
      275   define variable v-code_0 as integer   no-undo .
      276   case p-action :
      277     when "get-m-code":U then do:
      278       do v-ii0 = 1 to num-entries('restseq.dis-card'):
      279         assign
      280         v-table-name0 = entry(v-ii0, 'restseq.dis-card')
      281         v-field-name0 = entry(v-ii0, 'card-num')
      282         .
      283         create buffer buf_h0 for table v-table-name0.
      284         create query q_h0.
      285         q_h0:SET-BUFFERS(buf_h0).
      286         q_h0:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      287                           ,v-table-name0
      288                           ,v-field-name0
      289                           ,p-first-code
      290                           ,p-last-code)
      291                           ).
      292         q_h0:QUERY-OPEN.
      293         REPEAT while  q_h0:get-next().
      294           assign
      295             v-code_0 = buf_h0:buffer-field(v-field-name0):buffer-value
      296           .
      297           leave .
      298         END.
      299         q_h0:QUERY-CLOSE().
      300         delete object q_h0.
      301         delete object buf_h0.
      302         v-b-code = max(v-code_0, v-b-code).
      303       end.
      304     end.
      305     when "f-u":U then do:
      306       for each buf_code-range share-lock
      307           where ( buf_code-range.range-type = p-curr-type-cdrg
      308                   and buf_code-range.db-num = p-db-num
      309                   and buf_code-range.stts = "f":U
      310                 ) or
      311                 ( buf_code-range.range-type = p-curr-type-cdrg
      312                   and buf_code-range.db-num = p-db-num
      313                   and buf_code-range.stts = "u":U
      314                 )
      315       on error undo, return error
      316       :
      317         v-avail0 = 0.
      318         do v-ii0 = 1 to num-entries('restseq.dis-card'):
      319           assign
      320           v-table-name0 = entry(v-ii0, 'restseq.dis-card')
      321           v-field-name0 = entry(v-ii0, 'card-num')
      322           .
      323           create buffer buf_h0 for table v-table-name0.
      324           glog0 = buf_h0:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      325                                   , v-table-name0
      326                                   , v-field-name0
      327                                   , buf_code-range.first-code
      328                                   , buf_code-range.last-code)
      329                                   ) no-error .
      330           if buf_h0:available then do:
      331             assign
      332             v-avail0 = v-avail0 + 1
      333             .
      334             if v-avail0 = 1 then do:
      335               v-code-mess0 = string(buf_h0:buffer-field(v-field-name0):buffer-value)
      336               .
      337             end.
      338           end.
      339           delete object buf_h0.
      340        end.
      341        if v-avail0 > 0
      342           and buf_code-range.stts = "f":U
      343         then do:
      344           assign
      345             buf_code-range.stts = "u":U
      346             v-b-code            = v-b-code + 1
      347             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      348                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      349                                               , chr(10)
      350                                               , buf_code-range.first-code
      351                                               , buf_code-range.last-code
      352                                               , v-code-mess0
      353                                             )
      354           .
      355           if p-view-mess = true then do:
      356             message
      357               v-msg
      358               view-as alert-box information.
      359           end.
      360           else do:
      361             output stream getmc-stream to "getmc.log" append.
      362             put stream getmc-stream unformatted
      363               string( today, "99/99/9999" ) space(1)
      364               string( time, "HH:MM:SS" ) space(1)
      365               v-msg skip
      366             .
      367             output stream getmc-stream close.
      368           end.
      369         end.
      370         if v-avail0 = 0
      371           and buf_code-range.stts = "u":U
      372         then do:
      373           find first buf-c_code-range exclusive-lock
      374             where rowid( buf-c_code-range ) = rowid( buf_code-range )
      375           .
      376           assign
      377             buf-c_code-range.stts = "c":U
      378           .
      379           release buf-c_code-range .
      380           assign
      381             buf_code-range.stts = "f":U
      382             v-b-code            = v-b-code + 1
      383             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      384                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
      385                                               , chr(10)
      386                                               , buf_code-range.first-code
      387                                               , buf_code-range.last-code
      388                                             )
      389           .
      390           if p-view-mess = true then do:
      391             message
      392               v-msg
      393               view-as alert-box information.
      394           end.
      395           else do:
      396             output stream getmc-stream to "getmc.log" append.
      397             put stream getmc-stream unformatted
      398               string( today, "99/99/9999" ) space(1)
      399               string( time, "HH:MM:SS" ) space(1)
      400               v-msg skip
      401             .
      402             output stream getmc-stream close.
      403           end.
      404         end.
      405       end.
      406     end.
      407   end case.
      408         end.
      409         when 'ctgb':U then do:
      410   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411   define variable v-ii1 as integer   no-undo .
      412   define variable v-table-name1 as character no-undo .
      413   define variable v-field-name1 as character no-undo .
      414   define variable buf_h1 as handle no-undo .
      415   define variable q_h1 as handle no-undo .
      416   define variable v-avail1 as integer   no-undo .
      417   define variable v-code-mess1 as character no-undo .
      418   define variable glog1 as logical   no-undo .
      419   define variable v-code_1 as integer   no-undo .
      420   case p-action :
      421     when "get-m-code":U then do:
      422       do v-ii1 = 1 to num-entries('restseq.contract'):
      423         assign
      424         v-table-name1 = entry(v-ii1, 'restseq.contract')
      425         v-field-name1 = entry(v-ii1, 'contract-code')
      426         .
      427         create buffer buf_h1 for table v-table-name1.
      428         create query q_h1.
      429         q_h1:SET-BUFFERS(buf_h1).
      430         q_h1:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      431                           ,v-table-name1
      432                           ,v-field-name1
      433                           ,p-first-code
      434                           ,p-last-code)
      435                           ).
      436         q_h1:QUERY-OPEN.
      437         REPEAT while  q_h1:get-next().
      438           assign
      439             v-code_1 = buf_h1:buffer-field(v-field-name1):buffer-value
      440           .
      441           leave .
      442         END.
      443         q_h1:QUERY-CLOSE().
      444         delete object q_h1.
      445         delete object buf_h1.
      446         v-b-code = max(v-code_1, v-b-code).
      447       end.
      448     end.
      449     when "f-u":U then do:
      450       for each buf_code-range share-lock
      451           where ( buf_code-range.range-type = p-curr-type-cdrg
      452                   and buf_code-range.db-num = p-db-num
      453                   and buf_code-range.stts = "f":U
      454                 ) or
      455                 ( buf_code-range.range-type = p-curr-type-cdrg
      456                   and buf_code-range.db-num = p-db-num
      457                   and buf_code-range.stts = "u":U
      458                 )
      459       on error undo, return error
      460       :
      461         v-avail1 = 0.
      462         do v-ii1 = 1 to num-entries('restseq.contract'):
      463           assign
      464           v-table-name1 = entry(v-ii1, 'restseq.contract')
      465           v-field-name1 = entry(v-ii1, 'contract-code')
      466           .
      467           create buffer buf_h1 for table v-table-name1.
      468           glog1 = buf_h1:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      469                                   , v-table-name1
      470                                   , v-field-name1
      471                                   , buf_code-range.first-code
      472                                   , buf_code-range.last-code)
      473                                   ) no-error .
      474           if buf_h1:available then do:
      475             assign
      476             v-avail1 = v-avail1 + 1
      477             .
      478             if v-avail1 = 1 then do:
      479               v-code-mess1 = string(buf_h1:buffer-field(v-field-name1):buffer-value)
      480               .
      481             end.
      482           end.
      483           delete object buf_h1.
      484        end.
      485        if v-avail1 > 0
      486           and buf_code-range.stts = "f":U
      487         then do:
      488           assign
      489             buf_code-range.stts = "u":U
      490             v-b-code            = v-b-code + 1
      491             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      492                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      493                                               , chr(10)
      494                                               , buf_code-range.first-code
      495                                               , buf_code-range.last-code
      496                                               , v-code-mess1
      497                                             )
      498           .
      499           if p-view-mess = true then do:
      500             message
      501               v-msg
      502               view-as alert-box information.
      503           end.
      504           else do:
      505             output stream getmc-stream to "getmc.log" append.
      506             put stream getmc-stream unformatted
      507               string( today, "99/99/9999" ) space(1)
      508               string( time, "HH:MM:SS" ) space(1)
      509               v-msg skip
      510             .
      511             output stream getmc-stream close.
      512           end.
      513         end.
      514         if v-avail1 = 0
      515           and buf_code-range.stts = "u":U
      516         then do:
      517           find first buf-c_code-range exclusive-lock
      518             where rowid( buf-c_code-range ) = rowid( buf_code-range )
      519           .
      520           assign
      521             buf-c_code-range.stts = "c":U
      522           .
      523           release buf-c_code-range .
      524           assign
      525             buf_code-range.stts = "f":U
      526             v-b-code            = v-b-code + 1
      527             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      528                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
      529                                               , chr(10)
      530                                               , buf_code-range.first-code
      531                                               , buf_code-range.last-code
      532                                             )
      533           .
      534           if p-view-mess = true then do:
      535             message
      536               v-msg
      537               view-as alert-box information.
      538           end.
      539           else do:
      540             output stream getmc-stream to "getmc.log" append.
      541             put stream getmc-stream unformatted
      542               string( today, "99/99/9999" ) space(1)
      543               string( time, "HH:MM:SS" ) space(1)
      544               v-msg skip
      545             .
      546             output stream getmc-stream close.
      547           end.
      548         end.
      549       end.
      550     end.
      551   end case.
      552         end.
      553         when 'cagb':U then do:
      554   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   define variable v-ii2 as integer   no-undo .
      556   define variable v-table-name2 as character no-undo .
      557   define variable v-field-name2 as character no-undo .
