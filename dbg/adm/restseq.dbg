     1294         q_h7:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
     1295                           ,v-table-name7
     1296                           ,v-field-name7
     1297                           ,p-first-code
     1298                           ,p-last-code)
     1299                           ).
     1300         q_h7:QUERY-OPEN.
     1301         REPEAT while  q_h7:get-next().
     1302           assign
