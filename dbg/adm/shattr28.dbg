      615   procedure proc-alt-shift-f2:
      616     if not ibs.th.gbl.gbl-var:rcode
      617   then
      618     run gbl\inidebug.p .
      619   end.
      620   procedure proc-alt-shift-f3:
      621     run gbl/prvssinf.p
      622       ( input this-procedure
      623       ) .
      624   end.
      625   define variable v-inform-launched as logical no-undo initial false .
      626   procedure proc-alt-shift-f4:
      627     define variable v-action as character no-undo .
      628     if v-inform-launched = false then do:
      629       assign
      630         v-inform-launched = true
      631       .
      632       run gbl/d-inform.w
      633         (  input self
      634         ,  input this-procedure
      635         , output v-action
      636         ) no-error .
      637       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      638       assign
      639         v-inform-launched = false
      640       .
      641     end.
      642   end.
      643   procedure proc-alt-f1:
      644     run gbl/corrhelp.p
      645       (input this-procedure
      646       ) .
      647   end .
      648   on alt-shift-f2 anywhere do:
      649     run proc-alt-shift-f2.
      650   end.
      651   on alt-shift-f3 anywhere do:
      652     run proc-alt-shift-f3 in this-procedure .
      653   end.
      654   on alt-shift-f4 anywhere do:
      655     run proc-alt-shift-f4 in this-procedure.
      656   end.
      657   on alt-f1 anywhere do:
      658     run proc-alt-f1 in this-procedure .
      659   end.
      660   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661     define variable v-cntxt-db-num        as integer   no-undo .
      662     define variable v-cntxt-userid        as character no-undo .
      663     define variable v-cntxt-level         as character no-undo .
      664     define variable v-cntxt-host-code-obj as integer   no-undo .
      665     define variable v-cntxt-obj-type      as character no-undo .
      666     define variable v-cntxt-obj-code      as integer   no-undo .
      667     define variable v-cntxt-db-num-obj    as integer   no-undo .
      668     define variable v-cntxt-is-admin      as logical   no-undo .
      669   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      670   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      671   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      672   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      673   define variable v-tth as handle no-undo .
      674   assign
      675   v-tth = buffer thbjattr_thbj-attr:table-handle .
      676   DEFINE BUTTON B-exit AUTO-GO
      677        LABEL "&Ввод"
      678        SIZE 10 BY 1
      679        BGCOLOR 8 .
      680   DEFINE BUTTON B-Help
      681        LABEL "Помо&щь"
      682        SIZE 3 BY 1
      683        BGCOLOR 8 .
      684   DEFINE BUTTON b-quit AUTO-END-KEY
      685        LABEL "&Отмена"
      686        SIZE 10 BY 1
      687        BGCOLOR 8 .
      688   DEFINE VARIABLE f-master-key AS CHARACTER FORMAT "X(8)":U INITIAL "200"
      689        LABEL "Номер Мастер-ключа"
      690        VIEW-AS FILL-IN
      691        SIZE 9 BY 1 NO-UNDO.
      692   DEFINE FRAME Dialog-Frame
      693        B-exit AT ROW 1 COL 1
      694        b-quit AT ROW 1 COL 11
      695        B-Help AT ROW 1 COL 95
      696        f-master-key AT ROW 3.13 COL 21 COLON-ALIGNED
      697        SPACE(67.24) SKIP(4.67)
      698       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      699            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      700            TITLE "Опции работы с системой EasyFuel"
      701            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      702   ASSIGN
      703          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      704          FRAME Dialog-Frame:HIDDEN           = TRUE.
      705   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      706   DO:
      707     APPLY "END-ERROR":U TO SELF.
      708   END.
      709   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      710   DO:
      711     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      712     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      713   END.
      714   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      715   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      716   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   on help of frame Dialog-Frame
      718   do:
      719     run gbl/app_help.p
      720       (input this-procedure :file-name
      721       ,input ''
      722       ,input ?
      723       ) no-error.
      724     if error-status :error then do:
      725       message
      726         "Ошибка при вызове помощи"
      727         error-status :get-message(1)
      728         view-as alert-box .
      729     end.
      730   end.
      731   run minbtn-set in this-procedure .
      732   on choose of b-help in frame Dialog-Frame
      733   do:
      734     apply "help":u to frame Dialog-Frame .
      735   end.
      736   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      737   procedure minbtn-set :
      738       do
      739           on error undo, return error return-value
      740           :
      741           define variable ii              as integer       no-undo .
      742           define variable fh              as widget-handle no-undo .
      743           define variable hh              as widget-handle no-undo .
      744           define variable v-h             as handle        extent 4 no-undo .
      745           define variable v-name-button   as character     no-undo .
      746           define variable v-help-old-x    as decimal       no-undo .
      747           define variable v-help-old-y    as decimal       no-undo .
      748           define variable v-help-old-size as decimal       no-undo .
      749           define variable v-frame-width   as decimal       no-undo .
      750           define variable jj              as integer       no-undo .
      751           do
      752               on error undo, return error
      753               :
      754               assign
      755                   v-frame-width = frame Dialog-Frame:width - 0.3
      756                   fh            = frame Dialog-Frame:first-child
      757                   hh            = fh:first-child
      758                   ii            = 1
      759                   .
      760               do while valid-handle(hh):
      761                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      762                   do:
      763                       case lc(hh:name) :
      764                           when "b-help" then
      765                               do:
      766                                   hh:load-image-up("cmp/b-help.bmp":u) .
      767                                   hh:load-image-down("cmp/b-help.bmp":u) .
      768                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      769                                   hh:TOOLTIP = "Помощь" .
      770                                   v-help-old-x = hh:column .
      771                                   v-help-old-y = hh:row    .
      772                                   v-help-old-size = hh:width .
      773                                   hh:width-chars = 2.5 .
      774                               end.
      775                           when "b-print" then
      776                               do:
      777                                   hh:load-image("cmp/b-print.bmp":u) .
      778                                   hh:TOOLTIP = "Печать" .
      779                                   v-h[ii] = hh:handle .
      780                                   ii = ii + 1 .
      781                                   hh:width-chars = 3 .
      782                               end.
      783                           when "b-history" or
      784                           when "b-hist" then
      785                               do:
      786                                   hh:load-image("cmp/b-hist.bmp":u) .
      787                                   hh:TOOLTIP = "История" .
      788                                   v-h[ii] = hh:handle .
      789                                   ii = ii + 1 .
      790                                   hh:width-chars = 3 .
      791                               end.
      792                           when "b-sch" then
      793                               do:
      794                                   hh:load-image("cmp/b-sch.bmp":u) .
      795                                   hh:TOOLTIP = "Установка Фильтра" .
      796                                   v-h[ii] = hh:handle .
      797                                   ii = ii + 1 .
      798                                   hh:width-chars = 3 .
      799                               end.
      800                           when "b-hist-user" then
      801                               do:
      802                                   hh:load-image("cmp/b-hist.bmp":u) .
      803                                   hh:TOOLTIP = "История пользователя" .
      804                                   ii = ii + 1 .
      805                               end.
      806                       end case.
      807                   end.
      808                   hh = hh:next-sibling.
      809               end.
      810               b-help:column = v-frame-width - b-help:width-chars.
      811               jj = 0.
      812               repeat ii = 4 to 1 by -1 :
      813                   if valid-handle (v-h[ii] ) then
      814                   do:
      815                       jj  = jj + 1 .
      816                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      817                       v-h[ii]:row    = v-help-old-y .
      818                   end.
      819               end.
      820           end.
      821       end.
      822   end procedure.
      823   MAIN-BLOCK:
      824   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      825      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      826   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      827     run mainmenu_getcntxt in parparentproc
      828       (output v-cntxt-db-num
      829       ,output v-cntxt-userid
      830       ,output v-cntxt-level
      831       ,output v-cntxt-host-code-obj
      832       ,output v-cntxt-obj-type
      833       ,output v-cntxt-obj-code
      834       ,output v-cntxt-db-num-obj
      835       ,output v-cntxt-is-admin
      836       ) .
      837   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   ON TAB ANYWHERE
      839   DO:
      840   define variable ii as integer no-undo .
      841   define variable fh as widget-handle no-undo .
      842   define variable hh as widget-handle no-undo .
      843   define variable v-next-widget-name as character no-undo .
      844   if v-tab-order <> '' then do:
      845     if self:type = "TOGGLE-BOX" then
      846     self:BGCOLOR = ?.
      847     assign
      848     ii = lookup(self:name, v-tab-order).
      849     assign
      850     ii = ii + 1
      851     v-next-widget-name = entry(ii, v-tab-order)
      852     no-error .
      853     if error-status:error then do:
      854       assign
      855       ii = 1
      856       v-next-widget-name = entry( ii, v-tab-order)
      857       .
      858     end.
      859     assign
      860     fh = frame Dialog-Frame:first-child
      861     hh = fh:first-child
      862     .
      863     do while valid-handle(hh):
      864       if hh:name = v-next-widget-name then do:
      865         if hh:sensitive  = yes
      866         AND hh:visible = yes then do:
      867           if hh:type = "TOGGLE-BOX":U then do:
      868             assign
      869             hh:BGcolor = 1
      870             .
      871           end.
      872           APPLY "ENTRY" to hh.
      873           return no-apply.
      874         end.
      875         else do:
      876           APPLY "TAB" to hh.
      877           return no-apply.
      878         end.
      879       end.
      880       hh = hh:next-sibling.
      881     end.
      882   end.
      883   END.
      884   ON BACK-TAB ANYWHERE
      885   DO:
      886   define variable ii as integer no-undo .
      887   define variable fh as widget-handle no-undo .
      888   define variable hh as widget-handle no-undo .
      889   define variable v-next-widget-name as character no-undo .
      890   if v-tab-order <> '' then do:
      891     assign
      892     ii = lookup(self:name, v-tab-order).
      893     .
      894     assign
      895     ii = (if ii = 1
      896           then  num-entries(v-tab-order)
      897           else ii - 1
      898           )
      899     v-next-widget-name = entry(ii, v-tab-order)
      900     .
      901     assign
      902     fh = frame Dialog-Frame:first-child
      903     hh = fh:first-child
      904     .
      905     do while valid-handle(hh):
      906       if hh:name = v-next-widget-name then do:
      907         if hh:sensitive  = yes
      908         AND hh:visible = yes then do:
      909           if hh:type = "TOGGLE-BOX":U then do:
      910             assign
      911             hh:BGcolor = 1
      912             .
      913           end.
      914           APPLY "ENTRY" to hh.
      915           return no-apply.
      916         end.
      917         else do:
      918         APPLY "BACK-TAB" to hh.
      919         return no-apply.
      920         end.
      921       end.
      922       hh = hh:next-sibling.
      923     end.
      924     end.
      925   END.
      926   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      927   ON RETURN ANYWHERE
      928   DO:
      929   define variable ii as integer no-undo .
      930   define variable fh as widget-handle no-undo .
      931   define variable hh as widget-handle no-undo .
      932   define variable v-next-widget-name as character no-undo .
      933     if v-tab-order <> '' then do:
      934       assign
      935       ii = lookup(self:name, v-tab-order).
      936       if ii = num-entries(v-tab-order) then do:
      937           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      938           return no-apply.
      939       end.
      940       if self:type <> "BUTTON" and
      941         self:type <> "EDITOR"  then do:
      942         run proc-move-forward in this-procedure .
      943         return no-apply.
      944       end.
      945       if self:type = "BUTTON" then do:
      946         APPLY "CHOOSE" to self.
      947       end.
      948       if self:type = "TOGGLE-BOX" then
      949       self:BGCOLOR = ?.
      950       assign
      951       ii = ii + 1
      952       v-next-widget-name = entry(ii, v-tab-order)
      953       no-error .
      954       if error-status:error then do:
      955         assign
      956         ii = 1
      957         v-next-widget-name = entry( ii, v-tab-order)
      958         .
      959       end.
      960       assign
      961       fh = frame Dialog-Frame:first-child
      962       hh = fh:first-child
      963       .
      964       do while valid-handle(hh):
      965         if hh:name = v-next-widget-name then do:
      966           if hh:sensitive  = yes
      967           AND hh:visible = yes then do:
      968             if hh:type = "TOGGLE-BOX":U then do:
      969               assign
      970               hh:BGcolor = 1
      971               .
      972             end.
      973             APPLY "ENTRY" to hh.
      974             return no-apply.
      975           end.
      976           else do:
      977             APPLY "TAB" to hh.
      978             return no-apply.
      979           end.
      980         end.
      981         hh = hh:next-sibling.
      982       end.
      983     end.
      984   END.
      985   procedure proc-move-forward :
      986   define variable ii as integer no-undo .
      987   define variable fh as widget-handle no-undo .
      988   define variable hh as widget-handle no-undo .
      989   define variable v-next-widget-name as character no-undo .
      990   do
      991   on error undo, return error
      992   :
      993     if v-tab-order <> '' then do:
      994       if self:type = "TOGGLE-BOX" then
      995       self:BGCOLOR = ?.
      996       assign
      997       ii = lookup(self:name, v-tab-order).
      998       assign
      999       ii = ii + 1
     1000       v-next-widget-name = entry(ii, v-tab-order)
     1001       no-error .
     1002       if error-status:error then do:
     1003         assign
     1004         ii = 1
     1005         v-next-widget-name = entry( ii, v-tab-order)
     1006         .
     1007       end.
     1008       assign
     1009       fh = frame Dialog-Frame:first-child
     1010       hh = fh:first-child
     1011       .
     1012       do while valid-handle(hh):
     1013         if hh:name = v-next-widget-name then do:
     1014           if hh:sensitive  = yes
     1015           AND hh:visible = yes then do:
     1016             if hh:type = "TOGGLE-BOX":U then do:
     1017               assign
     1018               hh:BGcolor = 1
     1019               .
     1020             end.
     1021             APPLY "ENTRY" to hh.
     1022             return.
     1023           end.
     1024           else do:
     1025             assign
     1026             ii = ii + 1
     1027             v-next-widget-name = entry(ii, v-tab-order)
     1028             no-error .
     1029             if error-status:error then do:
     1030               assign
     1031               ii = 1
     1032               v-next-widget-name = entry( ii, v-tab-order)
     1033               .
     1034             end.
     1035           end.
     1036         end.
     1037         hh = hh:next-sibling.
     1038       end.
     1039     end.
     1040   end.
     1041   end procedure.
     1042     IF p-mode <> 'ПРОСМОТР':U
     1043     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1044         MESSAGE
     1045         vss-workfile vss-revision vss-description skip
     1046         "Неверное значение параметра p-mode" p-mode
     1047         VIEW-AS ALERT-BOX ERROR.
     1048         UNDO, RETURN ERROR.
     1049     END.
     1050     IF p-obj-type <> 'маг':U
     1051     and p-obj-type <> 'орг':U
     1052     and p-obj-type <> '':U
     1053     THEN DO:
     1054         MESSAGE
     1055         vss-workfile vss-revision vss-description skip
     1056         "Неверное значение параметра p-obj-type" p-obj-type
     1057         VIEW-AS ALERT-BOX ERROR.
     1058         UNDO, RETURN ERROR.
     1059     END.
     1060     if p-obj-type = 'маг':U then do:
     1061       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1062       IF NOT AVAILABLE X_shop THEN DO:
     1063           MESSAGE
     1064           vss-workfile vss-revision vss-description skip
     1065           "Неверное значение параметра p-obj-code" p-obj-code
     1066           VIEW-AS ALERT-BOX ERROR.
     1067           UNDO, RETURN ERROR.
     1068       END.
     1069   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1071     (input  'маг':U
     1072     ,input  p-obj-code
     1073     ,output v-db-num
     1074     )  .
     1075       IF v-db-num <> v-cntxt-db-num
     1076       AND v-cntxt-db-num <> 0
     1077       and p-mode <> 'ПРОСМОТР':U
     1078       THEN DO:
     1079           MESSAGE
     1080           "Нельзя менять параметры магазина в чужой БД" skip
     1081           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1082           VIEW-AS ALERT-BOX ERROR.
     1083           UNDO, RETURN ERROR.
     1084       END.
     1085     end.
     1086     if p-obj-type = 'орг':U then do:
     1087       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1088       IF NOT AVAILABLE X_sysconf THEN DO:
     1089           MESSAGE
     1090           vss-workfile vss-revision vss-description skip
     1091           "Неверное значение параметра p-obj-code" p-obj-code
     1092           VIEW-AS ALERT-BOX ERROR.
     1093           UNDO, RETURN ERROR.
     1094       END.
     1095       if v-cntxt-db-num <> 0
     1096       and p-mode <> 'ПРОСМОТР':U
     1097       then do:
     1098           MESSAGE
     1099           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1100           VIEW-AS ALERT-BOX ERROR.
     1101           UNDO, RETURN ERROR.
     1102       end.
     1103     end.
     1104     if p-obj-type = '':U then do:
     1105       if v-cntxt-db-num <> 0
     1106       and p-mode <> 'ПРОСМОТР':U
     1107       then do:
     1108           MESSAGE
     1109           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1110           VIEW-AS ALERT-BOX ERROR.
     1111           UNDO, RETURN ERROR.
     1112       end.
     1113     end.
     1114     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1115       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1116                 LOCKED_thbj-attr.obj-type = p-obj-type
     1117           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1118           AND   LOCKED_thbj-attr.upper-prop-code = 'easyfuel':U
     1119           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1120        if locked locked_thbj-attr then do:
     1121           message
     1122           vss-workfile vss-revision vss-description skip
     1123            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1124           view-as alert-box error .
     1125           undo, return error.
     1126         end.
     1127     END.
     1128     ELSE DO:
     1129         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1130             LOCKED_thbj-attr.obj-type = p-obj-type
     1131       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1132       AND   LOCKED_thbj-attr.upper-prop-code = 'easyfuel':U
     1133       and   locked_thbj-attr.prop-code = '':U
     1134       NO-ERROR.
     1135     END.
     1136     if not available locked_thbj-attr then do:
     1137       ASSIGN
     1138       v-to-create  = YES.
     1139       message
     1140       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1141                   chr(10))
     1142       view-as alert-box WARNING.
     1143     end.
     1144     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1145     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1146     RUN Myenable.
     1147     WAIT-FOR GO OF FRAME Dialog-Frame.
     1148   END.
     1149   RUN disable_UI.
     1150   PROCEDURE disable_UI :
     1151     HIDE FRAME Dialog-Frame.
     1152   END PROCEDURE.
     1153   PROCEDURE enable_UI :
     1154     DISPLAY f-master-key
     1155         WITH FRAME Dialog-Frame.
     1156     ENABLE B-exit b-quit B-Help f-master-key
     1157         WITH FRAME Dialog-Frame.
     1158     VIEW FRAME Dialog-Frame.
     1159   END PROCEDURE.
     1160   PROCEDURE fill-widgets :
     1161   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1162   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1163   define variable v-param-type as character no-undo .
     1164   define variable v-param-value as character no-undo .
     1165   define variable v-value-character as character no-undo .
     1166   define variable v-value-date as date no-undo .
     1167   define variable v-value-decimal as decimal no-undo .
     1168   define variable v-value-integer as INTEGER no-undo .
     1169   define variable v-value-logical AS LOGICAL no-undo .
     1170   FOR EACH thbjattr_thbj-attr:
     1171     delete thbjattr_thbj-attr.
     1172   end.
     1173   FOR EACH temp-thbj-attr:
     1174     delete temp-thbj-attr.
     1175   end.
     1176   run adm/shattri.p (
     1177                 input "init":U
     1178               , input p-obj-type
     1179               , input p-obj-code
     1180               , input 'easyfuel':U
     1181               , input "":U
     1182               , output v-value-character
     1183               , output v-value-date
     1184               , output v-value-decimal
     1185               , output v-value-integer
     1186               , output v-value-logical
     1187               , output v-param-type
     1188               , INPUT-OUTPUT TABLE-handle v-tth
     1189               ) no-error .
     1190   if error-status:error
     1191   and not available locked_thbj-attr then do:
     1192     message
     1193     "Не удалось получить начальные значения настроек" skip
     1194     error-status:get-message(1) return-value
     1195     view-as alert-box error .
     1196     undo, return error .
     1197   end.
     1198   FOR EACH thbjattr_thbj-attr:
     1199     ASSIGN
     1200     v-entry = thbjattr_thbj-attr.prop-code.
     1201     IF v-entry = 'master-key':U THEN DO:
     1202       ASSIGN
     1203       f-master-key = thbjattr_thbj-attr.property-value-character
     1204       f-master-key:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1205       .
     1206     END.
     1207     create temp-thbj-attr.
     1208     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1209   END.
     1210   END PROCEDURE.
     1211   PROCEDURE MyEnable :
     1212   ASSIGN
     1213   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1214   v-tab-order = "f-master-key".
     1215   DISPLAY
     1216   f-master-key
     1217   WITH FRAME Dialog-Frame.
     1218   ENABLE
     1219   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1220   b-quit
     1221   B-Help
     1222   f-master-key WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1223   WITH FRAME Dialog-Frame.
     1224   VIEW FRAME Dialog-Frame.
     1225   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1226       HIDE
     1227       b-exit
     1228       IN FRAME Dialog-Frame.
     1229       ASSIGN
     1230       b-quit:LABEL = "&Выход"
     1231       .
     1232   END.
     1233   END PROCEDURE.
     1234   PROCEDURE proc-save :
     1235   define variable v-value-character as character no-undo .
     1236   define variable v-value-date as date no-undo .
     1237   define variable v-value-decimal as decimal no-undo .
     1238   define variable v-value-integer as INTEGER no-undo .
     1239   define variable v-value-logical AS LOGICAL no-undo .
     1240   define variable v-param-type as character no-undo .
     1241   define variable wh as widget-handle no-undo .
     1242   define variable fh as widget-handle no-undo .
     1243   define variable v-same as logical no-undo .
     1244   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1245   ASSIGN
     1246   FRAME Dialog-Frame
     1247   f-master-key
     1248   .
     1249   assign
     1250   fh = frame Dialog-Frame:first-child
     1251   wh = fh:first-child
     1252   .
     1253   do while valid-handle(wh):
     1254     if wh:private-data begins "recid=" then do:
     1255       find first thbjattr_thbj-attr where
     1256                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1257       assign
     1258       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1259     end.
     1260     wh = wh:next-sibling.
     1261   end.
     1262   v-same = yes.
     1263   for each thbjattr_thbj-attr,
     1264       first temp-thbj-attr where
     1265             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1266         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1267         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1268         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1269      buffer-compare
     1270      thbjattr_thbj-attr
     1271      to temp-thbj-attr
     1272      save result in v-same.
     1273      if v-same = no then leave.
     1274   end.
     1275   v-same = no.
     1276   IF v-same  and not v-to-create THEN RETURN.
     1277   run adm/shattri.p (
     1278                  input "check":U
     1279                , input p-obj-type
     1280                , input p-obj-code
     1281                , input 'easyfuel':U
     1282                , input '':U
     1283                , output v-value-character
     1284                , output v-value-date
     1285                , output v-value-decimal
     1286                , output v-value-integer
     1287                , output v-value-logical
     1288                , output v-param-type
     1289                , input-output TABLE-handle v-tth
     1290               ) no-error .
     1291   if error-status:error then do:
     1292     message
     1293     "Некорректное значение ПАРАМЕТРОВ" skip
     1294     error-status:get-message(1) skip
     1295     return-value
     1296     view-as alert-box error .
     1297     undo, return error .
     1298   end.
     1299   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1300        input p-obj-type
     1301       ,input p-obj-code
     1302       ,input 'easyfuel':U
     1303       ,input table thbjattr_thbj-attr
     1304   ) NO-ERROR.
     1305   IF ERROR-STATUS:error THEN do:
     1306     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1307     RETURN-VALUE
     1308     VIEW-AS ALERT-BOX.
     1309     UNDO, RETURN ERROR.
     1310   END.
     1311   END PROCEDURE.
