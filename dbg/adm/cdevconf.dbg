        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Конфигурация логирования кассы IBS TH POS".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#library  as handle no-undo .
       63   define new global shared variable g#library2 as handle no-undo .
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   procedure proc-alt-shift-f2:
      319     if not ibs.th.gbl.gbl-var:rcode
      320   then
      321     run gbl\inidebug.p .
      322   end.
      323   procedure proc-alt-shift-f3:
      324     run gbl/prvssinf.p
      325       ( input this-procedure
      326       ) .
      327   end.
      328   define variable v-inform-launched as logical no-undo initial false .
      329   procedure proc-alt-shift-f4:
      330     define variable v-action as character no-undo .
      331     if v-inform-launched = false then do:
      332       assign
      333         v-inform-launched = true
      334       .
      335       run gbl/d-inform.w
      336         (  input self
      337         ,  input this-procedure
      338         , output v-action
      339         ) no-error .
      340       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      341       assign
      342         v-inform-launched = false
      343       .
      344     end.
      345   end.
      346   procedure proc-alt-f1:
      347     run gbl/corrhelp.p
      348       (input this-procedure
      349       ) .
      350   end .
      351   on alt-shift-f2 anywhere do:
      352     run proc-alt-shift-f2.
      353   end.
      354   on alt-shift-f3 anywhere do:
      355     run proc-alt-shift-f3 in this-procedure .
      356   end.
      357   on alt-shift-f4 anywhere do:
      358     run proc-alt-shift-f4 in this-procedure.
      359   end.
      360   on alt-f1 anywhere do:
      361     run proc-alt-f1 in this-procedure .
      362   end.
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure cur-time :
      365      define output parameter p-today as date      no-undo .
      366      define output parameter p-time  as integer   no-undo .
      367     do
      368     on error undo, return error
      369     :
      370       define variable v-date1 as date      no-undo .
      371       define variable v-date2 as date      no-undo .
      372       define variable v-time  as integer   no-undo .
      373       assign
      374         v-date1 = today
      375         v-time  = time
      376         v-date2 = today
      377       .
      378       if v-date1 <> v-date2
      379       then do:
      380         assign
      381           v-date1 = today
      382           v-time  = v-time
      383         .
      384       end.
      385       assign
      386         p-today = v-date1
      387         p-time  = v-time
      388       .
      389     end.
      390   end.
      391   function cur-time-date returns character
      392   :
      393     return string(today, '99/99/9999':U) .
      394   end.
      395   function cur-time-mjd returns decimal
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return integer(v-date) - 2400002 + (v-time / 86400) .
      404   end.
      405   function cur-time-get-ending-index returns integer
      406   (input p-number as integer
      407   )
      408   :
      409     if p-number < 0
      410     or p-number = ?
      411     then do:
      412       return 1 .
      413     end.
      414     define variable v-rest as integer   no-undo .
      415     assign
      416       p-number = p-number modulo 100
      417     .
      418     if p-number < 20
      419     then do:
      420       assign
      421         v-rest = p-number
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-rest = p-number modulo 10
      427       .
      428     end.
      429     case v-rest :
      430       when 1
      431       then do:
      432         return 2 .
      433       end.
      434       when 2 or
      435       when 3 or
      436       when 4
      437       then do:
      438         return 3 .
      439       end.
      440       otherwise do:
      441         return 1 .
      442       end.
      443     end case .
      444   end.
      445   procedure cur-time-mjd-to-date :
      446      define input  parameter i-mjd-diff as decimal no-undo.
      447      define output parameter o-Date     as date    no-undo.
      448      define output parameter o-Time     as integer no-undo.
      449      define variable v-day-number as integer   no-undo .
      450      if    i-mjd-diff < 0
      451         or i-mjd-diff = ?
      452      then do:
      453         return "?" .
      454      end.
      455      assign
      456         v-day-number = truncate(i-mjd-diff,0).
      457         o-Date = date(v-day-number + 2400002).
      458         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460   end.
      461   function cur-time-mjd-to-string returns character
      462   (input p-mjd-diff as decimal
      463   )
      464   :
      465     define variable v-day-number as integer   no-undo .
      466     define variable v-seconds    as integer   no-undo .
      467     define variable v-hour       as integer   no-undo .
      468     define variable v-min        as integer   no-undo .
      469     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      470     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      471     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      472     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      473     if p-mjd-diff < 0
      474     or p-mjd-diff = ?
      475     then do:
      476       return "?" .
      477     end.
      478     assign
      479       v-day-number = integer(truncate(p-mjd-diff,0))
      480       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482     if v-seconds > 86400
      483     then do:
      484       assign
      485         v-seconds = 86400 - 1
      486       .
      487     end.
      488     if v-seconds < 0
      489     then do:
      490       assign
      491         v-seconds = 0
      492       .
      493     end.
      494     assign
      495       v-hour = truncate(v-seconds / 3600, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 3600
      499     .
      500     assign
      501       v-min = truncate(v-seconds / 60, 0)
      502     .
      503     assign
      504       v-seconds = v-seconds modulo 60
      505     .
      506     return
      507         (if v-day-number <> 0
      508           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      509           else ""
      510         )
      511       + (if v-day-number <> 0 or v-hour <> 0
      512           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      513           else ""
      514         )
      515       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      516           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      517           else ""
      518         )
      519       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      520       .
      521   end.
      522   function cur-time-string returns character
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      531   end.
      532   function cur-time-string-sec returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      541   end.
      542   function cur-time-custom  returns character
      543   (input p-prefix as character
      544   ,input p-date-format as character
      545   ,input p-delimiter as character
      546   ,input p-time-format as character
      547   ,input p-suffix as character
      548   )
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return
      557       p-prefix
      558       + string(v-date, p-date-format)
      559       + p-delimiter
      560       + string(v-time, p-time-format)
      561       + p-suffix
      562       .
      563   end.
      564   function cur-time-print  returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      573   end.
      574   function cur-time-datetime returns datetime
      575   :
      576     define variable v-char as character no-undo .
      577     define variable v-datetime as datetime no-undo .
      578     v-char = cur-time-string().
      579     v-datetime = datetime(v-char).
      580     return  v-datetime.
      581   end.
      582   function cur-time-string-msec returns character
      583   :
      584     define variable v-date as datetime  no-undo .
      585     v-date = now.
      586     return string(v-date) .
      587   end.
      588   define variable v-layout-tables as character no-undo.
      589   define variable v-layout-table-names as character no-undo.
      590   define variable v-sys-key as character no-undo .
      591   define variable v-ibs as logical no-undo .
      592   define variable glog as logical no-undo .
      593   DEFINE BUFFER buf_file FOR dictdb._file.
      594   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER )  FORWARD.
      595   DEFINE BUTTON b-export
      596        LABEL "&Экспорт"
      597        SIZE 10 BY 1.
      598   DEFINE BUTTON B-Help
      599        LABEL "Помо&щь"
      600        SIZE 3 BY 1
      601        BGCOLOR 8 .
      602   DEFINE BUTTON b-import
      603        LABEL "&Импорт"
      604        SIZE 10 BY 1.
      605   DEFINE BUTTON b-quit AUTO-END-KEY
      606        LABEL "&Выход"
      607        SIZE 10 BY 1
      608        BGCOLOR 8 .
      609   DEFINE BUTTON B-sel
      610        LABEL "В&ыбор"
      611        SIZE 10 BY 1.
      612   DEFINE VARIABLE rs-language AS CHARACTER
      613        VIEW-AS RADIO-SET HORIZONTAL
      614        RADIO-BUTTONS
      615             "Item 1", "1",
      616   "Item 2", "2"
      617        SIZE 21 BY 1 NO-UNDO.
      618   DEFINE QUERY br-laytables FOR
      619         buf_file SCROLLING.
      620   DEFINE BROWSE br-laytables
      621     QUERY br-laytables DISPLAY
      622         buf_file._file-name FORMAT "X(32)" COLUMN-LABEL "Таблицы"
      623   get-tbl-fname (buf_file._file-name) FORMAT "X(62)" COLUMN-LABEL "Описание"
      624       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.25 FIT-LAST-COLUMN.
      625   DEFINE FRAME Dialog-Frame
      626        b-quit AT ROW 1 COL 1
      627        B-sel AT ROW 1 COL 21 WIDGET-ID 2
      628        b-export AT ROW 1 COL 48 WIDGET-ID 4
      629        b-import AT ROW 1 COL 58 WIDGET-ID 10
      630        B-Help AT ROW 1 COL 95
      631        rs-language AT ROW 2 COL 33.5 NO-LABEL WIDGET-ID 6
      632        br-laytables AT ROW 3 COL 1 WIDGET-ID 100
      633        SPACE(0.69) SKIP(0.02)
      634       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      635            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      636            TITLE "Справочники конфигурации раскладок"
      637            CANCEL-BUTTON b-quit.
      638   ASSIGN
      639          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      640          FRAME Dialog-Frame:HIDDEN           = TRUE.
      641   ASSIGN
      642          b-export:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      643   ASSIGN
      644          b-import:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      645   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      646   DO:
      647     APPLY "END-ERROR":U TO SELF.
      648   END.
      649   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      650   DO:
      651   END.
      652   ON CHOOSE OF b-import IN FRAME Dialog-Frame
      653   DO:
      654   END.
      655   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      656   DO:
      657     run proc-b-sel IN THIS-PROCEDURE NO-ERROR.
      658     IF ERROR-STATUS:ERROR THEN DO:
      659        RETURN NO-APPLY.
      660     END.
      661   END.
      662   ON DEFAULT-ACTION OF br-laytables IN FRAME Dialog-Frame
      663   DO:
      664     APPLY "CHOOSE" TO b-sel.
      665   END.
      666   ON VALUE-CHANGED OF rs-language IN FRAME Dialog-Frame
      667   DO:
      668     ASSIGN
      669     rs-language.
      670     CASE rs-language:
      671       WHEN "ABL" THEN DO:
      672         buf_file._file-name:VISIBLE IN BROWSE br-laytables = YES.
      673       END.
      674       WHEN "rus" THEN DO:
      675         buf_file._file-name:VISIBLE IN BROWSE br-laytables = NO.
      676       END.
      677     END CASE.
      678   END.
      679   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      680   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      681   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   on help of frame Dialog-Frame
      683   do:
      684     run gbl/app_help.p
      685       (input this-procedure :file-name
      686       ,input ''
      687       ,input ?
      688       ) no-error.
      689     if error-status :error then do:
      690       message
      691         "Ошибка при вызове помощи"
      692         error-status :get-message(1)
      693         view-as alert-box .
      694     end.
      695   end.
      696   run minbtn-set in this-procedure .
      697   on choose of b-help in frame Dialog-Frame
      698   do:
      699     apply "help":u to frame Dialog-Frame .
      700   end.
      701   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   procedure minbtn-set :
      703       do
      704           on error undo, return error return-value
      705           :
      706           define variable ii              as integer       no-undo .
      707           define variable fh              as widget-handle no-undo .
      708           define variable hh              as widget-handle no-undo .
      709           define variable v-h             as handle        extent 4 no-undo .
      710           define variable v-name-button   as character     no-undo .
      711           define variable v-help-old-x    as decimal       no-undo .
      712           define variable v-help-old-y    as decimal       no-undo .
      713           define variable v-help-old-size as decimal       no-undo .
      714           define variable v-frame-width   as decimal       no-undo .
      715           define variable jj              as integer       no-undo .
      716           do
      717               on error undo, return error
      718               :
      719               assign
      720                   v-frame-width = frame Dialog-Frame:width - 0.3
      721                   fh            = frame Dialog-Frame:first-child
      722                   hh            = fh:first-child
      723                   ii            = 1
      724                   .
      725               do while valid-handle(hh):
      726                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      727                   do:
      728                       case lc(hh:name) :
      729                           when "b-help" then
      730                               do:
      731                                   hh:load-image-up("cmp/b-help.bmp":u) .
      732                                   hh:load-image-down("cmp/b-help.bmp":u) .
      733                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      734                                   hh:TOOLTIP = "Помощь" .
      735                                   v-help-old-x = hh:column .
      736                                   v-help-old-y = hh:row    .
      737                                   v-help-old-size = hh:width .
      738                                   hh:width-chars = 2.5 .
      739                               end.
      740                           when "b-print" then
      741                               do:
      742                                   hh:load-image("cmp/b-print.bmp":u) .
      743                                   hh:TOOLTIP = "Печать" .
      744                                   v-h[ii] = hh:handle .
      745                                   ii = ii + 1 .
      746                                   hh:width-chars = 3 .
      747                               end.
      748                           when "b-history" or
      749                           when "b-hist" then
      750                               do:
      751                                   hh:load-image("cmp/b-hist.bmp":u) .
      752                                   hh:TOOLTIP = "История" .
      753                                   v-h[ii] = hh:handle .
      754                                   ii = ii + 1 .
      755                                   hh:width-chars = 3 .
      756                               end.
      757                           when "b-sch" then
      758                               do:
      759                                   hh:load-image("cmp/b-sch.bmp":u) .
      760                                   hh:TOOLTIP = "Установка Фильтра" .
      761                                   v-h[ii] = hh:handle .
      762                                   ii = ii + 1 .
      763                                   hh:width-chars = 3 .
      764                               end.
      765                           when "b-hist-user" then
      766                               do:
      767                                   hh:load-image("cmp/b-hist.bmp":u) .
      768                                   hh:TOOLTIP = "История пользователя" .
      769                                   ii = ii + 1 .
      770                               end.
      771                       end case.
      772                   end.
      773                   hh = hh:next-sibling.
      774               end.
      775               b-help:column = v-frame-width - b-help:width-chars.
      776               jj = 0.
      777               repeat ii = 4 to 1 by -1 :
      778                   if valid-handle (v-h[ii] ) then
      779                   do:
      780                       jj  = jj + 1 .
      781                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      782                       v-h[ii]:row    = v-help-old-y .
      783                   end.
      784               end.
      785           end.
      786       end.
      787   end procedure.
      788   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      789   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      790   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      791   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      792   define variable v-diasize-current-frame-width  as decimal   no-undo .
      793   define variable v-diasize-current-frame-height as decimal   no-undo .
      794   define variable v-diasize-change-size          as logical   no-undo .
      795   define variable v-diasize-resize-button        as handle    no-undo .
      796   define variable v-diasize-wndmax               as logical   no-undo .
      797   define variable v-diasize-wndstore             as logical   no-undo .
      798   define variable v-diasize-proc-name            as character no-undo .
      799   define variable v-diasize-browse-handle        as handle    no-undo .
      800   define variable v-diasize-browse-number        as integer   no-undo .
      801   define variable v-diasize-need-full-display    as logical   no-undo init false .
      802   define temp-table temp-diasize-handle no-undo
      803     field handle-value  as handle
      804     field save-position as decimal
      805     index xpk is primary unique handle-value
      806     .
      807   define temp-table temp-browse-handle no-undo
      808     field browse-type   as character
      809     field browse-number as integer
      810     field browse-handle as handle
      811     field original-size as decimal
      812     index xpk is primary unique browse-type browse-number
      813     index xie browse-type browse-handle
      814   .
      815   procedure diasize_change-height :
      816     define input  parameter p-change-value  as decimal   no-undo .
      817     define input  parameter p-move-resize   as logical   no-undo .
      818     define variable v-field-group-handle    as handle    no-undo .
      819     define variable v-object-handle         as handle    no-undo .
      820     define variable v-frame-height          as decimal   no-undo .
      821     define variable v-frame-virtual-height  as decimal   no-undo .
      822     define variable v-browse-height         as decimal   no-undo .
      823     define variable v-window-height         as decimal   no-undo .
      824     define variable v-window-virtual-height as decimal   no-undo .
      825     define variable v-change-sign           as integer   no-undo .
      826     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      827     define buffer buf_temp-browse-handle  for temp-browse-handle .
      828     if p-change-value > 0
      829     then do:
      830       if frame Dialog-Frame :height + p-change-value
      831           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      832       then do:
      833         assign
      834           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      835                           - (frame Dialog-Frame :height-chars)
      836         .
      837         if p-change-value <= 0
      838         then do:
      839           run diasize_position-resize-button in this-procedure .
      840           return .
      841         end.
      842       end.
      843     end.
      844     if p-change-value < 0
      845     then do:
      846       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      847       then do:
      848         assign
      849           p-change-value = v-diasize-orig-frame-height
      850                          - (frame Dialog-Frame :height-chars)
      851         .
      852         if p-change-value >= 0
      853         then do:
      854           run diasize_position-resize-button in this-procedure .
      855           return .
      856         end.
      857       end.
      858     end.
      859     if p-change-value >= 0
      860     then do:
      861       assign
      862         v-change-sign = 1
      863       .
      864     end.
      865     else do:
      866       assign
      867         v-change-sign = -1
      868       .
      869     end.
      870     assign
      871       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      872     .
      873     if p-change-value = 0
      874     then do:
      875       run diasize_position-resize-button in this-procedure .
      876       return .
      877     end.
      878     move_block:
      879     do
      880     on error undo move_block, retry move_block
      881     :
      882       if retry
      883       then do:
      884         do
      885         on error undo move_block, leave move_block
      886         :
      887           if p-change-value > 0
      888           then do:
      889             for each buf_temp-diasize-handle
      890             on error undo, next
      891             :
      892               assign
      893                 v-object-handle = buf_temp-diasize-handle.handle-value
      894               .
      895               if v-object-handle <> v-diasize-resize-button
      896               then do:
      897                 assign
      898                   v-object-handle :row = buf_temp-diasize-handle.save-position
      899                 .
      900               end.
      901             end.
      902             assign
      903               v-diasize-browse-handle :height = v-browse-height
      904             .
      905             for each buf_temp-browse-handle
      906               where buf_temp-browse-handle.browse-type = 'height':u
      907             on error undo, next
      908             :
      909               assign
      910                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      911               .
      912             end.
      913             assign
      914               frame Dialog-Frame :height = v-frame-height
      915             .
      916             if frame Dialog-Frame :scrollable = true
      917             then do:
      918               assign
      919                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      920               .
      921             end.
      922             run diasize_position-resize-button in this-procedure .
      923           end.
      924           else do:
      925             if frame Dialog-Frame :scrollable = true
      926             then do:
      927               assign
      928                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      929               .
      930             end.
      931             assign
      932               frame Dialog-Frame :height = v-frame-height
      933             .
      934             assign
      935               v-diasize-browse-handle :height = v-browse-height
      936             .
      937             for each buf_temp-browse-handle
      938               where buf_temp-browse-handle.browse-type = 'height':u
      939             on error undo, next
      940             :
      941               assign
      942                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      943               .
      944             end.
      945             for each buf_temp-diasize-handle
      946             on error undo, next
      947             :
      948               assign
      949                 v-object-handle = buf_temp-diasize-handle.handle-value
      950               .
      951               if v-object-handle <> v-diasize-resize-button
      952               then do:
      953                 assign
      954                   v-object-handle :row = buf_temp-diasize-handle.save-position
      955                 .
      956               end.
      957             end.
      958             run diasize_position-resize-button in this-procedure .
      959           end.
      960           assign
      961             v-diasize-change-size = false
      962           .
      963           leave move_block .
      964         end.
      965       end.
      966       assign
      967         v-diasize-need-full-display = true
      968       .
      969       if v-diasize-change-size = false
      970       then do:
      971         assign
      972           v-diasize-change-size = true
      973         .
      974       end.
      975       else do:
      976         return .
      977       end.
      978       assign
      979         v-frame-height = frame Dialog-Frame :height
      980         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      981         v-browse-height = v-diasize-browse-handle :height
      982       .
      983       for each buf_temp-browse-handle
      984         where buf_temp-browse-handle.browse-type = 'height':u
      985       :
      986         assign
      987           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      988         .
      989       end.
      990       for each buf_temp-diasize-handle
      991       :
      992         delete buf_temp-diasize-handle .
      993       end.
      994       assign
      995         v-field-group-handle = frame Dialog-Frame :first-child
      996       .
      997       do while valid-handle(v-field-group-handle)
      998       :
      999         assign
     1000           v-object-handle = v-field-group-handle :first-child
     1001         .
     1002         do while valid-handle(v-object-handle)
     1003         :
     1004           if  v-object-handle <> v-diasize-browse-handle :handle
     1005           and can-query(v-object-handle, "row")
     1006           and can-query(v-object-handle, "height")
     1007           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1008           then do:
     1009             find first buf_temp-browse-handle
     1010               where buf_temp-browse-handle.browse-type   = 'height':u
     1011                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1012               no-error .
     1013             if available buf_temp-browse-handle
     1014             then do:
     1015             end.
     1016             else do:
     1017               create buf_temp-diasize-handle .
     1018               assign
     1019                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1020                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1021               .
     1022             end.
     1023           end.
     1024           assign
     1025             v-object-handle = v-object-handle :next-sibling
     1026           .
     1027         end.
     1028         assign
     1029           v-field-group-handle = v-field-group-handle :next-sibling
     1030         .
     1031       end.
     1032       do with frame Dialog-Frame
     1033       :
     1034         hide v-diasize-resize-button .
     1035         assign
     1036           v-diasize-resize-button :row    = 1
     1037           v-diasize-resize-button :column = 1
     1038         .
     1039       end.
     1040       if p-change-value > 0
     1041       then do:
     1042         if frame Dialog-Frame :scrollable = true
     1043         then do:
     1044           assign
     1045             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1046             no-error .
     1047           if error-status :error
     1048           or error-status :get-message(1) <> ""
     1049           then do:
     1050             undo move_block, retry move_block .
     1051           end.
     1052         end.
     1053         assign
     1054           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1055           no-error .
     1056         if error-status :error
     1057         or error-status :get-message(1) <> ""
     1058         then do:
     1059           undo move_block, retry move_block .
     1060         end.
     1061         assign
     1062           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1063           no-error .
     1064         if error-status :error
     1065         or error-status :get-message(1) <> ""
     1066         then do:
     1067           undo move_block, retry move_block .
     1068         end.
     1069         for each buf_temp-browse-handle
     1070           where buf_temp-browse-handle.browse-type = 'height':u
     1071         on error undo move_block, retry move_block
     1072         :
     1073           assign
     1074             buf_temp-browse-handle.browse-handle :height
     1075               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1076             no-error .
     1077           if error-status :error
     1078           or error-status :get-message(1) <> ""
     1079           then do:
     1080             undo move_block, retry move_block .
     1081           end.
     1082         end.
     1083         for each buf_temp-diasize-handle
     1084         on error undo move_block, retry move_block
     1085         :
     1086           assign
     1087             v-object-handle = buf_temp-diasize-handle.handle-value
     1088           .
     1089           if v-object-handle <> v-diasize-resize-button
     1090           then do:
     1091             assign
     1092               v-object-handle :row = v-object-handle :row + p-change-value
     1093               no-error .
     1094             if error-status :error
     1095             or error-status :get-message(1) <> ""
     1096             then do:
     1097               undo move_block, retry move_block .
     1098             end.
     1099           end.
     1100         end.
     1101       end.
     1102       else do:
     1103         for each buf_temp-diasize-handle
     1104         on error undo move_block, retry move_block
     1105         :
     1106           assign
     1107             v-object-handle = buf_temp-diasize-handle.handle-value
     1108           .
     1109           if v-object-handle <> v-diasize-resize-button
     1110           then do:
     1111             assign
     1112               v-object-handle :row = v-object-handle :row + p-change-value
     1113               no-error .
     1114             if error-status :error
     1115             or error-status :get-message(1) <> ""
     1116             then do:
     1117               undo move_block, retry move_block .
     1118             end.
     1119           end.
     1120         end.
     1121         assign
     1122           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1123           no-error .
     1124         if error-status :error
     1125         or error-status :get-message(1) <> ""
     1126         then do:
     1127           undo move_block, retry move_block .
     1128         end.
     1129         for each buf_temp-browse-handle
     1130           where buf_temp-browse-handle.browse-type = 'height':u
     1131         on error undo move_block, retry move_block
     1132         :
     1133           assign
     1134             buf_temp-browse-handle.browse-handle :height
     1135               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1136             no-error .
     1137           if error-status :error
     1138           or error-status :get-message(1) <> ""
     1139           then do:
     1140             undo move_block, retry move_block .
     1141           end.
     1142         end.
     1143         assign
     1144           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1145           no-error .
     1146         if error-status :error
     1147         or error-status :get-message(1) <> ""
     1148         then do:
     1149           undo move_block, retry move_block .
     1150         end.
     1151         if frame Dialog-Frame :scrollable = true
     1152         then do:
     1153           assign
     1154             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1155             no-error .
     1156           if error-status :error
     1157           or error-status :get-message(1) <> ""
     1158           then do:
     1159             undo move_block, retry move_block .
     1160           end.
     1161         end.
     1162       end.
     1163       if p-move-resize = true
     1164       then do:
     1165         run diasize_position-resize-button in this-procedure .
     1166       end.
     1167       if v-diasize-wndstore = true
     1168       then do:
     1169         if connected("ub") = true
     1170         then do:
     1171           define variable v-cntxt-db-num        as integer   no-undo .
     1172           define variable v-cntxt-userid        as character no-undo .
     1173           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1174                                             , OUTPUT v-cntxt-userid
     1175                                             ) .
     1176           run gbl/wndsizew.p
     1177             (input  v-cntxt-db-num
     1178             ,input  v-cntxt-userid
     1179             ,input  v-diasize-proc-name
     1180             ,input  'height':u
     1181             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1182             ) .
     1183         end.
     1184       end.
     1185     end.
     1186     assign
     1187       v-diasize-change-size = false
     1188     .
     1189   end procedure.
     1190   procedure diasize_set-height :
     1191     define input  parameter p-new-height  as decimal   no-undo .
     1192     define input  parameter p-move-resize as logical   no-undo .
     1193     do
     1194     on error undo, return error return-value
     1195     :
     1196       run diasize_change-height in this-procedure
     1197         (input  (p-new-height - frame Dialog-Frame :height)
     1198         ,input  p-move-resize
     1199         ) .
     1200     end.
     1201   end procedure.
     1202   procedure diasize_change-width :
     1203     define input  parameter p-change-value as decimal   no-undo .
     1204     define input  parameter p-move-resize  as logical   no-undo .
     1205     define variable v-field-group-handle   as handle    no-undo .
     1206     define variable v-object-handle        as handle    no-undo .
     1207     define variable v-frame-width          as decimal   no-undo .
     1208     define variable v-frame-virtual-width  as decimal   no-undo .
     1209     define variable v-browse-width         as decimal   no-undo .
     1210     define variable v-window-width         as decimal   no-undo .
     1211     define variable v-window-virtual-width as decimal   no-undo .
     1212     define variable v-change-sign          as integer   no-undo .
     1213     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1214     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1215     if p-change-value > 0
     1216     then do:
     1217       if frame Dialog-Frame :width + p-change-value >
     1218           session :width-chars
     1219       then do:
     1220         assign
     1221           p-change-value = session :width-chars - frame Dialog-Frame :width
     1222         .
     1223         if p-change-value <= 0
     1224         then do:
     1225           run diasize_position-resize-button in this-procedure .
     1226           return .
     1227         end.
     1228       end.
     1229     end.
     1230     if p-change-value < 0
     1231     then do:
     1232       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1233       then do:
     1234         assign
     1235           p-change-value = v-diasize-orig-frame-width
     1236                          - frame Dialog-Frame :width
     1237         .
     1238         if p-change-value >= 0
     1239         then do:
     1240           run diasize_position-resize-button in this-procedure .
     1241           return .
     1242         end.
     1243       end.
     1244     end.
     1245     if p-change-value >= 0
     1246     then do:
     1247       assign
     1248         v-change-sign = 1
     1249       .
     1250     end.
     1251     else do:
     1252       assign
     1253         v-change-sign = -1
     1254       .
     1255     end.
     1256     assign
     1257       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1258     .
     1259     if p-change-value = 0
     1260     then do:
     1261       run diasize_position-resize-button in this-procedure .
     1262       return .
     1263     end.
     1264     move_block:
     1265     do
     1266     on error undo move_block, leave move_block
     1267     :
     1268       if retry
     1269       then do:
     1270         do
     1271         on error undo move_block, leave move_block
     1272         :
     1273           if p-change-value > 0
     1274           then do:
     1275             for each buf_temp-diasize-handle
     1276             on error undo, next
     1277             :
     1278               assign
     1279                 v-object-handle = buf_temp-diasize-handle.handle-value
     1280               .
     1281               if v-object-handle <> v-diasize-resize-button
     1282               then do:
     1283                 assign
     1284                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1285                 .
     1286               end.
     1287             end.
     1288             assign
     1289               v-diasize-browse-handle :width = v-browse-width
     1290             .
     1291             for each buf_temp-browse-handle
     1292               where buf_temp-browse-handle.browse-type = 'width':u
     1293             on error undo, next
     1294             :
     1295               assign
     1296                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1297               .
     1298             end.
     1299             assign
     1300               frame Dialog-Frame :width = v-frame-width
     1301             .
     1302             if frame Dialog-Frame :scrollable = true
     1303             then do:
     1304               assign
     1305                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1306               .
     1307             end.
     1308             run diasize_position-resize-button in this-procedure .
     1309           end.
     1310           else do:
     1311             if frame Dialog-Frame :scrollable = true
     1312             then do:
     1313               assign
     1314                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1315               .
     1316             end.
     1317             assign
     1318               frame Dialog-Frame :width = v-frame-width
     1319             .
     1320             for each buf_temp-browse-handle
     1321               where buf_temp-browse-handle.browse-type = 'width':u
     1322             on error undo, next
     1323             :
     1324               assign
     1325                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1326               .
     1327             end.
     1328             assign
     1329               v-diasize-browse-handle :width = v-browse-width
     1330             .
     1331             for each buf_temp-diasize-handle
     1332             on error undo, next
     1333             :
     1334               assign
     1335                 v-object-handle = buf_temp-diasize-handle.handle-value
     1336               .
     1337               if v-object-handle <> v-diasize-resize-button
     1338               then do:
     1339                 assign
     1340                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1341                 .
     1342               end.
     1343             end.
     1344             run diasize_position-resize-button in this-procedure .
     1345           end.
     1346           assign
     1347             v-diasize-change-size = false
     1348           .
     1349           leave move_block .
     1350         end.
     1351       end.
     1352       assign
     1353         v-diasize-need-full-display = true
     1354       .
     1355       if v-diasize-change-size = false
     1356       then do:
     1357         assign
     1358           v-diasize-change-size = true
     1359         .
     1360       end.
     1361       else do:
     1362         return .
     1363       end.
     1364       assign
     1365         v-frame-width = frame Dialog-Frame :width
     1366         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1367         v-browse-width = v-diasize-browse-handle :width
     1368       .
     1369       for each buf_temp-browse-handle
     1370         where buf_temp-browse-handle.browse-type = 'width':u
     1371       :
     1372         assign
     1373           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1374         .
     1375       end.
     1376       for each buf_temp-diasize-handle
     1377       :
     1378         delete buf_temp-diasize-handle .
     1379       end.
     1380       assign
     1381         v-field-group-handle = frame Dialog-Frame :first-child
     1382       .
     1383       do while valid-handle(v-field-group-handle)
     1384       :
     1385         assign
     1386           v-object-handle = v-field-group-handle :first-child
     1387         .
     1388         do while valid-handle(v-object-handle)
     1389         :
     1390           if  v-object-handle <> v-diasize-browse-handle :handle
     1391           and v-object-handle <> v-diasize-resize-button
     1392           and can-query(v-object-handle, "row")
     1393           and can-query(v-object-handle, "height")
     1394           and ( v-object-handle :col + v-object-handle :width
     1395                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1396               )
     1397           then do:
     1398             find first buf_temp-browse-handle
     1399               where buf_temp-browse-handle.browse-type   = 'width':u
     1400                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1401               no-error .
     1402             if available buf_temp-browse-handle
     1403             then do:
     1404             end.
     1405             else do:
     1406               create buf_temp-diasize-handle .
     1407               assign
     1408                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1409                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1410               .
     1411             end.
     1412           end.
     1413           assign
     1414             v-object-handle = v-object-handle :next-sibling
     1415           .
     1416         end.
     1417         assign
     1418           v-field-group-handle = v-field-group-handle :next-sibling
     1419         .
     1420       end.
     1421       do with frame Dialog-Frame
     1422       :
     1423         hide v-diasize-resize-button .
     1424         v-diasize-resize-button :row = 1.
     1425         v-diasize-resize-button :column = 1.
     1426       end.
     1427       if p-change-value > 0
     1428       then do:
     1429         if frame Dialog-Frame :scrollable = true
     1430         then do:
     1431           assign
     1432             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1433             no-error .
     1434           if error-status :error
     1435           or error-status :get-message(1) <> ""
     1436           then do:
     1437             undo move_block, retry move_block.
     1438           end.
     1439         end.
     1440         assign
     1441           frame Dialog-Frame :width = v-frame-width + p-change-value
     1442           no-error .
     1443         if error-status :error
     1444         or error-status :get-message(1) <> ""
     1445         then do:
     1446           undo move_block, retry move_block.
     1447         end.
     1448         assign
     1449           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1450         no-error .
     1451         if error-status :error
     1452         or error-status :get-message(1) <> ""
     1453         then do:
     1454           undo move_block, retry move_block.
     1455         end.
     1456         for each buf_temp-browse-handle
     1457           where buf_temp-browse-handle.browse-type = 'width':u
     1458         on error undo move_block, retry move_block
     1459         :
     1460           assign
     1461             buf_temp-browse-handle.browse-handle :width
     1462               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1463             no-error .
     1464           if error-status :error
     1465           or error-status :get-message(1) <> ""
     1466           then do:
     1467             undo move_block, retry move_block .
     1468           end.
     1469         end.
     1470         for each buf_temp-diasize-handle
     1471         on error undo move_block, retry move_block
     1472         :
     1473           assign
     1474             v-object-handle = buf_temp-diasize-handle.handle-value
     1475           .
     1476           if v-object-handle <> v-diasize-resize-button
     1477           then do:
     1478             assign
     1479               v-object-handle :col = v-object-handle :col + p-change-value
     1480               no-error .
     1481             if error-status :error
     1482             or error-status :get-message(1) <> ""
     1483             then do:
     1484               undo move_block, retry move_block .
     1485             end.
     1486           end.
     1487         end.
     1488       end.
     1489       else do:
     1490         for each buf_temp-diasize-handle
     1491         on error undo move_block, retry move_block
     1492         :
     1493           assign
     1494             v-object-handle = buf_temp-diasize-handle.handle-value
     1495           .
     1496           if v-object-handle <> v-diasize-resize-button
     1497           then do:
     1498             assign
     1499               v-object-handle :col = v-object-handle :col + p-change-value
     1500               no-error .
     1501             if error-status :error
     1502             or error-status :get-message(1) <> ""
     1503             then do:
     1504               undo move_block, retry move_block .
     1505             end.
     1506           end.
     1507         end.
     1508         for each buf_temp-browse-handle
     1509           where buf_temp-browse-handle.browse-type = 'width':u
     1510         on error undo move_block, retry move_block
     1511         :
     1512           assign
     1513             buf_temp-browse-handle.browse-handle :width
     1514               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1515             no-error .
     1516           if error-status :error
     1517           or error-status :get-message(1) <> ""
     1518           then do:
     1519             undo move_block, retry move_block .
     1520           end.
     1521         end.
     1522         assign
     1523           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1524           no-error .
     1525         if error-status :error
     1526         or error-status :get-message(1) <> ""
     1527         then do:
     1528           undo move_block, retry move_block.
     1529         end.
     1530         assign
     1531           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1532         no-error .
     1533         if error-status :error
     1534         or error-status :get-message(1) <> ""
     1535         then do:
     1536           undo move_block, retry move_block.
     1537         end.
     1538         if frame Dialog-Frame :scrollable = true
     1539         then do:
     1540           assign
     1541             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1542           no-error .
     1543           if error-status :error
     1544           or error-status :get-message(1) <> ""
     1545           then do:
     1546             undo move_block, retry move_block.
     1547           end.
     1548         end.
     1549       end.
     1550       if p-move-resize
     1551       then do:
     1552         run diasize_position-resize-button in this-procedure .
     1553       end.
     1554       if v-diasize-wndstore = true
     1555       then do:
     1556         if connected("ub") = true
     1557         then do:
     1558           define variable v-cntxt-db-num        as integer   no-undo .
     1559           define variable v-cntxt-userid        as character no-undo .
     1560           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1561                                             , OUTPUT v-cntxt-userid
     1562                                             ) .
     1563           run gbl/wndsizew.p
     1564             (input  v-cntxt-db-num
     1565             ,input  v-cntxt-userid
     1566             ,input  v-diasize-proc-name
     1567             ,input  'width':u
     1568             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1569             ) .
     1570         end.
     1571       end.
     1572     end.
     1573     assign
     1574       v-diasize-change-size = false
     1575     .
     1576   end procedure.
     1577   procedure diasize_set-width :
     1578     define input  parameter p-new-width  as decimal   no-undo .
     1579     define input  parameter p-move-resize as logical   no-undo .
     1580     do
     1581     on error undo, return error return-value
     1582     :
     1583       run diasize_change-width in this-procedure
     1584         (input  (p-new-width - frame Dialog-Frame :width)
     1585         ,input  p-move-resize
     1586         ) .
     1587     end.
     1588   end procedure.
     1589   procedure diasize_position-resize-button :
     1590     do with frame Dialog-Frame
     1591     :
     1592       hide v-diasize-resize-button .
     1593       assign
     1594         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1595                     - 1
     1596                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1597         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1598                     - 1
     1599                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1600       .
     1601       view v-diasize-resize-button .
     1602     end.
     1603   end procedure.
     1604   on alt-right anywhere
     1605   do:
     1606     run diasize_change-width in this-procedure
     1607       (input 1
     1608       ,input true
     1609       ) .
     1610     return no-apply .
     1611   end.
     1612   on alt-left anywhere
     1613   do:
     1614     run diasize_change-width in this-procedure
     1615       (input -1
     1616       ,input true
     1617       ) .
     1618     return no-apply .
     1619   end.
     1620   on alt-down anywhere
     1621   do:
     1622     run diasize_change-height in this-procedure
     1623       (input 1
     1624       ,input true
     1625       ) .
     1626     return no-apply .
     1627   end.
     1628   on alt-up anywhere
     1629   do:
     1630     run diasize_change-height in this-procedure
     1631       (input -1
     1632       ,input true
     1633       ) .
     1634     return no-apply .
     1635   end.
     1636   on alt-enter of frame Dialog-Frame
     1637   do:
     1638     run diasize_maximize in this-procedure
     1639       (input  ?
     1640       ).
     1641     return no-apply .
     1642   end.
     1643   procedure diasize_end-move :
     1644     do
     1645     on error undo, return error return-value
     1646     :
     1647       define variable v-row-delta as decimal   no-undo .
     1648       define variable v-col-delta as decimal   no-undo .
     1649       define variable v-new-row as decimal   no-undo .
     1650       define variable v-new-col as decimal   no-undo .
     1651       assign
     1652         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1653         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1654       .
     1655       assign
     1656         v-row-delta = v-new-row - frame Dialog-Frame :height
     1657         v-col-delta = v-new-col - frame Dialog-Frame :width
     1658       .
     1659       run diasize_change-height in this-procedure
     1660         (input v-row-delta
     1661         ,input true
     1662         ) .
     1663       run diasize_change-width in this-procedure
     1664         (input v-col-delta
     1665         ,input true
     1666         ) .
     1667     end.
     1668   end procedure.
     1669   procedure diasize_maximize :
     1670     define input  parameter p-action as logical   no-undo .
     1671     do
     1672     on error undo, return error return-value
     1673     :
     1674       if p-action = ?
     1675       then do:
     1676         if v-diasize-need-maximize = true
     1677         then do:
     1678           assign
     1679             p-action = true
     1680           .
     1681         end.
     1682         else do:
     1683           assign
     1684             p-action = false
     1685           .
     1686         end.
     1687       end.
     1688       if p-action = true
     1689       then do:
     1690         run diasize_change-height in this-procedure
     1691           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1692               - frame Dialog-Frame :height-chars
     1693           ,input true
     1694           ) .
     1695         run diasize_change-width in this-procedure
     1696           (input session :width-chars
     1697               - frame Dialog-Frame :width-chars
     1698           ,input true
     1699           ) .
     1700         assign
     1701           v-diasize-need-maximize = false
     1702         .
     1703       end.
     1704       else do:
     1705         run diasize_change-width in this-procedure
     1706           (input v-diasize-orig-frame-width
     1707               - frame Dialog-Frame :width-chars
     1708           ,input true
     1709           ) .
     1710         run diasize_change-height in this-procedure
     1711           (input v-diasize-orig-frame-height
     1712               - frame Dialog-Frame :height-chars
     1713           ,input true
     1714           ) .
     1715         assign
     1716           v-diasize-need-maximize = true
     1717         .
     1718       end.
     1719     end.
     1720   end procedure.
     1721   procedure diasize_restore-orig-size :
     1722     do
     1723     on error undo, return error return-value
     1724     :
     1725       assign
     1726         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1727         v-diasize-current-frame-height = frame Dialog-Frame :height
     1728       .
     1729       run diasize_set-height in this-procedure
     1730         (input  v-diasize-orig-frame-height
     1731         ,input  true
     1732         ) .
     1733       run diasize_set-width in this-procedure
     1734         (input  v-diasize-orig-frame-width
     1735         ,input  true
     1736         ) .
     1737     end.
     1738   end procedure.
     1739   procedure diasize_restore-current-size :
     1740     do
     1741     on error undo, return error return-value
     1742     :
     1743       run diasize_set-height in this-procedure
     1744         (input  v-diasize-current-frame-height
     1745         ,input  true
     1746         ) .
     1747       run diasize_set-width in this-procedure
     1748         (input  v-diasize-current-frame-width
     1749         ,input  true
     1750         ) .
     1751     end.
     1752   end procedure.
     1753   procedure diasize_set-browse-handle :
     1754     define input  parameter p-browse-handle as handle   no-undo .
     1755     define buffer buf_temp-browse-handle for temp-browse-handle .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       assign
     1760         v-diasize-browse-handle = p-browse-handle
     1761       .
     1762       for each buf_temp-browse-handle
     1763       on error undo, return error return-value
     1764       :
     1765         delete buf_temp-browse-handle .
     1766       end.
     1767     end.
     1768   end procedure.
     1769   procedure diasize_add_browse :
     1770     define input  parameter p-browse-type   as character no-undo .
     1771     define input  parameter p-browse-handle as handle    no-undo .
     1772     define buffer buf_temp-browse-handle for temp-browse-handle .
     1773     do
     1774     on error undo, return error return-value
     1775     :
     1776       assign
     1777         v-diasize-browse-number = v-diasize-browse-number + 1
     1778       .
     1779       create buf_temp-browse-handle .
     1780       assign
     1781         buf_temp-browse-handle.browse-type   = p-browse-type
     1782         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1783         buf_temp-browse-handle.browse-handle = p-browse-handle
     1784       .
     1785     end.
     1786   end procedure.
     1787   procedure diasize_init :
     1788     define variable v-default-value    as logical   no-undo .
     1789     define variable v-restore-saved    as logical   no-undo .
     1790     define variable v-resize-value-str as character no-undo .
     1791     do
     1792     on error undo, return error return-value
     1793     :
     1794       do with frame Dialog-Frame
     1795       :
     1796         assign
     1797           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1798           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1799           v-diasize-browse-handle     = browse br-laytables :handle
     1800         .
     1801         create button v-diasize-resize-button
     1802         assign
     1803           parent        = frame Dialog-Frame :first-child
     1804           label         = "s"
     1805           height-pixels = 16
     1806           width-pixels  = 16
     1807           visible       = true
     1808           sensitive     = true
     1809           movable       = true
     1810           triggers:
     1811             on end-move persistent run diasize_end-move in this-procedure .
     1812           end triggers.
     1813         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1814         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1815         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1816         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1817         assign
     1818           v-diasize-wndmax = false
     1819         .
     1820         if connected("ub") = true
     1821         then do:
     1822           define variable v-cntxt-db-num        as integer   no-undo .
     1823           define variable v-cntxt-userid        as character no-undo .
     1824           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1825                                             , OUTPUT v-cntxt-userid
     1826                                             ) .
     1827           run gbl/wndpar_r.p
     1828             (input  v-cntxt-db-num
     1829             ,input  v-cntxt-userid
     1830             ,input  'wndmax':U
     1831             ,output v-diasize-wndmax
     1832             ,output v-default-value
     1833             ) .
     1834         end.
     1835         assign
     1836           v-diasize-wndstore = false
     1837         .
     1838         if connected("ub") = true
     1839         then do:
     1840           run gbl/wndpar_r.p
     1841             (input  v-cntxt-db-num
     1842             ,input  v-cntxt-userid
     1843             ,input  'wndstore':U
     1844             ,output v-diasize-wndstore
     1845             ,output v-default-value
     1846             ) .
     1847         end.
     1848         assign
     1849           v-diasize-proc-name = entry(1, program-name(2), '.')
     1850         .
     1851         if v-diasize-wndstore = true
     1852         then do:
     1853           assign
     1854             v-restore-saved = false
     1855           .
     1856           if connected("ub") = true
     1857           then do:
     1858             run gbl/wndsizer.p
     1859               (input  v-cntxt-db-num
     1860               ,input  v-cntxt-userid
     1861               ,input  v-diasize-proc-name
     1862               ,input  'height':u
     1863               ,output v-resize-value-str
     1864               ) .
     1865             if v-resize-value-str <> '':U
     1866             then do:
     1867               run diasize_change-height in this-procedure
     1868                 (input  integer(v-resize-value-str)
     1869                 ,input  true
     1870                 ) .
     1871               assign
     1872                 v-restore-saved = true
     1873               .
     1874             end.
     1875           end.
     1876           if connected("ub") = true
     1877           then do:
     1878             run gbl/wndsizer.p
     1879               (input  v-cntxt-db-num
     1880               ,input  v-cntxt-userid
     1881               ,input  v-diasize-proc-name
     1882               ,input  'width':u
     1883               ,output v-resize-value-str
     1884               ) .
     1885             if v-resize-value-str <> '':U
     1886             then do:
     1887               run diasize_change-width in this-procedure
     1888                 (input  integer(v-resize-value-str)
     1889                 ,input  true
     1890                 ) .
     1891               assign
     1892                 v-restore-saved = true
     1893               .
     1894             end.
     1895           end.
     1896           if v-restore-saved <> true
     1897           then do:
     1898             if v-diasize-wndmax = true
     1899             then do:
     1900               run diasize_maximize in this-procedure
     1901                 (input  true
     1902                 ) .
     1903             end.
     1904           end.
     1905         end.
     1906         else do:
     1907           if v-diasize-wndmax = true
     1908           then do:
     1909             run diasize_maximize in this-procedure
     1910               (input  true
     1911               ) .
     1912           end.
     1913         end.
     1914       end.
     1915     end.
     1916   end procedure.
     1917   procedure diasize_need-full-display :
     1918     define output parameter p-need-full-display as logical   no-undo .
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       assign
     1923         p-need-full-display = v-diasize-need-full-display
     1924       .
     1925       assign
     1926         v-diasize-need-full-display = false
     1927       .
     1928     end.
     1929   end procedure.
     1930   procedure get-context :
     1931      define output parameter p-db-num as integer          no-undo.
     1932      define output parameter p-user-id as character        no-undo.
     1933      define variable v-login               as character    no-undo.
     1934      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1935      define buffer buf_user-login  for ub.user-login .
     1936      do
     1937      on error undo, return error
     1938      :
     1939            FIND FIRST buf_sys-ctrl no-lock.
     1940            ASSIGN
     1941               v-login = USERID("ub")
     1942               p-db-num = buf_sys-ctrl.db-num
     1943            .
     1944            FIND FIRST buf_user-login
     1945                 WHERE buf_user-login.db-num = p-db-num
     1946                   AND buf_user-login.user-login = v-login
     1947                 no-lock
     1948                 no-error
     1949                 .
     1950            IF AVAILABLE buf_user-login
     1951            THEN DO:
     1952               assign
     1953                  p-user-id = buf_user-login.user-id
     1954               .
     1955            END.
     1956      end.
     1957   end procedure.
     1958       run diasize_init in this-procedure .
     1959   MAIN-BLOCK:
     1960   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1961      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1962   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1963   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1964     (output v-sys-key
     1965     ) no-error .
     1966     if error-status:error then return error.
     1967     assign
     1968      v-ibs = (v-sys-key = 'ExpertekIBS':U)
     1969     .
     1970     if not v-ibs then do:
     1971       message
     1972         "Данная программа может вызываться только сотрудниками IBS" skip
     1973         "Продолжать?"
     1974       view-as alert-box question
     1975       buttons yes-no
     1976       update glog
     1977       .
     1978       if not glog then do:
     1979         undo, return error .
     1980       end.
     1981       DEFINE VARIABLE v-value AS CHARACTER no-undo.
     1982       DEFINE VARIABLE v-password AS CHARACTER no-undo.
     1983       DEFINE VARIABLE v-today as date no-undo .
     1984       DEFINE VARIABLE v-time as integer no-undo .
     1985       run cur-time in this-procedure ( output v-today, output v-time).
     1986       ASSIGN
     1987       v-password = string((if weekday(v-today) = 1
     1988                           then 7
     1989                           else (weekday(v-today) - 1))
     1990                           * 140).
     1991           run gbl/d-prompt.w (
     1992           'title=':u + "ВВЕДИТЕ ПАРОЛЬ" + '\':u
     1993         + 'text1=' + substitute("Пароль") + '\':u
     1994         + 'format=' + ">>>>>>>>9" + '\':u
     1995         + 'type=' + 'I':U + '\':u
     1996         + 'fillin_row=2\':u
     1997         + 'fillin_col=4\':u
     1998         + 'fillin_width=30\':u
     1999         + 'fillin_height=1\':u
     2000         + 'max-chars=70\':u
     2001         + 'readonly=no\':u
     2002         , input-output v-value
     2003         ).
     2004       if return-value = 'false':u
     2005       then do:
     2006         return no-apply.
     2007       end.
     2008       IF v-value <> v-password THEN DO:
     2009           MESSAGE
     2010         "Неверный пароль!"
     2011         VIEW-AS ALERT-BOX.
     2012         RETURN error.
     2013       END.
     2014     end.
     2015     assign
     2016      v-layout-tables   = v-layout-tables
     2017                        + chr(44)
     2018                        + 'cd-events':U
     2019                        + chr(44)
     2020                        + 'cd-video-link':U
     2021     .
     2022     assign
     2023      v-layout-table-names = v-layout-table-names
     2024                           + chr(44)
     2025                           + "События на кассе"
     2026                           + chr(44)
     2027                           + "Связь событий на кассе с событиями СВ"
     2028     .
     2029     assign
     2030     v-layout-tables = trim(v-layout-tables).
     2031     v-layout-table-names = trim(v-layout-table-names).
     2032     run Myenable.
     2033     WAIT-FOR GO OF FRAME Dialog-Frame.
     2034   END.
     2035   run disable_UI.
     2036   PROCEDURE disable_UI :
     2037     HIDE FRAME Dialog-Frame.
     2038   END PROCEDURE.
     2039   PROCEDURE enable_UI :
     2040     DISPLAY rs-language
     2041         WITH FRAME Dialog-Frame.
     2042     ENABLE b-quit B-sel B-Help rs-language br-laytables
     2043         WITH FRAME Dialog-Frame.
     2044     VIEW FRAME Dialog-Frame.
     2045     OPEN QUERY br-laytables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-layout-tables) > 0.
     2046   END PROCEDURE.
     2047   PROCEDURE MyEnable :
     2048      ASSIGN
     2049         rs-language:RADIO-BUTTONS IN FRAME Dialog-Frame = "ABL"
     2050                                                         + chr(44)
     2051                                                         + "ABL"
     2052                                                         + chr(44)
     2053                                                         + "rus"
     2054                                                         + chr(44)
     2055                                                         + "rus"
     2056      .
     2057         rs-language + "ABL"
     2058      .
     2059      ENABLE
     2060         b-quit
     2061         B-sel
     2062         B-Help
     2063         b-export
     2064         b-import
     2065         br-laytables
     2066         rs-language
     2067      WITH FRAME Dialog-Frame.
     2068      VIEW FRAME Dialog-Frame.
     2069      run waitfram-show in this-procedure ( input "Ждите..." ).
     2070      OPEN QUERY br-laytables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-layout-tables) > 0.
     2071      run waitfram-hide in this-procedure .
     2072   END PROCEDURE.
     2073   PROCEDURE proc-b-sel :
     2074   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2075   define variable v-ok    as logical      no-undo.
     2076      IF NOT AVAILABLE buf_file THEN DO:
     2077         RETURN.
     2078      END.
     2079      CASE buf_file._file-name:
     2080         WHEN 'cd-events':U THEN DO:
     2081            run ref/cd-event.w ( INPUT parparentproc
     2082                               , INPUT (if v-ibs then 'b-add':U else '':U)
     2083                               , INPUT-OUTPUT v-rid-list
     2084                               , OUTPUT v-ok
     2085                               ) NO-ERROR.
     2086         END.
     2087         WHEN 'cd-video-link':U THEN DO:
     2088            run ref/cd-video.w ( INPUT parparentproc
     2089                               , INPUT (if v-ibs then 'b-add':U else '':U)
     2090                               , INPUT-OUTPUT v-rid-list
     2091                               , OUTPUT v-ok
     2092                               ) NO-ERROR.
     2093         END.
     2094         OTHERWISE DO:
     2095         END.
     2096      END CASE.
     2097   END PROCEDURE.
     2098   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER ) :
     2099   DEFINE VARIABLE v-tbl-fname AS CHARACTER NO-UNDO.
     2100   v-tbl-fname = ENTRY(LOOKUP(p-tbl-name, v-layout-tables), v-layout-table-names).
     2101   return v-tbl-fname.
     2102   END FUNCTION.
