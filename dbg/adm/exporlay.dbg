        1   block-level on error undo, throw.
        2   define input parameter p-file-name as character no-undo .
        3   define input parameter p-old-file-name as character no-undo .
        4   define input parameter p-mode as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: exporlay.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: adm/exporlay.p $":U .
       10   define variable vss-description as character no-undo init "Экспорт конфигурации раскладок в формате СПН".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable v-layout-exp-tables as character no-undo .
       70   define variable v-layout-exp-table-names as character no-undo .
       71   define variable err-count as integer no-undo .
       72   define variable rec-count as integer no-undo .
       73   define variable v-ii as integer no-undo .
       74   define variable v-prepare-phrase as character no-undo .
       75   define variable num-rec as integer no-undo .
       76   define variable num-err as integer no-undo .
       77   assign
       78   v-layout-exp-tables =   'ruleset':U +
       79                       ";" + 'rule':U +
       80                       ";" + 'rule-by-set':U +
       81                       ";" + 'wi-mode':U +
       82                       ";" + 'layout-elem':U +
       83                       ";" + 'layout':U +
       84                       ";" + 'layout':U + chr(44) + 'layout-elem-rule':U +
       85                       ";" + 'layout':U + chr(44) + 'layout-elem-rule':U + chr(44) + 'rule-by-call':U +
       86                       ";" + 'layout':U + chr(44) + 'layout-elem-rule':U + chr(44) + 'rule-call-param':U +
       87                       ";" + ('layout':U + chr(44) + 'layout':U)
       88                       .
       89   assign
       90   v-layout-exp-table-names =  'Кодексы и наборы правил':U +
       91                           ";" + 'Правила RULE-машины':U +
       92                           ";" + 'Привязка правил к наборам':U +
       93                           ";" + 'Режимы работы':U +
       94                           ";" + 'Элементы раскладки':U +
       95                           ";" + 'Раскладка интерфе/клавиатуры':U +
       96                           ";" + 'layout-elem-rule':U +
       97                           ";" + 'Вызов правила':U +
       98                           ";" + 'Параметры вызова правил':U +
       99                           ";" + 'Раскладка интерфе/клавиатуры':U
      100                           .
      101   do v-ii = 1 to num-entries( v-layout-exp-tables, ";"):
      102     CASE entry(v-ii, v-layout-exp-tables, ";"):
      103       when 'ruleset':U then do:
      104         v-prepare-phrase = substitute(' for each &1 where &1.codex_id = 19'
      105                                       ,entry(v-ii, v-layout-exp-tables, ";")
      106                                      ).
      107       end.
      108       when 'rule-by-set':U then do:
      109         v-prepare-phrase = substitute(' for each &1 where &1.codex_id = 19'
      110                                      ,entry(v-ii, v-layout-exp-tables, ";")
      111                                      ).
      112       end.
      113       when 'rule':U then do:
      114         v-prepare-phrase = substitute(' for each &1 where &1.codex_id = 19 by &1.rule_id'
      115                                        ,entry(v-ii, v-layout-exp-tables, ";")
      116                                      ).
      117       end.
      118       when 'layout':U then do:
      119         v-prepare-phrase = substitute(' for each &1 where &1.layout-id <> "_" and (&1.is-default = &2 or &1.is-default = &3)'
      120                                      , entry(v-ii, v-layout-exp-tables, ";")
      121                                      , integer('1':U)
      122                                      , integer('-1':U)
      123                                      ).
      124       end.
      125       when ('layout':U + chr(44) + 'layout-elem-rule':U) then do:
      126         v-prepare-phrase = substitute(' for each layout where layout.layout-id <> "_" and (layout.is-default = &2 or layout.is-default = &3), ' +
      127                                       ' each &1 where &1.layout-id = layout.layout-id '
      128                                      , entry(2, entry(v-ii, v-layout-exp-tables, ";"))
      129                                      , integer('1':U)
      130                                      , integer('-1':U)
      131                                      ).
      132       end.
      133       when ('layout':U + chr(44) + 'layout-elem-rule':U  + chr(44) + 'rule-by-call':U) then do:
      134         v-prepare-phrase = substitute(' for each layout where layout.layout-id <> "_" and (layout.is-default = &2 or layout.is-default = &3), ' +
      135                                       ' each layout-elem-rule where layout-elem-rule.layout-id = layout.layout-id ,' +
      136                                       ' each &1 where &1.call_id = layout-elem-rule.uniq-key-rec '
      137                                      , entry(3, entry(v-ii, v-layout-exp-tables, ";"))
      138                                      , integer('1':U)
      139                                      , integer('-1':U)
      140                                      ).
      141       end.
      142       when ('layout':U + chr(44) + 'layout-elem-rule':U + chr(44) + 'rule-call-param':U) then do:
      143         v-prepare-phrase = substitute(' for each layout where layout.layout-id <> "_" and (layout.is-default = &2 or layout.is-default = &3), ' +
      144                                       ' each layout-elem-rule where layout-elem-rule.layout-id = layout.layout-id , ' +
      145                                       ' each &1 where &1.call_id = layout-elem-rule.uniq-key-rec '
      146                                      , entry(3, entry(v-ii, v-layout-exp-tables, ";"))
      147                                      , integer('1':U)
      148                                      , integer('-1':U)
      149                                      ).
      150       end.
      151       when ('layout':U + chr(44) + 'layout':U) then do:
      152         v-prepare-phrase = substitute(' for each &1 where &1.layout-id = "_"'
      153                                      , entry(1, entry(v-ii, v-layout-exp-tables, ";"))
      154                                      ).
      155         entry(v-ii, v-layout-exp-tables, ";") = entry(1, entry(v-ii, v-layout-exp-tables, ";")).
      156       end.
      157       otherwise do:
      158         v-prepare-phrase = substitute(" for each &1 ", entry(v-ii, v-layout-exp-tables, ";")).
      159       end.
      160    END CASE.
      161     rec-count = num-rec.
      162     err-count = num-err.
      163     run utl/upg-exp.p ( input p-file-name
      164                        ,input p-old-file-name
      165                        ,input p-mode
      166                        ,input (if v-ii = 1 then no else yes)
      167                        ,input (if v-ii = 1 then yes else no)
      168                        ,input ( if v-ii = num-entries(v-layout-exp-tables, ";") then yes else no)
      169                        ,input entry(v-ii, v-layout-exp-tables, ";")
      170                        ,input (if num-entries(entry(v-ii, v-layout-exp-tables, ";")) > 1
      171                                then num-entries(entry(v-ii, v-layout-exp-tables, ";"))
      172                                else 1)
      173                        ,input v-prepare-phrase
      174                        ,input-output rec-count
      175                        ,input-output err-count
      176                        ) no-error.
      177     if not error-status:error then do:
      178       num-rec = rec-count.
      179       num-err = err-count.
      180     end.
      181   end.
