        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: layoute3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: adm/layoute3.p $":U .
        9   define variable vss-description as character no-undo init "Удаление элемента раскладки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   FUNCTION get-region RETURNS CHARACTER
       81     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
       82     define variable par-region as character no-undo.
       83     if parhost-code = 0 and
       84          parobj-type = "":U and
       85          parobj-code = 0 then do:
       86          par-region = "Глобально".
       87          return par-region.
       88       end.
       89       if parobj-type = 'орг':U then do:
       90          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
       91          return par-region.
       92       end.
       93       if parobj-type = 'регион':U
       94       then do:
       95          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
       96          return par-region.
       97       end.
       98       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
       99       return par-region.
      100   END FUNCTION.
      101   FUNCTION get-objregion RETURNS CHARACTER
      102     (  input parobj-type as character, input parobj-code as integer ) :
      103     define variable par-region as character no-undo.
      104     if  parobj-type = "":U and
      105         parobj-code = 0
      106     then do:
      107        par-region = "Глобально".
      108     end.
      109     else if parobj-type = 'орг':U
      110     then do:
      111        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      112     end.
      113     else if parobj-type = 'регион':U
      114     then do:
      115        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      116     end.
      117     else
      118        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      119     return par-region.
      120   END FUNCTION.
      121   define variable v-mess as character no-undo .
      122   define variable v-prop-code as character no-undo .
      123   define buffer buf_layout-elem  for ub.layout-elem.
      124   define buffer buf_layout  for ub.layout.
      125   define buffer buf_layout-elem-rule  for ub.layout-elem-rule.
      126   define buffer buf_thbj-attr for ub.thbj-attr.
      127   main-block:
      128   do
      129   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      130   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      131   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      132   :
      133     find first buf_layout-elem exclusive-lock where
      134             recid(buf_layout-elem) = p-rec .
      135     if g#db-num > 0 then do:
      136       v-mess = substitute("Нельзя удалять элемент раскладки в УБД"
      137                           ).
      138       run err-mess in this-procedure ( input-output v-mess) .
      139       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      140     end.
      141     for each buf_layout no-lock where
      142             buf_layout.layout-type = buf_layout-elem.layout-type
      143         and buf_layout.device-type = buf_layout-elem.device-type,
      144         each buf_layout-elem-rule no-lock where
      145                 buf_layout-elem-rule.layout-id  = buf_layout.layout-id
      146              and buf_layout-elem-rule.mode-id = buf_layout-elem.mode-id
      147              and buf_layout-elem-rule.widget-id = buf_layout-elem.widget-id :
      148       leave.
      149     end.
      150     if available buf_layout-elem-rule then do:
      151       v-mess = substitute("Нельзя удалить элемент раскладки  -  есть привязанные элементы в раскладке &1)"
      152                         , buf_layout.layout-id
      153                         ).
      154       run err-mess in this-procedure ( input-output v-mess) .
      155       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      156     end.
      157     delete buf_layout-elem.
      158     if error-status:error then do:
      159       v-mess = substitute("Ошибка при удалении: &1&2&3"
      160                            , error-status:get-message(1)
      161                            , chr(10)
      162                            , return-value ).
      163      run err-mess in this-procedure ( input-output v-mess) .
      164      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      165     end.
      166   end.
      167   PROCEDURE err-mess:
      168     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      169     CASE p-silent:
      170       when yes then do:
      171         assign
      172         p-mess = substitute("Элемент &4 раскладки типа &1 для устройства &2 режим &3: &5"
      173                            , buf_layout-elem.layout-type
      174                            , buf_layout-elem.device-type
      175                            , buf_layout-elem.mode-id
      176                            , buf_layout-elem.widget-id
      177                            , p-mess)
      178         .
      179       end.
      180       when no then do:
      181         message
      182         p-mess
      183         view-as alert-box error .
      184       end.
      185     end.
      186   END PROCEDURE.
