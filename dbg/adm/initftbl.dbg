        1   block-level on error undo, throw.
        2   define input parameter loc_db-num as integer   no-undo .
        3   define input parameter p-language as character no-undo .
        4   define input parameter p-r-b      as character no-undo .
        5   define input parameter p-sys-key  as character no-undo .
        6   define input parameter p-extra-to as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: d58b016346f1, 2327, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: druban $":U .
        9   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:32 2020 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: initftbl.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: adm/initftbl.p $":U .
       12   define variable vss-description as character no-undo init "Начальная инициализация справочников".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   do
       72   on error undo, return error
       73   :
       74     disable triggers for load of DICTDB.db.
       75     disable triggers for load of DICTDB.db-attr.
       76     disable triggers for load of DICTDB.cli-grp.
       77     disable triggers for load of DICTDB.gds-grp.
       78     disable triggers for load of DICTDB.fbr-gds-grp.
       79     disable triggers for load of DICTDB.gds-prt.
       80     disable triggers for load of DICTDB.hist-nws-option.
       81     disable triggers for load of DICTDB.code-range.
       82     disable triggers for load of DICTDB.upgrade.
       83     define buffer buf_sys-ctrl for DICTDB.sys-ctrl .
       84     define buffer buf_db      for DICTDB.db .
       85     define buffer buf_db-attr for DICTDB.db-attr .
       86     define buffer buf_cli-grp for DICTDB.cli-grp .
       87     define buffer buf_gds-grp for DICTDB.gds-grp .
       88     define buffer buf_fbr-gds-grp for DICTDB.fbr-gds-grp .
       89     define buffer buf_gds-prt for DICTDB.gds-prt .
       90     define buffer buf_hist-nws-option for DICTDB.hist-nws-option.
       91     define buffer buf_code-range      for DICTDB.code-range .
       92     define variable seq-val as integer no-undo .
       93     create buf_sys-ctrl.
       94     assign
       95       buf_sys-ctrl.db-num   = loc_db-num
       96       buf_sys-ctrl.sys-date = today
       97       buf_sys-ctrl.sys-key  = p-sys-key
       98       buf_sys-ctrl.language = p-language
       99       buf_sys-ctrl.r-b      = p-r-b
      100     .
      101     create buf_db.
      102     assign
      103       buf_db.db-num      = 0
      104       buf_db.db-name     = "Главная БД"
      105       buf_db.add-clients = true when (p-extra-to = 1)
      106     .
      107     if p-extra-to = 1 then do:
      108       create buf_db-attr .
      109       assign
      110         buf_db-attr.db-num     = 0
      111         buf_db-attr.attr-code  = 'int-point':U
      112         buf_db-attr.attr-value = "00001":U
      113       .
      114     end.
      115     if loc_db-num = 0
      116     then do:
      117       find first ub.sys-ctrl where ub.sys-ctrl.db-num = 0 no-lock .
      118       create ub.upgrade.
      119           assign
      120             ub.upgrade.db-num      = ub.sys-ctrl.db-num
      121             ub.upgrade.version-num = "v16_0000.000.000":U
      122             ub.upgrade.version-ord = next-value( s-upg-ord, ub )
      123           .
      124       assign
      125         ub.upgrade.step-num    = step-num
      126         ub.upgrade.err-msgs    = "":U
      127         ub.upgrade.err-code    = 0
      128         ub.upgrade.complete    = false
      129         ub.upgrade.UpgDate     = today
      130         ub.upgrade.UpgTimeInt  = time
      131         ub.upgrade.UpgTime     = string( time, "HH:MM:SS" )
      132       .
      133     end.
      134     create buf_cli-grp.
      135     assign
      136       buf_cli-grp.upper-code = 0
      137       buf_cli-grp.node-code  = 1
      138       buf_cli-grp.node-name  = "Клиенты"
      139       dynamic-current-value( "s-cli-grp":U, LDBNAME("DICTDB":U) ) = 1
      140     .
      141     validate buf_cli-grp.
      142     if p-extra-to = 1 then do:
      143       create buf_cli-grp.
      144       assign
      145         buf_cli-grp.upper-code = 1
      146         buf_cli-grp.node-code  = 2
      147         buf_cli-grp.node-name  = "Фирмы, Объекты"
      148       .
      149       validate buf_cli-grp.
      150       create buf_cli-grp.
      151       assign
      152         buf_cli-grp.upper-code = 1
      153         buf_cli-grp.node-code  = 3
      154         buf_cli-grp.node-name  = "Поставщики"
      155       .
      156       validate buf_cli-grp.
      157       create buf_cli-grp.
      158       assign
      159         buf_cli-grp.upper-code = 1
      160         buf_cli-grp.node-code  = 4
      161         buf_cli-grp.node-name  = "Физ.лица"
      162       .
      163       validate buf_cli-grp.
      164       create buf_cli-grp.
      165       assign
      166         buf_cli-grp.upper-code = 1
      167         buf_cli-grp.node-code  = 5
      168         buf_cli-grp.node-name  = "Технологические контрагенты"
      169         dynamic-current-value( "s-cli-grp":U, LDBNAME("DICTDB":U) ) = 5
      170       .
      171       validate buf_cli-grp.
      172     end.
      173     create buf_gds-grp.
      174     assign
      175       buf_gds-grp.upper-code = 0
      176       buf_gds-grp.node-code  = 1
      177       buf_gds-grp.node-name  = "Товары"
      178       buf_gds-grp.calc-method = 'Не-считать':U
      179       dynamic-current-value( "s-gds-grp":U, LDBNAME("DICTDB":U) ) = 1
      180     .
      181     create buf_fbr-gds-grp.
      182     assign
      183       buf_fbr-gds-grp.upper-code = 0
      184       buf_fbr-gds-grp.node-code  = 1
      185       buf_fbr-gds-grp.node-name  = "Блюда"
      186       buf_fbr-gds-grp.host-code  = 0
      187       buf_fbr-gds-grp.obj-type   = ""
      188       buf_fbr-gds-grp.obj-code   = 0
      189       buf_fbr-gds-grp.out-code   = 0
      190     .
      191     create buf_gds-prt .
      192     assign
      193       buf_gds-prt.upper-code = 0
      194       buf_gds-prt.node-code  = 1
      195       buf_gds-prt.node-name  = '_Пустая шкала':U
      196       buf_gds-prt.root       = yes
      197       buf_gds-prt.prt-root   = buf_gds-prt.upper-code
      198       buf_gds-prt.is-term    = true
      199       dynamic-current-value( "s-gds-prt":U, LDBNAME("DICTDB":U) ) = 1
      200     .
      201     create buf_hist-nws-option .
      202     assign
      203       buf_hist-nws-option.table-name = '':U
      204       buf_hist-nws-option.subject-group = '':U
      205       buf_hist-nws-option.db-num = loc_db-num
      206       buf_hist-nws-option.smart-nws = integer('-1':U)
      207       buf_hist-nws-option.nws-to-hist = integer('0':U)
      208       buf_hist-nws-option.nws-to-cd = integer('0':U)
      209       buf_hist-nws-option.hist-to-nws = integer('0':U)
      210       buf_hist-nws-option.hist-from-prim = integer('0':U)
      211       buf_hist-nws-option.get-hist-from-nws = integer('0':U)
      212       buf_hist-nws-option.fill-option = '':U
      213       buf_hist-nws-option.hn-id = 0
      214      dynamic-current-value( "s-hn-id":U, LDBNAME("DICTDB":U) ) = 1
      215     .
      216     if loc_db-num = 0 then do:
      217       create buf_code-range.
      218       assign
      219         buf_code-range.range-type = 'ptlc':U
      220         buf_code-range.PS         = "топливный код"
      221         buf_code-range.beg-date   = today
      222         buf_code-range.first-code = 1
      223         buf_code-range.last-code  = 99
      224         buf_code-range.db-num = loc_db-num
      225         buf_code-range.stts = "u":U
      226       .
      227       create buf_code-range.
      228       assign
      229         buf_code-range.range-type = 'sclc':U
      230         buf_code-range.PS         = "локальный весовой код"
      231         buf_code-range.beg-date   = today
      232         buf_code-range.first-code = 100
      233         buf_code-range.last-code  = 999
      234         buf_code-range.db-num = loc_db-num
      235         buf_code-range.stts = "a":U
      236         dynamic-current-value( "s-sclc-code":U, LDBNAME("DICTDB":U) ) = buf_code-range.first-code - 1
      237       .
      238       define variable v-last-code as integer no-undo .
      239       v-last-code = (  if p-extra-to = 1 then 999999999
      240                                          else (if p-sys-key <> "raimbek":U then 199999 else 2000000000)  ) .
      241       create buf_code-range.
      242       assign
      243         buf_code-range.range-type = 'bcgb':U
      244         buf_code-range.PS         = "авто"
      245         buf_code-range.beg-date   = today
      246         buf_code-range.first-code = 100000
      247         buf_code-range.last-code  = v-last-code
      248         buf_code-range.db-num = loc_db-num
      249         buf_code-range.stts = "a":U
      250         dynamic-current-value( "s-bcgb-code":U, LDBNAME("DICTDB":U) ) =
      251          (if p-sys-key <> "raimbek":U  and p-extra-to <> 1 then buf_code-range.first-code - 1 else buf_code-range.last-code + 1 )
      252       .
      253       if p-extra-to = 1 then do:
      254          buf_code-range.stts = "u".
      255          create buf_code-range.
      256          assign
      257            buf_code-range.range-type = 'bcgb':U
      258            buf_code-range.PS         = "авто"
      259            buf_code-range.beg-date   = today
      260            buf_code-range.first-code = 1000000000
      261            buf_code-range.last-code  = 2000000000
      262            buf_code-range.db-num = loc_db-num
      263            buf_code-range.stts = "a":U
      264            dynamic-current-value( "s-bcgb-code":U, LDBNAME("DICTDB":U) ) =
      265               (if p-sys-key <> "raimbek":U  and p-extra-to <> 1 then buf_code-range.first-code - 1 else buf_code-range.last-code + 1 )
      266          .
      267       end.
      268       create buf_code-range.
      269       assign
      270         buf_code-range.range-type = 'dcgb':U
      271         buf_code-range.PS         = "авто"
      272         buf_code-range.beg-date   = today
      273         buf_code-range.first-code = 1
      274         buf_code-range.last-code  = 99999
      275         buf_code-range.db-num = loc_db-num
      276         buf_code-range.stts = "a":U
      277         dynamic-current-value( "s-dcgb-code":U, LDBNAME("DICTDB":U) ) = buf_code-range.first-code
      278       .
      279       create buf_code-range.
      280       assign
      281         buf_code-range.range-type = 'fmgb':U
      282         buf_code-range.PS         = "авто"
      283         buf_code-range.beg-date   = today
      284         buf_code-range.first-code = 1
      285         buf_code-range.last-code  = 999
      286         buf_code-range.db-num = 0
      287         buf_code-range.stts = "u":U
      288       .
      289       v-last-code = ( if (p-sys-key  = "raimbek":U) or
      290                          (p-extra-to = 1) then 2000000000 else 99999 ).
      291       create buf_code-range.
      292       assign
      293         buf_code-range.range-type = 'fmgb':U
      294         buf_code-range.PS         = "авто"
      295         buf_code-range.beg-date   = today
      296         buf_code-range.first-code = 1000
      297         buf_code-range.last-code  = v-last-code
      298         buf_code-range.db-num = 0
      299         buf_code-range.stts = "a":U
      300         dynamic-current-value( "s-fmgb-code":U, LDBNAME("DICTDB":U) ) =
      301          (if (p-sys-key  = "raimbek":U) or
      302              (p-extra-to = 1) then buf_code-range.last-code + 1 else buf_code-range.first-code - 1 )
      303       .
      304       create buf_code-range.
      305       assign
      306         buf_code-range.range-type = 'pngb':U
      307         buf_code-range.PS         = "авто"
      308         buf_code-range.beg-date   = today
      309         buf_code-range.first-code = 1
      310         buf_code-range.last-code  = ( if p-sys-key <> "raimbek":U then 99999 else 2000000000 )
      311         buf_code-range.db-num = 0
      312         buf_code-range.stts = "a":U
      313         dynamic-current-value( "s-pngb-code":U, LDBNAME("DICTDB":U) ) = (if p-sys-key <> "raimbek":U then buf_code-range.first-code else buf_code-range.last-code + 1 )
      314       .
      315       create buf_code-range.
      316       assign
      317         buf_code-range.range-type = 'drgb':U
      318         buf_code-range.PS         = "авто"
      319         buf_code-range.beg-date   = today
      320         buf_code-range.first-code = 1
      321         buf_code-range.last-code  = 99999
      322         buf_code-range.db-num = 0
      323         buf_code-range.stts = "l":U
      324       .
      325       create buf_code-range.
      326       assign
      327         buf_code-range.range-type = 'drgb':U
      328         buf_code-range.PS         = "авто"
      329         buf_code-range.beg-date   = today
      330         buf_code-range.first-code = 100000
      331         buf_code-range.last-code  = 199999
      332         buf_code-range.db-num = loc_db-num
      333         buf_code-range.stts = "a":U
      334         dynamic-current-value( "s-drgb-code":U, LDBNAME("DICTDB":U) ) = buf_code-range.first-code - 1
      335       .
      336       create buf_code-range.
      337       assign
      338         buf_code-range.range-type = 'ctgb':U
      339         buf_code-range.PS         = "авто"
      340         buf_code-range.beg-date   = today
      341         buf_code-range.first-code = 1
      342         buf_code-range.last-code  = ( if p-sys-key <> "raimbek":U then 1999 else 2000000000 )
      343         buf_code-range.db-num = loc_db-num
      344         buf_code-range.stts = "a":U
      345         dynamic-current-value( "s-ctgb-code":U, LDBNAME("DICTDB":U) ) = (if p-sys-key <> "raimbek":U then buf_code-range.first-code else buf_code-range.last-code + 1 )
      346       .
      347       create buf_code-range.
      348       assign
      349         buf_code-range.range-type = 'cagb':U
      350         buf_code-range.PS         = "авто"
      351         buf_code-range.beg-date   = today
      352         buf_code-range.first-code = 1
      353         buf_code-range.last-code  = 99999
      354         buf_code-range.db-num = loc_db-num
      355         buf_code-range.stts = "a":U
      356         dynamic-current-value( "s-cagb-code":U, LDBNAME("DICTDB":U) ) = buf_code-range.first-code
      357       .
      358       create buf_code-range.
      359       assign
      360         buf_code-range.range-type = 'fdgb':U
      361         buf_code-range.PS         = "авто"
      362         buf_code-range.beg-date   = today
      363         buf_code-range.first-code = 1
      364         buf_code-range.last-code  = 999
      365         buf_code-range.db-num = 0
      366         buf_code-range.stts = "a":U
      367         dynamic-current-value( "s-fin-doc":U, LDBNAME("DICTDB":U) ) = buf_code-range.first-code
      368       .
      369     end.
      370   end.
      371   return.
