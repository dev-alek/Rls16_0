        1   define input-output parameter p-noauto-scls as logical no-undo.
        2   DEFINE BUTTON B-exit AUTO-GO
        3        LABEL "&Ввод"
        4        SIZE 10 BY 1
        5        BGCOLOR 8 .
        6   DEFINE BUTTON b-quit AUTO-END-KEY
        7        LABEL "&Отмена"
        8        SIZE 10 BY 1
        9        BGCOLOR 8 .
       10   DEFINE VARIABLE noauto-scls AS LOGICAL INITIAL no
       11        LABEL "Не отправлять автоматически товары на весы"
       12        VIEW-AS TOGGLE-BOX
       13        SIZE 44.5 BY .83 NO-UNDO.
       14   DEFINE FRAME Dialog-Frame
       15        B-exit AT ROW 1 COL 1 WIDGET-ID 2
       16        b-quit AT ROW 1 COL 11 WIDGET-ID 4
       17        noauto-scls AT ROW 2.25 COL 1.5 WIDGET-ID 6
       18        SPACE(0.87) SKIP(0.62)
       19       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       20            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       21            TITLE "Дополнительно" WIDGET-ID 100.
       22   ASSIGN
       23          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       24          FRAME Dialog-Frame:HIDDEN           = TRUE.
       25   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       26   DO:
       27     APPLY "END-ERROR":U TO SELF.
       28   END.
       29   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
       30   DO:
       31     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
       32     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
       33   END.
       34   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       35   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       36   MAIN-BLOCK:
       37   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       38      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       39     RUN enable_UI.
       40     run init.
       41     WAIT-FOR GO OF FRAME Dialog-Frame.
       42   END.
       43   RUN disable_UI.
       44   PROCEDURE disable_UI :
       45     HIDE FRAME Dialog-Frame.
       46   END PROCEDURE.
       47   PROCEDURE enable_UI :
       48     DISPLAY noauto-scls
       49         WITH FRAME Dialog-Frame.
       50     ENABLE B-exit b-quit noauto-scls
       51         WITH FRAME Dialog-Frame.
       52     VIEW FRAME Dialog-Frame.
       53   END PROCEDURE.
       54   procedure init:
       55   noauto-scls = p-noauto-scls.
       56   display noauto-scls with frame Dialog-Frame.
       57   end procedure.
       58   procedure proc-save:
       59   assign frame Dialog-Frame
       60     noauto-scls
       61   .
       62   p-noauto-scls = noauto-scls.
       63   end procedure.
