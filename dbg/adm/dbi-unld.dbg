        1   define input param mode as char no-undo.
        2   define input-output param  ri as recid no-undo init ?.
        3   define output parameter p-unload-history as logical no-undo .
        4   define output parameter p-db-dst as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Редактирование БД".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1',mode)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   Function reverse returns character (str as character).
      130      define variable rev_incl_s as character init "" no-undo .
      131      define variable rev_incl_i as integer no-undo .
      132      define variable rev_incl_l as integer no-undo .
      133      rev_incl_l = length(str).
      134      do rev_incl_i = 1 to rev_incl_l:
      135         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      136      end.
      137      return rev_incl_s.
      138   end.
      139   procedure check-enc.
      140     define input  parameter p-db-num    as integer   no-undo .
      141     define input  parameter p-db-key    as character no-undo .
      142     define input  parameter p-code      as character no-undo .
      143     define input  parameter p-value     as character no-undo .
      144     define input  parameter p-beg-date  as date      no-undo .
      145     define input  parameter p-end-date  as date      no-undo .
      146     define input  parameter p-enc-value as character no-undo .
      147     define output parameter p-answer    as logical   no-undo .
      148     define variable tmp         as character no-undo .
      149     define variable v-enc-value as character no-undo .
      150     if p-db-num <> 0
      151       and p-db-key = "":U
      152     then do:
      153       assign
      154         p-answer = true
      155       .
      156       return.
      157     end.
      158     if p-db-key = "unload-db":U then do:
      159       assign
      160         p-answer = true
      161       .
      162       return.
      163     end.
      164     if p-code = ""  then do:
      165       assign
      166         tmp = string( p-db-num ) + reverse (p-db-key).
      167       .
      168     end.
      169     else do:
      170       assign
      171         tmp = string( p-db-num )
      172               + trim( p-db-key )
      173               + reverse( trim( p-code ) )
      174               + reverse( trim( p-value ) )
      175               + reverse( string( p-beg-date, "99.99.9999" ) )
      176               + reverse( string( p-end-date, "99.99.9999" ) )
      177       .
      178     end.
      179     run pswd-enc in this-procedure
      180       ( input tmp
      181        ,output v-enc-value
      182       ) no-error .
      183     if error-status:error then do:
      184       message
      185         vss-workfile vss-revision vss-description skip
      186         "Ошибка при вызове процедуры pswd-enc" skip
      187         return-value skip
      188         error-status :get-message(1) skip
      189         view-as alert-box error .
      190       undo, return error .
      191     end.
      192     if v-enc-value = p-enc-value then do:
      193       assign
      194         p-answer = true
      195       .
      196     end.
      197     else do:
      198       assign
      199         p-answer = false
      200       .
      201     end.
      202   end.
      203   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   procedure pswd-enc :
      205     define input parameter  pswd     as character no-undo .
      206     define output parameter enc-pswd as character no-undo .
      207     do
      208     on error undo, return error return-value
      209     :
      210       assign
      211         enc-pswd = encode(pswd + string(index(pswd, "k")))
      212       .
      213     end.
      214   end procedure.
      215   function diff-list returns character (
      216     input parfirst-list  as character,
      217     input parsecond-list as character,
      218     input pardelim       as character).
      219     if pardelim = ""
      220     or pardelim = ?
      221     then do:
      222       assign
      223         pardelim = ","
      224       .
      225     end.
      226     def var ind as integer no-undo .
      227     def var v-elem as character no-undo .
      228     def var v-result-list as character no-undo init "".
      229     def var v-num-parfirst-list as integer no-undo .
      230     assign
      231       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      232     .
      233     do ind = 1 to v-num-parfirst-list
      234     :
      235       assign
      236         v-elem = entry(ind, parfirst-list, pardelim)
      237       .
      238       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      239         assign
      240           v-result-list = v-result-list
      241                         + (if v-result-list > "" then pardelim else "")
      242                         + v-elem
      243         .
      244       end.
      245     end.
      246     return v-result-list .
      247   end function.
      248   function add-list returns character (
      249    input parfirst-list  as character,
      250    input parsecond-list as character,
      251    input pardelim       as character).
      252     if pardelim = ""
      253     or pardelim = ?
      254     then do:
      255       assign
      256         pardelim = ","
      257       .
      258     end.
      259     def var ind as integer no-undo .
      260     def var v-elem as character no-undo .
      261     def var v-result-list as character no-undo init "".
      262     def var v-num-parfirst-list as integer no-undo .
      263     assign
      264       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      265     .
      266     do ind = 1 to v-num-parfirst-list
      267     :
      268       assign
      269         v-elem = entry(ind, parfirst-list, pardelim)
      270       .
      271       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      272         assign
      273           v-result-list = v-result-list
      274                         + (if v-result-list > "" then pardelim else "")
      275                         + v-elem
      276         .
      277       end.
      278     end.
      279     def var v-num-parsecond-list as integer no-undo .
      280     assign
      281       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      282     .
      283     do ind = 1 to v-num-parsecond-list
      284     :
      285       assign
      286         v-elem = entry(ind, parsecond-list, pardelim)
      287       .
      288       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      289         assign
      290           v-result-list = v-result-list
      291                         + (if v-result-list > "" then pardelim else "")
      292                         + v-elem
      293         .
      294       end.
      295     end.
      296     return v-result-list .
      297   end function.
      298   function cross-list returns character (
      299    input parfirst-list  as character,
      300    input parsecond-list as character,
      301    input pardelim       as character).
      302     if pardelim = ""
      303     or pardelim = ?
      304     then do:
      305       assign
      306         pardelim = ","
      307       .
      308     end.
      309     def var ind as integer no-undo .
      310     def var v-elem as character no-undo .
      311     def var v-result-list as character no-undo init "".
      312     def var v-num-parfirst-list as integer no-undo .
      313     assign
      314       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      315     .
      316     do ind = 1 to v-num-parfirst-list
      317     :
      318       assign
      319         v-elem = entry(ind, parfirst-list, pardelim)
      320       .
      321       if lookup(v-elem, v-result-list, pardelim) = 0
      322       and lookup(v-elem, parsecond-list, pardelim) > 0
      323       then do:
      324         assign
      325           v-result-list = v-result-list
      326                         + (if v-result-list > "" then pardelim else "")
      327                         + v-elem
      328         .
      329       end.
      330     end.
      331     return v-result-list .
      332   end function.
      333   function radio-label returns character (
      334    input par-rs-value  as character,
      335    input par-rs-radio-buttons as character)
      336    .
      337    DEFINE variable v-result-label as character no-undo.
      338    assign
      339    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      340                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      341                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      342                             ), par-rs-radio-buttons
      343                           )
      344    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      345    .
      346   return v-result-label.
      347   end function.
      348   function m-radio-label returns character (
      349    input par-rs-value  as character,
      350    input par-rs-radio-buttons as character,
      351    input par-delim as character
      352    )
      353    .
      354    DEFINE variable v-result-label as character no-undo.
      355    assign
      356    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      357                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      358                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      359                             ), par-rs-radio-buttons, par-delim
      360                           )
      361    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      362    .
      363   return v-result-label.
      364   end function.
      365   FUNCTION mixlist returns character
      366   (
      367    input parfirst-list  as character
      368    ,input parsecond-list as character
      369    ,input pardelim       as character
      370    ,input pardelim-result as character ) :
      371     if pardelim = ""
      372     or pardelim = ?
      373     then do:
      374       assign
      375         pardelim = ","
      376       .
      377     end.
      378     def var ind as integer no-undo .
      379     def var v-elem1 as character no-undo .
      380     def var v-elem2 as character no-undo .
      381     def var v-result-list as character no-undo init "".
      382     do ind = 1 to num-entries(parfirst-list, pardelim)
      383     :
      384       assign
      385         v-elem1 = entry(ind, parfirst-list, pardelim)
      386         v-elem2 = entry(ind, parsecond-list, pardelim)
      387       .
      388         assign
      389           v-result-list = v-result-list
      390                         + (if v-result-list > "" then pardelim-result else "")
      391                         + v-elem1 + pardelim-result + v-elem2
      392         .
      393     end.
      394     return v-result-list .
      395   END FUNCTION.
      396   procedure save-db-key :
      397     define input parameter p-db-key like ub.db.db-key no-undo .
      398     do
      399     on error undo, return error
      400     :
      401       define buffer buf_rep for ub.rep .
      402       find buf_rep
      403         where buf_rep.rep-num = 1996011200
      404         no-error
      405       .
      406       if not available buf_rep then do:
      407         create buf_rep.
      408         assign
      409           buf_rep.rep-num = 1996011200
      410         .
      411       end.
      412       if lookup( p-db-key, buf_rep.name1 ) = 0 then do:
      413         assign
      414           buf_rep.name1 = buf_rep.name1 + ",":U + p-db-key
      415         .
      416       end.
      417     end.
      418   end procedure.
      419   procedure del-db-key :
      420     define input parameter p-db-key like ub.db.db-key no-undo .
      421     do
      422     on error undo, return error
      423     :
      424       define buffer buf_rep for ub.rep .
      425       define buffer buf_db  for ub.db .
      426       find first buf_db
      427         where buf_db.db-key = p-db-key
      428         no-error
      429       .
      430       if not available buf_db then do:
      431         find first buf_rep
      432           where buf_rep.rep-num = 1996011200
      433           no-error
      434         .
      435         if available buf_rep
      436           and lookup( p-db-key, buf_rep.name1 ) <> 0
      437         then do:
      438           assign
      439             buf_rep.name1 = diff-list( buf_rep.name1, p-db-key, ",":U )
      440           .
      441         end.
      442       end.
      443     end.
      444   end procedure.
      445   procedure chk-db-key :
      446     define input  parameter p-db-num     like ub.db.db-num     no-undo.
      447     define input  parameter p-db-key     like ub.db.db-key     no-undo.
      448     define input  parameter p-db-key-enc like ub.db.db-key-enc no-undo.
      449     define output parameter p-result     as   integer          no-undo .
      450     do
      451     on error undo, return error
      452     :
      453       define buffer buf_rep for ub.rep .
      454       define buffer buf_db  for ub.db .
      455       define variable v-ok as logical no-undo .
      456       if p-db-key = ?
      457         or p-db-key = ""
      458       then do:
      459         assign
      460           p-result = 1
      461         .
      462         return string("Не задано значение ключа БД.").
      463       end.
      464       if p-db-key-enc = ?
      465         or p-db-key-enc = ""
      466       then do:
      467         assign
      468           p-result = 2
      469         .
      470         return string("Не задано кодированное значение ключа БД.").
      471       end.
      472       find buf_rep
      473         where buf_rep.rep-num = 1996011200
      474         no-error
      475       .
      476       if not available buf_rep then do:
      477         create buf_rep.
      478         assign
      479           buf_rep.rep-num = 1996011200
      480         .
      481       end.
      482       for each buf_db no-lock
      483       on error undo, return error
      484       :
      485         if lookup( buf_db.db-key, buf_rep.name1 ) = 0 then do:
      486           assign
      487             buf_rep.name1 = buf_rep.name1 + ",":U + buf_db.db-key
      488           .
      489         end.
      490       end.
      491       assign
      492         p-result = 0
      493       .
      494       if lookup( p-db-key, buf_rep.name1 ) <> 0 then do:
      495         assign
      496           p-result = 1
      497         .
      498         return string("Данное значение ключа БД уже существует.").
      499       end.
      500       run check-enc in this-procedure
      501         ( input p-db-num
      502          ,input p-db-key
      503          ,input ""
      504          ,input ""
      505          ,input ?
      506          ,input ?
      507          ,input p-db-key-enc
      508          ,output v-ok
      509         ) no-error.
      510       if error-status:error then do:
      511         assign
      512           p-result = 1
      513         .
      514         return substitute( "Ошибка при проверке правильности кодирования. &1", error-status:get-message (1) ) .
      515       end.
      516       if v-ok <> true then do:
      517         assign
      518           p-result = 2
      519         .
      520         return string("Неверное кодированное значение ключа БД.").
      521       end.
      522     end.
      523   end procedure.
      524   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      525        LABEL "&Ввод ":L
      526        SIZE 10 BY 1.
      527   DEFINE BUTTON b-help DEFAULT
      528        LABEL "Помо&щь":L
