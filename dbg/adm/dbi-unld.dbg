      577             VIEW-AS FILL-IN
      578             SIZE 13 BY 1
      579        ub.db.db-key-enc AT ROW 2.67 COL  55 COLON-ALIGNED
      580             LABEL "Кодировка" FORMAT "X(16)"
      581             VIEW-AS FILL-IN
      582             SIZE 17 BY 1
      583        ub.db.db-name AT ROW 3.88 COL 10.63 COLON-ALIGNED FORMAT "X(40)"
      584             VIEW-AS FILL-IN
      585             SIZE 57.38 BY 1
      586        ub.db.add-clients AT ROW 5.75 COL 3
      587             VIEW-AS TOGGLE-BOX
      588             SIZE 22.5 BY .83 TOOLTIP "Возможность добавления клиентов"
      589        ub.db.remote-stock AT ROW 5.75 COL 27 HELP
      590             ""
      591             VIEW-AS TOGGLE-BOX
      592             SIZE 16.5 BY .83 TOOLTIP "Отправка чужих остатков"
      593        ub.db.send-check AT ROW 5.75 COL 50.5 HELP
      594             ""
      595             LABEL "Пересылать чеки"
      596             VIEW-AS TOGGLE-BOX
      597             SIZE 18.5 BY .83 TOOLTIP "ОТправлять чеки из БД в ГБД"
      598        ub.db.add-goods AT ROW 6.75 COL 3
      599             VIEW-AS TOGGLE-BOX
      600             SIZE 22.13 BY .83 TOOLTIP "Возможность добавлять товары"
      601        ub.db.on-line-rest AT ROW 6.75 COL 27 WIDGET-ID 2
      602             VIEW-AS TOGGLE-BOX
      603             SIZE 22 BY .83
      604        t-save-packs AT ROW 8 COL 3 WIDGET-ID 8
      605        ub.db.save-packs AT ROW 8 COL 53.5 COLON-ALIGNED HELP
      606             "" WIDGET-ID 6
      607             LABEL "через"
      608             VIEW-AS FILL-IN
      609             SIZE 5 BY 1
      610        ub.db.max-p-size AT ROW 9.5 COL 51 COLON-ALIGNED
      611             LABEL "Максимальное кол-во записей в пакете"
      612             VIEW-AS FILL-IN
      613             SIZE 14.38 BY 1
      614        ub.db.max-p-queue AT ROW 11.5 COL 51 COLON-ALIGNED
      615             LABEL "Кол-во неподтвержденных пакетов больше"
      616             VIEW-AS FILL-IN
      617             SIZE 6.25 BY 1
      618        ub.db.max-p-time AT ROW 12.75 COL 51 COLON-ALIGNED HELP
      619             ""
      620             LABEL "Время ожидания подтверждения больше (мин)" FORMAT ">>>>>9"
      621             VIEW-AS FILL-IN
      622             SIZE 7 BY 1
      623        ub.db.unload-arch AT ROW 14.25 COL 3
      624             LABEL "Выгружать складские архивы по товарам и по поставщикам"
      625             VIEW-AS TOGGLE-BOX
      626             SIZE 64 BY .83
      627             FGCOLOR 12
      628        ub.db.unload-aht AT ROW 15.25 COL 3
      629             LABEL "Выгружать складской архив по типам приобретения"
      630             VIEW-AS TOGGLE-BOX
      631             SIZE 64 BY .83
      632             FGCOLOR 12
      633        t-unload-history AT ROW 16.25 COL 3 WIDGET-ID 4
      634        f-days AT ROW 8 COL 59.5 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      635        f-if AT ROW 10.75 COL 2.5 NO-LABEL
      636        RECT-2 AT ROW 7.75 COL 2
      637        RECT-4 AT ROW 14 COL 2
      638        RECT-1 AT ROW 5.5 COL 2
      639        RECT-3 AT ROW 9.25 COL 2 WIDGET-ID 12
      640        RECT-5 at row 17.75 col 2
      641        "Целевая база данных" VIEW-AS TEXT
      642             SIZE 21.38 BY .75 AT ROW 18 COL 3
      643        v-db-dst AT ROW 19.5 COL 14.5 COLON-ALIGNED
      644        SPACE(0.74) SKIP(0.70)
      645       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      646            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      647            TITLE "БД":L
      648            CANCEL-BUTTON b-quit.
      649   ASSIGN
      650          FRAME dbi:SCROLLABLE       = FALSE.
      651   ASSIGN
      652          f-days:HIDDEN IN FRAME dbi           = TRUE
      653          f-days:READ-ONLY IN FRAME dbi        = TRUE.
      654   ASSIGN
      655          f-if:HIDDEN IN FRAME dbi           = TRUE
      656          f-if:READ-ONLY IN FRAME dbi        = TRUE.
      657   ASSIGN
      658          ub.db.max-p-queue:HIDDEN IN FRAME dbi           = TRUE.
      659   ASSIGN
      660          ub.db.max-p-size:HIDDEN IN FRAME dbi           = TRUE.
      661   ASSIGN
      662          ub.db.max-p-time:HIDDEN IN FRAME dbi           = TRUE.
      663   ASSIGN
      664          ub.db.on-line-rest:HIDDEN IN FRAME dbi           = TRUE.
      665   ASSIGN
      666          RECT-2:HIDDEN IN FRAME dbi           = TRUE.
      667   ASSIGN
      668          RECT-3:HIDDEN IN FRAME dbi           = TRUE.
      669   ASSIGN
      670          RECT-4:HIDDEN IN FRAME dbi           = TRUE.
      671   ASSIGN
      672          ub.db.remote-stock:HIDDEN IN FRAME dbi           = TRUE.
      673   ASSIGN
      674          ub.db.save-packs:HIDDEN IN FRAME dbi           = TRUE.
      675   ASSIGN
      676          ub.db.send-check:HIDDEN IN FRAME dbi           = TRUE.
      677   ASSIGN
      678          t-save-packs:HIDDEN IN FRAME dbi           = TRUE.
      679   ASSIGN
      680          t-unload-history:HIDDEN IN FRAME dbi           = TRUE.
      681   ASSIGN
      682          ub.db.unload-aht:HIDDEN IN FRAME dbi           = TRUE.
      683   ASSIGN
      684          ub.db.unload-arch:HIDDEN IN FRAME dbi           = TRUE.
      685   ON CHOOSE OF b-exit IN FRAME dbi
      686   DO:
      687     define variable ret-val as integer no-undo .
      688     define variable v-db-attr-del as logical   no-undo .
      689     define buffer buf1_db     for ub.db .
      690     define buffer buf_clients for ub.clients .
      691     define buffer buf_gds-obj for ub.gds-obj .
      692     if mode = "add":U then do:
      693       if input frame dbi ub.db.db-num = ? then do:
      694         message "Введите номер БД."
      695                 view-as alert-box error.
      696         apply "ENTRY" to ub.db.db-num.
      697         return no-apply.
      698       end.
      699       if can-find (buf1_db where buf1_db.db-num = input frame dbi ub.db.db-num no-lock ) then do:
      700         message "БД с таким номером уже есть."
      701                 view-as alert-box error.
      702         apply "ENTRY" to ub.db.db-num.
      703         undo, return no-apply.
      704       end.
      705     end.
      706     if ub.db.db-num :sensitive in frame dbi = true then do:
      707       assign
      708         ub.db.db-num
      709       .
      710     end.
      711     if ub.db.db-key :sensitive in frame dbi = true then do:
      712       if mode = "unld":U
      713         or ( mode <> "unld":U
      714              and trim( ub.db.db-key ) <> "":U
      715            )
      716       then do:
      717         run chk-db-key
      718           ( input ( input frame dbi ub.db.db-num )
      719           ,input ( input frame dbi ub.db.db-key )
      720           ,input ( input frame dbi ub.db.db-key-enc )
      721           ,output ret-val
      722           ).
      723         if ret-val <> 0 then do:
      724           message return-value
      725                   view-as alert-box error.
      726           if ret-val = 1 then do:
      727             apply "ENTRY" to ub.db.db-key.
      728           end.
      729           else do:
      730             apply "ENTRY" to ub.db.db-key-enc.
      731           end.
      732           undo, return no-apply.
      733         end.
      734         assign
      735           ub.db.db-key
      736           ub.db.db-key-enc
      737           .
      738       end.
      739     end.
      740     if input frame dbi ub.db.db-name = "" then do:
      741       message "Название БД не может быть пустым."
      742               view-as alert-box error.
      743       apply "ENTRY" to ub.db.db-name.
      744       undo, return no-apply.
      745     end.
      746     if ub.db.on-line-rest = true
      747       and input frame dbi ub.db.on-line-rest = false
      748     then do:
      749       for each buf_clients no-lock
      750         where buf_clients.db-num = ub.db.db-num
      751         ,each buf_gds-obj
      752         where buf_gds-obj.obj-type = buf_clients.obj-type
      753           and buf_gds-obj.obj-code = buf_clients.obj-code
      754       on error undo, return no-apply
      755       :
      756         assign
      757           buf_gds-obj.on-line-rest = ?
      758         .
      759       end.
      760     end.
      761     assign
      762       ub.db.db-name
      763       ub.db.add-clients
      764       ub.db.add-goods
      765       ub.db.on-line-rest
      766       ub.db.remote-stock
      767       ub.db.max-p-queue
      768       ub.db.max-p-time
      769       ub.db.max-p-size
      770       ub.db.db-key
      771       ub.db.db-key-enc
      772       ub.db.send-check
      773       ub.db.unload-arch
      774       ub.db.unload-aht
      775       t-save-packs
      776       t-unload-history when mode = "unld"
      777       v-db-dst when mode = "unld"
      778       ri = recid (ub.db)
      779       p-unload-history = t-unload-history
      780       p-db-dst = v-db-dst
      781     .
      782     if trim( ub.db.db-key ) <> "":U then do:
      783       run save-db-key( ub.db.db-key ) no-error.
      784       if error-status:error then do:
      785         message
      786           vss-workfile vss-revision vss-description skip
      787           substitute( "Невозможно сохранить ключ базы." ) skip
      788           return-value skip
      789           error-status :get-message ( error-status :num-messages )
      790           view-as alert-box error
      791         .
      792         undo, return no-apply.
      793       end.
      794     end.
      795     if p-db-dst = "":U and mode = "unld" then do:
      796       message
      797         vss-workfile vss-revision vss-description skip
      798         substitute( "Нeобходимо указать параметры соединения с целевой базой!" ) skip
      799         view-as alert-box error
      800       .
      801       apply "entry" to v-db-dst in frame dbi .
      802       return no-apply.
      803     end.
      804     if t-save-packs :sensitive in frame dbi = true then do:
      805       if t-save-packs = true then do:
      806         assign
      807           ub.db.save-packs
      808         .
      809       end.
      810       else do:
      811         assign
      812           ub.db.save-packs = ?
      813         .
      814       end.
      815     end.
      816   END.
      817   ON CHOOSE OF b-quit IN FRAME dbi
      818   DO:
      819     if mode = "add":U then do:
      820       delete ub.db.
      821     end.
      822     if mode <> "lkp":U then do:
      823       assign
      824         ri = ?
      825       .
      826     end.
      827   END.
      828   ON LEAVE OF ub.db.save-packs IN FRAME dbi
      829   DO:
      830     assign
      831       ub.db.save-packs
      832     .
      833     if ub.db.save-packs < 10 then do:
      834       message
      835         substitute( "Удалять пакеты раньше чем через 10 дней нельзя!" )
      836         view-as alert-box.
      837       assign
      838         ub.db.save-packs = 10
      839       .
      840     end.
      841   END.
      842   ON VALUE-CHANGED OF t-save-packs IN FRAME dbi
      843   DO:
      844     assign
      845       t-save-packs
      846     .
      847     if t-save-packs = true then do:
      848       if ub.db.save-packs = ?
      849         or ub.db.save-packs < 10
      850       then do:
      851         assign
      852           ub.db.save-packs = 10
      853         .
      854       end.
      855       enable
      856         ub.db.save-packs
      857         with frame dbi
      858         .
      859       display
      860         ub.db.save-packs
      861         f-days
      862         with frame dbi
      863         .
      864     end.
      865     else do:
      866       hide
      867         ub.db.save-packs
      868         f-days
      869         in frame dbi
      870         .
      871     end.
      872   END.
      873   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME dbi:PARENT eq ?
      874   THEN FRAME dbi:PARENT = ACTIVE-WINDOW.
      875   ON WINDOW-CLOSE OF FRAME dbi APPLY "END-ERROR":U TO SELF.
      876   MAIN-BLOCK:
      877   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      878      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      879      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      880   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   on help of frame dbi
      882   do:
      883     run gbl/app_help.p
      884       (input this-procedure :file-name
      885       ,input ''
      886       ,input ?
      887       ) no-error.
      888     if error-status :error then do:
      889       message
      890         "Ошибка при вызове помощи"
      891         error-status :get-message(1)
      892         view-as alert-box .
      893     end.
      894   end.
      895   run minbtn-set in this-procedure .
      896   on choose of b-help in frame dbi
      897   do:
      898     apply "help":u to frame dbi .
      899   end.
      900   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   procedure minbtn-set :
      902       do
      903           on error undo, return error return-value
      904           :
      905           define variable ii              as integer       no-undo .
      906           define variable fh              as widget-handle no-undo .
      907           define variable hh              as widget-handle no-undo .
      908           define variable v-h             as handle        extent 4 no-undo .
      909           define variable v-name-button   as character     no-undo .
      910           define variable v-help-old-x    as decimal       no-undo .
      911           define variable v-help-old-y    as decimal       no-undo .
      912           define variable v-help-old-size as decimal       no-undo .
      913           define variable v-frame-width   as decimal       no-undo .
      914           define variable jj              as integer       no-undo .
      915           do
      916               on error undo, return error
      917               :
      918               assign
      919                   v-frame-width = frame dbi:width - 0.3
      920                   fh            = frame dbi:first-child
      921                   hh            = fh:first-child
      922                   ii            = 1
      923                   .
      924               do while valid-handle(hh):
      925                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      926                   do:
      927                       case lc(hh:name) :
      928                           when "b-help" then
      929                               do:
      930                                   hh:load-image-up("cmp/b-help.bmp":u) .
      931                                   hh:load-image-down("cmp/b-help.bmp":u) .
      932                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      933                                   hh:TOOLTIP = "Помощь" .
      934                                   v-help-old-x = hh:column .
      935                                   v-help-old-y = hh:row    .
      936                                   v-help-old-size = hh:width .
      937                                   hh:width-chars = 2.5 .
      938                               end.
      939                           when "b-print" then
      940                               do:
      941                                   hh:load-image("cmp/b-print.bmp":u) .
      942                                   hh:TOOLTIP = "Печать" .
      943                                   v-h[ii] = hh:handle .
      944                                   ii = ii + 1 .
      945                                   hh:width-chars = 3 .
      946                               end.
      947                           when "b-history" or
      948                           when "b-hist" then
      949                               do:
      950                                   hh:load-image("cmp/b-hist.bmp":u) .
      951                                   hh:TOOLTIP = "История" .
      952                                   v-h[ii] = hh:handle .
      953                                   ii = ii + 1 .
      954                                   hh:width-chars = 3 .
      955                               end.
      956                           when "b-sch" then
      957                               do:
      958                                   hh:load-image("cmp/b-sch.bmp":u) .
      959                                   hh:TOOLTIP = "Установка Фильтра" .
      960                                   v-h[ii] = hh:handle .
      961                                   ii = ii + 1 .
      962                                   hh:width-chars = 3 .
      963                               end.
      964                           when "b-hist-user" then
      965                               do:
      966                                   hh:load-image("cmp/b-hist.bmp":u) .
      967                                   hh:TOOLTIP = "История пользователя" .
      968                                   ii = ii + 1 .
      969                               end.
      970                       end case.
      971                   end.
      972                   hh = hh:next-sibling.
      973               end.
      974               b-help:column = v-frame-width - b-help:width-chars.
      975               jj = 0.
      976               repeat ii = 4 to 1 by -1 :
      977                   if valid-handle (v-h[ii] ) then
      978                   do:
      979                       jj  = jj + 1 .
      980                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      981                       v-h[ii]:row    = v-help-old-y .
      982                   end.
      983               end.
      984           end.
      985       end.
      986   end procedure.
      987     define variable ret-val as integer no-undo .
      988     define variable v-db-attr-value as character no-undo .
      989     define variable v-db-attr-type  as character no-undo .
      990     if mode <> "add":U then do:
      991       if mode = "lkp":U then do:
      992         find ub.db no-lock
      993           where recid (ub.db) = ri
      994           no-error
      995         .
      996       end.
      997       else do:
      998         find ub.db exclusive-lock
      999           where recid (ub.db) = ri
     1000           no-error
     1001         .
     1002       end.
     1003       if not available ub.db then do:
     1004         message
     1005           vss-workfile vss-revision vss-description skip
     1006           substitute( "БД &1 удалена." ) skip
     1007           view-as alert-box information
     1008         .
     1009         return error .
     1010       end.
     1011     end.
     1012     case mode:
     1013       when "add":U then do:
     1014         create ub.db.
     1015         frame dbi:title = "Добавление БД".
     1016         assign
     1017           ub.db.db-key      = "":U
     1018           ub.db.db-key-enc  = "":U
     1019           ub.db.max-p-size  = 10000
     1020           ub.db.max-p-time  = 20
     1021           ub.db.max-p-queue = 10
     1022         .
     1023       end.
     1024       when "unld":U then do:
     1025         frame dbi:title = "Выгрузка БД".
     1026         if trim( ub.db.db-key ) <> "":U
     1027           and trim( ub.db.db-key-enc ) <> "":U
     1028         then do:
     1029           run chk-db-key ( input ub.db.db-num
     1030                           ,input ub.db.db-key
     1031                           ,input ub.db.db-key-enc
     1032                           ,output ret-val
     1033                          ).
     1034         end.
     1035         assign
     1036           ub.db.db-key     = "":U
     1037           ub.db.db-key-enc = "":U
     1038         .
     1039       end.
     1040       when "upd":U then do:
     1041         frame dbi:title = "Изменение БД".
     1042       end.
     1043       when "lkp":U then do:
     1044         frame dbi:title = "Просмотр БД".
     1045       end.
     1046       otherwise do:
     1047         message
     1048           vss-workfile vss-revision vss-description skip
     1049           substitute( "Не предусмотрена операция &1", mode ) skip
     1050           view-as alert-box error
     1051         .
     1052         return error .
     1053       end.
     1054     end case.
     1055     session:data-entry-return = yes .
     1056     if ub.db.db-num = 0 then do:
     1057       assign
     1058         frame dbi :height-chars = 8.5
     1059       .
     1060     end.
     1061     RUN enable_UI.
     1062     if ub.db.db-num <> 0 then do:
     1063       enable
     1064         ub.db.on-line-rest
     1065         ub.db.send-check
     1066         ub.db.remote-stock
     1067         ub.db.max-p-queue
     1068         ub.db.max-p-time
     1069         ub.db.max-p-size
     1070         ub.db.unload-arch
     1071         ub.db.unload-aht
     1072         t-save-packs
     1073         RECT-2
     1074         RECT-3
     1075         RECT-4
     1076         f-if
     1077         WITH FRAME dbi
     1078       .
     1079       display
     1080         ub.db.on-line-rest
     1081         ub.db.send-check
     1082         ub.db.remote-stock
     1083         ub.db.max-p-queue
     1084         ub.db.max-p-time
     1085         ub.db.max-p-size
     1086         ub.db.unload-arch
     1087         ub.db.unload-aht
     1088         t-save-packs
     1089         f-if
     1090         WITH FRAME dbi
     1091       .
     1092       if ub.db.save-packs <> ? then do:
     1093         assign
     1094           t-save-packs = true
     1095         .
     1096       end.
     1097       else do:
     1098         assign
     1099           t-save-packs = false
     1100         .
     1101       end.
     1102       display
     1103         t-save-packs
     1104         with frame dbi
     1105       .
     1106       apply "VALUE-CHANGED" to t-save-packs in frame dbi .
     1107     end.
     1108     case mode:
     1109       when "add":U then do:
     1110         ENABLE ub.db.db-num WITH FRAME dbi.
     1111       end.
     1112       when "unld":U then do:
     1113         ENABLE ub.db.db-key ub.db.db-key-enc t-unload-history v-db-dst WITH FRAME dbi.
     1114         display
     1115           t-unload-history
     1116           v-db-dst
     1117           with frame dbi .
     1118       end.
     1119       when "upd":U then do:
     1120         if trim( ub.db.db-key ) = "":U
     1121           or trim( ub.db.db-key ) = ?
     1122         then do:
     1123           ENABLE ub.db.db-key ub.db.db-key-enc WITH FRAME dbi.
     1124         end.
     1125       end.
     1126       when "lkp":U then do:
     1127         disable all WITH FRAME dbi.
     1128         ENABLE b-quit b-help WITH FRAME dbi.
     1129       end.
     1130     end case.
     1131     WAIT-FOR GO OF FRAME dbi.
     1132   END.
     1133   RUN disable_UI.
     1134   session:data-entry-return = no .
     1135   PROCEDURE disable_UI :
     1136     HIDE FRAME dbi.
     1137   END PROCEDURE.
     1138   PROCEDURE enable_UI :
     1139     IF AVAILABLE ub.db THEN
     1140       DISPLAY ub.db.db-num ub.db.db-key ub.db.db-key-enc ub.db.db-name
     1141             ub.db.add-clients ub.db.add-goods
     1142         WITH FRAME dbi.
     1143     ENABLE b-exit b-quit b-help RECT-1 ub.db.db-name ub.db.add-clients
     1144            ub.db.add-goods
     1145         WITH FRAME dbi.
     1146   END PROCEDURE.
