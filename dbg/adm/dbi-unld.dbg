      553        VIEW-AS TOGGLE-BOX
      554        SIZE 45 BY 1 NO-UNDO.
      555   DEFINE VARIABLE t-unload-history AS LOGICAL INITIAL yes
      556        LABEL "Выгружать историю"
      557        VIEW-AS TOGGLE-BOX
      558        SIZE 64 BY .83
      559        FGCOLOR 12  NO-UNDO.
      560   DEFINE VARIABLE v-db-dst AS CHARACTER FORMAT "X(256)":U
      561        LABEL "Целевая БД"
      562        VIEW-AS FILL-IN
      563        SIZE 30.88 BY 1 NO-UNDO.
      564   DEFINE RECTANGLE RECT-5
