      352   do
      353   on error undo, return error return-value
      354   :
      355     run copy-clients-attr in this-procedure .
      356     for each ub.clients no-lock
      357       where ub.clients.db-num = p-db-num
      358     on error undo, return error
      359     :
      360       run copy-archive-attr in this-procedure
      361         (input  ub.clients.obj-type
      362         ,input  ub.clients.obj-code
      363         ,input  p-copy-arh
      364         ,input  p-copy-ahsp
      365         ,input  p-copy-aht
      366         ) .
      367     end.
      368   end.
      369   procedure copy-clients-attr :
      370     define variable v-filter-reject     as character no-undo .
      371     do
      372     on error undo, return error return-value
      373     :
      374       run clntattr-get-archive-attr in this-procedure
      375         (output v-filter-reject
      376         ) .
      377       for each ub.clients-attr
      378       on error undo, return error return-value
      379       :
      380         if lookup(ub.clients-attr.attr-code, v-filter-reject) > 0
      381         then do:
      382           next .
      383         end.
      384         create dst.clients-attr .
      385         buffer-copy ub.clients-attr to dst.clients-attr .
      386       end.
      387     end.
      388   end procedure.
      389   procedure copy-archive-attr :
      390     define input  parameter p-obj-type  as character no-undo .
      391     define input  parameter p-obj-code  as integer   no-undo .
      392     define input  parameter p-copy-arh  as logical   no-undo .
      393     define input  parameter p-copy-ahsp as logical   no-undo .
      394     define input  parameter p-copy-aht  as logical   no-undo .
      395     define variable v-copy-arh-list  as character no-undo .
      396     define variable v-copy-ahsp-list as character no-undo .
      397     define variable v-copy-aht-list  as character no-undo .
      398     define variable v-copy-list      as character no-undo .
      399     do
      400     on error undo, return error return-value
      401     :
      402       run clntattr-get-archive-by-type in this-procedure
      403         (input  'arh':U
      404         ,output v-copy-arh-list
      405         ) .
      406       run clntattr-get-archive-by-type in this-procedure
      407         (input  'ahsp':U
      408         ,output v-copy-ahsp-list
      409         ) .
      410       run clntattr-get-archive-by-type in this-procedure
      411         (input  'aht':U
      412         ,output v-copy-aht-list
      413         ) .
      414       assign
      415         v-copy-list = ""
      416       .
      417       if p-copy-arh = true
      418       then do:
      419         assign
      420           v-copy-list = v-copy-list
      421                       + (if v-copy-list <> '':u then ',':u else '':u)
      422                       + v-copy-arh-list
      423         .
      424       end.
      425       if p-copy-ahsp = true
      426       then do:
      427         assign
      428           v-copy-list = v-copy-list
      429                       + (if v-copy-list <> '':u then ',':u else '':u)
      430                       + v-copy-ahsp-list
      431         .
      432       end.
      433       if p-copy-aht = true
      434       then do:
      435         assign
      436           v-copy-list = v-copy-list
      437                       + (if v-copy-list <> '':u then ',':u else '':u)
      438                       + v-copy-aht-list
      439         .
      440       end.
      441       for each ub.clients-attr
      442         where ub.clients-attr.obj-type = p-obj-type
      443           and ub.clients-attr.obj-code = p-obj-code
      444       on error undo, return error return-value
      445       :
      446         if lookup(ub.clients-attr.attr-code, v-copy-list) > 0
      447         then do:
      448           create dst.clients-attr .
      449           buffer-copy ub.clients-attr to dst.clients-attr .
      450         end.
      451       end.
      452     end.
      453   end procedure.
