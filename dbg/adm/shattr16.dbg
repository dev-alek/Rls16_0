     1107   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   on help of frame Dialog-Frame
     1109   do:
     1110     run gbl/app_help.p
     1111       (input this-procedure :file-name
     1112       ,input ''
     1113       ,input ?
     1114       ) no-error.
     1115     if error-status :error then do:
     1116       message
     1117         "Ошибка при вызове помощи"
     1118         error-status :get-message(1)
     1119         view-as alert-box .
     1120     end.
     1121   end.
     1122   run minbtn-set in this-procedure .
     1123   on choose of b-help in frame Dialog-Frame
     1124   do:
     1125     apply "help":u to frame Dialog-Frame .
     1126   end.
     1127   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   procedure minbtn-set :
     1129       do
     1130           on error undo, return error return-value
     1131           :
     1132           define variable ii              as integer       no-undo .
     1133           define variable fh              as widget-handle no-undo .
     1134           define variable hh              as widget-handle no-undo .
     1135           define variable v-h             as handle        extent 4 no-undo .
     1136           define variable v-name-button   as character     no-undo .
     1137           define variable v-help-old-x    as decimal       no-undo .
     1138           define variable v-help-old-y    as decimal       no-undo .
     1139           define variable v-help-old-size as decimal       no-undo .
     1140           define variable v-frame-width   as decimal       no-undo .
     1141           define variable jj              as integer       no-undo .
     1142           do
     1143               on error undo, return error
     1144               :
     1145               assign
     1146                   v-frame-width = frame Dialog-Frame:width - 0.3
     1147                   fh            = frame Dialog-Frame:first-child
     1148                   hh            = fh:first-child
     1149                   ii            = 1
     1150                   .
     1151               do while valid-handle(hh):
     1152                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1153                   do:
     1154                       case lc(hh:name) :
     1155                           when "b-help" then
     1156                               do:
     1157                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1158                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1159                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1160                                   hh:TOOLTIP = "Помощь" .
     1161                                   v-help-old-x = hh:column .
     1162                                   v-help-old-y = hh:row    .
     1163                                   v-help-old-size = hh:width .
     1164                                   hh:width-chars = 2.5 .
     1165                               end.
     1166                           when "b-print" then
     1167                               do:
     1168                                   hh:load-image("cmp/b-print.bmp":u) .
     1169                                   hh:TOOLTIP = "Печать" .
     1170                                   v-h[ii] = hh:handle .
     1171                                   ii = ii + 1 .
     1172                                   hh:width-chars = 3 .
     1173                               end.
     1174                           when "b-history" or
     1175                           when "b-hist" then
     1176                               do:
     1177                                   hh:load-image("cmp/b-hist.bmp":u) .
     1178                                   hh:TOOLTIP = "История" .
     1179                                   v-h[ii] = hh:handle .
     1180                                   ii = ii + 1 .
     1181                                   hh:width-chars = 3 .
     1182                               end.
     1183                           when "b-sch" then
     1184                               do:
     1185                                   hh:load-image("cmp/b-sch.bmp":u) .
     1186                                   hh:TOOLTIP = "Установка Фильтра" .
     1187                                   v-h[ii] = hh:handle .
     1188                                   ii = ii + 1 .
     1189                                   hh:width-chars = 3 .
     1190                               end.
     1191                           when "b-hist-user" then
     1192                               do:
     1193                                   hh:load-image("cmp/b-hist.bmp":u) .
     1194                                   hh:TOOLTIP = "История пользователя" .
     1195                                   ii = ii + 1 .
     1196                               end.
     1197                       end case.
     1198                   end.
     1199                   hh = hh:next-sibling.
     1200               end.
     1201               b-help:column = v-frame-width - b-help:width-chars.
     1202               jj = 0.
     1203               repeat ii = 4 to 1 by -1 :
     1204                   if valid-handle (v-h[ii] ) then
     1205                   do:
     1206                       jj  = jj + 1 .
     1207                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1208                       v-h[ii]:row    = v-help-old-y .
     1209                   end.
     1210               end.
     1211           end.
     1212       end.
     1213   end procedure.
     1214   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1215   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1216   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1217   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1218   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1219   define variable v-diasize-current-frame-height as decimal   no-undo .
     1220   define variable v-diasize-change-size          as logical   no-undo .
     1221   define variable v-diasize-resize-button        as handle    no-undo .
     1222   define variable v-diasize-wndmax               as logical   no-undo .
     1223   define variable v-diasize-wndstore             as logical   no-undo .
     1224   define variable v-diasize-proc-name            as character no-undo .
     1225   define variable v-diasize-browse-handle        as handle    no-undo .
     1226   define variable v-diasize-browse-number        as integer   no-undo .
     1227   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1228   define temp-table temp-diasize-handle no-undo
     1229     field handle-value  as handle
     1230     field save-position as decimal
     1231     index xpk is primary unique handle-value
     1232     .
     1233   define temp-table temp-browse-handle no-undo
     1234     field browse-type   as character
     1235     field browse-number as integer
     1236     field browse-handle as handle
     1237     field original-size as decimal
     1238     index xpk is primary unique browse-type browse-number
     1239     index xie browse-type browse-handle
     1240   .
     1241   procedure diasize_change-height :
     1242     define input  parameter p-change-value  as decimal   no-undo .
     1243     define input  parameter p-move-resize   as logical   no-undo .
     1244     define variable v-field-group-handle    as handle    no-undo .
     1245     define variable v-object-handle         as handle    no-undo .
     1246     define variable v-frame-height          as decimal   no-undo .
     1247     define variable v-frame-virtual-height  as decimal   no-undo .
     1248     define variable v-browse-height         as decimal   no-undo .
     1249     define variable v-window-height         as decimal   no-undo .
     1250     define variable v-window-virtual-height as decimal   no-undo .
     1251     define variable v-change-sign           as integer   no-undo .
     1252     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1253     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1254     if p-change-value > 0
     1255     then do:
     1256       if frame Dialog-Frame :height + p-change-value
     1257           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1258       then do:
     1259         assign
     1260           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1261                           - (frame Dialog-Frame :height-chars)
     1262         .
     1263         if p-change-value <= 0
     1264         then do:
     1265           run diasize_position-resize-button in this-procedure .
     1266           return .
     1267         end.
     1268       end.
     1269     end.
     1270     if p-change-value < 0
     1271     then do:
     1272       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1273       then do:
     1274         assign
     1275           p-change-value = v-diasize-orig-frame-height
     1276                          - (frame Dialog-Frame :height-chars)
     1277         .
     1278         if p-change-value >= 0
     1279         then do:
     1280           run diasize_position-resize-button in this-procedure .
     1281           return .
     1282         end.
     1283       end.
     1284     end.
     1285     if p-change-value >= 0
     1286     then do:
     1287       assign
     1288         v-change-sign = 1
     1289       .
     1290     end.
     1291     else do:
     1292       assign
     1293         v-change-sign = -1
     1294       .
     1295     end.
     1296     assign
     1297       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1298     .
     1299     if p-change-value = 0
     1300     then do:
     1301       run diasize_position-resize-button in this-procedure .
     1302       return .
     1303     end.
     1304     move_block:
     1305     do
     1306     on error undo move_block, retry move_block
     1307     :
     1308       if retry
     1309       then do:
     1310         do
     1311         on error undo move_block, leave move_block
     1312         :
     1313           if p-change-value > 0
     1314           then do:
     1315             for each buf_temp-diasize-handle
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 v-object-handle = buf_temp-diasize-handle.handle-value
     1320               .
     1321               if v-object-handle <> v-diasize-resize-button
     1322               then do:
     1323                 assign
     1324                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1325                 .
     1326               end.
     1327             end.
     1328             assign
     1329               v-diasize-browse-handle :height = v-browse-height
     1330             .
     1331             for each buf_temp-browse-handle
     1332               where buf_temp-browse-handle.browse-type = 'height':u
     1333             on error undo, next
     1334             :
     1335               assign
     1336                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1337               .
     1338             end.
     1339             assign
     1340               frame Dialog-Frame :height = v-frame-height
     1341             .
     1342             if frame Dialog-Frame :scrollable = true
     1343             then do:
     1344               assign
     1345                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1346               .
     1347             end.
     1348             run diasize_position-resize-button in this-procedure .
     1349           end.
     1350           else do:
     1351             if frame Dialog-Frame :scrollable = true
     1352             then do:
     1353               assign
     1354                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1355               .
     1356             end.
     1357             assign
     1358               frame Dialog-Frame :height = v-frame-height
     1359             .
     1360             assign
     1361               v-diasize-browse-handle :height = v-browse-height
     1362             .
     1363             for each buf_temp-browse-handle
     1364               where buf_temp-browse-handle.browse-type = 'height':u
     1365             on error undo, next
     1366             :
     1367               assign
     1368                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1369               .
     1370             end.
     1371             for each buf_temp-diasize-handle
     1372             on error undo, next
     1373             :
     1374               assign
     1375                 v-object-handle = buf_temp-diasize-handle.handle-value
     1376               .
     1377               if v-object-handle <> v-diasize-resize-button
     1378               then do:
     1379                 assign
     1380                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1381                 .
     1382               end.
     1383             end.
     1384             run diasize_position-resize-button in this-procedure .
     1385           end.
     1386           assign
     1387             v-diasize-change-size = false
     1388           .
     1389           leave move_block .
     1390         end.
     1391       end.
     1392       assign
     1393         v-diasize-need-full-display = true
     1394       .
     1395       if v-diasize-change-size = false
     1396       then do:
     1397         assign
     1398           v-diasize-change-size = true
     1399         .
     1400       end.
     1401       else do:
     1402         return .
     1403       end.
     1404       assign
     1405         v-frame-height = frame Dialog-Frame :height
     1406         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1407         v-browse-height = v-diasize-browse-handle :height
     1408       .
     1409       for each buf_temp-browse-handle
     1410         where buf_temp-browse-handle.browse-type = 'height':u
     1411       :
     1412         assign
     1413           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1414         .
     1415       end.
     1416       for each buf_temp-diasize-handle
     1417       :
     1418         delete buf_temp-diasize-handle .
     1419       end.
     1420       assign
     1421         v-field-group-handle = frame Dialog-Frame :first-child
     1422       .
     1423       do while valid-handle(v-field-group-handle)
     1424       :
     1425         assign
     1426           v-object-handle = v-field-group-handle :first-child
     1427         .
     1428         do while valid-handle(v-object-handle)
     1429         :
     1430           if  v-object-handle <> v-diasize-browse-handle :handle
     1431           and can-query(v-object-handle, "row")
     1432           and can-query(v-object-handle, "height")
     1433           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1434           then do:
     1435             find first buf_temp-browse-handle
     1436               where buf_temp-browse-handle.browse-type   = 'height':u
     1437                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1438               no-error .
     1439             if available buf_temp-browse-handle
     1440             then do:
     1441             end.
     1442             else do:
     1443               create buf_temp-diasize-handle .
     1444               assign
     1445                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1446                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1447               .
     1448             end.
     1449           end.
     1450           assign
     1451             v-object-handle = v-object-handle :next-sibling
     1452           .
     1453         end.
     1454         assign
     1455           v-field-group-handle = v-field-group-handle :next-sibling
     1456         .
     1457       end.
     1458       do with frame Dialog-Frame
     1459       :
     1460         hide v-diasize-resize-button .
     1461         assign
     1462           v-diasize-resize-button :row    = 1
     1463           v-diasize-resize-button :column = 1
     1464         .
     1465       end.
     1466       if p-change-value > 0
     1467       then do:
     1468         if frame Dialog-Frame :scrollable = true
     1469         then do:
     1470           assign
     1471             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1472             no-error .
     1473           if error-status :error
     1474           or error-status :get-message(1) <> ""
     1475           then do:
     1476             undo move_block, retry move_block .
     1477           end.
     1478         end.
     1479         assign
     1480           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1481           no-error .
     1482         if error-status :error
     1483         or error-status :get-message(1) <> ""
     1484         then do:
     1485           undo move_block, retry move_block .
     1486         end.
     1487         assign
     1488           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1489           no-error .
     1490         if error-status :error
     1491         or error-status :get-message(1) <> ""
     1492         then do:
     1493           undo move_block, retry move_block .
     1494         end.
     1495         for each buf_temp-browse-handle
     1496           where buf_temp-browse-handle.browse-type = 'height':u
     1497         on error undo move_block, retry move_block
     1498         :
     1499           assign
     1500             buf_temp-browse-handle.browse-handle :height
     1501               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1502             no-error .
     1503           if error-status :error
     1504           or error-status :get-message(1) <> ""
     1505           then do:
     1506             undo move_block, retry move_block .
     1507           end.
     1508         end.
     1509         for each buf_temp-diasize-handle
     1510         on error undo move_block, retry move_block
     1511         :
     1512           assign
     1513             v-object-handle = buf_temp-diasize-handle.handle-value
     1514           .
     1515           if v-object-handle <> v-diasize-resize-button
     1516           then do:
     1517             assign
     1518               v-object-handle :row = v-object-handle :row + p-change-value
     1519               no-error .
     1520             if error-status :error
     1521             or error-status :get-message(1) <> ""
     1522             then do:
     1523               undo move_block, retry move_block .
     1524             end.
     1525           end.
     1526         end.
     1527       end.
     1528       else do:
     1529         for each buf_temp-diasize-handle
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             v-object-handle = buf_temp-diasize-handle.handle-value
     1534           .
     1535           if v-object-handle <> v-diasize-resize-button
     1536           then do:
     1537             assign
     1538               v-object-handle :row = v-object-handle :row + p-change-value
     1539               no-error .
     1540             if error-status :error
     1541             or error-status :get-message(1) <> ""
     1542             then do:
     1543               undo move_block, retry move_block .
     1544             end.
     1545           end.
     1546         end.
     1547         assign
     1548           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1549           no-error .
     1550         if error-status :error
     1551         or error-status :get-message(1) <> ""
     1552         then do:
     1553           undo move_block, retry move_block .
     1554         end.
     1555         for each buf_temp-browse-handle
     1556           where buf_temp-browse-handle.browse-type = 'height':u
     1557         on error undo move_block, retry move_block
     1558         :
     1559           assign
     1560             buf_temp-browse-handle.browse-handle :height
     1561               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1562             no-error .
     1563           if error-status :error
     1564           or error-status :get-message(1) <> ""
     1565           then do:
     1566             undo move_block, retry move_block .
     1567           end.
     1568         end.
     1569         assign
     1570           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1571           no-error .
     1572         if error-status :error
     1573         or error-status :get-message(1) <> ""
     1574         then do:
     1575           undo move_block, retry move_block .
     1576         end.
     1577         if frame Dialog-Frame :scrollable = true
     1578         then do:
     1579           assign
     1580             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1581             no-error .
     1582           if error-status :error
     1583           or error-status :get-message(1) <> ""
     1584           then do:
     1585             undo move_block, retry move_block .
     1586           end.
     1587         end.
     1588       end.
     1589       if p-move-resize = true
     1590       then do:
     1591         run diasize_position-resize-button in this-procedure .
     1592       end.
     1593       if v-diasize-wndstore = true
     1594       then do:
     1595         if connected("ub") = true
     1596         then do:
     1597           define variable v-cntxt-db-num        as integer   no-undo .
     1598           define variable v-cntxt-userid        as character no-undo .
     1599           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1600                                             , OUTPUT v-cntxt-userid
     1601                                             ) .
     1602           run gbl/wndsizew.p
     1603             (input  v-cntxt-db-num
     1604             ,input  v-cntxt-userid
     1605             ,input  v-diasize-proc-name
     1606             ,input  'height':u
     1607             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1608             ) .
     1609         end.
     1610       end.
     1611     end.
     1612     assign
     1613       v-diasize-change-size = false
     1614     .
     1615   end procedure.
     1616   procedure diasize_set-height :
     1617     define input  parameter p-new-height  as decimal   no-undo .
     1618     define input  parameter p-move-resize as logical   no-undo .
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       run diasize_change-height in this-procedure
     1623         (input  (p-new-height - frame Dialog-Frame :height)
     1624         ,input  p-move-resize
     1625         ) .
     1626     end.
     1627   end procedure.
     1628   procedure diasize_change-width :
     1629     define input  parameter p-change-value as decimal   no-undo .
     1630     define input  parameter p-move-resize  as logical   no-undo .
     1631     define variable v-field-group-handle   as handle    no-undo .
     1632     define variable v-object-handle        as handle    no-undo .
     1633     define variable v-frame-width          as decimal   no-undo .
     1634     define variable v-frame-virtual-width  as decimal   no-undo .
     1635     define variable v-browse-width         as decimal   no-undo .
     1636     define variable v-window-width         as decimal   no-undo .
     1637     define variable v-window-virtual-width as decimal   no-undo .
     1638     define variable v-change-sign          as integer   no-undo .
     1639     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1640     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1641     if p-change-value > 0
     1642     then do:
     1643       if frame Dialog-Frame :width + p-change-value >
     1644           session :width-chars
     1645       then do:
     1646         assign
     1647           p-change-value = session :width-chars - frame Dialog-Frame :width
     1648         .
     1649         if p-change-value <= 0
     1650         then do:
     1651           run diasize_position-resize-button in this-procedure .
     1652           return .
     1653         end.
     1654       end.
     1655     end.
     1656     if p-change-value < 0
     1657     then do:
     1658       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1659       then do:
     1660         assign
     1661           p-change-value = v-diasize-orig-frame-width
     1662                          - frame Dialog-Frame :width
     1663         .
     1664         if p-change-value >= 0
     1665         then do:
     1666           run diasize_position-resize-button in this-procedure .
     1667           return .
     1668         end.
     1669       end.
     1670     end.
     1671     if p-change-value >= 0
     1672     then do:
     1673       assign
     1674         v-change-sign = 1
     1675       .
     1676     end.
     1677     else do:
     1678       assign
     1679         v-change-sign = -1
     1680       .
     1681     end.
     1682     assign
     1683       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1684     .
     1685     if p-change-value = 0
     1686     then do:
     1687       run diasize_position-resize-button in this-procedure .
     1688       return .
     1689     end.
     1690     move_block:
     1691     do
     1692     on error undo move_block, leave move_block
     1693     :
     1694       if retry
     1695       then do:
     1696         do
     1697         on error undo move_block, leave move_block
     1698         :
     1699           if p-change-value > 0
     1700           then do:
     1701             for each buf_temp-diasize-handle
     1702             on error undo, next
     1703             :
     1704               assign
     1705                 v-object-handle = buf_temp-diasize-handle.handle-value
     1706               .
     1707               if v-object-handle <> v-diasize-resize-button
     1708               then do:
     1709                 assign
     1710                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1711                 .
     1712               end.
     1713             end.
     1714             assign
     1715               v-diasize-browse-handle :width = v-browse-width
     1716             .
     1717             for each buf_temp-browse-handle
     1718               where buf_temp-browse-handle.browse-type = 'width':u
     1719             on error undo, next
     1720             :
     1721               assign
     1722                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1723               .
     1724             end.
     1725             assign
     1726               frame Dialog-Frame :width = v-frame-width
     1727             .
     1728             if frame Dialog-Frame :scrollable = true
     1729             then do:
     1730               assign
     1731                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1732               .
     1733             end.
     1734             run diasize_position-resize-button in this-procedure .
     1735           end.
     1736           else do:
     1737             if frame Dialog-Frame :scrollable = true
     1738             then do:
     1739               assign
     1740                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1741               .
     1742             end.
     1743             assign
     1744               frame Dialog-Frame :width = v-frame-width
     1745             .
     1746             for each buf_temp-browse-handle
     1747               where buf_temp-browse-handle.browse-type = 'width':u
     1748             on error undo, next
     1749             :
     1750               assign
     1751                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1752               .
     1753             end.
     1754             assign
     1755               v-diasize-browse-handle :width = v-browse-width
     1756             .
     1757             for each buf_temp-diasize-handle
     1758             on error undo, next
     1759             :
     1760               assign
     1761                 v-object-handle = buf_temp-diasize-handle.handle-value
     1762               .
     1763               if v-object-handle <> v-diasize-resize-button
     1764               then do:
     1765                 assign
     1766                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1767                 .
     1768               end.
     1769             end.
     1770             run diasize_position-resize-button in this-procedure .
     1771           end.
     1772           assign
     1773             v-diasize-change-size = false
     1774           .
     1775           leave move_block .
     1776         end.
     1777       end.
     1778       assign
     1779         v-diasize-need-full-display = true
     1780       .
     1781       if v-diasize-change-size = false
     1782       then do:
     1783         assign
     1784           v-diasize-change-size = true
     1785         .
     1786       end.
     1787       else do:
     1788         return .
     1789       end.
     1790       assign
     1791         v-frame-width = frame Dialog-Frame :width
     1792         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1793         v-browse-width = v-diasize-browse-handle :width
     1794       .
     1795       for each buf_temp-browse-handle
     1796         where buf_temp-browse-handle.browse-type = 'width':u
     1797       :
     1798         assign
     1799           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1800         .
     1801       end.
     1802       for each buf_temp-diasize-handle
     1803       :
     1804         delete buf_temp-diasize-handle .
     1805       end.
     1806       assign
     1807         v-field-group-handle = frame Dialog-Frame :first-child
     1808       .
     1809       do while valid-handle(v-field-group-handle)
     1810       :
     1811         assign
     1812           v-object-handle = v-field-group-handle :first-child
     1813         .
     1814         do while valid-handle(v-object-handle)
     1815         :
     1816           if  v-object-handle <> v-diasize-browse-handle :handle
     1817           and v-object-handle <> v-diasize-resize-button
     1818           and can-query(v-object-handle, "row")
     1819           and can-query(v-object-handle, "height")
     1820           and ( v-object-handle :col + v-object-handle :width
     1821                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1822               )
     1823           then do:
     1824             find first buf_temp-browse-handle
     1825               where buf_temp-browse-handle.browse-type   = 'width':u
     1826                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1827               no-error .
     1828             if available buf_temp-browse-handle
     1829             then do:
     1830             end.
     1831             else do:
     1832               create buf_temp-diasize-handle .
     1833               assign
     1834                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1835                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1836               .
     1837             end.
     1838           end.
     1839           assign
     1840             v-object-handle = v-object-handle :next-sibling
     1841           .
     1842         end.
     1843         assign
     1844           v-field-group-handle = v-field-group-handle :next-sibling
     1845         .
     1846       end.
     1847       do with frame Dialog-Frame
     1848       :
     1849         hide v-diasize-resize-button .
     1850         v-diasize-resize-button :row = 1.
     1851         v-diasize-resize-button :column = 1.
     1852       end.
     1853       if p-change-value > 0
     1854       then do:
     1855         if frame Dialog-Frame :scrollable = true
     1856         then do:
     1857           assign
     1858             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1859             no-error .
     1860           if error-status :error
     1861           or error-status :get-message(1) <> ""
     1862           then do:
     1863             undo move_block, retry move_block.
     1864           end.
     1865         end.
     1866         assign
     1867           frame Dialog-Frame :width = v-frame-width + p-change-value
     1868           no-error .
     1869         if error-status :error
     1870         or error-status :get-message(1) <> ""
     1871         then do:
     1872           undo move_block, retry move_block.
     1873         end.
     1874         assign
     1875           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1876         no-error .
     1877         if error-status :error
     1878         or error-status :get-message(1) <> ""
     1879         then do:
     1880           undo move_block, retry move_block.
     1881         end.
     1882         for each buf_temp-browse-handle
     1883           where buf_temp-browse-handle.browse-type = 'width':u
     1884         on error undo move_block, retry move_block
     1885         :
     1886           assign
     1887             buf_temp-browse-handle.browse-handle :width
     1888               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1889             no-error .
     1890           if error-status :error
     1891           or error-status :get-message(1) <> ""
     1892           then do:
     1893             undo move_block, retry move_block .
     1894           end.
     1895         end.
     1896         for each buf_temp-diasize-handle
     1897         on error undo move_block, retry move_block
     1898         :
     1899           assign
     1900             v-object-handle = buf_temp-diasize-handle.handle-value
     1901           .
     1902           if v-object-handle <> v-diasize-resize-button
     1903           then do:
     1904             assign
     1905               v-object-handle :col = v-object-handle :col + p-change-value
     1906               no-error .
     1907             if error-status :error
     1908             or error-status :get-message(1) <> ""
     1909             then do:
     1910               undo move_block, retry move_block .
     1911             end.
     1912           end.
     1913         end.
     1914       end.
     1915       else do:
     1916         for each buf_temp-diasize-handle
     1917         on error undo move_block, retry move_block
     1918         :
     1919           assign
     1920             v-object-handle = buf_temp-diasize-handle.handle-value
     1921           .
     1922           if v-object-handle <> v-diasize-resize-button
     1923           then do:
     1924             assign
     1925               v-object-handle :col = v-object-handle :col + p-change-value
     1926               no-error .
     1927             if error-status :error
     1928             or error-status :get-message(1) <> ""
     1929             then do:
     1930               undo move_block, retry move_block .
     1931             end.
     1932           end.
     1933         end.
     1934         for each buf_temp-browse-handle
     1935           where buf_temp-browse-handle.browse-type = 'width':u
     1936         on error undo move_block, retry move_block
     1937         :
     1938           assign
     1939             buf_temp-browse-handle.browse-handle :width
     1940               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block .
     1946           end.
     1947         end.
     1948         assign
     1949           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1950           no-error .
     1951         if error-status :error
     1952         or error-status :get-message(1) <> ""
     1953         then do:
     1954           undo move_block, retry move_block.
     1955         end.
     1956         assign
     1957           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1958         no-error .
     1959         if error-status :error
     1960         or error-status :get-message(1) <> ""
     1961         then do:
     1962           undo move_block, retry move_block.
     1963         end.
     1964         if frame Dialog-Frame :scrollable = true
     1965         then do:
     1966           assign
     1967             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1968           no-error .
     1969           if error-status :error
     1970           or error-status :get-message(1) <> ""
     1971           then do:
     1972             undo move_block, retry move_block.
     1973           end.
     1974         end.
     1975       end.
     1976       if p-move-resize
     1977       then do:
     1978         run diasize_position-resize-button in this-procedure .
     1979       end.
     1980       if v-diasize-wndstore = true
     1981       then do:
     1982         if connected("ub") = true
     1983         then do:
     1984           define variable v-cntxt-db-num        as integer   no-undo .
     1985           define variable v-cntxt-userid        as character no-undo .
     1986           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1987                                             , OUTPUT v-cntxt-userid
     1988                                             ) .
     1989           run gbl/wndsizew.p
     1990             (input  v-cntxt-db-num
     1991             ,input  v-cntxt-userid
     1992             ,input  v-diasize-proc-name
     1993             ,input  'width':u
     1994             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1995             ) .
     1996         end.
     1997       end.
     1998     end.
     1999     assign
     2000       v-diasize-change-size = false
     2001     .
     2002   end procedure.
     2003   procedure diasize_set-width :
     2004     define input  parameter p-new-width  as decimal   no-undo .
     2005     define input  parameter p-move-resize as logical   no-undo .
     2006     do
     2007     on error undo, return error return-value
     2008     :
     2009       run diasize_change-width in this-procedure
     2010         (input  (p-new-width - frame Dialog-Frame :width)
     2011         ,input  p-move-resize
     2012         ) .
     2013     end.
     2014   end procedure.
     2015   procedure diasize_position-resize-button :
     2016     do with frame Dialog-Frame
     2017     :
     2018       hide v-diasize-resize-button .
     2019       assign
     2020         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2021                     - 1
     2022                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2023         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2024                     - 1
     2025                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2026       .
     2027       view v-diasize-resize-button .
     2028     end.
     2029   end procedure.
     2030   on alt-right anywhere
     2031   do:
     2032     run diasize_change-width in this-procedure
     2033       (input 1
     2034       ,input true
     2035       ) .
     2036     return no-apply .
     2037   end.
     2038   on alt-left anywhere
     2039   do:
     2040     run diasize_change-width in this-procedure
     2041       (input -1
     2042       ,input true
     2043       ) .
     2044     return no-apply .
     2045   end.
     2046   on alt-down anywhere
     2047   do:
     2048     run diasize_change-height in this-procedure
     2049       (input 1
     2050       ,input true
     2051       ) .
     2052     return no-apply .
     2053   end.
     2054   on alt-up anywhere
     2055   do:
     2056     run diasize_change-height in this-procedure
     2057       (input -1
     2058       ,input true
     2059       ) .
     2060     return no-apply .
     2061   end.
     2062   on alt-enter of frame Dialog-Frame
     2063   do:
     2064     run diasize_maximize in this-procedure
     2065       (input  ?
     2066       ).
     2067     return no-apply .
     2068   end.
     2069   procedure diasize_end-move :
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       define variable v-row-delta as decimal   no-undo .
     2074       define variable v-col-delta as decimal   no-undo .
     2075       define variable v-new-row as decimal   no-undo .
     2076       define variable v-new-col as decimal   no-undo .
     2077       assign
     2078         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2079         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2080       .
     2081       assign
     2082         v-row-delta = v-new-row - frame Dialog-Frame :height
     2083         v-col-delta = v-new-col - frame Dialog-Frame :width
     2084       .
     2085       run diasize_change-height in this-procedure
     2086         (input v-row-delta
     2087         ,input true
     2088         ) .
     2089       run diasize_change-width in this-procedure
     2090         (input v-col-delta
     2091         ,input true
     2092         ) .
     2093     end.
     2094   end procedure.
     2095   procedure diasize_maximize :
     2096     define input  parameter p-action as logical   no-undo .
     2097     do
     2098     on error undo, return error return-value
     2099     :
     2100       if p-action = ?
     2101       then do:
     2102         if v-diasize-need-maximize = true
     2103         then do:
     2104           assign
     2105             p-action = true
     2106           .
     2107         end.
     2108         else do:
     2109           assign
     2110             p-action = false
     2111           .
     2112         end.
     2113       end.
     2114       if p-action = true
     2115       then do:
     2116         run diasize_change-height in this-procedure
     2117           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2118               - frame Dialog-Frame :height-chars
     2119           ,input true
     2120           ) .
     2121         run diasize_change-width in this-procedure
     2122           (input session :width-chars
     2123               - frame Dialog-Frame :width-chars
     2124           ,input true
     2125           ) .
     2126         assign
     2127           v-diasize-need-maximize = false
     2128         .
     2129       end.
     2130       else do:
     2131         run diasize_change-width in this-procedure
     2132           (input v-diasize-orig-frame-width
     2133               - frame Dialog-Frame :width-chars
     2134           ,input true
     2135           ) .
     2136         run diasize_change-height in this-procedure
     2137           (input v-diasize-orig-frame-height
     2138               - frame Dialog-Frame :height-chars
     2139           ,input true
     2140           ) .
     2141         assign
     2142           v-diasize-need-maximize = true
     2143         .
     2144       end.
     2145     end.
     2146   end procedure.
     2147   procedure diasize_restore-orig-size :
     2148     do
     2149     on error undo, return error return-value
     2150     :
     2151       assign
     2152         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2153         v-diasize-current-frame-height = frame Dialog-Frame :height
     2154       .
     2155       run diasize_set-height in this-procedure
     2156         (input  v-diasize-orig-frame-height
     2157         ,input  true
     2158         ) .
     2159       run diasize_set-width in this-procedure
     2160         (input  v-diasize-orig-frame-width
     2161         ,input  true
     2162         ) .
     2163     end.
     2164   end procedure.
     2165   procedure diasize_restore-current-size :
     2166     do
     2167     on error undo, return error return-value
     2168     :
     2169       run diasize_set-height in this-procedure
     2170         (input  v-diasize-current-frame-height
     2171         ,input  true
     2172         ) .
     2173       run diasize_set-width in this-procedure
     2174         (input  v-diasize-current-frame-width
     2175         ,input  true
     2176         ) .
     2177     end.
     2178   end procedure.
     2179   procedure diasize_set-browse-handle :
     2180     define input  parameter p-browse-handle as handle   no-undo .
     2181     define buffer buf_temp-browse-handle for temp-browse-handle .
     2182     do
     2183     on error undo, return error return-value
     2184     :
     2185       assign
     2186         v-diasize-browse-handle = p-browse-handle
     2187       .
     2188       for each buf_temp-browse-handle
     2189       on error undo, return error return-value
     2190       :
     2191         delete buf_temp-browse-handle .
     2192       end.
     2193     end.
     2194   end procedure.
     2195   procedure diasize_add_browse :
     2196     define input  parameter p-browse-type   as character no-undo .
     2197     define input  parameter p-browse-handle as handle    no-undo .
     2198     define buffer buf_temp-browse-handle for temp-browse-handle .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       assign
     2203         v-diasize-browse-number = v-diasize-browse-number + 1
     2204       .
     2205       create buf_temp-browse-handle .
     2206       assign
     2207         buf_temp-browse-handle.browse-type   = p-browse-type
     2208         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2209         buf_temp-browse-handle.browse-handle = p-browse-handle
     2210       .
     2211     end.
     2212   end procedure.
     2213   procedure diasize_init :
     2214     define variable v-default-value    as logical   no-undo .
     2215     define variable v-restore-saved    as logical   no-undo .
     2216     define variable v-resize-value-str as character no-undo .
     2217     do
     2218     on error undo, return error return-value
     2219     :
     2220       do with frame Dialog-Frame
     2221       :
     2222         assign
     2223           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2224           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2225           v-diasize-browse-handle     = browse BR-cash-pay :handle
     2226         .
     2227         create button v-diasize-resize-button
     2228         assign
     2229           parent        = frame Dialog-Frame :first-child
     2230           label         = "s"
     2231           height-pixels = 16
     2232           width-pixels  = 16
     2233           visible       = true
     2234           sensitive     = true
     2235           movable       = true
     2236           triggers:
     2237             on end-move persistent run diasize_end-move in this-procedure .
     2238           end triggers.
     2239         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2240         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2241         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2242         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2243         assign
     2244           v-diasize-wndmax = false
     2245         .
     2246         if connected("ub") = true
     2247         then do:
     2248           define variable v-cntxt-db-num        as integer   no-undo .
     2249           define variable v-cntxt-userid        as character no-undo .
     2250           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2251                                             , OUTPUT v-cntxt-userid
     2252                                             ) .
     2253           run gbl/wndpar_r.p
     2254             (input  v-cntxt-db-num
     2255             ,input  v-cntxt-userid
     2256             ,input  'wndmax':U
     2257             ,output v-diasize-wndmax
     2258             ,output v-default-value
     2259             ) .
     2260         end.
     2261         assign
     2262           v-diasize-wndstore = false
     2263         .
     2264         if connected("ub") = true
     2265         then do:
     2266           run gbl/wndpar_r.p
     2267             (input  v-cntxt-db-num
     2268             ,input  v-cntxt-userid
     2269             ,input  'wndstore':U
     2270             ,output v-diasize-wndstore
     2271             ,output v-default-value
     2272             ) .
     2273         end.
     2274         assign
     2275           v-diasize-proc-name = entry(1, program-name(2), '.')
     2276         .
     2277         if v-diasize-wndstore = true
     2278         then do:
     2279           assign
     2280             v-restore-saved = false
     2281           .
     2282           if connected("ub") = true
     2283           then do:
     2284             run gbl/wndsizer.p
     2285               (input  v-cntxt-db-num
     2286               ,input  v-cntxt-userid
     2287               ,input  v-diasize-proc-name
     2288               ,input  'height':u
     2289               ,output v-resize-value-str
     2290               ) .
     2291             if v-resize-value-str <> '':U
     2292             then do:
     2293               run diasize_change-height in this-procedure
     2294                 (input  integer(v-resize-value-str)
     2295                 ,input  true
     2296                 ) .
     2297               assign
     2298                 v-restore-saved = true
     2299               .
     2300             end.
     2301           end.
     2302           if connected("ub") = true
     2303           then do:
     2304             run gbl/wndsizer.p
     2305               (input  v-cntxt-db-num
     2306               ,input  v-cntxt-userid
     2307               ,input  v-diasize-proc-name
     2308               ,input  'width':u
     2309               ,output v-resize-value-str
     2310               ) .
     2311             if v-resize-value-str <> '':U
     2312             then do:
     2313               run diasize_change-width in this-procedure
     2314                 (input  integer(v-resize-value-str)
     2315                 ,input  true
     2316                 ) .
     2317               assign
     2318                 v-restore-saved = true
     2319               .
     2320             end.
     2321           end.
     2322           if v-restore-saved <> true
     2323           then do:
     2324             if v-diasize-wndmax = true
     2325             then do:
     2326               run diasize_maximize in this-procedure
     2327                 (input  true
     2328                 ) .
     2329             end.
     2330           end.
     2331         end.
     2332         else do:
     2333           if v-diasize-wndmax = true
     2334           then do:
     2335             run diasize_maximize in this-procedure
     2336               (input  true
     2337               ) .
     2338           end.
     2339         end.
     2340       end.
     2341     end.
     2342   end procedure.
     2343   procedure diasize_need-full-display :
     2344     define output parameter p-need-full-display as logical   no-undo .
     2345     do
     2346     on error undo, return error return-value
     2347     :
     2348       assign
     2349         p-need-full-display = v-diasize-need-full-display
     2350       .
     2351       assign
     2352         v-diasize-need-full-display = false
     2353       .
     2354     end.
     2355   end procedure.
     2356   procedure get-context :
     2357      define output parameter p-db-num as integer          no-undo.
     2358      define output parameter p-user-id as character        no-undo.
     2359      define variable v-login               as character    no-undo.
     2360      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2361      define buffer buf_user-login  for ub.user-login .
     2362      do
     2363      on error undo, return error
     2364      :
     2365            FIND FIRST buf_sys-ctrl no-lock.
     2366            ASSIGN
     2367               v-login = USERID("ub")
     2368               p-db-num = buf_sys-ctrl.db-num
     2369            .
     2370            FIND FIRST buf_user-login
     2371                 WHERE buf_user-login.db-num = p-db-num
     2372                   AND buf_user-login.user-login = v-login
     2373                 no-lock
     2374                 no-error
     2375                 .
     2376            IF AVAILABLE buf_user-login
     2377            THEN DO:
     2378               assign
     2379                  p-user-id = buf_user-login.user-id
     2380               .
     2381            END.
     2382      end.
     2383   end procedure.
     2384       run diasize_init in this-procedure .
     2385   MAIN-BLOCK:
     2386   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2387      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2388   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2389     run mainmenu_getcntxt in parparentproc
     2390       (output v-cntxt-db-num
     2391       ,output v-cntxt-userid
     2392       ,output v-cntxt-level
     2393       ,output v-cntxt-host-code-obj
     2394       ,output v-cntxt-obj-type
     2395       ,output v-cntxt-obj-code
     2396       ,output v-cntxt-db-num-obj
     2397       ,output v-cntxt-is-admin
     2398       ) .
     2399   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2400   ON TAB ANYWHERE
     2401   DO:
     2402   define variable ii as integer no-undo .
     2403   define variable fh as widget-handle no-undo .
     2404   define variable hh as widget-handle no-undo .
     2405   define variable v-next-widget-name as character no-undo .
     2406   if v-tab-order <> '' then do:
     2407     if self:type = "TOGGLE-BOX" then
     2408     self:BGCOLOR = ?.
     2409     assign
     2410     ii = lookup(self:name, v-tab-order).
     2411     assign
     2412     ii = ii + 1
     2413     v-next-widget-name = entry(ii, v-tab-order)
     2414     no-error .
     2415     if error-status:error then do:
     2416       assign
     2417       ii = 1
     2418       v-next-widget-name = entry( ii, v-tab-order)
     2419       .
     2420     end.
     2421     assign
     2422     fh = frame Dialog-Frame:first-child
     2423     hh = fh:first-child
     2424     .
     2425     do while valid-handle(hh):
     2426       if hh:name = v-next-widget-name then do:
     2427         if hh:sensitive  = yes
     2428         AND hh:visible = yes then do:
     2429           if hh:type = "TOGGLE-BOX":U then do:
     2430             assign
     2431             hh:BGcolor = 1
     2432             .
     2433           end.
     2434           APPLY "ENTRY" to hh.
     2435           return no-apply.
     2436         end.
     2437         else do:
     2438           APPLY "TAB" to hh.
     2439           return no-apply.
     2440         end.
     2441       end.
     2442       hh = hh:next-sibling.
     2443     end.
     2444   end.
     2445   END.
     2446   ON BACK-TAB ANYWHERE
     2447   DO:
     2448   define variable ii as integer no-undo .
     2449   define variable fh as widget-handle no-undo .
     2450   define variable hh as widget-handle no-undo .
     2451   define variable v-next-widget-name as character no-undo .
     2452   if v-tab-order <> '' then do:
     2453     assign
     2454     ii = lookup(self:name, v-tab-order).
     2455     .
     2456     assign
     2457     ii = (if ii = 1
     2458           then  num-entries(v-tab-order)
     2459           else ii - 1
     2460           )
     2461     v-next-widget-name = entry(ii, v-tab-order)
     2462     .
     2463     assign
     2464     fh = frame Dialog-Frame:first-child
     2465     hh = fh:first-child
     2466     .
     2467     do while valid-handle(hh):
     2468       if hh:name = v-next-widget-name then do:
     2469         if hh:sensitive  = yes
     2470         AND hh:visible = yes then do:
     2471           if hh:type = "TOGGLE-BOX":U then do:
     2472             assign
     2473             hh:BGcolor = 1
     2474             .
     2475           end.
     2476           APPLY "ENTRY" to hh.
     2477           return no-apply.
     2478         end.
     2479         else do:
     2480         APPLY "BACK-TAB" to hh.
     2481         return no-apply.
     2482         end.
     2483       end.
     2484       hh = hh:next-sibling.
     2485     end.
     2486     end.
     2487   END.
     2488   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489   ON RETURN ANYWHERE
     2490   DO:
     2491   define variable ii as integer no-undo .
     2492   define variable fh as widget-handle no-undo .
     2493   define variable hh as widget-handle no-undo .
     2494   define variable v-next-widget-name as character no-undo .
     2495     if v-tab-order <> '' then do:
     2496       assign
     2497       ii = lookup(self:name, v-tab-order).
     2498       if ii = num-entries(v-tab-order) then do:
     2499           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2500           return no-apply.
     2501       end.
     2502       if self:type <> "BUTTON" and
     2503         self:type <> "EDITOR"  then do:
     2504         run proc-move-forward in this-procedure .
     2505         return no-apply.
     2506       end.
     2507       if self:type = "BUTTON" then do:
     2508         APPLY "CHOOSE" to self.
     2509       end.
     2510       if self:type = "TOGGLE-BOX" then
     2511       self:BGCOLOR = ?.
     2512       assign
     2513       ii = ii + 1
     2514       v-next-widget-name = entry(ii, v-tab-order)
     2515       no-error .
     2516       if error-status:error then do:
     2517         assign
     2518         ii = 1
     2519         v-next-widget-name = entry( ii, v-tab-order)
     2520         .
     2521       end.
     2522       assign
     2523       fh = frame Dialog-Frame:first-child
     2524       hh = fh:first-child
     2525       .
     2526       do while valid-handle(hh):
     2527         if hh:name = v-next-widget-name then do:
     2528           if hh:sensitive  = yes
     2529           AND hh:visible = yes then do:
     2530             if hh:type = "TOGGLE-BOX":U then do:
     2531               assign
     2532               hh:BGcolor = 1
     2533               .
     2534             end.
     2535             APPLY "ENTRY" to hh.
     2536             return no-apply.
     2537           end.
     2538           else do:
     2539             APPLY "TAB" to hh.
     2540             return no-apply.
     2541           end.
     2542         end.
     2543         hh = hh:next-sibling.
     2544       end.
     2545     end.
     2546   END.
     2547   procedure proc-move-forward :
     2548   define variable ii as integer no-undo .
     2549   define variable fh as widget-handle no-undo .
     2550   define variable hh as widget-handle no-undo .
     2551   define variable v-next-widget-name as character no-undo .
     2552   do
     2553   on error undo, return error
     2554   :
     2555     if v-tab-order <> '' then do:
     2556       if self:type = "TOGGLE-BOX" then
     2557       self:BGCOLOR = ?.
     2558       assign
     2559       ii = lookup(self:name, v-tab-order).
     2560       assign
     2561       ii = ii + 1
     2562       v-next-widget-name = entry(ii, v-tab-order)
     2563       no-error .
     2564       if error-status:error then do:
     2565         assign
     2566         ii = 1
     2567         v-next-widget-name = entry( ii, v-tab-order)
     2568         .
     2569       end.
     2570       assign
     2571       fh = frame Dialog-Frame:first-child
     2572       hh = fh:first-child
     2573       .
     2574       do while valid-handle(hh):
     2575         if hh:name = v-next-widget-name then do:
     2576           if hh:sensitive  = yes
     2577           AND hh:visible = yes then do:
     2578             if hh:type = "TOGGLE-BOX":U then do:
     2579               assign
     2580               hh:BGcolor = 1
     2581               .
     2582             end.
     2583             APPLY "ENTRY" to hh.
     2584             return.
     2585           end.
     2586           else do:
     2587             assign
     2588             ii = ii + 1
     2589             v-next-widget-name = entry(ii, v-tab-order)
     2590             no-error .
     2591             if error-status:error then do:
     2592               assign
     2593               ii = 1
     2594               v-next-widget-name = entry( ii, v-tab-order)
     2595               .
     2596             end.
     2597           end.
     2598         end.
     2599         hh = hh:next-sibling.
     2600       end.
     2601     end.
     2602   end.
     2603   end procedure.
     2604     IF p-mode <> 'ПРОСМОТР':U
     2605     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2606         MESSAGE
     2607         vss-workfile vss-revision vss-description skip
     2608         "Неверное значение параметра p-mode" p-mode
     2609         VIEW-AS ALERT-BOX ERROR.
     2610         UNDO, RETURN ERROR.
     2611     END.
     2612     IF p-obj-type <> 'маг':U
     2613     and p-obj-type <> 'орг':U
     2614     and p-obj-type <> '':U
     2615     THEN DO:
     2616         MESSAGE
     2617         vss-workfile vss-revision vss-description skip
     2618         "Неверное значение параметра p-obj-type" p-obj-type
     2619         VIEW-AS ALERT-BOX ERROR.
     2620         UNDO, RETURN ERROR.
     2621     END.
     2622     if p-obj-type = 'маг':U then do:
     2623       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     2624       IF NOT AVAILABLE X_shop THEN DO:
     2625           MESSAGE
     2626           vss-workfile vss-revision vss-description skip
     2627           "Неверное значение параметра p-obj-code" p-obj-code
     2628           VIEW-AS ALERT-BOX ERROR.
     2629           UNDO, RETURN ERROR.
     2630       END.
     2631   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2633     (input  'маг':U
     2634     ,input  p-obj-code
     2635     ,output v-db-num
     2636     )  .
     2637       IF v-db-num <> v-cntxt-db-num
     2638       AND v-cntxt-db-num <> 0
     2639       and p-mode <> 'ПРОСМОТР':U
     2640       THEN DO:
     2641           MESSAGE
     2642           "Нельзя менять параметры магазина в чужой БД" skip
     2643           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     2644           VIEW-AS ALERT-BOX ERROR.
     2645           UNDO, RETURN ERROR.
     2646       END.
     2647   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2649     (input  p-obj-type
     2650     ,input  p-obj-code
     2651     ,output v-host-code
     2652     )  .
     2653     end.
     2654     if p-obj-type = 'орг':U then do:
     2655       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     2656       IF NOT AVAILABLE X_sysconf THEN DO:
     2657           MESSAGE
     2658           vss-workfile vss-revision vss-description skip
     2659           "Неверное значение параметра p-obj-code" p-obj-code
     2660           VIEW-AS ALERT-BOX ERROR.
     2661           UNDO, RETURN ERROR.
     2662       END.
     2663       if v-cntxt-db-num <> 0
     2664       and p-mode <> 'ПРОСМОТР':U
     2665       then do:
     2666           MESSAGE
     2667           "Нельзя менять параметры ФИРМЫ в УБД" skip
     2668           VIEW-AS ALERT-BOX ERROR.
     2669           UNDO, RETURN ERROR.
     2670       end.
     2671       v-host-code = p-obj-code.
     2672     end.
     2673     if p-obj-type = '':U then do:
     2674       if v-cntxt-db-num <> 0
     2675       and p-mode <> 'ПРОСМОТР':U
     2676       then do:
     2677           MESSAGE
     2678           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     2679           VIEW-AS ALERT-BOX ERROR.
     2680           UNDO, RETURN ERROR.
     2681       end.
     2682     end.
     2683     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2684       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     2685                 LOCKED_thbj-attr.obj-type = p-obj-type
     2686           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2687           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-r-keeper':U
     2688           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     2689        if locked locked_thbj-attr then do:
     2690           message
     2691           vss-workfile vss-revision vss-description skip
     2692            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     2693           view-as alert-box error .
     2694           undo, return error.
     2695         end.
     2696     END.
     2697     ELSE DO:
     2698         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     2699             LOCKED_thbj-attr.obj-type = p-obj-type
     2700       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     2701       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-r-keeper':U
     2702       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     2703     END.
     2704     if not available locked_thbj-attr then do:
     2705       ASSIGN
     2706       v-to-create  = YES.
     2707       message
     2708       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2709                   chr(10))
     2710       view-as alert-box WARNING.
     2711     end.
     2712   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2714     (input  v-host-code
     2715     ,output v-r-b-code
     2716     )  .
     2717   FIND FIRST buf_currency NO-LOCK WHERE
     2718           buf_currency.curr-code = v-r-b-code .
     2719     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     2720     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2721     RUN Myenable.
     2722     WAIT-FOR GO OF FRAME Dialog-Frame.
     2723   END.
     2724   RUN disable_UI.
     2725   PROCEDURE disable_UI :
     2726     HIDE FRAME Dialog-Frame.
     2727   END PROCEDURE.
     2728   PROCEDURE enable_UI :
     2729     DISPLAY f-cdpay-code f-r-keeper-sifr s-datef FILL-IN-cdpay-code
     2730         WITH FRAME Dialog-Frame.
     2731     ENABLE B-exit b-quit B-Help BR-cash-pay f-cdpay-code B-ok B-no-ok BR-dis-rule
     2732            f-r-keeper-sifr s-datef
     2733         WITH FRAME Dialog-Frame.
     2734     VIEW FRAME Dialog-Frame.
     2735   END PROCEDURE.
     2736   PROCEDURE fill-widgets :
     2737   define variable v-value-character as character no-undo .
     2738   define variable v-value-date as date no-undo .
     2739   define variable v-value-decimal as decimal no-undo .
     2740   define variable v-value-integer as INTEGER no-undo .
     2741   define variable v-value-logical AS LOGICAL no-undo .
     2742   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2743   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     2744   DEFINE VARIABLE v-cash-pay-list AS CHARACTER NO-UNDO.
     2745   DEFINE VARIABLE v-dis-rule-list AS CHARACTER NO-UNDO.
     2746   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2747   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     2748   DEFINE VARIABLE v-cdpay-code-r-keeper LIKE ub.cash-pay.cdpay-code NO-UNDO.
     2749   DEFINE VARIABLE v-r-keeper-sifr-r-keeper LIKE tt-dis-rule-r-keeper.r-keeper-sifr NO-UNDO.
     2750   define variable v-rule-num like ub.dis-rule.rule-num no-undo .
     2751   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2752   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     2753   define variable v-param-type as character no-undo .
     2754   define variable v-param-value as character no-undo .
     2755   FOR EACH thbjattr_thbj-attr:
     2756     delete thbjattr_thbj-attr.
     2757   end.
     2758   FOR EACH temp-thbj-attr:
     2759     delete temp-thbj-attr.
     2760   end.
     2761   run adm/shattri.p (
     2762                 input "init":U
     2763               , input p-obj-type
     2764               , input p-obj-code
     2765               , input 'cd-type-r-keeper':U
     2766               , input "":U
     2767               , output v-value-character
     2768               , output v-value-date
     2769               , output v-value-decimal
     2770               , output v-value-integer
     2771               , output v-value-logical
     2772               , output v-param-type
     2773               , INPUT-OUTPUT TABLE-handle v-tth
     2774               ) no-error .
     2775   if error-status:error
     2776   and not available locked_thbj-attr then do:
     2777     message
     2778     "Не удалось получить начальные значения настроек" skip
     2779     error-status:get-message(1) return-value
     2780     view-as alert-box error .
     2781     undo, return error .
     2782   end.
     2783   FOR EACH thbjattr_thbj-attr:
     2784     ASSIGN
     2785     v-entry = thbjattr_thbj-attr.prop-code.
     2786     IF v-entry = 'cash-pay-list':U THEN DO:
     2787       ASSIGN
     2788       v-cash-pay-list = thbjattr_thbj-attr.property-value-character.
     2789     END.
     2790     IF v-entry = 'dis-rule-list':U THEN DO:
     2791       ASSIGN
     2792       v-dis-rule-list = thbjattr_thbj-attr.property-value-character.
     2793     END.
     2794     IF v-entry = 'date-format':U THEN DO:
     2795       ASSIGN
     2796       v-date-format = thbjattr_thbj-attr.property-value-character
     2797       s-datef = (IF lookup(v-date-format, "dd.mm.yyyy" + chr(44) +                                    "dd.mm.yy" + chr(44) +                                    "dd.m.yyyy" + chr(44) +                                     "dd/mm/yy" + chr(44) +                                     "yyyy-mm-dd") > 0
     2798                  THEN v-date-format
     2799                  ELSE "dd.mm.yyyy").
     2800     END.
     2801     create temp-thbj-attr.
     2802     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     2803   END.
     2804   if v-cash-pay-list <> "":U then do:
     2805   _ii:
     2806   DO ii = 1 TO  NUM-ENTRIES(v-cash-pay-list, ";"):
     2807      ASSIGN
     2808      v-entry = entry(ii, v-cash-pay-list, ";":U)
     2809      v-cdpay-code-r-keeper = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     2810      v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     2811      v-curr-code = integer(entry(2, entry(2, v-entry, chr(47)), chr(44)))
     2812      .
     2813      FIND FIRST buf_cash-pay NO-LOCK WHERE
     2814                   buf_cash-pay.cdpay-code = v-cdpay-code
     2815           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     2816      IF NOT AVAILABLE buf_cash-pay THEN NEXT _ii.
     2817       CREATE tt-cash-pay-r-keeper.
     2818       BUFFER-COPY buf_cash-pay TO tt-cash-pay-r-keeper
     2819       ASSIGN
     2820       tt-cash-pay-r-keeper.r-keeper-cdpay-code = v-cdpay-code-r-keeper
     2821       .
     2822   END.
     2823   end.
     2824   if v-dis-rule-list <> "":U then do:
     2825   _ii:
     2826   DO ii = 1 TO  NUM-ENTRIES(v-dis-rule-list, ";"):
     2827      ASSIGN
     2828      v-entry = entry(ii, v-dis-rule-list, ";":U)
     2829      v-r-keeper-sifr-r-keeper = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     2830      v-rule-num = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     2831      .
     2832      FIND FIRST buf_dis-rule NO-LOCK WHERE
     2833                   buf_dis-rule.rule-num = v-rule-num NO-ERROR.
     2834      IF NOT AVAILABLE buf_dis-rule THEN NEXT _ii.
     2835       CREATE tt-dis-rule-r-keeper.
     2836       BUFFER-COPY buf_dis-rule TO tt-dis-rule-r-keeper
     2837       ASSIGN
     2838       tt-dis-rule-r-keeper.r-keeper-sifr = v-r-keeper-sifr-r-keeper
     2839       .
     2840     END.
     2841   end.
     2842   END PROCEDURE.
     2843   PROCEDURE MyEnable :
     2844   DEFINE BUFFER buf_currency FOR ub.currency.
     2845   ASSIGN
     2846   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     2847   v-tab-order = "b-add-cash-pay,b-del-cash-pay,b-add-rule,b-del-dis-rule,s-datef".
     2848   ASSIGN
     2849   s-datef:LIST-ITEMS = "dd.mm.yyyy" + chr(44) +                                    "dd.mm.yy" + chr(44) +                                    "dd.m.yyyy" + chr(44) +                                     "dd/mm/yy" + chr(44) +                                     "yyyy-mm-dd"
     2850   s-datef =  v-date-format   .
     2851   DISPLAY s-datef
     2852   WITH FRAME Dialog-Frame.
     2853   ENABLE
     2854   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2855   b-quit
     2856   B-Help
     2857   br-cash-pay
     2858   b-add-cash-pay   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2859   b-del-cash-pay   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2860   br-dis-rule
     2861   b-add-dis-rule   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2862   b-del-dis-rule   WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2863   s-datef WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     2864   WITH FRAME Dialog-Frame.
     2865   VIEW FRAME Dialog-Frame.
     2866   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2867       HIDE
     2868       b-exit
     2869       IN FRAME Dialog-Frame.
     2870       ASSIGN
     2871       b-quit:LABEL = "&Выход"
     2872       .
     2873   END.
     2874   HIDE
     2875   b-ok
     2876   b-no-ok
     2877   f-cdpay-code
     2878   FILL-IN-cdpay-code
     2879   f-r-keeper-sifr
     2880   in FRAME Dialog-Frame.
     2881   RUN openbrcash-pay IN THIS-PROCEDURE.
     2882   RUN openbrdis-rule IN THIS-PROCEDURE.
     2883   END PROCEDURE.
     2884   PROCEDURE OpenBrcash-pay :
     2885   OPEN QUERY br-cash-pay FOR EACH tt-cash-pay-r-keeper SHARE-LOCK.
     2886   END PROCEDURE.
     2887   PROCEDURE OpenBrdis-rule :
     2888   OPEN QUERY br-dis-rule FOR EACH tt-dis-rule-r-keeper SHARE-LOCK.
     2889   END PROCEDURE.
     2890   PROCEDURE proc-b-add :
     2891   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     2892   DEFINE INPUT PARAMETER p-code1 AS integer NO-UNDO.
     2893   DEFINE INPUT PARAMETER p-code2 AS integer NO-UNDO.
     2894   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     2895   DEFINE VARIABLE v-log AS logical NO-UNDO.
     2896   DEFINE variable v-rid AS RECID NO-UNDO.
     2897   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2898   DEFINE BUFFER buf_tt-cash-pay-r-keeper FOR tt-cash-pay-r-keeper.
     2899   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2900   define variable ii as integer no-undo .
     2901   CASE p-mode:
     2902       WHEN "cash-pay" THEN DO:
     2903         APPLY "ENTRY" TO f-cdpay-code IN FRAME Dialog-Frame.
     2904        END.
     2905       WHEN "dis-rule" THEN DO:
     2906         APPLY "ENTRY" TO f-r-keeper-sifr IN FRAME Dialog-Frame.
     2907       END.
     2908   END CASE.
     2909   END PROCEDURE.
     2910   PROCEDURE proc-b-del :
     2911   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     2912   CASE p-mode:
     2913       WHEN "cash-pay" THEN DO:
     2914           IF NOT AVAILABLE tt-cash-pay-r-keeper THEN RETURN NO-APPLY.
     2915             DELETE tt-cash-pay-r-keeper.
     2916             RUN openbrcash-pay IN THIS-PROCEDURE.
     2917             REPOSITION br-cash-pay TO ROW 1.
     2918       END.
     2919       WHEN "dis-rule" THEN DO:
     2920           IF NOT AVAILABLE tt-dis-rule-r-keeper THEN RETURN NO-APPLY.
     2921             DELETE tt-dis-rule-r-keeper.
     2922             RUN openbrdis-rule IN THIS-PROCEDURE.
     2923             REPOSITION br-dis-rule TO ROW 1.
     2924       END.
     2925   END CASE.
     2926   END PROCEDURE.
     2927   PROCEDURE proc-b-no-ok :
     2928   HIDE
     2929   b-ok
     2930   IN FRAME Dialog-Frame
     2931   b-no-ok
     2932   IN FRAME Dialog-Frame
     2933   f-cdpay-code
     2934   FILL-IN-cdpay-code
     2935   f-r-keeper-sifr
     2936   IN FRAME Dialog-Frame
     2937   .
     2938   END PROCEDURE.
     2939   PROCEDURE proc-b-ok :
     2940   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     2941   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     2942   DEFINE VARIABLE v-log AS logical NO-UNDO.
     2943   DEFINE variable v-rid AS RECID NO-UNDO.
     2944   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2945   define variable v-sts   like ub.dis-rule.sts no-undo init ?.
     2946   DEFINE BUFFER buf_tt-cash-pay-r-keeper FOR tt-cash-pay-r-keeper.
     2947   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2948   DEFINE BUFFER buf_tt-dis-rule-r-keeper FOR tt-dis-rule-r-keeper.
     2949   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     2950   ASSIGN
     2951   add-option = "":U.
     2952   CASE p-mode:
     2953       WHEN "cash-pay" THEN DO:
     2954           ASSIGN
     2955           FRAME Dialog-Frame
     2956           f-cdpay-code.
     2957           FIND FIRST buf_tt-cash-PAY-r-keeper NO-LOCK WHERE
     2958                   buf_tt-cash-pay-r-keeper.r-keeper-cdpay-code = f-cdpay-code NO-ERROR.
     2959           IF AVAILABLE buf_tt-cash-pay-r-keeper THEN DO:
     2960               MESSAGE
     2961               SUBSTITUTE("Уже задано правило соответствия для типа кассового платежа,&1" +
     2962                          "у которого код платежа &2"
     2963                          , chr(10)
     2964                          , f-cdpay-code
     2965                          )
     2966               VIEW-AS ALERT-BOX ERROR.
     2967               RETURN ERROR.
     2968           END.
     2969           run ref/cashpays.w (
     2970                      input parparentproc
     2971                     ,input  "b-sel":U
     2972                     ,input 'все':U
     2973                     ,input (if p-obj-type = 'орг':U then p-obj-code else v-host-code)
     2974                     ,input (if p-obj-type = 'орг':U then '':U else p-obj-type)
     2975                     ,input (if p-obj-type = 'орг':U then 0 else p-obj-code)
     2976                     ,OUTPUT v-rid-list) NO-ERROR.
     2977           IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN error.
     2978           FIND FIRST buf_cash-pay NO-LOCK WHERE
     2979                   RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
     2980           IF NOT AVAILABLE buf_cash-pay  THEN RETURN error.
     2981           CREATE tt-cash-pay-r-keeper.
     2982           BUFFER-COPY buf_cash-pay
     2983              TO tt-cash-pay-r-keeper
     2984              ASSIGN
     2985              tt-cash-pay-r-keeper.r-keeper-cdpay-code = f-cdpay-code
     2986               v-rid = RECID(tt-cash-pay-r-keeper)
     2987              .
     2988              RUN openbrcash-pay IN THIS-PROCEDURE.
     2989              REPOSITION br-cash-pay TO RECID v-rid.
     2990       END.
     2991       WHEN "dis-rule" THEN DO:
     2992           ASSIGN
     2993           FRAME Dialog-Frame
     2994           f-r-keeper-sifr.
     2995           if f-r-keeper-sifr = 0 then do:
     2996             message
     2997             "Нельзя ввести идентификатор скидки равный 0!"
     2998             view-as alert-box error .
     2999             undo, return error .
     3000           end.
     3001           FIND FIRST buf_tt-dis-rule-r-keeper NO-LOCK WHERE
     3002                   buf_tt-dis-rule-r-keeper.r-keeper-sifr = f-r-keeper-sifr NO-ERROR.
     3003           IF AVAILABLE buf_tt-dis-rule-r-keeper THEN DO:
     3004               MESSAGE
     3005               SUBSTITUTE("Уже задано правило соответствия для скидки с идентификатором &1"
     3006                           , f-r-keeper-sifr
     3007                          )
     3008               VIEW-AS ALERT-BOX ERROR.
     3009               RETURN ERROR.
     3010           END.
     3011           run ref/dis-ruls.w (
     3012                     input  parparentproc
     3013                     ,input 0
     3014                     ,input p-obj-type
     3015                     ,input p-obj-code
     3016                     ,input "b-sel":U
     3017                     ,input "cd-obj=R-KEEPER":U
     3018                     ,input 0
     3019                     ,input ?
     3020                     ,input 0
     3021                     ,input-output v-sts
     3022                     ,input-OUTPUT v-rid-list) NO-ERROR.
     3023           IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN error.
     3024           FIND FIRST buf_dis-rule NO-LOCK WHERE
     3025                   RECID(buf_dis-rule) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
     3026           IF NOT AVAILABLE buf_dis-rule  THEN RETURN error.
     3027           CREATE tt-dis-rule-r-keeper.
     3028           BUFFER-COPY buf_dis-rule
     3029              TO tt-dis-rule-r-keeper
     3030              ASSIGN
     3031              tt-dis-rule-r-keeper.r-keeper-sifr = f-r-keeper-sifr
     3032               v-rid = RECID(tt-dis-rule-r-keeper)
     3033              .
     3034              RUN openbrdis-rule IN THIS-PROCEDURE.
     3035              REPOSITION br-dis-rule TO RECID v-rid.
     3036       END.
     3037   END CASE.
     3038   HIDE
     3039   b-ok
     3040   IN FRAME Dialog-Frame
     3041   b-no-ok
     3042   IN FRAME Dialog-Frame
     3043   f-cdpay-code
     3044   IN FRAME Dialog-Frame
     3045   FILL-IN-cdpay-code
     3046   IN FRAME Dialog-Frame
     3047   f-r-keeper-sifr
     3048   IN FRAME Dialog-Frame
     3049   .
     3050   END PROCEDURE.
     3051   PROCEDURE proc-save :
     3052   define variable v-same as logical no-undo .
     3053   define variable v-value-character as character no-undo .
     3054   define variable v-value-date as date no-undo .
     3055   define variable v-value-decimal as decimal no-undo .
     3056   define variable v-value-integer as INTEGER no-undo .
     3057   define variable v-value-logical AS LOGICAL no-undo .
     3058   define variable v-param-type as character no-undo .
     3059   DEFINE VARIABLE v-cash-pay-list AS CHARACTER NO-UNDO.
     3060   DEFINE VARIABLE v-dis-rule-list AS CHARACTER NO-UNDO.
     3061   DEFINE BUFFER buf_tt-cash-pay-r-keeper FOR tt-cash-pay-r-keeper.
     3062   DEFINE BUFFER buf_tt-dis-rule-r-keeper FOR tt-dis-rule-r-keeper.
     3063   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     3064   ASSIGN
     3065   FRAME Dialog-Frame
     3066   s-datef
     3067   .
     3068   FOR EACH tt-cash-pay-r-keeper BY tt-cash-pay-r-keeper.r-keeper-cdpay-code:
     3069     ASSIGN
     3070     v-cash-pay-list = v-cash-pay-list + (IF v-cash-pay-list = "":U THEN "":U ELSE ";") +
     3071                       STRING(tt-cash-pay-r-keeper.r-keeper-cdpay-code) + chr(47) +
     3072                       STRING(tt-cash-pay-r-keeper.cdpay-code) + chr(44) +
     3073                       STRING(tt-cash-pay-r-keeper.curr-code)
     3074     .
     3075   END.
     3076   FOR EACH tt-dis-rule-r-keeper BY tt-dis-rule-r-keeper.r-keeper-sifr:
     3077     ASSIGN
     3078     v-dis-rule-list = v-dis-rule-list + (IF v-dis-rule-list = "":U THEN "":U ELSE ";") +
     3079                       STRING(tt-dis-rule-r-keeper.r-keeper-sifr) + chr(47) +
     3080                       STRING(tt-dis-rule-r-keeper.rule-num)
     3081     .
     3082   END.
     3083   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'cash-pay-list':U.
     3084   assign
     3085   thbjattr_thbj-attr.property-value-character = v-cash-pay-list.
     3086   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'dis-rule-list':U.
     3087   assign
     3088   thbjattr_thbj-attr.property-value-character = v-dis-rule-list.
     3089   find first thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'date-format':U.
     3090   assign
     3091   thbjattr_thbj-attr.property-value-character = s-datef.
     3092   v-same = yes.
     3093   for each thbjattr_thbj-attr,
     3094       first temp-thbj-attr where
     3095             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3096         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     3097         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3098         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     3099      buffer-compare
     3100      thbjattr_thbj-attr
     3101      to temp-thbj-attr
     3102      save result in v-same.
     3103      if not v-same then leave.
     3104   end.
     3105   v-same = no.
     3106   IF v-same  and not v-to-create THEN RETURN.
     3107   run adm/shattri.p (
     3108                 input "check":U
     3109               , input p-obj-type
     3110               , input p-obj-code
     3111               , input 'cd-type-r-keeper':U
     3112               , INPUT '':U
     3113                , output v-value-character
     3114                , output v-value-date
     3115                , output v-value-decimal
     3116                , output v-value-integer
     3117                , output v-value-logical
     3118                , output v-param-type
     3119                , input-output TABLE-handle v-tth
     3120                ) no-error .
     3121   if error-status:error then do:
     3122     message
     3123     "Некорректное значение ПАРАМЕТРОВ" skip
     3124     error-status:get-message(1) skip
     3125     return-value
     3126     view-as alert-box error .
     3127     undo, return error .
     3128   end.
     3129   do TRANSACTION
     3130   on error undo, return error return-value
     3131   :
     3132     RUN thbjattr_set-section IN THIS-PROCEDURE (
     3133          input p-obj-type
     3134         ,input p-obj-code
     3135         ,input 'cd-type-r-keeper':U
     3136         ,INPUT table thbjattr_thbj-attr
     3137     ) NO-ERROR.
     3138     IF ERROR-STATUS:error THEN do:
     3139       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3140       RETURN-VALUE
     3141       VIEW-AS ALERT-BOX.
     3142       UNDO, RETURN ERROR.
     3143     END.
     3144   end.
     3145   END PROCEDURE.
