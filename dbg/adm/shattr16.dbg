      621   procedure proc-alt-shift-f2:
      622     if not ibs.th.gbl.gbl-var:rcode
      623   then
      624     run gbl\inidebug.p .
      625   end.
      626   procedure proc-alt-shift-f3:
      627     run gbl/prvssinf.p
      628       ( input this-procedure
      629       ) .
      630   end.
      631   define variable v-inform-launched as logical no-undo initial false .
      632   procedure proc-alt-shift-f4:
      633     define variable v-action as character no-undo .
      634     if v-inform-launched = false then do:
      635       assign
      636         v-inform-launched = true
      637       .
      638       run gbl/d-inform.w
      639         (  input self
      640         ,  input this-procedure
      641         , output v-action
      642         ) no-error .
      643       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      644       assign
      645         v-inform-launched = false
      646       .
      647     end.
      648   end.
      649   procedure proc-alt-f1:
      650     run gbl/corrhelp.p
      651       (input this-procedure
      652       ) .
      653   end .
      654   on alt-shift-f2 anywhere do:
      655     run proc-alt-shift-f2.
      656   end.
      657   on alt-shift-f3 anywhere do:
      658     run proc-alt-shift-f3 in this-procedure .
      659   end.
      660   on alt-shift-f4 anywhere do:
      661     run proc-alt-shift-f4 in this-procedure.
      662   end.
      663   on alt-f1 anywhere do:
      664     run proc-alt-f1 in this-procedure .
      665   end.
      666   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   procedure cli-grplib-get-full-name :
      668      define input parameter  p-node-code  as integer      no-undo.
      669      define output parameter p-full-name as character    no-undo.
      670   do
      671   on error undo, return error
      672   :
      673       define variable v-upper-code    as integer           no-undo.
      674       define buffer buf_cli-grp       for ub.cli-grp.
      675       define buffer buf_upper_cli-grp for ub.cli-grp.
      676       find first buf_cli-grp no-lock
      677            where buf_cli-grp.node-code = p-node-code
      678       no-error.
      679       if not available buf_cli-grp
      680       then do:
      681           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      682       end.
      683       assign
      684           p-full-name  = ""
      685           v-upper-code = 1
      686       .
      687       do while buf_cli-grp.upper-code <> 0
      688       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      689       :
      690           assign
      691               p-full-name  = buf_cli-grp.node-name
      692                            + (if p-full-name <> "" then chr(47) else "")
      693                            + p-full-name
      694               v-upper-code = buf_cli-grp.upper-code
      695           .
      696           find first buf_cli-grp no-lock
      697                where buf_cli-grp.node-code = v-upper-code
      698           no-error.
      699           if not available buf_cli-grp
      700           then do:
      701               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      702                                   + string( v-upper-code )
      703                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      704           end.
      705       end.
      706       assign
      707       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      708       .
      709   end.
      710   end .
      711   procedure cgrplib-get-node-from-full-name :
      712   define input parameter p-full-name as character no-undo .
      713   define output parameter p-node-code as integer no-undo .
      714   define variable v-ii as integer no-undo .
      715   define variable v-upper-code as integer no-undo .
      716   define variable v-root-code as integer no-undo .
      717   define variable v-entry as character no-undo .
      718   define buffer buf_cli-grp       for ub.cli-grp.
      719   do
      720   on error undo, return error
      721   :
      722     find first buf_cli-grp no-lock
      723         where buf_cli-grp.upper-code = 0
      724     no-error .
      725     if not available buf_cli-grp
      726     then do:
      727         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      728     end.
      729     else do:
      730       assign
      731       v-root-code = buf_cli-grp.node-code
      732       .
      733     end.
      734     v-upper-code = v-root-code.
      735     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      736       assign
      737       v-entry = entry(v-ii, p-full-name, chr(47)).
      738       if v-entry = '' then leave.
      739       find first buf_cli-grp no-lock where
      740                 buf_cli-grp.node-name = v-entry
      741             and buf_cli-grp.upper-code = v-upper-code
      742             no-error.
      743       if not available buf_cli-grp then do:
      744         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      745       end.
      746       else do:
      747         p-node-code = buf_cli-grp.node-code.
      748         v-upper-code = buf_cli-grp.node-code.
      749       end.
      750     end.
      751   end.
      752   end .
      753   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   function windows-date-format returns character ( input p-date  as date, input p-format as character ):
      755   define variable v-string-date as character no-undo .
      756   CASE p-format:
      757     when "dd.mm.yyyy":U
      758     or
      759     when "dd.mm.yy":U
      760     or
      761     when "dd/mm/yy":U
      762     then do:
      763       assign
      764       p-format = replace(p-format, "dd", "99")
      765       p-format = replace(p-format, "mm", "99")
      766       p-format = replace(p-format, "yy", "99")
      767       v-string-date = string(p-date, p-format)
      768       .
      769     end.
      770     when "d.m.yy":U then do:
      771       ASSIGN
      772       v-string-date = string(day(p-date), ">9") + string(month(p-date), ">9") +
      773                       substring(string(p-date, "99/99/99"), 7, 2)
      774       .
      775     end.
      776     when "yyyy-mm-dd":U then do:
      777       ASSIGN
      778       v-string-date = string(year(p-date), "9999") + "-":U + string(month(p-date), "99") + string(day(p-date), "99")
      779       .
      780     end.
      781   END CASE.
      782   return v-string-date.
      783   END FUNCTION.
