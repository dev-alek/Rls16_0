        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define input parameter p-silent as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 446b147e8750, 2875, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        7   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:10 2021 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: schedul3.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: adm/schedul3.p $":U .
       10   define variable vss-description as character no-undo init "Удаление строки расписани ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure gen-key-rec :
       71     define input  parameter p-tbl-name    as character no-undo.
       72     define input  parameter p-bh_tbl-name as handle    no-undo.
       73     define output parameter p-key-rec     as character no-undo.
       74     do
       75     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       76     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       77     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       78     :
       79       define variable fh               as handle    no-undo .
       80       define variable v-ok             as logical   no-undo .
       81       define variable v-inform         as character no-undo .
       82       define variable v-ind            as integer   no-undo .
       83       define variable v-idx-field-qnty as integer   no-undo .
       84       if p-tbl-name = ?
       85         or p-tbl-name = "":U
       86       then do:
       87         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       88       end.
       89       if not p-bh_tbl-name:available then do:
       90         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       91       end.
       92       assign
       93         p-key-rec = p-tbl-name
       94         v-inform  = p-bh_tbl-name:index-information(1)
       95         v-ind     = 2
       96       .
       97       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       98       on error undo, return error
       99       :
      100         assign
      101           v-inform = p-bh_tbl-name:index-information( v-ind )
      102           v-ind    = v-ind + 1
      103         .
      104       end.
      105       if v-inform = ?
      106         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      107         or entry( 3, v-inform, ",":U ) <> "1":U
      108       then do:
      109         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      110       end.
      111       else do:
      112         assign
      113           v-idx-field-qnty = num-entries( v-inform ) - 4
      114         .
      115         if v-idx-field-qnty < 2 then do:
      116           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      117         end.
      118         do v-ind = 1 to v-idx-field-qnty by 2
      119         on error undo, return error
      120         :
      121           assign
      122             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      123             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      124           .
      125         end.
      126       end.
      127       if p-key-rec = ? then do:
      128         assign
      129           p-key-rec = "":U
      130         .
      131         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      132       end.
      133     end.
      134     return.
      135   end procedure.
      136   procedure gen-where-keyr-tab :
      137     define input  parameter i-tableSerach as character no-undo.
      138     define input  parameter i-tablekey   as character  no-undo.
      139     define input  parameter p-key-rec    as character  no-undo.
      140     define input  parameter p-key-handle as handle     no-undo .
      141     define input  parameter p-db-name    as character  no-undo .
      142     define input  parameter p-tt-handle  as handle     no-undo .
      143     define output parameter o-Where      as character  no-undo.
      144     do
      145     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      146     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      147     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      148     :
      149       define variable v-full-tbl-name  as character no-undo .
      150       define variable bh_tbl-name      as handle    no-undo .
      151       define variable fh_key           as handle    no-undo .
      152       define variable fh_search        as handle    no-undo .
      153       define variable v-field-num      as integer   no-undo .
      154       define variable v-count-fld      as integer   no-undo .
      155       define variable v-inform         as character no-undo .
      156       define variable v-ind            as integer   no-undo .
      157       define variable v-idx-field-qnty as integer   no-undo .
      158       define variable v-field-name     as character no-undo .
      159       define variable v-field-val      as character no-undo .
      160       define variable v-word-link      as character no-undo .
      161       define variable vTable           as character no-undo.
      162       define variable bh_tbl-key       as handle    no-undo .
      163       assign
      164         p-key-rec = trim( p-key-rec )
      165       .
      166       if p-key-handle <> ? then do:
      167         if not valid-handle(p-key-handle)
      168            or p-key-handle:type <> "buffer"
      169         then do:
      170           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      171         end.
      172         if num-entries( p-key-rec, chr(3) ) > 1
      173           or p-key-rec = ?
      174           or p-key-rec = "":U
      175         then do:
      176           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      177         end.
      178       end.
      179       else do:
      180         if p-key-rec = ?
      181           or p-key-rec = "":U
      182         then do:
      183           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      184         end.
      185       end.
      186       assign
      187         vTable = entry( 1 , p-key-rec, chr(3) )
      188       .
      189       if p-tt-handle <> ?
      190         and ( not valid-handle(p-tt-handle)
      191               or p-tt-handle:type <> "buffer"
      192             )
      193       then do:
      194         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      195       end.
      196       if p-tt-handle = ? then do:
      197         assign
      198           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      199         .
      200         create buffer bh_tbl-name for table v-full-tbl-name .
      201       end.
      202       else do:
      203         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      204       end.
      205       assign
      206         v-inform = bh_tbl-name:index-information(1)
      207         v-ind    = 2
      208       .
      209       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      210       on error undo, return error
      211       :
      212         assign
      213           v-inform = bh_tbl-name:index-information( v-ind )
      214           v-ind    = v-ind + 1
      215         .
      216       end.
      217       if v-inform = ?
      218         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      219         or entry( 3, v-inform, ",":U ) <> "1":U
      220       then do:
      221         delete object bh_tbl-name no-error.
      222         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      223       end.
      224       assign
      225         v-idx-field-qnty = num-entries( v-inform ) - 4
      226       .
      227       if v-idx-field-qnty < 2 then do:
      228         delete object bh_tbl-name no-error.
      229         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      230       end.
      231       assign
      232         o-where     = "where":U
      233         v-word-link = "":U
      234         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      235         v-count-fld = 0
      236       .
      237       if i-tablekey ne "" and i-tablekey ne ?
      238       then do:
      239         assign
      240           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      241         .
      242         create buffer bh_tbl-key for table v-full-tbl-name .
      243       end.
      244       if i-tableSerach ne "" and i-tableSerach ne ?
      245       then do:
      246         delete object bh_tbl-name no-error.
      247         assign
      248           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      249         .
      250         create buffer bh_tbl-name for table v-full-tbl-name .
      251       end.
      252       block_where:
      253       do v-ind = 1 to v-idx-field-qnty by 2
      254       on error undo, return error
      255       :
      256         assign
      257           v-count-fld = v-count-fld + 1
      258         .
      259         if p-key-handle = ?
      260           and v-count-fld > v-field-num
      261         then do:
      262           leave block_where.
      263         end.
      264         define variable VfieldKeyTable as handle no-undo.
      265         assign
      266           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      267           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      268         .
      269         if     bh_tbl-key ne ?
      270         then do:
      271            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      272            if VfieldKeyTable eq ?
      273            then next block_where.
      274         end.
      275         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      276         then
      277            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      278         else
      279            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      280         if p-key-handle = ? then do:
      281           assign
      282             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      283           .
      284         end.
      285         else do:
      286           assign
      287             fh_key = p-key-handle:buffer-field( v-field-name )
      288           .
      289           if fh_key = ?
      290             or not valid-handle( fh_key )
      291           then do:
      292             delete object bh_tbl-name.
      293             if     bh_tbl-key ne ?
      294             then
      295                delete object bh_tbl-key.
      296             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      297           end.
      298           assign
      299             v-field-val = fh_key:buffer-value
      300           .
      301         end.
      302         if fh_search:data-type ="character":U then do:
      303           assign
      304             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      305             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      306             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      307             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      308             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      309             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      310             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      311             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      312             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      313             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      314             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      315             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      316             v-field-val = substitute( '"&1"', v-field-val )
      317           .
      318         end.
      319         assign
      320           o-where = substitute( "&1 &2", o-where, v-field-val )
      321         .
      322         if v-word-link = "":U then do:
      323           assign
      324             v-word-link = "and":U
      325           .
      326         end.
      327       end.
      328       delete object bh_tbl-name.
      329       if     bh_tbl-key ne ?
      330       then
      331          delete object bh_tbl-key.
      332       if p-key-handle = ?
      333         and v-count-fld <> v-field-num
      334       then do:
      335         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      336       end.
      337     end.
      338   end procedure.
      339   procedure gen-hn-keyr-tab :
      340     define input  parameter i-tableSerach as character no-undo.
      341     define input  parameter i-tablekey   as character no-undo.
      342     define input  parameter p-key-rec    as character no-undo.
      343     define input  parameter p-key-handle as handle    no-undo .
      344     define input  parameter p-db-name    as character no-undo .
      345     define input  parameter p-tt-handle  as handle    no-undo .
      346     define input  parameter p-stts-lock  as integer   no-undo .
      347     define output parameter o-hn         as handle    no-undo.
      348     define variable v-full-tbl-name as character no-undo.
      349     define variable v-where         as character no-undo.
      350     define variable bh_tbl-name     as handle    no-undo.
      351     define variable vTable          as character no-undo.
      352     do
      353     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      354     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      355     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      356         run gen-where-keyr-tab(i-tableSerach,
      357                                i-tablekey,
      358                                p-key-rec,
      359                                p-key-handle,
      360                                p-db-name,
      361                                p-tt-handle,
      362                                output v-where).
      363         if i-tableSerach ne "" and i-tableSerach ne ?
      364         then do:
      365            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      366            create buffer bh_tbl-name for table v-full-tbl-name .
      367         end.
      368         else do:
      369            if p-tt-handle = ? then do:
      370               assign
      371                  vTable = entry( 1 , p-key-rec, chr(3) )
      372               .
      373               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      374               create buffer bh_tbl-name for table v-full-tbl-name .
      375            end.
      376            else do:
      377               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      378            end.
      379         end.
      380         if p-tt-handle = ? then do:
      381            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      382         end.
      383         else do:
      384            bh_tbl-name:find-first( v-where ) no-error .
      385         end.
      386         o-hn = bh_tbl-name.
      387      end.
      388   end procedure.
      389   procedure gen-hn-keyr :
      390     define input  parameter p-key-rec    as character no-undo.
      391     define input  parameter p-key-handle as handle    no-undo .
      392     define input  parameter p-db-name    as character no-undo .
      393     define input  parameter p-tt-handle  as handle    no-undo .
      394     define input  parameter p-stts-lock  as integer   no-undo .
      395     define output parameter o-hn         as handle    no-undo.
      396     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      397   end.
      398   procedure gen-row-keyr :
      399     define input  parameter p-key-rec    as character no-undo.
      400     define input  parameter p-key-handle as handle    no-undo .
      401     define input  parameter p-db-name    as character no-undo .
      402     define input  parameter p-tt-handle  as handle    no-undo .
      403     define input  parameter p-stts-lock  as integer   no-undo .
      404     define output parameter p-tbl-row    as rowid     no-undo.
      405     define output parameter p-tbl-name   as character no-undo.
      406     define variable vHn as handle no-undo.
      407       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      408       p-tbl-row = if vHn:available then vHn:rowid else ?.
      409       p-tbl-name =  vHn:table.
      410       delete object vHn no-error.
      411     if p-tbl-row = ? then do:
      412       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      413     end.
      414     else do:
      415       return.
      416     end.
      417   end procedure.
      418   procedure gen-key-fv :
      419     define input  parameter p-key-rec    as character no-undo .
      420     define output parameter p-field-list as character no-undo .
      421     define output parameter p-value-list as character no-undo.
      422     do
      423     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      424     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      425     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      426     :
      427       define variable v-full-tbl-name  as character no-undo .
      428       define variable bh_tbl-name      as handle    no-undo .
      429       define variable v-tbl-name       as character no-undo .
      430       define variable v-field-num      as integer   no-undo .
      431       define variable v-count-fld      as integer   no-undo .
      432       define variable v-inform         as character no-undo .
      433       define variable v-ind            as integer   no-undo .
      434       define variable v-idx-field-qnty as integer   no-undo .
      435       define variable v-delim-key      as character no-undo .
      436       if p-key-rec = ?
      437         or p-key-rec = "":U
      438       then do:
      439         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      440       end.
      441       assign
      442         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      443         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      444       .
      445       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      446       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      447       assign
      448         v-inform = bh_tbl-name:index-information(1)
      449         v-ind    = 2
      450       .
      451       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      452       on error undo, return error
      453       :
      454         assign
      455           v-inform = bh_tbl-name:index-information( v-ind )
      456           v-ind    = v-ind + 1
      457         .
      458       end.
      459       if v-inform = ?
      460         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      461         or entry( 3, v-inform, ",":U ) <> "1":U
      462       then do:
      463         delete object bh_tbl-name no-error.
      464         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      465       end.
      466       assign
      467         v-idx-field-qnty = num-entries( v-inform ) - 4
      468       .
      469       if v-idx-field-qnty < 2 then do:
      470         delete object bh_tbl-name no-error.
      471         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      472       end.
      473       assign
      474         p-field-list = "":U
      475         p-value-list = "":U
      476         v-delim-key  = "":U
      477         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      478         v-count-fld  = 0
      479       .
      480       block_where:
      481       do v-ind = 1 to v-idx-field-qnty by 2
      482       on error undo, return error
      483       :
      484         assign
      485           v-count-fld = v-count-fld + 1
      486         .
      487         if v-count-fld > v-field-num then do:
      488           leave block_where.
      489         end.
      490         assign
      491           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      492           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      493         .
      494         if v-ind = 1 then do:
      495           assign
      496             v-delim-key = chr(3)
      497           .
      498         end.
      499       end.
      500       delete object bh_tbl-name.
      501       if v-count-fld <> v-field-num then do:
      502         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      503       end.
      504     end.
      505   end procedure.
      506   procedure gen-key-field :
      507     define input  parameter p-table      as character no-undo .
      508     define output parameter p-field-list as character no-undo .
      509     do
      510     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      511     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      512     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      513     :
      514       define variable v-full-tbl-name  as character no-undo .
      515       define variable bh_tbl-name      as handle    no-undo .
      516       define variable v-tbl-name       as character no-undo .
      517       define variable v-field-num      as integer   no-undo .
      518       define variable v-count-fld      as integer   no-undo .
      519       define variable v-inform         as character no-undo .
      520       define variable v-ind            as integer   no-undo .
      521       define variable v-idx-field-qnty as integer   no-undo .
      522       define variable v-delim-key      as character no-undo .
      523       if p-table = ?
      524         or p-table = "":U
      525       then do:
      526         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      527       end.
      528       assign
      529         v-tbl-name      = p-table
      530         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      531       .
      532       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      533       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      534       assign
      535         v-inform = bh_tbl-name:index-information(1)
      536         v-ind    = 2
      537       .
      538       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      539       on error undo, return error
      540       :
      541         assign
      542           v-inform = bh_tbl-name:index-information( v-ind )
      543           v-ind    = v-ind + 1
      544         .
      545       end.
      546       if v-inform = ?
      547         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      548         or entry( 3, v-inform, ",":U ) <> "1":U
      549       then do:
      550         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      551       end.
      552       assign
      553         v-idx-field-qnty = num-entries( v-inform ) - 4
      554       .
      555       if v-idx-field-qnty < 2 then do:
      556         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      557       end.
      558       assign
      559         p-field-list = "":U
      560         v-delim-key  = "":U
      561         v-count-fld  = 0
      562       .
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      571         if v-ind = 1 then do:
      572           assign
      573             v-delim-key = chr(3)
      574           .
      575         end.
      576       end.
      577       delete object bh_tbl-name.
      578     end.
      579   end procedure.
      580   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define temp-table temp-schedule-free no-undo
      582   field free-id as character
      583   field free-task-name as character
      584   field proc-run-name as character
      585   field proc-param-edit-name as character
      586   field conf-param as character
      587   field is-gbd as logical
      588   field is-ubd as logical
      589   field enable-concurrent-0 as logical
      590   field enable-concurrent-db as logical
      591   field other-info as character
      592   field enc-key as character
      593   field is-rum as logical
      594   index pi is unique primary
      595   free-id.
      596   procedure schedule-attr-name :
      597   do
      598     on error undo, return error
      599     :
      600     define input  parameter p-code           as character no-undo .
      601     define output parameter p-type           as character no-undo .
      602     define output parameter p-format         as character no-undo .
      603     define output parameter p-label          as character no-undo .
      604     define output parameter p-user-can-edit  as logical   no-undo .
      605     define output parameter p-output-display as logical   no-undo .
      606     define output parameter p-other          as character no-undo .
      607       if index(p-code, chr(4)) > 0 then do:
      608         p-code = entry(1, p-code, chr(4)).
      609       end.
      610       case p-code :
      611               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      612               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      613               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      614               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      615               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      616               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      617               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      618               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      619               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      620         otherwise do:
      621           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      622         end.
      623       end.
      624     end.
      625   end procedure.
      626   procedure schedule-attr-tooltip :
      627   do
      628     on error undo, return error
      629     :
      630       define input  parameter p-code    as character no-undo .
      631       define output parameter p-tooltip as character no-undo .
      632       define output parameter p-label   as character no-undo .
      633       if index(p-code, chr(4)) > 0 then do:
      634         p-code = entry(1, p-code, chr(4)).
      635       end.
      636       case p-code :
      637               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      638               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      639               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      640               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      641               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      642               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      643               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      644               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      645               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      646         otherwise do:
      647               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      648         end.
      649       end.
      650     end.
      651   end procedure.
      652   procedure schedule-attr-value :
      653   do
      654   on error undo, return error return-value
      655   :
      656   define input parameter  p-cre-db-num as integer    no-undo.
      657   define input parameter  p-task-type  as character  no-undo.
      658   define input parameter  p-task-num   as integer    no-undo.
      659   define input parameter  p-code       as character  no-undo.
      660   define output parameter p-value      as character  no-undo.
      661   define output parameter p-type       as character  no-undo.
      662       define variable v-format         as character no-undo .
      663       define variable v-label          as character no-undo .
      664       define variable v-user-can-edit  as logical   no-undo .
      665       define variable v-output-display as logical   no-undo .
      666       define variable v-other          as character no-undo .
      667       define buffer buf_schedule-attr for ub.schedule-attr.
      668       run schedule-attr-name in this-procedure (
      669             input  p-code
      670           , output p-type
      671           , output v-format
      672           , output v-label
      673           , output v-user-can-edit
      674           , output v-output-display
      675           , output v-other
      676       ) no-error .
      677       if error-status :error
      678       then do:
      679           undo, return error return-value .
      680       end.
      681       if p-code begins ('schd-free-id':U + chr(4))
      682       and entry(2, p-code, chr(4)) = '':U then do:
      683         find first buf_schedule-attr no-lock
      684             where buf_schedule-attr.cre-db-num = p-cre-db-num
      685               and buf_schedule-attr.task-type  = p-task-type
      686               and buf_schedule-attr.task-num   = p-task-num
      687               and buf_schedule-attr.attr-code  begins p-code
      688         no-error .
      689       end.
      690       else do:
      691         find first buf_schedule-attr no-lock
      692             where buf_schedule-attr.cre-db-num = p-cre-db-num
      693               and buf_schedule-attr.task-type  = p-task-type
      694               and buf_schedule-attr.task-num   = p-task-num
      695               and buf_schedule-attr.attr-code  = p-code
      696         no-error .
      697       end.
      698       if available buf_schedule-attr
      699       then do:
      700           assign
      701               p-value = buf_schedule-attr.attr-value
      702           .
      703       end.
      704       else do:
      705         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      706            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      707         end.
      708         else do:
      709           assign
      710               p-value = if p-type = 'L':U then "no":U else ""
      711           .
      712         end.
      713       end.
      714   end.
      715   end procedure.
      716   procedure schedule-attr-write :
      717   do
      718   on error undo, return error
      719   :
      720   define input parameter p-cre-db-num  as integer   no-undo.
      721   define input parameter p-task-type   as character no-undo.
      722   define input parameter p-task-num    as integer   no-undo.
      723   define input parameter p-code        as character no-undo.
      724   define input parameter p-value       as character no-undo.
      725       define variable v-type              as character                no-undo.
      726       define variable v-format            as character                no-undo.
      727       define variable v-label             as character                no-undo.
      728       define variable v-user-can-edit     as logical                  no-undo.
      729       define variable v-output-display    as logical                  no-undo.
      730       define variable v-other             as character                no-undo.
      731       define buffer buf_schedule-attr for ub.schedule-attr .
      732       run schedule-attr-name in this-procedure (
      733             input  p-code
      734           , output v-type
      735           , output v-format
      736           , output v-label
      737           , output v-user-can-edit
      738           , output v-output-display
      739           , output v-other
      740       ) no-error.
      741       if error-status :error
      742       then do:
      743           undo, return error return-value.
      744       end.
      745       find first buf_schedule-attr exclusive-lock
      746            where buf_schedule-attr.cre-db-num = p-cre-db-num
      747              and buf_schedule-attr.task-type  = p-task-type
      748              and buf_schedule-attr.task-num   = p-task-num
      749              and buf_schedule-attr.attr-code  = p-code
      750       no-error.
      751       if not available buf_schedule-attr
      752       then do:
      753           create buf_schedule-attr.
      754           assign
      755             buf_schedule-attr.cre-db-num = p-cre-db-num
      756             buf_schedule-attr.task-type  = p-task-type
      757             buf_schedule-attr.task-num   = p-task-num
      758             buf_schedule-attr.attr-code  = p-code
      759             buf_schedule-attr.attr-value = p-value
      760           .
      761       end.
      762       else do:
      763           assign
      764               buf_schedule-attr.attr-value = p-value
      765           .
      766       end.
      767   end.
      768   end procedure.
      769   procedure schedule-attr-delete :
      770   do
      771   on error undo, return error
      772   :
      773   define input  parameter p-cre-db-num  as integer   no-undo.
      774   define input  parameter p-task-type   as character no-undo.
      775   define input  parameter p-task-num    as integer   no-undo.
      776   define input  parameter p-code        as character no-undo.
      777   define output parameter p-deleted     as logical   no-undo.
      778       define buffer buf_schedule-attr for ub.schedule-attr .
      779       define variable v-type              as character                no-undo.
      780       define variable v-format            as character                no-undo.
      781       define variable v-label             as character                no-undo.
      782       define variable v-user-can-edit     as logical                  no-undo.
      783       define variable v-output-display    as logical                  no-undo.
      784       define variable v-other             as character                no-undo.
      785       run schedule-attr-name in this-procedure (
      786             input p-code
      787           , output v-type
      788           , output v-format
      789           , output v-label
      790           , output v-user-can-edit
      791           , output v-output-display
      792           , output v-other
      793       ) no-error .
      794       if error-status :error
      795       then do:
      796           undo, return error return-value .
      797       end.
      798       find first buf_schedule-attr exclusive-lock
      799            where buf_schedule-attr.cre-db-num = p-cre-db-num
      800              and buf_schedule-attr.task-type  = p-task-type
      801              and buf_schedule-attr.task-num   = p-task-num
      802              and buf_schedule-attr.attr-code  = p-code
      803       no-error.
      804       if not available buf_schedule-attr
      805       then do:
      806           assign
      807               p-deleted = no
      808           .
      809       end.
      810       else do:
      811           delete buf_schedule-attr.
      812           assign
      813               p-deleted = yes
      814           .
      815       end.
      816   end.
      817   end procedure.
      818   procedure schedule-attr-news :
      819   do
      820   on error undo, return error
      821   :
      822       define input  parameter p-code           as character no-undo .
      823       define output parameter p-news           as logical   no-undo .
      824       if index(p-code, chr(4)) > 0 then do:
      825         p-code = entry(1, p-code, chr(4)).
      826       end.
      827       case p-code :
      828               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      829               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      830               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      831               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      832               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      833               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      834               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      835               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      836               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      837         otherwise do:
      838           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      839         end.
      840       end.
      841   end.
      842   end procedure.
      843   procedure schedule-attr-extract-logical :
      844   do
      845   on error undo, return error
      846   :
      847   define input  parameter p-parameter-number   as integer      no-undo.
      848   define input  parameter p-parameter-list     as character    no-undo.
      849   define output parameter p-parameter-value   as logical      no-undo.
      850       if num-entries( p-parameter-list ) > p-parameter-number - 1
      851       then do:
      852           assign
      853               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      854           .
      855       end.
      856       else do:
      857           assign
      858               p-parameter-value   = no
      859           .
      860       end.
      861   end.
      862   end procedure.
      863   procedure schedule-attr-get-free-id :
      864   do
      865   on error undo, return error return-value
      866   :
      867     define input  parameter p-cre-db-num  as integer   no-undo.
      868     define input  parameter p-task-type   as character no-undo.
      869     define input  parameter p-task-num    as integer   no-undo.
      870     define output parameter p-free-id     as character no-undo.
      871     define buffer buf_schedule-attr for ub.schedule-attr.
      872     find first buf_schedule-attr no-lock
      873         where buf_schedule-attr.cre-db-num = p-cre-db-num
      874           and buf_schedule-attr.task-type  = p-task-type
      875           and buf_schedule-attr.task-num   = p-task-num
      876           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      877     no-error .
      878     if available buf_schedule-attr then
      879     assign
      880     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      881     no-error
      882     .
      883   end.
      884   end procedure.
      885   procedure schedule-attr-get-free-props :
      886     define input parameter p-free-id as character no-undo .
      887     define output parameter p-value as character no-undo .
      888     define buffer buf_temp-schedule-free for temp-schedule-free.
      889     do
      890     on error undo, return error return-value
      891     :
      892       find first buf_temp-schedule-free no-lock no-error .
      893       if not available buf_temp-schedule-free then do:
      894         run schedule-attr-fill-free-props in this-procedure .
      895       end.
      896       find first buf_temp-schedule-free where
      897               buf_temp-schedule-free.free-id = p-free-id no-error.
      898       if available buf_temp-schedule-free then do:
      899         assign
      900         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      901                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      902                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      903                   buf_temp-schedule-free.conf-param           + chr(4) +
      904                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      905                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      906                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      907                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      908                   buf_temp-schedule-free.other-info
      909         .
      910       end.
      911       else do:
      912        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      913                              "id произвольной задачи - &5"
      914                              ,vss-workfile
      915                              ,vss-revision
      916                              ,vss-description
      917                              ,chr(10)
      918                              ,p-free-id).
      919       end.
      920     end.
      921   end procedure.
      922   procedure schedule-attr-is-rum-free-id :
      923   define input parameter p-free-id as character no-undo .
      924   define output parameter p-is-rum as logical no-undo .
      925   define buffer buf_temp-schedule-free for temp-schedule-free.
      926   do
      927   on error undo, return error
      928   :
      929       find first buf_temp-schedule-free no-lock no-error .
      930       if not available buf_temp-schedule-free then do:
      931         run schedule-attr-fill-free-props in this-procedure .
      932       end.
      933       find first buf_temp-schedule-free where
      934               buf_temp-schedule-free.free-id = p-free-id no-error.
      935       if available buf_temp-schedule-free
      936       and buf_temp-schedule-free.is-rum
      937       then do:
      938         p-is-rum = yes.
      939       end.
      940   end.
      941   end procedure.
      942   procedure schedule-attr-fill-free-props :
      943   define variable v-path                    as character                no-undo .
      944   DEFINE VARIABLE v-full-path               as character                no-undo .
      945   DEFINE VARIABLE v-file-name               as character                no-undo .
      946   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      947   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      948   define buffer buf_temp-schedule-free for temp-schedule-free.
      949   define variable v-answer as logical no-undo .
      950     do
      951     on error undo, return error substitute("&1 &2 &3&4&5&4"
      952                                           ,vss-workfile
      953                                           ,vss-revision
      954                                           ,vss-description
      955                                           ,chr(10)
      956                                           ,error-status:get-message(1) )
      957     :
      958       run gbl/filename.p (
      959                       input 'cmp/shd-free.d'
      960                     ,output v-full-path
      961                     ,output v-path
      962                     ,output v-file-name
      963                     ,output v-file-name-no-ext
      964                     ,output v-file-name-ext
      965                     ) .
      966       input from value(v-full-path).
      967       repeat :
      968         create buf_temp-schedule-free.
      969         import buf_temp-schedule-free.
      970       END.
      971       input close.
      972       _ff:
      973       for each buf_temp-schedule-free :
      974         if buf_temp-schedule-free.free-id = '':U then do:
      975            delete buf_temp-schedule-free.
      976            next _ff.
      977          end.
      978          run schedule-attr-check-enc in this-procedure (
      979                                                       input  buf_temp-schedule-free.free-id
      980                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      981                                                               buf_temp-schedule-free.proc-param-edit-name +
      982                                                               buf_temp-schedule-free.conf-param +
      983                                                               string(buf_temp-schedule-free.is-gbd) +
      984                                                               string(buf_temp-schedule-free.is-ubd) +
      985                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      986                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      987                                                               string(buf_temp-schedule-free.other-info)
      988                                                               )
      989                                                       ,input  buf_temp-schedule-free.enc-key
      990                                                       ,output v-answer    ) no-error .
      991          if error-status:error
      992          or not v-answer then delete buf_temp-schedule-free.
      993        end.
      994     end.
      995   end procedure.
      996   Function schedule-attr-reverse returns character (str as character).
      997      define variable rev_incl_s as character init "" no-undo .
      998      define variable rev_incl_i as integer no-undo .
      999      define variable rev_incl_l as integer no-undo .
     1000      rev_incl_l = length(str).
     1001      do rev_incl_i = 1 to rev_incl_l:
     1002         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1003      end.
     1004      return rev_incl_s.
     1005   end.
     1006   procedure schedule-attr-check-enc.
     1007     define input  parameter p-free-id   as character no-undo .
     1008     define input  parameter p-value     as character no-undo .
     1009     define input  parameter p-enc-value as character no-undo .
     1010     define output parameter p-answer    as logical   no-undo .
     1011     define variable tmp         as character no-undo .
     1012     define variable v-enc-value as character no-undo .
     1013     assign
     1014     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1015     .
     1016     run schedule-attr-pswd-enc in this-procedure
     1017       ( input tmp
     1018        ,output v-enc-value
     1019       ) no-error .
     1020     if error-status:error then do:
     1021       message
     1022         vss-workfile vss-revision vss-description skip
     1023         "Ошибка при вызове процедуры pswd-enc" skip
     1024         return-value skip
     1025         error-status :get-message(1) skip
     1026         view-as alert-box error .
     1027       undo, return error .
     1028     end.
     1029     if v-enc-value = p-enc-value then do:
     1030       assign
     1031         p-answer = true
     1032       .
     1033     end.
     1034     else do:
     1035       assign
     1036         p-answer = false
     1037       .
     1038     end.
     1039   end.
     1040   procedure schedule-attr-conf-enc.
     1041     define input  parameter p-free-id   as character no-undo .
     1042     define input  parameter p-value     as character no-undo .
     1043     define output parameter p-enc-value as character no-undo .
     1044     define variable tmp         as character no-undo .
     1045     assign
     1046       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1047     .
     1048     run schedule-attr-pswd-enc in this-procedure
     1049       ( input tmp
     1050        ,output p-enc-value
     1051       ) no-error .
     1052     if error-status:error then do:
     1053       message
     1054         vss-workfile vss-revision vss-description skip
     1055         "Ошибка при вызове процедуры pswd-enc" skip
     1056         return-value skip
     1057         error-status :get-message(1) skip
     1058         view-as alert-box error .
     1059       undo, return error .
     1060     end.
     1061   end procedure.
     1062   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   procedure schedule-attr-pswd-enc :
     1064     define input parameter  pswd     as character no-undo .
     1065     define output parameter enc-pswd as character no-undo .
     1066     do
     1067     on error undo, return error return-value
     1068     :
     1069       assign
     1070         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1071       .
     1072     end.
     1073   end procedure.
     1074   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1075     define variable v-cntxt-db-num        as integer   no-undo .
     1076     define variable v-cntxt-userid        as character no-undo .
     1077     define variable v-cntxt-level         as character no-undo .
     1078     define variable v-cntxt-host-code-obj as integer   no-undo .
     1079     define variable v-cntxt-obj-type      as character no-undo .
     1080     define variable v-cntxt-obj-code      as integer   no-undo .
     1081     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1082     define variable v-cntxt-is-admin      as logical   no-undo .
     1083   define variable v-mess as character no-undo .
     1084   define variable v-uniq-key-rec as character no-undo .
     1085   define variable v-free-id as character no-undo .
     1086   define variable v-rum-type as character no-undo .
     1087   define variable v-shift-num as integer no-undo .
     1088   define variable v-shift-date as date no-undo .
     1089   define buffer buf_shift-obj for ub.shift-obj .
     1090   define buffer buf_schedule for ub.schedule.
     1091   define buffer buf-del_schedule-attr   for ub.schedule-attr .
     1092   define buffer buf_schedule-attr       for ub.schedule-attr .
     1093   define buffer buf-del_schedule        for ub.schedule .
     1094   define temp-table tt-sched no-undo like ub.schedule .
     1095   DEFINE TEMP-TABLE tt0-rp-by-call NO-UNDO LIKE ub.rp-by-call.
     1096   DEFINE TEMP-TABLE tt0-rule-by-call NO-UNDO LIKE ub.rule-by-call.
     1097   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
     1098   main-block:
     1099   do
     1100   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1101   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1102   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1103   :
     1104   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105     run mainmenu_getcntxt in parparentproc
     1106       (output v-cntxt-db-num
     1107       ,output v-cntxt-userid
     1108       ,output v-cntxt-level
     1109       ,output v-cntxt-host-code-obj
     1110       ,output v-cntxt-obj-type
     1111       ,output v-cntxt-obj-code
     1112       ,output v-cntxt-db-num-obj
     1113       ,output v-cntxt-is-admin
     1114       ) .
     1115     find first buf_schedule exclusive-lock where
     1116             recid(buf_schedule) = p-rec .
     1117     case buf_schedule.task-type:
     1118       when 'autosuz':U then do:
     1119        v-rum-type = 'rep':U.
     1120       end.
     1121       when 'autofree':U
     1122       then do:
     1123         run schedule-attr-get-free-id in this-procedure (
     1124                                                          input buf_schedule.cre-db-num
     1125                                                         ,input buf_schedule.task-type
     1126                                                         ,input buf_schedule.task-num
     1127                                                         ,output v-free-id) no-error.
     1128        if num-entries(v-rum-type, "_") = 1 then do:
     1129          v-rum-type = entry(1, v-free-id, "_").
     1130            end.
     1131       end.
     1132       otherwise do:
     1133       end.
     1134     end case.
     1135     if v-rum-type <> "" then do:
     1136       run gen-key-rec in this-procedure ( input 'schedule':U
     1137                                           ,input (buffer buf_schedule:handle)
     1138                                           , output v-uniq-key-rec).
     1139       run rul/thbjrum1.p (
     1140                       input 'ИЗМЕНЕНИЕ':U
     1141                       ,input v-rum-type
     1142                       ,input v-uniq-key-rec
     1143                       ,input 0
     1144                       ,input "":U
     1145                       ,input 0
     1146                       ,input ?
     1147                       ,INPUT TABLE tt0-rp-by-call
     1148                       ,INPUT TABLE tt0-rule-by-call
     1149                       ,INPUT TABLE tt0-rule-call-param) no-error .
     1150       if error-status:error then do:
     1151         v-mess = substitute("Ошибка при удалении настроек строки расписания машины правил: &1&2&3"
     1152                             , error-status:get-message(1)
     1153                             , chr(10)
     1154                             , return-value ).
     1155         run err-mess in this-procedure ( input-output v-mess) .
     1156         undo main-block, return error (if p-silent = yes then v-mess else '':U).
     1157       end.
     1158     end.
     1159     for each buf_schedule-attr no-lock
     1160        where buf_schedule-attr.cre-db-num     = buf_schedule.cre-db-num
     1161          and buf_schedule-attr.task-type      = buf_schedule.task-type
     1162          and buf_schedule-attr.task-num       = buf_schedule.task-num
     1163     on error undo, return error
     1164     :
     1165       find first buf-del_schedule-attr exclusive-lock
     1166            where recid( buf-del_schedule-attr ) = recid( buf_schedule-attr )
     1167       .
     1168       delete buf-del_schedule-attr.
     1169     end.
     1170     create tt-sched .
     1171     buffer-copy buf_schedule to tt-sched .
     1172     delete buf_schedule no-error.
     1173     if error-status:error then do:
     1174       v-mess = substitute("Ошибка при удалении: &1&2&3"
     1175                            , error-status:get-message(1)
     1176                            , chr(10)
     1177                            , return-value ).
     1178      run err-mess in this-procedure ( input-output v-mess) .
     1179      undo main-block, return error (if p-silent = yes then v-mess else '':U).
     1180     end.
     1181     v-shift-num = 0 .
     1182     v-shift-date = ? .
     1183     for first buf_shift-obj
     1184         where buf_shift-obj.obj-type = v-cntxt-obj-type
     1185           and buf_shift-obj.obj-code = v-cntxt-obj-code
     1186           and buf_shift-obj.status_ = 'тек':U
     1187         use-index stts :
     1188       assign
     1189         v-shift-date = buf_shift-obj.shift-date
     1190         v-shift-num  = buf_shift-obj.shift-num
     1191       .
     1192     end.
     1193     if v-shift-date = ? then v-shift-date = today .
     1194     run trg/userlog.p (
     1195             input 'schedule'
     1196           , input ("Удаление расписания автозаданий на объекте " +
     1197                   v-cntxt-obj-type + string(v-cntxt-obj-code) + ";" +
     1198                   tt-sched.task-type + ";" +
     1199                   (if tt-sched.task-type = 'autofree':U then v-free-id else "0") + ";" +
     1200                     string(tt-sched.task-num) + "|" +
     1201                     (if tt-sched.active then "1" else "0") + "|" +
     1202                     tt-sched.task-year + "|" +
     1203                     tt-sched.task-month + "|" +
     1204                     tt-sched.task-day + "|" +
     1205                     tt-sched.task-weekday + "|" +
     1206                     tt-sched.task-hour + "|" +
     1207                     tt-sched.task-minute +
     1208                   chr(3) +
     1209                   v-cntxt-obj-type + chr(6) +
     1210                   string(v-cntxt-obj-code) + chr(6) +
     1211                   string(v-shift-date) + chr(6) +
     1212                   string(v-shift-num) + chr(6) +
     1213                   tt-sched.task-type + chr(6) +
     1214                   (if tt-sched.task-type = 'autofree':U then v-free-id else "0") + chr(6) +
     1215                   string(tt-sched.task-num) + chr(6) +
     1216                   (if tt-sched.active then "1" else "0") + chr(6) +
     1217                   tt-sched.task-year + chr(6) +
     1218                   tt-sched.task-month + chr(6) +
     1219                   tt-sched.task-day + chr(6) +
     1220                   tt-sched.task-weekday + chr(6) +
     1221                   tt-sched.task-hour + chr(6) +
     1222                   tt-sched.task-minute + chr(6) +
     1223                   "del" + chr(6) +
     1224                   tt-sched.db-num-char  )
     1225           , input ?
     1226           , input ?
     1227           , input ""
     1228           ) no-error.
     1229     if error-status :error
     1230     then do:
     1231         message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     1232     end.
     1233     delete tt-sched no-error .
     1234   end.
     1235   PROCEDURE err-mess:
     1236     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1237     CASE p-silent:
     1238       when yes then do:
     1239         assign
     1240         p-mess = substitute("Расписание БД &1 тип &2 задача &3:&4 &5"
     1241                            , buf_schedule.cre-db-num
     1242                            , buf_schedule.task-type
     1243                            , buf_schedule.task-num
     1244                            , chr(10)
     1245                            , p-mess)
     1246         .
     1247       end.
     1248       when no then do:
     1249         message
     1250         p-mess
     1251         view-as alert-box error .
     1252       end.
     1253     end.
     1254   END PROCEDURE.
