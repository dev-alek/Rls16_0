        1   DEFINE BUFFER find_sysconf FOR ub.sysconf.
        2   DEFINE BUFFER X_clients FOR ub.clients.
        3   DEFINE BUFFER X_curr-sysconf FOR ub.sysconf.
        4   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        5   define input  parameter parparentproc    as widget-handle no-undo.
        6   define input  parameter bttns            as character no-undo .
        7   define input  parameter p-lock-self-host as logical   no-undo .
        8   define input  parameter p-curr-host-code as integer   no-undo .
        9   define output parameter p-out-host-code  as integer   no-undo .
       10   define input-output parameter p-rid-list as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
