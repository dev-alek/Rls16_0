     3520       then do:
     3521         return no-apply.
     3522       end.
     3523       if p-upd-subject = 'sysconf':U then do:
     3524         run adm/config.w
     3525           (input  parParentProc
     3526           ,input  v-cntxt-host-code-obj
     3527           ,input  'ИЗМЕНЕНИЕ':U
     3528           ,input  no
     3529           ) no-error.
     3530         if error-status :error
     3531         then do:
     3532           return no-apply.
     3533         end.
     3534       end.
     3535       else do:
     3536         run adm/fin-def.w ( input parParentProc
     3537                           , input 'ИЗМЕНЕНИЕ':U
     3538                           , input X_sysconf.host-code
     3539                           , input (is-fin = "yes")
     3540                            ) no-error.
     3541       end.
     3542     END.
     3543   END CASE.
     3544   RUN Openbr IN THIS-PROCEDURE NO-ERROR.
     3545   END PROCEDURE.
     3546   PROCEDURE proc-b-lkp :
     3547   DEFINE INPUT PARAMETER p-lkp-subject AS CHARACTER NO-UNDO.
     3548   define variable v-ok    as logical   no-undo .
     3549   define variable v-recid as recid     no-undo .
     3550   define buffer buf_clients for ub.clients .
     3551   v-doc-rec = recid(X_sysconf).
     3552   CASE p-lkp-subject:
     3553     WHEN 'firm':U THEN DO:
     3554       find first buf_clients no-lock
     3555         where buf_clients.obj-type = 'орг':U
     3556           and buf_clients.obj-code = X_sysconf.host-code
     3557         no-error .
     3558       if not available buf_clients
     3559       then do:
     3560         message
     3561           vss-workfile vss-revision vss-description skip
     3562           substitute("Не найдена фирма с кодом &1", X_sysconf.host-code) skip
     3563           view-as alert-box error .
     3564         undo, return error .
     3565       end.
     3566   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3567   do:
     3568     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3569       (input  v-cntxt-db-num
     3570       ,input  v-cntxt-userid
     3571       ,input  0
     3572       ,input  'actn_client-reference_lookup':U
     3573       ,input  'global':U
     3574       ,input  0
     3575       ,input  '':U
     3576       ,input  0
     3577       ,input  0
     3578       ,input  0
     3579       ,input  0
     3580       ,input  true
     3581       ,output v-ok
     3582       )  .
     3583   end.
     3584       if v-ok <> true
     3585       then do:
     3586         undo, return error.
     3587       end.
     3588       v-recid = recid(buf_clients).
     3589       run ref/firmi.w
     3590         (input  parparentproc
     3591         ,input  'ПРОСМОТР':U
     3592         ,input  buf_clients.obj-code
     3593         ,input  buf_clients.grp-code
     3594         ,input  'sysconf':U
     3595         ,input-output v-recid
     3596         ) no-error .
     3597     END.
     3598     WHEN 'sysconf':U
     3599     or when "fin"
     3600     THEN DO:
     3601   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3602   do:
     3603     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3604       (input  v-cntxt-db-num
     3605       ,input  v-cntxt-userid
     3606       ,input  0
     3607       ,input  'actn_host-reference_lookup':U
     3608       ,input  'global':U
     3609       ,input  0
     3610       ,input  '':U
     3611       ,input  0
     3612       ,input  0
     3613       ,input  0
     3614       ,input  0
     3615       ,input  true
     3616       ,output v-ok
     3617       )  .
     3618   end.
     3619       if v-ok <> true
     3620       then do:
     3621         return no-apply.
     3622       end.
     3623       if p-lkp-subject = 'sysconf':U then do:
     3624         run adm/config.w
     3625           (input  parParentProc
     3626           ,input  X_sysconf.host-code
     3627           ,input  'ПРОСМОТР':U
     3628           ,input  no
     3629           ) no-error.
     3630       end.
     3631       else do:
     3632         run adm/fin-def.w ( input parParentProc
     3633                           , input 'ПРОСМОТР':U
     3634                           , input X_sysconf.host-code
     3635                           , input (is-fin = "yes")
     3636                            ) no-error.
     3637       end.
     3638     END.
     3639   END CASE.
     3640   if error-status :error
     3641   then do:
     3642     return no-apply.
     3643   end.
     3644   END PROCEDURE.
     3645   PROCEDURE update-br-sysconf-dependent :
     3646     do
     3647     on error undo, return error return-value
     3648     :
     3649       do with frame Dialog-Frame
     3650       :
     3651         if available ub.clients
     3652         then do:
     3653           assign
     3654             fi-object-list-description :screen-value = ub.clients.obj-name
     3655           .
     3656         end.
     3657         else do:
     3658           assign
     3659             fi-object-list-description :screen-value = '':U
     3660           .
     3661         end.
     3662       end.
     3663       OPEN QUERY BR-obj FOR EACH X_clients       WHERE X_clients.host-code = X_sysconf.host-code and X_clients.host-code > 0 NO-LOCK     BY X_clients.obj-type        BY X_clients.obj-code INDEXED-REPOSITION.
     3664     end.
     3665   END PROCEDURE.
     3666   FUNCTION get-curr-name RETURNS CHARACTER
     3667     ( input p-curr-code as integer ) :
     3668     do
     3669     on error undo, return error return-value
     3670     :
     3671       find first ub.currency no-lock
     3672         where ub.currency.curr-code = p-curr-code
     3673         no-error .
     3674       if available ub.currency
     3675       then do:
     3676         return ub.currency.curr-abbr.
     3677       end.
     3678       else do:
     3679         return chr(63).
     3680       end.
     3681     end.
     3682   END FUNCTION.
     3683   FUNCTION get-default-object RETURNS CHARACTER
     3684     ( input p-host-code as integer ) :
     3685     define variable v-obj-type as character no-undo .
     3686     define variable v-obj-code as integer no-undo .
     3687     run host-default-object
     3688       (input p-host-code
     3689       ,output v-obj-type
     3690       ,output v-obj-code
     3691       ) .
     3692     if v-obj-type <> ""
     3693     then do:
     3694       return substitute('&1 &2':u, v-obj-type, v-obj-code) .
     3695     end.
     3696     else do:
     3697       return "" .
     3698     end.
     3699   END FUNCTION.
     3700   FUNCTION get-host-available RETURNS CHARACTER
     3701     ( INPUT p-host-code AS integer ) :
     3702     define variable v-available-host as character no-undo .
     3703     run get-host-available-proc in this-procedure
     3704       (input p-host-code
     3705       ,output v-available-host
     3706       ) .
     3707     return v-available-host .
     3708   END FUNCTION.
     3709   FUNCTION get-host-name RETURNS CHARACTER
     3710     ( INPUT p-host-code AS integer ) :
     3711     define variable v-host-name as character no-undo .
     3712     run get-host-name-proc in this-procedure
     3713       (input  p-host-code
     3714       ,output v-host-name
     3715       ) .
     3716     return v-host-name .
     3717   END FUNCTION.
     3718   FUNCTION get-object-available RETURNS CHARACTER
     3719     ( INPUT p-obj-type AS CHARACTER, INPUT p-obj-code AS integer ) :
     3720     define variable v-available-object as character no-undo .
     3721     run get-object-available-proc in this-procedure
     3722       (input  p-obj-type
     3723       ,input  p-obj-code
     3724       ,output v-available-object
     3725       ) .
     3726     return v-available-object .
     3727   END FUNCTION.
