     3181   PROCEDURE get-host-name-proc :
     3182     define input  parameter p-host-code as integer   no-undo .
     3183     define output parameter p-host-name as character no-undo .
     3184     define buffer buf_clients for ub.clients .
     3185     do
     3186     on error undo, return error return-value
     3187     :
     3188       find first buf_clients no-lock
     3189         where buf_clients.obj-type = 'орг':U
     3190           and buf_clients.obj-code = p-host-code
     3191         no-error .
     3192       if available buf_clients
     3193       then do:
     3194         assign
     3195           p-host-name = (if buf_clients.stts = 0
     3196                          then buf_clients.obj-name
     3197                          else (substring (buf_clients.obj-name, 1, 20)
     3198                               + fill (" " , 20 - length (substring (buf_clients.obj-name, 1, 20)))
     3199                               + '---  УДАЛЕН  ---':U
     3200                               )
     3201                         )
     3202         .
     3203       end.
     3204     end.
     3205   END PROCEDURE.
