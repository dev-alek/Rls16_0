     1301         get-curr-name(X_sysconf.base-code) @ v-curr-name COLUMN-LABEL "Валюта" FORMAT "X(3)":U
     1302         entry (lookup (string(X_sysconf.purch-code), '1,2,3':U), 'выкуп,консигнация,ответственное хранение':U) COLUMN-LABEL "Тип!приобретения" FORMAT "X(12)":U
     1303         get-default-object(X_sysconf.host-code) @ v-default-object COLUMN-LABEL "Главн.объект!межфирм.перем."
     1304         get-host-available(X_sysconf.host-code) @ v-host-available COLUMN-LABEL "Доступна!для текущего пользователя" FORMAT "x(8)":U
     1305       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.81.
     1306   DEFINE FRAME Dialog-Frame
     1307        b-quit AT ROW 1 COL 1
     1308        B-mark AT ROW 1 COL 11
     1309        B-sel AT ROW 1 COL 21
     1310        b-add AT ROW 1 COL 31 WIDGET-ID 2
     1311        b-lkp AT ROW 1 COL 41
     1312        b-chg AT ROW 1 COL 51 WIDGET-ID 4
     1313        B-attr AT ROW 1 COL 61
     1314        b-obj-init AT ROW 1 COL 71 WIDGET-ID 6
     1315        B-hist AT ROW 1 COL 92
     1316        B-Help AT ROW 1 COL 95
     1317        BR-sysconf AT ROW 2.43 COL 1
     1318        B-obj AT ROW 11.43 COL 80
     1319        BR-obj AT ROW 12.48 COL 1
     1320        mark-num AT ROW 1 COL 12.6 COLON-ALIGNED NO-LABEL
     1321        fi-object-list-description AT ROW 11.52 COL 17.2 COLON-ALIGNED
     1322        SPACE(22.37) SKIP(9.84)
     1323       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1324            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1325            TITLE "Список <Своих> фирм системы"
     1326            CANCEL-BUTTON b-quit.
     1327   ASSIGN
     1328          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1329          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1330   ASSIGN
     1331          B-attr:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-attr:HANDLE.
     1332   ASSIGN
     1333          b-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-chg:HANDLE.
     1334   ASSIGN
     1335          b-lkp:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-lkp:HANDLE.
     1336   ASSIGN
     1337          BR-sysconf:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1338   ON GO OF FRAME Dialog-Frame
     1339   DO:
     1340     if ( available X_sysconf )
     1341     then do:
     1342       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1343       then do:
     1344         assign
     1345           v-rid-list = string( recid( X_sysconf ) )
     1346           p-out-host-code = X_sysconf.host-code
     1347         .
     1348       end.
     1349       ASSIGN
     1350       p-rid-list = v-rid-list.
     1351     end.
     1352   END.
     1353   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1354   DO:
     1355     APPLY "END-ERROR":U TO SELF.
     1356   END.
     1357   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1358   DO:
     1359     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1360     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1361   END.
     1362   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     1363   DO:
     1364     if not available X_sysconf then return no-apply.
     1365     if attr-option = '':U
     1366     then do:
     1367       run gbl/pop-up.p
     1368         (input  self:handle
     1369         ,input  no
     1370         ) no-error .
     1371     end.
     1372     if attr-option = '':U
     1373     then do:
     1374        return no-apply.
     1375     end.
     1376     run proc-b-attr in this-procedure
     1377       (input  attr-option
     1378       ,input  'орг':U
     1379       ,input  x_sysconf.host-code
     1380       ) no-error.
     1381     if error-status:error
     1382     then do:
     1383       assign
     1384         attr-option = '':U
     1385       .
     1386       return no-apply.
     1387     end.
     1388     assign
     1389       attr-option = '':U
     1390     .
     1391   END.
     1392   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1393   DO:
     1394     IF NOT AVAILABLE X_sysconf THEN RETURN NO-APPLY.
     1395     if upd-option = "":U then do:
     1396       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1397       if error-status :error then do: return no-apply. end.
     1398     end.
     1399     if upd-option = "":U then do:
     1400         return no-apply.
     1401     end.
     1402     RUN proc-b-chg IN THIS-PROCEDURE ( input upd-option) NO-ERROR.
     1403     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1404   END.
     1405   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1406   DO:
     1407     define variable v-loc-rid-list as character no-undo .
     1408     if available X_sysconf
     1409     then do:
     1410       run ref/cclihist.w
     1411         (input  parparentproc
     1412         ,input  0
     1413         ,input  '':U
     1414         ,input  0
     1415         ,input  '':U
     1416         ,input  'one':U
     1417         ,input  'орг':U
     1418         ,input  X_sysconf.host-code
     1419         ,input  ?
     1420         ,input  ?
     1421         ,input  '':U
     1422         ,input  '':U
     1423         ,input  g#db-num
     1424         ,input-output v-loc-rid-list
     1425         ) no-error .
     1426     end.
     1427   END.
     1428   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1429   DO:
     1430     DEFINE variable v-rec as recid no-undo.
     1431     if not available X_sysconf
     1432     then do:
     1433       return no-apply.
     1434     end.
     1435     if lkp-option = '':U then do:
     1436       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1437       if error-status:error then do: return no-apply. end.
     1438       if lkp-option = '':U then return no-apply.
     1439       run proc-b-lkp in this-procedure ( input lkp-option) no-error.
     1440       if error-status:error then do:
     1441         lkp-option = '':U.
     1442         return no-apply.
     1443       end.
     1444       lkp-option = '':U.
     1445     end.
     1446   END.
     1447   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1448   DO:
     1449   define variable loc#log as logical no-undo .
     1450   define variable v-num-entry7 as integer no-undo .
     1451   if not available X_sysconf then return no-apply.
     1452   assign
     1453     v-num-entry7 = lookup(string( recid(X_sysconf) ), v-rid-list )
     1454   .
     1455   if v-num-entry7 > 0
     1456   then do:
     1457     if p-lock-self-host = yes and X_sysconf.host-code = X_curr-sysconf.host-code
     1458     then do:
     1459       message
     1460         "Своя фирма уже выбрана - ее нельзя убрать из списка!"
     1461         view-as alert-box warning.
     1462       return no-apply.
     1463     end.
     1464     assign
     1465       entry(v-num-entry7, v-rid-list) = '':U
     1466       v-rid-list = replace( v-rid-list, chr(44) + chr(44), chr(44))
     1467     .
     1468   end.
     1469   else do:
     1470     assign
     1471       v-rid-list = v-rid-list
     1472                  + ( if v-rid-list = '':U
     1473                      then '':U
     1474                      else chr(44)
     1475                    )
     1476                  + string( recid( X_sysconf) )
     1477     .
     1478   end.
     1479   loc#log = br-sysconf:refresh() .
     1480   if last-event:function <> "MOUSE-SELECT-DBLCLICK"
     1481   then do:
     1482     assign
     1483       loc#log = br-sysconf:select-next-row()
     1484     .
     1485     run update-br-sysconf-dependent in this-procedure .
     1486   end.
     1487   if num-entries( v-rid-list ) = 0
     1488   then
     1489       hide mark-num in frame Dialog-Frame.
     1490   else
     1491       disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1492   apply "entry" to br-sysconf in frame Dialog-Frame.
     1493   END.
     1494   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     1495   DO:
     1496     run br-obj-show-object in this-procedure .
     1497   END.
     1498   ON CHOOSE OF b-obj-init IN FRAME Dialog-Frame
     1499   DO:
     1500     IF NOT AVAILABLE  X_sysconf THEN RETURN NO-APPLY.
     1501     run adm/obj-init.w ( input parparentproc
     1502                        , INPUT X_sysconf.host-code) NO-ERROR.
     1503   END.
     1504   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1505   DO:
     1506     assign
     1507     p-out-host-code =  ?
     1508      .
     1509   END.
     1510   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1511   DO:
     1512   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   if lookup(self :type
     1514            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1515            ) = 0
     1516   then do:
     1517     message
     1518       "$Workfile$"
     1519       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1520       "Интерфейсный элемент" self :name  skip
     1521       "Тип" self :type  skip
     1522       "Процедура" this-procedure :file-name skip
     1523       view-as alert-box .
     1524   end.
     1525   else do:
     1526     apply "entry":u to self  .
     1527     if focus :handle <> self :handle  then do:
     1528       return no-apply .
     1529     end.
     1530   end.
     1531   END.
     1532   ON DEFAULT-ACTION OF BR-obj IN FRAME Dialog-Frame
     1533   DO:
     1534     run br-obj-show-object in this-procedure .
     1535   END.
     1536   ON MOUSE-SELECT-DBLCLICK OF BR-sysconf IN FRAME Dialog-Frame
     1537   DO:
     1538      run br-mouse-select in this-procedure no-error.
     1539     if error-status:error then return no-apply.
     1540   END.
     1541   ON RETURN OF BR-sysconf IN FRAME Dialog-Frame
     1542   DO:
     1543       run br-return in this-procedure no-error.
     1544     if error-status:error then return no-apply.
     1545   END.
     1546   ON VALUE-CHANGED OF BR-sysconf IN FRAME Dialog-Frame
     1547   DO:
     1548     run update-br-sysconf-dependent in this-procedure .
     1549   END.
     1550   ON CHOOSE OF MENU-ITEM m_copy
     1551   DO:
     1552     assign
     1553       attr-option = 'КОПИРОВАНИЕ':U
     1554     .
     1555     apply "choose" to b-attr  in frame Dialog-Frame.
     1556   END.
     1557   ON CHOOSE OF MENU-ITEM m_fin
     1558   DO:
     1559       if not available X_sysconf
     1560       then do:
     1561         return no-apply.
     1562       end.
     1563        ASSIGN
     1564        lkp-option = "fin".
     1565        run proc-b-lkp IN THIS-PROCEDURE ( INPUT lkp-option) NO-ERROR.
     1566        ASSIGN
     1567        lkp-option = '':U.
     1568        IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1569   END.
     1570   ON CHOOSE OF MENU-ITEM m_firm
     1571   DO:
     1572     if not available X_sysconf
     1573     then do:
     1574       return no-apply.
     1575     end.
     1576      ASSIGN
     1577      lkp-option = 'firm':U.
     1578      run proc-b-lkp IN THIS-PROCEDURE ( INPUT lkp-option) NO-ERROR.
     1579      ASSIGN
     1580      lkp-option = '':U.
     1581      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1582   END.
     1583   ON CHOOSE OF MENU-ITEM m_lookup
     1584   DO:
     1585     assign
     1586       attr-option = 'ПРОСМОТР':U
     1587     .
     1588     apply "choose" to b-attr  in frame Dialog-Frame.
     1589   END.
     1590   ON CHOOSE OF MENU-ITEM m_sysconf
     1591   DO:
     1592     if not available X_sysconf
     1593     then do:
     1594       return no-apply.
     1595     end.
     1596      ASSIGN
     1597      lkp-option = 'sysconf':U.
     1598      run proc-b-lkp IN THIS-PROCEDURE ( INPUT lkp-option) NO-ERROR.
     1599      ASSIGN
     1600      lkp-option = '':U.
     1601      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1602   END.
     1603   ON CHOOSE OF MENU-ITEM m_upd-fin
     1604   DO:
     1605     if not available X_sysconf
     1606       then do:
     1607         return no-apply.
     1608       end.
     1609        ASSIGN
     1610        upd-option = "fin".
     1611        run proc-b-chg IN THIS-PROCEDURE ( INPUT upd-option) NO-ERROR.
     1612        ASSIGN
     1613        upd-option = '':U.
     1614        IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1615   END.
     1616   ON CHOOSE OF MENU-ITEM m_upd-firm
     1617   DO:
     1618       if not available X_sysconf
     1619       then do:
     1620         return no-apply.
     1621       end.
     1622        ASSIGN
     1623        upd-option = 'firm':U.
     1624        run proc-b-chg IN THIS-PROCEDURE ( INPUT upd-option) NO-ERROR.
     1625        ASSIGN
     1626        upd-option = '':U.
     1627        IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1628   END.
     1629   ON CHOOSE OF MENU-ITEM m_upd-sysconf
     1630   DO:
     1631     if not available X_sysconf
     1632     then do:
     1633       return no-apply.
     1634     end.
     1635     ASSIGN
     1636     upd-option = 'sysconf':U.
     1637     run proc-b-chg IN THIS-PROCEDURE ( INPUT upd-option) NO-ERROR.
     1638     ASSIGN
     1639     upd-option = '':U.
     1640     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1641   END.
     1642   ON CHOOSE OF MENU-ITEM m_update
     1643   DO:
     1644       assign
     1645     attr-option = 'ИЗМЕНЕНИЕ':U.
     1646     APPLY "CHOOSE" to b-attr  in frame Dialog-Frame.
     1647   END.
     1648   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1649   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1650   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1651   on INS of frame Dialog-Frame anywhere do:
     1652     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1653     return no-apply.
     1654   end.
     1655   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   on F3 of frame Dialog-Frame anywhere do:
     1657     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1658     return no-apply.
     1659   end.
     1660   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1662     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1663     return no-apply.
     1664   end.
     1665   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666   on F4 of frame Dialog-Frame anywhere do:
     1667     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     1668     return no-apply.
     1669   end.
     1670   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1671   on F2 of frame Dialog-Frame anywhere do:
     1672     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1673     return no-apply.
     1674   end.
     1675   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1676   on F2 of frame Dialog-Frame anywhere do:
     1677     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1678     return no-apply.
     1679   end.
     1680   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681     run mainmenu_getcntxt in parparentproc
     1682       (output v-cntxt-db-num
     1683       ,output v-cntxt-userid
     1684       ,output v-cntxt-level
     1685       ,output v-cntxt-host-code-obj
     1686       ,output v-cntxt-obj-type
     1687       ,output v-cntxt-obj-code
     1688       ,output v-cntxt-db-num-obj
     1689       ,output v-cntxt-is-admin
     1690       ) .
     1691   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1692   on help of frame Dialog-Frame
     1693   do:
     1694     run gbl/app_help.p
     1695       (input this-procedure :file-name
     1696       ,input ''
     1697       ,input ?
     1698       ) no-error.
     1699     if error-status :error then do:
     1700       message
     1701         "Ошибка при вызове помощи"
     1702         error-status :get-message(1)
     1703         view-as alert-box .
     1704     end.
     1705   end.
     1706   run minbtn-set in this-procedure .
     1707   on choose of b-help in frame Dialog-Frame
     1708   do:
     1709     apply "help":u to frame Dialog-Frame .
     1710   end.
     1711   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   procedure minbtn-set :
     1713       do
     1714           on error undo, return error return-value
     1715           :
     1716           define variable ii              as integer       no-undo .
     1717           define variable fh              as widget-handle no-undo .
     1718           define variable hh              as widget-handle no-undo .
     1719           define variable v-h             as handle        extent 4 no-undo .
     1720           define variable v-name-button   as character     no-undo .
     1721           define variable v-help-old-x    as decimal       no-undo .
     1722           define variable v-help-old-y    as decimal       no-undo .
     1723           define variable v-help-old-size as decimal       no-undo .
     1724           define variable v-frame-width   as decimal       no-undo .
     1725           define variable jj              as integer       no-undo .
     1726           do
     1727               on error undo, return error
     1728               :
     1729               assign
     1730                   v-frame-width = frame Dialog-Frame:width - 0.3
     1731                   fh            = frame Dialog-Frame:first-child
     1732                   hh            = fh:first-child
     1733                   ii            = 1
     1734                   .
     1735               do while valid-handle(hh):
     1736                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1737                   do:
     1738                       case lc(hh:name) :
     1739                           when "b-help" then
     1740                               do:
     1741                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1742                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1743                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1744                                   hh:TOOLTIP = "Помощь" .
     1745                                   v-help-old-x = hh:column .
     1746                                   v-help-old-y = hh:row    .
     1747                                   v-help-old-size = hh:width .
     1748                                   hh:width-chars = 2.5 .
     1749                               end.
     1750                           when "b-print" then
     1751                               do:
     1752                                   hh:load-image("cmp/b-print.bmp":u) .
     1753                                   hh:TOOLTIP = "Печать" .
     1754                                   v-h[ii] = hh:handle .
     1755                                   ii = ii + 1 .
     1756                                   hh:width-chars = 3 .
     1757                               end.
     1758                           when "b-history" or
     1759                           when "b-hist" then
     1760                               do:
     1761                                   hh:load-image("cmp/b-hist.bmp":u) .
     1762                                   hh:TOOLTIP = "История" .
     1763                                   v-h[ii] = hh:handle .
     1764                                   ii = ii + 1 .
     1765                                   hh:width-chars = 3 .
     1766                               end.
     1767                           when "b-sch" then
     1768                               do:
     1769                                   hh:load-image("cmp/b-sch.bmp":u) .
     1770                                   hh:TOOLTIP = "Установка Фильтра" .
     1771                                   v-h[ii] = hh:handle .
     1772                                   ii = ii + 1 .
     1773                                   hh:width-chars = 3 .
     1774                               end.
     1775                           when "b-hist-user" then
     1776                               do:
     1777                                   hh:load-image("cmp/b-hist.bmp":u) .
     1778                                   hh:TOOLTIP = "История пользователя" .
     1779                                   ii = ii + 1 .
     1780                               end.
     1781                       end case.
     1782                   end.
     1783                   hh = hh:next-sibling.
     1784               end.
     1785               b-help:column = v-frame-width - b-help:width-chars.
     1786               jj = 0.
     1787               repeat ii = 4 to 1 by -1 :
     1788                   if valid-handle (v-h[ii] ) then
     1789                   do:
     1790                       jj  = jj + 1 .
     1791                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1792                       v-h[ii]:row    = v-help-old-y .
     1793                   end.
     1794               end.
     1795           end.
     1796       end.
     1797   end procedure.
     1798   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1799   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1800   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1801   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1802   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1803   define variable v-diasize-current-frame-height as decimal   no-undo .
     1804   define variable v-diasize-change-size          as logical   no-undo .
     1805   define variable v-diasize-resize-button        as handle    no-undo .
     1806   define variable v-diasize-wndmax               as logical   no-undo .
     1807   define variable v-diasize-wndstore             as logical   no-undo .
     1808   define variable v-diasize-proc-name            as character no-undo .
     1809   define variable v-diasize-browse-handle        as handle    no-undo .
     1810   define variable v-diasize-browse-number        as integer   no-undo .
     1811   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1812   define temp-table temp-diasize-handle no-undo
     1813     field handle-value  as handle
     1814     field save-position as decimal
     1815     index xpk is primary unique handle-value
     1816     .
     1817   define temp-table temp-browse-handle no-undo
     1818     field browse-type   as character
     1819     field browse-number as integer
     1820     field browse-handle as handle
     1821     field original-size as decimal
     1822     index xpk is primary unique browse-type browse-number
     1823     index xie browse-type browse-handle
     1824   .
     1825   procedure diasize_change-height :
     1826     define input  parameter p-change-value  as decimal   no-undo .
     1827     define input  parameter p-move-resize   as logical   no-undo .
     1828     define variable v-field-group-handle    as handle    no-undo .
