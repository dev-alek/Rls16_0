     1105   procedure colwidth-write :
     1106     define buffer buf_rpt-option for ubflt.rpt-option .
     1107     do
     1108     on error undo, return error return-value
     1109     :
     1110       if v-colwidth-width-01-shadow <> v-colwidth-width-01
     1111       or v-colwidth-width-02-shadow <> v-colwidth-width-02
     1112       or v-colwidth-width-03-shadow <> v-colwidth-width-03
     1113       or v-colwidth-width-04-shadow <> v-colwidth-width-04
     1114       or v-colwidth-width-05-shadow <> v-colwidth-width-05
     1115       or v-colwidth-width-06-shadow <> v-colwidth-width-06
     1116       or v-colwidth-width-07-shadow <> v-colwidth-width-07
     1117       or v-colwidth-width-08-shadow <> v-colwidth-width-08
     1118       or v-colwidth-width-09-shadow <> v-colwidth-width-09
     1119       or v-colwidth-width-10-shadow <> v-colwidth-width-10
     1120       or v-colwidth-width-11-shadow <> v-colwidth-width-11
     1121       or v-colwidth-width-12-shadow <> v-colwidth-width-12
     1122       or v-colwidth-width-13-shadow <> v-colwidth-width-13
     1123       or v-colwidth-width-14-shadow <> v-colwidth-width-14
     1124       or v-colwidth-width-15-shadow <> v-colwidth-width-15
