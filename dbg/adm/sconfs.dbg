     1168             buf_rpt-option.param-decimal-18-value = v-colwidth-width-18
     1169             buf_rpt-option.param-decimal-19-value = v-colwidth-width-19
     1170             buf_rpt-option.param-decimal-20-value = v-colwidth-width-20
     1171           .
     1172         end.
     1173         assign
     1174           v-colwidth-width-01-shadow = v-colwidth-width-01
