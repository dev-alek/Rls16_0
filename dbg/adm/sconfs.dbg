     1126       or v-colwidth-width-17-shadow <> v-colwidth-width-17
     1127       or v-colwidth-width-18-shadow <> v-colwidth-width-18
     1128       or v-colwidth-width-19-shadow <> v-colwidth-width-19
     1129       or v-colwidth-width-20-shadow <> v-colwidth-width-20
     1130       then do:
     1131         do transaction
     1132         on error undo, return error return-value
     1133         :
     1134           find first buf_rpt-option exclusive-lock
     1135             where buf_rpt-option.rpt-name    = v-colwidth-program-name
     1136               and buf_rpt-option.rpt-code    = 'column-width':U
     1137               and buf_rpt-option.user-db-num = v-colwidth-db-num
     1138               and buf_rpt-option.user-id     = v-colwidth-user-id
     1139             no-error .
     1140           if not available buf_rpt-option
     1141           then do:
     1142             create buf_rpt-option .
     1143             assign
     1144               buf_rpt-option.rpt-name    = v-colwidth-program-name
     1145               buf_rpt-option.rpt-code    = 'column-width':U
     1146               buf_rpt-option.user-db-num = v-colwidth-db-num
     1147               buf_rpt-option.user-id     = v-colwidth-user-id
     1148             .
     1149           end.
     1150           assign
     1151             buf_rpt-option.param-decimal-01-value = v-colwidth-width-01
     1152             buf_rpt-option.param-decimal-02-value = v-colwidth-width-02
     1153             buf_rpt-option.param-decimal-03-value = v-colwidth-width-03
     1154             buf_rpt-option.param-decimal-04-value = v-colwidth-width-04
     1155             buf_rpt-option.param-decimal-05-value = v-colwidth-width-05
     1156             buf_rpt-option.param-decimal-06-value = v-colwidth-width-06
     1157             buf_rpt-option.param-decimal-07-value = v-colwidth-width-07
     1158             buf_rpt-option.param-decimal-08-value = v-colwidth-width-08
     1159             buf_rpt-option.param-decimal-09-value = v-colwidth-width-09
     1160             buf_rpt-option.param-decimal-10-value = v-colwidth-width-10
     1161             buf_rpt-option.param-decimal-11-value = v-colwidth-width-11
     1162             buf_rpt-option.param-decimal-12-value = v-colwidth-width-12
     1163             buf_rpt-option.param-decimal-13-value = v-colwidth-width-13
     1164             buf_rpt-option.param-decimal-14-value = v-colwidth-width-14
     1165             buf_rpt-option.param-decimal-15-value = v-colwidth-width-15
     1166             buf_rpt-option.param-decimal-16-value = v-colwidth-width-16
