     2058           or error-status :get-message(1) <> ""
     2059           then do:
     2060             undo move_block, retry move_block .
     2061           end.
     2062         end.
     2063         assign
     2064           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2065           no-error .
     2066         if error-status :error
     2067         or error-status :get-message(1) <> ""
     2068         then do:
     2069           undo move_block, retry move_block .
     2070         end.
     2071         assign
     2072           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2073           no-error .
     2074         if error-status :error
     2075         or error-status :get-message(1) <> ""
     2076         then do:
     2077           undo move_block, retry move_block .
     2078         end.
     2079         for each buf_temp-browse-handle
     2080           where buf_temp-browse-handle.browse-type = 'height':u
