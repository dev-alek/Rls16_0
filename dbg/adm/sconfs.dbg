     1010   procedure colwidth-read :
     1011     define input  parameter p-db-num       as integer   no-undo .
     1012     define input  parameter p-user-id      as character no-undo .
     1013     define input  parameter p-program-name as character no-undo .
     1014     define output parameter p-data-exist   as logical   no-undo .
     1015     define buffer buf_rpt-option for ubflt.rpt-option .
     1016     do
     1017     on error undo, return error return-value
     1018     :
     1019       assign
     1020         v-colwidth-db-num       = p-db-num
     1021         v-colwidth-user-id      = p-user-id
     1022         v-colwidth-program-name = p-program-name
     1023       .
     1024       find first buf_rpt-option no-lock
     1025         where buf_rpt-option.rpt-name    = p-program-name
     1026           and buf_rpt-option.rpt-code    = 'column-width':U
     1027           and buf_rpt-option.user-db-num = p-db-num
     1028           and buf_rpt-option.user-id     = p-user-id
     1029         no-error .
     1030       if available buf_rpt-option
     1031       then do:
     1032         assign
     1033           p-data-exist        = true
     1034           v-colwidth-width-01 = buf_rpt-option.param-decimal-01-value
