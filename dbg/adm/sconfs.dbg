     3246   PROCEDURE host-default-object :
     3247      define input parameter p-host-code as integer no-undo .
     3248      define output parameter p-obj-type as character no-undo .
     3249      define output parameter p-obj-code as integer no-undo .
     3250      define buffer buf_firm for ub.firm .
     3251      find first buf_firm no-lock
     3252        where buf_firm.firm-code = p-host-code
     3253        no-error .
     3254      if available buf_firm then do:
     3255        assign
     3256          p-obj-type = main-obj-type
     3257          p-obj-code = main-obj-code
     3258        .
     3259      end.
     3260   END PROCEDURE.
     3261   PROCEDURE MyEnable :
     3262   do
     3263   on error undo, return error return-value
     3264   :
     3265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3266     (input  'is-fin'
     3267     ,input  0
     3268     ,input  ''
     3269     ,input  0
     3270     ,input  ''
     3271     ,input  ''
     3272     ,input  ''
     3273     ,input  no
     3274     ,output is-fin
     3275     ,output is-fin-type
     3276     ) no-error .
     3277     if lookup('convert':U, bttns) > 0
     3278     then do:
     3279       run convert in this-procedure
     3280         (input 'in':U
     3281         ) no-error.
     3282     end.
     3283     if p-lock-self-host
     3284     then do:
     3285       if lookup(string(recid(X_curr-sysconf)), v-rid-list) = 0
     3286       then do:
     3287         assign
     3288           v-rid-list = (if v-rid-list = '':U
     3289                         then string(recid(X_curr-sysconf))
     3290                         else (string(recid(X_curr-sysconf))  + chr(44) + v-rid-list)
     3291                       )
     3292         .
     3293       end.
     3294     end.
     3295     if v-rid-list <> ""
     3296     then do:
     3297       find first find_sysconf no-lock
     3298         where recid(find_sysconf) = integer(entry(1, v-rid-list))
     3299         no-error.
     3300       if not avail find_sysconf
     3301       then do:
     3302         message
     3303         vss-workfile vss-revision vss-description skip
     3304         "Неверное значение параметра вызова v-rid-list" v-rid-list
     3305         view-as alert-box error .
     3306         return error.
     3307       end.
     3308       assign
     3309         v-doc-rec = integer(entry(1, v-rid-list))
     3310       .
     3311     end.
     3312     assign
     3313     b-attr:MENU-MOUSE in frame Dialog-Frame = 1
     3314     b-lkp:MENU-MOUSE in frame Dialog-Frame = 1
     3315     b-chg:MENU-MOUSE in frame Dialog-Frame = 1
     3316    .
     3317     assign
     3318     menu-item m_update :sensitive in menu menu-b-attr = (g#db-num = 0
     3319                                                         and lookup('b-attr-update':U, bttns) > 0
     3320                                                         )
     3321     menu-item m_copy   :sensitive in menu menu-b-attr = (g#db-num = 0
     3322                                                         and lookup('b-attr-copy':U, bttns) > 0
     3323                                                         )
     3324     menu-item m_lookup :sensitive in menu menu-b-attr = true
     3325     menu-item m_upd-fin:sensitive in menu menu-b-chg = g#db-num = 0
     3326     menu-item m_fin:sensitive in menu menu-b-lkp = yes
     3327     menu-item m_upd-firm:sensitive in menu menu-b-chg = (g#db-num = 0)
     3328     menu-item m_upd-sysconf:sensitive in menu menu-b-chg = (g#db-num = 0)
     3329     .
     3330     enable
     3331     b-quit
     3332     b-sel  when lookup('b-sel':u, bttns)  > 0
     3333     b-mark when lookup('b-mark':u, bttns) > 0
     3334     b-attr
     3335     b-lkp
     3336     b-ADD when lookup('b-add':u, bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION
     3337     b-chg when lookup('b-add':u, bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION
     3338     b-help
     3339     br-sysconf
     3340     br-obj
     3341     b-obj
     3342     b-hist
     3343     b-obj-init when NOT TRANSACTION
     3344     with frame Dialog-Frame.
     3345     view frame Dialog-Frame.
     3346     hide
     3347     mark-num
     3348     in frame Dialog-Frame .
     3349     RUN Openbr IN THIS-PROCEDURE NO-ERROR.
     3350   end.
     3351   END PROCEDURE.
     3352   PROCEDURE Openbr :
     3353   OPEN QUERY BR-sysconf FOR EACH X_sysconf NO-LOCK INDEXED-REPOSITION.
     3354     if available X_sysconf
     3355     then do:
     3356       OPEN QUERY BR-obj FOR EACH X_clients       WHERE X_clients.host-code = X_sysconf.host-code and X_clients.host-code > 0 NO-LOCK     BY X_clients.obj-type        BY X_clients.obj-code INDEXED-REPOSITION.
     3357     end.
     3358     if v-doc-rec <> ?
     3359     then do:
     3360       reposition br-sysconf to recid v-doc-rec no-error.
     3361     end.
     3362     apply 'entry':U to br-sysconf in frame Dialog-Frame .
     3363     run update-br-sysconf-dependent in this-procedure .
     3364   END PROCEDURE.
