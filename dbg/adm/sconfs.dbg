     2426         end.
     2427         assign
     2428           v-field-group-handle = v-field-group-handle :next-sibling
     2429         .
     2430       end.
     2431       do with frame Dialog-Frame
     2432       :
     2433         hide v-diasize-resize-button .
     2434         v-diasize-resize-button :row = 1.
     2435         v-diasize-resize-button :column = 1.
     2436       end.
     2437       if p-change-value > 0
     2438       then do:
     2439         if frame Dialog-Frame :scrollable = true
     2440         then do:
     2441           assign
     2442             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2443             no-error .
     2444           if error-status :error
     2445           or error-status :get-message(1) <> ""
     2446           then do:
     2447             undo move_block, retry move_block.
     2448           end.
     2449         end.
     2450         assign
     2451           frame Dialog-Frame :width = v-frame-width + p-change-value
     2452           no-error .
     2453         if error-status :error
     2454         or error-status :get-message(1) <> ""
     2455         then do:
     2456           undo move_block, retry move_block.
     2457         end.
     2458         assign
     2459           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2460         no-error .
     2461         if error-status :error
     2462         or error-status :get-message(1) <> ""
     2463         then do:
     2464           undo move_block, retry move_block.
     2465         end.
     2466         for each buf_temp-browse-handle
     2467           where buf_temp-browse-handle.browse-type = 'width':u
     2468         on error undo move_block, retry move_block
     2469         :
     2470           assign
     2471             buf_temp-browse-handle.browse-handle :width
     2472               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2473             no-error .
     2474           if error-status :error
     2475           or error-status :get-message(1) <> ""
     2476           then do:
     2477             undo move_block, retry move_block .
     2478           end.
     2479         end.
     2480         for each buf_temp-diasize-handle
     2481         on error undo move_block, retry move_block
     2482         :
     2483           assign
     2484             v-object-handle = buf_temp-diasize-handle.handle-value
     2485           .
     2486           if v-object-handle <> v-diasize-resize-button
     2487           then do:
     2488             assign
     2489               v-object-handle :col = v-object-handle :col + p-change-value
     2490               no-error .
     2491             if error-status :error
     2492             or error-status :get-message(1) <> ""
     2493             then do:
     2494               undo move_block, retry move_block .
     2495             end.
     2496           end.
     2497         end.
     2498       end.
     2499       else do:
     2500         for each buf_temp-diasize-handle
     2501         on error undo move_block, retry move_block
     2502         :
     2503           assign
     2504             v-object-handle = buf_temp-diasize-handle.handle-value
     2505           .
     2506           if v-object-handle <> v-diasize-resize-button
     2507           then do:
     2508             assign
     2509               v-object-handle :col = v-object-handle :col + p-change-value
     2510               no-error .
     2511             if error-status :error
     2512             or error-status :get-message(1) <> ""
     2513             then do:
     2514               undo move_block, retry move_block .
     2515             end.
     2516           end.
     2517         end.
     2518         for each buf_temp-browse-handle
     2519           where buf_temp-browse-handle.browse-type = 'width':u
     2520         on error undo move_block, retry move_block
     2521         :
     2522           assign
     2523             buf_temp-browse-handle.browse-handle :width
     2524               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2525             no-error .
     2526           if error-status :error
     2527           or error-status :get-message(1) <> ""
     2528           then do:
     2529             undo move_block, retry move_block .
     2530           end.
     2531         end.
     2532         assign
     2533           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2534           no-error .
     2535         if error-status :error
     2536         or error-status :get-message(1) <> ""
     2537         then do:
     2538           undo move_block, retry move_block.
     2539         end.
     2540         assign
     2541           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2542         no-error .
     2543         if error-status :error
     2544         or error-status :get-message(1) <> ""
     2545         then do:
     2546           undo move_block, retry move_block.
     2547         end.
     2548         if frame Dialog-Frame :scrollable = true
     2549         then do:
     2550           assign
     2551             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2552           no-error .
     2553           if error-status :error
     2554           or error-status :get-message(1) <> ""
     2555           then do:
     2556             undo move_block, retry move_block.
     2557           end.
     2558         end.
     2559       end.
     2560       if p-move-resize
     2561       then do:
     2562         run diasize_position-resize-button in this-procedure .
     2563       end.
     2564       if v-diasize-wndstore = true
     2565       then do:
     2566         if connected("ub") = true
     2567         then do:
     2568           define variable v-cntxt-db-num        as integer   no-undo .
     2569           define variable v-cntxt-userid        as character no-undo .
     2570           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2571                                             , OUTPUT v-cntxt-userid
     2572                                             ) .
     2573           run gbl/wndsizew.p
     2574             (input  v-cntxt-db-num
     2575             ,input  v-cntxt-userid
     2576             ,input  v-diasize-proc-name
     2577             ,input  'width':u
     2578             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2579             ) .
     2580         end.
     2581       end.
     2582     end.
     2583     assign
     2584       v-diasize-change-size = false
     2585     .
     2586   end procedure.
     2587   procedure diasize_set-width :
     2588     define input  parameter p-new-width  as decimal   no-undo .
     2589     define input  parameter p-move-resize as logical   no-undo .
     2590     do
     2591     on error undo, return error return-value
     2592     :
     2593       run diasize_change-width in this-procedure
     2594         (input  (p-new-width - frame Dialog-Frame :width)
     2595         ,input  p-move-resize
     2596         ) .
     2597     end.
     2598   end procedure.
     2599   procedure diasize_position-resize-button :
     2600     do with frame Dialog-Frame
     2601     :
     2602       hide v-diasize-resize-button .
     2603       assign
     2604         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2605                     - 1
     2606                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2607         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2608                     - 1
     2609                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2610       .
     2611       view v-diasize-resize-button .
     2612     end.
     2613   end procedure.
     2614   on alt-right anywhere
     2615   do:
     2616     run diasize_change-width in this-procedure
     2617       (input 1
     2618       ,input true
     2619       ) .
     2620     return no-apply .
     2621   end.
     2622   on alt-left anywhere
     2623   do:
     2624     run diasize_change-width in this-procedure
     2625       (input -1
     2626       ,input true
     2627       ) .
     2628     return no-apply .
     2629   end.
     2630   on alt-down anywhere
     2631   do:
     2632     run diasize_change-height in this-procedure
     2633       (input 1
     2634       ,input true
     2635       ) .
     2636     return no-apply .
     2637   end.
     2638   on alt-up anywhere
     2639   do:
     2640     run diasize_change-height in this-procedure
     2641       (input -1
     2642       ,input true
     2643       ) .
     2644     return no-apply .
     2645   end.
     2646   on alt-enter of frame Dialog-Frame
     2647   do:
     2648     run diasize_maximize in this-procedure
     2649       (input  ?
     2650       ).
     2651     return no-apply .
     2652   end.
     2653   procedure diasize_end-move :
     2654     do
     2655     on error undo, return error return-value
     2656     :
     2657       define variable v-row-delta as decimal   no-undo .
     2658       define variable v-col-delta as decimal   no-undo .
     2659       define variable v-new-row as decimal   no-undo .
     2660       define variable v-new-col as decimal   no-undo .
     2661       assign
     2662         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2663         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2664       .
     2665       assign
     2666         v-row-delta = v-new-row - frame Dialog-Frame :height
     2667         v-col-delta = v-new-col - frame Dialog-Frame :width
     2668       .
     2669       run diasize_change-height in this-procedure
     2670         (input v-row-delta
     2671         ,input true
     2672         ) .
     2673       run diasize_change-width in this-procedure
     2674         (input v-col-delta
     2675         ,input true
     2676         ) .
     2677     end.
     2678   end procedure.
     2679   procedure diasize_maximize :
     2680     define input  parameter p-action as logical   no-undo .
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       if p-action = ?
     2685       then do:
     2686         if v-diasize-need-maximize = true
     2687         then do:
     2688           assign
     2689             p-action = true
     2690           .
     2691         end.
     2692         else do:
     2693           assign
     2694             p-action = false
     2695           .
     2696         end.
     2697       end.
     2698       if p-action = true
     2699       then do:
     2700         run diasize_change-height in this-procedure
     2701           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2702               - frame Dialog-Frame :height-chars
     2703           ,input true
     2704           ) .
     2705         run diasize_change-width in this-procedure
     2706           (input session :width-chars
     2707               - frame Dialog-Frame :width-chars
     2708           ,input true
     2709           ) .
     2710         assign
     2711           v-diasize-need-maximize = false
     2712         .
     2713       end.
     2714       else do:
     2715         run diasize_change-width in this-procedure
     2716           (input v-diasize-orig-frame-width
     2717               - frame Dialog-Frame :width-chars
     2718           ,input true
     2719           ) .
     2720         run diasize_change-height in this-procedure
     2721           (input v-diasize-orig-frame-height
     2722               - frame Dialog-Frame :height-chars
     2723           ,input true
     2724           ) .
     2725         assign
     2726           v-diasize-need-maximize = true
     2727         .
     2728       end.
     2729     end.
     2730   end procedure.
     2731   procedure diasize_restore-orig-size :
     2732     do
     2733     on error undo, return error return-value
     2734     :
     2735       assign
     2736         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2737         v-diasize-current-frame-height = frame Dialog-Frame :height
     2738       .
     2739       run diasize_set-height in this-procedure
     2740         (input  v-diasize-orig-frame-height
     2741         ,input  true
     2742         ) .
     2743       run diasize_set-width in this-procedure
     2744         (input  v-diasize-orig-frame-width
     2745         ,input  true
     2746         ) .
     2747     end.
     2748   end procedure.
     2749   procedure diasize_restore-current-size :
     2750     do
     2751     on error undo, return error return-value
     2752     :
     2753       run diasize_set-height in this-procedure
     2754         (input  v-diasize-current-frame-height
     2755         ,input  true
     2756         ) .
     2757       run diasize_set-width in this-procedure
     2758         (input  v-diasize-current-frame-width
     2759         ,input  true
     2760         ) .
     2761     end.
     2762   end procedure.
     2763   procedure diasize_set-browse-handle :
     2764     define input  parameter p-browse-handle as handle   no-undo .
     2765     define buffer buf_temp-browse-handle for temp-browse-handle .
     2766     do
     2767     on error undo, return error return-value
     2768     :
     2769       assign
     2770         v-diasize-browse-handle = p-browse-handle
     2771       .
     2772       for each buf_temp-browse-handle
     2773       on error undo, return error return-value
     2774       :
     2775         delete buf_temp-browse-handle .
     2776       end.
     2777     end.
     2778   end procedure.
     2779   procedure diasize_add_browse :
     2780     define input  parameter p-browse-type   as character no-undo .
     2781     define input  parameter p-browse-handle as handle    no-undo .
     2782     define buffer buf_temp-browse-handle for temp-browse-handle .
     2783     do
     2784     on error undo, return error return-value
     2785     :
     2786       assign
     2787         v-diasize-browse-number = v-diasize-browse-number + 1
     2788       .
     2789       create buf_temp-browse-handle .
     2790       assign
     2791         buf_temp-browse-handle.browse-type   = p-browse-type
     2792         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2793         buf_temp-browse-handle.browse-handle = p-browse-handle
     2794       .
     2795     end.
     2796   end procedure.
     2797   procedure diasize_init :
     2798     define variable v-default-value    as logical   no-undo .
     2799     define variable v-restore-saved    as logical   no-undo .
     2800     define variable v-resize-value-str as character no-undo .
     2801     do
     2802     on error undo, return error return-value
     2803     :
     2804       do with frame Dialog-Frame
     2805       :
     2806         assign
     2807           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2808           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2809           v-diasize-browse-handle     = browse br-sysconf :handle
     2810         .
     2811         create button v-diasize-resize-button
     2812         assign
     2813           parent        = frame Dialog-Frame :first-child
     2814           label         = "s"
     2815           height-pixels = 16
     2816           width-pixels  = 16
     2817           visible       = true
     2818           sensitive     = true
     2819           movable       = true
     2820           triggers:
     2821             on end-move persistent run diasize_end-move in this-procedure .
     2822           end triggers.
     2823         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2824         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2825         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2826         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2827         assign
     2828           v-diasize-wndmax = false
     2829         .
     2830         if connected("ub") = true
     2831         then do:
     2832           define variable v-cntxt-db-num        as integer   no-undo .
     2833           define variable v-cntxt-userid        as character no-undo .
     2834           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2835                                             , OUTPUT v-cntxt-userid
     2836                                             ) .
     2837           run gbl/wndpar_r.p
     2838             (input  v-cntxt-db-num
     2839             ,input  v-cntxt-userid
     2840             ,input  'wndmax':U
     2841             ,output v-diasize-wndmax
     2842             ,output v-default-value
     2843             ) .
     2844         end.
     2845         assign
     2846           v-diasize-wndstore = false
     2847         .
     2848         if connected("ub") = true
     2849         then do:
     2850           run gbl/wndpar_r.p
     2851             (input  v-cntxt-db-num
     2852             ,input  v-cntxt-userid
     2853             ,input  'wndstore':U
     2854             ,output v-diasize-wndstore
     2855             ,output v-default-value
     2856             ) .
     2857         end.
     2858         assign
     2859           v-diasize-proc-name = entry(1, program-name(2), '.')
     2860         .
     2861         if v-diasize-wndstore = true
     2862         then do:
     2863           assign
     2864             v-restore-saved = false
     2865           .
     2866           if connected("ub") = true
     2867           then do:
     2868             run gbl/wndsizer.p
     2869               (input  v-cntxt-db-num
     2870               ,input  v-cntxt-userid
     2871               ,input  v-diasize-proc-name
     2872               ,input  'height':u
     2873               ,output v-resize-value-str
     2874               ) .
     2875             if v-resize-value-str <> '':U
     2876             then do:
     2877               run diasize_change-height in this-procedure
     2878                 (input  integer(v-resize-value-str)
     2879                 ,input  true
     2880                 ) .
     2881               assign
     2882                 v-restore-saved = true
     2883               .
     2884             end.
     2885           end.
     2886           if connected("ub") = true
     2887           then do:
     2888             run gbl/wndsizer.p
     2889               (input  v-cntxt-db-num
     2890               ,input  v-cntxt-userid
     2891               ,input  v-diasize-proc-name
     2892               ,input  'width':u
     2893               ,output v-resize-value-str
     2894               ) .
     2895             if v-resize-value-str <> '':U
     2896             then do:
     2897               run diasize_change-width in this-procedure
     2898                 (input  integer(v-resize-value-str)
     2899                 ,input  true
     2900                 ) .
     2901               assign
     2902                 v-restore-saved = true
     2903               .
     2904             end.
     2905           end.
     2906           if v-restore-saved <> true
     2907           then do:
     2908             if v-diasize-wndmax = true
     2909             then do:
     2910               run diasize_maximize in this-procedure
     2911                 (input  true
     2912                 ) .
     2913             end.
     2914           end.
     2915         end.
     2916         else do:
     2917           if v-diasize-wndmax = true
     2918           then do:
     2919             run diasize_maximize in this-procedure
     2920               (input  true
     2921               ) .
     2922           end.
     2923         end.
     2924       end.
     2925     end.
     2926   end procedure.
     2927   procedure diasize_need-full-display :
     2928     define output parameter p-need-full-display as logical   no-undo .
     2929     do
     2930     on error undo, return error return-value
     2931     :
     2932       assign
     2933         p-need-full-display = v-diasize-need-full-display
     2934       .
     2935       assign
     2936         v-diasize-need-full-display = false
     2937       .
     2938     end.
     2939   end procedure.
     2940   procedure get-context :
     2941      define output parameter p-db-num as integer          no-undo.
     2942      define output parameter p-user-id as character        no-undo.
     2943      define variable v-login               as character    no-undo.
     2944      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2945      define buffer buf_user-login  for ub.user-login .
     2946      do
     2947      on error undo, return error
     2948      :
     2949            FIND FIRST buf_sys-ctrl no-lock.
     2950            ASSIGN
     2951               v-login = USERID("ub")
     2952               p-db-num = buf_sys-ctrl.db-num
     2953            .
     2954            FIND FIRST buf_user-login
     2955                 WHERE buf_user-login.db-num = p-db-num
     2956                   AND buf_user-login.user-login = v-login
     2957                 no-lock
     2958                 no-error
     2959                 .
     2960            IF AVAILABLE buf_user-login
     2961            THEN DO:
     2962               assign
     2963                  p-user-id = buf_user-login.user-id
     2964               .
     2965            END.
     2966      end.
     2967   end procedure.
     2968   run diasize_add_browse in this-procedure
     2969     (input  'width':u
     2970     ,input  browse br-obj :handle
     2971     ) .
     2972   run diasize_init in this-procedure .
     2973   p-out-host-code = ? .
     2974   MAIN-BLOCK:
     2975   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2976      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2977   :
     2978     find first X_curr-sysconf no-lock
     2979       where X_curr-sysconf.host-code = p-curr-host-code
     2980       no-error .
     2981     if not available X_curr-sysconf
     2982     and p-lock-self-host = yes
     2983     then do:
     2984       message
     2985         vss-workfile vss-revision vss-description skip
     2986         "Неверное значение параметра вызова p-curr-host-code и p-lock-seld-host"
     2987         p-curr-host-code skip
     2988         view-as alert-box error.
     2989       undo, return error return-value .
     2990     end.
     2991     v-rid-list = p-rid-list.
     2992     assign
     2993       v-host-name        :resizable in browse br-sysconf = true
     2994       x_sysconf.branch   :resizable in browse br-sysconf = true
     2995       x_clients.obj-name :resizable in browse br-obj     = true
     2996     .
     2997     define variable v-colwidth-data-exist as logical   no-undo .
     2998   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2999   run colwidth-read in this-procedure
     3000     (input  v-cntxt-db-num
     3001     ,input  v-cntxt-userid
     3002     ,input  'adm/sconfs.w':U
     3003     ,output v-colwidth-data-exist
     3004     )  .
     3005     if v-colwidth-data-exist = true
     3006     then do:
     3007       assign
     3008         v-host-name        :width in browse br-sysconf = v-colwidth-width-01
     3009         x_sysconf.branch   :width in browse br-sysconf = v-colwidth-width-02
     3010         x_clients.obj-name :width in browse br-obj     = v-colwidth-width-03
     3011       .
     3012     end.
     3013     else do:
     3014       assign
     3015         v-host-name        :width in browse br-sysconf = 25
     3016         x_sysconf.branch   :width in browse br-sysconf = 25
     3017         x_clients.obj-name :width in browse br-obj     = 25
     3018       .
     3019     end.
     3020     run myenable in this-procedure .
     3021     wait-for go of frame Dialog-Frame.
     3022     if lookup('convert':u, bttns) > 0
     3023     then do:
     3024       run convert in this-procedure
     3025         (input 'out':u
     3026         ) no-error .
     3027     end.
     3028   END.
     3029   assign
     3030     v-colwidth-width-01 = v-host-name        :width in browse br-sysconf
     3031     v-colwidth-width-02 = x_sysconf.branch   :width in browse br-sysconf
     3032     v-colwidth-width-03 = x_clients.obj-name :width in browse br-obj
     3033   .
     3034   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3035   run colwidth-write in this-procedure
     3036     .
     3037   RUN disable_UI.
     3038   PROCEDURE br-mouse-select :
     3039   if b-sel:sensitive in frame Dialog-Frame then do:
     3040     if b-mark:sensitive then do:
     3041         apply "choose" to b-mark in frame Dialog-Frame.
     3042     end.
     3043     else do:
     3044         apply "choose" to b-sel in frame Dialog-Frame.
     3045     end.
     3046   end.
     3047   else do:
     3048     if b-lkp:sensitive then
     3049         apply "choose" to b-lkp in frame Dialog-Frame.
     3050   end.
     3051   END PROCEDURE.
     3052   PROCEDURE br-obj-show-object :
     3053     do
     3054     on error undo, return error return-value
     3055     :
     3056       if available x_clients
     3057       then do:
     3058         run ref/showcli.p
     3059           (input parparentproc
     3060           ,input x_clients.obj-type
     3061           ,input x_clients.obj-code
     3062           ) no-error.
     3063       end.
     3064     end.
     3065   END PROCEDURE.
     3066   PROCEDURE br-return :
     3067   if b-sel:sensitive in frame Dialog-Frame then do:
     3068       apply "choose" to b-sel in frame Dialog-Frame.
     3069   end.
     3070   else do:
     3071       if b-lkp:sensitive then
     3072           apply "choose" to b-lkp in frame Dialog-Frame.
     3073   end.
     3074   END PROCEDURE.
     3075   PROCEDURE convert :
     3076     define input parameter p-convert-mode as character no-undo.
     3077     define variable v-list as character no-undo .
     3078     define variable v-ind  as integer   no-undo .
     3079     define buffer buf_sysconf for ub.sysconf.
     3080     do
     3081     on error undo, return error return-value
     3082     :
     3083       case p-convert-mode
     3084       :
     3085         when 'in':U
     3086         then do:
     3087           do v-ind = 1 to num-entries(v-rid-list)
     3088           :
     3089             find first buf_sysconf no-lock
     3090               where buf_sysconf.host-code = integer(entry(v-ind, v-rid-list))
     3091               no-error.
     3092             if available buf_sysconf
     3093             then do:
     3094               assign
     3095                 v-list = v-list
     3096                        + (if v-list = '':U
     3097                           then '':U
     3098                           else chr(44)
     3099                          )
     3100                        + string(recid(buf_sysconf))
     3101               .
     3102             end.
     3103           end.
     3104         end.
     3105         when 'out':U
     3106         then do:
     3107           do v-ind = 1 to num-entries(v-rid-list)
     3108           :
     3109             find first buf_sysconf no-lock
     3110               where recid(buf_sysconf) = integer(entry(v-ind, v-rid-list))
     3111               no-error .
     3112             if available buf_sysconf
     3113             then do:
     3114               assign
     3115                 v-list = v-list
     3116                         + (if v-list = '':U
     3117                           then '':U
     3118                           else chr(44)
     3119                           )
     3120                         + string(buf_sysconf.host-code)
     3121               .
     3122             end.
     3123           end.
     3124         end.
     3125       end case.
     3126       assign
     3127         v-rid-list = v-list
     3128       .
     3129     end.
     3130   END PROCEDURE.
     3131   PROCEDURE disable_UI :
     3132     HIDE FRAME Dialog-Frame.
     3133   END PROCEDURE.
     3134   PROCEDURE enable_UI :
     3135     DISPLAY mark-num fi-object-list-description
     3136         WITH FRAME Dialog-Frame.
     3137     ENABLE b-quit B-mark B-sel b-add b-lkp b-chg B-attr b-obj-init B-hist B-Help
     3138            BR-sysconf B-obj BR-obj mark-num fi-object-list-description
     3139         WITH FRAME Dialog-Frame.
     3140     VIEW FRAME Dialog-Frame.
     3141     OPEN QUERY BR-obj FOR EACH X_clients       WHERE X_clients.host-code = X_sysconf.host-code and X_clients.host-code > 0 NO-LOCK     BY X_clients.obj-type        BY X_clients.obj-code INDEXED-REPOSITION.    OPEN QUERY BR-sysconf FOR EACH X_sysconf NO-LOCK INDEXED-REPOSITION.
     3142   END PROCEDURE.
