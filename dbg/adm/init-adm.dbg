        1   block-level on error undo, throw.
        2   define input  parameter inst     as logical   no-undo .
        3   define input  parameter p-db-num as integer   no-undo .
        4   define input  parameter p-create-adm as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: 4886e87b5a2b, 3169, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        7   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:23 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: init-adm.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: adm/init-adm.p $":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   do
       70   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       71   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       72   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       73   :
       74     for each dictdb._user
       75     on error undo, return error return-value
       76     :
       77       if dictdb._user._userid = 'sysadm':u
       78       or dictdb._user._userid = 'odbc':u
       79       or dictdb._user._userid = 'usr-flt':u
       80       then do:
       81         next.
       82       end.
       83       find first dictdb.user-login
       84         where dictdb.user-login.db-num   = p-db-num
       85           and dictdb.user-login.user-login = dictdb._user._userid
       86         no-error .
       87       if not available dictdb.user-login
       88       then do:
       89         message "В БД найдена запись о пользователе системы с именем:"
       90                 DICTDB._user._userid skip
       91                 "Это имя не является пользовательским для входа в систему IBS Trade House. Уничтожаем."
       92                 view-as alert-box.
       93         delete DICTDB._user.
       94       end.
       95     end.
       96     find first dictdb._user
       97       where dictdb._user._userid = "odbc":u
       98       no-error .
       99     if available dictdb._user
      100     then do:
      101       find first dictdb.user-login
      102         where dictdb.user-login.db-num   = p-db-num
      103           and dictdb.user-login.user-login = 'odbc':u
      104         no-error .
      105       if available dictdb.user-login
      106       then do:
      107         message
      108           "В БД найдена запись о пользователе системы с именем 'odbc'." skip
      109           "Это имя не может принадлежать пользователю системы,"
      110           "оно должно быть зарезервировано для connect из внешних приложений через ODBC." skip(2)
      111           "Необходимо создать пользователя PROGRESS для connect из внешних приложений с именем 'odbc', паролем 'odbc'." skip
      112           view-as alert-box error .
      113         return error.
      114       end.
      115     end.
      116     else do:
      117       message
      118         "В БД отсутствует пользователь PROGRESS с именем 'odbc',"
      119         "которое зарезервировано для connect внешних приложений через ODBC." skip
      120         "Дальнейшая инициализация данной БД невозможна!!!" skip
      121         view-as alert-box error.
      122       return error .
      123     end.
      124     find first dictdb._user
      125       where dictdb._user._userid = 'sysadm':u
      126       no-error .
      127     if available dictdb._user then do:
      128       find first dictdb.user-login
      129         where dictdb.user-login.db-num   = p-db-num
      130           and dictdb.user-login.user-login = 'sysadm':U
      131         no-error .
      132       if available DICTDB.user-login
      133       then do:
      134         message
      135           "В БД найдена запись о пользователе системы с именем 'sysadm'." skip
      136           "Это имя не может принадлежать пользователю системы,"
      137           "оно должно быть зарезервировано для connect из PROGRESS Procedure Editor." skip
      138           view-as alert-box error .
      139         return error.
      140       end.
      141     end.
      142     IF p-create-adm THEN DO:
      143      DEFINE VARIABLE v-encode-value AS CHARACTER NO-UNDO .
      144      define variable v-user-id      as character no-undo .
      145      disable triggers for  load   of dictdb.user-login .
      146      disable triggers for  load   of dictdb.user-account .
      147      FIND FIRST dictdb.user-login
      148           WHERE dictdb.user-login.db-num     = p-db-num
      149             AND dictdb.user-login.user-login = "адм":U
      150            exclusive-LOCK
      151            NO-ERROR
      152            no-wait.
      153      IF NOT AVAILABLE dictdb.user-login then do:
      154         IF LOCKED dictdb.user-login THEN DO:
      155         END.
      156         find first dictdb.user-account
      157              where dictdb.user-account.last-name = "System Administrator":U
      158                and dictdb.user-account.user-id  begins ( substitute ( '&1-':U
      159                                                                     ,  p-db-num
      160                                                                     )
      161                                                         )
      162               exclusive-lock
      163               no-error.
      164         if available dictdb.user-account then do:
      165            FIND FIRST dictdb.user-login
      166                 WHERE dictdb.user-login.db-num  = p-db-num
      167                   AND dictdb.user-login.user-id = dictdb.user-account.user-id
      168                 EXCLUSIVE-LOCK
      169                 NO-ERROR .
      170            IF NOT AVAILABLE dictdb.user-login THEN DO:
      171               CREATE dictdb.user-login.
      172               ASSIGN
      173                  dictdb.user-login.db-num  = p-db-num
      174                  dictdb.user-login.user-id = v-user-id
      175               .
      176            end.
      177         end.
      178         else do:
      179               define variable v-count    as integer      no-undo.
      180               for each  dictdb.user-account
      181                     where dictdb.user-account.user-id begins ( substitute ( '&1-':U
      182                                                                     ,  p-db-num
      183                                                                     )
      184                                                         )
      185                     no-lock
      186                     :
      187                     if v-count < INTEGER(entry(2, dictdb.user-account.user-id, "-")) then do:
      188                        assign
      189                        v-count = INTEGER(entry(2, dictdb.user-account.user-id, "-"))
      190                        .
      191                     end.
      192               end.
      193               if v-count <= current-value(s-user-id, dictdb) then do:
      194                  assign
      195                     v-count = next-value(s-user-id, dictdb)
      196                  .
      197               end.
      198               else do:
      199                  assign
      200                     current-value(s-user-id, dictdb) = v-count
      201                  .
      202               end.
      203               v-user-id = substitute ( '&1-&2':U
      204                                    , p-db-num
      205                                    , v-count
      206                                    ) .
      207               CREATE dictdb.user-account .
      208               ASSIGN
      209                  dictdb.user-account.user-id      = v-user-id
      210                  dictdb.user-account.last-name    = "System Administrator":U
      211                  dictdb.user-account.nik          = "System Administrator":U
      212                  dictdb.user-account.check-parent = false
      213               .
      214               CREATE dictdb.user-login.
      215               ASSIGN
      216                  dictdb.user-login.db-num                = p-db-num
      217                  dictdb.user-login.user-id               = v-user-id
      218               .
      219         end.
      220      end.
      221      else do:
      222            find first dictdb.user-account
      223               where dictdb.user-account.user-id = dictdb.user-login.user-id
      224                  exclusive-lock
      225                  no-error.
      226            if NOT available dictdb.user-account then do:
      227               CREATE dictdb.user-account .
      228               ASSIGN
      229                  dictdb.user-account.user-id      = dictdb.user-login.user-id
      230                  dictdb.user-account.last-name    = "System Administrator":U
      231                  dictdb.user-account.check-parent = false
      232                  dictdb.user-account.nik          = "System Administrator":U
      233               .
      234            end.
      235      end.
      236      run adm/pswd-enc.p ( INPUT  ENCODE( "адм":U )
      237                           , OUTPUT v-encode-value
      238                           ) .
      239      ASSIGN
      240         v-encode-value = ENCODE( v-encode-value )
      241      .
      242      ASSIGN
      243         dictdb.user-login.user-login              = "адм":U
      244         dictdb.user-login.user-password-encoded   = v-encode-value
      245         dictdb.user-login.user-administrator      = TRUE
      246         dictdb.user-login.status_                 = 0
      247         dictdb.user-account.status_               = 0
      248      .
      249      find first dictdb.user-account-attr where dictdb.user-account-attr.user-id    eq dictdb.user-account.user-id
      250                                            and dictdb.user-account-attr.attr-code  eq "superadm"
      251      exclusive-lock no-error.
      252      if not available dictdb.user-account-attr
      253      then do:
      254         create dictdb.user-account-attr.
      255         assign
      256            dictdb.user-account-attr.user-id    = dictdb.user-account.user-id
      257            dictdb.user-account-attr.attr-code = "superadm"
      258         .
      259      end.
      260      dictdb.user-account-attr.attr-value = "yes".
      261      release dictdb.user-account-attr.
      262   DEFINE TEMP-TABLE tempUser NO-UNDO LIKE
      263   dictdb._User
      264   .
      265   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266       if dictdb.user-login.status_ = 0
      267       then do:
      268         find first dictdb.user-account
      269              where dictdb.user-account.user-id = dictdb.user-login.user-id
      270              no-lock
      271              no-error .
      272         if not available dictdb.user-account
      273         then do:
      274           create dictdb.user-account.
      275           assign
      276               dictdb.user-account.user-id               = dictdb.user-login.user-id
      277               dictdb.user-account.status_               = 0
      278               dictdb.user-account.first-name            = '':U
      279               dictdb.user-account.second-name           = '':U
      280               dictdb.user-account.last-name             = dictdb.user-login.user-login
      281               dictdb.user-account.nik                   = dictdb.user-login.user-login
      282               dictdb.user-account.company               = '':U
      283               dictdb.user-account.department            = '':U
      284               dictdb.user-account.e-mail                = '':U
      285               dictdb.user-account.internal-phone-number = '':U
      286               dictdb.user-account.mobile-phone-number   = '':U
      287               dictdb.user-account.phone-number          = '':U
      288               dictdb.user-account.position              = '':U
      289               dictdb.user-account.PS                    = '':U
      290               dictdb.user-account.room                  = '':U
      291               dictdb.user-account.parent-user-id        = '':U
      292               dictdb.user-account.check-parent          = false
      293           .
      294         end.
      295         else
      296            dictdb.user-login.status_ = dictdb.user-account.status_.
      297      end.
      298      if dictdb.user-login.status_ = 0
      299      then do:
      300         find first dictdb._user
      301              where dictdb._user._userid    = dictdb.user-login.user-login
      302              no-error
      303              .
      304         if not available dictdb._user then do:
      305            create dictdb._user .
      306            assign
      307               dictdb._user._userid    = dictdb.user-login.user-login
      308               dictdb._user._password  = dictdb.user-login.user-password-encoded
      309            .
      310         end.
      311         ELSE DO:
      312            BUFFER-COPY dictdb._User EXCEPT dictdb._User._Password dictdb._User._TenantId TO tempUser ASSIGN tempUser._Password = dictdb.user-login.user-password-encoded
      313            .
      314            DELETE dictdb._User.
      315            CREATE dictdb._User.
      316            BUFFER-COPY tempUser EXCEPT tempUser._TenantId TO _User.
      317         END.
      318         assign
      319           dictdb._user._user-name = substitute('&1 &2 &3'
      320                                           ,dictdb.user-account.last-name
      321                                           ,dictdb.user-account.first-name
      322                                           ,dictdb.user-account.second-name
      323                                           )
      324         .
      325         release _user.
      326       end.
      327    END.
      328      if inst = true then do:
      329         message "Инициализация" "адм":U ", sysadm и odbc закончена успешно."
      330         view-as alert-box.
      331      end.
      332      return.
      333   end.
