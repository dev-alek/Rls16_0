      760   define variable v-tth_devices as handle NO-UNDO .
      761   define variable v-tth_fisreg as handle NO-UNDO .
      762   define variable v-tth_rec-print as handle NO-UNDO .
      763   define variable v-tth_interface as handle NO-UNDO .
