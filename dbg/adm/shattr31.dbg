      784     ( INPUT p-cdpay-code AS INTEGER , INPUT p-curr-code AS INTEGER)  FORWARD.
      785   DEFINE BUTTON B-exit AUTO-GO
      786        LABEL "&Ввод"
      787        SIZE 10 BY 1
      788        BGCOLOR 8 .
      789   DEFINE BUTTON B-Help
      790        LABEL "Помо&щь"
      791        SIZE 3 BY 1
      792        BGCOLOR 8 .
      793   DEFINE BUTTON B-main
      794        IMAGE-UP FILE "adeicon\ts-up110":U
      795        IMAGE-DOWN FILE "adeicon\ts-dn110":U
      796        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
      797        LABEL "&1.Перемещ."
      798        SIZE 14 BY 1.13.
      799   DEFINE BUTTON b-quit AUTO-END-KEY
      800        LABEL "&Отмена"
      801        SIZE 10 BY 1
      802        BGCOLOR 8 .
      803   DEFINE BUTTON b-rec-print
      804        IMAGE-UP FILE "adeicon\ts-up110":U
      805        IMAGE-DOWN FILE "adeicon\ts-dn110":U
      806        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
      807        LABEL ""
      808        SIZE 14 BY 1.13.
      809   DEFINE VARIABLE cb-pos-type-for-discnt AS CHARACTER FORMAT "X(256)":U
      810        LABEL "Тип POS, с которого брать скидки"
      811        VIEW-AS COMBO-BOX INNER-LINES 5
      812        LIST-ITEMS "Item 1"
      813        DROP-DOWN-LIST
      814        SIZE 25 BY 1 NO-UNDO.
      815   DEFINE VARIABLE f-main AS CHARACTER FORMAT "X(12)" INITIAL "Основные"
      816         VIEW-AS TEXT
      817        SIZE 11 BY .53
      818        FONT 4 NO-UNDO.
      819   DEFINE VARIABLE f-rec-print AS CHARACTER FORMAT "X(12)":U INITIAL "Чеки"
      820         VIEW-AS TEXT
      821        SIZE 11 BY .53
      822        FONT 4 NO-UNDO.
      823   DEFINE VARIABLE for-curr-name AS CHARACTER FORMAT "X(256)":U
      824         VIEW-AS TEXT
      825        SIZE 6.8 BY .67
      826        FGCOLOR 4  NO-UNDO.
      827   DEFINE VARIABLE t-rcpt-ord-alt-print AS LOGICAL INITIAL no
      828        LABEL "Печатать отлож.чек на доп принтере"
      829        VIEW-AS TOGGLE-BOX
      830        SIZE 32 BY 1 NO-UNDO.
      831   DEFINE VARIABLE t-rcpt-ord-slip-print AS LOGICAL INITIAL no
      832        LABEL "Печатать слип отложенного чека"
      833        VIEW-AS TOGGLE-BOX
      834        SIZE 32 BY 1 NO-UNDO.
      835   DEFINE VARIABLE t-salesman-mandatory AS LOGICAL INITIAL no
      836        LABEL "Обязателен продавец"
      837        VIEW-AS TOGGLE-BOX
      838        SIZE 21.5 BY 1 NO-UNDO.
      839   DEFINE FRAME Dialog-Frame
      840        B-exit AT ROW 1 COL 1
      841        b-rec-print AT ROW 2.57 COL 43 WIDGET-ID 34
      842        b-quit AT ROW 1 COL 11
      843        B-Help AT ROW 1 COL 95
      844        t-salesman-mandatory AT ROW 4.2 COL 14 WIDGET-ID 156
      845        cb-pos-type-for-discnt AT ROW 6.33 COL 35 COLON-ALIGNED WIDGET-ID 158
      846        B-main AT ROW 2.57 COL 1 WIDGET-ID 14
      847        t-rcpt-ord-slip-print AT ROW 8 COL 18 WIDGET-ID 198
      848        t-rcpt-ord-alt-print AT ROW 9 COL 18 WIDGET-ID 200
      849        f-main AT ROW 2.93 COL 2.5 NO-LABEL WIDGET-ID 18
      850        f-rec-print AT ROW 2.93 COL 44.5 NO-LABEL WIDGET-ID 36
      851        for-curr-name AT ROW 17 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 136
      852        SPACE(41.49) SKIP(4.59)
      853       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      854            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      855            TITLE "Настройки по умолчанию и опции работы POS IBS TH"
      856            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      857   ASSIGN
      858          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      859          FRAME Dialog-Frame:HIDDEN           = TRUE.
      860   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      861   DO:
      862     APPLY "END-ERROR":U TO SELF.
      863   END.
      864   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      865   DO:
      866     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      867     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      868   END.
      869   ON CHOOSE OF B-main IN FRAME Dialog-Frame
      870   DO:
      871      run proc-init-main in this-procedure .
      872   END.
      873   ON CHOOSE OF b-rec-print IN FRAME Dialog-Frame
      874   DO:
      875   run proc-init-rec-print in this-procedure .
      876   END.
      877   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      878   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      879   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   on help of frame Dialog-Frame
      881   do:
      882     run gbl/app_help.p
      883       (input this-procedure :file-name
      884       ,input ''
      885       ,input ?
      886       ) no-error.
      887     if error-status :error then do:
      888       message
      889         "Ошибка при вызове помощи"
      890         error-status :get-message(1)
      891         view-as alert-box .
      892     end.
      893   end.
      894   run minbtn-set in this-procedure .
      895   on choose of b-help in frame Dialog-Frame
      896   do:
      897     apply "help":u to frame Dialog-Frame .
      898   end.
      899   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   procedure minbtn-set :
      901       do
      902           on error undo, return error return-value
      903           :
      904           define variable ii              as integer       no-undo .
      905           define variable fh              as widget-handle no-undo .
      906           define variable hh              as widget-handle no-undo .
      907           define variable v-h             as handle        extent 4 no-undo .
      908           define variable v-name-button   as character     no-undo .
      909           define variable v-help-old-x    as decimal       no-undo .
      910           define variable v-help-old-y    as decimal       no-undo .
      911           define variable v-help-old-size as decimal       no-undo .
      912           define variable v-frame-width   as decimal       no-undo .
      913           define variable jj              as integer       no-undo .
      914           do
      915               on error undo, return error
      916               :
      917               assign
      918                   v-frame-width = frame Dialog-Frame:width - 0.3
      919                   fh            = frame Dialog-Frame:first-child
      920                   hh            = fh:first-child
      921                   ii            = 1
      922                   .
      923               do while valid-handle(hh):
      924                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      925                   do:
      926                       case lc(hh:name) :
      927                           when "b-help" then
      928                               do:
      929                                   hh:load-image-up("cmp/b-help.bmp":u) .
      930                                   hh:load-image-down("cmp/b-help.bmp":u) .
      931                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      932                                   hh:TOOLTIP = "Помощь" .
      933                                   v-help-old-x = hh:column .
      934                                   v-help-old-y = hh:row    .
      935                                   v-help-old-size = hh:width .
      936                                   hh:width-chars = 2.5 .
      937                               end.
      938                           when "b-print" then
      939                               do:
      940                                   hh:load-image("cmp/b-print.bmp":u) .
      941                                   hh:TOOLTIP = "Печать" .
      942                                   v-h[ii] = hh:handle .
      943                                   ii = ii + 1 .
      944                                   hh:width-chars = 3 .
      945                               end.
      946                           when "b-history" or
      947                           when "b-hist" then
      948                               do:
      949                                   hh:load-image("cmp/b-hist.bmp":u) .
      950                                   hh:TOOLTIP = "История" .
      951                                   v-h[ii] = hh:handle .
      952                                   ii = ii + 1 .
      953                                   hh:width-chars = 3 .
      954                               end.
      955                           when "b-sch" then
      956                               do:
      957                                   hh:load-image("cmp/b-sch.bmp":u) .
      958                                   hh:TOOLTIP = "Установка Фильтра" .
      959                                   v-h[ii] = hh:handle .
      960                                   ii = ii + 1 .
      961                                   hh:width-chars = 3 .
      962                               end.
      963                           when "b-hist-user" then
      964                               do:
      965                                   hh:load-image("cmp/b-hist.bmp":u) .
      966                                   hh:TOOLTIP = "История пользователя" .
      967                                   ii = ii + 1 .
      968                               end.
      969                       end case.
      970                   end.
      971                   hh = hh:next-sibling.
      972               end.
      973               b-help:column = v-frame-width - b-help:width-chars.
      974               jj = 0.
      975               repeat ii = 4 to 1 by -1 :
      976                   if valid-handle (v-h[ii] ) then
      977                   do:
      978                       jj  = jj + 1 .
      979                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      980                       v-h[ii]:row    = v-help-old-y .
      981                   end.
      982               end.
      983           end.
      984       end.
      985   end procedure.
      986   MAIN-BLOCK:
      987   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      988      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      989   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990     run mainmenu_getcntxt in parparentproc
      991       (output v-cntxt-db-num
      992       ,output v-cntxt-userid
      993       ,output v-cntxt-level
      994       ,output v-cntxt-host-code-obj
      995       ,output v-cntxt-obj-type
      996       ,output v-cntxt-obj-code
      997       ,output v-cntxt-db-num-obj
      998       ,output v-cntxt-is-admin
      999       ) .
     1000   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   ON TAB ANYWHERE
     1002   DO:
     1003   define variable ii as integer no-undo .
     1004   define variable fh as widget-handle no-undo .
     1005   define variable hh as widget-handle no-undo .
     1006   define variable v-next-widget-name as character no-undo .
     1007   if v-current-tab-order <> '' then do:
     1008     if self:type = "TOGGLE-BOX" then
     1009     self:BGCOLOR = ?.
     1010     assign
     1011     ii = lookup(self:name, v-current-tab-order).
     1012     assign
     1013     ii = ii + 1
     1014     v-next-widget-name = entry(ii, v-current-tab-order)
     1015     no-error .
     1016     if error-status:error then do:
     1017       assign
     1018       ii = 1
     1019       v-next-widget-name = entry( ii, v-current-tab-order)
     1020       .
     1021     end.
     1022     assign
     1023     fh = frame Dialog-Frame:first-child
     1024     hh = fh:first-child
     1025     .
     1026     do while valid-handle(hh):
     1027       if hh:name = v-next-widget-name then do:
     1028         if hh:sensitive  = yes
     1029         AND hh:visible = yes then do:
     1030           if hh:type = "TOGGLE-BOX":U then do:
     1031             assign
     1032             hh:BGcolor = 1
     1033             .
     1034           end.
     1035           APPLY "ENTRY" to hh.
     1036           return no-apply.
     1037         end.
     1038         else do:
     1039           APPLY "TAB" to hh.
     1040           return no-apply.
     1041         end.
     1042       end.
     1043       hh = hh:next-sibling.
     1044     end.
     1045   end.
     1046   END.
     1047   ON BACK-TAB ANYWHERE
     1048   DO:
     1049   define variable ii as integer no-undo .
     1050   define variable fh as widget-handle no-undo .
     1051   define variable hh as widget-handle no-undo .
     1052   define variable v-next-widget-name as character no-undo .
     1053   if v-current-tab-order <> '' then do:
     1054     assign
     1055     ii = lookup(self:name, v-current-tab-order).
     1056     .
     1057     assign
     1058     ii = (if ii = 1
     1059           then  num-entries(v-current-tab-order)
     1060           else ii - 1
     1061           )
     1062     v-next-widget-name = entry(ii, v-current-tab-order)
     1063     .
     1064     assign
     1065     fh = frame Dialog-Frame:first-child
     1066     hh = fh:first-child
     1067     .
     1068     do while valid-handle(hh):
     1069       if hh:name = v-next-widget-name then do:
     1070         if hh:sensitive  = yes
     1071         AND hh:visible = yes then do:
     1072           if hh:type = "TOGGLE-BOX":U then do:
     1073             assign
     1074             hh:BGcolor = 1
     1075             .
     1076           end.
     1077           APPLY "ENTRY" to hh.
     1078           return no-apply.
     1079         end.
     1080         else do:
     1081         APPLY "BACK-TAB" to hh.
     1082         return no-apply.
     1083         end.
     1084       end.
     1085       hh = hh:next-sibling.
     1086     end.
     1087     end.
     1088   END.
     1089   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   ON RETURN ANYWHERE
     1091   DO:
     1092   define variable ii as integer no-undo .
     1093   define variable fh as widget-handle no-undo .
     1094   define variable hh as widget-handle no-undo .
     1095   define variable v-next-widget-name as character no-undo .
     1096     if v-current-tab-order <> '' then do:
     1097       assign
     1098       ii = lookup(self:name, v-current-tab-order).
     1099       if ii = num-entries(v-current-tab-order) then do:
     1100           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1101           return no-apply.
     1102       end.
     1103       if self:type <> "BUTTON" and
     1104         self:type <> "EDITOR"  then do:
     1105         run proc-move-forward in this-procedure .
     1106         return no-apply.
     1107       end.
     1108       if self:type = "BUTTON" then do:
     1109         APPLY "CHOOSE" to self.
     1110       end.
     1111       if self:type = "TOGGLE-BOX" then
     1112       self:BGCOLOR = ?.
     1113       assign
     1114       ii = ii + 1
     1115       v-next-widget-name = entry(ii, v-current-tab-order)
     1116       no-error .
     1117       if error-status:error then do:
     1118         assign
     1119         ii = 1
     1120         v-next-widget-name = entry( ii, v-current-tab-order)
     1121         .
     1122       end.
     1123       assign
     1124       fh = frame Dialog-Frame:first-child
     1125       hh = fh:first-child
     1126       .
     1127       do while valid-handle(hh):
     1128         if hh:name = v-next-widget-name then do:
     1129           if hh:sensitive  = yes
     1130           AND hh:visible = yes then do:
     1131             if hh:type = "TOGGLE-BOX":U then do:
     1132               assign
     1133               hh:BGcolor = 1
     1134               .
     1135             end.
     1136             APPLY "ENTRY" to hh.
     1137             return no-apply.
     1138           end.
     1139           else do:
     1140             APPLY "TAB" to hh.
     1141             return no-apply.
     1142           end.
     1143         end.
     1144         hh = hh:next-sibling.
     1145       end.
     1146     end.
     1147   END.
     1148   procedure proc-move-forward :
     1149   define variable ii as integer no-undo .
     1150   define variable fh as widget-handle no-undo .
     1151   define variable hh as widget-handle no-undo .
     1152   define variable v-next-widget-name as character no-undo .
     1153   do
     1154   on error undo, return error
     1155   :
     1156     if v-current-tab-order <> '' then do:
     1157       if self:type = "TOGGLE-BOX" then
     1158       self:BGCOLOR = ?.
     1159       assign
     1160       ii = lookup(self:name, v-current-tab-order).
     1161       assign
     1162       ii = ii + 1
     1163       v-next-widget-name = entry(ii, v-current-tab-order)
     1164       no-error .
     1165       if error-status:error then do:
     1166         assign
     1167         ii = 1
     1168         v-next-widget-name = entry( ii, v-current-tab-order)
     1169         .
     1170       end.
     1171       assign
     1172       fh = frame Dialog-Frame:first-child
     1173       hh = fh:first-child
     1174       .
     1175       do while valid-handle(hh):
     1176         if hh:name = v-next-widget-name then do:
     1177           if hh:sensitive  = yes
     1178           AND hh:visible = yes then do:
     1179             if hh:type = "TOGGLE-BOX":U then do:
     1180               assign
     1181               hh:BGcolor = 1
     1182               .
     1183             end.
     1184             APPLY "ENTRY" to hh.
     1185             return.
     1186           end.
     1187           else do:
     1188             assign
     1189             ii = ii + 1
     1190             v-next-widget-name = entry(ii, v-current-tab-order)
     1191             no-error .
     1192             if error-status:error then do:
     1193               assign
     1194               ii = 1
     1195               v-next-widget-name = entry( ii, v-current-tab-order)
     1196               .
     1197             end.
     1198           end.
     1199         end.
     1200         hh = hh:next-sibling.
     1201       end.
     1202     end.
     1203   end.
     1204   end procedure.
     1205     IF p-mode <> 'ПРОСМОТР':U
     1206     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1207         MESSAGE
     1208         vss-workfile vss-revision vss-description skip
     1209         "Неверное значение параметра p-mode" p-mode
     1210         VIEW-AS ALERT-BOX ERROR.
     1211         UNDO, RETURN ERROR.
     1212     END.
     1213     IF p-obj-type <> 'маг':U
     1214     and p-obj-type <> '':U
     1215     THEN DO:
     1216         MESSAGE
     1217         vss-workfile vss-revision vss-description skip
     1218         "Неверное значение параметра p-obj-type" p-obj-type
     1219         VIEW-AS ALERT-BOX ERROR.
     1220         UNDO, RETURN ERROR.
     1221     END.
     1222     if p-obj-type = 'маг':U then do:
     1223       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1224       IF NOT AVAILABLE X_shop THEN DO:
     1225           MESSAGE
     1226           vss-workfile vss-revision vss-description skip
     1227           "Неверное значение параметра p-obj-code" p-obj-code
     1228           VIEW-AS ALERT-BOX ERROR.
     1229           UNDO, RETURN ERROR.
     1230       END.
     1231   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1233     (input  'маг':U
     1234     ,input  p-obj-code
     1235     ,output v-db-num
     1236     )  .
     1237       IF v-db-num <> v-cntxt-db-num
     1238       AND v-cntxt-db-num <> 0
     1239       and p-mode <> 'ПРОСМОТР':U
     1240       THEN DO:
     1241           MESSAGE
     1242           "Нельзя менять параметры магазина в чужой БД" skip
     1243           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1244           VIEW-AS ALERT-BOX ERROR.
     1245           UNDO, RETURN ERROR.
     1246       END.
     1247   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1249     (input  p-obj-type
     1250     ,input  p-obj-code
     1251     ,output v-host-code
     1252     )  .
     1253     end.
     1254     if p-obj-type = '':U then do:
     1255       if v-cntxt-db-num <> 0
     1256       and p-mode <> 'ПРОСМОТР':U
     1257       then do:
     1258           MESSAGE
     1259           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1260           VIEW-AS ALERT-BOX ERROR.
     1261           UNDO, RETURN ERROR.
     1262       end.
     1263     end.
     1264     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1265       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1266                 LOCKED_thbj-attr.obj-type = p-obj-type
     1267           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1268           AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-IBS-TH-MOB':U
     1269           AND   locked_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1270        if locked locked_thbj-attr then do:
     1271           message
     1272           vss-workfile vss-revision vss-description skip
     1273            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1274           view-as alert-box error .
     1275           undo, return error.
     1276         end.
     1277     END.
     1278     ELSE DO:
     1279         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1280             LOCKED_thbj-attr.obj-type = p-obj-type
     1281       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1282       AND   LOCKED_thbj-attr.upper-prop-code = 'cd-type-IBS-TH-MOB':U
     1283       and   locked_thbj-attr.prop-code = '':U
     1284       NO-ERROR.
     1285     END.
     1286     if not available locked_thbj-attr then do:
     1287       ASSIGN
     1288       v-to-create  = YES.
     1289       message
     1290       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1291                   chr(10))
     1292       view-as alert-box WARNING.
     1293     end.
     1294     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1295     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1296     RUN Myenable.
     1297     WAIT-FOR GO OF FRAME Dialog-Frame.
     1298   END.
     1299   RUN disable_UI.
     1300   PROCEDURE disable_UI :
     1301     HIDE FRAME Dialog-Frame.
     1302   END PROCEDURE.
     1303   PROCEDURE enable_UI :
     1304     DISPLAY t-salesman-mandatory cb-pos-type-for-discnt t-rcpt-ord-slip-print
     1305             t-rcpt-ord-alt-print f-main f-rec-print for-curr-name
     1306         WITH FRAME Dialog-Frame.
     1307     ENABLE B-exit b-rec-print b-quit B-Help t-salesman-mandatory
     1308            cb-pos-type-for-discnt B-main t-rcpt-ord-slip-print
     1309            t-rcpt-ord-alt-print f-main f-rec-print for-curr-name
     1310         WITH FRAME Dialog-Frame.
     1311     VIEW FRAME Dialog-Frame.
     1312   END PROCEDURE.
     1313   PROCEDURE fill-widgets :
     1314   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1315   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1316   define variable v-param-type as character no-undo .
     1317   define variable v-param-value as character no-undo .
     1318   define variable v-value-character as character no-undo .
     1319   define variable v-value-date as date no-undo .
     1320   define variable v-value-decimal as decimal no-undo .
     1321   define variable v-value-integer as INTEGER no-undo .
     1322   define variable v-value-logical AS LOGICAL no-undo .
     1323   DEFINE VARIABLE v-dop1 AS CHARACTER NO-UNDO.
     1324   DEFINE VARIABLE v-fr-code AS integer NO-UNDO.
     1325   DEFINE VARIABLE v-cp-list AS character NO-UNDO.
     1326   DEFINE VARIABLE v-name AS character NO-UNDO.
     1327   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     1328   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     1329   DEFINE BUFFER buf_currency FOR ub.currency.
     1330   FOR EACH thbjattr_thbj-attr:
     1331     delete thbjattr_thbj-attr.
     1332   end.
     1333   FOR EACH temp-thbj-attr:
     1334     delete temp-thbj-attr.
     1335   end.
     1336   run adm/shattri.p (
     1337                 input "init":U
     1338               , input p-obj-type
     1339               , input p-obj-code
     1340               , input 'cd-type-IBS-TH-MOB':U
     1341               , input "":U
     1342               , output v-value-character
     1343               , output v-value-date
     1344               , output v-value-decimal
     1345               , output v-value-integer
     1346               , output v-value-logical
     1347               , output v-param-type
     1348               , INPUT-OUTPUT TABLE-handle v-tth
     1349               ) no-error .
     1350   if error-status:error
     1351   and not available locked_thbj-attr then do:
     1352     message
     1353     "Не удалось получить начальные значения настроек" skip
     1354     error-status:get-message(1) return-value
     1355     view-as alert-box error .
     1356     undo, return error .
     1357   end.
     1358   FOR EACH thbjattr_thbj-attr:
     1359     ASSIGN
     1360     v-entry = thbjattr_thbj-attr.prop-code.
     1361     CASE thbjattr_thbj-attr.upper-prop-code :
     1362       WHEN 'ibs-th-mob_main':U THEN DO:
     1363         CASE v-entry:
     1364          WHEN 'salesman-mandatory':U THEN DO:
     1365             ASSIGN
     1366             t-salesman-mandatory = logical(thbjattr_thbj-attr.property-value-integer)
     1367             t-salesman-mandatory:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1368             .
     1369          END.
     1370          WHEN 'pos-type-for-discnt':U THEN DO:
     1371             ASSIGN
     1372             cb-pos-type-for-discnt = thbjattr_thbj-attr.property-value-character
     1373             cb-pos-type-for-discnt:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1374             .
     1375          END.
     1376         END CASE.
     1377       END.
     1378       when 'ibs-th-mob_rec-print':U THEN DO:
     1379         case v-entry:
     1380          when 'rcpt-ord-slip-print':U then do:
     1381            ASSIGN
     1382            t-rcpt-ord-slip-print = logical(thbjattr_thbj-attr.property-value-integer)
     1383            t-rcpt-ord-slip-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1384            .
     1385          end.
     1386          when 'rcpt-ord-alt-print':U then do:
     1387            ASSIGN
     1388            t-rcpt-ord-alt-print = logical(thbjattr_thbj-attr.property-value-integer)
     1389            t-rcpt-ord-alt-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1390            .
     1391          end.
     1392         END CASE.
     1393       end.
     1394     END CASE.
     1395     create temp-thbj-attr.
     1396     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1397   END.
     1398   END PROCEDURE.
     1399   PROCEDURE MyEnable :
     1400   DEFINE VARIABLE v-h AS HANDLE NO-UNDO.
     1401   DEFINE VARIABLE v-h1 AS HANDLE NO-UNDO.
     1402   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     1403   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     1404   define variable wh as widget-handle no-undo .
     1405   define variable fh as widget-handle no-undo .
     1406   ASSIGN
     1407   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     1408                                          ,FRAME Dialog-Frame:TITLE
     1409                                          ,(if p-obj-type = ""
     1410                                            then ""
     1411                                            else 'маг':U)
     1412                                          ,(IF p-obj-type = "" THEN "" ELSE string(p-obj-code)))
     1413   cb-pos-type-for-discnt:LIST-ITEMS = 'IBS-TH':U + chr(44) + 'IBS-TH-MOB':U
     1414   v-tab-order[1] = "t-salesman-mandatory,cb-pos-type-for-discnt"
     1415   v-labels[1] = ''
     1416   v-tab-order[2] = "t-rcpt-ord-slip-print,t-rcpt-ord-alt-print"
     1417   v-labels[2] = ''
     1418   .
     1419   v-h = FRAME Dialog-Frame:FIRST-CHILD.
     1420   DO WHILE valid-handle(v-h).
     1421     IF v-h:TYPE = "field-group"  THEN DO:
     1422        v-h1 = v-h:FIRST-CHILD.
     1423        DO WHILE valid-handle(v-h1).
     1424         RUN tempwidg_create-record IN THIS-PROCEDURE ( INPUT v-h1).
     1425         ASSIGN
     1426         v-h1 = v-h1:NEXT-sibling.
     1427       END.
     1428     END.
     1429     v-h = v-h:NEXT-SIBLING.
     1430   END.
     1431   DO v-ii = 1 TO 5:
     1432     IF v-tab-order[v-ii] > '' THEN do:
     1433       DO v-jj = 1 TO NUM-ENTRIES(v-tab-order[v-ii]):
     1434        FIND FIRST temp-widget WHERE
     1435                   temp-widget.name_ = ENTRY(v-jj,v-tab-order[v-ii]) NO-ERROR.
     1436        IF AVAILABLE temp-widget THEN DO:
     1437            temp-widget.section_ = STRING(v-ii).
     1438        END.
     1439       END.
     1440     END.
     1441     IF v-labels[v-ii] > '' THEN do:
     1442       DO v-jj = 1 TO NUM-ENTRIES(v-labels[v-ii]):
     1443        FIND FIRST temp-widget WHERE
     1444                   temp-widget.name_ = ENTRY(v-jj,v-labels[v-ii]) NO-ERROR.
     1445        IF AVAILABLE temp-widget THEN DO:
     1446           temp-widget.section_ = STRING(v-ii).
     1447         END.
     1448       END.
     1449     END.
     1450   END.
     1451   DISPLAY
     1452   f-main
     1453   f-rec-print
     1454   WITH FRAME Dialog-Frame.
     1455   assign
     1456   fh = frame Dialog-Frame:first-child
     1457   wh = fh:first-child
     1458   .
     1459   do while valid-handle(wh):
     1460   if wh:private-data begins "recid=" then do:
     1461     find first thbjattr_thbj-attr where
     1462               recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1463     IF wh:DATA-TYPE = 'logical':U
     1464     AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     1465        wh:screen-value = string(IF thbjattr_thbj-attr.property-value-integer = 1 THEN YES ELSE NO).
     1466     END.
     1467     ELSE DO:
     1468       assign
     1469       wh:screen-value = string(buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value).
     1470     END.
     1471   end.
     1472   ELSE DO:
     1473      FIND FIRST temp-widget NO-LOCK WHERE
     1474                temp-widget.NAME_ = wh:NAME NO-ERROR.
     1475      IF AVAILABLE temp-widget THEN DO:
     1476         CASE temp-widget.DATA-TYPE_:
     1477           WHEN 'character':U THEN DO:
     1478               ASSIGN
     1479               wh:SCREEN-VALUE = temp-widget.CHARACTER_.
     1480           END.
     1481         END CASE.
     1482      END.
     1483   END.
     1484   wh = wh:next-sibling.
     1485   end.
     1486   ENABLE
     1487   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1488   b-quit
     1489   B-Help
     1490   b-main
     1491   b-rec-print
     1492   t-salesman-mandatory WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1493   t-rcpt-ord-slip-print WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1494   t-rcpt-ord-alt-print WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1495   cb-pos-type-for-discnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1496   WITH FRAME Dialog-Frame.
     1497   VIEW FRAME Dialog-Frame.
     1498   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1499       HIDE
     1500       b-exit
     1501       IN FRAME Dialog-Frame.
     1502       ASSIGN
     1503       b-quit:LABEL = "&Выход"
     1504       b-quit:COLUMN = 1
     1505       .
     1506   END.
     1507   APPLY "CHOOSE" TO b-main.
     1508   END PROCEDURE.
     1509   PROCEDURE proc-init-main :
     1510   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1511   DO on error undo, return error return-value:
     1512    b-main:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     1513    b-rec-print:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     1514    f-main:fgcolor = 1   .
     1515    f-rec-print:fgcolor = ? .
     1516    FOR EACH temp-widget WHERE
     1517           temp-widget.SECTION_ = "1":
     1518      ASSIGN
     1519       temp-widget.HANDLE_:VISIBLE = YES.
     1520   END.
     1521   FOR EACH temp-widget WHERE
     1522           temp-widget.SECTION_ <> "1"
     1523       AND temp-widget.SECTION_ <> "":
     1524      ASSIGN
     1525       temp-widget.HANDLE_:VISIBLE = no.
     1526    END.
     1527    .
     1528    v-current-tab-order = v-tab-order[1].
     1529   end.
     1530   END PROCEDURE.
     1531   PROCEDURE proc-init-rec-print :
     1532   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1533   DO on error undo, return error return-value:
     1534    b-main:LOAD-IMAGE-UP("adeicon\ts-dn110":U)           in frame Dialog-Frame .
     1535    b-rec-print:LOAD-IMAGE-Up("adeicon\ts-up110":U)      in frame Dialog-Frame .
     1536    f-main:fgcolor = ?   .
     1537    f-rec-print:fgcolor = 1 .
     1538    FOR EACH temp-widget WHERE
     1539           temp-widget.SECTION_ = "2":
     1540      ASSIGN
     1541       temp-widget.HANDLE_:VISIBLE = YES.
     1542   END.
     1543   FOR EACH temp-widget WHERE
     1544           temp-widget.SECTION_ <> "2"
     1545       AND temp-widget.SECTION_ <> "":
     1546      ASSIGN
     1547       temp-widget.HANDLE_:VISIBLE = no.
     1548    END.
     1549    .
     1550    v-current-tab-order = v-tab-order[2].
     1551   end.
     1552   END PROCEDURE.
     1553   PROCEDURE proc-save :
     1554   define variable v-value-character as character no-undo .
     1555   define variable v-value-date as date no-undo .
     1556   define variable v-value-decimal as decimal no-undo .
     1557   define variable v-value-integer as INTEGER no-undo .
     1558   define variable v-value-logical AS LOGICAL no-undo .
     1559   define variable v-param-type as character no-undo .
     1560   define variable wh as widget-handle no-undo .
     1561   define variable fh as widget-handle no-undo .
     1562   define variable v-same as logical no-undo .
     1563   define variable v-loc-same as logical no-undo .
     1564   define variable l-write-cd as logical no-undo .
     1565   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1566   MESSAGE
     1567   substitute( "Применить сделанные Вами изменения ко всем POS IBS TH MOB&1&2?"
     1568              ,chr(10)
     1569              ,(IF p-obj-type <> '' THEN substitute("&1&2", p-obj-type, p-obj-code) ELSE "")
     1570              )
     1571   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO-CANCEL UPDATE l-write-cd.
     1572   IF l-write-cd = ? THEN UNDO, RETURN ERROR.
     1573   assign
     1574   fh = frame Dialog-Frame:first-child
     1575   wh = fh:first-child
     1576   .
     1577   do while valid-handle(wh):
     1578    if wh:private-data begins "recid=" then do:
     1579       find first thbjattr_thbj-attr where
     1580                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1581       IF wh:DATA-TYPE = 'logical':U
     1582       AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     1583         assign
     1584         thbjattr_thbj-attr.property-value-integer = (IF wh:INPUT-VALUE = YES THEN 1 ELSE 0).
     1585       END.
     1586       ELSE DO:
     1587        assign
     1588         buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1589       END.
     1590     end.
     1591     wh = wh:next-sibling.
     1592   end.
     1593   v-same = yes.
     1594   for each thbjattr_thbj-attr,
     1595       first temp-thbj-attr where
     1596             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1597         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1598         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1599         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code
     1600   break
     1601   by thbjattr_thbj-attr.upper-prop-code :
     1602      buffer-compare
     1603      thbjattr_thbj-attr
     1604      to temp-thbj-attr
     1605      save result in v-loc-same.
     1606      if v-loc-same = no then do:
     1607        v-same = v-loc-same.
     1608        if l-write-cd = yes
     1609        and thbjattr_thbj-attr.upper-prop-code <> 'cd-type-IBS-TH-MOB':U
     1610        then do:
     1611          run update-cda in this-procedure ( buffer thbjattr_thbj-attr).
     1612        end.
     1613        else do:
     1614          leave.
     1615       end.
     1616      end.
     1617   end.
     1618   v-same = no.
     1619   IF v-same  and not v-to-create THEN RETURN.
     1620   for each thbjattr_thbj-attr
     1621   break by thbjattr_thbj-attr.upper-prop-code
     1622   :
     1623     if first-of(thbjattr_thbj-attr.upper-prop-code) then do:
     1624       empty temp-table thbjattr___thbj-attr.
     1625     end.
     1626     create thbjattr___thbj-attr.
     1627     buffer-copy
     1628     thbjattr_thbj-attr
     1629     to
     1630     thbjattr___thbj-attr.
     1631     if last-of(thbjattr_thbj-attr.upper-prop-code) then do:
     1632       run adm/shattri.p (
     1633                     input "check":U
     1634                   , input p-obj-type
     1635                   , input p-obj-code
     1636                   , input thbjattr_thbj-attr.upper-prop-code
     1637                   , input '':U
     1638                   , output v-value-character
     1639                   , output v-value-date
     1640                   , output v-value-decimal
     1641                   , output v-value-integer
     1642                   , output v-value-logical
     1643                   , output v-param-type
     1644                   , input-output TABLE-handle v-tth_
     1645                   ) no-error .
     1646       if error-status:error then do:
     1647         message
     1648         "Некорректное значение ПАРАМЕТРОВ" skip
     1649         error-status:get-message(1) skip
     1650         return-value
     1651         view-as alert-box error .
     1652         undo, return error .
     1653       end.
     1654       empty temp-table thbjattr___thbj-attr.
     1655     end.
     1656   end.
     1657   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1658        input p-obj-type
     1659       ,input p-obj-code
     1660       ,input 'cd-type-IBS-TH-MOB':U
     1661       ,input table thbjattr_thbj-attr
     1662   ) NO-ERROR.
     1663   IF ERROR-STATUS:error THEN do:
     1664     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1665     RETURN-VALUE
     1666     VIEW-AS ALERT-BOX.
     1667     UNDO, RETURN ERROR.
     1668   END.
     1669   END PROCEDURE.
     1670   PROCEDURE update-cda :
     1671   DEFINE PARAMETER BUFFER buf_thbjattr_thbj-attr FOR thbjattr_thbj-attr.
     1672   define variable v-obj-db-num as integer no-undo .
     1673   define buffer buf_cash-desk for ub.cash-desk.
     1674   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     1675   case p-obj-type:
     1676     when '':U then do:
     1677       main-block:
     1678       for each buf_Cash-desk no-lock where
     1679               buf_cash-desk.pos-type = 'IBS-TH-MOB':U
     1680       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1681       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1682       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1683       :
     1684          find first   buf_cash-desk-attr share-lock where
     1685                buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     1686            and buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     1687            and buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     1688            and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     1689            and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1690           and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1691           no-error.
     1692          if not available buf_Cash-desk-attr then do:
     1693            create buf_cash-desk-attr.
     1694            assign
     1695            buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     1696            buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     1697            buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     1698            buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     1699            buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1700            buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1701            .
     1702          end.
     1703          assign
     1704          buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     1705          buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     1706          buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     1707          buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     1708          buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     1709          buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     1710          .
     1711       end.
     1712     end.
     1713     when 'маг':U then do:
     1714   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1716     (input  'маг':U
     1717     ,input  p-obj-code
     1718     ,output v-obj-db-num
     1719     )  .
     1720       main-block:
     1721       for each buf_Cash-desk no-lock where
     1722               buf_cash-desk.pos-type = 'IBS-TH-MOB':U
     1723           and buf_cash-desk.obj-code = p-obj-code
     1724           and buf_cash-desk.db-num = v-obj-db-num
     1725       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1726       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1727       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1728       :
     1729          find first   buf_cash-desk-attr share-lock where
     1730                buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     1731            and buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     1732            and buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     1733            and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     1734            and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1735           and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1736           no-error.
     1737          if not available buf_Cash-desk-attr then do:
     1738            create buf_cash-desk-attr.
     1739            assign
     1740            buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     1741            buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     1742            buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     1743            buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
     1744            buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1745            buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1746            .
     1747          end.
     1748          assign
     1749          buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     1750          buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     1751          buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     1752          buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     1753          buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     1754          buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     1755          .
     1756       end.
     1757     end.
     1758   end case.
     1759   END PROCEDURE.
     1760   FUNCTION get-frpay-name RETURNS CHARACTER
     1761     ( INPUT p-frpay-code AS INTEGER ) :
     1762   DEFINE BUFFER buf_temp-pay-names FOR temp-pay-names.
     1763   FIND first buf_temp-pay-names WHERE
     1764           buf_temp-pay-names.frpay-code = p-frpay-code NO-ERROR.
     1765   IF NOT AVAILABLE buf_temp-pay-names THEN RETURN "".
     1766   RETURN buf_temp-pay-names.frpay-name.
     1767   END FUNCTION.
     1768   FUNCTION getcp-name RETURNS CHARACTER
     1769     ( INPUT p-cdpay-code AS INTEGER , INPUT p-curr-code AS INTEGER) :
     1770   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1771   FIND first buf_cash-pay NO-LOCK  WHERE
     1772           buf_cash-pay.cdpay-code = p-cdpay-code
     1773       AND buf_Cash-pay.curr-code = p-curr-code NO-ERROR.
     1774   IF NOT AVAILABLE buf_cash-pay THEN RETURN "!!!НЕИЗВЕСТНЫЙ ТИП КАСС.ПЛАТЕЖА".
     1775   RETURN buf_cash-pay.obj-name.
     1776   END FUNCTION.
