      666     define variable v-cntxt-obj-code      as integer   no-undo .
      667     define variable v-cntxt-db-num-obj    as integer   no-undo .
      668     define variable v-cntxt-is-admin      as logical   no-undo .
      669   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   define temp-table thbjattr___thbj-attr no-undo like ub.thbj-attr.
      671   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   define variable v-tempwidg-index as integer no-undo .
      673   DEFINE TEMP-TABLE temp-widget
      674   FIELD NAME_ AS CHARACTER
      675   FIELD LENGTH_ AS DECIMAL
      676   FIELD index_ AS INTEGER
      677   FIELD HANDLE_ AS HANDLE
      678   FIELD format_ AS CHARACTER
      679   FIELD width_ AS DECIMAL
      680   field section_ as character
      681   field visible_ as integer
      682   field column_ as decimal
      683   field row_ as decimal
      684   field data-type_ as character
      685   field character_ as character
      686   field date_ as date
      687   field decimal_ as decimal
      688   field integer_ as decimal
      689   field logical_ as logical
      690   INDEX pi IS UNIQUE PRIMARY
      691   NAME_
      692   INDEX iindex
      693   INDEX_
      694   index isection
      695   section_
      696   .
      697   procedure tempwidg_create-record :
      698   define input parameter p-handle as widget-handle no-undo .
      699   define buffer buf_temp-widget for temp-widget.
      700   do
      701   on error undo, return error
      702   :
      703     find first buf_temp-widget where
      704               buf_temp-widget.name = p-handle:name no-error.
      705     if not available buf_temp-widget then do:
      706       create buf_temp-widget.
      707       assign
      708       buf_temp-widget.name = p-handle:name
      709       buf_temp-widget.index_ = v-tempwidg-index + 1
      710       buf_temp-widget.handle_ = p-handle
      711       v-tempwidg-index = v-tempwidg-index + 1
      712       .
      713     end.
      714   end.
      715   end procedure.
      716   procedure tempwidg_write-character :
      717   define input parameter p-name as character no-undo .
      718   define input parameter p-character as character no-undo .
      719   define buffer buf_temp-widget for temp-widget.
      720   do
      721   on error undo, return error
      722   :
      723     find first buf_temp-widget where
      724               buf_temp-widget.name = p-name no-error.
      725     if available buf_temp-widget then do:
      726       assign
      727       buf_temp-widget.character_ = p-character
      728       buf_temp-widget.data-type_ = 'character':U
      729       .
      730     end.
      731   end.
      732   end procedure.
      733   procedure tempwidg_write-logical :
      734   define input parameter p-name as character no-undo .
      735   define input parameter p-logical as logical no-undo .
      736   define buffer buf_temp-widget for temp-widget.
      737   do
      738   on error undo, return error
      739   :
      740     find first buf_temp-widget where
      741               buf_temp-widget.name = p-name no-error.
      742     if available buf_temp-widget then do:
      743       assign
      744       buf_temp-widget.logical_ = p-logical
      745       buf_temp-widget.data-type_ = 'logical':U
      746       .
      747     end.
      748   end.
      749   end procedure.
