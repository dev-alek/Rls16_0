        1   define input  parameter parParentProc   as widget-handle    no-undo.
        2   define input  parameter p-obj-type      as character        no-undo .
        3   define input  parameter p-obj-code      as integer          no-undo .
        4   define input  parameter p-date-change   as character        no-undo .
        5   define output parameter p-error-code    as integer          no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Запрос текущей даты".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3':u,p-obj-type,p-obj-code,p-date-change)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   procedure sel-date :
      302     define input  parameter p-date-handle as handle    no-undo .
      303     define input  parameter p-description as character no-undo .
      304     do
      305     on error undo, return error return-value
      306     :
      307       if (can-query (p-date-handle, "sensitive")
      308         and
      309         p-date-handle :sensitive = true
      310         )
      311       or (can-query (p-date-handle, "read-only")
      312         and
      313         p-date-handle :read-only = false
      314         )
      315       then do:
      316         if p-date-handle :handle <> focus :handle
      317         then do:
      318           apply "entry":u to p-date-handle .
      319         end.
      320         define variable v-ok            as logical no-undo .
      321         define variable v-curr-sv-date as date no-undo .
      322         assign
      323           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      324         .
      325         if v-curr-sv-date = ?
      326         then do:
      327           run gbl/getcurdt.p
      328             (output v-curr-sv-date
      329             ) .
      330         end.
      331         if v-curr-sv-date <> ?
      332         then do:
      333           run gbl/d-inpday.w
      334             (input ?
      335             ,input "Выбор даты"
      336             ,input p-description
      337             ,input ""
      338             ,input-output v-curr-sv-date
      339             ,output v-ok
      340             ).
      341           if v-ok = true
      342           then do:
      343             assign
      344               p-date-handle :screen-value = string(v-curr-sv-date) .
      345             .
      346           end.
      347         end.
      348       end.
      349     end.
      350   end procedure.
      351   procedure proc-alt-shift-f2:
      352     if not ibs.th.gbl.gbl-var:rcode
      353   then
      354     run gbl\inidebug.p .
      355   end.
      356   procedure proc-alt-shift-f3:
      357     run gbl/prvssinf.p
      358       ( input this-procedure
      359       ) .
      360   end.
      361   define variable v-inform-launched as logical no-undo initial false .
      362   procedure proc-alt-shift-f4:
      363     define variable v-action as character no-undo .
      364     if v-inform-launched = false then do:
      365       assign
      366         v-inform-launched = true
      367       .
      368       run gbl/d-inform.w
      369         (  input self
      370         ,  input this-procedure
      371         , output v-action
      372         ) no-error .
      373       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      374       assign
      375         v-inform-launched = false
      376       .
      377     end.
      378   end.
      379   procedure proc-alt-f1:
      380     run gbl/corrhelp.p
      381       (input this-procedure
      382       ) .
      383   end .
      384   on alt-shift-f2 anywhere do:
      385     run proc-alt-shift-f2.
      386   end.
      387   on alt-shift-f3 anywhere do:
      388     run proc-alt-shift-f3 in this-procedure .
      389   end.
      390   on alt-shift-f4 anywhere do:
      391     run proc-alt-shift-f4 in this-procedure.
      392   end.
      393   on alt-f1 anywhere do:
      394     run proc-alt-f1 in this-procedure .
      395   end.
      396   define variable v-today                 as date                    no-undo.
      397   define variable v-time                  as integer                 no-undo.
      398   define variable v-obj-date              as date                    no-undo.
      399   define variable v-allow-date-change     as logical                 no-undo.
      400   define variable v-auto-date-change      as logical                 no-undo.
      401   define variable v-conf-parameter-string as character               no-undo.
      402   define variable v-obj-date-is-from-base as logical init yes        no-undo.
      403   define variable v-shift-obj-on          as logical                 no-undo.
      404   define variable v-shift-start-date      as date                    no-undo.
      405   define variable v-max-shift-days        as integer                 no-undo.
      406   define variable v-par-type              as character               no-undo.
      407   define variable v-shift-num             as integer                 no-undo.
      408   define variable v-shift-name            as character               no-undo.
      409   define variable v-void-date             as date                    no-undo.
      410   define variable v-endkey-error          as logical init no         no-undo.
      411   define variable v-exit-enabled          as logical init no         no-undo.
      412   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413     define variable v-cntxt-db-num        as integer   no-undo .
      414     define variable v-cntxt-userid        as character no-undo .
      415     define variable v-cntxt-level         as character no-undo .
      416     define variable v-cntxt-host-code-obj as integer   no-undo .
      417     define variable v-cntxt-obj-type      as character no-undo .
      418     define variable v-cntxt-obj-code      as integer   no-undo .
      419     define variable v-cntxt-db-num-obj    as integer   no-undo .
      420     define variable v-cntxt-is-admin      as logical   no-undo .
      421   define buffer buf_obj-date      for ub.obj-date.
      422   DEFINE BUTTON b-choose-date
      423        IMAGE-UP FILE "btn-down-arrow":U
      424        IMAGE-DOWN FILE "btn-down-arrow":U
      425        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      426        LABEL "b-choose-date"
      427        SIZE 3 BY .88.
      428   DEFINE BUTTON b-exit AUTO-GO
      429        LABEL "&Ввод "
      430        SIZE 10 BY 1
      431        BGCOLOR 8 .
      432   DEFINE BUTTON b-help
      433        LABEL "Помо&щь"
      434        SIZE 10 BY 1
      435        BGCOLOR 8 .
      436   DEFINE BUTTON b-quit AUTO-END-KEY
      437        LABEL "&Отмена"
      438        SIZE 10 BY 1
      439        BGCOLOR 8 .
      440   DEFINE VARIABLE ed-info AS CHARACTER
      441        VIEW-AS EDITOR
      442        SIZE 36.38 BY 3.29
      443        FGCOLOR 4  NO-UNDO.
      444   DEFINE VARIABLE cur-date AS DATE FORMAT "99/99/9999":U
      445        VIEW-AS FILL-IN
      446        SIZE 11.5 BY 1 NO-UNDO.
      447   DEFINE VARIABLE fi-description AS CHARACTER FORMAT "X(256)":U INITIAL "Текущая дата:"
      448         VIEW-AS TEXT
      449        SIZE 14 BY .67 NO-UNDO.
      450   DEFINE FRAME d-cur-date
      451        b-exit AT ROW 1 COL 1
      452        b-quit AT ROW 1 COL 11
      453        b-help AT ROW 1 COL 21
      454        ed-info AT ROW 2.5 COL 1 NO-LABEL
      455        cur-date AT ROW 6.46 COL 14.13 COLON-ALIGNED NO-LABEL
      456        b-choose-date AT ROW 6.54 COL 28.75
      457        fi-description AT ROW 6.67 COL 1.38 NO-LABEL
      458        SPACE(23.48) SKIP(0.94)
      459       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      460            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      461            TITLE "Ввод даты"
      462            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      463   ASSIGN
      464          FRAME d-cur-date:SCROLLABLE       = FALSE
      465          FRAME d-cur-date:HIDDEN           = TRUE.
      466   ASSIGN
      467          ed-info:READ-ONLY IN FRAME d-cur-date        = TRUE.
      468   ON WINDOW-CLOSE OF FRAME d-cur-date
      469   DO:
      470       if v-exit-enabled = no
      471       then do:
      472           return no-apply.
      473       end.
      474       APPLY "END-ERROR":U TO SELF.
      475   END.
      476   ON CHOOSE OF b-choose-date IN FRAME d-cur-date
      477   DO:
      478     run sel-date in this-procedure
      479       (input cur-date :handle
      480       ,input replace(ed-info :screen-value, chr(10), '. ') + chr(10) +
      481              'Новая дата: &1'
      482       ) .
      483   END.
      484   ON CHOOSE OF b-quit IN FRAME d-cur-date
      485   DO:
      486     define variable v-ok as logical   no-undo .
      487     assign
      488       cur-date
      489     .
      490     if cur-date <> ?
      491     then do:
      492       message
      493         "Отказаться от изменения даты?" skip
      494         view-as alert-box question buttons yes-no update v-ok .
      495       if v-ok <> true
      496       then do:
      497         return no-apply .
      498       end.
      499     end.
      500     assign
      501       v-endkey-error = yes
      502       v-exit-enabled = yes
      503     .
      504   END.
      505   ON RETURN OF cur-date IN FRAME d-cur-date
      506   DO:
      507     assign
      508         v-exit-enabled = yes
      509     .
      510     apply "choose" to b-exit in frame d-cur-date.
      511   END.
      512   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-cur-date:PARENT eq ?
      513   THEN FRAME d-cur-date:PARENT = ACTIVE-WINDOW.
      514   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   on help of frame d-cur-date
      516   do:
      517     run gbl/app_help.p
      518       (input this-procedure :file-name
      519       ,input ''
      520       ,input ?
      521       ) no-error.
      522     if error-status :error then do:
      523       message
      524         "Ошибка при вызове помощи"
      525         error-status :get-message(1)
      526         view-as alert-box .
      527     end.
      528   end.
      529   run minbtn-set in this-procedure .
      530   on choose of b-help in frame d-cur-date
      531   do:
      532     apply "help":u to frame d-cur-date .
      533   end.
      534   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   procedure minbtn-set :
      536       do
      537           on error undo, return error return-value
      538           :
      539           define variable ii              as integer       no-undo .
      540           define variable fh              as widget-handle no-undo .
      541           define variable hh              as widget-handle no-undo .
      542           define variable v-h             as handle        extent 4 no-undo .
      543           define variable v-name-button   as character     no-undo .
      544           define variable v-help-old-x    as decimal       no-undo .
      545           define variable v-help-old-y    as decimal       no-undo .
      546           define variable v-help-old-size as decimal       no-undo .
      547           define variable v-frame-width   as decimal       no-undo .
      548           define variable jj              as integer       no-undo .
      549           do
      550               on error undo, return error
      551               :
      552               assign
      553                   v-frame-width = frame d-cur-date:width - 0.3
      554                   fh            = frame d-cur-date:first-child
      555                   hh            = fh:first-child
      556                   ii            = 1
      557                   .
      558               do while valid-handle(hh):
      559                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      560                   do:
      561                       case lc(hh:name) :
      562                           when "b-help" then
      563                               do:
      564                                   hh:load-image-up("cmp/b-help.bmp":u) .
      565                                   hh:load-image-down("cmp/b-help.bmp":u) .
      566                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      567                                   hh:TOOLTIP = "Помощь" .
      568                                   v-help-old-x = hh:column .
      569                                   v-help-old-y = hh:row    .
      570                                   v-help-old-size = hh:width .
      571                                   hh:width-chars = 2.5 .
      572                               end.
      573                           when "b-print" then
      574                               do:
      575                                   hh:load-image("cmp/b-print.bmp":u) .
      576                                   hh:TOOLTIP = "Печать" .
      577                                   v-h[ii] = hh:handle .
      578                                   ii = ii + 1 .
      579                                   hh:width-chars = 3 .
      580                               end.
      581                           when "b-history" or
      582                           when "b-hist" then
      583                               do:
      584                                   hh:load-image("cmp/b-hist.bmp":u) .
      585                                   hh:TOOLTIP = "История" .
      586                                   v-h[ii] = hh:handle .
      587                                   ii = ii + 1 .
      588                                   hh:width-chars = 3 .
      589                               end.
      590                           when "b-sch" then
      591                               do:
      592                                   hh:load-image("cmp/b-sch.bmp":u) .
      593                                   hh:TOOLTIP = "Установка Фильтра" .
      594                                   v-h[ii] = hh:handle .
      595                                   ii = ii + 1 .
      596                                   hh:width-chars = 3 .
      597                               end.
      598                           when "b-hist-user" then
      599                               do:
      600                                   hh:load-image("cmp/b-hist.bmp":u) .
      601                                   hh:TOOLTIP = "История пользователя" .
      602                                   ii = ii + 1 .
      603                               end.
      604                       end case.
      605                   end.
      606                   hh = hh:next-sibling.
      607               end.
      608               b-help:column = v-frame-width - b-help:width-chars.
      609               jj = 0.
      610               repeat ii = 4 to 1 by -1 :
      611                   if valid-handle (v-h[ii] ) then
      612                   do:
      613                       jj  = jj + 1 .
      614                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      615                       v-h[ii]:row    = v-help-old-y .
      616                   end.
      617               end.
      618           end.
      619       end.
      620   end procedure.
