      847   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848     run mainmenu_getcntxt in parparentproc
      849       (output v-cntxt-db-num
      850       ,output v-cntxt-userid
      851       ,output v-cntxt-level
      852       ,output v-cntxt-host-code-obj
      853       ,output v-cntxt-obj-type
      854       ,output v-cntxt-obj-code
      855       ,output v-cntxt-db-num-obj
