      705           ) .
      706       end.
      707       if v-curr-sv-date <> ?
      708       then do:
      709         assign
      710           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      711         .
      712         assign
      713           self :screen-value = string(v-new-sv-date) .
      714         .
      715       end.
      716     end.
      717     return no-apply .
      718   end.
      719   on ctrl-e of cur-date in frame d-cur-date
      720   do:
