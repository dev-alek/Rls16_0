      872       then do:
      873           if v-endkey-error = yes
      874           then do:
      875               if p-date-change <> 'change-date':U
      876               then do:
      877                   message
      878                       "Без ввода даты работа на объекте невозможна."
      879                   view-as alert-box error.
      880               end.
      881               undo, return error .
      882           end.
      883           else do:
      884               message
      885               vss-workfile vss-revision vss-description
      886               skip  "Ошибка входа на объект"
      887               skip
      888               skip  return-value
      889                       trim(error-status :get-message(1))
      890                       trim(error-status :get-message(2))
      891                       trim(error-status :get-message(3))
      892                       trim(error-status :get-message(4))
      893                       trim(error-status :get-message(5))
      894               view-as alert-box error.
      895               undo, return error .
      896           end.
      897       end.
      898     end.
      899   END.
