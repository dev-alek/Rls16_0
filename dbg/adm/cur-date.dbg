     1113           and buf_obj-date.status_  = 'тек':U
     1114       no-error .
     1115       if not available buf_obj-date
     1116       then do:
     1117           if v-obj-is-active = no
     1118           then do:
     1119               find first buf_obj-date
     1120                   where buf_obj-date.obj-type = p-obj-type
     1121                     and buf_obj-date.obj-code = p-obj-code
     1122               no-error .
     1123               if not available buf_obj-date
     1124               then do:
     1125                   assign
     1126                       v-obj-date              = v-today
     1127                       v-obj-date-is-from-base = yes
     1128                   .
     1129               end.
     1130               else do:
     1131                   message
     1132                       "Не удалось получить дату на неактивном объекте " p-obj-type p-obj-code "."
     1133                       skip "Необходимо установить дату на активном объекте."
     1134                       skip (1) "Обратитесь к администратору системы."
     1135                   view-as alert-box error.
     1136                   undo, return error .
     1137               end.
     1138           end.
     1139           else do:
     1140               if v-allow-date-change = no
     1141               then do:
     1142                   message
     1143                       "Это первый вход в систему на объекте " p-obj-type p-obj-code "."
     1144                       skip "Необходимо установить дату на объекте."
     1145                       skip (1) "Обратитесь к администратору системы."
     1146                   view-as alert-box error.
     1147                   undo, return error .
     1148               end.
     1149               else do:
     1150                   message
     1151                       "Это первый вход в систему на этом объекте."
     1152                       skip (1) "Установите, пожалуйста, дату на объекте."
     1153                   view-as alert-box information.
     1154                   run get-date-from-admin in this-procedure(
     1155                           input "is-obj-date"
     1156                           , input v-shift-obj-on
     1157                           , input v-shift-string
     1158                           , input v-auto-date-change
     1159                           , input " не установлена"
     1160                   ) no-error.
     1161                   if error-status :error or v-endkey-error = yes
     1162                   then do:
     1163                       undo, return no-apply .
     1164                   end.
     1165               end.
     1166           end.
     1167       end.
     1168       else do:
     1169   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1170   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtget in g#library
     1171     (input  p-obj-type
     1172     ,input  p-obj-code
     1173     ,output v-obj-date
     1174     )  .
     1175           if v-obj-is-active = no
     1176           then do:
     1177               assign
     1178                   v-obj-date-is-from-base = yes
     1179               .
     1180           end.
     1181           else do:
     1182               if v-obj-date > v-today
     1183               then do:
     1184                   undo, return error "Дата на объекте больше текущей даты".
     1185               end.
     1186               if v-obj-date = ?
     1187               or v-obj-date + 10 < v-today
     1188               then do:
     1189                   if v-auto-date-change = no
     1190                   and v-obj-date <> ?
     1191                   and p-date-change <> 'change-date':U
     1192                   then do:
     1193                       message
     1194                           "Дата на объекте " p-obj-type p-obj-code
     1195                           skip "отличается от текущей более чем на 10 дней."
     1196                           skip "Вы можете изменить дату на объекте вручную."
     1197                           skip "Для этого воспользуйтесь меню системы, пункт"
     1198                           skip "        Сервис / Изменить дату."
     1199                       view-as alert-box warning.
     1200                       assign
     1201                           v-obj-date-is-from-base = yes
     1202                       .
     1203                   end.
     1204                   else do:
     1205                       if v-allow-date-change = no
     1206                       then do:
     1207                           message
     1208                               "Дата на объекте " p-obj-type p-obj-code " не определена"
     1209                               skip "или на объект не входили более 10 дней."
     1210                               skip "Необходимо установить дату на объекте."
     1211                               skip (1) "Обратитесь к администратору системы."
     1212                           view-as alert-box error.
     1213                           undo, return error .
     1214                       end.
     1215                       else do:
     1216                           if p-date-change <> 'change-date':U
     1217                           then do:
     1218                               message
     1219                                   "Дата на объекте " p-obj-type p-obj-code " не определена"
     1220                                   skip "или на объект не входили более 10 дней."
     1221                                   skip (1) "Установите, пожалуйста, дату на объекте."
     1222                               view-as alert-box information.
     1223                           end.
     1224                           run get-date-from-admin in this-procedure(
     1225                               input "is-obj-date"
     1226                               , input v-shift-obj-on
     1227                               , input v-shift-string
     1228                               , input v-auto-date-change
     1229                               , input ( if v-obj-date = ? then " не установлена" else string( v-obj-date, '99/99/9999':u ) )
     1230                           ) no-error .
     1231                           if error-status :error or v-endkey-error = yes
     1232                           then do:
     1233                               undo, return error .
     1234                           end.
     1235                       end.
     1236                   end.
     1237               end.
     1238               else do:
     1239                   if v-obj-date < v-today
     1240                   then do:
     1241                       if v-auto-date-change = yes
     1242                       or p-date-change = 'change-date':U
     1243                       then do:
     1244                           run get-date-from-admin in this-procedure(
     1245                                             input ""
     1246                                           , input v-shift-obj-on
     1247                                           , input v-shift-string
     1248                                           , input v-auto-date-change
     1249                                           , input string( v-obj-date, '99/99/9999':u )
     1250                           ) no-error.
     1251                           if error-status :error or v-endkey-error = yes
     1252                           then do:
     1253                               undo, return error .
     1254                           end.
     1255                       end.
     1256                       else do:
     1257                           assign
     1258                               v-obj-date-is-from-base = yes
     1259                           .
     1260                       end.
     1261                       run check-shift-days in this-procedure (
     1262                           output p-error-code
     1263                       ) no-error.
     1264                       if error-status :error
     1265                       then do:
     1266                           message
     1267                             vss-workfile vss-revision vss-description
     1268                             skip "Ошибка продолжительности смены."
     1269                             skip return-value
     1270                             skip trim(error-status :get-message(1))
     1271                                  trim(error-status :get-message(2))
     1272                                  trim(error-status :get-message(3))
     1273                                  trim(error-status :get-message(4))
     1274                                  trim(error-status :get-message(5))
     1275                           view-as alert-box error.
     1276                           undo, return error .
     1277                       end.
     1278                   end.
     1279                   else do:
     1280                       if p-date-change = 'change-date':U
     1281                       then do:
     1282                           message
     1283                               "Дата на объекте равна или больше сегодняшней даты."
     1284                               skip(1) "Изменение даты невозможно."
     1285                           view-as alert-box information.
     1286                       end.
     1287                   end.
     1288               end.
     1289           end.
     1290       end.
     1291       if v-obj-is-active = yes
     1292       then do:
     1293           run check-shift-days in this-procedure (
     1294               output p-error-code
     1295           ) no-error.
     1296           if error-status :error
     1297           then do:
     1298               message
     1299                   vss-workfile vss-revision vss-description
     1300                   skip "Ошибка продолжительности смены."
     1301                   skip return-value
     1302                   skip trim(error-status :get-message(1))
     1303                       trim(error-status :get-message(2))
     1304                       trim(error-status :get-message(3))
     1305                       trim(error-status :get-message(4))
     1306                       trim(error-status :get-message(5))
     1307               view-as alert-box error.
     1308               undo, return error .
     1309           end.
     1310       end.
     1311       else do:
     1312           if p-date-change = 'change-date':U
     1313           then do:
     1314               message
     1315                   skip "Изменение даты невозможно:"
     1316                   skip "Объект не активен."
     1317               view-as alert-box error.
     1318           end.
     1319       end.
     1320       if v-obj-date-is-from-base = no
     1321       then do:
     1322           find first buf_obj-date no-lock
     1323                where buf_obj-date.obj-type = p-obj-type
     1324                  and buf_obj-date.obj-code = p-obj-code
     1325                  and buf_obj-date.status_  = 'тек':U
     1326           no-error .
     1327           if not available buf_obj-date
     1328           then do:
     1329   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
