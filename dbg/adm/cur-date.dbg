     1359   END PROCEDURE.
     1360   PROCEDURE get-date-from-admin :
     1361   do
     1362   on error undo, return error
     1363   :
     1364   define input parameter p-is-obj-date        as character    no-undo.
     1365   define input parameter p-shift-enabled      as logical      no-undo.
     1366   define input parameter p-shift-string       as character    no-undo.
     1367   define input parameter p-auto-date          as logical      no-undo.
     1368   define input parameter p-last-date-string   as character    no-undo.
     1369       define variable v-entered-date-ok as logical    no-undo.
     1370       RUN enable_UI.
     1371       assign
     1372           ed-info :screen-value in frame d-cur-date = "Объект: " + p-obj-type + " " + string( p-obj-code )
     1373                                   + ( if p-shift-enabled then ", сменный" else "" )
     1374                                   + ( if p-shift-enabled then chr(10) + p-shift-string else "" )
     1375                                   + chr(10) + ( if p-auto-date     then "Автоматическая смена даты" else "Не автоматическая смена даты" )
     1376                                   + chr(10) + "Дата на объекте: " + p-last-date-string
     1377           v-entered-date-ok   = no
     1378           v-endkey-error      = no
     1379       .
     1380       do while v-entered-date-ok = no
     1381       and v-endkey-error = no
     1382       :
     1383           WAIT-FOR GO OF FRAME d-cur-date focus cur-date.
     1384           assign cur-date.
     1385           if ( cur-date > v-obj-date
     1386               and cur-date <= v-today )
     1387           or v-obj-date = ?
     1388           then do:
     1389               assign
     1390                   v-entered-date-ok   = yes
     1391               .
     1392           end.
     1393           else do:
     1394               message
     1395               "Введенная дата меньше или равна дате на объекте"
     1396               skip "или больше текущей даты."
     1397               skip (1) "Установите дату правильно или отмените операцию."
     1398               view-as alert-box error.
     1399           end.
     1400       end.
     1401       RUN disable_UI.
     1402       if p-is-obj-date = "is-obj-date"
     1403       then do:
     1404           assign
     1405               v-obj-date = cur-date
     1406           .
     1407       end.
     1408       if cur-date < v-obj-date
     1409       or cur-date > v-today
     1410       then do:
     1411           message
     1412             vss-workfile vss-revision vss-description
     1413             skip "Введенная дата больше даты на сервере"
     1414             skip "или меньше текущей даты на объекте."
     1415             skip return-value
     1416             skip trim(error-status :get-message(1))
     1417                  trim(error-status :get-message(2))
     1418                  trim(error-status :get-message(3))
     1419                  trim(error-status :get-message(4))
     1420                  trim(error-status :get-message(5))
     1421           view-as alert-box error.
     1422           undo, return error .
     1423       end.
     1424       if v-auto-date-change = yes
     1425       and cur-date <> v-today
     1426       then do:
     1427           undo, return error.
     1428       end.
     1429       assign
     1430           v-obj-date = cur-date
     1431           v-obj-date-is-from-base = no
     1432       .
     1433       run set-all-active-auto-objects in this-procedure (
     1434           input v-obj-date
     1435       ) no-error.
     1436   end.
     1437   END PROCEDURE.
     1438   PROCEDURE set-all-active-auto-objects :
     1439   do
     1440   on error undo, return error
     1441   :
     1442   define input parameter p-obj-date   as date         no-undo.
     1443       define buffer buf_obj-date      for ub.obj-date.
     1444       define variable v-auto-date-change  as logical       no-undo.
     1445       define variable v-obj-is-active     as logical       no-undo.
     1446       define buffer buf_db for ub.db .
     1447       define buffer buf_clients for ub.clients .
     1448       objects-of-base:
     1449       for each buf_db no-lock
     1450       on error undo, return error return-value
     1451       :
     1452         for each buf_clients no-lock
     1453           where buf_clients.db-num = buf_db.db-num
     1454         :
     1455             if  buf_clients.obj-type = p-obj-type
     1456             and buf_clients.obj-code = p-obj-code
     1457             then do:
     1458                 next objects-of-base.
     1459             end.
     1460   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1462     (input  buf_clients.obj-type
     1463     ,input  buf_clients.obj-code
     1464     ,input  'autodate=request'
     1465     ,output v-auto-date-change
     1466     ) no-error .
     1467             if error-status :error
     1468             then do:
     1469                 message
     1470                     vss-workfile vss-revision vss-description
     1471                     skip "Ошибка при определении атрибута объекта."
     1472                     skip "Объект" buf_clients.obj-type buf_clients.obj-code
     1473                     skip "Атрибут" 'autodate=request':u
     1474                     skip "(автоматическая/ручная смена даты на объекте)"
     1475                     skip error-status :get-message(1)
     1476                     skip return-value
     1477                     skip "Дата на объекте не изменится."
     1478                 view-as alert-box error .
     1479                 undo, next objects-of-base.
     1480             end.
     1481             if v-auto-date-change = yes
     1482             then do:
     1483   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1484   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1485     (input  buf_clients.obj-type
     1486     ,input  buf_clients.obj-code
     1487     ,input  'active=request'
     1488     ,output v-obj-is-active
     1489     ) no-error .
     1490                 if error-status :error
     1491                 then do:
     1492                     message
     1493                         vss-workfile vss-revision vss-description
     1494                         skip "Ошибка при определении атрибута объекта."
     1495                         skip "Объект" buf_clients.obj-type buf_clients.obj-code
     1496                         skip "Атрибут" 'active=request':u
     1497                         skip "(активность объекта)"
     1498                         skip error-status :get-message(1)
     1499                         skip return-value
     1500                         skip "Дата на объекте не изменится."
     1501                     view-as alert-box error .
     1502                     undo, next objects-of-base.
     1503                 end.
     1504                 if v-obj-is-active = yes
     1505                 then do:
     1506                     find first buf_obj-date no-lock
     1507                         where buf_obj-date.obj-type = buf_clients.obj-type
     1508                           and buf_obj-date.obj-code = buf_clients.obj-code
     1509                           and buf_obj-date.status_  = 'тек':U
     1510                     no-error .
     1511                     if not available buf_obj-date
     1512                     then do:
     1513                         do transaction
     1514                         on error undo, return error
     1515                         :
     1516                             find last buf_obj-date exclusive-lock
     1517                                 where buf_obj-date.obj-type = buf_clients.obj-type
     1518                                   and buf_obj-date.obj-code = buf_clients.obj-code
     1519                             use-index pi
     1520                             no-error
     1521                             no-wait.
     1522                             if not available buf_obj-date
     1523                             then do:
     1524                             end.
     1525                             else do:
     1526                                 if buf_obj-date.status_ = 'зкр':U
     1527                                 then do:
     1528   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtcr in g#library
     1530     (input buf_clients.obj-type
     1531     ,input buf_clients.obj-code
     1532     ,input p-obj-date
     1533     ) no-error .
     1534                                     if error-status :error
     1535                                     then do:
     1536                                         message
     1537                                             vss-workfile vss-revision vss-description
     1538                                             skip "Ошибка при создании даты на объекте."
     1539                                             skip "Объект" buf_clients.obj-type buf_clients.obj-code
     1540                                             skip "Дата  " string( p-obj-date, "99/99/9999" )
     1541                                             skip return-value
     1542                                             skip trim(error-status :get-message(1))
     1543                                         view-as alert-box error.
     1544                                         undo, return error .
     1545                                     end.
     1546                                 end.
     1547                             end.
     1548                         end.
     1549                     end.
     1550                     else do:
     1551                         if buf_obj-date.sys-date < p-obj-date
     1552                         then do:
     1553                             do transaction
     1554                             :
     1555                                 find last buf_obj-date exclusive-lock
     1556                                     where buf_obj-date.obj-type = buf_clients.obj-type
     1557                                       and buf_obj-date.obj-code = buf_clients.obj-code
     1558                                 use-index pi
     1559                                 no-error
     1560                                 no-wait.
     1561                                 if available buf_obj-date
     1562                                 and buf_obj-date.status_ = 'тек':U
     1563                                 and buf_obj-date.sys-date < p-obj-date
     1564                                 then do:
     1565   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtset in g#library
     1567     (input buf_clients.obj-type
     1568     ,input buf_clients.obj-code
     1569     ,input p-obj-date
     1570     ) no-error .
     1571                                     if error-status :error
     1572                                     then do:
     1573                                         message
     1574                                             vss-workfile vss-revision vss-description
     1575                                             skip "Ошибка при изменении даты на объекте."
     1576                                             skip "Объект" buf_clients.obj-type buf_clients.obj-code
     1577                                             skip "Дата  " string( p-obj-date, "99/99/9999" )
     1578                                             skip return-value
     1579                                             skip trim(error-status :get-message(1))
     1580                                         view-as alert-box error.
     1581                                         undo, return error .
     1582                                     end.
     1583                                 end.
     1584                             end.
     1585                         end.
     1586                     end.
     1587                 end.
     1588             end.
     1589         end.
     1590      end.
     1591   end.
     1592   END PROCEDURE.
