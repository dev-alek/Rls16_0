     1334     ) no-error .
     1335               if error-status :error then do:
     1336                   message
     1337                       vss-workfile vss-revision vss-description
     1338                       skip "Ошибка при создании даты на объекте"
     1339                       skip return-value
     1340                       skip trim(error-status :get-message(1))
     1341                           trim(error-status :get-message(2))
     1342                           trim(error-status :get-message(3))
     1343                           trim(error-status :get-message(4))
     1344                           trim(error-status :get-message(5))
     1345                   view-as alert-box error.
