      957                   then do:
      958                       message
      959                           skip "С момента открытия смены N " v-shift-name " порядок " v-shift-num " от " v-shift-start-date
      960                           skip " до введенной даты: " v-obj-date
      961                           skip " прошло более " v-max-shift-days + 1 " дней"
      962                           skip (1)
      963                           skip "Вход на объект возможен"
      964                           skip "только для администратора системы."
      965                           skip "Для работы остальных пользователей на объекте"
      966                           skip "необходимо установить корректную дату ."
      967                       view-as alert-box error.
      968                       assign
      969                          p-error-code = 0
      970                       .
      971                   end.
      972                   else do:
      973                       assign
      974                          p-error-code = 1
      975                       .
      976                       message
      977                           skip "С момента открытия смены N " v-shift-name " порядок " v-shift-num " от " v-shift-start-date
      978                           skip " до введенной даты: " v-obj-date
      979                           skip " прошло более " v-max-shift-days + 1 " дней"
      980                           skip (1)
      981                           skip "Вход на объект возможен"
      982                           skip "только для администратора системы."
      983                       view-as alert-box error.
      984                       undo, return error .
      985                   end.
      986               end.
      987           end.
      988       end.
      989   end.
