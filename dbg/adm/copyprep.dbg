      336   function pascur returns handle ():
      337   define buffer  Buf_user for  _user.
      338    find first gPasSysAdm no-error.
      339    if not available gPasSysAdm then crpas().
      340    define variable vReturn as handle no-undo.
      341    find first Buf_user
      342              where Buf_user._userid    = mloginsysadm
      343              no-error
      344              .
      345      if available Buf_user
      346      then do:
      347          block-pas:
      348          for each gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-lock:
      349             if Buf_user._password eq encode(gpasSysadm.pasw)
      350             then
      351                leave block-pas.
      352          end.
      353      end.
      354      release Buf_user.
      355      if not available gPasSysAdm
      356      then
      357         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      358      vReturn = buffer gPasSysAdm:handle.
      359      return vReturn.
      360   end.
      361   function pasNew returns handle ():
      362      define buffer  sys-ctrl for ub.sys-ctrl.
      363      define buffer  upgrade for ub.upgrade.
      364      define buffer  upgrade-attr for ub.upgrade-attr.
      365      find first gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-error.
      366      if not available gPasSysAdm then crpas().
      367      define variable vReturn as handle no-undo.
      368      find first sys-ctrl no-lock .
      369      block-upg:
      370      for each  upgrade  where upgrade.db-num = sys-ctrl.db-num
      371      no-lock
      372       by upgrade.db-num descending by upgrade.step-num descending
      373          :
      374        leave block-upg.
      375      end.
      376      find first upgrade-attr no-lock where
      377                 upgrade-attr.db-num      = upgrade.db-num and
      378                 upgrade-attr.version-num = upgrade.version-num and
      379                 upgrade-attr.attr-code   = "releace" no-error .
      380      find first  gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm and
      381                                   gPasSysAdm.num eq integer (upgrade-attr.attr-value) no-lock no-error.
      382      release sys-ctrl.
      383      release upgrade.
      384      release upgrade-attr.
      385      if not available gPasSysAdm
      386      then
      387         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      388      vReturn = buffer gPasSysAdm:handle.
      389      return vReturn.
      390   end.
      391   DEFINE BUTTON b-exit AUTO-GO
      392        LABEL "&Ввод"
      393        SIZE 10 BY 1
      394        BGCOLOR 8 .
      395   DEFINE BUTTON b-help
      396        LABEL "Помо&щь"
      397        SIZE 10 BY 1
      398        BGCOLOR 8 .
      399   DEFINE BUTTON b-quit AUTO-END-KEY
      400        LABEL "&Отмена"
      401        SIZE 10 BY 1
      402        BGCOLOR 8 .
      403   DEFINE VARIABLE v-db-copy AS CHARACTER FORMAT "X(256)":U
      404        LABEL "Копия БД"
      405        VIEW-AS FILL-IN
      406        SIZE 46.5 BY 1 NO-UNDO.
      407   DEFINE RECTANGLE RECT-1
      408        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      409        SIZE 60 BY 3.21.
      410   DEFINE FRAME copyprep
      411        b-exit AT ROW 1.17 COL 2
      412        b-quit AT ROW 1.17 COL 12
      413        b-help AT ROW 1.17 COL 52
      414        v-db-copy AT ROW 4 COL 12 COLON-ALIGNED
      415        "Параметры соединения:" VIEW-AS TEXT
      416             SIZE 22 BY .88 AT ROW 2.75 COL 2.88
      417        RECT-1 AT ROW 2.38 COL 2
      418        SPACE(0.87) SKIP(0.36)
      419       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      420            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      421            TITLE "Подготовка копии БД для выгрузки УБД"
      422            CANCEL-BUTTON b-quit.
      423   ASSIGN
      424          FRAME copyprep:SCROLLABLE       = FALSE
      425          FRAME copyprep:HIDDEN           = TRUE.
      426   ON WINDOW-CLOSE OF FRAME copyprep
      427   DO:
      428     APPLY "END-ERROR":U TO SELF.
      429   END.
      430   ON CHOOSE OF b-exit IN FRAME copyprep
      431   DO:
      432     define variable v-pswrd as character no-undo .
      433     define buffer buf_user-login      for ub.user-login .
      434     assign
      435       v-db-copy
      436     .
      437     if v-db-copy = "":U then do:
      438       message
      439         vss-workfile vss-revision vss-description skip
      440         substitute( "Нeобходимо указать параметры соединения с копией ГБД!" ) skip
      441         view-as alert-box error
      442       .
      443       apply "entry":U to v-db-copy in frame copyprep .
      444       return no-apply.
      445     end.
      446     if connected( "db-copy":U ) then do:
      447       disconnect db-copy .
      448     end.
      449     define variable vConect as character no-undo.
      450     vConect = SUBSTITUTE("&1 -ld db-copy -U sysadm -P &2", v-db-copy,"sysadm") .
      451     connect value(vConect) no-error.
      452     if not connected ("db-copy":U) then do:
      453       connect value(v-db-copy) -U odbc -P odbc -ld db-copy no-error.
      454       if not connected ("db-copy":U) then do:
      455         message
      456           vss-workfile vss-revision vss-description skip
      457           substitute( "Не могу соединиться с копией ГБД с параметрами:" ) skip
      458           substitute( "&1", v-db-copy ) skip
      459           error-status :get-message ( error-status :num-messages )
      460           view-as alert-box error
      461         .
      462       end.
      463       else do:
      464         message
      465           vss-workfile vss-revision vss-description skip
      466           substitute( "Не могу соединиться с копией ГБД!" ) skip
      467           error-status :get-message ( error-status :num-messages )
      468           view-as alert-box error
      469         .
      470       end.
      471       apply "entry" to v-db-copy in frame copyprep .
      472       return no-apply.
      473     end.
      474   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      475   create alias db-orig for database 'ub' no-error.
      476   create alias db-copy for database 'db-copy' no-error.
      477   if pdbname( 'ub' ) = pdbname( 'db-copy' )
      478     or pdbname( 'db-copy' ) = "ub":U
      479   then do:
      480     delete alias db-orig .
      481     delete alias db-copy .
      482     message
      483       vss-workfile vss-revision vss-description skip
      484       substitute( "Копии БД должна иметь ФИЗИЧЕСКОЕ ИМЯ отличное от имени исходной БД и от ub." ) skip
      485       substitute( "Физическое имя исходной БД: &1", pdbname( 'ub' ) ) skip
      486       substitute( "Физическое имя копии БД: &1", pdbname( 'db-copy' ) ) skip
      487       view-as alert-box error
      488     .
      489     return no-apply.
      490   end.
      491   run adm/chk-c-db.p ( input 'prep':U
      492                  ,input ?
      493                 ) no-error .
      494   if error-status :error then do:
      495     delete alias db-orig .
      496     delete alias db-copy .
      497     message
      498       vss-workfile vss-revision vss-description skip
      499       substitute( "Ошибка при проверке корректности и подготовке копии БД." ) skip
      500       error-status :get-message ( error-status :num-messages ) skip
      501       return-value
      502       view-as alert-box error
      503     .
      504     return no-apply.
      505   end.
      506   delete alias db-orig .
      507   delete alias db-copy .
      508     if connected( "db-copy":U ) then do:
      509       disconnect db-copy .
      510     end.
      511     assign
      512       p-ok = true
      513     .
      514   END.
      515   ON CHOOSE OF b-quit IN FRAME copyprep
      516   DO:
      517     assign
      518       p-ok = false
      519     .
      520   END.
      521   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   on help of frame copyprep
      523   do:
      524     run gbl/app_help.p
      525       (input this-procedure :file-name
      526       ,input ''
      527       ,input ?
      528       ) no-error.
      529     if error-status :error then do:
      530       message
      531         "Ошибка при вызове помощи"
      532         error-status :get-message(1)
      533         view-as alert-box .
      534     end.
      535   end.
      536   run minbtn-set in this-procedure .
      537   on choose of b-help in frame copyprep
      538   do:
      539     apply "help":u to frame copyprep .
      540   end.
      541   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   procedure minbtn-set :
      543       do
      544           on error undo, return error return-value
      545           :
      546           define variable ii              as integer       no-undo .
      547           define variable fh              as widget-handle no-undo .
      548           define variable hh              as widget-handle no-undo .
      549           define variable v-h             as handle        extent 4 no-undo .
      550           define variable v-name-button   as character     no-undo .
      551           define variable v-help-old-x    as decimal       no-undo .
      552           define variable v-help-old-y    as decimal       no-undo .
      553           define variable v-help-old-size as decimal       no-undo .
      554           define variable v-frame-width   as decimal       no-undo .
      555           define variable jj              as integer       no-undo .
      556           do
      557               on error undo, return error
      558               :
      559               assign
      560                   v-frame-width = frame copyprep:width - 0.3
      561                   fh            = frame copyprep:first-child
      562                   hh            = fh:first-child
      563                   ii            = 1
      564                   .
      565               do while valid-handle(hh):
      566                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      567                   do:
      568                       case lc(hh:name) :
      569                           when "b-help" then
      570                               do:
      571                                   hh:load-image-up("cmp/b-help.bmp":u) .
      572                                   hh:load-image-down("cmp/b-help.bmp":u) .
      573                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      574                                   hh:TOOLTIP = "Помощь" .
      575                                   v-help-old-x = hh:column .
      576                                   v-help-old-y = hh:row    .
      577                                   v-help-old-size = hh:width .
      578                                   hh:width-chars = 2.5 .
      579                               end.
      580                           when "b-print" then
      581                               do:
      582                                   hh:load-image("cmp/b-print.bmp":u) .
      583                                   hh:TOOLTIP = "Печать" .
      584                                   v-h[ii] = hh:handle .
      585                                   ii = ii + 1 .
      586                                   hh:width-chars = 3 .
      587                               end.
      588                           when "b-history" or
      589                           when "b-hist" then
      590                               do:
      591                                   hh:load-image("cmp/b-hist.bmp":u) .
      592                                   hh:TOOLTIP = "История" .
      593                                   v-h[ii] = hh:handle .
      594                                   ii = ii + 1 .
      595                                   hh:width-chars = 3 .
      596                               end.
      597                           when "b-sch" then
      598                               do:
      599                                   hh:load-image("cmp/b-sch.bmp":u) .
      600                                   hh:TOOLTIP = "Установка Фильтра" .
      601                                   v-h[ii] = hh:handle .
      602                                   ii = ii + 1 .
      603                                   hh:width-chars = 3 .
      604                               end.
      605                           when "b-hist-user" then
      606                               do:
      607                                   hh:load-image("cmp/b-hist.bmp":u) .
      608                                   hh:TOOLTIP = "История пользователя" .
      609                                   ii = ii + 1 .
      610                               end.
      611                       end case.
      612                   end.
      613                   hh = hh:next-sibling.
      614               end.
      615               b-help:column = v-frame-width - b-help:width-chars.
      616               jj = 0.
      617               repeat ii = 4 to 1 by -1 :
      618                   if valid-handle (v-h[ii] ) then
      619                   do:
      620                       jj  = jj + 1 .
      621                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      622                       v-h[ii]:row    = v-help-old-y .
      623                   end.
      624               end.
      625           end.
      626       end.
      627   end procedure.
      628   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME copyprep:PARENT eq ?
      629   THEN FRAME copyprep:PARENT = ACTIVE-WINDOW.
      630   MAIN-BLOCK:
      631   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      632      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      633   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634     run mainmenu_getcntxt in parparentproc
      635       (output v-cntxt-db-num
      636       ,output v-cntxt-userid
      637       ,output v-cntxt-level
      638       ,output v-cntxt-host-code-obj
      639       ,output v-cntxt-obj-type
      640       ,output v-cntxt-obj-code
      641       ,output v-cntxt-db-num-obj
      642       ,output v-cntxt-is-admin
      643       ) .
      644     RUN enable_UI.
      645     assign
      646       p-ok = false
      647     .
      648     WAIT-FOR GO OF FRAME copyprep.
      649   END.
      650   if connected( "db-copy":U ) then do:
      651     disconnect db-copy .
      652   end.
      653   RUN disable_UI.
      654   PROCEDURE disable_UI :
      655     HIDE FRAME copyprep.
      656   END PROCEDURE.
      657   PROCEDURE enable_UI :
      658     DISPLAY v-db-copy
      659         WITH FRAME copyprep.
      660     ENABLE RECT-1 b-exit b-quit b-help v-db-copy
      661         WITH FRAME copyprep.
      662     VIEW FRAME copyprep.
      663   END PROCEDURE.
