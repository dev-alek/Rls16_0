        1   DEFINE BUFFER X_layout-elem FOR ub.layout-elem.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-layout-type as character no-undo .
        6   define input parameter p-device-type as character no-undo .
        7   define input parameter p-mode-id as character no-undo .
        8   define input parameter p-elem-type as integer no-undo .
        9   define input-output parameter p-rid-list as character no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Список элементов раскладок".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   define new global shared variable g#language as character no-undo .
      321   if g#language <> '' and g#language <> 'rus':U then do:
      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   procedure proc-alt-shift-f2:
      325     if not ibs.th.gbl.gbl-var:rcode
      326   then
      327     run gbl\inidebug.p .
      328   end.
      329   procedure proc-alt-shift-f3:
      330     run gbl/prvssinf.p
      331       ( input this-procedure
      332       ) .
      333   end.
      334   define variable v-inform-launched as logical no-undo initial false .
      335   procedure proc-alt-shift-f4:
      336     define variable v-action as character no-undo .
      337     if v-inform-launched = false then do:
      338       assign
      339         v-inform-launched = true
      340       .
      341       run gbl/d-inform.w
      342         (  input self
      343         ,  input this-procedure
      344         , output v-action
      345         ) no-error .
      346       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      347       assign
      348         v-inform-launched = false
      349       .
      350     end.
      351   end.
      352   procedure proc-alt-f1:
      353     run gbl/corrhelp.p
      354       (input this-procedure
      355       ) .
      356   end .
      357   on alt-shift-f2 anywhere do:
      358     run proc-alt-shift-f2.
      359   end.
      360   on alt-shift-f3 anywhere do:
      361     run proc-alt-shift-f3 in this-procedure .
      362   end.
      363   on alt-shift-f4 anywhere do:
      364     run proc-alt-shift-f4 in this-procedure.
      365   end.
      366   on alt-f1 anywhere do:
      367     run proc-alt-f1 in this-procedure .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   FUNCTION mark-string RETURNS CHARACTER
      371     ( input p-recid as recid, input mark-list as character  ) :
      372     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      373   END FUNCTION.
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375     define variable v-cntxt-db-num        as integer   no-undo .
      376     define variable v-cntxt-userid        as character no-undo .
      377     define variable v-cntxt-level         as character no-undo .
      378     define variable v-cntxt-host-code-obj as integer   no-undo .
      379     define variable v-cntxt-obj-type      as character no-undo .
      380     define variable v-cntxt-obj-code      as integer   no-undo .
      381     define variable v-cntxt-db-num-obj    as integer   no-undo .
      382     define variable v-cntxt-is-admin      as logical   no-undo .
      383   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure gen-key-rec :
      385     define input  parameter p-tbl-name    as character no-undo.
      386     define input  parameter p-bh_tbl-name as handle    no-undo.
      387     define output parameter p-key-rec     as character no-undo.
      388     do
      389     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      390     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      391     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      392     :
      393       define variable fh               as handle    no-undo .
      394       define variable v-ok             as logical   no-undo .
      395       define variable v-inform         as character no-undo .
      396       define variable v-ind            as integer   no-undo .
      397       define variable v-idx-field-qnty as integer   no-undo .
      398       if p-tbl-name = ?
      399         or p-tbl-name = "":U
      400       then do:
      401         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      402       end.
      403       if not p-bh_tbl-name:available then do:
      404         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      405       end.
      406       assign
      407         p-key-rec = p-tbl-name
      408         v-inform  = p-bh_tbl-name:index-information(1)
      409         v-ind     = 2
      410       .
      411       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      412       on error undo, return error
      413       :
      414         assign
      415           v-inform = p-bh_tbl-name:index-information( v-ind )
      416           v-ind    = v-ind + 1
      417         .
      418       end.
      419       if v-inform = ?
      420         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      421         or entry( 3, v-inform, ",":U ) <> "1":U
      422       then do:
      423         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      424       end.
      425       else do:
      426         assign
      427           v-idx-field-qnty = num-entries( v-inform ) - 4
      428         .
      429         if v-idx-field-qnty < 2 then do:
      430           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      431         end.
      432         do v-ind = 1 to v-idx-field-qnty by 2
      433         on error undo, return error
      434         :
      435           assign
      436             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      437             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      438           .
      439         end.
      440       end.
      441       if p-key-rec = ? then do:
      442         assign
      443           p-key-rec = "":U
      444         .
      445         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      446       end.
      447     end.
      448     return.
      449   end procedure.
      450   procedure gen-where-keyr-tab :
      451     define input  parameter i-tableSerach as character no-undo.
      452     define input  parameter i-tablekey   as character  no-undo.
      453     define input  parameter p-key-rec    as character  no-undo.
      454     define input  parameter p-key-handle as handle     no-undo .
      455     define input  parameter p-db-name    as character  no-undo .
      456     define input  parameter p-tt-handle  as handle     no-undo .
      457     define output parameter o-Where      as character  no-undo.
      458     do
      459     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      460     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      461     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      462     :
      463       define variable v-full-tbl-name  as character no-undo .
      464       define variable bh_tbl-name      as handle    no-undo .
      465       define variable fh_key           as handle    no-undo .
      466       define variable fh_search        as handle    no-undo .
      467       define variable v-field-num      as integer   no-undo .
      468       define variable v-count-fld      as integer   no-undo .
      469       define variable v-inform         as character no-undo .
      470       define variable v-ind            as integer   no-undo .
      471       define variable v-idx-field-qnty as integer   no-undo .
      472       define variable v-field-name     as character no-undo .
      473       define variable v-field-val      as character no-undo .
      474       define variable v-word-link      as character no-undo .
      475       define variable vTable           as character no-undo.
      476       define variable bh_tbl-key       as handle    no-undo .
      477       assign
      478         p-key-rec = trim( p-key-rec )
      479       .
      480       if p-key-handle <> ? then do:
      481         if not valid-handle(p-key-handle)
      482            or p-key-handle:type <> "buffer"
      483         then do:
      484           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      485         end.
      486         if num-entries( p-key-rec, chr(3) ) > 1
      487           or p-key-rec = ?
      488           or p-key-rec = "":U
      489         then do:
      490           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      491         end.
      492       end.
      493       else do:
      494         if p-key-rec = ?
      495           or p-key-rec = "":U
      496         then do:
      497           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      498         end.
      499       end.
      500       assign
      501         vTable = entry( 1 , p-key-rec, chr(3) )
      502       .
      503       if p-tt-handle <> ?
      504         and ( not valid-handle(p-tt-handle)
      505               or p-tt-handle:type <> "buffer"
      506             )
      507       then do:
      508         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      509       end.
      510       if p-tt-handle = ? then do:
      511         assign
      512           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      513         .
      514         create buffer bh_tbl-name for table v-full-tbl-name .
      515       end.
      516       else do:
      517         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      518       end.
      519       assign
      520         v-inform = bh_tbl-name:index-information(1)
      521         v-ind    = 2
      522       .
      523       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      524       on error undo, return error
      525       :
      526         assign
      527           v-inform = bh_tbl-name:index-information( v-ind )
      528           v-ind    = v-ind + 1
      529         .
      530       end.
      531       if v-inform = ?
      532         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      533         or entry( 3, v-inform, ",":U ) <> "1":U
      534       then do:
      535         delete object bh_tbl-name no-error.
      536         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      537       end.
      538       assign
      539         v-idx-field-qnty = num-entries( v-inform ) - 4
      540       .
      541       if v-idx-field-qnty < 2 then do:
      542         delete object bh_tbl-name no-error.
      543         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      544       end.
      545       assign
      546         o-where     = "where":U
      547         v-word-link = "":U
      548         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      549         v-count-fld = 0
      550       .
      551       if i-tablekey ne "" and i-tablekey ne ?
      552       then do:
      553         assign
      554           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      555         .
      556         create buffer bh_tbl-key for table v-full-tbl-name .
      557       end.
      558       if i-tableSerach ne "" and i-tableSerach ne ?
      559       then do:
      560         delete object bh_tbl-name no-error.
      561         assign
      562           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      563         .
      564         create buffer bh_tbl-name for table v-full-tbl-name .
      565       end.
      566       block_where:
      567       do v-ind = 1 to v-idx-field-qnty by 2
      568       on error undo, return error
      569       :
      570         assign
      571           v-count-fld = v-count-fld + 1
      572         .
      573         if p-key-handle = ?
      574           and v-count-fld > v-field-num
      575         then do:
      576           leave block_where.
      577         end.
      578         define variable VfieldKeyTable as handle no-undo.
      579         assign
      580           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      581           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      582         .
      583         if     bh_tbl-key ne ?
      584         then do:
      585            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      586            if VfieldKeyTable eq ?
      587            then next block_where.
      588         end.
      589         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      590         then
      591            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      592         else
      593            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      594         if p-key-handle = ? then do:
      595           assign
      596             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      597           .
      598         end.
      599         else do:
      600           assign
      601             fh_key = p-key-handle:buffer-field( v-field-name )
      602           .
      603           if fh_key = ?
      604             or not valid-handle( fh_key )
      605           then do:
      606             delete object bh_tbl-name.
      607             if     bh_tbl-key ne ?
      608             then
      609                delete object bh_tbl-key.
      610             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      611           end.
      612           assign
      613             v-field-val = fh_key:buffer-value
      614           .
      615         end.
      616         if fh_search:data-type ="character":U then do:
      617           assign
      618             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      619             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      620             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      621             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      622             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      623             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      624             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      625             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      626             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      627             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      628             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      629             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      630             v-field-val = substitute( '"&1"', v-field-val )
      631           .
      632         end.
      633         assign
      634           o-where = substitute( "&1 &2", o-where, v-field-val )
      635         .
      636         if v-word-link = "":U then do:
      637           assign
      638             v-word-link = "and":U
      639           .
      640         end.
      641       end.
      642       delete object bh_tbl-name.
      643       if     bh_tbl-key ne ?
      644       then
      645          delete object bh_tbl-key.
      646       if p-key-handle = ?
      647         and v-count-fld <> v-field-num
      648       then do:
      649         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      650       end.
      651     end.
      652   end procedure.
      653   procedure gen-hn-keyr-tab :
      654     define input  parameter i-tableSerach as character no-undo.
      655     define input  parameter i-tablekey   as character no-undo.
      656     define input  parameter p-key-rec    as character no-undo.
      657     define input  parameter p-key-handle as handle    no-undo .
      658     define input  parameter p-db-name    as character no-undo .
      659     define input  parameter p-tt-handle  as handle    no-undo .
      660     define input  parameter p-stts-lock  as integer   no-undo .
      661     define output parameter o-hn         as handle    no-undo.
      662     define variable v-full-tbl-name as character no-undo.
      663     define variable v-where         as character no-undo.
      664     define variable bh_tbl-name     as handle    no-undo.
      665     define variable vTable          as character no-undo.
      666     do
      667     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      668     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      669     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      670         run gen-where-keyr-tab(i-tableSerach,
      671                                i-tablekey,
      672                                p-key-rec,
      673                                p-key-handle,
      674                                p-db-name,
      675                                p-tt-handle,
      676                                output v-where).
      677         if i-tableSerach ne "" and i-tableSerach ne ?
      678         then do:
      679            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      680            create buffer bh_tbl-name for table v-full-tbl-name .
      681         end.
      682         else do:
      683            if p-tt-handle = ? then do:
      684               assign
      685                  vTable = entry( 1 , p-key-rec, chr(3) )
      686               .
      687               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      688               create buffer bh_tbl-name for table v-full-tbl-name .
      689            end.
      690            else do:
      691               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      692            end.
      693         end.
      694         if p-tt-handle = ? then do:
      695            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      696         end.
      697         else do:
      698            bh_tbl-name:find-first( v-where ) no-error .
      699         end.
      700         o-hn = bh_tbl-name.
      701      end.
      702   end procedure.
      703   procedure gen-hn-keyr :
      704     define input  parameter p-key-rec    as character no-undo.
      705     define input  parameter p-key-handle as handle    no-undo .
      706     define input  parameter p-db-name    as character no-undo .
      707     define input  parameter p-tt-handle  as handle    no-undo .
      708     define input  parameter p-stts-lock  as integer   no-undo .
      709     define output parameter o-hn         as handle    no-undo.
      710     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      711   end.
      712   procedure gen-row-keyr :
      713     define input  parameter p-key-rec    as character no-undo.
      714     define input  parameter p-key-handle as handle    no-undo .
      715     define input  parameter p-db-name    as character no-undo .
      716     define input  parameter p-tt-handle  as handle    no-undo .
      717     define input  parameter p-stts-lock  as integer   no-undo .
      718     define output parameter p-tbl-row    as rowid     no-undo.
      719     define output parameter p-tbl-name   as character no-undo.
      720     define variable vHn as handle no-undo.
      721       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      722       p-tbl-row = if vHn:available then vHn:rowid else ?.
      723       p-tbl-name =  vHn:table.
      724       delete object vHn no-error.
      725     if p-tbl-row = ? then do:
      726       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      727     end.
      728     else do:
      729       return.
      730     end.
      731   end procedure.
      732   procedure gen-key-fv :
      733     define input  parameter p-key-rec    as character no-undo .
      734     define output parameter p-field-list as character no-undo .
      735     define output parameter p-value-list as character no-undo.
      736     do
      737     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      738     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      739     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      740     :
      741       define variable v-full-tbl-name  as character no-undo .
      742       define variable bh_tbl-name      as handle    no-undo .
      743       define variable v-tbl-name       as character no-undo .
      744       define variable v-field-num      as integer   no-undo .
      745       define variable v-count-fld      as integer   no-undo .
      746       define variable v-inform         as character no-undo .
      747       define variable v-ind            as integer   no-undo .
      748       define variable v-idx-field-qnty as integer   no-undo .
      749       define variable v-delim-key      as character no-undo .
      750       if p-key-rec = ?
      751         or p-key-rec = "":U
      752       then do:
      753         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      754       end.
      755       assign
      756         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      757         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      758       .
      759       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      760       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      761       assign
      762         v-inform = bh_tbl-name:index-information(1)
      763         v-ind    = 2
      764       .
      765       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      766       on error undo, return error
      767       :
      768         assign
      769           v-inform = bh_tbl-name:index-information( v-ind )
      770           v-ind    = v-ind + 1
      771         .
      772       end.
      773       if v-inform = ?
      774         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      775         or entry( 3, v-inform, ",":U ) <> "1":U
      776       then do:
      777         delete object bh_tbl-name no-error.
      778         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      779       end.
      780       assign
      781         v-idx-field-qnty = num-entries( v-inform ) - 4
      782       .
      783       if v-idx-field-qnty < 2 then do:
      784         delete object bh_tbl-name no-error.
      785         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      786       end.
      787       assign
      788         p-field-list = "":U
      789         p-value-list = "":U
      790         v-delim-key  = "":U
      791         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      792         v-count-fld  = 0
      793       .
      794       block_where:
      795       do v-ind = 1 to v-idx-field-qnty by 2
      796       on error undo, return error
      797       :
      798         assign
      799           v-count-fld = v-count-fld + 1
      800         .
      801         if v-count-fld > v-field-num then do:
      802           leave block_where.
      803         end.
      804         assign
      805           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      806           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      807         .
      808         if v-ind = 1 then do:
      809           assign
      810             v-delim-key = chr(3)
      811           .
      812         end.
      813       end.
      814       delete object bh_tbl-name.
      815       if v-count-fld <> v-field-num then do:
      816         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      817       end.
      818     end.
      819   end procedure.
      820   procedure gen-key-field :
      821     define input  parameter p-table      as character no-undo .
      822     define output parameter p-field-list as character no-undo .
      823     do
      824     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      825     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      826     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      827     :
      828       define variable v-full-tbl-name  as character no-undo .
      829       define variable bh_tbl-name      as handle    no-undo .
      830       define variable v-tbl-name       as character no-undo .
      831       define variable v-field-num      as integer   no-undo .
      832       define variable v-count-fld      as integer   no-undo .
      833       define variable v-inform         as character no-undo .
      834       define variable v-ind            as integer   no-undo .
      835       define variable v-idx-field-qnty as integer   no-undo .
      836       define variable v-delim-key      as character no-undo .
      837       if p-table = ?
      838         or p-table = "":U
      839       then do:
      840         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      841       end.
      842       assign
      843         v-tbl-name      = p-table
      844         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      845       .
      846       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      847       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      848       assign
      849         v-inform = bh_tbl-name:index-information(1)
      850         v-ind    = 2
      851       .
      852       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      853       on error undo, return error
      854       :
      855         assign
      856           v-inform = bh_tbl-name:index-information( v-ind )
      857           v-ind    = v-ind + 1
      858         .
      859       end.
      860       if v-inform = ?
      861         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      862         or entry( 3, v-inform, ",":U ) <> "1":U
      863       then do:
      864         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      865       end.
      866       assign
      867         v-idx-field-qnty = num-entries( v-inform ) - 4
      868       .
      869       if v-idx-field-qnty < 2 then do:
      870         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      871       end.
      872       assign
      873         p-field-list = "":U
      874         v-delim-key  = "":U
      875         v-count-fld  = 0
      876       .
      877       block_where:
      878       do v-ind = 1 to v-idx-field-qnty by 2
      879       on error undo, return error
      880       :
      881         assign
      882           v-count-fld = v-count-fld + 1
      883         .
      884         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      885         if v-ind = 1 then do:
      886           assign
      887             v-delim-key = chr(3)
      888           .
      889         end.
      890       end.
      891       delete object bh_tbl-name.
      892     end.
      893   end procedure.
      894   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   FUNCTION get-cdm-name RETURNS CHARACTER
      896     ( input p-mode-id as character) :
      897   define buffer buf_wi-mode for ub.wi-mode.
      898   find first   buf_wi-mode no-lock where
      899               buf_wi-mode.mode-id = p-mode-id
      900           and buf_wi-mode.mode-type = 'cd-IBS-TH':U
      901               no-error.
      902   if available buf_wi-mode then do:
      903     return buf_wi-mode.mode-name.
      904   end.
      905   RETURN "".
      906   END FUNCTION.
      907   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      908   define variable v-admin as logical no-undo .
      909   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      910   define variable v-rid-list as character no-undo .
      911   DEFINE VARIABLE lkp-option AS CHARACTER NO-UNDO.
      912   define variable v-list-mode as character no-undo.
      913   define variable vh-layout-type-name as handle no-undo .
      914   define variable vh-cdm-name as handle no-undo .
      915   DEFINE VARIABLE v-all-devices-list-itemS AS CHARACTER NO-UNDO.
      916   DEFINE VARIABLE V-SCREEN-LIST-ITEMS AS CHARACTER NO-UNDO.
      917   DEFINE VARIABLE V-KEYBOARD-LIST-ITEMS AS CHARACTER NO-UNDO.
      918   DEFINE BUTTON b-add
      919        LABEL "&Добавить"
      920        SIZE 10 BY 1.
      921   DEFINE BUTTON b-chg
      922        LABEL "&Изменить"
      923        SIZE 10 BY 1.
      924   DEFINE BUTTON b-del
      925        LABEL "&Удалить"
      926        SIZE 10 BY 1.
      927   DEFINE BUTTON B-Help
      928        LABEL "Помо&щь"
      929        SIZE 3 BY 1
      930        BGCOLOR 8 .
      931   DEFINE BUTTON b-lkp
      932        LABEL "&Просмотр"
      933        SIZE 10 BY 1.
      934   DEFINE BUTTON b-mark
      935        LABEL "&*"
      936        SIZE 4 BY 1.
      937   DEFINE BUTTON b-quit AUTO-END-KEY
      938        LABEL "&Выход"
      939        SIZE 10 BY 1
      940        BGCOLOR 8 .
      941   DEFINE BUTTON b-sel AUTO-GO
      942        LABEL "Выбор"
      943        SIZE 10 BY 1.
      944   DEFINE VARIABLE CB-device-type AS CHARACTER FORMAT "X(256)":U
      945        LABEL "Устройство"
      946        VIEW-AS COMBO-BOX INNER-LINES 5
      947        LIST-ITEMS "Item 1"
      948        DROP-DOWN-LIST
      949        SIZE 21.5 BY 1 NO-UNDO.
      950   DEFINE VARIABLE Cb-elem-type AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      951        VIEW-AS COMBO-BOX INNER-LINES 5
      952        LIST-ITEM-PAIRS "Item 1",0
      953        DROP-DOWN-LIST
      954        SIZE 31 BY 1 NO-UNDO.
      955   DEFINE VARIABLE CB-layout-type AS CHARACTER FORMAT "X(256)":U
      956        LABEL "Тип раскладки"
      957        VIEW-AS COMBO-BOX INNER-LINES 5
      958        LIST-ITEM-PAIRS "Item 1","Item 1"
      959        DROP-DOWN-LIST
      960        SIZE 24 BY 1 NO-UNDO.
      961   DEFINE VARIABLE CB-mode-id AS CHARACTER FORMAT "X(256)":U
      962        LABEL "Режим"
      963        VIEW-AS COMBO-BOX INNER-LINES 5
      964        LIST-ITEM-PAIRS "Item 1","Item 1"
      965        DROP-DOWN-LIST
      966        SIZE 48 BY 1 NO-UNDO.
      967   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      968         VIEW-AS TEXT
      969        SIZE 9 BY .67
      970        FGCOLOR 10  NO-UNDO.
      971   DEFINE QUERY br-layout-elem FOR
      972         X_layout-elem SCROLLING.
      973   DEFINE BROWSE br-layout-elem
      974     QUERY br-layout-elem NO-LOCK DISPLAY
      975         mark-string(recid(X_layout-elem), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      976   entry (lookup (X_layout-elem.layout-type, 'th-pos-screen,th-pos-keyboard':U) + 1, ',' + 'Экран IBS TH POS,Клавиатура IBS TH POS':U) COLUMN-LABEL "Тип раскладки" FORMAT "X(255)" WIDTH 20
      977   X_layout-elem.device-type COLUMN-LABEL "Для устройства" FORMAT "X(15)"
      978   get-cdm-name(X_layout-elem.mode-id) COLUMN-LABEL "Режим" FORMAT "X(255)" width 25
      979   X_layout-elem.widget-id COLUMN-LABEL "Элемент"
      980   X_layout-elem.DES COLUMN-LABEL "Описание" format "X(255)" width 35
      981   entry (lookup (STRING(X_layout-elem.elem-type), '0,-1':U) + 1, ',' + 'Программируемый,Непрограммируемый':U) COLUMN-LABEL "Тип" FORMAT "X(15)"
      982       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 18 FIT-LAST-COLUMN.
      983   DEFINE FRAME Dialog-Frame
      984        b-quit AT ROW 1 COL 1
      985        b-mark AT ROW 1 COL 20 WIDGET-ID 12
      986        b-sel AT ROW 1 COL 24 WIDGET-ID 10
      987        b-add AT ROW 1 COL 34 WIDGET-ID 2
      988        b-chg AT ROW 1 COL 44 WIDGET-ID 4
      989        b-del AT ROW 1 COL 54 WIDGET-ID 8
      990        b-lkp AT ROW 1 COL 64 WIDGET-ID 6
      991        B-Help AT ROW 1 COL 95
      992        CB-layout-type AT ROW 2 COL 1.5 WIDGET-ID 16
      993        CB-device-type AT ROW 2 COL 41 WIDGET-ID 18
      994        Cb-elem-type AT ROW 2.87 COL 65.5 COLON-ALIGNED NO-LABEL WIDGET-ID 22
      995        CB-mode-id AT ROW 3 COL 1 WIDGET-ID 20
      996        br-layout-elem AT ROW 4.87 COL 1.5 WIDGET-ID 100
      997        mark-num AT ROW 1 COL 11 NO-LABEL WIDGET-ID 14
      998        SPACE(78.59) SKIP(21.21)
      999       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1000            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1001            TITLE ""
     1002            CANCEL-BUTTON b-quit.
     1003   ASSIGN
     1004          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1005          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1006   ON GO OF FRAME Dialog-Frame
     1007   DO:
     1008     p-rid-list = v-rid-list.
     1009   END.
     1010   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1011   DO:
     1012     APPLY "END-ERROR":U TO SELF.
     1013   END.
     1014   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1015   DO:
     1016    define variable v-rec as recid no-undo.
     1017     run adm/layoutei.w ( input parparentproc
     1018                          ,input 'ДОБАВЛЕНИЕ':U + chr(44) + (if v-admin then "admin" else '')
     1019                          ,input cb-layout-type
     1020                          ,input cb-device-type
     1021                          ,input cb-mode-id
     1022                          ,input ''
     1023                          ,input-output v-rec) no-error.
     1024     if v-rec <> ? then do:
     1025       RUN openbr IN THIS-PROCEDURE.
     1026     end.
     1027   END.
     1028   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1029   DO:
     1030     define variable v-rec as recid no-undo.
     1031     if not available X_layout-elem then return no-apply.
     1032     v-rec = recid(X_layout-elem).
     1033     run adm/layoutei.w ( input parparentproc
     1034                          ,input 'ИЗМЕНЕНИЕ':U + chr(44) + (if v-admin then "admin" else '')
     1035                          ,input X_layout-elem.layout-type
     1036                          ,input X_layout-elem.device-type
     1037                          ,input X_layout-elem.mode-id
     1038                          ,input X_layout-elem.widget-id
     1039                          ,input-output v-rec) no-error.
     1040     if v-rec <> ? then do:
     1041        br-layout-elem:refresh().
     1042     end.
     1043   END.
     1044   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1045   DO:
     1046     define variable v-rec as recid no-undo.
     1047     define variable glog as logical no-undo.
     1048     if not available X_layout-elem then return no-apply.
     1049     v-rec = recid(X_layout-elem).
     1050     message
     1051     "Вы уверены, что хотите удалить элемент раскладки?"
     1052     view-as alert-box question buttons yes-no update glog.
     1053     if not glog then return no-apply.
     1054    run adm/layoute3.p (
     1055                              input no
     1056                             ,input v-rec
     1057                             ) no-error.
     1058    if error-status:error then return no-apply.
     1059    run Openbr in this-procedure .
     1060   END.
     1061   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1062   DO:
     1063   if not available X_layout-elem then return no-apply.
     1064   run proc-b-lkp IN THIS-PROCEDURE ( INPUT 'layout-elem':U) NO-ERROR.
     1065   IF ERROR-STATUS:ERROR THEN DO:
     1066       lkp-option = '':U.
     1067       RETURN NO-APPLY.
     1068   END.
     1069   lkp-option = '':U.
     1070   END.
     1071   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1072   DO:
     1073     define variable glog as logical no-undo .
     1074     if available X_layout-elem then do:
     1075   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   define variable v-str-recid6 as character no-undo .
     1077   define variable v-num-entry6 as integer   no-undo .
     1078   assign
     1079     v-str-recid6 = trim( string( recid( X_layout-elem ) , "->>>>>>>>>>>9":U ) )
     1080     v-num-entry6 = lookup( v-str-recid6 , v-rid-list )
     1081   .
     1082   if v-num-entry6 > 0 then do:
     1083     assign
     1084       entry( v-num-entry6, v-rid-list ) = "":U
     1085       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1086     .
     1087   end.
     1088   else do:
     1089     assign
     1090       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid6
     1091     .
     1092   end.
     1093     glog = br-layout-elem:refresh() .
     1094     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1095         glog = br-layout-elem:select-next-row ().
     1096         apply "VALUE-CHANGED" to br-layout-elem in frame Dialog-Frame.
     1097     end.
     1098     if num-entries( v-rid-list ) = 0
     1099     then
     1100         hide mark-num in frame Dialog-Frame.
     1101     else
     1102         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1103   end.
     1104   apply "entry" to br-layout-elem in frame Dialog-Frame.
     1105   END.
     1106   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1107   DO:
     1108     if available X_layout-elem then do:
     1109       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1110       then  v-rid-list = string( recid( X_layout-elem ) ) .
     1111     end.
     1112   END.
     1113   ON VALUE-CHANGED OF CB-device-type IN FRAME Dialog-Frame
     1114   DO:
     1115       assign
     1116     cb-device-type.
     1117     run openbr in this-procedure no-error.
     1118   END.
     1119   ON VALUE-CHANGED OF Cb-elem-type IN FRAME Dialog-Frame
     1120   DO:
     1121       assign
     1122     cb-elem-type.
     1123     run openbr in this-procedure no-error.
     1124   END.
     1125   ON VALUE-CHANGED OF CB-layout-type IN FRAME Dialog-Frame
     1126   DO:
     1127     assign
     1128     cb-layout-type.
     1129     case cb-layout-type:
     1130       when '' then do:
     1131         ASSIGN
     1132        cb-device-type:LIST-ITEMS IN FRAME Dialog-Frame = chr(44) +
     1133                                                                v-keyboard-list-items + chr(44) +
     1134                                                                v-screen-list-items
     1135                                                           .
     1136       end.
     1137       when 'th-pos-keyboard':U then do:
     1138         assign
     1139         cb-device-type:list-items in frame Dialog-Frame = chr(44) +
     1140                                                                v-keyboard-list-items .
     1141       end.
     1142       when 'th-pos-screen':U then do:
     1143         assign
     1144         cb-device-type:list-items in frame Dialog-Frame = chr(44) +
     1145                                                                v-screen-list-items .
     1146       end.
     1147     end case.
     1148     run openbr in this-procedure no-error.
     1149   END.
     1150   ON VALUE-CHANGED OF CB-mode-id IN FRAME Dialog-Frame
     1151   DO:
     1152       assign
     1153     cb-mode-id.
     1154     run openbr in this-procedure no-error.
     1155   END.
     1156   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1157   on f5 of frame Dialog-Frame anywhere
     1158   do:
     1159      v-doc-rec = recid(X_layout-elem).    RUn OpenBR in this-procedure.  REPOSITION br-layout-elem to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-layout-elem.
     1160       apply "VALUE-CHANGED" to br-layout-elem.
     1161   end.
     1162   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1163   on help of frame Dialog-Frame
     1164   do:
     1165     run gbl/app_help.p
     1166       (input this-procedure :file-name
     1167       ,input ''
     1168       ,input ?
     1169       ) no-error.
     1170     if error-status :error then do:
     1171       message
     1172         "Ошибка при вызове помощи"
     1173         error-status :get-message(1)
     1174         view-as alert-box .
     1175     end.
     1176   end.
     1177   run minbtn-set in this-procedure .
     1178   on choose of b-help in frame Dialog-Frame
     1179   do:
     1180     apply "help":u to frame Dialog-Frame .
     1181   end.
     1182   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   procedure minbtn-set :
     1184       do
     1185           on error undo, return error return-value
     1186           :
     1187           define variable ii              as integer       no-undo .
     1188           define variable fh              as widget-handle no-undo .
     1189           define variable hh              as widget-handle no-undo .
     1190           define variable v-h             as handle        extent 4 no-undo .
     1191           define variable v-name-button   as character     no-undo .
     1192           define variable v-help-old-x    as decimal       no-undo .
     1193           define variable v-help-old-y    as decimal       no-undo .
     1194           define variable v-help-old-size as decimal       no-undo .
     1195           define variable v-frame-width   as decimal       no-undo .
     1196           define variable jj              as integer       no-undo .
     1197           do
     1198               on error undo, return error
     1199               :
     1200               assign
     1201                   v-frame-width = frame Dialog-Frame:width - 0.3
     1202                   fh            = frame Dialog-Frame:first-child
     1203                   hh            = fh:first-child
     1204                   ii            = 1
     1205                   .
     1206               do while valid-handle(hh):
     1207                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1208                   do:
     1209                       case lc(hh:name) :
     1210                           when "b-help" then
     1211                               do:
     1212                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1213                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1214                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1215                                   hh:TOOLTIP = "Помощь" .
     1216                                   v-help-old-x = hh:column .
     1217                                   v-help-old-y = hh:row    .
     1218                                   v-help-old-size = hh:width .
     1219                                   hh:width-chars = 2.5 .
     1220                               end.
     1221                           when "b-print" then
     1222                               do:
     1223                                   hh:load-image("cmp/b-print.bmp":u) .
     1224                                   hh:TOOLTIP = "Печать" .
     1225                                   v-h[ii] = hh:handle .
     1226                                   ii = ii + 1 .
     1227                                   hh:width-chars = 3 .
     1228                               end.
     1229                           when "b-history" or
     1230                           when "b-hist" then
     1231                               do:
     1232                                   hh:load-image("cmp/b-hist.bmp":u) .
     1233                                   hh:TOOLTIP = "История" .
     1234                                   v-h[ii] = hh:handle .
     1235                                   ii = ii + 1 .
     1236                                   hh:width-chars = 3 .
     1237                               end.
     1238                           when "b-sch" then
     1239                               do:
     1240                                   hh:load-image("cmp/b-sch.bmp":u) .
     1241                                   hh:TOOLTIP = "Установка Фильтра" .
     1242                                   v-h[ii] = hh:handle .
     1243                                   ii = ii + 1 .
     1244                                   hh:width-chars = 3 .
     1245                               end.
     1246                           when "b-hist-user" then
     1247                               do:
     1248                                   hh:load-image("cmp/b-hist.bmp":u) .
     1249                                   hh:TOOLTIP = "История пользователя" .
     1250                                   ii = ii + 1 .
     1251                               end.
     1252                       end case.
     1253                   end.
     1254                   hh = hh:next-sibling.
     1255               end.
     1256               b-help:column = v-frame-width - b-help:width-chars.
     1257               jj = 0.
     1258               repeat ii = 4 to 1 by -1 :
     1259                   if valid-handle (v-h[ii] ) then
     1260                   do:
     1261                       jj  = jj + 1 .
     1262                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1263                       v-h[ii]:row    = v-help-old-y .
     1264                   end.
     1265               end.
     1266           end.
     1267       end.
     1268   end procedure.
     1269   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1270   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1271   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1272   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1273   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1274   define variable v-diasize-current-frame-height as decimal   no-undo .
     1275   define variable v-diasize-change-size          as logical   no-undo .
     1276   define variable v-diasize-resize-button        as handle    no-undo .
     1277   define variable v-diasize-wndmax               as logical   no-undo .
     1278   define variable v-diasize-wndstore             as logical   no-undo .
     1279   define variable v-diasize-proc-name            as character no-undo .
     1280   define variable v-diasize-browse-handle        as handle    no-undo .
     1281   define variable v-diasize-browse-number        as integer   no-undo .
     1282   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1283   define temp-table temp-diasize-handle no-undo
     1284     field handle-value  as handle
     1285     field save-position as decimal
     1286     index xpk is primary unique handle-value
     1287     .
     1288   define temp-table temp-browse-handle no-undo
     1289     field browse-type   as character
     1290     field browse-number as integer
     1291     field browse-handle as handle
     1292     field original-size as decimal
     1293     index xpk is primary unique browse-type browse-number
     1294     index xie browse-type browse-handle
     1295   .
     1296   procedure diasize_change-height :
     1297     define input  parameter p-change-value  as decimal   no-undo .
     1298     define input  parameter p-move-resize   as logical   no-undo .
     1299     define variable v-field-group-handle    as handle    no-undo .
     1300     define variable v-object-handle         as handle    no-undo .
     1301     define variable v-frame-height          as decimal   no-undo .
     1302     define variable v-frame-virtual-height  as decimal   no-undo .
     1303     define variable v-browse-height         as decimal   no-undo .
     1304     define variable v-window-height         as decimal   no-undo .
     1305     define variable v-window-virtual-height as decimal   no-undo .
     1306     define variable v-change-sign           as integer   no-undo .
     1307     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1308     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1309     if p-change-value > 0
     1310     then do:
     1311       if frame Dialog-Frame :height + p-change-value
     1312           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1313       then do:
     1314         assign
     1315           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1316                           - (frame Dialog-Frame :height-chars)
     1317         .
     1318         if p-change-value <= 0
     1319         then do:
     1320           run diasize_position-resize-button in this-procedure .
     1321           return .
     1322         end.
     1323       end.
     1324     end.
     1325     if p-change-value < 0
     1326     then do:
     1327       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1328       then do:
     1329         assign
     1330           p-change-value = v-diasize-orig-frame-height
     1331                          - (frame Dialog-Frame :height-chars)
     1332         .
     1333         if p-change-value >= 0
     1334         then do:
     1335           run diasize_position-resize-button in this-procedure .
     1336           return .
     1337         end.
     1338       end.
     1339     end.
     1340     if p-change-value >= 0
     1341     then do:
     1342       assign
     1343         v-change-sign = 1
     1344       .
     1345     end.
     1346     else do:
     1347       assign
     1348         v-change-sign = -1
     1349       .
     1350     end.
     1351     assign
     1352       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1353     .
     1354     if p-change-value = 0
     1355     then do:
     1356       run diasize_position-resize-button in this-procedure .
     1357       return .
     1358     end.
     1359     move_block:
     1360     do
     1361     on error undo move_block, retry move_block
     1362     :
     1363       if retry
     1364       then do:
     1365         do
     1366         on error undo move_block, leave move_block
     1367         :
     1368           if p-change-value > 0
     1369           then do:
     1370             for each buf_temp-diasize-handle
     1371             on error undo, next
     1372             :
     1373               assign
     1374                 v-object-handle = buf_temp-diasize-handle.handle-value
     1375               .
     1376               if v-object-handle <> v-diasize-resize-button
     1377               then do:
     1378                 assign
     1379                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1380                 .
     1381               end.
     1382             end.
     1383             assign
     1384               v-diasize-browse-handle :height = v-browse-height
     1385             .
     1386             for each buf_temp-browse-handle
     1387               where buf_temp-browse-handle.browse-type = 'height':u
     1388             on error undo, next
     1389             :
     1390               assign
     1391                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1392               .
     1393             end.
     1394             assign
     1395               frame Dialog-Frame :height = v-frame-height
     1396             .
     1397             if frame Dialog-Frame :scrollable = true
     1398             then do:
     1399               assign
     1400                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1401               .
     1402             end.
     1403             run diasize_position-resize-button in this-procedure .
     1404           end.
     1405           else do:
     1406             if frame Dialog-Frame :scrollable = true
     1407             then do:
     1408               assign
     1409                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1410               .
     1411             end.
     1412             assign
     1413               frame Dialog-Frame :height = v-frame-height
     1414             .
     1415             assign
     1416               v-diasize-browse-handle :height = v-browse-height
     1417             .
     1418             for each buf_temp-browse-handle
     1419               where buf_temp-browse-handle.browse-type = 'height':u
     1420             on error undo, next
     1421             :
     1422               assign
     1423                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1424               .
     1425             end.
     1426             for each buf_temp-diasize-handle
     1427             on error undo, next
     1428             :
     1429               assign
     1430                 v-object-handle = buf_temp-diasize-handle.handle-value
     1431               .
     1432               if v-object-handle <> v-diasize-resize-button
     1433               then do:
     1434                 assign
     1435                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1436                 .
     1437               end.
     1438             end.
     1439             run diasize_position-resize-button in this-procedure .
     1440           end.
     1441           assign
     1442             v-diasize-change-size = false
     1443           .
     1444           leave move_block .
     1445         end.
     1446       end.
     1447       assign
     1448         v-diasize-need-full-display = true
     1449       .
     1450       if v-diasize-change-size = false
     1451       then do:
     1452         assign
     1453           v-diasize-change-size = true
     1454         .
     1455       end.
     1456       else do:
     1457         return .
     1458       end.
     1459       assign
     1460         v-frame-height = frame Dialog-Frame :height
     1461         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1462         v-browse-height = v-diasize-browse-handle :height
     1463       .
     1464       for each buf_temp-browse-handle
     1465         where buf_temp-browse-handle.browse-type = 'height':u
     1466       :
     1467         assign
     1468           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1469         .
     1470       end.
     1471       for each buf_temp-diasize-handle
     1472       :
     1473         delete buf_temp-diasize-handle .
     1474       end.
     1475       assign
     1476         v-field-group-handle = frame Dialog-Frame :first-child
     1477       .
     1478       do while valid-handle(v-field-group-handle)
     1479       :
     1480         assign
     1481           v-object-handle = v-field-group-handle :first-child
     1482         .
     1483         do while valid-handle(v-object-handle)
     1484         :
     1485           if  v-object-handle <> v-diasize-browse-handle :handle
     1486           and can-query(v-object-handle, "row")
     1487           and can-query(v-object-handle, "height")
     1488           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1489           then do:
     1490             find first buf_temp-browse-handle
     1491               where buf_temp-browse-handle.browse-type   = 'height':u
     1492                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1493               no-error .
     1494             if available buf_temp-browse-handle
     1495             then do:
     1496             end.
     1497             else do:
     1498               create buf_temp-diasize-handle .
     1499               assign
     1500                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1501                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1502               .
     1503             end.
     1504           end.
     1505           assign
     1506             v-object-handle = v-object-handle :next-sibling
     1507           .
     1508         end.
     1509         assign
     1510           v-field-group-handle = v-field-group-handle :next-sibling
     1511         .
     1512       end.
     1513       do with frame Dialog-Frame
     1514       :
     1515         hide v-diasize-resize-button .
     1516         assign
     1517           v-diasize-resize-button :row    = 1
     1518           v-diasize-resize-button :column = 1
     1519         .
     1520       end.
     1521       if p-change-value > 0
     1522       then do:
     1523         if frame Dialog-Frame :scrollable = true
     1524         then do:
     1525           assign
     1526             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1527             no-error .
     1528           if error-status :error
     1529           or error-status :get-message(1) <> ""
     1530           then do:
     1531             undo move_block, retry move_block .
     1532           end.
     1533         end.
     1534         assign
     1535           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1536           no-error .
     1537         if error-status :error
     1538         or error-status :get-message(1) <> ""
     1539         then do:
     1540           undo move_block, retry move_block .
     1541         end.
     1542         assign
     1543           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1544           no-error .
     1545         if error-status :error
     1546         or error-status :get-message(1) <> ""
     1547         then do:
     1548           undo move_block, retry move_block .
     1549         end.
     1550         for each buf_temp-browse-handle
     1551           where buf_temp-browse-handle.browse-type = 'height':u
     1552         on error undo move_block, retry move_block
     1553         :
     1554           assign
     1555             buf_temp-browse-handle.browse-handle :height
     1556               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1557             no-error .
     1558           if error-status :error
     1559           or error-status :get-message(1) <> ""
     1560           then do:
     1561             undo move_block, retry move_block .
     1562           end.
     1563         end.
     1564         for each buf_temp-diasize-handle
     1565         on error undo move_block, retry move_block
     1566         :
     1567           assign
     1568             v-object-handle = buf_temp-diasize-handle.handle-value
     1569           .
     1570           if v-object-handle <> v-diasize-resize-button
     1571           then do:
     1572             assign
     1573               v-object-handle :row = v-object-handle :row + p-change-value
     1574               no-error .
     1575             if error-status :error
     1576             or error-status :get-message(1) <> ""
     1577             then do:
     1578               undo move_block, retry move_block .
     1579             end.
     1580           end.
     1581         end.
     1582       end.
     1583       else do:
     1584         for each buf_temp-diasize-handle
     1585         on error undo move_block, retry move_block
     1586         :
     1587           assign
     1588             v-object-handle = buf_temp-diasize-handle.handle-value
     1589           .
     1590           if v-object-handle <> v-diasize-resize-button
     1591           then do:
     1592             assign
     1593               v-object-handle :row = v-object-handle :row + p-change-value
     1594               no-error .
     1595             if error-status :error
     1596             or error-status :get-message(1) <> ""
     1597             then do:
     1598               undo move_block, retry move_block .
     1599             end.
     1600           end.
     1601         end.
     1602         assign
     1603           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1604           no-error .
     1605         if error-status :error
     1606         or error-status :get-message(1) <> ""
     1607         then do:
     1608           undo move_block, retry move_block .
     1609         end.
     1610         for each buf_temp-browse-handle
     1611           where buf_temp-browse-handle.browse-type = 'height':u
     1612         on error undo move_block, retry move_block
     1613         :
     1614           assign
     1615             buf_temp-browse-handle.browse-handle :height
     1616               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1617             no-error .
     1618           if error-status :error
     1619           or error-status :get-message(1) <> ""
     1620           then do:
     1621             undo move_block, retry move_block .
     1622           end.
     1623         end.
     1624         assign
     1625           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1626           no-error .
     1627         if error-status :error
     1628         or error-status :get-message(1) <> ""
     1629         then do:
     1630           undo move_block, retry move_block .
     1631         end.
     1632         if frame Dialog-Frame :scrollable = true
     1633         then do:
     1634           assign
     1635             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1636             no-error .
     1637           if error-status :error
     1638           or error-status :get-message(1) <> ""
     1639           then do:
     1640             undo move_block, retry move_block .
     1641           end.
     1642         end.
     1643       end.
     1644       if p-move-resize = true
     1645       then do:
     1646         run diasize_position-resize-button in this-procedure .
     1647       end.
     1648       if v-diasize-wndstore = true
     1649       then do:
     1650         if connected("ub") = true
     1651         then do:
     1652           define variable v-cntxt-db-num        as integer   no-undo .
     1653           define variable v-cntxt-userid        as character no-undo .
     1654           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1655                                             , OUTPUT v-cntxt-userid
     1656                                             ) .
     1657           run gbl/wndsizew.p
     1658             (input  v-cntxt-db-num
     1659             ,input  v-cntxt-userid
     1660             ,input  v-diasize-proc-name
     1661             ,input  'height':u
     1662             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1663             ) .
     1664         end.
     1665       end.
     1666     end.
     1667     assign
     1668       v-diasize-change-size = false
     1669     .
     1670   end procedure.
     1671   procedure diasize_set-height :
     1672     define input  parameter p-new-height  as decimal   no-undo .
     1673     define input  parameter p-move-resize as logical   no-undo .
     1674     do
     1675     on error undo, return error return-value
     1676     :
     1677       run diasize_change-height in this-procedure
     1678         (input  (p-new-height - frame Dialog-Frame :height)
     1679         ,input  p-move-resize
     1680         ) .
     1681     end.
     1682   end procedure.
     1683   procedure diasize_change-width :
     1684     define input  parameter p-change-value as decimal   no-undo .
     1685     define input  parameter p-move-resize  as logical   no-undo .
     1686     define variable v-field-group-handle   as handle    no-undo .
     1687     define variable v-object-handle        as handle    no-undo .
     1688     define variable v-frame-width          as decimal   no-undo .
     1689     define variable v-frame-virtual-width  as decimal   no-undo .
     1690     define variable v-browse-width         as decimal   no-undo .
     1691     define variable v-window-width         as decimal   no-undo .
     1692     define variable v-window-virtual-width as decimal   no-undo .
     1693     define variable v-change-sign          as integer   no-undo .
     1694     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1695     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1696     if p-change-value > 0
     1697     then do:
     1698       if frame Dialog-Frame :width + p-change-value >
     1699           session :width-chars
     1700       then do:
     1701         assign
     1702           p-change-value = session :width-chars - frame Dialog-Frame :width
     1703         .
     1704         if p-change-value <= 0
     1705         then do:
     1706           run diasize_position-resize-button in this-procedure .
     1707           return .
     1708         end.
     1709       end.
     1710     end.
     1711     if p-change-value < 0
     1712     then do:
     1713       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1714       then do:
     1715         assign
     1716           p-change-value = v-diasize-orig-frame-width
     1717                          - frame Dialog-Frame :width
     1718         .
     1719         if p-change-value >= 0
     1720         then do:
     1721           run diasize_position-resize-button in this-procedure .
     1722           return .
     1723         end.
     1724       end.
     1725     end.
     1726     if p-change-value >= 0
     1727     then do:
     1728       assign
     1729         v-change-sign = 1
     1730       .
     1731     end.
     1732     else do:
     1733       assign
     1734         v-change-sign = -1
     1735       .
     1736     end.
     1737     assign
     1738       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1739     .
     1740     if p-change-value = 0
     1741     then do:
     1742       run diasize_position-resize-button in this-procedure .
     1743       return .
     1744     end.
     1745     move_block:
     1746     do
     1747     on error undo move_block, leave move_block
     1748     :
     1749       if retry
     1750       then do:
     1751         do
     1752         on error undo move_block, leave move_block
     1753         :
     1754           if p-change-value > 0
     1755           then do:
     1756             for each buf_temp-diasize-handle
     1757             on error undo, next
     1758             :
     1759               assign
     1760                 v-object-handle = buf_temp-diasize-handle.handle-value
     1761               .
     1762               if v-object-handle <> v-diasize-resize-button
     1763               then do:
     1764                 assign
     1765                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1766                 .
     1767               end.
     1768             end.
     1769             assign
     1770               v-diasize-browse-handle :width = v-browse-width
     1771             .
     1772             for each buf_temp-browse-handle
     1773               where buf_temp-browse-handle.browse-type = 'width':u
     1774             on error undo, next
     1775             :
     1776               assign
     1777                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1778               .
     1779             end.
     1780             assign
     1781               frame Dialog-Frame :width = v-frame-width
     1782             .
     1783             if frame Dialog-Frame :scrollable = true
     1784             then do:
     1785               assign
     1786                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1787               .
     1788             end.
     1789             run diasize_position-resize-button in this-procedure .
     1790           end.
     1791           else do:
     1792             if frame Dialog-Frame :scrollable = true
     1793             then do:
     1794               assign
     1795                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1796               .
     1797             end.
     1798             assign
     1799               frame Dialog-Frame :width = v-frame-width
     1800             .
     1801             for each buf_temp-browse-handle
     1802               where buf_temp-browse-handle.browse-type = 'width':u
     1803             on error undo, next
     1804             :
     1805               assign
     1806                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1807               .
     1808             end.
     1809             assign
     1810               v-diasize-browse-handle :width = v-browse-width
     1811             .
     1812             for each buf_temp-diasize-handle
     1813             on error undo, next
     1814             :
     1815               assign
     1816                 v-object-handle = buf_temp-diasize-handle.handle-value
     1817               .
     1818               if v-object-handle <> v-diasize-resize-button
     1819               then do:
     1820                 assign
     1821                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1822                 .
     1823               end.
     1824             end.
     1825             run diasize_position-resize-button in this-procedure .
     1826           end.
     1827           assign
     1828             v-diasize-change-size = false
     1829           .
     1830           leave move_block .
     1831         end.
     1832       end.
     1833       assign
     1834         v-diasize-need-full-display = true
     1835       .
     1836       if v-diasize-change-size = false
     1837       then do:
     1838         assign
     1839           v-diasize-change-size = true
     1840         .
     1841       end.
     1842       else do:
     1843         return .
     1844       end.
     1845       assign
     1846         v-frame-width = frame Dialog-Frame :width
     1847         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1848         v-browse-width = v-diasize-browse-handle :width
     1849       .
     1850       for each buf_temp-browse-handle
     1851         where buf_temp-browse-handle.browse-type = 'width':u
     1852       :
     1853         assign
     1854           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1855         .
     1856       end.
     1857       for each buf_temp-diasize-handle
     1858       :
     1859         delete buf_temp-diasize-handle .
     1860       end.
     1861       assign
     1862         v-field-group-handle = frame Dialog-Frame :first-child
     1863       .
     1864       do while valid-handle(v-field-group-handle)
     1865       :
     1866         assign
     1867           v-object-handle = v-field-group-handle :first-child
     1868         .
     1869         do while valid-handle(v-object-handle)
     1870         :
     1871           if  v-object-handle <> v-diasize-browse-handle :handle
     1872           and v-object-handle <> v-diasize-resize-button
     1873           and can-query(v-object-handle, "row")
     1874           and can-query(v-object-handle, "height")
     1875           and ( v-object-handle :col + v-object-handle :width
     1876                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1877               )
     1878           then do:
     1879             find first buf_temp-browse-handle
     1880               where buf_temp-browse-handle.browse-type   = 'width':u
     1881                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1882               no-error .
     1883             if available buf_temp-browse-handle
     1884             then do:
     1885             end.
     1886             else do:
     1887               create buf_temp-diasize-handle .
     1888               assign
     1889                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1890                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1891               .
     1892             end.
     1893           end.
     1894           assign
     1895             v-object-handle = v-object-handle :next-sibling
     1896           .
     1897         end.
     1898         assign
     1899           v-field-group-handle = v-field-group-handle :next-sibling
     1900         .
     1901       end.
     1902       do with frame Dialog-Frame
     1903       :
     1904         hide v-diasize-resize-button .
     1905         v-diasize-resize-button :row = 1.
     1906         v-diasize-resize-button :column = 1.
     1907       end.
     1908       if p-change-value > 0
     1909       then do:
     1910         if frame Dialog-Frame :scrollable = true
     1911         then do:
     1912           assign
     1913             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1914             no-error .
     1915           if error-status :error
     1916           or error-status :get-message(1) <> ""
     1917           then do:
     1918             undo move_block, retry move_block.
     1919           end.
     1920         end.
     1921         assign
     1922           frame Dialog-Frame :width = v-frame-width + p-change-value
     1923           no-error .
     1924         if error-status :error
     1925         or error-status :get-message(1) <> ""
     1926         then do:
     1927           undo move_block, retry move_block.
     1928         end.
     1929         assign
     1930           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1931         no-error .
     1932         if error-status :error
     1933         or error-status :get-message(1) <> ""
     1934         then do:
     1935           undo move_block, retry move_block.
     1936         end.
     1937         for each buf_temp-browse-handle
     1938           where buf_temp-browse-handle.browse-type = 'width':u
     1939         on error undo move_block, retry move_block
     1940         :
     1941           assign
     1942             buf_temp-browse-handle.browse-handle :width
     1943               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1944             no-error .
     1945           if error-status :error
     1946           or error-status :get-message(1) <> ""
     1947           then do:
     1948             undo move_block, retry move_block .
     1949           end.
     1950         end.
     1951         for each buf_temp-diasize-handle
     1952         on error undo move_block, retry move_block
     1953         :
     1954           assign
     1955             v-object-handle = buf_temp-diasize-handle.handle-value
     1956           .
     1957           if v-object-handle <> v-diasize-resize-button
     1958           then do:
     1959             assign
     1960               v-object-handle :col = v-object-handle :col + p-change-value
     1961               no-error .
     1962             if error-status :error
     1963             or error-status :get-message(1) <> ""
     1964             then do:
     1965               undo move_block, retry move_block .
     1966             end.
     1967           end.
     1968         end.
     1969       end.
     1970       else do:
     1971         for each buf_temp-diasize-handle
     1972         on error undo move_block, retry move_block
     1973         :
     1974           assign
     1975             v-object-handle = buf_temp-diasize-handle.handle-value
     1976           .
     1977           if v-object-handle <> v-diasize-resize-button
     1978           then do:
     1979             assign
     1980               v-object-handle :col = v-object-handle :col + p-change-value
     1981               no-error .
     1982             if error-status :error
     1983             or error-status :get-message(1) <> ""
     1984             then do:
     1985               undo move_block, retry move_block .
     1986             end.
     1987           end.
     1988         end.
     1989         for each buf_temp-browse-handle
     1990           where buf_temp-browse-handle.browse-type = 'width':u
     1991         on error undo move_block, retry move_block
     1992         :
     1993           assign
     1994             buf_temp-browse-handle.browse-handle :width
     1995               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1996             no-error .
     1997           if error-status :error
     1998           or error-status :get-message(1) <> ""
     1999           then do:
     2000             undo move_block, retry move_block .
     2001           end.
     2002         end.
     2003         assign
     2004           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2005           no-error .
     2006         if error-status :error
     2007         or error-status :get-message(1) <> ""
     2008         then do:
     2009           undo move_block, retry move_block.
     2010         end.
     2011         assign
     2012           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2013         no-error .
     2014         if error-status :error
     2015         or error-status :get-message(1) <> ""
     2016         then do:
     2017           undo move_block, retry move_block.
     2018         end.
     2019         if frame Dialog-Frame :scrollable = true
     2020         then do:
     2021           assign
     2022             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2023           no-error .
     2024           if error-status :error
     2025           or error-status :get-message(1) <> ""
     2026           then do:
     2027             undo move_block, retry move_block.
     2028           end.
     2029         end.
     2030       end.
     2031       if p-move-resize
     2032       then do:
     2033         run diasize_position-resize-button in this-procedure .
     2034       end.
     2035       if v-diasize-wndstore = true
     2036       then do:
     2037         if connected("ub") = true
     2038         then do:
     2039           define variable v-cntxt-db-num        as integer   no-undo .
     2040           define variable v-cntxt-userid        as character no-undo .
     2041           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2042                                             , OUTPUT v-cntxt-userid
     2043                                             ) .
     2044           run gbl/wndsizew.p
     2045             (input  v-cntxt-db-num
     2046             ,input  v-cntxt-userid
     2047             ,input  v-diasize-proc-name
     2048             ,input  'width':u
     2049             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2050             ) .
     2051         end.
     2052       end.
     2053     end.
     2054     assign
     2055       v-diasize-change-size = false
     2056     .
     2057   end procedure.
     2058   procedure diasize_set-width :
     2059     define input  parameter p-new-width  as decimal   no-undo .
     2060     define input  parameter p-move-resize as logical   no-undo .
     2061     do
     2062     on error undo, return error return-value
     2063     :
     2064       run diasize_change-width in this-procedure
     2065         (input  (p-new-width - frame Dialog-Frame :width)
     2066         ,input  p-move-resize
     2067         ) .
     2068     end.
     2069   end procedure.
     2070   procedure diasize_position-resize-button :
     2071     do with frame Dialog-Frame
     2072     :
     2073       hide v-diasize-resize-button .
     2074       assign
     2075         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2076                     - 1
     2077                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2078         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2079                     - 1
     2080                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2081       .
     2082       view v-diasize-resize-button .
     2083     end.
     2084   end procedure.
     2085   on alt-right anywhere
     2086   do:
     2087     run diasize_change-width in this-procedure
     2088       (input 1
     2089       ,input true
     2090       ) .
     2091     return no-apply .
     2092   end.
     2093   on alt-left anywhere
     2094   do:
     2095     run diasize_change-width in this-procedure
     2096       (input -1
     2097       ,input true
     2098       ) .
     2099     return no-apply .
     2100   end.
     2101   on alt-down anywhere
     2102   do:
     2103     run diasize_change-height in this-procedure
     2104       (input 1
     2105       ,input true
     2106       ) .
     2107     return no-apply .
     2108   end.
     2109   on alt-up anywhere
     2110   do:
     2111     run diasize_change-height in this-procedure
     2112       (input -1
     2113       ,input true
     2114       ) .
     2115     return no-apply .
     2116   end.
     2117   on alt-enter of frame Dialog-Frame
     2118   do:
     2119     run diasize_maximize in this-procedure
     2120       (input  ?
     2121       ).
     2122     return no-apply .
     2123   end.
     2124   procedure diasize_end-move :
     2125     do
     2126     on error undo, return error return-value
     2127     :
     2128       define variable v-row-delta as decimal   no-undo .
     2129       define variable v-col-delta as decimal   no-undo .
     2130       define variable v-new-row as decimal   no-undo .
     2131       define variable v-new-col as decimal   no-undo .
     2132       assign
     2133         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2134         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2135       .
     2136       assign
     2137         v-row-delta = v-new-row - frame Dialog-Frame :height
     2138         v-col-delta = v-new-col - frame Dialog-Frame :width
     2139       .
     2140       run diasize_change-height in this-procedure
     2141         (input v-row-delta
     2142         ,input true
     2143         ) .
     2144       run diasize_change-width in this-procedure
     2145         (input v-col-delta
     2146         ,input true
     2147         ) .
     2148     end.
     2149   end procedure.
     2150   procedure diasize_maximize :
     2151     define input  parameter p-action as logical   no-undo .
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155       if p-action = ?
     2156       then do:
     2157         if v-diasize-need-maximize = true
     2158         then do:
     2159           assign
     2160             p-action = true
     2161           .
     2162         end.
     2163         else do:
     2164           assign
     2165             p-action = false
     2166           .
     2167         end.
     2168       end.
     2169       if p-action = true
     2170       then do:
     2171         run diasize_change-height in this-procedure
     2172           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2173               - frame Dialog-Frame :height-chars
     2174           ,input true
     2175           ) .
     2176         run diasize_change-width in this-procedure
     2177           (input session :width-chars
     2178               - frame Dialog-Frame :width-chars
     2179           ,input true
     2180           ) .
     2181         assign
     2182           v-diasize-need-maximize = false
     2183         .
     2184       end.
     2185       else do:
     2186         run diasize_change-width in this-procedure
     2187           (input v-diasize-orig-frame-width
     2188               - frame Dialog-Frame :width-chars
     2189           ,input true
     2190           ) .
     2191         run diasize_change-height in this-procedure
     2192           (input v-diasize-orig-frame-height
     2193               - frame Dialog-Frame :height-chars
     2194           ,input true
     2195           ) .
     2196         assign
     2197           v-diasize-need-maximize = true
     2198         .
     2199       end.
     2200     end.
     2201   end procedure.
     2202   procedure diasize_restore-orig-size :
     2203     do
     2204     on error undo, return error return-value
     2205     :
     2206       assign
     2207         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2208         v-diasize-current-frame-height = frame Dialog-Frame :height
     2209       .
     2210       run diasize_set-height in this-procedure
     2211         (input  v-diasize-orig-frame-height
     2212         ,input  true
     2213         ) .
     2214       run diasize_set-width in this-procedure
     2215         (input  v-diasize-orig-frame-width
     2216         ,input  true
     2217         ) .
     2218     end.
     2219   end procedure.
     2220   procedure diasize_restore-current-size :
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       run diasize_set-height in this-procedure
     2225         (input  v-diasize-current-frame-height
     2226         ,input  true
     2227         ) .
     2228       run diasize_set-width in this-procedure
     2229         (input  v-diasize-current-frame-width
     2230         ,input  true
     2231         ) .
     2232     end.
     2233   end procedure.
     2234   procedure diasize_set-browse-handle :
     2235     define input  parameter p-browse-handle as handle   no-undo .
     2236     define buffer buf_temp-browse-handle for temp-browse-handle .
     2237     do
     2238     on error undo, return error return-value
     2239     :
     2240       assign
     2241         v-diasize-browse-handle = p-browse-handle
     2242       .
     2243       for each buf_temp-browse-handle
     2244       on error undo, return error return-value
     2245       :
     2246         delete buf_temp-browse-handle .
     2247       end.
     2248     end.
     2249   end procedure.
     2250   procedure diasize_add_browse :
     2251     define input  parameter p-browse-type   as character no-undo .
     2252     define input  parameter p-browse-handle as handle    no-undo .
     2253     define buffer buf_temp-browse-handle for temp-browse-handle .
     2254     do
     2255     on error undo, return error return-value
     2256     :
     2257       assign
     2258         v-diasize-browse-number = v-diasize-browse-number + 1
     2259       .
     2260       create buf_temp-browse-handle .
     2261       assign
     2262         buf_temp-browse-handle.browse-type   = p-browse-type
     2263         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2264         buf_temp-browse-handle.browse-handle = p-browse-handle
     2265       .
     2266     end.
     2267   end procedure.
     2268   procedure diasize_init :
     2269     define variable v-default-value    as logical   no-undo .
     2270     define variable v-restore-saved    as logical   no-undo .
     2271     define variable v-resize-value-str as character no-undo .
     2272     do
     2273     on error undo, return error return-value
     2274     :
     2275       do with frame Dialog-Frame
     2276       :
     2277         assign
     2278           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2279           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2280           v-diasize-browse-handle     = browse br-layout-elem :handle
     2281         .
     2282         create button v-diasize-resize-button
     2283         assign
     2284           parent        = frame Dialog-Frame :first-child
     2285           label         = "s"
     2286           height-pixels = 16
     2287           width-pixels  = 16
     2288           visible       = true
     2289           sensitive     = true
     2290           movable       = true
     2291           triggers:
     2292             on end-move persistent run diasize_end-move in this-procedure .
     2293           end triggers.
     2294         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2295         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2296         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2297         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2298         assign
     2299           v-diasize-wndmax = false
     2300         .
     2301         if connected("ub") = true
     2302         then do:
     2303           define variable v-cntxt-db-num        as integer   no-undo .
     2304           define variable v-cntxt-userid        as character no-undo .
     2305           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2306                                             , OUTPUT v-cntxt-userid
     2307                                             ) .
     2308           run gbl/wndpar_r.p
     2309             (input  v-cntxt-db-num
     2310             ,input  v-cntxt-userid
     2311             ,input  'wndmax':U
     2312             ,output v-diasize-wndmax
     2313             ,output v-default-value
     2314             ) .
     2315         end.
     2316         assign
     2317           v-diasize-wndstore = false
     2318         .
     2319         if connected("ub") = true
     2320         then do:
     2321           run gbl/wndpar_r.p
     2322             (input  v-cntxt-db-num
     2323             ,input  v-cntxt-userid
     2324             ,input  'wndstore':U
     2325             ,output v-diasize-wndstore
     2326             ,output v-default-value
     2327             ) .
     2328         end.
     2329         assign
     2330           v-diasize-proc-name = entry(1, program-name(2), '.')
     2331         .
     2332         if v-diasize-wndstore = true
     2333         then do:
     2334           assign
     2335             v-restore-saved = false
     2336           .
     2337           if connected("ub") = true
     2338           then do:
     2339             run gbl/wndsizer.p
     2340               (input  v-cntxt-db-num
     2341               ,input  v-cntxt-userid
     2342               ,input  v-diasize-proc-name
     2343               ,input  'height':u
     2344               ,output v-resize-value-str
     2345               ) .
     2346             if v-resize-value-str <> '':U
     2347             then do:
     2348               run diasize_change-height in this-procedure
     2349                 (input  integer(v-resize-value-str)
     2350                 ,input  true
     2351                 ) .
     2352               assign
     2353                 v-restore-saved = true
     2354               .
     2355             end.
     2356           end.
     2357           if connected("ub") = true
     2358           then do:
     2359             run gbl/wndsizer.p
     2360               (input  v-cntxt-db-num
     2361               ,input  v-cntxt-userid
     2362               ,input  v-diasize-proc-name
     2363               ,input  'width':u
     2364               ,output v-resize-value-str
     2365               ) .
     2366             if v-resize-value-str <> '':U
     2367             then do:
     2368               run diasize_change-width in this-procedure
     2369                 (input  integer(v-resize-value-str)
     2370                 ,input  true
     2371                 ) .
     2372               assign
     2373                 v-restore-saved = true
     2374               .
     2375             end.
     2376           end.
     2377           if v-restore-saved <> true
     2378           then do:
     2379             if v-diasize-wndmax = true
     2380             then do:
     2381               run diasize_maximize in this-procedure
     2382                 (input  true
     2383                 ) .
     2384             end.
     2385           end.
     2386         end.
     2387         else do:
     2388           if v-diasize-wndmax = true
     2389           then do:
     2390             run diasize_maximize in this-procedure
     2391               (input  true
     2392               ) .
     2393           end.
     2394         end.
     2395       end.
     2396     end.
     2397   end procedure.
     2398   procedure diasize_need-full-display :
     2399     define output parameter p-need-full-display as logical   no-undo .
     2400     do
     2401     on error undo, return error return-value
     2402     :
     2403       assign
     2404         p-need-full-display = v-diasize-need-full-display
     2405       .
     2406       assign
     2407         v-diasize-need-full-display = false
     2408       .
     2409     end.
     2410   end procedure.
     2411   procedure get-context :
     2412      define output parameter p-db-num as integer          no-undo.
     2413      define output parameter p-user-id as character        no-undo.
     2414      define variable v-login               as character    no-undo.
     2415      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2416      define buffer buf_user-login  for ub.user-login .
     2417      do
     2418      on error undo, return error
     2419      :
     2420            FIND FIRST buf_sys-ctrl no-lock.
     2421            ASSIGN
     2422               v-login = USERID("ub")
     2423               p-db-num = buf_sys-ctrl.db-num
     2424            .
     2425            FIND FIRST buf_user-login
     2426                 WHERE buf_user-login.db-num = p-db-num
     2427                   AND buf_user-login.user-login = v-login
     2428                 no-lock
     2429                 no-error
     2430                 .
     2431            IF AVAILABLE buf_user-login
     2432            THEN DO:
     2433               assign
     2434                  p-user-id = buf_user-login.user-id
     2435               .
     2436            END.
     2437      end.
     2438   end procedure.
     2439       run diasize_init in this-procedure .
     2440   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2441   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2442   MAIN-BLOCK:
     2443   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2444      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2445   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2446     run mainmenu_getcntxt in parparentproc
     2447       (output v-cntxt-db-num
     2448       ,output v-cntxt-userid
     2449       ,output v-cntxt-level
     2450       ,output v-cntxt-host-code-obj
     2451       ,output v-cntxt-obj-type
     2452       ,output v-cntxt-obj-code
     2453       ,output v-cntxt-db-num-obj
     2454       ,output v-cntxt-is-admin
     2455       ) .
     2456     v-admin = lookup('admin', bttns) > 0.
     2457     if (p-list-mode = "layout-type"
     2458           or
     2459           p-list-mode = "layout-device-type"
     2460           or
     2461           p-list-mode = "layout-device-type-mode")
     2462     and lookup(p-layout-type, 'th-pos-screen,th-pos-keyboard':U) = 0 then do:
     2463       message
     2464       substitute("Неверное значение параметра p-layout-type = &1", p-layout-type)
     2465       view-as alert-box error .
     2466       undo main-block, return error .
     2467     end.
     2468     if (  p-list-mode = "layout-device-type"
     2469           or
     2470           p-list-mode = "layout-device-type-mode")
     2471     and lookup(p-device-type, 'th-pos-screen,th-pos-keyboard':U) = 0 then do:
     2472       message
     2473       substitute("Неверное значение параметра p-device-type = &1", p-device-type)
     2474       view-as alert-box error .
     2475       undo main-block, return error .
     2476     end.
     2477     v-list-mode = p-list-mode.
     2478     run Myenable in this-procedure .
     2479     v-rid-list = p-rid-list.
     2480     WAIT-FOR GO OF FRAME Dialog-Frame.
     2481   END.
     2482   RUN disable_UI.
     2483   PROCEDURE disable_UI :
     2484     HIDE FRAME Dialog-Frame.
     2485   END PROCEDURE.
     2486   PROCEDURE enable_UI :
     2487     DISPLAY CB-layout-type CB-device-type Cb-elem-type CB-mode-id mark-num
     2488         WITH FRAME Dialog-Frame.
     2489     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp B-Help CB-layout-type
     2490            CB-device-type Cb-elem-type CB-mode-id br-layout-elem mark-num
     2491         WITH FRAME Dialog-Frame.
     2492     VIEW FRAME Dialog-Frame.
     2493   END PROCEDURE.
     2494   PROCEDURE MyEnable :
     2495   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2496   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     2497   define variable v-h as handle no-undo .
     2498   DEFINE BUFFER buf_wi-mode FOR ub.wi-mode.
     2499   v-list-items = chr(44).
     2500   DO v-ii = 1 TO NUM-ENTRIES('th-pos-screen,th-pos-keyboard':U):
     2501      v-list-items = v-list-items  + chr(44) +
     2502                    ENTRY(v-ii, 'Экран IBS TH POS,Клавиатура IBS TH POS':U) + chr(44) +
     2503                     ENTRY(v-ii, 'th-pos-screen,th-pos-keyboard':U).
     2504   END.
     2505   ASSIGN
     2506   cb-layout-type:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = v-list-items .
     2507   v-list-items = chr(44).
     2508   DO v-ii = 1 TO NUM-ENTRIES('0,-1':U):
     2509      v-list-items = v-list-items  + chr(44) +
     2510                    ENTRY(v-ii, 'Программируемый,Непрограммируемый':U) + chr(44) +
     2511                     ENTRY(v-ii, '0,-1':U).
     2512   END.
     2513   ASSIGN
     2514   cb-elem-type:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = v-list-items .
     2515   v-keyboard-list-items = 'IBM-50':U.
     2516   v-SCREEN-list-items = 'Screen,TouchScreen':U.
     2517   ASSIGN
     2518   v-h = br-layout-elem:FIRST-COLUMN in frame Dialog-Frame
     2519   .
     2520   DO while valid-handle(v-h) :
     2521     if v-h:LABEL = "Тип раскладки" then do:
     2522       vh-layout-type-name = v-h.
     2523     end.
     2524     if v-h:LABEL = "Режим" then do:
     2525       vh-cdm-name = v-h.
     2526     end.
     2527     v-h = v-h:NEXT-COLUMN.
     2528   END.
     2529   v-list-items = chr(44).
     2530   assign
     2531   cb-mode-id:list-item-pairs in frame Dialog-Frame = v-list-items.
     2532   for each buf_wi-mode NO-LOCK WHERE buf_wi-mode.mode-type = 'cd-IBS-TH':U
     2533   :
     2534     cb-mode-id:add-last ( substitute("&1 (&2)", string(buf_wi-mode.mode-name, "X(35)"), buf_wi-mode.mode-id), buf_wi-mode.mode-id).
     2535   end.
     2536   cb-mode-id:delete(1).
     2537   IF p-elem-type <> ? THEN do:
     2538       cb-elem-type = p-elem-type.
     2539   END.
     2540   case p-list-mode:
     2541      when 'все':U then do:
     2542        display
     2543        cb-layout-type
     2544        cb-device-type
     2545        cb-mode-id
     2546        with frame Dialog-Frame.
     2547      end.
     2548      when "layout-type" then do:
     2549         cb-layout-type = p-layout-type.
     2550        display
     2551        cb-device-type
     2552        cb-mode-id
     2553        with frame Dialog-Frame.
     2554      end.
     2555      when "layout-device-type" then do:
     2556        cb-layout-type = p-layout-type.
     2557        cb-device-type = p-device-type.
     2558        display
     2559        cb-mode-id
     2560        with frame Dialog-Frame.
     2561      end.
     2562      when "layout-type" then do:
     2563         cb-layout-type = p-layout-type.
     2564         cb-device-type = p-device-type.
     2565         cb-mode-id = p-mode-id.
     2566      end.
     2567   end case.
     2568   ASSIGN
     2569   X_layout-elem.device-type:RESIZABLE IN BROWSE br-layout-elem = YES
     2570   vh-layout-type-name:resizable = yes
     2571   vh-cdm-name:resizable = yes
     2572   .
     2573   ENABLE
     2574   b-quit
     2575   b-add when (lookup("b-add", bttns) > 0) and v-admin
     2576   b-chg when (lookup("b-add", bttns) > 0) and v-admin
     2577   b-del when (lookup("b-add", bttns) > 0) and v-admin
     2578   b-lkp
     2579   B-Help
     2580   b-mark when lookup("b-mark", bttns) > 0
     2581   b-sel when lookup("b-sel", bttns) > 0
     2582   br-layout-elem
     2583   cb-layout-type when p-list-mode = 'все':U
     2584   cb-device-type when (p-list-mode = 'все':U or p-list-mode = "layout-type")
     2585   cb-mode-id when (p-list-mode = 'все':U or p-list-mode = "layout-type" or p-list-mode = "layout-device-type")
     2586   cb-elem-type WHEN p-elem-type = ?
     2587   WITH FRAME Dialog-Frame.
     2588   VIEW FRAME Dialog-Frame.
     2589   IF p-elem-type <> ?  THEN DO:
     2590     HIDE
     2591     cb-elem-type
     2592     IN FRAME Dialog-Frame.
     2593   END.
     2594   apply "value-changed" to cb-layout-type.
     2595   run Openbr in this-procedure .
     2596   END PROCEDURE.
     2597   PROCEDURE Openbr :
     2598   OPEN QUERY br-layout-elem
     2599   FOR EACH X_layout-elem NO-LOCK where
     2600   (cb-layout-type = ''
     2601   or
     2602   X_layout-elem.layout-type = cb-layout-type)
     2603   and
     2604   (cb-device-type = ''
     2605   or
     2606   X_layout-elem.device-type = cb-device-type)
     2607   and
     2608   (cb-mode-id = ''
     2609   or
     2610   X_layout-elem.mode-id = cb-mode-id)
     2611   AND
     2612   (cb-elem-type = ?
     2613    OR
     2614    X_layout-elem.elem-type = cb-elem-type)
     2615   INDEXED-REPOSITION.
     2616   CASE v-list-mode:
     2617      when 'все':U then do:
     2618         frame Dialog-Frame :title = "Все элементы раскладки".
     2619       assign
     2620       vh-layout-type-name:visible  = yes
     2621       X_layout-elem.device-type:visible in browse br-layout-elem = yes
     2622       vh-cdm-name:visible  = yes
     2623       .
     2624      end.
     2625      when "layout-type" then do:
     2626         frame Dialog-Frame :title = substitute("Элементы раскладок типа &1", p-layout-type).
     2627         assign
     2628         vh-layout-type-name:visible  = no
     2629         X_layout-elem.device-type:visible in browse br-layout-elem = yes
     2630         vh-cdm-name:visible  = yes
     2631         .
     2632      end.
     2633      when "layout-device-type" then do:
     2634         frame Dialog-Frame :title = substitute("Элементы для раскладок типа &1  для &2", p-layout-type, p-device-type).
     2635         assign
     2636         vh-layout-type-name:visible  = no
     2637         X_layout-elem.device-type:visible in browse br-layout-elem = no
     2638         vh-cdm-name:visible  = yes
     2639         .
     2640      end.
     2641      when "layout-device-type-mode" then do:
     2642         frame Dialog-Frame :title = substitute("Элементы раскладок типа &1 для &2 в режиме", p-layout-type, p-device-type, p-mode-id).
     2643        assign
     2644        vh-layout-type-name:visible  = no
     2645        X_layout-elem.device-type:visible in browse br-layout-elem = no
     2646        vh-cdm-name:visible  = no
     2647        .
     2648      end.
     2649   end case.
     2650   END PROCEDURE.
     2651   PROCEDURE proc-b-lkp :
     2652   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2653   define variable v-rec as recid no-undo.
     2654   CASE p-option:
     2655     WHEN 'layout-elem':U THEN DO:
     2656         run adm/layoutei.w ( input parparentproc
     2657                              ,input 'ПРОСМОТР':U + chr(44) + (if v-admin then "admin" else '')
     2658                              ,input X_layout-elem.layout-type
     2659                              ,input X_layout-elem.device-type
     2660                              ,input X_layout-elem.mode-id
     2661                              ,input X_layout-elem.widget-id
     2662                              ,input-output v-rec) no-error.
     2663     END.
     2664   END CASE.
     2665   IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2666   END PROCEDURE.
