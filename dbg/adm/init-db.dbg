        1   block-level on error undo, throw.
        2   define input parameter loc_db-num as integer   no-undo .
        3   define input parameter ld-name    as character no-undo .
        4   define input parameter p-language as character no-undo .
        5   define input parameter p-r-b      as character no-undo .
        6   define input parameter p-sys-key  as character no-undo .
        7   define input parameter mess-view  as logical   no-undo .
        8   define input parameter p-create-adm as logical          no-undo.
        9   define input parameter p-extra-to as integer   no-undo .
       10   def var vss-revision    as character no-undo init "$Revision: d47c064bc860, 1107, rls $":U .
       11   def var vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       12   def var vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
       13   def var vss-workfile    as character no-undo init "$Workfile: init-db.p $":U .
       14   def var vss-archive     as character no-undo init "$Archive: adm/init-db.p $":U .
       15   def var vss-description as character no-undo init "Инициализация БД".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   do
       75   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       76   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       77   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       78   :
       79     define variable prev-ld-name as character no-undo .
       80     define variable g#log        as logical   no-undo .
       81     define variable err-log      as logical   no-undo .
       82     if mess-view then do:
       83       message
       84         "Инициализация БД. Продолжать ?"
       85         view-as alert-box question buttons OK-Cancel update g#log
       86         .
       87       if not g#log then do:
       88         return error.
       89       end.
       90     end.
       91     assign
       92       prev-ld-name = LDBNAME("DICTDB")
       93     .
       94     create alias "DICTDB" for database VALUE( ld-name ) no-error.
       95     if error-status:error then do:
       96       message "Не могу выбрать в качестве рабочей БД:" ld-name
       97         view-as alert-box error
       98         .
       99       return error.
      100     end.
      101     assign
      102       err-log = FALSE
      103     .
      104     lv-block:
      105     do
      106     on error undo, leave lv-block
      107     :
      108       run adm/init-chk.p no-error.
      109       if error-status :error then do:
      110         message
      111           vss-workfile vss-revision vss-description          skip
      112           "Инициализируемая БД должна содержать определения" skip
      113           "и в ней не должно быть не одной записи." skip
      114           return-value skip
      115           view-as alert-box error .
      116         assign
      117           err-log = TRUE
      118         .
      119         undo, leave lv-block.
      120       end.
      121       run adm/initftbl.p
      122         ( input loc_db-num
      123          ,input p-language
      124          ,input p-r-b
      125          ,input p-sys-key
      126          ,input p-extra-to
      127         ) no-error.
      128       if error-status:error then do:
      129         message
      130           vss-workfile vss-revision vss-description                   skip
      131           "Не удалась первичная инициализация справочников."
      132           view-as alert-box error .
      133         assign
      134           err-log = TRUE
      135         .
      136         undo, leave lv-block.
      137       end.
      138       IF loc_db-num = 0
      139       THEN DO:
      140         run utl/kick-db.p ( input p-sys-key ) no-error .
      141         if error-status:error then do:
      142            message
      143            vss-workfile vss-revision vss-description                   skip
      144            "Не удалась первичная инициализация валют, основных единиц и пр.."
      145            view-as alert-box error .
      146            assign
      147            err-log = TRUE
      148            .
      149            undo, leave lv-block.
      150         end.
      151       END.
      152       run adm/init-adm.p
      153         ( input false
      154         , input loc_db-num
      155         , input p-create-adm
      156         ) no-error.
      157       if error-status :error
      158       then do:
      159         message
      160           vss-workfile vss-revision vss-description  skip
      161           "Не удалась первичная инициализация пользователей."
      162           view-as alert-box error .
      163         assign
      164           err-log = TRUE
      165         .
      166         undo, leave lv-block.
      167       end.
      168     end.
      169     create alias "DICTDB" for database VALUE( prev-ld-name ) no-error.
      170     if error-status:error then do:
      171       message "Не могу вернуть в качестве рабочей БД:" prev-ld-name
      172         view-as alert-box error
      173         .
      174       return error.
      175     end.
      176     if mess-view then do:
      177       if err-log = TRUE then do:
      178         message
      179           "Не удалось инициализировать БД №" loc_db-num
      180           view-as alert-box .
      181       end.
      182       else do:
      183         message
      184           "Инициализация БД №" loc_db-num "закончена успешно." skip
      185           "БД" ld-name "отсоеденена."
      186           view-as alert-box .
      187       end.
      188     end.
      189     if err-log = TRUE then do:
      190       return error.
      191     end.
      192   end.
      193   procedure get-param :
      194   define output parameter p-get-extra-to as integer no-undo.
      195     p-get-extra-to = p-extra-to.
      196   end procedure.
