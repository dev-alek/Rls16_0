      494       ,input-output table-handle p-tth
      495       ,output p-all-found
      496       ) no-error .
      497     if error-status :error
      498     then do:
      499       delete object p-tth.
      500       undo, return error return-value .
      501     end.
      502     delete object p-tth.
      503   end.
      504   end procedure.
      505   procedure thbjattr_write :
