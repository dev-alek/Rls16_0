      615   procedure proc-alt-shift-f2:
      616     if not ibs.th.gbl.gbl-var:rcode
      617   then
      618     run gbl\inidebug.p .
      619   end.
      620   procedure proc-alt-shift-f3:
      621     run gbl/prvssinf.p
      622       ( input this-procedure
      623       ) .
      624   end.
      625   define variable v-inform-launched as logical no-undo initial false .
      626   procedure proc-alt-shift-f4:
      627     define variable v-action as character no-undo .
      628     if v-inform-launched = false then do:
      629       assign
      630         v-inform-launched = true
      631       .
      632       run gbl/d-inform.w
      633         (  input self
      634         ,  input this-procedure
      635         , output v-action
      636         ) no-error .
      637       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      638       assign
      639         v-inform-launched = false
      640       .
      641     end.
      642   end.
      643   procedure proc-alt-f1:
      644     run gbl/corrhelp.p
      645       (input this-procedure
      646       ) .
      647   end .
      648   on alt-shift-f2 anywhere do:
      649     run proc-alt-shift-f2.
      650   end.
      651   on alt-shift-f3 anywhere do:
      652     run proc-alt-shift-f3 in this-procedure .
      653   end.
      654   on alt-shift-f4 anywhere do:
      655     run proc-alt-shift-f4 in this-procedure.
      656   end.
      657   on alt-f1 anywhere do:
      658     run proc-alt-f1 in this-procedure .
      659   end.
      660   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661     define variable v-cntxt-db-num        as integer   no-undo .
      662     define variable v-cntxt-userid        as character no-undo .
      663     define variable v-cntxt-level         as character no-undo .
      664     define variable v-cntxt-host-code-obj as integer   no-undo .
      665     define variable v-cntxt-obj-type      as character no-undo .
      666     define variable v-cntxt-obj-code      as integer   no-undo .
      667     define variable v-cntxt-db-num-obj    as integer   no-undo .
      668     define variable v-cntxt-is-admin      as logical   no-undo .
      669   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      670   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      671   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      672   DEFINE VARIABLE v-old-attr-value AS CHARACTER NO-UNDO.
      673   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      674   define variable v-tth as handle no-undo .
      675   assign
      676   v-tth = buffer thbjattr_thbj-attr:table-handle .
      677   DEFINE BUTTON B-add
      678        LABEL "&Добавить"
      679        SIZE 10 BY 1.
      680   DEFINE BUTTON B-del
      681        LABEL "&Удалить"
      682        SIZE 10 BY 1.
      683   DEFINE BUTTON B-exit AUTO-GO
      684        LABEL "&Ввод"
      685        SIZE 10 BY 1
      686        BGCOLOR 8 .
      687   DEFINE BUTTON B-Help
      688        LABEL "Помо&щь"
      689        SIZE 10 BY 1
      690        BGCOLOR 8 .
      691   DEFINE BUTTON b-quit AUTO-END-KEY
      692        LABEL "&Отмена"
      693        SIZE 10 BY 1
      694        BGCOLOR 8 .
      695   DEFINE VARIABLE l-paycardv-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Список префиксов номеров платежных карт"
      696         VIEW-AS TEXT
      697        SIZE 41.5 BY .67 NO-UNDO.
      698   DEFINE VARIABLE l-paycardv-2 AS CHARACTER FORMAT "X(256)":U INITIAL "ПОЛНОСТЬЮ показываемых в интерфейсе"
      699         VIEW-AS TEXT
      700        SIZE 41.5 BY .67 NO-UNDO.
      701   DEFINE VARIABLE S-paycardv AS CHARACTER
      702        VIEW-AS SELECTION-LIST SINGLE SORT SCROLLBAR-VERTICAL
      703        SIZE 27 BY 5.75 NO-UNDO.
      704   DEFINE VARIABLE t-ch-bc-ck AS LOGICAL INITIAL no
      705        LABEL "Разрешена смена товара в чеке (при редакт. чека) на товар с другой ценой"
      706        VIEW-AS TOGGLE-BOX
      707        SIZE 77.5 BY 1 NO-UNDO.
      708   DEFINE VARIABLE t-chk-inf AS LOGICAL INITIAL no
      709        LABEL "Динамич. сбор инф по чекам и показ ее в пиктограммах главного меню АРМа Магазин"
      710        VIEW-AS TOGGLE-BOX
      711        SIZE 83 BY 1 NO-UNDO.
      712   DEFINE VARIABLE t-chk-spfc AS LOGICAL INITIAL no
      713        LABEL "Видна кнопка <Cпецификация> в списке чеков - запуск заказной печати"
      714        VIEW-AS TOGGLE-BOX
      715        SIZE 70 BY 1 NO-UNDO.
      716   DEFINE VARIABLE t-dc-change AS LOGICAL INITIAL no
      717        LABEL "Разрешена смена ДК при редактировании чека"
      718        VIEW-AS TOGGLE-BOX
      719        SIZE 70 BY 1 NO-UNDO.
      720   DEFINE FRAME Dialog-Frame
      721        B-exit AT ROW 1 COL 1
      722        b-quit AT ROW 1 COL 11
      723        B-Help AT ROW 1 COL 54.88
      724        t-ch-bc-ck AT ROW 2.75 COL 4
      725        t-chk-inf AT ROW 3.75 COL 4
      726        t-chk-spfc AT ROW 4.75 COL 4
      727        S-paycardv AT ROW 6 COL 48.5 NO-LABEL
      728        B-add AT ROW 6 COL 77
      729        B-del AT ROW 6 COL 87
      730        t-dc-change AT ROW 12.25 COL 4
      731        l-paycardv-1 AT ROW 6 COL 2 COLON-ALIGNED NO-LABEL
      732        l-paycardv-2 AT ROW 7 COL 2 COLON-ALIGNED NO-LABEL
      733        SPACE(53.74) SKIP(5.86)
      734       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      735            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      736            TITLE "Опции интерфейса при работе с чеками"
      737            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      738   ASSIGN
      739          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      740          FRAME Dialog-Frame:HIDDEN           = TRUE.
      741   ASSIGN
      742          B-add:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      743   ASSIGN
      744          B-del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      745   ASSIGN
      746          l-paycardv-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      747   ASSIGN
      748          l-paycardv-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      749   ASSIGN
      750          S-paycardv:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      751   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      752   DO:
      753     APPLY "END-ERROR":U TO SELF.
      754   END.
      755   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      756   DO:
      757     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      758     DEFINE VARIABLE v-log AS logical NO-UNDO.
      759     run gbl/d-prompt.w (
      760         'title=':u + "Добавить префикс платежной карты" + '\':u
      761       + 'format=' + ">>>>>>>>>>>9" + '\':u
      762       + 'type=' + 'D':U + '\':u
      763       + 'fillin_row=2\':u
      764       + 'fillin_col=4\':u
      765       + 'fillin_width=20\':u
      766       + 'fillin_height=1\':u
      767       + 'max-chars=12\':u
      768       + 'readonly=no\':u
      769       , input-output v-value
      770       ).
      771       if return-value = 'false':u then return NO-apply.
      772     v-log = s-paycardv:ADD-LAST ( v-value ) NO-ERROR.
      773     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      774   END.
      775   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      776   DO:
      777     DEFINE VARIABLE v-log AS LOGICAL NO-UNDO.
      778     v-log = s-paycardv:DELETE ( s-paycardv:SCREEN-VALUE) NO-ERROR.
      779     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      780   END.
      781   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      782   DO:
      783     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      784     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      785   END.
      786   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      787   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      788   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   on help of frame Dialog-Frame
      790   do:
      791     run gbl/app_help.p
      792       (input this-procedure :file-name
      793       ,input ''
      794       ,input ?
      795       ) no-error.
      796     if error-status :error then do:
      797       message
      798         "Ошибка при вызове помощи"
      799         error-status :get-message(1)
      800         view-as alert-box .
      801     end.
      802   end.
      803   run minbtn-set in this-procedure .
      804   on choose of b-help in frame Dialog-Frame
      805   do:
      806     apply "help":u to frame Dialog-Frame .
      807   end.
      808   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   procedure minbtn-set :
      810       do
      811           on error undo, return error return-value
      812           :
      813           define variable ii              as integer       no-undo .
      814           define variable fh              as widget-handle no-undo .
      815           define variable hh              as widget-handle no-undo .
      816           define variable v-h             as handle        extent 4 no-undo .
      817           define variable v-name-button   as character     no-undo .
      818           define variable v-help-old-x    as decimal       no-undo .
      819           define variable v-help-old-y    as decimal       no-undo .
      820           define variable v-help-old-size as decimal       no-undo .
      821           define variable v-frame-width   as decimal       no-undo .
      822           define variable jj              as integer       no-undo .
      823           do
      824               on error undo, return error
      825               :
      826               assign
      827                   v-frame-width = frame Dialog-Frame:width - 0.3
      828                   fh            = frame Dialog-Frame:first-child
      829                   hh            = fh:first-child
      830                   ii            = 1
      831                   .
      832               do while valid-handle(hh):
      833                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      834                   do:
      835                       case lc(hh:name) :
      836                           when "b-help" then
      837                               do:
      838                                   hh:load-image-up("cmp/b-help.bmp":u) .
      839                                   hh:load-image-down("cmp/b-help.bmp":u) .
      840                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      841                                   hh:TOOLTIP = "Помощь" .
      842                                   v-help-old-x = hh:column .
      843                                   v-help-old-y = hh:row    .
      844                                   v-help-old-size = hh:width .
      845                                   hh:width-chars = 2.5 .
      846                               end.
      847                           when "b-print" then
      848                               do:
      849                                   hh:load-image("cmp/b-print.bmp":u) .
      850                                   hh:TOOLTIP = "Печать" .
      851                                   v-h[ii] = hh:handle .
      852                                   ii = ii + 1 .
      853                                   hh:width-chars = 3 .
      854                               end.
      855                           when "b-history" or
      856                           when "b-hist" then
      857                               do:
      858                                   hh:load-image("cmp/b-hist.bmp":u) .
      859                                   hh:TOOLTIP = "История" .
      860                                   v-h[ii] = hh:handle .
      861                                   ii = ii + 1 .
      862                                   hh:width-chars = 3 .
      863                               end.
      864                           when "b-sch" then
      865                               do:
      866                                   hh:load-image("cmp/b-sch.bmp":u) .
      867                                   hh:TOOLTIP = "Установка Фильтра" .
      868                                   v-h[ii] = hh:handle .
      869                                   ii = ii + 1 .
      870                                   hh:width-chars = 3 .
      871                               end.
      872                           when "b-hist-user" then
      873                               do:
      874                                   hh:load-image("cmp/b-hist.bmp":u) .
      875                                   hh:TOOLTIP = "История пользователя" .
      876                                   ii = ii + 1 .
      877                               end.
      878                       end case.
      879                   end.
      880                   hh = hh:next-sibling.
      881               end.
      882               b-help:column = v-frame-width - b-help:width-chars.
      883               jj = 0.
      884               repeat ii = 4 to 1 by -1 :
      885                   if valid-handle (v-h[ii] ) then
      886                   do:
      887                       jj  = jj + 1 .
      888                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      889                       v-h[ii]:row    = v-help-old-y .
      890                   end.
      891               end.
      892           end.
      893       end.
      894   end procedure.
      895   MAIN-BLOCK:
      896   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      897      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      898   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899     run mainmenu_getcntxt in parparentproc
      900       (output v-cntxt-db-num
      901       ,output v-cntxt-userid
      902       ,output v-cntxt-level
      903       ,output v-cntxt-host-code-obj
      904       ,output v-cntxt-obj-type
      905       ,output v-cntxt-obj-code
      906       ,output v-cntxt-db-num-obj
      907       ,output v-cntxt-is-admin
      908       ) .
      909   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   ON TAB ANYWHERE
      911   DO:
      912   define variable ii as integer no-undo .
      913   define variable fh as widget-handle no-undo .
      914   define variable hh as widget-handle no-undo .
      915   define variable v-next-widget-name as character no-undo .
      916   if v-tab-order <> '' then do:
      917     if self:type = "TOGGLE-BOX" then
      918     self:BGCOLOR = ?.
      919     assign
      920     ii = lookup(self:name, v-tab-order).
      921     assign
      922     ii = ii + 1
      923     v-next-widget-name = entry(ii, v-tab-order)
      924     no-error .
      925     if error-status:error then do:
      926       assign
      927       ii = 1
      928       v-next-widget-name = entry( ii, v-tab-order)
      929       .
      930     end.
      931     assign
      932     fh = frame Dialog-Frame:first-child
      933     hh = fh:first-child
      934     .
      935     do while valid-handle(hh):
      936       if hh:name = v-next-widget-name then do:
      937         if hh:sensitive  = yes
      938         AND hh:visible = yes then do:
      939           if hh:type = "TOGGLE-BOX":U then do:
      940             assign
      941             hh:BGcolor = 1
      942             .
      943           end.
      944           APPLY "ENTRY" to hh.
      945           return no-apply.
      946         end.
      947         else do:
      948           APPLY "TAB" to hh.
      949           return no-apply.
      950         end.
      951       end.
      952       hh = hh:next-sibling.
      953     end.
      954   end.
      955   END.
      956   ON BACK-TAB ANYWHERE
      957   DO:
      958   define variable ii as integer no-undo .
      959   define variable fh as widget-handle no-undo .
      960   define variable hh as widget-handle no-undo .
      961   define variable v-next-widget-name as character no-undo .
      962   if v-tab-order <> '' then do:
      963     assign
      964     ii = lookup(self:name, v-tab-order).
      965     .
      966     assign
      967     ii = (if ii = 1
      968           then  num-entries(v-tab-order)
      969           else ii - 1
      970           )
      971     v-next-widget-name = entry(ii, v-tab-order)
      972     .
      973     assign
      974     fh = frame Dialog-Frame:first-child
      975     hh = fh:first-child
      976     .
      977     do while valid-handle(hh):
      978       if hh:name = v-next-widget-name then do:
      979         if hh:sensitive  = yes
      980         AND hh:visible = yes then do:
      981           if hh:type = "TOGGLE-BOX":U then do:
      982             assign
      983             hh:BGcolor = 1
      984             .
      985           end.
      986           APPLY "ENTRY" to hh.
      987           return no-apply.
      988         end.
      989         else do:
      990         APPLY "BACK-TAB" to hh.
      991         return no-apply.
      992         end.
      993       end.
      994       hh = hh:next-sibling.
      995     end.
      996     end.
      997   END.
      998   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999   ON RETURN ANYWHERE
     1000   DO:
     1001   define variable ii as integer no-undo .
     1002   define variable fh as widget-handle no-undo .
     1003   define variable hh as widget-handle no-undo .
     1004   define variable v-next-widget-name as character no-undo .
     1005     if v-tab-order <> '' then do:
     1006       assign
     1007       ii = lookup(self:name, v-tab-order).
     1008       if ii = num-entries(v-tab-order) then do:
     1009           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1010           return no-apply.
     1011       end.
     1012       if self:type <> "BUTTON" and
     1013         self:type <> "EDITOR"  then do:
     1014         run proc-move-forward in this-procedure .
     1015         return no-apply.
     1016       end.
     1017       if self:type = "BUTTON" then do:
     1018         APPLY "CHOOSE" to self.
     1019       end.
     1020       if self:type = "TOGGLE-BOX" then
     1021       self:BGCOLOR = ?.
     1022       assign
     1023       ii = ii + 1
     1024       v-next-widget-name = entry(ii, v-tab-order)
     1025       no-error .
     1026       if error-status:error then do:
     1027         assign
     1028         ii = 1
     1029         v-next-widget-name = entry( ii, v-tab-order)
     1030         .
     1031       end.
     1032       assign
     1033       fh = frame Dialog-Frame:first-child
     1034       hh = fh:first-child
     1035       .
     1036       do while valid-handle(hh):
     1037         if hh:name = v-next-widget-name then do:
     1038           if hh:sensitive  = yes
     1039           AND hh:visible = yes then do:
     1040             if hh:type = "TOGGLE-BOX":U then do:
     1041               assign
     1042               hh:BGcolor = 1
     1043               .
     1044             end.
     1045             APPLY "ENTRY" to hh.
     1046             return no-apply.
     1047           end.
     1048           else do:
     1049             APPLY "TAB" to hh.
     1050             return no-apply.
     1051           end.
     1052         end.
     1053         hh = hh:next-sibling.
     1054       end.
     1055     end.
     1056   END.
     1057   procedure proc-move-forward :
     1058   define variable ii as integer no-undo .
     1059   define variable fh as widget-handle no-undo .
     1060   define variable hh as widget-handle no-undo .
     1061   define variable v-next-widget-name as character no-undo .
     1062   do
     1063   on error undo, return error
     1064   :
     1065     if v-tab-order <> '' then do:
     1066       if self:type = "TOGGLE-BOX" then
     1067       self:BGCOLOR = ?.
     1068       assign
     1069       ii = lookup(self:name, v-tab-order).
     1070       assign
     1071       ii = ii + 1
     1072       v-next-widget-name = entry(ii, v-tab-order)
     1073       no-error .
     1074       if error-status:error then do:
     1075         assign
     1076         ii = 1
     1077         v-next-widget-name = entry( ii, v-tab-order)
     1078         .
     1079       end.
     1080       assign
     1081       fh = frame Dialog-Frame:first-child
     1082       hh = fh:first-child
     1083       .
     1084       do while valid-handle(hh):
     1085         if hh:name = v-next-widget-name then do:
     1086           if hh:sensitive  = yes
     1087           AND hh:visible = yes then do:
     1088             if hh:type = "TOGGLE-BOX":U then do:
     1089               assign
     1090               hh:BGcolor = 1
     1091               .
     1092             end.
     1093             APPLY "ENTRY" to hh.
     1094             return.
     1095           end.
     1096           else do:
     1097             assign
     1098             ii = ii + 1
     1099             v-next-widget-name = entry(ii, v-tab-order)
     1100             no-error .
     1101             if error-status:error then do:
     1102               assign
     1103               ii = 1
     1104               v-next-widget-name = entry( ii, v-tab-order)
     1105               .
     1106             end.
     1107           end.
     1108         end.
     1109         hh = hh:next-sibling.
     1110       end.
     1111     end.
     1112   end.
     1113   end procedure.
     1114     IF p-mode <> 'ПРОСМОТР':U
     1115     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1116         MESSAGE
     1117         vss-workfile vss-revision vss-description skip
     1118         "Неверное значение параметра p-mode" p-mode
     1119         VIEW-AS ALERT-BOX ERROR.
     1120         UNDO, RETURN ERROR.
     1121     END.
     1122     IF p-obj-type <> 'маг':U
     1123     and p-obj-type <> 'орг':U
     1124     and p-obj-type <> '':U
     1125     THEN DO:
     1126         MESSAGE
     1127         vss-workfile vss-revision vss-description skip
     1128         "Неверное значение параметра p-obj-type" p-obj-type
     1129         VIEW-AS ALERT-BOX ERROR.
     1130         UNDO, RETURN ERROR.
     1131     END.
     1132     if p-obj-type = 'маг':U then do:
     1133       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1134       IF NOT AVAILABLE X_shop THEN DO:
     1135           MESSAGE
     1136           vss-workfile vss-revision vss-description skip
     1137           "Неверное значение параметра p-obj-code" p-obj-code
     1138           VIEW-AS ALERT-BOX ERROR.
     1139           UNDO, RETURN ERROR.
     1140       END.
     1141   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1143     (input  'маг':U
     1144     ,input  p-obj-code
     1145     ,output v-db-num
     1146     )  .
     1147       IF v-db-num <> v-cntxt-db-num
     1148       AND v-cntxt-db-num <> 0
     1149       and p-mode <> 'ПРОСМОТР':U
     1150       THEN DO:
     1151           MESSAGE
     1152           "Нельзя менять параметры магазина в чужой БД" skip
     1153           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1154           VIEW-AS ALERT-BOX ERROR.
     1155           UNDO, RETURN ERROR.
     1156       END.
     1157     end.
     1158     if p-obj-type = 'орг':U then do:
     1159       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     1160       IF NOT AVAILABLE X_sysconf THEN DO:
     1161           MESSAGE
     1162           vss-workfile vss-revision vss-description skip
     1163           "Неверное значение параметра p-obj-code" p-obj-code
     1164           VIEW-AS ALERT-BOX ERROR.
     1165           UNDO, RETURN ERROR.
     1166       END.
     1167       if v-cntxt-db-num <> 0
     1168       and p-mode <> 'ПРОСМОТР':U
     1169       then do:
     1170           MESSAGE
     1171           "Нельзя менять параметры ФИРМЫ в УБД" skip
     1172           VIEW-AS ALERT-BOX ERROR.
     1173           UNDO, RETURN ERROR.
     1174       end.
     1175     end.
     1176     if p-obj-type = '':U then do:
     1177       if v-cntxt-db-num <> 0
     1178       and p-mode <> 'ПРОСМОТР':U
     1179       then do:
     1180           MESSAGE
     1181           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     1182           VIEW-AS ALERT-BOX ERROR.
     1183           UNDO, RETURN ERROR.
     1184       end.
     1185     end.
     1186     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1187       FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     1188                 LOCKED_thbj-attr.obj-type = p-obj-type
     1189           AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1190           AND   LOCKED_thbj-attr.upper-prop-code = 'chk-view':U
     1191           AND   LOCKED_thbj-attr.prop-code = '':U NO-WAIT NO-ERROR.
     1192        if locked locked_thbj-attr then do:
     1193           message
     1194           vss-workfile vss-revision vss-description skip
     1195            "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     1196           view-as alert-box error .
     1197           undo, return error.
     1198         end.
     1199     END.
     1200     ELSE DO:
     1201         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     1202             LOCKED_thbj-attr.obj-type = p-obj-type
     1203       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     1204       AND   LOCKED_thbj-attr.upper-prop-code = 'chk-view':U
     1205       AND   LOCKED_thbj-attr.prop-code = '':U NO-ERROR.
     1206     END.
     1207     if not available locked_thbj-attr then do:
     1208       ASSIGN
     1209       v-to-create  = YES.
     1210       message
     1211       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1212                   chr(10))
     1213       view-as alert-box WARNING.
     1214     end.
     1215     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1216     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1217     RUN Myenable.
     1218     WAIT-FOR GO OF FRAME Dialog-Frame.
     1219   END.
     1220   RUN disable_UI.
     1221   PROCEDURE disable_UI :
     1222     HIDE FRAME Dialog-Frame.
     1223   END PROCEDURE.
     1224   PROCEDURE enable_UI :
     1225     DISPLAY t-ch-bc-ck t-chk-inf t-chk-spfc t-dc-change
     1226         WITH FRAME Dialog-Frame.
     1227     ENABLE B-exit b-quit B-Help t-ch-bc-ck t-chk-inf t-chk-spfc t-dc-change
     1228         WITH FRAME Dialog-Frame.
     1229     VIEW FRAME Dialog-Frame.
     1230   END PROCEDURE.
     1231   PROCEDURE fill-widgets :
     1232   define variable v-param-type as character no-undo .
     1233   define variable v-entry as character no-undo .
     1234   define variable v-value-character as character no-undo .
     1235   define variable v-value-date as date no-undo .
     1236   define variable v-value-decimal as decimal no-undo .
     1237   define variable v-value-integer as INTEGER no-undo .
     1238   define variable v-value-logical AS LOGICAL no-undo .
     1239   FOR EACH thbjattr_thbj-attr:
     1240     delete thbjattr_thbj-attr.
     1241   end.
     1242   FOR EACH temp-thbj-attr:
     1243     delete temp-thbj-attr.
     1244   end.
     1245   run adm/shattri.p (
     1246                 input "init":U
     1247               , input p-obj-type
     1248               , input p-obj-code
     1249               , input 'chk-view':U
     1250               , input "":U
     1251               , output v-value-character
     1252               , output v-value-date
     1253               , output v-value-decimal
     1254               , output v-value-integer
     1255               , output v-value-logical
     1256               , output v-param-type
     1257               , INPUT-OUTPUT TABLE-handle v-tth
     1258               ) no-error .
     1259   if error-status:error
     1260   and not available locked_thbj-attr then do:
     1261     message
     1262     "Не удалось получить начальные значения настроек" skip
     1263     error-status:get-message(1) return-value
     1264     view-as alert-box error .
     1265     undo, return error .
     1266   end.
     1267   FOR EACH thbjattr_thbj-attr:
     1268     ASSIGN
     1269     v-entry = thbjattr_thbj-attr.prop-code.
     1270     IF v-entry = 'ch-bc-ck':U THEN DO:
     1271       ASSIGN
     1272       t-ch-bc-ck = thbjattr_thbj-attr.property-value-logical
     1273       t-ch-bc-ck:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1274       .
     1275     END.
     1276     IF v-entry = 'chk-inf':U THEN DO:
     1277       ASSIGN
     1278       t-chk-inf = thbjattr_thbj-attr.property-value-logical
     1279       t-chk-inf:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr)).
     1280     END.
     1281     IF v-entry = 'chk-spfc':U THEN DO:
     1282       ASSIGN
     1283       t-chk-spfc = thbjattr_thbj-attr.property-value-logical
     1284       t-chk-spfc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1285       .
     1286     END.
     1287     IF v-entry = 'paycardv':U THEN DO:
     1288       ASSIGN
     1289       S-paycardv:LIST-ITEMS IN FRAME Dialog-Frame  = thbjattr_thbj-attr.property-value-character.
     1290     END.
     1291     if v-entry = 'dc-change':U then do:
     1292       assign
     1293       t-dc-change = thbjattr_thbj-attr.property-value-logical
     1294       t-dc-change:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1295       .
     1296     end.
     1297     create temp-thbj-attr.
     1298     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1299   END.
     1300   END PROCEDURE.
     1301   PROCEDURE MyEnable :
     1302   ASSIGN
     1303   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code)
     1304   v-tab-order = "t-ch-bc-ck,t-chk-inf,t-chk-spfc,S-paycardv,b-add,b-del,t-dc-change".
     1305   DISPLAY
     1306   t-ch-bc-ck
     1307   t-chk-inf
     1308   t-chk-spfc
     1309   t-dc-change
     1310   WITH FRAME Dialog-Frame.
     1311   ENABLE
     1312   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1313   b-quit
     1314   B-Help
     1315   t-ch-bc-ck WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1316   t-chk-inf WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1317   t-chk-spfc WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1318   t-dc-change WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1319   WITH FRAME Dialog-Frame.
     1320   VIEW FRAME Dialog-Frame.
     1321   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1322       HIDE
     1323       b-exit
     1324       IN FRAME Dialog-Frame.
     1325       ASSIGN
     1326       b-quit:LABEL = "&Выход"
     1327       .
     1328   END.
     1329   END PROCEDURE.
     1330   PROCEDURE proc-save :
     1331   define variable v-value-character as character no-undo .
     1332   define variable v-value-date as date no-undo .
     1333   define variable v-value-decimal as decimal no-undo .
     1334   define variable v-value-integer as INTEGER no-undo .
     1335   define variable v-value-logical AS LOGICAL no-undo .
     1336   define variable v-param-type as character no-undo .
     1337   define variable wh as widget-handle no-undo .
     1338   define variable fh as widget-handle no-undo .
     1339   define variable v-same as logical no-undo .
     1340   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1341   ASSIGN
     1342   FRAME Dialog-Frame
     1343   t-ch-bc-ck
     1344   t-chk-inf
     1345   t-chk-spfc
     1346   t-dc-change
     1347   .
     1348   assign
     1349   fh = frame Dialog-Frame:first-child
     1350   wh = fh:first-child
     1351   .
     1352   do while valid-handle(wh):
     1353     if wh:private-data begins "recid=" then do:
     1354       find first thbjattr_thbj-attr where
     1355                 recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1356       assign
     1357       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1358     end.
     1359     wh = wh:next-sibling.
     1360   end.
     1361   v-same = yes.
     1362   for each thbjattr_thbj-attr,
     1363       first temp-thbj-attr where
     1364             temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1365         and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1366         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1367         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code:
     1368      buffer-compare
     1369      thbjattr_thbj-attr
     1370      to temp-thbj-attr
     1371      save result in v-same.
     1372      if v-same = no then leave.
     1373   end.
     1374   v-same = no.
     1375   IF v-same  and not v-to-create THEN RETURN.
     1376   run adm/shattri.p (
     1377                  input "check":U
     1378                , input p-obj-type
     1379                , input p-obj-code
     1380                , input 'chk-view':U
     1381                , input '':U
     1382                , output v-value-character
     1383                , output v-value-date
     1384                , output v-value-decimal
     1385                , output v-value-integer
     1386                , output v-value-logical
     1387                , output v-param-type
     1388                , input-output TABLE-handle v-tth
     1389               ) no-error .
     1390   if error-status:error then do:
     1391     message
     1392     "Некорректное значение ПАРАМЕТРОВ" skip
     1393     error-status:get-message(1) skip
     1394     return-value
     1395     view-as alert-box error .
     1396     undo, return error .
     1397   end.
     1398   RUN thbjattr_set-section IN THIS-PROCEDURE (
     1399        input p-obj-type
     1400       ,input p-obj-code
     1401       ,input 'chk-view':U
     1402       ,input table thbjattr_thbj-attr
     1403   ) NO-ERROR.
     1404   IF ERROR-STATUS:error THEN do:
     1405     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     1406     RETURN-VALUE
     1407     VIEW-AS ALERT-BOX.
     1408     UNDO, RETURN ERROR.
     1409   END.
     1410   END PROCEDURE.
